+/* An admitted direct interrupt has retained ownership until its complete
+ * kernel operation returns. Freeze seals new admission before draining owners.
+ */
+static inline int kvm_crucible_effect_enter(struct kvm *kvm)
+{
+	unsigned long flags;
+	int result = 0;
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	if (kvm->crucible_controlled && !kvm->crucible_active)
+		result = -EAGAIN;
+	else if (kvm->crucible_effect_owners == U32_MAX)
+		result = -EOVERFLOW;
+	else
+		kvm->crucible_effect_owners++;
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	return result;
+}
+
+static inline void kvm_crucible_effect_leave(struct kvm *kvm)
+{
+	unsigned long flags;
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	kvm->crucible_effect_owners--;
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	wake_up_all(&kvm->crucible_stopped);
+}
