+u64 kvm_crucible_clock_ns(struct kvm *kvm)
+{
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	unsigned long flags;
+	u64 now;
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	now = clock_now_locked(clock);
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	return now;
+}
+
+void kvm_crucible_clock_sample(struct kvm_vcpu *vcpu, u64 *ns, u64 *tsc)
+{
+	struct kvm *kvm = vcpu->kvm;
+	unsigned long flags;
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	*ns = clock_now_locked(&kvm->arch.crucible_clock);
+	*tsc = mul_u64_u32_div(*ns, vcpu->arch.virtual_tsc_khz, 1000000) +
+		vcpu->arch.crucible_tsc_offset;
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+}
+
+bool kvm_crucible_clock_host_expiration(struct kvm *kvm, ktime_t logical,
+					ktime_t *host)
+{
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	unsigned long flags;
+	u64 target = ktime_to_ns(logical);
+	u64 delay;
+	bool valid = false;
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	if (!clock->active || logical < 0 || target > clock->end_ns)
+		goto out;
+	if (target <= clock->start_ns)
+		delay = 0;
+	else
+		delay = kvm_crucible_clock_host_delay(target - clock->start_ns,
+			clock->numerator, clock->denominator);
+	if (delay > KTIME_MAX - clock->host_origin_ns)
+		goto out;
+	*host = ns_to_ktime(clock->host_origin_ns + delay);
+	valid = true;
+out:
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	return valid;
+}
+
+bool kvm_crucible_clock_timer_enter(struct kvm *kvm, ktime_t logical)
+{
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	unsigned long flags;
+	bool admitted;
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	admitted = clock->active && logical >= 0 &&
+		clock_now_locked(clock) >= ktime_to_ns(logical);
+	if (admitted)
+		clock->timer_owners++;
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	return admitted;
+}
+
+void kvm_crucible_clock_timer_leave(struct kvm *kvm)
+{
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	unsigned long flags;
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	clock->timer_owners--;
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	wake_up_all(&kvm->crucible_stopped);
+}
+
+ktime_t kvm_crucible_clock_tsc_deadline(struct kvm_vcpu *vcpu, u64 deadline)
+{
+	u64 ns, tsc, remaining;
+
+	kvm_crucible_clock_sample(vcpu, &ns, &tsc);
+	if (deadline <= tsc)
+		return ns_to_ktime(ns);
+	if (!vcpu->arch.virtual_tsc_khz)
+		return KTIME_MAX;
+	remaining = kvm_crucible_clock_cycles_to_ns(deadline - tsc,
+		vcpu->arch.virtual_tsc_khz);
+	if (remaining > KTIME_MAX - ns)
+		return KTIME_MAX;
+	return ns_to_ktime(ns + remaining);
+}
