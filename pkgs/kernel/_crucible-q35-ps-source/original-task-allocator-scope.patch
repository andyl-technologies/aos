@@ -0,0 +1,130 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Original Task-local allocation admission. Missing allocator families do not
+ * become covered merely because a source issuer has entered this scope. */
+
+#include <linux/crucible_allocator.h>
+#include <linux/export.h>
+#include <linux/interrupt.h>
+#include <linux/sched.h>
+
+static bool crucible_allocator_actor(struct crucible_allocator_scope *scope)
+{
+	return scope && in_task() && scope->original_task == current &&
+		scope->original_owner && scope->original_ops &&
+		scope->original_ops->source_current && scope->original_ops->reserve_slab &&
+		scope->original_ops->complete_slab;
+}
+
+static bool crucible_allocator_current(struct crucible_allocator_scope *scope)
+{
+	bool valid;
+
+	if (!crucible_allocator_actor(scope) || READ_ONCE(scope->failed) ||
+	    READ_ONCE(scope->callback_active))
+		return false;
+	WRITE_ONCE(scope->callback_active, true);
+	valid = scope->original_ops->source_current(scope->original_owner);
+	WRITE_ONCE(scope->callback_active, false);
+	return valid && !READ_ONCE(scope->failed);
+}
+
+bool crucible_allocator_enter(struct crucible_allocator_scope *scope)
+{
+	if (!scope || !crucible_allocator_actor(scope))
+		return false;
+	if (READ_ONCE(current->crucible_allocator_scope)) {
+		WRITE_ONCE(scope->failed, true);
+		return false;
+	}
+	/* Install before checking source currentness: its callback must not
+	 * obtain an ordinary allocation path through an uninstalled scope. */
+	WRITE_ONCE(current->crucible_allocator_scope, scope);
+	if (!crucible_allocator_current(scope)) {
+		WRITE_ONCE(scope->failed, true);
+		WRITE_ONCE(current->crucible_allocator_scope, NULL);
+		return false;
+	}
+	return true;
+}
+EXPORT_SYMBOL_GPL(crucible_allocator_enter);
+
+bool crucible_allocator_leave(struct crucible_allocator_scope *scope)
+{
+	bool valid;
+
+	if (!scope || READ_ONCE(current->crucible_allocator_scope) != scope ||
+	    !crucible_allocator_actor(scope))
+		return false;
+	valid = crucible_allocator_current(scope);
+	if (!valid)
+		WRITE_ONCE(scope->failed, true);
+	WRITE_ONCE(current->crucible_allocator_scope, NULL);
+	return valid;
+}
+EXPORT_SYMBOL_GPL(crucible_allocator_leave);
+
+bool crucible_allocator_slab_reserve(const struct crucible_slab_request *request,
+	struct crucible_allocator_token *token)
+{
+	struct crucible_allocator_scope *scope;
+	void *lease = NULL;
+	bool reserved;
+
+	token->original_scope = NULL;
+	token->original_lease = NULL;
+	token->original_cache = NULL;
+	scope = READ_ONCE(current->crucible_allocator_scope);
+	/* An interrupt sharing this Task is not the original constructor actor.
+	 * Its allocations remain outside this currently incomplete source scope. */
+	if (!scope || !in_task())
+		return true;
+	if (!request || !request->original_cache || !request->stride_bytes ||
+	    request->object_bytes > request->stride_bytes ||
+	    request->requested_bytes > request->object_bytes ||
+	    !request->slab_objects || !request->minimum_objects ||
+	    !request->slab_backing_bound ||
+	    !crucible_allocator_current(scope))
+		goto refuse;
+
+	WRITE_ONCE(scope->callback_active, true);
+	reserved = scope->original_ops->reserve_slab(scope->original_owner,
+		request, &lease);
+	WRITE_ONCE(scope->callback_active, false);
+	if (!reserved || !lease || !crucible_allocator_current(scope))
+		goto refuse;
+	/* The original reservation remains retained even if a later allocation
+	 * fails. No implicit refund or retry is manufactured by this dispatcher. */
+	token->original_scope = scope;
+	token->original_lease = lease;
+	token->original_cache = request->original_cache;
+	return true;
+
+refuse:
+	WRITE_ONCE(scope->failed, true);
+	return false;
+}
+EXPORT_SYMBOL_GPL(crucible_allocator_slab_reserve);
+
+void crucible_allocator_slab_complete(struct crucible_allocator_token *token,
+	const struct crucible_slab_output *output)
+{
+	struct crucible_allocator_scope *scope = token->original_scope;
+
+	if (!scope)
+		return;
+	/* Consume the local token before invoking the source sink. The sink
+	 * records the actual native pointer (including NULL) before currentness
+	 * reconciliation, so changed phase cannot erase an allocation result. */
+	token->original_scope = NULL;
+	WRITE_ONCE(scope->callback_active, true);
+	scope->original_ops->complete_slab(scope->original_owner,
+		token->original_lease, output);
+	WRITE_ONCE(scope->callback_active, false);
+	if (output->kfence_object ||
+	    (output->native_object && (!output->native_slab ||
+		output->native_cache != token->original_cache)) ||
+	    READ_ONCE(current->crucible_allocator_scope) != scope ||
+	    !crucible_allocator_current(scope))
+		WRITE_ONCE(scope->failed, true);
+}
+EXPORT_SYMBOL_GPL(crucible_allocator_slab_complete);
