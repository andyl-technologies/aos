+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _LINUX_CRUCIBLE_ALLOCATOR_H
+#define _LINUX_CRUCIBLE_ALLOCATOR_H
+
+#include <linux/types.h>
+
+struct task_struct;
+struct kmem_cache;
+struct slab;
+struct crucible_allocator_scope;
+
+/* Source snapshots remain separate: slab backing and object stride overlap.
+ * Neither their sum nor this row is an exact physical resident observation. */
+struct crucible_slab_request {
+	struct kmem_cache *original_cache;
+	u64 requested_bytes;
+	u64 object_bytes;
+	u64 stride_bytes;
+	u64 slab_backing_bound;
+	u64 extension_array_bytes;
+	u32 slab_order;
+	u32 slab_objects;
+	u32 minimum_order;
+	u32 minimum_objects;
+	u32 allocation_flags;
+};
+
+/* This is the original post-hook native result. Backing may be shared with
+ * other live objects; consumers must retain its identity instead of summing
+ * the same slab pages once for each object. KFENCE has no SLUB slab identity. */
+struct crucible_slab_output {
+	void *native_object;
+	struct slab *native_slab;
+	struct kmem_cache *native_cache;
+	u64 slab_backing_bytes;
+	u64 native_stride_bytes;
+	u32 native_slab_objects;
+	bool kfence_object;
+	bool native_attempted;
+};
+
+/* All callbacks are original kernel source functions retained by the issuer.
+ * They must not allocate, sleep or publish effects. Their original owner and
+ * code lifetime must outlive every outstanding lease and completion. */
+struct crucible_allocator_ops {
+	bool (*source_current)(void *owner);
+	bool (*reserve_slab)(void *owner,
+		const struct crucible_slab_request *request, void **lease);
+	void (*complete_slab)(void *owner, void *lease,
+		const struct crucible_slab_output *output);
+};
+
+struct crucible_allocator_scope {
+	struct task_struct *original_task;
+	void *original_owner;
+	const struct crucible_allocator_ops *original_ops;
+	bool callback_active;
+	bool failed;
+};
+
+struct crucible_allocator_token {
+	struct crucible_allocator_scope *original_scope;
+	void *original_lease;
+	struct kmem_cache *original_cache;
+};
+
+/* Only a literal source issuer may enroll its current original Task. This is
+ * kernel-private constructor custody, not a userspace registration interface.
+ * A child never inherits enrollment; interrupt ownership is not inferred. */
+bool crucible_allocator_enter(struct crucible_allocator_scope *scope);
+bool crucible_allocator_leave(struct crucible_allocator_scope *scope);
+bool crucible_allocator_slab_reserve(const struct crucible_slab_request *request,
+	struct crucible_allocator_token *token);
+void crucible_allocator_slab_complete(struct crucible_allocator_token *token,
+	const struct crucible_slab_output *output);
+
+#endif
