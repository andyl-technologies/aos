+void crucible_percpu_boot_free_complete(struct crucible_percpu_boot_token token,
+	int native_result)
+{
+	struct crucible_percpu_boot_ledger *ledger = &crucible_percpu_boot_ledger;
+	struct crucible_percpu_boot_free *row;
+
+	if (!token.retained)
+		return;
+	if (token.index >= ledger->free_used)
+		goto refuse;
+	row = &ledger->frees[token.index];
+	if (row->generation != token.generation || row->native_result_known)
+		goto refuse;
+	row->native_result = native_result;
+	row->native_result_known = true;
+	if (!crucible_percpu_boot_actor_current() || ledger->failed || native_result ||
+	    !ledger->free_depth || ledger->free_stack[ledger->free_depth - 1] != token.index ||
+	    ledger->depth != row->event_depth || !ledger->root_active ||
+	    ledger->original_root != row->original_root)
+		goto refuse;
+	row->completed = true;
+	ledger->free_depth--;
+	if (row->entered_root)
+		ledger->root_active = false;
+	return;
+refuse:
+	ledger->failed = true;
 }
 
