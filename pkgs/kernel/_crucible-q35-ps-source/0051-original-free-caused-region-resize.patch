+			    original_base == __pa(event->original_old_array) && bytes == event->old_bytes) {
+				root = ledger->original_root;
+				resize = index;
+			}
+		}
+	}
+	for (index = ledger->root_used; root == U32_MAX && index > 0; index--) {
+		const struct crucible_percpu_boot_root *allocation = &ledger->roots[index - 1];
+		u64 base, limit;
+
+		if (!allocation->original_return_known || !allocation->original_return)
+			continue;
+		base = __pa(allocation->original_return);
+		if (check_add_overflow(base, allocation->requested_bytes, &limit))
+			goto refuse;
+		if (original_base >= base && end <= limit) {
+			root = index - 1;
+			break;
+		}
+	}
+	if (root == U32_MAX || (ledger->root_active && root != ledger->original_root))
+		goto refuse;
+	/* A repeated/overlapping removal of the same retained allocation cannot
+	 * become a fresh release merely because the native range was reused.
+	 */
+	for (index = 0; index < ledger->free_used; index++) {
+		const struct crucible_percpu_boot_free *previous = &ledger->frees[index];
+		u64 previous_end;
+
+		if (previous->original_root != root || previous->original_resize != resize)
+			continue;
+		if (check_add_overflow(previous->original_base, previous->requested_bytes,
+			&previous_end) || (original_base < previous_end && previous->original_base < end))
+			goto refuse;
+	}
+	row = &ledger->frees[ledger->free_used];
+	row->generation = ++ledger->generation;
+	row->original_base = original_base;
+	row->requested_bytes = bytes;
+	row->original_root = root;
+	row->original_resize = resize;
+	row->event_depth = ledger->depth;
+	row->parent = ledger->free_depth ? ledger->free_stack[ledger->free_depth - 1] : U32_MAX;
+	row->entered_root = !ledger->root_active;
+	if (row->entered_root) {
+		ledger->original_root = root;
+		ledger->root_active = true;
+	}
+	ledger->free_stack[ledger->free_depth++] = ledger->free_used;
+	token.index = ledger->free_used++;
+	token.generation = row->generation;
+	token.retained = true;
+	return token;
+refuse:
+	ledger->failed = true;
+	return token;
+}
