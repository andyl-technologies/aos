+	if (!crucible_percpu_boot_actor_current() || ledger->failed || slab_available ||
+	    !bytes || check_add_overflow(original_base, bytes, &end) ||
+	    ledger->free_depth == CRUCIBLE_PCPU_BOOT_DEPTH ||
+	    ledger->free_used == CRUCIBLE_PCPU_BOOT_EVENTS || ledger->generation == U64_MAX)
+		goto refuse;
+
