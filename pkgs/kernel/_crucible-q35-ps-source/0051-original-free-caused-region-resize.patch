+struct crucible_percpu_boot_token crucible_percpu_boot_free_begin(
+	u64 original_base, u64 bytes, bool slab_available)
+{
+	struct crucible_percpu_boot_ledger *ledger = &crucible_percpu_boot_ledger;
+	struct crucible_percpu_boot_token token = { };
+	struct crucible_percpu_boot_free *row;
+	u64 end;
+	u32 index, root = U32_MAX, resize = U32_MAX;
