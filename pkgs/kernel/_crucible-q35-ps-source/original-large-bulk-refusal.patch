+	scope = READ_ONCE(current->crucible_allocator_scope);
+	if (!scope || !in_task())
+		return true;
+	if (request && crucible_allocator_actor(scope) &&
+	    !READ_ONCE(scope->callback_active) &&
+	    scope->original_ops->refuse_uncovered) {
+		WRITE_ONCE(scope->callback_active, true);
+		scope->original_ops->refuse_uncovered(scope->original_owner, request);
+		WRITE_ONCE(scope->callback_active, false);
+	}
+	WRITE_ONCE(scope->failed, true);
+	return false;
