+static struct crucible_fdtable_record *
+crucible_fdtable_find(const struct crucible_fdtable_token *token,
+	struct crucible_fdtable_scope **scope)
+{
+	u32 index, record;
+
+	lockdep_assert_held(&crucible_fdtables.lock);
+	for (index = 0; index < CRUCIBLE_FDTABLE_SCOPES; index++) {
+		struct crucible_fdtable_scope *candidate = crucible_fdtables.scopes[index];
+
+		if (!candidate)
+			continue;
+		for (record = 0; record < candidate->records_used; record++)
+			if (token->record == &candidate->records[record] &&
+			    token->generation == candidate->records[record].generation) {
+				*scope = candidate;
+				return &candidate->records[record];
+			}
+	}
+	return NULL;
+}
+
+/* Native lifecycle selection is from the retained bank, not a candidate
+ * token. A token mismatch taints its actual owner but cannot erase cleanup.
+ */
+static struct crucible_fdtable_record *
+crucible_fdtable_live_table(struct fdtable *table, struct crucible_fdtable_scope **scope)
+{
+	struct crucible_fdtable_record *found = NULL;
+	u32 index, entry;
+
+	lockdep_assert_held(&crucible_fdtables.lock);
+	for (index = 0; index < CRUCIBLE_FDTABLE_SCOPES; index++) {
+		struct crucible_fdtable_scope *candidate = crucible_fdtables.scopes[index];
+
+		if (!candidate)
+			continue;
+		for (entry = 0; entry < candidate->records_used; entry++) {
+			struct crucible_fdtable_record *record = &candidate->records[entry];
+
+			if (record->table != table || record->free_entered ||
+			    (!record->inherited && (!record->allocation_returned || record->native_result)))
+				continue;
+			if (found) {
+				WRITE_ONCE((*scope)->uncertain, true);
+				WRITE_ONCE(candidate->uncertain, true);
+				return NULL;
+			}
+			found = record;
+			*scope = candidate;
+		}
+	}
+	return found;
+}
+
+static void crucible_fdtable_origin_check(struct fdtable *table,
+	struct crucible_fdtable_scope *scope, struct crucible_fdtable_record *record)
+{
+	if (table->crucible_origin.record != record ||
+	    table->crucible_origin.generation != record->generation) {
+		if (!record->origin_mismatch)
+			record->refused_origin = table->crucible_origin;
+		record->origin_mismatch = true;
+		WRITE_ONCE(scope->uncertain, true);
+	}
+}
+
+/* Only literal original issuer enrollment publishes the scope address. No
+ * candidate token can choose an owner without registry membership first.
+ */
+bool crucible_fdtable_enter(struct crucible_fdtable_scope *scope)
+{
+	unsigned long flags;
+	u32 index;
+	bool admitted = false;
+
+	if (!scope || !scope->owner || !scope->ops || !scope->ops->owner_is_current ||
+	    !scope->ops->admit_growth || !scope->ops->observe || !scope->ops->observe_files ||
+	    !scope->ops->observe_slot ||
+	    scope->entered ||
+	    scope->task != current || scope->mm != current->mm ||
+	    scope->files != current->files || !scope->ops->owner_is_current(scope->owner))
+		return false;
+	raw_spin_lock_irqsave(&crucible_fdtables.lock, flags);
+	for (index = 0; index < CRUCIBLE_FDTABLE_SCOPES; index++)
+		if (crucible_fdtables.scopes[index] && crucible_fdtables.scopes[index]->active &&
+		    crucible_fdtables.scopes[index]->files == scope->files) {
+			WRITE_ONCE(crucible_fdtables.scopes[index]->uncertain, true);
+			WRITE_ONCE(scope->uncertain, true);
+			raw_spin_unlock_irqrestore(&crucible_fdtables.lock, flags);
+			return false;
+		}
+	for (index = 0; index < CRUCIBLE_FDTABLE_SCOPES; index++)
+		if (!crucible_fdtables.scopes[index] && crucible_fdtables.generation != U64_MAX) {
+			crucible_fdtables.scopes[index] = scope;
+			scope->entered = true;
+			scope->active = true;
+			scope->generation = ++crucible_fdtables.generation;
+			admitted = true;
+			break;
+		}
+	raw_spin_unlock_irqrestore(&crucible_fdtables.lock, flags);
+	return admitted;
+}
+EXPORT_SYMBOL_GPL(crucible_fdtable_enter);
+
+void crucible_fdtable_leave(struct crucible_fdtable_scope *scope)
+{
+	unsigned long flags;
+	u32 index;
+
+	raw_spin_lock_irqsave(&crucible_fdtables.lock, flags);
+	for (index = 0; index < CRUCIBLE_FDTABLE_SCOPES; index++)
+		if (crucible_fdtables.scopes[index] == scope) {
+			scope->active = false;
+			break;
+		}
+	raw_spin_unlock_irqrestore(&crucible_fdtables.lock, flags);
+}
+EXPORT_SYMBOL_GPL(crucible_fdtable_leave);
+
+static struct crucible_fdtable_scope *crucible_fdtable_active(struct files_struct *files)
+{
+	struct crucible_fdtable_scope *scope;
+	u32 index;
+
+	lockdep_assert_held(&crucible_fdtables.lock);
+	for (index = 0; index < CRUCIBLE_FDTABLE_SCOPES; index++) {
+		scope = crucible_fdtables.scopes[index];
+		if (scope && scope->active && scope->files == files) {
+			if (scope->task != current || scope->mm != current->mm)
+				WRITE_ONCE(scope->uncertain, true);
+			return scope;
+		}
+	}
+	return NULL;
+}
+
+static void crucible_fdtable_observe(struct crucible_fdtable_scope *scope,
+	const struct crucible_fdtable_record *record)
+{
+	struct crucible_allocator_scope *saved = READ_ONCE(current->crucible_allocator_scope);
+	struct crucible_allocator_scope guard = {
+		.original_task = current,
+		.original_owner = scope->owner,
+		.callback_active = true,
+		.cleanup_observer = true,
+	};
+
+	WRITE_ONCE(current->crucible_allocator_scope, &guard);
+	scope->ops->observe(scope->owner, record);
+	WRITE_ONCE(current->crucible_allocator_scope, saved);
+}
+
+static bool crucible_fdtable_allocation_begin(unsigned int slots,
+	struct crucible_fdtable_token *token)
+{
+	struct crucible_fdtable_scope *scope;
+	struct crucible_fdtable_record *record;
+	struct crucible_fdtable_quote quote = {
+		.table_bytes = sizeof(struct fdtable),
+		.array_bytes = (u64)slots * sizeof(struct file *),
+		.bitmap_bytes = max_t(size_t,
+			2 * slots / BITS_PER_BYTE + BITBIT_SIZE(slots), L1_CACHE_BYTES),
+		.counter_bytes = crucible_fdtable_scratch_bytes(),
+		.native_slots = slots,
+	};
+	unsigned long flags;
+	bool admitted = true;
+
+	token->record = NULL;
+	token->generation = 0;
+	raw_spin_lock_irqsave(&crucible_fdtables.lock, flags);
+	scope = crucible_fdtable_active(current->files);
+	if (!scope || scope->task != current || scope->mm != current->mm)
+		goto unlock;
+	if (scope->uncertain || scope->records_used == CRUCIBLE_FDTABLE_RECORDS ||
+	    crucible_fdtables.generation == U64_MAX || !scope->ops->owner_is_current(scope->owner)) {
+		if (!scope->quote_refused) {
+			scope->first_refused_quote = quote;
+			scope->quote_refused = true;
+		}
+		WRITE_ONCE(scope->uncertain, true);
+		admitted = false;
+		goto unlock;
+	}
+	record = &scope->records[scope->records_used];
+	record->index = scope->records_used++;
+	record->quote = quote;
+	record->generation = ++crucible_fdtables.generation;
+	/* The actual requested tuple is retained before the original source
+	 * sink can refuse its reservation; no native allocator has run yet.
+	 */
+	admitted = scope->ops->admit_growth(scope->owner, &quote);
+	record->admitted = admitted;
+	if (admitted) {
+		record->allocation_entered = true;
+		token->record = record;
+		token->generation = record->generation;
+	} else {
+		WRITE_ONCE(scope->uncertain, true);
+	}
+unlock:
+	raw_spin_unlock_irqrestore(&crucible_fdtables.lock, flags);
+	return admitted;
+}
+
+static void crucible_fdtable_allocation_part(const struct crucible_fdtable_token *token,
+	struct fdtable *table, void *array, void *bitmaps)
+{
+	struct crucible_fdtable_scope *scope = NULL;
+	struct crucible_fdtable_record *record;
+	unsigned long flags;
+
+	if (!token->record)
+		return;
+	raw_spin_lock_irqsave(&crucible_fdtables.lock, flags);
+	record = crucible_fdtable_find(token, &scope);
+	if (record && !record->allocation_returned) {
+		record->table = table;
+		record->array = array;
+		record->bitmaps = bitmaps;
+		record->sequence++;
+	}
+	raw_spin_unlock_irqrestore(&crucible_fdtables.lock, flags);
+}
+
+static void crucible_fdtable_allocation_complete(const struct crucible_fdtable_token *token,
+	struct fdtable *result)
+{
+	struct crucible_fdtable_scope *scope = NULL;
+	struct crucible_fdtable_record *record;
+	unsigned long flags;
+
+	if (!token->record)
+		return;
+	raw_spin_lock_irqsave(&crucible_fdtables.lock, flags);
+	record = crucible_fdtable_find(token, &scope);
+	if (record && !record->allocation_returned) {
+		/* Preserve raw native outcome and every earlier allocated pointer
+		 * before any source-currentness reconciliation. Never dereference
+		 * a partial pointer after the native unwind has freed its object.
+		 */
+		record->native_result = IS_ERR(result) ? PTR_ERR(result) : 0;
+		record->allocation_returned = true;
+		record->sequence++;
+		if (!scope->ops->owner_is_current(scope->owner))
+			WRITE_ONCE(scope->uncertain, true);
+		if (!IS_ERR(result))
+			result->crucible_origin = *token;
+	}
+	raw_spin_unlock_irqrestore(&crucible_fdtables.lock, flags);
+}
+
+static void crucible_fdtable_rcu_queue_begin(struct fdtable *table,
+	struct crucible_fdtable_token *token)
+{
+	struct crucible_fdtable_scope *scope = NULL;
+	struct crucible_fdtable_record *record;
+	unsigned long flags;
+
+	token->record = NULL;
+	token->generation = 0;
+	raw_spin_lock_irqsave(&crucible_fdtables.lock, flags);
+	record = crucible_fdtable_live_table(table, &scope);
+	if (record && record->table == table && !record->rcu_queue_entered) {
+		crucible_fdtable_origin_check(table, scope, record);
+		token->record = record;
+		token->generation = record->generation;
+		record->rcu_queue_entered = true;
+		record->sequence++;
+	} else {
+		token->record = NULL;
+	}
+	raw_spin_unlock_irqrestore(&crucible_fdtables.lock, flags);
+}
+
+static void crucible_fdtable_rcu_queue_complete(struct crucible_fdtable_token *token)
+{
+	struct crucible_fdtable_scope *scope = NULL;
+	struct crucible_fdtable_record *record;
+	struct crucible_fdtable_record output;
+	bool observed = false;
+	unsigned long flags;
+
+	if (!token->record)
+		return;
+	raw_spin_lock_irqsave(&crucible_fdtables.lock, flags);
+	record = crucible_fdtable_find(token, &scope);
+	if (record && record->rcu_queue_entered && !record->rcu_queue_returned) {
+		record->rcu_queue_returned = true;
+		record->sequence++;
+		output = *record;
+		observed = true;
+	}
+	raw_spin_unlock_irqrestore(&crucible_fdtables.lock, flags);
+	if (observed)
+		crucible_fdtable_observe(scope, &output);
+	token->record = NULL;
+}
+
+static void crucible_fdtable_free_begin(struct fdtable *table, bool rcu,
+	struct crucible_fdtable_token *token)
+{
+	struct crucible_fdtable_scope *scope = NULL;
+	struct crucible_fdtable_record *record;
+	unsigned long flags;
+
+	token->record = NULL;
+	token->generation = 0;
+	raw_spin_lock_irqsave(&crucible_fdtables.lock, flags);
+	record = crucible_fdtable_live_table(table, &scope);
+	if (record && record->table == table && !record->free_entered) {
+		crucible_fdtable_origin_check(table, scope, record);
+		token->record = record;
+		token->generation = record->generation;
+		record->free_entered = true;
+		record->rcu_entered = rcu;
+		record->rcu_actor = current;
+		record->sequence++;
+		if (rcu && !record->rcu_queue_entered)
+			WRITE_ONCE(scope->uncertain, true);
+	} else {
+		token->record = NULL;
+	}
+	raw_spin_unlock_irqrestore(&crucible_fdtables.lock, flags);
+}
+
+static void crucible_fdtable_free_complete(struct crucible_fdtable_token *token)
+{
+	struct crucible_fdtable_scope *scope = NULL;
+	struct crucible_fdtable_record *record;
+	struct crucible_fdtable_record output;
+	bool observed = false;
+	unsigned long flags;
+
+	if (!token->record)
+		return;
+	raw_spin_lock_irqsave(&crucible_fdtables.lock, flags);
+	record = crucible_fdtable_find(token, &scope);
+	if (record && record->free_entered && !record->free_returned) {
+		record->free_returned = true;
+		record->sequence++;
+		output = *record;
+		observed = true;
+	}
+	raw_spin_unlock_irqrestore(&crucible_fdtables.lock, flags);
+	/* No table/files/Task dereference survives the literal native free.
+	 * The retained source scope and module pin are a separate lifetime.
+	 */
+	if (observed)
+		crucible_fdtable_observe(scope, &output);
+	token->record = NULL;
+}
+
+static bool crucible_fdtable_capture_existing(struct files_struct *files,
+	struct fdtable *table)
+{
+	struct crucible_fdtable_scope *scope;
+	struct crucible_fdtable_scope *old_scope = NULL;
+	struct crucible_fdtable_record *record;
+	unsigned long flags;
+	bool admitted = true;
+
+	lockdep_assert_held(&files->file_lock);
+	raw_spin_lock_irqsave(&crucible_fdtables.lock, flags);
+	scope = crucible_fdtable_active(files);
+	if (!scope || scope->task != current)
+		goto unlock;
+	record = crucible_fdtable_live_table(table, &old_scope);
+	if (record) {
+		crucible_fdtable_origin_check(table, old_scope, record);
+		if (old_scope != scope) {
+			WRITE_ONCE(scope->uncertain, true);
+			admitted = false;
+		}
+		if (scope->uncertain)
+			admitted = false;
+		goto unlock;
+	}
+	if (old_scope) {
+		WRITE_ONCE(scope->uncertain, true);
+		admitted = false;
+		goto unlock;
+	}
+	if (scope->uncertain || scope->records_used == CRUCIBLE_FDTABLE_RECORDS ||
+	    crucible_fdtables.generation == U64_MAX || !scope->ops->owner_is_current(scope->owner)) {
+		WRITE_ONCE(scope->uncertain, true);
+		admitted = false;
+		goto unlock;
+	}
+	record = &scope->records[scope->records_used];
+	record->index = scope->records_used++;
+	record->generation = ++crucible_fdtables.generation;
+	record->table = table;
+	record->array = table->fd;
+	record->bitmaps = table->open_fds;
+	record->original_slots = table->max_fds;
+	record->inherited = true;
+	record->embedded = table == &files->fdtab;
+	/* This is a native lifetime origin, not invented allocator provenance.
+	 * Existing shared backing cannot be refunded from this adoption alone.
+	 */
+	table->crucible_origin.record = record;
+	table->crucible_origin.generation = record->generation;
+unlock:
+	raw_spin_unlock_irqrestore(&crucible_fdtables.lock, flags);
+	return admitted;
+}
+
+static void crucible_fdtable_publication(struct fdtable *table, bool returned)
+{
+	struct crucible_fdtable_scope *scope = NULL;
+	struct crucible_fdtable_record *record;
+	unsigned long flags;
+
+	raw_spin_lock_irqsave(&crucible_fdtables.lock, flags);
+	record = crucible_fdtable_find(&table->crucible_origin, &scope);
+	if (record && record->table == table) {
+		if (returned)
+			record->publication_returned = true;
+		else
+			record->publication_entered = true;
+		record->sequence++;
+	}
+	raw_spin_unlock_irqrestore(&crucible_fdtables.lock, flags);
+}
+
+static void crucible_fdtable_slot_begin(struct files_struct *files)
+{
+	struct crucible_fdtable_scope *scope;
+	unsigned long flags;
+
+	lockdep_assert_held(&files->file_lock);
+	raw_spin_lock_irqsave(&crucible_fdtables.lock, flags);
+	scope = crucible_fdtable_active(files);
+	if (scope && scope->task == current) {
+		if (scope->slot_returned)
+			WRITE_ONCE(scope->uncertain, true);
+		else
+			scope->next_fd_before = files->next_fd;
+	}
+	raw_spin_unlock_irqrestore(&crucible_fdtables.lock, flags);
+}
+
+static void crucible_fdtable_slot_return(struct files_struct *files, int result)
+{
+	struct crucible_fdtable_scope *scope;
+	unsigned long flags;
+
+	lockdep_assert_held(&files->file_lock);
+	raw_spin_lock_irqsave(&crucible_fdtables.lock, flags);
+	scope = crucible_fdtable_active(files);
+	if (scope && scope->task == current && !scope->slot_returned) {
+		scope->slot_result = result;
+		scope->next_fd_after = files->next_fd;
+		scope->slot_returned = true;
+		scope->sequence++;
+		if (!scope->ops->owner_is_current(scope->owner))
+			WRITE_ONCE(scope->uncertain, true);
+	}
+	raw_spin_unlock_irqrestore(&crucible_fdtables.lock, flags);
+}
+
+static void crucible_fdtable_slot_release(struct files_struct *files, unsigned int fd)
+{
+	struct crucible_fdtable_scope *scope;
+	unsigned long flags;
+
+	lockdep_assert_held(&files->file_lock);
+	raw_spin_lock_irqsave(&crucible_fdtables.lock, flags);
+	scope = crucible_fdtable_active(files);
+	if (scope && scope->task == current) {
+		if (!scope->slot_returned || scope->slot_result != fd || scope->slot_released)
+			WRITE_ONCE(scope->uncertain, true);
+		scope->slot_released = true;
+		scope->sequence++;
+	}
+	raw_spin_unlock_irqrestore(&crucible_fdtables.lock, flags);
+}
+
+/* Registry membership precedes following a returned native install token.
+ * Scope slots and generations are retained, never recycled by this stage.
+ */
+static struct crucible_fdtable_scope *
+crucible_fdtable_install_origin(const struct crucible_fdtable_install_token *token)
+{
+	u32 index;
+
+	lockdep_assert_held(&crucible_fdtables.lock);
+	for (index = 0; index < CRUCIBLE_FDTABLE_SCOPES; index++) {
+		struct crucible_fdtable_scope *scope = crucible_fdtables.scopes[index];
+
+		if (scope && token->original_scope == scope && token->generation == scope->generation)
+			return scope;
+	}
+	return NULL;
+}
+
+static void crucible_fdtable_install(struct files_struct *files, unsigned int fd,
+	struct file *file, bool returned, struct crucible_fdtable_install_token *token)
+{
+	struct crucible_fdtable_scope *scope;
+	unsigned long flags;
+
+	if (!returned) {
+		token->original_scope = NULL;
+		token->generation = 0;
+	}
+	raw_spin_lock_irqsave(&crucible_fdtables.lock, flags);
+	if (returned) {
+		scope = crucible_fdtable_install_origin(token);
+		if (!scope)
+			goto unlock;
+		if (scope->files != files || scope->installed_fd != fd ||
+		    scope->installed_file != file || !scope->install_entered ||
+		    scope->install_generation != token->generation || scope->installed) {
+			WRITE_ONCE(scope->uncertain, true);
+			goto unlock;
+		}
+		/* This is the original native return, not proof of a still-live
+		 * slot. A shared peer may already have cleared or replaced it.
+		 * Do not inspect the File or rewrite that earlier clear receipt.
+		 */
+		scope->installed = true;
+		if (scope->task != current || scope->mm != current->mm || scope->files != current->files)
+			WRITE_ONCE(scope->uncertain, true);
+	} else {
+		scope = crucible_fdtable_active(files);
+		if (!scope || scope->task != current)
+			goto unlock;
+		if (scope->install_entered) {
+			WRITE_ONCE(scope->uncertain, true);
+			goto unlock;
+		}
+		if (!scope->slot_returned || scope->slot_result != fd || scope->slot_released || !file)
+			WRITE_ONCE(scope->uncertain, true);
+		scope->install_entered = true;
+		scope->install_generation = scope->generation;
+		scope->installed_fd = fd;
+		scope->installed_file = file;
+		token->original_scope = scope;
+		token->generation = scope->generation;
+	}
+	scope->sequence++;
+unlock:
+	raw_spin_unlock_irqrestore(&crucible_fdtables.lock, flags);
+	if (returned) {
+		token->original_scope = NULL;
+		token->generation = 0;
+	}
+}
+
+static void crucible_fdtable_mutation(struct files_struct *files)
+{
+	unsigned long flags;
+
+	raw_spin_lock_irqsave(&crucible_fdtables.lock, flags);
+	/* A foreign Task can still finish its ordinary safe native operation.
+	 * It cannot leave the selected constructor's source cut falsely clean.
+	 */
+	{
+		struct crucible_fdtable_scope *scope = crucible_fdtable_active(files);
+
+		if (scope)
+			WRITE_ONCE(scope->uncertain, true);
+	}
+	raw_spin_unlock_irqrestore(&crucible_fdtables.lock, flags);
+}
+
+static void crucible_fdtable_files_free_begin(struct files_struct *files,
+	struct crucible_fdtable_files_token *token)
+{
+	struct crucible_fdtable_scope *scope;
+	unsigned long flags;
+	u32 index;
+
+	token->scopes = 0;
+	raw_spin_lock_irqsave(&crucible_fdtables.lock, flags);
+	for (index = 0; index < CRUCIBLE_FDTABLE_SCOPES; index++) {
+		scope = crucible_fdtables.scopes[index];
+		if (!scope || scope->files != files || scope->files_lifetime.entered)
+			continue;
+		scope->files_lifetime.files = files;
+		scope->files_lifetime.actor = current;
+		scope->files_lifetime.generation = scope->generation;
+		scope->files_lifetime.entered = true;
+		if (scope->installed && !scope->slot_lifetime.entered) {
+			scope->slot_lifetime.original = scope->installed_file;
+			scope->slot_lifetime.descriptor = scope->installed_fd;
+			scope->slot_lifetime.generation = scope->generation;
+			scope->slot_lifetime.actor = current;
+			scope->slot_lifetime.entered = true;
+			scope->slot_lifetime.files_retired = true;
+		}
+		{
+			u32 entry;
+
+			for (entry = 0; entry < scope->records_used; entry++)
+				if (scope->records[entry].embedded) {
+					scope->records[entry].free_entered = true;
+					scope->records[entry].sequence++;
+				}
+		}
+		scope->active = false;
+		token->scopes |= 1U << index;
+	}
+	raw_spin_unlock_irqrestore(&crucible_fdtables.lock, flags);
+}
+
+static void crucible_fdtable_files_free_complete(struct crucible_fdtable_files_token *token)
+{
+	struct crucible_fdtable_scope *scope;
+	struct crucible_fdtable_files_output output;
+	unsigned long flags;
+	u32 index;
+
+	for (index = 0; index < CRUCIBLE_FDTABLE_SCOPES; index++) {
+		struct crucible_allocator_scope *saved;
+		struct crucible_allocator_scope guard = {
+			.original_task = current,
+			.callback_active = true,
+			.cleanup_observer = true,
+		};
+
+		if (!(token->scopes & (1U << index)))
+			continue;
+		raw_spin_lock_irqsave(&crucible_fdtables.lock, flags);
+		scope = crucible_fdtables.scopes[index];
+		if (!scope || !scope->files_lifetime.entered || scope->files_lifetime.returned) {
+			raw_spin_unlock_irqrestore(&crucible_fdtables.lock, flags);
+			continue;
+		}
+		scope->files_lifetime.returned = true;
+		if (scope->slot_lifetime.files_retired)
+			scope->slot_lifetime.returned = true;
+		{
+			u32 entry;
+
+			for (entry = 0; entry < scope->records_used; entry++)
+				if (scope->records[entry].embedded) {
+					scope->records[entry].free_returned = true;
+					scope->records[entry].sequence++;
+				}
+		}
+		scope->files_lifetime.slot = scope->slot_lifetime;
+		output = scope->files_lifetime;
+		raw_spin_unlock_irqrestore(&crucible_fdtables.lock, flags);
+		/* The files address is now historical. The source bank and code
+		 * remain owned independently; no freed files_struct is followed.
+		 */
+		saved = READ_ONCE(current->crucible_allocator_scope);
+		WRITE_ONCE(current->crucible_allocator_scope, &guard);
+		scope->ops->observe_files(scope->owner, &output);
+		WRITE_ONCE(current->crucible_allocator_scope, saved);
+	}
+	token->scopes = 0;
+}
+
+static void crucible_fdtable_part_free(const struct crucible_fdtable_token *token,
+	unsigned int part, bool returned)
+{
+	struct crucible_fdtable_scope *scope = NULL;
+	struct crucible_fdtable_record *record;
+	unsigned long flags;
+
+	if (!token->record || part >= 3)
+		return;
+	raw_spin_lock_irqsave(&crucible_fdtables.lock, flags);
+	record = crucible_fdtable_find(token, &scope);
+	if (record) {
+		if (returned)
+			record->part_free_returned[part] = true;
+		else
+			record->part_free_entered[part] = true;
+		record->sequence++;
+	}
+	raw_spin_unlock_irqrestore(&crucible_fdtables.lock, flags);
+}
+
+static void crucible_fdtable_slot_clear_begin(struct files_struct *files,
+	unsigned int fd, struct file *original, struct file *replacement,
+	struct crucible_fdtable_slot_token *token)
+{
+	struct crucible_fdtable_scope *scope;
+	struct fdtable *table;
+	unsigned long flags;
+	u32 index;
+
+	token->scopes = 0;
+	lockdep_assert_held(&files->file_lock);
+	table = files_fdtable(files);
+	/* Native close/dup2 has observed this non-NULL pointer under file_lock.
+	 * Entry, not returned-history, owns the publication window. The later
+	 * original return must not revive a slot already cleared by a peer.
+	 */
+	if (!original || fd >= table->max_fds || rcu_access_pointer(table->fd[fd]) != original)
+		return;
+	raw_spin_lock_irqsave(&crucible_fdtables.lock, flags);
+	for (index = 0; index < CRUCIBLE_FDTABLE_SCOPES; index++) {
+		scope = crucible_fdtables.scopes[index];
+		if (!scope || scope->files != files || !scope->install_entered ||
+		    scope->install_generation != scope->generation || scope->files_lifetime.entered ||
+		    scope->installed_fd != fd || scope->installed_file != original ||
+		    scope->slot_lifetime.entered)
+			continue;
+		scope->slot_lifetime.original = original;
+		scope->slot_lifetime.replacement = replacement;
+		scope->slot_lifetime.descriptor = fd;
+		scope->slot_lifetime.generation = scope->generation;
+		scope->slot_lifetime.actor = current;
+		scope->slot_lifetime.entered = true;
+		token->scopes |= 1U << index;
+	}
+	raw_spin_unlock_irqrestore(&crucible_fdtables.lock, flags);
+}
+
+static void crucible_fdtable_slot_clear_complete(struct crucible_fdtable_slot_token *token)
+{
+	struct crucible_fdtable_scope *scope;
+	struct crucible_fdtable_slot_output output;
+	unsigned long flags;
+	u32 index;
+
+	for (index = 0; index < CRUCIBLE_FDTABLE_SCOPES; index++) {
+		struct crucible_allocator_scope *saved;
+		struct crucible_allocator_scope guard = {
+			.original_task = current,
+			.callback_active = true,
+			.cleanup_observer = true,
+		};
+
+		if (!(token->scopes & (1U << index)))
+			continue;
+		raw_spin_lock_irqsave(&crucible_fdtables.lock, flags);
+		scope = crucible_fdtables.scopes[index];
+		if (!scope || !scope->slot_lifetime.entered || scope->slot_lifetime.returned) {
+			raw_spin_unlock_irqrestore(&crucible_fdtables.lock, flags);
+			continue;
+		}
+		scope->slot_lifetime.returned = true;
+		output = scope->slot_lifetime;
+		raw_spin_unlock_irqrestore(&crucible_fdtables.lock, flags);
+		saved = READ_ONCE(current->crucible_allocator_scope);
+		WRITE_ONCE(current->crucible_allocator_scope, &guard);
+		scope->ops->observe_slot(scope->owner, &output);
+		WRITE_ONCE(current->crucible_allocator_scope, saved);
+	}
+	token->scopes = 0;
+}
