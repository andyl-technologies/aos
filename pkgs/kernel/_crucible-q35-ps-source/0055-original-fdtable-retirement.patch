+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Original CREATE/files and real fdtable generations. This is independent of
+ * the Task-local allocator scope: RCU callbacks get no allocation permission.
+ * Registry entries and original record generations are never recycled here.
+ */
+
+#define CRUCIBLE_FDTABLE_SCOPES 8U
+
+struct crucible_fdtable_registry {
+	struct crucible_fdtable_scope *scopes[CRUCIBLE_FDTABLE_SCOPES];
+	raw_spinlock_t lock;
+	u64 generation;
+} __aligned(PAGE_SIZE);
+
+static struct crucible_fdtable_registry crucible_fdtables = {
+	.lock = __RAW_SPIN_LOCK_UNLOCKED(crucible_fdtables.lock),
+};
+
+u64 crucible_fdtable_registry_bytes(void)
+{
+	return sizeof(crucible_fdtables);
+}
+EXPORT_SYMBOL_GPL(crucible_fdtable_registry_bytes);
