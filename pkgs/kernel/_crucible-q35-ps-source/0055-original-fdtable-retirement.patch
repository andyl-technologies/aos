+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Source-born object origins outlive the allocating Task and RCU callbacks.
+ * Object return and slab page handback are distinct native observations.
+ * Neither recycles a reservation or certifies shared backing reclamation.
+ */
+
+#define CRUCIBLE_RETIREMENT_RECORDS 256U
+
+enum crucible_retirement_phase {
+	CRUCIBLE_RETIREMENT_RESERVED = 1,
+	CRUCIBLE_RETIREMENT_BOUND,
+	CRUCIBLE_RETIREMENT_FAILED,
+	CRUCIBLE_RETIREMENT_CLOSING,
+	CRUCIBLE_RETIREMENT_RETURNED,
+};
+
+struct crucible_retirement_origin {
+	void *owner;
+	const struct crucible_allocator_ops *ops;
+	void *lease;
+	u64 generation;
+	u32 phase;
+	struct crucible_slab_request request;
+	struct crucible_slab_retirement output;
+};
+
+struct crucible_retirement_bank {
+	struct crucible_retirement_origin records[CRUCIBLE_RETIREMENT_RECORDS];
+	raw_spinlock_t lock;
+	u32 used;
+	u64 generation;
+	u64 group_generation;
+} __aligned(PAGE_SIZE);
+
+static struct crucible_retirement_bank crucible_retirements = {
+	.lock = __RAW_SPIN_LOCK_UNLOCKED(crucible_retirements.lock),
+};
+
+u64 crucible_allocator_retirement_metadata_bytes(void)
+{
+	return sizeof(crucible_retirements);
+}
+EXPORT_SYMBOL_GPL(crucible_allocator_retirement_metadata_bytes);
+
+/* These are additional typed logical windows, not compiler stack residency.
+ * The producer owns the returned output separately from the observer's loan.
+ */
+u64 crucible_allocator_retirement_scratch_bytes(void)
+{
+	/* Source-declared direct windows, summed conservatively across
+	 * sequential paths. This DATA is neither a compiler-frame layout
+	 * nor transitive allocator/implicit-temporary coverage.
+	 */
+	struct controls {
+		struct {
+			const struct crucible_retirement_token *token_0;
+			u32 index_1;
+			struct crucible_retirement_origin *returned_value_2;
+		} crucible_retirement_find;
+		struct {
+			struct crucible_allocator_scope *scope_0;
+			const struct crucible_slab_request *request_1;
+			struct crucible_retirement_token *token_2;
+			struct crucible_retirement_origin *origin_3;
+			unsigned long flags_4;
+			bool returned_value_5;
+		} crucible_retirement_reserve;
+		struct {
+			struct crucible_retirement_token *token_0;
+			void *lease_1;
+			const struct crucible_slab_output *output_2;
+			struct crucible_retirement_origin *origin_3;
+			unsigned long flags_4;
+		} crucible_retirement_bind;
+		struct {
+			struct crucible_retirement_origin *origin_0;
+			const struct crucible_slab_retirement *output_1;
+			struct crucible_allocator_scope *saved_2;
+			struct crucible_allocator_scope guard_3;
+		} crucible_retirement_observe;
+		struct {
+			struct kmem_cache *cache_0;
+			struct slab *slab_1;
+			const void *object_2;
+			struct crucible_retirement_token *token_3;
+			struct crucible_retirement_origin *origin_4;
+			struct crucible_slab_retirement output_5;
+			unsigned long flags_6;
+			u32 index_7;
+			struct crucible_retirement_origin *candidate_8;
+		} crucible_allocator_object_free_begin;
+		struct {
+			struct crucible_retirement_token *token_0;
+			struct crucible_retirement_origin *origin_1;
+			struct crucible_slab_retirement output_2;
+			unsigned long flags_3;
+		} crucible_allocator_object_free_complete;
+		struct {
+			struct kmem_cache *cache_0;
+			struct slab *slab_1;
+			struct crucible_retirement_group *group_2;
+			struct crucible_retirement_origin *origin_3;
+			unsigned long flags_4;
+			u32 index_5;
+		} crucible_allocator_slab_free_begin;
+		struct {
+			struct crucible_retirement_group *group_0;
+			struct crucible_retirement_origin *origin_1;
+			struct crucible_slab_retirement output_2;
+			unsigned long flags_3;
+			u32 index_4;
+		} crucible_allocator_slab_free_complete;
+		struct {
+			struct kmem_cache *cache_0;
+			size_t count_1;
+			void **objects_2;
+			struct crucible_retirement_group *group_3;
+			struct crucible_retirement_origin *origin_4;
+			unsigned long flags_5;
+			u32 index_6;
+			size_t object_7;
+		} crucible_allocator_objects_free_begin;
+		struct {
+			struct crucible_retirement_group *group_0;
+			struct crucible_retirement_origin *origin_1;
+			struct crucible_slab_retirement output_2;
+			unsigned long flags_3;
+			u32 index_4;
+		} crucible_allocator_objects_free_complete;
+		struct {
+			struct kmem_cache *s_0;
+			struct slab *slab_1;
+			void *object_2;
+			unsigned long addr_3;
+			struct crucible_retirement_token retirement_4;
+		} slab_free;
+		struct {
+			struct kmem_cache *s_0;
+			size_t size_1;
+			void **p_2;
+			struct crucible_retirement_group retirement_3;
+		} kmem_cache_free_bulk;
+		struct {
+			struct crucible_retirement_group retirement_0;
+		} native_page_handback;
+		struct {
+			u64 returned_0[2];
+		} counter_returns;
+	};
+
+	return sizeof(struct controls);
+}
+EXPORT_SYMBOL_GPL(crucible_allocator_retirement_scratch_bytes);
