+static struct crucible_retirement_origin *
+crucible_retirement_find(const struct crucible_retirement_token *token)
+{
+	u32 index;
+
+	lockdep_assert_held(&crucible_retirements.lock);
+	for (index = 0; index < crucible_retirements.used; index++)
+		if (token->original_record == &crucible_retirements.records[index] &&
+		    token->generation == crucible_retirements.records[index].generation)
+			return &crucible_retirements.records[index];
+	return NULL;
+}
+
+/* Reservation is before the literal slab producer. A refused origin is kept;
+ * there is no allocation or registry renewal hidden in a completion callback.
+ */
+static bool crucible_retirement_reserve(struct crucible_allocator_scope *scope,
+	const struct crucible_slab_request *request, struct crucible_retirement_token *token)
+{
+	struct crucible_retirement_origin *origin;
+	unsigned long flags;
+
+	token->original_record = NULL;
+	token->generation = 0;
+	if (!scope->original_ops->observe_slab_retirement)
+		return true;
+
+	raw_spin_lock_irqsave(&crucible_retirements.lock, flags);
+	if (crucible_retirements.used == CRUCIBLE_RETIREMENT_RECORDS ||
+	    crucible_retirements.generation == U64_MAX) {
+		raw_spin_unlock_irqrestore(&crucible_retirements.lock, flags);
+		return false;
+	}
+	origin = &crucible_retirements.records[crucible_retirements.used++];
+	origin->request = *request;
+	origin->owner = scope->original_owner;
+	origin->ops = scope->original_ops;
+	origin->generation = ++crucible_retirements.generation;
+	origin->phase = CRUCIBLE_RETIREMENT_RESERVED;
+	origin->output.generation = origin->generation;
+	token->original_record = origin;
+	token->generation = origin->generation;
+	raw_spin_unlock_irqrestore(&crucible_retirements.lock, flags);
+	return true;
+}
+
+static void crucible_retirement_bind(struct crucible_retirement_token *token,
+	void *lease, const struct crucible_slab_output *output)
+{
+	struct crucible_retirement_origin *origin;
+	unsigned long flags;
+
+	if (!token->original_record)
+		return;
+	raw_spin_lock_irqsave(&crucible_retirements.lock, flags);
+	origin = crucible_retirement_find(token);
+	if (origin && origin->phase == CRUCIBLE_RETIREMENT_RESERVED) {
+		origin->lease = lease;
+		origin->output.allocation = *output;
+		origin->phase = output->native_object && !output->kfence_object &&
+			output->native_slab && output->native_cache ?
+			CRUCIBLE_RETIREMENT_BOUND : CRUCIBLE_RETIREMENT_FAILED;
+	}
+	raw_spin_unlock_irqrestore(&crucible_retirements.lock, flags);
+	token->original_record = NULL;
+}
+
+static void crucible_retirement_observe(struct crucible_retirement_origin *origin,
