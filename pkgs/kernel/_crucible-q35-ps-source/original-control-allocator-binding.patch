+/* These callbacks run in the allocator, including its atomic paths. They use
+ * only the precharged original bank and never allocate or take the registry
+ * mutex. The module/Task/mm references were retained by original PREPARE. */
+static bool crucible_resource_allocator_current(void *owner)
+{
+	struct kvm_crucible_kernel_resource_context *context = owner;
+	u32 control = READ_ONCE(context->current_delivery);
+
+	return READ_ONCE(context->prepared) && !READ_ONCE(context->closed) &&
+		control < ARRAY_SIZE(context->delivery_scopes) &&
+		READ_ONCE(context->delivery_scope_active[control]) &&
+		context->original_task == current && context->original_mm == current->mm &&
+		context->original_file && context->original_file->f_op == &kvm_chardev_ops;
+}
+
+static bool crucible_resource_allocator_reserve(void *owner,
+	const struct crucible_slab_request *request, void **lease)
+{
+	struct kvm_crucible_kernel_resource_context *context = owner;
+	struct kvm_crucible_resource_allocation *row;
+	unsigned long flags;
+	u64 bound, reserved;
+	u32 control = READ_ONCE(context->current_delivery);
+	bool admitted = false;
+
+	*lease = NULL;
+	raw_spin_lock_irqsave(&context->allocator_lock, flags);
+	if (!crucible_resource_allocator_current(context) || context->uncertain ||
+	    context->allocations_used >= CRUCIBLE_RESOURCE_ALLOCATION_ROWS ||
+	    ktime_get_ns() > context->input.constructor_deadline_ns)
+		goto refuse;
+	/* This is a conservative reservation bound, not a resident sum. The
+	 * object stride, fresh slab and extension array can overlap physically;
+	 * all three source facts remain separately retained in the journal. */
+	if (check_add_overflow(request->stride_bytes, request->slab_backing_bound, &bound) ||
+	    check_add_overflow(bound, request->extension_array_bytes, &bound) ||
+	    check_add_overflow(context->reserved_bytes, bound, &reserved) ||
+	    reserved > context->input.reserved_ceiling ||
+	    reserved > context->input.peak_ceiling ||
+	    bound > context->input.transient_ceiling)
+		goto refuse;
+
+	row = &context->allocations[context->allocations_used++];
+	row->actor = current;
+	row->vm = context->original_vm;
+	row->generation = context->generation;
+	row->slab_request = *request;
+	row->control_index = control;
+	row->requested_bytes = request->requested_bytes;
+	row->quoted_rounded_bytes = request->stride_bytes;
+	row->reserved_bytes = bound;
+	row->source_reservation_known = true;
+	row->state = 1;
+	context->reserved_bytes = reserved;
+	*lease = row;
+	admitted = true;
+	goto unlock;
+
+refuse:
+	WRITE_ONCE(context->uncertain, true);
+unlock:
+	raw_spin_unlock_irqrestore(&context->allocator_lock, flags);
+	return admitted;
+}
+
+static void crucible_resource_allocator_complete(void *owner, void *lease,
+	const struct crucible_slab_output *output)
+{
+	struct kvm_crucible_kernel_resource_context *context = owner;
+	struct kvm_crucible_resource_allocation *row = NULL;
+	unsigned long flags;
+	u32 index;
+
+	raw_spin_lock_irqsave(&context->allocator_lock, flags);
+	/* Validate against original retained row addresses without dereferencing
+	 * a supplied pointer or manufacturing membership from pointer arithmetic. */
+	for (index = 0; index < context->allocations_used; index++)
+		if (lease == &context->allocations[index]) {
+			row = &context->allocations[index];
+			break;
+		}
+	if (!row || row->state != 1 || !row->source_reservation_known) {
+		WRITE_ONCE(context->uncertain, true);
+		goto unlock;
+	}
+	/* Cache the native producer output before ANY source phase check. NULL
+	 * does not imply no internal allocation or no native transient effects. */
+	row->slab_output = *output;
+	row->original_pointer = output->native_object;
+	row->observed_rounded_bytes = output->native_stride_bytes;
+	row->native_attempted = output->native_attempted;
+	row->native_known = true;
+	row->state = 2;
+	if (!crucible_resource_allocator_current(context) || row->actor != current ||
+	    row->generation != context->generation || row->vm != context->original_vm ||
+	    row->control_index != context->current_delivery || output->kfence_object ||
+	    (output->native_object && output->native_cache != row->slab_request.original_cache))
+		WRITE_ONCE(context->uncertain, true);
+	/* Retirement, internal metadata and other allocator families are not
+	 * installed. A raw result is Known; its complete live ownership is not.
+	 * Preserve the original charge and bank until that gap is resolved. */
+	if (output->native_attempted)
+		WRITE_ONCE(context->uncertain, true);
+unlock:
+	raw_spin_unlock_irqrestore(&context->allocator_lock, flags);
+}
+
+static const struct crucible_allocator_ops crucible_resource_allocator_ops = {
