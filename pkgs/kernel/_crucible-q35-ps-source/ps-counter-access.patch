+/* Guest counter effects require the fresh loaded readback from this same RUN.
+ * Cold constructor output and a physical ceiling alone cannot grant access. */
+static bool clock_ps_counter_live_locked(struct kvm_vcpu *vcpu, bool host)
+{
+	struct kvm *kvm = vcpu->kvm;
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	struct kvm_crucible_run_return_state *run = &vcpu->crucible_run_return;
+
+	lockdep_assert_held(&kvm->crucible_gate_lock);
+	return !host && !in_interrupt() && !kvm->crucible_irq_input.tainted &&
+		clock->ps.phase == KVM_CRUCIBLE_PS_ACTIVE &&
+		kvm_crucible_clock_admission_live(clock->active,
+			kvm->crucible_host_ceiling_ns, ktime_get_ns()) &&
+		q35_ps_run_counter_current_locked(vcpu) &&
+		run->ps_counter_attempted && run->ps_counter_known &&
+		!run->ps_counter_result;
+}
+
+/* Seal clock admission before containment; no timer is canceled here. */
+static void clock_counter_fault_locked(struct kvm *kvm)
+{
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+
+	lockdep_assert_held(&kvm->crucible_gate_lock);
+	if (clock->ps.selected && clock->ps.plan.version == 2) {
+		clock->ps.current_ps = q35_ps_now_locked(clock, ktime_get_ns());
+		clock->frozen_ns = clock->ps.current_ps / 1000;
+		clock->active = false;
+		kvm->crucible_active = false;
+		clock->close_acknowledged = false;
+		clock->ps.phase = KVM_CRUCIBLE_PS_UNKNOWN;
+	}
+	kvm_arch_crucible_irq_taint_locked(kvm);
+}
