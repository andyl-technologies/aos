+/* Guest reads never use the pre-roster host-initialization inverse. */
+static bool clock_ps_counter_read_admit(struct kvm_vcpu *vcpu)
+{
+	struct kvm *kvm = vcpu->kvm;
+	unsigned long flags;
+	bool valid;
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	valid = clock_ps_counter_live_locked(vcpu, false);
+	if (!valid)
+		clock_counter_fault_locked(kvm);
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	if (!valid)
+		kvm_vm_dead(kvm);
+	return valid;
+}
+
+/* The typed LAPIC arm/output owner is not installed yet. Refuse deadline
+ * writes before the legacy cancellation/restart path can change native work. */
+static int clock_tsc_write_prepare(struct kvm_vcpu *vcpu, bool host)
+{
+	struct kvm *kvm = vcpu->kvm;
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	unsigned long flags;
+	bool ps_v2 = READ_ONCE(clock->ps.selected) &&
+		READ_ONCE(clock->ps.plan.version) == 2;
+
+	if (!READ_ONCE(kvm->crucible_continuation_roster_frozen) ||
+	    (!ps_v2 && !READ_ONCE(kvm->crucible_irq_input.enabled)))
+		return 0;
+	if (!clock_tsc_writer_admit(vcpu, host))
+		return -EAGAIN;
+	if (ps_v2) {
+		if (kvm_crucible_lapic_tsc_prepare_write(vcpu))
+			return 0;
+		raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+		clock_counter_fault_locked(kvm);
+		raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+		kvm_vm_dead(kvm);
+		return -EOPNOTSUPP;
+	}
+	return kvm_crucible_lapic_tsc_prepare_write(vcpu) ? 0 : -EAGAIN;
+}
