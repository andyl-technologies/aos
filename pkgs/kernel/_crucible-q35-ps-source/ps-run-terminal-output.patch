+bool kvm_arch_crucible_q35_ps_worker_current_locked(struct kvm_vcpu *vcpu)
+{
+	struct kvm *kvm = vcpu->kvm;
+	struct kvm_crucible_pic_board *board = &kvm->arch.crucible_pic_board;
+	struct kvm_crucible_pic_initializer_state *actor;
+	struct kvm_crucible_q35_counter_row *counter;
+	u32 index;
+
+	lockdep_assert_held(&kvm->crucible_gate_lock);
+	lockdep_assert_held(&vcpu->mutex);
+	if (vcpu->vcpu_id >= 4 || kvm_get_vcpu(kvm, vcpu->vcpu_id) != vcpu ||
+	    !board->initializer_roster.selected || board->initializer_roster.uncertain ||
+	    READ_ONCE(kvm->vm_dead))
+		return false;
+	actor = &board->initializer_roster.actors[vcpu->vcpu_id];
+	counter = &board->counter_rows[vcpu->vcpu_id];
+	if (actor->task != current || actor->vcpu != vcpu ||
+	    actor->native_vcpu_id != vcpu->vcpu_id || actor->inflight || actor->uncertain ||
+	    !actor->issued || actor->issued > actor->maximum_effects ||
+	    counter->task != current || counter->vcpu != vcpu || !counter->applied ||
+	    counter->inflight || counter->uncertain || !counter->known || counter->native_result ||
+	    counter->original.configuration_enrollment_id != board->q35_configuration.enrollment_id ||
+	    counter->original.enrollment_id != actor->enrollment_id ||
+	    counter->original.initializer_tid != actor->initializer_tid ||
+	    counter->original.native_vcpu_id != vcpu->vcpu_id ||
+	    counter->output.observed_coverage != KVM_CRUCIBLE_Q35_COUNTER_COVERAGE ||
+	    counter->output.flags != (KVM_CRUCIBLE_Q35_COUNTER_KNOWN |
+		KVM_CRUCIBLE_Q35_COUNTER_LOADED | KVM_CRUCIBLE_Q35_COUNTER_CONSTRUCTOR))
+		return false;
