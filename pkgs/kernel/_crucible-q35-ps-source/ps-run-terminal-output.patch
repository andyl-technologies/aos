+/* The original vCPU mutex retains every byte/result across this readback.
+ * Mechanical completion may follow its original RUN, but a stale last STEP
+ * or mutable kvm_run exit view cannot stand in for this invocation's output.
+ */
+bool kvm_crucible_response_bytes_closed_locked(struct kvm_vcpu *vcpu, u64 generation)
+{
+	struct kvm_crucible_response_bytes_state *bytes = vcpu->crucible_response_bytes;
+	const struct kvm_crucible_run_return *run = &vcpu->crucible_run_return.original;
+	struct kvm_crucible_response_state *state = &vcpu->crucible_response;
+	const struct kvm_crucible_response_bytes *request, *result;
+
+	lockdep_assert_held(&vcpu->mutex);
+	lockdep_assert_held(&vcpu->kvm->crucible_gate_lock);
+	if (!bytes || !generation || bytes->active_input || bytes->fragment.valid ||
+	    state->flags || kvm_crucible_response_pending(state) ||
+	    (state->phase != KVM_CRUCIBLE_COMPLETION_EMPTY &&
+	     state->phase != KVM_CRUCIBLE_COMPLETION_DONE))
+		return false;
+	if (!run->pending_mask)
+		return true;
+	request = &bytes->last_request;
+	result = &bytes->last_result;
+	return bytes->result_known && state->phase == KVM_CRUCIBLE_COMPLETION_DONE &&
+		state->sequence == state->consumed_sequence && !result->flags &&
+		request->operation == KVM_CRUCIBLE_RESPONSE_BYTES_STEP && request->operation_id &&
+		request->expected_invocation == run->invocation &&
+		request->expected_generation == generation &&
+		request->expected_sequence == state->consumed_sequence &&
+		result->operation_id == request->operation_id && result->invocation == run->invocation &&
+		result->native_vcpu_id == vcpu->vcpu_id &&
+		result->phase == KVM_CRUCIBLE_COMPLETION_DONE && result->callback_result >= 0 &&
+		result->pending_sequence == state->sequence &&
+		result->consumed_sequence == state->consumed_sequence && result->revision == state->revision;
+}
+EXPORT_SYMBOL_FOR_KVM_INTERNAL(kvm_crucible_response_bytes_closed_locked);
 
