+	lockdep_assert_held(&vcpu->mutex);
+	lockdep_assert_held(&vcpu->kvm->crucible_gate_lock);
+	if (!generation || state->outstanding || original->version != 1 ||
+	    !original->invocation || state->acknowledged_invocation != original->invocation ||
