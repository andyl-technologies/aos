+/* Each accepted operation, including cached QUERY delivery, consumes a new
+ * lifetime slot before effects. No operation replaces an earlier receipt. */
+static struct kvm_crucible_ps_control_row *q35_ps_history_reserve_locked(
+	struct kvm *kvm, const struct kvm_crucible_q35_ps_clock *input,
+	struct kvm_crucible_ps_control_row *history, u32 maximum)
+{
+	struct kvm_crucible_ps_clock_state *ps = &kvm->arch.crucible_clock.ps;
+	struct kvm_crucible_ps_control_row *row;
+
+	lockdep_assert_held(&kvm->crucible_gate_lock);
+	if (!history || !maximum || maximum > KVM_CRUCIBLE_Q35_PS_MAX_CONTROLS ||
+	    ps->controls_used >= maximum)
+		return NULL;
+	row = &history[ps->controls_used];
+	if (row->ordinal || row->actor || row->output_known || row->delivery_known)
+		return NULL;
+	row->input = *input;
+	row->actor = current;
+	row->ordinal = ps->controls_used + 1;
+	return row;
+}
+
+static void q35_ps_history_output_locked(struct kvm *kvm,
+	struct kvm_crucible_ps_control_row *row,
+	const struct kvm_crucible_q35_ps_clock *output)
+{
+	lockdep_assert_held(&kvm->crucible_gate_lock);
+	if (!row)
+		return;
+	row->output = *output;
+	row->output_known = true;
+}
