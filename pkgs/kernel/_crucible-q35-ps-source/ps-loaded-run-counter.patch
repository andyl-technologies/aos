+int kvm_crucible_q35_ps_run_counter_prepare(struct kvm_vcpu *vcpu)
+{
+	struct kvm *kvm = vcpu->kvm;
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	struct kvm_crucible_run_return_state *run = &vcpu->crucible_run_return;
+	unsigned long flags;
+	long native_result;
+	bool known;
+	int result;
+
+	lockdep_assert_held(&vcpu->mutex);
+	if (!READ_ONCE(clock->ps.selected) || READ_ONCE(clock->ps.plan.version) != 2)
+		return 0;
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	if (!q35_ps_run_counter_current_locked(vcpu) || run->ps_counter_attempted ||
+	    clock->ps.phase != KVM_CRUCIBLE_PS_ACTIVE ||
+	    !kvm_crucible_clock_admission_live(clock->active,
+		kvm->crucible_host_ceiling_ns, ktime_get_ns())) {
+		raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+		return -EAGAIN;
+	}
+	/* Single consumption precedes the actual loaded setter/readback. Even a
+	 * failed native callback cannot be applied again in this invocation.
+	 */
+	run->ps_counter_attempted = true;
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+
+	preempt_disable();
+	native_result = kvm_x86_call(crucible_counter_intercepts)(vcpu);
+	preempt_enable();
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	/* Retain the exact native result before normalized syscall delivery.
+	 * This fixed row survives interruption and an original RUN ACK.
+	 */
+	run->ps_counter_result = native_result;
+	known = native_result == 0 && run->ps_counter_attempted &&
+		q35_ps_run_counter_current_locked(vcpu);
+	run->ps_counter_known = known;
+	if (!known) {
+		/* Seal future admission before containment. The pending ceiling
+		 * callback must not overwrite this irreversible Unknown phase.
+		 */
+		clock->ps.current_ps = q35_ps_now_locked(clock, ktime_get_ns());
+		clock->frozen_ns = clock->ps.current_ps / 1000;
+		clock->active = false;
+		kvm->crucible_active = false;
+		clock->close_acknowledged = false;
+		clock->ps.phase = KVM_CRUCIBLE_PS_UNKNOWN;
+		kvm_arch_crucible_irq_taint_locked(kvm);
+		result = native_result < 0 ? native_result : -EIO;
+	} else {
+		result = kvm_crucible_clock_admission_live(clock->active,
+			kvm->crucible_host_ceiling_ns, ktime_get_ns()) ? 0 : -EAGAIN;
+	}
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	if (!known)
+		kvm_vm_dead(kvm);
 	return result;
 }
 
