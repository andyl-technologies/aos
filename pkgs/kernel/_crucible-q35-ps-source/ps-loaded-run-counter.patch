+/* The same original RUN credit spans vcpu_load and this loaded vendor effect.
+ * A stop may arrive during readback, but cannot replace its actor/invocation.
+ */
+static bool q35_ps_run_counter_current_locked(struct kvm_vcpu *vcpu)
+{
+	struct kvm *kvm = vcpu->kvm;
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	struct kvm_crucible_run_return_state *run = &vcpu->crucible_run_return;
+
+	lockdep_assert_held(&kvm->crucible_gate_lock);
+	return clock->ps.selected && clock->ps.plan.version == 2 &&
+		kvm_arch_crucible_q35_ps_execution_ready_locked(kvm) &&
+		kvm_arch_crucible_q35_ps_worker_current_locked(vcpu) &&
+		(clock->ps.phase == KVM_CRUCIBLE_PS_ACTIVE ||
+		 clock->ps.phase == KVM_CRUCIBLE_PS_STOP_REQUESTED) &&
+		clock->run_owners && run->outstanding && run->original.invocation &&
+		run->ps_counter_invocation == run->original.invocation &&
+		run->ps_counter_generation == clock->window_generation &&
+		run->original.generation_begin == clock->window_generation &&
+		run->original.native_vcpu_id == vcpu->vcpu_id &&
+		vcpu->crucible_timer_run_owner == current &&
+		vcpu->crucible_timer_run_invocation == run->original.invocation &&
+		(run->original.flags & KVM_CRUCIBLE_RUN_RETURN_CLOCK_ENTERED) &&
+		!(run->original.flags & KVM_CRUCIBLE_RUN_RETURN_RETURNED);
+}
