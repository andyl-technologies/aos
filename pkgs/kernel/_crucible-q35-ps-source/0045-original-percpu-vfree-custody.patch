+bool crucible_allocator_vm_area_address_bind(struct vm_struct *area,
+	const void *canonical_address)
+{
+	struct crucible_vm_area_origin *record;
+	struct crucible_vm_area_cleanup output;
+	unsigned long flags;
+	bool accepted;
+
+	raw_spin_lock_irqsave(&crucible_vm_area_lock, flags);
+	record = crucible_vm_area_find(area);
+	if (!record) {
+		raw_spin_unlock_irqrestore(&crucible_vm_area_lock, flags);
+		return true;
+	}
+	record->cleanup.original_area = record->original_area;
+	record->cleanup.observed_bind_address = canonical_address;
+	record->cleanup.address_duplicate = record->cleanup.address_bound &&
+		record->original_address == canonical_address;
+	accepted = record->state == CRUCIBLE_VM_AREA_BOUND && canonical_address &&
+		!record->cleanup.address_mismatch &&
+		record->cleanup.address_bind_attempts != U32_MAX &&
+		(!record->cleanup.address_bound || record->cleanup.address_duplicate);
+	if (record->cleanup.address_bind_attempts != U32_MAX)
+		record->cleanup.address_bind_attempts++;
+	/* The first source-issued canonical address is immutable. Both literal
+	 * constructors may observe that same address; neither can renew it.
+	 */
+	if (accepted && !record->cleanup.address_bound) {
+		record->original_address = canonical_address;
+		record->cleanup.address_bound = true;
+	}
+	if (!accepted && !record->cleanup.address_mismatch) {
+		record->cleanup.first_rejected_bind_address = canonical_address;
+		record->cleanup.address_mismatch = true;
+	}
+	output = record->cleanup;
+	raw_spin_unlock_irqrestore(&crucible_vm_area_lock, flags);
+	crucible_vm_area_observe(record, &output, false);
+	return accepted;
+}
+EXPORT_SYMBOL_GPL(crucible_allocator_vm_area_address_bind);
+
+static struct crucible_vm_area_origin *
+crucible_vm_address_find(const void *canonical_address)
+{
+	u32 index;
+
+	lockdep_assert_held(&crucible_vm_area_lock);
+	if (!canonical_address)
+		return NULL;
+	for (index = 0; index < crucible_vm_area_used; index++) {
+		struct crucible_vm_area_origin *record = &crucible_vm_areas.records[index];
+
+		if (record->original_address == canonical_address &&
+		    (record->state == CRUCIBLE_VM_AREA_BOUND ||
+		     record->state == CRUCIBLE_VM_AREA_DEFERRED))
+			return record;
+	}
+	return NULL;
+}
+
+void crucible_allocator_vm_address_defer(const void *canonical_address,
+	const void *published_address, struct llist_head *list,
+	struct work_struct *work, void (*method)(struct work_struct *),
+	struct crucible_vm_area_token *token)
+{
+	struct crucible_vm_area_origin *record;
+	struct crucible_vm_area_cleanup output;
+	unsigned long flags;
+
+	token->original_record = NULL;
+	token->generation = 0;
+	raw_spin_lock_irqsave(&crucible_vm_area_lock, flags);
+	record = crucible_vm_address_find(canonical_address);
+	if (!record || record->state != CRUCIBLE_VM_AREA_BOUND) {
+		raw_spin_unlock_irqrestore(&crucible_vm_area_lock, flags);
+		return;
+	}
+	/* No vm_struct or backing-address follow occurs on the IRQ producer.
+	 * The literal per-CPU list/work/method tuple precedes publication.
+	 */
+	record->cleanup.original_area = record->original_area;
+	record->cleanup.native_address = (void *)canonical_address;
+	record->cleanup.published_address = published_address;
+	record->cleanup.original_list = list;
+	record->cleanup.original_work = work;
+	record->cleanup.original_method = method;
+	record->cleanup.atomic_publication = true;
+	record->cleanup.producer_in_task = in_task();
+	record->cleanup.native_producer = current;
+	record->cleanup.enqueue_attempted = true;
+	record->cleanup.native_path = 3;
+	record->cleanup.route_same = !record->cleanup.address_mismatch &&
+		list && work && method && work->func == method;
+	record->state = CRUCIBLE_VM_AREA_DEFERRED;
+	output = record->cleanup;
+	token->original_record = record;
+	token->generation = record->generation;
+	raw_spin_unlock_irqrestore(&crucible_vm_area_lock, flags);
+	crucible_vm_area_observe(record, &output, false);
+}
+EXPORT_SYMBOL_GPL(crucible_allocator_vm_address_defer);
+
+void crucible_allocator_vm_address_cleanup_begin(const void *canonical_address,
+	const void *published_address, struct llist_head *list,
+	struct work_struct *work, void (*method)(struct work_struct *),
+	struct crucible_vm_area_token *token)
+{
+	struct crucible_vm_area_origin *record;
+	struct crucible_vm_area_cleanup output;
+	unsigned long flags;
+
+	token->original_record = NULL;
+	token->generation = 0;
+	raw_spin_lock_irqsave(&crucible_vm_area_lock, flags);
+	record = crucible_vm_address_find(canonical_address);
+	if (!record) {
+		raw_spin_unlock_irqrestore(&crucible_vm_area_lock, flags);
+		return;
+	}
+	record->cleanup.native_actor = current;
+	record->cleanup.native_work = work;
+	record->cleanup.native_method = method;
+	record->cleanup.native_list = list;
+	record->cleanup.native_running = true;
+	record->cleanup.closing = true;
+	record->cleanup.route_same = record->state == CRUCIBLE_VM_AREA_DEFERRED &&
+		!record->cleanup.address_mismatch &&
+		record->cleanup.atomic_publication &&
+		record->cleanup.original_list == list &&
+		record->cleanup.original_work == work &&
+		record->cleanup.original_method == method &&
+		record->cleanup.published_address == published_address &&
+		list && work && method && work->func == method;
+	/* This receiver owns completion; nested vfree helpers cannot issue a
+	 * second completion after the original record enters Closing.
+	 */
+	record->state = CRUCIBLE_VM_AREA_CLOSING;
+	output = record->cleanup;
+	token->original_record = record;
+	token->generation = record->generation;
+	raw_spin_unlock_irqrestore(&crucible_vm_area_lock, flags);
+	crucible_vm_area_observe(record, &output, false);
+}
+EXPORT_SYMBOL_GPL(crucible_allocator_vm_address_cleanup_begin);
 
