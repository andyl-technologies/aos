+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Each literal APIC acceptance retains observed input/output bytes from its
+ * original native PIT route. Whole stopped hardware state is a separate cut. */
+
+static bool ps_pit_watchdog_target_begin(struct kvm_lapic *apic, int mode,
+	int vector, int level, int trigger, struct kvm_crucible_ps_irq_target_row **lease);
+static bool ps_pit_watchdog_target_complete(struct kvm_lapic *apic,
+	struct kvm_crucible_ps_irq_target_row *row, int result);
+
+static void ps_pit_apic_snapshot(struct kvm_lapic *apic,
+	struct kvm_crucible_ps_irq_target_row *row, bool output)
+{
+	struct kvm_vcpu *vcpu = apic->vcpu;
+	struct kvm_lapic_state *state = output ? &row->output : &row->input;
+
+	memcpy(state->regs, apic->regs, sizeof(state->regs));
+	if (output) {
+		row->output_requests = READ_ONCE(vcpu->requests);
+		row->output_nmi_queued = atomic_read(&vcpu->arch.nmi_queued);
+		row->output_nmi_pending = READ_ONCE(vcpu->arch.nmi_pending);
+		row->output_pending_events = READ_ONCE(apic->pending_events);
+		row->output_sipi_vector = READ_ONCE(apic->sipi_vector);
+		row->output_arb_prio = READ_ONCE(vcpu->arch.apic_arb_prio);
+		row->output_irr_pending = READ_ONCE(apic->irr_pending);
+		row->output_pv_unhalted = READ_ONCE(vcpu->arch.pv.pv_unhalted);
+		row->output_smi_pending = READ_ONCE(vcpu->arch.smi_pending);
+	} else {
+		row->input_requests = READ_ONCE(vcpu->requests);
+		row->input_nmi_queued = atomic_read(&vcpu->arch.nmi_queued);
+		row->input_nmi_pending = READ_ONCE(vcpu->arch.nmi_pending);
+		row->input_pending_events = READ_ONCE(apic->pending_events);
+		row->input_sipi_vector = READ_ONCE(apic->sipi_vector);
+		row->input_arb_prio = READ_ONCE(vcpu->arch.apic_arb_prio);
+		row->input_irr_pending = READ_ONCE(apic->irr_pending);
+		row->input_pv_unhalted = READ_ONCE(vcpu->arch.pv.pv_unhalted);
+		row->input_smi_pending = READ_ONCE(vcpu->arch.smi_pending);
+	}
+}
+
+static bool ps_pit_apic_route_reference(struct kvm_crucible_ps_timer_state *timers,
+	struct kvm_crucible_ps_timer_route_row *route)
+{
+	u32 index;
+
+	if (!timers->routes || timers->routes_used > timers->installation.maximum_routes ||
+	    timers->installation.maximum_routes > KVM_CRUCIBLE_Q35_PS_TIMER_MAX_ROUTES)
+		return false;
+	for (index = 0; index < timers->routes_used; index++)
+		if (route == &timers->routes[index])
+			return true;
+	return false;
+}
+
+static bool ps_pit_apic_begin(struct kvm_lapic *apic, int mode, int vector,
+	int level, int trigger, struct kvm_crucible_ps_irq_target_row **lease)
+{
+	struct kvm_vcpu *vcpu = apic->vcpu;
+	struct kvm *kvm = vcpu->kvm;
+	struct kvm_crucible_ps_timer_state *timers = &kvm->arch.crucible_clock.ps.timers;
+	struct kvm_crucible_ps_timer_route_row *route;
+	struct kvm_crucible_ps_timer_expiry_row *expiry;
+	struct kvm_crucible_ps_irq_target_row *row;
+	unsigned long flags;
+	bool valid;
+
+	*lease = NULL;
+	if (!READ_ONCE(kvm->arch.crucible_clock.ps.selected) ||
+	    READ_ONCE(kvm->arch.crucible_clock.ps.plan.version) != 2 ||
+	    !READ_ONCE(timers->pit_dispatch_active))
+		return true;
+	if (READ_ONCE(timers->pit_dispatch_nmi))
+		return ps_pit_watchdog_target_begin(apic, mode, vector, level, trigger, lease);
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	route = timers->pit_dispatch_route;
+	valid = kvm_crucible_q35_ps_pit_dispatch_current_locked(kvm, &expiry) &&
+		ps_pit_apic_route_reference(timers, route) && route->expiry == expiry &&
+		route->attempted && !route->known && route->receiver_input_known &&
+		vcpu->vcpu_id < 4 && kvm_get_vcpu(kvm, vcpu->vcpu_id) == vcpu &&
+		timers->roots.apics[vcpu->vcpu_id] == apic && apic->regs &&
+		!apic->guest_apic_protected &&
+		(mode == APIC_DM_FIXED || mode == APIC_DM_LOWEST || mode == APIC_DM_EXTINT) &&
+		vector >= 0 && vector < 256 &&
+		level >= 0 && level <= 1 && trigger >= 0 && trigger <= 1;
+	if (valid) {
+		row = &route->targets[vcpu->vcpu_id];
+		valid = !row->attempted;
+		if (valid) {
+			/* All four actual target bodies were charged with this route
+			 * at original bank installation, before native delivery. */
+			row->owner_kind = 1;
+			row->actor = current;
+			row->vcpu = vcpu;
+			row->apic = apic;
+			row->native_vcpu_id = vcpu->vcpu_id;
+			row->generation = expiry->original.generation;
+			row->delivery_mode = mode;
+			row->vector = vector;
+			row->level = level;
+			row->trigger_mode = trigger;
+			row->attempted = true;
+			ps_pit_apic_snapshot(apic, row, false);
+			*lease = row;
+		}
+	}
+	if (!valid) {
+		timers->uncertain = true;
+		kvm_crucible_q35_ps_timer_fault_locked(kvm);
+	}
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	if (!valid)
+		kvm_vm_dead(kvm);
+	return valid;
+}
+
+static bool ps_pit_apic_complete(struct kvm_lapic *apic,
+	struct kvm_crucible_ps_irq_target_row *row, int result)
+{
+	struct kvm *kvm = apic->vcpu->kvm;
+	struct kvm_crucible_ps_timer_state *timers = &kvm->arch.crucible_clock.ps.timers;
+	struct kvm_crucible_ps_timer_route_row *route;
+	struct kvm_crucible_ps_timer_expiry_row *expiry;
+	unsigned long flags;
+	bool valid;
+
+	if (!row)
+		return true;
+	if (row->owner_kind == 2)
+		return ps_pit_watchdog_target_complete(apic, row, result);
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	/* The original call lease owns these bytes even after a stop/refusal.
+	 * Preserve its native status and output before currentness checks. */
+	row->native_result = result;
+	ps_pit_apic_snapshot(apic, row, true);
+	row->output_known = true;
+	route = timers->pit_dispatch_route;
+	valid = ps_pit_apic_route_reference(timers, route) &&
+		apic->vcpu->vcpu_id < 4 && row == &route->targets[apic->vcpu->vcpu_id] &&
+		row->apic == apic && row->vcpu == apic->vcpu && row->actor == current &&
+		row->attempted && !row->known &&
+		kvm_crucible_q35_ps_pit_dispatch_current_locked(kvm, &expiry) &&
+		route->expiry == expiry && row->generation == expiry->original.generation;
+	row->known = valid;
+	if (!valid) {
+		timers->uncertain = true;
+		kvm_crucible_q35_ps_timer_fault_locked(kvm);
+	}
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	if (!valid)
+		kvm_vm_dead(kvm);
+	return valid;
+}
