+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Source-owned PIT guest mutation, native publication and contained expiry.
+ * IRQ pulse/NMI/EOI completion is a distinct, still-unissued source join. */
+
+static enum hrtimer_restart pit_timer_fn(struct hrtimer *timer);
+static void pit_do_work(struct kthread_work *work);
+static const struct kvm_io_device_ops pit_dev_ops;
+
+static bool pit_ps_selected(struct kvm_pit *pit)
+{
+	struct kvm_crucible_ps_clock_state *ps = &pit->kvm->arch.crucible_clock.ps;
+
+	return READ_ONCE(ps->selected) && READ_ONCE(ps->plan.version) == 2;
+}
+
+static void pit_ps_fault_locked(struct kvm_pit *pit)
+{
+	pit->kvm->arch.crucible_clock.ps.timers.uncertain = true;
+	kvm_crucible_q35_ps_timer_fault_locked(pit->kvm);
+}
+
+static bool pit_ps_roots_current_locked(struct kvm_pit *pit)
+{
+	struct kvm *kvm = pit->kvm;
+	struct kvm_crucible_ps_clock_state *ps = &kvm->arch.crucible_clock.ps;
+	struct kvm_crucible_ps_timer_state *timers = &ps->timers;
+	const struct kvm_crucible_ps_timer_roots *roots = &timers->roots;
+
+	lockdep_assert_held(&kvm->crucible_gate_lock);
+	return pit_ps_selected(pit) && timers->installed &&
+		timers->installation_attempted && timers->installation_known && !timers->uncertain &&
+		timers->owner == ps->controller &&
+		timers->installation.configuration_enrollment_id == ps->plan.configuration_enrollment_id &&
+		pit == kvm->arch.vpit && pit == kvm->arch.crucible_pic_board.pit &&
+		roots->pit == pit && roots->pit_worker == pit->worker && pit->worker &&
+		roots->pit_task == pit->worker->task && roots->pit_work == &pit->expired &&
+		roots->pit_timer == &pit->pit_state.timer && pit->dev.ops == &pit_dev_ops &&
+		pit->expired.func == pit_do_work && pit->pit_state.timer.function == pit_timer_fn;
+}
+
+static bool pit_ps_arm_reference(struct kvm_crucible_ps_timer_state *timers,
+	struct kvm_crucible_ps_pit_arm_row *arm)
+{
+	u32 index;
+
+	if (timers->pit_arms_used > timers->installation.maximum_pit_arms ||
+	    timers->installation.maximum_pit_arms > KVM_CRUCIBLE_Q35_PS_TIMER_MAX_ARMS)
+		return false;
+	for (index = 0; index < timers->pit_arms_used; index++)
+		if (arm == &timers->pit_arms[index])
+			return true;
+	return false;
+}
+
+static bool pit_ps_active_owner_locked(struct kvm_pit *pit)
+{
+	struct kvm_crucible_ps_timer_state *timers = &pit->kvm->arch.crucible_clock.ps.timers;
+	struct kvm_crucible_ps_pit_arm_row *arm = timers->pit_active_arm;
+
+	if (hrtimer_callback_running(&pit->pit_state.timer))
+		return false;
+	if (!arm)
+		return !hrtimer_active(&pit->pit_state.timer);
+	return pit_ps_arm_reference(timers, arm) && arm->pit == pit &&
+		arm->original.known && arm->state_output_known && !arm->original.retired &&
+		arm->original.timer == &pit->pit_state.timer;
+}
+
+static void pit_ps_snapshot(struct kvm_pit *pit, struct kvm_pit_state2 *state)
+{
+	lockdep_assert_held(&pit->pit_state.lock);
+	memset(state, 0, sizeof(*state));
+	memcpy(state->channels, pit->pit_state.channels, sizeof(state->channels));
+	state->flags = pit->pit_state.flags;
+}
+
+static bool pit_ps_write_begin(struct kvm_pit *pit, struct kvm_vcpu *vcpu,
+	gpa_t address, int length, u32 value)
+{
+	struct kvm *kvm = pit->kvm;
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	struct kvm_crucible_ps_timer_state *timers = &clock->ps.timers;
+	struct kvm_crucible_ps_pit_arm_row *row;
+	unsigned long flags;
+	u64 position;
+	bool valid;
+
+	lockdep_assert_held(&pit->pit_state.lock);
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	valid = vcpu && vcpu->kvm == kvm && length == 1 &&
+		pit_ps_roots_current_locked(pit) && !timers->pit_access &&
+		!timers->pit_queued_expiry &&
+		timers->pit_arms && timers->installation.maximum_pit_arms &&
+		timers->installation.maximum_pit_arms <= KVM_CRUCIBLE_Q35_PS_TIMER_MAX_ARMS &&
+		timers->pit_arms_used < timers->installation.maximum_pit_arms &&
+		clock->timer_owners != U32_MAX &&
+		pit_ps_active_owner_locked(pit) &&
+		kvm_crucible_q35_ps_pit_guest_current_locked(vcpu, &position, false);
+	if (!valid) {
+		pit_ps_fault_locked(pit);
+		goto unlock;
+	}
+	/* Charge the complete original input and effect credit before any native
+	 * PIT register mutation. This row is never renewed or reused. */
+	row = &timers->pit_arms[timers->pit_arms_used++];
+	row->pit = pit;
+	row->address = address;
+	row->length = length;
+	row->value = value;
+	row->original.actor = current;
+	row->original.writer = vcpu;
+	row->original.timer = &pit->pit_state.timer;
+	row->original.ordinal = timers->pit_arms_used;
+	row->original.generation = clock->window_generation;
+	row->original.invocation = vcpu->crucible_timer_run_invocation;
+	row->original.native_vcpu_id = vcpu->vcpu_id;
+	row->original.position_ps = position;
+	row->original.kind = 1;
+	row->original.attempted = true;
+	row->original.retired = true;
+	pit_ps_snapshot(pit, &row->input);
+	timers->pit_access = row;
+	clock->timer_owners++;
+unlock:
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	return valid;
+}
+
+static bool pit_ps_write_finish(struct kvm_pit *pit)
+{
+	struct kvm *kvm = pit->kvm;
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	struct kvm_crucible_ps_timer_state *timers = &clock->ps.timers;
+	struct kvm_crucible_ps_pit_arm_row *row;
+	unsigned long flags;
+	u64 position;
+	bool valid;
+
+	lockdep_assert_held(&pit->pit_state.lock);
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	row = timers->pit_access;
+	valid = pit_ps_arm_reference(timers, row) && row->pit == pit &&
+		row->original.actor == current && row->original.writer && clock->timer_owners;
+	if (valid) {
+		/* Native output is retained before currentness reconciliation, even
+		 * if the physical stop raced with the completed register effect. */
+		pit_ps_snapshot(pit, &row->output);
+		row->state_output_known = true;
+		valid = pit_ps_roots_current_locked(pit) &&
+			kvm_crucible_q35_ps_pit_guest_current_locked(row->original.writer,
+				&position, true) && row->original.generation == clock->window_generation &&
+			row->original.invocation == row->original.writer->crucible_timer_run_invocation;
+		row->original.known = valid;
+		clock->timer_owners--;
+		timers->pit_access = NULL;
+	}
+	if (!valid)
+		pit_ps_fault_locked(pit);
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	return valid;
+}
+
+static bool pit_ps_cancel_locked(struct kvm_pit *pit,
+	struct kvm_crucible_ps_pit_arm_row *row)
+{
+	struct kvm_crucible_ps_timer_state *timers = &pit->kvm->arch.crucible_clock.ps.timers;
+	struct kvm_crucible_ps_pit_arm_row *prior = timers->pit_active_arm;
+	bool active = hrtimer_active(&pit->pit_state.timer);
+
+	if (hrtimer_callback_running(&pit->pit_state.timer) ||
+	    (active && !prior) || (prior &&
+	     (!pit_ps_arm_reference(timers, prior) || prior->pit != pit ||
+	      !prior->original.known || !prior->state_output_known || prior->original.retired ||
+	      prior->original.timer != &pit->pit_state.timer)))
+		return false;
+	if (!prior)
+		return true;
+	row->superseded = prior;
+	if (active) {
+		row->cancel_attempted = true;
+		row->cancel_result = hrtimer_try_to_cancel(&pit->pit_state.timer);
+		row->cancel_known = row->cancel_result >= 0;
+		if (!row->cancel_known)
+			return false;
+	}
+	prior->original.retired = true;
+	timers->pit_active_arm = NULL;
+	return true;
+}
+
+static bool pit_ps_program(struct kvm_pit *pit, u32 count, bool periodic)
+{
+	struct kvm *kvm = pit->kvm;
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	struct kvm_crucible_ps_timer_state *timers = &clock->ps.timers;
+	struct kvm_crucible_ps_pit_arm_row *row;
+	unsigned long flags;
+	u64 position, observed_position, interval, minimum, deadline;
+	ktime_t host, observed_host;
+	int projection;
+	bool valid = false;
+
+	lockdep_assert_held(&pit->pit_state.lock);
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	row = timers->pit_access;
+	if (!pit_ps_roots_current_locked(pit) || !pit_ps_arm_reference(timers, row) ||
+	    row->pit != pit || row->original.actor != current || !row->original.writer ||
+	    !kvm_crucible_q35_ps_pit_guest_current_locked(row->original.writer, &position, false) ||
+	    !count || count > 0x10000 ||
+	    check_mul_overflow((u64)min_timer_period_us, 1000000ULL, &minimum))
+		goto fault;
+	interval = mul_u64_u32_div(1000000000000ULL, count, KVM_PIT_FREQ);
+	if (periodic && interval < minimum)
+		interval = minimum;
+	if (!interval || check_add_overflow(position, interval, &deadline))
+		goto fault;
+	projection = kvm_crucible_q35_ps_timer_host_locked(kvm, deadline, &host);
+	if (projection < 0 || !pit_ps_cancel_locked(pit, row))
+		goto fault;
+	/* Native cancellation can finish after the original admission sample.
+	 * Revalidate the SAME original RUN and projection before publication;
+	 * its retained cancellation is not permission to arm after the stop. */
+	if (projection &&
+	    (!kvm_crucible_q35_ps_pit_guest_current_locked(row->original.writer,
+		&observed_position, false) ||
+	     kvm_crucible_q35_ps_timer_host_locked(kvm, deadline, &observed_host) != 1 ||
+	     observed_host != host))
+		goto fault;
+	row->original.position_ps = position;
+	row->original.deadline_ps = deadline;
+	row->original.period_ps = periodic ? interval : 0;
+	row->original.host_deadline = projection ? host : 0;
+	row->original.native_result = 0;
+	row->original.known = true;
+	row->original.retired = false;
+	timers->pit_active_arm = row;
+	pit->pit_state.period = div_u64(interval, 1000);
+	pit->pit_state.is_periodic = periodic;
+	if (projection) {
+		/* The original row and native timer credit precede publication.
+		 * The callback cannot inspect a half-published row through the gate. */
+		hrtimer_start(&pit->pit_state.timer, host, HRTIMER_MODE_ABS);
+	}
+	valid = true;
+	goto unlock;
+fault:
+	if (pit_ps_arm_reference(timers, row))
+		row->original.native_result = -EIO;
+	pit_ps_fault_locked(pit);
+unlock:
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	return valid;
+}
+
+static void pit_ps_cancel(struct kvm_pit *pit)
+{
+	struct kvm *kvm = pit->kvm;
+	struct kvm_crucible_ps_timer_state *timers = &kvm->arch.crucible_clock.ps.timers;
+	struct kvm_crucible_ps_pit_arm_row *row;
+	unsigned long flags;
+
+	lockdep_assert_held(&pit->pit_state.lock);
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	row = timers->pit_access;
+	if (!pit_ps_roots_current_locked(pit) || !pit_ps_arm_reference(timers, row) ||
+	    row->original.actor != current || !pit_ps_cancel_locked(pit, row))
+		pit_ps_fault_locked(pit);
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+}
+
+static void pit_ps_unowned_callback(struct kvm_pit *pit)
+{
+	struct kvm *kvm = pit->kvm;
+	unsigned long flags;
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	pit_ps_fault_locked(pit);
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	kvm_vm_dead(kvm);
+}
+
+static enum hrtimer_restart pit_ps_expire(struct kvm_pit *pit)
+{
+	struct kvm *kvm = pit->kvm;
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	struct kvm_crucible_ps_timer_state *timers = &clock->ps.timers;
+	struct kvm_crucible_ps_pit_arm_row *arm;
+	struct kvm_crucible_ps_timer_expiry_row *expiry;
+	unsigned long flags;
+	u64 position;
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	arm = timers->pit_active_arm;
+	if (!pit_ps_roots_current_locked(pit) || !pit_ps_arm_reference(timers, arm) ||
+	    arm->pit != pit || !arm->original.known || arm->original.retired ||
+	    arm->original.generation != clock->window_generation ||
+	    !timers->expiries || timers->expiries_used >= timers->installation.maximum_expiries ||
+	    timers->installation.maximum_expiries > KVM_CRUCIBLE_Q35_PS_TIMER_MAX_EXPIRIES ||
+	    timers->pit_queued_expiry || clock->timer_owners == U32_MAX)
+		goto fault;
+	/* Native callback entry reserves its own output before any queue, pulse,
+	 * NMI or periodic rearm. Unfinished delivery cannot be discarded at Close. */
+	expiry = &timers->expiries[timers->expiries_used++];
+	expiry->original = arm->original;
+	expiry->original.ordinal = timers->expiries_used;
+	expiry->original.retired = true;
+	expiry->arm = &arm->original;
+	expiry->worker = timers->roots.pit_task;
+	expiry->observed_host_ns = ktime_get_ns();
+	position = kvm_crucible_q35_ps_timer_now_locked(kvm, expiry->observed_host_ns);
+	expiry->observed_ps = position;
+	expiry->route_begin = timers->routes_used;
+	expiry->nmi_begin = timers->nmis_used;
+	expiry->original.known = position >= arm->original.deadline_ps &&
+		arm->original.deadline_ps < clock->ps.end_ps;
+	arm->original.retired = true;
+	timers->pit_active_arm = NULL;
+	if (!expiry->original.known)
+		goto fault;
+	/* The original expiry row and completion credit precede actual native
+	 * publication. Neither a failed queue nor early worker entry renews it. */
+	timers->pit_queued_expiry = expiry;
+	clock->timer_owners++;
+	expiry->queue_attempted = true;
+	expiry->queue_result = kthread_queue_work(pit->worker, &pit->expired);
+	expiry->queue_known = expiry->queue_result == 1;
+	if (!expiry->queue_known)
+		goto fault;
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	return HRTIMER_NORESTART;
+fault:
+	pit_ps_fault_locked(pit);
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	kvm_vm_dead(kvm);
+	return HRTIMER_NORESTART;
+}
+
+/* Only the same original native worker and queued expiry can issue a pulse.
+ * The complete active installation still has its own, presently closed gate. */
+bool kvm_crucible_q35_ps_pit_dispatch_current_locked(struct kvm *kvm,
+	struct kvm_crucible_ps_timer_expiry_row **output)
+{
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	struct kvm_crucible_ps_clock_state *ps = &clock->ps;
+	struct kvm_crucible_ps_timer_state *timers = &ps->timers;
+	struct kvm_crucible_ps_timer_expiry_row *expiry = timers->pit_queued_expiry;
+	struct kvm_pit *pit = kvm->arch.vpit;
+	u32 index;
+	bool original = false;
+
+	lockdep_assert_held(&kvm->crucible_gate_lock);
+	*output = NULL;
+	if (!pit || !pit_ps_roots_current_locked(pit) || in_interrupt() ||
+	    current != timers->roots.pit_task || !timers->pit_dispatch_active ||
+	    !clock->timer_owners || READ_ONCE(kvm->vm_dead) ||
+	    kvm->crucible_irq_input.enabled || kvm->crucible_irq_input.tainted ||
+	    kvm->crucible_memory_tainted ||
+	    !kvm_arch_crucible_q35_ps_execution_ready_locked(kvm) ||
+	    (ps->phase != KVM_CRUCIBLE_PS_ACTIVE && ps->phase != KVM_CRUCIBLE_PS_STOP_REQUESTED) ||
+	    ktime_get_ns() > ps->physical_stop_deadline_ns ||
+	    timers->expiries_used > timers->installation.maximum_expiries ||
+	    timers->installation.maximum_expiries > KVM_CRUCIBLE_Q35_PS_TIMER_MAX_EXPIRIES ||
+	    ps->irq.routing != kvm->arch.crucible_pic_board.routing ||
+	    ps->irq.routing != rcu_dereference_protected(kvm->irq_routing, 1))
+		return false;
+	for (index = 0; index < timers->expiries_used; index++)
+		if (expiry == &timers->expiries[index]) {
+			original = true;
+			break;
+		}
+	if (!original || expiry->worker != current || expiry->work_actor != current ||
+	    !expiry->work_entered || !expiry->queue_known || expiry->queue_result != 1 ||
+	    expiry->completion_known || expiry->work_refusal_known ||
+	    !expiry->original.known || expiry->original.generation != clock->window_generation ||
+	    expiry->original.deadline_ps >= ps->end_ps ||
+	    pit->worker->current_work != &pit->expired)
+		return false;
+	*output = expiry;
+	return true;
+}
+EXPORT_SYMBOL_FOR_KVM_INTERNAL(kvm_crucible_q35_ps_pit_dispatch_current_locked);
+
+bool kvm_crucible_q35_ps_pit_irq_claim_locked(struct kvm *kvm, u32 kind,
+	int source, u32 gsi, int level, bool line_status)
+{
+	struct kvm_crucible_ps_timer_state *timers = &kvm->arch.crucible_clock.ps.timers;
+	struct kvm_crucible_ps_timer_expiry_row *expiry;
+	u32 bit;
+
+	if (!kvm_crucible_q35_ps_pit_dispatch_current_locked(kvm, &expiry) ||
+	    kind != KVM_CRUCIBLE_IRQ_SOURCE_LINE || source != KVM_PIT_IRQ_SOURCE_ID ||
+	    gsi || line_status || level < 0 || level > 1 ||
+	    timers->pit_dispatch_level != level)
+		return false;
+	bit = 1U << (level ? 0 : 1);
+	if (!(expiry->pulse_attempted & bit) || (expiry->pulse_claimed & bit) ||
+	    (level == 0 && expiry->pulse_completed != 1))
+		return false;
+	expiry->pulse_claimed |= bit;
+	return true;
+}
+EXPORT_SYMBOL_FOR_KVM_INTERNAL(kvm_crucible_q35_ps_pit_irq_claim_locked);
+
+static bool pit_ps_pulse(struct kvm_pit *pit,
+	struct kvm_crucible_ps_timer_expiry_row *expiry, u32 level)
+{
+	struct kvm *kvm = pit->kvm;
+	struct kvm_crucible_ps_timer_state *timers = &kvm->arch.crucible_clock.ps.timers;
+	struct kvm_crucible_ps_timer_expiry_row *original;
+	unsigned long flags;
+	u32 bit = 1U << (level ? 0 : 1), begin, index;
+	int result;
+	bool valid;
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	valid = kvm_crucible_q35_ps_pit_dispatch_current_locked(kvm, &original) &&
+		original == expiry && !(expiry->pulse_attempted & bit) &&
+		!timers->pit_dispatch_route;
+	if (!valid) {
+		pit_ps_fault_locked(pit);
+		raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+		return false;
+	}
+	begin = timers->routes_used;
+	timers->pit_dispatch_level = level;
+	expiry->pulse_attempted |= bit;
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+
+	result = kvm_set_irq(kvm, KVM_PIT_IRQ_SOURCE_ID, 0, level, false);
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	/* Raw aggregate status remains distinct from route-callback permission.
+	 * A fully retained masked/ignored negative status can still be Known. */
+	expiry->pulse_results[level ? 0 : 1] = result;
+	valid = kvm_crucible_q35_ps_pit_dispatch_current_locked(kvm, &original) &&
+		original == expiry && (expiry->pulse_claimed & bit) &&
+		timers->routes_used == begin + 2 && !timers->pit_dispatch_route;
+	for (index = begin; valid && index < timers->routes_used; index++)
+		valid = timers->routes[index].expiry == expiry &&
+			timers->routes[index].known && timers->routes[index].receiver_output_known;
+	if (valid)
+		expiry->pulse_completed |= bit;
+	else
+		pit_ps_fault_locked(pit);
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	return valid;
+}
+
+/* The literal original PIT worker claims this expiry before any IRQ effect.
+ * Completion is deliberately held until the full source pulse/NMI/EOI join;
+ * native callback entry alone does not complete or publish the output row. */
+static void pit_ps_work(struct kvm_pit *pit)
+{
+	struct kvm *kvm = pit->kvm;
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	struct kvm_crucible_ps_timer_state *timers = &clock->ps.timers;
+	struct kvm_crucible_ps_timer_expiry_row *expiry;
+	unsigned long flags;
+	u32 index;
+	bool original = false, running = false;
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	expiry = timers->pit_queued_expiry;
+	if (!pit_ps_roots_current_locked(pit) || in_interrupt() ||
+	    current != timers->roots.pit_task || !clock->timer_owners ||
+	    timers->expiries_used > timers->installation.maximum_expiries ||
+	    timers->installation.maximum_expiries > KVM_CRUCIBLE_Q35_PS_TIMER_MAX_EXPIRIES)
+		goto fault;
+	for (index = 0; index < timers->expiries_used; index++)
+		if (expiry == &timers->expiries[index]) {
+			original = true;
+			break;
+		}
+	if (!original || expiry->worker != current || !expiry->queue_attempted ||
+	    !expiry->queue_known || expiry->queue_result != 1 || expiry->work_entered ||
+	    expiry->original.generation != clock->window_generation ||
+	    !expiry->original.known || !expiry->original.retired)
+		goto fault;
+	/* Native worker lock is tried rather than acquired in inverse order.
+	 * It verifies real callback entry, not a task-name or caller label. */
+	if (raw_spin_trylock(&pit->worker->lock)) {
+		running = pit->worker->current_work == &pit->expired;
+		raw_spin_unlock(&pit->worker->lock);
+	}
+	if (!running)
+		goto fault;
+	expiry->work_actor = current;
+	expiry->work_host_ns = ktime_get_ns();
+	expiry->work_position_ps = kvm_crucible_q35_ps_timer_now_locked(kvm,
+		expiry->work_host_ns);
+	expiry->work_entered = true;
+	timers->pit_dispatch_active = true;
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	if (!pit_ps_pulse(pit, expiry, 1) || !pit_ps_pulse(pit, expiry, 0) ||
+	    !kvm_crucible_q35_ps_pit_watchdogs(kvm, expiry)) {
+		raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+		goto fault;
+	}
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	/* The exact original dual pulse is retained. EOI/periodic carry and
+	 * stopped output publication remain separate, still-unissued joins. */
+	expiry->work_refusal_result = -EOPNOTSUPP;
+	expiry->work_refusal_known = true;
+fault:
+	timers->pit_dispatch_active = false;
+	pit_ps_fault_locked(pit);
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	kvm_vm_dead(kvm);
+}
