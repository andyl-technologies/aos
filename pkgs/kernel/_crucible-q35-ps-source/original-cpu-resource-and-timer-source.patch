+
+struct kvm_crucible_kernel_resource_context {
+	struct file *original_file;
+	struct task_struct *original_task;
+	struct mm_struct *original_mm;
+	struct kvm *original_vm;
+	u64 generation;
+	struct kvm_crucible_kernel_resource_policy input;
+	struct kvm_crucible_kernel_resource_policy prepare_output;
+	struct kvm_crucible_kernel_resource_policy query_input;
+	struct kvm_crucible_kernel_resource_policy query_output;
+	struct kvm_crucible_resource_allocation allocations[CRUCIBLE_RESOURCE_ALLOCATION_ROWS];
+	u64 resident_bytes;
+	u64 peak_bytes;
+	u64 reserved_bytes;
+	u64 transient_bytes;
+	u64 output_bytes;
+	u64 metadata_bytes;
+	u32 allocations_used;
+	s64 prepare_delivery_result;
+	u64 prepare_delivered_prefix;
+	s64 query_delivery_result;
+	u64 query_delivered_prefix;
+	struct task_struct *create_actor;
+	u64 create_operand;
+	s64 create_result;
+	bool prepared;
+	bool prepare_delivery_known;
+	bool query_attempted;
+	bool query_delivery_known;
+	bool create_attempted;
+	bool create_native_entered;
+	bool create_no_effect_known;
+	bool uncertain;
+	bool closed;
+} __aligned(PAGE_SIZE);
+
+/* Each selected context owns a distinct page-aligned original metadata bank.
+ * Known unused retirement may recycle a slot with a NEW native generation;
+ * uncertainty retains the old slot and its original references permanently. */
+static struct kvm_crucible_kernel_resource_context
+	crucible_resource_contexts[CRUCIBLE_RESOURCE_CONTEXTS];
+static DEFINE_MUTEX(crucible_resource_lock);
+static u64 crucible_resource_generation;
+
+static struct kvm_crucible_kernel_resource_context *
+crucible_resource_find(struct file *file)
+{
+	u32 index;
+
+	lockdep_assert_held(&crucible_resource_lock);
+	for (index = 0; index < CRUCIBLE_RESOURCE_CONTEXTS; index++)
+		if (crucible_resource_contexts[index].original_file == file)
+			return &crucible_resource_contexts[index];
+	return NULL;
+}
+
+static bool crucible_resource_actor(struct kvm_crucible_kernel_resource_context *context,
+	struct file *file)
+{
+	lockdep_assert_held(&crucible_resource_lock);
+	return context && context->original_file == file && !context->closed &&
+		context->original_task == current && context->original_mm == current->mm &&
+		file->f_op == &kvm_chardev_ops;
+}
+
+static bool crucible_resource_input_same(
+	const struct kvm_crucible_kernel_resource_policy *input,
+	const struct kvm_crucible_kernel_resource_policy *original)
+{
+	return input->version == original->version &&
+		input->enrollment_id == original->enrollment_id &&
+		input->expected_vm_type == original->expected_vm_type &&
+		input->constructor_deadline_ns == original->constructor_deadline_ns &&
+		input->resident_ceiling == original->resident_ceiling &&
+		input->peak_ceiling == original->peak_ceiling &&
+		input->reserved_ceiling == original->reserved_ceiling &&
+		input->transient_ceiling == original->transient_ceiling &&
+		input->output_ceiling == original->output_ceiling &&
+		input->metadata_ceiling == original->metadata_ceiling;
+}
+
+static bool crucible_resource_input_clean(
+	const struct kvm_crucible_kernel_resource_policy *input)
+{
+	return !input->quoted_resident && !input->quoted_peak && !input->quoted_reserved &&
+		!input->quoted_transient && !input->quoted_output && !input->quoted_metadata &&
+		!input->coverage && !input->reservation_generation && !input->native_result &&
+		!input->flags && !input->reserved32 && !input->prepare_delivery_result &&
+		!input->prepare_delivered_prefix && !input->reserved[0] && !input->reserved[1];
+}
+
+static int crucible_resource_quote(
+	const struct kvm_crucible_kernel_resource_policy *input,
+	struct kvm_crucible_kernel_resource_policy *output)
+{
+	u64 metadata = sizeof(struct kvm_crucible_kernel_resource_context);
+	u64 vm_request, resident;
+
+	BUILD_BUG_ON(sizeof(*input) != 192);
+	BUILD_BUG_ON(sizeof(struct kvm_crucible_kernel_resource_context) % PAGE_SIZE);
+#ifndef CONFIG_X86_64
+	return -EOPNOTSUPP;
+#endif
+	if (input->expected_vm_type)
+		return -EOPNOTSUPP;
+	/* This native request rounding is a diagnostic minimum, not complete
+	 * slab/page allocator metadata, slack or internal transient coverage. */
+	vm_request = kmalloc_size_roundup(sizeof(struct kvm));
+	if (!vm_request || check_add_overflow(metadata, vm_request, &resident))
+		return -EOVERFLOW;
+	*output = *input;
+	output->quoted_resident = resident;
+	output->quoted_peak = resident;
+	output->quoted_reserved = resident;
+	output->quoted_transient = vm_request;
+	output->quoted_output = 2 * sizeof(*output);
+	output->quoted_metadata = metadata;
+	/* The fixed source-born metadata bank is covered. VM root request size
+	 * is observed, but its allocator-complete coverage remains unissued. */
+	output->coverage = CRUCIBLE_RESOURCE_METADATA;
+	output->flags = KVM_CRUCIBLE_KERNEL_RESOURCE_METADATA_KNOWN;
+	if (input->resident_ceiling < resident || input->peak_ceiling < resident ||
+	    input->reserved_ceiling < resident || input->transient_ceiling < vm_request ||
+	    input->output_ceiling < output->quoted_output || input->metadata_ceiling < metadata)
+		return -E2BIG;
+	return 0;
+}
+
+/* Same original reservation is required BEFORE descriptor-table expansion,
+ * VM allocation, SRCU/perCPU and all original architecture constructors. */
+static int kvm_crucible_resource_before_create(struct file *file, unsigned long type)
+{
+	struct kvm_crucible_kernel_resource_context *context;
+	int result = 0;
+
+	mutex_lock(&crucible_resource_lock);
+	context = crucible_resource_find(file);
+	if (!context)
+		goto unlock;
+	if (!crucible_resource_actor(context, file) || context->uncertain ||
+	    !context->prepared || context->create_attempted ||
+	    type != context->input.expected_vm_type ||
+	    ktime_get_ns() > context->input.constructor_deadline_ns) {
+		context->uncertain = true;
+		result = -EPERM;
+		goto unlock;
+	}
+	context->create_actor = current;
+	context->create_operand = type;
+	context->create_attempted = true;
+	/* No caller flag, quote width or cap number completes native coverage.
+	 * Missing constructor families refuse before any native allocation. */
+	if (context->prepare_output.coverage != CRUCIBLE_RESOURCE_REQUIRED ||
+	    !(context->prepare_output.flags & KVM_CRUCIBLE_KERNEL_RESOURCE_COVERAGE_COMPLETE)) {
+		context->create_result = -EOPNOTSUPP;
+		context->create_no_effect_known = true;
+		result = -EOPNOTSUPP;
+		goto unlock;
+	}
+	/* The allocation-family continuation itself is not installed yet. Even
+	 * a corrupted complete bit cannot enter ordinary unaccounted creation. */
+	context->uncertain = true;
+	context->create_result = -EOPNOTSUPP;
+	result = -EOPNOTSUPP;
+unlock:
+	mutex_unlock(&crucible_resource_lock);
+	return result;
+}
+
+static int kvm_crucible_resource_system_control(struct file *file,
+	unsigned long arg, bool *handled)
+{
+	struct kvm_enable_cap cap;
+	struct kvm_crucible_kernel_resource_policy input, output;
+	struct kvm_crucible_kernel_resource_context *context = NULL;
+	void __user *pointer;
+	unsigned long remaining;
+	u64 now, latest;
+	u32 index;
+	int result;
+
+	*handled = false;
+	/* Unsupported ordinary ENABLE_CAP keeps its architecture result. The
+	 * eventual private branch consumes THIS complete copied cap, never an
+	 * earlier classification snapshot followed by a substituted tuple. */
+	if (copy_from_user(&cap, (void __user *)arg, sizeof(cap)) ||
+	    cap.cap != KVM_CAP_CRUCIBLE_Q35_BOARD_CONSTRUCTOR_V2 ||
+	    cap.flags || cap.args[0] != KVM_CRUCIBLE_Q35_SYSTEM_RESOURCE_POLICY ||
+	    !cap.args[1] || cap.args[2] || cap.args[3])
+		return -EINVAL;
+	*handled = true;
+	for (index = 0; index < sizeof(cap.pad); index++)
+		if (cap.pad[index])
+			return -EINVAL;
+	if (file->f_op != &kvm_chardev_ops)
+		return -EINVAL;
+	pointer = u64_to_user_ptr(cap.args[1]);
+	if (copy_from_user(&input, pointer, sizeof(input)))
+		return -EFAULT;
+	if (input.version != KVM_CRUCIBLE_KERNEL_RESOURCE_VERSION || !input.enrollment_id ||
+	    !crucible_resource_input_clean(&input) ||
+	    (input.operation != KVM_CRUCIBLE_KERNEL_RESOURCE_PREPARE &&
+	     input.operation != KVM_CRUCIBLE_KERNEL_RESOURCE_QUERY))
+		return -EINVAL;
+
+	mutex_lock(&crucible_resource_lock);
+	context = crucible_resource_find(file);
+	if (input.operation == KVM_CRUCIBLE_KERNEL_RESOURCE_QUERY) {
+		if (!crucible_resource_actor(context, file) || !context->prepared ||
+		    !context->prepare_delivery_known || context->query_attempted ||
+		    !crucible_resource_input_same(&input, &context->input)) {
+			result = -EPERM;
+			goto unlock;
+		}
+		context->query_input = input;
+		context->query_attempted = true;
+		output = context->prepare_output;
+		output.operation = KVM_CRUCIBLE_KERNEL_RESOURCE_QUERY;
+		output.prepare_delivery_result = context->prepare_delivery_result;
+		output.prepare_delivered_prefix = context->prepare_delivered_prefix;
+		output.flags |= KVM_CRUCIBLE_KERNEL_RESOURCE_PREPARE_DELIVERY_KNOWN;
+		if (context->uncertain)
+			output.flags |= KVM_CRUCIBLE_KERNEL_RESOURCE_UNCERTAIN;
+		context->query_output = output;
+	} else {
+		if (context) {
+			context->uncertain = true;
+			result = -EPERM;
+			goto unlock;
+		}
+		now = ktime_get_ns();
+		if (!current->mm || !input.resident_ceiling ||
+		    input.peak_ceiling < input.resident_ceiling ||
+		    input.reserved_ceiling < input.peak_ceiling ||
+		    !input.transient_ceiling || input.transient_ceiling > input.peak_ceiling ||
+		    !input.output_ceiling || input.output_ceiling > input.resident_ceiling ||
+		    !input.metadata_ceiling || input.metadata_ceiling > input.resident_ceiling ||
+		    check_add_overflow(now, CRUCIBLE_RESOURCE_CONSTRUCTOR_NS, &latest) ||
+		    input.constructor_deadline_ns <= now || input.constructor_deadline_ns > latest) {
+			result = -EINVAL;
+			goto unlock;
+		}
+		result = crucible_resource_quote(&input, &output);
+		if (result)
+			goto unlock;
+		for (index = 0; index < CRUCIBLE_RESOURCE_CONTEXTS; index++)
+			if (!crucible_resource_contexts[index].original_file) {
+				context = &crucible_resource_contexts[index];
+				break;
+			}
+		if (!context || crucible_resource_generation == U64_MAX) {
+			result = -ENOSPC;
+			goto unlock;
+		}
+		if (!try_module_get(THIS_MODULE)) {
+			result = -EOPNOTSUPP;
+			goto unlock;
+		}
+		memset(context, 0, sizeof(*context));
+		context->input = input;
+		context->generation = ++crucible_resource_generation;
+		output.reservation_generation = context->generation;
+		output.native_result = 0;
+		context->prepare_output = output;
+		context->original_task = current;
+		context->original_mm = current->mm;
+		get_task_struct(current);
+		mmgrab(current->mm);
+		context->resident_bytes = output.quoted_metadata;
+		context->peak_bytes = context->resident_bytes;
+		context->reserved_bytes = context->resident_bytes;
+		context->metadata_bytes = output.quoted_metadata;
+		context->output_bytes = output.quoted_output;
+		context->prepared = true;
+		/* Publish only the already charged complete original bank. */
+		context->original_file = file;
+	}
+	mutex_unlock(&crucible_resource_lock);
+
+	remaining = copy_to_user(pointer, &output, sizeof(output));
+
+	mutex_lock(&crucible_resource_lock);
+	if (remaining > sizeof(output)) {
+		context->uncertain = true;
+		result = -EIO;
+		goto unlock;
+	}
+	result = remaining ? -EFAULT : 0;
+	if (input.operation == KVM_CRUCIBLE_KERNEL_RESOURCE_PREPARE) {
+		context->prepare_delivery_result = result;
+		context->prepare_delivered_prefix = sizeof(output) - remaining;
+		context->prepare_delivery_known = true;
+	} else {
+		context->query_delivery_result = result;
+		context->query_delivered_prefix = sizeof(output) - remaining;
+		context->query_delivery_known = true;
+	}
+unlock:
+	mutex_unlock(&crucible_resource_lock);
+	return result;
+}
+
+static int kvm_crucible_resource_system_release(struct inode *inode, struct file *file)
+{
+	struct kvm_crucible_kernel_resource_context *context;
+	struct task_struct *task = NULL;
+	struct mm_struct *mm = NULL;
+
+	mutex_lock(&crucible_resource_lock);
+	context = crucible_resource_find(file);
+	if (context) {
+		context->closed = true;
+		/* Unknown allocations never release or recycle this original bank. */
+		if (!context->original_vm && !context->allocations_used && !context->uncertain) {
+			task = context->original_task;
+			mm = context->original_mm;
+			memset(context, 0, sizeof(*context));
+		} else {
+			context->uncertain = true;
+		}
+	}
+	mutex_unlock(&crucible_resource_lock);
+	if (task)
+		put_task_struct(task);
+	if (mm) {
+		mmdrop(mm);
+		module_put(THIS_MODULE);
+	}
+	return 0;
+}
