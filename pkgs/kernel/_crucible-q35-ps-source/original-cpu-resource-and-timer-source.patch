+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Original PIT watchdog callbacks retain the exact local-delivery operand and
+ * native result. Pending NMI ownership is separate from guest consumption. */
+
+static bool ps_pit_watchdog_selected(struct kvm_vcpu *vcpu)
+{
+	struct kvm_crucible_ps_clock_state *ps = &vcpu->kvm->arch.crucible_clock.ps;
+
+	return READ_ONCE(ps->selected) && READ_ONCE(ps->plan.version) == 2;
+}
+
+static void ps_pit_watchdog_fault_locked(struct kvm *kvm)
+{
+	kvm->arch.crucible_clock.ps.timers.uncertain = true;
+	kvm_crucible_q35_ps_timer_fault_locked(kvm);
+}
+
+static bool ps_pit_watchdog_reference(struct kvm_crucible_ps_timer_state *timers,
+	struct kvm_crucible_ps_timer_nmi_row *row)
+{
+	u32 index;
+
+	if (!timers->nmis || timers->nmis_used > timers->installation.maximum_nmis ||
+	    timers->installation.maximum_nmis > KVM_CRUCIBLE_Q35_PS_TIMER_MAX_NMIS)
+		return false;
+	for (index = 0; index < timers->nmis_used; index++)
+		if (row == &timers->nmis[index])
+			return true;
+	return false;
+}
+
+static bool ps_pit_watchdog_context_locked(struct kvm *kvm,
+	struct kvm_crucible_ps_timer_nmi_row *row)
+{
+	struct kvm_crucible_ps_timer_state *timers = &kvm->arch.crucible_clock.ps.timers;
+	struct kvm_crucible_ps_timer_expiry_row *expiry;
+	u32 id;
+
+	if (!ps_pit_watchdog_reference(timers, row) ||
+	    !kvm_crucible_q35_ps_pit_dispatch_current_locked(kvm, &expiry))
+		return false;
+	id = row->native_vcpu_id;
+	return id < 4 && row->expiry == expiry && row->actor == current &&
+		row->ordinal == expiry->nmi_begin + id + 1 && expiry->nmi_count == 4 &&
+		row == &timers->nmis[expiry->nmi_begin + id] &&
+		row->generation == expiry->original.generation &&
+		row->vcpu && row->apic && row->vcpu == kvm_get_vcpu(kvm, id) &&
+		row->apic == timers->roots.apics[id] && row->vcpu->arch.apic == row->apic &&
+		row->apic->regs &&
+		!row->apic->guest_apic_protected && expiry->pulse_completed == 3;
+}
+
+/* The native caller passes the ONE LVT read ultimately consumed by its body.
+ * A prevalidation read followed by a second native read would be insufficient. */
+static bool ps_pit_watchdog_local_begin(struct kvm_lapic *apic, int lvt_type,
+	u32 reg, bool hardware_enabled)
+{
+	struct kvm *kvm = apic->vcpu->kvm;
+	struct kvm_crucible_ps_timer_state *timers = &kvm->arch.crucible_clock.ps.timers;
+	struct kvm_crucible_ps_timer_nmi_row *row;
+	unsigned long flags;
+	bool valid;
+
+	if (!ps_pit_watchdog_selected(apic->vcpu))
+		return true;
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	row = timers->pit_dispatch_nmi;
+	valid = ps_pit_watchdog_context_locked(kvm, row) && row->apic == apic &&
+		row->attempted && !row->local_attempted && !row->output_known &&
+		lvt_type == APIC_LVT0;
+	if (valid) {
+		row->input_lvt0 = reg;
+		row->hardware_enabled = hardware_enabled;
+		row->input_pending = atomic_read(&apic->vcpu->arch.nmi_queued);
+		row->local_attempted = true;
+	} else {
+		ps_pit_watchdog_fault_locked(kvm);
+	}
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	if (!valid)
+		kvm_vm_dead(kvm);
+	return valid;
+}
+
+static bool ps_pit_watchdog_target_begin(struct kvm_lapic *apic, int mode,
+	int vector, int level, int trigger, struct kvm_crucible_ps_irq_target_row **lease)
+{
+	struct kvm *kvm = apic->vcpu->kvm;
+	struct kvm_crucible_ps_timer_state *timers = &kvm->arch.crucible_clock.ps.timers;
+	struct kvm_crucible_ps_timer_nmi_row *row;
+	struct kvm_crucible_ps_irq_target_row *target;
+	unsigned long flags;
+	bool valid;
+
+	*lease = NULL;
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	row = timers->pit_dispatch_nmi;
+	valid = ps_pit_watchdog_context_locked(kvm, row) && row->apic == apic &&
+		row->attempted && row->local_attempted && !row->output_known &&
+		!row->target.attempted && row->hardware_enabled &&
+		!(row->input_lvt0 & APIC_LVT_MASKED) &&
+		mode == (row->input_lvt0 & APIC_MODE_MASK) &&
+		vector == (row->input_lvt0 & APIC_VECTOR_MASK) && level == 1 &&
+		trigger == (row->input_lvt0 & APIC_LVT_LEVEL_TRIGGER) &&
+		(mode == APIC_DM_FIXED || mode == APIC_DM_LOWEST ||
+		 mode == APIC_DM_EXTINT || mode == APIC_DM_NMI);
+	if (valid) {
+		target = &row->target;
+		target->owner_kind = 2;
+		target->actor = current;
+		target->vcpu = row->vcpu;
+		target->apic = apic;
+		target->generation = row->generation;
+		target->native_vcpu_id = row->native_vcpu_id;
+		target->delivery_mode = mode;
+		target->vector = vector;
+		target->level = level;
+		target->trigger_mode = trigger;
+		target->attempted = true;
+		ps_pit_apic_snapshot(apic, target, false);
+		*lease = target;
+	} else {
+		ps_pit_watchdog_fault_locked(kvm);
+	}
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	if (!valid)
+		kvm_vm_dead(kvm);
+	return valid;
+}
+
+static bool ps_pit_watchdog_target_complete(struct kvm_lapic *apic,
+	struct kvm_crucible_ps_irq_target_row *target, int result)
+{
+	struct kvm *kvm = apic->vcpu->kvm;
+	struct kvm_crucible_ps_timer_state *timers = &kvm->arch.crucible_clock.ps.timers;
+	struct kvm_crucible_ps_timer_nmi_row *row;
+	unsigned long flags;
+	bool valid;
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	/* Original native call lease survives a lost phase. Cache its result and
+	 * observed output before reconciling permission; neither grants delivery. */
+	target->native_result = result;
+	ps_pit_apic_snapshot(apic, target, true);
+	target->output_known = true;
+	row = timers->pit_dispatch_nmi;
+	valid = ps_pit_watchdog_reference(timers, row) && target == &row->target &&
+		target->apic == apic && target->vcpu == apic->vcpu && target->actor == current &&
+		target->owner_kind == 2 && target->attempted && !target->known &&
+		ps_pit_watchdog_context_locked(kvm, row);
+	target->known = valid;
+	if (!valid)
+		ps_pit_watchdog_fault_locked(kvm);
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	if (!valid)
+		kvm_vm_dead(kvm);
+	return valid;
+}
+
+/* Reached only from the literal original watchdog caller. All four leases
+ * already exist before any native local-delivery callback runs. */
+static void ps_pit_watchdog_deliver(struct kvm_vcpu *vcpu)
+{
+	struct kvm *kvm = vcpu->kvm;
+	struct kvm_crucible_ps_timer_state *timers = &kvm->arch.crucible_clock.ps.timers;
+	struct kvm_crucible_ps_timer_nmi_row *row;
+	struct kvm_lapic *apic;
+	unsigned long flags;
+	int result;
+	bool valid;
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	row = timers->pit_dispatch_nmi;
+	valid = ps_pit_watchdog_context_locked(kvm, row) && row->vcpu == vcpu &&
+		row->attempted && !row->local_attempted && !row->output_known;
+	if (!valid) {
+		ps_pit_watchdog_fault_locked(kvm);
+		raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+		kvm_vm_dead(kvm);
+		return;
+	}
+	apic = row->apic;
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+
+	result = kvm_apic_local_deliver(apic, APIC_LVT0);
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	row->native_result = result;
+	row->output_lvt0 = kvm_lapic_get_reg(apic, APIC_LVT0);
+	row->output_pending = atomic_read(&vcpu->arch.nmi_queued);
+	row->output_known = true;
+	valid = ps_pit_watchdog_context_locked(kvm, row) && timers->pit_dispatch_nmi == row &&
+		row->local_attempted && !row->known &&
+		(!row->target.attempted || (row->target.known && row->target.output_known));
+	row->known = valid;
+	if (!valid)
+		ps_pit_watchdog_fault_locked(kvm);
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	if (!valid)
+		kvm_vm_dead(kvm);
+}
+
+bool kvm_crucible_q35_ps_pit_watchdogs(struct kvm *kvm,
+	struct kvm_crucible_ps_timer_expiry_row *expiry)
+{
+	struct kvm_crucible_ps_timer_state *timers = &kvm->arch.crucible_clock.ps.timers;
+	struct kvm_crucible_ps_timer_expiry_row *original;
+	struct kvm_crucible_ps_timer_nmi_row *row;
+	struct kvm_vcpu *vcpu;
+	unsigned long flags;
+	u32 index, begin;
+	int count;
+	bool valid;
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	valid = kvm_crucible_q35_ps_pit_dispatch_current_locked(kvm, &original) &&
+		original == expiry && expiry->pulse_completed == 3 &&
+		!expiry->watchdog_observed && !timers->pit_dispatch_route &&
+		!timers->pit_dispatch_nmi;
+	count = atomic_read(&kvm->arch.vapics_in_nmi_mode);
+	if (!valid)
+		goto fault;
+	expiry->input_watchdog_count = count;
+	if (count < 0 || count > 4)
+		goto fault;
+	expiry->watchdog_observed = true;
+	if (!count) {
+		expiry->output_watchdog_count = count;
+		expiry->watchdog_completed = true;
+		raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+		return true;
+	}
+	if (!timers->nmis || timers->installation.maximum_nmis > KVM_CRUCIBLE_Q35_PS_TIMER_MAX_NMIS ||
+	    timers->nmis_used > timers->installation.maximum_nmis ||
+	    4 > timers->installation.maximum_nmis - timers->nmis_used ||
+	    expiry->nmi_begin != timers->nmis_used || expiry->nmi_count)
+		goto fault;
+	/* Validate every original receiver before consuming the entire cohort. */
+	for (index = 0; index < 4; index++) {
+		vcpu = kvm_get_vcpu(kvm, index);
+		if (!vcpu || vcpu->vcpu_id != index || !vcpu->arch.apic ||
+		    vcpu->arch.apic != timers->roots.apics[index] || !vcpu->arch.apic->regs ||
+		    vcpu->arch.apic->guest_apic_protected)
+			goto fault;
+	}
+	begin = timers->nmis_used;
+	timers->nmis_used += 4;
+	expiry->nmi_count = 4;
+	for (index = 0; index < 4; index++) {
+		vcpu = kvm_get_vcpu(kvm, index);
+		row = &timers->nmis[begin + index];
+		row->expiry = expiry;
+		row->actor = current;
+		row->vcpu = vcpu;
+		row->apic = vcpu->arch.apic;
+		row->ordinal = begin + index + 1;
+		row->generation = expiry->original.generation;
+		row->native_vcpu_id = index;
+		row->native_result = -EINPROGRESS;
+	}
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+
+	for (index = 0; index < 4; index++) {
+		raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+		row = &timers->nmis[begin + index];
+		if (!ps_pit_watchdog_context_locked(kvm, row) || row->attempted || row->known ||
+		    timers->pit_dispatch_nmi || (index && !timers->nmis[begin + index - 1].known))
+			goto fault;
+		row->attempted = true;
+		timers->pit_dispatch_nmi = row;
+		vcpu = row->vcpu;
+		raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+
+		kvm_apic_nmi_wd_deliver(vcpu);
+
+		raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+		if (!ps_pit_watchdog_context_locked(kvm, row) || timers->pit_dispatch_nmi != row ||
+		    !row->known || !row->output_known)
+			goto fault;
+		timers->pit_dispatch_nmi = NULL;
+		raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	}
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	expiry->output_watchdog_count = atomic_read(&kvm->arch.vapics_in_nmi_mode);
+	if (!kvm_crucible_q35_ps_pit_dispatch_current_locked(kvm, &original) ||
+	    original != expiry || timers->pit_dispatch_nmi ||
+	    expiry->output_watchdog_count < 0 || expiry->output_watchdog_count > 4)
+		goto fault;
+	expiry->watchdog_completed = true;
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	return true;
+
+fault:
+	ps_pit_watchdog_fault_locked(kvm);
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	kvm_vm_dead(kvm);
+	return false;
+}
+EXPORT_SYMBOL_FOR_KVM_INTERNAL(kvm_crucible_q35_ps_pit_watchdogs);
