+/* Retention alone may complete after currentness is lost. This matches the
+ * original in-flight Task/vCPU/row and grants no native effect permission. */
+static struct kvm_crucible_pic_initializer_effect *
+pic_initializer_retained_cpu_effect_locked(struct kvm_vcpu *vcpu,
+	unsigned int ioctl)
+{
+	struct kvm_crucible_pic_initializer_state *state =
+		pic_initializer_actor_state(vcpu->kvm, vcpu);
+	struct kvm_crucible_pic_initializer_effect *effect;
+
+	lockdep_assert_held(&vcpu->kvm->crucible_gate_lock);
+	if (!state || state->task != current || state->vcpu != vcpu ||
+	    !state->inflight || !state->issued ||
+	    state->issued > state->maximum_effects)
+		return NULL;
+	effect = &state->effects[state->issued - 1];
+	return effect->native_ioctl == ioctl ? effect : NULL;
+}
