+	    request->native_vcpu_id >= KVM_CRUCIBLE_PIC_INITIALIZER_V2_CPUS ||
+	    !request->effect_index ||
+	    request->effect_index > KVM_CRUCIBLE_PIC_INITIALIZER_MAX_EFFECTS ||
+	    !request->native_ioctl || request->flags || request->input_bytes ||
+	    request->output_bytes || request->native_result ||
+	    request->original_delivery_result || request->reader_delivery_result ||
+	    request->input_copied_bytes ||
+	    request->input_capacity > KVM_CRUCIBLE_PIC_INITIALIZER_MAX_INPUT_BYTES ||
+	    request->output_capacity > KVM_CRUCIBLE_PIC_INITIALIZER_MAX_INPUT_BYTES)
+		return false;
+	if (request->version == 2 &&
+	    request->operation == KVM_CRUCIBLE_Q35_CPU_BYTES_METADATA_V2 &&
+	    (request->input_buffer || request->input_capacity ||
+	     request->output_buffer || request->output_capacity))
+		return false;
+	for (index = 0; index < ARRAY_SIZE(request->reserved); index++)
+		if (request->reserved[index])
+			return false;
+	return true;
+}
+
+static void q35_cpu_bytes_retained_spans(
+	const struct kvm_crucible_pic_initializer_effect *effect,
+	const void **input, u64 *input_bytes, const void **output,
+	u64 *output_bytes, u64 *copied)
+{
+	*input = NULL;
+	*output = NULL;
+	*input_bytes = 0;
+	*output_bytes = 0;
+	*copied = 0;
+
+	if (effect->cpu_bytes_charged) {
+		*input = effect->input_cpu;
+		*input_bytes = *input ? effect->input_cpu_bytes : 0;
+		*output = effect->output_cpu;
+		*output_bytes = *output ? effect->output_cpu_bytes : 0;
+		*copied = effect->input_cpu_copied_bytes;
+	} else if (effect->cpuid_header) {
+		*input = effect->cpuid_header;
+		*input_bytes = sizeof(struct kvm_cpuid2);
+		*copied = effect->cpuid_header_copied_bytes;
+	} else if (effect->input_msrs_known && effect->input_msrs) {
+		*input = effect->input_msrs;
+		*input_bytes = sizeof(*effect->input_msrs) +
+			effect->input_msrs->nmsrs * sizeof(effect->input_msrs->entries[0]);
+		*copied = *input_bytes;
+		if (effect->output_msrs_known && effect->output_msrs) {
+			*output = effect->output_msrs;
+			*output_bytes = sizeof(*effect->output_msrs) +
+				effect->output_msrs->nmsrs *
+				sizeof(effect->output_msrs->entries[0]);
+		}
+	} else if (effect->input_nested_known && effect->input_nested) {
+		*input = effect->input_nested;
+		*input_bytes = effect->input_nested_bytes;
+		*copied = *input_bytes;
+	} else if (effect->input_events_known) {
+		*input = &effect->input_events;
+		*input_bytes = sizeof(effect->input_events);
+		*copied = *input_bytes;
+	}
+}
+
+/* This resolves only the original completed row. It grants no CPU effect,
+ * execution window or new Task/vCPU enrollment. */
+static struct kvm_crucible_pic_initializer_effect *
+q35_cpu_bytes_original_row_locked(struct kvm *kvm,
+	const struct kvm_crucible_q35_cpu_bytes *request)
+{
+	struct kvm_crucible_pic_board *board = &kvm->arch.crucible_pic_board;
+	struct kvm_crucible_pic_initializer_state *actor;
+	struct kvm_crucible_pic_initializer_effect *effect;
+
+	lockdep_assert_held(&kvm->crucible_gate_lock);
+	if (board->constructor != current ||
+	    board->edition != KVM_CRUCIBLE_Q35_BOARD_ONLY ||
+	    !board->initializer_roster.selected ||
+	    board->initializer_roster.enrollment_id != request->enrollment_id)
+		return NULL;
+	actor = &board->initializer_roster.actors[request->native_vcpu_id];
+	if (!actor->task || !actor->vcpu || actor->inflight ||
+	    actor->enrollment_id != request->enrollment_id ||
+	    actor->native_vcpu_id != request->native_vcpu_id ||
+	    kvm_get_vcpu(kvm, request->native_vcpu_id) != actor->vcpu ||
+	    actor->vcpu->vcpu_id != request->native_vcpu_id ||
+	    request->effect_index > actor->issued)
+		return NULL;
+	effect = &actor->effects[request->effect_index - 1];
+	/* A scalar receipt is not a complete byte owner. Selected nested GET
+	 * now owns its literal producer output; the ordinary user-output path
+	 * remains separate. Refuse every selector lacking an original byte
+	 * owner rather than manufacture an empty complete payload. */
+	if (!pic_initializer_cpu_bytes_operation(effect->native_ioctl) &&
+	    !effect->input_msrs_known && !effect->input_nested_known &&
+	    !effect->input_events_known)
+		return NULL;
+	if (effect->native_ioctl != request->native_ioctl)
+		return NULL;
+	return effect;
+}
+
+/* A failed variable allocation can leave only the original CPUID header.
+ * Edition1 retains its exact span semantics. Edition2 names that real surviving
+ * bank instead of guessing the originally requested variable allocation. */
+static void q35_cpu_bytes_spans_v2(
+	const struct kvm_crucible_pic_initializer_effect *effect,
+	const void **input, u64 *input_bytes, const void **output,
+	u64 *output_bytes, u64 *copied)
+{
+	q35_cpu_bytes_retained_spans(effect, input, input_bytes, output,
+		output_bytes, copied);
+	if (!*input && effect->cpuid_header) {
+		*input = effect->cpuid_header;
+		*input_bytes = sizeof(struct kvm_cpuid2);
+		*copied = effect->cpuid_header_copied_bytes;
+	}
+}
+
+static int q35_cpu_bytes_admit_locked(struct kvm *kvm,
+	const struct kvm_crucible_q35_cpu_bytes *request,
+	struct kvm_crucible_pic_initializer_effect **retained,
+	const void **input, const void **output)
+{
+	struct kvm_crucible_pic_board *board = &kvm->arch.crucible_pic_board;
+	struct kvm_crucible_pic_initializer_state *actor;
+	struct kvm_crucible_pic_initializer_effect *effect;
+	struct kvm_crucible_q35_cpu_bytes reply = *request;
+	u64 input_bytes, output_bytes, copied;
+
+	lockdep_assert_held(&kvm->crucible_gate_lock);
+	if (board->constructor != current ||
+	    board->edition != KVM_CRUCIBLE_Q35_BOARD_ONLY ||
+	    !board->initializer_roster.selected ||
+	    board->initializer_roster.enrollment_id != request->enrollment_id)
+		return -EPERM;
+	actor = &board->initializer_roster.actors[request->native_vcpu_id];
+	if (!actor->task || !actor->vcpu || actor->inflight ||
+	    actor->enrollment_id != request->enrollment_id ||
+	    actor->native_vcpu_id != request->native_vcpu_id ||
+	    kvm_get_vcpu(kvm, request->native_vcpu_id) != actor->vcpu ||
+	    actor->vcpu->vcpu_id != request->native_vcpu_id ||
+	    request->effect_index > actor->issued)
+		return -ESTALE;
+	effect = &actor->effects[request->effect_index - 1];
+	/* A scalar receipt is not a complete byte owner. Selected nested GET
+	 * now owns its literal producer output; the ordinary user-output path
+	 * remains separate. Refuse every selector lacking an original byte
+	 * owner rather than manufacture an empty complete payload. */
+	if (!pic_initializer_cpu_bytes_operation(effect->native_ioctl) &&
+	    !effect->input_msrs_known && !effect->input_nested_known &&
+	    !effect->input_events_known)
+		return -EOPNOTSUPP;
+	if (effect->native_ioctl != request->native_ioctl)
+		return -ESTALE;
+	if (effect->reader_attempted)
+		return -EALREADY;
+
+	if (request->version == 2) {
+		if (!effect->reader_metadata_attempted ||
+		    effect->reader_metadata_delivery_result ||
+		    effect->reader_metadata_reply.input_bytes != request->input_capacity ||
+		    effect->reader_metadata_reply.output_bytes != request->output_capacity)
+			return -ESTALE;
+		q35_cpu_bytes_spans_v2(effect, input, &input_bytes, output,
+			&output_bytes, &copied);
+	} else {
+		q35_cpu_bytes_retained_spans(effect, input, &input_bytes, output,
+			&output_bytes, &copied);
+	}
+	/* The whole original storage must fit before the one-shot read is spent.
+	 * Capacity mistakes admit no prefix or replacement buffer. */
+	if (copied > input_bytes || input_bytes != request->input_capacity ||
+	    output_bytes != request->output_capacity ||
+	    (!!input_bytes != !!request->input_buffer) ||
+	    (!!output_bytes != !!request->output_buffer))
+		return -EINVAL;
+
+	reply.input_bytes = input_bytes;
+	reply.output_bytes = output_bytes;
+	reply.input_copied_bytes = copied;
+	/* MSR counts and nested required extents are literal native callback
+	 * returns. They remain distinct from normalized ioctl delivery below. */
+	reply.native_result = effect->output_msrs_known ?
+		effect->native_msr_result :
+		(effect->native_ioctl == KVM_GET_NESTED_STATE && effect->cpu_callback_returned ?
+		 effect->nested_native_result : effect->native_result);
+	reply.original_delivery_result = pic_initializer_cpu_bytes_operation(effect->native_ioctl) ?
+		effect->cpu_delivery_result : effect->native_result;
+	reply.flags = effect->known ? KVM_CRUCIBLE_Q35_CPU_BYTES_KNOWN :
+		KVM_CRUCIBLE_Q35_CPU_BYTES_UNCERTAIN;
+	if (input_bytes && copied == input_bytes)
+		reply.flags |= KVM_CRUCIBLE_Q35_CPU_BYTES_INPUT_COMPLETE;
+	if (effect->cpu_callback_returned || effect->output_msrs_known ||
+	    (!pic_initializer_cpu_bytes_operation(effect->native_ioctl) && effect->known))
+		reply.flags |= KVM_CRUCIBLE_Q35_CPU_BYTES_NATIVE_RETURNED;
+	if ((effect->cpu_completed &&
+	     (effect->native_ioctl != KVM_GET_NESTED_STATE ||
+	      effect->nested_write_count ||
+	      effect->nested_native_result > effect->output_cpu_bytes)) ||
+	    effect->output_msrs_known)
+		reply.flags |= KVM_CRUCIBLE_Q35_CPU_BYTES_OUTPUT_OBSERVED;
+
+	/* Storage and its metadata were precharged at SELECT. The immutable
+	 * tuple is retained before any user delivery; errors never renew it. */
+	effect->reader_request = *request;
+	effect->reader_reply = reply;
+	effect->reader_attempted = true;
+	effect->reader_delivery_result = -EINPROGRESS;
+	*retained = effect;
+	return 0;
+}
+
+static int q35_cpu_bytes_metadata_locked(struct kvm *kvm,
+	const struct kvm_crucible_q35_cpu_bytes *request,
+	struct kvm_crucible_pic_initializer_effect **retained)
+{
+	struct kvm_crucible_pic_initializer_effect *effect;
+	struct kvm_crucible_q35_cpu_bytes reply = *request;
+	const void *input, *output;
+	u64 input_bytes, output_bytes, copied;
+
+	effect = q35_cpu_bytes_original_row_locked(kvm, request);
+	if (!effect)
+		return -ESTALE;
+	if (effect->reader_metadata_attempted || effect->reader_attempted)
+		return -EALREADY;
+	q35_cpu_bytes_spans_v2(effect, &input, &input_bytes, &output,
+		&output_bytes, &copied);
+	if (copied > input_bytes ||
+	    input_bytes > KVM_CRUCIBLE_PIC_INITIALIZER_MAX_INPUT_BYTES ||
+	    output_bytes > KVM_CRUCIBLE_PIC_INITIALIZER_MAX_INPUT_BYTES)
+		return -ESTALE;
+	reply.input_bytes = input_bytes;
+	reply.output_bytes = output_bytes;
+	reply.input_copied_bytes = copied;
+	/* MSR counts and nested required extents are literal native callback
+	 * returns. They remain distinct from normalized ioctl delivery below. */
+	reply.native_result = effect->output_msrs_known ?
+		effect->native_msr_result :
+		(effect->native_ioctl == KVM_GET_NESTED_STATE && effect->cpu_callback_returned ?
+		 effect->nested_native_result : effect->native_result);
+	reply.original_delivery_result = pic_initializer_cpu_bytes_operation(effect->native_ioctl) ?
+		effect->cpu_delivery_result : effect->native_result;
+	reply.flags = effect->known ? KVM_CRUCIBLE_Q35_CPU_BYTES_KNOWN :
+		KVM_CRUCIBLE_Q35_CPU_BYTES_UNCERTAIN;
+	if (input_bytes && copied == input_bytes)
+		reply.flags |= KVM_CRUCIBLE_Q35_CPU_BYTES_INPUT_COMPLETE;
+	if (effect->cpu_callback_returned || effect->output_msrs_known ||
+	    (!pic_initializer_cpu_bytes_operation(effect->native_ioctl) && effect->known))
+		reply.flags |= KVM_CRUCIBLE_Q35_CPU_BYTES_NATIVE_RETURNED;
+	if ((effect->cpu_completed &&
+	     (effect->native_ioctl != KVM_GET_NESTED_STATE ||
+	      effect->nested_write_count ||
+	      effect->nested_native_result > effect->output_cpu_bytes)) ||
+	    effect->output_msrs_known)
+		reply.flags |= KVM_CRUCIBLE_Q35_CPU_BYTES_OUTPUT_OBSERVED;
+
+
+	/* Both exact bodies and final delivery counters were charged at SELECT.
+	 * Partial delivery consumes this slot, preserving the offered body. */
+	effect->reader_metadata_request = *request;
+	effect->reader_metadata_reply = reply;
+	effect->reader_metadata_delivery_result = -EINPROGRESS;
+	effect->reader_metadata_attempted = true;
+	*retained = effect;
+	return 0;
+}
+
+static int kvm_crucible_q35_cpu_bytes_control(struct kvm *kvm,
+	struct kvm_enable_cap *cap)
+{
+	struct kvm_crucible_q35_cpu_bytes request;
+	struct kvm_crucible_pic_initializer_effect *effect = NULL;
+	void __user *argument = u64_to_user_ptr(cap->args[0]);
+	const void *input = NULL, *output = NULL;
+	unsigned long flags, remaining;
+	int result;
+
+	BUILD_BUG_ON(sizeof(request) != 128);
+	BUILD_BUG_ON(offsetof(struct kvm_crucible_q35_cpu_bytes, native_result) != 80);
+	BUILD_BUG_ON(offsetof(struct kvm_crucible_q35_cpu_bytes, input_copied_bytes) != 104);
+	if (cap->flags || !cap->args[0] || cap->args[1] ||
+	    cap->args[2] || cap->args[3])
+		return -EINVAL;
+	if (copy_from_user(&request, argument, sizeof(request)))
+		return -EFAULT;
+	if (!q35_cpu_bytes_request_valid(&request))
+		return -EINVAL;
+	if (!mutex_trylock(&kvm->crucible_configuration_lock))
+		return -EBUSY;
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	if (request.version == 2 &&
+	    request.operation == KVM_CRUCIBLE_Q35_CPU_BYTES_METADATA_V2)
+		result = q35_cpu_bytes_metadata_locked(kvm, &request, &effect);
+	else
+	result = q35_cpu_bytes_admit_locked(kvm, &request, &effect, &input, &output);
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	if (result)
+		goto unlock;
+
+	if (request.version == 2 &&
+	    request.operation == KVM_CRUCIBLE_Q35_CPU_BYTES_METADATA_V2) {
+		remaining = copy_to_user(argument, &effect->reader_metadata_reply,
+			sizeof(effect->reader_metadata_reply));
+		effect->reader_metadata_header_delivered =
+			sizeof(effect->reader_metadata_reply) - remaining;
+		result = remaining ? -EFAULT : 0;
+		effect->reader_metadata_delivery_result = result;
+		goto unlock;
+	}
+
+	/* Configuration exclusion ends only after the same preowned reply and
+	 * complete payload attempts. No raw spinlock spans a userspace fault. */
+	result = -EFAULT;
+	if (request.input_capacity) {
+		remaining = copy_to_user(u64_to_user_ptr(request.input_buffer),
+			input, request.input_capacity);
+		effect->reader_input_delivered = request.input_capacity - remaining;
+		if (remaining)
+			goto retain_delivery;
+	}
+	if (request.output_capacity) {
+		remaining = copy_to_user(u64_to_user_ptr(request.output_buffer),
+			output, request.output_capacity);
+		effect->reader_output_delivered = request.output_capacity - remaining;
+		if (remaining)
+			goto retain_delivery;
+	}
+	result = 0;
+
+retain_delivery:
+	effect->reader_reply.reader_delivery_result = result;
+	remaining = copy_to_user(argument, &effect->reader_reply,
+		sizeof(effect->reader_reply));
+	effect->reader_header_delivered = sizeof(effect->reader_reply) - remaining;
+	if (remaining)
+		result = -EFAULT;
+	effect->reader_delivery_result = result;
+	/* Preserve the exact header offered before copyout. Header loss changes
+	 * only the separate final delivery record, never that offered body or
+	 * the retained native result and original payload allocations. */
+unlock:
+	mutex_unlock(&kvm->crucible_configuration_lock);
+	return result;
+}
