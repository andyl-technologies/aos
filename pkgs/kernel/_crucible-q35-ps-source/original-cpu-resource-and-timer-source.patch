+/* Native producer admission consumes the same original loaded RUN cut.
+ * Completion may retain an effect after the physical stop; it cannot admit a
+ * new effect or sample a substituted VM/vCPU/counter owner. */
+bool kvm_crucible_q35_ps_pit_guest_current_locked(struct kvm_vcpu *vcpu,
+	u64 *position_ps, bool completion)
+{
+	struct kvm *kvm = vcpu->kvm;
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	struct kvm_crucible_run_return_state *run = &vcpu->crucible_run_return;
+
+	lockdep_assert_held(&kvm->crucible_gate_lock);
+	if (in_interrupt() || !q35_ps_run_counter_current_locked(vcpu) ||
+	    !run->ps_counter_attempted || !run->ps_counter_known || run->ps_counter_result ||
+	    READ_ONCE(kvm->vm_dead) || kvm->crucible_irq_input.tainted ||
+	    kvm->crucible_memory_tainted ||
+	    (!completion && !clock_ps_counter_live_locked(vcpu, false)))
+		return false;
+	*position_ps = q35_ps_now_locked(clock, ktime_get_ns());
+	return true;
+}
