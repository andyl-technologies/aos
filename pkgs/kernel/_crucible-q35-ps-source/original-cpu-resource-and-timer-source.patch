@@ -0,0 +1,243 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Native PIT pulse routing consumes the original worker/expiry issuer, not
+ * the external controller IRQ journal or a caller-selected route capsule. */
+
+static void ps_pit_route_fault_locked(struct kvm *kvm)
+{
+	kvm->arch.crucible_clock.ps.timers.uncertain = true;
+	kvm_crucible_q35_ps_timer_fault_locked(kvm);
+}
+
+static bool ps_pit_route_reference(struct kvm_crucible_ps_timer_state *timers,
+	struct kvm_crucible_ps_timer_route_row *row)
+{
+	u32 index;
+
+	if (!timers->routes || timers->routes_used > timers->installation.maximum_routes ||
+	    timers->installation.maximum_routes > KVM_CRUCIBLE_Q35_PS_TIMER_MAX_ROUTES)
+		return false;
+	for (index = 0; index < timers->routes_used; index++)
+		if (row == &timers->routes[index])
+			return true;
+	return false;
+}
+
+static bool ps_pit_route_context_locked(struct kvm *kvm,
+	struct kvm_crucible_ps_timer_route_row *row)
+{
+	struct kvm_crucible_ps_timer_state *timers = &kvm->arch.crucible_clock.ps.timers;
+	struct kvm_crucible_ps_timer_expiry_row *expiry;
+	u32 index;
+
+	if (!kvm_crucible_q35_ps_pit_dispatch_current_locked(kvm, &expiry) ||
+	    timers->routes_used > timers->installation.maximum_routes ||
+	    timers->installation.maximum_routes > KVM_CRUCIBLE_Q35_PS_TIMER_MAX_ROUTES)
+		return false;
+	for (index = 0; index < timers->routes_used; index++)
+		if (row == &timers->routes[index])
+			return row->expiry == expiry && row->ordinal == index + 1 &&
+				row->generation == expiry->original.generation &&
+				row->source == KVM_PIT_IRQ_SOURCE_ID && !row->gsi &&
+				row->level == timers->pit_dispatch_level &&
+				row->input == &timers->route_storage[index * 2] &&
+				row->buffer == &timers->route_storage[index * 2 + 1];
+	return false;
+}
+
+/* A matching integer chip/pin cannot replace the literal native callback. */
+static bool ps_pit_native_route(const struct kvm_kernel_irq_routing_entry *entry)
+{
+#ifdef CONFIG_KVM_IOAPIC
+	return entry->type == KVM_IRQ_ROUTING_IRQCHIP &&
+		((entry->irqchip.irqchip == KVM_IRQCHIP_PIC_MASTER &&
+		  entry->irqchip.pin == 0 && entry->set == kvm_pic_set_irq) ||
+		 (entry->irqchip.irqchip == KVM_IRQCHIP_IOAPIC &&
+		  entry->irqchip.pin == 2 && entry->set == kvm_ioapic_set_irq));
+#else
+	return false;
+#endif
+}
+
+/* kvm_set_irq passes its exact original native array entry. Reserve/copy all
+ * two source routes before the first callback; callbacks consume in native
+ * reverse-array order and cannot substitute their working storage. */
+static struct kvm_kernel_irq_routing_entry *ps_pit_route_prepare(struct kvm *kvm,
+	int source, u32 gsi, int level, bool line_status,
+	struct kvm_kernel_irq_routing_entry *input, u32 index, u32 count,
+	struct kvm_crucible_ps_timer_route_row **lease)
+{
+	struct kvm_crucible_ps_timer_state *timers = &kvm->arch.crucible_clock.ps.timers;
+	struct kvm_crucible_ps_timer_expiry_row *expiry;
+	struct kvm_crucible_ps_timer_route_row *row;
+	unsigned long flags;
+	u32 begin, position;
+	bool valid = false;
+
+	*lease = NULL;
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	if (!kvm_crucible_q35_ps_pit_dispatch_current_locked(kvm, &expiry) ||
+	    source != KVM_PIT_IRQ_SOURCE_ID || gsi || line_status || level < 0 || level > 1 ||
+	    timers->pit_dispatch_level != level || count != 2 || index >= count ||
+	    timers->pit_dispatch_route || !timers->routes || !timers->route_storage ||
+	    timers->installation.maximum_routes > KVM_CRUCIBLE_Q35_PS_TIMER_MAX_ROUTES)
+		goto fault;
+	if (index == count - 1) {
+		if (timers->routes_used > timers->installation.maximum_routes ||
+		    count > timers->installation.maximum_routes - timers->routes_used ||
+		    timers->routes_used != expiry->route_begin + expiry->route_count)
+			goto fault;
+		/* Both immutable records are complete before any callback effect.
+		 * The original source route table is already frozen by its issuer. */
+		for (position = 0; position < count; position++) {
+			struct kvm_kernel_irq_routing_entry *entry = input - index + position;
+
+			if (!ps_pit_native_route(entry))
+				goto fault;
+		}
+		if ((input - index)->irqchip.irqchip == input->irqchip.irqchip)
+			goto fault;
+		begin = timers->routes_used;
+		timers->routes_used += count;
+		expiry->route_count += count;
+		for (position = 0; position < count; position++) {
+			row = &timers->routes[begin + position];
+			*row->input = *(input - position);
+			*row->buffer = *row->input;
+			row->expiry = expiry;
+			row->ordinal = begin + position + 1;
+			row->generation = expiry->original.generation;
+			row->source = source;
+			row->gsi = gsi;
+			row->level = level;
+			row->native_result = -EINPROGRESS;
+		}
+	}
+	if (expiry->route_count < count)
+		goto fault;
+	begin = expiry->route_begin + expiry->route_count - count;
+	row = &timers->routes[begin + count - index - 1];
+	if (!ps_pit_route_context_locked(kvm, row) || row->attempted || row->known ||
+	    (index + 1 < count && !timers->routes[begin + count - index - 2].known) ||
+	    memcmp(input, row->input, sizeof(*input)))
+		goto fault;
+	row->attempted = true;
+	timers->pit_dispatch_route = row;
+	*lease = row;
+	valid = true;
+	goto unlock;
+fault:
+	ps_pit_route_fault_locked(kvm);
+unlock:
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	if (!valid)
+		kvm_vm_dead(kvm);
+	return valid ? row->buffer : NULL;
+}
+
+static bool ps_pit_route_complete(struct kvm *kvm,
+	struct kvm_crucible_ps_timer_route_row *row, int result)
+{
+	struct kvm_crucible_ps_timer_state *timers = &kvm->arch.crucible_clock.ps.timers;
+	unsigned long flags;
+	u32 index;
+	bool valid;
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	/* Literal native result is retained before permission reconciliation. */
+	row->native_result = result;
+	valid = ps_pit_route_context_locked(kvm, row) && timers->pit_dispatch_route == row &&
+		row->attempted && !row->known && row->receiver_input_known &&
+		row->receiver_output_known &&
+		!memcmp(row->input, row->buffer, sizeof(*row->buffer));
+	for (index = 0; valid && index < 4; index++)
+		if (row->targets[index].attempted && !row->targets[index].known)
+			valid = false;
+	row->known = valid;
+	if (valid)
+		timers->pit_dispatch_route = NULL;
+	else
+		ps_pit_route_fault_locked(kvm);
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	if (!valid)
+		kvm_vm_dead(kvm);
+	return valid;
+}
+
+/* Called under the SAME native PIC/IOAPIC lock as its actual mutations. */
+bool kvm_crucible_q35_ps_pit_receiver_begin(struct kvm *kvm,
+	struct kvm_kernel_irq_routing_entry *entry, void *receiver,
+	const struct kvm_irqchip *input, const unsigned long *irq_states,
+	u32 count, u32 extra, const struct kvm_irqchip *peer, const u64 control[4])
+{
+	struct kvm_crucible_ps_timer_state *timers = &kvm->arch.crucible_clock.ps.timers;
+	struct kvm_crucible_ps_timer_route_row *row;
+	unsigned long flags;
+	u32 index;
+	bool valid;
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	row = timers->pit_dispatch_route;
+	valid = ps_pit_route_context_locked(kvm, row) && row->attempted && !row->known &&
+		!row->receiver_input_known && entry == row->buffer && count <= 24 &&
+		input->chip_id == entry->irqchip.irqchip &&
+		((input->chip_id == KVM_IRQCHIP_PIC_MASTER && count == 16 &&
+		  receiver == kvm->arch.vpic && receiver == kvm->arch.crucible_pic_board.pic) ||
+		 (input->chip_id == KVM_IRQCHIP_IOAPIC && count == 24 &&
+		  receiver == kvm->arch.vioapic && receiver == kvm->arch.crucible_pic_board.ioapic));
+	if (valid) {
+		row->receiver = receiver;
+		row->receiver_input = *input;
+		row->receiver_extra_input = extra;
+		if (peer)
+			row->receiver_peer_input = *peer;
+		memcpy(row->receiver_control_input, control, sizeof(row->receiver_control_input));
+		for (index = 0; index < count; index++)
+			row->receiver_irq_states_input[index] = irq_states[index];
+		row->receiver_input_known = true;
+	} else {
+		ps_pit_route_fault_locked(kvm);
+	}
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	return valid;
+}
+EXPORT_SYMBOL_FOR_KVM_INTERNAL(kvm_crucible_q35_ps_pit_receiver_begin);
+
+bool kvm_crucible_q35_ps_pit_receiver_complete(struct kvm *kvm,
+	struct kvm_kernel_irq_routing_entry *entry, void *receiver,
+	const struct kvm_irqchip *output, const unsigned long *irq_states,
+	u32 count, u32 extra, const struct kvm_irqchip *peer, const u64 control[4], int native_result)
+{
+	struct kvm_crucible_ps_timer_state *timers = &kvm->arch.crucible_clock.ps.timers;
+	struct kvm_crucible_ps_timer_route_row *row;
+	unsigned long flags;
+	u32 index;
+	bool valid;
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	row = timers->pit_dispatch_route;
+	/* The original callback lease survives a lost phase. Retain its observed
+	 * output and raw receiver status before currentness reconciliation. */
+	valid = ps_pit_route_reference(timers, row) && row->attempted && !row->known &&
+		row->receiver_input_known && !row->receiver_output_known && entry == row->buffer &&
+		row->receiver == receiver && output->chip_id == row->receiver_input.chip_id &&
+		((output->chip_id == KVM_IRQCHIP_PIC_MASTER && count == 16) ||
+		 (output->chip_id == KVM_IRQCHIP_IOAPIC && count == 24));
+	if (valid) {
+		row->receiver_native_result = native_result;
+		row->receiver_output = *output;
+		row->receiver_extra_output = extra;
+		if (peer)
+			row->receiver_peer_output = *peer;
+		memcpy(row->receiver_control_output, control, sizeof(row->receiver_control_output));
+		for (index = 0; index < count; index++)
+			row->receiver_irq_states_output[index] = irq_states[index];
+		row->receiver_output_known = true;
+		valid = ps_pit_route_context_locked(kvm, row);
+	}
+	if (!valid) {
+		ps_pit_route_fault_locked(kvm);
+	}
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	return valid;
+}
