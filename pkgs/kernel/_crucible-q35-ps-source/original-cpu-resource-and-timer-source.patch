+/* SPDX-License-Identifier: GPL-2.0-only */
+/* This source-owned cold installation retains typed producer backing. It
+ * neither dispatches a timer nor installs whole execution/output authority. */
+
+#include <linux/overflow.h>
+
+static void ps_timer_bank_free(struct kvm_crucible_ps_timer_state *timers)
+{
+	kfree(timers->pit_arms);
+	kfree(timers->lapic_arms);
+	kfree(timers->expiries);
+	kfree(timers->routes);
+	kfree(timers->route_storage);
+	kfree(timers->nmis);
+	kfree(timers->eois);
+	if (timers->roots.pit_task)
+		put_task_struct(timers->roots.pit_task);
+	memset(timers, 0, sizeof(*timers));
+}
+
+void kvm_crucible_q35_ps_timer_bank_destroy(struct kvm *kvm)
+{
+	/* The architecture calls this after destroying PIT work and all vCPUs. */
+	ps_timer_bank_free(&kvm->arch.crucible_clock.ps.timers);
+}
+
+#ifdef CONFIG_KVM_IOAPIC
+static bool ps_timer_bank_geometry(const struct kvm_crucible_q35_ps_timer_bank *input,
+	u64 *storage_bytes)
+{
+	u64 total = sizeof(struct kvm_crucible_ps_timer_state), bytes;
+	u32 index;
+	u32 counts[] = {
+		input->maximum_pit_arms, input->maximum_lapic_arms,
+		input->maximum_expiries, input->maximum_routes,
+		input->maximum_nmis, input->maximum_eois,
+	};
+	u32 sizes[] = {
+		sizeof(struct kvm_crucible_ps_pit_arm_row),
+		sizeof(struct kvm_crucible_ps_lapic_arm_row),
+		sizeof(struct kvm_crucible_ps_timer_expiry_row),
+		sizeof(struct kvm_crucible_ps_timer_route_row) +
+			2 * sizeof(struct kvm_kernel_irq_routing_entry),
+		sizeof(struct kvm_crucible_ps_timer_nmi_row),
+		sizeof(struct kvm_crucible_ps_timer_eoi_row),
+	};
+	u32 maxima[] = {
+		KVM_CRUCIBLE_Q35_PS_TIMER_MAX_ARMS,
+		KVM_CRUCIBLE_Q35_PS_TIMER_MAX_ARMS,
+		KVM_CRUCIBLE_Q35_PS_TIMER_MAX_EXPIRIES,
+		KVM_CRUCIBLE_Q35_PS_TIMER_MAX_ROUTES,
+		KVM_CRUCIBLE_Q35_PS_TIMER_MAX_NMIS,
+		KVM_CRUCIBLE_Q35_PS_TIMER_MAX_EOIS,
+	};
+
+	if (input->version != 2 || !input->configuration_enrollment_id ||
+	    (input->operation != KVM_CRUCIBLE_Q35_PS_TIMER_INSTALL &&
+	     input->operation != KVM_CRUCIBLE_Q35_PS_TIMER_QUERY) ||
+	    !input->maximum_storage_bytes ||
+	    input->maximum_storage_bytes > KVM_CRUCIBLE_Q35_PS_TIMER_MAX_STORAGE ||
+	    input->actual_storage_bytes || input->native_result || input->flags ||
+	    input->producer_mask || input->reserved32 || input->reserved64 ||
+	    input->pit_arm_row_bytes || input->lapic_arm_row_bytes ||
+	    input->expiry_row_bytes || input->route_row_bytes ||
+	    input->nmi_row_bytes || input->eoi_row_bytes)
+		return false;
+	for (index = 0; index < ARRAY_SIZE(counts); index++) {
+		if (!counts[index] || counts[index] > maxima[index] ||
+		    check_mul_overflow((u64)counts[index], (u64)sizes[index], &bytes) ||
+		    check_add_overflow(total, bytes, &total))
+			return false;
+	}
+	if (total > input->maximum_storage_bytes)
+		return false;
+	*storage_bytes = total;
+	return true;
+}
+
+static bool ps_timer_bank_allocate(struct kvm_crucible_ps_timer_state *timers,
+	const struct kvm_crucible_q35_ps_timer_bank *input)
+{
+	u32 index;
+
+	timers->pit_arms = kcalloc(input->maximum_pit_arms,
+		sizeof(*timers->pit_arms), GFP_KERNEL_ACCOUNT);
+	timers->lapic_arms = kcalloc(input->maximum_lapic_arms,
+		sizeof(*timers->lapic_arms), GFP_KERNEL_ACCOUNT);
+	timers->expiries = kcalloc(input->maximum_expiries,
+		sizeof(*timers->expiries), GFP_KERNEL_ACCOUNT);
+	timers->routes = kcalloc(input->maximum_routes,
+		sizeof(*timers->routes), GFP_KERNEL_ACCOUNT);
+	timers->route_storage = kcalloc(input->maximum_routes * 2,
+		sizeof(*timers->route_storage), GFP_KERNEL_ACCOUNT);
+	timers->nmis = kcalloc(input->maximum_nmis,
+		sizeof(*timers->nmis), GFP_KERNEL_ACCOUNT);
+	timers->eois = kcalloc(input->maximum_eois,
+		sizeof(*timers->eois), GFP_KERNEL_ACCOUNT);
+	if (!timers->pit_arms || !timers->lapic_arms || !timers->expiries ||
+	    !timers->routes || !timers->route_storage || !timers->nmis || !timers->eois)
+		return false;
+	for (index = 0; index < input->maximum_routes; index++) {
+		timers->routes[index].input = &timers->route_storage[index * 2];
+		timers->routes[index].buffer = &timers->route_storage[index * 2 + 1];
+	}
+	return true;
+}
+
+static void ps_timer_bank_output(struct kvm_crucible_q35_ps_timer_bank *output,
+	const struct kvm_crucible_q35_ps_timer_bank *input, u64 storage_bytes)
+{
+	*output = *input;
+	output->actual_storage_bytes = storage_bytes;
+	output->pit_arm_row_bytes = sizeof(struct kvm_crucible_ps_pit_arm_row);
+	output->lapic_arm_row_bytes = sizeof(struct kvm_crucible_ps_lapic_arm_row);
+	output->expiry_row_bytes = sizeof(struct kvm_crucible_ps_timer_expiry_row);
+	output->route_row_bytes = sizeof(struct kvm_crucible_ps_timer_route_row) +
+		2 * sizeof(struct kvm_kernel_irq_routing_entry);
+	output->nmi_row_bytes = sizeof(struct kvm_crucible_ps_timer_nmi_row);
+	output->eoi_row_bytes = sizeof(struct kvm_crucible_ps_timer_eoi_row);
+	output->producer_mask = 31;
+	output->flags = KVM_CRUCIBLE_Q35_PS_TIMER_KNOWN;
+}
+
+static u64 ps_timer_bank_charged(const struct kvm_crucible_ps_timer_state *timers,
+	const struct kvm_crucible_q35_ps_timer_bank *input)
+{
+	u64 bytes = sizeof(*timers);
+
+	if (timers->pit_arms)
+		bytes += (u64)input->maximum_pit_arms * sizeof(*timers->pit_arms);
+	if (timers->lapic_arms)
+		bytes += (u64)input->maximum_lapic_arms * sizeof(*timers->lapic_arms);
+	if (timers->expiries)
+		bytes += (u64)input->maximum_expiries * sizeof(*timers->expiries);
+	if (timers->routes)
+		bytes += (u64)input->maximum_routes * sizeof(*timers->routes);
+	if (timers->route_storage)
+		bytes += (u64)input->maximum_routes * 2 * sizeof(*timers->route_storage);
+	if (timers->nmis)
+		bytes += (u64)input->maximum_nmis * sizeof(*timers->nmis);
+	if (timers->eois)
+		bytes += (u64)input->maximum_eois * sizeof(*timers->eois);
+	return bytes;
+}
+
+static bool ps_timer_roots_read_locked(struct kvm *kvm,
+	struct kvm_crucible_ps_timer_roots *roots)
+{
+	struct kvm_vcpu *vcpu;
+	unsigned long index;
+
+	if (!kvm_crucible_q35_ps_pit_roots_locked(kvm, roots))
+		return false;
+	kvm_for_each_vcpu(index, vcpu, kvm)
+		if (!kvm_crucible_q35_ps_lapic_roots_locked(vcpu, roots))
+			return false;
+	return kvm->created_vcpus == 4;
+}
+#endif
+
+#ifdef CONFIG_KVM_IOAPIC
+static bool ps_timer_origin_closed(struct kvm *kvm,
+	const struct kvm_crucible_ps_timer_origin *origin, u64 ordinal,
+	struct hrtimer *timer, u32 kind)
+{
+	struct kvm_crucible_pic_board *board = &kvm->arch.crucible_pic_board;
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	struct kvm_vcpu *vcpu;
+
+	if (!origin->attempted || !origin->known || !origin->retired ||
+	    origin->native_result || origin->ordinal != ordinal ||
+	    origin->kind != kind || origin->timer != timer ||
+	    !origin->generation || origin->generation > clock->window_generation ||
+	    !origin->invocation || origin->native_vcpu_id >= 4 ||
+	    origin->position_ps > clock->ps.current_ps)
+		return false;
+	vcpu = kvm_get_vcpu(kvm, origin->native_vcpu_id);
+	return vcpu && origin->writer == vcpu &&
+		board->initializer_roster.actors[origin->native_vcpu_id].vcpu == vcpu &&
+		origin->actor == board->initializer_roster.actors[origin->native_vcpu_id].task;
+}
+
+static bool ps_timer_expiry_reference(const struct kvm_crucible_ps_timer_state *timers,
+	const struct kvm_crucible_ps_timer_expiry_row *expiry)
+{
+	u32 index;
+
+	/* Equality is checked before dereference. No pointer range comparison or
+	 * caller-selected address can create a native expiry reference. */
+	for (index = 0; index < timers->expiries_used; index++)
+		if (expiry == &timers->expiries[index])
+			return true;
+	return false;
+}
+
+static bool ps_timer_arm_reference(const struct kvm_crucible_ps_timer_state *timers,
+	const struct kvm_crucible_ps_timer_expiry_row *expiry)
+{
+	u32 index;
+
+	for (index = 0; index < timers->pit_arms_used; index++)
+		if (expiry->arm == &timers->pit_arms[index].original)
+			return expiry->original.kind == 1 &&
+				expiry->worker == timers->roots.pit_task;
+	for (index = 0; index < timers->lapic_arms_used; index++)
+		if (expiry->arm == &timers->lapic_arms[index].original)
+			return expiry->original.kind == 2 &&
+				expiry->worker == expiry->arm->actor;
+	return false;
+}
+
+static bool ps_timer_delivery_closed(const struct kvm_crucible_ps_timer_delivery_row *row,
+	const struct kvm_crucible_q35_ps_timer_bank *input,
+	const struct kvm_crucible_q35_ps_timer_bank *output,
+	struct task_struct *owner, u64 ordinal)
+{
+	if (row->actor != owner || row->ordinal != ordinal || !row->output_known ||
+	    !row->delivery_known || !row->delivery_attempted ||
+	    row->uncopied > sizeof(*output) ||
+	    row->syscall_result != (row->uncopied ? -EFAULT : 0))
+		return false;
+	return !memcmp(&row->input, input, sizeof(*input)) &&
+		!memcmp(&row->output, output, sizeof(*output));
+}
+#endif
+
+/* A closed native queue is insufficient if an original callback output is
+ * unresolved. This walk reads only source-owned lifetime rows and retains
+ * them after closure; it grants neither execution nor publication authority.
+ * Until a genuine logical carry issuer exists, every consumed arm must be
+ * retired. A future deadline alone cannot stand in for that ownership. */
+bool kvm_crucible_q35_ps_timer_outputs_closed_locked(struct kvm *kvm)
+{
+#ifdef CONFIG_KVM_IOAPIC
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	struct kvm_crucible_ps_clock_state *ps = &clock->ps;
+	struct kvm_crucible_ps_timer_state *timers = &ps->timers;
+	const struct kvm_crucible_q35_ps_timer_bank *input = &timers->installation;
+	struct kvm_crucible_q35_ps_timer_bank expected, query_input, query_output;
+	struct kvm_crucible_ps_timer_roots roots = {};
+	u64 bytes, route_end = 0, nmi_end = 0;
+	u32 index;
+
+	lockdep_assert_held(&kvm->crucible_gate_lock);
+	lockdep_assert_held(&kvm->lock);
+	lockdep_assert_held(&kvm->slots_lock);
+	lockdep_assert_held(&kvm->irq_lock);
+	if (!ps->selected || ps->plan.version != 2 || ps->controller != current ||
+	    timers->owner != ps->controller || !timers->installation_attempted ||
+	    !timers->installation_known || !timers->installed || timers->uncertain ||
+	    timers->pit_access || timers->pit_active_arm || timers->pit_queued_expiry ||
+	    !timers->pit_arms || !timers->lapic_arms || !timers->expiries ||
+	    !timers->routes || !timers->route_storage || !timers->nmis || !timers->eois ||
+	    input->operation != KVM_CRUCIBLE_Q35_PS_TIMER_INSTALL ||
+	    input->configuration_enrollment_id != ps->plan.configuration_enrollment_id ||
+	    !ps_timer_bank_geometry(input, &bytes) ||
+	    ps_timer_bank_charged(timers, input) != bytes ||
+	    timers->pit_arms_used > input->maximum_pit_arms ||
+	    timers->lapic_arms_used > input->maximum_lapic_arms ||
+	    timers->expiries_used > input->maximum_expiries ||
+	    timers->routes_used > input->maximum_routes ||
+	    timers->nmis_used > input->maximum_nmis ||
+	    timers->eois_used > input->maximum_eois ||
+	    !ps_timer_roots_read_locked(kvm, &roots) ||
+	    memcmp(&roots, &timers->roots, sizeof(roots)))
+		return false;
+	ps_timer_bank_output(&expected, input, bytes);
+	if (memcmp(&expected, &timers->installation_output, sizeof(expected)) ||
+	    !ps_timer_delivery_closed(&timers->deliveries[0], input, &expected,
+		ps->controller, 1))
+		return false;
+	if (timers->installation_queried) {
+		query_input = *input;
+		query_input.operation = KVM_CRUCIBLE_Q35_PS_TIMER_QUERY;
+		query_output = expected;
+		query_output.operation = query_input.operation;
+		if (!ps_timer_delivery_closed(&timers->deliveries[1], &query_input,
+			&query_output, ps->controller, 2))
+			return false;
+	}
+	for (index = 0; index < timers->pit_arms_used; index++) {
+		const struct kvm_crucible_ps_pit_arm_row *row = &timers->pit_arms[index];
+
+		if (!row->state_output_known ||
+		    (row->cancel_attempted && (!row->cancel_known || row->cancel_result < 0)) ||
+		    row->pit != roots.pit ||
+		    !ps_timer_origin_closed(kvm, &row->original, index + 1, roots.pit_timer, 1))
+			return false;
+	}
+	for (index = 0; index < timers->lapic_arms_used; index++) {
+		const struct kvm_crucible_ps_lapic_arm_row *row = &timers->lapic_arms[index];
+		u32 vcpu_id = row->original.native_vcpu_id;
+
+		if (vcpu_id >= 4 || row->apic != roots.apics[vcpu_id] ||
+		    !ps_timer_origin_closed(kvm, &row->original, index + 1,
+			roots.lapic_timers[vcpu_id], 2))
+			return false;
+	}
+	for (index = 0; index < timers->expiries_used; index++) {
+		const struct kvm_crucible_ps_timer_expiry_row *row = &timers->expiries[index];
+
+		if (!ps_timer_arm_reference(timers, row) || !row->completion_known ||
+		    !ps_timer_origin_closed(kvm, &row->original, index + 1,
+			row->arm->timer, row->arm->kind) ||
+		    row->original.generation != row->arm->generation ||
+		    row->observed_ps < row->arm->deadline_ps || row->observed_ps > ps->current_ps ||
+		    row->route_begin != route_end || row->nmi_begin != nmi_end ||
+		    check_add_overflow(route_end, (u64)row->route_count, &route_end) ||
+		    check_add_overflow(nmi_end, (u64)row->nmi_count, &nmi_end) ||
+		    route_end > timers->routes_used || nmi_end > timers->nmis_used)
+			return false;
+	}
+	if (route_end != timers->routes_used || nmi_end != timers->nmis_used)
+		return false;
+	for (index = 0; index < timers->routes_used; index++) {
+		const struct kvm_crucible_ps_timer_route_row *row = &timers->routes[index];
+
+		if (!row->attempted || !row->known || row->ordinal != index + 1 ||
+		    !ps_timer_expiry_reference(timers, row->expiry) ||
+		    row->generation != row->expiry->original.generation ||
+		    index < row->expiry->route_begin ||
+		    index - row->expiry->route_begin >= row->expiry->route_count ||
+		    row->input != &timers->route_storage[index * 2] ||
+		    row->buffer != &timers->route_storage[index * 2 + 1])
+			return false;
+	}
+	for (index = 0; index < timers->nmis_used; index++) {
+		const struct kvm_crucible_ps_timer_nmi_row *row = &timers->nmis[index];
+
+		if (!row->attempted || !row->known || row->ordinal != index + 1 ||
+		    row->native_vcpu_id >= 4 ||
+		    row->vcpu != kvm_get_vcpu(kvm, row->native_vcpu_id) ||
+		    row->apic != roots.apics[row->native_vcpu_id] ||
+		    !ps_timer_expiry_reference(timers, row->expiry) ||
+		    row->generation != row->expiry->original.generation ||
+		    index < row->expiry->nmi_begin ||
+		    index - row->expiry->nmi_begin >= row->expiry->nmi_count)
+			return false;
+	}
+	for (index = 0; index < timers->eois_used; index++) {
+		const struct kvm_crucible_ps_timer_eoi_row *row = &timers->eois[index];
+		const struct kvm_crucible_pic_initializer_state *actor;
+
+		if (row->native_vcpu_id >= 4)
+			return false;
+		actor = &kvm->arch.crucible_pic_board.initializer_roster.actors[row->native_vcpu_id];
+		if (!row->attempted || !row->known || row->ordinal != index + 1 ||
+		    row->vcpu != kvm_get_vcpu(kvm, row->native_vcpu_id) ||
+		    actor->vcpu != row->vcpu || actor->task != row->actor ||
+		    !row->invocation || row->vector > 255 || row->pin >= 24 || row->trigger_mode > 1 ||
+		    !ps_timer_expiry_reference(timers, row->expiry) ||
+		    row->generation != row->expiry->original.generation)
+			return false;
+	}
+	return true;
+#else
+	return false;
+#endif
+}
+
+int kvm_crucible_q35_ps_timer_bank_control(struct kvm *kvm, struct kvm_enable_cap *cap)
+{
+#ifdef CONFIG_KVM_IOAPIC
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	struct kvm_crucible_ps_clock_state *ps = &clock->ps;
+	struct kvm_crucible_ps_timer_state *timers = &ps->timers;
+	struct kvm_crucible_ps_timer_state allocation = {};
+	struct kvm_crucible_q35_ps_timer_bank input, output, identity;
+	struct kvm_crucible_ps_timer_roots roots = {};
+	struct kvm_crucible_ps_timer_roots observed = {};
+	struct kvm_vcpu *vcpu;
+	void __user *argument = u64_to_user_ptr(cap->args[0]);
+	unsigned long index, flags;
+	u64 storage_bytes, closed, pending;
+	u32 locked = 0, uncopied = 0;
+	int delivery_index = -1;
+	int result = -EBUSY;
+	bool contain = false;
+
+	BUILD_BUG_ON(sizeof(input) != 128);
+	if (cap->flags || !argument || cap->args[1] || cap->args[2] || cap->args[3])
+		return -EINVAL;
+	if (copy_from_user(&input, argument, sizeof(input)))
+		return -EFAULT;
+	if (!ps_timer_bank_geometry(&input, &storage_bytes))
+		return -EINVAL;
+	if (!mutex_trylock(&clock->control_lock))
+		return -EBUSY;
+	if (!mutex_trylock(&kvm->crucible_configuration_lock))
+		goto unlock_control;
+	if (!mutex_trylock(&kvm->lock))
+		goto unlock_configuration;
+	if (!mutex_trylock(&kvm->slots_lock))
+		goto unlock_vm;
+	if (!mutex_trylock(&kvm->irq_lock))
+		goto unlock_slots;
+	kvm_for_each_vcpu(index, vcpu, kvm) {
+		if (index != locked || index >= 4 || !mutex_trylock(&vcpu->mutex))
+			goto unlock_vcpus;
+		locked++;
+	}
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	result = -EOPNOTSUPP;
+	if (!ps->selected || ps->plan.version != 2 || ps->controller != current ||
+	    ps->plan.configuration_enrollment_id != input.configuration_enrollment_id ||
+	    timers->uncertain || READ_ONCE(kvm->vm_dead) ||
+	    kvm->crucible_irq_input.tainted || kvm->crucible_memory_tainted)
+		goto unlock_gate;
+	if (input.operation == KVM_CRUCIBLE_Q35_PS_TIMER_QUERY) {
+		identity = input;
+		identity.operation = KVM_CRUCIBLE_Q35_PS_TIMER_INSTALL;
+		if (!timers->installation_attempted || !timers->installation_known ||
+		    timers->owner != current ||
+		    timers->installation_queried ||
+		    memcmp(&identity, &timers->installation, sizeof(identity)))
+			goto unlock_gate;
+		/* Cached installation readback does not assert active root currentness. */
+		delivery_index = 1;
+		timers->deliveries[1].input = input;
+		timers->deliveries[1].actor = current;
+		timers->deliveries[1].ordinal = 2;
+		timers->installation_queried = true;
+		output = timers->installation_output;
+		output.operation = input.operation;
+		timers->deliveries[1].output = output;
+		timers->deliveries[1].output_known = true;
+		result = 0;
+		goto unlock_gate;
+	}
+	if (timers->installation_attempted || timers->installed ||
+	    timers->pit_arms || timers->lapic_arms ||
+	    timers->expiries || timers->routes || timers->route_storage ||
+	    timers->nmis || timers->eois || ps->phase != KVM_CRUCIBLE_PS_COLD ||
+	    input.expected_phase != ps->phase || input.generation || input.position_ps ||
+	    clock->window_generation || clock->active || clock->run_owners ||
+	    clock->timer_owners || kvm->crucible_effect_owners ||
+	    kvm->crucible_irq_input.enabled || kvm->crucible_irq_input.owners ||
+	    !ps->irq.installed || ps->irq.uncertain || ps->irq.owner != current ||
+	    !kvm_arch_crucible_q35_ps_native_cut_locked(kvm, &closed, &pending) ||
+	    closed != 15 || pending ||
+	    !kvm_arch_crucible_q35_ps_timers_closed_locked(kvm) ||
+	    !ps_timer_roots_read_locked(kvm, &roots))
+		goto unlock_gate;
+
+	/* Once-retained input and actor consume the installation before allocation.
+	 * A failed allocation has its own cached result and cannot renew a bank. */
+	timers->installation = input;
+	timers->owner = current;
+	timers->installation_attempted = true;
+	delivery_index = 0;
+	timers->deliveries[0].input = input;
+	timers->deliveries[0].actor = current;
+	timers->deliveries[0].ordinal = 1;
+	get_task_struct(roots.pit_task);
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+
+	result = ps_timer_bank_allocate(&allocation, &input) ? 0 : -ENOMEM;
+	allocation.installation = input;
+	allocation.owner = current;
+	allocation.roots = roots;
+	allocation.installation_attempted = true;
+	allocation.installation_known = true;
+	allocation.installed = !result;
+	ps_timer_bank_output(&output, &input, storage_bytes);
+	output.actual_storage_bytes = ps_timer_bank_charged(&allocation, &input);
+	output.native_result = result;
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	if (ps->phase != KVM_CRUCIBLE_PS_COLD || timers->owner != current ||
+	    !timers->installation_attempted ||
+	    memcmp(&timers->installation, &input, sizeof(input)) ||
+	    kvm->crucible_irq_input.tainted || kvm->crucible_memory_tainted ||
+	    READ_ONCE(kvm->vm_dead) || clock->active || clock->run_owners ||
+	    clock->timer_owners ||
+	    !kvm_arch_crucible_q35_ps_native_cut_locked(kvm, &closed, &pending) ||
+	    closed != 15 || pending ||
+	    !kvm_arch_crucible_q35_ps_timers_closed_locked(kvm) ||
+	    !ps_timer_roots_read_locked(kvm, &observed) ||
+	    memcmp(&roots, &observed, sizeof(roots))) {
+		allocation.uncertain = true;
+		allocation.installed = false;
+		allocation.installation_known = false;
+		output.flags |= KVM_CRUCIBLE_Q35_PS_TIMER_UNCERTAIN;
+		ps->phase = KVM_CRUCIBLE_PS_UNKNOWN;
+		kvm_arch_crucible_irq_taint_locked(kvm);
+		contain = true;
+		result = -EIO;
+	}
+	/* Partial backing is retained through teardown too. Neither failure nor
+	 * a changed source cut returns installation credit to the constructor. */
+	allocation.installation_output = output;
+	allocation.deliveries[0] = timers->deliveries[0];
+	allocation.deliveries[0].output = output;
+	allocation.deliveries[0].output_known = true;
+	*timers = allocation;
+	memset(&allocation, 0, sizeof(allocation));
+unlock_gate:
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+unlock_vcpus:
+	while (locked)
+		mutex_unlock(&kvm_get_vcpu(kvm, --locked)->mutex);
+	mutex_unlock(&kvm->irq_lock);
+unlock_slots:
+	mutex_unlock(&kvm->slots_lock);
+unlock_vm:
+	mutex_unlock(&kvm->lock);
+unlock_configuration:
+	mutex_unlock(&kvm->crucible_configuration_lock);
+unlock_control:
+	mutex_unlock(&clock->control_lock);
+	ps_timer_bank_free(&allocation);
+	if (contain)
+		kvm_vm_dead(kvm);
+	if (!result) {
+		/* The complete native output was retained before this user callback. */
+		uncopied = copy_to_user(argument, &output, sizeof(output));
+		if (uncopied)
+			result = -EFAULT;
+	}
+	if (delivery_index >= 0) {
+		struct kvm_crucible_ps_timer_delivery_row *delivery =
+			&timers->deliveries[delivery_index];
+
+		/* The original VM file reference spans delivery. Query does not edit
+		 * the earlier INSTALL row, even when either user mapping rejects copy. */
+		raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+		delivery->syscall_result = result;
+		delivery->uncopied = uncopied;
+		delivery->delivery_attempted = !result || uncopied;
+		delivery->delivery_known = true;
+		raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	}
+	return result;
+#else
+	return -EOPNOTSUPP;
+#endif
+}
