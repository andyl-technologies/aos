+/* One literal route callback consumes this private original lease. */
+struct ps_irq_route_lease {
+	struct kvm_crucible_ps_irq_row *row;
+	struct kvm_kernel_irq_routing_entry *buffer;
+	u32 index;
+};
+
+static bool ps_irq_route_context_locked(struct kvm *kvm,
+	struct kvm_crucible_ps_irq_row *row)
+{
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	struct kvm_crucible_ps_clock_state *ps = &clock->ps;
+	struct kvm_crucible_ps_irq_state *irq = &ps->irq;
+	u32 id;
+
+	lockdep_assert_held(&kvm->crucible_gate_lock);
+	if (!ps->selected || ps->plan.version != 2 || !ps->execution_installed ||
+	    !irq->installed || irq->uncertain || !irq->rows || !irq->route_storage ||
+	    irq->inflight != row || !row || row->known || !row->claimed ||
+	    irq->owner != current || ps->controller != current || in_interrupt() ||
+	    clock->active || clock->run_owners || clock->timer_owners ||
+	    kvm->crucible_irq_input.enabled || kvm->crucible_irq_input.tainted ||
+	    kvm->crucible_memory_tainted || READ_ONCE(kvm->vm_dead) ||
+	    irq->routing != kvm->arch.crucible_pic_board.routing ||
+	    irq->routing != rcu_dereference_protected(kvm->irq_routing, 1) ||
+	    (ps->phase != KVM_CRUCIBLE_PS_COLD && ps->phase != KVM_CRUCIBLE_PS_ACKNOWLEDGED))
+		return false;
+	id = row->input.input_id;
+	return id && id <= irq->issued && id <= irq->installation.maximum_inputs &&
+		row == &irq->rows[id - 1] &&
+		row->route_inputs == irq->route_storage + (id - 1) * 2 * KVM_NR_IRQCHIPS &&
+		row->route_buffers == row->route_inputs + KVM_NR_IRQCHIPS &&
+		row->input.configuration_enrollment_id == ps->plan.configuration_enrollment_id &&
+		row->input.generation == clock->window_generation &&
+		row->input.position_ps == ps->current_ps && row->input.expected_phase == ps->phase;
+}
+
+static void ps_irq_route_fault_locked(struct kvm *kvm)
+{
+	lockdep_assert_held(&kvm->crucible_gate_lock);
+	kvm->arch.crucible_clock.ps.irq.uncertain = true;
+	kvm->arch.crucible_clock.ps.phase = KVM_CRUCIBLE_PS_UNKNOWN;
+	kvm_arch_crucible_irq_taint_locked(kvm);
+}
+
+/* Immutable input and native working storage were reserved by the original
+ * cold installation. Publication precedes the callback, never its retry. */
+static struct kvm_kernel_irq_routing_entry *ps_irq_route_prepare(struct kvm *kvm,
+	int source, u32 gsi, int level, bool line_status,
+	struct kvm_kernel_irq_routing_entry *input, u32 index, u32 count,
+	struct ps_irq_route_lease *lease)
+{
+	struct kvm_crucible_ps_clock_state *ps = &kvm->arch.crucible_clock.ps;
+	struct kvm_crucible_ps_irq_row *row;
+	unsigned long flags;
+	u32 previous;
+	bool valid;
+
+	lease->row = NULL;
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	/* This is not IRQ permission: source_begin already admitted the genuine
+	 * ordinary or original constructor lane before reaching this reader. */
+	if (!ps->selected || ps->plan.version != 2 || !ps->irq.installed) {
+		raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+		return input;
+	}
+	row = ps->irq.inflight;
+	valid = ps_irq_route_context_locked(kvm, row) && count &&
+		count <= KVM_NR_IRQCHIPS && index < count &&
+		source == KVM_USERSPACE_IRQ_SOURCE_ID && !line_status &&
+		gsi == row->input.gsi && level >= 0 && level <= 1 &&
+		(u32)level == row->input.level && input->type == KVM_IRQ_ROUTING_IRQCHIP &&
+		input->set && (!row->route_count || row->route_count == count);
+	if (valid) {
+		previous = ((1U << count) - 1) & ~((1U << (index + 1)) - 1);
+		valid = row->routes_attempted == previous && row->routes_known == previous;
+	}
+	if (valid) {
+		row->route_count = count;
+		row->route_inputs[index] = *input;
+		row->route_buffers[index] = row->route_inputs[index];
+		row->route_results[index] = -EINPROGRESS;
+		row->routes_attempted |= 1U << index;
+		lease->row = row;
+		lease->buffer = &row->route_buffers[index];
+		lease->index = index;
+	} else {
+		ps_irq_route_fault_locked(kvm);
+	}
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	if (!valid) {
+		kvm_vm_dead(kvm);
+		return NULL;
+	}
+	return lease->buffer;
+}
+
+/* The exact raw callback return is cached before aggregate interpretation.
+ * A masked/ignored negative IRQ result can be Known; it is not NoEffect. */
+static bool ps_irq_route_complete(struct kvm *kvm,
+	struct ps_irq_route_lease *lease, int native_result)
+{
+	struct kvm_crucible_ps_irq_row *row = lease->row;
+	unsigned long flags;
+	bool valid;
+
+	if (!row)
+		return true;
+	lease->row = NULL;
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	row->route_results[lease->index] = native_result;
+	valid = ps_irq_route_context_locked(kvm, row) &&
+		lease->index < row->route_count &&
+		lease->buffer == &row->route_buffers[lease->index] &&
+		(row->routes_attempted & (1U << lease->index)) &&
+		!(row->routes_known & (1U << lease->index)) &&
+		!memcmp(&row->route_inputs[lease->index], lease->buffer, sizeof(*lease->buffer));
+	if (valid)
+		row->routes_known |= 1U << lease->index;
+	else
+		ps_irq_route_fault_locked(kvm);
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	if (!valid)
+		kvm_vm_dead(kvm);
+	return valid;
+}
