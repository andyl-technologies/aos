+static DEFINE_RAW_SPINLOCK(crucible_vm_area_lock);
+static u32 crucible_vm_area_used;
+static u64 crucible_vm_area_generation;
+
+/* A cleanup worker gets an allocation-refusal guard, not the original
+ * constructor's permission. Original callbacks are observational and cannot
+ * obtain an ordinary allocator path by running outside that Task scope.
+ */
+static void crucible_vm_area_observe(struct crucible_vm_area_origin *record,
+	const struct crucible_vm_area_cleanup *output, bool native_returned)
+{
+	struct crucible_allocator_scope *saved = READ_ONCE(current->crucible_allocator_scope);
+	struct crucible_allocator_scope guard = {
+		.original_task = current,
+		.original_owner = record->original_owner,
+		.original_ops = record->original_ops,
+		.callback_active = true,
+	};
+
+	WRITE_ONCE(current->crucible_allocator_scope, &guard);
+	record->original_ops->observe_vm_area_cleanup(record->original_owner,
+		record->original_lease, output, native_returned);
+	WRITE_ONCE(current->crucible_allocator_scope, saved);
+}
+
+u64 crucible_allocator_vm_area_metadata_bytes(void)
