+void crucible_allocator_vm_area_defer(struct vm_struct *area,
+	struct work_struct *work, void (*method)(struct work_struct *),
+	struct crucible_vm_area_token *token)
+{
+	struct crucible_vm_area_origin *record;
+	struct crucible_vm_area_cleanup output;
+	unsigned long flags;
+
+	token->original_record = NULL;
+	token->generation = 0;
+	raw_spin_lock_irqsave(&crucible_vm_area_lock, flags);
+	record = crucible_vm_area_find(area);
+	if (!record || record->state != CRUCIBLE_VM_AREA_BOUND) {
+		raw_spin_unlock_irqrestore(&crucible_vm_area_lock, flags);
+		return;
+	}
+	/* Original area membership precedes native-field snapshots. Work and
+	 * literal method are retained BEFORE list publication or scheduling.
+	 */
+	record->cleanup.original_area = area;
+	record->cleanup.enqueue_attempted = true;
+	record->cleanup.original_work = work;
+	record->cleanup.original_method = method;
+	record->cleanup.native_address = area->addr;
+	record->cleanup.native_pages = area->pages;
+	record->cleanup.native_page_count = area->nr_pages;
+	record->cleanup.native_path = area->pages ? 2 : 1;
+	record->cleanup.route_same = work && method && work->func == method;
+	record->state = CRUCIBLE_VM_AREA_DEFERRED;
+	output = record->cleanup;
+	token->original_record = record;
+	token->generation = record->generation;
+	raw_spin_unlock_irqrestore(&crucible_vm_area_lock, flags);
+	crucible_vm_area_observe(record, &output, false);
+}
+EXPORT_SYMBOL_GPL(crucible_allocator_vm_area_defer);
+
+void crucible_allocator_vm_area_enqueued(struct crucible_vm_area_token *token,
+	bool list_was_empty, bool schedule_attempted, bool schedule_accepted)
+{
+	struct crucible_vm_area_origin *record;
+	struct crucible_vm_area_cleanup output;
+	unsigned long flags;
+
+	if (!token->original_record)
+		return;
+	raw_spin_lock_irqsave(&crucible_vm_area_lock, flags);
+	record = crucible_vm_area_token_find(token);
+	if (!record) {
+		raw_spin_unlock_irqrestore(&crucible_vm_area_lock, flags);
+		return;
+	}
+	/* Worker completion can precede this observation. The original token,
+	 * not an area address that may have been freed/reused, retains its row.
+	 */
+	record->cleanup.enqueue_returned = true;
+	record->cleanup.list_was_empty = list_was_empty;
+	record->cleanup.schedule_attempted = schedule_attempted;
+	record->cleanup.schedule_accepted = schedule_accepted;
+	output = record->cleanup;
+	raw_spin_unlock_irqrestore(&crucible_vm_area_lock, flags);
+	token->original_record = NULL;
+	crucible_vm_area_observe(record, &output, false);
+}
+EXPORT_SYMBOL_GPL(crucible_allocator_vm_area_enqueued);
+
+void crucible_allocator_vm_area_cleanup_begin(struct vm_struct *area,
+	struct work_struct *work, void (*method)(struct work_struct *),
+	struct crucible_vm_area_token *token)
+{
+	struct crucible_vm_area_origin *record;
+	struct crucible_vm_area_cleanup output;
+	unsigned long flags;
+
+	token->original_record = NULL;
+	token->generation = 0;
+	raw_spin_lock_irqsave(&crucible_vm_area_lock, flags);
+	record = crucible_vm_area_find(area);
+	if (!record) {
+		raw_spin_unlock_irqrestore(&crucible_vm_area_lock, flags);
+		return;
+	}
+	/* Closing precedes every native backing/metadata free in the worker.
+	 * The worker is an observed cleanup actor, never the original Task's
+	 * allocator permission. It does not inherit an allocation scope.
+	 */
+	record->cleanup.original_area = area;
+	record->cleanup.native_actor = current;
+	record->cleanup.native_running = true;
+	record->cleanup.closing = true;
+	record->cleanup.native_work = work;
+	record->cleanup.native_method = method;
+	if (record->state == CRUCIBLE_VM_AREA_DEFERRED)
+		record->cleanup.route_same = record->cleanup.original_work == work &&
+			record->cleanup.original_method == method && work && method &&
+			work->func == method && record->cleanup.native_address == area->addr &&
+			record->cleanup.native_pages == area->pages &&
+			record->cleanup.native_page_count == area->nr_pages;
+	else
+		record->cleanup.route_same = !work && !method;
+	if (record->state == CRUCIBLE_VM_AREA_BOUND) {
+		record->cleanup.native_address = area->addr;
+		record->cleanup.native_pages = area->pages;
+		record->cleanup.native_page_count = area->nr_pages;
+		record->cleanup.native_path = area->pages ? 2 : 1;
+	}
+	record->state = CRUCIBLE_VM_AREA_CLOSING;
+	output = record->cleanup;
+	token->original_record = record;
+	token->generation = record->generation;
+	raw_spin_unlock_irqrestore(&crucible_vm_area_lock, flags);
+	crucible_vm_area_observe(record, &output, false);
+}
+EXPORT_SYMBOL_GPL(crucible_allocator_vm_area_cleanup_begin);
+
+void crucible_allocator_vm_area_cleanup_complete(struct crucible_vm_area_token *token)
+{
+	struct crucible_vm_area_origin *record;
+	struct crucible_vm_area_cleanup output;
+	unsigned long flags;
+
+	if (!token->original_record)
+		return;
+	raw_spin_lock_irqsave(&crucible_vm_area_lock, flags);
+	record = crucible_vm_area_token_find(token);
+	if (!record || record->state != CRUCIBLE_VM_AREA_CLOSING) {
+		raw_spin_unlock_irqrestore(&crucible_vm_area_lock, flags);
+		return;
+	}
+	record->state = CRUCIBLE_VM_AREA_RETURNED;
+	record->cleanup.native_returned = true;
+	output = record->cleanup;
+	raw_spin_unlock_irqrestore(&crucible_vm_area_lock, flags);
+	token->original_record = NULL;
+	/* The area is already gone. No pointer follow, implicit refund, work
+	 * cancellation/flush or physical retirement proof is manufactured.
+	 */
+	crucible_vm_area_observe(record, &output, true);
+}
+EXPORT_SYMBOL_GPL(crucible_allocator_vm_area_cleanup_complete);
