+/* Source-born origin records outlive native metadata and deferred callbacks.
+ * Returned cleanup is deliberately not physical retirement; records are never
+ * renewed or refunded. Original issuers must pin owner/code/Task/mm lifetime.
+ */
+#define CRUCIBLE_VM_AREA_RECORDS 256U
+
+enum crucible_vm_area_state {
+	CRUCIBLE_VM_AREA_RESERVED = 1,
+	CRUCIBLE_VM_AREA_BOUND,
+	CRUCIBLE_VM_AREA_DEFERRED,
+	CRUCIBLE_VM_AREA_CLOSING,
+	CRUCIBLE_VM_AREA_RETURNED,
+	CRUCIBLE_VM_AREA_REFUSED,
+};
+
+struct crucible_vm_area_origin {
+	void *original_owner;
+	const struct crucible_allocator_ops *original_ops;
+	void *original_lease;
+	struct vm_struct *original_area;
+	u64 generation;
+	u32 state;
+	struct crucible_vm_area_cleanup cleanup;
+};
+
+struct crucible_vm_area_bank {
+	struct crucible_vm_area_origin records[CRUCIBLE_VM_AREA_RECORDS];
+} __aligned(PAGE_SIZE);
