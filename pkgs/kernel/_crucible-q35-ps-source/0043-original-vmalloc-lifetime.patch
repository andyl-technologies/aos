+static struct kvm_crucible_resource_allocation *crucible_resource_vm_area_row(
+	struct kvm_crucible_kernel_resource_context *context, void *lease)
+{
+	u32 index;
+
+	lockdep_assert_held(&context->allocator_lock);
+	for (index = 0; index < context->allocations_used; index++)
+		if (lease == &context->allocations[index] &&
+		    context->allocations[index].family == CRUCIBLE_ALLOCATOR_VM_AREA)
+			return &context->allocations[index];
+	return NULL;
+}
+
+static bool crucible_resource_vm_area_reserve(void *owner,
+	const struct crucible_vm_area_request *request, void **lease)
+{
+	struct kvm_crucible_kernel_resource_context *context = owner;
+	struct kvm_crucible_resource_allocation *row;
+	unsigned long flags;
+	u64 reserved;
+	bool admitted = false;
+
+	*lease = NULL;
+	raw_spin_lock_irqsave(&context->allocator_lock, flags);
+	if (!crucible_resource_allocator_current(context) || context->uncertain ||
+	    context->allocations_used >= CRUCIBLE_RESOURCE_ALLOCATION_ROWS ||
+	    !request->metadata_bytes || request->rounded_metadata_bytes < request->metadata_bytes ||
+	    ktime_get_ns() > context->input.constructor_deadline_ns ||
+	    check_add_overflow(context->reserved_bytes, request->rounded_metadata_bytes, &reserved) ||
+	    reserved > context->input.reserved_ceiling || reserved > context->input.peak_ceiling ||
+	    request->rounded_metadata_bytes > context->input.transient_ceiling)
+		goto refuse;
+	row = &context->allocations[context->allocations_used++];
+	row->actor = current;
+	row->vm = context->original_vm;
+	row->generation = context->generation;
+	row->control_index = context->current_delivery;
+	row->family = CRUCIBLE_ALLOCATOR_VM_AREA;
+	row->vm_area_request = *request;
+	row->requested_bytes = request->metadata_bytes;
+	row->reserved_bytes = request->rounded_metadata_bytes;
+	row->source_reservation_known = true;
+	row->state = 4;
+	context->reserved_bytes = reserved;
+	*lease = row;
+	admitted = true;
+	goto unlock;
+refuse:
+	WRITE_ONCE(context->uncertain, true);
+unlock:
+	raw_spin_unlock_irqrestore(&context->allocator_lock, flags);
+	return admitted;
+}
+
+static void crucible_resource_vm_area_complete(void *owner, void *lease,
+	struct vm_struct *area, bool native_attempted)
+{
+	struct kvm_crucible_kernel_resource_context *context = owner;
+	struct kvm_crucible_resource_allocation *row;
+	unsigned long flags;
+
+	raw_spin_lock_irqsave(&context->allocator_lock, flags);
+	row = crucible_resource_vm_area_row(context, lease);
+	if (row && row->state == 4) {
+		/* Raw metadata return precedes source phase reconciliation. The
+		 * lease retains original module/Task/mm/context through cleanup.
+		 */
+		row->original_vm_area = area;
+		row->vm_area_native_attempted = native_attempted;
+		row->vm_area_returned = true;
+		row->state = 5;
+	}
+	/* Page arrays, mapping tables, retries and backing lifetime remain
+	 * incomplete. Keep every charge/reference, including a NULL return.
+	 */
+	WRITE_ONCE(context->uncertain, true);
+	raw_spin_unlock_irqrestore(&context->allocator_lock, flags);
+}
+
+static void crucible_resource_vm_area_observe(void *owner, void *lease,
+	const struct crucible_vm_area_cleanup *output, bool native_returned)
+{
+	struct kvm_crucible_kernel_resource_context *context = owner;
+	struct kvm_crucible_resource_allocation *row;
+	unsigned long flags;
+
+	raw_spin_lock_irqsave(&context->allocator_lock, flags);
+	row = crucible_resource_vm_area_row(context, lease);
+	if (row && row->vm_area_returned && row->original_vm_area == output->original_area) {
+		row->vm_area_cleanup = *output;
+		if (row->vm_area_observations != U32_MAX)
+			row->vm_area_observations++;
+		row->vm_area_cleanup_returned |= native_returned;
+	}
+	/* Worker identity is observation, never inherited allocation authority.
+	 * A native callback return is not cancellation/flush or retirement.
+	 */
+	WRITE_ONCE(context->uncertain, true);
+	raw_spin_unlock_irqrestore(&context->allocator_lock, flags);
+}
