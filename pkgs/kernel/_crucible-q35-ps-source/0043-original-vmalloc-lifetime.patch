+static struct crucible_vm_area_origin *
+crucible_vm_area_token_find(const struct crucible_vm_area_token *token)
+{
+	u32 index;
+
+	lockdep_assert_held(&crucible_vm_area_lock);
+	for (index = 0; index < crucible_vm_area_used; index++)
+		if (token->original_record == &crucible_vm_areas.records[index] &&
+		    token->generation == crucible_vm_areas.records[index].generation)
+			return &crucible_vm_areas.records[index];
+	return NULL;
+}
+
+static struct crucible_vm_area_origin *crucible_vm_area_find(struct vm_struct *area)
+{
+	u32 index;
+
+	lockdep_assert_held(&crucible_vm_area_lock);
+	if (!area)
+		return NULL;
+	for (index = 0; index < crucible_vm_area_used; index++) {
+		struct crucible_vm_area_origin *record = &crucible_vm_areas.records[index];
+
+		if (record->original_area == area &&
+		    (record->state == CRUCIBLE_VM_AREA_BOUND ||
+		     record->state == CRUCIBLE_VM_AREA_DEFERRED))
+			return record;
+	}
+	return NULL;
+}
+
+bool crucible_allocator_vm_area_reserve(const struct crucible_vm_area_request *request,
+	struct crucible_vm_area_token *token)
+{
+	struct crucible_allocator_scope *scope = READ_ONCE(current->crucible_allocator_scope);
+	struct crucible_vm_area_origin *record;
+	unsigned long flags;
+	void *lease = NULL;
+	bool reserved;
+
+	token->original_record = NULL;
+	token->generation = 0;
+	if (!scope || !in_task())
+		return true;
+	if (!request || !crucible_allocator_current(scope) ||
+	    !scope->original_ops->reserve_vm_area ||
+	    !scope->original_ops->complete_vm_area ||
+	    !scope->original_ops->observe_vm_area_cleanup)
+		goto refuse;
+	raw_spin_lock_irqsave(&crucible_vm_area_lock, flags);
+	if (crucible_vm_area_used == CRUCIBLE_VM_AREA_RECORDS ||
+	    crucible_vm_area_generation == U64_MAX) {
+		raw_spin_unlock_irqrestore(&crucible_vm_area_lock, flags);
+		goto refuse;
+	}
+	record = &crucible_vm_areas.records[crucible_vm_area_used++];
+	record->generation = ++crucible_vm_area_generation;
+	record->state = CRUCIBLE_VM_AREA_RESERVED;
+	raw_spin_unlock_irqrestore(&crucible_vm_area_lock, flags);
+
+	/* No issuer callback runs under the native bank/list/workqueue locks. */
+	WRITE_ONCE(scope->callback_active, true);
+	reserved = scope->original_ops->reserve_vm_area(scope->original_owner, request, &lease);
+	WRITE_ONCE(scope->callback_active, false);
+	raw_spin_lock_irqsave(&crucible_vm_area_lock, flags);
+	if (reserved && lease) {
+		record->original_owner = scope->original_owner;
+		record->original_ops = scope->original_ops;
+		record->original_lease = lease;
+		token->original_record = record;
+		token->generation = record->generation;
+	} else {
+		record->state = CRUCIBLE_VM_AREA_REFUSED;
+	}
+	raw_spin_unlock_irqrestore(&crucible_vm_area_lock, flags);
+	if (!reserved || !lease || !crucible_allocator_current(scope))
+		goto refuse;
+	return true;
+
+refuse:
+	WRITE_ONCE(scope->failed, true);
+	return false;
+}
+EXPORT_SYMBOL_GPL(crucible_allocator_vm_area_reserve);
+
+void crucible_allocator_vm_area_complete(struct crucible_vm_area_token *token,
+	struct vm_struct *area, bool native_attempted)
+{
+	struct crucible_vm_area_origin *record;
+	unsigned long flags;
+
+	if (!token->original_record)
+		return;
+	raw_spin_lock_irqsave(&crucible_vm_area_lock, flags);
+	record = crucible_vm_area_token_find(token);
+	if (!record || record->state != CRUCIBLE_VM_AREA_RESERVED) {
+		raw_spin_unlock_irqrestore(&crucible_vm_area_lock, flags);
+		return;
+	}
+	/* Preserve the actual metadata allocation return before source checks. */
+	record->original_area = area;
+	record->state = CRUCIBLE_VM_AREA_BOUND;
+	raw_spin_unlock_irqrestore(&crucible_vm_area_lock, flags);
+	token->original_record = NULL;
+	record->original_ops->complete_vm_area(record->original_owner,
+		record->original_lease, area, native_attempted);
+}
+EXPORT_SYMBOL_GPL(crucible_allocator_vm_area_complete);
