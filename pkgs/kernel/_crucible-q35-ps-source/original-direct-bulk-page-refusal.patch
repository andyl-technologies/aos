 EXPORT_SYMBOL_GPL(crucible_allocator_uncovered);
+
+/* Snapshot only for an enrolled original Task. The ordinary/interrupt inverse
+ * does not inspect an otherwise unused nodemask. This retains a refusal input;
+ * no page-array ownership or complete page-allocation coverage is issued. */
+bool crucible_allocator_page_uncovered(gfp_t flags, unsigned int order,
+	int native_node, const nodemask_t *nodemask, unsigned long requested_pages,
+	unsigned long populated_pages, bool bulk)
+{
+	struct crucible_allocator_scope *scope;
+	struct crucible_uncovered_request request = { };
+	u64 pages = requested_pages;
+
+	scope = READ_ONCE(current->crucible_allocator_scope);
+	if (!scope || !in_task())
+		return true;
+	if (!crucible_allocator_actor(scope) || READ_ONCE(scope->callback_active)) {
+		WRITE_ONCE(scope->failed, true);
+		return false;
+	}
+
+	if (!bulk)
+		pages = order < 64 ? 1ULL << order : 0;
+	request.requested_objects = pages;
+	if (pages <= U64_MAX / PAGE_SIZE)
+		request.requested_bytes = pages * PAGE_SIZE;
+	request.family = bulk ? CRUCIBLE_ALLOCATOR_PAGE_BULK : CRUCIBLE_ALLOCATOR_PAGE;
+	request.allocation_flags = flags;
+	request.native_node = native_node;
+	request.page_order = order;
+	request.page_populated = populated_pages;
+	request.has_nodemask = nodemask != NULL;
+	if (nodemask)
+		request.node_mask = *nodemask;
+
+	return crucible_allocator_uncovered(&request);
+}
+EXPORT_SYMBOL_GPL(crucible_allocator_page_uncovered);
