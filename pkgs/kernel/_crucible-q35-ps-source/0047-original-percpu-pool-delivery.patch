+static bool crucible_resource_percpu_reserve(void *owner,
+	const struct crucible_percpu_request *request,
+	const struct crucible_percpu_pool_shape *shape, void **lease)
+{
+	struct kvm_crucible_kernel_resource_context *context = owner;
+	struct kvm_crucible_resource_allocation *row;
+	struct crucible_percpu_pool_shape actual;
+	struct kvm_crucible_kernel_resource_policy prefix;
+	unsigned long flags;
+	u64 reserved;
+	bool admitted = false;
+
+	*lease = NULL;
+	if (!crucible_allocator_percpu_pool_shape(&actual) ||
+	    memcmp(&actual, shape, sizeof(actual)) ||
+	    crucible_resource_quote(&context->input, &prefix))
+		return false;
+	raw_spin_lock_irqsave(&context->allocator_lock, flags);
+	if (!crucible_resource_allocator_current(context) || context->uncertain ||
+	    context->allocations_used == CRUCIBLE_RESOURCE_ALLOCATION_ROWS ||
+	    ktime_get_ns() > context->input.constructor_deadline_ns)
+		goto refuse;
+	reserved = context->reserved_bytes;
+	if (context->percpu_pool_reserved) {
+		if (memcmp(&context->original_percpu_pool, &actual, sizeof(actual)))
+			goto refuse;
+	} else if (check_add_overflow(reserved, actual.physical_peak_bound, &reserved)) {
+		goto refuse;
+	}
+	/* The counter already retains the charged metadata and other families.
+	 * Reserve the whole arena/mapping bound once, without logical refunds.
+	 */
+	if (reserved > context->input.resident_ceiling ||
+	    reserved > context->input.peak_ceiling ||
+	    reserved > context->input.reserved_ceiling)
+		goto refuse;
+	context->original_percpu_pool = actual;
+	context->percpu_pool_reserved = true;
+	context->reserved_bytes = reserved;
+	row = &context->allocations[context->allocations_used++];
+	row->actor = current;
+	row->vm = context->original_vm;
+	row->generation = context->generation;
+	row->control_index = context->current_delivery;
+	row->family = CRUCIBLE_ALLOCATOR_PERCPU_POOL;
+	row->percpu_request = *request;
+	row->requested_bytes = request->requested_bytes;
+	row->percpu_physical_reserved = true;
+	row->source_reservation_known = true;
+	row->state = 6;
+	*lease = row;
+	admitted = true;
+	goto unlock;
+refuse:
+	WRITE_ONCE(context->uncertain, true);
+unlock:
+	raw_spin_unlock_irqrestore(&context->allocator_lock, flags);
+	return admitted;
+}
+
+static void crucible_resource_percpu_complete(void *owner, void *lease,
+	const struct crucible_percpu_output *output)
+{
+	struct kvm_crucible_kernel_resource_context *context = owner;
+	struct kvm_crucible_resource_allocation *row;
+	unsigned long flags;
+
+	raw_spin_lock_irqsave(&context->allocator_lock, flags);
+	row = crucible_resource_percpu_row(context, lease);
+	if (row && !row->percpu_completed) {
+		row->percpu_output = *output;
+		row->percpu_original_output = output;
+		row->percpu_completed = true;
+		row->native_attempted = output->native_attempted;
+		row->native_known = output->native_returned && output->source_current;
+		row->state = 7;
+	}
+	if (!row || !output->native_returned || !output->source_current)
+		WRITE_ONCE(context->uncertain, true);
+	raw_spin_unlock_irqrestore(&context->allocator_lock, flags);
