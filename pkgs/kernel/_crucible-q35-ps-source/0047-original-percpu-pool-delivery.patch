+/* SPDX-License-Identifier: GPL-2.0-only */
+/* A selected constructor never borrows the dynamic per-CPU allocator's
+ * shared chunks or global balance queue. Boot-born static storage stays held.
+ */
+
+#define CRUCIBLE_PERCPU_ARENA_BYTES (64U * 1024U)
+#define CRUCIBLE_PERCPU_LEASES 256U
+
+struct crucible_percpu_arena {
+	u8 data[CRUCIBLE_PERCPU_ARENA_BYTES];
+};
+
+static DEFINE_PER_CPU_PAGE_ALIGNED(struct crucible_percpu_arena,
+	crucible_percpu_storage);
+
+enum crucible_percpu_state {
+	CRUCIBLE_PERCPU_RESERVED = 1,
+	CRUCIBLE_PERCPU_LIVE,
+	CRUCIBLE_PERCPU_CLOSING,
+	CRUCIBLE_PERCPU_RELEASED,
+	CRUCIBLE_PERCPU_REFUSED,
+};
+
+struct crucible_percpu_lease {
+	void *original_owner;
+	const struct crucible_allocator_ops *original_ops;
+	void *original_lease;
+	struct crucible_percpu_request request;
+	struct crucible_percpu_output output;
+	u32 state;
+};
+
+struct crucible_percpu_birth {
+	void *original_base;
+	const unsigned long *original_offsets;
+	u64 original_unit_bytes;
+	u64 original_static_bytes;
+	u64 original_arena_offset;
+	u32 original_cpu_ids;
+	cpumask_t original_possible;
+	void *native_arenas[NR_CPUS];
+	bool attempted;
+	bool complete;
+	bool failed;
+};
+
+struct crucible_percpu_bank {
+	struct crucible_percpu_birth birth;
+	struct crucible_percpu_lease leases[CRUCIBLE_PERCPU_LEASES];
+	u64 generation;
+	u64 cursor;
+	u32 used;
+} __aligned(PAGE_SIZE);
+
+static struct crucible_percpu_bank crucible_percpu_pool;
+static DEFINE_RAW_SPINLOCK(crucible_percpu_pool_lock);
+
+u64 crucible_allocator_percpu_pool_metadata_bytes(void)
+{
+	return sizeof(crucible_percpu_pool);
+}
+EXPORT_SYMBOL_GPL(crucible_allocator_percpu_pool_metadata_bytes);
+
+bool crucible_allocator_percpu_output_snapshot(void *owner, void *lease,
+	const struct crucible_percpu_output *original_output, u64 lease_generation,
+	struct crucible_percpu_output *snapshot)
+{
+	unsigned long flags;
+	u32 index;
+	bool matched = false;
+
+	raw_spin_lock_irqsave(&crucible_percpu_pool_lock, flags);
+	for (index = 0; index < crucible_percpu_pool.used; index++) {
+		const struct crucible_percpu_lease *candidate = &crucible_percpu_pool.leases[index];
+
+		/* Compare source membership before following the supplied address. */
+		if (original_output != &candidate->output ||
+		    owner != candidate->original_owner || lease != candidate->original_lease ||
+		    lease_generation != candidate->output.lease_generation)
+			continue;
+		*snapshot = candidate->output;
+		matched = true;
+		break;
+	}
+	raw_spin_unlock_irqrestore(&crucible_percpu_pool_lock, flags);
+	return matched;
+}
+EXPORT_SYMBOL_GPL(crucible_allocator_percpu_output_snapshot);
+
+static void __init crucible_percpu_pool_birth(const struct pcpu_alloc_info *ai,
+	void *base_addr)
+{
+	struct crucible_percpu_birth *birth = &crucible_percpu_pool.birth;
+	unsigned long offset = (unsigned long)&crucible_percpu_storage -
+		(unsigned long)__per_cpu_start;
+	unsigned int cpu;
+
+	if (birth->attempted) {
+		birth->failed = true;
+		return;
+	}
+	birth->attempted = true;
+	if (!base_addr || base_addr != pcpu_base_addr || !pcpu_unit_offsets ||
+	    !nr_cpu_ids || nr_cpu_ids > NR_CPUS || offset_in_page(offset) ||
+	    offset > ai->static_size ||
+	    sizeof(crucible_percpu_storage) > ai->static_size - offset ||
+	    ai->unit_size != pcpu_unit_size || !pcpu_first_chunk ||
+	    !pcpu_first_chunk->immutable) {
+		birth->failed = true;
+		return;
+	}
+	/* Copy constructor facts now; ai and its initialization lifetime are not
+	 * followed later. The static region is outside dynamic allocation maps.
+	 */
+	birth->original_base = base_addr;
+	birth->original_offsets = pcpu_unit_offsets;
+	birth->original_unit_bytes = ai->unit_size;
+	birth->original_static_bytes = ai->static_size;
+	birth->original_arena_offset = offset;
+	birth->original_cpu_ids = nr_cpu_ids;
+	cpumask_copy(&birth->original_possible, cpu_possible_mask);
+	for_each_cpu(cpu, &birth->original_possible)
+		birth->native_arenas[cpu] = base_addr + pcpu_unit_offsets[cpu] + offset;
+	birth->complete = true;
+}
+
+static bool crucible_percpu_pool_current(void)
+{
+	const struct crucible_percpu_birth *birth = &crucible_percpu_pool.birth;
+	unsigned int cpu;
+
+	if (!birth->complete || birth->failed ||
+	    birth->original_base != pcpu_base_addr ||
+	    birth->original_offsets != pcpu_unit_offsets ||
+	    birth->original_unit_bytes != pcpu_unit_size ||
+	    birth->original_cpu_ids != nr_cpu_ids ||
+	    !cpumask_equal(&birth->original_possible, cpu_possible_mask))
+		return false;
+	for_each_cpu(cpu, &birth->original_possible)
+		if (birth->native_arenas[cpu] != per_cpu_ptr(&crucible_percpu_storage, cpu))
+			return false;
+	return true;
+}
+
+bool crucible_allocator_percpu_pool_shape(struct crucible_percpu_pool_shape *shape)
+{
+	u64 data, mappings, resident;
+
+	memset(shape, 0, sizeof(*shape));
+	/* These sanitizer profiles need their own literal shadow/origin backing
+	 * issuer. Do not infer one from the logical static arena's byte count.
+	 */
+	if (IS_ENABLED(CONFIG_KASAN) || IS_ENABLED(CONFIG_KMSAN) ||
+	    !crucible_percpu_pool_current())
+		return false;
+	/* Include the original linker template and every CPU ID conservatively.
+	 * Bound both the direct-map and per-CPU aliases by a private page-table
+	 * page at every hardware level for every data page. Mapping sharing is
+	 * overcharged rather than inferred from final-pointer addition.
+	 * Runtime pool operations allocate no pages, tables, shadow or scratch.
+	 */
+	if (check_mul_overflow((u64)sizeof(crucible_percpu_storage),
+	    (u64)nr_cpu_ids + 1, &data) ||
+	    check_mul_overflow(data, 2ULL * CONFIG_PGTABLE_LEVELS, &mappings) ||
+	    check_add_overflow(data, mappings, &resident) ||
+	    check_add_overflow(resident, (u64)sizeof(crucible_percpu_pool), &resident))
+		return false;
+	shape->generation = 1;
+	shape->original_issuer = &crucible_percpu_pool.birth;
+	shape->original_storage = &crucible_percpu_storage;
+	shape->original_offsets = crucible_percpu_pool.birth.original_offsets;
+	shape->arena_bytes = sizeof(crucible_percpu_storage);
+	shape->metadata_bytes = sizeof(crucible_percpu_pool);
+	shape->physical_resident_bound = resident;
+	shape->physical_peak_bound = resident;
+	shape->cpu_ids = nr_cpu_ids;
+	shape->slot_limit = CRUCIBLE_PERCPU_LEASES;
+	return true;
+}
+EXPORT_SYMBOL_GPL(crucible_allocator_percpu_pool_shape);
+
+static bool crucible_percpu_scope_current(struct crucible_allocator_scope *scope)
+{
+	bool currentness;
+
+	if (!scope || !in_task() || scope->original_task != current ||
+	    scope->failed || scope->callback_active || scope->cleanup_observer ||
+	    !scope->original_owner || !scope->original_ops ||
+	    !scope->original_ops->source_current ||
+	    !scope->original_ops->reserve_percpu_pool ||
+	    !scope->original_ops->percpu_pool_current ||
+	    !scope->original_ops->complete_percpu_pool ||
+	    !scope->original_ops->observe_percpu_transition)
+		return false;
+	WRITE_ONCE(scope->callback_active, true);
+	currentness = scope->original_ops->source_current(scope->original_owner) &&
+		scope->original_ops->percpu_pool_current(scope->original_owner);
+	WRITE_ONCE(scope->callback_active, false);
+	return currentness && !READ_ONCE(scope->failed);
+}
+
+static bool crucible_percpu_scope_selected(struct crucible_allocator_scope *scope)
+{
+	return scope && (in_task() ||
+		(scope->original_task == current && scope->cleanup_observer));
+}
+
+static void __percpu *crucible_percpu_pool_allocate(size_t size, size_t align,
+	bool reserved, gfp_t gfp, bool *handled)
+{
+	struct crucible_allocator_scope *scope = READ_ONCE(current->crucible_allocator_scope);
+	struct crucible_percpu_pool_shape shape;
+	struct crucible_percpu_request request = {
+		.requested_bytes = size,
+		.requested_alignment = align,
+		.allocation_flags = gfp,
+		.reserved = reserved,
+	};
+	struct crucible_percpu_lease *lease;
+	void *original_lease = NULL;
+	unsigned long flags;
+	u64 offset, end, lease_generation, delivery_generation;
+	void __percpu *original_pointer;
+	void *original_owner;
+	const struct crucible_allocator_ops *original_ops;
+	unsigned int cpu;
+	bool admitted;
+
+	*handled = crucible_percpu_scope_selected(scope);
+	if (!*handled)
+		return NULL;
+	request.aligned_bytes = ALIGN(size, PCPU_MIN_ALLOC_SIZE);
+	request.effective_alignment = max_t(size_t, align, PCPU_MIN_ALLOC_SIZE);
+	/* Selected kernel/SRCU constructors use the unaccounted ordinary region.
+	 * Every other raw GFP profile and reserved inputs cannot fall back to shared
+	 * chunks or queue a global worker outside their physical reservation.
+	 */
+	if (!crucible_percpu_scope_current(scope) || reserved ||
+	    gfp != GFP_KERNEL ||
+	    !request.aligned_bytes || request.aligned_bytes < size ||
+	    request.aligned_bytes > PCPU_MIN_UNIT_SIZE ||
+	    request.effective_alignment > PAGE_SIZE ||
+	    !is_power_of_2(request.effective_alignment) ||
+	    !crucible_allocator_percpu_pool_shape(&shape))
+		goto refuse;
+
+	raw_spin_lock_irqsave(&crucible_percpu_pool_lock, flags);
+	offset = ALIGN(crucible_percpu_pool.cursor, request.effective_alignment);
+	if (crucible_percpu_pool.used == CRUCIBLE_PERCPU_LEASES ||
+	    crucible_percpu_pool.generation == U64_MAX ||
+	    check_add_overflow(offset, request.aligned_bytes, &end) ||
+	    end > sizeof(crucible_percpu_storage)) {
+		raw_spin_unlock_irqrestore(&crucible_percpu_pool_lock, flags);
+		goto refuse;
+	}
+	lease = &crucible_percpu_pool.leases[crucible_percpu_pool.used++];
+	lease->state = CRUCIBLE_PERCPU_RESERVED;
+	lease->original_owner = scope->original_owner;
+	lease->original_ops = scope->original_ops;
+	lease->request = request;
+	lease->output.pool_generation = shape.generation;
+	lease->output.lease_generation = ++crucible_percpu_pool.generation;
+	lease->output.native_offset = offset;
+	lease->output.native_bytes = request.aligned_bytes;
+	lease->output.original_cpu_ids = shape.cpu_ids;
+	crucible_percpu_pool.cursor = end;
+	raw_spin_unlock_irqrestore(&crucible_percpu_pool_lock, flags);
+
+	WRITE_ONCE(scope->callback_active, true);
+	admitted = lease->original_ops->reserve_percpu_pool(lease->original_owner,
+		&request, &shape, &original_lease);
+	WRITE_ONCE(scope->callback_active, false);
+	lease->original_lease = original_lease;
+	if (!admitted || !original_lease || !crucible_percpu_scope_current(scope)) {
+		lease->state = CRUCIBLE_PERCPU_REFUSED;
+		goto complete;
+	}
+	/* The retained native addresses come from the literal boot constructor,
+	 * not a mutable possible-CPU walk after eligibility checking.
+	 */
+	lease->output.native_attempted = true;
+	for_each_cpu(cpu, &crucible_percpu_pool.birth.original_possible) {
+		memset(crucible_percpu_pool.birth.native_arenas[cpu] + offset,
+			0, request.aligned_bytes);
+		lease->output.cleared_cpu_count++;
+	}
+	lease->output.original_pointer = (void __percpu *)&crucible_percpu_storage + offset;
+	lease->output.native_returned = true;
+	lease->output.source_current = crucible_percpu_pool_current() &&
+		crucible_percpu_scope_current(scope);
+	raw_spin_lock_irqsave(&crucible_percpu_pool_lock, flags);
+	lease->state = CRUCIBLE_PERCPU_LIVE;
+	raw_spin_unlock_irqrestore(&crucible_percpu_pool_lock, flags);
+complete:
+	WRITE_ONCE(scope->callback_active, true);
+	lease->original_ops->complete_percpu_pool(lease->original_owner,
+		lease->original_lease, &lease->output);
+	WRITE_ONCE(scope->callback_active, false);
+	/* The native result has already reached its original receiver. The final
+	 * observer sees an attempted delivery, never a speculative delivered bit.
+	 * The permanent source row owns the result after that callback returns.
+	 */
+	original_owner = lease->original_owner;
+	original_ops = lease->original_ops;
+	original_pointer = lease->output.original_pointer;
+	lease_generation = lease->output.lease_generation;
+	raw_spin_lock_irqsave(&crucible_percpu_pool_lock, flags);
+	delivery_generation = ++lease->output.delivery_generation;
+	lease->output.delivery_attempted = true;
+	raw_spin_unlock_irqrestore(&crucible_percpu_pool_lock, flags);
+	WRITE_ONCE(scope->callback_active, true);
+	original_ops->observe_percpu_transition(original_owner,
+		lease->original_lease, &lease->output);
+	WRITE_ONCE(scope->callback_active, false);
+
+	/* All callback effects precede this cut. A consumed lease, replaced Task
+	 * scope, closed issuer or elapsed original deadline cannot supply delivery.
+	 * No second observer, native attempt, offset reuse or refund is issued.
+	 */
+	admitted = READ_ONCE(current->crucible_allocator_scope) == scope &&
+		scope->original_owner == original_owner && scope->original_ops == original_ops &&
+		lease->output.source_current && crucible_percpu_pool_current() &&
+		crucible_percpu_scope_current(scope);
+	raw_spin_lock_irqsave(&crucible_percpu_pool_lock, flags);
+	admitted = admitted && READ_ONCE(current->crucible_allocator_scope) == scope &&
+		in_task() && scope->original_task == current && !scope->cleanup_observer &&
+		!READ_ONCE(scope->failed) && !READ_ONCE(scope->callback_active) &&
+		scope->original_owner == original_owner && scope->original_ops == original_ops &&
+		lease->state == CRUCIBLE_PERCPU_LIVE &&
+		lease->original_owner == original_owner && lease->original_ops == original_ops &&
+		lease->output.original_pointer == original_pointer &&
+		lease->output.lease_generation == lease_generation &&
+		lease->output.delivery_generation == delivery_generation &&
+		!lease->output.delivery_completed;
+	lease->output.delivered = admitted;
+	lease->output.delivery_completed = true;
+	raw_spin_unlock_irqrestore(&crucible_percpu_pool_lock, flags);
+	if (admitted)
+		return original_pointer;
+refuse:
+	WRITE_ONCE(scope->failed, true);
+	return NULL;
+}
+
+static bool crucible_percpu_pool_release(void __percpu *pointer)
+{
+	struct crucible_allocator_scope *saved;
+	struct crucible_allocator_scope observer;
+	struct crucible_percpu_lease *lease = NULL;
+	struct crucible_percpu_output output;
+	unsigned long flags;
+	u32 index;
+
+	raw_spin_lock_irqsave(&crucible_percpu_pool_lock, flags);
+	for (index = 0; index < crucible_percpu_pool.used; index++) {
+		struct crucible_percpu_lease *candidate = &crucible_percpu_pool.leases[index];
+
+		if (pointer == candidate->output.original_pointer && pointer) {
+			lease = candidate;
+			break;
+		}
+	}
+	if (!lease) {
+		bool inside = (unsigned long)pointer >= (unsigned long)&crucible_percpu_storage &&
+			(unsigned long)pointer < (unsigned long)&crucible_percpu_storage +
+			sizeof(crucible_percpu_storage);
+
+		raw_spin_unlock_irqrestore(&crucible_percpu_pool_lock, flags);
+		return inside;
+	}
+	if (lease->state != CRUCIBLE_PERCPU_LIVE) {
+		raw_spin_unlock_irqrestore(&crucible_percpu_pool_lock, flags);
+		return true;
+	}
+	/* Source membership precedes every owner/callback follow. Closing is
+	 * visible before logical release; the static backing is never freed,
+	 * reused or sent to the dynamic bitmap/global balance queue.
+	 */
+	lease->state = CRUCIBLE_PERCPU_CLOSING;
+	lease->output.closing = true;
+	lease->output.source_current = crucible_percpu_pool_current();
+	output = lease->output;
+	raw_spin_unlock_irqrestore(&crucible_percpu_pool_lock, flags);
+	saved = READ_ONCE(current->crucible_allocator_scope);
+	observer = (struct crucible_allocator_scope) {
+		.original_task = current,
+		.original_owner = lease->original_owner,
+		.original_ops = lease->original_ops,
+		.callback_active = true,
+		.cleanup_observer = true,
+	};
+	WRITE_ONCE(current->crucible_allocator_scope, &observer);
+	lease->original_ops->observe_percpu_transition(lease->original_owner,
+		lease->original_lease, &output);
+	raw_spin_lock_irqsave(&crucible_percpu_pool_lock, flags);
+	lease->state = CRUCIBLE_PERCPU_RELEASED;
+	lease->output.logical_released = true;
+	output = lease->output;
+	raw_spin_unlock_irqrestore(&crucible_percpu_pool_lock, flags);
+	lease->original_ops->observe_percpu_transition(lease->original_owner,
+		lease->original_lease, &output);
+	WRITE_ONCE(current->crucible_allocator_scope, saved);
+	return true;
+}
+
+static bool crucible_percpu_pool_shared_balance_refuse(void)
+{
+	struct crucible_allocator_scope *scope = READ_ONCE(current->crucible_allocator_scope);
+
+	if (!crucible_percpu_scope_selected(scope))
+		return false;
+	/* Dedicated-source operations never own this global worker. A selected
+	 * legacy escape cannot enqueue unreserved backing effects. Ordinary
+	 * queue/receiver/reclaim behavior remains entirely with its native owner.
+	 */
+	WRITE_ONCE(scope->failed, true);
+	return true;
+}
