+static struct kvm_crucible_resource_allocation *crucible_resource_percpu_row(
+	struct kvm_crucible_kernel_resource_context *context, void *lease)
+{
+	u32 index;
+
+	lockdep_assert_held(&context->allocator_lock);
+	for (index = 0; index < context->allocations_used; index++)
+		if (lease == &context->allocations[index] &&
+		    context->allocations[index].family == CRUCIBLE_ALLOCATOR_PERCPU_POOL)
+			return &context->allocations[index];
+	return NULL;
+}
