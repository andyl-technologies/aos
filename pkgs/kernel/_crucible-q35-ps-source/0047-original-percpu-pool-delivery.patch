+static bool crucible_resource_percpu_current(void *owner)
+{
+	struct kvm_crucible_kernel_resource_context *context = owner;
+
+	struct crucible_percpu_output output;
+	u32 index;
+
+	if (!crucible_resource_allocator_current(context) || READ_ONCE(context->uncertain) ||
+	    ktime_get_ns() > context->input.constructor_deadline_ns)
+		return false;
+	/* Raw completion retains the original permanent pool row. Its readonly
+	 * source lookup supplies the post-observer result without another callback.
+	 * A copied pre-delivery snapshot is never treated as a final delivery claim.
+	 */
+	for (index = 0; index < READ_ONCE(context->allocations_used); index++) {
+		struct kvm_crucible_resource_allocation *row = &context->allocations[index];
+
+		if (row->family != CRUCIBLE_ALLOCATOR_PERCPU_POOL || !row->percpu_completed)
+			continue;
+		if (!crucible_allocator_percpu_output_snapshot(context, row,
+		    row->percpu_original_output, row->percpu_output.lease_generation, &output) ||
+		    (output.delivery_completed && !output.delivered)) {
+			WRITE_ONCE(context->uncertain, true);
+			return false;
+		}
+	}
+	return true;
+}
