+	    (output->delivery_completed && !output->delivered))
+		WRITE_ONCE(context->uncertain, true);
+	/* Logical release never discharges the original physical pool charge or
+	 * the issuer's module/Task/mm references. No backing retirement is issued.
+	 */
+	raw_spin_unlock_irqrestore(&context->allocator_lock, flags);
+}
