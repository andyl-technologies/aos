+/* Root custody is established at the native constructor, never by a quote
+ * or a userspace pointer. Public before-CREATE still refuses every selected
+ * context: no complete-family continuation issues create_native_entered yet.
+ */
+static struct kvm *kvm_crucible_resource_alloc_vm(struct file *file,
+	unsigned long type, int *source_result)
+{
+	struct kvm_crucible_kernel_resource_context *context;
+	struct kvm *kvm;
+	bool scope_entered, scope_known;
+	size_t extent;
+	u64 request_reservation, reserved;
+
+	*source_result = 0;
+	mutex_lock(&crucible_resource_lock);
+	context = crucible_resource_find(file);
+	if (!context) {
+		mutex_unlock(&crucible_resource_lock);
+		return kvm_arch_alloc_vm();
+	}
+	if (!crucible_resource_actor(context, file) || !context->prepared ||
+	    context->uncertain || !context->create_native_entered ||
+	    context->create_actor != current || context->create_operand != type ||
+	    context->root_attempted || current->crucible_allocator_scope ||
+	    ktime_get_ns() > context->input.constructor_deadline_ns) {
+		context->uncertain = true;
+		mutex_unlock(&crucible_resource_lock);
+		*source_result = -EPERM;
+		return NULL;
+	}
+#ifndef CONFIG_X86_64
+	context->uncertain = true;
+	mutex_unlock(&crucible_resource_lock);
+	*source_result = -EOPNOTSUPP;
+	return NULL;
+#else
+	extent = READ_ONCE(kvm_x86_ops.vm_size);
+	if (extent < sizeof(struct kvm)) {
+		context->uncertain = true;
+		mutex_unlock(&crucible_resource_lock);
+		*source_result = -EINVAL;
+		return NULL;
+	}
+	/* Retain the actual request reservation before any native allocation.
+	 * This overlaps later leaf reservations deliberately: it is a ceiling
+	 * check, not a claim about resident pages, internal retries or slack.
+	 */
+	request_reservation = kmalloc_size_roundup(extent);
+	if (!request_reservation ||
+	    check_add_overflow(context->reserved_bytes, request_reservation, &reserved) ||
+	    reserved > context->input.reserved_ceiling ||
+	    reserved > context->input.peak_ceiling ||
+	    request_reservation > context->input.transient_ceiling) {
+		context->uncertain = true;
+		mutex_unlock(&crucible_resource_lock);
+		*source_result = -E2BIG;
+		return NULL;
+	}
+	context->root_request_reservation = request_reservation;
+	context->reserved_bytes = reserved;
+	context->root_actor = current;
+	context->root_generation = context->generation;
+	context->root_requested_bytes = extent;
+	context->root_allocation_flags = GFP_KERNEL_ACCOUNT;
+	context->root_scope.original_task = current;
+	context->root_scope.original_owner = context;
+	context->root_scope.original_ops = &crucible_resource_allocator_ops;
+	context->current_delivery = ARRAY_SIZE(context->delivery_scopes);
+	context->root_attempted = true;
+	WRITE_ONCE(context->root_scope_active, true);
+	mutex_unlock(&crucible_resource_lock);
