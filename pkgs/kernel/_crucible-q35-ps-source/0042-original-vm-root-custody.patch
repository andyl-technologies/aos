+	 * Binding lives in the actual zeroed root, not an address-only lookup.
+	 */
+	context->original_vm = kvm;
+	context->root_returned = true;
+	/* Internal retries, vmalloc fallback, shared backing and retirement are
+	 * still incomplete even when the immediate native return is non-NULL.
+	 */
+	WRITE_ONCE(context->uncertain, true);
+	if (kvm)
+		kvm->crucible_resource_context = context;
+	scope_known = crucible_allocator_leave(&context->root_scope);
+	WRITE_ONCE(context->root_scope_active, false);
+	if (!scope_known || context->uncertain || context->root_actor != current ||
+	    context->root_generation != context->generation) {
+		WRITE_ONCE(context->uncertain, true);
+		*source_result = -EIO;
+	}
+	if (!kvm) {
+		/* The literal constructor returns source_result for this NULL
+		 * root. Retain that return in its original context, without a VM
+		 * owner field or a fabricated successful allocation identity.
+		 */
+		context->root_constructor_result = *source_result;
+		context->root_constructor_completed = true;
+	}
+	return kvm;
+#endif
+}
+
+/* Only source-born live root records identify a journal owner. Never follow
+ * the candidate pointer stored in a VM; it may be cleared or substituted.
+ * Closing is published before native free, excluding any address reuse while
+ * the destructor's retained context token awaits its return observation.
+ */
+static struct kvm_crucible_kernel_resource_context *
+crucible_resource_root_find(struct kvm *kvm)
+{
+	struct kvm_crucible_kernel_resource_context *context = NULL;
+	u32 index;
+
+	lockdep_assert_held(&crucible_resource_lock);
+	for (index = 0; index < CRUCIBLE_RESOURCE_CONTEXTS; index++) {
+		struct kvm_crucible_kernel_resource_context *candidate =
+			&crucible_resource_contexts[index];
+
+		if (!candidate->root_attempted || !candidate->root_returned ||
+		    candidate->original_vm != kvm || candidate->root_free_attempted)
+			continue;
+		if (context) {
+			WRITE_ONCE(context->uncertain, true);
+			WRITE_ONCE(candidate->uncertain, true);
+			return NULL;
+		}
+		context = candidate;
+	}
+	return context;
+}
+
+static void kvm_crucible_resource_constructor_complete(struct kvm *kvm, int result)
+{
+	struct kvm_crucible_kernel_resource_context *context;
+	unsigned long flags;
+
+	mutex_lock(&crucible_resource_lock);
+	context = crucible_resource_root_find(kvm);
+	if (!context)
+		goto unlock_registry;
+	raw_spin_lock_irqsave(&context->allocator_lock, flags);
+	/* Membership and the original root-return tuple precede both candidate
+	 * pointer observation and journal mutation. A substituted owner cannot
+	 * redirect the actual constructor return to another retained bank.
+	 */
+	if (kvm->crucible_resource_context != context)
+		WRITE_ONCE(context->uncertain, true);
+	if (context->root_constructor_completed) {
+		WRITE_ONCE(context->uncertain, true);
+		goto unlock_allocator;
+	}
+	context->root_constructor_result = result;
+	context->root_constructor_completed = true;
+	if (context->root_actor != current ||
+	    context->root_generation != context->generation || context->closed)
+		WRITE_ONCE(context->uncertain, true);
+unlock_allocator:
+	raw_spin_unlock_irqrestore(&context->allocator_lock, flags);
+unlock_registry:
+	mutex_unlock(&crucible_resource_lock);
+}
+
+static void kvm_crucible_resource_free_vm(struct kvm *kvm)
+{
+	struct kvm_crucible_kernel_resource_context *context;
+	unsigned long flags;
+
+	mutex_lock(&crucible_resource_lock);
+	context = crucible_resource_root_find(kvm);
+	if (context) {
+		raw_spin_lock_irqsave(&context->allocator_lock, flags);
+		/* The source-born root, not its candidate owner field, retains the
+		 * cleanup token. Clearing that field cannot bypass this journal.
+		 * Unknown cleanup still runs; no physical credit is refunded.
+		 */
+		WRITE_ONCE(context->root_free_attempted, true);
+		WRITE_ONCE(context->uncertain, true);
+		raw_spin_unlock_irqrestore(&context->allocator_lock, flags);
+	}
+	mutex_unlock(&crucible_resource_lock);
+	kvm_arch_free_vm(kvm);
+	/* Never dereference the freed root. This is only the void native
+	 * destructor's return; deferred/shared backing retirement is unproved.
+	 */
+	if (context) {
+		raw_spin_lock_irqsave(&context->allocator_lock, flags);
+		WRITE_ONCE(context->root_free_returned, true);
+		raw_spin_unlock_irqrestore(&context->allocator_lock, flags);
+	}
+}
 
