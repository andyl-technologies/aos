+/* PS callers keep the complete unsigned coordinate, including sub-ns values.
+ * A result of zero retains a future/boundary expiry; negative results refuse
+ * this projection. No timer owner or native queue changes in this reader.
+ */
+int kvm_crucible_q35_ps_timer_host(struct kvm *kvm, u64 logical_ps, ktime_t *host)
+{
+	unsigned long flags;
+	int result;
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	result = q35_ps_timer_host_locked(kvm, logical_ps, host, ktime_get_ns());
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	return result;
+}
+EXPORT_SYMBOL_FOR_KVM_INTERNAL(kvm_crucible_q35_ps_timer_host);
