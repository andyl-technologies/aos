+
+/* Timer projection observes the installed source domain; it does not create
+ * an arm, callback ancestry or output permission. The original timer caller
+ * retains those separately through actual native queue publication.
+ */
+static bool q35_ps_timer_window_current_locked(struct kvm *kvm, u64 now_ns)
+{
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	struct kvm_crucible_ps_clock_state *ps = &clock->ps;
+	u64 slice = ps->plan.physical_slice_ns;
+
+	lockdep_assert_held(&kvm->crucible_gate_lock);
+	return ps->selected && ps->plan.version == 2 &&
+		kvm_arch_crucible_q35_ps_execution_ready_locked(kvm) &&
+		ps->phase == KVM_CRUCIBLE_PS_ACTIVE && clock->active &&
+		kvm->crucible_active && clock->window_generation &&
+		ps->start_ps < ps->end_ps && ps->plan.quantum_ps &&
+		ps->end_ps - ps->start_ps == ps->plan.quantum_ps &&
+		slice && clock->host_origin_ns <= KTIME_MAX &&
+		slice <= KTIME_MAX - clock->host_origin_ns &&
+		clock->host_ceiling_ns == clock->host_origin_ns + slice &&
+		kvm->crucible_host_ceiling_ns == clock->host_ceiling_ns &&
+		now_ns >= clock->host_origin_ns && now_ns < clock->host_ceiling_ns;
+}
+
+/* A future or boundary expiry remains a logical pending row. It is never
+ * converted to an unbounded host arm or borrowed from a previous window.
+ * The positive result supplies a deadline only, not a timer-effect lease.
+ */
+static int q35_ps_timer_host_locked(struct kvm *kvm, u64 logical_ps,
+	ktime_t *host, u64 now_ns)
+{
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	struct kvm_crucible_ps_clock_state *ps = &clock->ps;
+	u64 delay;
+
+	lockdep_assert_held(&kvm->crucible_gate_lock);
+	if (!ps->selected || ps->plan.version != 2 || !host)
+		return -EOPNOTSUPP;
+	if (!q35_ps_timer_window_current_locked(kvm, now_ns))
+		return -EAGAIN;
+	if (logical_ps >= ps->end_ps)
+		return 0;
+	delay = logical_ps <= ps->start_ps ? 0 :
+		kvm_crucible_ps_host_delay(logical_ps - ps->start_ps,
+			ps->plan.quantum_ps, ps->plan.physical_slice_ns);
+	/* An interior logical expiry that rounds to the physical stop cannot be
+	 * represented by this native window. Refuse rather than move it silently.
+	 */
+	if (delay >= ps->plan.physical_slice_ns)
+		return -ERANGE;
+	*host = ns_to_ktime(clock->host_origin_ns + delay);
+	return 1;
+}
+
+static bool q35_ps_timer_due_locked(struct kvm *kvm, u64 logical_ps, u64 now_ns)
+{
+	struct kvm_crucible_ps_clock_state *ps = &kvm->arch.crucible_clock.ps;
+
+	lockdep_assert_held(&kvm->crucible_gate_lock);
+	return q35_ps_timer_window_current_locked(kvm, now_ns) &&
+		logical_ps < ps->end_ps &&
+		logical_ps <= q35_ps_now_locked(&kvm->arch.crucible_clock, now_ns);
 }
 
