# ANDYL OS — kernel console display

# VT + framebuffer console so kernel/systemd messages reach whatever
# the firmware/hypervisor exposes as a graphical console after the
# bootloader hands off — the EC2/GCP/Azure web "screenshot" surfaces,
# the QEMU GTK window during local dev, the IPMI BMC viewer on a
# rack server. Serial (CONFIG_SERIAL_8250_CONSOLE) remains the
# canonical interactive surface; this fragment just stops the
# graphical console from going dark at sd-boot handoff.
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y

# UEFI framebuffer handoff: SYSFB_SIMPLEFB registers the firmware's
# framebuffer as a `simple-framebuffer` platform device, which
# DRM_SIMPLEDRM then binds to — no vendor-specific DRM module needed.
# Covers every UEFI cloud (AWS Nitro, GCP, Azure Gen2, OCI,
# DigitalOcean, Vultr, Linode) and bare-metal UEFI boxes with one
# driver. Vendor drivers can still bind later as modules if we add
# them; without them, simpledrm holds the framebuffer for the life
# of the boot. Note: SYSFB=y alone only builds the framework — the
# SIMPLEFB sub-option is what actually instantiates the platform
# device, otherwise tty0 falls back to VGA_CONSOLE which writes to
# a text-mode buffer the EFI GOP display doesn't scan out (black
# screen after sd-boot).
CONFIG_SYSFB=y
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
