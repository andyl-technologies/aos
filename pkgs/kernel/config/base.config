# ANDYL OS — Base kernel configuration
# Core subsystems required for a functional server system.

# General
CONFIG_SYSFS=y
CONFIG_PROC_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_FHANDLE=y
CONFIG_POSIX_MQUEUE=y

# initrd support
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_XZ=y
CONFIG_RD_ZSTD=y
CONFIG_RD_LZ4=y

# Kernel image compression: zstd, replacing the defconfig default (gzip).
# The kernel's self-decompressing stub compresses the image at zstd's
# maximum level internally, producing a smaller bzImage / UKI .linux
# section. Requires the zstd tool at build time (pkgs/kernel/linux.nix).
# olddefconfig clears the previously-default CONFIG_KERNEL_GZIP choice.
CONFIG_KERNEL_ZSTD=y

# Cgroups (required for containers and systemd)
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_PERF=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_SCHED=y
# Crucible's attempt owner requires cpu.max, not just CPU accounting.
CONFIG_CFS_BANDWIDTH=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_WRITEBACK=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_CPUSETS=y

# Ext4 project quotas bound aggregate attempt artifacts, including helpers.
# Build them in so isolated hosts can enforce quotas without loading modules.
CONFIG_QUOTA=y
CONFIG_QFMT_V2=y
CONFIG_QUOTACTL=y

# Namespaces (required for containers)
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y

# BPF
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_EVENTS=y
CONFIG_FUNCTION_TRACER=y
CONFIG_DYNAMIC_FTRACE=y

# BTF type information for eBPF tooling and BPF-LSM policy development.
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_COMPRESSED_NONE=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y
# CONFIG_DEBUG_INFO_REDUCED is not set
# CONFIG_DEBUG_INFO_SPLIT is not set

# Multi-processor
CONFIG_SMP=y
CONFIG_SCHED_SMT=y
CONFIG_SCHED_MC=y
CONFIG_NR_CPUS=8192
CONFIG_NUMA=y
CONFIG_NUMA_BALANCING=y
CONFIG_NUMA_BALANCING_DEFAULT_ENABLED=y

# Reliability and large-memory server telemetry
CONFIG_X86_MCE=y
CONFIG_X86_MCE_AMD=y
CONFIG_EDAC=y
CONFIG_EDAC_AMD64=m
CONFIG_ACPI_APEI=y
CONFIG_ACPI_APEI_GHES=y
CONFIG_RAS=y
CONFIG_MEMORY_HOTPLUG=y
CONFIG_MEMORY_HOTREMOVE=y
CONFIG_HOTPLUG_CPU=y

# Power management
CONFIG_ACPI=y
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_DEFAULT_GOV_ONDEMAND=y

# Memory
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_COMPACTION=y
CONFIG_KSM=y
CONFIG_SWAP=y

# Misc
CONFIG_PRINTK=y
CONFIG_FUTEX=y
CONFIG_MULTIUSER=y
CONFIG_SYSVIPC=y
CONFIG_UNIX=y
CONFIG_ELF_CORE=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_CRASH_DUMP=y
CONFIG_PERF_EVENTS=y

# efivarfs built-in (not =m) so it is available at PID1 mount_setup time
# and systemd mounts /sys/firmware/efi/efivars early. As a module it is
# never loaded before that mount, leaving EFI variables (incl. Secure
# Boot's SecureBoot/SetupMode) invisible and `bootctl` reporting
# "unsupported" (RFC-0006). The defconfig default is =m.
CONFIG_EFI=y
CONFIG_EFIVAR_FS=y
