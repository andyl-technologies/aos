# ANDYL OS — aarch64 key-free kernel hardening
#
# Architecture-specific, reproducible hardening for arm64. Merged only when
# building the arm64 kernel (see pkgs/kernel/linux.nix).

# Per-task stack canary.
CONFIG_STACKPROTECTOR_PER_TASK=y

# Pointer authentication for userspace and the kernel.
CONFIG_ARM64_PTR_AUTH=y
CONFIG_ARM64_PTR_AUTH_KERNEL=y

# Branch Target Identification (forward-edge control-flow integrity) for
# userspace. ARM64_BTI_KERNEL is left out: the kernel Kconfig excludes GCC,
# which is the compiler AOS uses to build the kernel.
CONFIG_ARM64_BTI=y
