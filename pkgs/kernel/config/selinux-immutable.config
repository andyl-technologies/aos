# ANDYL OS - immutable SELinux boot contract

# SELinux is unconditionally active and enforcing in this kernel variant.
# Neither the signed command line nor a process with policy authority can
# disable enforcement after the kernel starts.
CONFIG_SECURITY_SELINUX=y
# CONFIG_SECURITY_SELINUX_BOOTPARAM is not set
# CONFIG_SECURITY_SELINUX_DEVELOP is not set
CONFIG_DEFAULT_SECURITY_SELINUX=y
CONFIG_DEFAULT_SECURITY="selinux"

# Stage 0 mounts the labeled stage-1 image directly from a regular file in the
# signed initramfs.  All four features must be built in: loading a filesystem
# module before the SELinux policy would create an unaudited admission path.
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EROFS_FS_BACKED_BY_FILE=y
