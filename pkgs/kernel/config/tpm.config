# ANDYL OS — TPM / TCG drivers (RFC-0006 phase 3, measured boot)
#
# Drivers, not keys: unlike lockdown/module-signing (which need a
# non-public key and therefore live in a deployment overlay), the TPM
# interface drivers are reproducible and belong in the base. Built-in
# (=y, not =m) so the TPM is available in early boot for the PCR-phase
# extender and for TPM2-token unlock of /var before switch-root.
CONFIG_TCG_TPM=y
CONFIG_TCG_TIS_CORE=y
CONFIG_TCG_TIS=y
CONFIG_TCG_CRB=y
CONFIG_HW_RANDOM_TPM=y
