# ANDYL OS — x86_64 key-free kernel hardening
#
# Architecture-specific, reproducible hardening for x86_64. Merged only when
# building the x86_64 kernel (see pkgs/kernel/linux.nix).

# Indirect Branch Tracking (forward-edge control-flow integrity).
CONFIG_X86_KERNEL_IBT=y

# Remove the legacy vsyscall page; it is a fixed-address code region.
CONFIG_LEGACY_VSYSCALL_NONE=y
