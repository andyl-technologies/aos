# ANDYL OS — Storage / block device configuration

# SCSI
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_SCSI_SPI_ATTRS=y
CONFIG_SCSI_FC_ATTRS=y
CONFIG_SCSI_SCAN_ASYNC=y
CONFIG_SCSI_MULTI_LUN=y

# ATA / SATA
CONFIG_ATA=y
CONFIG_ATA_PIIX=y
CONFIG_SATA_AHCI=y
CONFIG_ATA_SFF=y
CONFIG_ATA_BMDMA=y

# NVMe
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_CORE=y

# Block layer
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
CONFIG_DM_VERITY_VERIFY_ROOTHASH_SIG=y
CONFIG_DM_VERITY_VERIFY_ROOTHASH_SIG_PLATFORM_KEYRING=y
CONFIG_DM_CRYPT=m
CONFIG_DM_SNAPSHOT=m
CONFIG_DM_THIN_PROVISIONING=m
CONFIG_DM_MIRROR=m
CONFIG_DM_ZERO=m
CONFIG_DM_MULTIPATH=m
CONFIG_MD=y
CONFIG_MD_RAID0=m
CONFIG_MD_RAID1=m
CONFIG_MD_RAID456=m

# Filesystems
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_XFS_FS=m
CONFIG_BTRFS_FS=m
CONFIG_OVERLAY_FS=y
CONFIG_OVERLAY_FS_REDIRECT_DIR=y
# Lets composefs serve file content from a separate data-only lower
# (datadir+= overlay option) while keeping mode/ownership metadata in
# the EROFS image. Required by the /etc overlay's three-layer composition.
CONFIG_OVERLAY_FS_METACOPY=y
# EROFS backs the per-generation /etc system lower. EROFS_FS_XATTR and
# EROFS_FS_BACKED_BY_FILE follow as upstream kernel defaults (default y
# in fs/erofs/Kconfig), so no explicit lines are needed for them.
CONFIG_EROFS_FS=y
# Compressed-data support for EROFS, used by the zstd-compressed read-only
# root filesystem. EROFS_FS_ZIP (the LZ4 base) is upstream default-y under
# EROFS_FS; EROFS_FS_ZIP_ZSTD is opt-in and is what decodes the root image
# written by `mkfs.erofs -z zstd`.
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_ZIP_ZSTD=y
CONFIG_FUSE_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_ISO9660_FS=m

# Disk partitions
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y
