# ANDYL OS — Virtualization / VM guest configuration

# VirtIO (QEMU / KVM guests)
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LEGACY=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MEM=m
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y

# KVM guest support
CONFIG_KVM_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_PARAVIRT_TIME_ACCOUNTING=y
CONFIG_HYPERVISOR_GUEST=y

# SCSI for VMs
CONFIG_SCSI_VIRTIO=y

# 9P filesystem (host-guest sharing)
CONFIG_NET_9P=m
CONFIG_NET_9P_VIRTIO=m
CONFIG_9P_FS=m
CONFIG_9P_FS_POSIX_ACL=y

# QEMU firmware config device — ignition uses this to read its
# first-boot config JSON delivered via QEMU -fw_cfg.
CONFIG_FW_CFG_SYSFS=y
CONFIG_FW_CFG_SYSFS_CMDLINE=y
