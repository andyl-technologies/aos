# ANDYL OS — Network stack configuration

CONFIG_NET=y
CONFIG_INET=y
CONFIG_IP_MULTICAST=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IP_ROUTE_MULTIPATH=y
CONFIG_IP_ROUTE_VERBOSE=y
CONFIG_IP_PNP=y
CONFIG_IP_PNP_DHCP=y
CONFIG_NET_IPIP=m
CONFIG_NET_IPGRE=m
CONFIG_NET_IPGRE_DEMUX=m
CONFIG_IP_MROUTE=y
CONFIG_SYN_COOKIES=y

# IPv6
CONFIG_IPV6=y
CONFIG_IPV6_ROUTER_PREF=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IPV6_SIT=m
CONFIG_IPV6_TUNNEL=m
CONFIG_IPV6_GRE=m

# Bridging
CONFIG_BRIDGE=y
CONFIG_BRIDGE_VLAN_FILTERING=y
CONFIG_LLC=y

# Bonding (link aggregation / failover)
CONFIG_BONDING=m

# VLAN
CONFIG_VLAN_8021Q=m
CONFIG_VLAN_8021Q_GVRP=y

# VXLAN / Tunneling
CONFIG_VXLAN=m
CONFIG_GENEVE=m
CONFIG_GRE=m
CONFIG_NET_FOU=m
CONFIG_IPVLAN=m
CONFIG_MACVLAN=m
CONFIG_MACVTAP=m
CONFIG_TUN=y
CONFIG_VETH=y
CONFIG_DUMMY=m

# Netfilter
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y

# Bridge netfilter for Kubernetes pod networking: kube-proxy's iptables
# rules on bridged traffic only take effect when br_netfilter is loaded.
# k8s-modules-load.service modprobes this at boot.
CONFIG_BRIDGE_NETFILTER=m

# Built-in (not module) so nftables' `log` expression works without
# relying on the kernel's request_module() path — that calls
# /sbin/modprobe, which doesn't exist on AOS's rootfs. Built-in
# avoids the auto-load detour entirely.
CONFIG_NF_LOG_SYSLOG=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_FTP=m
CONFIG_NF_CONNTRACK_TFTP=m
CONFIG_NF_CT_NETLINK=m
CONFIG_NF_NAT=y
CONFIG_NF_NAT_FTP=m
CONFIG_NF_NAT_TFTP=m
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_TARGET_MARK=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=m
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_CT=m
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_RECENT=m
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_MATCH_STATISTIC=m
# Linux 6.x split CONFIG_IP_NF_IPTABLES into an umbrella symbol +
# *_LEGACY symbols that gate the x_tables backend. The dependency
# chain — `IP_NF_NAT` deps `IP_NF_IPTABLES_LEGACY` deps
# `NETFILTER_XTABLES_LEGACY` — means all three need to be enabled
# for kube-proxy's iptables-legacy to find the `nat` table. Without
# the chain, kbuild silently drops the leaves and kube-proxy exits
# with "iptables v1.8.x (legacy): can't initialize iptables table
# `nat'". Same story for IP6_NF.
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_REJECT=y
CONFIG_IP6_NF_MANGLE=y

# nftables
CONFIG_NETFILTER_NETLINK_ACCT=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_COUNTER=y
CONFIG_NFT_COMPAT=y

# IPVS (required for kube-proxy IPVS mode)
CONFIG_IP_VS=m
CONFIG_IP_VS_PROTO_TCP=y
CONFIG_IP_VS_PROTO_UDP=y
CONFIG_IP_VS_RR=m
CONFIG_IP_VS_WRR=m
CONFIG_IP_VS_SH=m
CONFIG_IP_VS_NFCT=y

# Packet scheduling
CONFIG_NET_SCHED=y
CONFIG_NET_CLS_CGROUP=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_INGRESS=m
# Fair Queue — does packet pacing in the qdisc layer. BBR does not
# strictly require it: net/ipv4/tcp_bbr.c notes "BBR might be used with
# the fq qdisc ... otherwise TCP stack falls back to an internal pacing
# using one high resolution timer per TCP socket and may use more
# resources." fq keeps pacing off that per-socket timer, which is the
# right trade for a many-connection server. `aos.kernel.bbr` sets
# net.core.default_qdisc=fq; built in so the early sysctl that selects
# it never waits on a module load.
CONFIG_NET_SCH_FQ=y

# Advanced TCP congestion control + BBR. BBR gates on
# CONFIG_TCP_CONG_ADVANCED; built as a module (`tcp_bbr`) to match
# `aos.kernel.bbr`, which loads it via /etc/modules-load.d and sets
# net.ipv4.tcp_congestion_control=bbr.
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=m

# XDP / eBPF networking
CONFIG_XDP_SOCKETS=y

# ipset — used by k3s's NetworkPolicy controller (kube-router-derived)
# and by kube-proxy (when users add `-m set` rules to extra-iptables).
# Set types are split per family upstream; the subset below covers
# what k3s's netpol controller emits. NETNET / NETIFACE etc. are
# omitted — k3s does not generate rules keyed on those.
CONFIG_IP_SET=m
CONFIG_NETFILTER_XT_SET=m
CONFIG_IP_SET_HASH_IP=m
CONFIG_IP_SET_HASH_NET=m
CONFIG_IP_SET_HASH_IPPORT=m
CONFIG_IP_SET_HASH_NETPORT=m
CONFIG_IP_SET_HASH_IPPORTNET=m
CONFIG_IP_SET_HASH_NETNET=m
CONFIG_IP_SET_LIST_SET=m
CONFIG_NETFILTER_XT_MATCH_IPVS=m
