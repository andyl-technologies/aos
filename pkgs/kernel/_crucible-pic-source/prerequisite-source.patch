+		input->inflight = true;
+		input->claimed = false;
+		input->known = false;
+		input->owner = current;
+	}
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	if (result)
+		goto unlock_roster;
