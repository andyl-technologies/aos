+			  kvm->crucible_irq_input.owners)) ||
+			(kvm->crucible_memory_tainted ||
+			 (kvm->crucible_irq_input.enabled &&
+			  kvm->crucible_irq_input.tainted)),
+			kvm->crucible_uncollected_returns);
