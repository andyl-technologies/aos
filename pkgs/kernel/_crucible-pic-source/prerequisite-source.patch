+	if (state->resumes >= state->maximum_resumes ||
+	    state->active_ns >= state->maximum_active_ns)
+		return -EOVERFLOW;
+	return 0;
+}
+
+/* Called once only after original admission and finite deadline computation. */
+static inline void kvm_crucible_continuation_resume(
+	struct kvm_crucible_continuation_policy *state)
+{
+	state->resumes++;
+	state->paused = false;
+}
