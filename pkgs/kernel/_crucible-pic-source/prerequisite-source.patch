+// SPDX-License-Identifier: GPL-2.0-only
+/* Included by i8254.c. Original PIT arm/expiry/work lineage only. This does
+ * not remove native PIT creation refusal or issue complete board authority. */
+static bool pit_native_selected(struct kvm_pit *pit)
+{
+	return READ_ONCE(pit->kvm->crucible_irq_input.enabled) &&
+		READ_ONCE(pit->kvm->crucible_continuation_roster_frozen);
+}
+
+static bool pit_native_live_locked(struct kvm *kvm)
+{
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+
+	lockdep_assert_held(&kvm->crucible_gate_lock);
+	return kvm_crucible_clock_admission_live(clock->active,
+		kvm->crucible_host_ceiling_ns, ktime_get_ns()) &&
+		!kvm->crucible_irq_input.tainted && !kvm->crucible_memory_tainted &&
+		!clock->continuation.uncertain;
+}
+
+static bool pit_native_run_locked(struct kvm_pit *pit, struct kvm_vcpu *vcpu)
+{
+	struct kvm *kvm = pit->kvm;
+
+	return vcpu && vcpu->kvm == kvm && kvm->arch.vpit == pit &&
+		pit_native_live_locked(kvm) && !in_interrupt() &&
+		vcpu->crucible_timer_run_owner == current &&
+		vcpu->crucible_timer_run_invocation &&
+		vcpu->crucible_run_return.outstanding &&
+		vcpu->crucible_timer_run_invocation ==
+			vcpu->crucible_run_return.original.invocation &&
+		vcpu->crucible_run_return.original.native_vcpu_id == vcpu->vcpu_id &&
+		vcpu->crucible_run_return.original.generation_begin ==
+			kvm->arch.crucible_clock.window_generation &&
+		!(vcpu->crucible_run_return.original.flags & KVM_CRUCIBLE_RUN_RETURN_RETURNED);
+}
+
+/* The birth retains a bounded identity from the frozen native roster. A later
+ * RUN may replace the kernel's last-return slot; it cannot rewrite this arm. */
+static bool pit_native_birth_locked(struct kvm_pit *pit, u64 generation,
+	u64 invocation, u64 sequence, u32 native_vcpu_id)
+{
+	struct kvm_vcpu *vcpu;
+	unsigned long index;
+
+	lockdep_assert_held(&pit->kvm->crucible_gate_lock);
+	if (!generation || generation != pit->kvm->arch.crucible_clock.window_generation ||
+	    !invocation || !sequence || sequence > pit->pit_state.crucible.issued)
+		return false;
+	kvm_for_each_vcpu(index, vcpu, pit->kvm) {
+		if (index < KVM_MAX_VCPUS && vcpu->vcpu_id == native_vcpu_id)
+			return true;
+	}
+	return false;
+}
+
+static void pit_native_fault(struct kvm_pit *pit)
+{
+	unsigned long flags;
+
+	raw_spin_lock_irqsave(&pit->kvm->crucible_gate_lock, flags);
+	kvm_arch_crucible_irq_taint_locked(pit->kvm);
+	raw_spin_unlock_irqrestore(&pit->kvm->crucible_gate_lock, flags);
+	kvm_vm_dead(pit->kvm);
+}
+
+/* Called with the original PIT mutex. It never drains expired work or replaces
+ * queued expiry rows. A concurrent callback makes cancellation uncertain. */
+static bool pit_native_cancel(struct kvm_pit *pit)
+{
+	struct kvm_crucible_pit_journal *journal = &pit->pit_state.crucible;
+	unsigned long flags;
+	bool valid;
+
+	raw_spin_lock_irqsave(&pit->kvm->crucible_gate_lock, flags);
+	valid = pit_native_run_locked(pit, journal->write_vcpu) && journal->access_active &&
+		!journal->callback_active && !journal->worker_active;
+	raw_spin_unlock_irqrestore(&pit->kvm->crucible_gate_lock, flags);
+	if (!valid || hrtimer_try_to_cancel(&pit->pit_state.timer) < 0) {
+		pit_native_fault(pit);
+		return false;
+	}
+
+	raw_spin_lock_irqsave(&pit->kvm->crucible_gate_lock, flags);
+	valid = pit_native_run_locked(pit, journal->write_vcpu) && journal->access_active &&
+		!journal->callback_active && !journal->worker_active;
+	if (valid) {
+		journal->queued = false;
+		journal->valid = false;
+	}
+	raw_spin_unlock_irqrestore(&pit->kvm->crucible_gate_lock, flags);
+	if (!valid)
+		pit_native_fault(pit);
+	return valid;
+}
+
+static bool pit_native_program(struct kvm_pit *pit, u32 count, bool periodic)
+{
+	struct kvm *kvm = pit->kvm;
+	struct kvm_kpit_state *state = &pit->pit_state;
+	struct kvm_crucible_pit_journal *journal = &state->crucible;
+	struct kvm_vcpu *vcpu = journal->write_vcpu;
+	unsigned long flags;
+	u64 interval = mul_u64_u32_div(count, NSEC_PER_SEC, KVM_PIT_FREQ);
+	u64 logical, reserved;
+	ktime_t host;
+	bool valid, queue;
+
+	/* Reserve the finite arm identity before cancellation changes a queue.
+	 * Failure consumes that reservation and retains sticky uncertainty. */
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	valid = pit_native_run_locked(pit, vcpu) && journal->access_active &&
+		journal->issued < KVM_CRUCIBLE_PIT_ISSUED &&
+		ioapic_in_kernel(kvm) && !(state->flags & KVM_PIT_FLAGS_HPET_LEGACY) && interval;
+	reserved = valid ? ++journal->issued : 0;
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	if (!valid || !pit_native_cancel(pit)) {
+		pit_native_fault(pit);
+		return false;
+	}
+	logical = kvm_crucible_clock_ns(kvm);
+	if (logical > KTIME_MAX || interval > KTIME_MAX - logical) {
+		pit_native_fault(pit);
+		return false;
+	}
+	logical += interval;
+	queue = kvm_crucible_clock_host_expiration(kvm, ns_to_ktime(logical), &host);
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	valid = pit_native_run_locked(pit, vcpu) && journal->access_active &&
+		journal->issued == reserved;
+	if (valid) {
+		journal->arm_sequence = reserved;
+		journal->generation = kvm->arch.crucible_clock.window_generation;
+		journal->invocation = vcpu->crucible_timer_run_invocation;
+		journal->native_vcpu_id = vcpu->vcpu_id;
+		journal->logical = ns_to_ktime(logical);
+		journal->host = queue ? host : 0;
+		journal->valid = true;
+		journal->queued = queue;
+		journal->periodic = periodic;
+		state->period = interval;
+		state->is_periodic = periodic;
+	}
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	if (!valid) {
+		pit_native_fault(pit);
+		return false;
+	}
+	/* The original RUN remains retained through native queue publication.
+	 * A target outside this window is retained, never armed against host time. */
+	if (queue)
+		hrtimer_start(&state->timer, host, HRTIMER_MODE_ABS);
+	return true;
+}
+
+static bool pit_native_schedule_locked(struct kvm_pit *pit)
+{
+	struct kvm_crucible_pit_journal *journal = &pit->pit_state.crucible;
+
+	if (!journal->count || journal->work_scheduled ||
+	    journal->awaiting_ack || journal->worker_active || !pit_native_live_locked(pit->kvm))
+		return false;
+	journal->work_scheduled = true;
+	return true;
+}
+
+static enum hrtimer_restart pit_native_expire(struct kvm_pit *pit)
+{
+	struct kvm *kvm = pit->kvm;
+	struct kvm_kpit_state *state = &pit->pit_state;
+	struct kvm_crucible_pit_journal *journal = &state->crucible;
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	struct kvm_crucible_pit_expiry *row;
+	unsigned long flags;
+	ktime_t next = 0, host;
+	bool valid, closed, schedule = false, periodic = false;
+	enum hrtimer_restart result = HRTIMER_NORESTART;
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	valid = kvm->arch.vpit == pit && journal->valid && journal->queued &&
+		pit_native_birth_locked(pit, journal->generation, journal->invocation,
+			journal->arm_sequence, journal->native_vcpu_id) &&
+		journal->host == hrtimer_get_expires(&state->timer) &&
+		!journal->callback_active && !kvm->crucible_irq_input.tainted;
+	closed = valid && !kvm_crucible_clock_admission_live(clock->active,
+		kvm->crucible_host_ceiling_ns, ktime_get_ns()) && !kvm->crucible_memory_tainted &&
+		!clock->continuation.uncertain;
+	if (closed)
+		journal->queued = false;
+	valid = valid && !closed && pit_native_live_locked(kvm) &&
+		clock->timer_owners != U32_MAX &&
+		journal->count < KVM_CRUCIBLE_PIT_PENDING &&
+		kvm_crucible_clock_project(ktime_get_ns() - clock->host_origin_ns,
+			clock->continuation.started ? clock->continuation.projection_origin_ns :
+			clock->start_ns, clock->end_ns, clock->numerator, clock->denominator) >=
+			ktime_to_ns(journal->logical) &&
+		(!journal->periodic || (state->period > 0 &&
+		 journal->logical <= KTIME_MAX - state->period &&
+		 journal->issued < KVM_CRUCIBLE_PIT_ISSUED));
+	if (valid) {
+		journal->queued = false;
+		journal->callback_active = true;
+		clock->timer_owners++;
+		row = &journal->pending[(journal->head + journal->count) % KVM_CRUCIBLE_PIT_PENDING];
+		*row = (struct kvm_crucible_pit_expiry) {
+			.sequence = journal->arm_sequence, .generation = journal->generation,
+			.invocation = journal->invocation, .logical = journal->logical,
+			.host = journal->host,
+			.native_vcpu_id = journal->native_vcpu_id,
+		};
+		journal->count++;
+		periodic = journal->periodic;
+		if (periodic) {
+			journal->issued++;
+			journal->arm_sequence = journal->issued;
+			journal->logical += state->period;
+			next = journal->logical;
+		} else {
+			journal->valid = false;
+		}
+		schedule = pit_native_schedule_locked(pit);
+	}
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	if (!valid) {
+		if (!closed)
+			pit_native_fault(pit);
+		return HRTIMER_NORESTART;
+	}
+	if (schedule)
+		kthread_queue_work(pit->worker, &pit->expired);
+	if (periodic && kvm_crucible_clock_host_expiration(kvm, next, &host)) {
+		raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+		if (pit_native_live_locked(kvm) && journal->generation == clock->window_generation &&
+		    journal->logical == next && journal->callback_active) {
+			journal->host = host;
+			journal->queued = true;
+			hrtimer_set_expires(&state->timer, host);
+			result = HRTIMER_RESTART;
+		}
+		raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	}
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	/* Freeze waits for this lease, then hrtimer_cancel joins the actual
+	 * callback return/core RESTART reenqueue before publishing its cut. */
+	valid = pit_native_live_locked(kvm);
+	if (!valid) {
+		kvm_arch_crucible_irq_taint_locked(kvm);
+		result = HRTIMER_NORESTART;
+	}
+	journal->callback_active = false;
+	clock->timer_owners--;
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	wake_up_all(&kvm->crucible_stopped);
+	if (!valid)
+		kvm_vm_dead(kvm);
+	return result;
+}
+
+/* Only the actual owned kthread may claim each original IRQ level once. This
+ * source class is independent of an operator-enrolled userspace IRQ input. */
+bool kvm_arch_crucible_pit_irq_claim_locked(struct kvm *kvm, u32 source_kind,
+	int source, u32 gsi, int level, bool line_status)
+{
+	struct kvm_pit *pit = kvm->arch.vpit;
+	struct kvm_crucible_pit_journal *journal;
+	struct kvm_crucible_pit_expiry *row;
+
+	lockdep_assert_held(&kvm->crucible_gate_lock);
+	if (!pit || !pit_native_selected(pit))
+		return false;
+	journal = &pit->pit_state.crucible;
+	if (!journal->worker_active || journal->worker_owner != current || in_interrupt() ||
+	    !pit->worker || pit->worker->task != current || !journal->count ||
+	    journal->irq_claimed || !pit_native_live_locked(kvm))
+		return false;
+	row = &journal->pending[journal->head];
+	if (!pit_native_birth_locked(pit, row->generation, row->invocation,
+		row->sequence, row->native_vcpu_id) || row->phase > 1 ||
+	    source_kind != KVM_CRUCIBLE_IRQ_SOURCE_LINE || source != KVM_PIT_IRQ_SOURCE_ID ||
+	    gsi || line_status || level != (row->phase == 0 ? 1 : 0))
+		return false;
+	journal->irq_claimed = true;
+	return true;
+}
+
+/* A source lease is necessary but not sufficient: the destination carries
+ * this exact original worker/expiry identity across every native callback. */
+bool kvm_arch_crucible_pit_irq_birth_live_locked(struct kvm *kvm,
+	const struct kvm_crucible_pit_irq_birth *birth)
+{
+	struct kvm_pit *pit = kvm->arch.vpit;
+	struct kvm_crucible_pit_journal *journal;
+	struct kvm_crucible_pit_expiry *row;
+
+	lockdep_assert_held(&kvm->crucible_gate_lock);
+	if (!birth || !pit || !pit_native_selected(pit))
+		return false;
+	journal = &pit->pit_state.crucible;
+	if (!journal->worker_active || journal->worker_owner != current ||
+	    !pit->worker || pit->worker->task != current || in_interrupt() ||
+	    !journal->count || !journal->irq_claimed ||
+	    !kvm->arch.crucible_clock.timer_owners || !kvm->crucible_irq_input.owners ||
+	    !pit_native_live_locked(kvm))
+		return false;
+
+	row = &journal->pending[journal->head];
+	return row->phase < 2 && row->phase == birth->phase &&
+		row->generation == birth->generation && row->invocation == birth->invocation &&
+		row->sequence == birth->sequence && row->native_vcpu_id == birth->native_vcpu_id &&
+		ktime_to_ns(row->host) == birth->host_ns &&
+		ktime_to_ns(row->logical) == birth->logical_ns &&
+		row->irq_route_bits == birth->route_bits &&
+		pit_native_birth_locked(pit, birth->generation, birth->invocation,
+			birth->sequence, birth->native_vcpu_id);
+}
+EXPORT_SYMBOL_FOR_KVM_INTERNAL(kvm_arch_crucible_pit_irq_birth_live_locked);
+
+bool kvm_arch_crucible_pit_irq_route_bind_locked(struct kvm *kvm,
+	struct kvm_crucible_pit_irq_birth *birth, u64 route_bits)
+{
+	struct kvm_crucible_pit_expiry *row;
+
+	lockdep_assert_held(&kvm->crucible_gate_lock);
+	if (!route_bits || !kvm_arch_crucible_pit_irq_birth_live_locked(kvm, birth))
+		return false;
+	row = &kvm->arch.vpit->pit_state.crucible.pending[
+		kvm->arch.vpit->pit_state.crucible.head];
+	if (!birth->phase && !row->irq_route_bits) {
+		/* Reserve before line/IRR effects. A failed delivery never clears it. */
+		row->irq_route_bits = route_bits;
+		birth->route_bits = route_bits;
+		return true;
+	}
+	return birth->phase == 1 && row->irq_route_bits == route_bits;
+}
+EXPORT_SYMBOL_FOR_KVM_INTERNAL(kvm_arch_crucible_pit_irq_route_bind_locked);
+
+static int pit_native_irq_dispatch(struct kvm_pit *pit,
+	struct kvm_crucible_pit_irq_birth *birth)
+{
+	struct kvm *kvm = pit->kvm;
+	struct kvm_kernel_irq_routing_entry routes[KVM_NR_IRQCHIPS];
+	bool retained, admitted;
+	int count, srcu, result = -EAGAIN;
+
+	admitted = kvm_crucible_irq_source_begin(kvm, KVM_CRUCIBLE_IRQ_SOURCE_LINE,
+		KVM_PIT_IRQ_SOURCE_ID, 0, birth->phase ? 0 : 1, false, &retained);
+	if (!admitted)
+		goto release;
+
+	srcu = srcu_read_lock(&kvm->irq_srcu);
+	count = kvm_irq_map_gsi(kvm, routes, 0);
+	srcu_read_unlock(&kvm->irq_srcu, srcu);
+	/* The usual dual PIC/IOAPIC route requires a separate PIC birth join.
+	 * Validate the entire bounded route before performing either branch. */
+	if (count != 1 || routes[0].type != KVM_IRQ_ROUTING_IRQCHIP ||
+	    routes[0].irqchip.irqchip != KVM_IRQCHIP_IOAPIC || routes[0].irqchip.pin ||
+	    routes[0].gsi || routes[0].set != kvm_ioapic_set_irq) {
+		pit_native_fault(pit);
+		goto release;
+	}
+	result = kvm_crucible_ioapic_pit_set_irq(kvm, birth);
+
+release:
+	kvm_crucible_irq_source_leave(kvm, retained);
+	return result;
+}
+
+bool kvm_arch_crucible_pit_nmi_admit(struct kvm_vcpu *vcpu)
+{
+	struct kvm *kvm = vcpu->kvm;
+	struct kvm_pit *pit = kvm->arch.vpit;
+	struct kvm_crucible_pit_journal *journal;
+	struct kvm_crucible_pit_expiry *row;
+	struct kvm_vcpu *original;
+	unsigned long flags, index;
+	bool valid = false;
+
+	if (!pit || !pit_native_selected(pit))
+		return true;
+	journal = &pit->pit_state.crucible;
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	if (journal->count && journal->worker_active && journal->worker_owner == current &&
+	    pit->worker && pit->worker->task == current && !in_interrupt() &&
+	    !journal->nmi_claimed && pit_native_live_locked(kvm)) {
+		row = &journal->pending[journal->head];
+		kvm_for_each_vcpu(index, original, kvm) {
+			if (index == row->nmi_index && original == vcpu && row->phase == 2 &&
+			    pit_native_birth_locked(pit, row->generation, row->invocation,
+				row->sequence, row->native_vcpu_id)) {
+				valid = true;
+				journal->nmi_claimed = true;
+				break;
+			}
+		}
+	}
+	if (!valid)
+		kvm_arch_crucible_irq_taint_locked(kvm);
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	if (!valid)
+		kvm_vm_dead(kvm);
+	return valid;
+}
+
+static void pit_native_work(struct kvm_pit *pit)
+{
+	struct kvm *kvm = pit->kvm;
+	struct kvm_crucible_pit_journal *journal = &pit->pit_state.crucible;
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	struct kvm_crucible_pit_expiry *row;
+	struct kvm_vcpu *vcpu;
+	struct kvm_crucible_pit_irq_birth birth;
+	unsigned long flags, index;
+	bool valid, schedule;
+	int native_result;
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	valid = kvm->arch.vpit == pit && pit->worker && pit->worker->task == current &&
+		!in_interrupt() && journal->work_scheduled && !journal->worker_active;
+	if (valid)
+		journal->work_scheduled = false;
+	if (valid && (!pit_native_live_locked(kvm) || journal->awaiting_ack || !journal->count)) {
+		raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+		return;
+	}
+	row = &journal->pending[journal->head];
+	valid = valid && pit_native_birth_locked(pit, row->generation, row->invocation,
+		row->sequence, row->native_vcpu_id) && row->phase <= 2 &&
+		clock->timer_owners != U32_MAX;
+	if (valid) {
+		journal->worker_active = true;
+		journal->worker_owner = current;
+		clock->timer_owners++;
+	}
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	if (!valid) {
+		pit_native_fault(pit);
+		return;
+	}
+
+	while (row->phase < 2) {
+		raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+		valid = pit_native_live_locked(kvm) && row->generation == clock->window_generation &&
+			journal->worker_owner == current && !journal->irq_claimed;
+		if (valid && !row->phase && atomic_read(&pit->pit_state.reinject)) {
+			journal->awaiting_ack = true;
+			journal->ack_sequence = row->sequence;
+			journal->ack_generation = row->generation;
+			journal->ack_invocation = row->invocation;
+		}
+		if (valid) {
+			birth = (struct kvm_crucible_pit_irq_birth) {
+				.generation = row->generation, .invocation = row->invocation,
+				.sequence = row->sequence, .native_vcpu_id = row->native_vcpu_id,
+				.host_ns = ktime_to_ns(row->host), .logical_ns = ktime_to_ns(row->logical),
+				.phase = row->phase, .route_bits = row->irq_route_bits,
+			};
+		}
+		raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+		if (!valid)
+			goto fault;
+		native_result = pit_native_irq_dispatch(pit, &birth);
+		raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+		valid = native_result >= 0 && journal->irq_claimed &&
+			pit_native_live_locked(kvm) && row->generation == clock->window_generation;
+		if (valid) {
+			row->phase++;
+			journal->irq_claimed = false;
+		}
+		raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+		if (!valid)
+			goto fault;
+	}
+	if (atomic_read(&kvm->arch.vapics_in_nmi_mode) > 0) {
+		kvm_for_each_vcpu(index, vcpu, kvm) {
+			if (index < row->nmi_index)
+				continue;
+			raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+			valid = pit_native_live_locked(kvm) && index < KVM_MAX_VCPUS &&
+				row->generation == clock->window_generation && journal->worker_owner == current;
+			if (valid)
+				row->nmi_index = index;
+			raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+			if (!valid)
+				goto fault;
+			kvm_apic_nmi_wd_deliver(vcpu);
+			/* Return from this original native callback records the prefix.
+			 * It is not a device-wide output or complete NMI writer proof. */
+			raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+			valid = journal->nmi_claimed && pit_native_live_locked(kvm) &&
+				row->generation == clock->window_generation;
+			if (valid) {
+				row->nmi_index = index + 1;
+				journal->nmi_claimed = false;
+			}
+			raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+			if (!valid)
+				goto fault;
+		}
+	}
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	if (!pit_native_live_locked(kvm) || row->generation != clock->window_generation) {
+		raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+		goto fault;
+	}
+	row->phase = 3;
+	journal->head = (journal->head + 1) % KVM_CRUCIBLE_PIT_PENDING;
+	journal->count--;
+	journal->worker_active = false;
+	schedule = pit_native_schedule_locked(pit);
+	journal->worker_owner = NULL;
+	clock->timer_owners--;
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	if (schedule)
+		kthread_queue_work(pit->worker, &pit->expired);
+	wake_up_all(&kvm->crucible_stopped);
+	return;
+
+fault:
+	pit_native_fault(pit);
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	journal->worker_active = false;
+	journal->worker_owner = NULL;
+	clock->timer_owners--;
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	wake_up_all(&kvm->crucible_stopped);
+}
+
+/* A generic notifier carries no original destination/vector ancestry. Selected
+ * PIT reinjection therefore accepts only the explicit native IOAPIC EOI path. */
+static void pit_native_ack(struct kvm_pit *pit)
+{
+	pit_native_fault(pit);
+}
+
+bool kvm_crucible_pit_ioapic_ack(struct kvm_vcpu *vcpu, int pin, int vector,
+	int trigger_mode, u64 original_route_bits)
+{
+	struct kvm *kvm = vcpu->kvm;
+	struct kvm_pit *pit = kvm->arch.vpit;
+	struct kvm_crucible_pit_journal *journal;
+	struct kvm_crucible_apic_vector *target;
+	unsigned long flags;
+	bool valid, schedule = false;
+
+	lockdep_assert_held(&vcpu->mutex);
+	if (!READ_ONCE(kvm->crucible_irq_input.enabled) ||
+	    !READ_ONCE(kvm->crucible_continuation_roster_frozen))
+		return false;
+	if (!pit || pit->kvm != kvm) {
+		/* Missing original PIT custody cannot become a successful EOI tail. */
+		raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+		kvm_arch_crucible_irq_taint_locked(kvm);
+		raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+		kvm_vm_dead(kvm);
+		return false;
+	}
+	journal = &pit->pit_state.crucible;
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	valid = pin == 0 && trigger_mode == IOAPIC_EDGE_TRIG &&
+		vector >= 16 && vector < 256 && original_route_bits &&
+		kvm->crucible_effect_owners && pit_native_run_locked(pit, vcpu) &&
+		journal->awaiting_ack && journal->ack_sequence && journal->ack_invocation &&
+		journal->ack_generation == kvm->arch.crucible_clock.window_generation;
+	if (valid) {
+		target = &vcpu->crucible_apic_target.vectors[vector];
+		/* A known injection tail is retained ancestry, not guest delivery proof.
+		 * The actual IOAPIC EOI supplies the original receiver and locked route. */
+		valid = target->phase == CRUCIBLE_APIC_CONSUMED && target->source_kind == 2 &&
+			target->target_id == vcpu->vcpu_id && target->consume_invocation &&
+			target->generation == journal->ack_generation &&
+			target->source_sequence == journal->ack_sequence &&
+			target->source_invocation == journal->ack_invocation &&
+			target->source_route_bits == original_route_bits &&
+			(original_route_bits & 0xff) == (u32)vector &&
+			pit_native_birth_locked(pit, target->generation, target->source_invocation,
+				target->source_sequence, target->source_id);
+	}
+	if (valid) {
+		journal->last_acknowledged = journal->ack_sequence;
+		journal->last_ack_target_id = target->target_id;
+		journal->last_ack_vector = vector;
+		journal->last_ack_consume_invocation = target->consume_invocation;
+		journal->last_ack_writer_invocation = vcpu->crucible_timer_run_invocation;
+		journal->awaiting_ack = false;
+		schedule = pit_native_schedule_locked(pit);
+	} else {
+		kvm_arch_crucible_irq_taint_locked(kvm);
+	}
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+
+	if (!valid)
+		kvm_vm_dead(kvm);
+	else if (schedule)
+		kthread_queue_work(pit->worker, &pit->expired);
+	return valid;
+}
+EXPORT_SYMBOL_FOR_KVM_INTERNAL(kvm_crucible_pit_ioapic_ack);
+
+/* Unmasking cannot erase expired rows or a previously delivered IRQ credit.
+ * Its actual guest RUN may only resume the retained original worker obligation. */
+static void pit_native_unmask(struct kvm_pit *pit)
+{
+	struct kvm *kvm = pit->kvm;
+	struct kvm_vcpu *vcpu;
+	unsigned long flags, index;
+	bool valid = false, schedule = false;
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	kvm_for_each_vcpu(index, vcpu, kvm) {
+		if (index < KVM_MAX_VCPUS && pit_native_run_locked(pit, vcpu)) {
+			valid = true;
+			break;
+		}
+	}
+	if (valid)
+		schedule = pit_native_schedule_locked(pit);
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	if (!valid)
+		pit_native_fault(pit);
+	else if (schedule)
+		kthread_queue_work(pit->worker, &pit->expired);
+}
+
+/* Native CPU relocation keeps the same original arm, logical deadline and
+ * birth invocation. It never flushes a worker or creates a replacement row. */
+static void pit_native_migrate(struct kvm_pit *pit, struct kvm_vcpu *vcpu)
+{
+	struct kvm *kvm = pit->kvm;
+	struct kvm_crucible_pit_journal *journal = &pit->pit_state.crucible;
+	unsigned long flags;
+	u64 sequence, generation, invocation;
+	ktime_t logical, host;
+	bool valid, queued;
+
+	mutex_lock(&pit->pit_state.lock);
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	valid = pit_native_run_locked(pit, vcpu) && !journal->callback_active &&
+		!journal->worker_active && !journal->access_active &&
+		kvm->arch.crucible_clock.timer_owners != U32_MAX;
+	sequence = journal->arm_sequence;
+	generation = journal->generation;
+	invocation = journal->invocation;
+	logical = journal->logical;
+	host = journal->host;
+	queued = journal->queued;
+	if (valid)
+		kvm->arch.crucible_clock.timer_owners++;
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	if (!valid)
+		goto out;
+	valid = !queued || hrtimer_try_to_cancel(&pit->pit_state.timer) >= 0;
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	valid = valid && pit_native_run_locked(pit, vcpu) && !journal->callback_active &&
+		!journal->worker_active && journal->arm_sequence == sequence &&
+		journal->generation == generation && journal->invocation == invocation &&
+		journal->logical == logical && journal->host == host && journal->queued == queued;
+	if (valid && queued)
+		journal->queued = true;
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	if (valid && queued)
+		hrtimer_start(&pit->pit_state.timer, host, HRTIMER_MODE_ABS);
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	valid = valid && pit_native_run_locked(pit, vcpu);
+	/* An immediate original expiry owns the next queue fact; never overwrite it. */
+	kvm->arch.crucible_clock.timer_owners--;
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	wake_up_all(&kvm->crucible_stopped);
+out:
+	mutex_unlock(&pit->pit_state.lock);
+	if (!valid)
+		pit_native_fault(pit);
+}
+
+void kvm_crucible_pit_freeze(struct kvm *kvm)
+{
+	struct kvm_pit *pit = kvm->arch.vpit;
+	struct kvm_crucible_pit_journal *journal;
+	unsigned long flags;
+	bool valid;
+
+	if (!pit || !pit_native_selected(pit))
+		return;
+	journal = &pit->pit_state.crucible;
+	mutex_lock(&pit->pit_state.lock);
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	valid = !kvm->arch.crucible_clock.active && !journal->callback_active &&
+		!journal->worker_active && !journal->access_active &&
+		!kvm->crucible_irq_input.tainted && !kvm->crucible_memory_tainted &&
+		!kvm->arch.crucible_clock.continuation.uncertain;
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	if (valid)
+		hrtimer_cancel(&pit->pit_state.timer);
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	valid = valid && !journal->callback_active && !journal->worker_active &&
+		!kvm->arch.crucible_clock.active && !kvm->crucible_irq_input.tainted &&
+		!kvm->crucible_memory_tainted &&
+		!kvm->arch.crucible_clock.continuation.uncertain;
+	if (valid)
+		journal->queued = false;
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	mutex_unlock(&pit->pit_state.lock);
+	if (!valid)
+		pit_native_fault(pit);
+}
+
+void kvm_crucible_pit_resume(struct kvm *kvm)
+{
+	struct kvm_pit *pit = kvm->arch.vpit;
+	struct kvm_crucible_pit_journal *journal;
+	unsigned long flags;
+	ktime_t host;
+	bool valid, queue = false, schedule = false;
+	u32 offset;
+	u64 generation;
+
+	if (!pit || !pit_native_selected(pit))
+		return;
+	journal = &pit->pit_state.crucible;
+	mutex_lock(&pit->pit_state.lock);
+	if (journal->valid)
+		queue = kvm_crucible_clock_host_expiration(kvm, journal->logical, &host);
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	generation = kvm->arch.crucible_clock.window_generation;
+	valid = pit_native_live_locked(kvm) &&
+		kvm->arch.crucible_clock.timer_owners != U32_MAX && !journal->callback_active &&
+		!journal->worker_active && !journal->access_active && !journal->queued &&
+		(!journal->valid ||
+		 journal->generation == kvm->arch.crucible_clock.window_generation);
+	for (offset = 0; valid && offset < journal->count; offset++)
+		valid = journal->pending[(journal->head + offset) % KVM_CRUCIBLE_PIT_PENDING].generation ==
+			kvm->arch.crucible_clock.window_generation;
+	valid = valid && (!journal->awaiting_ack || journal->ack_generation ==
+		kvm->arch.crucible_clock.window_generation);
+	if (valid) {
+		kvm->arch.crucible_clock.timer_owners++;
+		if (queue) {
+			journal->host = host;
+			journal->queued = true;
+		}
+		schedule = pit_native_schedule_locked(pit);
+	}
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	if (valid && queue)
+		hrtimer_start(&pit->pit_state.timer, host, HRTIMER_MODE_ABS);
+	mutex_unlock(&pit->pit_state.lock);
+	if (!valid) {
+		pit_native_fault(pit);
+		return;
+	}
+	if (schedule)
+		kthread_queue_work(pit->worker, &pit->expired);
+
+	/* Queue calls may race a ceiling/Close. Their original lease prevents a
+	 * stopped cut until return; a late effect stays Unknown, never success. */
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	valid = pit_native_live_locked(kvm) &&
+		generation == kvm->arch.crucible_clock.window_generation;
+	if (!valid)
+		kvm_arch_crucible_irq_taint_locked(kvm);
+	kvm->arch.crucible_clock.timer_owners--;
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	wake_up_all(&kvm->crucible_stopped);
+	if (!valid)
+		kvm_vm_dead(kvm);
+}
