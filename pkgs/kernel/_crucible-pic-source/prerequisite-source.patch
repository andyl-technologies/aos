+
+/* Private stack custody for one actual in-kernel device call, not a public
+ * grant or complete IRQ-controller authority. The caller holds its native
+ * device lock during admission and releases it before containment. */
+struct crucible_irq_device_lease {
+	bool entered;
+	u64 generation;
+	u64 invocation;
+};
+
+static bool crucible_irq_device_selected(struct kvm *kvm)
+{
+	return READ_ONCE(kvm->crucible_irq_input.enabled) &&
+		READ_ONCE(kvm->crucible_continuation_roster_frozen);
+}
+
+static bool crucible_irq_device_run_locked(struct kvm *kvm, struct kvm_vcpu *vcpu)
+{
+	lockdep_assert_held(&kvm->crucible_gate_lock);
+	return vcpu && vcpu->kvm == kvm && !in_interrupt() &&
+		!kvm->crucible_irq_input.tainted && !kvm->crucible_memory_tainted &&
+		!kvm->arch.crucible_clock.continuation.uncertain &&
+		kvm_crucible_clock_admission_live(kvm->arch.crucible_clock.active,
+			kvm->crucible_host_ceiling_ns, ktime_get_ns()) &&
+		vcpu->crucible_timer_run_owner == current &&
+		vcpu->crucible_timer_run_invocation &&
+		vcpu->crucible_run_return.outstanding &&
+		vcpu->crucible_timer_run_invocation ==
+			vcpu->crucible_run_return.original.invocation &&
+		vcpu->crucible_run_return.original.native_vcpu_id == vcpu->vcpu_id &&
+		vcpu->crucible_run_return.original.generation_begin ==
+			kvm->arch.crucible_clock.window_generation &&
+		!(vcpu->crucible_run_return.original.flags & KVM_CRUCIBLE_RUN_RETURN_RETURNED);
+}
+
+static bool crucible_irq_device_begin(struct kvm *kvm, struct kvm_vcpu *vcpu,
+	bool original_device, struct crucible_irq_device_lease *lease)
+{
+	unsigned long flags;
+	bool valid;
+
+	lease->entered = false;
+	if (!crucible_irq_device_selected(kvm))
+		return true;
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	valid = original_device && crucible_irq_device_run_locked(kvm, vcpu) &&
+		kvm->crucible_effect_owners != U32_MAX;
+	if (valid) {
+		lease->generation = kvm->arch.crucible_clock.window_generation;
+		lease->invocation = vcpu->crucible_timer_run_invocation;
+		lease->entered = true;
+		kvm->crucible_effect_owners++;
+	} else {
+		kvm_arch_crucible_irq_taint_locked(kvm);
+	}
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	return valid;
+}
+
+/* The native call and all its wake/copy tails have returned. Unknown preserves
+ * earlier effects; this release only lets the stopped-cut owner finish waiting. */
+static int crucible_irq_device_finish(struct kvm *kvm, struct kvm_vcpu *vcpu,
+	struct crucible_irq_device_lease *lease)
+{
+	unsigned long flags;
+	bool valid;
+
+	if (!lease->entered)
+		return 0;
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	valid = crucible_irq_device_run_locked(kvm, vcpu) &&
+		lease->generation == kvm->arch.crucible_clock.window_generation &&
+		lease->invocation == vcpu->crucible_timer_run_invocation;
+	if (!valid)
+		kvm_arch_crucible_irq_taint_locked(kvm);
+	lease->entered = false;
+	kvm->crucible_effect_owners--;
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	wake_up_all(&kvm->crucible_stopped);
+	if (!valid) {
+		kvm_vm_dead(kvm);
+		return -EAGAIN;
+	}
+	return 0;
+}
