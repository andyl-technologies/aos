+/* A native timer refusal must not be delivered as a successful Begin/Resume.
+ * This status applies only to the selected PIT component; old lanes keep zero. */
+static int clock_native_pit_status(struct kvm *kvm)
+{
+#ifdef CONFIG_KVM_IOAPIC
+	unsigned long flags;
+	bool failed = false;
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	if ((kvm->arch.vpit || kvm->arch.vioapic) && kvm->crucible_irq_input.enabled &&
+	    kvm->crucible_continuation_roster_frozen)
+		failed = kvm->crucible_irq_input.tainted || kvm->crucible_memory_tainted ||
+			kvm->arch.crucible_clock.continuation.uncertain;
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	if (failed)
+		return -EIO;
+#endif
+	return 0;
+}
