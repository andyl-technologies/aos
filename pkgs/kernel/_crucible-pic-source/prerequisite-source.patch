+	if (!roster_complete || owners_busy || original_pending ||
+	    state->uncertain || (state->started && !state->terminal))
+		return -EBUSY;
+	if (!generation || generation <= state->generation || start_ns >= end_ns)
+		return -EINVAL;
+	return 0;
