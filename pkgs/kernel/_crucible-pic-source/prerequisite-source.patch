+	if (kvm->arch.vpit) {
+		request->observed_roots |= KVM_CRUCIBLE_INIT_HAS_PIT;
+		request->unsupported_roots |= KVM_CRUCIBLE_INIT_PIT;
+	}
+#endif
+	/* These samples are mutable userspace input, not native architecture values.
+	 * Selected RUN owns a separate immutable branch and ignores later writes.
