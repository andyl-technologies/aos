+/* The notifier owns the original gate before native memory effects. This
+ * freezes the current projection and preserves original generation/history;
+ * it never cancels a safety callback or claims a physical stopped cut. */
+void kvm_arch_crucible_memory_taint_locked(struct kvm *kvm)
+{
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+
+	lockdep_assert_held(&kvm->crucible_gate_lock);
+	if (!kvm->crucible_memory_tainted)
+		kvm->crucible_memory_taint_generation = clock->window_generation;
+	kvm->crucible_memory_tainted = true;
+	if (clock->active) {
+		clock->frozen_ns = clock_now_locked(clock);
+		if (clock->continuation.configured && clock->continuation.started) {
+			kvm_crucible_continuation_account(&clock->continuation,
+				ktime_get_ns() - clock->host_origin_ns, clock->frozen_ns, false);
+		}
+	}
+	/* Unknown never erases elapsed physical budget or permits a later segment. */
+	clock->continuation.uncertain = true;
+	clock->active = false;
+	kvm->crucible_active = false;
+	clock->close_acknowledged = false;
+}
+EXPORT_SYMBOL_FOR_KVM_INTERNAL(kvm_arch_crucible_memory_taint_locked);
