+	native_result = kvm_set_irq(kvm, KVM_USERSPACE_IRQ_SOURCE_ID,
+		request.gsi, request.level, false);
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	input->original.result = native_result;
+	input->original.flags = KVM_CRUCIBLE_IRQ_INPUT_KNOWN;
+	if (!input->claimed || input->tainted || kvm->crucible_memory_tainted) {
+		input->original.flags |= KVM_CRUCIBLE_IRQ_INPUT_UNCERTAIN;
+		kvm_arch_crucible_irq_taint_locked(kvm);
+	}
+	input->known = true;
+	input->inflight = false;
+	input->owner = NULL;
+	request = input->original;
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
