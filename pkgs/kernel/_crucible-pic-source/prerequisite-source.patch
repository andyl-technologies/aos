+
+static bool continuation_roster_lock(struct kvm *kvm, unsigned long *locked,
+	bool pending_allowed)
+{
+	struct kvm_vcpu *vcpu;
+	unsigned long index;
+
+	lockdep_assert_held(&kvm->lock);
+	bitmap_zero(locked, KVM_MAX_VCPUS);
+	if (kvm->created_vcpus != kvm->arch.crucible_clock.continuation.maximum_vcpus ||
+	    kvm->created_vcpus != atomic_read(&kvm->online_vcpus))
+		return false;
+	kvm_for_each_vcpu(index, vcpu, kvm) {
+		if (index >= KVM_MAX_VCPUS || !mutex_trylock(&vcpu->mutex))
+			return false;
+		__set_bit(index, locked);
+		if (!pending_allowed && (vcpu->crucible_run_return.outstanding ||
+		    vcpu->crucible_response.flags ||
+		    kvm_crucible_response_pending(&vcpu->crucible_response) ||
+		    kvm_arch_crucible_run_pending(vcpu)))
+			return false;
+	}
+	return true;
+}
+
+static void continuation_roster_unlock(struct kvm *kvm, unsigned long *locked)
+{
+	struct kvm_vcpu *vcpu;
+	unsigned long index;
+
+	lockdep_assert_held(&kvm->lock);
+	kvm_for_each_vcpu(index, vcpu, kvm)
+		if (index < KVM_MAX_VCPUS && test_bit(index, locked))
+			mutex_unlock(&vcpu->mutex);
+}
