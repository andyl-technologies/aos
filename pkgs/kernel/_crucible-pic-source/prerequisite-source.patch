+	request->mapped_valid_regs = READ_ONCE(vcpu->run->kvm_valid_regs);
+	request->mapped_dirty_regs = READ_ONCE(vcpu->run->kvm_dirty_regs);
+	request->requested_interrupt_window = READ_ONCE(vcpu->run->request_interrupt_window);
