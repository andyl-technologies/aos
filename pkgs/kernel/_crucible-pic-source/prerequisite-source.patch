+	result = count > 0 ? 0 : -EOPNOTSUPP;
+	for (index = 0; index < count; index++) {
+		if (routes[index].type != KVM_IRQ_ROUTING_IRQCHIP)
+			result = -EOPNOTSUPP;
+	}
+	srcu_read_unlock(&kvm->irq_srcu, srcu);
