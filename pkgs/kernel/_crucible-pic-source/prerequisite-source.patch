+	    request->paused || request->terminal || request->stop_acknowledged ||
+	    request->flags || request->reserved)
+		return false;
+	if (request->operation == KVM_CRUCIBLE_CONTINUATION_QUERY)
+		return !request->operation_id && !request->expected_generation &&
+			!request->expected_current_ns && !request->expected_end_ns &&
+			!request->stop_budget_ns && !request->maximum_active_ns &&
+			!request->maximum_resumes && !request->maximum_vcpus;
+	if (!request->operation_id)
+		return false;
+	if (request->operation == KVM_CRUCIBLE_CONTINUATION_CONFIGURE)
+		return !request->expected_generation && !request->expected_current_ns &&
+			!request->expected_end_ns && !request->stop_budget_ns &&
+			request->maximum_vcpus && request->maximum_vcpus <= KVM_MAX_VCPUS;
+	if (request->maximum_active_ns || request->maximum_resumes || request->maximum_vcpus)
+		return false;
+	if (request->operation == KVM_CRUCIBLE_CONTINUATION_PAUSE)
+		return !request->expected_current_ns && request->stop_budget_ns &&
+			request->stop_budget_ns <= 5000000000ULL;
+	return request->operation == KVM_CRUCIBLE_CONTINUATION_RESUME &&
+		!request->stop_budget_ns;
+}
+
+static void continuation_report(struct kvm *kvm,
+	struct kvm_crucible_clock_continuation *request)
+{
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	struct kvm_crucible_continuation_policy *state = &clock->continuation;
+	unsigned long flags;
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	request->generation = clock->window_generation;
+	request->current_ns = clock_now_locked(clock);
+	request->end_ns = clock->end_ns;
+	request->active_ns = state->active_ns;
+	if (clock->active && state->configured) {
+		u64 elapsed = ktime_get_ns() - clock->host_origin_ns;
+
+		if (elapsed <= U64_MAX - state->active_ns)
+			request->active_ns += elapsed;
+		else {
+			request->active_ns = U64_MAX;
+			request->flags |= KVM_CRUCIBLE_CONTINUATION_UNCERTAIN;
+		}
+	}
+	request->resumes = state->resumes;
+	request->active = clock->active;
+	request->paused = state->paused;
+	request->terminal = state->terminal;
+	request->stop_acknowledged = clock->close_acknowledged;
+	request->flags |= state->uncertain ? KVM_CRUCIBLE_CONTINUATION_UNCERTAIN : 0;
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+}
+
+int kvm_crucible_clock_continuation_control(struct kvm *kvm, struct kvm_enable_cap *cap)
+{
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	struct kvm_crucible_continuation_policy *state = &clock->continuation;
+	struct kvm_crucible_clock_continuation request, original;
+	void __user *user = u64_to_user_ptr(cap->args[0]);
+	DECLARE_BITMAP(locked, KVM_MAX_VCPUS);
+	unsigned long flags, memory_flags;
+	u64 now, projected, deadline;
+	bool changed = false, roster;
+	int result, waited;
