+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Original guest IPI births travel explicitly through destination delivery.
+ * Other producer classes need separate joins; a task/active VM is insufficient. */
+
+struct crucible_apic_birth {
+	struct kvm_vcpu *source;
+	struct kvm_lapic_irq irq;
+	u64 generation, invocation, sequence;
+	u64 host_ns, logical_ns;
+	bool selected;
+	u32 kind;
+	struct kvm_crucible_pit_irq_birth pit;
+};
+
+static void crucible_apic_refuse(struct kvm *kvm)
+{
+	unsigned long flags;
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	kvm_arch_crucible_irq_taint_locked(kvm);
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	kvm_vm_dead(kvm);
+}
+
+static bool crucible_apic_geometry_equal(const struct kvm_lapic_irq *a,
+	const struct kvm_lapic_irq *b)
+{
+	return a->vector == b->vector && a->delivery_mode == b->delivery_mode &&
+		a->dest_mode == b->dest_mode && a->dest_id == b->dest_id &&
+		a->level == b->level && a->trig_mode == b->trig_mode &&
+		a->shorthand == b->shorthand && a->msi_redir_hint == b->msi_redir_hint;
+}
+
+static bool crucible_apic_birth_begin(struct kvm *kvm, struct kvm_lapic *src,
+	struct kvm_lapic_irq *irq, struct crucible_apic_birth *birth)
+{
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	struct kvm_lapic_irq original;
+	unsigned long flags;
+	bool valid;
+
+	birth->selected = crucible_ipi_selected(kvm);
+	if (!birth->selected)
+		return true;
+	if (!src || src->vcpu->kvm != kvm || src != src->vcpu->arch.apic) {
+		crucible_apic_refuse(kvm);
+		return false;
+	}
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	valid = crucible_ipi_run_locked(src->vcpu) &&
+		src->vcpu->crucible_ipi.active &&
+		src->vcpu->crucible_ipi.generation == clock->window_generation &&
+		src->vcpu->crucible_ipi.invocation == src->vcpu->crucible_timer_run_invocation &&
+		src->vcpu->crucible_ipi.sequence && kvm->crucible_effect_owners;
+	if (valid) {
+		kvm_icr_to_lapic_irq(src, src->vcpu->crucible_ipi.icr_low,
+			src->vcpu->crucible_ipi.icr_high, &original);
+		valid = crucible_apic_geometry_equal(irq, &original) &&
+			!irq->msi_redir_hint &&
+			(irq->delivery_mode == APIC_DM_FIXED || irq->delivery_mode == APIC_DM_LOWEST) &&
+			/* The legacy lowest broadcast rewrite changes original geometry. */
+			!(irq->delivery_mode == APIC_DM_LOWEST &&
+			  irq->dest_mode == APIC_DEST_PHYSICAL && irq->dest_id == 0xff);
+	}
+	if (valid) {
+		birth->kind = 1;
+		birth->source = src->vcpu;
+		birth->irq = *irq;
+		birth->generation = clock->window_generation;
+		birth->invocation = src->vcpu->crucible_ipi.invocation;
+		birth->sequence = src->vcpu->crucible_ipi.sequence;
+		birth->host_ns = ktime_get_ns();
+		birth->logical_ns = kvm_crucible_clock_project(birth->host_ns - clock->host_origin_ns,
+			clock->continuation.configured && clock->continuation.started ?
+			clock->continuation.projection_origin_ns : clock->start_ns,
+			clock->end_ns, clock->numerator, clock->denominator);
+	} else {
+		kvm_arch_crucible_irq_taint_locked(kvm);
+	}
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	if (!valid)
+		kvm_vm_dead(kvm);
+	return valid;
+}
+
+static bool crucible_apic_birth_live_locked(struct kvm *kvm,
+	struct crucible_apic_birth *birth)
+{
+	lockdep_assert_held(&kvm->crucible_gate_lock);
+	if (birth && birth->selected && birth->kind == 2)
+		return kvm_arch_crucible_pit_irq_birth_live_locked(kvm, &birth->pit) &&
+			!birth->pit.phase && birth->generation == birth->pit.generation &&
+			birth->invocation == birth->pit.invocation &&
+			birth->sequence == birth->pit.sequence;
+	return birth && birth->selected && birth->kind == 1 && birth->source && birth->source->kvm == kvm &&
+		crucible_ipi_run_locked(birth->source) && birth->source->crucible_ipi.active &&
+		birth->generation == kvm->arch.crucible_clock.window_generation &&
+		birth->invocation == birth->source->crucible_ipi.invocation &&
+		birth->sequence == birth->source->crucible_ipi.sequence &&
+		kvm->crucible_effect_owners;
+}
+
+static bool crucible_apic_target_begin(struct kvm_lapic *apic,
+	struct crucible_apic_birth *birth, int mode, int vector, int level,
+	int trig_mode, struct rtc_status *rtc_status, bool *retained)
+{
+	struct kvm_vcpu *vcpu = apic->vcpu;
+	struct kvm *kvm = vcpu->kvm;
+	struct kvm_crucible_apic_vector *row = NULL;
+	unsigned long flags;
+	bool valid;
+
+	*retained = false;
+	if (!crucible_ipi_selected(kvm))
+		return true;
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	valid = crucible_apic_birth_live_locked(kvm, birth) &&
+		vector >= 16 && vector < 256 && mode == birth->irq.delivery_mode &&
+		vector == birth->irq.vector && level == birth->irq.level &&
+		trig_mode == birth->irq.trig_mode && !rtc_status &&
+		kvm_apic_match_dest(vcpu, birth->kind == 1 ? birth->source->arch.apic : NULL,
+			birth->irq.shorthand,
+			birth->irq.dest_id, birth->irq.dest_mode) &&
+		!apic->apicv_active && !apic->guest_apic_protected && !is_guest_mode(vcpu) &&
+		apic_enabled(apic) && !(trig_mode && !level) &&
+		vcpu->crucible_apic_target.issued < CRUCIBLE_APIC_TARGET_TOTAL;
+	if (valid) {
+		row = &vcpu->crucible_apic_target.vectors[vector];
+		/* Never coalesce two births or reuse a still-active service vector. */
+		valid = (!row->phase || row->phase == CRUCIBLE_APIC_CONSUMED) &&
+			!apic_test_vector(vector, apic->regs + APIC_IRR) &&
+			!apic_test_vector(vector, apic->regs + APIC_ISR);
+	}
+	if (valid) {
+		row->generation = birth->generation;
+		row->source_invocation = birth->invocation;
+		row->source_sequence = birth->sequence;
+		row->source_kind = birth->kind;
+		row->source_id = birth->kind == 1 ? birth->source->vcpu_id : birth->pit.native_vcpu_id;
+		row->target_id = vcpu->vcpu_id;
+		row->birth_host_ns = birth->host_ns;
+		row->birth_logical_ns = birth->logical_ns;
+		row->icr_low = birth->kind == 1 ? birth->source->crucible_ipi.icr_low : 0;
+		row->icr_high = birth->kind == 1 ? birth->source->crucible_ipi.icr_high : 0;
+		row->source_route_bits = birth->kind == 2 ? birth->pit.route_bits : 0;
+		row->consume_invocation = 0;
+		row->phase = CRUCIBLE_APIC_RESERVED;
+		vcpu->crucible_apic_target.issued++;
+		*retained = true;
+	} else {
+		kvm_arch_crucible_irq_taint_locked(kvm);
+	}
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	if (!valid)
+		kvm_vm_dead(kvm);
+	return valid;
+}
+
+static int crucible_apic_target_finish(struct kvm_lapic *apic,
+	struct crucible_apic_birth *birth, int vector, bool retained, int result)
+{
+	struct kvm_vcpu *vcpu = apic->vcpu;
+	struct kvm *kvm = vcpu->kvm;
+	struct kvm_crucible_apic_vector *row;
+	unsigned long flags;
+	bool valid;
+
+	if (!retained)
+		return result;
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	row = &vcpu->crucible_apic_target.vectors[vector];
+	valid = crucible_apic_birth_live_locked(kvm, birth) && result == 1 &&
+		row->phase == CRUCIBLE_APIC_RESERVED && row->generation == birth->generation &&
+		row->source_sequence == birth->sequence && row->source_invocation == birth->invocation &&
+		row->source_kind == birth->kind &&
+		row->source_id == (birth->kind == 1 ? birth->source->vcpu_id : birth->pit.native_vcpu_id) &&
+		row->source_route_bits == (birth->kind == 2 ? birth->pit.route_bits : 0) &&
+		row->target_id == vcpu->vcpu_id &&
+		apic_test_vector(vector, apic->regs + APIC_IRR);
+	row->phase = valid ? CRUCIBLE_APIC_PENDING : CRUCIBLE_APIC_UNKNOWN;
+	if (!valid)
+		kvm_arch_crucible_irq_taint_locked(kvm);
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	if (!valid) {
+		kvm_vm_dead(kvm);
+		return -EAGAIN;
+	}
+	return result;
+}
+
+static bool crucible_apic_consume_begin(struct kvm_vcpu *vcpu, int vector)
+{
+	struct kvm *kvm = vcpu->kvm;
+	struct kvm_lapic *apic = vcpu->arch.apic;
+	struct kvm_crucible_apic_vector *row;
+	unsigned long flags;
+	bool valid;
+
+	if (!crucible_ipi_selected(kvm))
+		return true;
+	lockdep_assert_held(&vcpu->mutex);
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	valid = crucible_ipi_run_locked(vcpu) && vector >= 16 && vector < 256 && apic &&
+		!apic->apicv_active && !apic->guest_apic_protected && !is_guest_mode(vcpu) &&
+		!kvm_hv_synic_auto_eoi_set(vcpu, vector) &&
+		vcpu->crucible_apic_target.injection_active &&
+		vcpu->crucible_apic_target.injection_invocation == vcpu->crucible_timer_run_invocation &&
+		!vcpu->crucible_apic_target.consuming && kvm->crucible_effect_owners;
+	if (valid) {
+		row = &vcpu->crucible_apic_target.vectors[vector];
+		valid = row->phase == CRUCIBLE_APIC_PENDING &&
+			row->generation == kvm->arch.crucible_clock.window_generation &&
+			row->target_id == vcpu->vcpu_id && row->source_invocation && row->source_sequence &&
+			apic_test_vector(vector, apic->regs + APIC_IRR) &&
+			!apic_test_vector(vector, apic->regs + APIC_ISR);
+		if (valid) {
+			row->phase = CRUCIBLE_APIC_CONSUMING;
+			row->consume_invocation = vcpu->crucible_timer_run_invocation;
+			vcpu->crucible_apic_target.consuming = true;
+			vcpu->crucible_apic_target.consuming_vector = vector;
+		}
+	}
+	if (!valid)
+		kvm_arch_crucible_irq_taint_locked(kvm);
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	if (!valid)
+		kvm_vm_dead(kvm);
+	return valid;
+}
+
+/* Called while the original injection owner still holds the stopped-cut credit.
+ * A known tail return is not a proof that the guest accepted/delivered an IRQ. */
+bool kvm_crucible_apic_injection_finish_locked(struct kvm_vcpu *vcpu, bool injected)
+{
+	struct kvm *kvm = vcpu->kvm;
+	struct kvm_crucible_apic_vector *row;
+	int vector;
+	bool valid;
+
+	lockdep_assert_held(&kvm->crucible_gate_lock);
+	if (!vcpu->crucible_apic_target.consuming)
+		return true;
+	vector = vcpu->crucible_apic_target.consuming_vector;
+	if (vector < 16 || vector >= 256) {
+		kvm_arch_crucible_irq_taint_locked(kvm);
+		return false;
+	}
+	row = &vcpu->crucible_apic_target.vectors[vector];
+	valid = injected && crucible_ipi_run_locked(vcpu) &&
+		row->phase == CRUCIBLE_APIC_CONSUMING && row->target_id == vcpu->vcpu_id &&
+		row->generation == kvm->arch.crucible_clock.window_generation &&
+		row->consume_invocation == vcpu->crucible_timer_run_invocation &&
+		!apic_test_vector(vector, vcpu->arch.apic->regs + APIC_IRR) &&
+		apic_test_vector(vector, vcpu->arch.apic->regs + APIC_ISR);
+	row->phase = valid ? CRUCIBLE_APIC_CONSUMED : CRUCIBLE_APIC_UNKNOWN;
+	vcpu->crucible_apic_target.consuming = false;
+	if (!valid)
+		kvm_arch_crucible_irq_taint_locked(kvm);
+	return valid;
+}
+EXPORT_SYMBOL_FOR_KVM_INTERNAL(kvm_crucible_apic_injection_finish_locked);
