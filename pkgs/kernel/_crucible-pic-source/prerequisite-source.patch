+	    request.expected_end_ns != state->original_end_ns ||
+	    clock->window_generation != state->generation ||
+	    clock->start_ns != state->original_start_ns ||
+	    clock->end_ns != state->original_end_ns ||
+	    (request.operation == KVM_CRUCIBLE_CONTINUATION_RESUME &&
+	     clock->frozen_ns != state->projection_origin_ns)) {
+		result = -ESTALE;
+		goto unlock_vm;
+	}
+	if (request.operation == KVM_CRUCIBLE_CONTINUATION_RESUME) {
+		roster = continuation_roster_lock(kvm, locked, false);
+		spin_lock_irqsave(&kvm->mn_invalidate_lock, memory_flags);
+		raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+		result = kvm_crucible_continuation_resume_policy(state,
+			request.expected_generation, request.expected_current_ns,
+			request.expected_end_ns, !roster || clock->active ||
