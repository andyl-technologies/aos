+			clock->host_ceiling_ns = deadline;
+			kvm->crucible_host_ceiling_ns = deadline;
+			clock->close_acknowledged = false;
+			clock->active = true;
+			kvm->crucible_active = true;
+			changed = true;
+		}
+		raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+		spin_unlock_irqrestore(&kvm->mn_invalidate_lock, memory_flags);
+		if (!result) {
+			hrtimer_start(&clock->ceiling_timer, ns_to_ktime(deadline), HRTIMER_MODE_ABS_HARD);
+			CONTINUATION_TIMER_RESUME(kvm);
+#ifdef CONTINUATION_TIMER_STATUS
+			result = CONTINUATION_TIMER_STATUS(kvm);
+#endif
+		}
+		continuation_roster_unlock(kvm, locked);
+		goto unlock_vm;
+	}
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	if (!clock->active || state->paused || state->terminal) {
+		result = -EBUSY;
+	} else {
+		projected = clock_now_locked(clock);
+		result = kvm_crucible_continuation_account(state,
+			ktime_get_ns() - clock->host_origin_ns, projected, false);
+		clock->frozen_ns = projected;
+		clock->active = false;
+		kvm->crucible_active = false;
+		clock->close_acknowledged = false;
+		changed = true;
+	}
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	mutex_unlock(&kvm->lock);
+	if (!changed)
+		goto report;
+	hrtimer_cancel(&clock->ceiling_timer);
+	kvm_make_all_cpus_request(kvm, CONTINUATION_EVENT);
+	waited = wait_event_interruptible_hrtimeout(kvm->crucible_stopped,
+		!READ_ONCE(clock->run_owners) && !READ_ONCE(clock->timer_owners) &&
+		!READ_ONCE(kvm->crucible_effect_owners) &&
+		!(READ_ONCE(kvm->crucible_memory_notifier_owners) ||
+		  (READ_ONCE(kvm->crucible_irq_input.enabled) &&
+		   READ_ONCE(kvm->crucible_irq_input.owners))), ns_to_ktime(request.stop_budget_ns));
+	if (waited)
+		result = waited == -ETIME ? -ETIMEDOUT : waited;
+	if (!result)
+		CONTINUATION_TIMER_FREEZE(kvm);
+	if (!mutex_trylock(&kvm->lock)) {
+		raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+		state->uncertain = true;
+		raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+		result = -EBUSY;
+		goto report;
+	}
+	roster = continuation_roster_lock(kvm, locked, true);
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	if (!result && roster && !clock->run_owners && !clock->timer_owners &&
+	    !kvm->crucible_effect_owners && !(kvm->crucible_memory_notifier_owners ||
+	                                      (kvm->crucible_irq_input.enabled &&
+	                                       kvm->crucible_irq_input.owners)) &&
+	    !(kvm->crucible_memory_tainted ||
+	      (kvm->crucible_irq_input.enabled &&
+	       kvm->crucible_irq_input.tainted)))
+		clock->close_acknowledged = true;
+	else {
+		if (!result)
+			result = -EBUSY;
+		state->uncertain = true;
+	}
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	continuation_roster_unlock(kvm, locked);
+unlock_vm:
+	mutex_unlock(&kvm->lock);
+report:
+	continuation_report(kvm, &request);
+	if (changed) {
+		state->last_request = original;
+		state->last_result = request;
+		state->last_status = result;
+	}
+deliver:
+	mutex_unlock(&kvm->crucible_configuration_lock);
+	mutex_unlock(&clock->control_lock);
+	if (copy_to_user(user, &request, sizeof(request)))
+		return -EFAULT;
+	return result;
+}
