+/* The source projection is original logical time, never a new HZ grant.
+ * Rounding up a native jiffy may delay effects; it cannot move them earlier. */
+static bool ioapic_native_queue_locked(struct kvm_ioapic *ioapic)
+{
+	struct kvm *kvm = ioapic->kvm;
+	struct kvm_crucible_eoi_journal *journal = &ioapic->crucible_eoi;
+	ktime_t logical = KTIME_MAX, host;
+	u64 now;
+	unsigned long delay;
+	int pin;
+
+	if (journal->queued || journal->active)
+		return true;
+	for (pin = 0; pin < IOAPIC_NUM_PINS; pin++) {
+		if (journal->rows[pin].pending)
+			logical = min(logical, journal->rows[pin].logical);
+	}
+	if (logical == KTIME_MAX ||
+	    !kvm_crucible_clock_host_expiration(kvm, logical, &host))
+		return true;
+	now = ktime_get_ns();
+	delay = host > now ? nsecs_to_jiffies64(host - now) + 1 : 0;
+	journal->queued = true;
+	journal->queued_generation = kvm->arch.crucible_clock.window_generation;
