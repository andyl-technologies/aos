+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+
+	lockdep_assert_held(&kvm->crucible_gate_lock);
+	if (!kvm->crucible_irq_input.taint_generation)
+		kvm->crucible_irq_input.taint_generation = clock->window_generation;
+	kvm->crucible_irq_input.tainted = true;
+	if (clock->active) {
+		clock->frozen_ns = clock_now_locked(clock);
+		if (clock->continuation.configured && clock->continuation.started) {
+			kvm_crucible_continuation_account(&clock->continuation,
+				ktime_get_ns() - clock->host_origin_ns, clock->frozen_ns, false);
+		}
+	}
+	/* Unknown never erases elapsed physical budget or permits a later segment. */
+	clock->continuation.uncertain = true;
+	clock->active = false;
+	kvm->crucible_active = false;
+	clock->close_acknowledged = false;
+}
+EXPORT_SYMBOL_FOR_KVM_INTERNAL(kvm_arch_crucible_irq_taint_locked);
 
