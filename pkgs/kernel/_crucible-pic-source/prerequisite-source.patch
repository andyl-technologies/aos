+/* Clock completion joins both native timer families. Pending PIT expiry/ACK
+ * records survive Pause; Resume maps only their retained same-generation arm. */
+static void clock_native_timers_freeze(struct kvm *kvm)
+{
+	kvm_crucible_lapic_freeze(kvm);
+	kvm_crucible_pit_freeze(kvm);
+#ifdef CONFIG_KVM_IOAPIC
+	kvm_crucible_ioapic_freeze(kvm);
+#endif
+}
+
+static void clock_native_timers_resume(struct kvm *kvm)
+{
+	kvm_crucible_lapic_resume(kvm);
+	kvm_crucible_pit_resume(kvm);
+#ifdef CONFIG_KVM_IOAPIC
+	kvm_crucible_ioapic_resume(kvm);
+#endif
+}
