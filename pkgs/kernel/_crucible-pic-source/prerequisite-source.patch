+static bool lapic_is_periodic(struct kvm_lapic *apic);
+static void advance_periodic_target_expiration(struct kvm_lapic *apic);
+
+static bool lapic_timer_ancestry_selected(struct kvm_lapic *apic)
+{
+	return READ_ONCE(apic->vcpu->kvm->crucible_irq_input.enabled) &&
+		READ_ONCE(apic->vcpu->kvm->crucible_continuation_roster_frozen);
+}
+
+static bool lapic_timer_original_run_locked(struct kvm_lapic *apic)
+{
+	struct kvm_vcpu *vcpu = apic->vcpu;
+	struct kvm_crucible_run_return_state *run = &vcpu->crucible_run_return;
+	struct kvm_crucible_clock_domain *clock = &vcpu->kvm->arch.crucible_clock;
+
+	lockdep_assert_held(&vcpu->kvm->crucible_gate_lock);
+	return kvm_crucible_clock_admission_live(clock->active,
+		vcpu->kvm->crucible_host_ceiling_ns, ktime_get_ns()) &&
+		!in_interrupt() && vcpu->arch.apic == apic &&
+		vcpu->crucible_timer_run_owner == current &&
+		vcpu->crucible_timer_run_invocation && run->outstanding &&
+		vcpu->crucible_timer_run_invocation == run->original.invocation &&
+		run->original.native_vcpu_id == vcpu->vcpu_id &&
+		run->original.generation_begin == clock->window_generation &&
+		!(run->original.flags & KVM_CRUCIBLE_RUN_RETURN_RETURNED);
+}
+
+static void lapic_timer_original_fault(struct kvm_lapic *apic)
+{
+	struct kvm *kvm = apic->vcpu->kvm;
+	unsigned long flags;
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	kvm_arch_crucible_irq_taint_locked(kvm);
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	/* Native containment follows the gate release, never an inverted lock. */
+	kvm_vm_dead(kvm);
+}
+
+static bool lapic_timer_original_prepare_write(struct kvm_lapic *apic)
+{
+	struct kvm *kvm = apic->vcpu->kvm;
+	struct kvm_timer *timer = &apic->lapic_timer;
+	unsigned long flags;
+	bool valid;
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	valid = lapic_timer_original_run_locked(apic) &&
+		!timer->crucible_callback_active && !kvm->crucible_irq_input.tainted &&
+		timer->crucible_arm_sequence != U64_MAX;
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	if (!valid || hrtimer_try_to_cancel(&timer->timer) < 0) {
+		lapic_timer_original_fault(apic);
+		return false;
+	}
+
+	/* Cancel the actual old native queue before guest fields can be changed.
+	 * A running callback is not relabeled with a later programmed deadline. */
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	valid = lapic_timer_original_run_locked(apic) &&
+		!timer->crucible_callback_active && !kvm->crucible_irq_input.tainted &&
+		timer->crucible_arm_sequence != U64_MAX;
+	if (valid)
+		timer->crucible_arm_queued = false;
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	if (!valid)
+		lapic_timer_original_fault(apic);
+	return valid;
+}
+
+static bool lapic_timer_original_start(struct kvm_lapic *apic, ktime_t host)
+{
+	struct kvm_vcpu *vcpu = apic->vcpu;
+	struct kvm *kvm = vcpu->kvm;
+	struct kvm_timer *timer = &apic->lapic_timer;
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	unsigned long flags;
+	bool run, resume, valid;
+
+	/* Authenticate before cancelling the native queue; a foreign caller
+	 * cannot consume even a mechanical timer effect. Revalidate afterward. */
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	run = lapic_timer_original_run_locked(apic);
+	resume = !in_interrupt() && timer->crucible_resume_owner == current &&
+		timer->crucible_arm_valid &&
+		timer->crucible_arm_generation == clock->window_generation &&
+		timer->crucible_arm_logical == timer->target_expiration;
+	valid = (run || resume) &&
+		kvm_crucible_clock_admission_live(clock->active,
+			kvm->crucible_host_ceiling_ns, ktime_get_ns()) &&
+		!kvm->crucible_irq_input.tainted && !timer->crucible_callback_active &&
+		timer->target_expiration >= 0 && host >= 0 &&
+		timer->crucible_arm_sequence != U64_MAX;
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	if (!valid || hrtimer_try_to_cancel(&timer->timer) < 0) {
+		lapic_timer_original_fault(apic);
+		return false;
+	}
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	run = lapic_timer_original_run_locked(apic);
+	resume = !in_interrupt() && timer->crucible_resume_owner == current &&
+		timer->crucible_arm_valid &&
+		timer->crucible_arm_generation == clock->window_generation &&
+		timer->crucible_arm_logical == timer->target_expiration;
+	valid = (run || resume) &&
+		kvm_crucible_clock_admission_live(clock->active,
+			kvm->crucible_host_ceiling_ns, ktime_get_ns()) &&
+		!kvm->crucible_irq_input.tainted && !timer->crucible_callback_active &&
+		timer->target_expiration >= 0 && host >= 0 &&
+		timer->crucible_arm_sequence != U64_MAX;
+	if (valid) {
+		timer->crucible_arm_sequence++;
+		timer->crucible_arm_generation = clock->window_generation;
+		if (run)
+			timer->crucible_arm_invocation = vcpu->crucible_timer_run_invocation;
+		timer->crucible_arm_logical = timer->target_expiration;
+		timer->crucible_arm_host = host;
+		timer->crucible_arm_valid = true;
+		timer->crucible_arm_queued = true;
+	}
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	if (!valid) {
+		lapic_timer_original_fault(apic);
+		return false;
+	}
+
+	/* Original lineage precedes the actual native timer publication. Closing
+	 * still waits for the original RUN and cancels the actual timer roster. */
+	hrtimer_start(&timer->timer, host, HRTIMER_MODE_ABS_HARD);
+	return true;
+}
+
+/* Native CPU migration relocates an existing arm; it never creates a new
+ * guest deadline, arm sequence, generation, or birth invocation. */
+static bool lapic_timer_original_migrate(struct kvm_lapic *apic)
+{
+	struct kvm *kvm = apic->vcpu->kvm;
+	struct kvm_timer *timer = &apic->lapic_timer;
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	unsigned long flags;
+	u64 sequence, generation, birth_invocation;
+	ktime_t logical, host;
+	bool valid, idle;
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	idle = !timer->crucible_arm_queued && !timer->crucible_callback_active &&
+		!hrtimer_active(&timer->timer);
+	sequence = timer->crucible_arm_sequence;
+	generation = timer->crucible_arm_generation;
+	birth_invocation = timer->crucible_arm_invocation;
+	logical = timer->crucible_arm_logical;
+	host = timer->crucible_arm_host;
+	valid = lapic_timer_original_run_locked(apic) &&
+		!kvm->crucible_irq_input.tainted && !timer->crucible_callback_active &&
+		timer->crucible_arm_valid && timer->crucible_arm_queued && sequence &&
+		birth_invocation && generation == clock->window_generation &&
+		logical == timer->target_expiration &&
+		host == hrtimer_get_expires(&timer->timer);
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	if (idle)
+		return true;
+	if (!valid || hrtimer_try_to_cancel(&timer->timer) != 1) {
+		lapic_timer_original_fault(apic);
+		return false;
+	}
+
+	/* A completed callback or changed arm is not relabeled as this migration.
+	 * Uncertainty remains contained rather than requeueing old guest work. */
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	valid = lapic_timer_original_run_locked(apic) &&
+		!kvm->crucible_irq_input.tainted && !timer->crucible_callback_active &&
+		timer->crucible_arm_valid && timer->crucible_arm_queued &&
+		timer->crucible_arm_sequence == sequence &&
+		timer->crucible_arm_generation == generation &&
+		timer->crucible_arm_invocation == birth_invocation &&
+		generation == clock->window_generation &&
+		timer->crucible_arm_logical == logical &&
+		timer->target_expiration == logical &&
+		timer->crucible_arm_host == host &&
+		hrtimer_get_expires(&timer->timer) == host;
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	if (!valid) {
+		lapic_timer_original_fault(apic);
+		return false;
+	}
+
+	/* Closing waits for the original native RUN before cancelling its roster. */
+	hrtimer_start(&timer->timer, host, HRTIMER_MODE_ABS_HARD);
+	return true;
+}
+
+static enum hrtimer_restart lapic_timer_original_expire(struct kvm_lapic *apic)
+{
+	struct kvm *kvm = apic->vcpu->kvm;
+	struct kvm_timer *timer = &apic->lapic_timer;
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	unsigned long flags;
+	ktime_t host;
+	bool valid, closed;
+	enum hrtimer_restart result = HRTIMER_NORESTART;
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	valid = apic->vcpu->arch.apic == apic && timer->crucible_arm_valid &&
+		timer->crucible_arm_queued && timer->crucible_arm_sequence &&
+		timer->crucible_arm_invocation && !timer->crucible_callback_active &&
+		timer->crucible_arm_generation == clock->window_generation &&
+		timer->crucible_arm_logical == timer->target_expiration &&
+		timer->crucible_arm_host == hrtimer_get_expires(&timer->timer) &&
+		!kvm->crucible_irq_input.tainted;
+	closed = valid && !kvm_crucible_clock_admission_live(clock->active,
+		kvm->crucible_host_ceiling_ns, ktime_get_ns());
+	if (closed)
+		timer->crucible_arm_queued = false;
+	valid = valid && !closed && clock->timer_owners != U32_MAX &&
+		(!lapic_is_periodic(apic) || timer->crucible_arm_sequence != U64_MAX) &&
+		timer->crucible_arm_logical >= 0 &&
+		kvm_crucible_clock_project(ktime_get_ns() - clock->host_origin_ns,
+			clock->continuation.started ?
+			clock->continuation.projection_origin_ns : clock->start_ns,
+			clock->end_ns, clock->numerator, clock->denominator) >=
+			ktime_to_ns(timer->crucible_arm_logical);
+	if (valid) {
+		timer->crucible_arm_queued = false;
+		timer->crucible_callback_active = true;
+		timer->crucible_callback_owner = current;
+		clock->timer_owners++;
+	}
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	if (!valid) {
+		/* A legitimate close can win before this callback; no delivery occurs.
+		 * A stale/foreign arm retains uncertainty and faults the original VM. */
+		if (!closed)
+			lapic_timer_original_fault(apic);
+		return HRTIMER_NORESTART;
+	}
+
+	apic_timer_expired(apic, true);
+	if (lapic_is_periodic(apic) && timer->period) {
+		advance_periodic_target_expiration(apic);
+		/* Preserve the next original logical target even when a lawful close
+		 * wins before native rearm. This is pending lineage, not a queue birth. */
+		raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+		valid = !kvm->crucible_irq_input.tainted &&
+			timer->crucible_callback_owner == current &&
+			timer->crucible_callback_active &&
+			timer->crucible_arm_generation == clock->window_generation &&
+			timer->crucible_arm_sequence != U64_MAX &&
+			timer->target_expiration >= 0;
+		if (valid) {
+			timer->crucible_arm_sequence++;
+			timer->crucible_arm_logical = timer->target_expiration;
+		}
+		raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+		if (!valid) {
+			lapic_timer_original_fault(apic);
+		} else if (lapic_timer_host_expiration(apic, timer->target_expiration, &host)) {
+			raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+			if (kvm_crucible_clock_admission_live(clock->active,
+				kvm->crucible_host_ceiling_ns, ktime_get_ns()) &&
+			    !kvm->crucible_irq_input.tainted &&
+			    timer->crucible_callback_owner == current &&
+			    timer->crucible_arm_generation == clock->window_generation &&
+			    timer->crucible_arm_logical == timer->target_expiration) {
+				timer->crucible_arm_host = host;
+				timer->crucible_arm_queued = true;
+				hrtimer_set_expires(&timer->timer, host);
+				result = HRTIMER_RESTART;
+			}
+			raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+		}
+	}
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	timer->crucible_callback_active = false;
+	timer->crucible_callback_owner = NULL;
+	clock->timer_owners--;
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	wake_up_all(&kvm->crucible_stopped);
+	return result;
+}
