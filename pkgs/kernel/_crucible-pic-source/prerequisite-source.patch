+	    request.operation_id == state->last_request.operation_id) {
+		if (memcmp(&request, &state->last_request, sizeof(request))) {
+			result = -ESTALE;
+			goto report;
+		}
+		request = state->last_result;
+		result = state->last_status;
+		goto deliver;
+	}
+	if (request.operation != KVM_CRUCIBLE_CONTINUATION_QUERY &&
+	    (state->last_request.operation_id == U64_MAX ||
+	     request.operation_id != state->last_request.operation_id + 1)) {
+		result = -ESTALE;
+		goto report;
+	}
+	if (request.operation == KVM_CRUCIBLE_CONTINUATION_QUERY) {
+		result = state->configured ? 0 : -ENOENT;
+		goto report;
+	}
