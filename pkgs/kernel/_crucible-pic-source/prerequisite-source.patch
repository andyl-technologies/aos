+	irq_input_roster_unlock(kvm, locked);
+	mutex_unlock(&kvm->lock);
+	if (result)
+		goto unlock_configuration;
+copy_reply:
+	/* Cache is finished before copyout; failure retains the original result. */
+	if (copy_to_user(user, &request, sizeof(request)))
+		result = -EFAULT;
+unlock_configuration:
+	mutex_unlock(&kvm->crucible_configuration_lock);
+	mutex_unlock(&clock->control_lock);
+	return result;
+}
