+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef KVM_CRUCIBLE_IPI_SOURCE_H
+#define KVM_CRUCIBLE_IPI_SOURCE_H
+
+/* This synchronous producer does not authorize delayed INIT/SIPI/NMI/SMI
+ * consumers, a userspace input, or an independently entered LAPIC callback. */
+#define KVM_CRUCIBLE_IPI_PER_RUN 4096U
+#define KVM_CRUCIBLE_IPI_TOTAL 65536ULL
+
+static bool crucible_ipi_selected(struct kvm *kvm)
+{
+	return READ_ONCE(kvm->crucible_irq_input.enabled) &&
+		READ_ONCE(kvm->crucible_continuation_roster_frozen);
+}
+
+static bool crucible_ipi_run_locked(struct kvm_vcpu *vcpu)
+{
+	struct kvm *kvm = vcpu->kvm;
+
+	lockdep_assert_held(&kvm->crucible_gate_lock);
+	return !in_interrupt() &&
+		!kvm->crucible_irq_input.tainted && !kvm->crucible_memory_tainted &&
+		!kvm->arch.crucible_clock.continuation.uncertain &&
+		kvm_crucible_clock_admission_live(kvm->arch.crucible_clock.active,
+			kvm->crucible_host_ceiling_ns, ktime_get_ns()) &&
+		vcpu->crucible_timer_run_owner == current &&
+		vcpu->crucible_timer_run_invocation &&
+		vcpu->crucible_run_return.outstanding &&
+		vcpu->crucible_timer_run_invocation ==
+			vcpu->crucible_run_return.original.invocation &&
+		vcpu->crucible_run_return.original.native_vcpu_id == vcpu->vcpu_id &&
+		vcpu->crucible_run_return.original.generation_begin ==
+			kvm->arch.crucible_clock.window_generation &&
+		!(vcpu->crucible_run_return.original.flags & KVM_CRUCIBLE_RUN_RETURN_RETURNED);
+}
+
+static bool crucible_ipi_begin(struct kvm_vcpu *vcpu, u32 icr_low,
+	u32 icr_high, bool *retained)
+{
+	struct kvm *kvm = vcpu->kvm;
+	unsigned long flags;
+	u32 mode = icr_low & APIC_MODE_MASK;
+	bool valid;
+
+	*retained = false;
+	if (!crucible_ipi_selected(kvm))
+		return true;
+	lockdep_assert_held(&vcpu->mutex);
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	valid = crucible_ipi_run_locked(vcpu) && !vcpu->crucible_ipi.active &&
+		(!vcpu->crucible_ipi.sequence || vcpu->crucible_ipi.known) &&
+		vcpu->crucible_ipi.sequence < KVM_CRUCIBLE_IPI_TOTAL &&
+		kvm->crucible_effect_owners != U32_MAX &&
+		(mode == APIC_DM_FIXED || mode == APIC_DM_LOWEST) &&
+		(icr_low & APIC_VECTOR_MASK) >= 16 && !(icr_low & APIC_ICR_BUSY);
+
+	/* A new original RUN may acquire fresh per-RUN credit only after the
+	 * prior synchronous result became known. Lifetime credit never resets. */
+	if (valid && (vcpu->crucible_ipi.generation !=
+		kvm->arch.crucible_clock.window_generation ||
+		vcpu->crucible_ipi.invocation != vcpu->crucible_timer_run_invocation))
+		vcpu->crucible_ipi.run_count = 0;
+	if (valid && vcpu->crucible_ipi.run_count >= KVM_CRUCIBLE_IPI_PER_RUN)
+		valid = false;
+
+	if (valid) {
+		vcpu->crucible_ipi.generation = kvm->arch.crucible_clock.window_generation;
+		vcpu->crucible_ipi.invocation = vcpu->crucible_timer_run_invocation;
+		vcpu->crucible_ipi.sequence++;
+		vcpu->crucible_ipi.run_count++;
+		vcpu->crucible_ipi.icr_low = icr_low;
+		vcpu->crucible_ipi.icr_high = icr_high;
+		vcpu->crucible_ipi.active = true;
+		vcpu->crucible_ipi.known = false;
+		kvm->crucible_effect_owners++;
+		*retained = true;
+	} else {
+		kvm_arch_crucible_irq_taint_locked(kvm);
+	}
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	if (!valid)
+		kvm_vm_dead(kvm);
+	return valid;
+}
+
+static void crucible_ipi_finish(struct kvm_vcpu *vcpu, bool retained, int result)
+{
+	struct kvm *kvm = vcpu->kvm;
+	unsigned long flags;
+	bool valid;
+
+	if (!retained)
+		return;
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	valid = crucible_ipi_run_locked(vcpu) && vcpu->crucible_ipi.active &&
+		vcpu->crucible_ipi.generation == kvm->arch.crucible_clock.window_generation &&
+		vcpu->crucible_ipi.invocation == vcpu->crucible_timer_run_invocation &&
+		result >= 0;
+
+	/* A late cut retains the actual callback result and original identity as
+	 * uncertain history before the stopped-cut waiter can release the owner. */
+	vcpu->crucible_ipi.delivery_result = result;
+	vcpu->crucible_ipi.known = valid;
+	vcpu->crucible_ipi.active = false;
+	if (!valid)
+		kvm_arch_crucible_irq_taint_locked(kvm);
+	kvm->crucible_effect_owners--;
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	wake_up_all(&kvm->crucible_stopped);
+	if (!valid)
+		kvm_vm_dead(kvm);
+}
+
