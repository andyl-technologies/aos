+// SPDX-License-Identifier: GPL-2.0-only
+/* Included by the native clock TUs. This reads retained native inventory under
+ * the original bounded roster mutexes, without loading guest registers or
+ * invoking GET ioctls with possible observation side effects. */
+static bool initialization_request_shape(
+	const struct kvm_crucible_initialization *request)
+{
+	return request->version == 1 && request->expected_vcpus &&
+		request->vcpu_index < request->expected_vcpus &&
+		!request->architecture && !request->native_vcpu_id &&
+		!request->actual_vcpus && !request->native_devices &&
+		!request->window_generation && !request->run_invocation &&
+		!request->acknowledged_invocation && !request->observed_roots &&
+		!request->unsupported_roots && !request->memory_slots &&
+		!request->mapped_valid_regs && !request->mapped_dirty_regs &&
+		!request->requested_interrupt_window && !request->irqchip_mode &&
+		!request->reserved[0] && !request->reserved[1] && !request->reserved[2];
+}
+
+int kvm_crucible_initialization_control(struct kvm *kvm, struct kvm_enable_cap *cap)
+{
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	struct kvm_crucible_initialization request;
+	struct kvm_device *device;
+	struct kvm_memory_slot *slot;
+	struct kvm_vcpu *vcpu;
+	void __user *user = u64_to_user_ptr(cap->args[0]);
+	DECLARE_BITMAP(locked, KVM_MAX_VCPUS);
+	unsigned long index, flags;
+	int result, bucket, srcu, as_id;
+	bool found = false;
+
+	BUILD_BUG_ON(sizeof(request) != 128);
+	if (cap->flags || cap->args[1] || cap->args[2] || cap->args[3])
+		return -EINVAL;
+	if (copy_from_user(&request, user, sizeof(request)))
+		return -EFAULT;
+	if (!initialization_request_shape(&request))
+		return -EINVAL;
+
+	mutex_lock(&clock->control_lock);
+	mutex_lock(&kvm->crucible_configuration_lock);
+	if (!clock->enabled || !clock->continuation.configured ||
+	    clock->continuation.started || kvm->crucible_topology_writers ||
+	    (READ_ONCE(kvm->crucible_memory_notifier_owners) ||
+	     (READ_ONCE(kvm->crucible_irq_input.enabled) &&
+	      READ_ONCE(kvm->crucible_irq_input.owners))) ||
+	    (READ_ONCE(kvm->crucible_memory_tainted) ||
+	     (READ_ONCE(kvm->crucible_irq_input.enabled) &&
+	      READ_ONCE(kvm->crucible_irq_input.tainted))) ||
+	    request.expected_vcpus != clock->continuation.maximum_vcpus) {
+		result = -EBUSY;
+		goto unlock_configuration;
+	}
+	if (!mutex_trylock(&kvm->lock)) {
+		result = -EBUSY;
+		goto unlock_configuration;
+	}
+	if (!continuation_roster_lock(kvm, locked, false)) {
+		result = -EBUSY;
+		goto unlock_roster;
+	}
+	/* First-RUN receipts and native callbacks must still be absent. Locking the
+	 * original vCPU roster is an observation scope, not an execution permit. */
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	result = clock->active || clock->run_owners || clock->timer_owners ||
+		kvm->crucible_effect_owners || clock->window_generation ? -EBUSY : 0;
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	if (result)
+		goto unlock_roster;
+	request.architecture = INITIALIZATION_ARCHITECTURE;
+	request.actual_vcpus = kvm->created_vcpus;
+	request.unsupported_roots = KVM_CRUCIBLE_INIT_ARCH_VALUES |
+		KVM_CRUCIBLE_INIT_DMA | KVM_CRUCIBLE_INIT_MMU |
+		KVM_CRUCIBLE_INIT_ASYNCHRONOUS_WRITERS;
+	kvm_for_each_vcpu(index, vcpu, kvm) {
+		if (vcpu->crucible_run_return.original.invocation ||
+		    vcpu->crucible_run_return.acknowledged_invocation) {
+			result = -EBUSY;
+			goto unlock_roster;
+		}
+		if (index == request.vcpu_index) {
+			request.native_vcpu_id = vcpu->vcpu_id;
+			INITIALIZATION_ARCH_OBSERVE(kvm, vcpu, &request);
+			found = true;
+		}
+	}
+	if (!found) {
+		result = -ENOENT;
+		goto unlock_roster;
+	}
+	list_for_each_entry(device, &kvm->devices, vm_node) {
+		if (request.native_devices == 65536) {
+			result = -E2BIG;
+			goto unlock_roster;
+		}
+		request.native_devices++;
+	}
+	if (request.native_devices) {
+		request.observed_roots |= KVM_CRUCIBLE_INIT_HAS_DEVICE_FD;
+		request.unsupported_roots |= KVM_CRUCIBLE_INIT_DEVICE_FD;
+	}
+	/* The native ioeventfd/coalescing lists use slots_lock, independently of
+	 * SRCU retaining the slot tables. Trylock avoids introducing a blocking
+	 * inverse edge against a native slot updater. No list is read on refusal. */
+	if (!mutex_trylock(&kvm->slots_lock)) {
+		result = -EBUSY;
+		goto unlock_roster;
+	}
+	/* SRCU retains native slot tables while reading. This does not flush dirty
+	 * logs, fault pages, invalidate MMUs or certify RAM/DMA contents. */
+	srcu = srcu_read_lock(&kvm->srcu);
+	for (as_id = 0; as_id < KVM_MAX_NR_ADDRESS_SPACES; as_id++) {
+		struct kvm_memslots *slots = __kvm_memslots(kvm, as_id);
+
+		kvm_for_each_memslot(slot, bucket, slots) {
+			if (request.memory_slots == 65536) {
+				result = -E2BIG;
+				goto unlock_srcu;
+			}
+			request.memory_slots++;
+		}
+	}
+	if (request.memory_slots)
+		request.observed_roots |= KVM_CRUCIBLE_INIT_HAS_MEMORY;
+	if (!list_empty(&kvm->ioeventfds))
+		request.observed_roots |= KVM_CRUCIBLE_INIT_HAS_IOEVENTFD;
+#ifdef CONFIG_KVM_MMIO
+	if (!list_empty(&kvm->coalesced_zones))
+		request.observed_roots |= KVM_CRUCIBLE_INIT_HAS_COALESCING;
+#endif
+#ifdef CONFIG_HAVE_KVM_IRQCHIP
+	spin_lock_irqsave(&kvm->irqfds.lock, flags);
+	if (!list_empty(&kvm->irqfds.items))
+		request.observed_roots |= KVM_CRUCIBLE_INIT_HAS_IRQFD;
+	spin_unlock_irqrestore(&kvm->irqfds.lock, flags);
+#endif
+	/* A present asynchronous transport remains unsupported even if its other
+	 * metadata looks familiar. Source producer/callback ancestry is required. */
+	if (request.observed_roots & (KVM_CRUCIBLE_INIT_HAS_IOEVENTFD |
+	    KVM_CRUCIBLE_INIT_HAS_IRQFD | KVM_CRUCIBLE_INIT_HAS_COALESCING))
+		request.unsupported_roots |= KVM_CRUCIBLE_INIT_ASYNCHRONOUS_TRANSPORT;
+unlock_srcu:
+	srcu_read_unlock(&kvm->srcu, srcu);
+	mutex_unlock(&kvm->slots_lock);
+unlock_roster:
+	continuation_roster_unlock(kvm, locked);
+	mutex_unlock(&kvm->lock);
+unlock_configuration:
+	mutex_unlock(&kvm->crucible_configuration_lock);
+	mutex_unlock(&clock->control_lock);
+	if (result)
+		return result;
+	/* Delivery does not change native state or make subsequent pages one
+	 * immutable capture. A failed copyout is safely repeatable observation. */
+	return copy_to_user(user, &request, sizeof(request)) ? -EFAULT : 0;
+}
