+static bool ioapic_native_birth_locked(struct kvm_ioapic *ioapic,
+	struct kvm_crucible_eoi_row *row)
+{
+	struct kvm_vcpu *vcpu;
+	unsigned long index;
+
+	if (!row->sequence || row->sequence > ioapic->crucible_eoi.issued ||
+	    !row->invocation || row->generation !=
+		ioapic->kvm->arch.crucible_clock.window_generation)
+		return false;
