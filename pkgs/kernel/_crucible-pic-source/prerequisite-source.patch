+static bool ioapic_native_live_locked(struct kvm *kvm)
+{
+	return !kvm->crucible_irq_input.tainted && !kvm->crucible_memory_tainted &&
+		!kvm->arch.crucible_clock.continuation.uncertain &&
+		kvm_crucible_clock_admission_live(kvm->arch.crucible_clock.active,
