+		    kvm_arch_crucible_response_pending(vcpu) || vcpu->crucible_response.flags)
+			return false;
+	}
+	return true;
+}
+
+static void irq_input_roster_unlock(struct kvm *kvm, unsigned long *locked)
+{
+	struct kvm_vcpu *vcpu;
+	unsigned long index;
+
+	kvm_for_each_vcpu(index, vcpu, kvm) {
+		if (index < KVM_MAX_VCPUS && test_bit(index, locked))
+			mutex_unlock(&vcpu->mutex);
+	}
+}
