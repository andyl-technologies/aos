+			state->original_end_ns - state->projection_origin_ns,
+			clock->numerator, clock->denominator, &deadline) ||
+			state->maximum_active_ns - state->active_ns > KTIME_MAX - now))
+			result = -EOVERFLOW;
+		if (!result) {
+			deadline = min(deadline, now + state->maximum_active_ns - state->active_ns);
