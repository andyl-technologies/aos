+		result = -EBUSY;
+		goto unlock_configuration;
+	}
+	result = -EBUSY;
+	if (!irq_input_roster_lock(kvm, locked))
+		goto unlock_roster;
+	if (!kvm_arch_irqchip_in_kernel(kvm)) {
+		result = -EOPNOTSUPP;
+		goto unlock_roster;
+	}
+	/* Only retained native IRQCHIP GSI routes participate in this edition.
+	 * MSI, irqfd, PIT and internal RUN/timer producers need distinct ancestry. */
+	srcu = srcu_read_lock(&kvm->irq_srcu);
