+		goto unlock_roster;
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	result = !clock->continuation.started || !clock->continuation.paused ||
+		clock->continuation.terminal ||
+		clock->continuation.generation != clock->window_generation ||
+		clock->continuation.original_start_ns != clock->start_ns ||
+		clock->continuation.original_end_ns != clock->end_ns ||
+		clock->continuation.projection_origin_ns != clock->frozen_ns ||
+		clock->active || clock->run_owners || clock->timer_owners ||
+		kvm->crucible_effect_owners || kvm->crucible_uncollected_returns ||
+		kvm->crucible_memory_tainted || kvm->crucible_memory_notifier_owners ||
+		!kvm->crucible_continuation_roster_frozen || input->owners ||
+		input->inflight || input->tainted || clock->continuation.uncertain ||
+		request.generation != clock->window_generation ? -EBUSY : 0;
