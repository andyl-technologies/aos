+	struct kvm_crucible_continuation_policy *state, u64 generation,
+	u64 start_ns, u64 end_ns)
+{
+	state->generation = generation;
+	state->original_start_ns = start_ns;
+	state->original_end_ns = end_ns;
+	state->projection_origin_ns = start_ns;
+	state->active_ns = 0;
+	state->resumes = 0;
+	state->started = true;
+	state->paused = false;
+	state->terminal = false;
+}
+
+/* Physical elapsed time is charged even when a native stop is late. It is not
+ * clamped to a declared budget, so overshoot cannot disappear from evidence.
+ */
+static inline int kvm_crucible_continuation_account(
+	struct kvm_crucible_continuation_policy *state, u64 elapsed_ns,
+	u64 current_ns, bool final)
+{
+	if (!state->configured || !state->started || state->paused || state->terminal)
+		return -EBUSY;
+	if (current_ns < state->projection_origin_ns ||
+	    current_ns > state->original_end_ns ||
+	    elapsed_ns > U64_MAX - state->active_ns) {
+		state->uncertain = true;
+		return -EOVERFLOW;
+	}
+	state->active_ns += elapsed_ns;
+	state->projection_origin_ns = current_ns;
+	state->terminal = final || current_ns == state->original_end_ns ||
+		state->active_ns >= state->maximum_active_ns;
+	state->paused = !state->terminal;
+	return 0;
+}
+
+static inline int kvm_crucible_continuation_resume_policy(
+	const struct kvm_crucible_continuation_policy *state, u64 generation,
+	u64 current_ns, u64 end_ns, bool owners_busy, bool original_pending)
+{
+	if (!state->configured || !state->started || !state->paused ||
+	    state->terminal || state->uncertain || owners_busy || original_pending)
+		return -EBUSY;
+	if (generation != state->generation || current_ns != state->projection_origin_ns ||
+	    end_ns != state->original_end_ns)
