+	 * block on their inverse edge while retaining the original clock lock.
+	 */
+	if (!mutex_trylock(&kvm->lock)) {
+		result = -EBUSY;
+		goto report;
+	}
+	if (request.operation == KVM_CRUCIBLE_CONTINUATION_CONFIGURE) {
+		result = kvm_crucible_continuation_configure_policy(state,
+			request.maximum_active_ns, request.maximum_resumes,
+			clock->enabled && clock->version == CONTINUATION_CLOCK_VERSION &&
+			request.maximum_vcpus <= kvm->max_vcpus &&
+			kvm->crucible_response_enabled && kvm->crucible_run_return_enabled &&
+			kvm->crucible_response_bytes_enabled && !clock->active,
