+/* The receiver record belongs to the PIC. EXTINT does not move a LAPIC vector
+ * into ISR, so no LAPIC consumption bit can substitute for this native tail. */
+static bool pic_pit_consume_begin_locked(struct kvm_pic *pic,
+	struct kvm_vcpu *vcpu, int irq)
+{
+	struct kvm *kvm = vcpu->kvm;
+	struct kvm_kpic_state *state = &pic->pics[0];
+	struct kvm_crucible_pic_pit_line *row = &pic->crucible_pit[0];
+	unsigned long flags;
+	bool valid;
+
+	lockdep_assert_held(&pic->lock);
+	lockdep_assert_held(&vcpu->mutex);
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	valid = irq == 0 && pic == kvm->arch.vpic && pic->kvm == kvm &&
+		crucible_irq_device_run_locked(kvm, vcpu) &&
+		vcpu->crucible_apic_target.injection_active &&
+		vcpu->crucible_apic_target.injection_invocation ==
+			vcpu->crucible_timer_run_invocation &&
+		kvm_apic_accept_pic_intr(vcpu) &&
+		row->phase == CRUCIBLE_PIC_PIT_PENDING && row->high_known &&
+		row->original.sequence && row->original.invocation &&
+		row->original.generation == kvm->arch.crucible_clock.window_generation &&
+		row->vector >= 16 && row->vector < 256 &&
+		row->vector == state->irq_base && row->geometry == pic_pit_geometry(state) &&
+		!state->auto_eoi && !state->rotate_on_auto_eoi && !state->poll &&
+		!state->init_state && !(state->elcr & 1) && !(state->imr & 1) &&
+		state->irr == 1 && !state->isr &&
+		!pic->pics[1].irr && !pic->pics[1].isr;
+	if (valid) {
+		/* Reservation precedes output clearing and the actual IRR-to-ISR move. */
+		row->phase = CRUCIBLE_PIC_PIT_CONSUMING;
+		row->target_id = vcpu->vcpu_id;
+		row->consume_invocation = vcpu->crucible_timer_run_invocation;
+	} else {
+		kvm_arch_crucible_irq_taint_locked(kvm);
+	}
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	return valid;
+}
+
+/* The architecture caller retains its original injection credit while this
+ * helper takes PIC then gate. It never acquires PIC while holding the gate. */
+bool kvm_crucible_pic_injection_finish(struct kvm_vcpu *vcpu, bool injected)
+{
+	struct kvm *kvm = vcpu->kvm;
+	struct kvm_pic *pic = kvm->arch.vpic;
+	struct kvm_crucible_pic_pit_line *row;
+	unsigned long flags;
+	bool valid;
+
+	if (!crucible_irq_device_selected(kvm) || !pic)
+		return true;
+	lockdep_assert_held(&vcpu->mutex);
+	pic_lock(pic);
+	row = &pic->crucible_pit[0];
+	if (row->phase != CRUCIBLE_PIC_PIT_CONSUMING ||
+	    row->target_id != vcpu->vcpu_id) {
+		/* This invocation may instead have taken an ordinary LAPIC vector. */
+		spin_unlock(&pic->lock);
+		return true;
+	}
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	valid = injected && pic == kvm->arch.vpic && pic->kvm == kvm &&
+		crucible_irq_device_run_locked(kvm, vcpu) &&
+		vcpu->crucible_apic_target.injection_active &&
+		vcpu->crucible_apic_target.injection_invocation == row->consume_invocation &&
+		row->consume_invocation == vcpu->crucible_timer_run_invocation &&
+		row->original.generation == kvm->arch.crucible_clock.window_generation &&
+		row->geometry == pic_pit_geometry(&pic->pics[0]) &&
+		vcpu->arch.interrupt.nr == row->vector &&
+		!(pic->pics[0].irr & 1) && (pic->pics[0].isr & 1);
+	row->phase = valid ? CRUCIBLE_PIC_PIT_CONSUMED : CRUCIBLE_PIC_PIT_UNKNOWN;
+	if (!valid)
+		kvm_arch_crucible_irq_taint_locked(kvm);
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	/* No second native wake tail is needed for collecting the receiver fact. */
+	spin_unlock(&pic->lock);
+	return valid;
+}
+EXPORT_SYMBOL_FOR_KVM_INTERNAL(kvm_crucible_pic_injection_finish);
+
+/* The architecture check can fail after the local intack/inject fact was
+ * collected. Original injection credit and identity remain held until this
+ * receiver disposition is reconciled, with PIC before gate on every path. */
+void kvm_crucible_pic_injection_failed(struct kvm_vcpu *vcpu)
+{
+	struct kvm *kvm = vcpu->kvm;
+	struct kvm_pic *pic = kvm->arch.vpic;
+	struct kvm_crucible_pic_pit_line *row;
+	unsigned long flags;
+
+	if (!crucible_irq_device_selected(kvm) || !pic)
+		return;
+	lockdep_assert_held(&vcpu->mutex);
+	pic_lock(pic);
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	row = &pic->crucible_pit[0];
+	if ((row->phase == CRUCIBLE_PIC_PIT_CONSUMING ||
+	     row->phase == CRUCIBLE_PIC_PIT_CONSUMED) &&
+	    row->target_id == vcpu->vcpu_id &&
+	    vcpu->crucible_apic_target.injection_active &&
+	    row->consume_invocation ==
+		vcpu->crucible_apic_target.injection_invocation &&
+	    row->consume_invocation == vcpu->crucible_timer_run_invocation)
+		row->phase = CRUCIBLE_PIC_PIT_UNKNOWN;
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	spin_unlock(&pic->lock);
+}
+EXPORT_SYMBOL_FOR_KVM_INTERNAL(kvm_crucible_pic_injection_failed);
