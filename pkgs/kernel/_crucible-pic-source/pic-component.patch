+/* Pending controller geometry is original custody. A generic PIC programming
+ * call cannot clear ISR, run a scalar notifier or retarget the retained birth.
+ * The explicit original EOI/disposition join is a separate source prerequisite. */
+static bool pic_pit_controller_write_safe_locked(struct kvm_pic *pic)
+{
+	unsigned int pin;
+
+	lockdep_assert_held(&pic->lock);
+	if (!crucible_irq_device_selected(pic->kvm))
+		return true;
+	for (pin = 0; pin < PIC_NUM_PINS; pin++)
+		if (pic->crucible_pit[pin].phase &&
+		    pic->crucible_pit[pin].phase != CRUCIBLE_PIC_PIT_ACKED)
+			return false;
+	return true;
 }
 
