+/* Immutable routing geometry is distinct from native IRR/ISR state. A later
+ * controller reprogramming cannot silently retarget this original expiry. */
+static u64 pic_pit_geometry(struct kvm_kpic_state *state)
+{
+	return (u64)state->irq_base | ((u64)state->elcr << 8) |
+		((u64)state->imr << 16) | ((u64)state->priority_add << 24) |
+		((u64)state->special_mask << 32) |
+		((u64)state->special_fully_nested_mode << 40) |
+		((u64)state->init_state << 48) | ((u64)state->init4 << 56);
+}
+
+static bool pic_pit_original_equal(const struct kvm_crucible_pit_irq_birth *a,
+	const struct kvm_crucible_pit_irq_birth *b)
+{
+	/* The IOAPIC route is another receiver's identity. It can bind between the
+	 * same original PIT high/low calls without changing the PIC birth itself. */
+	return a->generation == b->generation && a->invocation == b->invocation &&
+		a->sequence == b->sequence && a->native_vcpu_id == b->native_vcpu_id &&
+		a->host_ns == b->host_ns && a->logical_ns == b->logical_ns;
+}
