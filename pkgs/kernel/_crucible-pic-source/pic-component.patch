+	irq_level = __kvm_irq_line_state(&pic->irq_states[0], irq_source_id, level);
+	native_result = pic_set_irq1(state, 0, irq_level);
+	pic_update_irq(pic);
+	trace_kvm_pic_set_irq(0, 0, state->elcr, state->imr, native_result == 0);
+	/* Publish the native field result before the actual wake tail lets the
+	 * original destination perform intack. A later tail failure stays Unknown. */
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	valid = kvm_arch_crucible_pit_irq_birth_live_locked(kvm, original) &&
+		(native_result == 0 || native_result == 1 || (masked && native_result == -1)) &&
+		pic_pit_geometry(state) == geometry &&
+		(level ? ((state->last_irr & 1) && (state->irr & 1)) :
+			 (!(state->last_irr & 1) && !pic->irq_states[0]));
+	row->native_result = native_result;
+	if (valid) {
+		if (level)
+			row->high_known = true;
+		else
+			row->low_known = true;
+	} else {
+		row->phase = CRUCIBLE_PIC_PIT_UNKNOWN;
+		kvm_arch_crucible_irq_taint_locked(kvm);
+	}
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	if (!valid) {
+		spin_unlock(&pic->lock);
+		kvm_vm_dead(kvm);
+		return -EAGAIN;
+	}
+	/* The original source lease and PIT worker credit span this native wake
+	 * tail. A stopped cut cannot conclude until the dispatcher releases them. */
+	pic_unlock(pic);
+
+	/* Reacquire the actual controller lock after its wake tail. Another guest
+	 * controller writer cannot make a changed geometry look like our receipt. */
+	pic_lock(pic);
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	valid = kvm_arch_crucible_pit_irq_birth_live_locked(kvm, original) &&
+		pic_pit_original_equal(&row->original, original) &&
+		row->geometry == geometry && pic_pit_geometry(state) == geometry &&
+		row->phase != CRUCIBLE_PIC_PIT_UNKNOWN &&
+		(native_result == 0 || native_result == 1 || (masked && native_result == -1));
+	row->native_result = native_result;
+	if (valid) {
+		if (level)
+			row->high_known = true;
+		else
+			row->low_known = true;
+	} else {
+		row->phase = CRUCIBLE_PIC_PIT_UNKNOWN;
+		kvm_arch_crucible_irq_taint_locked(kvm);
