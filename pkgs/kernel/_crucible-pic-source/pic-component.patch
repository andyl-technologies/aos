+	    e->type != KVM_IRQ_ROUTING_IRQCHIP ||
+	    e->irqchip.irqchip != KVM_IRQCHIP_PIC_MASTER || e->irqchip.pin ||
+	    e->set != kvm_pic_set_irq || irq_source_id != KVM_PIT_IRQ_SOURCE_ID ||
+	    line_status || level < 0 || level > 1) {
+		raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+		kvm_arch_crucible_irq_taint_locked(kvm);
+		raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+		kvm_vm_dead(kvm);
+		return -EAGAIN;
+	}
+
+	pic_lock(pic);
+	state = &pic->pics[0];
+	row = &pic->crucible_pit[0];
+	geometry = pic_pit_geometry(state);
+	masked = state->imr & 1;
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	valid = pic->kvm == kvm && kvm->arch.vpic == pic &&
+		kvm_arch_crucible_pit_irq_birth_live_locked(kvm, original) &&
+		original->phase == (level ? 0 : 1) &&
+		!(state->elcr & 1) && !state->auto_eoi && !state->rotate_on_auto_eoi &&
+		!state->poll && !state->init_state &&
+		!(state->irr & ~1) && !(state->isr & ~1) &&
+		!pic->pics[1].irr && !pic->pics[1].isr;
+	if (valid && level) {
+		valid = (!row->phase || row->phase == CRUCIBLE_PIC_PIT_ACKED) &&
+			!pic->irq_states[0] && !state->last_irr && !state->irr && !state->isr &&
