+			pic_pit_original_equal(&row->original, original) &&
+			pic->irq_states[0] == BIT(KVM_PIT_IRQ_SOURCE_ID) && (state->last_irr & 1);
+	}
+	if (!valid)
+		kvm_arch_crucible_irq_taint_locked(kvm);
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	if (!valid) {
+		/* Ordinary pic_unlock itself mutates wake fields and kicks receivers. */
+		spin_unlock(&pic->lock);
+		kvm_vm_dead(kvm);
+		return -EAGAIN;
+	}
