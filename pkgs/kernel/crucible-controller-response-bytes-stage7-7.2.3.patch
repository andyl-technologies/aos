+// SPDX-License-Identifier: GPL-2.0-only
+/* Immutable original response bytes, never another guest entry. This component
+ * owns one bounded current fragment and one exact last-operation/result pair.
+ * It does not certify device effects, DMA, input ordering or full restoration.
+ */
+#include <linux/kvm_host.h>
+#include <linux/slab.h>
+#include <linux/uaccess.h>
+
+struct kvm_crucible_response_fragment {
+	u64 invocation;
+	u64 address;
+	u64 data_offset;
+	u32 reason;
+	u32 length;
+	u32 count;
+	u32 size;
+	u32 direction;
+	u32 total;
+	bool valid;
+	u8 output[KVM_CRUCIBLE_RESPONSE_BYTES_MAX];
+};
+
+struct kvm_crucible_response_bytes_state {
+	struct kvm_crucible_response_fragment fragment;
+	struct kvm_crucible_response_bytes scratch;
+	struct kvm_crucible_response_bytes last_request;
+	struct kvm_crucible_response_bytes last_result;
+	bool active_input;
+	bool result_known;
+};
+
+int kvm_crucible_response_bytes_configure(struct kvm *kvm,
+	const struct kvm_enable_cap *cap)
+{
+	int result = 0;
+
+	if ((!IS_ENABLED(CONFIG_X86) && !IS_ENABLED(CONFIG_ARM64)) || cap->flags ||
+	    cap->args[0] || cap->args[1] || cap->args[2] || cap->args[3])
+		return -EINVAL;
+	mutex_lock(&kvm->lock);
+	mutex_lock(&kvm->crucible_configuration_lock);
+	if (!kvm->crucible_controlled || !kvm->crucible_response_enabled ||
+	    !kvm->crucible_run_return_enabled || kvm->crucible_active ||
+	    kvm->created_vcpus || kvm->crucible_effect_owners ||
+	    kvm->crucible_response_bytes_enabled)
+		result = -EBUSY;
+	else
+		WRITE_ONCE(kvm->crucible_response_bytes_enabled, true);
+	mutex_unlock(&kvm->crucible_configuration_lock);
+	mutex_unlock(&kvm->lock);
+	return result;
+}
+
+int kvm_crucible_response_bytes_vcpu_init(struct kvm_vcpu *vcpu)
+{
+	if (!READ_ONCE(vcpu->kvm->crucible_response_bytes_enabled))
+		return 0;
+	vcpu->crucible_response_bytes = kzalloc(sizeof(*vcpu->crucible_response_bytes),
+		GFP_KERNEL_ACCOUNT);
+	return vcpu->crucible_response_bytes ? 0 : -ENOMEM;
+}
+
+void kvm_crucible_response_bytes_vcpu_destroy(struct kvm_vcpu *vcpu)
+{
+	kfree(vcpu->crucible_response_bytes);
+}
+
+void kvm_crucible_response_bytes_run_reset(struct kvm_vcpu *vcpu)
+{
+	if (vcpu->crucible_response_bytes)
+		vcpu->crucible_response_bytes->fragment.valid = false;
+}
+
+/* These arguments come from the original native emulator before public mapping
+ * writes. A More producer may replace only the current fragment, never the
+ * retained original STEP input/result pair.
+ */
+void kvm_crucible_response_bytes_produce(struct kvm_vcpu *vcpu, u32 reason,
+	u64 address, u64 data_offset, u32 length, u32 count, u32 size, u32 direction,
+	const void *data)
+{
+	struct kvm_crucible_response_bytes_state *bytes = vcpu->crucible_response_bytes;
+	struct kvm_crucible_response_fragment *fragment;
+	u32 total;
+
+	if (!bytes)
+		return;
+	lockdep_assert_held(&vcpu->mutex);
+	fragment = &bytes->fragment;
+	if (reason == KVM_EXIT_MMIO) {
+		if (!length || length > 8 || count || size || data_offset || direction > 1)
+			goto unsupported;
+		total = length;
+	} else if (reason == KVM_EXIT_IO) {
+		if (length || !count || (size != 1 && size != 2 && size != 4) ||
+		    count > KVM_CRUCIBLE_RESPONSE_BYTES_MAX / size ||
+		    direction > KVM_EXIT_IO_OUT)
+			goto unsupported;
+		total = count * size;
+	} else {
+		goto unsupported;
+	}
+	if (!vcpu->crucible_run_return.original.invocation ||
+	    (fragment->valid && !bytes->active_input))
+		goto unsupported;
+
+	fragment->invocation = vcpu->crucible_run_return.original.invocation;
+	fragment->address = address;
+	fragment->data_offset = data_offset;
+	fragment->reason = reason;
+	fragment->length = length;
+	fragment->count = count;
+	fragment->size = size;
+	fragment->direction = direction;
+	fragment->total = total;
+	memset(fragment->output, 0, sizeof(fragment->output));
+	if (direction)
+		memcpy(fragment->output, data, total);
+	fragment->valid = true;
+	return;
+
+unsupported:
+	fragment->valid = false;
+	vcpu->crucible_response.phase = KVM_CRUCIBLE_COMPLETION_UNSUPPORTED;
+	vcpu->crucible_response.flags |= KVM_CRUCIBLE_COMPLETION_OPAQUE;
+}
+
+EXPORT_SYMBOL_FOR_KVM_INTERNAL(kvm_crucible_response_bytes_produce);
+
+void kvm_crucible_response_bytes_consume_begin(struct kvm_vcpu *vcpu)
+{
+	if (vcpu->crucible_response_bytes && vcpu->crucible_response_bytes->active_input)
+		vcpu->crucible_response_bytes->fragment.valid = false;
+}
+
+u32 kvm_crucible_response_bytes_reason(struct kvm_vcpu *vcpu)
+{
+	struct kvm_crucible_response_bytes_state *bytes = vcpu->crucible_response_bytes;
+
+	if (!bytes)
+		return vcpu->run->exit_reason;
+	return bytes->fragment.valid ? bytes->fragment.reason : KVM_EXIT_UNKNOWN;
+}
+
+/* The actual callback reads a private input frozen before its effects. A native
+ * geometry discrepancy cannot fall back to externally mutable mapped bytes.
+ */
+const void *kvm_crucible_response_bytes_input(struct kvm_vcpu *vcpu,
+	const void *legacy, unsigned int length)
+{
+	struct kvm_crucible_response_bytes_state *bytes = vcpu->crucible_response_bytes;
+
+	if (!bytes || !bytes->active_input)
+		return legacy;
+	if (length != bytes->last_request.data_length) {
+		vcpu->crucible_response.phase = KVM_CRUCIBLE_COMPLETION_UNKNOWN;
+		vcpu->crucible_response.flags |= KVM_CRUCIBLE_COMPLETION_UNCERTAIN;
+		return NULL;
+	}
+	return bytes->last_request.data;
+}
+
+static bool response_bytes_zero_tail(const struct kvm_crucible_response_bytes *request)
+{
+	unsigned int index;
+
+	for (index = 0; index < ARRAY_SIZE(request->reserved); index++)
+		if (request->reserved[index])
+			return false;
+	if (request->data_length > KVM_CRUCIBLE_RESPONSE_BYTES_MAX)
+		return false;
+	for (index = request->data_length; index < KVM_CRUCIBLE_RESPONSE_BYTES_MAX; index++)
+		if (request->data[index])
+			return false;
+	return true;
+}
+
+static bool response_bytes_geometry(const struct kvm_crucible_response_fragment *fragment,
+	const struct kvm_crucible_response_bytes *request)
+{
+	return fragment->valid && request->address == fragment->address &&
+		request->data_offset == fragment->data_offset && request->reason == fragment->reason &&
+		request->length == fragment->length && request->count == fragment->count &&
+		request->size == fragment->size && request->direction == fragment->direction &&
+		request->data_length == (fragment->direction ? 0 : fragment->total);
+}
+
+static void response_bytes_fill(struct kvm_vcpu *vcpu,
+	struct kvm_crucible_response_bytes *result)
+{
+	struct kvm_crucible_response_fragment *fragment = &vcpu->crucible_response_bytes->fragment;
+	struct kvm_crucible_response_state *state = &vcpu->crucible_response;
+
+	result->invocation = vcpu->crucible_run_return.original.invocation;
+	result->pending_sequence = state->sequence;
+	result->consumed_sequence = state->consumed_sequence;
+	result->revision = state->revision;
+	result->phase = state->phase;
+	result->native_vcpu_id = vcpu->vcpu_id;
+	result->flags = state->flags;
+	result->callback_result = state->last_result.callback_result;
+	result->address = 0;
+	result->data_offset = 0;
+	result->reason = 0;
+	result->length = 0;
+	result->count = 0;
+	result->size = 0;
+	result->direction = 0;
+	result->data_length = 0;
+	memset(result->data, 0, sizeof(result->data));
+	if (!fragment->valid || !kvm_crucible_response_pending(state))
+		return;
+	result->address = fragment->address;
+	result->data_offset = fragment->data_offset;
+	result->reason = fragment->reason;
+	result->length = fragment->length;
+	result->count = fragment->count;
+	result->size = fragment->size;
+	result->direction = fragment->direction;
+	if (fragment->direction) {
+		result->data_length = fragment->total;
+		memcpy(result->data, fragment->output, fragment->total);
+	}
+}
+
+int kvm_crucible_response_bytes_ioctl(struct kvm_vcpu *vcpu, void __user *argument)
+{
+	struct kvm_crucible_response_bytes_state *bytes = vcpu->crucible_response_bytes;
