+/* Freeze is called only after RUN/effect/callback ownership drains. Synchronous
+ * cancellation joins the callback tail and leaves architectural deadlines intact.
+ */
+void kvm_crucible_arm_timer_freeze(struct kvm *kvm)
+{
+	struct kvm_vcpu *vcpu;
+	unsigned long index;
+
+	kvm_for_each_vcpu(index, vcpu, kvm) {
+		hrtimer_cancel(&vcpu_timer(vcpu)->bg_timer);
+		for (int i = 0; i < nr_timers(vcpu); i++)
+			hrtimer_cancel(&vcpu_get_timer(vcpu, i)->hrtimer);
+	}
+}
