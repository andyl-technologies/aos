+// SPDX-License-Identifier: GPL-2.0-only
+/* Opt-in ARM counter/timer component. Device custody, complete GIC closure and
+ * native execution qualification are deliberately not advertised by this ABI.
+ */
+#include <linux/kvm_host.h>
+#include <linux/kvm_crucible_clock_math.h>
+#include <linux/ktime.h>
+#include <linux/math64.h>
+#include <linux/uaccess.h>
+#include <clocksource/arm_arch_timer.h>
+#include <asm/cpufeature.h>
+#include <asm/kvm_mmu.h>
+#include "crucible-clock.h"
+
+bool kvm_crucible_arm_supported(void)
+{
+	/* ECV is required to trap the virtual counter; offsets cannot freeze it. */
+	return has_vhe() && cpus_have_final_cap(ARM64_HAS_ECV) &&
+		!is_protected_kvm_enabled() && !system_supports_32bit_el0() &&
+		arch_timer_get_rate() &&
+		arch_timer_get_rate() <= NSEC_PER_SEC;
+}
+
+void kvm_crucible_clock_init(struct kvm *kvm)
+{
+	mutex_init(&kvm->arch.crucible_clock.control_lock);
+}
+
+static u64 clock_now_locked(struct kvm_crucible_clock_domain *clock)
+{
+	if (!clock->active)
+		return clock->frozen_ns;
+	return kvm_crucible_clock_project(ktime_get_ns() - clock->host_origin_ns,
+		clock->start_ns, clock->end_ns, clock->numerator, clock->denominator);
+}
+
+static int clock_transition_locked(struct kvm *kvm,
+				   struct kvm_crucible_clock *request)
+{
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+
+	if (request->operation == KVM_CRUCIBLE_CLOCK_CONFIGURE) {
+		if (clock->enabled || kvm->created_vcpus || kvm->crucible_effect_owners)
+			return -EBUSY;
+		if (!kvm_crucible_arm_supported())
+			return -EOPNOTSUPP;
+		if (!request->numerator || !request->denominator ||
+		    request->window_generation || request->start_ns > KTIME_MAX)
+			return -EINVAL;
+		clock->numerator = request->numerator;
+		clock->denominator = request->denominator;
+		clock->frozen_ns = request->start_ns;
+		/* No physical host epoch or pre-configuration counter offset survives. */
+		kvm->arch.timer_data.voffset = 0;
+		kvm->arch.timer_data.poffset = 0;
+		set_bit(KVM_ARCH_FLAG_VM_COUNTER_OFFSET, &kvm->arch.flags);
+		smp_store_release(&clock->enabled, true);
+		smp_store_release(&kvm->crucible_controlled, true);
+		return 0;
+	}
+	if (!clock->enabled)
+		return -ENOENT;
+	if (request->operation == KVM_CRUCIBLE_CLOCK_QUERY)
+		return 0;
+	if (request->operation == KVM_CRUCIBLE_CLOCK_BEGIN) {
+		struct kvm_crucible_begin_state state = {
+			.generation = clock->window_generation,
+			.frozen_ns = clock->frozen_ns,
+			.requested_generation = request->window_generation,
+			.start_ns = request->start_ns,
+			.end_ns = request->end_ns,
+			.denominator = clock->denominator,
+			.active = clock->active,
+			.owners_busy = clock->run_owners || clock->timer_owners ||
+				kvm->crucible_effect_owners,
+			.acknowledged = clock->close_acknowledged,
+		};
+
+		switch (kvm_crucible_clock_begin_policy(&state)) {
+		case KVM_CRUCIBLE_BEGIN_BUSY:
+			return -EBUSY;
+		case KVM_CRUCIBLE_BEGIN_INVALID:
+			return -EINVAL;
+		case KVM_CRUCIBLE_BEGIN_OVERFLOW:
+			return -EOVERFLOW;
+		case KVM_CRUCIBLE_BEGIN_READY:
+			break;
+		}
+		clock->window_generation = request->window_generation;
+		clock->start_ns = request->start_ns;
+		clock->end_ns = request->end_ns;
+		clock->host_origin_ns = ktime_get_ns();
+		clock->close_acknowledged = false;
+		clock->active = true;
+		kvm->crucible_active = true;
+		return 0;
+	}
+	if (request->window_generation != clock->window_generation)
+		return -ESTALE;
+	if (request->operation == KVM_CRUCIBLE_CLOCK_FREEZE) {
+		if (clock->active) {
+			clock->frozen_ns = clock_now_locked(clock);
+			clock->active = false;
+			kvm->crucible_active = false;
+		}
+		return 0;
+	}
+	if (request->operation == KVM_CRUCIBLE_CLOCK_STEP) {
+		if (clock->active || clock->run_owners || clock->timer_owners ||
+		    kvm->crucible_effect_owners || !clock->close_acknowledged)
+			return -EBUSY;
+		if (request->start_ns < clock->frozen_ns || request->start_ns > KTIME_MAX)
+			return -EINVAL;
+		clock->frozen_ns = request->start_ns;
+		return 0;
+	}
+	return -EINVAL;
+}
+
+int kvm_crucible_clock_control(struct kvm *kvm, struct kvm_enable_cap *cap)
+{
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	struct kvm_crucible_clock request;
+	void __user *user = u64_to_user_ptr(cap->args[0]);
+	unsigned long flags;
