+		raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	}
+	mutex_unlock(&kvm->lock);
+	if (!result && request.operation == KVM_CRUCIBLE_CLOCK_FREEZE) {
+		kvm_make_all_cpus_request(kvm, KVM_REQ_IRQ_PENDING);
+		waited = wait_event_interruptible_hrtimeout(kvm->crucible_stopped,
+			!READ_ONCE(clock->run_owners) && !READ_ONCE(clock->timer_owners) &&
+			!READ_ONCE(kvm->crucible_effect_owners), ns_to_ktime(request.stop_budget_ns));
+		if (waited)
+			result = waited == -ETIME ? -ETIMEDOUT : waited;
+		else {
+			kvm_crucible_arm_timer_freeze(kvm);
+			raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+			/* Frozen immediate-exit reentry may disposition an old exit
+			 * concurrently with the wait/cancel tail. Recheck ownership at
+			 * the acknowledgment cut instead of certifying a stale drain.
+			 */
+			if (clock->run_owners || clock->timer_owners || kvm->crucible_effect_owners)
+				result = -EBUSY;
+			else
+				clock->close_acknowledged = true;
+			raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+		}
+	}
+	if (!result && request.operation == KVM_CRUCIBLE_CLOCK_BEGIN)
+		kvm_crucible_arm_timer_resume(kvm);
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	request.current_ns = clock_now_locked(clock);
+	request.window_generation = clock->window_generation;
+	request.start_ns = clock->start_ns;
+	request.end_ns = clock->end_ns;
+	request.numerator = clock->numerator;
+	request.denominator = clock->denominator;
+	request.coverage = KVM_CRUCIBLE_ARM_COVERAGE;
+	request.run_owners = clock->run_owners;
+	request.active = clock->active;
+	request.close_acknowledged = clock->close_acknowledged;
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	mutex_unlock(&kvm->crucible_configuration_lock);
+	mutex_unlock(&clock->control_lock);
+	if (copy_to_user(user, &request, sizeof(request)))
+		return -EFAULT;
+	return result;
+}
+
+int kvm_crucible_clock_run_enter(struct kvm_vcpu *vcpu)
+{
+	struct kvm *kvm = vcpu->kvm;
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	unsigned long flags;
+	int result = 0;
+
+	if (!kvm_crucible_clock_enabled(kvm))
+		return 0;
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	if ((!clock->active && vcpu->wants_to_run) || clock->run_owners == U32_MAX)
+		result = -EAGAIN;
+	else {
+		if (!clock->active)
+			clock->close_acknowledged = false;
+		clock->run_owners++;
+	}
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	return result;
+}
+
+void kvm_crucible_clock_run_leave(struct kvm_vcpu *vcpu)
+{
+	struct kvm *kvm = vcpu->kvm;
+	unsigned long flags;
+
+	if (!kvm_crucible_clock_enabled(kvm))
+		return;
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	kvm->arch.crucible_clock.run_owners--;
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	wake_up_all(&kvm->crucible_stopped);
+}
+
+bool kvm_crucible_clock_run_allowed(struct kvm_vcpu *vcpu)
+{
+	return !kvm_crucible_clock_enabled(vcpu->kvm) || READ_ONCE(vcpu->kvm->crucible_active);
+}
+
+u64 kvm_crucible_clock_ns(struct kvm *kvm)
+{
+	unsigned long flags;
+	u64 now;
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	now = clock_now_locked(&kvm->arch.crucible_clock);
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	return now;
+}
+
+void kvm_crucible_clock_sample(struct kvm_vcpu *vcpu, u64 *ns, u64 *counter)
+{
+	struct kvm *kvm = vcpu->kvm;
+	unsigned long flags;
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	*ns = clock_now_locked(&kvm->arch.crucible_clock);
+	*counter = kvm_crucible_clock_counter_from_ns(*ns, arch_timer_get_rate());
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+}
+
+u64 kvm_crucible_clock_counter(struct kvm_vcpu *vcpu)
+{
+	u64 ns, counter;
+
+	kvm_crucible_clock_sample(vcpu, &ns, &counter);
+	return counter;
+}
+
+u64 kvm_crucible_clock_counter_delta(u64 cycles)
+{
+	return kvm_crucible_clock_counter_cycles_to_ns(cycles, arch_timer_get_rate());
+}
+
+bool kvm_crucible_clock_host_expiration(struct kvm *kvm, u64 logical_delta,
+				       ktime_t *host)
+{
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	unsigned long flags;
+	u64 now, target, delay;
+	bool valid = false;
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	now = clock_now_locked(clock);
+	/* An unreachable counter deadline remains pending; saturating it onto
+	 * the terminal coordinate would repeatedly restart a hard IRQ timer.
+	 */
+	if (logical_delta > KTIME_MAX - now)
+		goto out;
+	target = now + logical_delta;
+	if (!clock->active || target > clock->end_ns)
+		goto out;
+	delay = kvm_crucible_clock_host_delay(target - clock->start_ns,
+		clock->numerator, clock->denominator);
+	if (delay > KTIME_MAX - clock->host_origin_ns)
+		goto out;
+	*host = ns_to_ktime(clock->host_origin_ns + delay);
+	valid = true;
+out:
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	return valid;
+}
+
+bool kvm_crucible_clock_timer_enter(struct kvm *kvm)
+{
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	unsigned long flags;
+	bool admitted;
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	admitted = clock->active && clock->timer_owners != U32_MAX;
+	if (admitted)
+		clock->timer_owners++;
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	return admitted;
+}
+
+void kvm_crucible_clock_timer_leave(struct kvm *kvm)
+{
+	unsigned long flags;
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	kvm->arch.crucible_clock.timer_owners--;
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	wake_up_all(&kvm->crucible_stopped);
+}
