+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __KVM_CRUCIBLE_CLOCK_MATH_H
+#define __KVM_CRUCIBLE_CLOCK_MATH_H
+
+/* Callers validate extent*denominator before installing a window. This makes
+ * the unsaturated elapsed*numerator product representable without floating
+ * point, and saturation never creates a later authorization interval.
+ */
+static inline u64 kvm_crucible_clock_project(u64 elapsed, u64 start, u64 end,
+					   u32 numerator, u32 denominator)
+{
+	u64 product = (end - start) * denominator;
+	u64 threshold = product / numerator + !!(product % numerator);
+
+	if (elapsed >= threshold)
+		return end;
+	return start + elapsed * numerator / denominator;
+}
+
+/* The caller checks the product before accepting a window. Ceiling division
+ * avoids early native callbacks and does not overflow at U64_MAX products.
+ */
+static inline u64 kvm_crucible_clock_host_delay(u64 logical_delta,
+					       u32 numerator, u32 denominator)
+{
+	u64 product = logical_delta * denominator;
+
+	return product / numerator + !!(product % numerator);
+}
+
+/* Logical timer positions use the nonnegative signed ktime range. Saturating
+ * retains a far-future deadline rather than wrapping it into a past callback.
+ */
+static inline u64 kvm_crucible_clock_deadline_add(u64 position, u64 delta)
+{
+	u64 maximum = U64_MAX >> 1;
+
+	return delta > maximum - position ? maximum : position + delta;
+}
+
+static inline u64 kvm_crucible_clock_cycles_to_ns(u64 cycles, u32 khz)
+{
+	u64 whole = cycles / khz;
+	u64 product = (cycles % khz) * 1000000;
+	u64 fraction = product / khz + !!(product % khz);
+
+	if (whole > (U64_MAX - fraction) / 1000000)
+		return U64_MAX;
+	return whole * 1000000 + fraction;
+}
+
+/* This view is captured under the native admission lock. Portable tests execute
+ * the same transition policy; callback/run ownership still needs native proof.
+ */
+struct kvm_crucible_begin_state {
+	u64 generation;
+	u64 frozen_ns;
+	u64 requested_generation;
+	u64 start_ns;
+	u64 end_ns;
+	u32 denominator;
+	bool active;
+	bool owners_busy;
+	bool acknowledged;
+};
+
+enum kvm_crucible_begin_result {
+	KVM_CRUCIBLE_BEGIN_READY,
+	KVM_CRUCIBLE_BEGIN_BUSY,
+	KVM_CRUCIBLE_BEGIN_INVALID,
+	KVM_CRUCIBLE_BEGIN_OVERFLOW,
+};
+
+static inline enum kvm_crucible_begin_result
+kvm_crucible_clock_begin_policy(const struct kvm_crucible_begin_state *state)
+{
+	if (state->active || state->owners_busy ||
+	    (!state->acknowledged && state->generation))
+		return KVM_CRUCIBLE_BEGIN_BUSY;
+	if (!state->denominator || state->generation == U64_MAX ||
+	    state->requested_generation != state->generation + 1 ||
+	    state->start_ns != state->frozen_ns || state->end_ns <= state->start_ns ||
+	    state->end_ns > (U64_MAX >> 1))
+		return KVM_CRUCIBLE_BEGIN_INVALID;
+	if (state->end_ns - state->start_ns > U64_MAX / state->denominator)
+		return KVM_CRUCIBLE_BEGIN_OVERFLOW;
+	return KVM_CRUCIBLE_BEGIN_READY;
+}
+
+/* The configured ARM rate is at most 1 GHz and logical coordinates are in the
