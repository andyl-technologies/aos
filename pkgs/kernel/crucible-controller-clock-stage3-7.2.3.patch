+	if (cap->cap != KVM_CAP_CRUCIBLE_CLOCK_V2 || cap->flags ||
+	    cap->args[1] || cap->args[2] || cap->args[3])
+		return -EINVAL;
+	if (copy_from_user(&request, user, sizeof(request)))
+		return -EFAULT;
+	if (request.version != 2 || request.flags || request.reserved[0] ||
+	    request.reserved[1] || request.reserved[2] || request.reserved[3] ||
+	    request.reserved[4])
+		return -EINVAL;
+	if (request.operation == KVM_CRUCIBLE_CLOCK_FREEZE &&
+	    (!request.stop_budget_ns || request.stop_budget_ns > 5ULL * NSEC_PER_SEC))
+		return -EINVAL;
