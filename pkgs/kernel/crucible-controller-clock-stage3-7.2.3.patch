+void kvm_crucible_arm_timer_resume(struct kvm *kvm)
+{
+	struct kvm_vcpu *vcpu;
+	unsigned long index;
+
+	kvm_for_each_vcpu(index, vcpu, kvm) {
+		if (!vcpu_timer(vcpu)->enabled)
+			continue;
+		timer_emulate(vcpu_vtimer(vcpu));
+		timer_emulate(vcpu_ptimer(vcpu));
+		if (kvm_vcpu_is_blocking(vcpu))
+			kvm_timer_blocking(vcpu);
+	}
+}
