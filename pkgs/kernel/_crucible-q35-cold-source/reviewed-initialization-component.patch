+	    board->constructor != current || board->result || !board->birth.known ||
+	    !board->pic || board->pic != kvm->arch.vpic ||
+	    !board->pit || board->pit != kvm->arch.vpit ||
+	    !board->ioapic || board->ioapic != kvm->arch.vioapic ||
+	    board->routing != rcu_dereference_protected(kvm->irq_routing, 1) ||
+	    board->memory.inflight || board->memory.uncertain ||
+	    board->initialization.inflight || board->initialization.uncertain ||
+	    clock->enabled || clock->active || clock->run_owners ||
+	    clock->timer_owners || kvm->crucible_controlled ||
+	    kvm->crucible_continuation_roster_frozen ||
+	    kvm->crucible_topology_writers || kvm->crucible_irq_input.enabled ||
+	    kvm->crucible_irq_input.owners || kvm->crucible_irq_input.tainted ||
+	    kvm->crucible_memory_tainted || READ_ONCE(kvm->vm_dead))
+		return false;
+	if (board->initializer_roster.uncertain)
+		return false;
+	for (index = 0; index < ARRAY_SIZE(board->initializer_roster.actors); index++)
+		if (board->initializer_roster.actors[index].inflight ||
+		    board->initializer_roster.actors[index].uncertain)
+			return false;
+	for (index = 0; index < ARRAY_SIZE(board->setup); index++)
+		if (board->setup[index].inflight || board->setup[index].uncertain)
+			return false;
+	return true;
+}
+
+static void pic_device_birth_report(struct kvm *kvm,
+	struct kvm_crucible_pic_device_birth *request)
+{
+	struct kvm_crucible_pic_device_birth_state *birth =
+		&kvm->arch.crucible_pic_board.birth;
+	const void *payload;
+	u32 bytes;
+
+	BUILD_BUG_ON(sizeof(birth->pic[0]) > sizeof(request->payload));
+	BUILD_BUG_ON(sizeof(birth->ioapic) > sizeof(request->payload));
+	BUILD_BUG_ON(sizeof(birth->pit) > sizeof(request->payload));
+	switch (request->kind) {
+	case KVM_CRUCIBLE_PIC_DEVICE_BIRTH_MASTER:
+	case KVM_CRUCIBLE_PIC_DEVICE_BIRTH_SLAVE:
+		payload = &birth->pic[request->kind - 1];
+		bytes = sizeof(birth->pic[0]);
+		break;
+	case KVM_CRUCIBLE_PIC_DEVICE_BIRTH_IOAPIC:
+		payload = &birth->ioapic;
+		bytes = sizeof(birth->ioapic);
+		break;
+	default:
+		payload = &birth->pit;
+		bytes = sizeof(birth->pit);
+		break;
+	}
+	/* Input validation requires zero trailing payload/reserved bytes. Only
+	 * the bounded original public structure is copied; no private pointers
+	 * or fresh GET state crosses the process boundary. */
+	memcpy(request->payload, payload, bytes);
+	request->payload_bytes = bytes;
+	request->native_result = 0;
+	request->flags = KVM_CRUCIBLE_PIC_DEVICE_BIRTH_KNOWN;
+}
+
+static int kvm_crucible_device_birth_control(struct kvm *kvm,
+	struct kvm_enable_cap *cap, u32 edition)
+{
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	struct kvm_crucible_pic_device_birth request;
+	void __user *argument = u64_to_user_ptr(cap->args[0]);
+	unsigned long flags;
+	int result;
+
+	BUILD_BUG_ON(sizeof(request) != 576);
+	if (cap->flags || !cap->args[0] || cap->args[1] ||
+	    cap->args[2] || cap->args[3])
+		return -EINVAL;
+	if (copy_from_user(&request, argument, sizeof(request)))
+		return -EFAULT;
+	if (request.version != edition)
+		return -EINVAL;
+	/* Validate the unchanged bounded public payload shape; edition
+	 * is separately bound to the original constructor below. */
+	request.version = 1;
+	if (!pic_device_birth_request_valid(&request))
+		return -EINVAL;
+	if (!mutex_trylock(&clock->control_lock))
+		return -EBUSY;
+	if (!mutex_trylock(&kvm->crucible_configuration_lock)) {
+		mutex_unlock(&clock->control_lock);
+		return -EBUSY;
+	}
+	if (!mutex_trylock(&kvm->lock)) {
+		result = -EBUSY;
+		goto unlock_configuration;
+	}
+	mutex_lock(&kvm->irq_lock);
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	result = -EOPNOTSUPP;
+	if (pic_device_birth_live_locked(kvm, edition)) {
+		pic_device_birth_report(kvm, &request);
+		result = 0;
+	}
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	mutex_unlock(&kvm->irq_lock);
+	mutex_unlock(&kvm->lock);
+unlock_configuration:
+	mutex_unlock(&kvm->crucible_configuration_lock);
+	mutex_unlock(&clock->control_lock);
+	/* Failed delivery can retry this immutable birth history without any
+	 * repeated native getter or setter. Returned bytes never assert that the
+	 * native device still has these values after the original birth. */
+	request.version = edition;
+	if (!result && copy_to_user(argument, &request, sizeof(request)))
+		return -EFAULT;
+	return result;
+}
+
+#else
+
+static int kvm_crucible_device_birth_control(struct kvm *kvm,
+	struct kvm_enable_cap *cap, u32 edition)
+{
+	return -EOPNOTSUPP;
+}
+
+#endif /* CONFIG_KVM_IOAPIC */
+
+static int kvm_crucible_pic_device_birth_control(struct kvm *kvm,
+	struct kvm_enable_cap *cap)
+{
+	return kvm_crucible_device_birth_control(kvm, cap, KVM_CRUCIBLE_PIC_BOARD_ONLY);
+}
+
+static int kvm_crucible_q35_device_birth_control(struct kvm *kvm,
+	struct kvm_enable_cap *cap)
+{
+	return kvm_crucible_device_birth_control(kvm, cap, KVM_CRUCIBLE_Q35_BOARD_ONLY);
+}
