+/* A retained kernel input has already captured its exact declared size.
+ * Check ranges without overflow; legacy NULL inputs keep userspace faults. */
+int kvm_nested_state_copy(void *destination, const void __user *user_source,
+	const struct kvm_nested_state *owned_state, size_t offset, size_t length)
+{
+	if (!owned_state)
+		return copy_from_user(destination, user_source, length) ? -EFAULT : 0;
+	if (offset > owned_state->size || length > owned_state->size - offset)
+		return -EINVAL;
+	memcpy(destination, (const u8 *)owned_state + offset, length);
+	return 0;
+}
+EXPORT_SYMBOL_FOR_KVM_INTERNAL(kvm_nested_state_copy);
+
+/* Duplicate the same bounded retained bytes, or preserve the ordinary
+ * memdup_user allocation and fault behavior when no input owner is supplied. */
+void *kvm_nested_state_memdup(const void __user *user_source,
+	const struct kvm_nested_state *owned_state, size_t offset, size_t length)
+{
+	if (!owned_state)
+		return memdup_user(user_source, length);
+	if (offset > owned_state->size || length > owned_state->size - offset)
+		return ERR_PTR(-EINVAL);
+	return kmemdup((const u8 *)owned_state + offset, length, GFP_KERNEL);
+}
+EXPORT_SYMBOL_FOR_KVM_INTERNAL(kvm_nested_state_memdup);
