+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Three native VM setters required by ordinary x86 architecture setup. These
+ * original function-return receipts do not qualify MMU/RAM/device closure or
+ * a clock issuer. Direct legacy setter ioctls remain under their old fence.
+ */
+#ifdef CONFIG_KVM_IOAPIC
+
+static bool pic_vm_setup_request_valid(
+	const struct kvm_crucible_pic_vm_setup *request)
+{
+	if (request->version != 1 || !request->request_id ||
+	    (request->operation != KVM_CRUCIBLE_PIC_VM_SETUP_APPLY &&
+	     request->operation != KVM_CRUCIBLE_PIC_VM_SETUP_QUERY) ||
+	    request->effect < KVM_CRUCIBLE_PIC_VM_SETUP_IDENTITY ||
+	    request->effect > KVM_CRUCIBLE_PIC_VM_SETUP_MMU_PAGES ||
+	    request->index != request->effect - 1 || request->native_result ||
+	    request->flags || request->reserved[0] || request->reserved[1] ||
+	    request->reserved[2] || request->reserved[3])
+		return false;
+
+	if (request->effect == KVM_CRUCIBLE_PIC_VM_SETUP_MMU_PAGES)
+		return request->value >= KVM_MIN_ALLOC_MMU_PAGES &&
+			request->value <= 65536;
+	return request->value && !(request->value & (PAGE_SIZE - 1)) &&
+		request->value <= (u32)(-3 * PAGE_SIZE);
+}
+
+static bool pic_vm_setup_live_locked(struct kvm *kvm)
+{
+	struct kvm_crucible_pic_board *board = &kvm->arch.crucible_pic_board;
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+
+	lockdep_assert_held(&clock->control_lock);
+	lockdep_assert_held(&kvm->crucible_configuration_lock);
+	lockdep_assert_held(&kvm->lock);
+	lockdep_assert_held(&kvm->irq_lock);
+	lockdep_assert_held(&kvm->crucible_gate_lock);
+	return board->phase == 2 && board->constructor == current &&
+		board->pic == kvm->arch.vpic && board->pit == kvm->arch.vpit &&
+		board->ioapic == kvm->arch.vioapic &&
+		board->routing == rcu_dereference_protected(kvm->irq_routing, 1) &&
+		!board->initialization.task && !kvm->created_vcpus &&
+		!board->memory.inflight && !board->memory.uncertain &&
+		!clock->enabled && !clock->active && !clock->run_owners &&
+		!clock->timer_owners && !kvm->crucible_controlled &&
+		!kvm->crucible_continuation_roster_frozen &&
+		!kvm->crucible_irq_input.owners &&
+		!kvm->crucible_irq_input.tainted && !kvm->crucible_memory_tainted &&
+		!READ_ONCE(kvm->vm_dead);
+}
+
+static void pic_vm_setup_report(
+	const struct kvm_crucible_pic_vm_setup_effect *effect,
+	struct kvm_crucible_pic_vm_setup *request)
+{
+	request->native_result = effect->native_result;
+	request->flags = (effect->known ? KVM_CRUCIBLE_PIC_VM_SETUP_KNOWN : 0) |
+		(effect->inflight ? KVM_CRUCIBLE_PIC_VM_SETUP_INFLIGHT : 0) |
+		(effect->uncertain ? KVM_CRUCIBLE_PIC_VM_SETUP_UNCERTAIN : 0);
+}
+
+static int kvm_crucible_pic_vm_setup_control(struct kvm *kvm,
+	struct kvm_enable_cap *cap)
+{
+	struct kvm_crucible_pic_board *board = &kvm->arch.crucible_pic_board;
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	struct kvm_crucible_pic_vm_setup request;
+	struct kvm_crucible_pic_vm_setup_effect *effect;
+	void __user *argument = u64_to_user_ptr(cap->args[0]);
+	unsigned long flags;
+	bool entered = false, contain = false;
+	int result, native_result;
+
+	BUILD_BUG_ON(sizeof(request) != 80);
+	if (cap->flags || !cap->args[0] || cap->args[1] ||
+	    cap->args[2] || cap->args[3])
+		return -EINVAL;
+	if (copy_from_user(&request, argument, sizeof(request)))
+		return -EFAULT;
+	if (!pic_vm_setup_request_valid(&request))
+		return -EINVAL;
+	if (!mutex_trylock(&clock->control_lock))
+		return -EBUSY;
+	if (!mutex_trylock(&kvm->crucible_configuration_lock)) {
+		mutex_unlock(&clock->control_lock);
+		return -EBUSY;
+	}
+
+	effect = &board->setup[request.index];
+	result = -EPERM;
+	if (board->constructor != current)
+		goto unlock_configuration;
+	if (effect->attempted) {
+		/* Recover this exact original result before current live admission.
+		 * A lost userspace copy never authorizes a second native setter. */
+		result = effect->original.request_id == request.request_id &&
+			effect->original.effect == request.effect &&
+			effect->original.value == request.value ? 0 : -ESTALE;
+		if (!result)
+			pic_vm_setup_report(effect, &request);
+		goto unlock_configuration;
+	}
+	result = -ENOENT;
+	if (request.operation != KVM_CRUCIBLE_PIC_VM_SETUP_APPLY)
+		goto unlock_configuration;
+	if (!mutex_trylock(&kvm->lock)) {
+		result = -EBUSY;
+		goto unlock_configuration;
+	}
+	mutex_lock(&kvm->irq_lock);
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	result = -EOPNOTSUPP;
+	if (pic_vm_setup_live_locked(kvm) && !kvm->crucible_topology_writers &&
+	    (!request.index || board->setup[request.index - 1].known)) {
+		effect->original = request;
+		effect->native_result = -EINPROGRESS;
+		effect->attempted = true;
+		effect->inflight = true;
+		kvm->crucible_topology_writers++;
+		entered = true;
+	}
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	mutex_unlock(&kvm->irq_lock);
+	mutex_unlock(&kvm->lock);
+	mutex_unlock(&kvm->crucible_configuration_lock);
+	if (!entered)
+		goto unlock_control;
+
+	/* No configuration/VM/IRQ/gate lock crosses slots/MMU native work.
+	 * The original topology credit and control lock span its entire return. */
+	switch (request.effect) {
+	case KVM_CRUCIBLE_PIC_VM_SETUP_IDENTITY:
+		mutex_lock(&kvm->lock);
+		native_result = kvm_vm_ioctl_set_identity_map_addr(kvm, request.value);
+		mutex_unlock(&kvm->lock);
+		break;
+	case KVM_CRUCIBLE_PIC_VM_SETUP_TSS:
+		native_result = kvm_vm_ioctl_set_tss_addr(kvm, request.value);
+		break;
+	default:
+		native_result = kvm_vm_ioctl_set_nr_mmu_pages(kvm, request.value);
+		break;
+	}
+
+	mutex_lock(&kvm->crucible_configuration_lock);
+	mutex_lock(&kvm->lock);
+	mutex_lock(&kvm->irq_lock);
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	effect->native_result = native_result;
+	effect->known = !native_result && pic_vm_setup_live_locked(kvm) &&
+		kvm->crucible_topology_writers == 1;
+	effect->uncertain = !effect->known;
+	effect->inflight = false;
+	/* Publish Unknown before releasing the sole original effect credit or
+	 * asking native teardown to contain partial/unreconciled work. */
+	if (effect->uncertain) {
+		kvm->crucible_memory_tainted = true;
+		contain = true;
+	}
+	kvm->crucible_topology_writers--;
+	pic_vm_setup_report(effect, &request);
+	result = effect->known ? 0 : -EAGAIN;
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	mutex_unlock(&kvm->irq_lock);
+	mutex_unlock(&kvm->lock);
+unlock_configuration:
+	mutex_unlock(&kvm->crucible_configuration_lock);
+unlock_control:
+	mutex_unlock(&clock->control_lock);
+	if (contain)
+		kvm_vm_dead(kvm);
+	if ((entered || !result) && copy_to_user(argument, &request, sizeof(request)))
+		return -EFAULT;
+	return result;
+}
+
+#else
+
+static int kvm_crucible_pic_vm_setup_control(struct kvm *kvm,
+	struct kvm_enable_cap *cap)
+{
+	return -EOPNOTSUPP;
+}
