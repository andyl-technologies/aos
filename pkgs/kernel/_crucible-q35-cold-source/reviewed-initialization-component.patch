+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Original sequential four-worker enrollment, separate from clock/RUN
+ * permission. A selected plan is incomplete until every real actor and CPU
+ * has been observed; no numeric slot creates a native object. */
+
+static bool pic_initializer_roster_request_valid(
+	const struct kvm_crucible_pic_initializer_v2 *request)
+{
+	u32 index;
+
+	if (request->version != 2 || !request->enrollment_id ||
+	    request->native_vcpu_count != KVM_CRUCIBLE_PIC_INITIALIZER_V2_CPUS ||
+	    request->native_vcpu_id >= KVM_CRUCIBLE_PIC_INITIALIZER_V2_CPUS ||
+	    !request->maximum_effects ||
+	    request->maximum_effects > KVM_CRUCIBLE_PIC_INITIALIZER_MAX_EFFECTS ||
+	    request->issued_effects || request->native_result ||
+	    request->native_ioctl || request->flags)
+		return false;
+	for (index = 0; index < ARRAY_SIZE(request->reserved); index++)
+		if (request->reserved[index])
+			return false;
+
+	switch (request->operation) {
+	case KVM_CRUCIBLE_PIC_INITIALIZER_SELECT:
+		return !request->native_vcpu_id && !request->initializer_tid &&
+			!request->effect_index;
+	case KVM_CRUCIBLE_PIC_INITIALIZER_ACTOR_ENROLL:
+		return request->initializer_tid &&
+			request->initializer_tid <= INT_MAX && !request->effect_index;
+	case KVM_CRUCIBLE_PIC_INITIALIZER_ACTOR_QUERY:
+		return request->initializer_tid <= INT_MAX;
+	default:
+		return false;
+	}
+}
+
+static bool pic_initializer_roster_same_request(
+	struct kvm *kvm, const struct kvm_crucible_pic_initializer_v2 *request)
+{
+	struct kvm_crucible_pic_board *board = &kvm->arch.crucible_pic_board;
+
+	return board->initializer_roster.selected &&
+		board->initializer_roster.enrollment_id == request->enrollment_id &&
+		board->initializer_roster.maximum_effects == request->maximum_effects;
+}
+
+static int pic_initializer_roster_report_locked(struct kvm *kvm,
+	struct kvm_crucible_pic_initializer_v2 *request)
+{
+	struct kvm_crucible_pic_board *board = &kvm->arch.crucible_pic_board;
+	const struct kvm_crucible_pic_initializer_state *state =
+		&board->initializer_roster.actors[request->native_vcpu_id];
+	const struct kvm_crucible_pic_initializer_effect *effect;
+
+	if (request->initializer_tid != state->initializer_tid)
+		return -ESTALE;
+	if (request->effect_index > state->issued)
+		return -ENOENT;
+	request->issued_effects = state->issued;
+	request->flags = (state->inflight ?
+		KVM_CRUCIBLE_PIC_INITIALIZER_INFLIGHT : 0) |
+		(state->uncertain || board->initializer_roster.uncertain ?
+		 KVM_CRUCIBLE_PIC_INITIALIZER_UNCERTAIN : 0) |
+		(state->task ? KVM_CRUCIBLE_PIC_INITIALIZER_ACTOR_PRESENT : 0) |
+		(state->vcpu ? KVM_CRUCIBLE_PIC_INITIALIZER_VCPU_PRESENT : 0);
+	if (!request->effect_index)
+		return 0;
+
+	effect = &state->effects[request->effect_index - 1];
+	request->native_ioctl = effect->native_ioctl;
+	request->native_result = effect->native_result;
+	if (effect->known)
+		request->flags |= KVM_CRUCIBLE_PIC_INITIALIZER_KNOWN;
+	return 0;
+}
+
+static int kvm_crucible_pic_initializer_roster_control(struct kvm *kvm,
+	struct kvm_enable_cap *cap)
+{
+	struct kvm_crucible_pic_board *board = &kvm->arch.crucible_pic_board;
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	struct kvm_crucible_pic_initializer_v2 request;
+	struct kvm_crucible_pic_initializer_state *state;
+	struct task_struct *task = NULL;
+	struct mm_struct *mm;
+	void __user *argument = u64_to_user_ptr(cap->args[0]);
+	unsigned long flags;
+	u32 index;
+	int result;
+
+	if (cap->flags || !cap->args[0] || cap->args[1] ||
+	    cap->args[2] || cap->args[3])
+		return -EINVAL;
+	if (copy_from_user(&request, argument, sizeof(request)))
+		return -EFAULT;
+	if (!pic_initializer_roster_request_valid(&request))
+		return -EINVAL;
+
+	if (!mutex_trylock(&clock->control_lock))
+		return -EBUSY;
+	if (!mutex_trylock(&kvm->crucible_configuration_lock)) {
+		mutex_unlock(&clock->control_lock);
+		return -EBUSY;
+	}
+	result = -EPERM;
+	if (board->constructor != current)
+		goto unlock_configuration;
+	result = -EOPNOTSUPP;
+	if (board->edition != KVM_CRUCIBLE_Q35_BOARD_ONLY || board->initialization.task)
+		goto unlock_configuration;
+
+	if (request.operation != KVM_CRUCIBLE_PIC_INITIALIZER_SELECT) {
+		result = -ESTALE;
+		if (!pic_initializer_roster_same_request(kvm, &request))
+			goto unlock_configuration;
+		state = &board->initializer_roster.actors[request.native_vcpu_id];
+		if (request.operation == KVM_CRUCIBLE_PIC_INITIALIZER_ACTOR_QUERY) {
+			result = pic_initializer_roster_report_locked(kvm, &request);
+			goto unlock_configuration;
+		}
+		result = -EALREADY;
+		if (state->task)
+			goto unlock_configuration;
+
+		/* Resolve only this actually born worker once. Cached observations
+		 * never resolve the same numeric TID into a replacement task. */
+		task = find_get_task_by_vpid(request.initializer_tid);
+		result = -ESRCH;
+		if (!task)
+			goto unlock_configuration;
+		mm = get_task_mm(task);
+		result = mm == kvm->mm && same_thread_group(task, current) &&
+			task != current ? 0 : -EPERM;
+		if (mm)
+			mmput(mm);
+		if (result)
+			goto unlock_configuration;
+		for (index = 0; index < KVM_CRUCIBLE_PIC_INITIALIZER_V2_CPUS; index++) {
+			result = -EEXIST;
+			if (board->initializer_roster.actors[index].task == task)
+				goto unlock_configuration;
+		}
+	}
+
+	if (!mutex_trylock(&kvm->lock)) {
+		result = -EBUSY;
+		goto unlock_configuration;
+	}
+	mutex_lock(&kvm->irq_lock);
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	result = -EOPNOTSUPP;
+	if (!pic_initializer_live_locked(kvm) || kvm->crucible_topology_writers)
+		goto unlock_gate;
+
+	if (request.operation == KVM_CRUCIBLE_PIC_INITIALIZER_SELECT) {
+		if (board->initializer_roster.selected || kvm->created_vcpus)
+			goto unlock_gate;
+		board->initializer_roster.enrollment_id = request.enrollment_id;
+		board->initializer_roster.maximum_effects = request.maximum_effects;
+		for (index = 0; index < KVM_CRUCIBLE_PIC_INITIALIZER_V2_CPUS; index++) {
+			state = &board->initializer_roster.actors[index];
+			state->enrollment_id = request.enrollment_id;
+			state->maximum_effects = request.maximum_effects;
+			state->native_vcpu_id = index;
+		}
+		smp_store_release(&board->initializer_roster.selected, true);
+	} else {
+		state = &board->initializer_roster.actors[request.native_vcpu_id];
+		if (state->task || state->issued || state->vcpu ||
+		    kvm->created_vcpus != request.native_vcpu_id)
+			goto unlock_gate;
+		state->initializer_tid = request.initializer_tid;
+		smp_store_release(&state->task, task);
+		task = NULL;
+	}
+	result = pic_initializer_roster_report_locked(kvm, &request);
+
+unlock_gate:
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	mutex_unlock(&kvm->irq_lock);
+	mutex_unlock(&kvm->lock);
+unlock_configuration:
+	mutex_unlock(&kvm->crucible_configuration_lock);
+	mutex_unlock(&clock->control_lock);
+	if (task)
+		put_task_struct(task);
+	/* Selection/enrollment is already immutable if userspace writeback fails. */
+	if (!result && copy_to_user(argument, &request, sizeof(request)))
+		return -EFAULT;
+	return result;
+}
