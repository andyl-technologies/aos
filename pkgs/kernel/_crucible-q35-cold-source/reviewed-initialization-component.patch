+++ b/arch/x86/kvm/crucible-pic-initializer.inc.c
@@ -0,0 +1,772 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Finite initialization effects on the original CPU thread. This component
+ * retains function-return facts, not complete architectural values. The
+ * separate clock/FirstBegin/RUN fences remain unchanged.
+ */
+#include <linux/sched/mm.h>
+
+static bool pic_initializer_request_valid(
+	const struct kvm_crucible_pic_initializer *request)
+{
+	return request->version == 1 && request->enrollment_id &&
+		request->initializer_tid && request->initializer_tid <= INT_MAX &&
+		!request->native_vcpu_id && request->maximum_effects &&
+		request->maximum_effects <= KVM_CRUCIBLE_PIC_INITIALIZER_MAX_EFFECTS &&
+		!request->issued_effects && !request->native_result &&
+		!request->native_ioctl && !request->flags &&
+		!request->reserved[0] && !request->reserved[1] &&
+		!request->reserved[2] &&
+		(request->operation == KVM_CRUCIBLE_PIC_INITIALIZER_QUERY ||
+		 (request->operation == KVM_CRUCIBLE_PIC_INITIALIZER_ENROLL &&
+		  !request->effect_index));
+}
+
+static bool pic_initializer_same_request(
+	const struct kvm_crucible_pic_initializer_state *state,
+	const struct kvm_crucible_pic_initializer *request)
+{
+	return state->task && state->enrollment_id == request->enrollment_id &&
+		state->initializer_tid == request->initializer_tid &&
+		state->maximum_effects == request->maximum_effects;
+}
+
+/* Only the selected source edition chooses the actor table. Numeric CPU
+ * IDs index immutable slots; actual retained task and vCPU refs authorize
+ * execution. The legacy single-CPU table remains a separate source lane. */
+static struct kvm_crucible_pic_initializer_state *
+pic_initializer_actor_state(struct kvm *kvm, struct kvm_vcpu *vcpu)
+{
+	struct kvm_crucible_pic_board *board = &kvm->arch.crucible_pic_board;
+	u32 index;
+
+	if (!smp_load_acquire(&board->initializer_roster.selected))
+		return &board->initialization;
+	if (vcpu) {
+		if (vcpu->vcpu_id >= KVM_CRUCIBLE_PIC_INITIALIZER_V2_CPUS)
+			return NULL;
+		return &board->initializer_roster.actors[vcpu->vcpu_id];
+	}
+	for (index = 0; index < KVM_CRUCIBLE_PIC_INITIALIZER_V2_CPUS; index++)
+		if (smp_load_acquire(&board->initializer_roster.actors[index].task) == current)
+			return &board->initializer_roster.actors[index];
+	return NULL;
+}
+
+static u32 pic_initializer_cpu_count(struct kvm *kvm)
+{
+	return smp_load_acquire(&kvm->arch.crucible_pic_board.initializer_roster.selected) ?
+		KVM_CRUCIBLE_PIC_INITIALIZER_V2_CPUS : 1;
+}
+
+/* configuration -> VM -> irq -> gate, matching the constructor order. The
+ * original writer credit prevents another initialization or a future roster
+ * seal while native allocation/state callbacks run with these locks dropped.
+ */
+static bool pic_initializer_live_locked(struct kvm *kvm)
+{
+	struct kvm_crucible_pic_board *board = &kvm->arch.crucible_pic_board;
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+
+	lockdep_assert_held(&kvm->crucible_configuration_lock);
+	lockdep_assert_held(&kvm->irq_lock);
+	lockdep_assert_held(&kvm->crucible_gate_lock);
+	return board->phase == CRUCIBLE_PIC_BOARD_ENROLLED &&
+		!board->initializer_roster.uncertain &&
+		board->pic == kvm->arch.vpic &&
+		board->ioapic == kvm->arch.vioapic &&
+		board->pit == kvm->arch.vpit &&
+		board->routing == rcu_dereference_protected(kvm->irq_routing, 1) &&
+		!clock->enabled && !clock->active && !clock->run_owners &&
+		!clock->timer_owners && !kvm->crucible_controlled &&
+		!kvm->crucible_continuation_roster_frozen &&
+		!kvm->crucible_irq_input.owners &&
+		!kvm->crucible_irq_input.tainted && !kvm->crucible_memory_tainted &&
+		!READ_ONCE(kvm->vm_dead);
+}
+
+static int pic_initializer_report_locked(
+	const struct kvm_crucible_pic_initializer_state *state,
+	struct kvm_crucible_pic_initializer *request)
+{
+	const struct kvm_crucible_pic_initializer_effect *effect;
+
+	if (request->effect_index > state->issued)
+		return -ENOENT;
+	request->issued_effects = state->issued;
+	request->flags = (state->inflight ?
+		KVM_CRUCIBLE_PIC_INITIALIZER_INFLIGHT : 0) |
+		(state->uncertain ? KVM_CRUCIBLE_PIC_INITIALIZER_UNCERTAIN : 0);
+	if (!request->effect_index)
+		return 0;
+
+	effect = &state->effects[request->effect_index - 1];
+	request->native_ioctl = effect->native_ioctl;
+	request->native_result = effect->native_result;
+	if (effect->known)
+		request->flags |= KVM_CRUCIBLE_PIC_INITIALIZER_KNOWN;
+	return 0;
+}
+
+static int kvm_crucible_pic_initializer_control(struct kvm *kvm,
+	struct kvm_enable_cap *cap)
+{
+	struct kvm_crucible_pic_board *board = &kvm->arch.crucible_pic_board;
+	struct kvm_crucible_pic_initializer_state *state = &board->initialization;
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	struct kvm_crucible_pic_initializer request;
+	struct task_struct *task = NULL;
+	struct mm_struct *mm;
+	void __user *argument = u64_to_user_ptr(cap->args[0]);
+	unsigned long flags;
+	int result;
+
+	if (cap->flags || !cap->args[0] || cap->args[1] ||
+	    cap->args[2] || cap->args[3])
+		return -EINVAL;
+	if (copy_from_user(&request, argument, sizeof(request)))
+		return -EFAULT;
+	if (!pic_initializer_request_valid(&request))
+		return -EINVAL;
+
+	if (!mutex_trylock(&clock->control_lock))
+		return -EBUSY;
+	if (!mutex_trylock(&kvm->crucible_configuration_lock)) {
+		mutex_unlock(&clock->control_lock);
+		return -EBUSY;
+	}
+	/* The actual original constructor owns enrollment and observation.
+	 * A same-number replacement thread never acquires that authority. */
+	result = -EPERM;
+	if (board->edition != KVM_CRUCIBLE_PIC_BOARD_ONLY) {
+		result = -EOPNOTSUPP;
+		goto unlock_configuration;
+	}
+	if (board->constructor != current || board->initializer_roster.selected)
+		goto unlock_configuration;
+	if (state->task) {
+		result = pic_initializer_same_request(state, &request) ?
+			pic_initializer_report_locked(state, &request) : -ESTALE;
+		goto unlock_configuration;
+	}
+	result = -ENOENT;
+	if (request.operation != KVM_CRUCIBLE_PIC_INITIALIZER_ENROLL)
+		goto unlock_configuration;
+
+	/* Resolve the TID once, hold its actual task reference, and establish
+	 * its real address-space relationship. Cached queries never resolve it
+	 * again. An exited original may be retained but cannot execute calls. */
+	task = find_get_task_by_vpid(request.initializer_tid);
+	result = -ESRCH;
+	if (!task)
+		goto unlock_configuration;
+	mm = get_task_mm(task);
+	result = mm == kvm->mm ? 0 : -EPERM;
+	if (mm)
+		mmput(mm);
+	if (result)
+		goto unlock_configuration;
+	if (!mutex_trylock(&kvm->lock)) {
+		result = -EBUSY;
+		goto unlock_configuration;
+	}
+	mutex_lock(&kvm->irq_lock);
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	result = -EOPNOTSUPP;
+	if (pic_initializer_live_locked(kvm) && !kvm->created_vcpus &&
+	    !kvm->crucible_topology_writers && !state->task) {
+		state->task = task;
+		state->enrollment_id = request.enrollment_id;
+		state->initializer_tid = request.initializer_tid;
+		state->maximum_effects = request.maximum_effects;
+		task = NULL;
+		result = pic_initializer_report_locked(state, &request);
+	}
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	mutex_unlock(&kvm->irq_lock);
+	mutex_unlock(&kvm->lock);
+
+unlock_configuration:
+	mutex_unlock(&kvm->crucible_configuration_lock);
+	mutex_unlock(&clock->control_lock);
+	if (task)
+		put_task_struct(task);
+	if (!result && copy_to_user(argument, &request, sizeof(request)))
+		return -EFAULT;
+	return result;
+}
+
+static bool pic_initializer_cpu_operation(unsigned int ioctl)
+{
+	/* GET callbacks can update native bookkeeping, so they consume the
+	 * same finite effect journal as setters. This pre-clock lane admits
+	 * only architectural state: injection, arbitrary capabilities, nested
+	 * execution and MSR timer/device effects need separate input owners. */
+	switch (ioctl) {
+	case KVM_GET_REGS:
+	case KVM_SET_REGS:
+	case KVM_GET_SREGS:
+	case KVM_SET_SREGS:
+	case KVM_GET_MP_STATE:
+	case KVM_SET_MP_STATE:
+	case KVM_SET_CPUID2:
+	case KVM_GET_SREGS2:
+	case KVM_SET_SREGS2:
+	case KVM_GET_FPU:
+	case KVM_SET_FPU:
+	case KVM_GET_XSAVE:
+	case KVM_GET_XSAVE2:
+	case KVM_SET_XSAVE:
+	case KVM_GET_XCRS:
+	case KVM_SET_XCRS:
+	case KVM_GET_VCPU_EVENTS:
+	case KVM_SET_VCPU_EVENTS:
+	case KVM_GET_DEBUGREGS:
+	case KVM_SET_DEBUGREGS:
+	case KVM_GET_TSC_KHZ:
+	case KVM_SET_TSC_KHZ:
+	case KVM_X86_SETUP_MCE:
+	case KVM_GET_MSRS:
+	case KVM_SET_MSRS:
+	case KVM_GET_NESTED_STATE:
+	case KVM_SET_NESTED_STATE:
+		return true;
+	default:
+		return false;
+	}
+}
+
+int kvm_arch_crucible_pic_initializer_enter(struct kvm *kvm,
+	struct kvm_vcpu *vcpu, unsigned int ioctl, unsigned long arg,
+	u32 *effect_index)
+{
+	struct kvm_crucible_pic_initializer_state *state;
+	struct kvm_crucible_pic_initializer_effect *effect;
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	unsigned long flags;
+	int result = -EOPNOTSUPP;
+
+	*effect_index = 0;
+	if ((!vcpu && ioctl != KVM_CREATE_VCPU) ||
+	    (vcpu && !pic_initializer_cpu_operation(ioctl)))
+		return result;
+	if (!mutex_trylock(&clock->control_lock))
+		return -EBUSY;
+	if (!mutex_trylock(&kvm->crucible_configuration_lock)) {
+		mutex_unlock(&clock->control_lock);
+		return -EBUSY;
+	}
+	state = pic_initializer_actor_state(kvm, vcpu);
+	if (!state || (!vcpu && arg != state->native_vcpu_id))
+		goto unlock_configuration;
+	if (!mutex_trylock(&kvm->lock)) {
+		result = -EBUSY;
+		goto unlock_configuration;
+	}
+	mutex_lock(&kvm->irq_lock);
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	if (!pic_initializer_live_locked(kvm) || state->task != current ||
+	    state->uncertain || state->inflight ||
+	    state->issued >= state->maximum_effects ||
+	    kvm->crucible_topology_writers)
+		goto unlock_gate;
+	/* The retained actual CPU pointer is born only at the original native
+	 * create return. VM lifetime owns it; a numeric fd is never authority. */
+	if ((!vcpu && (state->issued || state->vcpu ||
+		   kvm->created_vcpus != state->native_vcpu_id)) ||
+	    (vcpu && (vcpu != state->vcpu ||
+		      vcpu->vcpu_id != state->native_vcpu_id ||
+		      kvm->created_vcpus <= state->native_vcpu_id ||
+		      kvm->created_vcpus > pic_initializer_cpu_count(kvm) ||
+		      kvm_get_vcpu(kvm, state->native_vcpu_id) != vcpu)))
+		goto unlock_gate;
+
+	effect = &state->effects[state->issued++];
+	effect->native_ioctl = ioctl;
+	effect->native_result = -EINPROGRESS;
+	effect->known = false;
+	state->inflight = true;
+	kvm->crucible_topology_writers++;
+	*effect_index = state->issued;
+	result = 0;
+
+unlock_gate:
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	mutex_unlock(&kvm->irq_lock);
+	mutex_unlock(&kvm->lock);
+unlock_configuration:
+	mutex_unlock(&kvm->crucible_configuration_lock);
+	mutex_unlock(&clock->control_lock);
+	return result;
+}
+EXPORT_SYMBOL_FOR_KVM_INTERNAL(kvm_arch_crucible_pic_initializer_enter);
+
+/* The vCPU ioctl already owns this finite native operation. Its gate
+ * retains the same effect row and actual task/vCPU before the callback.
+ * Capture the validated local copy once; never read userspace a second time.
+ */
+static int pic_initializer_snapshot_events(struct kvm_vcpu *vcpu,
+	const struct kvm_vcpu_events *events)
+{
+	struct kvm *kvm = vcpu->kvm;
+	struct kvm_crucible_pic_board *board = &kvm->arch.crucible_pic_board;
+	struct kvm_crucible_pic_initializer_state *state =
+		pic_initializer_actor_state(kvm, vcpu);
+	struct kvm_crucible_pic_initializer_effect *effect;
+	unsigned long flags;
+	int result = -EOPNOTSUPP;
+
+	if (!kvm_arch_crucible_pic_board_fenced(kvm))
+		return 0;
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	if (!state || board->initializer_roster.uncertain ||
+	    board->phase != CRUCIBLE_PIC_BOARD_ENROLLED ||
+	    !state->inflight || state->uncertain || state->task != current ||
+	    state->vcpu != vcpu || kvm->crucible_topology_writers != 1 ||
+	    !state->issued || state->issued > state->maximum_effects)
+		goto unlock_gate;
+
+	effect = &state->effects[state->issued - 1];
+	if (effect->native_ioctl != KVM_SET_VCPU_EVENTS ||
+	    effect->input_events_known)
+		goto unlock_gate;
+	memcpy(&effect->input_events, events, sizeof(*events));
+	effect->input_events_known = true;
+	result = 0;
+
+unlock_gate:
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	return result;
+}
+
+/* Reset admission owns no nested guest, timer deadline, SMM or eVMCS
+ * publication. Both original vendor reset branches retire nested bookkeeping
+ * and return before reading payload; later restore requires its own owner. */
+static bool pic_initializer_nested_reset_valid(
+	const struct kvm_nested_state *input)
+{
+	struct kvm_nested_state reset;
+
+	memset(&reset, 0, sizeof(reset));
+	reset.size = input->size;
+	reset.format = input->format;
+	if (input->format == KVM_STATE_NESTED_FORMAT_VMX) {
+		reset.hdr.vmx.vmxon_pa = ~0ULL;
+		reset.hdr.vmx.vmcs12_pa = ~0ULL;
+	} else if (input->format != KVM_STATE_NESTED_FORMAT_SVM) {
+		return false;
+	}
+	return !memcmp(input, &reset, sizeof(reset));
+}
+
+static struct kvm_crucible_pic_initializer_effect *
+pic_initializer_nested_effect_locked(struct kvm_vcpu *vcpu)
+{
+	struct kvm *kvm = vcpu->kvm;
+	struct kvm_crucible_pic_board *board = &kvm->arch.crucible_pic_board;
+	struct kvm_crucible_pic_initializer_state *state =
+		pic_initializer_actor_state(kvm, vcpu);
+	struct kvm_crucible_pic_initializer_effect *effect;
+
+	lockdep_assert_held(&kvm->crucible_gate_lock);
+	if (!state || board->initializer_roster.uncertain ||
+	    board->phase != CRUCIBLE_PIC_BOARD_ENROLLED ||
+	    !state->inflight || state->uncertain || state->task != current ||
+	    state->vcpu != vcpu || kvm->crucible_topology_writers != 1 ||
+	    !state->issued || state->issued > state->maximum_effects)
+		return NULL;
+	effect = &state->effects[state->issued - 1];
+	if (effect->native_ioctl != KVM_SET_NESTED_STATE ||
+	    effect->input_nested_known)
+		return NULL;
+	return effect;
+}
+
+/* The fixed header has already been copied exactly once. Capture only its
+ * tail from userspace, then bind the immutable whole buffer to this same
+ * original effect. Vendor callbacks consume this buffer, never a second
+ * userspace read. No allocation or user fault occurs under the native gate. */
+static int pic_initializer_snapshot_nested(struct kvm_vcpu *vcpu,
+	const struct kvm_nested_state *header,
+	const struct kvm_nested_state __user *user_state,
+	const struct kvm_nested_state **owned_state)
+{
+	struct kvm *kvm = vcpu->kvm;
+	struct kvm_crucible_pic_initializer_state *state =
+		pic_initializer_actor_state(kvm, vcpu);
+	struct kvm_crucible_pic_initializer_effect *effect;
+	struct kvm_nested_state *input;
+	unsigned long flags;
+	int result = -EOPNOTSUPP;
+
+	*owned_state = NULL;
+	if (!kvm_arch_crucible_pic_board_fenced(kvm))
+		return 0;
+	if (header->size < sizeof(*header) ||
+	    header->size > KVM_CRUCIBLE_PIC_INITIALIZER_MAX_NESTED_BYTES ||
+	    !pic_initializer_nested_reset_valid(header))
+		return result;
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	effect = pic_initializer_nested_effect_locked(vcpu);
+	if (effect && state->input_bytes <=
+	    KVM_CRUCIBLE_PIC_INITIALIZER_MAX_INPUT_BYTES - header->size)
+		result = 0;
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	if (result)
+		return result;
+
+	input = kmalloc(header->size, GFP_KERNEL);
+	if (!input)
+		return -ENOMEM;
+	memcpy(input, header, sizeof(*header));
+	if (copy_from_user((u8 *)input + sizeof(*header),
+			   (const u8 __user *)user_state + sizeof(*header),
+			   header->size - sizeof(*header))) {
+		kfree(input);
+		return -EFAULT;
+	}
+
+	result = -EOPNOTSUPP;
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	effect = pic_initializer_nested_effect_locked(vcpu);
+	if (effect && state->input_bytes <=
+	    KVM_CRUCIBLE_PIC_INITIALIZER_MAX_INPUT_BYTES - header->size) {
+		effect->input_nested = input;
+		effect->input_nested_bytes = header->size;
+		effect->input_nested_known = true;
+		state->input_bytes += header->size;
+		*owned_state = input;
+		result = 0;
+	}
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	if (result)
+		kfree(input);
+	return result;
+}
+
+/* Native common/vendor architectural setters may update MMU and CPU
+ * bookkeeping under the same original operation. Clock/IRQ/RAM-producing
+ * MSRs are admitted only in their disabled form. PMU programming, x2APIC
+ * writes, Hyper-V/Xen and unknown families require separate source owners. */
+static bool pic_initializer_msr_entry_valid(const struct kvm_msr_entry *entry,
+	bool write)
+{
+	if (entry->reserved)
+		return false;
+	switch (entry->index) {
+	case MSR_IA32_SYSENTER_CS:
+	case MSR_IA32_SYSENTER_ESP:
+	case MSR_IA32_SYSENTER_EIP:
+	case MSR_STAR:
+	case MSR_LSTAR:
+	case MSR_CSTAR:
+	case MSR_SYSCALL_MASK:
+	case MSR_KERNEL_GS_BASE:
+	case MSR_TSC_AUX:
+	case MSR_IA32_TSC:
+	case MSR_IA32_TSC_ADJUST:
+	case MSR_AMD64_TSC_RATIO:
+	case MSR_EFER:
+	case MSR_IA32_CR_PAT:
+	case MSR_IA32_APICBASE:
+	case MSR_IA32_MISC_ENABLE:
+	case MSR_IA32_SMBASE:
+	case MSR_SMI_COUNT:
+	case MSR_IA32_FEAT_CTL:
+	case MSR_IA32_UCODE_REV:
+	case MSR_IA32_ARCH_CAPABILITIES:
+	case MSR_IA32_CORE_CAPS:
+	case MSR_IA32_XSS:
+	case MSR_IA32_UMWAIT_CONTROL:
+	case MSR_IA32_SPEC_CTRL:
+	case MSR_IA32_TSX_CTRL:
+	case MSR_AMD64_VIRT_SPEC_CTRL:
+	case MSR_K7_HWCR:
+	case MSR_VM_HSAVE_PA:
+	case MSR_IA32_BNDCFGS:
+	case MSR_IA32_XFD:
+	case MSR_IA32_XFD_ERR:
+	case MSR_IA32_U_CET:
+	case MSR_IA32_S_CET:
+	case MSR_IA32_PL0_SSP ... MSR_IA32_PL3_SSP:
+	case MSR_IA32_INT_SSP_TAB:
+	case MSR_IA32_VMX_BASIC ... MSR_IA32_VMX_VMFUNC:
+	case MTRRphysBase_MSR(0) ... MSR_MTRRfix4K_F8000:
+	case MSR_MTRRdefType:
+	case MSR_IA32_MCG_CTL:
+	case MSR_IA32_MCG_STATUS:
+	case MSR_IA32_MCG_EXT_CTL:
+	case MSR_IA32_MC0_CTL ... MSR_IA32_MCx_CTL(KVM_MAX_MCE_BANKS) - 1:
+	case MSR_IA32_MC0_CTL2 ... MSR_IA32_MCx_CTL2(KVM_MAX_MCE_BANKS) - 1:
+		return true;
+	case MSR_IA32_PERF_CAPABILITIES:
+		return !write;
+	case MSR_IA32_TSC_DEADLINE:
+	case MSR_KVM_WALL_CLOCK:
+	case MSR_KVM_WALL_CLOCK_NEW:
+	case MSR_KVM_SYSTEM_TIME:
+	case MSR_KVM_SYSTEM_TIME_NEW:
+	case MSR_KVM_ASYNC_PF_EN:
+	case MSR_KVM_ASYNC_PF_INT:
+	case MSR_KVM_PV_EOI_EN:
+	case MSR_KVM_STEAL_TIME:
+	case MSR_IA32_PRED_CMD:
+	case MSR_IA32_FLUSH_CMD:
+		return !write || !entry->data;
+	case MSR_KVM_POLL_CONTROL:
+		return !write || entry->data <= 1;
+	default:
+		return false;
+	}
+}
+
+static struct kvm_crucible_pic_initializer_effect *
+pic_initializer_msr_effect_locked(struct kvm_vcpu *vcpu, bool write)
+{
+	struct kvm *kvm = vcpu->kvm;
+	struct kvm_crucible_pic_board *board = &kvm->arch.crucible_pic_board;
+	struct kvm_crucible_pic_initializer_state *state =
+		pic_initializer_actor_state(kvm, vcpu);
+	struct kvm_crucible_pic_initializer_effect *effect;
+
+	lockdep_assert_held(&kvm->crucible_gate_lock);
+	if (!state || board->initializer_roster.uncertain ||
+	    board->phase != CRUCIBLE_PIC_BOARD_ENROLLED ||
+	    !state->inflight || state->uncertain || state->task != current ||
+	    state->vcpu != vcpu || kvm->crucible_topology_writers != 1 ||
+	    !state->issued || state->issued > state->maximum_effects)
+		return NULL;
+	effect = &state->effects[state->issued - 1];
+	if (effect->native_ioctl != (write ? KVM_SET_MSRS : KVM_GET_MSRS))
+		return NULL;
+	return effect;
+}
+
+/* Both buffers are allocated before any native callback. The admission
+ * predicate scans the exact memdup_user entries subsequently consumed by
+ * __msr_io; immutable input history never shares its mutable getter outputs. */
+static int pic_initializer_snapshot_msrs(struct kvm_vcpu *vcpu,
+	const struct kvm_msrs *header, const struct kvm_msr_entry *entries,
+	bool write)
+{
+	struct kvm *kvm;
+	struct kvm_crucible_pic_initializer_state *state;
+	struct kvm_crucible_pic_initializer_effect *effect;
+	struct kvm_msrs *input, *output;
+	unsigned long flags;
+	u32 index, bytes;
+	int result = -EOPNOTSUPP;
+
+	if (!vcpu || !kvm_arch_crucible_pic_board_fenced(vcpu->kvm))
+		return 0;
+	if (header->pad || header->nmsrs >= MAX_IO_MSRS)
+		return result;
+	for (index = 0; index < header->nmsrs; index++)
+		if (!pic_initializer_msr_entry_valid(&entries[index], write))
+			return result;
+
+	kvm = vcpu->kvm;
+	state = pic_initializer_actor_state(kvm, vcpu);
+	bytes = sizeof(*header) + header->nmsrs * sizeof(*entries);
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	effect = pic_initializer_msr_effect_locked(vcpu, write);
+	if (effect && !effect->input_msrs_known && state->input_bytes <=
+	    KVM_CRUCIBLE_PIC_INITIALIZER_MAX_INPUT_BYTES - 2 * bytes)
+		result = 0;
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	if (result)
+		return result;
+
+	input = kmalloc(bytes, GFP_KERNEL);
+	if (!input)
+		return -ENOMEM;
+	output = kmalloc(bytes, GFP_KERNEL);
+	if (!output) {
+		kfree(input);
+		return -ENOMEM;
+	}
+	memcpy(input, header, sizeof(*header));
+	memcpy(input->entries, entries, bytes - sizeof(*header));
+	memcpy(output, header, sizeof(*header));
+
+	result = -EOPNOTSUPP;
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	effect = pic_initializer_msr_effect_locked(vcpu, write);
+	if (effect && !effect->input_msrs_known && state->input_bytes <=
+	    KVM_CRUCIBLE_PIC_INITIALIZER_MAX_INPUT_BYTES - 2 * bytes) {
+		effect->input_msrs = input;
+		effect->output_msrs = output;
+		effect->native_msr_write = write;
+		effect->input_msrs_known = true;
+		state->input_bytes += 2 * bytes;
+		result = 0;
+	}
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	if (result) {
+		kfree(output);
+		kfree(input);
+	}
+	return result;
+}
+
+static int pic_initializer_complete_msrs(struct kvm_vcpu *vcpu,
+	const struct kvm_msrs *header, const struct kvm_msr_entry *entries,
+	bool write, long native_result)
+{
+	struct kvm_crucible_pic_initializer_effect *effect;
+	struct kvm *kvm;
+	unsigned long flags;
+	int result = -EOPNOTSUPP;
+
+	if (!vcpu || !kvm_arch_crucible_pic_board_fenced(vcpu->kvm))
+		return 0;
+	kvm = vcpu->kvm;
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	effect = pic_initializer_msr_effect_locked(vcpu, write);
+	if (effect && effect->input_msrs_known && effect->input_msrs &&
+	    effect->output_msrs && !effect->output_msrs_known &&
+	    effect->native_msr_write == write &&
+	    !memcmp(header, effect->input_msrs, sizeof(*header))) {
+		memcpy(effect->output_msrs->entries, entries,
+		       header->nmsrs * sizeof(*entries));
+		effect->native_msr_result = native_result;
+		effect->output_msrs_known = true;
+		result = 0;
+	}
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	return result;
+}
+
+static void pic_initializer_release_actor_inputs(
+	struct kvm_crucible_pic_initializer_state *state)
+{
+	u32 index;
+
+	for (index = 0; index < state->issued; index++) {
+		kfree(state->effects[index].output_msrs);
+		kfree(state->effects[index].input_msrs);
+		kfree(state->effects[index].input_nested);
+	}
+}
+
+static void pic_initializer_release_inputs(struct kvm *kvm)
+{
+	struct kvm_crucible_pic_board *board = &kvm->arch.crucible_pic_board;
+	u32 index;
+
+	/* VM/file lifetime has retired every native callback and vCPU first. */
+	pic_initializer_release_actor_inputs(&board->initialization);
+	for (index = 0; index < KVM_CRUCIBLE_PIC_INITIALIZER_V2_CPUS; index++)
+		pic_initializer_release_actor_inputs(&board->initializer_roster.actors[index]);
+}
+
+/* CREATE returns a descriptor and GET_TSC_KHZ returns a positive frequency.
+ * Every other admitted architectural operation has an exact zero-success
+ * contract. A malformed positive setter result must become sticky Unknown
+ * before writer credit release or containment, just like a negative result.
+ */
+static bool pic_initializer_native_result_known(unsigned int ioctl,
+	long native_result)
+{
+	if (ioctl == KVM_CREATE_VCPU)
+		return native_result >= 0;
+	if (ioctl == KVM_GET_TSC_KHZ)
+		return native_result > 0;
+	if (ioctl == KVM_GET_MSRS || ioctl == KVM_SET_MSRS)
+		return native_result >= 0;
+	return native_result == 0;
+}
+
+static struct kvm_crucible_pic_initializer_state *
+pic_initializer_finish_state_locked(struct kvm *kvm, struct kvm_vcpu *vcpu)
+{
+	struct kvm_crucible_pic_board *board = &kvm->arch.crucible_pic_board;
+	struct kvm_crucible_pic_initializer_state *state;
+	u32 index;
+
+	lockdep_assert_held(&kvm->crucible_gate_lock);
+	state = pic_initializer_actor_state(kvm, vcpu);
+	if (state && state->inflight)
+		return state;
+	if (board->initializer_roster.selected) {
+		for (index = 0; index < KVM_CRUCIBLE_PIC_INITIALIZER_V2_CPUS; index++)
+			if (board->initializer_roster.actors[index].inflight)
+				return &board->initializer_roster.actors[index];
+	}
+	return state ? state : &board->initialization;
+}
+
+long kvm_arch_crucible_pic_initializer_finish(struct kvm *kvm,
+	struct kvm_vcpu *vcpu, unsigned int ioctl, u32 effect_index,
+	long native_result)
+{
+	struct kvm_crucible_pic_initializer_state *state;
+	struct kvm_crucible_pic_initializer_effect *effect;
+	struct kvm_vcpu *original;
+	unsigned long flags;
+	bool known;
+
+	mutex_lock(&kvm->crucible_configuration_lock);
+	mutex_lock(&kvm->lock);
+	mutex_lock(&kvm->irq_lock);
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	state = pic_initializer_finish_state_locked(kvm, vcpu);
+	/* Every caller holds the VM/file reference across the native function.
+	 * Reconcile the original row before credit release, wake or containment.
+	 * A function-return receipt does not authenticate the input register bytes.
+	 */
+	known = effect_index && effect_index == state->issued &&
+		state->inflight && state->task == current &&
+		kvm->crucible_topology_writers == 1 &&
+		pic_initializer_live_locked(kvm) &&
+		pic_initializer_native_result_known(ioctl, native_result);
+	if (effect_index && effect_index <= state->issued) {
+		effect = &state->effects[effect_index - 1];
+		known = known && effect->native_ioctl == ioctl;
+		if (ioctl == KVM_SET_VCPU_EVENTS)
+			known = known && effect->input_events_known;
+		if (ioctl == KVM_SET_NESTED_STATE)
+			known = known && effect->input_nested_known &&
+				effect->input_nested &&
+				effect->input_nested_bytes == effect->input_nested->size;
+		if (ioctl == KVM_GET_MSRS || ioctl == KVM_SET_MSRS)
+			known = known && effect->input_msrs_known &&
+				effect->output_msrs_known && effect->input_msrs &&
+				effect->output_msrs &&
+				effect->native_msr_write == (ioctl == KVM_SET_MSRS) &&
+				effect->native_msr_result == effect->input_msrs->nmsrs &&
+				native_result == effect->native_msr_result;
+		original = vcpu ? vcpu : kvm_get_vcpu(kvm, state->native_vcpu_id);
+		known = known && original &&
+			original->vcpu_id == state->native_vcpu_id &&
+			kvm->created_vcpus > state->native_vcpu_id &&
+			kvm->created_vcpus <= pic_initializer_cpu_count(kvm) &&
+			kvm_get_vcpu(kvm, state->native_vcpu_id) == original &&
+			(vcpu ? state->vcpu == original : !state->vcpu);
