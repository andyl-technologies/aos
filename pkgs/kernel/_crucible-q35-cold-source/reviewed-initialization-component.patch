+/* SPDX-License-Identifier: GPL-2.0-only */
+/* One original constructor-owned RAM registration before CPU birth/clock.
+ * This retains native call/publication facts. It does not freeze userspace
+ * bytes, close direct RAM writers, issue a board clock or permit guest entry.
+ */
+#define PIC_MEMORY_BOARD_ENROLLED 2
+
+static bool pic_memory_request_valid(
+	const struct kvm_crucible_pic_memory_initialization *request)
+{
+	return request->version == 1 && request->request_id &&
+		(request->operation == KVM_CRUCIBLE_PIC_MEMORY_REGISTER ||
+		 request->operation == KVM_CRUCIBLE_PIC_MEMORY_QUERY) &&
+		request->userspace_addr && request->memory_size &&
+		!(request->userspace_addr & (PAGE_SIZE - 1)) &&
+		!(request->memory_size & (PAGE_SIZE - 1)) &&
+		request->memory_size <= KVM_CRUCIBLE_PIC_MEMORY_MAX_BYTES &&
+		request->memory_size <= ULONG_MAX &&
+		request->userspace_addr <= ULONG_MAX - request->memory_size &&
+		!request->slot && !request->native_result && !request->flags &&
+		!request->reserved[0] && !request->reserved[1] &&
+		!request->reserved[2] && !request->reserved[3];
+}
+
+static bool pic_memory_same_request(
+	const struct kvm_crucible_pic_memory_state *state,
+	const struct kvm_crucible_pic_memory_initialization *request)
+{
+	return state->original.request_id == request->request_id &&
+		state->original.userspace_addr == request->userspace_addr &&
+		state->original.memory_size == request->memory_size;
+}
+
+static bool pic_memory_live_locked(struct kvm *kvm)
+{
+	struct kvm_crucible_pic_board *board = &kvm->arch.crucible_pic_board;
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+
+	lockdep_assert_held(&clock->control_lock);
+	lockdep_assert_held(&kvm->crucible_configuration_lock);
+	lockdep_assert_held(&kvm->lock);
+	lockdep_assert_held(&kvm->irq_lock);
+	lockdep_assert_held(&kvm->crucible_gate_lock);
+	return board->phase == PIC_MEMORY_BOARD_ENROLLED &&
+		board->constructor == current &&
+		board->pic == kvm->arch.vpic && board->pit == kvm->arch.vpit &&
+		board->ioapic == kvm->arch.vioapic &&
+		board->routing == rcu_dereference_protected(kvm->irq_routing, 1) &&
+		!board->initialization.task && !kvm->created_vcpus &&
+		!clock->enabled && !clock->active && !clock->run_owners &&
+		!clock->timer_owners && !kvm->crucible_controlled &&
+		!kvm->crucible_continuation_roster_frozen &&
+		!kvm->crucible_irq_input.owners &&
+		!kvm->crucible_irq_input.tainted && !kvm->crucible_memory_tainted &&
+		!READ_ONCE(kvm->vm_dead);
+}
+
+static void pic_memory_report(
+	const struct kvm_crucible_pic_memory_state *state,
+	struct kvm_crucible_pic_memory_initialization *request)
+{
+	request->native_result = state->native_result;
+	request->flags = (state->known ? KVM_CRUCIBLE_PIC_MEMORY_KNOWN : 0) |
+		(state->inflight ? KVM_CRUCIBLE_PIC_MEMORY_INFLIGHT : 0) |
+		(state->uncertain ? KVM_CRUCIBLE_PIC_MEMORY_UNCERTAIN : 0);
+}
+
+static int kvm_crucible_pic_memory_control(struct kvm *kvm,
+	struct kvm_enable_cap *cap)
+{
+	struct kvm_crucible_pic_board *board = &kvm->arch.crucible_pic_board;
+	struct kvm_crucible_pic_memory_state *state = &board->memory;
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	struct kvm_crucible_pic_memory_initialization request;
+	struct kvm_userspace_memory_region2 memory = { 0 };
+	struct kvm_memory_slot *slot;
+	void __user *argument = u64_to_user_ptr(cap->args[0]);
+	unsigned long flags;
+	bool entered = false, published = false, contain = false;
+	int native_result = -EINPROGRESS;
+	int result;
