+static int kvm_crucible_board_construct(struct kvm *kvm,
+	struct kvm_enable_cap *cap, u32 edition)
+{
+#ifdef CONFIG_KVM_IOAPIC
+	struct kvm_crucible_pic_board *board = &kvm->arch.crucible_pic_board;
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	struct kvm_irq_routing_entry route = {
+		.gsi = 0,
+		.type = KVM_IRQ_ROUTING_IRQCHIP,
+		.u.irqchip = { .irqchip = KVM_IRQCHIP_PIC_MASTER, .pin = 0 },
+	};
+	unsigned long flags;
+	unsigned int bus_index;
+	int result;
+	bool entered = false;
+
+	if (cap->flags || cap->args[0] != edition ||
+	    cap->args[1] || cap->args[2] || cap->args[3])
+		return -EINVAL;
+	/* Existing control ordering is clock->configuration->VM. Nonblocking
+	 * acquisition refuses contention before original construction effects. */
+	if (!mutex_trylock(&clock->control_lock))
+		return -EBUSY;
+	if (!mutex_trylock(&kvm->crucible_configuration_lock)) {
+		mutex_unlock(&clock->control_lock);
+		return -EBUSY;
+	}
+	if (!mutex_trylock(&kvm->lock)) {
+		result = -EBUSY;
+		goto unlock_configuration;
+	}
+	if (board->phase) {
+		/* Only the same retained original task can recover the constructor
+		 * result. This is a call receipt, not a live device-state query. */
+		result = board->constructor != current ? -EPERM :
+			board->edition != edition ? -ESTALE : board->result;
+		goto unlock_vm;
+	}
+	result = -EOPNOTSUPP;
+	if (kvm->created_vcpus || clock->enabled || kvm->crucible_controlled ||
+	    kvm->crucible_topology_writers || kvm->arch.vpic ||
+	    kvm->arch.vioapic || kvm->arch.vpit || irqchip_in_kernel(kvm) ||
+	    !list_empty(&kvm->devices) || kvm->arch.has_protected_eoi ||
+	    enable_vmware_backdoor)
+		goto unlock_vm;
+	mutex_lock(&kvm->slots_lock);
+	result = list_empty(&kvm->ioeventfds) ? 0 : -EOPNOTSUPP;
+#ifdef CONFIG_KVM_MMIO
+	if (!list_empty(&kvm->coalesced_zones))
+		result = -EOPNOTSUPP;
+#endif
+	for (bus_index = 0; bus_index < KVM_NR_BUSES; bus_index++) {
+		struct kvm_io_bus *bus = kvm_get_bus(kvm, bus_index);
+
+		if (!bus || bus->dev_count || bus->ioeventfd_count)
+			result = -EOPNOTSUPP;
+	}
+	mutex_unlock(&kvm->slots_lock);
+#ifdef CONFIG_HAVE_KVM_IRQCHIP
+	spin_lock_irqsave(&kvm->irqfds.lock, flags);
+	if (!list_empty(&kvm->irqfds.items))
+		result = -EOPNOTSUPP;
+	spin_unlock_irqrestore(&kvm->irqfds.lock, flags);
+#endif
+#ifdef CONFIG_KVM_XEN
+	if (kvm->arch.xen.hvm_config.msr || kvm->arch.xen.hvm_config.flags)
+		result = -EOPNOTSUPP;
+#endif
+	if (result)
+		goto unlock_vm;
+
+	/* Pre-reserve the sole original request before native constructors. A
+	 * partial allocation/publication cannot be repeated as a fresh request. */
+	mutex_lock(&kvm->irq_lock);
+	{
+		struct kvm_irq_routing_table *original =
+			rcu_dereference_protected(kvm->irq_routing, 1);
+
+		/* A caller-provided route is not silently replaced or adopted. */
+		if (!original || original->nr_rt_entries != 1 ||
+		    !hlist_empty(&original->map[0])) {
+			mutex_unlock(&kvm->irq_lock);
+			result = -EOPNOTSUPP;
+			goto unlock_vm;
+		}
+	}
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	if (kvm->crucible_irq_input.owners || kvm->crucible_irq_input.enabled ||
+	    kvm->crucible_irq_input.tainted || kvm->crucible_memory_tainted) {
+		raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+		mutex_unlock(&kvm->irq_lock);
+		result = -EOPNOTSUPP;
+		goto unlock_vm;
+	}
+	/* This gate also orders native source entry: a source which entered
+	 * before the cut retains an owner, and a later source cannot dispatch. */
+	get_task_struct(current);
+	board->constructor = current;
+	board->edition = edition;
+	board->result = -EIO;
+	smp_store_release(&board->phase, CRUCIBLE_PIC_BOARD_BUILDING);
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	mutex_unlock(&kvm->irq_lock);
+	entered = true;
+	result = kvm_pic_init(kvm);
+	if (result)
+		goto original_finish;
+	result = kvm_ioapic_init(kvm);
+	if (result)
+		goto original_finish;
+	smp_wmb();
+	kvm->arch.irqchip_mode = KVM_IRQCHIP_KERNEL;
+	kvm_set_apicv_inhibit(kvm, APICV_INHIBIT_REASON_DISABLED);
+	/* The q35 edition preserves the native dual PIC/IOAPIC routes.
+	 * It never borrows the single-route V1 constructor result. */
+	result = edition == KVM_CRUCIBLE_Q35_BOARD_ONLY ?
+		kvm_setup_default_ioapic_and_pic_routing(kvm) :
+		kvm_set_irq_routing(kvm, &route, 1, 0);
+	if (result)
+		goto original_finish;
+	kvm->arch.vpit = kvm_create_pit(kvm, 0);
+	if (!kvm->arch.vpit) {
+		result = -ENOMEM;
+		goto original_finish;
+	}
+	if (!pic_board_fresh_devices(kvm)) {
+		result = -ESTALE;
+		goto original_finish;
+	}
+	result = pic_board_capture_birth(kvm);
+	if (result)
+		goto original_finish;
+	mutex_lock(&kvm->irq_lock);
+	if (!(edition == KVM_CRUCIBLE_Q35_BOARD_ONLY ?
+	      q35_board_default_routes(kvm, &board->routing) :
+	      pic_board_only_route(kvm, &board->routing))) {
+		mutex_unlock(&kvm->irq_lock);
+		result = -ESTALE;
+		goto original_finish;
+	}
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	/* A rejected source may have contained this VM during allocation.
+	 * The original cut must still hold at the enrollment publication. */
+	if (board->phase != CRUCIBLE_PIC_BOARD_BUILDING ||
+	    board->constructor != current || kvm->crucible_irq_input.owners ||
+	    kvm->crucible_irq_input.tainted || kvm->crucible_memory_tainted ||
+	    READ_ONCE(kvm->vm_dead)) {
+		raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+		mutex_unlock(&kvm->irq_lock);
+		result = -EAGAIN;
+		goto original_finish;
+	}
+	board->pic = kvm->arch.vpic;
+	board->ioapic = kvm->arch.vioapic;
+	board->pit = kvm->arch.vpit;
+	board->birth.known = true;
+	board->result = 0;
+	smp_store_release(&board->phase, CRUCIBLE_PIC_BOARD_ENROLLED);
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	mutex_unlock(&kvm->irq_lock);
+	result = 0;
+
+original_finish:
+	if (result) {
+		board->result = result;
+		smp_store_release(&board->phase, CRUCIBLE_PIC_BOARD_UNKNOWN);
+	}
+unlock_vm:
+	mutex_unlock(&kvm->lock);
+unlock_configuration:
+	mutex_unlock(&kvm->crucible_configuration_lock);
+	mutex_unlock(&clock->control_lock);
+	if (entered && result)
+		kvm_vm_dead(kvm);
+	return result;
+#else
+	return -EOPNOTSUPP;
+#endif
+}
+
+static int kvm_crucible_pic_board_construct(struct kvm *kvm,
+	struct kvm_enable_cap *cap)
+{
+	return kvm_crucible_board_construct(kvm, cap, KVM_CRUCIBLE_PIC_BOARD_ONLY);
+}
+
+static int kvm_crucible_q35_board_construct(struct kvm *kvm,
+	struct kvm_enable_cap *cap)
+{
+	return kvm_crucible_board_construct(kvm, cap, KVM_CRUCIBLE_Q35_BOARD_ONLY);
+}
