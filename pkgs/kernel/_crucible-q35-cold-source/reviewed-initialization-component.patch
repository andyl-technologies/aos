+	}
+	mutex_unlock(&kvm->slots_lock);
+
+	mutex_lock(&kvm->crucible_configuration_lock);
+	mutex_lock(&kvm->lock);
+	mutex_lock(&kvm->irq_lock);
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	state->native_result = native_result;
+	state->known = !native_result && published &&
+		state->inflight && pic_memory_same_request(state, &request) &&
+		pic_memory_live_locked(kvm) && kvm->crucible_topology_writers == 1;
+	state->uncertain = !state->known;
+	contain = state->uncertain;
+	if (contain)
+		kvm->crucible_memory_tainted = true;
+	/* The same original row becomes Unknown before its credit, wake or
+	 * containment can escape. The native call is never rolled back here. */
+	state->inflight = false;
+	if (kvm->crucible_topology_writers)
+		kvm->crucible_topology_writers--;
+	pic_memory_report(state, &request);
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	mutex_unlock(&kvm->irq_lock);
+	mutex_unlock(&kvm->lock);
+	result = 0;
+
+unlock_configuration:
+	mutex_unlock(&kvm->crucible_configuration_lock);
+unlock_control:
+	mutex_unlock(&clock->control_lock);
+	if (contain)
+		kvm_vm_dead(kvm);
+	if (!result && copy_to_user(argument, &request, sizeof(request)))
+		return -EFAULT;
+	return result;
+}
