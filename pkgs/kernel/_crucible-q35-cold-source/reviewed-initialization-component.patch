+/* SPDX-License-Identifier: GPL-2.0-only */
+/* A separate finite constructor edition. It creates actual native devices and
+ * one PIC route before any vCPU or custom clock. The existing clock/FirstBegin
+ * refusals remain: this journal is not a usable-board or guest-entry issuer. */
+#include <linux/kthread.h>
+#include <linux/sched/task.h>
+
+#define CRUCIBLE_PIC_BOARD_BUILDING 1
+#define CRUCIBLE_PIC_BOARD_ENROLLED 2
+#define CRUCIBLE_PIC_BOARD_UNKNOWN 3
+
+bool kvm_arch_crucible_pic_board_fenced(struct kvm *kvm)
+{
+	return smp_load_acquire(&kvm->arch.crucible_pic_board.phase) != 0;
+}
+EXPORT_SYMBOL_FOR_KVM_INTERNAL(kvm_arch_crucible_pic_board_fenced);
+
+bool kvm_arch_crucible_pic_board_route_allowed(struct kvm *kvm)
+{
+	struct kvm_crucible_pic_board *board = &kvm->arch.crucible_pic_board;
+	u32 phase = smp_load_acquire(&board->phase);
+
+	return !phase || (phase == CRUCIBLE_PIC_BOARD_BUILDING &&
+		READ_ONCE(board->constructor) == current);
+}
+EXPORT_SYMBOL_FOR_KVM_INTERNAL(kvm_arch_crucible_pic_board_route_allowed);
+
+#ifdef CONFIG_KVM_IOAPIC
+/* irq_lock retains the actual publication, including a routing writer which
+ * entered before enrollment. No public pointer/address is adopted here. */
+static bool pic_board_only_route(struct kvm *kvm,
+	struct kvm_irq_routing_table **original)
+{
+	struct kvm_irq_routing_table *table;
+	struct kvm_kernel_irq_routing_entry *entry;
+	unsigned int count = 0;
+
+	lockdep_assert_held(&kvm->irq_lock);
+	table = rcu_dereference_protected(kvm->irq_routing, 1);
+	if (!table || table->nr_rt_entries != 1)
+		return false;
+	hlist_for_each_entry(entry, &table->map[0], link) {
+		if (++count != 1 || entry->gsi ||
+		    entry->type != KVM_IRQ_ROUTING_IRQCHIP ||
+		    entry->irqchip.irqchip != KVM_IRQCHIP_PIC_MASTER ||
+		    entry->irqchip.pin || entry->set != kvm_pic_set_irq)
+			return false;
+	}
+	if (count != 1)
+		return false;
+	*original = table;
+	return true;
+}
+
+/* This is the actual native post-publication table, not a declared route
+ * roster. PIC slave pins are normalized by kvm_set_routing_entry to 8..15. */
+static bool q35_board_default_routes(struct kvm *kvm,
+	struct kvm_irq_routing_table **original)
+{
+	struct kvm_irq_routing_table *table;
+	struct kvm_kernel_irq_routing_entry *entry;
+	u32 gsi;
+
+	lockdep_assert_held(&kvm->irq_lock);
+	table = rcu_dereference_protected(kvm->irq_routing, 1);
+	if (!table || table->nr_rt_entries != KVM_IOAPIC_NUM_PINS)
+		return false;
+	for (gsi = 0; gsi < KVM_IOAPIC_NUM_PINS; gsi++) {
+		u32 chips = 0;
+
+		hlist_for_each_entry(entry, &table->map[gsi], link) {
+			u32 chip = entry->irqchip.irqchip;
+
+			if (entry->gsi != gsi || entry->type != KVM_IRQ_ROUTING_IRQCHIP ||
+			    entry->irqchip.pin != gsi || chip >= KVM_NR_IRQCHIPS ||
+			    (chips & BIT(chip)))
+				return false;
+			if (chip == KVM_IRQCHIP_IOAPIC) {
+				if (entry->set != kvm_ioapic_set_irq)
+					return false;
+			} else if (gsi >= PIC_NUM_PINS ||
+				   chip != (gsi < 8 ? KVM_IRQCHIP_PIC_MASTER :
+						     KVM_IRQCHIP_PIC_SLAVE) ||
+				   entry->set != kvm_pic_set_irq) {
+				return false;
+			}
+			chips |= BIT(chip);
+		}
+		if (chips != (BIT(KVM_IRQCHIP_IOAPIC) |
+			      (gsi < PIC_NUM_PINS ? BIT(gsi < 8 ?
+			       KVM_IRQCHIP_PIC_MASTER : KVM_IRQCHIP_PIC_SLAVE) : 0)))
+			return false;
+	}
+	*original = table;
+	return true;
+}
+
+/* Native locks serialize each public getter. The VM/control/configuration
+ * cut and selected source fence exclude independent initialization writers;
+ * the final gate rechecks that cut before these bytes become Known. */
+static int pic_board_capture_birth(struct kvm *kvm)
+{
+	struct kvm_crucible_pic_device_birth_state *birth =
+		&kvm->arch.crucible_pic_board.birth;
+	struct kvm_irqchip chip = {};
+	int result;
+
+	chip.chip_id = KVM_IRQCHIP_PIC_MASTER;
+	result = kvm_vm_ioctl_get_irqchip(kvm, &chip);
+	if (result)
+		return result;
+	birth->pic[0] = chip.chip.pic;
+
+	memset(&chip, 0, sizeof(chip));
+	chip.chip_id = KVM_IRQCHIP_PIC_SLAVE;
+	result = kvm_vm_ioctl_get_irqchip(kvm, &chip);
+	if (result)
+		return result;
+	birth->pic[1] = chip.chip.pic;
+
+	memset(&chip, 0, sizeof(chip));
+	chip.chip_id = KVM_IRQCHIP_IOAPIC;
+	result = kvm_vm_ioctl_get_irqchip(kvm, &chip);
+	if (result)
+		return result;
+	birth->ioapic = chip.chip.ioapic;
+
+	memset(&birth->pit, 0, sizeof(birth->pit));
+	return kvm_vm_ioctl_get_pit2(kvm, &birth->pit);
+}
+
+static bool pic_board_fresh_devices(struct kvm *kvm)
+{
+	struct kvm_pic *pic = kvm->arch.vpic;
+	struct kvm_ioapic *ioapic = kvm->arch.vioapic;
+	struct kvm_pit *pit = kvm->arch.vpit;
+	unsigned int index;
+	bool fresh = true;
+
+	/* These pointers are read from the actual VM only after the native
+	 * constructors returned under its mutex, never from caller input. */
+	if (!pic || !ioapic || !pit || pic->kvm != kvm ||
+	    ioapic->kvm != kvm || pit->kvm != kvm || !pit->worker ||
+	    !pit->worker->task || !atomic_read(&pit->pit_state.reinject))
+		return false;
+	spin_lock(&ioapic->lock);
+	for (index = 0; index < IOAPIC_NUM_PINS; index++)
+		if (!ioapic->redirtbl[index].fields.mask ||
+		    ioapic->irq_states[index] || ioapic->irq_eoi[index])
+			fresh = false;
+	fresh = fresh && !ioapic->irr && !ioapic->irr_delivered &&
+		!ioapic->crucible_eoi.issued && !ioapic->crucible_eoi.queued &&
+		!ioapic->crucible_eoi.active;
+	spin_unlock(&ioapic->lock);
+	if (!fresh)
+		return false;
+
+	spin_lock(&pic->lock);
+	fresh = !pic->output && !pic->pending_acks && !pic->wakeup_needed &&
+		!pic->crucible_pit_issued && !pic->crucible_eoi_issued;
+	for (index = 0; index < PIC_NUM_PINS; index++)
+		fresh = fresh && !pic->irq_states[index] &&
+			!pic->crucible_pit[index].phase;
+	for (index = 0; index < 2; index++)
+		fresh = fresh && !pic->pics[index].irr && !pic->pics[index].isr;
+	spin_unlock(&pic->lock);
+	if (!fresh)
+		return false;
+
+	mutex_lock(&pit->pit_state.lock);
+	fresh = !hrtimer_active(&pit->pit_state.timer) &&
+		!hrtimer_callback_running(&pit->pit_state.timer) &&
+		!pit->pit_state.crucible.issued &&
+		!pit->pit_state.crucible.count && !pit->pit_state.crucible.valid &&
+		!pit->pit_state.crucible.callback_active &&
+		!pit->pit_state.crucible.worker_active &&
+		!pit->pit_state.crucible.work_scheduled;
+	mutex_unlock(&pit->pit_state.lock);
+	return fresh;
+}
+#endif
