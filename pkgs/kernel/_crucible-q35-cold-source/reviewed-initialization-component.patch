+	/* The source lease and control mutex span the actual setter, while
+	 * configuration/VM/IRQ/gate are released before native slots/MMU work.
+	 * The ordinary selected VM topology entry remains refused. */
+	memory.memory_size = request.memory_size;
+	memory.userspace_addr = request.userspace_addr;
+	mutex_lock(&kvm->slots_lock);
