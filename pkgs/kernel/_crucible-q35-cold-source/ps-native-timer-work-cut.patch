+/* A later source40 setter cannot replace the immutable bootstrap birth behind
+ * a previously issued PS binding. Guest PIO requires its own arm ancestry;
+ * this readback neither equates those arms nor clears native timer state.
+ */
+bool kvm_crucible_q35_ps_pit_birth_current_locked(struct kvm *kvm)
+{
+	struct kvm_crucible_ps_clock_state *ps = &kvm->arch.crucible_clock.ps;
+
+	lockdep_assert_held(&kvm->crucible_gate_lock);
+	return ps->pit_birth_bound && ps->native_pit == kvm->arch.vpit &&
+		ps->native_pit == kvm->arch.crucible_pic_board.pit &&
+		ps->pit_birth && pit_ps_original_birth_locked(kvm) == ps->pit_birth;
+}
+EXPORT_SYMBOL_FOR_KVM_INTERNAL(kvm_crucible_q35_ps_pit_birth_current_locked);
