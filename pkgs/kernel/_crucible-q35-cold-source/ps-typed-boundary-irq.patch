+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	result = -EOPNOTSUPP;
+	if (!ps->selected || ps->plan.version != 2 || ps->controller != current ||
+	    ps->plan.configuration_enrollment_id != input.configuration_enrollment_id ||
+	    irq->uncertain || kvm->crucible_irq_input.tainted || READ_ONCE(kvm->vm_dead))
+		goto unlock_gate;
+	if (input.operation == KVM_CRUCIBLE_Q35_PS_IRQ_QUERY) {
+		if (!irq->installed || input.maximum_inputs != irq->installation.maximum_inputs)
+			goto unlock_gate;
+		if (!input.input_id) {
+			if (irq->installation_queried || !ps_irq_identity(&input, &irq->installation))
+				goto unlock_gate;
+			irq->installation_queried = true;
+			output = irq->installation_output;
+		} else {
+			if (input.input_id > irq->issued)
+				goto unlock_gate;
+			row = &irq->rows[input.input_id - 1];
+			if (!row->known || row->queried || !ps_irq_identity(&input, &row->input))
+				goto unlock_gate;
+			row->queried = true;
+			output = row->output;
+		}
+		output.operation = input.operation;
+		result = 0;
+		goto unlock_gate;
+	}
+	if (clock->active || clock->run_owners || clock->timer_owners ||
+	    kvm->crucible_effect_owners || kvm->crucible_irq_input.owners ||
+	    kvm->crucible_irq_input.inflight || irq->inflight ||
+	    input.expected_phase != ps->phase || input.generation != clock->window_generation ||
+	    input.position_ps != ps->current_ps ||
+	    (ps->phase != KVM_CRUCIBLE_PS_COLD && ps->phase != KVM_CRUCIBLE_PS_ACKNOWLEDGED) ||
+	    !kvm_arch_crucible_q35_ps_native_cut_locked(kvm, &closed, &pending) ||
+	    closed != 15 || pending)
+		goto unlock_gate;
+	if (input.operation == KVM_CRUCIBLE_Q35_PS_IRQ_INSTALL) {
+		if (irq->installed || irq->rows || input.input_id || input.gsi || input.level ||
+		    ps->phase != KVM_CRUCIBLE_PS_COLD || input.generation || ps->pit_birth_bound)
+			goto unlock_gate;
+		raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+		result = kvm_crucible_q35_ps_pit_bind_original_birth(kvm);
+		raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+		if (result)
+			goto unlock_gate;
+		irq->installation = input;
+		irq->rows = allocation;
+		allocation = NULL;
+		irq->routing = kvm->arch.crucible_pic_board.routing;
+		irq->owner = current;
+		irq->installed = true;
+		output = input;
+		output.flags = KVM_CRUCIBLE_Q35_PS_IRQ_KNOWN;
+		irq->installation_output = output;
+		goto unlock_gate;
+	}
+	/* Whole installation remains unissued until the original parked QEMU
+	 * output join and physical-stop issuer exist. The cold binding alone
+	 * cannot authorize even a boundary input effect. */
+	if (!ps->execution_installed || !irq->installed || irq->owner != current ||
+	    input.maximum_inputs != irq->installation.maximum_inputs ||
+	    irq->routing != kvm->arch.crucible_pic_board.routing ||
+	    irq->routing != rcu_dereference_protected(kvm->irq_routing, 1) ||
+	    irq->issued >= irq->installation.maximum_inputs || input.input_id != irq->issued + 1)
+		goto unlock_gate;
+	/* Mapping bounds are guaranteed by the original24-GSI source publication.
+	 * No MSI/irqfd or unrelated asynchronous producer gains this input permit. */
+	count = kvm_irq_map_gsi(kvm, routes, input.gsi);
+	if (count <= 0 || count > KVM_NR_IRQCHIPS)
+		goto unlock_gate;
+	for (route = 0; route < count; route++)
+		if (routes[route].type != KVM_IRQ_ROUTING_IRQCHIP || !routes[route].set)
+			goto unlock_gate;
+	row = &irq->rows[irq->issued++];
+	row->input = input;
+	irq->inflight = row;
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+
+	native_result = kvm_set_irq(kvm, KVM_USERSPACE_IRQ_SOURCE_ID,
+		row->input.gsi, row->input.level, false);
