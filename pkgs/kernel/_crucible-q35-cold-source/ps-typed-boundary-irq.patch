+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Source-owned boundary IRQ inputs have their own copied-byte journal. This
+ * installation neither opens RUN nor supplies a native output publication cut.
+ */
+
+static bool ps_irq_geometry_valid(const struct kvm_crucible_q35_ps_irq_input *input)
+{
+	u32 index;
+
+	if (input->version != 2 || !input->configuration_enrollment_id ||
+	    !input->maximum_inputs || input->maximum_inputs > KVM_CRUCIBLE_Q35_PS_IRQ_MAX_INPUTS ||
+	    input->operation < KVM_CRUCIBLE_Q35_PS_IRQ_INSTALL ||
+	    input->operation > KVM_CRUCIBLE_Q35_PS_IRQ_QUERY ||
+	    input->gsi >= 24 || input->level > 1 || input->native_result ||
+	    input->flags || input->inputs_used)
+		return false;
+	for (index = 0; index < ARRAY_SIZE(input->reserved); index++)
+		if (input->reserved[index])
+			return false;
+	return true;
+}
+
+static bool ps_irq_identity(const struct kvm_crucible_q35_ps_irq_input *query,
+	const struct kvm_crucible_q35_ps_irq_input *input)
+{
+	struct kvm_crucible_q35_ps_irq_input identity = *query;
+
+	identity.operation = input->operation;
+	return !memcmp(&identity, input, sizeof(identity));
+}
+
+bool kvm_crucible_q35_ps_irq_claim_locked(struct kvm *kvm, u32 kind,
+	int source, u32 gsi, int level, bool line_status)
+{
+	struct kvm_crucible_ps_clock_state *ps = &kvm->arch.crucible_clock.ps;
+	struct kvm_crucible_ps_irq_state *irq = &ps->irq;
+	struct kvm_crucible_ps_irq_row *row = irq->inflight;
+
+	lockdep_assert_held(&kvm->crucible_gate_lock);
+	if (!irq->installed || irq->uncertain || irq->owner != current ||
+	    ps->controller != current || ps->plan.version != 2 || !row || row->known ||
+	    row->claimed || in_interrupt() || kind != KVM_CRUCIBLE_IRQ_SOURCE_LINE ||
+	    source != KVM_USERSPACE_IRQ_SOURCE_ID || line_status ||
+	    level < 0 || level > 1 || row->input.gsi != gsi || row->input.level != level ||
+	    irq->routing != rcu_dereference_protected(kvm->irq_routing, 1) ||
+	    (ps->phase != KVM_CRUCIBLE_PS_COLD && ps->phase != KVM_CRUCIBLE_PS_ACKNOWLEDGED) ||
+	    row->input.generation != kvm->arch.crucible_clock.window_generation ||
+	    row->input.position_ps != ps->current_ps)
+		return false;
+	row->claimed = true;
+	return true;
+}
+EXPORT_SYMBOL_FOR_KVM_INTERNAL(kvm_crucible_q35_ps_irq_claim_locked);
+
+/* Every resource lock is acquired without waiting behind a native RUN. The
+ * exact retained route table stays published while irq_lock and the original
+ * configuration mutex exclude replacement. Input bytes are never recopied.
+ */
+int kvm_crucible_q35_ps_irq_control(struct kvm *kvm, struct kvm_enable_cap *cap)
+{
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	struct kvm_crucible_ps_clock_state *ps = &clock->ps;
+	struct kvm_crucible_ps_irq_state *irq = &ps->irq;
+	struct kvm_crucible_q35_ps_irq_input input, output;
+	struct kvm_crucible_ps_irq_row *allocation = NULL, *row = NULL;
+	struct kvm_kernel_irq_routing_entry routes[KVM_NR_IRQCHIPS];
+	struct kvm_vcpu *vcpu;
+	void __user *argument = u64_to_user_ptr(cap->args[0]);
+	unsigned long index, flags;
+	u64 closed, pending;
+	u32 locked = 0;
+	int result = -EBUSY, count, route, native_result;
+	bool contain = false;
+
+	BUILD_BUG_ON(sizeof(input) != 128);
+	if (cap->flags || !argument || cap->args[1] || cap->args[2] || cap->args[3])
+		return -EINVAL;
+	if (copy_from_user(&input, argument, sizeof(input)))
+		return -EFAULT;
+	if (!ps_irq_geometry_valid(&input))
+		return -EINVAL;
+	if (!mutex_trylock(&clock->control_lock))
+		return -EBUSY;
+	if (!mutex_trylock(&kvm->crucible_configuration_lock))
+		goto unlock_control;
+	if (!mutex_trylock(&kvm->lock))
+		goto unlock_configuration;
+	if (!mutex_trylock(&kvm->slots_lock))
+		goto unlock_vm;
+	if (!mutex_trylock(&kvm->irq_lock))
+		goto unlock_slots;
+	kvm_for_each_vcpu(index, vcpu, kvm) {
+		if (index != locked || index >= 4 || !mutex_trylock(&vcpu->mutex))
+			goto unlock_vcpus;
+		locked++;
+	}
+	if (input.operation == KVM_CRUCIBLE_Q35_PS_IRQ_INSTALL) {
+		/* Typed rows are reserved before any retained binding or IRQ effect.
+		 * The fixed maximum bounds all later original input/output storage. */
+		allocation = kcalloc(input.maximum_inputs, sizeof(*allocation), GFP_KERNEL_ACCOUNT);
+		if (!allocation) {
+			result = -ENOMEM;
+			goto unlock_vcpus;
+		}
+	}
