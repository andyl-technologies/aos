+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	output = row->input;
+	output.native_result = native_result;
+	output.inputs_used = irq->issued;
+	output.flags = KVM_CRUCIBLE_Q35_PS_IRQ_KNOWN;
+	if (!row->claimed || irq->inflight != row || kvm->crucible_irq_input.tainted ||
+	    kvm->crucible_memory_tainted) {
+		output.flags |= KVM_CRUCIBLE_Q35_PS_IRQ_UNCERTAIN;
+		irq->uncertain = true;
+		ps->phase = KVM_CRUCIBLE_PS_UNKNOWN;
+		contain = true;
+	}
+	row->output = output;
+	row->known = true;
+	irq->inflight = NULL;
+	result = 0;
+unlock_gate:
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+unlock_vcpus:
+	while (locked)
+		mutex_unlock(&kvm_get_vcpu(kvm, --locked)->mutex);
+	mutex_unlock(&kvm->irq_lock);
+unlock_slots:
+	mutex_unlock(&kvm->slots_lock);
+unlock_vm:
+	mutex_unlock(&kvm->lock);
+unlock_configuration:
+	mutex_unlock(&kvm->crucible_configuration_lock);
+unlock_control:
+	mutex_unlock(&clock->control_lock);
+	kfree(allocation);
+	if (contain)
+		kvm_vm_dead(kvm);
+	if (result)
+		return result;
+	/* Failed delivery leaves the exact native output and one-query allowance. */
+	return copy_to_user(argument, &output, sizeof(output)) ? -EFAULT : 0;
+}
+EXPORT_SYMBOL_FOR_KVM_INTERNAL(kvm_crucible_q35_ps_irq_control);
