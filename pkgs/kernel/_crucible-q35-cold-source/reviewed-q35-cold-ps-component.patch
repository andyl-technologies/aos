+		return true;
+	case KVM_SET_XCRS:
+		*write = true;
+		fallthrough;
+	case KVM_GET_XCRS:
+		*bytes = sizeof(struct kvm_xcrs);
+		return true;
+	case KVM_SET_DEBUGREGS:
+		*write = true;
+		fallthrough;
+	case KVM_GET_DEBUGREGS:
+		*bytes = sizeof(struct kvm_debugregs);
+		return true;
+	case KVM_SET_LAPIC:
+		*write = true;
+		fallthrough;
+	case KVM_GET_LAPIC:
