+		return vcpu->arch.guest_fpu.uabi_size <= *bytes;
+	case KVM_SET_XSAVE:
+		*write = true;
+		fallthrough;
+	case KVM_GET_XSAVE2:
+		/* This is the original configured native format, including host
+		 * extensions. A 4096-byte assumption would truncate XSAVE2. */
+		*bytes = vcpu->arch.guest_fpu.uabi_size;
+		return *bytes && *bytes <=
+			KVM_CRUCIBLE_PIC_INITIALIZER_MAX_INPUT_BYTES / 2;
+	default:
+		return false;
+	}
+}
+
+static bool pic_initializer_cpu_bytes_operation(unsigned int ioctl)
+{
+	switch (ioctl) {
+	case KVM_SET_CPUID:
+	case KVM_SET_CPUID2:
+	case KVM_GET_CPUID2:
+	case KVM_X86_SETUP_MCE:
+	case KVM_SET_TSC_KHZ:
+	case KVM_GET_TSC_KHZ:
+	case KVM_GET_REGS:
+	case KVM_SET_REGS:
+	case KVM_GET_SREGS:
+	case KVM_SET_SREGS:
+	case KVM_GET_SREGS2:
+	case KVM_SET_SREGS2:
+	case KVM_GET_FPU:
+	case KVM_SET_FPU:
+	case KVM_GET_XSAVE:
+	case KVM_GET_XSAVE2:
+	case KVM_SET_XSAVE:
+	case KVM_GET_XCRS:
+	case KVM_SET_XCRS:
+	case KVM_GET_DEBUGREGS:
+	case KVM_SET_DEBUGREGS:
+	case KVM_SET_GUEST_DEBUG:
+	case KVM_GET_LAPIC:
+	case KVM_SET_LAPIC:
+		return true;
+	default:
+		return false;
+	}
+}
+
+static bool pic_initializer_cpu_input_valid(unsigned int ioctl,
+	const void *buffer)
+{
+	if (ioctl == KVM_SET_TSC_KHZ) {
+		const u64 *argument = buffer;
+
+		/* The ordinary ABI truncates unsigned long. The selected constructor
+		 * retains the complete scalar and rejects ambiguous high bits. */
+		return *argument <= U32_MAX;
+	}
+	if (ioctl == KVM_SET_GUEST_DEBUG) {
+		const struct kvm_guest_debug *debug = buffer;
+
+		return !(debug->control &
+			(KVM_GUESTDBG_INJECT_DB | KVM_GUESTDBG_INJECT_BP));
+	}
+	if (ioctl == KVM_SET_LAPIC) {
+		const struct kvm_lapic_state *lapic = buffer;
+		u32 value, index;
+
+		memcpy(&value, lapic->regs + APIC_TMICT, sizeof(value));
+		if (value)
+			return false;
+		memcpy(&value, lapic->regs + APIC_TMCCT, sizeof(value));
+		if (value)
+			return false;
+		memcpy(&value, lapic->regs + APIC_LVT0, sizeof(value));
+		if (!(value & APIC_LVT_MASKED) &&
+		    (value & APIC_MODE_MASK) == APIC_DM_NMI)
+			return false;
+		for (index = 0; index < 8; index++) {
+			memcpy(&value, lapic->regs + APIC_ISR + 16 * index, sizeof(value));
+			if (value)
+				return false;
+			memcpy(&value, lapic->regs + APIC_IRR + 16 * index, sizeof(value));
+			if (value)
+				return false;
+		}
+	}
+	return true;
+}
+
+static struct kvm_crucible_pic_initializer_effect *
+pic_initializer_cpu_effect_locked(struct kvm_vcpu *vcpu,
+	unsigned int ioctl)
+{
+	struct kvm *kvm = vcpu->kvm;
+	struct kvm_crucible_pic_initializer_state *state =
+		pic_initializer_actor_state(kvm, vcpu);
+	struct kvm_crucible_pic_board *board = &kvm->arch.crucible_pic_board;
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	struct kvm_crucible_pic_initializer_effect *effect;
+
+	lockdep_assert_held(&kvm->crucible_gate_lock);
+	/* The original admission holds one configuration writer through the
+	 * native callback. No replacement Task/vCPU or later row can bind it. */
+	if (!board->initializer_roster.selected || !state ||
+	    board->initializer_roster.uncertain || state->uncertain ||
+	    board->phase != CRUCIBLE_PIC_BOARD_ENROLLED ||
+	    !state->inflight || state->task != current || state->vcpu != vcpu ||
+	    state->native_vcpu_id != vcpu->vcpu_id ||
+	    kvm_get_vcpu(kvm, state->native_vcpu_id) != vcpu ||
+	    kvm->crucible_topology_writers != 1 || !state->issued ||
+	    state->issued > state->maximum_effects ||
+	    clock->enabled || clock->active || clock->run_owners || clock->timer_owners)
+		return NULL;
+	effect = &state->effects[state->issued - 1];
+	return effect->native_ioctl == ioctl ? effect : NULL;
+}
+
+int kvm_arch_crucible_pic_initializer_cpu_prepare(struct kvm_vcpu *vcpu,
+	unsigned int ioctl, void *buffer, u32 bytes)
+{
+	struct kvm *kvm = vcpu->kvm;
+	struct kvm_crucible_pic_initializer_state *state;
+	struct kvm_crucible_pic_initializer_effect *effect;
+	void *input = NULL, *output;
+	unsigned long flags;
+	u32 expected, charge;
+	bool write;
+	int result = -EOPNOTSUPP;
+
+	if (!kvm_arch_crucible_pic_board_fenced(kvm) ||
+	    !smp_load_acquire(&kvm->arch.crucible_pic_board.initializer_roster.selected))
+		return 0;
+	if (!buffer || !pic_initializer_cpu_bytes_layout(vcpu, ioctl, &expected, &write) ||
+	    expected != bytes || (write && !pic_initializer_cpu_input_valid(ioctl, buffer)))
+		return result;
+	charge = write ? 2 * bytes : bytes;
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	state = pic_initializer_actor_state(kvm, vcpu);
+	effect = pic_initializer_cpu_effect_locked(vcpu, ioctl);
+	if (effect && !effect->cpu_bytes_charged && state->input_bytes <=
+	    KVM_CRUCIBLE_PIC_INITIALIZER_MAX_INPUT_BYTES - charge) {
+		/* Admission consumes this immutable history budget once. Allocation
+		 * failure cannot refund it and create a replacement original row. */
+		effect->cpu_bytes_charged = true;
+		effect->input_cpu_bytes = write ? bytes : 0;
+		effect->output_cpu_bytes = bytes;
+		state->input_bytes += charge;
+		result = 0;
+	}
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	if (result)
+		return result;
+
+	if (write) {
+		input = kmemdup(buffer, bytes, GFP_KERNEL);
+		if (!input)
+			return -ENOMEM;
+	}
+	output = kmalloc(bytes, GFP_KERNEL);
+	if (!output) {
+		kfree(input);
+		return -ENOMEM;
+	}
+
+	result = -EOPNOTSUPP;
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	effect = pic_initializer_cpu_effect_locked(vcpu, ioctl);
+	if (effect && effect->cpu_bytes_charged && !effect->cpu_prepared &&
+	    effect->input_cpu_bytes == (write ? bytes : 0) &&
+	    effect->output_cpu_bytes == bytes) {
+		effect->input_cpu = input;
+		effect->output_cpu = output;
+		effect->cpu_prepared = true;
+		result = 0;
+	}
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	if (result) {
+		kfree(output);
+		kfree(input);
+	} else if (!write) {
+		/* Native getters may leave reserved bytes untouched. Initialize their
+		 * actual local, never guest state, before the original callback. */
+		memset(buffer, 0, bytes);
+	}
+	return result;
+}
+EXPORT_SYMBOL_FOR_KVM_INTERNAL(kvm_arch_crucible_pic_initializer_cpu_prepare);
+
+int kvm_arch_crucible_pic_initializer_cpu_complete(struct kvm_vcpu *vcpu,
+	unsigned int ioctl, const void *buffer, u32 bytes, long native_result)
+{
+	struct kvm *kvm = vcpu->kvm;
+	struct kvm_crucible_pic_initializer_effect *effect;
+	unsigned long flags;
+	int result = -EOPNOTSUPP;
+
+	if (!kvm_arch_crucible_pic_board_fenced(kvm) ||
+	    !smp_load_acquire(&kvm->arch.crucible_pic_board.initializer_roster.selected))
+		return 0;
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	effect = pic_initializer_cpu_effect_locked(vcpu, ioctl);
+	if (effect && effect->cpu_prepared && !effect->cpu_completed &&
+	    effect->output_cpu && effect->output_cpu_bytes == bytes && buffer) {
+		memcpy(effect->output_cpu, buffer, bytes);
+		effect->native_cpu_result = native_result;
+		effect->cpu_completed = true;
+		result = 0;
+	}
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	return result;
+}
+EXPORT_SYMBOL_FOR_KVM_INTERNAL(kvm_arch_crucible_pic_initializer_cpu_complete);
+
+/* CPUID retains its once-copied header separately from the variable user tail.
+ * Allocation and all history charges precede that tail read. The working copy
+ * may become native CPUID state; it never substitutes for immutable input. */
+int kvm_arch_crucible_pic_initializer_cpuid_prepare(struct kvm_vcpu *vcpu,
+	unsigned int ioctl, const void *header, const void __user *entries,
+	void **working, u32 *working_bytes)
+{
+	struct kvm *kvm = vcpu->kvm;
+	struct kvm_crucible_pic_initializer_state *state;
+	struct kvm_crucible_pic_initializer_effect *effect;
+	const struct kvm_cpuid2 *shape = header;
+	void *input = NULL, *output = NULL, *copy = NULL;
+	unsigned long flags;
+	u32 input_bytes, output_bytes, bytes, charge, entry_bytes;
+	bool get = ioctl == KVM_GET_CPUID2;
+	int result = -EOPNOTSUPP;
+
+	*working = NULL;
+	*working_bytes = 0;
+	if (!smp_load_acquire(&kvm->arch.crucible_pic_board.initializer_roster.selected))
+		return 0;
+	if (!kvm_arch_crucible_pic_board_fenced(kvm))
+		return result;
+	if (!header || shape->nent > KVM_MAX_CPUID_ENTRIES ||
+	    (ioctl != KVM_SET_CPUID && ioctl != KVM_SET_CPUID2 && !get))
+		return result;
+	entry_bytes = ioctl == KVM_SET_CPUID ? sizeof(struct kvm_cpuid_entry) :
+		sizeof(struct kvm_cpuid_entry2);
+	bytes = sizeof(*shape) + shape->nent * entry_bytes;
+	input_bytes = get ? sizeof(*shape) : bytes;
+	output_bytes = sizeof(*shape) + shape->nent * sizeof(struct kvm_cpuid_entry2);
+	/* Charge the transient converter and published native entries as well. */
+	charge = input_bytes + output_bytes + bytes +
+		(get ? 0 : bytes + output_bytes);
+	if (charge > KVM_CRUCIBLE_PIC_INITIALIZER_MAX_INPUT_BYTES)
+		return result;
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	state = pic_initializer_actor_state(kvm, vcpu);
+	effect = pic_initializer_cpu_effect_locked(vcpu, ioctl);
+	if (effect && !effect->cpu_bytes_charged && state->input_bytes <=
+	    KVM_CRUCIBLE_PIC_INITIALIZER_MAX_INPUT_BYTES - charge) {
+		effect->cpu_bytes_charged = true;
+		effect->input_cpu_bytes = input_bytes;
+		effect->output_cpu_bytes = output_bytes;
+		state->input_bytes += charge;
+		result = 0;
+	}
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	if (result)
+		return result;
+
+	input = kzalloc(input_bytes, GFP_KERNEL);
+	output = kzalloc(output_bytes, GFP_KERNEL);
+	copy = kzalloc(bytes, GFP_KERNEL);
+	if (!input || !output || !copy) {
+		result = -ENOMEM;
+		goto out;
+	}
+	memcpy(input, header, sizeof(*shape));
+	if (!get && shape->nent && copy_from_user(input + sizeof(*shape), entries,
+						bytes - sizeof(*shape))) {
+		result = -EFAULT;
+		goto out;
+	}
+	memcpy(copy, input, input_bytes);
+
+	result = -EOPNOTSUPP;
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	effect = pic_initializer_cpu_effect_locked(vcpu, ioctl);
+	if (effect && effect->cpu_bytes_charged && !effect->cpu_prepared &&
+	    effect->input_cpu_bytes == input_bytes &&
+	    effect->output_cpu_bytes == output_bytes) {
+		effect->input_cpu = input;
+		effect->output_cpu = output;
+		effect->cpu_prepared = true;
+		*working = copy;
+		*working_bytes = bytes;
+		result = 0;
+	}
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+out:
+	if (result) {
+		kfree(copy);
+		kfree(output);
+		kfree(input);
+	}
+	return result;
+}
+EXPORT_SYMBOL_FOR_KVM_INTERNAL(kvm_arch_crucible_pic_initializer_cpuid_prepare);
+
+int kvm_arch_crucible_pic_initializer_cpuid_complete(struct kvm_vcpu *vcpu,
+	unsigned int ioctl, const void *working, u32 working_bytes, long native_result)
+{
+	struct kvm *kvm = vcpu->kvm;
+	struct kvm_crucible_pic_initializer_effect *effect;
+	struct kvm_cpuid2 *output;
+	unsigned long flags;
+	u32 bytes;
+	int result = -EOPNOTSUPP;
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	effect = pic_initializer_cpu_effect_locked(vcpu, ioctl);
+	if (!effect || !effect->cpu_prepared || effect->cpu_completed ||
+	    !effect->output_cpu || vcpu->arch.cpuid_nent > KVM_MAX_CPUID_ENTRIES)
+		goto out;
+	bytes = sizeof(*output) + vcpu->arch.cpuid_nent * sizeof(output->entries[0]);
+	/* A failed callback may leave the previous, larger native roster intact.
+	 * Its raw failure is cached, but it never gains Known or output credit. */
+	if (!native_result && bytes > effect->output_cpu_bytes)
+		goto out;
+	output = effect->output_cpu;
+	if (!native_result && ioctl == KVM_GET_CPUID2) {
+		const struct kvm_cpuid2 *observed = working;
+
+		/* Cache the exact native getter buffer later delivered to userspace.
+		 * A second native-state read cannot substitute for those output bytes. */
+		if (!observed || working_bytes != effect->output_cpu_bytes ||
+		    observed->nent != vcpu->arch.cpuid_nent ||
+		    sizeof(*observed) + observed->nent * sizeof(observed->entries[0]) >
+			working_bytes)
+			goto out;
+		memcpy(output, working, working_bytes);
+	} else if (!native_result) {
+		output->nent = vcpu->arch.cpuid_nent;
+		if (output->nent)
+			memcpy(output->entries, vcpu->arch.cpuid_entries,
+			       bytes - sizeof(*output));
+	}
+	effect->native_cpu_result = native_result;
+	effect->cpu_completed = true;
+	result = 0;
+out:
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	return result;
+}
+EXPORT_SYMBOL_FOR_KVM_INTERNAL(kvm_arch_crucible_pic_initializer_cpuid_complete);
