+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Exact copied filter header/tails reach the actual original native range
+ * allocator and publisher. Retained native filter references protect history. */
+
+static bool q35_filter_request_valid(const struct kvm_crucible_q35_msr_filter *request)
+{
+	u32 index;
+
+	if (request->version != 2 || !request->enrollment_id ||
+	    !request->maximum_effects ||
+	    request->maximum_effects > KVM_CRUCIBLE_Q35_FILTER_MAX_EFFECTS ||
+	    request->issued_effects || request->flags || request->input_bytes ||
+	    request->native_result || request->native_count || request->native_default_allow)
+		return false;
+	for (index = 0; index < ARRAY_SIZE(request->reserved); index++)
+		if (request->reserved[index])
+			return false;
+	switch (request->operation) {
+	case KVM_CRUCIBLE_Q35_FILTER_SELECT:
+		return !request->effect_index && !request->user_filter;
+	case KVM_CRUCIBLE_Q35_FILTER_QUERY:
+		return !request->user_filter;
+	case KVM_CRUCIBLE_Q35_FILTER_APPLY:
+		return request->effect_index && request->user_filter;
+	default:
+		return false;
+	}
+}
+
+static bool q35_filter_same(const struct kvm_crucible_q35_filter_state *state,
+	const struct kvm_crucible_q35_msr_filter *request)
+{
+	return state->selected && state->enrollment_id == request->enrollment_id &&
+		state->maximum_effects == request->maximum_effects;
+}
+
+static void q35_filter_report(const struct kvm_crucible_q35_filter_state *state,
+	struct kvm_crucible_q35_msr_filter *request)
+{
+	const struct kvm_crucible_q35_filter_effect *effect;
+	u32 operation = request->operation;
+
+	if (request->effect_index) {
+		effect = &state->effects[request->effect_index - 1];
+		*request = effect->original;
+		request->operation = operation;
+		request->input_bytes = effect->input_bytes;
+		request->native_result = effect->native_result;
+		request->native_count = effect->native_count;
+		request->native_default_allow = effect->native_default_allow;
+		request->flags = effect->known ? KVM_CRUCIBLE_Q35_FILTER_KNOWN : 0;
+	}
+	request->issued_effects = state->issued;
+	request->flags |= (state->selected ? KVM_CRUCIBLE_Q35_FILTER_SELECTED : 0) |
+		(state->inflight ? KVM_CRUCIBLE_Q35_FILTER_INFLIGHT : 0) |
+		(state->uncertain ? KVM_CRUCIBLE_Q35_FILTER_UNCERTAIN : 0);
+}
+
+static int q35_filter_copy_input(struct kvm_crucible_q35_filter_state *state,
+	struct kvm_crucible_q35_filter_effect *effect)
+{
+	struct kvm_msr_filter *input;
+	u32 index;
+	size_t bytes;
+	void *bitmap;
+
+	if (state->input_bytes > KVM_CRUCIBLE_Q35_FILTER_MAX_INPUT_BYTES - sizeof(*input))
+		return -ENOSPC;
+	input = memdup_user(u64_to_user_ptr(effect->original.user_filter), sizeof(*input));
+	if (IS_ERR(input))
+		return PTR_ERR(input);
+	effect->input = input;
+	effect->input_bytes = sizeof(*input);
+	state->input_bytes += sizeof(*input);
+	if (input->flags & ~KVM_MSR_FILTER_VALID_MASK)
+		return -EINVAL;
+
+	for (index = 0; index < ARRAY_SIZE(input->ranges); index++) {
+		const struct kvm_msr_filter_range *range = &input->ranges[index];
+
+		if (!range->nmsrs) {
+			if (range->flags || range->base || range->bitmap)
+				return -EINVAL;
+			continue;
+		}
+		bytes = BITS_TO_LONGS((u64)range->nmsrs) * sizeof(long);
+		if (!range->flags || (range->flags & ~KVM_MSR_FILTER_RANGE_VALID_MASK) ||
+		    !range->bitmap || range->nmsrs - 1 > U32_MAX - range->base ||
+		    !bytes || bytes > KVM_MSR_FILTER_MAX_BITMAP_SIZE ||
+		    bytes > KVM_CRUCIBLE_Q35_FILTER_MAX_INPUT_BYTES - state->input_bytes)
+			return -EINVAL;
+		bitmap = memdup_user((__user u8 *)range->bitmap, bytes);
+		if (IS_ERR(bitmap))
+			return PTR_ERR(bitmap);
+		effect->bitmaps[index] = bitmap;
+		effect->bitmap_bytes[index] = bytes;
+		effect->input_bytes += bytes;
+		state->input_bytes += bytes;
+	}
+	return 0;
+}
+
+static bool q35_filter_published_same(struct kvm *kvm,
+	const struct kvm_crucible_q35_filter_effect *effect)
+{
+	const struct kvm_x86_msr_filter *published = effect->published;
+	const struct kvm_msr_filter *input = effect->input;
+	u32 index, native_index = 0;
+
+	lockdep_assert_held(&kvm->lock);
+	if (!published || !input ||
+	    published != rcu_dereference_protected(kvm->arch.msr_filter, 1) ||
+	    published->default_allow != !(input->flags & KVM_MSR_FILTER_DEFAULT_DENY))
+		return false;
+	for (index = 0; index < ARRAY_SIZE(input->ranges); index++) {
+		const struct kvm_msr_filter_range *original = &input->ranges[index];
+		const struct msr_bitmap_range *native;
+
+		if (!original->nmsrs)
+			continue;
+		if (native_index >= published->count || !effect->bitmaps[index])
+			return false;
+		native = &published->ranges[native_index++];
+		if (native->flags != original->flags || native->base != original->base ||
+		    native->nmsrs != original->nmsrs ||
+		    memcmp(native->bitmap, effect->bitmaps[index], effect->bitmap_bytes[index]))
+			return false;
+	}
+	return native_index == published->count;
+}
+
+static int kvm_crucible_q35_msr_filter_control(struct kvm *kvm,
+	struct kvm_enable_cap *cap)
+{
+	struct kvm_crucible_pic_board *board = &kvm->arch.crucible_pic_board;
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	struct kvm_crucible_q35_filter_state *state = &board->q35_filter;
+	struct kvm_crucible_q35_msr_filter request;
+	struct kvm_crucible_q35_filter_effect *effect = NULL;
+	void __user *argument = u64_to_user_ptr(cap->args[0]);
+	unsigned long flags;
+	bool entered = false, contain = false;
+	int result = -EPERM, native_result;
+
+	BUILD_BUG_ON(sizeof(request) != 96);
+	if (cap->flags || !cap->args[0] || cap->args[1] || cap->args[2] || cap->args[3])
+		return -EINVAL;
+	if (copy_from_user(&request, argument, sizeof(request)))
+		return -EFAULT;
+	if (!q35_filter_request_valid(&request))
+		return -EINVAL;
+	if (!mutex_trylock(&clock->control_lock))
+		return -EBUSY;
+	if (!mutex_trylock(&kvm->crucible_configuration_lock)) {
+		mutex_unlock(&clock->control_lock);
+		return -EBUSY;
+	}
+	if (!q35_vm_actor(kvm))
+		goto unlock_configuration;
+	if (request.operation == KVM_CRUCIBLE_Q35_FILTER_QUERY) {
+		result = -ENOENT;
+		if (q35_filter_same(state, &request) && request.effect_index <= state->issued &&
+		    (!request.effect_index || state->effects[request.effect_index - 1].actor == current)) {
+			q35_filter_report(state, &request);
+			result = 0;
+		}
+		goto unlock_configuration;
+	}
+	if (!mutex_trylock(&kvm->lock)) {
+		result = -EBUSY;
+		goto unlock_configuration;
+	}
+	mutex_lock(&kvm->irq_lock);
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	result = -EOPNOTSUPP;
+	if (!q35_vm_live_locked(kvm) || state->inflight || state->uncertain ||
+	    board->q35_configuration.inflight || board->q35_configuration.uncertain ||
+	    !board->q35_configuration.selected || kvm->crucible_topology_writers ||
+	    request.enrollment_id != board->q35_configuration.enrollment_id)
+		goto unlock_admission;
+	if (request.operation == KVM_CRUCIBLE_Q35_FILTER_SELECT) {
+		if (state->selected || board->constructor != current || kvm->created_vcpus)
+			goto unlock_admission;
+		state->enrollment_id = request.enrollment_id;
+		state->maximum_effects = request.maximum_effects;
+		state->selected = true;
+		q35_filter_report(state, &request);
+		result = 0;
+		goto unlock_admission;
+	}
+	if (!q35_filter_same(state, &request) || state->issued >= state->maximum_effects ||
+	    request.effect_index != state->issued + 1)
+		goto unlock_admission;
+	effect = &state->effects[state->issued++];
+	effect->original = request;
+	effect->actor = current;
+	effect->native_result = -EINPROGRESS;
+	effect->inflight = true;
+	state->inflight = true;
+	kvm->crucible_topology_writers++;
+	entered = true;
+unlock_admission:
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	mutex_unlock(&kvm->irq_lock);
+	mutex_unlock(&kvm->lock);
+unlock_configuration:
+	mutex_unlock(&kvm->crucible_configuration_lock);
+	if (!entered)
+		goto unlock_control;
+
+	native_result = q35_filter_copy_input(state, effect);
+	if (!native_result)
+		native_result = kvm_vm_ioctl_set_msr_filter_owned(kvm, effect->input,
+			(const void * const *)effect->bitmaps, &effect->published);
+
+	mutex_lock(&kvm->crucible_configuration_lock);
+	mutex_lock(&kvm->lock);
+	mutex_lock(&kvm->irq_lock);
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	effect->native_result = native_result;
+	if (effect->published) {
+		effect->native_count = effect->published->count;
+		effect->native_default_allow = effect->published->default_allow;
+	}
+	effect->known = !native_result && q35_vm_live_locked(kvm) &&
+		q35_filter_published_same(kvm, effect) && kvm->crucible_topology_writers == 1;
+	effect->uncertain = !effect->known;
+	effect->inflight = false;
+	state->inflight = false;
+	if (effect->uncertain) {
+		state->uncertain = true;
+		kvm->crucible_memory_tainted = true;
+		contain = true;
+	}
+	kvm->crucible_topology_writers--;
+	q35_filter_report(state, &request);
+	result = effect->known ? 0 : -EAGAIN;
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	mutex_unlock(&kvm->irq_lock);
+	mutex_unlock(&kvm->lock);
+	mutex_unlock(&kvm->crucible_configuration_lock);
+unlock_control:
+	mutex_unlock(&clock->control_lock);
+	if (contain)
+		kvm_vm_dead(kvm);
+	if ((!result || entered) && copy_to_user(argument, &request, sizeof(request)))
+		return -EFAULT;
+	return result;
+}
+
+static void kvm_crucible_q35_msr_filter_destroy(struct kvm *kvm)
+{
+	struct kvm_crucible_q35_filter_state *state = &kvm->arch.crucible_pic_board.q35_filter;
+	u32 row, range;
+
+	/* Original VM/file destruction follows all native vCPU/callback lifetimes.
+	 * Release retained provider refs only after the ordinary current owner. */
+	for (row = 0; row < state->issued; row++) {
+		struct kvm_crucible_q35_filter_effect *effect = &state->effects[row];
+
+		kvm_free_msr_filter(effect->published);
+		for (range = 0; range < ARRAY_SIZE(effect->bitmaps); range++)
+			kfree(effect->bitmaps[range]);
+		kfree(effect->input);
+	}
+}
