+/* Actual constructor-owned frozen time before a clock is configured. This
+ * observer cannot configure a domain, acknowledge physical stop or admit RUN. */
+
+static int kvm_crucible_q35_inactive_clock_control(struct kvm *kvm,
+	struct kvm_enable_cap *cap)
+{
+	struct kvm_crucible_pic_board *board = &kvm->arch.crucible_pic_board;
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	struct kvm_crucible_q35_inactive_clock request;
+	void __user *argument = u64_to_user_ptr(cap->args[0]);
+	unsigned long flags;
+	u32 index;
+	int result = -EOPNOTSUPP;
+
+	BUILD_BUG_ON(sizeof(request) != 80);
+	if (cap->flags || !cap->args[0] || cap->args[1] || cap->args[2] || cap->args[3])
+		return -EINVAL;
+	if (copy_from_user(&request, argument, sizeof(request)))
+		return -EFAULT;
+	if (request.version != 2 || request.operation != KVM_CRUCIBLE_Q35_CLOCK_OBSERVE ||
+	    !request.enrollment_id || request.logical_ns || request.native_result ||
+	    request.flags || request.clock_version || request.run_owners || request.timer_owners ||
+	    request.effect_owners || request.irq_owners || request.topology_writers)
+		return -EINVAL;
+	for (index = 0; index < ARRAY_SIZE(request.reserved); index++)
+		if (request.reserved[index])
+			return -EINVAL;
+	if (!mutex_trylock(&clock->control_lock))
+		return -EBUSY;
+	if (!mutex_trylock(&kvm->crucible_configuration_lock)) {
+		mutex_unlock(&clock->control_lock);
+		return -EBUSY;
+	}
+	if (!mutex_trylock(&kvm->lock)) {
+		result = -EBUSY;
+		goto unlock_configuration;
+	}
+	mutex_lock(&kvm->irq_lock);
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	if (q35_vm_live_locked(kvm) && board->q35_configuration.selected &&
+	    !board->q35_configuration.inflight && !board->q35_configuration.uncertain &&
+	    request.enrollment_id == board->q35_configuration.enrollment_id &&
+	    !clock->version && !clock->window_generation && !clock->frozen_ns &&
+	    !clock->start_ns && !clock->end_ns && !clock->host_origin_ns &&
+	    !clock->numerator && !clock->denominator && !clock->close_acknowledged &&
+	    !clock->continuation.configured && !clock->continuation.started &&
+	    !kvm->crucible_effect_owners && !kvm->crucible_topology_writers) {
+		/* This is the same inactive branch used by clock_now_locked().
