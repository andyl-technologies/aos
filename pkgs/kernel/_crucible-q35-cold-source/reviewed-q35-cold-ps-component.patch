+#ifdef CONFIG_KVM_IOAPIC
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Canonical Q35 source routing replaces the kernel's immutable birth default.
+ * Both real providers remain retained; this journal grants no runtime IRQ. */
+
+static bool q35_route_request_valid(const struct kvm_crucible_q35_initial_routing *request)
+{
+	u32 index;
+
+	if (request->version != 2 || !request->enrollment_id || request->maximum_effects != 1 ||
+	    request->issued_effects || request->flags || request->input_bytes ||
+	    request->native_result || request->native_count || request->native_gsis)
+		return false;
+	for (index = 0; index < ARRAY_SIZE(request->reserved); index++)
+		if (request->reserved[index])
+			return false;
+	if (request->operation == KVM_CRUCIBLE_Q35_ROUTE_SELECT)
+		return !request->effect_index && !request->user_routes;
+	if (request->operation == KVM_CRUCIBLE_Q35_ROUTE_QUERY)
+		return request->effect_index <= 1 && !request->user_routes;
+	return request->operation == KVM_CRUCIBLE_Q35_ROUTE_APPLY &&
+		request->effect_index == 1 && request->user_routes;
+}
+
+static bool q35_route_same(const struct kvm_crucible_q35_route_state *state,
+	const struct kvm_crucible_q35_initial_routing *request)
+{
+	return state->selected && state->enrollment_id == request->enrollment_id;
+}
+
+static void q35_route_report(const struct kvm_crucible_q35_route_state *state,
+	struct kvm_crucible_q35_initial_routing *request)
+{
+	const struct kvm_crucible_q35_route_effect *effect = &state->effect;
+	u32 operation = request->operation;
+
+	if (request->effect_index) {
+		*request = effect->original;
+		request->operation = operation;
+		request->input_bytes = effect->input_bytes;
+		request->native_result = effect->native_result;
+		request->native_count = effect->native_count;
+		request->native_gsis = effect->native_gsis;
+		request->flags = effect->known ? KVM_CRUCIBLE_Q35_ROUTE_KNOWN : 0;
+	}
+	request->issued_effects = state->issued;
+	request->flags |= (state->selected ? KVM_CRUCIBLE_Q35_ROUTE_SELECTED : 0) |
+		(state->inflight ? KVM_CRUCIBLE_Q35_ROUTE_INFLIGHT : 0) |
+		(state->uncertain ? KVM_CRUCIBLE_Q35_ROUTE_UNCERTAIN : 0);
+}
+
+static bool q35_route_input_is_canonical(const struct kvm_irq_routing_entry *entries)
+{
+	struct kvm_irq_routing_entry expected = { .type = KVM_IRQ_ROUTING_IRQCHIP };
+	u32 gsi, index = 0;
+
+	/* These are the actual source loops in kvm_pc_setup_irq_routing(true):
+	 * the cascade GSI2 is omitted and the timer GSI0 reaches IOAPIC pin2. */
+	for (gsi = 0; gsi < 16; gsi++) {
+		if (gsi == 2)
+			continue;
+		expected.gsi = gsi;
+		expected.u.irqchip.irqchip = gsi < 8 ? KVM_IRQCHIP_PIC_MASTER : KVM_IRQCHIP_PIC_SLAVE;
+		expected.u.irqchip.pin = gsi % 8;
+		if (memcmp(&entries[index++], &expected, sizeof(expected)))
+			return false;
+	}
+	for (gsi = 0; gsi < KVM_IOAPIC_NUM_PINS; gsi++) {
+		if (gsi == 2)
+			continue;
+		expected.gsi = gsi;
+		expected.u.irqchip.irqchip = KVM_IRQCHIP_IOAPIC;
+		expected.u.irqchip.pin = gsi ? gsi : 2;
+		if (memcmp(&entries[index++], &expected, sizeof(expected)))
+			return false;
+	}
+	return index == KVM_CRUCIBLE_Q35_INITIAL_ROUTE_COUNT;
+}
+
+static int q35_route_copy_input(struct kvm_crucible_q35_route_effect *effect)
+{
+	void __user *argument = u64_to_user_ptr(effect->original.user_routes);
+	size_t bytes = KVM_CRUCIBLE_Q35_INITIAL_ROUTE_COUNT * sizeof(*effect->entries);
+
+	if (copy_from_user(&effect->header, argument, sizeof(effect->header)))
+		return -EFAULT;
+	effect->input_bytes = sizeof(effect->header);
+	if (effect->header.nr != KVM_CRUCIBLE_Q35_INITIAL_ROUTE_COUNT || effect->header.flags)
+		return -EINVAL;
+	if (effect->original.user_routes > U64_MAX - sizeof(effect->header) - bytes)
+		return -EINVAL;
+	effect->entries = memdup_user((u8 __user *)argument + sizeof(effect->header), bytes);
+	if (IS_ERR(effect->entries)) {
+		int result = PTR_ERR(effect->entries);
+
+		effect->entries = NULL;
+		return result;
+	}
+	effect->input_bytes += bytes;
+	return q35_route_input_is_canonical(effect->entries) ? 0 : -EINVAL;
+}
+
+static bool q35_route_published_same(struct kvm *kvm,
+	const struct kvm_crucible_q35_route_effect *effect)
+{
+	const struct kvm_irq_routing_table *published = effect->published;
+	struct kvm_kernel_irq_routing_entry *native;
+	u32 gsi, count = 0;
+
+	lockdep_assert_held(&kvm->irq_lock);
+	if (!published || published != rcu_dereference_protected(kvm->irq_routing, 1) ||
+	    published->nr_rt_entries != KVM_IOAPIC_NUM_PINS || !effect->entries)
+		return false;
+	for (gsi = 0; gsi < published->nr_rt_entries; gsi++) {
+		hlist_for_each_entry(native, &published->map[gsi], link) {
+			u32 index;
+			bool matched = false;
+
+			for (index = 0; index < effect->header.nr; index++) {
+				const struct kvm_irq_routing_entry *input = &effect->entries[index];
+				struct kvm_kernel_irq_routing_entry projected = {0};
+
+				if (input->gsi != gsi || input->u.irqchip.irqchip != native->irqchip.irqchip)
+					continue;
+				/* The original native route decoder supplies the actual callback
+				 * and slave-pin transformation into a local effect-free projection. */
+				if (kvm_set_routing_entry(kvm, &projected, input) || native->gsi != gsi ||
+				    native->type != input->type || native->set != projected.set ||
+				    native->irqchip.pin != projected.irqchip.pin ||
+				    published->chip[native->irqchip.irqchip][native->irqchip.pin] != gsi)
+					return false;
+				matched = true;
+				break;
+			}
+			if (!matched)
+				return false;
+			count++;
+		}
+	}
+	return count == effect->header.nr;
+}
+
+static void q35_route_snapshot(struct kvm_crucible_q35_route_effect *effect)
+{
+	struct kvm_kernel_irq_routing_entry *entry;
+	u32 gsi;
+
+	if (!effect->published)
+		return;
+	effect->native_gsis = effect->published->nr_rt_entries;
+	if (effect->native_gsis > KVM_IOAPIC_NUM_PINS)
+		return;
+	for (gsi = 0; gsi < effect->native_gsis; gsi++)
+		hlist_for_each_entry(entry, &effect->published->map[gsi], link)
+			effect->native_count++;
+}
+
+bool kvm_arch_crucible_q35_route_native_owned(struct kvm *kvm,
+	const struct kvm_irq_routing_entry *entries, unsigned int nr,
+	struct kvm_irq_routing_table **published)
+{
+	const struct kvm_crucible_q35_route_state *state = &kvm->arch.crucible_pic_board.q35_route;
+	const struct kvm_crucible_q35_route_effect *effect = &state->effect;
+
+	return state->selected && state->inflight && !state->uncertain && state->issued == 1 &&
+		effect->inflight && !effect->uncertain && effect->actor == current &&
+		entries == effect->entries && nr == effect->header.nr && !effect->header.flags &&
+		published == &state->effect.published && !effect->published &&
+		kvm->crucible_topology_writers == 1;
+}
+
+static int kvm_crucible_q35_initial_routing_control(struct kvm *kvm,
+	struct kvm_enable_cap *cap)
+{
+	struct kvm_crucible_pic_board *board = &kvm->arch.crucible_pic_board;
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	struct kvm_crucible_q35_route_state *state = &board->q35_route;
+	struct kvm_crucible_q35_route_effect *effect = &state->effect;
+	struct kvm_crucible_q35_initial_routing request;
