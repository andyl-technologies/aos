+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Original finite q35 normal/SMM RAM alias effects. CPU initialization can
+ * precede RAM publication; no stage here enables a clock or guest execution. */
+
+static bool q35_memory_zero_region(const struct kvm_userspace_memory_region *memory)
+{
+	return !memory->slot && !memory->flags && !memory->guest_phys_addr &&
+		!memory->memory_size && !memory->userspace_addr;
+}
+
+static bool q35_memory_request_valid(const struct kvm_crucible_q35_memory *request)
+{
+	const struct kvm_userspace_memory_region *memory = &request->memory;
+	u32 index;
+
+	if (request->version != 2 || !request->enrollment_id ||
+	    !request->maximum_effects ||
+	    request->maximum_effects > KVM_CRUCIBLE_Q35_MEMORY_MAX_EFFECTS ||
+	    !request->maximum_slots ||
+	    request->maximum_slots > KVM_CRUCIBLE_Q35_MEMORY_MAX_SLOTS ||
+	    request->maximum_slots > KVM_USER_MEM_SLOTS || request->issued_effects ||
+	    request->native_result || request->flags || request->native_slots)
+		return false;
+	for (index = 0; index < ARRAY_SIZE(request->reserved); index++)
+		if (request->reserved[index])
+			return false;
+
+	switch (request->operation) {
+	case KVM_CRUCIBLE_Q35_MEMORY_SELECT:
+	case KVM_CRUCIBLE_Q35_MEMORY_SEAL:
+		return !request->effect_index && q35_memory_zero_region(memory);
+	case KVM_CRUCIBLE_Q35_MEMORY_QUERY:
+		return q35_memory_zero_region(memory);
+	case KVM_CRUCIBLE_Q35_MEMORY_APPLY:
+		return request->effect_index &&
+			(u16)memory->slot < request->maximum_slots &&
+			(memory->slot >> 16) < KVM_MAX_NR_ADDRESS_SPACES &&
+			!(memory->flags & ~KVM_MEM_READONLY) &&
+			!(memory->memory_size & (PAGE_SIZE - 1)) &&
+			!(memory->guest_phys_addr & (PAGE_SIZE - 1)) &&
+			!(memory->userspace_addr & (PAGE_SIZE - 1)) &&
+			memory->memory_size <= KVM_CRUCIBLE_Q35_MEMORY_MAX_REGION_BYTES &&
+			memory->memory_size <= ULONG_MAX &&
+			memory->userspace_addr <= ULONG_MAX - memory->memory_size &&
+			memory->guest_phys_addr <= U64_MAX - memory->memory_size;
+	default:
+		return false;
+	}
+}
+
+static bool q35_memory_same(const struct kvm_crucible_q35_memory_state *state,
+	const struct kvm_crucible_q35_memory *request)
+{
+	return state->selected && state->enrollment_id == request->enrollment_id &&
+		state->maximum_effects == request->maximum_effects &&
+		state->maximum_slots == request->maximum_slots;
+}
+
+static bool q35_memory_live_locked(struct kvm *kvm)
+{
+	struct kvm_crucible_pic_board *board = &kvm->arch.crucible_pic_board;
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	u32 index;
+
+	lockdep_assert_held(&kvm->crucible_configuration_lock);
+	lockdep_assert_held(&kvm->irq_lock);
+	lockdep_assert_held(&kvm->crucible_gate_lock);
+	if (board->edition != KVM_CRUCIBLE_Q35_BOARD_ONLY ||
+	    board->phase != PIC_MEMORY_BOARD_ENROLLED || board->constructor != current ||
+	    board->pic != kvm->arch.vpic || board->pit != kvm->arch.vpit ||
+	    board->ioapic != kvm->arch.vioapic ||
+	    board->routing != rcu_dereference_protected(kvm->irq_routing, 1) ||
+	    !board->initializer_roster.selected || board->initializer_roster.uncertain ||
+	    kvm->created_vcpus > KVM_CRUCIBLE_PIC_INITIALIZER_V2_CPUS ||
+	    clock->enabled || clock->active || clock->run_owners || clock->timer_owners ||
+	    kvm->crucible_controlled || kvm->crucible_continuation_roster_frozen ||
+	    kvm->crucible_irq_input.owners || kvm->crucible_irq_input.tainted ||
+	    kvm->crucible_memory_tainted || READ_ONCE(kvm->vm_dead))
+		return false;
+	for (index = 0; index < KVM_CRUCIBLE_PIC_INITIALIZER_V2_CPUS; index++)
+		if (board->initializer_roster.actors[index].inflight ||
+		    board->initializer_roster.actors[index].uncertain)
+			return false;
+	return true;
+}
+
+static bool q35_memory_slot_matches(struct kvm *kvm,
+	const struct kvm_userspace_memory_region *memory)
+{
+	struct kvm_memory_slot *slot;
+	u32 as_id = memory->slot >> 16;
+	u32 id = (u16)memory->slot;
+
+	lockdep_assert_held(&kvm->slots_lock);
+	slot = id_to_memslot(__kvm_memslots(kvm, as_id), id);
+	if (!memory->memory_size)
+		return !slot || !slot->npages;
+	return slot && slot->id == id && slot->as_id == as_id &&
+		slot->base_gfn == (memory->guest_phys_addr >> PAGE_SHIFT) &&
+		slot->npages == (memory->memory_size >> PAGE_SHIFT) &&
+		slot->userspace_addr == memory->userspace_addr &&
+		slot->flags == memory->flags;
+}
+
+static void q35_memory_report(const struct kvm_crucible_q35_memory_state *state,
+	struct kvm_crucible_q35_memory *request)
+{
+	const struct kvm_crucible_q35_memory_effect *effect;
+
+	request->issued_effects = state->issued;
+	request->native_slots = state->native_slots;
+	request->flags = (state->selected ? KVM_CRUCIBLE_Q35_MEMORY_SELECTED : 0) |
+		(state->inflight ? KVM_CRUCIBLE_Q35_MEMORY_INFLIGHT : 0) |
+		(state->uncertain ? KVM_CRUCIBLE_Q35_MEMORY_UNCERTAIN : 0) |
+		(state->sealed ? KVM_CRUCIBLE_Q35_MEMORY_SEALED : 0);
+	if (!request->effect_index)
+		return;
+	effect = &state->effects[request->effect_index - 1];
+	request->memory = effect->original.memory;
+	request->native_result = effect->native_result;
+	if (effect->known)
+		request->flags |= KVM_CRUCIBLE_Q35_MEMORY_KNOWN;
+}
+
+/* The slots mutex protects actual table pointers while topology is still
+ * open. Successful seal then closes this source lane before those references
+ * are published; no plan or earlier counter creates an actual slot. */
+static bool q35_memory_current_cut(struct kvm *kvm,
+	struct kvm_crucible_q35_memory_state *state)
+{
+	u32 as_id, id, index, count = 0;
+
+	lockdep_assert_held(&kvm->slots_lock);
+	for (as_id = 0; as_id < kvm_arch_nr_memslot_as_ids(kvm); as_id++) {
+		struct kvm_memslots *table = __kvm_memslots(kvm, as_id);
+
+		if (as_id >= KVM_MAX_NR_ADDRESS_SPACES || !table)
+			return false;
+		state->tables[as_id] = table;
+		for (id = 0; id < KVM_USER_MEM_SLOTS; id++) {
+			const struct kvm_crucible_q35_memory_effect *latest = NULL;
+			struct kvm_memory_slot *slot = id_to_memslot(table, id);
+
+			if (id >= state->maximum_slots) {
+				if (slot && slot->npages)
+					return false;
+				continue;
+			}
+			for (index = 0; index < state->issued; index++) {
+				const struct kvm_crucible_q35_memory_effect *effect =
+					&state->effects[index];
+
+				if (!effect->known)
+					return false;
+				if (effect->original.memory.slot == ((as_id << 16) | id))
+					latest = effect;
+			}
+			if (!latest) {
+				if (slot && slot->npages)
+					return false;
+				state->slots[as_id][id] = NULL;
+				continue;
+			}
+			if (!q35_memory_slot_matches(kvm, &latest->original.memory))
+				return false;
+			state->slots[as_id][id] = slot && slot->npages ? slot : NULL;
+			if (state->slots[as_id][id])
+				count++;
+		}
+	}
+	state->native_slots = count;
+	return count != 0;
+}
+
+static int kvm_crucible_q35_memory_control(struct kvm *kvm,
+	struct kvm_enable_cap *cap)
+{
+	struct kvm_crucible_pic_board *board = &kvm->arch.crucible_pic_board;
+	struct kvm_crucible_q35_memory_state *state = &board->q35_memory;
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	struct kvm_crucible_q35_memory request;
+	struct kvm_crucible_q35_memory_effect *effect = NULL;
+	struct kvm_userspace_memory_region2 memory = {};
+	void __user *user = u64_to_user_ptr(cap->args[0]);
+	unsigned long flags;
+	bool entered = false, contain = false, cut = false;
+	int result;
+	u32 index;
+
+	BUILD_BUG_ON(sizeof(request) != 128);
+	BUILD_BUG_ON(KVM_MAX_NR_ADDRESS_SPACES > KVM_CRUCIBLE_Q35_MEMORY_MAX_AS_IDS);
+	if (cap->flags || !user || cap->args[1] || cap->args[2] || cap->args[3])
+		return -EINVAL;
+	/* This is the only input copy. Both the immutable journal and the native
+	 * callback below consume this exact retained region header. */
+	if (copy_from_user(&request, user, sizeof(request)))
+		return -EFAULT;
+	if (!q35_memory_request_valid(&request))
+		return -EINVAL;
+	if (!mutex_trylock(&clock->control_lock))
+		return -EBUSY;
+	if (!mutex_trylock(&kvm->crucible_configuration_lock)) {
+		mutex_unlock(&clock->control_lock);
+		return -EBUSY;
+	}
