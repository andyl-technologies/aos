+	    board->q35_configuration.inflight || board->q35_configuration.uncertain ||
+	    !board->q35_configuration.selected || kvm->crucible_topology_writers ||
+	    request.enrollment_id != board->q35_configuration.enrollment_id)
+		goto unlock_admission;
+	if (request.operation == KVM_CRUCIBLE_Q35_ROUTE_SELECT) {
+		if (state->selected)
+			goto unlock_admission;
+		state->enrollment_id = request.enrollment_id;
+		state->original_routing = board->routing;
+		kvm_get_irq_routing_table(state->original_routing);
+		state->selected = true;
+		q35_route_report(state, &request);
+		result = 0;
+		goto unlock_admission;
+	}
+	if (!q35_route_same(state, &request) || state->issued || request.effect_index != 1)
+		goto unlock_admission;
