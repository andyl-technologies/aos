+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Original worker's loaded hardware counter preparation. The embedded rows
+ * reserve one immutable Apply and one cached Query each; no caller IDs grant
+ * task/vCPU authority and no active clock or guest entry is enabled here. */
+
+static bool q35_counter_actor_locked(struct kvm *kvm,
+	const struct kvm_crucible_q35_loaded_counter *request,
+	struct kvm_vcpu *vcpu, u32 writers)
+{
+	struct kvm_crucible_pic_board *board = &kvm->arch.crucible_pic_board;
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	struct kvm_crucible_pic_initializer_state *actor;
+	u32 index;
+
+	lockdep_assert_held(&kvm->crucible_gate_lock);
+	actor = pic_initializer_actor_state(kvm, vcpu);
+	if (!board->initializer_roster.selected || board->initializer_roster.uncertain ||
+	    board->phase != CRUCIBLE_PIC_BOARD_ENROLLED || !board->constructor ||
+	    !board->q35_configuration.selected || board->q35_configuration.inflight ||
+	    board->q35_configuration.uncertain ||
+	    board->q35_configuration.enrollment_id != request->configuration_enrollment_id ||
+	    !actor || actor->task != current || actor->vcpu != vcpu ||
+	    actor->native_vcpu_id != request->native_vcpu_id ||
+	    actor->initializer_tid != request->initializer_tid ||
+	    actor->enrollment_id != request->enrollment_id ||
+	    actor->inflight || actor->uncertain || !actor->issued ||
+	    actor->issued > actor->maximum_effects ||
+	    kvm_get_vcpu(kvm, request->native_vcpu_id) != vcpu ||
+	    kvm->created_vcpus != KVM_CRUCIBLE_PIC_INITIALIZER_V2_CPUS ||
+	    kvm->crucible_topology_writers != writers || kvm->crucible_effect_owners ||
+	    kvm->crucible_memory_notifier_owners || kvm->crucible_memory_tainted ||
+	    kvm->crucible_irq_input.owners || kvm->crucible_irq_input.tainted ||
+	    clock->enabled || clock->active || clock->version || clock->window_generation ||
+	    clock->frozen_ns || clock->start_ns || clock->end_ns || clock->host_origin_ns ||
+	    clock->numerator || clock->denominator || clock->close_acknowledged ||
+	    clock->run_owners || clock->timer_owners ||
+	    clock->continuation.configured || clock->continuation.started)
+		return false;
+	for (index = 0; index < actor->issued; index++)
+		if (!actor->effects[index].known)
+			return false;
+	return true;
+}
+
+static int kvm_crucible_q35_loaded_counter_control(struct kvm *kvm,
+	struct kvm_enable_cap *cap)
+{
+	struct kvm_crucible_q35_loaded_counter request, identity, output;
+	struct kvm_crucible_pic_board *board = &kvm->arch.crucible_pic_board;
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	struct kvm_crucible_q35_counter_row *row;
+	struct kvm_vcpu *vcpu;
+	void __user *argument = u64_to_user_ptr(cap->args[0]);
+	unsigned long flags;
+	long native_result;
+	bool known = false, contain = false;
+	int result = -EOPNOTSUPP;
+
+	BUILD_BUG_ON(sizeof(request) != 80);
+	if (cap->flags || !cap->args[0] || cap->args[1] || cap->args[2] || cap->args[3])
+		return -EINVAL;
+	if (copy_from_user(&request, argument, sizeof(request)))
+		return -EFAULT;
+	if (request.version != 1 ||
+	    (request.operation != KVM_CRUCIBLE_Q35_COUNTER_APPLY &&
+	     request.operation != KVM_CRUCIBLE_Q35_COUNTER_QUERY) ||
+	    !request.configuration_enrollment_id || !request.enrollment_id ||
+	    !request.initializer_tid || request.native_vcpu_id >=
+		KVM_CRUCIBLE_PIC_INITIALIZER_V2_CPUS ||
+	    request.expected_coverage != KVM_CRUCIBLE_Q35_COUNTER_COVERAGE ||
+	    request.native_result || request.flags || request.observed_coverage ||
+	    request.reserved[0] || request.reserved[1])
+		return -EINVAL;
+	if (!mutex_trylock(&clock->control_lock))
+		return -EBUSY;
+	if (!mutex_trylock(&kvm->crucible_configuration_lock)) {
+		mutex_unlock(&clock->control_lock);
+		return -EBUSY;
+	}
+	vcpu = kvm_get_vcpu(kvm, request.native_vcpu_id);
+	if (!vcpu || !mutex_trylock(&vcpu->mutex)) {
+		result = -EBUSY;
+		goto unlock_configuration;
+	}
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	row = &board->counter_rows[request.native_vcpu_id];
+	if (!q35_counter_actor_locked(kvm, &request, vcpu, 0))
+		goto unlock_gate;
+	if (request.operation == KVM_CRUCIBLE_Q35_COUNTER_QUERY) {
+		identity = request;
+		identity.operation = KVM_CRUCIBLE_Q35_COUNTER_APPLY;
+		if (!row->applied || row->inflight || row->queried || row->uncertain ||
+		    !row->known || row->task != current || row->vcpu != vcpu ||
+		    memcmp(&identity, &row->original, sizeof(identity)))
+			goto unlock_gate;
+		row->queried = true;
+		output = row->output;
+		output.operation = request.operation;
+		result = 0;
+		goto unlock_gate;
+	}
+	if (row->applied)
+		goto unlock_gate;
+
+	/* Reserve the fixed original row and its writer before vcpu_load or any
+	 * native hardware setter. Delivery loss never creates an Apply retry. */
+	row->original = request;
+	row->task = current;
+	row->vcpu = vcpu;
+	row->applied = true;
+	row->inflight = true;
+	row->native_result = -EINPROGRESS;
+	kvm->crucible_topology_writers++;
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+
+	vcpu_load(vcpu);
+	preempt_disable();
+	native_result = kvm_x86_call(crucible_counter_intercepts)(vcpu);
+	preempt_enable();
+	vcpu_put(vcpu);
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	/* The same original Task/vCPU/immutable row and writer remain retained
+	 * across the actual loaded callback, before caching or public delivery. */
+	known = native_result == 0 && row->inflight && row->task == current &&
+		row->vcpu == vcpu && !memcmp(&request, &row->original, sizeof(request)) &&
+		q35_counter_actor_locked(kvm, &request, vcpu, 1);
+	row->native_result = native_result;
+	row->inflight = false;
+	row->known = known;
+	row->uncertain = !known;
+	row->output = request;
+	row->output.native_result = native_result;
+	if (known) {
+		row->output.observed_coverage = KVM_CRUCIBLE_Q35_COUNTER_COVERAGE;
+		row->output.flags = KVM_CRUCIBLE_Q35_COUNTER_KNOWN |
+			KVM_CRUCIBLE_Q35_COUNTER_LOADED |
+			KVM_CRUCIBLE_Q35_COUNTER_CONSTRUCTOR;
+		kvm->crucible_topology_writers--;
+		output = row->output;
+		result = 0;
+	} else {
+		board->initializer_roster.uncertain = true;
+		result = native_result < 0 ? native_result : -EAGAIN;
+	}
