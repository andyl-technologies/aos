@@ -0,0 +1,98 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __KVM_CRUCIBLE_PS_CLOCK_H
+#define __KVM_CRUCIBLE_PS_CLOCK_H
+
+#ifdef __KERNEL__
+#include <linux/math64.h>
+#include <linux/types.h>
+#endif
+
+/* The master coordinate remains unsigned picoseconds. Only projections to
+ * native nanosecond timers lose resolution; native TSC reads use PS directly.
+ * The caller proves start <= end and slice > 0 before installing the cut.
+ */
+static inline u64 kvm_crucible_ps_project(u64 elapsed_ns, u64 start_ps,
+	u64 end_ps, u64 slice_ns)
+{
+	if (elapsed_ns >= slice_ns)
+		return end_ps;
+	return start_ps + mul_u64_u64_div_u64(elapsed_ns,
+		end_ps - start_ps, slice_ns);
+}
+
+/* A kHz rate means one cycle per billion PS. Splitting preserves sub-ns
+ * positions without a 64-bit product overflow. Counter wrap is architectural.
+ */
+static inline u64 kvm_crucible_ps_tsc(u64 position_ps, u32 rate_khz)
+{
+	return position_ps / 1000000000 * rate_khz +
+		(position_ps % 1000000000) * rate_khz / 1000000000;
+}
+
+/* Rounding toward the future cannot deliver a native timer before its logical
+ * position. The inverse quotient is at most slice, including a full-u64 Q.
+ */
+static inline u64 kvm_crucible_ps_host_delay(u64 delta_ps, u64 quantum_ps,
+	u64 slice_ns)
+{
+	u64 delay = mul_u64_u64_div_u64(delta_ps, slice_ns, quantum_ps);
+
+	if (delay < slice_ns &&
+	    mul_u64_u64_div_u64(delay, quantum_ps, slice_ns) < delta_ps)
+		delay++;
+	return delay;
+}
+
+static inline bool kvm_crucible_ps_next_boundary(u64 current_ps, u64 quantum_ps,
+	u64 phase_ps, u64 *end_ps)
+{
+	if (!quantum_ps || phase_ps >= quantum_ps || current_ps < phase_ps ||
+	    (current_ps - phase_ps) % quantum_ps ||
+	    quantum_ps > U64_MAX - current_ps)
+		return false;
+	*end_ps = current_ps + quantum_ps;
+	return true;
+}
+
+/* A kick seals future admission; it does not assert physical completion or
+ * authorize another interval. Native owner and output cuts are separate.
+ */
+enum kvm_crucible_ps_phase {
+	KVM_CRUCIBLE_PS_UNSELECTED,
+	KVM_CRUCIBLE_PS_COLD,
+	KVM_CRUCIBLE_PS_ACTIVE,
+	KVM_CRUCIBLE_PS_STOP_REQUESTED,
+	KVM_CRUCIBLE_PS_NATIVE_CLOSED,
+	KVM_CRUCIBLE_PS_ACKNOWLEDGED,
+	KVM_CRUCIBLE_PS_UNKNOWN,
+};
+
+struct kvm_crucible_ps_boundary_cut {
+	u64 generation;
+	u64 requested_generation;
+	u64 current_ps;
+	u64 start_ps;
+	u64 end_ps;
+	u64 quantum_ps;
+	u64 phase_ps;
+	u32 phase;
+	bool owners_busy;
+	bool pending_io;
+};
+
+static inline bool kvm_crucible_ps_begin_valid(
+	const struct kvm_crucible_ps_boundary_cut *cut)
+{
+	u64 end_ps;
+
+	return (cut->phase == KVM_CRUCIBLE_PS_COLD ||
+		cut->phase == KVM_CRUCIBLE_PS_ACKNOWLEDGED) &&
+		!cut->owners_busy && !cut->pending_io &&
+		cut->generation != U64_MAX &&
+		cut->requested_generation == cut->generation + 1 &&
+		cut->start_ps == cut->current_ps &&
+		kvm_crucible_ps_next_boundary(cut->start_ps, cut->quantum_ps,
+			cut->phase_ps, &end_ps) && cut->end_ps == end_ps;
+}
+
+#endif
