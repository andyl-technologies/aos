+/* Original native Q35 device birth uses the same unconfigured VM clock field
+ * as cap41. Ordinary and old PIC constructors keep their original clock. */
+
+int kvm_crucible_q35_bootstrap_clock_read(struct kvm *kvm, u64 *logical_ns)
+{
+	struct kvm_crucible_pic_board *board = &kvm->arch.crucible_pic_board;
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	unsigned long flags;
+	int result = -ENOENT;
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	if (board->edition != KVM_CRUCIBLE_Q35_BOARD_ONLY || !board->phase)
+		goto unlock;
+	result = -EPERM;
+	if (!logical_ns || board->constructor != current ||
+	    READ_ONCE(kvm->vm_dead) || kvm->crucible_memory_tainted ||
+	    kvm->crucible_controlled || kvm->crucible_continuation_roster_frozen ||
+	    (kvm->crucible_topology_writers &&
+	     !kvm_arch_crucible_q35_device_pit_owned_locked(kvm)) ||
+	    kvm->crucible_effect_owners ||
+	    kvm->crucible_irq_input.enabled || kvm->crucible_irq_input.owners ||
+	    kvm->crucible_irq_input.tainted || clock->enabled || clock->active ||
+	    clock->version || clock->window_generation || clock->frozen_ns ||
+	    clock->start_ns || clock->end_ns || clock->host_origin_ns ||
+	    clock->numerator || clock->denominator || clock->close_acknowledged ||
+	    clock->run_owners || clock->timer_owners ||
+	    clock->continuation.configured || clock->continuation.started)
+		goto unlock;
+	if (board->phase == CRUCIBLE_PIC_BOARD_BUILDING) {
+		/* The original source reservation precedes kvm_create_pit. No
+		 * public/PIT pointer exists yet and no vCPU may already exist. */
+		if (board->result != -EIO || kvm->created_vcpus)
+			goto unlock;
+	} else if (board->phase == CRUCIBLE_PIC_BOARD_ENROLLED) {
+		if (board->result || !board->birth.known || !board->pic ||
+		    board->pic != kvm->arch.vpic || !board->ioapic ||
+		    board->ioapic != kvm->arch.vioapic || !board->pit ||
+		    board->pit != kvm->arch.vpit)
+			goto unlock;
+	} else {
+		goto unlock;
+	}
+	*logical_ns = clock->frozen_ns;
+	result = 0;
+unlock:
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	return result;
+}
+EXPORT_SYMBOL_FOR_KVM_INTERNAL(kvm_crucible_q35_bootstrap_clock_read);
