+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifdef CONFIG_KVM_IOAPIC
+/* Once-owned original native device initialization. This source journal
+ * neither activates the board nor permits runtime device/IRQ effects. */
+
+static bool q35_device_request_valid(const struct kvm_crucible_q35_device_initializer *request)
+{
+	u32 index;
+
+	if (request->version != 2 || !request->enrollment_id ||
+	    !request->maximum_effects || request->maximum_effects > KVM_CRUCIBLE_Q35_DEVICE_MAX_EFFECTS ||
+	    request->issued_effects || request->flags || request->input_bytes ||
+	    request->output_bytes || request->native_result || request->native_aux)
+		return false;
+	for (index = 0; index < ARRAY_SIZE(request->reserved); index++)
+		if (request->reserved[index])
+			return false;
+	if (request->operation == KVM_CRUCIBLE_Q35_DEVICE_SELECT)
+		return !request->effect_index && !request->native_ioctl && !request->user_buffer;
+	if (request->operation == KVM_CRUCIBLE_Q35_DEVICE_QUERY)
+		return request->effect_index <= request->maximum_effects &&
+			!request->native_ioctl && !request->user_buffer;
+	return request->operation == KVM_CRUCIBLE_Q35_DEVICE_APPLY &&
+		request->effect_index && request->effect_index <= request->maximum_effects &&
+		request->native_ioctl && request->user_buffer;
+}
+
+static size_t q35_device_buffer_bytes(u32 native_ioctl)
+{
+	switch (native_ioctl) {
+	case KVM_GET_IRQCHIP:
+	case KVM_SET_IRQCHIP:
+		return sizeof(struct kvm_irqchip);
+	case KVM_GET_PIT2:
+	case KVM_SET_PIT2:
+		return sizeof(struct kvm_pit_state2);
+	case KVM_IRQ_LINE:
+	case KVM_IRQ_LINE_STATUS:
+		return sizeof(struct kvm_irq_level);
+	default:
+		return 0;
+	}
+}
+
+static bool q35_device_same(const struct kvm_crucible_q35_device_state *state,
+	const struct kvm_crucible_q35_device_initializer *request)
+{
+	return state->selected && state->enrollment_id == request->enrollment_id &&
+		state->maximum_effects == request->maximum_effects;
+}
+
+static void q35_device_report(const struct kvm_crucible_q35_device_state *state,
+	struct kvm_crucible_q35_device_initializer *request)
+{
+	u32 operation = request->operation;
+
+	if (request->effect_index) {
+		const struct kvm_crucible_q35_device_effect *effect =
+			&state->effects[request->effect_index - 1];
+
+		*request = effect->original;
+		request->operation = operation;
+		request->input_bytes = effect->bytes;
+		request->output_bytes = effect->known ? effect->bytes : 0;
+		request->native_result = effect->native_result;
+		request->native_aux = effect->native_aux;
+		request->flags = effect->known ? KVM_CRUCIBLE_Q35_DEVICE_KNOWN : 0;
+	}
+	request->issued_effects = state->issued;
+	request->flags |= KVM_CRUCIBLE_Q35_DEVICE_SELECTED |
+		(state->inflight ? KVM_CRUCIBLE_Q35_DEVICE_INFLIGHT : 0) |
+		(state->uncertain ? KVM_CRUCIBLE_Q35_DEVICE_UNCERTAIN : 0);
+}
+
+static struct kvm_crucible_q35_device_effect *q35_device_current_effect_locked(struct kvm *kvm)
+{
+	struct kvm_crucible_pic_board *board = &kvm->arch.crucible_pic_board;
+	struct kvm_crucible_q35_device_state *state = &board->q35_device;
+	struct kvm_crucible_q35_device_effect *effect;
+
+	lockdep_assert_held(&kvm->crucible_gate_lock);
+	if (!state->selected || state->uncertain || !state->inflight || !state->issued ||
+	    state->issued > state->maximum_effects || !state->effects ||
+	    board->edition != KVM_CRUCIBLE_Q35_BOARD_ONLY ||
+	    board->phase != CRUCIBLE_PIC_BOARD_ENROLLED || board->result ||
+	    board->constructor != current || !board->birth.known ||
+	    board->pic != kvm->arch.vpic || board->ioapic != kvm->arch.vioapic ||
+	    board->pit != kvm->arch.vpit || !board->pit ||
+	    kvm->crucible_topology_writers != 1 || kvm->crucible_effect_owners ||
+	    kvm->arch.crucible_clock.enabled || kvm->arch.crucible_clock.active ||
+	    kvm->arch.crucible_clock.version || kvm->arch.crucible_clock.window_generation ||
+	    kvm->arch.crucible_clock.frozen_ns || kvm->arch.crucible_clock.start_ns ||
+	    kvm->arch.crucible_clock.end_ns || kvm->arch.crucible_clock.host_origin_ns ||
+	    kvm->arch.crucible_clock.numerator || kvm->arch.crucible_clock.denominator ||
+	    kvm->arch.crucible_clock.close_acknowledged ||
+	    kvm->arch.crucible_clock.continuation.configured ||
+	    kvm->arch.crucible_clock.continuation.started ||
+	    kvm->arch.crucible_clock.run_owners || kvm->arch.crucible_clock.timer_owners ||
+	    kvm->crucible_irq_input.enabled || kvm->crucible_irq_input.tainted ||
+	    kvm->crucible_memory_tainted || READ_ONCE(kvm->vm_dead))
+		return NULL;
+	effect = &state->effects[state->issued - 1];
+	return effect->actor == current && effect->inflight && !effect->uncertain &&
+		effect->input && effect->native_buffer && effect->bytes ? effect : NULL;
+}
+
+bool kvm_arch_crucible_q35_device_pit_owned_locked(struct kvm *kvm)
+{
+	struct kvm_crucible_q35_device_effect *effect = q35_device_current_effect_locked(kvm);
+
+	return effect && effect->native_entered && effect->original.native_ioctl == KVM_SET_PIT2;
+}
+EXPORT_SYMBOL_FOR_KVM_INTERNAL(kvm_arch_crucible_q35_device_pit_owned_locked);
+
+struct kvm_crucible_q35_device_effect *
+kvm_arch_crucible_q35_device_pit_seed_locked(struct kvm *kvm)
+{
+	return kvm_arch_crucible_q35_device_pit_owned_locked(kvm) ?
+		q35_device_current_effect_locked(kvm) : NULL;
+}
+EXPORT_SYMBOL_FOR_KVM_INTERNAL(kvm_arch_crucible_q35_device_pit_seed_locked);
+
+void kvm_arch_crucible_q35_device_initializer_fault(struct kvm *kvm)
+{
+	struct kvm_crucible_q35_device_state *state = &kvm->arch.crucible_pic_board.q35_device;
+	unsigned long flags;
+
+	/* A nested native refusal must make the original row sticky Unknown
+	 * before containment, without releasing its reserved writer credit. */
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	if (state->selected && state->inflight && state->effects && state->issued &&
+	    state->issued <= state->maximum_effects) {
+		state->effects[state->issued - 1].uncertain = true;
+		state->uncertain = true;
+	}
+	kvm->crucible_memory_tainted = true;
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	kvm_vm_dead(kvm);
+}
+EXPORT_SYMBOL_FOR_KVM_INTERNAL(kvm_arch_crucible_q35_device_initializer_fault);
+
+bool kvm_arch_crucible_q35_device_irq_claim_locked(struct kvm *kvm, u32 source_kind,
+	int source, u32 gsi, int level, bool line_status)
+{
+	struct kvm_crucible_q35_device_effect *effect = q35_device_current_effect_locked(kvm);
+	const struct kvm_irq_level *input;
+
+	if (!effect || !effect->native_entered || effect->source_claimed ||
+	    (effect->original.native_ioctl != KVM_IRQ_LINE &&
+	     effect->original.native_ioctl != KVM_IRQ_LINE_STATUS) ||
+	    source_kind != KVM_CRUCIBLE_IRQ_SOURCE_LINE ||
+	    source != KVM_USERSPACE_IRQ_SOURCE_ID || level ||
+	    line_status != (effect->original.native_ioctl == KVM_IRQ_LINE_STATUS))
+		return false;
+	input = effect->input;
+	if (input->irq != gsi || input->level != level)
+		return false;
+	effect->source_claimed = true;
+	return true;
+}
+EXPORT_SYMBOL_FOR_KVM_INTERNAL(kvm_arch_crucible_q35_device_irq_claim_locked);
+
+static bool q35_device_input_quiescent(const struct kvm_crucible_q35_device_effect *effect)
+{
+	u32 index;
+
+	switch (effect->original.native_ioctl) {
+	case KVM_GET_IRQCHIP:
+	case KVM_SET_IRQCHIP: {
+		const struct kvm_irqchip *chip = effect->input;
+
+		if (chip->pad || chip->chip_id > KVM_IRQCHIP_IOAPIC)
+			return false;
+		if (effect->original.native_ioctl == KVM_GET_IRQCHIP)
+			return !memchr_inv(chip->chip.dummy, 0, sizeof(chip->chip.dummy));
+		if (chip->chip_id == KVM_IRQCHIP_IOAPIC) {
+			if (chip->chip.ioapic.irr)
+				return false;
+			for (index = 0; index < KVM_IOAPIC_NUM_PINS; index++)
+				if (!(chip->chip.ioapic.redirtbl[index].bits & (1ULL << 16)))
+					return false;
+		} else if (chip->chip.pic.irr || chip->chip.pic.isr || chip->chip.pic.last_irr) {
+			return false;
+		}
+		return true;
+	}
+	case KVM_GET_PIT2:
+		return !memchr_inv(effect->input, 0, effect->bytes);
+	case KVM_SET_PIT2: {
+		const struct kvm_pit_state2 *pit = effect->input;
+
+		if (pit->flags & ~KVM_PIT_FLAGS_HPET_LEGACY ||
+		    memchr_inv(pit->reserved, 0, sizeof(pit->reserved)))
+			return false;
+		for (index = 0; index < ARRAY_SIZE(pit->channels); index++)
+			if (pit->channels[index].count_load_time || pit->channels[index].count != 65536 ||
+			    pit->channels[index].bcd ||
+			    (pit->channels[index].mode != 3 && pit->channels[index].mode != 255))
+				return false;
+		return true;
+	}
+	case KVM_IRQ_LINE:
+	case KVM_IRQ_LINE_STATUS: {
+		const struct kvm_irq_level *irq = effect->input;
+
+		return irq->irq < KVM_IOAPIC_NUM_PINS && !irq->level;
+	}
+	default:
+		return false;
+	}
+}
+
+static int q35_device_native(struct kvm *kvm, struct kvm_crucible_q35_device_effect *effect)
+{
+	unsigned long flags;
+	bool valid;
+
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	/* Validate the exact working buffer passed below, against the immutable
+	 * one-copy journal. No callback can recopy substituted userspace bytes. */
+	valid = q35_device_current_effect_locked(kvm) == effect && !effect->native_entered &&
+		!memcmp(effect->native_buffer, effect->input, effect->bytes) &&
+		((effect->original.native_ioctl != KVM_GET_PIT2 &&
+		  effect->original.native_ioctl != KVM_SET_PIT2) ||
+		 kvm_arch_crucible_q35_pit_bootstrap_quiescent_locked(kvm));
+	if (valid)
+		effect->native_entered = true;
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	if (!valid)
+		return -EPERM;
+	switch (effect->original.native_ioctl) {
+	case KVM_GET_IRQCHIP:
+		return kvm_vm_ioctl_get_irqchip(kvm, effect->native_buffer);
+	case KVM_SET_IRQCHIP:
+		return kvm_vm_ioctl_set_irqchip(kvm, effect->native_buffer);
+	case KVM_GET_PIT2:
+		return kvm_vm_ioctl_get_pit2(kvm, effect->native_buffer);
+	case KVM_SET_PIT2:
+		return kvm_vm_ioctl_set_pit2(kvm, effect->native_buffer);
+	case KVM_IRQ_LINE:
+	case KVM_IRQ_LINE_STATUS:
+		return kvm_vm_ioctl_irq_line(kvm, effect->native_buffer,
+			effect->original.native_ioctl == KVM_IRQ_LINE_STATUS);
+	default:
+		return -EINVAL;
+	}
+}
+
+static int kvm_crucible_q35_device_initializer_control(struct kvm *kvm,
+	struct kvm_enable_cap *cap)
+{
+	struct kvm_crucible_pic_board *board = &kvm->arch.crucible_pic_board;
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	struct kvm_crucible_q35_device_state *state = &board->q35_device;
+	struct kvm_crucible_q35_device_initializer request;
+	struct kvm_crucible_q35_device_effect *effect = NULL;
+	void __user *argument = u64_to_user_ptr(cap->args[0]);
+	unsigned long flags;
+	bool entered = false, contain = false;
+	int result = -EPERM, native_result;
+	size_t bytes;
+
+	BUILD_BUG_ON(sizeof(request) != 104);
+	if (cap->flags || !cap->args[0] || cap->args[1] || cap->args[2] || cap->args[3])
+		return -EINVAL;
+	if (copy_from_user(&request, argument, sizeof(request)))
+		return -EFAULT;
+	if (!q35_device_request_valid(&request))
+		return -EINVAL;
+	if (!mutex_trylock(&clock->control_lock))
+		return -EBUSY;
+	if (!mutex_trylock(&kvm->crucible_configuration_lock)) {
+		mutex_unlock(&clock->control_lock);
+		return -EBUSY;
+	}
+	if (board->constructor != current)
+		goto unlock_configuration;
+	if (request.operation == KVM_CRUCIBLE_Q35_DEVICE_QUERY) {
+		result = -ENOENT;
+		if (q35_device_same(state, &request) && request.effect_index <= state->issued) {
+			if (request.effect_index)
+				effect = &state->effects[request.effect_index - 1];
+			q35_device_report(state, &request);
+			result = 0;
+		}
+		goto unlock_configuration;
+	}
+	if (!mutex_trylock(&kvm->lock)) {
+		result = -EBUSY;
+		goto unlock_configuration;
+	}
+	mutex_lock(&kvm->irq_lock);
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	result = -EOPNOTSUPP;
+	if (!q35_vm_live_locked(kvm) || state->inflight || state->uncertain ||
+	    kvm->crucible_topology_writers || kvm->crucible_effect_owners ||
+	    !board->q35_configuration.selected || board->q35_configuration.inflight ||
+	    board->q35_configuration.uncertain ||
+	    request.enrollment_id != board->q35_configuration.enrollment_id)
+		goto unlock_admission;
+	if (request.operation == KVM_CRUCIBLE_Q35_DEVICE_SELECT) {
+		if (state->selected)
+			goto unlock_admission;
+		state->selected = true;
+		state->enrollment_id = request.enrollment_id;
+		state->maximum_effects = request.maximum_effects;
+		state->inflight = true;
+		kvm->crucible_topology_writers++;
+		entered = true;
+		goto unlock_admission;
+	}
+	bytes = q35_device_buffer_bytes(request.native_ioctl);
+	if (!q35_device_same(state, &request) || !state->effects || !bytes ||
+	    state->issued == state->maximum_effects || request.effect_index != state->issued + 1)
+		goto unlock_admission;
+	effect = &state->effects[state->issued++];
+	effect->original = request;
+	effect->actor = current;
+	effect->bytes = bytes;
+	effect->native_result = -EINPROGRESS;
+	effect->inflight = true;
+	state->inflight = true;
+	kvm->crucible_topology_writers++;
+	entered = true;
+unlock_admission:
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	mutex_unlock(&kvm->irq_lock);
+	mutex_unlock(&kvm->lock);
+unlock_configuration:
+	mutex_unlock(&kvm->crucible_configuration_lock);
+	if (!entered)
+		goto unlock_control;
+	if (!effect) {
+		state->effects = kcalloc(state->maximum_effects, sizeof(*state->effects), GFP_KERNEL_ACCOUNT);
+		native_result = state->effects ? 0 : -ENOMEM;
+	} else {
+		/* The finite slot and both byte obligations were reserved before
+		 * allocation, usercopy or the native callback can have any effect. */
+		effect->input = memdup_user(u64_to_user_ptr(effect->original.user_buffer), effect->bytes);
+		native_result = IS_ERR(effect->input) ? PTR_ERR(effect->input) : 0;
+		if (native_result)
+			effect->input = NULL;
+		if (!native_result && !q35_device_input_quiescent(effect))
+			native_result = -EINVAL;
+		if (!native_result) {
+			effect->native_buffer = kmemdup(effect->input, effect->bytes, GFP_KERNEL_ACCOUNT);
+			if (!effect->native_buffer)
+				native_result = -ENOMEM;
+		}
+		if (!native_result)
+			native_result = q35_device_native(kvm, effect);
+	}
+
+	mutex_lock(&kvm->crucible_configuration_lock);
+	mutex_lock(&kvm->lock);
+	mutex_lock(&kvm->irq_lock);
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	if (effect) {
+		effect->native_result = native_result;
+		if ((effect->original.native_ioctl == KVM_IRQ_LINE ||
+		     effect->original.native_ioctl == KVM_IRQ_LINE_STATUS) && effect->native_buffer)
+			effect->native_aux = ((struct kvm_irq_level *)effect->native_buffer)->status;
+		effect->known = !native_result && effect->native_entered &&
+			q35_device_current_effect_locked(kvm) == effect &&
+			(effect->original.native_ioctl != KVM_SET_PIT2 ||
+			 kvm_arch_crucible_q35_device_pit_result_known_locked(kvm, effect)) &&
+			((effect->original.native_ioctl != KVM_IRQ_LINE &&
+			  effect->original.native_ioctl != KVM_IRQ_LINE_STATUS) || effect->source_claimed) &&
+			!kvm->crucible_irq_input.owners;
+		effect->uncertain = !effect->known;
+		effect->inflight = false;
+		contain = effect->uncertain;
+	} else {
+		contain = native_result || !q35_vm_live_locked(kvm) ||
+			kvm->crucible_topology_writers != 1;
+	}
+	state->inflight = false;
+	if (contain) {
+		state->uncertain = true;
+		kvm->crucible_memory_tainted = true;
+		/* Unknown retains its reserved writer until VM destruction. */
+	} else {
+		kvm->crucible_topology_writers--;
+	}
+	q35_device_report(state, &request);
+	result = contain ? -EAGAIN : 0;
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	mutex_unlock(&kvm->irq_lock);
+	mutex_unlock(&kvm->lock);
+	mutex_unlock(&kvm->crucible_configuration_lock);
+unlock_control:
+	mutex_unlock(&clock->control_lock);
+	if (contain)
+		kvm_vm_dead(kvm);
+	if (!result && effect && effect->known &&
+	    copy_to_user(u64_to_user_ptr(effect->original.user_buffer), effect->native_buffer, effect->bytes))
+		return -EFAULT;
+	if ((!result || entered) && copy_to_user(argument, &request, sizeof(request)))
+		return -EFAULT;
+	return result;
+}
+
+static void kvm_crucible_q35_device_initializer_destroy(struct kvm *kvm)
+{
+	struct kvm_crucible_q35_device_state *state = &kvm->arch.crucible_pic_board.q35_device;
+	u32 index;
+
+	for (index = 0; state->effects && index < state->issued; index++) {
+		kfree(state->effects[index].native_buffer);
+		kfree(state->effects[index].input);
+	}
+	kfree(state->effects);
+}
+
+#else
+
+void kvm_arch_crucible_q35_device_initializer_fault(struct kvm *kvm)
+{
+	kvm_vm_dead(kvm);
+}
+EXPORT_SYMBOL_FOR_KVM_INTERNAL(kvm_arch_crucible_q35_device_initializer_fault);
+
+bool kvm_arch_crucible_q35_device_pit_owned_locked(struct kvm *kvm)
+{
+	return false;
+}
+EXPORT_SYMBOL_FOR_KVM_INTERNAL(kvm_arch_crucible_q35_device_pit_owned_locked);
+
+struct kvm_crucible_q35_device_effect *
+kvm_arch_crucible_q35_device_pit_seed_locked(struct kvm *kvm)
+{
+	return NULL;
+}
+EXPORT_SYMBOL_FOR_KVM_INTERNAL(kvm_arch_crucible_q35_device_pit_seed_locked);
+
+bool kvm_arch_crucible_q35_device_irq_claim_locked(struct kvm *kvm, u32 kind,
+	int source, u32 gsi, int level, bool line_status)
+{
+	return false;
+}
+EXPORT_SYMBOL_FOR_KVM_INTERNAL(kvm_arch_crucible_q35_device_irq_claim_locked);
+
+static int kvm_crucible_q35_device_initializer_control(struct kvm *kvm,
+	struct kvm_enable_cap *cap)
+{
+	return -EOPNOTSUPP;
+}
+
+static void kvm_crucible_q35_device_initializer_destroy(struct kvm *kvm)
+{
+}
