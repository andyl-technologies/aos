+static bool pic_initializer_cpu_result_known(struct kvm_vcpu *vcpu,
+	const struct kvm_crucible_pic_initializer_effect *effect)
+{
+	u64 value;
+
+	if (effect->native_ioctl != KVM_GET_TSC_KHZ)
+		return effect->native_cpu_result == 0;
+	if (!vcpu || effect->output_cpu_bytes != sizeof(value))
+		return false;
+	memcpy(&value, effect->output_cpu, sizeof(value));
+	return value && value <= U32_MAX && value == effect->native_cpu_result &&
+		value == vcpu->arch.virtual_tsc_khz;
+}
