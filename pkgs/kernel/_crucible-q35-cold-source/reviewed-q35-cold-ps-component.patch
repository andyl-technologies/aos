+/* SPDX-License-Identifier: GPL-2.0-only */
+/* The native kernel cut and QEMU publication cut remain separate. This control
+ * reserves a pre-vCPU plan, retains native control results before delivery and
+ * cannot activate a board lacking its original interrupt/response issuers.
+ */
+
+static u64 q35_ps_now_locked(struct kvm_crucible_clock_domain *clock, u64 now_ns)
+{
+	struct kvm_crucible_ps_clock_state *ps = &clock->ps;
+
+	/* A planned phase is not an observed constructor clock reading. */
+	if (ps->phase == KVM_CRUCIBLE_PS_COLD)
+		return 0;
+	if (ps->phase != KVM_CRUCIBLE_PS_ACTIVE)
+		return ps->current_ps;
+	return kvm_crucible_ps_project(now_ns - clock->host_origin_ns,
+		ps->start_ps, ps->end_ps, ps->plan.physical_slice_ns);
+}
+
+static void q35_ps_seal_locked(struct kvm *kvm)
+{
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	struct kvm_crucible_ps_clock_state *ps = &clock->ps;
+
+	lockdep_assert_held(&kvm->crucible_gate_lock);
+	ps->current_ps = ps->end_ps;
+	ps->phase = KVM_CRUCIBLE_PS_STOP_REQUESTED;
+	clock->frozen_ns = ps->current_ps / 1000;
+	clock->active = false;
+	kvm->crucible_active = false;
+	clock->close_acknowledged = false;
+}
+
+static bool q35_ps_geometry_valid(const struct kvm_crucible_q35_ps_clock *request)
+{
+	u64 end_ps;
+	u32 index;
+
+	if (request->version != 1 || !request->configuration_enrollment_id ||
+	    !request->maximum_controls ||
+	    request->maximum_controls > KVM_CRUCIBLE_Q35_PS_MAX_CONTROLS ||
+	    request->request_flags || !request->physical_slice_ns ||
+	    !request->physical_stop_ns ||
+	    request->physical_slice_ns > KTIME_MAX || request->physical_stop_ns > KTIME_MAX ||
+	    !kvm_crucible_ps_next_boundary(request->phase_ps, request->quantum_ps,
+		request->phase_ps, &end_ps) || !request->operation_id ||
+	    request->operation < KVM_CRUCIBLE_Q35_PS_SELECT ||
+	    request->operation > KVM_CRUCIBLE_Q35_PS_OBSERVE ||
+	    request->current_ps || request->host_deadline_ns || request->closed_at_ns ||
+	    request->native_phase || request->native_result || request->run_owners ||
+	    request->timer_owners || request->effect_owners || request->irq_owners ||
+	    request->pending_mask || request->closed_workers || request->flags ||
+	    request->controls_used)
+		return false;
+	for (index = 0; index < ARRAY_SIZE(request->reserved); index++)
+		if (request->reserved[index])
+			return false;
+	return true;
+}
+
+static bool q35_ps_same_plan(const struct kvm_crucible_ps_clock_state *ps,
+	const struct kvm_crucible_q35_ps_clock *request)
+{
+	const struct kvm_crucible_q35_ps_clock *plan = &ps->plan;
+
+	return ps->selected && ps->controller == current &&
+		request->configuration_enrollment_id == plan->configuration_enrollment_id &&
+		request->maximum_controls == plan->maximum_controls &&
+		request->quantum_ps == plan->quantum_ps && request->phase_ps == plan->phase_ps &&
+		request->physical_slice_ns == plan->physical_slice_ns &&
+		request->physical_stop_ns == plan->physical_stop_ns;
+}
+
+static void q35_ps_report_locked(struct kvm *kvm,
+	struct kvm_crucible_q35_ps_clock *result, u64 closed_workers, u64 pending)
+{
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	struct kvm_crucible_ps_clock_state *ps = &clock->ps;
+
+	result->current_ps = q35_ps_now_locked(clock, ktime_get_ns());
+	result->host_deadline_ns = clock->host_ceiling_ns;
+	result->closed_at_ns = ps->closed_at_ns;
+	result->native_phase = ps->phase;
+	result->run_owners = clock->run_owners;
+	result->timer_owners = clock->timer_owners;
+	result->effect_owners = kvm->crucible_effect_owners;
+	result->irq_owners = kvm->crucible_irq_input.owners;
+	result->pending_mask = pending;
+	result->closed_workers = closed_workers;
+	result->controls_used = ps->controls_used;
+	result->flags = KVM_CRUCIBLE_Q35_PS_KNOWN;
+	if (ps->phase == KVM_CRUCIBLE_PS_NATIVE_CLOSED ||
+	    ps->phase == KVM_CRUCIBLE_PS_ACKNOWLEDGED)
+		result->flags |= KVM_CRUCIBLE_Q35_PS_RUNS_CLOSED;
+}
+
+/* Locks are acquired without waiting on a native RUN owner. A failed trylock
+ * cannot certify physical stop. Control/configuration precede native resources;
+ * the original gate is last and is released before hrtimer cancellation/kicks.
+ */
+int kvm_crucible_q35_ps_clock_control(struct kvm *kvm, struct kvm_enable_cap *cap)
+{
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	struct kvm_crucible_ps_clock_state *ps = &clock->ps;
+	struct kvm_crucible_q35_ps_clock request, output, identity;
+	struct kvm_vcpu *vcpu;
+	void __user *argument = u64_to_user_ptr(cap->args[0]);
+	unsigned long flags, index;
+	u64 closed_workers = 0, pending = 0, now;
+	u32 locked = 0;
+	bool kick = false, arm = false, contain = false;
+	int result = -EOPNOTSUPP;
+
+	BUILD_BUG_ON(sizeof(request) != 208);
+	if (cap->flags || !cap->args[0] || cap->args[1] || cap->args[2] || cap->args[3])
+		return -EINVAL;
+	if (copy_from_user(&request, argument, sizeof(request)))
+		return -EFAULT;
+	if (!q35_ps_geometry_valid(&request))
+		return -EINVAL;
+	if (!mutex_trylock(&clock->control_lock))
+		return -EBUSY;
+	result = -EBUSY;
+	if (!mutex_trylock(&kvm->crucible_configuration_lock))
+		goto unlock_control;
+	if (!mutex_trylock(&kvm->lock))
+		goto unlock_configuration;
+	if (!mutex_trylock(&kvm->slots_lock))
+		goto unlock_vm;
+	if (!mutex_trylock(&kvm->irq_lock))
+		goto unlock_slots;
+	if (request.operation == KVM_CRUCIBLE_Q35_PS_OBSERVE)
+		goto native_observation;
+	kvm_for_each_vcpu(index, vcpu, kvm) {
+		if (index != locked || index >= 4 || !mutex_trylock(&vcpu->mutex)) {
+			result = -EBUSY;
+			goto unlock_vcpus;
+		}
+		locked++;
+	}
+
+native_observation:
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	result = -EOPNOTSUPP;
+	now = ktime_get_ns();
+	if (request.operation == KVM_CRUCIBLE_Q35_PS_SELECT) {
+		if (ps->selected || request.operation_id != 1 || request.generation ||
+		    request.start_ps || request.end_ps || request.expected_phase ||
+		    !kvm_arch_crucible_q35_ps_plan_cut_locked(kvm, &request))
+			goto unlock_gate;
+
+		/* This changes no old clock/IRQ fields. The actual ordinary vCPU
+		 * allocation will allocate its private byte journal after this cut. */
+		ps->controller = current;
+		ps->plan = request;
+		ps->current_ps = request.phase_ps;
+		ps->phase = KVM_CRUCIBLE_PS_COLD;
+		ps->selected = true;
+		kvm->crucible_response_enabled = true;
+		kvm->crucible_run_return_enabled = true;
+		kvm->crucible_response_bytes_enabled = true;
+	} else {
+		if (!q35_ps_same_plan(ps, &request))
+			goto unlock_gate;
+		if (request.operation == KVM_CRUCIBLE_Q35_PS_QUERY) {
+			identity = request;
+			identity.operation = ps->last_request.operation;
+			if (!ps->result_known || ps->cached_query ||
+			    memcmp(&identity, &ps->last_request, sizeof(identity)) ||
+			    ps->controls_used >= ps->plan.maximum_controls)
+				goto unlock_gate;
+			ps->cached_query = true;
+			ps->controls_used++;
+			output = ps->last_result;
+			output.operation = request.operation;
+			result = 0;
+			goto unlock_gate;
+		}
+		if (request.operation_id != ps->last_request.operation_id + 1 ||
+		    ps->last_request.operation_id == U64_MAX ||
+		    request.expected_phase != ps->phase ||
+		    (request.operation != KVM_CRUCIBLE_Q35_PS_BEGIN &&
+		     (request.start_ps != ps->start_ps || request.end_ps != ps->end_ps)) ||
+		    request.generation != clock->window_generation +
+			(request.operation == KVM_CRUCIBLE_Q35_PS_BEGIN) ||
+		    (request.operation != KVM_CRUCIBLE_Q35_PS_OBSERVE &&
+		     !kvm_arch_crucible_q35_ps_native_cut_locked(kvm, &closed_workers, &pending)))
+			goto unlock_gate;
+	}
+	if (ps->controls_used >= ps->plan.maximum_controls)
+		goto unlock_gate;
+
+	/* The original operation is charged and retained before a native effect.
+	 * Even a refused operation cannot be retried as a fresh Apply. */
+	ps->controls_used++;
+	ps->last_request = request;
+	ps->cached_query = false;
+	ps->result_known = false;
+	result = 0;
+	if (request.operation == KVM_CRUCIBLE_Q35_PS_BEGIN) {
+		struct kvm_crucible_ps_boundary_cut cut = {
+			.generation = clock->window_generation,
+			.requested_generation = request.generation,
+			.current_ps = ps->current_ps,
+			.start_ps = request.start_ps,
+			.end_ps = request.end_ps,
+			.quantum_ps = ps->plan.quantum_ps,
+			.phase_ps = ps->plan.phase_ps,
+			.phase = ps->phase,
+			.owners_busy = clock->run_owners || clock->timer_owners ||
+				kvm->crucible_effect_owners || kvm->crucible_irq_input.owners,
+			.pending_io = pending || closed_workers != 15,
+		};
+
+		/* Only actual source-installed interrupt/response ownership may open
+		 * execution. Cold readback and a public descriptor cannot supply it. */
+		if (!kvm_arch_crucible_q35_ps_execution_ready_locked(kvm) ||
+		    !kvm_crucible_ps_begin_valid(&cut)) {
+			result = -EOPNOTSUPP;
+			goto cache_result;
+		}
+		if (now > KTIME_MAX || ps->plan.physical_slice_ns > KTIME_MAX - now ||
+		    ps->plan.physical_stop_ns > KTIME_MAX - now - ps->plan.physical_slice_ns) {
+			result = -EOVERFLOW;
+			goto cache_result;
+		}
+		ps->start_ps = request.start_ps;
+		ps->end_ps = request.end_ps;
+		ps->closed_at_ns = 0;
+		ps->phase = KVM_CRUCIBLE_PS_ACTIVE;
+		ps->physical_stop_deadline_ns = now + ps->plan.physical_slice_ns +
+			ps->plan.physical_stop_ns;
+		clock->host_origin_ns = now;
+		clock->host_ceiling_ns = now + ps->plan.physical_slice_ns;
+		clock->window_generation = request.generation;
+		clock->start_ns = request.start_ps / 1000;
+		clock->end_ns = request.end_ps / 1000;
+		clock->frozen_ns = clock->start_ns;
+		clock->close_acknowledged = false;
+		clock->active = true;
+		kvm->crucible_host_ceiling_ns = clock->host_ceiling_ns;
+		kvm->crucible_active = true;
+		arm = true;
+	} else if (request.operation == KVM_CRUCIBLE_Q35_PS_STOP) {
+		if (ps->phase != KVM_CRUCIBLE_PS_ACTIVE || now < clock->host_ceiling_ns) {
+			result = -EAGAIN;
+			goto cache_result;
+		}
+		q35_ps_seal_locked(kvm);
+		kick = true;
+	} else if (request.operation == KVM_CRUCIBLE_Q35_PS_CLOSE) {
+		if (ps->phase != KVM_CRUCIBLE_PS_STOP_REQUESTED ||
+		    clock->active || clock->run_owners || clock->timer_owners ||
+		    hrtimer_active(&clock->ceiling_timer) ||
+		    hrtimer_callback_running(&clock->ceiling_timer) ||
+		    kvm->crucible_effect_owners || kvm->crucible_irq_input.owners ||
+		    pending || closed_workers != 15) {
+			result = -EBUSY;
+			goto cache_result;
+		}
+		if (now > ps->physical_stop_deadline_ns) {
+			ps->phase = KVM_CRUCIBLE_PS_UNKNOWN;
+			contain = true;
+			result = -ETIMEDOUT;
+			goto cache_result;
+		}
+		ps->closed_at_ns = now;
+		ps->phase = KVM_CRUCIBLE_PS_NATIVE_CLOSED;
+	} else if (request.operation == KVM_CRUCIBLE_Q35_PS_ACK) {
+		/* This only acknowledges the kernel cut to its original Task. QEMU
+		 * must seal its actual output cohort before issuing this operation. */
+		if (ps->phase != KVM_CRUCIBLE_PS_NATIVE_CLOSED ||
+		    pending || closed_workers != 15 || clock->run_owners || clock->timer_owners) {
+			result = -EBUSY;
+			goto cache_result;
+		}
+		ps->phase = KVM_CRUCIBLE_PS_ACKNOWLEDGED;
+		clock->close_acknowledged = true;
+	}
+
+cache_result:
+	output = request;
+	output.native_result = result;
+	q35_ps_report_locked(kvm, &output, closed_workers, pending);
+	ps->last_result = output;
+	ps->result_known = true;
+unlock_gate:
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+unlock_vcpus:
+	while (locked)
+		mutex_unlock(&kvm_get_vcpu(kvm, --locked)->mutex);
+	mutex_unlock(&kvm->irq_lock);
+unlock_slots:
+	mutex_unlock(&kvm->slots_lock);
+unlock_vm:
+	mutex_unlock(&kvm->lock);
+unlock_configuration:
+	mutex_unlock(&kvm->crucible_configuration_lock);
+unlock_control:
+	if (arm)
+		hrtimer_start(&clock->ceiling_timer, ns_to_ktime(clock->host_ceiling_ns),
+			HRTIMER_MODE_ABS_HARD);
+	if (kick) {
+		kvm_for_each_vcpu(index, vcpu, kvm) {
+			kvm_make_request(KVM_REQ_EVENT, vcpu);
+			kvm_vcpu_kick(vcpu);
+		}
+	}
+	mutex_unlock(&clock->control_lock);
+	if (contain)
+		kvm_vm_dead(kvm);
+	if (result)
+		return result;
+	return copy_to_user(argument, &output, sizeof(output)) ? -EFAULT : 0;
+}
--- /dev/null
+++ b/arch/x86/kvm/crucible-q35-ps-native-cut.inc.c
@@ -0,0 +1,112 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Original native resources, not a userspace roster, select this clock plan. */
+
+bool kvm_arch_crucible_q35_ps_plan_cut_locked(struct kvm *kvm,
+	const struct kvm_crucible_q35_ps_clock *request)
+{
+	struct kvm_crucible_pic_board *board = &kvm->arch.crucible_pic_board;
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+
+	return q35_vm_live_locked(kvm) && board->constructor == current &&
+		board->q35_configuration.selected && !board->q35_configuration.inflight &&
+		!board->q35_configuration.uncertain &&
+		board->q35_configuration.enrollment_id == request->configuration_enrollment_id &&
+		!kvm->created_vcpus && !kvm->crucible_topology_writers &&
+		!kvm->crucible_effect_owners && !kvm->crucible_memory_notifier_owners &&
+		!kvm->crucible_response_enabled && !kvm->crucible_run_return_enabled &&
+		!kvm->crucible_response_bytes_enabled && !clock->version &&
+		!clock->window_generation && !clock->frozen_ns && !clock->start_ns &&
+		!clock->end_ns && !clock->host_origin_ns && !clock->host_ceiling_ns &&
+		!clock->numerator && !clock->denominator && !clock->close_acknowledged &&
+		!clock->continuation.configured && !clock->continuation.started;
+}
+
+bool kvm_arch_crucible_q35_ps_native_cut_locked(struct kvm *kvm,
+	u64 *closed_workers, u64 *pending_mask)
+{
+	struct kvm_crucible_pic_board *board = &kvm->arch.crucible_pic_board;
+	u32 index, as_id;
+
+	lockdep_assert_held(&kvm->lock);
+	lockdep_assert_held(&kvm->slots_lock);
+	lockdep_assert_held(&kvm->irq_lock);
+	lockdep_assert_held(&kvm->crucible_gate_lock);
+	*closed_workers = 0;
+	*pending_mask = 0;
+	if (board->edition != KVM_CRUCIBLE_Q35_BOARD_ONLY || board->phase != 2 ||
+	    board->constructor != current || board->pic != kvm->arch.vpic ||
+	    board->pit != kvm->arch.vpit || board->ioapic != kvm->arch.vioapic ||
+	    board->routing != rcu_dereference_protected(kvm->irq_routing, 1) ||
+	    !board->initializer_roster.selected || board->initializer_roster.uncertain ||
+	    kvm->created_vcpus != 4 || kvm->crucible_topology_writers ||
+	    kvm->crucible_memory_tainted || kvm->crucible_memory_notifier_owners ||
+	    kvm->crucible_irq_input.tainted || READ_ONCE(kvm->vm_dead) ||
+	    !board->q35_memory.sealed || board->q35_memory.inflight ||
+	    board->q35_memory.uncertain || !board->q35_memory.native_slots ||
+	    !board->q35_route.effect.known || board->q35_route.inflight ||
+	    board->q35_route.uncertain ||
+	    board->q35_route.effect.published != board->routing ||
+	    !board->q35_configuration.selected || board->q35_configuration.inflight ||
+	    board->q35_configuration.uncertain || !board->q35_filter.selected ||
+	    board->q35_filter.inflight || board->q35_filter.uncertain ||
+	    !board->q35_device.selected || board->q35_device.inflight ||
+	    board->q35_device.uncertain)
+		return false;
+	for (as_id = 0; as_id < 2; as_id++)
+		if (board->q35_memory.tables[as_id] != __kvm_memslots(kvm, as_id))
+			return false;
+	for (index = 0; index < board->q35_configuration.issued; index++)
+		if (!board->q35_configuration.effects[index].known)
+			return false;
+	for (index = 0; index < board->q35_filter.issued; index++)
+		if (!board->q35_filter.effects[index].known)
+			return false;
+	for (index = 0; index < board->q35_device.issued; index++)
+		if (!board->q35_device.effects[index].known)
+			return false;
+	for (index = 0; index < 4; index++) {
+		struct kvm_crucible_pic_initializer_state *actor =
+			&board->initializer_roster.actors[index];
+		struct kvm_crucible_q35_counter_row *counter = &board->counter_rows[index];
+		struct kvm_vcpu *vcpu = kvm_get_vcpu(kvm, index);
+		u32 effect, pending;
+
+		if (!vcpu || vcpu->vcpu_id != index || actor->vcpu != vcpu ||
+		    actor->native_vcpu_id != index ||
+		    !actor->task || actor->task != counter->task || counter->vcpu != vcpu ||
+		    actor->inflight || actor->uncertain || !actor->issued ||
+		    actor->issued > actor->maximum_effects || !counter->applied ||
+		    counter->inflight || counter->uncertain || !counter->known ||
+		    counter->native_result || counter->output.observed_coverage != 3 ||
+		    counter->output.flags != 7 || !vcpu->crucible_response_bytes)
+			return false;
+		lockdep_assert_held(&vcpu->mutex);
+		for (effect = 0; effect < actor->issued; effect++)
+			if (!actor->effects[effect].known)
+				return false;
+		pending = kvm_arch_crucible_run_pending(vcpu);
+		if (vcpu->crucible_response.flags)
+			pending |= KVM_CRUCIBLE_RUN_PENDING_OPAQUE;
+		if (kvm_crucible_response_pending(&vcpu->crucible_response))
+			pending |= KVM_CRUCIBLE_RUN_PENDING_CALLBACK;
+		*pending_mask |= (u64)pending << (index * 8);
+		if (!pending && !vcpu->crucible_timer_run_owner &&
+		    READ_ONCE(vcpu->mode) == OUTSIDE_GUEST_MODE &&
+		    !vcpu->crucible_run_return.outstanding)
+			*closed_workers |= BIT_ULL(index);
+	}
+	return true;
+}
+
+bool kvm_arch_crucible_q35_ps_execution_ready_locked(struct kvm *kvm)
+{
+	/* The currently supplied constructor families do not install this active
+	 * IRQ/clock issuer. Keep admission closed until a source-owned whole-board
+	 * installation actually establishes all these native fields. */
+	return kvm->arch.crucible_clock.ps.selected &&
+		kvm->arch.crucible_clock.enabled && kvm->crucible_controlled &&
+		kvm->crucible_continuation_roster_frozen && kvm->crucible_irq_input.enabled &&
+		!kvm->crucible_irq_input.inflight && !kvm->crucible_irq_input.tainted &&
+		kvm->crucible_response_enabled && kvm->crucible_run_return_enabled &&
+		kvm->crucible_response_bytes_enabled;
+}
--- /dev/null
+++ b/arch/x86/kvm/crucible-q35-vm-configuration.inc.c
@@ -0,0 +1,372 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Copied original VM initialization effects. Observing default MMU mode does
+ * not pretend that an explicit MMU setter ran; no clock/RUN is issued here. */
+
+static bool q35_vm_capability_valid(const struct kvm_crucible_q35_vm_configuration *request)
+{
+	if (request->arguments[1] || request->arguments[2] || request->arguments[3])
+		return false;
+	switch (request->capability) {
+	case KVM_CAP_EXCEPTION_PAYLOAD:
+	case KVM_CAP_X86_TRIPLE_FAULT_EVENT:
+		return request->arguments[0] == 1;
+	case KVM_CAP_X86_USER_SPACE_MSR:
+		return request->arguments[0] &&
+			!(request->arguments[0] & ~KVM_MSR_EXIT_REASON_VALID_MASK);
+	case KVM_CAP_DISABLE_QUIRKS2:
+		return request->arguments[0] &&
+			!(request->arguments[0] & ~kvm_caps.supported_quirks);
+	case KVM_CAP_MAX_VCPU_ID:
+		return request->arguments[0] >= KVM_CRUCIBLE_PIC_INITIALIZER_V2_CPUS &&
+			request->arguments[0] <= KVM_MAX_VCPU_IDS;
+	case KVM_CAP_X2APIC_API:
+		return request->arguments[0] ==
+			(KVM_X2APIC_API_USE_32BIT_IDS | KVM_X2APIC_API_DISABLE_BROADCAST_QUIRK);
+	case KVM_CAP_PMU_CAPABILITY:
+		return request->arguments[0] == KVM_PMU_CAP_DISABLE;
+	case KVM_CAP_MANUAL_DIRTY_LOG_PROTECT2:
+		return request->arguments[0] &&
+			!(request->arguments[0] & ~KVM_DIRTY_LOG_MANUAL_CAPS) &&
+			(request->arguments[0] & KVM_DIRTY_LOG_MANUAL_PROTECT_ENABLE);
+	default:
+		return false;
+	}
+}
+
+static bool q35_vm_request_valid(const struct kvm_crucible_q35_vm_configuration *request)
+{
+	u32 index;
+
+	if (request->version != 2 || !request->enrollment_id ||
+	    !request->maximum_effects ||
+	    request->maximum_effects > KVM_CRUCIBLE_Q35_VM_MAX_EFFECTS ||
+	    request->issued_effects || request->flags || request->native_result)
+		return false;
+	for (index = 0; index < ARRAY_SIZE(request->native_state); index++)
+		if (request->native_state[index])
+			return false;
+	for (index = 0; index < ARRAY_SIZE(request->reserved); index++)
+		if (request->reserved[index])
+			return false;
+	if (request->operation == KVM_CRUCIBLE_Q35_VM_SELECT ||
+	    request->operation == KVM_CRUCIBLE_Q35_VM_QUERY) {
+		if (request->effect || request->capability || request->value ||
+		    (request->operation == KVM_CRUCIBLE_Q35_VM_SELECT && request->effect_index))
+			return false;
+		for (index = 0; index < ARRAY_SIZE(request->arguments); index++)
+			if (request->arguments[index])
+				return false;
+		return true;
+	}
+	if (request->operation != KVM_CRUCIBLE_Q35_VM_APPLY || !request->effect_index)
+		return false;
+	if (request->effect == KVM_CRUCIBLE_Q35_VM_ENABLE_CAP)
+		return !request->value && q35_vm_capability_valid(request);
+	if (request->capability)
+		return false;
+	for (index = 0; index < ARRAY_SIZE(request->arguments); index++)
+		if (request->arguments[index])
+			return false;
+	switch (request->effect) {
+	case KVM_CRUCIBLE_Q35_VM_IDENTITY:
+	case KVM_CRUCIBLE_Q35_VM_TSS:
+		return request->value && !(request->value & (PAGE_SIZE - 1)) &&
+			request->value <= (u32)(-3 * PAGE_SIZE);
+	case KVM_CRUCIBLE_Q35_VM_MMU_PAGES:
+		return request->value >= KVM_MIN_ALLOC_MMU_PAGES && request->value <= 65536;
+	case KVM_CRUCIBLE_Q35_VM_DEFAULT_MMU:
+		return !request->value;
+	default:
+		return false;
+	}
+}
+
+static bool q35_vm_same(const struct kvm_crucible_q35_vm_configuration_state *state,
+	const struct kvm_crucible_q35_vm_configuration *request)
+{
+	return state->selected && state->enrollment_id == request->enrollment_id &&
+		state->maximum_effects == request->maximum_effects;
+}
+
+static bool q35_vm_actor(struct kvm *kvm)
+{
+	struct kvm_crucible_pic_board *board = &kvm->arch.crucible_pic_board;
+	u32 index;
+
+	if (board->constructor == current)
+		return true;
+	for (index = 0; index < KVM_CRUCIBLE_PIC_INITIALIZER_V2_CPUS; index++) {
+		struct kvm_crucible_pic_initializer_state *actor = &board->initializer_roster.actors[index];
+
+		if (actor->task == current && !actor->inflight && !actor->uncertain &&
+		    actor->native_vcpu_id == index)
+			return true;
+	}
+	return false;
+}
+
+static bool q35_vm_live_locked_routing(struct kvm *kvm,
+	const struct kvm_irq_routing_table *expected_routing)
+{
+	struct kvm_crucible_pic_board *board = &kvm->arch.crucible_pic_board;
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	u32 index;
+
+	lockdep_assert_held(&clock->control_lock);
+	lockdep_assert_held(&kvm->crucible_configuration_lock);
+	lockdep_assert_held(&kvm->lock);
+	lockdep_assert_held(&kvm->irq_lock);
+	lockdep_assert_held(&kvm->crucible_gate_lock);
+	if (board->edition != KVM_CRUCIBLE_Q35_BOARD_ONLY || board->phase != 2 ||
+	    !q35_vm_actor(kvm) || board->pic != kvm->arch.vpic ||
+	    board->pit != kvm->arch.vpit || board->ioapic != kvm->arch.vioapic ||
+	    expected_routing != rcu_dereference_protected(kvm->irq_routing, 1) ||
+	    !board->initializer_roster.selected || board->initializer_roster.uncertain ||
+	    kvm->created_vcpus > KVM_CRUCIBLE_PIC_INITIALIZER_V2_CPUS ||
+	    board->q35_memory.inflight || board->q35_memory.uncertain ||
+	    clock->enabled || clock->active || clock->run_owners || clock->timer_owners ||
+	    kvm->crucible_controlled || kvm->crucible_continuation_roster_frozen ||
+	    kvm->crucible_irq_input.owners || kvm->crucible_irq_input.tainted ||
+	    kvm->crucible_memory_tainted || READ_ONCE(kvm->vm_dead))
+		return false;
+	for (index = 0; index < KVM_CRUCIBLE_PIC_INITIALIZER_V2_CPUS; index++)
+		if (board->initializer_roster.actors[index].inflight ||
+		    board->initializer_roster.actors[index].uncertain)
+			return false;
+	return true;
+}
+
+
+static bool q35_vm_live_locked(struct kvm *kvm)
+{
+	return q35_vm_live_locked_routing(kvm, kvm->arch.crucible_pic_board.routing);
+}
+
+static void q35_vm_snapshot(struct kvm *kvm, struct kvm_crucible_q35_vm_effect *effect)
+{
+	u64 *state = effect->native_state;
+	u32 capability = effect->original.capability;
+
+	if (effect->original.effect == KVM_CRUCIBLE_Q35_VM_DEFAULT_MMU ||
+	    effect->original.effect == KVM_CRUCIBLE_Q35_VM_MMU_PAGES) {
+		state[0] = kvm->arch.n_requested_mmu_pages;
+		state[1] = kvm->arch.n_max_mmu_pages;
+		return;
+	}
+	switch (capability) {
+	case KVM_CAP_EXCEPTION_PAYLOAD:
+		state[0] = kvm->arch.exception_payload_enabled;
+		break;
+	case KVM_CAP_X86_TRIPLE_FAULT_EVENT:
+		state[0] = kvm->arch.triple_fault_event;
+		break;
+	case KVM_CAP_X86_USER_SPACE_MSR:
+		state[0] = kvm->arch.user_space_msr_mask;
+		break;
+	case KVM_CAP_DISABLE_QUIRKS2:
+		state[0] = kvm->arch.disabled_quirks;
+		break;
+	case KVM_CAP_MAX_VCPU_ID:
+		state[0] = kvm->arch.max_vcpu_ids;
+		break;
+	case KVM_CAP_X2APIC_API:
+		state[0] = kvm->arch.x2apic_format;
+		state[1] = kvm->arch.x2apic_broadcast_quirk_disabled;
+		state[2] = kvm->arch.suppress_eoi_broadcast_mode;
+		break;
+	case KVM_CAP_PMU_CAPABILITY:
+		state[0] = kvm->arch.enable_pmu;
+		break;
+	case KVM_CAP_MANUAL_DIRTY_LOG_PROTECT2:
+		state[0] = kvm->manual_dirty_log_protect;
+		break;
+	default:
+		/* Identity/TSS callbacks are vendor-specific, including AMD's real
+		 * no-op implementations. Their exact native return is the receipt;
+		 * an echoed request address is not claimed as native MMU state. */
+		break;
+	}
+}
+
+static bool q35_vm_native_matches(const struct kvm_crucible_q35_vm_effect *effect)
+{
+	const struct kvm_crucible_q35_vm_configuration *original = &effect->original;
+	const u64 *state = effect->native_state;
+
+	if (original->effect == KVM_CRUCIBLE_Q35_VM_DEFAULT_MMU)
+		return !state[0];
+	if (original->effect == KVM_CRUCIBLE_Q35_VM_MMU_PAGES)
+		return state[0] == original->value;
+	if (original->effect != KVM_CRUCIBLE_Q35_VM_ENABLE_CAP)
+		return true;
+	switch (original->capability) {
+	case KVM_CAP_DISABLE_QUIRKS2:
+		return (state[0] & original->arguments[0]) == original->arguments[0];
+	case KVM_CAP_X2APIC_API:
+		return state[0] && state[1];
+	case KVM_CAP_PMU_CAPABILITY:
+		return !state[0];
+	default:
+		return state[0] == original->arguments[0];
+	}
+}
+
+static void q35_vm_report(const struct kvm_crucible_q35_vm_configuration_state *state,
+	struct kvm_crucible_q35_vm_configuration *request)
+{
+	const struct kvm_crucible_q35_vm_effect *effect;
+	u32 operation = request->operation;
+
+	if (request->effect_index) {
+		effect = &state->effects[request->effect_index - 1];
+		*request = effect->original;
+		request->operation = operation;
+		request->native_result = effect->native_result;
+		memcpy(request->native_state, effect->native_state, sizeof(request->native_state));
+		request->flags = effect->known ? KVM_CRUCIBLE_Q35_VM_KNOWN : 0;
+	}
+	request->issued_effects = state->issued;
+	request->flags |= (state->selected ? KVM_CRUCIBLE_Q35_VM_SELECTED : 0) |
+		(state->inflight ? KVM_CRUCIBLE_Q35_VM_INFLIGHT : 0) |
+		(state->uncertain ? KVM_CRUCIBLE_Q35_VM_UNCERTAIN : 0);
+}
+
+static int kvm_crucible_q35_vm_configuration_control(struct kvm *kvm,
+	struct kvm_enable_cap *cap)
+{
+	struct kvm_crucible_pic_board *board = &kvm->arch.crucible_pic_board;
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	struct kvm_crucible_q35_vm_configuration_state *state = &board->q35_configuration;
+	struct kvm_crucible_q35_vm_configuration request;
+	struct kvm_crucible_q35_vm_effect *effect = NULL;
+	void __user *argument = u64_to_user_ptr(cap->args[0]);
+	unsigned long flags;
+	bool entered = false, contain = false;
+	int result = -EPERM, native_result;
+
+	BUILD_BUG_ON(sizeof(request) != 144);
+	if (cap->flags || !cap->args[0] || cap->args[1] || cap->args[2] || cap->args[3])
+		return -EINVAL;
+	if (copy_from_user(&request, argument, sizeof(request)))
+		return -EFAULT;
+	if (!q35_vm_request_valid(&request))
+		return -EINVAL;
+	if (!mutex_trylock(&clock->control_lock))
+		return -EBUSY;
+	if (!mutex_trylock(&kvm->crucible_configuration_lock)) {
+		mutex_unlock(&clock->control_lock);
+		return -EBUSY;
+	}
+	if (!q35_vm_actor(kvm))
+		goto unlock_configuration;
+	if (request.operation == KVM_CRUCIBLE_Q35_VM_QUERY) {
+		result = -ENOENT;
+		if (q35_vm_same(state, &request) && request.effect_index <= state->issued &&
+		    (!request.effect_index || state->effects[request.effect_index - 1].actor == current)) {
+			q35_vm_report(state, &request);
+			result = 0;
+		}
+		goto unlock_configuration;
+	}
+	if (!mutex_trylock(&kvm->lock)) {
+		result = -EBUSY;
+		goto unlock_configuration;
+	}
+	mutex_lock(&kvm->irq_lock);
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	result = -EOPNOTSUPP;
+	if (!q35_vm_live_locked(kvm) || state->inflight || state->uncertain ||
+	    kvm->crucible_topology_writers)
+		goto unlock_admission;
+	if (request.operation == KVM_CRUCIBLE_Q35_VM_SELECT) {
+		if (state->selected || board->constructor != current || kvm->created_vcpus ||
+		    request.enrollment_id != board->initializer_roster.enrollment_id)
+			goto unlock_admission;
+		state->enrollment_id = request.enrollment_id;
+		state->maximum_effects = request.maximum_effects;
+		state->selected = true;
+		q35_vm_report(state, &request);
+		result = 0;
+		goto unlock_admission;
+	}
+	if (!q35_vm_same(state, &request) ||
+	    state->enrollment_id != board->initializer_roster.enrollment_id ||
+	    state->issued >= state->maximum_effects || request.effect_index != state->issued + 1)
+		goto unlock_admission;
+	effect = &state->effects[state->issued++];
+	effect->original = request;
+	effect->actor = current;
+	effect->native_cap.cap = request.capability;
+	memcpy(effect->native_cap.args, request.arguments, sizeof(effect->native_cap.args));
+	effect->native_result = -EINPROGRESS;
+	effect->inflight = true;
+	state->inflight = true;
+	kvm->crucible_topology_writers++;
+	entered = true;
+unlock_admission:
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	mutex_unlock(&kvm->irq_lock);
+	mutex_unlock(&kvm->lock);
+unlock_configuration:
+	mutex_unlock(&kvm->crucible_configuration_lock);
+	if (!entered)
+		goto unlock_control;
+
+	/* Only this exact retained projection reaches original native callbacks.
+	 * Configuration/VM/IRQ locks never cross slots/MMU or native cap locks. */
+	switch (effect->original.effect) {
+	case KVM_CRUCIBLE_Q35_VM_IDENTITY:
+		mutex_lock(&kvm->lock);
+		native_result = kvm_vm_ioctl_set_identity_map_addr(kvm, effect->original.value);
+		mutex_unlock(&kvm->lock);
+		break;
+	case KVM_CRUCIBLE_Q35_VM_TSS:
+		native_result = kvm_vm_ioctl_set_tss_addr(kvm, effect->original.value);
+		break;
+	case KVM_CRUCIBLE_Q35_VM_MMU_PAGES:
+		native_result = kvm_vm_ioctl_set_nr_mmu_pages(kvm, effect->original.value);
+		break;
+	case KVM_CRUCIBLE_Q35_VM_DEFAULT_MMU:
+		/* Observation only: preserve the default auto-sizing behavior. */
+		native_result = 0;
+		break;
+	default:
+		native_result = kvm_crucible_q35_vm_native_enable_cap(kvm, &effect->native_cap);
+		break;
+	}
+	mutex_lock(&kvm->slots_lock);
+	q35_vm_snapshot(kvm, effect);
+	mutex_unlock(&kvm->slots_lock);
+
+	mutex_lock(&kvm->crucible_configuration_lock);
+	mutex_lock(&kvm->lock);
+	mutex_lock(&kvm->irq_lock);
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	effect->native_result = native_result;
+	effect->known = !native_result && q35_vm_live_locked(kvm) &&
+		q35_vm_native_matches(effect) && kvm->crucible_topology_writers == 1;
+	effect->uncertain = !effect->known;
+	effect->inflight = false;
+	state->inflight = false;
+	if (effect->uncertain) {
+		state->uncertain = true;
+		kvm->crucible_memory_tainted = true;
+		contain = true;
+	}
+	/* Publish immutable result/Unknown before releasing credit or containment. */
+	kvm->crucible_topology_writers--;
+	q35_vm_report(state, &request);
+	result = effect->known ? 0 : -EAGAIN;
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	mutex_unlock(&kvm->irq_lock);
+	mutex_unlock(&kvm->lock);
+	mutex_unlock(&kvm->crucible_configuration_lock);
+unlock_control:
+	mutex_unlock(&clock->control_lock);
+	if (contain)
+		kvm_vm_dead(kvm);
+	if (!result || entered)
+		if (copy_to_user(argument, &request, sizeof(request)))
+			return -EFAULT;
+	return result;
+}
