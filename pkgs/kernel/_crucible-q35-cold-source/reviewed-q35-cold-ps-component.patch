+	effect->original = request;
+	effect->actor = current;
+	effect->native_result = -EINPROGRESS;
+	effect->inflight = true;
+	state->inflight = true;
+	kvm->crucible_topology_writers++;
+	entered = true;
+unlock_admission:
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	mutex_unlock(&kvm->irq_lock);
+	mutex_unlock(&kvm->lock);
+unlock_configuration:
+	mutex_unlock(&kvm->crucible_configuration_lock);
+	if (!entered)
+		goto unlock_control;
