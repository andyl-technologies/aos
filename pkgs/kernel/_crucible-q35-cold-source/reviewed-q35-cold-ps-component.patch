+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Included by the original PIT implementation. An initializer owns the same
+ * native PIT mutex/callback and retains the real periodic state while parked. */
+
+static void pit_do_work(struct kthread_work *work);
+
+static bool pit_q35_bootstrap_owned(struct kvm_pit *pit)
+{
+	unsigned long flags;
+	bool owned;
+
+	raw_spin_lock_irqsave(&pit->kvm->crucible_gate_lock, flags);
+	owned = kvm_arch_crucible_q35_device_pit_owned_locked(pit->kvm);
+	raw_spin_unlock_irqrestore(&pit->kvm->crucible_gate_lock, flags);
+	return owned;
+}
+
+static bool pit_q35_bootstrap_cancel(struct kvm_pit *pit)
+{
+	struct kvm_crucible_pit_journal *journal = &pit->pit_state.crucible;
+	unsigned long flags;
+	bool valid;
+
+	/* No work is flushed or discarded: the original initialization cut
+	 * requires actual callback/worker ownership to be absent. */
+	raw_spin_lock_irqsave(&pit->kvm->crucible_gate_lock, flags);
+	valid = kvm_arch_crucible_q35_device_pit_owned_locked(pit->kvm) &&
+		!journal->valid && !journal->queued && !journal->count &&
+		!journal->callback_active && !journal->worker_active &&
+		!journal->work_scheduled && !journal->access_active;
+	raw_spin_unlock_irqrestore(&pit->kvm->crucible_gate_lock, flags);
+	/* An unexpected physical arm is not this initializer's work. Refuse
+	 * before cancellation, preserving the timer and its original seed. */
+	if (!valid || hrtimer_active(&pit->pit_state.timer) ||
+	    hrtimer_callback_running(&pit->pit_state.timer) ||
+	    hrtimer_try_to_cancel(&pit->pit_state.timer) < 0) {
+		kvm_arch_crucible_q35_device_initializer_fault(pit->kvm);
+		return false;
+	}
+	raw_spin_lock_irqsave(&pit->kvm->crucible_gate_lock, flags);
+	valid = kvm_arch_crucible_q35_device_pit_owned_locked(pit->kvm) &&
+		!journal->callback_active && !journal->worker_active && !journal->work_scheduled;
+	if (valid)
+		journal->bootstrap_pending = false;
+	raw_spin_unlock_irqrestore(&pit->kvm->crucible_gate_lock, flags);
+	if (!valid)
+		kvm_arch_crucible_q35_device_initializer_fault(pit->kvm);
+	return valid;
+}
+
+static void pit_q35_bootstrap_program(struct kvm_pit *pit, u32 count, bool periodic)
+{
+	struct kvm_kpit_state *state = &pit->pit_state;
+	struct kvm_crucible_pit_journal *journal = &state->crucible;
+	struct kvm_crucible_q35_device_effect *effect;
+	u64 interval = mul_u64_u32_div(count, NSEC_PER_SEC, KVM_PIT_FREQ);
+	u64 logical;
+	unsigned long flags;
+	bool valid;
+
+	if (!interval || kvm_crucible_q35_bootstrap_clock_read(pit->kvm, &logical) ||
+	    logical > KTIME_MAX) {
+		kvm_arch_crucible_q35_device_initializer_fault(pit->kvm);
+		return;
+	}
+	if (periodic && interval < min_timer_period_us * 1000ULL)
+		interval = min_timer_period_us * 1000ULL;
+	/* Validate the actual chosen interval before changing the prior seed. */
+	if (interval > KTIME_MAX - logical) {
+		kvm_arch_crucible_q35_device_initializer_fault(pit->kvm);
+		return;
+	}
+	if (!pit_q35_bootstrap_cancel(pit))
+		return;
+	raw_spin_lock_irqsave(&pit->kvm->crucible_gate_lock, flags);
+	effect = kvm_arch_crucible_q35_device_pit_seed_locked(pit->kvm);
+	valid = effect && !journal->callback_active && !journal->worker_active &&
+		!journal->work_scheduled && !journal->bootstrap_pending;
+	if (valid) {
+		journal->bootstrap_effect = effect;
+		journal->bootstrap_logical = ns_to_ktime(logical + interval);
+		journal->bootstrap_periodic = periodic;
+		journal->bootstrap_pending = true;
+		state->period = interval;
+		state->is_periodic = periodic;
+		state->channels[0].count_load_time = ns_to_ktime(logical);
+	}
+	raw_spin_unlock_irqrestore(&pit->kvm->crucible_gate_lock, flags);
+	if (!valid)
+		kvm_arch_crucible_q35_device_initializer_fault(pit->kvm);
+	/* The real periodic state and original effect remain pending. An actual
+	 * whole-board activation must adopt this seed before any RUN or expiry;
+	 * there is deliberately no host hrtimer publication during construction. */
+}
+
+bool kvm_arch_crucible_q35_pit_bootstrap_quiescent_locked(struct kvm *kvm)
+{
+	struct kvm_pit *pit = kvm->arch.vpit;
+	bool valid;
+
+	lockdep_assert_held(&kvm->crucible_gate_lock);
+	if (!pit || !pit->worker || hrtimer_active(&pit->pit_state.timer) ||
+	    hrtimer_callback_running(&pit->pit_state.timer) ||
+	    pit->expired.func != pit_do_work || !raw_spin_trylock(&pit->worker->lock))
+		return false;
+	/* The same source writer excludes field mutation. The actual worker
+	 * lock proves that neither queued work nor a dispatched callback remains. */
+	valid = !pit->worker->current_work && list_empty(&pit->worker->work_list) &&
+		list_empty(&pit->expired.node);
+	raw_spin_unlock(&pit->worker->lock);
+	return valid;
+}
+EXPORT_SYMBOL_FOR_KVM_INTERNAL(kvm_arch_crucible_q35_pit_bootstrap_quiescent_locked);
+
+bool kvm_arch_crucible_q35_device_pit_result_known_locked(struct kvm *kvm,
+	const struct kvm_crucible_q35_device_effect *effect)
+{
+	struct kvm_pit *pit = kvm->arch.vpit;
+	const struct kvm_pit_state2 *input = effect->input;
+	struct kvm_kpit_state *state;
+	struct kvm_crucible_pit_journal *journal;
+	u64 interval;
+
+	lockdep_assert_held(&kvm->crucible_gate_lock);
+	if (!pit || kvm_arch_crucible_q35_device_pit_seed_locked(kvm) != effect ||
+	    !input || !kvm_arch_crucible_q35_pit_bootstrap_quiescent_locked(kvm))
+		return false;
+	state = &pit->pit_state;
+	journal = &state->crucible;
+	if (journal->valid || journal->queued || journal->count ||
+	    journal->callback_active || journal->worker_active || journal->work_scheduled ||
+	    memcmp(state->channels, input->channels, sizeof(state->channels)) ||
+	    state->flags != input->flags)
+		return false;
+	if (input->channels[0].mode == 255 || input->flags & KVM_PIT_FLAGS_HPET_LEGACY)
+		return !journal->bootstrap_pending;
+	interval = mul_u64_u32_div(input->channels[0].count, NSEC_PER_SEC, KVM_PIT_FREQ);
+	if (interval < min_timer_period_us * 1000ULL)
+		interval = min_timer_period_us * 1000ULL;
+	return journal->bootstrap_pending && journal->bootstrap_periodic &&
+		journal->bootstrap_effect == effect && state->period == interval &&
+		state->is_periodic && ktime_to_ns(journal->bootstrap_logical) == interval;
+}
+EXPORT_SYMBOL_FOR_KVM_INTERNAL(kvm_arch_crucible_q35_device_pit_result_known_locked);
