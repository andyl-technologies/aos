+
+static void kvm_crucible_q35_initial_routing_destroy(struct kvm *kvm)
+{
+	struct kvm_crucible_q35_route_state *state = &kvm->arch.crucible_pic_board.q35_route;
+
+	/* Generic destruction has released the current owner after native vCPU/IRQ
+	 * callbacks end. Retained original and replacement providers follow here. */
+	kvm_put_irq_routing_table(state->effect.published);
+	kvm_put_irq_routing_table(state->original_routing);
