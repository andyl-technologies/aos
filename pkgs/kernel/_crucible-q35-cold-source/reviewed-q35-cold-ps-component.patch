+	const struct kvm_irq_routing_entry *entries, unsigned int nr,
+	struct kvm_irq_routing_table **published)
+{
+	return false;
+}
+
+static int kvm_crucible_q35_initial_routing_control(struct kvm *kvm, struct kvm_enable_cap *cap)
+{
+	return -EOPNOTSUPP;
+}
+
+static void kvm_crucible_q35_initial_routing_destroy(struct kvm *kvm)
+{
+}
+
