+		    (!request.effect_index || effect->actor == current)) {
+			q35_route_report(state, &request);
+			result = 0;
+		}
+		goto unlock_configuration;
+	}
+	if (!mutex_trylock(&kvm->lock)) {
+		result = -EBUSY;
+		goto unlock_configuration;
+	}
