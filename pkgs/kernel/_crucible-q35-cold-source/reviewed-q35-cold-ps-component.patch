+		request.logical_ns = clock->frozen_ns;
+		request.clock_version = clock->version;
+		request.run_owners = clock->run_owners;
+		request.timer_owners = clock->timer_owners;
+		request.effect_owners = kvm->crucible_effect_owners;
+		request.irq_owners = kvm->crucible_irq_input.owners;
+		request.topology_writers = kvm->crucible_topology_writers;
+		request.flags = KVM_CRUCIBLE_Q35_CLOCK_KNOWN | KVM_CRUCIBLE_Q35_CLOCK_BOOTSTRAP;
+		result = 0;
+	}
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+	mutex_unlock(&kvm->irq_lock);
+	mutex_unlock(&kvm->lock);
+unlock_configuration:
+	mutex_unlock(&kvm->crucible_configuration_lock);
+	mutex_unlock(&clock->control_lock);
+	if (!result && copy_to_user(argument, &request, sizeof(request)))
+		return -EFAULT;
+	return result;
