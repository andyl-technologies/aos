+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef KVM_CRUCIBLE_COMPLETION_H
+#define KVM_CRUCIBLE_COMPLETION_H
+
+#include <linux/errno.h>
+#include <linux/kvm.h>
+#include <linux/limits.h>
+#include <linux/types.h>
+
+/* Owned by the original vCPU mutex; its last result survives failed delivery.
+ * This bounded journal is not an export of hidden architecture emulation state.
+ */
+struct kvm_crucible_response_state {
+	u64 sequence;
+	u64 consumed_sequence;
+	u64 revision;
+	u32 phase;
+	u32 flags;
+	struct kvm_crucible_completion last_result;
+};
+
+static inline bool kvm_crucible_response_pending(
+	const struct kvm_crucible_response_state *state)
+{
+	return state->phase == KVM_CRUCIBLE_COMPLETION_PENDING ||
+		state->phase == KVM_CRUCIBLE_COMPLETION_MORE;
+}
+
+/* Returns 1 for an exact retained original result, 0 for a new one-step request.
+ * Reservation and finite counter checks precede any native callback.
+ */
+static inline int kvm_crucible_response_admit(
+	const struct kvm_crucible_response_state *state,
+	const struct kvm_crucible_completion *request)
+{
+	unsigned int index;
+
+	if (request->version != 1 || request->pending_sequence ||
+	    request->consumed_sequence || request->revision ||
+	    request->callback_result || request->phase || request->native_vcpu_id ||
+	    request->flags)
+		return -EINVAL;
+	for (index = 0; index < 4; index++)
+		if (request->reserved[index])
+			return -EINVAL;
+	if (request->operation == KVM_CRUCIBLE_COMPLETION_QUERY)
+		return request->operation_id || request->expected_sequence ? -EINVAL : 0;
+	if (request->operation != KVM_CRUCIBLE_COMPLETION_STEP || !request->operation_id)
+		return -EINVAL;
+	if (request->operation_id == state->last_result.operation_id)
+		return request->expected_sequence == state->last_result.expected_sequence ?
+			1 : -ESTALE;
+	if (state->last_result.operation_id == U64_MAX || state->revision >= U64_MAX - 1 ||
+	    state->sequence == U64_MAX)
+		return -EOVERFLOW;
+	if (request->operation_id != state->last_result.operation_id + 1 ||
+	    request->expected_sequence != state->sequence)
+		return -ESTALE;
+	if (!kvm_crucible_response_pending(state) || state->flags)
+		return -EIO;
+	return 0;
+}
+
+static inline bool kvm_crucible_response_birth(struct kvm_crucible_response_state *state)
+{
+	if (kvm_crucible_response_pending(state) || state->flags ||
+	    state->revision == U64_MAX || state->sequence == U64_MAX)
+		return false;
+	state->sequence++;
+	state->revision++;
+	state->phase = KVM_CRUCIBLE_COMPLETION_PENDING;
+	return true;
+}
+
+static inline void kvm_crucible_response_fill(
+	const struct kvm_crucible_response_state *state,
+	struct kvm_crucible_completion *result, u32 native_id)
+{
+	result->pending_sequence = state->sequence;
+	result->consumed_sequence = state->consumed_sequence;
+	result->revision = state->revision;
+	result->phase = state->phase;
+	result->native_vcpu_id = native_id;
+	result->flags = state->flags;
+}
+
+/* Called only after admission reserved both possible native counter changes.
+ * An error never fabricates response consumption and permanently taints custody.
+ */
+static inline void kvm_crucible_response_finish(
+	struct kvm_crucible_response_state *state,
+	const struct kvm_crucible_completion *request, int callback_result,
+	bool more, u32 native_id)
+{
+	state->revision++;
+	if (callback_result < 0) {
+		state->phase = KVM_CRUCIBLE_COMPLETION_UNKNOWN;
+		state->flags |= KVM_CRUCIBLE_COMPLETION_UNCERTAIN;
+	} else {
+		state->consumed_sequence = state->sequence;
+		if (more) {
+			state->sequence++;
+			state->revision++;
+			state->phase = KVM_CRUCIBLE_COMPLETION_MORE;
+		} else {
+			state->phase = KVM_CRUCIBLE_COMPLETION_DONE;
+		}
+	}
+	state->last_result = *request;
+	state->last_result.callback_result = callback_result;
+	kvm_crucible_response_fill(state, &state->last_result, native_id);
+}
