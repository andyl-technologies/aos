+// SPDX-License-Identifier: GPL-2.0-only
+/* One original response step, without another KVM_RUN or guest-entry path.
+ * This private component does not export hidden emulation state or qualify a node.
+ */
+#include <linux/kvm_host.h>
+#include <linux/uaccess.h>
+
+int kvm_crucible_response_configure(struct kvm *kvm, const struct kvm_enable_cap *cap)
+{
+	int result = 0;
+
+	if ((!IS_ENABLED(CONFIG_X86) && !IS_ENABLED(CONFIG_ARM64)) || cap->flags ||
+	    cap->args[0] || cap->args[1] || cap->args[2] || cap->args[3])
+		return -EINVAL;
+	mutex_lock(&kvm->crucible_configuration_lock);
+	if (!kvm->crucible_controlled || kvm->crucible_active || kvm->created_vcpus ||
+	    kvm->crucible_effect_owners || kvm->crucible_response_enabled)
+		result = -EBUSY;
+	else
+		WRITE_ONCE(kvm->crucible_response_enabled, true);
+	mutex_unlock(&kvm->crucible_configuration_lock);
+	return result;
+}
+
+int kvm_crucible_response_run_admit(struct kvm_vcpu *vcpu)
+{
+	struct kvm_crucible_response_state *state = &vcpu->crucible_response;
+
+	lockdep_assert_held(&vcpu->mutex);
+	if (!READ_ONCE(vcpu->kvm->crucible_response_enabled))
+		return 0;
+	if (state->flags || kvm_crucible_response_pending(state))
+		return -EBUSY;
+	/* The next native exit needs its own original-sequence credit. */
+	if (state->sequence == U64_MAX || state->revision == U64_MAX)
+		return -EOVERFLOW;
+	return 0;
+}
+
+static bool response_geometry(struct kvm_vcpu *vcpu, bool retain)
+{
+	struct kvm_run *run = vcpu->run;
+	u64 address = 0, data_offset = 0;
+	u32 reason = run->exit_reason, length = 0, count = 0, size = 0, direction = 0;
+
+	if (reason == KVM_EXIT_MMIO) {
+		address = run->mmio.phys_addr;
+		length = run->mmio.len;
+		direction = run->mmio.is_write;
+		if (!length || length > sizeof(run->mmio.data) || direction > 1)
+			return false;
+	} else if (reason == KVM_EXIT_IO) {
+		address = run->io.port;
+		data_offset = run->io.data_offset;
+		count = run->io.count;
+		size = run->io.size;
+		direction = run->io.direction;
+		if (!count || (size != 1 && size != 2 && size != 4) ||
+		    count > PAGE_SIZE / size || direction > KVM_EXIT_IO_OUT)
+			return false;
+	} else {
+		return false;
+	}
+	if (!retain)
+		return vcpu->crucible_response_original.reason == reason &&
+			vcpu->crucible_response_original.address == address &&
+			vcpu->crucible_response_original.data_offset == data_offset &&
+			vcpu->crucible_response_original.length == length &&
+			vcpu->crucible_response_original.count == count &&
+			vcpu->crucible_response_original.size == size &&
+			vcpu->crucible_response_original.direction == direction;
+	vcpu->crucible_response_original.reason = reason;
+	vcpu->crucible_response_original.address = address;
+	vcpu->crucible_response_original.data_offset = data_offset;
+	vcpu->crucible_response_original.length = length;
+	vcpu->crucible_response_original.count = count;
+	vcpu->crucible_response_original.size = size;
+	vcpu->crucible_response_original.direction = direction;
+	return true;
+}
+
+void kvm_crucible_response_observe(struct kvm_vcpu *vcpu, int result)
+{
+	struct kvm_crucible_response_state *state = &vcpu->crucible_response;
+
+	lockdep_assert_held(&vcpu->mutex);
+	if (!READ_ONCE(vcpu->kvm->crucible_response_enabled))
+		return;
+	/* A rejected RUN with stale shared-memory bytes is not a new native exit.
+	 * The enrolled normal path invalidates that reason before kernel admission.
+	 */
+	if (result < 0) {
+		if (kvm_arch_crucible_response_pending(vcpu)) {
+			state->phase = KVM_CRUCIBLE_COMPLETION_UNKNOWN;
+			state->flags |= KVM_CRUCIBLE_COMPLETION_UNCERTAIN;
+		}
+		return;
+	}
+	if (vcpu->run->exit_reason != KVM_EXIT_IO && vcpu->run->exit_reason != KVM_EXIT_MMIO) {
+		if (kvm_arch_crucible_response_pending(vcpu) ||
+		    vcpu->run->exit_reason == KVM_EXIT_HYPERCALL ||
+		    vcpu->run->exit_reason == KVM_EXIT_OSI ||
+		    vcpu->run->exit_reason == KVM_EXIT_PAPR_HCALL ||
+		    vcpu->run->exit_reason == KVM_EXIT_XEN ||
+		    vcpu->run->exit_reason == KVM_EXIT_EPR ||
+		    vcpu->run->exit_reason == KVM_EXIT_X86_RDMSR ||
+		    vcpu->run->exit_reason == KVM_EXIT_X86_WRMSR ||
+		    vcpu->run->exit_reason == KVM_EXIT_TDX) {
+			state->phase = KVM_CRUCIBLE_COMPLETION_UNSUPPORTED;
+			state->flags |= KVM_CRUCIBLE_COMPLETION_OPAQUE;
+		}
+		return;
+	}
+	if (!kvm_crucible_response_birth(state) || !response_geometry(vcpu, true) ||
+	    !kvm_arch_crucible_response_pending(vcpu)) {
+		state->phase = KVM_CRUCIBLE_COMPLETION_UNSUPPORTED;
+		state->flags |= KVM_CRUCIBLE_COMPLETION_OPAQUE;
+	} else if (result < 0) {
+		state->phase = KVM_CRUCIBLE_COMPLETION_UNKNOWN;
+		state->flags |= KVM_CRUCIBLE_COMPLETION_UNCERTAIN;
+	}
+}
+
+int kvm_crucible_response_ioctl(struct kvm_vcpu *vcpu, void __user *argument)
+{
+	struct kvm_crucible_response_state *state = &vcpu->crucible_response;
+	struct kvm_crucible_completion request;
+	struct kvm *kvm = vcpu->kvm;
+	unsigned long flags;
+	bool more = false;
+	int result, callback_result;
+
+	BUILD_BUG_ON(sizeof(request) != 96);
+	lockdep_assert_held(&vcpu->mutex);
+	if (!READ_ONCE(kvm->crucible_response_enabled))
+		return -EOPNOTSUPP;
+	if (copy_from_user(&request, argument, sizeof(request)))
+		return -EFAULT;
+	result = kvm_crucible_response_admit(state, &request);
+	if (result < 0)
+		return result;
+	if (result == 1) {
+		request = state->last_result;
+		goto deliver;
+	}
+	if (request.operation == KVM_CRUCIBLE_COMPLETION_QUERY) {
+		kvm_crucible_response_fill(state, &request, vcpu->vcpu_id);
+		request.callback_result = state->last_result.callback_result;
+		goto deliver;
+	}
+	if (!response_geometry(vcpu, false) || !kvm_arch_crucible_response_pending(vcpu))
+		return -ESTALE;
+
+	/* Serialize against clock Begin/Freeze; count this finite mechanical step.
+	 * Closed controller time is preserved, without claiming full device closure.
+	 */
+	mutex_lock(&kvm->crucible_configuration_lock);
+	raw_spin_lock_irqsave(&kvm->crucible_gate_lock, flags);
+	if (!kvm->crucible_controlled || kvm->crucible_active || kvm->crucible_effect_owners ||
+	    !kvm_arch_crucible_response_stopped(kvm)) {
+		raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+		mutex_unlock(&kvm->crucible_configuration_lock);
+		return -EBUSY;
+	}
+	kvm->crucible_effect_owners++;
+	raw_spin_unlock_irqrestore(&kvm->crucible_gate_lock, flags);
+
+	callback_result = kvm_arch_crucible_response_complete(vcpu, &more);
+	if (callback_result >= 0 && more && !response_geometry(vcpu, true))
+		callback_result = -EIO;
+	kvm_crucible_response_finish(state, &request, callback_result, more, vcpu->vcpu_id);
+	request = state->last_result;
+	kvm_crucible_effect_leave(kvm);
+	mutex_unlock(&kvm->crucible_configuration_lock);
+
+deliver:
+	/* The original result is already retained before delivery can fail. */
+	return copy_to_user(argument, &request, sizeof(request)) ? -EFAULT : 0;
+}
