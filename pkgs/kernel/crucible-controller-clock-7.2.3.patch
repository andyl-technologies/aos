+++ b/arch/x86/kvm/crucible-clock.c
@@ -0,0 +1,278 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* VM-owned frozen/capped counter domain. This partial extension deliberately
+ * does not advertise pvclock, timer, IRQ, device or complete-close coverage.
+ */
+#include <linux/kvm_host.h>
+#include <linux/ktime.h>
+#include <linux/math64.h>
+#include <linux/uaccess.h>
+
+#include "x86.h"
+#include "cpuid.h"
+#include "crucible-clock.h"
+#include "crucible-clock-math.h"
+
+static u64 clock_now_locked(struct kvm_crucible_clock_domain *clock)
+{
+	u64 now;
+
+	if (!clock->active)
+		return clock->frozen_ns;
+	now = ktime_get_ns();
+	return kvm_crucible_clock_project(now - clock->host_origin_ns,
+		clock->start_ns, clock->end_ns, clock->numerator, clock->denominator);
+}
+
+void kvm_crucible_clock_init(struct kvm *kvm)
+{
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+
+	raw_spin_lock_init(&clock->lock);
+	init_waitqueue_head(&clock->stopped);
+	mutex_init(&clock->control_lock);
+}
+
+static int clock_control_locked(struct kvm *kvm, struct kvm_crucible_clock *request)
+{
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	u64 extent;
+
+	if (request->operation == KVM_CRUCIBLE_CLOCK_CONFIGURE) {
+		if (clock->enabled || kvm->created_vcpus)
+			return -EBUSY;
+		if (kvm->arch.vm_type != KVM_X86_DEFAULT_VM || !request->numerator ||
+		    !request->denominator || request->window_generation)
+			return -EINVAL;
+		clock->numerator = request->numerator;
+		clock->denominator = request->denominator;
+		clock->frozen_ns = request->start_ns;
+		/* Configuration precedes vCPU creation and cannot be disabled. */
+		smp_store_release(&clock->enabled, true);
+		return 0;
+	}
+	if (!clock->enabled)
+		return -ENOENT;
+	if (request->operation == KVM_CRUCIBLE_CLOCK_QUERY)
+		return 0;
+	if (request->operation == KVM_CRUCIBLE_CLOCK_BEGIN) {
+		if (clock->active || clock->run_owners || (!clock->close_acknowledged &&
+		    clock->window_generation))
+			return -EBUSY;
+		if (clock->window_generation == U64_MAX ||
+		    request->window_generation != clock->window_generation + 1 ||
+		    request->start_ns != clock->frozen_ns || request->end_ns <= request->start_ns)
+			return -EINVAL;
+		extent = request->end_ns - request->start_ns;
+		if (extent > U64_MAX / clock->denominator)
+			return -EOVERFLOW;
+		clock->start_ns = request->start_ns;
+		clock->end_ns = request->end_ns;
+		clock->window_generation = request->window_generation;
+		clock->host_origin_ns = ktime_get_ns();
+		clock->close_acknowledged = false;
+		clock->active = true;
+		return 0;
+	}
+	if (request->window_generation != clock->window_generation)
+		return -ESTALE;
+	if (request->operation == KVM_CRUCIBLE_CLOCK_FREEZE) {
+		if (clock->active) {
+			clock->frozen_ns = clock_now_locked(clock);
+			clock->active = false;
+		}
+		return 0;
+	}
+	if (request->operation == KVM_CRUCIBLE_CLOCK_STEP) {
+		if (clock->active || clock->run_owners || !clock->close_acknowledged)
+			return -EBUSY;
+		if (request->start_ns < clock->frozen_ns)
+			return -EINVAL;
+		clock->frozen_ns = request->start_ns;
+		return 0;
+	}
+	return -EINVAL;
+}
+
+int kvm_crucible_clock_control(struct kvm *kvm, struct kvm_enable_cap *cap)
+{
+	struct kvm_crucible_clock_domain *clock = &kvm->arch.crucible_clock;
+	struct kvm_crucible_clock request;
+	void __user *user = u64_to_user_ptr(cap->args[0]);
+	unsigned long flags;
+	long waited;
+	int result;
+
+	if (cap->args[1] || cap->args[2] || cap->args[3])
+		return -EINVAL;
+	if (copy_from_user(&request, user, sizeof(request)))
+		return -EFAULT;
+	if (request.version != 1 || request.flags || request.reserved[0] ||
+	    request.reserved[1] || request.reserved[2] || request.reserved[3] ||
+	    request.reserved[4])
+		return -EINVAL;
+	if (request.operation == KVM_CRUCIBLE_CLOCK_FREEZE &&
+	    (!request.stop_budget_ns || request.stop_budget_ns > 5ULL * NSEC_PER_SEC))
+		return -EINVAL;
+
+	mutex_lock(&clock->control_lock);
+	if (request.operation == KVM_CRUCIBLE_CLOCK_CONFIGURE)
+		mutex_lock(&kvm->lock);
+	raw_spin_lock_irqsave(&clock->lock, flags);
+	result = clock_control_locked(kvm, &request);
+	raw_spin_unlock_irqrestore(&clock->lock, flags);
+	if (request.operation == KVM_CRUCIBLE_CLOCK_CONFIGURE)
+		mutex_unlock(&kvm->lock);
+	if (!result && request.operation == KVM_CRUCIBLE_CLOCK_FREEZE) {
+		/* Never wait while holding the domain lock used by run-owner exit. */
+		kvm_make_all_cpus_request(kvm, KVM_REQ_EVENT);
+		waited = wait_event_interruptible_timeout(clock->stopped,
+			!READ_ONCE(clock->run_owners),
+			max_t(unsigned long, 1, nsecs_to_jiffies(request.stop_budget_ns)));
+		if (waited <= 0)
+			result = waited ? waited : -ETIMEDOUT;
+		else {
+			raw_spin_lock_irqsave(&clock->lock, flags);
+			clock->close_acknowledged = true;
+			raw_spin_unlock_irqrestore(&clock->lock, flags);
+		}
+	}
+	raw_spin_lock_irqsave(&clock->lock, flags);
+	request.current_ns = clock_now_locked(clock);
+	request.window_generation = clock->window_generation;
+	request.start_ns = clock->start_ns;
+	request.end_ns = clock->end_ns;
+	request.numerator = clock->numerator;
+	request.denominator = clock->denominator;
+	request.coverage = KVM_CRUCIBLE_CLOCK_COVERAGE;
+	request.run_owners = clock->run_owners;
+	request.active = clock->active;
+	request.close_acknowledged = clock->close_acknowledged;
+	raw_spin_unlock_irqrestore(&clock->lock, flags);
+	mutex_unlock(&clock->control_lock);
+	if (copy_to_user(user, &request, sizeof(request)))
+		return -EFAULT;
+	return result;
+}
+
+int kvm_crucible_clock_run_enter(struct kvm_vcpu *vcpu)
+{
+	struct kvm_crucible_clock_domain *clock = &vcpu->kvm->arch.crucible_clock;
+	unsigned long flags;
+	int result = 0;
+
+	if (!kvm_crucible_clock_enabled(vcpu->kvm))
+		return 0;
+	raw_spin_lock_irqsave(&clock->lock, flags);
+	/* Frozen reentry with immediate_exit may finish old I/O, but may not
+	 * retire a subsequent guest instruction. Its owner is counted too.
+	 */
+	if (!clock->active && vcpu->wants_to_run)
+		result = -EAGAIN;
+	else {
+		if (!clock->active)
+			clock->close_acknowledged = false;
+		clock->run_owners++;
+	}
+	raw_spin_unlock_irqrestore(&clock->lock, flags);
+	return result;
+}
+
+void kvm_crucible_clock_run_leave(struct kvm_vcpu *vcpu)
+{
+	struct kvm_crucible_clock_domain *clock = &vcpu->kvm->arch.crucible_clock;
+	unsigned long flags;
+	bool stopped;
+
+	if (!kvm_crucible_clock_enabled(vcpu->kvm))
+		return;
+	raw_spin_lock_irqsave(&clock->lock, flags);
+	clock->run_owners--;
+	stopped = !clock->run_owners;
+	raw_spin_unlock_irqrestore(&clock->lock, flags);
+	if (stopped)
+		wake_up_all(&clock->stopped);
+}
+
+bool kvm_crucible_clock_run_allowed(struct kvm_vcpu *vcpu)
+{
+	return !kvm_crucible_clock_enabled(vcpu->kvm) ||
+		(READ_ONCE(vcpu->kvm->arch.crucible_clock.active) && !is_guest_mode(vcpu));
+}
+
+static u64 clock_tsc_base(struct kvm_vcpu *vcpu)
+{
+	struct kvm_crucible_clock_domain *clock = &vcpu->kvm->arch.crucible_clock;
+	unsigned long flags;
+	u64 nanoseconds;
+
+	raw_spin_lock_irqsave(&clock->lock, flags);
+	nanoseconds = clock_now_locked(clock);
+	raw_spin_unlock_irqrestore(&clock->lock, flags);
+	return mul_u64_u32_div(nanoseconds, vcpu->arch.virtual_tsc_khz, 1000000);
+}
+
+u64 kvm_crucible_clock_tsc(struct kvm_vcpu *vcpu)
+{
+	return clock_tsc_base(vcpu) + vcpu->arch.crucible_tsc_offset;
+}
+
+int kvm_crucible_clock_write_tsc(struct kvm_vcpu *vcpu, u64 value, bool host)
+{
+	u64 delta = value - kvm_crucible_clock_tsc(vcpu);
+
+	vcpu->arch.crucible_tsc_offset += delta;
+	if (!host)
+		vcpu->arch.ia32_tsc_adjust_msr += delta;
+	return 0;
+}
+
+int kvm_crucible_clock_write_adjust(struct kvm_vcpu *vcpu, u64 value, bool host)
+{
+	if (guest_cpu_cap_has(vcpu, X86_FEATURE_TSC_ADJUST)) {
+		if (!host)
+			vcpu->arch.crucible_tsc_offset += value - vcpu->arch.ia32_tsc_adjust_msr;
+		vcpu->arch.ia32_tsc_adjust_msr = value;
+	}
+	return 0;
+}
+
+static int emulate_counter(struct kvm_vcpu *vcpu, bool auxiliary)
+{
+	struct msr_data aux = { .index = MSR_TSC_AUX };
+	u64 value;
+
+	if (!kvm_crucible_clock_enabled(vcpu->kvm))
+		return auxiliary ? kvm_handle_invalid_op(vcpu) :
+			kvm_emulate_instruction(vcpu, 0);
+	if (auxiliary && !guest_cpu_cap_has(vcpu, X86_FEATURE_RDTSCP)) {
+		kvm_queue_exception(vcpu, UD_VECTOR);
+		return 1;
+	}
+	if ((kvm_read_cr4(vcpu) & X86_CR4_TSD) && kvm_x86_call(get_cpl)(vcpu)) {
+		kvm_inject_gp(vcpu, 0);
+		return 1;
+	}
+	/* A fault must not partially modify the instruction's destination state. */
+	if (auxiliary && kvm_x86_call(get_msr)(vcpu, &aux)) {
+		kvm_inject_gp(vcpu, 0);
+		return 1;
+	}
+	value = kvm_crucible_clock_tsc(vcpu);
+	kvm_eax_write(vcpu, value);
+	kvm_edx_write(vcpu, value >> 32);
+	if (auxiliary)
+		kvm_ecx_write(vcpu, aux.data);
+	return kvm_skip_emulated_instruction(vcpu);
+}
+
+int kvm_crucible_emulate_rdtsc(struct kvm_vcpu *vcpu)
+{
+	return emulate_counter(vcpu, false);
+}
