+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __KVM_X86_CRUCIBLE_CLOCK_MATH_H
+#define __KVM_X86_CRUCIBLE_CLOCK_MATH_H
+
+/* Callers validate extent*denominator before installing a window. This makes
+ * the unsaturated elapsed*numerator product representable without floating
+ * point, and saturation never creates a later authorization interval.
+ */
+static inline u64 kvm_crucible_clock_project(u64 elapsed, u64 start, u64 end,
+					   u32 numerator, u32 denominator)
+{
+	u64 product = (end - start) * denominator;
+	u64 threshold = product / numerator + !!(product % numerator);
+
+	if (elapsed >= threshold)
+		return end;
+	return start + elapsed * numerator / denominator;
+}
