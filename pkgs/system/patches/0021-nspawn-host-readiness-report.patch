+                if (r >= 0)
+                        r = aos_host_report_originals(&aos_report, true);
+                if (r < 0)
+                        return EXIT_FAILURE;
+                aos_report.fd = safe_close(aos_report.fd);
+                for (size_t i = 0; i < ELEMENTSOF(aos_report.originals); i++)
+                        aos_report.originals[i] = safe_close(aos_report.originals[i]);
+                argc = 1;
+                argv[1] = NULL;
+        }
