@@ -3469,1 +3471,23 @@ int main(int argc, char *argv[]) {
         assert_se(argc > 0 && !isempty(argv[0]));
+
+        /* Selected fixed Guest-init exec only; ordinary manager entry, argv,
+         * activation and collect_fds paths remain unchanged. The report is
+         * emitted by this post-exec image, never inferred from bootstrap exe. */
+        if (argc == 2 && streq(argv[1], "--aos-host-readiness-report")) {
+                if (getpid_cached() != 1 || geteuid() != 0)
+                        return EXIT_FAILURE;
+                aos_report.fd = AOS_HOST_REPORT_GUEST_FD;
+                r = fd_cloexec(aos_report.fd, true);
