new file mode 100644
--- /dev/null
+++ b/src/shared/aos-host-readiness.h
@@ -0,0 +1,174 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <time.h>
+#include <unistd.h>
+
+#include "socket-util.h"
+#include "unaligned.h"
+
+#define AOS_HOST_REPORT_HEADER_BYTES 176U
+#define AOS_HOST_REPORT_CHALLENGE_BYTES 200U
+#define AOS_HOST_REPORT_MAX_BYTES 98504U
+#define AOS_HOST_REPORT_FD_NAME "aos-host-readiness-report"
+#define AOS_HOST_REPORT_GUEST_FD 8
+
+/* Private inherited transport DATA. These bytes never replace Host's actual
+ * MainPID/invocation, measured executable, same-child pidfd or cleanup gates.
+ * Native returned originals and partial challenge stay resident through an
+ * error; process termination is not a population/drain certificate. */
+typedef struct AosHostReport {
+        int fd;
+        int originals[3];
+        uint8_t challenge[AOS_HOST_REPORT_CHALLENGE_BYTES];
+        bool attempted;
+        bool ready;
+        int first_error;
+} AosHostReport;
+
+#define AOS_HOST_REPORT_INIT { .fd = -EBADF, .originals = { -EBADF, -EBADF, -EBADF } }
+
+static int aos_host_report_before(const AosHostReport *report) {
+        struct timespec ts;
+        uint64_t now, deadline;
+
+        if (!report->ready)
+                return -ESTALE;
+        if (clock_gettime(CLOCK_BOOTTIME, &ts) < 0)
+                return -errno;
+        if (ts.tv_sec < 0 || ts.tv_nsec < 0 || ts.tv_nsec >= 1000000000 ||
+            (uint64_t) ts.tv_sec > UINT64_MAX / 1000000000U)
+                return -EOVERFLOW;
+        now = (uint64_t) ts.tv_sec * 1000000000U;
+        if (now > UINT64_MAX - (uint64_t) ts.tv_nsec)
+                return -EOVERFLOW;
+        now += (uint64_t) ts.tv_nsec;
+        deadline = unaligned_read_be64(report->challenge + 192);
+        return now < deadline ? 0 : -ETIMEDOUT;
+}
+
+static int aos_host_report_challenge(AosHostReport *report) {
+        CMSG_BUFFER_TYPE(CMSG_SPACE(sizeof(struct ucred)) + CMSG_SPACE(sizeof(int))) control = {};
+        struct iovec iov = { .iov_base = report->challenge, .iov_len = sizeof(report->challenge) };
+        struct msghdr message = {
+                .msg_iov = &iov,
+                .msg_iovlen = 1,
+                .msg_control = control.buf,
+                .msg_controllen = sizeof(control.buf),
+        };
+        struct pollfd wait = { .fd = report->fd, .events = POLLIN };
+        ssize_t n;
+        int r;
+
+        if (report->attempted || report->fd < 0)
+                return -ESTALE;
+        report->attempted = true;
+        /* This finite pre-challenge wait cannot renew the supplied original D.
+         * The complete record is checked before any selected report or exec. */
+        r = poll(&wait, 1, 30000);
+        if (r < 0)
+                return report->first_error = -errno;
+        if (r == 0 || wait.revents != POLLIN)
+                return report->first_error = r == 0 ? -ETIMEDOUT : -EIO;
+        n = recvmsg_safe(report->fd, &message, MSG_DONTWAIT|MSG_CMSG_CLOEXEC);
+        /* The shared ancillary disposer owns every returned nominated pidfd.
+         * No strict global peer identity is fabricated inside the child PID
+         * namespace. Host independently associates every outgoing report. */
+        if (n < 0)
+                return report->first_error = (int) n;
+        cmsg_close_all(&message);
+        if (n != sizeof(report->challenge) || message.msg_flags & (MSG_TRUNC|MSG_CTRUNC) ||
+            memcmp(report->challenge, "AOSHCR01", 8) != 0 ||
+            unaligned_read_be16(report->challenge + 8) != 1 ||
+            unaligned_read_be16(report->challenge + 10) != 0 ||
+            unaligned_read_be32(report->challenge + 12) != sizeof(report->challenge) ||
+            unaligned_read_be32(report->challenge + 160) != 0 ||
+            unaligned_read_be32(report->challenge + 164) != 0 ||
+            unaligned_read_be64(report->challenge + 168) != 0 ||
+            unaligned_read_be64(report->challenge + 192) == 0)
+                return report->first_error = -EBADMSG;
+        report->ready = true;
+        r = aos_host_report_before(report);
+        if (r < 0) {
+                report->ready = false;
+                report->first_error = r;
+        }
+        return r;
+}
+
+static int aos_host_report_send(
+                AosHostReport *report,
+                uint16_t kind,
+                uint64_t sequence,
+                uint8_t *bytes,
+                size_t size,
+                const int *fds,
+                size_t n_fds) {
+        CMSG_BUFFER_TYPE(CMSG_SPACE(3 * sizeof(int))) control = {};
+        struct iovec iov = { .iov_base = bytes, .iov_len = size };
+        struct msghdr message = { .msg_iov = &iov, .msg_iovlen = 1 };
+        int r;
+
+        if (size < AOS_HOST_REPORT_HEADER_BYTES || size > AOS_HOST_REPORT_MAX_BYTES || n_fds > 3)
+                return -EINVAL;
+        memcpy(bytes, report->challenge, 160);
+        unaligned_write_be16(bytes + 10, kind);
+        unaligned_write_be32(bytes + 12, size);
+        unaligned_write_be32(bytes + 164, 0);
+        unaligned_write_be64(bytes + 168, sequence);
+        if (n_fds > 0) {
+                struct cmsghdr *cmsg;
+
+                message.msg_control = control.buf;
+                message.msg_controllen = CMSG_SPACE(n_fds * sizeof(int));
+                cmsg = CMSG_FIRSTHDR(&message);
+                cmsg->cmsg_level = SOL_SOCKET;
+                cmsg->cmsg_type = SCM_RIGHTS;
+                cmsg->cmsg_len = CMSG_LEN(n_fds * sizeof(int));
+                memcpy(CMSG_DATA(cmsg), fds, n_fds * sizeof(int));
+        }
+        for (;;) {
+                struct pollfd wait = { .fd = report->fd, .events = POLLOUT };
+                ssize_t n;
+
+                r = aos_host_report_before(report);
+                if (r < 0)
+                        return r;
+                n = sendmsg(report->fd, &message, MSG_DONTWAIT|MSG_NOSIGNAL);
+                if (n >= 0)
+                        return n == size ? aos_host_report_before(report) : -EIO;
+                if (!IN_SET(errno, EAGAIN, EINTR))
+                        return -errno;
+                r = poll(&wait, 1, 2);
+                if (r < 0 && errno != EINTR)
+                        return -errno;
+        }
+}
+
+static int aos_host_report_originals(AosHostReport *report, bool guest_manager) {
+        uint8_t bytes[AOS_HOST_REPORT_HEADER_BYTES] = {};
+        static const char *const paths[] = { "/proc/self/exe", "/proc/self/ns/net", "/proc/self/stat" };
+        size_t count = guest_manager ? 1 : 3;
+        int r;
+
+        for (size_t i = 0; i < count; i++) {
+                if (report->originals[i] >= 0)
+                        return -ESTALE;
+                report->originals[i] = open(paths[i], O_RDONLY|O_CLOEXEC);
+                if (report->originals[i] < 0)
+                        return -errno;
+                r = aos_host_report_before(report);
+                if (r < 0)
+                        return r;
+        }
+        return aos_host_report_send(report, guest_manager ? 6 : 1, guest_manager ? 3 : 0,
+                                    bytes, sizeof(bytes), report->originals, count);
+}
