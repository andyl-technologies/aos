+int aos_resource_enforce_controller_cpu(Service *service, int prepare_result) {
+        Unit *unit = UNIT(service);
+        AosResourceControllerCPU *original = &enrollment.controller_cpu;
+        AosResourceControllerCPUCheck *check;
+        CGroupRuntime *runtime;
+        char expected[128];
+        bool first;
+        int r;
+
+        if (!aos_resource_controller_protected_unit(unit))
+                return prepare_result;
+        if (original->first_error < 0)
+                return refuse(original->first_error);
+        if (!original->prepared || !enrollment.admitted || enrollment.manager != unit->manager ||
+            !sd_id128_equal(original->invocation, unit->invocation_id))
+                return controller_cpu_refuse(-EOWNERDEAD);
+
+        first = !original->attempted;
+        original->attempted = true;
+        check = first ? &original->first : &original->later;
+        check->prepare_result = prepare_result;
+        if (prepare_result < 0)
+                return controller_cpu_refuse(prepare_result);
+        runtime = unit_get_cgroup_runtime(unit);
+        if (!runtime || !streq_ptr(runtime->cgroup_path, AOS_RESOURCE_CONTROLLER_CGROUP))
+                return controller_cpu_refuse(-EPERM);
+
+        if (first) {
+                original->cgroup_fd = cg_path_open(runtime->cgroup_path);
+                if (original->cgroup_fd < 0)
+                        return controller_cpu_refuse(original->cgroup_fd);
+                original->control_fd = openat(original->cgroup_fd, "cpu.max", O_RDWR | O_CLOEXEC | O_NOFOLLOW);
+                original->control_open_result = original->control_fd < 0 ? -errno : 0;
+                if (original->control_open_result < 0)
+                        return controller_cpu_refuse(original->control_open_result);
+        }
+        r = controller_cpu_check(check, runtime);
+        if (r < 0)
+                return controller_cpu_refuse(r);
+        snprintf(expected, sizeof(expected), "%" PRIu64 " 100000\n",
+                 policy_u64(enrollment.policy + AOS_RESOURCE_CONTROLLER_PREFIX_OFFSET));
+        if (first) {
+                r = resource_control_install(original->control_fd, expected,
+                                             &original->write_length, &original->write_result);
+                if (r < 0)
+                        return controller_cpu_refuse(r);
+        }
+        r = resource_control_readback(original->control_fd, expected, check->readback,
+                                      sizeof(check->readback), &check->read_length, &check->read_result);
+        if (r < 0)
+                return controller_cpu_refuse(r);
+        return 0;
+}
