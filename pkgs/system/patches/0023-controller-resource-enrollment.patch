diff --git a/src/core/aos-resource-enrollment.c b/src/core/aos-resource-enrollment.c
new file mode 100644
--- /dev/null
+++ b/src/core/aos-resource-enrollment.c
@@ -0,0 +1,386 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <sys/vfs.h>
+#include <unistd.h>
+
+#include "aos-resource-enrollment.h"
+#include "alloc-util.h"
+#include "fd-util.h"
+#include "initrd-util.h"
+#include "load-fragment.h"
+#include "memfd-util.h"
+#include "set.h"
+#include "sha256.h"
+#include "string-util.h"
+
+#define AOS_RESOURCE_POLICY_BYTES 776U
+#define AOS_RESOURCE_POLICY_BODY 744U
+#define AOS_RESOURCE_VECTOR_BYTES (22U * 8U)
+#define AOS_RESOURCE_COMPONENTS_OFFSET (40U + 3U * AOS_RESOURCE_VECTOR_BYTES)
+#define AOS_RESOURCE_CONCURRENT_OPERATIONS 21U
+#define AOS_RESOURCE_EROFS_MAGIC 0xE0F5E1E2
+
+/* Both original OFDs stay with the recipient even after failed comparison or
+ * Service cleanup. Service.extra_fds owns only the completed delivery copy. */
+typedef struct AosResourceDelivery {
+        int sealed_fd;
+        int reopened_fd;
+        struct stat sealed_stat;
+        struct stat reopened_stat;
+        int sealed_stat_result;
+        int sealed_seals;
+        int reopened_stat_result;
+        int reopened_seals;
+        int reopened_flags;
+        int comparison;
+        int delivery_error;
+        bool attempted;
+} AosResourceDelivery;
+
+typedef struct AosResourceEnrollment {
+        Manager *manager;
+        int policy_fd;
+        int first_error;
+        bool attempted;
+        bool admitted;
+        sd_id128_t boot;
+        sd_id128_t invocation;
+        uint8_t policy[AOS_RESOURCE_POLICY_BYTES];
+        uint64_t job_limit;
+        uint64_t jobs;
+        sd_id128_t controller_invocation;
+        sd_id128_t storage_invocation;
+        AosResourceDelivery controller_delivery;
+        AosResourceDelivery storage_delivery;
+} AosResourceEnrollment;
+
+/* The existing root PID1 is the only issuer. This original owner is neither
+ * serialized nor reconstructed from an inherited capsule after reexec. */
+#define AOS_RESOURCE_DELIVERY_EMPTY { \
+        .sealed_fd = -EBADF, \
+        .reopened_fd = -EBADF, \
+        .sealed_stat_result = -EBADF, \
+        .sealed_seals = -EBADF, \
+        .reopened_stat_result = -EBADF, \
+        .reopened_seals = -EBADF, \
+        .reopened_flags = -EBADF, \
+        .comparison = -EBADF, \
+}
+
+static AosResourceEnrollment enrollment = {
+        .policy_fd = -EBADF,
+        .controller_delivery = AOS_RESOURCE_DELIVERY_EMPTY,
+        .storage_delivery = AOS_RESOURCE_DELIVERY_EMPTY,
+};
+
+static uint64_t policy_u64(const uint8_t *bytes) {
+        uint64_t value = 0;
+
+        for (unsigned i = 0; i < 8; i++)
+                value = (value << 8) | bytes[i];
+        return value;
+}
+
+static int refuse(int error) {
+        assert(error < 0);
+
+        if (enrollment.first_error == 0)
+                enrollment.first_error = error;
+        enrollment.admitted = false;
+        return enrollment.first_error;
+}
+
+static int read_original_policy(void) {
+        uint8_t digest[SHA256_DIGEST_SIZE];
+        struct stat st;
+        struct statfs fs;
+        size_t used = 0;
+
+        if (fstat(enrollment.policy_fd, &st) < 0 ||
+            fstatfs(enrollment.policy_fd, &fs) < 0)
+                return -errno;
+        if (!S_ISREG(st.st_mode) || st.st_size != AOS_RESOURCE_POLICY_BYTES ||
+            st.st_uid != 0 || st.st_gid != 0 || (st.st_mode & 0222) != 0 ||
+            fs.f_type != AOS_RESOURCE_EROFS_MAGIC)
+                return -EPERM;
+
+        while (used < sizeof(enrollment.policy)) {
+                ssize_t returned = pread(enrollment.policy_fd, enrollment.policy + used,
+                                         sizeof(enrollment.policy) - used, used);
+                if (returned < 0) {
+                        if (errno == EINTR)
+                                continue;
+                        return -errno;
+                }
+                if (returned == 0)
+                        return -EBADMSG;
+                used += returned;
+        }
+        if (memcmp(enrollment.policy, "AOSRSB01", 8) != 0)
+                return -EBADMSG;
+        sha256_direct(enrollment.policy, AOS_RESOURCE_POLICY_BODY, digest);
+        if (memcmp(digest, enrollment.policy + AOS_RESOURCE_POLICY_BODY, sizeof(digest)) != 0)
+                return -EBADMSG;
+
+        /* Image generation checks all 22 rows with explicit finite policy.
+         * PID1 does not implement a second resource arithmetic ledger. This
+         * local job count subdivides the already prepaid component envelope. */
+        enrollment.job_limit = policy_u64(enrollment.policy + AOS_RESOURCE_COMPONENTS_OFFSET +
+                                          AOS_RESOURCE_CONCURRENT_OPERATIONS * 8U);
+        return enrollment.job_limit > 0 ? 0 : -ENODATA;
+}
+
+int aos_resource_enrollment_begin(Manager *manager, bool restoring) {
+        int r;
+
+        assert(manager);
+
+        if (in_initrd() || !aos_network_image_guard_active())
+                return 0;
+        if (enrollment.attempted)
+                return refuse(-EALREADY);
+
+        /* Arm before the first native open. An error retains its descriptor
+         * and original cause; no later trigger retries or manufactures a loan. */
+        enrollment.attempted = true;
+        enrollment.manager = manager;
+        /* The original initrd handoff is the first final-root enrollment,
+         * not a daemon re-exec that has lost its original producer custody. */
+        if (restoring && !MANAGER_IS_SWITCHING_ROOT(manager)) {
+                refuse(-EOWNERDEAD);
+                return 0;
+        }
+        enrollment.policy_fd = aos_resource_open_image_policy();
+        if (enrollment.policy_fd < 0) {
+                refuse(enrollment.policy_fd);
+                return 0;
+        }
+        r = read_original_policy();
+        if (r < 0) {
+                refuse(r);
+                return 0;
+        }
+        r = sd_id128_get_boot(&enrollment.boot);
+        if (r >= 0)
+                r = sd_id128_randomize(&enrollment.invocation);
+        if (r < 0) {
+                refuse(r);
+                return 0;
+        }
+        if (sd_id128_is_null(enrollment.boot) || sd_id128_is_null(enrollment.invocation)) {
+                refuse(-ENODATA);
+                return 0;
+        }
+
+        /* The fixed image policy itself authorizes these two finite trusted
+         * bootstrap envelopes before enumeration, sockets or selected jobs.
+         * Dynamic projects are admitted only by the Rust durable bank. */
+        enrollment.admitted = true;
+        return 0;
+}
+
+static bool selected_unit(const Unit *unit) {
+        const char *alias;
+        bool selected;
+
+        if (in_initrd() || !aos_network_image_guard_active())
+                return false;
+        selected = startswith(unit->id, "aos-");
+        SET_FOREACH(alias, unit->aliases)
+                if (startswith(alias, "aos-"))
+                        selected = true;
+        return selected;
+}
+
+int aos_resource_require_unit(Unit *unit) {
+        assert(unit);
+
+        if (!selected_unit(unit))
+                return 0;
+        if (!enrollment.admitted || enrollment.manager != unit->manager)
+                return enrollment.first_error < 0 ? enrollment.first_error : -ENODATA;
+        return 0;
+}
+
+int aos_resource_job_acquire(Unit *unit) {
+        int r;
+
+        assert(unit);
+
+        r = aos_resource_require_unit(unit);
+        if (r < 0)
+                return r;
+        if (!enrollment.admitted || enrollment.manager != unit->manager)
+                return 0;
+        if (enrollment.jobs >= enrollment.job_limit)
+                return -ENOSPC;
+
+        /* Cover ordinary competing manager jobs too while the shared fixed
+         * envelope is active. Dependency/reload/deserialization use this same
+         * pre-allocation entry point, not a post-spawn accounting receipt. */
+        enrollment.jobs++;
+        return 1;
+}
+
+/* These fixed roles borrow the one already reserved bootstrap envelope.
+ * Their invocation owners survive unit unload; a new Service object cannot
+ * obtain a second payment by resetting its delivery flag. */
+static sd_id128_t *recipient_invocation(const Unit *unit) {
+        if (streq_ptr(unit->id, "aos-sandboxd.service"))
+                return &enrollment.controller_invocation;
+        if (streq_ptr(unit->id, "aos-storaged.service"))
+                return &enrollment.storage_invocation;
+        return NULL;
+}
+
+static AosResourceDelivery *recipient_delivery(const Unit *unit) {
+        if (streq_ptr(unit->id, "aos-sandboxd.service"))
+                return &enrollment.controller_delivery;
+        if (streq_ptr(unit->id, "aos-storaged.service"))
+                return &enrollment.storage_delivery;
+        return NULL;
+}
+
+static int compare_original_capsule(AosResourceDelivery *delivery) {
+        const int required_seals = F_SEAL_SEAL | F_SEAL_GROW | F_SEAL_SHRINK | F_SEAL_WRITE;
+
+        /* The actual reopen Result is already parked. Independent available
+         * original observations do not replace that earlier native cause. */
+        delivery->sealed_stat_result = fstat(delivery->sealed_fd, &delivery->sealed_stat) < 0 ? -errno : 0;
+        delivery->sealed_seals = fcntl(delivery->sealed_fd, F_GET_SEALS);
+        if (delivery->sealed_seals < 0)
+                delivery->sealed_seals = -errno;
+
+        if (delivery->reopened_fd >= 0) {
+                delivery->reopened_stat_result = fstat(delivery->reopened_fd, &delivery->reopened_stat) < 0 ? -errno : 0;
+                delivery->reopened_seals = fcntl(delivery->reopened_fd, F_GET_SEALS);
+                if (delivery->reopened_seals < 0)
+                        delivery->reopened_seals = -errno;
+                delivery->reopened_flags = fcntl(delivery->reopened_fd, F_GETFL);
+                if (delivery->reopened_flags < 0)
+                        delivery->reopened_flags = -errno;
+        }
+
+        if (delivery->reopened_fd < 0)
+                return delivery->reopened_fd;
+        if (delivery->sealed_stat_result < 0)
+                return delivery->sealed_stat_result;
+        if (delivery->sealed_seals < 0)
+                return delivery->sealed_seals;
+        if (delivery->reopened_stat_result < 0)
+                return delivery->reopened_stat_result;
+        if (delivery->reopened_seals < 0)
+                return delivery->reopened_seals;
+        if (delivery->reopened_flags < 0)
+                return delivery->reopened_flags;
+
+        if (!S_ISREG(delivery->sealed_stat.st_mode) || !S_ISREG(delivery->reopened_stat.st_mode) ||
+            delivery->sealed_stat.st_size != 152 || delivery->reopened_stat.st_size != 152 ||
+            delivery->sealed_stat.st_dev != delivery->reopened_stat.st_dev ||
+            delivery->sealed_stat.st_ino != delivery->reopened_stat.st_ino ||
+            delivery->sealed_seals != delivery->reopened_seals ||
+            (delivery->sealed_seals & required_seals) != required_seals ||
+            (delivery->reopened_flags & O_ACCMODE) != O_RDONLY ||
+            (delivery->reopened_flags & O_PATH) != 0)
+                return -EPERM;
+
+        return 0;
+}
+
+sd_id128_t aos_resource_unit_producer(Service *service) {
+        Unit *unit = UNIT(service);
+        sd_id128_t *original = recipient_invocation(unit);
+
+        /* Read-only DATA from original manager custody. Reexec deliberately
+         * loses this owner; neither a capsule nor a unit property recreates it. */
+        if (!original || !enrollment.admitted || enrollment.manager != unit->manager ||
+            !service->aos_resource_delivery || sd_id128_is_null(*original) ||
+            !sd_id128_equal(*original, unit->invocation_id))
+                return SD_ID128_NULL;
+        return enrollment.invocation;
+}
+
+int aos_resource_deliver_component(Service *service) {
+        uint8_t capsule[152] = {};
+        uint8_t digest[SHA256_DIGEST_SIZE];
+        Unit *unit = UNIT(service);
+        sd_id128_t *original = recipient_invocation(unit);
+        int r;
+
+        if (!aos_network_image_guard_active() || !original)
+                return 0;
+        r = aos_resource_require_unit(unit);
+        if (r >= 0)
+                r = aos_resource_verify_component_fragment(unit);
+        if (r < 0)
+                return refuse(r);
+        if (sd_id128_is_null(unit->invocation_id))
+                return refuse(-ENODATA);
+        if (!sd_id128_is_null(*original)) {
+                /* A new invocation must recover the previous native owner;
+                 * restart cannot reconstruct original custody from bytes. */
+                return service->aos_resource_delivery && sd_id128_equal(*original, unit->invocation_id)
+                        ? 0 : refuse(-EOWNERDEAD);
+        }
+        if (service->aos_resource_delivery || service->n_extra_fds != 0 || service->n_fd_store != 0)
+                return refuse(-EPERM);
+
+        AosResourceDelivery *delivery = recipient_delivery(unit);
+        if (!delivery || delivery->attempted)
+                return refuse(-EALREADY);
+        delivery->attempted = true;
+
+        service->extra_fds = new0(ServiceExtraFD, 2);
+        if (!service->extra_fds)
+                return refuse(-ENOMEM);
+        service->n_extra_fds = 2;
+        service->extra_fds[0].fd = service->extra_fds[1].fd = -EBADF;
+        service->aos_resource_delivery = true;
+        *original = unit->invocation_id;
+        service->extra_fds[0].fdname = strdup("aos-resource-image-policy-v1");
+        service->extra_fds[1].fdname = strdup("aos-resource-pid1-enrollment-v1");
+        if (!service->extra_fds[0].fdname || !service->extra_fds[1].fdname)
+                return refuse(-ENOMEM);
+
+        service->extra_fds[0].fd = fcntl(enrollment.policy_fd, F_DUPFD_CLOEXEC, 3);
+        if (service->extra_fds[0].fd < 0)
+                return refuse(-errno);
+        memcpy(capsule, "AOSRSE01", 8);
+        memcpy(capsule + 8, enrollment.policy + 8, 32);
+        memcpy(capsule + 40, enrollment.boot.bytes, 16);
+        memcpy(capsule + 56, enrollment.invocation.bytes, 16);
+        sha256_direct(enrollment.policy, sizeof(enrollment.policy), digest);
+        memcpy(capsule + 72, digest, sizeof(digest));
+        memcpy(capsule + 104, unit->invocation_id.bytes, 16);
+        sha256_direct(capsule, 120, capsule + 120);
+        delivery->sealed_fd = memfd_new_and_seal("aos-resource-pid1-enrollment-v1", capsule, sizeof(capsule));
+        if (delivery->sealed_fd < 0)
+                return refuse(delivery->sealed_fd);
+
+        /* Seals do not clear FMODE_WRITE at the recipient's SELinux exec
+         * boundary. Only this checked same-inode RO OFD is delivered. */
+        delivery->reopened_fd = fd_reopen(delivery->sealed_fd, O_RDONLY | O_CLOEXEC);
+        delivery->comparison = compare_original_capsule(delivery);
+        if (delivery->comparison < 0)
+                return refuse(delivery->comparison);
+
+        service->extra_fds[1].fd = fcntl(delivery->reopened_fd, F_DUPFD_CLOEXEC, 3);
+        if (service->extra_fds[1].fd < 0) {
+                delivery->delivery_error = -errno;
+                service->extra_fds[1].fd = delivery->delivery_error;
+                return refuse(delivery->delivery_error);
+        }
+        return 0;
+}
+
+void aos_resource_job_release(bool charged) {
+        if (!charged)
+                return;
+
+        assert(enrollment.jobs > 0);
+        enrollment.jobs--;
+        /* Only the freed local Job slot is reusable. Neither fixed envelope
+         * nor a durable project claim is refunded by object destruction. */
+}
