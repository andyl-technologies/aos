+#include "string-util.h"
+
+#define AOS_RESOURCE_POLICY_BYTES 776U
+#define AOS_RESOURCE_POLICY_BODY 744U
+#define AOS_RESOURCE_HOST_POLICY_BYTES 1128U
+#define AOS_RESOURCE_HOST_POLICY_BODY 1096U
+#define AOS_RESOURCE_FIRST_GLOBAL_POLICY_BYTES 1304U
+#define AOS_RESOURCE_FIRST_GLOBAL_POLICY_BODY 1272U
+#define AOS_RESOURCE_NIX_INTAKE_POLICY_BYTES 1480U
+#define AOS_RESOURCE_NIX_INTAKE_POLICY_BODY 1448U
+#define AOS_RESOURCE_Q04_INTAKE_POLICY_BYTES 1656U
+#define AOS_RESOURCE_Q04_INTAKE_POLICY_BODY 1624U
+#define AOS_RESOURCE_ROOT_POLICY_BYTES 1832U
+#define AOS_RESOURCE_ROOT_POLICY_BODY 1800U
+#define AOS_RESOURCE_ROOT_OFFSET 1624U
+#define AOS_RESOURCE_CONTROLLER_PREFIX_OFFSET 1096U
+#define AOS_RESOURCE_CONTROLLER_CGROUP "/aos.slice/aos-control.slice/aos-sandboxd.service"
+#define AOS_RESOURCE_CONTROLLER_CGROUP_FILE "/sys/fs/cgroup" AOS_RESOURCE_CONTROLLER_CGROUP
+#define AOS_RESOURCE_ROOT_CGROUP "/system.slice/aos-sandbox-policy-authorityd.service"
+#define AOS_RESOURCE_ROOT_CGROUP_FILE "/sys/fs/cgroup" AOS_RESOURCE_ROOT_CGROUP
+#define AOS_RESOURCE_VECTOR_BYTES (22U * 8U)
+#define AOS_RESOURCE_COMPONENTS_OFFSET (40U + 3U * AOS_RESOURCE_VECTOR_BYTES)
+#define AOS_RESOURCE_CONCURRENT_OPERATIONS 21U
+#define AOS_RESOURCE_EROFS_MAGIC 0xE0F5E1E2
+
+/* Both original OFDs stay with the recipient even after failed comparison or
+ * Service cleanup. Service.extra_fds owns only the completed delivery copy. */
+typedef struct AosResourceDelivery {
+        int sealed_fd;
+        int reopened_fd;
+        struct stat sealed_stat;
+        struct stat reopened_stat;
+        int sealed_stat_result;
+        int sealed_seals;
+        int reopened_stat_result;
+        int reopened_seals;
+        int reopened_flags;
+        int comparison;
+        int delivery_error;
+        bool attempted;
+} AosResourceDelivery;
+
+/* The first observations and the later-command check have separate storage.
+ * A failed check freezes both: no command reopens or reinstalls this owner. */
+typedef struct AosResourceControllerCPUCheck {
+        struct stat cgroup_stat;
+        struct statfs cgroup_statfs;
+        struct stat current_cgroup_stat;
+        struct stat control_stat;
+        struct statfs control_statfs;
+        struct stat current_control_stat;
+        int prepare_result;
+        int cgroup_stat_result;
+        int cgroup_statfs_result;
+        int current_cgroup_stat_result;
+        int control_stat_result;
+        int control_statfs_result;
+        int current_control_stat_result;
+        ssize_t read_length;
+        int read_result;
+        uint8_t readback[128];
+} AosResourceControllerCPUCheck;
+
+typedef struct AosResourceControllerCPU {
+        sd_id128_t invocation;
+        bool prepared;
+        bool attempted;
+        int first_error;
+        int fragment_result;
+        int cgroup_fd;
+        int control_fd;
+        int control_open_result;
+        ssize_t write_length;
+        int write_result;
+        AosResourceControllerCPUCheck first;
+        AosResourceControllerCPUCheck later;
+} AosResourceControllerCPU;
+
+/* Each bookend is written once. Raw event bytes and native errors are evidence,
+ * not a Drained claim. This fixed storage and two held OFDs are parent costs;
+ * this slice does not establish their whole-parent C/K payment. */
+typedef struct AosResourceRootObservation {
+        bool attempted;
+        bool unit_seen;
+        sd_id128_t invocation;
+        uint64_t cgroup_id;
+        uint64_t oom_kill_last;
+        uint64_t managed_oom_kill_last;
+        struct stat named_before;
+        struct stat named_after;
+        struct stat event_stats[2];
+        struct stat event_after_stats[2];
+        int named_before_result;
+        int named_after_result;
+        int event_stat_results[2];
+        int event_after_stat_results[2];
+        int unit_join_result;
+        int identity_result;
+        ssize_t read_lengths[2];
+        int read_results[2];
+        uint8_t readback[2][512];
+        int parse_results[2];
+        uint64_t event_values[2]; /* memory.events oom_kill; cgroup.events populated */
+        int result;
+} AosResourceRootObservation;
+
+typedef struct AosResourceEnrollment {
+        Manager *manager;
+        int policy_fd;
+        int first_error;
+        bool attempted;
+        bool admitted;
+        sd_id128_t boot;
+        sd_id128_t invocation;
+        uint8_t policy[AOS_RESOURCE_ROOT_POLICY_BYTES];
+        size_t policy_bytes;
+        uint64_t job_limit;
+        uint64_t jobs;
+        sd_id128_t controller_invocation;
+        sd_id128_t storage_invocation;
+        sd_id128_t host_invocation;
+        sd_id128_t root_invocation;
+        AosResourceDelivery controller_delivery;
+        AosResourceDelivery storage_delivery;
+        AosResourceDelivery host_delivery;
+        AosResourceDelivery root_delivery;
+        AosResourceControllerCPU controller_cpu;
+        int root_cgroup_fd;
+        int root_control_fds[3];
+        int root_write_results[3];
+        int root_read_results[3];
+        ssize_t root_write_lengths[3];
+        ssize_t root_read_lengths[3];
+        struct stat root_cgroup_stat;
+        struct statfs root_cgroup_statfs;
+        struct stat root_control_stats[3];
+        int root_cgroup_stat_result;
+        int root_cgroup_statfs_result;
+        int root_control_stat_results[3];
+        uint8_t root_readback[3][128];
+        int root_limit_error;
+        bool root_limits_attempted;
+        FixedCgroupSpawnOriginal root_spawn;
+        int root_event_fds[2];
+        int root_event_open_results[2];
+        struct stat root_event_stats[2];
+        int root_event_stat_results[2];
+        AosResourceRootObservation root_before_spawn;
+        AosResourceRootObservation root_at_death;
+        AosResourceRootObservation root_kernel_oom;
+        AosResourceRootObservation root_managed_oom;
+        AosResourceRootObservation root_before_cleanup;
+        bool root_death_attempted;
+        siginfo_t root_child_death;
+        siginfo_t root_manager_death;
+        int root_death_wait_result;
+        int root_death_join_result;
+        bool root_reap_attempted;
+        siginfo_t root_reaped_death;
+        int root_reap_result;
+        int root_reap_join_result;
+        int root_post_error;
+} AosResourceEnrollment;
+
+/* The existing root PID1 is the only issuer. This original owner is neither
+ * serialized nor reconstructed from an inherited capsule after reexec. */
+#define AOS_RESOURCE_DELIVERY_EMPTY { \
+        .sealed_fd = -EBADF, \
+        .reopened_fd = -EBADF, \
+        .sealed_stat_result = -EBADF, \
+        .sealed_seals = -EBADF, \
+        .reopened_stat_result = -EBADF, \
+        .reopened_seals = -EBADF, \
+        .reopened_flags = -EBADF, \
+        .comparison = -EBADF, \
+}
+
+static AosResourceEnrollment enrollment = {
+        .policy_fd = -EBADF,
+        .controller_delivery = AOS_RESOURCE_DELIVERY_EMPTY,
+        .storage_delivery = AOS_RESOURCE_DELIVERY_EMPTY,
+        .host_delivery = AOS_RESOURCE_DELIVERY_EMPTY,
+        .root_delivery = AOS_RESOURCE_DELIVERY_EMPTY,
+        .controller_cpu = {
+                .cgroup_fd = -EBADF,
+                .control_fd = -EBADF,
+                .control_open_result = -EBADF,
+                .write_length = -EBADF,
+                .write_result = -EBADF,
+                .first.read_length = -EBADF,
+                .first.read_result = -EBADF,
+                .later.read_length = -EBADF,
+                .later.read_result = -EBADF,
+        },
+        .root_cgroup_fd = -EBADF,
+        .root_control_fds = { -EBADF, -EBADF, -EBADF },
+        .root_write_results = { -EBADF, -EBADF, -EBADF },
+        .root_read_results = { -EBADF, -EBADF, -EBADF },
+        .root_write_lengths = { -EBADF, -EBADF, -EBADF },
+        .root_read_lengths = { -EBADF, -EBADF, -EBADF },
+        .root_cgroup_stat_result = -EBADF,
+        .root_cgroup_statfs_result = -EBADF,
+        .root_control_stat_results = { -EBADF, -EBADF, -EBADF },
+        .root_spawn = { .pidfd = -EBADF, .duplicate_pidfd = -EBADF },
+        .root_event_fds = { -EBADF, -EBADF },
+        .root_event_open_results = { -EBADF, -EBADF },
+        .root_event_stat_results = { -EBADF, -EBADF },
+};
+
+static uint64_t policy_u64(const uint8_t *bytes) {
+        uint64_t value = 0;
+
+        for (unsigned i = 0; i < 8; i++)
+                value = (value << 8) | bytes[i];
+        return value;
+}
+
+static int refuse(int error) {
+        assert(error < 0);
+
+        if (enrollment.first_error == 0)
+                enrollment.first_error = error;
+        enrollment.admitted = false;
+        return enrollment.first_error;
+}
+
+static int read_original_policy(void) {
+        uint8_t digest[SHA256_DIGEST_SIZE];
+        struct stat st;
+        struct statfs fs;
+        size_t used = 0;
+
+        if (fstat(enrollment.policy_fd, &st) < 0 ||
+            fstatfs(enrollment.policy_fd, &fs) < 0)
+                return -errno;
+        if (!S_ISREG(st.st_mode) ||
+            (st.st_size != AOS_RESOURCE_POLICY_BYTES && st.st_size != AOS_RESOURCE_HOST_POLICY_BYTES &&
+             st.st_size != AOS_RESOURCE_FIRST_GLOBAL_POLICY_BYTES &&
+             st.st_size != AOS_RESOURCE_NIX_INTAKE_POLICY_BYTES &&
+             st.st_size != AOS_RESOURCE_Q04_INTAKE_POLICY_BYTES &&
+             st.st_size != AOS_RESOURCE_ROOT_POLICY_BYTES) ||
+            st.st_uid != 0 || st.st_gid != 0 || (st.st_mode & 0222) != 0 ||
+            fs.f_type != AOS_RESOURCE_EROFS_MAGIC)
+                return -EPERM;
+
+        enrollment.policy_bytes = st.st_size;
+        while (used < enrollment.policy_bytes) {
+                ssize_t returned = pread(enrollment.policy_fd, enrollment.policy + used,
+                                         enrollment.policy_bytes - used, used);
+                if (returned < 0) {
+                        if (errno == EINTR)
+                                continue;
+                        return -errno;
+                }
+                if (returned == 0)
+                        return -EBADMSG;
+                used += returned;
+        }
+        bool root_receiving = enrollment.policy_bytes == AOS_RESOURCE_ROOT_POLICY_BYTES;
+        bool q04_intake = enrollment.policy_bytes == AOS_RESOURCE_Q04_INTAKE_POLICY_BYTES;
+        bool nix_intake = enrollment.policy_bytes == AOS_RESOURCE_NIX_INTAKE_POLICY_BYTES;
+        bool first_global = enrollment.policy_bytes == AOS_RESOURCE_FIRST_GLOBAL_POLICY_BYTES;
+        bool host_policy = enrollment.policy_bytes == AOS_RESOURCE_HOST_POLICY_BYTES;
+        size_t body_bytes = root_receiving ? AOS_RESOURCE_ROOT_POLICY_BODY :
+                            q04_intake ? AOS_RESOURCE_Q04_INTAKE_POLICY_BODY :
+                            nix_intake ? AOS_RESOURCE_NIX_INTAKE_POLICY_BODY :
+                            first_global ? AOS_RESOURCE_FIRST_GLOBAL_POLICY_BODY :
+                            (host_policy ? AOS_RESOURCE_HOST_POLICY_BODY : AOS_RESOURCE_POLICY_BODY);
+        const char *magic = root_receiving ? "AOSRSB06" : (q04_intake ? "AOSRSB05" : (nix_intake ? "AOSRSB04" :
+                            first_global ? "AOSRSB03" : (host_policy ? "AOSRSB02" : "AOSRSB01")));
+        if (memcmp(enrollment.policy, magic, 8) != 0)
+                return -EBADMSG;
+        sha256_direct(enrollment.policy, body_bytes, digest);
+        if (memcmp(digest, enrollment.policy + body_bytes, sizeof(digest)) != 0)
+                return -EBADMSG;
+
+        /* Image generation checks all 22 rows with explicit finite policy.
+         * PID1 does not implement a second resource arithmetic ledger. This
+         * local job count subdivides the already prepaid component envelope. */
+        enrollment.job_limit = policy_u64(enrollment.policy + AOS_RESOURCE_COMPONENTS_OFFSET +
+                                          AOS_RESOURCE_CONCURRENT_OPERATIONS * 8U);
+        return enrollment.job_limit > 0 ? 0 : -ENODATA;
+}
+
+int aos_resource_enrollment_begin(Manager *manager, bool restoring) {
+        int r;
+
+        assert(manager);
+
+        if (in_initrd() || !aos_network_image_guard_active())
+                return 0;
+        if (enrollment.attempted)
+                return refuse(-EALREADY);
+
+        /* Arm before the first native open. An error retains its descriptor
+         * and original cause; no later trigger retries or manufactures a loan. */
+        enrollment.attempted = true;
+        enrollment.manager = manager;
+        /* The original initrd handoff is the first final-root enrollment,
+         * not a daemon re-exec that has lost its original producer custody. */
+        if (restoring && !MANAGER_IS_SWITCHING_ROOT(manager)) {
+                refuse(-EOWNERDEAD);
+                return 0;
+        }
+        enrollment.policy_fd = aos_resource_open_image_policy();
+        if (enrollment.policy_fd < 0) {
+                refuse(enrollment.policy_fd);
+                return 0;
+        }
+        r = read_original_policy();
+        if (r < 0) {
+                refuse(r);
+                return 0;
+        }
+        r = sd_id128_get_boot(&enrollment.boot);
+        if (r >= 0)
+                r = sd_id128_randomize(&enrollment.invocation);
+        if (r < 0) {
+                refuse(r);
+                return 0;
+        }
+        if (sd_id128_is_null(enrollment.boot) || sd_id128_is_null(enrollment.invocation)) {
+                refuse(-ENODATA);
+                return 0;
+        }
+
+        /* The fixed image policy itself authorizes these two finite trusted
+         * bootstrap envelopes before enumeration, sockets or selected jobs.
+         * Dynamic projects are admitted only by the Rust durable bank. */
+        enrollment.admitted = true;
+        return 0;
+}
+
+static bool host_policy_family(void) {
+        return enrollment.policy_bytes == AOS_RESOURCE_HOST_POLICY_BYTES ||
+               enrollment.policy_bytes == AOS_RESOURCE_FIRST_GLOBAL_POLICY_BYTES ||
+               enrollment.policy_bytes == AOS_RESOURCE_NIX_INTAKE_POLICY_BYTES ||
+               enrollment.policy_bytes == AOS_RESOURCE_Q04_INTAKE_POLICY_BYTES ||
+               enrollment.policy_bytes == AOS_RESOURCE_ROOT_POLICY_BYTES;
+}
+
+static bool controller_prefix_family(void) {
+        return enrollment.policy_bytes == AOS_RESOURCE_FIRST_GLOBAL_POLICY_BYTES ||
+               enrollment.policy_bytes == AOS_RESOURCE_NIX_INTAKE_POLICY_BYTES ||
+               enrollment.policy_bytes == AOS_RESOURCE_Q04_INTAKE_POLICY_BYTES ||
+               enrollment.policy_bytes == AOS_RESOURCE_ROOT_POLICY_BYTES;
+}
+
+bool aos_resource_controller_protected_unit(const Unit *unit) {
+        const char *alias;
+        bool selected = streq_ptr(unit->id, "aos-sandboxd.service");
+
+        SET_FOREACH(alias, unit->aliases)
+                if (streq_ptr(alias, "aos-sandboxd.service"))
+                        selected = true;
+        /* An unavailable original after reexec or failed enrollment refuses
+         * selected commands and overrides instead of entering ordinary mode. */
+        return selected &&
+               (controller_prefix_family() || (enrollment.attempted && !enrollment.admitted)) &&
+               (enrollment.controller_cpu.prepared || aos_network_image_guard_active());
+}
+
+static int controller_cpu_refuse(int error) {
+        AosResourceControllerCPU *original = &enrollment.controller_cpu;
+
+        if (original->first_error == 0)
+                original->first_error = error;
+        return refuse(original->first_error);
+}
+
+/* These kernels share only native control I/O and exact material comparison.
+ * Their callers select policy and retain every descriptor and observation. */
+static int resource_control_readback(
+                int fd,
+                const char *expected,
+                uint8_t *readback,
+                size_t capacity,
+                ssize_t *read_length,
+                int *read_result) {
+        size_t length = strlen(expected);
+        ssize_t returned;
+
+        returned = pread(fd, readback, capacity, 0);
+        *read_length = returned;
+        *read_result = returned < 0 ? -errno :
+                (returned == (ssize_t) length && memcmp(readback, expected, length) == 0 ? 0 : -EPERM);
+        return *read_result;
+}
+
+static int resource_control_install(
+                int fd,
+                const char *expected,
+                ssize_t *write_length,
+                int *write_result) {
+        size_t length = strlen(expected);
+        ssize_t returned;
+
+        returned = write(fd, expected, length);
+        *write_length = returned;
+        *write_result = returned < 0 ? -errno : (returned == (ssize_t) length ? 0 : -EIO);
+        return *write_result;
+}
+
+int aos_resource_prepare_controller_exec(Service *service, ExecCommand *command, ExecFlags flags) {
+        Unit *unit = UNIT(service);
+        AosResourceControllerCPU *original = &enrollment.controller_cpu;
+        const ExecContext *context = &service->exec_context;
+        const CGroupContext *cgroup = &service->cgroup_context;
+        uint64_t cpu = policy_u64(enrollment.policy + AOS_RESOURCE_CONTROLLER_PREFIX_OFFSET);
+
+        if (!aos_resource_controller_protected_unit(unit))
+                return 0;
+        if (original->first_error < 0)
+                return refuse(original->first_error);
+        if (!enrollment.admitted || enrollment.manager != unit->manager ||
+            !controller_prefix_family() || enrollment.policy_fd < 0 ||
+            sd_id128_is_null(enrollment.boot) || sd_id128_is_null(enrollment.invocation) ||
+            sd_id128_is_null(unit->invocation_id) || !streq_ptr(unit->id, "aos-sandboxd.service"))
+                return controller_cpu_refuse(enrollment.first_error < 0 ? enrollment.first_error : -EOWNERDEAD);
+
+        /* Pre-start legitimately precedes main capsule delivery. This distinct
+         * invocation slot cannot prepopulate the main delivery owner. */
+        if (original->prepared) {
+                if (!sd_id128_equal(original->invocation, unit->invocation_id))
+                        return controller_cpu_refuse(-EOWNERDEAD);
+        } else {
+                original->prepared = true;
+                original->invocation = unit->invocation_id;
+        }
+
+        original->fragment_result = aos_resource_verify_component_fragment(unit);
+        if (original->fragment_result < 0)
+                return controller_cpu_refuse(original->fragment_result);
+        /* P constrains CPU only. The image's C memory, tasks and NOFILE remain
+         * authoritative; legitimate sandboxed control commands use this gate. */
+        if (cpu == 0 || cpu % 1000 != 0 || cpu > UINT64_MAX / 10 ||
+            cgroup->cpu_quota_per_sec_usec != cpu * 10 || cgroup->cpu_quota_period_usec != 100000 ||
+            !FLAGS_SET(flags, EXEC_APPLY_SANDBOXING) ||
+            FLAGS_SET(command->flags, EXEC_COMMAND_FULLY_PRIVILEGED) ||
+            service->permissions_start_only || context->pam_name != NULL ||
+            cgroup->delegate || !isempty(cgroup->delegate_subgroup) ||
+            !context->no_new_privileges || context->capability_bounding_set != 0 ||
+            context->capability_ambient_set != 0)
+                return controller_cpu_refuse(-EPERM);
+        return 0;
+}
+
+static int controller_cpu_check(AosResourceControllerCPUCheck *check, CGroupRuntime *runtime) {
+        AosResourceControllerCPU *original = &enrollment.controller_cpu;
+
+        check->cgroup_stat_result = fstat(original->cgroup_fd, &check->cgroup_stat) < 0 ? -errno : 0;
+        check->cgroup_statfs_result = fstatfs(original->cgroup_fd, &check->cgroup_statfs) < 0 ? -errno : 0;
+        /* cg_get_path resolves this fixed hierarchy under /sys/fs/cgroup.
+         * Observe its current inode without reopening or replacing any OFD. */
+        check->current_cgroup_stat_result = fstatat(AT_FDCWD, AOS_RESOURCE_CONTROLLER_CGROUP_FILE,
+                                                   &check->current_cgroup_stat, AT_SYMLINK_NOFOLLOW) < 0 ? -errno : 0;
+        check->control_stat_result = fstat(original->control_fd, &check->control_stat) < 0 ? -errno : 0;
+        check->control_statfs_result = fstatfs(original->control_fd, &check->control_statfs) < 0 ? -errno : 0;
+        check->current_control_stat_result = fstatat(original->cgroup_fd, "cpu.max",
+                                                    &check->current_control_stat, AT_SYMLINK_NOFOLLOW) < 0 ? -errno : 0;
+        if (check->cgroup_stat_result < 0)
+                return check->cgroup_stat_result;
+        if (check->cgroup_statfs_result < 0)
+                return check->cgroup_statfs_result;
+        if (check->current_cgroup_stat_result < 0)
+                return check->current_cgroup_stat_result;
+        if (check->control_stat_result < 0)
+                return check->control_stat_result;
+        if (check->control_statfs_result < 0)
+                return check->control_statfs_result;
+        if (check->current_control_stat_result < 0)
+                return check->current_control_stat_result;
+
+        if (check->cgroup_statfs.f_type != 0x63677270 ||
+            check->control_statfs.f_type != 0x63677270 ||
+            !S_ISDIR(check->cgroup_stat.st_mode) ||
+            check->cgroup_stat.st_uid != 0 || check->cgroup_stat.st_gid != 0 ||
+            !S_ISDIR(check->current_cgroup_stat.st_mode) ||
+            check->current_cgroup_stat.st_uid != 0 || check->current_cgroup_stat.st_gid != 0 ||
+            check->current_cgroup_stat.st_dev != check->cgroup_stat.st_dev ||
+            check->current_cgroup_stat.st_ino != check->cgroup_stat.st_ino ||
+            runtime->cgroup_id == 0 || runtime->cgroup_id != check->cgroup_stat.st_ino ||
+            !S_ISREG(check->control_stat.st_mode) ||
+            check->control_stat.st_uid != 0 || check->control_stat.st_gid != 0 ||
+            check->control_stat.st_dev != check->cgroup_stat.st_dev ||
+            !S_ISREG(check->current_control_stat.st_mode) ||
+            check->current_control_stat.st_uid != 0 || check->current_control_stat.st_gid != 0 ||
+            check->current_control_stat.st_dev != check->control_stat.st_dev ||
+            check->current_control_stat.st_ino != check->control_stat.st_ino)
+                return -EPERM;
+        if (check == &original->later &&
+            (check->cgroup_stat.st_dev != original->first.cgroup_stat.st_dev ||
+             check->cgroup_stat.st_ino != original->first.cgroup_stat.st_ino ||
+             check->control_stat.st_dev != original->first.control_stat.st_dev ||
+             check->control_stat.st_ino != original->first.control_stat.st_ino))
+                return -EOWNERDEAD;
+        return 0;
+}
