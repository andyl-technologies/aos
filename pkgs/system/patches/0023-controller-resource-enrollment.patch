+/* R is the image's once-only subdivision of the existing Components grant.
+ * These fixed owner slots are armed before any Root command can run. A dead
+ * or uncertain invocation cannot receive another envelope by restarting. */
+int aos_resource_prepare_root_exec(Service *service, ExecCommand *command, ExecFlags flags) {
+        const ExecContext *context = &service->exec_context;
+        const CGroupContext *cgroup = &service->cgroup_context;
+        const struct rlimit *nofile = context->rlimit[RLIMIT_NOFILE];
+        const uint8_t *root = enrollment.policy + AOS_RESOURCE_ROOT_OFFSET;
+        uint64_t cpu, memory, tasks, files;
+        int r;
+
+        if (!aos_resource_root_selected_name(UNIT(service)->id))
+                return 0;
+        if (enrollment.root_limits_attempted)
+                return refuse(-EOWNERDEAD);
+        enrollment.root_limits_attempted = true;
+
+        r = aos_resource_verify_component_fragment(UNIT(service));
+        if (r < 0)
+                return refuse(enrollment.root_limit_error = r);
+        cpu = policy_u64(root);
+        memory = policy_u64(root + 8);
+        tasks = policy_u64(root + 16);
+        files = policy_u64(root + 24);
+        if (cpu == 0 || cpu > UINT64_MAX / 10 || memory == 0 || memory % 4096 != 0 ||
+            tasks == 0 || tasks == UINT64_MAX || files < 80 || files >= RLIM_INFINITY ||
+            policy_u64(root + AOS_RESOURCE_CONCURRENT_OPERATIONS * 8U) == 0 ||
+            command != service->exec_command[SERVICE_EXEC_START] ||
+            !FLAGS_SET(flags, EXEC_APPLY_SANDBOXING | EXEC_PASS_FDS) ||
+            FLAGS_SET(flags, EXEC_IS_CONTROL) ||
+            FLAGS_SET(command->flags, EXEC_COMMAND_FULLY_PRIVILEGED) ||
+            context->pam_name != NULL || service->permissions_start_only ||
+            !strv_isempty(context->environment_files) || !strv_isempty(context->pass_environment) ||
+            !strv_isempty(context->exec_search_path) ||
+            !nofile || nofile->rlim_cur != files || nofile->rlim_max != files ||
+            cgroup->memory_max != memory || cgroup->startup_memory_max_set ||
+            cgroup->tasks_max.scale != 0 || cgroup->tasks_max.value != tasks ||
+            cgroup->cpu_quota_per_sec_usec != cpu * 10 ||
+            cgroup->cpu_quota_period_usec != 100000 ||
+            cgroup->delegate || !isempty(cgroup->delegate_subgroup) ||
+            !context->no_new_privileges || context->capability_bounding_set != 0 ||
+            context->capability_ambient_set != 0)
+                return refuse(enrollment.root_limit_error = -EPERM);
+        return 0;
+}
+
+static const char *const root_event_names[2] = { "memory.events", "cgroup.events" };
+
+/* Decode only the two fixed native event fields; preserve the unparsed bytes.
+ * Missing, duplicate, unterminated or overlong fields remain uncertain. */
+static int root_event_value(const uint8_t *bytes, size_t length, const char *key, uint64_t *ret) {
+        size_t key_length = strlen(key);
+        bool found = false;
+
+        if (memchr(bytes, 0, length))
+                return -EBADMSG;
+
+        while (length > 0) {
+                const uint8_t *end = memchr(bytes, '\n', length);
+                size_t line_length;
+                char value[DECIMAL_STR_MAX(uint64_t)];
+                int r;
+
+                if (!end)
+                        return -EBADMSG;
+                line_length = end - bytes;
+                if (line_length > key_length && memcmp(bytes, key, key_length) == 0 && bytes[key_length] == ' ') {
+                        size_t value_length = line_length - key_length - 1;
+
+                        if (found)
+                                return -EBADMSG;
+                        if (value_length == 0)
+                                return -EBADMSG;
+                        if (value_length >= sizeof(value))
+                                return -E2BIG;
+                        for (size_t i = 0; i < value_length; i++)
+                                if (bytes[key_length + 1 + i] < '0' || bytes[key_length + 1 + i] > '9')
+                                        return -EBADMSG;
+                        memcpy(value, bytes + key_length + 1, value_length);
+                        value[value_length] = 0;
+                        r = safe_atou64_full(value, 10, ret);
+                        if (r < 0)
+                                return r;
+                        found = true;
+                }
+
+                bytes = end + 1;
+                length -= line_length + 1;
+        }
+
+        return found ? 0 : -ENXIO;
+}
+
+static int root_observe(AosResourceRootObservation *observation, Unit *unit) {
+        if (observation->attempted)
+                return observation->result;
+        observation->attempted = true;
+
+        if (unit) {
+                CGroupRuntime *runtime = unit_get_cgroup_runtime(unit);
+
+                observation->unit_seen = true;
+                observation->invocation = unit->invocation_id;
+                if (runtime) {
+                        observation->cgroup_id = runtime->cgroup_id;
+                        observation->oom_kill_last = runtime->oom_kill_last;
+                        observation->managed_oom_kill_last = runtime->managed_oom_kill_last;
+                }
+                observation->unit_join_result =
+                        enrollment.manager == unit->manager &&
+                        sd_id128_equal(enrollment.root_invocation, unit->invocation_id) &&
+                        runtime && streq_ptr(runtime->cgroup_path, AOS_RESOURCE_ROOT_CGROUP) &&
+                        runtime->cgroup_id == enrollment.root_cgroup_stat.st_ino ? 0 : -EOWNERDEAD;
+        }
+
+        /* Observe the fixed name on both sides of the reads. All reads use the
+         * original OFDs, even if the name was removed or replaced meanwhile. */
+        observation->named_before_result =
+                fstatat(AT_FDCWD, AOS_RESOURCE_ROOT_CGROUP_FILE,
+                        &observation->named_before, AT_SYMLINK_NOFOLLOW) < 0 ? -errno : 0;
+        for (unsigned i = 0; i < 2; i++) {
+                observation->event_stat_results[i] =
+                        fstatat(enrollment.root_cgroup_fd, root_event_names[i],
+                                &observation->event_stats[i], AT_SYMLINK_NOFOLLOW) < 0 ? -errno : 0;
+                observation->read_lengths[i] =
+                        pread(enrollment.root_event_fds[i], observation->readback[i],
+                              sizeof(observation->readback[i]), 0);
+                observation->read_results[i] = observation->read_lengths[i] < 0 ? -errno :
+                        observation->read_lengths[i] == 0 ? -ENODATA :
+                        observation->read_lengths[i] == (ssize_t) sizeof(observation->readback[i]) ? -E2BIG : 0;
+                observation->parse_results[i] = observation->read_results[i] < 0 ? observation->read_results[i] :
+                        root_event_value(observation->readback[i], observation->read_lengths[i],
+                                         i == 0 ? "oom_kill" : "populated", &observation->event_values[i]);
+                if (i == 1 && observation->parse_results[i] >= 0 && observation->event_values[i] > 1)
+                        observation->parse_results[i] = -EBADMSG;
+                /* Retain this after-read result even when read or decode failed. */
+                observation->event_after_stat_results[i] =
+                        fstatat(enrollment.root_cgroup_fd, root_event_names[i],
+                                &observation->event_after_stats[i], AT_SYMLINK_NOFOLLOW) < 0 ? -errno : 0;
+        }
+        observation->named_after_result =
+                fstatat(AT_FDCWD, AOS_RESOURCE_ROOT_CGROUP_FILE,
+                        &observation->named_after, AT_SYMLINK_NOFOLLOW) < 0 ? -errno : 0;
+
+        observation->identity_result = observation->named_before_result < 0 ? observation->named_before_result :
+                observation->named_after_result;
+        if (observation->identity_result >= 0 &&
+            (!S_ISDIR(observation->named_before.st_mode) ||
+             observation->named_before.st_uid != 0 || observation->named_before.st_gid != 0 ||
+             observation->named_before.st_dev != enrollment.root_cgroup_stat.st_dev ||
+             observation->named_before.st_ino != enrollment.root_cgroup_stat.st_ino ||
+             !S_ISDIR(observation->named_after.st_mode) ||
+             observation->named_after.st_uid != 0 || observation->named_after.st_gid != 0 ||
+             observation->named_after.st_dev != enrollment.root_cgroup_stat.st_dev ||
+             observation->named_after.st_ino != enrollment.root_cgroup_stat.st_ino))
+                observation->identity_result = -EOWNERDEAD;
+
+        for (unsigned i = 0; i < 2; i++) {
+                if (observation->identity_result < 0)
+                        break;
+                if (observation->event_stat_results[i] < 0)
+                        observation->identity_result = observation->event_stat_results[i];
+                else if (observation->event_after_stat_results[i] < 0)
+                        observation->identity_result = observation->event_after_stat_results[i];
+                else if (observation->event_stats[i].st_dev != enrollment.root_event_stats[i].st_dev ||
+                         observation->event_stats[i].st_ino != enrollment.root_event_stats[i].st_ino ||
+                         observation->event_after_stats[i].st_dev != enrollment.root_event_stats[i].st_dev ||
+                         observation->event_after_stats[i].st_ino != enrollment.root_event_stats[i].st_ino)
+                        observation->identity_result = -EOWNERDEAD;
+        }
+
+        observation->result = observation->unit_join_result < 0 ? observation->unit_join_result :
+                observation->identity_result;
+        for (unsigned i = 0; i < 2; i++)
+                if (observation->result >= 0 && observation->parse_results[i] < 0)
+                        observation->result = observation->parse_results[i];
+        return observation->result;
+}
+
+static void root_post_error(int result) {
+        if (result < 0 && enrollment.root_post_error == 0)
+                enrollment.root_post_error = result;
+}
+
+void aos_resource_root_sigchld(Manager *manager, const siginfo_t *si) {
+        siginfo_t original = {};
+        int r;
+
+        if (enrollment.manager != manager || enrollment.root_spawn.pidfd < 0 ||
+            enrollment.root_death_attempted)
+                return;
+
+        /* The manager has not reaped si yet. Query the original clone pidfd,
+         * including when duplicate/PidRef handoff failed and no unit watches it.
+         * An unrelated child or a still-live original supplies no death. */
+        r = waitid(P_PIDFD, enrollment.root_spawn.pidfd, &original, WEXITED | WNOHANG | WNOWAIT) < 0 ? -errno : 0;
+        if (r >= 0 && (original.si_pid == 0 || original.si_pid != si->si_pid))
+                return;
+
+        enrollment.root_death_attempted = true;
+        enrollment.root_child_death = original;
+        enrollment.root_manager_death = *si;
+        enrollment.root_death_wait_result = r;
+        enrollment.root_death_join_result = r < 0 ? r :
+                original.si_code == si->si_code && original.si_status == si->si_status &&
+                IN_SET(original.si_code, CLD_EXITED, CLD_KILLED, CLD_DUMPED) ? 0 : -EOWNERDEAD;
+        root_post_error(enrollment.root_death_join_result);
+        root_post_error(root_observe(&enrollment.root_at_death, NULL));
+}
+
+void aos_resource_root_reaped(Manager *manager, pid_t pid, const siginfo_t *si, int result) {
+        if (enrollment.manager != manager || !enrollment.root_death_attempted ||
+            enrollment.root_death_join_result < 0 || enrollment.root_reap_attempted ||
+            pid != enrollment.root_child_death.si_pid)
+                return;
+
+        enrollment.root_reap_attempted = true;
+        enrollment.root_reaped_death = *si;
+        enrollment.root_reap_result = result;
+        enrollment.root_reap_join_result = result < 0 ? result :
+                si->si_pid == pid && si->si_code == enrollment.root_child_death.si_code &&
+                si->si_status == enrollment.root_child_death.si_status ? 0 : -EOWNERDEAD;
+        root_post_error(enrollment.root_reap_join_result);
+}
+
+void aos_resource_root_oom(Unit *unit, bool managed_oom) {
+        if (!aos_resource_root_protected_unit(unit) || enrollment.manager != unit->manager ||
+            enrollment.root_cgroup_fd < 0)
+                return;
+
+        /* This is the actual native notification, before OOMPolicy= or Service
+         * state can discard it. Kernel and oomd suppliers stay distinct; neither
+         * identifies which individual process the cgroup OOM killed. */
+        root_post_error(root_observe(managed_oom ? &enrollment.root_managed_oom : &enrollment.root_kernel_oom, unit));
+}
+
+void aos_resource_root_before_cleanup(Unit *unit) {
+        if (!aos_resource_root_protected_unit(unit) || enrollment.manager != unit->manager ||
+            enrollment.root_cgroup_fd < 0)
+                return;
+
+        /* Cgroup pruning calls this before trim; unit_free is the fallback
+         * before unit_done or unwatch. Neither resets or closes the original. */
+        root_post_error(root_observe(&enrollment.root_before_cleanup, unit));
+}
