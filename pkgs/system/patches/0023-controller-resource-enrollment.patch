+int aos_resource_open_image_policy(void) {
+        _cleanup_free_ char *top = NULL, *basedir = NULL, *link = NULL, *path = NULL;
+        _cleanup_close_ int fd = -EBADF;
+        struct stat root_st, st;
+        struct statfs fs;
+        struct statvfs vfs;
+        int r;
+
+        if (!aos_network_image_guard_active())
+                return -EPERM;
+        if (stat("/", &root_st) < 0 || statfs("/", &fs) < 0 || statvfs("/", &vfs) < 0)
+                return -errno;
+        if (fs.f_type != EROFS_SUPER_MAGIC_V1 ||
+            !FLAGS_SET(vfs.f_flag, ST_RDONLY | ST_NODEV))
+                return -EPERM;
+        r = aos_network_image_link("/aos-toplevel", NULL, root_st.st_dev, &top);
+        if (r < 0)
+                return r;
+        link = path_join(top, "etc-basedir");
+        if (!link)
+                return -ENOMEM;
+        r = aos_network_image_link(link, NULL, root_st.st_dev, &basedir);
+        if (r < 0)
+                return r;
+        path = path_join(basedir, "aos/resource-bootstrap-v1");
+        if (!path)
+                return -ENOMEM;
+
+        /* Reuse the same no-symlink/no-mount-crossing physical image walk.
+         * The mutable /etc projection cannot enroll a resource bank. */
+        fd = aos_network_open_image_path(path, O_RDONLY | O_NOFOLLOW | O_NOCTTY);
+        if (fd < 0)
+                return fd;
+        if (fstat(fd, &st) < 0)
+                return -errno;
+        if (!S_ISREG(st.st_mode) || st.st_dev != root_st.st_dev ||
+            st.st_uid != 0 || st.st_gid != 0 || (st.st_mode & 0222) != 0)
+                return -EPERM;
+        return TAKE_FD(fd);
+}
