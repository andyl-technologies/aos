--- a/src/basic/process-util.c
+++ b/src/basic/process-util.c
@@ -2129,1 +2129,55 @@
+int posix_spawn_wrapper_fixed_cgroup(
+                const char *path,
+                char * const *argv,
+                char * const *envp,
+                int original_cgroup_fd,
+                FixedCgroupSpawnOriginal *original,
+                PidRef *ret_pidref) {
+        posix_spawnattr_t attr;
+        sigset_t mask;
+
+        assert(path);
+        assert(argv);
+        assert(original);
+        assert(ret_pidref);
+
+        if (original->attempted || original_cgroup_fd < 0)
+                return -EOWNERDEAD;
+        original->attempted = true;
+        original->sigfill_result = sigfillset(&mask) < 0 ? -errno : 0;
+        if (original->sigfill_result < 0)
+                return original->sigfill_result;
+        original->attr_result = posix_spawnattr_init(&attr);
+        if (original->attr_result != 0)
+                return -original->attr_result;
+        _unused_ _cleanup_(posix_spawnattr_destroyp) posix_spawnattr_t *attr_destructor = &attr;
+
+        /* A libc/kernel/privilege refusal occurs before any child runs.
+         * The ordinary wrapper and its fallback remain unchanged. */
+        original->cgroup_result = posix_spawnattr_setcgroup_np(&attr, original_cgroup_fd);
+        if (original->cgroup_result != 0)
+                return -original->cgroup_result;
+        original->flags_result = posix_spawnattr_setflags(&attr, POSIX_SPAWN_SETSIGMASK | POSIX_SPAWN_SETCGROUP);
+        if (original->flags_result != 0)
+                return -original->flags_result;
+        original->mask_result = posix_spawnattr_setsigmask(&attr, &mask);
+        if (original->mask_result != 0)
+                return -original->mask_result;
+
+        original->spawn_result = pidfd_spawn(&original->pidfd, path, NULL, &attr, argv, envp);
+        if (original->spawn_result != 0)
+                return -original->spawn_result;
+        /* Preserve the original pidfd even if its normal unit handoff fails.
+         * A spawned but uncertain child stays charged and cannot be retried. */
+        original->duplicate_pidfd = fcntl(original->pidfd, F_DUPFD_CLOEXEC, 3);
+        if (original->duplicate_pidfd < 0) {
+                original->duplicate_pidfd = -errno;
+                return original->duplicate_pidfd;
+        }
+        original->pidref_result = pidref_set_pidfd_consume(ret_pidref, TAKE_FD(original->duplicate_pidfd));
+        if (original->pidref_result < 0)
+                return original->pidref_result;
+        return 1;
+}
