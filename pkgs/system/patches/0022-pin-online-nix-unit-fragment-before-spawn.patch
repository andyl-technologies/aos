+int aos_network_verify_loaded_fragment(const Unit *u) {
+        if (!aos_network_protected_unit(u))
+                return 0;
+        if (!aos_network_protected_name(u->id))
+                return -EPERM;
+        return aos_verify_loaded_image_fragment(u);
+}
+
+bool aos_nix_protected_name(const char *name) {
+        return streq_ptr(name, "aos-sandbox-nixd.service");
+}
+
+bool aos_nix_protected_unit(const Unit *u) {
+        const char *alias;
+        bool selected = aos_nix_protected_name(u->id);
+
+        /* Selection comes from the actual immutable boot, never a directive,
+         * a serialized positive pin or a removable in-memory role flag. */
+        SET_FOREACH(alias, u->aliases)
+                if (aos_nix_protected_name(alias))
+                        selected = true;
+        return selected && aos_network_image_guard_active();
+}
+
+int aos_nix_verify_loaded_fragment(const Unit *u) {
+        const Service *s;
+        const ExecContext *context;
+        int r;
+
+        if (!aos_nix_protected_unit(u))
+                return 0;
+        if (!aos_nix_protected_name(u->id) || u->type != UNIT_SERVICE)
+                return -EPERM;
+        r = aos_verify_loaded_image_fragment(u);
+        if (r < 0)
+                return r;
+        s = (const Service*) u;
+        context = &s->exec_context;
+        if (!strv_isempty(context->environment_files) ||
+            !strv_isempty(context->pass_environment) ||
+            !strv_isempty(context->exec_search_path))
+                return -EPERM;
+        return 0;
+}
