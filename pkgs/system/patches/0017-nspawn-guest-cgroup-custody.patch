+int aos_guest_cgroup_custody(int provisioning, int ret_fds[2]) {
+        _cleanup_close_ int root = -EBADF, binding = -EBADF, root_copy = -EBADF, binding_copy = -EBADF;
+        struct stat credential, directory;
+        struct statfs filesystem;
+        uint8_t record[AOS_GUEST_CGROUP_CUSTODY_BYTES] = "AOSGCG01";
+        int seals;
+
+        /* This is the already-mounted payload hierarchy after barrier #4,
+         * never the Host's outer cgroup. No broader root is chmod/chowned.
+         * The record joins actual retained inodes, not paths or authority. */
+        root = open("/sys/fs/cgroup", O_RDONLY|O_DIRECTORY|O_NOFOLLOW|O_CLOEXEC);
+        if (root < 0 || fstat(root, &directory) < 0 || fstatfs(root, &filesystem) < 0 ||
+            fstat(provisioning, &credential) < 0)
+                return -errno;
+        if (sizeof(ino_t) != 8 || filesystem.f_type != 0x63677270 ||
+            !S_ISDIR(directory.st_mode) || directory.st_uid != 0 ||
+            (directory.st_mode & 0022) != 0 || directory.st_ino == 0 ||
+            !S_ISREG(credential.st_mode) || credential.st_size != 258)
+                return -EINVAL;
+        seals = fcntl(provisioning, F_GET_SEALS);
+        if (seals < 0)
+                return -errno;
+        if ((seals & (F_SEAL_SEAL|F_SEAL_SHRINK|F_SEAL_GROW|F_SEAL_WRITE)) !=
+            (F_SEAL_SEAL|F_SEAL_SHRINK|F_SEAL_GROW|F_SEAL_WRITE))
+                return -EPERM;
+
+        unaligned_write_be64(record + 8, credential.st_dev);
+        unaligned_write_be64(record + 16, credential.st_ino);
+        unaligned_write_be64(record + 24, credential.st_size);
+        unaligned_write_be64(record + 32, directory.st_dev);
+        unaligned_write_be64(record + 40, directory.st_ino);
+        binding = memfd_new_and_seal("aos-guest-cgroup-custody-v1", record, sizeof(record));
+        if (binding < 0)
+                return binding;
+        /* Sources stay above all five fixed targets during final delivery. */
+        root_copy = fcntl(root, F_DUPFD_CLOEXEC, 16);
+        binding_copy = fcntl(binding, F_DUPFD_CLOEXEC, 16);
+        if (root_copy < 0 || binding_copy < 0)
+                return -errno;
+        ret_fds[0] = TAKE_FD(root_copy);
+        ret_fds[1] = TAKE_FD(binding_copy);
+        return 0;
+}
