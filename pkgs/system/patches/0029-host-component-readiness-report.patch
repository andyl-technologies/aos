+TEST(component_report_kind_is_bound_before_originals) {
+        AosHostReport report = AOS_HOST_REPORT_INIT;
+
+        memcpy(report.challenge, "AOSHCR01", 8);
+        unaligned_write_be16(report.challenge + 8, 1);
+        unaligned_write_be32(report.challenge + 12, sizeof(report.challenge));
+        unaligned_write_be64(report.challenge + 192, UINT64_MAX);
+
+        assert_se(aos_host_report_challenge_is_canonical(&report, sizeof(report.challenge), 0));
+        report.component = true;
+        assert_se(!aos_host_report_challenge_is_canonical(&report, sizeof(report.challenge), 0));
+
+        memcpy(report.challenge, "AOSNHR01", 8);
+        assert_se(aos_host_report_challenge_is_canonical(&report, sizeof(report.challenge), 0));
+        assert_se(!aos_host_report_challenge_is_canonical(&report, sizeof(report.challenge) - 1, 0));
+        assert_se(!aos_host_report_challenge_is_canonical(&report, sizeof(report.challenge), MSG_CTRUNC));
+        report.component = false;
+        assert_se(!aos_host_report_challenge_is_canonical(&report, sizeof(report.challenge), 0));
+}
