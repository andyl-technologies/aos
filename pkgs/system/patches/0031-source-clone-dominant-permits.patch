+static int fdset_network_collector_enter(FDSetNetworkCollectorOriginal *collector, unsigned phase) {
+        assert(collector);
+        if (collector->first_error < 0)
+                return collector->first_error;
+        if (phase >= ELEMENTSOF(collector->entered) || phase != collector->completed || collector->entered[phase])
+                return collector->first_error = -EALREADY;
+        collector->entered[phase] = true;
+        if (phase == 0) {
+                collector->directory = opendir("/proc/self/fd");
+                collector->open_result = collector->directory ? 0 : -errno;
+                return collector->open_result;
