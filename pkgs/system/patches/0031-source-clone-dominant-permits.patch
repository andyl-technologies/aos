+        else if (collector->filesystem_after_results[phase] < 0)
+                first = collector->filesystem_after_results[phase];
+        else if (collector->named_after_results[phase] < 0)
+                first = collector->named_after_results[phase];
+        else if (!S_ISDIR(collector->after[phase].st_mode) || collector->after[phase].st_uid != geteuid() ||
+                 collector->after[phase].st_gid != getegid() || collector->filesystem_after[phase].f_type != PROC_SUPER_MAGIC ||
