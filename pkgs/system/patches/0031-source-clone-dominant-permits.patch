+/* Conservative byte permits for the dominant private clone buffers. These
+ * target-kernel DATA describe the selected ABI, not exact SLUB occupancy or
+ * global kernel overhead. RFC06 decoder and real M/service cgroups remain
+ * backstops. This helper selects no account and performs no Native IO. */
+static int kernel_clone_add(size_t a, size_t b, size_t *ret) {
+        if (a > SIZE_MAX - b)
+                return -EOVERFLOW;
+        *ret = a + b;
+        return 0;
+}
+
+static int kernel_clone_mul(size_t a, size_t b, size_t *ret) {
+        if (b > 0 && a > SIZE_MAX / b)
+                return -EOVERFLOW;
+        *ret = a * b;
+        return 0;
+}
+
+static int kernel_clone_power_of_two(size_t value, size_t *ret) {
+        size_t result = 1;
+        while (result < value) {
+                if (result > SIZE_MAX / 2U)
+                        return -EOVERFLOW;
+                result *= 2U;
+        }
+        *ret = result;
+        return 0;
+}
+
+static int kernel_clone_page_permit(size_t bytes, size_t *ret) {
+        size_t page = AOS_KERNEL_CLONE_V1_PAGE_BYTES, rounded;
+        int r;
+
+        if (page == 0 || (page & (page - 1U)) != 0)
+                return -EBADMSG;
+        r = kernel_clone_add(bytes, page - 1U, &rounded);
+        if (r < 0)
+                return r;
+        *ret = rounded & ~(page - 1U);
+        return 0;
+}
+
+/* A power-of-two backing ceiling covers both the selected kmalloc class and
+ * the page-rounded fallback for these bounded dominant objects. */
+static int kernel_clone_object_permit(size_t bytes, size_t *ret) {
+        size_t backing;
+        int r = kernel_clone_power_of_two(bytes, &backing);
+
+        return r < 0 ? r : kernel_clone_page_permit(backing, ret);
+}
+
+static int kernel_clone_fdtable_permit(uint64_t highest, size_t *ret) {
+        size_t wanted, slots, array, bitmap, bitbit_longs, part, total;
+        int r;
+
+        if (highest >= SIZE_MAX)
+                return -EOVERFLOW;
+        r = kernel_clone_object_permit(AOS_KERNEL_CLONE_V1_FILES_STRUCT_BYTES, &total);
