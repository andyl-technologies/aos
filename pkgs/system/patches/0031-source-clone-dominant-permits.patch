+        collector->stat_before_results[phase] = fstat(fd, &collector->before[phase]) < 0 ? -errno : 0;
+        collector->filesystem_before_results[phase] = fstatfs(fd, &collector->filesystem_before[phase]) < 0 ? -errno : 0;
+        if (collector->stat_before_results[phase] < 0)
+                first = collector->stat_before_results[phase];
+        else if (collector->filesystem_before_results[phase] < 0)
+                first = collector->filesystem_before_results[phase];
+        else if (!S_ISDIR(collector->before[phase].st_mode) || collector->before[phase].st_uid != geteuid() ||
