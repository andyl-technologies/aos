+ * the native collector owner itself is included by the source's sizeof bill. */
+size_t fdset_network_collector_header_memory(void) {
+        return sizeof(pthread_mutex_t) + 2U * sizeof(int) + 3U * sizeof(size_t) +
+               sizeof(off_t) + 2U * sizeof(max_align_t) + sizeof(struct stat);
