+/* All reached posts are independent, including after an earlier parent or
+ * primary error. This observes custody; it does not re-admit a failed sender. */
+static int network_child_native_post(AosNetworkWorkerOriginal *worker, bool child, bool executable,
+                                      AosNetworkChildNativePost *post) {
+        AosSourceOrigin *origin = &enrollment.network_origin;
+        Service *source = origin->transport.unit ? SERVICE(origin->transport.unit) : NULL;
+        Service *recipient = UNIT_ISSET(worker->worker) ? SERVICE(UNIT_DEREF(worker->worker)) : NULL;
+        CGroupRuntime *source_runtime = source ? unit_get_cgroup_runtime(UNIT(source)) : NULL;
+        CGroupRuntime *worker_runtime = recipient ? unit_get_cgroup_runtime(UNIT(recipient)) : NULL;
+        int first = 0;
+
+        if (post->entered)
+                return -EALREADY;
+        post->entered = true;
+        if (source) {
+                post->source_main_pid = source->main_pid.pid;
+                post->source_state = source->state;
+                post->source_main_known = source->main_pid_known;
+                post->source_main_alien = source->main_pid_alien;
+                post->source_main_command = source->main_command;
+                post->source_configured_command = source->exec_command[SERVICE_EXEC_START];
+                post->source_observed_unit = manager_get_unit_by_pidref_cgroup(
+                        enrollment.manager, &origin->transport.recipient);
+        }
+        post->source_fields_result = source && network_worker_source(enrollment.manager) == source &&
+                UNIT_ISSET(worker->source) && UNIT_DEREF(worker->source) == UNIT(source) &&
+                sd_id128_equal(worker->source_invocation, UNIT(source)->invocation_id) &&
+                source_runtime && source_runtime->cgroup_id == origin->exec_claim.cgroup_id &&
+                post->source_main_known && !post->source_main_alien &&
+                post->source_main_pid == origin->transport.recipient.pid &&
+                IN_SET(post->source_state, SERVICE_START, SERVICE_RUNNING) &&
+                post->source_main_command == origin->transport.main_command &&
+                post->source_main_command == post->source_configured_command &&
+                post->source_main_command && !post->source_main_command->command_next &&
+                post->source_observed_unit == UNIT(source) ? 0 : -EOWNERDEAD;
+        post->source_verify_before = pidref_verify(&origin->transport.recipient);
+        post->source_executable_result = network_child_executable_current(&origin->transport.recipient,
+                &origin->proc_executable_stat, &post->source_executable);
+        post->source_controls_result = source ?
+                aos_resource_parent_source_clone_post(source, &origin->exec_claim, &post->source_controls) : -EOWNERDEAD;
+        post->aggregate_controls_result = source ?
+                aos_resource_parent_network_aggregate_post(source, &origin->exec_claim,
+                        &enrollment.network_child_source.aggregate, &post->aggregate_controls) : -EOWNERDEAD;
+
+        if (child) {
+                post->worker_observed_unit = manager_get_unit_by_pidref_cgroup(
+                        enrollment.manager, &worker->child.transport.recipient);
+                post->worker_fields_result = recipient && worker->child.transport.unit == UNIT(recipient) &&
+                        sd_id128_equal(worker->worker_invocation, UNIT(recipient)->invocation_id) &&
+                        worker_runtime && worker_runtime->cgroup_id == worker->cgroup_id &&
+                        post->worker_observed_unit == UNIT(recipient) ? 0 : -EOWNERDEAD;
+                post->worker_verify_before = pidref_verify(&worker->child.transport.recipient);
+                post->worker_controls_result = network_child_worker_controls(worker, &post->worker_controls);
+                if (executable)
+                        post->worker_executable_result = network_child_executable_current(
+                                &worker->child.transport.recipient, &worker->child.executable_stat,
+                                &post->worker_executable);
+                post->worker_verify_after = pidref_verify(&worker->child.transport.recipient);
+        }
+        post->source_verify_after = pidref_verify(&origin->transport.recipient);
+        /* Financial and native observations are independently owed. A prior
+         * physical failure cannot skip the same sender-account post. */
+        post->source_financial_result = source ? aos_resource_parent_require_source_sender(source) : -EOWNERDEAD;
+
+        const int results[] = {
+                post->source_fields_result, post->source_financial_result, post->source_verify_before, post->source_executable_result,
+                post->source_controls_result, post->aggregate_controls_result,
+                post->worker_fields_result, post->worker_verify_before, post->worker_controls_result,
+                post->worker_executable_result, post->worker_verify_after, post->source_verify_after,
+        };
+        FOREACH_ELEMENT(result, results)
+                if (first == 0 && *result < 0)
+                        first = *result;
+        post->result = first;
+        return first;
+}
+
+static int network_child_disable_event(sd_event_source *event, bool *entered, int *result) {
+        if (*entered)
+                return *result;
+        *entered = true;
+        return *result = event ? sd_event_source_set_enabled(event, SD_EVENT_OFF) : 0;
+}
+
+static int network_child_stop_event(AosNetworkWorkerOriginal *worker, sd_event_source *event) {
+        AosNetworkChildOriginal *child = &worker->child;
+        int first = network_child_disable_event(event, &child->event_disabled, &child->event_disable_result);
+
+        if (!child->event_stop_after.entered) {
+                int after = network_child_native_post(worker, false, false, &child->event_stop_after);
+                if (first == 0 && after < 0)
+                        first = after;
+        }
+        return first < 0 ? network_child_refuse(worker, first) : 0;
+}
+
+static int network_child_stop_source_event(sd_event_source *event) {
+        AosNetworkChildSourceOriginal *owner = &enrollment.network_child_source;
+        int first = network_child_disable_event(event, &owner->event_disabled, &owner->event_disable_result);
+
+        if (!owner->event_stop_after.entered) {
+                AosNetworkChildProgrammeOriginal *programme = owner->active;
+                int after = programme ? network_child_native_post(
+                        &programme->workers[MIN(programme->phase / 3U, 1U)],
+                        false, false, &owner->event_stop_after) : -EOWNERDEAD;
+                if (first == 0 && after < 0)
+                        first = after;
+        }
+        if (first < 0) {
+                if (owner->first_error == 0)
+                        owner->first_error = first;
+                return aos_resource_parent_fail(owner->first_error);
+        }
+        return 0;
+}
+
+static int network_child_probe_io(sd_event_source *event, int fd, uint32_t revents, void *userdata) {
+        AosNetworkWorkerOriginal *worker = userdata;
+        AosNetworkChildOriginal *child = &worker->child;
+        _cleanup_(allocation_account_leave) AllocationAccountScope scope = {};
+        int first = 0;
+
+        if (child->first_error < 0 || !child->bootstrap_delivered || child->probe_count == child->probe_limit) {
+                (void) network_child_stop_event(worker, event);
+                return 0;
+        }
+        AosNetworkChildProbeOriginal *probe = &child->probes[child->probe_count++];
+        probe->entered = true;
+        first = aos_resource_parent_source_exec_scope(SERVICE(UNIT_DEREF(worker->source)), &scope);
+        int before = network_child_native_post(worker, false, false, &probe->source_before);
+        if (first == 0 && before < 0)
+                first = before;
+        if (first == 0) {
+                /* A closed endpoint grants no currentness and no retirement.
+                 * Peek before child-liveness checks so ordinary post-exit EOF
+                 * cannot poison an independently live Netd Source. */
+                probe->peek_length = recv(fd, &probe->peek_byte, 1, MSG_PEEK | MSG_DONTWAIT);
+                probe->peek_result = probe->peek_length < 0 ? -errno : 0;
+                if (probe->peek_result < 0)
+                        first = probe->peek_result;
+                else
+                        probe->endpoint_eof = probe->peek_length == 0;
+        }
+        if (first == 0 && !probe->endpoint_eof)
+                first = network_child_native_post(worker, true, true, &probe->before);
+
+        struct iovec iov = { .iov_base = probe->request, .iov_len = sizeof(probe->request) };
+        /* Ancillary reception is disabled on this original endpoint before
+         * handoff. No descriptor can be installed by a malformed probe. */
+        struct msghdr message = { .msg_iov = &iov, .msg_iovlen = 1 };
+        if (first == 0 && !probe->endpoint_eof) {
+                probe->receive_length = recvmsg(fd, &message, MSG_DONTWAIT | MSG_CMSG_CLOEXEC);
+                probe->receive_result = probe->receive_length < 0 ? -errno : 0;
+                probe->flags = message.msg_flags;
+        } else if (!probe->endpoint_eof)
+                probe->receive_result = first;
+        if (first == 0 && probe->receive_result < 0)
+                first = probe->receive_result;
+        probe->packet_result = probe->endpoint_eof ? 0 : probe->receive_result == 0 &&
+                (probe->flags & (MSG_TRUNC | MSG_CTRUNC)) == 0 &&
+                network_child_header(probe->request, probe->receive_length, "AOSNFP02",
+                        worker->purpose + 1U, AOS_NETWORK_CHILD_PROBE_BYTES) &&
+                memcmp(probe->request + 16, child->challenge.bytes, 16) == 0 &&
+                memcmp(probe->request + 32, worker->worker_invocation.bytes, 16) == 0 &&
+                policy_u64(probe->request + 48) == child->probe_count &&
+                policy_u64(probe->request + 56) == 0 ? 0 : -EBADMSG;
+        if (first == 0 && !probe->endpoint_eof && probe->packet_result < 0)
+                first = probe->packet_result;
+        int after = network_child_native_post(worker, probe->before.entered, probe->before.entered, &probe->after);
+        if (first == 0 && after < 0)
+                first = after;
+        probe->first_error = first;
+        if (probe->endpoint_eof && first == 0) {
+                child->endpoint_closed = true;
+                (void) network_child_stop_event(worker, event);
+                return 0;
+        }
+
+        network_child_write_header(probe->response, "AOSNFQ02", worker->purpose + 1U, sizeof(probe->response));
+        memcpy(probe->response + 16, child->challenge.bytes, 16);
+        memcpy(probe->response + 32, worker->worker_invocation.bytes, 16);
+        unaligned_write_be64(probe->response + 48, child->probe_count);
+        memcpy(probe->response + 56, child->request_digest, 32);
+        memcpy(probe->response + 88, worker->source_invocation.bytes, 16);
+        memcpy(probe->response + 104, enrollment.boot.bytes, 16);
+        unaligned_write_be32(probe->response + 120, (uint32_t) first);
+        probe->send_length = send(fd, probe->response, sizeof(probe->response), MSG_DONTWAIT | MSG_NOSIGNAL);
+        probe->send_result = probe->send_length < 0 ? -errno :
+                probe->send_length == sizeof(probe->response) ? 0 : -EIO;
+        if (first == 0 && probe->send_result < 0)
+                first = probe->send_result;
+        after = network_child_native_post(worker, true, true, &probe->send_after);
+        if (first == 0 && after < 0)
+                first = after;
+        probe->first_error = first;
+        if (first < 0) {
+                (void) network_child_refuse(worker, first);
+                (void) network_child_stop_event(worker, event);
+        } else if (child->probe_count == child->probe_limit)
+                (void) network_child_stop_event(worker, event);
+        return 0;
+}
+
+/* Fee is additional retained liability on the same original F, not another
+ * full resource envelope. CPU and the one active operation are already paid. */
+static int network_child_request_validate(AosNetworkWorkerOriginal *worker, const uint8_t *bytes,
+                                           size_t length) {
+        const AosSourceOrigin *source = &enrollment.network_origin;
+        const uint8_t *ceiling = source->exec_claim.vector;
+        AosNetworkChildProgrammeOriginal *programme = worker->programme;
+        const uint8_t *prior = worker->purpose == 1 ? programme->requests[0].record.payload :
+                programme->previous ? programme->previous->requests[1].record.payload : NULL;
+        uint64_t probes;
+
+        if (!network_child_header(bytes, length, "AOSNFR02", worker->purpose + 1U,
+                AOS_NETWORK_CHILD_REQUEST_BYTES) ||
+            memcmp(bytes + 16, enrollment.boot.bytes, 16) != 0 ||
+            memcmp(bytes + 32, source->transport.invocation.bytes, 16) != 0 ||
+            memcmp(bytes + 48, source->exec_claim.parent_digest, 32) != 0 ||
+            memcmp(bytes + 80, (uint8_t[16]) {}, 16) == 0 ||
+            memcmp(bytes + 96, (uint8_t[32]) {}, 32) == 0 || policy_u64(bytes + 128) == 0)
+                return -EBADMSG;
+        probes = policy_u64(bytes + 136);
+        if (probes == 0 || probes > SIZE_MAX / sizeof(AosNetworkChildProbeOriginal))
+                return -EOVERFLOW;
+        if (policy_u64(bytes + 144) != 0 || policy_u64(bytes + 144 + 21U * 8U) != 0 ||
+            policy_u64(bytes + 320) != policy_u64(ceiling) ||
+            policy_u64(bytes + 320 + 21U * 8U) != 1 ||
+            policy_u64(bytes + 144 + 8) == 0 || policy_u64(bytes + 144 + 16) == 0 ||
+            policy_u64(bytes + 144 + 24) == 0)
+                return -EBADMSG;
+        for (unsigned dimension = 0; dimension < 22; dimension++) {
+                uint64_t fee = policy_u64(bytes + 144 + 8U * dimension);
+                uint64_t baseline = policy_u64(bytes + 320 + 8U * dimension);
+                uint64_t total = policy_u64(ceiling + 8U * dimension);
+                uint64_t persistent = policy_u64(source->completion.payload + 128 + 8U * dimension);
+                if (baseline < persistent || baseline > total || fee > total - baseline)
+                        return -ENOSPC;
+                if (prior) {
+                        uint64_t prior_fee = policy_u64(prior + 144 + 8U * dimension);
+                        uint64_t prior_baseline = policy_u64(prior + 320 + 8U * dimension);
+                        if (prior_baseline > total || prior_fee > total - prior_baseline ||
+                            baseline < prior_baseline + prior_fee)
+                                return -ENOSPC;
+                }
+        }
+        worker->child.probe_limit = (size_t) probes;
+        worker->child.probes_memory = (size_t) probes * sizeof(AosNetworkChildProbeOriginal);
+        return 0;
+}
+
+static int network_child_prebirth_io(sd_event_source *event, int fd, uint32_t revents, void *userdata) {
+        AosNetworkChildSourceOriginal *owner = &enrollment.network_child_source;
+        AosSourceOrigin *source = &enrollment.network_origin;
+        _cleanup_(allocation_account_leave) AllocationAccountScope scope = {};
+        Unit *root_scope;
+        int first;
+
+        AosNetworkChildProgrammeOriginal *programme = owner->active;
+        if (owner->first_error < 0 || !programme ||
+            programme->requests_entered == ELEMENTSOF(programme->requests) ||
+            programme->phase != 3U * programme->requests_entered) {
+                (void) network_child_stop_source_event(event);
+                return 0;
+        }
+        unsigned index = programme->requests_entered++;
+        AosNetworkChildRequestOriginal *request = &programme->requests[index];
+        AosNetworkWorkerOriginal *worker = &programme->workers[index];
+        AosNetworkChildOriginal *child = &worker->child;
+        unsigned purpose = index + 1U;
+        AosLaunchRecord *native = &request->record.native;
+        uint8_t *bytes = request->record.payload;
+        first = aos_resource_parent_source_exec_scope(SERVICE(source->transport.unit), &scope);
+        root_scope = manager_get_unit(enrollment.manager, "init.scope");
+        if (first == 0 && (!root_scope || child->requested || worker->entered))
+                first = -EOWNERDEAD;
+        if (first < 0)
+                goto refused;
+        child->requested = true;
+        child->request_index = index;
+        worker->purpose = index;
+        worker->source_invocation = source->transport.invocation;
+        unit_ref_set(&worker->source, root_scope, source->transport.unit);
+        first = network_child_native_post(worker, false, false, &request->before);
+        if (first == 0)
+                first = aos_launch_record_receive_network_borrow_once(&request->record, fd);
+        if (first == 0 && (native->malformed || native->length != AOS_NETWORK_CHILD_REQUEST_BYTES ||
+            (native->flags & (MSG_TRUNC | MSG_CTRUNC)) != 0 || native->rights_count != 0 ||
+            native->credential_count != 1 || native->pidfd_count != 1 || native->descriptor_count != 1 ||
+            native->kernel_pidfd < 0 || native->credentials.pid != source->transport.recipient.pid ||
+            native->credentials.uid != 0 || native->credentials.gid != 0 || bytes[10] != purpose))
+                first = -EBADMSG;
+        if (first == 0) {
+                request->source_pidfd_result = fstat(native->kernel_pidfd, &request->source_pidfd) < 0 ? -errno : 0;
+                request->validation_result = network_child_request_validate(worker, bytes, native->length);
+                if (request->validation_result == 0 && index == 1 &&
+                    memcmp(bytes + 80, programme->requests[0].record.payload + 80, 56) != 0)
+                        request->validation_result = -EOWNERDEAD;
+                if (request->validation_result == 0 && index == 0 &&
+                    policy_u64(bytes + 128) <= programme->ordinal)
+                        request->validation_result = -EOWNERDEAD;
+                if (request->validation_result == 0 && index == 0)
+                        programme->ordinal = policy_u64(bytes + 128);
+                if (request->source_pidfd_result == 0 &&
+                    (request->source_pidfd.st_dev != source->clone_stat.st_dev ||
+                     request->source_pidfd.st_ino != source->clone_stat.st_ino))
+                        request->source_pidfd_result = -EOWNERDEAD;
+                if (request->source_pidfd_result < 0)
+                        first = request->source_pidfd_result;
+                else if (request->validation_result < 0)
+                        first = request->validation_result;
+        }
+        if (first == 0) {
+                /* The account debits bytes before libc is entered. A failed
+                 * allocation retains that spent debit and the request. */
+                child->probes = allocation_account_calloc(child->probe_limit, sizeof(*child->probes));
+                child->probes_allocation_result = child->probes ? 0 : -ENOMEM;
+                if (child->probes_allocation_result < 0)
+                        first = child->probes_allocation_result;
+        }
+        if (first == 0) {
+                child->challenge_result = sd_id128_randomize(&child->challenge);
+                if (child->challenge_result < 0)
+                        first = child->challenge_result;
+                else
+                        sha256_direct(bytes, AOS_NETWORK_CHILD_REQUEST_BYTES, child->request_digest);
+        }
+        int after = network_child_native_post(worker, false, false, &request->after);
+        if (first == 0 && after < 0)
+                first = after;
+        if (first < 0) {
+                (void) network_child_refuse(worker, first);
+                goto refused;
+        }
+
+        network_child_write_header(child->prepared_bytes, "AOSNFA02", purpose, sizeof(child->prepared_bytes));
+        memcpy(child->prepared_bytes + 16, enrollment.boot.bytes, 16);
+        memcpy(child->prepared_bytes + 32, worker->source_invocation.bytes, 16);
+        memcpy(child->prepared_bytes + 48, bytes + 80, 16);
+        memcpy(child->prepared_bytes + 64, child->request_digest, 32);
+        memcpy(child->prepared_bytes + 96, child->challenge.bytes, 16);
+        unaligned_write_be64(child->prepared_bytes + 112, source->exec_claim.cgroup_id);
+        unaligned_write_be64(child->prepared_bytes + 120, source->transport.recipient.pid);
+        unaligned_write_be64(child->prepared_bytes + 128, source->process_start[0]);
+        child->prepared_length = send(fd, child->prepared_bytes, sizeof(child->prepared_bytes),
+                MSG_DONTWAIT | MSG_NOSIGNAL);
+        child->prepared_send_result = child->prepared_length < 0 ? -errno :
+                child->prepared_length == sizeof(child->prepared_bytes) ? 0 : -EIO;
+        int sent_after = network_child_native_post(worker, false, false, &child->prepared_after);
+        first = child->prepared_send_result < 0 ? child->prepared_send_result : sent_after;
+        if (first < 0) {
+                (void) network_child_refuse(worker, first);
+                goto refused;
+        }
+        child->prepared = true;
+        programme->phase++;
+        return 0;
+
+refused:
+        if (owner->first_error == 0)
+                owner->first_error = first;
+        (void) aos_resource_parent_fail(owner->first_error);
+        (void) network_child_stop_source_event(event);
+        return 0;
+}
+
+static int network_child_send_bootstrap(AosNetworkWorkerOriginal *worker);
+
+static int network_child_arm_io(sd_event_source *event, int fd, uint32_t revents, void *userdata) {
+        AosNetworkChildSourceOriginal *owner = &enrollment.network_child_source;
+        AosSourceOrigin *source = &enrollment.network_origin;
+        _cleanup_(allocation_account_leave) AllocationAccountScope scope = {};
+        AosNetworkChildProgrammeOriginal *programme = owner->active;
+        int first;
+
+        if (!programme || programme->phase >= 6 || programme->phase % 3U != 1)
+                return aos_resource_parent_fail(-EOWNERDEAD);
+        unsigned index = programme->phase / 3U;
+        AosNetworkWorkerOriginal *worker = &programme->workers[index];
+        AosNetworkChildOriginal *child = &worker->child;
+        AosNetworkChildRequestOriginal *arm = &programme->arms[index];
+        first = aos_resource_parent_source_exec_scope(SERVICE(source->transport.unit), &scope);
+        if (first == 0 && (!child->birth_delivered || child->armed || child->first_error < 0))
+                first = -EOWNERDEAD;
+        if (first < 0)
+                goto refused;
+        first = network_child_native_post(worker, true, false, &arm->before);
+        if (first == 0)
+                first = aos_launch_record_receive_network_borrow_once(&arm->record, fd);
+        AosLaunchRecord *native = &arm->record.native;
+        uint8_t *bytes = arm->record.payload;
+        if (first == 0 && (native->malformed ||
+            !network_child_header(bytes, native->length, "AOSNFJ02", index + 1U, AOS_NETWORK_CHILD_ARM_BYTES) ||
+            (native->flags & (MSG_TRUNC | MSG_CTRUNC)) != 0 || native->rights_count != 0 ||
+            native->credential_count != 1 || native->pidfd_count != 1 || native->descriptor_count != 1 ||
+            native->kernel_pidfd < 0 || native->credentials.pid != source->transport.recipient.pid ||
+            native->credentials.uid != 0 || native->credentials.gid != 0 ||
+            memcmp(bytes + 16, child->birth_bytes + 16, AOS_NETWORK_CHILD_ARM_BYTES - 16U) != 0))
+                first = -EBADMSG;
+        arm->validation_result = first;
+        if (first == 0) {
+                arm->source_pidfd_result = fstat(native->kernel_pidfd, &arm->source_pidfd) < 0 ? -errno : 0;
+                if (arm->source_pidfd_result == 0 &&
+                    (arm->source_pidfd.st_dev != source->clone_stat.st_dev ||
+                     arm->source_pidfd.st_ino != source->clone_stat.st_ino))
+                        arm->source_pidfd_result = -EOWNERDEAD;
+                if (arm->source_pidfd_result < 0)
+                        first = arm->source_pidfd_result;
+        }
+        int after = network_child_native_post(worker, true, false, &arm->after);
+        if (first == 0 && after < 0)
+                first = after;
+        if (first < 0)
+                goto refused;
+
+        child->armed = true;
+        programme->phase++;
+        first = network_child_send_bootstrap(worker);
+        if (first < 0)
+                goto refused;
+        return 0;
+
+refused:
+        if (owner->first_error == 0)
+                owner->first_error = first;
+        (void) network_child_refuse(worker, first);
+        (void) network_child_stop_source_event(event);
+        return 0;
+}
+
+/* Each physical identity and both zero-time death polls are retained even
+ * when the authenticated trigger or another independent observation fails.
+ * An unlinked cgroup need not still have its old pathname. */
+static int network_child_terminal_identity(AosNetworkWorkerOriginal *worker,
+                                            AosNetworkChildTerminalOriginal *terminal, unsigned side) {
+        AosNetworkChildOriginal *child = &worker->child;
+        int first = 0;
+
+        terminal->pidfd_results[side] = fstat(worker->clone.pidfd, &terminal->pidfd_stats[side]) < 0 ? -errno : 0;
+        terminal->recipient_results[side] = fstat(child->transport.recipient.fd, &terminal->recipient_stats[side]) < 0 ? -errno : 0;
+        terminal->cgroup_results[side] = fstat(worker->cgroup_fd, &terminal->cgroup_stats[side]) < 0 ? -errno : 0;
+        terminal->event_results[side] = fstat(child->event_fd, &terminal->event_stats[side]) < 0 ? -errno : 0;
+        const int results[] = {
+                terminal->pidfd_results[side], terminal->recipient_results[side],
+                terminal->cgroup_results[side], terminal->event_results[side],
+        };
+        FOREACH_ELEMENT(result, results)
+                if (first == 0 && *result < 0)
+                        first = *result;
+        if (first == 0 && (terminal->pidfd_stats[side].st_dev != terminal->recipient_stats[side].st_dev ||
+            terminal->pidfd_stats[side].st_ino != terminal->recipient_stats[side].st_ino ||
+            terminal->cgroup_stats[side].st_dev != worker->cgroup_stat.st_dev ||
+            terminal->cgroup_stats[side].st_ino != worker->cgroup_stat.st_ino ||
+            terminal->event_stats[side].st_dev != child->event_stat.st_dev ||
+            terminal->event_stats[side].st_ino != child->event_stat.st_ino ||
+            (side > 0 && (terminal->pidfd_stats[side].st_dev != terminal->pidfd_stats[0].st_dev ||
+                          terminal->pidfd_stats[side].st_ino != terminal->pidfd_stats[0].st_ino))))
+                first = -EOWNERDEAD;
+        terminal->identity_results[side] = first;
+
+        terminal->death[side] = (struct pollfd) { .fd = worker->clone.pidfd, .events = POLLIN };
+        terminal->death_returned[side] = poll(&terminal->death[side], 1, 0);
+        terminal->death_native_results[side] = terminal->death_returned[side] < 0 ? -errno : 0;
+        terminal->death_results[side] = terminal->death_native_results[side] < 0 ? terminal->death_native_results[side] :
+                terminal->death_returned[side] == 1 && (terminal->death[side].revents & POLLIN) != 0 &&
+                (terminal->death[side].revents & (POLLERR | POLLNVAL)) == 0 ? 0 : -EBUSY;
+        return first < 0 ? first : terminal->death_results[side];
+}
+
+/* Match the existing held-events observation law: only the actual ENODEV
+ * read result means Retired. Missing names, EOF and truncated bytes do not. */
+static int network_child_terminal_population(AosNetworkWorkerOriginal *worker,
+                                              AosNetworkChildTerminalOriginal *terminal) {
+        terminal->population_length = pread(worker->child.event_fd, terminal->population_bytes,
+                sizeof(terminal->population_bytes), 0);
+        terminal->population_read_result = terminal->population_length < 0 ? -errno : 0;
+        if (terminal->population_read_result == -ENODEV) {
+                terminal->retired = true;
+                return terminal->population_result = 0;
+        }
+        if (terminal->population_read_result < 0)
+                return terminal->population_result = terminal->population_read_result;
+        if (terminal->population_length <= 0 ||
+            terminal->population_length >= (ssize_t) sizeof(terminal->population_bytes))
+                return terminal->population_result = -EBADMSG;
+
+        size_t offset = 0, length = (size_t) terminal->population_length;
+        while (offset < length) {
+                uint8_t *line = terminal->population_bytes + offset;
+                uint8_t *end = memchr(line, '\n', length - offset);
+                size_t count = end ? (size_t) (end - line) : length - offset;
+
+                if (count >= STRLEN("populated ") && memcmp(line, "populated ", STRLEN("populated ")) == 0) {
+                        if (count != STRLEN("populated 0") || !IN_SET(line[count - 1U], '0', '1'))
+                                return terminal->population_result = -EBADMSG;
+                        terminal->empty = line[count - 1U] == '0';
+                        return terminal->population_result = terminal->empty ? 0 : -EBUSY;
+                }
+                offset += count + (end ? 1U : 0U);
+        }
+        return terminal->population_result = -EBADMSG;
+}
+
+static int network_child_terminal_io(sd_event_source *event, int fd, uint32_t revents, void *userdata) {
+        AosNetworkChildSourceOriginal *owner = &enrollment.network_child_source;
+        AosNetworkChildProgrammeOriginal *programme = owner->active;
+        AosSourceOrigin *source = &enrollment.network_origin;
+        _cleanup_(allocation_account_leave) AllocationAccountScope scope = {};
+
+        if (!programme || programme->phase >= 6 || programme->phase % 3U != 2)
+                return aos_resource_parent_fail(-EOWNERDEAD);
+        unsigned index = programme->phase / 3U;
+        AosNetworkWorkerOriginal *worker = &programme->workers[index];
+        AosNetworkChildOriginal *child = &worker->child;
+        AosNetworkChildTerminalOriginal *terminal = &programme->terminals[index];
+        AosNetworkChildRequestOriginal *request = &terminal->request;
+        int first = aos_resource_parent_source_exec_scope(SERVICE(source->transport.unit), &scope);
+
+        if (terminal->entered)
+                first = first < 0 ? first : -EALREADY;
+        terminal->entered = true;
+        if (first == 0 && (!child->armed || !child->bootstrap_delivered || child->first_error < 0))
+                first = -EOWNERDEAD;
+        int before = network_child_native_post(worker, false, false, &request->before);
+        if (first == 0 && before < 0)
+                first = before;
+        if (first == 0)
+                first = aos_launch_record_receive_network_borrow_once(&request->record, fd);
+        AosLaunchRecord *native = &request->record.native;
+        uint8_t *bytes = request->record.payload;
+        if (first == 0 && (native->malformed ||
+            !network_child_header(bytes, native->length, "AOSNFK02", index + 1U, AOS_NETWORK_CHILD_TERMINAL_BYTES) ||
+            (native->flags & (MSG_TRUNC | MSG_CTRUNC)) != 0 || native->rights_count != 0 ||
+            native->credential_count != 1 || native->pidfd_count != 1 || native->descriptor_count != 1 ||
+            native->kernel_pidfd < 0 || native->credentials.pid != source->transport.recipient.pid ||
+            native->credentials.uid != 0 || native->credentials.gid != 0 ||
+            memcmp(bytes + 16, child->birth_bytes + 16, AOS_NETWORK_CHILD_TERMINAL_BYTES - 16U) != 0))
+                first = -EBADMSG;
+        request->validation_result = first;
+        if (native->attempted && native->kernel_pidfd >= 0) {
+                request->source_pidfd_result = fstat(native->kernel_pidfd, &request->source_pidfd) < 0 ? -errno : 0;
+                if (request->source_pidfd_result == 0 &&
+                    (request->source_pidfd.st_dev != source->clone_stat.st_dev ||
+                     request->source_pidfd.st_ino != source->clone_stat.st_ino))
+                        request->source_pidfd_result = -EOWNERDEAD;
+                if (first == 0 && request->source_pidfd_result < 0)
+                        first = request->source_pidfd_result;
+        }
+
+        int identity_before = network_child_terminal_identity(worker, terminal, 0);
+        int population = network_child_terminal_population(worker, terminal);
+        int identity_after = network_child_terminal_identity(worker, terminal, 1);
+        int after = network_child_native_post(worker, false, false, &request->after);
+        terminal->financial_result = aos_resource_parent_require_source_sender(SERVICE(source->transport.unit));
+        const int posts[] = { identity_before, population, identity_after, after, terminal->financial_result };
+        FOREACH_ELEMENT(post, posts)
+                if (first == 0 && *post < 0)
+                        first = *post;
+        if (first == 0) {
+                /* A dead worker's already-queued probe cannot later poison a
+                 * healthy Source after this independently observed terminal.
+                 * Disabling the endpoint grants no currentness or refund. */
+                terminal->event_stop_result = network_child_stop_event(worker, child->event);
+                if (terminal->event_stop_result < 0)
+                        first = terminal->event_stop_result;
+        }
+        terminal->first_error = first;
+        if (first < 0) {
+                if (owner->first_error == 0)
+                        owner->first_error = first;
+                (void) network_child_refuse(worker, first);
+                (void) network_child_stop_source_event(event);
+                return 0;
+        }
+        /* Native debt and old descriptors stay retained. A completed
+         * programme supplies ordering, never a financial refund or new bank. */
+        programme->phase++;
+        return 0;
+}
+
+static void network_child_programme_initialize(AosNetworkChildProgrammeOriginal *programme) {
+        FOREACH_ELEMENT(worker, programme->workers) {
+                *worker = (AosNetworkWorkerOriginal) {
+                        .programme = programme,
+                        .accepted_fd = -EBADF, .peer_fd = -EBADF, .peer = PIDREF_NULL,
+                        .cgroup_fd = -EBADF, .control_fds = { -EBADF, -EBADF },
+                        .clone = { .pidfd = -EBADF, .duplicate_pidfd = -EBADF },
+                        .child = { .executable_fd = -EBADF, .event_fd = -EBADF,
+                                   .transport = { .sockets = { -EBADF, -EBADF }, .recipient = PIDREF_NULL } },
+                };
+        }
+}
+
+/* Source M pays this finite additional programme before calloc, the next
+ * receive, DIR or event allocation. The account's prior spent debit remains.
+ * The first four-walk collector is never reset or lent to a successor. */
+static int network_child_programme_append(void) {
+        AosNetworkChildSourceOriginal *owner = &enrollment.network_child_source;
+        AosNetworkChildProgrammeOriginal *previous = owner->active;
+        AosSourceOrigin *source = &enrollment.network_origin;
+        AosNetworkWorkerOriginal *last = previous ? &previous->workers[1] : NULL;
+        _cleanup_(allocation_account_leave) AllocationAccountScope scope = {};
+        int first = aos_resource_parent_source_exec_scope(SERVICE(source->transport.unit), &scope);
+
+        if (!previous || previous->phase != 6 || previous->next ||
+            !previous->terminals[0].entered || !previous->terminals[1].entered ||
+            previous->terminals[0].first_error < 0 || previous->terminals[1].first_error < 0)
+                return aos_resource_parent_fail(first < 0 ? first : -EOWNERDEAD);
+        int before = network_child_native_post(last, false, false, &previous->append_before);
+        if (first == 0 && before < 0)
+                first = before;
+        if (first == 0) {
+                /* Actual struct bytes are charged by calloc itself. This
+                 * separate permit covers two IO events and glibc DIR storage.
+                 * Native FD peaks include received request/ARM/terminal PIDFDs,
+                 * image failure leaves and raw DIR plus retained duplicate. */
+                size_t memory = 2U * sizeof(sd_event_source) + 1024U * 1024U +
+                                fdset_network_collector_header_memory();
+                unsigned files = 2U * (2U + 1U + 4U + 3U) + AOS_NETWORK_IMAGE_READ_FILES +
+                                 2U * 7U + 6U + 2U;
+                previous->fee_result = allocation_account_charge(memory, files);
+                if (previous->fee_result < 0)
+                        first = previous->fee_result;
+        }
+        AosNetworkChildProgrammeOriginal *next = NULL;
+        if (first == 0) {
+                next = allocation_account_calloc(1, sizeof(*next));
+                previous->allocation_result = next ? 0 : -ENOMEM;
+                if (!next)
+                        first = previous->allocation_result;
+                else {
+                        next->continuation = true;
+                        next->previous = previous;
+                        next->ordinal = previous->ordinal;
+                        network_child_programme_initialize(next);
+                        previous->next = next;
+                }
+        }
+        int after = network_child_native_post(last, false, false, &previous->append_after);
+        if (first == 0 && after < 0)
+                first = after;
+        if (first < 0) {
+                if (owner->first_error == 0)
+                        owner->first_error = first;
+                return aos_resource_parent_fail(first);
+        }
+        owner->active = next;
+        return 0;
+}
+
+static int network_child_source_io(sd_event_source *event, int fd, uint32_t revents, void *userdata) {
+        AosNetworkChildSourceOriginal *owner = &enrollment.network_child_source;
+
+        if (owner->first_error < 0 || !owner->active ||
+            (owner->active->phase == 6 && network_child_programme_append() < 0)) {
+                (void) network_child_stop_source_event(event);
+                return 0;
+        }
+        switch (owner->active->phase % 3U) {
+        case 0:
+                return network_child_prebirth_io(event, fd, revents, userdata);
+        case 1:
+                return network_child_arm_io(event, fd, revents, userdata);
+        case 2:
+                return network_child_terminal_io(event, fd, revents, userdata);
+        default:
+                return aos_resource_parent_fail(-EOWNERDEAD);
+        }
+}
+
+static int network_child_source_begin(Service *service) {
+        AosNetworkChildSourceOriginal *owner = &enrollment.network_child_source;
+        AosSourceOrigin *source = &enrollment.network_origin;
+        int disabled = 0, first;
+        socklen_t length = sizeof(owner->rights_value);
+
+        if (owner->entered)
+                return aos_resource_parent_fail(-EALREADY);
+        owner->entered = true;
+        owner->first = owner->active = &enrollment.network_programme;
+        FOREACH_ELEMENT(worker, owner->active->workers)
+                worker->programme = owner->active;
+        owner->initial_source_before_result = aos_resource_parent_source_clone_post(
+                service, &source->exec_claim, &owner->initial_source_before);
+        first = owner->initial_source_before_result;
+        if (first == 0) {
+                owner->aggregate_result = aos_resource_parent_network_aggregate_capture(service,
+                        &source->exec_claim, &owner->aggregate, &owner->aggregate_id);
+                if (owner->aggregate_result < 0)
+                        first = owner->aggregate_result;
+        }
+        if (first == 0) {
+                /* Initial completion is already received. Later prebirth
+                 * records carry a genuine kernel PIDFD, never SCM_RIGHTS. */
+                owner->rights_set_result = setsockopt(source->transport.sockets[0], SOL_SOCKET,
+                        SO_PASSRIGHTS, &disabled, sizeof(disabled)) < 0 ? -errno : 0;
+                owner->rights_get_result = getsockopt(source->transport.sockets[0], SOL_SOCKET,
+                        SO_PASSRIGHTS, &owner->rights_value, &length) < 0 ? -errno :
+                        length == sizeof(owner->rights_value) && owner->rights_value == 0 ? 0 : -EOWNERDEAD;
+                if (owner->rights_set_result < 0)
+                        first = owner->rights_set_result;
+                else if (owner->rights_get_result < 0)
+                        first = owner->rights_get_result;
+        }
+        if (first == 0) {
+                owner->event_result = sd_event_add_io(UNIT(service)->manager->event, &owner->event,
+                        source->transport.sockets[0], EPOLLIN, network_child_source_io, owner);
+                if (owner->event_result < 0)
+                        first = owner->event_result;
+        }
+        /* Physical posts are owed after each entered setup prefix, including
+         * a failed control setter, event registration or aggregate opening. */
+        owner->initial_source_after_result = aos_resource_parent_source_clone_post(
+                service, &source->exec_claim, &owner->initial_source_after);
+        if (owner->aggregate.directory_fd >= 0)
+                owner->aggregate_after_result = aos_resource_parent_network_aggregate_post(service,
+                        &source->exec_claim, &owner->aggregate, &owner->aggregate_after);
+        if (first == 0 && owner->initial_source_after_result < 0)
+                first = owner->initial_source_after_result;
+        if (first == 0 && owner->aggregate_after_result < 0)
+                first = owner->aggregate_after_result;
+        if (first < 0) {
+                owner->first_error = first;
+                (void) network_child_stop_source_event(owner->event);
+                return aos_resource_parent_fail(first);
+        }
+        return 0;
+}
+
+static int network_child_prepare_transport(AosNetworkWorkerOriginal *worker, Service *service,
+                                            ExecCommand *command, ExecFlags flags) {
+        static const int options[] = { SO_PASSCRED, SO_PASSPIDFD, SO_PASSRIGHTS };
+        AosNetworkChildOriginal *child = &worker->child;
+        AosServiceLaunchTransport *transport = &child->transport;
+        int disabled = 0, first = 0;
+
+        if (!child->prepared || child->transport_entered || child->first_error < 0)
+                return network_child_refuse(worker, -EOWNERDEAD);
+        child->transport_entered = true;
+        transport->entered = true;
+        transport->unit = UNIT(service);
+        transport->main_command = command;
+        transport->main_flags = flags;
+        transport->invocation = UNIT(service)->invocation_id;
+        first = network_child_native_post(worker, false, false, &child->transport_before);
+        if (first == 0)
+                first = service_launch_pair_and_deliver(transport, service, AOS_SERVICE_LAUNCH_NETWORK_CHILD);
+        if (first == 0)
+                for (unsigned i = 0; i < ELEMENTSOF(options); i++) {
+                        socklen_t length = sizeof(child->socket_flag_values[i]);
+                        child->socket_flag_set_results[i] = setsockopt(transport->sockets[0],
+                                SOL_SOCKET, options[i], &disabled, sizeof(disabled)) < 0 ? -errno : 0;
+                        child->socket_flag_get_results[i] = getsockopt(transport->sockets[0],
+                                SOL_SOCKET, options[i], &child->socket_flag_values[i], &length) < 0 ? -errno :
+                                length == sizeof(child->socket_flag_values[i]) &&
+                                        child->socket_flag_values[i] == 0 ? 0 : -EOWNERDEAD;
+                        if (first == 0 && child->socket_flag_set_results[i] < 0)
+                                first = child->socket_flag_set_results[i];
+                        if (first == 0 && child->socket_flag_get_results[i] < 0)
+                                first = child->socket_flag_get_results[i];
+                }
+        if (first == 0) {
+                child->executable_fd = open(command->path, O_PATH | O_CLOEXEC);
+                child->executable_open_result = child->executable_fd < 0 ? -errno : 0;
+                if (child->executable_open_result < 0)
+                        first = child->executable_open_result;
+                else {
+                        child->executable_stat_result = fstat(child->executable_fd, &child->executable_stat) < 0 ? -errno : 0;
+                        if (child->executable_stat_result < 0)
+                                first = child->executable_stat_result;
+                        else if (!S_ISREG(child->executable_stat.st_mode) || child->executable_stat.st_uid != 0 ||
+                                 (child->executable_stat.st_mode & 0222) != 0)
+                                first = -EOWNERDEAD;
+                }
+        }
+        int after = network_child_native_post(worker, false, false, &child->transport_after);
+        if (first == 0 && after < 0)
+                first = after;
+        return first < 0 ? network_child_refuse(worker, first) : 0;
+}
+
+static int network_child_capture_events(AosNetworkWorkerOriginal *worker) {
+        AosNetworkChildOriginal *child = &worker->child;
+        int first = network_child_native_post(worker, false, false, &child->event_before);
+
+        if (first == 0) {
+                child->event_fd = openat(worker->cgroup_fd, "cgroup.events", O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+                child->event_open_result = child->event_fd < 0 ? -errno : 0;
+                if (child->event_open_result < 0)
+                        first = child->event_open_result;
+                else {
+                        child->event_stat_result = fstat(child->event_fd, &child->event_stat) < 0 ? -errno : 0;
+                        child->event_named_result = fstatat(worker->cgroup_fd, "cgroup.events",
+                                &child->event_named_stat, AT_SYMLINK_NOFOLLOW) < 0 ? -errno : 0;
+                        if (child->event_stat_result < 0)
+                                first = child->event_stat_result;
+                        else if (child->event_named_result < 0)
+                                first = child->event_named_result;
+                        else if (!S_ISREG(child->event_stat.st_mode) || child->event_stat.st_uid != 0 ||
+                                 child->event_stat.st_dev != worker->cgroup_stat.st_dev ||
+                                 child->event_stat.st_dev != child->event_named_stat.st_dev ||
+                                 child->event_stat.st_ino != child->event_named_stat.st_ino)
+                                first = -EOWNERDEAD;
+                }
+        }
+        int after = network_child_native_post(worker, false, false, &child->event_after);
+        if (first == 0 && after < 0)
+                first = after;
+        return first < 0 ? network_child_refuse(worker, first) : 0;
+}
+
+/* Only the fixed birth3 and bootstrap9 roles reach this stack-only carrier. */
+static int network_child_send_rights(int socket, const uint8_t *bytes, size_t length,
+                                      const int *descriptors, unsigned count,
+                                      ssize_t *returned) {
+        if (!IN_SET(count, 3U, 9U))
+                return -EINVAL;
+
+        union { struct cmsghdr alignment; uint8_t bytes[CMSG_SPACE(9U * sizeof(int))]; } control = {};
+        struct iovec iov = { .iov_base = (void*) bytes, .iov_len = length };
+        struct msghdr message = {
+                .msg_iov = &iov, .msg_iovlen = 1,
+                .msg_control = control.bytes, .msg_controllen = CMSG_SPACE(count * sizeof(int)),
+        };
+
+        struct cmsghdr *header = CMSG_FIRSTHDR(&message);
+        header->cmsg_level = SOL_SOCKET;
+        header->cmsg_type = SCM_RIGHTS;
+        header->cmsg_len = CMSG_LEN(count * sizeof(int));
+        memcpy(CMSG_DATA(header), descriptors, count * sizeof(int));
+        *returned = sendmsg(socket, &message, MSG_DONTWAIT | MSG_NOSIGNAL);
+        return *returned < 0 ? -errno : *returned == length ? 0 : -EIO;
+}
+
+static int network_child_spawn_returned(AosNetworkWorkerOriginal *worker, Service *service,
+                                        int spawn_result, const PidRef *recipient) {
+        AosNetworkChildOriginal *child = &worker->child;
+        AosSourceOrigin *source = &enrollment.network_origin;
+        const uint8_t *request = worker->programme->requests[child->request_index].record.payload;
+        int first = service_launch_spawn_returned(&child->transport, service, spawn_result, recipient);
+
+        if (first < 0)
+                return network_child_refuse(worker, first);
+        if (child->bootstrap_entered)
+                return network_child_refuse(worker, -EALREADY);
+        child->bootstrap_entered = true;
+        child->process_start_result = pidref_get_start_time(&child->transport.recipient, &child->process_start);
+        if (child->process_start_result < 0)
+                first = child->process_start_result;
+        int before = network_child_native_post(worker, true, false, &child->birth_before);
+        if (first == 0 && before < 0)
+                first = before;
+        if (first == 0) {
+                network_child_write_header(child->birth_bytes, "AOSNFH02", worker->purpose + 1U,
+                        sizeof(child->birth_bytes));
+                memcpy(child->birth_bytes + 16, enrollment.boot.bytes, 16);
+                memcpy(child->birth_bytes + 32, worker->source_invocation.bytes, 16);
+                memcpy(child->birth_bytes + 48, worker->worker_invocation.bytes, 16);
+                memcpy(child->birth_bytes + 64, child->request_digest, 32);
+                memcpy(child->birth_bytes + 96, child->challenge.bytes, 16);
+                memcpy(child->birth_bytes + 112, request + 80, 16);
+                unaligned_write_be64(child->birth_bytes + 128, child->transport.recipient.pid);
+                unaligned_write_be64(child->birth_bytes + 136, child->process_start);
+                unaligned_write_be64(child->birth_bytes + 144, worker->cgroup_id);
+                const int descriptors[] = { worker->clone.pidfd, worker->cgroup_fd, child->event_fd };
+                child->birth_send_result = network_child_send_rights(source->transport.sockets[0],
+                        child->birth_bytes, sizeof(child->birth_bytes), descriptors,
+                        ELEMENTSOF(descriptors), &child->birth_length);
+                if (child->birth_send_result < 0)
+                        first = child->birth_send_result;
+        }
+        int after = network_child_native_post(worker, true, false, &child->birth_after);
+        if (first == 0 && after < 0)
+                first = after;
+        if (first < 0)
+                return network_child_refuse(worker, first);
+        child->birth_delivered = true;
+        return 0;
+}
+
+/* The child cannot enter its paid startup until its real lender has adopted
+ * native cleanup custody and acknowledged on the same original Source path. */
+static int network_child_send_bootstrap(AosNetworkWorkerOriginal *worker) {
+        AosNetworkChildOriginal *child = &worker->child;
+        AosSourceOrigin *source = &enrollment.network_origin;
+        AosNetworkChildSourceOriginal *owner = &enrollment.network_child_source;
+        const uint8_t *request = worker->programme->requests[child->request_index].record.payload;
+
+        if (!child->armed || !child->birth_delivered || child->bootstrap_delivered)
+                return network_child_refuse(worker, -EOWNERDEAD);
+        int first = network_child_native_post(worker, true, false, &child->bootstrap_before);
+        if (first == 0) {
+                uint8_t *bytes = child->bootstrap_bytes;
+                network_child_write_header(bytes, "AOSNFB02", worker->purpose + 1U, sizeof(child->bootstrap_bytes));
+                memcpy(bytes + 16, enrollment.boot.bytes, 16);
+                memcpy(bytes + 32, worker->source_invocation.bytes, 16);
+                memcpy(bytes + 48, worker->worker_invocation.bytes, 16);
+                memcpy(bytes + 64, child->request_digest, 32);
+                memcpy(bytes + 96, source->exec_claim.parent_digest, 32);
+                memcpy(bytes + 128, source->budget_digest, 32);
+                memcpy(bytes + 160, child->challenge.bytes, 16);
+                memcpy(bytes + 176, request + 80, 48);
+                unaligned_write_be64(bytes + 224, source->transport.recipient.pid);
+                unaligned_write_be64(bytes + 232, source->process_start[0]);
