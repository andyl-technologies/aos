+static bool network_child_header(const uint8_t *bytes, size_t length, const char magic[8],
+                                  unsigned purpose, size_t expected) {
+        return length == expected && memcmp(bytes, magic, 8) == 0 &&
+                unaligned_read_be16(bytes + 8) == 2 && bytes[10] == purpose &&
+                bytes[11] == 0 && unaligned_read_be32(bytes + 12) == expected;
+}
+
+static void network_child_write_header(uint8_t *bytes, const char magic[8],
+                                        unsigned purpose, size_t length) {
+        memcpy(bytes, magic, 8);
+        unaligned_write_be16(bytes + 8, 2);
+        bytes[10] = purpose;
+        bytes[11] = 0;
+        unaligned_write_be32(bytes + 12, length);
+}
