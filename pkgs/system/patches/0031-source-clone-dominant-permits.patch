+                return r;
+        wanted = (size_t) highest + 1U;
+        if (wanted <= AOS_KERNEL_CLONE_V1_NR_OPEN_DEFAULT) {
+                *ret = total;
+                return 0;
+        }
+        r = kernel_clone_power_of_two(wanted, &slots);
+        if (r < 0)
+                return r;
+        r = kernel_clone_mul(slots, AOS_KERNEL_CLONE_V1_FILE_POINTER_BYTES, &array);
+        if (r < 0)
+                return r;
+        /* fs/file.c BITBIT_SIZE plus both open/close-on-exec bitmaps. */
+        bitbit_longs = slots / AOS_KERNEL_CLONE_V1_BITS_PER_LONG;
+        bitbit_longs = bitbit_longs / AOS_KERNEL_CLONE_V1_BITS_PER_LONG +
+                       (bitbit_longs % AOS_KERNEL_CLONE_V1_BITS_PER_LONG != 0);
+        r = kernel_clone_mul(bitbit_longs, AOS_KERNEL_CLONE_V1_ULONG_BYTES, &bitmap);
+        if (r < 0)
