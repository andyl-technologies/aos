--- a/src/core/selinux-access.c
+++ b/src/core/selinux-access.c
@@ -223,6 +223,13 @@
         assert(permission);
         assert(audit_info);
         assert(audit_info->function);
+
+        /* libselinux permits an unknown permission under allow_unknown policies.
+         * Require deny/reject semantics for the dedicated initrd handoff, so an
+         * older policy cannot turn a missing permission into authorization. */
+        if (streq(permission, "aos_switch_root") && sym_security_deny_unknown() != 1)
+                return sd_bus_error_set(reterr_error, SD_BUS_ERROR_ACCESS_DENIED,
+                                        "SwitchRoot requires a policy that denies unknown permissions.");
 
         r = sym_selinux_check_access(scon, tcon, tclass, permission, audit_info);
