+        cursor += AOS_RESOURCE_VECTOR_BYTES;
+        memcpy(cursor, enrollment.policy + AOS_RESOURCE_CONTROLLER_RANGE_ALLOWANCE_OFFSET, AOS_RESOURCE_VECTOR_BYTES);
+        cursor += AOS_RESOURCE_VECTOR_BYTES;
+        memcpy(cursor, enrollment.policy + AOS_RESOURCE_CONTROLLER_RANGE_COUNT_OFFSET, 8);
+        sha256_direct(material, sizeof(material), original->range_commitment);
+
+        r = aos_resource_parent_controller_exec_scope(service, &scope);
+        if (r < 0)
+                return r;
+        original->history_capacity = history_bytes / sizeof(AosControllerRetiredAttempt);
+        original->history = allocation_account_calloc(original->history_capacity, sizeof(AosControllerRetiredAttempt));
+        original->history_allocation_result = original->history ? 0 :
+                enrollment.parent.controller_sender.account.first_error < 0 ?
+                enrollment.parent.controller_sender.account.first_error : -ENOMEM;
+        original->history_account_post_result = aos_resource_parent_require_controller_sender(service);
