+/* The commitment uses the same canonical identity as capsule[8..104].
+ * It binds provider declarations only; range authority is enabled separately
+ * by the real initial durable-bank ACK/Confirm under this native original. */
+static int controller_initialize_range(Service *service) {
+        AosControllerRestart *original = &enrollment.controller_restart;
+        _cleanup_(allocation_account_leave) AllocationAccountScope scope = {};
+        static const char domain[] = "AOS-controller-recipient-prepaid-range-v1\0";
+        uint8_t material[sizeof(domain) - 1U + 96U + 2U * AOS_RESOURCE_VECTOR_BYTES + 8U];
+        uint8_t *cursor = material;
+        uint8_t policy_digest[SHA256_DIGEST_SIZE];
+        size_t history_bytes = aos_resource_controller_history_memory();
+        int r;
+
+        if (enrollment.policy_bytes != AOS_RESOURCE_CONTROLLER_RANGE_POLICY_BYTES)
+                return 0;
+        if (original->history || history_bytes == SIZE_MAX)
+                return -EOWNERDEAD;
+        memcpy(cursor, domain, sizeof(domain) - 1U);
+        cursor += sizeof(domain) - 1U;
+        memcpy(cursor, enrollment.policy + 8, 32);
+        cursor += 32;
+        memcpy(cursor, enrollment.boot.bytes, 16);
+        cursor += 16;
+        memcpy(cursor, enrollment.invocation.bytes, 16);
+        cursor += 16;
+        sha256_direct(enrollment.policy, enrollment.policy_bytes, policy_digest);
+        memcpy(cursor, policy_digest, sizeof(policy_digest));
+        cursor += sizeof(policy_digest);
