+/* These are original kernel controls, not another resource ledger or loan.
+ * Fixed storage and held OFDs are real parent costs. Earlier boot allocations
+ * and charges do not migrate retrospectively into these enclosures. */
+typedef struct AosParentCheck {
+        struct stat directory[2];
+        struct stat controls[2][3];
+        int directory_results[2];
+        int control_results[2][3];
+        uint8_t readback[3][128];
