+++ b/src/core/aos-component-parent.c
@@ -0,0 +1,877 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+
+#include <fcntl.h>
+#include <sys/resource.h>
+#include <sys/stat.h>
+#include <sys/vfs.h>
+#include <unistd.h>
+
+#include "aos-component-parent.h"
+#include "aos-resource-enrollment.h"
+#include "alloc-util.h"
+#include "cgroup-setup.h"
+#include "cgroup-util.h"
+#include "fd-util.h"
+#include "initrd-util.h"
+#include "load-fragment.h"
+#include "set.h"
+#include "special.h"
+#include "string-util.h"
+#include "strv.h"
+#include "mountpoint-util.h"
+
+#define AOS_RESOURCE_VECTOR_BYTES (22U * 8U)
+#define AOS_RESOURCE_COMPONENTS_OFFSET (40U + 3U * AOS_RESOURCE_VECTOR_BYTES)
+#define AOS_RESOURCE_HOST_POLICY_BYTES 1128U
+#define AOS_RESOURCE_ROOT_POLICY_BYTES 1832U
+#define AOS_RESOURCE_ROOT_OFFSET 1624U
+
+static uint64_t policy_u64(const uint8_t *bytes) {
+        uint64_t value = 0;
+
+        for (unsigned i = 0; i < 8; i++)
+                value = (value << 8) | bytes[i];
+        return value;
+}
+
+/* The separate image manifest provisions M and a fixed F subset inside the
+ * already committed Components baseline. Zero is zero accounting provision,
+ * never evidence that an effect is absent. Other services retain the residual
+ * U and their existing operation gates. Only CPU/memory/PIDs are hard controls;
+ * NOFILE observations and financial bounds do not resist privileged raises. */
+static const char *const parent_members[] = {
+        "aoscomponents.slice",
+        "aos-sandbox-source-signerd.service",
+        "aos-sandbox-source-signer-view.service",
+        "aos-sandbox-cache-signerd.service",
+        "aos-sandbox-cache-signer-views.service",
+        "aos-sandbox-cache-journal-view.service",
+        "aos-sandbox-policy-cache-recovery.service",
+        "systemd-journald.service",
+        "aos-journald-runtime-prep.service",
+        "auditd.service",
+        "audit-rules.service",
+};
+
+static const char *const parent_control_names[] = { "memory.max", "pids.max", "cpu.max" };
+static const char *const parent_cgroup_paths[] = { "/init.scope", "/aoscomponents.slice" };
+static const char *const parent_native_paths[] = {
+        "/sys/fs/cgroup/init.scope", "/sys/fs/cgroup/aoscomponents.slice",
+};
+
+static int parent_refuse(int error) {
+        AosResourceParent *parent = aos_resource_parent_original();
+
+        if (parent->first_error == 0)
+                parent->first_error = error;
+        aos_resource_parent_fail(parent->first_error);
+        return parent->first_error;
+}
+
+int aos_resource_parent_error(void) {
+        AosResourceParent *parent = aos_resource_parent_original();
+        const uint8_t *policy;
+        size_t bytes;
+        int r;
+
+        if (!parent->selected)
+                return 0;
+        if (parent->first_error < 0)
+                return parent->first_error;
+        r = aos_resource_parent_policy(parent->manager, &policy, &bytes);
+        return r < 0 ? parent_refuse(r) : 0;
+}
+
+static unsigned parent_u16(const uint8_t *bytes) {
+        return ((unsigned) bytes[0] << 8) | bytes[1];
+}
+
+static const uint8_t *parent_row(unsigned member) {
+        return aos_resource_parent_original()->manifest + AOS_PARENT_HEADER_BYTES + member * AOS_PARENT_ROW_BYTES;
+}
+
+static int parent_member_index(const char *name) {
+        for (unsigned i = 0; i < aos_resource_parent_original()->members; i++)
+                if (streq_ptr(name, (const char*) parent_row(i)))
+                        return (int) i;
+        return -1;
+}
+
+static bool parent_string(const uint8_t *bytes, size_t capacity) {
+        const uint8_t *end = memchr(bytes, 0, capacity);
+
+        if (!end || end == bytes)
+                return false;
+        for (size_t i = (size_t) (end - bytes); i < capacity; i++)
+                if (bytes[i] != 0)
+                        return false;
+        return true;
+}
+
+static bool parent_leaf_basename(const char *name) {
+        if (isempty(name) || strchr(name, '/') || STR_IN_SET(name, ".", "..") || !endswith(name, ".conf"))
+                return false;
+        for (const unsigned char *byte = (const unsigned char*) name; *byte; byte++)
+                if (*byte > 127)
+                        return false;
+        return true;
+}
+
+static bool parent_known_name(const char *name) {
+        FOREACH_ELEMENT(member, parent_members)
+                if (streq(name, *member))
+                        return true;
+        return false;
+}
+
+static const uint8_t *parent_vector(unsigned enclosure) {
+        return aos_resource_parent_original()->manifest + 40 + enclosure * AOS_RESOURCE_VECTOR_BYTES;
+}
+
+static const char *parent_file_path(unsigned member, unsigned file) {
+        const uint8_t *row = parent_row(member);
+
+        return (const char*) (file == 0 ? row + 64 : row + 354 + (file - 1) * 288);
+}
+
+static const uint8_t *parent_file_digest(unsigned member, unsigned file) {
+        const uint8_t *row = parent_row(member);
+
+        return file == 0 ? row + 320 : row + 610 + (file - 1) * 288;
+}
+
+const char *aos_resource_parent_member_path(const char *name, unsigned file) {
+        int member = parent_member_index(name);
+
+        if (!aos_resource_parent_original()->selected || aos_resource_parent_original()->first_error < 0 || member < 0 ||
+            file > parent_u16(parent_row(member) + 352))
+                return NULL;
+        return parent_file_path(member, file);
+}
+
+static int parent_validate_manifest(void) {
+        AosResourceParent *parent = aos_resource_parent_original();
+        uint8_t digest[SHA256_DIGEST_SIZE];
+        unsigned count;
+        bool slice = false, journal = false, runtime_prep = false;
+
+        if (parent->manifest_bytes < 486 || memcmp(parent->manifest, "AOSRPE01", 8) != 0)
+                return -EBADMSG;
+        count = parent_u16(parent->manifest + 452);
+        if (count == 0 || count > AOS_PARENT_MEMBERS ||
+            parent->manifest_bytes != 486U + count * AOS_PARENT_ROW_BYTES)
+                return -EBADMSG;
+        sha256_direct(parent->manifest, parent->manifest_bytes - sizeof(digest), digest);
+        if (memcmp(digest, parent->manifest + parent->manifest_bytes - sizeof(digest), sizeof(digest)) != 0)
+                return -EBADMSG;
+        sha256_direct(parent->policy, parent->policy_bytes, digest);
+        if (memcmp(digest, parent->manifest + 8, sizeof(digest)) != 0)
+                return -EOWNERDEAD;
+
+        for (unsigned dimension = 0; dimension < 22; dimension++) {
+                uint64_t baseline = policy_u64(parent->policy + AOS_RESOURCE_COMPONENTS_OFFSET + dimension * 8);
+                uint64_t m = policy_u64(parent_vector(0) + dimension * 8);
+                uint64_t f = policy_u64(parent_vector(1) + dimension * 8);
+
+                if (parent->policy_bytes >= AOS_RESOURCE_HOST_POLICY_BYTES)
+                        for (unsigned offset = 744; offset <= 920; offset += AOS_RESOURCE_VECTOR_BYTES) {
+                                uint64_t host = policy_u64(parent->policy + offset + dimension * 8);
+
+                                if (host > baseline)
+                                        return -ERANGE;
+                                baseline -= host;
+                        }
+                if (parent->policy_bytes == AOS_RESOURCE_ROOT_POLICY_BYTES) {
+                        uint64_t root = policy_u64(parent->policy + AOS_RESOURCE_ROOT_OFFSET + dimension * 8);
+
+                        if (root > baseline)
+                                return -ERANGE;
+                        baseline -= root;
+                }
+                if (m > baseline || f > baseline - m)
+                        return -ERANGE;
+                for (unsigned enclosure = 0; enclosure < 2; enclosure++) {
+                        uint64_t value = policy_u64(parent_vector(enclosure) + dimension * 8);
+                        uint8_t expected = dimension < 3 ? 1 : value > 0 ? 2 : 0;
+
+                        if (((dimension < 4 || dimension == 21) && value == 0) ||
+                            parent->manifest[408 + enclosure * 22 + dimension] != expected)
+                                return -EBADMSG;
+                }
+        }
+        for (unsigned enclosure = 0; enclosure < 2; enclosure++) {
+                const uint8_t *vector = parent_vector(enclosure);
+                uint64_t cpu = policy_u64(vector), memory = policy_u64(vector + 8);
+                uint64_t tasks = policy_u64(vector + 16), files = policy_u64(vector + 24);
+                uint64_t nofile = policy_u64(parent->manifest + 392 + enclosure * 8);
+
+                if (cpu < 1000 || cpu % 1000 != 0 || cpu > UINT64_MAX / 10 ||
+                    memory == 0 || memory % 4096 != 0 || memory > INT64_MAX ||
+                    tasks == 0 || tasks > INT64_MAX || nofile == 0 || nofile > UINT32_MAX ||
+                    nofile >= (uint64_t) RLIM_INFINITY || nofile > files / tasks)
+                        return -ERANGE;
+        }
+
+        for (unsigned i = 0; i < count; i++) {
+                const uint8_t *row = parent_row(i);
+                const char *name = (const char*) row;
+                unsigned dropins = parent_u16(row + 352);
+
+                if (!parent_string(row, 64) || !parent_known_name(name) ||
+                    !parent_string(row + 64, 256) || !streq(name, (const char*) row + 64) ||
+                    dropins > 4 || (i > 0 && strcmp((const char*) parent_row(i - 1), name) >= 0))
+                        return -EBADMSG;
+                slice |= streq(name, "aoscomponents.slice");
+                journal |= streq(name, "systemd-journald.service");
+                runtime_prep |= streq(name, "aos-journald-runtime-prep.service");
+                for (unsigned file = 1; file <= 4; file++) {
+                        const uint8_t *slot = row + 354 + (file - 1) * 288;
+                        const char *path = (const char*) slot, *basename;
+                        size_t prefix = strlen(name);
+
+                        if (file > dropins) {
+                                for (unsigned j = 0; j < 288; j++)
+                                        if (slot[j] != 0)
+                                                return -EBADMSG;
+                                continue;
+                        }
+                        if (!parent_string(slot, 256) || strncmp(path, name, prefix) != 0 ||
+                            strncmp(path + prefix, ".d/", 3) != 0)
+                                return -EBADMSG;
+                        basename = path + prefix + 3;
+                        if (!parent_leaf_basename(basename) ||
+                            (file > 1 && strcmp(parent_file_path(i, file - 1), path) >= 0))
+                                return -EBADMSG;
+                }
+        }
+        if (!slice || !journal || !runtime_prep)
+                return -EBADMSG;
+        parent->members = count;
+        return 0;
+}
+
+void aos_resource_parent_setup_result(Manager *manager, int attach_result, int migrate_result) {
+        AosResourceParent *parent = aos_resource_parent_original();
+
+        if (parent->first_error < 0 || parent->setup_seen)
+                return;
+        if (in_initrd() || !aos_network_image_guard_active())
+                return;
+        parent->setup_seen = true;
+        parent->setup_manager = manager;
+        parent->attach_result = attach_result;
+        parent->migrate_result = migrate_result;
+}
+
+static void parent_expected(unsigned enclosure, unsigned control, char expected[128]) {
+        const uint8_t *vector = parent_vector(enclosure);
+
+        if (control < 2)
+                snprintf(expected, 128, "%" PRIu64 "\n", policy_u64(vector + (control + 1) * 8));
+        else
+                snprintf(expected, 128, "%" PRIu64 " 100000\n", policy_u64(vector));
+}
+
+static int parent_name_check(unsigned enclosure, AosParentCheck *check, unsigned side) {
+        AosParentLimits *limits = &aos_resource_parent_original()->limits[enclosure];
+        int result = 0;
+
+        check->directory_results[side] =
+                fstatat(AT_FDCWD, parent_native_paths[enclosure], &check->directory[side], AT_SYMLINK_NOFOLLOW) < 0 ? -errno : 0;
+        if (check->directory_results[side] < 0)
+                result = check->directory_results[side];
+        else if (check->directory[side].st_dev != limits->directory_stat.st_dev ||
+                 check->directory[side].st_ino != limits->directory_stat.st_ino)
+                result = -EOWNERDEAD;
+        for (unsigned i = 0; i < 3; i++) {
+                check->control_results[side][i] =
+                        fstatat(limits->directory_fd, parent_control_names[i], &check->controls[side][i], AT_SYMLINK_NOFOLLOW) < 0 ? -errno : 0;
+                if (result == 0 && check->control_results[side][i] < 0)
+                        result = check->control_results[side][i];
+                else if (result == 0 &&
+                         (check->controls[side][i].st_dev != limits->control_stats[i].st_dev ||
+                          check->controls[side][i].st_ino != limits->control_stats[i].st_ino))
+                        result = -EOWNERDEAD;
+        }
+        return result;
+}
+
+static int parent_limits_observe(unsigned enclosure, bool install) {
+        AosParentLimits *limits = &aos_resource_parent_original()->limits[enclosure];
+        AosParentCheck *check = install ? &limits->first : &limits->later;
+        char expected[128];
+        int result, r;
+
+        result = aos_resource_parent_error();
+        if (result < 0)
+                return result;
+        result = parent_name_check(enclosure, check, 0);
+        if (result == 0)
+                for (unsigned i = 0; i < 3; i++) {
+                        parent_expected(enclosure, i, expected);
+                        if (install) {
+                                r = aos_resource_control_install(limits->control_fds[i], expected,
+                                                             &limits->write_lengths[i], &limits->write_results[i]);
+                                if (r < 0) {
+                                        result = r;
+                                        break;
+                                }
+                        }
+                        r = aos_resource_control_readback(limits->control_fds[i], expected, check->readback[i],
+                                                      sizeof(check->readback[i]), &check->read_lengths[i],
+                                                      &check->read_results[i]);
+                        if (r < 0) {
+                                result = r;
+                                break;
+                        }
+                }
+        /* Always retain the after-name observations, even after an earlier
+         * failure. No later caller installs again to heal an uncertain post. */
+        r = parent_name_check(enclosure, check, 1);
+        return result < 0 ? result : r;
+}
+
+static int parent_open_limits(unsigned enclosure) {
+        AosParentLimits *limits = &aos_resource_parent_original()->limits[enclosure];
+
+        limits->directory_fd = cg_path_open(parent_cgroup_paths[enclosure]);
+        if (limits->directory_fd < 0)
+                return limits->directory_fd;
+        limits->directory_stat_result = fstat(limits->directory_fd, &limits->directory_stat) < 0 ? -errno : 0;
+        limits->filesystem_result = fstatfs(limits->directory_fd, &limits->filesystem) < 0 ? -errno : 0;
+        if (limits->directory_stat_result < 0)
+                return limits->directory_stat_result;
+        if (limits->filesystem_result < 0)
+                return limits->filesystem_result;
+        if (limits->filesystem.f_type != 0x63677270 || !S_ISDIR(limits->directory_stat.st_mode) ||
+            limits->directory_stat.st_uid != 0 || limits->directory_stat.st_gid != 0)
+                return -EPERM;
+        for (unsigned i = 0; i < 3; i++) {
+                limits->control_fds[i] = openat(limits->directory_fd, parent_control_names[i], O_RDWR | O_CLOEXEC | O_NOFOLLOW);
+                if (limits->control_fds[i] < 0)
+                        return -errno;
+                limits->control_stat_results[i] = fstat(limits->control_fds[i], &limits->control_stats[i]) < 0 ? -errno : 0;
+                if (limits->control_stat_results[i] < 0)
+                        return limits->control_stat_results[i];
+                if (!S_ISREG(limits->control_stats[i].st_mode) ||
+                    limits->control_stats[i].st_uid != 0 || limits->control_stats[i].st_gid != 0 ||
+                    limits->control_stats[i].st_dev != limits->directory_stat.st_dev)
+                        return -EPERM;
+        }
+        return parent_limits_observe(enclosure, true);
+}
+
+static int parent_pin_members(void) {
+        AosResourceParent *parent = aos_resource_parent_original();
+
+        for (unsigned member = 0; member < parent->members; member++)
+                for (unsigned file = 0; file <= parent_u16(parent_row(member) + 352); file++) {
+                        AosParentFile *original = &parent->files[member][file];
+
+                        original->fd = aos_resource_open_parent_member((const char*) parent_row(member), file,
+                                                                      &original->physical_path);
+                        if (original->fd < 0)
+                                return original->fd;
+                        original->stat_result = fstat(original->fd, &original->stat) < 0 ? -errno : 0;
+                        if (original->stat_result < 0)
+                                return original->stat_result;
+                        if (original->stat.st_size <= 0 || original->stat.st_size > AOS_PARENT_FILE_BYTES)
+                                return -EFBIG;
+                        original->read_length = pread(original->fd, parent->file_bytes, sizeof(parent->file_bytes), 0);
+                        original->read_result = original->read_length < 0 ? -errno :
+                                original->read_length == original->stat.st_size ? 0 : -EIO;
+                        if (original->read_result < 0)
+                                return original->read_result;
+                        sha256_direct(parent->file_bytes, original->read_length, original->digest);
+                        if (memcmp(original->digest, parent_file_digest(member, file), sizeof(original->digest)) != 0)
+                                return -EOWNERDEAD;
+                }
+        return 0;
+}
+
+static int parent_compare_effective(AosParentFile *original, const char *path) {
+        AosResourceParent *parent = aos_resource_parent_original();
+        _cleanup_close_ int fd = -EBADF;
+
+        if (parent->first_error < 0)
+                return parent->first_error;
+        if (isempty(path))
+                return -EOWNERDEAD;
+        /* Mutable lookup files supply comparison DATA only. Nonblocking open
+         * prevents a substituted FIFO from parking PID1 before type checking. */
+        fd = open(path, O_RDONLY | O_CLOEXEC | O_NONBLOCK | O_NOCTTY);
+        original->effective_open_result = fd < 0 ? -errno : fd;
+        if (original->effective_open_result < 0)
+                return original->effective_open_result;
+        original->effective_stat_result = fstat(fd, &original->effective_stat) < 0 ? -errno : 0;
+        if (original->effective_stat_result < 0)
+                return original->effective_stat_result;
+        if (!S_ISREG(original->effective_stat.st_mode) || original->effective_stat.st_size != original->stat.st_size ||
+            original->effective_stat.st_size <= 0 || original->effective_stat.st_size > AOS_PARENT_FILE_BYTES)
+                return -EOWNERDEAD;
+        original->effective_read_length = pread(fd, parent->file_bytes, sizeof(parent->file_bytes), 0);
+        original->effective_read_result = original->effective_read_length < 0 ? -errno :
+                original->effective_read_length == original->stat.st_size ? 0 : -EIO;
+        if (original->effective_read_result < 0)
+                return original->effective_read_result;
+        sha256_direct(parent->file_bytes, original->effective_read_length, original->effective_digest);
+        return memcmp(original->effective_digest, original->digest, sizeof(original->digest)) == 0 ? 0 : -EOWNERDEAD;
+}
+
+static int parent_check_all(void) {
+        AosResourceParent *parent = aos_resource_parent_original();
+        const uint8_t *policy;
+        size_t policy_bytes;
+        int r;
+
+        if (!parent->selected)
+                return 0;
+        if (parent->first_error < 0)
+                return parent->first_error;
+        r = aos_resource_parent_policy(parent->manager, &policy, &policy_bytes);
+        if (r < 0)
+                return parent_refuse(r);
+        if (!parent->installed || policy != parent->policy || policy_bytes != parent->policy_bytes)
+                return parent_refuse(-EOWNERDEAD);
+        parent->pid1_later_path = mfree(parent->pid1_later_path);
+        parent->pid1_later_result = cg_pid_get_path(0, &parent->pid1_later_path);
+        if (parent->pid1_later_result < 0)
+                return parent_refuse(parent->pid1_later_result);
+        if (!streq_ptr(parent->pid1_later_path, parent_cgroup_paths[0]))
+                return parent_refuse(-EOWNERDEAD);
+        parent->nofile_later_result = getrlimit(RLIMIT_NOFILE, &parent->nofile_later) < 0 ? -errno : 0;
+        if (parent->nofile_later_result < 0)
+                return parent_refuse(parent->nofile_later_result);
+        if (parent->nofile_later.rlim_cur > parent->nofile_after.rlim_cur ||
+            parent->nofile_later.rlim_max > parent->nofile_after.rlim_max)
+                return parent_refuse(-ERANGE);
+        for (unsigned enclosure = 0; enclosure < 2; enclosure++) {
+                r = parent_limits_observe(enclosure, false);
+                if (r < 0)
+                        return parent_refuse(r);
+        }
+        return 0;
+}
+
+int aos_resource_parent_begin(Manager *manager, bool restoring) {
+        AosResourceParent *parent = aos_resource_parent_original();
+        struct rlimit nofile;
+        int r;
+
+        r = aos_resource_parent_error();
+        if (r < 0)
+                return r;
+        if (in_initrd() || !aos_network_image_guard_active())
+                return 0;
+        if (parent->attempted)
+                return parent->selected ? parent_refuse(-EALREADY) : 0;
+        parent->attempted = true;
+        for (unsigned enclosure = 0; enclosure < 2; enclosure++) {
+                parent->config_fds[enclosure] = -EBADF;
+                parent->limits[enclosure].directory_fd = -EBADF;
+                for (unsigned i = 0; i < 3; i++)
+                        parent->limits[enclosure].control_fds[i] = -EBADF;
+        }
+        for (unsigned member = 0; member < AOS_PARENT_MEMBERS; member++)
+                for (unsigned file = 0; file < 5; file++)
+                        parent->files[member][file].fd = -EBADF;
+
+        for (unsigned file = 0; file < 2; file++) {
+                parent->config_fds[file] = aos_resource_open_parent_config(file == 0, &parent->absent[file]);
+                if (parent->config_fds[file] < 0 && !parent->absent[file]) {
+                        parent->selected = true;
+                        return parent_refuse(parent->config_fds[file]);
+                }
+        }
+        if (parent->absent[0] && parent->absent[1])
+                return 0;
+        parent->selected = true;
+        parent->manager = manager;
+        r = aos_resource_parent_policy(manager, &parent->policy, &parent->policy_bytes);
+        if (r < 0)
+                return parent_refuse(r);
+        if (parent->absent[0] || parent->absent[1] || !parent->setup_seen ||
+            parent->setup_manager != manager || !isempty(manager->cgroup_root) ||
+            (restoring && !MANAGER_IS_SWITCHING_ROOT(manager)))
+                return parent_refuse(-EOWNERDEAD);
+        if (parent->attach_result < 0)
+                return parent_refuse(parent->attach_result);
+        if (parent->migrate_result < 0)
+                return parent_refuse(parent->migrate_result);
+        for (unsigned file = 0; file < 2; file++) {
+                parent->config_stat_results[file] = fstat(parent->config_fds[file], &parent->config_stats[file]) < 0 ? -errno : 0;
+                if (parent->config_stat_results[file] < 0)
+                        return parent_refuse(parent->config_stat_results[file]);
+        }
+        parent->config_read_lengths[0] = pread(parent->config_fds[0], parent->selector, sizeof(parent->selector), 0);
+        parent->config_read_results[0] = parent->config_read_lengths[0] < 0 ? -errno : 0;
+        if (parent->config_read_results[0] < 0)
+                return parent_refuse(parent->config_read_results[0]);
+        if (parent->config_read_lengths[0] != 8 || parent->config_stats[0].st_size != 8 ||
+            memcmp(parent->selector, "AOSRPE01", 8) != 0)
+                return parent_refuse(-EBADMSG);
+        parent->config_read_lengths[1] = pread(parent->config_fds[1], parent->manifest, sizeof(parent->manifest), 0);
+        parent->config_read_results[1] = parent->config_read_lengths[1] < 0 ? -errno : 0;
+        if (parent->config_read_results[1] < 0)
+                return parent_refuse(parent->config_read_results[1]);
+        if (parent->config_read_lengths[1] != parent->config_stats[1].st_size ||
+            parent->config_read_lengths[1] > AOS_PARENT_MAX_BYTES)
+                return parent_refuse(-EFBIG);
+        parent->manifest_bytes = parent->config_read_lengths[1];
+        r = parent_validate_manifest();
+        if (r < 0)
+                return parent_refuse(r);
+        if (!FLAGS_SET(manager->cgroup_supported, AOS_PARENT_CONTROLLERS))
+                return parent_refuse(-EOPNOTSUPP);
+        /* Restrict supported too: cg_enable otherwise disables unrelated
+         * controllers. Its success alone does not prove each enable succeeded. */
+        parent->enable_result = cg_enable(manager->cgroup_supported & AOS_PARENT_CONTROLLERS,
+                                         AOS_PARENT_CONTROLLERS, manager->cgroup_root, &parent->enabled);
+        if (parent->enable_result < 0)
+                return parent_refuse(parent->enable_result);
+        if (!FLAGS_SET(parent->enabled, AOS_PARENT_CONTROLLERS))
+                return parent_refuse(-EOPNOTSUPP);
+        parent->create_result = cg_create(parent_cgroup_paths[1]);
+        if (parent->create_result < 0)
+                return parent_refuse(parent->create_result);
+        for (unsigned enclosure = 0; enclosure < 2; enclosure++) {
+                r = parent_open_limits(enclosure);
+                if (r < 0)
+                        return parent_refuse(r);
+        }
+
+        parent->pid1_first_result = cg_pid_get_path(0, &parent->pid1_first_path);
+        if (parent->pid1_first_result < 0)
+                return parent_refuse(parent->pid1_first_result);
+        if (!streq_ptr(parent->pid1_first_path, parent_cgroup_paths[0]))
+                return parent_refuse(-EOWNERDEAD);
+        parent->nofile_before_result = getrlimit(RLIMIT_NOFILE, &parent->nofile_before) < 0 ? -errno : 0;
+        if (parent->nofile_before_result < 0)
+                return parent_refuse(parent->nofile_before_result);
+        nofile = (struct rlimit) {
+                .rlim_cur = policy_u64(parent->manifest + 392),
+                .rlim_max = policy_u64(parent->manifest + 392),
+        };
+        parent->nofile_set_result = setrlimit(RLIMIT_NOFILE, &nofile) < 0 ? -errno : 0;
+        if (parent->nofile_set_result < 0)
+                return parent_refuse(parent->nofile_set_result);
+        parent->nofile_after_result = getrlimit(RLIMIT_NOFILE, &parent->nofile_after) < 0 ? -errno : 0;
+        if (parent->nofile_after_result < 0)
+                return parent_refuse(parent->nofile_after_result);
+        if (parent->nofile_after.rlim_cur != nofile.rlim_cur || parent->nofile_after.rlim_max != nofile.rlim_max)
+                return parent_refuse(-ERANGE);
+        r = parent_pin_members();
+        if (r < 0)
+                return parent_refuse(r);
+        parent->installed = true;
+        return parent_check_all();
+}
+
+bool aos_resource_parent_member_name(const char *name) {
+        return aos_resource_parent_original()->selected && parent_member_index(name) >= 0;
+}
+
+bool aos_resource_parent_protected_unit(const Unit *unit) {
+        const char *alias;
+
+        if (!aos_resource_parent_original()->selected)
+                return false;
+        if (unit_has_name(unit, SPECIAL_INIT_SCOPE) || aos_resource_parent_member_name(unit->id))
+                return true;
+        SET_FOREACH(alias, unit->aliases)
+                if (aos_resource_parent_member_name(alias))
+                        return true;
+        return false;
+}
+
+int aos_resource_parent_context(Unit *unit, bool project) {
+        CGroupContext *context = unit_get_cgroup_context(unit);
+        unsigned enclosure;
+        const uint8_t *vector;
+        int r;
+
+        if (!aos_resource_parent_original()->selected ||
+            (!unit_has_name(unit, SPECIAL_ROOT_SLICE) && !streq_ptr(unit->id, SPECIAL_INIT_SCOPE) &&
+             !streq_ptr(unit->id, "aoscomponents.slice")))
+                return 0;
+        r = aos_resource_parent_error();
+        if (r < 0)
+                return r;
+        if (unit_has_name(unit, SPECIAL_ROOT_SLICE))
+                return context && (context->disable_controllers & AOS_PARENT_CONTROLLERS) ?
+                        parent_refuse(-EPERM) : 0;
+        if (streq_ptr(unit->id, SPECIAL_INIT_SCOPE))
+                enclosure = 0;
+        else if (streq_ptr(unit->id, "aoscomponents.slice"))
+                enclosure = 1;
+        else
+                return 0;
+        if (!context || !aos_resource_parent_original()->installed)
+                return parent_refuse(-EOWNERDEAD);
+        vector = parent_vector(enclosure);
+        if (project && enclosure == 0) {
+                /* init.scope is synthesized AFTER generators. Preserve the
+                 * already installed M rather than applying default infinity. */
+                context->cpu_quota_per_sec_usec = policy_u64(vector) * 10;
+                context->cpu_quota_period_usec = 100000;
+                context->memory_max = policy_u64(vector + 8);
+                context->startup_memory_max = context->memory_max;
+                context->startup_memory_max_set = true;
+                context->tasks_max = (CGroupTasksMax) { .value = policy_u64(vector + 16), .scale = 0 };
+        }
+        if (context->delegate || (context->disable_controllers & AOS_PARENT_CONTROLLERS) ||
+            context->cpu_quota_per_sec_usec != policy_u64(vector) * 10 ||
+            context->cpu_quota_period_usec != 100000 ||
+            context->memory_max != policy_u64(vector + 8) ||
+            (context->startup_memory_max_set && context->startup_memory_max != context->memory_max) ||
+            context->tasks_max.scale != 0 || context->tasks_max.value != policy_u64(vector + 16))
+                return parent_refuse(-EPERM);
+        return 0;
+}
+
+int aos_resource_parent_controls(Unit *unit) {
+        if (!aos_resource_parent_original()->selected ||
+            (!streq_ptr(unit->id, SPECIAL_INIT_SCOPE) && !streq_ptr(unit->id, "aoscomponents.slice")))
+                return 0;
+        return parent_check_all();
+}
+
+int aos_resource_parent_enabled(Unit *unit, int result, CGroupMask enabled) {
+        AosResourceParent *parent = aos_resource_parent_original();
+        unsigned index;
+        int r;
+
+        if (!parent->selected)
+                return 0;
+        if (unit_has_name(unit, SPECIAL_ROOT_SLICE))
+                index = 0;
+        else if (streq_ptr(unit->id, "aoscomponents.slice"))
+                index = 1;
+        else
+                return 0;
+        r = aos_resource_parent_error();
+        if (r < 0)
+                return r;
+        parent->later_enable_results[index] = result;
+        parent->later_enabled[index] = enabled;
+        if (result < 0)
+                return parent_refuse(result);
+        return FLAGS_SET(enabled, AOS_PARENT_CONTROLLERS) ? 0 : parent_refuse(-EOPNOTSUPP);
+}
+
+int aos_resource_parent_prepare_exec(Service *service, ExecCommand *command, ExecFlags flags) {
+        const struct rlimit *nofile = service->exec_context.rlimit[RLIMIT_NOFILE];
+        uint64_t ceiling = policy_u64(aos_resource_parent_original()->manifest + 400);
+        AosParentExecCheck *check;
+        int r;
+
+        if (!aos_resource_parent_protected_unit(UNIT(service)))
+                return 0;
+        r = aos_resource_parent_error();
+        if (r < 0)
+                return r;
+        if (!aos_resource_parent_member_name(UNIT(service)->id))
+                return parent_refuse(-EPERM);
+        check = &aos_resource_parent_original()->exec_checks[parent_member_index(UNIT(service)->id)];
+        check->nofile_present = nofile != NULL;
+        check->nofile = nofile ? *nofile : (struct rlimit) {};
+        check->flags = flags;
+        check->command_flags = command->flags;
+        check->permissions_start_only = service->permissions_start_only;
+        if (check->permissions_start_only || FLAGS_SET(check->command_flags, EXEC_COMMAND_FULLY_PRIVILEGED) ||
+            !FLAGS_SET(check->flags, EXEC_APPLY_SANDBOXING) || !check->nofile_present || check->nofile.rlim_cur == 0 ||
+            check->nofile.rlim_cur > ceiling || check->nofile.rlim_max > ceiling ||
+            !streq_ptr(unit_slice_name(UNIT(service)), "aoscomponents.slice"))
+                return parent_refuse(-EPERM);
+        r = aos_resource_parent_verify_fragment(UNIT(service));
+        return r < 0 ? parent_refuse(r) : parent_check_all();
+}
+
+int aos_resource_parent_arm_exec(Service *service) {
+        AosParentExecCheck *check;
+        int r;
+
+        if (!aos_resource_parent_protected_unit(UNIT(service)))
+                return 0;
+        r = aos_resource_parent_error();
+        if (r < 0)
+                return r;
+        if (!aos_resource_parent_member_name(UNIT(service)->id))
+                return parent_refuse(-EPERM);
+        check = &aos_resource_parent_original()->exec_checks[parent_member_index(UNIT(service)->id)];
+        if (check->prepare_pending)
+                return parent_refuse(-EALREADY);
+        check->prepare_unit = UNIT(service);
+        check->prepare_pending = true;
+        return 0;
+}
+
+int aos_resource_parent_enforce_exec(Service *service, int prepare_result) {
+        _cleanup_close_ int fd = -EBADF;
+        CGroupRuntime *runtime;
+        AosParentExecCheck *check;
+        int r;
+
+        if (!aos_resource_parent_protected_unit(UNIT(service)))
+                return prepare_result;
+        if (!aos_resource_parent_member_name(UNIT(service)->id))
+                return parent_refuse(-EPERM);
+        check = &aos_resource_parent_original()->exec_checks[parent_member_index(UNIT(service)->id)];
+        if (!check->prepare_pending || check->prepare_unit != UNIT(service)) {
+                r = aos_resource_parent_error();
+                return r < 0 ? r : parent_refuse(-EOWNERDEAD);
+        }
+        /* Settle the genuinely entered call even when a nested context/control
+         * supplier failed. Later refusals cannot replace its native outcome. */
+        check->prepare_result = prepare_result;
+        check->prepare_pending = false;
+        r = aos_resource_parent_error();
+        if (r < 0)
+                return r;
+        if (prepare_result < 0)
+                return parent_refuse(prepare_result);
+        runtime = unit_get_cgroup_runtime(UNIT(service));
+        if (!runtime || !streq_ptr(runtime->cgroup_path, strjoina("/aoscomponents.slice/", UNIT(service)->id)) ||
+            runtime->cgroup_id == 0)
+                return parent_refuse(-EPERM);
+        fd = openat(aos_resource_parent_original()->limits[1].directory_fd, UNIT(service)->id,
+                    O_PATH | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
+        check->directory_result = fd;
+        if (fd < 0)
+                return parent_refuse(check->directory_result = -errno);
+        check->stat_result = fstat(fd, &check->directory) < 0 ? -errno : 0;
+        if (check->stat_result < 0)
+                return parent_refuse(check->stat_result);
+        if (check->directory.st_dev != aos_resource_parent_original()->limits[1].directory_stat.st_dev)
+                return parent_refuse(-EOWNERDEAD);
+        check->identity_result = fd_to_handle_u64(fd, &check->cgroup_id);
+        if (check->identity_result < 0)
+                return parent_refuse(check->identity_result);
+        if (check->cgroup_id != runtime->cgroup_id)
+                return parent_refuse(-EOWNERDEAD);
+        r = parent_check_all();
+        return r < 0 ? r : 0;
+}
+
+int aos_resource_parent_reload(Manager *manager) {
+        int r;
+
+        if (!aos_resource_parent_original()->selected)
+                return 0;
+        r = aos_resource_parent_error();
+        if (r < 0)
+                return r;
+        if (aos_resource_parent_original()->manager != manager)
+                return parent_refuse(-EOWNERDEAD);
+        r = parent_check_all();
+        /* Reload clears units and discards generator errors. Until a genuine
+         * original restoration path exists, reject BEFORE that destructive cut. */
+        return r < 0 ? r : -EPERM;
+}
+
+int aos_resource_parent_reexecute(void) {
+        int r = aos_resource_parent_error();
+
+        if (r < 0)
+                return r;
+        /* do_reexecute resets NOFILE before exec. Do not lose these originals
+         * and later pretend a restored capsule can reconstruct their custody. */
+        return aos_resource_parent_original()->selected ? -EPERM : 0;
+}
+
+int aos_resource_parent_fragment(Unit *unit, const char *effective_path, char **ret_path, int *ret_fd) {
+        int member = parent_member_index(unit->id);
+        AosParentFile *original;
+        int r;
+
+        if (!aos_resource_parent_original()->selected || member < 0)
+                return 0;
+        r = aos_resource_parent_error();
+        if (r < 0)
+                return r;
+        if (unit->transient || !set_isempty(unit->aliases) || !isempty(unit->source_path))
+                return parent_refuse(-EPERM);
+        original = &aos_resource_parent_original()->files[member][0];
+        r = parent_compare_effective(original, effective_path);
+        if (r < 0)
+                return parent_refuse(r);
+        *ret_path = strdup(original->physical_path);
+        if (!*ret_path)
+                return parent_refuse(-ENOMEM);
+        *ret_fd = fcntl(original->fd, F_DUPFD_CLOEXEC, 3);
+        if (*ret_fd < 0)
+                return parent_refuse(-errno);
+        if (lseek(*ret_fd, 0, SEEK_SET) < 0)
+                return parent_refuse(-errno);
+        return 1;
+}
+
+int aos_resource_parent_dropins(Unit *unit, char **paths, int lookup_result) {
+        int member = parent_member_index(unit->id);
+        unsigned count;
+        int r;
+
+        if (!aos_resource_parent_protected_unit(unit))
+                return 0;
+        r = aos_resource_parent_error();
+        if (r < 0)
+                return r;
+        if (lookup_result < 0)
+                return parent_refuse(lookup_result);
+        count = member < 0 ? 0 : parent_u16(parent_row(member) + 352);
+        if (strv_length(paths) != count)
+                return parent_refuse(-EPERM);
+        for (unsigned file = 1; file <= count; file++) {
+                AosParentFile *original = &aos_resource_parent_original()->files[member][file];
+
+                /* The actual effective list includes all lookup roots,
+                 * aliases and type/hierarchy drop-ins. No extra/mask wins. */
+                if (!endswith(paths[file - 1], strjoina("/", parent_file_path(member, file))))
+                        return parent_refuse(-EOWNERDEAD);
+                r = parent_compare_effective(original, paths[file - 1]);
+                if (r < 0)
+                        return parent_refuse(r);
+        }
+        return 0;
+}
+
+int aos_resource_parent_dropin_fd(Unit *unit, unsigned file) {
+        int member = parent_member_index(unit->id);
+        int fd, r;
+
+        r = aos_resource_parent_error();
+        if (r < 0)
+                return r;
+        if (member < 0 || file == 0 || file > parent_u16(parent_row(member) + 352))
+                return parent_refuse(-EPERM);
+        fd = fcntl(aos_resource_parent_original()->files[member][file].fd, F_DUPFD_CLOEXEC, 3);
+        if (fd < 0)
+                return parent_refuse(-errno);
+        if (lseek(fd, 0, SEEK_SET) < 0) {
+                int error = -errno;
+
+                safe_close(fd);
+                return parent_refuse(error);
+        }
+        return fd;
+}
+
+int aos_resource_parent_verify_fragment(const Unit *unit) {
+        int member = parent_member_index(unit->id);
+        const AosParentFile *original;
+        int r;
+
+        r = aos_resource_parent_error();
+        if (r < 0)
+                return r;
+        if (member < 0 || unit->transient || unit->load_state != UNIT_LOADED ||
+            !set_isempty(unit->aliases) || !isempty(unit->source_path))
+                return -EPERM;
+        original = &aos_resource_parent_original()->files[member][0];
+        if (!unit->aos_image_fragment_pinned ||
+            unit->aos_image_fragment_device != original->stat.st_dev ||
+            unit->aos_image_fragment_inode != original->stat.st_ino ||
+            !streq_ptr(unit->fragment_path, strjoina("/nix/store/", original->physical_path + strlen("/nix.lower/store/"))))
+                return -EOWNERDEAD;
+        return aos_resource_parent_dropins((Unit*) unit, unit->dropin_paths, 0);
+}
