+} AosParentCheck;
+
+typedef struct AosParentLimits {
+        int directory_fd;
+        int control_fds[3];
+        struct stat directory_stat;
+        struct statfs filesystem;
+        struct stat control_stats[3];
+        int directory_stat_result;
+        int filesystem_result;
+        int control_stat_results[3];
+        ssize_t write_lengths[3];
+        int write_results[3];
+        AosParentCheck first;
+        AosParentCheck later;
+} AosParentLimits;
+
+typedef struct AosParentFile {
+        int fd;
+        char *physical_path;
+        struct stat stat;
+        int stat_result;
+        ssize_t read_length;
+        int read_result;
+        uint8_t digest[SHA256_DIGEST_SIZE];
+        struct stat effective_stat;
+        int effective_open_result;
+        int effective_stat_result;
+        ssize_t effective_read_length;
+        int effective_read_result;
+        uint8_t effective_digest[SHA256_DIGEST_SIZE];
+} AosParentFile;
+
+typedef struct AosParentExecCheck {
+        struct rlimit nofile;
+        bool nofile_present;
+        ExecFlags flags;
+        ExecCommandFlags command_flags;
+        bool permissions_start_only;
+        /* Synchronous borrow: only the armed native prepare return may settle. */
+        Unit *prepare_unit;
+        bool prepare_pending;
+        int prepare_result;
+        int directory_result;
+        struct stat directory;
+        int stat_result;
+        uint64_t cgroup_id;
+        int identity_result;
+} AosParentExecCheck;
+
+typedef struct AosResourceParent {
+        Manager *setup_manager;
+        Manager *manager;
+        const uint8_t *policy;
+        size_t policy_bytes;
+        bool setup_seen;
+        int attach_result;
+        int migrate_result;
+        bool attempted;
+        bool selected;
+        bool installed;
+        int first_error;
+        int config_fds[2];
+        bool absent[2];
+        struct stat config_stats[2];
+        int config_stat_results[2];
+        ssize_t config_read_lengths[2];
+        int config_read_results[2];
+        uint8_t selector[9];
+        uint8_t manifest[AOS_PARENT_MAX_BYTES + 1];
+        size_t manifest_bytes;
+        unsigned members;
+        int enable_result;
+        CGroupMask enabled;
+        int create_result;
+        int later_enable_results[2];
+        CGroupMask later_enabled[2];
+        AosParentLimits limits[2];
+        AosParentFile files[AOS_PARENT_MEMBERS][5];
+        AosParentExecCheck exec_checks[AOS_PARENT_MEMBERS];
+        uint8_t file_bytes[AOS_PARENT_FILE_BYTES + 1];
+        struct rlimit nofile_before;
+        struct rlimit nofile_after;
+        struct rlimit nofile_later;
+        int nofile_before_result;
+        int nofile_set_result;
+        int nofile_after_result;
+        int nofile_later_result;
+        char *pid1_first_path;
+        char *pid1_later_path;
+        int pid1_first_result;
+        int pid1_later_result;
+} AosResourceParent;
+
+/* Internal native lifecycle seams, never public resource authority. */
+void aos_resource_parent_setup_result(Manager *manager, int attach_result, int migrate_result);
+int aos_resource_parent_begin(Manager *manager, bool restoring);
+int aos_resource_parent_error(void);
+bool aos_resource_parent_member_name(const char *name);
+bool aos_resource_parent_protected_unit(const Unit *unit);
+const char *aos_resource_parent_member_path(const char *name, unsigned file);
+int aos_resource_parent_context(Unit *unit, bool project);
+int aos_resource_parent_controls(Unit *unit);
+int aos_resource_parent_enabled(Unit *unit, int result, CGroupMask enabled);
+int aos_resource_parent_prepare_exec(Service *service, ExecCommand *command, ExecFlags flags);
+int aos_resource_parent_arm_exec(Service *service);
+int aos_resource_parent_enforce_exec(Service *service, int prepare_result);
+int aos_resource_parent_reload(Manager *manager);
+int aos_resource_parent_reexecute(void);
+int aos_resource_parent_fragment(Unit *unit, const char *effective_path, char **ret_path, int *ret_fd);
+int aos_resource_parent_dropins(Unit *unit, char **paths, int lookup_result);
+int aos_resource_parent_dropin_fd(Unit *unit, unsigned file);
+int aos_resource_parent_verify_fragment(const Unit *unit);
