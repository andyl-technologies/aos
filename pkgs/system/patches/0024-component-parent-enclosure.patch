+#define AOS_PARENT_MEMBERS 16U
+#define AOS_PARENT_ROW_BYTES 1506U
+#define AOS_PARENT_HEADER_BYTES 454U
+#define AOS_PARENT_MAX_BYTES (486U + AOS_PARENT_MEMBERS * AOS_PARENT_ROW_BYTES)
+#define AOS_PARENT_FILE_BYTES 65536U
+#define AOS_PARENT_CONTROLLERS (CGROUP_MASK_CPU | CGROUP_MASK_MEMORY | CGROUP_MASK_PIDS)
