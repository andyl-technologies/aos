+static int controller_launch_refuse(int error) {
+        AosControllerRestart *original = &enrollment.controller_restart;
+
+        if (original->first_error == 0)
+                original->first_error = error;
+        if (original->ack_event && !original->event_disabled) {
+                original->event_disabled = true;
+                original->event_disable_result = sd_event_source_set_enabled(original->ack_event, SD_EVENT_OFF);
+        }
+        return aos_resource_parent_fail(original->first_error);
+}
