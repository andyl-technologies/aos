+TEST(scoped_allocation_refuses_growth_before_realloc) {
+        AllocationAccount account = { .memory_limit = 8, .files_limit = 1 };
+        AllocationAccountScope scope = {};
+
+        assert_se(allocation_account_enter(&account, &scope) == 0);
+        char *original = new(char, 8);
+        assert_se(original);
+        memcpy(original, "retained", 8);
+
+        char *grown = allocation_account_realloc(original, 16);
+        assert_se(!grown);
+        assert_se(memcmp(original, "retained", 8) == 0);
+        assert_se(!new(char, 1));
+        assert_se(account.first_error == -ENOSPC);
+        assert_se(account.refusal.memory_requested == 16);
+
+        allocation_account_leave(&scope);
+        assert_se(!allocation_account_active());
+        assert_se(allocation_account_enter(&account, &scope) == -ENOSPC);
+        assert_se(memcmp(original, "retained", 8) == 0);
+        free(original);
+}
