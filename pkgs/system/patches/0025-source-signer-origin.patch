+        assert_se(before.st_ino == after.st_ino && before.st_mode == after.st_mode);
+}
+
+TEST(scoped_recursive_chown_refuses_child_before_metadata_mutation) {
+        _cleanup_(rm_rf_physical_and_freep) char *path = NULL;
+        struct stat before, after;
+        assert_se(mkdtemp_malloc(NULL, &path) >= 0);
+        const char *child = strjoina(path, "/child");
+        assert_se(mknod(child, S_IFREG | 0600, 0) >= 0);
+        assert_se(stat(child, &before) >= 0);
+
+        AllocationAccount account = {
+                .memory_limit = 2U * 1048576U,
+                .resource_tracking = true,
+                .resource_limits[ALLOCATION_METADATA] = 0,
+        };
+        _cleanup_(allocation_account_leave) AllocationAccountScope scope = {};
+        assert_se(allocation_account_enter(&account, &scope) >= 0);
+        assert_se(path_chown_recursive(path, UID_INVALID, GID_INVALID, 0, 0) == -ENOSPC);
+
+        assert_se(account.memory_charged >= 1048576U);
+        assert_se(account.first_error == -ENOSPC);
+        assert_se(account.persistent_refusal.requested[3] == 1);
+        assert_se(stat(child, &after) >= 0);
+        assert_se(before.st_ino == after.st_ino && before.st_mode == after.st_mode);
+}
