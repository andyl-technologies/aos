diff --git a/src/basic/allocation-accounting.c b/src/basic/allocation-accounting.c
--- /dev/null
+++ b/src/basic/allocation-accounting.c
@@ -0,0 +1,297 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "allocation-accounting.h"
+
+/* The manager calls its exec path synchronously. A second scope is refused,
+ * including reentry from a callback: it cannot exchange the current payer. */
+static _Thread_local AllocationAccount *current_account;
+
+static int refuse(AllocationAccount *account, AllocationAccountAttempt attempt) {
+        if (account->first_error == 0) {
+                account->closed = true;
+                account->first_error = attempt.result;
+                account->refusal = attempt;
+        }
+
+        return account->first_error;
+}
+
+int allocation_account_enter(AllocationAccount *account, AllocationAccountScope *scope) {
+        if (!account || !scope)
+                return -EINVAL;
+        if (account->first_error < 0)
+                return account->first_error;
+        if (account->closed || account->active || scope->installed || current_account)
+                return refuse(account, (AllocationAccountAttempt) { .result = -EALREADY });
+
+        account->entered = true;
+        account->active = true;
+        scope->account = account;
+        scope->installed = true;
+        current_account = account;
+        return 0;
+}
+
+int allocation_account_require_current(const AllocationAccount *account) {
+        if (!account)
+                return -EINVAL;
+        if (account->first_error < 0)
+                return account->first_error;
+        if (current_account != account || !account->entered || !account->active || account->closed)
+                return -EOWNERDEAD;
+
+        return 0;
+}
+
+void allocation_account_leave(AllocationAccountScope *scope) {
+        if (!scope || !scope->installed)
+                return;
+
+        AllocationAccount *account = scope->account;
+        if (current_account == account)
+                current_account = NULL;
+        else
+                (void) refuse(account, (AllocationAccountAttempt) { .result = -EOWNERDEAD });
+
+        account->active = false;
+        scope->installed = false;
+}
+
+int allocation_account_charge(size_t memory, unsigned files) {
+        AllocationAccount *account = current_account;
+        if (!account)
+                return 0;
+        if (account->first_error < 0)
+                return account->first_error;
+
+        AllocationAccountAttempt attempt = {
+                .memory_before = account->memory_charged,
+                .files_before = account->files_charged,
+                .memory_requested = memory,
+                .files_requested = files,
+        };
+
+        if (memory > UINT64_MAX - account->memory_charged || files > UINT64_MAX - account->files_charged)
+                attempt.result = -EOVERFLOW;
+        else if (account->memory_charged + memory > account->memory_limit ||
+                 account->files_charged + files > account->files_limit)
+                attempt.result = -ENOSPC;
+        if (attempt.result < 0)
+                return refuse(account, attempt);
+
+        account->last_admission = attempt;
+        account->memory_charged += memory;
+        account->files_charged += files;
+        return 0;
+}
+
+int allocation_account_charge_persistent(uint64_t memory, uint64_t mounts,
+                                         uint64_t tmpfs, uint64_t metadata) {
+        AllocationAccount *account = current_account;
+        if (!account || !account->resource_tracking)
+                return 0;
+        if (account->first_error < 0)
+                return account->first_error;
+
+        const struct { unsigned dimension; uint64_t amount; } additions[] = {
+                { ALLOCATION_MEMORY, memory },
+                { ALLOCATION_MOUNTS, mounts },
+                { ALLOCATION_TMPFS, tmpfs },
+                { ALLOCATION_METADATA, metadata },
+        };
+        AllocationAccountAttempt attempt = {
+                .memory_before = account->memory_charged,
+                .files_before = account->files_charged,
+        };
+        AllocationPersistentAttempt persistent = {};
+        for (size_t i = 0; i < sizeof(additions) / sizeof(additions[0]); i++) {
+                persistent.before[i] = account->persistent_usage[additions[i].dimension];
+                persistent.requested[i] = additions[i].amount;
+        }
+        for (size_t i = 0; i < sizeof(additions) / sizeof(additions[0]); i++) {
+                unsigned dimension = additions[i].dimension;
+                uint64_t amount = additions[i].amount;
+                uint64_t before = persistent.before[i];
+                if (amount > UINT64_MAX - before)
+                        attempt.result = -EOVERFLOW;
+                else if (before + amount > account->resource_limits[dimension])
+                        attempt.result = -ENOSPC;
+                if (attempt.result < 0) {
+                        persistent.result = attempt.result;
+                        account->persistent_refusal = persistent;
+                        return refuse(account, attempt);
+                }
+        }
+        if (memory > SIZE_MAX) {
+                persistent.result = -EOVERFLOW;
+                account->persistent_refusal = persistent;
+                return refuse(account, (AllocationAccountAttempt) { .result = -EOVERFLOW });
+        }
+        int r = allocation_account_charge((size_t) memory, 0);
+        if (r < 0) {
+                persistent.result = r;
+                account->persistent_refusal = persistent;
+                return r;
+        }
+        account->last_persistent_admission = persistent;
+        for (size_t i = 0; i < sizeof(additions) / sizeof(additions[0]); i++)
+                account->persistent_usage[additions[i].dimension] += additions[i].amount;
+        return 0;
+}
+
+void allocation_account_native_failure(int error) {
+        if (current_account && error < 0) {
+                AllocationAccountAttempt attempt = current_account->last_admission;
+                attempt.result = error;
+                (void) refuse(current_account, attempt);
+        }
+}
+
+bool allocation_account_active(void) {
+        return current_account != NULL;
+}
+
+static bool admit(size_t bytes) {
+        if (allocation_account_charge(bytes, 0) >= 0)
+                return true;
+
+        errno = ENOMEM;
+        return false;
+}
+
+void *allocation_account_malloc(size_t bytes) {
+        if (!admit(bytes))
+                return NULL;
+
+        void *result = malloc(bytes);
+        if (!result)
+                allocation_account_native_failure(-ENOMEM);
+        return result;
+}
+
+void *allocation_account_calloc(size_t count, size_t size) {
+        if (count != 0 && size > SIZE_MAX / count) {
+                allocation_account_native_failure(-EOVERFLOW);
+                errno = ENOMEM;
+                return NULL;
+        }
+        if (!admit(count * size))
+                return NULL;
+
+        void *result = calloc(count, size);
+        if (!result)
+                allocation_account_native_failure(-ENOMEM);
+        return result;
+}
+
+void *allocation_account_realloc(void *previous, size_t bytes) {
+        if (!admit(bytes))
+                return NULL;
+
+        void *result = realloc(previous, bytes);
+        if (!result && bytes != 0)
+                allocation_account_native_failure(-ENOMEM);
+        return result;
+}
+
+void *allocation_account_reallocarray(void *previous, size_t count, size_t size) {
+        if (!current_account)
+                return reallocarray(previous, count, size);
+        if (count != 0 && size > SIZE_MAX / count) {
+                allocation_account_native_failure(-EOVERFLOW);
+                errno = ENOMEM;
+                return NULL;
+        }
+
+        return allocation_account_realloc(previous, count * size);
+}
+
+char *allocation_account_strdup(const char *value) {
+        if (!current_account)
+                return strdup(value);
+
+        size_t length = strlen(value);
+        if (length == SIZE_MAX) {
+                allocation_account_native_failure(-EOVERFLOW);
+                errno = ENOMEM;
+                return NULL;
+        }
+
+        char *result = allocation_account_malloc(length + 1);
+        if (result)
+                memcpy(result, value, length + 1);
+        return result;
+}
+
+char *allocation_account_strndup(const char *value, size_t maximum) {
+        if (!current_account)
+                return strndup(value, maximum);
+
+        size_t length = strnlen(value, maximum);
+        if (length == SIZE_MAX) {
+                allocation_account_native_failure(-EOVERFLOW);
+                errno = ENOMEM;
+                return NULL;
+        }
+
+        char *result = allocation_account_malloc(length + 1);
+        if (result) {
+                memcpy(result, value, length);
+                result[length] = 0;
+        }
+        return result;
+}
+
+/* The format is the existing systemd helper's compiled format, not untrusted
+ * input. A sized second rendering uses that same formatter and avoids libc's
+ * hidden growable vasprintf buffer while a launch account is active. */
+int allocation_account_vasprintf(char **result, const char *format, va_list arguments) {
+        if (!current_account)
+                return vasprintf(result, format, arguments);
+
+        int original_errno = errno;
+        *result = NULL;
+        va_list copy;
+        va_copy(copy, arguments);
+        int length = vsnprintf(NULL, 0, format, copy);
+        va_end(copy);
+        if (length < 0) {
+                allocation_account_native_failure(errno > 0 ? -errno : -EIO);
+                return length;
+        }
+
+        size_t capacity = (size_t) length + 1;
+        char *buffer = allocation_account_malloc(capacity);
+        if (!buffer)
+                return -1;
+
+        va_copy(copy, arguments);
+        errno = original_errno;
+        int written = vsnprintf(buffer, capacity, format, copy);
+        va_end(copy);
+        if (written < 0 || written != length) {
+                allocation_account_native_failure(written < 0 && errno > 0 ? -errno : -EOVERFLOW);
+                free(buffer);
+                return -1;
+        }
+
+        *result = buffer;
+        return written;
+}
+
+int allocation_account_asprintf(char **result, const char *format, ...) {
+        va_list arguments;
+        va_start(arguments, format);
+        int r = allocation_account_vasprintf(result, format, arguments);
+        va_end(arguments);
+        return r;
+}
+
+bool allocation_account_tracks_resources(void) {
+        return current_account && current_account->resource_tracking;
+}
diff --git a/src/basic/allocation-accounting.h b/src/basic/allocation-accounting.h
--- /dev/null
+++ b/src/basic/allocation-accounting.h
@@ -0,0 +1,89 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include <stdarg.h>
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+/* Restrictive allocation accounting DATA. A scope cannot establish an image
+ * payer, recipient, currentness or permission to start an operation. The closed
+ * original owner must admit the account before installing its synchronous scope.
+ * Refused and failed allocations remain charged; no destructor refunds them. */
+typedef struct AllocationAccountAttempt {
+        uint64_t memory_before;
+        uint64_t files_before;
+        size_t memory_requested;
+        unsigned files_requested;
+        int result;
+} AllocationAccountAttempt;
+
+/* Stable passive vector order matches the Core ResourceDimension wire order.
+ * Only a genuinely prepaid Source executor installs resource_tracking; ordinary
+ * manager accounts continue to restrict their existing memory/file dimensions. */
+enum {
+        ALLOCATION_RESOURCE_DIMENSIONS = 22,
+        ALLOCATION_MEMORY = 1,
+        ALLOCATION_FILES = 3,
+        ALLOCATION_MOUNTS = 4,
+        ALLOCATION_TMPFS = 7,
+        ALLOCATION_METADATA = 10,
+};
+
+typedef struct AllocationPersistentAttempt {
+        uint64_t before[4];
+        uint64_t requested[4];
+        int result;
+} AllocationPersistentAttempt;
+
+typedef struct AllocationAccount {
+        uint64_t memory_limit;
+        uint64_t files_limit;
+        uint64_t memory_charged;
+        uint64_t files_charged;
+        bool resource_tracking;
+        uint64_t resource_limits[ALLOCATION_RESOURCE_DIMENSIONS];
+        uint64_t persistent_usage[ALLOCATION_RESOURCE_DIMENSIONS];
+        bool entered;
+        bool active;
+        bool closed;
+        int first_error;
+        AllocationAccountAttempt last_admission;
+        AllocationAccountAttempt refusal;
+        AllocationPersistentAttempt last_persistent_admission;
+        AllocationPersistentAttempt persistent_refusal;
+} AllocationAccount;
+
+typedef struct AllocationAccountScope {
+        AllocationAccount *account;
+        bool installed;
+} AllocationAccountScope;
+
+/* Successful synchronous scopes may resume the SAME monotone account.
+ * There is deliberately no implicit reset, refund or nesting. These internal
+ * DATA operations add restrictions; they do not return an authority loan. */
+int allocation_account_enter(AllocationAccount *account, AllocationAccountScope *scope);
+/* Final native crossings must require the SAME active original explicitly;
+ * best-effort helpers can preserve a value after a refused allocation. */
+int allocation_account_require_current(const AllocationAccount *account);
+void allocation_account_leave(AllocationAccountScope *scope);
+int allocation_account_charge(size_t memory, unsigned files);
+void allocation_account_native_failure(int error);
+bool allocation_account_active(void);
+int allocation_account_vasprintf(char **result, const char *format, va_list arguments);
+int allocation_account_asprintf(char **result, const char *format, ...);
+
+void *allocation_account_malloc(size_t bytes);
+void *allocation_account_calloc(size_t count, size_t size);
+void *allocation_account_realloc(void *previous, size_t bytes);
+void *allocation_account_reallocarray(void *previous, size_t count, size_t size);
+char *allocation_account_strdup(const char *value);
+char *allocation_account_strndup(const char *value, size_t maximum);
+
+/* Debits persistent namespace backing before its existing native/growth
+ * frontier. These are restrictions on the active original, never a grant;
+ * inactive ordinary and manager-only scopes retain their original behavior. */
+int allocation_account_charge_persistent(uint64_t memory, uint64_t mounts,
+                                         uint64_t tmpfs, uint64_t metadata);
+
+bool allocation_account_tracks_resources(void);
