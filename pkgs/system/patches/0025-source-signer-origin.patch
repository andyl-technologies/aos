+
+int aos_source_executor_nofile_argument(const char *value) {
+        uint64_t limit;
+        if (!original.entered || safe_atou64(value, &limit) < 0 || limit != original.early_nofile)
+                return refuse(original.first_error < 0 ? original.first_error : -EOWNERDEAD);
+        return 0;
+}
+
+int aos_source_executor_channel(void) {
+        return original.entered && original.context_attempted && original.first_error == 0 &&
+                original.named_channel_result == 0 ? original.initial_channel : -EBADF;
+}
+
+int aos_source_executor_namespace_entry(void) {
+        if (!original.entered)
+                return 0;
+        if (original.first_error < 0)
+                return original.first_error;
+        if (!original.context_attempted || original.namespace_attempted)
+                return refuse(-EALREADY);
+        original.namespace_attempted = true;
+        /* This is the actual frontier immediately before namespace setup.
+         * Privileged setup avoids the implicit helper fork used by the generic
+         * executor's unprivileged private-user fallback. */
+        original.capability_result = have_effective_cap(CAP_SYS_ADMIN);
+        return original.capability_result > 0 ? allocation_account_require_current(&original.account) :
+                refuse(original.capability_result < 0 ? original.capability_result : -EPERM);
+}
