+typedef enum ParentSenderPurpose {
+        PARENT_SENDER_SOURCE,
+        PARENT_SENDER_OWNERSHIP,
+        PARENT_SENDER_CONTROLLER_SUCCESSOR,
+} ParentSenderPurpose;
+
+static AosParentSenderAdmission *sender_admission(ParentSenderPurpose purpose) {
+        AosResourceParent *parent = aos_resource_parent_original();
+
+        switch (purpose) {
+        case PARENT_SENDER_SOURCE:
+                return &parent->source_sender;
+        case PARENT_SENDER_OWNERSHIP:
+                return &parent->ownership_sender;
+        case PARENT_SENDER_CONTROLLER_SUCCESSOR:
+                return &parent->controller_sender;
+        default:
+                assert_not_reached();
+        }
+}
+
+static const char *sender_unit_name(ParentSenderPurpose purpose) {
+        switch (purpose) {
+        case PARENT_SENDER_SOURCE:
+                return "aos-sandbox-source-signerd.service";
+        case PARENT_SENDER_OWNERSHIP:
+                return "aos-sandbox-ownershipd.service";
+        case PARENT_SENDER_CONTROLLER_SUCCESSOR:
+                return "aos-sandboxd.service";
+        default:
+                assert_not_reached();
+        }
+}
+
+static int admit_sender(Service *service, ParentSenderPurpose purpose) {
+        AosResourceParent *parent = aos_resource_parent_original();
+        AosParentSenderAdmission *admission = sender_admission(purpose);
+        const uint8_t *vector;
+        int r;
+
+        if (admission->entered)
+                return parent_refuse(-EALREADY);
+        admission->entered = true;
+        admission->unit = UNIT(service);
+        admission->invocation = UNIT(service)->invocation_id;
+
+        switch (purpose) {
+        case PARENT_SENDER_SOURCE:
+                vector = source_sender_vector();
+                admission->memory = aos_resource_source_origin_memory();
+                admission->files = aos_resource_source_origin_files();
+                break;
+        case PARENT_SENDER_OWNERSHIP:
+                vector = ownership_sender_vector();
+                admission->memory = aos_resource_ownership_origin_memory();
+                admission->files = aos_resource_ownership_origin_files();
+                break;
+        case PARENT_SENDER_CONTROLLER_SUCCESSOR:
+                vector = controller_sender_vector();
+                admission->memory = aos_resource_controller_successor_memory();
+                admission->files = aos_resource_controller_successor_files();
+                break;
+        default:
+                assert_not_reached();
+        }
+
+        /* This initial image-paid intake permits only bounded currentness
+         * capture. Native rereads happen after the same account is installed;
+         * historical configuration is not promoted into policy authority. */
+        r = parent->first_error;
+        if (r >= 0 && (!parent->selected || !parent->installed || getpid() != 1 ||
+                      parent->manager != UNIT(service)->manager ||
+                      !streq_ptr(UNIT(service)->id, sender_unit_name(purpose)) ||
+                      sd_id128_is_null(admission->invocation)))
+                r = -EOWNERDEAD;
+        if (r >= 0 && (policy_u64(vector) == 0 || policy_u64(vector + 8) < admission->memory ||
+                      policy_u64(vector + 24) < admission->files || policy_u64(vector + 21U * 8U) != 1))
+                r = -ENOSPC;
+        admission->result = r;
+        if (r < 0)
+                return parent_refuse(r);
+
+        admission->account = (AllocationAccount) {
+                .memory_limit = policy_u64(vector + 8),
+                .files_limit = policy_u64(vector + 24),
+                .memory_charged = admission->memory,
+                .files_charged = admission->files,
+        };
+        return 0;
+}
+
+int aos_resource_parent_admit_controller_sender(Service *service) {
+        return admit_sender(service, PARENT_SENDER_CONTROLLER_SUCCESSOR);
+}
+
+static int enter_sender_scope(Service *service, ParentSenderPurpose purpose, AllocationAccountScope *scope) {
+        AosResourceParent *parent = aos_resource_parent_original();
+        AosParentSenderAdmission *admission = sender_admission(purpose);
+        int r;
+
+        if (parent->first_error < 0)
+                return parent->first_error;
+        if (admission->result < 0)
+                return parent_refuse(admission->result);
+        if (admission->account.first_error < 0)
+                return parent_refuse(admission->account.first_error);
+        if (!admission->entered || parent->manager != UNIT(service)->manager || !parent->installed)
+                return parent_refuse(-EOWNERDEAD);
+        if (purpose != PARENT_SENDER_CONTROLLER_SUCCESSOR) {
+                if (admission->unit != UNIT(service) ||
+                    !sd_id128_equal(admission->invocation, UNIT(service)->invocation_id))
+                        return parent_refuse(-EOWNERDEAD);
+        } else {
+                r = aos_resource_controller_sender_context(service);
+                if (r < 0)
+                        return parent_refuse(r);
+        }
+
+        r = allocation_account_enter(&admission->account, scope);
+        if (r >= 0)
+                r = parent_check_all();
+        return r < 0 ? parent_refuse(r) : 0;
+}
+
+int aos_resource_parent_begin_source_sender(Service *service, AllocationAccountScope *scope) {
+        ParentSenderPurpose purpose = ownership_unit(UNIT(service)) ? PARENT_SENDER_OWNERSHIP : PARENT_SENDER_SOURCE;
+        int r = admit_sender(service, purpose);
+        if (r < 0)
+                return r;
+
+        return enter_sender_scope(service, purpose, scope);
+}
+
+static int require_sender_scope(Service *service, ParentSenderPurpose purpose) {
+        AosResourceParent *parent = aos_resource_parent_original();
+        AosParentSenderAdmission *admission = sender_admission(purpose);
+        int r;
+
+        if (parent->first_error < 0)
+                return parent->first_error;
+        if (admission->result < 0)
+                return parent_refuse(admission->result);
+        if (admission->account.first_error < 0)
+                return parent_refuse(admission->account.first_error);
+        if (!parent->installed || parent->manager != UNIT(service)->manager || !admission->entered)
+                return parent_refuse(-EOWNERDEAD);
+
+        if (purpose != PARENT_SENDER_CONTROLLER_SUCCESSOR) {
+                if (admission->unit != UNIT(service) ||
+                    !sd_id128_equal(admission->invocation, UNIT(service)->invocation_id))
+                        return parent_refuse(-EOWNERDEAD);
+        } else {
+                r = aos_resource_controller_sender_context(service);
+                if (r < 0)
+                        return parent_refuse(r);
+        }
+        r = allocation_account_require_current(&admission->account);
+        if (r < 0)
+                return parent_refuse(r);
+
+        r = parent_check_all();
+        if (r < 0)
+                return r;
+        r = allocation_account_require_current(&admission->account);
+        return r < 0 ? parent_refuse(r) : 0;
+}
+
+int aos_resource_parent_require_source_sender(Service *service) {
+        return require_sender_scope(service, ownership_unit(UNIT(service)) ? PARENT_SENDER_OWNERSHIP : PARENT_SENDER_SOURCE);
+}
+
+int aos_resource_parent_require_controller_sender(Service *service) {
+        return require_sender_scope(service, PARENT_SENDER_CONTROLLER_SUCCESSOR);
+}
+
+int aos_resource_parent_source_exec_scope(Service *service, AllocationAccountScope *scope) {
+        return enter_sender_scope(service, ownership_unit(UNIT(service)) ? PARENT_SENDER_OWNERSHIP : PARENT_SENDER_SOURCE, scope);
+}
+
+int aos_resource_parent_controller_exec_scope(Service *service, AllocationAccountScope *scope) {
+        return enter_sender_scope(service, PARENT_SENDER_CONTROLLER_SUCCESSOR, scope);
+}
+
+int aos_resource_parent_reuse_controller_sender(Service *service) {
+        AosResourceParent *parent = aos_resource_parent_original();
+        AosParentSenderAdmission *admission = &parent->controller_sender;
+        int r;
+
+        if (parent->first_error < 0)
+                return parent->first_error;
+        if (admission->result < 0)
+                return parent_refuse(admission->result);
+        if (admission->account.first_error < 0)
+                return parent_refuse(admission->account.first_error);
+        if (!admission->entered || parent->manager != UNIT(service)->manager ||
+            !parent->installed || admission->account.active)
+                return parent_refuse(-EOWNERDEAD);
+
+        /* This consumes the actual once-only positive Controller closure. It
+         * checks bank ACK+Confirm, old death/empty-cgroup, scope completion and
+         * disposal. Neither a supplied generation nor a decoded receipt can
+         * enter this port; the verifier must refuse repeated consumption. */
+        r = aos_resource_controller_sender_completed_peak(service, admission);
+        if (r < 0)
+                return parent_refuse(r);
+
+        admission->memory_highwater = MAX(admission->memory_highwater, admission->account.memory_charged);
+        admission->files_highwater = MAX(admission->files_highwater, admission->account.files_charged);
+        admission->account = (AllocationAccount) {
+                .memory_limit = admission->account.memory_limit,
+                .files_limit = admission->account.files_limit,
+                .memory_charged = admission->memory,
+                .files_charged = admission->files,
+        };
+        return 0;
+}
