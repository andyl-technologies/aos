+                .memory_limit = 8192,
+                .resource_tracking = true,
+                .resource_limits = {
+                        [ALLOCATION_MEMORY] = 4096,
+                        [ALLOCATION_MOUNTS] = 1,
+                        [ALLOCATION_TMPFS] = 4096,
+                        [ALLOCATION_METADATA] = 3,
+                },
+        };
+        AllocationAccountScope scope = {};
+
+        assert_se(allocation_account_enter(&account, &scope) == 0);
+        assert_se(allocation_account_charge_persistent(4096, 1, 4096, 2) == 0);
+        assert_se(allocation_account_charge(128, 0) == 0);
+        allocation_account_leave(&scope);
+
+        /* The actual persistent debt differs from transient requested bytes.
+         * Scope disposal does not clear it or create a fresh resource account. */
+        assert_se(account.memory_charged == 4224);
+        assert_se(account.persistent_usage[ALLOCATION_MEMORY] == 4096);
+        assert_se(account.persistent_usage[ALLOCATION_TMPFS] == 4096);
+        assert_se(allocation_account_enter(&account, &scope) == 0);
+        assert_se(allocation_account_charge_persistent(0, 0, 0, 1) == 0);
+        assert_se(allocation_account_charge_persistent(0, 1, 0, 0) == -ENOSPC);
+        assert_se(account.persistent_usage[ALLOCATION_MOUNTS] == 1);
+        assert_se(account.persistent_usage[ALLOCATION_METADATA] == 3);
+        assert_se(account.persistent_refusal.result == -ENOSPC);
+        assert_se(allocation_account_require_current(&account) == -ENOSPC);
+        allocation_account_leave(&scope);
+}
+
+TEST(ordinary_account_does_not_reinterpret_generic_namespace_recipes) {
+        AllocationAccount account = { .memory_limit = 1 };
+        AllocationAccountScope scope = {};
+
+        assert_se(allocation_account_enter(&account, &scope) == 0);
+        assert_se(!allocation_account_tracks_resources());
+        assert_se(allocation_account_charge_persistent(UINT64_MAX, UINT64_MAX, UINT64_MAX, UINT64_MAX) == 0);
+        assert_se(allocation_account_require_current(&account) == 0);
+        assert_se(account.memory_charged == 0);
+        allocation_account_leave(&scope);
+}
+
 DEFINE_TEST_MAIN(LOG_DEBUG);
