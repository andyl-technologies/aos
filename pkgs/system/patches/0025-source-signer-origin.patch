+                                /* At most20 integers fit in the entire80B control
+                                 * buffer, even before kernel header overhead. */
+                                if (record->descriptor_count == ELEMENTSOF(record->descriptors)) {
+                                        record->malformed = true;
+                                        break;
+                                }
+                                record->descriptors[record->descriptor_count++] = fds[i];
+                        }
+                        if (header->cmsg_type == SCM_PIDFD) {
+                                record->pidfd_count++;
+                                if (count == 1)
+                                        record->kernel_pidfd = fds[0];
+                                else
+                                        record->malformed = true;
+                        } else
+                                record->rights_count++;
+                } else if (header->cmsg_type == SCM_CREDENTIALS && body == sizeof(struct ucred)) {
+                        memcpy(&record->credentials, CMSG_DATA(header), sizeof(struct ucred));
+                        record->credential_count++;
+                } else
+                        record->malformed = true;
+        }
+
+        return 0;
+}
