+        assert_se(allocation_account_asprintf(&first, "%s:%u", "Source", 23U) == 9);
+        assert_se(streq(first, "Source:23"));
+        assert_se(allocation_account_asprintf(&refused, "%080u", 1U) < 0);
+        assert_se(!refused);
+        assert_se(streq(first, "Source:23"));
+        allocation_account_leave(&scope);
+
+        assert_se(allocation_account_asprintf(&ordinary, "%080u", 1U) == 80);
+        assert_se(ordinary[79] == '1' && ordinary[80] == 0);
+        assert_se(account.refusal.memory_requested == 81);
+        free(first);
