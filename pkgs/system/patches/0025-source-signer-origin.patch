+/* This closed policy guard borrows the actual activation roster. Configuring
+ * flags later cannot bless an earlier/adopted listener: its private creation
+ * mark is set only by the successful opt-in creation below and never restored. */
+static int fixed_origin_activation_port(Service *service, SocketPort **ret) {
+        Socket *selected = NULL;
+        Unit *u;
+        bool source;
+
+        if (!service)
+                return -EPERM;
+
+        source = streq_ptr(UNIT(service)->id, "aos-sandbox-source-signerd.service");
+        if ((!source && !streq_ptr(UNIT(service)->id, "aos-sandbox-ownershipd.service")) ||
+            service->socket_fd >= 0 ||
+            service->exec_context.std_input != (source ? EXEC_INPUT_SOCKET : EXEC_INPUT_NULL))
+                return -EPERM;
+
+        const char *socket_unit = source ? "aos-sandbox-source-signerd.socket" : "aos-sandbox-ownershipd.socket";
+        const char *socket_path = source ? "/run/aos/sandbox-source-signerd.sock" : "/run/aos/sandbox-ownership/control.sock";
+        const char *fd_name = source ? "aos-sandbox-source-signerd" : "aos-sandbox-ownership";
+
+        UNIT_FOREACH_DEPENDENCY(u, UNIT(service), UNIT_ATOM_TRIGGERED_BY) {
+                Socket *socket = SOCKET(u);
+                if (!socket)
+                        continue;
+                if (selected || !streq_ptr(u->id, socket_unit))
+                        return -EPERM;
+                selected = socket;
+        }
+        if (!selected || selected->accept || UNIT_DEREF(selected->service) != UNIT(service) ||
+            !IN_SET(selected->state, SOCKET_LISTENING, SOCKET_RUNNING) ||
+            !selected->pass_subject_before_listen || !selected->pass_cred ||
+            !selected->pass_pidfd || selected->pass_sec != source ||
+            (!source && !streq_ptr(socket_fdname(selected), fd_name)))
+                return -EPERM;
+
+        SocketPort *port = selected->ports;
+        if (!port || port->port_next || port->type != SOCKET_SOCKET || port->fd < 0 ||
+            !port->subject_before_listen || port->n_auxiliary_fds != 0 ||
+            socket_address_family(&port->address) != AF_UNIX ||
+            port->address.type != (source ? SOCK_STREAM : SOCK_SEQPACKET) ||
+            !streq_ptr(socket_address_get_path(&port->address), socket_path))
+                return -EPERM;
+        *ret = port;
+        return 0;
+}
+
+static int fixed_origin_activation_current(Service *service) {
+        SocketPort *port;
+        int r = fixed_origin_activation_port(service, &port);
+        if (r < 0)
+                return r;
+
+        bool source = streq_ptr(UNIT(service)->id, "aos-sandbox-source-signerd.service");
+        const int options[] = { SO_PASSCRED, SO_PASSPIDFD, SO_PASSSEC, SO_ACCEPTCONN };
+        FOREACH_ELEMENT(option, options) {
+                int value;
+                r = getsockopt_int(port->fd, SOL_SOCKET, *option, &value);
+                if (r < 0)
+                        return r;
+                if (value != (*option == SO_PASSSEC ? source : 1))
+                        return -EPERM;
+        }
+        return 0;
+}
+
+int socket_require_source_origin_activation(Service *service) {
+        SocketPort *port;
+        if (!service || !streq_ptr(UNIT(service)->id, "aos-sandbox-source-signerd.service"))
+                return -EPERM;
+        return fixed_origin_activation_port(service, &port);
+}
+
+int socket_require_source_origin_activation_current(Service *service) {
+        if (!service || !streq_ptr(UNIT(service)->id, "aos-sandbox-source-signerd.service"))
+                return -EPERM;
+        return fixed_origin_activation_current(service);
+}
+
+int socket_require_ownership_origin_activation(Service *service) {
+        SocketPort *port;
+        if (!service || !streq_ptr(UNIT(service)->id, "aos-sandbox-ownershipd.service"))
+                return -EPERM;
+        return fixed_origin_activation_port(service, &port);
+}
+
+int socket_require_ownership_origin_activation_current(Service *service) {
+        if (!service || !streq_ptr(UNIT(service)->id, "aos-sandbox-ownershipd.service"))
+                return -EPERM;
+        return fixed_origin_activation_current(service);
+}
