+/* A positive populated sample may be replaced before the ordered empty cut.
+ * Native/shape failures are sticky; an empty cut is retained before trim. */
+static int controller_observe_empty(AosControllerChildOriginal *child, AosResourceServiceCPU *cpu) {
+        if (child->empty_observed)
+                return 0;
+        if (child->event_fd < 0 || cpu->cgroup_fd < 0)
+                return -EOWNERDEAD;
+        child->empty_named_before_result = fstatat(AT_FDCWD, AOS_RESOURCE_CONTROLLER_CGROUP_FILE,
+                                                   &child->empty_named_before, AT_SYMLINK_NOFOLLOW) < 0 ? -errno : 0;
+        child->empty_cgroup_stat_result = fstat(cpu->cgroup_fd, &child->empty_cgroup_stat) < 0 ? -errno : 0;
+        child->empty_event_stat_result = fstat(child->event_fd, &child->empty_event_stat) < 0 ? -errno : 0;
+        child->empty_length = pread(child->event_fd, child->empty_bytes, sizeof(child->empty_bytes), 0);
+        child->empty_read_result = child->empty_length < 0 ? -errno :
+                child->empty_length == sizeof(child->empty_bytes) ? -E2BIG : 0;
+        child->empty_named_after_result = fstatat(AT_FDCWD, AOS_RESOURCE_CONTROLLER_CGROUP_FILE,
+                                                  &child->empty_named_after, AT_SYMLINK_NOFOLLOW) < 0 ? -errno : 0;
+        if (child->empty_named_before_result < 0)
+                return child->empty_named_before_result;
+        if (child->empty_cgroup_stat_result < 0)
+                return child->empty_cgroup_stat_result;
+        if (child->empty_named_after_result < 0)
+                return child->empty_named_after_result;
+        if (child->empty_event_stat_result < 0)
+                return child->empty_event_stat_result;
+        if (child->empty_read_result < 0)
+                return child->empty_read_result;
+        if (child->empty_named_before.st_dev != child->cgroup_stat.st_dev ||
+            child->empty_named_before.st_ino != child->cgroup_stat.st_ino ||
+            child->empty_named_after.st_dev != child->cgroup_stat.st_dev ||
+            child->empty_named_after.st_ino != child->cgroup_stat.st_ino ||
+            child->empty_cgroup_stat.st_dev != child->cgroup_stat.st_dev ||
+            child->empty_cgroup_stat.st_ino != child->cgroup_stat.st_ino ||
+            child->empty_event_stat.st_dev != child->event_stat.st_dev ||
+            child->empty_event_stat.st_ino != child->event_stat.st_ino)
+                return -EOWNERDEAD;
+        child->empty_parse_result = root_event_value(child->empty_bytes, child->empty_length,
+                                                       "populated", &child->populated);
+        if (child->empty_parse_result < 0)
+                return child->empty_parse_result;
+        child->empty_observed = child->populated == 0;
+        return child->empty_observed ? 0 : -EBUSY;
+}
