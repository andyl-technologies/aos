+static int controller_socket_label_begin(AosServiceLaunchTransport *original) {
+#if HAVE_SELINUX
+        original->label_load_result = dlopen_libselinux(LOG_DEBUG);
+        if (original->label_load_result < 0)
+                return original->label_load_result;
+        original->label_enabled_result = sym_is_selinux_enabled();
+        if (original->label_enabled_result <= 0)
+                return -EOPNOTSUPP;
+        original->label_get_result = sym_getsockcreatecon_raw(&original->previous_socket_label) < 0 ? -errno : 0;
+        if (original->label_get_result < 0)
+                return original->label_get_result;
+        if (original->previous_socket_label)
+                controller_socket_label_unrestored(original, -EOWNERDEAD);
+        original->label_set_result = sym_setsockcreatecon_raw("system_u:object_r:aos_controller_resource_origin_channel_t:s0") < 0 ? -errno : 0;
+        return original->label_set_result;
+#else
+        return -EOPNOTSUPP;
+#endif
+}
+
+static int controller_socket_label_end(AosServiceLaunchTransport *original) {
+#if HAVE_SELINUX
+        original->label_reset_result = sym_setsockcreatecon_raw(NULL) < 0 ? -errno : 0;
+        original->label_readback_result = sym_getsockcreatecon_raw(&original->restored_socket_label) < 0 ? -errno : 0;
+        if (original->label_readback_result < 0 || original->restored_socket_label)
+                controller_socket_label_unrestored(original,
+                        original->label_reset_result < 0 ? original->label_reset_result :
+                        original->label_readback_result < 0 ? original->label_readback_result : -EOWNERDEAD);
+        /* Even independently proven NULL does not erase an earlier setter
+         * refusal or permit this launch to resume after its failed reset. */
+        return original->label_reset_result;
+#else
+        return -EOPNOTSUPP;
+#endif
+}
+
+/* Called only after the selected real owner paid this transport peak.
+ * The enum fixes both role and slot; no arbitrary descriptor name escapes. */
+static int service_launch_pair_and_deliver(
+                AosServiceLaunchTransport *original,
+                Service *service,
+                AosServiceLaunchPurpose purpose) {
+        const char *name;
+        unsigned slot;
+        int enabled = 1;
+
+        switch (purpose) {
+        case AOS_SERVICE_LAUNCH_COMPONENT_ORIGIN:
+                name = "aos-resource-service-origin-v1";
+                slot = 0;
+                if (service->n_extra_fds != 0 || service->n_fd_store != 0)
+                        return -EPERM;
+                break;
+        case AOS_SERVICE_LAUNCH_CONTROLLER_SUCCESSOR:
+                name = "aos-resource-controller-successor-v1";
+                slot = 2;
+                if (!service->aos_resource_delivery || service->n_extra_fds != 3 ||
+                    service->n_fd_store != 0 || service->extra_fds[slot].fd >= 0)
+                        return -EPERM;
+                break;
+        default:
+                return -EPERM;
+        }
+
+        if (purpose == AOS_SERVICE_LAUNCH_CONTROLLER_SUCCESSOR) {
+                int label = controller_socket_label_begin(original);
+                if (label < 0) {
+                        /* A failed native setter is uncertain until reset; the
+                         * original setter error remains the first cause. */
+                        if (original->label_set_result < 0)
+                                (void) controller_socket_label_end(original);
+                        return label;
+                }
+        }
+        original->pair_result = socketpair(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC | SOCK_NONBLOCK, 0,
+                                           original->sockets) < 0 ? -errno : 0;
+        if (purpose == AOS_SERVICE_LAUNCH_CONTROLLER_SUCCESSOR)
+                (void) controller_socket_label_end(original);
+        if (original->pair_result < 0)
+                return original->pair_result;
+        if (purpose == AOS_SERVICE_LAUNCH_CONTROLLER_SUCCESSOR && original->label_reset_result < 0)
+                return original->label_reset_result;
+        for (unsigned i = 0; i < 2; i++) {
+                original->passcred_results[i] = setsockopt(original->sockets[i], SOL_SOCKET, SO_PASSCRED,
+                                                          &enabled, sizeof(enabled)) < 0 ? -errno : 0;
+                if (original->passcred_results[i] < 0)
+                        return original->passcred_results[i];
+                original->passpidfd_results[i] = setsockopt(original->sockets[i], SOL_SOCKET, SO_PASSPIDFD,
+                                                           &enabled, sizeof(enabled)) < 0 ? -errno : 0;
+                if (original->passpidfd_results[i] < 0)
+                        return original->passpidfd_results[i];
+        }
+        if (purpose == AOS_SERVICE_LAUNCH_COMPONENT_ORIGIN) {
+                service->extra_fds = allocation_account_calloc(1, sizeof(ServiceExtraFD));
+                original->allocation_result = service->extra_fds ? 0 : -ENOMEM;
+                if (original->allocation_result < 0)
+                        return original->allocation_result;
+                service->n_extra_fds = 1;
+                service->extra_fds[0].fd = -EBADF;
+                service->aos_resource_delivery = true;
+        }
+        service->extra_fds[slot].fdname = allocation_account_strdup(name);
+        original->name_result = service->extra_fds[slot].fdname ? 0 : -ENOMEM;
+        if (original->name_result < 0)
+                return original->name_result;
+        service->extra_fds[slot].fd = fcntl(original->sockets[1], F_DUPFD_CLOEXEC, 3);
+        original->duplicate_result = service->extra_fds[slot].fd < 0 ? -errno : 0;
+        return original->duplicate_result;
+}
+
+/* Retain the exact returned native Result before any caller error projection. */
+static int service_launch_spawn_returned(
+                AosServiceLaunchTransport *original,
+                Service *service,
+                int spawn_result,
+                const PidRef *recipient) {
+        if (!original->entered || original->spawned || original->unit != UNIT(service) ||
+            !sd_id128_equal(original->invocation, UNIT(service)->invocation_id))
+                return -EOWNERDEAD;
+        original->spawned = true;
+        original->spawn_result = spawn_result;
+        if (spawn_result < 0)
+                return spawn_result;
+        if (!recipient || !pidref_is_set(recipient))
+                return -EOWNERDEAD;
+        original->recipient_result = pidref_copy(recipient, &original->recipient);
+        return original->recipient_result < 0 ? original->recipient_result : spawn_result;
+}
+
+static int service_launch_watch_returned(
+                AosServiceLaunchTransport *original,
+                Service *service,
+                int watch_result) {
+        if (!original->spawned || original->delivered || original->unit != UNIT(service) ||
+            original->spawn_result < 0 || original->recipient_result < 0 ||
+            !sd_id128_equal(original->invocation, UNIT(service)->invocation_id))
+                return -EOWNERDEAD;
+        original->watch_result = watch_result;
+        return watch_result;
+}
+
+/* Closed role selection chooses custody only. Parent admission separately
+ * proves the same real Unit, invocation, profile, cgroup and disjoint M/F. */
+typedef enum AosComponentOriginRole {
+        AOS_COMPONENT_ORIGIN_NONE,
+        AOS_COMPONENT_ORIGIN_SOURCE,
+        AOS_COMPONENT_ORIGIN_OWNERSHIP,
+} AosComponentOriginRole;
+
+static AosComponentOriginRole source_origin_role(Service *service) {
+        if (!enrollment.parent.selected)
+                return AOS_COMPONENT_ORIGIN_NONE;
+        if (streq_ptr(UNIT(service)->id, "aos-sandbox-source-signerd.service"))
+                return AOS_COMPONENT_ORIGIN_SOURCE;
+        if (streq_ptr(UNIT(service)->id, "aos-sandbox-ownershipd.service"))
+                return AOS_COMPONENT_ORIGIN_OWNERSHIP;
+        return AOS_COMPONENT_ORIGIN_NONE;
+}
+
+static AosSourceOrigin *source_origin_original(Service *service) {
+        switch (source_origin_role(service)) {
+        case AOS_COMPONENT_ORIGIN_SOURCE:
+                return &enrollment.source_origin;
+        case AOS_COMPONENT_ORIGIN_OWNERSHIP:
+                return &enrollment.ownership_origin;
+        default:
+                return NULL;
+        }
+}
+
+static bool source_origin_selected(Service *service) {
+        return source_origin_original(service) != NULL;
+}
+
+static int source_origin_refuse(Service *service, int error) {
+        AosSourceOrigin *original = source_origin_original(service);
+
+        if (!original)
+                return aos_resource_parent_fail(error);
+        if (original->transport.first_error == 0)
+                original->transport.first_error = error;
+        return aos_resource_parent_fail(original->transport.first_error);
+}
+
+/* Fixed DATA supplier for original M admission. It includes the sender's
+ * resident originals, the child delivery copy and bounded native stack peak.
+ * The caller cannot choose a vector, callback, cap or descriptor count. */
+size_t aos_resource_source_origin_memory(void) {
+        return sizeof(AosSourceOrigin) + sizeof(AosParentSenderAdmission) + 2U * sizeof(PidRef) +
+               2U * AOS_RESOURCE_VECTOR_BYTES +
+               /* Pinned glibc2.39 __alloc_dir clamps its getdents buffer to
+                * at most 1 MiB. The passive inheritance walker opens one DIR;
+                * its dominant native buffer is prepaid, not inferred free. */
+               1024U * 1024U +
+               152U + 32U +
+               3U * sizeof(int) + 2U * sizeof(struct iovec);
+}
+
+unsigned aos_resource_source_origin_files(void) {
+        /* Pair+Service copy, capsule pair, original clone+transport+main+watch
+         * pidfds, held cgroup+three controls, bootstrap alias, exec pipe pair,
+         * all20 installed Completion FDs, two exe opens and four native probes.
+         * The same M owner pays the full parent flight before any new growth. */
+        return 2U + 1U + 2U + 4U + 4U + 1U + 2U + 20U + 2U + 4U;
+}
+
+size_t aos_resource_ownership_origin_memory(void) {
+        return aos_resource_source_origin_memory();
+}
+
+unsigned aos_resource_ownership_origin_files(void) {
+        return aos_resource_source_origin_files();
+}
+
+int aos_resource_prepare_source_origin(Service *service, ExecCommand *command, ExecFlags flags) {
+        AosSourceOrigin *original = source_origin_original(service);
+        Unit *unit = UNIT(service);
+        int r;
+
+        if (!source_origin_selected(service))
+                return 0;
+        r = aos_resource_parent_error();
+        if (r < 0)
+                return r;
+        if (command != service->exec_command[SERVICE_EXEC_START] || !FLAGS_SET(flags, EXEC_PASS_FDS))
+                return 0;
+        if (!enrollment.admitted || enrollment.manager != unit->manager ||
+            sd_id128_is_null(unit->invocation_id) || original->transport.entered ||
+            service->aos_resource_delivery || service->n_extra_fds != 0 || service->n_fd_store != 0)
+                return source_origin_refuse(service, -EOWNERDEAD);
+
+        original->transport.entered = true;
+        original->transport.unit = unit;
+        original->transport.invocation = unit->invocation_id;
+        original->transport.main_command = command;
+        original->transport.main_flags = flags;
+        /* This must precede socket creation/allocation. It is a closed borrow
+         * of the genuine original M sender subdivision, never row clearance. */
+        r = aos_resource_parent_require_source_sender(service);
+        if (r < 0)
+                return source_origin_refuse(service, r);
+        r = service_launch_pair_and_deliver(&original->transport, service,
+                                            AOS_SERVICE_LAUNCH_COMPONENT_ORIGIN);
+        return r < 0 ? source_origin_refuse(service, r) : 0;
+}
+
+static int source_exec_refuse(Service *service, int error);
+
+static void source_origin_u64(uint8_t *bytes, uint64_t value) {
+        for (unsigned i = 0; i < 8; i++)
+                bytes[i] = (uint8_t) (value >> (56U - 8U * i));
+}
+
+/* Each original native frontier is recorded before its caller can return.
+ * The returned PidRef copy stays here even if unit_watch_pidref later fails. */
+int aos_resource_source_spawn_returned(Service *service, ExecCommand *command, ExecFlags flags,
+                                      int spawn_result, const PidRef *recipient) {
+        AosSourceOrigin *original = source_origin_original(service);
+        if (!source_origin_selected(service) || command != service->exec_command[SERVICE_EXEC_START] ||
+            !FLAGS_SET(flags, EXEC_PASS_FDS))
+                return spawn_result;
+        int r = service_launch_spawn_returned(&original->transport, service, spawn_result, recipient);
+        if (r < 0)
+                return source_origin_refuse(service, r);
+        /* Only a positive actual clone result permits disposal of this parent
+         * bootstrap alias. Leaving it non-CLOEXEC in PID1 would leak Source's
+         * channel into unrelated later executor children. The actual child
+         * owns its inherited reference; no financial FD credit is issued. */
+        if (original->bootstrap_fd < 0 || original->bootstrap_closed)
+                return source_exec_refuse(service, -EOWNERDEAD);
+        original->bootstrap_close_result = close(original->bootstrap_fd) < 0 ? -errno : 0;
+        original->bootstrap_closed = original->bootstrap_close_result == 0;
+        if (original->bootstrap_close_result < 0)
+                return source_exec_refuse(service, original->bootstrap_close_result);
+        return r;
+}
+
+static int source_deliver_origin(Service *service, ExecCommand *command, ExecFlags flags) {
+        AosSourceOrigin *original = source_origin_original(service);
+        uint8_t capsule[152] = {};
+        uint8_t parent_digest[SHA256_DIGEST_SIZE];
+        const uint8_t *fragment_digest;
+        int descriptors[3], manifest_fd;
+
+        if (!source_origin_selected(service) || command != service->exec_command[SERVICE_EXEC_START] ||
+            !FLAGS_SET(flags, EXEC_PASS_FDS))
+                return -EOWNERDEAD;
+        int r = aos_resource_source_exec_require_transition(service);
+        if (r < 0)
+                return source_origin_refuse(service, r);
+        original->verify_results[0] = pidref_verify(&original->transport.recipient);
+        if (original->verify_results[0] < 0)
+                return source_origin_refuse(service, original->verify_results[0]);
+        original->start_result = pidref_get_start_time(&original->transport.recipient, &original->start_time);
+        if (original->start_result < 0)
+                return source_origin_refuse(service, original->start_result);
+        original->parent_results[0] = aos_resource_parent_source_origin(service, &manifest_fd,
+                                                                       &fragment_digest, &original->cgroup_id);
+        if (original->parent_results[0] < 0)
+                return source_origin_refuse(service, original->parent_results[0]);
+        sha256_direct(enrollment.parent.manifest, enrollment.parent.manifest_bytes, parent_digest);
+
+        memcpy(capsule, "AOSRSE01", 8);
+        memcpy(capsule + 8, enrollment.policy + 8, 32);
+        memcpy(capsule + 40, enrollment.boot.bytes, 16);
+        memcpy(capsule + 56, enrollment.invocation.bytes, 16);
+        sha256_direct(enrollment.policy, enrollment.policy_bytes, capsule + 72);
+        memcpy(capsule + 104, original->transport.invocation.bytes, 16);
+        sha256_direct(capsule, 120, capsule + 120);
+        original->capsule.attempted = true;
+        original->capsule.sealed_fd = memfd_new_and_seal("aos-resource-pid1-enrollment-v1", capsule, sizeof(capsule));
+        if (original->capsule.sealed_fd < 0)
+                return source_origin_refuse(service, original->capsule.sealed_fd);
+        original->capsule.reopened_fd = fd_reopen(original->capsule.sealed_fd, O_RDONLY | O_CLOEXEC);
+        original->capsule.comparison = compare_original_capsule(&original->capsule);
+        if (original->capsule.comparison < 0)
+                return source_origin_refuse(service, original->capsule.comparison);
+        descriptors[0] = enrollment.policy_fd;
+        descriptors[1] = manifest_fd;
+        descriptors[2] = original->capsule.reopened_fd;
+
+        for (unsigned i = 0; i < 3; i++) {
+                uint8_t *payload = original->payloads[i];
+                struct iovec iov = { .iov_base = payload, .iov_len = 128 };
+
+                memcpy(payload, "AOSRSO01", 8);
+                payload[8] = i;
+                payload[9] = source_origin_role(service); /* Same original fixed service, never request DATA. */
+                memcpy(payload + 16, original->transport.invocation.bytes, 16);
+                source_origin_u64(payload + 32, original->cgroup_id);
+                source_origin_u64(payload + 40, original->transport.recipient.pid);
+                source_origin_u64(payload + 48, original->start_time);
+                memcpy(payload + 56, parent_digest, 32);
+                memcpy(payload + 88, fragment_digest, 32);
+                if (i == 2)
+                        continue;
+                r = aos_resource_require_launch_sender(service, command, flags);
+                if (r < 0)
+                        return source_origin_refuse(service, r);
+                original->send_lengths[i] = send_one_fd_iov(original->transport.sockets[0], descriptors[i], &iov, 1,
+                                                           MSG_DONTWAIT | MSG_NOSIGNAL);
+                original->send_results[i] = original->send_lengths[i] < 0 ?
+                        (int) original->send_lengths[i] : original->send_lengths[i] == 128 ? 0 : -EIO;
+                if (original->send_results[i] < 0)
+                        return source_origin_refuse(service, original->send_results[i]);
+        }
+
+        original->verify_results[1] = pidref_verify(&original->transport.recipient);
+        original->parent_results[1] = aos_resource_parent_source_origin(service, &manifest_fd,
+                                                                       &fragment_digest, &original->cgroup_after);
+        if (original->verify_results[1] < 0)
+                return source_origin_refuse(service, original->verify_results[1]);
+        if (original->parent_results[1] < 0)
+                return source_origin_refuse(service, original->parent_results[1]);
+        if (original->cgroup_after != original->cgroup_id)
+                return source_origin_refuse(service, -EOWNERDEAD);
+        /* The final capsule is withheld until every independent sender
+         * bookend succeeds. Earlier descriptor prefixes cannot enter Source. */
+        struct iovec final_iov = { .iov_base = original->payloads[2], .iov_len = 128 };
+        r = aos_resource_require_launch_sender(service, command, flags);
+        if (r < 0)
+                return source_origin_refuse(service, r);
+        original->send_lengths[2] = send_one_fd_iov(original->transport.sockets[0], descriptors[2], &final_iov, 1,
+                                                   MSG_DONTWAIT | MSG_NOSIGNAL);
+        original->send_results[2] = original->send_lengths[2] < 0 ?
+                (int) original->send_lengths[2] : original->send_lengths[2] == 128 ? 0 : -EIO;
+        if (original->send_results[2] < 0)
+                return source_origin_refuse(service, original->send_results[2]);
+        /* Authenticated0/1/2 precede profile parts so the receiver obtains the
+         * bounded original Parent roster before determining its remaining count.
+         * F3 is the sole final marker, withheld after every native bookend. */
+        for (unsigned file = 0; file < 5; file++) {
+                int descriptor;
+                const uint8_t *digest;
+                r = aos_resource_parent_source_profile_file(service, file, &descriptor, &digest);
+                if (r == -ENOENT && file > 0)
+                        break;
+                if (r < 0)
+                        return source_origin_refuse(service, r);
+                unsigned part = 4 + file;
+                memcpy(original->payloads[part], original->payloads[0], 128);
+                original->payloads[part][8] = part;
+                memcpy(original->payloads[part] + 88, digest, 32);
+                struct iovec iov = { .iov_base = original->payloads[part], .iov_len = 128 };
+                original->send_lengths[part] = send_one_fd_iov(original->transport.sockets[0], descriptor, &iov, 1,
+                                                               MSG_DONTWAIT | MSG_NOSIGNAL);
+                original->send_results[part] = original->send_lengths[part] < 0 ?
+                        (int) original->send_lengths[part] : original->send_lengths[part] == 128 ? 0 : -EIO;
+                if (original->send_results[part] < 0)
+                        return source_origin_refuse(service, original->send_results[part]);
+        }
+        memcpy(original->payloads[3], original->payloads[0], 128);
+        original->payloads[3][8] = 3;
+        memcpy(original->payloads[3] + 56, original->budget_digest, 32);
+        source_origin_u64(original->payloads[3] + 88, original->exec_claim.nofile);
+        source_origin_u64(original->payloads[3] + 96, original->inherited.high_descriptors);
+        source_origin_u64(original->payloads[3] + 104, original->fd_peak);
+        source_origin_u64(original->payloads[3] + 112, policy_u64(original->completion.payload + 96));
+        source_origin_u64(original->payloads[3] + 120, 1);
+        memcpy(original->payloads[3] + 128, original->completion.payload + 128, 176);
+        struct iovec transfer_iov = { .iov_base = original->payloads[3], .iov_len = 304 };
+        r = aos_resource_require_launch_sender(service, command, flags);
+        if (r < 0)
+                return source_origin_refuse(service, r);
+        original->send_lengths[3] = send_one_fd_iov(original->transport.sockets[0], original->completion_executable,
+                                                    &transfer_iov, 1, MSG_DONTWAIT | MSG_NOSIGNAL);
+        original->send_results[3] = original->send_lengths[3] < 0 ?
+                (int) original->send_lengths[3] : original->send_lengths[3] == 304 ? 0 : -EIO;
+        if (original->send_results[3] < 0)
+                return source_origin_refuse(service, original->send_results[3]);
+        original->transport.delivered = true;
+        return 0;
+}
+
+static int source_exec_refuse(Service *service, int error) {
+        AosSourceOrigin *original = source_origin_original(service);
+        if (!original)
+                return aos_resource_parent_fail(error);
+        if (original->exec_error == 0)
+                original->exec_error = error;
+        return source_origin_refuse(service, original->exec_error);
+}
