diff --git a/src/core/aos-fixed-service-profile.h b/src/core/aos-fixed-service-profile.h
--- /dev/null
+++ b/src/core/aos-fixed-service-profile.h
@@ -0,0 +1,71 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include "execute.h"
+#include "nsflags.h"
+#include "string-util.h"
+#include "strv.h"
+
+/* Restrictive profile DATA only. The actual Parent or authenticated child
+ * original independently selects the fixed role; this enum grants no scope,
+ * sender, descriptor, account, executable or operation authority. */
+typedef enum AosFixedServiceProfileRole {
+        AOS_FIXED_PROFILE_SOURCE = 1,
+        AOS_FIXED_PROFILE_OWNERSHIP = 2,
+} AosFixedServiceProfileRole;
+
+static inline bool aos_fixed_service_directories_match(
+                const ExecContext *context,
+                AosFixedServiceProfileRole role) {
+
+        if (!context || !IN_SET(role, AOS_FIXED_PROFILE_SOURCE, AOS_FIXED_PROFILE_OWNERSHIP))
+                return false;
+
+        for (ExecDirectoryType type = 0; type < _EXEC_DIRECTORY_TYPE_MAX; type++) {
+                const ExecDirectory *directory = &context->directories[type];
+                const char *path = type == EXEC_DIRECTORY_STATE ? "aos/sandbox/multi-node" :
+                                   type == EXEC_DIRECTORY_RUNTIME ? "aos/sandbox-ownership" : NULL;
+                mode_t mode = type == EXEC_DIRECTORY_STATE ? 0700 : 0711;
+
+                if (role == AOS_FIXED_PROFILE_SOURCE || !path) {
+                        if (directory->n_items != 0)
+                                return false;
+                        continue;
+                }
+                if (directory->n_items != 1 || !directory->items || directory->mode != mode ||
+                    !streq_ptr(directory->items[0].path, path) || directory->items[0].flags != 0 ||
+                    !strv_isempty(directory->items[0].symlinks) || directory->items[0].idmapped ||
+                    directory->exec_quota.quota_accounting || directory->exec_quota.quota_enforce)
+                        return false;
+        }
+        return true;
+}
+
+/* The same finite context predicate is checked in PID1 before M admission and
+ * again against the actual deserialized child. Unit/invocation/NOFILE/native
+ * original and currentness joins remain with those two independent owners. */
+static inline bool aos_fixed_service_context_matches(
+                const ExecContext *context,
+                AosFixedServiceProfileRole role) {
+
+        if (!context || !aos_fixed_service_directories_match(context, role))
+                return false;
+        if (context->private_users != PRIVATE_USERS_NO || context->private_pids != PRIVATE_PIDS_NO ||
+            context->private_bpf != PRIVATE_BPF_NO || context->dynamic_user ||
+            context->delegate_namespaces != NAMESPACE_FLAGS_INITIAL || !isempty(context->user_namespace_path) ||
+            !isempty(context->root_directory) || !isempty(context->root_image) || !isempty(context->root_mstack) ||
+            context->root_ephemeral || context->n_mount_images != 0 || context->n_extension_images != 0 ||
+            !strv_isempty(context->extension_directories) || context->n_temporary_filesystems != 0 ||
+            context->private_tmp != PRIVATE_TMP_CONNECTED || context->private_var_tmp != PRIVATE_TMP_CONNECTED ||
+            !isempty(context->pam_name) || !strv_isempty(context->environment_files) ||
+            context->capability_bounding_set != 0 || context->capability_ambient_set != 0)
+                return false;
+
+        if (role == AOS_FIXED_PROFILE_SOURCE)
+                return streq_ptr(context->user, "aos-source-signer") && streq_ptr(context->group, "aos-source-signer");
+
+        /* The existing Ownership unit uses the actual system root default.
+         * Explicit root remains the same identity; other names/IDs are refused. */
+        return (isempty(context->user) || streq(context->user, "root")) &&
+               (isempty(context->group) || streq(context->group, "root"));
+}
