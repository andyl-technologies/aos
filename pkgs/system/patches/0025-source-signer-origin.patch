+        int r = aos_resource_parent_require_source_sender(service);
+        if (r < 0)
+                return r;
+        return source_loader_environment(parameters->environment) && source_loader_environment(parameters->files_env) ?
+                0 : parent_refuse(-EPERM);
+}
