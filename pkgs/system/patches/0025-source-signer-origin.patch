+                return parent_refuse(-EPERM);
+        for (ServiceExecCommand slot = 0; slot < _SERVICE_EXEC_COMMAND_MAX; slot++)
+                if (slot != SERVICE_EXEC_START && service->exec_command[slot])
+                        return parent_refuse(-EPERM);
