diff --git a/src/core/aos-source-executor.c b/src/core/aos-source-executor.c
--- /dev/null
+++ b/src/core/aos-source-executor.c
@@ -0,0 +1,351 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+
+#include <poll.h>
+#include <sys/resource.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <time.h>
+#include <unistd.h>
+
+#include "aos-launch-record.h"
+#include "aos-fixed-service-profile.h"
+#include "aos-source-exec.h"
+#include "capability-util.h"
+#include "fd-util.h"
+#include "nsflags.h"
+#include "parse-util.h"
+#include "sha256.h"
+#include "strv.h"
+#include "time-util.h"
+#include "socket-util.h"
+#include "string-util.h"
+#include "unaligned.h"
+
+/* The only producer is PID1's same original fixed Source/Ownership clone. This static
+ * child custody survives every refusal until this executor process exits;
+ * it cannot be reentered, exchanged for a decoded row or issued to a helper. */
+static struct {
+        bool entered;
+        int first_error;
+        bool context_attempted;
+        bool namespace_attempted;
+        bool completion_attempted;
+        uint64_t early_nofile;
+        uint64_t role;
+        int parse_nofile_result;
+        int serialization_fd;
+        struct stat serialization;
+        int serialization_result;
+        struct timespec clocks[2];
+        int clock_results[2];
+        int descriptor_close_result;
+        int initial_channel;
+        int channel_flags_result;
+        struct ucred peer;
+        int peer_result;
+        struct pollfd poll;
+        int poll_result;
+        AosLaunchRecord budget;
+        uint8_t budget_digest[32];
+        struct rlimit limit_before;
+        struct rlimit limit_after;
+        int limit_before_result;
+        int limit_set_result;
+        int limit_after_result;
+        int capability_result;
+        int context_result;
+        int named_channel_result;
+        uint64_t channel_cookie;
+        uint64_t named_cookie;
+        int cookie_result;
+        int named_cookie_result;
+        AllocationAccount account;
+        uint8_t completion[304];
+        struct rlimit final_limit;
+        int final_limit_result;
+        ssize_t completion_length;
+        int completion_send_result;
+} original = { .initial_channel = -EBADF };
+
+static int refuse(int error) {
+        if (original.first_error == 0)
+                original.first_error = error;
+        allocation_account_native_failure(original.first_error);
+        return original.first_error;
+}
+
+int aos_source_executor_prelude(int argc, char **argv, AllocationAccountScope *scope) {
+        const char *argument = NULL, *nofile_argument = NULL, *serialization_argument = NULL;
+        int r, scan_error = 0;
+        bool source_option = false;
+
+        /* Pointer/length inspection only, before logging, fdopen, FDSet, MAC or
+         * deserialization. Ordinary executors retain their original entrance. */
+        for (int i = 1; i < argc; i++)
+                if (streq(argv[i], "--aos-source-origin")) {
+                        source_option = true;
+                        if (argument || i + 1 >= argc) {
+                                scan_error = -EINVAL;
+                                continue;
+                        }
+                        argument = argv[++i];
+                } else if (streq(argv[i], "--deserialize")) {
+                        if (serialization_argument || i + 1 >= argc) {
+                                scan_error = -EINVAL;
+                                continue;
+                        }
+                        serialization_argument = argv[++i];
+                } else if (streq(argv[i], "--aos-source-nofile")) {
+                        source_option = true;
+                        if (nofile_argument || i + 1 >= argc) {
+                                scan_error = -EINVAL;
+                                continue;
+                        }
+                        nofile_argument = argv[++i];
+                }
+        /* Ordinary malformed options belong to the unchanged ordinary parser
+         * and its original logging/error order, not this selected prelude. */
+        if (!source_option)
+                return 0;
+        if (scan_error < 0)
+                return scan_error;
+        if (!argument || !nofile_argument || !serialization_argument)
+                return -EINVAL;
+        if (original.entered)
+                return refuse(-EALREADY);
+        original.entered = true;
+        original.initial_channel = parse_fd(argument);
+        if (original.initial_channel < 0)
+                return refuse(original.initial_channel);
+        original.parse_nofile_result = safe_atou64(nofile_argument, &original.early_nofile);
+        if (original.parse_nofile_result < 0)
+                return refuse(original.parse_nofile_result);
+        if (original.early_nofile < 3 || original.early_nofile > UINT32_MAX)
+                return refuse(-EINVAL);
+        original.limit_before_result = getrlimit(RLIMIT_NOFILE, &original.limit_before) < 0 ? -errno : 0;
+        if (original.limit_before_result < 0)
+                return refuse(original.limit_before_result);
+        if (original.early_nofile > original.limit_before.rlim_max)
+                return refuse(-EPERM);
+        const struct rlimit limit = { .rlim_cur = original.early_nofile, .rlim_max = original.early_nofile };
+        original.limit_set_result = setrlimit(RLIMIT_NOFILE, &limit) < 0 ? -errno : 0;
+        original.limit_after_result = getrlimit(RLIMIT_NOFILE, &original.limit_after) < 0 ? -errno : 0;
+        if (original.limit_set_result < 0)
+                return refuse(original.limit_set_result);
+        if (original.limit_after_result < 0)
+                return refuse(original.limit_after_result);
+        if (original.limit_after.rlim_cur != original.early_nofile || original.limit_after.rlim_max != original.early_nofile)
+                return refuse(-EOWNERDEAD);
+        original.channel_flags_result = fd_cloexec(original.initial_channel, true);
+        if (original.channel_flags_result < 0)
+                return refuse(original.channel_flags_result);
+        socklen_t peer_bytes = sizeof(original.peer);
+        original.peer_result = getsockopt(original.initial_channel, SOL_SOCKET, SO_PEERCRED,
+                                          &original.peer, &peer_bytes) < 0 ? -errno : 0;
+        if (original.peer_result < 0)
+                return refuse(original.peer_result);
+        if (peer_bytes != sizeof(original.peer) || original.peer.pid != 1 || original.peer.uid != 0 || original.peer.gid != 0)
+                return refuse(-EOWNERDEAD);
+
+        /* This fixed native bootstrap is prepaid before the original clone;
+         * the packet supplies restrictions, never a new payer or permission. */
+        original.poll = (struct pollfd) { .fd = original.initial_channel, .events = POLLIN };
+        original.poll_result = poll(&original.poll, 1, 30000);
+        if (original.poll_result < 0)
+                return refuse(-errno);
+        if (original.poll_result != 1 || original.poll.revents != POLLIN)
+                return refuse(-ETIMEDOUT);
+        r = aos_launch_record_receive_once(&original.budget, original.initial_channel, AOS_LAUNCH_RECORD_SOURCE_BUDGET_368);
+        if (r < 0)
+                return refuse(r);
+        if (original.budget.malformed || original.budget.length != 368 ||
+            FLAGS_SET(original.budget.flags, MSG_TRUNC) || FLAGS_SET(original.budget.flags, MSG_CTRUNC) ||
+            original.budget.credential_count != 1 || original.budget.pidfd_count != 1 ||
+            original.budget.rights_count != 0 || original.budget.descriptor_count != 1 ||
+            original.budget.kernel_pidfd < 0 || original.budget.credentials.pid != 1 ||
+            original.budget.credentials.uid != 0 || original.budget.credentials.gid != 0 ||
+            memcmp(original.budget.payload, "AOSSFB01", 8) != 0 ||
+            unaligned_read_be64(original.budget.payload + 104) != (uint64_t) getpid() ||
+            unaligned_read_be64(original.budget.payload + 152) != 1 ||
+            !IN_SET(unaligned_read_be64(original.budget.payload + 184), 1U, 2U))
+                return refuse(-EBADMSG);
+        original.role = unaligned_read_be64(original.budget.payload + 184);
+        uint64_t nofile = unaligned_read_be64(original.budget.payload + 144);
+        uint64_t files = unaligned_read_be64(original.budget.payload + 136);
+        uint64_t high = unaligned_read_be64(original.budget.payload + 160);
+        uint64_t memory = unaligned_read_be64(original.budget.payload + 128);
+        if (nofile != original.early_nofile || high > UINT64_MAX - nofile ||
+            files != nofile + high || memory < sizeof(original))
+                return refuse(-ENOSPC);
+        sha256_direct(original.budget.payload, 368, original.budget_digest);
+        original.account = (AllocationAccount) {
+                .memory_limit = memory,
+                .files_limit = files,
+                .memory_charged = sizeof(original),
+                .resource_tracking = true,
+        };
+        for (unsigned i = 0; i < ALLOCATION_RESOURCE_DIMENSIONS; i++)
+                original.account.resource_limits[i] = unaligned_read_be64(original.budget.payload + 192 + 8 * i);
+        if (original.account.resource_limits[ALLOCATION_MEMORY] != memory ||
+            original.account.resource_limits[ALLOCATION_FILES] < files)
+                return refuse(-EBADMSG);
+        /* The original F keeps the whole finite FD peak through successful
+         * exec. It cannot be exchanged for old-mm memory replacement credit. */
+        original.account.persistent_usage[ALLOCATION_FILES] = files;
+        if (original.account.resource_limits[0] == 0 || original.account.resource_limits[2] < 1 ||
+            original.account.resource_limits[21] < 1)
+                return refuse(-ENOSPC);
+        /* Same kernel process/cgroup continues across exec: its installed rate,
+         * one actual task and one original lifetime do not disappear with mm. */
+        original.account.persistent_usage[0] = original.account.resource_limits[0];
+        original.account.persistent_usage[2] = 1;
+        original.account.persistent_usage[21] = 1;
+        r = allocation_account_enter(&original.account, scope);
+        if (r < 0)
+                return refuse(r);
+        original.serialization_fd = parse_fd(serialization_argument);
+        if (original.serialization_fd < 0)
+                return refuse(original.serialization_fd);
+        original.serialization_result = fstat(original.serialization_fd, &original.serialization) < 0 ? -errno : 0;
+        if (original.serialization_result < 0)
+                return refuse(original.serialization_result);
+        if (!S_ISREG(original.serialization.st_mode) || original.serialization.st_size <= 0 ||
+            (uint64_t) original.serialization.st_size != unaligned_read_be64(original.budget.payload + 168))
+                return refuse(-EOWNERDEAD);
+        original.clock_results[0] = clock_gettime(CLOCK_BOOTTIME, &original.clocks[0]) < 0 ? -errno : 0;
+        if (original.clock_results[0] < 0)
+                return refuse(original.clock_results[0]);
+        if (timespec_load(&original.clocks[0]) >= unaligned_read_be64(original.budget.payload + 176))
+                return refuse(-ETIMEDOUT);
+
+        /* The authenticated no-rights Budget has completed its PID1 subject
+         * observation. Dispose that actual kernel pidfd before later global
+         * FD cleanup, retaining the close result; permanent peak is not refunded. */
+        original.descriptor_close_result = close(original.budget.kernel_pidfd) < 0 ? -errno : 0;
+        original.budget.descriptors[0] = -EBADF;
+        original.budget.kernel_pidfd = -EBADF;
+        if (original.descriptor_close_result < 0)
+                return refuse(original.descriptor_close_result);
+        socklen_t cookie_bytes = sizeof(original.channel_cookie);
+        original.cookie_result = getsockopt(original.initial_channel, SOL_SOCKET, SO_COOKIE,
+                                             &original.channel_cookie, &cookie_bytes) < 0 ? -errno : 0;
+        if (original.cookie_result < 0)
+                return refuse(original.cookie_result);
+        return cookie_bytes == sizeof(original.channel_cookie) && original.channel_cookie != 0 ? 1 : refuse(-EOWNERDEAD);
+}
+
+int aos_source_executor_argument(const char *value) {
+        if (!original.entered || original.first_error < 0 || parse_fd(value) != original.initial_channel)
+                return refuse(original.first_error < 0 ? original.first_error : -EOWNERDEAD);
+        return 0;
+}
+
+int aos_source_executor_deserialized(const ExecContext *context, const ExecParameters *params) {
+        if (!original.entered)
+                return 0;
+        if (original.first_error < 0)
+                return original.first_error;
+        if (original.context_attempted)
+                return refuse(-EALREADY);
+        original.context_attempted = true;
+        AosFixedServiceProfileRole profile = original.role == 1 ?
+                AOS_FIXED_PROFILE_SOURCE : AOS_FIXED_PROFILE_OWNERSHIP;
+        original.context_result = aos_fixed_service_context_matches(context, profile) &&
+                context->rlimit[RLIMIT_NOFILE] &&
+                context->rlimit[RLIMIT_NOFILE]->rlim_cur == original.limit_after.rlim_cur &&
+                context->rlimit[RLIMIT_NOFILE]->rlim_max == original.limit_after.rlim_max &&
+                (original.role == 1 ? streq_ptr(params->unit_id, "aos-sandbox-source-signerd.service") :
+                 original.role == 2 && streq_ptr(params->unit_id, "aos-sandbox-ownershipd.service")) &&
+                memcmp(params->invocation_id.bytes, original.budget.payload + 8, 16) == 0 && params->exec_fd >= 0 ? 0 : -EPERM;
+        if (original.context_result < 0)
+                return refuse(original.context_result);
+        original.named_channel_result = -EOWNERDEAD;
+        for (size_t i = 0; i < params->n_socket_fds + params->n_stashed_fds; i++)
+                if (streq_ptr(params->fd_names[i], "aos-resource-service-origin-v1")) {
+                        if (original.named_channel_result == 0)
+                                return refuse(-EBADMSG);
+                        socklen_t bytes = sizeof(original.named_cookie);
+                        original.named_cookie_result = getsockopt(params->fds[i], SOL_SOCKET, SO_COOKIE,
+                                                                  &original.named_cookie, &bytes) < 0 ? -errno : 0;
+                        if (original.named_cookie_result < 0)
+                                return refuse(original.named_cookie_result);
+                        if (bytes != sizeof(original.named_cookie) || original.named_cookie != original.channel_cookie)
+                                return refuse(-EOWNERDEAD);
+                        original.named_channel_result = 0;
+                }
+        return original.named_channel_result < 0 ? refuse(original.named_channel_result) :
+                allocation_account_require_current(&original.account);
