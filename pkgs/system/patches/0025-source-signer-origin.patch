+        assert_se(chmod(path, 0700) >= 0);
+        assert_se(stat(path, &before) >= 0);
+
+        AllocationAccount account = { .resource_tracking = true };
+        _cleanup_(allocation_account_leave) AllocationAccountScope scope = {};
+        assert_se(allocation_account_enter(&account, &scope) >= 0);
