+            !streq_ptr(unit->id, ownership ? "aos-sandbox-ownershipd.service" : "aos-sandbox-source-signerd.service") ||
+            !set_isempty(unit->aliases) || unit->transient || !isempty(unit->source_path) ||
+            !command || command != service->exec_command[SERVICE_EXEC_START] || command->command_next ||
+            !FLAGS_SET(flags, EXEC_PASS_FDS) || !FLAGS_SET(flags, EXEC_APPLY_SANDBOXING) ||
