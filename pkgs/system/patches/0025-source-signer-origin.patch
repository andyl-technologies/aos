+static void controller_sigchld(Manager *manager, const siginfo_t *si) {
+        AosControllerRestart *original = &enrollment.controller_restart;
+        AosControllerChildOriginal *children[] = { &original->current_child, &original->pending_child };
+
+        if (enrollment.manager != manager || !original->sender_admitted)
+                return;
+        FOREACH_ELEMENT(child, children) {
+                siginfo_t observed = {};
+                int r;
+
+                if ((*child)->spawn.pidfd < 0 || (*child)->death_attempted)
+                        continue;
+                r = waitid(P_PIDFD, (*child)->spawn.pidfd, &observed, WEXITED | WNOHANG | WNOWAIT) < 0 ? -errno : 0;
+                if (r >= 0 && (observed.si_pid == 0 || observed.si_pid != si->si_pid))
+                        continue;
+                (*child)->death_attempted = true;
+                (*child)->child_death = observed;
+                (*child)->manager_death = *si;
+                (*child)->death_wait_result = r;
+                (*child)->death_join_result = r < 0 ? r :
+                        observed.si_code == si->si_code && observed.si_status == si->si_status &&
+                        IN_SET(observed.si_code, CLD_EXITED, CLD_KILLED, CLD_DUMPED) ? 0 : -EOWNERDEAD;
+                if ((*child)->death_join_result < 0 ||
+                    (!original->confirmed && *child == controller_launch_child()))
+                        (void) controller_launch_refuse((*child)->death_join_result < 0 ?
+                                                       (*child)->death_join_result : -EOWNERDEAD);
+        }
+}
+
+static void controller_reaped(Manager *manager, pid_t pid, const siginfo_t *si, int result) {
+        AosControllerRestart *original = &enrollment.controller_restart;
+        AosControllerChildOriginal *children[] = { &original->current_child, &original->pending_child };
+
+        if (enrollment.manager != manager || !original->sender_admitted)
+                return;
+        FOREACH_ELEMENT(child, children) {
+                if (!(*child)->death_attempted || (*child)->death_join_result < 0 ||
+                    (*child)->reap_attempted || pid != (*child)->child_death.si_pid)
+                        continue;
+                (*child)->reap_attempted = true;
+                (*child)->reaped_death = *si;
+                (*child)->reap_result = result;
+                (*child)->reap_join_result = result < 0 ? result :
+                        si->si_pid == pid && si->si_code == (*child)->child_death.si_code &&
+                        si->si_status == (*child)->child_death.si_status ? 0 : -EOWNERDEAD;
+                if ((*child)->reap_join_result < 0)
+                        (void) controller_launch_refuse((*child)->reap_join_result);
+        }
+}
+
+static void controller_before_cleanup(Unit *unit) {
+        AosControllerRestart *original = &enrollment.controller_restart;
+        AosServiceLaunchTransport *transport = controller_launch_transport();
+        AosControllerChildOriginal *child = controller_launch_child();
+        AosResourceServiceCPU *cpu = original->pending ? &original->pending_cpu : &enrollment.controller_cpu;
+        int r;
+
+        if (!controller_launch_selected(unit) || transport->unit != unit || !child->death_attempted)
+                return;
+        r = controller_observe_empty(child, cpu);
+        if (r < 0 && r != -EBUSY)
+                (void) controller_launch_refuse(r);
+}
+
+static int controller_old_cut(Service *service) {
+        AosControllerRestart *original = &enrollment.controller_restart;
+        AosControllerChildOriginal *child = &original->current_child;
+        int r;
+
+        if (original->first_error < 0)
+                return original->first_error;
+        if (!original->confirmed || !original->ack_accepted || original->pending ||
+            (original->current_transport.unit != UNIT(service) && !original->old_unit_retired) ||
+            !child->death_attempted || child->death_join_result < 0 ||
+            !child->reap_attempted || child->reap_join_result < 0)
+                return -EOWNERDEAD;
+        r = controller_observe_empty(child, &enrollment.controller_cpu);
+        return r < 0 ? r : 0;
+}
+
+/* unit_free calls this before service_done releases delivery copies. It
+ * records an actual quiescent old owner, never a replacement Unit argument. */
+void aos_resource_controller_unit_retiring(Unit *unit) {
+        AosControllerRestart *original = &enrollment.controller_restart;
+        AosControllerChildOriginal *child = &original->current_child;
+
+        if (!controller_launch_selected(unit) || original->current_transport.unit != unit)
+                return;
+        if (original->pending || !original->confirmed || !original->ack_accepted ||
+            !child->death_attempted || child->death_join_result < 0 ||
+            !child->reap_attempted || child->reap_join_result < 0 || !child->empty_observed) {
+                (void) controller_launch_refuse(-EOWNERDEAD);
+                return;
+        }
+        original->old_unit_retired = true;
+}
+
+/* Parent invokes this only with its actual permanent admission. Consuming this
+ * original closure once authorizes only reuse of its already paid sender peak. */
+int aos_resource_controller_sender_completed_peak(Service *service, const AosParentSenderAdmission *admission) {
+        AosControllerRestart *original = &enrollment.controller_restart;
+        int r;
+
+        if (admission != &enrollment.parent.controller_sender || !admission->entered ||
+            admission->result < 0 || admission->account.active || admission->account.closed ||
+            admission->account.first_error < 0 || original->peak_consumed ||
+            original->retired_copy_count != 3)
+                return -EOWNERDEAD;
+        r = controller_old_cut(service);
+        if (r < 0)
+                return r;
+        for (unsigned i = 0; i < original->retired_copy_count; i++)
+                if (original->retired_copy_close_results[i] < 0)
+                        return original->retired_copy_close_results[i];
+        original->peak_consumed = true;
+        return 0;
+}
+
+int aos_resource_controller_sender_context(Service *service) {
+        AosControllerRestart *original = &enrollment.controller_restart;
+        AosServiceLaunchTransport *transport = controller_launch_transport();
+
+        if (!controller_launch_selected(UNIT(service)) || !enrollment.admitted ||
+            enrollment.manager != UNIT(service)->manager || original->first_error < 0 ||
+            !original->sender_admitted || transport->unit != UNIT(service) ||
+            !sd_id128_equal(transport->invocation, UNIT(service)->invocation_id))
+                return -EOWNERDEAD;
+        return 0;
+}
+
+/* Service cleanup moves the genuine original delivery array rather than
+ * scheduling asynchronous close. The handoff owner then retains even a failed
+ * prefix; cleanup never grants a new launch or claims native completion. */
+bool aos_resource_retain_controller_delivery(Service *service) {
+        AosControllerRestart *original = &enrollment.controller_restart;
+        AosServiceLaunchTransport *transport = controller_launch_transport();
+
+        if (!controller_launch_selected(UNIT(service)) || !service->aos_resource_delivery || !service->extra_fds)
+                return false;
+        if (transport->unit != UNIT(service) || original->held_extra_fds || service->n_extra_fds != 3) {
+                (void) controller_launch_refuse(-EOWNERDEAD);
+                return true;
+        }
+        original->held_extra_fds = TAKE_PTR(service->extra_fds);
+        original->held_extra_count = service->n_extra_fds;
+        service->n_extra_fds = 0;
+        service->aos_resource_delivery = false;
+        return true;
+}
+
+static int controller_retire_service_copies(Service *service) {
+        AosControllerRestart *original = &enrollment.controller_restart;
+        static const char *const names[] = {
+                "aos-resource-image-policy-v1", "aos-resource-pid1-enrollment-v1",
+                "aos-resource-controller-successor-v1",
+        };
+
+        if (!original->held_extra_fds)
+                (void) aos_resource_retain_controller_delivery(service);
+        if (!original->held_extra_fds || original->held_extra_count != ELEMENTSOF(names) ||
+            service->n_extra_fds != 0 || service->n_fd_store != 0 || original->retired_copy_count != 0)
+                return -EOWNERDEAD;
+        for (unsigned i = 0; i < ELEMENTSOF(names); i++)
+                if (!streq_ptr(original->held_extra_fds[i].fdname, names[i]) || original->held_extra_fds[i].fd < 0)
+                        return -EOWNERDEAD;
+        for (unsigned i = 0; i < ELEMENTSOF(names); i++) {
+                original->retired_copy_close_results[i] = close(original->held_extra_fds[i].fd) < 0 ? -errno : 0;
+                original->retired_copy_count++;
+                original->held_extra_fds[i].fd = -EBADF;
+        }
+        for (unsigned i = 0; i < ELEMENTSOF(names); i++)
+                if (original->retired_copy_close_results[i] < 0)
+                        return original->retired_copy_close_results[i];
+        for (unsigned i = 0; i < ELEMENTSOF(names); i++)
+                original->held_extra_fds[i].fdname = mfree(original->held_extra_fds[i].fdname);
+        original->held_extra_fds = mfree(original->held_extra_fds);
+        original->held_extra_count = 0;
+        return 0;
+}
+
+/* Called for prestart too, before its CPU owner checks. The channel is still
+ * attached only to the fixed main ExecStart; auxiliary commands cannot mint it. */
+static int controller_prepare_launch(Service *service, ExecCommand *command, ExecFlags flags) {
+        AosControllerRestart *original = &enrollment.controller_restart;
+        AosServiceLaunchTransport *transport;
+        int r;
+
+        if (!controller_launch_selected(UNIT(service)))
+                return 0;
+        if (original->first_error < 0)
+                return original->first_error;
+        if (!original->sender_admitted) {
+                r = aos_resource_parent_admit_controller_sender(service);
+                if (r < 0)
+                        return controller_launch_refuse(r);
+                original->sender_admitted = true;
+                original->current_transport.unit = UNIT(service);
+                original->current_transport.invocation = UNIT(service)->invocation_id;
+        } else if (!sd_id128_equal(controller_launch_transport()->invocation, UNIT(service)->invocation_id)) {
+                /* R is one immutable residual inside B. Consume at most one
+                 * successor before clone, delivery or child allocation. */
+                if (enrollment.policy_bytes == AOS_RESOURCE_CONTROLLER_RECOVERY_POLICY_BYTES && original->generation != 0)
+                        return controller_launch_refuse(-EOWNERDEAD);
+                r = controller_old_cut(service);
+                if (r < 0)
+                        return controller_launch_refuse(r);
+                r = controller_retire_service_copies(service);
+                if (r >= 0)
+                        r = aos_resource_parent_reuse_controller_sender(service);
+                if (r < 0)
+                        return controller_launch_refuse(r);
+                original->pending = true;
+                original->pending_transport.unit = UNIT(service);
+                original->pending_transport.invocation = UNIT(service)->invocation_id;
+        }
+        r = aos_resource_controller_sender_context(service);
+        if (r < 0)
+                return controller_launch_refuse(r);
+        transport = controller_launch_transport();
+        if (command == service->exec_command[SERVICE_EXEC_START] && FLAGS_SET(flags, EXEC_PASS_FDS)) {
+                if (transport->entered)
+                        return controller_launch_refuse(-EALREADY);
+                transport->entered = true;
+                transport->main_command = command;
+                transport->main_flags = flags;
+                usec_t sampled = now(CLOCK_BOOTTIME);
+                if (sampled > (UINT64_MAX - UINT64_C(30000000000)) / 1000U)
+                        return controller_launch_refuse(-EOVERFLOW);
+                original->cold_cutoff = sampled * 1000U + UINT64_C(30000000000);
+                original->ack_accepted = false;
+                original->account_post_attempted = false;
+                original->confirmed = false;
+                original->ack_record = (AosLaunchRecord) {};
+        }
+        return 0;
+}
+
+/* Shared hooks retain distinct Source, Ownership and Controller originals. */
+int aos_resource_prepare_launch_origin(Service *service, ExecCommand *command, ExecFlags flags) {
+        int r = aos_resource_prepare_source_origin(service, command, flags);
+        if (r < 0)
+                return r;
+        return controller_launch_selected(UNIT(service)) ? aos_resource_controller_sender_context(service) : 0;
+}
+
+int aos_resource_begin_launch_exec_scope(Service *service, ExecCommand *command, ExecFlags flags,
+                                         AllocationAccountScope *scope) {
+        int r = aos_resource_parent_require_source_profile(service, command, flags);
+        if (r < 0)
+                return r;
+
+        if (source_origin_selected(service)) {
+                if (command != service->exec_command[SERVICE_EXEC_START] || !FLAGS_SET(flags, EXEC_PASS_FDS))
+                        return 0;
+                return aos_resource_parent_begin_source_sender(service, scope);
+        }
+        if (controller_launch_selected(UNIT(service))) {
+                r = controller_prepare_launch(service, command, flags);
+                if (r < 0)
+                        return r;
+                return aos_resource_parent_controller_exec_scope(service, scope);
+        }
+        return 0;
+}
+
+int aos_resource_require_launch_sender(Service *service, ExecCommand *command, ExecFlags flags) {
+        if (source_origin_selected(service)) {
+                if (command != service->exec_command[SERVICE_EXEC_START] || !FLAGS_SET(flags, EXEC_PASS_FDS))
+                        return 0;
+                return aos_resource_parent_require_source_sender(service);
+        }
+        if (controller_launch_selected(UNIT(service)))
+                return aos_resource_parent_require_controller_sender(service);
+        return 0;
+}
+
+/* Main clone custody comes from the same CLONE_INTO_CGROUP engine as Root.
+ * Returning a selected failure never falls back to the generic spawn path. */
+int aos_resource_controller_spawn_original(Unit *unit, ExecCommand *command, ExecFlags flags,
+                                           FixedCgroupSpawnOriginal **ret, int *ret_cgroup_fd) {
+        AosControllerChildOriginal *child;
+        AosServiceLaunchTransport *transport;
+        AosResourceServiceCPU *cpu;
+        Service *service;
+
+        *ret = NULL;
+        *ret_cgroup_fd = -EBADF;
+        if (!controller_launch_selected(unit))
+                return 0;
+        service = SERVICE(unit);
+        if (command != service->exec_command[SERVICE_EXEC_START] || !FLAGS_SET(flags, EXEC_PASS_FDS))
+                return 0;
+        transport = controller_launch_transport();
+        child = controller_launch_child();
+        cpu = resource_cpu_original(AOS_RESOURCE_CPU_CONTROLLER);
+        if (aos_resource_controller_sender_context(service) < 0 || !transport->entered ||
+            !FLAGS_SET(flags, EXEC_APPLY_SANDBOXING) || FLAGS_SET(flags, EXEC_IS_CONTROL) ||
+            child->spawn.attempted || child->event_fd >= 0 || !cpu->attempted ||
+            cpu->first_error < 0 || cpu->first.read_result < 0 || cpu->cgroup_fd < 0)
+                return controller_launch_refuse(-EOWNERDEAD);
+        child->cgroup_stat_result = fstat(cpu->cgroup_fd, &child->cgroup_stat) < 0 ? -errno : 0;
+        child->event_fd = openat(cpu->cgroup_fd, "cgroup.events", O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+        child->event_open_result = child->event_fd < 0 ? -errno : 0;
+        child->event_stat_result = fstat(child->event_fd, &child->event_stat) < 0 ? -errno : 0;
+        if (child->cgroup_stat_result < 0)
+                return controller_launch_refuse(child->cgroup_stat_result);
+        if (child->event_open_result < 0)
+                return controller_launch_refuse(child->event_open_result);
+        if (child->event_stat_result < 0)
+                return controller_launch_refuse(child->event_stat_result);
+        if (child->cgroup_stat.st_dev != cpu->first.cgroup_stat.st_dev ||
+            child->cgroup_stat.st_ino != cpu->first.cgroup_stat.st_ino ||
+            !S_ISREG(child->event_stat.st_mode) || child->event_stat.st_uid != 0 ||
+            child->event_stat.st_gid != 0 || child->event_stat.st_dev != child->cgroup_stat.st_dev)
+                return controller_launch_refuse(-EOWNERDEAD);
+        *ret = &child->spawn;
+        *ret_cgroup_fd = cpu->cgroup_fd;
+        return 1;
+}
+
+static int controller_recipient_current(Service *service) {
+        AosServiceLaunchTransport *transport = controller_launch_transport();
+        AosControllerChildOriginal *child = controller_launch_child();
+        AosResourceServiceCPU *cpu = resource_cpu_original(AOS_RESOURCE_CPU_CONTROLLER);
+        struct stat clone, handed;
+        char expected[128];
+        int r;
+
+        r = aos_resource_controller_sender_context(service);
+        if (r >= 0 && (now(CLOCK_BOOTTIME) >= enrollment.controller_restart.cold_cutoff / 1000U ||
+                      !transport->spawned || transport->spawn_result < 0 ||
+                      transport->recipient_result < 0 || transport->watch_result < 0 ||
+                      child->spawn.pidfd < 0 || child->death_attempted))
+                r = -EOWNERDEAD;
+        if (r >= 0)
+                r = pidref_verify(&transport->recipient);
+        if (r >= 0)
+                r = pidref_is_alive(&transport->recipient);
+        if (r == 0)
+                r = -EOWNERDEAD;
+        if (r < 0)
+                return r;
+        if (fstat(child->spawn.pidfd, &clone) < 0 || fstat(transport->recipient.fd, &handed) < 0)
+                return -errno;
+        if (clone.st_dev != handed.st_dev || clone.st_ino != handed.st_ino)
+                return -EOWNERDEAD;
+        /* Independently verify the currently installed CPU control, its OFDs,
+         * current inode and unit/cgroup join at this actual packet frontier. */
+        CGroupRuntime *runtime = unit_get_cgroup_runtime(UNIT(service));
+        if (!runtime)
+                return -EOWNERDEAD;
+        r = resource_cpu_check(cpu, &cpu->later, runtime, AOS_RESOURCE_CPU_CONTROLLER);
+        snprintf(expected, sizeof(expected), "%" PRIu64 " 100000\n",
+                 policy_u64(enrollment.policy + AOS_RESOURCE_CONTROLLER_PREFIX_OFFSET));
+        return r < 0 ? r : aos_resource_control_readback(cpu->control_fd, expected,
+                cpu->later.readback, sizeof(cpu->later.readback), &cpu->later.read_length, &cpu->later.read_result);
+}
+
+static void controller_close_retained(int *fd) {
+        AosControllerRestart *original = &enrollment.controller_restart;
+        int r;
+
+        if (*fd < 0)
+                return;
+        r = close(*fd) < 0 ? -errno : 0;
+        if (original->retirement_close_count < ELEMENTSOF(original->retirement_close_results))
+                original->retirement_close_results[original->retirement_close_count++] = r;
+        else
+                r = -EOVERFLOW;
+        *fd = -EBADF;
+        if (r < 0)
+                (void) controller_launch_refuse(r);
+}
+
+/* Positive disposal happens only after the same recipient's real ACK and
+ * completed Confirm send. The still-current clone/cgroup/capsule originals
+ * move from pending to current, and are never reconstructed from the packet. */
+static int controller_complete_exchange(Service *service) {
+        AosControllerRestart *original = &enrollment.controller_restart;
+        AosServiceLaunchTransport *transport = controller_launch_transport();
+
+        original->ack_event = sd_event_source_disable_unref(original->ack_event);
+        original->retirement_close_count = 0;
+        for (unsigned i = 0; i < original->ack_record.descriptor_count; i++)
+                controller_close_retained(&original->ack_record.descriptors[i]);
+        controller_close_retained(&transport->sockets[0]);
+        controller_close_retained(&transport->sockets[1]);
+        if (original->pending) {
+                controller_close_retained(&original->current_child.spawn.pidfd);
+                controller_close_retained(&original->current_child.event_fd);
+                controller_close_retained(&original->current_transport.recipient.fd);
+                controller_close_retained(&enrollment.controller_cpu.cgroup_fd);
+                controller_close_retained(&enrollment.controller_cpu.control_fd);
+                controller_close_retained(&enrollment.controller_delivery.sealed_fd);
+                controller_close_retained(&enrollment.controller_delivery.reopened_fd);
+                if (original->first_error < 0)
+                        return original->first_error;
+                enrollment.controller_cpu = original->pending_cpu;
+                enrollment.controller_delivery = original->pending_delivery;
+                enrollment.controller_invocation = original->pending_delivery_invocation;
+                original->current_transport = original->pending_transport;
+                original->current_child = original->pending_child;
+                original->pending_cpu = (AosResourceServiceCPU) AOS_RESOURCE_CPU_EMPTY;
+                original->pending_delivery = (AosResourceDelivery) AOS_RESOURCE_DELIVERY_EMPTY;
+                original->pending_delivery_invocation = SD_ID128_NULL;
+                original->pending_transport = (AosServiceLaunchTransport) {
+                        .sockets = { -EBADF, -EBADF }, .recipient = PIDREF_NULL,
+                };
+                original->pending_child = (AosControllerChildOriginal) {
+                        .spawn = { .pidfd = -EBADF, .duplicate_pidfd = -EBADF }, .event_fd = -EBADF,
+                };
+                original->generation++;
+                original->pending = false;
+        }
+        if (original->first_error < 0)
+                return original->first_error;
+        original->confirmed = true;
+        original->old_unit_retired = false;
+        original->peak_consumed = false;
+        original->retired_copy_count = 0;
+        return 0;
+}
+
+static int controller_receive_ack_body(sd_event_source *source, int fd, uint32_t revents, void *userdata) {
+        AosControllerRestart *original = &enrollment.controller_restart;
+        AosServiceLaunchTransport *transport = controller_launch_transport();
+        AosControllerChildOriginal *child = controller_launch_child();
+        Service *service = userdata;
+        int r;
+        struct stat original_clone = {}, received_clone = {};
+
+        if (source != original->ack_event || fd != transport->sockets[0] || original->ack_accepted)
+                return controller_launch_refuse(-EOWNERDEAD);
+        r = aos_launch_record_receive_once(&original->ack_record, fd, AOS_LAUNCH_RECORD_128);
+        if (r < 0)
+                return controller_launch_refuse(r);
+        if (original->ack_record.malformed || original->ack_record.length != 128 ||
+            FLAGS_SET(original->ack_record.flags, MSG_TRUNC) || FLAGS_SET(original->ack_record.flags, MSG_CTRUNC) ||
+            original->ack_record.credential_count != 1 || original->ack_record.pidfd_count != 1 ||
+            original->ack_record.rights_count != 0 || original->ack_record.descriptor_count != 1 ||
+            original->ack_record.kernel_pidfd < 0)
+                return controller_launch_refuse(-EBADMSG);
+        original->ack_context_result = controller_recipient_current(service);
+        original->ack_peer_result = fstat(child->spawn.pidfd, &original_clone) < 0 ? -errno :
+                fstat(original->ack_record.kernel_pidfd, &received_clone) < 0 ? -errno :
+                original_clone.st_dev == received_clone.st_dev && original_clone.st_ino == received_clone.st_ino ? 0 : -EOWNERDEAD;
+        if (original->ack_context_result < 0)
+                return controller_launch_refuse(original->ack_context_result);
+        if (original->ack_peer_result < 0 || original->ack_record.credentials.pid != transport->recipient.pid ||
+            memcmp(original->ack_record.payload, "AOSRCO01", 8) != 0 || original->ack_record.payload[8] != 2 ||
+            original->ack_record.payload[9] != (original->pending ? 2 : 1) ||
+            memcmp(original->ack_record.payload + 10, (uint8_t[6]) {}, 6) != 0 ||
+            policy_u64(original->ack_record.payload + 16) != original->generation + (original->pending ? 1U : 0U) ||
+            memcmp(original->ack_record.payload + 24, original->offer_digest, 32) != 0 ||
+            memcmp(original->ack_record.payload + 56, (uint8_t[32]) {}, 32) == 0 ||
+            memcmp(original->ack_record.payload + 88, (uint8_t[16]) {}, 16) == 0 ||
+            memcmp(original->ack_record.payload + 104, transport->invocation.bytes, 16) != 0 ||
+            memcmp(original->ack_record.payload + 120, (uint8_t[8]) {}, 8) != 0)
+                return controller_launch_refuse(-EOWNERDEAD);
+        original->ack_accepted = true;
+        memcpy(original->confirm, original->ack_record.payload, 128);
+        original->confirm[8] = 3;
+        int observed = original->pending ? original->current_child.spawn.pidfd : child->spawn.pidfd;
+        struct iovec confirm_iov = { .iov_base = original->confirm, .iov_len = 128 };
+        r = aos_resource_require_launch_sender(service, transport->main_command, transport->main_flags);
+        if (r < 0)
+                return controller_launch_refuse(r);
+        original->confirm_length = send_one_fd_iov(fd, observed, &confirm_iov, 1, MSG_DONTWAIT | MSG_NOSIGNAL);
+        original->confirm_send_result = original->confirm_length < 0 ? (int) original->confirm_length :
+                original->confirm_length == 128 ? 0 : -EIO;
+        r = controller_recipient_current(service);
+        /* Both native/account posts precede any positive original disposal.
+         * Keep the actual account Result even if send or native post failed. */
+        original->account_post_attempted = true;
+        original->account_post_result = aos_resource_parent_require_controller_sender(service);
+        if (original->confirm_send_result < 0)
+                return controller_launch_refuse(original->confirm_send_result);
+        if (r < 0)
+                return controller_launch_refuse(r);
+        if (original->account_post_result < 0)
+                return controller_launch_refuse(original->account_post_result);
+        return controller_complete_exchange(service);
+}
+
+static int controller_receive_ack(sd_event_source *source, int fd, uint32_t revents, void *userdata) {
+        /* Refusal is retained and disables this original input. It must not
+         * spin the manager event loop or make it discard the failed receipt. */
+        _cleanup_(allocation_account_leave) AllocationAccountScope scope = {};
+        Service *service = userdata;
+        int r = aos_resource_parent_controller_exec_scope(service, &scope);
+        if (r < 0) {
+                (void) controller_launch_refuse(r);
+                return 0;
+        }
+        r = controller_receive_ack_body(source, fd, revents, userdata);
+        if (r < 0) {
+                /* Early refusal still owes its independent same-account post;
+                 * successful body closure already paid it before disposal. */
+                if (!enrollment.controller_restart.account_post_attempted) {
+                        enrollment.controller_restart.account_post_attempted = true;
+                        enrollment.controller_restart.account_post_result =
+                                aos_resource_parent_require_controller_sender(service);
+                }
+                (void) controller_launch_refuse(r);
+        }
+        return 0;
+}
+
+static int controller_finish_spawn(Service *service, ExecCommand *command, ExecFlags flags, int watch_result) {
+        AosControllerRestart *original = &enrollment.controller_restart;
+        AosServiceLaunchTransport *transport = controller_launch_transport();
+        AosControllerChildOriginal *child = controller_launch_child();
+        AosControllerChildOriginal *observed = original->pending ? &original->current_child : child;
+        int r;
+
+        if (!controller_launch_selected(UNIT(service)) || command != service->exec_command[SERVICE_EXEC_START] ||
+            !FLAGS_SET(flags, EXEC_PASS_FDS))
+                return watch_result;
+        r = service_launch_watch_returned(transport, service, watch_result);
+        if (r >= 0)
+                r = controller_recipient_current(service);
+        if (r < 0)
+                return controller_launch_refuse(r);
+        if (original->generation == UINT64_MAX)
+                return controller_launch_refuse(-EOVERFLOW);
+        for (unsigned i = 0; i < ELEMENTSOF(original->nonces); i++) {
+                original->nonce_results[i] = sd_id128_randomize(&original->nonces[i]);
+                if (original->nonce_results[i] < 0)
+                        return controller_launch_refuse(original->nonce_results[i]);
+                if (sd_id128_is_null(original->nonces[i]))
+                        return controller_launch_refuse(-EIO);
+        }
+        memzero(original->offer, sizeof(original->offer));
+        memcpy(original->offer, "AOSRCO01", 8);
+        original->offer[8] = 1;
+        original->offer[9] = original->pending ? 2 : 1;
+        source_origin_u64(original->offer + 16, original->generation + (original->pending ? 1U : 0U));
+        memcpy(original->offer + 24, enrollment.invocation.bytes, 16);
+        if (original->pending)
+                memcpy(original->offer + 40, original->current_transport.invocation.bytes, 16);
+        memcpy(original->offer + 56, transport->invocation.bytes, 16);
+        source_origin_u64(original->offer + 72, observed->cgroup_stat.st_dev);
+        source_origin_u64(original->offer + 80, observed->cgroup_stat.st_ino);
+        memcpy(original->offer + 88, original->nonces, 32);
+        source_origin_u64(original->offer + 120, original->cold_cutoff);
+        sha256_direct(original->offer, sizeof(original->offer), original->offer_digest);
+        struct iovec iov = { .iov_base = original->offer, .iov_len = sizeof(original->offer) };
+        original->event_disabled = false;
+        original->event_result = sd_event_add_io(UNIT(service)->manager->event, &original->ack_event,
+                                                  transport->sockets[0], EPOLLIN, controller_receive_ack, service);
+        if (original->event_result < 0)
+                return controller_launch_refuse(original->event_result);
+        r = aos_resource_require_launch_sender(service, command, flags);
+        if (r < 0)
+                return controller_launch_refuse(r);
+        original->offer_length = send_one_fd_iov(transport->sockets[0], observed->spawn.pidfd, &iov, 1,
+                                                MSG_DONTWAIT | MSG_NOSIGNAL);
+        original->offer_send_result = original->offer_length < 0 ? (int) original->offer_length :
+                original->offer_length == 128 ? 0 : -EIO;
+        if (original->offer_send_result < 0)
+                return controller_launch_refuse(original->offer_send_result);
+        transport->delivered = true;
+        return 0;
+}
+
+int aos_resource_launch_spawn_returned(Service *service, ExecCommand *command, ExecFlags flags,
+                                       int spawn_result, const PidRef *recipient) {
+        if (!controller_launch_selected(UNIT(service)) || command != service->exec_command[SERVICE_EXEC_START] ||
+            !FLAGS_SET(flags, EXEC_PASS_FDS))
+                return aos_resource_source_spawn_returned(service, command, flags, spawn_result, recipient);
+        int r = service_launch_spawn_returned(controller_launch_transport(), service, spawn_result, recipient);
+        return r < 0 ? controller_launch_refuse(r) : r;
+}
+
+int aos_resource_finish_launch_spawn(Service *service, ExecCommand *command, ExecFlags flags, int watch_result) {
+        if (controller_launch_selected(UNIT(service)))
+                return controller_finish_spawn(service, command, flags, watch_result);
+        return aos_resource_finish_source_spawn(service, command, flags, watch_result);
+}
+
+int aos_resource_service_spawn_original(Unit *unit, ExecCommand *command, ExecFlags flags,
+                                        FixedCgroupSpawnOriginal **ret, int *ret_cgroup_fd) {
+        FixedCgroupSpawnOriginal *source = NULL, *controller = NULL;
+        int source_cgroup = -EBADF, controller_cgroup = -EBADF;
+        FixedCgroupSpawnOriginal *root = aos_resource_root_spawn_original(unit);
+        int r;
+
+        *ret = NULL;
+        *ret_cgroup_fd = -EBADF;
+        if (aos_resource_root_protected_unit(unit) && !root)
+                return -EOWNERDEAD;
+        r = aos_resource_source_spawn_original(unit, command, flags, &source, &source_cgroup);
+        if (r < 0)
+                return r;
+        if ((r > 0) != (source && source_cgroup >= 0))
+                return -EOWNERDEAD;
+        r = aos_resource_controller_spawn_original(unit, command, flags, &controller, &controller_cgroup);
+        if (r < 0)
+                return r;
+        if ((r > 0) != (controller && controller_cgroup >= 0))
+                return -EOWNERDEAD;
+        if ((root != NULL) + (source != NULL) + (controller != NULL) > 1)
+                return -EOWNERDEAD;
+        /* This is the final same-account check after argument serialization,
+         * original clone preparation and all helper allocation attempts. */
+        if (unit->type == UNIT_SERVICE) {
+                r = aos_resource_require_launch_sender(SERVICE(unit), command, flags);
+                if (r < 0)
+                        return r;
+        }
+        *ret = source ?: controller ?: root;
+        *ret_cgroup_fd = source ? source_cgroup : controller ? controller_cgroup :
+                root ? aos_resource_root_cgroup_fd(unit) : -EBADF;
+        return *ret ? 1 : 0;
+}
