+TEST(subject_options_precede_listening) {
+        SocketAddress address = {};
+        _cleanup_close_ int ordinary = -EBADF, selected = -EBADF, client = -EBADF, accepted = -EBADF;
+        char name[80];
+        int value;
+
+        xsprintf(name, "@aos-subject-before-listen-%" PRIu64, random_u64());
+        ASSERT_OK(socket_address_parse(&address, name));
+        address.type = SOCK_STREAM;
+        ordinary = socket_address_listen(&address, SOCK_CLOEXEC, 1, SOCKET_ADDRESS_DEFAULT,
+                                        NULL, false, false, false, 0755, 0600, NULL, NULL);
+        ASSERT_OK(ordinary);
+        const int options[] = { SO_PASSCRED, SO_PASSPIDFD, SO_PASSSEC };
+        FOREACH_ELEMENT(option, options) {
+                ASSERT_OK(getsockopt_int(ordinary, SOL_SOCKET, *option, &value));
+                ASSERT_EQ(value, 0);
+        }
+        ordinary = safe_close(ordinary);
+
+        selected = socket_address_listen_subject_before_bind(
+                        &address, SOCK_CLOEXEC, 1, SOCKET_ADDRESS_DEFAULT,
+                        NULL, false, false, false, 0755, 0600, NULL, NULL);
+        ASSERT_OK(selected);
+        FOREACH_ELEMENT(option, options) {
+                ASSERT_OK(getsockopt_int(selected, SOL_SOCKET, *option, &value));
+                ASSERT_EQ(value, 1);
+        }
+        ASSERT_OK(getsockopt_int(selected, SOL_SOCKET, SO_ACCEPTCONN, &value));
+        ASSERT_EQ(value, 1);
+
+        client = socket(AF_UNIX, SOCK_STREAM|SOCK_CLOEXEC, 0);
+        ASSERT_OK(client);
+        ASSERT_OK(connect(client, &address.sockaddr.sa, address.size));
+        ASSERT_EQ(write(client, "x", 1), 1);
+        accepted = accept4(selected, NULL, NULL, SOCK_CLOEXEC);
+        ASSERT_OK(accepted);
+        FOREACH_ELEMENT(option, options) {
+                ASSERT_OK(getsockopt_int(accepted, SOL_SOCKET, *option, &value));
+                ASSERT_EQ(value, 1);
+        }
+        char byte;
+        ASSERT_EQ(read(accepted, &byte, 1), 1);
+        ASSERT_EQ(byte, 'x');
+}
+
+TEST(configured_subject_options_precede_seqpacket_listening) {
+        SocketAddress address = { .type = SOCK_SEQPACKET };
+        _cleanup_close_ int listener = -EBADF, client = -EBADF, accepted = -EBADF;
+        char name[80];
+        int value;
+
+        xsprintf(name, "@aos-configured-subject-%" PRIu64, random_u64());
+        ASSERT_OK(socket_address_parse(&address, name));
+        address.type = SOCK_SEQPACKET;
+        listener = socket_address_listen_configured_subject_before_bind(
+                        &address, SOCK_CLOEXEC, 1, SOCKET_ADDRESS_DEFAULT,
+                        NULL, false, false, false, 0755, 0600, NULL, NULL,
+                        true, true, false);
+        ASSERT_OK(listener);
+
+        /* Ownership's ordinary record grammar forbids SCM_SECURITY. Its
+         * credential/pidfd evidence must nevertheless apply before connect. */
+        const int options[] = { SO_PASSCRED, SO_PASSPIDFD, SO_PASSSEC, SO_ACCEPTCONN };
+        FOREACH_ELEMENT(option, options) {
+                ASSERT_OK(getsockopt_int(listener, SOL_SOCKET, *option, &value));
+                ASSERT_EQ(value, *option == SO_PASSSEC ? 0 : 1);
+        }
+
+        client = socket(AF_UNIX, SOCK_SEQPACKET|SOCK_CLOEXEC, 0);
+        ASSERT_OK(client);
+        ASSERT_OK(connect(client, &address.sockaddr.sa, address.size));
+        ASSERT_EQ(write(client, "x", 1), 1);
+        accepted = accept4(listener, NULL, NULL, SOCK_CLOEXEC);
+        ASSERT_OK(accepted);
+        FOREACH_ELEMENT(option, options) {
+                if (*option == SO_ACCEPTCONN)
+                        continue;
+                ASSERT_OK(getsockopt_int(accepted, SOL_SOCKET, *option, &value));
+                ASSERT_EQ(value, *option == SO_PASSSEC ? 0 : 1);
+        }
+        char byte;
+        ASSERT_EQ(read(accepted, &byte, 1), 1);
+        ASSERT_EQ(byte, 'x');
+}
+
 DEFINE_TEST_MAIN(LOG_DEBUG);
