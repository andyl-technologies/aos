+bool aos_resource_source_exec_pipe_selected(Service *service, ExecCommand *command, ExecFlags flags) {
+        return source_origin_selected(service) && command == service->exec_command[SERVICE_EXEC_START] &&
+                FLAGS_SET(flags, EXEC_PASS_FDS);
+}
+
+int aos_resource_source_exec_serialized(Unit *unit, ExecCommand *command, ExecParameters *params,
+                                         int serialization_fd, int *ret_bootstrap_fd, uint64_t *ret_nofile) {
+        AosSourceOrigin *original;
+        Service *service;
+        int r;
+
+        *ret_bootstrap_fd = -EBADF;
+        *ret_nofile = 0;
+        if (unit->type != UNIT_SERVICE || !source_origin_selected(SERVICE(unit)))
+                return 0;
+        service = SERVICE(unit);
+        original = source_origin_original(service);
+        r = aos_resource_require_launch_sender(service, command, params->flags);
+        if (r < 0)
+                return source_exec_refuse(service, r);
+        if (!aos_resource_source_exec_pipe_selected(service, command, params->flags) ||
+            !original->transport.entered || original->transport.unit != unit || original->exec_prepared ||
+            params->exec_fd < 0 || !sd_id128_equal(original->transport.invocation, unit->invocation_id))
+                return source_exec_refuse(service, -EOWNERDEAD);
+        original->exec_prepared = true;
+        r = aos_resource_parent_source_environment(service, params);
+        if (r < 0)
+                return source_exec_refuse(service, r);
+        r = aos_resource_parent_capture_source_exec(service, &original->exec_claim);
+        if (r < 0)
+                return source_exec_refuse(service, r);
+        original->serialization_result = fstat(serialization_fd, &original->serialization) < 0 ? -errno : 0;
+        if (original->serialization_result < 0)
+                return source_exec_refuse(service, original->serialization_result);
+        if (!S_ISREG(original->serialization.st_mode) || original->serialization.st_size <= 0 ||
+            (uint64_t) original->serialization.st_size > policy_u64(original->exec_claim.vector + 8))
+                return source_exec_refuse(service, -ENOSPC);
+        /* The channel alias is inherited independently of the serialized table.
+         * All remaining parent-created descriptors are CLOEXEC. The very same
+         * walker then observes high inherited slots without mutating PID1 FDs. */
+        original->bootstrap_fd = fcntl(original->transport.sockets[1], F_DUPFD, 3);
+        original->bootstrap_result = original->bootstrap_fd < 0 ? -errno : 0;
+        if (original->bootstrap_result < 0)
+                return source_exec_refuse(service, original->bootstrap_result);
+        original->inherited_result = fdset_observe_inheritance_geometry(original->exec_claim.nofile,
+                                                                        &original->inherited);
+        if (original->inherited_result < 0)
+                return source_exec_refuse(service, original->inherited_result);
+        if (original->inherited.high_descriptors > UINT64_MAX - original->exec_claim.nofile)
+                return source_exec_refuse(service, -EOVERFLOW);
+        original->fd_peak = original->exec_claim.nofile + original->inherited.high_descriptors;
+        /* This exact selected executor closure has one sequential loader FD:
+         * no audit/preload callbacks, frame/shim/libc-only constructors. NULL
+         * posix_spawn file actions add no descriptors, and exec closes every
+         * CLOEXEC slot observed by the same walker. Qualify the final ELF
+         * closure with this source recipe; never use PID1's entire open table. */
+        if (original->inherited.descriptors == UINT64_MAX ||
+            original->inherited.descriptors + 1U > original->fd_peak ||
+            original->fd_peak > policy_u64(original->exec_claim.vector + 24))
+                return source_exec_refuse(service, -ENOSPC);
+        original->challenge_result = sd_id128_randomize(&original->challenge);
+        if (original->challenge_result < 0)
+                return source_exec_refuse(service, original->challenge_result);
+        original->exec_clock_results[0] = clock_gettime(CLOCK_BOOTTIME, &original->exec_clock[0]) < 0 ? -errno : 0;
+        if (original->exec_clock_results[0] < 0)
+                return source_exec_refuse(service, original->exec_clock_results[0]);
+        usec_t began = timespec_load(&original->exec_clock[0]);
+        if (began == USEC_INFINITY || began > USEC_INFINITY - 30U * USEC_PER_SEC)
+                return source_exec_refuse(service, -EOVERFLOW);
+        original->cutoff = began + 30U * USEC_PER_SEC;
+        *ret_bootstrap_fd = original->bootstrap_fd;
+        *ret_nofile = original->exec_claim.nofile;
+        return aos_resource_require_launch_sender(service, command, params->flags);
+}
+
+int aos_resource_source_spawn_original(Unit *unit, ExecCommand *command, ExecFlags flags,
+                                       FixedCgroupSpawnOriginal **ret, int *ret_cgroup_fd) {
+        AosSourceOrigin *original;
+        Service *service;
+        int r;
+
+        *ret = NULL;
+        *ret_cgroup_fd = -EBADF;
+        if (unit->type != UNIT_SERVICE || !source_origin_selected(SERVICE(unit)))
+                return 0;
+        service = SERVICE(unit);
+        original = source_origin_original(service);
+        r = aos_resource_require_launch_sender(service, command, flags);
+        if (r < 0)
+                return source_exec_refuse(service, r);
+        if (!original->exec_prepared || original->exec_error < 0 || original->exec_claim.result < 0 ||
+            original->clone.attempted || original->exec_claim.limits.directory_fd < 0 ||
+            original->transport.unit != unit || !sd_id128_equal(original->transport.invocation, unit->invocation_id))
+                return source_exec_refuse(service, -EOWNERDEAD);
+        *ret = &original->clone;
+        *ret_cgroup_fd = original->exec_claim.limits.directory_fd;
+        return 1;
+}
+
+/* Both observations run under the same retained M account. They are separate
+ * reservoirs: final exec validation cannot replace the original post-clone cut. */
+static int source_exec_current(Service *service, unsigned phase) {
+        AosSourceOrigin *original = source_origin_original(service);
+        int manifest_fd;
+        const uint8_t *fragment;
+        uint64_t cgroup_id;
+
+        if (!original)
+                return -EOWNERDEAD;
+        if (phase >= ELEMENTSOF(original->current_attempted) || original->current_attempted[phase] ||
+            (phase == 1 && !original->current_attempted[0]))
+                return -EALREADY;
+        original->current_attempted[phase] = true;
+        int control = aos_resource_parent_source_exec_current(service, &original->exec_claim, phase);
+        if (control < 0)
+                return control;
+        original->process_results[phase] = pidref_verify(&original->transport.recipient);
+        if (original->process_results[phase] < 0)
+                return original->process_results[phase];
+        original->process_start_results[phase] = pidref_get_start_time(&original->transport.recipient,
+                                                                      &original->process_start[phase]);
+        if (original->process_start_results[phase] < 0)
+                return original->process_start_results[phase];
+        original->process_path_results[phase] = cg_pid_get_path(original->transport.recipient.pid, &original->process_paths[phase]);
+        if (original->process_path_results[phase] < 0)
+                return original->process_path_results[phase];
+        original->context_results[phase] = aos_resource_parent_source_origin(service, &manifest_fd, &fragment, &cgroup_id);
+        if (original->context_results[phase] < 0)
+                return original->context_results[phase];
+        if (cgroup_id != original->exec_claim.cgroup_id ||
+            !streq_ptr(original->process_paths[phase],
+                source_origin_role(service) == AOS_COMPONENT_ORIGIN_SOURCE ?
+                "/aoscomponents.slice/aos-sandbox-source-signerd.service" :
+                "/aoscomponents.slice/aos-sandbox-ownershipd.service") ||
+            (phase == 1 && original->process_start[1] != original->process_start[0]))
+                return -EOWNERDEAD;
+        original->exec_clock_results[phase + 1] = clock_gettime(CLOCK_BOOTTIME, &original->exec_clock[phase + 1]) < 0 ? -errno : 0;
+        if (original->exec_clock_results[phase + 1] < 0)
+                return original->exec_clock_results[phase + 1];
+        usec_t observed = timespec_load(&original->exec_clock[phase + 1]);
+        if (observed < timespec_load(&original->exec_clock[phase]) || observed >= original->cutoff)
+                return -ETIMEDOUT;
+        original->process_verify_after[phase] = pidref_verify(&original->transport.recipient);
+        return original->process_verify_after[phase] < 0 ? original->process_verify_after[phase] :
+                aos_resource_parent_require_source_sender(service);
+}
+
+int aos_resource_source_exec_watch_returned(Service *service, ExecCommand *command, ExecFlags flags) {
+        AosSourceOrigin *original = source_origin_original(service);
+        if (!original)
+                return -EOWNERDEAD;
+        if (original->budget_attempted)
+                return source_exec_refuse(service, -EALREADY);
+        original->budget_attempted = true;
+        int r = source_exec_current(service, 0);
+        if (r < 0)
+                return source_exec_refuse(service, r);
+        original->clone_stat_result = fstat(original->clone.pidfd, &original->clone_stat) < 0 ? -errno : 0;
+        if (original->clone_stat_result < 0)
+                return source_exec_refuse(service, original->clone_stat_result);
+        memcpy(original->budget, "AOSSFB01", 8);
+        memcpy(original->budget + 8, original->transport.invocation.bytes, 16);
+        memcpy(original->budget + 24, original->challenge.bytes, 16);
+        memcpy(original->budget + 40, original->exec_claim.parent_digest, 32);
+        memcpy(original->budget + 72, enrollment.invocation.bytes, 16);
+        memcpy(original->budget + 88, enrollment.boot.bytes, 16);
+        source_origin_u64(original->budget + 104, original->transport.recipient.pid);
+        source_origin_u64(original->budget + 112, original->process_start[0]);
+        source_origin_u64(original->budget + 120, original->exec_claim.cgroup_id);
+        source_origin_u64(original->budget + 128, policy_u64(original->exec_claim.vector + 8));
+        source_origin_u64(original->budget + 136, original->fd_peak);
+        source_origin_u64(original->budget + 144, original->exec_claim.nofile);
+        source_origin_u64(original->budget + 152, 1); /* Measured pre-exec table count, not service TasksMax. */
+        source_origin_u64(original->budget + 160, original->inherited.high_descriptors);
+        source_origin_u64(original->budget + 168, original->serialization.st_size);
+        source_origin_u64(original->budget + 176, original->cutoff);
+        source_origin_u64(original->budget + 184, source_origin_role(service));
+        memcpy(original->budget + 192, original->exec_claim.vector, 176);
+        sha256_direct(original->budget, sizeof(original->budget), original->budget_digest);
+        struct iovec iov = { .iov_base = original->budget, .iov_len = sizeof(original->budget) };
+        r = aos_resource_require_launch_sender(service, command, flags);
+        if (r < 0)
+                return source_exec_refuse(service, r);
+        original->budget_length = sendmsg(original->transport.sockets[0],
+                &(struct msghdr) { .msg_iov = &iov, .msg_iovlen = 1 }, MSG_DONTWAIT | MSG_NOSIGNAL);
+        original->budget_send_result = original->budget_length < 0 ? -errno :
+                original->budget_length == sizeof(original->budget) ? 0 : -EIO;
+        return original->budget_send_result < 0 ? source_exec_refuse(service, original->budget_send_result) : 0;
+}
+
+int aos_resource_finish_source_spawn(Service *service, ExecCommand *command, ExecFlags flags, int watch_result) {
+        if (!aos_resource_source_exec_pipe_selected(service, command, flags))
+                return watch_result;
+        int r = service_launch_watch_returned(&source_origin_original(service)->transport, service, watch_result);
+        return r < 0 ? source_exec_refuse(service, r) : aos_resource_source_exec_watch_returned(service, command, flags);
+}
+
+int aos_resource_source_exec_require_transition(Service *service) {
+        AosSourceOrigin *original = source_origin_original(service);
+        if (!original)
+                return -EOWNERDEAD;
+        if (original->exec_error < 0)
+                return original->exec_error;
+        return source_origin_selected(service) && original->transport.unit == UNIT(service) &&
+                original->exec_complete && original->exec_eof && original->exec_hot &&
+                sd_id128_equal(original->transport.invocation, UNIT(service)->invocation_id) ? 0 : -EOWNERDEAD;
+}
+
+int aos_resource_source_exec_pipe_observed(Service *service, ssize_t length, uint8_t byte, int native_error) {
+        AosSourceOrigin *original = source_origin_original(service);
+        _cleanup_(allocation_account_leave) AllocationAccountScope scope = {};
+        int r;
+
+        if (!source_origin_selected(service))
+                return 0;
+        if (original->exec_error < 0)
+                return original->exec_error;
+        if (native_error == -EAGAIN)
+                return 0; /* Proven nonconsuming/no-acquisition sample is disposed. */
+        if (original->exec_read_count == ELEMENTSOF(original->exec_read_lengths) || original->exec_eof)
+                return source_exec_refuse(service, -EALREADY);
+        unsigned index = original->exec_read_count++;
+        original->exec_read_lengths[index] = length;
+        original->exec_bytes[index] = byte;
+        if (native_error < 0)
+                return source_exec_refuse(service, native_error);
+        if (length == 1) {
+                if (byte != 1 || original->exec_hot)
+                        return source_exec_refuse(service, -ENOEXEC); /* Actual cold/error is retained. */
+                original->exec_hot = true;
+                return 0;
+        }
+        if (length != 0 || !original->exec_hot || original->budget_send_result < 0 ||
+            !original->transport.spawned || original->transport.watch_result < 0)
+                return source_exec_refuse(service, -ENOEXEC);
+        original->exec_eof = true;
+        r = aos_resource_parent_source_exec_scope(service, &scope);
+        if (r < 0)
+                return source_exec_refuse(service, r);
+        r = aos_launch_record_receive_once(&original->completion, original->transport.sockets[0], AOS_LAUNCH_RECORD_SOURCE_COMPLETION_304);
+        if (r < 0)
+                return source_exec_refuse(service, r);
+        AosLaunchRecord *record = &original->completion;
+        original->completion_result =
+                !record->malformed && record->length == 304 &&
+                !FLAGS_SET(record->flags, MSG_TRUNC) && !FLAGS_SET(record->flags, MSG_CTRUNC) &&
+                record->credential_count == 1 && record->pidfd_count == 1 && record->rights_count == 1 &&
+                record->descriptor_count == 2 && record->kernel_pidfd >= 0 &&
+                record->credentials.pid == original->transport.recipient.pid &&
+                memcmp(record->payload, "AOSSFC01", 8) == 0 &&
+                memcmp(record->payload + 8, original->budget_digest, 32) == 0 &&
+                memcmp(record->payload + 40, original->challenge.bytes, 16) == 0 &&
+                memcmp(record->payload + 56, original->transport.invocation.bytes, 16) == 0 &&
+                memcmp(record->payload + 72, original->budget + 104, 24) == 0 &&
+                policy_u64(record->payload + 96) <= policy_u64(original->exec_claim.vector + 8) &&
+                policy_u64(record->payload + 104) == original->exec_claim.nofile &&
+                policy_u64(record->payload + 112) == original->exec_claim.nofile &&
+                policy_u64(record->payload + 120) == 1 ? 0 : -EBADMSG;
+        if (original->completion_result < 0)
+                return source_exec_refuse(service, original->completion_result);
+        for (unsigned dimension = 0; dimension < 22; dimension++)
+                if (policy_u64(record->payload + 128 + 8 * dimension) >
+                    policy_u64(original->exec_claim.vector + 8 * dimension))
+                        return source_exec_refuse(service, -ENOSPC);
+        if (policy_u64(record->payload + 128 + 3 * 8) != original->fd_peak)
+                return source_exec_refuse(service, -EOWNERDEAD);
+        original->completion_peer_result = fstat(record->kernel_pidfd, &original->completion_peer_stat) < 0 ? -errno : 0;
+        if (original->completion_peer_result < 0)
+                return source_exec_refuse(service, original->completion_peer_result);
+        if (original->completion_peer_stat.st_dev != original->clone_stat.st_dev ||
+            original->completion_peer_stat.st_ino != original->clone_stat.st_ino)
+                return source_exec_refuse(service, -EOWNERDEAD);
+        original->completion_executable = record->descriptors[record->descriptors[0] == record->kernel_pidfd ? 1 : 0];
+        original->completion_executable_stat_result = fstat(original->completion_executable, &original->completion_executable_stat) < 0 ? -errno : 0;
+        if (original->completion_executable_stat_result < 0)
+                return source_exec_refuse(service, original->completion_executable_stat_result);
+        r = source_exec_current(service, 1);
+        if (r < 0)
+                return source_exec_refuse(service, r);
+        char proc_path[STRLEN("/proc/") + DECIMAL_STR_MAX(pid_t) + STRLEN("/exe")];
+        xsprintf(proc_path, "/proc/" PID_FMT "/exe", original->transport.recipient.pid);
+        original->proc_executable = open(proc_path, O_PATH | O_CLOEXEC);
+        original->proc_executable_open_result = original->proc_executable < 0 ? -errno : 0;
+        if (original->proc_executable_open_result < 0)
+                return source_exec_refuse(service, original->proc_executable_open_result);
+        original->proc_executable_stat_result = fstat(original->proc_executable, &original->proc_executable_stat) < 0 ? -errno : 0;
+        original->executor_stat_result = fstat(UNIT(service)->manager->executor_fd, &original->executor_stat) < 0 ? -errno : 0;
+        if (original->proc_executable_stat_result < 0)
+                return source_exec_refuse(service, original->proc_executable_stat_result);
+        if (original->executor_stat_result < 0)
+                return source_exec_refuse(service, original->executor_stat_result);
+        if (!S_ISREG(original->completion_executable_stat.st_mode) ||
+            original->proc_executable_stat.st_dev != original->completion_executable_stat.st_dev ||
+            original->proc_executable_stat.st_ino != original->completion_executable_stat.st_ino ||
+            (original->proc_executable_stat.st_dev == original->executor_stat.st_dev &&
+             original->proc_executable_stat.st_ino == original->executor_stat.st_ino))
+                return source_exec_refuse(service, -EOWNERDEAD);
+        original->final_verify_result = pidref_verify(&original->transport.recipient);
+        if (original->final_verify_result < 0)
+                return source_exec_refuse(service, original->final_verify_result);
+        original->final_sender_result = aos_resource_parent_require_source_sender(service);
+        if (original->final_sender_result < 0)
+                return source_exec_refuse(service, original->final_sender_result);
+        /* Completion+hot/EOF+same original clone/start/cgroup+new actual proc
+         * executable jointly prove the old executor mm was replaced. This
+         * permits memory-peak reuse only; permanently charged FD coverage stays. */
+        original->exec_complete = true;
+        return source_deliver_origin(service, original->transport.main_command, original->transport.main_flags);
+}
+
+/* The explicit parent02 ControllerSender subdivision must cover this fixed
+ * current+pending peak before any pair, array, clone or ACK receive enters.
+ * Whole-exec variable growth is additionally paid by the same private account. */
+size_t aos_resource_controller_successor_memory(void) {
+        return sizeof(AosControllerRestart) + sizeof(AosParentSenderAdmission) +
+               sizeof(AosResourceServiceCPU) + sizeof(AosResourceDelivery) +
+               4U * sizeof(PidRef) + 2U * AOS_RESOURCE_VECTOR_BYTES + 5U * 65536U +
+               2U * sizeof(struct msghdr) + 2U * sizeof(struct iovec) + 512U;
+}
+
+unsigned aos_resource_controller_successor_files(void) {
+        /* Two CPU/capsule/clone/transport-PidRef/event owners (7 each),
+         * plus each actual Service main PidRef and unit-watch pidref_dup (2).
+         * Add one socketpair, three Service copies, complete 80-byte raw ACK
+         * slots before parsing, and four transient native probes. No future
+         * close is deducted from this simultaneously retained peak. */
+        return 2U * 9U + 2U + 3U + 80U / sizeof(int) + 4U;
+}
