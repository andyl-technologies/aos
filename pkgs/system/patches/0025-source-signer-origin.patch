+/* Borrow the next fixed Source profile original. It remains in Parent custody;
+ * the launch sender transfers only the kernel SCM_RIGHTS reference. */
+int aos_resource_parent_source_profile_file(Service *service, unsigned file,
+                                             int *ret_fd, const uint8_t **ret_digest) {
+        AosResourceParent *parent = aos_resource_parent_original();
+        int r = aos_resource_parent_require_source_sender(service);
+        if (r < 0)
+                return r;
+        int member = parent_member_index(UNIT(service)->id);
+        if (member < 0 || file > parent_u16(parent_row(member) + 352))
+                return -ENOENT;
