+int aos_launch_record_receive_once(AosLaunchRecord *record, int socket, AosLaunchRecordShape shape) {
+        size_t bytes;
+        struct cmsghdr *header;
+
+        assert(record);
+        if (record->attempted)
+                return record->receive_result < 0 ? record->receive_result : -EALREADY;
+        switch (shape) {
+        case AOS_LAUNCH_RECORD_128:
+                bytes = 129; /* Detect an overlong record without accepting its prefix. */
+                break;
+        case AOS_LAUNCH_RECORD_SOURCE_BUDGET_368:
+                bytes = 369;
+                break;
+        case AOS_LAUNCH_RECORD_SOURCE_COMPLETION_304:
+                bytes = 305;
+                break;
+        default:
+                return -EINVAL;
+        }
+
+        record->attempted = true;
+        record->kernel_pidfd = -EBADF;
+        struct iovec iov = { .iov_base = record->payload, .iov_len = bytes };
+        struct msghdr message = {
+                .msg_iov = &iov, .msg_iovlen = 1,
+                .msg_control = record->control.bytes, .msg_controllen = sizeof(record->control.bytes),
+        };
+        record->length = recvmsg(socket, &message, MSG_DONTWAIT | MSG_CMSG_CLOEXEC);
+        record->receive_result = record->length < 0 ? -errno : 0;
+        record->control_length = message.msg_controllen;
+        record->flags = message.msg_flags;
+        if (record->receive_result < 0)
+                return record->receive_result;
+
+        /* Do not stop on the first bad header: subsequent SCM_RIGHTS/SCM_PIDFD
+         * descriptors have already been installed by this actual recvmsg. */
+        CMSG_FOREACH(header, &message) {
+                size_t body = header->cmsg_len >= CMSG_LEN(0) ? header->cmsg_len - CMSG_LEN(0) : 0;
+                if (header->cmsg_level != SOL_SOCKET) {
+                        record->malformed = true;
+                        continue;
+                }
+                if (IN_SET(header->cmsg_type, SCM_RIGHTS, SCM_PIDFD)) {
+                        unsigned count = body / sizeof(int);
+                        const int *fds = (const int*) CMSG_DATA(header);
+                        if (body % sizeof(int) != 0 || count == 0)
+                                record->malformed = true;
