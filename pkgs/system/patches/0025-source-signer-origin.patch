+TEST(actual_rights_stay_owned_until_semantic_refusal) {
+        _cleanup_close_pair_ int sockets[2] = EBADF_PAIR;
+        _cleanup_close_ int original = -EBADF;
+        AosLaunchRecord sample = {};
+        uint8_t bytes[128] = {};
+
+        assert_se(socketpair(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0, sockets) == 0);
+        original = open("/dev/null", O_RDONLY | O_CLOEXEC);
+        assert_se(original >= 0);
+        struct iovec iov = { .iov_base = bytes, .iov_len = sizeof(bytes) };
+        assert_se(send_one_fd_iov(sockets[0], original, &iov, 1, MSG_NOSIGNAL) == sizeof(bytes));
+
+        assert_se(aos_launch_record_receive_once(&sample, sockets[1], AOS_LAUNCH_RECORD_128) == 0);
+        assert_se(sample.length == 128);
+        assert_se(sample.rights_count == 1 && sample.descriptor_count == 1);
+        assert_se(fcntl(sample.descriptors[0], F_GETFD) >= 0);
+        /* Controller purpose rejects this RIGHT, but the shared sample must
+         * retain it before that distinct semantic decision. Reentry cannot
+         * overwrite the actual received descriptor or acquire another one. */
+        int retained = sample.descriptors[0];
+        assert_se(aos_launch_record_receive_once(&sample, sockets[1], AOS_LAUNCH_RECORD_128) == -EALREADY);
+        assert_se(sample.descriptors[0] == retained && fcntl(retained, F_GETFD) >= 0);
+        safe_close(retained);
+}
+
+TEST(overlong_native_record_is_not_accepted_as_fixed_prefix) {
+        _cleanup_close_pair_ int sockets[2] = EBADF_PAIR;
+        AosLaunchRecord sample = {};
+        uint8_t bytes[129] = {};
+
+        assert_se(socketpair(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0, sockets) == 0);
+        assert_se(send(sockets[0], bytes, sizeof(bytes), MSG_NOSIGNAL) == sizeof(bytes));
+
+        assert_se(aos_launch_record_receive_once(&sample, sockets[1], AOS_LAUNCH_RECORD_128) == 0);
+        assert_se(sample.length == 129);
+        assert_se(sample.descriptor_count == 0);
+}
+
+TEST(source_usage_records_keep_full_payload_and_native_rights) {
+        _cleanup_close_pair_ int sockets[2] = EBADF_PAIR;
+        _cleanup_close_ int executable = -EBADF;
+        AosLaunchRecord sample = {};
+        uint8_t bytes[304] = {};
+
+        assert_se(socketpair(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0, sockets) == 0);
+        executable = open("/dev/null", O_PATH | O_CLOEXEC);
+        assert_se(executable >= 0);
+        bytes[303] = 37;
+        struct iovec iov = { .iov_base = bytes, .iov_len = sizeof(bytes) };
+        assert_se(send_one_fd_iov(sockets[0], executable, &iov, 1, MSG_NOSIGNAL) == sizeof(bytes));
+
+        assert_se(aos_launch_record_receive_once(&sample, sockets[1], AOS_LAUNCH_RECORD_SOURCE_COMPLETION_304) == 0);
+        assert_se(sample.length == sizeof(bytes) && sample.payload[303] == 37);
+        assert_se(sample.rights_count == 1 && sample.descriptor_count == 1);
+        assert_se(fcntl(sample.descriptors[0], F_GETFD) >= 0);
+        safe_close(sample.descriptors[0]);
+}
+
+TEST(source_budget_detects_overlong_full_vector_record) {
+        _cleanup_close_pair_ int sockets[2] = EBADF_PAIR;
+        AosLaunchRecord sample = {};
+        uint8_t bytes[369] = {};
+
+        assert_se(socketpair(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC, 0, sockets) == 0);
+        assert_se(send(sockets[0], bytes, sizeof(bytes), MSG_NOSIGNAL) == sizeof(bytes));
+        assert_se(aos_launch_record_receive_once(&sample, sockets[1], AOS_LAUNCH_RECORD_SOURCE_BUDGET_368) == 0);
+        assert_se(sample.length == sizeof(bytes));
+        assert_se(sample.descriptor_count == 0);
+}
+
+DEFINE_TEST_MAIN(LOG_INFO);
