+/* This closed path only handles the selected final V7 Controller. Other
+ * image families retain their original once-only delivery behavior. */
+static bool controller_launch_selected(const Unit *unit) {
+        return enrollment.parent.selected &&
+               IN_SET(enrollment.policy_bytes, AOS_RESOURCE_CREATE_STORAGE_POLICY_BYTES,
+                      AOS_RESOURCE_OPERATION_INTAKE_POLICY_BYTES, AOS_RESOURCE_HOST_EXECUTION_POLICY_BYTES,
+                      AOS_RESOURCE_CONTROLLER_RECOVERY_POLICY_BYTES) &&
+               streq_ptr(unit->id, "aos-sandboxd.service");
+}
