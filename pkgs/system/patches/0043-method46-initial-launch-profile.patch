@@ -0,0 +1,20 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include "aos-fixed-service-profile.h"
+#include "service.h"
+
+/* Compare only the fixed manual launch grammar. Parent admission, pinned
+ * executable identity and the actual child original remain independent. */
+static inline bool aos_method46_initial_start_matches(const Service *service, const ExecCommand *command) {
+        if (!service || !command ||
+            aos_fixed_service_method46_initial_index(aos_fixed_service_role(service->meta.id)) < 0)
+                return false;
+
+        /* Type=exec retains the live invocation through the producer's posts.
+         * The two fixed executables select their purpose without argv selectors. */
+        return service->type == SERVICE_EXEC && !service->remain_after_exit &&
+               command == service->exec_command[SERVICE_EXEC_START] && !command->command_next &&
+               !isempty(command->path) && command->argv &&
+               streq_ptr(command->argv[0], command->path) && !command->argv[1];
+}
