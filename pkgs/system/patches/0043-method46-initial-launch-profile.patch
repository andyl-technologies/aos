+TEST(manual_initial_start_requires_argument_free_live_exec) {
+        AosFixedServiceProfileRole role;
+
+        FOREACH_ARGUMENT(role, AOS_FIXED_PROFILE_METHOD46_CONTROLLER_INITIAL,
+                               AOS_FIXED_PROFILE_METHOD46_STORAGE_INITIAL) {
+                char *argv[] = { (char*) "/fixed/initial-producer", NULL, NULL };
+                ExecCommand command = { .path = argv[0], .argv = argv };
+                Service service = {
+                        .meta.id = (char*) aos_fixed_service_unit_name(role),
+                        .type = SERVICE_EXEC,
+                        .exec_command[SERVICE_EXEC_START] = &command,
+                };
+                ExecCommand foreign = command;
+
+                ASSERT_TRUE(aos_method46_initial_start_matches(&service, &command));
+                ASSERT_FALSE(aos_method46_initial_start_matches(NULL, &command));
+                ASSERT_FALSE(aos_method46_initial_start_matches(&service, NULL));
+                ASSERT_FALSE(aos_method46_initial_start_matches(&service, &foreign));
+
+                service.type = SERVICE_ONESHOT;
+                service.remain_after_exit = true;
+                argv[1] = (char*) (role == AOS_FIXED_PROFILE_METHOD46_CONTROLLER_INITIAL ?
+                        "--controller-initial-v1" : "--storage-initial-v1");
+                ASSERT_FALSE(aos_method46_initial_start_matches(&service, &command));
+                service.type = SERVICE_EXEC;
+                service.remain_after_exit = false;
+                ASSERT_FALSE(aos_method46_initial_start_matches(&service, &command));
+                argv[1] = NULL;
+                service.remain_after_exit = true;
+                ASSERT_FALSE(aos_method46_initial_start_matches(&service, &command));
+                service.remain_after_exit = false;
+                service.type = SERVICE_ONESHOT;
+                ASSERT_FALSE(aos_method46_initial_start_matches(&service, &command));
+                service.type = SERVICE_EXEC;
+
+                command.command_next = &foreign;
+                ASSERT_FALSE(aos_method46_initial_start_matches(&service, &command));
+                command.command_next = NULL;
+                command.argv = NULL;
+                ASSERT_FALSE(aos_method46_initial_start_matches(&service, &command));
+                command.argv = argv;
+                argv[0] = NULL;
+                ASSERT_FALSE(aos_method46_initial_start_matches(&service, &command));
+                argv[0] = (char*) "/foreign/producer";
+                ASSERT_FALSE(aos_method46_initial_start_matches(&service, &command));
+                argv[0] = command.path;
+                service.meta.id = (char*) "aos-sandbox-runtime-publisher.service";
+                ASSERT_FALSE(aos_method46_initial_start_matches(&service, &command));
+                service.meta.id = (char*) aos_fixed_service_unit_name(role);
+                ASSERT_TRUE(aos_method46_initial_start_matches(&service, &command));
         }
