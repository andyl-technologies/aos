diff --git a/src/nspawn/nspawn-root-fd.c b/src/nspawn/nspawn-root-fd.c
new file mode 100644
index 000000000..2db084a95
--- /dev/null
+++ b/src/nspawn/nspawn-root-fd.c
@@ -0,0 +1,77 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+
+#include <fcntl.h>
+#include <sys/file.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include "sd-daemon.h"
+
+#include "alloc-util.h"
+#include "fd-util.h"
+#include "nspawn-root-fd.h"
+#include "string-util.h"
+#include "strv.h"
+
+int aos_root_directory_from_fd(int fd, int *ret_root_fd, int *ret_lock_fd, char **ret_path) {
+        _cleanup_close_ int root_fd = -EBADF, lock_fd = -EBADF;
+        _cleanup_free_ char *path = NULL;
+        struct stat source, host_root;
+
+        assert(ret_root_fd);
+        assert(ret_lock_fd);
+        assert(ret_path);
+
+        root_fd = fcntl(fd, F_DUPFD_CLOEXEC, SD_LISTEN_FDS_START);
+        if (root_fd < 0)
+                return -errno;
+        if (fstat(root_fd, &source) < 0 || stat("/", &host_root) < 0)
+                return -errno;
+        if (!S_ISDIR(source.st_mode))
+                return -ENOTDIR;
+        if (source.st_dev == host_root.st_dev && source.st_ino == host_root.st_ino)
+                return -EINVAL;
+
+        /* Open a fresh file description for an inode lock, not a pathname lock.
+         * Independent launches of the same root must contend even after rename.
+         * The broker retains allocation authority; this is additional local
+         * exclusion, not cooperation with upstream's pathname-based image lock. */
+        lock_fd = openat(root_fd, ".", O_RDONLY|O_DIRECTORY|O_NOFOLLOW|O_CLOEXEC);
+        if (lock_fd < 0)
+                return -errno;
+        if (flock(lock_fd, LOCK_EX|LOCK_NB) < 0)
+                return -errno;
+
+        /* This alias is diagnostic only. Runtime setup imports the detached
+         * descriptor through the new mount API; it must never canonicalize the
+         * alias or reopen a replaceable host pathname. The mount operation is
+         * also the final kernel check that the received tree is transferable. */
+        if (asprintf(&path, "/proc/self/fd/%d", root_fd) < 0)
+                return -ENOMEM;
+
+        *ret_root_fd = TAKE_FD(root_fd);
+        *ret_lock_fd = TAKE_FD(lock_fd);
+        *ret_path = TAKE_PTR(path);
+        return 0;
+}
+
+int aos_root_directory_acquire(int *ret_root_fd, int *ret_lock_fd, char **ret_path) {
+        _cleanup_strv_free_ char **names = NULL;
+        int n, r;
+
+        /* This is a setup-only descriptor, never a payload activation socket.
+         * Unsetting LISTEN_* makes the later fdset collector empty. Require the
+         * exact role and arity before adopting anything; generic nspawn socket
+         * activation remains unchanged when this option is absent. */
+        n = sd_listen_fds_with_names(/* unset_environment= */ true, &names);
+        if (n < 0)
+                return n;
+        if (n != 1 || !streq_ptr(names[0], AOS_ROOT_DIRECTORY_FD_NAME))
+                r = -EINVAL;
+        else
+                r = aos_root_directory_from_fd(SD_LISTEN_FDS_START, ret_root_fd, ret_lock_fd, ret_path);
+
+        for (int i = 0; i < n; i++)
+                safe_close(SD_LISTEN_FDS_START + i);
+        return r;
+}
