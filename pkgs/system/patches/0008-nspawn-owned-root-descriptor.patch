diff --git a/src/nspawn/test-nspawn-root-fd.c b/src/nspawn/test-nspawn-root-fd.c
new file mode 100644
index 000000000..ce64fdf28
--- /dev/null
+++ b/src/nspawn/test-nspawn-root-fd.c
@@ -0,0 +1,105 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include "sd-daemon.h"
+
+#include "alloc-util.h"
+#include "fd-util.h"
+#include "nspawn-root-fd.h"
+#include "path-util.h"
+#include "process-util.h"
+#include "rm-rf.h"
+#include "tests.h"
+#include "tmpfile-util.h"
+
+TEST(root_descriptor_survives_path_replacement) {
+        _cleanup_(rm_rf_physical_and_freep) char *parent = NULL;
+        _cleanup_free_ char *original = NULL, *renamed = NULL, *alias = NULL, *second_alias = NULL;
+        _cleanup_close_ int source = -EBADF, root = -EBADF, lock = -EBADF, second_root = -EBADF, second_lock = -EBADF;
+        struct stat before, after, replacement;
+
+        ASSERT_OK(mkdtemp_malloc("/tmp/test-nspawn-root-fd.XXXXXX", &parent));
+        ASSERT_NOT_NULL(original = path_join(parent, "root"));
+        ASSERT_NOT_NULL(renamed = path_join(parent, "renamed"));
+        ASSERT_OK_ERRNO(mkdir(original, 0700));
+        ASSERT_OK_ERRNO(source = open(original, O_PATH|O_DIRECTORY|O_CLOEXEC));
+        ASSERT_OK_ERRNO(fstat(source, &before));
+        ASSERT_OK(aos_root_directory_from_fd(source, &root, &lock, &alias));
+        ASSERT_ERROR(aos_root_directory_from_fd(source, &second_root, &second_lock, &second_alias), EWOULDBLOCK);
+        source = safe_close(source);
+
+        ASSERT_OK_ERRNO(rename(original, renamed));
+        ASSERT_OK_ERRNO(mkdir(original, 0700));
+        ASSERT_OK_ERRNO(stat(alias, &after));
+        ASSERT_OK_ERRNO(stat(original, &replacement));
+        ASSERT_EQ(before.st_dev, after.st_dev);
+        ASSERT_EQ(before.st_ino, after.st_ino);
+        ASSERT_NE(after.st_ino, replacement.st_ino);
+        ASSERT_TRUE(FLAGS_SET(fcntl(root, F_GETFD), FD_CLOEXEC));
+        ASSERT_TRUE(FLAGS_SET(fcntl(lock, F_GETFD), FD_CLOEXEC));
+
+        lock = safe_close(lock);
+        ASSERT_OK(aos_root_directory_from_fd(root, &second_root, &second_lock, &second_alias));
+}
+
+TEST(rejects_host_root_and_non_directory) {
+        _cleanup_close_ int source = -EBADF, root = -EBADF, lock = -EBADF;
+        _cleanup_free_ char *alias = NULL;
+
+        ASSERT_OK_ERRNO(source = open("/", O_PATH|O_DIRECTORY|O_CLOEXEC));
+        ASSERT_ERROR(aos_root_directory_from_fd(source, &root, &lock, &alias), EINVAL);
+        source = safe_close(source);
+        ASSERT_OK_ERRNO(source = open("/dev/null", O_PATH|O_CLOEXEC));
+        ASSERT_ERROR(aos_root_directory_from_fd(source, &root, &lock, &alias), ENOTDIR);
+        ASSERT_ERROR(aos_root_directory_from_fd(-1, &root, &lock, &alias), EBADF);
+}
+
+TEST(setup_role_is_exact_and_not_forwarded) {
+        _cleanup_(rm_rf_physical_and_freep) char *directory = NULL;
+        static const struct {
+                const char *count;
+                const char *names;
+                int expected;
+        } cases[] = {
+                { "1", AOS_ROOT_DIRECTORY_FD_NAME, 0 },
+                { "0", "", -EINVAL },
+                { "1", "unexpected", -EINVAL },
+                { "2", AOS_ROOT_DIRECTORY_FD_NAME ":unexpected", -EINVAL },
+        };
+
+        ASSERT_OK(mkdtemp_malloc("/tmp/test-nspawn-root-role.XXXXXX", &directory));
+        FOREACH_ELEMENT(c, cases) {
+                int r;
+
+                ASSERT_OK(r = safe_fork("(aos-root-role)", FORK_WAIT, NULL));
+                if (r == 0) {
+                        _cleanup_free_ char *pid = NULL, *alias = NULL;
+                        int source, root = -EBADF, lock = -EBADF;
+
+                        ASSERT_OK_ERRNO(source = open(directory, O_PATH|O_DIRECTORY|O_CLOEXEC));
+                        ASSERT_OK_ERRNO(dup2(source, SD_LISTEN_FDS_START));
+                        if (source != SD_LISTEN_FDS_START)
+                                safe_close(source);
+                        if (c->count[0] == '2')
+                                ASSERT_OK_ERRNO(dup2(SD_LISTEN_FDS_START, SD_LISTEN_FDS_START + 1));
+                        ASSERT_OK_ERRNO(asprintf(&pid, "%d", getpid()));
+                        ASSERT_OK_ERRNO(setenv("LISTEN_PID", pid, 1));
+                        ASSERT_OK_ERRNO(setenv("LISTEN_FDS", c->count, 1));
+                        ASSERT_OK_ERRNO(setenv("LISTEN_FDNAMES", c->names, 1));
+
+                        ASSERT_EQ(aos_root_directory_acquire(&root, &lock, &alias), c->expected);
+                        ASSERT_NULL(getenv("LISTEN_PID"));
+                        ASSERT_NULL(getenv("LISTEN_FDS"));
+                        ASSERT_NULL(getenv("LISTEN_FDNAMES"));
+                        ASSERT_EQ(sd_listen_fds(/* unset_environment= */ false), 0);
+                        if (c->count[0] != '0')
+                                ASSERT_ERROR_ERRNO(fcntl(SD_LISTEN_FDS_START, F_GETFD), EBADF);
+                        _exit(EXIT_SUCCESS);
+                }
+        }
+}
+
+DEFINE_TEST_MAIN(LOG_DEBUG);
