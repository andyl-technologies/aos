diff --git a/src/core/aos-network-worker-source.inc b/src/core/aos-network-worker-source.inc
--- /dev/null
+++ b/src/core/aos-network-worker-source.inc
@@ -0,0 +1,515 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+
+/* Private Network source mechanics of aos-resource-enrollment.c.
+ *
+ * Both fixed socket activations borrow the same original admitted Network M
+ * account. Accepted OFDs, stable peer pins, partial Unit models and native
+ * cgroup observations remain in its two once-only owners. No decoded request,
+ * caller-selected Unit or count can select a payer or rearm these slots.
+ */
+
+static int network_worker_refuse(AosNetworkWorkerOriginal *original, int error) {
+        assert(error < 0);
+        if (original->first_error == 0)
+                original->first_error = error;
+        return aos_resource_parent_fail(original->first_error);
+}
+
+static int network_worker_socket_purpose(Socket *socket) {
+        if (!enrollment.parent.selected)
+                return -1;
+        if (streq_ptr(UNIT(socket)->id, "aos-sandbox-network-worker.socket"))
+                return 0;
+        if (streq_ptr(UNIT(socket)->id, "aos-sandbox-network-observation-worker.socket"))
+                return 1;
+        return -1;
+}
+
+static bool network_worker_name(const Unit *unit, unsigned purpose) {
+        const char *prefix = purpose == 0 ? "aos-sandbox-network-worker@" :
+                                           "aos-sandbox-network-observation-worker@";
+        return unit->type == UNIT_SERVICE && unit->id &&
+               startswith(unit->id, prefix) && endswith(unit->id, ".service");
+}
+
+static Service *network_worker_source(Manager *manager) {
+        Unit *unit = manager_get_unit(manager, "aos-netd.service");
+        AosSourceOrigin *origin = &enrollment.network_origin;
+
+        if (!enrollment.parent.selected || !enrollment.parent.installed ||
+            enrollment.parent.manager != manager || !unit || unit->type != UNIT_SERVICE ||
+            origin->transport.unit != unit || !origin->transport.entered ||
+            origin->transport.first_error < 0 || origin->exec_error < 0 ||
+            !origin->exec_complete || !origin->transport.delivered || !origin->exec_eof ||
+            !origin->bootstrap_closed || !origin->clone.attempted || origin->clone.spawn_result != 0 ||
+            origin->clone.pidfd < 0 || origin->transport.recipient.fd < 0 ||
+            sd_id128_is_null(origin->transport.invocation) ||
+            !sd_id128_equal(origin->transport.invocation, unit->invocation_id))
+                return NULL;
+        return SERVICE(unit);
+}
+
+/* All entered peer observations retain their actual Results. The after checks
+ * are independent of lookup, profile and identity failures. No PID reopening
+ * or pidref_equal error fallback participates in this comparison. */
+static int network_worker_observe_source(AosNetworkWorkerOriginal *original, unsigned phase) {
+        Service *source;
+        if (!UNIT_ISSET(original->source))
+                return network_worker_refuse(original, -EOWNERDEAD);
+        source = SERVICE(UNIT_DEREF(original->source));
+        AosSourceOrigin *origin = &enrollment.network_origin;
+        PidRef *subjects[3] = { &original->peer, &source->main_pid, &origin->transport.recipient };
+        int first = 0, r;
+
+        if (phase >= ELEMENTSOF(original->observed) || original->observed[phase])
+                return network_worker_refuse(original, -EALREADY);
+        original->observed[phase] = true;
+
+        for (unsigned i = 0; i < ELEMENTSOF(subjects); i++) {
+                original->verify_before[phase][i] = pidref_verify(subjects[i]);
+                if (first == 0 && original->verify_before[phase][i] < 0)
+                        first = original->verify_before[phase][i];
+        }
+
+        if (first == 0) {
+                for (unsigned i = 0; i < ELEMENTSOF(subjects); i++) {
+                        original->acquire_ids[phase][i] = pidref_acquire_pidfd_id(subjects[i]);
+                        original->pidfd_ids[phase][i] = subjects[i]->fd_id;
+                        if (first == 0 && original->acquire_ids[phase][i] < 0)
+                                first = original->acquire_ids[phase][i];
+                }
+                if (first == 0 && (original->pidfd_ids[phase][0] == 0 ||
+                    original->pidfd_ids[phase][0] != original->pidfd_ids[phase][1] ||
+                    original->pidfd_ids[phase][0] != original->pidfd_ids[phase][2]))
+                        first = -EOWNERDEAD;
+        }
+
+        if (first == 0) {
+                original->peer_unit[phase] = manager_get_unit_by_pidref_cgroup(UNIT(source)->manager, &original->peer);
+                if (original->peer_unit[phase] != UNIT(source) || !source->main_pid_known ||
+                    source->main_pid_alien || !IN_SET(source->state, SERVICE_START, SERVICE_RUNNING) ||
+                    source->main_command != source->exec_command[SERVICE_EXEC_START] ||
+                    source->main_command != origin->transport.main_command ||
+                    !source->main_command || source->main_command->command_next ||
+                    !sd_id128_equal(original->source_invocation, UNIT(source)->invocation_id))
+                        first = -EOWNERDEAD;
+        }
+
+        if (first == 0) {
+                original->parent_profile[phase] = aos_resource_parent_require_source_profile(
+                                source, origin->transport.main_command, origin->transport.main_flags);
+                if (original->parent_profile[phase] < 0)
+                        first = original->parent_profile[phase];
+        }
+        if (first == 0) {
+                original->parent_context[phase] = aos_resource_parent_context(UNIT(source), false);
+                if (original->parent_context[phase] < 0)
+                        first = original->parent_context[phase];
+        }
+        if (first == 0) {
+                original->parent_sender[phase] = aos_resource_parent_require_source_sender(source);
+                if (original->parent_sender[phase] < 0)
+                        first = original->parent_sender[phase];
+        }
+
+        for (unsigned i = 0; i < ELEMENTSOF(subjects); i++) {
+                original->verify_after[phase][i] = pidref_verify(subjects[i]);
+                if (first == 0 && original->verify_after[phase][i] < 0)
+                        first = original->verify_after[phase][i];
+        }
+        r = first;
+        return r < 0 ? network_worker_refuse(original, r) : 0;
+}
+
+/* The fixed listener is known before accept4. Enter the existing sender
+ * account before that native allocation, not after an accepted FD exists. */
+int aos_resource_network_worker_socket_scope(Socket *socket, SocketPort *port,
+                                               AllocationAccountScope *scope) {
+        int purpose = network_worker_socket_purpose(socket), r;
+        Service *source;
+        AosNetworkWorkerOriginal *original;
+        const char *path;
+
+        if (purpose < 0)
+                return 0;
+        source = network_worker_source(UNIT(socket)->manager);
+        if (!source)
+                return aos_resource_parent_fail(-EOWNERDEAD);
+        r = aos_resource_parent_source_exec_scope(source, scope);
+        if (r < 0)
+                return r;
+        original = &enrollment.network_workers[purpose];
+        original->purpose = (unsigned) purpose;
+        if (original->entered || original->first_error < 0)
+                return network_worker_refuse(original, original->first_error < 0 ? original->first_error : -EALREADY);
+        path = purpose == 0 ? "/run/aos/sandbox-network-worker/control.sock" :
+                              "/run/aos/sandbox-network-observation-worker/control.sock";
+        /* This closed profile reaches only PASSCRED and PASSPIDFD in the
+         * unchanged shared option engine. Observation also has its exact
+         * two configured1MiB buffers. No forked IP accept helper is entered. */
+        if (port->type != SOCKET_SOCKET || port->address.sockaddr.sa.sa_family != AF_UNIX ||
+            port->address.type != SOCK_SEQPACKET ||
+            !streq_ptr(port->address.sockaddr.un.sun_path, path) || !socket->accept ||
+            socket->max_connections != 1 || socket->max_connections_per_source != 0 ||
+            !socket->pass_cred || !socket->pass_pidfd || !socket->pass_rights ||
+            socket->keep_alive || timestamp_is_set(socket->keep_alive_time) ||
+            socket->keep_alive_interval > 0 || socket->keep_alive_cnt > 0 || socket->defer_accept > 0 ||
+            socket->no_delay || socket->broadcast || socket->pass_sec || socket->pass_pktinfo ||
+            socket->timestamping != SOCKET_TIMESTAMPING_OFF || socket->priority >= 0 ||
+            socket->receive_buffer != (purpose == 1 ? 1024U * 1024U : 0) ||
+            socket->send_buffer != (purpose == 1 ? 1024U * 1024U : 0) || socket->mark >= 0 ||
+            socket->ip_tos >= 0 || socket->ip_ttl >= 0 || socket->tcp_congestion ||
+            socket->smack_ip_in || socket->smack_ip_out)
+                return network_worker_refuse(original, -EPERM);
+        original->socket_fragment_result = aos_network_verify_loaded_fragment_retaining(UNIT(socket), &original->image);
+        if (original->socket_fragment_result < 0)
+                return network_worker_refuse(original, original->socket_fragment_result);
+        return 1;
+}
+
+void aos_resource_network_worker_accept_returned(Socket *socket, int result) {
+        int purpose = network_worker_socket_purpose(socket);
+        AosNetworkWorkerOriginal *original;
+
+        if (purpose < 0)
+                return;
+        original = &enrollment.network_workers[purpose];
+        original->accept_result = result;
+        if (result >= 0)
+                original->accepted_fd = result;
+        else {
+                original->entered = true;
+                (void) network_worker_refuse(original, result);
+        }
+}
+
+void aos_resource_network_worker_socket_option(AosNetworkWorkerOriginal *original, unsigned slot, int result) {
+        if (!original)
+                return;
+        assert(slot < ELEMENTSOF(original->socket_option_results));
+        if (original->socket_option_entered[slot]) {
+                if (original->first_error == 0)
+                        original->first_error = -EALREADY;
+                return;
+        }
+        original->socket_option_entered[slot] = true;
+        original->socket_option_results[slot] = result;
+        if (original->first_error == 0 && result < 0)
+                original->first_error = result;
+}
+
+int aos_resource_network_worker_socket_options_complete(AosNetworkWorkerOriginal *original) {
+        if (!original)
+                return 0;
+        if (original->first_error < 0)
+                return network_worker_refuse(original, original->first_error);
+        if (!original->socket_option_entered[0] || !original->socket_option_entered[1] ||
+            (original->purpose == 1 &&
+             (!original->socket_option_entered[2] || !original->socket_option_entered[3])))
+                return network_worker_refuse(original, -EOWNERDEAD);
+        return 0;
+}
+
+/* This scope precedes socket peer buckets, service model parsing and job
+ * construction. Their actual allocations belong to the same original M
+ * sender; the child's MemoryMax never pays for PID1's causative heap. */
+int aos_resource_network_worker_accept_begin(Socket *socket, int *accepted,
+                                             AllocationAccountScope *scope,
+                                             AosNetworkWorkerOriginal **ret) {
+        int purpose = network_worker_socket_purpose(socket), r;
+        AosNetworkWorkerOriginal *original;
+        Service *source;
+        Unit *root_scope;
+
+        *ret = NULL;
+        if (purpose < 0)
+                return 0;
+        source = network_worker_source(UNIT(socket)->manager);
+        if (!source)
+                return aos_resource_parent_fail(-EOWNERDEAD);
+        r = allocation_account_active() ? aos_resource_parent_require_source_sender(source) :
+                                         aos_resource_parent_source_exec_scope(source, scope);
+        if (r < 0)
+                return r;
+
+        original = &enrollment.network_workers[purpose];
+        *ret = original;
+        if (original->entered)
+                return network_worker_refuse(original, -EALREADY);
+        root_scope = manager_get_unit(UNIT(socket)->manager, "init.scope");
+        if (!root_scope)
+                return network_worker_refuse(original, -EOWNERDEAD);
+        original->entered = true;
+        original->purpose = (unsigned) purpose;
+        unit_ref_set(&original->socket, root_scope, UNIT(socket));
+        unit_ref_set(&original->source, root_scope, UNIT(source));
+        original->source_invocation = UNIT(source)->invocation_id;
+        if (*accepted < 0)
+                return network_worker_refuse(original, -EBADF);
+
+        /* Park the real accepted OFD before any duplication/adoption can fail. */
+        original->accepted_fd = TAKE_FD(*accepted);
+        original->peer_fd = getpeerpidfd(original->accepted_fd);
+        if (original->peer_fd < 0) {
+                int first = original->peer_fd;
+                original->first_error = first;
+                (void) network_worker_observe_source(original, 0);
+                return network_worker_refuse(original, first);
+        }
+        original->peer_adoption_result = pidref_set_pidfd_take(&original->peer, original->peer_fd);
+        if (original->peer_adoption_result < 0) {
+                int first = original->peer_adoption_result;
+                original->first_error = first;
+                (void) network_worker_observe_source(original, 0);
+                return network_worker_refuse(original, first);
+        }
+        original->peer_fd = -EBADF; /* Ownership moved only on real adoption success. */
+        r = network_worker_observe_source(original, 0);
+        if (r < 0)
+                return r;
+        original->delivery_result = fcntl(original->accepted_fd, F_DUPFD_CLOEXEC, 3);
+        if (original->delivery_result < 0) {
+                original->delivery_result = -errno;
+                return network_worker_refuse(original, original->delivery_result);
+        }
+        *accepted = original->delivery_result;
+        return 1;
+}
+
+int aos_resource_network_worker_accept_loaded(AosNetworkWorkerOriginal *original, Unit *worker, int load_result) {
+        Unit *slice;
+        Service *service;
+
+        if (!original)
+                return 0;
+        if (original->first_error < 0)
+                return original->first_error;
+        original->loaded_result = load_result;
+        if (UNIT_ISSET(original->worker))
+                return network_worker_refuse(original, -EALREADY);
+        /* The real returned partial Unit remains owned even on load error. */
+        if (worker)
+                unit_ref_set(&original->worker, original->source.source, worker);
+        if (load_result < 0)
+                return network_worker_refuse(original, load_result);
+        if (!worker || !network_worker_name(worker, original->purpose))
+                return network_worker_refuse(original, -EOWNERDEAD);
+        if (UNIT_IS_LOAD_ERROR(worker->load_state))
+                return network_worker_refuse(original, worker->load_error);
+        if (worker->load_state != UNIT_LOADED)
+                return network_worker_refuse(original, -EOWNERDEAD);
+        service = SERVICE(worker);
+        slice = UNIT_GET_SLICE(worker);
+        if (!slice || !streq_ptr(slice->id, "aoscomponents-network.slice") ||
+            !service->exec_command[SERVICE_EXEC_START] ||
+            service->exec_command[SERVICE_EXEC_START]->command_next)
+                return network_worker_refuse(original, -EPERM);
+        for (ServiceExecCommand command = 0; command < _SERVICE_EXEC_COMMAND_MAX; command++)
+                if (command != SERVICE_EXEC_START && service->exec_command[command])
+                        return network_worker_refuse(original, -EPERM);
+
+        original->fragment_result = aos_network_verify_loaded_fragment_retaining(worker, &original->image);
+        if (original->fragment_result < 0)
+                return network_worker_refuse(original, original->fragment_result);
+        return 0;
+}
+
+static AosNetworkWorkerOriginal *network_worker_for_service(Service *service) {
+        if (!enrollment.parent.selected)
+                return NULL;
+        FOREACH_ELEMENT(original, enrollment.network_workers)
+                if (UNIT_DEREF(original->worker) == UNIT(service))
+                        return original;
+        return NULL;
+}
+
+static bool network_worker_requires_original(Service *service) {
+        return enrollment.parent.selected &&
+               (network_worker_name(UNIT(service), 0) || network_worker_name(UNIT(service), 1));
+}
+
+static int network_worker_exec_scope(Service *service, ExecCommand *command, ExecFlags flags,
+                                       AllocationAccountScope *scope) {
+        AosNetworkWorkerOriginal *original = network_worker_for_service(service);
+        Service *source;
+        socklen_t size;
+        int r;
+
+        if (!original || !UNIT_ISSET(original->source) || !UNIT_ISSET(original->socket))
+                return aos_resource_parent_fail(-EOWNERDEAD);
+        source = SERVICE(UNIT_DEREF(original->source));
+        r = aos_resource_parent_source_exec_scope(source, scope);
+        if (r < 0)
+                return network_worker_refuse(original, r);
+        if (original->first_error < 0)
+                return original->first_error;
+        if (!original->entered || original->clone.attempted ||
+            command != service->exec_command[SERVICE_EXEC_START] || command->command_next ||
+            !FLAGS_SET(flags, EXEC_PASS_FDS) || service->socket_fd < 0 ||
+            UNIT_DEREF(service->accept_socket) != UNIT_DEREF(original->socket) ||
+            sd_id128_is_null(UNIT(service)->invocation_id))
+                return network_worker_refuse(original, -EOWNERDEAD);
+        if (original->invocation_bound &&
+            !sd_id128_equal(original->worker_invocation, UNIT(service)->invocation_id))
+                return network_worker_refuse(original, -EOWNERDEAD);
+        original->worker_invocation = UNIT(service)->invocation_id;
+        original->invocation_bound = true;
+
+        /* The service delivery must still be the same actual accepted OFD. */
+        for (unsigned i = 0; i < 2; i++) {
+                int fd = i == 0 ? original->accepted_fd : service->socket_fd;
+                size = sizeof(original->socket_cookies[i]);
+                original->socket_cookie_results[i] = getsockopt(fd, SOL_SOCKET, SO_COOKIE,
+                        &original->socket_cookies[i], &size) < 0 ? -errno :
+                        size == sizeof(original->socket_cookies[i]) ? 0 : -EBADMSG;
+        }
+        for (unsigned i = 0; i < 2; i++)
+                if (original->socket_cookie_results[i] < 0)
+                        return network_worker_refuse(original, original->socket_cookie_results[i]);
+        if (original->socket_cookies[0] == 0 || original->socket_cookies[0] != original->socket_cookies[1])
+                return network_worker_refuse(original, -EOWNERDEAD);
+
+        /* Selection comes from the accepted native source, independently of
+         * the loaded Slice. A wrong template/Slice cannot become ordinary. */
+        r = aos_network_verify_loaded_fragment_retaining(UNIT(service), &original->image);
+        return r < 0 ? network_worker_refuse(original, r) : 0;
+}
+
+/* unit_prepare_exec has already realized the unit's native controls. This
+ * held directory, not a later cgroup pathname or an after-READY observation,
+ * is passed directly to the existing atomic CLONE_INTO_CGROUP wrapper. */
+static int network_worker_capture_cgroup(AosNetworkWorkerOriginal *original, Service *service) {
+        static const char *const names[] = { "memory.max", "pids.max" };
+        static const char *const expected[] = { "268435456\n", "2\n" };
+        CGroupRuntime *runtime = unit_get_cgroup_runtime(UNIT(service));
+        CGroupContext *context = unit_get_cgroup_context(UNIT(service));
+        const struct rlimit *nofile = service->exec_context.rlimit[RLIMIT_NOFILE];
+        const char *expected_path;
+        int first = 0;
+
+        if (original->cgroup_attempted)
+                return network_worker_refuse(original, -EALREADY);
+        original->cgroup_attempted = true;
+        expected_path = strjoina("/aoscomponents.slice/aoscomponents-network.slice/", UNIT(service)->id);
+        if (!runtime || !runtime->cgroup_id || !streq_ptr(runtime->cgroup_path, expected_path) ||
+            !context || context->delegate || context->memory_max != 268435456U ||
+            !service->exec_context.no_new_privileges ||
+            (service->exec_context.capability_bounding_set & (UINT64_C(1) << CAP_SYS_RESOURCE)) ||
+            (context->startup_memory_max_set && context->startup_memory_max != context->memory_max) ||
+            context->tasks_max.value != 2 || context->tasks_max.scale != 0 ||
+            !nofile || nofile->rlim_cur != 128 || nofile->rlim_max != 128)
+                return original->cgroup_result = network_worker_refuse(original, -EPERM);
+
+        /* The trusted systemd executor also starts with this hard bound,
+         * before its normal per-command rlimit application. No wider inherited
+         * table is silently charged as the child's 128-entry source. */
+        original->inherited_nofile_result = getrlimit(RLIMIT_NOFILE, &original->inherited_nofile) < 0 ? -errno : 0;
+        if (original->inherited_nofile_result < 0)
+                return original->cgroup_result = network_worker_refuse(original, original->inherited_nofile_result);
+        if (original->inherited_nofile.rlim_cur != 128 || original->inherited_nofile.rlim_max != 128)
+                return original->cgroup_result = network_worker_refuse(original, -EPERM);
+
+        original->cgroup_native_path = strjoin("/sys/fs/cgroup", expected_path);
+        if (!original->cgroup_native_path)
+                return original->cgroup_result = network_worker_refuse(original, -ENOMEM);
+        original->cgroup_fd = cg_path_open(expected_path);
+        if (original->cgroup_fd < 0) {
+                first = original->cgroup_fd;
+                goto posts;
+        }
+        original->cgroup_stat_result = fstat(original->cgroup_fd, &original->cgroup_stat) < 0 ? -errno : 0;
+        original->cgroup_filesystem_result = fstatfs(original->cgroup_fd, &original->cgroup_filesystem) < 0 ? -errno : 0;
+        original->cgroup_id_result = fd_to_handle_u64(original->cgroup_fd, &original->cgroup_id);
+        original->named_directory_results[0] = fstatat(AT_FDCWD, original->cgroup_native_path,
+                &original->named_directory[0], AT_SYMLINK_NOFOLLOW) < 0 ? -errno : 0;
+        if (original->cgroup_stat_result < 0)
+                first = original->cgroup_stat_result;
+        else if (original->cgroup_filesystem_result < 0)
+                first = original->cgroup_filesystem_result;
+        else if (original->cgroup_id_result < 0)
+                first = original->cgroup_id_result;
+        else if (original->named_directory_results[0] < 0)
+                first = original->named_directory_results[0];
+        else if (!S_ISDIR(original->cgroup_stat.st_mode) ||
+                 original->cgroup_filesystem.f_type != CGROUP2_SUPER_MAGIC ||
+                 original->cgroup_id != runtime->cgroup_id ||
+                 original->named_directory[0].st_dev != original->cgroup_stat.st_dev ||
+                 original->named_directory[0].st_ino != original->cgroup_stat.st_ino)
+                first = -EOWNERDEAD;
+
+        if (first == 0)
+                for (unsigned i = 0; i < ELEMENTSOF(names); i++) {
+                        original->control_fds[i] = openat(original->cgroup_fd, names[i], O_RDONLY|O_CLOEXEC|O_NOFOLLOW);
+                        if (original->control_fds[i] < 0) {
+                                original->control_fds[i] = -errno;
+                                if (first == 0)
+                                        first = original->control_fds[i];
+                                continue;
+                        }
+                        original->control_stat_results[i] = fstat(original->control_fds[i], &original->control_stats[i]) < 0 ? -errno : 0;
+                        if (original->control_stat_results[i] < 0) {
+                                if (first == 0)
+                                        first = original->control_stat_results[i];
+                                continue;
+                        }
+                        if (!S_ISREG(original->control_stats[i].st_mode) ||
+                            original->control_stats[i].st_dev != original->cgroup_stat.st_dev) {
+                                if (first == 0)
+                                        first = -EPERM;
+                                continue;
+                        }
+                        int r = aos_resource_control_readback(original->control_fds[i], expected[i],
+                                original->control_readback[i], sizeof(original->control_readback[i]),
+                                &original->control_read_lengths[i], &original->control_read_results[i]);
+                        if (first == 0 && r < 0)
