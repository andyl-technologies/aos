diff --git a/src/nspawn/test-nspawn-seccomp.c b/src/nspawn/test-nspawn-seccomp.c
new file mode 100644
index 0000000..a0c27a1
--- /dev/null
+++ b/src/nspawn/test-nspawn-seccomp.c
@@ -0,0 +1,50 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+
+#include <linux/sched.h>
+#include <linux/seccomp.h>
+#include <sys/mount.h>
+#include <sys/prctl.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+#include "errno-util.h"
+#include "nspawn-seccomp.h"
+#include "process-util.h"
+#include "seccomp-util.h"
+#include "tests.h"
+
+static void test_profile_child(void) {
+        int r;
+
+        ASSERT_OK(prctl(PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0));
+        ASSERT_OK(setup_aos_payload_seccomp());
+        ASSERT_EQ(prctl(PR_GET_SECCOMP, 0, 0, 0, 0), SECCOMP_MODE_FILTER);
+
+        ASSERT_ERROR_ERRNO(chroot("/"), EPERM);
+        ASSERT_ERROR_ERRNO(mount(NULL, NULL, NULL, 0, NULL), EPERM);
+        ASSERT_ERROR_ERRNO(syscall(__NR_io_uring_setup, 0, NULL), EPERM);
+        ASSERT_ERROR_ERRNO(syscall(__NR_io_uring_enter, -1, 0, 0, 0, NULL, 0), EPERM);
+        ASSERT_ERROR_ERRNO(syscall(__NR_io_uring_register, -1, 0, NULL, 0), EPERM);
+        ASSERT_ERROR_ERRNO(syscall(__NR_unshare, 0), EPERM);
+        ASSERT_ERROR_ERRNO(syscall(__NR_clone3, NULL, 0), ENOSYS);
+        ASSERT_ERROR_ERRNO(syscall(__NR_clone, CLONE_NEWNS | SIGCHLD, NULL, NULL, NULL, 0), EPERM);
+
+        ASSERT_OK(r = pidref_safe_fork("(aos-seccomp-clone)", FORK_WAIT, NULL));
+        if (r == 0)
+                _exit(EXIT_SUCCESS);
+}
+
+TEST(aos_payload_profile) {
+        int r;
+
+        if (!is_seccomp_available())
+                return (void) log_tests_skipped("Seccomp not available");
+
+        ASSERT_OK(r = pidref_safe_fork("(aos-seccomp-profile)", FORK_WAIT, NULL));
+        if (r == 0) {
+                test_profile_child();
+                _exit(EXIT_SUCCESS);
+        }
+}
+
+DEFINE_TEST_MAIN(LOG_DEBUG);
