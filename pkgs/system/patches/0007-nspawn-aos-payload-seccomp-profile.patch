+static int add_aos_payload_rule(
+                scmp_filter_ctx ctx,
+                uint32_t arch,
+                uint32_t action,
+                const char *syscall_name,
+                int syscall_number,
+                unsigned argument_count,
+                const struct scmp_arg_cmp *arguments) {
+
+        int r;
+
+        r = sym_seccomp_rule_add_array(ctx, action, syscall_number, argument_count, arguments);
+        if (r < 0)
+                return log_error_errno(r,
+                                       "Failed to add AOS payload seccomp rule for %s on %s: %m",
+                                       syscall_name,
+                                       seccomp_arch_to_string(arch));
+
+        return 0;
+}
+
+int setup_aos_payload_seccomp(void) {
+        static const char *const denied_syscalls[] = {
+                "bpf",
+                "chroot",
+                "delete_module",
+                "finit_module",
+                "fsconfig",
+                "fsmount",
+                "fsopen",
+                "fspick",
+                "init_module",
+                "mount",
+                "mount_setattr",
+                "move_mount",
+                "open_tree",
+                "open_tree_attr",
+                "perf_event_open",
+                "pivot_root",
+                "ptrace",
+                "setns",
+                "umount",
+                "umount2",
+                "unshare",
+        };
+        static const unsigned long denied_clone_flags[] = {
+                CLONE_NEWCGROUP,
+                CLONE_NEWIPC,
+                CLONE_NEWNET,
+                CLONE_NEWNS,
+                CLONE_NEWPID,
+                CLONE_NEWTIME,
+                CLONE_NEWUSER,
+                CLONE_NEWUTS,
+        };
+        uint32_t arch;
+        int r;
+
+        if (!is_seccomp_available())
+                return log_error_errno(SYNTHETIC_ERRNO(EOPNOTSUPP),
+                                       "AOS payload profile requires kernel seccomp support.");
+
+        r = prctl(PR_GET_NO_NEW_PRIVS, 0, 0, 0, 0);
+        if (r < 0)
+                return log_error_errno(errno, "Failed to query no-new-privileges before AOS payload filter: %m");
+        if (r == 0)
+                return log_error_errno(SYNTHETIC_ERRNO(EPERM),
+                                       "AOS payload profile requires no-new-privileges.");
+
+        SECCOMP_FOREACH_LOCAL_ARCH(arch) {
+                _cleanup_(seccomp_releasep) scmp_filter_ctx seccomp = NULL;
+
+                r = seccomp_init_for_arch(&seccomp, arch, SCMP_ACT_ALLOW);
+                if (r < 0)
+                        return log_error_errno(r,
+                                               "Failed to allocate AOS payload seccomp filter for %s: %m",
+                                               seccomp_arch_to_string(arch));
+
+                FOREACH_ELEMENT(syscall_name, denied_syscalls) {
+                        int syscall_number;
+
+                        syscall_number = sym_seccomp_syscall_resolve_name(*syscall_name);
+                        if (syscall_number == __NR_SCMP_ERROR)
+                                return log_error_errno(SYNTHETIC_ERRNO(EOPNOTSUPP),
+                                                       "libseccomp does not recognize required AOS payload syscall %s.",
+                                                       *syscall_name);
+
+                        r = add_aos_payload_rule(
+                                        seccomp,
+                                        arch,
+                                        SCMP_ACT_ERRNO(EPERM),
+                                        *syscall_name,
+                                        syscall_number,
+                                        0,
+                                        NULL);
+                        if (r < 0)
+                                return r;
+                }
+
+                r = add_aos_payload_rule(
+                                seccomp,
+                                arch,
+                                SCMP_ACT_ERRNO(ENOSYS),
+                                "clone3",
+                                sym_seccomp_syscall_resolve_name("clone3"),
+                                0,
+                                NULL);
+                if (r < 0)
+                        return r;
+
+                FOREACH_ELEMENT(flag, denied_clone_flags) {
+                        const struct scmp_arg_cmp argument = SCMP_A0(SCMP_CMP_MASKED_EQ, *flag, *flag);
+
+                        r = add_aos_payload_rule(
+                                        seccomp,
+                                        arch,
+                                        SCMP_ACT_ERRNO(EPERM),
+                                        "clone",
+                                        sym_seccomp_syscall_resolve_name("clone"),
+                                        1,
+                                        &argument);
+                        if (r < 0)
+                                return r;
+                }
+
+                r = sym_seccomp_load(seccomp);
+                if (r < 0)
+                        return log_error_errno(r,
+                                               "Failed to install AOS payload seccomp filter for %s: %m",
+                                               seccomp_arch_to_string(arch));
+        }
+
+        return 0;
+}
