 static int add_syscall_filters(
                 scmp_filter_ctx ctx,
                 uint32_t arch,
@@ -246,6 +382,11 @@ int setup_seccomp(uint64_t cap_list_retain, char **syscall_allow_list, char **sy
 
 #else
 
