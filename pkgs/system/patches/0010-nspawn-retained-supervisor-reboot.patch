new file mode 100644
index 0000000..f6d7949
--- /dev/null
+++ b/src/nspawn/nspawn-lifecycle-cgroup.c
@@ -0,0 +1,195 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+
+#include <dirent.h>
+#include <fcntl.h>
+#include <linux/magic.h>
+#include <sys/stat.h>
+#include <sys/vfs.h>
+#include <unistd.h>
+
+#include "alloc-util.h"
+#include "cgroup-util.h"
+#include "errno-util.h"
+#include "fd-util.h"
+#include "fileio.h"
+#include "nspawn-lifecycle-cgroup.h"
+#include "path-util.h"
+#include "string-util.h"
+#include "strv.h"
+#include "time-util.h"
+
+typedef struct AosCgroupResetBudget {
+        unsigned directories;
+        unsigned entries;
+        size_t name_bytes;
+        usec_t deadline;
+} AosCgroupResetBudget;
+
+int aos_payload_cgroup_is_empty(const char *events) {
+        _cleanup_strv_free_ char **lines = NULL;
+        bool populated_seen = false;
+
+        assert(events);
+
+        if (strlen(events) > 512)
+                return -E2BIG;
+
+        lines = strv_split_newlines(events);
+        if (!lines)
+                return -ENOMEM;
+
+        STRV_FOREACH(line, lines) {
+                const char *value = startswith(*line, "populated ");
+
+                if (!value) {
+                        if (startswith(*line, "populated"))
+                                return -EBADMSG;
+                        continue; /* Future unrelated kernel fields do not change this decision. */
+                }
+
+                if (populated_seen)
+                        return -EBADMSG;
+                populated_seen = true;
+                if (streq(value, "1"))
+                        return -EBUSY;
+                if (!streq(value, "0"))
+                        return -EBADMSG;
+        }
+
+        return populated_seen ? 0 : -EBADMSG;
+}
+
+static int verify_cgroup_directory(int fd, dev_t *ret_device) {
+        struct statfs fs;
+        struct stat st;
+
+        if (fstatfs(fd, &fs) < 0 || fstat(fd, &st) < 0)
+                return -errno;
+        if (fs.f_type != CGROUP2_SUPER_MAGIC || !S_ISDIR(st.st_mode))
+                return -ENODEV;
+
+        *ret_device = st.st_dev;
+        return 0;
+}
+
+static int remove_empty_cgroup_at(int parent_fd, const char *name, dev_t device, unsigned depth, AosCgroupResetBudget *budget) {
+        _cleanup_close_ int fd = -EBADF;
+        _cleanup_closedir_ DIR *directory = NULL;
+        dev_t actual_device;
+        int r;
+
+        /* Charge before opening or descending. Depth bounds retained descriptors/stack, while global
+         * counters bound breadth and total work; an adversarial hierarchy never becomes a work queue. */
+        if (depth > 64 || budget->directories >= 4096 || now(CLOCK_BOOTTIME) >= budget->deadline)
+                return -E2BIG;
+        budget->directories++;
+
+        fd = openat(parent_fd, name, O_RDONLY|O_DIRECTORY|O_NOFOLLOW|O_CLOEXEC);
+        if (fd < 0)
+                return -errno;
+        r = verify_cgroup_directory(fd, &actual_device);
+        if (r < 0)
+                return r;
+        if (actual_device != device)
+                return -EXDEV;
+
+        directory = take_fdopendir(&fd);
+        if (!directory)
+                return -errno;
+
+        for (;;) {
+                struct dirent *entry;
+                struct stat st;
+                size_t length;
+
+                if (budget->entries >= 524288 || now(CLOCK_BOOTTIME) >= budget->deadline)
+                        return -E2BIG;
+                errno = 0;
+                entry = readdir(directory);
+                if (!entry) {
+                        if (errno != 0)
+                                return -errno;
+                        break;
+                }
+                budget->entries++;
+                length = strlen(entry->d_name);
+                if (length > 16U*1024U*1024U - budget->name_bytes)
+                        return -E2BIG;
+                budget->name_bytes += length;
+
+                if (dot_or_dot_dot(entry->d_name))
+                        continue;
+                if (fstatat(dirfd(directory), entry->d_name, &st, AT_SYMLINK_NOFOLLOW) < 0)
+                        return -errno;
+                if (st.st_dev != device)
+                        return -EXDEV;
+
+                if (S_ISREG(st.st_mode))
+                        continue; /* Kernel control files disappear with their directory; never unlink them. */
+                if (!S_ISDIR(st.st_mode))
+                        return -EBADMSG;
+
+                r = remove_empty_cgroup_at(dirfd(directory), entry->d_name, device, depth + 1, budget);
+                if (r < 0)
+                        return r;
+        }
+
+        if (now(CLOCK_BOOTTIME) >= budget->deadline)
+                return -E2BIG;
+        return RET_NERRNO(unlinkat(parent_fd, name, AT_REMOVEDIR));
+}
+
+int aos_payload_cgroup_reset_at(int unit_fd) {
+        _cleanup_close_ int payload_fd = -EBADF;
+        _cleanup_free_ char *events = NULL;
+        AosCgroupResetBudget budget = { .deadline = now(CLOCK_BOOTTIME) + 5*USEC_PER_SEC };
+        dev_t device, payload_device;
+        int r;
+
+        r = verify_cgroup_directory(unit_fd, &device);
+        if (r < 0)
+                return r;
+        payload_fd = openat(unit_fd, "payload", O_RDONLY|O_DIRECTORY|O_NOFOLLOW|O_CLOEXEC);
+        if (payload_fd < 0)
+                return -errno;
+        r = verify_cgroup_directory(payload_fd, &payload_device);
+        if (r < 0)
+                return r;
+        if (payload_device != device)
+                return -EXDEV;
+
+        /* populated includes all descendants. PID namespace teardown must already have killed them;
+         * do not kill unknown tasks or attempt a new boot when this precondition is not proven. */
+        r = read_full_file_full(payload_fd, "cgroup.events", UINT64_MAX, 512,
+                               READ_FULL_FILE_FAIL_WHEN_LARGER|READ_FULL_FILE_VERIFY_REGULAR,
+                               NULL, &events, NULL);
+        if (r < 0)
+                return r;
+        r = aos_payload_cgroup_is_empty(events);
+        if (r < 0)
+                return r;
+
+        /* Remove the root too, so guest-written limits and subtree controllers cannot survive a boot.
+         * Any failure leaves the supervisor to fail closed; the caller must not retry launch. */
+        return remove_empty_cgroup_at(unit_fd, "payload", device, 0, &budget);
+}
+
+int aos_payload_cgroup_reset(void) {
+        _cleanup_free_ char *path = NULL;
+        _cleanup_close_ int unit_fd = -EBADF;
+        char *suffix;
+        int r;
+
+        r = cg_pid_get_path(0, &path);
+        if (r < 0)
+                return r;
+        suffix = endswith(path, "/supervisor");
+        if (!suffix || suffix == path)
+                return -EINVAL;
+        *suffix = 0;
+
+        unit_fd = cg_path_open(path);
+        if (unit_fd < 0)
+                return unit_fd;
+        return aos_payload_cgroup_reset_at(unit_fd);
+}
