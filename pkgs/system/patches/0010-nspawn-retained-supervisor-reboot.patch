index 0000000..543e112
--- /dev/null
+++ b/src/nspawn/nspawn-lifecycle-cgroup.h
@@ -0,0 +1,12 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+/* Parses bounded kernel cgroup.events content; only an unambiguous populated=0 is empty. */
+int aos_payload_cgroup_is_empty(const char *events);
+
+/* Removes only the empty payload subtree of a caller-owned, pinned unit cgroup. The caller must
+ * have reaped the old payload PID 1 and exclude any concurrent payload launch or host migration. */
+int aos_payload_cgroup_reset_at(int unit_fd);
+
+/* Resolves the current supervisor's unit cgroup, then performs the bounded reset above. */
+int aos_payload_cgroup_reset(void);
