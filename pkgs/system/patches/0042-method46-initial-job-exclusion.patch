+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#pragma once
+
+#include "manager.h"
+#include "strv.h"
+#include "unit.h"
+
+/* PID1 serializes job dispatch and migration. Keep this test at those native
+ * boundaries as well as transaction admission: jobs in the same transaction
+ * are not yet visible through Unit.job while the transaction is assembled. */
+static inline Unit *aos_method46_named_unit(Manager *m, const char *name) {
+        Unit *u = manager_get_unit(m, name);
+
+        return u ? unit_follow_merge(u) : NULL;
+}
+
+static inline bool aos_method46_unit_busy(Unit *u) {
+        return u && (u->job || u->nop_job || unit_active_state(u) != UNIT_INACTIVE);
+}
+
+static inline bool aos_method46_initial_interval_busy(Manager *m) {
+        if (!MANAGER_IS_SYSTEM(m))
+                return false;
+
+        FOREACH_STRING(name,
+                       "aos-sandbox-controller-floor-initialize.service",
+                       "aos-sandbox-storage-floor-initialize.service")
+                if (aos_method46_unit_busy(aos_method46_named_unit(m, name)))
+                        return true;
+
+        return false;
+}
+
+static inline int aos_method46_verify_start_exclusion(Unit *u) {
+        Manager *m = u->manager;
+        bool initial = false, normal = false;
+
+        if (!MANAGER_IS_SYSTEM(m))
+                return 0;
+
+        u = unit_follow_merge(u);
+
+        FOREACH_STRING(name,
+                       "aos-sandbox-controller-floor-initialize.service",
+                       "aos-sandbox-storage-floor-initialize.service") {
+                Unit *peer = aos_method46_named_unit(m, name);
+
+                if (peer == u)
+                        initial = true;
+        }
+
+        FOREACH_STRING(name, "aos-sandboxd.service", "aos-storaged.service")
+                if (aos_method46_named_unit(m, name) == u)
+                        normal = true;
+
+        if (normal && aos_method46_initial_interval_busy(m))
+                return -EBUSY;
+        if (!initial)
+                return 0;
+
+        FOREACH_STRING(name,
+                       "aos-sandbox-controller-floor-initialize.service",
+                       "aos-sandbox-storage-floor-initialize.service") {
+                Unit *peer = aos_method46_named_unit(m, name);
+
+                if (peer != u && aos_method46_unit_busy(peer))
+                        return -EBUSY;
+        }
+
+        /* Do not load a missing normal owner or stop it implicitly. The manual
+         * producer still proves the exact native empty cgroups and image. */
+        FOREACH_STRING(name, "aos-sandboxd.service", "aos-storaged.service") {
+                Unit *peer = aos_method46_named_unit(m, name);
+
+                if (!peer || peer->load_state != UNIT_LOADED || aos_method46_unit_busy(peer))
+                        return -EBUSY;
+        }
+
+        return 0;
+}
