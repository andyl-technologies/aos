+
+static Service method46_stopped_service(Manager *manager) {
+        return (Service) {
+                .meta = {
+                        .manager = manager,
+                        .type = UNIT_SERVICE,
+                        .load_state = UNIT_LOADED,
+                },
+                .state = SERVICE_DEAD,
+        };
+}
+
+/* These are native Unit/Job objects, without a running host manager or cgroup
+ * effects. Exercise the production dispatch boundary before any native work. */
+TEST(manual_initial_excludes_both_normal_owners_and_other_manual_jobs) {
+        _cleanup_hashmap_free_ Hashmap *units = hashmap_new(&string_hash_ops);
+        Manager manager = { .runtime_scope = RUNTIME_SCOPE_SYSTEM, .units = units };
+        Service controller = method46_stopped_service(&manager);
+        Service storage = method46_stopped_service(&manager);
+        Service first = method46_stopped_service(&manager);
+        Service second = method46_stopped_service(&manager);
+        Job queued = { .unit = UNIT(&storage), .type = JOB_START };
+        ServiceState state;
+
+        ASSERT_NOT_NULL(units);
+        ASSERT_OK(hashmap_put(units, "aos-sandboxd.service", UNIT(&controller)));
+        ASSERT_OK(hashmap_put(units, "aos-storaged.service", UNIT(&storage)));
+        ASSERT_OK(hashmap_put(units, "aos-sandbox-controller-floor-initialize.service", UNIT(&first)));
+        ASSERT_OK(hashmap_put(units, "aos-sandbox-storage-floor-initialize.service", UNIT(&second)));
+        ASSERT_OK(aos_method46_verify_start_exclusion(UNIT(&first)));
+        ASSERT_OK(aos_method46_verify_start_exclusion(UNIT(&second)));
+        ASSERT_FALSE(aos_method46_initial_interval_busy(&manager));
+
+        storage.meta.job = &queued;
+        ASSERT_ERROR(unit_start(UNIT(&first), NULL), EBUSY);
+        ASSERT_ERROR(unit_start(UNIT(&second), NULL), EBUSY);
+        storage.meta.job = NULL;
+
+        FOREACH_ARGUMENT(state, SERVICE_START, SERVICE_RUNNING, SERVICE_STOP, SERVICE_FAILED) {
+                storage.state = state;
+                ASSERT_ERROR(unit_start(UNIT(&first), NULL), EBUSY);
+                ASSERT_ERROR(unit_start(UNIT(&second), NULL), EBUSY);
+        }
+        storage.state = SERVICE_DEAD;
+        controller.state = SERVICE_RUNNING;
+        ASSERT_ERROR(unit_start(UNIT(&first), NULL), EBUSY);
+        controller.state = SERVICE_DEAD;
+
+        queued.unit = UNIT(&first);
+        first.meta.job = &queued;
+        ASSERT_ERROR(unit_start(UNIT(&controller), NULL), EBUSY);
+        ASSERT_ERROR(unit_start(UNIT(&storage), NULL), EBUSY);
+        ASSERT_ERROR(unit_start(UNIT(&second), NULL), EBUSY);
+        /* The candidate's own queued start does not conflict with itself. */
+        ASSERT_OK(aos_method46_verify_start_exclusion(UNIT(&first)));
+        first.meta.job = NULL;
+
+        FOREACH_ARGUMENT(state, SERVICE_START, SERVICE_RUNNING, SERVICE_STOP, SERVICE_FAILED) {
+                first.state = state;
+                ASSERT_TRUE(aos_method46_initial_interval_busy(&manager));
+                ASSERT_ERROR(unit_start(UNIT(&controller), NULL), EBUSY);
+                ASSERT_ERROR(unit_start(UNIT(&storage), NULL), EBUSY);
+                ASSERT_ERROR(unit_start(UNIT(&second), NULL), EBUSY);
+                /* Migration into any destination is refused, even before the
+                 * normal empty-PID shortcut. No cgroup can be touched. */
+                ASSERT_ERROR(unit_attach_pids_to_cgroup(UNIT(&storage), NULL, NULL), EBUSY);
+        }
+        first.state = SERVICE_DEAD;
+        ASSERT_FALSE(aos_method46_initial_interval_busy(&manager));
+        ASSERT_OK(aos_method46_verify_start_exclusion(UNIT(&controller)));
+        ASSERT_OK(aos_method46_verify_start_exclusion(UNIT(&storage)));
+
+        storage.meta.load_state = UNIT_NOT_FOUND;
+        ASSERT_ERROR(unit_start(UNIT(&first), NULL), EBUSY);
+        ASSERT_PTR_EQ(hashmap_remove(units, "aos-storaged.service"), UNIT(&storage));
+        ASSERT_ERROR(unit_start(UNIT(&first), NULL), EBUSY);
+}
+
+TEST(manual_initial_migration_exclusion_covers_foreign_destinations_and_aliases) {
+        _cleanup_hashmap_free_ Hashmap *units = hashmap_new(&string_hash_ops);
+        Manager manager = { .runtime_scope = RUNTIME_SCOPE_SYSTEM, .units = units };
+        Service initial = method46_stopped_service(&manager);
+        Service normal = method46_stopped_service(&manager);
+        Service foreign = method46_stopped_service(&manager);
+        Service alias = method46_stopped_service(&manager);
+        Job queued = { .unit = UNIT(&initial), .type = JOB_NOP };
+
+        ASSERT_NOT_NULL(units);
+        initial.state = SERVICE_RUNNING;
+        normal.meta.id = (char*) "owner-alias.service";
+        ASSERT_OK(hashmap_put(units, "aos-sandbox-storage-floor-initialize.service", UNIT(&initial)));
+        ASSERT_OK(hashmap_put(units, "aos-storaged.service", UNIT(&normal)));
+        ASSERT_ERROR(unit_start(UNIT(&normal), NULL), EBUSY);
+        /* A merged alias and its canonical unit share one exclusion identity. */
+        alias.meta.load_state = UNIT_MERGED;
+        alias.meta.merged_into = UNIT(&normal);
+        ASSERT_OK(hashmap_replace(units, "aos-storaged.service", UNIT(&alias)));
+        ASSERT_ERROR(unit_start(UNIT(&normal), NULL), EBUSY);
+        ASSERT_ERROR(unit_start(UNIT(&alias), NULL), EBUSY);
+        ASSERT_OK(aos_method46_verify_start_exclusion(UNIT(&foreign)));
+        ASSERT_ERROR(unit_attach_pids_to_cgroup(UNIT(&foreign), NULL, NULL), EBUSY);
+
+        initial.state = SERVICE_DEAD;
+        initial.meta.nop_job = &queued;
+        ASSERT_ERROR(unit_start(UNIT(&normal), NULL), EBUSY);
+        ASSERT_ERROR(unit_attach_pids_to_cgroup(UNIT(&foreign), NULL, NULL), EBUSY);
+        initial.meta.nop_job = NULL;
+        ASSERT_FALSE(aos_method46_initial_interval_busy(&manager));
+
+        /* System-service names have no special meaning inside a user manager. */
+        initial.state = SERVICE_RUNNING;
+        manager.runtime_scope = RUNTIME_SCOPE_USER;
+        ASSERT_FALSE(aos_method46_initial_interval_busy(&manager));
+        ASSERT_OK(aos_method46_verify_start_exclusion(UNIT(&normal)));
+}
