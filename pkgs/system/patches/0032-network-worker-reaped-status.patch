+                                      WEXITED | WNOHANG | WNOWAIT) < 0 ? -errno : 0;
+        original->death_result = original->wait_result < 0 ? original->wait_result :
+                expected_pid > 0 && original->held_death.si_pid == expected_pid &&
+                manager_death->si_pid == expected_pid &&
+                original->held_death.si_code == manager_death->si_code &&
+                original->held_death.si_status == manager_death->si_status &&
+                IN_SET(manager_death->si_code, CLD_EXITED, CLD_KILLED, CLD_DUMPED) ? 0 : -EOWNERDEAD;
+        return original->death_result;
