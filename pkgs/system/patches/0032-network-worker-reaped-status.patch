+                terminal->final_main_status.pid, terminal->final_main_status.code,
+                terminal->final_main_status.status);
+        if (terminal->status_join_result == 0 &&
+            (!sd_id128_equal(terminal->final_invocation, worker->worker_invocation) ||
+             !sd_id128_equal(UNIT(service)->invocation_id, worker->worker_invocation) ||
