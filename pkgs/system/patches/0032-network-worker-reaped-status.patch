+        original->reaped = true;
+        original->reaped_death = *reaped_death;
+        original->reap_result = result;
+        original->reap_join_result = result < 0 ? result :
+                original->observed && original->death_result == 0 && pid > 0 &&
+                pid == original->held_death.si_pid && reaped_death->si_pid == pid &&
+                reaped_death->si_code == original->held_death.si_code &&
+                reaped_death->si_status == original->held_death.si_status ? 0 : -EOWNERDEAD;
+        return original->reap_join_result;
+}
