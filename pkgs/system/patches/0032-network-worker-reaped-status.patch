+/* The same native status engine used by PID1 must not turn a queued RESULT,
+ * PIDFD readability or WNOWAIT observation into a completed successful exit. */
+static void test_network_child_native_exit(int exit_status, int signal) {
+        _cleanup_close_pair_ int gate[2] = EBADF_PAIR;
+        _cleanup_(pidref_done) PidRef child = PIDREF_NULL;
+        AosReapedChildStatus original = {};
+        siginfo_t death = {}, reaped = {};
+        char byte;
+
+        assert_se(pipe2(gate, O_CLOEXEC) == 0);
+        pid_t pid = fork();
+        assert_se(pid >= 0);
+        if (pid == 0) {
+                safe_close(gate[1]);
+                if (read(gate[0], &byte, 1) != 1)
+                        _exit(120);
+                _exit(exit_status);
+        }
+        assert_se(pidref_set_pid(&child, pid) == 0);
+        assert_se(child.fd >= 0);
+        assert_se(aos_reaped_child_require_status(&original, pid, CLD_EXITED, 0) == -EAGAIN);
+        if (signal != 0)
+                assert_se(kill(pid, signal) == 0);
+        else
+                assert_se(write(gate[1], "x", 1) == 1);
+        assert_se(waitid(P_PID, pid, &death, WEXITED | WNOWAIT) == 0);
+        assert_se(aos_reaped_child_observe_sigchld(&original, child.fd, pid, &death) == 0);
+        assert_se(aos_reaped_child_require_status(&original, pid, death.si_code, death.si_status) == -EAGAIN);
+        assert_se(aos_reaped_child_observe_sigchld(&original, child.fd, pid, &death) == -EALREADY);
+
+        /* Actual waitid reaps this child before the retained status can pass. */
+        assert_se(waitid(P_PID, pid, &reaped, WEXITED) == 0);
+        assert_se(aos_reaped_child_observe_reaped(&original, pid, &reaped, 0) == 0);
+        assert_se(aos_reaped_child_require_status(&original, pid, reaped.si_code, reaped.si_status) == 0);
+        assert_se(aos_reaped_child_require_status(&original, pid + 1, reaped.si_code, reaped.si_status) == -EOWNERDEAD);
+        assert_se(aos_reaped_child_observe_reaped(&original, pid, &reaped, -EIO) == -EALREADY);
+        assert_se(original.reap_result == 0 && original.reaped_death.si_pid == pid);
+        if (signal != 0) {
+                assert_se(reaped.si_code == CLD_KILLED && reaped.si_status == signal);
+                assert_se(aos_reaped_child_require_status(&original, pid, CLD_EXITED, 0) == -EOWNERDEAD);
+        } else {
+                assert_se(reaped.si_code == CLD_EXITED && reaped.si_status == exit_status);
+                assert_se((aos_reaped_child_require_status(&original, pid, CLD_EXITED, 0) == 0) == (exit_status == 0));
+        }
+}
+
+TEST(network_child_success_requires_the_actual_reaped_exit) {
+        test_network_child_native_exit(0, 0);
+}
+
+TEST(network_child_nonzero_exit_cannot_become_success) {
+        test_network_child_native_exit(23, 0);
+}
+
+TEST(network_child_signal_exit_cannot_become_success) {
+        test_network_child_native_exit(0, SIGKILL);
+}
