+
+        /* These fixed bytes are a report of native custody, never a new Source
+         * or a renewed D. Only the joined normal exit and final Unit success
+         * receive result zero; all other completed outcomes stay negative. */
+        uint8_t *bytes = terminal->status_bytes;
+        memset(bytes, 0, sizeof(terminal->status_bytes));
+        memcpy(bytes, "AOSNFL03", 8);
+        unaligned_write_be16(bytes + 8, 3);
+        bytes[10] = worker->purpose + 1U;
+        unaligned_write_be32(bytes + 12, sizeof(terminal->status_bytes));
+        memcpy(bytes + 16, child->birth_bytes + 16, AOS_NETWORK_CHILD_BIRTH_BYTES - 16U);
+        if (terminal->status_join_result == 0) {
+                unaligned_write_be32(bytes + 160, terminal->final_main_status.code);
+                unaligned_write_be32(bytes + 164, terminal->final_main_status.status);
+        }
+        bool success = terminal->status_join_result == 0 &&
+                terminal->final_main_status.code == CLD_EXITED && terminal->final_main_status.status == 0 &&
+                terminal->final_state != SERVICE_FAILED && terminal->final_result == SERVICE_SUCCESS;
+        unaligned_write_be32(bytes + 168, success ? 0 : 1);
+
+        int first = aos_resource_parent_source_exec_scope(SERVICE(source->transport.unit), &scope);
+        int before = network_child_native_post(worker, false, false, &terminal->status_before);
+        if (first == 0 && before < 0)
+                first = before;
+        if (first == 0) {
+                terminal->status_length = send(source->transport.sockets[0], bytes,
+                        sizeof(terminal->status_bytes), MSG_DONTWAIT | MSG_NOSIGNAL);
+                terminal->status_send_result = terminal->status_length < 0 ? -errno :
+                        terminal->status_length == sizeof(terminal->status_bytes) ? 0 : -EIO;
+                first = terminal->status_send_result;
+        }
+        int after = network_child_native_post(worker, false, false, &terminal->status_after);
+        if (first == 0 && after < 0)
+                first = after;
+        if (first == 0) {
+                terminal->resume_attempted = true;
+                terminal->resume_result = sd_event_source_set_enabled(owner->event, SD_EVENT_ON);
+                if (terminal->resume_result < 0)
+                        first = terminal->resume_result;
+        }
+        if (terminal->resume_attempted) {
+                int resume_after = network_child_native_post(worker, false, false, &terminal->resume_after);
+                if (first == 0 && resume_after < 0)
+                        first = resume_after;
+        }
+        terminal->first_error = first;
+        if (first < 0) {
