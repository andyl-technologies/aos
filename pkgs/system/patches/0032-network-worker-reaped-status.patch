+/* K cleanup and successful execution are separate facts. A pending K keeps the
+ * same UnitRef, clone PIDFD and Source channel until the actual manager reap
+ * and the service's final result have both been observed. */
+static void network_child_latch_final_status(AosNetworkWorkerOriginal *worker, Service *service) {
+        AosNetworkChildTerminalOriginal *terminal = &worker->programme->terminals[worker->purpose];
+
+        if (terminal->final_observed || (!worker->child.exit_status.observed && !worker->child.armed) ||
+            !IN_SET(service->state, SERVICE_DEAD, SERVICE_FAILED, SERVICE_EXITED))
+                return;
+        /* Preserve the first actual final result even when K arrives later.
+         * ResetFailed or a later invocation cannot rewrite this completion. */
+        terminal->final_observed = true;
+        terminal->final_state = service->state;
+        terminal->final_result = service->result;
+        terminal->final_invocation = UNIT(service)->invocation_id;
+        terminal->final_main_status = service->main_exec_status;
