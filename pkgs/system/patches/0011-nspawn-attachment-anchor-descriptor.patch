+static int install_aos_attachment_anchor(
+                const char *directory,
+                int attachment_anchor_fd,
+                int idmap_userns_fd) {
+
+        _cleanup_close_ int anchor_mount_fd = -EBADF, target_fd = -EBADF;
+        struct stat target_stat;
+        int r;
+
+        assert(directory);
+        assert(attachment_anchor_fd >= 0);
+        assert(idmap_userns_fd >= 0);
+
+        anchor_mount_fd = open_tree(
+                        attachment_anchor_fd,
+                        "",
+                        OPEN_TREE_CLONE|OPEN_TREE_CLOEXEC|AT_EMPTY_PATH|AT_RECURSIVE);
+        if (anchor_mount_fd < 0)
+                return log_error_errno(errno, "Failed to clone AOS attachment anchor: %m");
+
+        struct mount_attr attr = {
+                .attr_set = MOUNT_ATTR_IDMAP|MOUNT_ATTR_RDONLY|MOUNT_ATTR_NOSUID|
+                            MOUNT_ATTR_NODEV|MOUNT_ATTR_NOEXEC,
+                .userns_fd = idmap_userns_fd,
+        };
+        if (mount_setattr(anchor_mount_fd, "", AT_EMPTY_PATH|AT_RECURSIVE, &attr, sizeof(attr)) < 0)
+                return log_error_errno(errno, "Failed to protect AOS attachment anchor: %m");
+
+        r = userns_mkdir(directory, "/run/aos", 0755, 0, 0);
+        if (r < 0)
+                return log_error_errno(r, "Failed to create AOS runtime directory: %m");
+
+        r = userns_mkdir(directory, "/run/aos/attachments", 0555, 0, 0);
+        if (r < 0)
+                return log_error_errno(r, "Failed to create AOS attachment-anchor target: %m");
+
+        target_fd = chase_and_open(
+                        "/run/aos/attachments",
+                        directory,
+                        CHASE_PREFIX_ROOT|CHASE_PROHIBIT_SYMLINKS|CHASE_MUST_BE_DIRECTORY,
+                        O_PATH|O_DIRECTORY|O_CLOEXEC,
+                        NULL);
+        if (target_fd < 0)
+                return log_error_errno(target_fd, "Failed to resolve AOS attachment-anchor target: %m");
+        if (fstat(target_fd, &target_stat) < 0)
+                return log_error_errno(errno, "Failed to inspect AOS attachment-anchor target: %m");
+        if (target_stat.st_uid != arg_uid_shift ||
+            target_stat.st_gid != (gid_t) arg_uid_shift ||
+            (target_stat.st_mode & 07777) != 0555)
+                return log_error_errno(
+                                SYNTHETIC_ERRNO(EPERM),
+                                "AOS attachment-anchor target has unsafe ownership or mode.");
+
+        r = path_is_mount_point_full("/run/aos/attachments", directory, 0);
+        if (r < 0)
+                return log_error_errno(r, "Failed to inspect AOS attachment-anchor mountpoint: %m");
+        if (r > 0)
+                return log_error_errno(
+                                SYNTHETIC_ERRNO(EBUSY),
+                                "AOS attachment-anchor target is already a mountpoint.");
+
+        if (move_mount(
+                        anchor_mount_fd,
+                        "",
+                        target_fd,
+                        "",
+                        MOVE_MOUNT_F_EMPTY_PATH|MOVE_MOUNT_T_EMPTY_PATH) < 0)
+                return log_error_errno(errno, "Failed to install AOS attachment anchor: %m");
+
+        return 0;
+}
