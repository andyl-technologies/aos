+TEST(attachment_anchor_requires_a_protected_directory) {
+        _cleanup_(rm_rf_physical_and_freep) char *directory = NULL;
+        _cleanup_close_ int source = -EBADF, anchor = -EBADF;
+
+        ASSERT_OK(mkdtemp_malloc("/tmp/test-nspawn-anchor-fd.XXXXXX", &directory));
+        ASSERT_OK_ERRNO(chmod(directory, 0755));
+        ASSERT_OK_ERRNO(source = open(directory, O_PATH|O_DIRECTORY|O_CLOEXEC));
+        ASSERT_OK(aos_attachment_anchor_from_fd(source, &anchor));
+        ASSERT_TRUE(FLAGS_SET(fcntl(anchor, F_GETFD), FD_CLOEXEC));
+
+        anchor = safe_close(anchor);
+        ASSERT_OK_ERRNO(chmod(directory, 0500));
+        ASSERT_ERROR(aos_attachment_anchor_from_fd(source, &anchor), EPERM);
+}
