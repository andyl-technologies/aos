+static int aos_prepare_root_handoff(
+                ManagerObjective objective,
+                const char *switch_root_dir,
+                const char *switch_root_init) {
+        int fd;
+
+        if (arg_aos_root_handoff_count == 0)
+                return 0;
+
+        arg_crash_action = CRASH_FREEZE;
+        if (arg_aos_root_handoff_count != 1 || arg_aos_root_handoff_malformed)
+                return log_error_errno(
+                                SYNTHETIC_ERRNO(EINVAL),
+                                "Malformed authenticated AOS root-handoff contract.");
+        if (objective == MANAGER_SOFT_REBOOT)
+                return log_error_errno(
+                                SYNTHETIC_ERRNO(EPERM),
+                                "AOS protected root handoff forbids soft reboot.");
+        if (objective == MANAGER_SWITCH_ROOT &&
+            (!streq_ptr(switch_root_dir, "/sysroot") || switch_root_init))
+                return log_error_errno(
+                                SYNTHETIC_ERRNO(EPERM),
+                                "AOS protected root handoff requires /sysroot and forbids a custom init.");
+
+        fd = aos_open_root_handoff_guard(
+                        objective == MANAGER_SWITCH_ROOT ? switch_root_dir : NULL);
+        if (fd < 0)
+                return fd;
+
+        arg_aos_root_handoff_fd = safe_close(arg_aos_root_handoff_fd);
+        arg_aos_root_handoff_fd = fd;
+        return 0;
+}
 
