+static int aos_open_root_handoff_guard(const char *root) {
+        static const char expected_context[] = "system_u:object_r:init_exec_t";
+        struct stat guard_status, lower_status, mapper_status, root_status, source_status;
+        struct statfs filesystem_status;
+        struct statvfs lower_mount_status, mount_status;
+        char context[sizeof(expected_context)];
+        _cleanup_free_ char *filesystem_type = NULL, *mount_options = NULL, *mount_source = NULL;
+        _cleanup_close_ int guard_fd = -EBADF, lower_fd = -EBADF, root_fd = -EBADF;
+        int r;
+        ssize_t context_size;
+
+        guard_fd = chase_and_open(
+                        AOS_ROOT_HANDOFF_PATH,
+                        root,
+                        (root ? CHASE_PREFIX_ROOT : 0) |
+                        CHASE_PROHIBIT_SYMLINKS |
+                        CHASE_NO_AUTOFS |
+                        CHASE_MUST_BE_REGULAR,
+                        O_RDONLY | O_CLOEXEC | O_NOCTTY,
+                        /* ret_path= */ NULL);
+        if (guard_fd < 0)
+                return log_error_errno(guard_fd, "Cannot open authenticated AOS root-handoff guard: %m");
+
+        root_fd = chase_and_open(
+                        "/",
+                        root,
+                        (root ? CHASE_PREFIX_ROOT : 0) |
+                        CHASE_PROHIBIT_SYMLINKS |
+                        CHASE_NO_AUTOFS |
+                        CHASE_MUST_BE_DIRECTORY,
+                        O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOCTTY,
+                        /* ret_path= */ NULL);
+        if (root_fd < 0)
+                return log_error_errno(root_fd, "Cannot open AOS handoff root: %m");
+        lower_fd = chase_and_open(
+                        "/nix.lower",
+                        root,
+                        (root ? CHASE_PREFIX_ROOT : 0) |
+                        CHASE_PROHIBIT_SYMLINKS |
+                        CHASE_NO_AUTOFS |
+                        CHASE_MUST_BE_DIRECTORY,
+                        O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOCTTY,
+                        /* ret_path= */ NULL);
+        if (lower_fd < 0)
+                return log_error_errno(lower_fd, "Cannot open AOS physical lower store root: %m");
+        r = path_get_mount_info(root ?: "/", &filesystem_type, &mount_options, &mount_source);
+        if (r < 0)
+                return log_error_errno(r, "Cannot inspect AOS handoff root mount: %m");
+        if (!streq_ptr(filesystem_type, "erofs") ||
+            isempty(mount_source) ||
+            stat(mount_source, &source_status) < 0 ||
+            stat("/dev/mapper/root", &mapper_status) < 0 ||
+            !S_ISBLK(source_status.st_mode) ||
+            !S_ISBLK(mapper_status.st_mode) ||
+            source_status.st_rdev != mapper_status.st_rdev ||
+            !fstab_test_yes_no_option(mount_options, "ro\0rw\0") ||
+            !fstab_test_yes_no_option(mount_options, "nodev\0dev\0"))
+                return log_error_errno(
+                                SYNTHETIC_ERRNO(EPERM),
+                                "AOS handoff root is not the read-only nodev /dev/mapper/root EROFS mount.");
+
+        if (fstat(guard_fd, &guard_status) < 0 ||
+            fstat(root_fd, &root_status) < 0 ||
+            fstat(lower_fd, &lower_status) < 0)
+                return log_error_errno(errno, "Cannot inspect AOS root-handoff guard: %m");
+        if (guard_status.st_uid != 0 || guard_status.st_gid != 0 ||
+            (guard_status.st_mode & 07777) != 0555 ||
+            guard_status.st_dev != root_status.st_dev ||
+            lower_status.st_dev != root_status.st_dev)
+                return log_error_errno(
+                                SYNTHETIC_ERRNO(EPERM),
+                                "AOS root-handoff guard has untrusted ownership, mode, or filesystem identity.");
+        if (fstatfs(guard_fd, &filesystem_status) < 0 ||
+            fstatvfs(guard_fd, &mount_status) < 0 ||
+            fstatvfs(lower_fd, &lower_mount_status) < 0)
+                return log_error_errno(errno, "Cannot inspect AOS root-handoff filesystem: %m");
+        if (filesystem_status.f_type != EROFS_SUPER_MAGIC_V1 ||
+            !FLAGS_SET(mount_status.f_flag, ST_RDONLY | ST_NODEV) ||
+            !FLAGS_SET(lower_mount_status.f_flag, ST_RDONLY | ST_NODEV))
+                return log_error_errno(
+                                SYNTHETIC_ERRNO(EPERM),
+                                "AOS root-handoff guard and lower store are not on the authenticated read-only nodev EROFS root.");
+
+        context_size = fgetxattr(guard_fd, "security.selinux", context, sizeof(context));
+        if (!IN_SET(context_size, (ssize_t) sizeof(expected_context) - 1, (ssize_t) sizeof(expected_context)) ||
+            memcmp(context, expected_context, sizeof(expected_context) - 1) != 0 ||
+            (context_size == (ssize_t) sizeof(expected_context) && context[sizeof(expected_context) - 1] != 0))
+                return log_error_errno(
+                                SYNTHETIC_ERRNO(EPERM),
+                                "AOS root-handoff guard has the wrong SELinux label.");
+
+        return TAKE_FD(guard_fd);
+}
