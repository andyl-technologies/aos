         return 0;
 }
 
+static int aos_guest_agent_descriptor_validate(int fd, int role) {
+        struct stat st;
+
+        if (fstat(fd, &st) < 0)
+                return -errno;
+        if (role == 0) {
+                struct sockaddr_storage peer;
+                socklen_t peer_length = sizeof(peer);
+                int type, domain, accepting;
+                socklen_t length = sizeof(int);
+
+                if (!S_ISSOCK(st.st_mode) ||
+                    getsockopt(fd, SOL_SOCKET, SO_TYPE, &type, &length) < 0 ||
+                    length != sizeof(int) || type != SOCK_SEQPACKET)
+                        return -EINVAL;
+                length = sizeof(int);
+                if (getsockopt(fd, SOL_SOCKET, SO_DOMAIN, &domain, &length) < 0 ||
+                    length != sizeof(int) || domain != AF_UNIX)
+                        return -EINVAL;
+                length = sizeof(int);
+                if (getsockopt(fd, SOL_SOCKET, SO_ACCEPTCONN, &accepting, &length) < 0 ||
+                    length != sizeof(int) || accepting != 0 ||
+                    getpeername(fd, (struct sockaddr*) &peer, &peer_length) < 0)
+                        return -EINVAL;
+                return 0;
+        }
+
+        if (!S_ISREG(st.st_mode) ||
+            (role == 1 && st.st_size != 258) ||
+            (role == 2 && (st.st_size < 152 || st.st_size > 16792)))
+                return -EINVAL;
+        int seals = fcntl(fd, F_GET_SEALS);
+        if (seals < 0)
+                return -errno;
+        if ((seals & (F_SEAL_SEAL|F_SEAL_SHRINK|F_SEAL_GROW|F_SEAL_WRITE)) !=
+            (F_SEAL_SEAL|F_SEAL_SHRINK|F_SEAL_GROW|F_SEAL_WRITE))
+                return -EPERM;
+        return 0;
+}
