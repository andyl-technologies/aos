-                int *ret_anchor_namespace_fd) {
+                int *ret_anchor_namespace_fd,
+                int ret_guest_fds[3]) {
         _cleanup_strv_free_ char **names = NULL;
-        int expected, n, r;
+        int expected, guest_base, n, r;
 
         /* This is a setup-only descriptor, never a payload activation socket.
          * Unsetting LISTEN_* makes the later fdset collector empty. Require the
@@ -195,12 +237,17 @@
         n = sd_listen_fds_with_names(/* unset_environment= */ true, &names);
         if (n < 0)
                 return n;
-        expected = with_attachment_anchor ? 3 : 1;
+        guest_base = with_attachment_anchor ? 3 : 1;
+        expected = guest_base + (with_guest_agent ? 3 : 0);
         if (n != expected ||
             !streq_ptr(names[0], AOS_ROOT_DIRECTORY_FD_NAME) ||
             (with_attachment_anchor &&
              (!streq_ptr(names[1], AOS_ATTACHMENT_ANCHOR_FD_NAME) ||
-              !streq_ptr(names[2], AOS_ATTACHMENT_ANCHOR_NAMESPACE_FD_NAME))))
+              !streq_ptr(names[2], AOS_ATTACHMENT_ANCHOR_NAMESPACE_FD_NAME))) ||
+            (with_guest_agent &&
+             (!streq_ptr(names[guest_base], AOS_GUEST_AGENT_CHANNEL_FD_NAME) ||
+              !streq_ptr(names[guest_base + 1], AOS_GUEST_AGENT_PROVISIONING_FD_NAME) ||
+              !streq_ptr(names[guest_base + 2], AOS_GUEST_ATTACH_TRUST_FD_NAME))))
                 r = -EINVAL;
         else {
                 r = aos_root_directory_from_fd(SD_LISTEN_FDS_START, ret_root_fd, ret_lock_fd, ret_path);
@@ -210,6 +257,20 @@
