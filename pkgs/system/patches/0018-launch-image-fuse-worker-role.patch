diff --git a/systemd-261.2/src/test/test-aos-fuse-worker.c b/src/test/test-aos-fuse-worker.c
new file mode 100644
index 0000000..df57565
--- /dev/null
+++ b/src/test/test-aos-fuse-worker.c
@@ -0,0 +1,90 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+
+#include <fcntl.h>
+
+#include "alloc-util.h"
+#include "aos-fuse-worker.h"
+#include "load-fragment.h"
+#include "service.h"
+#include "strv.h"
+#include "tests.h"
+
+TEST(instance_name) {
+        _cleanup_free_ char *name = NULL;
+
+        ASSERT_OK(aos_fuse_worker_instance_name("00000000000000000000000000000001", &name));
+        ASSERT_STREQ(name, "aos-view-worker@00000000000000000000000000000001.service");
+        ASSERT_TRUE(aos_fuse_worker_valid_name(name));
+        ASSERT_TRUE(aos_fuse_worker_protected_name(name));
+
+        FOREACH_STRING(instance,
+                       "", "00000000000000000000000000000000",
+                       "0000000000000000000000000000001",
+                       "000000000000000000000000000000001",
+                       "0000000000000000000000000000000A",
+                       "0000000000000000000000000000000g",
+                       "0000000000000000000000000000000/") {
+                _cleanup_free_ char *rejected = NULL;
+
+                ASSERT_ERROR(aos_fuse_worker_instance_name(instance, &rejected), EINVAL);
+                ASSERT_NULL(rejected);
+        }
+        ASSERT_ERROR(aos_fuse_worker_instance_name(NULL, &name), EINVAL);
+}
+
+TEST(reserved_malformed_instances) {
+        /* Invalid instances stay reserved instead of becoming caller-owned
+         * transient units with an arbitrary executable or environment. */
+        FOREACH_STRING(name,
+                       "aos-view-worker@.service",
+                       "aos-view-worker@00000000000000000000000000000000.service",
+                       "aos-view-worker@0000000000000000000000000000000A.service",
+                       "aos-view-worker@short.service") {
+                ASSERT_TRUE(aos_fuse_worker_protected_name(name));
+                ASSERT_FALSE(aos_fuse_worker_valid_name(name));
+        }
+        ASSERT_FALSE(aos_fuse_worker_protected_name(NULL));
+        ASSERT_FALSE(aos_fuse_worker_valid_name(NULL));
+        ASSERT_FALSE(aos_fuse_worker_protected_name("aos-view-worker.service"));
+        ASSERT_FALSE(aos_fuse_worker_protected_name("aos-view-worker@1.socket"));
+}
+
+TEST(network_name_set_is_unchanged) {
+        ASSERT_TRUE(aos_network_protected_name("aos-netd.service"));
+        ASSERT_TRUE(aos_network_protected_name("aos-sandbox-network-namespace-inspector@original.service"));
+        ASSERT_TRUE(aos_network_protected_name("aos-sandbox-network-lifecycle-worker@original.service"));
+        ASSERT_FALSE(aos_network_protected_name("aos-view-worker@00000000000000000000000000000001.service"));
+        ASSERT_FALSE(aos_network_protected_name("aos-netd.socket"));
+        ASSERT_FALSE(aos_network_protected_name("ordinary.service"));
+}
+
+TEST(launch_role_copies_close_synchronously) {
+        Service service = {
+                .meta.id = (char*) "aos-view-worker@00000000000000000000000000000001.service",
+                .n_extra_fds = 5,
+        };
+        int original_fds[5];
+
+        service.extra_fds = new0(ServiceExtraFD, service.n_extra_fds);
+        ASSERT_NOT_NULL(service.extra_fds);
+        for (size_t i = 0; i < service.n_extra_fds; i++) {
+                original_fds[i] = open("/dev/null", O_RDONLY|O_CLOEXEC);
+                ASSERT_OK(original_fds[i]);
+                service.extra_fds[i].fd = original_fds[i];
+                service.extra_fds[i].fdname = strdup("validated-role");
+                ASSERT_NOT_NULL(service.extra_fds[i].fdname);
+        }
+
+        aos_fuse_worker_release_launch_fds(&service);
+
+        ASSERT_NULL(service.extra_fds);
+        ASSERT_EQ(service.n_extra_fds, 0U);
+        for (size_t i = 0; i < ELEMENTSOF(original_fds); i++) {
+                errno = 0;
+                ASSERT_EQ(fcntl(original_fds[i], F_GETFD), -1);
+                ASSERT_EQ(errno, EBADF);
+        }
+}
+
+DEFINE_TEST_MAIN(LOG_INFO);
+
