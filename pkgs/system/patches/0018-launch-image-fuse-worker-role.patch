+         * path resolver is shared with the separately armed fixed FUSE role. */
+        if (aos_fuse_worker_valid_name(name))
+                return "aos-view-worker@.service";
         if (streq(name, "aos-netd.service"))
                 return name;
         if (startswith(name, "aos-sandbox-network-namespace-inspector@") && endswith(name, ".service"))
@@ -6315,6 +6321,54 @@ int aos_network_verify_loaded_fragment(const Unit *u) {
                          strjoina("/nix/store/", expected + strlen("/nix.lower/store/"))) ? 0 : -EPERM;
 }
 
+int aos_fuse_worker_verify_loaded_fragment(const Unit *u) {
+        _cleanup_free_ char *expected = NULL;
+        struct stat st;
+        int r;
+
+        if (!aos_fuse_worker_valid_name(u->id) || u->type != UNIT_SERVICE || u->transient ||
+            u->load_state != UNIT_LOADED || !set_isempty(u->aliases) ||
+            !strv_isempty(u->dropin_paths) || !isempty(u->source_path))
+                return -EPERM;
+        r = aos_network_image_fragment(u->id, &expected, NULL, &st);
+        if (r < 0)
+                return r;
+        if (!u->aos_image_fragment_pinned || st.st_dev != u->aos_image_fragment_device ||
+            st.st_ino != u->aos_image_fragment_inode)
+                return -EPERM;
+        return streq_ptr(u->fragment_path,
+                         strjoina("/nix/store/", expected + strlen("/nix.lower/store/"))) ? 0 : -EPERM;
+}
+
+int aos_fuse_worker_verify_executable(Unit *u, int descriptor) {
+        _cleanup_free_ char *physical = NULL;
+        _cleanup_close_ int image = -EBADF;
+        const ExecCommand *command;
+        const char *relative;
+        struct stat held, expected, root;
+        struct statfs fs;
+
+        command = SERVICE(u)->exec_command[SERVICE_EXEC_START];
+        if (!command || command->command_next || !path_is_normalized(command->path))
+                return -EPERM;
+        relative = startswith(command->path, "/nix/store/");
+        if (!relative || !endswith(relative, "/bin/aos-filesystem-fuse-worker"))
+                return -EPERM;
+        physical = strjoin("/nix.lower/store/", relative);
+        if (!physical)
+                return -ENOMEM;
+        image = aos_network_open_image_path(physical, O_RDONLY | O_NOFOLLOW | O_NOCTTY);
+        if (image < 0)
+                return image;
+        if (fstat(image, &expected) < 0 || fstat(descriptor, &held) < 0 ||
+            fstatfs(image, &fs) < 0 || stat("/", &root) < 0)
+                return -errno;
+        return S_ISREG(expected.st_mode) && expected.st_uid == 0 && expected.st_gid == 0 &&
+               expected.st_dev == root.st_dev && fs.f_type == EROFS_SUPER_MAGIC_V1 &&
+               (expected.st_mode & 0222) == 0 && (expected.st_mode & 0111) != 0 &&
+               held.st_dev == expected.st_dev && held.st_ino == expected.st_ino ? 0 : -EPERM;
+}
+
 int unit_load_fragment(Unit *u) {
         _cleanup_free_ char *image_fragment = NULL;
         _cleanup_close_ int image_fd = -EBADF;
@@ -6325,7 +6379,8 @@ int unit_load_fragment(Unit *u) {
         assert(u->id);
 
         if (u->transient) {
-                if (aos_network_image_guard_active() && aos_network_protected_unit(u))
+                if ((aos_network_image_guard_active() && aos_network_protected_unit(u)) ||
+                    aos_fuse_worker_protected_unit(u))
                         return -EPERM;
                 u->access_selinux_context = mfree(u->access_selinux_context);
                 u->load_state = UNIT_LOADED;
@@ -6351,7 +6406,8 @@ int unit_load_fragment(Unit *u) {
         if (r < 0 && r != -ENOENT)
                 return r;
 
-        if (aos_network_image_guard_active() && aos_network_protected_name(u->id)) {
+        if ((aos_network_image_guard_active() && aos_network_protected_name(u->id)) ||
+            aos_fuse_worker_protected_name(u->id)) {
                 r = aos_network_image_fragment(u->id, &image_fragment, &image_fd, NULL);
                 if (r < 0)
                         return log_unit_error_errno(u, r, "Cannot pin Network unit to boot-image EROFS: %m");
