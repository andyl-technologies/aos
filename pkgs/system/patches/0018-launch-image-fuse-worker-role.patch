 #include "bitfield.h"
 #include "build.h"
@@ -1149,6 +1150,43 @@ static int method_start_transient_unit(sd_bus_message *message, void *userdata,
         return bus_unit_queue_job(message, u, JOB_START, mode, 0, reterr_error);
 }
 
+static int method_launch_aos_fuse_worker_v1(sd_bus_message *message, void *userdata, sd_bus_error *reterr_error) {
+        _cleanup_free_ char *name = NULL;
+        const char *instance;
+        Manager *m = ASSERT_PTR(userdata);
+        Unit *u;
+        int r;
+
+        r = aos_fuse_worker_require_host(message);
+        if (r < 0)
+                return sd_bus_error_setf(reterr_error, SD_BUS_ERROR_ACCESS_DENIED,
+                                         "Fixed FUSE launch requires the pinned Host service");
+        r = sd_bus_message_read(message, "s", &instance);
+        if (r < 0)
+                return r;
+        r = aos_fuse_worker_instance_name(instance, &name);
+        if (r < 0)
+                return sd_bus_error_setf(reterr_error, SD_BUS_ERROR_INVALID_ARGS,
+                                         "Invalid fixed FUSE worker instance");
+        r = bus_verify_manage_units_async_impl(m, name, "start",
+                                              N_("Authentication is required to start fixed FUSE worker '$(unit)'."),
+                                              message, reterr_error);
+        if (r < 0)
+                return r;
+        if (r == 0)
+                return 1;
+        r = manager_load_unit(m, name, NULL, reterr_error, &u);
+        if (r < 0)
+                return r;
+        r = mac_selinux_unit_access_check(u, message, "start", reterr_error);
+        if (r < 0)
+                return r;
+        r = aos_fuse_worker_arm(u, message, reterr_error);
+        if (r < 0)
+                return r;
+        return bus_unit_queue_job(message, u, JOB_START, JOB_FAIL, 0, reterr_error);
+}
+
 static int method_get_job(sd_bus_message *message, void *userdata, sd_bus_error *reterr_error) {
         _cleanup_free_ char *path = NULL;
         Manager *m = ASSERT_PTR(userdata);
@@ -3163,6 +3201,11 @@ const sd_bus_vtable bus_manager_vtable[] = {
                                 SD_BUS_RESULT("o", job),
                                 method_start_transient_unit,
                                 SD_BUS_VTABLE_UNPRIVILEGED),
+        SD_BUS_METHOD_WITH_ARGS("LaunchAosFuseWorkerV1",
+                                SD_BUS_ARGS("s", instance, "a(hs)", descriptors),
+                                SD_BUS_RESULT("o", job),
+                                method_launch_aos_fuse_worker_v1,
+                                SD_BUS_VTABLE_UNPRIVILEGED),
         SD_BUS_METHOD_WITH_ARGS("GetUnitProcesses",
