diff --git a/systemd-261.2/src/core/aos-fuse-worker.c b/src/core/aos-fuse-worker.c
new file mode 100644
index 0000000..1863f1d
--- /dev/null
+++ b/src/core/aos-fuse-worker.c
@@ -0,0 +1,267 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+
+#include <fcntl.h>
+#include <sys/pidfd.h>
+#include <sys/socket.h>
+#include <sys/stat.h>
+#include <sys/sysmacros.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+#include "alloc-util.h"
+#include "aos-fuse-worker.h"
+#include "fd-util.h"
+#include "load-fragment.h"
+#include "service.h"
+#include "set.h"
+#include "socket-util.h"
+#include "string-util.h"
+
+#define AOS_FUSE_WORKER_FDS 5U
+#define AOS_FUSE_WORKER_PLAN_MAX (64U * 1024U * 1024U)
+
+static const char *const role_names[AOS_FUSE_WORKER_FDS] = {
+        "fuse-worker-executable-v1",
+        "fuse-worker-plan-v1",
+        "fuse-worker-connection-v1",
+        "fuse-worker-records-v1",
+        "fuse-worker-cancellation-v1",
+};
+
+bool aos_fuse_worker_protected_name(const char *name) {
+        /* Reserve malformed instances too: they must not fall through to
+         * an ordinary transient service with caller-selected commands. */
+        return name && startswith(name, "aos-view-worker@") && endswith(name, ".service");
+}
+
+bool aos_fuse_worker_protected_unit(const Unit *u) {
+        const char *alias;
+
+        if (aos_fuse_worker_protected_name(u->id))
+                return true;
+        SET_FOREACH(alias, u->aliases)
+                if (aos_fuse_worker_protected_name(alias))
+                        return true;
+        return false;
+}
+
+bool aos_fuse_worker_valid_name(const char *name) {
+        const char *instance;
+
+        instance = name ? startswith(name, "aos-view-worker@") : NULL;
+        return instance && strlen(instance) == 40 &&
+               strspn(instance, "0123456789abcdef") == 32 &&
+               strspn(instance, "0") != 32 && streq(instance + 32, ".service");
+}
+
+int aos_fuse_worker_instance_name(const char *instance, char **ret) {
+        if (!instance || strlen(instance) != 32 ||
+            strspn(instance, "0123456789abcdef") != 32 ||
+            strspn(instance, "0") == 32)
+                return -EINVAL;
+
+        *ret = strjoin("aos-view-worker@", instance, ".service");
+        return *ret ? 0 : -ENOMEM;
+}
+
+int aos_fuse_worker_require_host(sd_bus_message *message) {
+        _cleanup_(sd_bus_creds_unrefp) sd_bus_creds *sender = NULL, *pinned = NULL;
+        _cleanup_close_ int pidfd = -EBADF;
+        const char *cgroup;
+        uid_t sender_uid, pinned_uid;
+        int r;
+
+        /* This is the existing Host principal, not a new root launcher.
+         * Obtain a kernel process pin from bus-authenticated sender custody,
+         * then derive credentials and cgroup from that same pin. */
+        r = sd_bus_query_sender_creds(message, SD_BUS_CREDS_EUID | SD_BUS_CREDS_PIDFD, &sender);
+        if (r < 0)
+                return r;
+        r = sd_bus_creds_get_euid(sender, &sender_uid);
+        if (r < 0 || sender_uid != 0)
+                return -EPERM;
+        r = sd_bus_creds_get_pidfd_dup(sender, &pidfd);
+        if (r < 0)
+                return r;
+        r = sd_bus_creds_new_from_pidfd(&pinned, pidfd, SD_BUS_CREDS_EUID | SD_BUS_CREDS_CGROUP);
+        if (r < 0)
+                return r;
+        r = sd_bus_creds_get_euid(pinned, &pinned_uid);
+        if (r < 0 || pinned_uid != sender_uid)
+                return -EPERM;
+        r = sd_bus_creds_get_cgroup(pinned, &cgroup);
+        if (r < 0 || !streq_ptr(cgroup, "/system.slice/aos-sandbox-hostd.service"))
+                return -EPERM;
+        return pidfd_send_signal(pidfd, 0, NULL, 0) < 0 ? -errno : 0;
+}
+
+static int verify_role(Unit *u, unsigned role, int fd) {
+        struct stat st;
+        int flags, seals, type, enabled;
+        struct sockaddr_un peer;
+        socklen_t length;
+
+        if (fstat(fd, &st) < 0)
+                return -errno;
+        flags = fcntl(fd, F_GETFL);
+        if (flags < 0)
+                return -errno;
+
+        switch (role) {
+        case 0:
+                if ((flags & O_ACCMODE) != O_RDONLY)
+                        return -EPERM;
+                return aos_fuse_worker_verify_executable(u, fd);
+        case 1:
+                seals = fcntl(fd, F_GET_SEALS);
+                if (!S_ISREG(st.st_mode) || st.st_nlink != 0 || st.st_size <= 0 ||
+                    st.st_size > AOS_FUSE_WORKER_PLAN_MAX || seals < 0 ||
+                    (flags & O_ACCMODE) == O_WRONLY ||
+                    !FLAGS_SET(seals, F_SEAL_SEAL | F_SEAL_GROW | F_SEAL_SHRINK | F_SEAL_WRITE))
+                        return -EPERM;
+                return 0;
+        case 2:
+                /* Shape is not fresh-connection authority. Mount retains the
+                 * internally opened original OFD and held launch flight. */
+                return S_ISCHR(st.st_mode) && major(st.st_rdev) == 10 && minor(st.st_rdev) == 229 &&
+                       (flags & O_ACCMODE) == O_RDWR && FLAGS_SET(flags, O_NONBLOCK) ? 0 : -EPERM;
+        case 3:
+                length = sizeof(type);
+                if (getsockopt(fd, SOL_SOCKET, SO_TYPE, &type, &length) < 0)
+                        return -errno;
+                if (length != sizeof(type) || type != SOCK_SEQPACKET || !FLAGS_SET(flags, O_NONBLOCK))
+                        return -EPERM;
+                length = sizeof(peer);
+                if (getpeername(fd, (struct sockaddr*) &peer, &length) < 0)
+                        return -errno;
+                if (peer.sun_family != AF_UNIX)
+                        return -EPERM;
+                length = sizeof(enabled);
+                if (getsockopt(fd, SOL_SOCKET, SO_PASSCRED, &enabled, &length) < 0 ||
+                    length != sizeof(enabled) || enabled != 1)
+                        return -EPERM;
+                length = sizeof(enabled);
+                if (getsockopt(fd, SOL_SOCKET, SO_PASSPIDFD, &enabled, &length) < 0 ||
+                    length != sizeof(enabled) || enabled != 1)
+                        return -EPERM;
+                return 0;
+        case 4:
+                return S_ISFIFO(st.st_mode) && (flags & O_ACCMODE) == O_RDONLY &&
+                       FLAGS_SET(flags, O_NONBLOCK) ? 0 : -EPERM;
+        default:
+                return -EINVAL;
+        }
+}
+
+static void free_role_table(ServiceExtraFD **table) {
+        if (!*table)
+                return;
+        for (unsigned i = 0; i < AOS_FUSE_WORKER_FDS; i++) {
+                safe_close((*table)[i].fd);
+                free((*table)[i].fdname);
+        }
+        free(*table);
+}
+
+int aos_fuse_worker_arm(Unit *u, sd_bus_message *message, sd_bus_error *error) {
+        _cleanup_(free_role_table) ServiceExtraFD *table = NULL;
+        Service *s = SERVICE(u);
+        unsigned count = 0;
+        int r;
+
+        r = aos_fuse_worker_verify_loaded_fragment(u);
+        if (r < 0)
+                return r;
+        if (unit_active_state(u) != UNIT_INACTIVE || u->job ||
+            !sd_id128_is_null(u->invocation_id) || s->aos_fuse_worker_launch_armed ||
+            s->n_extra_fds != 0 || s->n_fd_store != 0)
+                return sd_bus_error_setf(error, SD_BUS_ERROR_ACCESS_DENIED,
+                                         "FUSE worker instance already has launch custody");
+
+        table = new0(ServiceExtraFD, AOS_FUSE_WORKER_FDS);
+        if (!table)
+                return -ENOMEM;
+        for (unsigned i = 0; i < AOS_FUSE_WORKER_FDS; i++)
+                table[i].fd = -EBADF;
+
+        r = sd_bus_message_enter_container(message, 'a', "(hs)");
+        if (r < 0)
+                return r;
+        for (;;) {
+                const char *name;
+                int fd;
+
+                r = sd_bus_message_read(message, "(hs)", &fd, &name);
+                if (r < 0)
+                        return r;
+                if (r == 0)
+                        break;
+                if (count >= AOS_FUSE_WORKER_FDS || !streq(name, role_names[count]))
+                        return sd_bus_error_setf(error, SD_BUS_ERROR_INVALID_ARGS,
+                                                 "FUSE worker requires the exact five-role descriptor table");
+                r = verify_role(u, count, fd);
+                if (r < 0)
+                        return r;
+                table[count].fdname = strdup(name);
+                if (!table[count].fdname)
+                        return -ENOMEM;
+                table[count].fd = fcntl(fd, F_DUPFD_CLOEXEC, 3);
+                if (table[count].fd < 0)
+                        return -errno;
+                count++;
+        }
+        r = sd_bus_message_exit_container(message);
+        if (r < 0)
+                return r;
+        if (count != AOS_FUSE_WORKER_FDS)
+                return sd_bus_error_setf(error, SD_BUS_ERROR_INVALID_ARGS,
+                                         "FUSE worker descriptor table is incomplete");
+
+        s->extra_fds = TAKE_PTR(table);
+        s->n_extra_fds = AOS_FUSE_WORKER_FDS;
+        s->aos_fuse_worker_launch_armed = true;
+        return 0;
+}
+
+int aos_fuse_worker_take_launch(Service *s, ExecCommand *command) {
+        int r;
+
+        r = aos_fuse_worker_verify_loaded_fragment(UNIT(s));
+        if (r < 0)
+                return r;
+        if (!s->aos_fuse_worker_launch_armed || s->n_extra_fds != AOS_FUSE_WORKER_FDS ||
+            s->n_fd_store != 0 || command != s->exec_command[SERVICE_EXEC_START] || command->command_next)
+                return -EPERM;
+        for (unsigned i = 0; i < _SERVICE_EXEC_COMMAND_MAX; i++)
+                if (i != SERVICE_EXEC_START && s->exec_command[i])
+                        return -EPERM;
+        for (unsigned i = 0; i < AOS_FUSE_WORKER_FDS; i++) {
+                if (!streq_ptr(s->extra_fds[i].fdname, role_names[i]))
+                        return -EPERM;
+                r = verify_role(UNIT(s), i, s->extra_fds[i].fd);
+                if (r < 0)
+                        return r;
+        }
+
+        /* Never serialize this arm: reexec before the first spawn is
+         * ambiguous, and neither restart nor a recovered scalar can re-arm. */
+        s->aos_fuse_worker_launch_armed = false;
+        return 0;
+}
+
+void aos_fuse_worker_release_launch_fds(Service *s) {
+        assert(s);
+        assert(aos_fuse_worker_protected_unit(UNIT(s)));
+        assert(!s->aos_fuse_worker_launch_armed);
+        assert(s->n_extra_fds == AOS_FUSE_WORKER_FDS);
+
+        /* The executor inherited its own serialized copies. Close the
+         * originals synchronously: async close is not a handoff barrier. */
+        FOREACH_ARRAY(i, s->extra_fds, s->n_extra_fds) {
+                i->fd = safe_close(i->fd);
+                free(i->fdname);
+        }
+
+        s->extra_fds = mfree(s->extra_fds);
+        s->n_extra_fds = 0;
+}
