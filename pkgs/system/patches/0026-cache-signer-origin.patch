+        ASSERT_TRUE(aos_fixed_service_context_matches(&source, AOS_FIXED_PROFILE_SOURCE));
+        ASSERT_TRUE(aos_fixed_service_context_matches(&ownership, AOS_FIXED_PROFILE_OWNERSHIP));
+        ASSERT_FALSE(aos_fixed_service_context_matches(&source, AOS_FIXED_PROFILE_CACHE));
+        ASSERT_FALSE(aos_fixed_service_context_matches(&ownership, AOS_FIXED_PROFILE_CACHE));
+        ownership.directories[EXEC_DIRECTORY_STATE].mode = 0755;
+        ASSERT_FALSE(aos_fixed_service_context_matches(&ownership, AOS_FIXED_PROFILE_OWNERSHIP));
+}
