+        ASSERT_FALSE(aos_fixed_service_subdivisions_fit(20, 12, 2, 3, 8, 2, 3, 4, 11));
+        ASSERT_FALSE(aos_fixed_service_subdivisions_fit(20, 12, 2, 3, 7, 2, 3, 4, 12));
