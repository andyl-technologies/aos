+bool aos_network_protected_name(const char *name) {
+        return streq_ptr(name, "aos-netd.service") ||
+               (name && startswith(name, "aos-sandbox-network-namespace-inspector@") && endswith(name, ".service")) ||
+               (name && startswith(name, "aos-sandbox-network-lifecycle-worker@") && endswith(name, ".service"));
+}
+
+bool aos_network_protected_unit(const Unit *u) {
+        const char *alias;
+
+        if (aos_network_protected_name(u->id))
+                return true;
+        SET_FOREACH(alias, u->aliases)
+                if (aos_network_protected_name(alias))
+                        return true;
+        return false;
+}
+
+bool aos_network_image_guard_active(void) {
+        struct statfs fs;
+
+        if (getpid_cached() != 1)
+                return false;
+        /* An unreadable root is treated as protected and fails the later
+         * authenticated-image check. Ext4 development guests stay available. */
+        return statfs("/", &fs) < 0 || fs.f_type == EROFS_SUPER_MAGIC_V1;
+}
+
+static const char *aos_network_template_name(const char *name) {
+        if (streq(name, "aos-netd.service"))
+                return name;
+        if (startswith(name, "aos-sandbox-network-namespace-inspector@") && endswith(name, ".service"))
+                return "aos-sandbox-network-namespace-inspector@.service";
+        if (startswith(name, "aos-sandbox-network-lifecycle-worker@") && endswith(name, ".service"))
+                return "aos-sandbox-network-lifecycle-worker@.service";
+        return NULL;
+}
+
+static int aos_network_open_image_path(const char *path, int flags) {
+        struct open_how how = {
+                .flags = flags | O_CLOEXEC,
+                .resolve = RESOLVE_BENEATH | RESOLVE_NO_MAGICLINKS |
+                           RESOLVE_NO_XDEV | RESOLVE_NO_SYMLINKS,
+        };
+        _cleanup_close_ int root_fd = -EBADF;
+        int fd;
+
+        /* A bind mount over any image component must not substitute an inode
+         * even if its backing filesystem has the same device number. */
+        if (!path || path[0] != '/' || path[1] == 0)
+                return -EINVAL;
+        root_fd = open("/", O_PATH | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
+        if (root_fd < 0)
+                return -errno;
+        fd = syscall(SYS_openat2, root_fd, path + 1, &how, sizeof(how));
+        return fd < 0 ? -errno : fd;
+}
+
+static int aos_network_image_link(
+                const char *link_path,
+                const char *expected_suffix,
+                dev_t image_device,
+                char **ret_path) {
+        static const char store_prefix[] = "/nix/store/";
+        _cleanup_free_ char *target = NULL;
+        const char *relative, *suffix;
+        struct stat st;
+        _cleanup_close_ int fd = -EBADF;
+        int r;
+
+        fd = aos_network_open_image_path(link_path, O_PATH | O_NOFOLLOW);
+        if (fd < 0)
+                return fd;
+        if (fstat(fd, &st) < 0)
+                return -errno;
+        if (!S_ISLNK(st.st_mode) || st.st_uid != 0 || st.st_dev != image_device)
+                return -EPERM;
+
+        r = readlinkat_malloc(fd, "", &target);
+        if (r < 0)
+                return r;
+        relative = startswith(target, store_prefix);
+        if (!relative || strlen(relative) < 34 || relative[32] != '-' ||
+            strspn(relative, "0123456789abcdfghijklmnpqrsvwxyz") != 32)
+                return -EPERM;
+
+        suffix = strchr(relative, '/');
+        if (expected_suffix ? !streq_ptr(suffix, expected_suffix) : suffix != NULL)
+                return -EPERM;
+
+        *ret_path = strjoin("/nix.lower/store/", relative);
+        return *ret_path ? 0 : -ENOMEM;
+}
+
+static int aos_network_image_fragment(
+                const char *unit_name,
+                char **ret_path,
+                int *ret_fd,
+                struct stat *ret_stat) {
+        _cleanup_free_ char *top = NULL, *units = NULL, *unit_link = NULL, *suffix = NULL;
+        const char *template_name;
+        struct stat root_st, st;
+        struct statfs fs;
+        struct statvfs vfs;
+        _cleanup_close_ int top_fd = -EBADF, units_fd = -EBADF, fd = -EBADF;
+        int r;
+
+        template_name = aos_network_template_name(unit_name);
+        if (!template_name)
+                return -EINVAL;
+
+        /* /aos-toplevel is part of the measured boot image. Follow only its
+         * fixed store-link chain through the physical EROFS lower store. */
+        if (stat("/", &root_st) < 0 || statfs("/", &fs) < 0 || statvfs("/", &vfs) < 0)
+                return -errno;
+        if (fs.f_type != EROFS_SUPER_MAGIC_V1 ||
+            !FLAGS_SET(vfs.f_flag, ST_RDONLY | ST_NODEV))
+                return -EPERM;
+
+        r = aos_network_image_link("/aos-toplevel", NULL, root_st.st_dev, &top);
+        if (r < 0)
+                return r;
+        top_fd = aos_network_open_image_path(top, O_PATH | O_DIRECTORY);
+        if (top_fd < 0)
+                return top_fd;
+        if (fstat(top_fd, &st) < 0)
+                return -errno;
+        if (!S_ISDIR(st.st_mode) || st.st_dev != root_st.st_dev || st.st_uid != 0)
+                return -EPERM;
+
+        unit_link = path_join(top, "systemd-units");
+        if (!unit_link)
+                return -ENOMEM;
+        r = aos_network_image_link(unit_link, NULL, root_st.st_dev, &units);
+        if (r < 0)
+                return r;
+        units_fd = aos_network_open_image_path(units, O_PATH | O_DIRECTORY);
+        if (units_fd < 0)
+                return units_fd;
+        if (fstat(units_fd, &st) < 0)
+                return -errno;
+        if (!S_ISDIR(st.st_mode) || st.st_dev != root_st.st_dev || st.st_uid != 0)
+                return -EPERM;
+
+        unit_link = mfree(unit_link);
+        unit_link = path_join(units, template_name);
+        suffix = strjoin("/", template_name);
+        if (!unit_link || !suffix)
+                return -ENOMEM;
+        r = aos_network_image_link(unit_link, suffix, root_st.st_dev, ret_path);
+        if (r < 0)
+                return r;
+
+        fd = aos_network_open_image_path(*ret_path, O_RDONLY | O_NOFOLLOW | O_NOCTTY);
+        if (fd < 0)
+                return fd;
+        if (fstat(fd, &st) < 0 || fstatfs(fd, &fs) < 0)
+                return -errno;
+        if (!S_ISREG(st.st_mode) || st.st_uid != 0 || st.st_gid != 0 || st.st_dev != root_st.st_dev ||
+            (st.st_mode & 0222) != 0 || fs.f_type != EROFS_SUPER_MAGIC_V1)
+                return -EPERM;
+        if (ret_stat)
+                *ret_stat = st;
+        if (ret_fd)
+                *ret_fd = TAKE_FD(fd);
+        return 0;
+}
