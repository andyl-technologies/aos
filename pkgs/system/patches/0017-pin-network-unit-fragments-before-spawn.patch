+int aos_network_verify_loaded_fragment(const Unit *u) {
+        _cleanup_free_ char *expected = NULL;
+        struct stat st;
+        int r;
+
+        if (!aos_network_protected_unit(u))
+                return 0;
+        if (!aos_network_protected_name(u->id) || u->transient ||
+            u->load_state != UNIT_LOADED || !set_isempty(u->aliases) ||
+            !strv_isempty(u->dropin_paths) || !isempty(u->source_path))
+                return -EPERM;
+
+        r = aos_network_image_fragment(u->id, &expected, NULL, &st);
+        if (r < 0)
+                return r;
+        if (!u->aos_image_fragment_pinned ||
+            st.st_dev != u->aos_image_fragment_device ||
+            st.st_ino != u->aos_image_fragment_inode)
+                return -EPERM;
+        return streq_ptr(u->fragment_path,
+                         strjoina("/nix/store/", expected + strlen("/nix.lower/store/"))) ? 0 : -EPERM;
+}
