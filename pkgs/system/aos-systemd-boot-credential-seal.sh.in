#!@bash@/bin/bash
set -euo pipefail

if [ "$#" -ne 6 ]; then
  echo "usage: aos-boot-credential-seal NAME POLICY_PUBLIC_KEY SIGNED_PCRS PINNED_PCRS INPUT OUTPUT" >&2
  exit 2
fi

name=$1
public_key=$2
signed_pcrs=$3
pinned_pcrs=$4
input=$5
output=$6

exec @systemd_creds@ encrypt \
  --name="$name" \
  --with-key=tpm2 \
  --tpm2-public-key="$public_key" \
  --tpm2-public-key-pcrs="$signed_pcrs" \
  --tpm2-pcrs="$pinned_pcrs" \
  "$input" "$output"
