+static int erofsdump_show_xattr(void)
+{
+	struct erofs_inode inode = { .sbi = &g_sbi };
+	char value[4096];
+	int length, i;
+
+	if (!dumpcfg.inode_path || dumpcfg.show_extent ||
+	    dumpcfg.show_file_content || dumpcfg.show_statistics ||
+	    dumpcfg.show_superblock || dumpcfg.show_subdirectories)
+		return -EINVAL;
+
+	length = erofs_ilookup(dumpcfg.inode_path, &inode);
+	if (length)
+		return length;
+	length = erofs_getxattr(&inode, dumpcfg.xattr_name,
+				value, sizeof(value));
+	if (length == -ENODATA) {
+		printf("EROFS_XATTR_V1\tmode=%07o\tstatus=absent\tvalue=-\n",
+		       inode.i_mode);
+		return 0;
+	}
+	if (length < 0)
+		return length;
+
+	printf("EROFS_XATTR_V1\tmode=%07o\tstatus=present\tvalue=",
+	       inode.i_mode);
+	for (i = 0; i < length; i++)
+		printf("%02x", (unsigned char)value[i]);
+	putchar('\n');
+	return 0;
+}
