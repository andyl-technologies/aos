 }
 
@@ -486,6 +497,76 @@ static void erofsdump_show_fileinfo(bool show_extent)
 		erofs_is_packed_inode(&inode) ? "(packed file)" : path, extent_count);
 }
 
+#define EROFSDUMP_XATTR_VALUE_MAX	(1024U * 1024U)
+
+static void erofsdump_print_hex(const unsigned char *value, size_t size)
+{
+	size_t i;
+
+	for (i = 0; i < size; ++i)
+		printf("%02x", value[i]);
+}
+
+static int erofsdump_show_xattr(void)
+{
+	struct erofs_inode inode = { .sbi = &g_sbi, .nid = dumpcfg.nid };
+	unsigned char *value;
+	int err, size;
+
+	if (dumpcfg.inode_path) {
+		err = erofs_ilookup(dumpcfg.inode_path, &inode);
+		if (err) {
+			erofs_err("read inode failed @ %s", dumpcfg.inode_path);
+			return err;
+		}
+	} else {
+		err = erofs_read_inode_from_disk(&inode);
+		if (err) {
+			erofs_err("read inode failed @ nid %llu", inode.nid | 0ULL);
+			return err;
+		}
+	}
+
+	size = erofs_getxattr(&inode, dumpcfg.xattr_name, NULL, 0);
+	if (size == -ENODATA) {
+		printf("EROFS_XATTR_V1\tmode=%07o\tstatus=absent\tvalue=-\n",
+		       inode.i_mode);
+		return 0;
+	}
+	if (size < 0) {
+		erofs_err("failed to get xattr `%s` size @ nid %llu: %s",
+			  dumpcfg.xattr_name, inode.nid | 0ULL,
+			  erofs_strerror(size));
+		return size;
+	}
+	if ((unsigned int)size > EROFSDUMP_XATTR_VALUE_MAX) {
+		erofs_err("xattr `%s` @ nid %llu exceeds the %u-byte output limit",
+			  dumpcfg.xattr_name, inode.nid | 0ULL,
+			  EROFSDUMP_XATTR_VALUE_MAX);
+		return -E2BIG;
+	}
+
+	value = malloc(size ? (size_t)size : 1);
+	if (!value)
+		return -ENOMEM;
+	err = erofs_getxattr(&inode, dumpcfg.xattr_name, (char *)value, size);
+	if (err != size) {
+		if (err >= 0)
+			err = -EIO;
+		erofs_err("xattr `%s` @ nid %llu changed size while reading",
+			  dumpcfg.xattr_name, inode.nid | 0ULL);
+		free(value);
+		return err;
+	}
+
+	printf("EROFS_XATTR_V1\tmode=%07o\tstatus=present\tvalue=",
+	       inode.i_mode);
+	erofsdump_print_hex(value, size);
+	putchar('\n');
+	free(value);
+	return 0;
+}
+
 static void erofsdump_filesize_distribution(const char *title,
 		unsigned int *file_counts, unsigned int len)
 {
@@ -770,6 +856,12 @@ int main(int argc, char **argv)
 	if (dumpcfg.show_inode)
 		erofsdump_show_fileinfo(dumpcfg.show_extent);
 
+	if (dumpcfg.xattr_name) {
+		err = erofsdump_show_xattr();
+		if (err)
+			goto exit_put_super;
+	}
+
 exit_put_super:
 	erofs_put_super(&g_sbi);
 exit_dev_close:
