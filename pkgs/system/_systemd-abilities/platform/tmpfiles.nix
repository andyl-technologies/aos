##! Package-owned tmpfiles policy supplied by the selected systemd manager.
{
  abilitySelection ? null,
  lib,
  packageArtifactFor,
  ...
}: let
  managerBindings =
    if abilitySelection == null
    then []
    else abilitySelection.bindingsForImplementation "system-manager";
  selected =
    builtins.length managerBindings
    == 1
    && (builtins.head managerBindings).binding.request == "system:manager";
  cryptsetup = packageArtifactFor (lib.abilities.packageOutput {package = "cryptsetup";});
in {
  config.environment.etc = lib.mkIf selected {
    "tmpfiles.d/aos-base.conf" = {
      text = ''
        # /etc/tmpfiles.d/aos-base.conf
        # Generated by the selected systemd provider; do not edit manually.

        # Runtime lock directories use volatile storage so stale locks cannot
        # survive a reboot.
        d  /run/lock                0755 root root - -
        d  /var/db                  0755 root root - -
        L  /var/lock                -    -    -    - ../run/lock

        # Remove shadow-utils locks left behind by an interrupted account update.
        R! /etc/group.lock           -    -    -    - -
        R! /etc/passwd.lock          -    -    -    - -
        R! /etc/shadow.lock          -    -    -    - -
      '';
    };

    # AOS owns these paths through its immutable image and explicit service
    # configuration. Higher-priority empty files mask systemd's stock rules.
    "tmpfiles.d/home.conf" = {
      text = ''
        # Masked by AOS; /home and /srv are not created by systemd-tmpfiles.
      '';
    };
    "tmpfiles.d/provision.conf" = {
      text = ''
        # Masked by AOS; root SSH authorization does not use systemd provisioning.
      '';
    };
    "tmpfiles.d/root.conf" = {
      text = ''
        # Masked by AOS; the immutable image owns root-directory permissions.
      '';
    };

    # systemd-tmpfiles scans the selected manager and /etc trees, while the
    # upstream cryptsetup rule lives in its package output.
    "tmpfiles.d/cryptsetup.conf" = {
      source = "${cryptsetup}/lib/tmpfiles.d/cryptsetup.conf";
    };
  };
}
