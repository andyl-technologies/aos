+CO_TEST_F(MinimizeNthLargestUtilizationSpecBuilderTest, MaximumSupportsLp) {
+  interface::MinimizeNthLargestUtilizationSpec spec;
+  spec.scope() = "host";
+  spec.dimension() = "cpu";
+  spec.n() = 0;
+
+  const MinimizeNthLargestUtilizationSpecBuilder specBuilder(
+      buildUniverse(), spec);
+  auto goal = co_await specBuilder.goalCoro(expressionBuilder());
+
+  EXPECT_NEAR(
+      4.0 / 14,
+      SpecBuilderTestBase<>::evaluate(goal, deltaFromInitial({})),
+      1e-8);
+  EXPECT_NEAR(
+      3.0 / 10,
+      SpecBuilderTestBase<>::evaluate(
+          goal, deltaFromInitial({{"task0", "host3"}})),
+      1e-8);
+}
+
+CO_TEST_F(MinimizeNthLargestUtilizationSpecBuilderTest, MinimumSupportsLp) {
+  interface::MinimizeNthLargestUtilizationSpec spec;
+  spec.scope() = "host";
+  spec.dimension() = "cpu";
+  spec.n() = 3;
+
+  const MinimizeNthLargestUtilizationSpecBuilder specBuilder(
+      buildUniverse(), spec);
+  auto goal = co_await specBuilder.goalCoro(expressionBuilder());
+
+  EXPECT_NEAR(
+      0,
+      SpecBuilderTestBase<>::evaluate(goal, deltaFromInitial({})),
+      1e-8);
+  // Moving to the empty host creates equal minimum utilizations on two hosts.
+  EXPECT_NEAR(
+      1.0 / 10,
+      SpecBuilderTestBase<>::evaluate(
+          goal, deltaFromInitial({{"task0", "host1"}})),
+      1e-8);
+}
+
+CO_TEST_F(MinimizeNthLargestUtilizationSpecBuilderTest, FilteredMinimumSupportsLp) {
+  interface::MinimizeNthLargestUtilizationSpec spec;
+  spec.scope() = "host";
+  spec.dimension() = "cpu";
+  spec.n() = 3;
+  spec.filter()->itemsBlacklist() = {"host1"};
+
+  const MinimizeNthLargestUtilizationSpecBuilder specBuilder(
+      buildUniverse(), spec);
+  auto goal = co_await specBuilder.goalCoro(expressionBuilder());
+
+  // A rank beyond the filtered size retains the smallest utilization.
+  EXPECT_NEAR(
+      1.0 / 10,
+      SpecBuilderTestBase<>::evaluate(goal, deltaFromInitial({})),
+      1e-8);
+  EXPECT_NEAR(
+      0,
+      SpecBuilderTestBase<>::evaluate(
+          goal, deltaFromInitial({{"task6", "host3"}})),
+      1e-8);
+}
+
