+GLIB_AVAILABLE_IN_ALL
+gboolean g_crucible_main_context_current (const GCrucibleMainContextHold *hold);
+GLIB_AVAILABLE_IN_ALL
+gboolean g_crucible_main_context_inventory (
+    const GCrucibleMainContextHold *hold,
+    GCrucibleSourceObservation *sources, guint capacity,
+    GCrucibleMainContextObservation *observation);
+GLIB_AVAILABLE_IN_ALL
+gboolean g_crucible_main_context_release (GCrucibleMainContextHold *hold);
+
+/* Pure foreign-thread freshness of an exact retained all-context census.
+ * The caller retains the token/array storage through the call and serializes
+ * its own changes. This API takes the real registry before any token reads,
+ * then every context mutex; it grants no ownership or dispatch authority.
+ */
+GLIB_AVAILABLE_IN_ALL
+gboolean g_crucible_main_contexts_inventory_current (
+    const GCrucibleMainContextRegistryHold *registry,
+    GMainContext *const *contexts, const GCrucibleMainContextHold *holds,
+    const GCrucibleMainContextObservation *captured, guint count);
+
+/* Source implementations classify their own concrete source before attach.
+ * Unknown is the default. Attached reclassification invalidates observations.
+ */
+GLIB_AVAILABLE_IN_ALL
+void g_crucible_source_set_role (GSource *source, GCrucibleSourceRole role,
+                                const void *owner);
+
+/* Refresh never surrenders the physical dispatch fence. The native owner
+ * must independently authenticate its reconstruction/Source scope before and
+ * after this API, then recollect every source and reject unknown roles.
+ */
+GLIB_AVAILABLE_IN_ALL
+gboolean g_crucible_main_context_registry_refresh (
+    GCrucibleMainContextRegistryHold *registry,
+    GMainContext **contexts, GCrucibleMainContextHold *holds, guint count);
+
+/* Only an authenticated native child reconstruction may call this. The exact
+ * copied parent holder must be current, every mutex actually trylocked, and
+ * every activity/waiter absent. It cannot repair an arbitrary copied ticket.
+ */
+GLIB_AVAILABLE_IN_ALL
+gboolean g_crucible_main_context_registry_after_fork_child (
