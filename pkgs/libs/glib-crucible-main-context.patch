+#include <glib.h>
+
+G_BEGIN_DECLS
+
+typedef enum {
+  G_CRUCIBLE_SOURCE_UNKNOWN,
+  G_CRUCIBLE_SOURCE_CONTROL,
+  G_CRUCIBLE_SOURCE_NATIVE_AIO,
+  G_CRUCIBLE_SOURCE_GUEST_CHARDEV
+} GCrucibleSourceRole;
+
+typedef struct {
+  GMainContext *context;
+  GThread *thread;
+  guint64 process;
+  gint generation;
+} GCrucibleMainContextHold;
+
+typedef struct {
+  GThread *thread;
+  guint64 process;
+  gint generation;
+} GCrucibleMainContextRegistryHold;
+
+/* Acquires the real registry and returns owned references to every context.
+ * Caller releases each context reference, then the registry hold. New foreign
+ * contexts invalidate current before waiting at the registry publication seam.
+ */
+GLIB_AVAILABLE_IN_ALL
+gboolean g_crucible_main_context_registry_try_hold (
+    GCrucibleMainContextRegistryHold *hold,
+    GMainContext **contexts, guint capacity, guint *count);
+GLIB_AVAILABLE_IN_ALL
+gboolean g_crucible_main_context_registry_current (
+    const GCrucibleMainContextRegistryHold *hold);
+/* Physical global dispatch fence, including a stale or partially released
+ * holder. This observer grants no ownership or release authority.
+ */
+GLIB_AVAILABLE_IN_ALL
+gboolean g_crucible_main_context_dispatch_fenced (void);
+
+GLIB_AVAILABLE_IN_ALL
+gboolean g_crucible_main_context_registry_release (
+    GCrucibleMainContextRegistryHold *hold);
+
+typedef struct {
+  GSource *source; /* Borrowed identity, never dereferenced by the observer. */
+  const void *owner;
+  guint source_id;
+  GCrucibleSourceRole role;
+  gboolean destroyed;
+  gboolean ready;
+  gboolean armed;
+  guint descriptors;
+} GCrucibleSourceObservation;
+
+typedef struct {
+  guint sources;
+  guint pending_dispatches;
+  guint active_callbacks;
+  guint pending_mutators;
+  guint foreign_waiters;
+} GCrucibleMainContextObservation;
+
+/* Nonblocking acquisition refuses foreign ownership or an active callback.
+ * The holder must release on its acquiring thread, even after invalidation.
+ */
+GLIB_AVAILABLE_IN_ALL
+gboolean g_crucible_main_context_try_hold (GMainContext *context,
