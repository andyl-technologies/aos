+/* These APIs inspect GLib's own registry, including library-created sources.
+ * No QEMU private objects or public process protocol are involved.
+ */
+gboolean
+g_crucible_main_context_try_hold (GMainContext *context,
+                                 GCrucibleMainContextHold *hold)
+{
+  GCrucibleMainContextHold next = { 0 };
+  GHashTableIter iter;
+  gpointer value;
+  gboolean accepted = FALSE;
+
+  g_return_val_if_fail (context != NULL && hold != NULL, FALSE);
+  if (!g_mutex_trylock (&context->mutex))
+    return FALSE;
+
+  if (context->crucible_holder || context->owner ||
+      context->in_check_or_prepare || context->crucible_callbacks ||
+      context->crucible_mutators || context->waiters ||
+      g_hash_table_size (context->sources) > 8192 ||
+      g_atomic_int_get (&context->crucible_epoch) == G_MAXINT)
+    goto out;
+
+  g_hash_table_iter_init (&iter, context->sources);
+  while (g_hash_table_iter_next (&iter, NULL, &value))
+    {
+      GSource *source = G_CONTAINER_OF (value, GSource, source_id);
+      if (source->flags & G_HOOK_FLAG_IN_CALL)
+        goto out;
+    }
+
+  /* Private acquisition follows the same ownership invariant as acquire(),
+   * while the registry fence already forbids ordinary dispatch admission.
+   */
+  context->owner = G_THREAD_SELF;
+  context->owner_count = 1;
+  crucible_mutation_unlocked (context);
+  context->crucible_holder = G_THREAD_SELF;
+  next.context = g_main_context_ref (context);
+  next.thread = G_THREAD_SELF;
+  next.process = crucible_process_identity ();
+  next.generation = g_atomic_int_get (&context->crucible_epoch);
+  g_atomic_int_set (&context->crucible_hold_epoch, next.generation);
+  *hold = next;
+  accepted = TRUE;
+
+out:
+  UNLOCK_CONTEXT (context);
+  return accepted;
+}
+
+gboolean
+g_crucible_main_context_current (const GCrucibleMainContextHold *hold)
+{
+  return hold && hold->context && hold->generation > 0 &&
+         hold->generation < G_MAXINT && hold->thread == G_THREAD_SELF &&
+         hold->process == crucible_process_identity () &&
+         g_atomic_int_get (&hold->context->crucible_epoch) == hold->generation &&
+         g_atomic_int_get (&hold->context->crucible_hold_epoch) == hold->generation;
+}
+
+gboolean
+g_crucible_main_context_inventory (const GCrucibleMainContextHold *hold,
+                                  GCrucibleSourceObservation *sources,
+                                  guint capacity,
+                                  GCrucibleMainContextObservation *observation)
+{
+  GCrucibleMainContextObservation next = { 0 };
+  GMainContext *context;
+  GHashTableIter iter;
+  gpointer value;
+  gboolean accepted = FALSE;
+
+  if (!observation || !g_crucible_main_context_current (hold))
+    return FALSE;
+  context = hold->context;
+  if (!g_mutex_trylock (&context->mutex))
+    return FALSE;
+  if (!g_crucible_main_context_current (hold))
+    goto out;
+
+  next.sources = g_hash_table_size (context->sources);
+  next.pending_dispatches = context->pending_dispatches->len;
+  next.active_callbacks = context->crucible_callbacks + context->in_check_or_prepare;
+  next.pending_mutators = context->crucible_mutators;
+  next.foreign_waiters = g_slist_length (context->waiters);
+  if (next.sources > capacity || (next.sources && !sources))
+    goto out;
+
+  next.sources = 0;
+  g_hash_table_iter_init (&iter, context->sources);
+  while (g_hash_table_iter_next (&iter, NULL, &value))
+    {
+      GSource *source = G_CONTAINER_OF (value, GSource, source_id);
+      GCrucibleSourceObservation entry = { 0 };
+
+      entry.source = source;
+      entry.owner = source->priv->crucible_owner;
+      entry.source_id = source->source_id;
+      entry.role = source->priv->crucible_role;
+      entry.destroyed = SOURCE_DESTROYED (source);
+      entry.ready = (source->flags & G_SOURCE_READY) != 0;
+      entry.armed = source->priv->ready_time >= 0;
+      entry.descriptors = g_slist_length (source->poll_fds) +
+                          g_slist_length (source->priv->fds);
+      if (source->flags & G_HOOK_FLAG_IN_CALL)
+        next.active_callbacks++;
+      sources[next.sources++] = entry;
+    }
+
+  if (!g_crucible_main_context_current (hold))
+    goto out;
+  *observation = next;
+  accepted = TRUE;
+
+out:
+  UNLOCK_CONTEXT (context);
+  return accepted;
+}
+
+gboolean
+g_crucible_main_context_release (GCrucibleMainContextHold *hold)
+{
+  GMainContext *context;
+
+  g_return_val_if_fail (hold && hold->context && hold->thread == G_THREAD_SELF, FALSE);
+  g_return_val_if_fail (hold->process == crucible_process_identity (), FALSE);
+  context = hold->context;
+  if (!g_mutex_trylock (&context->mutex))
+    return FALSE;
+  if (context->crucible_holder != hold->thread ||
+      g_atomic_pointer_get (&context->crucible_control) ||
+      g_atomic_int_get (&context->crucible_hold_epoch) != hold->generation)
+    {
+      UNLOCK_CONTEXT (context);
+      return FALSE;
+    }
+
+  g_atomic_int_set (&context->crucible_hold_epoch, 0);
+  context->crucible_holder = NULL;
+  crucible_mutation_unlocked (context);
+  g_main_context_release_unlocked (context);
+  g_cond_broadcast (&context->cond);
+  UNLOCK_CONTEXT (context);
+  *hold = (GCrucibleMainContextHold) { 0 };
+  g_main_context_unref (context);
+  return TRUE;
+}
+
+void
+g_crucible_source_set_role (GSource *source, GCrucibleSourceRole role,
+                            const void *owner)
+{
+  GMainContext *context;
+
+  g_return_if_fail (source && g_atomic_int_get (&source->ref_count) > 0);
+  g_return_if_fail (role >= G_CRUCIBLE_SOURCE_UNKNOWN &&
+                    role <= G_CRUCIBLE_SOURCE_GUEST_CHARDEV);
+  g_return_if_fail (role == G_CRUCIBLE_SOURCE_UNKNOWN || owner != NULL);
+  context = source->context;
+  if (context)
+    LOCK_CONTEXT (context);
+  crucible_mutation_unlocked (context);
+  source->priv->crucible_role = role;
+  source->priv->crucible_owner = owner;
+  if (context)
+    UNLOCK_CONTEXT (context);
+}
