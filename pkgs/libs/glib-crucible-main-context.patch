+ */
+GLIB_AVAILABLE_IN_ALL
+gboolean g_crucible_main_context_control_iteration (
+    GCrucibleMainContextControlHold *control);
+/* Revoke first, then acknowledge only after the real reader leaves ownership.
+ * A refused release retains the cohort and every source reference for retry.
+ */
+GLIB_AVAILABLE_IN_ALL
+gboolean g_crucible_main_context_control_try_release (
+    GCrucibleMainContextControlHold *control);
