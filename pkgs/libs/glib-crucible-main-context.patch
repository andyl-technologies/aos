+  if (!hold || !contexts || !count || capacity > 64 ||
+      !G_TRYLOCK (main_context_list))
+    return FALSE;
+  size = crucible_context_registry_size_unlocked ();
+  if (crucible_context_registry_holder || crucible_context_registry_mutators ||
+      g_atomic_int_get (&crucible_context_registry_epoch) == G_MAXINT ||
+      size > capacity)
+    {
+      G_UNLOCK (main_context_list);
+      return FALSE;
+    }
+  *count = 0;
+  for (GSList *entry = main_context_list; entry; entry = entry->next)
+    {
+      GMainContext *context = entry->data;
+      gint references = g_atomic_int_get (&context->ref_count);
+
+      /* Final unref decrements before taking this lock. Conditional ref
+       * acquisition avoids resurrecting a context concurrently reaching zero.
+       */
+      if (references <= 0 || references == G_MAXINT ||
+          !g_atomic_int_compare_and_exchange (&context->ref_count,
+                                              references, references + 1))
+        {
+          G_UNLOCK (main_context_list);
+          while (*count)
+            g_main_context_unref (contexts[--(*count)]);
+          return FALSE;
+        }
+      contexts[(*count)++] = context;
+    }
+  crucible_context_registry_mutation_unlocked ();
+  crucible_context_registry_holder = G_THREAD_SELF;
+  next.thread = G_THREAD_SELF;
+  next.process = crucible_process_identity ();
+  next.generation = g_atomic_int_get (&crucible_context_registry_epoch);
+  g_atomic_int_set (&crucible_context_registry_hold_epoch, next.generation);
+  *hold = next;
+  G_UNLOCK (main_context_list);
+  return TRUE;
+}
+
+gboolean
+g_crucible_main_context_registry_current (
+    const GCrucibleMainContextRegistryHold *hold)
+{
+  return hold && hold->generation > 0 && hold->generation < G_MAXINT &&
+         hold->thread == G_THREAD_SELF &&
+         hold->process == crucible_process_identity () &&
+         g_atomic_int_get (&crucible_context_registry_epoch) == hold->generation &&
+         g_atomic_int_get (&crucible_context_registry_hold_epoch) == hold->generation;
+}
+
+gboolean
+g_crucible_main_contexts_inventory_current (
+    const GCrucibleMainContextRegistryHold *registry,
+    GMainContext *const *contexts, const GCrucibleMainContextHold *holds,
+    const GCrucibleMainContextObservation *captured, guint count)
+{
+  guint locked = 0;
+  gboolean current = FALSE;
+
+  if (!registry || !contexts || !holds || !captured || count > 64 ||
+      !G_TRYLOCK (main_context_list))
+    return FALSE;
+  if (!registry->thread || registry->process != crucible_process_identity () ||
+      registry->generation <= 0 || registry->generation >= G_MAXINT ||
+      crucible_context_registry_holder != registry->thread ||
+      crucible_context_registry_mutators ||
+      g_atomic_int_get (&crucible_context_registry_epoch) != registry->generation ||
+      g_atomic_int_get (&crucible_context_registry_hold_epoch) != registry->generation ||
+      crucible_context_registry_size_unlocked () != count)
+    goto out;
+
+  for (guint index = 0; index < count; index++)
+    {
+      GMainContext *context = contexts[index];
+      const GCrucibleMainContextHold *hold = &holds[index];
+      const GCrucibleMainContextObservation *expected = &captured[index];
+      GHashTableIter iter;
+      gpointer value;
+      guint active;
+
+      if (!context || !g_slist_find (main_context_list, context))
+        goto out;
+      for (guint earlier = 0; earlier < index; earlier++)
+        if (contexts[earlier] == context)
+          goto out;
+      if (!g_mutex_trylock (&context->mutex))
+        goto out;
+      locked++;
+      if (hold->context != context || hold->thread != registry->thread ||
+          hold->process != registry->process || hold->generation <= 0 ||
+          hold->generation >= G_MAXINT ||
+          context->crucible_holder != hold->thread ||
+          g_atomic_int_get (&context->crucible_epoch) != hold->generation ||
+          g_atomic_int_get (&context->crucible_hold_epoch) != hold->generation ||
+          expected->sources > 8192 || expected->active_callbacks ||
+          expected->pending_mutators || expected->foreign_waiters ||
+          g_hash_table_size (context->sources) != expected->sources ||
+          context->pending_dispatches->len != expected->pending_dispatches ||
+          context->crucible_mutators || context->waiters)
+        goto out;
+      active = context->crucible_callbacks + context->in_check_or_prepare;
+      g_hash_table_iter_init (&iter, context->sources);
+      while (g_hash_table_iter_next (&iter, NULL, &value))
+        {
+          GSource *source = G_CONTAINER_OF (value, GSource, source_id);
+          active += (source->flags & G_HOOK_FLAG_IN_CALL) != 0;
+        }
+      if (active)
+        goto out;
+    }
+  current = TRUE;
+
+out:
+  while (locked)
+    UNLOCK_CONTEXT (contexts[--locked]);
+  G_UNLOCK (main_context_list);
+  return current;
+}
+
+gboolean
+g_crucible_main_context_dispatch_fenced (void)
+{
+  return g_atomic_int_get (&crucible_context_registry_hold_epoch) != 0;
+}
+
+gboolean
+g_crucible_main_context_registry_release (GCrucibleMainContextRegistryHold *hold)
+{
+  gboolean accepted = FALSE;
+
+  g_return_val_if_fail (hold && hold->thread == G_THREAD_SELF, FALSE);
+  g_return_val_if_fail (hold->process == crucible_process_identity (), FALSE);
+  if (!G_TRYLOCK (main_context_list))
+    return FALSE;
+  if (crucible_context_registry_holder == hold->thread &&
+      g_atomic_int_get (&crucible_context_registry_hold_epoch) == hold->generation)
+    {
+      for (GSList *entry = main_context_list; entry; entry = entry->next)
+        {
+          GMainContext *context = entry->data;
+          if (g_atomic_pointer_get (&context->crucible_control))
+            goto out;
+        }
+      g_atomic_int_set (&crucible_context_registry_hold_epoch, 0);
+      crucible_context_registry_holder = NULL;
+      crucible_context_registry_mutation_unlocked ();
+      g_cond_broadcast (&crucible_context_registry_cond);
+      *hold = (GCrucibleMainContextRegistryHold) { 0 };
+      accepted = TRUE;
+    }
+out:
+  G_UNLOCK (main_context_list);
+  return accepted;
+}
+
+/* Child-only structural validation of the copied parent cohort. It cannot
+ * admit the vanished reader. Every exact source and retained reference joins
+ * the real locked hash table before its copied dispatch permit is consumed.
+ */
+static gboolean
+crucible_control_child_join_unlocked (GMainContext *context,
+                                     const GCrucibleMainContextRegistryHold *registry,
+                                     const GCrucibleMainContextHold *hold)
+{
+  GCrucibleMainContextControlHold *control = context->crucible_control;
+
+  if (!crucible_control_token_matches (control) ||
+      control->controller != hold->thread ||
+      control->process != registry->process ||
+      control->generation != hold->generation ||
+      control->registry_generation != registry->generation ||
+      !control->reader || control->source_count > 8192 ||
+      control->source_count != g_hash_table_size (context->sources) ||
+      context->owner || context->owner_count ||
+      g_atomic_int_get (&context->crucible_control_active) ||
+      g_atomic_int_get (&context->crucible_control_revoked))
+    return FALSE;
+  for (guint index = 0; index < control->source_count; index++)
+    {
+      const GCrucibleSourceObservation *entry =
+          &context->crucible_control_sources[index];
+      GSource *source = entry->source;
+
+      if (!source || !entry->owner || source->context != context ||
+          SOURCE_DESTROYED (source) || source->source_id != entry->source_id ||
+          source->priv->crucible_role != entry->role ||
+          source->priv->crucible_owner != entry->owner ||
+          g_atomic_int_get (&source->ref_count) <= 1 ||
+          g_hash_table_lookup (context->sources, &source->source_id) !=
+              &source->source_id)
+        return FALSE;
+    }
+  return TRUE;
+}
+
+/* Exact retained holder revalidation. All context mutexes and the actual
+ * registry mutex are acquired nonblockingly; no callback is entered here.
+ */
+static gboolean
+crucible_registry_revalidate (GCrucibleMainContextRegistryHold *registry,
+                             GMainContext **contexts,
+                             GCrucibleMainContextHold *holds,
+                             guint count, gboolean after_fork)
+{
+  guint locked = 0;
+  GCrucibleSourceObservation *retired_sources[64] = { 0 };
+  GThread *retired_readers[64] = { 0 };
+  guint64 process = crucible_process_identity ();
+  GThread *thread = G_THREAD_SELF;
+  gboolean accepted = FALSE;
+
+  if (!registry || !contexts || !holds || count > 64 ||
+      registry->thread != thread || registry->generation <= 0 ||
+      registry->generation >= G_MAXINT - 1 ||
+      (after_fork ? registry->process == process : registry->process != process) ||
+      !G_TRYLOCK (main_context_list))
+    return FALSE;
+
+  if (crucible_context_registry_holder != thread ||
+      crucible_context_registry_mutators ||
+      g_atomic_int_get (&crucible_context_registry_hold_epoch) != registry->generation ||
+      g_atomic_int_get (&crucible_context_registry_epoch) >= G_MAXINT - 1 ||
+      crucible_context_registry_size_unlocked () != count)
+    goto out;
+  if (after_fork &&
+      g_atomic_int_get (&crucible_context_registry_epoch) != registry->generation)
+    goto out;
+
+  for (guint index = 0; index < count; index++)
+    {
+      GMainContext *context = contexts[index];
+      GCrucibleMainContextHold *hold = &holds[index];
+      GHashTableIter iter;
+      gpointer value;
+
+      if (!context || hold->context != context || hold->thread != thread ||
+          hold->process != registry->process || hold->generation <= 0 ||
+          hold->generation >= G_MAXINT - 1 ||
+          !g_slist_find (main_context_list, context))
+        goto out;
+      for (guint previous = 0; previous < index; previous++)
+        if (contexts[previous] == context)
+          goto out;
+      if (!g_mutex_trylock (&context->mutex))
+        goto out;
+      locked++;
+      if ((context->crucible_control ?
+             (!after_fork || !crucible_control_child_join_unlocked (
+                 context, registry, hold)) :
+             (context->owner != thread || context->owner_count != 1)) ||
+          context->crucible_holder != thread ||
+          context->crucible_callbacks ||
+          context->in_check_or_prepare || context->crucible_mutators ||
+          context->waiters || g_hash_table_size (context->sources) > 8192 ||
+          g_atomic_int_get (&context->crucible_hold_epoch) != hold->generation ||
+          g_atomic_int_get (&context->crucible_epoch) >= G_MAXINT - 1 ||
+          (after_fork && g_atomic_int_get (&context->crucible_epoch) != hold->generation))
+        goto out;
+      g_hash_table_iter_init (&iter, context->sources);
+      while (g_hash_table_iter_next (&iter, NULL, &value))
+        {
+          GSource *source = G_CONTAINER_OF (value, GSource, source_id);
+          if (source->flags & G_HOOK_FLAG_IN_CALL)
+            goto out;
+        }
+    }
+
+  /* A successful child join advances every identity. Copied mutexes are never
+   * cleared: trylock has proved their real unlocked state. Only conditions
+   * with no actual waiters are reconstructed, before replacement workers.
+   */
+  for (guint index = 0; index < count; index++)
+    {
+      GMainContext *context = contexts[index];
+      GCrucibleMainContextHold *hold = &holds[index];
+      if (after_fork)
+        {
+          GCrucibleMainContextControlHold *control = context->crucible_control;
+
+          if (control)
+            {
+              retired_sources[index] = context->crucible_control_sources;
+              retired_readers[index] = control->reader;
+              /* All references were proved nonfinal under this exact mutex.
+               * Dropping this internal cache cannot run dispose/finalize or
+               * change source identity. The copied reader permit is consumed,
+               * never rebased into a fresh child permission.
+               */
+              context->crucible_control_retiring_refs = TRUE;
+              for (guint source_index = 0; source_index < control->source_count;
+                   source_index++)
+                g_source_unref_internal (
+                    retired_sources[index][source_index].source, context, TRUE);
+              context->crucible_control_retiring_refs = FALSE;
+              g_atomic_pointer_set (&context->crucible_control, NULL);
+              context->crucible_control_sources = NULL;
+              context->crucible_control_identity =
+                  (GCrucibleMainContextControlHold) { 0 };
+              *control = (GCrucibleMainContextControlHold) { 0 };
+              context->owner = thread;
+              context->owner_count = 1;
+            }
+          g_cond_clear (&context->cond);
+          g_cond_init (&context->cond);
+        }
+      crucible_mutation_unlocked (context);
+      hold->generation = g_atomic_int_get (&context->crucible_epoch);
+      hold->process = process;
+      g_atomic_int_set (&context->crucible_hold_epoch, hold->generation);
+    }
+  if (after_fork)
+    {
+      g_cond_clear (&crucible_context_registry_cond);
+      g_cond_init (&crucible_context_registry_cond);
+    }
+  crucible_context_registry_mutation_unlocked ();
+  registry->generation = g_atomic_int_get (&crucible_context_registry_epoch);
+  registry->process = process;
+  g_atomic_int_set (&crucible_context_registry_hold_epoch, registry->generation);
+  accepted = TRUE;
+
+out:
+  while (locked)
+    g_mutex_unlock (&contexts[--locked]->mutex);
+  G_UNLOCK (main_context_list);
+  for (guint index = 0; index < count; index++)
+    {
+      g_free (retired_sources[index]);
+      if (retired_readers[index])
+        g_thread_unref (retired_readers[index]);
+    }
+  return accepted;
+}
+
+gboolean
+g_crucible_main_context_registry_refresh (
+    GCrucibleMainContextRegistryHold *registry,
+    GMainContext **contexts, GCrucibleMainContextHold *holds, guint count)
+{
+  return crucible_registry_revalidate (registry, contexts, holds, count, FALSE);
+}
+
+gboolean
+g_crucible_main_context_registry_after_fork_child (
+    GCrucibleMainContextRegistryHold *registry,
+    GMainContext **contexts, GCrucibleMainContextHold *holds, guint count)
+{
+  return crucible_registry_revalidate (registry, contexts, holds, count, TRUE);
+}
+
+gboolean
+g_crucible_main_contexts_try_hold (GCrucibleMainContextRegistryHold *registry,
+                                  GMainContext **contexts,
+                                  GCrucibleMainContextHold *holds,
+                                  guint capacity, guint *count)
+{
+  guint size, locked = 0, referenced = 0;
+  GThread *thread = G_THREAD_SELF;
+  guint64 process = crucible_process_identity ();
+  gboolean accepted = FALSE;
+
+  if (!registry || !contexts || !holds || !count || capacity > 64 ||
+      !G_TRYLOCK (main_context_list))
+    return FALSE;
+  size = crucible_context_registry_size_unlocked ();
+  if (size > capacity || crucible_context_registry_holder ||
+      crucible_context_registry_mutators ||
+      g_atomic_int_get (&crucible_context_registry_epoch) >= G_MAXINT - 1)
+    goto out;
+
+  for (GSList *entry = main_context_list; entry; entry = entry->next)
+    {
+      GMainContext *context = entry->data;
+      GHashTableIter iter;
+      gpointer value;
+
+      contexts[locked] = context;
+      if (!g_mutex_trylock (&context->mutex))
+        goto out;
+      locked++;
+      if (context->owner || context->crucible_holder ||
+          context->in_check_or_prepare || context->crucible_callbacks ||
+          context->crucible_mutators || context->waiters ||
+          g_atomic_int_get (&context->crucible_epoch) >= G_MAXINT - 1 ||
+          g_hash_table_size (context->sources) > 8192)
+        goto out;
+      g_hash_table_iter_init (&iter, context->sources);
+      while (g_hash_table_iter_next (&iter, NULL, &value))
+        {
+          GSource *source = G_CONTAINER_OF (value, GSource, source_id);
+          if (source->flags & G_HOOK_FLAG_IN_CALL)
+            goto out;
+        }
+    }
+
+  for (guint index = 0; index < size; index++)
+    {
+      GMainContext *context = contexts[index];
+      gint references = g_atomic_int_get (&context->ref_count);
+
+      /* One reference owns the exact context snapshot; another owns its hold.
+       * Conditional acquisition cannot resurrect a concurrent final unref.
+       */
+      if (references <= 0 || references >= G_MAXINT - 2 ||
+          !g_atomic_int_compare_and_exchange (&context->ref_count,
+                                              references, references + 2))
+        goto out;
+      referenced++;
+    }
+
+  /* Every real mutex is held and every owner/activity has been checked.
+   * Publish the complete fence only after this all-or-nothing acquisition.
+   */
+  crucible_context_registry_mutation_unlocked ();
+  crucible_context_registry_holder = thread;
+  *registry = (GCrucibleMainContextRegistryHold) {
+    thread, process, g_atomic_int_get (&crucible_context_registry_epoch)
+  };
+  g_atomic_int_set (&crucible_context_registry_hold_epoch, registry->generation);
+  for (guint index = 0; index < size; index++)
+    {
+      GMainContext *context = contexts[index];
+
+      crucible_mutation_unlocked (context);
+      context->owner = thread;
+      context->owner_count = 1;
+      context->crucible_holder = thread;
+      holds[index] = (GCrucibleMainContextHold) {
+        context, thread, process, g_atomic_int_get (&context->crucible_epoch)
+      };
+      g_atomic_int_set (&context->crucible_hold_epoch, holds[index].generation);
+    }
+  *count = size;
+  accepted = TRUE;
+
+out:
+  while (locked)
+    g_mutex_unlock (&contexts[--locked]->mutex);
+  G_UNLOCK (main_context_list);
+  if (!accepted)
+    {
+      while (referenced)
+        {
+          GMainContext *context = contexts[--referenced];
+          g_main_context_unref (context);
+          g_main_context_unref (context);
+        }
+    }
+  return accepted;
+}
+
+
+static gboolean
+crucible_control_token_matches (const GCrucibleMainContextControlHold *control)
+{
+  const GCrucibleMainContextControlHold *actual;
+
+  if (!control || !control->context ||
+      g_atomic_pointer_get (&control->context->crucible_control) != control)
+    return FALSE;
+  actual = &control->context->crucible_control_identity;
+  return control->controller == actual->controller &&
+         control->reader == actual->reader &&
+         control->process == actual->process &&
+         control->generation == actual->generation &&
+         control->registry_generation == actual->registry_generation &&
+         control->source_count == actual->source_count;
+}
+
+/* Context mutex held; the registry/physical holder owns the context lifetime. */
+static gboolean
+crucible_control_current_unlocked (
+    const GCrucibleMainContextControlHold *control)
+{
+  return crucible_control_token_matches (control) &&
+         control->process == crucible_process_identity () &&
+         !g_atomic_int_get (&control->context->crucible_control_revoked) &&
+         g_atomic_int_get (&control->context->crucible_hold_epoch) ==
+             control->generation &&
+         g_atomic_int_get (&control->context->crucible_epoch) ==
+             control->generation &&
+         g_atomic_int_get (&crucible_context_registry_hold_epoch) ==
+             control->registry_generation &&
+         g_atomic_int_get (&crucible_context_registry_epoch) ==
+             control->registry_generation;
+}
+
+/* Public entry never reads mutable token identity before the registry lock.
+ * Registry membership then pins the real context while its mutex serializes
+ * installation/removal and the entire pre-active interval. Dispatch runs only
+ * after both locks have been released.
+ */
+static GMainContext *
+crucible_control_entry_try_lock (const GCrucibleMainContextControlHold *control)
+{
+  GMainContext *context;
+
+  if (!control || !G_TRYLOCK (main_context_list))
+    return NULL;
+  context = control->context;
+  if (!context || !g_slist_find (main_context_list, context) ||
+      !g_mutex_trylock (&context->mutex))
+    {
+      G_UNLOCK (main_context_list);
+      return NULL;
+    }
+  return context;
+}
+
+static void
+crucible_control_entry_unlock (GMainContext *context)
+{
+  UNLOCK_CONTEXT (context);
+  G_UNLOCK (main_context_list);
+}
+
+gboolean
+g_crucible_main_context_control_current (
+    const GCrucibleMainContextControlHold *control)
+{
+  GMainContext *context = crucible_control_entry_try_lock (control);
+  gboolean current;
+
+  if (!context)
+    return FALSE;
+  current = crucible_control_current_unlocked (control);
+  crucible_control_entry_unlock (context);
+  return current;
+}
+
+static gboolean
+crucible_control_iteration_allowed_unlocked (GMainContext *context)
+{
+  GCrucibleMainContextControlHold *control =
+      g_atomic_pointer_get (&context->crucible_control);
+
+  return control && g_atomic_int_get (&context->crucible_control_active) &&
+         control->reader == G_THREAD_SELF &&
+         crucible_control_current_unlocked (control);
+}
+
+static gboolean
+crucible_control_source_allowed_unlocked (GMainContext *context, GSource *source)
+{
+  if (!crucible_control_iteration_allowed_unlocked (context))
+    return FALSE;
+  for (guint index = 0; index < context->crucible_control_identity.source_count;
+       index++)
+    {
+      const GCrucibleSourceObservation *entry =
+          &context->crucible_control_sources[index];
+      if (entry->source == source)
+        return entry->role == G_CRUCIBLE_SOURCE_CONTROL &&
+               source->priv->crucible_role == entry->role &&
+               source->priv->crucible_owner == entry->owner &&
+               source->source_id == entry->source_id &&
+               source->context == context && !SOURCE_DESTROYED (source);
+    }
+  return FALSE;
+}
+
+gboolean
+g_crucible_main_context_control_try_arm (
+    const GCrucibleMainContextRegistryHold *registry,
+    const GCrucibleMainContextHold *context_hold,
+    const GCrucibleSourceObservation *sources, guint count,
+    GThread *reader, GCrucibleMainContextControlHold *control)
+{
+  GMainContext *context;
+  GCrucibleSourceObservation *retained = NULL;
+  guint controls = 0;
+  gboolean accepted = FALSE;
+
+  if (!control || !reader || reader == G_THREAD_SELF || !sources || !count ||
+      count > 8192 || !g_crucible_main_context_registry_current (registry) ||
+      !g_crucible_main_context_current (context_hold))
+    return FALSE;
+  if (!G_TRYLOCK (main_context_list))
+    return FALSE;
+  context = context_hold->context;
+  if (!g_slist_find (main_context_list, context) ||
+      !g_mutex_trylock (&context->mutex))
+    {
+      G_UNLOCK (main_context_list);
+      return FALSE;
+    }
+  if (!g_crucible_main_context_registry_current (registry) ||
+      !g_crucible_main_context_current (context_hold) ||
+      context->crucible_control || context->owner != G_THREAD_SELF ||
+      context->owner_count != 1 || context->in_check_or_prepare ||
+      context->crucible_callbacks || context->crucible_mutators ||
+      context->waiters ||
+      g_hash_table_size (context->sources) != count)
+    goto out;
+  for (guint index = 0; index < count; index++)
+    {
+      GSource *source = sources[index].source;
+
+      if (!source || !sources[index].owner || sources[index].destroyed ||
+          source->context != context || SOURCE_DESTROYED (source) ||
+          source->source_id != sources[index].source_id ||
+          source->priv->crucible_role != sources[index].role ||
+          source->priv->crucible_owner != sources[index].owner ||
+          g_hash_table_lookup (context->sources,
+                               &source->source_id) !=
+              &source->source_id ||
+          (sources[index].role != G_CRUCIBLE_SOURCE_CONTROL &&
+           sources[index].role != G_CRUCIBLE_SOURCE_NATIVE_AIO))
+        goto out;
+      for (guint previous = 0; previous < index; previous++)
+        if (sources[previous].source == source)
+          goto out;
+      controls += sources[index].role == G_CRUCIBLE_SOURCE_CONTROL;
+    }
+  if (!controls)
+    goto out;
+  for (guint index = 0; index < context->pending_dispatches->len; index++)
+    {
+      GSource *source = context->pending_dispatches->pdata[index];
+      if (!source || source->priv->crucible_role != G_CRUCIBLE_SOURCE_CONTROL)
+        goto out;
+    }
+
+  retained = g_try_malloc_n (count, sizeof (*sources));
+  if (!retained)
+    goto out;
+  memcpy (retained, sources, count * sizeof (*sources));
+  for (guint index = 0; index < count; index++)
+    g_source_ref (retained[index].source);
+  *control = (GCrucibleMainContextControlHold) {
+    context, G_THREAD_SELF, reader, crucible_process_identity (),
+    context_hold->generation, registry->generation, count
+  };
+  g_thread_ref (reader);
+  context->crucible_control_identity = *control;
+  context->crucible_control_sources = retained;
+  g_atomic_int_set (&context->crucible_control_revoked, 0);
+  g_atomic_int_set (&context->crucible_control_active, 0);
+  g_atomic_pointer_set (&context->crucible_control, control);
+  /* The reserved physical holder survives this real ownership handoff. Only
+   * the canonical reader's bounded CONTROL iteration may acquire the context.
+   */
+  context->owner = NULL;
+  context->owner_count = 0;
+  accepted = TRUE;
+
+out:
+  crucible_control_entry_unlock (context);
+  return accepted;
+}
+
+gboolean
+g_crucible_main_context_control_iteration (
+    GCrucibleMainContextControlHold *control)
+{
+  GMainContext *context;
+  gboolean ready;
+
+  context = crucible_control_entry_try_lock (control);
+  if (!context)
+    return FALSE;
+  if (control->reader != G_THREAD_SELF ||
+      !crucible_control_current_unlocked (control) ||
+      context->owner || context->owner_count || context->waiters ||
+      context->crucible_mutators || context->in_check_or_prepare ||
+      g_atomic_int_get (&context->crucible_control_active))
+    {
+      crucible_control_entry_unlock (context);
+      return FALSE;
+    }
+  context->owner = G_THREAD_SELF;
+  context->owner_count = 1;
+  g_atomic_int_set (&context->crucible_control_active, 1);
+  crucible_control_entry_unlock (context);
+
+  g_main_context_push_thread_default (context);
+  LOCK_CONTEXT (context);
+  ready = g_main_context_iterate_unlocked (context, FALSE, TRUE, G_THREAD_SELF);
+  UNLOCK_CONTEXT (context);
+  g_main_context_pop_thread_default (context);
+
+  LOCK_CONTEXT (context);
+  g_assert (context->owner == G_THREAD_SELF && context->owner_count == 1);
+  /* End only the canonical reader's reserved ownership; the exact physical
+   * holder and global guest dispatch fence remain installed throughout.
+   */
+  context->owner = NULL;
+  context->owner_count = 0;
+  g_atomic_int_set (&context->crucible_control_active, 0);
+  g_cond_broadcast (&context->cond);
+  UNLOCK_CONTEXT (context);
+  return ready;
+}
+
+gboolean
+g_crucible_main_context_control_try_release (
+    GCrucibleMainContextControlHold *control)
+{
+  GMainContext *context;
+  GCrucibleSourceObservation *sources;
+  guint count;
+  GThread *reader;
+
+  context = crucible_control_entry_try_lock (control);
+  if (!context)
+    return FALSE;
+  if (!crucible_control_token_matches (control) ||
+      control->controller != G_THREAD_SELF ||
+      control->process != crucible_process_identity ())
+    {
+      crucible_control_entry_unlock (context);
+      return FALSE;
+    }
+  g_atomic_int_set (&context->crucible_control_revoked, 1);
+  if (context->owner ||
+      context->owner_count || context->in_check_or_prepare ||
+      context->crucible_callbacks ||
+      g_atomic_int_get (&context->crucible_control_active))
+    {
+      crucible_control_entry_unlock (context);
+      g_main_context_wakeup (context);
+      return FALSE;
+    }
+  count = control->source_count;
+  reader = control->reader;
+  sources = context->crucible_control_sources;
+  context->crucible_control_sources = NULL;
+  g_atomic_pointer_set (&context->crucible_control, NULL);
+  context->crucible_control_identity = (GCrucibleMainContextControlHold) { 0 };
+  context->owner = G_THREAD_SELF;
+  context->owner_count = 1;
+  *control = (GCrucibleMainContextControlHold) { 0 };
+  crucible_control_entry_unlock (context);
+  g_main_context_wakeup (context);
+
+  /* Source retirement/finalization callbacks always run outside both locks. */
+  for (guint index = 0; index < count; index++)
+    g_source_unref (sources[index].source);
+  g_free (sources);
+  g_thread_unref (reader);
+  return TRUE;
+}
+
+
+static gboolean
+crucible_control_retained_reference_unlocked (GMainContext *context, GSource *source)
+{
+  if (!context ||
+      (!context->crucible_control_retiring_refs &&
+       (!g_atomic_int_get (&context->crucible_control_active) ||
+        context->crucible_control_identity.reader != G_THREAD_SELF)) ||
+      !g_atomic_pointer_get (&context->crucible_control) ||
+      g_atomic_int_get (&source->ref_count) <= 1)
+    return FALSE;
+  for (guint index = 0; index < context->crucible_control_identity.source_count;
+       index++)
+    if (context->crucible_control_sources[index].source == source)
+      return TRUE;
+  return FALSE;
+}
