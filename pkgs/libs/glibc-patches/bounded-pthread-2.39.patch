+#include <pthread-bounded.h>
+#include <pthread-bounded-internal.h>
+#include <pthreadP.h>
+#include <dlfcn.h>
+#include <errno.h>
+#include <sched.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <sys/mman.h>
+#include <unistd.h>
+#include <support/check.h>
+#include <support/capture_subprocess.h>
+#include <sys/wait.h>
+#include <sys/syscall.h>
+#include <signal.h>
+#include <string.h>
+#include <locale.h>
+#include <resolv.h>
+#include <malloc.h>
+#include <support/support.h>
+#include <support/temp_file.h>
+#include <support/xthread.h>
+#include <shlib-compat.h>
+
+/* Obtain the shared loader layout after other headers, then access its
+   actual exported object through dlsym rather than a copy relocation.  */
+#define SHARED
+#include <ldsodefs.h>
+#undef SHARED
+#undef GL
+#define GL(name) (loader_state->_##name)
+
+static struct rtld_global *loader_state;
+
+#define ARENA_BYTES (128 * 1024)
+#define STACK_BYTES (1024 * 1024)
+#define MODULES 80
+
+extern int __cxa_thread_atexit_impl (void (*) (void *), void *, void *);
+extern void *__dso_handle;
+struct rpc_createerr;
+extern struct rpc_createerr *__rpc_thread_createerr (void);
+compat_symbol_reference (libc, __rpc_thread_createerr, __rpc_thread_createerr,
+                         GLIBC_2_0);
+
+struct fixture
+{
+  void *arena;
+  void *mapping;
+  size_t mapping_bytes;
+  pthread_attr_t attr;
+  pthread_bounded_t *owner;
+  uint64_t incarnation;
+  pthread_t thread;
+  unsigned int worker_finished;
+  struct pthread_bounded_receipt receipt;
+};
+
+struct worker_state
+{
+  pthread_barrier_t ready;
+  pthread_barrier_t loaded;
+  unsigned int destructor_entered;
+  unsigned int destructor_release;
+  unsigned int tsd_finished;
+  pthread_key_t key;
+  volatile uint64_t *stack_sentinel;
+  void *(*address[MODULES]) (void);
+};
+
+static struct pthread_bounded_config
+configuration (void)
+{
+  struct pthread_bounded_config config =
+    { .version = PTHREAD_BOUNDED_VERSION, .size = sizeof (config),
+      .flags = PTHREAD_BOUNDED_STRICT };
+  for (size_t i = 0; i < PTHREAD_BOUNDED_KINDS; ++i)
+    config.limit[i] = (struct pthread_bounded_limit) { 1, 512, 16 };
+  config.limit[PTHREAD_BOUNDED_DTV]
+    = (struct pthread_bounded_limit) { 4, 4096, 16 };
+  config.limit[PTHREAD_BOUNDED_DYNAMIC_TLS]
+    = (struct pthread_bounded_limit) { MODULES, 1024, 64 };
+  return config;
+}
+
+static struct fixture
+fixture (struct pthread_bounded_config *config)
+{
+  struct fixture result = { 0 };
+  size_t pagesize = sysconf (_SC_PAGESIZE);
+  result.mapping_bytes = STACK_BYTES + 2 * pagesize;
+  result.mapping = mmap (NULL, result.mapping_bytes, PROT_NONE,
+                         MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+  TEST_VERIFY_EXIT (result.mapping != MAP_FAILED);
+  TEST_COMPARE (mprotect ((char *) result.mapping + pagesize, STACK_BYTES,
+                          PROT_READ | PROT_WRITE), 0);
+
+  result.arena = mmap (NULL, ARENA_BYTES, PROT_READ | PROT_WRITE,
+                       MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+  TEST_VERIFY_EXIT (result.arena != MAP_FAILED);
+  TEST_COMPARE (pthread_bounded_init_np (result.arena, ARENA_BYTES,
+                                         config, &result.owner,
+                                         &result.incarnation), 0);
+
+  xpthread_attr_init (&result.attr);
+  /* The deliberately unaligned usable span exercises actual TCB/static
+     TLS placement and alignment, with guards outside the supplied span.  */
+  TEST_COMPARE (pthread_attr_setstack (&result.attr,
+                                       (char *) result.mapping + pagesize + 16,
+                                       STACK_BYTES - 32), 0);
+  return result;
+}
+
+static void
+release_fixture (struct fixture *fixture)
+{
+  TEST_VERIFY (fixture->receipt.backing_returned);
+  xpthread_attr_destroy (&fixture->attr);
+  TEST_COMPARE (munmap (fixture->arena, ARENA_BYTES), 0);
+  TEST_COMPARE (munmap (fixture->mapping, fixture->mapping_bytes), 0);
+}
+
+static void
+retire (struct fixture *fixture)
+{
+  int status;
+  do
+    {
+      status = pthread_bounded_tryretire_np (fixture->owner, fixture->incarnation, NULL,
+                                             &fixture->receipt);
+      if (status == EBUSY)
+        sched_yield ();
+    }
+  while (status == EBUSY);
+  TEST_COMPARE (status, 0);
+}
+
+static void *
+never_entered (void *argument)
+{
+  __atomic_store_n ((unsigned int *) argument, 1, __ATOMIC_RELEASE);
+  return argument;
+}
+
+static void
+test_unfunded_dtv (void)
+{
+  struct pthread_bounded_config config = configuration ();
+  config.limit[PTHREAD_BOUNDED_DTV].requests = 0;
+  struct fixture test = fixture (&config);
+  unsigned int entered = 0;
+
+  TEST_COMPARE (pthread_bounded_create_np
+                (test.owner, test.incarnation, &test.thread, &test.attr,
+                 never_entered, &entered, &test.receipt), EAGAIN);
+  TEST_COMPARE (test.receipt.clone_attempted, 0);
+  TEST_COMPARE (test.receipt.born, 0);
+  TEST_COMPARE (test.receipt.first_error, ENOMEM);
+  TEST_COMPARE (test.receipt.allocation[PTHREAD_BOUNDED_DTV].attempted, 1);
+  TEST_COMPARE (test.receipt.allocation[PTHREAD_BOUNDED_DTV].allocated, 0);
+
+  retire (&test);
+  TEST_COMPARE (entered, 0);
+  TEST_COMPARE (test.receipt.kernel_exited, 0);
+  TEST_COMPARE (test.receipt.joined, 0);
+  release_fixture (&test);
+}
+
+static void
+test_born_never_entered (void)
+{
+  struct pthread_bounded_config config = configuration ();
+  struct fixture test = fixture (&config);
+  cpu_set_t empty;
+  CPU_ZERO (&empty);
+  TEST_COMPARE (pthread_attr_setaffinity_np (&test.attr, sizeof (empty),
+                                            &empty), 0);
+  unsigned int entered = 0;
+
+  /* Linux rejects an empty effective CPU set only after clone.  This is a
+     deterministic real partial creation failure, independent of privilege.  */
+  TEST_COMPARE (pthread_bounded_create_np
+                (test.owner, test.incarnation, &test.thread, &test.attr,
+                 never_entered, &entered, &test.receipt), EINVAL);
+  TEST_COMPARE (test.receipt.clone_attempted, 1);
+  TEST_COMPARE (test.receipt.born, 1);
+
+  retire (&test);
+  TEST_COMPARE (entered, 0);
+  TEST_COMPARE (test.receipt.entered, 0);
+  TEST_COMPARE (test.receipt.kernel_exited, 1);
+  TEST_COMPARE (test.receipt.joined, 1);
+  TEST_COMPARE (test.receipt.exit_cleanup_completed, 0);
+  TEST_COMPARE (test.receipt.allocation[PTHREAD_BOUNDED_DTV].allocated, 1);
+  TEST_COMPARE (test.receipt.allocation[PTHREAD_BOUNDED_DTV].released, 1);
+  release_fixture (&test);
+}
+
+static void
+tls_destructor (void *argument)
+{
+  struct worker_state *state = argument;
+  __atomic_store_n (&state->destructor_entered, 1, __ATOMIC_RELEASE);
+  while (!__atomic_load_n (&state->destructor_release, __ATOMIC_ACQUIRE))
+    sched_yield ();
+}
+
+static void
+tsd_destructor (void *argument)
+{
+  struct worker_state *state = argument;
+  __atomic_store_n (&state->tsd_finished, 1, __ATOMIC_RELEASE);
+}
+
+static void *
+worker (void *argument)
+{
+  struct worker_state *state = argument;
+  _Alignas (16) volatile uint64_t sentinel[1024]
+    = { UINT64_C (0xa15c7e9d42b603f8) };
+  state->stack_sentinel = &sentinel[0];
+  xpthread_barrier_wait (&state->ready);
+  xpthread_barrier_wait (&state->loaded);
+
+  for (size_t i = 0; i < MODULES; ++i)
+    {
+      unsigned char *block = state->address[i] ();
+      TEST_VERIFY (((uintptr_t) block & 63) == 0);
+      TEST_COMPARE (block[0], 0);
+      block[0] = i + 1;
+    }
+  TEST_COMPARE (pthread_setspecific (state->key, state), 0);
+  TEST_COMPARE (__cxa_thread_atexit_impl
+                (tls_destructor, state, &__dso_handle), 0);
+  TEST_COMPARE (sentinel[0], UINT64_C (0xa15c7e9d42b603f8));
+  return state;
+}
+
+struct exhaustion_state
+{
+  pthread_key_t first;
+  pthread_key_t second;
+  unsigned int destructor_calls;
+  pthread_mutex_t priority;
+};
+
+static void
+count_destructor (void *argument)
+{
+  struct exhaustion_state *state = argument;
+  ++state->destructor_calls;
+}
+
+static void *
+exhaustion_worker (void *argument)
+{
+  struct exhaustion_state *state = argument;
+  TEST_COMPARE (pthread_setspecific (state->first, state), 0);
+  TEST_COMPARE (pthread_setspecific (state->second, state), ENOMEM);
+  TEST_COMPARE (__cxa_thread_atexit_impl
+                (count_destructor, state, &__dso_handle), 0);
+  TEST_COMPARE (__cxa_thread_atexit_impl
+                (count_destructor, state, &__dso_handle), ENOMEM);
+
+  int status = pthread_mutex_lock (&state->priority);
+  TEST_VERIFY (status == 0 || status == EINVAL);
+  if (status == 0)
+    TEST_COMPARE (pthread_mutex_unlock (&state->priority), 0);
+  return NULL;
+}
+
+static void
+test_enforced_requests (void)
+{
+  struct pthread_bounded_config config = configuration ();
+  struct fixture test = fixture (&config);
+  struct exhaustion_state state = { 0 };
+  pthread_key_t keys[65];
+  for (size_t i = 0; i < 65; ++i)
+    TEST_COMPARE (pthread_key_create (&keys[i], NULL), 0);
+  state.first = keys[32];
+  state.second = keys[64];
+
+  pthread_mutexattr_t attr;
+  TEST_COMPARE (pthread_mutexattr_init (&attr), 0);
+  TEST_COMPARE (pthread_mutexattr_setprotocol (&attr, PTHREAD_PRIO_PROTECT), 0);
+  TEST_COMPARE (pthread_mutexattr_setprioceiling (&attr, 1), 0);
+  TEST_COMPARE (pthread_mutex_init (&state.priority, &attr), 0);
+  TEST_COMPARE (pthread_mutexattr_destroy (&attr), 0);
+
+  TEST_COMPARE (pthread_bounded_create_np
+                (test.owner, test.incarnation, &test.thread, &test.attr,
+                 exhaustion_worker, &state, &test.receipt), 0);
+  retire (&test);
+  TEST_COMPARE (state.destructor_calls, 1);
+  TEST_COMPARE (test.receipt.allocation[PTHREAD_BOUNDED_TSD].attempted, 2);
+  TEST_COMPARE (test.receipt.allocation[PTHREAD_BOUNDED_TSD].allocated, 1);
+  TEST_COMPARE (test.receipt.allocation[PTHREAD_BOUNDED_TSD].released, 1);
+  TEST_COMPARE (test.receipt.allocation[PTHREAD_BOUNDED_TSD].first_error, ENOMEM);
+  TEST_COMPARE (test.receipt.allocation[PTHREAD_BOUNDED_DESTRUCTOR].attempted, 2);
+  TEST_COMPARE (test.receipt.allocation[PTHREAD_BOUNDED_DESTRUCTOR].allocated, 1);
+  TEST_COMPARE (test.receipt.allocation[PTHREAD_BOUNDED_DESTRUCTOR].released, 1);
+  TEST_COMPARE (test.receipt.allocation[PTHREAD_BOUNDED_PRIORITY].allocated, 1);
+  TEST_COMPARE (test.receipt.allocation[PTHREAD_BOUNDED_PRIORITY].released, 1);
+  TEST_COMPARE (pthread_mutex_destroy (&state.priority), 0);
+  for (size_t i = 0; i < 65; ++i)
+    TEST_COMPARE (pthread_key_delete (keys[i]), 0);
+  release_fixture (&test);
+}
+
+static void *
+fatal_tls_worker (void *argument)
+{
+  void *(*address) (void) = argument;
+  address ();
+  /* A normal return would prove that the admitted zero-request bound was
+     bypassed.  Exit with a distinct status rather than matching libc OOM.  */
+  _exit (99);
+}
+
+static void
+fatal_tls_child (void *argument)
+{
+  struct pthread_bounded_config config = configuration ();
+  config.limit[PTHREAD_BOUNDED_DYNAMIC_TLS].requests = 0;
+  struct fixture test = fixture (&config);
+  TEST_COMPARE (pthread_bounded_create_np
+                (test.owner, test.incarnation, &test.thread, &test.attr,
+                 fatal_tls_worker, argument, &test.receipt), 0);
+  for (;;)
+    pause ();
+}
+
+static void
+test_fatal_tls_exhaustion (void)
+{
+  char *path = xasprintf ("%s/nptl/tst-pthread-bounded-mod.so",
+                          support_objdir_root);
+  void *module = dlopen (path, RTLD_NOW | RTLD_LOCAL);
+  TEST_VERIFY_EXIT (module != NULL);
+  void *address = dlsym (module, "bounded_tls_address");
+  TEST_VERIFY_EXIT (address != NULL);
+
+  struct support_capture_subprocess capture
+    = support_capture_subprocess (fatal_tls_child, address);
+  TEST_VERIFY (WIFEXITED (capture.status));
+  TEST_COMPARE (WEXITSTATUS (capture.status), 127);
+  TEST_COMPARE_STRING
+    (capture.err.buffer,
+     "cannot allocate memory for thread-local data: ABORT\n");
+  support_capture_subprocess_free (&capture);
+  TEST_COMPARE (dlclose (module), 0);
+  free (path);
+}
+
+static void *
+fatal_rpc_worker (void *argument)
+{
+  __rpc_thread_createerr ();
+  _exit (99);
+}
+
+static void
+fatal_rpc_child (void *argument)
+{
+  struct pthread_bounded_config config = configuration ();
+  struct fixture test = fixture (&config);
+  TEST_COMPARE (pthread_bounded_create_np
+                (test.owner, test.incarnation, &test.thread, &test.attr,
+                 fatal_rpc_worker, NULL, &test.receipt), 0);
+  for (;;)
+    pause ();
+}
+
+static void
+test_fatal_rpc_refusal (void)
+{
+  struct support_capture_subprocess capture
+    = support_capture_subprocess (fatal_rpc_child, NULL);
+  TEST_VERIFY (WIFEXITED (capture.status));
+  TEST_COMPARE (WEXITSTATUS (capture.status), 127);
+  TEST_COMPARE_STRING (capture.err.buffer, "");
+  support_capture_subprocess_free (&capture);
+}
+
+static void
+test_terminal_and_growth (void)
+{
+  struct pthread_bounded_config config = configuration ();
+  struct fixture test = fixture (&config);
+  struct worker_state state = { 0 };
+  xpthread_barrier_init (&state.ready, NULL, 2);
+  xpthread_barrier_init (&state.loaded, NULL, 2);
+
+  pthread_key_t keys[33];
+  for (size_t i = 0; i < 33; ++i)
+    TEST_COMPARE (pthread_key_create (&keys[i], tsd_destructor), 0);
+  state.key = keys[32];
+
+  TEST_COMPARE (pthread_bounded_create_np
+                (test.owner, test.incarnation, &test.thread, &test.attr,
+                 worker, &state, &test.receipt), 0);
+  xpthread_barrier_wait (&state.ready);
+  TEST_COMPARE (pthread_join (test.thread, NULL), EINVAL);
+  TEST_COMPARE (pthread_detach (test.thread), EINVAL);
+  pthread_bounded_t *overlap;
+  uint64_t overlap_incarnation = 0;
+  uintptr_t stack_address = (uintptr_t) state.stack_sentinel;
+  uintptr_t overlap_base = stack_address;
+  struct pthread_bounded_config overlap_config = config;
+  for (size_t i = 0; i < PTHREAD_BOUNDED_KINDS; ++i)
+    overlap_config.limit[i].requests = 0;
+  TEST_VERIFY (overlap_base >= test.receipt.stack);
+  TEST_VERIFY (overlap_base + 4096
+               <= test.receipt.stack + test.receipt.stack_bytes);
+  TEST_COMPARE (pthread_bounded_init_np
+                ((void *) overlap_base, 4096, &overlap_config,
+                 &overlap, &overlap_incarnation), EBUSY);
+  TEST_COMPARE (*state.stack_sentinel, UINT64_C (0xa15c7e9d42b603f8));
+
+  /* Outputs from an independent canonical owner must not overwrite this
+     still-live stack.  Reject before a create attempt or terminal return.  */
+  struct fixture output_peer = fixture (&config);
+  struct pthread_bounded_receipt *peer_receipt
+    = (void *) state.stack_sentinel;
+  TEST_COMPARE (pthread_bounded_query_np
+                (output_peer.owner, output_peer.incarnation, peer_receipt),
+                EINVAL);
+  TEST_COMPARE (pthread_bounded_query_np
+                (output_peer.owner, output_peer.incarnation, test.arena),
+                EINVAL);
+  TEST_COMPARE (pthread_bounded_query_np
+                (test.owner, test.incarnation, &test.receipt), 0);
+  unsigned int output_entered = 0;
+  TEST_COMPARE (pthread_bounded_create_np
+                (output_peer.owner, output_peer.incarnation,
+                 (pthread_t *) state.stack_sentinel, &output_peer.attr,
+                 never_entered, &output_entered, &output_peer.receipt), EINVAL);
+  TEST_COMPARE (pthread_bounded_create_np
+                (output_peer.owner, output_peer.incarnation,
+                 &output_peer.thread, &output_peer.attr, never_entered,
+                 &output_entered, peer_receipt), EINVAL);
+  TEST_COMPARE (pthread_bounded_tryretire_np
+                (output_peer.owner, output_peer.incarnation,
+                 (void **) state.stack_sentinel, &output_peer.receipt), EINVAL);
+  TEST_COMPARE (pthread_bounded_tryretire_np
+                (output_peer.owner, output_peer.incarnation, NULL,
+                 peer_receipt), EINVAL);
+  TEST_COMPARE (pthread_bounded_query_np
+                (output_peer.owner, output_peer.incarnation,
+                 &output_peer.receipt), 0);
+  TEST_COMPARE (output_peer.receipt.create_attempted, 0);
+  TEST_COMPARE (output_peer.receipt.backing_returned, 0);
+
+  void *output_arena = mmap (NULL, ARENA_BYTES, PROT_READ | PROT_WRITE,
+                             MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+  TEST_VERIFY_EXIT (output_arena != MAP_FAILED);
+  TEST_COMPARE (pthread_bounded_init_np
+                (output_arena, ARENA_BYTES, &config,
+                 (pthread_bounded_t **) state.stack_sentinel,
+                 &overlap_incarnation), EINVAL);
+  TEST_COMPARE (pthread_bounded_init_np
+                (output_arena, ARENA_BYTES, &config, &overlap,
+                 (uint64_t *) state.stack_sentinel), EINVAL);
+  TEST_COMPARE (munmap (output_arena, ARENA_BYTES), 0);
+  TEST_COMPARE (*state.stack_sentinel, UINT64_C (0xa15c7e9d42b603f8));
+  retire (&output_peer);
+  release_fixture (&output_peer);
+
+  /* Copy the same real DSO to distinct inodes after thread creation.  Its
+     new module IDs force DTV growth and aligned dynamic TLS allocations.  */
+  size_t slot_lists_before = 0;
+  for (struct dtv_slotinfo_list *slots = GL (dl_tls_dtv_slotinfo_list);
+       slots != NULL; slots = slots->next)
+    ++slot_lists_before;
+  char *directory = support_create_temp_directory ("tst-pthread-bounded");
+  char *source = xasprintf ("%s/nptl/tst-pthread-bounded-mod.so",
+                            support_objdir_root);
+  void *handles[MODULES];
+  for (size_t i = 0; i < MODULES; ++i)
+    {
+      char *path = xasprintf ("%s/%zu.so", directory, i);
+      support_copy_file (source, path);
+      add_temp_file (path);
+      handles[i] = dlopen (path, RTLD_NOW | RTLD_LOCAL);
+      TEST_VERIFY_EXIT (handles[i] != NULL);
+      state.address[i] = dlsym (handles[i], "bounded_tls_address");
+      TEST_VERIFY_EXIT (state.address[i] != NULL);
+      free (path);
+    }
+  size_t slot_lists_after = 0;
+  for (struct dtv_slotinfo_list *slots = GL (dl_tls_dtv_slotinfo_list);
+       slots != NULL; slots = slots->next)
+    ++slot_lists_after;
+  TEST_VERIFY (slot_lists_after > slot_lists_before);
+  free (source);
+  free (directory);
+  xpthread_barrier_wait (&state.loaded);
+
+  while (!__atomic_load_n (&state.destructor_entered, __ATOMIC_ACQUIRE))
+    sched_yield ();
+  TEST_COMPARE (pthread_bounded_tryretire_np
+                (test.owner, test.incarnation, NULL, &test.receipt), EBUSY);
+  TEST_COMPARE (test.receipt.entered, 1);
+  TEST_COMPARE (test.receipt.exit_cleanup_completed, 0);
+  TEST_COMPARE (test.receipt.joined, 0);
+  TEST_COMPARE (test.receipt.backing_returned, 0);
+
+  pthread_bounded_t *another;
+  struct pthread_bounded_receipt copied = test.receipt;
+  copied.backing_returned = 1;
+  TEST_COMPARE (pthread_bounded_init_np
+                (test.arena, ARENA_BYTES, &config, &another, &test.incarnation), EBUSY);
+  TEST_COMPARE (pthread_bounded_query_np (test.owner, test.incarnation, &test.receipt), 0);
+  TEST_COMPARE (test.receipt.backing_returned, 0);
+  TEST_COMPARE (copied.backing_returned, 1);
+
+  struct fixture alias = fixture (&config);
+  TEST_COMPARE (pthread_attr_setstack (&alias.attr,
+                                       (void *) test.receipt.stack,
+                                       test.receipt.stack_bytes), 0);
+  unsigned int alias_entered = 0;
+  TEST_COMPARE (pthread_bounded_create_np
+                (alias.owner, alias.incarnation, &alias.thread, &alias.attr,
+                 never_entered, &alias_entered, &alias.receipt), EBUSY);
+  TEST_COMPARE (alias.receipt.clone_attempted, 0);
+  TEST_COMPARE (alias.receipt.born, 0);
+  retire (&alias);
+  TEST_COMPARE (alias_entered, 0);
+  release_fixture (&alias);
+
+  /* Hold the actual loader stack-list/cache lock across kernel exit.
+     Retirement must report an actual join and retained list/TLS debt.  */
+  int expected = 0;
+  while (!__atomic_compare_exchange_n (&GL (dl_stack_cache_lock), &expected,
+                                       1, false, __ATOMIC_ACQUIRE,
+                                       __ATOMIC_RELAXED))
+    {
+      expected = 0;
+      sched_yield ();
+    }
+  __atomic_store_n (&state.destructor_release, 1, __ATOMIC_RELEASE);
+  do
+    {
+      TEST_COMPARE (pthread_bounded_tryretire_np
+                    (test.owner, test.incarnation, NULL, &test.receipt), EBUSY);
+      sched_yield ();
+    }
+  while (!test.receipt.joined);
+
+  TEST_COMPARE (test.receipt.kernel_exited, 1);
+  TEST_COMPARE (test.receipt.list_linked, 1);
+  TEST_COMPARE (test.receipt.list_returned, 0);
+  TEST_COMPARE (test.receipt.tls_returned, 0);
+  TEST_COMPARE (test.receipt.backing_returned, 0);
+  TEST_COMPARE (test.receipt.exit_cleanup_completed, 1);
+  TEST_COMPARE (state.tsd_finished, 1);
+  TEST_COMPARE (pthread_bounded_tryretire_np
+                (test.owner, test.incarnation, test.arena, &test.receipt), EINVAL);
+  TEST_COMPARE (test.receipt.joined, 1);
+  TEST_COMPARE (test.receipt.backing_returned, 0);
+  __atomic_store_n (&GL (dl_stack_cache_lock), 0, __ATOMIC_RELEASE);
+
+  void *result = NULL;
+  TEST_COMPARE (pthread_bounded_tryretire_np
+                (test.owner, test.incarnation, &result, &test.receipt), 0);
+  TEST_VERIFY (result == &state);
+  TEST_COMPARE (test.receipt.first_error, EBUSY);
+  TEST_COMPARE (test.receipt.retire_status, 0);
+  TEST_COMPARE (test.receipt.list_returned, 1);
+  TEST_COMPARE (test.receipt.tls_returned, 1);
+  TEST_COMPARE (test.receipt.backing_returned, 1);
+  TEST_VERIFY (test.receipt.arena_used <= ARENA_BYTES);
+  TEST_COMPARE (test.receipt.stack_available_bytes
+                + test.receipt.stack_reserved_bytes, STACK_BYTES - 32);
+  TEST_VERIFY (test.receipt.stack_reserved_bytes >= sizeof (struct pthread));
+  TEST_VERIFY (test.receipt.allocation[PTHREAD_BOUNDED_DTV].allocated >= 2);
+  TEST_COMPARE (test.receipt.allocation[PTHREAD_BOUNDED_DYNAMIC_TLS].allocated,
+                MODULES);
+  TEST_COMPARE (test.receipt.allocation[PTHREAD_BOUNDED_TSD].allocated, 1);
+  TEST_COMPARE (test.receipt.allocation[PTHREAD_BOUNDED_DESTRUCTOR].allocated, 1);
+  for (size_t i = 0; i < PTHREAD_BOUNDED_KINDS; ++i)
+    TEST_COMPARE (test.receipt.allocation[i].allocated,
+                  test.receipt.allocation[i].released);
+
+  uint64_t incarnation = test.receipt.incarnation;
+  TEST_COMPARE (pthread_bounded_init_np
+                (test.arena, ARENA_BYTES, &config, &test.owner,
+                 &test.incarnation), 0);
+  TEST_COMPARE (pthread_bounded_query_np (test.owner, test.incarnation, &test.receipt), 0);
+  TEST_VERIFY (test.receipt.incarnation > incarnation);
+  TEST_COMPARE (pthread_bounded_query_np
+                (test.owner, incarnation, &test.receipt), ESTALE);
+  TEST_COMPARE (pthread_bounded_tryretire_np
+                (test.owner, incarnation, NULL, &test.receipt), ESTALE);
+  retire (&test);
+  release_fixture (&test);
+
+  for (size_t i = 0; i < MODULES; ++i)
+    TEST_COMPARE (dlclose (handles[i]), 0);
+  for (size_t i = 0; i < 33; ++i)
+    TEST_COMPARE (pthread_key_delete (keys[i]), 0);
+  xpthread_barrier_destroy (&state.ready);
+  xpthread_barrier_destroy (&state.loaded);
+}
+
+static void *
+strict_refusal_worker (void *argument)
+{
+  /* The test disables allocator builtins so these reach the real entry
+     points even when only their failure result is observed.  */
+  errno = 0;
+  TEST_VERIFY (malloc (16) == NULL);
+  TEST_COMPARE (errno, ENOTSUP);
+  TEST_VERIFY (calloc (1, 16) == NULL);
+  TEST_COMPARE (errno, ENOTSUP);
+  TEST_VERIFY (realloc (NULL, 16) == NULL);
+  TEST_COMPARE (errno, ENOTSUP);
+  TEST_VERIFY (memalign (64, 64) == NULL);
+  TEST_VERIFY (aligned_alloc (64, 64) == NULL);
+  TEST_VERIFY (valloc (16) == NULL);
+  TEST_VERIFY (pvalloc (16) == NULL);
+  void *aligned = argument;
+  TEST_COMPARE (posix_memalign (&aligned, 64, 64), ENOTSUP);
+  TEST_VERIFY (aligned == argument);
+  TEST_COMPARE (malloc_trim (0), 0);
+  TEST_COMPARE (errno, ENOTSUP);
+
+  TEST_VERIFY (strsignal (SIGRTMIN) == NULL);
+  TEST_COMPARE (errno, ENOTSUP);
+  TEST_COMPARE_STRING (strerror_l (99999, LC_GLOBAL_LOCALE),
+                       "Error formatting is unavailable in a bounded thread");
+  TEST_COMPARE (errno, ENOTSUP);
+  TEST_COMPARE (res_init (), -1);
+  TEST_COMPARE (errno, ENOTSUP);
+  TEST_VERIFY (dlopen ("nonexistent-bounded-module", RTLD_NOW) == NULL);
+  TEST_COMPARE (errno, ENOTSUP);
+  TEST_COMPARE_STRING
+    (dlerror (), "Dynamic loader operations are unavailable in a bounded thread");
+  struct fixture *test = argument;
+  __atomic_store_n (&test->worker_finished, 1, __ATOMIC_RELEASE);
+  return NULL;
+}
+
+static void
+test_strict_refusals (void)
+{
+  struct pthread_bounded_config config = configuration ();
+  struct fixture test = fixture (&config);
+  TEST_COMPARE (pthread_bounded_create_np
+                (test.owner, test.incarnation, &test.thread, &test.attr,
+                 strict_refusal_worker, &test, &test.receipt), 0);
+  while (!__atomic_load_n (&test.worker_finished, __ATOMIC_ACQUIRE))
+    sched_yield ();
+  TEST_COMPARE (pthread_bounded_query_np
+                (test.owner, test.incarnation, &test.receipt), 0);
+  TEST_VERIFY (test.receipt.allocator_refusals >= 14);
+  retire (&test);
+  TEST_VERIFY (test.receipt.allocator_refusals >= 14);
+  TEST_COMPARE (test.receipt.foreign_free_refusals, 0);
+  TEST_COMPARE (test.receipt.cleanup_blocked, 0);
+  TEST_COMPARE (test.receipt.exit_cleanup_completed, 1);
+  TEST_COMPARE (test.receipt.first_error, ENOTSUP);
+  TEST_COMPARE (test.receipt.backing_returned, 1);
+  release_fixture (&test);
+}
+
+static void *
+foreign_free_worker (void *argument)
+{
+  free (argument);
+  return NULL;
+}
+
+static void *
+unknown_tail_worker (void *argument)
+{
+  /* Supply a real ordinary allocation owned outside this bounded thread.
+     The exit guard must retain it before any ordinary free or lock.  */
+  THREAD_SELF->tls_state.strsignal_buf = argument;
+  return NULL;
+}
+
+static void *
+raw_exit_worker (void *argument)
+{
+  INTERNAL_SYSCALL_CALL (exit, 0);
+  __builtin_unreachable ();
+}
+
+static void *
+foreign_tls_worker (void *argument)
+{
+  /* Inject a foreign ownership claim into the real DTV released by the
+     terminal provider.  Equal arena counters cannot justify this return.  */
+  dtv_t *dtv = THREAD_DTV ();
+  TEST_VERIFY (dtv[1].pointer.to_free == NULL);
+  dtv[1].pointer.to_free = argument;
+  return NULL;
+}
+
+static void
+retained_debt_child (void *argument)
+{
+  uintptr_t scenario = (uintptr_t) argument;
+  struct pthread_bounded_config config = configuration ();
+  struct fixture test = fixture (&config);
+  unsigned char *foreign = malloc (16);
+  TEST_VERIFY_EXIT (foreign != NULL);
+  memset (foreign, 0x42, 16);
+  void *(*start) (void *) = scenario == 0 ? foreign_free_worker
+                            : scenario == 1 ? unknown_tail_worker
+                            : scenario == 2 ? raw_exit_worker
+                                            : foreign_tls_worker;
+  TEST_COMPARE (pthread_bounded_create_np
+                (test.owner, test.incarnation, &test.thread, &test.attr,
+                 start, foreign, &test.receipt), 0);
+  int status;
+  do
+    {
+      status = pthread_bounded_tryretire_np
+        (test.owner, test.incarnation, NULL, &test.receipt);
+      if (status == EBUSY)
+        sched_yield ();
+    }
+  while (status == EBUSY);
+
+  TEST_COMPARE (status, scenario == 0 ? ENOTSUP : EPROTO);
+  TEST_COMPARE (test.receipt.kernel_exited, 1);
+  TEST_COMPARE (test.receipt.joined, 1);
+  TEST_COMPARE (test.receipt.backing_returned, 0);
+  TEST_COMPARE (test.receipt.stack_returned, 0);
+  TEST_COMPARE (test.receipt.registration_returned, 0);
+  TEST_COMPARE (test.receipt.list_returned, scenario == 3);
+  TEST_COMPARE (test.receipt.tls_returned, 0);
+  if (scenario == 0)
+    {
+      TEST_COMPARE (test.receipt.foreign_free_refusals, 1);
+      TEST_VERIFY (test.receipt.first_refused_free == (uintptr_t) foreign);
+    }
+  if (scenario == 1 || scenario == 3)
+    TEST_COMPARE (test.receipt.cleanup_blocked, 1);
+  if (scenario == 3)
+    {
+      TEST_COMPARE (test.receipt.exit_cleanup_completed, 1);
+      TEST_COMPARE (test.receipt.allocation[PTHREAD_BOUNDED_DTV].allocated,
+                    test.receipt.allocation[PTHREAD_BOUNDED_DTV].released);
+    }
+  for (size_t i = 0; i < 16; ++i)
+    TEST_COMPARE (foreign[i], 0x42);
+
+  pthread_bounded_t *another;
+  uint64_t incarnation;
+  TEST_COMPARE (pthread_bounded_init_np
+                (test.arena, ARENA_BYTES, &config, &another, &incarnation), EBUSY);
+  /* Deliberately retained debt has no invented cancellation receipt.
+     This subprocess's actual process reap is its containing return.  */
+}
+
+static void
+test_retained_unknown_debt (void)
+{
+  for (uintptr_t scenario = 0; scenario < 4; ++scenario)
+    {
+      struct support_capture_subprocess capture
+        = support_capture_subprocess (retained_debt_child, (void *) scenario);
+      TEST_VERIFY (WIFEXITED (capture.status));
+      TEST_COMPARE (WEXITSTATUS (capture.status), 0);
+      TEST_COMPARE_STRING (capture.err.buffer, "");
+      support_capture_subprocess_free (&capture);
+    }
+}
+
+struct refusal_contention
+{
+  pthread_barrier_t barrier;
+  pthread_bounded_t *owner;
+};
+
+static void *
+record_refusal (void *argument)
+{
+  struct refusal_contention *state = argument;
+  xpthread_barrier_wait (&state->barrier);
+  for (size_t i = 0; i < 10000; ++i)
+    __pthread_bounded_refuse_heap (state->owner, NULL);
+  return NULL;
+}
+
+static void
+test_refusal_contention (void)
+{
+  struct pthread_bounded_config config = configuration ();
+  struct fixture test = fixture (&config);
+  struct refusal_contention state = { .owner = test.owner };
+  xpthread_barrier_init (&state.barrier, NULL, 2);
+  pthread_t first = xpthread_create (NULL, record_refusal, &state);
+  pthread_t second = xpthread_create (NULL, record_refusal, &state);
+  xpthread_join (first);
+  xpthread_join (second);
+  TEST_COMPARE (pthread_bounded_query_np
+                (test.owner, test.incarnation, &test.receipt), 0);
+  TEST_VERIFY (test.receipt.allocator_refusals > 0);
+  TEST_VERIFY (test.receipt.allocator_refusals <= 20000);
+  TEST_COMPARE (test.receipt.first_error, ENOTSUP);
+
+  /* This internal control injects the saturation boundary, then executes
+     the real recording helper.  Identity and history must never wrap.  */
+  test.owner->fact.allocator_refusals = SIZE_MAX - 1;
+  __pthread_bounded_refuse_heap (test.owner, NULL);
+  __pthread_bounded_refuse_heap (test.owner, NULL);
+  TEST_COMPARE (test.owner->fact.allocator_refusals, SIZE_MAX);
+  retire (&test);
+  TEST_COMPARE (test.receipt.backing_returned, 1);
+  xpthread_barrier_destroy (&state.barrier);
+  release_fixture (&test);
+}
+
+static pthread_bounded_t *release_signal_owner;
+static void *release_signal_pointer;
+static volatile sig_atomic_t release_signal_refused;
+
+static void
+release_signal_handler (int signal_number)
+{
+  release_signal_refused
+    = !__pthread_bounded_release (release_signal_owner, release_signal_pointer);
+}
+
+static void
+release_debt_child (void *argument)
+{
+  uintptr_t scenario = (uintptr_t) argument;
+  struct pthread_bounded_config config = configuration ();
+  struct fixture test = fixture (&config);
+  void *pointer = __pthread_bounded_allocate
+    (test.owner, PTHREAD_BOUNDED_TSD, 64, 16);
+  TEST_VERIFY_EXIT (pointer != NULL);
+
+  if (scenario == 0)
+    {
+      struct sigaction action = { .sa_handler = release_signal_handler };
+      sigemptyset (&action.sa_mask);
+      TEST_COMPARE (sigaction (SIGUSR1, &action, NULL), 0);
+      release_signal_owner = test.owner;
+      release_signal_pointer = pointer;
+      release_signal_refused = 0;
+
+      /* Interrupt the actual allocation/release exclusion cut.  The handler
+         must return instead of waiting behind the interrupted operation.  */
+      atomic_store_release (&test.owner->allocation_lock, 1);
+      TEST_COMPARE (raise (SIGUSR1), 0);
+      TEST_COMPARE (release_signal_refused, 1);
+      TEST_COMPARE (test.owner->fact.allocation[PTHREAD_BOUNDED_TSD].released, 0);
+      atomic_store_release (&test.owner->allocation_lock, 0);
+      TEST_VERIFY (__pthread_bounded_release (test.owner, pointer));
+      TEST_COMPARE (test.owner->fact.first_error, EBUSY);
+    }
+  else if (scenario == 1)
+    {
+      TEST_VERIFY (__pthread_bounded_release (test.owner, pointer));
+      TEST_VERIFY (!__pthread_bounded_release (test.owner, pointer));
+      TEST_COMPARE (test.owner->fact.allocation[PTHREAD_BOUNDED_TSD].released, 1);
+    }
+  else
+    {
+      void *invalid;
+      if (scenario == 2)
+        invalid = (char *) pointer + 1;
+      else if (scenario == 3)
+        invalid = (char *) test.owner + sizeof (*test.owner);
+      else if (scenario == 4)
+        invalid = (char *) test.arena + test.owner->fact.arena_used + 16;
+      else
+        {
+          struct __pthread_bounded_block *block
+            = (struct __pthread_bounded_block *) pointer - 1;
+          block->size = SIZE_MAX;
+          invalid = pointer;
+        }
+      TEST_VERIFY (!__pthread_bounded_release (test.owner, invalid));
+      TEST_COMPARE (test.owner->fact.allocation[PTHREAD_BOUNDED_TSD].released, 0);
+    }
+
+  TEST_COMPARE (pthread_bounded_tryretire_np
+                (test.owner, test.incarnation, NULL, &test.receipt), EPROTO);
+  TEST_COMPARE (test.receipt.cleanup_blocked, 1);
+  TEST_COMPARE (test.receipt.registration_returned, 0);
+  TEST_COMPARE (test.receipt.backing_returned, 0);
+  TEST_COMPARE (test.owner->allocation_lock, 0);
+  /* Even a later successful logical release cannot erase uncertainty.
+     Actual subprocess reap is the containing return for this debt.  */
+}
+
+static void
+test_release_debt (void)
+{
+  for (uintptr_t scenario = 0; scenario < 6; ++scenario)
+    {
+      struct support_capture_subprocess capture
+        = support_capture_subprocess (release_debt_child, (void *) scenario);
+      TEST_VERIFY (WIFEXITED (capture.status));
+      TEST_COMPARE (WEXITSTATUS (capture.status), 0);
+      TEST_COMPARE_STRING (capture.err.buffer, "");
+      support_capture_subprocess_free (&capture);
+    }
+}
+
+static int
+do_test (void)
+{
+  loader_state = dlsym (RTLD_DEFAULT, "_rtld_global");
+  TEST_VERIFY_EXIT (loader_state != NULL);
+  printf ("bounded layout: control=%zu block=%zu config=%zu receipt=%zu "
+          "pthread=%zu\n", sizeof (pthread_bounded_t),
+          sizeof (struct __pthread_bounded_block),
+          sizeof (struct pthread_bounded_config),
+          sizeof (struct pthread_bounded_receipt), sizeof (struct pthread));
+  struct pthread_bounded_receipt receipt;
+  TEST_COMPARE (pthread_bounded_query_np
+                ((pthread_bounded_t *) (uintptr_t) 1, 1, &receipt), ESRCH);
+  test_refusal_contention ();
+  test_release_debt ();
+  test_unfunded_dtv ();
+  test_born_never_entered ();
+  test_enforced_requests ();
+  test_strict_refusals ();
+  test_retained_unknown_debt ();
+  test_terminal_and_growth ();
+  test_fatal_tls_exhaustion ();
+  test_fatal_rpc_refusal ();
+  return 0;
+}
