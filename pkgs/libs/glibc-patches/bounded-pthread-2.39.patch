+struct malloc_bounded_failstop
+{
+  unsigned int version;
+  unsigned int size;
+  uint64_t incarnation;
+  uint64_t attachment;
+  uint64_t scope;
+  uint64_t end_scope;
+  uint64_t begin_attempts;
+  uint64_t end_attempts;
+  int first_error;
+  int begin_status;
+  int end_status;
+  unsigned int active;
+  unsigned int ended;
+  unsigned int abandoned;
+};
+
+/* Snapshot only: neither this receipt nor a token creates parent authority.
+   libc_custody_returned ends libc access; it does not return reusable backing
+   or perform the caller's independent containing-owner return operation.
+   Every admitted address extent stays quarantined until process reap: the
+   caller must retain its VA reservation, even after libc returns custody.
