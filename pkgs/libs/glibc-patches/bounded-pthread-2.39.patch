+  (malloc_bounded_t *, uint64_t, uint64_t *) __THROW;
+extern int malloc_bounded_detach_np
+  (malloc_bounded_t *, uint64_t, uint64_t) __THROW;
+extern int malloc_bounded_attachment_np
+  (malloc_bounded_t *, uint64_t, uint64_t,
+   struct malloc_bounded_attachment *) __THROW;
