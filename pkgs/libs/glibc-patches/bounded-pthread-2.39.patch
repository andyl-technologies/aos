+#if TLS_TCB_AT_TP
+          char *available_top = (char *) (pd + 1) - tls_static_size_for_stack;
+#else
+          char *available_top = (char *) (pd - 1);
+#endif
+          bounded->fact.stack_available_bytes
+            = available_top - (char *) pd->stackblock;
+          bounded->fact.stack_reserved_bytes
+            = size - bounded->fact.stack_available_bytes;
+        }
+
       /* Allocate the DTV for this thread.  */
       if (_dl_allocate_tls (TLS_TPADJ (pd)) == NULL)
 	{
+	  /* The bounded loader allocator has no libc errno-producing heap
+	     call.  rtld's private errno must not be read as libc errno.  */
+	  if (bounded != NULL)
+	    return ENOMEM;
