+/* Explicit failure behavior for one audited no-fail invocation.  Counts are
+   saturating diagnostic lower bounds; SCOPE never wraps or repeats within
+   an attachment.  Historical errors do not clear successful scope facts.  */
+#define MALLOC_BOUNDED_FAILSTOP_STATUS 127
