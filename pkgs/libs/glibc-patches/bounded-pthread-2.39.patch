+    return EBUSY;
+
+  if (!__pthread_bounded_external_span_locked (control, sizeof (*control))
+      || !__pthread_bounded_external_span_locked (incarnation_out,
+                                                  sizeof (*incarnation_out))
+      || spans_overlap ((uintptr_t) control, sizeof (*control),
+                         (uintptr_t) incarnation_out, sizeof (*incarnation_out)))
+    {
+      atomic_store_release (&__pthread_bounded_registration_lock, 0);
+      return EINVAL;
+    }
+
+  if (!__pthread_bounded_external_span_locked (backing, bytes))
+    {
+      atomic_store_release (&__pthread_bounded_registration_lock, 0);
+      return EBUSY;
+    }
