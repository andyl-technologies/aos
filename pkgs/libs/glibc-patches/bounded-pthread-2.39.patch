+
+#include <malloc-bounded.h>
+#include <malloc-bounded-internal.h>
+#include <pthread-bounded-internal.h>
+#include <support/check.h>
+#include <support/capture_subprocess.h>
+#include <support/xthread.h>
+#include <atomic.h>
+#include <errno.h>
+#include <malloc.h>
+#include <sched.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+#define BACKING_BYTES (1024 * 1024)
+
+struct fixture
+{
+  void *backing;
+  malloc_bounded_t *owner;
+  uint64_t incarnation;
+};
+
+static struct malloc_bounded_config
+configuration (size_t requests)
+{
+  return (struct malloc_bounded_config)
+    { MALLOC_BOUNDED_VERSION, sizeof (struct malloc_bounded_config),
+      requests, 256, 4096, 8 };
+}
+
+static struct fixture
+fixture (size_t requests)
+{
+  struct fixture f = { 0 };
+  f.backing = mmap (NULL, BACKING_BYTES, PROT_READ | PROT_WRITE,
+                     MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+  TEST_VERIFY_EXIT (f.backing != MAP_FAILED);
+  struct malloc_bounded_config config = configuration (requests);
+  TEST_COMPARE (malloc_bounded_init_np (f.backing, BACKING_BYTES, &config,
+                                       &f.owner, &f.incarnation), 0);
+  return f;
+}
+
+static void
+retire (struct fixture *f)
+{
+  struct malloc_bounded_receipt fact;
+  TEST_COMPARE (malloc_bounded_tryretire_np (f->owner, f->incarnation, &fact), 0);
+  TEST_COMPARE (fact.live, 0);
+  TEST_COMPARE (fact.attached, 0);
+  TEST_COMPARE (fact.libc_custody_returned, 1);
+  TEST_COMPARE (fact.registration_removed, 1);
+  TEST_COMPARE (fact.address_quarantined, 1);
+  /* Keep the actual address reservation through process reap.  */
+  TEST_COMPARE (mprotect (f->backing, BACKING_BYTES, PROT_NONE), 0);
+}
+
+struct process_observation
+{
+  malloc_bounded_process_t *owner;
+  pid_t process;
+};
+
+static void
+fork_process_control (void *argument)
+{
+  struct process_observation *parent = argument;
+  struct malloc_bounded_process_info info, saved;
+  memset (&info, 0x5a, sizeof (info));
+  memcpy (&saved, &info, sizeof (info));
+  /* The inherited numeric address is unchanged; actual process binding is
+     not.  Neither a fresh query nor the child's PID grants adoption.  */
+  TEST_VERIFY (malloc_bounded_process_np () == parent->owner);
+  TEST_COMPARE (malloc_bounded_process_current_np (parent->owner,
+                                                   parent->process, &info),
+                ESTALE);
+  TEST_COMPARE (memcmp (&info, &saved, sizeof (info)), 0);
+  TEST_COMPARE (malloc_bounded_process_current_np (parent->owner, getpid (),
+                                                   &info), 0);
+  TEST_COMPARE (info.process, getpid ());
+}
+
+static void
+process_controls (void)
+{
+  malloc_bounded_process_t *owner = malloc_bounded_process_np ();
+  struct malloc_bounded_process_info info, saved;
+  TEST_VERIFY_EXIT (owner != NULL);
+  TEST_VERIFY (malloc_bounded_process_np () == owner);
+  TEST_COMPARE (malloc_bounded_process_current_np (owner, getpid (), &info), 0);
+  TEST_VERIFY (info.owner == owner);
+  TEST_COMPARE (info.version, MALLOC_BOUNDED_PROCESS_VERSION);
+  TEST_COMPARE (info.size, sizeof (info));
+  TEST_COMPARE (info.objects, MALLOC_BOUNDED_PROCESS_OBJECTS);
+  TEST_COMPARE (info.application_capacity, 128);
+  TEST_COMPARE (info.pthread_capacity, __PTHREAD_BOUNDED_REGISTRATIONS);
+
+  struct malloc_bounded_layout layout;
+  TEST_COMPARE (malloc_bounded_layout_np (&layout), 0);
+  size_t total = 0;
+  unsigned int kinds = 0;
+  for (size_t i = 0; i < info.objects; ++i)
+    {
+      struct malloc_bounded_process_object object = info.object[i];
+      TEST_COMPARE (object.reserved, 0);
+      TEST_VERIFY_EXIT (object.kind >= MALLOC_BOUNDED_PROCESS_APPLICATION
+                        && object.kind <= MALLOC_BOUNDED_PROCESS_IDENTITY);
+      TEST_VERIFY ((kinds & (1u << object.kind)) == 0);
+      kinds |= 1u << object.kind;
+      TEST_VERIFY_EXIT (object.bytes != 0 && object.alignment != 0);
+      TEST_COMPARE (object.base % object.alignment, 0);
+      TEST_VERIFY (!__builtin_add_overflow (total, object.bytes, &total));
+      if (object.kind == MALLOC_BOUNDED_PROCESS_PTHREAD)
+        {
+          TEST_COMPARE (object.base,
+                         (uintptr_t) &__pthread_bounded_process_registry);
+          TEST_COMPARE (object.bytes,
+                         sizeof (__pthread_bounded_process_registry));
+          TEST_COMPARE (object.alignment,
+                         _Alignof (struct __pthread_bounded_registry));
+        }
+      if (object.kind == MALLOC_BOUNDED_PROCESS_IDENTITY)
+        TEST_COMPARE (object.base, (uintptr_t) owner);
+
+      /* Test the actual whole object, including padding and immutable
+         identity bytes.  Every nominated output refuses before a write.  */
+      unsigned char bytes[16384];
+      TEST_VERIFY_EXIT (object.bytes <= sizeof (bytes));
+      memcpy (bytes, (void *) object.base, object.bytes);
+      TEST_COMPARE (malloc_bounded_process_current_np (owner, getpid (),
+                      (void *) object.base), EINVAL);
+      TEST_COMPARE (malloc_bounded_layout_np ((void *) object.base), EINVAL);
+      TEST_COMPARE (malloc_bounded_layout_np
+                      ((void *) (object.base + object.bytes - 1)), EINVAL);
+      if (object.bytes >= layout.control_bytes)
+        {
+          struct malloc_bounded_config config = configuration (0);
+          config.attachments = 0;
+          malloc_bounded_t *child = (void *) 1;
+          uint64_t incarnation = UINT64_MAX;
+          TEST_COMPARE (malloc_bounded_init_np ((void *) object.base,
