+   <https://www.gnu.org/licenses/>.  */
+
+#ifndef _PTHREAD_BOUNDED_INTERNAL_H
+#define _PTHREAD_BOUNDED_INTERNAL_H 1
+
+#include <pthread-bounded.h>
+#include <atomic.h>
+#include <errno.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <string.h>
+#include <tls.h>
+#include <sys/single_threaded.h>
+
+#define PTHREAD_BOUNDED_MAGIC UINT64_C (0x6270746872656164)
+
+enum __pthread_bounded_state
+{
+  __PTHREAD_BOUNDED_READY,
+  __PTHREAD_BOUNDED_CREATING,
+  __PTHREAD_BOUNDED_ACTIVE,
+  __PTHREAD_BOUNDED_NO_BIRTH,
+  __PTHREAD_BOUNDED_FAILED_BIRTH,
+  __PTHREAD_BOUNDED_RETIRED
+};
+
+/* This control is part of the actual containing allocation.  It cannot be
+   copied to transfer custody.  The parent/child ownership handoff is the
+   pthread creation handoff; retirement only inspects child-written data
+   after the acquire observation of the kernel's clear-child-tid store.  */
+struct __pthread_bounded
+{
+  uint64_t magic;
+  uintptr_t self;
+  int lock;
+  int allocation_lock;
+  enum __pthread_bounded_state state;
+  struct pthread *pd;
+  struct pthread_bounded_config config;
+  struct pthread_bounded_receipt fact;
+};
+
+/* libc may allocate during startup before a thread pointer exists.  An
+   explicit bounded birth is possible only after NPTL has completed its
+   single-to-multithreaded initialization.  */
+static inline struct __pthread_bounded *
+__pthread_bounded_current (void)
+{
+#if IS_IN (libc)
+  if (!__libc_single_threaded_internal)
+    return THREAD_SELF->bounded;
+#endif
+  return NULL;
+}
+
+struct __pthread_bounded_block
+{
+  struct __pthread_bounded *owner;
+  size_t size;
+  enum pthread_bounded_kind kind;
+  bool released;
+};
+
+static inline void
+__pthread_bounded_error (struct __pthread_bounded *owner, int error)
+{
+  int expected = 0;
+  __atomic_compare_exchange_n (&owner->fact.first_error, &expected, error,
+                               false, __ATOMIC_RELAXED, __ATOMIC_RELAXED);
+}
+
+/* Unsupported ordinary allocator requests are distinct from the scoped
+   TLS/control inventory.  Counters are monotonic lower bounds: a failed
+   strong CAS means another increment already recorded a positive refusal.
+   There is one attempt, no retry, and no wrap at saturation.  */
+static inline void
+__pthread_bounded_refuse_heap (struct __pthread_bounded *owner, void *pointer)
+{
+  size_t *counter = pointer == NULL ? &owner->fact.allocator_refusals
+                                   : &owner->fact.foreign_free_refusals;
+  size_t value = atomic_load_relaxed (counter);
+  if (value != SIZE_MAX)
+    __atomic_compare_exchange_n (counter, &value, value + 1, false,
+                                  __ATOMIC_RELAXED, __ATOMIC_RELAXED);
+
+  if (pointer != NULL)
+    {
+      uintptr_t expected = 0;
+      __atomic_compare_exchange_n (&owner->fact.first_refused_free, &expected,
+                                    (uintptr_t) pointer, false,
+                                    __ATOMIC_RELAXED, __ATOMIC_RELAXED);
+    }
+  __pthread_bounded_error (owner, ENOTSUP);
+}
+
+/* Try-locking also bounds signal-handler reentry: it refuses rather than
+   corrupting a partially constructed block or spinning behind itself.  */
+static inline void *
+__pthread_bounded_allocate (struct __pthread_bounded *owner,
+                            enum pthread_bounded_kind kind,
+                            size_t bytes, size_t alignment)
+{
+  struct pthread_bounded_allocation_fact *fact = &owner->fact.allocation[kind];
+  const struct pthread_bounded_limit *limit = &owner->config.limit[kind];
+  int error = ENOMEM;
+
+  if (atomic_exchange_acquire (&owner->allocation_lock, 1) != 0)
+    {
+      __pthread_bounded_error (owner, EBUSY);
+      return NULL;
+    }
+
+  if (fact->attempted == SIZE_MAX)
+    goto failed;
+  atomic_fetch_add_relaxed (&fact->attempted, 1);
+
+  if (alignment == 0 || (alignment & (alignment - 1)) != 0
+      || alignment > limit->alignment || bytes > limit->request_bytes
+      || fact->allocated >= limit->requests)
+    goto failed;
+
+  if (alignment < _Alignof (struct __pthread_bounded_block))
+    alignment = _Alignof (struct __pthread_bounded_block);
+
+  size_t used = owner->fact.arena_used;
+  size_t capacity = owner->fact.backing_bytes;
+  size_t prefix = sizeof (struct __pthread_bounded_block);
+  uintptr_t base = owner->fact.backing;
+
+  if (used > capacity || prefix > capacity - used
+      || alignment - 1 > capacity - used - prefix)
+    goto failed;
+
+  uintptr_t address = (base + used + prefix + alignment - 1)
+                      & ~(uintptr_t) (alignment - 1);
+  size_t offset = address - base;
+  if (offset > capacity || bytes > capacity - offset)
+    goto failed;
+
+  struct __pthread_bounded_block *block
+    = (struct __pthread_bounded_block *) address - 1;
+  *block = (struct __pthread_bounded_block)
+    { owner, bytes, kind, false };
+  atomic_store_relaxed (&owner->fact.arena_used, offset + bytes);
+  atomic_fetch_add_relaxed (&fact->allocated, 1);
+  atomic_fetch_add_relaxed (&fact->bytes, bytes);
+  memset ((void *) address, 0, bytes);
+  atomic_store_release (&owner->allocation_lock, 0);
+  return (void *) address;
+
+ failed:
+  if (fact->first_error == 0)
+    atomic_store_relaxed (&fact->first_error, error);
+  __pthread_bounded_error (owner, error);
+  atomic_store_release (&owner->allocation_lock, 0);
+  return NULL;
+}
+
+/* Storage stays physically consumed until retirement.  No ordinary free,
+   allocator cache, callback, lock, or heap fallback is reached here.  */
+static inline bool
+__pthread_bounded_release (struct __pthread_bounded *owner, void *pointer)
+{
+  if (pointer == NULL)
+    return true;
+
+  uintptr_t address = (uintptr_t) pointer;
+  uintptr_t base = owner->fact.backing;
+  size_t prefix = sizeof (struct __pthread_bounded_block);
+  if (address < base || address - base < sizeof (*owner) + prefix
+      || address - base > owner->fact.arena_used)
+    {
+      atomic_store_release (&owner->fact.cleanup_blocked, 1);
+      __pthread_bounded_error (owner, EPROTO);
+      return false;
+    }
+
+  struct __pthread_bounded_block *block
+    = (struct __pthread_bounded_block *) pointer - 1;
+  if (block->owner != owner || block->released
+      || block->kind >= PTHREAD_BOUNDED_KINDS)
+    {
+      atomic_store_release (&owner->fact.cleanup_blocked, 1);
+      __pthread_bounded_error (owner, EPROTO);
+      return false;
+    }
+
+  block->released = true;
+  atomic_fetch_add_relaxed (&owner->fact.allocation[block->kind].released, 1);
+  return true;
+}
+
+/* CREATE and RETIRE hold the control lock.  The child updates only the
+   fields loaded atomically here; a receipt may be taken while it runs.  */
+static inline void
+__pthread_bounded_snapshot (struct __pthread_bounded *owner,
+                            struct pthread_bounded_receipt *result)
+{
+#define COPY(field) result->field = owner->fact.field
+#define OBSERVE(field) result->field = atomic_load_relaxed (&owner->fact.field)
+  COPY (version);
+  COPY (size);
+  COPY (incarnation);
+  COPY (backing);
+  COPY (backing_bytes);
+  COPY (stack);
+  COPY (stack_bytes);
+  COPY (stack_reserved_bytes);
+  COPY (stack_available_bytes);
+  OBSERVE (arena_used);
+  OBSERVE (allocator_refusals);
+  OBSERVE (foreign_free_refusals);
+  OBSERVE (first_refused_free);
+  OBSERVE (cleanup_blocked);
+  OBSERVE (first_error);
+  COPY (create_status);
+  COPY (create_attempted);
+  COPY (clone_attempted);
+  COPY (born);
+  OBSERVE (entered);
+  OBSERVE (exit_cleanup_completed);
+  COPY (kernel_exited);
+  COPY (joined);
+  COPY (list_linked);
+  COPY (list_returned);
+  COPY (tls_returned);
+  COPY (stack_returned);
+  COPY (registration_returned);
+  COPY (backing_returned);
+  COPY (retire_attempts);
+  COPY (retire_status);
+  for (size_t i = 0; i < PTHREAD_BOUNDED_KINDS; ++i)
+    {
+      OBSERVE (allocation[i].attempted);
+      OBSERVE (allocation[i].allocated);
+      OBSERVE (allocation[i].released);
+      OBSERVE (allocation[i].bytes);
+      OBSERVE (allocation[i].first_error);
+    }
+#undef OBSERVE
+#undef COPY
+}
+
+extern int __pthread_create_bounded (pthread_t *, const pthread_attr_t *,
+                                     void *(*) (void *), void *,
+                                     struct __pthread_bounded *) attribute_hidden;
+#endif
