+
+/* The caller holds the shared registration gate.  Membership precedes every
+   nominated owner dereference, and birth cannot race the owner try-lock.  */
+int
+__pthread_bounded_bind_application_locked (pthread_bounded_t *owner,
+                                          uint64_t incarnation, void *pin)
+{
+  if (registration (owner) < 0)
+    return ESRCH;
+  if (atomic_exchange_acquire (&owner->lock, 1) != 0)
+    return EBUSY;
+  int status = owner->fact.incarnation != incarnation ? ESTALE
+               : owner->state != __PTHREAD_BOUNDED_READY
+                 || owner->application != NULL ? EALREADY : 0;
+  if (status == 0)
+    owner->application = pin;
+  atomic_store_release (&owner->lock, 0);
+  return status;
+}
