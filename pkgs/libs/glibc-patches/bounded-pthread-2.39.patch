+{
+  return pthread_create_internal (newthread, attr, start_routine, arg, NULL);
+}
+
+int
+__pthread_create_bounded (pthread_t *newthread, const pthread_attr_t *attr,
+                          void *(*start_routine) (void *), void *arg,
+                          struct __pthread_bounded *bounded)
+{
+  return pthread_create_internal (newthread, attr, start_routine, arg, bounded);
+}
