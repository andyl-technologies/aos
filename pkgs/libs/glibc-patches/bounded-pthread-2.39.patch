+/* Registration is a real finite admission resource.  Lookup compares the
+   nominated address before dereferencing it.  Callers serialize lifetime
+   operations on a control and retain its arena until final return.  */
+#define BOUNDED_REGISTRATIONS 128
+static struct __pthread_bounded *registered[BOUNDED_REGISTRATIONS];
+static uint64_t next_incarnation;
+static int registration_lock;
+
+static int
+registration (struct __pthread_bounded *owner)
+{
+  if (owner == NULL)
+    return -1;
+
+  for (int i = 0; i < BOUNDED_REGISTRATIONS; ++i)
+    if (atomic_load_acquire (&registered[i]) == owner)
+      return i;
+  return -1;
+}
+
+/* The registry lock pins a nominated control until its own try-lock is
+   held.  All lock acquisition is a single attempt, including final return.  */
+static int
+lock_control (struct __pthread_bounded *owner, uint64_t incarnation, int *slot)
+{
+  if (atomic_exchange_acquire (&registration_lock, 1) != 0)
+    return EBUSY;
+
+  *slot = registration (owner);
+  int status = ESRCH;
+  if (*slot >= 0)
+    {
+      status = atomic_exchange_acquire (&owner->lock, 1) != 0 ? EBUSY : 0;
+      if (status == 0 && owner->fact.incarnation != incarnation)
+        {
+          atomic_store_release (&owner->lock, 0);
+          status = ESTALE;
+        }
+    }
+
+  atomic_store_release (&registration_lock, 0);
+  return status;
+}
+
+static bool
+spans_overlap (uintptr_t first, size_t first_size,
+               uintptr_t second, size_t second_size)
+{
+  return first <= second ? second - first < first_size
+                         : first - second < second_size;
+}
+
+/* Reserve the supplied mapping against every still-retained arena and
+   stack.  The registry and actual owner, rather than a copied receipt,
+   establish whether a span is already in custody.  */
+static int
+reserve_stack (struct __pthread_bounded *owner, uintptr_t base, size_t bytes)
+{
+  if (atomic_exchange_acquire (&registration_lock, 1) != 0)
+    return EBUSY;
+
+  int status = 0;
+  for (size_t i = 0; i < BOUNDED_REGISTRATIONS; ++i)
+    {
+      struct __pthread_bounded *other = atomic_load_acquire (&registered[i]);
+      if (other != NULL
+          && (spans_overlap (base, bytes,
+                             other->fact.backing, other->fact.backing_bytes)
+              || (other != owner
+                  && spans_overlap (base, bytes,
+                                    other->fact.stack, other->fact.stack_bytes))))
+        {
+          status = EBUSY;
+          break;
+        }
+    }
+
+  if (status == 0)
+    {
+      owner->fact.stack = base;
+      owner->fact.stack_bytes = bytes;
+    }
+  atomic_store_release (&registration_lock, 0);
+  return status;
+}
+
+/* Output validation and writes share the registry lock.  A separately
+   admitted owner cannot begin occupying an output span between the check
+   and the write.  Only canonical registry entries supply peer geometry.  */
+static bool
+external_span_locked (const void *pointer, size_t bytes)
+{
+  uintptr_t address = (uintptr_t) pointer;
+  if (pointer == NULL || bytes > UINTPTR_MAX - address)
+    return false;
+
+  for (size_t i = 0; i < BOUNDED_REGISTRATIONS; ++i)
+    {
+      struct __pthread_bounded *other = registered[i];
+      if (other != NULL
+          && (spans_overlap (address, bytes,
+                             other->fact.backing, other->fact.backing_bytes)
+              || spans_overlap (address, bytes,
+                                other->fact.stack, other->fact.stack_bytes)))
+        return false;
+    }
+  return true;
+}
+
+static bool
+outputs_locked (struct pthread_bounded_receipt *receipt,
+                void *extra, size_t extra_bytes)
+{
+  return external_span_locked (receipt, sizeof (*receipt))
+    && (extra == NULL
+        || (external_span_locked (extra, extra_bytes)
+            && !spans_overlap ((uintptr_t) extra, extra_bytes,
+                               (uintptr_t) receipt, sizeof (*receipt))));
+}
+
+static int
+validate_outputs (struct pthread_bounded_receipt *receipt,
+                  void *extra, size_t extra_bytes)
+{
+  if (atomic_exchange_acquire (&registration_lock, 1) != 0)
+    return EBUSY;
+  int status = outputs_locked (receipt, extra, extra_bytes) ? 0 : EINVAL;
+  atomic_store_release (&registration_lock, 0);
+  return status;
+}
+
+static int
+publish_receipt (struct __pthread_bounded *owner,
+                 struct pthread_bounded_receipt *receipt,
+                 pthread_t *thread, pthread_t value)
+{
+  if (atomic_exchange_acquire (&registration_lock, 1) != 0)
+    return EBUSY;
+  int status = outputs_locked (receipt, thread, sizeof (*thread)) ? 0 : EINVAL;
+  if (status == 0)
+    {
+      if (thread != NULL)
+        *thread = value;
+      __pthread_bounded_snapshot (owner, receipt);
+    }
+  atomic_store_release (&registration_lock, 0);
+  return status;
+}
+
+int
+__pthread_bounded_init_np (void *backing, size_t bytes,
+                           const struct pthread_bounded_config *config,
+                           pthread_bounded_t **control, uint64_t *incarnation_out)
+{
+#if !defined __linux__ || !defined __x86_64__ || !defined __LP64__
+  return ENOTSUP;
+#else
+  uintptr_t address = (uintptr_t) backing;
+  if (backing == NULL || config == NULL || control == NULL
+      || incarnation_out == NULL
+      || config->version != PTHREAD_BOUNDED_VERSION
+      || config->size != sizeof (*config)
+      || config->flags != PTHREAD_BOUNDED_STRICT || config->reserved != 0
+      || (address & (_Alignof (struct __pthread_bounded) - 1)) != 0
+      || bytes < sizeof (struct __pthread_bounded)
+      || bytes > UINTPTR_MAX - address
+      || spans_overlap (address, bytes, (uintptr_t) config, sizeof (*config))
+      || spans_overlap (address, bytes, (uintptr_t) control, sizeof (*control))
+      || spans_overlap (address, bytes, (uintptr_t) incarnation_out,
+                        sizeof (*incarnation_out)))
+    return EINVAL;
+
+  /* Reserve enough physical space for every admitted request at its worst
+     alignment.  Actual requests may consume less; their unused reservation
+     still belongs to this arena until terminal return.  */
+  size_t required = sizeof (struct __pthread_bounded);
+  for (size_t i = 0; i < PTHREAD_BOUNDED_KINDS; ++i)
+    {
+      const struct pthread_bounded_limit *limit = &config->limit[i];
+      size_t alignment = limit->alignment;
+      if (alignment == 0 || (alignment & (alignment - 1)) != 0)
+        return EINVAL;
+      if (alignment < _Alignof (struct __pthread_bounded_block))
+        alignment = _Alignof (struct __pthread_bounded_block);
+
+      size_t block;
+      size_t reservation;
+      if (__builtin_add_overflow (limit->request_bytes,
+                                  sizeof (struct __pthread_bounded_block),
+                                  &block)
+          || __builtin_add_overflow (block, alignment - 1, &block)
+          || __builtin_mul_overflow (block, limit->requests, &reservation)
+          || __builtin_add_overflow (required, reservation, &required))
+        return EOVERFLOW;
+    }
+  if (required > bytes)
+    return ENOMEM;
+
+  if (atomic_exchange_acquire (&registration_lock, 1) != 0)
+    return EBUSY;
+
+  if (!external_span_locked (control, sizeof (*control))
+      || !external_span_locked (incarnation_out, sizeof (*incarnation_out))
+      || spans_overlap ((uintptr_t) control, sizeof (*control),
+                         (uintptr_t) incarnation_out, sizeof (*incarnation_out)))
+    {
+      atomic_store_release (&registration_lock, 0);
+      return EINVAL;
+    }
+
+  /* Initialization must not overwrite an arena already in libc custody.  */
+  for (size_t i = 0; i < BOUNDED_REGISTRATIONS; ++i)
+    {
+      struct __pthread_bounded *other = atomic_load_acquire (&registered[i]);
+      if (other != NULL
+          && (spans_overlap (address, bytes,
+                             other->fact.backing, other->fact.backing_bytes)
+              || spans_overlap (address, bytes,
+                                other->fact.stack, other->fact.stack_bytes)))
+        {
+          atomic_store_release (&registration_lock, 0);
+          return EBUSY;
+        }
+    }
+
+  uint64_t incarnation = atomic_load_relaxed (&next_incarnation);
+  if (incarnation == UINT64_MAX)
+    {
+      atomic_store_release (&registration_lock, 0);
+      return EOVERFLOW;
+    }
+  /* Registration serializes the sole writer.  No CAS retry is needed.  */
+  atomic_store_relaxed (&next_incarnation, incarnation + 1);
+
+  struct __pthread_bounded *owner = backing;
+  memset (owner, 0, sizeof (*owner));
+  owner->magic = PTHREAD_BOUNDED_MAGIC;
+  owner->self = address;
+  owner->config = *config;
+  owner->fact.version = PTHREAD_BOUNDED_VERSION;
+  owner->fact.size = sizeof (owner->fact);
+  owner->fact.incarnation = incarnation + 1;
+  owner->fact.backing = address;
+  owner->fact.backing_bytes = bytes;
+  owner->fact.arena_used = sizeof (*owner);
+
+  for (size_t i = 0; i < BOUNDED_REGISTRATIONS; ++i)
+    {
+      struct __pthread_bounded *expected = NULL;
+      if (__atomic_compare_exchange_n (&registered[i], &expected, owner, false,
+                                        __ATOMIC_RELEASE, __ATOMIC_RELAXED))
+        {
+          *control = owner;
+          *incarnation_out = owner->fact.incarnation;
+          atomic_store_release (&registration_lock, 0);
+          return 0;
+        }
+    }
+
+  owner->magic = 0;
+  atomic_store_release (&registration_lock, 0);
+  return EAGAIN;
+#endif
+}
+versioned_symbol (libc, __pthread_bounded_init_np, pthread_bounded_init_np,
+                  GLIBC_2_39);
+
+int
+__pthread_bounded_create_np (pthread_bounded_t *owner, uint64_t incarnation,
+                             pthread_t *thread,
+                             const pthread_attr_t *attr,
+                             void *(*start) (void *), void *arg,
+                             struct pthread_bounded_receipt *receipt)
+{
+  int slot;
+  int locked = lock_control (owner, incarnation, &slot);
+  if (locked != 0)
+    return locked;
+
+  pthread_t created_thread = 0;
+  int status = validate_outputs (receipt, thread, sizeof (*thread));
+  if (status != 0)
+    goto unlock;
+  status = EINVAL;
+  if (owner->state != __PTHREAD_BOUNDED_READY)
+    {
+      status = EALREADY;
+      goto observe;
+    }
+
+  owner->state = __PTHREAD_BOUNDED_NO_BIRTH;
+  owner->fact.create_attempted = 1;
+  if (THREAD_SELF->report_events)
+    {
+      status = ENOTSUP;
+      goto failed;
+    }
+
+  if (thread == NULL || attr == NULL || start == NULL
+      || spans_overlap ((uintptr_t) thread, sizeof (*thread),
+                        owner->fact.backing, owner->fact.backing_bytes))
+    goto failed;
+
+  const struct pthread_attr *internal = (const struct pthread_attr *) attr;
+  uintptr_t top = (uintptr_t) internal->stackaddr;
+  size_t bytes = internal->stacksize;
+  if ((internal->flags & ATTR_FLAG_STACKADDR) == 0
+      || (internal->flags & ATTR_FLAG_DETACHSTATE) != 0
+      || bytes == 0 || top < bytes
+      || spans_overlap (top - bytes, bytes,
+                        owner->fact.backing, owner->fact.backing_bytes)
+      || spans_overlap (top - bytes, bytes,
+                        (uintptr_t) receipt, sizeof (*receipt))
+      || spans_overlap (top - bytes, bytes,
+                        (uintptr_t) thread, sizeof (*thread))
+      || spans_overlap (top - bytes, bytes,
+                        (uintptr_t) attr, sizeof (*attr)))
+    goto failed;
+
+  status = reserve_stack (owner, top - bytes, bytes);
+  if (status != 0)
+    goto failed;
+
+  owner->state = __PTHREAD_BOUNDED_CREATING;
+  status = __pthread_create_bounded (&created_thread, attr, start, arg, owner);
+  if (status == 0)
+    owner->state = __PTHREAD_BOUNDED_ACTIVE;
+  else if (!owner->fact.born)
+    owner->state = __PTHREAD_BOUNDED_NO_BIRTH;
+
+ failed:
+  owner->fact.create_status = status;
+  if (status != 0)
+    __pthread_bounded_error (owner, status);
+ observe:
+  {
+    int post = publish_receipt (owner, receipt,
+                                status == 0 ? thread : NULL, created_thread);
+    if (post != 0)
+      {
+        __pthread_bounded_error (owner, post);
+        if (status == 0)
+          status = post;
+      }
+  }
+ unlock:
+  atomic_store_release (&owner->lock, 0);
+  return status;
+}
+versioned_symbol (libc, __pthread_bounded_create_np, pthread_bounded_create_np,
+                  GLIBC_2_39);
+
+int
+__pthread_bounded_query_np (pthread_bounded_t *owner, uint64_t incarnation,
+                            struct pthread_bounded_receipt *receipt)
+{
+  int slot;
+  int locked = lock_control (owner, incarnation, &slot);
+  if (locked != 0)
+    return locked;
+
+  int status = publish_receipt (owner, receipt, NULL, 0);
+  atomic_store_release (&owner->lock, 0);
+  return status;
+}
+versioned_symbol (libc, __pthread_bounded_query_np, pthread_bounded_query_np,
+                  GLIBC_2_39);
+
+int
+__pthread_bounded_tryretire_np (pthread_bounded_t *owner, uint64_t incarnation,
+                               void **result,
+                               struct pthread_bounded_receipt *receipt)
+{
+  int slot;
+  int locked = lock_control (owner, incarnation, &slot);
+  if (locked != 0)
+    return locked;
+
+  int status = validate_outputs (receipt, result, sizeof (*result));
+  if (status != 0)
+    goto unlock;
+  status = EINVAL;
+
+  if (owner->fact.retire_attempts == UINT_MAX)
+    {
+      status = EOVERFLOW;
+      goto observe;
+    }
+  ++owner->fact.retire_attempts;
+  if (result != NULL
+      && (spans_overlap ((uintptr_t) result, sizeof (*result),
+                         owner->fact.backing, owner->fact.backing_bytes)
+          || spans_overlap ((uintptr_t) result, sizeof (*result),
+                            owner->fact.stack, owner->fact.stack_bytes)
+          || spans_overlap ((uintptr_t) result, sizeof (*result),
+                            (uintptr_t) receipt, sizeof (*receipt))))
+    goto observe;
+
+  struct pthread *pd = owner->pd;
+  if (owner->fact.born && !owner->fact.joined)
+    {
+      if (pd == NULL || pd == THREAD_SELF)
+        goto observe;
+
+      if (atomic_load_acquire (&pd->tid) != 0)
+        {
+          status = EBUSY;
+          goto observe;
+        }
+
+      /* The kernel clear-child-tid store is the terminal observation.
+         Neither user entry return nor the last destructor supplies it.  */
+      owner->fact.kernel_exited = 1;
+      if (pd->joinid != NULL)
+        {
+          status = EBUSY;
+          goto observe;
+        }
+      pd->joinid = THREAD_SELF;
+      pd->tid = -1;
+      owner->fact.joined = 1;
+      if (owner->state == __PTHREAD_BOUNDED_FAILED_BIRTH)
+        atomic_fetch_add_relaxed (&__nptl_nthreads, -1);
+    }
+
+  /* A raw kernel exit can clear tid without running libc's destructor
+     and freeres tail.  Kernel join is factual, but is insufficient to
+     return any backing in that case.  Only the deliberate setup-failure
+     path is known to have skipped all application/runtime entry.  */
+  if (owner->fact.born && owner->state != __PTHREAD_BOUNDED_FAILED_BIRTH
+      && !atomic_load_acquire (&owner->fact.exit_cleanup_completed))
+    {
+      status = EPROTO;
+      goto observe;
+    }
+
+  if (atomic_load_acquire (&owner->fact.cleanup_blocked))
+    {
+      status = EPROTO;
+      goto observe;
+    }
+  if (atomic_load_acquire (&owner->fact.foreign_free_refusals) != 0)
+    {
+      status = ENOTSUP;
+      goto observe;
+    }
+
+  if (owner->fact.list_linked && !owner->fact.list_returned)
+    {
+      if (lll_trylock (GL (dl_stack_cache_lock)) != 0)
+        {
+          status = EBUSY;
+          goto observe;
+        }
+
+      __nptl_stack_list_del (&pd->list);
+      owner->fact.list_returned = 1;
+      lll_unlock (GL (dl_stack_cache_lock), LLL_PRIVATE);
+    }
+
+  if (!owner->fact.tls_returned)
+    {
+      if (pd != NULL && GET_DTV (TLS_TPADJ (pd)) != NULL)
+        _dl_deallocate_tls (TLS_TPADJ (pd), false);
+      if (atomic_load_acquire (&owner->fact.cleanup_blocked))
+        {
+          status = EPROTO;
+          goto observe;
+        }
+      owner->fact.tls_returned = 1;
+    }
+
+  if (pd != NULL && pd->tpp != NULL)
+    {
+      if (!__pthread_bounded_release (owner, pd->tpp))
+        {
+          status = EPROTO;
+          goto observe;
+        }
+      pd->tpp = NULL;
+    }
+
+  for (size_t i = 0; i < PTHREAD_BOUNDED_KINDS; ++i)
+    if (owner->fact.allocation[i].allocated
+        != owner->fact.allocation[i].released)
+      {
+        status = EBUSY;
+        goto observe;
+      }
+
+  if (atomic_exchange_acquire (&registration_lock, 1) != 0)
+    {
+      status = EBUSY;
+      goto observe;
+    }
+
+  if (!outputs_locked (receipt, result, sizeof (*result)))
+    {
+      atomic_store_release (&registration_lock, 0);
+      status = EINVAL;
+      goto observe;
+    }
+  if (owner->fact.born && result != NULL)
+    *result = pd->result;
+  atomic_store_release (&registered[slot], NULL);
+  owner->fact.registration_returned = 1;
+  owner->fact.stack_returned = owner->fact.stack_bytes != 0;
+  owner->fact.backing_returned = 1;
+  owner->state = __PTHREAD_BOUNDED_RETIRED;
+  status = 0;
+
+ observe:
+  owner->fact.retire_status = status;
+  if (status != 0)
+    __pthread_bounded_error (owner, status);
+  if (owner->fact.backing_returned)
+    {
+      __pthread_bounded_snapshot (owner, receipt);
+      atomic_store_release (&owner->lock, 0);
+      atomic_store_release (&registration_lock, 0);
+      return status;
+    }
+  {
+    int post = publish_receipt (owner, receipt, NULL, 0);
+    if (post != 0)
+      {
+        __pthread_bounded_error (owner, post);
+        if (status == 0)
+          status = post;
+      }
+  }
+ unlock:
+  atomic_store_release (&owner->lock, 0);
+  return status;
+}
