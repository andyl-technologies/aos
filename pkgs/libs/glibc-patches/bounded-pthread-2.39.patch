+                (f.owner, f.incarnation, pin, &second), 0);
+  TEST_VERIFY (second > first);
+  TEST_COMPARE (malloc_bounded_failstop_end_np
+                (f.owner, f.incarnation, pin, first), ESTALE);
+  struct malloc_bounded_failstop fact;
+  TEST_COMPARE (malloc_bounded_failstop_query_np
+                (f.owner, f.incarnation, pin, &fact), 0);
+  TEST_COMPARE (fact.active, 1);
+  TEST_COMPARE (fact.scope, second);
+  TEST_COMPARE (fact.ended, 0);
+  TEST_COMPARE (fact.end_scope, first);
+  TEST_COMPARE (fact.end_status, ESTALE);
+  atomic_store_relaxed (&__pthread_bounded_registration_lock, 1);
+  TEST_COMPARE (malloc_bounded_failstop_end_np
+                (f.owner, f.incarnation, pin, second), EBUSY);
+  atomic_store_relaxed (&__pthread_bounded_registration_lock, 0);
+  TEST_COMPARE (malloc_bounded_failstop_end_np
+                (f.owner, f.incarnation, pin, second), 0);
+  TEST_COMPARE (malloc_bounded_failstop_query_np
+                (f.owner, f.incarnation, pin, &fact), 0);
+  TEST_COMPARE (fact.active, 0);
+  TEST_COMPARE (fact.ended, 1);
+  TEST_COMPARE (fact.begin_attempts, 4);
+  TEST_COMPARE (fact.end_attempts, 3);
+  TEST_COMPARE (fact.first_error, EINVAL);
+  TEST_COMPARE (fact.end_status, 0);
+  errno = 0;
+  void *result = malloc (17);
+  TEST_VERIFY (result == NULL);
+  TEST_COMPARE (errno, ENOMEM);
+  TEST_COMPARE (malloc_bounded_detach_np (f.owner, f.incarnation, pin), 0);
+  retire (&f);
+  retire (&peer);
+}
+
+static int
+do_test (void)
+{
+  process_controls ();
+  failstop_controls ();
+  for (uintptr_t i = 0; i < 3; ++i)
+    {
+      struct support_capture_subprocess child = support_capture_subprocess
+        (invalid_release_child, (void *) i);
+      support_capture_subprocess_check (&child, "release debt", 0, sc_allow_none);
+      support_capture_subprocess_free (&child);
+    }
+  allocation_controls ();
+  release_controls ();
+  identity_controls ();
+  terminal_controls (false);
+  terminal_controls (true);
+  no_birth_controls ();
+  retired_range_controls ();
+  registry_exhaustion_controls ();
+  return 0;
+}
+
+#include <support/test-driver.c>
