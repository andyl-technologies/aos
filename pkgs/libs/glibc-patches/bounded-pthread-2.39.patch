+  for (size_t i = 0; i < BOUNDED_REGISTRATIONS; ++i)
+    {
+      struct __pthread_bounded *expected = NULL;
+      if (__atomic_compare_exchange_n (&registered[i], &expected, owner, false,
+                                        __ATOMIC_RELEASE, __ATOMIC_RELAXED))
+        {
+          *control = owner;
+          *incarnation_out = owner->fact.incarnation;
+          atomic_store_release (&__pthread_bounded_registration_lock, 0);
+          return 0;
+        }
+    }
