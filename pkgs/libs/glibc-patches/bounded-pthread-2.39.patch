+/* A strict bounded thread has no ordinary heap owner.  Refuse before
+   ptmalloc initialization, tcache creation or any global allocator lock.
+   During early single-threaded startup the thread pointer need not exist.  */
+static inline bool
+bounded_heap_refused (void *pointer)
+{
+#if IS_IN (libc)
+  struct __pthread_bounded *owner = __pthread_bounded_current ();
+  if (owner != NULL)
+    {
+      __pthread_bounded_refuse_heap (owner, pointer);
+      __set_errno (ENOTSUP);
+      return true;
+    }
+#endif
+  return false;
+}
