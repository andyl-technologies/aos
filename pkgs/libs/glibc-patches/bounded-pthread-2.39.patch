diff --git a/nptl/allocatestack.c b/nptl/allocatestack.c
index f35a8369bd5d197a36e9774c30468d2fb2271a48..3d1eca9c3ea3997899e3b8a033fa5ac9ba182121 100644
--- a/nptl/allocatestack.c
+++ b/nptl/allocatestack.c
@@ -212,7 +212,8 @@ advise_stack_range (void *mem, size_t size, uintptr_t pd, size_t guardsize)
    PDP must be non-NULL.  */
 static int
 allocate_stack (const struct pthread_attr *attr, struct pthread **pdp,
-		void **stack, size_t *stacksize)
+		void **stack, size_t *stacksize,
+                struct __pthread_bounded *bounded)
 {
   struct pthread *pd;
   size_t size;
@@ -279,6 +280,9 @@ allocate_stack (const struct pthread_attr *attr, struct pthread **pdp,
 
       /* The user provided stack memory needs to be cleared.  */
       memset (pd, '\0', sizeof (struct pthread));
+      pd->bounded = bounded;
+      if (bounded != NULL)
+        bounded->pd = pd;
 
       /* The first TSD block is included in the TCB.  */
       pd->specific[0] = pd->specific_1stblock;
@@ -301,9 +305,27 @@ allocate_stack (const struct pthread_attr *attr, struct pthread **pdp,
       /* Don't allow setxid until cloned.  */
