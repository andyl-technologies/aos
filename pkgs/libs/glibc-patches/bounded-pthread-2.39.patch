+#ifndef _PTHREAD_BOUNDED_H
+#define _PTHREAD_BOUNDED_H 1
+
+#include <pthread.h>
+#include <stddef.h>
+#include <stdint.h>
+
+__BEGIN_DECLS
+
+#define PTHREAD_BOUNDED_VERSION 1
+#define PTHREAD_BOUNDED_STRICT 1
+
+enum pthread_bounded_kind
+{
+  PTHREAD_BOUNDED_DTV,
+  PTHREAD_BOUNDED_DYNAMIC_TLS,
+  PTHREAD_BOUNDED_TSD,
+  PTHREAD_BOUNDED_DESTRUCTOR,
+  PTHREAD_BOUNDED_PRIORITY,
+  PTHREAD_BOUNDED_KINDS
+};
+
+/* Each allocation consumes one request permanently, including a request
+   whose storage is logically released before thread exit.  */
+struct pthread_bounded_limit
+{
+  size_t requests;
+  size_t request_bytes;
+  size_t alignment;
+};
+
+struct pthread_bounded_config
+{
+  unsigned int version;
+  unsigned int size;
+  /* Must select PTHREAD_BOUNDED_STRICT: no ordinary heap ownership.  */
+  unsigned int flags;
+  unsigned int reserved;
+  struct pthread_bounded_limit limit[PTHREAD_BOUNDED_KINDS];
+};
+
+struct pthread_bounded_allocation_fact
+{
+  size_t attempted;
+  size_t allocated;
+  size_t released;
+  size_t bytes;
+  int first_error;
+};
+
+/* A receipt is an observation, never permission to reuse a resource.
+   Only backing_returned relinquishes the containing arena.  A successful
+   kernel join alone does not return the arena or supplied stack.  */
+struct pthread_bounded_receipt
+{
+  unsigned int version;
+  unsigned int size;
+  uint64_t incarnation;
+  uintptr_t backing;
+  size_t backing_bytes;
+  uintptr_t stack;
+  size_t stack_bytes;
+  size_t stack_reserved_bytes;
+  size_t stack_available_bytes;
+  size_t arena_used;
+  /* Saturated monotonic lower bounds; concurrent refusals may coalesce.  */
+  size_t allocator_refusals;
+  size_t foreign_free_refusals;
+  uintptr_t first_refused_free;
+  unsigned int cleanup_blocked;
+  int first_error;
+  int create_status;
+  unsigned int create_attempted;
+  unsigned int clone_attempted;
+  unsigned int born;
+  unsigned int entered;
+  unsigned int exit_cleanup_completed;
+  unsigned int kernel_exited;
+  unsigned int joined;
+  unsigned int list_linked;
+  unsigned int list_returned;
+  unsigned int tls_returned;
+  unsigned int stack_returned;
+  unsigned int registration_returned;
+  unsigned int backing_returned;
+  unsigned int retire_attempts;
+  int retire_status;
+  struct pthread_bounded_allocation_fact allocation[PTHREAD_BOUNDED_KINDS];
+};
+
+typedef struct __pthread_bounded pthread_bounded_t;
+
+/* Initializes CONTROL and its nonwrapping INCARNATION inside caller-owned
+   BACKING.  BACKING must remain exclusively owned and writable until a
+   terminal receipt returns it.
+   CONFIG describes enforced bounds, not a numeric credit transfer.
+   Writable outputs must not overlap any registered arena or retained stack.
+   The current implementation supports Linux/x86-64 supplied stacks.  */
+extern int pthread_bounded_init_np (void *__backing, size_t __bytes,
+                                  const struct pthread_bounded_config *__config,
+                                  pthread_bounded_t **__control,
+                                  uint64_t *__incarnation) __THROW;
+
+/* Creates one joinable thread on an explicit supplied stack.  Creation may
+   wait.  Once valid outputs are admitted, a creation attempt consumes CONTROL,
+   even if no thread is born.
+   A publication failure can follow an actual birth; query the canonical
+   control instead of treating every returned error as no birth.  */
+extern int pthread_bounded_create_np (pthread_bounded_t *__control,
+                                    uint64_t __incarnation,
+                                    pthread_t *__thread_id,
+                                    const pthread_attr_t *__attr,
+                                    void *(*__start) (void *), void *__arg,
+                                    struct pthread_bounded_receipt *__receipt);
+
+/* Obtains the canonical control's current factual snapshot.  The caller
+   must retain exclusive lifetime custody while querying the control.  */
+extern int pthread_bounded_query_np
+  (pthread_bounded_t *__control, uint64_t __incarnation,
+   struct pthread_bounded_receipt *__receipt) __THROW;
+
+/* Tries kernel join and terminal resource return without waiting on a
+   futex or libc lock.  EBUSY retains all outstanding debt.  Repeated calls
+   preserve birth, join and physical-return facts and the first error.
+   All outputs must reside outside every registered arena and retained stack.
+   An output publication refusal can return without a new receipt.  */
+extern int pthread_bounded_tryretire_np
+  (pthread_bounded_t *__control, uint64_t __incarnation, void **__result,
+   struct pthread_bounded_receipt *__receipt) __THROW;
+
+__END_DECLS
+#endif
