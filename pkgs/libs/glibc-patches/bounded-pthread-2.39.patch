+#ifndef _MALLOC_BOUNDED_PROCESS_H
+#define _MALLOC_BOUNDED_PROCESS_H 1
+
+#include <stddef.h>
+#include <stdint.h>
+#include <sys/types.h>
+
+__BEGIN_DECLS
+
+#define MALLOC_BOUNDED_PROCESS_VERSION 1
+#define MALLOC_BOUNDED_PROCESS_OBJECTS 3
+
+typedef const struct __malloc_bounded_process malloc_bounded_process_t;
+
+enum malloc_bounded_process_object_kind
+{
+  MALLOC_BOUNDED_PROCESS_APPLICATION = 1,
+  MALLOC_BOUNDED_PROCESS_PTHREAD = 2,
+  MALLOC_BOUNDED_PROCESS_IDENTITY = 3
+};
+
+/* Actual complete compiled objects, including their own padding.  Objects
+   can share ELF pages with unrelated libc data; this is not a page mapping
+   or a substitute for the containing process's actual ELF/TLS floor.  */
+struct malloc_bounded_process_object
+{
+  unsigned int kind;
+  unsigned int reserved;
+  uintptr_t base;
+  size_t bytes;
+  size_t alignment;
+};
+
+struct malloc_bounded_process_info
+{
+  unsigned int version;
+  unsigned int size;
+  malloc_bounded_process_t *owner;
+  pid_t process;
+  unsigned int objects;
+  size_t total_bytes;
+  size_t application_capacity;
+  size_t pthread_capacity;
+  struct malloc_bounded_process_object object[MALLOC_BOUNDED_PROCESS_OBJECTS];
+};
+
+/* Direct canonical process-lifetime identity of this loaded provider.
+   Neither its address nor an inventory snapshot grants an allocation,
+   parent debit, semantic operation, hot-fork adoption or backing return.
+   The containing owner binds this actual identity and matching loaded libc
+   to its independently authenticated native process lifetime and funds the
+   complete process inventory exactly once under the real resource parent.
+   There is no process-owner retirement/rearm or address reuse in that life.  */
+extern malloc_bounded_process_t *malloc_bounded_process_np (void) __THROW;
+
+/* Authenticate OWNER by exact canonical membership before dereference.
+   EXPECTED_PROCESS must match the actual current getpid result; a parent's
+   inherited pointer/PID pair refuses after fork.  PID is an observation,
+   not a Source generation or permission.  Querying with a child's PID does
