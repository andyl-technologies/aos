index 0000000000000000000000000000000000000000..200023d0d44cbbca780c229e8e778ae188fe5580
--- /dev/null
+++ b/nptl/pthread-bounded-internal.h
@@ -0,0 +1,295 @@
+/* Copyright (C) 2026 Dylan Plecki.
+   This file is part of the GNU C Library.
+
