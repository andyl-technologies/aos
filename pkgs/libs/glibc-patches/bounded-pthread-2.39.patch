+{
+  unsigned int version;
+  unsigned int size;
+  uint64_t incarnation;
+  uintptr_t backing;
+  size_t backing_bytes;
+  size_t used;
+  size_t allocation_attempts;
+  size_t allocated;
+  size_t released;
+  size_t live;
+  size_t attached;
+  size_t attachments_used;
+  size_t bound_threads;
+  size_t terminal_threads;
+  size_t refusals;
+  size_t invalid_releases;
+  size_t registry_slot;
+  size_t registry_used;
+  size_t registry_capacity;
+  unsigned int uncertain_release;
+  int first_error;
+  unsigned int registration_removed;
+  unsigned int libc_custody_returned;
+  unsigned int address_quarantined;
+};
