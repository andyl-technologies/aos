diff --git a/malloc/tst-malloc-bounded-glib.c b/malloc/tst-malloc-bounded-glib.c
new file mode 100644
index 0000000000000000000000000000000000000000..ad00fbe2b921c3f31353577eb1928d47e3e1691c
--- /dev/null
+++ b/malloc/tst-malloc-bounded-glib.c
@@ -0,0 +1,225 @@
+/* Copyright (C) 2026 Dylan Plecki.
+   This file is part of the GNU C Library.
+
+   The GNU C Library is free software; you can redistribute it and/or
+   modify it under the terms of the GNU Lesser General Public
+   License as published by the Free Software Foundation; either
+   version 2.1 of the License, or (at your option) any later version.
+
+   The GNU C Library is distributed in the hope that it will be useful,
+   but WITHOUT ANY WARRANTY; without even the implied warranty of
+   MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+   Lesser General Public License for more details.
+
+   You should have received a copy of the GNU Lesser General Public
+   License along with the GNU C Library; if not, see
+   <https://www.gnu.org/licenses/>.  */
+
+/* External integration control, deliberately not a default glibc test.
+   Compile against the actual configured GLib public headers and DSO, using
+   the matching newly built libc and loader.  See README.bounded-application.
+   This file must not be qualified by linking the old installed dae19 libc.  */
+#include <glib.h>
+#include <malloc-bounded.h>
+#include <assert.h>
+#include <dlfcn.h>
+#include <errno.h>
+#include <stdarg.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#define BACKING_BYTES (16 * 1024 * 1024)
+
+extern int __vasprintf_chk (char **, int, const char *, va_list);
+
+static int
+checked_format (char **out, const char *format, ...)
+{
+  va_list args;
+  va_start (args, format);
+  int status = __vasprintf_chk (out, 1, format, args);
+  va_end (args);
+  return status;
+}
+
+static void
+inside (void *backing, const void *pointer)
+{
+  assert ((uintptr_t) pointer >= (uintptr_t) backing);
+  assert ((uintptr_t) pointer - (uintptr_t) backing < BACKING_BYTES);
+}
+
+static void
+forbidden_log (const gchar *domain G_GNUC_UNUSED,
+               GLogLevelFlags level G_GNUC_UNUSED,
+               const gchar *message G_GNUC_UNUSED,
+               gpointer unused G_GNUC_UNUSED)
+{
+  /* A real GLib allocation failure must never enter its recursive logging
+     path in the selected scope.  A different exit makes this causal.  */
+  _exit (126);
+}
+
+static GLogWriterOutput
+forbidden_writer (GLogLevelFlags level G_GNUC_UNUSED,
+                  const GLogField *fields G_GNUC_UNUSED,
+                  gsize count G_GNUC_UNUSED, gpointer unused G_GNUC_UNUSED)
+{
+  _exit (126);
+}
+
+static void *volatile failure_result;
+
+static void
+glib_failstop_controls (void)
+{
+  for (unsigned int mode = 0; mode < 4; ++mode)
+    {
+      pid_t child = fork ();
+      assert (child >= 0);
+      if (child == 0)
+        {
+          /* Install the actual DSO's two logging hooks BEFORE attachment.
+             Neither hook may run; neither allocates if the control fails.  */
+          g_log_set_default_handler (forbidden_log, NULL);
+          g_log_set_writer_func (forbidden_writer, NULL, NULL);
+          void *backing = mmap (NULL, BACKING_BYTES, PROT_READ | PROT_WRITE,
+                                MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+          assert (backing != MAP_FAILED);
+          struct malloc_bounded_config config =
+            { MALLOC_BOUNDED_VERSION, sizeof (config), mode == 2 ? 1 : 0,
+              64, 16, 1 };
+          malloc_bounded_t *owner;
+          uint64_t incarnation, pin, scope;
+          assert (malloc_bounded_init_np (backing, BACKING_BYTES, &config,
+                                          &owner, &incarnation) == 0);
+          assert (malloc_bounded_attach_np (owner, incarnation, &pin) == 0);
+          void *old = mode == 2 ? g_malloc (16) : NULL;
+
+          /* The same real DSO try-allocation route still returns NULL.
+             Selection is explicit, not inferred from its malloc symbol.  */
+          assert (g_try_malloc (17) == NULL);
+          assert (malloc_bounded_failstop_begin_np
+                  (owner, incarnation, pin, &scope) == 0);
+          switch (mode)
+            {
+            case 0:
+              failure_result = g_malloc (17);
+              break;
+            case 1:
+              failure_result = g_malloc0 (17);
+              break;
+            case 2:
+              failure_result = g_realloc (old, 32);
+              break;
+            case 3:
+              /* The real imported hidden __vasprintf_chk allocator path.  */
+              failure_result = g_strdup_printf ("%010000d", 7);
+              break;
+            }
+          _exit (125);
+        }
+      int status;
+      assert (waitpid (child, &status, 0) == child);
+      assert (WIFEXITED (status));
+      assert (WEXITSTATUS (status) == MALLOC_BOUNDED_FAILSTOP_STATUS);
+    }
+}
+
+int
+main (void)
+{
+  /* Load and resolve the real configured DSO before attaching: loader
+     namespace/constructors are not application-child admission effects.  */
+  Dl_info origin;
+  assert (dladdr ((void *) g_malloc, &origin) != 0);
+  assert (strstr (origin.dli_fname, "libglib-2.0.so") != NULL);
+  printf ("GLib allocator DSO: %s\n", origin.dli_fname);
+  fflush (stdout);
+
+  void *backing = mmap (NULL, BACKING_BYTES, PROT_READ | PROT_WRITE,
+                        MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+  assert (backing != MAP_FAILED);
+  struct malloc_bounded_config config =
+    { MALLOC_BOUNDED_VERSION, sizeof (config), 128, 65536, 4096, 2 };
+  malloc_bounded_t *owner;
+  uint64_t incarnation, pin;
+  assert (malloc_bounded_init_np (backing, BACKING_BYTES, &config, &owner,
+                                  &incarnation) == 0);
+  assert (malloc_bounded_attach_np (owner, incarnation, &pin) == 0);
+
+  /* Actual DSO malloc/calloc/realloc/free, including allocated size macros. */
+  unsigned char *data = g_malloc0 (64);
+  inside (backing, data);
+  for (size_t i = 0; i < 64; ++i)
+    assert (data[i] == 0);
+  memset (data, 0x39, 64);
+  data = g_realloc (data, 256);
+  inside (backing, data);
+  assert (data[63] == 0x39);
+  g_free (data);
+  void *plain = g_malloc (17);
+  inside (backing, plain);
+  g_free (plain);
+
+  GArray *array = g_array_sized_new (FALSE, FALSE, sizeof (uint64_t), 1);
+  for (uint64_t i = 0; i < 129; ++i)
+    g_array_append_val (array, i);
+  inside (backing, array);
+  inside (backing, array->data);
+  assert (g_array_index (array, uint64_t, 128) == 128);
+  g_array_free (array, TRUE);
+
+  GHashTable *table = g_hash_table_new (g_direct_hash, g_direct_equal);
+  inside (backing, table);
+  for (uintptr_t i = 1; i <= 129; ++i)
+    g_hash_table_insert (table, (void *) i, (void *) (i + 1));
+  assert (g_hash_table_lookup (table, (void *) 129) == (void *) 130);
+  g_hash_table_remove_all (table);
+  g_hash_table_unref (table);
+
+  GRand *random = g_rand_new_with_seed (41);
+  GRand *copy = g_rand_copy (random);
+  inside (backing, random);
+  inside (backing, copy);
+  assert (g_rand_int (random) == g_rand_int (copy));
+  g_rand_free (random);
+  g_rand_free (copy);
+
+  /* Real GLib formatted-string path imports __vasprintf_chk; direct call
+     additionally forces hidden libc malloc/realloc and result transfer.  */
+  char *string = g_strdup_printf ("%010000d", 7);
+  inside (backing, string);
+  assert (strlen (string) == 10000 && string[9999] == '7');
+  g_free (string);
+  string = NULL;
+  assert (checked_format (&string, "%010000d", 9) == 10000);
+  inside (backing, string);
+  assert (string[9999] == '9');
+  free (string);
+
+  struct malloc_bounded_receipt fact;
+  assert (malloc_bounded_detach_np (owner, incarnation, pin) == 0);
+  assert (malloc_bounded_query_np (owner, incarnation, &fact) == 0);
+  assert (fact.allocated > 8 && fact.live == 0);
+  for (uint64_t i = 1; i <= fact.allocated; ++i)
+    {
+      struct malloc_bounded_allocation allocation;
+      assert (malloc_bounded_allocation_np (owner, incarnation, i,
+                                            &allocation) == 0);
+      inside (backing, (void *) allocation.pointer);
+      assert (allocation.released == 1 && allocation.attachment == pin);
+    }
+  assert (malloc_bounded_tryretire_np (owner, incarnation, &fact) == 0);
+  assert (fact.libc_custody_returned && fact.registration_removed);
+  assert (fact.address_quarantined);
+  assert (mprotect (backing, BACKING_BYTES, PROT_NONE) == 0);
+  glib_failstop_controls ();
+  puts ("PASS: actual GLib DSO and __vasprintf_chk application storage");
+  return 0;
+}
