+  (malloc_bounded_t *, uint64_t, uint64_t, uint64_t *) __THROW;
+extern int malloc_bounded_failstop_end_np
+  (malloc_bounded_t *, uint64_t, uint64_t, uint64_t) __THROW;
+extern int malloc_bounded_failstop_query_np
+  (malloc_bounded_t *, uint64_t, uint64_t,
+   struct malloc_bounded_failstop *) __THROW;
+
