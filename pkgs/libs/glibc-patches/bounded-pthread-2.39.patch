+   creation.  It survives no-birth/partial birth and every TLS/TSD tail;
+   only successful authenticated pthread retirement returns that pin.  */
+extern int malloc_bounded_bind_np
+  (malloc_bounded_t *, uint64_t, pthread_bounded_t *, uint64_t,
+   uint64_t *) __THROW;
+extern int malloc_bounded_tryretire_np
+  (malloc_bounded_t *, uint64_t, struct malloc_bounded_receipt *) __THROW;
