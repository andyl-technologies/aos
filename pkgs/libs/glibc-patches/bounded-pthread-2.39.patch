+      __nptl_stack_list_del (&pd->list);
+      owner->fact.list_returned = 1;
+      lll_unlock (GL (dl_stack_cache_lock), LLL_PRIVATE);
+    }
+
+  if (!owner->fact.tls_returned)
+    {
+      if (pd != NULL && GET_DTV (TLS_TPADJ (pd)) != NULL)
+        _dl_deallocate_tls (TLS_TPADJ (pd), false);
+      if (atomic_load_acquire (&owner->fact.cleanup_blocked))
+        {
+          status = EPROTO;
+          goto observe;
+        }
+      owner->fact.tls_returned = 1;
+    }
+
+  if (pd != NULL && pd->tpp != NULL)
+    {
+      if (!__pthread_bounded_release (owner, pd->tpp))
+        {
+          status = EPROTO;
+          goto observe;
+        }
+      pd->tpp = NULL;
+    }
