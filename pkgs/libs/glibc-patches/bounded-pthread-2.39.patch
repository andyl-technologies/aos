+extern int malloc_bounded_init_np
+  (void *, size_t, const struct malloc_bounded_config *,
+   malloc_bounded_t **, uint64_t *) __THROW;
+extern int malloc_bounded_query_np
+  (malloc_bounded_t *, uint64_t, struct malloc_bounded_receipt *) __THROW;
+extern int malloc_bounded_allocate_np
+  (malloc_bounded_t *, uint64_t, size_t, size_t,
+   struct malloc_bounded_token *) __THROW;
+extern int malloc_bounded_reallocate_np
+  (malloc_bounded_t *, uint64_t, struct malloc_bounded_token, size_t,
+   struct malloc_bounded_token *) __THROW;
+extern int malloc_bounded_allocation_np
+  (malloc_bounded_t *, uint64_t, uint64_t,
+   struct malloc_bounded_allocation *) __THROW;
+extern int malloc_bounded_release_np
+  (malloc_bounded_t *, uint64_t, struct malloc_bounded_token) __THROW;
+
+/* Scoped producer attachment for preparation/callback execution.  It is
+   not inherited by pthread_create.  Nested attachment, including the same
+   child, refuses.  Detach cannot release a thread-bound attachment.  */
