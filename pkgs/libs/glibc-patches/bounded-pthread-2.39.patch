+/* TLS_TPADJ is the sole conversion between a pthread descriptor and the
+   TLS pointer used by the loader.  Ordinary descriptors keep a NULL owner.  */
+static inline struct __pthread_bounded *
+bounded_for_tcb (void *tcb)
+{
+#if TLS_TCB_AT_TP
+  return ((struct pthread *) tcb)->bounded;
+#else
+  return ((struct pthread *) ((char *) tcb - TLS_PRE_TCB_SIZE))->bounded;
+#endif
+}
+
+static inline void
+release_tls_block (struct __pthread_bounded *bounded, void *pointer)
+{
+  if (bounded != NULL)
+    __pthread_bounded_release (bounded, pointer);
+  else
+    free (pointer);
+}
