#!@bash@
set -euo pipefail

if [ "$#" -lt 6 ]; then
  echo "usage: aos-zfs-unlock POOL ENCRYPTION_ROOT SEALED_KEY_PATH ESP_COUNT ESP... EXPECTED_DEVICE..." >&2
  exit 2
fi

pool_name=$1
encryption_root=$2
sealed_key_path=$3
esp_count=$4
shift 4

case "$esp_count" in
  ""|*[!0-9]*)
    echo "aos-zfs-unlock: ESP count must be a non-negative integer" >&2
    exit 2
    ;;
esac
if [ "$esp_count" -eq 0 ] || [ "$#" -le "$esp_count" ]; then
  echo "aos-zfs-unlock: ESP and expected-device arguments are required" >&2
  exit 2
fi

esp_devices=()
while [ "$esp_count" -gt 0 ]; do
  esp_devices+=("$1")
  shift
  esp_count=$((esp_count - 1))
done
expected_devices=("$@")

key=/run/aos-zfs.key
esp=/run/aos-zfs-esp
mounted=false
cleanup() {
  rm -f "$key"
  if [ "$mounted" = true ]; then umount "$esp" || true; fi
}
trap cleanup EXIT INT TERM
mkdir -p "$esp"

signature=
for candidate in /run/systemd/tpm2-pcr-signature.json \
  /.extra/tpm2-pcr-signature.json \
  /run/credentials/@system/tpm2-pcr-signature.json; do
  if [ -r "$candidate" ]; then signature="$candidate"; break; fi
done
signature_arg=
[ -n "$signature" ] && signature_arg="--tpm2-signature=$signature"

unlocked=false
for device in "${esp_devices[@]}"; do
  [ -e "$device" ] || continue
  if mount -t vfat -o ro,noatime,fmask=0077,dmask=0077 "$device" "$esp"; then
    mounted=true
    if [ -r "$esp/$sealed_key_path" ]; then
      rm -f "$key"
      if systemd-creds decrypt --name=aos-zfs-key $signature_arg \
        "$esp/$sealed_key_path" "$key"; then
        chmod 0400 "$key"
        unlocked=true
        umount "$esp"
        mounted=false
        break
      fi
      rm -f "$key"
    fi
    umount "$esp"
    mounted=false
  fi
done
if [ "$unlocked" != true ]; then
  echo "aos-zfs-unlock: no configured ESP supplied a usable sealed key" >&2
  exit 1
fi

zpool import -N -f "$pool_name"
zfs load-key -L "file://$key" "$encryption_root"
rm -f "$key"
udevadm settle

for device in "${expected_devices[@]}"; do
  i=0
  while [ ! -e "$device" ] && [ "$i" -lt 60 ]; do
    i=$((i + 1))
    sleep 0.5
  done
  [ -e "$device" ] || {
    echo "aos-zfs-unlock: expected zvol did not appear: $device" >&2
    exit 1
  }
done
