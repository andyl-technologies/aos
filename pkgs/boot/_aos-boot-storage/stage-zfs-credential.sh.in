#!@bash@/bin/bash
set -euo pipefail

if [ "$#" -lt 3 ]; then
  echo "usage: aos-stage-zfs-credential SEALED_KEY_PATH OUTPUT ESP..." >&2
  exit 2
fi

sealed_key_path=$1
output=$2
shift 2

staging=${output}.new
esp=/run/aos-zfs-credential-esp
mounted=false
cleanup() {
  rm -f "$staging"
  if [ "$mounted" = true ]; then umount "$esp" || true; fi
}
trap cleanup EXIT INT TERM
mkdir -p "$esp"
install -d -m 0700 "$(dirname "$output")"

for device in "$@"; do
  [ -e "$device" ] || continue
  if mount -t vfat -o ro,noatime,fmask=0077,dmask=0077 "$device" "$esp"; then
    mounted=true
    if [ -r "$esp/$sealed_key_path" ]; then
      install -m 0600 "$esp/$sealed_key_path" "$staging"
      mv -f "$staging" "$output"
      umount "$esp"
      mounted=false
      exit 0
    fi
    umount "$esp"
    mounted=false
  fi
done

echo "aos-stage-zfs-credential: no configured ESP supplied the sealed credential" >&2
exit 1
