+// fetchFromFile reads a local file referenced by file:///path. The host
+// component, if present, is allowed only when empty or "localhost" — RFC
+// 8089 §3 says the empty host means the local machine and "localhost" is
+// reserved for the same. Any other host implies a remote read which is
+// out of scope here.
+//
+// Only the canonical `file:///path` form is supported. The opaque form
+// `file:/path` (no `//` authority delimiter) parses to `u.Path == ""`
+// and is rejected here as a missing path. Callers must always use the
+// triple-slash form.
+func (f *Fetcher) fetchFromFile(u url.URL, dest io.Writer, opts FetchOptions) error {
+	if u.Host != "" && u.Host != "localhost" {
+		return ErrSchemeUnsupported
+	}
+	if u.Path == "" {
+		return ErrSchemeUnsupported
+	}
+	src, err := os.Open(u.Path)
+	if err != nil {
+		return err
+	}
+	defer src.Close()
+	return f.decompressCopyHashAndVerify(dest, src, opts)
+}
