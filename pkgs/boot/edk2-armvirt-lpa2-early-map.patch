--- a/ArmVirtPkg/Library/ArmPlatformLibQemu/ArmPlatformHelper.S
+++ b/ArmVirtPkg/Library/ArmPlatformLibQemu/ArmPlatformHelper.S
@@ -72,6 +72,19 @@
   isb
 
 .Learly_idmap:
+  // The early tables use at most 48-bit addressing. ArmConfigureMmu selects
+  // 52-bit LPA2 tables before replacing this mapping, so changing TCR with
+  // these tables active would fault on the next instruction. Leave the MMU
+  // off on such CPUs until ArmConfigureMmu installs the full LPA2 mapping.
+  mrs    x0, id_aa64mmfr0_el1
+  and    x1, x0, #0xf
+  cmp    x1, #6                  // PARange == 52 bits
+  b.ne   .Learly_idmap_setup
+  ubfx   x0, x0, #28, #4         // TGran4 == 1 enables 52-bit 4 KB pages
+  cmp    x0, #1
+  b.eq   0f
+
+.Learly_idmap_setup:
   mov_i  x0, mairval
   mov_i  x1, tcrval
   adrp   x2, idmap
