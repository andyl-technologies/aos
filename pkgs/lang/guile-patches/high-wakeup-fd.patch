+/* Preserve select's remaining timeout for scm_std_sleep and scm_std_usleep.
+   Poll's millisecond timeout is rounded up, and long waits are split without
+   returning early when the millisecond count would exceed INT_MAX.  */
+static int
+poll_with_select_timeout (struct pollfd *fds, nfds_t nfds,
+                          struct timeval *timeout)
+{
+  if (timeout == NULL)
+    return poll (fds, nfds, -1);
+
+  if (timeout->tv_sec < 0 || timeout->tv_usec < 0
+      || timeout->tv_usec >= 1000000)
+    {
+      errno = EINVAL;
+      return -1;
+    }
+
+  for (;;)
+    {
+      struct timespec before, after;
+      time_t elapsed_secs;
+      long elapsed_usecs;
+      int milliseconds, result, saved_errno;
+
+      if (clock_gettime (CLOCK_MONOTONIC, &before) < 0)
+        return -1;
+
+      if (timeout->tv_sec > (INT_MAX - 1000) / 1000)
+        milliseconds = INT_MAX;
+      else
+        milliseconds = timeout->tv_sec * 1000
+          + (timeout->tv_usec + 999) / 1000;
+
+      result = poll (fds, nfds, milliseconds);
+      saved_errno = errno;
+      if (clock_gettime (CLOCK_MONOTONIC, &after) < 0)
+        return -1;
+
+      elapsed_secs = after.tv_sec - before.tv_sec;
+      elapsed_usecs = (after.tv_nsec - before.tv_nsec) / 1000;
+      if (elapsed_usecs < 0)
+        {
+          elapsed_secs--;
+          elapsed_usecs += 1000000;
+        }
+
+      if (elapsed_secs > timeout->tv_sec
+          || (elapsed_secs == timeout->tv_sec
+              && elapsed_usecs >= timeout->tv_usec))
+        timeout->tv_sec = timeout->tv_usec = 0;
+      else
+        {
+          timeout->tv_sec -= elapsed_secs;
+          timeout->tv_usec -= elapsed_usecs;
+          if (timeout->tv_usec < 0)
+            {
+              timeout->tv_sec--;
+              timeout->tv_usec += 1000000;
+            }
+        }
+
+      if (result != 0 || (timeout->tv_sec == 0 && timeout->tv_usec == 0))
+        {
+          errno = saved_errno;
+          return result;
+        }
+    }
+}
