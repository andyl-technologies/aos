+/* The caller's sets fit fd_set, but the private wakeup pipe need not.
+   Keep that descriptor in poll's array rather than indexing past fd_set.  */
+static void *
+do_std_select_with_high_wakeup_fd (void *data)
+{
+  struct select_args *args = data;
+  struct pollfd fds[FD_SETSIZE + 1];
+  nfds_t count = 0, i;
+  int fd, result;
+
+  args->result = -1;
+  if (args->nfds < 0 || args->nfds > FD_SETSIZE)
+    {
+      args->errno_value = EINVAL;
+      return NULL;
+    }
+
+  for (fd = 0; fd < args->nfds; fd++)
+    {
+      short events = 0;
+
+      if (args->read_fds && FD_ISSET (fd, args->read_fds))
+        events |= POLLIN;
+      if (args->write_fds && FD_ISSET (fd, args->write_fds))
+        events |= POLLOUT;
+      if (args->except_fds && FD_ISSET (fd, args->except_fds))
+        events |= POLLPRI;
+
+      if (events)
+        fds[count++] = (struct pollfd) { fd, events, 0 };
+    }
+  fds[count] = (struct pollfd) { args->wakeup_fd, POLLIN, 0 };
+
+  result = poll_with_select_timeout (fds, count + 1, args->timeout);
+  args->errno_value = errno;
+  if (result < 0)
+    return NULL;
+
+  /* Unlike select, poll reports invalid descriptors as returned events.  */
+  for (i = 0; i <= count; i++)
+    if (fds[i].revents & POLLNVAL)
+      {
+        args->errno_value = EBADF;
+        return NULL;
+      }
+
+  if (args->read_fds)
+    FD_ZERO (args->read_fds);
+  if (args->write_fds)
+    FD_ZERO (args->write_fds);
+  if (args->except_fds)
+    FD_ZERO (args->except_fds);
+
+  /* Select counts ready bits, so a descriptor ready in two sets counts twice. */
+  result = 0;
+  for (i = 0; i < count; i++)
+    {
+      fd = fds[i].fd;
+      if ((fds[i].events & POLLIN)
+          && (fds[i].revents & (POLLIN | POLLHUP | POLLERR)))
+        {
+          FD_SET (fd, args->read_fds);
+          result++;
+        }
+      if ((fds[i].events & POLLOUT)
+          && (fds[i].revents & (POLLOUT | POLLERR)))
+        {
+          FD_SET (fd, args->write_fds);
+          result++;
+        }
+      if ((fds[i].events & POLLPRI) && (fds[i].revents & POLLPRI))
+        {
+          FD_SET (fd, args->except_fds);
+          result++;
+        }
+    }
+
+  args->wakeup_ready = !!(fds[count].revents & (POLLIN | POLLHUP | POLLERR));
+  args->result = result + args->wakeup_ready;
+  return NULL;
+}
 
