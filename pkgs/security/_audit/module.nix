##! Package-owned Linux audit configuration and services.
{
  config,
  lib,
  package,
  ...
}: let
  cfg = config.aos.security.audit;
  files = config.aos.abilities.configuration.operations.file.effects;
  services = config.aos.abilities.serviceManagement.operations.realize.effects;

  command = entryPoint: arguments: {
    executable = {
      path = "${package}/${entryPoint}";
      inherit arguments;
    };
    ignore_failure = false;
  };

  rulesText = ''
    ## Generated by the package-owned audit ability module.
    ## Do not edit manually.

    -b ${toString cfg.backlogLimit}
    -f ${toString cfg.failureMode}

    ${builtins.concatStringsSep "\n" cfg.rules}
  '';
  daemonConfigurationText = ''
    # Generated by the package-owned audit ability module.
    log_file = /var/log/audit/audit.log
    log_format = ENRICHED
    log_group = root
    priority_boost = 4
    flush = INCREMENTAL_ASYNC
    freq = 50
    num_logs = 5
    max_log_file = 50
    max_log_file_action = ROTATE
    space_left = 75
    space_left_action = SYSLOG
    admin_space_left = 50
    admin_space_left_action = SUSPEND
    disk_full_action = SUSPEND
    disk_error_action = SUSPEND
  '';

  daemonService = {
    service = "auditd";
    lifecycle = {
      description = "Linux Audit Daemon";
      execution_model = "foreground";
      environment_files = [];
      condition = [];
      pre_start = [];
      start = [(command "sbin/auditd" ["-n"])];
      post_start = [];
      stop = [];
      post_stop = [];
      restart = "on-failure";
      restart_delay_millis = 5000;
      configuration_change_action = "reload";
      remain_after_exit = false;
      start_timeout_millis = 90000;
      stop_timeout_millis = 90000;
    };
    dependencies = {
      after = [];
      before = [];
      requires = [];
      wants = [];
      prerequisites = [files.audit-daemon.outputs.resource];
    };
    reload = {
      strategy = "signal";
      commands = [];
      signal = "HUP";
      completion = "command-exit";
    };
    directories.managed = [
      {
        path = "audit";
        purpose = "logs";
        mode = "0700";
        retention = "persistent";
        owner = "root";
        group = "root";
      }
    ];
    isolation = {
      privilege = "privileged";
      filesystem = "host";
      network = "host";
      process_visibility = "host";
      termination_scope = "all-processes";
      temporary_directory = "shared";
      devices = [];
      host_paths = [];
      permit_core_dumps = true;
    };
  };
  rulesService = {
    service = "audit-rules";
    lifecycle = {
      description = "Load Audit Rules";
      execution_model = "oneshot";
      environment_files = [];
      condition = [];
      pre_start = [];
      start = [(command "libexec/aos-audit-rules" ["/etc/audit/audit.rules"])];
      post_start = [];
      stop = [];
      post_stop = [];
      restart = "never";
      restart_delay_millis = 0;
      configuration_change_action = "restart";
      remain_after_exit = true;
      start_timeout_millis = 90000;
      stop_timeout_millis = 90000;
    };
    dependencies = {
      after = [];
      before = [];
      requires = [];
      wants = [];
      prerequisites = [
        files.audit-rules.outputs.resource
        services."audit.auditd".outputs.resource
      ];
    };
    isolation = {
      privilege = "privileged";
      filesystem = "host";
      network = "host";
      process_visibility = "host";
      termination_scope = "all-processes";
      temporary_directory = "shared";
      devices = [];
      host_paths = [];
      permit_core_dumps = true;
    };
  };
in {
  options.aos.security.audit = {
    enable = lib.mkOption {
      extensible = true;
      type = lib.types.bool;
      default = true;
      description = "Enable the Linux audit framework and its rule loader.";
    };
    rules = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      default = [
        "-a always,exit -F arch=b64 -S execve -k exec"
        "-a always,exit -F arch=b64 -S init_module -S finit_module -S delete_module -k modules"
        "-a always,exit -F arch=b64 -S mount -S umount2 -k mounts"
        "-w /etc/passwd -p wa -k user_modification"
        "-w /etc/group -p wa -k group_modification"
        "-w /etc/shadow -p wa -k shadow_modification"
        "-w /etc/gshadow -p wa -k gshadow_modification"
        "-w /etc/selinux/ -p wa -k selinux_policy"
        "-a always,exit -F arch=b64 -S sethostname -S setdomainname -k network_config"
        "-w /etc/hostname -p wa -k network_config"
        "-w /etc/ssh/sshd_config -p wa -k sshd_config"
        "-w /var/log/audit/ -p wa -k audit_log"
        "-w /etc/sudoers -p wa -k sudoers"
        "-w /etc/sudoers.d/ -p wa -k sudoers"
        "-a always,exit -F arch=b64 -S adjtimex -S settimeofday -k time_change"
        "-w /etc/localtime -p wa -k time_change"
      ];
      description = "Audit rules in auditctl(8) format.";
    };
    backlogLimit = lib.mkOption {
      type = lib.types.ints.between 1 9007199254740991;
      default = 8192;
      description = "Kernel audit backlog buffer size.";
    };
    failureMode = lib.mkOption {
      type = lib.types.ints.between 0 2;
      default = 1;
      description = "Kernel audit failure action: silent, printk, or panic.";
    };
  };

  config = lib.mkMerge [
    {
      aos.services = {
        "audit.auditd" = lib.mkMerge [(lib.mkDefault daemonService) {enable = lib.mkDefault cfg.enable;}];
        "audit.audit-rules" = lib.mkMerge [(lib.mkDefault rulesService) {enable = lib.mkDefault cfg.enable;}];
      };
    }
    (lib.mkIf cfg.enable {
      system.checks.audit = import ./runtime-tests.nix {};
      aos.abilities.configuration.operations.file.effects = {
        audit-daemon.input = {
          path = "/etc/audit/auditd.conf";
          content = daemonConfigurationText;
          mode = "0640";
        };
        audit-rules.input = {
          path = "/etc/audit/audit.rules";
          content = rulesText;
          mode = "0444";
        };
      };
      aos.kernel.commandLineParts.audit = ["audit=1"];
    })
  ];
}
