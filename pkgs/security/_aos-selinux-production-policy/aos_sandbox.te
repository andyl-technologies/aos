module aos_sandbox 1.0;

require {
    role system_r;

    attribute domain;
    attribute aos_explicit_loader_domain;
    attribute aos_no_context_translation_domain;
    attribute file_type;
    type init_t;
    type device_t;
    type fixed_disk_device_t;
    type fuse_device_t;
    type fs_t;
    type lib_t;
    type ld_so_t;
    type proc_t;
    type root_t;
    type security_t;
    type sysctl_t;
    type sysctl_kernel_t;
    type tmpfs_t;
    type usr_t;
    type var_lib_t;
    type var_t;
    type cgroup_t;
    type devpts_t;
    type ptmx_t;
    type null_device_t;
    type random_device_t;
    type urandom_device_t;
    type sysfs_t;
    type init_runtime_t;

    class blk_file getattr;
    class capability { chown dac_override fowner fsetid kill setgid setuid sys_admin sys_chroot sys_ptrace };
    class cap_userns { chown dac_override fowner fsetid kill setgid setuid };
    class chr_file { getattr ioctl open read write };
    class dir { add_name create getattr open read relabelfrom relabelto remove_name rename rmdir search setattr write };
    class fd use;
    class fifo_file { append create getattr ioctl open read relabelto unlink write };
    class file { append create entrypoint execute execute_no_trans getattr ioctl link lock map open read relabelfrom relabelto rename setattr unlink write };
    class filesystem { associate getattr };
    class lnk_file { create getattr read relabelfrom relabelto rename setattr unlink };
    class process { fork getcap getattr getpgid getsched noatsecure ptrace rlimitinh setexec setfscreate setpgid setrlimit setsched setsockcreate sigchld siginh sigkill signal sigstop transition };
    class process2 { nnp_transition nosuid_transition };
    class security read_policy;
    class memfd_file { getattr ioctl map open read };
    class sock_file { create getattr open read rename setattr unlink write };
    class unix_stream_socket { accept bind connect connectto create getattr getopt ioctl listen read setopt shutdown write };
}

# The fixed image worker has no pathname-opened FUSE, Cache, Root or channel
# authority. Mount labels and retains its original preparation objects before
# transfer; PID 1's sealed five-role launch narrows otherwise type-wide fd use.
type aos_filesystem_fuse_worker_t;
typeattribute aos_filesystem_fuse_worker_t domain;
typeattribute aos_filesystem_fuse_worker_t aos_explicit_loader_domain;
typeattribute aos_filesystem_fuse_worker_t aos_no_context_translation_domain;
role system_r types aos_filesystem_fuse_worker_t;
type aos_filesystem_fuse_worker_exec_t;
type aos_filesystem_fuse_worker_plan_t;
type aos_filesystem_fuse_worker_channel_t;
type aos_filesystem_fuse_worker_cancel_t;

allow init_t aos_filesystem_fuse_worker_exec_t:file { execute getattr map open read };
allow init_t aos_filesystem_fuse_worker_t:process transition;
allow init_t aos_filesystem_fuse_worker_t:process2 nnp_transition;
allow aos_filesystem_fuse_worker_t aos_filesystem_fuse_worker_exec_t:file { entrypoint execute getattr map open read };
type_transition init_t aos_filesystem_fuse_worker_exec_t:process aos_filesystem_fuse_worker_t;
allow aos_filesystem_fuse_worker_t init_t:fd use;
# Only writes to already inherited logging streams; no connect/read is added.
allow aos_filesystem_fuse_worker_t init_t:unix_stream_socket write;

# The socket-creation context is used only by Mount's synchronous fenced
# producer. Object types deliberately do not join generic file_type grants.
allow init_t self:process setsockcreate;
allow init_t aos_filesystem_fuse_worker_channel_t:unix_stream_socket { create getattr getopt read setopt write };
allow aos_filesystem_fuse_worker_t aos_filesystem_fuse_worker_channel_t:unix_stream_socket { getattr getopt read write };
allow init_t aos_filesystem_fuse_worker_plan_t:file { getattr map open read relabelto setattr write };
allow init_t aos_filesystem_fuse_worker_cancel_t:fifo_file { getattr open read relabelto unlink write };
allow aos_filesystem_fuse_worker_plan_t tmpfs_t:filesystem associate;
allow aos_filesystem_fuse_worker_cancel_t tmpfs_t:filesystem associate;
allow aos_filesystem_fuse_worker_t aos_filesystem_fuse_worker_plan_t:file { getattr map read };
allow aos_filesystem_fuse_worker_t aos_filesystem_fuse_worker_cancel_t:fifo_file { getattr read };
allow aos_filesystem_fuse_worker_t fuse_device_t:chr_file { getattr read write };

# The worker observes its own startup table/subject and immutable image.
# Other tasks' proc files retain their subject types and are not readable.
allow aos_filesystem_fuse_worker_t self:dir { getattr open read search };
allow aos_filesystem_fuse_worker_t self:file { getattr open read };
allow aos_filesystem_fuse_worker_t self:lnk_file { getattr read };
allow aos_filesystem_fuse_worker_t proc_t:dir { getattr open read search };
allow aos_filesystem_fuse_worker_t proc_t:file { getattr open read };
# KernelBootId reads the fixed boot_id sysctl. These type-wide reads do not
# permit writing kernel settings; the sealed worker selects the exact path.
allow aos_filesystem_fuse_worker_t sysctl_t:dir search;
allow aos_filesystem_fuse_worker_t sysctl_kernel_t:dir search;
allow aos_filesystem_fuse_worker_t sysctl_kernel_t:file { getattr open read };
allow aos_filesystem_fuse_worker_t root_t:dir { getattr search };
allow aos_filesystem_fuse_worker_t usr_t:dir search;
# The actual transport and libfuse SONAME links live in the immutable store;
# context_plan labels their symlink inodes usr_t, not their lib_t targets.
allow aos_filesystem_fuse_worker_t usr_t:lnk_file { getattr read };
allow aos_filesystem_fuse_worker_t lib_t:dir search;
allow aos_filesystem_fuse_worker_t lib_t:file { execute getattr map open read };
allow aos_filesystem_fuse_worker_t ld_so_t:file { execute getattr map open read };
allow aos_filesystem_fuse_worker_t fs_t:filesystem getattr;
allow aos_filesystem_fuse_worker_t security_t:dir search;
allow aos_filesystem_fuse_worker_t security_t:file { getattr open read };

# AOS privileged processes use distinct domains. The Network publisher is the
# long-lived aos-netd broker; the namespace inspector and lifecycle worker are
# separate fixed executables even though they ship in the same package.
type aos_sandbox_host_t;
typeattribute aos_sandbox_host_t domain;
role system_r types aos_sandbox_host_t;

# Host pins the worker's actual immutable executable before submitting the
# fixed role table. This type-wide inspection grant is narrowed by its closed
# EROFS image path/inode checks; it grants neither execution nor modification.
allow aos_sandbox_host_t aos_filesystem_fuse_worker_exec_t:file { getattr open read };

# Host reads the retained worker's real post-exec attr/current, not the
# channel's creation label or a SID string asserted in HELLO. Its pidfd,
# invocation and exact cgroup sandwich separately binds this type-wide read.
allow aos_sandbox_host_t aos_filesystem_fuse_worker_t:process getattr;
allow aos_sandbox_host_t aos_filesystem_fuse_worker_t:dir { getattr search };
allow aos_sandbox_host_t aos_filesystem_fuse_worker_t:file { getattr open read };

type aos_sandbox_network_publisher_t;
typeattribute aos_sandbox_network_publisher_t domain;
role system_r types aos_sandbox_network_publisher_t;

type aos_sandbox_namespace_inspector_t;
typeattribute aos_sandbox_namespace_inspector_t domain;
role system_r types aos_sandbox_namespace_inspector_t;

type aos_sandbox_network_lifecycle_worker_t;
typeattribute aos_sandbox_network_lifecycle_worker_t domain;
role system_r types aos_sandbox_network_lifecycle_worker_t;

type aos_sandbox_runtime_roots_t;
typeattribute aos_sandbox_runtime_roots_t domain;
role system_r types aos_sandbox_runtime_roots_t;

type aos_sandbox_runtime_roots_handoff_t;
typeattribute aos_sandbox_runtime_roots_handoff_t domain;
role system_r types aos_sandbox_runtime_roots_handoff_t;

# The existing cap-empty Guest publisher is not the long-lived Storage broker.
# It has a dedicated binary; its exact normal template selects this context.
type aos_sandbox_guest_root_publisher_t;
typeattribute aos_sandbox_guest_root_publisher_t domain;
role system_r types aos_sandbox_guest_root_publisher_t;
type aos_sandbox_guest_root_publisher_exec_t;
allow init_t aos_sandbox_guest_root_publisher_exec_t:file { execute getattr map open read };
allow init_t aos_sandbox_guest_root_publisher_t:process transition;
allow init_t aos_sandbox_guest_root_publisher_t:process2 nnp_transition;
allow aos_sandbox_guest_root_publisher_t aos_sandbox_guest_root_publisher_exec_t:file entrypoint;
type_transition init_t aos_sandbox_guest_root_publisher_exec_t:process aos_sandbox_guest_root_publisher_t;

# The outer nspawn supervisor and shifted guest payload are separate enforcing
# subjects. Only the supervisor is granted mount/chroot capability by this
# module; the payload cannot inherit that AOS-specific authority.
type aos_nspawn_t;
typeattribute aos_nspawn_t domain;
role system_r types aos_nspawn_t;

type aos_sandbox_payload_t;
typeattribute aos_sandbox_payload_t domain;
typeattribute aos_sandbox_payload_t aos_explicit_loader_domain;
role system_r types aos_sandbox_payload_t;

# UID zero remains a Tenant. Only the existing fixed Guest owner inherits this
# separate subject before first exec; no Tenant entrypoint can enter it.
type aos_sandbox_guest_owner_t;
typeattribute aos_sandbox_guest_owner_t domain;
typeattribute aos_sandbox_guest_owner_t aos_explicit_loader_domain;
role system_r types aos_sandbox_guest_owner_t;

# None of these protected workspace types joins file_type. In particular, the
# base unconfined file matrix cannot turn a Tenant UID-zero process into a
# writer of the copied loader, libraries, units, credentials, or runtime TCB.
type aos_sandbox_guest_owner_exec_t;
type aos_sandbox_guest_store_t;
type aos_sandbox_guest_anchor_t;
type aos_sandbox_guest_config_t;
type aos_sandbox_guest_runtime_metadata_t;
type aos_sandbox_guest_private_t;
type aos_sandbox_guest_publication_t;
type aos_sandbox_guest_tenant_data_t;
type aos_sandbox_guest_pty_t;

# These labels are for the two copied workspace inodes, not their Nix-store
# source binaries. A runtime publisher must apply and read back both labels.
type aos_sandbox_payload_bootstrap_exec_t;
type aos_sandbox_payload_systemd_exec_t;

# Exact persistent ZFS and fresh runtime tmpfs association, without joining
# the protected objects to file_type's generic UID-zero write matrix.
allow {
    aos_sandbox_payload_bootstrap_exec_t
    aos_sandbox_payload_systemd_exec_t
    aos_sandbox_guest_owner_exec_t
    aos_sandbox_guest_store_t
    aos_sandbox_guest_anchor_t
    aos_sandbox_guest_config_t
    aos_sandbox_guest_runtime_metadata_t
    aos_sandbox_guest_private_t
    aos_sandbox_guest_publication_t
    aos_sandbox_guest_tenant_data_t
} { fs_t tmpfs_t }:filesystem associate;
allow aos_sandbox_guest_pty_t devpts_t:filesystem associate;

type aos_sandbox_host_exec_t;
type aos_sandbox_network_publisher_exec_t;
type aos_sandbox_namespace_inspector_exec_t;
type aos_sandbox_network_lifecycle_worker_exec_t;
type aos_sandbox_runtime_roots_exec_t;
type aos_sandbox_runtime_roots_handoff_exec_t;
type aos_nspawn_exec_t;

# PID 1 alone enters each fixed domain through its labeled executable.
allow init_t aos_sandbox_host_exec_t:file { execute getattr map open read };
allow init_t aos_sandbox_host_t:process transition;
allow aos_sandbox_host_t aos_sandbox_host_exec_t:file entrypoint;
type_transition init_t aos_sandbox_host_exec_t:process aos_sandbox_host_t;

# These fixed services retain NoNewPrivileges; PID 1 may enter only their
# dedicated domains when executing their labeled immutable-store binaries.
allow init_t aos_sandbox_network_publisher_exec_t:file { execute getattr map open read };
allow init_t aos_sandbox_network_publisher_t:process transition;
allow init_t aos_sandbox_network_publisher_t:process2 nnp_transition;
allow aos_sandbox_network_publisher_t aos_sandbox_network_publisher_exec_t:file entrypoint;
type_transition init_t aos_sandbox_network_publisher_exec_t:process aos_sandbox_network_publisher_t;

allow init_t aos_sandbox_namespace_inspector_exec_t:file { execute getattr map open read };
allow init_t aos_sandbox_namespace_inspector_t:process transition;
allow init_t aos_sandbox_namespace_inspector_t:process2 nnp_transition;
# ELF segments are mapped after the new inspector SID takes effect.
allow aos_sandbox_namespace_inspector_t aos_sandbox_namespace_inspector_exec_t:file { entrypoint execute map read };
# PID 1 opens both the executable and the accepted socket. fd:use cannot name
# individual descriptors; startup admits only the exact socket/journal FDs,
# while the inspector has no ptrace authority to fetch other PID 1 FDs.
allow aos_sandbox_namespace_inspector_t init_t:fd use;
# This type-wide grant permits writes to inherited init_t streams. The pinned
# unit and startup FD contract narrow those streams to journal stderr; socket
# pathname writes and new connections remain forbidden by the policy checks.
allow aos_sandbox_namespace_inspector_t init_t:unix_stream_socket write;
type_transition init_t aos_sandbox_namespace_inspector_exec_t:process aos_sandbox_namespace_inspector_t;

# SELinux labels the enforcement file security_t. These type-wide reads support
# its fixed-path query, not pathname-specific authority; directory enumeration,
# mutations, SELinux control, and policy readback remain forbidden.
allow aos_sandbox_namespace_inspector_t security_t:dir search;
allow aos_sandbox_namespace_inspector_t security_t:file { getattr open read };

allow init_t aos_sandbox_network_lifecycle_worker_exec_t:file { execute getattr map open read };
allow init_t aos_sandbox_network_lifecycle_worker_t:process transition;
allow init_t aos_sandbox_network_lifecycle_worker_t:process2 nnp_transition;
allow aos_sandbox_network_lifecycle_worker_t aos_sandbox_network_lifecycle_worker_exec_t:file entrypoint;
type_transition init_t aos_sandbox_network_lifecycle_worker_exec_t:process aos_sandbox_network_lifecycle_worker_t;

# A distinct, immutable stage0 copy receives only executable custody. The
# launcher closes its inherited descriptors before this transition; the FD
# permission is needed for the kernel's post-transition ELF mapping.
allow init_t aos_sandbox_runtime_roots_handoff_exec_t:file { execute getattr map open read };
allow init_t aos_sandbox_runtime_roots_handoff_t:process transition;
allow aos_sandbox_runtime_roots_handoff_t init_t:fd use;
allow aos_sandbox_runtime_roots_handoff_t aos_sandbox_runtime_roots_handoff_exec_t:file { entrypoint execute map read };
type_transition init_t aos_sandbox_runtime_roots_handoff_exec_t:process aos_sandbox_runtime_roots_handoff_t;

# The handoff may read only the immutable root and kernel admission inputs,
# then execute the physically verified provisioner. No mutable root authority
# is present until the second transition succeeds.
allow aos_sandbox_runtime_roots_handoff_t root_t:dir { getattr open read search };
allow aos_sandbox_runtime_roots_handoff_t fs_t:filesystem getattr;
allow aos_sandbox_runtime_roots_handoff_t proc_t:filesystem getattr;
allow aos_sandbox_runtime_roots_handoff_t proc_t:dir { getattr open read search };
allow aos_sandbox_runtime_roots_handoff_t proc_t:file { getattr open read };
allow aos_sandbox_runtime_roots_handoff_t security_t:filesystem getattr;
allow aos_sandbox_runtime_roots_handoff_t security_t:dir { getattr open read search };
allow aos_sandbox_runtime_roots_handoff_t security_t:file { getattr open read };
# Both sealed stage0 modes compare the selected kernel policy with the
# embedded expected bytes before admitting any mutable runtime root.
allow aos_sandbox_runtime_roots_handoff_t security_t:security read_policy;
allow aos_sandbox_runtime_roots_handoff_t aos_sandbox_runtime_roots_exec_t:file { execute getattr map open read };
allow aos_sandbox_runtime_roots_handoff_t aos_sandbox_runtime_roots_t:process { noatsecure rlimitinh siginh transition };

# The provisioner uses only the handoff-opened executable FD. It never gains
# use of arbitrary init_t descriptors or the handoff's immutable-root search.
allow aos_sandbox_runtime_roots_t aos_sandbox_runtime_roots_handoff_t:fd use;
allow aos_sandbox_runtime_roots_t aos_sandbox_runtime_roots_exec_t:file { entrypoint execute map read };
type_transition aos_sandbox_runtime_roots_handoff_t aos_sandbox_runtime_roots_exec_t:process aos_sandbox_runtime_roots_t;
allow aos_sandbox_runtime_roots_t self:process setfscreate;

# PID 1 enters the supervisor domain through the fixed packaged nspawn.
# Patched nspawn first execs guest-init under --selinux-context; guest-init
# replaces itself with the copied guest systemd without another transition.
allow init_t aos_nspawn_exec_t:file { execute getattr map open read };
allow init_t aos_nspawn_t:process transition;
allow aos_nspawn_t aos_nspawn_exec_t:file entrypoint;
type_transition init_t aos_nspawn_exec_t:process aos_nspawn_t;
allow aos_nspawn_t self:capability { sys_admin sys_chroot };
allow aos_nspawn_t self:process setexec;
allow aos_nspawn_t aos_sandbox_guest_owner_t:process transition;
allow aos_nspawn_t aos_sandbox_guest_owner_t:process2 { nnp_transition nosuid_transition };
allow aos_nspawn_t aos_sandbox_payload_bootstrap_exec_t:file { execute getattr map open read };
allow aos_sandbox_guest_owner_t aos_sandbox_payload_bootstrap_exec_t:file entrypoint;
allow aos_sandbox_guest_owner_t aos_sandbox_payload_systemd_exec_t:file { execute execute_no_trans getattr map open read };

# The existing zero-cap Guest publisher runs in its own domain. Linux delegates
# valid security.selinux xattr changes to relabel policy without CAP_MAC_ADMIN.
# The kernel still checks ownership and relabelfrom on the copied source type;
# only these two exact destination types are granted here. Storage and Host
# subsequently read the physical xattrs before trusting a publication.
allow aos_sandbox_guest_root_publisher_t aos_sandbox_payload_bootstrap_exec_t:file { getattr open read relabelto };
allow aos_sandbox_guest_root_publisher_t aos_sandbox_payload_systemd_exec_t:file { getattr open read relabelto };
allow aos_sandbox_host_t aos_sandbox_payload_bootstrap_exec_t:file { getattr open read };
allow aos_sandbox_host_t aos_sandbox_payload_systemd_exec_t:file { getattr open read };

# pidfs namespace ioctls use file read/ioctl against the target task SID.
# Host's unit sandbox still carries no CAP_SYS_PTRACE or CAP_SYS_ADMIN.
allow aos_sandbox_host_t aos_sandbox_payload_t:file { ioctl read };
allow aos_sandbox_host_t aos_sandbox_guest_owner_t:file { ioctl read };

# The existing fixed guest-root publisher, not the Storage broker or init_t,
# projects and reads back the immutable substrate. Its entrypoint/domain is
# installed by the existing-owner confinement policy; these are only its exact
# Guest output types. Runtime Owner projection remains a separate fresh-mount cut.
allow aos_sandbox_guest_root_publisher_t { aos_sandbox_guest_owner_exec_t aos_sandbox_guest_store_t aos_sandbox_guest_anchor_t aos_sandbox_guest_config_t aos_sandbox_guest_private_t aos_sandbox_guest_publication_t }:dir { getattr open read relabelto search };
allow aos_sandbox_guest_root_publisher_t { aos_sandbox_guest_owner_exec_t aos_sandbox_guest_store_t aos_sandbox_guest_config_t aos_sandbox_guest_runtime_metadata_t aos_sandbox_guest_private_t aos_sandbox_guest_publication_t }:file { getattr open read relabelto };
allow aos_sandbox_guest_root_publisher_t { aos_sandbox_guest_store_t aos_sandbox_guest_config_t aos_sandbox_guest_private_t }:lnk_file { getattr read relabelto };
allow aos_sandbox_host_t { aos_sandbox_guest_anchor_t aos_sandbox_guest_store_t aos_sandbox_guest_config_t aos_sandbox_guest_private_t aos_sandbox_guest_publication_t }:dir { getattr open read search };
allow aos_sandbox_host_t { aos_sandbox_guest_owner_exec_t aos_sandbox_guest_store_t aos_sandbox_guest_config_t aos_sandbox_guest_runtime_metadata_t aos_sandbox_guest_private_t aos_sandbox_guest_publication_t }:file { getattr open read };
allow aos_sandbox_host_t { aos_sandbox_guest_store_t aos_sandbox_guest_config_t aos_sandbox_guest_private_t }:lnk_file { getattr read };

# Marker format, signature and write ordering are unchanged. Only this fixed
# existing publisher creates the temporary file and renames it within the
# separately projected publication directory; no private-tree writer is added.
allow aos_sandbox_guest_root_publisher_t aos_sandbox_guest_publication_t:dir { add_name getattr open read remove_name search write };
allow aos_sandbox_guest_root_publisher_t aos_sandbox_guest_publication_t:file { create getattr open read rename setattr unlink write };
type_transition aos_sandbox_guest_root_publisher_t aos_sandbox_guest_publication_t:file aos_sandbox_guest_publication_t;
allow aos_sandbox_guest_owner_t aos_sandbox_guest_publication_t:dir { getattr open read search };
allow aos_sandbox_guest_owner_t aos_sandbox_guest_publication_t:file { getattr open read };

allow aos_sandbox_guest_owner_t self:process { fork getcap getattr getpgid getsched setexec setpgid setrlimit setsched sigchld sigkill signal sigstop };
allow aos_sandbox_guest_owner_t self:file { getattr ioctl open read write };
allow aos_sandbox_guest_owner_t self:dir { getattr open read search };
allow aos_sandbox_guest_owner_t self:lnk_file { getattr read };
allow aos_sandbox_guest_owner_t self:fd use;
allow aos_sandbox_guest_owner_t self:capability { chown dac_override fowner fsetid kill setgid setuid };
allow aos_sandbox_guest_owner_t self:cap_userns { chown dac_override fowner fsetid kill setgid setuid };
allow aos_sandbox_guest_owner_t aos_sandbox_payload_t:process { getattr getpgid sigchld sigkill signal sigstop transition };
allow aos_sandbox_guest_owner_t aos_sandbox_payload_t:process2 { nnp_transition nosuid_transition };
allow aos_sandbox_guest_owner_t aos_sandbox_payload_t:file { getattr ioctl read };

allow aos_sandbox_guest_owner_t aos_sandbox_guest_owner_exec_t:file { execute execute_no_trans getattr map open read };
allow aos_sandbox_guest_owner_t aos_sandbox_guest_store_t:dir { getattr open read search };
allow aos_sandbox_guest_owner_t aos_sandbox_guest_store_t:file { execute execute_no_trans getattr map open read };
allow aos_sandbox_guest_owner_t aos_sandbox_guest_store_t:lnk_file { getattr read };
allow aos_sandbox_guest_owner_t aos_sandbox_guest_anchor_t:dir { add_name getattr open read search write };
allow aos_sandbox_guest_owner_t { aos_sandbox_guest_config_t aos_sandbox_guest_private_t }:dir { add_name create getattr open read remove_name search write };
allow aos_sandbox_guest_owner_t { aos_sandbox_guest_config_t aos_sandbox_guest_private_t }:file { append create getattr ioctl lock open read rename setattr unlink write };
allow aos_sandbox_guest_owner_t aos_sandbox_guest_config_t:lnk_file { getattr read };
allow aos_sandbox_guest_owner_t aos_sandbox_guest_runtime_metadata_t:file { getattr open read setattr write };
allow aos_sandbox_guest_owner_t aos_sandbox_guest_private_t:sock_file { create getattr open read rename setattr unlink write };
allow aos_sandbox_guest_owner_t aos_sandbox_guest_private_t:lnk_file { create getattr read rename setattr unlink };
type_transition aos_sandbox_guest_owner_t aos_sandbox_guest_anchor_t:dir aos_sandbox_guest_private_t;
type_transition aos_sandbox_guest_owner_t aos_sandbox_guest_private_t:dir aos_sandbox_guest_private_t;
type_transition aos_sandbox_guest_owner_t aos_sandbox_guest_private_t:file aos_sandbox_guest_private_t;
type_transition aos_sandbox_guest_owner_t aos_sandbox_guest_private_t:sock_file aos_sandbox_guest_private_t;
type_transition aos_sandbox_guest_owner_t aos_sandbox_guest_config_t:dir aos_sandbox_guest_config_t;
type_transition aos_sandbox_guest_owner_t aos_sandbox_guest_config_t:file aos_sandbox_guest_config_t;

# /run and /dev are fresh nspawn mounts, not copied workspace inodes. The fixed
# bootstrap checks its actual Owner SID before relabeling those exact anchors;
# it never relabels tenant data or the immutable closure at runtime.
allow aos_sandbox_guest_owner_t { root_t device_t tmpfs_t }:dir { getattr open read relabelfrom search };
allow aos_sandbox_guest_owner_t var_t:dir { getattr open read search };
allow aos_sandbox_guest_owner_t aos_sandbox_guest_anchor_t:dir relabelto;
# Pinned refpolicy labels /run/systemd as init_runtime_t (init_var_run_t alias).
allow aos_sandbox_guest_owner_t { tmpfs_t init_runtime_t }:dir { getattr open read relabelfrom search };
allow aos_sandbox_guest_owner_t { tmpfs_t init_runtime_t }:file { getattr open read relabelfrom };
allow aos_sandbox_guest_owner_t aos_sandbox_guest_private_t:dir relabelto;
allow aos_sandbox_guest_owner_t aos_sandbox_guest_private_t:file relabelto;
allow aos_nspawn_t aos_sandbox_guest_anchor_t:dir { getattr open read search };
# The supervisor reads the copied interpreter/library closure before changing
# subject. It cannot execute that closure without the explicit transition.
# Only machine-id/resolver metadata has its separate existing setup writer;
# hostname setup is a UTS syscall, not writable loader/NSS/PAM configuration.
allow aos_nspawn_t aos_sandbox_guest_store_t:dir { getattr open read search };
allow aos_nspawn_t aos_sandbox_guest_store_t:file { execute getattr map open read };
allow aos_nspawn_t aos_sandbox_guest_store_t:lnk_file { getattr read };
allow aos_nspawn_t aos_sandbox_guest_config_t:dir { getattr open read search };
allow aos_nspawn_t aos_sandbox_guest_config_t:file { getattr open read };
allow aos_nspawn_t aos_sandbox_guest_runtime_metadata_t:file { getattr open read setattr write };
allow aos_sandbox_guest_owner_t security_t:dir { getattr open read search };
allow aos_sandbox_guest_owner_t security_t:file { getattr open read };
allow aos_sandbox_guest_owner_t security_t:filesystem getattr;
allow aos_sandbox_guest_owner_t proc_t:dir { getattr open read search };
allow aos_sandbox_guest_owner_t proc_t:file { getattr open read write };
allow aos_sandbox_guest_owner_t proc_t:lnk_file { getattr read };
allow aos_sandbox_guest_owner_t sysfs_t:dir { getattr open read search };
allow aos_sandbox_guest_owner_t sysfs_t:file { getattr open read };
allow aos_sandbox_guest_owner_t cgroup_t:dir { add_name create getattr open read remove_name search setattr write };
allow aos_sandbox_guest_owner_t cgroup_t:file { getattr open read setattr write };
allow aos_sandbox_guest_owner_t { cgroup_t devpts_t proc_t sysfs_t tmpfs_t }:filesystem getattr;
allow aos_sandbox_guest_owner_t { null_device_t random_device_t urandom_device_t devpts_t }:chr_file { getattr ioctl open read write };
allow aos_sandbox_guest_owner_t ptmx_t:chr_file { getattr ioctl open read write };
type_transition aos_sandbox_guest_owner_t devpts_t:chr_file aos_sandbox_guest_pty_t;
allow { aos_sandbox_guest_owner_t aos_sandbox_payload_t } aos_sandbox_guest_pty_t:chr_file { getattr ioctl open read write };
allow aos_sandbox_guest_owner_t self:fifo_file { create getattr ioctl open read write };
allow aos_sandbox_guest_owner_t self:unix_stream_socket { accept bind connect connectto create getattr getopt ioctl listen read setopt shutdown write };
allow aos_sandbox_guest_owner_t aos_sandbox_host_t:fd use;
allow aos_sandbox_guest_owner_t aos_nspawn_t:fd use;
allow aos_sandbox_guest_owner_t { aos_sandbox_host_t aos_nspawn_t }:file { getattr ioctl map open read };
allow aos_sandbox_guest_owner_t { aos_sandbox_host_t aos_nspawn_t }:memfd_file { getattr ioctl map open read };
# Linux maps both AF_UNIX stream and seqpacket transports to this class.
allow aos_sandbox_guest_owner_t aos_sandbox_host_t:unix_stream_socket { connectto getattr getopt ioctl read setopt shutdown write };
allow aos_sandbox_guest_owner_t { aos_sandbox_guest_anchor_t aos_sandbox_guest_tenant_data_t }:dir { getattr search };
allow aos_sandbox_guest_owner_t { file_type aos_sandbox_guest_tenant_data_t }:file { execute getattr };
allow aos_sandbox_guest_owner_t file_type:dir { getattr search };

# An explicit Owner->Tenant exec may target the readonly package closure or
# mutable tenant data. No default transition or Tenant->Owner edge exists.
# Generic host file types are not execution inputs. The copied closure is
# projected to guest_store_t; mutable Tenant files use tenant_data_t.
allow aos_sandbox_payload_t aos_sandbox_guest_tenant_data_t:file { append create entrypoint execute execute_no_trans getattr ioctl lock map open read rename setattr unlink write };
allow aos_sandbox_payload_t aos_sandbox_guest_store_t:file { entrypoint execute execute_no_trans getattr map open read };
allow aos_sandbox_payload_t aos_sandbox_guest_store_t:dir { getattr open read search };
allow aos_sandbox_payload_t aos_sandbox_guest_store_t:lnk_file { getattr read };
allow aos_sandbox_payload_t aos_sandbox_guest_config_t:dir { getattr open read search };
allow aos_sandbox_payload_t aos_sandbox_guest_config_t:file { getattr open read };
allow aos_sandbox_payload_t aos_sandbox_guest_runtime_metadata_t:file { getattr open read };
allow aos_sandbox_payload_t aos_sandbox_guest_anchor_t:dir { add_name getattr open read remove_name search write };
allow aos_sandbox_payload_t aos_sandbox_guest_tenant_data_t:dir { add_name create getattr open read remove_name rename rmdir search setattr write };
allow aos_sandbox_payload_t aos_sandbox_guest_tenant_data_t:lnk_file { create getattr read rename setattr unlink };
type_transition aos_sandbox_payload_t aos_sandbox_guest_anchor_t:dir aos_sandbox_guest_tenant_data_t;
type_transition aos_sandbox_payload_t aos_sandbox_guest_anchor_t:file aos_sandbox_guest_tenant_data_t;
type_transition aos_sandbox_payload_t aos_sandbox_guest_tenant_data_t:dir aos_sandbox_guest_tenant_data_t;
type_transition aos_sandbox_payload_t aos_sandbox_guest_tenant_data_t:file aos_sandbox_guest_tenant_data_t;
type_transition aos_sandbox_payload_t aos_sandbox_guest_tenant_data_t:lnk_file aos_sandbox_guest_tenant_data_t;
allow aos_sandbox_payload_t self:process { fork getcap getattr getpgid getsched setpgid setrlimit setsched sigchld sigkill signal sigstop };
allow aos_sandbox_payload_t self:fd use;
allow aos_sandbox_payload_t self:file { getattr ioctl open read write };
allow aos_sandbox_payload_t self:dir { getattr open read search };
allow aos_sandbox_payload_t self:lnk_file { getattr read };
allow aos_sandbox_payload_t self:fifo_file { create getattr ioctl open read write };
allow aos_sandbox_payload_t self:capability { chown dac_override fowner fsetid kill setgid setuid };
allow aos_sandbox_payload_t self:cap_userns { chown dac_override fowner fsetid kill setgid setuid };

# fd:use is a domain pair, not an FD-number filter. The measured exec helper
# closes every >=3 entry. Actual FIFO/PTY object checks admit only stdio; there
# is deliberately no Tenant->Owner regular-file read/map or ptrace permission.
allow aos_sandbox_payload_t aos_sandbox_guest_owner_t:fd use;
allow aos_sandbox_payload_t aos_sandbox_guest_owner_t:fifo_file { getattr ioctl open read write };
allow aos_sandbox_payload_t { null_device_t random_device_t urandom_device_t devpts_t }:chr_file { getattr ioctl open read write };

# The static provisioner observes only its immutable execution substrate,
# SELinux state, own proc attributes, and the two fixed /var device names.
allow aos_sandbox_runtime_roots_t root_t:dir { getattr open read search };
# fstatfs on the selected /var root checks its ext4 superblock SID.
allow aos_sandbox_runtime_roots_t fs_t:filesystem getattr;
allow aos_sandbox_runtime_roots_t security_t:filesystem getattr;
allow aos_sandbox_runtime_roots_t security_t:dir { getattr open read search };
allow aos_sandbox_runtime_roots_t security_t:file { getattr open read };
allow aos_sandbox_runtime_roots_t security_t:security read_policy;
allow aos_sandbox_runtime_roots_t proc_t:filesystem getattr;
allow aos_sandbox_runtime_roots_t proc_t:dir { getattr open read search };
allow aos_sandbox_runtime_roots_t proc_t:file { getattr open read write };
allow aos_sandbox_runtime_roots_t device_t:dir { getattr open read search };
allow aos_sandbox_runtime_roots_t device_t:lnk_file { getattr read };
# The fixed /var symlink may resolve to a devtmpfs node still labeled device_t.
# Only its metadata is needed to compare the mounted ext4 device identity.
allow aos_sandbox_runtime_roots_t device_t:blk_file getattr;
allow aos_sandbox_runtime_roots_t fixed_disk_device_t:blk_file getattr;

type aos_sandbox_network_root_t;
type aos_sandbox_network_state_t;

# The protected inspector store has four non-aliasing directory roles. A record
# is born with its final role type in staging because rename preserves the inode
# type. These protected object types deliberately do not join the base policy's
# broad file_type attribute: all required access is enumerated below, and an
# inherited files_unconfined_type-to-file_type allow would bypass that matrix.
# fs-verity, not a post-rename type change, rejects later content writes.
type aos_sandbox_network_expected_staging_t;
type aos_sandbox_network_expected_final_t;
type aos_sandbox_network_expected_record_t;

type aos_sandbox_network_spent_staging_t;
type aos_sandbox_network_spent_final_t;
type aos_sandbox_network_spent_record_t;

type aos_sandbox_network_store_t;

# These deliberately non-file_type objects still need to join the selected
# ext4 superblock when a protected directory or record inode is created.
# Enumerate only that association; file_type would inherit broad base grants.
allow {
    aos_sandbox_network_root_t
    aos_sandbox_network_state_t
    aos_sandbox_network_store_t
    aos_sandbox_network_expected_staging_t
    aos_sandbox_network_expected_final_t
    aos_sandbox_network_expected_record_t
    aos_sandbox_network_spent_staging_t
    aos_sandbox_network_spent_final_t
    aos_sandbox_network_spent_record_t
} fs_t:filesystem associate;

# Only the provisioner can create or validate the fixed descendant tree.
# Parent name creation and child inode creation remain separate and auditable.
allow aos_sandbox_runtime_roots_t var_t:dir { add_name getattr open read search write };
allow aos_sandbox_runtime_roots_t var_lib_t:dir { add_name create getattr open read search write };
allow aos_sandbox_runtime_roots_t aos_sandbox_network_root_t:dir { add_name create getattr open read search write };
allow aos_sandbox_runtime_roots_t aos_sandbox_network_state_t:dir { create getattr open read search };
allow aos_sandbox_runtime_roots_t aos_sandbox_network_store_t:dir { add_name create getattr open read search write };
allow aos_sandbox_runtime_roots_t aos_sandbox_network_expected_staging_t:dir { create getattr open read search };
allow aos_sandbox_runtime_roots_t aos_sandbox_network_expected_final_t:dir { create getattr open read search };
allow aos_sandbox_runtime_roots_t aos_sandbox_network_spent_staging_t:dir { create getattr open read search };
allow aos_sandbox_runtime_roots_t aos_sandbox_network_spent_final_t:dir { create getattr open read search };

# Neither runtime role can rename or remove the four protected roots. They get
# traversal only on the immutable Network parent; the one-shot provisioner
# owns post-mount topology creation.
allow aos_sandbox_network_publisher_t aos_sandbox_network_root_t:dir { getattr open search };
allow aos_sandbox_namespace_inspector_t aos_sandbox_network_root_t:dir { getattr open search };
allow aos_sandbox_network_publisher_t aos_sandbox_network_store_t:dir { getattr open search };
allow aos_sandbox_namespace_inspector_t aos_sandbox_network_store_t:dir { getattr open search };
allow aos_sandbox_network_publisher_t var_t:dir { getattr open search };
allow aos_sandbox_network_publisher_t var_lib_t:dir { getattr open search };
allow aos_sandbox_namespace_inspector_t var_t:dir { getattr open search };
allow aos_sandbox_namespace_inspector_t var_lib_t:dir { getattr open search };

# The broker alone owns its authenticated mutable journal. The fixed root
# cannot itself be renamed or removed because no runtime role can mutate the
# enclosing Network root.
allow aos_sandbox_network_publisher_t aos_sandbox_network_state_t:dir { add_name getattr open read remove_name search write };
allow aos_sandbox_network_publisher_t aos_sandbox_network_state_t:file { append create getattr ioctl lock open read rename setattr unlink write };

# O_CREAT in a staging directory produces the final record type before any
# bytes are written. That type is intentionally preserved by renameat2.
type_transition aos_sandbox_network_publisher_t aos_sandbox_network_expected_staging_t:file aos_sandbox_network_expected_record_t;
type_transition aos_sandbox_namespace_inspector_t aos_sandbox_network_spent_staging_t:file aos_sandbox_network_spent_record_t;

# Expected-policy publication: staging-name removal and final-name addition are
# the distinct Linux rename gates. No rule grants final-directory remove_name.
allow aos_sandbox_network_publisher_t aos_sandbox_network_expected_staging_t:dir { add_name getattr open read remove_name search write };
allow aos_sandbox_network_publisher_t aos_sandbox_network_expected_final_t:dir { add_name getattr open read search write };
allow aos_sandbox_network_publisher_t aos_sandbox_network_expected_record_t:file { create getattr ioctl open read rename write };

# The inspector can only read sealed expected records. Its separate spent
# ledger repeats the append-only staging-to-final publication contract.
allow aos_sandbox_namespace_inspector_t aos_sandbox_network_expected_final_t:dir { getattr open read search };
allow aos_sandbox_namespace_inspector_t aos_sandbox_network_expected_record_t:file { getattr ioctl open read };

allow aos_sandbox_namespace_inspector_t aos_sandbox_network_spent_staging_t:dir { add_name getattr open read remove_name search write };
allow aos_sandbox_namespace_inspector_t aos_sandbox_network_spent_final_t:dir { add_name getattr open read search write };
allow aos_sandbox_namespace_inspector_t aos_sandbox_network_spent_record_t:file { create getattr ioctl open read rename write };

# Linux 6.18 PIDFD_GET_NET_NAMESPACE performs PTRACE_MODE_READ_FSCREDS through
# selinux_ptrace_access_check(), which checks file:read, followed by file:ioctl.
# pidfs assigns the task SID to its pidfd inode, so both accesses are confined
# to this exact inspector-to-lifecycle-worker pair without process:ptrace.
allow aos_sandbox_namespace_inspector_t self:capability sys_ptrace;
allow aos_sandbox_namespace_inspector_t aos_sandbox_network_lifecycle_worker_t:file { ioctl read };
