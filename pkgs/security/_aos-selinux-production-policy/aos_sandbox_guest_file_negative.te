module aos_sandbox_guest_file_negative 1.0;

require {
    type aos_sandbox_guest_owner_t;
    type aos_sandbox_payload_t;
    type cpu_online_t;
    type var_t;

    class file read;
}

# Both axes are indirect. A legitimate CPU-online read must not conceal an
# unrelated host file in the same target attribute or a disabled conditional.
attribute aos_sandbox_negative_guest_reader;
typeattribute aos_sandbox_guest_owner_t aos_sandbox_negative_guest_reader;
typeattribute aos_sandbox_payload_t aos_sandbox_negative_guest_reader;
attribute aos_sandbox_negative_guest_files;
typeattribute cpu_online_t aos_sandbox_negative_guest_files;
typeattribute var_t aos_sandbox_negative_guest_files;

bool aos_sandbox_negative_guest_files_enabled false;
if (aos_sandbox_negative_guest_files_enabled) {
    allow aos_sandbox_negative_guest_reader aos_sandbox_negative_guest_files:file read;
}
