# Explicit unit context only, with the immutable store still mounted nosuid.
allow init_t aos_method46_@ROLE@_initial_exec_t:file { execute execute_no_trans getattr map open read };
allow init_t aos_method46_@ROLE@_initial_t:process { rlimitinh transition };
