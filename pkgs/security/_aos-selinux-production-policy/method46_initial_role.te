# PID1 creates the inherited approval listener with the explicit service SID.
# Root's ordinary administrative transport carries public request/signature
# DATA only. It gains no initial-role FD, proc, stream read/write or TPM rights.
allow init_t aos_method46_@ROLE@_initial_t:unix_stream_socket { bind create getattr getopt listen read setopt shutdown write };
allow init_t aos_method46_@ROLE@_initial_approval_t:sock_file { create getattr open read setattr unlink write };
allow aos_method46_@ROLE@_initial_approval_t tmpfs_t:filesystem associate;
allow aos_method46_@ROLE@_initial_t aos_method46_@ROLE@_initial_approval_t:sock_file getattr;
allow unconfined_t aos_method46_@ROLE@_initial_approval_t:sock_file { getattr open read write };
allow unconfined_t aos_method46_@ROLE@_initial_t:unix_stream_socket connectto;
# The received generated pidfd needs GET_INFO, not the operator's proc files.
allow aos_method46_@ROLE@_initial_t unconfined_t:file ioctl;
allowxperm aos_method46_@ROLE@_initial_t unconfined_t:file ioctl { 0xff0b };

# The fixed executor's output stream has an object-only label. Neither helper
# nor operator can inherit the service's public journal stream through a role.
allow init_t aos_method46_@ROLE@_initial_output_t:unix_stream_socket { connect create getattr getopt read setopt shutdown write };
allow aos_method46_@ROLE@_initial_output_t init_t:unix_stream_socket connectto;
allow aos_method46_@ROLE@_initial_t aos_method46_@ROLE@_initial_output_t:unix_stream_socket { getattr read write };

# Credential creation defaults to init_tmpfs_t; only the fixed delivery roster
# is promoted to this role's readable label by the generated named transitions.
allow aos_method46_@ROLE@_initial_credential_t tmpfs_t:filesystem associate;
allow init_t aos_method46_@ROLE@_initial_credential_t:dir { add_name create getattr mounton open read relabelto remove_name search setattr write };
allow init_t aos_method46_@ROLE@_initial_credential_t:file { create getattr open read setattr unlink write };
type_transition init_t aos_method46_@ROLE@_initial_credential_t:file init_tmpfs_t;
@CREDENTIAL_TRANSITIONS@
allow aos_method46_@ROLE@_initial_t aos_method46_@ROLE@_initial_credential_t:dir { getattr open read search };
allow aos_method46_@ROLE@_initial_t aos_method46_@ROLE@_initial_credential_t:file { getattr open read };

# Main acquisition uses the existing RDWR writer, with no main publication or
# repair permission. The floor exchange requires unlink checks on both inodes;
# the fixed programme preserves the old empty inode and never calls unlink.
allow aos_method46_@ROLE@_initial_t aos_sandbox_@ROLE@_state_t:dir { getattr open read search };
allow aos_method46_@ROLE@_initial_t aos_method46_@ROLE@_floor_t:dir { add_name getattr open read remove_name search write };
allow aos_method46_@ROLE@_initial_t aos_method46_@ROLE@_floor_t:file { append create getattr open read rename setattr unlink write };
allow aos_method46_@ROLE@_initial_t aos_method46_@ROLE@_lock_t:file { create getattr lock open read setattr write };
allow aos_method46_@ROLE@_initial_t aos_method46_@ROLE@_main_t:file { getattr open read write };
allow aos_method46_@ROLE@_initial_t aos_method46_@ROLE@_initial_intent_t:file { create getattr open read rename write };
type_transition aos_method46_@ROLE@_initial_t aos_method46_@ROLE@_floor_t:file aos_method46_@ROLE@_floor_t;
type_transition aos_method46_@ROLE@_initial_t aos_method46_@ROLE@_floor_t:file aos_method46_@ROLE@_lock_t "session.journal.lock";
type_transition aos_method46_@ROLE@_initial_t aos_method46_@ROLE@_floor_t:file aos_method46_@ROLE@_lock_t "session-floor.journal.lock";
type_transition aos_method46_@ROLE@_initial_t aos_method46_@ROLE@_floor_t:file aos_method46_@ROLE@_initial_intent_t "session-floor.initial-intent";
type_transition aos_method46_@ROLE@_initial_t aos_method46_@ROLE@_floor_t:file aos_method46_@ROLE@_initial_intent_t "session-floor.initial-intent.pending";

