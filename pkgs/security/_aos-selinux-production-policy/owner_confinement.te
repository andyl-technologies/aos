allow aos_sandbox_policy_authority_t aos_sandbox_policy_authority_credential_t:file { getattr open read };
# PID 1 labels this fixed unit's credential directory before creating copies.
# This is credential delivery only: Root state remains denied to PID 1, and
# the reader still verifies read-only backing and original named identity.
allow init_t aos_sandbox_policy_authority_credential_t:dir { add_name create getattr mounton open read relabelto remove_name search setattr write };
allow init_t aos_sandbox_policy_authority_credential_t:file { create getattr open read setattr unlink write };
type_transition init_t aos_sandbox_policy_authority_credential_t:file aos_sandbox_policy_authority_credential_t;
