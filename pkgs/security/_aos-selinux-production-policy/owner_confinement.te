# D-Bus transports the existing status-only manager calls. Method authorization
# still checks service/system classes; there is no start/stop/reload grant.
allow aos_sandbox_policy_authority_t system_dbusd_var_run_t:sock_file { getattr open read write };
allow aos_sandbox_policy_authority_t system_dbusd_t:unix_stream_socket connectto;
