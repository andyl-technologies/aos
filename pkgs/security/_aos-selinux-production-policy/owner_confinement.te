# Explicit normal-unit context only: no ELF-based init_t default transition.
# PID 1 may still run the legacy/recovery invocation without that context.
allow init_t aos_sandbox_policy_authority_exec_t:file { execute execute_no_trans getattr map open read };
allow init_t aos_sandbox_policy_authority_t:process transition;
allow init_t aos_sandbox_policy_authority_t:process2 nnp_transition;

# Restore only PID 1's exact pinned domain_read_all_domains_state profile.
# Other interface callers must not inspect normal Root's task files or FDs.
allow init_t aos_sandbox_policy_authority_t:dir { getattr search open read lock ioctl };
allow init_t aos_sandbox_policy_authority_t:file { getattr open read lock ioctl };
allow init_t aos_sandbox_policy_authority_t:lnk_file { getattr read };

allow aos_sandbox_policy_authority_t aos_sandbox_policy_authority_exec_t:file { entrypoint getattr map open read };
allow aos_sandbox_policy_authority_t self:process { fork getattr getsched setrlimit sigchld signal };
allow aos_sandbox_policy_authority_t self:unix_stream_socket { accept bind connect create getattr getopt listen read setopt shutdown write };
allow aos_sandbox_policy_authority_t init_t:fd use;
# Original PID1 OpenFile is an already-owned executable FD, not permission to
# execute PID1 or inspect its procfs task. Only Root's own exe symlink is read.
allow aos_sandbox_policy_authority_t init_exec_t:file { getattr read };
allow aos_sandbox_policy_authority_t self:lnk_file { getattr read };
allow aos_sandbox_policy_authority_t aos_sandbox_policy_authority_profile_t:file { getattr open read };
allow init_t aos_sandbox_policy_authority_profile_t:file { getattr open read };
# Public selected-image bytes, never Root task files or Root-owned descriptors.
allow aos_sandbox_controller_t aos_sandbox_policy_authority_profile_t:file { getattr open read };
