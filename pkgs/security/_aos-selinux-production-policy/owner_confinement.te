# Root owns its accepted endpoint. A Controller client needs only pathname
# access and connectto; receiving/using/writing Root's accepted FD is denied.
allow aos_sandbox_controller_t aos_sandbox_policy_authority_runtime_t:dir { getattr open search };
allow aos_sandbox_controller_t aos_sandbox_policy_authority_runtime_t:sock_file { getattr open read write };
allow aos_sandbox_controller_t aos_sandbox_policy_authority_t:unix_stream_socket connectto;

# One exact helper image has source-specific transitions, never an init_t entry.
type aos_method46_helper_exec_t;
type aos_method46_tpm_device_t;

type aos_method46_controller_helper_t;
typeattribute aos_method46_controller_helper_t domain;
role system_r types aos_method46_controller_helper_t;
type aos_method46_controller_floor_t;
type aos_method46_controller_lock_t;
allow aos_sandbox_controller_t aos_method46_helper_exec_t:file { execute getattr map open read };
allow aos_sandbox_controller_t aos_method46_controller_helper_t:process { getattr sigkill signal transition };
allow aos_sandbox_controller_t aos_method46_controller_helper_t:process2 nnp_transition;
allow aos_sandbox_controller_t aos_method46_controller_helper_t:dir { getattr open read search };
# PTRACE_MODE_READ/task image inspection, never process:ptrace/attach. Image
# observation occurs before public HELLO and before the child becomes nondumpable.
allow aos_sandbox_controller_t aos_method46_controller_helper_t:file { getattr open read };
allow aos_method46_controller_helper_t aos_method46_helper_exec_t:file { entrypoint getattr map open read };
type_transition aos_sandbox_controller_t aos_method46_helper_exec_t:process aos_method46_controller_helper_t;
allow aos_method46_controller_helper_t aos_sandbox_controller_t:process sigchld;
allow aos_method46_controller_helper_t aos_sandbox_controller_t:fd use;
allow aos_method46_controller_helper_t aos_sandbox_controller_t:unix_stream_socket { getattr getopt read setopt write };
allow aos_sandbox_controller_t aos_method46_controller_helper_t:fd use;
allow aos_method46_controller_helper_t self:process getattr;
allow aos_method46_controller_helper_t self:file { getattr open read };
allow aos_method46_controller_helper_t self:dir { getattr open search };
allow aos_method46_controller_helper_t { root_t usr_t device_t proc_t }:dir { getattr open search };
allow aos_method46_controller_helper_t proc_t:filesystem getattr;
allow aos_method46_controller_helper_t lib_t:file { execute getattr map open read };
allow aos_method46_controller_helper_t ld_so_t:file { execute getattr map open read };
allow aos_method46_controller_helper_t security_t:dir { getattr open search };
allow aos_method46_controller_helper_t security_t:filesystem getattr;
allow aos_method46_controller_helper_t security_t:file { getattr open read };
allow aos_method46_controller_helper_t aos_method46_tpm_device_t:chr_file { getattr open read write };
# SCM_RIGHTS checks the RDWR mode. These permissions apply only to exact empty
# lock OFDs, not journal data; no pathname open, flock, truncate or rename grant.
allow aos_method46_controller_helper_t aos_method46_controller_lock_t:file { getattr read write };
allow aos_sandbox_controller_t aos_method46_controller_floor_t:dir { add_name getattr open read remove_name search write };
allow aos_sandbox_controller_t aos_method46_controller_floor_t:file { append create getattr open read rename setattr unlink write };
allow aos_sandbox_controller_t aos_method46_controller_lock_t:file { create getattr lock open read write };
type_transition aos_sandbox_controller_t aos_method46_controller_floor_t:file aos_method46_controller_floor_t;
type_transition aos_sandbox_controller_t aos_method46_controller_floor_t:file aos_method46_controller_lock_t "session.journal.lock";
type_transition aos_sandbox_controller_t aos_method46_controller_floor_t:file aos_method46_controller_lock_t "session-floor.journal.lock";

