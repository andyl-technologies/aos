# Narrow subroles name existing preparation processes, not new principals.
# Their fixed entrypoint/tool/mount/credential-input producer closure remains
# independently required; no generic init_t or bin_t grant substitutes for it.
type aos_sandbox_cache_view_preparer_t;
typeattribute aos_sandbox_cache_view_preparer_t domain;
role system_r types aos_sandbox_cache_view_preparer_t;
type aos_sandbox_source_view_preparer_t;
typeattribute aos_sandbox_source_view_preparer_t domain;
role system_r types aos_sandbox_source_view_preparer_t;

# The static preparation program already runs with PID 1's setup capabilities.
# Only freshly created held Controller directories may be fchowned to the
# compiled image assignment; no data inode or existing wrong-owner repair.
require { class capability chown; }
allow aos_sandbox_runtime_roots_t self:capability chown;
allow aos_sandbox_runtime_roots_t aos_sandbox_controller_state_t:dir { add_name create getattr open read search setattr write };
allow aos_sandbox_runtime_roots_t aos_method46_controller_floor_t:dir { create getattr open read search setattr };
allow aos_sandbox_runtime_roots_t aos_sandbox_storage_state_t:dir { add_name create getattr open read search write };
allow aos_sandbox_runtime_roots_t aos_method46_storage_floor_t:dir { create getattr open read search };
# AOS_ONLINE_NIX_BEGIN
# This entire block is absent from the default compiled policy. It names
# existing-only ONLINE058/059 consumers, not the offline provisioning role.
require {
    class capability { setuid setgid };
    class process setcap;
    class fifo_file { create getattr read write };
}
