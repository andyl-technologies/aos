allow aos_sandbox_policy_authority_t security_t:file { getattr open read };
allow aos_sandbox_policy_authority_t cgroup_t:dir { getattr open read search };
allow aos_sandbox_policy_authority_t cgroup_t:file { getattr open read };
allow aos_sandbox_policy_authority_t sysctl_t:dir search;
allow aos_sandbox_policy_authority_t sysctl_kernel_t:dir search;
allow aos_sandbox_policy_authority_t sysctl_kernel_t:file { getattr open read };
