module aos_sandbox_guest_ancestor_negative 1.0;

require {
    type aos_sandbox_guest_owner_t;
    type aos_sandbox_payload_t;
    type var_t;
    type var_lib_t;

    class dir relabelfrom;
}

# Fresh /run and /dev projection cannot confer authority over shared /var.
# Both source and target expansion, including a disabled branch, remain denied.
attribute aos_sandbox_negative_guest_relabeler;
typeattribute aos_sandbox_guest_owner_t aos_sandbox_negative_guest_relabeler;
typeattribute aos_sandbox_payload_t aos_sandbox_negative_guest_relabeler;
attribute aos_sandbox_negative_guest_ancestors;
typeattribute var_t aos_sandbox_negative_guest_ancestors;
typeattribute var_lib_t aos_sandbox_negative_guest_ancestors;

bool aos_sandbox_negative_guest_ancestors_enabled false;
if (aos_sandbox_negative_guest_ancestors_enabled) {
    allow aos_sandbox_negative_guest_relabeler aos_sandbox_negative_guest_ancestors:dir relabelfrom;
}
