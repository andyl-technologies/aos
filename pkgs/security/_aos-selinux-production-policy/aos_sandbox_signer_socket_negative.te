module aos_sandbox_signer_socket_negative 1.0;

require {
    type aos_sandbox_cache_signer_t;
    type aos_sandbox_source_signer_t;
    type init_t;
    class unix_stream_socket connect;
}

# Both axes mix inherited-listener signers with an ordinary socket user.
# The unchanged wildcard deny must expand this grant even when default-off.
attribute aos_sandbox_negative_signer_socket_sources;
typeattribute init_t aos_sandbox_negative_signer_socket_sources;
typeattribute aos_sandbox_cache_signer_t aos_sandbox_negative_signer_socket_sources;
typeattribute aos_sandbox_source_signer_t aos_sandbox_negative_signer_socket_sources;

attribute aos_sandbox_negative_signer_socket_targets;
typeattribute init_t aos_sandbox_negative_signer_socket_targets;
typeattribute aos_sandbox_cache_signer_t aos_sandbox_negative_signer_socket_targets;
typeattribute aos_sandbox_source_signer_t aos_sandbox_negative_signer_socket_targets;

bool aos_sandbox_negative_signer_socket_enabled false;

if (aos_sandbox_negative_signer_socket_enabled) {
    allow aos_sandbox_negative_signer_socket_sources aos_sandbox_negative_signer_socket_targets:unix_stream_socket connect;
}
