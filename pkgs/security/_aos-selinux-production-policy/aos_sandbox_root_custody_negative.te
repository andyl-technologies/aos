module aos_sandbox_root_custody_negative 1.0;

require {
    type aos_sandbox_policy_authority_t;
    type init_t;
    type unconfined_t;
    class fd use;
}

# Both axes mix a trusted/ordinary member with a forbidden Root custody edge.
# The unchanged all-source checker must expand both even when default-off.
attribute aos_sandbox_negative_root_sources;
typeattribute init_t aos_sandbox_negative_root_sources;
typeattribute unconfined_t aos_sandbox_negative_root_sources;

attribute aos_sandbox_negative_root_targets;
typeattribute init_t aos_sandbox_negative_root_targets;
typeattribute aos_sandbox_policy_authority_t aos_sandbox_negative_root_targets;

bool aos_sandbox_negative_root_custody_enabled false;

if (aos_sandbox_negative_root_custody_enabled) {
    allow aos_sandbox_negative_root_sources aos_sandbox_negative_root_targets:fd use;
}
