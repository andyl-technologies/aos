##! Hermetic policy readback generated by the exact AOS deployment kernel.
{
  mkDerivation,
  stdenv,
  buildPackages,
  linux,
  aos-selinux-production-policy,
}: let
  sourcePolicy = "${aos-selinux-production-policy}/etc/selinux/aos/policy/policy.33";
  guestArchitecture = stdenv.hostPlatform.constraints.cpu;
  qemuPlatforms = {
    x86_64 = {
      binary = "qemu-system-x86_64";
      machine = "q35,accel=tcg";
      cpu = "max";
      console = "ttyS0";
      serialDevice = "virtio-serial";
      # Q35 TCG has no working emulated IO-APIC timer for this kernel.
      # noapic changes only this fixture's boot path, not the readback.
      kernelParameters = "noapic ";
    };
    aarch64 = {
      binary = "qemu-system-aarch64";
      machine = "virt,accel=tcg";
      cpu = "cortex-a57";
      console = "ttyAMA0";
      serialDevice = "virtio-serial-pci";
      kernelParameters = "";
    };
  };
  qemuPlatform =
    qemuPlatforms.${guestArchitecture}
    or (throw "SELinux policy readback: unsupported guest architecture '${guestArchitecture}'");
  qemuBinary = "${buildPackages.qemu}/bin/${qemuPlatform.binary}";
in
  mkDerivation {
    pname = "aos-selinux-kernel-policy-readback";
    version = "1";
    src = ./aos-selinux-kernel-readback.c;

    # The kernel and init belong to the target; all sandbox tools remain native.
    buildDeps = [
      buildPackages.coreutils
      buildPackages.cpio
      buildPackages.diffutils
      buildPackages.findutils
      buildPackages.grep
      buildPackages.qemu
      buildPackages.socat
    ];
    runtimeDeps = [];
    propagatedDeps = [];
    outputChecks = {};

    phases = [
      {
        name = "build";
        script = ''
          set -eu

          set -- ${linux}/boot/vmlinuz-*
          test "$#" -eq 1
          kernel_image=$1

          $CC -std=c17 -Os -Wall -Wextra -Werror -static \
            -Wl,-z,noexecstack "$src" -o init
          mkdir -p initrd/dev initrd/proc initrd/sys/fs/selinux
          cp init initrd/init
          cp ${sourcePolicy} initrd/source-policy.33
          (cd initrd && find . -print0 | cpio --null -o -H newc) > initrd.cpio

          run_readback() {
            round=$1
            ${qemuBinary} \
              -machine ${qemuPlatform.machine} -cpu ${qemuPlatform.cpu} -m 1024 -smp 1 \
              -display none -serial file:"$PWD/serial-$round.log" \
              -device ${qemuPlatform.serialDevice} \
              -chardev file,id=readback,path="$PWD/readback-$round.bin" \
              -device virtserialport,chardev=readback,name=aos.policy.readback \
              -monitor unix:"$PWD/monitor-$round.sock",server=on,wait=off \
              -kernel "$kernel_image" -initrd initrd.cpio \
              -append 'console=${qemuPlatform.console},115200 ${qemuPlatform.kernelParameters}selinux=1 security=selinux enforcing=1' \
              -pidfile "$PWD/qemu-$round.pid" -daemonize -no-reboot

            elapsed=0
            while ! grep -Fq 'AOS_POLICY_READBACK_COMPLETE=' "serial-$round.log"; do
              if [ "$elapsed" -ge 90 ]; then
                tail -n 40 "serial-$round.log" >&2
                printf 'quit\n' | socat - UNIX-CONNECT:"$PWD/monitor-$round.sock"
                echo "kernel policy readback timed out" >&2
                exit 1
              fi
              sleep 1
              elapsed=$((elapsed + 1))
            done

            printf 'quit\n' | socat - UNIX-CONNECT:"$PWD/monitor-$round.sock"
            test -s "readback-$round.bin"
          }

          # Independent boots catch unstable kernel serialization before it
          # can become the immutable stage-0 expectation.
          run_readback first
          run_readback second
          cmp readback-first.bin readback-second.bin

          mkdir -p "$out"
          install -m 0444 readback-first.bin "$out/policy.33"
          {
            printf 'source_policy_sha256=%s\n' "$(sha256sum ${sourcePolicy} | cut -d ' ' -f 1)"
            printf 'kernel_image_sha256=%s\n' "$(sha256sum "$kernel_image" | cut -d ' ' -f 1)"
            printf 'generator_source_sha256=%s\n' "$(sha256sum "$src" | cut -d ' ' -f 1)"
            printf 'qemu_binary_sha256=%s\n' "$(sha256sum ${qemuBinary} | cut -d ' ' -f 1)"
            printf 'readback_sha256=%s\n' "$(sha256sum "$out/policy.33" | cut -d ' ' -f 1)"
          } > "$out/provenance"
        '';
      }
    ];

    passthru = {
      kernel = linux;
      inherit sourcePolicy qemuPlatform qemuBinary;
    };

    meta = {
      description = "Kernel-bound canonical SELinux policy readback";
      license = "Apache-2.0";
    };
  }
