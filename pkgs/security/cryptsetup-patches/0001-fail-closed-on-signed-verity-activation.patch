@@ -378,8 +378,18 @@ int VERITY_activate(struct crypt_device *cd,
 	r = dm_status_verity_ok(cd, name);
 	if (r < 0)
 		goto out;
 
-	if (!r)
+	if (!r) {
 		log_err(cd, _("Verity device detected corruption after activation."));
+		if (signature) {
+			/* Signed activation must fail closed when the kernel
+			 * reports an unusable verity target immediately after
+			 * creation.
+			 */
+			(void)dm_remove_device(cd, name, 0);
+			r = -ENOKEY;
