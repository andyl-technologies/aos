--- i/lib/libdevmapper.c
+++ w/lib/libdevmapper.c
@@ -1398,6 +1398,11 @@ static int _dm_create_device(struct crypt_device *cd, const char *name, const ch
 		if (r == -ENOKEY || r == -EKEYREVOKED || r == -EKEYEXPIRED) {
 			/* propagate DM errors around key management as such */
 			r = -ENOKEY;
+			/* A rejected dm-verity root-hash signature can leave an
+			 * inactive mapper behind. Remove it now so callers cannot
+			 * mistake the leftover name for a reusable active device.
+			 */
+			(void)_dm_remove(name, 1, 0);
 			goto out;
 		}
 
--- i/lib/verity/verity.c
