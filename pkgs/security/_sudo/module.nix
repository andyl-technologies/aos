##! Owns sudo policy, PAM configuration, and privileged executable resources.
{
  config,
  lib,
  package,
  ...
}: let
  cfg = config.aos.security.sudo;
  passwordTag =
    if cfg.wheelNeedsPassword
    then "PASSWD"
    else "NOPASSWD";
  # Privileged lookup follows system profiles, never the user's PAM PATH.
  securePath =
    config.system.build.systemPath or (lib.concatStringsSep ":" [
      "/run/wrappers/bin"
      "/var/lib/profiles/system-packages/current/bin"
      "/var/lib/profiles/system-packages/current/sbin"
      "/var/lib/profiles/system/current/bin"
      "/var/lib/profiles/system/current/sbin"
    ]);
  sudoersText = ''
    # Generated by the sudo package module.
    Defaults env_reset
    Defaults use_pty
    Defaults secure_path="${securePath}"

    root ALL=(ALL:ALL) ALL
    %wheel ALL=(ALL:ALL) ${passwordTag}: ALL
    ${lib.concatStringsSep "\n" cfg.extraRules}
  '';
  directory = path: mode: {
    input = {
      inherit path mode;
      owner = "root";
      group = "root";
    };
  };
  sudoers = config.aos.abilities.configuration.operations.file.effects.sudoers;
  pamFiles = lib.filterAttrs (name: _: lib.hasPrefix "pam-" name) config.aos.abilities.configuration.operations.file.effects;
  pamResources = map (effect: effect.outputs.path) (builtins.attrValues pamFiles);
  wrapper = name: {
    after = [sudoers.outputs.resource] ++ pamResources;
    input = {
      inherit name;
      source = "${package}/bin/sudo";
      owner = "root";
      group = "root";
      mode = "4755";
    };
  };
in {
  options.aos.security.sudo = {
    enable = lib.mkEnableOption "sudo with wheel authorization policy";
    wheelNeedsPassword = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = "Require wheel members to authenticate before using sudo.";
    };
    extraRules = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      default = [];
      description = "Additional complete sudoers policy lines.";
    };
  };

  config = lib.mkIf cfg.enable {
    aos.pam.packageServices.sudo = {
      unixAuth = true;
      startSession = true;
      setLoginUid = true;
    };
    aos.abilities = {
      configuration.operations.file.effects.sudoers.input = {
        path = "/etc/sudoers";
        content = sudoersText;
        mode = "0440";
      };
      filesystem.operations = {
        directory.effects.sudo-runtime = directory "/run/sudo" "0755";
        persistentAllocate.effects = {
          sudo-state = directory "/var/db/sudo" "0700";
          sudo-io = directory "/var/log/sudo-io" "0700";
        };
        privilegedExecutable.effects = {
          sudo = wrapper "sudo";
          sudoedit = wrapper "sudoedit";
        };
      };
    };
  };
}
