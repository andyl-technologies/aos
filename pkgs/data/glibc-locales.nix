##! glibc-locales — locale data for AOS programs and package tests
{
  mkDerivation,
  buildPackages,
}: let
  version = buildPackages.glibc.version;
in
  mkDerivation {
    pname = "glibc-locales";
    inherit version;

    # localedef is a build-time generator; the emitted unarchived locale tree
    # is data consumed by the target libc.
    buildDeps = [buildPackages.glibc.bin];
    runtimeDeps = [];
    propagatedDeps = [];

    passthru.evidenceSources = buildPackages.glibc.passthru.evidenceSources;

    phases = [
      {
        name = "install";
        script = ''
          mkdir -p "$out/lib/locale"
          export I18NPATH="${buildPackages.glibc.bin}/share/i18n"
          localedef="${buildPackages.glibc.bin}/bin/localedef"

          "$localedef" --no-archive --inputfile=C --charmap=UTF-8 \
            "$out/lib/locale/C.UTF-8"

          # Guile exercises locale-sensitive collation, case mapping, and time
          # formatting; provide its named locales from the same AOS glibc.
          for locale in cs_CZ de_DE el_GR en_US fr_FR sv_SE tr_TR; do
            "$localedef" --no-archive --inputfile="$locale" --charmap=UTF-8 \
              "$out/lib/locale/$locale.utf8"
          done
          "$localedef" --no-archive --inputfile=fr_FR --charmap=ISO-8859-1 \
            "$out/lib/locale/fr_FR.iso88591"
        '';
      }
    ];

    meta = {
      description = "Locale data generated by the AOS C library";
      homepage = "https://www.gnu.org/software/libc/";
      license = "LGPL-2.1-or-later";
    };
  }
