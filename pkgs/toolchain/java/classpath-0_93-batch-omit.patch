+# Both standard.omit and vm.omit contain one expression per line. Filtering
+# them together avoids rereading the full class list for every VM class.
+grep -v -f tmp.omit < ${top_builddir}/lib/classes.1 > ${top_builddir}/lib/classes.tmp
+mv ${top_builddir}/lib/classes.tmp ${top_builddir}/lib/classes.1
