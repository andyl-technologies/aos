 print "# It was generated by:\n";
 printf "# %s %s %s\n", $0, $symvers, (join ' ',@ARGV);
 
-foreach my $i (keys %export_hash) {
+foreach my $i (sort keys %export_hash) {
   printf "%s\n",$i or die;
 }
