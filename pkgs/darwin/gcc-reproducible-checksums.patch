--- a/gcc/genchecksum.cc
+++ b/gcc/genchecksum.cc
@@ -98,6 +98,7 @@
   struct md5_ctx ctx;
   unsigned char result[16];
   int i;
+  const char *aos_identity = getenv ("AOS_GCC_OUTPUT_IDENTITY");
 
   if (argc < 2)
     {
@@ -106,8 +107,20 @@
     }
 
   md5_init_ctx (&ctx);
-  for (i = 1; i < argc; i++) 
-    dosum (&ctx, argv[i]);
+  if (aos_identity)
+    {
+      /* The output path identifies the exact source, flags, and toolchain.
+         Object debug metadata can vary without changing the linked compiler.
+         Include input names so each frontend keeps a distinct PCH identity.  */
+      md5_process_bytes (aos_identity, strlen (aos_identity) + 1, &ctx);
+      for (i = 1; i < argc; i++)
+        md5_process_bytes (argv[i], strlen (argv[i]) + 1, &ctx);
+    }
+  else
+    {
+      for (i = 1; i < argc; i++)
+        dosum (&ctx, argv[i]);
+    }
   md5_finish_ctx (&ctx, result);
 
   puts ("#include \"config.h\"");
