    symbols:
      - _AEGetDescData
      - _AEGetDescDataSize
      - _ATSFontActivateFromFileReference
      - _FSFindFolder
      - _FSRefMakePath
      - _FSPathMakeRef
      - _FSPathMakeRefWithOptions
      - _FSResolveAliasFileWithMountFlags
      - _GetIconRef
      - _GetCurrentEventKeyModifiers
      - _GetCurrentProcess
      - _HIThemeBeginFocus
      - _HIThemeEndFocus
      - _LSCopyDisplayNameForRef
      - _LSCopyItemInfoForRef
      - _LSOpenURLsWithRole
      - _ReleaseIconRef
      - _LMGetKbdType
      - _TISCopyCurrentKeyboardInputSource
      - _TISGetInputSourceProperty
      - _UCKeyTranslate
      - _kTISPropertyUnicodeKeyLayoutData
      - _UCConvertCFAbsoluteTimeToLongDateTime
      - _UCConvertLongDateTimeToCFAbsoluteTime
...
