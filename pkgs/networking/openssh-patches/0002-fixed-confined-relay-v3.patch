 	/*
 	 * Clear loginmsg, since it's the child's responsibility to display
@@ -563,6 +566,7 @@ do_exec_pty(struct ssh *ssh, Session *s, const char *command)
 	}
 
 	/* Fork the child. */
+	aos_attach_relay_before_fork();
 	switch ((pid = fork())) {
 	case -1:
 		error_f("fork: %.100s", strerror(errno));
@@ -613,6 +617,7 @@ do_exec_pty(struct ssh *ssh, Session *s, const char *command)
 #endif
 
 	s->pid = pid;
