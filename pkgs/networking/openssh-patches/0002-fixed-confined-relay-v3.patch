 	/* Parent.  Close the slave side of the pseudo tty. */
 	close(ttyfd);
@@ -1257,6 +1262,20 @@ do_nologin(struct passwd *pw)
 	exit(254);
 }
 
+void
+aos_attach_account_check_v3(struct passwd *pw)
+{
+	if (!options.aos_attach_monitor_v2)
+		return;
+	/* Preserve the existing non-PAM account check before monitor readiness. */
+	if (!options.use_pam)
+		do_nologin(pw);
+#ifdef USE_PAM
+	if (options.use_pam && !is_pam_session_open())
+		fatal("AOS attach PAM session unavailable");
+#endif
+}
+
 /*
  * Chroot into a directory after checking it for safety: all path components
  * must be root-owned directories with strict permissions.
@@ -1481,6 +1500,18 @@ do_child(struct ssh *ssh, Session *s, const char *command)
 
 	/* remove keys from memory */
 	ssh_packet_clear_keys(ssh);
+	if (options.aos_attach_monitor_v2) {
+		/* No passwd shell, user environment, home directory or RC hook. */
+		if (s->authctxt->force_pwchange || command == NULL || options.adm_forced_command == NULL ||
+		    auth_opts->force_command == NULL || s->is_subsystem ||
+		    strcmp(command, options.adm_forced_command) != 0 ||
+		    strcmp(command, auth_opts->force_command) != 0)
+			fatal("AOS attach internal command rejected");
+		aos_attach_relay_child();
+		child_close_fds(ssh);
+		closefrom(STDERR_FILENO + 1);
+		aos_attach_internal_relay();
+	}
 
 	/* Force a password change */
 	if (s->authctxt->force_pwchange) {
@@ -2684,4 +2715,3 @@ session_get_remote_name_or_ip(struct ssh *ssh, u_int utmp_size, int use_dns)
 		remote = ssh_remote_ipaddr(ssh);
 	return remote;
 }
