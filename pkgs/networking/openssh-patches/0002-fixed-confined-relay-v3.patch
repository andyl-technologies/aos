@@ -29,6 +29,7 @@
 
 #include "includes.h"
 #include "aos-attach-monitor.h"
+#include "aos-attach-confinement.h"
 
 #include <sys/types.h>
 #include <sys/ioctl.h>
@@ -421,6 +422,10 @@ privsep_postauth(struct ssh *ssh, Authctxt *authctxt)
 	reseed_prngs();
 
 	/* Drop privileges */
+	if (options.aos_attach_monitor_v2) {
+		aos_attach_account_check_v3(authctxt->pw);
+		aos_attach_confinement_before_drop();
+	}
 	if (!skip_privdrop)
 		do_setusercontext(authctxt->pw);
 
diff --git a/monitor.c b/monitor.c
index 02e55c3..31ba951 100644
--- a/monitor.c
+++ b/monitor.c
@@ -218,6 +218,7 @@ struct mon_table mon_dispatch_proto20[] = {
 };
 
 struct mon_table mon_dispatch_postauth20[] = {
+	{AOS_ATTACH_RELAY_REQUEST, MON_ONCE, aos_attach_monitor_relay},
     {MONITOR_REQ_STATE, MON_ONCE, mm_answer_state},
 #ifdef WITH_OPENSSL
     {MONITOR_REQ_MODULI, 0, mm_answer_moduli},
@@ -431,6 +432,8 @@ monitor_child_postauth(struct ssh *ssh, struct monitor *pmonitor)
 #endif
 
 	mon_dispatch = mon_dispatch_postauth20;
+	monitor_permit(mon_dispatch, AOS_ATTACH_RELAY_REQUEST,
+	    options.aos_attach_monitor_v2);
 
 	/* Permit requests for moduli and signatures */
 	monitor_permit(mon_dispatch, MONITOR_REQ_STATE, 1);
