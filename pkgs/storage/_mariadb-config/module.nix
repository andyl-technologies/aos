##! Typed, package-owned MariaDB runtime configuration.
{
  config,
  lib,
  ...
}: let
  inherit (lib) mkIf mkMerge mkOption types;
  cfg = config.mariadb;

  positiveInt = types.addCheck types.int (value: value > 0);
  port = types.addCheck types.int (value: value > 0 && value < 65536);
  address = types.strMatching "[A-Za-z0-9_.:-]+";
  sqlMode = types.strMatching "[A-Z0-9_,]*";
  secretRef = types.submodule ({...}: {
    config._module.strict = true;
    options.ref = mkOption {
      type = types.strMatching "(tpm2-credstore|desired-toml|system-credential)(:[A-Za-z0-9_.-]+)?";
      description = "Opaque AOS credential reference; secret bytes never enter Nix evaluation.";
    };
  });
  optionalSecretRef = types.nullOr secretRef;

  boolValue = value:
    if value
    then "ON"
    else "OFF";
  optionalLine = condition: line:
    if condition
    then "${line}\n"
    else "";
  mariadbConfig = ''
    # Generated by the MariaDB AOS package configuration module. Do not edit.
    [client]
    socket=/run/mariadb/mariadb.sock
    port=${toString cfg.port}

    [mariadbd]
    bind-address=${cfg.bindAddress}
    port=${toString cfg.port}
    socket=/run/mariadb/mariadb.sock
    pid-file=/run/mariadb/mariadb.pid
    datadir=/var/lib/aos-pkg-mariadb
    log-error=/var/log/mariadb/error.log
    character-set-server=${cfg.characterSet}
    collation-server=${cfg.collation}
    max-connections=${toString cfg.maxConnections}
    skip-name-resolve=${boolValue cfg.skipNameResolve}
    sql-mode=${cfg.sqlMode}
    upgrade=AUTO
    init-file=/run/mariadb/bootstrap.sql
    ${optionalLine cfg.tls.enable "ssl-cert=/run/credentials/mariadb.service/tls-certificate"}${optionalLine cfg.tls.enable "ssl-key=/run/credentials/mariadb.service/tls-private-key"}${optionalLine (cfg.tls.enable && cfg.tls.ca != null) "ssl-ca=/run/credentials/mariadb.service/tls-ca"}
  '';
in {
  options.mariadb = {
    enable = lib.mkEnableOption "the MariaDB database service";

    bindAddress = mkOption {
      type = address;
      default = "127.0.0.1";
      description = "Address on which MariaDB accepts client connections.";
    };

    port = mkOption {
      type = port;
      default = 3306;
      description = "TCP port on which MariaDB accepts client connections.";
    };

    maxConnections = mkOption {
      type = positiveInt;
      default = 151;
      description = "Maximum simultaneous MariaDB client connections.";
    };

    characterSet = mkOption {
      type = types.enum ["utf8mb4" "utf8mb3" "latin1"];
      default = "utf8mb4";
      description = "Default server character set.";
    };

    collation = mkOption {
      type = types.strMatching "[A-Za-z0-9_]+";
      default = "utf8mb4_uca1400_ai_ci";
      description = "Default server collation.";
    };

    skipNameResolve = mkOption {
      type = types.bool;
      default = true;
      description = "Disable DNS lookups while matching client grant entries.";
    };

    sqlMode = mkOption {
      type = sqlMode;
      default = "STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION";
      description = "Comma-separated server SQL modes.";
    };

    tls = {
      enable = mkOption {
        type = types.bool;
        default = false;
        description = "Enable TLS using credential-backed certificate material.";
      };
      certificate = mkOption {
        type = optionalSecretRef;
        default = null;
        description = "Opaque reference for the PEM server certificate.";
      };
      privateKey = mkOption {
        type = optionalSecretRef;
        default = null;
        description = "Opaque reference for the PEM server private key.";
      };
      ca = mkOption {
        type = optionalSecretRef;
        default = null;
        description = "Optional opaque reference for the client CA bundle.";
      };
    };

    bootstrap = {
      adminSql = mkOption {
        type = optionalSecretRef;
        default = null;
        description = "Optional credential containing idempotent SQL for administrator provisioning.";
      };
      replicationSql = mkOption {
        type = optionalSecretRef;
        default = null;
        description = "Optional credential containing idempotent SQL for replication provisioning.";
      };
    };
  };

  config = {
    mariadb.config.runtime = {
      MARIADB_ENABLED =
        if cfg.enable
        then "1"
        else "0";
      MARIADB_CONFIG_GENERATION = builtins.hashString "sha256" mariadbConfig;
    };

    mariadb.credentials = mkMerge [
      (mkIf (cfg.tls.certificate != null) {"tls-certificate" = cfg.tls.certificate;})
      (mkIf (cfg.tls.privateKey != null) {"tls-private-key" = cfg.tls.privateKey;})
      (mkIf (cfg.tls.ca != null) {"tls-ca" = cfg.tls.ca;})
      (mkIf (cfg.bootstrap.adminSql != null) {"admin-bootstrap-sql" = cfg.bootstrap.adminSql;})
      (mkIf (cfg.bootstrap.replicationSql != null) {"replication-bootstrap-sql" = cfg.bootstrap.replicationSql;})
    ];

    environment.etc."aos/packages/mariadb/my.cnf" = {
      mode = "0640";
      text = mariadbConfig;
    };

    aos.users.users.mariadb = {
      uid = 803;
      group = "mariadb";
      home = "/var/lib/aos-pkg-mariadb";
      shell = "/sbin/nologin";
      description = "MariaDB database service";
      extraGroups = [];
    };
    aos.users.groups.mariadb = {
      gid = 803;
      members = [];
    };

    assertions = [
      {
        assertion = !cfg.tls.enable || (cfg.tls.certificate != null && cfg.tls.privateKey != null);
        message = "mariadb TLS requires certificate and private-key credential references";
      }
      {
        assertion = cfg.tls.enable || (cfg.tls.certificate == null && cfg.tls.privateKey == null && cfg.tls.ca == null);
        message = "mariadb TLS credentials require mariadb.tls.enable";
      }
    ];
  };
}
