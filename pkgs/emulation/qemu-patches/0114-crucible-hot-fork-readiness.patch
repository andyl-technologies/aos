+
+CrucibleHotForkReadiness *qmp_query_crucible_hot_fork_readiness(Error **errp)
+{
+    CrucibleHotForkReadiness *report = g_new0(CrucibleHotForkReadiness, 1);
+    uint64_t acknowledged = 0;
+
+    (void)errp;
+    if (icount_enabled() == ICOUNT_PRECISE) {
+        acknowledged |= CRUCIBLE_HOT_FORK_PROOF_PRECISE_ICOUNT;
+    }
+    if (qemu_plugin_crucible_single_threaded_rr()) {
+        acknowledged |= CRUCIBLE_HOT_FORK_PROOF_SINGLE_THREADED_SIM_RR;
+    }
+    if (runstate_check(RUN_STATE_PAUSED) &&
+        qemu_plugin_crucible_vmstop_pending() &&
+        !qemu_plugin_crucible_vmstop_admission_pending() &&
+        qemu_plugin_crucible_vmstop_flush_status() == 0) {
+        acknowledged |= CRUCIBLE_HOT_FORK_PROOF_EXACT_PAUSED_BOUNDARY;
+    }
+
+    /*
+     * The remaining proof classes deliberately stay clear until their
+     * subsystem-owned barriers and child reconstruction hooks land.  In
+     * particular, ordinary paused state is not evidence for any of them.
+     */
+    report->schema_version = 1;
+    report->required_proofs = CRUCIBLE_HOT_FORK_REQUIRED_PROOFS;
+    report->acknowledged_proofs = acknowledged;
+    report->ready = acknowledged == CRUCIBLE_HOT_FORK_REQUIRED_PROOFS;
+    return report;
+}
+
+CrucibleHotForkThreadInventory *
+qmp_query_crucible_hot_fork_thread_inventory(Error **errp)
+{
+    CrucibleHotForkThreadInventory *report =
+        g_new0(CrucibleHotForkThreadInventory, 1);
+
+    (void)errp;
+    report->schema_version = 1;
+#ifdef CONFIG_POSIX
+    QemuThreadHotForkInventory inventory;
+    CrucibleHotForkThreadList **tail = &report->threads;
+    uint32_t coordinator_count = 0;
+    uint32_t unclassified_count = 0;
+    size_t index;
+
+    qemu_thread_hot_fork_inventory(&inventory);
+    report->generation = inventory.generation;
+    for (index = 0; index < inventory.entry_count; index++) {
+        QemuThreadHotForkInventoryEntry *source = &inventory.entries[index];
+        CrucibleHotForkThread *thread = g_new0(CrucibleHotForkThread, 1);
+        CrucibleHotForkThreadList *node = g_new0(CrucibleHotForkThreadList, 1);
+
+        thread->thread_id = source->thread_id;
+        thread->name = g_strdup(source->name);
+        thread->name_valid = source->name_valid;
+        thread->joinable = source->joinable;
+        switch (source->disposition) {
+        case QEMU_THREAD_HOT_FORK_COORDINATOR:
+            thread->disposition =
+                CRUCIBLE_HOT_FORK_THREAD_DISPOSITION_COORDINATOR;
+            coordinator_count++;
+            break;
+        case QEMU_THREAD_HOT_FORK_UNCLASSIFIED:
+            thread->disposition =
+                CRUCIBLE_HOT_FORK_THREAD_DISPOSITION_UNCLASSIFIED;
+            unclassified_count++;
+            break;
+        default:
+            g_assert_not_reached();
+        }
+        node->value = thread;
+        *tail = node;
+        tail = &node->next;
+    }
+    report->unclassified_threads = unclassified_count;
+    report->overflowed = inventory.overflow_count != 0;
+    report->complete = inventory.overflow_count == 0 &&
+                       coordinator_count == 1;
+    for (index = 0; index < inventory.entry_count; index++) {
+        report->complete &= inventory.entries[index].name_valid;
+    }
+    qemu_thread_hot_fork_inventory_destroy(&inventory);
+#else
+    report->complete = false;
+#endif
+    return report;
+}
