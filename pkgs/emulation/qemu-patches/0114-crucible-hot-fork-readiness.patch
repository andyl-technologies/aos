+##
+# @CrucibleHotForkReadiness:
+#
+# Bounded readiness report for Crucible's local hot-fork coordinator.
+#
+# @schema-version: version of the proof-bit contract, currently 1
+#
+# @required-proofs: complete proof bitmap required before hot fork may be
+#     advertised
+#
+# @acknowledged-proofs: subset of @required-proofs that QEMU can attest at
+#     the current boundary
+#
+# @ready: true exactly when @acknowledged-proofs equals @required-proofs
+#
+# The version-1 proof bits are precise icount (bit 0), single-threaded sim
+# round-robin execution (bit 1), exact paused device-flush boundary (bit 2),
+# drained AIO/bottom-half/timer state (bit 3), drained RCU state (bit 4),
+# immutable block-snapshot boundary (bit 5), frozen plugin/protocol rings
+# (bit 6), closed mapping/descriptor disposition (bit 7), and complete child
+# reinitialization support (bit 8).  Unknown or incomplete proofs fail closed.
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'struct': 'CrucibleHotForkReadiness',
+  'data': { 'schema-version': 'uint32',
+            'required-proofs': 'uint64',
+            'acknowledged-proofs': 'uint64',
+            'ready': 'bool' } }
+
+##
+# @query-crucible-hot-fork-readiness:
+#
+# Query QEMU-owned hot-fork quiescence proofs at the current execution
+# boundary.  This command never pauses, forks, or mutates the VM.  Callers must
+# not infer readiness from ordinary paused status.
+#
+# Returns: @CrucibleHotForkReadiness
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'command': 'query-crucible-hot-fork-readiness',
+  'returns': 'CrucibleHotForkReadiness' }
+
+##
+# @CrucibleHotForkThreadDisposition:
+#
+# QEMU-owned fork disposition for one internally registered thread.
+#
+# @coordinator: the QMP main-loop thread designated to coordinate a future
+#     fork transaction
+#
+# @unclassified: active QEMU-created thread without a child disposition;
+#     this is never fork-ready
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'enum': 'CrucibleHotForkThreadDisposition',
+  'data': [ 'coordinator', 'unclassified' ] }
+
+##
+# @CrucibleHotForkThread:
+#
+# One active thread in QEMU's bounded internal fork registry.
+#
+# @thread-id: positive operating-system thread identifier
+#
+# @name: bounded UTF-8 QEMU thread name
+#
+# @name-valid: whether @name is the exact nonempty name supplied at creation
+#
+# @joinable: whether QEMU created the thread as joinable
+#
+# @disposition: current QEMU-owned fork disposition
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'struct': 'CrucibleHotForkThread',
+  'data': { 'thread-id': 'int64',
+            'name': 'str',
+            'name-valid': 'bool',
+            'joinable': 'bool',
+            'disposition': 'CrucibleHotForkThreadDisposition' } }
+
+##
+# @CrucibleHotForkThreadInventory:
+#
+# Bounded snapshot of QEMU's internal active-thread registry.  Entries are
+# sorted by @thread-id.  This report is audit evidence and does not by itself
+# acknowledge child reinitialization or authorize a fork.
+#
+# @schema-version: inventory contract version, currently 1
+#
+# @generation: monotonic process-local register/unregister/disposition counter
+#
+# @complete: true exactly when the registry did not overflow, every name was
+#     retained exactly, and exactly one coordinator is present
+#
+# @overflowed: whether one or more active QEMU-created threads exceeded the
+#     retained registry bound
+#
+# @unclassified-threads: number of active entries without a disposition
+#
+# @threads: every retained active QEMU-created thread, bounded to 65536 entries
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'struct': 'CrucibleHotForkThreadInventory',
+  'data': { 'schema-version': 'uint32',
+            'generation': 'uint64',
+            'complete': 'bool',
+            'overflowed': 'bool',
+            'unclassified-threads': 'uint32',
+            'threads': [ 'CrucibleHotForkThread' ] } }
+
+##
+# @query-crucible-hot-fork-thread-inventory:
+#
+# Query the exact bounded active-thread registry owned by QEMU.  The operation
+# is observational apart from first registering the process-lifetime QMP
+# coordinator.  Unclassified or externally created threads remain blockers.
+#
+# Returns: @CrucibleHotForkThreadInventory
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'command': 'query-crucible-hot-fork-thread-inventory',
+  'returns': 'CrucibleHotForkThreadInventory' }
+
 ##
 # @SHUTDOWN:
 #
diff --git a/util/qemu-thread-posix.c b/util/qemu-thread-posix.c
index b2e26e212..2af870d3e 100644
--- a/util/qemu-thread-posix.c
+++ b/util/qemu-thread-posix.c
@@ -497,13 +497,195 @@ typedef struct {
     void *(*start_routine)(void *);
     void *arg;
     char *name;
+    int mode;
 } QemuThreadArgs;
 
+typedef struct QemuHotForkThreadRecord {
+    int64_t thread_id;
+    char name[QEMU_HOT_FORK_THREAD_NAME_MAX + 1];
+    bool joinable;
+    bool name_valid;
+    bool tracked;
+    QemuThreadHotForkDisposition disposition;
+} QemuHotForkThreadRecord;
+
+static pthread_mutex_t qemu_hot_fork_thread_lock = PTHREAD_MUTEX_INITIALIZER;
+static GList *qemu_hot_fork_threads;
+static size_t qemu_hot_fork_thread_count;
+static size_t qemu_hot_fork_thread_overflow;
+static uint64_t qemu_hot_fork_thread_generation;
+static int64_t qemu_hot_fork_coordinator_thread_id;
+
+static QemuHotForkThreadRecord *qemu_hot_fork_thread_register(
+    const char *name, int mode, QemuThreadHotForkDisposition disposition)
+{
+    QemuHotForkThreadRecord *record = g_new0(QemuHotForkThreadRecord, 1);
+    size_t name_length = name ?
+        strnlen(name, QEMU_HOT_FORK_THREAD_NAME_MAX + 1) : 0;
+    int err;
+
+    record->thread_id = qemu_get_thread_id();
+    record->joinable = mode == QEMU_THREAD_JOINABLE;
+    record->disposition = disposition;
+    record->name_valid = name && name_length <= QEMU_HOT_FORK_THREAD_NAME_MAX &&
+                         g_utf8_validate(name, name_length, NULL);
+    g_strlcpy(record->name, record->name_valid ? name : "<invalid>",
+              sizeof(record->name));
+
+    err = pthread_mutex_lock(&qemu_hot_fork_thread_lock);
+    if (err) {
+        error_exit(err, __func__);
+    }
+    if (qemu_hot_fork_thread_count == QEMU_HOT_FORK_THREAD_INVENTORY_MAX) {
+        qemu_hot_fork_thread_overflow++;
+    } else {
+        record->tracked = true;
+        qemu_hot_fork_threads = g_list_prepend(qemu_hot_fork_threads, record);
+        qemu_hot_fork_thread_count++;
+    }
+    qemu_hot_fork_thread_generation++;
+    err = pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+    if (err) {
+        error_exit(err, __func__);
+    }
+    return record;
+}
+
+static void qemu_hot_fork_thread_unregister(void *opaque)
+{
+    QemuHotForkThreadRecord *record = opaque;
+    int err = pthread_mutex_lock(&qemu_hot_fork_thread_lock);
+
+    if (err) {
+        error_exit(err, __func__);
+    }
+    if (record->tracked) {
+        qemu_hot_fork_threads = g_list_remove(qemu_hot_fork_threads, record);
+        assert(qemu_hot_fork_thread_count > 0);
+        qemu_hot_fork_thread_count--;
+    } else {
+        assert(qemu_hot_fork_thread_overflow > 0);
+        qemu_hot_fork_thread_overflow--;
+    }
+    qemu_hot_fork_thread_generation++;
+    err = pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+    if (err) {
+        error_exit(err, __func__);
+    }
+    g_free(record);
+}
+
+static int qemu_hot_fork_thread_entry_compare(const void *left,
+                                               const void *right)
+{
+    const QemuThreadHotForkInventoryEntry *a = left;
+    const QemuThreadHotForkInventoryEntry *b = right;
+
+    return (a->thread_id > b->thread_id) - (a->thread_id < b->thread_id);
+}
+
+static void qemu_hot_fork_register_coordinator(void)
+{
+    int64_t thread_id = qemu_get_thread_id();
+    GList *node;
+    int err = pthread_mutex_lock(&qemu_hot_fork_thread_lock);
+
+    if (err) {
+        error_exit(err, __func__);
+    }
+    if (qemu_hot_fork_coordinator_thread_id == thread_id) {
+        err = pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+        if (err) {
+            error_exit(err, __func__);
+        }
+        return;
+    }
+    for (node = qemu_hot_fork_threads; node; node = node->next) {
+        QemuHotForkThreadRecord *record = node->data;
+
+        if (record->thread_id == thread_id) {
+            if (record->disposition != QEMU_THREAD_HOT_FORK_COORDINATOR) {
+                record->disposition = QEMU_THREAD_HOT_FORK_COORDINATOR;
+                qemu_hot_fork_thread_generation++;
+            }
+            qemu_hot_fork_coordinator_thread_id = thread_id;
+            err = pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+            if (err) {
+                error_exit(err, __func__);
+            }
+            return;
+        }
+    }
+    qemu_hot_fork_coordinator_thread_id = thread_id;
+    err = pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+    if (err) {
+        error_exit(err, __func__);
+    }
+
+    /* The QMP main-loop thread is process-lifetime authority. */
+    qemu_hot_fork_thread_register("qemu-main-loop", QEMU_THREAD_DETACHED,
+                                  QEMU_THREAD_HOT_FORK_COORDINATOR);
+}
+
+void qemu_thread_hot_fork_inventory(QemuThreadHotForkInventory *inventory)
+{
+    GList *node;
+    size_t index = 0;
+    int err;
+
+    memset(inventory, 0, sizeof(*inventory));
+    qemu_hot_fork_register_coordinator();
+
+    err = pthread_mutex_lock(&qemu_hot_fork_thread_lock);
+    if (err) {
+        error_exit(err, __func__);
+    }
+    inventory->generation = qemu_hot_fork_thread_generation;
+    inventory->entry_count = qemu_hot_fork_thread_count;
+    inventory->overflow_count = qemu_hot_fork_thread_overflow;
+    inventory->entries = g_new0(QemuThreadHotForkInventoryEntry,
+                                inventory->entry_count);
+    for (node = qemu_hot_fork_threads; node; node = node->next) {
+        QemuHotForkThreadRecord *record = node->data;
+        QemuThreadHotForkInventoryEntry *entry = &inventory->entries[index++];
+
+        entry->thread_id = record->thread_id;
+        entry->name = g_strdup(record->name);
+        entry->joinable = record->joinable;
+        entry->name_valid = record->name_valid;
+        entry->disposition = record->disposition;
+    }
+    assert(index == inventory->entry_count);
+    err = pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+    if (err) {
+        error_exit(err, __func__);
+    }
+    if (inventory->entry_count > 1) {
+        qsort(inventory->entries, inventory->entry_count,
+              sizeof(*inventory->entries),
+              qemu_hot_fork_thread_entry_compare);
+    }
+}
+
+void qemu_thread_hot_fork_inventory_destroy(
+    QemuThreadHotForkInventory *inventory)
+{
+    size_t index;
+
+    for (index = 0; index < inventory->entry_count; index++) {
+        g_free(inventory->entries[index].name);
+    }
+    g_free(inventory->entries);
+    memset(inventory, 0, sizeof(*inventory));
+}
