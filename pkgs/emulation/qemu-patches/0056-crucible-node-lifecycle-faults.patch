+static CrucibleLifecyclePendingReset crucible_lifecycle_pending_reset;
+static bool crucible_lifecycle_node_hung;
+static GArray *crucible_lifecycle_vcpu_hung;
+static GPtrArray *crucible_lifecycle_hangs;
+static uint64_t crucible_lifecycle_next_watchdog_ns = UINT64_MAX;
+
+static bool crucible_lifecycle_mode(void)
+{
+    return strcmp(current_accel_name(), "sim") == 0 &&
+           icount_enabled() == ICOUNT_PRECISE;
+}
+
+static bool crucible_lifecycle_field(
+    const QemuCrucibleFaultRule *rule, uint16_t tag, uint16_t type,
+    const uint8_t **data, uint32_t *length)
+{
+    return qemu_crucible_fault_rule_field(rule, tag, type, data, length);
+}
+
+static bool crucible_lifecycle_u32(
+    const QemuCrucibleFaultRule *rule, uint16_t tag, uint32_t *value)
+{
+    const uint8_t *data;
+    uint32_t length;
+
+    if (!crucible_lifecycle_field(rule, tag,
+            CRUCIBLE_NODE_FAULT_FIELD_TYPE_U32, &data, &length) ||
+        length != sizeof(*value)) {
+        return false;
+    }
+    *value = ldl_le_p(data);
+    return true;
+}
+
+static bool crucible_lifecycle_u64(
+    const QemuCrucibleFaultRule *rule, uint16_t tag, uint64_t *value)
+{
+    const uint8_t *data;
+    uint32_t length;
+
+    if (!crucible_lifecycle_field(rule, tag,
+            CRUCIBLE_NODE_FAULT_FIELD_TYPE_U64, &data, &length) ||
+        length != sizeof(*value)) {
+        return false;
+    }
+    *value = ldq_le_p(data);
+    return true;
+}
+
+static bool crucible_lifecycle_json_u64(const QObject *object,
+                                        uint64_t *value)
+{
+    QNum *number = qobject_to(QNum, object);
+
+    return number && number->kind != QNUM_DOUBLE &&
+           qnum_get_try_uint(number, value);
+}
+
+static bool crucible_lifecycle_transition_name(const char *name,
+                                               uint32_t *transition)
+{
+    static const char *const names[] = {
+        NULL, "boot", "crash", "reset", "power_off", "power_cycle",
+        "permanent_failure",
+    };
+
+    if (!name) {
+        return false;
+    }
+    for (uint32_t value = CRUCIBLE_LIFECYCLE_BOOT;
+         value <= CRUCIBLE_LIFECYCLE_PERMANENT_FAILURE; value++) {
+        if (strcmp(name, names[value]) == 0) {
+            *transition = value;
+            return true;
+        }
+    }
+    return false;
+}
+
+static bool crucible_lifecycle_state_policy(const QObject *object,
+                                            bool device,
+                                            uint32_t *policy)
+{
+    QString *string = qobject_to(QString, object);
+    const char *name = string ? qstring_get_str(string) : NULL;
+
+    if (name && strcmp(name, "preserve") == 0) {
+        *policy = 1;
+        return true;
+    }
+    if (name && strcmp(name, "clear") == 0) {
+        *policy = 2;
+        return true;
+    }
+    if (device && name && strcmp(name, "device_reset") == 0) {
+        *policy = 3;
+        return true;
+    }
+    return false;
+}
+
+static bool crucible_lifecycle_direct_plan(
+    const QemuCrucibleFaultRule *rule, CrucibleLifecyclePlan *plan)
+{
+    return crucible_lifecycle_u32(
+               rule, CRUCIBLE_NODE_FAULT_FIELD_P1, &plan->transition) &&
+           crucible_lifecycle_u64(
+               rule, CRUCIBLE_NODE_FAULT_FIELD_P2, &plan->downtime) &&
+           crucible_lifecycle_u32(
+               rule, CRUCIBLE_NODE_FAULT_FIELD_P4,
+               &plan->volatile_policy) &&
+           crucible_lifecycle_u32(
+               rule, CRUCIBLE_NODE_FAULT_FIELD_P5, &plan->device_policy);
+}
+
+static bool crucible_lifecycle_watchdog_plan(
+    const QemuCrucibleFaultRule *rule, CrucibleLifecyclePlan *plan,
+    uint64_t *timeout)
+{
+    QDict *watchdog = qobject_to(QDict, qemu_crucible_fault_rule_json(
+        rule, CRUCIBLE_NODE_FAULT_FIELD_P4));
+    QDict *parameters;
+    const char *kind;
+    QString *transition;
+
+    kind = watchdog ? qdict_get_try_str(watchdog, "kind") : NULL;
+    if (!kind || strcmp(kind, "transition_after") != 0) {
+        return false;
+    }
+    parameters = qdict_get_qdict(watchdog, "parameters");
+    transition = parameters ?
+        qobject_to(QString, qdict_get(parameters, "transition")) : NULL;
+    return parameters && transition &&
+           crucible_lifecycle_json_u64(
+               qdict_get(parameters, "timeout_nanos"), timeout) &&
+           *timeout != 0 &&
+           crucible_lifecycle_json_u64(
+               qdict_get(parameters, "downtime_nanos"), &plan->downtime) &&
+           crucible_lifecycle_transition_name(
+               qstring_get_str(transition), &plan->transition) &&
+           crucible_lifecycle_state_policy(
+               qdict_get(parameters, "volatile_state_policy"), false,
+               &plan->volatile_policy) &&
+           crucible_lifecycle_state_policy(
+               qdict_get(parameters, "device_state_policy"), true,
+               &plan->device_policy);
+}
+
+static void crucible_lifecycle_sha256(const uint8_t *data, size_t length,
+                                      uint8_t digest[32])
+{
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    gsize digest_length = 32;
+
+    g_checksum_update(checksum, data, length);
+    g_checksum_get_digest(checksum, digest, &digest_length);
+    g_assert(digest_length == 32);
+}
+
+static bool crucible_lifecycle_snapshot(uint8_t digest[32],
+                                        uint64_t *ram_bytes,
+                                        uint64_t *device_bytes)
+{
+    uint8_t material[64] = { 0 };
+    uint8_t device_digest[32];
+    uint64_t ram_hash;
+
+    ram_hash = qemu_plugin_crucible_ram_hash(ram_bytes);
+    if (qemu_plugin_crucible_device_state_sha256(
+            device_digest, device_bytes) != 0) {
+        return false;
+    }
+    memcpy(material, "CRUCLFS1", 8);
+    stq_le_p(material + 8, ram_hash);
+    stq_le_p(material + 16, *ram_bytes);
+    stq_le_p(material + 24, *device_bytes);
+    memcpy(material + 32, device_digest, 32);
+    crucible_lifecycle_sha256(material, sizeof(material), digest);
+    return true;
+}
+
+static int crucible_lifecycle_capture_state(uint32_t domains,
+                                            uint8_t **state,
+                                            size_t *state_len)
+{
+    QIOChannelBuffer *buffer;
+    QEMUFile *file;
+    int status;
+    int close_status;
+
+    *state = NULL;
+    *state_len = 0;
+    if (domains == 0) {
+        return 0;
+    }
+    buffer = qio_channel_buffer_new(4096);
+    file = qemu_file_new_output(QIO_CHANNEL(buffer));
+    status = qemu_save_device_state_domains(file, domains);
+    if (status == 0) {
+        status = qemu_fflush(file);
+    }
+    if (status == 0) {
+        status = qemu_file_get_error(file);
+    }
+    if (status == 0 && buffer->usage == 0) {
+        status = -EIO;
+    }
+    if (status == 0) {
+        *state = g_memdup2(buffer->data, buffer->usage);
+        *state_len = buffer->usage;
+    }
+    close_status = qemu_fclose(file);
+    object_unref(OBJECT(buffer));
+    if (status == 0 && close_status != 0) {
+        status = close_status;
+    }
+    if (status != 0) {
+        g_clear_pointer(state, g_free);
+        *state_len = 0;
+    }
+    return status;
+}
+
+static int crucible_lifecycle_restore_state(const uint8_t *state,
+                                            size_t state_len)
+{
+    QIOChannelBuffer *buffer;
+    QEMUFile *file;
+    int status;
+    int close_status;
+
+    if (!state_len) {
+        return 0;
+    }
+    if (state_len < 8 || ldl_be_p(state) != QEMU_VM_FILE_MAGIC ||
+        ldl_be_p(state + 4) != QEMU_VM_FILE_VERSION) {
+        return -EINVAL;
+    }
+    state += 8;
+    state_len -= 8;
+    buffer = qio_channel_buffer_new(state_len);
+    memcpy(buffer->data, state, state_len);
+    buffer->usage = state_len;
+    file = qemu_file_new_input(QIO_CHANNEL(buffer));
+    status = qemu_load_device_state(file);
+    close_status = qemu_fclose(file);
+    object_unref(OBJECT(buffer));
+    return status == 0 ? close_status : status;
+}
+
+static void crucible_lifecycle_pending_clear(
+    CrucibleLifecyclePendingReset *pending)
+{
+    qemu_crucible_fault_event_reservation_release(pending->reservation);
+    qemu_crucible_fault_rule_unref(pending->rule);
+    g_free(pending->preserved_state);
+    memset(pending, 0, sizeof(*pending));
+}
+
+static int crucible_lifecycle_clear_ram_block(RAMBlock *block, void *opaque)
+{
+    uint64_t *cleared = opaque;
+
+    if (!block->mr || !memory_region_is_ram(block->mr) ||
+        memory_region_is_rom(block->mr) ||
+        memory_region_is_nonvolatile(block->mr)) {
+        return 0;
+    }
+    memset(block->host, 0, block->used_length);
+    memory_region_set_dirty(block->mr, 0, block->used_length);
+    if (*cleared > UINT64_MAX - block->used_length) {
+        return -EOVERFLOW;
+    }
+    *cleared += block->used_length;
+    return 0;
+}
+
+static bool crucible_lifecycle_clear_ram(uint64_t *cleared)
+{
+    CPUState *cpu;
+
+    *cleared = 0;
+    if (qemu_ram_foreach_block(
+            crucible_lifecycle_clear_ram_block, cleared) != 0) {
+        return false;
+    }
+    cpu = qemu_get_cpu(0);
+    if (!cpu) {
+        return false;
+    }
+    tb_flush(cpu);
+    return true;
+}
+
+static void crucible_lifecycle_evidence_begin(
+    uint8_t evidence[CRUCIBLE_LIFECYCLE_EVIDENCE_BYTES],
+    const QemuCrucibleFaultRule *rule, uint32_t transition,
+    uint64_t downtime, uint32_t volatile_policy, uint32_t device_policy,
+    uint64_t observed_icount, int64_t virtual_before,
+    uint64_t ram_bytes, uint64_t device_bytes)
+{
+    memcpy(evidence, "CRUCLIF1", 8);
+    stw_le_p(evidence + 8, 1);
+    stw_le_p(evidence + 10, transition);
+    stl_le_p(evidence + 12, volatile_policy);
+    stl_le_p(evidence + 16, device_policy);
+    stq_le_p(evidence + 24, observed_icount);
+    stq_le_p(evidence + 32, virtual_before);
+    stq_le_p(evidence + 40, downtime);
+    stq_le_p(evidence + 48, ram_bytes);
+    stq_le_p(evidence + 56, device_bytes);
+    memcpy(evidence + 64, qemu_crucible_fault_rule_binding_hash(rule), 32);
+}
+
+static int crucible_lifecycle_advance_downtime(uint64_t downtime,
+                                               int64_t *after)
+{
+    int64_t before = icount_get_observed();
+
+    if (downtime > INT64_MAX || before > INT64_MAX - (int64_t)downtime) {
+        return -EOVERFLOW;
+    }
+    *after = before + downtime;
+    if (downtime != 0) {
+        icount_advance_virtual_time_to_ns(*after);
+    }
+    return 0;
+}
+
+static int crucible_lifecycle_execute(
+    const QemuCrucibleFaultRule *rule, uint64_t observed_icount,
+    const CrucibleLifecyclePlan *plan, bool complete_deferred,
+    uint8_t before_hash[32], uint8_t after_hash[32], GByteArray *evidence,
+    uint16_t *outcome,
+    QemuCrucibleFaultEventReservation **event_reservation)
+{
+    uint8_t bytes[CRUCIBLE_LIFECYCLE_EVIDENCE_BYTES] = { 0 };
+    g_autofree uint8_t *preserved_state = NULL;
+    uint32_t transition = plan->transition;
+    uint32_t volatile_policy = plan->volatile_policy;
+    uint32_t device_policy = plan->device_policy;
+    uint32_t preserved_domains = 0;
+    uint64_t downtime = plan->downtime;
+    uint64_t ram_bytes, device_bytes, cleared = 0;
+    size_t preserved_state_len = 0;
+    int64_t virtual_before = icount_get_observed();
+    int64_t virtual_after;
+    bool reset_transition;
+
+    if (!crucible_lifecycle_snapshot(before_hash, &ram_bytes,
+                                      &device_bytes)) {
+        return -EINVAL;
+    }
+    reset_transition = transition == CRUCIBLE_LIFECYCLE_BOOT ||
+                       transition == CRUCIBLE_LIFECYCLE_RESET ||
+                       transition == CRUCIBLE_LIFECYCLE_POWER_CYCLE;
+    if (reset_transition) {
+        CrucibleLifecyclePendingReset *pending =
+            &crucible_lifecycle_pending_reset;
+
+        if (pending->rule || !event_reservation || !*event_reservation) {
+            return -EBUSY;
+        }
+        if (volatile_policy == 1) {
+            preserved_domains |= QEMU_CRUCIBLE_LIFECYCLE_STATE_VOLATILE;
+        }
+        if (device_policy == 1) {
+            preserved_domains |= QEMU_CRUCIBLE_LIFECYCLE_STATE_DEVICE;
+        }
+        if (crucible_lifecycle_capture_state(
+                preserved_domains, &preserved_state,
+                &preserved_state_len) != 0) {
+            return -EIO;
+        }
+    }
+    if (crucible_lifecycle_advance_downtime(
+            downtime, &virtual_after) != 0) {
+        return -EOVERFLOW;
+    }
+    if (volatile_policy == 2 && !crucible_lifecycle_clear_ram(&cleared)) {
+        return -EIO;
+    }
+    crucible_lifecycle_evidence_begin(
+        bytes, rule, transition, downtime, volatile_policy, device_policy,
+        observed_icount, virtual_before, ram_bytes, device_bytes);
+    stq_le_p(bytes + 96, virtual_after);
+    stq_le_p(bytes + 104, cleared);
+    stl_le_p(bytes + 20, preserved_domains);
+    if (reset_transition) {
+        CrucibleLifecyclePendingReset *pending =
+            &crucible_lifecycle_pending_reset;
+
+        pending->rule = qemu_crucible_fault_rule_copy(rule);
+        pending->reservation = *event_reservation;
+        *event_reservation = NULL;
+        pending->observed_icount = observed_icount;
+        memcpy(pending->before_hash, before_hash, 32);
+        memcpy(pending->evidence, bytes, sizeof(bytes));
+        pending->preserved_state = g_steal_pointer(&preserved_state);
+        pending->preserved_state_len = preserved_state_len;
+        pending->complete_deferred = complete_deferred;
+        qemu_system_reset_request(SHUTDOWN_CAUSE_HOST_QMP_SYSTEM_RESET);
+        return QEMU_CRUCIBLE_FAULT_IMPULSE_DEFERRED;
+    }
+
+    memcpy(bytes + 112, "terminal", 8);
+    crucible_lifecycle_sha256(bytes, sizeof(bytes), after_hash);
+    memcpy(bytes + 128, before_hash, 32);
+    memcpy(bytes + 160, after_hash, 32);
+    g_byte_array_append(evidence, bytes, sizeof(bytes));
+    *outcome = CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED;
+    switch (transition) {
+    case CRUCIBLE_LIFECYCLE_CRASH:
+        qemu_system_shutdown_request_with_code(
+            SHUTDOWN_CAUSE_HOST_ERROR, CRUCIBLE_LIFECYCLE_EXIT_CRASH);
+        break;
+    case CRUCIBLE_LIFECYCLE_POWER_OFF:
+        qemu_system_shutdown_request_with_code(
+            SHUTDOWN_CAUSE_HOST_ERROR, CRUCIBLE_LIFECYCLE_EXIT_POWER_OFF);
+        break;
+    case CRUCIBLE_LIFECYCLE_PERMANENT_FAILURE:
+        qemu_system_shutdown_request_with_code(
+            SHUTDOWN_CAUSE_HOST_ERROR,
+            CRUCIBLE_LIFECYCLE_EXIT_PERMANENT_FAILURE);
+        break;
+    default:
+        return -EINVAL;
+    }
+    return 0;
+}
+
+static int crucible_lifecycle_impulse(
+    const QemuCrucibleFaultRule *rule, uint64_t observed_icount,
+    uint8_t before_hash[32], uint8_t after_hash[32], GByteArray *evidence,
+    uint16_t *outcome,
+    QemuCrucibleFaultEventReservation **event_reservation)
+{
+    CrucibleLifecyclePlan plan;
+
+    if (!crucible_lifecycle_direct_plan(rule, &plan)) {
+        return -EINVAL;
+    }
+    return crucible_lifecycle_execute(
+        rule, observed_icount, &plan, true, before_hash, after_hash,
+        evidence, outcome, event_reservation);
+}
+
+void qemu_crucible_fault_lifecycle_reset_complete(void)
+{
+    CrucibleLifecyclePendingReset *pending =
+        &crucible_lifecycle_pending_reset;
+    uint8_t after_hash[32], opportunity_hash[32];
+    uint64_t ram_bytes, device_bytes;
+
+    if (!pending->rule) {
+        return;
+    }
+    if (crucible_lifecycle_restore_state(
+            pending->preserved_state, pending->preserved_state_len) != 0 ||
+        !crucible_lifecycle_snapshot(after_hash, &ram_bytes, &device_bytes)) {
+        if (pending->complete_deferred) {
+            qemu_crucible_fault_fail_deferred(
+                pending->rule, pending->observed_icount,
+                pending->before_hash);
+        } else {
+            memcpy(after_hash, pending->before_hash, sizeof(after_hash));
+            crucible_lifecycle_sha256(
+                pending->evidence, sizeof(pending->evidence),
+                opportunity_hash);
+            qemu_crucible_fault_event_reservation_consume(
+                pending->reservation);
+            qemu_crucible_fault_rule_event(
+                pending->rule, CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR,
+                pending->observed_icount, opportunity_hash,
+                pending->before_hash, after_hash,
+                pending->evidence, sizeof(pending->evidence));
+        }
+        crucible_lifecycle_pending_clear(pending);
+        return;
+    }
+    stq_le_p(pending->evidence + 112, ram_bytes);
+    stq_le_p(pending->evidence + 120, device_bytes);
+    memcpy(pending->evidence + 128, pending->before_hash, 32);
+    memcpy(pending->evidence + 160, after_hash, 32);
+    crucible_lifecycle_sha256(pending->evidence,
+                               sizeof(pending->evidence), opportunity_hash);
+    qemu_crucible_fault_event_reservation_consume(pending->reservation);
+    qemu_crucible_fault_rule_event(
+        pending->rule, CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED,
+        pending->observed_icount, opportunity_hash,
+        pending->before_hash, after_hash,
+        pending->evidence, sizeof(pending->evidence));
+    if (pending->complete_deferred) {
+        qemu_crucible_fault_complete_deferred(
+            pending->rule, pending->observed_icount,
+            MAX(pending->observed_icount, qemu_plugin_icount_raw()),
+            pending->before_hash, after_hash);
+    }
+    crucible_lifecycle_pending_clear(pending);
+}
+
+static bool crucible_lifecycle_vcpu_exists(uint32_t target)
+{
+    return qemu_get_cpu(target) != NULL;
+}
+
+int qemu_crucible_fault_lifecycle_validate(
+    const QemuCrucibleFaultRule *rule)
+{
+    uint16_t kind = qemu_crucible_fault_rule_command_kind(rule);
+    uint32_t value;
+
+    if (!crucible_lifecycle_mode()) {
+        return -ENOTSUP;
+    }
+    if (kind == CRUCIBLE_FAULT_COMMAND_NODE_LIFECYCLE) {
+        CrucibleLifecyclePlan plan;
+
+        return qemu_crucible_fault_rule_operation(rule) ==
+                   CRUCIBLE_NODE_FAULT_OPERATION_APPLY &&
+               crucible_lifecycle_direct_plan(rule, &plan) &&
+               plan.transition >= CRUCIBLE_LIFECYCLE_BOOT &&
+               plan.transition <= CRUCIBLE_LIFECYCLE_PERMANENT_FAILURE &&
+               plan.volatile_policy >= 1 && plan.volatile_policy <= 2 &&
+               plan.device_policy >= 1 && plan.device_policy <= 3 &&
+               plan.downtime <= INT64_MAX ? 0 : -EINVAL;
+    }
+    if (kind == CRUCIBLE_FAULT_COMMAND_NODE_HANG) {
+        const QObject *object;
+        QDict *scope;
+        QList *list;
+        QListEntry *entry;
+
+        if (qemu_crucible_fault_rule_operation(rule) ==
+                CRUCIBLE_NODE_FAULT_OPERATION_REMOVE) {
+            return 0;
+        }
+        if (!crucible_lifecycle_u32(
+                rule, CRUCIBLE_NODE_FAULT_FIELD_P1, &value)) {
+            return -EINVAL;
+        }
+        {
+            CrucibleLifecyclePlan plan;
+            uint64_t timeout;
+            QDict *watchdog = qobject_to(
+                QDict, qemu_crucible_fault_rule_json(
+                    rule, CRUCIBLE_NODE_FAULT_FIELD_P4));
+            const char *watchdog_kind =
+                watchdog ? qdict_get_try_str(watchdog, "kind") : NULL;
+
+            if (!watchdog_kind ||
+                (strcmp(watchdog_kind, "disabled") != 0 &&
+                 (!crucible_lifecycle_watchdog_plan(
+                      rule, &plan, &timeout) ||
+                  timeout > INT64_MAX || plan.downtime > INT64_MAX))) {
+                return -EINVAL;
+            }
+        }
+        if (value == 1) {
+            return 0;
+        }
+        object = qemu_crucible_fault_rule_json(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_P2);
+        scope = qobject_to(QDict, object);
+        list = scope ? qobject_to(QList, qdict_get(scope, "parameters")) : NULL;
+        if (value != 2 || !list || qlist_empty(list)) {
+            return value == 3 ? 0 : -EINVAL;
+        }
+        QLIST_FOREACH_ENTRY(list, entry) {
+            uint64_t vcpu = qnum_get_uint(
+                qobject_to(QNum, qlist_entry_obj(entry)));
+
+            if (vcpu > UINT32_MAX || !crucible_lifecycle_vcpu_exists(vcpu)) {
+                return -EINVAL;
+            }
+        }
+        return 0;
+    }
+    return -EINVAL;
+}
+
+size_t qemu_crucible_fault_lifecycle_event_budget(
+    const QemuCrucibleFaultRule *rule)
+{
+    CrucibleLifecyclePlan plan;
+    uint64_t timeout;
+
+    if (qemu_crucible_fault_rule_command_kind(rule) !=
+            CRUCIBLE_FAULT_COMMAND_NODE_HANG ||
+        qemu_crucible_fault_rule_operation(rule) !=
+            CRUCIBLE_NODE_FAULT_OPERATION_UPSERT) {
+        return 0;
+    }
+    return crucible_lifecycle_watchdog_plan(rule, &plan, &timeout) ? 3 : 2;
+}
+
+static void crucible_lifecycle_apply_hang(
+    const QemuCrucibleFaultRule *rule, void *opaque)
+{
+    CrucibleHangApply *apply = opaque;
+    const QObject *object;
+    QDict *scope;
+    QList *list;
+    QListEntry *entry;
+    uint32_t kind;
+
+    if (!crucible_lifecycle_u32(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_P1, &kind)) {
+        abort();
+    }
+    if (kind == 1) {
+        apply->node_hung = true;
+        return;
+    }
+    if (kind != 2) {
+        return;
+    }
+    object = qemu_crucible_fault_rule_json(
+        rule, CRUCIBLE_NODE_FAULT_FIELD_P2);
+    scope = qobject_to(QDict, object);
+    list = scope ? qobject_to(QList, qdict_get(scope, "parameters")) : NULL;
+    if (!list) {
+        abort();
+    }
+    QLIST_FOREACH_ENTRY(list, entry) {
+        uint64_t vcpu = qnum_get_uint(
+            qobject_to(QNum, qlist_entry_obj(entry)));
+
+        if (vcpu >= apply->vcpu_hung->len) {
+            abort();
+        }
+        g_array_index(apply->vcpu_hung, bool, vcpu) = true;
+    }
+}
+
+static void crucible_hang_state_free(gpointer opaque)
+{
+    CrucibleHangState *state = opaque;
+
+    if (!state) {
+        return;
+    }
+    if (state->activation_reservation) {
+        qemu_crucible_fault_event_reservation_release(
+            state->activation_reservation);
+    }
+    if (state->watchdog_reservation) {
+        qemu_crucible_fault_event_reservation_release(
+            state->watchdog_reservation);
+    }
+    if (state->recovery_reservation) {
+        qemu_crucible_fault_event_reservation_release(
+            state->recovery_reservation);
+    }
+    qemu_crucible_fault_rule_unref(state->rule);
+    g_free(state);
+}
+
+static void crucible_hang_digest(const GPtrArray *states,
+                                 uint8_t digest[32])
+{
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    gsize digest_length = 32;
+
+    g_checksum_update(checksum, (const uint8_t *)"CRUCHGS1", 8);
+    if (states) {
+        for (guint index = 0; index < states->len; index++) {
+            CrucibleHangState *state = g_ptr_array_index(states, index);
+            uint8_t scalar[40] = { 0 };
+
+            stq_le_p(scalar, qemu_crucible_fault_rule_generation(
+                state->rule));
+            stq_le_p(scalar + 8, state->entered_icount);
+            stq_le_p(scalar + 16, state->entered_virtual_ns);
+            stq_le_p(scalar + 24, state->watchdog_deadline_ns);
+            scalar[32] = state->watchdog_enabled;
+            scalar[33] = state->watchdog_fired;
+            g_checksum_update(
+                checksum, qemu_crucible_fault_rule_binding_hash(state->rule),
+                32);
+            g_checksum_update(checksum, scalar, sizeof(scalar));
+        }
+    }
+    g_checksum_get_digest(checksum, digest, &digest_length);
+    g_assert(digest_length == 32);
+}
+
+static void crucible_hang_event(
+    CrucibleHangState *state, uint32_t event_kind,
+    QemuCrucibleFaultEventReservation **reservation,
+    const uint8_t before_hash[32], const uint8_t after_hash[32])
+{
+    uint8_t evidence[CRUCIBLE_HANG_EVIDENCE_BYTES] = { 0 };
+    uint8_t opportunity_hash[32];
+    uint32_t scope;
+    uint64_t now = icount_get_observed();
+
+    if (!reservation || !*reservation ||
+        !crucible_lifecycle_u32(
+            state->rule, CRUCIBLE_NODE_FAULT_FIELD_P1, &scope)) {
+        error_report("Crucible hang transition lacked reserved evidence");
+        abort();
+    }
+    memcpy(evidence, "CRUCHNG1", 8);
+    stw_le_p(evidence + 8, 1);
+    stw_le_p(evidence + 10, event_kind);
+    stl_le_p(evidence + 12, scope);
+    stq_le_p(evidence + 16, state->entered_icount);
+    stq_le_p(evidence + 24, state->entered_virtual_ns);
+    stq_le_p(evidence + 32, now);
+    stq_le_p(evidence + 40, state->watchdog_deadline_ns);
+    stq_le_p(evidence + 48,
+             qemu_crucible_fault_rule_generation(state->rule));
+    stq_le_p(evidence + 56, qemu_plugin_icount_raw());
+    memcpy(evidence + 64,
+           qemu_crucible_fault_rule_binding_hash(state->rule), 32);
+    memcpy(evidence + 96,
+           qemu_crucible_fault_rule_action_hash(state->rule), 32);
+    memcpy(evidence + 128, before_hash, 32);
+    memcpy(evidence + 160, after_hash, 32);
+    crucible_lifecycle_sha256(
+        evidence, sizeof(evidence), opportunity_hash);
+    qemu_crucible_fault_event_reservation_consume(*reservation);
+    qemu_crucible_fault_rule_event(
+        state->rule, CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED,
+        qemu_plugin_icount_raw(), opportunity_hash, before_hash, after_hash,
+        evidence, sizeof(evidence));
+    qemu_crucible_fault_event_reservation_release(*reservation);
+    *reservation = NULL;
+}
+
+typedef struct CrucibleHangRebuild {
+    GPtrArray *previous;
+    GPtrArray *next;
+    const QemuCrucibleFaultRule *transition_rule;
+    QemuCrucibleFaultEventReservation **event_reservation;
+} CrucibleHangRebuild;
+
+static CrucibleHangState *crucible_hang_previous_take(
+    CrucibleHangRebuild *rebuild, const QemuCrucibleFaultRule *rule)
+{
+    for (guint index = 0; index < rebuild->previous->len; index++) {
+        CrucibleHangState *state =
+            g_ptr_array_index(rebuild->previous, index);
+
+        if (qemu_crucible_fault_rule_generation(state->rule) ==
+                qemu_crucible_fault_rule_generation(rule) &&
+            memcmp(qemu_crucible_fault_rule_binding_hash(state->rule),
+                   qemu_crucible_fault_rule_binding_hash(rule), 32) == 0) {
+            return g_ptr_array_steal_index(rebuild->previous, index);
+        }
+    }
+    return NULL;
+}
+
+static void crucible_hang_rebuild_visit(
+    const QemuCrucibleFaultRule *rule, void *opaque)
+{
+    CrucibleHangRebuild *rebuild = opaque;
+    CrucibleHangState *state =
+        crucible_hang_previous_take(rebuild, rule);
+    CrucibleLifecyclePlan plan;
+    uint64_t timeout;
+    int64_t entered_virtual_ns;
+
+    if (state) {
+        g_ptr_array_add(rebuild->next, state);
+        return;
+    }
+    if (!rebuild->transition_rule || !rebuild->event_reservation ||
+        !*rebuild->event_reservation ||
+        memcmp(qemu_crucible_fault_rule_binding_hash(rule),
+               qemu_crucible_fault_rule_binding_hash(
+                   rebuild->transition_rule), 32) != 0) {
+        error_report("Crucible hang activation lacked prepared evidence");
+        abort();
+    }
+    state = g_new0(CrucibleHangState, 1);
+    state->rule = qemu_crucible_fault_rule_copy(rule);
+    state->entered_icount = qemu_plugin_icount_raw();
+    entered_virtual_ns = icount_get_observed();
+    if (entered_virtual_ns < 0) {
+        error_report("Crucible hang entered at negative virtual time");
+        abort();
+    }
+    state->entered_virtual_ns = entered_virtual_ns;
+    state->watchdog_enabled = crucible_lifecycle_watchdog_plan(
+        rule, &plan, &timeout);
+    if (state->watchdog_enabled) {
+        if (timeout > INT64_MAX - entered_virtual_ns) {
+            error_report("Crucible watchdog deadline overflowed after prepare");
+            abort();
+        }
+        state->watchdog_deadline_ns = state->entered_virtual_ns + timeout;
+    } else {
+        state->watchdog_deadline_ns = UINT64_MAX;
+    }
+    {
+        state->activation_reservation =
+            qemu_crucible_fault_event_reservation_split(
+                *rebuild->event_reservation, 1);
+        state->recovery_reservation =
+            qemu_crucible_fault_event_reservation_split(
+                *rebuild->event_reservation, 1);
+        if (state->watchdog_enabled) {
+            state->watchdog_reservation =
+                qemu_crucible_fault_event_reservation_split(
+                    *rebuild->event_reservation, 1);
+        }
+    }
+    g_ptr_array_add(rebuild->next, state);
+}
+
+static void crucible_hang_effective_recompute(void)
+{
+    CPUState *cpu;
+    guint count = 0;
+    CrucibleHangApply apply = { 0 };
+    GArray *next;
+
+    CPU_FOREACH(cpu) {
+        if (cpu->cpu_index < 0 || (guint)cpu->cpu_index != count) {
+            abort();
+        }
+        if (count == G_MAXUINT) {
+            abort();
+        }
+        count++;
+    }
+    next = g_array_sized_new(false, true, sizeof(bool), count);
+    g_array_set_size(next, count);
+    apply.vcpu_hung = next;
+    if (crucible_lifecycle_hangs) {
+        for (guint index = 0;
+             index < crucible_lifecycle_hangs->len; index++) {
+            CrucibleHangState *state =
+                g_ptr_array_index(crucible_lifecycle_hangs, index);
+
+            if (!state->watchdog_fired) {
+                crucible_lifecycle_apply_hang(state->rule, &apply);
+            }
+        }
+    }
+    if (crucible_lifecycle_vcpu_hung) {
+        g_array_unref(crucible_lifecycle_vcpu_hung);
+    }
+    crucible_lifecycle_vcpu_hung = next;
+    crucible_lifecycle_node_hung = apply.node_hung;
+}
+
+void qemu_crucible_fault_lifecycle_rules_changed(
+    const QemuCrucibleFaultRule *transition_rule,
+    QemuCrucibleFaultEventReservation **event_reservation)
+{
+    GPtrArray *previous;
+    GPtrArray *next_hangs;
+    CrucibleHangRebuild rebuild;
+    uint8_t before_hash[32], after_hash[32];
+
+    if (!crucible_lifecycle_mode()) {
+        return;
+    }
+    previous = crucible_lifecycle_hangs ?
+        crucible_lifecycle_hangs :
+        g_ptr_array_new_with_free_func(crucible_hang_state_free);
+    next_hangs = g_ptr_array_new_with_free_func(crucible_hang_state_free);
+    crucible_hang_digest(previous, before_hash);
+    rebuild = (CrucibleHangRebuild) {
+        .previous = previous,
+        .next = next_hangs,
+        .transition_rule = transition_rule,
+        .event_reservation = event_reservation,
+    };
+    qemu_crucible_fault_rule_foreach(
+        CRUCIBLE_FAULT_COMMAND_NODE_HANG,
+        crucible_hang_rebuild_visit, &rebuild);
+    crucible_hang_digest(next_hangs, after_hash);
+    for (guint index = 0; index < previous->len; index++) {
+        CrucibleHangState *state = g_ptr_array_index(previous, index);
+
+        if (state->recovery_reservation) {
+            crucible_hang_event(
+                state, CRUCIBLE_HANG_RECOVERED,
+                &state->recovery_reservation, before_hash, after_hash);
+        }
+    }
+    for (guint index = 0; index < next_hangs->len; index++) {
+        CrucibleHangState *state = g_ptr_array_index(next_hangs, index);
+        if (state->activation_reservation) {
+            crucible_hang_event(
+                state, CRUCIBLE_HANG_ACTIVATED,
+                &state->activation_reservation,
+                before_hash, after_hash);
+        }
+    }
+    g_ptr_array_unref(previous);
+    crucible_lifecycle_hangs = next_hangs;
+    crucible_lifecycle_next_watchdog_ns = UINT64_MAX;
+    for (guint index = 0; index < next_hangs->len; index++) {
+        CrucibleHangState *state = g_ptr_array_index(next_hangs, index);
+
+        if (state->watchdog_enabled && !state->watchdog_fired) {
+            crucible_lifecycle_next_watchdog_ns = MIN(
+                crucible_lifecycle_next_watchdog_ns,
+                state->watchdog_deadline_ns);
+        }
+    }
+    crucible_hang_effective_recompute();
+}
+
+bool qemu_crucible_fault_node_hung(void)
+{
+    return crucible_lifecycle_node_hung;
+}
+
+bool qemu_crucible_fault_vcpu_hung(uint32_t vcpu)
+{
+    return crucible_lifecycle_vcpu_hung &&
+           vcpu < crucible_lifecycle_vcpu_hung->len &&
+           g_array_index(crucible_lifecycle_vcpu_hung, bool, vcpu);
+}
+
+static void crucible_lifecycle_watchdog_recompute(void)
+{
+    crucible_lifecycle_next_watchdog_ns = UINT64_MAX;
+    if (!crucible_lifecycle_hangs) {
+        return;
+    }
+    for (guint index = 0; index < crucible_lifecycle_hangs->len; index++) {
+        CrucibleHangState *state =
+            g_ptr_array_index(crucible_lifecycle_hangs, index);
+
+        if (state->watchdog_enabled && !state->watchdog_fired) {
+            crucible_lifecycle_next_watchdog_ns = MIN(
+                crucible_lifecycle_next_watchdog_ns,
+                state->watchdog_deadline_ns);
+        }
+    }
+}
+
+static unsigned int crucible_lifecycle_transition_rank(uint32_t transition)
+{
+    switch (transition) {
+    case CRUCIBLE_LIFECYCLE_BOOT:
+        return 1;
+    case CRUCIBLE_LIFECYCLE_RESET:
+        return 2;
+    case CRUCIBLE_LIFECYCLE_POWER_CYCLE:
+        return 3;
+    case CRUCIBLE_LIFECYCLE_CRASH:
+        return 4;
+    case CRUCIBLE_LIFECYCLE_POWER_OFF:
+        return 5;
+    case CRUCIBLE_LIFECYCLE_PERMANENT_FAILURE:
+        return 6;
+    default:
+        return 0;
+    }
+}
+
+static unsigned int crucible_lifecycle_device_policy_rank(uint32_t policy)
+{
+    switch (policy) {
+    case 1: /* preserve */
+        return 1;
+    case 3: /* device_reset */
+        return 2;
+    case 2: /* clear */
+        return 3;
+    default:
+        return 0;
+    }
+}
+
+static void crucible_lifecycle_plan_compose(
+    CrucibleLifecyclePlan *resolved, const CrucibleLifecyclePlan *candidate)
+{
+    if (crucible_lifecycle_transition_rank(candidate->transition) >
+        crucible_lifecycle_transition_rank(resolved->transition)) {
+        resolved->transition = candidate->transition;
+    }
+    resolved->downtime = MAX(resolved->downtime, candidate->downtime);
+    if (candidate->volatile_policy == 2) {
+        resolved->volatile_policy = 2;
+    }
+    if (crucible_lifecycle_device_policy_rank(candidate->device_policy) >
+        crucible_lifecycle_device_policy_rank(resolved->device_policy)) {
+        resolved->device_policy = candidate->device_policy;
+    }
+}
+
+static bool crucible_lifecycle_watchdog_wins(
+    const CrucibleHangState *candidate,
+    const CrucibleLifecyclePlan *candidate_plan,
+    const CrucibleHangState *winner,
+    const CrucibleLifecyclePlan *winner_plan)
+{
+    unsigned int candidate_rank =
+        crucible_lifecycle_transition_rank(candidate_plan->transition);
+    unsigned int winner_rank =
+        crucible_lifecycle_transition_rank(winner_plan->transition);
+
+    return candidate_rank > winner_rank ||
+           (candidate_rank == winner_rank &&
+            memcmp(qemu_crucible_fault_rule_binding_hash(candidate->rule),
+                   qemu_crucible_fault_rule_binding_hash(winner->rule),
+                   32) < 0);
+}
+
+static void crucible_lifecycle_watchdog_composition_event(
+    CrucibleHangState *state, const CrucibleHangState *winner,
+    const CrucibleLifecyclePlan *requested,
+    const CrucibleLifecyclePlan *resolved, uint64_t observed_icount,
+    uint64_t observed_virtual_ns, const uint8_t before_hash[32],
+    const uint8_t after_hash[32])
+{
+    uint8_t evidence[CRUCIBLE_WATCHDOG_COMPOSITION_EVIDENCE_BYTES] = { 0 };
+    uint8_t opportunity_hash[32];
+
+    if (!state->watchdog_reservation) {
+        error_report("Crucible composed watchdog lacked reserved evidence");
+        abort();
+    }
+    memcpy(evidence, "CRUCWDC1", 8);
+    stw_le_p(evidence + 8, 1);
+    stw_le_p(evidence + 10, requested->transition);
+    stw_le_p(evidence + 12, resolved->transition);
+    stl_le_p(evidence + 16, requested->volatile_policy);
+    stl_le_p(evidence + 20, requested->device_policy);
+    stl_le_p(evidence + 24, resolved->volatile_policy);
+    stl_le_p(evidence + 28, resolved->device_policy);
+    stq_le_p(evidence + 32, requested->downtime);
+    stq_le_p(evidence + 40, resolved->downtime);
+    stq_le_p(evidence + 48, state->watchdog_deadline_ns);
+    stq_le_p(evidence + 56, observed_virtual_ns);
+    memcpy(evidence + 64,
+           qemu_crucible_fault_rule_binding_hash(state->rule), 32);
+    memcpy(evidence + 96,
+           qemu_crucible_fault_rule_binding_hash(winner->rule), 32);
+    memcpy(evidence + 128,
+           qemu_crucible_fault_rule_action_hash(state->rule), 32);
+    memcpy(evidence + 160,
+           qemu_crucible_fault_rule_action_hash(winner->rule), 32);
+    crucible_lifecycle_sha256(evidence, sizeof(evidence), opportunity_hash);
+    qemu_crucible_fault_event_reservation_consume(
+        state->watchdog_reservation);
+    qemu_crucible_fault_rule_event(
+        state->rule, CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED,
+        observed_icount, opportunity_hash, before_hash, after_hash,
+        evidence, sizeof(evidence));
+    qemu_crucible_fault_event_reservation_release(
+        state->watchdog_reservation);
+    state->watchdog_reservation = NULL;
+}
+
+static void crucible_lifecycle_watchdog_boundary(
+    uint16_t phase, uint64_t observed_icount)
+{
+    g_autoptr(GPtrArray) due = NULL;
+    CrucibleHangState *winner = NULL;
+    CrucibleLifecyclePlan winner_plan = { 0 };
+    CrucibleLifecyclePlan resolved = { 0 };
+    uint8_t hang_before_hash[32], hang_after_hash[32];
+    uint64_t now;
+
+    if (phase != CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY ||
+        !crucible_lifecycle_mode() || !crucible_lifecycle_hangs ||
+        crucible_lifecycle_pending_reset.rule) {
+        return;
+    }
+    now = icount_get_observed();
+    due = g_ptr_array_new();
+    for (guint index = 0; index < crucible_lifecycle_hangs->len; index++) {
+        CrucibleHangState *state =
+            g_ptr_array_index(crucible_lifecycle_hangs, index);
+        CrucibleLifecyclePlan plan;
+        uint64_t timeout;
+
+        if (!state->watchdog_enabled || state->watchdog_fired ||
+            state->watchdog_deadline_ns > now) {
+            continue;
+        }
+        if (!state->watchdog_reservation ||
+            !crucible_lifecycle_watchdog_plan(
+                state->rule, &plan, &timeout)) {
+            error_report("Crucible watchdog lost its prepared plan");
+            abort();
+        }
+        g_ptr_array_add(due, state);
+        if (!winner) {
+            winner = state;
+            winner_plan = plan;
+            resolved = plan;
+        } else {
+            crucible_lifecycle_plan_compose(&resolved, &plan);
+            if (crucible_lifecycle_watchdog_wins(
+                    state, &plan, winner, &winner_plan)) {
+                winner = state;
+                winner_plan = plan;
+            }
+        }
+    }
+    if (!winner) {
+        crucible_lifecycle_watchdog_recompute();
+        return;
+    }
+    crucible_hang_digest(crucible_lifecycle_hangs, hang_before_hash);
+    for (guint index = 0; index < due->len; index++) {
+        CrucibleHangState *state = g_ptr_array_index(due, index);
+
+        state->watchdog_fired = true;
+    }
+    crucible_hang_digest(crucible_lifecycle_hangs, hang_after_hash);
+    crucible_hang_effective_recompute();
+    for (guint index = 0; index < due->len; index++) {
+        CrucibleHangState *state = g_ptr_array_index(due, index);
+
+        crucible_hang_event(
+            state, CRUCIBLE_HANG_RECOVERED,
+            &state->recovery_reservation,
+            hang_before_hash, hang_after_hash);
+    }
+    for (guint index = 0; index < due->len; index++) {
+        CrucibleHangState *state = g_ptr_array_index(due, index);
+        CrucibleLifecyclePlan requested;
+        uint64_t timeout;
+
+        if (state == winner) {
+            continue;
+        }
+        if (!crucible_lifecycle_watchdog_plan(
+                state->rule, &requested, &timeout)) {
+            error_report("Crucible composed watchdog lost its plan");
+            abort();
+        }
+        crucible_lifecycle_watchdog_composition_event(
+            state, winner, &requested, &resolved, observed_icount, now,
+            hang_before_hash, hang_after_hash);
+    }
+    {
+        g_autoptr(GByteArray) evidence = g_byte_array_new();
+        uint8_t before_hash[32], after_hash[32], opportunity_hash[32];
+        uint16_t outcome = CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED;
+        int status;
+
+        status = crucible_lifecycle_execute(
+            winner->rule, observed_icount, &resolved, false,
+            before_hash, after_hash, evidence, &outcome,
+            &winner->watchdog_reservation);
+        if (status != 0 &&
+            status != QEMU_CRUCIBLE_FAULT_IMPULSE_DEFERRED) {
+            error_report("Crucible prepared watchdog transition failed");
+            abort();
+        }
+        if (status == 0) {
+            if (evidence->len == 0) {
+                error_report("Crucible watchdog transition omitted evidence");
+                abort();
+            }
+            crucible_lifecycle_sha256(
+                evidence->data, evidence->len, opportunity_hash);
+            qemu_crucible_fault_event_reservation_consume(
+                winner->watchdog_reservation);
+            qemu_crucible_fault_rule_event(
+                winner->rule, outcome, observed_icount, opportunity_hash,
+                before_hash, after_hash, evidence->data, evidence->len);
+            qemu_crucible_fault_event_reservation_release(
+                winner->watchdog_reservation);
+            winner->watchdog_reservation = NULL;
+        }
+    }
+    crucible_lifecycle_watchdog_recompute();
+}
+
+static uint64_t crucible_lifecycle_watchdog_deadline(uint16_t phase)
+{
+    return phase == CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY &&
+           crucible_lifecycle_mode() ?
+        crucible_lifecycle_next_watchdog_ns : UINT64_MAX;
+}
+
+static void crucible_lifecycle_register(void)
+{
+    const uint32_t boundary =
+        1U << (CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY - 1);
+
+    qemu_crucible_fault_node_register(
+        CRUCIBLE_FAULT_COMMAND_NODE_LIFECYCLE,
+        QEMU_PLUGIN_CRUCIBLE_FAULT_SCOPE_ALL, boundary,
+        "qemu.node.lifecycle.v1", crucible_lifecycle_impulse);
+    qemu_crucible_fault_node_register(
+        CRUCIBLE_FAULT_COMMAND_NODE_HANG,
+        QEMU_PLUGIN_CRUCIBLE_FAULT_SCOPE_ALL, boundary,
+        "qemu.node.hang.v1", NULL);
+    qemu_crucible_fault_boundary_observer_register(
+        crucible_lifecycle_watchdog_boundary);
+    qemu_crucible_fault_boundary_deadline_register(
+        crucible_lifecycle_watchdog_deadline);
+}
+
+type_init(crucible_lifecycle_register)
