+                cpu_budget = rr_crucible_sim_clamp_boundary_deadline(
+                    cpu_budget);
                 if (cpu_budget == 0) {
                     qemu_crucible_fault_dispatch_boundary(
                         CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY,
@@ -658,6 +747,9 @@ static void *rr_cpu_thread_fn(void *arg)
 
             if (!qemu_crucible_fault_vcpu_service_eligible(cpu)) {
                 qemu_crucible_fault_vcpu_service_skipped(cpu);
+                if (rr_crucible_sim_advance_stalled_deadline()) {
+                    break;
+                }
             } else if (cpu_can_run(cpu)) {
                 if (rr_crucible_sim_run_tcg_batch(&cpu, &cpu_budget)) {
                     break;
@@ -683,6 +775,15 @@ static void *rr_cpu_thread_fn(void *arg)
             rr_crucible_sim_reset_exit_request(cpu);
         }
 
+        /*
+         * A control command can make the last runnable vCPU ineligible and
+         * request its exit in the same boundary callback.  In that case the
+         * loop above breaks before it reaches the ordinary eligibility check.
+         * Service the virtual deadline here as well, before entering an I/O
+         * wait that no guest execution can wake.
+         */
+        rr_crucible_sim_advance_stalled_deadline();
