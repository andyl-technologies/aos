@@ -32,6 +32,7 @@
 #include "qemu/notify.h"
 #include "qemu/guest-random.h"
 #include "qemu/accel.h"
+#include "qemu/error-report.h"
 #include "qemu/plugin.h"
 #include "qemu/timer.h"
 #include "exec/cpu-common.h"
@@ -93,6 +94,87 @@ static CPUState *rr_crucible_sim_loop_cpu(CPUState *cpu)
     return cpu;
 }
 
+static bool rr_crucible_sim_service_available(void)
+{
+    CPUState *cpu;
+
+    CPU_FOREACH(cpu) {
+        if (qemu_crucible_fault_vcpu_service_eligible(cpu)) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static bool rr_crucible_sim_boundary_deadline_active(void)
+{
+    return qemu_crucible_fault_next_boundary_deadline(
+               CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY) != UINT64_MAX;
+}
+
+static bool rr_crucible_sim_boundary_deadline_due(void)
+{
+    uint64_t deadline = qemu_crucible_fault_next_boundary_deadline(
+        CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY);
+    int64_t now = icount_get_observed();
+
+    return deadline != UINT64_MAX && deadline <= INT64_MAX && now >= 0 &&
+           deadline <= (uint64_t)now;
+}
+
+static int64_t rr_crucible_sim_clamp_boundary_deadline(int64_t budget)
+{
+    uint64_t deadline;
+    uint64_t remaining;
+    int64_t now;
+
+    if (budget <= 0) {
+        return budget;
+    }
+    deadline = qemu_crucible_fault_next_boundary_deadline(
+        CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY);
+    if (deadline == UINT64_MAX || deadline > INT64_MAX) {
+        return budget;
+    }
+    now = icount_get_observed();
+    if (now < 0) {
+        error_report("Crucible virtual deadline observed negative time");
+        abort();
+    }
+    if (deadline <= (uint64_t)now) {
+        return 0;
+    }
+    remaining = deadline - (uint64_t)now;
+    return remaining < (uint64_t)budget ? (int64_t)remaining : budget;
+}
+
+static bool rr_crucible_sim_advance_stalled_deadline(void)
+{
+    uint64_t deadline;
+    int64_t now;
+
+    if (!rr_crucible_sim_mode() ||
+        rr_crucible_sim_service_available()) {
+        return false;
+    }
+    deadline = qemu_crucible_fault_next_boundary_deadline(
+        CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY);
+    if (deadline == UINT64_MAX || deadline > INT64_MAX) {
+        return false;
+    }
+    now = icount_get_observed();
+    if (now < 0 || deadline < (uint64_t)now) {
+        error_report("Crucible stalled-node deadline regressed");
+        abort();
+    }
+    if (deadline != (uint64_t)now) {
+        icount_advance_virtual_time_to_ns(deadline);
+    }
+    qemu_crucible_fault_dispatch_boundary(
+        CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY, qemu_plugin_icount_raw());
+    return true;
+}
+
 static void rr_crucible_sim_reset_exit_request(CPUState *cpu)
 {
     if (!cpu) {
@@ -237,7 +319,8 @@ static bool rr_crucible_sim_run_tcg_batch(CPUState **cpu_ptr,
             (crucible_sim_shmem_dispatch_registered() ||
              crucible_sim_observer_registered() ||
              qemu_crucible_fault_next_icount(
-                 CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY) != UINT64_MAX)) {
+                 CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY) != UINT64_MAX ||
+             rr_crucible_sim_boundary_deadline_active())) {
