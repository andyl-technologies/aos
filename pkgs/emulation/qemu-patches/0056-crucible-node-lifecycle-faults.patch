+    uint64_t entered_icount;
+    uint64_t entered_virtual_ns;
+    uint64_t watchdog_deadline_ns;
+    bool watchdog_enabled;
+    bool watchdog_fired;
+} CrucibleHangState;
+
+typedef struct CrucibleHangApply {
+    bool node_hung;
+    GArray *vcpu_hung;
+} CrucibleHangApply;
