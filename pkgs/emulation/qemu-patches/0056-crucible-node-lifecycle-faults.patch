                     CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY, current_icount);
@@ -313,9 +398,10 @@ static bool rr_crucible_sim_run_tcg_batch(CPUState **cpu_ptr,
             r != EXCP_HALTED && cpu_can_run(cpu));
 
