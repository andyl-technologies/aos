     int load_section_id;
     const SaveVMHandlers *ops;
     const VMStateDescription *vmsd;
+    VMStateIf *obj;
     void *opaque;
     CompatEntry *compat;
     int is_ram;
 } SaveStateEntry;
 
+static uint32_t crucible_lifecycle_state_domain(const SaveStateEntry *se)
+{
+    const char *name = se->vmsd ? se->vmsd->name : se->idstr;
+    Object *object;
+    DeviceState *device;
+
+    if (!se->obj) {
+        if (strcmp(name, "globalstate") == 0 ||
+            strcmp(name, "replay") == 0 ||
+            strcmp(name, "crucible-shmem") == 0) {
+            return QEMU_CRUCIBLE_LIFECYCLE_STATE_CONTROL;
+        }
+        if (strcmp(name, "cpu") == 0 ||
+            g_str_has_prefix(name, "cpu/") ||
+            strcmp(name, "cpu_common") == 0 ||
+            g_str_has_prefix(name, "cpu_common/") ||
+            strcmp(name, "timer") == 0 ||
+            g_str_has_prefix(name, "timer/") ||
+            strcmp(name, "arm_timer") == 0 ||
+            strcmp(name, "apic") == 0 ||
+            g_str_has_prefix(name, "apic/")) {
+            return QEMU_CRUCIBLE_LIFECYCLE_STATE_VOLATILE;
+        }
+        return QEMU_CRUCIBLE_LIFECYCLE_STATE_DEVICE;
+    }
+    object = OBJECT(se->obj);
+    if (object_dynamic_cast(object, TYPE_CPU)) {
+        return QEMU_CRUCIBLE_LIFECYCLE_STATE_VOLATILE;
+    }
+    device = object_dynamic_cast(object, TYPE_DEVICE) ? DEVICE(object) : NULL;
+    if (device && DEVICE_GET_CLASS(device)->crucible_volatile_state) {
+        return QEMU_CRUCIBLE_LIFECYCLE_STATE_VOLATILE;
+    }
+    return QEMU_CRUCIBLE_LIFECYCLE_STATE_DEVICE;
+}
