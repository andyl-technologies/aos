+QemuCrucibleFaultEventReservation *
+qemu_crucible_fault_event_reservation_split(
+    QemuCrucibleFaultEventReservation *reservation, size_t count)
+{
+    QemuCrucibleFaultEventReservation *split;
+
+    if (!reservation || count == 0 || count > reservation->remaining) {
+        error_report("Invalid Crucible fault-event reservation split");
+        abort();
+    }
+    split = g_new0(QemuCrucibleFaultEventReservation, 1);
+    split->remaining = count;
+    reservation->remaining -= count;
+    return split;
+}
