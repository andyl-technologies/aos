From 23d9630233d07787bdd70518edafb3344a91b068 Mon Sep 17 00:00:00 2001
From: Dylan Plecki <dylan@andyl.com>
Date: Mon, 1 Jan 2001 00:00:01 +0000
Subject: [PATCH] crucible: register hot-fork child runtime

Signed-off-by: Dylan Plecki <dylan@andyl.com>
---
 include/qemu/crucible-hot-fork-plugin.h |  12 ++
 include/qemu/qemu-plugin.h              |  81 ++++++++++
 plugins/api-system.c                    | 206 ++++++++++++++++++++++++
 3 files changed, 299 insertions(+)

diff --git a/include/qemu/crucible-hot-fork-plugin.h b/include/qemu/crucible-hot-fork-plugin.h
index eab07ca71..23e59df1a 100644
--- a/include/qemu/crucible-hot-fork-plugin.h
+++ b/include/qemu/crucible-hot-fork-plugin.h
@@ -26,6 +26,14 @@ typedef struct QemuPluginCrucibleHotForkBarrierInventory {
     bool manifest_consistent;
 } QemuPluginCrucibleHotForkBarrierInventory;
 
+typedef struct QemuPluginCrucibleHotForkChildRuntimeInventory {
+    struct qemu_plugin_crucible_hot_fork_child_status status;
+    uint64_t generation;
+    uint64_t plugin_id;
+    bool registered;
+    bool manifest_consistent;
+} QemuPluginCrucibleHotForkChildRuntimeInventory;
+
 void qemu_plugin_crucible_callback_registered(qemu_plugin_id_t plugin_id,
                                               uint64_t callback_mask);
 void qemu_plugin_crucible_hot_fork_inventory(
@@ -33,5 +41,9 @@ void qemu_plugin_crucible_hot_fork_inventory(
 int qemu_plugin_crucible_hot_fork_barrier(
     uint32_t action,
     QemuPluginCrucibleHotForkBarrierInventory *inventory);
+int qemu_plugin_crucible_hot_fork_child_runtime(
+    uint32_t action,
+    const struct qemu_plugin_crucible_hot_fork_child_plan *plan,
+    QemuPluginCrucibleHotForkChildRuntimeInventory *inventory);
 
 #endif
diff --git a/include/qemu/qemu-plugin.h b/include/qemu/qemu-plugin.h
index d5ab3e88a..83c2bb534 100644
--- a/include/qemu/qemu-plugin.h
+++ b/include/qemu/qemu-plugin.h
@@ -1283,6 +1283,87 @@ int qemu_plugin_crucible_register_hot_fork_barrier(
     qemu_plugin_crucible_hot_fork_barrier_cb_t cb,
     void *userdata);
 
+#define QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PLAN_VERSION 1
+#define QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_STATUS_VERSION 1
+#define QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_INITIALIZE 1
+#define QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_QUERY 2
+#define QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_RELEASE 3
+#define QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PHASE_TEMPLATE 0
+#define QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PHASE_INITIALIZING 1
+#define QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PHASE_WORKERS_HELD 2
+#define QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PHASE_ACTIVE 3
+#define QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PHASE_FAILED 4
+#define QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_CALLBACKS_HELD (1U << 0)
+#define QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_MAPPING_INSTALLED (1U << 1)
+#define QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_WORKERS_READY (1U << 2)
+#define QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_ACTIVE (1U << 3)
+#define QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_FAILED (1U << 4)
+#define QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_ALL \
+    ((1U << 5) - 1)
+
+struct qemu_plugin_crucible_hot_fork_child_plan {
+    uint32_t schema_version;
+    uint32_t struct_size;
+    uint32_t flags;
+    uint32_t reserved;
+    uint64_t template_generation;
+    uint64_t private_ring_generation;
+    uint64_t plugin_endpoint_generation;
+    uint64_t plugin_barrier_generation;
+    uint64_t worker_mask;
+    uint64_t control_socket_cookie;
+    uint64_t wake_eventfd_id;
+    uint64_t shmem_device;
+    uint64_t shmem_inode;
+    uint64_t shmem_length;
+    int32_t private_ring_fd;
+    int32_t control_fd;
+    int32_t wake_fd;
+    int32_t reserved_fd;
+};
+
+struct qemu_plugin_crucible_hot_fork_child_status {
+    uint32_t schema_version;
+    uint32_t struct_size;
+    uint32_t flags;
+    uint32_t phase;
+    uint64_t template_generation;
+    uint64_t private_ring_generation;
+    uint64_t plugin_endpoint_generation;
+    uint64_t plugin_barrier_generation;
+    uint64_t control_socket_cookie;
+    uint64_t wake_eventfd_id;
+    uint64_t worker_mask;
+    uint64_t parked_worker_mask;
+    uint64_t pending_worker_mask;
+    uint64_t worker_operations_in_flight;
+};
+
+typedef int (*qemu_plugin_crucible_hot_fork_child_runtime_cb_t)(
+    uint32_t action,
+    const struct qemu_plugin_crucible_hot_fork_child_plan *plan,
+    struct qemu_plugin_crucible_hot_fork_child_status *status,
+    void *userdata);
+
+/**
+ * qemu_plugin_crucible_register_hot_fork_child_runtime() - register rebuild
+ * @plugin_id: nonzero identity of the registering Crucible plugin
+ * @cb: process-lifetime child mapping and worker reconstruction operation
+ * @userdata: stable opaque pointer passed to @cb
+ *
+ * The callback is registered during ordinary plugin setup but remains inert
+ * until a future hot-fork child transaction supplies an authenticated private
+ * mapping and replacement endpoint plan. Registration alone does not assert
+ * that a child was forked, reconstructed, or ready to execute.
+ *
+ * Returns zero on success or a negative errno-style status on failure.
+ */
+QEMU_PLUGIN_API
+int qemu_plugin_crucible_register_hot_fork_child_runtime(
+    qemu_plugin_id_t plugin_id,
+    qemu_plugin_crucible_hot_fork_child_runtime_cb_t cb,
+    void *userdata);
+
 /**
  * qemu_plugin_request_shutdown() - request plugin-owned QEMU teardown
  * @failure: nonzero selects a fail-loud host-error exit
diff --git a/plugins/api-system.c b/plugins/api-system.c
index 3114d8306..88f3715cf 100644
--- a/plugins/api-system.c
+++ b/plugins/api-system.c
@@ -127,6 +127,11 @@ static QemuPluginCrucibleHotForkBarrierInventory
 static qemu_plugin_crucible_hot_fork_barrier_cb_t
     qemu_plugin_crucible_barrier_cb;
 static void *qemu_plugin_crucible_barrier_userdata;
+static QemuPluginCrucibleHotForkChildRuntimeInventory
+    qemu_plugin_crucible_child_runtime_inventory;
+static qemu_plugin_crucible_hot_fork_child_runtime_cb_t
+    qemu_plugin_crucible_child_runtime_cb;
+static void *qemu_plugin_crucible_child_runtime_userdata;
 static qemu_plugin_id_t qemu_plugin_crucible_observed_plugin_id;
 static bool qemu_plugin_crucible_callback_plugin_conflict;
 
@@ -161,6 +166,31 @@ int qemu_plugin_crucible_register_hot_fork_barrier(
     return 0;
 }
 
+int qemu_plugin_crucible_register_hot_fork_child_runtime(
+    qemu_plugin_id_t plugin_id,
+    qemu_plugin_crucible_hot_fork_child_runtime_cb_t cb,
+    void *userdata)
+{
+    QEMU_LOCK_GUARD(&qemu_plugin_crucible_resource_lock);
+
+    if (plugin_id == 0 || !cb || !userdata) {
+        return -EINVAL;
+    }
+    if (qemu_plugin_crucible_child_runtime_inventory.registered) {
+        return qemu_plugin_crucible_child_runtime_inventory.plugin_id ==
+                   plugin_id &&
+               qemu_plugin_crucible_child_runtime_cb == cb &&
+               qemu_plugin_crucible_child_runtime_userdata == userdata ? 0 :
+               -EALREADY;
+    }
+    qemu_plugin_crucible_child_runtime_inventory.plugin_id = plugin_id;
+    qemu_plugin_crucible_child_runtime_inventory.registered = true;
+    qemu_plugin_crucible_child_runtime_inventory.generation++;
+    qemu_plugin_crucible_child_runtime_cb = cb;
+    qemu_plugin_crucible_child_runtime_userdata = userdata;
+    return 0;
+}
+
 void qemu_plugin_crucible_callback_registered(qemu_plugin_id_t plugin_id,
                                               uint64_t callback_mask)
 {
@@ -404,6 +434,182 @@ int qemu_plugin_crucible_hot_fork_barrier(
     qemu_mutex_unlock(&qemu_plugin_crucible_barrier_operation_lock);
     return 0;
 }
+
+int qemu_plugin_crucible_hot_fork_child_runtime(
+    uint32_t action,
+    const struct qemu_plugin_crucible_hot_fork_child_plan *plan,
+    QemuPluginCrucibleHotForkChildRuntimeInventory *inventory)
+{
+    struct qemu_plugin_crucible_hot_fork_child_status status = { 0 };
+    qemu_plugin_crucible_hot_fork_child_runtime_cb_t cb;
+    void *userdata;
+    struct qemu_plugin_crucible_hot_fork_child_status previous_status;
+    uint64_t previous_generation;
+    int result;
+
+    if (!inventory ||
+        (action != QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_INITIALIZE &&
+         action != QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_QUERY &&
+         action != QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_RELEASE) ||
+        (action == QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_INITIALIZE &&
+         (!plan ||
+          plan->schema_version !=
+              QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PLAN_VERSION ||
+          plan->struct_size != sizeof(*plan) || plan->flags != 0 ||
+          plan->reserved != 0 || plan->reserved_fd != -1 ||
+          plan->template_generation == 0 ||
+          plan->private_ring_generation == 0 ||
+          plan->plugin_endpoint_generation == 0 ||
+          plan->plugin_barrier_generation == 0 ||
+          plan->control_socket_cookie == 0 ||
+          plan->wake_eventfd_id == 0 ||
+          plan->private_ring_fd < 0 || plan->control_fd < 0 ||
+          plan->wake_fd < 0 || plan->control_fd == plan->wake_fd ||
+          plan->private_ring_fd == plan->control_fd ||
+          plan->private_ring_fd == plan->wake_fd ||
+          plan->shmem_inode == 0 || plan->shmem_length == 0))) {
+        return -EINVAL;
+    }
+
+    qemu_mutex_lock(&qemu_plugin_crucible_barrier_operation_lock);
+    qemu_mutex_lock(&qemu_plugin_crucible_resource_lock);
+    if (!qemu_plugin_crucible_child_runtime_inventory.registered) {
+        *inventory = qemu_plugin_crucible_child_runtime_inventory;
+        qemu_mutex_unlock(&qemu_plugin_crucible_resource_lock);
+        qemu_mutex_unlock(&qemu_plugin_crucible_barrier_operation_lock);
+        return action == QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_QUERY ? 0 :
+               -ENODEV;
+    }
+    if (!qemu_plugin_crucible_resource_inventory.registered ||
+        !qemu_plugin_crucible_resource_inventory.complete ||
+        qemu_plugin_crucible_resource_inventory.manifest.plugin_id !=
+            qemu_plugin_crucible_child_runtime_inventory.plugin_id ||
+        (action == QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_INITIALIZE &&
+         (plan->worker_mask !=
+              qemu_plugin_crucible_resource_inventory.manifest.worker_mask ||
+          plan->control_fd !=
+              qemu_plugin_crucible_resource_inventory.manifest.control_fd ||
+          plan->wake_fd !=
+              qemu_plugin_crucible_resource_inventory.manifest.wake_fd ||
+          (plan->shmem_device ==
+               qemu_plugin_crucible_resource_inventory.manifest.shmem_device &&
+           plan->shmem_inode ==
+               qemu_plugin_crucible_resource_inventory.manifest.
+                   shmem_inode)))) {
+        qemu_mutex_unlock(&qemu_plugin_crucible_resource_lock);
+        qemu_mutex_unlock(&qemu_plugin_crucible_barrier_operation_lock);
+        return -EPROTO;
+    }
+    cb = qemu_plugin_crucible_child_runtime_cb;
+    userdata = qemu_plugin_crucible_child_runtime_userdata;
+    previous_status =
+        qemu_plugin_crucible_child_runtime_inventory.status;
+    qemu_mutex_unlock(&qemu_plugin_crucible_resource_lock);
+
+    result = cb(action, plan, &status, userdata);
+    if (result != 0) {
+        qemu_mutex_unlock(&qemu_plugin_crucible_barrier_operation_lock);
+        return result;
+    }
+    if (status.schema_version !=
+            QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_STATUS_VERSION ||
+        status.struct_size != sizeof(status) ||
+        (status.flags &
+         ~QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_ALL) != 0 ||
+        status.phase > QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PHASE_FAILED ||
+        (status.worker_mask & ~QEMU_PLUGIN_CRUCIBLE_WORKER_ALL) != 0 ||
+        (status.worker_mask & QEMU_PLUGIN_CRUCIBLE_WORKER_REQUIRED) !=
+            QEMU_PLUGIN_CRUCIBLE_WORKER_REQUIRED ||
+        (status.parked_worker_mask & ~status.worker_mask) != 0 ||
+        (status.pending_worker_mask & ~status.parked_worker_mask) != 0 ||
+        ctpop64(status.parked_worker_mask) +
+            status.worker_operations_in_flight > ctpop64(status.worker_mask) ||
+        (((status.flags &
+         QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_ACTIVE) != 0) !=
+         (status.phase ==
+          QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PHASE_ACTIVE)) ||
+        (((status.flags &
+         QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_FAILED) != 0) !=
+         (status.phase ==
+          QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PHASE_FAILED)) ||
+        (status.phase == QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PHASE_TEMPLATE &&
+         (status.template_generation != 0 ||
+          status.private_ring_generation != 0 ||
+          status.plugin_endpoint_generation != 0 ||
+          status.plugin_barrier_generation != 0 ||
+          status.control_socket_cookie != 0 ||
+          status.wake_eventfd_id != 0)) ||
+        (status.phase >=
+             QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PHASE_WORKERS_HELD &&
+         (status.template_generation == 0 ||
+          status.private_ring_generation == 0 ||
+          status.plugin_endpoint_generation == 0 ||
+          status.plugin_barrier_generation == 0 ||
+          status.control_socket_cookie == 0 ||
+          status.wake_eventfd_id == 0)) ||
+        (status.phase ==
+             QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PHASE_WORKERS_HELD &&
+         ((status.flags &
+           (QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_CALLBACKS_HELD |
+            QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_MAPPING_INSTALLED |
+            QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_WORKERS_READY)) !=
+          (QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_CALLBACKS_HELD |
+           QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_MAPPING_INSTALLED |
+           QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_WORKERS_READY))) ||
+        (status.phase == QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PHASE_ACTIVE &&
+         ((status.flags &
+           (QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_CALLBACKS_HELD |
+            QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_WORKERS_READY)) != 0 ||
+          (status.flags &
+           QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_MAPPING_INSTALLED) ==
+              0)) ||
+        (action == QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_INITIALIZE &&
+         ((status.flags &
+           QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_CALLBACKS_HELD) == 0 ||
+          (status.flags &
+           QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_MAPPING_INSTALLED) == 0 ||
+          status.template_generation != plan->template_generation ||
+          status.private_ring_generation != plan->private_ring_generation ||
+          status.plugin_endpoint_generation !=
+              plan->plugin_endpoint_generation ||
+          status.plugin_barrier_generation !=
+              plan->plugin_barrier_generation ||
+          status.control_socket_cookie != plan->control_socket_cookie ||
+          status.wake_eventfd_id != plan->wake_eventfd_id)) ||
+        (action != QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_INITIALIZE &&
+         previous_status.phase !=
+             QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PHASE_TEMPLATE &&
+         (status.template_generation !=
+              previous_status.template_generation ||
+          status.private_ring_generation !=
+              previous_status.private_ring_generation ||
+          status.plugin_endpoint_generation !=
+              previous_status.plugin_endpoint_generation ||
+          status.plugin_barrier_generation !=
+              previous_status.plugin_barrier_generation ||
+          status.control_socket_cookie !=
+              previous_status.control_socket_cookie ||
+          status.wake_eventfd_id != previous_status.wake_eventfd_id)) ||
+        (action == QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_RELEASE &&
+         (status.flags & QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_ACTIVE) ==
+             0)) {
+        qemu_mutex_unlock(&qemu_plugin_crucible_barrier_operation_lock);
+        return -EPROTO;
+    }
+
+    qemu_mutex_lock(&qemu_plugin_crucible_resource_lock);
+    previous_generation =
+        qemu_plugin_crucible_child_runtime_inventory.generation;
+    qemu_plugin_crucible_child_runtime_inventory.status = status;
+    qemu_plugin_crucible_child_runtime_inventory.manifest_consistent = true;
+    qemu_plugin_crucible_child_runtime_inventory.generation =
+        previous_generation + 1;
+    *inventory = qemu_plugin_crucible_child_runtime_inventory;
+    qemu_mutex_unlock(&qemu_plugin_crucible_resource_lock);
+    qemu_mutex_unlock(&qemu_plugin_crucible_barrier_operation_lock);
+    return 0;
+}
+
 static NotifierList qemu_plugin_wake_notifiers =
     NOTIFIER_LIST_INITIALIZER(qemu_plugin_wake_notifiers);
 qemu_plugin_tcg_exec_cb_t qemu_plugin_tcg_exec_cb;
