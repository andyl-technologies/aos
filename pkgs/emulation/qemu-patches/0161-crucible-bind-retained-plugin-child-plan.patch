+{
+    return reinitializer && reinitializer->prepared &&
+        !reinitializer->attempted && !reinitializer->initialized &&
+        qemu_crucible_hot_fork_plugin_child_plan_valid(plan) &&
+        crucible_hot_fork_plugin_child_plans_equal(&reinitializer->plan, plan);
