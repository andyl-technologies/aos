+static bool crucible_hot_fork_plugin_child_plans_equal(
+    const struct qemu_plugin_crucible_hot_fork_child_plan *left,
+    const struct qemu_plugin_crucible_hot_fork_child_plan *right)
+{
+    return left->schema_version == right->schema_version &&
+        left->struct_size == right->struct_size &&
+        left->flags == right->flags && left->reserved == right->reserved &&
+        left->parent_process_generation ==
+            right->parent_process_generation &&
+        left->child_process_generation == right->child_process_generation &&
+        left->template_generation == right->template_generation &&
+        left->private_ring_generation == right->private_ring_generation &&
+        left->plugin_endpoint_generation ==
+            right->plugin_endpoint_generation &&
+        left->plugin_barrier_generation ==
+            right->plugin_barrier_generation &&
+        left->worker_mask == right->worker_mask &&
+        left->control_socket_cookie == right->control_socket_cookie &&
+        left->wake_eventfd_id == right->wake_eventfd_id &&
+        left->shmem_device == right->shmem_device &&
+        left->shmem_inode == right->shmem_inode &&
+        left->shmem_length == right->shmem_length &&
+        left->source_mapping_start == right->source_mapping_start &&
+        left->source_mapping_length == right->source_mapping_length &&
+        left->source_mapping_offset == right->source_mapping_offset &&
+        left->private_ring_fd == right->private_ring_fd &&
+        left->control_fd == right->control_fd &&
+        left->wake_fd == right->wake_fd &&
+        left->reserved_fd == right->reserved_fd;
+}
