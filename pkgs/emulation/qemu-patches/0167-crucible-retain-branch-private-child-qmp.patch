+    report->resource_plan_bound = crucible_hot_fork_qmp_resource_plan_bound();
+    report->nonblocking_unix_stream = report->staged;
+    report->reinitialized = false;
+    report->disposition_complete = false;
+    report->readiness_proof_acknowledged = false;
+    return report;
