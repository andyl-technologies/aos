+CrucibleHotForkQmpState *qmp_crucible_hot_fork_child_qmp(
+    CrucibleHotForkQmpAction action, const char *fdname,
+    bool has_expected_socket_cookie, uint64_t expected_socket_cookie,
+    Error **errp)
+{
+    CrucibleHotForkQmpState *report = NULL;
+    CrucibleHotForkPluginBarrierState *plugin_barrier = NULL;
+    uint64_t observed_socket_cookie = 0;
+    uint64_t next_generation;
+    int candidate = -1;
+    int result;
+
+    g_mutex_lock(&crucible_hot_fork_template_lock);
+    switch (action) {
+    case CRUCIBLE_HOT_FORK_QMP_ACTION_STAGE:
+        if (!fdname || !has_expected_socket_cookie ||
+            expected_socket_cookie == 0 ||
+            !crucible_hot_fork_private_ring_fd_name_valid(fdname)) {
+            error_setg(errp, "Crucible hot-fork child QMP requires one "
+                       "exact bounded descriptor identity");
+            goto out;
+        }
+        if (!crucible_hot_fork_template_active) {
+            error_setg(errp, "Crucible hot-fork child QMP requires an active "
+                       "retained template");
+            goto out;
+        }
+        if (!crucible_hot_fork_private_ring_stage.staged ||
+            crucible_hot_fork_private_ring_stage.template_generation !=
+                crucible_hot_fork_template_generation ||
+            !crucible_hot_fork_diagnostic_stage.staged ||
+            crucible_hot_fork_diagnostic_stage.template_generation !=
+                crucible_hot_fork_template_generation) {
+            error_setg(errp, "Crucible hot-fork child QMP requires private "
+                       "rings and diagnostics from the same template");
+            goto out;
+        }
+        if (!crucible_hot_fork_resource_stage_allowed(
+                &plugin_barrier, errp)) {
+            goto out;
+        }
+        candidate = monitor_dup_fd(monitor_cur(), fdname, errp);
+        if (candidate < 0) {
+            goto out;
+        }
+        if (!crucible_hot_fork_nonblocking_socket_cookie(
+                candidate, &observed_socket_cookie, errp)) {
+            goto out;
+        }
+        if (observed_socket_cookie != expected_socket_cookie) {
+            error_setg(errp, "Crucible hot-fork child QMP identity mismatch");
+            goto out;
+        }
+        if (expected_socket_cookie ==
+                crucible_hot_fork_diagnostic_stage.socket_cookie) {
+            error_setg(errp, "Crucible hot-fork child QMP aliases the "
+                       "diagnostics stream");
+            goto out;
+        }
+        if (candidate == QEMU_CRUCIBLE_HOT_FORK_DIAGNOSTIC_TARGET_FD ||
+            candidate == crucible_hot_fork_diagnostic_stage.fd ||
+            candidate == crucible_hot_fork_private_ring_stage.fd) {
+            error_setg(errp, "Crucible hot-fork child QMP aliases another "
+                       "retained resource");
+            goto out;
+        }
+        if (crucible_hot_fork_qmp_stage.staged) {
+            if (!crucible_hot_fork_qmp_stage_matches(
+                    fdname, expected_socket_cookie) ||
+                crucible_hot_fork_qmp_stage.template_generation !=
+                    crucible_hot_fork_template_generation) {
+                error_setg(errp, "Different Crucible hot-fork child QMP "
+                           "endpoint is already staged");
+                goto out;
+            }
+            report = crucible_hot_fork_qmp_report();
+            goto out;
+        }
+        if (crucible_hot_fork_plugin_endpoint_stage.staged) {
+            error_setg(errp, "Crucible hot-fork child QMP must be staged "
+                       "before plugin endpoints seal the child plan");
+            goto out;
+        }
+        if (crucible_hot_fork_qmp_stage.generation == UINT64_MAX) {
+            error_setg(errp, "Crucible hot-fork child QMP generation is "
+                       "exhausted");
+            goto out;
+        }
+        result = qemu_crucible_hot_fork_prepare_qmp_child_resources(
+            &crucible_hot_fork_qmp_child_resources, candidate,
+            expected_socket_cookie);
+        if (result != 0) {
+            error_setg_errno(errp, -result,
+                             "Could not prepare Crucible hot-fork child QMP "
+                             "resources");
+            goto out;
+        }
+        next_generation = crucible_hot_fork_qmp_stage.generation + 1;
+        crucible_hot_fork_qmp_stage.staged = true;
+        crucible_hot_fork_qmp_stage.fd = candidate;
+        candidate = -1;
+        crucible_hot_fork_qmp_stage.fdname = g_strdup(fdname);
+        crucible_hot_fork_qmp_stage.socket_cookie = expected_socket_cookie;
+        crucible_hot_fork_qmp_stage.template_generation =
+            crucible_hot_fork_template_generation;
+        crucible_hot_fork_qmp_stage.generation = next_generation;
+        report = crucible_hot_fork_qmp_report();
+        break;
+    case CRUCIBLE_HOT_FORK_QMP_ACTION_QUERY:
+        if (fdname || has_expected_socket_cookie) {
+            error_setg(errp, "Crucible hot-fork child QMP query accepts no "
+                       "descriptor identity");
+            goto out;
+        }
+        report = crucible_hot_fork_qmp_report();
+        break;
+    case CRUCIBLE_HOT_FORK_QMP_ACTION_RELEASE:
+        if (!fdname || !has_expected_socket_cookie ||
+            !crucible_hot_fork_qmp_stage_matches(
+                fdname, expected_socket_cookie)) {
+            error_setg(errp, "Crucible hot-fork child QMP release requires "
+                       "the exact retained basis");
+            goto out;
+        }
+        if (crucible_hot_fork_template_active) {
+            error_setg(errp, "Cannot release Crucible hot-fork child QMP "
+                       "during template preparation");
+            goto out;
+        }
+        if (crucible_hot_fork_plugin_endpoint_stage.staged) {
+            error_setg(errp, "Cannot release Crucible hot-fork child QMP "
+                       "before plugin endpoints release the sealed plan");
+            goto out;
+        }
+        close(crucible_hot_fork_qmp_stage.fd);
+        crucible_hot_fork_qmp_stage.fd = -1;
+        g_clear_pointer(&crucible_hot_fork_qmp_stage.fdname, g_free);
+        crucible_hot_fork_qmp_stage.staged = false;
+        crucible_hot_fork_qmp_stage.socket_cookie = 0;
+        crucible_hot_fork_qmp_stage.template_generation = 0;
+        qemu_crucible_hot_fork_reset_qmp_child_resources(
+            &crucible_hot_fork_qmp_child_resources);
+        crucible_hot_fork_qmp_stage.generation++;
+        assert(crucible_hot_fork_qmp_stage.generation != 0);
+        report = crucible_hot_fork_qmp_report();
+        break;
+    default:
+        g_assert_not_reached();
+    }
+out:
+    g_free(plugin_barrier);
+    if (candidate >= 0) {
+        close(candidate);
+    }
+    g_mutex_unlock(&crucible_hot_fork_template_lock);
+    return report;
+}
