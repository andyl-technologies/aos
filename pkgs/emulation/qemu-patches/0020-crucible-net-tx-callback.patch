 QEMU_PLUGIN_API
 int qemu_plugin_net_inject(const uint8_t *data, size_t len);
 
+/**
+ * typedef qemu_plugin_net_tx_cb_t - shmem network TX callback
+ * @data: Ethernet frame bytes emitted by the guest
+ * @len: byte length of @data
+ * @userdata: a pointer supplied when the callback was registered
+ *
+ * Called synchronously from QEMU's network transmit path before the frame is
+ * handed to the upstream backend. Returns 0 when the plugin accepted the frame
+ * for deterministic routing and nonzero on fail-loud rejection.
+ */
+typedef int (*qemu_plugin_net_tx_cb_t)(const uint8_t *data,
+                                       size_t len,
+                                       void *userdata);
+
+/**
+ * qemu_plugin_register_net_tx_cb() - register shmem network TX interception
+ * @tx_cb: transmit callback, or NULL to use the upstream backend
+ * @userdata: opaque pointer passed to @tx_cb
+ *
+ * With no callback registered, QEMU uses its upstream network backend. Once a
+ * callback is registered, guest-emitted Ethernet frames are delivered to the
+ * callback instead of the backend.
+ */
+QEMU_PLUGIN_API
+void qemu_plugin_register_net_tx_cb(qemu_plugin_net_tx_cb_t tx_cb,
+                                    void *userdata);
+
 typedef void
 (*qemu_plugin_vcpu_syscall_cb_t)(qemu_plugin_id_t id, unsigned int vcpu_index,
