+static qemu_plugin_net_tx_cb_t crucible_net_tx_cb;
+static void *crucible_net_tx_userdata;
+
+void qemu_plugin_register_net_tx_cb(qemu_plugin_net_tx_cb_t tx_cb,
+                                    void *userdata)
+{
+    crucible_net_tx_userdata = userdata;
+    crucible_net_tx_cb = tx_cb;
+}
+
+static bool crucible_net_tx_callback_ready(NetClientState *sender)
+{
+    return crucible_net_tx_cb != NULL &&
+           sender != NULL &&
+           sender->info != NULL &&
+           sender->info->type == NET_CLIENT_DRIVER_NIC;
+}
+
+static ssize_t crucible_net_tx_submit(const uint8_t *data, size_t len)
+{
+    if (data == NULL || len == 0 || len > SSIZE_MAX) {
+        return -1;
+    }
+    if (crucible_net_tx_cb(data, len, crucible_net_tx_userdata) != 0) {
+        return -1;
+    }
+
+    return (ssize_t)len;
+}
 
