+static void rng_builtin_drain_requests(RngBackend *b)
+{
+    while (!QSIMPLEQ_EMPTY(&b->requests)) {
+        RngRequest *req = QSIMPLEQ_FIRST(&b->requests);
+
+        /*
+         * Generate every virtio-rng request independently from the run seed.
+         * qemu_guest_getrandom() is thread-local, so sharing it with CPU and
+         * firmware consumers makes the observed bytes depend on which QEMU
+         * thread serviced earlier requests even when completion icount is
+         * exact.  Advancing even a dedicated device stream would also make
+         * the observed bytes depend on host-sensitive kernel entropy consumers
+         * that may submit earlier requests.  The sim-only synchronous path
+         * therefore makes the response a pure function of the run seed and
+         * request length, independent of request ordinal and servicing thread.
+         */
+        qemu_guest_getrandom_sim_rng_nofail(req->data, req->size);
+        req->receive_entropy(req->opaque, req->data, req->size);
+        rng_backend_finalize_request(b, req);
+    }
+}
+
 static void rng_builtin_request_entropy(RngBackend *b, RngRequest *req)
 {
     RngBuiltin *s = RNG_BUILTIN(b);
