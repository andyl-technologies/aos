diff --git a/backends/rng-builtin.c b/backends/rng-builtin.c
--- a/backends/rng-builtin.c
+++ b/backends/rng-builtin.c
@@ -34,10 +34,26 @@ static void rng_builtin_receive_entropy_bh(void *opaque)
     }
 }
 
+static void rng_builtin_drain_requests(RngBackend *b)
+{
+    rng_builtin_receive_entropy_bh(RNG_BUILTIN(b));
+}
+
 static void rng_builtin_request_entropy(RngBackend *b, RngRequest *req)
 {
     RngBuiltin *s = RNG_BUILTIN(b);
 
+    /*
+     * The builtin backend draws from the deterministically seeded guest-random
+     * stream, which is available synchronously.  Under the Crucible sim
+     * accelerator's deterministic icount, the generic backend layer
+     * (rng_backend_request_entropy) drains the queued request inline on the
+     * requesting vCPU thread via ->drain_requests so the completion interrupt
+     * lands at the exact request icount; the bottom half scheduled here then
+     * runs against an already-empty queue and is a no-op.  Outside the sim
+     * accelerator, behaviour is unchanged: the bottom half services the request
+     * from the host main loop.
+     */
     replay_bh_schedule_event(s->bh);
 }
 
@@ -60,6 +76,7 @@ static void rng_builtin_class_init(ObjectClass *klass, void *data)
     RngBackendClass *rbc = RNG_BACKEND_CLASS(klass);
 
     rbc->request_entropy = rng_builtin_request_entropy;
+    rbc->drain_requests = rng_builtin_drain_requests;
 }
 
 static const TypeInfo rng_builtin_info = {
diff --git a/backends/rng.c b/backends/rng.c
--- a/backends/rng.c
+++ b/backends/rng.c
@@ -11,7 +11,9 @@
  */
 
 #include "qemu/osdep.h"
+#include "qemu/accel.h"
 #include "system/rng.h"
+#include "system/cpu-timers.h"
 #include "qapi/error.h"
 #include "qemu/module.h"
 #include "qom/object_interfaces.h"
@@ -35,6 +37,32 @@ void rng_backend_request_entropy(RngBackend *s, size_t size,
         k->request_entropy(s, req);
 
         QSIMPLEQ_INSERT_TAIL(&s->requests, req, next);
+
+        /*
+         * Crucible deterministic entropy delivery (no QEMU record/replay, per
+         * RFC-0010 NG-6).  When a backend can produce entropy synchronously and
+         * the Crucible sim accelerator is active under icount, complete the
+         * request inline on the requesting (vCPU) thread so the guest-visible
+         * completion interrupt fires at the exact request icount.  Delivering
+         * it from a host-scheduled bottom half instead makes the completion
+         * icount a function of host timing rather than of virtual time --
+         * exactly the failure RFC-0010 15-io-subnodes.md warns of ("a bottom
+         * half ... makes the completion icount a function of host timing rather
+         * than of virtual time") -- and forks the guest instruction stream
+         * across otherwise-identical deterministic runs (determinism-contract
+         * 4.6/E7 interrupt-delivery timing; S6/T-RISK-6).  This is an inherent
+         * upstream icount limitation for asynchronous device completions,
+         * sealed here by construction.  Delivery is immediate: any modeled
+         * completion latency is a property of a crucible IO sub-node and its
+         * links (15-io-subnodes.md), so it belongs there if/when virtio-rng
+         * becomes a sub-node, never in this backend.  The request was inserted
+         * above, so ->drain_requests can dequeue and finalize it.  Plain TCG
+         * icount deliberately retains upstream asynchronous delivery.
+         */
+        if (icount_enabled() && strcmp(current_accel_name(), "sim") == 0 &&
+            k->drain_requests) {
+            k->drain_requests(s);
+        }
     }
 }
 
diff --git a/include/system/rng.h b/include/system/rng.h
--- a/include/system/rng.h
+++ b/include/system/rng.h
@@ -44,6 +44,16 @@ struct RngBackendClass
 
     void (*request_entropy)(RngBackend *s, RngRequest *req);
 
+    /*
+     * Optional: synchronously service every queued request.  A backend that can
+     * produce entropy without blocking implements this so the Crucible sim
+     * accelerator's deterministic-delivery path (rng_backend_request_entropy)
+     * can complete requests inline on the requesting thread instead of from a
+     * host-scheduled bottom half.  Must dequeue and finalize each serviced
+     * request via rng_backend_finalize_request.
+     */
+    void (*drain_requests)(RngBackend *s);
+
     void (*opened)(RngBackend *s, Error **errp);
 };
 
