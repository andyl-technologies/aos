+/*
+ * Busy SMP guest for the Crucible RR invalidation regression.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+    .text
+    .global __start
+__start:
+    /* Start CPU1 through the virt machine's PSCI HVC conduit. */
+    mov x0, #3
+    movk x0, #0xc400, lsl #16
+    mov x1, #1
+    adr x2, secondary
+    mov x3, #0
+    hvc #0
+
+primary:
+    add x4, x4, #1
+    b primary
+
+secondary:
+    adrp x1, selected
+    add x1, x1, :lo12:selected
+    adrp x2, iterations
+    add x2, x2, :lo12:iterations
+    mov x3, #0
+
+target_loop:
+    mov x0, #0x40
+    .global selected_instruction
+selected_instruction:
+    add x0, x0, #0
+    str w0, [x1]
+    add x3, x3, #1
+    str w3, [x2]
+    b target_loop
+
+    .data
+    .balign 8
+    .global selected
+selected:
+    .word 0
+    .global iterations
+iterations:
+    .word 0
+
+    .section .note.GNU-stack,"",%progbits
