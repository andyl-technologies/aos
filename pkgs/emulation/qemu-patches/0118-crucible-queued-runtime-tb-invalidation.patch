diff --git a/tests/tcg/plugins/run-crucible-smp-invalidation.py b/tests/tcg/plugins/run-crucible-smp-invalidation.py
new file mode 100644
index 000000000..8bb398988
--- /dev/null
+++ b/tests/tcg/plugins/run-crucible-smp-invalidation.py
@@ -0,0 +1,77 @@
+"""Run the two-vCPU RR invalidation regression with built test artifacts."""
+
+# SPDX-License-Identifier: GPL-2.0-or-later
+
+import argparse
+from pathlib import Path
+import struct
+import subprocess
+
+
+def guest_symbols(path):
+    """Read the exported test addresses from a little-endian ELF64 guest."""
+    data = path.read_bytes()
+    if data[:6] != b"\x7fELF\x02\x01":
+        raise ValueError("the guest must be a little-endian ELF64 executable")
+
+    section_offset = struct.unpack_from("<Q", data, 40)[0]
+    section_size, section_count = struct.unpack_from("<HH", data, 58)
+    sections = [
+        struct.unpack_from("<IIQQQQIIQQ", data,
+                           section_offset + index * section_size)
+        for index in range(section_count)
+    ]
+    symbols = {}
+    for section in sections:
+        if section[1] != 2:  # SHT_SYMTAB
+            continue
+        strings = sections[section[6]]
+        names = data[strings[4]:strings[4] + strings[5]]
+        for offset in range(section[4], section[4] + section[5], section[9]):
+            name, _, _, _, value, _ = struct.unpack_from(
+                "<IBBHQQ", data, offset)
+            end = names.index(0, name)
+            symbols[names[name:end].decode()] = value
+    return symbols
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--qemu", required=True)
+    parser.add_argument("--guest", type=Path, required=True)
+    parser.add_argument("--plugin", type=Path, required=True)
+    args = parser.parse_args()
+
+    symbols = guest_symbols(args.guest)
+    plugin = (
+        f"{args.plugin},architecture=3,mode=smp-invalidation,"
+        f"pc={symbols['selected_instruction']},bytes=00000091,register=x0,"
+        f"selected-address={symbols['selected']},"
+        f"iterations-address={symbols['iterations']},"
+        "exception-address=0,result-fault-count-address=0"
+    )
+    command = [
+        args.qemu, "-machine", "virt", "-cpu", "cortex-a57", "-smp", "2",
+        "-accel", "sim", "-m", "128M", "-display", "none",
+        "-monitor", "none", "-serial", "none",
+        "-icount", "shift=0,sleep=off,rr_switch_quantum=64",
+        "-kernel", str(args.guest), "-plugin", plugin,
+    ]
+    try:
+        result = subprocess.run(command, capture_output=True, text=True,
+                                timeout=30, check=False)
+    except subprocess.TimeoutExpired as error:
+        print((error.stdout or b"").decode(), end="")
+        print((error.stderr or b"").decode(), end="")
+        raise SystemExit("the SMP invalidation regression timed out") from error
+    print(result.stdout, end="")
+    print(result.stderr, end="")
+    if result.returncode != 0 or (
+        "CRUCIBLE_INSTRUCTION_SMP_FLUSH_LIVE_PASS flushes=1"
+        not in result.stderr
+    ):
+        raise SystemExit("the SMP invalidation regression failed")
+
+
+if __name__ == "__main__":
+    main()
