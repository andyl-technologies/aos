+# This report is observational: it does not park callbacks, freeze rings,
+# acknowledge readiness proof bit 6, or authorize a fork.
+#
+# @schema-version: inventory contract version, currently 1
+#
+# @generation: process-local registration-state generation
+#
+# @registered: whether one complete manifest was sealed
+#
+# @complete: whether the manifest is registered and agrees with QEMU state
+#
+# @process-generation: nonzero host-provisioned process generation
+#
+# @plugin-id: nonzero QEMU plugin identity
+#
+# @resource-mask: closed plugin resource-class mask
+#
+# @callback-mask: callback-class mask sealed by the plugin
+#
+# @observed-callback-mask: callback classes observed by QEMU registration APIs
+#
+# @callback-mask-consistent: whether the two callback masks are equal
+#
+# @shmem-device: st_dev of the mapped shared-memory backing object
+#
+# @shmem-inode: nonzero st_ino of the mapped shared-memory backing object
+#
+# @shmem-length: positive mapped byte length
+#
+# @slot-index: plugin VM slot in the shared-memory topology
+#
+# @node-count: positive shared-memory topology node count
+#
+# @control-fd: plugin control-socket descriptor number
+#
+# @wake-fd: QEMU-registered nonblocking wake descriptor number
+#
+# @coverage: whether the manifest owns coverage resources
+#
+# @whitebox: whether the manifest owns white-box resources
+#
+# @fingerprint: whether the manifest owns fingerprint resources
+#
+# @state-dump: whether the manifest owns raw-state-dump resources
+#
+# @app-random: whether the manifest owns app-random resources
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'struct': 'CrucibleHotForkPluginResourceInventory',
+  'data': { 'schema-version': 'uint32',
+            'generation': 'uint64',
+            'registered': 'bool',
+            'complete': 'bool',
+            'process-generation': 'uint64',
+            'plugin-id': 'uint64',
+            'resource-mask': 'uint64',
+            'callback-mask': 'uint64',
