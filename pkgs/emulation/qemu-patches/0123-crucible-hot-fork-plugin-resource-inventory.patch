+static QemuMutex qemu_plugin_crucible_resource_lock;
+static QemuPluginCrucibleHotForkInventory
+    qemu_plugin_crucible_resource_inventory;
+static qemu_plugin_id_t qemu_plugin_crucible_observed_plugin_id;
+static bool qemu_plugin_crucible_callback_plugin_conflict;
+
+static void __attribute__((__constructor__))
+qemu_plugin_crucible_resource_inventory_init(void)
+{
+    qemu_mutex_init(&qemu_plugin_crucible_resource_lock);
+}
+
+void qemu_plugin_crucible_callback_registered(qemu_plugin_id_t plugin_id,
+                                              uint64_t callback_mask)
+{
+    QEMU_LOCK_GUARD(&qemu_plugin_crucible_resource_lock);
+
+    if (callback_mask == 0 ||
+        (callback_mask & ~QEMU_PLUGIN_CRUCIBLE_CALLBACK_ALL) != 0) {
+        return;
+    }
+    if (plugin_id != 0) {
+        if (qemu_plugin_crucible_observed_plugin_id == 0) {
+            qemu_plugin_crucible_observed_plugin_id = plugin_id;
+        } else if (qemu_plugin_crucible_observed_plugin_id != plugin_id) {
+            qemu_plugin_crucible_callback_plugin_conflict = true;
+        }
+    }
+    if ((qemu_plugin_crucible_resource_inventory.observed_callback_mask &
+         callback_mask) != callback_mask) {
+        qemu_plugin_crucible_resource_inventory.observed_callback_mask |=
+            callback_mask;
+        qemu_plugin_crucible_resource_inventory.generation++;
+    }
+}
+
+int qemu_plugin_crucible_register_resource_manifest(
+    const struct qemu_plugin_crucible_resource_manifest *manifest)
+{
+    uint64_t optional_callbacks;
+    uint64_t observed_callbacks;
+    QEMU_LOCK_GUARD(&qemu_plugin_crucible_resource_lock);
+
+    observed_callbacks =
+        qemu_plugin_crucible_resource_inventory.observed_callback_mask;
+
+    if (!manifest ||
+        manifest->schema_version !=
+            QEMU_PLUGIN_CRUCIBLE_RESOURCE_MANIFEST_VERSION ||
+        manifest->struct_size != sizeof(*manifest) ||
+        manifest->process_generation == 0 || manifest->plugin_id == 0 ||
+        manifest->node_count == 0 ||
+        manifest->slot_index >= manifest->node_count ||
+        manifest->control_fd < 0 || manifest->wake_fd < 0 ||
+        manifest->control_fd == manifest->wake_fd ||
+        manifest->shmem_inode == 0 || manifest->shmem_length == 0 ||
+        (manifest->resource_mask & ~QEMU_PLUGIN_CRUCIBLE_RESOURCE_ALL) != 0 ||
+        (manifest->callback_mask & ~QEMU_PLUGIN_CRUCIBLE_CALLBACK_ALL) != 0 ||
+        (manifest->resource_mask & QEMU_PLUGIN_CRUCIBLE_RESOURCE_REQUIRED) !=
+            QEMU_PLUGIN_CRUCIBLE_RESOURCE_REQUIRED ||
+        (manifest->callback_mask & QEMU_PLUGIN_CRUCIBLE_CALLBACK_REQUIRED) !=
+            QEMU_PLUGIN_CRUCIBLE_CALLBACK_REQUIRED) {
+        return -EINVAL;
+    }
+    if (qemu_plugin_crucible_resource_inventory.registered) {
+        return memcmp(&qemu_plugin_crucible_resource_inventory.manifest,
+                      manifest, sizeof(*manifest)) == 0 ? 0 : -EALREADY;
+    }
+    if (qemu_plugin_crucible_callback_plugin_conflict ||
+        qemu_plugin_crucible_observed_plugin_id != manifest->plugin_id ||
+        qemu_plugin_wake_fd != manifest->wake_fd ||
+        observed_callbacks != manifest->callback_mask) {
+        error_report("Crucible resource manifest mismatch: conflict=%d "
+                     "observed_plugin=%" PRIu64 " manifest_plugin=%" PRIu64 " "
+                     "observed_wake=%d manifest_wake=%d "
+                     "observed_callbacks=%" PRIx64
+                     " manifest_callbacks=%" PRIx64,
+                     qemu_plugin_crucible_callback_plugin_conflict,
+                     qemu_plugin_crucible_observed_plugin_id,
+                     manifest->plugin_id, qemu_plugin_wake_fd,
+                     manifest->wake_fd,
+                     observed_callbacks, manifest->callback_mask);
+        return -EPROTO;
+    }
+
+    optional_callbacks = manifest->callback_mask &
+        ~QEMU_PLUGIN_CRUCIBLE_CALLBACK_REQUIRED;
+    if (((manifest->resource_mask &
+          (QEMU_PLUGIN_CRUCIBLE_RESOURCE_COVERAGE |
+           QEMU_PLUGIN_CRUCIBLE_RESOURCE_WHITEBOX)) != 0) !=
+        ((optional_callbacks &
+          QEMU_PLUGIN_CRUCIBLE_CALLBACK_TB_TRANSLATION) != 0) ||
+        ((manifest->resource_mask & QEMU_PLUGIN_CRUCIBLE_RESOURCE_COVERAGE) !=
+         0) !=
+        ((optional_callbacks & QEMU_PLUGIN_CRUCIBLE_CALLBACK_FLUSH) != 0)) {
+        return -EPROTO;
+    }
+
+    qemu_plugin_crucible_resource_inventory.manifest = *manifest;
+    qemu_plugin_crucible_resource_inventory.registered = true;
+    qemu_plugin_crucible_resource_inventory.complete = true;
+    qemu_plugin_crucible_resource_inventory.generation++;
+    return 0;
+}
+
+void qemu_plugin_crucible_hot_fork_inventory(
+    QemuPluginCrucibleHotForkInventory *inventory)
+{
+    QEMU_LOCK_GUARD(&qemu_plugin_crucible_resource_lock);
+
+    *inventory = qemu_plugin_crucible_resource_inventory;
+    inventory->complete = inventory->registered && inventory->complete &&
+        !qemu_plugin_crucible_callback_plugin_conflict &&
+        inventory->manifest.callback_mask == inventory->observed_callback_mask;
+}
