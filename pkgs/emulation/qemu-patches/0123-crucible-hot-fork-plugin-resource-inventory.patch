+CrucibleHotForkPluginResourceInventory *
+qmp_query_crucible_hot_fork_plugin_resource_inventory(Error **errp)
+{
+    CrucibleHotForkPluginResourceInventory *report =
+        g_new0(CrucibleHotForkPluginResourceInventory, 1);
+    QemuPluginCrucibleHotForkInventory inventory;
+    const struct qemu_plugin_crucible_resource_manifest *manifest;
+
+    (void)errp;
+    qemu_plugin_crucible_hot_fork_inventory(&inventory);
+    manifest = &inventory.manifest;
+    report->schema_version =
+        QEMU_PLUGIN_CRUCIBLE_RESOURCE_MANIFEST_VERSION;
+    report->generation = inventory.generation;
+    report->registered = inventory.registered;
+    report->complete = inventory.complete;
+    report->process_generation = manifest->process_generation;
+    report->plugin_id = manifest->plugin_id;
+    report->resource_mask = manifest->resource_mask;
+    report->callback_mask = manifest->callback_mask;
+    report->observed_callback_mask = inventory.observed_callback_mask;
+    report->callback_mask_consistent =
+        manifest->callback_mask == inventory.observed_callback_mask;
+    report->shmem_device = manifest->shmem_device;
+    report->shmem_inode = manifest->shmem_inode;
+    report->shmem_length = manifest->shmem_length;
+    report->slot_index = manifest->slot_index;
+    report->node_count = manifest->node_count;
+    report->control_fd = manifest->control_fd;
+    report->wake_fd = manifest->wake_fd;
+    report->coverage = (manifest->resource_mask &
+        QEMU_PLUGIN_CRUCIBLE_RESOURCE_COVERAGE) != 0;
+    report->whitebox = (manifest->resource_mask &
+        QEMU_PLUGIN_CRUCIBLE_RESOURCE_WHITEBOX) != 0;
+    report->fingerprint = (manifest->resource_mask &
+        QEMU_PLUGIN_CRUCIBLE_RESOURCE_FINGERPRINT) != 0;
+    report->state_dump = (manifest->resource_mask &
+        QEMU_PLUGIN_CRUCIBLE_RESOURCE_STATE_DUMP) != 0;
+    report->app_random = (manifest->resource_mask &
+        QEMU_PLUGIN_CRUCIBLE_RESOURCE_APP_RANDOM) != 0;
+    return report;
+}
