+/* Versioned Crucible plugin resource manifest. */
+#define QEMU_PLUGIN_CRUCIBLE_RESOURCE_MANIFEST_VERSION 1
+
+#define QEMU_PLUGIN_CRUCIBLE_RESOURCE_CONTROL_SOCKET (UINT64_C(1) << 0)
+#define QEMU_PLUGIN_CRUCIBLE_RESOURCE_SHMEM_MAPPING (UINT64_C(1) << 1)
+#define QEMU_PLUGIN_CRUCIBLE_RESOURCE_WAKE_FD (UINT64_C(1) << 2)
+#define QEMU_PLUGIN_CRUCIBLE_RESOURCE_TIME_CONTROL (UINT64_C(1) << 3)
+#define QEMU_PLUGIN_CRUCIBLE_RESOURCE_VCPU (UINT64_C(1) << 4)
+#define QEMU_PLUGIN_CRUCIBLE_RESOURCE_NETWORK (UINT64_C(1) << 5)
+#define QEMU_PLUGIN_CRUCIBLE_RESOURCE_BLOCK (UINT64_C(1) << 6)
+#define QEMU_PLUGIN_CRUCIBLE_RESOURCE_9P (UINT64_C(1) << 7)
+#define QEMU_PLUGIN_CRUCIBLE_RESOURCE_ACCELERATOR (UINT64_C(1) << 8)
+#define QEMU_PLUGIN_CRUCIBLE_RESOURCE_FAULT_TRANSPORT (UINT64_C(1) << 9)
+#define QEMU_PLUGIN_CRUCIBLE_RESOURCE_COVERAGE (UINT64_C(1) << 10)
+#define QEMU_PLUGIN_CRUCIBLE_RESOURCE_WHITEBOX (UINT64_C(1) << 11)
+#define QEMU_PLUGIN_CRUCIBLE_RESOURCE_FINGERPRINT (UINT64_C(1) << 12)
+#define QEMU_PLUGIN_CRUCIBLE_RESOURCE_STATE_DUMP (UINT64_C(1) << 13)
+#define QEMU_PLUGIN_CRUCIBLE_RESOURCE_APP_RANDOM (UINT64_C(1) << 14)
+#define QEMU_PLUGIN_CRUCIBLE_RESOURCE_ALL ((UINT64_C(1) << 15) - 1)
+#define QEMU_PLUGIN_CRUCIBLE_RESOURCE_REQUIRED ((UINT64_C(1) << 10) - 1)
+
+#define QEMU_PLUGIN_CRUCIBLE_CALLBACK_VCPU_INIT (UINT64_C(1) << 0)
+#define QEMU_PLUGIN_CRUCIBLE_CALLBACK_TCG_EXEC (UINT64_C(1) << 1)
+#define QEMU_PLUGIN_CRUCIBLE_CALLBACK_VCPU_IDLE_RESUME (UINT64_C(1) << 2)
+#define QEMU_PLUGIN_CRUCIBLE_CALLBACK_CONTROL_BOUNDARY (UINT64_C(1) << 3)
+#define QEMU_PLUGIN_CRUCIBLE_CALLBACK_SIM_SHMEM (UINT64_C(1) << 4)
+#define QEMU_PLUGIN_CRUCIBLE_CALLBACK_TIME_ADVANCE (UINT64_C(1) << 5)
+#define QEMU_PLUGIN_CRUCIBLE_CALLBACK_NETWORK (UINT64_C(1) << 6)
+#define QEMU_PLUGIN_CRUCIBLE_CALLBACK_BLOCK (UINT64_C(1) << 7)
+#define QEMU_PLUGIN_CRUCIBLE_CALLBACK_BLOCK_EVENT (UINT64_C(1) << 8)
+#define QEMU_PLUGIN_CRUCIBLE_CALLBACK_BLOCK_WAIT (UINT64_C(1) << 9)
+#define QEMU_PLUGIN_CRUCIBLE_CALLBACK_9P (UINT64_C(1) << 10)
+#define QEMU_PLUGIN_CRUCIBLE_CALLBACK_ACCELERATOR (UINT64_C(1) << 11)
+#define QEMU_PLUGIN_CRUCIBLE_CALLBACK_TB_TRANSLATION (UINT64_C(1) << 12)
+#define QEMU_PLUGIN_CRUCIBLE_CALLBACK_FLUSH (UINT64_C(1) << 13)
+#define QEMU_PLUGIN_CRUCIBLE_CALLBACK_ALL ((UINT64_C(1) << 14) - 1)
+#define QEMU_PLUGIN_CRUCIBLE_CALLBACK_REQUIRED \
+    (((UINT64_C(1) << 12) - 1) & \
+     ~QEMU_PLUGIN_CRUCIBLE_CALLBACK_TCG_EXEC)
+
+struct qemu_plugin_crucible_resource_manifest {
+    uint32_t schema_version;
+    uint32_t struct_size;
+    uint64_t process_generation;
+    uint64_t plugin_id;
+    uint64_t resource_mask;
+    uint64_t callback_mask;
+    uint64_t shmem_device;
+    uint64_t shmem_inode;
+    uint64_t shmem_length;
+    uint32_t slot_index;
+    uint32_t node_count;
+    int32_t control_fd;
+    int32_t wake_fd;
+};
+
+/**
+ * qemu_plugin_crucible_register_resource_manifest() - seal plugin resources
+ * @manifest: complete versioned scalar manifest retained by QEMU
+ *
+ * The call succeeds once, only after every mandatory callback and the exact
+ * wake descriptor are registered. QEMU cross-checks its observed callback set
+ * and retains a by-value copy for the out-of-band hot-fork query.
+ *
+ * Returns zero on success or a negative errno-style status on failure.
+ */
+QEMU_PLUGIN_API
+int qemu_plugin_crucible_register_resource_manifest(
+    const struct qemu_plugin_crucible_resource_manifest *manifest);
+
