 static void crucible_hot_fork_template_schedule_block_transition(void);
 
+static bool crucible_hot_fork_resource_stage_allowed(Error **errp)
+{
+    CrucibleHotForkPluginBarrierState *plugin_barrier;
+    bool allowed;
+
+    if (!crucible_hot_fork_template_active) {
+        return true;
+    }
+    if (crucible_hot_fork_template_phase !=
+        CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BARRIERS_HELD) {
+        error_setg(errp, "Crucible hot-fork resources require the retained "
+                   "template barrier phase");
+        return false;
+    }
+    if (!crucible_hot_fork_exact_paused_boundary()) {
+        error_setg(errp, "Crucible hot-fork resources require the exact "
+                   "paused/device-flush boundary");
+        return false;
+    }
+
+    plugin_barrier = crucible_hot_fork_plugin_barrier(
+        QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_QUERY, errp);
+    if (!plugin_barrier) {
+        return false;
+    }
+    allowed = plugin_barrier->quiescent;
+    g_free(plugin_barrier);
+    if (!allowed) {
+        error_setg(errp, "Crucible hot-fork resources require a quiescent "
+                   "retained plugin barrier");
+    }
+    return allowed;
+}
