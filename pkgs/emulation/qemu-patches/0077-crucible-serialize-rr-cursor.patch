+static int crucible_rr_cursor_state_post_load(void *opaque, int version_id)
+{
+    TimersState *state = opaque;
+    uint64_t quantum = icount_crucible_rr_switch_quantum();
+
+    if (quantum == 0) {
+        return 0;
+    }
+    if (!state->crucible_rr_cursor_valid ||
+        state->crucible_rr_cursor_position >= quantum ||
+        !qemu_get_cpu(state->crucible_rr_current_vcpu)) {
+        return -EINVAL;
+    }
+    state->crucible_rr_selection_pending = true;
+    return 0;
