+static CPUState *icount_crucible_rr_next_runnable(CPUState *selected)
+{
+    CPUState *candidate = CPU_NEXT(selected);
+
+    if (!candidate) {
+        candidate = first_cpu;
+    }
+    while (candidate && candidate != selected) {
+        if (cpu_can_run(candidate) &&
+            (!candidate->halted || cpu_has_work(candidate))) {
+            return candidate;
+        }
+        candidate = CPU_NEXT(candidate);
+        if (!candidate) {
+            candidate = first_cpu;
+        }
+    }
+    return NULL;
+}
+
+CPUState *icount_crucible_rr_select_cpu(CPUState *suggested)
+{
+    CPUState *selected;
+    CPUState *runnable;
+
+    if (!suggested || icount_crucible_rr_switch_quantum() == 0) {
+        return suggested;
+    }
+    if (timers_state.crucible_rr_selection_pending) {
+        selected = qemu_get_cpu(timers_state.crucible_rr_current_vcpu);
+        g_assert(selected);
+        /* A zero-instruction boundary must not consume the selection. */
+        if ((!cpu_can_run(selected) ||
+             (selected->halted && !cpu_has_work(selected))) &&
+            (runnable = icount_crucible_rr_next_runnable(selected))) {
+            timers_state.crucible_rr_current_vcpu = runnable->cpu_index;
+            timers_state.crucible_rr_cursor_position = 0;
+            timers_state.crucible_rr_selection_pending = false;
+            return runnable;
+        }
+        return selected;
+    }
+    if (!timers_state.crucible_rr_cursor_valid ||
+        timers_state.crucible_rr_current_vcpu != suggested->cpu_index) {
+        timers_state.crucible_rr_current_vcpu = suggested->cpu_index;
+        timers_state.crucible_rr_cursor_position = 0;
+        timers_state.crucible_rr_cursor_valid = true;
+    }
+    return suggested;
+}
