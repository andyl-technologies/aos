+    if (!cpu || quantum == 0 || executed == 0) {
+        return;
+    }
+    if (!timers_state.crucible_rr_cursor_valid ||
+        timers_state.crucible_rr_current_vcpu != cpu->cpu_index) {
+        timers_state.crucible_rr_current_vcpu = cpu->cpu_index;
+        timers_state.crucible_rr_cursor_position = 0;
+        timers_state.crucible_rr_cursor_valid = true;
+    }
+    timers_state.crucible_rr_selection_pending = false;
+    remaining = quantum - timers_state.crucible_rr_cursor_position;
+    if (executed > remaining) {
+        error_report("crucible RR cursor overrun: executed=%" PRIu64
+                     " remaining=%" PRIu64,
+                     executed, remaining);
+        abort();
+    }
+    timers_state.crucible_rr_cursor_position += executed;
+    if (timers_state.crucible_rr_cursor_position != quantum) {
+        return;
+    }
+
+    next = CPU_NEXT(cpu);
+    if (!next) {
+        next = first_cpu;
+    }
+    g_assert(next);
+    timers_state.crucible_rr_current_vcpu = next->cpu_index;
+    timers_state.crucible_rr_cursor_position = 0;
+    timers_state.crucible_rr_selection_pending = true;
 }
 
