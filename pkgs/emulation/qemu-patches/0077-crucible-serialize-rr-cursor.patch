+            (runnable = icount_crucible_rr_next_runnable(selected))) {
+            timers_state.crucible_rr_current_vcpu = runnable->cpu_index;
+            timers_state.crucible_rr_cursor_position = 0;
+            timers_state.crucible_rr_selection_pending = false;
