+CrucibleHotForkBottomHalfInventory *
+qmp_query_crucible_hot_fork_bottom_half_inventory(Error **errp)
+{
+#ifdef CONFIG_POSIX
+    CrucibleHotForkBottomHalfInventory *report =
+        g_new0(CrucibleHotForkBottomHalfInventory, 1);
+    QemuBhHotForkInventory inventory;
+    CrucibleHotForkBottomHalfList **tail = &report->bottom_halves;
+    uint64_t previous_bh_id = 0;
+    bool valid_entries = true;
+    size_t index;
+
+    (void)errp;
+    report->schema_version = 1;
+    qemu_bh_hot_fork_inventory(&inventory);
+    report->generation = inventory.generation;
+    report->stable = inventory.stable;
+    for (index = 0; index < inventory.entry_count; index++) {
+        QemuBhHotForkInventoryEntry *source = &inventory.entries[index];
+        CrucibleHotForkBottomHalf *bh =
+            g_new0(CrucibleHotForkBottomHalf, 1);
+        CrucibleHotForkBottomHalfList *node =
+            g_new0(CrucibleHotForkBottomHalfList, 1);
+
+        bh->bottom_half_id = source->bh_id;
+        bh->context_id = source->context_id;
+        bh->name = g_strdup(source->name);
+        bh->name_valid = source->name_valid;
+        bh->pending = source->pending;
+        bh->scheduled = source->scheduled;
+        bh->deleted = source->deleted;
+        bh->oneshot = source->oneshot;
+        bh->idle = source->idle;
+        bh->active_callbacks = source->active_callbacks;
+        if (source->bh_id == 0 || source->context_id == 0 ||
+            (index != 0 && source->bh_id <= previous_bh_id) ||
+            !source->name_valid || source->name[0] == '\0' ||
+            strlen(source->name) > QEMU_BH_HOT_FORK_NAME_MAX ||
+            (source->scheduled && !source->pending) ||
+            (source->idle && !source->pending)) {
+            valid_entries = false;
+        }
+        previous_bh_id = source->bh_id;
+        report->pending_bottom_halves += source->pending;
+        report->scheduled_bottom_halves += source->scheduled;
+        report->deleted_bottom_halves += source->deleted;
+        report->active_callbacks += source->active_callbacks;
+        node->value = bh;
+        *tail = node;
+        tail = &node->next;
+    }
+    report->bottom_half_count = inventory.entry_count;
+    report->overflowed = inventory.overflowed;
+    report->complete = inventory.stable && !inventory.overflowed &&
+                       valid_entries;
+    qemu_bh_hot_fork_inventory_destroy(&inventory);
+    return report;
+#else
+    error_setg(errp, "Crucible hot-fork bottom-half inventory requires POSIX");
+    return NULL;
+#endif
+}
