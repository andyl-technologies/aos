+#define QEMU_BH_HOT_FORK_INVENTORY_MAX 65536
+#define QEMU_BH_HOT_FORK_NAME_MAX 128
+
+typedef struct QemuBhHotForkInventoryEntry {
+    uint64_t bh_id;
+    uint64_t context_id;
+    uint32_t active_callbacks;
+    bool pending;
+    bool scheduled;
+    bool deleted;
+    bool oneshot;
+    bool idle;
+    bool name_valid;
+    char name[QEMU_BH_HOT_FORK_NAME_MAX + 1];
+} QemuBhHotForkInventoryEntry;
+
+typedef struct QemuBhHotForkInventory {
+    uint64_t generation;
+    size_t entry_count;
+    bool overflowed;
+    bool stable;
+    QemuBhHotForkInventoryEntry *entries;
+} QemuBhHotForkInventory;
+
+/*
+ * Capture every allocated QEMUBH for hot-fork auditing.  This remains an
+ * observation and does not drain, park, or authorize bottom-half execution.
+ */
+void qemu_bh_hot_fork_inventory(QemuBhHotForkInventory *inventory);
+void qemu_bh_hot_fork_inventory_destroy(QemuBhHotForkInventory *inventory);
