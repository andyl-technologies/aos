+##
+# @CrucibleHotForkBottomHalf:
+#
+# One allocated bottom half in the process-local registry.
+#
+# @bottom-half-id: positive stable process-local identity
+#
+# @context-id: positive process-local AioContext identity
+#
+# @name: bounded copied diagnostic callback name
+#
+# @name-valid: whether @name was nonempty, valid UTF-8, and at most 128 bytes
+#
+# @pending: whether the bottom half is enqueued for polling
+#
+# @scheduled: whether its callback remains scheduled
+#
+# @deleted: whether deferred deletion was requested
+#
+# @oneshot: whether the bottom half is freed after its first callback
+#
+# @idle: whether it is scheduled only while the event loop is idle
+#
+# @active-callbacks: number of callbacks currently executing
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'struct': 'CrucibleHotForkBottomHalf',
+  'data': { 'bottom-half-id': 'uint64',
+            'context-id': 'uint64',
+            'name': 'str',
+            'name-valid': 'bool',
+            'pending': 'bool',
+            'scheduled': 'bool',
+            'deleted': 'bool',
+            'oneshot': 'bool',
+            'idle': 'bool',
+            'active-callbacks': 'uint32' } }
+
+##
+# @CrucibleHotForkBottomHalfInventory:
+#
+# Bounded observational snapshot of every allocated QEMUBH, including inert,
+# pending, active, canceled, and deferred-deletion instances.  This report does
+# not drain, park, or retain a bottom-half barrier.
+#
+# @schema-version: inventory contract version, currently 1
+#
+# @generation: monotonic process-local lifecycle and state generation
+#
+# @complete: true exactly when the snapshot is stable, did not overflow, and
+#     every retained entry is structurally valid
+#
+# @overflowed: whether allocated bottom halves exceeded the retained bound
+#
+# @stable: whether no bottom-half transition raced the bounded copy
+#
+# @bottom-half-count: number of retained allocated bottom halves
+#
+# @pending-bottom-halves: retained bottom halves whose @pending field is true
+#
+# @scheduled-bottom-halves: retained bottom halves whose @scheduled field is
+#     true
+#
+# @deleted-bottom-halves: retained bottom halves whose @deleted field is true
+#
+# @active-callbacks: checked sum of retained @active-callbacks
+#
+# @bottom-halves: allocated bottom halves sorted by @bottom-half-id and bounded
+#     to 65536
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'struct': 'CrucibleHotForkBottomHalfInventory',
+  'data': { 'schema-version': 'uint32',
+            'generation': 'uint64',
+            'complete': 'bool',
+            'overflowed': 'bool',
+            'stable': 'bool',
+            'bottom-half-count': 'uint32',
+            'pending-bottom-halves': 'uint32',
+            'scheduled-bottom-halves': 'uint32',
+            'deleted-bottom-halves': 'uint32',
+            'active-callbacks': 'uint64',
+            'bottom-halves': [ 'CrucibleHotForkBottomHalf' ] } }
+
+##
+# @query-crucible-hot-fork-bottom-half-inventory:
+#
+# Query every allocated QEMUBH.  This command is observational and cannot
+# acknowledge the AIO/BH/timer readiness proof.
+#
+# Returns: @CrucibleHotForkBottomHalfInventory
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'command': 'query-crucible-hot-fork-bottom-half-inventory',
+  'returns': 'CrucibleHotForkBottomHalfInventory',
+  'allow-oob': true }
+
 ##
 # @SHUTDOWN:
 #
diff --git a/util/async.c b/util/async.c
index 0ae679613..b14da687c 100644
--- a/util/async.c
+++ b/util/async.c
@@ -30,6 +30,7 @@
 #include "block/graph-lock.h"
 #include "qemu/main-loop.h"
 #include "qemu/atomic.h"
