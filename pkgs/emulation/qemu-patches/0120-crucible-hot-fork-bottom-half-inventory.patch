@@ -165,8 +166,132 @@ struct QEMUBH {
     QSLIST_ENTRY(QEMUBH) next;
     unsigned flags;
     MemReentrancyGuard *reentrancy_guard;
+    uint64_t crucible_hot_fork_id;
+    uint32_t crucible_hot_fork_active_callbacks;
+    bool crucible_hot_fork_name_valid;
+    char crucible_hot_fork_name[QEMU_BH_HOT_FORK_NAME_MAX + 1];
+    QTAILQ_ENTRY(QEMUBH) crucible_hot_fork_node;
 };
 
+static QTAILQ_HEAD(, QEMUBH) crucible_hot_fork_bhs =
+    QTAILQ_HEAD_INITIALIZER(crucible_hot_fork_bhs);
+static uint64_t crucible_hot_fork_bh_next_id = 1;
+static uint64_t crucible_hot_fork_bh_generation;
+/* Bracket lock-free state writes so a reader cannot miss a late generation. */
+static uint32_t crucible_hot_fork_bh_active_transitions;
+
+static void crucible_hot_fork_bh_changed(void)
+{
+    qatomic_inc(&crucible_hot_fork_bh_generation);
+}
+
+static void crucible_hot_fork_bh_transition_begin(void)
+{
+    qatomic_inc(&crucible_hot_fork_bh_active_transitions);
+}
+
+static void crucible_hot_fork_bh_transition_end(bool changed)
+{
+    if (changed) {
+        crucible_hot_fork_bh_changed();
+    }
+    qatomic_dec(&crucible_hot_fork_bh_active_transitions);
+}
+
+static void crucible_hot_fork_bh_register(QEMUBH *bh, const char *name)
+{
+    size_t name_length = name ?
+        strnlen(name, QEMU_BH_HOT_FORK_NAME_MAX + 1) : 0;
+
+    bh->crucible_hot_fork_name_valid =
+        name_length > 0 && name_length <= QEMU_BH_HOT_FORK_NAME_MAX &&
+        g_utf8_validate(name, name_length, NULL);
+    if (bh->crucible_hot_fork_name_valid) {
+        memcpy(bh->crucible_hot_fork_name, name, name_length);
+        bh->crucible_hot_fork_name[name_length] = '\0';
+    } else {
+        pstrcpy(bh->crucible_hot_fork_name,
+                sizeof(bh->crucible_hot_fork_name), "<invalid>");
+    }
+
+    QEMU_LOCK_GUARD(&crucible_hot_fork_aio_lock);
+    bh->crucible_hot_fork_id = crucible_hot_fork_bh_next_id++;
+    assert(bh->crucible_hot_fork_id != 0);
+    QTAILQ_INSERT_TAIL(&crucible_hot_fork_bhs, bh,
+                       crucible_hot_fork_node);
+    crucible_hot_fork_bh_changed();
+}
+
+static void crucible_hot_fork_bh_free(QEMUBH *bh)
+{
+    qemu_mutex_lock(&crucible_hot_fork_aio_lock);
+    QTAILQ_REMOVE(&crucible_hot_fork_bhs, bh, crucible_hot_fork_node);
+    crucible_hot_fork_bh_changed();
+    qemu_mutex_unlock(&crucible_hot_fork_aio_lock);
+    g_free(bh);
+}
+
+void qemu_bh_hot_fork_inventory(QemuBhHotForkInventory *inventory)
+{
+    QEMUBH *bh;
+    uint64_t generation_before;
+    uint32_t transitions_before;
+    uint32_t transitions_after;
+    size_t count = 0;
+
+    *inventory = (QemuBhHotForkInventory) { 0 };
+    qemu_mutex_lock(&crucible_hot_fork_aio_lock);
+    generation_before = qatomic_read(&crucible_hot_fork_bh_generation);
+    transitions_before =
+        qatomic_read(&crucible_hot_fork_bh_active_transitions);
+    QTAILQ_FOREACH(bh, &crucible_hot_fork_bhs, crucible_hot_fork_node) {
+        if (count == QEMU_BH_HOT_FORK_INVENTORY_MAX) {
+            inventory->overflowed = true;
+            break;
+        }
+        count++;
+    }
+
+    inventory->entries = g_new0(QemuBhHotForkInventoryEntry, count);
+    inventory->entry_count = count;
+    count = 0;
+    QTAILQ_FOREACH(bh, &crucible_hot_fork_bhs, crucible_hot_fork_node) {
+        QemuBhHotForkInventoryEntry *entry;
+        unsigned flags;
+
+        if (count == inventory->entry_count) {
+            break;
+        }
+        entry = &inventory->entries[count++];
+        entry->bh_id = bh->crucible_hot_fork_id;
+        entry->context_id = bh->ctx->crucible_hot_fork_id;
+        entry->active_callbacks =
+            qatomic_read(&bh->crucible_hot_fork_active_callbacks);
+        flags = qatomic_read(&bh->flags);
+        entry->pending = flags & BH_PENDING;
+        entry->scheduled = flags & BH_SCHEDULED;
+        entry->deleted = flags & BH_DELETED;
+        entry->oneshot = flags & BH_ONESHOT;
+        entry->idle = flags & BH_IDLE;
+        entry->name_valid = bh->crucible_hot_fork_name_valid;
+        pstrcpy(entry->name, sizeof(entry->name),
+                bh->crucible_hot_fork_name);
+    }
+    transitions_after =
+        qatomic_read(&crucible_hot_fork_bh_active_transitions);
+    inventory->generation =
+        qatomic_read(&crucible_hot_fork_bh_generation);
+    inventory->stable = transitions_before == 0 && transitions_after == 0 &&
+                        generation_before == inventory->generation;
+    qemu_mutex_unlock(&crucible_hot_fork_aio_lock);
+}
+
+void qemu_bh_hot_fork_inventory_destroy(QemuBhHotForkInventory *inventory)
+{
+    g_free(inventory->entries);
+    *inventory = (QemuBhHotForkInventory) { 0 };
+}
