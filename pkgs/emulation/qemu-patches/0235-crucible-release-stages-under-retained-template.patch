+++ b/monitor/qmp-cmds.c
@@ -737,6 +737,31 @@ static int crucible_hot_fork_reinitialize_child_console(
 
 static void crucible_hot_fork_template_schedule_block_transition(void);
 
+/*
+ * A staged child resource may be released while no fork operation is active
+ * and the template is either absent or retained at its barrier phase: a
+ * stage the last fork consumed must give way to the next child's, and an
+ * unconsumed one may be withdrawn.  The transitional phases still refuse,
+ * since the template's proofs are being computed from the stages then.
+ */
+static bool crucible_hot_fork_stage_release_allowed(const char *what,
+                                                    Error **errp)
+{
+    if (crucible_hot_fork_operation_active) {
+        error_setg(errp, "Cannot release Crucible hot-fork %s during a fork "
+                   "operation", what);
+        return false;
+    }
+    if (crucible_hot_fork_template_active &&
+        crucible_hot_fork_template_phase !=
+            CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BARRIERS_HELD) {
+        error_setg(errp, "Cannot release Crucible hot-fork %s during template "
+                   "preparation", what);
+        return false;
+    }
+    return true;
+}
+
 static bool crucible_hot_fork_resource_stage_allowed(
     CrucibleHotForkPluginBarrierState **retained_plugin_barrier,
     Error **errp)
@@ -1281,9 +1306,7 @@ qmp_crucible_hot_fork_private_rings(
                        "does not match the retained descriptor");
             goto out;
         }
-        if (crucible_hot_fork_template_active) {
-            error_setg(errp, "Cannot release Crucible hot-fork private rings "
-                       "during template preparation");
+        if (!crucible_hot_fork_stage_release_allowed("private rings", errp)) {
