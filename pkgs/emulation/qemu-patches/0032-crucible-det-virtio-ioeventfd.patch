diff --git a/hw/virtio/virtio-pci.c b/hw/virtio/virtio-pci.c
index 3ca3f84..fbcf68f 100644
--- a/hw/virtio/virtio-pci.c
+++ b/hw/virtio/virtio-pci.c
@@ -16,6 +16,8 @@
  */
 
 #include "qemu/osdep.h"
+#include "qemu/accel.h"
+#include "system/cpu-timers.h"
 
 #include "exec/memop.h"
 #include "standard-headers/linux/virtio_pci.h"
@@ -313,6 +315,35 @@ static bool virtio_pci_ioeventfd_enabled(DeviceState *d)
 {
     VirtIOPCIProxy *proxy = to_virtio_pci_proxy(d);
 
+    /*
+     * Under the Crucible sim accelerator's deterministic icount, ioeventfd
+     * would dispatch the guest's virtqueue kick asynchronously on the main
+     * loop, so the device handler (and any completion interrupt it raises) runs
+     * at an icount that races the vCPU thread rather than one fixed by the kick
+     * -- the host-timing-vs-virtual-time completion hazard of RFC-0010
+     * 15-io-subnodes.md, an inherent upstream icount limitation for async
+     * device dispatch (determinism-contract 4.6/E7).  Disable ioeventfd so the
+     * kick is serviced synchronously on the requesting vCPU thread at a
+     * deterministic icount; synchronous completion without ioeventfd is
+     * ordinary QEMU device behaviour.  No QEMU record/replay (RFC-0010 NG-6).
+     *
+     * Scope this ioctl-level policy to virtio-rng and virtio-blk.  virtio-rng's
+     * entropy completion has no other deterministic anchor -- its delivery
+     * icount is the leak S6 hits.  A standard file-backed virtio-blk guest must
+     * enter the generic notification path before patch 0040 can dispatch its
+     * request inline; otherwise the vCPU can park before QEMU submits the AIO.
+     * Both devices preserve their existing completion paths.
+     */
+    if (icount_enabled() && strcmp(current_accel_name(), "sim") == 0) {
+        VirtIODevice *vdev = virtio_bus_get_device(&proxy->bus);
+
+        if (vdev != NULL &&
+            (vdev->device_id == VIRTIO_ID_RNG ||
+             vdev->device_id == VIRTIO_ID_BLOCK)) {
+            return false;
+        }
+    }
+
     return (proxy->flags & VIRTIO_PCI_FLAG_USE_IOEVENTFD) != 0;
 }
 
@@ -2630,4 +2661,3 @@ static void virtio_pci_register_types(void)
 }
 
 type_init(virtio_pci_register_types)
