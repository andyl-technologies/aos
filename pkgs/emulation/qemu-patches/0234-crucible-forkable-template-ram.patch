+/*
+ * Marks every RAM block's host memory as inherited across fork, or restores
+ * the MADV_DONTFORK that ram_block_add() applies.  A Crucible hot-fork
+ * template needs its guest RAM in the child as private copy-on-write pages;
+ * KVM needs MADV_DONTFORK, so the change is refused with -ENOTSUP under KVM.
+ * Returns zero or a negative errno.
+ */
+int qemu_crucible_hot_fork_ram_set_forkable(bool forkable);
 int ram_block_discard_range(RAMBlock *rb, uint64_t start, size_t length);
