@@ -3953,6 +3964,23 @@ qmp_crucible_hot_fork_template(
                 outcome = CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_DRAINING;
                 break;
             }
+            /*
+             * ram_block_add() marks guest RAM MADV_DONTFORK so helper forks
+             * never duplicate it; a fork child needs that RAM as private
+             * copy-on-write pages.  Make it forkable for the template's
