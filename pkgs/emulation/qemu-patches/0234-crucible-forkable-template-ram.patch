     return !(memory_region_is_ram(mr) || memory_region_is_romd(mr));
 }
 
+static int crucible_hot_fork_ram_advise(RAMBlock *block, void *opaque)
+{
+    const int advice = *(const int *)opaque;
+
+    if (!block->host) {
+        return 0;
+    }
+    if (qemu_madvise(block->host, block->max_length, advice) != 0) {
+        return -errno;
+    }
+    return 0;
+}
+
+int qemu_crucible_hot_fork_ram_set_forkable(bool forkable)
+{
+    int advice = forkable ? QEMU_MADV_DOFORK : QEMU_MADV_DONTFORK;
+
+    if (kvm_enabled()) {
+        return -ENOTSUP;
+    }
+    if (advice == QEMU_MADV_INVALID) {
+        return -ENOTSUP;
+    }
+    /* A qtest server never applied MADV_DONTFORK; leave it that way. */
+    if (qtest_enabled()) {
+        return 0;
+    }
+    return qemu_ram_foreach_block(crucible_hot_fork_ram_advise, &advice);
+}
