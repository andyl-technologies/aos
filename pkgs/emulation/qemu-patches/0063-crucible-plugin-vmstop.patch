+static __thread unsigned int qemu_plugin_crucible_exact_boundary_depth;
+static int qemu_plugin_crucible_vmstop_state;
+static int qemu_plugin_crucible_vmstop_flush_result;
+
+enum {
+    QEMU_PLUGIN_CRUCIBLE_VMSTOP_IDLE,
+    QEMU_PLUGIN_CRUCIBLE_VMSTOP_ADMITTED,
+    QEMU_PLUGIN_CRUCIBLE_VMSTOP_STOPPED,
+};
+
+int qemu_plugin_request_vmstop(void)
+{
+    int status;
+
+    if (!current_cpu ||
+        qemu_plugin_crucible_exact_boundary_depth == 0 ||
+        icount_enabled() != ICOUNT_PRECISE ||
+        !qemu_plugin_crucible_single_threaded_rr()) {
+        return -EPERM;
+    }
+
+    qatomic_set(&qemu_plugin_crucible_vmstop_flush_result, 0);
+    if (qatomic_cmpxchg(&qemu_plugin_crucible_vmstop_state,
+                       QEMU_PLUGIN_CRUCIBLE_VMSTOP_IDLE,
+                       QEMU_PLUGIN_CRUCIBLE_VMSTOP_ADMITTED) !=
+        QEMU_PLUGIN_CRUCIBLE_VMSTOP_IDLE) {
+        return -EALREADY;
+    }
+
+    /*
+     * vCPU-thread vm_stop() admits an asynchronous main-loop transition and
+     * therefore returns zero after queueing it.  QMP query-status is the
+     * completion channel; this return value reports admission only.
+     */
+    status = vm_stop(RUN_STATE_PAUSED);
+
+    if (status != 0) {
+        qatomic_set(&qemu_plugin_crucible_vmstop_state,
+                    QEMU_PLUGIN_CRUCIBLE_VMSTOP_IDLE);
+    }
+    return status;
+}
+
+void qemu_plugin_crucible_exact_boundary_enter(void)
+{
+    g_assert(qemu_plugin_crucible_exact_boundary_depth < UINT_MAX);
+    qemu_plugin_crucible_exact_boundary_depth++;
+}
+
+void qemu_plugin_crucible_exact_boundary_leave(void)
+{
+    g_assert(qemu_plugin_crucible_exact_boundary_depth > 0);
+    qemu_plugin_crucible_exact_boundary_depth--;
+}
+
+bool qemu_plugin_crucible_vmstop_pending(void)
+{
+    return qatomic_read(&qemu_plugin_crucible_vmstop_state) !=
+           QEMU_PLUGIN_CRUCIBLE_VMSTOP_IDLE;
+}
+
+bool qemu_plugin_crucible_vmstop_admission_pending(void)
+{
+    return qatomic_read(&qemu_plugin_crucible_vmstop_state) ==
+           QEMU_PLUGIN_CRUCIBLE_VMSTOP_ADMITTED;
+}
+
+void qemu_plugin_crucible_vmstop_request_stopped(int flush_status)
+{
+    if (qatomic_read(&qemu_plugin_crucible_vmstop_state) ==
+        QEMU_PLUGIN_CRUCIBLE_VMSTOP_ADMITTED) {
+        qatomic_set(&qemu_plugin_crucible_vmstop_flush_result, flush_status);
+        qatomic_cmpxchg(&qemu_plugin_crucible_vmstop_state,
+                        QEMU_PLUGIN_CRUCIBLE_VMSTOP_ADMITTED,
+                        QEMU_PLUGIN_CRUCIBLE_VMSTOP_STOPPED);
+    }
+}
+
+int qemu_plugin_crucible_vmstop_flush_status(void)
+{
+    if (qatomic_read(&qemu_plugin_crucible_vmstop_state) !=
+        QEMU_PLUGIN_CRUCIBLE_VMSTOP_STOPPED) {
+        return 0;
+    }
+    return qatomic_read(&qemu_plugin_crucible_vmstop_flush_result);
+}
+
+void qemu_plugin_crucible_vmstop_request_complete(void)
+{
+    if (qatomic_cmpxchg(&qemu_plugin_crucible_vmstop_state,
+                       QEMU_PLUGIN_CRUCIBLE_VMSTOP_STOPPED,
+                       QEMU_PLUGIN_CRUCIBLE_VMSTOP_IDLE) ==
+        QEMU_PLUGIN_CRUCIBLE_VMSTOP_STOPPED) {
+        qatomic_set(&qemu_plugin_crucible_vmstop_flush_result, 0);
