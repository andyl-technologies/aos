+/**
+ * qemu_plugin_request_vmstop() - stop the VM from an exact plugin boundary
+ *
+ * Requests QEMU's native RUN_STATE_PAUSED transition and stops the current
+ * vCPU. This is the handoff used after a Crucible plugin has published an
+ * exact checkpoint boundary: the vCPU releases the execution path so the main
+ * loop can complete QMP stop/save operations without retiring another guest
+ * instruction.
+ *
+ * Returns: 0 on success, nonzero outside precise single-threaded sim RR.
+ */
+QEMU_PLUGIN_API
+int qemu_plugin_request_vmstop(void);
