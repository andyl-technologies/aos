+struct CrucibleRamHash {
+    uint64_t hash;
+    uint64_t bytes;
+};
+
+static uint64_t crucible_fnv1a_u64(uint64_t hash, uint64_t value)
+{
+    for (int i = 0; i < 8; i++) {
+        hash ^= (value >> (i * 8)) & 0xffU;
+        hash *= 1099511628211ULL;
+    }
+    return hash;
+}
+
+static uint64_t crucible_fnv1a_bytes(uint64_t hash,
+                                     const uint8_t *bytes,
+                                     size_t len)
+{
+    for (size_t i = 0; i < len; i++) {
+        hash ^= bytes[i];
+        hash *= 1099511628211ULL;
+    }
+    return hash;
+}
+
+static int crucible_hash_ram_block(RAMBlock *block, void *opaque)
+{
+    struct CrucibleRamHash *state = opaque;
+
+    if (!block->host) {
+        return 0;
+    }
+
+    state->hash = crucible_fnv1a_bytes(state->hash,
+                                       (const uint8_t *)block->idstr,
+                                       strlen(block->idstr));
+    state->hash = crucible_fnv1a_u64(state->hash, block->used_length);
+    state->hash = crucible_fnv1a_bytes(state->hash, block->host,
+                                       block->used_length);
+    state->bytes += block->used_length;
+    return 0;
+}
+
+uint64_t qemu_plugin_crucible_ram_hash(uint64_t *bytes_out)
+{
+    struct CrucibleRamHash state = {
+        .hash = 1469598103934665603ULL,
+        .bytes = 0,
+    };
+
+    qemu_ram_foreach_block(crucible_hash_ram_block, &state);
+    if (bytes_out) {
+        *bytes_out = state.bytes;
+    }
+    return state.hash;
+}
+
+void qemu_plugin_crucible_pause_vm(void)
+{
+    (void)vm_stop(RUN_STATE_PAUSED);
+}
