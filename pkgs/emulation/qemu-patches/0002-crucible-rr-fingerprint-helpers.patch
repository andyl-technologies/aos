+static void crucible_checksum_u64(GChecksum *checksum, uint64_t value)
+{
+    uint8_t encoded[8];
+
+    for (size_t i = 0; i < sizeof(encoded); i++) {
+        encoded[sizeof(encoded) - i - 1] = value & 0xff;
+        value >>= 8;
+    }
+    g_checksum_update(checksum, encoded, sizeof(encoded));
+}
+
+static void crucible_checksum_bytes(GChecksum *checksum, const void *data,
+                                    size_t length)
+{
+    crucible_checksum_u64(checksum, length);
+    if (length != 0) {
+        g_checksum_update(checksum, data, length);
+    }
+}
+
+static void crucible_checksum_string(GChecksum *checksum, const char *value)
+{
+    if (value) {
+        crucible_checksum_bytes(checksum, value, strlen(value));
+    } else {
+        crucible_checksum_u64(checksum, UINT64_MAX);
+    }
+}
+
+static void crucible_checksum_vmsd(GChecksum *checksum,
+                                   const VMStateDescription *vmsd)
+{
+    const VMStateField *field;
+    const VMStateDescription * const *subsection;
+
+    crucible_checksum_string(checksum, vmsd->name);
+    crucible_checksum_u64(checksum, vmsd->version_id);
+    crucible_checksum_u64(checksum, vmsd->minimum_version_id);
+    crucible_checksum_u64(checksum, vmsd->priority);
+    crucible_checksum_u64(checksum, vmsd->early_setup);
+    crucible_checksum_u64(checksum, vmsd->unmigratable);
+    crucible_checksum_u64(checksum, vmsd->pre_load != NULL);
+    crucible_checksum_u64(checksum, vmsd->post_load != NULL);
+    crucible_checksum_u64(checksum, vmsd->pre_save != NULL);
+    crucible_checksum_u64(checksum, vmsd->post_save != NULL);
+    crucible_checksum_u64(checksum, vmsd->needed != NULL);
+    crucible_checksum_u64(checksum, vmsd->dev_unplug_pending != NULL);
+
+    for (field = vmsd->fields; field && field->name; field++) {
+        crucible_checksum_string(checksum, "field");
+        crucible_checksum_string(checksum, field->name);
+        crucible_checksum_u64(checksum, field->offset);
+        crucible_checksum_u64(checksum, field->size);
+        crucible_checksum_u64(checksum, field->start);
+        crucible_checksum_u64(checksum, field->num);
+        crucible_checksum_u64(checksum, field->num_offset);
+        crucible_checksum_u64(checksum, field->size_offset);
+        crucible_checksum_u64(checksum, field->flags);
+        crucible_checksum_u64(checksum, field->version_id);
+        crucible_checksum_u64(checksum, field->struct_version_id);
+        crucible_checksum_u64(checksum, field->field_exists != NULL);
+        crucible_checksum_string(checksum,
+                                 field->info ? field->info->name : NULL);
+        if (field->vmsd) {
+            crucible_checksum_vmsd(checksum, field->vmsd);
+        }
+    }
+    crucible_checksum_string(checksum, "fields-end");
+
+    for (subsection = vmsd->subsections;
+         subsection && *subsection; subsection++) {
+        crucible_checksum_string(checksum, "subsection");
+        crucible_checksum_vmsd(checksum, *subsection);
+    }
+    crucible_checksum_string(checksum, "subsections-end");
+}
+
+int qemu_savevm_crucible_schema_sha256(uint8_t digest[32],
+                                       uint64_t *sections_out)
+{
+    g_autoptr(GChecksum) checksum = NULL;
+    SaveStateEntry *se;
+    gsize digest_length = 32;
+    uint64_t sections = 0;
+
+    if (!digest || !sections_out) {
+        return -EINVAL;
+    }
+    memset(digest, 0, 32);
+    *sections_out = 0;
+    checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    if (!checksum) {
+        return -ENOMEM;
+    }
+    crucible_checksum_string(checksum,
+                             "crucible.qemu.device-vmstate-schema.v1");
+    QTAILQ_FOREACH(se, &savevm_state.handlers, entry) {
+        if (se->is_ram) {
+            continue;
+        }
+        sections++;
+        crucible_checksum_string(checksum, "section");
+        crucible_checksum_string(checksum, se->idstr);
+        crucible_checksum_u64(checksum, se->instance_id);
+        crucible_checksum_u64(checksum, se->version_id);
+        if (se->vmsd) {
+            crucible_checksum_vmsd(checksum, se->vmsd);
+        } else {
+            crucible_checksum_string(checksum, "legacy-savevm-handlers");
+        }
+    }
+    crucible_checksum_string(checksum, "sections-end");
+    g_checksum_get_digest(checksum, digest, &digest_length);
+    if (digest_length != 32) {
+        memset(digest, 0, 32);
+        return -EIO;
+    }
+    *sections_out = sections;
+    return 0;
+}
