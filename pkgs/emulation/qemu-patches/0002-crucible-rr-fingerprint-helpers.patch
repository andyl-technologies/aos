+int qemu_plugin_crucible_sha256_bytes(const uint8_t *material,
+                                      uint64_t material_length,
+                                      uint8_t digest_out[32])
+{
+    g_autoptr(GChecksum) checksum = NULL;
+    gsize digest_length = 32;
+
+    if (!digest_out || (material_length != 0 && !material) ||
+        material_length > G_MAXSIZE) {
+        return -EINVAL;
+    }
+    memset(digest_out, 0, 32);
+    checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    if (!checksum) {
+        return -ENOMEM;
+    }
+    if (material_length != 0) {
+        g_checksum_update(checksum, material, material_length);
+    }
+    g_checksum_get_digest(checksum, digest_out, &digest_length);
+    if (digest_length != 32) {
+        memset(digest_out, 0, 32);
+        return -EIO;
+    }
+    return 0;
+}
