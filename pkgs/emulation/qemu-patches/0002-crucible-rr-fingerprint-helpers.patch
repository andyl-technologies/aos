+int qemu_plugin_crucible_fingerprint_capture(
+    uint8_t **ram_material_out, uint64_t *ram_material_length_out,
+    uint64_t *ram_bytes_out, uint8_t **device_material_out,
+    uint64_t *device_material_length_out, uint64_t *device_bytes_out)
+{
+    g_autoptr(GByteArray) ram_material = NULL;
+    g_autoptr(GByteArray) device_material = NULL;
+    QIOChannelBuffer *buffer = NULL;
+    QEMUFile *file = NULL;
+    Error *local_err = NULL;
+    struct CrucibleCapturedRam ram;
+    bool acquired_bql = false;
+    bool started_dirty_tracking = false;
+    int close_status;
+    int status = 0;
+
+    if (!ram_material_out || !ram_material_length_out || !ram_bytes_out ||
+        !device_material_out || !device_material_length_out ||
+        !device_bytes_out) {
+        return -EINVAL;
+    }
+    *ram_material_out = NULL;
+    *ram_material_length_out = 0;
+    *ram_bytes_out = 0;
+    *device_material_out = NULL;
+    *device_material_length_out = 0;
+    *device_bytes_out = 0;
+
+    /*
+     * The safe fingerprint observer invokes this export at the exact scheduler
+     * ceiling on the single-threaded RR vCPU owner. Acquire the BQL explicitly
+     * before changing dirty-log state or serializing VMState. Dirty tracking
+     * supplies the write-protected capture epoch; the immutable copies remain
+     * valid after tracking ends, the BQL is released, and the guest resumes.
+     */
+    if (!bql_locked()) {
+        bql_lock();
+        acquired_bql = true;
+    }
+    if (!(global_dirty_tracking & GLOBAL_DIRTY_MIGRATION)) {
+        if (!memory_global_dirty_log_start(GLOBAL_DIRTY_MIGRATION,
+                                           &local_err)) {
+            error_free(local_err);
+            status = -EIO;
+            goto out;
+        }
+        started_dirty_tracking = true;
+    }
+
+    ram_material = g_byte_array_new();
+    device_material = g_byte_array_new();
+    if (!ram_material || !device_material) {
+        status = -ENOMEM;
+        goto out;
+    }
+    ram.material = ram_material;
+    ram.bytes = 0;
+    crucible_byte_array_bytes(ram_material, "crucible.qemu.guest-ram.v1",
+                              strlen("crucible.qemu.guest-ram.v1"));
+    qemu_ram_foreach_block(crucible_capture_guest_ram_block, &ram);
+
+    buffer = qio_channel_buffer_new(4096);
+    file = qemu_file_new_output(QIO_CHANNEL(buffer));
+    status = qemu_save_device_state(file);
+    if (status == 0) {
+        status = qemu_fflush(file);
+    }
+    if (status == 0) {
+        status = qemu_file_get_error(file);
+    }
+    if (status == 0) {
+        crucible_byte_array_bytes(device_material,
+                                  "crucible.qemu.device-vmstate.v1",
+                                  strlen("crucible.qemu.device-vmstate.v1"));
+        crucible_byte_array_bytes(device_material, buffer->data,
+                                  buffer->usage);
+        *ram_material_length_out = ram_material->len;
+        *ram_bytes_out = ram.bytes;
+        *device_material_length_out = device_material->len;
+        *device_bytes_out = buffer->usage;
+        *ram_material_out = g_byte_array_free(g_steal_pointer(&ram_material),
+                                              false);
+        *device_material_out =
+            g_byte_array_free(g_steal_pointer(&device_material), false);
+    }
+
+out:
+    if (file) {
+        close_status = qemu_fclose(file);
+        if (status == 0 && close_status != 0) {
+            status = close_status;
+        }
+    }
+    if (buffer) {
+        object_unref(OBJECT(buffer));
+    }
+    if (started_dirty_tracking) {
+        memory_global_dirty_log_stop(GLOBAL_DIRTY_MIGRATION);
+    }
+    if (acquired_bql) {
+        bql_unlock();
+    }
+    if (status != 0) {
+        g_clear_pointer(ram_material_out, g_free);
+        g_clear_pointer(device_material_out, g_free);
+        *ram_material_length_out = 0;
+        *ram_bytes_out = 0;
+        *device_material_length_out = 0;
+        *device_bytes_out = 0;
+    }
+    return status;
+}
