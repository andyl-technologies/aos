+
+static void crucible_checksum_u64(GChecksum *checksum, uint64_t value)
+{
+    uint8_t encoded[8];
+
+    for (size_t i = 0; i < sizeof(encoded); i++) {
+        encoded[sizeof(encoded) - i - 1] = value & 0xff;
+        value >>= 8;
+    }
+    g_checksum_update(checksum, encoded, sizeof(encoded));
+}
+
+static void crucible_checksum_bytes(GChecksum *checksum,
+                                    const void *bytes, size_t length)
+{
+    crucible_checksum_u64(checksum, length);
+    if (length != 0) {
+        g_checksum_update(checksum, bytes, length);
+    }
+}
+
+static void crucible_byte_array_u64(GByteArray *material, uint64_t value)
+{
+    uint8_t encoded[8];
+
+    for (size_t i = 0; i < sizeof(encoded); i++) {
+        encoded[sizeof(encoded) - i - 1] = value & 0xff;
+        value >>= 8;
+    }
+    g_byte_array_append(material, encoded, sizeof(encoded));
+}
+
+static void crucible_byte_array_bytes(GByteArray *material,
+                                      const void *bytes, size_t length)
+{
+    crucible_byte_array_u64(material, length);
+    if (length != 0) {
+        g_byte_array_append(material, bytes, length);
+    }
+}
+
+static int crucible_capture_guest_ram_block(RAMBlock *block, void *opaque)
+{
+    struct CrucibleCapturedRam *state = opaque;
+
+    if (!block->host || !block->mr || !memory_region_is_ram(block->mr) ||
+        memory_region_is_rom(block->mr) ||
+        memory_region_is_ram_device(block->mr)) {
+        return 0;
+    }
+    crucible_byte_array_bytes(state->material, block->idstr,
+                              strlen(block->idstr));
+    crucible_byte_array_u64(state->material, block->used_length);
+    crucible_byte_array_bytes(state->material, block->host,
+                              block->used_length);
+    state->bytes += block->used_length;
+    return 0;
+}
+
+static int crucible_sha256_guest_ram_block(RAMBlock *block, void *opaque)
+{
+    struct CrucibleSha256Ram *state = opaque;
+
+    if (!block->host || !block->mr || !memory_region_is_ram(block->mr) ||
+        memory_region_is_rom(block->mr) ||
+        memory_region_is_ram_device(block->mr)) {
+        return 0;
+    }
+    crucible_checksum_bytes(state->checksum, block->idstr,
+                            strlen(block->idstr));
+    crucible_checksum_u64(state->checksum, block->used_length);
+    crucible_checksum_bytes(state->checksum, block->host,
+                            block->used_length);
+    state->bytes += block->used_length;
+    return 0;
+}
+
+int qemu_plugin_crucible_guest_ram_sha256(uint8_t digest_out[32],
+                                          uint64_t *bytes_out)
+{
+    g_autoptr(GChecksum) checksum = NULL;
+    struct CrucibleSha256Ram state;
+    gsize digest_length = 32;
+
+    if (!digest_out || !bytes_out) {
+        return -EINVAL;
+    }
+    memset(digest_out, 0, 32);
+    *bytes_out = 0;
+    checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    if (!checksum) {
+        return -ENOMEM;
+    }
+    state.checksum = checksum;
+    state.bytes = 0;
+    crucible_checksum_bytes(checksum, "crucible.qemu.guest-ram.v1",
+                            strlen("crucible.qemu.guest-ram.v1"));
+    qemu_ram_foreach_block(crucible_sha256_guest_ram_block, &state);
+    g_checksum_get_digest(checksum, digest_out, &digest_length);
+    if (digest_length != 32) {
+        memset(digest_out, 0, 32);
+        return -EIO;
+    }
+    *bytes_out = state.bytes;
+    return 0;
+}
+
+int qemu_plugin_crucible_device_state_sha256(uint8_t digest_out[32],
+                                             uint64_t *bytes_out)
+{
+    QIOChannelBuffer *buffer;
+    QEMUFile *file;
+    GChecksum *checksum;
+    gsize digest_length = 32;
+    int status;
+    int close_status;
+
+    if (!digest_out || !bytes_out) {
+        return -EINVAL;
+    }
+    memset(digest_out, 0, 32);
+    *bytes_out = 0;
+    buffer = qio_channel_buffer_new(4096);
+    file = qemu_file_new_output(QIO_CHANNEL(buffer));
+    status = qemu_save_device_state(file);
+    if (status == 0) {
+        status = qemu_fflush(file);
+    }
+    if (status == 0) {
+        status = qemu_file_get_error(file);
+    }
+    checksum = status == 0 ? g_checksum_new(G_CHECKSUM_SHA256) : NULL;
+    if (status == 0 && !checksum) {
+        status = -ENOMEM;
+    }
+    if (status == 0) {
+        crucible_checksum_bytes(checksum,
+                                "crucible.qemu.device-vmstate.v1",
+                                strlen("crucible.qemu.device-vmstate.v1"));
+        crucible_checksum_bytes(checksum, buffer->data, buffer->usage);
+        g_checksum_get_digest(checksum, digest_out, &digest_length);
+        if (digest_length != 32) {
+            memset(digest_out, 0, 32);
+            status = -EIO;
+        } else {
+            *bytes_out = buffer->usage;
+        }
+    }
+    if (checksum) {
+        g_checksum_free(checksum);
+    }
+    close_status = qemu_fclose(file);
+    object_unref(OBJECT(buffer));
+    if (status == 0 && close_status != 0) {
+        memset(digest_out, 0, 32);
+        *bytes_out = 0;
+        status = close_status;
+    }
+    return status;
+}
