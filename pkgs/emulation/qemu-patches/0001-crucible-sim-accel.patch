diff --git a/accel/tcg/tcg-accel-ops-sim.c b/accel/tcg/tcg-accel-ops-sim.c
new file mode 100644
index 000000000..a3e2e27c8
--- /dev/null
+++ b/accel/tcg/tcg-accel-ops-sim.c
@@ -0,0 +1,38 @@
+/*
+ * QEMU TCG Crucible deterministic simulation accelerator ops
+ *
+ * This accelerator is selected only by -accel sim.  It intentionally reuses
+ * QEMU's single-threaded TCG icount machinery while giving Crucible a distinct
+ * accelerator name to gate later deterministic event-loop refinements.
+ */
+
+#include "qemu/osdep.h"
+#include "system/accel-ops.h"
+#include "system/tcg.h"
+#include "tcg-accel-ops.h"
+
+static void sim_accel_ops_class_init(ObjectClass *oc, const void *data)
+{
+    /*
+     * The inherited TCG ops initializer selects the single-threaded RR loop
+     * whenever icount is active.  sim_init_machine rejects non-icount launches
+     * and disables MTTCG before machine initialization, so the vCPU thread owns
+     * icount accounting and CPU execution while the main thread retains QMP and
+     * iohandler service.
+     */
+    tcg_accel_ops_class_init(oc, data);
+}
+
+static const TypeInfo sim_accel_ops_type = {
+    .name = ACCEL_OPS_NAME("sim"),
+    .parent = TYPE_ACCEL_OPS,
+    .class_init = sim_accel_ops_class_init,
+    .abstract = true,
+};
+module_obj(ACCEL_OPS_NAME("sim"));
+
+static void sim_accel_ops_register_types(void)
+{
+    type_register_static(&sim_accel_ops_type);
+}
+type_init(sim_accel_ops_register_types);
