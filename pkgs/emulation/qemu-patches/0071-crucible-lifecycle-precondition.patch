diff --git a/plugins/crucible-fault-lifecycle.c b/plugins/crucible-fault-lifecycle.c
index 7f4c1adf4..1ea15d518 100644
--- a/plugins/crucible-fault-lifecycle.c
+++ b/plugins/crucible-fault-lifecycle.c
@@ -486,6 +486,58 @@ static void crucible_lifecycle_sha256(const uint8_t *data, size_t length,
     g_assert(digest_length == 32);
 }
 
+static int crucible_lifecycle_device_sha256(uint8_t digest[32],
+                                            uint64_t *bytes)
+{
+    QIOChannelBuffer *buffer;
+    QEMUFile *file;
+    GChecksum *checksum = NULL;
+    gsize digest_length = 32;
+    int status;
+    int close_status;
+
+    memset(digest, 0, 32);
+    *bytes = 0;
+    buffer = qio_channel_buffer_new(4096);
+    file = qemu_file_new_output(QIO_CHANNEL(buffer));
+    status = qemu_save_device_state_domains(
+        file, QEMU_CRUCIBLE_LIFECYCLE_STATE_VOLATILE |
+              QEMU_CRUCIBLE_LIFECYCLE_STATE_DEVICE);
+    if (status == 0) {
+        status = qemu_fflush(file);
+    }
+    if (status == 0) {
+        status = qemu_file_get_error(file);
+    }
+    checksum = status == 0 ? g_checksum_new(G_CHECKSUM_SHA256) : NULL;
+    if (status == 0 && !checksum) {
+        status = -ENOMEM;
+    }
+    if (status == 0) {
+        g_checksum_update(
+            checksum,
+            (const uint8_t *)"crucible.qemu.lifecycle-device-vmstate.v1",
+            strlen("crucible.qemu.lifecycle-device-vmstate.v1"));
+        g_checksum_update(checksum, buffer->data, buffer->usage);
+        g_checksum_get_digest(checksum, digest, &digest_length);
+        if (digest_length != 32) {
+            memset(digest, 0, 32);
+            status = -EIO;
+        } else {
+            *bytes = buffer->usage;
+        }
+    }
+    g_clear_pointer(&checksum, g_checksum_free);
+    close_status = qemu_fclose(file);
+    object_unref(OBJECT(buffer));
+    if (status == 0 && close_status != 0) {
+        memset(digest, 0, 32);
+        *bytes = 0;
+        status = close_status;
+    }
+    return status;
+}
