+/**
+ * qemu_chr_socket_hot_fork_reconstruct_child_held() - replace child socket
+ * @basis: exact inherited socket basis prepared before fork
+ * @replacement_fd: retained branch-private connected AF_UNIX stream
+ * @expected_socket_cookie: exact nonzero Linux SO_COOKIE for @replacement_fd
+ *
+ * Consumes the copied basis only in a different process incarnation. The
+ * operation revalidates every inherited object and the replacement endpoint
+ * before mutation, then destroys the child's inherited read/HUP sources and
+ * connection and installs a duplicate of @replacement_fd without attaching
+ * input sources or emitting an open event. The listener remains disabled.
+ * Monitor parser reset, greeting, input release, and dispatcher reconstruction
+ * remain a later monitor-owned transaction.
+ *
+ * The transition is one-shot. Once destructive work begins, failure never
+ * makes the basis reusable.
+ *
+ * Returns: zero after exact held replacement, -EPERM in the source process or
+ * after an earlier attempt, -ESTALE if the inherited basis changed, -ENOTSUP
+ * when exact Linux socket authentication is unavailable, or another negative
+ * errno value for an invalid or unusable replacement.
+ */
+int qemu_chr_socket_hot_fork_reconstruct_child_held(
+    QemuChrSocketHotForkChildBasis *basis, int replacement_fd,
+    uint64_t expected_socket_cookie);
+
 DECLARE_INSTANCE_CHECKER(SocketChardev, SOCKET_CHARDEV,
                          TYPE_CHARDEV_SOCKET)
 
