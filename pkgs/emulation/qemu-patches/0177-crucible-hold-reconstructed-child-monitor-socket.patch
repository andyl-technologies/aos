+static int tcp_chr_hot_fork_validate_replacement_fd(
+    int fd, uint64_t expected_socket_cookie)
+{
+#if defined(SO_DOMAIN) && defined(SO_COOKIE)
+    int domain;
+    int type;
+    int flags;
+    uint64_t observed_socket_cookie;
+    socklen_t length;
+    char byte;
+    ssize_t peeked;
+
+    if (fd < 0 || expected_socket_cookie == 0) {
+        return -EINVAL;
+    }
+    length = sizeof(domain);
+    if (getsockopt(fd, SOL_SOCKET, SO_DOMAIN, &domain, &length) != 0) {
+        return -errno;
+    }
+    if (length != sizeof(domain) || domain != AF_UNIX) {
+        return -EPROTOTYPE;
+    }
+    length = sizeof(type);
+    if (getsockopt(fd, SOL_SOCKET, SO_TYPE, &type, &length) != 0) {
+        return -errno;
+    }
+    if (length != sizeof(type) || type != SOCK_STREAM) {
+        return -EPROTOTYPE;
+    }
+    length = sizeof(observed_socket_cookie);
+    if (getsockopt(fd, SOL_SOCKET, SO_COOKIE, &observed_socket_cookie,
+                   &length) != 0) {
+        return -errno;
+    }
+    if (length != sizeof(observed_socket_cookie) ||
+        observed_socket_cookie != expected_socket_cookie) {
+        return -EKEYREJECTED;
+    }
+    flags = fcntl(fd, F_GETFL);
+    if (flags < 0) {
+        return -errno;
+    }
+    if ((flags & O_NONBLOCK) == 0) {
+        return -EINVAL;
+    }
+    do {
+        peeked = recv(fd, &byte, sizeof(byte), MSG_PEEK | MSG_DONTWAIT);
+    } while (peeked < 0 && errno == EINTR);
+    if (peeked >= 0 || (errno != EAGAIN && errno != EWOULDBLOCK)) {
+        return -ENOTCONN;
+    }
+    return 0;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_chr_socket_hot_fork_reconstruct_child_held(
+    QemuChrSocketHotForkChildBasis *basis, int replacement_fd,
+    uint64_t expected_socket_cookie)
+{
+    Error *local_err = NULL;
+    QIOChannelSocket *replacement;
+    SocketChardev *s;
+    Chardev *chardev;
+    int replacement_flags;
+    int replacement_dup;
+    int result;
+
+    if (!basis || !basis->prepared || !basis->chardev ||
+        !basis->frontend || basis->source_pid <= 0) {
+        return -EINVAL;
+    }
+    if (basis->source_pid == getpid() || basis->attempted) {
+        return -EPERM;
+    }
+    result = tcp_chr_hot_fork_validate_replacement_fd(
+        replacement_fd, expected_socket_cookie);
+    if (result != 0) {
+        return result;
+    }
+    replacement_flags = fcntl(replacement_fd, F_GETFL);
+    if (replacement_flags < 0) {
+        return -errno;
+    }
+    replacement_dup = qemu_dup_flags(replacement_fd, replacement_flags);
+    if (replacement_dup < 0) {
+        return -errno;
+    }
+    replacement = qio_channel_socket_new_fd(replacement_dup, &local_err);
+    if (!replacement) {
+        result = local_err ? -EIO : -errno;
+        error_free(local_err);
+        close(replacement_dup);
+        return result;
+    }
+    if (qio_channel_set_blocking(
+            QIO_CHANNEL(replacement), false, &local_err) != 0) {
+        result = local_err ? -EIO : -errno;
+        error_free(local_err);
+        object_unref(OBJECT(replacement));
+        return result;
+    }
+
+    chardev = basis->chardev;
+    s = SOCKET_CHARDEV(chardev);
+    qemu_mutex_lock(&chardev->chr_write_lock);
+    if (basis->source_pid == getpid() || basis->attempted ||
+        !tcp_chr_hot_fork_child_basis_objects_match_locked(
+            basis, chardev, basis->frontend, basis->context)) {
+        result = -ESTALE;
+        goto out;
+    }
+    if (replacement_fd == s->sioc->fd) {
+        result = -EINVAL;
+        goto out;
+    }
+
+    basis->attempted = true;
+    tcp_chr_free_connection(chardev);
+    basis->inherited_disposed = true;
+
+    tcp_chr_change_state(s, TCP_CHARDEV_STATE_CONNECTING);
+    tcp_chr_set_client_ioc_name(chardev, replacement);
+    s->ioc = QIO_CHANNEL(replacement);
+    object_ref(OBJECT(replacement));
+    s->sioc = replacement;
+    object_ref(OBJECT(replacement));
+    if (s->do_nodelay) {
+        qio_channel_set_delay(s->ioc, false);
+    }
+    if (s->listener) {
+        qio_net_listener_set_client_func_full(
+            s->listener, NULL, NULL, NULL, chardev->gcontext);
+    }
+    if (s->registered_yank) {
+        yank_register_function(CHARDEV_YANK_INSTANCE(chardev->label),
+                               char_socket_yank_iochannel,
+                               QIO_CHANNEL(replacement));
+    }
+    tcp_chr_change_state(s, TCP_CHARDEV_STATE_CONNECTED);
+    s->crucible_hot_fork_connection_generation++;
+    g_free(chardev->filename);
+    chardev->filename = qemu_chr_compute_filename(s);
+
+    basis->replacement_ioc = s->ioc;
+    basis->replacement_sioc = s->sioc;
+    basis->replacement_socket_cookie = expected_socket_cookie;
+    basis->replacement_connection_generation =
+        s->crucible_hot_fork_connection_generation;
+    basis->replacement_attached = true;
+    basis->input_held = true;
+    result = 0;
+out:
+    qemu_mutex_unlock(&chardev->chr_write_lock);
+    object_unref(OBJECT(replacement));
+    return result;
+}
