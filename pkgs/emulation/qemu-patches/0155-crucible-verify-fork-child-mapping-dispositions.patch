+static void test_mapping_table_rejects_unlisted_shared_mapping(void)
+{
+    QemuCrucibleHotForkDescriptorTableTransaction transaction = {
+        .parent_pid = getpid(),
+        .child_pid = getpid(),
+        .active = false,
+        .descriptors_applied = true,
+        .mappings_verified = false,
+    };
+    uintptr_t page_size = qemu_real_host_page_size();
+    void *mapping;
+
+    mapping = mmap(NULL, page_size, PROT_READ | PROT_WRITE,
+                   MAP_SHARED | MAP_ANONYMOUS, -1, 0);
+    g_assert_true(mapping != MAP_FAILED);
+
+    g_assert_cmpint(qemu_crucible_hot_fork_verify_mapping_table(
+                        &transaction, NULL, 0),
+                    ==, -EPERM);
+    g_assert_false(transaction.descriptors_applied);
+    g_assert_false(transaction.mappings_verified);
+    g_assert_cmpint(munmap(mapping, page_size), ==, 0);
+}
