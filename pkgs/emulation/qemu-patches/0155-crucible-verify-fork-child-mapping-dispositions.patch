+/**
+ * qemu_crucible_hot_fork_verify_mapping_table() - classify child mappings
+ * @transaction: exact child transaction after descriptor-table application
+ * @shared_mappings: sorted writable shared VMAs allowed in the child
+ * @shared_mapping_count: number of entries in @shared_mappings
+ *
+ * Streams the child's Linux /proc/self/maps file without heap allocation and
+ * rejects every writable shared VMA that is not an exact allowlist entry.  It
+ * also rejects every allowlist entry not present as one exact writable shared
+ * VMA.  Private mappings are admitted as copy-on-write and read-only shared
+ * mappings cannot mutate a sibling.  The allowlist must be strictly ordered,
+ * nonoverlapping, nonempty per entry, and contain at most
+ * QEMU_CRUCIBLE_HOT_FORK_MAX_SHARED_MAPPINGS entries.
+ *
+ * The scan accepts at most QEMU_CRUCIBLE_HOT_FORK_MAX_MAPPING_RECORDS records,
+ * QEMU_CRUCIBLE_HOT_FORK_MAX_MAPPING_RECORD_BYTES bytes per record, and
+ * QEMU_CRUCIBLE_HOT_FORK_MAX_MAPPING_BYTES bytes in aggregate.  It opens and
+ * closes its procfs descriptor synchronously while signals remain blocked and
+ * retains no path or kernel record bytes.
+ *
+ * Argument validation leaves the descriptor-applied transaction available for
+ * an exact retry.  Once scanning begins, the transaction is consumed.  Any
+ * failure then rejects the child; success records the complete mapping proof
+ * for future composition with child reinitialization.
+ *
+ * This primitive is intentionally unwired and does not acknowledge readiness
+ * bit 7 by itself.
+ *
+ * Returns zero after exact mapping classification, or a negative errno-style
+ * status on failure.
+ */
+int qemu_crucible_hot_fork_verify_mapping_table(
+    QemuCrucibleHotForkDescriptorTableTransaction *transaction,
+    const QemuCrucibleHotForkSharedMapping *shared_mappings,
+    size_t shared_mapping_count);
+
 #endif
