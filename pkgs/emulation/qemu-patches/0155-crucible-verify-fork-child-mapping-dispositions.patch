+static bool crucible_hot_fork_parse_hex(const char *bytes, size_t length,
+                                        uint64_t *value)
+{
+    uint64_t parsed = 0;
+
+    if (length == 0) {
+        return false;
+    }
+    for (size_t index = 0; index < length; index++) {
+        unsigned int digit;
+
+        if (bytes[index] >= '0' && bytes[index] <= '9') {
+            digit = bytes[index] - '0';
+        } else if (bytes[index] >= 'a' && bytes[index] <= 'f') {
+            digit = bytes[index] - 'a' + 10;
+        } else if (bytes[index] >= 'A' && bytes[index] <= 'F') {
+            digit = bytes[index] - 'A' + 10;
+        } else {
+            return false;
+        }
+        if (parsed > (UINT64_MAX - digit) / 16) {
+            return false;
+        }
+        parsed = parsed * 16 + digit;
+    }
+    *value = parsed;
+    return true;
+}
+
+static int crucible_hot_fork_parse_mapping_record(
+    const char *record,
+    size_t length,
+    uint64_t *start,
+    uint64_t *mapping_length,
+    bool *writable_shared)
+{
+    const char *range_end = memchr(record, ' ', length);
+    const char *separator;
+    const char *permissions;
+    const char *permissions_end;
+    uint64_t end;
+
+    if (!range_end || range_end == record) {
+        return -EPROTO;
+    }
+    separator = memchr(record, '-', range_end - record);
+    if (!separator || separator == record || separator + 1 == range_end ||
+        !crucible_hot_fork_parse_hex(record, separator - record, start) ||
+        !crucible_hot_fork_parse_hex(separator + 1,
+                                     range_end - separator - 1, &end) ||
+        *start >= end) {
+        return -EPROTO;
+    }
+
+    permissions = range_end;
+    while (permissions < record + length && *permissions == ' ') {
+        permissions++;
+    }
+    permissions_end = memchr(permissions, ' ', record + length - permissions);
+    if (!permissions_end || permissions_end - permissions != 4 ||
+        (permissions[0] != 'r' && permissions[0] != '-') ||
+        (permissions[1] != 'w' && permissions[1] != '-') ||
+        (permissions[2] != 'x' && permissions[2] != '-') ||
+        (permissions[3] != 'p' && permissions[3] != 's')) {
+        return -EPROTO;
+    }
+
+    *mapping_length = end - *start;
+    *writable_shared = permissions[1] == 'w' && permissions[3] == 's';
+    return 0;
+}
+
+static bool crucible_hot_fork_shared_mapping_table_is_valid(
+    const QemuCrucibleHotForkSharedMapping *mappings,
+    size_t mapping_count)
+{
+    uint64_t prior_end = 0;
+
+    if ((mapping_count != 0 && !mappings) ||
+        mapping_count > QEMU_CRUCIBLE_HOT_FORK_MAX_SHARED_MAPPINGS) {
+        return false;
+    }
+    for (size_t index = 0; index < mapping_count; index++) {
+        uint64_t end;
+
+        if (mappings[index].length == 0 ||
+            mappings[index].start > UINT64_MAX - mappings[index].length) {
+            return false;
+        }
+        end = mappings[index].start + mappings[index].length;
+        if (index > 0 && mappings[index].start < prior_end) {
+            return false;
+        }
+        prior_end = end;
+    }
+    return true;
+}
+
+static int crucible_hot_fork_match_mapping_record(
+    const char *record,
+    size_t length,
+    const QemuCrucibleHotForkSharedMapping *mappings,
+    size_t mapping_count,
+    size_t *mapping_index)
+{
+    uint64_t start;
+    uint64_t mapping_length;
+    bool writable_shared;
+    int result = crucible_hot_fork_parse_mapping_record(
+        record, length, &start, &mapping_length, &writable_shared);
+
+    if (result != 0 || !writable_shared) {
+        return result;
+    }
+    if (*mapping_index >= mapping_count ||
+        mappings[*mapping_index].start != start ||
+        mappings[*mapping_index].length != mapping_length) {
+        return -EPERM;
+    }
+    (*mapping_index)++;
+    return 0;
+}
+
+static int crucible_hot_fork_scan_mapping_table(
+    const QemuCrucibleHotForkSharedMapping *mappings,
+    size_t mapping_count)
+{
+    char input[4096];
+    char record[QEMU_CRUCIBLE_HOT_FORK_MAX_MAPPING_RECORD_BYTES];
+    size_t mapping_index = 0;
+    size_t record_count = 0;
+    size_t record_length = 0;
+    size_t total_bytes = 0;
+    int maps_fd;
+    int result = 0;
+
+    maps_fd = open("/proc/self/maps", O_RDONLY | O_CLOEXEC);
+    if (maps_fd < 0) {
+        return -errno;
+    }
+    for (;;) {
+        ssize_t length = read(maps_fd, input, sizeof(input));
+
+        if (length < 0) {
+            if (errno == EINTR) {
+                continue;
+            }
+            result = -errno;
+            break;
+        }
+        if (length == 0) {
+            if (record_length != 0) {
+                record_count++;
+                if (record_count >
+                    QEMU_CRUCIBLE_HOT_FORK_MAX_MAPPING_RECORDS) {
+                    result = -E2BIG;
+                } else {
+                    result = crucible_hot_fork_match_mapping_record(
+                        record, record_length, mappings, mapping_count,
+                        &mapping_index);
+                }
+            }
+            break;
+        }
+        if ((size_t)length >
+            QEMU_CRUCIBLE_HOT_FORK_MAX_MAPPING_BYTES - total_bytes) {
+            result = -E2BIG;
+            break;
+        }
+        total_bytes += length;
+
+        for (ssize_t index = 0; index < length; index++) {
+            if (input[index] == '\n') {
+                record_count++;
+                if (record_count >
+                    QEMU_CRUCIBLE_HOT_FORK_MAX_MAPPING_RECORDS) {
+                    result = -E2BIG;
+                    break;
+                }
+                result = crucible_hot_fork_match_mapping_record(
+                    record, record_length, mappings, mapping_count,
+                    &mapping_index);
+                record_length = 0;
+                if (result != 0) {
+                    break;
+                }
+            } else {
+                if (record_length == sizeof(record)) {
+                    result = -E2BIG;
+                    break;
+                }
+                record[record_length++] = input[index];
+            }
+        }
+        if (result != 0) {
+            break;
+        }
+    }
+    if (close(maps_fd) < 0 && result == 0) {
+        result = -errno;
+    }
+    if (result == 0 && (record_count == 0 || mapping_index != mapping_count)) {
+        result = -EPERM;
+    }
+    return result;
+}
+
+int qemu_crucible_hot_fork_verify_mapping_table(
+    QemuCrucibleHotForkDescriptorTableTransaction *transaction,
+    const QemuCrucibleHotForkSharedMapping *shared_mappings,
+    size_t shared_mapping_count)
+{
+    int result;
+
+    if (!transaction) {
+        return -EINVAL;
+    }
+    if (transaction->active || !transaction->descriptors_applied ||
+        transaction->mappings_verified || transaction->parent_pid <= 1 ||
+        transaction->child_pid != getpid()) {
+        return -EPERM;
+    }
+    if (!crucible_hot_fork_shared_mapping_table_is_valid(
+            shared_mappings, shared_mapping_count)) {
+        return -EINVAL;
+    }
+
+    transaction->descriptors_applied = false;
+    result = crucible_hot_fork_scan_mapping_table(shared_mappings,
+                                                  shared_mapping_count);
+    if (result == 0) {
+        transaction->mappings_verified = true;
+    }
     return result;
 }
