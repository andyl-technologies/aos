+static void test_source_mapping_binding_rounds_exact_lengths_to_pages(void)
+{
+    QemuCrucibleHotForkSourceMapping mapping = { 0 };
+    struct stat metadata;
+    uint64_t page_size = qemu_real_host_page_size();
+    uint64_t exact_length = page_size + 1;
+    void *source;
+    int backing;
+
+    backing = memfd_create(
+        "crucible-hot-fork-unaligned-source-mapping", MFD_CLOEXEC);
+    g_assert_cmpint(backing, >=, 0);
+    g_assert_cmpint(ftruncate(backing, exact_length), ==, 0);
+    source = mmap(NULL, exact_length, PROT_READ | PROT_WRITE, MAP_SHARED,
+                  backing, 0);
+    g_assert_true(source != MAP_FAILED);
+    g_assert_cmpint(fstat(backing, &metadata), ==, 0);
+
+    /* The exact protocol length binds the whole-page VMA that carries it. */
+    g_assert_cmpint(qemu_crucible_hot_fork_find_source_mapping(
+                        metadata.st_dev, metadata.st_ino, exact_length,
+                        &mapping),
+                    ==, 0);
+    g_assert_cmpuint(mapping.start, ==, (uintptr_t)source);
+    g_assert_cmpuint(mapping.length, ==, 2 * page_size);
+    g_assert_cmpuint(mapping.offset, ==, 0);
+    /* A shorter declared length names a different extent and is ambiguous. */
+    g_assert_cmpint(qemu_crucible_hot_fork_find_source_mapping(
+                        metadata.st_dev, metadata.st_ino, page_size,
+                        &mapping),
+                    ==, -EPERM);
+    g_assert_cmpint(qemu_crucible_hot_fork_find_source_mapping(
+                        metadata.st_dev, metadata.st_ino, 0, &mapping),
+                    ==, -EINVAL);
+
+    g_assert_cmpint(munmap(source, exact_length), ==, 0);
+    close(backing);
+}
