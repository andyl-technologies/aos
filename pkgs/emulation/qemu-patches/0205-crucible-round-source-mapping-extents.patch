+/* Shared mappings span whole pages; protocol region lengths are exact. */
+static uint64_t crucible_hot_fork_mapping_extent(uint64_t length)
+{
+    uint64_t page_size = qemu_real_host_page_size();
+
+    if (length > UINT64_MAX - (page_size - 1)) {
+        return UINT64_MAX;
+    }
+    return QEMU_ALIGN_UP(length, page_size);
+}
