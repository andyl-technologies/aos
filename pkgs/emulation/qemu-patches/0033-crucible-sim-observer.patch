+/**
+ * qemu_plugin_register_sim_shmem_observer_cb() - observe exact sim boundaries
+ * @observe_icount_cb: callback invoked after a sim vCPU execution window
+ * @userdata: opaque pointer passed to @observe_icount_cb
+ *
+ * This observation-only callback is independent of the single scheduler-owned
+ * shmem dispatch registration. It runs after icount processing and before the
+ * RR loop resumes, so an auxiliary plugin can sample post-execution CPU, RAM,
+ * and device-I/O state without replacing or perturbing the control plugin.
+ */
+QEMU_PLUGIN_API
+void qemu_plugin_register_sim_shmem_observer_cb(
+    qemu_plugin_sim_shmem_publish_icount_cb_t observe_icount_cb,
+    void *userdata);
+
