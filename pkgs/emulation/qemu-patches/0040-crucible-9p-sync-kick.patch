@@ -2417,6 +2418,15 @@ out:
 
 static int coroutine_fn raw_thread_pool_submit(ThreadPoolFunc func, void *arg)
 {
+    /*
+     * QEMU's icount mode owns logical time.  Run regular file I/O at the
+     * request's submission icount so a host thread-pool completion cannot race
+     * repeated logical-time bottom halves or strand an unmodified guest.
+     * Non-icount accelerators retain QEMU's normal asynchronous thread pool.
+     */
+    if (icount_enabled()) {
+        return func(arg);
+    }
     return thread_pool_submit_co(func, arg);
 }
 
