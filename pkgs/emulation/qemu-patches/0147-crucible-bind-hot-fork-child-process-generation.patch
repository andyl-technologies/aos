diff --git a/plugins/crucible-fault-lifecycle.c b/plugins/crucible-fault-lifecycle.c
index e8b82984c..60a868d9e 100644
--- a/plugins/crucible-fault-lifecycle.c
+++ b/plugins/crucible-fault-lifecycle.c
@@ -166,6 +166,28 @@ static bool crucible_lifecycle_mode(void)
            icount_enabled() == ICOUNT_PRECISE;
 }
 
+uint64_t qemu_crucible_fault_lifecycle_process_generation(void)
+{
+    return crucible_lifecycle_process_generation;
+}
+
+int qemu_crucible_fault_lifecycle_rebind_process_generation(
+    uint64_t parent_process_generation,
+    uint64_t child_process_generation)
+{
+    if (!crucible_lifecycle_mode() || parent_process_generation == 0 ||
+        parent_process_generation == UINT64_MAX ||
+        child_process_generation != parent_process_generation + 1) {
+        return -EINVAL;
+    }
+    if (crucible_lifecycle_process_generation != parent_process_generation ||
+        crucible_lifecycle_terminal_transition != 0) {
+        return -EPROTO;
+    }
+    crucible_lifecycle_process_generation = child_process_generation;
+    return 0;
+}
