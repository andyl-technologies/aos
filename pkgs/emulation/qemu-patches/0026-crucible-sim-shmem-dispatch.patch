+#ifndef TCG_ACCEL_OPS_SIM_SHMEM_H
+#define TCG_ACCEL_OPS_SIM_SHMEM_H
+
+void crucible_sim_shmem_publish_current_icount(uint64_t current_icount);
+uint64_t crucible_sim_shmem_current_icount(void);
+uint64_t crucible_sim_shmem_max_advance_icount(void);
+bool crucible_sim_shmem_dispatch_registered(void);
+int64_t crucible_sim_shmem_clamp_cpu_budget(uint64_t current_icount,
+                                            int64_t cpu_budget);
+bool crucible_sim_shmem_may_advance_to(uint64_t candidate_icount);
+
+#endif /* TCG_ACCEL_OPS_SIM_SHMEM_H */
