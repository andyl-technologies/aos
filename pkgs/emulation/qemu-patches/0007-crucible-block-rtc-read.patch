diff --git a/system/rtc.c b/system/rtc.c
index 56951288c..e360fd6b0 100644
--- a/system/rtc.c
+++ b/system/rtc.c
@@ -44,8 +44,34 @@ static int rtc_realtime_clock_offset; /* used only with QEMU_CLOCK_REALTIME */
 static int rtc_host_datetime_offset = -1; /* valid & used only with
                                              RTC_BASE_DATETIME */
 QEMUClockType rtc_clock;
+static bool crucible_sim_rtc_virtual_clock;
 /***********************************************************/
 /* RTC reference time/date access */
+
+void qemu_rtc_enable_sim_virtual_clock(void)
+{
+    /*
+     * Force all RTC-device uses of the global rtc_clock onto virtual time.
+     * This covers direct guest-read paths such as mc146818rtc in addition to
+     * the qemu_get_timedate/qemu_timedate_diff helpers below.
+     */
+    crucible_sim_rtc_virtual_clock = true;
+    rtc_clock = QEMU_CLOCK_VIRTUAL;
+}
+
+static QEMUClockType crucible_guest_rtc_clock(void)
+{
+    if (crucible_sim_rtc_virtual_clock) {
+        /*
+         * Sim mode exposes wall-clock and RTC reads as fixed epoch plus
+         * icount-derived virtual time, never host wall-clock.
+         */
+        return QEMU_CLOCK_VIRTUAL;
+    }
+
+    return rtc_clock;
+}
+
 static time_t qemu_ref_timedate(QEMUClockType clock)
 {
     time_t value = qemu_clock_get_ms(clock) / 1000;
@@ -69,7 +95,7 @@ static time_t qemu_ref_timedate(QEMUClockType clock)
 
 void qemu_get_timedate(struct tm *tm, time_t offset)
 {
-    time_t ti = qemu_ref_timedate(rtc_clock);
+    time_t ti = qemu_ref_timedate(crucible_guest_rtc_clock());
 
     ti += offset;
 
@@ -104,7 +130,7 @@ time_t qemu_timedate_diff(struct tm *tm)
         abort();
     }
 
-    return seconds - qemu_ref_timedate(QEMU_CLOCK_HOST);
+    return seconds - qemu_ref_timedate(crucible_guest_rtc_clock());
 }
 
