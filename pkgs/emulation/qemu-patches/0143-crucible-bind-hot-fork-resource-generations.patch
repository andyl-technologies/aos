+static CrucibleHotForkTemplateResourceStageState *
+crucible_hot_fork_template_resource_stage_report(void)
+{
+    CrucibleHotForkTemplateResourceStageState *report =
+        g_new0(CrucibleHotForkTemplateResourceStageState, 1);
+    bool resources_staged = crucible_hot_fork_private_ring_stage.staged ||
+        crucible_hot_fork_plugin_endpoint_stage.staged;
+
+    assert(!crucible_hot_fork_plugin_endpoint_stage.staged ||
+           crucible_hot_fork_private_ring_stage.staged);
+    assert(!crucible_hot_fork_plugin_endpoint_stage.staged ||
+           crucible_hot_fork_plugin_endpoint_stage.private_ring_generation ==
+               crucible_hot_fork_private_ring_stage.generation);
+    assert(!crucible_hot_fork_plugin_endpoint_stage.staged ||
+           crucible_hot_fork_plugin_endpoint_stage.template_generation ==
+               crucible_hot_fork_private_ring_stage.template_generation);
+    if (resources_staged &&
+        crucible_hot_fork_private_ring_stage.template_generation != 0) {
+        assert(crucible_hot_fork_private_ring_stage.template_generation ==
+               crucible_hot_fork_template_generation);
+    }
+
+    report->schema_version = 1;
+    report->template_generation = resources_staged ?
+        crucible_hot_fork_private_ring_stage.template_generation : 0;
+    report->private_ring_staged =
+        crucible_hot_fork_private_ring_stage.staged;
+    report->private_ring_generation =
+        crucible_hot_fork_private_ring_stage.generation;
+    report->plugin_endpoints_staged =
+        crucible_hot_fork_plugin_endpoint_stage.staged;
+    report->plugin_endpoint_generation =
+        crucible_hot_fork_plugin_endpoint_stage.generation;
+    report->plugin_private_ring_generation =
+        crucible_hot_fork_plugin_endpoint_stage.private_ring_generation;
+    report->transaction_bound = crucible_hot_fork_template_active &&
+        resources_staged && report->template_generation ==
+            crucible_hot_fork_template_generation;
+    report->readiness_proof_acknowledged = false;
+    return report;
+}
