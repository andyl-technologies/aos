+##
+# @CrucibleHotForkTemplateResourceStageState:
+#
+# Atomic generation binding for branch-private resources retained beside one
+# template transaction. This state does not complete a child disposition or
+# acknowledge a hot-fork readiness proof.
+#
+# @schema-version: resource-stage binding contract version, currently 1
+#
+# @template-generation: exact template generation that originally admitted the
+#     retained resources, or zero when none are staged or they were staged
+#     outside a template transaction
+#
+# @private-ring-staged: whether one private-ring descriptor is retained
+#
+# @private-ring-generation: current private-ring mutation generation
+#
+# @plugin-endpoints-staged: whether one plugin endpoint pair is retained
+#
+# @plugin-endpoint-generation: current endpoint-pair mutation generation
+#
+# @plugin-private-ring-generation: private-ring generation captured by the
+#     retained endpoints, or zero when no endpoint pair is retained
+#
+# @transaction-bound: whether every retained resource belongs to the current
+#     active template generation
+#
+# @readiness-proof-acknowledged: always false; exact generation binding alone
+#     acknowledges no hot-fork readiness proof
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'struct': 'CrucibleHotForkTemplateResourceStageState',
+  'data': { 'schema-version': 'uint32',
+            'template-generation': 'uint64',
+            'private-ring-staged': 'bool',
+            'private-ring-generation': 'uint64',
+            'plugin-endpoints-staged': 'bool',
+            'plugin-endpoint-generation': 'uint64',
+            'plugin-private-ring-generation': 'uint64',
+            'transaction-bound': 'bool',
+            'readiness-proof-acknowledged': 'bool' } }
+
