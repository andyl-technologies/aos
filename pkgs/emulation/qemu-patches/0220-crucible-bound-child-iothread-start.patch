diff --git a/include/qemu/crucible-hot-fork-child.h b/include/qemu/crucible-hot-fork-child.h
index 91abbdf4a..af6294231 100644
--- a/include/qemu/crucible-hot-fork-child.h
+++ b/include/qemu/crucible-hot-fork-child.h
@@ -383,7 +383,10 @@ int qemu_crucible_hot_fork_apply_child_resources(
  * preconditions of the application record 11 arguments, 12 plan and
  * descriptor transaction state, 13 runtime transaction state, 14 plan
  * validity, 15 plugin reinitializer, 16 QMP reinitializer, 17 console
- * reinitializer.  Zero means the application has not started.
+ * reinitializer.  A rebuilt monitor iothread records 70 when it never
