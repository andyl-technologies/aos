  */
 void qemu_crucible_hot_fork_note_child_detail(unsigned int detail);
 unsigned int qemu_crucible_hot_fork_child_detail(void);
diff --git a/iothread.c b/iothread.c
index 75057e61f..121873604 100644
--- a/iothread.c
+++ b/iothread.c
@@ -12,6 +12,7 @@
  */
 
 #include "qemu/osdep.h"
+#include "qemu/crucible-hot-fork-child.h"
 #ifdef CONFIG_LINUX
 #include <sys/syscall.h>
 #endif
@@ -39,25 +40,51 @@
 #define IOTHREAD_POLL_MAX_NS_DEFAULT 0ULL
 #endif
 
+/*
+ * Progress of a monitor iothread restarted in a hot-fork child, recorded
+ * for the child's exit status while its coordinator waits for the start
+ * semaphore: 71 entered, 72 disposition set, 73 RCU registered, 74 context
+ * pushed, 75 started.  A coordinator that times out keeps the last record.
+ */
+#define IOTHREAD_HOT_FORK_CHILD_START_DETAIL 71
+#define IOTHREAD_HOT_FORK_CHILD_START_TIMEOUT_MS 10000
+
+static void iothread_hot_fork_note_child_progress(IOThread *iothread,
+                                                  unsigned int step)
+{
+#ifdef CONFIG_LINUX
+    if (iothread->crucible_hot_fork_monitor &&
+        qemu_crucible_hot_fork_child_detail() != 0) {
+        qemu_crucible_hot_fork_note_child_detail(
+            IOTHREAD_HOT_FORK_CHILD_START_DETAIL + step);
+    }
+#endif
+}
+
 static void *iothread_run(void *opaque)
 {
     IOThread *iothread = opaque;
 
+    iothread_hot_fork_note_child_progress(iothread, 0);
 #ifdef CONFIG_POSIX
     qemu_thread_hot_fork_set_current_disposition(
         iothread->crucible_hot_fork_monitor ?
         QEMU_THREAD_HOT_FORK_MONITOR_RESTART :
         QEMU_THREAD_HOT_FORK_UNCLASSIFIED_AIO);
 #endif
+    iothread_hot_fork_note_child_progress(iothread, 1);
     rcu_register_thread();
+    iothread_hot_fork_note_child_progress(iothread, 2);
     /*
      * g_main_context_push_thread_default() must be called before anything
      * in this new thread uses glib.
      */
     g_main_context_push_thread_default(iothread->worker_context);
     qemu_set_current_aio_context(iothread->ctx);
+    iothread_hot_fork_note_child_progress(iothread, 3);
     iothread->thread_id = qemu_get_thread_id();
     qemu_sem_post(&iothread->init_done_sem);
+    iothread_hot_fork_note_child_progress(iothread, 4);
 
     while (iothread->running) {
         /*
@@ -469,7 +496,20 @@ int iothread_hot_fork_reconstruct_child(
                                       OBJECT(iothread)));
     qemu_thread_create(&iothread->thread, thread_name, iothread_run,
                        iothread, QEMU_THREAD_JOINABLE);
-    qemu_sem_wait(&iothread->init_done_sem);
+    /*
+     * The replacement announces itself within its first instructions; a
+     * bounded wait turns a thread that never does into a named child failure
+     * instead of a silent hang, and its recorded progress survives.
+     */
+    if (qemu_sem_timedwait(&iothread->init_done_sem,
+                           IOTHREAD_HOT_FORK_CHILD_START_TIMEOUT_MS) != 0) {
+        if (qemu_crucible_hot_fork_child_detail() <
+            IOTHREAD_HOT_FORK_CHILD_START_DETAIL) {
+            qemu_crucible_hot_fork_note_child_detail(
+                IOTHREAD_HOT_FORK_CHILD_START_DETAIL - 1);
+        }
+        return -ETIMEDOUT;
+    }
     assert(iothread->thread_id > 0);
     *replacement_thread_id = iothread->thread_id;
     return 0;
