diff --git a/system/main.c b/system/main.c
--- a/system/main.c
+++ b/system/main.c
@@ -41,6 +41,122 @@
 #include <CoreFoundation/CoreFoundation.h>
 #endif
 
+static uint8_t crucible_process_argv_digest[32];
+static bool crucible_process_argv_digest_valid;
+static uint64_t crucible_process_argc;
+static uint64_t crucible_process_argv_raw_bytes;
+
+static void crucible_argv_hash_u64(GChecksum *checksum, uint64_t value)
+{
+    uint8_t encoded[8];
+
+    for (size_t i = 0; i < sizeof(encoded); i++) {
+        encoded[sizeof(encoded) - i - 1] = value & 0xff;
+        value >>= 8;
+    }
+    g_checksum_update(checksum, encoded, sizeof(encoded));
+}
+
+static void crucible_argv_hash_framed(GChecksum *checksum,
+                                      const void *bytes, size_t length)
+{
+    crucible_argv_hash_u64(checksum, length);
+    if (length != 0) {
+        g_checksum_update(checksum, bytes, length);
+    }
+}
+
+static void crucible_argv_hash_segment(GChecksum *checksum,
+                                       const char *label,
+                                       const void *bytes, size_t length)
+{
+    crucible_argv_hash_framed(checksum, label, strlen(label));
+    crucible_argv_hash_framed(checksum, bytes, length);
+}
+
+static void crucible_capture_process_argv(int argc, char **argv)
+{
+    g_autoptr(GChecksum) checksum = NULL;
+    gsize digest_length = sizeof(crucible_process_argv_digest);
+    uint64_t argc_u64;
+    uint8_t encoded[8];
+
+    memset(crucible_process_argv_digest, 0,
+           sizeof(crucible_process_argv_digest));
+    crucible_process_argv_digest_valid = false;
+    crucible_process_argc = 0;
+    crucible_process_argv_raw_bytes = 0;
+    if (argc <= 0 || !argv || !argv[0]) {
+        return;
+    }
+    checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    if (!checksum) {
+        return;
+    }
+    crucible_argv_hash_framed(checksum,
+                              "crucible.qemu.raw-unix-argv.v2",
+                              strlen("crucible.qemu.raw-unix-argv.v2"));
+    crucible_process_argc = argc;
+    for (int index = 0; index < argc; index++) {
+        size_t length;
+
+        if (!argv[index]) {
+            return;
+        }
+        length = strlen(argv[index]);
+        if (UINT64_MAX - crucible_process_argv_raw_bytes < length) {
+            return;
+        }
+        crucible_process_argv_raw_bytes += length;
+    }
+    argc_u64 = argc;
+    for (size_t i = 0; i < sizeof(encoded); i++) {
+        encoded[sizeof(encoded) - i - 1] = argc_u64 & 0xff;
+        argc_u64 >>= 8;
+    }
+    crucible_argv_hash_segment(checksum, "argc", encoded, sizeof(encoded));
+    for (int index = 0; index < argc; index++) {
+        uint64_t index_u64 = index;
+        for (size_t i = 0; i < sizeof(encoded); i++) {
+            encoded[sizeof(encoded) - i - 1] = index_u64 & 0xff;
+            index_u64 >>= 8;
+        }
+        crucible_argv_hash_segment(checksum, "argv-index",
+                                   encoded, sizeof(encoded));
+        crucible_argv_hash_segment(checksum, "argv-value",
+                                   argv[index], strlen(argv[index]));
+    }
+    g_checksum_get_digest(checksum, crucible_process_argv_digest,
+                          &digest_length);
+    crucible_process_argv_digest_valid = digest_length == 32;
+    if (!crucible_process_argv_digest_valid) {
+        memset(crucible_process_argv_digest, 0,
+               sizeof(crucible_process_argv_digest));
+    }
+}
+
+int qemu_crucible_process_argv_attestation(uint32_t *version_out,
+                                           uint64_t *argc_out,
+                                           uint64_t *raw_bytes_out,
+                                           uint8_t digest_out[32])
+{
+    if (!version_out || !argc_out || !raw_bytes_out || !digest_out) {
+        return -EINVAL;
+    }
+    *version_out = 0;
+    *argc_out = 0;
+    *raw_bytes_out = 0;
+    memset(digest_out, 0, 32);
+    if (!crucible_process_argv_digest_valid) {
+        return -ENODATA;
+    }
+    *version_out = 2;
+    *argc_out = crucible_process_argc;
+    *raw_bytes_out = crucible_process_argv_raw_bytes;
+    memcpy(digest_out, crucible_process_argv_digest, 32);
+    return 0;
+}
