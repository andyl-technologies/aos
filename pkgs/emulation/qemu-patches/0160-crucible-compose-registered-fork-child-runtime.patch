diff --git a/system/crucible-hot-fork-plugin-child.c b/system/crucible-hot-fork-plugin-child.c
new file mode 100644
index 000000000..b9a01330b
--- /dev/null
+++ b/system/crucible-hot-fork-plugin-child.c
@@ -0,0 +1,128 @@
+/*
+ * Crucible registered plugin fork-child reinitializer
+ *
+ * Copyright (c) Andyl, Inc.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+
+#include "system/crucible-hot-fork-plugin-child.h"
+
+bool qemu_crucible_hot_fork_plugin_child_plan_valid(
+    const struct qemu_plugin_crucible_hot_fork_child_plan *plan)
+{
+    return plan &&
+        plan->schema_version ==
+            QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PLAN_VERSION &&
+        plan->struct_size == sizeof(*plan) && plan->flags == 0 &&
+        plan->reserved == 0 && plan->reserved_fd == -1 &&
+        plan->parent_process_generation != 0 &&
+        plan->parent_process_generation != UINT64_MAX &&
+        plan->child_process_generation ==
+            plan->parent_process_generation + 1 &&
+        plan->template_generation != 0 &&
+        plan->private_ring_generation != 0 &&
+        plan->plugin_endpoint_generation != 0 &&
+        plan->plugin_barrier_generation != 0 &&
+        plan->control_socket_cookie != 0 && plan->wake_eventfd_id != 0 &&
+        plan->private_ring_fd >= 0 && plan->control_fd >= 0 &&
+        plan->wake_fd >= 0 && plan->control_fd != plan->wake_fd &&
+        plan->private_ring_fd != plan->control_fd &&
+        plan->private_ring_fd != plan->wake_fd &&
+        plan->shmem_inode != 0 && plan->shmem_length != 0 &&
+        plan->source_mapping_start != 0 &&
+        plan->source_mapping_length == plan->shmem_length &&
+        plan->source_mapping_offset == 0 &&
+        QEMU_IS_ALIGNED(plan->source_mapping_start,
+                        qemu_real_host_page_size()) &&
+        QEMU_IS_ALIGNED(plan->source_mapping_length,
+                        qemu_real_host_page_size()) &&
+        plan->source_mapping_start <= UINTPTR_MAX &&
+        plan->source_mapping_length <= SIZE_MAX &&
+        plan->source_mapping_start <=
+            UINTPTR_MAX - plan->source_mapping_length;
+}
+
+int qemu_crucible_hot_fork_prepare_plugin_child_reinitializer(
+    QemuCrucibleHotForkPluginChildReinitializer *reinitializer,
+    const struct qemu_plugin_crucible_hot_fork_child_plan *plan)
+{
+    if (!reinitializer ||
+        !qemu_crucible_hot_fork_plugin_child_plan_valid(plan)) {
+        return -EINVAL;
+    }
+
+    *reinitializer = (QemuCrucibleHotForkPluginChildReinitializer) {
+        .plan = *plan,
+        .prepared = true,
+    };
+    return 0;
+}
+
+static bool crucible_hot_fork_plugin_child_status_matches(
+    const QemuCrucibleHotForkPluginChildReinitializer *reinitializer)
+{
+    const struct qemu_plugin_crucible_hot_fork_child_plan *plan =
+        &reinitializer->plan;
+    const QemuPluginCrucibleHotForkChildRuntimeInventory *inventory =
+        &reinitializer->inventory;
+    const struct qemu_plugin_crucible_hot_fork_child_status *status =
+        &inventory->status;
+    const uint32_t expected_flags =
+        QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_CALLBACKS_HELD |
+        QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_MAPPING_INSTALLED |
+        QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_WORKERS_READY;
+
+    return inventory->registered && inventory->manifest_consistent &&
+        inventory->generation != 0 && inventory->plugin_id != 0 &&
+        status->schema_version ==
+            QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_STATUS_VERSION &&
+        status->struct_size == sizeof(*status) &&
+        status->flags == expected_flags &&
+        status->phase ==
+            QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PHASE_WORKERS_HELD &&
+        status->parent_process_generation ==
+            plan->parent_process_generation &&
+        status->child_process_generation == plan->child_process_generation &&
+        status->template_generation == plan->template_generation &&
+        status->private_ring_generation == plan->private_ring_generation &&
+        status->plugin_endpoint_generation ==
+            plan->plugin_endpoint_generation &&
+        status->plugin_barrier_generation ==
+            plan->plugin_barrier_generation &&
+        status->control_socket_cookie == plan->control_socket_cookie &&
+        status->wake_eventfd_id == plan->wake_eventfd_id &&
+        status->source_mapping_start == plan->source_mapping_start &&
+        status->source_mapping_length == plan->source_mapping_length &&
+        status->source_mapping_offset == plan->source_mapping_offset &&
+        status->worker_mask == plan->worker_mask &&
+        status->parked_worker_mask == status->worker_mask &&
+        status->pending_worker_mask == 0 &&
+        status->worker_operations_in_flight == 0;
+}
+
+int qemu_crucible_hot_fork_reinitialize_plugin_child(void *opaque)
+{
+    QemuCrucibleHotForkPluginChildReinitializer *reinitializer = opaque;
+    int result;
+
+    if (!reinitializer || !reinitializer->prepared ||
+        reinitializer->attempted) {
+        return -EPERM;
+    }
+
+    reinitializer->attempted = true;
+    result = qemu_plugin_crucible_hot_fork_child_runtime(
+        QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_INITIALIZE,
+        &reinitializer->plan, &reinitializer->inventory);
+    if (result != 0) {
+        return result;
+    }
+    if (!crucible_hot_fork_plugin_child_status_matches(reinitializer)) {
+        return -EPROTO;
+    }
+
+    reinitializer->initialized = true;
+    return 0;
+}
