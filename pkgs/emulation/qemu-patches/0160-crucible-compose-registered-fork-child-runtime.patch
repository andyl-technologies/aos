+/*
+ * Crucible registered plugin fork-child reinitializer
+ *
+ * Copyright (c) Andyl, Inc.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef QEMU_CRUCIBLE_HOT_FORK_PLUGIN_CHILD_H
+#define QEMU_CRUCIBLE_HOT_FORK_PLUGIN_CHILD_H
+
+#include "qemu/crucible-hot-fork-plugin.h"
+
+typedef struct QemuCrucibleHotForkPluginChildReinitializer {
+    struct qemu_plugin_crucible_hot_fork_child_plan plan;
+    QemuPluginCrucibleHotForkChildRuntimeInventory inventory;
+    bool prepared;
+    bool attempted;
+    bool initialized;
+} QemuCrucibleHotForkPluginChildReinitializer;
+
+/**
+ * qemu_crucible_hot_fork_plugin_child_plan_valid() - validate one plan
+ * @plan: immutable registered plugin child-runtime plan
+ *
+ * Applies the complete process-independent shape and geometry checks shared by
+ * the registered runtime entry point and the child transaction adapter.
+ * Process-local resource identity remains authenticated by the registered
+ * runtime immediately before mutation.
+ *
+ * Returns true exactly when @plan has the closed current schema and valid
+ * fixed-layout resource geometry.
+ */
+bool qemu_crucible_hot_fork_plugin_child_plan_valid(
+    const struct qemu_plugin_crucible_hot_fork_child_plan *plan);
+
+/**
+ * qemu_crucible_hot_fork_prepare_plugin_child_reinitializer() - copy a plan
+ * @reinitializer: caller-owned storage inherited by the future fork child
+ * @plan: immutable registered plugin child-runtime plan
+ *
+ * Validates and copies the complete plan before a destructive child resource
+ * transaction.  Repreparing the caller-owned storage before fork replaces the
+ * prior plan.  Once child initialization is attempted, that inherited copy is
+ * one-shot and cannot be retried.
+ *
+ * Returns zero after exact preparation or -EINVAL for an invalid argument or
+ * plan.
+ */
+int qemu_crucible_hot_fork_prepare_plugin_child_reinitializer(
+    QemuCrucibleHotForkPluginChildReinitializer *reinitializer,
+    const struct qemu_plugin_crucible_hot_fork_child_plan *plan);
+
+/**
+ * qemu_crucible_hot_fork_reinitialize_plugin_child() - invoke held runtime
+ * @opaque: prepared QemuCrucibleHotForkPluginChildReinitializer
+ *
+ * Invokes the process-global registered plugin runtime exactly once with the
+ * copied initialization plan.  Success additionally requires the registered
+ * runtime to echo the exact plan in a complete workers-held state: callbacks
+ * remain closed, the private mapping is installed, and every sealed worker is
+ * parked without pending local work.  This function matches
+ * QemuCrucibleHotForkChildReinitializer and is intended to run only inside the
+ * authenticated destructive child resource transaction.
+ *
+ * Returns zero after exact held initialization, -EPERM when the context is not
+ * prepared or was already attempted, -EPROTO for a contradictory successful
+ * runtime response, or the registered runtime's negative errno-style failure.
+ */
+int qemu_crucible_hot_fork_reinitialize_plugin_child(void *opaque);
+
+#endif
