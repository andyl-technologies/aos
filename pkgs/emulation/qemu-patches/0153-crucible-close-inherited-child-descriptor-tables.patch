+/**
+ * qemu_crucible_hot_fork_apply_descriptor_table() - close inherited FDs
+ * @identity: mutable parent identity captured before fork
+ * @replacements: exact control and wake source-to-target descriptor pairs
+ * @retained_fds: sorted final descriptor table retained by the child
+ * @retained_fd_count: number of entries in @retained_fds
+ * @verify: callback that authenticates the complete installed table
+ * @opaque: caller-owned value passed to @verify
+ *
+ * Authenticates the immediate child, replaces both endpoint slots, and uses
+ * Linux close_range(2) to close every descriptor not named by the final table.
+ * The table must be strictly increasing, contain both replacement targets,
+ * omit both replacement sources and the parent pidfd, and contain at most
+ * QEMU_CRUCIBLE_HOT_FORK_MAX_RETAINED_DESCRIPTORS entries.  The verifier runs
+ * only after every close range succeeds and every retained slot is still live.
+ * The operation blocks every blockable signal before changing descriptors and
+ * leaves that mask installed for the future child reinitializer.
+ *
+ * Successful child authentication consumes @identity in the child even if a
+ * later operation fails.  Any nonzero result after that point is destructive:
+ * the caller must terminate or quarantine the child and must not resume QEMU.
+ * The parent process owns an independent copy of every descriptor and remains
+ * unchanged.
+ *
+ * This primitive is intentionally unwired.  A future coordinator must build
+ * the table while descriptor admission is closed and compose the separate
+ * mapping and child-reinitialization proofs before authorizing resume.
+ *
+ * Returns zero after exact disposition and verification, or a negative
+ * errno-style status on failure.
+ */
+int qemu_crucible_hot_fork_apply_descriptor_table(
+    QemuCrucibleHotForkParentIdentity *identity,
+    const QemuCrucibleHotForkDescriptorReplacement
+        replacements[QEMU_CRUCIBLE_HOT_FORK_ENDPOINT_REPLACEMENT_COUNT],
+    const int *retained_fds,
+    size_t retained_fd_count,
+    QemuCrucibleHotForkDescriptorVerifier verify,
+    void *opaque);
+
 #endif
