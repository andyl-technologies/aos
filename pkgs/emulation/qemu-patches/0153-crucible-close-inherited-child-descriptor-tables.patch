diff --git a/util/crucible-hot-fork-child.c b/util/crucible-hot-fork-child.c
index 5900ea765..4706b9807 100644
--- a/util/crucible-hot-fork-child.c
+++ b/util/crucible-hot-fork-child.c
@@ -28,6 +28,31 @@ static int crucible_hot_fork_pidfd_probe(int pidfd)
     return syscall(__NR_pidfd_send_signal, pidfd, 0, NULL, 0);
 }
 
+static int crucible_hot_fork_close_range(unsigned int first,
+                                         unsigned int last)
+{
+    if (syscall(__NR_close_range, first, last, 0) < 0) {
+        return -errno;
+    }
+    return 0;
+}
+
+static int crucible_hot_fork_probe_close_range(void)
+{
+    return crucible_hot_fork_close_range(UINT_MAX, UINT_MAX);
+}
+
+static int crucible_hot_fork_block_child_signals(void)
+{
+    sigset_t blocked;
+
+    if (sigfillset(&blocked) < 0 ||
+        sigprocmask(SIG_SETMASK, &blocked, NULL) < 0) {
+        return -errno;
+    }
+    return 0;
+}
