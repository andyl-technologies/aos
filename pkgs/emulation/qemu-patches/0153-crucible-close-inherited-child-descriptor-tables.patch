+static int crucible_hot_fork_accept_descriptor_replacements(void *opaque)
+{
+    (void)opaque;
+    return 0;
+}
+
+static bool crucible_hot_fork_retained_table_is_valid(
+    const QemuCrucibleHotForkParentIdentity *identity,
+    const QemuCrucibleHotForkDescriptorReplacement replacements[2],
+    const int *retained_fds,
+    size_t retained_fd_count)
+{
+    bool target_present[2] = { false, false };
+
+    if (!identity || identity->parent_pid <= 1 ||
+        identity->parent_pidfd < 0 || !replacements || !retained_fds ||
+        retained_fd_count == 0 ||
+        retained_fd_count >
+            QEMU_CRUCIBLE_HOT_FORK_MAX_RETAINED_DESCRIPTORS ||
+        !crucible_hot_fork_descriptors_are_distinct(replacements)) {
+        return false;
+    }
+
+    for (size_t index = 0; index < retained_fd_count; index++) {
+        int fd = retained_fds[index];
+
+        if (fd < 0 || fcntl(fd, F_GETFD) < 0 ||
+            (index > 0 && retained_fds[index - 1] >= fd) ||
+            fd == identity->parent_pidfd ||
+            fd == replacements[0].source_fd ||
+            fd == replacements[1].source_fd) {
+            return false;
+        }
+        for (size_t replacement = 0; replacement < 2; replacement++) {
+            if (fd == replacements[replacement].target_fd) {
+                target_present[replacement] = true;
+            }
+        }
+    }
+    return target_present[0] && target_present[1];
+}
+
+static int crucible_hot_fork_close_outside_table(const int *retained_fds,
+                                                  size_t retained_fd_count)
+{
+    unsigned int first = 0;
+
+    for (size_t index = 0; index < retained_fd_count; index++) {
+        unsigned int retained = retained_fds[index];
+        int result;
+
+        if (first < retained) {
+            result = crucible_hot_fork_close_range(first, retained - 1);
+            if (result != 0) {
+                return result;
+            }
+        }
+        first = retained + 1;
+    }
+    return crucible_hot_fork_close_range(first, UINT_MAX);
+}
+
+int qemu_crucible_hot_fork_apply_descriptor_table(
+    QemuCrucibleHotForkParentIdentity *identity,
+    const QemuCrucibleHotForkDescriptorReplacement replacements[2],
+    const int *retained_fds,
+    size_t retained_fd_count,
+    QemuCrucibleHotForkDescriptorVerifier verify,
+    void *opaque)
+{
+    int result;
+
+    if (!verify || !crucible_hot_fork_retained_table_is_valid(
+                       identity, replacements, retained_fds,
+                       retained_fd_count)) {
+        return -EINVAL;
+    }
+    result = crucible_hot_fork_probe_close_range();
+    if (result != 0) {
+        return result;
+    }
+    result = qemu_crucible_hot_fork_authenticate_immediate_child(identity);
+    if (result != 0) {
+        return result;
+    }
+    result = crucible_hot_fork_block_child_signals();
+    qemu_crucible_hot_fork_release_parent_identity(identity);
+    if (result != 0) {
+        return result;
+    }
+
+    result = qemu_crucible_hot_fork_replace_endpoint_descriptors(
+        replacements, crucible_hot_fork_accept_descriptor_replacements, NULL);
+    if (result != 0) {
+        return result;
+    }
+    result = crucible_hot_fork_close_outside_table(retained_fds,
+                                                   retained_fd_count);
+    if (result != 0) {
+        return result;
+    }
+    for (size_t index = 0; index < retained_fd_count; index++) {
+        if (fcntl(retained_fds[index], F_GETFD) < 0) {
+            return -errno;
+        }
+    }
+
+    result = verify(opaque);
+    if (result > 0 || result == -EUCLEAN) {
+        return -EPROTO;
+    }
+    return result;
+}
