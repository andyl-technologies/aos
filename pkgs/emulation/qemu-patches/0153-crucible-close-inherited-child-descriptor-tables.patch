+static int verify_closed_descriptor_table(void *opaque)
+{
+    ClosedDescriptorTableVerification *verification = opaque;
+    char byte = 't';
+    uint64_t wake = 1;
+
+    if (fcntl(verification->closed_fd, F_GETFD) >= 0 || errno != EBADF) {
+        return -EBUSY;
+    }
+    if (send(verification->control_fd, &byte, 1, 0) != 1) {
+        return errno != 0 ? -errno : -EIO;
+    }
+    if (write(verification->wake_fd, &wake, sizeof(wake)) != sizeof(wake)) {
+        return errno != 0 ? -errno : -EIO;
+    }
+    return 0;
+}
+
+static int compare_descriptors(const void *left, const void *right)
+{
+    int left_fd = *(const int *)left;
+    int right_fd = *(const int *)right;
+
+    return (left_fd > right_fd) - (left_fd < right_fd);
+}
