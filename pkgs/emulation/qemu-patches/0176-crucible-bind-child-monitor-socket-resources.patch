+} QemuChrSocketHotForkChildBasis;
+
+/**
+ * qemu_chr_socket_hot_fork_prepare_child_basis() - bind socket resources
+ * @basis: caller-owned future-child socket resource basis
+ * @chardev: exact connected chardev owned by @frontend
+ * @frontend: exact admitted monitor frontend
+ * @context: exact GMainContext used by the chardev sources
+ *
+ * Binds one connected listening AF_UNIX socket backend without TLS, telnet,
+ * WebSocket, reconnect, connect-task, or queued descriptor-transfer state.
+ * The immutable basis retains the exact inherited channel, listener, read/HUP
+ * sources, frontend, and context for a later child-only disposition.  This
+ * operation is nondestructive.
+ *
+ * Returns: zero on success, or a negative errno value on rejection.
+ */
+int qemu_chr_socket_hot_fork_prepare_child_basis(
+    QemuChrSocketHotForkChildBasis *basis, Chardev *chardev,
+    CharBackend *frontend, GMainContext *context);
+
+/**
+ * qemu_chr_socket_hot_fork_child_basis_matches() - revalidate socket basis
+ * @basis: previously prepared future-child socket resource basis
+ * @chardev: exact expected connected chardev
+ * @frontend: exact expected monitor frontend
+ * @context: exact expected GMainContext
+ *
+ * Returns: true exactly while every bound socket resource and restriction
+ * remains unchanged.
+ */
+bool qemu_chr_socket_hot_fork_child_basis_matches(
+    const QemuChrSocketHotForkChildBasis *basis, Chardev *chardev,
+    CharBackend *frontend, GMainContext *context);
