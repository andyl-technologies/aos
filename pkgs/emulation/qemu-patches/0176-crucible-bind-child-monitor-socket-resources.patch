+static bool tcp_chr_hot_fork_child_profile(
+    SocketChardev *s, CharBackend *frontend, GMainContext *context)
+{
+    Chardev *chr = CHARDEV(s);
+
+    return frontend && chr->be == frontend && chr->gcontext == context &&
+        qemu_chr_has_feature(chr, QEMU_CHAR_FEATURE_GCONTEXT) &&
+        !qemu_chr_replay(chr) && s->state == TCP_CHARDEV_STATE_CONNECTED &&
+        s->addr && s->addr->type == SOCKET_ADDRESS_TYPE_UNIX &&
+        s->is_listen && s->listener && s->ioc && s->sioc &&
+        s->ioc == QIO_CHANNEL(s->sioc) && chr->gsource && s->hup_source &&
+        s->crucible_hot_fork_connection_generation != 0 &&
+        !s->tls_creds && !s->tls_authz && !s->is_telnet && !s->is_tn3270 &&
+        !s->is_websock && !s->telnet_source && !s->telnet_init &&
+        !s->reconnect_timer && s->reconnect_time_ms == 0 &&
+        !s->connect_task && !s->read_msgfds && s->read_msgfds_num == 0 &&
+        !s->write_msgfds && s->write_msgfds_num == 0 && s->registered_yank;
+}
+
+int qemu_chr_socket_hot_fork_prepare_child_basis(
+    QemuChrSocketHotForkChildBasis *basis, Chardev *chardev,
+    CharBackend *frontend, GMainContext *context)
+{
+    SocketChardev *s;
+    int result = 0;
+
+    if (!basis || !chardev || !frontend ||
+        !object_dynamic_cast(OBJECT(chardev), TYPE_CHARDEV_SOCKET)) {
+        return -EINVAL;
+    }
+
+    s = SOCKET_CHARDEV(chardev);
+    qemu_mutex_lock(&chardev->chr_write_lock);
+    if (!tcp_chr_hot_fork_child_profile(s, frontend, context)) {
+        result = -ENOTSUP;
+        goto out;
+    }
+    *basis = (QemuChrSocketHotForkChildBasis) {
+        .chardev = chardev,
+        .frontend = frontend,
+        .address = s->addr,
+        .ioc = s->ioc,
+        .sioc = s->sioc,
+        .listener = s->listener,
+        .read_source = chardev->gsource,
+        .hup_source = s->hup_source,
+        .context = context,
+        .connection_generation =
+            s->crucible_hot_fork_connection_generation,
+        .prepared = true,
+    };
+out:
+    qemu_mutex_unlock(&chardev->chr_write_lock);
+    return result;
+}
+
+bool qemu_chr_socket_hot_fork_child_basis_matches(
+    const QemuChrSocketHotForkChildBasis *basis, Chardev *chardev,
+    CharBackend *frontend, GMainContext *context)
+{
+    SocketChardev *s;
+    bool matches;
+
+    if (!basis || !basis->prepared || !chardev || !frontend ||
+        !object_dynamic_cast(OBJECT(chardev), TYPE_CHARDEV_SOCKET)) {
+        return false;
+    }
+
+    s = SOCKET_CHARDEV(chardev);
+    qemu_mutex_lock(&chardev->chr_write_lock);
+    matches = tcp_chr_hot_fork_child_profile(s, frontend, context) &&
+        basis->chardev == chardev && basis->frontend == frontend &&
+        basis->address == s->addr && basis->ioc == s->ioc &&
+        basis->sioc == s->sioc && basis->listener == s->listener &&
+        basis->read_source == chardev->gsource &&
+        basis->hup_source == s->hup_source && basis->context == context &&
+        basis->connection_generation ==
+            s->crucible_hot_fork_connection_generation;
+    qemu_mutex_unlock(&chardev->chr_write_lock);
+    return matches;
+}
+
 static void tcp_chr_change_state(SocketChardev *s, TCPChardevState state)
 {
     switch (state) {
@@ -644,6 +726,11 @@ static void tcp_chr_connect(void *opaque)
     chr->filename = qemu_chr_compute_filename(s);
 
     tcp_chr_change_state(s, TCP_CHARDEV_STATE_CONNECTED);
+    if (s->crucible_hot_fork_connection_generation == UINT64_MAX) {
+        s->crucible_hot_fork_connection_generation = 0;
+    } else {
+        s->crucible_hot_fork_connection_generation++;
+    }
     update_ioc_handlers(s);
     qemu_chr_be_event(chr, CHR_EVENT_OPENED);
 }
