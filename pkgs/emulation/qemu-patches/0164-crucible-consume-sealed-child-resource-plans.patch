+/**
+ * qemu_crucible_hot_fork_apply_child_resource_plan() - consume a sealed plan
+ * @resources: inherited, sealed complete resource plan
+ * @transaction: active authenticated immediate-child transaction
+ * @verify_descriptors: complete installed descriptor-table verifier
+ * @descriptor_opaque: caller-owned value passed to @verify_descriptors
+ * @reinitializer: exact inherited plugin child-runtime adapter
+ *
+ * Revalidates the complete sealed union and its exact plugin contribution,
+ * requires an unconsumed plugin reinitializer for the same immutable plan, and
+ * passes only those tables to the destructive child resource transaction.  A
+ * successful preflight consumes @resources before descriptor mutation begins;
+ * the plan is one-shot even when a later destructive phase fails.  Success
+ * records both the plan and transaction as completely applied while every
+ * recreated worker and callback path remains held.
+ *
+ * This adapter still covers only explicitly merged subsystem contributions.
+ * It neither proves that the union is a complete QEMU inventory nor releases
+ * guest admission, and therefore does not acknowledge readiness bit 7 or 8.
+ *
+ * Returns zero after exact application, -EPERM when either linear owner is not
+ * current, -EINVAL when the immutable bases disagree, or the destructive child
+ * transaction's negative errno-style status after the plan is consumed.
+ */
+int qemu_crucible_hot_fork_apply_child_resource_plan(
+    QemuCrucibleHotForkChildResourcePlan *resources,
+    QemuCrucibleHotForkDescriptorTableTransaction *transaction,
+    QemuCrucibleHotForkDescriptorVerifier verify_descriptors,
+    void *descriptor_opaque,
+    QemuCrucibleHotForkPluginChildReinitializer *reinitializer);
+
