+int qemu_crucible_hot_fork_apply_child_resource_plan(
+    QemuCrucibleHotForkChildResourcePlan *resources,
+    QemuCrucibleHotForkDescriptorTableTransaction *transaction,
+    QemuCrucibleHotForkDescriptorVerifier verify_descriptors,
+    void *descriptor_opaque,
+    QemuCrucibleHotForkPluginChildReinitializer *reinitializer)
+{
+    int result;
+
+    if (!resources || !transaction || !verify_descriptors || !reinitializer) {
+        return -EINVAL;
+    }
+    if (!resources->sealed || resources->building || resources->attempted ||
+        resources->applied || !transaction->active ||
+        transaction->parent_pid <= 1 || transaction->child_pid != getpid()) {
+        return -EPERM;
+    }
+    if (!crucible_hot_fork_child_resource_plan_valid(
+            resources, &resources->plugin) ||
+        !qemu_crucible_hot_fork_plugin_child_reinitializer_prepared_for(
+            reinitializer, &resources->plugin.plan)) {
+        return -EINVAL;
+    }
+
+    resources->attempted = true;
+    result = qemu_crucible_hot_fork_apply_child_resources(
+        transaction, resources->plugin.replacements,
+        resources->retained_fds, resources->retained_fd_count,
+        verify_descriptors, descriptor_opaque,
+        qemu_crucible_hot_fork_reinitialize_plugin_child, reinitializer,
+        resources->shared_mappings, resources->shared_mapping_count);
+    if (result == 0) {
+        resources->applied = true;
+    }
+    return result;
