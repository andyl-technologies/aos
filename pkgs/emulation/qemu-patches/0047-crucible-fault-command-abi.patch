@@ -0,0 +1,44 @@
+/*
+ * Crucible deterministic fault command registry
+ *
+ * Copyright (c) 2026 ANDYL Technologies
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef QEMU_CRUCIBLE_FAULT_H
+#define QEMU_CRUCIBLE_FAULT_H
+
+#include "qemu/qemu-plugin.h"
+
+typedef struct QemuCrucibleFaultHandler QemuCrucibleFaultHandler;
+
+typedef int (*QemuCrucibleFaultValidateFn)(
+    const struct qemu_plugin_crucible_fault_command *command,
+    const uint8_t *payload, size_t payload_len);
+typedef int (*QemuCrucibleFaultArmFn)(
+    const struct qemu_plugin_crucible_fault_command *command,
+    const uint8_t *payload, size_t payload_len, void **state_out);
+typedef int (*QemuCrucibleFaultApplyFn)(
+    const struct qemu_plugin_crucible_fault_command *command,
+    const uint8_t *payload, size_t payload_len, void *state,
+    struct qemu_plugin_crucible_fault_result *result,
+    GByteArray *result_payload);
+typedef void (*QemuCrucibleFaultFreeFn)(void *state);
+
+struct QemuCrucibleFaultHandler {
+    struct qemu_plugin_crucible_fault_capability capability;
+    QemuCrucibleFaultValidateFn validate;
+    QemuCrucibleFaultArmFn arm;
+    QemuCrucibleFaultApplyFn apply;
+    QemuCrucibleFaultFreeFn free_state;
+};
+
+void qemu_crucible_fault_register(const QemuCrucibleFaultHandler *handler);
+void qemu_crucible_fault_registry_seal(void);
+void qemu_crucible_fault_dispatch_boundary(uint16_t phase,
+                                           uint64_t observed_icount);
+bool qemu_crucible_fault_has_pending_at_or_before(uint64_t icount);
+uint64_t qemu_crucible_fault_next_icount(void);
+
+#endif
diff --git a/include/qemu/qemu-plugin.h b/include/qemu/qemu-plugin.h
--- a/include/qemu/qemu-plugin.h
+++ b/include/qemu/qemu-plugin.h
@@ -1787,6 +1787,126 @@ void qemu_plugin_crucible_pause_vm(void);
 QEMU_PLUGIN_API
 int64_t qemu_plugin_clock_deadline_ns(void);
 
+/**
+ * struct qemu_plugin_crucible_fault_command - validated fault command copy
+ *
+ * This GPL-side structure is populated only after the plugin validates the
+ * public byte ABI and copies its payload out of shared memory. QEMU revalidates
+ * every scalar bound before retaining it.
+ */
+struct qemu_plugin_crucible_fault_command {
+    uint16_t abi_major;
+    uint16_t abi_minor;
+    uint16_t command_kind;
+    uint16_t command_flags;
+    uint16_t phase;
+    uint16_t reserved;
+    uint32_t semantic_version;
+    uint64_t command_sequence;
+    uint8_t target_node_hash[32];
+    uint64_t target_icount;
+    uint64_t authorization_ceiling_icount;
+    uint8_t binding_hash[32];
+    uint8_t opportunity_hash[32];
+    uint8_t expected_precondition_hash[32];
+};
+
+/**
+ * struct qemu_plugin_crucible_fault_result - QEMU mutation result
+ *
+ * The plugin converts this fixed GPL-side value and its separately copied
+ * payload into the public byte-level result ABI.
+ */
+struct qemu_plugin_crucible_fault_result {
+    uint16_t command_kind;
+    uint16_t status;
+    uint16_t phase;
+    uint16_t reserved;
+    uint32_t semantic_version;
+    uint32_t capability_version;
+    uint64_t command_sequence;
+    uint64_t observed_icount;
+    uint64_t applied_icount;
+    uint8_t before_hash[32];
+    uint8_t after_hash[32];
+    uint8_t evidence_hash[32];
+};
+
+enum qemu_plugin_crucible_fault_scope {
+    QEMU_PLUGIN_CRUCIBLE_FAULT_SCOPE_ALL = 1,
+    QEMU_PLUGIN_CRUCIBLE_FAULT_SCOPE_X86_64 = 2,
+    QEMU_PLUGIN_CRUCIBLE_FAULT_SCOPE_AARCH64 = 3,
+    QEMU_PLUGIN_CRUCIBLE_FAULT_SCOPE_VIRTIO = 4,
+};
+
+/**
+ * struct qemu_plugin_crucible_fault_capability - immutable handler descriptor
+ *
+ * Strings have process lifetime and are copied synchronously by the plugin.
+ */
+struct qemu_plugin_crucible_fault_capability {
+    uint16_t command_kind;
+    uint16_t scope;
+    uint32_t semantic_version;
+    uint32_t phase_mask;
+    uint32_t maximum_payload_bytes;
+    uint32_t maximum_pending_commands;
+    uint64_t required_feature_bits;
+    const char *name;
+    const char *payload_schema;
+};
+
+/**
+ * qemu_plugin_crucible_fault_capabilities() - copy the sorted registry
+ * @out: destination array, or NULL to query the required row count
+ * @capacity: number of rows available at @out
+ *
+ * Returns the required row count. No rows are copied unless @capacity is large
+ * enough for the complete immutable registry.
+ */
+QEMU_PLUGIN_API
+size_t qemu_plugin_crucible_fault_capabilities(
+    struct qemu_plugin_crucible_fault_capability *out, size_t capacity);
+
+/**
+ * qemu_plugin_crucible_fault_submit() - copy and arm a validated command
+ * @command: plugin-validated fixed command fields
+ * @payload: copied canonical payload bytes
+ * @payload_len: exact payload byte count
+ *
+ * Returns zero after arming or queuing a canonical rejection, or a negative
+ * errno when transport resources cannot preserve a result.
+ */
+QEMU_PLUGIN_API
+int qemu_plugin_crucible_fault_submit(
+    const struct qemu_plugin_crucible_fault_command *command,
+    const uint8_t *payload, size_t payload_len);
+
+/**
+ * qemu_plugin_crucible_fault_cancel() - cancel one command not yet applied
+ * @command_sequence: exact live sequence to cancel
+ *
+ * Returns zero on cancellation or -ENOENT once absent or applied.
+ */
+QEMU_PLUGIN_API
+int qemu_plugin_crucible_fault_cancel(uint64_t command_sequence);
+
+/**
+ * qemu_plugin_crucible_fault_poll() - copy one completed result
+ * @result: fixed result destination
+ * @payload: result payload destination
+ * @payload_capacity: bytes available at @payload
+ * @payload_length: required/copied result payload bytes
+ *
+ * Returns one when a result was consumed, zero when none is ready, -ENOSPC
+ * without consumption when the payload buffer is too small, or -EINVAL for an
+ * invalid pointer contract.
+ */
+QEMU_PLUGIN_API
+int qemu_plugin_crucible_fault_poll(
+    struct qemu_plugin_crucible_fault_result *result,
+    uint8_t *payload, size_t payload_capacity, size_t *payload_length);
+
