+bool acpi_ghes_memory_error_ready(uint16_t source_id)
+{
+    AcpiGedState *acpi_ged_state;
+    AcpiGhesState *ags;
+    uint64_t cper_addr = 0;
+    uint64_t read_ack_register_addr = 0;
+    uint64_t read_ack_register;
+
+    if (source_id >= ACPI_GHES_ERROR_SOURCE_COUNT) {
+        return false;
+    }
+    acpi_ged_state = ACPI_GED(object_resolve_path_type(
+        "", TYPE_ACPI_GED, NULL));
+    if (!acpi_ged_state) {
+        return false;
+    }
+    ags = &acpi_ged_state->ghes_state;
+    if (!ags->present) {
+        return false;
+    }
+    get_hw_error_offsets(le64_to_cpu(ags->hw_error_le), source_id,
+                         &cper_addr, &read_ack_register_addr);
+    if (!cper_addr) {
+        return false;
+    }
+    cpu_physical_memory_read(read_ack_register_addr,
+                             &read_ack_register,
+                             sizeof(read_ack_register));
+    return le64_to_cpu(read_ack_register) != 0;
+}
+
+bool acpi_ghes_memory_error_state(
+    uint16_t source_id, AcpiGhesMemoryErrorState *state)
+{
+    AcpiGedState *acpi_ged_state;
+    AcpiGhesState *ags;
+    uint64_t cper_addr = 0;
+    uint64_t read_ack_register_addr = 0;
+    uint64_t read_ack_register;
+
+    if (!state || source_id >= ACPI_GHES_ERROR_SOURCE_COUNT) {
+        return false;
+    }
+    acpi_ged_state = ACPI_GED(object_resolve_path_type(
+        "", TYPE_ACPI_GED, NULL));
+    if (!acpi_ged_state) {
+        return false;
+    }
+    ags = &acpi_ged_state->ghes_state;
+    if (!ags->present) {
+        return false;
+    }
+    get_hw_error_offsets(le64_to_cpu(ags->hw_error_le), source_id,
+                         &cper_addr, &read_ack_register_addr);
+    if (!cper_addr) {
+        return false;
+    }
+    memset(state, 0, sizeof(*state));
+    cpu_physical_memory_read(read_ack_register_addr,
+                             &read_ack_register,
+                             sizeof(read_ack_register));
+    state->read_ack = le64_to_cpu(read_ack_register);
+    state->record_length = ACPI_GHES_MEMORY_ERROR_RECORD_BYTES;
+    cpu_physical_memory_read(cper_addr, state->record,
+                             sizeof(state->record));
+    return true;
+}
+
+bool acpi_ghes_memory_error_restore(
+    uint16_t source_id, const AcpiGhesMemoryErrorState *state)
+{
+    AcpiGedState *acpi_ged_state;
+    AcpiGhesState *ags;
+    uint64_t cper_addr = 0;
+    uint64_t read_ack_register_addr = 0;
+    uint64_t read_ack_register;
+
+    if (!state || source_id >= ACPI_GHES_ERROR_SOURCE_COUNT ||
+        state->record_length != ACPI_GHES_MEMORY_ERROR_RECORD_BYTES) {
+        return false;
+    }
+    acpi_ged_state = ACPI_GED(object_resolve_path_type(
+        "", TYPE_ACPI_GED, NULL));
+    if (!acpi_ged_state) {
+        return false;
+    }
+    ags = &acpi_ged_state->ghes_state;
+    if (!ags->present) {
+        return false;
+    }
+    get_hw_error_offsets(le64_to_cpu(ags->hw_error_le), source_id,
+                         &cper_addr, &read_ack_register_addr);
+    if (!cper_addr) {
+        return false;
+    }
+    cpu_physical_memory_write(cper_addr, state->record,
+                              sizeof(state->record));
+    read_ack_register = cpu_to_le64(state->read_ack);
+    cpu_physical_memory_write(read_ack_register_addr,
+                              &read_ack_register,
+                              sizeof(read_ack_register));
+    return true;
+}
