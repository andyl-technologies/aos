+bool x86_cpu_get_fault_hardware_error_capability(
+    CPUState *cs, CPUFaultHardwareErrorCapability *capability)
+{
+    CPUX86State *env = cpu_env(cs);
+    uint32_t banks = env->mcg_cap & 0xff;
+
+    if (!env->mcg_cap || banks == 0 || banks > MCE_BANKS_DEF) {
+        return false;
+    }
+    capability->bank_count = banks;
+    capability->machine_check = true;
+    return true;
+}
+
+bool x86_cpu_get_fault_privilege(CPUState *cs, uint32_t *privilege)
+{
+    CPUX86State *env = cpu_env(cs);
+
+    if (!privilege) {
+        return false;
+    }
+    *privilege = env->hflags & HF_CPL_MASK;
+    return *privilege <= 3;
+}
+
+bool x86_cpu_read_fault_hardware_error_state(
+    CPUState *cs, uint32_t bank_number, CPUFaultHardwareErrorState *state)
+{
+    CPUX86State *env = cpu_env(cs);
+    const uint32_t banks = env->mcg_cap & 0xff;
+    const uint64_t *bank;
+
+    if (bank_number >= banks) {
+        return false;
+    }
+    bank = env->mce_banks + 4 * bank_number;
+    state->architecture = CPU_FAULT_EXCEPTION_X86_64;
+    state->record = CPU_FAULT_EXCEPTION_X86_MACHINE_CHECK;
+    state->bank = bank_number;
+    state->interrupt_request = cs->interrupt_request;
+    state->bank_control = bank[0];
+    state->bank_status = bank[1];
+    state->bank_address = bank[2];
+    state->bank_misc = bank[3];
+    state->global_status = env->mcg_status;
+    return true;
+}
+
+bool x86_cpu_restore_fault_hardware_error_state(
+    CPUState *cs, const CPUFaultHardwareErrorState *state)
+{
+    CPUX86State *env = cpu_env(cs);
+    const uint32_t banks = env->mcg_cap & 0xff;
+    uint64_t *bank;
+
+    if (!state || state->architecture != CPU_FAULT_EXCEPTION_X86_64 ||
+        state->record != CPU_FAULT_EXCEPTION_X86_MACHINE_CHECK ||
+        state->bank >= banks) {
+        return false;
+    }
+    bank = env->mce_banks + 4 * state->bank;
+    bank[0] = state->bank_control;
+    bank[1] = state->bank_status;
+    bank[2] = state->bank_address;
+    bank[3] = state->bank_misc;
+    env->mcg_status = state->global_status;
+    if (state->interrupt_request & CPU_INTERRUPT_MCE) {
+        cpu_interrupt(cs, CPU_INTERRUPT_MCE);
+    } else {
+        cpu_reset_interrupt(cs, CPU_INTERRUPT_MCE);
+    }
+    return true;
+}
+
+static void x86_cpu_write_fault_bank(CPUX86State *env,
+                                     const CPUFaultException *exception)
+{
+    uint64_t *bank = env->mce_banks +
+        4 * exception->x86_machine_check.bank;
+    uint64_t status = exception->x86_machine_check.status;
+
+    if (bank[1] & MCI_STATUS_VAL) {
+        status |= MCI_STATUS_OVER;
+    }
+    if (exception->x86_machine_check.corrected &&
+        (bank[1] & (MCI_STATUS_VAL | MCI_STATUS_UC)) ==
+            (MCI_STATUS_VAL | MCI_STATUS_UC)) {
+        bank[1] |= MCI_STATUS_OVER;
+        return;
+    }
+    bank[2] = exception->x86_machine_check.has_address ?
+        exception->x86_machine_check.address : 0;
+    bank[3] = exception->x86_machine_check.has_misc ?
+        exception->x86_machine_check.misc : 0;
+    bank[1] = status;
