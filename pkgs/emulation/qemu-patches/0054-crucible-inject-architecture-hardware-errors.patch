+static void crucible_instruction_exception_record(
+    uint8_t record[256], const CPUFaultException *exception)
+{
+    stw_le_p(record + 160, exception->record);
+    if (exception->record == CPU_FAULT_EXCEPTION_X86_MACHINE_CHECK) {
+        stl_le_p(record + 164, exception->x86_machine_check.bank);
+        stq_le_p(record + 168, exception->x86_machine_check.status);
+        stq_le_p(record + 176,
+                 exception->x86_machine_check.global_status);
+        stq_le_p(record + 184, exception->x86_machine_check.address);
+        stq_le_p(record + 192, exception->x86_machine_check.misc);
+        record[200] = exception->x86_machine_check.corrected;
+        record[201] = exception->x86_machine_check.has_address;
+        record[202] = exception->x86_machine_check.has_misc;
+    } else if (exception->record == CPU_FAULT_EXCEPTION_AARCH64_RAS) {
+        stq_le_p(record + 168, exception->aarch64_ras.esr);
+        stq_le_p(record + 176, exception->aarch64_ras.far);
+        stq_le_p(record + 184, exception->aarch64_ras.disr);
+        record[200] = exception->aarch64_ras.asynchronous;
+        record[201] = exception->aarch64_ras.corrected;
+        record[202] = exception->aarch64_ras.has_far;
+        record[203] = exception->aarch64_ras.has_disr;
+        record[204] = exception->aarch64_ras.fatal;
+    }
+}
