+
+#include "qemu/osdep.h"
+
+#include "exec/address-spaces.h"
+#include "exec/memory.h"
+#include "hw/acpi/ghes.h"
+#include "hw/core/cpu.h"
+#include "qemu/bswap.h"
+#include "qemu/crucible-fault.h"
+#include "qemu/error-report.h"
+#include "qobject/qdict.h"
+#include "qobject/qobject.h"
+#include "system/runstate.h"
+
+#define CRUCIBLE_HWERR_RECORD_X86_MCE 1
+#define CRUCIBLE_HWERR_RECORD_AARCH64_RAS 2
+#define CRUCIBLE_HWERR_RECORD_MEMORY_ECC 3
+
+#define CRUCIBLE_HWERR_CLASS_CORRECTED 1
+#define CRUCIBLE_HWERR_CLASS_RECOVERABLE 2
+#define CRUCIBLE_HWERR_CLASS_FATAL 3
+#define CRUCIBLE_HWERR_CLASS_SYNCHRONOUS 4
+#define CRUCIBLE_HWERR_CLASS_ASYNCHRONOUS 5
+
+#define CRUCIBLE_HWERR_MECHANISM_X86_MCA 1
+#define CRUCIBLE_HWERR_MECHANISM_ACPI_GHES 2
+#define CRUCIBLE_HWERR_MECHANISM_AARCH64_RAS 3
+
+#define CRUCIBLE_HWERR_VISIBILITY_TELEMETRY (1U << 0)
+#define CRUCIBLE_HWERR_VISIBILITY_INTERRUPT (1U << 1)
+#define CRUCIBLE_HWERR_VISIBILITY_EXCEPTION (1U << 2)
+
+#define CRUCIBLE_HWERR_CPU_PHASES \
+    ((UINT64_C(1) << (11 - 1)) | (UINT64_C(1) << (12 - 1)))
+#define CRUCIBLE_HWERR_MEMORY_PHASES \
+    ((UINT64_C(1) << (9 - 1)) | (UINT64_C(1) << (17 - 1)) | \
+     (UINT64_C(1) << (18 - 1)) | (UINT64_C(1) << (19 - 1)) | \
+     (UINT64_C(1) << (20 - 1)) | (UINT64_C(1) << (21 - 1)) | \
+     (UINT64_C(1) << (22 - 1)))
+#define CRUCIBLE_HWERR_PRIVILEGES 0x0f
+
+#define CRUCIBLE_X86_MCI_STATUS_VAL (UINT64_C(1) << 63)
+#define CRUCIBLE_X86_MCI_STATUS_OVER (UINT64_C(1) << 62)
+#define CRUCIBLE_X86_MCI_STATUS_UC (UINT64_C(1) << 61)
+#define CRUCIBLE_X86_MCI_STATUS_EN (UINT64_C(1) << 60)
+#define CRUCIBLE_X86_MCI_STATUS_MISCV (UINT64_C(1) << 59)
+#define CRUCIBLE_X86_MCI_STATUS_ADDRV (UINT64_C(1) << 58)
+#define CRUCIBLE_X86_MCI_STATUS_PCC (UINT64_C(1) << 57)
+#define CRUCIBLE_X86_MCI_STATUS_S (UINT64_C(1) << 56)
+#define CRUCIBLE_X86_MCI_STATUS_AR (UINT64_C(1) << 55)
+#define CRUCIBLE_X86_MCI_STATUS_DEFERRED (UINT64_C(1) << 44)
+#define CRUCIBLE_X86_MCI_STATUS_POISON (UINT64_C(1) << 43)
+
+typedef struct CrucibleHardwareBinding {
+    uint8_t id[32];
+    uint8_t bank[32];
+    uint8_t channel[32];
+    uint8_t rank[32];
+    uint8_t firmware[32];
+    uint8_t state[32];
+    bool present;
+} CrucibleHardwareBinding;
+
+typedef struct CrucibleHardwarePending {
+    CPUState *cpu;
+    QemuCrucibleFaultRule *rule;
+    QemuCrucibleFaultEventReservation *reservation;
+    CPUFaultException exception;
+    uint64_t command_icount;
+    uint64_t address;
+    uint64_t ecc_syndrome;
+    uint32_t row_index;
+    uint16_t ghes_source_id;
+    uint8_t before_hash[32];
+    uint8_t id[32];
+    uint8_t bank[32];
+    uint8_t channel[32];
+    uint8_t rank[32];
+    uint8_t firmware[32];
+    uint8_t state[32];
+    CPUFaultHardwareErrorState before_cpu_state;
+    CPUFaultHardwareErrorState queued_cpu_state;
+    AcpiGhesMemoryErrorState before_ghes_state;
+    AcpiGhesMemoryErrorState queued_ghes_state;
+} CrucibleHardwarePending;
+
+static GArray *crucible_hardware_manifest;
+static GArray *crucible_hardware_bindings;
+static GPtrArray *crucible_hardware_pending;
+static uint16_t crucible_hardware_architecture;
+static bool crucible_hardware_bindings_sealed;
+static bool crucible_hardware_registered;
+static bool crucible_hardware_terminal;
+static uint8_t crucible_hardware_manifest_sha256[32];
+
+static const uint64_t x86_status_allowed =
+    CRUCIBLE_X86_MCI_STATUS_VAL | CRUCIBLE_X86_MCI_STATUS_OVER |
+    CRUCIBLE_X86_MCI_STATUS_UC | CRUCIBLE_X86_MCI_STATUS_EN |
+    CRUCIBLE_X86_MCI_STATUS_MISCV | CRUCIBLE_X86_MCI_STATUS_ADDRV |
+    CRUCIBLE_X86_MCI_STATUS_PCC | CRUCIBLE_X86_MCI_STATUS_S |
+    CRUCIBLE_X86_MCI_STATUS_AR | CRUCIBLE_X86_MCI_STATUS_DEFERRED |
+    CRUCIBLE_X86_MCI_STATUS_POISON | UINT64_C(0xffffffff);
+
+static void crucible_hardware_add_row(
+    uint16_t record_kind, uint16_t error_class, uint16_t mechanism,
+    uint16_t visibility_mask, uint32_t bank_number, uint32_t bank_count,
+    uint64_t status_required, uint64_t status_allowed,
+    uint64_t syndrome_required, uint64_t syndrome_allowed,
+    bool corrected, bool maskable,
+    const char *id, const char *bank, const char *channel,
+    const char *rank, const char *firmware, const char *state)
+{
+    bool memory = record_kind == CRUCIBLE_HWERR_RECORD_MEMORY_ECC;
+    struct qemu_plugin_crucible_fault_hardware_error_capability row = {
+        .record_kind = record_kind,
+        .error_class = error_class,
+        .mechanism = mechanism,
+        .visibility_mask = visibility_mask,
+        .bank_number = bank_number,
+        .bank_count = bank_count,
+        .vector = mechanism == CRUCIBLE_HWERR_MECHANISM_X86_MCA ?
+            18 : (maskable ? 47 : 3),
+        .status_required = status_required,
+        .status_allowed = status_allowed,
+        .syndrome_required = syndrome_required,
+        .syndrome_allowed = syndrome_allowed,
+        .model_phase_mask = memory ? CRUCIBLE_HWERR_MEMORY_PHASES :
+            CRUCIBLE_HWERR_CPU_PHASES,
+        .privilege_mask = CRUCIBLE_HWERR_PRIVILEGES,
+        .corrected = corrected,
+        .maskable = maskable,
+        .vmstate = 0,
+        .id = id,
+        .bank = bank,
+        .channel = channel,
+        .rank = rank,
+        .firmware = firmware,
+        .state = state,
+    };
+
+    g_array_append_val(crucible_hardware_manifest, row);
+}
+
+static gint crucible_hardware_row_compare(gconstpointer left,
+                                          gconstpointer right)
+{
+    const struct qemu_plugin_crucible_fault_hardware_error_capability *a =
+        left;
+    const struct qemu_plugin_crucible_fault_hardware_error_capability *b =
+        right;
+
+    return strcmp(a->id, b->id);
+}
+
+static bool crucible_hardware_manifest_init(void)
+{
+    CPUState *cpu = qemu_get_cpu(0);
+    CPUFaultHardwareErrorCapability capability = { 0 };
+
+    if (crucible_hardware_manifest) {
+        return true;
+    }
+    if (!cpu) {
+        return false;
+    }
+    crucible_hardware_architecture =
+        CPU_GET_CLASS(cpu)->crucible_register_scope;
+    crucible_hardware_manifest = g_array_new(
+        false, true,
+        sizeof(struct qemu_plugin_crucible_fault_hardware_error_capability));
+    if (!cpu_get_fault_hardware_error_capability(cpu, &capability)) {
+        goto complete;
+    }
+    if (crucible_hardware_architecture ==
+            QEMU_PLUGIN_CRUCIBLE_FAULT_SCOPE_X86_64) {
+        if (!capability.machine_check) {
+            goto complete;
+        }
+        crucible_hardware_add_row(
+            CRUCIBLE_HWERR_RECORD_X86_MCE,
+            CRUCIBLE_HWERR_CLASS_CORRECTED,
+            CRUCIBLE_HWERR_MECHANISM_X86_MCA,
+            CRUCIBLE_HWERR_VISIBILITY_TELEMETRY, 0,
+            capability.bank_count,
+            CRUCIBLE_X86_MCI_STATUS_VAL, x86_status_allowed,
+            0, UINT32_MAX, true, false, "x86.machine-check.corrected",
+            "x86.mca.bank", "x86.memory.channel", "x86.memory.rank",
+            "x86-mca", "x86-mca-bank-record");
+        crucible_hardware_add_row(
+            CRUCIBLE_HWERR_RECORD_X86_MCE,
+            CRUCIBLE_HWERR_CLASS_RECOVERABLE,
+            CRUCIBLE_HWERR_MECHANISM_X86_MCA,
+            CRUCIBLE_HWERR_VISIBILITY_EXCEPTION, 0,
+            capability.bank_count,
+            CRUCIBLE_X86_MCI_STATUS_VAL | CRUCIBLE_X86_MCI_STATUS_UC,
+            x86_status_allowed, 0, UINT32_MAX, false, false,
+            "x86.machine-check.recoverable", "x86.mca.bank",
+            "x86.memory.channel", "x86.memory.rank", "x86-mca",
+            "x86-mca-bank-record-machine-check");
+        crucible_hardware_add_row(
+            CRUCIBLE_HWERR_RECORD_X86_MCE,
+            CRUCIBLE_HWERR_CLASS_FATAL,
+            CRUCIBLE_HWERR_MECHANISM_X86_MCA,
+            CRUCIBLE_HWERR_VISIBILITY_EXCEPTION, 0,
+            capability.bank_count,
+            CRUCIBLE_X86_MCI_STATUS_VAL | CRUCIBLE_X86_MCI_STATUS_UC |
+                CRUCIBLE_X86_MCI_STATUS_PCC,
+            x86_status_allowed, 0, UINT32_MAX, false, false,
+            "x86.machine-check.fatal", "x86.mca.bank",
+            "x86.memory.channel", "x86.memory.rank", "x86-mca",
+            "x86-mca-bank-record-machine-check");
+        if (capability.bank_count > 9) {
+            crucible_hardware_add_row(
+                CRUCIBLE_HWERR_RECORD_MEMORY_ECC,
+                CRUCIBLE_HWERR_CLASS_CORRECTED,
+                CRUCIBLE_HWERR_MECHANISM_X86_MCA,
+                CRUCIBLE_HWERR_VISIBILITY_TELEMETRY, 9, 1,
+                CRUCIBLE_X86_MCI_STATUS_VAL, x86_status_allowed,
+                0, UINT32_MAX, true, false, "memory.ecc.corrected",
+                "memory.bank-0", "memory.channel-0", "memory.rank-0",
+                "x86-mca-bank-9", "x86-mca-bank-record");
+            crucible_hardware_add_row(
+                CRUCIBLE_HWERR_RECORD_MEMORY_ECC,
+                CRUCIBLE_HWERR_CLASS_RECOVERABLE,
+                CRUCIBLE_HWERR_MECHANISM_X86_MCA,
+                CRUCIBLE_HWERR_VISIBILITY_EXCEPTION, 9, 1,
+                CRUCIBLE_X86_MCI_STATUS_VAL | CRUCIBLE_X86_MCI_STATUS_UC,
+                x86_status_allowed, 0, UINT32_MAX, false, false,
+                "memory.ecc.uncorrectable", "memory.bank-0",
+                "memory.channel-0", "memory.rank-0", "x86-mca-bank-9",
+                "x86-mca-bank-record-machine-check");
+        }
+    } else if (crucible_hardware_architecture ==
+               QEMU_PLUGIN_CRUCIBLE_FAULT_SCOPE_AARCH64) {
+        if (!capability.ras) {
+            goto complete;
+        }
+        crucible_hardware_add_row(
+            CRUCIBLE_HWERR_RECORD_AARCH64_RAS,
+            CRUCIBLE_HWERR_CLASS_SYNCHRONOUS,
+            CRUCIBLE_HWERR_MECHANISM_AARCH64_RAS,
+            CRUCIBLE_HWERR_VISIBILITY_EXCEPTION, 0, 1, 0, 0,
+            0x10, UINT32_MAX & ~(UINT64_C(3) << 11), false, false,
+            "aarch64.ras.synchronous",
+            "aarch64.ras.delivery-state", "aarch64.memory.channel",
+            "aarch64.memory.rank", "aarch64-ras",
+            "aarch64-esr-far-data-abort");
+        crucible_hardware_add_row(
+            CRUCIBLE_HWERR_RECORD_AARCH64_RAS,
+            CRUCIBLE_HWERR_CLASS_FATAL,
+            CRUCIBLE_HWERR_MECHANISM_AARCH64_RAS,
+            CRUCIBLE_HWERR_VISIBILITY_EXCEPTION, 0, 1, 0, 0,
+            0x10 | (UINT64_C(2) << 11),
+            UINT32_MAX & ~(UINT64_C(1) << 11), false, false,
+            "aarch64.ras.synchronous-fatal",
+            "aarch64.ras.delivery-state", "aarch64.memory.channel",
+            "aarch64.memory.rank", "aarch64-ras",
+            "aarch64-esr-far-data-abort");
+        crucible_hardware_add_row(
+            CRUCIBLE_HWERR_RECORD_AARCH64_RAS,
+            CRUCIBLE_HWERR_CLASS_ASYNCHRONOUS,
+            CRUCIBLE_HWERR_MECHANISM_AARCH64_RAS,
+            CRUCIBLE_HWERR_VISIBILITY_EXCEPTION, 0, 1, 0, 0,
+            UINT64_C(0xbe000000) | (UINT64_C(3) << 10),
+            UINT32_MAX & ~(UINT64_C(1) << 12), false, true,
+            "aarch64.ras.asynchronous",
+            "aarch64.ras.delivery-state", "aarch64.memory.channel",
+            "aarch64.memory.rank", "aarch64-ras",
+            "aarch64-disr-serror");
+        crucible_hardware_add_row(
+            CRUCIBLE_HWERR_RECORD_AARCH64_RAS,
+            CRUCIBLE_HWERR_CLASS_FATAL,
+            CRUCIBLE_HWERR_MECHANISM_AARCH64_RAS,
+            CRUCIBLE_HWERR_VISIBILITY_EXCEPTION, 0, 1, 0, 0,
+            UINT64_C(0xbe000000),
+            UINT32_MAX & ~(UINT64_C(7) << 10), false, true,
+            "aarch64.ras.asynchronous-fatal",
+            "aarch64.ras.delivery-state", "aarch64.memory.channel",
+            "aarch64.memory.rank", "aarch64-ras",
+            "aarch64-disr-serror");
+        if (acpi_ghes_present()) {
+            crucible_hardware_add_row(
+                CRUCIBLE_HWERR_RECORD_MEMORY_ECC,
+                CRUCIBLE_HWERR_CLASS_CORRECTED,
+                CRUCIBLE_HWERR_MECHANISM_ACPI_GHES,
+                CRUCIBLE_HWERR_VISIBILITY_TELEMETRY, 0, 1, 0, 0,
+                0, UINT64_MAX, true, false, "memory.ecc.corrected",
+                "memory.bank-0", "memory.channel-0", "memory.rank-0",
+                "acpi-apei-ghes-polled", "acpi-ghes-cper-record");
+            crucible_hardware_add_row(
+                CRUCIBLE_HWERR_RECORD_MEMORY_ECC,
+                CRUCIBLE_HWERR_CLASS_RECOVERABLE,
+                CRUCIBLE_HWERR_MECHANISM_ACPI_GHES,
+                CRUCIBLE_HWERR_VISIBILITY_EXCEPTION, 0, 1, 0, 0,
+                0x10, UINT64_MAX, false, false,
+                "memory.ecc.uncorrectable",
+                "memory.bank-0", "memory.channel-0", "memory.rank-0",
+                "acpi-apei-ghes-sea",
+                "acpi-ghes-cper-record-aarch64-data-abort");
+        }
+    }
+complete:
+    g_array_sort(crucible_hardware_manifest,
+                 crucible_hardware_row_compare);
+    crucible_hardware_bindings = g_array_sized_new(
+        false, true, sizeof(CrucibleHardwareBinding),
+        crucible_hardware_manifest->len);
+    g_array_set_size(crucible_hardware_bindings,
+                     crucible_hardware_manifest->len);
+    return true;
+}
+
+size_t qemu_plugin_crucible_fault_hardware_error_manifest(
+    struct qemu_plugin_crucible_fault_hardware_error_capability *out,
+    size_t capacity, uint16_t *architecture)
+{
+    if (!architecture || !crucible_hardware_manifest_init()) {
+        return 0;
+    }
+    *architecture = crucible_hardware_architecture;
+    if (out && capacity >= crucible_hardware_manifest->len) {
+        memcpy(out, crucible_hardware_manifest->data,
+               crucible_hardware_manifest->len * sizeof(*out));
+    }
+    return crucible_hardware_manifest->len;
+}
+
+int qemu_plugin_crucible_fault_hardware_error_bind(
+    uint32_t row_index, const uint8_t id[32], const uint8_t bank[32],
+    const uint8_t channel[32], const uint8_t rank[32],
+    const uint8_t firmware[32], const uint8_t state[32])
+{
+    CrucibleHardwareBinding *binding;
+
+    if (!id || !bank || !channel || !rank || !firmware || !state ||
+        !crucible_hardware_manifest_init() ||
+        crucible_hardware_bindings_sealed ||
+        row_index >= crucible_hardware_bindings->len) {
+        return -EINVAL;
+    }
+    binding = &g_array_index(crucible_hardware_bindings,
+                             CrucibleHardwareBinding, row_index);
+    if (binding->present) {
+        return -EEXIST;
+    }
+    memcpy(binding->id, id, 32);
+    memcpy(binding->bank, bank, 32);
+    memcpy(binding->channel, channel, 32);
+    memcpy(binding->rank, rank, 32);
+    memcpy(binding->firmware, firmware, 32);
+    memcpy(binding->state, state, 32);
+    binding->present = true;
+    return 0;
+}
+
+int qemu_plugin_crucible_fault_hardware_error_bindings_seal(
+    const uint8_t manifest_sha256[32])
+{
+    if (!manifest_sha256 || !crucible_hardware_manifest_init() ||
+        crucible_hardware_bindings_sealed) {
+        return -EINVAL;
+    }
+    for (guint i = 0; i < crucible_hardware_bindings->len; i++) {
+        if (!g_array_index(crucible_hardware_bindings,
+                           CrucibleHardwareBinding, i).present) {
+            return -ENOENT;
+        }
+    }
+    memcpy(crucible_hardware_manifest_sha256, manifest_sha256, 32);
+    crucible_hardware_bindings_sealed = true;
+    return 0;
+}
+
+static bool crucible_hardware_field(
+    const QemuCrucibleFaultRule *rule, uint16_t tag, uint16_t type,
+    const uint8_t **data, uint32_t *length)
+{
+    return qemu_crucible_fault_rule_field(rule, tag, type, data, length);
+}
+
+static bool crucible_hardware_u32(
+    const QemuCrucibleFaultRule *rule, uint16_t tag, uint32_t *value)
+{
+    const uint8_t *data;
+    uint32_t length;
+
+    if (!crucible_hardware_field(
+            rule, tag, CRUCIBLE_NODE_FAULT_FIELD_TYPE_U32,
+            &data, &length) || length != sizeof(*value)) {
+        return false;
+    }
+    *value = ldl_le_p(data);
+    return true;
+}
+
+static bool crucible_hardware_u64(
+    const QemuCrucibleFaultRule *rule, uint16_t tag, uint64_t *value)
+{
+    const uint8_t *data;
+    uint32_t length;
+
+    if (!crucible_hardware_field(
+            rule, tag, CRUCIBLE_NODE_FAULT_FIELD_TYPE_U64,
+            &data, &length) || length != sizeof(*value)) {
+        return false;
+    }
+    *value = ldq_le_p(data);
+    return true;
+}
+
+static bool crucible_hardware_hash(
+    const QemuCrucibleFaultRule *rule, uint16_t tag, const uint8_t **value)
+{
+    uint32_t length;
+
+    return crucible_hardware_field(
+               rule, tag, CRUCIBLE_NODE_FAULT_FIELD_TYPE_HASH,
+               value, &length) && length == 32;
+}
+
+static CPUState *crucible_hardware_target_cpu(
+    const QemuCrucibleFaultRule *rule)
+{
+    uint32_t vcpu_index;
+
+    return crucible_hardware_u32(
+               rule, CRUCIBLE_NODE_FAULT_FIELD_P8, &vcpu_index) ?
+        qemu_get_cpu(vcpu_index) : NULL;
+}
+
+static bool crucible_hardware_realized_ram(uint64_t address)
+{
+    MemoryRegionSection section = memory_region_find(
+        get_system_memory(), address, 1);
+    bool valid = section.mr && int128_nz(section.size) &&
+        memory_region_is_ram(section.mr) && !memory_region_is_rom(section.mr);
+
+    if (section.mr) {
+        memory_region_unref(section.mr);
+    }
+    return valid;
+}
+
+static bool crucible_hardware_privilege_matches(
+    const struct qemu_plugin_crucible_fault_hardware_error_capability *row,
+    CPUState *cpu)
+{
+    uint32_t privilege;
+
+    return cpu_get_fault_privilege(cpu, &privilege) && privilege < 16 &&
+        (row->privilege_mask & (1U << privilege));
+}
+
+static uint16_t crucible_hardware_visibility(const QObject *object,
+                                             const QObject **exception)
+{
+    QDict *dict = qobject_to(QDict, object);
+    const char *kind;
+
+    *exception = NULL;
+    if (!dict) {
+        return 0;
+    }
+    kind = qdict_get_try_str(dict, "kind");
+    if (!kind) {
+        return 0;
+    }
+    if (strcmp(kind, "telemetry_only") == 0) {
+        return CRUCIBLE_HWERR_VISIBILITY_TELEMETRY;
+    }
+    if (strcmp(kind, "corrected_interrupt") == 0) {
+        return CRUCIBLE_HWERR_VISIBILITY_INTERRUPT;
+    }
+    if (strcmp(kind, "exception") == 0) {
+        *exception = qdict_get(dict, "parameters");
+        return *exception ? CRUCIBLE_HWERR_VISIBILITY_EXCEPTION : 0;
+    }
+    return 0;
+}
+
+static int crucible_hardware_ecc_row(
+    const QemuCrucibleFaultRule *rule, uint32_t *row_index,
+    CPUFaultException *exception, uint16_t *visibility_out)
+{
+    const uint8_t *bank;
+    const uint8_t *channel;
+    const uint8_t *rank;
+    const QObject *exception_object;
+    uint64_t address;
+    uint64_t syndrome;
+    uint32_t kind;
+    uint16_t visibility;
+    CPUState *cpu = crucible_hardware_target_cpu(rule);
+
+    if (!cpu || !crucible_hardware_bindings_sealed ||
+        !crucible_hardware_u32(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_P1, &kind) ||
+        !crucible_hardware_u64(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_P2, &address) ||
+        !crucible_hardware_u64(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_P3, &syndrome) ||
+        !crucible_hardware_hash(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_P4, &bank) ||
+        !crucible_hardware_hash(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_P5, &channel) ||
+        !crucible_hardware_hash(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_P6, &rank)) {
+        return -EINVAL;
+    }
+    visibility = crucible_hardware_visibility(
+        qemu_crucible_fault_rule_json(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_P7), &exception_object);
+    if (!visibility ||
+        (kind == 1 && visibility != CRUCIBLE_HWERR_VISIBILITY_TELEMETRY) ||
+        (kind == 2 && visibility != CRUCIBLE_HWERR_VISIBILITY_EXCEPTION)) {
+        return -ENOTSUP;
+    }
+    for (guint i = 0; i < crucible_hardware_manifest->len; i++) {
+        const struct qemu_plugin_crucible_fault_hardware_error_capability *row =
+            &g_array_index(
+                crucible_hardware_manifest,
+                struct qemu_plugin_crucible_fault_hardware_error_capability,
+                i);
+        const CrucibleHardwareBinding *binding = &g_array_index(
+            crucible_hardware_bindings, CrucibleHardwareBinding, i);
+
+        if (row->record_kind != CRUCIBLE_HWERR_RECORD_MEMORY_ECC ||
+            !crucible_hardware_privilege_matches(row, cpu) ||
+            row->corrected != (kind == 1) ||
+            !(row->visibility_mask & visibility) ||
+            memcmp(binding->bank, bank, 32) != 0 ||
+            memcmp(binding->channel, channel, 32) != 0 ||
+            memcmp(binding->rank, rank, 32) != 0) {
+            continue;
+        }
+        if (visibility == CRUCIBLE_HWERR_VISIBILITY_EXCEPTION &&
+            (!qemu_crucible_fault_exception_decode(
+                 exception_object, exception) ||
+             !cpu_validate_fault_exception(cpu, exception) ||
+             !exception->has_fault_address ||
+             exception->fault_address != address ||
+             (exception->record == CPU_FAULT_EXCEPTION_X86_MACHINE_CHECK ?
+                  (!exception->x86_machine_check.has_address ||
+                   exception->x86_machine_check.address != address ||
+                   (exception->x86_machine_check.status & UINT32_MAX) !=
+                       ((syndrome & UINT32_MAX) ?: UINT64_C(0x100))) :
+                  exception->syndrome != syndrome))) {
+            return -EINVAL;
+        }
+        *row_index = i;
+        *visibility_out = visibility;
+        return 0;
+    }
+    return -ENOENT;
+}
+
+static bool crucible_hardware_exception_matches_row(
+    const struct qemu_plugin_crucible_fault_hardware_error_capability *row,
+    const CPUFaultException *exception)
+{
+    bool x86_record =
+        exception->record == CPU_FAULT_EXCEPTION_X86_MACHINE_CHECK;
+    bool arm_record =
+        exception->record == CPU_FAULT_EXCEPTION_AARCH64_RAS;
+
+    if (x86_record &&
+        (row->record_kind == CRUCIBLE_HWERR_RECORD_X86_MCE ||
+         (row->record_kind == CRUCIBLE_HWERR_RECORD_MEMORY_ECC &&
+          row->mechanism == CRUCIBLE_HWERR_MECHANISM_X86_MCA))) {
+        return row->vector == exception->vector &&
+            row->corrected == exception->x86_machine_check.corrected &&
+            exception->x86_machine_check.bank >= row->bank_number &&
+            exception->x86_machine_check.bank <
+                row->bank_number + row->bank_count &&
+            (exception->x86_machine_check.status & row->status_required) ==
+                row->status_required &&
+            !(exception->x86_machine_check.status & ~row->status_allowed) &&
+            (exception->syndrome & row->syndrome_required) ==
+                row->syndrome_required &&
+            !(exception->syndrome & ~row->syndrome_allowed) &&
+            ((row->error_class == CRUCIBLE_HWERR_CLASS_FATAL) ==
+             !!(exception->x86_machine_check.status &
+                CRUCIBLE_X86_MCI_STATUS_PCC));
+    }
+    if (arm_record &&
+        row->record_kind == CRUCIBLE_HWERR_RECORD_AARCH64_RAS) {
+        return row->vector == exception->vector &&
+            row->corrected == exception->aarch64_ras.corrected &&
+            row->maskable == exception->maskable &&
+            (row->error_class == CRUCIBLE_HWERR_CLASS_FATAL) ==
+                exception->aarch64_ras.fatal &&
+            (row->error_class == CRUCIBLE_HWERR_CLASS_FATAL ||
+             row->error_class ==
+                (exception->aarch64_ras.asynchronous ?
+                 CRUCIBLE_HWERR_CLASS_ASYNCHRONOUS :
+                 CRUCIBLE_HWERR_CLASS_SYNCHRONOUS)) &&
+            (exception->syndrome & row->syndrome_required) ==
+                row->syndrome_required &&
+            !(exception->syndrome & ~row->syndrome_allowed);
+    }
+    if (arm_record &&
+        row->record_kind == CRUCIBLE_HWERR_RECORD_MEMORY_ECC &&
+        row->mechanism == CRUCIBLE_HWERR_MECHANISM_ACPI_GHES) {
+        return row->vector == exception->vector &&
+            !exception->aarch64_ras.corrected &&
+            !exception->aarch64_ras.fatal &&
+            !exception->aarch64_ras.asynchronous &&
+            !exception->maskable &&
+            (exception->syndrome & row->syndrome_required) ==
+                row->syndrome_required &&
+            !(exception->syndrome & ~row->syndrome_allowed);
+    }
+    return false;
+}
+
+int qemu_crucible_fault_hardware_ecc_validate(
+    const QemuCrucibleFaultRule *rule)
+{
+    CPUFaultException exception = { 0 };
+    uint32_t row_index;
+    uint16_t visibility;
+    uint16_t model_phase;
+    uint64_t address;
+    const struct qemu_plugin_crucible_fault_hardware_error_capability *row;
+
+    if (!crucible_hardware_u64(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_P2, &address) ||
+        !crucible_hardware_realized_ram(address) ||
+        crucible_hardware_ecc_row(
+            rule, &row_index, &exception, &visibility) != 0 ||
+        !crucible_hardware_target_cpu(rule)) {
+        return -EINVAL;
+    }
+    row = &g_array_index(
+        crucible_hardware_manifest,
+        struct qemu_plugin_crucible_fault_hardware_error_capability,
+        row_index);
+    model_phase = qemu_crucible_fault_rule_model_phase(rule);
+
+    if (model_phase == 0 || model_phase > 64 ||
+        !(row->model_phase_mask & (UINT64_C(1) << (model_phase - 1)))) {
+        return -EINVAL;
+    }
+    if (row->mechanism == CRUCIBLE_HWERR_MECHANISM_ACPI_GHES &&
+        !acpi_ghes_memory_error_ready(
+            row->corrected ? ACPI_HEST_SRC_ID_CORRECTED_POLL :
+                             ACPI_HEST_SRC_ID_SEA)) {
+        return -EBUSY;
+    }
+    if (visibility == CRUCIBLE_HWERR_VISIBILITY_EXCEPTION &&
+        (!cpu_validate_fault_exception(
+             crucible_hardware_target_cpu(rule), &exception) ||
+         !crucible_hardware_exception_matches_row(row, &exception))) {
+        return -EINVAL;
+    }
+    return 0;
+}
+
+int qemu_crucible_fault_hardware_exception_validate(
+    const QemuCrucibleFaultRule *rule, CPUState *cpu,
+    const CPUFaultException *exception)
+{
+    uint16_t model_phase;
+
+    if (!rule || !cpu || !exception || !crucible_hardware_manifest_init()) {
+        return -EINVAL;
+    }
+    model_phase = qemu_crucible_fault_rule_model_phase(rule);
+    if (model_phase == 0 || model_phase > 64) {
+        return -EINVAL;
+    }
+    if (!cpu_validate_fault_exception(cpu, exception)) {
+        return -EINVAL;
+    }
+    for (guint i = 0; i < crucible_hardware_manifest->len; i++) {
+        const struct qemu_plugin_crucible_fault_hardware_error_capability *row =
+            &g_array_index(
+                crucible_hardware_manifest,
+                struct qemu_plugin_crucible_fault_hardware_error_capability,
+                i);
+
+        if (row->model_phase_mask & (UINT64_C(1) << (model_phase - 1)) &&
+            crucible_hardware_privilege_matches(row, cpu) &&
+            crucible_hardware_exception_matches_row(row, exception)) {
+            return 0;
+        }
+    }
+    return -ENOTSUP;
+}
+
+bool qemu_crucible_fault_hardware_exception_identity(
+    const CPUFaultException *exception, uint32_t *row_index,
+    uint8_t id[32], uint8_t bank[32], uint8_t channel[32], uint8_t rank[32],
+    uint8_t firmware[32], uint8_t state[32], uint8_t manifest_sha256[32])
+{
+    if (!exception || !row_index || !id || !bank || !channel || !rank ||
+        !firmware || !state || !manifest_sha256 ||
+        !crucible_hardware_manifest_init() ||
+        !crucible_hardware_bindings_sealed) {
+        return false;
+    }
+    for (guint i = 0; i < crucible_hardware_manifest->len; i++) {
+        const struct qemu_plugin_crucible_fault_hardware_error_capability *row =
+            &g_array_index(
+                crucible_hardware_manifest,
+                struct qemu_plugin_crucible_fault_hardware_error_capability,
+                i);
+        const CrucibleHardwareBinding *binding = &g_array_index(
+            crucible_hardware_bindings, CrucibleHardwareBinding, i);
+
+        if (!crucible_hardware_exception_matches_row(row, exception)) {
+            continue;
+        }
+        *row_index = i;
+        memcpy(id, binding->id, 32);
+        memcpy(bank, binding->bank, 32);
+        memcpy(channel, binding->channel, 32);
+        memcpy(rank, binding->rank, 32);
+        memcpy(firmware, binding->firmware, 32);
+        memcpy(state, binding->state, 32);
+        memcpy(manifest_sha256, crucible_hardware_manifest_sha256, 32);
+        return true;
+    }
+    return false;
+}
+
+static CrucibleHardwarePending *crucible_hardware_find_pending(CPUState *cpu)
+{
+    if (!crucible_hardware_pending) {
+        return NULL;
+    }
+    for (guint i = 0; i < crucible_hardware_pending->len; i++) {
+        CrucibleHardwarePending *pending =
+            g_ptr_array_index(crucible_hardware_pending, i);
+
+        if (pending->cpu == cpu) {
+            return pending;
+        }
+    }
+    return NULL;
+}
+
+static void crucible_hardware_pending_free(gpointer opaque)
+{
+    CrucibleHardwarePending *pending = opaque;
+
+    if (pending->reservation) {
+        qemu_crucible_fault_event_reservation_release(pending->reservation);
+    }
+    qemu_crucible_fault_rule_unref(pending->rule);
+    g_free(pending);
+}
+
+static void crucible_hardware_fail_closed(const char *message)
+{
+    error_report("Crucible hardware-error terminal failure: %s", message);
+    qemu_crucible_fault_hardware_error_event_terminal();
+    qemu_system_vmstop_request_prepare();
+    qemu_system_vmstop_request(RUN_STATE_INTERNAL_ERROR);
+}
+
+static bool crucible_hardware_restore(
+    CPUState *cpu, bool restore_cpu,
+    const CPUFaultHardwareErrorState *cpu_state, bool restore_ghes,
+    uint16_t ghes_source_id, const AcpiGhesMemoryErrorState *ghes_state)
+{
+    bool restored = true;
+
+    if (restore_cpu) {
+        restored = cpu_restore_fault_hardware_error_state(cpu, cpu_state);
+    }
+    if (restore_ghes) {
+        restored = acpi_ghes_memory_error_restore(
+            ghes_source_id, ghes_state) && restored;
+    }
+    if (!restored) {
+        crucible_hardware_fail_closed("could not restore pre-command state");
+    }
+    return restored;
+}
+
+static void crucible_hardware_evidence(
+    GByteArray *evidence, const QemuCrucibleFaultRule *rule,
+    uint32_t row_index, uint64_t observed_icount, uint64_t address,
+    uint64_t syndrome, uint32_t target_vcpu,
+    const uint8_t id[32], const uint8_t bank[32],
+    const uint8_t channel[32], const uint8_t rank[32],
+    const uint8_t firmware[32], const uint8_t state_identity[32],
+    const CPUFaultException *exception, uint8_t delivery,
+    const CPUFaultHardwareErrorState *before_cpu,
+    const CPUFaultHardwareErrorState *queued_cpu,
+    const CPUFaultHardwareErrorState *after_cpu,
+    const AcpiGhesMemoryErrorState *before_ghes,
+    const AcpiGhesMemoryErrorState *queued_ghes,
+    const AcpiGhesMemoryErrorState *after_ghes)
+{
+    uint8_t record[416] = { 0 };
+    const CPUFaultHardwareErrorState empty_cpu = { 0 };
+    const AcpiGhesMemoryErrorState empty_ghes = { 0 };
+    const CPUFaultHardwareErrorState *cpu_states[] = {
+        before_cpu ?: &empty_cpu,
+        queued_cpu ?: &empty_cpu,
+        after_cpu ?: &empty_cpu,
+    };
+    const AcpiGhesMemoryErrorState *ghes_states[] = {
+        before_ghes ?: &empty_ghes,
+        queued_ghes ?: &empty_ghes,
+        after_ghes ?: &empty_ghes,
+    };
+
+    memcpy(record, "CRUCHWE1", 8);
+    stw_le_p(record + 8, 1);
+    stw_le_p(record + 10, crucible_hardware_architecture);
+    stl_le_p(record + 12, row_index);
+    stq_le_p(record + 16, observed_icount);
+    stq_le_p(record + 24, address);
+    stq_le_p(record + 32, syndrome);
+    stq_le_p(record + 40,
+             qemu_crucible_fault_rule_command_sequence(rule));
+    record[48] = delivery;
+    stl_le_p(record + 52, target_vcpu);
+    memcpy(record + 64, id, 32);
+    memcpy(record + 96, bank, 32);
+    memcpy(record + 128, channel, 32);
+    memcpy(record + 160, rank, 32);
+    memcpy(record + 320, crucible_hardware_manifest_sha256, 32);
+    memcpy(record + 352, firmware, 32);
+    memcpy(record + 384, state_identity, 32);
+    if (exception) {
+        uint32_t flags = exception->has_fault_address |
+            (exception->before_instruction << 1) |
+            (exception->maskable << 2);
+
+        stw_le_p(record + 192, exception->record);
+        stl_le_p(record + 196, exception->vector);
+        stq_le_p(record + 200, exception->syndrome);
+        stq_le_p(record + 208, exception->fault_address);
+        if (exception->record == CPU_FAULT_EXCEPTION_X86_MACHINE_CHECK) {
+            flags |= exception->x86_machine_check.corrected << 3;
+            flags |= exception->x86_machine_check.has_address << 4;
+            flags |= exception->x86_machine_check.has_misc << 5;
+            stl_le_p(record + 216, exception->x86_machine_check.bank);
+            stq_le_p(record + 224,
+                     exception->x86_machine_check.status);
+            stq_le_p(record + 232,
+                     exception->x86_machine_check.global_status);
+            stq_le_p(record + 240,
+                     exception->x86_machine_check.address);
+            stq_le_p(record + 248,
+                     exception->x86_machine_check.misc);
+        } else if (exception->record ==
+                   CPU_FAULT_EXCEPTION_AARCH64_RAS) {
+            flags |= exception->aarch64_ras.asynchronous << 3;
+            flags |= exception->aarch64_ras.corrected << 4;
+            flags |= exception->aarch64_ras.fatal << 5;
+            flags |= exception->aarch64_ras.has_far << 6;
+            flags |= exception->aarch64_ras.has_disr << 7;
+            stq_le_p(record + 264, exception->aarch64_ras.esr);
+            stq_le_p(record + 272, exception->aarch64_ras.far);
+            stq_le_p(record + 280, exception->aarch64_ras.disr);
+        }
+        stl_le_p(record + 256, flags);
+    }
+    g_byte_array_append(evidence, record, sizeof(record));
+    for (size_t i = 0; i < ARRAY_SIZE(cpu_states); i++) {
+        const CPUFaultHardwareErrorState *state = cpu_states[i];
+        uint8_t encoded[128] = { 0 };
+
+        memcpy(encoded, "CRUCHCS1", 8);
+        stl_le_p(encoded + 8, state->architecture);
+        stl_le_p(encoded + 12, state->record);
+        stl_le_p(encoded + 16, state->bank);
+        stl_le_p(encoded + 20, state->flags);
+        stl_le_p(encoded + 24, state->interrupt_request);
+        stq_le_p(encoded + 32, state->bank_control);
+        stq_le_p(encoded + 40, state->bank_status);
+        stq_le_p(encoded + 48, state->bank_address);
+        stq_le_p(encoded + 56, state->bank_misc);
+        stq_le_p(encoded + 64, state->global_status);
+        stq_le_p(encoded + 72, state->syndrome);
+        stq_le_p(encoded + 80, state->fault_address);
+        stq_le_p(encoded + 88, state->esr);
+        stq_le_p(encoded + 96, state->far);
+        stq_le_p(encoded + 104, state->disr);
+        g_byte_array_append(evidence, encoded, sizeof(encoded));
+    }
+    for (size_t i = 0; i < ARRAY_SIZE(ghes_states); i++) {
+        const AcpiGhesMemoryErrorState *state = ghes_states[i];
+        uint8_t encoded[192] = { 0 };
+
+        memcpy(encoded, "CRUCGHS1", 8);
+        stq_le_p(encoded + 8, state->read_ack);
+        stl_le_p(encoded + 16, state->record_length);
+        memcpy(encoded + 20, state->record, sizeof(state->record));
+        g_byte_array_append(evidence, encoded, sizeof(encoded));
+    }
+}
+
+static int crucible_hardware_ecc_impulse(
+    const QemuCrucibleFaultRule *rule, uint64_t observed_icount,
+    uint8_t before_hash[32], uint8_t after_hash[32], GByteArray *evidence,
+    uint16_t *outcome,
+    QemuCrucibleFaultEventReservation **event_reservation)
+{
+    CPUFaultException exception = { 0 };
+    const struct qemu_plugin_crucible_fault_hardware_error_capability *row;
+    const CrucibleHardwareBinding *binding;
+    CrucibleHardwarePending *pending;
+    CPUState *cpu = crucible_hardware_target_cpu(rule);
+    uint64_t address;
+    uint64_t syndrome;
+    uint32_t row_index;
+    uint32_t snapshot_bank;
+    uint16_t ghes_source_id;
+    uint16_t visibility;
+    CPUFaultHardwareErrorState before_cpu_state = { 0 };
+    CPUFaultHardwareErrorState queued_cpu_state = { 0 };
+    AcpiGhesMemoryErrorState before_ghes_state = { 0 };
+    AcpiGhesMemoryErrorState queued_ghes_state = { 0 };
+
+    if (crucible_hardware_terminal || !cpu || !event_reservation ||
+        !*event_reservation ||
+        qemu_crucible_fault_hardware_ecc_validate(rule) != 0 ||
+        !crucible_hardware_u64(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_P2, &address) ||
+        !crucible_hardware_u64(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_P3, &syndrome) ||
+        crucible_hardware_ecc_row(
+            rule, &row_index, &exception, &visibility) != 0 ||
+        qemu_crucible_fault_execution_fingerprint(
+            observed_icount, before_hash) != 0) {
+        return -EINVAL;
+    }
+    row = &g_array_index(
+        crucible_hardware_manifest,
+        struct qemu_plugin_crucible_fault_hardware_error_capability,
+        row_index);
+    binding = &g_array_index(crucible_hardware_bindings,
+                             CrucibleHardwareBinding, row_index);
+    ghes_source_id = row->corrected ? ACPI_HEST_SRC_ID_CORRECTED_POLL :
+                                      ACPI_HEST_SRC_ID_SEA;
+    snapshot_bank = exception.record == CPU_FAULT_EXCEPTION_X86_MACHINE_CHECK ?
+        exception.x86_machine_check.bank : row->bank_number;
+    if (row->mechanism == CRUCIBLE_HWERR_MECHANISM_ACPI_GHES) {
+        if (!acpi_ghes_memory_error_state(
+                ghes_source_id, &before_ghes_state)) {
+            return -EIO;
+        }
+    }
+    if ((row->mechanism != CRUCIBLE_HWERR_MECHANISM_ACPI_GHES ||
+         visibility == CRUCIBLE_HWERR_VISIBILITY_EXCEPTION) &&
+        !cpu_read_fault_hardware_error_state(
+            cpu, snapshot_bank, &before_cpu_state)) {
+        return -EIO;
+    }
+    if (visibility == CRUCIBLE_HWERR_VISIBILITY_TELEMETRY) {
+        if (row->mechanism == CRUCIBLE_HWERR_MECHANISM_X86_MCA) {
+            exception = (CPUFaultException) {
+                .architecture = CPU_FAULT_EXCEPTION_X86_64,
+                .record = CPU_FAULT_EXCEPTION_X86_MACHINE_CHECK,
+                .vector = 18,
+                .fault_address = address,
+                .has_fault_address = true,
+                .x86_machine_check = {
+                    .bank = row->bank_number,
+                    .status = CRUCIBLE_X86_MCI_STATUS_VAL |
+                              CRUCIBLE_X86_MCI_STATUS_EN |
+                              CRUCIBLE_X86_MCI_STATUS_ADDRV |
+                              ((syndrome & UINT32_MAX) ?: UINT64_C(0x100)),
+                    .address = address,
+                    .corrected = true,
+                    .has_address = true,
+                },
+            };
+            if (!cpu_record_corrected_fault(cpu, &exception)) {
+                return -EINVAL;
+            }
+        } else if (acpi_ghes_memory_error_record(
+                       ghes_source_id, address, true, syndrome,
+                       0, 0, 0) != 0) {
+            return -EIO;
+        }
+        if (row->mechanism == CRUCIBLE_HWERR_MECHANISM_ACPI_GHES) {
+            if (!acpi_ghes_memory_error_state(
+                    ghes_source_id, &queued_ghes_state)) {
+                crucible_hardware_restore(
+                    cpu, false, &before_cpu_state, true, ghes_source_id,
+                    &before_ghes_state);
+                return -EIO;
+            }
+        } else if (!cpu_read_fault_hardware_error_state(
+                       cpu, snapshot_bank, &queued_cpu_state)) {
+            crucible_hardware_restore(
+                cpu, true, &before_cpu_state, false, ghes_source_id,
+                &before_ghes_state);
+            return -EIO;
+        }
+        if (qemu_crucible_fault_execution_fingerprint(
+                observed_icount, after_hash) != 0) {
+            crucible_hardware_restore(
+                cpu,
+                row->mechanism != CRUCIBLE_HWERR_MECHANISM_ACPI_GHES,
+                &before_cpu_state,
+                row->mechanism == CRUCIBLE_HWERR_MECHANISM_ACPI_GHES,
+                ghes_source_id, &before_ghes_state);
+            return -EIO;
+        }
+        crucible_hardware_evidence(
+            evidence, rule, row_index, observed_icount, address, syndrome,
+            cpu->cpu_index,
+            binding->id, binding->bank, binding->channel, binding->rank,
+            binding->firmware, binding->state,
+            &exception, 1, &before_cpu_state, &queued_cpu_state,
+            &queued_cpu_state, &before_ghes_state, &queued_ghes_state,
+            &queued_ghes_state);
+        *outcome = CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED;
+        return 0;
+    }
+    if (crucible_hardware_find_pending(cpu)) {
+        return -EBUSY;
+    }
+    pending = g_new0(CrucibleHardwarePending, 1);
+    pending->cpu = cpu;
+    pending->rule = qemu_crucible_fault_rule_copy(rule);
+    pending->exception = exception;
+    pending->command_icount = observed_icount;
+    pending->address = address;
+    pending->ecc_syndrome = syndrome;
+    pending->row_index = row_index;
+    pending->ghes_source_id = ghes_source_id;
+    memcpy(pending->before_hash, before_hash, 32);
+    memcpy(pending->id, binding->id, 32);
+    memcpy(pending->bank, binding->bank, 32);
+    memcpy(pending->channel, binding->channel, 32);
+    memcpy(pending->rank, binding->rank, 32);
+    memcpy(pending->firmware, binding->firmware, 32);
+    memcpy(pending->state, binding->state, 32);
+    pending->before_cpu_state = before_cpu_state;
+    pending->before_ghes_state = before_ghes_state;
+    if (row->mechanism == CRUCIBLE_HWERR_MECHANISM_ACPI_GHES &&
+        acpi_ghes_memory_error_record(
+            ghes_source_id, address, false, syndrome,
+            0, 0, 0) != 0) {
+        crucible_hardware_pending_free(pending);
+        return -EIO;
+    }
+    if (!cpu_queue_fault_hardware_error(cpu, &exception)) {
+        crucible_hardware_restore(
+            cpu, false, &before_cpu_state,
+            row->mechanism == CRUCIBLE_HWERR_MECHANISM_ACPI_GHES,
+            ghes_source_id, &before_ghes_state);
+        crucible_hardware_pending_free(pending);
+        return -EINVAL;
+    }
+    if (row->mechanism == CRUCIBLE_HWERR_MECHANISM_ACPI_GHES) {
+        if (!acpi_ghes_memory_error_state(
+                ghes_source_id, &queued_ghes_state)) {
+            crucible_hardware_restore(
+                cpu, true, &before_cpu_state, true, ghes_source_id,
+                &before_ghes_state);
+            crucible_hardware_pending_free(pending);
+            return -EIO;
+        }
+    }
+    if (!cpu_read_fault_hardware_error_state(
+            cpu, snapshot_bank, &queued_cpu_state)) {
+        crucible_hardware_restore(
+            cpu, true, &before_cpu_state,
+            row->mechanism == CRUCIBLE_HWERR_MECHANISM_ACPI_GHES,
+            ghes_source_id,
+            &before_ghes_state);
+        crucible_hardware_pending_free(pending);
+        return -EIO;
+    }
+    pending->queued_cpu_state = queued_cpu_state;
+    pending->queued_ghes_state = queued_ghes_state;
+    pending->reservation = *event_reservation;
+    *event_reservation = NULL;
+    if (!crucible_hardware_pending) {
+        crucible_hardware_pending = g_ptr_array_new_with_free_func(
+            crucible_hardware_pending_free);
+    }
+    g_ptr_array_add(crucible_hardware_pending, pending);
+    memcpy(after_hash, before_hash, 32);
+    *outcome = CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED;
+    return QEMU_CRUCIBLE_FAULT_IMPULSE_DEFERRED;
+}
+
+bool qemu_crucible_fault_hardware_exception_delivered(
+    CPUState *cpu, uint32_t vector, uint64_t syndrome,
+    bool has_fault_address, uint64_t fault_address)
+{
+    CrucibleHardwarePending *pending =
+        crucible_hardware_find_pending(cpu);
+    g_autoptr(GByteArray) evidence = NULL;
+    uint8_t opportunity_hash[32];
+    uint8_t after_hash[32];
+    uint64_t observed_icount;
+    CPUFaultHardwareErrorState after_cpu_state = { 0 };
+    AcpiGhesMemoryErrorState after_ghes_state = { 0 };
+
+    if (!pending) {
+        return false;
+    }
+    if (pending->exception.vector != vector ||
+        (pending->exception.record != CPU_FAULT_EXCEPTION_X86_MACHINE_CHECK &&
+         (pending->exception.syndrome != syndrome ||
+          pending->exception.has_fault_address != has_fault_address ||
+          (has_fault_address &&
+           pending->exception.fault_address != fault_address)))) {
+        crucible_hardware_fail_closed("delivery differs from request");
+        return true;
+    }
+    observed_icount = qemu_crucible_fault_observed_icount();
+    if (pending->queued_ghes_state.record_length != 0) {
+        if (!acpi_ghes_memory_error_state(
+                pending->ghes_source_id, &after_ghes_state)) {
+            crucible_hardware_fail_closed("cannot read delivered GHES state");
+            return true;
+        }
+    }
+    if (!cpu_read_fault_hardware_error_state(
+            cpu, pending->exception.record ==
+                     CPU_FAULT_EXCEPTION_X86_MACHINE_CHECK ?
+                pending->exception.x86_machine_check.bank : 0,
+            &after_cpu_state)) {
+        crucible_hardware_fail_closed("cannot read delivered CPU state");
+        return true;
+    }
+    if (qemu_crucible_fault_execution_fingerprint(
+            observed_icount, after_hash) != 0) {
+        crucible_hardware_fail_closed("cannot fingerprint delivered state");
+        return true;
+    }
+    evidence = g_byte_array_new();
+    crucible_hardware_evidence(
+        evidence, pending->rule, pending->row_index, observed_icount,
+        pending->address, pending->ecc_syndrome, cpu->cpu_index, pending->id,
+        pending->bank, pending->channel, pending->rank,
+        pending->firmware, pending->state,
+        &pending->exception, 2, &pending->before_cpu_state,
+        &pending->queued_cpu_state, &after_cpu_state,
+        &pending->before_ghes_state, &pending->queued_ghes_state,
+        &after_ghes_state);
+    qemu_plugin_crucible_sha256_bytes(
+        evidence->data, evidence->len, opportunity_hash);
+    qemu_crucible_fault_event_reservation_consume(pending->reservation);
+    qemu_crucible_fault_rule_event(
+        pending->rule, CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED,
+        observed_icount, opportunity_hash, pending->before_hash,
+        after_hash, evidence->data, evidence->len);
+    qemu_crucible_fault_complete_deferred(
+        pending->rule, pending->command_icount, observed_icount,
+        pending->before_hash, after_hash);
+    pending->reservation = NULL;
+    g_ptr_array_remove(crucible_hardware_pending, pending);
+    return true;
+}
+
+void qemu_crucible_fault_hardware_error_event_terminal(void)
+{
+    crucible_hardware_terminal = true;
+    while (crucible_hardware_pending &&
+           crucible_hardware_pending->len != 0) {
+        CrucibleHardwarePending *pending =
+            g_ptr_array_index(crucible_hardware_pending, 0);
+
+        qemu_crucible_fault_fail_deferred(
+            pending->rule, pending->command_icount, pending->before_hash);
+        g_ptr_array_remove_index(crucible_hardware_pending, 0);
+    }
+}
+
+bool qemu_crucible_fault_hardware_error_ensure_registered(void)
+{
+    CPUState *cpu = qemu_get_cpu(0);
+    const uint32_t phases =
+        (1U << (CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY - 1)) |
+        (1U << (CRUCIBLE_FAULT_PHASE_BEFORE_MEMORY_ACCESS - 1)) |
+        (1U << (CRUCIBLE_FAULT_PHASE_AFTER_MEMORY_ACCESS - 1));
+
+    if (crucible_hardware_registered) {
+        return true;
+    }
+    if (!cpu || !crucible_hardware_manifest_init()) {
+        return false;
+    }
+    for (guint i = 0; i < crucible_hardware_manifest->len; i++) {
+        const struct qemu_plugin_crucible_fault_hardware_error_capability *row =
+            &g_array_index(
+                crucible_hardware_manifest,
+                struct qemu_plugin_crucible_fault_hardware_error_capability,
+                i);
+
+        if (row->record_kind == CRUCIBLE_HWERR_RECORD_MEMORY_ECC) {
+            qemu_crucible_fault_node_register(
+                CRUCIBLE_FAULT_COMMAND_MEMORY_ECC_EVENT,
+                CPU_GET_CLASS(cpu)->crucible_register_scope, phases,
+                "qemu.memory.ecc-event.v1", crucible_hardware_ecc_impulse);
+            break;
+        }
+    }
+    crucible_hardware_registered = true;
+    return true;
+}
