+static bool crucible_hot_fork_template_copy_snapshot_bindings(
+    CrucibleHotForkBlockSnapshotBindingList *bindings,
+    Error **errp)
+{
+    CrucibleHotForkBlockSnapshotBindingList *node;
+    QemuBlockBackendHotForkSnapshotBinding *copy;
+    size_t count = 0;
+    size_t index = 0;
+
+    for (node = bindings; node; node = node->next) {
+        if (count == QEMU_BLOCK_BACKEND_HOT_FORK_INVENTORY_MAX) {
+            error_setg(errp, "too many Crucible hot-fork block snapshot "
+                       "bindings");
+            return false;
+        }
+        count++;
+    }
+    copy = g_new0(QemuBlockBackendHotForkSnapshotBinding, count);
+    for (node = bindings; node; node = node->next, index++) {
+        CrucibleHotForkBlockSnapshotBinding *source = node->value;
+
+        copy[index].backend_id = source->backend_id;
+        if (strlen(source->backend_name) >
+                QEMU_BLOCK_BACKEND_HOT_FORK_NAME_MAX ||
+            strlen(source->overlay_node_name) >
