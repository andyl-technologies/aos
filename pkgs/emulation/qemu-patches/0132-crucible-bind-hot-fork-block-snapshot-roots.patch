+
+bool qemu_block_backend_hot_fork_snapshot_bind(
+    const QemuBlockBackendHotForkSnapshotBinding *bindings,
+    size_t binding_count,
+    QemuBlockBackendHotForkBarrierInventory *inventory,
+    Error **errp)
+{
+    QemuBlockBackendHotForkBarrierInventory barrier;
+    QemuBlockBackendHotForkSnapshotRoot *roots;
+    BlockBackend *blk;
+    size_t binding_index = 0;
+    uint64_t previous_backend_id = 0;
+    uint64_t backend_generation;
+    uint64_t graph_generation;
+
+    GLOBAL_STATE_CODE();
+    if (binding_count > QEMU_BLOCK_BACKEND_HOT_FORK_INVENTORY_MAX) {
+        error_setg(errp, "too many Crucible hot-fork snapshot roots");
+        return false;
+    }
+    if (!qemu_block_backend_hot_fork_barrier(
+            QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_QUERY, &barrier)) {
+        error_setg(errp, "cannot inspect Crucible hot-fork block barrier");
+        return false;
+    }
+    if (!barrier.quiescent || barrier.snapshot_bound) {
+        error_setg(errp, "Crucible hot-fork snapshot binding requires one "
+                   "unbound quiescent block barrier");
+        qemu_block_backend_hot_fork_barrier_inventory_destroy(&barrier);
+        return false;
+    }
+    graph_generation = barrier.held_graph_mutation_generation;
+    qemu_block_backend_hot_fork_barrier_inventory_destroy(&barrier);
+
+    {
+        QEMU_LOCK_GUARD(&crucible_hot_fork_block_backend_lock);
+
+        backend_generation = crucible_hot_fork_block_backend_generation;
+    }
+
+    roots = g_new0(QemuBlockBackendHotForkSnapshotRoot, binding_count);
+    QTAILQ_FOREACH(blk, &block_backends, link) {
+        const QemuBlockBackendHotForkSnapshotBinding *binding;
+        QemuBlockBackendHotForkSnapshotRoot *root;
+        BlockDriverState *overlay;
+        BlockDriverState *snapshot;
+
+        if (!blk->root || !(blk->perm & BLK_PERM_WRITE)) {
+            continue;
+        }
+        if (binding_index == binding_count) {
+            error_setg(errp, "missing Crucible hot-fork snapshot root for "
+                       "writable backend");
+            goto fail;
+        }
+        binding = &bindings[binding_index];
+        root = &roots[binding_index];
+        if (binding->backend_id == 0 ||
+            binding->backend_id <= previous_backend_id ||
+            binding->backend_id != blk->crucible_hot_fork_id ||
+            strcmp(binding->backend_name, blk->name ?: "") != 0 ||
+            !id_wellformed(binding->backend_name) ||
+            !id_wellformed(binding->overlay_node_name) ||
+            !id_wellformed(binding->snapshot_node_name) ||
+            !crucible_hot_fork_content_id_valid(
+                binding->snapshot_content_id)) {
+            error_setg(errp, "invalid or out-of-order Crucible hot-fork "
+                       "snapshot binding");
+            goto fail;
+        }
+
+        GRAPH_RDLOCK_GUARD_MAINLOOP();
+        overlay = blk_bs(blk);
+        snapshot = overlay ? bdrv_cow_bs(overlay) : NULL;
+        if (!overlay || !snapshot ||
+            strcmp(bdrv_get_node_name(overlay),
+                   binding->overlay_node_name) != 0 ||
+            strcmp(bdrv_get_node_name(snapshot),
+                   binding->snapshot_node_name) != 0 ||
+            !bdrv_is_writable(overlay) || !bdrv_is_read_only(snapshot)) {
+            error_setg(errp, "Crucible hot-fork snapshot graph did not match "
+                       "the requested writable-overlay/read-only-root basis");
+            goto fail;
+        }
+        if (!crucible_hot_fork_overlay_is_empty(
+                overlay, snapshot, &root->virtual_size, errp)) {
+            goto fail;
+        }
+
+        root->binding = *binding;
+        root->overlay_empty = true;
+        root->snapshot_read_only = true;
+        previous_backend_id = binding->backend_id;
+        binding_index++;
+    }
+    if (binding_index != binding_count) {
+        error_setg(errp, "extra Crucible hot-fork snapshot root binding");
+        goto fail;
+    }
+
+    {
+        QEMU_LOCK_GUARD(&crucible_hot_fork_block_backend_lock);
+
+        if (!crucible_hot_fork_block_barrier_held ||
+            crucible_hot_fork_block_snapshot_bound ||
+            backend_generation !=
+                crucible_hot_fork_block_backend_generation) {
+            error_setg(errp, "Crucible hot-fork block barrier changed during "
+                       "snapshot binding");
+            goto fail;
+        }
+        crucible_hot_fork_block_snapshot_generation++;
+        assert(crucible_hot_fork_block_snapshot_generation != 0);
+        crucible_hot_fork_block_snapshot_backend_generation =
+            backend_generation;
+        crucible_hot_fork_block_snapshot_graph_generation = graph_generation;
+        crucible_hot_fork_block_snapshot_owner =
+            crucible_hot_fork_block_barrier_owner;
+        crucible_hot_fork_block_snapshot_bound = true;
+        crucible_hot_fork_block_snapshot_root_count = binding_count;
+        crucible_hot_fork_block_snapshot_roots = roots;
+    }
+
+    return qemu_block_backend_hot_fork_barrier(
+        QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_QUERY, inventory);
+
+fail:
+    g_free(roots);
+    return false;
+}
