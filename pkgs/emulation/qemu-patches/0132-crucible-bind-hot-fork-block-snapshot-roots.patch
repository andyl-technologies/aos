+
+static bool crucible_hot_fork_content_id_valid(const char *content_id)
+{
+    size_t index;
+
+    if (strlen(content_id) !=
+        QEMU_BLOCK_BACKEND_HOT_FORK_CONTENT_ID_HEX_LENGTH) {
+        return false;
+    }
+    for (index = 0;
+         index < QEMU_BLOCK_BACKEND_HOT_FORK_CONTENT_ID_HEX_LENGTH;
+         index++) {
+        if (!g_ascii_isdigit(content_id[index]) &&
+            !(content_id[index] >= 'a' && content_id[index] <= 'f')) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool crucible_hot_fork_overlay_is_empty(
+    BlockDriverState *overlay, BlockDriverState *snapshot,
+    uint64_t *virtual_size, Error **errp)
+{
+    int64_t length = bdrv_getlength(overlay);
+    int64_t snapshot_length;
+    int64_t offset = 0;
+
+    if (length < 0) {
+        error_setg_errno(errp, -length,
+                         "cannot read Crucible hot-fork overlay length");
+        return false;
+    }
+    snapshot_length = bdrv_getlength(snapshot);
+    if (snapshot_length < 0) {
+        error_setg_errno(errp, -snapshot_length,
+                         "cannot read Crucible hot-fork snapshot length");
+        return false;
+    }
+    if (snapshot_length != length) {
+        error_setg(errp, "Crucible hot-fork overlay and snapshot lengths "
+                   "differ");
+        return false;
+    }
+    while (offset < length) {
+        int64_t bytes = length - offset;
+        int64_t pnum = 0;
+        int allocated = bdrv_is_allocated_above(
+            overlay, snapshot, false, offset, bytes, &pnum);
+
+        if (allocated < 0) {
+            error_setg_errno(errp, -allocated,
+                             "cannot inspect Crucible hot-fork overlay");
+            return false;
+        }
+        if (allocated != 0) {
+            error_setg(errp, "Crucible hot-fork overlay contains allocated "
+                       "guest data at offset %" PRId64, offset);
+            return false;
+        }
+        if (pnum <= 0 || pnum > bytes) {
+            error_setg(errp, "Crucible hot-fork overlay allocation scan "
+                       "made no bounded progress");
+            return false;
+        }
+        offset += pnum;
+    }
+    *virtual_size = length;
+    return true;
+}
