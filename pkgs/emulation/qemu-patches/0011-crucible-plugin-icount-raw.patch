+uint64_t qemu_plugin_icount_raw(void)
+{
+    int64_t raw_icount;
+
+    if (!icount_enabled()) {
+        return 0;
+    }
+
+    raw_icount = icount_get_raw();
+    if (raw_icount < 0) {
+        return 0;
+    }
+    return (uint64_t)raw_icount;
+}
