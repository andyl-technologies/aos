+static Chardev *monitor_hot_fork_child_chardev(MonitorQMP *monitor)
+{
+    Chardev *chardev;
+    ChardevClass *klass;
+
+    chardev = qemu_chr_fe_get_driver(&monitor->common.chr);
+    if (!chardev || chardev->be != &monitor->common.chr ||
+        !qemu_chr_has_feature(chardev, QEMU_CHAR_FEATURE_GCONTEXT)) {
+        return NULL;
+    }
+    klass = CHARDEV_GET_CLASS(chardev);
+    if (!klass->chr_disconnect || !klass->chr_add_client) {
+        return NULL;
+    }
+    return chardev;
+}
