+                                    unsigned flags,
+                                    const uint8_t *data,
+                                    size_t size,
+                                    NetPacketSent *sent_cb)
+{
+    if (queue == NULL || sender == NULL || data == NULL || size == 0 ||
+        sent_cb == NULL) {
+        return false;
+    }
+
+    qemu_net_queue_append(queue, sender, flags, data, size, sent_cb);
+    return true;
