+/**
+ * qemu_plugin_net_inject() - inject an inbound frame into the default NIC
+ * @data: Ethernet frame bytes
+ * @len: byte length of @data
+ *
+ * This direct injection helper is intended for deterministic sim-mode plugins
+ * that have already advanced virtual time to the frame's delivery icount. It
+ * fails loudly instead of silently dropping the frame when the guest NIC cannot
+ * receive at that moment.
+ *
+ * Returns: 0 on complete delivery, nonzero on failure.
+ */
+QEMU_PLUGIN_API
+int qemu_plugin_net_inject(const uint8_t *data, size_t len);
+
+/**
+ * qemu_plugin_net_send() - queue an inbound frame for the default NIC
+ * @data: Ethernet frame bytes
+ * @len: byte length of @data
+ *
+ * The frame is appended to QEMU's incoming queue and is not made visible to the
+ * guest until qemu_plugin_net_flush() is called.
+ *
+ * Returns: 0 on successful queueing, nonzero on failure.
+ */
+QEMU_PLUGIN_API
+int qemu_plugin_net_send(const uint8_t *data, size_t len);
+
+/**
+ * qemu_plugin_net_flush() - flush queued inbound frames for the default NIC
+ *
+ * Returns: 0 when queued frames were flushed, nonzero when the default NIC is
+ * absent, link-down, or still unable to receive.
+ */
+QEMU_PLUGIN_API
+int qemu_plugin_net_flush(void);
+
+/**
+ * qemu_plugin_net_can_receive() - report whether the default NIC can receive
+ *
+ * Returns: 1 when the default NIC can receive, 0 when it is present but unable
+ * to receive, and -1 when no default NIC exists.
+ */
+QEMU_PLUGIN_API
+int qemu_plugin_net_can_receive(void);
