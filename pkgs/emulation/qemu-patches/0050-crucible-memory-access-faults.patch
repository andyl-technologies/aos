+static void test_build_rule_target(uint32_t kind, uint32_t classes,
+                                   const uint8_t *mask, size_t mask_len,
+                                   bool replacement_present,
+                                   const uint8_t *replacement,
+                                   size_t replacement_len,
+                                   bool violate_atomicity,
+                                   bool virtual_address)
+{
+    uint8_t no_device[32] = { 0 };
+    uint8_t zero = 0;
+
+    test_payload_begin(CRUCIBLE_FAULT_COMMAND_MEMORY_ACCESS_TRANSFORM, 16);
+    test_field_u64(CRUCIBLE_NODE_FAULT_FIELD_P1, test_address);
+    test_field_u64(CRUCIBLE_NODE_FAULT_FIELD_P2, mask_len);
+    test_field_u32(CRUCIBLE_NODE_FAULT_FIELD_P3, kind);
+    test_field(CRUCIBLE_NODE_FAULT_FIELD_P4,
+               CRUCIBLE_NODE_FAULT_FIELD_TYPE_BYTES,
+               mask_len ? mask : &zero, MAX(mask_len, 1));
+    test_field_bool(CRUCIBLE_NODE_FAULT_FIELD_P5, replacement_present);
+    test_field(CRUCIBLE_NODE_FAULT_FIELD_P6,
+               CRUCIBLE_NODE_FAULT_FIELD_TYPE_BYTES,
+               replacement_len ? replacement : &zero,
+               MAX(replacement_len, 1));
+    test_field_policy(CRUCIBLE_NODE_FAULT_FIELD_P7, "{\"kind\":\"every\"}");
+    test_field_u32(CRUCIBLE_NODE_FAULT_FIELD_P8, classes);
+    test_field_bool(CRUCIBLE_NODE_FAULT_FIELD_P9, violate_atomicity);
+    test_field_bool(10, false);
+    test_field(11, CRUCIBLE_NODE_FAULT_FIELD_TYPE_HASH, no_device,
+               sizeof(no_device));
+    test_payload_target(test_address, mask_len, virtual_address);
+}
+
+static void test_build_rule(uint32_t kind, uint32_t classes,
+                            const uint8_t *mask, size_t mask_len,
+                            bool replacement_present,
+                            const uint8_t *replacement,
+                            size_t replacement_len, bool violate_atomicity)
+{
+    test_build_rule_target(kind, classes, mask, mask_len,
+                           replacement_present, replacement,
+                           replacement_len, violate_atomicity, false);
+}
