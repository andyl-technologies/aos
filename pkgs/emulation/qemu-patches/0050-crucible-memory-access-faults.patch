+static bool crucible_fault_load_rules_active(MMUAccessType type)
+{
+    return type == MMU_INST_FETCH ?
+        qemu_crucible_fault_memory_fetch_rules_active() :
+        qemu_crucible_fault_memory_cpu_rules_active();
+}
