+            "{\"kind\":\"periodic\",\"parameters\":{"
+            "\"count\":1,\"first\":1,\"period\":1}}");
+    } else if (strcmp(scenario, "retry-aarch64") == 0) {
+        test_retry_scenario = true;
+        test_kind = 5;
+        policy = g_strdup_printf(
+            "{\"kind\":\"exception\",\"parameters\":{\"exception\":{"
+            "\"architecture\":\"aarch64\",\"before_instruction\":true,"
+            "\"fault_address\":%" PRIu64 ",\"maskable\":false,"
+            "\"record\":{\"kind\":\"architecture_default\"},"
+            "\"syndrome\":0,\"vector\":4}}}", test_address);
+        test_build_poison_with_occurrence(
+            policy,
+            "{\"kind\":\"periodic\",\"parameters\":{"
+            "\"count\":1,\"first\":1,\"period\":1}}");
+    } else if (strcmp(scenario, "page-table-walk") == 0) {
+        uint8_t mask[8] = { 1 };
+
+        test_kind = 2;
+        test_build_rule(2, TEST_MEMORY_PAGE_TABLE_WALK_CLASS,
+                        mask, test_length, false, NULL, 0, false);
+    } else if (strcmp(scenario, "page-table-walk-access-error") == 0) {
+        test_kind = 5;
+        test_build_poison("{\"kind\":\"access_error\"}");
+    } else if (strcmp(scenario, "page-table-walk-corrected") == 0) {
+        test_kind = 5;
+        test_build_poison(
+            "{\"kind\":\"corrected\",\"parameters\":{"
+            "\"xor_mask\":\"0002000000000000\"}}");
+    } else if (strcmp(scenario, "page-table-walk-failed-region") == 0) {
+        test_command_kind = CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE;
+        test_kind = 1;
+        test_build_region(1, test_address, test_length,
+            "{\"kind\":\"failed\",\"parameters\":{\"policy\":{\"kind\":\"access_error\"}}}");
+    } else if (strcmp(scenario, "page-table-walk-service") == 0) {
+        test_command_kind = CRUCIBLE_FAULT_COMMAND_MEMORY_SERVICE;
+        test_build_service(false);
+    } else if (strcmp(scenario, "page-table-walk-retry") == 0) {
+        test_retry_scenario = true;
+        test_kind = 5;
+        test_build_poison_with_occurrence(
+            "{\"kind\":\"access_error\"}",
+            "{\"kind\":\"periodic\",\"parameters\":{"
+            "\"count\":1,\"first\":1,\"period\":1}}");
+    } else if (test_is_nested_page_table_walk_scenario()) {
+        const uint8_t mask[8] = { 0, 2 };
+
+        test_kind = 2;
+        test_build_rule(2, TEST_MEMORY_PAGE_TABLE_WALK_CLASS,
+                        mask, sizeof(mask), false, NULL, 0, false);
+    } else if (strcmp(scenario, "invalid-mmio") == 0) {
+        const uint8_t mask = 0xff;
+        const uint8_t replacement = 0xa5;
+
+        test_address = 0xfec00000;
+        test_build_rule(1, 2, &mask, 1, true, &replacement, 1, false);
+        test_expected_rejection = CRUCIBLE_FAULT_STATUS_INVALID_TARGET;
+    } else if (strcmp(scenario, "invalid-atomic") == 0) {
+        const uint8_t mask = 0;
+        const uint8_t selector = 0xff;
+
+        test_build_rule(4, 16, &mask, 1, true, &selector, 1, true);
+        test_expected_rejection = CRUCIBLE_FAULT_STATUS_MALFORMED_COMMAND;
+    } else if (strcmp(scenario, "invalid-geometry") == 0) {
+        test_command_kind = CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE;
+        test_build_region(3, test_address, 1,
+            "{\"kind\":\"rowhammer\",\"parameters\":{\"flip_mask\":\"ff\",\"row_bytes\":64,\"threshold\":1,\"victim_distance\":0}}");
+        test_expected_rejection = CRUCIBLE_FAULT_STATUS_MALFORMED_COMMAND;
+    } else if (strcmp(scenario, "invalid-walk-virtual") == 0) {
+        uint8_t mask[8] = { 1 };
+
+        test_kind = 2;
+        test_build_rule_target(
+            2, TEST_MEMORY_PAGE_TABLE_WALK_CLASS, mask, test_length,
+            false, NULL, 0, false, true);
+        test_expected_rejection = CRUCIBLE_FAULT_STATUS_INVALID_TARGET;
+    } else if (strcmp(scenario, "invalid-walk-exception") == 0) {
+        test_kind = 5;
+        test_build_poison(
+            "{\"kind\":\"exception\",\"parameters\":{\"exception\":{"
+            "\"architecture\":\"x86_64\",\"before_instruction\":true,"
+            "\"fault_address\":null,\"maskable\":false,"
+            "\"record\":{\"kind\":\"architecture_default\"},"
+            "\"syndrome\":0,\"vector\":14}}}");
+        test_expected_rejection = CRUCIBLE_FAULT_STATUS_MALFORMED_COMMAND;
+    } else {
+        test_fail("unknown advanced scenario");
+    }
