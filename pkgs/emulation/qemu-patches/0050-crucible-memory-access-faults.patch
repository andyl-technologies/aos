+static void node_memory_dma_fragment_clear(gpointer opaque)
+{
+    CrucibleMemoryDmaFragment *fragment = opaque;
+
+    if (fragment->mr) {
+        memory_region_unref(fragment->mr);
+        fragment->mr = NULL;
+    }
+}
+
+static void node_memory_mutation_fragment_clear(gpointer opaque)
+{
+    CrucibleMemoryMutationFragment *fragment = opaque;
+
+    if (fragment->mr) {
+        memory_region_unref(fragment->mr);
+        fragment->mr = NULL;
+    }
+}
+
+static bool node_memory_mutation_plan_capture_rule(
+    QemuCrucibleFaultRule *rule)
+{
+    CrucibleMemoryTransaction *transaction = &crucible_memory_transaction;
+    uint64_t start, length;
+    uint64_t rule_offset = 0;
+
+    if (!node_rule_memory_range(rule, &start, &length)) {
+        return false;
+    }
+    while (rule_offset != length) {
+        CrucibleMemoryMutationFragment fragment = {
+            .rule = rule,
+            .rule_offset = rule_offset,
+        };
+        uint64_t translation_available;
+        hwaddr region_available;
+
+        if (!node_rule_physical_span(
+                rule, rule_offset, &fragment.gpa,
+                &translation_available)) {
+            return false;
+        }
+        region_available = MIN(length - rule_offset,
+                               translation_available);
+        if (!address_space_translate_crucible_dma(
+                &address_space_memory, fragment.gpa, &fragment.gpa,
+                &fragment.mr, &fragment.mr_addr, &region_available,
+                true, MEMTXATTRS_UNSPECIFIED) || region_available == 0) {
+            return false;
+        }
+        fragment.length = region_available;
+        if (transaction->dma_mutation_fragments->len ==
+            CRUCIBLE_NODE_MEMORY_MATCH_LIMIT) {
+            return false;
+        }
+        memory_region_ref(fragment.mr);
+        g_array_append_val(transaction->dma_mutation_fragments, fragment);
+        rule_offset += fragment.length;
+    }
+    return true;
+}
+
+static bool node_memory_mutation_plan_capture(void)
+{
+    CrucibleMemoryTransaction *transaction = &crucible_memory_transaction;
+
+    transaction->dma_mutation_fragments = g_array_new(
+        false, false, sizeof(CrucibleMemoryMutationFragment));
+    g_array_set_clear_func(transaction->dma_mutation_fragments,
+                           node_memory_mutation_fragment_clear);
+    for (guint i = 0;
+         transaction->rule_snapshot && i < transaction->rule_snapshot->len;
+         i++) {
+        QemuCrucibleFaultRule *rule =
+            g_ptr_array_index(transaction->rule_snapshot, i);
+        uint32_t kind;
+
+        if (rule->command_kind !=
+                CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE ||
+            !node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P3, &kind) ||
+            (kind != 2 && kind != 3)) {
+            continue;
+        }
+        if (!node_memory_mutation_plan_capture_rule(rule)) {
+            g_clear_pointer(&transaction->dma_mutation_fragments,
+                            g_array_unref);
+            return false;
+        }
+    }
+    return true;
+}
+
+static void node_memory_transaction_preflight_dma(
+    enum QemuCrucibleMemoryAccessClass access_class, uint32_t actor,
+    AddressSpace *as, uint64_t iova, size_t length, MemTxAttrs attrs,
+    uint64_t identity)
+{
+    g_autoptr(GHashTable) counter_rules = g_hash_table_new(
+        g_direct_hash, g_direct_equal);
+    g_autoptr(GHashTable) row_plans = g_hash_table_new_full(
+        g_direct_hash, g_direct_equal, NULL,
+        node_memory_row_resource_plan_free);
+    g_autoptr(GHashTable) retention_plans = g_hash_table_new_full(
+        g_direct_hash, g_direct_equal, NULL,
+        node_memory_retention_resource_plan_free);
+    CrucibleMemoryTransaction *transaction = &crucible_memory_transaction;
+    uint64_t current = iova;
+    size_t remaining = length;
+    bool is_write = access_class == QEMU_CRUCIBLE_MEMORY_DMA_WRITE;
+
+    if (!crucible_memory_transaction_poison) {
+        crucible_memory_transaction_poison = g_hash_table_new(
+            g_direct_hash, g_direct_equal);
+    } else {
+        g_hash_table_remove_all(crucible_memory_transaction_poison);
+    }
+    node_memory_service_plan_reset();
+    g_clear_pointer(&transaction->dma_fragments, g_array_unref);
+    g_clear_pointer(&transaction->dma_mutation_fragments, g_array_unref);
+    transaction->dma_fragments = g_array_new(
+        false, false, sizeof(CrucibleMemoryDmaFragment));
+    g_array_set_clear_func(transaction->dma_fragments,
+                           node_memory_dma_fragment_clear);
+    {
+        RCU_READ_LOCK_GUARD();
+
+        while (remaining != 0) {
+            CrucibleMemoryDmaFragment fragment = { 0 };
+            hwaddr part = remaining;
+
+            if (!address_space_translate_crucible_dma(
+                    as, current, &fragment.gpa, &fragment.mr,
+                    &fragment.mr_addr, &part, is_write, attrs)) {
+                transaction->poisoned = true;
+                break;
+            }
+            if (part == 0 || part > remaining) {
+                error_report("Invalid Crucible DMA translation span");
+                abort();
+            }
+            fragment.length = part;
+            memory_region_ref(fragment.mr);
+            g_array_append_val(transaction->dma_fragments, fragment);
+            current += part;
+            remaining -= part;
+        }
+        if (transaction->poisoned) {
+            return;
+        }
+        for (guint i = 0; i < transaction->dma_fragments->len; i++) {
+            CrucibleMemoryDmaFragment *fragment = &g_array_index(
+                transaction->dma_fragments, CrucibleMemoryDmaFragment, i);
+
+            if (!node_memory_transaction_count_segment(
+                    access_class, actor, fragment->gpa, fragment->gpa,
+                    fragment->length, false, identity)) {
+                return;
+            }
+        }
+        for (guint i = 0; i < transaction->dma_fragments->len; i++) {
+            CrucibleMemoryDmaFragment *fragment = &g_array_index(
+                transaction->dma_fragments, CrucibleMemoryDmaFragment, i);
+
+            if (!node_memory_transaction_resources_segment(
+                    access_class, actor, fragment->gpa, fragment->gpa,
+                    fragment->length, false, identity,
+                    counter_rules, row_plans, retention_plans)) {
+                transaction->poisoned = true;
+                return;
+            }
+        }
+        if (!node_memory_transaction_resources_finish(
+                counter_rules, row_plans, retention_plans)) {
+            return;
+        }
+        if (!node_memory_mutation_plan_capture()) {
+            transaction->poisoned = true;
+            return;
+        }
+        for (guint i = 0; i < transaction->dma_fragments->len; i++) {
+            CrucibleMemoryDmaFragment *fragment = &g_array_index(
+                transaction->dma_fragments, CrucibleMemoryDmaFragment, i);
+
+            node_memory_transaction_preflight_segment(
+                access_class, actor, fragment->gpa, fragment->gpa,
+                fragment->length, false, identity);
+            if (transaction->poisoned) {
+                return;
+            }
+        }
+        transaction->poison_preflighted = true;
+    }
+}
+
+static void node_memory_transaction_preflight_dma_poison(void)
+{
+    CrucibleMemoryTransaction *transaction = &crucible_memory_transaction;
+    uint64_t remaining = transaction->length;
+
+    if (transaction->poison_preflighted || transaction->poisoned) {
+        return;
+    }
+    transaction->poison_preflighted = true;
+    for (guint i = 0;
+         transaction->dma_fragments &&
+         i < transaction->dma_fragments->len && remaining != 0; i++) {
+        CrucibleMemoryDmaFragment *fragment = &g_array_index(
+            transaction->dma_fragments, CrucibleMemoryDmaFragment, i);
+        uint64_t part = MIN(remaining, fragment->length);
+
+        node_memory_transaction_preflight_segment(
+            transaction->access_class, transaction->actor,
+            fragment->gpa, fragment->gpa, part, false,
+            transaction->identity);
+        if (transaction->poisoned) {
+            return;
+        }
+        remaining -= part;
+    }
+    g_assert(remaining == 0);
+}
+
+static guint node_memory_retry_key_hash(gconstpointer opaque)
+{
+    const CrucibleMemoryRetryKey *key = opaque;
+    uint64_t hash = key->address ^ (key->length << 7) ^
+                    (key->length >> 57) ^ key->observed_icount ^
+                    (key->instruction_pc << 13) ^
+                    (key->instruction_pc >> 51) ^
+                    key->page_table_target_vaddr;
+
+    hash ^= (uint64_t)key->access_class << 32;
+    hash ^= key->actor;
+    hash ^= (uint64_t)key->instruction_ordinal << 17;
+    hash ^= (uint64_t)(uint32_t)key->page_table_level << 29;
+    hash ^= (uint64_t)key->page_table_stage << 43;
+    hash ^= (uint64_t)key->initiating_access_class << 47;
+    hash ^= (uint64_t)key->has_instruction << 61;
+    hash ^= (uint64_t)key->streaming << 62;
+    hash ^= hash >> 33;
+    hash *= UINT64_C(0xff51afd7ed558ccd);
+    hash ^= hash >> 33;
+    return hash ^ (hash >> 32);
+}
+
+static gboolean node_memory_retry_key_equal(gconstpointer left_opaque,
+                                             gconstpointer right_opaque)
+{
+    const CrucibleMemoryRetryKey *left = left_opaque;
+    const CrucibleMemoryRetryKey *right = right_opaque;
+
+    return left->address == right->address &&
+           left->length == right->length &&
+           left->observed_icount == right->observed_icount &&
+           left->instruction_pc == right->instruction_pc &&
+           left->page_table_target_vaddr == right->page_table_target_vaddr &&
+           left->access_class == right->access_class &&
+           left->actor == right->actor &&
+           left->instruction_ordinal == right->instruction_ordinal &&
+           left->page_table_level == right->page_table_level &&
+           left->page_table_stage == right->page_table_stage &&
+           left->initiating_access_class == right->initiating_access_class &&
+           left->has_instruction == right->has_instruction &&
+           left->streaming == right->streaming;
+}
+
+static CrucibleMemoryRetryKey node_memory_retry_key(
+    const CrucibleMemoryTransaction *transaction)
+{
+    /*
+     * An instruction-backed retry is independent of elapsed virtual time and
+     * translation-block shape.  Accesses without a decoded instruction use
+     * the observed clock as their only available execution-episode identity.
+     */
+    return (CrucibleMemoryRetryKey) {
+        .address = transaction->address,
+        .length = transaction->streaming ? 0 : transaction->preflight_length,
+        .observed_icount = transaction->has_instruction ? 0 :
+                           transaction->observed_icount,
+        .instruction_pc = transaction->instruction_pc,
+        .page_table_target_vaddr =
+            transaction->page_table_target_vaddr,
+        .access_class = transaction->access_class,
+        .actor = transaction->actor,
+        .instruction_ordinal = transaction->instruction_ordinal,
+        .page_table_level = transaction->page_table_level,
+        .page_table_stage = transaction->page_table_stage,
+        .initiating_access_class = transaction->initiating_access_class,
+        .has_instruction = transaction->has_instruction,
+        .streaming = transaction->streaming,
+    };
+}
+
+static void node_memory_retry_evict_oldest(void)
+{
+    GHashTableIter iter;
+    gpointer key;
+    gpointer value;
+    gpointer oldest_key = NULL;
+    uint64_t oldest_sequence = UINT64_MAX;
+
+    g_hash_table_iter_init(&iter, crucible_memory_retry_states);
+    while (g_hash_table_iter_next(&iter, &key, &value)) {
+        CrucibleMemoryRetryState *state = value;
+
+        if (state->last_access_sequence < oldest_sequence) {
+            oldest_key = key;
+            oldest_sequence = state->last_access_sequence;
+        }
+    }
+    g_assert(oldest_key);
+    g_hash_table_remove(crucible_memory_retry_states, oldest_key);
+}
+
+static void node_memory_retry_finish(
+    const CrucibleMemoryTransaction *transaction)
+{
+    CrucibleMemoryRetryKey key = node_memory_retry_key(transaction);
+    CrucibleMemoryRetryState *state = g_hash_table_lookup(
+        crucible_memory_retry_states, &key);
+
+    if (!transaction->poisoned) {
+        if (state) {
+            g_hash_table_remove(crucible_memory_retry_states, &key);
+        }
+        return;
+    }
+    if (!state) {
+        CrucibleMemoryRetryKey *stored_key;
+
+        if (g_hash_table_size(crucible_memory_retry_states) ==
+            CRUCIBLE_NODE_MEMORY_RETRY_LIMIT) {
+            node_memory_retry_evict_oldest();
+        }
+        stored_key = g_new(CrucibleMemoryRetryKey, 1);
+        *stored_key = key;
+        state = g_new0(CrucibleMemoryRetryState, 1);
+        g_hash_table_insert(crucible_memory_retry_states, stored_key, state);
+    }
+    state->last_access_sequence = transaction->identity;
+    state->retry_ordinal = transaction->retry_ordinal;
+}
+
+static void node_memory_transaction_begin(
+    enum QemuCrucibleMemoryAccessClass access_class, uint32_t actor,
+    uint64_t address, size_t length, uint64_t observed_icount,
+    bool has_instruction, uint64_t instruction_pc,
+    uint32_t instruction_ordinal,
+    bool streaming, bool automatic_preflight,
+    const CrucibleMemoryPageTableIdentity *page_table)
+{
+    CrucibleMemoryTransaction *transaction = &crucible_memory_transaction;
+    CrucibleMemoryRetryKey retry_key;
+    CrucibleMemoryRetryState *retry_state;
+
+    if (!qemu_crucible_fault_memory_rules_active()) {
+        return;
+    }
+    qemu_mutex_lock(&crucible_memory_transaction_lock);
+    if (transaction->active) {
+        error_report("Nested Crucible memory transaction is ambiguous");
+        abort();
+    }
+    if ((!streaming && length == 0) ||
+        (length != 0 && address > UINT64_MAX - (length - 1))) {
+        error_report("Crucible memory transaction range is invalid");
+        abort();
+    }
+    if (crucible_memory_access_sequence == UINT64_MAX) {
+        error_report("Crucible memory transaction sequence overflow");
+        abort();
+    }
+    memset(transaction, 0, sizeof(*transaction));
+    if (crucible_memory_pending_services) {
+        g_array_set_size(crucible_memory_pending_services, 0);
+        g_hash_table_remove_all(crucible_memory_pending_service_index);
+    }
+    if (!crucible_memory_transaction_poison) {
+        crucible_memory_transaction_poison = g_hash_table_new(
+            g_direct_hash, g_direct_equal);
+    } else {
+        g_hash_table_remove_all(crucible_memory_transaction_poison);
+    }
+    node_memory_service_plan_reset();
+    if (crucible_memory_transaction_occurrences) {
+        g_hash_table_remove_all(crucible_memory_transaction_occurrences);
+    }
+    if (crucible_memory_transaction_rows) {
+        g_hash_table_remove_all(crucible_memory_transaction_rows);
+    }
+    if (crucible_memory_transaction_state_opportunities) {
+        g_hash_table_remove_all(
+            crucible_memory_transaction_state_opportunities);
+    }
+    if (crucible_memory_transaction_state_applied) {
+        g_hash_table_remove_all(crucible_memory_transaction_state_applied);
+    }
+    transaction->active = true;
+    transaction->lock_held = true;
+    transaction->access_class = access_class;
+    transaction->actor = actor;
+    transaction->address = address;
+    transaction->length = length;
+    transaction->preflight_length = length;
+    transaction->observed_icount = observed_icount;
+    transaction->has_instruction = has_instruction;
+    transaction->streaming = streaming;
+    transaction->instruction_pc = instruction_pc;
+    transaction->instruction_ordinal = instruction_ordinal;
+    if (page_table) {
+        transaction->page_table_target_vaddr = page_table->target_vaddr;
+        transaction->page_table_level = page_table->level;
+        transaction->page_table_stage = page_table->stage;
+        transaction->initiating_access_class =
+            page_table->initiating_access_class;
+    }
+    transaction->identity = ++crucible_memory_access_sequence;
+    transaction->event_count_start = crucible_node_event_count;
+    if (!crucible_memory_retry_states) {
+        crucible_memory_retry_states = g_hash_table_new_full(
+            node_memory_retry_key_hash, node_memory_retry_key_equal,
+            g_free, g_free);
+    }
+    retry_key = node_memory_retry_key(transaction);
+    retry_state = g_hash_table_lookup(crucible_memory_retry_states,
+                                      &retry_key);
+    if (retry_state) {
+        if (retry_state->retry_ordinal == UINT32_MAX) {
+            error_report("Crucible memory retry ordinal overflow");
+            abort();
+        }
+        transaction->retry_ordinal = retry_state->retry_ordinal + 1;
+    }
+    if (!streaming && automatic_preflight) {
+        node_memory_transaction_preflight(access_class, actor, address,
+                                          length, transaction->identity);
+    }
+}
+
+void qemu_crucible_fault_memory_transaction_begin(
+    enum QemuCrucibleMemoryAccessClass access_class, uint32_t actor,
+    uint64_t address, size_t length, uint64_t observed_icount,
+    bool has_instruction, uint64_t instruction_pc,
+    uint32_t instruction_ordinal)
+{
+    node_memory_transaction_begin(
+        access_class, actor, address, length, observed_icount,
+        has_instruction, instruction_pc, instruction_ordinal, false, true,
+        NULL);
+}
+
+void qemu_crucible_fault_memory_dma_transaction_begin(
+    enum QemuCrucibleMemoryAccessClass access_class, uint32_t actor,
+    AddressSpace *as, uint64_t iova, size_t length, MemTxAttrs attrs,
+    uint64_t observed_icount)
+{
+    if ((access_class != QEMU_CRUCIBLE_MEMORY_DMA_READ &&
+         access_class != QEMU_CRUCIBLE_MEMORY_DMA_WRITE) || !as) {
+        error_report("Invalid Crucible DMA memory transaction");
+        abort();
+    }
+    node_memory_transaction_begin(
+        access_class, actor, iova, length, observed_icount,
+        false, 0, 0, false, false, NULL);
+    if (crucible_memory_transaction.active) {
+        node_memory_transaction_preflight_dma(
+            access_class, actor, as, iova, length, attrs,
+            crucible_memory_transaction.identity);
+    }
+}
+
+void qemu_crucible_fault_memory_fetch_transaction_begin(
+    uint32_t actor, uint64_t address, uint64_t observed_icount,
+    uint64_t instruction_pc, uint32_t instruction_ordinal)
+{
+    node_memory_transaction_begin(
+        QEMU_CRUCIBLE_MEMORY_FETCH, actor, address, 0, observed_icount,
+        true, instruction_pc, instruction_ordinal, true, true, NULL);
+}
+
+bool qemu_crucible_fault_memory_fetch_transaction_extend(
+    uint64_t vaddr, uint64_t gpa, size_t length)
+{
+    CrucibleMemoryTransaction *transaction = &crucible_memory_transaction;
+    uint64_t end;
+
+    if (!transaction->active ||
+        transaction->access_class != QEMU_CRUCIBLE_MEMORY_FETCH ||
+        length == 0 || vaddr < transaction->address ||
+        vaddr > UINT64_MAX - length) {
+        error_report("Invalid Crucible instruction fetch fragment");
+        abort();
+    }
+    end = vaddr + length;
+    transaction->length = MAX(transaction->length,
+                              end - transaction->address);
+    transaction->preflight_length = transaction->length;
+    if (!transaction->fetch_fragments) {
+        transaction->fetch_fragments = g_array_new(
+            false, false, sizeof(CrucibleMemoryFetchFragment));
+    }
+    CrucibleMemoryFetchFragment fragment = {
+        .vaddr = vaddr,
+        .gpa = gpa,
+        .length = length,
+    };
+
+    g_array_append_val(transaction->fetch_fragments, fragment);
+    if (!node_memory_transaction_count_segment(
+            QEMU_CRUCIBLE_MEMORY_FETCH, transaction->actor, vaddr, gpa,
+            length, true, transaction->identity)) {
+        return false;
+    }
+    return true;
+}
+
+bool qemu_crucible_fault_memory_transaction_failed(void)
+{
+    return crucible_memory_transaction.active &&
+           crucible_memory_transaction.poisoned;
+}
+
+bool qemu_crucible_fault_memory_transaction_active(
+    enum QemuCrucibleMemoryAccessClass access_class)
+{
+    return crucible_memory_transaction.active &&
+           crucible_memory_transaction.access_class == access_class &&
+           crucible_memory_transaction.rule_snapshot &&
+           crucible_memory_transaction.rule_snapshot->len != 0;
+}
+
+bool qemu_crucible_fault_memory_transaction_exception(
+    CPUFaultException *exception)
+{
+    if (!crucible_memory_transaction.active ||
+        !crucible_memory_transaction.has_exception) {
+        return false;
+    }
+    *exception = crucible_memory_transaction.exception;
+    return true;
+}
+
+QemuCrucibleMemoryTransactionToken *
+qemu_crucible_fault_memory_transaction_detach(void)
+{
+    QemuCrucibleMemoryTransactionToken *token;
+    size_t emitted;
+
+    if (!crucible_memory_transaction.active) {
+        return NULL;
+    }
+    if (!crucible_memory_transaction.streaming &&
+        crucible_memory_pending_services &&
+        crucible_memory_pending_services->len != 0) {
+        error_report("Cannot detach a partially applied Crucible transaction");
+        abort();
+    }
+    token = g_new0(QemuCrucibleMemoryTransactionToken, 1);
+    token->transaction = crucible_memory_transaction;
+    token->poison = crucible_memory_transaction_poison;
+    crucible_memory_transaction_poison = NULL;
+    token->occurrences = crucible_memory_transaction_occurrences;
+    crucible_memory_transaction_occurrences = NULL;
+    token->rows = crucible_memory_transaction_rows;
+    crucible_memory_transaction_rows = NULL;
+    token->state_opportunities =
+        crucible_memory_transaction_state_opportunities;
+    crucible_memory_transaction_state_opportunities = NULL;
+    token->state_applied = crucible_memory_transaction_state_applied;
+    crucible_memory_transaction_state_applied = NULL;
+    token->service_plan = crucible_memory_service_plan;
+    token->service_plan_index = crucible_memory_service_plan_index;
+    crucible_memory_service_plan = NULL;
+    crucible_memory_service_plan_index = NULL;
+    token->pending_services = crucible_memory_pending_services;
+    token->pending_service_index = crucible_memory_pending_service_index;
+    crucible_memory_pending_services = NULL;
+    crucible_memory_pending_service_index = NULL;
+    emitted = crucible_node_event_count -
+              token->transaction.event_count_start;
+    emitted = MIN(emitted, token->transaction.event_budget);
+    token->reserved_events = token->transaction.event_budget - emitted;
+    if (crucible_node_event_reserved > SIZE_MAX - token->reserved_events) {
+        error_report("Crucible detached event reservation overflow");
+        abort();
+    }
+    crucible_node_event_reserved += token->reserved_events;
+    memset(&crucible_memory_transaction, 0,
+           sizeof(crucible_memory_transaction));
+    if (!token->transaction.streaming) {
+        token->transaction.lock_held = false;
+        qemu_mutex_unlock(&crucible_memory_transaction_lock);
+    }
+    return token;
+}
+
+void qemu_crucible_fault_memory_transaction_resume(
+    QemuCrucibleMemoryTransactionToken *token)
+{
+    if (!token) {
+        error_report("Crucible detached transaction cannot be resumed");
+        abort();
+    }
+    if (!token->transaction.lock_held) {
+        qemu_mutex_lock(&crucible_memory_transaction_lock);
+        token->transaction.lock_held = true;
+    }
+    if (crucible_memory_transaction.active ||
+        crucible_node_event_reserved < token->reserved_events) {
+        error_report("Crucible detached transaction cannot be resumed");
+        abort();
+    }
+    crucible_node_event_reserved -= token->reserved_events;
+    if (crucible_memory_transaction_poison) {
+        g_hash_table_unref(crucible_memory_transaction_poison);
+    }
+    g_clear_pointer(&crucible_memory_transaction_occurrences,
+                    g_hash_table_unref);
+    g_clear_pointer(&crucible_memory_transaction_rows,
+                    g_hash_table_unref);
+    g_clear_pointer(&crucible_memory_transaction_state_opportunities,
+                    g_hash_table_unref);
+    g_clear_pointer(&crucible_memory_transaction_state_applied,
+                    g_hash_table_unref);
+    g_clear_pointer(&crucible_memory_service_plan, g_array_unref);
+    g_clear_pointer(&crucible_memory_service_plan_index,
+                    g_hash_table_unref);
+    g_clear_pointer(&crucible_memory_pending_services, g_array_unref);
+    g_clear_pointer(&crucible_memory_pending_service_index,
+                    g_hash_table_unref);
+    crucible_memory_transaction_poison = token->poison;
+    token->poison = NULL;
+    crucible_memory_transaction_occurrences = token->occurrences;
+    token->occurrences = NULL;
+    crucible_memory_transaction_rows = token->rows;
+    token->rows = NULL;
+    crucible_memory_transaction_state_opportunities =
+        token->state_opportunities;
+    token->state_opportunities = NULL;
+    crucible_memory_transaction_state_applied = token->state_applied;
+    token->state_applied = NULL;
+    crucible_memory_service_plan = token->service_plan;
+    token->service_plan = NULL;
+    crucible_memory_service_plan_index = token->service_plan_index;
+    token->service_plan_index = NULL;
+    crucible_memory_pending_services = token->pending_services;
+    token->pending_services = NULL;
+    crucible_memory_pending_service_index = token->pending_service_index;
+    token->pending_service_index = NULL;
+    crucible_memory_transaction = token->transaction;
+    g_free(token);
+}
+
+void qemu_crucible_fault_memory_transaction_discard(
+    QemuCrucibleMemoryTransactionToken *token)
+{
+    if (!token) {
+        error_report("Crucible detached transaction cannot be discarded");
+        abort();
+    }
+    if (!token->transaction.lock_held) {
+        qemu_mutex_lock(&crucible_memory_transaction_lock);
+        token->transaction.lock_held = true;
+    }
+    if (crucible_memory_transaction.active ||
+        crucible_node_event_reserved < token->reserved_events) {
+        error_report("Crucible detached transaction cannot be discarded");
+        abort();
+    }
+    crucible_node_event_reserved -= token->reserved_events;
+    if (token->poison) {
+        g_hash_table_unref(token->poison);
+    }
+    g_clear_pointer(&token->occurrences, g_hash_table_unref);
+    g_clear_pointer(&token->rows, g_hash_table_unref);
+    g_clear_pointer(&token->state_opportunities, g_hash_table_unref);
+    g_clear_pointer(&token->state_applied, g_hash_table_unref);
+    node_memory_reservations_release(&token->transaction);
+    g_clear_pointer(&token->transaction.rule_snapshot, g_ptr_array_unref);
+    g_clear_pointer(&token->transaction.dma_fragments, g_array_unref);
+    g_clear_pointer(&token->transaction.dma_mutation_fragments,
+                    g_array_unref);
+    g_clear_pointer(&token->transaction.fetch_fragments, g_array_unref);
+    g_clear_pointer(&token->transaction.rule_reservations, g_array_unref);
+    g_clear_pointer(&token->transaction.row_reservations, g_array_unref);
+    g_clear_pointer(&token->transaction.retention_reservations,
+                    g_array_unref);
+    g_clear_pointer(&token->transaction.ledger_reservations, g_array_unref);
+    g_clear_pointer(&token->transaction.shadow_originals,
+                    g_hash_table_unref);
+    g_clear_pointer(&token->transaction.shadow_rules, g_hash_table_unref);
+    g_clear_pointer(&token->transaction.shadow_writes, g_array_unref);
+    g_clear_pointer(&token->transaction.staged_events, g_ptr_array_unref);
+    g_clear_pointer(&token->service_plan, g_array_unref);
+    g_clear_pointer(&token->service_plan_index, g_hash_table_unref);
+    g_clear_pointer(&token->pending_services, g_array_unref);
+    g_clear_pointer(&token->pending_service_index, g_hash_table_unref);
+    if (token->transaction.lock_held) {
+        qemu_mutex_unlock(&crucible_memory_transaction_lock);
+    }
+    g_free(token);
+}
+
+void qemu_crucible_fault_memory_transaction_resize(size_t length)
+{
+    CrucibleMemoryTransaction *transaction = &crucible_memory_transaction;
+
+    if (!transaction->active) {
+        return;
+    }
+    if (transaction->access_class != QEMU_CRUCIBLE_MEMORY_DMA_WRITE ||
+        length > transaction->preflight_length) {
+        error_report("Invalid Crucible mapped-DMA transaction length");
+        abort();
+    }
+    transaction->length = length;
+    if (length == transaction->preflight_length) {
+        return;
+    }
+    node_memory_reservations_release(transaction);
+    g_clear_pointer(&transaction->rule_reservations, g_array_unref);
+    g_clear_pointer(&transaction->row_reservations, g_array_unref);
+    g_clear_pointer(&transaction->retention_reservations, g_array_unref);
+    g_clear_pointer(&transaction->ledger_reservations, g_array_unref);
+    transaction->resources_preflighted = false;
+    node_memory_service_plan_reset();
+    if (length == 0) {
+        return;
+    }
+
+    g_autoptr(GHashTable) counter_rules = g_hash_table_new(
+        g_direct_hash, g_direct_equal);
+    g_autoptr(GHashTable) row_plans = g_hash_table_new_full(
+        g_direct_hash, g_direct_equal, NULL,
+        node_memory_row_resource_plan_free);
+    g_autoptr(GHashTable) retention_plans = g_hash_table_new_full(
+        g_direct_hash, g_direct_equal, NULL,
+        node_memory_retention_resource_plan_free);
+    uint64_t plan_offset = 0;
+    uint64_t remaining = length;
+
+    for (guint i = 0;
+         transaction->dma_fragments &&
+         i < transaction->dma_fragments->len && remaining != 0; i++) {
+        CrucibleMemoryDmaFragment *fragment = &g_array_index(
+            transaction->dma_fragments, CrucibleMemoryDmaFragment, i);
+        uint64_t part = MIN(remaining, fragment->length);
+
+        if (!node_memory_transaction_resources_segment(
+                transaction->access_class, transaction->actor,
+                fragment->gpa, fragment->gpa, part, false,
+                transaction->identity, counter_rules, row_plans,
+                retention_plans)) {
+            error_report(
+                "Crucible reduced DMA reservation unexpectedly failed");
+            abort();
+        }
+        plan_offset += part;
+        remaining -= part;
+    }
+    g_assert(plan_offset == length && remaining == 0);
+    if (!node_memory_transaction_resources_finish(
+            counter_rules, row_plans, retention_plans)) {
+        error_report("Crucible reduced DMA resource commit failed");
+        abort();
+    }
+}
+
+static void node_memory_fetch_transaction_commit(void)
+{
+    CrucibleMemoryTransaction *transaction = &crucible_memory_transaction;
+
+    g_assert(transaction->active && transaction->streaming &&
+             !transaction->poisoned);
+    if (transaction->shadow_rules) {
+        GHashTableIter iter;
+        gpointer original;
+        gpointer shadow;
+
+        g_hash_table_iter_init(&iter, transaction->shadow_rules);
+        while (g_hash_table_iter_next(&iter, &original, &shadow)) {
+            node_memory_shadow_state_commit(original, shadow);
+        }
+    }
+    for (guint i = 0;
+         transaction->shadow_writes &&
+         i < transaction->shadow_writes->len; i++) {
+        CrucibleMemoryShadowWrite *write = &g_array_index(
+            transaction->shadow_writes, CrucibleMemoryShadowWrite, i);
+
+        memory_region_fault_commit_ram(
+            write->mr, write->mr_addr, write->value->data,
+            write->value->len);
+    }
+    for (guint i = 0;
+         transaction->staged_events &&
+         i < transaction->staged_events->len; i++) {
+        CrucibleMemoryStagedEvent *event = g_ptr_array_index(
+            transaction->staged_events, i);
+
+        qemu_crucible_fault_rule_event(
+            event->rule, event->outcome, event->observed_icount,
+            event->opportunity_hash, event->before_hash,
+            event->after_hash, event->evidence->data,
+            event->evidence->len);
+        qemu_crucible_fault_notify_events();
+    }
+}
+
+bool qemu_crucible_fault_memory_fetch_transaction_finish(void)
+{
+    CrucibleMemoryTransaction *transaction = &crucible_memory_transaction;
+    g_autoptr(GHashTable) counter_rules = g_hash_table_new(
+        g_direct_hash, g_direct_equal);
+    g_autoptr(GHashTable) row_plans = g_hash_table_new_full(
+        g_direct_hash, g_direct_equal, NULL,
+        node_memory_row_resource_plan_free);
+    g_autoptr(GHashTable) retention_plans = g_hash_table_new_full(
+        g_direct_hash, g_direct_equal, NULL,
+        node_memory_retention_resource_plan_free);
+    size_t staged_count = transaction->staged_events ?
+        transaction->staged_events->len : 0;
+    size_t service_count = crucible_memory_pending_services ?
+        crucible_memory_pending_services->len : 0;
+
+    if (!transaction->active) {
+        return true;
+    }
+    if (!transaction->streaming) {
+        error_report("Crucible fetch finish used outside a fetch transaction");
+        abort();
+    }
+    if (staged_count > SIZE_MAX - service_count) {
+        error_report("Crucible fetch event count overflow");
+        abort();
+    }
+    if (staged_count + service_count != 0) {
+        QemuCrucibleFaultRule *rule = transaction->rule_snapshot &&
+            transaction->rule_snapshot->len != 0 ?
+            g_ptr_array_index(transaction->rule_snapshot, 0) : NULL;
+
+        g_assert(rule);
+        node_memory_boundary_match(rule, transaction->identity);
+        crucible_memory_preflight_collecting = true;
+        bool available = node_memory_event_capacity(
+            rule, staged_count + service_count,
+            QEMU_CRUCIBLE_MEMORY_FETCH, transaction->actor,
+            transaction->address, transaction->address,
+            transaction->length, transaction->observed_icount);
+        crucible_memory_preflight_collecting = false;
+        node_memory_boundary_match_done();
+        if (!available) {
+            transaction->poisoned = true;
+            transaction->resource_failed = true;
+            transaction->has_exception = false;
+            return false;
+        }
+    }
+    node_memory_service_plan_reset();
+    for (guint i = 0;
+         transaction->fetch_fragments &&
+         i < transaction->fetch_fragments->len; i++) {
+        CrucibleMemoryFetchFragment *fragment = &g_array_index(
+            transaction->fetch_fragments, CrucibleMemoryFetchFragment, i);
+
+        if (!node_memory_transaction_resources_segment(
+                QEMU_CRUCIBLE_MEMORY_FETCH, transaction->actor,
+                fragment->vaddr, fragment->gpa, fragment->length, true,
+                transaction->identity, counter_rules, row_plans,
+                retention_plans)) {
+            transaction->poisoned = true;
+            transaction->resource_failed = true;
+            transaction->has_exception = false;
+            return false;
+        }
+    }
+    if (!node_memory_transaction_resources_finish(
+            counter_rules, row_plans, retention_plans)) {
+        return false;
+    }
+
+    transaction->resources_preflighted = true;
+    return true;
+}
+
+void qemu_crucible_fault_memory_fetch_transaction_stage(CPUState *cpu)
+{
+    if (!cpu || cpu->crucible_fetch_transaction ||
+        !crucible_memory_transaction.active ||
+        !crucible_memory_transaction.streaming ||
+        crucible_memory_transaction.poisoned) {
+        error_report("Invalid Crucible fetch transaction staging");
+        abort();
+    }
+    cpu->crucible_fetch_transaction =
+        qemu_crucible_fault_memory_transaction_detach();
+    g_assert(cpu->crucible_fetch_transaction);
+}
+
+void qemu_crucible_fault_memory_fetch_stage_commit(CPUState *cpu)
+{
+    QemuCrucibleMemoryTransactionToken *token;
+
+    if (!cpu || !cpu->crucible_fetch_transaction) {
+        return;
+    }
+    token = cpu->crucible_fetch_transaction;
+    cpu->crucible_fetch_transaction = NULL;
+    qemu_crucible_fault_memory_transaction_resume(token);
+    node_memory_fetch_transaction_commit();
+    qemu_crucible_fault_memory_transaction_end();
+}
+
+void qemu_crucible_fault_memory_fetch_stage_discard(CPUState *cpu)
+{
+    QemuCrucibleMemoryTransactionToken *token;
+
+    if (!cpu || !cpu->crucible_fetch_transaction) {
+        return;
+    }
+    token = cpu->crucible_fetch_transaction;
+    cpu->crucible_fetch_transaction = NULL;
+    if (!token->transaction.streaming ||
+        token->transaction.identity == 0 ||
+        crucible_memory_access_sequence != token->transaction.identity) {
+        error_report("Invalid Crucible fetch transaction rollback");
+        abort();
+    }
+    crucible_memory_access_sequence--;
+    qemu_crucible_fault_memory_transaction_discard(token);
+}
+
+void qemu_crucible_fault_memory_transaction_end(void)
+{
+    GPtrArray *snapshot;
+    GArray *dma_fragments;
+    GArray *dma_mutation_fragments;
+    GArray *rule_reservations;
+    GArray *row_reservations;
+    GArray *retention_reservations;
+    GArray *ledger_reservations;
+    GArray *fetch_fragments;
+    GHashTable *shadow_rules;
+    GHashTable *shadow_originals;
+    GArray *shadow_writes;
+    GPtrArray *staged_events;
+    uint64_t service_delay = 0;
+    bool lock_held;
+
+    if (!crucible_memory_transaction.active) {
+        return;
+    }
+    if (!crucible_memory_transaction.poisoned) {
+        service_delay = node_memory_service_finish_transaction();
+    }
+    snapshot = crucible_memory_transaction.rule_snapshot;
+    crucible_memory_transaction.rule_snapshot = NULL;
+    dma_fragments = crucible_memory_transaction.dma_fragments;
+    crucible_memory_transaction.dma_fragments = NULL;
+    dma_mutation_fragments =
+        crucible_memory_transaction.dma_mutation_fragments;
+    crucible_memory_transaction.dma_mutation_fragments = NULL;
+    node_memory_reservations_release(&crucible_memory_transaction);
+    rule_reservations = crucible_memory_transaction.rule_reservations;
+    crucible_memory_transaction.rule_reservations = NULL;
+    row_reservations = crucible_memory_transaction.row_reservations;
+    crucible_memory_transaction.row_reservations = NULL;
+    retention_reservations =
+        crucible_memory_transaction.retention_reservations;
+    crucible_memory_transaction.retention_reservations = NULL;
+    ledger_reservations =
+        crucible_memory_transaction.ledger_reservations;
+    crucible_memory_transaction.ledger_reservations = NULL;
+    fetch_fragments = crucible_memory_transaction.fetch_fragments;
+    crucible_memory_transaction.fetch_fragments = NULL;
+    shadow_rules = crucible_memory_transaction.shadow_rules;
+    crucible_memory_transaction.shadow_rules = NULL;
+    shadow_originals = crucible_memory_transaction.shadow_originals;
+    crucible_memory_transaction.shadow_originals = NULL;
+    shadow_writes = crucible_memory_transaction.shadow_writes;
+    crucible_memory_transaction.shadow_writes = NULL;
+    staged_events = crucible_memory_transaction.staged_events;
+    crucible_memory_transaction.staged_events = NULL;
+    lock_held = crucible_memory_transaction.lock_held;
+    node_memory_retry_finish(&crucible_memory_transaction);
+    node_memory_service_plan_reset();
+    g_clear_pointer(&snapshot, g_ptr_array_unref);
+    g_clear_pointer(&dma_fragments, g_array_unref);
+    g_clear_pointer(&dma_mutation_fragments, g_array_unref);
+    g_clear_pointer(&rule_reservations, g_array_unref);
+    g_clear_pointer(&row_reservations, g_array_unref);
+    g_clear_pointer(&retention_reservations, g_array_unref);
+    g_clear_pointer(&ledger_reservations, g_array_unref);
+    g_clear_pointer(&fetch_fragments, g_array_unref);
+    g_clear_pointer(&shadow_originals, g_hash_table_unref);
+    g_clear_pointer(&shadow_rules, g_hash_table_unref);
+    g_clear_pointer(&shadow_writes, g_array_unref);
+    g_clear_pointer(&staged_events, g_ptr_array_unref);
+    memset(&crucible_memory_transaction, 0,
+           sizeof(crucible_memory_transaction));
+    if (lock_held) {
+        qemu_mutex_unlock(&crucible_memory_transaction_lock);
+    }
+    if (service_delay != 0 && current_cpu && current_cpu->running &&
+        !current_cpu->neg.can_do_io) {
+        if (current_cpu->crucible_memory_service_nanos >
+            UINT64_MAX - service_delay) {
+            error_report("Crucible memory service staging overflow");
+            abort();
+        }
+        current_cpu->crucible_memory_service_nanos += service_delay;
+        qatomic_set_mb(&current_cpu->exit_request, 1);
+    } else {
+        node_memory_apply_service(service_delay);
+    }
+}
+
+static bool node_memory_runtime_resources_ready(
+    size_t match_count, uint32_t access_class, uint32_t vcpu,
+    uint64_t vaddr, uint64_t gpa, size_t length, uint64_t observed_icount)
+{
+    QemuCrucibleFaultRule *service_rule = NULL;
+
+    if (crucible_memory_transaction.active &&
+        crucible_memory_transaction.poisoned) {
+        return false;
+    }
+    if (crucible_memory_transaction.active &&
+        crucible_memory_transaction.streaming) {
+        return true;
+    }
+    if (crucible_memory_transaction.active &&
+        crucible_memory_transaction.resources_preflighted) {
+        return true;
+    }
+    if (!crucible_memory_transaction.active) {
+        node_memory_service_plan_reset();
+    }
+    for (size_t i = 0; i < match_count; i++) {
+        QemuCrucibleFaultRule *rule = crucible_memory_matches[i];
+        size_t offset, selected;
+        uint64_t rule_offset;
+
+        if (!node_rule_memory_overlap(rule, vcpu, vaddr, gpa, length,
+                                      &offset, &selected, &rule_offset)) {
+            continue;
+        }
+        if (rule->command_kind ==
+            CRUCIBLE_FAULT_COMMAND_MEMORY_ACCESS_TRANSFORM) {
+            uint32_t classes;
+
+            g_assert(node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P8,
+                                    &classes));
+            if ((classes & access_class) == 0) {
+                continue;
+            }
+        }
+        if (!node_memory_rule_resources_ready(rule)) {
+            node_memory_counter_terminal_metadata(UINT64_MAX);
+            node_memory_resource_terminal(
+                rule, access_class, vcpu, vaddr + offset, gpa + offset,
+                selected, observed_icount);
+            return false;
+        }
+        if (rule->command_kind ==
+            CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE) {
+            uint32_t kind;
+
+            g_assert(node_field_u32(rule,
+                                    CRUCIBLE_NODE_FAULT_FIELD_P3,
+                                    &kind));
+            if (kind == 3) {
+                QDict *process = qobject_to(
+                    QDict, node_field(rule,
+                        CRUCIBLE_NODE_FAULT_FIELD_P4)->json);
+                QDict *parameters = qdict_get_qdict(
+                    process, "parameters");
+
+                if (!node_memory_rowhammer_resources_ready(
+                        rule, parameters, rule_offset, selected)) {
+                    node_memory_resource_terminal(
+                        rule, access_class, vcpu, vaddr + offset,
+                        gpa + offset, selected, observed_icount);
+                    return false;
+                }
+            }
+        }
+        if (rule->command_kind == CRUCIBLE_FAULT_COMMAND_MEMORY_SERVICE) {
+            service_rule = rule;
+            if (!node_memory_service_plan_add(rule, selected)) {
+                node_memory_resource_terminal(
+                    rule, access_class, vcpu, vaddr + offset, gpa + offset,
+                    selected, observed_icount);
+                return false;
+            }
+        }
+    }
+    if (service_rule && !node_memory_service_plan_valid()) {
+        node_memory_resource_terminal(
+            service_rule, access_class, vcpu, vaddr, gpa, length,
+            observed_icount);
+        return false;
+    }
+    return true;
+}
+
+bool qemu_crucible_fault_memory_dma_fragment(
+    uint64_t offset, MemoryRegion **mr, uint64_t *mr_addr,
+    uint64_t *gpa, size_t *length)
+{
+    CrucibleMemoryTransaction *transaction = &crucible_memory_transaction;
+    uint64_t plan_offset = 0;
+
+    if (!mr || !mr_addr || !gpa || !length || *length == 0 ||
+        !transaction->active ||
+        (transaction->access_class != QEMU_CRUCIBLE_MEMORY_DMA_READ &&
+         transaction->access_class != QEMU_CRUCIBLE_MEMORY_DMA_WRITE) ||
+        !transaction->dma_fragments || offset >= transaction->length) {
+        return false;
+    }
+    node_memory_transaction_preflight_dma_poison();
+    if (transaction->poisoned) {
+        return false;
+    }
+    for (guint i = 0; i < transaction->dma_fragments->len; i++) {
+        CrucibleMemoryDmaFragment *fragment = &g_array_index(
+            transaction->dma_fragments, CrucibleMemoryDmaFragment, i);
+        uint64_t fragment_end;
+        uint64_t within;
+
+        if (plan_offset > UINT64_MAX - fragment->length) {
+            error_report("Crucible DMA fragment plan overflow");
+            abort();
+        }
+        fragment_end = plan_offset + fragment->length;
+        if (offset >= fragment_end) {
+            plan_offset = fragment_end;
+            continue;
+        }
+        within = offset - plan_offset;
+        if (fragment->gpa > UINT64_MAX - within ||
+            fragment->mr_addr > UINT64_MAX - within) {
+            error_report("Crucible DMA frozen fragment overflow");
+            abort();
+        }
+        *mr = fragment->mr;
+        *mr_addr = fragment->mr_addr + within;
+        *gpa = fragment->gpa + within;
+        *length = MIN((uint64_t)*length, fragment->length - within);
+        *length = MIN((uint64_t)*length, transaction->length - offset);
+        return true;
+    }
+    return false;
+}
+
+QemuCrucibleMemoryAccessResult qemu_crucible_fault_memory_access(
+    enum QemuCrucibleMemoryAccessClass access_class, uint32_t vcpu,
+    uint64_t vaddr, uint64_t gpa, const uint8_t *before, uint8_t *value,
+    size_t length, bool atomic, uint64_t observed_icount)
+{
+    QemuCrucibleMemoryAccessResult result = { 0 };
+    bool post_state = false;
+    uint64_t service_latency = 0;
+    uint64_t service_queue = 0;
+    size_t match_count;
+    uint8_t commit_mask[4096];
+    uint8_t shadow_before[4096];
+    bool write_access = access_class == QEMU_CRUCIBLE_MEMORY_CPU_STORE ||
+                        access_class == QEMU_CRUCIBLE_MEMORY_DMA_WRITE;
+
+    if ((!qemu_crucible_fault_memory_rules_active() &&
+         !crucible_memory_transaction.active) ||
+        !before || !value || length == 0) {
+        return result;
+    }
+    if (crucible_memory_post_state.active ||
+        length > sizeof(crucible_memory_post_state.before)) {
+        error_report("Crucible memory post-access state was not finalized");
+        abort();
+    }
+    if (write_access) {
+        memset(commit_mask, UINT8_MAX, length);
+    }
+    if (crucible_memory_transaction.active &&
+        crucible_memory_transaction.streaming) {
+        g_assert(access_class == QEMU_CRUCIBLE_MEMORY_FETCH);
+        memcpy(shadow_before, before, length);
+        node_memory_shadow_read(gpa, shadow_before, length);
+        memcpy(value, shadow_before, length);
+        before = shadow_before;
+    }
+    match_count = node_memory_matching_rules(
+        vcpu, vaddr, gpa, length,
+        access_class != QEMU_CRUCIBLE_MEMORY_DMA_READ &&
+        access_class != QEMU_CRUCIBLE_MEMORY_DMA_WRITE &&
+        access_class != QEMU_CRUCIBLE_MEMORY_PAGE_TABLE_WALK);
+    if (!crucible_memory_transaction.active && match_count != 0 &&
+        !node_memory_event_capacity(crucible_memory_matches[0], match_count,
+                                    access_class, vcpu, vaddr, gpa, length,
+                                    observed_icount)) {
+        result.access_error = true;
+        node_memory_matching_rules_done();
+        return result;
+    }
+    if (!node_memory_runtime_resources_ready(
+            match_count, access_class, vcpu, vaddr, gpa, length,
+            observed_icount)) {
+        result.access_error = true;
+        node_memory_matching_rules_done();
+        return result;
+    }
+    if (node_memory_poison_preflight(
+            access_class, vcpu, vaddr, gpa, before, value, length,
+            observed_icount, match_count)) {
+        result.access_error = true;
+        node_memory_matching_rules_done();
+        return result;
+    }
+    for (size_t i = 0; i < match_count; i++) {
+        QemuCrucibleFaultRule *rule = crucible_memory_matches[i];
+        size_t offset, selected;
+        uint64_t rule_offset;
+
+        if (rule->command_kind !=
+                CRUCIBLE_FAULT_COMMAND_MEMORY_ACCESS_TRANSFORM &&
+            rule->command_kind != CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE &&
+            rule->command_kind != CRUCIBLE_FAULT_COMMAND_MEMORY_SERVICE) {
+            continue;
+        }
+        if (!node_rule_memory_overlap(rule, vcpu, vaddr, gpa, length, &offset,
+                                      &selected, &rule_offset)) {
+            if (rule->translation_stale &&
+                !rule->translation_error_reported) {
+                node_memory_event_span(0, 0);
+                node_memory_event(rule, CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR,
+                                  access_class, vcpu, vaddr, gpa, before,
+                                  value, length, observed_icount);
+                rule->translation_error_reported = true;
+            }
+            continue;
+        }
+        node_memory_event_span(offset, selected);
+        if (rule->command_kind == CRUCIBLE_FAULT_COMMAND_MEMORY_SERVICE) {
+            node_memory_state_opportunity(rule);
+            node_memory_state_applied(rule);
+            if (crucible_memory_transaction.active) {
+                node_memory_service_defer(
+                    rule, access_class, vcpu, vaddr + offset, gpa + offset,
+                    before + offset, value + offset, selected,
+                    observed_icount);
+                continue;
+            }
+            uint64_t latency;
+            uint64_t delay = node_memory_service(rule, selected, &latency);
+
+            if (service_latency > UINT64_MAX - latency) {
+                error_report("Crucible memory latency sum overflow");
+                abort();
+            }
+            service_latency += latency;
+            service_queue = MAX(service_queue, delay);
+            node_memory_event(rule, CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED,
+                              access_class, vcpu, vaddr, gpa, before, value,
+                              length, observed_icount);
+            continue;
+        }
+        if (rule->command_kind ==
+            CRUCIBLE_FAULT_COMMAND_MEMORY_ACCESS_TRANSFORM) {
+            uint32_t classes, kind;
+            bool violate_atomicity;
+            uint16_t outcome = CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED;
+
+            g_assert(node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P8,
+                                    &classes));
+            g_assert(node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P3,
+                                    &kind));
+            if ((classes & access_class) == 0 ||
+                (kind == 5 ? !crucible_memory_poison_occurs[i] :
+                 !node_memory_rule_occurs(rule,
+                                          CRUCIBLE_NODE_FAULT_FIELD_P7))) {
+                continue;
+            }
+            g_assert(node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_P9,
+                                     &violate_atomicity));
+            if (atomic && kind == 4 && !violate_atomicity) {
+                g_assert(rule->applied_count != 0);
+                rule->applied_count--;
+                node_memory_event(rule,
+                                  CRUCIBLE_FAULT_EVENT_OUTCOME_PASSED,
+                                  access_class, vcpu, vaddr, gpa, before, value,
+                                  length, observed_icount);
+                continue;
+            }
+            if (kind == 1 || kind == 2) {
+                node_repeated_transform(
+                    value + offset, before + offset, selected, rule_offset,
+                    node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P4),
+                    node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P6), kind);
+            } else if (kind == 3) {
+                memcpy(value + offset, before + offset, selected);
+                memset(commit_mask + offset, 0, selected);
+                outcome = CRUCIBLE_FAULT_EVENT_OUTCOME_SUPPRESSED;
+            } else if (kind == 4) {
+                CrucibleNodeField *selector = node_field(
+                    rule, CRUCIBLE_NODE_FAULT_FIELD_P6);
+
+                node_repeated_transform(
+                    value + offset, before + offset, selected, rule_offset,
+                    selector, NULL, kind);
+                for (size_t byte = 0; byte < selected; byte++) {
+                    commit_mask[offset + byte] &=
+                        selector->data[(rule_offset + byte) %
+                                       selector->length];
+                }
+            } else {
+                CrucibleNodeField *poison_field =
+                    node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P6);
+                QDict *poison = qobject_to(QDict, poison_field->json);
+                const char *poison_kind = qdict_get_try_str(poison, "kind");
+
+                if (strcmp(poison_kind, "corrected") == 0) {
+                    QDict *parameters = qobject_to(
+                        QDict, qdict_get(poison, "parameters"));
+                    const char *mask = qdict_get_str(parameters, "xor_mask");
+                    size_t mask_len = strlen(mask) / 2;
+
+                    for (size_t byte = 0; byte < selected; byte++) {
+                        unsigned parsed;
+                        size_t index = (rule_offset + byte) % mask_len;
+
+                        g_assert(sscanf(mask + index * 2, "%2x", &parsed) == 1);
+                        value[offset + byte] ^= parsed;
+                    }
+                    outcome = CRUCIBLE_FAULT_EVENT_OUTCOME_CORRECTED;
+                } else {
+                    g_assert_not_reached();
+                }
+            }
+            node_memory_event(rule, outcome,
+                              access_class, vcpu, vaddr, gpa, before, value,
+                              length, observed_icount);
+            continue;
+        }
+        if (rule->command_kind == CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE) {
+            uint32_t region_kind;
+            QDict *process;
+            bool state_changed = true;
+
+            node_memory_state_opportunity(rule);
+            g_assert(node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P3,
+                                    &region_kind));
+            process = qobject_to(
+                QDict, node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P4)->json);
+            node_memory_mutation_evidence_reset(rule);
+            if (region_kind != 1 &&
+                (access_class == QEMU_CRUCIBLE_MEMORY_CPU_STORE ||
+                 access_class == QEMU_CRUCIBLE_MEMORY_DMA_WRITE)) {
+                post_state = true;
+                continue;
+            }
+            if (region_kind == 1) {
+                QDict *parameters = qdict_get_qdict(process, "parameters");
+                QDict *policy = qdict_get_qdict(parameters, "policy");
+                const char *policy_kind = qdict_get_str(policy, "kind");
+
+                if (strcmp(policy_kind, "corrected") == 0) {
+                    QDict *corrected = qdict_get_qdict(policy, "parameters");
+                    const char *mask = qdict_get_str(corrected, "xor_mask");
+                    size_t mask_len = strlen(mask) / 2;
+
+                    for (size_t byte = 0; byte < selected; byte++) {
+                        unsigned parsed;
+                        size_t index = (rule_offset + byte) % mask_len;
+
+                        g_assert(sscanf(mask + index * 2, "%2x", &parsed) == 1);
+                        value[offset + byte] ^= parsed;
+                    }
+                    node_memory_state_applied(rule);
+                    node_memory_event(
+                        rule, CRUCIBLE_FAULT_EVENT_OUTCOME_CORRECTED,
+                        access_class, vcpu, vaddr, gpa, before, value,
+                        length, observed_icount);
+                } else {
+                    g_assert_not_reached();
+                }
+            } else if (region_kind == 2) {
+                QDict *parameters = qdict_get_qdict(process, "parameters");
+                uint64_t now = node_virtual_now();
+
+                node_memory_mutation_evidence_reset(rule);
+                bool decayed = node_memory_apply_retention(
+                    rule, parameters, rule_offset, value + offset, selected,
+                    now);
+
+                state_changed = decayed;
+            } else {
+                QDict *parameters = qdict_get_qdict(process, "parameters");
+
+                node_memory_mutation_evidence_reset(rule);
+                state_changed = true;
+                (void)node_memory_apply_rowhammer(
+                    rule, parameters, rule_offset, selected);
+            }
+            if (region_kind != 1) {
+                uint16_t outcome = state_changed ?
+                    CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED :
+                    CRUCIBLE_FAULT_EVENT_OUTCOME_PASSED;
+
+                if (state_changed) {
+                    node_memory_state_applied(rule);
+                }
+                node_memory_event(rule, outcome,
+                                  access_class, vcpu, vaddr, gpa, before,
+                                  value, length, observed_icount);
+            }
+        }
+    }
+    if (write_access) {
+        bool partial = false;
+
+        for (size_t byte = 0; byte < length; byte++) {
+            partial |= commit_mask[byte] != UINT8_MAX;
+        }
+        if (partial) {
+            bool commits_any_bit = false;
+
+            for (size_t byte = 0; byte < length; byte++) {
+                commits_any_bit |= commit_mask[byte] != 0;
+                value[byte] = (before[byte] & ~commit_mask[byte]) |
+                              (value[byte] & commit_mask[byte]);
+            }
+            result.suppress_write = !commits_any_bit;
+        }
+    }
+    if (post_state) {
+        crucible_memory_post_state.active = true;
+        crucible_memory_post_state.access_class = access_class;
+        crucible_memory_post_state.vcpu = vcpu;
+        crucible_memory_post_state.vaddr = vaddr;
+        crucible_memory_post_state.gpa = gpa;
+        crucible_memory_post_state.length = length;
+        crucible_memory_post_state.observed_icount = observed_icount;
+        crucible_memory_post_state.access_sequence =
+            crucible_memory_current_access;
+        memcpy(crucible_memory_post_state.before, before, length);
+        memcpy(crucible_memory_post_state.commit_mask, commit_mask, length);
+    }
+    if (service_latency > UINT64_MAX - service_queue) {
+        error_report("Crucible memory completion delay overflow");
+        abort();
+    }
+    result.service_nanos = service_latency + service_queue;
+    node_memory_apply_service(result.service_nanos);
+    node_memory_matching_rules_done();
+    return result;
+}
+
+void qemu_crucible_fault_memory_access_finish(const uint8_t *after,
+                                              size_t length)
+{
+    CrucibleMemoryPostState *post = &crucible_memory_post_state;
+    size_t match_count;
+
+    if (!post->active) {
+        return;
+    }
+    if (!after || length != post->length) {
+        error_report("Crucible memory post-access identity changed");
+        abort();
+    }
+    match_count = node_memory_matching_rules_at(
+        post->vcpu, post->vaddr, post->gpa, post->length,
+        post->access_class != QEMU_CRUCIBLE_MEMORY_DMA_WRITE,
+        post->access_sequence);
+    for (size_t i = 0; i < match_count; i++) {
+        QemuCrucibleFaultRule *rule = crucible_memory_matches[i];
+        size_t offset, selected;
+        uint64_t rule_offset;
+        uint32_t region_kind;
+        QDict *process;
+
+        if (rule->command_kind !=
+                CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE ||
+            !node_rule_memory_overlap(
+                rule, post->vcpu, post->vaddr, post->gpa, post->length,
+                &offset, &selected, &rule_offset)) {
+            continue;
+        }
+        node_memory_event_span(offset, selected);
+        g_assert(node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P3,
+                                &region_kind));
+        node_memory_mutation_evidence_reset(rule);
+        if (region_kind == 1) {
+            continue;
+        }
+        process = qobject_to(
+            QDict, node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P4)->json);
+        if (region_kind == 2) {
+            bool refreshed;
+
+            node_memory_mutation_evidence_reset(rule);
+            refreshed = node_memory_refresh_retention(
+                rule, rule_offset, post->commit_mask + offset, selected,
+                node_virtual_now());
+            if (refreshed) {
+                node_memory_state_applied(rule);
+            }
+            node_memory_event(
+                rule, refreshed ? CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED :
+                                  CRUCIBLE_FAULT_EVENT_OUTCOME_PASSED,
+                post->access_class, post->vcpu, post->vaddr, post->gpa,
+                post->before, after, post->length, post->observed_icount);
+        } else {
+            node_memory_mutation_evidence_reset(rule);
+            (void)node_memory_apply_rowhammer(
+                rule, qdict_get_qdict(process, "parameters"), rule_offset,
+                selected);
+            node_memory_state_applied(rule);
+            node_memory_event(
+                rule, CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED,
+                post->access_class, post->vcpu, post->vaddr, post->gpa,
+                post->before, after, post->length, post->observed_icount);
+        }
+    }
+    node_memory_matching_rules_done();
+    memset(post, 0, sizeof(*post));
+}
+
+void qemu_crucible_fault_memory_page_table_walk_context_begin(
+    CPUState *cpu, uint64_t target_vaddr,
+    enum QemuCrucibleMemoryAccessClass initiating_access_class,
+    bool has_instruction, uint64_t instruction_pc,
+    uint32_t instruction_ordinal)
+{
+    if (!cpu ||
+        (initiating_access_class != QEMU_CRUCIBLE_MEMORY_FETCH &&
+         initiating_access_class != QEMU_CRUCIBLE_MEMORY_CPU_LOAD &&
+         initiating_access_class != QEMU_CRUCIBLE_MEMORY_CPU_STORE)) {
+        error_report("Invalid Crucible page-table walk context");
+        abort();
+    }
+    cpu->crucible_page_table_walk_active = true;
+    cpu->crucible_page_table_walk_has_instruction = has_instruction;
+    cpu->crucible_page_table_walk_access_class = initiating_access_class;
+    cpu->crucible_page_table_walk_instruction_ordinal =
+        instruction_ordinal;
+    cpu->crucible_page_table_walk_target_vaddr = target_vaddr;
+    cpu->crucible_page_table_walk_instruction_pc = instruction_pc;
+}
+
+void qemu_crucible_fault_memory_page_table_walk_context_end(CPUState *cpu)
+{
+    if (cpu) {
+        cpu->crucible_page_table_walk_active = false;
+    }
+}
+
+bool qemu_crucible_fault_memory_page_table_walk_context_active(
+    const CPUState *cpu)
+{
+    return cpu && cpu->crucible_page_table_walk_active;
+}
+
+bool qemu_crucible_fault_memory_page_table_walk(
+    CPUState *cpu, uint64_t entry_gpa, int32_t level, uint32_t stage,
+    const uint8_t *before, uint8_t *value, size_t length)
+{
+    CrucibleMemoryTransaction *transaction = &crucible_memory_transaction;
+    CrucibleMemoryPageTableIdentity page_table;
+    QemuCrucibleMemoryAccessResult result;
+    uint64_t observed_icount;
+    uint32_t initiating_access_class;
+
+    if (!qemu_crucible_fault_memory_page_table_walk_rules_active() ||
+        !qemu_crucible_fault_memory_page_table_walk_context_active(cpu)) {
+        return false;
+    }
+    initiating_access_class =
+        cpu->crucible_page_table_walk_access_class;
+    if (!cpu || !before || !value || (length != 4 && length != 8) ||
+        (stage != 1 && stage != 2) || level < -1 || level > 5 ||
+        (initiating_access_class != QEMU_CRUCIBLE_MEMORY_FETCH &&
+         initiating_access_class != QEMU_CRUCIBLE_MEMORY_CPU_LOAD &&
+         initiating_access_class != QEMU_CRUCIBLE_MEMORY_CPU_STORE)) {
+        error_report("Invalid Crucible page-table walk opportunity");
+        abort();
+    }
+    page_table = (CrucibleMemoryPageTableIdentity) {
+        .target_vaddr = cpu->crucible_page_table_walk_target_vaddr,
+        .level = level,
+        .stage = stage,
+        .initiating_access_class = initiating_access_class,
+    };
+    observed_icount = qemu_crucible_fault_observed_icount();
+    node_memory_transaction_begin(
+        QEMU_CRUCIBLE_MEMORY_PAGE_TABLE_WALK, cpu->cpu_index,
+        entry_gpa, length, observed_icount,
+        cpu->crucible_page_table_walk_has_instruction,
+        cpu->crucible_page_table_walk_instruction_pc,
+        cpu->crucible_page_table_walk_instruction_ordinal,
+        false, false, &page_table);
+    if (!transaction->active) {
+        return false;
+    }
+    node_memory_transaction_preflight_physical(
+        QEMU_CRUCIBLE_MEMORY_PAGE_TABLE_WALK, cpu->cpu_index,
+        page_table.target_vaddr, entry_gpa, length, transaction->identity);
+    result = qemu_crucible_fault_memory_access(
+        QEMU_CRUCIBLE_MEMORY_PAGE_TABLE_WALK, cpu->cpu_index,
+        page_table.target_vaddr, entry_gpa, before, value, length, false,
+        observed_icount);
+    qemu_crucible_fault_memory_transaction_end();
+    return result.access_error;
+}
+
+QemuCrucibleMemoryAccessResult qemu_crucible_fault_memory_atomic(
+    uint32_t vcpu, uint64_t vaddr, uint64_t gpa, const uint8_t *before,
+    uint8_t *visible, uint8_t *committed, size_t length,
+    bool write_happened, uint64_t observed_icount)
+{
+    QemuCrucibleMemoryAccessResult result = { 0 };
+    uint32_t access_classes = QEMU_CRUCIBLE_MEMORY_CPU_LOAD |
+        (write_happened ? QEMU_CRUCIBLE_MEMORY_CPU_STORE : 0);
+    size_t match_count;
+    uint64_t service_latency = 0;
+    uint64_t service_queue = 0;
+    uint8_t commit_mask[16];
+
+    if (!qemu_crucible_fault_memory_rules_active() || !before || !visible ||
+        !committed || length == 0) {
+        return result;
+    }
+    memset(commit_mask, UINT8_MAX, length);
+    match_count = node_memory_matching_rules(vcpu, vaddr, gpa, length, true);
+    if (!crucible_memory_transaction.active && match_count != 0 &&
+        !node_memory_event_capacity(crucible_memory_matches[0], match_count,
+                                    access_classes, vcpu, vaddr, gpa, length,
+                                    observed_icount)) {
+        result.access_error = true;
+        node_memory_matching_rules_done();
+        return result;
+    }
+    if (!node_memory_runtime_resources_ready(
+            match_count, access_classes, vcpu, vaddr, gpa, length,
+            observed_icount)) {
+        result.access_error = true;
+        node_memory_matching_rules_done();
+        return result;
+    }
+    if (node_memory_poison_preflight(
+            access_classes, vcpu, vaddr, gpa, before, visible, length,
+            observed_icount, match_count)) {
+        result.access_error = true;
+        node_memory_matching_rules_done();
+        return result;
+    }
+    for (size_t i = 0; i < match_count; i++) {
+        QemuCrucibleFaultRule *rule = crucible_memory_matches[i];
+        size_t offset, selected;
+        uint64_t rule_offset;
+
+        if (rule->command_kind !=
+                CRUCIBLE_FAULT_COMMAND_MEMORY_ACCESS_TRANSFORM &&
+            rule->command_kind != CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE &&
+            rule->command_kind != CRUCIBLE_FAULT_COMMAND_MEMORY_SERVICE) {
+            continue;
+        }
+        if (!node_rule_memory_overlap(rule, vcpu, vaddr, gpa, length, &offset,
+                                      &selected, &rule_offset)) {
+            if (rule->translation_stale &&
+                !rule->translation_error_reported) {
+                node_memory_event_span(0, 0);
+                node_memory_event(rule, CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR,
+                                  access_classes, vcpu, vaddr, gpa, before,
+                                  visible, length, observed_icount);
+                rule->translation_error_reported = true;
+            }
+            continue;
+        }
+        node_memory_event_span(offset, selected);
+        if (rule->command_kind == CRUCIBLE_FAULT_COMMAND_MEMORY_SERVICE) {
+            node_memory_state_opportunity(rule);
+            node_memory_state_applied(rule);
+            if (crucible_memory_transaction.active) {
+                node_memory_service_defer(
+                    rule, access_classes, vcpu, vaddr + offset, gpa + offset,
+                    before + offset, committed + offset, selected,
+                    observed_icount);
+                continue;
+            }
+            uint64_t latency;
+            uint64_t delay = node_memory_service(rule, selected, &latency);
+
+            if (service_latency > UINT64_MAX - latency) {
+                error_report("Crucible memory latency sum overflow");
+                abort();
+            }
+            service_latency += latency;
+            service_queue = MAX(service_queue, delay);
+            node_memory_event(rule, CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED,
+                              access_classes, vcpu, vaddr, gpa, before,
+                              committed, length, observed_icount);
+            continue;
+        }
+        if (rule->command_kind ==
+            CRUCIBLE_FAULT_COMMAND_MEMORY_ACCESS_TRANSFORM) {
+            uint32_t classes, kind;
+            bool violate_atomicity;
+            uint16_t outcome = CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED;
+
+            g_assert(node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P8,
+                                    &classes));
+            g_assert(node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P3,
+                                    &kind));
+            if ((classes & access_classes) == 0 ||
+                (kind == 5 ? !crucible_memory_poison_occurs[i] :
+                 !node_memory_rule_occurs(rule,
+                                   CRUCIBLE_NODE_FAULT_FIELD_P7))) {
+                continue;
+            }
+            g_assert(node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_P9,
+                                     &violate_atomicity));
+            if (kind == 4 && !violate_atomicity) {
+                g_assert(rule->applied_count != 0);
+                rule->applied_count--;
+                node_memory_event(rule, CRUCIBLE_FAULT_EVENT_OUTCOME_PASSED,
+                                  access_classes, vcpu, vaddr, gpa, before,
+                                  committed, length, observed_icount);
+                continue;
+            }
+            if (kind == 1) {
+                if (classes & QEMU_CRUCIBLE_MEMORY_CPU_LOAD) {
+                    node_repeated_transform(
+                        visible + offset, before + offset, selected,
+                        rule_offset,
+                        node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P4),
+                        node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P6), kind);
+                }
+                if (write_happened &&
+                    (classes & QEMU_CRUCIBLE_MEMORY_CPU_STORE)) {
+                    node_repeated_transform(
+                        committed + offset, before + offset, selected,
+                        rule_offset,
+                        node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P4),
+                        node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P6), kind);
+                }
+            } else if (kind == 2) {
+                node_repeated_transform(
+                    visible + offset, before + offset, selected, rule_offset,
+                    node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P4),
+                    node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P6), kind);
+            } else if (kind == 3 && write_happened) {
+                memcpy(committed + offset, before + offset, selected);
+                memset(commit_mask + offset, 0, selected);
+                outcome = CRUCIBLE_FAULT_EVENT_OUTCOME_SUPPRESSED;
+            } else if (kind == 4 && write_happened) {
+                CrucibleNodeField *selector = node_field(
+                    rule, CRUCIBLE_NODE_FAULT_FIELD_P6);
+
+                node_repeated_transform(
+                    committed + offset, before + offset, selected, rule_offset,
+                    selector, NULL, kind);
+                for (size_t byte = 0; byte < selected; byte++) {
+                    commit_mask[offset + byte] &=
+                        selector->data[(rule_offset + byte) %
+                                       selector->length];
+                }
+            } else if (kind == 5) {
+                QDict *poison = qobject_to(
+                    QDict, node_field(rule,
+                        CRUCIBLE_NODE_FAULT_FIELD_P6)->json);
+                const char *poison_kind = qdict_get_str(poison, "kind");
+
+                if (strcmp(poison_kind, "corrected") == 0) {
+                    QDict *parameters = qdict_get_qdict(poison, "parameters");
+                    const char *mask = qdict_get_str(parameters, "xor_mask");
+                    size_t mask_len = strlen(mask) / 2;
+
+                    for (size_t byte = 0; byte < selected; byte++) {
+                        unsigned parsed;
+                        size_t index = (rule_offset + byte) % mask_len;
+
+                        g_assert(sscanf(mask + index * 2, "%2x", &parsed) == 1);
+                        visible[offset + byte] ^= parsed;
+                    }
+                    outcome = CRUCIBLE_FAULT_EVENT_OUTCOME_CORRECTED;
+                } else {
+                    g_assert_not_reached();
+                }
+            }
+            node_memory_event(rule, outcome,
+                              access_classes, vcpu, vaddr, gpa, before,
+                              write_happened ? committed : visible, length,
+                              observed_icount);
+            continue;
+        }
+
+        uint32_t region_kind;
+        QDict *process = qobject_to(
+            QDict, node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P4)->json);
+        uint16_t outcome = CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED;
+
+        node_memory_state_opportunity(rule);
+        g_assert(node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P3,
+                                &region_kind));
+        node_memory_mutation_evidence_reset(rule);
+        if (region_kind == 1) {
+            QDict *parameters = qdict_get_qdict(process, "parameters");
+            QDict *policy = qdict_get_qdict(parameters, "policy");
+            const char *policy_kind = qdict_get_str(policy, "kind");
+
+            if (strcmp(policy_kind, "corrected") == 0) {
+                QDict *corrected = qdict_get_qdict(policy, "parameters");
+                const char *mask = qdict_get_str(corrected, "xor_mask");
+                size_t mask_len = strlen(mask) / 2;
+
+                for (size_t byte = 0; byte < selected; byte++) {
+                    unsigned parsed;
+                    size_t index = (rule_offset + byte) % mask_len;
+
+                    g_assert(sscanf(mask + index * 2, "%2x", &parsed) == 1);
+                    visible[offset + byte] ^= parsed;
+                }
+                outcome = CRUCIBLE_FAULT_EVENT_OUTCOME_CORRECTED;
+            } else {
+                g_assert_not_reached();
+            }
+        } else if (region_kind == 2) {
+            QDict *parameters = qdict_get_qdict(process, "parameters");
+            uint64_t now = node_virtual_now();
+            node_memory_mutation_evidence_reset(rule);
+            if (write_happened) {
+                if (!node_memory_refresh_retention(
+                        rule, rule_offset, commit_mask + offset, selected,
+                        now)) {
+                    outcome = CRUCIBLE_FAULT_EVENT_OUTCOME_PASSED;
+                }
+            } else {
+                bool decayed = node_memory_apply_retention(
+                    rule, parameters, rule_offset, visible + offset,
+                    selected, now);
+
+                if (!decayed) {
+                    outcome = CRUCIBLE_FAULT_EVENT_OUTCOME_PASSED;
+                }
+            }
+        } else {
+            node_memory_mutation_evidence_reset(rule);
+            (void)node_memory_apply_rowhammer(
+                rule, qdict_get_qdict(process, "parameters"), rule_offset,
+                selected);
+        }
+        if (outcome != CRUCIBLE_FAULT_EVENT_OUTCOME_PASSED) {
+            node_memory_state_applied(rule);
+        }
+        node_memory_event(rule, outcome,
+                          access_classes, vcpu, vaddr, gpa, before,
+                          write_happened ? committed : visible, length,
+                          observed_icount);
+    }
+    if (write_happened) {
+        bool partial = false;
+
+        for (size_t byte = 0; byte < length; byte++) {
+            partial |= commit_mask[byte] != UINT8_MAX;
+        }
+        if (partial) {
+            for (size_t byte = 0; byte < length; byte++) {
+                committed[byte] =
+                    (before[byte] & ~commit_mask[byte]) |
+                    (committed[byte] & commit_mask[byte]);
+            }
+        }
+    }
+    if (service_latency > UINT64_MAX - service_queue) {
+        error_report("Crucible memory completion delay overflow");
+        abort();
+    }
+    result.service_nanos = service_latency + service_queue;
+    node_memory_apply_service(result.service_nanos);
+    node_memory_matching_rules_done();
+    return result;
+}
+
+static void crucible_memory_access_faults_register(void)
+{
+    const uint32_t boundary =
+        1U << (CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY - 1);
+
+    qemu_mutex_init(&crucible_memory_transaction_lock);
+
+    qemu_crucible_fault_node_register(
+        CRUCIBLE_FAULT_COMMAND_MEMORY_ACCESS_TRANSFORM,
+        QEMU_PLUGIN_CRUCIBLE_FAULT_SCOPE_ALL, boundary,
+        "qemu.memory.access-transform.v1", NULL);
+    qemu_crucible_fault_node_register(
+        CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE,
+        QEMU_PLUGIN_CRUCIBLE_FAULT_SCOPE_ALL, boundary,
+        "qemu.memory.region-state.v1", NULL);
+    qemu_crucible_fault_node_register(
+        CRUCIBLE_FAULT_COMMAND_MEMORY_SERVICE,
+        QEMU_PLUGIN_CRUCIBLE_FAULT_SCOPE_ALL, boundary,
+        "qemu.memory.service.v1", NULL);
+    qemu_crucible_fault_boundary_observer_register(
+        node_memory_retention_boundary);
+    qemu_crucible_fault_boundary_deadline_register(
+        node_memory_retention_deadline);
+}
+
+type_init(crucible_memory_access_faults_register)
