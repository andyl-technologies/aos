+bool arm_cpu_validate_fault_exception(
+    CPUState *cs, const CPUFaultException *exception)
+{
+    bool abort = exception->vector == EXCP_PREFETCH_ABORT ||
+                 exception->vector == EXCP_DATA_ABORT;
+
+    return exception->architecture == CPU_FAULT_EXCEPTION_AARCH64 &&
+           exception->record == CPU_FAULT_EXCEPTION_ARCHITECTURE_DEFAULT &&
+           exception->syndrome <= UINT32_MAX &&
+           exception->before_instruction && !exception->maskable &&
+           (exception->vector == EXCP_UDEF || abort ||
+            exception->vector == EXCP_BKPT) &&
+           (abort || !exception->has_fault_address);
+}
+
+void arm_cpu_inject_fault_exception(
+    CPUState *cs, const CPUFaultException *exception, uintptr_t retaddr)
+{
+    CPUARMState *env = cpu_env(cs);
+
+    if (exception->has_fault_address) {
+        env->exception.vaddress = exception->fault_address;
+    }
+    if (retaddr) {
+        raise_exception_ra(env, exception->vector, exception->syndrome,
+                           exception_target_el(env), retaddr);
+    }
+    raise_exception(env, exception->vector, exception->syndrome,
+                    exception_target_el(env));
+}
+
+void arm_cpu_inject_fault_access_error(
+    CPUState *cs, vaddr address, unsigned size,
+    MMUAccessType access_type, uintptr_t retaddr)
+{
+    ARMCPU *cpu = ARM_CPU(cs);
+    ARMMMUFaultInfo fi = {
+        .ea = 1,
+        .type = ARMFault_SyncExternal,
+    };
+
+    if (retaddr) {
+        cpu_restore_state(cs, retaddr);
+    }
+    arm_deliver_fault(cpu, address, access_type,
+                      cpu_mmu_index(cs, false), &fi);
+}
