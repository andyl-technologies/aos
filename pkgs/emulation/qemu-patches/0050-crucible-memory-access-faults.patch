+static QDict *node_memory_poison_policy(
+    QemuCrucibleFaultRule *rule)
+{
+    QDict *poison = NULL;
+
+    if (rule->command_kind ==
+        CRUCIBLE_FAULT_COMMAND_MEMORY_ACCESS_TRANSFORM) {
+        uint32_t kind;
+
+        if (!node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P3, &kind) ||
+            kind != 5) {
+            return NULL;
+        }
+        poison = qobject_to(
+            QDict, node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P6)->json);
+    } else if (rule->command_kind ==
+               CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE) {
+        uint32_t kind;
+        QDict *process;
+
+        if (!node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P3, &kind) ||
+            kind != 1) {
+            return NULL;
+        }
+        process = qobject_to(
+            QDict, node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P4)->json);
+        poison = qdict_get_qdict(
+            qdict_get_qdict(process, "parameters"), "policy");
+    }
+    return poison;
+}
