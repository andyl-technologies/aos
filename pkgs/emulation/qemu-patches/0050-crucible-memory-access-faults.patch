+int64_t icount_get_observed(void)
+{
+    CPUState *cpu = current_cpu;
+    int64_t bias;
+    int64_t executed;
+    int64_t icount;
+    int shift;
+    unsigned start;
+
+    do {
+        executed = 0;
+        start = seqlock_read_begin(&timers_state.vm_clock_seqlock);
+        icount = qatomic_read_i64(&timers_state.qemu_icount);
+        bias = qatomic_read_i64(&timers_state.qemu_icount_bias);
+        shift = qatomic_read(&timers_state.icount_time_shift);
+        if (cpu && cpu->running) {
+            executed = icount_get_executed(cpu);
+        }
+    } while (seqlock_read_retry(&timers_state.vm_clock_seqlock, start));
+
+    if (icount < 0 || executed < 0 || icount > INT64_MAX - executed) {
+        return -1;
+    }
+    icount += executed;
+    if (shift < 0 || shift >= 63 || icount > (INT64_MAX >> shift)) {
+        return -1;
+    }
+    icount <<= shift;
+    if (bias > INT64_MAX - icount) {
+        return -1;
+    }
+    return bias + icount;
+}
