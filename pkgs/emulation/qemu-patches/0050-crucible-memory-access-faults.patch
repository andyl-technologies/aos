+static QemuCrucibleFaultRule *node_memory_shadow_original(
+    QemuCrucibleFaultRule *rule)
+{
+    CrucibleMemoryTransaction *transaction = &crucible_memory_transaction;
+    QemuCrucibleFaultRule *original;
+
+    if (!transaction->streaming || !transaction->shadow_originals) {
+        return rule;
+    }
+    original = g_hash_table_lookup(transaction->shadow_originals, rule);
+    return original ? original : rule;
+}
+
+static QemuCrucibleFaultRule *node_memory_shadow_rule(
+    QemuCrucibleFaultRule *original)
+{
+    CrucibleMemoryTransaction *transaction = &crucible_memory_transaction;
+    QemuCrucibleFaultRule *shadow;
+
+    g_assert(transaction->streaming);
+    if (!transaction->shadow_rules) {
+        transaction->shadow_rules = g_hash_table_new_full(
+            g_direct_hash, g_direct_equal, NULL,
+            (GDestroyNotify)node_rule_unref);
+        transaction->shadow_originals = g_hash_table_new(
+            g_direct_hash, g_direct_equal);
+    }
+    shadow = g_hash_table_lookup(transaction->shadow_rules, original);
+    if (!shadow) {
+        shadow = node_memory_shadow_rule_copy(original);
+        g_hash_table_insert(transaction->shadow_rules, original, shadow);
+        g_hash_table_insert(transaction->shadow_originals, shadow, original);
+    }
+    return shadow;
+}
