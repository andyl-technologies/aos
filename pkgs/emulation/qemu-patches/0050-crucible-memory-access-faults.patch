+           node_json_memory_region(object, 2) ||
+           node_json_memory_region(object, 3);
+}
+
+static bool node_json_clock_release_any(const QObject *object)
+{
+    return node_json_clock_release(object);
+}
+
+static bool node_json_jitter_any(const QObject *object)
+{
+    return node_json_jitter(object, UINT64_MAX);
+}
+
+static bool node_json_wander_any(const QObject *object)
+{
+    return node_json_wander(object);
+}
+
+static bool node_target_pair_valid(const QemuCrucibleFaultRule *rule)
+{
+    switch (rule->command_kind) {
+    case CRUCIBLE_FAULT_COMMAND_NODE_LIFECYCLE:
+        return rule->target_kind == CRUCIBLE_NODE_FAULT_TARGET_NODE;
+    case CRUCIBLE_FAULT_COMMAND_NODE_HANG:
+        return rule->target_kind == CRUCIBLE_NODE_FAULT_TARGET_NODE ||
+               rule->target_kind == CRUCIBLE_NODE_FAULT_TARGET_VCPU ||
+               rule->target_kind == CRUCIBLE_NODE_FAULT_TARGET_ACCELERATOR;
+    case CRUCIBLE_FAULT_COMMAND_CPU_SERVICE:
+        return rule->target_kind == CRUCIBLE_NODE_FAULT_TARGET_NODE ||
+               rule->target_kind == CRUCIBLE_NODE_FAULT_TARGET_VCPU;
+    case CRUCIBLE_FAULT_COMMAND_CPU_VCPU_STATE:
+    case CRUCIBLE_FAULT_COMMAND_CPU_INSTRUCTION_TRANSFORM:
+    case CRUCIBLE_FAULT_COMMAND_CPU_EXCEPTION:
+        return rule->target_kind == CRUCIBLE_NODE_FAULT_TARGET_VCPU;
+    case CRUCIBLE_FAULT_COMMAND_CPU_REGISTER_TRANSFORM:
+        return rule->target_kind == CRUCIBLE_NODE_FAULT_TARGET_REGISTER;
+    case CRUCIBLE_FAULT_COMMAND_INTERRUPT_DISPOSITION:
+    case CRUCIBLE_FAULT_COMMAND_INTERRUPT_STORM:
+        return rule->target_kind == CRUCIBLE_NODE_FAULT_TARGET_INTERRUPT;
+    case CRUCIBLE_FAULT_COMMAND_MEMORY_ACCESS_TRANSFORM:
+    case CRUCIBLE_FAULT_COMMAND_MEMORY_ECC_EVENT:
+    case CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE:
+    case CRUCIBLE_FAULT_COMMAND_MEMORY_SERVICE:
+        return rule->target_kind == CRUCIBLE_NODE_FAULT_TARGET_MEMORY;
+    case CRUCIBLE_FAULT_COMMAND_CLOCK_TRANSFORM:
+    case CRUCIBLE_FAULT_COMMAND_CLOCK_SOURCE_STATE:
+        return rule->target_kind == CRUCIBLE_NODE_FAULT_TARGET_CLOCK;
+    case CRUCIBLE_FAULT_COMMAND_ACCELERATOR_LIFECYCLE:
+    case CRUCIBLE_FAULT_COMMAND_ACCELERATOR_RESULT_TRANSFORM:
+    case CRUCIBLE_FAULT_COMMAND_ACCELERATOR_MEMORY_EVENT:
+    case CRUCIBLE_FAULT_COMMAND_ACCELERATOR_SERVICE:
+        return rule->target_kind == CRUCIBLE_NODE_FAULT_TARGET_ACCELERATOR;
+    default:
+        return false;
+    }
+}
+
+static bool node_operation_valid(uint16_t command_kind, uint16_t operation)
+{
+    if (operation == CRUCIBLE_NODE_FAULT_OPERATION_APPLY) {
+        switch (command_kind) {
+        case CRUCIBLE_FAULT_COMMAND_NODE_LIFECYCLE:
+        case CRUCIBLE_FAULT_COMMAND_CPU_REGISTER_TRANSFORM:
+        case CRUCIBLE_FAULT_COMMAND_CPU_EXCEPTION:
+        case CRUCIBLE_FAULT_COMMAND_MEMORY_ECC_EVENT:
+        case CRUCIBLE_FAULT_COMMAND_CLOCK_TRANSFORM:
+        case CRUCIBLE_FAULT_COMMAND_ACCELERATOR_MEMORY_EVENT:
+            return true;
+        default:
+            return false;
+        }
+    }
+    if (operation == CRUCIBLE_NODE_FAULT_OPERATION_UPSERT ||
+        operation == CRUCIBLE_NODE_FAULT_OPERATION_REMOVE) {
+        return command_kind != CRUCIBLE_FAULT_COMMAND_CPU_EXCEPTION;
+    }
+    return false;
+}
+
+static bool node_ratio_capacity_valid(QemuCrucibleFaultRule *rule, uint16_t tag)
+{
+    CrucibleNodeField *field = node_field(rule, tag);
+    uint64_t numerator, denominator;
+
+    if (!field || field->type != CRUCIBLE_NODE_FAULT_FIELD_TYPE_RATIO) {
+        return false;
+    }
+    numerator = node_get_u64(field->data);
+    denominator = node_get_u64(field->data + 8);
+    return numerator != 0 && numerator <= denominator;
+}
+
+static bool node_target_memory_valid(QemuCrucibleFaultRule *rule)
+{
+    bool has_vcpu;
+    uint32_t vcpu;
+    uint64_t start, length;
+
+    return node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_T2, &start) &&
+           node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_T3, &has_vcpu) &&
+           node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_T4, &vcpu) &&
+           node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_T5, &length) &&
+           length != 0 && length <= UINT64_MAX - start &&
+           (has_vcpu || vcpu == 0);
+}
+
+static bool node_rule_policies_valid(QemuCrucibleFaultRule *rule)
+{
+    uint32_t kind;
+
+    switch (rule->command_kind) {
+    case CRUCIBLE_FAULT_COMMAND_NODE_LIFECYCLE:
+        return node_policy_parse(node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P3),
+                                 node_json_boot_policy);
+    case CRUCIBLE_FAULT_COMMAND_NODE_HANG:
+        return node_policy_parse(node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P2),
+                                 node_json_hang_scope_any) &&
+               node_policy_parse(node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P4),
+                                 node_json_watchdog);
+    case CRUCIBLE_FAULT_COMMAND_CPU_SERVICE:
+        return node_policy_parse(node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P1),
+                                 node_json_vcpus);
+    case CRUCIBLE_FAULT_COMMAND_CPU_REGISTER_TRANSFORM:
+        return node_policy_parse(node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P8),
+                                 node_json_occurrence);
+    case CRUCIBLE_FAULT_COMMAND_CPU_INSTRUCTION_TRANSFORM:
+        if (!node_policy_parse(node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P1),
+                               node_json_instruction_selector) ||
+            !node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P2, &kind)) {
+            return false;
+        }
+        return kind != 1 ||
+               node_policy_parse(node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P4),
+                                 node_json_register_mutation);
+    case CRUCIBLE_FAULT_COMMAND_CPU_EXCEPTION:
+        return node_policy_parse(node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P1),
+                                 node_json_exception);
+    case CRUCIBLE_FAULT_COMMAND_INTERRUPT_STORM:
+        return node_policy_parse(node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P6),
+                                 node_json_interrupt_routing);
+    case CRUCIBLE_FAULT_COMMAND_MEMORY_ACCESS_TRANSFORM:
+        if (!node_policy_parse(node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P7),
+                               node_json_occurrence) ||
+            !node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P3, &kind)) {
+            return false;
+        }
+        return kind != 5 ||
+               node_policy_parse(node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P6),
+                                 node_json_poison);
+    case CRUCIBLE_FAULT_COMMAND_MEMORY_ECC_EVENT:
+        return node_policy_parse(node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P7),
+                                 node_json_ecc_visibility);
+    case CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE:
+        return node_policy_parse(node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P4),
+                                 node_json_memory_region_any);
+    case CRUCIBLE_FAULT_COMMAND_MEMORY_SERVICE:
+        return node_policy_parse(node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P6),
+                                 node_json_memory_service_scope);
+    case CRUCIBLE_FAULT_COMMAND_CLOCK_TRANSFORM:
+        if (!node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P2, &kind)) {
+            return false;
+        }
+        if (kind == 4) {
+            return node_policy_parse(
+                node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P6),
+                node_json_clock_release_any);
+        }
+        if (kind == 5) {
+            return node_policy_parse(
+                node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P6),
+                node_json_jitter_any);
+        }
+        if (kind == 6) {
+            return node_policy_parse(
+                node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P6),
+                node_json_wander_any);
+        }
+        return true;
+    case CRUCIBLE_FAULT_COMMAND_CLOCK_SOURCE_STATE:
+        return node_policy_parse(node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P2),
+                                 node_json_clock_transition) &&
+               node_policy_parse(node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P3),
+                                 node_json_clock_sync);
+    case CRUCIBLE_FAULT_COMMAND_ACCELERATOR_RESULT_TRANSFORM:
+        return node_policy_parse(node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P1),
+                                 node_json_accelerator_job) &&
+               node_policy_parse(node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P2),
+                                 node_json_accelerator_result);
+    case CRUCIBLE_FAULT_COMMAND_ACCELERATOR_SERVICE:
+        return node_policy_parse(node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P6),
+                                 node_json_accelerator_thermal);
+    default:
+        return true;
+    }
+}
+
+static bool node_fields_equal(QemuCrucibleFaultRule *rule, uint16_t left,
+                              uint16_t right)
+{
+    CrucibleNodeField *a = node_field(rule, left);
+    CrucibleNodeField *b = node_field(rule, right);
+
+    return a && b && a->length == b->length &&
+           memcmp(a->data, b->data, a->length) == 0;
+}
+
+static bool node_json_vcpu_contains(const QObject *object, uint32_t selected)
+{
+    QList *list = qobject_to(QList, object);
+    QListEntry *entry;
+
+    if (!list) {
+        return false;
+    }
+    QLIST_FOREACH_ENTRY(list, entry) {
+        uint32_t value;
+
+        if (node_json_u32(qlist_entry_obj(entry), &value) &&
+            value == selected) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static bool node_bytes_nontrivial_selector(const CrucibleNodeField *field)
+{
+    bool has_zero = false;
+    bool has_one = false;
+
+    if (!field) {
+        return false;
+    }
+    for (size_t i = 0; i < field->length; i++) {
+        has_zero |= field->data[i] != UINT8_MAX;
+        has_one |= field->data[i] != 0;
+    }
+    return has_zero && has_one;
+}
+
+static bool node_rule_cross_fields_valid(QemuCrucibleFaultRule *rule)
+{
+    CrucibleNodeField *field;
+    uint32_t kind, other, target_vcpu;
+    uint64_t first, second, target_start, target_length;
+    bool present, other_present, transform_present;
+
+    if (!node_target_pair_valid(rule)) {
+        return false;
+    }
+    switch (rule->command_kind) {
+    case CRUCIBLE_FAULT_COMMAND_NODE_LIFECYCLE: {
+        const char *boot_kind;
+
+        if (!node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P1, &kind) ||
+            kind < 1 || kind > 6 ||
+            !node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P4, &other) ||
+            other < 1 || other > 2 ||
+            !node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P5, &other) ||
+            other < 1 || other > 3) {
+            return false;
+        }
+        field = node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P3);
+        boot_kind = qdict_get_try_str(qobject_to(QDict, field->json), "kind");
+        return strcmp(boot_kind, "immediate") == 0 ||
+               ((kind == 1 || kind == 3 || kind == 5) &&
+                strcmp(boot_kind, "require_ready") == 0);
+    }
+    case CRUCIBLE_FAULT_COMMAND_NODE_HANG:
+        if (!node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P1, &kind) ||
+            kind < 1 || kind > 3 ||
+            !node_json_hang_scope(
+                node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P2)->json, kind)) {
+            return false;
+        }
+        return (kind == 1 &&
+                rule->target_kind == CRUCIBLE_NODE_FAULT_TARGET_NODE) ||
+               (kind == 2 &&
+                rule->target_kind == CRUCIBLE_NODE_FAULT_TARGET_VCPU) ||
+               (kind == 3 &&
+                rule->target_kind == CRUCIBLE_NODE_FAULT_TARGET_ACCELERATOR);
+    case CRUCIBLE_FAULT_COMMAND_CPU_SERVICE:
+        if (!node_ratio_capacity_valid(rule, CRUCIBLE_NODE_FAULT_FIELD_P2) ||
+            !node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_P3, &first) ||
+            first == 0 ||
+            !node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P4, &kind) ||
+            kind < 1 || kind > 2) {
+            return false;
+        }
+        return rule->target_kind == CRUCIBLE_NODE_FAULT_TARGET_NODE ||
+               (node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_T1,
+                               &target_vcpu) &&
+                node_json_vcpu_contains(
+                    node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P1)->json,
+                    target_vcpu));
+    case CRUCIBLE_FAULT_COMMAND_CPU_VCPU_STATE:
+        return node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P1, &kind) &&
+               kind >= 1 && kind <= 3 &&
+               node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_P2, &present) &&
+               present == (kind != 1) &&
+               (present ?
+                node_field_nonzero(rule, CRUCIBLE_NODE_FAULT_FIELD_P3) :
+                node_field_zero(rule, CRUCIBLE_NODE_FAULT_FIELD_P3));
+    case CRUCIBLE_FAULT_COMMAND_CPU_REGISTER_TRANSFORM: {
+        uint32_t first_bit, bit_count, target_first, target_count;
+        size_t bytes;
+
+        if (!node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P2, &first_bit) ||
+            !node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P3, &bit_count) ||
+            bit_count == 0 || first_bit > 65536 ||
+            bit_count > 65536 - first_bit ||
+            !node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_T4,
+                            &target_first) ||
+            !node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_T5,
+                            &target_count) ||
+            first_bit != target_first || bit_count != target_count ||
+            !node_fields_equal(rule, CRUCIBLE_NODE_FAULT_FIELD_P1,
+                               CRUCIBLE_NODE_FAULT_FIELD_T3) ||
+            !node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P4, &kind) ||
+            kind < 1 || kind > 3 ||
+            !node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_P6, &present)) {
+            return false;
+        }
+        bytes = (bit_count + 7) / 8;
+        field = node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P5);
+        if (!field || field->length != bytes ||
+            ((kind == 1 || kind == 2) && !node_field_nonzero(
+                rule, CRUCIBLE_NODE_FAULT_FIELD_P5))) {
+            return false;
+        }
+        field = node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P7);
+        return present == (kind != 1) && field &&
+               (present ? field->length == bytes : node_field_zero(
+                    rule, CRUCIBLE_NODE_FAULT_FIELD_P7));
+    }
+    case CRUCIBLE_FAULT_COMMAND_CPU_INSTRUCTION_TRANSFORM:
+        if (!node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P2, &kind) ||
+            kind < 1 || kind > 3 ||
+            !node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P5, &other)) {
+            return false;
+        }
+        if (kind == 1) {
+            return node_field_nonzero(rule, CRUCIBLE_NODE_FAULT_FIELD_P3) &&
+                   other == 0;
+        }
+        return node_field_zero(rule, CRUCIBLE_NODE_FAULT_FIELD_P3) &&
+               node_field_zero(rule, CRUCIBLE_NODE_FAULT_FIELD_P4) &&
+               (kind == 2 ? other == 0 : other > 0 && other <= 256);
+    case CRUCIBLE_FAULT_COMMAND_CPU_EXCEPTION:
+        return true;
+    case CRUCIBLE_FAULT_COMMAND_INTERRUPT_DISPOSITION:
+        if (!node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P1, &kind) ||
+            kind < 1 || kind > 4 ||
+            !node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_P2, &first) ||
+            !node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P3, &other) ||
+            !node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_P4, &second)) {
+            return false;
+        }
+        return (kind == 1 && first == 0 && other == 0 && second == 0 &&
+                node_field_zero(rule, CRUCIBLE_NODE_FAULT_FIELD_P5)) ||
+               (kind == 2 && first > 0 && other == 0 && second == 0 &&
+                node_field_zero(rule, CRUCIBLE_NODE_FAULT_FIELD_P5)) ||
+               (kind == 3 && first == 0 && other > 0 && other <= 256 &&
+                second <= UINT64_MAX / other &&
+                node_field_zero(rule, CRUCIBLE_NODE_FAULT_FIELD_P5)) ||
+               (kind == 4 && first == 0 && other == 0 && second == 0);
+    case CRUCIBLE_FAULT_COMMAND_INTERRUPT_STORM:
+        return node_fields_equal(rule, CRUCIBLE_NODE_FAULT_FIELD_P1,
+                                 CRUCIBLE_NODE_FAULT_FIELD_T2) &&
+               node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P2, &kind) &&
+               node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_T4, &other) &&
+               kind == other &&
+               node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_P3, &first) &&
+               first > 0 &&
+               node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P4, &kind) &&
+               kind > 0 && kind <= 4194304 &&
+               node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P5, &kind) &&
+               kind > 0 && kind <= 4194304;
+    case CRUCIBLE_FAULT_COMMAND_MEMORY_ACCESS_TRANSFORM:
+        if (!node_target_memory_valid(rule) ||
+            !node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_P1, &first) ||
+            !node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_P2, &second) ||
+            !node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_T2,
+                            &target_start) ||
+            !node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_T5,
+                            &target_length) ||
+            first != target_start || second != target_length ||
+            !node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P3, &kind) ||
+            kind < 1 || kind > 5 ||
+            !node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_P5, &present) ||
+            !node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P8, &other) ||
+            other == 0 || (other & ~0x1fU) != 0 ||
+            !node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_P9,
+                             &other_present)) {
+            return false;
+        }
+        if (kind == 1) {
+            field = node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P4);
+            return present && field && node_field_nonzero(
+                       rule, CRUCIBLE_NODE_FAULT_FIELD_P4) &&
+                   node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P6)->length ==
+                       field->length && !other_present;
+        }
+        if (kind == 2) {
+            return !present && !other_present && (other & 0x0bU) != 0 &&
+                   node_field_nonzero(rule, CRUCIBLE_NODE_FAULT_FIELD_P4) &&
+                   node_field_zero(rule, CRUCIBLE_NODE_FAULT_FIELD_P6);
+        }
+        if (kind == 3) {
+            return !present && !other_present && (other & 0x14U) != 0 &&
+                   node_field_zero(rule, CRUCIBLE_NODE_FAULT_FIELD_P4) &&
+                   node_field_zero(rule, CRUCIBLE_NODE_FAULT_FIELD_P6);
+        }
+        if (kind == 4) {
+            return present && (other & 0x14U) != 0 &&
+                   node_field_zero(rule, CRUCIBLE_NODE_FAULT_FIELD_P4) &&
+                   node_bytes_nontrivial_selector(
+                       node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P6));
+        }
+        return present && !other_present &&
+               node_field_zero(rule, CRUCIBLE_NODE_FAULT_FIELD_P4);
+    case CRUCIBLE_FAULT_COMMAND_MEMORY_ECC_EVENT:
+        return node_target_memory_valid(rule) &&
+               node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P1, &kind) &&
+               kind >= 1 && kind <= 2 &&
+               node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_P2, &first) &&
+               node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_T2,
+                              &target_start) &&
+               node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_T5,
+                              &target_length) &&
+               first >= target_start && first - target_start < target_length;
+    case CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE:
+        return node_target_memory_valid(rule) &&
+               node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_P1, &first) &&
+               node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_P2, &second) &&
+               node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_T2,
+                              &target_start) &&
+               node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_T5,
+                              &target_length) &&
+               first == target_start && second == target_length &&
+               node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P3, &kind) &&
+               kind >= 1 && kind <= 3 &&
+               node_json_memory_region(
+                   node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P4)->json, kind);
+    case CRUCIBLE_FAULT_COMMAND_MEMORY_SERVICE:
+        return node_target_memory_valid(rule) &&
+               node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_P1, &first) &&
+               node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_P2, &present) &&
+               node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_P3, &second) &&
+               present == (second != 0) &&
+               node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_P4,
+                               &other_present) &&
+               node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_P5,
+                              &target_length) &&
+               other_present == (target_length != 0) &&
+               (first != 0 || present || other_present);
+    case CRUCIBLE_FAULT_COMMAND_CLOCK_TRANSFORM:
+        if (!node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P2, &kind) ||
+            kind < 1 || kind > 6 ||
+            !node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P7, &other) ||
+            other < 1 || other > 3 ||
+            !node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P8, &other) ||
+            other < 1 || other > 3 ||
+            !node_fields_equal(rule, CRUCIBLE_NODE_FAULT_FIELD_P1,
+                               CRUCIBLE_NODE_FAULT_FIELD_T1)) {
+            return false;
+        }
+        return (kind >= 4 ||
+                node_field_zero(rule, CRUCIBLE_NODE_FAULT_FIELD_P6)) &&
+               (kind != 2 || node_ratio_capacity_valid(
+                    rule, CRUCIBLE_NODE_FAULT_FIELD_P4));
+    case CRUCIBLE_FAULT_COMMAND_CLOCK_SOURCE_STATE:
+        return true;
+    case CRUCIBLE_FAULT_COMMAND_ACCELERATOR_LIFECYCLE:
+        return node_fields_equal(rule, CRUCIBLE_NODE_FAULT_FIELD_P1,
+                                 CRUCIBLE_NODE_FAULT_FIELD_T1) &&
+               node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P2, &kind) &&
+               kind >= 1 && kind <= 3 &&
+               node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P3, &kind) &&
+               kind >= 1 && kind <= 3 &&
+               node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P4, &kind) &&
+               kind >= 1 && kind <= 3;
+    case CRUCIBLE_FAULT_COMMAND_ACCELERATOR_RESULT_TRANSFORM:
+        return true;
+    case CRUCIBLE_FAULT_COMMAND_ACCELERATOR_MEMORY_EVENT:
+        return node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_P1, &first) &&
+               node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_P2, &second) &&
+               second != 0 && second <= UINT64_MAX - first &&
+               node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_P3, &present) &&
+               node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P4, &kind) &&
+               node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_P5,
+                               &other_present) &&
+               node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_P6,
+                              &target_length) &&
+               node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_P7,
+                               &transform_present) &&
+               ((present && kind >= 1 && kind <= 2 && other_present &&
+                 !transform_present &&
+                 node_field_zero(rule, CRUCIBLE_NODE_FAULT_FIELD_P8)) ||
+                (!present && kind == 0 && !other_present &&
+                 target_length == 0 && transform_present &&
+                 node_field_nonzero(rule, CRUCIBLE_NODE_FAULT_FIELD_P8)));
+    case CRUCIBLE_FAULT_COMMAND_ACCELERATOR_SERVICE:
+        return node_ratio_capacity_valid(rule, CRUCIBLE_NODE_FAULT_FIELD_P1) &&
+               node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_P2, &present) &&
+               node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_P3, &second) &&
+               present == (second != 0) &&
+               node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_P4,
+                               &other_present) &&
+               node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_P5, &first) &&
+               other_present == (first != 0);
+    default:
+        return false;
+    }
+}
+
+static int node_parse(const struct qemu_plugin_crucible_fault_command *command,
+                      const uint8_t *payload, size_t payload_len,
+                      QemuCrucibleFaultRule *rule)
+{
+    const NodeSchemaField *parameters;
+    const NodeSchemaField *targets;
+    size_t parameter_count;
+    size_t target_count;
+    size_t offset;
+    uint16_t previous_tag = 0;
+
+    if (payload_len < CRUCIBLE_NODE_FAULT_PAYLOAD_HEADER_V1_BYTES ||
+        payload_len > CRUCIBLE_FAULT_HARD_PAYLOAD_BYTES ||
+        memcmp(payload, CRUCIBLE_NODE_MAGIC, 8) != 0 ||
+        node_get_u16(payload + CRUCIBLE_NODE_FAULT_PAYLOAD_VERSION_OFFSET) !=
+            CRUCIBLE_NODE_FAULT_PAYLOAD_VERSION_V1 ||
+        node_get_u16(payload +
+                     CRUCIBLE_NODE_FAULT_PAYLOAD_RESERVED_OFFSET) != 0 ||
+        node_get_u16(
+            payload +
+            CRUCIBLE_NODE_FAULT_PAYLOAD_TRAILING_RESERVED_OFFSET) != 0) {
+        return -EINVAL;
+    }
+    memset(rule, 0, sizeof(*rule));
+    rule->command_kind = node_get_u16(
+        payload + CRUCIBLE_NODE_FAULT_PAYLOAD_COMMAND_KIND_OFFSET);
+    rule->operation = node_get_u16(
+        payload + CRUCIBLE_NODE_FAULT_PAYLOAD_OPERATION_OFFSET);
+    rule->target_kind = node_get_u16(
+        payload + CRUCIBLE_NODE_FAULT_PAYLOAD_TARGET_KIND_OFFSET);
+    rule->model_phase = node_get_u16(
+        payload + CRUCIBLE_NODE_FAULT_PAYLOAD_MODEL_PHASE_OFFSET);
+    rule->generation = node_get_u64(
+        payload + CRUCIBLE_NODE_FAULT_PAYLOAD_GENERATION_OFFSET);
+    rule->field_count = node_get_u16(
+        payload + CRUCIBLE_NODE_FAULT_PAYLOAD_FIELD_COUNT_OFFSET);
+    rule->command_sequence = command->command_sequence;
+    memcpy(rule->binding_hash, command->binding_hash, 32);
+    memcpy(rule->action_hash,
+           payload + CRUCIBLE_NODE_FAULT_PAYLOAD_ACTION_HASH_OFFSET, 32);
+    memcpy(rule->target_hash,
+           payload + CRUCIBLE_NODE_FAULT_PAYLOAD_TARGET_HASH_OFFSET, 32);
+    memcpy(rule->schema_hash,
+           payload + CRUCIBLE_NODE_FAULT_PAYLOAD_SCHEMA_HASH_OFFSET, 32);
+    if (rule->command_kind != command->command_kind ||
+        !node_operation_valid(rule->command_kind, rule->operation) ||
+        rule->model_phase == 0 || rule->generation == 0 ||
+        rule->field_count > CRUCIBLE_NODE_FAULT_MAX_FIELDS_V1 ||
+        !node_hash_nonzero(rule->binding_hash) ||
+        !node_hash_nonzero(rule->action_hash) ||
+        !node_hash_nonzero(rule->target_hash) ||
+        !node_hash_nonzero(rule->schema_hash) ||
+        !node_schema_for(rule->command_kind, &parameters, &parameter_count) ||
+        !node_target_schema_for(rule->target_kind, &targets, &target_count)) {
+        return -EINVAL;
+    }
+    rule->payload = g_memdup2(payload, payload_len);
+    rule->payload_len = payload_len;
+    offset = CRUCIBLE_NODE_FAULT_PAYLOAD_HEADER_V1_BYTES;
+    for (size_t i = 0; i < rule->field_count; i++) {
+        CrucibleNodeField *field = &rule->fields[i];
+        size_t end;
+
+        if (offset > payload_len || payload_len - offset <
+            CRUCIBLE_NODE_FAULT_FIELD_HEADER_V1_BYTES) {
+            return -EINVAL;
+        }
+        field->tag = node_get_u16(rule->payload + offset +
+                                  CRUCIBLE_NODE_FAULT_FIELD_TAG_OFFSET);
+        field->type = node_get_u16(rule->payload + offset +
+                                   CRUCIBLE_NODE_FAULT_FIELD_TYPE_OFFSET);
+        field->length = node_get_u32(rule->payload + offset +
+                                     CRUCIBLE_NODE_FAULT_FIELD_LENGTH_OFFSET);
+        offset += CRUCIBLE_NODE_FAULT_FIELD_HEADER_V1_BYTES;
+        end = offset + field->length;
+        if (end < offset || end > payload_len || field->tag <= previous_tag) {
+            return -EINVAL;
+        }
+        field->data = rule->payload + offset;
+        if (!node_field_value_valid(field->type, field->data, field->length)) {
+            return -EINVAL;
+        }
+        previous_tag = field->tag;
+        offset = end;
+    }
+    if (offset != payload_len) {
+        return -EINVAL;
+    }
+    if (!node_target_pair_valid(rule)) {
+        return -EINVAL;
+    }
+    if (rule->operation == CRUCIBLE_NODE_FAULT_OPERATION_REMOVE) {
+        return rule->field_count == 0 ? 0 : -EINVAL;
+    }
+    if (rule->operation == CRUCIBLE_NODE_FAULT_OPERATION_APPLY &&
+        !crucible_node_impulses[rule->command_kind]) {
+        return -EINVAL;
+    }
+    if (rule->field_count != parameter_count + target_count) {
+        return -EINVAL;
+    }
+    for (size_t i = 0; i < parameter_count; i++) {
+        if (!node_field_matches(rule, &parameters[i])) {
+            return -EINVAL;
+        }
+    }
+    for (size_t i = 0; i < target_count; i++) {
+        if (!node_field_matches(rule, &targets[i])) {
+            return -EINVAL;
+        }
+    }
+    return node_rule_policies_valid(rule) &&
+           node_rule_cross_fields_valid(rule) ? 0 : -EINVAL;
+}
+
+static void node_staging_clear(CrucibleNodeStaging *staging)
+{
+    if (!staging) {
+        return;
+    }
+    node_rule_clear(&staging->rule);
+    if (staging->impulse_evidence) {
+        g_byte_array_unref(staging->impulse_evidence);
+    }
+    g_free(staging);
+}
+
+static int node_validate(
+    const struct qemu_plugin_crucible_fault_command *command,
+    const uint8_t *payload, size_t payload_len)
+{
+    QemuCrucibleFaultRule rule = { 0 };
+    int status = node_parse(command, payload, payload_len, &rule);
+
+    node_rule_clear(&rule);
+    return status;
+}
+
+static int node_arm(const struct qemu_plugin_crucible_fault_command *command,
+                    const uint8_t *payload, size_t payload_len,
+                    void **state_out)
+{
+    CrucibleNodeStaging *staging = g_new0(CrucibleNodeStaging, 1);
+    int status = node_parse(command, payload, payload_len, &staging->rule);
+
+    if (status != 0) {
+        node_staging_clear(staging);
+        return status;
+    }
+    staging->impulse = crucible_node_impulses[command->command_kind];
+    *state_out = staging;
+    return 0;
+}
+
+static void node_encode_evidence(CrucibleNodeStaging *staging,
+                                 GByteArray *payload)
+{
+    uint8_t evidence[CRUCIBLE_NODE_FAULT_EVIDENCE_V1_BYTES] = { 0 };
+
+    memcpy(evidence + CRUCIBLE_NODE_FAULT_EVIDENCE_MAGIC_OFFSET,
+           CRUCIBLE_NODE_EVIDENCE_MAGIC, 8);
+    stw_le_p(evidence + CRUCIBLE_NODE_FAULT_EVIDENCE_VERSION_OFFSET,
+             CRUCIBLE_NODE_FAULT_PAYLOAD_VERSION_V1);
+    stw_le_p(evidence + CRUCIBLE_NODE_FAULT_EVIDENCE_COMMAND_KIND_OFFSET,
+             staging->rule.command_kind);
+    stw_le_p(evidence + CRUCIBLE_NODE_FAULT_EVIDENCE_OPERATION_OFFSET,
+             staging->rule.operation);
+    stw_le_p(evidence + CRUCIBLE_NODE_FAULT_EVIDENCE_TARGET_KIND_OFFSET,
+             staging->rule.target_kind);
+    stw_le_p(evidence + CRUCIBLE_NODE_FAULT_EVIDENCE_MODEL_PHASE_OFFSET,
+             staging->rule.model_phase);
+    stq_le_p(evidence + CRUCIBLE_NODE_FAULT_EVIDENCE_GENERATION_OFFSET,
+             staging->rule.generation);
+    stq_le_p(evidence + CRUCIBLE_NODE_FAULT_EVIDENCE_PRIOR_GENERATION_OFFSET,
+             staging->prior ? staging->prior->generation : 0);
+    memcpy(evidence + CRUCIBLE_NODE_FAULT_EVIDENCE_ACTION_HASH_OFFSET,
+           staging->rule.action_hash, 32);
+    memcpy(evidence + CRUCIBLE_NODE_FAULT_EVIDENCE_TARGET_HASH_OFFSET,
+           staging->rule.target_hash, 32);
+    memcpy(evidence + CRUCIBLE_NODE_FAULT_EVIDENCE_SCHEMA_HASH_OFFSET,
+           staging->rule.schema_hash, 32);
+    memcpy(evidence + CRUCIBLE_NODE_FAULT_EVIDENCE_REQUEST_SHA256_OFFSET,
+           staging->request_hash, 32);
+    memcpy(evidence + CRUCIBLE_NODE_FAULT_EVIDENCE_BEFORE_SHA256_OFFSET,
+           staging->before_hash, 32);
+    memcpy(evidence + CRUCIBLE_NODE_FAULT_EVIDENCE_AFTER_SHA256_OFFSET,
+           staging->after_hash, 32);
+    g_byte_array_append(payload, evidence, sizeof(evidence));
+}
+
+static bool node_memory_gpa_is_ram(uint64_t start, uint64_t length)
+{
+    uint64_t current = start;
+    uint64_t remaining = length;
+
+    while (remaining != 0) {
+        hwaddr translated;
+        hwaddr available = remaining;
+        MemoryRegion *region = address_space_translate(
+            &address_space_memory, current, &translated, &available, false,
+            MEMTXATTRS_UNSPECIFIED);
+
+        if (!region || available == 0 || !memory_region_is_ram(region) ||
+            memory_region_is_ram_device(region) ||
+            memory_region_is_rom(region)) {
+            return false;
+        }
+        current += available;
+        remaining -= available;
+    }
+    return true;
+}
+
+static int node_memory_resolve_target(QemuCrucibleFaultRule *rule)
+{
+    g_autoptr(GChecksum) checksum = NULL;
+    uint64_t start, length;
+    uint32_t vcpu;
+    bool has_vcpu;
+
+    if (rule->target_kind != CRUCIBLE_NODE_FAULT_TARGET_MEMORY ||
+        !node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_T2, &start) ||
+        !node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_T5, &length) ||
+        !node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_T3, &has_vcpu) ||
+        !node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_T4, &vcpu)) {
+        return -EINVAL;
+    }
+    rule->translations = g_array_new(
+        false, false, sizeof(CrucibleNodeTranslation));
+    if (rule->command_kind == CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE) {
+        uint32_t region_kind;
+
+        g_assert(node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P3,
+                                &region_kind));
+        if (region_kind == 3) {
+            QDict *process = qobject_to(
+                QDict, node_field(rule,
+                    CRUCIBLE_NODE_FAULT_FIELD_P4)->json);
+            QDict *parameters = qdict_get_qdict(process, "parameters");
+            uint64_t row_bytes, rows;
+
+            g_assert(node_json_u64(qdict_get(parameters, "row_bytes"),
+                                   &row_bytes));
+            rows = length / row_bytes + (length % row_bytes != 0);
+            if (rows > CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT) {
+                return -ENOSPC;
+            }
+            rule->row_counts = g_array_sized_new(
+                false, true, sizeof(uint64_t), rows);
+            g_array_set_size(rule->row_counts, rows);
+        }
+    }
+    if (!has_vcpu) {
+        return node_memory_gpa_is_ram(start, length) ? 0 : -EFAULT;
+    }
+
+    CPUState *cpu = qemu_get_cpu(vcpu);
+    uint64_t current = start;
+    uint64_t remaining = length;
+
+    if (!cpu) {
+        return -ENOENT;
+    }
+    while (remaining != 0) {
+        CPUFaultTranslation resolved;
+        CrucibleNodeTranslation translation = { 0 };
+        uint64_t offset, available;
+
+        if (!cpu_get_fault_translation(cpu, current, &resolved) ||
+            resolved.page_size == 0) {
+            return -EFAULT;
+        }
+        offset = current % resolved.page_size;
+        if (offset > resolved.physical_address) {
+            return -EFAULT;
+        }
+        translation.virtual_page = current - offset;
+        translation.physical_page = resolved.physical_address - offset;
+        translation.page_size = resolved.page_size;
+        available = resolved.page_size - offset;
+        translation.covered_bytes = MIN(remaining, available);
+        if (!node_memory_gpa_is_ram(resolved.physical_address,
+                                    translation.covered_bytes)) {
+            return -EFAULT;
+        }
+        g_array_append_val(rule->translations, translation);
+        current += translation.covered_bytes;
+        remaining -= translation.covered_bytes;
+    }
+
+    checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    g_checksum_update(checksum, (const uint8_t *)"CRUCNTX1", 8);
+    for (guint i = 0; i < rule->translations->len; i++) {
+        CrucibleNodeTranslation *translation = &g_array_index(
+            rule->translations, CrucibleNodeTranslation, i);
+        uint8_t encoded[32] = { 0 };
+
+        stq_le_p(encoded, translation->virtual_page);
+        stq_le_p(encoded + 8, translation->physical_page);
+        stq_le_p(encoded + 16, translation->page_size);
+        stl_le_p(encoded + 24, translation->covered_bytes);
+        g_checksum_update(checksum, encoded, sizeof(encoded));
+    }
+    gsize digest_length = sizeof(rule->translation_hash);
+
+    g_checksum_get_digest(checksum, rule->translation_hash, &digest_length);
+    g_assert(digest_length == sizeof(rule->translation_hash));
+    return 0;
+}
+
+static int node_prepare(
+    const struct qemu_plugin_crucible_fault_command *command,
+    const uint8_t *payload, size_t payload_len, void *state,
+    struct qemu_plugin_crucible_fault_result *result,
+    GByteArray *result_payload)
+{
+    CrucibleNodeStaging *staging = state;
+    int status;
+
+    staging->prior = node_find_rule(staging->rule.command_kind,
+                                    staging->rule.binding_hash, NULL);
+    if (staging->prior &&
+        staging->rule.generation <= staging->prior->generation) {
+        result->status = CRUCIBLE_FAULT_STATUS_PRECONDITION_MISMATCH;
+        return -EINVAL;
+    }
+    if (staging->rule.operation == CRUCIBLE_NODE_FAULT_OPERATION_REMOVE &&
+        !staging->prior) {
+        result->status = CRUCIBLE_FAULT_STATUS_PRECONDITION_MISMATCH;
+        return -ENOENT;
+    }
+    if (staging->rule.operation == CRUCIBLE_NODE_FAULT_OPERATION_UPSERT &&
+        staging->rule.target_kind == CRUCIBLE_NODE_FAULT_TARGET_MEMORY) {
+        status = node_memory_resolve_target(&staging->rule);
+        if (status != 0) {
+            result->status = CRUCIBLE_FAULT_STATUS_PRECONDITION_MISMATCH;
+            return status;
+        }
+        if (!node_memory_rule_admissible(&staging->rule)) {
+            result->status = CRUCIBLE_FAULT_STATUS_RESOURCE_LIMIT;
+            return -ENOSPC;
+        }
+    }
+    node_sha256(payload, payload_len, staging->request_hash);
+    node_rules_digest_with(NULL, false, staging->before_hash);
+    if (staging->rule.operation == CRUCIBLE_NODE_FAULT_OPERATION_UPSERT) {
+        node_rules_digest_with(&staging->rule, false, staging->after_hash);
+    } else if (staging->rule.operation ==
+               CRUCIBLE_NODE_FAULT_OPERATION_REMOVE) {
+        node_rules_digest_with(&staging->rule, true, staging->after_hash);
+    } else {
+        if (crucible_node_event_count >= CRUCIBLE_NODE_EVENT_CAPACITY) {
+            result->status = CRUCIBLE_FAULT_STATUS_RESOURCE_LIMIT;
+            return -ENOSPC;
+        }
+        memcpy(staging->after_hash, staging->before_hash, 32);
+    }
+    memcpy(result->before_hash, staging->before_hash, 32);
+    memcpy(result->after_hash, staging->after_hash, 32);
+    node_encode_evidence(staging, result_payload);
+    node_sha256(result_payload->data, result_payload->len,
+                result->evidence_hash);
+    return 0;
+}
+
+static void node_event_enqueue(const QemuCrucibleFaultRule *rule,
+                               uint16_t outcome, uint64_t observed_icount,
+                               const uint8_t opportunity_hash[32],
+                               const uint8_t before_hash[32],
+                               const uint8_t after_hash[32],
+                               const uint8_t *evidence, size_t evidence_len)
+{
+    CrucibleNodeEvent *queued;
+
+    node_events_ensure();
+    if (crucible_node_event_count >= CRUCIBLE_NODE_EVENT_CAPACITY ||
+        evidence_len == 0 || evidence_len > CRUCIBLE_FAULT_HARD_PAYLOAD_BYTES) {
+        error_report(
+            "Crucible fault event transport cannot preserve occurrence");
+        abort();
+    }
+    queued = QTAILQ_FIRST(&crucible_node_free_events);
+    g_assert(queued);
+    QTAILQ_REMOVE(&crucible_node_free_events, queued, link);
+    memset(&queued->event, 0, sizeof(queued->event));
+    queued->event.command_kind = rule->command_kind;
+    queued->event.outcome = outcome;
+    queued->event.model_phase = rule->model_phase;
+    queued->event.target_kind = rule->target_kind;
+    queued->event.event_sequence = ++crucible_node_event_sequence;
+    queued->event.rule_command_sequence = rule->command_sequence;
+    queued->event.observed_icount = observed_icount;
+    queued->event.generation = rule->generation;
+    memcpy(queued->event.binding_hash, rule->binding_hash, 32);
+    memcpy(queued->event.opportunity_hash, opportunity_hash, 32);
+    memcpy(queued->event.action_hash, rule->action_hash, 32);
+    memcpy(queued->event.target_hash, rule->target_hash, 32);
+    memcpy(queued->event.before_hash, before_hash, 32);
+    memcpy(queued->event.after_hash, after_hash, 32);
+    queued->payload_length = evidence_len;
+    if (evidence_len <= sizeof(queued->inline_payload)) {
+        queued->payload = NULL;
+        memcpy(queued->inline_payload, evidence, evidence_len);
+    } else {
+        queued->payload = g_byte_array_sized_new(evidence_len);
+        g_byte_array_append(queued->payload, evidence, evidence_len);
+    }
+    QTAILQ_INSERT_TAIL(&crucible_node_events, queued, link);
+    crucible_node_event_count++;
+}
+
+static void node_commit(
+    const struct qemu_plugin_crucible_fault_command *command,
+    const uint8_t *payload, size_t payload_len, void *state,
+    struct qemu_plugin_crucible_fault_result *result,
+    GByteArray *result_payload)
+{
+    CrucibleNodeStaging *staging = state;
+    guint index;
+
+    if (staging->rule.operation == CRUCIBLE_NODE_FAULT_OPERATION_UPSERT) {
+        QemuCrucibleFaultRule *replacement = node_rule_copy(&staging->rule);
+
+        if (!node_memory_service_ledger_acquire(replacement)) {
+            error_report("Crucible memory service scope lost after prepare");
+            abort();
+        }
+        if (node_find_rule(replacement->command_kind,
+                           replacement->binding_hash, &index)) {
+            g_ptr_array_remove_index(crucible_node_rules, index);
+        }
+        g_ptr_array_add(crucible_node_rules, replacement);
+        g_ptr_array_sort(crucible_node_rules, node_rule_compare);
+        node_memory_index_rebuild();
+    } else if (staging->rule.operation ==
+               CRUCIBLE_NODE_FAULT_OPERATION_REMOVE) {
+        g_assert(node_find_rule(staging->rule.command_kind,
+                                staging->rule.binding_hash, &index));
+        g_ptr_array_remove_index(crucible_node_rules, index);
+        node_memory_index_rebuild();
+    } else {
+        uint8_t opportunity_hash[32];
+
+        staging->impulse_evidence = g_byte_array_new();
+        staging->impulse_outcome = CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED;
+        if (staging->impulse) {
+            int status = staging->impulse(
+                &staging->rule, result->observed_icount,
+                staging->before_hash, staging->after_hash,
+                staging->impulse_evidence, &staging->impulse_outcome);
+            if (status != 0) {
+                error_report(
+                    "Crucible prepared node impulse failed during commit");
+                abort();
+            }
+        }
+        if (staging->impulse_evidence->len == 0) {
+            g_byte_array_append(staging->impulse_evidence,
+                                staging->request_hash, 32);
+        }
+        node_sha256(staging->impulse_evidence->data,
+                    staging->impulse_evidence->len, opportunity_hash);
+        node_event_enqueue(&staging->rule, staging->impulse_outcome,
+                           result->observed_icount, opportunity_hash,
+                           staging->before_hash, staging->after_hash,
+                           staging->impulse_evidence->data,
+                           staging->impulse_evidence->len);
+        memcpy(result->after_hash, staging->after_hash, 32);
+    }
+    result->status = CRUCIBLE_FAULT_STATUS_APPLIED;
+    result->applied_icount = result->observed_icount;
+}
+
+void qemu_crucible_fault_node_register(uint16_t command_kind, uint16_t scope,
+                                       uint32_t phase_mask, const char *name,
+                                       QemuCrucibleFaultImpulseFn impulse)
+{
+    QemuCrucibleFaultHandler *handler = g_new0(QemuCrucibleFaultHandler, 1);
+
+    handler->capability.command_kind = command_kind;
+    handler->capability.scope = scope;
+    handler->capability.semantic_version =
+        CRUCIBLE_FAULT_COMMAND_SEMANTIC_VERSION;
+    handler->capability.phase_mask = phase_mask;
+    handler->capability.maximum_payload_bytes =
+        CRUCIBLE_FAULT_HARD_PAYLOAD_BYTES;
+    handler->capability.maximum_pending_commands =
+        CRUCIBLE_FAULT_DEFAULT_COMMAND_CAPACITY;
+    handler->capability.required_feature_bits = 0;
+    handler->capability.name = name;
+    handler->capability.payload_schema = "crucible.node-fault-payload.v1";
+    handler->validate = node_validate;
+    handler->arm = node_arm;
+    handler->prepare = node_prepare;
+    handler->commit = node_commit;
+    handler->free_state = (QemuCrucibleFaultFreeFn)node_staging_clear;
+    g_assert(!crucible_node_impulses[command_kind]);
+    crucible_node_impulses[command_kind] = impulse;
+    qemu_crucible_fault_register(handler);
+}
