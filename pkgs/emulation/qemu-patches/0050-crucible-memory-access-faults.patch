+typedef struct CrucibleFaultMemoryTransactionGuard {
+    bool active;
+} CrucibleFaultMemoryTransactionGuard;
+
+static void crucible_fault_memory_transaction_cleanup(
+    CrucibleFaultMemoryTransactionGuard *guard)
+{
+    if (guard->active) {
+        qemu_crucible_fault_memory_transaction_end();
+    }
+}
+
+#define CRUCIBLE_MEMORY_TRANSACTION_GUARD \
+    __attribute__((cleanup(crucible_fault_memory_transaction_cleanup)))
+
+static CrucibleFaultMemoryTransactionGuard
+crucible_fault_memory_transaction_start(
+    CPUState *cpu, enum QemuCrucibleMemoryAccessClass access_class,
+    vaddr address, size_t length, uintptr_t ra)
+{
+    bool active = qemu_crucible_fault_memory_rules_active();
+    vaddr tb_pc = 0;
+    uint32_t instruction_ordinal = 0;
+    bool has_instruction = cpu_get_tb_fault_identity(
+        ra, &tb_pc, &instruction_ordinal);
+
+    if (active) {
+        qemu_crucible_fault_memory_transaction_begin(
+            access_class, cpu->cpu_index, address, length,
+            qemu_plugin_icount_raw(), has_instruction, tb_pc,
+            instruction_ordinal);
+    }
+    return (CrucibleFaultMemoryTransactionGuard) { .active = active };
+}
