+    QListEntry *entry;
+
+    if (!list || qlist_empty(list) || qlist_size(list) > 4096) {
+        return false;
+    }
+    QLIST_FOREACH_ENTRY(list, entry) {
+        int64_t value;
+
+        if (!node_json_i64(qlist_entry_obj(entry), &value) ||
+            (value < 0 && (value == INT64_MIN || (uint64_t)-value > maximum)) ||
+            (value >= 0 && (uint64_t)value > maximum)) {
+            return false;
+        }
+    }
+    return true;
+}
