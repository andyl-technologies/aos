+static bool node_schema_for(uint16_t command_kind,
+                            const NodeSchemaField **fields, size_t *count)
+{
+#define SCHEMA(kind_, value_) \
+    case CRUCIBLE_FAULT_COMMAND_##kind_: \
+        return node_schema_select(fields, count, value_, G_N_ELEMENTS(value_))
+    switch (command_kind) {
+    SCHEMA(NODE_LIFECYCLE, schema_lifecycle);
+    SCHEMA(NODE_HANG, schema_hang);
+    SCHEMA(CPU_SERVICE, schema_cpu_service);
+    SCHEMA(CPU_VCPU_STATE, schema_vcpu_state);
+    SCHEMA(CPU_REGISTER_TRANSFORM, schema_register);
+    SCHEMA(CPU_INSTRUCTION_TRANSFORM, schema_instruction);
+    SCHEMA(CPU_EXCEPTION, schema_exception);
+    SCHEMA(INTERRUPT_DISPOSITION, schema_irq_disposition);
+    SCHEMA(INTERRUPT_STORM, schema_irq_storm);
+    SCHEMA(MEMORY_ACCESS_TRANSFORM, schema_memory_access);
+    SCHEMA(MEMORY_ECC_EVENT, schema_memory_ecc);
+    SCHEMA(MEMORY_REGION_STATE, schema_memory_region);
+    SCHEMA(MEMORY_SERVICE, schema_service);
+    SCHEMA(CLOCK_TRANSFORM, schema_clock);
+    SCHEMA(CLOCK_SOURCE_STATE, schema_clock_source);
+    SCHEMA(ACCELERATOR_LIFECYCLE, schema_accel_lifecycle);
+    SCHEMA(ACCELERATOR_RESULT_TRANSFORM, schema_accel_result);
+    SCHEMA(ACCELERATOR_MEMORY_EVENT, schema_accel_memory);
+    SCHEMA(ACCELERATOR_SERVICE, schema_service);
+    default:
+        return false;
+    }
+#undef SCHEMA
+}
