+static bool node_memory_rule_resources_ready(
+    QemuCrucibleFaultRule *rule)
+{
+    CrucibleMemoryReservedCounters *reserved =
+        node_memory_reserved_counter(rule, false);
+    uint64_t opportunities = reserved ? reserved->opportunities : 0;
+    uint64_t applied = reserved ? reserved->applied : 0;
+
+    return opportunities != UINT64_MAX && applied != UINT64_MAX &&
+           rule->opportunity_count <= UINT64_MAX - opportunities - 1 &&
+           rule->applied_count <= UINT64_MAX - applied - 1;
+}
+
+static void node_memory_rule_reservation_release(
+    CrucibleMemoryRuleReservation *reservation, bool opportunity)
+{
+    CrucibleMemoryReservedCounters *reserved;
+    bool *active = opportunity ? &reservation->opportunity :
+                                 &reservation->applied;
+    uint64_t *count;
+
+    if (!*active) {
+        return;
+    }
+    reserved = node_memory_reserved_counter(reservation->rule, false);
+    g_assert(reserved);
+    count = opportunity ? &reserved->opportunities : &reserved->applied;
+    g_assert(*count != 0);
+    (*count)--;
+    *active = false;
+    if (reserved->opportunities == 0 && reserved->applied == 0) {
+        g_hash_table_remove(crucible_memory_reserved_counters,
+                            reservation->rule);
+    }
+}
+
+static void node_memory_rule_reservation_consume(
+    QemuCrucibleFaultRule *rule, bool opportunity)
+{
+    CrucibleMemoryTransaction *transaction = &crucible_memory_transaction;
+    QemuCrucibleFaultRule *original = node_memory_shadow_original(rule);
+
+    for (guint i = 0;
+         transaction->rule_reservations &&
+         i < transaction->rule_reservations->len; i++) {
+        CrucibleMemoryRuleReservation *reservation = &g_array_index(
+            transaction->rule_reservations,
+            CrucibleMemoryRuleReservation, i);
+
+        if (reservation->rule == original) {
+            node_memory_rule_reservation_release(
+                reservation, opportunity);
+            return;
+        }
+    }
+    if (transaction->resources_preflighted) {
+        error_report("Crucible rule reservation is incomplete");
+        abort();
+    }
+}
+
+static void node_memory_reservations_release(
+    CrucibleMemoryTransaction *transaction)
+{
+    for (guint i = 0;
+         transaction->rule_reservations &&
+         i < transaction->rule_reservations->len; i++) {
+        CrucibleMemoryRuleReservation *reservation = &g_array_index(
+            transaction->rule_reservations,
+            CrucibleMemoryRuleReservation, i);
+
+        node_memory_rule_reservation_release(reservation, true);
+        node_memory_rule_reservation_release(reservation, false);
+    }
+    for (guint i = 0;
+         transaction->row_reservations &&
+         i < transaction->row_reservations->len; i++) {
+        CrucibleMemoryRowReservation *reservation = &g_array_index(
+            transaction->row_reservations,
+            CrucibleMemoryRowReservation, i);
+
+        if (reservation->active) {
+            CrucibleMemoryReservedRows *rows =
+                node_memory_reserved_row_set(reservation->rule, false);
+            uint64_t *count;
+
+            g_assert(rows);
+            count = g_hash_table_lookup(
+                rows->coordinates, &reservation->coordinate);
+            g_assert(count && *count != 0);
+            (*count)--;
+            if (*count == 0) {
+                g_hash_table_remove(rows->coordinates,
+                                    &reservation->coordinate);
+            }
+            if (g_hash_table_size(rows->coordinates) == 0) {
+                g_hash_table_remove(crucible_memory_reserved_rows,
+                                    reservation->rule);
+            }
+            reservation->active = false;
+        }
+    }
+    for (guint i = 0;
+         transaction->retention_reservations &&
+         i < transaction->retention_reservations->len; i++) {
+        CrucibleMemoryRetentionReservation *reservation = &g_array_index(
+            transaction->retention_reservations,
+            CrucibleMemoryRetentionReservation, i);
+
+        if (reservation->active) {
+            CrucibleMemoryReservedRetention *retention =
+                node_memory_reserved_retention_set(
+                    reservation->rule, false);
+            uint64_t *count;
+
+            g_assert(retention);
+            count = g_hash_table_lookup(retention->offsets,
+                                        &reservation->offset);
+            g_assert(count && *count != 0);
+            (*count)--;
+            if (*count == 0) {
+                g_hash_table_remove(retention->offsets,
+                                    &reservation->offset);
+            }
+            if (g_hash_table_size(retention->offsets) == 0) {
+                g_hash_table_remove(
+                    crucible_memory_reserved_retention,
+                    reservation->rule);
+            }
+            reservation->active = false;
+        }
+    }
+    for (guint i = 0;
+         transaction->ledger_reservations &&
+         i < transaction->ledger_reservations->len; i++) {
+        CrucibleMemoryLedgerReservation *reservation = &g_array_index(
+            transaction->ledger_reservations,
+            CrucibleMemoryLedgerReservation, i);
+        uint64_t *reserved = g_hash_table_lookup(
+            crucible_memory_reserved_ledgers, reservation->ledger);
+
+        g_assert(reserved && *reserved >= reservation->demand);
+        *reserved -= reservation->demand;
+        if (*reserved == 0) {
+            g_hash_table_remove(crucible_memory_reserved_ledgers,
+                                reservation->ledger);
+        }
+        reservation->demand = 0;
+    }
+    g_assert(crucible_memory_reserved_virtual_time >=
+             transaction->virtual_time_reservation);
+    crucible_memory_reserved_virtual_time -=
+        transaction->virtual_time_reservation;
+    transaction->virtual_time_reservation = 0;
+}
+
+static void node_memory_resources_reserve(
+    GHashTable *counter_rules, GHashTable *row_plans,
+    GHashTable *retention_plans)
+{
+    CrucibleMemoryTransaction *transaction = &crucible_memory_transaction;
+    GHashTableIter iter;
+    gpointer key;
+    gpointer value;
+    g_autoptr(GHashTable) demand_by_ledger = g_hash_table_new_full(
+        g_direct_hash, g_direct_equal, NULL, g_free);
+    uint64_t fixed_latency = 0;
+    uint64_t queue_delay = 0;
+    uint64_t now = node_virtual_now();
+
+    transaction->rule_reservations = g_array_new(
+        false, false, sizeof(CrucibleMemoryRuleReservation));
+    g_hash_table_iter_init(&iter, counter_rules);
+    while (g_hash_table_iter_next(&iter, &key, NULL)) {
+        QemuCrucibleFaultRule *rule = key;
+        CrucibleMemoryReservedCounters *reserved =
+            node_memory_reserved_counter(rule, true);
+        CrucibleMemoryRuleReservation reservation = {
+            .rule = rule,
+            .opportunity = true,
+            .applied = true,
+        };
+
+        g_assert(reserved->opportunities != UINT64_MAX &&
+                 reserved->applied != UINT64_MAX);
+        reserved->opportunities++;
+        reserved->applied++;
+        g_array_append_val(transaction->rule_reservations, reservation);
+    }
+
+    transaction->row_reservations = g_array_new(
+        false, false, sizeof(CrucibleMemoryRowReservation));
+    g_hash_table_iter_init(&iter, row_plans);
+    while (g_hash_table_iter_next(&iter, &key, &value)) {
+        QemuCrucibleFaultRule *rule = key;
+        CrucibleMemoryRowResourcePlan *plan = value;
+        GHashTableIter coordinate_iter;
+        gpointer coordinate_key;
+        CrucibleMemoryReservedRows *rows =
+            node_memory_reserved_row_set(rule, true);
+
+        g_hash_table_iter_init(&coordinate_iter, plan->coordinates);
+        while (g_hash_table_iter_next(
+                   &coordinate_iter, &coordinate_key, NULL)) {
+            uint64_t *count = g_hash_table_lookup(
+                rows->coordinates, coordinate_key);
+            CrucibleMemoryRowReservation reservation = {
+                .rule = rule,
+                .coordinate = *(CrucibleDramCoordinate *)coordinate_key,
+                .active = true,
+            };
+
+            if (!count) {
+                count = g_new0(uint64_t, 1);
+                g_hash_table_insert(
+                    rows->coordinates,
+                    g_memdup2(coordinate_key,
+                              sizeof(CrucibleDramCoordinate)), count);
+            }
+            g_assert(*count != UINT64_MAX);
+            (*count)++;
+            g_array_append_val(transaction->row_reservations, reservation);
+        }
+    }
+
+    transaction->retention_reservations = g_array_new(
+        false, false, sizeof(CrucibleMemoryRetentionReservation));
+    g_hash_table_iter_init(&iter, retention_plans);
+    while (g_hash_table_iter_next(&iter, &key, &value)) {
+        QemuCrucibleFaultRule *rule = key;
+        CrucibleMemoryRetentionResourcePlan *plan = value;
+        GHashTableIter offset_iter;
+        gpointer offset_key;
+        CrucibleMemoryReservedRetention *retention =
+            node_memory_reserved_retention_set(rule, true);
+
+        g_hash_table_iter_init(&offset_iter, plan->offsets);
+        while (g_hash_table_iter_next(&offset_iter, &offset_key, NULL)) {
+            uint64_t *count = g_hash_table_lookup(
+                retention->offsets, offset_key);
+            CrucibleMemoryRetentionReservation reservation = {
+                .rule = rule,
+                .offset = *(uint64_t *)offset_key,
+                .active = true,
+            };
+
+            if (!count) {
+                count = g_new0(uint64_t, 1);
+                g_hash_table_insert(
+                    retention->offsets,
+                    g_memdup2(offset_key, sizeof(uint64_t)), count);
+            }
+            g_assert(*count != UINT64_MAX);
+            (*count)++;
+            g_array_append_val(transaction->retention_reservations,
+                               reservation);
+        }
+    }
+
+    transaction->ledger_reservations = g_array_new(
+        false, false, sizeof(CrucibleMemoryLedgerReservation));
+    for (guint i = 0;
+         crucible_memory_service_plan &&
+         i < crucible_memory_service_plan->len; i++) {
+        CrucibleMemoryServicePlan *plan = &g_array_index(
+            crucible_memory_service_plan, CrucibleMemoryServicePlan, i);
+        uint64_t latency, demand;
+        uint64_t *stored;
+
+        g_assert(node_memory_service_demand_checked(
+            plan->rule, plan->bytes, &latency, &demand));
+        g_assert(fixed_latency <= UINT64_MAX - latency);
+        fixed_latency += latency;
+        stored = g_hash_table_lookup(
+            demand_by_ledger, plan->rule->service_ledger);
+        if (!stored) {
+            stored = g_new0(uint64_t, 1);
+            g_hash_table_insert(demand_by_ledger,
+                                plan->rule->service_ledger, stored);
+        }
+        *stored = MAX(*stored, demand);
+    }
+    g_hash_table_iter_init(&iter, demand_by_ledger);
+    while (g_hash_table_iter_next(&iter, &key, &value)) {
+        CrucibleMemoryServiceLedger *ledger = key;
+        uint64_t demand = *(uint64_t *)value;
+        uint64_t prior = node_memory_reserved_ledger(ledger);
+        uint64_t ready = MAX(now, ledger->ready_ns) + prior;
+        uint64_t *reserved;
+        CrucibleMemoryLedgerReservation reservation = {
+            .ledger = ledger,
+            .demand = demand,
+        };
+
+        g_assert(ready <= UINT64_MAX - demand);
+        queue_delay = MAX(queue_delay, ready + demand - now);
+        if (!crucible_memory_reserved_ledgers) {
+            crucible_memory_reserved_ledgers = g_hash_table_new_full(
+                g_direct_hash, g_direct_equal, NULL, g_free);
+        }
+        reserved = g_hash_table_lookup(
+            crucible_memory_reserved_ledgers, ledger);
+        if (!reserved) {
+            reserved = g_new0(uint64_t, 1);
+            g_hash_table_insert(crucible_memory_reserved_ledgers,
+                                ledger, reserved);
+        }
+        g_assert(*reserved <= UINT64_MAX - demand);
+        *reserved += demand;
+        g_array_append_val(transaction->ledger_reservations, reservation);
+    }
+    g_assert(fixed_latency <= UINT64_MAX - queue_delay);
+    transaction->virtual_time_reservation = fixed_latency + queue_delay;
+    g_assert(crucible_memory_reserved_virtual_time <=
+             UINT64_MAX - transaction->virtual_time_reservation);
+    crucible_memory_reserved_virtual_time +=
+        transaction->virtual_time_reservation;
+}
+
+static bool node_memory_rowhammer_resources_plan(
+    QemuCrucibleFaultRule *rule, QDict *parameters,
+    uint64_t rule_offset, size_t selected, GHashTable *plans)
+{
+    CrucibleMemoryRowResourcePlan *plan =
+        g_hash_table_lookup(plans, rule);
+    uint64_t row_bytes;
+    uint64_t current = rule_offset;
+    uint64_t remaining = selected;
+    uint64_t existing = rule->row_counters ?
+        g_hash_table_size(rule->row_counters) : 0;
+    CrucibleMemoryReservedRows *reserved_rows =
+        node_memory_reserved_row_set(rule, false);
+    uint64_t reserved_new = 0;
+
+    g_assert(existing <= CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT);
+    if (reserved_rows) {
+        GHashTableIter reserved_iter;
+        gpointer reserved_key;
+
+        g_hash_table_iter_init(&reserved_iter, reserved_rows->coordinates);
+        while (g_hash_table_iter_next(&reserved_iter, &reserved_key, NULL)) {
+            if (!rule->row_counters ||
+                !g_hash_table_contains(rule->row_counters, reserved_key)) {
+                reserved_new++;
+            }
+        }
+    }
+    g_assert(reserved_new <=
+             CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT - existing);
+    g_assert(node_json_u64(qdict_get(parameters, "row_bytes"),
+                           &row_bytes));
+    if (!plan) {
+        plan = g_new0(CrucibleMemoryRowResourcePlan, 1);
+        plan->coordinates = g_hash_table_new_full(
+            node_dram_coordinate_hash, node_dram_coordinate_equal,
+            g_free, NULL);
+        g_hash_table_insert(plans, rule, plan);
+    }
+    while (remaining != 0) {
+        uint64_t physical, available;
+        uint64_t part;
+
+        g_assert(node_rule_physical_span(rule, current, &physical,
+                                         &available));
+        part = MIN(remaining, available);
+        for (uint64_t byte = 0; byte < part; byte++) {
+            CrucibleDramCoordinate coordinate = node_dram_coordinate(
+                physical + byte, row_bytes);
+            uint64_t *counter;
+
+            if (g_hash_table_contains(plan->coordinates, &coordinate)) {
+                continue;
+            }
+            counter = rule->row_counters ?
+                g_hash_table_lookup(rule->row_counters, &coordinate) :
+                NULL;
+            uint64_t reserved = node_memory_reserved_row_count(
+                rule, &coordinate);
+
+            if (reserved == UINT64_MAX || (counter ? *counter : 0) >
+                UINT64_MAX - reserved - 1) {
+                node_memory_counter_terminal_metadata(
+                    (counter ? *counter : 0) + reserved);
+                return false;
+            }
+            if (!counter && reserved == 0) {
+                if (plan->new_counters ==
+                    CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT - existing -
+                    reserved_new) {
+                    node_memory_resource_terminal_metadata(
+                        CRUCIBLE_NODE_RESOURCE_PERSISTENT_CELLS,
+                        existing + reserved_new,
+                        plan->new_counters + 1,
+                        CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT,
+                        CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT);
+                    return false;
+                }
+                plan->new_counters++;
+            }
+            g_hash_table_add(
+                plan->coordinates,
+                g_memdup2(&coordinate, sizeof(coordinate)));
+        }
+        current += part;
+        remaining -= part;
+    }
+    return true;
+}
+
+static bool node_memory_retention_resources_plan(
+    QemuCrucibleFaultRule *rule, QDict *parameters,
+    uint32_t access_class, uint64_t rule_offset, size_t selected,
+    GHashTable *plans)
+{
+    CrucibleMemoryRetentionResourcePlan *plan =
+        g_hash_table_lookup(plans, rule);
+    CrucibleMemoryReservedRetention *reserved_retention =
+        node_memory_reserved_retention_set(rule, false);
+    uint64_t existing = rule->retention_cells ?
+        g_hash_table_size(rule->retention_cells) : 0;
+    uint64_t reserved_new = 0;
+    uint64_t interval;
+    const char *mask;
+    size_t mask_length;
+    bool write_access =
+        (access_class & (QEMU_CRUCIBLE_MEMORY_CPU_STORE |
+                         QEMU_CRUCIBLE_MEMORY_DMA_WRITE)) != 0;
+    uint64_t now = node_virtual_now();
+
+    if (reserved_retention) {
+        GHashTableIter iter;
+        gpointer offset_key;
+
+        g_hash_table_iter_init(&iter, reserved_retention->offsets);
+        while (g_hash_table_iter_next(&iter, &offset_key, NULL)) {
+            if (!rule->retention_cells ||
+                !g_hash_table_contains(rule->retention_cells, offset_key)) {
+                reserved_new++;
+            }
+        }
+    }
+    g_assert(existing <= CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT &&
+             reserved_new <=
+                CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT - existing);
+    g_assert(node_json_u64(qdict_get(parameters, "interval_nanos"),
+                           &interval));
+    mask = qdict_get_str(parameters, "decay_mask");
+    mask_length = strlen(mask) / 2;
+    if (!plan) {
+        plan = g_new0(CrucibleMemoryRetentionResourcePlan, 1);
+        plan->offsets = g_hash_table_new_full(
+            g_int64_hash, g_int64_equal, g_free, NULL);
+        g_hash_table_insert(plans, rule, plan);
+    }
+    for (size_t byte = 0; byte < selected; byte++) {
+        uint64_t offset = rule_offset + byte;
+        uint64_t reserved;
+        unsigned parsed;
+        bool creates = write_access;
+
+        if (g_hash_table_contains(plan->offsets, &offset)) {
+            continue;
+        }
+        if (!creates && rule->exposure_initialized &&
+            now >= rule->last_exposure_ns &&
+            now - rule->last_exposure_ns >= interval) {
+            g_assert(sscanf(mask + (offset % mask_length) * 2,
+                            "%2x", &parsed) == 1);
+            creates = parsed != 0;
+        }
+        if (!creates || (rule->retention_cells &&
+                         g_hash_table_contains(rule->retention_cells,
+                                               &offset))) {
+            continue;
+        }
+        reserved = node_memory_reserved_retention_count(rule, offset);
+        if (reserved == 0) {
+            if (plan->new_cells ==
+                CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT - existing -
+                reserved_new) {
+                node_memory_resource_terminal_metadata(
+                    CRUCIBLE_NODE_RESOURCE_PERSISTENT_CELLS,
+                    existing + reserved_new, plan->new_cells + 1,
+                    CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT,
+                    CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT);
+                return false;
+            }
+            plan->new_cells++;
+        }
+        g_hash_table_add(plan->offsets,
+                         g_memdup2(&offset, sizeof(offset)));
+    }
+    return true;
+}
+
+bool qemu_crucible_fault_memory_rules_active(void)
+{
+    if (crucible_memory_recursive || !crucible_node_rules ||
+        strcmp(current_accel_name(), "sim") != 0 ||
+        icount_enabled() != ICOUNT_PRECISE) {
+        return false;
+    }
+    return (crucible_memory_gpa_index && crucible_memory_gpa_index->len != 0) ||
+           (crucible_memory_gva_index && crucible_memory_gva_index->len != 0);
+}
+
+bool qemu_crucible_fault_memory_fetch_rules_active(void)
+{
+    return qemu_crucible_fault_memory_rules_active() &&
+           (crucible_memory_access_classes &
+            QEMU_CRUCIBLE_MEMORY_FETCH) != 0;
+}
+
+bool qemu_crucible_fault_memory_cpu_rules_active(void)
+{
+    return qemu_crucible_fault_memory_rules_active() &&
+           (crucible_memory_access_classes &
+            (QEMU_CRUCIBLE_MEMORY_CPU_LOAD |
+             QEMU_CRUCIBLE_MEMORY_CPU_STORE)) != 0;
+}
+
+bool qemu_crucible_fault_memory_page_table_walk_rules_active(void)
+{
+    return qemu_crucible_fault_memory_rules_active() &&
+           (crucible_memory_access_classes &
+            QEMU_CRUCIBLE_MEMORY_PAGE_TABLE_WALK) != 0;
+}
+
+bool qemu_crucible_fault_memory_page_table_walk_matches(
+    uint64_t entry_gpa, size_t length)
+{
+    uint64_t last;
+    IntervalTreeNode *node;
+
+    if (!qemu_crucible_fault_memory_page_table_walk_rules_active() ||
+        length == 0 || entry_gpa > UINT64_MAX - (length - 1)) {
+        return false;
+    }
+    last = entry_gpa + length - 1;
+    for (node = interval_tree_iter_first(
+             &crucible_memory_gpa_root, entry_gpa, last);
+         node;
+         node = interval_tree_iter_next(node, entry_gpa, last)) {
+        CrucibleMemoryIndexEntry *entry = container_of(
+            node, CrucibleMemoryIndexEntry, interval);
+        QemuCrucibleFaultRule *rule = entry->rule;
+        uint32_t classes;
+
+        if (rule->command_kind !=
+                CRUCIBLE_FAULT_COMMAND_MEMORY_ACCESS_TRANSFORM ||
+            (node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P8, &classes) &&
+             (classes & QEMU_CRUCIBLE_MEMORY_PAGE_TABLE_WALK) != 0)) {
+            return true;
+        }
+    }
+    return false;
+}
+
+bool qemu_crucible_fault_memory_dma_rules_active(bool is_write)
+{
+    uint32_t access_class = is_write ? QEMU_CRUCIBLE_MEMORY_DMA_WRITE :
+                                       QEMU_CRUCIBLE_MEMORY_DMA_READ;
+
+    return qemu_crucible_fault_memory_rules_active() &&
+           (crucible_memory_access_classes & access_class) != 0;
+}
