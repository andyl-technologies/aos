 #include "qemu/plugin.h"
 
+#ifndef CRUCIBLE_ATOMIC_DECLARE
+#define CRUCIBLE_ATOMIC_FALLBACK
+#define CRUCIBLE_ATOMIC_DECLARE
+#define CRUCIBLE_ATOMIC_LOOKUP(cpu_, addr_, oi_, retaddr_) \
+    atomic_mmu_lookup((cpu_), (addr_), (oi_), DATA_SIZE, (retaddr_))
+#define CRUCIBLE_ATOMIC_CAPTURE(haddr_) do { } while (0)
+#define CRUCIBLE_ATOMIC_FINISH(cpu_, oi_, retaddr_, returned_, wrote_) \
+    do { } while (0)
+#endif
+
 #if DATA_SIZE == 16
 # define SUFFIX     o
 # define DATA_TYPE  Int128
 # define BSWAP      bswap128
 # define SHIFT      4
+# define DATA_EQUAL(a, b) int128_eq((a), (b))
 #elif DATA_SIZE == 8
 # define SUFFIX     q
 # define DATA_TYPE  aligned_uint64_t
 # define SDATA_TYPE aligned_int64_t
 # define BSWAP      bswap64
 # define SHIFT      3
+# define DATA_EQUAL(a, b) ((a) == (b))
 #elif DATA_SIZE == 4
 # define SUFFIX     l
 # define DATA_TYPE  uint32_t
 # define SDATA_TYPE int32_t
 # define BSWAP      bswap32
 # define SHIFT      2
+# define DATA_EQUAL(a, b) ((a) == (b))
 #elif DATA_SIZE == 2
 # define SUFFIX     w
 # define DATA_TYPE  uint16_t
 # define SDATA_TYPE int16_t
 # define BSWAP      bswap16
 # define SHIFT      1
+# define DATA_EQUAL(a, b) ((a) == (b))
 #elif DATA_SIZE == 1
 # define SUFFIX     b
 # define DATA_TYPE  uint8_t
 # define SDATA_TYPE int8_t
 # define BSWAP
 # define SHIFT      0
+# define DATA_EQUAL(a, b) ((a) == (b))
 #else
 # error unsupported data size
 #endif
