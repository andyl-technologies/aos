+static bool crucible_fault_memory_value(
+    CPUState *cpu, MMULookupPageData *p,
+    enum QemuCrucibleMemoryAccessClass access_class, uint8_t *value,
+    size_t length, bool atomic, int mmu_idx, uintptr_t ra)
+{
+    uint8_t before[16];
+    QemuCrucibleMemoryAccessResult result;
+    MMUAccessType type = access_class == QEMU_CRUCIBLE_MEMORY_CPU_STORE ?
+                         MMU_DATA_STORE :
+                         (access_class == QEMU_CRUCIBLE_MEMORY_FETCH ?
+                          MMU_INST_FETCH : MMU_DATA_LOAD);
+
+    (void)mmu_idx;
+    g_assert(length <= sizeof(before));
+    memcpy(before, p->haddr, length);
+    result = qemu_crucible_fault_memory_access(
+        access_class, cpu->cpu_index, p->addr, crucible_fault_gpa(p), before,
+        value, length, atomic, qemu_crucible_fault_observed_icount());
+    if (result.access_error) {
+        CPUFaultException exception;
+        bool has_exception =
+            qemu_crucible_fault_memory_transaction_exception(&exception);
+
+        qemu_crucible_fault_memory_transaction_end();
+        if (has_exception) {
+            cpu_inject_fault_exception(cpu, &exception, ra);
+        }
+        cpu_inject_fault_access_error(cpu, p->addr, length, type, ra);
+    }
+    return result.suppress_write;
+}
