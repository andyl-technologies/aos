+static bool crucible_translator_fetch(CPUArchState *env,
+                                      DisasContextBase *db, void *dest,
+                                      vaddr pc, size_t len)
+{
+    CPUState *cpu;
+    uint8_t before[32];
+    size_t request_offset;
+    size_t offset;
+
+    if (!db->crucible_fetch_active) {
+        return true;
+    }
+    if (db->crucible_fetch_faulted) {
+        return true;
+    }
+    if (len == 0 || pc < db->crucible_fetch_start ||
+        pc - db->crucible_fetch_start > sizeof(db->crucible_fetch_bytes) ||
+        len > sizeof(db->crucible_fetch_bytes) -
+              (pc - db->crucible_fetch_start)) {
+        error_report("Crucible instruction fetch exceeds exact byte bound");
+        abort();
+    }
+    cpu = env_cpu(env);
+    request_offset = pc - db->crucible_fetch_start;
+    memcpy(before, dest, len);
+    offset = 0;
+    while (offset < len) {
+        CPUFaultTranslation translation;
+        uint64_t current = pc + offset;
+        uint64_t page_offset;
+        size_t part;
+        QemuCrucibleMemoryAccessResult result;
+
+        if (db->crucible_fetch_valid[request_offset + offset]) {
+            offset++;
+            continue;
+        }
+        if (!cpu_get_fault_translation(cpu, current, MMU_INST_FETCH,
+                                       &translation) ||
+            translation.page_size == 0) {
+            db->crucible_fetch_faulted = true;
+            return false;
+        }
+        page_offset = current % translation.page_size;
+        part = MIN(len - offset, translation.page_size - page_offset);
+        for (size_t contiguous = 1; contiguous < part; contiguous++) {
+            if (db->crucible_fetch_valid[
+                    request_offset + offset + contiguous]) {
+                part = contiguous;
+                break;
+            }
+        }
+        if (!qemu_crucible_fault_memory_fetch_transaction_extend(
+                current, translation.physical_address, part)) {
+            db->crucible_fetch_faulted = true;
+            return true;
+        }
+        memcpy(db->crucible_fetch_bytes + request_offset + offset,
+               before + offset, part);
+        result = qemu_crucible_fault_memory_access(
+            QEMU_CRUCIBLE_MEMORY_FETCH, cpu->cpu_index, current,
+            translation.physical_address, before + offset,
+            db->crucible_fetch_bytes + request_offset + offset, part, false,
+            qemu_crucible_fault_observed_icount());
+        if (result.access_error) {
+            db->crucible_fetch_faulted = true;
+            return true;
+        }
+        memset(db->crucible_fetch_valid + request_offset + offset, 1, part);
+        offset += part;
+    }
+    memcpy(dest, db->crucible_fetch_bytes + request_offset, len);
+    return true;
+}
