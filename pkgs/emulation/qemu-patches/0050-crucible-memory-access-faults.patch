+static bool node_field_value_valid(uint16_t type, const uint8_t *data,
+                                   uint32_t length)
+{
+    switch (type) {
+    case CRUCIBLE_NODE_FAULT_FIELD_TYPE_U32:
+        return length == 4;
+    case CRUCIBLE_NODE_FAULT_FIELD_TYPE_U64:
+    case CRUCIBLE_NODE_FAULT_FIELD_TYPE_I64:
+        return length == 8;
+    case CRUCIBLE_NODE_FAULT_FIELD_TYPE_BOOL:
+        return length == 1 && data[0] <= 1;
+    case CRUCIBLE_NODE_FAULT_FIELD_TYPE_RATIO:
+        return length == 16 && node_get_u64(data + 8) != 0;
+    case CRUCIBLE_NODE_FAULT_FIELD_TYPE_HASH:
+        return length == 32;
+    case CRUCIBLE_NODE_FAULT_FIELD_TYPE_BYTES:
+        return length != 0;
+    case CRUCIBLE_NODE_FAULT_FIELD_TYPE_HASH_SET:
+        if (length == 0 || length % 32 != 0 || length / 32 > 4096) {
+            return false;
+        }
+        for (uint32_t offset = 32; offset < length; offset += 32) {
+            if (memcmp(data + offset - 32, data + offset, 32) >= 0) {
+                return false;
+            }
+        }
+        return true;
+    default:
+        return false;
+    }
+}
