+static uint64_t crucible_fault_load_beN(CPUState *cpu,
+                                        MMULookupPageData *p,
+                                        uint64_t ret_be, int mmu_idx,
+                                        MMUAccessType type, MemOp mop,
+                                        uintptr_t ra)
+{
+    uint8_t value[8];
+    uint64_t fragment = ret_be;
+    uint64_t prefix = 0;
+    unsigned bits = p->size * 8;
+
+    if (!qemu_crucible_fault_memory_rules_active()) {
+        return ret_be;
+    }
+    if (p->size < sizeof(fragment)) {
+        uint64_t mask = (UINT64_C(1) << bits) - 1;
+
+        fragment &= mask;
+        prefix = ret_be >> bits;
+    }
+    for (int i = p->size - 1; i >= 0; i--) {
+        value[i] = fragment;
+        fragment >>= 8;
+    }
+    crucible_fault_memory_value(
+        cpu, p, crucible_fault_load_class(type), value, p->size,
+        (mop & MO_ATOM_MASK) != MO_ATOM_NONE, mmu_idx, ra);
+    fragment = 0;
+    for (int i = 0; i < p->size; i++) {
+        fragment = (fragment << 8) | value[i];
+    }
+    return p->size == sizeof(fragment) ? fragment :
+                                         (prefix << bits) | fragment;
+}
