+static bool node_hash_nonzero(const uint8_t hash[32])
+{
+    uint8_t aggregate = 0;
+
+    for (size_t i = 0; i < 32; i++) {
+        aggregate |= hash[i];
+    }
+    return aggregate != 0;
+}
+
+static void node_sha256(const uint8_t *data, size_t len, uint8_t out[32])
+{
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    gsize digest_len = 32;
+
+    g_checksum_update(checksum, data, len);
+    g_checksum_get_digest(checksum, out, &digest_len);
+    g_assert(digest_len == 32);
+}
+
+static void node_memory_sha256(const uint8_t *data, size_t len,
+                               uint8_t out[32])
+{
+    gsize digest_len = 32;
+
+    g_assert(crucible_memory_checksum);
+    g_checksum_reset(crucible_memory_checksum);
+    g_checksum_update(crucible_memory_checksum, data, len);
+    g_checksum_get_digest(crucible_memory_checksum, out, &digest_len);
+    g_assert(digest_len == 32);
+}
+
+static int node_rule_compare(gconstpointer left, gconstpointer right)
+{
+    const QemuCrucibleFaultRule *a = *(const void * const *)left;
+    const QemuCrucibleFaultRule *b = *(const void * const *)right;
+    int order;
+
+    order = memcmp(a->binding_hash, b->binding_hash, 32);
+    if (order) {
+        return order;
+    }
+    if (a->command_kind != b->command_kind) {
+        return a->command_kind < b->command_kind ? -1 : 1;
+    }
+    return a->generation == b->generation ? 0 :
+           (a->generation < b->generation ? -1 : 1);
+}
+
+static void node_rule_clear(QemuCrucibleFaultRule *rule)
+{
+    if (!rule) {
+        return;
+    }
+    for (size_t i = 0; i < rule->field_count; i++) {
+        qobject_unref(rule->fields[i].json);
+    }
+    g_clear_pointer(&rule->row_counts, g_array_unref);
+    g_clear_pointer(&rule->translations, g_array_unref);
+    node_memory_service_ledger_release(rule->service_ledger);
+    rule->service_ledger = NULL;
+    g_free(rule->payload);
+    rule->payload = NULL;
+    rule->payload_len = 0;
+    rule->field_count = 0;
+}
+
+static void node_rule_free(QemuCrucibleFaultRule *rule)
+{
+    if (!rule) {
+        return;
+    }
+    node_rule_clear(rule);
+    g_free(rule);
+}
+
+static QemuCrucibleFaultRule *
+node_rule_copy(const QemuCrucibleFaultRule *source)
+{
+    QemuCrucibleFaultRule *copy = g_new0(QemuCrucibleFaultRule, 1);
+
+    *copy = *source;
+    copy->payload = g_memdup2(source->payload, source->payload_len);
+    for (size_t i = 0; i < copy->field_count; i++) {
+        ptrdiff_t offset = source->fields[i].data - source->payload;
+        copy->fields[i].data = copy->payload + offset;
+        copy->fields[i].json = qobject_ref(source->fields[i].json);
+    }
+    copy->row_counts = source->row_counts ?
+        g_array_ref(source->row_counts) : NULL;
+    copy->translations = source->translations ?
+        g_array_ref(source->translations) : NULL;
+    copy->service_ledger = NULL;
+    return copy;
+}
+
+static void node_rules_ensure(void)
+{
+    if (!crucible_node_rules) {
+        crucible_node_rules = g_ptr_array_new_with_free_func(
+            (GDestroyNotify)node_rule_free);
+    }
+}
+
+static QemuCrucibleFaultRule *node_find_rule(uint16_t command_kind,
+                                             const uint8_t binding_hash[32],
+                                             guint *index_out)
+{
+    node_rules_ensure();
+    for (guint i = 0; i < crucible_node_rules->len; i++) {
+        QemuCrucibleFaultRule *rule = g_ptr_array_index(crucible_node_rules, i);
+        if (rule->command_kind == command_kind &&
+            memcmp(rule->binding_hash, binding_hash, 32) == 0) {
+            if (index_out) {
+                *index_out = i;
+            }
+            return rule;
+        }
+    }
+    return NULL;
+}
+
+static void node_rules_digest_with(const QemuCrucibleFaultRule *replacement,
+                                   bool remove, uint8_t out[32])
+{
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    g_autoptr(GPtrArray) ordered = g_ptr_array_new();
+    gsize digest_len = 32;
+    bool inserted = false;
+
+    node_rules_ensure();
+    for (guint i = 0; i < crucible_node_rules->len; i++) {
+        QemuCrucibleFaultRule *rule = g_ptr_array_index(crucible_node_rules, i);
+        if (replacement && rule->command_kind == replacement->command_kind &&
+            memcmp(rule->binding_hash, replacement->binding_hash, 32) == 0) {
+            if (!remove) {
+                g_ptr_array_add(ordered, (void *)replacement);
+                inserted = true;
+            }
+        } else {
+            g_ptr_array_add(ordered, rule);
+        }
+    }
+    if (replacement && !remove && !inserted) {
+        g_ptr_array_add(ordered, (void *)replacement);
+    }
+    g_ptr_array_sort(ordered, node_rule_compare);
+    g_checksum_update(checksum, (const guchar *)"crucible.node-rules.v1", 22);
+    for (guint i = 0; i < ordered->len; i++) {
+        QemuCrucibleFaultRule *rule = g_ptr_array_index(ordered, i);
+        g_checksum_update(checksum, rule->payload, rule->payload_len);
+        g_checksum_update(checksum, rule->binding_hash, 32);
+        g_checksum_update(checksum, (const guchar *)&rule->command_sequence,
+                          sizeof(rule->command_sequence));
+    }
+    g_checksum_get_digest(checksum, out, &digest_len);
+    g_assert(digest_len == 32);
+}
+
+typedef struct NodeJsonCursor {
+    const uint8_t *data;
+    size_t len;
+    size_t pos;
+    unsigned depth;
+} NodeJsonCursor;
+
+static bool node_json_scan_value(NodeJsonCursor *cursor);
+
+static bool node_json_scan_string(NodeJsonCursor *cursor,
+                                  const uint8_t **start, size_t *length)
+{
+    size_t begin;
+
+    if (cursor->pos >= cursor->len || cursor->data[cursor->pos++] != '"') {
+        return false;
+    }
+    begin = cursor->pos;
+    while (cursor->pos < cursor->len && cursor->data[cursor->pos] != '"') {
+        uint8_t byte = cursor->data[cursor->pos++];
+
+        /* Closed policy strings are printable unescaped ASCII. */
+        if (byte < 0x20 || byte > 0x7e || byte == '\\') {
+            return false;
+        }
+    }
+    if (cursor->pos >= cursor->len) {
+        return false;
+    }
+    if (start) {
+        *start = cursor->data + begin;
+    }
+    if (length) {
+        *length = cursor->pos - begin;
+    }
+    cursor->pos++;
+    return true;
+}
+
+static bool node_json_scan_number(NodeJsonCursor *cursor)
+{
+    size_t begin = cursor->pos;
+
+    if (cursor->data[cursor->pos] == '-') {
+        cursor->pos++;
+        if (cursor->pos >= cursor->len || cursor->data[cursor->pos] == '0') {
+            return false;
+        }
+    }
+    if (cursor->pos >= cursor->len ||
+        !g_ascii_isdigit(cursor->data[cursor->pos])) {
+        return false;
+    }
+    if (cursor->data[cursor->pos] == '0') {
+        cursor->pos++;
+        return cursor->pos == cursor->len ||
+               !g_ascii_isdigit(cursor->data[cursor->pos]);
+    }
+    while (cursor->pos < cursor->len &&
+           g_ascii_isdigit(cursor->data[cursor->pos])) {
+        cursor->pos++;
+    }
+    return cursor->pos > begin;
+}
+
+static bool node_json_scan_array(NodeJsonCursor *cursor)
+{
+    if (++cursor->depth > 64) {
+        return false;
+    }
+    cursor->pos++;
+    if (cursor->pos < cursor->len && cursor->data[cursor->pos] == ']') {
+        cursor->pos++;
+        cursor->depth--;
+        return true;
+    }
+    for (;;) {
+        if (!node_json_scan_value(cursor) || cursor->pos >= cursor->len) {
+            return false;
+        }
+        if (cursor->data[cursor->pos] == ']') {
+            cursor->pos++;
+            cursor->depth--;
+            return true;
+        }
+        if (cursor->data[cursor->pos++] != ',') {
+            return false;
+        }
+    }
+}
+
+static bool node_json_scan_object(NodeJsonCursor *cursor)
+{
+    g_autofree uint8_t *previous = NULL;
+    size_t previous_len = 0;
+
+    if (++cursor->depth > 64) {
+        return false;
+    }
+    cursor->pos++;
+    if (cursor->pos < cursor->len && cursor->data[cursor->pos] == '}') {
+        cursor->pos++;
+        cursor->depth--;
+        return true;
+    }
+    for (;;) {
+        const uint8_t *key;
+        size_t key_len;
+        size_t common;
+        int order;
+
+        if (!node_json_scan_string(cursor, &key, &key_len)) {
+            return false;
+        }
+        common = MIN(previous_len, key_len);
+        order = previous ? memcmp(previous, key, common) : -1;
+        if (previous &&
+            (order > 0 || (order == 0 && previous_len >= key_len))) {
+            return false;
+        }
+        g_free(previous);
+        previous = g_memdup2(key, key_len);
+        previous_len = key_len;
+        if (cursor->pos >= cursor->len || cursor->data[cursor->pos++] != ':' ||
+            !node_json_scan_value(cursor) || cursor->pos >= cursor->len) {
+            return false;
+        }
+        if (cursor->data[cursor->pos] == '}') {
+            cursor->pos++;
+            cursor->depth--;
+            return true;
+        }
+        if (cursor->data[cursor->pos++] != ',') {
+            return false;
+        }
+    }
+}
+
+static bool node_json_scan_value(NodeJsonCursor *cursor)
+{
+    static const char *literals[] = { "false", "null", "true" };
+
+    if (cursor->pos >= cursor->len) {
+        return false;
+    }
+    switch (cursor->data[cursor->pos]) {
+    case '{':
+        return node_json_scan_object(cursor);
+    case '[':
+        return node_json_scan_array(cursor);
+    case '"':
+        return node_json_scan_string(cursor, NULL, NULL);
+    case '-':
+    case '0' ... '9':
+        return node_json_scan_number(cursor);
+    default:
+        for (size_t i = 0; i < G_N_ELEMENTS(literals); i++) {
+            size_t length = strlen(literals[i]);
+
+            if (cursor->len - cursor->pos >= length &&
+                memcmp(cursor->data + cursor->pos, literals[i], length) == 0) {
+                cursor->pos += length;
+                return true;
+            }
+        }
+        return false;
+    }
+}
+
+static bool node_json_canonical(const uint8_t *data, size_t len)
+{
+    NodeJsonCursor cursor = { .data = data, .len = len };
+
+    return len != 0 && node_json_scan_value(&cursor) && cursor.pos == len &&
+           cursor.depth == 0;
+}
+
+static bool node_qdict_exact(const QDict *dict, const char *const *keys,
+                             size_t count)
+{
+    if (!dict || qdict_size(dict) != count) {
+        return false;
+    }
+    for (size_t i = 0; i < count; i++) {
+        if (!qdict_haskey(dict, keys[i])) {
+            return false;
+        }
+    }
+    return true;
+}
+
+#define NODE_KEYS(...) ((const char *const[]) { __VA_ARGS__ })
+#define NODE_EXACT(dict_, ...) \
+    node_qdict_exact((dict_), NODE_KEYS(__VA_ARGS__), \
+                     G_N_ELEMENTS(NODE_KEYS(__VA_ARGS__)))
+
+static bool node_json_u64(const QObject *object, uint64_t *value)
+{
+    QNum *number = qobject_to(QNum, object);
+
+    return number && number->kind != QNUM_DOUBLE &&
+           qnum_get_try_uint(number, value);
+}
+
+static bool node_json_i64(const QObject *object, int64_t *value)
+{
+    QNum *number = qobject_to(QNum, object);
+
+    return number && number->kind != QNUM_DOUBLE &&
+           qnum_get_try_int(number, value);
+}
+
+static bool node_json_u32(const QObject *object, uint32_t *value)
+{
+    uint64_t wide;
+
+    if (!node_json_u64(object, &wide) || wide > UINT32_MAX) {
+        return false;
+    }
+    *value = wide;
+    return true;
+}
+
+static bool node_json_positive(const QObject *object, uint64_t *value)
+{
+    return node_json_u64(object, value) && *value != 0;
+}
+
+static bool node_json_bool(const QObject *object, bool *value)
+{
+    QBool *boolean = qobject_to(QBool, object);
+
+    if (!boolean) {
+        return false;
+    }
+    *value = qbool_get_bool(boolean);
+    return true;
+}
+
+static const char *node_json_string(const QObject *object)
+{
+    QString *string = qobject_to(QString, object);
+
+    return string ? qstring_get_str(string) : NULL;
+}
+
+static bool node_json_null(const QObject *object)
+{
+    return qobject_to(QNull, object) != NULL;
+}
+
+static bool node_string_one_of(const QObject *object,
+                               const char *const *values, size_t count)
+{
+    const char *actual = node_json_string(object);
+
+    if (!actual) {
+        return false;
+    }
+    for (size_t i = 0; i < count; i++) {
+        if (strcmp(actual, values[i]) == 0) {
+            return true;
+        }
+    }
+    return false;
+}
+
+#define NODE_ONE_OF(object_, ...) \
+    node_string_one_of((object_), NODE_KEYS(__VA_ARGS__), \
+                       G_N_ELEMENTS(NODE_KEYS(__VA_ARGS__)))
+
+static bool node_json_object_id(const QObject *object)
+{
+    const char *value = node_json_string(object);
+    size_t length;
+
+    if (!value) {
+        return false;
+    }
+    length = strlen(value);
+    if (length == 0 || length > 96 || value[0] < 'a' || value[0] > 'z' ||
+        !((value[length - 1] >= 'a' && value[length - 1] <= 'z') ||
+          (value[length - 1] >= '0' && value[length - 1] <= '9'))) {
+        return false;
+    }
+    for (size_t i = 0; i < length; i++) {
+        if (!((value[i] >= 'a' && value[i] <= 'z') ||
+              (value[i] >= '0' && value[i] <= '9') || value[i] == '-') ||
+            (value[i] == '-' && i != 0 && value[i - 1] == '-')) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool node_json_hex(const QObject *object, size_t minimum_bytes,
+                          size_t maximum_bytes, size_t *decoded_bytes)
+{
+    const char *value = node_json_string(object);
+    size_t length;
+
+    if (!value) {
+        return false;
+    }
+    length = strlen(value);
+    if ((length & 1) != 0 || length / 2 < minimum_bytes ||
+        length / 2 > maximum_bytes) {
+        return false;
+    }
+    for (size_t i = 0; i < length; i++) {
+        if (!((value[i] >= '0' && value[i] <= '9') ||
+              (value[i] >= 'a' && value[i] <= 'f'))) {
+            return false;
+        }
+    }
+    if (decoded_bytes) {
+        *decoded_bytes = length / 2;
+    }
+    return true;
+}
+
+static bool node_json_sorted_vcpus(const QObject *object)
+{
+    QList *list = qobject_to(QList, object);
+    QListEntry *entry;
+    uint32_t previous = 0;
+    bool first = true;
+
+    if (!list || qlist_empty(list) || qlist_size(list) > 4096) {
+        return false;
+    }
+    QLIST_FOREACH_ENTRY(list, entry) {
+        uint32_t value;
+
+        if (!node_json_u32(qlist_entry_obj(entry), &value) ||
+            (!first && value <= previous)) {
+            return false;
+        }
+        previous = value;
+        first = false;
+    }
+    return true;
+}
+
+static bool node_json_ratio(const QObject *object)
+{
+    QDict *dict = qobject_to(QDict, object);
+    uint64_t numerator, denominator;
+
+    return NODE_EXACT(dict, "denominator", "numerator") &&
+           node_json_positive(qdict_get(dict, "numerator"), &numerator) &&
+           node_json_positive(qdict_get(dict, "denominator"), &denominator);
+}
+
+static bool node_json_tag(const QObject *object, const char *kind,
+                          bool parameters, QObject **value)
+{
+    QDict *dict = qobject_to(QDict, object);
+    const char *actual;
+
+    if (!(parameters ? NODE_EXACT(dict, "kind", "parameters") :
+                       NODE_EXACT(dict, "kind"))) {
+        return false;
+    }
+    actual = node_json_string(qdict_get(dict, "kind"));
+    if (!actual || strcmp(actual, kind) != 0) {
+        return false;
+    }
+    if (value) {
+        *value = parameters ? qdict_get(dict, "parameters") : NULL;
+    }
+    return true;
+}
+
+static QDict *node_json_tag_dict(const QObject *object, const char *kind)
+{
+    QObject *parameters;
+
+    if (!node_json_tag(object, kind, true, &parameters)) {
+        return NULL;
+    }
+    return qobject_to(QDict, parameters);
+}
+
+static bool node_json_occurrence(const QObject *object)
+{
+    QObject *parameters;
+    QDict *dict;
+    uint64_t first, period, count;
+
+    if (node_json_tag(object, "every", false, NULL)) {
+        return true;
+    }
+    if (!node_json_tag(object, "periodic", true, &parameters)) {
+        return false;
+    }
+    dict = qobject_to(QDict, parameters);
+    if (!dict ||
+        !NODE_EXACT(dict, "count", "first", "period") ||
+        !node_json_u64(qdict_get(dict, "first"), &first) ||
+        !node_json_positive(qdict_get(dict, "period"), &period) ||
+        !node_json_positive(qdict_get(dict, "count"), &count) ||
+        count > 4194304) {
+        return false;
+    }
+    return count - 1 <= (UINT64_MAX - first) / period;
+}
+
+static bool node_json_register_mutation(const QObject *object)
+{
+    QDict *dict;
+    size_t mask_len, value_len;
+
+    dict = node_json_tag_dict(object, "bit_flip");
+    if (dict && NODE_EXACT(dict, "mask")) {
+        return node_json_hex(qdict_get(dict, "mask"), 1, 16 * 1024 * 1024,
+                             NULL);
+    }
+    dict = node_json_tag_dict(object, "stuck");
+    if (dict && NODE_EXACT(dict, "mask", "value") &&
+        node_json_hex(qdict_get(dict, "mask"), 1, 16 * 1024 * 1024,
+                      &mask_len) &&
+        node_json_hex(qdict_get(dict, "value"), 1, 16 * 1024 * 1024,
+                      &value_len)) {
+        return mask_len == value_len;
+    }
+    dict = node_json_tag_dict(object, "replace");
+    if (dict && NODE_EXACT(dict, "value")) {
+        return node_json_hex(qdict_get(dict, "value"), 1, 16 * 1024 * 1024,
+                             NULL);
+    }
+    return false;
+}
+
+static bool node_json_exception(const QObject *object)
+{
+    QDict *dict = qobject_to(QDict, object);
+    QObject *record_parameters = NULL;
+    const char *architecture;
+    QDict *record;
+    const char *record_kind;
+    uint32_t vector;
+    uint64_t syndrome, fault_address = 0;
+    bool before, maskable;
+    bool has_fault_address;
+
+    if (!NODE_EXACT(dict, "architecture", "before_instruction",
+                    "fault_address", "maskable", "record", "syndrome",
+                    "vector")) {
+        return false;
+    }
+    architecture = node_json_string(qdict_get(dict, "architecture"));
+    if (!architecture ||
+        (strcmp(architecture, "x86_64") != 0 &&
+         strcmp(architecture, "aarch64") != 0) ||
+        !node_json_bool(qdict_get(dict, "before_instruction"), &before) ||
+        !node_json_bool(qdict_get(dict, "maskable"), &maskable) ||
+        !node_json_u64(qdict_get(dict, "syndrome"), &syndrome) ||
+        !node_json_u32(qdict_get(dict, "vector"), &vector)) {
+        return false;
+    }
+    has_fault_address = !node_json_null(qdict_get(dict, "fault_address"));
+    if (has_fault_address &&
+        !node_json_u64(qdict_get(dict, "fault_address"), &fault_address)) {
+        return false;
+    }
+    if ((strcmp(architecture, "x86_64") == 0 && vector > 255) ||
+        (strcmp(architecture, "aarch64") == 0 && vector > 1023)) {
+        return false;
+    }
+    record = qobject_to(QDict, qdict_get(dict, "record"));
+    if (!record) {
+        return false;
+    }
+    record_kind = qdict_get_try_str(record, "kind");
+    if (!record_kind) {
+        return false;
+    }
+    if (strcmp(record_kind, "architecture_default") == 0) {
+        return NODE_EXACT(record, "kind");
+    }
+    if (!node_json_tag(QOBJECT(record), record_kind, true,
+                       &record_parameters)) {
+        return false;
+    }
+    if (strcmp(record_kind, "x86_machine_check") == 0) {
+        QDict *parameters = qobject_to(QDict, record_parameters);
+        uint32_t bank;
+        uint64_t status, global_status, address = 0, misc;
+        bool corrected;
+        bool has_address, has_misc;
+
+        if (strcmp(architecture, "x86_64") != 0 || vector != 18 ||
+            !NODE_EXACT(parameters, "address", "bank", "corrected",
+                        "global_status", "misc", "status") ||
+            !node_json_u32(qdict_get(parameters, "bank"), &bank) ||
+            !node_json_u64(qdict_get(parameters, "status"), &status) ||
+            status == 0 ||
+            !node_json_u64(qdict_get(parameters, "global_status"),
+                           &global_status) ||
+            !node_json_bool(qdict_get(parameters, "corrected"), &corrected)) {
+            return false;
+        }
+        has_address = !node_json_null(qdict_get(parameters, "address"));
+        has_misc = !node_json_null(qdict_get(parameters, "misc"));
+        return (!has_address ||
+                node_json_u64(qdict_get(parameters, "address"), &address)) &&
+               (!has_misc ||
+                node_json_u64(qdict_get(parameters, "misc"), &misc)) &&
+               has_address == has_fault_address &&
+               (!has_address || address == fault_address);
+    }
+    if (strcmp(record_kind, "aarch64_ras") == 0) {
+        QDict *parameters = qobject_to(QDict, record_parameters);
+        uint64_t esr, far = 0, disr;
+        bool asynchronous, corrected;
+        bool has_far, has_disr;
+
+        if (strcmp(architecture, "aarch64") != 0 ||
+            !NODE_EXACT(parameters, "asynchronous", "corrected", "disr",
+                        "esr", "far") ||
+            !node_json_u64(qdict_get(parameters, "esr"), &esr) ||
+            esr != syndrome ||
+            !node_json_bool(qdict_get(parameters, "asynchronous"),
+                            &asynchronous) ||
+            !node_json_bool(qdict_get(parameters, "corrected"), &corrected)) {
+            return false;
+        }
+        has_far = !node_json_null(qdict_get(parameters, "far"));
+        has_disr = !node_json_null(qdict_get(parameters, "disr"));
+        return (!has_far ||
+                node_json_u64(qdict_get(parameters, "far"), &far)) &&
+               (!has_disr ||
+                node_json_u64(qdict_get(parameters, "disr"), &disr)) &&
+               has_far == has_fault_address &&
+               (!has_far || far == fault_address) &&
+               (!asynchronous || has_disr);
+    }
+    return false;
+}
+
+static bool node_json_poison(const QObject *object)
+{
+    QDict *dict;
+    uint32_t vector;
+
+    if (node_json_tag(object, "access_error", false, NULL)) {
+        return true;
+    }
+    dict = node_json_tag_dict(object, "corrected");
+    if (dict && NODE_EXACT(dict, "vector", "xor_mask") &&
+        node_json_u32(qdict_get(dict, "vector"), &vector) &&
+        node_json_hex(qdict_get(dict, "xor_mask"), 1, 16 * 1024 * 1024,
+                      NULL)) {
+        return true;
+    }
+    dict = node_json_tag_dict(object, "exception");
+    return dict && NODE_EXACT(dict, "exception") &&
+           node_json_exception(qdict_get(dict, "exception"));
+}
