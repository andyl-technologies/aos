+static void test_poll_events(void)
+{
+    struct qemu_plugin_crucible_fault_event event;
+    size_t length;
+    int status;
+
+    while ((status = qemu_plugin_crucible_fault_event_poll(
+                &event, test_evidence, sizeof(test_evidence), &length)) == 1) {
+        uint64_t access_address = test_get_u64(test_evidence + 24);
+        uint64_t access_length = test_get_u64(test_evidence + 32);
+        uint64_t rule_length = strcmp(test_scenario, "rowhammer") == 0 ?
+                               0x3000 : test_length;
+
+        if (event.command_kind != test_command_kind ||
+            event.generation != 1 || access_length == 0 ||
+            access_length > 4096 ||
+            memcmp(test_evidence, "CRUCMEM1", 8) != 0 ||
+            ((test_get_u32(test_evidence + 8) & test_classes) == 0 &&
+             !(strcmp(test_scenario, "retention") == 0 &&
+               test_get_u32(test_evidence + 8) ==
+                   TEST_MEMORY_BOUNDARY_CLASS)) ||
+            test_get_u64(test_evidence + 48) == 0) {
+            g_printerr("event kind=%u generation=%" PRIu64
+                       " class=%u access=%" PRIx64 "+%" PRIu64
+                       " payload=%zu\n",
+                       event.command_kind, event.generation,
+                       test_get_u32(test_evidence + 8), access_address,
+                       access_length, length);
+            test_fail("occurrence evidence is incomplete");
+        }
+        if (test_command_kind == CRUCIBLE_FAULT_COMMAND_MEMORY_SERVICE) {
+            if (strcmp(test_scenario, "fetch-service") == 0 &&
+                test_event_seen) {
+                test_fail("fetch service was committed more than once");
+            }
+            if (length != 576 || memcmp(test_evidence + 368, "CRUCSVC1", 8) ||
+                test_get_u32(test_evidence + 376) != 1 ||
+                test_get_u64(test_evidence + 400) <
+                    test_get_u64(test_evidence + 392) ||
+                test_get_u64(test_evidence + 408) != 1000 ||
+                test_get_u64(test_evidence + 416) == 0 ||
+                test_get_u64(test_evidence + 432) == 0 ||
+                test_get_u64(test_evidence + 440) != 1000 ||
+                test_get_u64(test_evidence + 448) != 1000000000 ||
+                test_get_u64(test_evidence + 456) != 1000000 ||
+                test_get_u32(test_evidence + 464) != 3 ||
+                test_get_u32(test_evidence + 468) !=
+                    CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED) {
+                g_printerr(
+                    "service length=%zu version=%u ready=%" PRIu64
+                    "/%" PRIu64 " fixed=%" PRIu64 " demand=%" PRIu64
+                    " queue=%" PRIu64 " completion=%" PRIu64
+                    " configured=%" PRIu64 "/%" PRIu64 "/%" PRIu64
+                    " flags=%u outcome=%u\n",
+                    length, test_get_u32(test_evidence + 376),
+                    test_get_u64(test_evidence + 392),
+                    test_get_u64(test_evidence + 400),
+                    test_get_u64(test_evidence + 408),
+                    test_get_u64(test_evidence + 416),
+                    test_get_u64(test_evidence + 424),
+                    test_get_u64(test_evidence + 432),
+                    test_get_u64(test_evidence + 440),
+                    test_get_u64(test_evidence + 448),
+                    test_get_u64(test_evidence + 456),
+                    test_get_u32(test_evidence + 464),
+                    test_get_u32(test_evidence + 468));
+                test_fail("service evidence is incomplete");
+            }
+            if (test_is_page_table_walk_scenario() &&
+                (test_get_u64(test_evidence + 16) !=
+                     test_get_u64(test_evidence + 224) ||
+                 test_get_u32(test_evidence + 232) !=
+                     (test_address == 0x10d000 ? 1 : 3) ||
+                 test_get_u32(test_evidence + 236) != 1 ||
+                 test_get_u32(test_evidence + 240) != 2)) {
+                test_fail("service evidence lacks page-table identity");
+            }
+        } else {
+            uint64_t transaction_address = test_get_u64(test_evidence + 264);
+            uint64_t transaction_length = test_get_u64(test_evidence + 272);
+            uint32_t event_offset = test_get_u32(test_evidence + 60);
+            uint32_t event_length = test_get_u32(test_evidence + 108);
+            uint32_t state_flags = test_get_u32(test_evidence + 104);
+            uint16_t outcome = test_get_u16(test_evidence + 306);
+            uint64_t selected_address;
+            bool retention_boundary =
+                strcmp(test_scenario, "retention") == 0 &&
+                test_get_u32(test_evidence + 8) ==
+                    TEST_MEMORY_BOUNDARY_CLASS;
+            bool page_table_walk = test_is_page_table_walk_scenario();
+
+            if (test_retry_scenario) {
+                uint32_t retry_ordinal =
+                    test_get_u32(test_evidence + 260);
+                uint32_t has_instruction =
+                    test_get_u32(test_evidence + 300);
+
+                test_retry_event_count++;
+                if (has_instruction != 1 ||
+                    test_get_u64(test_evidence + 288) == 0) {
+                    test_fail("retry evidence lacks instruction identity");
+                }
+                if (page_table_walk &&
+                    (test_get_u32(test_evidence + 8) !=
+                         TEST_MEMORY_PAGE_TABLE_WALK_CLASS ||
+                     test_get_u64(test_evidence + 16) !=
+                         test_get_u64(test_evidence + 224) ||
+                     test_get_u32(test_evidence + 236) != 1 ||
+                     test_get_u32(test_evidence + 240) != 2)) {
+                    test_fail("page-table retry evidence lacks walk identity");
+                }
+                if (outcome == CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR &&
+                    test_get_u32(test_evidence + 308) == 5 &&
+                    retry_ordinal == 0 && !test_retry_poison_seen) {
+                    test_retry_poison_seen = true;
+                    test_retry_poison_icount =
+                        test_get_u64(test_evidence + 280);
+                } else if (outcome ==
+                               CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED &&
+                           test_get_u32(test_evidence + 308) == 1 &&
+                           retry_ordinal == 1 &&
+                           test_get_u64(test_evidence + 280) >
+                               test_retry_poison_icount &&
+                           test_retry_poison_seen &&
+                           !test_retry_applied_seen) {
+                    test_retry_applied_seen = true;
+                } else {
+                    test_fail("retry evidence has an unexpected ordinal");
+                }
+                test_event_seen = true;
+                continue;
+            }
+
+            if ((state_flags & 2U) != 0) {
+                if (event_offset != 0 || event_length != 0 ||
+                    outcome != CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR) {
+                    test_fail("stale-translation evidence is incomplete");
+                }
+                continue;
+            }
+
+            if (retention_boundary) {
+                if (test_retention_boundary_seen ||
+                    event.observed_icount != test_install_icount + 1 ||
+                    outcome != CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED) {
+                    g_printerr(
+                        "retention boundary duplicate=%u install=%" PRIu64
+                        " event=%" PRIu64 " outcome=%u\n",
+                        test_retention_boundary_seen, test_install_icount,
+                        event.observed_icount, outcome);
+                    test_fail(
+                        "retention did not decay at its exact virtual deadline");
+                }
+                test_retention_boundary_seen = true;
+            }
+
+            if (page_table_walk &&
+                (test_get_u32(test_evidence + 8) !=
+                     TEST_MEMORY_PAGE_TABLE_WALK_CLASS ||
+                 test_get_u64(test_evidence + 16) !=
+                     test_get_u64(test_evidence + 224) ||
+                 test_get_u32(test_evidence + 236) !=
+                     (strcmp(test_scenario,
+                             "page-table-walk-nested-stage2") == 0 ? 2 : 1) ||
+                 test_get_u32(test_evidence + 240) != 2 ||
+                 (test_is_nested_page_table_walk_scenario() &&
+                  (test_get_u64(test_evidence + 224) != 0x400000 ||
+                   test_get_u32(test_evidence + 232) != 1)) ||
+                 ((!test_is_nested_page_table_walk_scenario() &&
+                   test_address == 0x10d000) &&
+                   (test_get_u64(test_evidence + 224) != 0x400000 ||
+                    test_get_u32(test_evidence + 232) != 1)) ||
+                 ((!test_is_nested_page_table_walk_scenario() &&
+                   test_address != 0x10d000) &&
+                   (test_get_u64(test_evidence + 224) != 0x40600000 ||
+                    test_get_u32(test_evidence + 232) != 3)))) {
+                test_fail("page-table walk evidence is incomplete");
+            }
+
+            if (strcmp(test_scenario, "rowhammer") == 0 &&
+                (test_get_u64(test_evidence + 176) == 0 ||
+                 test_get_u64(test_evidence + 184) == 0 ||
+                 test_get_u64(test_evidence + 344) == 0)) {
+                g_printerr(
+                    "rowhammer evidence mutations=%" PRIu64
+                    " bytes=%" PRIu64 " victims=%" PRIu64
+                    " access=%" PRIx64 "+%" PRIu64 "\n",
+                    test_get_u64(test_evidence + 176),
+                    test_get_u64(test_evidence + 184),
+                    test_get_u64(test_evidence + 344),
+                    access_address, access_length);
+                test_fail("rowhammer did not mutate a victim row");
+            }
+
+            if (length < 480 || test_get_u32(test_evidence + 56) == 0 ||
+                (!retention_boundary && transaction_length == 0) ||
+                test_get_u16(test_evidence + 304) != test_command_kind ||
+                test_get_u32(test_evidence + 308) != test_kind ||
+                event_length == 0 || event_length > access_length ||
+                event_offset > access_length - event_length ||
+                access_address > UINT64_MAX - event_offset ||
+                ((strcmp(test_scenario, "poison-corrected") == 0 ||
+                  g_str_has_prefix(test_scenario,
+                                    "fetch-poison-corrected-")) &&
+                 outcome != CRUCIBLE_FAULT_EVENT_OUTCOME_CORRECTED) ||
+                ((strcmp(test_scenario, "poison-access-error") == 0 ||
+                  g_str_has_prefix(test_scenario, "poison-exception-") ||
+                 strcmp(test_scenario, "failed-region") == 0) &&
+                 outcome != CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR)) {
+                g_printerr(
+                    "memory evidence scenario=%s payload=%zu matches=%u "
+                    "transaction=%" PRIx64 "+%" PRIu64
+                    " command=%u/%u kind=%u/%u event=%u+%u "
+                    "access=%" PRIx64 "+%" PRIu64 " outcome=%u\n",
+                    test_scenario, length,
+                    test_get_u32(test_evidence + 56), transaction_address,
+                    transaction_length, test_get_u16(test_evidence + 304),
+                    test_command_kind, test_get_u32(test_evidence + 308),
+                    test_kind, event_offset, event_length, access_address,
+                    access_length, outcome);
+                test_fail("memory evidence is incomplete");
+            }
+            selected_address = access_address + event_offset;
+            if (selected_address < test_address ||
+                selected_address - test_address > rule_length - event_length ||
+                (!retention_boundary &&
+                 (transaction_address > selected_address ||
+                  selected_address - transaction_address >=
+                      transaction_length))) {
+                test_fail("occurrence evidence selected the wrong byte range");
+            }
+            if (test_require_full_coverage) {
+                for (size_t byte = 0; byte < event_length; byte++) {
+                    test_coverage |=
+                        1U << (selected_address - test_address + byte);
+                }
+            }
+        }
+        test_event_seen = true;
+    }
+    if (status < 0) {
+        test_fail("occurrence evidence could not be polled losslessly");
+    }
+}
