+static bool node_rule_memory_range(QemuCrucibleFaultRule *rule,
+                                   uint64_t *start, uint64_t *length)
+{
+    uint16_t start_tag = CRUCIBLE_NODE_FAULT_FIELD_T2;
+    uint16_t length_tag = CRUCIBLE_NODE_FAULT_FIELD_T5;
+
+    if (rule->command_kind == CRUCIBLE_FAULT_COMMAND_MEMORY_ACCESS_TRANSFORM ||
+        rule->command_kind == CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE) {
+        start_tag = CRUCIBLE_NODE_FAULT_FIELD_P1;
+        length_tag = CRUCIBLE_NODE_FAULT_FIELD_P2;
+    }
+    return node_field_u64(rule, start_tag, start) &&
+           node_field_u64(rule, length_tag, length);
+}
