+static void test_fault_completion(void *opaque)
+{
+    struct qemu_plugin_crucible_fault_result result;
+    uint8_t evidence[CRUCIBLE_NODE_FAULT_EVIDENCE_V1_BYTES];
+    size_t length;
+    int status;
+
+    (void)opaque;
+    test_poll_events();
+    while ((status = qemu_plugin_crucible_fault_poll(
+                &result, evidence, sizeof(evidence), &length)) == 1) {
+        if (test_expected_rejection != 0) {
+            if (result.status != test_expected_rejection || length != 0 ||
+                memcmp(result.before_hash, result.after_hash, 32) != 0) {
+                g_printerr(
+                    "rejection scenario=%s status=%u expected=%u "
+                    "evidence=%zu state_changed=%u\n",
+                    test_scenario, result.status, test_expected_rejection,
+                    length,
+                    memcmp(result.before_hash, result.after_hash, 32) != 0);
+                test_fail("invalid memory rule was not rejected atomically");
+            }
+            test_poll_events();
+            if (test_event_seen) {
+                test_fail("rejected memory rule emitted an occurrence");
+            }
+            test_complete = true;
+            g_printerr("CRUCIBLE_MEMORY_REJECTION_LIVE_PASS\n");
+            qemu_plugin_request_shutdown(0);
+            continue;
+        }
+        if ((test_rule_stage & 1U) == 0) {
+            if (result.status != CRUCIBLE_FAULT_STATUS_PREPARED ||
+                length != sizeof(evidence)) {
+                test_fail("rule preparation did not return canonical evidence");
+            }
+            memcpy(test_command.expected_precondition_hash,
+                   result.before_hash, 32);
+            test_command.command_flags = 0;
+            test_command.command_sequence = test_rule_stage + 2;
+            test_command.target_icount = result.observed_icount;
+            test_command.authorization_ceiling_icount = result.observed_icount;
+            test_prepared = true;
+            test_rule_stage++;
+            if (qemu_plugin_crucible_fault_submit(
+                    &test_command, test_payload->data,
+                    test_payload->len) != 0) {
+                test_fail("rule commit could not be submitted");
+            }
+            qemu_plugin_force_vcpu_exit();
+        } else {
+            const uint8_t ready = 0x7f;
+
+            if (result.status != CRUCIBLE_FAULT_STATUS_APPLIED ||
+                length != sizeof(evidence)) {
+                test_fail("rule commit was not applied");
+            }
+            if (test_retry_scenario && test_rule_stage == 1) {
+                const uint8_t cpu_mask = 0xff;
+                const uint8_t cpu_replacement = 0xa5;
+                const uint8_t walk_mask[8] = { 0, 2 };
+                const uint8_t walk_replacement[8] = { 0, 2 };
+
+                test_rule_stage = 2;
+                g_byte_array_unref(test_payload);
+                test_kind = 1;
+                if (test_is_page_table_walk_scenario()) {
+                    test_build_rule(
+                        1, TEST_MEMORY_PAGE_TABLE_WALK_CLASS,
+                        walk_mask, sizeof(walk_mask), true,
+                        walk_replacement, sizeof(walk_replacement), false);
+                } else {
+                    test_build_rule(1, 2, &cpu_mask, 1, true,
+                                    &cpu_replacement, 1, false);
+                }
+                test_command.command_flags =
+                    CRUCIBLE_FAULT_COMMAND_FLAG_PREPARE_ONLY;
+                test_command.command_sequence = 3;
+                test_command.target_icount = result.observed_icount;
+                test_command.authorization_ceiling_icount =
+                    result.observed_icount;
+                memset(test_command.expected_precondition_hash, 0, 32);
+                memset(test_command.binding_hash, 0x41, 32);
+                if (qemu_plugin_crucible_fault_submit(
+                        &test_command, test_payload->data,
+                        test_payload->len) != 0) {
+                    test_fail(
+                        "retry observer preparation could not be submitted");
+                }
+                qemu_plugin_force_vcpu_exit();
+                continue;
+            }
+            test_rule_stage++;
+            test_installed = true;
+            test_install_icount = result.observed_icount;
+            if (test_is_page_table_walk_scenario() &&
+                !test_is_nested_page_table_walk_scenario()) {
+                g_autoptr(GByteArray) inspected = g_byte_array_new();
+                uint64_t alias = test_address == 0x10d000 ?
+                    UINT64_C(0x400000) : UINT64_C(0x40600000);
+
+                if (!qemu_plugin_read_memory_vaddr(alias, inspected, 1) ||
+                    inspected->len != 1 || inspected->data[0] != 0x5a) {
+                    test_fail("inspection translation could not read alias");
+                }
+                test_poll_events();
+                if (test_event_seen) {
+                    test_fail("inspection translation consumed a walk rule");
+                }
+            }
+            if (!qemu_plugin_crucible_write_memory_vaddr(
+                    test_result_address, &ready, sizeof(ready))) {
+                test_fail(
+                    "guest installation acknowledgement could not be written");
+            }
+        }
+    }
+    if (status < 0) {
+        test_fail("rule result could not be polled losslessly");
+    }
+}
