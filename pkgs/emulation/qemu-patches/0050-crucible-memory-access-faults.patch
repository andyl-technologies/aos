+static void node_memory_service_ledger_free(gpointer opaque)
+{
+    CrucibleMemoryServiceLedger *ledger = opaque;
+
+    g_free(ledger->key);
+    g_free(ledger);
+}
+
+static void node_memory_service_ledger_release(
+    CrucibleMemoryServiceLedger *ledger)
+{
+    if (!ledger) {
+        return;
+    }
+    g_assert(ledger->references != 0);
+    if (--ledger->references == 0) {
+        g_assert(crucible_memory_service_ledgers);
+        g_assert(g_hash_table_remove(crucible_memory_service_ledgers,
+                                   ledger->key));
+    }
+}
+
+static char *node_memory_service_ledger_key(QemuCrucibleFaultRule *rule)
+{
+    CrucibleNodeField *field = node_field(
+        rule, CRUCIBLE_NODE_FAULT_FIELD_P6);
+    QDict *scope;
+    const char *kind;
+    uint64_t start, length;
+    uint32_t vcpu;
+    bool has_vcpu;
+
+    if (!field || !node_rule_memory_range(rule, &start, &length) ||
+        !node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_T3, &has_vcpu) ||
+        !node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_T4, &vcpu)) {
+        return NULL;
+    }
+    scope = qobject_to(QDict, field->json);
+    kind = scope ? qdict_get_try_str(scope, "kind") : NULL;
+    if (!kind) {
+        return NULL;
+    }
+    if (strcmp(kind, "node") == 0) {
+        return g_strdup("node");
+    }
+    if (strcmp(kind, "range") == 0) {
+        return g_strdup_printf("range:%u:%u:%016" PRIx64 ":%016" PRIx64,
+                               has_vcpu, vcpu, start, length);
+    }
+    if (strcmp(kind, "controller") == 0) {
+        const char *controller = qdict_get_try_str(scope, "parameters");
+
+        return controller ? g_strdup_printf("controller:%s", controller) :
+                            NULL;
+    }
+    return NULL;
+}
+
+static bool node_memory_service_ledger_acquire(QemuCrucibleFaultRule *rule)
+{
+    g_autofree char *key = NULL;
+    CrucibleMemoryServiceLedger *ledger;
+
+    if (rule->command_kind != CRUCIBLE_FAULT_COMMAND_MEMORY_SERVICE) {
+        return true;
+    }
+    key = node_memory_service_ledger_key(rule);
+    if (!key) {
+        return false;
+    }
+    if (!crucible_memory_service_ledgers) {
+        crucible_memory_service_ledgers = g_hash_table_new_full(
+            g_str_hash, g_str_equal, NULL, node_memory_service_ledger_free);
+    }
+    ledger = g_hash_table_lookup(crucible_memory_service_ledgers, key);
+    if (!ledger) {
+        ledger = g_new0(CrucibleMemoryServiceLedger, 1);
+        ledger->key = g_steal_pointer(&key);
+        g_hash_table_insert(crucible_memory_service_ledgers,
+                            ledger->key, ledger);
+    }
+    g_assert(ledger->references != UINT32_MAX);
+    ledger->references++;
+    rule->service_ledger = ledger;
+    return true;
+}
+
+static bool node_memory_rule_admissible(QemuCrucibleFaultRule *rule)
+{
+    uint64_t start, length, end;
+    uint32_t target_vcpu;
+    bool has_vcpu;
+    size_t memory_rules = 1;
+    size_t overlaps = 1;
+
+    if (!node_rule_memory_range(rule, &start, &length) ||
+        start > UINT64_MAX - length ||
+        !node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_T3, &has_vcpu) ||
+        !node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_T4, &target_vcpu)) {
+        return false;
+    }
+    end = start + length;
+    for (guint i = 0; i < crucible_node_rules->len; i++) {
+        QemuCrucibleFaultRule *other =
+            g_ptr_array_index(crucible_node_rules, i);
+        uint64_t other_start, other_length, other_end;
+        uint32_t other_vcpu;
+        bool other_has_vcpu;
+
+        if (other->command_kind !=
+                CRUCIBLE_FAULT_COMMAND_MEMORY_ACCESS_TRANSFORM &&
+            other->command_kind != CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE &&
+            other->command_kind != CRUCIBLE_FAULT_COMMAND_MEMORY_SERVICE) {
+            continue;
+        }
+        if (other->command_kind == rule->command_kind &&
+            memcmp(other->binding_hash, rule->binding_hash, 32) == 0) {
+            continue;
+        }
+        if (++memory_rules > CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT) {
+            return false;
+        }
+        if (!node_rule_memory_range(other, &other_start, &other_length) ||
+            other_start > UINT64_MAX - other_length ||
+            !node_field_bool(other, CRUCIBLE_NODE_FAULT_FIELD_T3,
+                             &other_has_vcpu) ||
+            !node_field_u32(other, CRUCIBLE_NODE_FAULT_FIELD_T4, &other_vcpu) ||
+            has_vcpu != other_has_vcpu ||
+            (has_vcpu && target_vcpu != other_vcpu)) {
+            continue;
+        }
+        other_end = other_start + other_length;
+        if (start < other_end && other_start < end &&
+            ++overlaps > CRUCIBLE_NODE_MEMORY_MATCH_LIMIT) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static void node_memory_index_finalize(GArray *index, IntervalTreeRoot *root)
+{
+    memset(root, 0, sizeof(*root));
+    for (guint i = 0; i < index->len; i++) {
+        CrucibleMemoryIndexEntry *entry = &g_array_index(
+            index, CrucibleMemoryIndexEntry, i);
+
+        interval_tree_insert(&entry->interval, root);
+    }
+}
+
+static void node_memory_index_rebuild(void)
+{
+    memset(&crucible_memory_gpa_root, 0, sizeof(crucible_memory_gpa_root));
+    memset(&crucible_memory_gva_root, 0, sizeof(crucible_memory_gva_root));
+    g_clear_pointer(&crucible_memory_gpa_index, g_array_unref);
+    g_clear_pointer(&crucible_memory_gva_index, g_array_unref);
+    g_clear_pointer(&crucible_memory_binding_order, g_ptr_array_unref);
+    crucible_memory_gpa_index = g_array_new(
+        false, false, sizeof(CrucibleMemoryIndexEntry));
+    crucible_memory_gva_index = g_array_new(
+        false, false, sizeof(CrucibleMemoryIndexEntry));
+    crucible_memory_binding_order = g_ptr_array_new();
+    if (!crucible_memory_checksum) {
+        crucible_memory_checksum = g_checksum_new(G_CHECKSUM_SHA256);
+        if (!crucible_memory_checksum) {
+            error_report("Crucible memory evidence digest is unavailable");
+            abort();
+        }
+    }
+    for (guint i = 0; i < crucible_node_rules->len; i++) {
+        QemuCrucibleFaultRule *rule = g_ptr_array_index(crucible_node_rules, i);
+        CrucibleMemoryIndexEntry entry = { .rule = rule };
+        uint64_t length;
+        bool has_vcpu;
+
+        if ((rule->command_kind !=
+                 CRUCIBLE_FAULT_COMMAND_MEMORY_ACCESS_TRANSFORM &&
+             rule->command_kind != CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE &&
+             rule->command_kind != CRUCIBLE_FAULT_COMMAND_MEMORY_SERVICE) ||
+            !node_rule_memory_range(rule, &entry.interval.start, &length) ||
+            entry.interval.start > UINT64_MAX - length ||
+            !node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_T3, &has_vcpu)) {
+            continue;
+        }
+        entry.interval.last = entry.interval.start + length - 1;
+        if (crucible_memory_binding_order->len ==
+            CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT) {
+            error_report("Crucible memory rule index exceeds resource bound");
+            abort();
+        }
+        entry.rank = crucible_memory_binding_order->len;
+        g_ptr_array_add(crucible_memory_binding_order, rule);
+        g_array_append_val(has_vcpu ? crucible_memory_gva_index :
+                                      crucible_memory_gpa_index,
+                           entry);
+    }
+    node_memory_index_finalize(crucible_memory_gpa_index,
+                               &crucible_memory_gpa_root);
+    node_memory_index_finalize(crucible_memory_gva_index,
+                               &crucible_memory_gva_root);
+}
+
+static void node_memory_match_mark(uint32_t rank)
+{
+    uint32_t word = rank / 64;
+    uint32_t word_bit = rank % 64;
+    uint32_t group = word / 64;
+    uint32_t group_bit = word % 64;
+    uint32_t top = group / 64;
+    uint32_t top_bit = group % 64;
+
+    if (crucible_memory_match_bits[word] == 0) {
+        if (crucible_memory_match_words[group] == 0) {
+            crucible_memory_match_groups[top] |= UINT64_C(1) << top_bit;
+        }
+        crucible_memory_match_words[group] |= UINT64_C(1) << group_bit;
+    }
+    crucible_memory_match_bits[word] |= UINT64_C(1) << word_bit;
+}
+
+static void node_memory_index_collect(IntervalTreeRoot *root,
+                                      uint64_t address, size_t length)
+{
+    uint64_t last = address + length - 1;
+    IntervalTreeNode *node;
+
+    for (node = interval_tree_iter_first(root, address, last);
+         node;
+         node = interval_tree_iter_next(node, address, last)) {
+        CrucibleMemoryIndexEntry *entry = container_of(
+            node, CrucibleMemoryIndexEntry, interval);
+
+        node_memory_match_mark(entry->rank);
+    }
+}
+
+static size_t node_memory_matches_materialize(void)
+{
+    size_t count = 0;
+    gsize digest_len = sizeof(crucible_memory_current_match_hash);
+
+    for (size_t top = 0; top < G_N_ELEMENTS(crucible_memory_match_groups);
+         top++) {
+        uint64_t groups = crucible_memory_match_groups[top];
+
+        while (groups != 0) {
+            unsigned group_bit = ctz64(groups);
+            size_t group = top * 64 + group_bit;
+            uint64_t words = crucible_memory_match_words[group];
+
+            while (words != 0) {
+                unsigned word_bit = ctz64(words);
+                size_t word = group * 64 + word_bit;
+                uint64_t matches = crucible_memory_match_bits[word];
+
+                while (matches != 0) {
+                    unsigned match_bit = ctz64(matches);
+                    size_t rank = word * 64 + match_bit;
+
+                    if (count == CRUCIBLE_NODE_MEMORY_MATCH_LIMIT) {
+                        error_report(
+                            "Crucible memory match bound was violated");
+                        abort();
+                    }
+                    crucible_memory_matches[count++] = g_ptr_array_index(
+                        crucible_memory_binding_order, rank);
+                    matches &= matches - 1;
+                }
+                crucible_memory_match_bits[word] = 0;
+                words &= words - 1;
+            }
+            crucible_memory_match_words[group] = 0;
+            groups &= groups - 1;
+        }
+        crucible_memory_match_groups[top] = 0;
+    }
+    g_checksum_reset(crucible_memory_checksum);
+    for (size_t i = 0; i < count; i++) {
+        QemuCrucibleFaultRule *rule = crucible_memory_matches[i];
+        uint8_t generation[8];
+
+        g_checksum_update(crucible_memory_checksum, rule->binding_hash,
+                          sizeof(rule->binding_hash));
+        stq_le_p(generation, rule->generation);
+        g_checksum_update(crucible_memory_checksum, generation,
+                          sizeof(generation));
+    }
+    g_checksum_get_digest(crucible_memory_checksum,
+                          crucible_memory_current_match_hash, &digest_len);
+    g_assert(digest_len == sizeof(crucible_memory_current_match_hash));
+    crucible_memory_current_match_count = count;
+    return count;
+}
+
+static size_t node_memory_matching_rules_at(uint64_t vaddr, uint64_t gpa,
+                                            size_t length, bool include_gva,
+                                            uint64_t access_sequence)
+{
+    if (crucible_memory_matches_in_use) {
+        error_report(
+            "Concurrent Crucible memory opportunity is not deterministic");
+        abort();
+    }
+    crucible_memory_matches_in_use = true;
+    crucible_memory_current_access = access_sequence;
+    if (!crucible_memory_gpa_index || gpa > UINT64_MAX - length ||
+        vaddr > UINT64_MAX - length) {
+        return 0;
+    }
+    node_memory_index_collect(&crucible_memory_gpa_root, gpa, length);
+    if (include_gva) {
+        node_memory_index_collect(&crucible_memory_gva_root, vaddr, length);
+    }
+    return node_memory_matches_materialize();
+}
+
+static size_t node_memory_matching_rules(uint64_t vaddr, uint64_t gpa,
+                                         size_t length, bool include_gva)
+{
+    uint64_t identity;
+
+    if (crucible_memory_transaction.active) {
+        identity = crucible_memory_transaction.identity;
+        if (crucible_memory_transaction.fragment_ordinal == UINT32_MAX) {
+            error_report("Crucible memory fragment ordinal overflow");
+            abort();
+        }
+        crucible_memory_current_fragment =
+            crucible_memory_transaction.fragment_ordinal;
+        crucible_memory_transaction.fragment_ordinal++;
+    } else {
+        if (crucible_memory_access_sequence == UINT64_MAX) {
+            error_report("Crucible memory access sequence overflow");
+            abort();
+        }
+        identity = ++crucible_memory_access_sequence;
+    }
+    return node_memory_matching_rules_at(
+        vaddr, gpa, length, include_gva, identity);
+}
+
+static void node_memory_matching_rules_done(void)
+{
+    g_assert(crucible_memory_matches_in_use);
+    crucible_memory_current_access = 0;
+    crucible_memory_current_match_count = 0;
+    memset(crucible_memory_current_match_hash, 0,
+           sizeof(crucible_memory_current_match_hash));
+    crucible_memory_current_event_offset = 0;
+    crucible_memory_current_event_length = 0;
+    crucible_memory_current_fragment = 0;
+    crucible_memory_matches_in_use = false;
+}
+
+static void node_memory_event_span(size_t offset, size_t length)
+{
+    if (offset > UINT32_MAX || length > UINT32_MAX) {
+        error_report("Crucible memory evidence span overflow");
+        abort();
+    }
+    crucible_memory_current_event_offset = offset;
+    crucible_memory_current_event_length = length;
+}
+
+static bool node_rule_memory_overlap(QemuCrucibleFaultRule *rule,
+                                     uint32_t vcpu, uint64_t vaddr,
+                                     uint64_t gpa, size_t length,
+                                     size_t *offset, size_t *selected,
+                                     uint64_t *rule_offset)
+{
+    uint64_t start, range_length, access, access_end, range_end;
+    uint32_t target_vcpu;
+    bool has_vcpu;
+
+    if (length == 0 || !node_rule_memory_range(rule, &start, &range_length) ||
+        !node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_T3, &has_vcpu) ||
+        !node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_T4, &target_vcpu) ||
+        (has_vcpu && target_vcpu != vcpu)) {
+        return false;
+    }
+    access = has_vcpu ? vaddr : gpa;
+    if (access > UINT64_MAX - length || start > UINT64_MAX - range_length) {
+        return false;
+    }
+    access_end = access + length;
+    range_end = start + range_length;
+    if (access >= range_end || start >= access_end) {
+        return false;
+    }
+    *offset = MAX(access, start) - access;
+    *selected = MIN(access_end, range_end) - MAX(access, start);
+    *rule_offset = MAX(access, start) - start;
+    if (has_vcpu) {
+        uint64_t logical = MAX(access, start);
+        uint64_t physical = gpa + *offset;
+        uint64_t remaining = *selected;
+
+        for (guint i = 0; i < rule->translations->len && remaining != 0; i++) {
+            CrucibleNodeTranslation *translation = &g_array_index(
+                rule->translations, CrucibleNodeTranslation, i);
+            uint64_t covered_start = MAX(start, translation->virtual_page);
+            uint64_t covered_end = covered_start + translation->covered_bytes;
+            uint64_t part;
+
+            if (logical < covered_start || logical >= covered_end) {
+                continue;
+            }
+            part = MIN(remaining, covered_end - logical);
+            if (physical != translation->physical_page +
+                            (logical - translation->virtual_page)) {
+                rule->translation_stale = true;
+                return false;
+            }
+            logical += part;
+            physical += part;
+            remaining -= part;
+        }
+        if (remaining != 0) {
+            rule->translation_stale = true;
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool node_rule_occurs(QemuCrucibleFaultRule *rule, uint16_t tag)
+{
+    CrucibleNodeField *field = node_field(rule, tag);
+    QDict *policy;
+    const char *kind;
+
+    if (!field) {
+        return false;
+    }
+    policy = qobject_to(QDict, field->json);
+    if (!policy) {
+        return false;
+    }
+    kind = qdict_get_try_str(policy, "kind");
+    if (!kind) {
+        return false;
+    }
+    rule->opportunity_count++;
+    if (strcmp(kind, "every") == 0) {
+        rule->applied_count++;
+        return true;
+    }
+    if (strcmp(kind, "periodic") == 0) {
+        QDict *parameters = qobject_to(QDict, qdict_get(policy, "parameters"));
+        uint64_t first, period, count;
+
+        if (!parameters ||
+            !node_json_u64(qdict_get(parameters, "first"), &first) ||
+            !node_json_u64(qdict_get(parameters, "period"), &period) ||
+            !node_json_u64(qdict_get(parameters, "count"), &count) ||
+            rule->opportunity_count < first || rule->applied_count >= count ||
+            (rule->opportunity_count - first) % period != 0) {
+            return false;
+        }
+        rule->applied_count++;
+        return true;
+    }
+    return false;
+}
+
+static void node_repeated_transform(uint8_t *value, const uint8_t *before,
+                                    size_t length, uint64_t rule_offset,
+                                    const CrucibleNodeField *mask,
+                                    const CrucibleNodeField *replacement,
+                                    uint32_t kind)
+{
+    for (size_t i = 0; i < length; i++) {
+        uint8_t selected = mask->data[(rule_offset + i) % mask->length];
+
+        switch (kind) {
+        case 1:
+            value[i] = (value[i] & ~selected) |
+                       (replacement->data[(rule_offset + i) %
+                                          replacement->length] & selected);
+            break;
+        case 2:
+            value[i] ^= selected;
+            break;
+        case 4:
+            value[i] = (value[i] & selected) | (before[i] & ~selected);
+            break;
+        default:
+            g_assert_not_reached();
+        }
+    }
+}
+
+static void node_memory_event(QemuCrucibleFaultRule *rule, uint16_t outcome,
+                              enum QemuCrucibleMemoryAccessClass access_class,
+                              uint32_t vcpu, uint64_t vaddr, uint64_t gpa,
+                              const uint8_t *before, const uint8_t *after,
+                              size_t length, uint64_t observed_icount)
+{
+    uint8_t identity[304] = { 0 };
+    uint8_t before_hash[32], after_hash[32], opportunity_hash[32];
+    uint8_t evidence[sizeof(identity) + 3 * 32];
+
+    memcpy(identity, "CRUCMEM1", 8);
+    stl_le_p(identity + 8, access_class);
+    stl_le_p(identity + 12, vcpu);
+    stq_le_p(identity + 16, vaddr);
+    stq_le_p(identity + 24, gpa);
+    stq_le_p(identity + 32, length);
+    stq_le_p(identity + 40, rule->opportunity_count);
+    stq_le_p(identity + 48, crucible_memory_current_access);
+    stl_le_p(identity + 56, crucible_memory_current_match_count);
+    stl_le_p(identity + 60, crucible_memory_current_event_offset);
+    stq_le_p(identity + 64, observed_icount);
+    stq_le_p(identity + 72, rule->generation);
+    stq_le_p(identity + 80, rule->applied_count);
+    stq_le_p(identity + 88, rule->service_ledger ?
+             rule->service_ledger->ready_ns : 0);
+    stq_le_p(identity + 96, rule->last_exposure_ns);
+    stl_le_p(identity + 104,
+             (rule->exposure_initialized ? 1U : 0U) |
+             (rule->translation_stale ? 2U : 0U));
+    stl_le_p(identity + 108, crucible_memory_current_event_length);
+    memcpy(identity + 112, crucible_memory_current_match_hash, 32);
+    memcpy(identity + 144, rule->translation_hash, 32);
+    if (rule->command_kind == CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE) {
+        stq_le_p(identity + 176, rule->evidence_mutation_count);
+        stq_le_p(identity + 184, rule->evidence_mutation_bytes);
+        memcpy(identity + 192, rule->evidence_mutation_hash, 32);
+    }
+    if (access_class == QEMU_CRUCIBLE_MEMORY_DMA_READ ||
+        access_class == QEMU_CRUCIBLE_MEMORY_DMA_WRITE) {
+        qemu_crucible_fault_dma_identity(identity + 224);
+    }
+    if (crucible_memory_transaction.active) {
+        stl_le_p(identity + 256, crucible_memory_current_fragment);
+        stl_le_p(identity + 260,
+                 crucible_memory_transaction.retry_ordinal);
+        stq_le_p(identity + 264, crucible_memory_transaction.address);
+        stq_le_p(identity + 272, crucible_memory_transaction.length);
+        stq_le_p(identity + 280,
+                 crucible_memory_transaction.observed_icount);
+        stq_le_p(identity + 288, crucible_memory_transaction.tb_pc);
+        stl_le_p(identity + 296,
+                 crucible_memory_transaction.instruction_ordinal);
+        stl_le_p(identity + 300,
+                 crucible_memory_transaction.has_instruction);
+    }
+    node_memory_sha256(identity, sizeof(identity), opportunity_hash);
+    node_memory_sha256(before, length, before_hash);
+    node_memory_sha256(after, length, after_hash);
+    memcpy(evidence, identity, sizeof(identity));
+    memcpy(evidence + sizeof(identity), before_hash, sizeof(before_hash));
+    memcpy(evidence + sizeof(identity) + sizeof(before_hash), after_hash,
+           sizeof(after_hash));
+    qemu_crucible_fault_rule_event(rule, outcome, observed_icount,
+                                   opportunity_hash, before_hash, after_hash,
+                                   evidence, sizeof(evidence));
+    qemu_crucible_fault_notify_events();
+}
+
+static uint64_t node_rate_delay(uint64_t units, uint64_t per_second)
+{
+    uint64_t quotient, remainder;
+
+    if (per_second == 0) {
+        return 0;
+    }
+    quotient = units / per_second;
+    remainder = units % per_second;
+    if (quotient > UINT64_MAX / 1000000000ULL) {
+        error_report("Crucible memory service delay overflow");
+        abort();
+    }
+    quotient *= 1000000000ULL;
+    if (remainder != 0) {
+        uint64_t fractional, high;
+        uint64_t rounding = per_second - 1;
+        uint64_t old_fractional;
+
+        mulu64(&fractional, &high, remainder, 1000000000ULL);
+        old_fractional = fractional;
+        fractional += rounding;
+        high += fractional < old_fractional;
+        divu128(&fractional, &high, per_second);
+        g_assert(high == 0);
+        if (quotient > UINT64_MAX - fractional) {
+            error_report("Crucible memory service delay overflow");
+            abort();
+        }
+        quotient += fractional;
+    }
+    return quotient;
+}
+
+static uint64_t node_virtual_now(void)
+{
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+
+    if (now < 0) {
+        error_report("Crucible fault model observed negative virtual time");
+        abort();
+    }
+    return now;
+}
+
+static uint64_t node_memory_service(QemuCrucibleFaultRule *rule,
+                                    size_t length, uint64_t *latency_out)
+{
+    uint64_t latency, byte_rate, operation_rate, delay, now, ready;
+    bool has_byte_rate, has_operation_rate;
+
+    g_assert(node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_P1, &latency));
+    g_assert(node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_P2,
+                             &has_byte_rate));
+    g_assert(node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_P3, &byte_rate));
+    g_assert(node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_P4,
+                             &has_operation_rate));
+    g_assert(node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_P5,
+                            &operation_rate));
+    *latency_out = latency;
+    delay = 0;
+    if (has_byte_rate) {
+        uint64_t contribution = node_rate_delay(length, byte_rate);
+
+        if (delay > UINT64_MAX - contribution) {
+            error_report("Crucible memory service delay overflow");
+            abort();
+        }
+        delay += contribution;
+    }
+    if (has_operation_rate) {
+        uint64_t contribution = node_rate_delay(1, operation_rate);
+
+        if (delay > UINT64_MAX - contribution) {
+            error_report("Crucible memory service delay overflow");
+            abort();
+        }
+        delay += contribution;
+    }
+    g_assert(rule->service_ledger);
+    now = node_virtual_now();
+    ready = MAX(now, rule->service_ledger->ready_ns);
+    if (ready > UINT64_MAX - delay) {
+        error_report("Crucible memory service coordinate overflow");
+        abort();
+    }
+    rule->service_ledger->ready_ns = ready + delay;
+    return rule->service_ledger->ready_ns - now;
+}
+
+static void node_memory_apply_service(uint64_t delay)
+{
+    int64_t now;
+
+    if (delay == 0) {
+        return;
+    }
+    now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    if (now < 0 || delay > INT64_MAX - now) {
+        error_report("Crucible memory service coordinate overflow");
+        abort();
+    }
+    icount_advance_virtual_time_to_ns(now + delay);
+}
+
+static bool node_rule_physical_span(QemuCrucibleFaultRule *rule,
+                                    uint64_t rule_offset, uint64_t *gpa,
+                                    uint64_t *available)
+{
+    uint64_t start, length;
+    bool has_vcpu;
+
+    if (!node_rule_memory_range(rule, &start, &length) ||
+        rule_offset >= length ||
+        !node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_T3, &has_vcpu)) {
+        return false;
+    }
+    if (!has_vcpu) {
+        *gpa = start + rule_offset;
+        *available = length - rule_offset;
+        return true;
+    }
+
+    uint64_t logical = start + rule_offset;
+
+    for (guint i = 0; i < rule->translations->len; i++) {
+        CrucibleNodeTranslation *translation = &g_array_index(
+            rule->translations, CrucibleNodeTranslation, i);
+        uint64_t covered_start = MAX(start, translation->virtual_page);
+        uint64_t covered_end = covered_start + translation->covered_bytes;
+
+        if (logical >= covered_start && logical < covered_end) {
+            *gpa = translation->physical_page +
+                   (logical - translation->virtual_page);
+            *available = covered_end - logical;
+            return true;
+        }
+    }
+    return false;
+}
+
+static void node_memory_mutation_evidence_reset(QemuCrucibleFaultRule *rule)
+{
+    rule->evidence_mutation_count = 0;
+    rule->evidence_mutation_bytes = 0;
+    memset(rule->evidence_mutation_hash, 0,
+           sizeof(rule->evidence_mutation_hash));
+}
+
+static void node_memory_mutation_evidence_add(QemuCrucibleFaultRule *rule,
+                                              uint64_t physical,
+                                              uint64_t rule_offset,
+                                              const uint8_t *before,
+                                              const uint8_t *after,
+                                              size_t length, bool clear)
+{
+    uint8_t record[128] = { 0 };
+
+    if (rule->evidence_mutation_count == UINT64_MAX ||
+        rule->evidence_mutation_bytes > UINT64_MAX - length) {
+        error_report("Crucible memory mutation evidence overflow");
+        abort();
+    }
+    memcpy(record, rule->evidence_mutation_hash, 32);
+    stq_le_p(record + 32, physical);
+    stq_le_p(record + 40, rule_offset);
+    stq_le_p(record + 48, length);
+    stl_le_p(record + 56, clear);
+    node_memory_sha256(before, length, record + 64);
+    node_memory_sha256(after, length, record + 96);
+    node_memory_sha256(record, sizeof(record),
+                       rule->evidence_mutation_hash);
+    rule->evidence_mutation_count++;
+    rule->evidence_mutation_bytes += length;
+}
+
+static void node_memory_mutate_range(QemuCrucibleFaultRule *rule,
+                                     uint64_t rule_offset, uint64_t length,
+                                     const char *mask, bool clear)
+{
+    size_t mask_length = strlen(mask) / 2;
+    uint8_t buffer[4096];
+
+    while (length != 0) {
+        hwaddr mr_offset;
+        hwaddr region_available;
+        uint64_t physical, translation_available;
+        uint64_t part;
+        MemoryRegion *region;
+
+        if (!node_rule_physical_span(rule, rule_offset, &physical,
+                                     &translation_available)) {
+            error_report("Crucible memory translation became incomplete");
+            abort();
+        }
+        region_available = MIN(length, translation_available);
+        region = address_space_translate(
+            &address_space_memory, physical, &mr_offset, &region_available,
+            true, MEMTXATTRS_UNSPECIFIED);
+        if (!region || region_available == 0 ||
+            !memory_region_is_ram(region) || memory_region_is_rom(region) ||
+            memory_region_is_ram_device(region)) {
+            error_report("Crucible persistent memory target is no longer RAM");
+            abort();
+        }
+        part = MIN((uint64_t)sizeof(buffer), (uint64_t)region_available);
+        memcpy(buffer, memory_region_get_ram_ptr(region) + mr_offset, part);
+        uint8_t before[sizeof(buffer)];
+
+        memcpy(before, buffer, part);
+        for (size_t byte = 0; byte < part; byte++) {
+            unsigned parsed;
+            size_t index = (rule_offset + byte) % mask_length;
+
+            g_assert(sscanf(mask + index * 2, "%2x", &parsed) == 1);
+            if (clear) {
+                buffer[byte] &= ~parsed;
+            } else {
+                buffer[byte] ^= parsed;
+            }
+        }
+        node_memory_mutation_evidence_add(
+            rule, physical, rule_offset, before, buffer, part, clear);
+        memory_region_fault_commit_ram(region, mr_offset, buffer, part);
+        rule_offset += part;
+        length -= part;
+    }
+}
+
+static bool node_memory_apply_retention(QemuCrucibleFaultRule *rule,
+                                        QDict *parameters, uint64_t now)
+{
+    uint64_t interval, length, elapsed, start;
+
+    g_assert(node_json_u64(qdict_get(parameters, "interval_nanos"),
+                           &interval));
+    if (!rule->exposure_initialized) {
+        rule->last_exposure_ns = now;
+        rule->exposure_initialized = true;
+        return false;
+    }
+    if (now < rule->last_exposure_ns ||
+        now - rule->last_exposure_ns < interval) {
+        return false;
+    }
+    elapsed = (now - rule->last_exposure_ns) / interval;
+    rule->last_exposure_ns += elapsed * interval;
+    g_assert(node_rule_memory_range(rule, &start, &length));
+    node_memory_mutate_range(rule, 0, length,
+                             qdict_get_str(parameters, "decay_mask"), true);
+    return true;
+}
+
+static void node_memory_apply_rowhammer_row(QemuCrucibleFaultRule *rule,
+                                            QDict *parameters, uint64_t row,
+                                            uint64_t row_bytes,
+                                            uint64_t threshold,
+                                            uint64_t victim_distance,
+                                            uint64_t range_length)
+{
+    uint64_t *count;
+
+    g_assert(rule->row_counts && row < rule->row_counts->len);
+    count = &g_array_index(rule->row_counts, uint64_t, row);
+    if (*count == UINT64_MAX) {
+        error_report("Crucible rowhammer counter overflow");
+        abort();
+    }
+    (*count)++;
+    if (*count % threshold != 0) {
+        return;
+    }
+    for (unsigned direction = 0; direction < 2; direction++) {
+        uint64_t victim_row;
+        uint64_t victim_offset;
+        uint64_t victim_length;
+
+        if (direction == 0) {
+            if (row < victim_distance) {
+                continue;
+            }
+            victim_row = row - victim_distance;
+        } else {
+            if (row > UINT64_MAX - victim_distance) {
+                continue;
+            }
+            victim_row = row + victim_distance;
+        }
+        if (victim_row > UINT64_MAX / row_bytes) {
+            continue;
+        }
+        victim_offset = victim_row * row_bytes;
+        if (victim_offset >= range_length) {
+            continue;
+        }
+        victim_length = MIN(row_bytes, range_length - victim_offset);
+        node_memory_mutate_range(
+            rule, victim_offset, victim_length,
+            qdict_get_str(parameters, "flip_mask"), false);
+    }
+}
+
+static void node_memory_apply_rowhammer(QemuCrucibleFaultRule *rule,
+                                        QDict *parameters,
+                                        uint64_t rule_offset,
+                                        size_t selected)
+{
+    uint64_t row_bytes, threshold, victim_distance, range_length, ignored;
+    uint64_t first_row, last_row;
+
+    g_assert(selected != 0 && rule_offset <= UINT64_MAX - selected);
+    g_assert(node_json_u64(qdict_get(parameters, "row_bytes"), &row_bytes));
+    g_assert(node_json_u64(qdict_get(parameters, "threshold"), &threshold));
+    g_assert(node_json_u64(qdict_get(parameters, "victim_distance"),
+                           &victim_distance));
+    g_assert(node_rule_memory_range(rule, &ignored, &range_length));
+    first_row = rule_offset / row_bytes;
+    last_row = (rule_offset + selected - 1) / row_bytes;
+    for (uint64_t row = first_row; row <= last_row; row++) {
+        node_memory_apply_rowhammer_row(
+            rule, parameters, row, row_bytes, threshold, victim_distance,
+            range_length);
+    }
+}
+
+bool qemu_crucible_fault_memory_rules_active(void)
+{
+    if (crucible_memory_recursive || !crucible_node_rules ||
+        strcmp(current_accel_name(), "sim") != 0 ||
+        icount_enabled() != ICOUNT_PRECISE) {
+        return false;
+    }
+    return (crucible_memory_gpa_index && crucible_memory_gpa_index->len != 0) ||
+           (crucible_memory_gva_index && crucible_memory_gva_index->len != 0);
+}
+
+void qemu_crucible_fault_memory_transaction_begin(
+    enum QemuCrucibleMemoryAccessClass access_class, uint32_t actor,
+    uint64_t address, size_t length, uint64_t observed_icount,
+    bool has_instruction, uint64_t tb_pc, uint32_t instruction_ordinal)
+{
+    CrucibleMemoryTransaction *transaction = &crucible_memory_transaction;
+    CrucibleMemoryTransaction *last = &crucible_memory_last_transaction;
+
+    if (!qemu_crucible_fault_memory_rules_active()) {
+        return;
+    }
+    if (transaction->active) {
+        error_report("Nested Crucible memory transaction is ambiguous");
+        abort();
+    }
+    if (crucible_memory_access_sequence == UINT64_MAX) {
+        error_report("Crucible memory transaction sequence overflow");
+        abort();
+    }
+    memset(transaction, 0, sizeof(*transaction));
+    transaction->active = true;
+    transaction->valid = true;
+    transaction->access_class = access_class;
+    transaction->actor = actor;
+    transaction->address = address;
+    transaction->length = length;
+    transaction->observed_icount = observed_icount;
+    transaction->has_instruction = has_instruction;
+    transaction->tb_pc = tb_pc;
+    transaction->instruction_ordinal = instruction_ordinal;
+    transaction->identity = ++crucible_memory_access_sequence;
+    if (last->valid && last->access_class == access_class &&
+        last->actor == actor && last->address == address &&
+        last->length == length && last->observed_icount == observed_icount &&
+        last->has_instruction == has_instruction && last->tb_pc == tb_pc &&
+        last->instruction_ordinal == instruction_ordinal) {
+        if (last->retry_ordinal == UINT32_MAX) {
+            error_report("Crucible memory retry ordinal overflow");
+            abort();
+        }
+        transaction->retry_ordinal = last->retry_ordinal + 1;
+    }
+}
+
+void qemu_crucible_fault_memory_transaction_end(void)
+{
+    if (!crucible_memory_transaction.active) {
+        return;
+    }
+    crucible_memory_last_transaction = crucible_memory_transaction;
+    crucible_memory_last_transaction.active = false;
+    memset(&crucible_memory_transaction, 0,
+           sizeof(crucible_memory_transaction));
+}
+
+QemuCrucibleMemoryAccessResult qemu_crucible_fault_memory_access(
+    enum QemuCrucibleMemoryAccessClass access_class, uint32_t vcpu,
+    uint64_t vaddr, uint64_t gpa, const uint8_t *before, uint8_t *value,
+    size_t length, bool atomic, uint64_t observed_icount)
+{
+    QemuCrucibleMemoryAccessResult result = { 0 };
+    bool post_state = false;
+    uint64_t service_latency = 0;
+    uint64_t service_queue = 0;
+    size_t match_count;
+
+    if (!qemu_crucible_fault_memory_rules_active() || !before || !value ||
+        length == 0) {
+        return result;
+    }
+    if (crucible_memory_post_state.active ||
+        length > sizeof(crucible_memory_post_state.before)) {
+        error_report("Crucible memory post-access state was not finalized");
+        abort();
+    }
+    match_count = node_memory_matching_rules(
+        vaddr, gpa, length,
+        access_class != QEMU_CRUCIBLE_MEMORY_DMA_READ &&
+        access_class != QEMU_CRUCIBLE_MEMORY_DMA_WRITE);
+    for (size_t i = 0; i < match_count; i++) {
+        QemuCrucibleFaultRule *rule = crucible_memory_matches[i];
+        size_t offset, selected;
+        uint64_t rule_offset;
+
+        if (rule->command_kind !=
+                CRUCIBLE_FAULT_COMMAND_MEMORY_ACCESS_TRANSFORM &&
+            rule->command_kind != CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE &&
+            rule->command_kind != CRUCIBLE_FAULT_COMMAND_MEMORY_SERVICE) {
+            continue;
+        }
+        if (!node_rule_memory_overlap(rule, vcpu, vaddr, gpa, length, &offset,
+                                      &selected, &rule_offset)) {
+            if (rule->translation_stale &&
+                !rule->translation_error_reported) {
+                node_memory_event_span(0, 0);
+                node_memory_event(rule, CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR,
+                                  access_class, vcpu, vaddr, gpa, before,
+                                  value, length, observed_icount);
+                rule->translation_error_reported = true;
+            }
+            continue;
+        }
+        node_memory_event_span(offset, selected);
+        if (rule->command_kind == CRUCIBLE_FAULT_COMMAND_MEMORY_SERVICE) {
+            uint64_t latency;
+            uint64_t delay = node_memory_service(rule, selected, &latency);
+
+            if (service_latency > UINT64_MAX - latency) {
+                error_report("Crucible memory latency sum overflow");
+                abort();
+            }
+            service_latency += latency;
+            service_queue = MAX(service_queue, delay);
+            node_memory_event(rule, CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED,
+                              access_class, vcpu, vaddr, gpa, before, value,
+                              length, observed_icount);
+            continue;
+        }
+        if (rule->command_kind ==
+            CRUCIBLE_FAULT_COMMAND_MEMORY_ACCESS_TRANSFORM) {
+            uint32_t classes, kind;
+            bool violate_atomicity;
+            uint16_t outcome = CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED;
+
+            g_assert(node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P8,
+                                    &classes));
+            if ((classes & access_class) == 0 ||
+                !node_rule_occurs(rule, CRUCIBLE_NODE_FAULT_FIELD_P7)) {
+                continue;
+            }
+            g_assert(node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P3, &kind));
+            g_assert(node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_P9,
+                                     &violate_atomicity));
+            if (atomic && kind == 4 && !violate_atomicity) {
+                g_assert(rule->applied_count != 0);
+                rule->applied_count--;
+                node_memory_event(rule,
+                                  CRUCIBLE_FAULT_EVENT_OUTCOME_PASSED,
+                                  access_class, vcpu, vaddr, gpa, before, value,
+                                  length, observed_icount);
+                continue;
+            }
+            if (kind == 1 || kind == 2) {
+                node_repeated_transform(
+                    value + offset, before + offset, selected, rule_offset,
+                    node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P4),
+                    node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P6), kind);
+            } else if (kind == 3) {
+                memcpy(value + offset, before + offset, selected);
+                result.suppress_write = offset == 0 && selected == length;
+                outcome = CRUCIBLE_FAULT_EVENT_OUTCOME_SUPPRESSED;
+            } else if (kind == 4) {
+                node_repeated_transform(
+                    value + offset, before + offset, selected, rule_offset,
+                    node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P6), NULL, kind);
+            } else {
+                CrucibleNodeField *poison_field =
+                    node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P6);
+                QDict *poison = qobject_to(QDict, poison_field->json);
+                const char *poison_kind = qdict_get_try_str(poison, "kind");
+
+                if (strcmp(poison_kind, "corrected") == 0) {
+                    QDict *parameters = qobject_to(
+                        QDict, qdict_get(poison, "parameters"));
+                    const char *mask = qdict_get_str(parameters, "xor_mask");
+                    size_t mask_len = strlen(mask) / 2;
+
+                    for (size_t byte = 0; byte < selected; byte++) {
+                        unsigned parsed;
+                        size_t index = (rule_offset + byte) % mask_len;
+
+                        g_assert(sscanf(mask + index * 2, "%2x", &parsed) == 1);
+                        value[offset + byte] ^= parsed;
+                    }
+                    outcome = CRUCIBLE_FAULT_EVENT_OUTCOME_CORRECTED;
+                } else {
+                    result.access_error = true;
+                    outcome = CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR;
+                }
+            }
+            node_memory_event(rule, outcome,
+                              access_class, vcpu, vaddr, gpa, before, value,
+                              length, observed_icount);
+            continue;
+        }
+        if (rule->command_kind == CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE) {
+            uint32_t region_kind;
+            QDict *process;
+            bool state_changed = true;
+
+            g_assert(node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P3,
+                                    &region_kind));
+            process = qobject_to(
+                QDict, node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P4)->json);
+            node_memory_mutation_evidence_reset(rule);
+            if (region_kind != 1 &&
+                (access_class == QEMU_CRUCIBLE_MEMORY_CPU_STORE ||
+                 access_class == QEMU_CRUCIBLE_MEMORY_DMA_WRITE)) {
+                post_state = true;
+                continue;
+            }
+            if (region_kind == 1) {
+                QDict *parameters = qdict_get_qdict(process, "parameters");
+                QDict *policy = qdict_get_qdict(parameters, "policy");
+                const char *policy_kind = qdict_get_str(policy, "kind");
+
+                if (strcmp(policy_kind, "corrected") == 0) {
+                    QDict *corrected = qdict_get_qdict(policy, "parameters");
+                    const char *mask = qdict_get_str(corrected, "xor_mask");
+                    size_t mask_len = strlen(mask) / 2;
+
+                    for (size_t byte = 0; byte < selected; byte++) {
+                        unsigned parsed;
+                        size_t index = (rule_offset + byte) % mask_len;
+
+                        g_assert(sscanf(mask + index * 2, "%2x", &parsed) == 1);
+                        value[offset + byte] ^= parsed;
+                    }
+                    node_memory_event(
+                        rule, CRUCIBLE_FAULT_EVENT_OUTCOME_CORRECTED,
+                        access_class, vcpu, vaddr, gpa, before, value,
+                        length, observed_icount);
+                } else {
+                    result.access_error = true;
+                    node_memory_event(rule,
+                                      CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR,
+                                      access_class, vcpu, vaddr, gpa, before,
+                                      value, length, observed_icount);
+                }
+            } else if (region_kind == 2) {
+                QDict *parameters = qdict_get_qdict(process, "parameters");
+                uint64_t now = node_virtual_now();
+
+                node_memory_mutation_evidence_reset(rule);
+                bool decayed = node_memory_apply_retention(rule, parameters,
+                                                            now);
+
+                state_changed = decayed;
+
+                if (decayed &&
+                    (access_class == QEMU_CRUCIBLE_MEMORY_FETCH ||
+                     access_class == QEMU_CRUCIBLE_MEMORY_CPU_LOAD ||
+                     access_class == QEMU_CRUCIBLE_MEMORY_DMA_READ)) {
+                    const char *mask = qdict_get_str(parameters, "decay_mask");
+                    size_t mask_len = strlen(mask) / 2;
+
+                    for (size_t byte = 0; byte < selected; byte++) {
+                        unsigned parsed;
+                        size_t index = (rule_offset + byte) % mask_len;
+
+                        g_assert(sscanf(mask + index * 2, "%2x", &parsed) == 1);
+                        value[offset + byte] &= ~parsed;
+                    }
+                }
+            } else {
+                QDict *parameters = qdict_get_qdict(process, "parameters");
+
+                node_memory_mutation_evidence_reset(rule);
+                node_memory_apply_rowhammer(rule, parameters, rule_offset,
+                                            selected);
+            }
+            if (region_kind != 1) {
+                uint16_t outcome = state_changed ?
+                    CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED :
+                    CRUCIBLE_FAULT_EVENT_OUTCOME_PASSED;
+
+                node_memory_event(rule, outcome,
+                                  access_class, vcpu, vaddr, gpa, before,
+                                  value, length, observed_icount);
+            }
+        }
+    }
+    if (post_state) {
+        crucible_memory_post_state.active = true;
+        crucible_memory_post_state.access_class = access_class;
+        crucible_memory_post_state.vcpu = vcpu;
+        crucible_memory_post_state.vaddr = vaddr;
+        crucible_memory_post_state.gpa = gpa;
+        crucible_memory_post_state.length = length;
+        crucible_memory_post_state.observed_icount = observed_icount;
+        crucible_memory_post_state.access_sequence =
+            crucible_memory_current_access;
+        memcpy(crucible_memory_post_state.before, before, length);
+    }
+    if (service_latency > UINT64_MAX - service_queue) {
+        error_report("Crucible memory completion delay overflow");
+        abort();
+    }
+    result.service_nanos = service_latency + service_queue;
+    node_memory_apply_service(result.service_nanos);
+    node_memory_matching_rules_done();
+    if (result.access_error && post_state) {
+        qemu_crucible_fault_memory_access_finish(before, length);
+    }
+    return result;
+}
+
+void qemu_crucible_fault_memory_access_finish(const uint8_t *after,
+                                              size_t length)
+{
+    CrucibleMemoryPostState *post = &crucible_memory_post_state;
+    size_t match_count;
+
+    if (!post->active) {
+        return;
+    }
+    if (!after || length != post->length) {
+        error_report("Crucible memory post-access identity changed");
+        abort();
+    }
+    match_count = node_memory_matching_rules_at(
+        post->vaddr, post->gpa, post->length,
+        post->access_class != QEMU_CRUCIBLE_MEMORY_DMA_WRITE,
+        post->access_sequence);
+    for (size_t i = 0; i < match_count; i++) {
+        QemuCrucibleFaultRule *rule = crucible_memory_matches[i];
+        size_t offset, selected;
+        uint64_t rule_offset;
+        uint32_t region_kind;
+        QDict *process;
+
+        if (rule->command_kind !=
+                CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE ||
+            !node_rule_memory_overlap(
+                rule, post->vcpu, post->vaddr, post->gpa, post->length,
+                &offset, &selected, &rule_offset)) {
+            continue;
+        }
+        node_memory_event_span(offset, selected);
+        g_assert(node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P3,
+                                &region_kind));
+        node_memory_mutation_evidence_reset(rule);
+        if (region_kind == 1) {
+            continue;
+        }
+        process = qobject_to(
+            QDict, node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P4)->json);
+        if (region_kind == 2) {
+            QDict *parameters = qdict_get_qdict(process, "parameters");
+            node_memory_mutation_evidence_reset(rule);
+            bool decayed = node_memory_apply_retention(
+                rule, parameters, node_virtual_now());
+
+            node_memory_event(
+                rule, decayed ? CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED :
+                                CRUCIBLE_FAULT_EVENT_OUTCOME_PASSED,
+                post->access_class, post->vcpu, post->vaddr, post->gpa,
+                post->before, after, post->length, post->observed_icount);
+        } else {
+            node_memory_mutation_evidence_reset(rule);
+            node_memory_apply_rowhammer(
+                rule, qdict_get_qdict(process, "parameters"), rule_offset,
+                selected);
+            node_memory_event(
+                rule, CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED,
+                post->access_class, post->vcpu, post->vaddr, post->gpa,
+                post->before, after, post->length, post->observed_icount);
+        }
+    }
+    node_memory_matching_rules_done();
+    memset(post, 0, sizeof(*post));
+}
+
+QemuCrucibleMemoryAccessResult qemu_crucible_fault_memory_atomic(
+    uint32_t vcpu, uint64_t vaddr, uint64_t gpa, const uint8_t *before,
+    uint8_t *visible, uint8_t *committed, size_t length,
+    bool write_happened, uint64_t observed_icount)
+{
+    QemuCrucibleMemoryAccessResult result = { 0 };
+    uint32_t access_classes = QEMU_CRUCIBLE_MEMORY_CPU_LOAD |
+        (write_happened ? QEMU_CRUCIBLE_MEMORY_CPU_STORE : 0);
+    size_t match_count;
+    uint64_t service_latency = 0;
+    uint64_t service_queue = 0;
+
+    if (!qemu_crucible_fault_memory_rules_active() || !before || !visible ||
+        !committed || length == 0) {
+        return result;
+    }
+    match_count = node_memory_matching_rules(vaddr, gpa, length, true);
+    for (size_t i = 0; i < match_count; i++) {
+        QemuCrucibleFaultRule *rule = crucible_memory_matches[i];
+        size_t offset, selected;
+        uint64_t rule_offset;
+
+        if (rule->command_kind !=
+                CRUCIBLE_FAULT_COMMAND_MEMORY_ACCESS_TRANSFORM &&
+            rule->command_kind != CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE &&
+            rule->command_kind != CRUCIBLE_FAULT_COMMAND_MEMORY_SERVICE) {
+            continue;
+        }
+        if (!node_rule_memory_overlap(rule, vcpu, vaddr, gpa, length, &offset,
+                                      &selected, &rule_offset)) {
+            if (rule->translation_stale &&
+                !rule->translation_error_reported) {
+                node_memory_event_span(0, 0);
+                node_memory_event(rule, CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR,
+                                  access_classes, vcpu, vaddr, gpa, before,
+                                  visible, length, observed_icount);
+                rule->translation_error_reported = true;
+            }
+            continue;
+        }
+        node_memory_event_span(offset, selected);
+        if (rule->command_kind == CRUCIBLE_FAULT_COMMAND_MEMORY_SERVICE) {
+            uint64_t latency;
+            uint64_t delay = node_memory_service(rule, selected, &latency);
+
+            if (service_latency > UINT64_MAX - latency) {
+                error_report("Crucible memory latency sum overflow");
+                abort();
+            }
+            service_latency += latency;
+            service_queue = MAX(service_queue, delay);
+            node_memory_event(rule, CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED,
+                              access_classes, vcpu, vaddr, gpa, before,
+                              committed, length, observed_icount);
+            continue;
+        }
+        if (rule->command_kind ==
+            CRUCIBLE_FAULT_COMMAND_MEMORY_ACCESS_TRANSFORM) {
+            uint32_t classes, kind;
+            bool violate_atomicity;
+            uint16_t outcome = CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED;
+
+            g_assert(node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P8,
+                                    &classes));
+            if ((classes & access_classes) == 0 ||
+                !node_rule_occurs(rule, CRUCIBLE_NODE_FAULT_FIELD_P7)) {
+                continue;
+            }
+            g_assert(node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P3, &kind));
+            g_assert(node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_P9,
+                                     &violate_atomicity));
+            if (kind == 4 && !violate_atomicity) {
+                g_assert(rule->applied_count != 0);
+                rule->applied_count--;
+                node_memory_event(rule, CRUCIBLE_FAULT_EVENT_OUTCOME_PASSED,
+                                  access_classes, vcpu, vaddr, gpa, before,
+                                  committed, length, observed_icount);
+                continue;
+            }
+            if (kind == 1) {
+                if (classes & QEMU_CRUCIBLE_MEMORY_CPU_LOAD) {
+                    node_repeated_transform(
+                        visible + offset, before + offset, selected,
+                        rule_offset,
+                        node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P4),
+                        node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P6), kind);
+                }
+                if (write_happened &&
+                    (classes & QEMU_CRUCIBLE_MEMORY_CPU_STORE)) {
+                    node_repeated_transform(
+                        committed + offset, before + offset, selected,
+                        rule_offset,
+                        node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P4),
+                        node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P6), kind);
+                }
+            } else if (kind == 2) {
+                node_repeated_transform(
+                    visible + offset, before + offset, selected, rule_offset,
+                    node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P4),
+                    node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P6), kind);
+            } else if (kind == 3 && write_happened) {
+                memcpy(committed + offset, before + offset, selected);
+                result.suppress_write = offset == 0 && selected == length;
+                outcome = CRUCIBLE_FAULT_EVENT_OUTCOME_SUPPRESSED;
+            } else if (kind == 4 && write_happened) {
+                node_repeated_transform(
+                    committed + offset, before + offset, selected, rule_offset,
+                    node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P6), NULL, kind);
+            } else if (kind == 5) {
+                QDict *poison = qobject_to(
+                    QDict, node_field(rule,
+                        CRUCIBLE_NODE_FAULT_FIELD_P6)->json);
+                const char *poison_kind = qdict_get_str(poison, "kind");
+
+                if (strcmp(poison_kind, "corrected") == 0) {
+                    QDict *parameters = qdict_get_qdict(poison, "parameters");
+                    const char *mask = qdict_get_str(parameters, "xor_mask");
+                    size_t mask_len = strlen(mask) / 2;
+
+                    for (size_t byte = 0; byte < selected; byte++) {
+                        unsigned parsed;
+                        size_t index = (rule_offset + byte) % mask_len;
+
+                        g_assert(sscanf(mask + index * 2, "%2x", &parsed) == 1);
+                        visible[offset + byte] ^= parsed;
+                    }
+                    outcome = CRUCIBLE_FAULT_EVENT_OUTCOME_CORRECTED;
+                } else {
+                    result.access_error = true;
+                    outcome = CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR;
+                }
+            }
+            node_memory_event(rule, outcome,
+                              access_classes, vcpu, vaddr, gpa, before,
+                              write_happened ? committed : visible, length,
+                              observed_icount);
+            continue;
+        }
+
+        uint32_t region_kind;
+        QDict *process = qobject_to(
+            QDict, node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P4)->json);
+        uint16_t outcome = CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED;
+
+        g_assert(node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P3,
+                                &region_kind));
+        node_memory_mutation_evidence_reset(rule);
+        if (region_kind == 1) {
+            QDict *parameters = qdict_get_qdict(process, "parameters");
+            QDict *policy = qdict_get_qdict(parameters, "policy");
+            const char *policy_kind = qdict_get_str(policy, "kind");
+
+            if (strcmp(policy_kind, "corrected") == 0) {
+                QDict *corrected = qdict_get_qdict(policy, "parameters");
+                const char *mask = qdict_get_str(corrected, "xor_mask");
+                size_t mask_len = strlen(mask) / 2;
+
+                for (size_t byte = 0; byte < selected; byte++) {
+                    unsigned parsed;
+                    size_t index = (rule_offset + byte) % mask_len;
+
+                    g_assert(sscanf(mask + index * 2, "%2x", &parsed) == 1);
+                    visible[offset + byte] ^= parsed;
+                }
+                outcome = CRUCIBLE_FAULT_EVENT_OUTCOME_CORRECTED;
+            } else {
+                result.access_error = true;
+                outcome = CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR;
+            }
+        } else if (region_kind == 2) {
+            QDict *parameters = qdict_get_qdict(process, "parameters");
+            uint64_t now = node_virtual_now();
+            node_memory_mutation_evidence_reset(rule);
+            bool decayed = node_memory_apply_retention(rule, parameters, now);
+
+            if (decayed) {
+                const char *mask = qdict_get_str(parameters, "decay_mask");
+                size_t mask_len = strlen(mask) / 2;
+
+                for (size_t byte = 0; byte < selected; byte++) {
+                    unsigned parsed;
+                    size_t index = (rule_offset + byte) % mask_len;
+
+                    g_assert(sscanf(mask + index * 2, "%2x", &parsed) == 1);
+                    visible[offset + byte] &= ~parsed;
+                }
+            } else {
+                outcome = CRUCIBLE_FAULT_EVENT_OUTCOME_PASSED;
+            }
+        } else {
+            node_memory_mutation_evidence_reset(rule);
+            node_memory_apply_rowhammer(
+                rule, qdict_get_qdict(process, "parameters"), rule_offset,
+                selected);
+        }
+        node_memory_event(rule, outcome,
+                          access_classes, vcpu, vaddr, gpa, before,
+                          write_happened ? committed : visible, length,
+                          observed_icount);
+    }
+    if (service_latency > UINT64_MAX - service_queue) {
+        error_report("Crucible memory completion delay overflow");
+        abort();
+    }
+    result.service_nanos = service_latency + service_queue;
+    node_memory_apply_service(result.service_nanos);
+    node_memory_matching_rules_done();
+    return result;
+}
+
+static void crucible_memory_access_faults_register(void)
+{
+    const uint32_t boundary =
+        1U << (CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY - 1);
+
+    qemu_crucible_fault_node_register(
+        CRUCIBLE_FAULT_COMMAND_MEMORY_ACCESS_TRANSFORM,
+        QEMU_PLUGIN_CRUCIBLE_FAULT_SCOPE_ALL, boundary,
+        "qemu.memory.access-transform.v1", NULL);
+    qemu_crucible_fault_node_register(
+        CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE,
+        QEMU_PLUGIN_CRUCIBLE_FAULT_SCOPE_ALL, boundary,
+        "qemu.memory.region-state.v1", NULL);
+    qemu_crucible_fault_node_register(
+        CRUCIBLE_FAULT_COMMAND_MEMORY_SERVICE,
+        QEMU_PLUGIN_CRUCIBLE_FAULT_SCOPE_ALL, boundary,
+        "qemu.memory.service.v1", NULL);
+}
+
+type_init(crucible_memory_access_faults_register)
