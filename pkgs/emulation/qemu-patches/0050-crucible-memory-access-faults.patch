+static MemoryRegion *flatview_translate_crucible(
+    FlatView *fv, hwaddr addr, hwaddr *xlat, hwaddr *plen, bool is_write,
+    MemTxAttrs attrs, hwaddr *physical)
+{
+    AddressSpace *target_as = NULL;
+    MemoryRegionSection section = flatview_do_translate(
+        fv, addr, xlat, plen, NULL, is_write, true, &target_as, attrs);
+    MemoryRegion *mr = section.mr;
+
+    *physical = UINT64_MAX;
+    if (target_as == &address_space_memory ||
+        (!target_as &&
+         fv == address_space_to_flatview(&address_space_memory))) {
+        *physical = *xlat + section.offset_within_address_space -
+                    section.offset_within_region;
+    }
+    if (xen_enabled() && memory_access_is_direct(mr, is_write, attrs)) {
+        hwaddr page = ((addr & TARGET_PAGE_MASK) + TARGET_PAGE_SIZE) - addr;
+
+        *plen = MIN(page, *plen);
+    }
+    return mr;
+}
+
+bool address_space_translate_crucible_dma(
+    AddressSpace *as, hwaddr iova, hwaddr *gpa, MemoryRegion **mr,
+    hwaddr *mr_addr, hwaddr *plen, bool is_write, MemTxAttrs attrs)
+{
+    AddressSpace *target_as = NULL;
+    MemoryRegionSection section;
+    hwaddr xlat;
+
+    RCU_READ_LOCK_GUARD();
+    section = flatview_do_translate(
+        address_space_to_flatview(as), iova, &xlat, plen, NULL,
+        is_write, true, &target_as, attrs);
+    if ((target_as && target_as != &address_space_memory) ||
+        (!target_as && as != &address_space_memory) ||
+        !memory_access_is_direct(section.mr, is_write, attrs)) {
+        *gpa = UINT64_MAX;
+        *mr = NULL;
+        *mr_addr = 0;
+        return false;
+    }
+    *gpa = xlat + section.offset_within_address_space -
+           section.offset_within_region;
+    *mr = section.mr;
+    *mr_addr = xlat;
+    return true;
+}
