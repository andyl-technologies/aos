+static void test_put_u16(uint8_t *bytes, uint16_t value)
+{
+    bytes[0] = value;
+    bytes[1] = value >> 8;
+}
+
+static void test_put_u32(uint8_t *bytes, uint32_t value)
+{
+    for (size_t i = 0; i < 4; i++) {
+        bytes[i] = value >> (i * 8);
+    }
+}
+
+static void test_put_u64(uint8_t *bytes, uint64_t value)
+{
+    for (size_t i = 0; i < 8; i++) {
+        bytes[i] = value >> (i * 8);
+    }
+}
+
+static uint32_t test_get_u32(const uint8_t *bytes)
+{
+    return bytes[0] | (uint32_t)bytes[1] << 8 |
+           (uint32_t)bytes[2] << 16 | (uint32_t)bytes[3] << 24;
+}
+
+static uint16_t test_get_u16(const uint8_t *bytes)
+{
+    return bytes[0] | (uint16_t)bytes[1] << 8;
+}
+
+static uint64_t test_get_u64(const uint8_t *bytes)
+{
+    return test_get_u32(bytes) | (uint64_t)test_get_u32(bytes + 4) << 32;
+}
+
+static size_t test_parse_hex(const char *text, uint8_t *bytes,
+                             size_t capacity)
+{
+    size_t length = strlen(text);
+
+    if (length == 0 || (length & 1) != 0 || length / 2 > capacity) {
+        test_fail("hex vector has an invalid length");
+    }
+    for (size_t i = 0; i < length / 2; i++) {
+        unsigned parsed;
+
+        if (sscanf(text + i * 2, "%2x", &parsed) != 1) {
+            test_fail("hex vector contains a non-hex byte");
+        }
+        bytes[i] = parsed;
+    }
+    return length / 2;
+}
+
+static void test_field(uint16_t tag, uint16_t type,
+                       const void *data, uint32_t length)
+{
+    uint8_t header[CRUCIBLE_NODE_FAULT_FIELD_HEADER_V1_BYTES];
+
+    test_put_u16(header + CRUCIBLE_NODE_FAULT_FIELD_TAG_OFFSET, tag);
+    test_put_u16(header + CRUCIBLE_NODE_FAULT_FIELD_TYPE_OFFSET, type);
+    test_put_u32(header + CRUCIBLE_NODE_FAULT_FIELD_LENGTH_OFFSET, length);
+    g_byte_array_append(test_payload, header, sizeof(header));
+    g_byte_array_append(test_payload, data, length);
+}
+
+static void test_field_u32(uint16_t tag, uint32_t value)
+{
+    uint8_t bytes[4];
+
+    test_put_u32(bytes, value);
+    test_field(tag, CRUCIBLE_NODE_FAULT_FIELD_TYPE_U32,
+               bytes, sizeof(bytes));
+}
+
+static void test_field_u64(uint16_t tag, uint64_t value)
+{
+    uint8_t bytes[8];
+
+    test_put_u64(bytes, value);
+    test_field(tag, CRUCIBLE_NODE_FAULT_FIELD_TYPE_U64,
+               bytes, sizeof(bytes));
+}
+
+static void test_field_bool(uint16_t tag, bool value)
+{
+    uint8_t byte = value;
+
+    test_field(tag, CRUCIBLE_NODE_FAULT_FIELD_TYPE_BOOL, &byte, 1);
+}
+
+static void test_field_policy(uint16_t tag, const char *json)
+{
+    g_autofree char *policy = g_strconcat(
+        CRUCIBLE_NODE_FAULT_POLICY_JSON_MAGIC_V1, json, NULL);
+
+    test_field(tag, CRUCIBLE_NODE_FAULT_FIELD_TYPE_BYTES,
+               policy, strlen(policy));
+}
+
+static void test_payload_begin(uint16_t command_kind, uint16_t field_count)
+{
+    uint8_t header[CRUCIBLE_NODE_FAULT_PAYLOAD_HEADER_V1_BYTES] = { 0 };
+
+    memcpy(header + CRUCIBLE_NODE_FAULT_PAYLOAD_MAGIC_OFFSET,
+           "CRUCNOD1", 8);
+    test_put_u16(header + CRUCIBLE_NODE_FAULT_PAYLOAD_VERSION_OFFSET,
+                 CRUCIBLE_NODE_FAULT_PAYLOAD_VERSION_V1);
+    test_put_u16(header + CRUCIBLE_NODE_FAULT_PAYLOAD_COMMAND_KIND_OFFSET,
+                 command_kind);
+    test_put_u16(header + CRUCIBLE_NODE_FAULT_PAYLOAD_OPERATION_OFFSET,
+                 CRUCIBLE_NODE_FAULT_OPERATION_UPSERT);
+    test_put_u16(header + CRUCIBLE_NODE_FAULT_PAYLOAD_TARGET_KIND_OFFSET,
+                 CRUCIBLE_NODE_FAULT_TARGET_MEMORY);
+    test_put_u16(header + CRUCIBLE_NODE_FAULT_PAYLOAD_MODEL_PHASE_OFFSET, 1);
+    test_put_u64(header + CRUCIBLE_NODE_FAULT_PAYLOAD_GENERATION_OFFSET, 1);
+    memset(header + CRUCIBLE_NODE_FAULT_PAYLOAD_ACTION_HASH_OFFSET, 0x21, 32);
+    memset(header + CRUCIBLE_NODE_FAULT_PAYLOAD_TARGET_HASH_OFFSET, 0x22, 32);
+    memset(header + CRUCIBLE_NODE_FAULT_PAYLOAD_SCHEMA_HASH_OFFSET, 0x23, 32);
+    test_put_u16(header + CRUCIBLE_NODE_FAULT_PAYLOAD_FIELD_COUNT_OFFSET,
+                 field_count);
+    test_payload = g_byte_array_new();
+    g_byte_array_append(test_payload, header, sizeof(header));
+}
