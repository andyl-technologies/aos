+static CrucibleMemoryReservedCounters *node_memory_reserved_counter(
+    QemuCrucibleFaultRule *rule, bool create)
+{
+    CrucibleMemoryReservedCounters *reserved;
+
+    if (!crucible_memory_reserved_counters) {
+        if (!create) {
+            return NULL;
+        }
+        crucible_memory_reserved_counters = g_hash_table_new_full(
+            g_direct_hash, g_direct_equal, NULL, g_free);
+    }
+    reserved = g_hash_table_lookup(crucible_memory_reserved_counters, rule);
+    if (!reserved && create) {
+        reserved = g_new0(CrucibleMemoryReservedCounters, 1);
+        g_hash_table_insert(crucible_memory_reserved_counters,
+                            rule, reserved);
+    }
+    return reserved;
+}
+
+static CrucibleMemoryReservedRows *node_memory_reserved_row_set(
+    QemuCrucibleFaultRule *rule, bool create)
+{
+    CrucibleMemoryReservedRows *rows;
+
+    if (!crucible_memory_reserved_rows) {
+        if (!create) {
+            return NULL;
+        }
+        crucible_memory_reserved_rows = g_hash_table_new_full(
+            g_direct_hash, g_direct_equal, NULL,
+            node_memory_reserved_rows_free);
+    }
+    rows = g_hash_table_lookup(crucible_memory_reserved_rows, rule);
+    if (!rows && create) {
+        rows = g_new0(CrucibleMemoryReservedRows, 1);
+        rows->coordinates = g_hash_table_new_full(
+            node_dram_coordinate_hash, node_dram_coordinate_equal,
+            g_free, g_free);
+        g_hash_table_insert(crucible_memory_reserved_rows, rule, rows);
+    }
+    return rows;
+}
+
+static uint64_t node_memory_reserved_row_count(
+    QemuCrucibleFaultRule *rule,
+    const CrucibleDramCoordinate *coordinate)
+{
+    CrucibleMemoryReservedRows *rows = node_memory_reserved_row_set(
+        rule, false);
+    uint64_t *count = rows ?
+        g_hash_table_lookup(rows->coordinates, coordinate) : NULL;
+
+    return count ? *count : 0;
+}
