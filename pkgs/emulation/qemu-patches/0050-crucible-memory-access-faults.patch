+static bool node_field_bool(QemuCrucibleFaultRule *rule, uint16_t tag,
+                            bool *value)
+{
+    CrucibleNodeField *field = node_field(rule, tag);
+
+    if (!field || field->type != CRUCIBLE_NODE_FAULT_FIELD_TYPE_BOOL) {
+        return false;
+    }
+    *value = field->data[0] != 0;
+    return true;
+}
+
+static bool node_field_zero(QemuCrucibleFaultRule *rule, uint16_t tag)
+{
+    CrucibleNodeField *field = node_field(rule, tag);
+    uint8_t aggregate = 0;
+
+    if (!field) {
+        return false;
+    }
+    for (size_t i = 0; i < field->length; i++) {
+        aggregate |= field->data[i];
+    }
+    return aggregate == 0;
+}
+
+static bool node_field_nonzero(QemuCrucibleFaultRule *rule, uint16_t tag)
+{
+    return !node_field_zero(rule, tag);
