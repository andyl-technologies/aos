+static bool node_memory_dma_transaction_active(void)
+{
+    return crucible_memory_transaction.active &&
+        (crucible_memory_transaction.access_class ==
+             QEMU_CRUCIBLE_MEMORY_DMA_READ ||
+         crucible_memory_transaction.access_class ==
+             QEMU_CRUCIBLE_MEMORY_DMA_WRITE);
+}
+
+static CrucibleMemoryMutationFragment *
+node_memory_mutation_fragment(QemuCrucibleFaultRule *rule,
+                              uint64_t rule_offset)
+{
+    GArray *fragments =
+        crucible_memory_transaction.dma_mutation_fragments;
+
+    if (!fragments) {
+        return NULL;
+    }
+    for (guint i = 0; i < fragments->len; i++) {
+        CrucibleMemoryMutationFragment *fragment = &g_array_index(
+            fragments, CrucibleMemoryMutationFragment, i);
+
+        if (fragment->rule == rule &&
+            rule_offset >= fragment->rule_offset &&
+            rule_offset - fragment->rule_offset < fragment->length) {
+            return fragment;
+        }
+    }
+    return NULL;
+}
+
+static void node_memory_shadow_read(uint64_t gpa, uint8_t *value,
+                                    size_t length)
+{
+    GArray *writes = crucible_memory_transaction.shadow_writes;
+
+    for (guint i = 0; writes && i < writes->len; i++) {
+        CrucibleMemoryShadowWrite *write = &g_array_index(
+            writes, CrucibleMemoryShadowWrite, i);
+        uint64_t start = MAX(gpa, write->gpa);
+        uint64_t end = MIN(gpa + length,
+                           write->gpa + write->value->len);
+
+        if (start < end) {
+            memcpy(value + (start - gpa),
+                   write->value->data + (start - write->gpa),
+                   end - start);
+        }
+    }
+}
+
+static void node_memory_shadow_write(MemoryRegion *mr, uint64_t mr_addr,
+                                     uint64_t gpa, const uint8_t *value,
+                                     size_t length)
+{
+    CrucibleMemoryTransaction *transaction = &crucible_memory_transaction;
+    CrucibleMemoryShadowWrite write = {
+        .gpa = gpa,
+        .mr_addr = mr_addr,
+        .mr = mr,
+        .value = g_byte_array_sized_new(length),
+    };
+
+    if (!transaction->shadow_writes) {
+        transaction->shadow_writes = g_array_new(
+            false, false, sizeof(CrucibleMemoryShadowWrite));
+        g_array_set_clear_func(transaction->shadow_writes,
+                               node_memory_shadow_write_clear);
+    }
+    memory_region_ref(mr);
+    g_byte_array_append(write.value, value, length);
+    g_array_append_val(transaction->shadow_writes, write);
+}
+
+static void node_memory_mutate_range(QemuCrucibleFaultRule *rule,
+                                     uint64_t rule_offset, uint64_t length,
+                                     const char *mask, bool clear)
+{
+    size_t mask_length = strlen(mask) / 2;
+    uint8_t buffer[4096];
+
+    while (length != 0) {
+        hwaddr mr_offset;
+        hwaddr region_available;
+        uint64_t physical, translation_available;
+        uint64_t part;
+        MemoryRegion *region;
+
+        if (node_memory_dma_transaction_active()) {
+            CrucibleMemoryMutationFragment *fragment =
+                node_memory_mutation_fragment(rule, rule_offset);
+            uint64_t within;
+
+            if (!fragment) {
+                error_report("Crucible frozen mutation plan is incomplete");
+                abort();
+            }
+            within = rule_offset - fragment->rule_offset;
+            region = fragment->mr;
+            mr_offset = fragment->mr_addr + within;
+            physical = fragment->gpa + within;
+            region_available = MIN(length, fragment->length - within);
+        } else {
+            if (!node_rule_physical_span(rule, rule_offset, &physical,
+                                         &translation_available)) {
+                error_report("Crucible memory translation became incomplete");
+                abort();
+            }
+            region_available = MIN(length, translation_available);
+            region = address_space_translate(
+                &address_space_memory, physical, &mr_offset,
+                &region_available, true, MEMTXATTRS_UNSPECIFIED);
+        }
+        if (!region || region_available == 0 ||
+            !memory_region_is_ram(region) || memory_region_is_rom(region) ||
+            memory_region_is_ram_device(region)) {
+            error_report("Crucible persistent memory target is no longer RAM");
+            abort();
+        }
+        part = MIN((uint64_t)sizeof(buffer), (uint64_t)region_available);
+        memcpy(buffer, memory_region_get_ram_ptr(region) + mr_offset, part);
+        if (crucible_memory_transaction.active &&
+            crucible_memory_transaction.streaming) {
+            node_memory_shadow_read(physical, buffer, part);
+        }
+        uint8_t before[sizeof(buffer)];
+
+        memcpy(before, buffer, part);
+        for (size_t byte = 0; byte < part; byte++) {
+            unsigned parsed;
+            size_t index = (rule_offset + byte) % mask_length;
+
+            g_assert(sscanf(mask + index * 2, "%2x", &parsed) == 1);
+            if (clear) {
+                buffer[byte] &= ~parsed;
+            } else {
+                buffer[byte] ^= parsed;
+            }
+        }
+        node_memory_mutation_evidence_add(
+            rule, physical, rule_offset, before, buffer, part, clear);
+        if (crucible_memory_transaction.active &&
+            crucible_memory_transaction.streaming) {
+            node_memory_shadow_write(region, mr_offset, physical,
+                                     buffer, part);
+        } else {
+            memory_region_fault_commit_ram(region, mr_offset, buffer, part);
+        }
+        rule_offset += part;
+        length -= part;
+    }
+}
+
+static CrucibleRetentionCell *
+node_memory_retention_cell(QemuCrucibleFaultRule *rule, uint64_t offset,
+                           bool create)
+{
+    CrucibleRetentionCell *cell;
+
+    if (!rule->retention_cells) {
+        if (!create) {
+            return NULL;
+        }
+        rule->retention_cells = g_hash_table_new_full(
+            g_int64_hash, g_int64_equal, g_free, g_free);
+    }
+    cell = g_hash_table_lookup(rule->retention_cells, &offset);
+    if (!cell && create) {
+        uint64_t *key;
+
+        g_assert(g_hash_table_size(rule->retention_cells) <
+                 CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT);
+        key = g_new(uint64_t, 1);
+        *key = offset;
+        cell = g_new0(CrucibleRetentionCell, 1);
+        for (size_t bit = 0; bit < 8; bit++) {
+            cell->refresh_ns[bit] = rule->last_exposure_ns;
+        }
+        g_hash_table_insert(rule->retention_cells, key, cell);
+    }
+    return cell;
+}
+
+static bool node_memory_apply_retention(QemuCrucibleFaultRule *rule,
+                                        QDict *parameters,
+                                        uint64_t rule_offset,
+                                        uint8_t *value, size_t length,
+                                        uint64_t now)
+{
+    uint64_t interval;
+    const char *mask;
+    size_t mask_length;
+    bool changed = false;
+
+    g_assert(node_json_u64(qdict_get(parameters, "interval_nanos"),
+                           &interval));
+    if (!rule->exposure_initialized) {
+        rule->last_exposure_ns = now;
+        rule->exposure_initialized = true;
+        return false;
+    }
+    mask = qdict_get_str(parameters, "decay_mask");
+    mask_length = strlen(mask) / 2;
+    for (size_t byte = 0; byte < length; byte++) {
+        uint64_t offset = rule_offset + byte;
+        CrucibleRetentionCell *cell = node_memory_retention_cell(
+            rule, offset, false);
+        unsigned parsed;
+        uint8_t due = 0;
+        size_t index = offset % mask_length;
+
+        g_assert(sscanf(mask + index * 2, "%2x", &parsed) == 1);
+        for (size_t bit = 0; bit < 8; bit++) {
+            uint8_t selected = 1U << bit;
+            uint64_t refreshed = cell ? cell->refresh_ns[bit] :
+                                        rule->last_exposure_ns;
+
+            if ((parsed & selected) != 0 &&
+                (cell == NULL || (cell->decayed_mask & selected) == 0) &&
+                now >= refreshed && now - refreshed >= interval) {
+                due |= selected;
+            }
+        }
+        if (due != 0) {
+            char due_mask[3];
+
+            if (!cell) {
+                cell = node_memory_retention_cell(rule, offset, true);
+            }
+            snprintf(due_mask, sizeof(due_mask), "%02x", due);
+            node_memory_mutate_range(rule, offset, 1, due_mask, true);
+            cell->decayed_mask |= due;
+            if (value) {
+                value[byte] &= ~due;
+            }
+            changed = true;
+        }
+    }
+    return changed;
+}
+
+static bool node_memory_retention_chunk_due(
+    QemuCrucibleFaultRule *rule, QDict *parameters,
+    uint64_t rule_offset, size_t length, uint64_t now)
+{
+    uint64_t interval;
+    const char *mask;
+    size_t mask_length;
+
+    if (!rule->retention_scheduled || now < rule->retention_next_ns) {
+        return false;
+    }
+    g_assert(node_json_u64(qdict_get(parameters, "interval_nanos"),
+                           &interval));
+    mask = qdict_get_str(parameters, "decay_mask");
+    mask_length = strlen(mask) / 2;
+    for (size_t byte = 0; byte < length; byte++) {
+        uint64_t offset = rule_offset + byte;
+        CrucibleRetentionCell *cell = node_memory_retention_cell(
+            rule, offset, false);
+        unsigned parsed;
+
+        g_assert(sscanf(mask + (offset % mask_length) * 2,
+                        "%2x", &parsed) == 1);
+        for (size_t bit = 0; bit < 8; bit++) {
+            uint8_t selected = 1U << bit;
+            uint64_t refreshed = cell ? cell->refresh_ns[bit] :
+                                        rule->last_exposure_ns;
+
+            if ((parsed & selected) != 0 &&
+                (!cell || (cell->decayed_mask & selected) == 0) &&
+                now >= refreshed && now - refreshed >= interval) {
+                return true;
+            }
+        }
+    }
+    return false;
+}
+
+static void node_memory_retention_recompute(
+    QemuCrucibleFaultRule *rule, QDict *parameters)
+{
+    GHashTableIter iter;
+    gpointer key, value;
+    uint64_t interval;
+    uint64_t next = UINT64_MAX;
+    const char *mask;
+    size_t mask_length;
+
+    g_assert(node_json_u64(qdict_get(parameters, "interval_nanos"),
+                           &interval));
+    mask = qdict_get_str(parameters, "decay_mask");
+    mask_length = strlen(mask) / 2;
+    if (rule->retention_cells) {
+        g_hash_table_iter_init(&iter, rule->retention_cells);
+        while (g_hash_table_iter_next(&iter, &key, &value)) {
+            uint64_t offset = *(uint64_t *)key;
+            CrucibleRetentionCell *cell = value;
+            unsigned parsed;
+
+            g_assert(sscanf(mask + (offset % mask_length) * 2,
+                            "%2x", &parsed) == 1);
+            for (size_t bit = 0; bit < 8; bit++) {
+                uint8_t selected = 1U << bit;
+                uint64_t due;
+
+                if ((parsed & selected) == 0 ||
+                    (cell->decayed_mask & selected) != 0) {
+                    continue;
+                }
+                due = cell->refresh_ns[bit] > UINT64_MAX - interval ?
+                    UINT64_MAX : cell->refresh_ns[bit] + interval;
+                next = MIN(next, due);
+            }
+        }
+    }
+    rule->retention_next_ns = next;
+    rule->retention_scheduled = next != UINT64_MAX;
+}
+
+typedef struct CrucibleRetentionBoundaryCount {
+    QemuCrucibleFaultRule *first;
+    QemuCrucibleFaultRule *counter_exhausted;
+    QemuCrucibleFaultRule *cells_exhausted;
+    uint64_t cells_current;
+    uint64_t cells_requested;
+    size_t events;
+    uint64_t now;
+} CrucibleRetentionBoundaryCount;
+
+static bool node_memory_retention_rule(QemuCrucibleFaultRule *rule,
+                                       uint64_t *start, uint64_t *length,
+                                       QDict **parameters)
+{
+    uint32_t kind;
+    QDict *process;
+
+    if (!node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P3, &kind) ||
+        kind != 2 || !node_rule_memory_range(rule, start, length)) {
+        return false;
+    }
+    process = qobject_to(
+        QDict, node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P4)->json);
+    *parameters = qdict_get_qdict(process, "parameters");
+    return true;
+}
+
+static void node_memory_retention_boundary_count(
+    const QemuCrucibleFaultRule *const_rule, void *opaque)
+{
+    CrucibleRetentionBoundaryCount *count = opaque;
+    QemuCrucibleFaultRule *rule = (QemuCrucibleFaultRule *)const_rule;
+    QDict *parameters;
+    uint64_t start, length, offset = 0, chunks = 0;
+    uint64_t existing;
+    uint64_t reserved_new = 0;
+    uint64_t new_cells = 0;
+
+    if (!node_memory_retention_rule(rule, &start, &length, &parameters)) {
+        return;
+    }
+    existing = rule->retention_cells ?
+        g_hash_table_size(rule->retention_cells) : 0;
+    CrucibleMemoryReservedRetention *reserved_retention =
+        node_memory_reserved_retention_set(rule, false);
+
+    if (reserved_retention) {
+        GHashTableIter iter;
+        gpointer offset_key;
+
+        g_hash_table_iter_init(&iter, reserved_retention->offsets);
+        while (g_hash_table_iter_next(&iter, &offset_key, NULL)) {
+            if (!rule->retention_cells ||
+                !g_hash_table_contains(rule->retention_cells, offset_key)) {
+                reserved_new++;
+            }
+        }
+    }
+    while (offset != length) {
+        uint64_t physical, available;
+        uint64_t part;
+
+        if (!node_rule_physical_span(rule, offset, &physical, &available) ||
+            available == 0) {
+            chunks = CRUCIBLE_NODE_EVENT_CAPACITY;
+            break;
+        }
+        part = MIN((uint64_t)4096, MIN(available, length - offset));
+        if (node_memory_retention_chunk_due(
+                rule, parameters, offset, part, count->now)) {
+            chunks++;
+            for (uint64_t byte = 0; byte < part; byte++) {
+                uint64_t cell_offset = offset + byte;
+
+                if ((!rule->retention_cells ||
+                     !g_hash_table_contains(rule->retention_cells,
+                                            &cell_offset)) &&
+                    node_memory_reserved_retention_count(
+                        rule, cell_offset) == 0 &&
+                    node_memory_retention_chunk_due(
+                        rule, parameters, cell_offset, 1, count->now)) {
+                    new_cells++;
+                }
+            }
+        }
+        offset += part;
+    }
+    if (chunks == 0 && rule->retention_scheduled &&
+        count->now >= rule->retention_next_ns) {
+        node_memory_retention_recompute(rule, parameters);
+    }
+    if (chunks == 0) {
+        return;
+    }
+    if (!count->counter_exhausted &&
+        !node_memory_rule_resources_ready(rule)) {
+        count->counter_exhausted = rule;
+    }
+    if (!count->cells_exhausted &&
+        (reserved_new > CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT - existing ||
+         new_cells > CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT - existing -
+             MIN(reserved_new,
+                 CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT - existing))) {
+        count->cells_exhausted = rule;
+        count->cells_current = existing + MIN(
+            reserved_new, CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT - existing);
+        count->cells_requested = new_cells;
+    }
+    if (!count->first) {
+        count->first = rule;
+    }
+    if (chunks > CRUCIBLE_NODE_EVENT_CAPACITY ||
+        count->events > CRUCIBLE_NODE_EVENT_CAPACITY - chunks) {
+        count->events = CRUCIBLE_NODE_EVENT_CAPACITY;
+    } else {
+        count->events += chunks;
+    }
+}
+
+static void node_memory_boundary_match(QemuCrucibleFaultRule *rule,
+                                       uint64_t access_sequence)
+{
+    uint8_t material[40];
+
+    crucible_memory_current_access = access_sequence;
+    crucible_memory_current_match_count = 1;
+    memcpy(material, rule->binding_hash, sizeof(rule->binding_hash));
+    stq_le_p(material + 32, rule->generation);
+    node_memory_sha256(material, sizeof(material),
+                       crucible_memory_current_match_hash);
+}
+
+static void node_memory_boundary_match_done(void)
+{
+    crucible_memory_current_access = 0;
+    crucible_memory_current_match_count = 0;
+    memset(crucible_memory_current_match_hash, 0,
+           sizeof(crucible_memory_current_match_hash));
+    node_memory_event_span(0, 0);
+}
+
+typedef struct CrucibleRetentionBoundaryApply {
+    uint64_t observed_icount;
+} CrucibleRetentionBoundaryApply;
+
+static void node_memory_retention_boundary_apply(
+    const QemuCrucibleFaultRule *const_rule, void *opaque)
+{
+    CrucibleRetentionBoundaryApply *apply = opaque;
+    QemuCrucibleFaultRule *rule = (QemuCrucibleFaultRule *)const_rule;
+    QDict *parameters;
+    uint64_t start, length, offset = 0;
+    uint64_t now = node_virtual_now();
+    uint32_t vcpu;
+    bool has_vcpu;
+    bool applied_counted = false;
+    bool opportunity_counted = false;
+
+    if (!node_memory_retention_rule(rule, &start, &length, &parameters)) {
+        return;
+    }
+    g_assert(node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_T3, &has_vcpu));
+    g_assert(node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_T4, &vcpu));
+    while (offset != length) {
+        uint64_t physical, available;
+        size_t part = MIN((uint64_t)4096, length - offset);
+        bool changed;
+
+        g_assert(node_rule_physical_span(rule, offset, &physical,
+                                         &available));
+        part = MIN((uint64_t)part, available);
+        if (!node_memory_retention_chunk_due(
+                rule, parameters, offset, part, now)) {
+            offset += part;
+            continue;
+        }
+        if (!opportunity_counted) {
+            node_memory_state_opportunity(rule);
+            opportunity_counted = true;
+        }
+        g_assert(crucible_memory_access_sequence != UINT64_MAX);
+        node_memory_boundary_match(rule, ++crucible_memory_access_sequence);
+        node_memory_event_span(0, part);
+        node_memory_mutation_evidence_reset(rule);
+        changed = node_memory_apply_retention(
+            rule, parameters, offset, NULL, part, now);
+        if (changed && !applied_counted) {
+            node_memory_state_applied(rule);
+            applied_counted = true;
+        }
+        g_assert(changed);
+        node_memory_event(
+            rule, CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED,
+            QEMU_CRUCIBLE_MEMORY_BOUNDARY,
+            has_vcpu ? vcpu : UINT32_MAX,
+            has_vcpu ? start + offset : physical, physical,
+            NULL, NULL, part, apply->observed_icount);
+        node_memory_boundary_match_done();
+        offset += part;
+    }
+    node_memory_retention_recompute(rule, parameters);
+}
+
+static void node_memory_retention_boundary(uint16_t phase,
+                                           uint64_t observed_icount)
+{
+    CrucibleRetentionBoundaryCount count = { .now = node_virtual_now() };
+    CrucibleRetentionBoundaryApply apply = { observed_icount };
+    uint64_t start, length;
+    QDict *parameters;
+
+    if (phase != CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY ||
+        crucible_memory_matches_in_use ||
+        !qemu_crucible_fault_memory_rules_active()) {
+        return;
+    }
+    qemu_crucible_fault_rule_foreach(
+        CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE,
+        node_memory_retention_boundary_count, &count);
+    if (!count.first || count.events == 0) {
+        node_memory_retention_deadline_recompute();
+        return;
+    }
+    if (count.counter_exhausted) {
+        node_memory_counter_terminal_metadata(UINT64_MAX);
+        g_assert(node_memory_retention_rule(
+            count.counter_exhausted, &start, &length, &parameters));
+        node_memory_boundary_match(count.counter_exhausted,
+                                   crucible_memory_access_sequence);
+        node_memory_resource_terminal(
+            count.counter_exhausted, QEMU_CRUCIBLE_MEMORY_BOUNDARY,
+            UINT32_MAX, start, start, length, observed_icount);
+        node_memory_boundary_match_done();
+        return;
+    }
+    if (count.cells_exhausted) {
+        node_memory_resource_terminal_metadata(
+            CRUCIBLE_NODE_RESOURCE_PERSISTENT_CELLS,
+            count.cells_current, count.cells_requested,
+            CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT,
+            CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT);
+        g_assert(node_memory_retention_rule(
+            count.cells_exhausted, &start, &length, &parameters));
+        node_memory_boundary_match(count.cells_exhausted,
+                                   crucible_memory_access_sequence);
+        node_memory_resource_terminal(
+            count.cells_exhausted, QEMU_CRUCIBLE_MEMORY_BOUNDARY,
+            UINT32_MAX, start, start, length, observed_icount);
+        node_memory_boundary_match_done();
+        return;
+    }
+    g_assert(node_memory_retention_rule(
+        count.first, &start, &length, &parameters));
+    node_memory_boundary_match(count.first, crucible_memory_access_sequence);
+    if (count.events > UINT64_MAX - crucible_memory_access_sequence) {
+        node_memory_resource_terminal_metadata(
+            CRUCIBLE_NODE_RESOURCE_COUNTER,
+            crucible_memory_access_sequence, count.events,
+            UINT64_MAX, UINT64_MAX);
+        node_memory_resource_terminal(
+            count.first, QEMU_CRUCIBLE_MEMORY_BOUNDARY, UINT32_MAX,
+            start, start, length, observed_icount);
+        node_memory_boundary_match_done();
+        return;
+    }
+    if (!node_memory_event_capacity(
+            count.first, count.events, QEMU_CRUCIBLE_MEMORY_BOUNDARY,
+            UINT32_MAX, start, start, length, observed_icount)) {
+        node_memory_boundary_match_done();
+        return;
+    }
+    node_memory_boundary_match_done();
+    qemu_crucible_fault_rule_foreach(
+        CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE,
+        node_memory_retention_boundary_apply, &apply);
+    node_memory_retention_deadline_recompute();
+}
+
+static void node_memory_retention_deadline_visit(
+    const QemuCrucibleFaultRule *const_rule, void *opaque)
+{
+    QemuCrucibleFaultRule *rule = (QemuCrucibleFaultRule *)const_rule;
+    uint64_t *next = opaque;
+    uint64_t start, length;
+    QDict *parameters;
+
+    if (node_memory_retention_rule(rule, &start, &length, &parameters) &&
+        rule->retention_scheduled) {
+        *next = MIN(*next, rule->retention_next_ns);
+    }
+}
+
+static void node_memory_retention_deadline_recompute(void)
+{
+    uint64_t next = UINT64_MAX;
+
+    qemu_crucible_fault_rule_foreach(
+        CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE,
+        node_memory_retention_deadline_visit, &next);
+    crucible_memory_retention_next_ns = next;
+}
+
+static uint64_t node_memory_retention_deadline(uint16_t phase)
+{
+    if (phase != CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY ||
+        crucible_memory_matches_in_use ||
+        !qemu_crucible_fault_memory_rules_active()) {
+        return UINT64_MAX;
+    }
+    return crucible_memory_retention_next_ns;
+}
+
+static bool node_memory_refresh_retention(QemuCrucibleFaultRule *rule,
+                                          uint64_t rule_offset,
+                                          const uint8_t *commit_mask,
+                                          size_t length, uint64_t now)
+{
+    bool refreshed_any = false;
+    QDict *process = qobject_to(
+        QDict, node_field(rule,
+            CRUCIBLE_NODE_FAULT_FIELD_P4)->json);
+    QDict *parameters = qdict_get_qdict(process, "parameters");
+    uint64_t interval;
+
+    g_assert(node_json_u64(qdict_get(parameters, "interval_nanos"),
+                           &interval));
+
+    if (!rule->exposure_initialized) {
+        rule->last_exposure_ns = now;
+        rule->exposure_initialized = true;
+    }
+    for (size_t byte = 0; byte < length; byte++) {
+        uint8_t refreshed = commit_mask ? commit_mask[byte] : UINT8_MAX;
+        CrucibleRetentionCell *cell;
+
+        if (refreshed == 0) {
+            continue;
+        }
+        cell = node_memory_retention_cell(rule, rule_offset + byte, true);
+        refreshed_any = true;
+
+        for (size_t bit = 0; bit < 8; bit++) {
+            uint8_t selected = 1U << bit;
+
+            if (refreshed & selected) {
+                cell->refresh_ns[bit] = now;
+                cell->decayed_mask &= ~selected;
+            }
+        }
+    }
+    if (refreshed_any && now <= UINT64_MAX - interval) {
+        uint64_t due = now + interval;
+
+        if (!rule->retention_scheduled || due < rule->retention_next_ns) {
+            rule->retention_next_ns = due;
+            rule->retention_scheduled = true;
+        }
+        crucible_memory_retention_next_ns = MIN(
+            crucible_memory_retention_next_ns, due);
+    }
+    return refreshed_any;
+}
+
+static guint node_dram_coordinate_hash(gconstpointer opaque)
+{
+    const CrucibleDramCoordinate *coordinate = opaque;
+    uint64_t mixed = coordinate->row ^
+        ((uint64_t)coordinate->channel << 48) ^
+        ((uint64_t)coordinate->rank << 32) ^
+        ((uint64_t)coordinate->bank << 16);
+
+    return mixed ^ (mixed >> 32);
+}
+
+static gboolean node_dram_coordinate_equal(gconstpointer left,
+                                           gconstpointer right)
+{
+    return memcmp(left, right, sizeof(CrucibleDramCoordinate)) == 0;
+}
+
+static CrucibleDramCoordinate node_dram_coordinate(uint64_t gpa,
+                                                    uint64_t row_bytes)
+{
+    uint64_t line = gpa / CRUCIBLE_DRAM_INTERLEAVE_BYTES;
+    uint64_t byte = gpa % CRUCIBLE_DRAM_INTERLEAVE_BYTES;
+    CrucibleDramCoordinate coordinate = { 0 };
+
+    coordinate.channel = line % CRUCIBLE_DRAM_CHANNELS;
+    line /= CRUCIBLE_DRAM_CHANNELS;
+    coordinate.bank = line % CRUCIBLE_DRAM_BANKS;
+    line /= CRUCIBLE_DRAM_BANKS;
+    coordinate.rank = line % CRUCIBLE_DRAM_RANKS;
+    line /= CRUCIBLE_DRAM_RANKS;
+    coordinate.row = (line * CRUCIBLE_DRAM_INTERLEAVE_BYTES + byte) /
+                     row_bytes;
+    return coordinate;
+}
+
+static bool node_dram_physical(const CrucibleDramCoordinate *coordinate,
+                               uint64_t row_bytes, uint64_t column,
+                               uint64_t *physical)
+{
+    uint64_t bank_byte;
+    uint64_t line;
+    uint64_t byte;
+
+    if (coordinate->row > UINT64_MAX / row_bytes) {
+        return false;
+    }
+    bank_byte = coordinate->row * row_bytes;
+    if (column > UINT64_MAX - bank_byte) {
+        return false;
+    }
+    bank_byte += column;
+    line = bank_byte / CRUCIBLE_DRAM_INTERLEAVE_BYTES;
+    byte = bank_byte % CRUCIBLE_DRAM_INTERLEAVE_BYTES;
+
+    if (line > (UINT64_MAX - coordinate->rank) /
+               CRUCIBLE_DRAM_RANKS) {
+        return false;
+    }
+    line = line * CRUCIBLE_DRAM_RANKS + coordinate->rank;
+    if (line > (UINT64_MAX - coordinate->bank) /
+               CRUCIBLE_DRAM_BANKS) {
+        return false;
+    }
+    line = line * CRUCIBLE_DRAM_BANKS + coordinate->bank;
+    if (line > (UINT64_MAX - coordinate->channel) /
+               CRUCIBLE_DRAM_CHANNELS) {
+        return false;
+    }
+    line = line * CRUCIBLE_DRAM_CHANNELS + coordinate->channel;
+    if (line > (UINT64_MAX - byte) /
+               CRUCIBLE_DRAM_INTERLEAVE_BYTES) {
+        return false;
+    }
+    *physical = line * CRUCIBLE_DRAM_INTERLEAVE_BYTES + byte;
+    return true;
+}
+
+static bool node_rule_offset_for_gpa(QemuCrucibleFaultRule *rule,
+                                     uint64_t gpa, uint64_t *rule_offset)
+{
+    uint64_t start, length;
+    bool has_vcpu;
+
+    if (!node_rule_memory_range(rule, &start, &length) ||
+        !node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_T3, &has_vcpu)) {
+        return false;
+    }
+    if (!has_vcpu) {
+        if (gpa < start || gpa - start >= length) {
+            return false;
+        }
+        *rule_offset = gpa - start;
+        return true;
+    }
+    for (guint i = 0; i < rule->translations->len; i++) {
+        CrucibleNodeTranslation *translation = &g_array_index(
+            rule->translations, CrucibleNodeTranslation, i);
+        uint64_t covered_start = MAX(start, translation->virtual_page);
+        uint64_t physical_start = translation->physical_page +
+                                  (covered_start - translation->virtual_page);
+
+        if (gpa >= physical_start &&
+            gpa - physical_start < translation->covered_bytes) {
+            uint64_t logical = covered_start +
+                               (gpa - physical_start);
+
+            if (logical >= start && logical - start < length) {
+                *rule_offset = logical - start;
+                return true;
+            }
+        }
+    }
+    return false;
+}
+
+static bool node_memory_disturb_dram_row(
+    QemuCrucibleFaultRule *rule, const CrucibleDramCoordinate *victim,
+    uint64_t row_bytes, const char *mask)
+{
+    bool changed = false;
+
+    for (uint64_t column = 0; column < row_bytes;) {
+        uint64_t bank_byte_mod =
+            ((victim->row % CRUCIBLE_DRAM_INTERLEAVE_BYTES) *
+             (row_bytes % CRUCIBLE_DRAM_INTERLEAVE_BYTES) +
+             column % CRUCIBLE_DRAM_INTERLEAVE_BYTES) %
+            CRUCIBLE_DRAM_INTERLEAVE_BYTES;
+        uint64_t physical;
+        uint64_t rule_offset;
+        uint64_t line_available = CRUCIBLE_DRAM_INTERLEAVE_BYTES -
+            bank_byte_mod;
+        uint64_t length = MIN(line_available, row_bytes - column);
+
+        if (!node_dram_physical(victim, row_bytes, column, &physical)) {
+            return changed;
+        }
+        if (node_rule_offset_for_gpa(rule, physical, &rule_offset)) {
+            uint64_t mapped_physical, available;
+
+            g_assert(node_rule_physical_span(
+                rule, rule_offset, &mapped_physical, &available));
+            if (mapped_physical != physical) {
+                column += length;
+                continue;
+            }
+            length = MIN(length, available);
+            node_memory_mutate_range(rule, rule_offset, length, mask, false);
+            changed = true;
+        }
+        column += length;
+    }
+    return changed;
+}
+
+static void node_memory_apply_rowhammer_row(
+    QemuCrucibleFaultRule *rule, QDict *parameters,
+    const CrucibleDramCoordinate *aggressor, uint64_t row_bytes,
+    uint64_t threshold, uint64_t victim_distance)
+{
+    uint64_t *count;
+
+    if (!rule->row_counters) {
+        rule->row_counters = g_hash_table_new_full(
+            node_dram_coordinate_hash, node_dram_coordinate_equal,
+            g_free, g_free);
+    }
+    count = g_hash_table_lookup(rule->row_counters, aggressor);
+    if (!count) {
+        CrucibleDramCoordinate *key;
+
+        g_assert(g_hash_table_size(rule->row_counters) <
+                 CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT);
+        key = g_memdup2(aggressor, sizeof(*aggressor));
+        count = g_new0(uint64_t, 1);
+        g_hash_table_insert(rule->row_counters, key, count);
+    }
+    g_assert(*count != UINT64_MAX);
+    rule->evidence_aggressor = *aggressor;
+    rule->evidence_counter_before = *count;
+    (*count)++;
+    rule->evidence_counter_after = *count;
+    node_memory_counter_evidence_add(
+        rule, aggressor, rule->evidence_counter_before,
+        rule->evidence_counter_after);
+    if (*count % threshold != 0) {
+        return;
+    }
+    for (unsigned direction = 0; direction < 2; direction++) {
+        CrucibleDramCoordinate victim = *aggressor;
+
+        if (direction == 0) {
+            if (victim.row < victim_distance) {
+                continue;
+            }
+            victim.row -= victim_distance;
+        } else {
+            if (victim.row > UINT64_MAX - victim_distance) {
+                continue;
+            }
+            victim.row += victim_distance;
+        }
+        if (node_memory_disturb_dram_row(
+                rule, &victim, row_bytes,
+                qdict_get_str(parameters, "flip_mask"))) {
+            rule->evidence_victim_rows++;
+        }
+    }
+}
+
+static bool node_memory_apply_rowhammer(QemuCrucibleFaultRule *rule,
+                                        QDict *parameters,
+                                        uint64_t rule_offset,
+                                        size_t selected)
+{
+    g_autoptr(GHashTable) local_seen = NULL;
+    GHashTable *seen;
+    uint64_t row_bytes, threshold, victim_distance;
+    uint64_t current = rule_offset;
+    uint64_t remaining = selected;
+
+    g_assert(selected != 0 && rule_offset <= UINT64_MAX - selected);
+    g_assert(node_json_u64(qdict_get(parameters, "row_bytes"), &row_bytes));
+    g_assert(node_json_u64(qdict_get(parameters, "threshold"), &threshold));
+    g_assert(node_json_u64(qdict_get(parameters, "victim_distance"),
+                           &victim_distance));
+    if (crucible_memory_transaction.active) {
+        if (!crucible_memory_transaction_rows) {
+            crucible_memory_transaction_rows = g_hash_table_new_full(
+                g_direct_hash, g_direct_equal, NULL,
+                (GDestroyNotify)g_hash_table_unref);
+        }
+        seen = g_hash_table_lookup(crucible_memory_transaction_rows, rule);
+        if (!seen) {
+            seen = g_hash_table_new_full(
+                node_dram_coordinate_hash, node_dram_coordinate_equal,
+                g_free, NULL);
+            g_hash_table_insert(crucible_memory_transaction_rows, rule,
+                                seen);
+        }
+    } else {
+        local_seen = g_hash_table_new_full(
+            node_dram_coordinate_hash, node_dram_coordinate_equal,
+            g_free, NULL);
+        seen = local_seen;
+    }
+    rule->evidence_victim_rows = 0;
+    while (remaining != 0) {
+        uint64_t physical, available;
+        uint64_t part;
+
+        g_assert(node_rule_physical_span(rule, current, &physical,
+                                         &available));
+        part = MIN(remaining, available);
+        for (uint64_t byte = 0; byte < part; byte++) {
+            CrucibleDramCoordinate coordinate = node_dram_coordinate(
+                physical + byte, row_bytes);
+
+            if (!g_hash_table_contains(seen, &coordinate)) {
+                CrucibleDramCoordinate *key = g_memdup2(
+                    &coordinate, sizeof(coordinate));
+
+                g_hash_table_add(seen, key);
+                node_memory_apply_rowhammer_row(
+                    rule, parameters, &coordinate, row_bytes, threshold,
+                    victim_distance);
+            }
+        }
+        current += part;
+        remaining -= part;
+    }
+    return rule->evidence_mutation_count != 0;
+}
+
+static bool node_memory_rowhammer_resources_ready(
+    QemuCrucibleFaultRule *rule, QDict *parameters,
+    uint64_t rule_offset, size_t selected)
+{
+    g_autoptr(GHashTable) local_seen = g_hash_table_new_full(
+        node_dram_coordinate_hash, node_dram_coordinate_equal,
+        g_free, NULL);
+    GHashTable *transaction_seen = NULL;
+    uint64_t row_bytes;
+    uint64_t current = rule_offset;
+    uint64_t remaining = selected;
+    uint64_t new_counters = 0;
+    uint64_t existing = rule->row_counters ?
+        g_hash_table_size(rule->row_counters) : 0;
+    CrucibleMemoryReservedRows *reserved_rows =
+        node_memory_reserved_row_set(rule, false);
+    uint64_t reserved_new = 0;
+
+    g_assert(existing <= CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT);
+    if (reserved_rows) {
+        GHashTableIter reserved_iter;
+        gpointer reserved_key;
+
+        g_hash_table_iter_init(&reserved_iter, reserved_rows->coordinates);
+        while (g_hash_table_iter_next(&reserved_iter, &reserved_key, NULL)) {
+            if (!rule->row_counters ||
+                !g_hash_table_contains(rule->row_counters, reserved_key)) {
+                reserved_new++;
+            }
+        }
+    }
+    g_assert(node_json_u64(qdict_get(parameters, "row_bytes"),
+                           &row_bytes));
+    if (crucible_memory_transaction.active &&
+        crucible_memory_transaction_rows) {
+        transaction_seen = g_hash_table_lookup(
+            crucible_memory_transaction_rows, rule);
+    }
+    while (remaining != 0) {
+        uint64_t physical, available;
+        uint64_t part;
+
+        g_assert(node_rule_physical_span(rule, current, &physical,
+                                         &available));
+        part = MIN(remaining, available);
+        for (uint64_t byte = 0; byte < part; byte++) {
+            CrucibleDramCoordinate coordinate = node_dram_coordinate(
+                physical + byte, row_bytes);
+            uint64_t *counter;
+
+            if (g_hash_table_contains(local_seen, &coordinate)) {
+                continue;
+            }
+            g_hash_table_add(local_seen,
+                             g_memdup2(&coordinate, sizeof(coordinate)));
+            if (transaction_seen &&
+                g_hash_table_contains(transaction_seen, &coordinate)) {
+                continue;
+            }
+            counter = rule->row_counters ?
+                g_hash_table_lookup(rule->row_counters, &coordinate) :
+                NULL;
+            uint64_t reserved = node_memory_reserved_row_count(
+                rule, &coordinate);
+            uint64_t current = counter ? *counter : 0;
+
+            if (reserved == UINT64_MAX ||
+                current > UINT64_MAX - reserved - 1) {
+                node_memory_counter_terminal_metadata(current + reserved);
+                return false;
+            }
+            if (!counter && reserved == 0) {
+                new_counters++;
+            }
+        }
+        current += part;
+        remaining -= part;
+    }
+    if (reserved_new > CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT - existing ||
+        new_counters > CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT - existing -
+            reserved_new) {
+        node_memory_resource_terminal_metadata(
+            CRUCIBLE_NODE_RESOURCE_PERSISTENT_CELLS,
+            existing + MIN(reserved_new,
+                           CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT - existing),
+            new_counters, CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT,
+            CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT);
+        return false;
+    }
+    return true;
+}
