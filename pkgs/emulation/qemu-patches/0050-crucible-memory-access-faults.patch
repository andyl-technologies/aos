+static __thread unsigned crucible_dma_depth;
+static __thread bool crucible_dma_write;
+static __thread MemTxAttrs crucible_dma_attrs;
+static __thread uint8_t crucible_dma_device_identity[32];
+static __thread bool crucible_dma_device_identified;
+
+static bool crucible_dma_identity_nonzero(const uint8_t identity[32])
+{
+    uint8_t combined = 0;
+
+    for (size_t i = 0; i < 32; i++) {
+        combined |= identity[i];
+    }
+    return combined != 0;
+}
+
+void qemu_crucible_fault_dma_enter(bool is_write, MemTxAttrs attrs,
+                                   const uint8_t device_identity[32])
+{
+    if (crucible_dma_depth++ == 0) {
+        crucible_dma_write = is_write;
+        crucible_dma_attrs = attrs;
+        crucible_dma_device_identified = device_identity &&
+            crucible_dma_identity_nonzero(device_identity);
+        if (device_identity) {
+            memcpy(crucible_dma_device_identity, device_identity,
+                   sizeof(crucible_dma_device_identity));
+        } else {
+            memset(crucible_dma_device_identity, 0,
+                   sizeof(crucible_dma_device_identity));
+        }
+    }
+}
+
+void qemu_crucible_fault_dma_leave(void)
+{
+    g_assert(crucible_dma_depth != 0);
+    crucible_dma_depth--;
+}
+
+bool qemu_crucible_fault_dma_context_active(void)
+{
+    return crucible_dma_depth != 0 &&
+           qemu_crucible_fault_memory_dma_rules_active(
+               crucible_dma_write);
+}
+
+bool qemu_crucible_fault_dma_identity(uint8_t device_identity[32])
+{
+    if (crucible_dma_depth == 0 || !crucible_dma_device_identified) {
+        memset(device_identity, 0, 32);
+        return false;
+    }
+    memcpy(device_identity, crucible_dma_device_identity, 32);
+    return true;
+}
+
+static bool crucible_dma_fault_active(bool is_write)
+{
+    enum QemuCrucibleMemoryAccessClass access_class = is_write ?
+        QEMU_CRUCIBLE_MEMORY_DMA_WRITE : QEMU_CRUCIBLE_MEMORY_DMA_READ;
+
+    return crucible_dma_depth != 0 && crucible_dma_write == is_write &&
+           (qemu_crucible_fault_memory_transaction_active(access_class) ||
+            qemu_crucible_fault_memory_dma_rules_active(is_write));
+}
+
+static uint32_t crucible_dma_actor_id(void)
+{
+    if (crucible_dma_device_identified) {
+        return ldl_le_p(crucible_dma_device_identity);
+    }
+    return crucible_dma_attrs.unspecified ? UINT32_MAX :
+                                            crucible_dma_attrs.requester_id;
+}
