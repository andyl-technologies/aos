+int qemu_plugin_crucible_fault_event_peek(
+    struct qemu_plugin_crucible_fault_event *event, size_t *payload_length)
+{
+    CrucibleNodeEvent *queued;
+
+    if (!event || !payload_length) {
+        return -EINVAL;
+    }
+    node_events_ensure();
+    queued = QTAILQ_FIRST(&crucible_node_events);
+    if (!queued) {
+        return 0;
