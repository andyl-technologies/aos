+typedef bool (*NodeJsonValidator)(const QObject *object);
+
+static bool node_policy_parse(CrucibleNodeField *field,
+                              NodeJsonValidator validator)
+{
+    const size_t magic_len = CRUCIBLE_NODE_FAULT_POLICY_JSON_MAGIC_V1_BYTES;
+    g_autofree char *text = NULL;
+    Error *error = NULL;
+    QObject *object;
+
+    if (!field || field->type != CRUCIBLE_NODE_FAULT_FIELD_TYPE_BYTES ||
+        field->length <= magic_len ||
+        memcmp(field->data, CRUCIBLE_NODE_FAULT_POLICY_JSON_MAGIC_V1,
+               magic_len) != 0 ||
+        !node_json_canonical(field->data + magic_len,
+                             field->length - magic_len)) {
+        return false;
+    }
+    text = g_strndup((const char *)field->data + magic_len,
+                     field->length - magic_len);
+    object = qobject_from_json(text, &error);
+    if (!object || error || !validator(object)) {
+        error_free(error);
+        qobject_unref(object);
+        return false;
+    }
+    field->json = object;
+    return true;
+}
