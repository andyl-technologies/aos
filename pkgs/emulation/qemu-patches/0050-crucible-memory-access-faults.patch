+static void node_memory_service_ledger_release(
+    CrucibleMemoryServiceLedger *ledger)
+{
+    if (!ledger) {
+        return;
+    }
+    g_assert(ledger->references != 0);
+    if (--ledger->references == 0) {
+        g_assert(crucible_memory_service_ledgers);
+        g_assert(g_hash_table_remove(crucible_memory_service_ledgers,
+                                   ledger->key));
+    }
+}
+
+static char *node_memory_service_ledger_key(QemuCrucibleFaultRule *rule)
+{
+    CrucibleNodeField *field = node_field(
+        rule, CRUCIBLE_NODE_FAULT_FIELD_P6);
+    QDict *scope;
+    const char *kind;
+    uint64_t start, length;
+    uint32_t vcpu;
+    bool has_vcpu;
+
+    if (!field || !node_rule_memory_range(rule, &start, &length) ||
+        !node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_T3, &has_vcpu) ||
+        !node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_T4, &vcpu)) {
+        return NULL;
+    }
+    scope = qobject_to(QDict, field->json);
+    kind = scope ? qdict_get_try_str(scope, "kind") : NULL;
+    if (!kind) {
+        return NULL;
+    }
+    if (strcmp(kind, "node") == 0) {
+        return g_strdup("node");
+    }
+    if (strcmp(kind, "range") == 0) {
+        return g_strdup_printf("range:%u:%u:%016" PRIx64 ":%016" PRIx64,
+                               has_vcpu, vcpu, start, length);
+    }
+    if (strcmp(kind, "controller") == 0) {
+        const char *controller = qdict_get_try_str(scope, "parameters");
+
+        return controller ? g_strdup_printf("controller:%s", controller) :
+                            NULL;
+    }
+    return NULL;
+}
+
+static bool node_memory_service_ledger_acquire(QemuCrucibleFaultRule *rule)
+{
+    g_autofree char *key = NULL;
+    CrucibleMemoryServiceLedger *ledger;
+
+    if (rule->command_kind != CRUCIBLE_FAULT_COMMAND_MEMORY_SERVICE) {
+        return true;
+    }
+    key = node_memory_service_ledger_key(rule);
+    if (!key) {
+        return false;
+    }
+    if (!crucible_memory_service_ledgers) {
+        crucible_memory_service_ledgers = g_hash_table_new_full(
+            g_str_hash, g_str_equal, NULL, node_memory_service_ledger_free);
+    }
+    ledger = g_hash_table_lookup(crucible_memory_service_ledgers, key);
+    if (!ledger) {
+        ledger = g_new0(CrucibleMemoryServiceLedger, 1);
+        ledger->key = g_steal_pointer(&key);
+        g_hash_table_insert(crucible_memory_service_ledgers,
+                            ledger->key, ledger);
+    }
+    g_assert(ledger->references != UINT32_MAX);
+    ledger->references++;
+    rule->service_ledger = ledger;
+    return true;
+}
+
+static bool node_memory_persistent_counter_demand(
+    QemuCrucibleFaultRule *rule, uint64_t *demand)
+{
+    uint64_t start, length;
+    uint32_t kind;
+
+    *demand = 0;
+    if (rule->command_kind != CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE ||
+        !node_rule_memory_range(rule, &start, &length) ||
+        !node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P3, &kind)) {
+        return true;
+    }
+    if (kind == 2) {
+        *demand = length;
+        return true;
+    }
+    if (kind == 3) {
+        /* A byte can select a distinct interleaved DRAM coordinate. */
+        *demand = length;
+    }
+    return true;
+}
+
+static bool node_memory_rule_admissible(QemuCrucibleFaultRule *rule)
+{
+    uint64_t start, length, end;
+    uint32_t target_vcpu;
+    bool has_vcpu;
+    size_t memory_rules = 1;
+    size_t overlaps = 1;
+    uint64_t persistent_counters;
+    const QObject *exception_object;
+
+    if (!node_rule_memory_range(rule, &start, &length) ||
+        start > UINT64_MAX - length ||
+        !node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_T3, &has_vcpu) ||
+        !node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_T4, &target_vcpu)) {
+        return false;
+    }
+    if (!node_memory_persistent_counter_demand(
+            rule, &persistent_counters) ||
+        persistent_counters > CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT) {
+        return false;
+    }
+    if (rule->command_kind ==
+            CRUCIBLE_FAULT_COMMAND_MEMORY_ACCESS_TRANSFORM) {
+        uint32_t classes;
+
+        if (!node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P8,
+                            &classes) ||
+            (has_vcpu &&
+             (classes & QEMU_CRUCIBLE_MEMORY_PAGE_TABLE_WALK) != 0)) {
+            return false;
+        }
+    }
+    exception_object = node_memory_poison_exception(rule);
+
+    if (exception_object) {
+        CPUFaultException exception;
+        CPUState *cpu;
+        bool found = false;
+
+        if (!node_exception_decode(exception_object, &exception)) {
+            return false;
+        }
+        if (rule->command_kind ==
+            CRUCIBLE_FAULT_COMMAND_MEMORY_ACCESS_TRANSFORM) {
+            uint32_t classes;
+
+            if (!node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P8,
+                                &classes)) {
+                return false;
+            }
+            if ((classes & QEMU_CRUCIBLE_MEMORY_PAGE_TABLE_WALK) != 0) {
+                return false;
+            }
+            if (exception.architecture == CPU_FAULT_EXCEPTION_AARCH64 &&
+                (((classes & QEMU_CRUCIBLE_MEMORY_FETCH) != 0 &&
+                  (classes & ~QEMU_CRUCIBLE_MEMORY_FETCH) != 0) ||
+                 ((classes & QEMU_CRUCIBLE_MEMORY_FETCH) != 0 &&
+                  exception.vector != 3) ||
+                 ((classes & QEMU_CRUCIBLE_MEMORY_FETCH) == 0 &&
+                  exception.vector != 4))) {
+                return false;
+            }
+        }
+        CPU_FOREACH(cpu) {
+            if (has_vcpu && cpu->cpu_index != target_vcpu) {
+                continue;
+            }
+            found = true;
+            if (!cpu_validate_fault_exception(cpu, &exception)) {
+                return false;
+            }
+        }
+        if (!found) {
+            return false;
+        }
+    }
+    end = start + length;
+    for (guint i = 0; i < crucible_node_rules->len; i++) {
+        QemuCrucibleFaultRule *other =
+            g_ptr_array_index(crucible_node_rules, i);
+        uint64_t other_start, other_length, other_end;
+        uint32_t other_vcpu;
+        bool other_has_vcpu;
+
+        if (other->command_kind !=
+                CRUCIBLE_FAULT_COMMAND_MEMORY_ACCESS_TRANSFORM &&
+            other->command_kind != CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE &&
+            other->command_kind != CRUCIBLE_FAULT_COMMAND_MEMORY_SERVICE) {
+            continue;
+        }
+        if (other->command_kind == rule->command_kind &&
+            memcmp(other->binding_hash, rule->binding_hash, 32) == 0) {
+            continue;
+        }
+        uint64_t other_counters;
+
+        if (!node_memory_persistent_counter_demand(
+                other, &other_counters) ||
+            other_counters > CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT ||
+            persistent_counters >
+                CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT - other_counters) {
+            return false;
+        }
+        persistent_counters += other_counters;
+        if (++memory_rules > CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT) {
+            return false;
+        }
+        if (!node_rule_memory_range(other, &other_start, &other_length) ||
+            other_start > UINT64_MAX - other_length ||
+            !node_field_bool(other, CRUCIBLE_NODE_FAULT_FIELD_T3,
+                             &other_has_vcpu) ||
+            !node_field_u32(other, CRUCIBLE_NODE_FAULT_FIELD_T4, &other_vcpu) ||
+            has_vcpu != other_has_vcpu ||
+            (has_vcpu && target_vcpu != other_vcpu)) {
+            continue;
+        }
+        other_end = other_start + other_length;
+        if (start < other_end && other_start < end) {
+            QDict *policy = node_memory_poison_policy(rule);
+            QDict *other_policy = node_memory_poison_policy(other);
+
+            if (policy && other_policy &&
+                !qobject_is_equal(QOBJECT(policy), QOBJECT(other_policy))) {
+                return false;
+            }
+            if (++overlaps > CRUCIBLE_NODE_MEMORY_MATCH_LIMIT) {
+                return false;
+            }
+        }
+    }
+    return true;
+}
+
+static void node_memory_index_finalize(GArray *index, IntervalTreeRoot *root)
+{
+    memset(root, 0, sizeof(*root));
+    for (guint i = 0; i < index->len; i++) {
+        CrucibleMemoryIndexEntry *entry = &g_array_index(
+            index, CrucibleMemoryIndexEntry, i);
+
+        interval_tree_insert(&entry->interval, root);
+    }
+}
+
+static void node_memory_index_rebuild(void)
+{
+    uint32_t prior_access_classes = crucible_memory_access_classes;
+    bool was_active =
+        (crucible_memory_gpa_index && crucible_memory_gpa_index->len != 0) ||
+        (crucible_memory_gva_index && crucible_memory_gva_index->len != 0);
+    memset(&crucible_memory_gpa_root, 0, sizeof(crucible_memory_gpa_root));
+    memset(&crucible_memory_gva_root, 0, sizeof(crucible_memory_gva_root));
+    g_clear_pointer(&crucible_memory_gpa_index, g_array_unref);
+    g_clear_pointer(&crucible_memory_gva_index, g_array_unref);
+    g_clear_pointer(&crucible_memory_binding_order, g_ptr_array_unref);
+    crucible_memory_gpa_index = g_array_new(
+        false, false, sizeof(CrucibleMemoryIndexEntry));
+    crucible_memory_gva_index = g_array_new(
+        false, false, sizeof(CrucibleMemoryIndexEntry));
+    crucible_memory_binding_order = g_ptr_array_new();
+    crucible_memory_access_classes = 0;
+    if (!crucible_memory_checksum) {
+        crucible_memory_checksum = g_checksum_new(G_CHECKSUM_SHA256);
+        if (!crucible_memory_checksum) {
+            error_report("Crucible memory evidence digest is unavailable");
+            abort();
+        }
+    }
+    for (guint i = 0; i < crucible_node_rules->len; i++) {
+        QemuCrucibleFaultRule *rule = g_ptr_array_index(crucible_node_rules, i);
+        CrucibleMemoryIndexEntry entry = { .rule = rule };
+        uint64_t length;
+        bool has_vcpu;
+        uint32_t target_vcpu;
+
+        if ((rule->command_kind !=
+                 CRUCIBLE_FAULT_COMMAND_MEMORY_ACCESS_TRANSFORM &&
+             rule->command_kind != CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE &&
+             rule->command_kind != CRUCIBLE_FAULT_COMMAND_MEMORY_SERVICE) ||
+            !node_rule_memory_range(rule, &entry.interval.start, &length) ||
+            entry.interval.start > UINT64_MAX - length ||
+            !node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_T3, &has_vcpu) ||
+            !node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_T4,
+                            &target_vcpu)) {
+            continue;
+        }
+        entry.vcpu = has_vcpu ? target_vcpu : UINT32_MAX;
+        entry.interval.last = entry.interval.start + length - 1;
+        if (crucible_memory_binding_order->len ==
+            CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT) {
+            error_report("Crucible memory rule index exceeds resource bound");
+            abort();
+        }
+        entry.rank = crucible_memory_binding_order->len;
+        if (rule->command_kind ==
+            CRUCIBLE_FAULT_COMMAND_MEMORY_ACCESS_TRANSFORM) {
+            uint32_t classes;
+
+            g_assert(node_field_u32(
+                rule, CRUCIBLE_NODE_FAULT_FIELD_P8, &classes));
+            crucible_memory_access_classes |= classes;
+        } else {
+            crucible_memory_access_classes |= 0x3fU;
+        }
+        g_ptr_array_add(crucible_memory_binding_order, rule);
+        g_array_append_val(has_vcpu ? crucible_memory_gva_index :
+                                      crucible_memory_gpa_index,
+                           entry);
+    }
+    node_memory_index_finalize(crucible_memory_gpa_index,
+                               &crucible_memory_gpa_root);
+    node_memory_index_finalize(crucible_memory_gva_index,
+                               &crucible_memory_gva_root);
+
+    bool is_active = crucible_memory_gpa_index->len != 0 ||
+                     crucible_memory_gva_index->len != 0;
+
+    if (was_active != is_active ||
+        ((prior_access_classes ^ crucible_memory_access_classes) &
+         (QEMU_CRUCIBLE_MEMORY_CPU_LOAD |
+          QEMU_CRUCIBLE_MEMORY_CPU_STORE |
+          QEMU_CRUCIBLE_MEMORY_PAGE_TABLE_WALK)) != 0) {
+        if (!current_cpu) {
+            error_report(
+                "Crucible memory rule transition has no boundary vCPU");
+            abort();
+        }
+        tlb_flush_all_cpus_synced(current_cpu);
+    }
+}
+
+static void node_memory_match_mark(uint32_t rank)
+{
+    uint32_t word = rank / 64;
+    uint32_t word_bit = rank % 64;
+    uint32_t group = word / 64;
+    uint32_t group_bit = word % 64;
+    uint32_t top = group / 64;
+    uint32_t top_bit = group % 64;
+
+    if (crucible_memory_match_bits[word] == 0) {
+        if (crucible_memory_match_words[group] == 0) {
+            crucible_memory_match_groups[top] |= UINT64_C(1) << top_bit;
+        }
+        crucible_memory_match_words[group] |= UINT64_C(1) << group_bit;
+    }
+    crucible_memory_match_bits[word] |= UINT64_C(1) << word_bit;
+}
+
+static void node_memory_index_collect(IntervalTreeRoot *root,
+                                      uint64_t address, size_t length,
+                                      uint32_t vcpu)
+{
+    uint64_t last = address + length - 1;
+    IntervalTreeNode *node;
+
+    for (node = interval_tree_iter_first(root, address, last);
+         node;
+         node = interval_tree_iter_next(node, address, last)) {
+        CrucibleMemoryIndexEntry *entry = container_of(
+            node, CrucibleMemoryIndexEntry, interval);
+
+        if (entry->vcpu == UINT32_MAX || entry->vcpu == vcpu) {
+            node_memory_match_mark(entry->rank);
+        }
+    }
+}
+
+static size_t node_memory_matches_materialize(void)
+{
+    size_t count = 0;
+    gsize digest_len = sizeof(crucible_memory_current_match_hash);
+
+    for (size_t top = 0; top < G_N_ELEMENTS(crucible_memory_match_groups);
+         top++) {
+        uint64_t groups = crucible_memory_match_groups[top];
+
+        while (groups != 0) {
+            unsigned group_bit = ctz64(groups);
+            size_t group = top * 64 + group_bit;
+            uint64_t words = crucible_memory_match_words[group];
+
+            while (words != 0) {
+                unsigned word_bit = ctz64(words);
+                size_t word = group * 64 + word_bit;
+                uint64_t matches = crucible_memory_match_bits[word];
+
+                while (matches != 0) {
+                    unsigned match_bit = ctz64(matches);
+                    size_t rank = word * 64 + match_bit;
+
+                    if (count == CRUCIBLE_NODE_MEMORY_MATCH_LIMIT) {
+                        error_report(
+                            "Crucible memory match bound was violated");
+                        abort();
+                    }
+                    QemuCrucibleFaultRule *rule = g_ptr_array_index(
+                        crucible_memory_binding_order, rank);
+                    bool has_device = false;
+                    uint8_t device_identity[32];
+
+                    if (rule->command_kind ==
+                            CRUCIBLE_FAULT_COMMAND_MEMORY_ACCESS_TRANSFORM) {
+                        g_assert(node_field_bool(
+                            rule, CRUCIBLE_NODE_FAULT_FIELD_P10,
+                            &has_device));
+                    }
+                    if (!has_device ||
+                        (qemu_crucible_fault_dma_identity(device_identity) &&
+                         memcmp(device_identity,
+                                node_field(
+                                    rule,
+                                    CRUCIBLE_NODE_FAULT_FIELD_P11)->data,
+                                sizeof(device_identity)) == 0)) {
+                        crucible_memory_matches[count++] = rule;
+                    }
+                    matches &= matches - 1;
+                }
+                crucible_memory_match_bits[word] = 0;
+                words &= words - 1;
+            }
+            crucible_memory_match_words[group] = 0;
+            groups &= groups - 1;
+        }
+        crucible_memory_match_groups[top] = 0;
+    }
+    g_checksum_reset(crucible_memory_checksum);
+    for (size_t i = 0; i < count; i++) {
+        QemuCrucibleFaultRule *rule = crucible_memory_matches[i];
+        uint8_t generation[8];
+
+        g_checksum_update(crucible_memory_checksum, rule->binding_hash,
+                          sizeof(rule->binding_hash));
+        stq_le_p(generation, rule->generation);
+        g_checksum_update(crucible_memory_checksum, generation,
+                          sizeof(generation));
+    }
+    g_checksum_get_digest(crucible_memory_checksum,
+                          crucible_memory_current_match_hash, &digest_len);
+    g_assert(digest_len == sizeof(crucible_memory_current_match_hash));
+    crucible_memory_current_match_count = count;
+    if (crucible_memory_transaction.streaming &&
+        !crucible_memory_preflight_collecting) {
+        for (size_t i = 0; i < count; i++) {
+            crucible_memory_matches[i] = node_memory_shadow_rule(
+                crucible_memory_matches[i]);
+        }
+    }
+    return count;
+}
+
+static size_t node_memory_snapshot_materialize(
+    uint32_t vcpu, uint64_t vaddr, uint64_t gpa, size_t length)
+{
+    GPtrArray *snapshot = crucible_memory_transaction.rule_snapshot;
+    gsize digest_len = sizeof(crucible_memory_current_match_hash);
+    size_t count = 0;
+
+    for (guint i = 0; snapshot && i < snapshot->len; i++) {
+        QemuCrucibleFaultRule *rule = g_ptr_array_index(snapshot, i);
+        uint64_t start, range_length, access;
+        uint32_t target_vcpu;
+        bool has_vcpu;
+
+        if (!node_rule_memory_range(rule, &start, &range_length) ||
+            !node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_T3,
+                             &has_vcpu) ||
+            !node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_T4,
+                            &target_vcpu) ||
+            (has_vcpu && target_vcpu != vcpu)) {
+            continue;
+        }
+        access = has_vcpu ? vaddr : gpa;
+        if (access > UINT64_MAX - length ||
+            start > UINT64_MAX - range_length ||
+            access >= start + range_length || start >= access + length) {
+            continue;
+        }
+        g_assert(count != CRUCIBLE_NODE_MEMORY_MATCH_LIMIT);
+        crucible_memory_matches[count++] = rule;
+    }
+    g_checksum_reset(crucible_memory_checksum);
+    for (size_t i = 0; i < count; i++) {
+        QemuCrucibleFaultRule *rule = crucible_memory_matches[i];
+        uint8_t generation[8];
+
+        g_checksum_update(crucible_memory_checksum, rule->binding_hash,
+                          sizeof(rule->binding_hash));
+        stq_le_p(generation, rule->generation);
+        g_checksum_update(crucible_memory_checksum, generation,
+                          sizeof(generation));
+    }
+    g_checksum_get_digest(crucible_memory_checksum,
+                          crucible_memory_current_match_hash, &digest_len);
+    g_assert(digest_len == sizeof(crucible_memory_current_match_hash));
+    crucible_memory_current_match_count = count;
+    if (crucible_memory_transaction.streaming &&
+        !crucible_memory_resource_planning) {
+        for (size_t i = 0; i < count; i++) {
+            crucible_memory_matches[i] = node_memory_shadow_rule(
+                crucible_memory_matches[i]);
+        }
+    }
+    return count;
+}
+
+static void node_memory_snapshot_add_current(size_t count)
+{
+    CrucibleMemoryTransaction *transaction = &crucible_memory_transaction;
+
+    if (!transaction->rule_snapshot) {
+        transaction->rule_snapshot = g_ptr_array_new_with_free_func(
+            (GDestroyNotify)node_rule_unref);
+    }
+    for (size_t i = 0; i < count; i++) {
+        QemuCrucibleFaultRule *rule = crucible_memory_matches[i];
+
+        if (!g_ptr_array_find(transaction->rule_snapshot, rule, NULL)) {
+            g_ptr_array_add(transaction->rule_snapshot,
+                            node_rule_ref(rule));
+        }
+    }
+    g_ptr_array_sort(transaction->rule_snapshot, node_rule_compare);
+}
+
+static size_t node_memory_matching_rules_at(uint32_t vcpu,
+                                            uint64_t vaddr, uint64_t gpa,
+                                            size_t length, bool include_gva,
+                                            uint64_t access_sequence)
+{
+    if (crucible_memory_matches_in_use) {
+        error_report(
+            "Concurrent Crucible memory opportunity is not deterministic");
+        abort();
+    }
+    crucible_memory_matches_in_use = true;
+    crucible_memory_current_access = access_sequence;
+    if (crucible_memory_transaction.active &&
+        crucible_memory_transaction.rule_snapshot &&
+        (!crucible_memory_preflight_collecting ||
+         crucible_memory_resource_planning)) {
+        return node_memory_snapshot_materialize(vcpu, vaddr, gpa, length);
+    }
+    if (!crucible_memory_gpa_index || length == 0 ||
+        gpa > UINT64_MAX - (length - 1) ||
+        vaddr > UINT64_MAX - (length - 1)) {
+        return node_memory_matches_materialize();
+    }
+    node_memory_index_collect(&crucible_memory_gpa_root, gpa, length,
+                              UINT32_MAX);
+    if (include_gva) {
+        node_memory_index_collect(&crucible_memory_gva_root, vaddr, length,
+                                  vcpu);
+    }
+    return node_memory_matches_materialize();
+}
+
+static size_t node_memory_matching_rules(uint32_t vcpu,
+                                         uint64_t vaddr, uint64_t gpa,
+                                         size_t length, bool include_gva)
+{
+    uint64_t identity;
+
+    if (crucible_memory_transaction.active) {
+        identity = crucible_memory_transaction.identity;
+        if (crucible_memory_transaction.fragment_ordinal == UINT32_MAX) {
+            error_report("Crucible memory fragment ordinal overflow");
+            abort();
+        }
+        crucible_memory_current_fragment =
+            crucible_memory_transaction.fragment_ordinal;
+        crucible_memory_transaction.fragment_ordinal++;
+    } else {
+        if (crucible_memory_access_sequence == UINT64_MAX) {
+            error_report("Crucible memory access sequence overflow");
+            abort();
+        }
+        identity = ++crucible_memory_access_sequence;
+    }
+    return node_memory_matching_rules_at(
+        vcpu, vaddr, gpa, length, include_gva, identity);
+}
+
+static void node_memory_matching_rules_done(void)
+{
+    g_assert(crucible_memory_matches_in_use);
+    crucible_memory_current_access = 0;
+    crucible_memory_current_match_count = 0;
+    memset(crucible_memory_current_match_hash, 0,
+           sizeof(crucible_memory_current_match_hash));
+    crucible_memory_current_event_offset = 0;
+    crucible_memory_current_event_length = 0;
+    crucible_memory_current_fragment = 0;
+    memset(crucible_memory_poison_occurs, 0,
+           sizeof(crucible_memory_poison_occurs));
+    crucible_memory_matches_in_use = false;
+}
+
+static bool node_memory_poison_preflight(
+    uint32_t access_classes, uint32_t vcpu, uint64_t vaddr, uint64_t gpa,
+    const uint8_t *before, uint8_t *value, size_t length,
+    uint64_t observed_icount, size_t match_count)
+{
+    bool failed = false;
+
+    if (crucible_memory_transaction.active &&
+        crucible_memory_transaction.poisoned) {
+        crucible_memory_transaction.poison_reported = true;
+        return true;
+    }
+
+    for (size_t i = 0; i < match_count; i++) {
+        QemuCrucibleFaultRule *rule = crucible_memory_matches[i];
+        size_t offset, selected;
+        uint64_t rule_offset;
+        uint32_t kind;
+
+        if (!node_rule_memory_overlap(rule, vcpu, vaddr, gpa, length,
+                                      &offset, &selected, &rule_offset)) {
+            continue;
+        }
+        node_memory_event_span(offset, selected);
+        if (rule->command_kind ==
+            CRUCIBLE_FAULT_COMMAND_MEMORY_ACCESS_TRANSFORM) {
+            uint32_t classes;
+            CrucibleNodeField *poison_field;
+            QDict *poison;
+            const char *poison_kind;
+
+            g_assert(node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P3,
+                                    &kind));
+            if (kind != 5 ||
+                !node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P8,
+                                &classes) ||
+                (classes & access_classes) == 0) {
+                continue;
+            }
+            if (crucible_memory_transaction.active) {
+                gpointer evaluated = g_hash_table_lookup(
+                    crucible_memory_transaction_poison, rule);
+
+                if (!evaluated &&
+                    crucible_memory_transaction.streaming) {
+                    bool occurs = node_memory_rule_occurs(
+                        rule, CRUCIBLE_NODE_FAULT_FIELD_P7);
+
+                    evaluated = GUINT_TO_POINTER(occurs ? 2 : 1);
+                    g_hash_table_insert(
+                        crucible_memory_transaction_poison,
+                        rule, evaluated);
+                }
+
+                crucible_memory_poison_occurs[i] =
+                    GPOINTER_TO_UINT(evaluated) == 2;
+            } else {
+                crucible_memory_poison_occurs[i] = node_memory_rule_occurs(
+                    rule, CRUCIBLE_NODE_FAULT_FIELD_P7);
+            }
+            if (!crucible_memory_poison_occurs[i]) {
+                continue;
+            }
+            poison_field = node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P6);
+            poison = qobject_to(QDict, poison_field->json);
+            poison_kind = qdict_get_try_str(poison, "kind");
+            if (strcmp(poison_kind, "corrected") != 0) {
+                if (crucible_memory_transaction.streaming &&
+                    strcmp(poison_kind, "exception") == 0) {
+                    CPUFaultException exception;
+
+                    g_assert(node_exception_decode(
+                        qdict_get(
+                            qdict_get_qdict(poison, "parameters"),
+                            "exception"), &exception));
+                    if (crucible_memory_transaction.has_exception &&
+                        memcmp(&crucible_memory_transaction.exception,
+                               &exception, sizeof(exception)) != 0) {
+                        error_report(
+                            "Conflicting Crucible fetch exceptions escaped staging");
+                        abort();
+                    }
+                    crucible_memory_transaction.has_exception = true;
+                    crucible_memory_transaction.exception = exception;
+                }
+                failed = true;
+                if (crucible_memory_transaction.streaming) {
+                    crucible_memory_transaction.poisoned = true;
+                }
+                node_memory_event(rule, CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR,
+                                  access_classes, vcpu, vaddr, gpa, before,
+                                  value, length, observed_icount);
+            }
+            continue;
+        }
+        if (rule->command_kind ==
+            CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE) {
+            QDict *process;
+            QDict *parameters;
+            QDict *policy;
+            const char *policy_kind;
+
+            g_assert(node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P3,
+                                    &kind));
+            if (kind != 1) {
+                continue;
+            }
+            process = qobject_to(
+                QDict, node_field(rule,
+                    CRUCIBLE_NODE_FAULT_FIELD_P4)->json);
+            parameters = qdict_get_qdict(process, "parameters");
+            policy = qdict_get_qdict(parameters, "policy");
+            policy_kind = qdict_get_str(policy, "kind");
+            if (strcmp(policy_kind, "corrected") != 0) {
+                if (crucible_memory_transaction.streaming) {
+                    gpointer evaluated = g_hash_table_lookup(
+                        crucible_memory_transaction_poison, rule);
+
+                    if (evaluated) {
+                        continue;
+                    }
+                    g_hash_table_insert(
+                        crucible_memory_transaction_poison, rule,
+                        GUINT_TO_POINTER(2));
+                    node_memory_state_opportunity(rule);
+                    node_memory_state_applied(rule);
+                    if (strcmp(policy_kind, "exception") == 0) {
+                        CPUFaultException exception;
+
+                        g_assert(node_exception_decode(
+                            qdict_get(
+                                qdict_get_qdict(policy, "parameters"),
+                                "exception"), &exception));
+                        if (crucible_memory_transaction.has_exception &&
+                            memcmp(&crucible_memory_transaction.exception,
+                                   &exception, sizeof(exception)) != 0) {
+                            error_report(
+                                "Conflicting Crucible fetch exceptions escaped staging");
+                            abort();
+                        }
+                        crucible_memory_transaction.has_exception = true;
+                        crucible_memory_transaction.exception = exception;
+                    }
+                    crucible_memory_transaction.poisoned = true;
+                }
+                failed = true;
+                node_memory_event_span(offset, selected);
+                node_memory_event(rule, CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR,
+                                  access_classes, vcpu, vaddr, gpa, before,
+                                  value, length, observed_icount);
+            }
+        }
+    }
+    return failed;
+}
+
+static void node_memory_event_span(size_t offset, size_t length)
+{
+    if (offset > UINT32_MAX || length > UINT32_MAX) {
+        error_report("Crucible memory evidence span overflow");
+        abort();
+    }
+    crucible_memory_current_event_offset = offset;
+    crucible_memory_current_event_length = length;
+}
+
+static bool node_rule_memory_overlap_internal(
+    QemuCrucibleFaultRule *rule, uint32_t vcpu, uint64_t vaddr,
+    uint64_t gpa, size_t length, size_t *offset, size_t *selected,
+    uint64_t *rule_offset, bool mark_stale)
+{
+    uint64_t start, range_length, access, access_end, range_end;
+    uint32_t target_vcpu;
+    bool has_vcpu;
+
+    if (length == 0 || !node_rule_memory_range(rule, &start, &range_length) ||
+        !node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_T3, &has_vcpu) ||
+        !node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_T4, &target_vcpu) ||
+        (has_vcpu && target_vcpu != vcpu)) {
+        return false;
+    }
+    access = has_vcpu ? vaddr : gpa;
+    if (access > UINT64_MAX - length || start > UINT64_MAX - range_length) {
+        return false;
+    }
+    access_end = access + length;
+    range_end = start + range_length;
+    if (access >= range_end || start >= access_end) {
+        return false;
+    }
+    *offset = MAX(access, start) - access;
+    *selected = MIN(access_end, range_end) - MAX(access, start);
+    *rule_offset = MAX(access, start) - start;
+    if (has_vcpu) {
+        uint64_t logical = MAX(access, start);
+        uint64_t physical = gpa + *offset;
+        uint64_t remaining = *selected;
+        CPUState *cpu = qemu_get_cpu(target_vcpu);
+
+        if (!cpu) {
+            if (mark_stale) {
+                rule->translation_stale = true;
+            }
+            return false;
+        }
+
+        for (guint i = 0; i < rule->translations->len && remaining != 0; i++) {
+            CrucibleNodeTranslation *translation = &g_array_index(
+                rule->translations, CrucibleNodeTranslation, i);
+            CPUFaultTranslation current;
+            uint64_t covered_start = MAX(start, translation->virtual_page);
+            uint64_t covered_end = covered_start + translation->covered_bytes;
+            uint64_t part;
+
+            if (logical < covered_start || logical >= covered_end) {
+                continue;
+            }
+            part = MIN(remaining, covered_end - logical);
+            if (!node_memory_translate_rule(rule, cpu, logical, &current) ||
+                physical != translation->physical_page +
+                            (logical - translation->virtual_page) ||
+                current.physical_address != physical ||
+                current.page_size != translation->page_size ||
+                memcmp(&current.attrs, &translation->attrs,
+                       sizeof(current.attrs)) != 0 ||
+                current.readable != translation->readable ||
+                current.writable != translation->writable ||
+                current.executable != translation->executable ||
+                current.user != translation->user) {
+                if (mark_stale) {
+                    rule->translation_stale = true;
+                }
+                return false;
+            }
+            logical += part;
+            physical += part;
+            remaining -= part;
+        }
+        if (remaining != 0) {
+            if (mark_stale) {
+                rule->translation_stale = true;
+            }
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool node_rule_memory_overlap(QemuCrucibleFaultRule *rule,
+                                     uint32_t vcpu, uint64_t vaddr,
+                                     uint64_t gpa, size_t length,
+                                     size_t *offset, size_t *selected,
+                                     uint64_t *rule_offset)
+{
+    return node_rule_memory_overlap_internal(
+        rule, vcpu, vaddr, gpa, length, offset, selected,
+        rule_offset, true);
+}
+
+static bool node_rule_occurs(QemuCrucibleFaultRule *rule, uint16_t tag)
+{
+    CrucibleNodeField *field = node_field(rule, tag);
+    QDict *policy;
+    const char *kind;
+
+    if (!field) {
+        return false;
+    }
+    policy = qobject_to(QDict, field->json);
+    if (!policy) {
+        return false;
+    }
+    kind = qdict_get_try_str(policy, "kind");
+    if (!kind) {
+        return false;
+    }
+    if (rule->opportunity_count == UINT64_MAX) {
+        error_report("Crucible rule opportunity counter overflow");
+        abort();
+    }
+    if (crucible_memory_transaction.active &&
+        crucible_memory_transaction.resources_preflighted &&
+        !crucible_memory_transaction.streaming) {
+        node_memory_rule_reservation_consume(rule, true);
+    }
+    rule->opportunity_count++;
+    if (strcmp(kind, "every") == 0) {
+        if (rule->applied_count == UINT64_MAX) {
+            error_report("Crucible rule applied counter overflow");
+            abort();
+        }
+        if (crucible_memory_transaction.active &&
+            crucible_memory_transaction.resources_preflighted &&
+            !crucible_memory_transaction.streaming) {
+            node_memory_rule_reservation_consume(rule, false);
+        }
+        rule->applied_count++;
+        return true;
+    }
+    if (strcmp(kind, "periodic") == 0) {
+        QDict *parameters = qobject_to(QDict, qdict_get(policy, "parameters"));
+        uint64_t first, period, count;
+
+        if (!parameters ||
+            !node_json_u64(qdict_get(parameters, "first"), &first) ||
+            !node_json_u64(qdict_get(parameters, "period"), &period) ||
+            !node_json_u64(qdict_get(parameters, "count"), &count) ||
+            rule->opportunity_count < first || rule->applied_count >= count ||
+            (rule->opportunity_count - first) % period != 0) {
+            return false;
+        }
+        if (rule->applied_count == UINT64_MAX) {
+            error_report("Crucible rule applied counter overflow");
+            abort();
+        }
+        if (crucible_memory_transaction.active &&
+            crucible_memory_transaction.resources_preflighted &&
+            !crucible_memory_transaction.streaming) {
+            node_memory_rule_reservation_consume(rule, false);
+        }
+        rule->applied_count++;
+        return true;
+    }
+    return false;
+}
+
+static bool node_memory_rule_occurs(QemuCrucibleFaultRule *rule,
+                                    uint16_t tag)
+{
+    gpointer evaluated;
+    bool occurs;
+
+    if (!crucible_memory_transaction.active) {
+        return node_rule_occurs(rule, tag);
+    }
+    if (!crucible_memory_transaction_occurrences) {
+        crucible_memory_transaction_occurrences = g_hash_table_new(
+            g_direct_hash, g_direct_equal);
+    }
+    evaluated = g_hash_table_lookup(
+        crucible_memory_transaction_occurrences, rule);
+    if (evaluated) {
+        return GPOINTER_TO_UINT(evaluated) == 2;
+    }
+    occurs = node_rule_occurs(rule, tag);
+    g_hash_table_insert(crucible_memory_transaction_occurrences, rule,
+                        GUINT_TO_POINTER(occurs ? 2 : 1));
+    return occurs;
+}
+
+static bool node_memory_transaction_once(GHashTable **table,
+                                         QemuCrucibleFaultRule *rule)
+{
+    if (!crucible_memory_transaction.active) {
+        return true;
+    }
+    if (!*table) {
+        *table = g_hash_table_new(g_direct_hash, g_direct_equal);
+    }
+    if (g_hash_table_contains(*table, rule)) {
+        return false;
+    }
+    g_hash_table_add(*table, rule);
+    return true;
+}
+
+static void node_memory_state_opportunity(QemuCrucibleFaultRule *rule)
+{
+    if (node_memory_transaction_once(
+            &crucible_memory_transaction_state_opportunities, rule)) {
+        if (rule->opportunity_count == UINT64_MAX) {
+            error_report("Crucible memory state opportunity counter overflow");
+            abort();
+        }
+        if (crucible_memory_transaction.resources_preflighted &&
+            !crucible_memory_transaction.streaming) {
+            node_memory_rule_reservation_consume(rule, true);
+        }
+        rule->opportunity_count++;
+    }
+}
+
+static void node_memory_state_applied(QemuCrucibleFaultRule *rule)
+{
+    if (node_memory_transaction_once(
+            &crucible_memory_transaction_state_applied, rule)) {
+        if (rule->applied_count == UINT64_MAX) {
+            error_report("Crucible memory state applied counter overflow");
+            abort();
+        }
+        if (crucible_memory_transaction.resources_preflighted &&
+            !crucible_memory_transaction.streaming) {
+            node_memory_rule_reservation_consume(rule, false);
+        }
+        rule->applied_count++;
+    }
+}
+
+static void node_repeated_transform(uint8_t *value, const uint8_t *before,
+                                    size_t length, uint64_t rule_offset,
+                                    const CrucibleNodeField *mask,
+                                    const CrucibleNodeField *replacement,
+                                    uint32_t kind)
+{
+    for (size_t i = 0; i < length; i++) {
+        uint8_t selected = mask->data[(rule_offset + i) % mask->length];
+
+        switch (kind) {
+        case 1:
+            value[i] = (value[i] & ~selected) |
+                       (replacement->data[(rule_offset + i) %
+                                          replacement->length] & selected);
+            break;
+        case 2:
+            value[i] ^= selected;
+            break;
+        case 4:
+            value[i] = (value[i] & selected) | (before[i] & ~selected);
+            break;
+        default:
+            g_assert_not_reached();
+        }
+    }
+}
+
+static void node_memory_event(QemuCrucibleFaultRule *rule, uint16_t outcome,
+                              enum QemuCrucibleMemoryAccessClass access_class,
+                              uint32_t vcpu, uint64_t vaddr, uint64_t gpa,
+                              const uint8_t *before, const uint8_t *after,
+                              size_t length, uint64_t observed_icount)
+{
+    g_autoptr(GByteArray) evidence = g_byte_array_new();
+    g_autofree uint8_t *effect_mask = NULL;
+    uint8_t identity[368] = { 0 };
+    uint8_t before_hash[32] = { 0 };
+    uint8_t after_hash[32] = { 0 };
+    uint8_t opportunity_hash[32];
+    uint8_t extension[48] = { 0 };
+
+    memcpy(identity, "CRUCMEM1", 8);
+    stl_le_p(identity + 8, access_class);
+    stl_le_p(identity + 12, vcpu);
+    stq_le_p(identity + 16, vaddr);
+    stq_le_p(identity + 24, gpa);
+    stq_le_p(identity + 32, length);
+    stq_le_p(identity + 40, rule->opportunity_count);
+    stq_le_p(identity + 48, crucible_memory_current_access);
+    stl_le_p(identity + 56, crucible_memory_current_match_count);
+    stl_le_p(identity + 60, crucible_memory_current_event_offset);
+    stq_le_p(identity + 64, observed_icount);
+    stq_le_p(identity + 72, rule->generation);
+    stq_le_p(identity + 80, rule->applied_count);
+    stq_le_p(identity + 88, rule->service_ledger ?
+             rule->service_ledger->ready_ns : 0);
+    stq_le_p(identity + 96, rule->last_exposure_ns);
+    stl_le_p(identity + 104,
+             (rule->exposure_initialized ? 1U : 0U) |
+             (rule->translation_stale ? 2U : 0U));
+    stl_le_p(identity + 108, crucible_memory_current_event_length);
+    memcpy(identity + 112, crucible_memory_current_match_hash, 32);
+    memcpy(identity + 144, rule->translation_hash, 32);
+    if (rule->command_kind == CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE) {
+        stq_le_p(identity + 176, rule->evidence_mutation_count);
+        stq_le_p(identity + 184, rule->evidence_mutation_bytes);
+        memcpy(identity + 192, rule->evidence_mutation_hash, 32);
+    }
+    if (access_class == QEMU_CRUCIBLE_MEMORY_DMA_READ ||
+        access_class == QEMU_CRUCIBLE_MEMORY_DMA_WRITE) {
+        qemu_crucible_fault_dma_identity(identity + 224);
+    } else if (access_class ==
+               QEMU_CRUCIBLE_MEMORY_PAGE_TABLE_WALK) {
+        stq_le_p(identity + 224,
+                 crucible_memory_transaction.page_table_target_vaddr);
+        stl_le_p(identity + 232,
+                 crucible_memory_transaction.page_table_level);
+        stl_le_p(identity + 236,
+                 crucible_memory_transaction.page_table_stage);
+        stl_le_p(identity + 240,
+                 crucible_memory_transaction.initiating_access_class);
+    }
+    if (crucible_memory_transaction.active) {
+        stl_le_p(identity + 256, crucible_memory_current_fragment);
+        stl_le_p(identity + 260,
+                 crucible_memory_transaction.retry_ordinal);
+        stq_le_p(identity + 264, crucible_memory_transaction.address);
+        stq_le_p(identity + 272, crucible_memory_transaction.length);
+        stq_le_p(identity + 280,
+                 crucible_memory_transaction.observed_icount);
+        stq_le_p(identity + 288,
+                 crucible_memory_transaction.instruction_pc);
+        stl_le_p(identity + 296,
+                 crucible_memory_transaction.instruction_ordinal);
+        stl_le_p(identity + 300,
+                 crucible_memory_transaction.has_instruction);
+    }
+    stw_le_p(identity + 304, rule->command_kind);
+    stw_le_p(identity + 306, outcome);
+    if (rule->command_kind ==
+        CRUCIBLE_FAULT_COMMAND_MEMORY_ACCESS_TRANSFORM) {
+        uint32_t kind;
+        CrucibleNodeField *effect;
+
+        g_assert(node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P3, &kind));
+        stl_le_p(identity + 308, kind);
+        effect = node_field(
+            rule, kind == 1 || kind == 2 ?
+                  CRUCIBLE_NODE_FAULT_FIELD_P4 :
+                  CRUCIBLE_NODE_FAULT_FIELD_P6);
+        node_memory_sha256(effect->data, effect->length, identity + 312);
+    } else if (rule->command_kind ==
+               CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE) {
+        uint32_t kind;
+
+        g_assert(node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P3, &kind));
+        stl_le_p(identity + 308, kind);
+        stq_le_p(identity + 312, rule->evidence_aggressor.row);
+        stw_le_p(identity + 320, rule->evidence_aggressor.channel);
+        stw_le_p(identity + 322, rule->evidence_aggressor.rank);
+        stw_le_p(identity + 324, rule->evidence_aggressor.bank);
+        stq_le_p(identity + 328, rule->evidence_counter_before);
+        stq_le_p(identity + 336, rule->evidence_counter_after);
+        stq_le_p(identity + 344, rule->evidence_victim_rows);
+        stl_le_p(identity + 352,
+                 rule->retention_cells ?
+                 g_hash_table_size(rule->retention_cells) : 0);
+        stw_le_p(identity + 356, CRUCIBLE_DRAM_CHANNELS);
+        stw_le_p(identity + 358, CRUCIBLE_DRAM_RANKS);
+        stw_le_p(identity + 360, CRUCIBLE_DRAM_BANKS);
+        stw_le_p(identity + 362, CRUCIBLE_DRAM_INTERLEAVE_BYTES);
+        stl_le_p(identity + 364,
+                 rule->evidence_counter_records ?
+                 rule->evidence_counter_records->len / 64 : 0);
+    }
+    node_memory_sha256(identity, sizeof(identity), opportunity_hash);
+    if (before && after) {
+        node_memory_sha256(before, length, before_hash);
+        node_memory_sha256(after, length, after_hash);
+        effect_mask = g_malloc0(length);
+    }
+    if (effect_mask && crucible_memory_current_event_length != 0) {
+        uint64_t start, range_length, access;
+        uint64_t rule_offset = 0;
+        bool has_vcpu;
+        CrucibleNodeField *mask = NULL;
+
+        g_assert(node_rule_memory_range(rule, &start, &range_length));
+        g_assert(node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_T3,
+                                 &has_vcpu));
+        access = has_vcpu ? vaddr : gpa;
+        g_assert(access <= UINT64_MAX - crucible_memory_current_event_offset);
+        g_assert(access + crucible_memory_current_event_offset >= start);
+        rule_offset = access + crucible_memory_current_event_offset - start;
+        if (rule->command_kind ==
+            CRUCIBLE_FAULT_COMMAND_MEMORY_ACCESS_TRANSFORM) {
+            uint32_t kind;
+
+            g_assert(node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P3,
+                                    &kind));
+            if (kind == 1 || kind == 2) {
+                mask = node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P4);
+            } else if (kind == 4) {
+                mask = node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P6);
+            }
+            for (size_t byte = 0;
+                 byte < crucible_memory_current_event_length; byte++) {
+                effect_mask[crucible_memory_current_event_offset + byte] =
+                    mask ? mask->data[(rule_offset + byte) % mask->length] :
+                           UINT8_MAX;
+            }
+        } else {
+            memset(effect_mask + crucible_memory_current_event_offset,
+                   UINT8_MAX, crucible_memory_current_event_length);
+        }
+    }
+    g_byte_array_append(evidence, identity, sizeof(identity));
+    g_byte_array_append(evidence, before_hash, sizeof(before_hash));
+    g_byte_array_append(evidence, after_hash, sizeof(after_hash));
+    stl_le_p(extension, 1);
+    stl_le_p(extension + 4, before && after ? length : 0);
+    stl_le_p(extension + 8,
+             rule->evidence_mutation_records ?
+             rule->evidence_mutation_records->len / 96 : 0);
+    stl_le_p(extension + 12, before && after ? 0x7 : 0);
+    stl_le_p(extension + 16,
+             rule->evidence_counter_records ?
+             rule->evidence_counter_records->len / 64 : 0);
+    stl_le_p(extension + 20, 96);
+    stl_le_p(extension + 24, 64);
+    stl_le_p(extension + 28, rule->retention_scheduled);
+    stq_le_p(extension + 32, rule->retention_next_ns);
+    if (crucible_memory_transaction.active) {
+        stq_le_p(extension + 40,
+                 crucible_memory_transaction.preflight_length);
+    }
+    g_byte_array_append(evidence, extension, sizeof(extension));
+    if (before && after) {
+        g_byte_array_append(evidence, before, length);
+        g_byte_array_append(evidence, after, length);
+        g_byte_array_append(evidence, effect_mask, length);
+    }
+    if (rule->evidence_mutation_records) {
+        g_byte_array_append(evidence, rule->evidence_mutation_records->data,
+                            rule->evidence_mutation_records->len);
+    }
+    if (rule->evidence_counter_records) {
+        g_byte_array_append(evidence, rule->evidence_counter_records->data,
+                            rule->evidence_counter_records->len);
+    }
+    g_assert(evidence->len <= CRUCIBLE_FAULT_HARD_PAYLOAD_BYTES);
+    if (crucible_memory_transaction.active &&
+        crucible_memory_transaction.streaming &&
+        !crucible_memory_preflight_collecting) {
+        CrucibleMemoryStagedEvent *staged = g_new0(
+            CrucibleMemoryStagedEvent, 1);
+
+        if (!crucible_memory_transaction.staged_events) {
+            crucible_memory_transaction.staged_events =
+                g_ptr_array_new_with_free_func(
+                    node_memory_staged_event_free);
+        }
+        staged->rule = node_memory_shadow_original(rule);
+        staged->outcome = outcome;
+        staged->observed_icount = observed_icount;
+        memcpy(staged->opportunity_hash, opportunity_hash, 32);
+        memcpy(staged->before_hash, before_hash, 32);
+        memcpy(staged->after_hash, after_hash, 32);
+        staged->evidence = g_byte_array_ref(evidence);
+        g_ptr_array_add(crucible_memory_transaction.staged_events, staged);
+    } else {
+        qemu_crucible_fault_rule_event(
+            rule, outcome, observed_icount, opportunity_hash,
+            before_hash, after_hash, evidence->data, evidence->len);
+        qemu_crucible_fault_notify_events();
+    }
+}
+
+static bool node_memory_event_capacity(
+    QemuCrucibleFaultRule *terminal_rule, size_t required,
+    uint32_t access_class, uint32_t vcpu,
+    uint64_t vaddr, uint64_t gpa, size_t length, uint64_t observed_icount)
+{
+    size_t used = MIN(crucible_node_event_count,
+                      (size_t)CRUCIBLE_NODE_EVENT_CAPACITY - 1);
+    size_t available = CRUCIBLE_NODE_EVENT_CAPACITY - 1 - used;
+
+    available -= MIN(crucible_node_event_reserved, available);
+
+    if (!crucible_node_event_terminal && required <= available) {
+        return true;
+    }
+    if (!crucible_node_event_terminal && required != 0) {
+        crucible_node_terminal_resource_kind =
+            CRUCIBLE_NODE_RESOURCE_EVENT_SLOTS;
+        crucible_node_terminal_current = used +
+            crucible_node_event_reserved;
+        crucible_node_terminal_requested = required;
+        crucible_node_terminal_configured = CRUCIBLE_NODE_EVENT_CAPACITY - 1;
+        crucible_node_terminal_hard = CRUCIBLE_NODE_EVENT_CAPACITY - 1;
+        crucible_node_event_force_terminal = true;
+        node_memory_mutation_evidence_reset(terminal_rule);
+        node_memory_event_span(0, length);
+        node_memory_event(terminal_rule, CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR,
+                          access_class, vcpu, vaddr, gpa, NULL, NULL,
+                          length, observed_icount);
+    }
+    return false;
+}
+
+static void node_memory_resource_terminal(
+    QemuCrucibleFaultRule *rule, uint32_t access_class, uint32_t vcpu,
+    uint64_t vaddr, uint64_t gpa, size_t length, uint64_t observed_icount)
+{
+    if (crucible_node_event_terminal) {
+        return;
+    }
+    if (!crucible_node_terminal_resource_kind) {
+        crucible_node_terminal_resource_kind = 2;
+        crucible_node_terminal_current = 0;
+        crucible_node_terminal_requested = 1;
+        crucible_node_terminal_configured = UINT64_MAX;
+        crucible_node_terminal_hard = UINT64_MAX;
+    }
+    crucible_node_event_force_terminal = true;
+    node_memory_mutation_evidence_reset(rule);
+    node_memory_event_span(0, length);
+    node_memory_event(rule, CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR,
+                      access_class, vcpu, vaddr, gpa, NULL, NULL,
+                      length, observed_icount);
+}
+
+static void node_memory_resource_terminal_metadata(
+    enum CrucibleNodeResourceKind kind, uint64_t current,
+    uint64_t requested, uint64_t configured, uint64_t hard)
+{
+    crucible_node_terminal_resource_kind = kind;
+    crucible_node_terminal_current = current;
+    crucible_node_terminal_requested = requested;
+    crucible_node_terminal_configured = configured;
+    crucible_node_terminal_hard = hard;
+}
+
+static void node_memory_counter_terminal_metadata(uint64_t current)
+{
+    node_memory_resource_terminal_metadata(
+        CRUCIBLE_NODE_RESOURCE_COUNTER, current,
+        current == UINT64_MAX ? UINT64_MAX : current + 1,
+        UINT64_MAX, UINT64_MAX);
+}
+
+static bool node_rate_delay_checked(uint64_t units, uint64_t per_second,
+                                    uint64_t *delay)
+{
+    uint64_t quotient, remainder;
+
+    if (per_second == 0) {
+        *delay = 0;
+        return true;
+    }
+    quotient = units / per_second;
+    remainder = units % per_second;
+    if (quotient > UINT64_MAX / 1000000000ULL) {
+        return false;
+    }
+    quotient *= 1000000000ULL;
+    if (remainder != 0) {
+        uint64_t fractional, high;
+        uint64_t rounding = per_second - 1;
+        uint64_t old_fractional;
+
+        mulu64(&fractional, &high, remainder, 1000000000ULL);
+        old_fractional = fractional;
+        fractional += rounding;
+        high += fractional < old_fractional;
+        divu128(&fractional, &high, per_second);
+        if (high != 0 || quotient > UINT64_MAX - fractional) {
+            return false;
+        }
+        quotient += fractional;
+    }
+    *delay = quotient;
+    return true;
+}
+
+static uint64_t node_rate_delay(uint64_t units, uint64_t per_second)
+{
+    uint64_t delay;
+
+    g_assert(node_rate_delay_checked(units, per_second, &delay));
+    return delay;
+}
+
+static uint64_t node_virtual_now(void)
+{
+    int64_t now = icount_enabled() == ICOUNT_PRECISE ?
+        icount_get_observed() : qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+
+    if (now < 0) {
+        error_report("Crucible fault model observed negative virtual time");
+        abort();
+    }
+    return now;
+}
+
+static uint64_t node_memory_service(QemuCrucibleFaultRule *rule,
+                                    size_t length, uint64_t *latency_out)
+{
+    uint64_t latency, byte_rate, operation_rate, delay, now, ready;
+    bool has_byte_rate, has_operation_rate;
+
+    g_assert(node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_P1, &latency));
+    g_assert(node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_P2,
+                             &has_byte_rate));
+    g_assert(node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_P3, &byte_rate));
+    g_assert(node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_P4,
+                             &has_operation_rate));
+    g_assert(node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_P5,
+                            &operation_rate));
+    *latency_out = latency;
+    delay = 0;
+    if (has_byte_rate) {
+        uint64_t contribution = node_rate_delay(length, byte_rate);
+
+        if (delay > UINT64_MAX - contribution) {
+            error_report("Crucible memory service delay overflow");
+            abort();
+        }
+        delay += contribution;
+    }
+    if (has_operation_rate) {
+        uint64_t contribution = node_rate_delay(1, operation_rate);
+
+        if (delay > UINT64_MAX - contribution) {
+            error_report("Crucible memory service delay overflow");
+            abort();
+        }
+        delay += contribution;
+    }
+    g_assert(rule->service_ledger);
+    now = node_virtual_now();
+    ready = MAX(now, rule->service_ledger->ready_ns);
+    if (ready > UINT64_MAX - delay) {
+        error_report("Crucible memory service coordinate overflow");
+        abort();
+    }
+    rule->service_ledger->ready_ns = ready + delay;
+    return rule->service_ledger->ready_ns - now;
+}
+
+static uint64_t node_memory_service_demand(QemuCrucibleFaultRule *rule,
+                                           uint64_t length,
+                                           uint64_t *latency_out)
+{
+    uint64_t latency, byte_rate, operation_rate, delay = 0;
+    bool has_byte_rate, has_operation_rate;
+
+    g_assert(node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_P1, &latency));
+    g_assert(node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_P2,
+                             &has_byte_rate));
+    g_assert(node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_P3, &byte_rate));
+    g_assert(node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_P4,
+                             &has_operation_rate));
+    g_assert(node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_P5,
+                            &operation_rate));
+    *latency_out = latency;
+    if (has_byte_rate) {
+        delay = node_rate_delay(length, byte_rate);
+    }
+    if (has_operation_rate) {
+        uint64_t contribution = node_rate_delay(1, operation_rate);
+
+        if (delay > UINT64_MAX - contribution) {
+            error_report("Crucible memory service delay overflow");
+            abort();
+        }
+        delay += contribution;
+    }
+    return delay;
+}
+
+static bool node_memory_service_demand_checked(
+    QemuCrucibleFaultRule *rule, uint64_t length,
+    uint64_t *latency_out, uint64_t *demand_out)
+{
+    uint64_t latency, byte_rate, operation_rate;
+    uint64_t demand = 0;
+    bool has_byte_rate, has_operation_rate;
+
+    g_assert(node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_P1, &latency));
+    g_assert(node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_P2,
+                             &has_byte_rate));
+    g_assert(node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_P3, &byte_rate));
+    g_assert(node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_P4,
+                             &has_operation_rate));
+    g_assert(node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_P5,
+                            &operation_rate));
+    if (has_byte_rate &&
+        !node_rate_delay_checked(length, byte_rate, &demand)) {
+        return false;
+    }
+    if (has_operation_rate) {
+        uint64_t contribution;
+
+        if (!node_rate_delay_checked(1, operation_rate, &contribution) ||
+            demand > UINT64_MAX - contribution) {
+            return false;
+        }
+        demand += contribution;
+    }
+    *latency_out = latency;
+    *demand_out = demand;
+    return true;
+}
+
+static bool node_memory_service_plan_add(QemuCrucibleFaultRule *rule,
+                                         uint64_t bytes)
+{
+    gpointer encoded;
+    CrucibleMemoryServicePlan *plan;
+
+    if (!crucible_memory_service_plan) {
+        crucible_memory_service_plan = g_array_new(
+            false, false, sizeof(CrucibleMemoryServicePlan));
+        crucible_memory_service_plan_index = g_hash_table_new(
+            g_direct_hash, g_direct_equal);
+    }
+    encoded = g_hash_table_lookup(crucible_memory_service_plan_index, rule);
+    if (encoded) {
+        plan = &g_array_index(
+            crucible_memory_service_plan, CrucibleMemoryServicePlan,
+            GPOINTER_TO_UINT(encoded) - 1);
+        if (plan->bytes > UINT64_MAX - bytes) {
+            node_memory_resource_terminal_metadata(
+                CRUCIBLE_NODE_RESOURCE_SERVICE_BYTES, plan->bytes,
+                bytes, UINT64_MAX, UINT64_MAX);
+            return false;
+        }
+        plan->bytes += bytes;
+        return true;
+    }
+    if (crucible_memory_service_plan->len ==
+        CRUCIBLE_NODE_MEMORY_MATCH_LIMIT) {
+        node_memory_resource_terminal_metadata(
+            CRUCIBLE_NODE_RESOURCE_SERVICE_RULES,
+            crucible_memory_service_plan->len,
+            (uint64_t)crucible_memory_service_plan->len + 1,
+            CRUCIBLE_NODE_MEMORY_MATCH_LIMIT,
+            CRUCIBLE_NODE_MEMORY_MATCH_LIMIT);
+        return false;
+    }
+    CrucibleMemoryServicePlan entry = { .rule = rule, .bytes = bytes };
+
+    g_array_append_val(crucible_memory_service_plan, entry);
+    g_hash_table_insert(crucible_memory_service_plan_index, rule,
+                        GUINT_TO_POINTER(crucible_memory_service_plan->len));
+    return true;
+}
+
+static void node_memory_service_plan_reset(void)
+{
+    if (crucible_memory_service_plan) {
+        g_array_set_size(crucible_memory_service_plan, 0);
+        g_hash_table_remove_all(crucible_memory_service_plan_index);
+    }
+}
+
+static bool node_memory_service_plan_valid(void)
+{
+    g_autoptr(GHashTable) demand_by_ledger = NULL;
+    uint64_t fixed_latency = 0;
+    uint64_t queue_delay = 0;
+    int64_t signed_now;
+    uint64_t now;
+
+    if (!crucible_memory_service_plan ||
+        crucible_memory_service_plan->len == 0) {
+        return true;
+    }
+    signed_now = icount_enabled() == ICOUNT_PRECISE ?
+        icount_get_observed() : qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    if (signed_now < 0) {
+        node_memory_resource_terminal_metadata(
+            CRUCIBLE_NODE_RESOURCE_VIRTUAL_TIME, 0, 0,
+            INT64_MAX, INT64_MAX);
+        return false;
+    }
+    now = signed_now;
+    demand_by_ledger = g_hash_table_new_full(
+        g_direct_hash, g_direct_equal, NULL, g_free);
+    for (guint i = 0; i < crucible_memory_service_plan->len; i++) {
+        CrucibleMemoryServicePlan *plan = &g_array_index(
+            crucible_memory_service_plan, CrucibleMemoryServicePlan, i);
+        uint64_t latency, demand, *stored;
+
+        if (!node_memory_service_demand_checked(
+                plan->rule, plan->bytes, &latency, &demand)) {
+            node_memory_resource_terminal_metadata(
+                CRUCIBLE_NODE_RESOURCE_ARITHMETIC, plan->bytes,
+                plan->bytes, UINT64_MAX, UINT64_MAX);
+            return false;
+        }
+        if (fixed_latency > UINT64_MAX - latency) {
+            node_memory_resource_terminal_metadata(
+                CRUCIBLE_NODE_RESOURCE_VIRTUAL_TIME, fixed_latency,
+                latency, UINT64_MAX, UINT64_MAX);
+            return false;
+        }
+        fixed_latency += latency;
+        stored = g_hash_table_lookup(
+            demand_by_ledger, plan->rule->service_ledger);
+        if (!stored) {
+            stored = g_new(uint64_t, 1);
+            *stored = 0;
+            g_hash_table_insert(demand_by_ledger,
+                                plan->rule->service_ledger, stored);
+        }
+        *stored = MAX(*stored, demand);
+    }
+    GHashTableIter iter;
+    gpointer ledger_key, demand_value;
+
+    g_hash_table_iter_init(&iter, demand_by_ledger);
+    while (g_hash_table_iter_next(&iter, &ledger_key, &demand_value)) {
+        CrucibleMemoryServiceLedger *ledger = ledger_key;
+        uint64_t demand = *(uint64_t *)demand_value;
+        uint64_t ready = MAX(now, ledger->ready_ns);
+        uint64_t reserved = node_memory_reserved_ledger(ledger);
+
+        if (ready > UINT64_MAX - reserved ||
+            ready + reserved > UINT64_MAX - demand) {
+            node_memory_resource_terminal_metadata(
+                CRUCIBLE_NODE_RESOURCE_VIRTUAL_TIME, ready,
+                reserved + demand,
+                UINT64_MAX, UINT64_MAX);
+            return false;
+        }
+        ready += reserved + demand;
+        queue_delay = MAX(queue_delay, ready - now);
+    }
+    if (fixed_latency > UINT64_MAX - queue_delay) {
+        node_memory_resource_terminal_metadata(
+            CRUCIBLE_NODE_RESOURCE_VIRTUAL_TIME, fixed_latency,
+            queue_delay, UINT64_MAX, UINT64_MAX);
+        return false;
+    }
+    if (crucible_memory_reserved_virtual_time > INT64_MAX - now ||
+        fixed_latency + queue_delay >
+            INT64_MAX - now - crucible_memory_reserved_virtual_time) {
+        node_memory_resource_terminal_metadata(
+            CRUCIBLE_NODE_RESOURCE_VIRTUAL_TIME,
+            now + MIN(crucible_memory_reserved_virtual_time,
+                      INT64_MAX - now),
+            fixed_latency + queue_delay, INT64_MAX, INT64_MAX);
+        return false;
+    }
+    return true;
+}
+
+static void node_memory_service_chain(uint8_t chain[32], uint64_t vaddr,
+                                      uint64_t gpa, const uint8_t *value,
+                                      size_t length)
+{
+    uint8_t material[112] = { 0 };
+
+    memcpy(material, chain, 32);
+    stq_le_p(material + 32, vaddr);
+    stq_le_p(material + 40, gpa);
+    stq_le_p(material + 48, length);
+    node_memory_sha256(value, length, material + 64);
+    node_memory_sha256(material, sizeof(material), chain);
+}
+
+static void node_memory_service_match_chain(uint8_t chain[32])
+{
+    uint8_t material[64];
+
+    memcpy(material, chain, 32);
+    memcpy(material + 32, crucible_memory_current_match_hash, 32);
+    node_memory_sha256(material, sizeof(material), chain);
+}
+
+static void node_memory_service_defer(QemuCrucibleFaultRule *rule,
+                                      uint32_t access_class, uint32_t vcpu,
+                                      uint64_t vaddr, uint64_t gpa,
+                                      const uint8_t *before,
+                                      const uint8_t *after, size_t length,
+                                      uint64_t observed_icount)
+{
+    gpointer encoded;
+    guint index;
+    CruciblePendingMemoryService *pending;
+
+    if (!crucible_memory_transaction.active) {
+        return;
+    }
+    if (!crucible_memory_pending_services) {
+        crucible_memory_pending_services = g_array_new(
+            false, false, sizeof(CruciblePendingMemoryService));
+        crucible_memory_pending_service_index = g_hash_table_new(
+            g_direct_hash, g_direct_equal);
+    }
+    encoded = g_hash_table_lookup(crucible_memory_pending_service_index,
+                                  rule);
+    if (encoded) {
+        index = GPOINTER_TO_UINT(encoded) - 1;
+        pending = &g_array_index(crucible_memory_pending_services,
+                                 CruciblePendingMemoryService, index);
+        if (pending->bytes > UINT64_MAX - length) {
+            error_report("Crucible transaction service bytes overflow");
+            abort();
+        }
+        pending->bytes += length;
+        node_memory_service_chain(pending->before_chain, vaddr, gpa, before,
+                                  length);
+        node_memory_service_chain(pending->after_chain, vaddr, gpa, after,
+                                  length);
+        node_memory_service_match_chain(pending->match_chain);
+        return;
+    }
+    if (crucible_memory_pending_services->len ==
+        CRUCIBLE_NODE_MEMORY_MATCH_LIMIT) {
+        error_report("Crucible transaction service rule bound exceeded");
+        abort();
+    }
+    CruciblePendingMemoryService entry = {
+        .rule = rule,
+        .bytes = length,
+        .access_class = access_class,
+        .vcpu = vcpu,
+        .vaddr = vaddr,
+        .gpa = gpa,
+        .observed_icount = observed_icount,
+    };
+
+    node_memory_service_chain(entry.before_chain, vaddr, gpa, before,
+                              length);
+    node_memory_service_chain(entry.after_chain, vaddr, gpa, after, length);
+    node_memory_service_match_chain(entry.match_chain);
+
+    g_array_append_val(crucible_memory_pending_services, entry);
+    index = crucible_memory_pending_services->len - 1;
+    g_hash_table_insert(crucible_memory_pending_service_index, rule,
+                        GUINT_TO_POINTER(index + 1));
+}
+
+static void node_memory_service_transaction_event(
+    CruciblePendingMemoryService *pending)
+{
+    uint8_t identity[304] = { 0 };
+    uint8_t opportunity_hash[32];
+    uint8_t evidence[576] = { 0 };
+    uint8_t ledger_hash[32];
+    uint8_t scope_hash[32];
+    uint64_t latency, byte_rate, operation_rate;
+    bool has_byte_rate, has_operation_rate;
+
+    memcpy(identity, "CRUCMEM1", 8);
+    stl_le_p(identity + 8, pending->access_class);
+    stl_le_p(identity + 12, pending->vcpu);
+    stq_le_p(identity + 16, pending->vaddr);
+    stq_le_p(identity + 24, pending->gpa);
+    stq_le_p(identity + 32, pending->bytes);
+    stq_le_p(identity + 48, crucible_memory_transaction.identity);
+    stl_le_p(identity + 56, 1);
+    stq_le_p(identity + 64, pending->observed_icount);
+    stq_le_p(identity + 72, pending->rule->generation);
+    stq_le_p(identity + 88, pending->rule->service_ledger->ready_ns);
+    if (pending->access_class == QEMU_CRUCIBLE_MEMORY_PAGE_TABLE_WALK) {
+        stq_le_p(identity + 224,
+                 crucible_memory_transaction.page_table_target_vaddr);
+        stl_le_p(identity + 232,
+                 crucible_memory_transaction.page_table_level);
+        stl_le_p(identity + 236,
+                 crucible_memory_transaction.page_table_stage);
+        stl_le_p(identity + 240,
+                 crucible_memory_transaction.initiating_access_class);
+    }
+    stq_le_p(identity + 264, crucible_memory_transaction.address);
+    stq_le_p(identity + 272, crucible_memory_transaction.length);
+    stq_le_p(identity + 280,
+             crucible_memory_transaction.observed_icount);
+    stq_le_p(identity + 288,
+             crucible_memory_transaction.instruction_pc);
+    stl_le_p(identity + 296,
+             crucible_memory_transaction.instruction_ordinal);
+    stl_le_p(identity + 300,
+             crucible_memory_transaction.has_instruction);
+    memcpy(evidence, identity, sizeof(identity));
+    memcpy(evidence + 304, pending->before_chain, 32);
+    memcpy(evidence + 336, pending->after_chain, 32);
+    memcpy(evidence + 368, "CRUCSVC1", 8);
+    stl_le_p(evidence + 376, 1);
+    stl_le_p(evidence + 380, crucible_memory_transaction.retry_ordinal);
+    stl_le_p(evidence + 384, crucible_memory_transaction.fragment_ordinal);
+    stq_le_p(evidence + 392, pending->ledger_ready_before);
+    stq_le_p(evidence + 400, pending->ledger_ready_after);
+    stq_le_p(evidence + 408, pending->fixed_latency);
+    stq_le_p(evidence + 416, pending->demand);
+    stq_le_p(evidence + 424, pending->queue_delay);
+    stq_le_p(evidence + 432, pending->completion_delay);
+    g_assert(node_field_u64(pending->rule,
+                            CRUCIBLE_NODE_FAULT_FIELD_P1, &latency));
+    g_assert(node_field_bool(pending->rule,
+                             CRUCIBLE_NODE_FAULT_FIELD_P2,
+                             &has_byte_rate));
+    g_assert(node_field_u64(pending->rule,
+                            CRUCIBLE_NODE_FAULT_FIELD_P3, &byte_rate));
+    g_assert(node_field_bool(pending->rule,
+                             CRUCIBLE_NODE_FAULT_FIELD_P4,
+                             &has_operation_rate));
+    g_assert(node_field_u64(pending->rule,
+                            CRUCIBLE_NODE_FAULT_FIELD_P5,
+                            &operation_rate));
+    stq_le_p(evidence + 440, latency);
+    stq_le_p(evidence + 448, byte_rate);
+    stq_le_p(evidence + 456, operation_rate);
+    stl_le_p(evidence + 464,
+             (has_byte_rate ? 1 : 0) | (has_operation_rate ? 2 : 0));
+    stl_le_p(evidence + 468, CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED);
+    node_memory_sha256(
+        (const uint8_t *)pending->rule->service_ledger->key,
+        strlen(pending->rule->service_ledger->key), ledger_hash);
+    node_memory_sha256(
+        node_field(pending->rule, CRUCIBLE_NODE_FAULT_FIELD_P6)->data,
+        node_field(pending->rule, CRUCIBLE_NODE_FAULT_FIELD_P6)->length,
+        scope_hash);
+    memcpy(evidence + 472, ledger_hash, sizeof(ledger_hash));
+    memcpy(evidence + 504, scope_hash, sizeof(scope_hash));
+    memcpy(evidence + 536, pending->match_chain,
+           sizeof(pending->match_chain));
+    node_memory_sha256(identity, sizeof(identity), opportunity_hash);
+    qemu_crucible_fault_rule_event(
+        node_memory_shadow_original(pending->rule),
+        CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED,
+        pending->observed_icount, opportunity_hash, pending->before_chain,
+        pending->after_chain, evidence, sizeof(evidence));
+    qemu_crucible_fault_notify_events();
+}
+
+static uint64_t node_memory_service_finish_transaction(void)
+{
+    g_autoptr(GArray) ledgers = NULL;
+    g_autoptr(GHashTable) ledger_index = NULL;
+    uint64_t fixed_latency = 0;
+    uint64_t queue_delay = 0;
+    uint64_t now;
+
+    if (!crucible_memory_pending_services ||
+        crucible_memory_pending_services->len == 0) {
+        return 0;
+    }
+    ledgers = g_array_new(false, false,
+                          sizeof(CruciblePendingServiceLedger));
+    ledger_index = g_hash_table_new(g_direct_hash, g_direct_equal);
+    for (guint i = 0; i < crucible_memory_pending_services->len; i++) {
+        CruciblePendingMemoryService *pending = &g_array_index(
+            crucible_memory_pending_services, CruciblePendingMemoryService,
+            i);
+        uint64_t latency;
+        uint64_t demand = node_memory_service_demand(
+            pending->rule, pending->bytes, &latency);
+        gpointer encoded = g_hash_table_lookup(
+            ledger_index, pending->rule->service_ledger);
+        CruciblePendingServiceLedger *group;
+
+        if (fixed_latency > UINT64_MAX - latency) {
+            error_report("Crucible transaction fixed latency overflow");
+            abort();
+        }
+        fixed_latency += latency;
+        pending->fixed_latency = latency;
+        pending->demand = demand;
+        if (encoded) {
+            group = &g_array_index(ledgers, CruciblePendingServiceLedger,
+                                   GPOINTER_TO_UINT(encoded) - 1);
+            group->delay = MAX(group->delay, demand);
+        } else {
+            CruciblePendingServiceLedger new_group = {
+                .ledger = pending->rule->service_ledger,
+                .delay = demand,
+                .ready_before = pending->rule->service_ledger->ready_ns,
+            };
+
+            g_array_append_val(ledgers, new_group);
+            g_hash_table_insert(ledger_index, new_group.ledger,
+                GUINT_TO_POINTER(ledgers->len));
+        }
+    }
+    now = node_virtual_now();
+    for (guint i = 0; i < ledgers->len; i++) {
+        CruciblePendingServiceLedger *group = &g_array_index(
+            ledgers, CruciblePendingServiceLedger, i);
+        uint64_t ready = MAX(now, group->ledger->ready_ns);
+
+        if (ready > UINT64_MAX - group->delay) {
+            error_report("Crucible transaction service coordinate overflow");
+            abort();
+        }
+        group->ledger->ready_ns = ready + group->delay;
+        group->ready_after = group->ledger->ready_ns;
+        group->queue_delay = group->ready_after - now;
+        queue_delay = MAX(queue_delay, group->queue_delay);
+    }
+    if (fixed_latency > UINT64_MAX - queue_delay) {
+        error_report("Crucible transaction service composition overflow");
+        abort();
+    }
+    if (crucible_memory_transaction.streaming) {
+        CPUState *cpu = qemu_get_cpu(crucible_memory_transaction.actor);
+        uint64_t delay = fixed_latency + queue_delay;
+
+        if (!cpu || cpu->crucible_fetch_service_nanos > UINT64_MAX - delay) {
+            error_report("Crucible fetch service staging overflow");
+            abort();
+        }
+        cpu->crucible_fetch_service_nanos += delay;
+    }
+    for (guint i = 0; i < crucible_memory_pending_services->len; i++) {
+        CruciblePendingMemoryService *pending = &g_array_index(
+            crucible_memory_pending_services, CruciblePendingMemoryService,
+            i);
+        gpointer encoded = g_hash_table_lookup(
+            ledger_index, pending->rule->service_ledger);
+        CruciblePendingServiceLedger *group = &g_array_index(
+            ledgers, CruciblePendingServiceLedger,
+            GPOINTER_TO_UINT(encoded) - 1);
+
+        pending->ledger_ready_before = group->ready_before;
+        pending->ledger_ready_after = group->ready_after;
+        pending->queue_delay = group->queue_delay;
+        pending->completion_delay = fixed_latency + queue_delay;
+
+        node_memory_service_transaction_event(pending);
+    }
+    return crucible_memory_transaction.streaming ? 0 :
+           fixed_latency + queue_delay;
+}
+
+static void node_memory_apply_service(uint64_t delay)
+{
+    int64_t now;
+
+    if (delay == 0) {
+        return;
+    }
+    now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    if (now < 0 || delay > INT64_MAX - now) {
+        error_report("Crucible memory service coordinate overflow");
+        abort();
+    }
+    icount_advance_virtual_time_to_ns(now + delay);
+}
+
+bool qemu_crucible_fault_memory_fetch_service_apply(CPUState *cpu)
+{
+    uint64_t delay;
+
+    if (!cpu) {
+        return false;
+    }
+    delay = cpu->crucible_fetch_service_nanos;
+    cpu->crucible_fetch_service_nanos = 0;
+    node_memory_apply_service(delay);
+    return delay != 0;
+}
+
+bool qemu_crucible_fault_memory_service_apply(CPUState *cpu)
+{
+    uint64_t delay;
+
+    if (!cpu) {
+        return false;
+    }
+    delay = cpu->crucible_memory_service_nanos;
+    cpu->crucible_memory_service_nanos = 0;
+    node_memory_apply_service(delay);
+    return delay != 0;
+}
