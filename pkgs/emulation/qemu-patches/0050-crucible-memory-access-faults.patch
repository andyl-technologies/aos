+static void test_exit(qemu_plugin_id_t id, void *opaque)
+{
+    (void)id;
+    (void)opaque;
+    if (!test_complete) {
+        g_printerr("state tb=%" PRIu64 " icount=%" PRIu64
+                   "submitted=%u prepared=%u installed=%u event=%u "
+                   "coverage=%08x "
+                   "retry=%u/%u/%u readable=%u result=", test_tb_count,
+                   test_last_icount,
+                   test_submitted,
+                   test_prepared,
+                   test_installed, test_event_seen, test_coverage,
+                   test_retry_poison_seen, test_retry_applied_seen,
+                   test_retry_event_count,
+                   test_last_result_readable);
+        for (size_t byte = 0; byte < test_last_result_length; byte++) {
+            g_printerr("%02x", test_last_result[byte]);
+        }
+        g_printerr(" expected=");
+        for (size_t byte = 0; byte < test_expected_length; byte++) {
+            g_printerr("%02x", test_expected[byte]);
+        }
+        g_printerr("\n");
+        test_fail("guest-visible result was not observed");
+    }
+    g_byte_array_unref(test_payload);
+}
+
+QEMU_PLUGIN_EXPORT int qemu_plugin_install(qemu_plugin_id_t id,
+                                           const qemu_info_t *info,
+                                           int argc, char **argv)
+{
+    uint32_t kind = 1;
+    uint32_t classes = 2;
+    uint8_t mask[16] = { 0 };
+    uint8_t replacement[16] = { 0 };
+    size_t length = 1;
+    bool replacement_present = true;
+    bool violate_atomicity = false;
+
+    (void)info;
+    if ((argc != 9 && argc != 10) ||
+        !g_str_has_prefix(argv[0], "address=") ||
+        !g_str_has_prefix(argv[1], "result=") ||
+        !g_str_has_prefix(argv[2], "expected=") ||
+        !g_str_has_prefix(argv[3], "kind=") ||
+        !g_str_has_prefix(argv[4], "classes=") ||
+        !g_str_has_prefix(argv[5], "length=") ||
+        !g_str_has_prefix(argv[6], "mask=") ||
+        !g_str_has_prefix(argv[7], "replacement=") ||
+        !g_str_has_prefix(argv[8], "atomic=") ||
+        (argc == 10 && !g_str_has_prefix(argv[9], "scenario="))) {
+        test_fail(
+            "nine canonical arguments and an optional scenario are required");
+    }
+    test_address = g_ascii_strtoull(argv[0] + 8, NULL, 0);
+    test_result_address = g_ascii_strtoull(argv[1] + 7, NULL, 0);
+    test_expected_length = test_parse_hex(
+        argv[2] + 9, test_expected, sizeof(test_expected));
+    kind = g_ascii_strtoull(argv[3] + 5, NULL, 0);
+    classes = g_ascii_strtoull(argv[4] + 8, NULL, 0);
+    length = g_ascii_strtoull(argv[5] + 7, NULL, 0);
+    if (length == 0 || length > sizeof(mask)) {
+        test_fail("test length is out of range");
+    }
+    test_length = length;
+    test_kind = kind;
+    test_classes = classes;
+    if (strcmp(argv[6] + 5, "none") != 0 &&
+        test_parse_hex(argv[6] + 5, mask, sizeof(mask)) != length) {
+        test_fail("mask length must equal the rule length");
+    }
+    if (strcmp(argv[7] + 12, "none") == 0) {
+        replacement_present = false;
+    } else if (test_parse_hex(
+                   argv[7] + 12, replacement,
+                   sizeof(replacement)) != length) {
+        test_fail("replacement length must equal the rule length");
+    }
+    violate_atomicity = g_ascii_strtoull(argv[8] + 7, NULL, 0) != 0;
+    if (argc == 10) {
+        test_scenario = argv[9] + 9;
+        test_build_scenario(test_scenario);
+    } else {
+        test_build_rule(kind, classes, mask, length, replacement_present,
+                        replacement, length, violate_atomicity);
+    }
+    memset(&test_command, 0, sizeof(test_command));
+    test_command.abi_major = CRUCIBLE_FAULT_COMMAND_ABI_MAJOR;
+    test_command.abi_minor = CRUCIBLE_FAULT_COMMAND_ABI_MINOR;
+    test_command.command_kind = test_command_kind;
+    test_command.command_flags = CRUCIBLE_FAULT_COMMAND_FLAG_PREPARE_ONLY;
+    test_command.phase = CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY;
+    test_command.semantic_version = CRUCIBLE_FAULT_COMMAND_SEMANTIC_VERSION;
+    test_command.command_sequence = 1;
+    test_command.target_icount = 32;
+    test_command.authorization_ceiling_icount = 32;
+    memset(test_command.target_node_hash, 0x11, 32);
+    memset(test_command.binding_hash, 0x31, 32);
+    if (argc != 10 || !test_deferred_submission) {
+        if (qemu_plugin_crucible_fault_submit(
+                &test_command, test_payload->data, test_payload->len) != 0) {
+            test_fail("rule preparation could not be submitted");
+        }
+        test_submitted = true;
+    }
+    qemu_plugin_register_crucible_fault_completion_cb(
+        test_fault_completion, NULL);
+    qemu_plugin_register_vcpu_tb_trans_cb(id, test_tb_trans);
+    qemu_plugin_register_atexit_cb(id, test_exit, NULL);
+    return 0;
+}
diff --git a/tests/tcg/plugins/crucible-memory-dma.c b/tests/tcg/plugins/crucible-memory-dma.c
new file mode 100644
index 000000000..e1e096d68
--- /dev/null
+++ b/tests/tcg/plugins/crucible-memory-dma.c
@@ -0,0 +1,433 @@
+/*
+ * Live Crucible device-scoped DMA memory-fault test plugin
+ *
+ * Copyright (c) 2026 ANDYL Technologies
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include <glib.h>
+#include <qemu-plugin.h>
+
+#include "aos/crucible/crucible_shmem_abi.h"
+
+QEMU_PLUGIN_EXPORT int qemu_plugin_version = QEMU_PLUGIN_VERSION;
+
+#define TEST_EVIDENCE_BYTES (1024 * 1024)
+#define TEST_DMA_ID_DOMAIN "qemu.virtio.dma-id.v1"
+#ifndef CRUCIBLE_NODE_FAULT_FIELD_P10
+#define CRUCIBLE_NODE_FAULT_FIELD_P10 10u
+#define CRUCIBLE_NODE_FAULT_FIELD_P11 11u
+#endif
+
+static struct qemu_plugin_crucible_fault_command test_command;
+static GByteArray *test_payload;
+static uint8_t test_evidence[TEST_EVIDENCE_BYTES];
+static uint8_t test_device_identity[32];
+static uint64_t test_start;
+static uint64_t test_length;
+static uint64_t test_mailbox;
+static uint64_t test_publish_pc;
+static uint64_t test_ready_pc;
+static uint64_t test_complete_pc;
+static uint32_t test_class;
+static bool test_prepared;
+static bool test_installed;
+static bool test_complete;
+static bool test_require_translation;
+static bool test_guest_complete;
+static bool test_target_published;
+
+static void test_fail(const char *message)
+{
+    g_printerr("Crucible DMA memory live test failed: %s\n", message);
+    abort();
+}
+
+static void test_put_u16(uint8_t *bytes, uint16_t value)
+{
+    bytes[0] = value;
+    bytes[1] = value >> 8;
+}
+
+static void test_put_u32(uint8_t *bytes, uint32_t value)
+{
+    for (size_t i = 0; i < 4; i++) {
+        bytes[i] = value >> (i * 8);
+    }
+}
+
+static void test_put_u64(uint8_t *bytes, uint64_t value)
+{
+    for (size_t i = 0; i < 8; i++) {
+        bytes[i] = value >> (i * 8);
+    }
+}
+
+static uint32_t test_get_u32(const uint8_t *bytes)
+{
+    return bytes[0] | (uint32_t)bytes[1] << 8 |
+           (uint32_t)bytes[2] << 16 | (uint32_t)bytes[3] << 24;
+}
+
+static uint64_t test_get_u64(const uint8_t *bytes)
+{
+    return test_get_u32(bytes) | (uint64_t)test_get_u32(bytes + 4) << 32;
+}
+
+static void test_field(uint16_t tag, uint16_t type,
+                       const void *data, uint32_t length)
+{
+    uint8_t header[CRUCIBLE_NODE_FAULT_FIELD_HEADER_V1_BYTES];
+
+    test_put_u16(header + CRUCIBLE_NODE_FAULT_FIELD_TAG_OFFSET, tag);
+    test_put_u16(header + CRUCIBLE_NODE_FAULT_FIELD_TYPE_OFFSET, type);
+    test_put_u32(header + CRUCIBLE_NODE_FAULT_FIELD_LENGTH_OFFSET, length);
+    g_byte_array_append(test_payload, header, sizeof(header));
+    g_byte_array_append(test_payload, data, length);
+}
+
+static void test_field_u32(uint16_t tag, uint32_t value)
+{
+    uint8_t bytes[4];
+
+    test_put_u32(bytes, value);
+    test_field(tag, CRUCIBLE_NODE_FAULT_FIELD_TYPE_U32,
+               bytes, sizeof(bytes));
+}
+
+static void test_field_u64(uint16_t tag, uint64_t value)
+{
+    uint8_t bytes[8];
+
+    test_put_u64(bytes, value);
+    test_field(tag, CRUCIBLE_NODE_FAULT_FIELD_TYPE_U64,
+               bytes, sizeof(bytes));
+}
+
+static void test_field_bool(uint16_t tag, bool value)
+{
+    uint8_t byte = value;
+
+    test_field(tag, CRUCIBLE_NODE_FAULT_FIELD_TYPE_BOOL, &byte, 1);
+}
+
+static void test_device_hash(const char *device)
+{
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    gsize length = sizeof(test_device_identity);
+
+    if (!checksum) {
+        test_fail("SHA-256 is unavailable");
+    }
+    g_checksum_update(checksum, (const uint8_t *)TEST_DMA_ID_DOMAIN,
+                      strlen(TEST_DMA_ID_DOMAIN));
+    g_checksum_update(checksum, (const uint8_t *)device, strlen(device));
+    g_checksum_get_digest(checksum, test_device_identity, &length);
+    if (length != sizeof(test_device_identity)) {
+        test_fail("device identity digest has the wrong width");
+    }
+}
+
+static void test_build_rule(void)
+{
+    uint8_t header[CRUCIBLE_NODE_FAULT_PAYLOAD_HEADER_V1_BYTES] = { 0 };
+    uint8_t node_hash[32];
+    uint8_t mask = 1;
+    uint8_t replacement = 1;
+    const char policy[] = CRUCIBLE_NODE_FAULT_POLICY_JSON_MAGIC_V1
+                          "{\"kind\":\"every\"}";
+
+    memset(node_hash, 0x11, sizeof(node_hash));
+    memcpy(header + CRUCIBLE_NODE_FAULT_PAYLOAD_MAGIC_OFFSET,
+           "CRUCNOD1", 8);
+    test_put_u16(header + CRUCIBLE_NODE_FAULT_PAYLOAD_VERSION_OFFSET,
+                 CRUCIBLE_NODE_FAULT_PAYLOAD_VERSION_V1);
+    test_put_u16(header + CRUCIBLE_NODE_FAULT_PAYLOAD_COMMAND_KIND_OFFSET,
+                 CRUCIBLE_FAULT_COMMAND_MEMORY_ACCESS_TRANSFORM);
+    test_put_u16(header + CRUCIBLE_NODE_FAULT_PAYLOAD_OPERATION_OFFSET,
+                 CRUCIBLE_NODE_FAULT_OPERATION_UPSERT);
+    test_put_u16(header + CRUCIBLE_NODE_FAULT_PAYLOAD_TARGET_KIND_OFFSET,
+                 CRUCIBLE_NODE_FAULT_TARGET_MEMORY);
+    test_put_u16(header + CRUCIBLE_NODE_FAULT_PAYLOAD_MODEL_PHASE_OFFSET, 1);
+    test_put_u64(header + CRUCIBLE_NODE_FAULT_PAYLOAD_GENERATION_OFFSET, 1);
+    memset(header + CRUCIBLE_NODE_FAULT_PAYLOAD_ACTION_HASH_OFFSET, 0x21, 32);
+    memset(header + CRUCIBLE_NODE_FAULT_PAYLOAD_TARGET_HASH_OFFSET, 0x22, 32);
+    memset(header + CRUCIBLE_NODE_FAULT_PAYLOAD_SCHEMA_HASH_OFFSET, 0x23, 32);
+    test_put_u16(header + CRUCIBLE_NODE_FAULT_PAYLOAD_FIELD_COUNT_OFFSET, 16);
+    test_payload = g_byte_array_new();
+    g_byte_array_append(test_payload, header, sizeof(header));
+    test_field_u64(CRUCIBLE_NODE_FAULT_FIELD_P1, test_start);
+    test_field_u64(CRUCIBLE_NODE_FAULT_FIELD_P2, test_length);
+    test_field_u32(CRUCIBLE_NODE_FAULT_FIELD_P3, 1);
+    test_field(CRUCIBLE_NODE_FAULT_FIELD_P4,
+               CRUCIBLE_NODE_FAULT_FIELD_TYPE_BYTES, &mask, 1);
+    test_field_bool(CRUCIBLE_NODE_FAULT_FIELD_P5, true);
+    test_field(CRUCIBLE_NODE_FAULT_FIELD_P6,
+               CRUCIBLE_NODE_FAULT_FIELD_TYPE_BYTES, &replacement, 1);
+    test_field(CRUCIBLE_NODE_FAULT_FIELD_P7,
+               CRUCIBLE_NODE_FAULT_FIELD_TYPE_BYTES,
+               policy, sizeof(policy) - 1);
+    test_field_u32(CRUCIBLE_NODE_FAULT_FIELD_P8, test_class);
+    test_field_bool(CRUCIBLE_NODE_FAULT_FIELD_P9, false);
+    test_field_bool(CRUCIBLE_NODE_FAULT_FIELD_P10, true);
+    test_field(CRUCIBLE_NODE_FAULT_FIELD_P11,
+               CRUCIBLE_NODE_FAULT_FIELD_TYPE_HASH,
+               test_device_identity, sizeof(test_device_identity));
+    test_field(CRUCIBLE_NODE_FAULT_FIELD_T1,
+               CRUCIBLE_NODE_FAULT_FIELD_TYPE_HASH,
+               node_hash, sizeof(node_hash));
+    test_field_u64(CRUCIBLE_NODE_FAULT_FIELD_T2, test_start);
+    test_field_bool(CRUCIBLE_NODE_FAULT_FIELD_T3, false);
+    test_field_u32(CRUCIBLE_NODE_FAULT_FIELD_T4, 0);
+    test_field_u64(CRUCIBLE_NODE_FAULT_FIELD_T5, test_length);
+}
+
+static void test_poll_events(void)
+{
+    struct qemu_plugin_crucible_fault_event event;
+    size_t evidence_length;
+    int status;
+
+    while ((status = qemu_plugin_crucible_fault_event_poll(
+                &event, test_evidence, sizeof(test_evidence),
+                &evidence_length)) == 1) {
+        uint64_t address;
+        uint64_t length;
+        uint64_t transaction_address;
+        const uint8_t *before;
+        const uint8_t *after;
+        const uint8_t *effect;
+
+        if (event.command_kind !=
+                CRUCIBLE_FAULT_COMMAND_MEMORY_ACCESS_TRANSFORM ||
+            event.generation != 1 || evidence_length < 483 ||
+            memcmp(test_evidence, "CRUCMEM1", 8) != 0 ||
+            test_get_u32(test_evidence + 8) != test_class ||
+            memcmp(test_evidence + 224, test_device_identity, 32) != 0) {
+            test_fail("device-scoped DMA evidence identity is incomplete");
+        }
+        address = test_get_u64(test_evidence + 24);
+        length = test_get_u64(test_evidence + 32);
+        transaction_address = test_get_u64(test_evidence + 264);
+        if (length == 0 || length > 4096 ||
+            address < test_start || address - test_start >= test_length ||
+            length > test_length - (address - test_start) ||
+            evidence_length != 480 + 3 * length ||
+            test_get_u32(test_evidence + 436) != length) {
+            test_fail("DMA opportunity span is not exact");
+        }
+        if (test_require_translation &&
+            (transaction_address == address ||
+             (transaction_address >= test_start &&
+              transaction_address - test_start < test_length))) {
+            test_fail("IOMMU DMA preflight did not select by translated GPA");
+        }
+        if (test_require_translation) {
+            g_printerr("CRUCIBLE_MEMORY_DMA_TRANSLATION iova=%" PRIx64
+                       " gpa=%" PRIx64 "\n",
+                       transaction_address, address);
+        }
+        before = test_evidence + 480;
+        after = before + length;
+        effect = after + length;
+        for (size_t i = 0; i < length; i++) {
+            size_t payload_offset = address - test_start + i;
+            uint8_t expected = ((uint8_t)payload_offset ^ 0x36u) | 1u;
+
+            if (after[i] != expected || effect[i] != 1) {
+                test_fail("DMA bytes do not match the stuck-bit transform");
+            }
+        }
+        if (!test_complete) {
+            test_complete = true;
+        }
+    }
+    if (status < 0) {
+        test_fail("DMA occurrence evidence could not be polled losslessly");
+    }
+}
+
+static void test_fault_completion(void *opaque)
+{
+    struct qemu_plugin_crucible_fault_result result;
+    uint8_t evidence[CRUCIBLE_NODE_FAULT_EVIDENCE_V1_BYTES];
+    size_t length;
+    int status;
+
+    (void)opaque;
+    test_poll_events();
+    while ((status = qemu_plugin_crucible_fault_poll(
+                &result, evidence, sizeof(evidence), &length)) == 1) {
+        if (!test_prepared) {
+            if (result.status != CRUCIBLE_FAULT_STATUS_PREPARED ||
+                length != sizeof(evidence)) {
+                g_printerr("DMA preparation status=%u evidence=%zu\n",
+                           result.status, length);
+                test_fail("rule preparation did not return canonical evidence");
+            }
+            memcpy(test_command.expected_precondition_hash,
+                   result.before_hash, 32);
+            test_command.command_flags = 0;
+            test_command.command_sequence = 2;
+            test_command.target_icount = result.observed_icount;
+            test_command.authorization_ceiling_icount =
+                result.observed_icount;
+            test_prepared = true;
+            if (qemu_plugin_crucible_fault_submit(
+                    &test_command, test_payload->data,
+                    test_payload->len) != 0) {
+                test_fail("rule commit could not be submitted");
+            }
+            qemu_plugin_force_vcpu_exit();
+        } else {
+            if (result.status != CRUCIBLE_FAULT_STATUS_APPLIED ||
+                length != sizeof(evidence)) {
+                test_fail("rule commit was not applied");
+            }
+            test_installed = true;
+        }
+    }
+    if (status < 0) {
+        test_fail("rule result could not be polled losslessly");
+    }
+}
+
+static void test_tb_exec(unsigned int cpu_index, void *opaque)
+{
+    (void)cpu_index;
+    (void)opaque;
+    if (test_installed) {
+        test_poll_events();
+    }
+}
+
+static void test_target_publish_exec(unsigned int cpu_index, void *opaque)
+{
+    g_autoptr(GByteArray) bytes = g_byte_array_new();
+    uint64_t current_icount;
+
+    (void)cpu_index;
+    (void)opaque;
+    if (test_target_published ||
+        !qemu_plugin_read_memory_vaddr(test_mailbox, bytes, 8)) {
+        test_fail("guest DMA target mailbox could not be consumed once");
+    }
+    test_start = test_get_u64(bytes->data);
+    if (test_start == 0 || test_start > UINT64_MAX - test_length) {
+        test_fail("guest published an invalid DMA target GPA");
+    }
+    test_build_rule();
+    current_icount = qemu_plugin_crucible_icount();
+    test_command.target_icount = current_icount;
+    test_command.authorization_ceiling_icount = current_icount;
+    test_target_published = true;
+    if (qemu_plugin_crucible_fault_submit(
+            &test_command, test_payload->data, test_payload->len) != 0) {
+        test_fail("dynamic DMA rule preparation could not be submitted");
+    }
+    qemu_plugin_force_vcpu_exit();
+}
+
+static void test_guest_ready_exec(unsigned int cpu_index, void *opaque)
+{
+    (void)cpu_index;
+    (void)opaque;
+    test_fault_completion(NULL);
+    if (!test_installed) {
+        test_fail("guest reached DMA issue point before rule installation");
+    }
+}
+
+static void test_guest_complete_exec(unsigned int cpu_index, void *opaque)
+{
+    (void)cpu_index;
+    (void)opaque;
+    test_poll_events();
+    if (!test_complete) {
+        test_fail("guest completed without a matching payload DMA event");
+    }
+    if (!test_guest_complete) {
+        test_guest_complete = true;
+        g_printerr("CRUCIBLE_MEMORY_DMA_LIVE_PASS\n");
+        qemu_plugin_request_shutdown(0);
+    }
+}
+
+static void test_tb_trans(qemu_plugin_id_t id, struct qemu_plugin_tb *tb)
+{
+    (void)id;
+    if (qemu_plugin_tb_vaddr(tb) == test_publish_pc) {
+        qemu_plugin_register_vcpu_tb_exec_cb(
+            tb, test_target_publish_exec, QEMU_PLUGIN_CB_NO_REGS, NULL);
+    } else if (qemu_plugin_tb_vaddr(tb) == test_ready_pc) {
+        qemu_plugin_register_vcpu_tb_exec_cb(
+            tb, test_guest_ready_exec, QEMU_PLUGIN_CB_NO_REGS, NULL);
+    } else if (qemu_plugin_tb_vaddr(tb) == test_complete_pc) {
+        qemu_plugin_register_vcpu_tb_exec_cb(
+            tb, test_guest_complete_exec, QEMU_PLUGIN_CB_NO_REGS, NULL);
+    } else {
+        qemu_plugin_register_vcpu_tb_exec_cb(
+            tb, test_tb_exec, QEMU_PLUGIN_CB_NO_REGS, NULL);
+    }
+}
+
+static void test_exit(qemu_plugin_id_t id, void *opaque)
+{
+    (void)id;
+    (void)opaque;
+    if (!test_complete || !test_guest_complete) {
+        test_fail("guest-visible production DMA transform did not complete");
+    }
+    g_byte_array_unref(test_payload);
+}
+
+QEMU_PLUGIN_EXPORT int qemu_plugin_install(qemu_plugin_id_t id,
+                                           const qemu_info_t *info,
+                                           int argc, char **argv)
+{
+    const char *device;
+
+    (void)info;
+    if ((argc != 7 && argc != 8) ||
+        !g_str_has_prefix(argv[0], "length=") ||
+        !g_str_has_prefix(argv[1], "class=") ||
+        !g_str_has_prefix(argv[2], "device=") ||
+        !g_str_has_prefix(argv[3], "mailbox=") ||
+        !g_str_has_prefix(argv[4], "publish-pc=") ||
+        !g_str_has_prefix(argv[5], "ready-pc=") ||
+        !g_str_has_prefix(argv[6], "complete-pc=") ||
+        (argc == 8 && strcmp(argv[7], "translated=1") != 0)) {
+        test_fail("canonical DMA arguments are required");
+    }
+    test_length = g_ascii_strtoull(argv[0] + 7, NULL, 0);
+    test_class = g_ascii_strtoull(argv[1] + 6, NULL, 0);
+    device = argv[2] + 7;
+    test_mailbox = g_ascii_strtoull(argv[3] + 8, NULL, 0);
+    test_publish_pc = g_ascii_strtoull(argv[4] + 11, NULL, 0);
+    test_ready_pc = g_ascii_strtoull(argv[5] + 9, NULL, 0);
+    test_complete_pc = g_ascii_strtoull(argv[6] + 12, NULL, 0);
+    test_require_translation = argc == 8;
+    if (test_length == 0 ||
+        (test_class != 8 && test_class != 16) || *device == '\0' ||
+        test_mailbox == 0 || test_publish_pc == 0 || test_ready_pc == 0 ||
+        test_complete_pc == 0) {
+        test_fail("DMA rule arguments are outside the closed schema");
+    }
+    test_device_hash(device);
+    memset(&test_command, 0, sizeof(test_command));
+    test_command.abi_major = CRUCIBLE_FAULT_COMMAND_ABI_MAJOR;
+    test_command.abi_minor = CRUCIBLE_FAULT_COMMAND_ABI_MINOR;
+    test_command.command_kind = CRUCIBLE_FAULT_COMMAND_MEMORY_ACCESS_TRANSFORM;
+    test_command.command_flags = CRUCIBLE_FAULT_COMMAND_FLAG_PREPARE_ONLY;
+    test_command.phase = CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY;
+    test_command.semantic_version = CRUCIBLE_FAULT_COMMAND_SEMANTIC_VERSION;
+    test_command.command_sequence = 1;
+    memset(test_command.target_node_hash, 0x11, 32);
+    memset(test_command.binding_hash, 0x41, 32);
+    qemu_plugin_register_crucible_fault_completion_cb(
+        test_fault_completion, NULL);
+    qemu_plugin_register_vcpu_tb_trans_cb(id, test_tb_trans);
+    qemu_plugin_register_atexit_cb(id, test_exit, NULL);
+    return 0;
+}
