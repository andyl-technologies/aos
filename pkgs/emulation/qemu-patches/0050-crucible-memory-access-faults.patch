+static bool node_target_schema_for(uint16_t target_kind,
+                                   const NodeSchemaField **fields,
+                                   size_t *count)
+{
+    switch (target_kind) {
+    case CRUCIBLE_NODE_FAULT_TARGET_NODE:
+        *fields = NULL;
+        *count = 0;
+        return true;
+    case CRUCIBLE_NODE_FAULT_TARGET_VCPU:
+        *fields = target_vcpu;
+        *count = G_N_ELEMENTS(target_vcpu);
+        return true;
+    case CRUCIBLE_NODE_FAULT_TARGET_REGISTER:
+        *fields = target_register;
+        *count = G_N_ELEMENTS(target_register);
+        return true;
+    case CRUCIBLE_NODE_FAULT_TARGET_MEMORY:
+        *fields = target_memory;
+        *count = G_N_ELEMENTS(target_memory);
+        return true;
+    case CRUCIBLE_NODE_FAULT_TARGET_INTERRUPT:
+        *fields = target_interrupt;
+        *count = G_N_ELEMENTS(target_interrupt);
+        return true;
+    case CRUCIBLE_NODE_FAULT_TARGET_CLOCK:
+    case CRUCIBLE_NODE_FAULT_TARGET_ACCELERATOR:
+        *fields = target_hash;
+        *count = G_N_ELEMENTS(target_hash);
+        return true;
+    default:
+        return false;
+    }
+}
