+static CrucibleNodeField *node_field(QemuCrucibleFaultRule *rule, uint16_t tag)
+{
+    for (size_t i = 0; i < rule->field_count; i++) {
+        if (rule->fields[i].tag == tag) {
+            return &rule->fields[i];
+        }
+    }
+    return NULL;
+}
+
+static bool node_field_u32(QemuCrucibleFaultRule *rule, uint16_t tag,
+                           uint32_t *value)
+{
+    CrucibleNodeField *field = node_field(rule, tag);
+
+    if (!field || field->type != CRUCIBLE_NODE_FAULT_FIELD_TYPE_U32) {
+        return false;
+    }
+    *value = node_get_u32(field->data);
+    return true;
+}
