+static void node_memory_transaction_preflight_segment(
+    uint32_t access_class, uint32_t vcpu, uint64_t vaddr, uint64_t gpa,
+    size_t length, bool include_gva, uint64_t identity)
+{
+    crucible_memory_preflight_collecting = true;
+    size_t match_count = node_memory_matching_rules_at(
+        vcpu, vaddr, gpa, length, include_gva, identity);
+    crucible_memory_preflight_collecting = false;
+
+    for (size_t i = 0; i < match_count; i++) {
+        QemuCrucibleFaultRule *rule = crucible_memory_matches[i];
+        size_t offset, selected;
+        uint64_t rule_offset;
+        uint32_t kind;
+
+        if (!node_rule_memory_overlap(rule, vcpu, vaddr, gpa, length,
+                                      &offset, &selected, &rule_offset)) {
+            continue;
+        }
+        if (rule->command_kind == CRUCIBLE_FAULT_COMMAND_MEMORY_SERVICE) {
+            continue;
+        }
+        if (rule->command_kind ==
+            CRUCIBLE_FAULT_COMMAND_MEMORY_ACCESS_TRANSFORM) {
+            uint32_t classes;
+            gpointer evaluated;
+            bool occurs;
+            bool first_evaluation;
+            QDict *poison;
+
+            g_assert(node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P3,
+                                    &kind));
+            g_assert(node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P8,
+                                    &classes));
+            if (kind != 5 || (classes & access_class) == 0) {
+                continue;
+            }
+            if (rule->opportunity_count == UINT64_MAX ||
+                rule->applied_count == UINT64_MAX) {
+                node_memory_counter_terminal_metadata(UINT64_MAX);
+                node_memory_resource_terminal(
+                    rule, access_class, vcpu, vaddr + offset,
+                    gpa + offset, selected,
+                    crucible_memory_transaction.observed_icount);
+                crucible_memory_transaction.poisoned = true;
+                break;
+            }
+            evaluated = g_hash_table_lookup(
+                crucible_memory_transaction_poison, rule);
+            first_evaluation = !evaluated;
+            if (!evaluated) {
+                occurs = node_memory_rule_occurs(
+                    rule, CRUCIBLE_NODE_FAULT_FIELD_P7);
+                g_hash_table_insert(crucible_memory_transaction_poison, rule,
+                    GUINT_TO_POINTER(occurs ? 2 : 1));
+            } else {
+                occurs = GPOINTER_TO_UINT(evaluated) == 2;
+            }
+            if (!occurs) {
+                continue;
+            }
+            poison = qobject_to(
+                QDict, node_field(rule,
+                    CRUCIBLE_NODE_FAULT_FIELD_P6)->json);
+            if (strcmp(qdict_get_str(poison, "kind"), "corrected") != 0) {
+                if (strcmp(qdict_get_str(poison, "kind"), "exception") == 0) {
+                    CPUFaultException exception;
+
+                    g_assert(node_exception_decode(
+                        qdict_get(
+                            qdict_get_qdict(poison, "parameters"),
+                            "exception"),
+                        &exception));
+                    if (crucible_memory_transaction.has_exception &&
+                        memcmp(&crucible_memory_transaction.exception,
+                               &exception, sizeof(exception)) != 0) {
+                        error_report(
+                            "Conflicting Crucible memory exceptions escaped admission");
+                        abort();
+                    }
+                    crucible_memory_transaction.has_exception = true;
+                    crucible_memory_transaction.exception = exception;
+                }
+                crucible_memory_transaction.poisoned = true;
+                if (first_evaluation) {
+                    node_memory_event_span(0, selected);
+                    node_memory_event(
+                        rule, CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR,
+                        access_class, vcpu, vaddr + offset, gpa + offset,
+                        NULL, NULL, selected,
+                        crucible_memory_transaction.observed_icount);
+                }
+            }
+        } else if (rule->command_kind ==
+                   CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE) {
+            QDict *process;
+            QDict *policy;
+
+            g_assert(node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P3,
+                                    &kind));
+            if (kind != 1) {
+                continue;
+            }
+            if (rule->opportunity_count == UINT64_MAX ||
+                rule->applied_count == UINT64_MAX) {
+                node_memory_counter_terminal_metadata(UINT64_MAX);
+                node_memory_resource_terminal(
+                    rule, access_class, vcpu, vaddr + offset,
+                    gpa + offset, selected,
+                    crucible_memory_transaction.observed_icount);
+                crucible_memory_transaction.poisoned = true;
+                break;
+            }
+            if (g_hash_table_lookup(crucible_memory_transaction_poison,
+                                    rule)) {
+                continue;
+            }
+            g_hash_table_insert(crucible_memory_transaction_poison, rule,
+                                GUINT_TO_POINTER(2));
+            process = qobject_to(
+                QDict, node_field(rule,
+                    CRUCIBLE_NODE_FAULT_FIELD_P4)->json);
+            policy = qdict_get_qdict(
+                qdict_get_qdict(process, "parameters"), "policy");
+            if (strcmp(qdict_get_str(policy, "kind"), "corrected") != 0) {
+                if (strcmp(qdict_get_str(policy, "kind"), "exception") == 0) {
+                    CPUFaultException exception;
+
+                    g_assert(node_exception_decode(
+                        qdict_get(
+                            qdict_get_qdict(policy, "parameters"),
+                            "exception"),
+                        &exception));
+                    if (crucible_memory_transaction.has_exception &&
+                        memcmp(&crucible_memory_transaction.exception,
+                               &exception, sizeof(exception)) != 0) {
+                        error_report(
+                            "Conflicting Crucible memory exceptions escaped admission");
+                        abort();
+                    }
+                    crucible_memory_transaction.has_exception = true;
+                    crucible_memory_transaction.exception = exception;
+                }
+                crucible_memory_transaction.poisoned = true;
+                node_memory_state_opportunity(rule);
+                node_memory_state_applied(rule);
+                node_memory_event_span(0, selected);
+                node_memory_event(
+                    rule, CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR,
+                    access_class, vcpu, vaddr + offset, gpa + offset,
+                    NULL, NULL, selected,
+                    crucible_memory_transaction.observed_icount);
+            }
+        }
+    }
+    node_memory_matching_rules_done();
+}
+
+static bool node_memory_transaction_count_segment(
+    uint32_t access_class, uint32_t vcpu, uint64_t vaddr, uint64_t gpa,
+    size_t length, bool include_gva, uint64_t identity)
+{
+    CrucibleMemoryTransaction *transaction = &crucible_memory_transaction;
+    crucible_memory_preflight_collecting = true;
+    size_t match_count = node_memory_matching_rules_at(
+        vcpu, vaddr, gpa, length, include_gva, identity);
+    crucible_memory_preflight_collecting = false;
+
+    node_memory_snapshot_add_current(match_count);
+
+    if (transaction->event_budget > SIZE_MAX - match_count) {
+        error_report("Crucible memory transaction event budget overflow");
+        abort();
+    }
+    transaction->event_budget += match_count;
+    if (!transaction->streaming && match_count != 0 &&
+        !node_memory_event_capacity(
+            crucible_memory_matches[0], transaction->event_budget,
+            access_class, vcpu, vaddr, gpa, length,
+            transaction->observed_icount)) {
+        transaction->poisoned = true;
+        node_memory_matching_rules_done();
+        return false;
+    }
+    node_memory_matching_rules_done();
+    return true;
+}
+
+static bool node_memory_transaction_resources_segment(
+    uint32_t access_class, uint32_t vcpu, uint64_t vaddr, uint64_t gpa,
+    size_t length, bool include_gva, uint64_t identity,
+    GHashTable *counter_rules, GHashTable *row_plans,
+    GHashTable *retention_plans)
+{
+    size_t match_count;
+
+    crucible_memory_preflight_collecting = true;
+    crucible_memory_resource_planning = true;
+    match_count = node_memory_matching_rules_at(
+        vcpu, vaddr, gpa, length, include_gva, identity);
+
+    for (size_t i = 0; i < match_count; i++) {
+        QemuCrucibleFaultRule *rule = crucible_memory_matches[i];
+        size_t offset, selected;
+        uint64_t rule_offset;
+
+        if (!node_rule_memory_overlap_internal(
+                rule, vcpu, vaddr, gpa, length, &offset, &selected,
+                &rule_offset, false)) {
+            continue;
+        }
+        if (rule->command_kind ==
+            CRUCIBLE_FAULT_COMMAND_MEMORY_ACCESS_TRANSFORM) {
+            uint32_t classes;
+
+            g_assert(node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P8,
+                                    &classes));
+            if ((classes & access_class) == 0) {
+                continue;
+            }
+        }
+        if (!g_hash_table_contains(counter_rules, rule)) {
+            if (!node_memory_rule_resources_ready(rule)) {
+                node_memory_counter_terminal_metadata(UINT64_MAX);
+                node_memory_resource_terminal(
+                    rule, access_class, vcpu, vaddr + offset,
+                    gpa + offset, selected,
+                    crucible_memory_transaction.observed_icount);
+                crucible_memory_preflight_collecting = false;
+                crucible_memory_resource_planning = false;
+                node_memory_matching_rules_done();
+                return false;
+            }
+            g_hash_table_add(counter_rules, rule);
+        }
+        if (rule->command_kind ==
+            CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE) {
+            uint32_t kind;
+
+            g_assert(node_field_u32(rule,
+                                    CRUCIBLE_NODE_FAULT_FIELD_P3,
+                                    &kind));
+            if (kind == 2) {
+                QDict *process = qobject_to(
+                    QDict, node_field(rule,
+                        CRUCIBLE_NODE_FAULT_FIELD_P4)->json);
+                QDict *parameters = qdict_get_qdict(
+                    process, "parameters");
+
+                if (!node_memory_retention_resources_plan(
+                        rule, parameters, access_class, rule_offset,
+                        selected, retention_plans)) {
+                    node_memory_resource_terminal(
+                        rule, access_class, vcpu, vaddr + offset,
+                        gpa + offset, selected,
+                        crucible_memory_transaction.observed_icount);
+                    crucible_memory_preflight_collecting = false;
+                    crucible_memory_resource_planning = false;
+                    node_memory_matching_rules_done();
+                    return false;
+                }
+            } else if (kind == 3) {
+                QDict *process = qobject_to(
+                    QDict, node_field(rule,
+                        CRUCIBLE_NODE_FAULT_FIELD_P4)->json);
+                QDict *parameters = qdict_get_qdict(
+                    process, "parameters");
+
+                if (!node_memory_rowhammer_resources_plan(
+                        rule, parameters, rule_offset, selected,
+                        row_plans)) {
+                    node_memory_resource_terminal(
+                        rule, access_class, vcpu, vaddr + offset,
+                        gpa + offset, selected,
+                        crucible_memory_transaction.observed_icount);
+                    crucible_memory_preflight_collecting = false;
+                    crucible_memory_resource_planning = false;
+                    node_memory_matching_rules_done();
+                    return false;
+                }
+            }
+        }
+        if (rule->command_kind == CRUCIBLE_FAULT_COMMAND_MEMORY_SERVICE &&
+            !node_memory_service_plan_add(rule, selected)) {
+            node_memory_resource_terminal(
+                rule, access_class, vcpu, vaddr + offset, gpa + offset,
+                selected, crucible_memory_transaction.observed_icount);
+            crucible_memory_preflight_collecting = false;
+            crucible_memory_resource_planning = false;
+            node_memory_matching_rules_done();
+            return false;
+        }
+    }
+    crucible_memory_preflight_collecting = false;
+    crucible_memory_resource_planning = false;
+    node_memory_matching_rules_done();
+    return true;
+}
+
+static bool node_memory_transaction_resources_finish(
+    GHashTable *counter_rules, GHashTable *row_plans,
+    GHashTable *retention_plans)
+{
+    CrucibleMemoryTransaction *transaction = &crucible_memory_transaction;
+
+    if (!node_memory_service_plan_valid()) {
+        CrucibleMemoryServicePlan *plan = &g_array_index(
+            crucible_memory_service_plan, CrucibleMemoryServicePlan, 0);
+
+        crucible_memory_preflight_collecting = true;
+        node_memory_boundary_match(plan->rule, transaction->identity);
+        node_memory_resource_terminal(
+            plan->rule, transaction->access_class, transaction->actor,
+            transaction->address, transaction->address,
+            transaction->length, transaction->observed_icount);
+        node_memory_boundary_match_done();
+        crucible_memory_preflight_collecting = false;
+        transaction->poisoned = true;
+        transaction->resource_failed = true;
+        transaction->has_exception = false;
+        return false;
+    }
+    node_memory_resources_reserve(
+        counter_rules, row_plans, retention_plans);
+    transaction->resources_preflighted = true;
+    return true;
+}
+
+static void node_memory_transaction_preflight(
+    enum QemuCrucibleMemoryAccessClass access_class, uint32_t actor,
+    uint64_t address, size_t length, uint64_t identity)
+{
+    g_autoptr(GHashTable) counter_rules = g_hash_table_new(
+        g_direct_hash, g_direct_equal);
+    g_autoptr(GHashTable) row_plans = g_hash_table_new_full(
+        g_direct_hash, g_direct_equal, NULL,
+        node_memory_row_resource_plan_free);
+    g_autoptr(GHashTable) retention_plans = g_hash_table_new_full(
+        g_direct_hash, g_direct_equal, NULL,
+        node_memory_retention_resource_plan_free);
+
+    if (!crucible_memory_transaction_poison) {
+        crucible_memory_transaction_poison = g_hash_table_new(
+            g_direct_hash, g_direct_equal);
+    } else {
+        g_hash_table_remove_all(crucible_memory_transaction_poison);
+    }
+    node_memory_service_plan_reset();
+
+    CPUState *cpu = qemu_get_cpu(actor);
+    uint64_t current = address;
+    size_t remaining = length;
+
+    if (!cpu) {
+        crucible_memory_transaction.poisoned = true;
+        return;
+    }
+    while (remaining != 0) {
+        CPUFaultTranslation translation;
+        uint64_t page_offset;
+        size_t part;
+
+        MMUAccessType mmu_access = access_class ==
+                QEMU_CRUCIBLE_MEMORY_FETCH ? MMU_INST_FETCH :
+            access_class == QEMU_CRUCIBLE_MEMORY_CPU_STORE ?
+                MMU_DATA_STORE : MMU_DATA_LOAD;
+
+        if (!cpu_get_fault_translation(cpu, current, mmu_access,
+                                       &translation) ||
+            translation.page_size == 0) {
+            crucible_memory_transaction.poisoned = true;
+            return;
+        }
+        page_offset = current % translation.page_size;
+        part = MIN(remaining, translation.page_size - page_offset);
+        if (!node_memory_transaction_count_segment(
+                access_class, actor, current,
+                translation.physical_address, part, true, identity)) {
+            return;
+        }
+        current += part;
+        remaining -= part;
+    }
+    current = address;
+    remaining = length;
+    while (remaining != 0) {
+        CPUFaultTranslation translation;
+        uint64_t page_offset;
+        size_t part;
+        MMUAccessType mmu_access = access_class ==
+                QEMU_CRUCIBLE_MEMORY_FETCH ? MMU_INST_FETCH :
+            access_class == QEMU_CRUCIBLE_MEMORY_CPU_STORE ?
+                MMU_DATA_STORE : MMU_DATA_LOAD;
+
+        if (!cpu_get_fault_translation(cpu, current, mmu_access,
+                                       &translation) ||
+            translation.page_size == 0) {
+            crucible_memory_transaction.poisoned = true;
+            return;
+        }
+        page_offset = current % translation.page_size;
+        part = MIN(remaining, translation.page_size - page_offset);
+        if (!node_memory_transaction_resources_segment(
+                access_class, actor, current,
+                translation.physical_address, part, true, identity,
+                counter_rules, row_plans, retention_plans)) {
+            crucible_memory_transaction.poisoned = true;
+            return;
+        }
+        current += part;
+        remaining -= part;
+    }
+    if (!node_memory_transaction_resources_finish(
+            counter_rules, row_plans, retention_plans)) {
+        return;
+    }
+    current = address;
+    remaining = length;
+    while (remaining != 0) {
+        CPUFaultTranslation translation;
+        uint64_t page_offset;
+        size_t part;
+        MMUAccessType mmu_access = access_class ==
+                QEMU_CRUCIBLE_MEMORY_FETCH ? MMU_INST_FETCH :
+            access_class == QEMU_CRUCIBLE_MEMORY_CPU_STORE ?
+                MMU_DATA_STORE : MMU_DATA_LOAD;
+
+        if (!cpu_get_fault_translation(cpu, current, mmu_access,
+                                       &translation) ||
+            translation.page_size == 0) {
+            crucible_memory_transaction.poisoned = true;
+            return;
+        }
+        page_offset = current % translation.page_size;
+        part = MIN(remaining, translation.page_size - page_offset);
+        node_memory_transaction_preflight_segment(
+            access_class, actor, current, translation.physical_address,
+            part, true, identity);
+        current += part;
+        remaining -= part;
+    }
+}
+
+static void node_memory_transaction_preflight_physical(
+    enum QemuCrucibleMemoryAccessClass access_class, uint32_t actor,
+    uint64_t target_vaddr, uint64_t gpa, size_t length, uint64_t identity)
+{
+    g_autoptr(GHashTable) counter_rules = g_hash_table_new(
+        g_direct_hash, g_direct_equal);
+    g_autoptr(GHashTable) row_plans = g_hash_table_new_full(
+        g_direct_hash, g_direct_equal, NULL,
+        node_memory_row_resource_plan_free);
+    g_autoptr(GHashTable) retention_plans = g_hash_table_new_full(
+        g_direct_hash, g_direct_equal, NULL,
+        node_memory_retention_resource_plan_free);
+
+    if (!node_memory_transaction_count_segment(
+            access_class, actor, target_vaddr, gpa, length, false,
+            identity)) {
+        return;
+    }
+    if (!node_memory_transaction_resources_segment(
+            access_class, actor, target_vaddr, gpa, length, false,
+            identity, counter_rules, row_plans, retention_plans)) {
+        crucible_memory_transaction.poisoned = true;
+        return;
+    }
+    if (!node_memory_transaction_resources_finish(
+            counter_rules, row_plans, retention_plans)) {
+        return;
+    }
+    node_memory_transaction_preflight_segment(
+        access_class, actor, target_vaddr, gpa, length, false, identity);
+}
