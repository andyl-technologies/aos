+static bool node_rule_physical_span(QemuCrucibleFaultRule *rule,
+                                    uint64_t rule_offset, uint64_t *gpa,
+                                    uint64_t *available)
+{
+    uint64_t start, length;
+    bool has_vcpu;
+
+    if (!node_rule_memory_range(rule, &start, &length) ||
+        rule_offset >= length ||
+        !node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_T3, &has_vcpu)) {
+        return false;
+    }
+    if (!has_vcpu) {
+        *gpa = start + rule_offset;
+        *available = length - rule_offset;
+        return true;
+    }
+
+    uint64_t logical = start + rule_offset;
+
+    for (guint i = 0; i < rule->translations->len; i++) {
+        CrucibleNodeTranslation *translation = &g_array_index(
+            rule->translations, CrucibleNodeTranslation, i);
+        uint64_t covered_start = MAX(start, translation->virtual_page);
+        uint64_t covered_end = covered_start + translation->covered_bytes;
+
+        if (logical >= covered_start && logical < covered_end) {
+            *gpa = translation->physical_page +
+                   (logical - translation->virtual_page);
+            *available = covered_end - logical;
+            return true;
+        }
+    }
+    return false;
+}
