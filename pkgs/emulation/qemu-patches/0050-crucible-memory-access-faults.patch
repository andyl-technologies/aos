+static void test_payload_target(uint64_t address, uint64_t length,
+                                bool virtual_address)
+{
+    uint8_t node_hash[32];
+
+    memset(node_hash, 0x11, sizeof(node_hash));
+    test_field(CRUCIBLE_NODE_FAULT_FIELD_T1,
+               CRUCIBLE_NODE_FAULT_FIELD_TYPE_HASH,
+               node_hash, sizeof(node_hash));
+    test_field_u64(CRUCIBLE_NODE_FAULT_FIELD_T2, address);
+    test_field_bool(CRUCIBLE_NODE_FAULT_FIELD_T3, virtual_address);
+    test_field_u32(CRUCIBLE_NODE_FAULT_FIELD_T4, 0);
+    test_field_u64(CRUCIBLE_NODE_FAULT_FIELD_T5, length);
+}
