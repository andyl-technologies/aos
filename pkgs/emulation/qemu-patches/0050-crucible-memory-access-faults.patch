+static const QObject *node_memory_poison_exception(
+    QemuCrucibleFaultRule *rule)
+{
+    QDict *poison = node_memory_poison_policy(rule);
+
+    if (!poison || strcmp(qdict_get_str(poison, "kind"), "exception") != 0) {
+        return NULL;
+    }
+    return qdict_get(
+        qdict_get_qdict(poison, "parameters"), "exception");
+}
