+static bool node_field_matches(const QemuCrucibleFaultRule *rule,
+                               const NodeSchemaField *schema)
+{
+    for (size_t i = 0; i < rule->field_count; i++) {
+        if (rule->fields[i].tag == schema->tag) {
+            return rule->fields[i].type == schema->type;
+        }
+    }
+    return false;
+}
+
+static CrucibleNodeField *node_field(QemuCrucibleFaultRule *rule, uint16_t tag)
+{
+    for (size_t i = 0; i < rule->field_count; i++) {
+        if (rule->fields[i].tag == tag) {
+            return &rule->fields[i];
+        }
+    }
+    return NULL;
+}
+
+static bool node_field_u32(QemuCrucibleFaultRule *rule, uint16_t tag,
+                           uint32_t *value)
+{
+    CrucibleNodeField *field = node_field(rule, tag);
+
+    if (!field || field->type != CRUCIBLE_NODE_FAULT_FIELD_TYPE_U32) {
+        return false;
+    }
+    *value = node_get_u32(field->data);
+    return true;
+}
+
+static bool node_field_u64(QemuCrucibleFaultRule *rule, uint16_t tag,
+                           uint64_t *value)
+{
+    CrucibleNodeField *field = node_field(rule, tag);
+
+    if (!field || field->type != CRUCIBLE_NODE_FAULT_FIELD_TYPE_U64) {
+        return false;
+    }
+    *value = node_get_u64(field->data);
+    return true;
+}
+
+static bool node_field_bool(QemuCrucibleFaultRule *rule, uint16_t tag,
+                            bool *value)
+{
+    CrucibleNodeField *field = node_field(rule, tag);
+
+    if (!field || field->type != CRUCIBLE_NODE_FAULT_FIELD_TYPE_BOOL) {
+        return false;
+    }
+    *value = field->data[0] != 0;
+    return true;
+}
+
+static bool node_field_zero(QemuCrucibleFaultRule *rule, uint16_t tag)
+{
+    CrucibleNodeField *field = node_field(rule, tag);
+    uint8_t aggregate = 0;
+
+    if (!field) {
+        return false;
+    }
+    for (size_t i = 0; i < field->length; i++) {
+        aggregate |= field->data[i];
+    }
+    return aggregate == 0;
+}
+
+static bool node_field_nonzero(QemuCrucibleFaultRule *rule, uint16_t tag)
+{
+    return !node_field_zero(rule, tag);
+}
