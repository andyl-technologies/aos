+
+int qemu_plugin_crucible_fault_event_poll(
+    struct qemu_plugin_crucible_fault_event *event, uint8_t *payload,
+    size_t payload_capacity, size_t *payload_length)
+{
+    CrucibleNodeEvent *queued;
+
+    if (!event || !payload_length) {
+        return -EINVAL;
+    }
+    node_events_ensure();
+    queued = QTAILQ_FIRST(&crucible_node_events);
+    if (!queued) {
+        return 0;
+    }
+    *payload_length = queued->payload_length;
+    if (queued->payload_length > payload_capacity ||
+        (queued->payload_length != 0 && !payload)) {
+        return -ENOSPC;
+    }
+    *event = queued->event;
+    memcpy(payload, queued->payload ? queued->payload->data :
+                                     queued->inline_payload,
+           queued->payload_length);
+    QTAILQ_REMOVE(&crucible_node_events, queued, link);
+    crucible_node_event_count--;
+    g_clear_pointer(&queued->payload, g_byte_array_unref);
+    queued->payload_length = 0;
+    QTAILQ_INSERT_TAIL(&crucible_node_free_events, queued, link);
+    return 1;
+}
