+static bool node_json_occurrence(const QObject *object)
+{
+    QObject *parameters;
+    QDict *dict;
+    uint64_t first, period, count;
+
+    if (node_json_tag(object, "every", false, NULL)) {
+        return true;
+    }
+    if (!node_json_tag(object, "periodic", true, &parameters)) {
+        return false;
+    }
+    dict = qobject_to(QDict, parameters);
+    if (!dict ||
+        !NODE_EXACT(dict, "count", "first", "period") ||
+        !node_json_u64(qdict_get(dict, "first"), &first) ||
+        !node_json_positive(qdict_get(dict, "period"), &period) ||
+        !node_json_positive(qdict_get(dict, "count"), &count) ||
+        count > 4194304) {
+        return false;
+    }
+    return count - 1 <= (UINT64_MAX - first) / period;
+}
