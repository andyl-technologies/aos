+static QemuCrucibleFaultRule *
+node_memory_shadow_rule_copy(const QemuCrucibleFaultRule *source)
+{
+    QemuCrucibleFaultRule *copy = node_rule_copy(source);
+
+    g_clear_pointer(&copy->retention_cells, g_hash_table_unref);
+    g_clear_pointer(&copy->row_counters, g_hash_table_unref);
+    copy->retention_cells = node_memory_retention_cells_copy(
+        source->retention_cells);
+    copy->row_counters = node_memory_row_counters_copy(
+        source->row_counters);
+    if (source->evidence_mutation_records) {
+        copy->evidence_mutation_records = g_byte_array_sized_new(
+            source->evidence_mutation_records->len);
+        g_byte_array_append(copy->evidence_mutation_records,
+                            source->evidence_mutation_records->data,
+                            source->evidence_mutation_records->len);
+    }
+    if (source->evidence_counter_records) {
+        copy->evidence_counter_records = g_byte_array_sized_new(
+            source->evidence_counter_records->len);
+        g_byte_array_append(copy->evidence_counter_records,
+                            source->evidence_counter_records->data,
+                            source->evidence_counter_records->len);
+    }
+    if (source->service_ledger) {
+        g_assert(source->service_ledger->references != UINT32_MAX);
+        source->service_ledger->references++;
+        copy->service_ledger = source->service_ledger;
+    }
+    return copy;
+}
