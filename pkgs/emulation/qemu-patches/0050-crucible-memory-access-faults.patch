+static bool node_field_u64(QemuCrucibleFaultRule *rule, uint16_t tag,
+                           uint64_t *value)
+{
+    CrucibleNodeField *field = node_field(rule, tag);
+
+    if (!field || field->type != CRUCIBLE_NODE_FAULT_FIELD_TYPE_U64) {
+        return false;
