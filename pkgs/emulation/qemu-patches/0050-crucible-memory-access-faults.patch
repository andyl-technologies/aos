+static void node_memory_mutation_evidence_reset(QemuCrucibleFaultRule *rule)
+{
+    rule->evidence_mutation_count = 0;
+    rule->evidence_mutation_bytes = 0;
+    memset(rule->evidence_mutation_hash, 0,
+           sizeof(rule->evidence_mutation_hash));
+    memset(&rule->evidence_aggressor, 0,
+           sizeof(rule->evidence_aggressor));
+    rule->evidence_counter_before = 0;
+    rule->evidence_counter_after = 0;
+    rule->evidence_victim_rows = 0;
+    if (rule->evidence_mutation_records) {
+        g_byte_array_set_size(rule->evidence_mutation_records, 0);
+    }
+    if (rule->evidence_counter_records) {
+        g_byte_array_set_size(rule->evidence_counter_records, 0);
+    }
+}
+
+static void node_memory_counter_evidence_add(
+    QemuCrucibleFaultRule *rule,
+    const CrucibleDramCoordinate *coordinate,
+    uint64_t before, uint64_t after)
+{
+    uint8_t record[64] = { 0 };
+
+    if (!rule->evidence_counter_records) {
+        rule->evidence_counter_records = g_byte_array_new();
+    }
+    g_assert(rule->evidence_counter_records->len <=
+             CRUCIBLE_FAULT_HARD_PAYLOAD_BYTES - sizeof(record));
+    memcpy(record, "CRUCROW1", 8);
+    stq_le_p(record + 8, coordinate->row);
+    stw_le_p(record + 16, coordinate->channel);
+    stw_le_p(record + 18, coordinate->rank);
+    stw_le_p(record + 20, coordinate->bank);
+    stq_le_p(record + 24, before);
+    stq_le_p(record + 32, after);
+    g_byte_array_append(rule->evidence_counter_records,
+                        record, sizeof(record));
+}
+
+static void node_memory_mutation_evidence_add(QemuCrucibleFaultRule *rule,
+                                              uint64_t physical,
+                                              uint64_t rule_offset,
+                                              const uint8_t *before,
+                                              const uint8_t *after,
+                                              size_t length, bool clear)
+{
+    uint8_t record[128] = { 0 };
+    uint8_t exact[96] = { 0 };
+
+    g_assert(rule->evidence_mutation_count != UINT64_MAX);
+    g_assert(rule->evidence_mutation_bytes <= UINT64_MAX - length);
+    memcpy(record, rule->evidence_mutation_hash, 32);
+    stq_le_p(record + 32, physical);
+    stq_le_p(record + 40, rule_offset);
+    stq_le_p(record + 48, length);
+    stl_le_p(record + 56, clear);
+    node_memory_sha256(before, length, record + 64);
+    node_memory_sha256(after, length, record + 96);
+    node_memory_sha256(record, sizeof(record),
+                       rule->evidence_mutation_hash);
+    rule->evidence_mutation_count++;
+    rule->evidence_mutation_bytes += length;
+    if (!rule->evidence_mutation_records) {
+        rule->evidence_mutation_records = g_byte_array_new();
+    }
+    g_assert(rule->evidence_mutation_records->len <=
+             CRUCIBLE_FAULT_HARD_PAYLOAD_BYTES - sizeof(exact));
+    stq_le_p(exact, physical);
+    stq_le_p(exact + 8, rule_offset);
+    stq_le_p(exact + 16, length);
+    stl_le_p(exact + 24, clear);
+    node_memory_sha256(before, length, exact + 32);
+    node_memory_sha256(after, length, exact + 64);
+    g_byte_array_append(rule->evidence_mutation_records, exact,
+                        sizeof(exact));
+}
