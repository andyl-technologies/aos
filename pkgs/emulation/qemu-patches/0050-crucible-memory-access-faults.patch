+static Int128 crucible_fault_int128_from_memory(const uint8_t value[16])
+{
+    if (HOST_BIG_ENDIAN) {
+        return int128_make128(ldq_be_p(value + 8), ldq_be_p(value));
+    }
+    return int128_make128(ldq_le_p(value), ldq_le_p(value + 8));
+}
+
+static void crucible_fault_int128_to_memory(uint8_t value[16], Int128 number)
+{
+    if (HOST_BIG_ENDIAN) {
+        stq_be_p(value, int128_gethi(number));
+        stq_be_p(value + 8, int128_getlo(number));
+    } else {
+        stq_le_p(value, int128_getlo(number));
+        stq_le_p(value + 8, int128_gethi(number));
+    }
+}
