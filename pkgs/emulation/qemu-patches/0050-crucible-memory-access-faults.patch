+typedef bool (*NodeJsonValidator)(const QObject *object);
+
+static bool node_policy_parse(CrucibleNodeField *field,
+                              NodeJsonValidator validator)
+{
+    const size_t magic_len = CRUCIBLE_NODE_FAULT_POLICY_JSON_MAGIC_V1_BYTES;
+    g_autofree char *text = NULL;
+    Error *error = NULL;
+    QObject *object;
+
+    if (!field || field->type != CRUCIBLE_NODE_FAULT_FIELD_TYPE_BYTES ||
+        field->length <= magic_len ||
+        memcmp(field->data, CRUCIBLE_NODE_FAULT_POLICY_JSON_MAGIC_V1,
+               magic_len) != 0 ||
+        !node_json_canonical(field->data + magic_len,
+                             field->length - magic_len)) {
+        return false;
+    }
+    text = g_strndup((const char *)field->data + magic_len,
+                     field->length - magic_len);
+    object = qobject_from_json(text, &error);
+    if (!object || error || !validator(object)) {
+        error_free(error);
+        qobject_unref(object);
+        return false;
+    }
+    field->json = object;
+    return true;
+}
+
+static bool node_json_vcpus(const QObject *object)
+{
+    return node_json_sorted_vcpus(object);
+}
+
+static bool node_json_hang_scope_any(const QObject *object)
+{
+    return node_json_hang_scope(object, 1) ||
+           node_json_hang_scope(object, 2) ||
+           node_json_hang_scope(object, 3);
+}
+
+static bool node_json_memory_region_any(const QObject *object)
+{
+    return node_json_memory_region(object, 1) ||
+           node_json_memory_region(object, 2) ||
+           node_json_memory_region(object, 3);
+}
+
+static bool node_json_clock_release_any(const QObject *object)
+{
+    return node_json_clock_release(object);
+}
+
+static bool node_json_jitter_any(const QObject *object)
+{
+    return node_json_jitter(object, UINT64_MAX);
+}
+
+static bool node_json_wander_any(const QObject *object)
+{
+    return node_json_wander(object);
+}
