+    SCHEMA(INTERRUPT_STORM, schema_irq_storm);
+    SCHEMA(MEMORY_ACCESS_TRANSFORM, schema_memory_access);
+    SCHEMA(MEMORY_ECC_EVENT, schema_memory_ecc);
+    SCHEMA(MEMORY_REGION_STATE, schema_memory_region);
+    SCHEMA(MEMORY_SERVICE, schema_service);
+    SCHEMA(CLOCK_TRANSFORM, schema_clock);
+    SCHEMA(CLOCK_SOURCE_STATE, schema_clock_source);
+    SCHEMA(ACCELERATOR_LIFECYCLE, schema_accel_lifecycle);
+    SCHEMA(ACCELERATOR_RESULT_TRANSFORM, schema_accel_result);
+    SCHEMA(ACCELERATOR_MEMORY_EVENT, schema_accel_memory);
+    SCHEMA(ACCELERATOR_SERVICE, schema_service);
