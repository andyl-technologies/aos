+MemTxResult address_space_rw_crucible_dma_frozen(void *buf, hwaddr len,
+                                                  bool is_write)
+{
+    enum QemuCrucibleMemoryAccessClass access_class = is_write ?
+        QEMU_CRUCIBLE_MEMORY_DMA_WRITE : QEMU_CRUCIBLE_MEMORY_DMA_READ;
+    uint8_t *bytes = buf;
+    hwaddr offset = 0;
+
+    RCU_READ_LOCK_GUARD();
+    while (offset != len) {
+        MemoryRegion *mr;
+        uint64_t mr_addr;
+        uint64_t gpa;
+        size_t fragment = len - offset;
+        hwaddr mapped;
+        uint8_t *ram_ptr;
+
+        if (!qemu_crucible_fault_memory_dma_fragment(
+                offset, &mr, &mr_addr, &gpa, &fragment) || fragment == 0) {
+            return MEMTX_ERROR;
+        }
+        mapped = fragment;
+        ram_ptr = qemu_ram_ptr_length(mr->ram_block, mr_addr, &mapped,
+                                      false, is_write);
+        if (mapped == 0) {
+            return MEMTX_ERROR;
+        }
+        fragment = MIN(fragment, mapped);
+        for (size_t done = 0; done != fragment;) {
+            size_t part = MIN((size_t)4096, fragment - done);
+            QemuCrucibleMemoryAccessResult fault;
+
+            if (is_write) {
+                uint8_t value[4096];
+
+                memcpy(value, bytes + offset + done, part);
+                fault = qemu_crucible_fault_memory_access(
+                    access_class, crucible_dma_actor_id(),
+                    gpa + done, gpa + done, ram_ptr + done, value,
+                    part, false, qemu_crucible_fault_observed_icount());
+                if (fault.access_error) {
+                    return MEMTX_ERROR;
+                }
+                if (!fault.suppress_write) {
+                    memmove(ram_ptr + done, value, part);
+                    invalidate_and_set_dirty(mr, mr_addr + done, part);
+                }
+                qemu_crucible_fault_memory_access_finish(ram_ptr + done,
+                                                          part);
+            } else {
+                memcpy(bytes + offset + done, ram_ptr + done, part);
+                fault = qemu_crucible_fault_memory_access(
+                    access_class, crucible_dma_actor_id(),
+                    gpa + done, gpa + done, ram_ptr + done,
+                    bytes + offset + done, part, false,
+                    qemu_crucible_fault_observed_icount());
+                if (fault.access_error) {
+                    return MEMTX_ERROR;
+                }
+            }
+            done += part;
+        }
+        offset += fragment;
+    }
+    return MEMTX_OK;
+}
