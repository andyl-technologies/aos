+static QemuCrucibleFaultRule *
+node_rule_copy(const QemuCrucibleFaultRule *source)
+{
+    QemuCrucibleFaultRule *copy = g_new0(QemuCrucibleFaultRule, 1);
+
+    *copy = *source;
+    copy->references = 1;
+    copy->payload = g_memdup2(source->payload, source->payload_len);
+    for (size_t i = 0; i < copy->field_count; i++) {
+        ptrdiff_t offset = source->fields[i].data - source->payload;
+        copy->fields[i].data = copy->payload + offset;
+        copy->fields[i].json = qobject_ref(source->fields[i].json);
+    }
+    copy->row_counts = source->row_counts ?
+        g_array_ref(source->row_counts) : NULL;
+    copy->translations = source->translations ?
+        g_array_ref(source->translations) : NULL;
+    copy->retention_cells = source->retention_cells ?
+        g_hash_table_ref(source->retention_cells) : NULL;
+    copy->row_counters = source->row_counters ?
+        g_hash_table_ref(source->row_counters) : NULL;
+    copy->service_ledger = NULL;
+    copy->evidence_mutation_records = NULL;
+    copy->evidence_counter_records = NULL;
+    return copy;
+}
+
+static GHashTable *node_memory_retention_cells_copy(GHashTable *source)
+{
+    GHashTable *copy;
+    GHashTableIter iter;
+    gpointer key;
+    gpointer value;
+
+    if (!source) {
+        return NULL;
+    }
+    copy = g_hash_table_new_full(
+        g_int64_hash, g_int64_equal, g_free, g_free);
+    g_hash_table_iter_init(&iter, source);
+    while (g_hash_table_iter_next(&iter, &key, &value)) {
+        g_hash_table_insert(copy, g_memdup2(key, sizeof(uint64_t)),
+                            g_memdup2(value, sizeof(CrucibleRetentionCell)));
+    }
+    return copy;
+}
+
+static GHashTable *node_memory_row_counters_copy(GHashTable *source)
+{
+    GHashTable *copy;
+    GHashTableIter iter;
+    gpointer key;
+    gpointer value;
+
+    if (!source) {
+        return NULL;
+    }
+    copy = g_hash_table_new_full(
+        node_dram_coordinate_hash, node_dram_coordinate_equal,
+        g_free, g_free);
+    g_hash_table_iter_init(&iter, source);
+    while (g_hash_table_iter_next(&iter, &key, &value)) {
+        g_hash_table_insert(
+            copy, g_memdup2(key, sizeof(CrucibleDramCoordinate)),
+            g_memdup2(value, sizeof(uint64_t)));
+    }
+    return copy;
+}
