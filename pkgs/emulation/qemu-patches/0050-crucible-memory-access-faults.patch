+bool x86_cpu_validate_fault_exception(
+    CPUState *cs, const CPUFaultException *exception)
+{
+    return exception->architecture == CPU_FAULT_EXCEPTION_X86_64 &&
+           exception->record == CPU_FAULT_EXCEPTION_ARCHITECTURE_DEFAULT &&
+           exception->vector < 32 && exception->before_instruction &&
+           !exception->maskable &&
+           (exception->vector == EXCP0E_PAGE ||
+            !exception->has_fault_address);
+}
+
+void x86_cpu_inject_fault_exception(
+    CPUState *cs, const CPUFaultException *exception, uintptr_t retaddr)
+{
+    CPUX86State *env = cpu_env(cs);
+
+    if (exception->has_fault_address) {
+        env->cr[2] = exception->fault_address;
+    }
+    if (retaddr) {
+        raise_exception_err_ra(env, exception->vector, exception->syndrome,
+                               retaddr);
+    }
+    raise_exception_err(env, exception->vector, exception->syndrome);
+}
+
+void x86_cpu_inject_fault_access_error(
+    CPUState *cs, vaddr address, unsigned size,
+    MMUAccessType access_type, uintptr_t retaddr)
+{
+    CPUX86State *env = cpu_env(cs);
+    int error_code = access_type == MMU_DATA_STORE ? PG_ERROR_W_MASK : 0;
+
+    if (access_type == MMU_INST_FETCH) {
+        error_code |= PG_ERROR_I_D_MASK;
+    }
+    if (is_mmu_index_user(cpu_mmu_index(cs, false))) {
+        error_code |= PG_ERROR_U_MASK;
+    }
+    env->cr[2] = address;
+    if (retaddr) {
+        raise_exception_err_ra(env, EXCP0E_PAGE, error_code, retaddr);
+    }
+    raise_exception_err(env, EXCP0E_PAGE, error_code);
+}
