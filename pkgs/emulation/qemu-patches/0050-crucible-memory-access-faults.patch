+static bool node_field_matches(const QemuCrucibleFaultRule *rule,
+                               const NodeSchemaField *schema)
+{
+    for (size_t i = 0; i < rule->field_count; i++) {
+        if (rule->fields[i].tag == schema->tag) {
+            return rule->fields[i].type == schema->type;
+        }
+    }
+    return false;
+}
