+static hwaddr crucible_fault_gpa(const MMULookupPageData *p)
+{
+    return p->full->phys_addr | (p->addr & ~TARGET_PAGE_MASK);
+}
+
+static enum QemuCrucibleMemoryAccessClass
+crucible_fault_load_class(MMUAccessType type)
+{
+    return type == MMU_INST_FETCH ? QEMU_CRUCIBLE_MEMORY_FETCH :
+                                    QEMU_CRUCIBLE_MEMORY_CPU_LOAD;
+}
+
+static bool crucible_fault_memory_value(
+    CPUState *cpu, MMULookupPageData *p,
+    enum QemuCrucibleMemoryAccessClass access_class, uint8_t *value,
+    size_t length, bool atomic, int mmu_idx, uintptr_t ra)
+{
+    uint8_t before[16];
+    QemuCrucibleMemoryAccessResult result;
+    MMUAccessType type = access_class == QEMU_CRUCIBLE_MEMORY_CPU_STORE ?
+                         MMU_DATA_STORE :
+                         (access_class == QEMU_CRUCIBLE_MEMORY_FETCH ?
+                          MMU_INST_FETCH : MMU_DATA_LOAD);
+
+    g_assert(length <= sizeof(before));
+    memcpy(before, p->haddr, length);
+    result = qemu_crucible_fault_memory_access(
+        access_class, cpu->cpu_index, p->addr, crucible_fault_gpa(p), before,
+        value, length, atomic, qemu_plugin_icount_raw());
+    if (result.access_error) {
+        qemu_crucible_fault_memory_transaction_end();
+        io_failed(cpu, p->full, p->addr, length, type, mmu_idx,
+                  MEMTX_ERROR, ra);
+    }
+    return result.suppress_write;
+}
+
+static void crucible_fault_memory_store_finish(MMULookupPageData *p)
+{
+    qemu_crucible_fault_memory_access_finish(p->haddr, p->size);
+}
+
+static uint64_t crucible_fault_store_done(MMULookupPageData *p,
+                                          uint64_t remainder)
+{
+    crucible_fault_memory_store_finish(p);
+    return remainder;
+}
+
+static Int128 crucible_fault_int128_from_memory(const uint8_t value[16])
+{
+    if (HOST_BIG_ENDIAN) {
+        return int128_make128(ldq_be_p(value + 8), ldq_be_p(value));
+    }
+    return int128_make128(ldq_le_p(value), ldq_le_p(value + 8));
+}
