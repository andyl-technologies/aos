+static QemuCrucibleFaultRule *node_find_rule(uint16_t command_kind,
+                                             const uint8_t binding_hash[32],
+                                             guint *index_out)
+{
+    node_rules_ensure();
+    for (guint i = 0; i < crucible_node_rules->len; i++) {
+        QemuCrucibleFaultRule *rule = g_ptr_array_index(crucible_node_rules, i);
+        if (rule->command_kind == command_kind &&
+            memcmp(rule->binding_hash, binding_hash, 32) == 0) {
+            if (index_out) {
+                *index_out = i;
+            }
+            return rule;
+        }
+    }
+    return NULL;
+}
+
+static void node_rules_digest_with(const QemuCrucibleFaultRule *replacement,
+                                   bool remove, uint8_t out[32])
+{
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    g_autoptr(GPtrArray) ordered = g_ptr_array_new();
+    gsize digest_len = 32;
+    bool inserted = false;
+
+    node_rules_ensure();
+    for (guint i = 0; i < crucible_node_rules->len; i++) {
+        QemuCrucibleFaultRule *rule = g_ptr_array_index(crucible_node_rules, i);
+        if (replacement && rule->command_kind == replacement->command_kind &&
+            memcmp(rule->binding_hash, replacement->binding_hash, 32) == 0) {
+            if (!remove) {
+                g_ptr_array_add(ordered, (void *)replacement);
+                inserted = true;
+            }
+        } else {
+            g_ptr_array_add(ordered, rule);
+        }
+    }
+    if (replacement && !remove && !inserted) {
+        g_ptr_array_add(ordered, (void *)replacement);
+    }
+    g_ptr_array_sort(ordered, node_rule_compare);
+    g_checksum_update(checksum, (const guchar *)"crucible.node-rules.v1", 22);
+    for (guint i = 0; i < ordered->len; i++) {
+        QemuCrucibleFaultRule *rule = g_ptr_array_index(ordered, i);
+        g_checksum_update(checksum, rule->payload, rule->payload_len);
+        g_checksum_update(checksum, rule->binding_hash, 32);
+        g_checksum_update(checksum, (const guchar *)&rule->command_sequence,
+                          sizeof(rule->command_sequence));
+    }
+    g_checksum_get_digest(checksum, out, &digest_len);
+    g_assert(digest_len == 32);
+}
+
+typedef struct NodeJsonCursor {
+    const uint8_t *data;
+    size_t len;
+    size_t pos;
+    unsigned depth;
+} NodeJsonCursor;
+
+static bool node_json_scan_value(NodeJsonCursor *cursor);
+
+static bool node_json_scan_string(NodeJsonCursor *cursor,
+                                  const uint8_t **start, size_t *length)
+{
+    size_t begin;
+
+    if (cursor->pos >= cursor->len || cursor->data[cursor->pos++] != '"') {
+        return false;
+    }
+    begin = cursor->pos;
+    while (cursor->pos < cursor->len && cursor->data[cursor->pos] != '"') {
+        uint8_t byte = cursor->data[cursor->pos++];
+
+        /* Closed policy strings are printable unescaped ASCII. */
+        if (byte < 0x20 || byte > 0x7e || byte == '\\') {
+            return false;
+        }
+    }
+    if (cursor->pos >= cursor->len) {
+        return false;
+    }
+    if (start) {
+        *start = cursor->data + begin;
+    }
+    if (length) {
+        *length = cursor->pos - begin;
+    }
+    cursor->pos++;
+    return true;
+}
+
+static bool node_json_scan_number(NodeJsonCursor *cursor)
+{
+    size_t begin = cursor->pos;
+
+    if (cursor->data[cursor->pos] == '-') {
+        cursor->pos++;
+        if (cursor->pos >= cursor->len || cursor->data[cursor->pos] == '0') {
+            return false;
+        }
+    }
+    if (cursor->pos >= cursor->len ||
+        !g_ascii_isdigit(cursor->data[cursor->pos])) {
+        return false;
+    }
+    if (cursor->data[cursor->pos] == '0') {
+        cursor->pos++;
+        return cursor->pos == cursor->len ||
+               !g_ascii_isdigit(cursor->data[cursor->pos]);
+    }
+    while (cursor->pos < cursor->len &&
+           g_ascii_isdigit(cursor->data[cursor->pos])) {
+        cursor->pos++;
+    }
+    return cursor->pos > begin;
+}
+
+static bool node_json_scan_array(NodeJsonCursor *cursor)
+{
+    if (++cursor->depth > 64) {
+        return false;
+    }
+    cursor->pos++;
+    if (cursor->pos < cursor->len && cursor->data[cursor->pos] == ']') {
+        cursor->pos++;
+        cursor->depth--;
+        return true;
+    }
+    for (;;) {
+        if (!node_json_scan_value(cursor) || cursor->pos >= cursor->len) {
+            return false;
+        }
+        if (cursor->data[cursor->pos] == ']') {
+            cursor->pos++;
+            cursor->depth--;
+            return true;
+        }
+        if (cursor->data[cursor->pos++] != ',') {
+            return false;
+        }
+    }
+}
+
+static bool node_json_scan_object(NodeJsonCursor *cursor)
+{
+    g_autofree uint8_t *previous = NULL;
+    size_t previous_len = 0;
+
+    if (++cursor->depth > 64) {
+        return false;
+    }
+    cursor->pos++;
+    if (cursor->pos < cursor->len && cursor->data[cursor->pos] == '}') {
+        cursor->pos++;
+        cursor->depth--;
+        return true;
+    }
+    for (;;) {
+        const uint8_t *key;
+        size_t key_len;
+        size_t common;
+        int order;
+
+        if (!node_json_scan_string(cursor, &key, &key_len)) {
+            return false;
+        }
+        common = MIN(previous_len, key_len);
+        order = previous ? memcmp(previous, key, common) : -1;
+        if (previous &&
+            (order > 0 || (order == 0 && previous_len >= key_len))) {
+            return false;
+        }
+        g_free(previous);
+        previous = g_memdup2(key, key_len);
+        previous_len = key_len;
+        if (cursor->pos >= cursor->len || cursor->data[cursor->pos++] != ':' ||
+            !node_json_scan_value(cursor) || cursor->pos >= cursor->len) {
+            return false;
+        }
+        if (cursor->data[cursor->pos] == '}') {
+            cursor->pos++;
+            cursor->depth--;
+            return true;
+        }
+        if (cursor->data[cursor->pos++] != ',') {
+            return false;
+        }
+    }
+}
+
+static bool node_json_scan_value(NodeJsonCursor *cursor)
+{
+    static const char *literals[] = { "false", "null", "true" };
+
+    if (cursor->pos >= cursor->len) {
+        return false;
+    }
+    switch (cursor->data[cursor->pos]) {
+    case '{':
+        return node_json_scan_object(cursor);
+    case '[':
+        return node_json_scan_array(cursor);
+    case '"':
+        return node_json_scan_string(cursor, NULL, NULL);
+    case '-':
+    case '0' ... '9':
+        return node_json_scan_number(cursor);
+    default:
+        for (size_t i = 0; i < G_N_ELEMENTS(literals); i++) {
+            size_t length = strlen(literals[i]);
+
+            if (cursor->len - cursor->pos >= length &&
+                memcmp(cursor->data + cursor->pos, literals[i], length) == 0) {
+                cursor->pos += length;
+                return true;
+            }
+        }
+        return false;
+    }
+}
+
+static bool node_json_canonical(const uint8_t *data, size_t len)
+{
+    NodeJsonCursor cursor = { .data = data, .len = len };
+
+    return len != 0 && node_json_scan_value(&cursor) && cursor.pos == len &&
+           cursor.depth == 0;
+}
+
+static bool node_qdict_exact(const QDict *dict, const char *const *keys,
+                             size_t count)
+{
+    if (!dict || qdict_size(dict) != count) {
+        return false;
+    }
+    for (size_t i = 0; i < count; i++) {
+        if (!qdict_haskey(dict, keys[i])) {
+            return false;
+        }
+    }
+    return true;
+}
+
+#define NODE_KEYS(...) ((const char *const[]) { __VA_ARGS__ })
+#define NODE_EXACT(dict_, ...) \
+    node_qdict_exact((dict_), NODE_KEYS(__VA_ARGS__), \
+                     G_N_ELEMENTS(NODE_KEYS(__VA_ARGS__)))
+
+static bool node_json_u64(const QObject *object, uint64_t *value)
+{
+    QNum *number = qobject_to(QNum, object);
+
+    return number && number->kind != QNUM_DOUBLE &&
+           qnum_get_try_uint(number, value);
+}
+
+static bool node_json_i64(const QObject *object, int64_t *value)
+{
+    QNum *number = qobject_to(QNum, object);
+
+    return number && number->kind != QNUM_DOUBLE &&
+           qnum_get_try_int(number, value);
+}
+
+static bool node_json_u32(const QObject *object, uint32_t *value)
+{
+    uint64_t wide;
+
+    if (!node_json_u64(object, &wide) || wide > UINT32_MAX) {
+        return false;
+    }
+    *value = wide;
+    return true;
+}
