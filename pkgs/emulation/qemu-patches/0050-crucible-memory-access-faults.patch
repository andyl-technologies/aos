+MemTxResult address_space_read_cached_fault(MemoryRegionCache *cache,
+                                            hwaddr addr, MemTxAttrs attrs,
+                                            void *buf, hwaddr len)
+{
+    MemTxResult result;
+
+    qemu_crucible_fault_dma_enter(false, attrs,
+                                  cache->crucible_dma_identity);
+    qemu_crucible_fault_memory_dma_transaction_begin(
+        QEMU_CRUCIBLE_MEMORY_DMA_READ, crucible_dma_actor_id(),
+        cache->crucible_as, cache->crucible_addr + addr, len, attrs,
+        qemu_crucible_fault_observed_icount());
+    if (qemu_crucible_fault_memory_transaction_failed()) {
+        result = MEMTX_ERROR;
+    } else if (qemu_crucible_fault_memory_transaction_active(
+                   QEMU_CRUCIBLE_MEMORY_DMA_READ)) {
+        result = address_space_rw_crucible_dma_frozen(buf, len, false);
+    } else {
+        result = flatview_read(cache->fv, cache->crucible_addr + addr,
+                               attrs, buf, len);
+    }
+    qemu_crucible_fault_memory_transaction_end();
+    qemu_crucible_fault_dma_leave();
+    return result;
+}
