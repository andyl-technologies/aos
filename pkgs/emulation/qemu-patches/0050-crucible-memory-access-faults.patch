+static void node_rule_clear(QemuCrucibleFaultRule *rule)
+{
+    if (!rule) {
+        return;
+    }
+    for (size_t i = 0; i < rule->field_count; i++) {
+        qobject_unref(rule->fields[i].json);
+    }
+    g_clear_pointer(&rule->row_counts, g_array_unref);
+    g_clear_pointer(&rule->translations, g_array_unref);
+    g_clear_pointer(&rule->retention_cells, g_hash_table_unref);
+    g_clear_pointer(&rule->row_counters, g_hash_table_unref);
+    g_clear_pointer(&rule->evidence_mutation_records, g_byte_array_unref);
+    g_clear_pointer(&rule->evidence_counter_records, g_byte_array_unref);
+    node_memory_service_ledger_release(rule->service_ledger);
+    rule->service_ledger = NULL;
+    g_free(rule->payload);
+    rule->payload = NULL;
+    rule->payload_len = 0;
+    rule->field_count = 0;
+}
+
+static QemuCrucibleFaultRule *node_rule_ref(QemuCrucibleFaultRule *rule)
+{
+    g_assert(rule && rule->references != 0 &&
+             rule->references != UINT32_MAX);
+    rule->references++;
+    return rule;
+}
