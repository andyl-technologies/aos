+    if (node_json_tag(object, "healthy", false, NULL) ||
+        node_json_tag(object, "degraded", false, NULL)) {
+        return true;
+    }
+    dict = node_json_tag_dict(object, "failed");
+    if (dict && NODE_EXACT(dict, "behavior")) {
+        return NODE_ONE_OF(qdict_get(dict, "behavior"), "stop", "read_error");
+    }
+    dict = node_json_tag_dict(object, "fallback");
+    return dict && NODE_EXACT(dict, "source") &&
+           node_json_object_id(qdict_get(dict, "source"));
+}
+
+static bool node_json_clock_sync(const QObject *object)
+{
+    QObject *parameters;
+    QDict *dict;
+    uint64_t threshold;
+
+    if (node_json_tag(object, "step", false, NULL)) {
+        return true;
+    }
+    return node_json_tag(object, "slew", true, &parameters) &&
+           (dict = qobject_to(QDict, parameters)) &&
+           NODE_EXACT(dict, "rate", "threshold_nanos") &&
+           node_json_ratio(qdict_get(dict, "rate")) &&
+           node_json_positive(qdict_get(dict, "threshold_nanos"), &threshold);
+}
+
+static bool node_json_accelerator_job(const QObject *object)
+{
+    QDict *dict = qobject_to(QDict, object);
+    QObject *queue;
+    uint32_t queue_value;
+
+    if (!NODE_EXACT(dict, "job_kind", "occurrence", "queue") ||
+        !node_json_object_id(qdict_get(dict, "job_kind")) ||
+        !node_json_occurrence(qdict_get(dict, "occurrence"))) {
+        return false;
+    }
+    queue = qdict_get(dict, "queue");
+    return node_json_null(queue) || node_json_u32(queue, &queue_value);
+}
+
+static bool node_json_accelerator_result(const QObject *object)
+{
+    QDict *dict = qobject_to(QDict, object);
+    uint64_t offset;
+    size_t mask_len, value_len;
+
+    return NODE_EXACT(dict, "mask", "offset", "value") &&
+           node_json_u64(qdict_get(dict, "offset"), &offset) &&
+           node_json_hex(qdict_get(dict, "mask"), 1, 16 * 1024 * 1024,
+                         &mask_len) &&
+           node_json_hex(qdict_get(dict, "value"), 1, 16 * 1024 * 1024,
+                         &value_len) &&
+           mask_len == value_len && offset <= UINT64_MAX - mask_len;
+}
+
+static bool node_json_accelerator_thermal(const QObject *object)
+{
+    QDict *dict = qobject_to(QDict, object);
+    uint64_t power, temperature;
+
+    return NODE_EXACT(dict, "power_milliwatts", "temperature_millikelvin") &&
+           node_json_positive(qdict_get(dict, "power_milliwatts"), &power) &&
+           node_json_positive(qdict_get(dict, "temperature_millikelvin"),
+                              &temperature);
+}
