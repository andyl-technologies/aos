+bool cpu_get_tb_fault_identity(uintptr_t host_pc, vaddr *tb_pc,
+                               uint32_t *instruction_ordinal)
+{
+    TranslationBlock *tb;
+    uint64_t data[TARGET_INSN_START_WORDS];
+    int insns_left;
+
+    if (host_pc == 0) {
+        return false;
+    }
+    tb = tcg_tb_lookup(host_pc);
+    if (!tb) {
+        return false;
+    }
+    insns_left = cpu_unwind_data_from_tb(tb, host_pc, data);
+    if (insns_left < 0) {
+        return false;
+    }
+    *tb_pc = tb->pc;
+    *instruction_ordinal = tb->icount - insns_left;
+    return true;
+}
