-#define GEN_ATOMIC_HELPER_FN(X, FN, XDATA_TYPE, RET)                \
+#define GEN_ATOMIC_HELPER_FN(X, FN, XDATA_TYPE, RET, RAWRET)        \
 ABI_TYPE ATOMIC_NAME(X)(CPUArchState *env, abi_ptr addr,            \
                         ABI_TYPE xval, MemOpIdx oi, uintptr_t retaddr) \
 {                                                                   \
-    XDATA_TYPE *haddr, ldo, ldn, old, new, val = xval;              \
-    haddr = atomic_mmu_lookup(env_cpu(env), addr, oi, DATA_SIZE, retaddr);   \
+    CPUState *cpu = env_cpu(env);                                   \
+    CRUCIBLE_ATOMIC_DECLARE;                                        \
+    XDATA_TYPE *haddr, ldo, ldn, old, new, fault_ret, val = xval;   \
+    haddr = CRUCIBLE_ATOMIC_LOOKUP(cpu, addr, oi, retaddr);         \
+    CRUCIBLE_ATOMIC_CAPTURE(haddr);                                 \
     smp_mb();                                                       \
     ldn = qatomic_read__nocheck(haddr);                             \
     do {                                                            \
         ldo = ldn; old = BSWAP(ldo); new = FN(old, val);            \
         ldn = qatomic_cmpxchg__nocheck(haddr, ldo, BSWAP(new));     \
     } while (ldo != ldn);                                           \
+    fault_ret = RAWRET;                                             \
+    CRUCIBLE_ATOMIC_FINISH(cpu, oi, retaddr, fault_ret, true);      \
