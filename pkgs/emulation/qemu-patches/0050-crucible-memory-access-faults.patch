+static void test_tb_exec(unsigned int cpu_index, void *opaque)
+{
+    g_autoptr(GByteArray) value = g_byte_array_new();
+
+    (void)cpu_index;
+    (void)opaque;
+    test_tb_count++;
+    test_last_icount = qemu_plugin_crucible_icount();
+    if (!test_submitted) {
+        if (qemu_plugin_read_memory_vaddr(test_result_address, value, 1) &&
+            value->len == 1 && value->data[0] == 0x7e) {
+            test_command.target_icount = test_last_icount;
+            test_command.authorization_ceiling_icount = test_last_icount;
+            if (qemu_plugin_crucible_fault_submit(
+                    &test_command, test_payload->data,
+                    test_payload->len) != 0) {
+                test_fail("deferred rule preparation could not be submitted");
+            }
+            test_submitted = true;
+            qemu_plugin_force_vcpu_exit();
+        }
+        return;
+    }
+    g_byte_array_set_size(value, 0);
+    if (test_installed && qemu_plugin_read_memory_vaddr(
+            test_result_address, value, test_expected_length)) {
+        test_last_result_readable = true;
+        test_last_result_length = value->len;
+        memcpy(test_last_result, value->data, value->len);
+    }
+    if (!test_installed || !test_event_seen || test_complete ||
+        (strcmp(test_scenario, "retention") == 0 &&
+         !test_retention_boundary_seen) ||
+        (test_retry_scenario &&
+         (!test_retry_poison_seen || !test_retry_applied_seen ||
+          test_retry_event_count != 2)) ||
+        (test_require_full_coverage &&
+         test_coverage != (1U << test_length) - 1) ||
+        !test_last_result_readable ||
+        value->len != test_expected_length ||
+        memcmp(value->data, test_expected, test_expected_length) != 0) {
+        return;
+    }
+    test_complete = true;
+    g_printerr("CRUCIBLE_MEMORY_ACCESS_LIVE_PASS\n");
+    qemu_plugin_request_shutdown(0);
+}
