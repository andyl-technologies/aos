diff --git a/accel/tcg/tcg-accel-ops-icount.c b/accel/tcg/tcg-accel-ops-icount.c
--- a/accel/tcg/tcg-accel-ops-icount.c
+++ b/accel/tcg/tcg-accel-ops-icount.c
@@ -48,4 +48,11 @@ static int64_t icount_get_limit(void)
-        /* Check realtime timers, because they help with input processing */
-        deadline = qemu_soonest_timeout(deadline,
-                qemu_clock_deadline_ns_all(QEMU_CLOCK_REALTIME,
-                                           QEMU_TIMER_ATTR_ALL));
+        if (icount_enabled() != ICOUNT_PRECISE) {
+            /*
+             * Adaptive icount keeps upstream's realtime input-processing
+             * deadline. Precise fixed-shift icount must derive its instruction
+             * budget from the virtual clock only, or host speed/load changes
+             * the number of guest instructions retired before a TB exit.
+             */
+            deadline = qemu_soonest_timeout(deadline,
+                    qemu_clock_deadline_ns_all(QEMU_CLOCK_REALTIME,
+                                               QEMU_TIMER_ATTR_ALL));
+        }
