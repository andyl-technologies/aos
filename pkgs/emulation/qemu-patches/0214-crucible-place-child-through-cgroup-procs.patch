+/*
+ * Authenticate one writable descriptor as the cgroup.procs control file of
+ * the exact authenticated cgroup directory.
+ *
+ * The source QEMU runs under attempt credentials that need not be able to
+ * traverse the supervisor-owned cgroup directory, so the file is not looked
+ * up beneath the directory.  Both descriptors are resolved through this
+ * process's own /proc/self/fd links instead, which needs no permission on
+ * the cgroup hierarchy, and the file must sit directly beneath the directory
+ * on the same cgroup-v2 filesystem.
+ */
+static bool crucible_hot_fork_cgroup_procs_identity(
+    int procs_fd, int cgroup_fd, uint64_t *inode, Error **errp)
+{
+#ifdef CONFIG_LINUX
+    g_autofree char *procs_link = g_strdup_printf("/proc/self/fd/%d", procs_fd);
+    g_autofree char *cgroup_link =
+        g_strdup_printf("/proc/self/fd/%d", cgroup_fd);
+    g_autofree char *expected_path = NULL;
+    char procs_path[PATH_MAX];
+    char cgroup_path[PATH_MAX];
+    struct stat status;
+    struct stat directory;
+    struct statfs filesystem;
+    ssize_t procs_length;
+    ssize_t cgroup_length;
+    int flags = fcntl(procs_fd, F_GETFL);
+
+    if (flags < 0 || fstat(procs_fd, &status) < 0 ||
+        fstat(cgroup_fd, &directory) < 0 ||
+        fstatfs(procs_fd, &filesystem) < 0) {
+        error_setg_errno(errp, errno,
+                         "Could not inspect Crucible hot-fork cgroup.procs");
+        return false;
+    }
+    procs_length = readlink(procs_link, procs_path, sizeof(procs_path) - 1);
+    cgroup_length = readlink(cgroup_link, cgroup_path, sizeof(cgroup_path) - 1);
+    if (procs_length < 0 || cgroup_length < 0) {
+        error_setg_errno(errp, errno,
+                         "Could not resolve Crucible hot-fork cgroup.procs");
+        return false;
+    }
+    procs_path[procs_length] = '\0';
+    cgroup_path[cgroup_length] = '\0';
+    expected_path = g_strdup_printf("%s/cgroup.procs", cgroup_path);
+    if (!S_ISREG(status.st_mode) ||
+        filesystem.f_type != CGROUP2_SUPER_MAGIC ||
+        ((flags & O_ACCMODE) != O_WRONLY && (flags & O_ACCMODE) != O_RDWR) ||
+        status.st_dev != directory.st_dev || status.st_ino == 0 ||
+        strcmp(procs_path, expected_path) != 0) {
+        error_setg(errp, "Crucible hot-fork process contract requires the "
+                   "writable cgroup.procs of its cgroup-v2 directory");
+        return false;
+    }
+    *inode = status.st_ino;
+    return true;
+#else
+    (void)procs_fd;
+    (void)cgroup_fd;
+    (void)inode;
+    error_setg(errp, "Crucible hot-fork cgroup placement requires Linux");
+    return false;
+#endif
+}
