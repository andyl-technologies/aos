+/**
+ * qemu_plugin_read_vcpu_regs() - read canonical register bytes for a vCPU
+ * @vcpu_index: the vCPU index to inspect
+ * @out_register_bytes: plugin-owned output buffer
+ * @out_register_capacity: size of @out_register_bytes
+ * @out_register_len: output byte count, or required byte count on overflow
+ * @out_retired_instruction_count: output deterministic register-read stamp
+ *
+ * Returns 0 on success and nonzero on failure. The byte stream is a stable
+ * canonicalization of each named architectural register descriptor and value
+ * for @vcpu_index. The read is side-effect-free with respect to guest state.
+ */
+QEMU_PLUGIN_API
+int qemu_plugin_read_vcpu_regs(unsigned int vcpu_index,
+                               uint8_t *out_register_bytes,
+                               size_t out_register_capacity,
+                               size_t *out_register_len,
+                               uint64_t *out_retired_instruction_count);
+
+/**
+ * struct qemu_plugin_rr_cursor - round-robin scheduler cursor snapshot
+ * @current_vcpu: currently executing vCPU index
+ * @cursor_position: retired instructions inside the pinned RR quantum
+ * @rr_switch_quantum: pinned RR switch quantum in node-icount units
+ */
+struct qemu_plugin_rr_cursor {
+    uint64_t current_vcpu;
+    uint64_t cursor_position;
+    uint64_t rr_switch_quantum;
+};
+
+/**
+ * qemu_plugin_rr_cursor() - read the current round-robin cursor
+ * @out: plugin-owned cursor output
+ *
+ * Returns 0 on success and nonzero if no valid vCPU is current, no pinned
+ * rr_switch_quantum is active, or the cursor is not inside that quantum. The
+ * read is side-effect-free with respect to guest state.
+ */
+QEMU_PLUGIN_API
+int qemu_plugin_rr_cursor(struct qemu_plugin_rr_cursor *out);
