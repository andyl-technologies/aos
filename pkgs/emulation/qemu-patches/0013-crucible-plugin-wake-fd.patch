+/**
+ * qemu_plugin_crucible_single_threaded_rr() - report the live sim execution mode
+ *
+ * Returns one only while the Crucible sim accelerator is active with MTTCG
+ * disabled, proving that QEMU serializes the round-robin vCPU execution path.
+ * Returns zero for every other accelerator or threading mode.
+ */
+QEMU_PLUGIN_API
+int qemu_plugin_crucible_single_threaded_rr(void);
+
+/**
+ * qemu_plugin_register_wake_fd() - register a scheduler wake fd
+ * @fd: nonblocking eventfd or pipe descriptor owned by the plugin
+ *
+ * Registers @fd on QEMU's main AioContext. Read readiness is therefore serviced
+ * by both the outer main loop and nested aio_poll() waits used by synchronous
+ * block I/O. The handler drains the descriptor, resumes device waiters, and
+ * kicks the first RR vCPU. The scheduler remains the single authority for
+ * publishing wake decisions.
+ *
+ * Returns: 0 on successful registration, nonzero on invalid input.
+ */
+QEMU_PLUGIN_API
+int qemu_plugin_register_wake_fd(int fd);
+
+/**
+ * qemu_plugin_request_shutdown() - request plugin-owned QEMU teardown
+ * @failure: nonzero selects a fail-loud host-error exit
+ *
+ * Schedules shutdown through QEMU's normal runstate path. A zero value uses
+ * the same clean exit cause as QMP quit; a nonzero value preserves a protocol
+ * fault as a failed child exit. The request also kicks the RR vCPU so an idle
+ * simulation cannot delay the main-loop transition.
+ */
+QEMU_PLUGIN_API
+void qemu_plugin_request_shutdown(int failure);
