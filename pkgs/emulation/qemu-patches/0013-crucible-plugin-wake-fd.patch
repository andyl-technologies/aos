 static bool has_control;
 static Error *migration_blocker;
+static int qemu_plugin_wake_fd = -1;
 
 bool qemu_plugin_has_time_control(void)
 {
@@ -199,6 +200,39 @@ void qemu_plugin_force_vcpu_exit(void)
     }
 }
 
+static void qemu_plugin_wake_fd_read(void *opaque)
+{
+    int fd = (intptr_t)opaque;
+    uint64_t value;
+
+    (void)read(fd, &value, sizeof(value));
+}
+
+int qemu_plugin_register_wake_fd(int fd)
+{
+    if (fd < 0) {
+        return -1;
+    }
+
+    if (qemu_plugin_wake_fd >= 0 && qemu_plugin_wake_fd != fd) {
+        qemu_set_fd_handler(qemu_plugin_wake_fd, NULL, NULL, NULL);
+    }
+
+    qemu_plugin_wake_fd = fd;
+    qemu_set_fd_handler(fd, qemu_plugin_wake_fd_read, NULL,
+                        (void *)(intptr_t)fd);
+    return 0;
+}
+
+void qemu_plugin_main_loop_wait(void)
+{
+    if (!bql_locked()) {
+        return;
+    }
+
+    main_loop_wait(false);
+}
