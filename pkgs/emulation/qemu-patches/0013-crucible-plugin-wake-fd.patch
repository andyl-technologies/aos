+int qemu_plugin_crucible_single_threaded_rr(void)
+{
+    return strcmp(current_accel_name(), "sim") == 0 &&
+           !qemu_tcg_mttcg_enabled();
+}
+
+static void qemu_plugin_unregister_wake_fd(int fd)
+{
+    aio_set_fd_handler(qemu_get_aio_context(), fd, NULL, NULL,
+                       NULL, NULL, NULL);
+    if (qemu_plugin_wake_fd == fd) {
+        qemu_plugin_wake_fd = -1;
+    }
+}
+
+void qemu_plugin_wake_notifier_add(Notifier *notifier)
+{
+    notifier_list_add(&qemu_plugin_wake_notifiers, notifier);
+}
+
+void qemu_plugin_wake_notifier_remove(Notifier *notifier)
+{
+    notifier_remove(notifier);
+}
+
+static void qemu_plugin_wake_fd_read(void *opaque)
+{
+    int fd = (intptr_t)opaque;
+    uint8_t buffer[256];
+    bool drained = false;
+
+    for (;;) {
+        ssize_t ret = read(fd, buffer, sizeof(buffer));
+
+        if (ret > 0) {
+            drained = true;
+            continue;
+        }
+        if (ret < 0 && errno == EINTR) {
+            continue;
+        }
+        if (ret < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) {
+            if (drained) {
+                notifier_list_notify(&qemu_plugin_wake_notifiers,
+                                     (void *)(intptr_t)QEMU_PLUGIN_WAKE_EVENT_DRAINED);
+            }
+            if (drained && first_cpu) {
+                qemu_cpu_kick(first_cpu);
+            }
+            return;
+        }
+        if (ret == 0) {
+            error_report("Crucible plugin wake fd %d reached EOF", fd);
+        } else {
+            error_report("Crucible plugin wake fd %d read failed: %s",
+                         fd, strerror(errno));
+        }
+        notifier_list_notify(&qemu_plugin_wake_notifiers,
+                             (void *)(intptr_t)QEMU_PLUGIN_WAKE_EVENT_FAILED);
+        qemu_plugin_unregister_wake_fd(fd);
+        qemu_system_shutdown_request(SHUTDOWN_CAUSE_HOST_ERROR);
+        if (first_cpu) {
+            qemu_cpu_kick(first_cpu);
+        }
+        return;
+    }
+}
+
+int qemu_plugin_register_wake_fd(int fd)
+{
+    int flags;
+
+    if (fd < 0) {
+        return -1;
+    }
+    flags = fcntl(fd, F_GETFL);
+    if (flags < 0 || !(flags & O_NONBLOCK)) {
+        return -1;
+    }
+
+    if (qemu_plugin_wake_fd >= 0) {
+        return qemu_plugin_wake_fd == fd ? 0 : -EBUSY;
+    }
+
+    qemu_plugin_wake_fd = fd;
+    aio_set_fd_handler(qemu_get_aio_context(), fd,
+                       qemu_plugin_wake_fd_read, NULL, NULL, NULL,
+                       (void *)(intptr_t)fd);
+    return 0;
+}
+
+void qemu_plugin_request_shutdown(int failure)
+{
+    qemu_system_shutdown_request(failure ? SHUTDOWN_CAUSE_HOST_ERROR :
+                                           SHUTDOWN_CAUSE_HOST_QMP_QUIT);
+    if (first_cpu) {
+        qemu_cpu_kick(first_cpu);
+    }
+}
