diff --git a/include/qemu/qemu-plugin.h b/include/qemu/qemu-plugin.h
--- a/include/qemu/qemu-plugin.h
+++ b/include/qemu/qemu-plugin.h
@@ -782,6 +782,30 @@ uint64_t qemu_plugin_icount_raw(void);
 QEMU_PLUGIN_API
 void qemu_plugin_force_vcpu_exit(void);
 
+/**
+ * qemu_plugin_register_wake_fd() - register a scheduler wake fd
+ * @fd: nonblocking eventfd or pipe descriptor owned by the plugin
+ *
+ * Registers @fd on QEMU's main-loop iohandler context. Read readiness drains the
+ * descriptor but dispatches no guest-visible work; the scheduler remains the
+ * single authority for publishing wake decisions.
+ *
+ * Returns: 0 on successful registration, nonzero on invalid input.
+ */
+QEMU_PLUGIN_API
+int qemu_plugin_register_wake_fd(int fd);
+
+/**
+ * qemu_plugin_main_loop_wait() - block in QEMU's main-loop wait
+ *
+ * Runs one blocking main-loop wait iteration so plugin idle waits integrate
+ * scheduler wake fds and QEMU-owned fd handlers such as QMP/chardev sources.
+ * The call is ignored unless QEMU's BQL is held; QEMU's main loop drops and
+ * reacquires BQL around the host poll.
+ */
+QEMU_PLUGIN_API
+void qemu_plugin_main_loop_wait(void);
+
