+        timers_state.crucible_rr_cursor_valid) {
+        return;
+    }
+
+    /*
+     * Establish the fresh-boot cursor before the RR thread computes its first
+     * budget.  Lazy initialization after host-driven startup work lets that
+     * work choose the cursor's virtual origin, so identical guests can expose
+     * different intra-turn positions at the same aggregate icount.  A loaded
+     * VMState already has a valid serialized cursor and is never overwritten.
+     */
+    g_assert(icount_get_raw() == 0);
+    timers_state.crucible_rr_current_vcpu = cpu->cpu_index;
+    timers_state.crucible_rr_cursor_position = 0;
+    timers_state.crucible_rr_cursor_valid = true;
