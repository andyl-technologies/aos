+int crucible_sim_det_ipi_deliver_commanded(unsigned int target_vcpu,
+                                           unsigned int vector)
+{
+    CPUState *dst_cpu;
+    X86CPU *x86_cpu;
+    APICCommonState *target_apic;
+    uint64_t delivery_icount;
+    unsigned int src_vcpu = UINT_MAX;
+
+    if (vector > UINT8_MAX) {
+        return -1;
+    }
+
+    dst_cpu = qemu_get_cpu(target_vcpu);
+    if (!dst_cpu) {
+        return -1;
+    }
+
+    x86_cpu = X86_CPU(dst_cpu);
+    if (!x86_cpu->apic_state) {
+        return -1;
+    }
+
+    target_apic = APIC_COMMON(x86_cpu->apic_state);
+    apic_set_irq(target_apic, vector, APIC_TRIGGER_EDGE);
+
+    if (current_cpu) {
+        src_vcpu = current_cpu->cpu_index;
+    }
+    delivery_icount = qemu_plugin_icount_raw();
+    qemu_plugin_crucible_maybe_fire_ipi_delivery_cb(
+        ++crucible_sim_det_ipi_next_event_id, delivery_icount, src_vcpu,
+        dst_cpu->cpu_index, APIC_DM_FIXED, vector);
+
+    return 0;
+}
