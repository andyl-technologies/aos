+/**
+ * qemu_plugin_inject_preemption() - command a sim RR preemption
+ * @at_icount: raw node icount where the preemption must be applied
+ * @deadline_icount: inclusive lower bound authorized by the scheduler
+ * @ceiling_icount: inclusive upper bound authorized by the scheduler
+ * @kind: one of QEMU_PLUGIN_PREEMPTION_KIND_*
+ * @arg0: kind-specific first operand
+ * @arg1: kind-specific second operand
+ * @arg2: reserved operand, currently zero
+ *
+ * Queues a single commanded vCPU switch or interrupt delivery for the sim
+ * accelerator's precise-icount round-robin path. The command is rejected when
+ * sim precise-icount RR mode is inactive, another command is pending, operands
+ * are malformed, @at_icount falls outside [@deadline_icount, @ceiling_icount],
+ * @at_icount is in the past, or @ceiling_icount is beyond the current
+ * scheduler-published max-advance ceiling.
+ *
+ * Returns: 0 when the command is accepted, nonzero when it is rejected.
+ */
+QEMU_PLUGIN_API
+int qemu_plugin_inject_preemption(uint64_t at_icount,
+                                  uint64_t deadline_icount,
+                                  uint64_t ceiling_icount,
+                                  unsigned int kind, uint32_t arg0,
+                                  uint32_t arg1, uint32_t arg2);
+
