--- /dev/null
+++ b/accel/tcg/tcg-accel-ops-preemption.c
@@ -0,0 +1,170 @@
+/*
+ * QEMU TCG Crucible commanded preemption injection.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/accel.h"
+#include "qemu/error-report.h"
+#include "qemu/qemu-plugin.h"
+#include "exec/cpu-common.h"
+#include "system/cpu-timers.h"
+#include "system/crucible-sim-ipi.h"
+#include "system/crucible-sim-preemption.h"
+#include "tcg-accel-ops-sim-shmem.h"
+
+typedef struct CrucibleSimPreemptionCommand {
+    bool pending;
+    uint64_t at_icount;
+    unsigned int kind;
+    uint32_t arg0;
+    uint32_t arg1;
+    uint32_t arg2;
+} CrucibleSimPreemptionCommand;
+
+static CrucibleSimPreemptionCommand crucible_sim_preemption_command;
+
+static bool crucible_sim_preemption_mode(void)
+{
+    return strcmp(current_accel_name(), "sim") == 0 &&
+           icount_enabled() == ICOUNT_PRECISE &&
+           icount_crucible_rr_switch_quantum() != 0 &&
+           crucible_sim_shmem_dispatch_registered();
+}
+
+static int crucible_sim_preemption_validate_vcpu(uint32_t vcpu)
+{
+    return qemu_get_cpu(vcpu) != NULL ? 0 : -1;
+}
+
+static int crucible_sim_preemption_validate_window(uint64_t at_icount,
+                                                   uint64_t deadline_icount,
+                                                   uint64_t ceiling_icount)
+{
+    uint64_t current_icount = qemu_plugin_icount_raw();
+    uint64_t max_advance_icount = crucible_sim_shmem_max_advance_icount();
+
+    if (deadline_icount > ceiling_icount ||
+        ceiling_icount > max_advance_icount ||
+        at_icount < deadline_icount ||
+        at_icount > ceiling_icount ||
+        at_icount < current_icount) {
+        return -1;
+    }
+    return 0;
+}
+
+int crucible_sim_preemption_enqueue(uint64_t at_icount,
+                                    uint64_t deadline_icount,
+                                    uint64_t ceiling_icount,
+                                    unsigned int kind, uint32_t arg0,
+                                    uint32_t arg1, uint32_t arg2)
+{
+    if (!crucible_sim_preemption_mode()) {
+        return -1;
+    }
+    if (crucible_sim_preemption_validate_window(at_icount, deadline_icount,
+                                                ceiling_icount) != 0) {
+        return -2;
+    }
+    if (crucible_sim_preemption_command.pending) {
+        return -3;
+    }
+
+    switch (kind) {
+    case QEMU_PLUGIN_PREEMPTION_KIND_VCPU_SWITCH:
+        if (arg2 != 0 || arg0 == arg1 ||
+            crucible_sim_preemption_validate_vcpu(arg0) != 0 ||
+            crucible_sim_preemption_validate_vcpu(arg1) != 0) {
+            return -4;
+        }
+        break;
+    case QEMU_PLUGIN_PREEMPTION_KIND_INTERRUPT_AT:
+        if (arg2 != 0 || arg1 > UINT8_MAX ||
+            crucible_sim_preemption_validate_vcpu(arg0) != 0) {
+            return -5;
+        }
+        break;
+    default:
+        return -6;
+    }
+
+    crucible_sim_preemption_command = (CrucibleSimPreemptionCommand) {
+        .pending = true,
+        .at_icount = at_icount,
+        .kind = kind,
+        .arg0 = arg0,
+        .arg1 = arg1,
+        .arg2 = arg2,
+    };
+    return 0;
+}
+
+int64_t crucible_sim_preemption_clamp_cpu_budget(uint64_t current_icount,
+                                                 int64_t cpu_budget)
+{
+    uint64_t remaining;
+
+    if (!crucible_sim_preemption_command.pending || cpu_budget <= 0) {
+        return cpu_budget;
+    }
+    if (current_icount >= crucible_sim_preemption_command.at_icount) {
+        return 0;
+    }
+
+    remaining = crucible_sim_preemption_command.at_icount - current_icount;
+    if (remaining > (uint64_t)INT64_MAX || (uint64_t)cpu_budget <= remaining) {
+        return cpu_budget;
+    }
+    return (int64_t)remaining;
+}
+
+bool crucible_sim_preemption_apply_due(CPUState **cpu)
+{
+    CrucibleSimPreemptionCommand command;
+    CPUState *target_cpu;
+    uint64_t current_icount;
+
+    if (!crucible_sim_preemption_command.pending) {
+        return false;
+    }
+
+    current_icount = qemu_plugin_icount_raw();
+    if (current_icount < crucible_sim_preemption_command.at_icount) {
+        return false;
+    }
+    if (current_icount > crucible_sim_preemption_command.at_icount) {
+        error_report("crucible preemption missed commanded icount: "
+                     "current=%" PRIu64 " commanded=%" PRIu64,
+                     current_icount, crucible_sim_preemption_command.at_icount);
+        abort();
+    }
+
+    command = crucible_sim_preemption_command;
+    crucible_sim_preemption_command.pending = false;
+
+    switch (command.kind) {
+    case QEMU_PLUGIN_PREEMPTION_KIND_VCPU_SWITCH:
+        if (!cpu || !*cpu || (*cpu)->cpu_index != (int)command.arg0) {
+            error_report("crucible preemption vCPU switch current mismatch");
+            abort();
+        }
+        target_cpu = qemu_get_cpu(command.arg1);
+        if (!target_cpu) {
+            error_report("crucible preemption vCPU switch target missing");
+            abort();
+        }
+        *cpu = target_cpu;
+        current_cpu = target_cpu;
+        return true;
+    case QEMU_PLUGIN_PREEMPTION_KIND_INTERRUPT_AT:
+        if (crucible_sim_det_ipi_deliver_commanded(command.arg0,
+                                                   command.arg1) != 0) {
+            error_report("crucible preemption interrupt target missing");
+            abort();
+        }
+        return true;
+    default:
+        error_report("crucible preemption unknown kind");
+        abort();
+    }
+}
