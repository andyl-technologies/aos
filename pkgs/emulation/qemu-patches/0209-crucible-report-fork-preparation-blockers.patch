+/*
+ * Names the first precondition that blocks a fork preparation.  The checks
+ * mirror the admission condition exactly so a live rejection identifies the
+ * stage whose generation, quiescence, or binding drifted.
+ */
+static const char *crucible_hot_fork_operation_blocker(
+    const CrucibleHotForkOperation *operation,
+    const CrucibleHotForkPluginBarrierState *plugin_barrier,
+    const CrucibleHotForkRcuBarrierState *rcu_barrier,
+    const CrucibleHotForkBhTimerBarrierState *bh_timer_barrier,
+    const CrucibleHotForkBlockBarrierState *block_barrier)
+{
+    struct qemu_plugin_crucible_hot_fork_child_plan child_plan = { 0 };
+
+    if (!crucible_hot_fork_operation_active) {
+        return "no fork operation is active";
+    }
+    if (!plugin_barrier || !block_barrier || !rcu_barrier ||
+        !bh_timer_barrier) {
+        return "a barrier report is absent";
+    }
+    if (!crucible_hot_fork_template_active ||
+        crucible_hot_fork_template_phase !=
+            CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BARRIERS_HELD) {
+        return "retained template is not in the held-barrier phase";
+    }
+    if (!crucible_hot_fork_exact_paused_boundary()) {
+        return "source is not at the exact paused boundary";
+    }
+    if (operation->template_generation !=
+        crucible_hot_fork_template_generation) {
+        return "template generation differs";
+    }
+    if (operation->private_ring_generation !=
+        crucible_hot_fork_private_ring_stage.generation) {
+        return "private ring generation differs";
+    }
+    if (operation->diagnostic_generation !=
+        crucible_hot_fork_diagnostic_stage.generation) {
+        return "diagnostic generation differs";
+    }
+    if (operation->qmp_generation != crucible_hot_fork_qmp_stage.generation) {
+        return "child QMP generation differs";
+    }
+    if (operation->console_generation !=
+        crucible_hot_fork_console_stage.generation) {
+        return "child console generation differs";
+    }
+    if (operation->monitor_generation !=
+        crucible_hot_fork_qmp_stage.monitor_generation) {
+        return "monitor generation differs";
+    }
+    if (operation->plugin_endpoint_generation !=
+        crucible_hot_fork_plugin_endpoint_stage.generation) {
+        return "plugin endpoint generation differs";
+    }
+    if (operation->plugin_barrier_generation != plugin_barrier->generation ||
+        operation->rcu_barrier_generation != rcu_barrier->generation ||
+        operation->bh_timer_barrier_generation !=
+            bh_timer_barrier->generation ||
+        operation->block_barrier_generation != block_barrier->generation) {
+        return "a barrier generation differs";
+    }
+    if (!plugin_barrier->quiescent || !rcu_barrier->quiescent ||
+        !bh_timer_barrier->quiescent || !block_barrier->quiescent) {
+        return "a barrier is not quiescent";
+    }
+    if (!block_barrier->snapshot_complete) {
+        return "block snapshot binding is incomplete";
+    }
+    if (!crucible_hot_fork_plugin_child_plan_bound(
+            plugin_barrier, NULL, NULL) ||
+        !crucible_hot_fork_current_plugin_child_plan(
+            plugin_barrier, &child_plan)) {
+        return "plugin child plan is not bound";
+    }
+    if (operation->parent_process_generation !=
+            child_plan.parent_process_generation ||
+        operation->child_process_generation !=
+            child_plan.child_process_generation) {
+        return "plugin process generations differ";
+    }
+    if (operation->child_process_contract_generation !=
+        crucible_hot_fork_child_process_contract_stage.generation) {
+        return "child process contract generation differs";
+    }
+    if (operation->child_files_generation !=
+        crucible_hot_fork_child_files_stage.generation) {
+        return "child file plan generation differs";
+    }
+    if (!crucible_hot_fork_child_process_contract_bound()) {
+        return "child process contract is not bound";
+    }
+    if (!crucible_hot_fork_plugin_child_resource_plan_bound(plugin_barrier)) {
+        return "plugin child resource plan is not bound";
+    }
+    if (!crucible_hot_fork_diagnostic_resource_plan_bound()) {
+        return "diagnostic resource plan is not bound";
+    }
+    if (!crucible_hot_fork_qmp_resource_plan_bound()) {
+        return "child QMP resource plan is not bound";
+    }
+    if (!crucible_hot_fork_console_resource_plan_bound()) {
+        return "child console resource plan is not bound";
+    }
+    if (!monitor_hot_fork_child_basis_matches_current(
+            &crucible_hot_fork_qmp_child_basis,
+            operation->monitor_generation)) {
+        return "child monitor basis changed";
+    }
+    return NULL;
+}
