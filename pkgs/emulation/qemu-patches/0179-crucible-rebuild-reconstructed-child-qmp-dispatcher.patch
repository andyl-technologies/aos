+/**
+ * monitor_qmp_hot_fork_dispatcher_is_idle() - check copied dispatcher state
+ * @expected: exact dispatcher retained in the monitor child basis
+ *
+ * The caller must hold @monitor_lock. Returns true only when @expected is the
+ * unchanged global dispatcher, is not shutting down, and is idle rather than
+ * scheduled or processing a request.
+ */
+bool monitor_qmp_hot_fork_dispatcher_is_idle(Coroutine *expected);
+
+/**
+ * monitor_qmp_hot_fork_rebuild_dispatcher_held() - replace child dispatcher
+ * @inherited: exact idle dispatcher copied from the source process
+ * @replacement: receives the fresh child dispatcher on success
+ *
+ * Retires the inherited idle dispatcher through its normal coroutine exit
+ * path, then installs one fresh dispatcher while monitor input remains held.
+ * The request queues must remain empty throughout the transition.
+ *
+ * Returns zero after replacement, -EINVAL for invalid arguments, -ESTALE when
+ * the supplied dispatcher is no longer the idle global dispatcher, or
+ * -EPROTO when retirement does not leave an empty dispatcher slot.
+ */
+int monitor_qmp_hot_fork_rebuild_dispatcher_held(
+    Coroutine *inherited, Coroutine **replacement);
