+bool monitor_qmp_hot_fork_dispatcher_is_idle(Coroutine *expected)
+{
+    return expected && qmp_dispatcher_co == expected &&
+        !qmp_dispatcher_co_shutdown &&
+        !qatomic_read(&qmp_dispatcher_co_busy);
+}
+
+int monitor_qmp_hot_fork_rebuild_dispatcher_held(
+    Coroutine *inherited, Coroutine **replacement)
+{
+    Coroutine *fresh;
+
+    if (!inherited || !replacement) {
+        return -EINVAL;
+    }
+    *replacement = NULL;
+
+    qemu_mutex_lock(&monitor_lock);
+    if (!monitor_qmp_hot_fork_dispatcher_is_idle(inherited)) {
+        qemu_mutex_unlock(&monitor_lock);
+        return -ESTALE;
+    }
+    qmp_dispatcher_co_shutdown = true;
+    qemu_mutex_unlock(&monitor_lock);
+
+    /*
+     * The copied dispatcher is idle and therefore not scheduled.  Wake it
+     * exactly once so that it observes shutdown and returns through QEMU's
+     * normal coroutine disposal path instead of leaking an inherited stack.
+     */
+    qmp_dispatcher_co_wake();
+    AIO_WAIT_WHILE_UNLOCKED(NULL,
+                   (aio_poll(iohandler_get_aio_context(), false),
+                    qatomic_read(&qmp_dispatcher_co)));
+
+    qemu_mutex_lock(&monitor_lock);
+    if (qmp_dispatcher_co || qatomic_read(&qmp_dispatcher_co_busy)) {
+        qemu_mutex_unlock(&monitor_lock);
+        return -EPROTO;
+    }
+
+    qmp_dispatcher_co_shutdown = false;
+    qatomic_set(&qmp_dispatcher_co_busy, true);
+    fresh = qemu_coroutine_create(monitor_qmp_dispatcher_co, NULL);
+    qmp_dispatcher_co = fresh;
+    aio_co_schedule(iohandler_get_aio_context(), fresh);
+    *replacement = fresh;
+    qemu_mutex_unlock(&monitor_lock);
+    return 0;
+}
