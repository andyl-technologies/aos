+static GMutex crucible_hot_fork_template_lock;
+static uint64_t crucible_hot_fork_template_generation;
+static bool crucible_hot_fork_template_active;
+
+CrucibleHotForkPluginBarrierState *
+qmp_crucible_hot_fork_plugin_barrier(
+    CrucibleHotForkPluginBarrierAction action, Error **errp)
+{
+    CrucibleHotForkPluginBarrierState *report = NULL;
+    uint32_t operation;
+
+    g_mutex_lock(&crucible_hot_fork_template_lock);
+    switch (action) {
+    case CRUCIBLE_HOT_FORK_PLUGIN_BARRIER_ACTION_HOLD:
+        if (crucible_hot_fork_template_active) {
+            error_setg(errp, "Crucible hot-fork template transaction owns "
+                       "the plugin barrier");
+            goto out;
+        }
+        if (!crucible_hot_fork_exact_paused_boundary()) {
+            error_setg(errp, "Crucible hot-fork plugin barrier requires "
+                       "an exact paused/device-flush boundary");
+            goto out;
+        }
+        operation = QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_HOLD;
+        break;
+    case CRUCIBLE_HOT_FORK_PLUGIN_BARRIER_ACTION_QUERY:
+        operation = QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_QUERY;
+        break;
+    case CRUCIBLE_HOT_FORK_PLUGIN_BARRIER_ACTION_RELEASE:
+        if (crucible_hot_fork_template_active) {
+            error_setg(errp, "Crucible hot-fork template transaction owns "
+                       "the plugin barrier");
+            goto out;
+        }
+        operation = QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_RELEASE;
+        break;
+    default:
+        error_setg(errp, "Unknown Crucible hot-fork plugin barrier action");
+        goto out;
+    }
+
+    report = crucible_hot_fork_plugin_barrier(operation, errp);
+out:
+    g_mutex_unlock(&crucible_hot_fork_template_lock);
+    return report;
+}
+
+static CrucibleHotForkTemplateState *
+crucible_hot_fork_template_report(
+    CrucibleHotForkTemplateOutcome outcome,
+    CrucibleHotForkPluginBarrierState *plugin_barrier)
+{
+    CrucibleHotForkTemplateState *report =
+        g_new0(CrucibleHotForkTemplateState, 1);
+    uint64_t acknowledged = crucible_hot_fork_acknowledged_proofs();
+
+    report->schema_version = 1;
+    report->generation = crucible_hot_fork_template_generation;
+    report->outcome = outcome;
+    report->transaction_active = crucible_hot_fork_template_active;
+    report->required_proofs = CRUCIBLE_HOT_FORK_REQUIRED_PROOFS;
+    report->acknowledged_proofs = acknowledged;
+    report->missing_proofs = CRUCIBLE_HOT_FORK_REQUIRED_PROOFS & ~acknowledged;
+    report->plugin_barrier = plugin_barrier;
+    report->rollback_complete = !report->transaction_active &&
+        !plugin_barrier->held;
+    report->ready = outcome == CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_PREPARED &&
+        report->transaction_active && plugin_barrier->quiescent &&
+        report->missing_proofs == 0;
+    return report;
+}
+
+CrucibleHotForkTemplateState *
+qmp_crucible_hot_fork_template(
+    CrucibleHotForkTemplateAction action, Error **errp)
+{
+    CrucibleHotForkPluginBarrierState *plugin_barrier = NULL;
+    CrucibleHotForkTemplateState *report = NULL;
+    CrucibleHotForkTemplateOutcome outcome;
+
+    g_mutex_lock(&crucible_hot_fork_template_lock);
+    switch (action) {
+    case CRUCIBLE_HOT_FORK_TEMPLATE_ACTION_PREPARE:
+        if (!crucible_hot_fork_template_active) {
+            if (!crucible_hot_fork_exact_paused_boundary()) {
+                error_setg(errp, "Crucible hot-fork template preparation "
+                           "requires an exact paused/device-flush boundary");
+                goto out;
+            }
+            plugin_barrier = crucible_hot_fork_plugin_barrier(
+                QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_QUERY, errp);
+            if (!plugin_barrier) {
+                goto out;
+            }
+            if (plugin_barrier->held) {
+                error_setg(errp, "Crucible hot-fork plugin barrier was held "
+                           "outside the template coordinator");
+                g_free(plugin_barrier);
+                plugin_barrier = NULL;
+                goto out;
+            }
+            g_free(plugin_barrier);
+            plugin_barrier = crucible_hot_fork_plugin_barrier(
+                QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_HOLD, errp);
+            if (!plugin_barrier) {
+                goto out;
+            }
+            crucible_hot_fork_template_active = true;
+            crucible_hot_fork_template_generation++;
+            assert(crucible_hot_fork_template_generation != 0);
+        } else {
+            plugin_barrier = crucible_hot_fork_plugin_barrier(
+                QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_QUERY, errp);
+            if (!plugin_barrier) {
+                goto out;
+            }
+        }
+        if (!plugin_barrier->held || plugin_barrier->teardown_closed) {
+            error_setg(errp, "Crucible hot-fork template lost its retained "
+                       "plugin barrier");
+            g_free(plugin_barrier);
+            plugin_barrier = NULL;
+            goto out;
+        }
+        if (!plugin_barrier->quiescent) {
+            outcome = CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_DRAINING;
+            break;
+        }
+        if (crucible_hot_fork_acknowledged_proofs() ==
+            CRUCIBLE_HOT_FORK_REQUIRED_PROOFS) {
+            outcome = CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_PREPARED;
+            break;
+        }
+
+        g_free(plugin_barrier);
+        plugin_barrier = crucible_hot_fork_plugin_barrier(
+            QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_RELEASE, errp);
+        if (!plugin_barrier) {
+            goto out;
+        }
+        crucible_hot_fork_template_active = false;
+        outcome = CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_BLOCKED;
+        break;
+    case CRUCIBLE_HOT_FORK_TEMPLATE_ACTION_QUERY:
+        plugin_barrier = crucible_hot_fork_plugin_barrier(
+            QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_QUERY, errp);
+        if (!plugin_barrier) {
+            goto out;
+        }
+        if (crucible_hot_fork_template_active &&
+            (!plugin_barrier->held || plugin_barrier->teardown_closed)) {
+            error_setg(errp, "Crucible hot-fork template lost its retained "
+                       "plugin barrier");
+            g_free(plugin_barrier);
+            plugin_barrier = NULL;
+            goto out;
+        }
+        if (!crucible_hot_fork_template_active && plugin_barrier->held) {
+            error_setg(errp, "Crucible hot-fork plugin barrier was held "
+                       "outside the template coordinator");
+            g_free(plugin_barrier);
+            plugin_barrier = NULL;
+            goto out;
+        }
+        if (!crucible_hot_fork_template_active) {
+            outcome = CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_IDLE;
+        } else if (plugin_barrier->quiescent &&
+                   crucible_hot_fork_acknowledged_proofs() ==
+                       CRUCIBLE_HOT_FORK_REQUIRED_PROOFS) {
+            outcome = CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_PREPARED;
+        } else {
+            outcome = CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_DRAINING;
+        }
+        break;
+    case CRUCIBLE_HOT_FORK_TEMPLATE_ACTION_ABORT:
+        if (!crucible_hot_fork_template_active) {
+            plugin_barrier = crucible_hot_fork_plugin_barrier(
+                QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_QUERY, errp);
+            if (!plugin_barrier) {
+                goto out;
+            }
+            if (plugin_barrier->held) {
+                error_setg(errp, "Crucible hot-fork plugin barrier was held "
+                           "outside the template coordinator");
+                g_free(plugin_barrier);
+                plugin_barrier = NULL;
+                goto out;
+            }
+            outcome = CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_IDLE;
+            break;
+        }
+        plugin_barrier = crucible_hot_fork_plugin_barrier(
+            QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_RELEASE, errp);
+        if (!plugin_barrier) {
+            goto out;
+        }
+        crucible_hot_fork_template_active = false;
+        outcome = CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_ABORTED;
+        break;
+    default:
+        error_setg(errp, "Unknown Crucible hot-fork template action");
+        goto out;
+    }
+
+    report = crucible_hot_fork_template_report(outcome, plugin_barrier);
+out:
+    g_mutex_unlock(&crucible_hot_fork_template_lock);
+    return report;
+}
