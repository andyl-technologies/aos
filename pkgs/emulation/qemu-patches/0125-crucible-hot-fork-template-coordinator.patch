+##
+# @CrucibleHotForkTemplateAction:
+#
+# Operation over QEMU's retained hot-fork template preparation transaction.
+#
+# @prepare: acquire registered subsystem barriers, poll them, and either retain
+#     a draining/prepared transaction or roll every acquired barrier back when
+#     the complete readiness proof is unavailable
+#
+# @query: observe the current transaction without acquiring or releasing a
+#     barrier
+#
+# @abort: release every acquired barrier and return the coordinator to idle
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'enum': 'CrucibleHotForkTemplateAction',
+  'data': [ 'prepare', 'query', 'abort' ] }
+
+##
+# @CrucibleHotForkTemplateOutcome:
+#
+# Exact outcome of one hot-fork template coordinator operation.
+#
+# @idle: no retained transaction or acquired barrier exists
+#
+# @draining: the transaction retains its acquired barrier while admitted work
+#     drains or while the caller asks @prepare to evaluate readiness again
+#
+# @blocked: preparation reached a stable barrier but the complete readiness
+#     bitmap was unavailable, so all acquired barriers were rolled back
+#
+# @prepared: every required proof was acknowledged and the transaction remains
+#     retained for a future fork operation
+#
+# @aborted: an active transaction was explicitly rolled back
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'enum': 'CrucibleHotForkTemplateOutcome',
+  'data': [ 'idle', 'draining', 'blocked', 'prepared', 'aborted' ] }
+
+##
+# @CrucibleHotForkTemplateState:
+#
+# QEMU-owned state for one retained template-preparation transaction. Version 1
+# acquires only the Crucible plugin callback barrier. Because that barrier does
+# not freeze host ring producers or provide child reconstruction, proof bit 6
+# remains clear and a drained transaction rolls back as @blocked.
+#
+# @schema-version: transaction contract version, currently 1
+#
+# @generation: positive process-local transaction generation after the first
+#     successful prepare, or zero before any transaction
+#
+# @outcome: exact result of the requested coordinator operation
+#
+# @transaction-active: whether QEMU still owns acquired barrier state
+#
+# @required-proofs: complete proof bitmap required before preparation succeeds
+#
+# @acknowledged-proofs: subset currently attested by QEMU
+#
+# @missing-proofs: exact @required-proofs bits not acknowledged
+#
+# @plugin-barrier: plugin barrier state after the operation and any rollback
+#
+# @rollback-complete: whether no transaction barrier remains acquired
+#
+# @ready: true exactly for a retained @prepared transaction with every proof
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'struct': 'CrucibleHotForkTemplateState',
+  'data': { 'schema-version': 'uint32',
+            'generation': 'uint64',
+            'outcome': 'CrucibleHotForkTemplateOutcome',
+            'transaction-active': 'bool',
+            'required-proofs': 'uint64',
+            'acknowledged-proofs': 'uint64',
+            'missing-proofs': 'uint64',
+            'plugin-barrier': 'CrucibleHotForkPluginBarrierState',
+            'rollback-complete': 'bool',
+            'ready': 'bool' } }
+
+##
+# @crucible-hot-fork-template:
+#
+# Drives QEMU's retained hot-fork template preparation coordinator. Preparation
+# begins only at the exact paused/device-flush boundary. The command never forks
+# a process; incomplete readiness rolls acquired barriers back fail-closed.
+#
+# @action: requested coordinator operation
+#
+# Returns: @CrucibleHotForkTemplateState
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'command': 'crucible-hot-fork-template',
+  'data': { 'action': 'CrucibleHotForkTemplateAction' },
+  'returns': 'CrucibleHotForkTemplateState',
+  'allow-oob': true }
+
 ##
 # @CrucibleHotForkMutex:
 #
