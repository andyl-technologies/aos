         node_memory_retention_boundary);
     qemu_crucible_fault_boundary_deadline_register(
         node_memory_retention_deadline);
+    qemu_crucible_fault_vmstate_register(&crucible_node_vmstate_section);
+    qemu_crucible_fault_vmstate_register(&crucible_memory_vmstate_section);
 }
 
