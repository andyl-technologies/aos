+static size_t crucible_lifecycle_vmstate_reservation_remaining(
+    QemuCrucibleFaultEventReservation *reservation)
+{
+    return qemu_crucible_fault_event_reservation_remaining(reservation);
+}
+
+static int crucible_lifecycle_vmstate_save(GByteArray *payload)
+{
+    CrucibleLifecyclePendingReset *pending =
+        &crucible_lifecycle_pending_reset;
+    uint32_t hang_count = crucible_lifecycle_hangs ?
+        crucible_lifecycle_hangs->len : 0;
+    uint32_t vcpu_count = crucible_lifecycle_vcpu_hung ?
+        crucible_lifecycle_vcpu_hung->len : 0;
+    size_t pending_reservation =
+        crucible_lifecycle_vmstate_reservation_remaining(
+            pending->reservation);
+
+    if (crucible_lifecycle_process_generation == 0 || hang_count > 4096 ||
+        vcpu_count > 4096 || pending_reservation > UINT32_MAX ||
+        pending->preserved_state_len >
+            CRUCIBLE_LIFECYCLE_VMSTATE_MAX_PRESERVED_BYTES ||
+        (!!pending->rule != !!pending->reservation) ||
+        (!!pending->rule != (pending->preserved_state_len != 0 ||
+                             pending->boot_policy != 0)) ||
+        (pending->waiting_ready && !pending->ready_marker) ||
+        (crucible_lifecycle_terminal_transition == 0 &&
+         crucible_lifecycle_terminal_exit_requested)) {
+        return -EINVAL;
+    }
+    qemu_crucible_fault_vmstate_put_bytes(payload, "CRUCLVS1", 8);
+    qemu_crucible_fault_vmstate_put_u64(
+        payload, crucible_lifecycle_process_generation);
+    qemu_crucible_fault_vmstate_put_u64(
+        payload, crucible_lifecycle_next_watchdog_ns);
+    qemu_crucible_fault_vmstate_put_u32(
+        payload, crucible_lifecycle_terminal_transition);
+    qemu_crucible_fault_vmstate_put_u32(payload, hang_count);
+    qemu_crucible_fault_vmstate_put_u32(payload, vcpu_count);
+    qemu_crucible_fault_vmstate_put_u8(
+        payload, crucible_lifecycle_node_hung);
+    qemu_crucible_fault_vmstate_put_u8(
+        payload, crucible_lifecycle_terminal_exit_requested);
+    qemu_crucible_fault_vmstate_put_u8(payload, pending->rule != NULL);
+    qemu_crucible_fault_vmstate_put_u8(payload, 0);
+    qemu_crucible_fault_vmstate_put_bytes(
+        payload, crucible_lifecycle_terminal_action_sha256, 32);
+    qemu_crucible_fault_vmstate_put_bytes(
+        payload, crucible_lifecycle_terminal_evidence_sha256, 32);
+    for (uint32_t i = 0; i < vcpu_count; i++) {
+        qemu_crucible_fault_vmstate_put_u8(
+            payload, g_array_index(
+                crucible_lifecycle_vcpu_hung, bool, i));
+    }
+    if (pending->rule) {
+        size_t marker_len = pending->ready_marker ?
+            strlen(pending->ready_marker) : 0;
+
+        if (marker_len > UINT8_MAX) {
+            return -EINVAL;
+        }
+        qemu_crucible_fault_vmstate_put_u8(
+            payload, pending->complete_deferred);
+        qemu_crucible_fault_vmstate_put_u8(
+            payload, pending->waiting_ready);
+        qemu_crucible_fault_vmstate_put_u8(payload, marker_len);
+        qemu_crucible_fault_vmstate_put_u8(payload, 0);
+        qemu_crucible_fault_vmstate_put_u32(payload, pending_reservation);
+        qemu_crucible_fault_vmstate_put_u64(
+            payload, pending->observed_icount);
+        qemu_crucible_fault_vmstate_put_u32(
+            payload, pending->boot_policy);
+        qemu_crucible_fault_vmstate_put_u32(
+            payload, pending->maximum_attempts);
+        qemu_crucible_fault_vmstate_put_u32(payload, pending->attempt);
+        qemu_crucible_fault_vmstate_put_u32(
+            payload, pending->exhausted_transition);
+        qemu_crucible_fault_vmstate_put_u64(payload, pending->retry_delay);
+        qemu_crucible_fault_vmstate_put_u64(
+            payload, pending->ready_deadline_ns);
+        qemu_crucible_fault_vmstate_put_u64(
+            payload, pending->preserved_state_len);
+        qemu_crucible_fault_vmstate_put_bytes(
+            payload, pending->before_hash, 32);
+        qemu_crucible_fault_vmstate_put_bytes(
+            payload, pending->evidence, sizeof(pending->evidence));
+        qemu_crucible_fault_vmstate_put_bytes(
+            payload, pending->ready_marker, marker_len);
+        qemu_crucible_fault_vmstate_put_bytes(
+            payload, pending->preserved_state,
+            pending->preserved_state_len);
+        if (pending->complete_deferred) {
+            qemu_crucible_fault_rule_vmstate_save(payload, pending->rule);
+        } else {
+            qemu_crucible_fault_rule_reference_vmstate_save(
+                payload, pending->rule);
+        }
+    }
+    for (uint32_t i = 0; i < hang_count; i++) {
+        CrucibleHangState *hang = g_ptr_array_index(
+            crucible_lifecycle_hangs, i);
+        size_t activation =
+            crucible_lifecycle_vmstate_reservation_remaining(
+                hang->activation_reservation);
+        size_t watchdog =
+            crucible_lifecycle_vmstate_reservation_remaining(
+                hang->watchdog_reservation);
+        size_t recovery =
+            crucible_lifecycle_vmstate_reservation_remaining(
+                hang->recovery_reservation);
+
+        if (activation > UINT32_MAX || watchdog > UINT32_MAX ||
+            recovery > UINT32_MAX ||
+            (hang->watchdog_fired && watchdog != 0) ||
+            (!hang->watchdog_enabled && watchdog != 0)) {
+            return -EINVAL;
+        }
+        qemu_crucible_fault_rule_reference_vmstate_save(
+            payload, hang->rule);
+        qemu_crucible_fault_vmstate_put_u64(
+            payload, hang->entered_icount);
+        qemu_crucible_fault_vmstate_put_u64(
+            payload, hang->entered_virtual_ns);
+        qemu_crucible_fault_vmstate_put_u64(
+            payload, hang->watchdog_deadline_ns);
+        qemu_crucible_fault_vmstate_put_u32(payload, activation);
+        qemu_crucible_fault_vmstate_put_u32(payload, watchdog);
+        qemu_crucible_fault_vmstate_put_u32(payload, recovery);
+        qemu_crucible_fault_vmstate_put_u8(
+            payload, hang->watchdog_enabled);
+        qemu_crucible_fault_vmstate_put_u8(payload, hang->watchdog_fired);
+        qemu_crucible_fault_vmstate_put_u16(payload, 0);
+    }
+    return 0;
+}
+
+static void crucible_lifecycle_vmstate_free(void *opaque)
+{
+    CrucibleLifecycleVmstate *state = opaque;
+
+    if (!state) {
+        return;
+    }
+    qemu_crucible_fault_rule_unref(state->pending_reset.rule);
+    g_free(state->pending_reset.preserved_state);
+    g_free(state->pending_reset.ready_marker);
+    g_clear_pointer(&state->hangs, g_ptr_array_unref);
+    g_clear_pointer(&state->vcpu_hung, g_array_unref);
+    g_free(state);
+}
+
+static bool crucible_lifecycle_vmstate_hash_zero(const uint8_t hash[32])
+{
+    uint8_t zero[32] = { 0 };
+
+    return memcmp(hash, zero, sizeof(zero)) == 0;
+}
+
+static int crucible_lifecycle_vmstate_prepare(
+    const uint8_t *payload, size_t payload_len, void **staged_out)
+{
+    QemuCrucibleFaultVmstateReader reader = {
+        .data = payload,
+        .length = payload_len,
+    };
+    CrucibleLifecycleVmstate *state = g_new0(
+        CrucibleLifecycleVmstate, 1);
+    CrucibleLifecyclePendingReset *pending = &state->pending_reset;
+    uint8_t magic[8], node_hung, exit_requested, has_pending, reserved8;
+    uint32_t hang_count, vcpu_count;
+
+    state->hangs = g_ptr_array_new_with_free_func(
+        crucible_hang_state_free);
+    if (!qemu_crucible_fault_vmstate_get_bytes(&reader, magic, 8) ||
+        memcmp(magic, "CRUCLVS1", 8) != 0 ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            &reader, &state->process_generation) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            &reader, &state->next_watchdog_ns) ||
+        !qemu_crucible_fault_vmstate_get_u32(
+            &reader, &state->terminal_transition) ||
+        !qemu_crucible_fault_vmstate_get_u32(&reader, &hang_count) ||
+        !qemu_crucible_fault_vmstate_get_u32(&reader, &vcpu_count) ||
+        !qemu_crucible_fault_vmstate_get_u8(&reader, &node_hung) ||
+        !qemu_crucible_fault_vmstate_get_u8(&reader, &exit_requested) ||
+        !qemu_crucible_fault_vmstate_get_u8(&reader, &has_pending) ||
+        !qemu_crucible_fault_vmstate_get_u8(&reader, &reserved8) ||
+        !qemu_crucible_fault_vmstate_get_bytes(
+            &reader, state->terminal_action_sha256, 32) ||
+        !qemu_crucible_fault_vmstate_get_bytes(
+            &reader, state->terminal_evidence_sha256, 32) ||
+        state->process_generation == 0 ||
+        hang_count > 4096 ||
+        vcpu_count > 4096 || node_hung > 1 || exit_requested > 1 ||
+        has_pending > 1 || reserved8 != 0 ||
+        (state->terminal_transition != 0 &&
+         crucible_lifecycle_terminal_exit_code(
+             state->terminal_transition) == 0) ||
+        (state->terminal_transition == 0 &&
+         (exit_requested ||
+          !crucible_lifecycle_vmstate_hash_zero(
+              state->terminal_action_sha256) ||
+          !crucible_lifecycle_vmstate_hash_zero(
+              state->terminal_evidence_sha256)))) {
+        goto fail;
+    }
+    if (state->process_generation != crucible_lifecycle_process_generation) {
+        if (state->process_generation == UINT64_MAX ||
+            state->process_generation + 1 !=
+                crucible_lifecycle_process_generation ||
+            state->terminal_transition == 0) {
+            goto fail;
+        }
+        state->replacement_handoff = true;
+    }
+    state->node_hung = node_hung;
+    state->terminal_exit_requested = exit_requested;
+    state->vcpu_hung = g_array_sized_new(
+        false, true, sizeof(bool), vcpu_count);
+    for (uint32_t i = 0; i < vcpu_count; i++) {
+        uint8_t hung;
+        bool value;
+
+        if (!qemu_crucible_fault_vmstate_get_u8(&reader, &hung) || hung > 1) {
+            goto fail;
+        }
+        value = hung;
+        g_array_append_val(state->vcpu_hung, value);
+    }
+    if (has_pending) {
+        const uint8_t *marker, *preserved;
+        uint8_t complete_deferred, waiting_ready, marker_len;
+        uint64_t preserved_len;
+        CrucibleLifecyclePlan plan = { 0 };
+        uint64_t timeout;
+
+        if (!qemu_crucible_fault_vmstate_get_u8(
+                &reader, &complete_deferred) ||
+            !qemu_crucible_fault_vmstate_get_u8(&reader, &waiting_ready) ||
+            !qemu_crucible_fault_vmstate_get_u8(&reader, &marker_len) ||
+            !qemu_crucible_fault_vmstate_get_u8(&reader, &reserved8) ||
+            !qemu_crucible_fault_vmstate_get_u32(
+                &reader, &pending->vmstate_reservation_remaining) ||
+            !qemu_crucible_fault_vmstate_get_u64(
+                &reader, &pending->observed_icount) ||
+            !qemu_crucible_fault_vmstate_get_u32(
+                &reader, &pending->boot_policy) ||
+            !qemu_crucible_fault_vmstate_get_u32(
+                &reader, &pending->maximum_attempts) ||
+            !qemu_crucible_fault_vmstate_get_u32(
+                &reader, &pending->attempt) ||
+            !qemu_crucible_fault_vmstate_get_u32(
+                &reader, &pending->exhausted_transition) ||
+            !qemu_crucible_fault_vmstate_get_u64(
+                &reader, &pending->retry_delay) ||
+            !qemu_crucible_fault_vmstate_get_u64(
+                &reader, &pending->ready_deadline_ns) ||
+            !qemu_crucible_fault_vmstate_get_u64(
+                &reader, &preserved_len) ||
+            !qemu_crucible_fault_vmstate_get_bytes(
+                &reader, pending->before_hash, 32) ||
+            !qemu_crucible_fault_vmstate_get_bytes(
+                &reader, pending->evidence, sizeof(pending->evidence)) ||
+            !qemu_crucible_fault_vmstate_get_view(
+                &reader, &marker, marker_len) ||
+            preserved_len > CRUCIBLE_LIFECYCLE_VMSTATE_MAX_PRESERVED_BYTES ||
+            !qemu_crucible_fault_vmstate_get_view(
+                &reader, &preserved, preserved_len) ||
+            complete_deferred > 1 || waiting_ready > 1 || reserved8 != 0 ||
+            (marker_len != 0 &&
+             (!g_utf8_validate((const char *)marker, marker_len, NULL) ||
+              memchr(marker, '\0', marker_len) != NULL)) ||
+            pending->vmstate_reservation_remaining == 0 ||
+            pending->maximum_attempts == 0 || pending->attempt == 0 ||
+            pending->attempt > pending->maximum_attempts) {
+            goto fail;
+        }
+        pending->complete_deferred = complete_deferred;
+        pending->waiting_ready = waiting_ready;
+        pending->ready_marker = marker_len ?
+            g_strndup((const char *)marker, marker_len) : NULL;
+        pending->preserved_state = preserved_len ?
+            g_memdup2(preserved, preserved_len) : NULL;
+        pending->preserved_state_len = preserved_len;
+        pending->rule = complete_deferred ?
+            qemu_crucible_fault_rule_vmstate_load(&reader) :
+            qemu_crucible_fault_rule_reference_vmstate_load(&reader);
+        if (!pending->rule ||
+            (complete_deferred &&
+             (qemu_crucible_fault_rule_command_kind(pending->rule) !=
+                  CRUCIBLE_FAULT_COMMAND_NODE_LIFECYCLE ||
+              qemu_crucible_fault_rule_operation(pending->rule) !=
+                  CRUCIBLE_NODE_FAULT_OPERATION_APPLY ||
+              !crucible_lifecycle_direct_plan(pending->rule, &plan))) ||
+            (!complete_deferred &&
+             (qemu_crucible_fault_rule_command_kind(pending->rule) !=
+                  CRUCIBLE_FAULT_COMMAND_NODE_HANG ||
+              !crucible_lifecycle_watchdog_plan(
+                  pending->rule, &plan, &timeout))) ||
+            plan.boot_policy != pending->boot_policy ||
+            plan.maximum_attempts != pending->maximum_attempts ||
+            plan.retry_delay != pending->retry_delay ||
+            plan.exhausted_transition != pending->exhausted_transition ||
+            (!!plan.ready_marker != !!pending->ready_marker) ||
+            (plan.ready_marker && strcmp(
+                plan.ready_marker, pending->ready_marker) != 0) ||
+            (pending->waiting_ready &&
+             pending->boot_policy != CRUCIBLE_BOOT_REQUIRE_READY) ||
+            (pending->waiting_ready &&
+             pending->ready_deadline_ns == UINT64_MAX)) {
+            goto fail;
+        }
+        qemu_crucible_fault_vmstate_count_reservations(
+            pending->vmstate_reservation_remaining);
+        pending->reservation =
+            qemu_crucible_fault_event_reservation_restore(
+                pending->vmstate_reservation_remaining);
+        if (!pending->reservation) {
+            goto fail;
+        }
+        pending->vmstate_reservation_remaining = 0;
+        if (pending->complete_deferred) {
+            qemu_crucible_fault_vmstate_count_deferred(1);
+        }
+    }
+    for (uint32_t i = 0; i < hang_count; i++) {
+        CrucibleHangState *hang = g_new0(CrucibleHangState, 1);
+        uint8_t enabled, fired;
+        uint16_t reserved16;
+        CrucibleLifecyclePlan plan;
+        uint64_t timeout;
+
+        hang->rule = qemu_crucible_fault_rule_reference_vmstate_load(
+            &reader);
+        if (!hang->rule ||
+            !qemu_crucible_fault_vmstate_get_u64(
+                &reader, &hang->entered_icount) ||
+            !qemu_crucible_fault_vmstate_get_u64(
+                &reader, &hang->entered_virtual_ns) ||
+            !qemu_crucible_fault_vmstate_get_u64(
+                &reader, &hang->watchdog_deadline_ns) ||
+            !qemu_crucible_fault_vmstate_get_u32(
+                &reader, &hang->vmstate_activation_remaining) ||
+            !qemu_crucible_fault_vmstate_get_u32(
+                &reader, &hang->vmstate_watchdog_remaining) ||
+            !qemu_crucible_fault_vmstate_get_u32(
+                &reader, &hang->vmstate_recovery_remaining) ||
+            !qemu_crucible_fault_vmstate_get_u8(&reader, &enabled) ||
+            !qemu_crucible_fault_vmstate_get_u8(&reader, &fired) ||
+            !qemu_crucible_fault_vmstate_get_u16(&reader, &reserved16) ||
+            enabled > 1 || fired > 1 || reserved16 != 0 ||
+            qemu_crucible_fault_rule_command_kind(hang->rule) !=
+                CRUCIBLE_FAULT_COMMAND_NODE_HANG ||
+            qemu_crucible_fault_rule_operation(hang->rule) !=
+                CRUCIBLE_NODE_FAULT_OPERATION_UPSERT ||
+            qemu_crucible_fault_lifecycle_validate(hang->rule) != 0 ||
+            (i != 0 && memcmp(
+                qemu_crucible_fault_rule_binding_hash(
+                    ((CrucibleHangState *)g_ptr_array_index(
+                        state->hangs, i - 1))->rule),
+                qemu_crucible_fault_rule_binding_hash(hang->rule), 32) >= 0)) {
+            crucible_hang_state_free(hang);
+            goto fail;
+        }
+        hang->watchdog_enabled = enabled;
+        hang->watchdog_fired = fired;
+        if (hang->vmstate_activation_remaining != 0 ||
+            (hang->watchdog_fired &&
+             (hang->vmstate_watchdog_remaining != 0 ||
+              hang->vmstate_recovery_remaining != 0)) ||
+            (!hang->watchdog_fired &&
+             (hang->vmstate_recovery_remaining != 1 ||
+              hang->vmstate_watchdog_remaining !=
+                  (uint32_t)hang->watchdog_enabled)) ||
+            (crucible_lifecycle_watchdog_plan(
+                 hang->rule, &plan, &timeout) != hang->watchdog_enabled) ||
+            (hang->watchdog_enabled &&
+             (timeout > UINT64_MAX - hang->entered_virtual_ns ||
+              hang->watchdog_deadline_ns !=
+                  hang->entered_virtual_ns + timeout)) ||
+            (!hang->watchdog_enabled &&
+             hang->watchdog_deadline_ns != UINT64_MAX)) {
+            crucible_hang_state_free(hang);
+            goto fail;
+        }
+        qemu_crucible_fault_vmstate_count_reservations(
+            hang->vmstate_activation_remaining +
+            hang->vmstate_watchdog_remaining +
+            hang->vmstate_recovery_remaining);
+        if (hang->vmstate_activation_remaining) {
+            hang->activation_reservation =
+                qemu_crucible_fault_event_reservation_restore(
+                    hang->vmstate_activation_remaining);
+        }
+        if (hang->vmstate_watchdog_remaining) {
+            hang->watchdog_reservation =
+                qemu_crucible_fault_event_reservation_restore(
+                    hang->vmstate_watchdog_remaining);
+        }
+        if (hang->vmstate_recovery_remaining) {
+            hang->recovery_reservation =
+                qemu_crucible_fault_event_reservation_restore(
+                    hang->vmstate_recovery_remaining);
+        }
+        if ((hang->vmstate_activation_remaining &&
+             !hang->activation_reservation) ||
+            (hang->vmstate_watchdog_remaining &&
+             !hang->watchdog_reservation) ||
+            (hang->vmstate_recovery_remaining &&
+             !hang->recovery_reservation)) {
+            crucible_hang_state_free(hang);
+            goto fail;
+        }
+        hang->vmstate_activation_remaining = 0;
+        hang->vmstate_watchdog_remaining = 0;
+        hang->vmstate_recovery_remaining = 0;
+        g_ptr_array_add(state->hangs, hang);
+    }
+    if (!qemu_crucible_fault_vmstate_reader_finished(&reader)) {
+        goto fail;
+    }
+    {
+        CrucibleHangApply apply = {
+            .vcpu_hung = g_array_sized_new(
+                false, true, sizeof(bool), vcpu_count),
+        };
+        uint64_t next_watchdog = UINT64_MAX;
+
+        g_array_set_size(apply.vcpu_hung, vcpu_count);
+        for (guint i = 0; i < state->hangs->len; i++) {
+            CrucibleHangState *hang = g_ptr_array_index(state->hangs, i);
+
+            if (!hang->watchdog_fired) {
+                crucible_lifecycle_apply_hang(hang->rule, &apply);
+            }
+            if (hang->watchdog_enabled && !hang->watchdog_fired) {
+                next_watchdog = MIN(
+                    next_watchdog, hang->watchdog_deadline_ns);
+            }
+        }
+        if (apply.node_hung != state->node_hung ||
+            apply.vcpu_hung->len != state->vcpu_hung->len ||
+            memcmp(apply.vcpu_hung->data, state->vcpu_hung->data,
+                   state->vcpu_hung->len * sizeof(bool)) != 0 ||
+            next_watchdog != state->next_watchdog_ns) {
+            g_array_unref(apply.vcpu_hung);
+            goto fail;
+        }
+        g_array_unref(apply.vcpu_hung);
+    }
+    *staged_out = state;
+    return 0;
+
+fail:
+    crucible_lifecycle_vmstate_free(state);
+    return -EINVAL;
+}
+
+static void crucible_lifecycle_vmstate_commit(void *opaque)
+{
+    CrucibleLifecycleVmstate *state = opaque;
+
+    if (crucible_lifecycle_pending_reset.rule) {
+        crucible_lifecycle_pending_clear(
+            &crucible_lifecycle_pending_reset);
+    }
+    if (state->pending_reset.rule) {
+        crucible_lifecycle_pending_reset = state->pending_reset;
+        memset(&state->pending_reset, 0, sizeof(state->pending_reset));
+    } else {
+        memset(&crucible_lifecycle_pending_reset, 0,
+               sizeof(crucible_lifecycle_pending_reset));
+    }
+    g_clear_pointer(&crucible_lifecycle_hangs, g_ptr_array_unref);
+    crucible_lifecycle_hangs = g_steal_pointer(&state->hangs);
+    g_clear_pointer(&crucible_lifecycle_vcpu_hung, g_array_unref);
+    crucible_lifecycle_vcpu_hung = g_steal_pointer(&state->vcpu_hung);
+    crucible_lifecycle_node_hung = state->node_hung;
+    crucible_lifecycle_next_watchdog_ns = state->next_watchdog_ns;
+    if (state->replacement_handoff) {
+        crucible_lifecycle_terminal_transition = 0;
+        crucible_lifecycle_terminal_exit_requested = false;
+        memset(crucible_lifecycle_terminal_action_sha256, 0, 32);
+        memset(crucible_lifecycle_terminal_evidence_sha256, 0, 32);
+    } else {
+        crucible_lifecycle_terminal_transition = state->terminal_transition;
+        crucible_lifecycle_terminal_exit_requested =
+            state->terminal_exit_requested;
+        memcpy(crucible_lifecycle_terminal_action_sha256,
+               state->terminal_action_sha256, 32);
+        memcpy(crucible_lifecycle_terminal_evidence_sha256,
+               state->terminal_evidence_sha256, 32);
+    }
+    crucible_lifecycle_vmstate_free(state);
+}
+
+static const QemuCrucibleFaultVmstateSection
+crucible_lifecycle_vmstate_section = {
+    .name = "lifecycle",
+    .version = 1,
+    .save = crucible_lifecycle_vmstate_save,
+    .prepare = crucible_lifecycle_vmstate_prepare,
