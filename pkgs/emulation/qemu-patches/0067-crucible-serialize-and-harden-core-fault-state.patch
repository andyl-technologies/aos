+bool qemu_crucible_fault_register_vmstate_identity(uint8_t identity[32])
+{
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    uint8_t scope[2];
+    gsize identity_len = 32;
+
+    if (!identity || !crucible_register_bindings_sealed ||
+        !crucible_register_architecture_bound ||
+        !crucible_register_manifest || !crucible_register_numeric_bindings ||
+        !crucible_cpu_model) {
+        return false;
+    }
+    stw_le_p(scope, crucible_register_scope);
+    g_checksum_update(checksum, (const uint8_t *)"CRUCRVS1", 8);
+    g_checksum_update(checksum, scope, sizeof(scope));
+    g_checksum_update(checksum, crucible_register_architecture_identity, 32);
+    g_checksum_update(checksum, (const uint8_t *)crucible_cpu_model,
+                      strlen(crucible_cpu_model) + 1);
+    for (guint numeric_id = 1;
+         numeric_id <= crucible_register_manifest->len; numeric_id++) {
+        GBytes *binding = g_hash_table_lookup(
+            crucible_register_numeric_bindings,
+            GUINT_TO_POINTER(numeric_id));
+        gsize binding_len;
+        const uint8_t *bytes;
+
+        if (!binding) {
+            return false;
+        }
+        bytes = g_bytes_get_data(binding, &binding_len);
+        if (binding_len != 32) {
+            return false;
+        }
+        g_checksum_update(checksum, bytes, binding_len);
+    }
+    g_checksum_get_digest(checksum, identity, &identity_len);
+    g_assert(identity_len == 32);
+    return true;
+}
