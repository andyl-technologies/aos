+            CRUCIBLE_FAULT_COMMAND_CPU_INSTRUCTION_TRANSFORM,
+            crucible_instruction_index_visit, state->restored_index)) {
+        goto fail;
+    }
+    for (guint i = 0; i < state->restored_impulses->len; i++) {
+        CrucibleInstructionImpulse *impulse = g_ptr_array_index(
+            state->restored_impulses, i);
+
+        crucible_instruction_index_visit(
+            impulse->rule, state->restored_index);
+    }
+    qemu_crucible_fault_vmstate_count_deferred(state->impulses->len);
+    *staged_out = state;
+    return 0;
+
+fail:
+    crucible_instruction_vmstate_free(state);
+    return -EINVAL;
+}
+
+static void crucible_instruction_vmstate_commit(void *opaque)
+{
+    CrucibleCpuVmstate *state = opaque;
+
+    g_clear_pointer(&crucible_instruction_impulses, g_ptr_array_unref);
+    crucible_instruction_impulses =
+        g_steal_pointer(&state->restored_impulses);
+    memset(&crucible_instruction_root, 0, sizeof(crucible_instruction_root));
+    g_clear_pointer(&crucible_instruction_index, g_array_unref);
+    crucible_instruction_index = g_steal_pointer(&state->restored_index);
+    for (guint i = 0; i < crucible_instruction_index->len; i++) {
+        CrucibleInstructionIndexEntry *entry = &g_array_index(
+            crucible_instruction_index, CrucibleInstructionIndexEntry, i);
+
+        interval_tree_insert(&entry->interval, &crucible_instruction_root);
+    }
+    crucible_instruction_event_terminal_latched = state->event_terminal;
+    crucible_instruction_vmstate_free(state);
+}
