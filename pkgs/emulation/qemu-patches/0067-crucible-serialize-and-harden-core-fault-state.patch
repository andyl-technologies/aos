+static bool crucible_interrupt_vmstate_identity(uint8_t identity[32])
+{
+    g_autoptr(GByteArray) encoded = g_byte_array_new();
+
+    if (!crucible_interrupt_manifest_init() ||
+        !crucible_interrupt_bindings_sealed ||
+        crucible_interrupt_manifest->len != crucible_interrupt_bindings->len) {
+        return false;
+    }
+    qemu_crucible_fault_vmstate_put_bytes(encoded, "CRUCIMI1", 8);
+    qemu_crucible_fault_vmstate_put_u16(encoded, crucible_interrupt_scope);
+    qemu_crucible_fault_vmstate_put_u16(encoded, 0);
+    qemu_crucible_fault_vmstate_put_u32(
+        encoded, crucible_interrupt_manifest->len);
+    for (guint i = 0; i < crucible_interrupt_manifest->len; i++) {
+        const CrucibleInterruptCapability *row = &g_array_index(
+            crucible_interrupt_manifest, CrucibleInterruptCapability, i);
+        const CrucibleInterruptBinding *binding = &g_array_index(
+            crucible_interrupt_bindings, CrucibleInterruptBinding, i);
+        const char *strings[] = {
+            row->id, row->controller, row->source, row->controller_version,
+        };
+
+        qemu_crucible_fault_vmstate_put_u16(encoded, row->family);
+        qemu_crucible_fault_vmstate_put_u16(encoded, row->trigger);
+        qemu_crucible_fault_vmstate_put_u16(encoded, row->polarity);
+        qemu_crucible_fault_vmstate_put_u16(encoded, row->delivery_drop);
+        qemu_crucible_fault_vmstate_put_u32(encoded, row->vector_start);
+        qemu_crucible_fault_vmstate_put_u32(encoded, row->vector_end);
+        qemu_crucible_fault_vmstate_put_u32(
+            encoded, row->replacement_vector_start);
+        qemu_crucible_fault_vmstate_put_u32(
+            encoded, row->replacement_vector_end);
+        qemu_crucible_fault_vmstate_put_u16(encoded, row->priority);
+        qemu_crucible_fault_vmstate_put_u8(encoded, row->vmstate);
+        qemu_crucible_fault_vmstate_put_u8(encoded, row->reserved);
+        qemu_crucible_fault_vmstate_put_u64(encoded, row->model_phase_mask);
+        qemu_crucible_fault_vmstate_put_u32(
+            encoded, row->target_vcpu_count);
+        for (size_t target = 0; target < row->target_vcpu_count; target++) {
+            qemu_crucible_fault_vmstate_put_u32(
+                encoded, row->target_vcpus[target]);
+        }
+        for (size_t string = 0; string < G_N_ELEMENTS(strings); string++) {
+            size_t length = strlen(strings[string]);
+
+            if (length > UINT16_MAX) {
+                return false;
+            }
+            qemu_crucible_fault_vmstate_put_u16(encoded, length);
+            qemu_crucible_fault_vmstate_put_bytes(
+                encoded, strings[string], length);
+        }
+        qemu_crucible_fault_vmstate_put_bytes(encoded, binding->id, 32);
+        qemu_crucible_fault_vmstate_put_bytes(
+            encoded, binding->controller, 32);
+        qemu_crucible_fault_vmstate_put_bytes(encoded, binding->source, 32);
+    }
+    crucible_interrupt_sha256(encoded->data, encoded->len, identity);
+    return true;
+}
+
+static gint crucible_interrupt_vmstate_provenance_compare(
+    gconstpointer left, gconstpointer right)
+{
+    const CrucibleInterruptVmstateProvenance *a = left;
+    const CrucibleInterruptVmstateProvenance *b = right;
+
+    if (a->key.family != b->key.family) {
+        return (a->key.family > b->key.family) -
+               (a->key.family < b->key.family);
+    }
+    if (a->key.target_vcpu != b->key.target_vcpu) {
+        return (a->key.target_vcpu > b->key.target_vcpu) -
+               (a->key.target_vcpu < b->key.target_vcpu);
+    }
+    return (a->key.vector > b->key.vector) -
+           (a->key.vector < b->key.vector);
+}
