+
+bool qemu_crucible_fault_vmstate_get_view(
+    QemuCrucibleFaultVmstateReader *reader, const uint8_t **value,
+    size_t length)
+{
+    if (reader->offset > reader->length ||
+        length > reader->length - reader->offset) {
+        return false;
+    }
+    *value = reader->data + reader->offset;
+    reader->offset += length;
+    return true;
+}
+
+bool qemu_crucible_fault_vmstate_get_bytes(
+    QemuCrucibleFaultVmstateReader *reader, void *value, size_t length)
+{
+    const uint8_t *encoded;
+
+    if (!qemu_crucible_fault_vmstate_get_view(reader, &encoded, length)) {
+        return false;
+    }
+    memcpy(value, encoded, length);
+    return true;
+}
+
+bool qemu_crucible_fault_vmstate_get_u8(
+    QemuCrucibleFaultVmstateReader *reader, uint8_t *value)
+{
