+
+static bool crucible_vcpu_vmstate_get_service(
+    QemuCrucibleFaultVmstateReader *reader, CrucibleVcpuService *service)
+{
+#define GET(field) \
+    qemu_crucible_fault_vmstate_get_u64(reader, &service->field)
+    if (!GET(numerator) || !GET(denominator) || !GET(quantum) ||
+        !GET(remainder) || !GET(window_remainder_before) ||
+        !GET(credit_remaining) || !GET(window_credit) ||
+        !GET(window_retired) || !GET(denied_pending) ||
+        !GET(skipped_selections) || !GET(window_sequence) ||
+        !GET(grant_own) || !GET(grant_borrowed) ||
+        !GET(window_own_retired) || !GET(window_borrowed_retired) ||
+        !GET(donated_credit) ||
+        !qemu_crucible_fault_vmstate_get_u32(reader,
+                                              &service->discipline) ||
+        !qemu_crucible_fault_vmstate_get_u32(reader, &service->state)) {
+        return false;
+    }
+#undef GET
+    return service->numerator != 0 && service->denominator != 0 &&
+           service->numerator <= service->denominator &&
+           service->quantum != 0 && service->remainder < service->denominator &&
+           service->discipline >= CRUCIBLE_VCPU_WORK_CONSERVING &&
+           service->discipline <= CRUCIBLE_VCPU_STRICT_CAP &&
+           service->state >= CRUCIBLE_VCPU_ONLINE &&
+           service->state <= CRUCIBLE_VCPU_STALLED;
+}
+
+static bool crucible_vcpu_vmstate_configuration_valid(
+    const CrucibleVcpuService *service, uint32_t vcpu)
+{
+    uint64_t numerator = 1, denominator = 1;
+    uint64_t quantum = icount_crucible_rr_switch_quantum();
+    uint32_t discipline = CRUCIBLE_VCPU_STRICT_CAP;
+    QemuCrucibleFaultRule *controller = NULL;
+
+    for (guint i = 0; i < service->service_rules->len; i++) {
+        QemuCrucibleFaultRule *rule = g_ptr_array_index(
+            service->service_rules, i);
+        uint64_t next_numerator, next_denominator, next_quantum;
+        uint32_t next_discipline;
+        bool first = i == 0;
+
+        if (qemu_crucible_fault_rule_command_kind(rule) !=
+                CRUCIBLE_FAULT_COMMAND_CPU_SERVICE ||
+            !crucible_vcpu_rule_selects(rule, vcpu) ||
+            !crucible_vcpu_ratio(rule, &next_numerator, &next_denominator) ||
+            !crucible_vcpu_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_P3,
+                               &next_quantum) ||
+            !crucible_vcpu_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P4,
+                               &next_discipline)) {
+            return false;
+        }
+        if (first || crucible_vcpu_ratio_less(
+                next_numerator, next_denominator, numerator, denominator)) {
+            numerator = next_numerator;
+            denominator = next_denominator;
+            quantum = next_quantum;
+            discipline = next_discipline;
+            controller = rule;
+        } else if (!crucible_vcpu_ratio_less(
+                       numerator, denominator,
+                       next_numerator, next_denominator)) {
+            quantum = MIN(quantum, next_quantum);
+            if (next_discipline > discipline) {
+                discipline = next_discipline;
+                controller = rule;
+            }
+        }
+    }
+    if (service->state_rule) {
+        uint32_t target, state;
+
+        if (qemu_crucible_fault_rule_command_kind(service->state_rule) !=
+                CRUCIBLE_FAULT_COMMAND_CPU_VCPU_STATE ||
+            !crucible_vcpu_target(service->state_rule, &target) ||
+            target != vcpu ||
+            !crucible_vcpu_u32(service->state_rule,
+                               CRUCIBLE_NODE_FAULT_FIELD_P1, &state) ||
+            state != service->state) {
+            return false;
+        }
+    } else if (service->state != CRUCIBLE_VCPU_ONLINE) {
+        return false;
+    }
+    return service->numerator == numerator &&
+           service->denominator == denominator &&
+           service->quantum == quantum &&
+           service->discipline == discipline &&
+           service->controller_rule == controller;
+}
+
+static bool crucible_vcpu_vmstate_ledger_valid(
+    const CrucibleVcpuService *service, uint32_t reservation, bool terminal)
+{
+    __uint128_t scaled = (__uint128_t)service->quantum *
+                         service->numerator +
+                         service->window_remainder_before;
+    uint64_t expected_credit = scaled / service->denominator;
+    uint64_t expected_remainder = scaled % service->denominator;
+    bool has_window = service->window_credit != 0 ||
+                      service->window_retired != 0 ||
+                      service->denied_pending != 0 ||
+                      service->window_own_retired != 0 ||
+                      service->window_borrowed_retired != 0 ||
+                      service->credit_remaining != 0;
+
+    if (service->grant_own != 0 || service->grant_borrowed != 0 ||
+        service->window_remainder_before >= service->denominator ||
+        service->window_retired == UINT64_MAX ||
+        service->window_own_retired == UINT64_MAX ||
+        service->window_borrowed_retired == UINT64_MAX ||
+        service->window_sequence == UINT64_MAX ||
+        service->window_own_retired > UINT64_MAX -
+            service->window_borrowed_retired ||
+        service->window_retired != service->window_own_retired +
+            service->window_borrowed_retired) {
+        return false;
+    }
+    if (has_window) {
+        if ((!terminal && reservation != service->service_rules->len) ||
+            (terminal && reservation != 0) ||
+            service->service_rules->len == 0 ||
+            service->window_credit == 0 ||
+            service->credit_remaining == 0 ||
+            service->donated_credit != 0 ||
+            service->window_credit != expected_credit ||
+            service->remainder != expected_remainder ||
+            service->window_credit > service->quantum ||
+            service->denied_pending != service->quantum -
+                service->window_credit ||
+            service->window_own_retired > service->window_credit ||
+            service->credit_remaining != service->window_credit -
+                service->window_own_retired) {
+            return false;
+        }
+    } else if (reservation != 0 || service->credit_remaining != 0 ||
+               service->window_credit != 0 ||
+               service->window_retired != 0 ||
+               service->denied_pending != 0 ||
+               service->window_own_retired != 0 ||
+               service->window_borrowed_retired != 0) {
+        return false;
+    }
+    if (service->donated_credit != 0 &&
+        (terminal || has_window || service->service_rules->len == 0 ||
+         !service->controller_rule ||
+         service->discipline != CRUCIBLE_VCPU_WORK_CONSERVING ||
+         service->donated_credit > service->quantum)) {
+        return false;
+    }
+    return true;
+}
+
+typedef struct CrucibleVcpuVmstateCoverage {
+    GArray *services;
+    GArray *expected_state;
+    GPtrArray *expected_state_rule;
+    bool valid;
+} CrucibleVcpuVmstateCoverage;
+
+static void crucible_vcpu_vmstate_service_rule_coverage(
+    const QemuCrucibleFaultRule *rule, void *opaque)
+{
+    CrucibleVcpuVmstateCoverage *coverage = opaque;
+
+    for (guint vcpu = 0; vcpu < coverage->services->len; vcpu++) {
+        CrucibleVcpuService *service = &g_array_index(
+            coverage->services, CrucibleVcpuService, vcpu);
+        bool present = g_ptr_array_find(
+            service->service_rules, (gpointer)rule, NULL);
+
+        if (present != crucible_vcpu_rule_selects(rule, vcpu)) {
+            coverage->valid = false;
+        }
+    }
+}
+
+static void crucible_vcpu_vmstate_state_rule_coverage(
+    const QemuCrucibleFaultRule *rule, void *opaque)
+{
+    CrucibleVcpuVmstateCoverage *coverage = opaque;
+    uint32_t target, state;
+
+    if (!crucible_vcpu_target(rule, &target) ||
+        target >= coverage->services->len ||
+        !crucible_vcpu_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P1, &state)) {
+        coverage->valid = false;
+        return;
+    }
+    uint32_t *expected = &g_array_index(
+        coverage->expected_state, uint32_t, target);
+    if ((state == CRUCIBLE_VCPU_OFFLINE &&
+         *expected != CRUCIBLE_VCPU_OFFLINE) ||
+        (*expected == CRUCIBLE_VCPU_ONLINE &&
+         state == CRUCIBLE_VCPU_STALLED)) {
+        *expected = state;
+        g_ptr_array_index(coverage->expected_state_rule, target) =
+            (gpointer)rule;
+    }
+}
+
+static int crucible_vcpu_vmstate_save(GByteArray *payload)
+{
+    size_t count = crucible_vcpu_count();
+
+    if (count == 0 || count > CRUCIBLE_VCPU_SERVICE_MAX_VCPUS ||
+        (crucible_vcpu_services && crucible_vcpu_services->len != count)) {
+        return -EINVAL;
+    }
+    qemu_crucible_fault_vmstate_put_bytes(payload, "CRUCVVS1", 8);
+    qemu_crucible_fault_vmstate_put_u32(payload, count);
+    qemu_crucible_fault_vmstate_put_u8(payload,
+                                       crucible_vcpu_service_terminal);
+    qemu_crucible_fault_vmstate_put_u8(payload, 0);
+    qemu_crucible_fault_vmstate_put_u16(payload, 0);
+    for (uint32_t i = 0; i < count; i++) {
+        CrucibleVcpuService fallback;
+        CrucibleVcpuService *service;
+        size_t reservation;
+
+        if (crucible_vcpu_services) {
+            service = &g_array_index(crucible_vcpu_services,
+                                     CrucibleVcpuService, i);
+        } else {
+            crucible_vcpu_service_init(&fallback);
+            service = &fallback;
+        }
+        reservation = qemu_crucible_fault_event_reservation_remaining(
+            service->window_reservation);
+        if (reservation > UINT32_MAX ||
+            (reservation != 0 &&
+             reservation != service->service_rules->len) ||
+            !crucible_vcpu_vmstate_ledger_valid(
+                service, reservation, crucible_vcpu_service_terminal)) {
+            if (!crucible_vcpu_services) {
+                crucible_vcpu_service_clear(&fallback);
+            }
+            return service->grant_own != 0 ||
+                   service->grant_borrowed != 0 ? -EBUSY : -EINVAL;
+        }
+        crucible_vcpu_vmstate_put_service(payload, service);
+        qemu_crucible_fault_vmstate_put_u32(
+            payload, service->service_rules->len);
+        qemu_crucible_fault_vmstate_put_u8(
+            payload, service->controller_rule != NULL);
+        qemu_crucible_fault_vmstate_put_u8(payload,
+                                           service->state_rule != NULL);
+        qemu_crucible_fault_vmstate_put_u16(payload, 0);
+        qemu_crucible_fault_vmstate_put_u32(payload, reservation);
+        qemu_crucible_fault_vmstate_put_u32(payload, 0);
+        for (guint rule_index = 0;
+             rule_index < service->service_rules->len; rule_index++) {
+            qemu_crucible_fault_rule_reference_vmstate_save(
+                payload, g_ptr_array_index(service->service_rules,
+                                            rule_index));
+        }
+        if (service->controller_rule) {
+            qemu_crucible_fault_rule_reference_vmstate_save(
+                payload, service->controller_rule);
+        }
+        if (service->state_rule) {
+            qemu_crucible_fault_rule_reference_vmstate_save(
+                payload, service->state_rule);
+        }
+        if (!crucible_vcpu_services) {
+            crucible_vcpu_service_clear(&fallback);
+        }
+    }
+    return 0;
+}
+
+static int crucible_vcpu_vmstate_prepare(const uint8_t *payload,
+                                         size_t payload_len,
+                                         void **staged_out)
+{
+    QemuCrucibleFaultVmstateReader reader = {
+        .data = payload,
+        .length = payload_len,
+    };
+    CrucibleVcpuVmstate *state = g_new0(CrucibleVcpuVmstate, 1);
+    uint8_t magic[8], terminal, reserved8;
+    uint16_t reserved16;
+    uint32_t count;
+
+    if (!qemu_crucible_fault_vmstate_get_bytes(&reader, magic, 8) ||
+        memcmp(magic, "CRUCVVS1", 8) != 0 ||
+        !qemu_crucible_fault_vmstate_get_u32(&reader, &count) ||
+        !qemu_crucible_fault_vmstate_get_u8(&reader, &terminal) ||
+        !qemu_crucible_fault_vmstate_get_u8(&reader, &reserved8) ||
+        !qemu_crucible_fault_vmstate_get_u16(&reader, &reserved16) ||
+        count != crucible_vcpu_count() || terminal > 1 ||
+        reserved8 != 0 || reserved16 != 0) {
+        goto fail;
+    }
+    state->terminal = terminal;
+    state->services = g_array_sized_new(
+        false, true, sizeof(CrucibleVcpuService), count);
+    state->reservation_remaining = g_array_sized_new(
+        false, true, sizeof(uint32_t), count);
+    g_array_set_size(state->services, count);
+    for (uint32_t i = 0; i < count; i++) {
+        CrucibleVcpuService *service = &g_array_index(
+            state->services, CrucibleVcpuService, i);
+        uint8_t has_controller, has_state;
+        uint16_t reserved;
+        uint32_t rule_count, reservation, reserved32;
+
+        service->service_rules = g_ptr_array_new_with_free_func(
+            (GDestroyNotify)qemu_crucible_fault_rule_unref);
+        if (!crucible_vcpu_vmstate_get_service(&reader, service) ||
+            !qemu_crucible_fault_vmstate_get_u32(&reader, &rule_count) ||
+            !qemu_crucible_fault_vmstate_get_u8(
+                &reader, &has_controller) ||
+            !qemu_crucible_fault_vmstate_get_u8(&reader, &has_state) ||
+            !qemu_crucible_fault_vmstate_get_u16(&reader, &reserved) ||
+            !qemu_crucible_fault_vmstate_get_u32(
+                &reader, &reservation) ||
+            !qemu_crucible_fault_vmstate_get_u32(&reader, &reserved32) ||
+            rule_count > CRUCIBLE_FAULT_DEFAULT_COMMAND_CAPACITY ||
+            has_controller > 1 || has_state > 1 || reserved != 0 ||
+            reserved32 != 0 ||
+            (reservation != 0 && reservation != rule_count)) {
+            goto fail;
+        }
+        for (uint32_t rule_index = 0; rule_index < rule_count; rule_index++) {
+            QemuCrucibleFaultRule *rule =
+                qemu_crucible_fault_rule_reference_vmstate_load(&reader);
+
+            if (!rule || g_ptr_array_find(service->service_rules,
+                                          rule, NULL)) {
+                qemu_crucible_fault_rule_unref(rule);
+                goto fail;
+            }
+            g_ptr_array_add(service->service_rules, rule);
+        }
+        if (has_controller) {
+            QemuCrucibleFaultRule *controller =
+                qemu_crucible_fault_rule_reference_vmstate_load(&reader);
+
+            if (!controller || !g_ptr_array_find(
+                    service->service_rules, controller, NULL)) {
+                qemu_crucible_fault_rule_unref(controller);
+                goto fail;
+            }
+            service->controller_rule = controller;
+            qemu_crucible_fault_rule_unref(controller);
+        }
+        if (has_state) {
+            service->state_rule =
+                qemu_crucible_fault_rule_reference_vmstate_load(&reader);
+            if (!service->state_rule) {
+                goto fail;
+            }
+        }
+        if (!crucible_vcpu_vmstate_configuration_valid(service, i)) {
+            goto fail;
+        }
+        if (!crucible_vcpu_vmstate_ledger_valid(
+                service, reservation, state->terminal)) {
+            goto fail;
+        }
+        g_array_append_val(state->reservation_remaining, reservation);
+    }
+    CrucibleVcpuVmstateCoverage coverage = {
+        .services = state->services,
+        .expected_state = g_array_sized_new(
+            false, true, sizeof(uint32_t), count),
+        .expected_state_rule = g_ptr_array_sized_new(count),
+        .valid = true,
+    };
+    g_array_set_size(coverage.expected_state, count);
+    g_ptr_array_set_size(coverage.expected_state_rule, count);
+    for (uint32_t i = 0; i < count; i++) {
+        g_array_index(coverage.expected_state, uint32_t, i) =
+            CRUCIBLE_VCPU_ONLINE;
+    }
+    if (!qemu_crucible_fault_rule_foreach_staged(
+            CRUCIBLE_FAULT_COMMAND_CPU_SERVICE,
+            crucible_vcpu_vmstate_service_rule_coverage, &coverage) ||
+        !qemu_crucible_fault_rule_foreach_staged(
+            CRUCIBLE_FAULT_COMMAND_CPU_VCPU_STATE,
+            crucible_vcpu_vmstate_state_rule_coverage, &coverage) ||
+        !coverage.valid) {
+        g_array_unref(coverage.expected_state);
+        g_ptr_array_unref(coverage.expected_state_rule);
+        goto fail;
+    }
+    for (uint32_t i = 0; i < count; i++) {
+        CrucibleVcpuService *service = &g_array_index(
+            state->services, CrucibleVcpuService, i);
+
+        if (service->state != g_array_index(
+                coverage.expected_state, uint32_t, i) ||
+            service->state_rule != g_ptr_array_index(
+                coverage.expected_state_rule, i)) {
+            coverage.valid = false;
+            break;
+        }
+    }
+    g_array_unref(coverage.expected_state);
+    g_ptr_array_unref(coverage.expected_state_rule);
+    if (!coverage.valid) {
+        goto fail;
+    }
+    if (!qemu_crucible_fault_vmstate_reader_finished(&reader)) {
+        goto fail;
+    }
+    for (guint i = 0; i < state->reservation_remaining->len; i++) {
+        uint32_t remaining = g_array_index(
+            state->reservation_remaining, uint32_t, i);
+
+        qemu_crucible_fault_vmstate_count_reservations(remaining);
+        if (remaining != 0) {
+            CrucibleVcpuService *service = &g_array_index(
+                state->services, CrucibleVcpuService, i);
+
+            service->window_reservation =
+                qemu_crucible_fault_event_reservation_restore(remaining);
+            if (!service->window_reservation) {
+                goto fail;
+            }
+        }
+    }
+    *staged_out = state;
+    return 0;
+
+fail:
+    crucible_vcpu_vmstate_free(state);
+    return -EINVAL;
+}
+
+static void crucible_vcpu_vmstate_commit(void *opaque)
+{
+    CrucibleVcpuVmstate *state = opaque;
+
+    if (crucible_vcpu_services) {
+        for (guint i = 0; i < crucible_vcpu_services->len; i++) {
+            crucible_vcpu_service_clear(&g_array_index(
+                crucible_vcpu_services, CrucibleVcpuService, i));
+        }
+        g_array_unref(crucible_vcpu_services);
+    }
+    crucible_vcpu_services = g_steal_pointer(&state->services);
+    crucible_vcpu_service_terminal = state->terminal;
+    crucible_vcpu_vmstate_free(state);
+}
+
+static const QemuCrucibleFaultVmstateSection
+crucible_vcpu_vmstate_section = {
+    .name = "vcpu-service",
+    .version = 1,
+    .save = crucible_vcpu_vmstate_save,
+    .prepare = crucible_vcpu_vmstate_prepare,
+    .commit = crucible_vcpu_vmstate_commit,
+    .free_staged = crucible_vcpu_vmstate_free,
+};
+
 static void crucible_vcpu_service_register(void)
 {
     const uint32_t boundary =
@@ -950,6 +1458,7 @@ static void crucible_vcpu_service_register(void)
         CRUCIBLE_FAULT_COMMAND_CPU_VCPU_STATE,
         QEMU_PLUGIN_CRUCIBLE_FAULT_SCOPE_ALL, boundary,
         "qemu.cpu.vcpu-state.v1", NULL);
+    qemu_crucible_fault_vmstate_register(&crucible_vcpu_vmstate_section);
 }
 
 type_init(crucible_vcpu_service_register)
diff --git a/plugins/crucible-fault-vmstate.c b/plugins/crucible-fault-vmstate.c
new file mode 100644
index 000000000..629eb40dc
--- /dev/null
+++ b/plugins/crucible-fault-vmstate.c
@@ -0,0 +1,514 @@
+/*
