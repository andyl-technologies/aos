+static int crucible_hardware_vmstate_prepare(
+    const uint8_t *payload, size_t payload_len, void **staged_out)
+{
+    QemuCrucibleFaultVmstateReader reader = {
+        .data = payload,
+        .length = payload_len,
+    };
+    CrucibleHardwareVmstate *state = g_new0(CrucibleHardwareVmstate, 1);
+    GPtrArray *pending = g_ptr_array_new_with_free_func(
+        crucible_hardware_pending_free);
+    uint8_t magic[8], saved_identity[32], current_identity[32];
+    uint8_t terminal, reserved8;
+    uint16_t reserved16;
+    uint32_t count;
+
+    if (!qemu_crucible_fault_vmstate_get_bytes(&reader, magic, 8) ||
+        memcmp(magic, "CRUCHVS1", 8) != 0 ||
+        !qemu_crucible_fault_vmstate_get_bytes(
+            &reader, saved_identity, 32) ||
+        !crucible_hardware_vmstate_identity(current_identity) ||
+        memcmp(saved_identity, current_identity, 32) != 0 ||
+        !qemu_crucible_fault_vmstate_get_u32(&reader, &count) ||
+        !qemu_crucible_fault_vmstate_get_u8(&reader, &terminal) ||
+        !qemu_crucible_fault_vmstate_get_u8(&reader, &reserved8) ||
+        !qemu_crucible_fault_vmstate_get_u16(&reader, &reserved16) ||
+        count > 4096 || terminal > 1 || reserved8 != 0 || reserved16 != 0 ||
+        (terminal && count != 0)) {
+        goto fail;
+    }
+    for (uint32_t i = 0; i < count; i++) {
+        CrucibleHardwarePending *item = g_new0(
+            CrucibleHardwarePending, 1);
+        CPUFaultException derived_exception = { 0 };
+        CPUFaultHardwareErrorState current_cpu = { 0 };
+        AcpiGhesMemoryErrorState current_ghes = { 0 };
+        uint32_t cpu_index, reserved32, derived_row;
+        uint16_t derived_visibility;
+        uint64_t rule_address, rule_syndrome;
+        const CrucibleHardwareBinding *binding;
+        uint32_t snapshot_bank;
+
+        if (!qemu_crucible_fault_vmstate_get_u32(&reader, &cpu_index) ||
+            !qemu_crucible_fault_vmstate_get_u32(
+                &reader, &item->row_index) ||
+            !qemu_crucible_fault_vmstate_get_u16(
+                &reader, &item->ghes_source_id) ||
+            !qemu_crucible_fault_vmstate_get_u16(&reader, &reserved16) ||
+            !qemu_crucible_fault_vmstate_get_u64(
+                &reader, &item->command_icount) ||
+            !qemu_crucible_fault_vmstate_get_u64(
+                &reader, &item->address) ||
+            !qemu_crucible_fault_vmstate_get_u64(
+                &reader, &item->ecc_syndrome) ||
+            !qemu_crucible_fault_vmstate_get_u32(
+                &reader, &item->vmstate_reservation_remaining) ||
+            !qemu_crucible_fault_vmstate_get_u32(&reader, &reserved32) ||
+            !qemu_crucible_fault_vmstate_get_bytes(
+                &reader, item->before_hash, 32) ||
+            !qemu_crucible_fault_vmstate_get_bytes(&reader, item->id, 32) ||
+            !qemu_crucible_fault_vmstate_get_bytes(&reader, item->bank, 32) ||
+            !qemu_crucible_fault_vmstate_get_bytes(
+                &reader, item->channel, 32) ||
+            !qemu_crucible_fault_vmstate_get_bytes(&reader, item->rank, 32) ||
+            !qemu_crucible_fault_vmstate_get_bytes(
+                &reader, item->firmware, 32) ||
+            !qemu_crucible_fault_vmstate_get_bytes(&reader, item->state, 32) ||
+            reserved16 != 0 || reserved32 != 0 ||
+            item->row_index >= crucible_hardware_manifest->len ||
+            item->vmstate_reservation_remaining == 0 ||
+            (i != 0 && ((CrucibleHardwarePending *)g_ptr_array_index(
+                pending, i - 1))->cpu->cpu_index >= cpu_index)) {
+            crucible_hardware_pending_free(item);
+            goto fail;
+        }
+        item->cpu = qemu_get_cpu(cpu_index);
+        if (!item->cpu) {
+            crucible_hardware_pending_free(item);
+            goto fail;
+        }
+        item->rule = qemu_crucible_fault_rule_vmstate_load(&reader);
+        if (!item->rule ||
+            qemu_crucible_fault_rule_command_kind(item->rule) !=
+                CRUCIBLE_FAULT_COMMAND_MEMORY_ECC_EVENT ||
+            qemu_crucible_fault_rule_operation(item->rule) !=
+                CRUCIBLE_NODE_FAULT_OPERATION_APPLY ||
+            !crucible_hardware_u64(
+                item->rule, CRUCIBLE_NODE_FAULT_FIELD_P2,
+                &rule_address) ||
+            !crucible_hardware_u64(
+                item->rule, CRUCIBLE_NODE_FAULT_FIELD_P3,
+                &rule_syndrome) ||
+            rule_address != item->address ||
+            rule_syndrome != item->ecc_syndrome ||
+            !crucible_hardware_vmstate_get_exception(
+                &reader, &item->exception) ||
+            !crucible_hardware_vmstate_get_cpu_state(
+                &reader, &item->before_cpu_state) ||
+            !crucible_hardware_vmstate_get_cpu_state(
+                &reader, &item->queued_cpu_state) ||
+            !crucible_hardware_vmstate_get_ghes_state(
+                &reader, &item->before_ghes_state) ||
+            !crucible_hardware_vmstate_get_ghes_state(
+                &reader, &item->queued_ghes_state) ||
+            crucible_hardware_target_cpu(item->rule) != item->cpu ||
+            crucible_hardware_ecc_row(
+                item->rule, &derived_row, &derived_exception,
+                &derived_visibility) != 0 ||
+            derived_row != item->row_index ||
+            !crucible_hardware_vmstate_exception_equal(
+                &derived_exception, &item->exception)) {
+            crucible_hardware_pending_free(item);
+            goto fail;
+        }
+        if (item->ghes_source_id !=
+            (g_array_index(
+                 crucible_hardware_manifest,
+                 struct qemu_plugin_crucible_fault_hardware_error_capability,
+                 item->row_index).corrected ?
+                 ACPI_HEST_SRC_ID_CORRECTED_POLL : ACPI_HEST_SRC_ID_SEA)) {
+            crucible_hardware_pending_free(item);
+            goto fail;
+        }
+        binding = &g_array_index(
+            crucible_hardware_bindings, CrucibleHardwareBinding,
+            item->row_index);
+        if (memcmp(item->id, binding->id, 32) != 0 ||
+            memcmp(item->bank, binding->bank, 32) != 0 ||
+            memcmp(item->channel, binding->channel, 32) != 0 ||
+            memcmp(item->rank, binding->rank, 32) != 0 ||
+            memcmp(item->firmware, binding->firmware, 32) != 0 ||
+            memcmp(item->state, binding->state, 32) != 0) {
+            crucible_hardware_pending_free(item);
+            goto fail;
+        }
+        snapshot_bank = item->exception.record ==
+                CPU_FAULT_EXCEPTION_X86_MACHINE_CHECK ?
+            item->exception.x86_machine_check.bank : 0;
+        if (!cpu_read_fault_hardware_error_state(
+                item->cpu, snapshot_bank, &current_cpu) ||
+            !crucible_hardware_vmstate_cpu_state_equal(
+                &current_cpu, &item->queued_cpu_state) ||
+            (item->queued_ghes_state.record_length != 0 &&
+             (!acpi_ghes_memory_error_state(
+                  item->ghes_source_id, &current_ghes) ||
+              !crucible_hardware_vmstate_ghes_state_equal(
+                  &current_ghes, &item->queued_ghes_state)))) {
+            crucible_hardware_pending_free(item);
+            goto fail;
+        }
+        qemu_crucible_fault_vmstate_count_reservations(
+            item->vmstate_reservation_remaining);
+        item->reservation = qemu_crucible_fault_event_reservation_restore(
+            item->vmstate_reservation_remaining);
+        if (!item->reservation) {
+            crucible_hardware_pending_free(item);
+            goto fail;
+        }
+        item->vmstate_reservation_remaining = 0;
+        g_ptr_array_add(pending, item);
+    }
+    if (!qemu_crucible_fault_vmstate_reader_finished(&reader)) {
+        goto fail;
+    }
+    qemu_crucible_fault_vmstate_count_deferred(pending->len);
+    state->pending = pending;
+    state->terminal = terminal;
+    *staged_out = state;
+    return 0;
+
+fail:
+    g_ptr_array_unref(pending);
+    g_free(state);
+    return -EINVAL;
+}
