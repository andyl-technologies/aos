+static bool crucible_memory_vmstate_get_bool(
+    QemuCrucibleFaultVmstateReader *reader, bool *value)
+{
+    uint8_t encoded;
+
+    if (!qemu_crucible_fault_vmstate_get_u8(reader, &encoded) ||
+        encoded > 1) {
+        return false;
+    }
+    *value = encoded;
+    return true;
+}
+
+static bool crucible_memory_vmstate_get_translation(
+    QemuCrucibleFaultVmstateReader *reader,
+    CrucibleNodeTranslation *translation)
+{
+    uint16_t requester_id;
+    uint8_t pid, space, secure, attrs_user, memory, debug, unspecified;
+    uint8_t readable, writable, executable, user, reserved;
+
+    if (!qemu_crucible_fault_vmstate_get_u64(
+            reader, &translation->virtual_page) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            reader, &translation->physical_page) ||
+        !qemu_crucible_fault_vmstate_get_u64(reader,
+                                              &translation->page_size) ||
+        !qemu_crucible_fault_vmstate_get_u32(
+            reader, &translation->covered_bytes) ||
+        !qemu_crucible_fault_vmstate_get_u16(reader, &requester_id) ||
+        !qemu_crucible_fault_vmstate_get_u8(reader, &pid) ||
+        !qemu_crucible_fault_vmstate_get_u8(reader, &space) ||
+        !qemu_crucible_fault_vmstate_get_u8(reader, &secure) ||
+        !qemu_crucible_fault_vmstate_get_u8(reader, &attrs_user) ||
+        !qemu_crucible_fault_vmstate_get_u8(reader, &memory) ||
+        !qemu_crucible_fault_vmstate_get_u8(reader, &debug) ||
+        !qemu_crucible_fault_vmstate_get_u8(reader, &unspecified) ||
+        !qemu_crucible_fault_vmstate_get_u8(reader, &readable) ||
+        !qemu_crucible_fault_vmstate_get_u8(reader, &writable) ||
+        !qemu_crucible_fault_vmstate_get_u8(reader, &executable) ||
+        !qemu_crucible_fault_vmstate_get_u8(reader, &user) ||
+        !qemu_crucible_fault_vmstate_get_u8(reader, &reserved) ||
+        translation->page_size == 0 || translation->covered_bytes == 0 ||
+        translation->covered_bytes > translation->page_size || space > 3 ||
+        secure > 1 || attrs_user > 1 || memory > 1 || debug > 1 ||
+        unspecified > 1 || readable > 1 || writable > 1 || executable > 1 ||
+        user > 1 || reserved != 0) {
+        return false;
+    }
+    translation->attrs.pid = pid;
+    translation->attrs.requester_id = requester_id;
+    translation->attrs.space = space;
+    translation->attrs.secure = secure;
+    translation->attrs.user = attrs_user;
+    translation->attrs.memory = memory;
+    translation->attrs.debug = debug;
+    translation->attrs.unspecified = unspecified;
+    translation->readable = readable;
+    translation->writable = writable;
+    translation->executable = executable;
+    translation->user = user;
+    return true;
+}
+
+static void crucible_memory_translation_encode(
+    const CrucibleNodeTranslation *translation, uint8_t encoded[48])
+{
+    memset(encoded, 0, 48);
+    stq_le_p(encoded, translation->virtual_page);
+    stq_le_p(encoded + 8, translation->physical_page);
+    stq_le_p(encoded + 16, translation->page_size);
+    stl_le_p(encoded + 24, translation->covered_bytes);
+    stw_le_p(encoded + 28, translation->attrs.requester_id);
+    encoded[30] = translation->attrs.pid;
+    encoded[31] = translation->attrs.space;
+    encoded[32] = translation->attrs.secure;
+    encoded[33] = translation->attrs.user;
+    encoded[34] = translation->attrs.memory;
+    encoded[35] = translation->attrs.debug;
+    encoded[36] = translation->attrs.unspecified;
+    encoded[40] = translation->readable;
+    encoded[41] = translation->writable;
+    encoded[42] = translation->executable;
+    encoded[43] = translation->user;
+}
+
+static bool crucible_memory_vmstate_translations_valid(
+    QemuCrucibleFaultRule *rule)
+{
+    g_autoptr(GChecksum) checksum = NULL;
+    uint8_t digest[32];
+    gsize digest_len = sizeof(digest);
+    uint64_t start, length, current, remaining;
+    uint32_t vcpu;
+    bool has_vcpu;
+
+    if (!node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_T2, &start) ||
+        !node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_T5, &length) ||
+        !node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_T3, &has_vcpu) ||
+        !node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_T4, &vcpu)) {
+        return false;
+    }
+    if (!has_vcpu) {
+        uint8_t zero[32] = { 0 };
+
+        return (!rule->translations || rule->translations->len == 0) &&
+               memcmp(rule->translation_hash, zero, sizeof(zero)) == 0;
+    }
+    if (!qemu_get_cpu(vcpu)) {
+        return false;
+    }
+    checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    g_checksum_update(checksum, (const uint8_t *)"CRUCNTX1", 8);
+    current = start;
+    remaining = length;
+    for (guint i = 0; rule->translations &&
+         i < rule->translations->len; i++) {
+        const CrucibleNodeTranslation *translation = &g_array_index(
+            rule->translations, CrucibleNodeTranslation, i);
+        uint8_t encoded[48];
+        uint64_t offset, physical;
+        uint64_t covered;
+
+        if (translation->page_size == 0) {
+            return false;
+        }
+        offset = current % translation->page_size;
+        if (current < offset ||
+            translation->virtual_page != current - offset ||
+            translation->physical_page > UINT64_MAX - offset) {
+            return false;
+        }
+        physical = translation->physical_page + offset;
+        covered = MIN(remaining, translation->page_size - offset);
+        if (translation->covered_bytes != covered || covered == 0 ||
+            !node_memory_gpa_is_ram(physical, covered) ||
+            current > UINT64_MAX - covered) {
+            return false;
+        }
+        crucible_memory_translation_encode(translation, encoded);
+        g_checksum_update(checksum, encoded, sizeof(encoded));
+        current += covered;
+        remaining -= covered;
+    }
+    if (remaining != 0) {
+        return false;
+    }
+    g_checksum_get_digest(checksum, digest, &digest_len);
+    return digest_len == sizeof(digest) &&
+           memcmp(digest, rule->translation_hash, sizeof(digest)) == 0;
+}
+
+static bool crucible_memory_vmstate_get_retry(
+    QemuCrucibleFaultVmstateReader *reader,
+    CrucibleMemoryVmstateRetry *retry)
+{
+    uint8_t has_instruction, streaming;
+    uint16_t reserved16;
+    uint32_t page_table_level, reserved32;
+
+    if (!qemu_crucible_fault_vmstate_get_u64(reader, &retry->key.address) ||
+        !qemu_crucible_fault_vmstate_get_u64(reader, &retry->key.length) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            reader, &retry->key.observed_icount) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            reader, &retry->key.instruction_pc) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            reader, &retry->key.page_table_target_vaddr) ||
+        !qemu_crucible_fault_vmstate_get_u32(
+            reader, &retry->key.access_class) ||
+        !qemu_crucible_fault_vmstate_get_u32(reader, &retry->key.actor) ||
+        !qemu_crucible_fault_vmstate_get_u32(
+            reader, &retry->key.instruction_ordinal) ||
+        !qemu_crucible_fault_vmstate_get_u32(reader, &page_table_level) ||
+        !qemu_crucible_fault_vmstate_get_u32(
+            reader, &retry->key.page_table_stage) ||
+        !qemu_crucible_fault_vmstate_get_u32(
+            reader, &retry->key.initiating_access_class) ||
+        !qemu_crucible_fault_vmstate_get_u8(reader, &has_instruction) ||
+        !qemu_crucible_fault_vmstate_get_u8(reader, &streaming) ||
+        !qemu_crucible_fault_vmstate_get_u16(reader, &reserved16) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            reader, &retry->state.last_access_sequence) ||
+        !qemu_crucible_fault_vmstate_get_u32(
+            reader, &retry->state.retry_ordinal) ||
+        !qemu_crucible_fault_vmstate_get_u32(reader, &reserved32) ||
+        has_instruction > 1 || streaming > 1 || reserved16 != 0 ||
+        reserved32 != 0 || retry->state.last_access_sequence == 0) {
+        return false;
+    }
+    retry->key.page_table_level = (int32_t)page_table_level;
+    retry->key.has_instruction = has_instruction;
+    retry->key.streaming = streaming;
+    return true;
+}
+
+static int crucible_memory_vmstate_prepare(const uint8_t *payload,
+                                           size_t payload_len,
+                                           void **staged_out)
+{
+    QemuCrucibleFaultVmstateReader reader = {
+        .data = payload,
+        .length = payload_len,
+    };
+    CrucibleMemoryVmstate *state = g_new0(CrucibleMemoryVmstate, 1);
+    g_autoptr(GHashTable) seen = g_hash_table_new(
+        g_direct_hash, g_direct_equal);
+    g_autoptr(GHashTable) ledger_values = g_hash_table_new_full(
+        g_str_hash, g_str_equal, g_free, g_free);
+    uint8_t magic[8];
+    uint32_t rule_count, retry_count;
+    int status = -EINVAL;
+
+    state->ledgers = g_array_new(
+        false, false, sizeof(CrucibleMemoryVmstateLedger));
+    state->retry_states = g_hash_table_new_full(
+        node_memory_retry_key_hash, node_memory_retry_key_equal,
+        g_free, g_free);
+    if (!qemu_crucible_fault_vmstate_get_bytes(&reader, magic, 8) ||
+        memcmp(magic, "CRUCMVS1", 8) != 0 ||
+        !qemu_crucible_fault_vmstate_get_u32(&reader, &rule_count) ||
+        !qemu_crucible_fault_vmstate_get_u32(&reader, &retry_count) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            &reader, &state->access_sequence) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            &reader, &state->retention_next_ns) ||
+        rule_count > CRUCIBLE_NODE_VMSTATE_MAX_RULES ||
+        retry_count > CRUCIBLE_NODE_MEMORY_RETRY_LIMIT) {
+        goto fail;
+    }
+    for (uint32_t i = 0; i < rule_count; i++) {
+        QemuCrucibleFaultRule *rule = crucible_memory_vmstate_get_rule_id(
+            &reader);
+        CrucibleMemoryVmstateLedger ledger;
+        uint8_t exposure, scheduled, stale, translation_error;
+        uint32_t cell_count, row_count, translation_count, reserved;
+
+        if (!rule || !crucible_memory_vmstate_rule(rule) ||
+            g_hash_table_contains(seen, rule) ||
+            !qemu_crucible_fault_vmstate_get_u64(
+                &reader, &rule->last_exposure_ns) ||
+            !qemu_crucible_fault_vmstate_get_u64(
+                &reader, &rule->retention_next_ns) ||
+            !qemu_crucible_fault_vmstate_get_u8(&reader, &exposure) ||
+            !qemu_crucible_fault_vmstate_get_u8(&reader, &scheduled) ||
+            !qemu_crucible_fault_vmstate_get_u8(&reader, &stale) ||
+            !qemu_crucible_fault_vmstate_get_u8(
+                &reader, &translation_error) ||
+            !qemu_crucible_fault_vmstate_get_u64(&reader,
+                                                  &ledger.ready_ns) ||
+            !qemu_crucible_fault_vmstate_get_u32(&reader, &cell_count) ||
+            !qemu_crucible_fault_vmstate_get_u32(&reader, &row_count) ||
+            !qemu_crucible_fault_vmstate_get_u32(
+                &reader, &translation_count) ||
+            !qemu_crucible_fault_vmstate_get_u32(&reader, &reserved) ||
+            !qemu_crucible_fault_vmstate_get_bytes(
+                &reader, rule->translation_hash, 32) || exposure > 1 ||
+            scheduled > 1 || stale > 1 || translation_error > 1 ||
+            reserved != 0 || cell_count > CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT ||
+            row_count > CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT ||
+            translation_count > CRUCIBLE_NODE_MEMORY_MATCH_LIMIT ||
+            (rule->command_kind != CRUCIBLE_FAULT_COMMAND_MEMORY_SERVICE &&
+             ledger.ready_ns != 0)) {
+            qemu_crucible_fault_rule_unref(rule);
+            goto fail;
+        }
+        if (rule->command_kind == CRUCIBLE_FAULT_COMMAND_MEMORY_SERVICE) {
+            g_autofree char *ledger_key = node_memory_service_ledger_key(rule);
+            uint64_t *existing = ledger_key ?
+                g_hash_table_lookup(ledger_values, ledger_key) : NULL;
+
+            if (!ledger_key || (existing && *existing != ledger.ready_ns)) {
+                qemu_crucible_fault_rule_unref(rule);
+                goto fail;
+            }
+            if (!existing) {
+                uint64_t *stored = g_new(uint64_t, 1);
+
+                *stored = ledger.ready_ns;
+                g_hash_table_insert(ledger_values,
+                                    g_steal_pointer(&ledger_key), stored);
+            }
+        }
+        g_hash_table_add(seen, rule);
+        rule->exposure_initialized = exposure;
+        rule->retention_scheduled = scheduled;
+        rule->translation_stale = stale;
+        rule->translation_error_reported = translation_error;
+        g_clear_pointer(&rule->retention_cells, g_hash_table_unref);
+        g_clear_pointer(&rule->row_counters, g_hash_table_unref);
+        g_clear_pointer(&rule->translations, g_array_unref);
+        if (cell_count != 0) {
+            rule->retention_cells = g_hash_table_new_full(
+                g_int64_hash, g_int64_equal, g_free, g_free);
+        }
+        uint64_t previous_offset = 0;
+        for (uint32_t cell_index = 0; cell_index < cell_count; cell_index++) {
+            uint64_t *offset = g_new(uint64_t, 1);
+            CrucibleRetentionCell *cell = g_new0(CrucibleRetentionCell, 1);
+
+            if (!qemu_crucible_fault_vmstate_get_u64(&reader, offset)) {
+                g_free(offset);
+                g_free(cell);
+                qemu_crucible_fault_rule_unref(rule);
+                goto fail;
+            }
+            for (size_t bit = 0; bit < G_N_ELEMENTS(cell->refresh_ns); bit++) {
+                if (!qemu_crucible_fault_vmstate_get_u64(
+                        &reader, &cell->refresh_ns[bit])) {
+                    g_free(offset);
+                    g_free(cell);
+                    qemu_crucible_fault_rule_unref(rule);
+                    goto fail;
+                }
+            }
+            if (!qemu_crucible_fault_vmstate_get_u8(
+                    &reader, &cell->decayed_mask) ||
+                (cell_index != 0 && *offset <= previous_offset)) {
+                g_free(offset);
+                g_free(cell);
+                qemu_crucible_fault_rule_unref(rule);
+                goto fail;
+            }
+            previous_offset = *offset;
+            g_hash_table_insert(rule->retention_cells, offset, cell);
+        }
+        if (row_count != 0) {
+            rule->row_counters = g_hash_table_new_full(
+                node_dram_coordinate_hash, node_dram_coordinate_equal,
+                g_free, g_free);
+        }
+        CrucibleMemoryVmstateRow previous_row = { 0 };
+        for (uint32_t row_index = 0; row_index < row_count; row_index++) {
+            CrucibleDramCoordinate *coordinate = g_new0(
+                CrucibleDramCoordinate, 1);
+            uint64_t *count = g_new(uint64_t, 1);
+
+            if (!qemu_crucible_fault_vmstate_get_u64(
+                    &reader, &coordinate->row) ||
+                !qemu_crucible_fault_vmstate_get_u16(
+                    &reader, &coordinate->channel) ||
+                !qemu_crucible_fault_vmstate_get_u16(
+                    &reader, &coordinate->rank) ||
+                !qemu_crucible_fault_vmstate_get_u16(
+                    &reader, &coordinate->bank) ||
+                !qemu_crucible_fault_vmstate_get_u16(
+                    &reader, &coordinate->reserved) ||
+                !qemu_crucible_fault_vmstate_get_u64(&reader, count) ||
+                coordinate->reserved != 0 ||
+                coordinate->channel >= CRUCIBLE_DRAM_CHANNELS ||
+                coordinate->rank >= CRUCIBLE_DRAM_RANKS ||
+                coordinate->bank >= CRUCIBLE_DRAM_BANKS || *count == 0) {
+                g_free(coordinate);
+                g_free(count);
+                qemu_crucible_fault_rule_unref(rule);
+                goto fail;
+            }
+            CrucibleMemoryVmstateRow current_row = {
+                .coordinate = *coordinate,
+            };
+            if (row_index != 0 && crucible_memory_vmstate_row_compare(
+                    &previous_row, &current_row) >= 0) {
+                g_free(coordinate);
+                g_free(count);
+                qemu_crucible_fault_rule_unref(rule);
+                goto fail;
+            }
+            previous_row = current_row;
+            g_hash_table_insert(rule->row_counters, coordinate, count);
+        }
+        if (translation_count != 0) {
+            rule->translations = g_array_sized_new(
+                false, false, sizeof(CrucibleNodeTranslation),
+                translation_count);
+        }
+        for (uint32_t translation_index = 0;
+             translation_index < translation_count; translation_index++) {
+            CrucibleNodeTranslation translation = { 0 };
+
+            if (!crucible_memory_vmstate_get_translation(
+                    &reader, &translation)) {
+                qemu_crucible_fault_rule_unref(rule);
+                goto fail;
+            }
+            g_array_append_val(rule->translations, translation);
+        }
+        if (!crucible_memory_vmstate_translations_valid(rule)) {
+            qemu_crucible_fault_rule_unref(rule);
+            goto fail;
+        }
+        ledger.rule = rule;
+        g_array_append_val(state->ledgers, ledger);
+    }
+    uint64_t expected_retention_next_ns = UINT64_MAX;
+    for (guint i = 0; i < state->ledgers->len; i++) {
+        const CrucibleMemoryVmstateLedger *ledger = &g_array_index(
+            state->ledgers, CrucibleMemoryVmstateLedger, i);
+        uint64_t start, length;
+        QDict *parameters;
+
+        if (node_memory_retention_rule(
+                ledger->rule, &start, &length, &parameters) &&
+            ledger->rule->retention_scheduled) {
+            expected_retention_next_ns = MIN(
+                expected_retention_next_ns,
+                ledger->rule->retention_next_ns);
+        }
+    }
+    if (state->retention_next_ns != expected_retention_next_ns) {
+        goto fail;
+    }
+    uint32_t expected_rule_count = 0;
+    for (guint i = 0; i < crucible_node_vmstate_prepared->rules->len; i++) {
+        QemuCrucibleFaultRule *rule = g_ptr_array_index(
+            crucible_node_vmstate_prepared->rules, i);
+
+        expected_rule_count += crucible_memory_vmstate_rule(rule);
+    }
+    if (g_hash_table_size(seen) != rule_count ||
+        expected_rule_count != rule_count) {
+        goto fail;
+    }
+    CrucibleMemoryVmstateRetry previous_retry = { 0 };
+    for (uint32_t i = 0; i < retry_count; i++) {
+        CrucibleMemoryVmstateRetry retry = { 0 };
+        CrucibleMemoryRetryKey *key;
+        CrucibleMemoryRetryState *retry_state;
+
+        if (!crucible_memory_vmstate_get_retry(&reader, &retry) ||
+            retry.state.last_access_sequence > state->access_sequence ||
+            (i != 0 && crucible_memory_vmstate_retry_compare(
+                &previous_retry, &retry) >= 0)) {
+            goto fail;
+        }
+        previous_retry = retry;
+        key = g_memdup2(&retry.key, sizeof(retry.key));
+        retry_state = g_memdup2(&retry.state, sizeof(retry.state));
+        g_hash_table_insert(state->retry_states, key, retry_state);
+    }
+    if (!qemu_crucible_fault_vmstate_reader_finished(&reader)) {
+        goto fail;
+    }
+    *staged_out = state;
+    return 0;
+
+fail:
+    crucible_memory_vmstate_free(state);
+    return status;
+}
+
+static void crucible_memory_vmstate_commit(void *opaque)
+{
+    CrucibleMemoryVmstate *state = opaque;
+
+    g_clear_pointer(&crucible_memory_retry_states, g_hash_table_unref);
+    crucible_memory_retry_states = g_steal_pointer(&state->retry_states);
+    crucible_memory_access_sequence = state->access_sequence;
+    crucible_memory_retention_next_ns = state->retention_next_ns;
+    g_clear_pointer(&crucible_memory_service_ledgers, g_hash_table_unref);
+    for (guint i = 0; i < state->ledgers->len; i++) {
+        CrucibleMemoryVmstateLedger *ledger = &g_array_index(
+            state->ledgers, CrucibleMemoryVmstateLedger, i);
+
+        g_assert(node_memory_service_ledger_acquire(ledger->rule));
+        if (ledger->rule->service_ledger) {
+            if (ledger->rule->service_ledger->references > 1) {
+                g_assert(ledger->rule->service_ledger->ready_ns ==
+                         ledger->ready_ns);
+            } else {
+                ledger->rule->service_ledger->ready_ns = ledger->ready_ns;
+            }
+        }
+    }
+    node_memory_index_rebuild();
+    node_memory_retention_deadline_recompute();
+    crucible_memory_vmstate_free(state);
+}
+
+static const QemuCrucibleFaultVmstateSection
+crucible_memory_vmstate_section = {
+    .name = "memory",
+    .version = 1,
+    .save = crucible_memory_vmstate_save,
+    .prepare = crucible_memory_vmstate_prepare,
+    .commit = crucible_memory_vmstate_commit,
+    .free_staged = crucible_memory_vmstate_free,
+};
+
