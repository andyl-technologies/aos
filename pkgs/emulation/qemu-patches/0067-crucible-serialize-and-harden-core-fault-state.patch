+static void crucible_hardware_vmstate_put_exception(
+    GByteArray *payload, const CPUFaultException *exception)
+{
+    qemu_crucible_fault_vmstate_put_u32(payload, exception->architecture);
+    qemu_crucible_fault_vmstate_put_u32(payload, exception->record);
+    qemu_crucible_fault_vmstate_put_u32(payload, exception->vector);
+    qemu_crucible_fault_vmstate_put_u64(payload, exception->syndrome);
+    qemu_crucible_fault_vmstate_put_u64(payload, exception->fault_address);
+    qemu_crucible_fault_vmstate_put_u8(payload, exception->has_fault_address);
+    qemu_crucible_fault_vmstate_put_u8(payload, exception->before_instruction);
+    qemu_crucible_fault_vmstate_put_u8(payload, exception->maskable);
+    qemu_crucible_fault_vmstate_put_u8(payload, 0);
+    qemu_crucible_fault_vmstate_put_u32(
+        payload, exception->x86_machine_check.bank);
+    qemu_crucible_fault_vmstate_put_u64(
+        payload, exception->x86_machine_check.status);
+    qemu_crucible_fault_vmstate_put_u64(
+        payload, exception->x86_machine_check.global_status);
+    qemu_crucible_fault_vmstate_put_u64(
+        payload, exception->x86_machine_check.address);
+    qemu_crucible_fault_vmstate_put_u64(
+        payload, exception->x86_machine_check.misc);
+    qemu_crucible_fault_vmstate_put_u8(
+        payload, exception->x86_machine_check.corrected);
+    qemu_crucible_fault_vmstate_put_u8(
+        payload, exception->x86_machine_check.has_address);
+    qemu_crucible_fault_vmstate_put_u8(
+        payload, exception->x86_machine_check.has_misc);
+    qemu_crucible_fault_vmstate_put_u8(payload, 0);
+    qemu_crucible_fault_vmstate_put_u64(
+        payload, exception->aarch64_ras.esr);
+    qemu_crucible_fault_vmstate_put_u64(
+        payload, exception->aarch64_ras.far);
+    qemu_crucible_fault_vmstate_put_u64(
+        payload, exception->aarch64_ras.disr);
+    qemu_crucible_fault_vmstate_put_u8(
+        payload, exception->aarch64_ras.asynchronous);
+    qemu_crucible_fault_vmstate_put_u8(
+        payload, exception->aarch64_ras.corrected);
+    qemu_crucible_fault_vmstate_put_u8(
+        payload, exception->aarch64_ras.fatal);
+    qemu_crucible_fault_vmstate_put_u8(
+        payload, exception->aarch64_ras.has_far);
+    qemu_crucible_fault_vmstate_put_u8(
+        payload, exception->aarch64_ras.has_disr);
+    qemu_crucible_fault_vmstate_put_u8(payload, 0);
+    qemu_crucible_fault_vmstate_put_u16(payload, 0);
+}
+
+static bool crucible_hardware_vmstate_get_bool(
+    QemuCrucibleFaultVmstateReader *reader, bool *value)
+{
+    uint8_t encoded;
+
+    if (!qemu_crucible_fault_vmstate_get_u8(reader, &encoded) ||
+        encoded > 1) {
+        return false;
+    }
+    *value = encoded;
+    return true;
+}
+
+static bool crucible_hardware_vmstate_get_exception(
+    QemuCrucibleFaultVmstateReader *reader, CPUFaultException *exception)
+{
+    uint32_t architecture, record;
+    uint8_t reserved8a, reserved8b, reserved8c;
+    uint16_t reserved16;
+
+    if (!qemu_crucible_fault_vmstate_get_u32(reader, &architecture) ||
+        !qemu_crucible_fault_vmstate_get_u32(reader, &record) ||
+        !qemu_crucible_fault_vmstate_get_u32(reader, &exception->vector) ||
+        !qemu_crucible_fault_vmstate_get_u64(reader, &exception->syndrome) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            reader, &exception->fault_address) ||
+        !crucible_hardware_vmstate_get_bool(
+            reader, &exception->has_fault_address) ||
+        !crucible_hardware_vmstate_get_bool(
+            reader, &exception->before_instruction) ||
+        !crucible_hardware_vmstate_get_bool(reader, &exception->maskable) ||
+        !qemu_crucible_fault_vmstate_get_u8(reader, &reserved8a) ||
+        !qemu_crucible_fault_vmstate_get_u32(
+            reader, &exception->x86_machine_check.bank) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            reader, &exception->x86_machine_check.status) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            reader, &exception->x86_machine_check.global_status) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            reader, &exception->x86_machine_check.address) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            reader, &exception->x86_machine_check.misc) ||
+        !crucible_hardware_vmstate_get_bool(
+            reader, &exception->x86_machine_check.corrected) ||
+        !crucible_hardware_vmstate_get_bool(
+            reader, &exception->x86_machine_check.has_address) ||
+        !crucible_hardware_vmstate_get_bool(
+            reader, &exception->x86_machine_check.has_misc) ||
+        !qemu_crucible_fault_vmstate_get_u8(reader, &reserved8b) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            reader, &exception->aarch64_ras.esr) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            reader, &exception->aarch64_ras.far) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            reader, &exception->aarch64_ras.disr) ||
+        !crucible_hardware_vmstate_get_bool(
+            reader, &exception->aarch64_ras.asynchronous) ||
+        !crucible_hardware_vmstate_get_bool(
+            reader, &exception->aarch64_ras.corrected) ||
+        !crucible_hardware_vmstate_get_bool(
+            reader, &exception->aarch64_ras.fatal) ||
+        !crucible_hardware_vmstate_get_bool(
+            reader, &exception->aarch64_ras.has_far) ||
+        !crucible_hardware_vmstate_get_bool(
+            reader, &exception->aarch64_ras.has_disr) ||
+        !qemu_crucible_fault_vmstate_get_u8(reader, &reserved8c) ||
+        !qemu_crucible_fault_vmstate_get_u16(reader, &reserved16) ||
+        reserved8a != 0 || reserved8b != 0 || reserved8c != 0 ||
+        reserved16 != 0 ||
+        architecture < CPU_FAULT_EXCEPTION_X86_64 ||
+        architecture > CPU_FAULT_EXCEPTION_AARCH64 ||
+        record < CPU_FAULT_EXCEPTION_ARCHITECTURE_DEFAULT ||
+        record > CPU_FAULT_EXCEPTION_AARCH64_RAS) {
+        return false;
+    }
+    exception->architecture = architecture;
+    exception->record = record;
+    return true;
+}
+
+static void crucible_hardware_vmstate_put_cpu_state(
+    GByteArray *payload, const CPUFaultHardwareErrorState *state)
+{
+    const uint32_t words[] = {
+        state->architecture, state->record, state->bank, state->flags,
+        state->interrupt_request,
+    };
+    const uint64_t values[] = {
+        state->bank_control, state->bank_status, state->bank_address,
+        state->bank_misc, state->global_status, state->syndrome,
+        state->fault_address, state->esr, state->far, state->disr,
+    };
+
+    for (size_t i = 0; i < G_N_ELEMENTS(words); i++) {
+        qemu_crucible_fault_vmstate_put_u32(payload, words[i]);
+    }
+    for (size_t i = 0; i < G_N_ELEMENTS(values); i++) {
+        qemu_crucible_fault_vmstate_put_u64(payload, values[i]);
+    }
+}
+
+static bool crucible_hardware_vmstate_get_cpu_state(
+    QemuCrucibleFaultVmstateReader *reader,
+    CPUFaultHardwareErrorState *state)
+{
+    return qemu_crucible_fault_vmstate_get_u32(reader, &state->architecture) &&
+        qemu_crucible_fault_vmstate_get_u32(reader, &state->record) &&
+        qemu_crucible_fault_vmstate_get_u32(reader, &state->bank) &&
+        qemu_crucible_fault_vmstate_get_u32(reader, &state->flags) &&
+        qemu_crucible_fault_vmstate_get_u32(
+            reader, &state->interrupt_request) &&
+        qemu_crucible_fault_vmstate_get_u64(reader, &state->bank_control) &&
+        qemu_crucible_fault_vmstate_get_u64(reader, &state->bank_status) &&
+        qemu_crucible_fault_vmstate_get_u64(reader, &state->bank_address) &&
+        qemu_crucible_fault_vmstate_get_u64(reader, &state->bank_misc) &&
+        qemu_crucible_fault_vmstate_get_u64(reader, &state->global_status) &&
+        qemu_crucible_fault_vmstate_get_u64(reader, &state->syndrome) &&
+        qemu_crucible_fault_vmstate_get_u64(reader, &state->fault_address) &&
+        qemu_crucible_fault_vmstate_get_u64(reader, &state->esr) &&
+        qemu_crucible_fault_vmstate_get_u64(reader, &state->far) &&
+        qemu_crucible_fault_vmstate_get_u64(reader, &state->disr);
+}
+
+static bool crucible_hardware_vmstate_cpu_state_equal(
+    const CPUFaultHardwareErrorState *a,
+    const CPUFaultHardwareErrorState *b)
+{
+    return a->architecture == b->architecture && a->record == b->record &&
+        a->bank == b->bank && a->flags == b->flags &&
+        a->interrupt_request == b->interrupt_request &&
+        a->bank_control == b->bank_control &&
+        a->bank_status == b->bank_status &&
+        a->bank_address == b->bank_address &&
+        a->bank_misc == b->bank_misc &&
+        a->global_status == b->global_status &&
+        a->syndrome == b->syndrome &&
+        a->fault_address == b->fault_address && a->esr == b->esr &&
+        a->far == b->far && a->disr == b->disr;
+}
+
+static void crucible_hardware_vmstate_put_ghes_state(
+    GByteArray *payload, const AcpiGhesMemoryErrorState *state)
+{
+    qemu_crucible_fault_vmstate_put_u64(payload, state->read_ack);
+    qemu_crucible_fault_vmstate_put_u32(payload, state->record_length);
+    qemu_crucible_fault_vmstate_put_bytes(
+        payload, state->record, sizeof(state->record));
+}
+
+static bool crucible_hardware_vmstate_get_ghes_state(
+    QemuCrucibleFaultVmstateReader *reader,
+    AcpiGhesMemoryErrorState *state)
+{
+    return qemu_crucible_fault_vmstate_get_u64(reader, &state->read_ack) &&
+        qemu_crucible_fault_vmstate_get_u32(reader, &state->record_length) &&
+        state->record_length <= sizeof(state->record) &&
+        qemu_crucible_fault_vmstate_get_bytes(
+            reader, state->record, sizeof(state->record));
+}
+
+static bool crucible_hardware_vmstate_ghes_state_equal(
+    const AcpiGhesMemoryErrorState *a,
+    const AcpiGhesMemoryErrorState *b)
+{
+    return a->read_ack == b->read_ack &&
+        a->record_length == b->record_length &&
+        memcmp(a->record, b->record, sizeof(a->record)) == 0;
+}
+
+static bool crucible_hardware_vmstate_identity(uint8_t identity[32])
+{
+    g_autoptr(GByteArray) encoded = g_byte_array_new();
+
+    if (!crucible_hardware_manifest_init() ||
+        !crucible_hardware_bindings_sealed ||
+        crucible_hardware_manifest->len != crucible_hardware_bindings->len) {
+        return false;
+    }
+    qemu_crucible_fault_vmstate_put_bytes(encoded, "CRUCHMI1", 8);
+    qemu_crucible_fault_vmstate_put_u16(
+        encoded, crucible_hardware_architecture);
+    qemu_crucible_fault_vmstate_put_u16(encoded, 0);
+    qemu_crucible_fault_vmstate_put_u32(
+        encoded, crucible_hardware_manifest->len);
+    qemu_crucible_fault_vmstate_put_bytes(
+        encoded, crucible_hardware_manifest_sha256, 32);
+    for (guint i = 0; i < crucible_hardware_bindings->len; i++) {
+        const struct qemu_plugin_crucible_fault_hardware_error_capability *row =
+            &g_array_index(
+                crucible_hardware_manifest,
+                struct qemu_plugin_crucible_fault_hardware_error_capability,
+                i);
+        const CrucibleHardwareBinding *binding = &g_array_index(
+            crucible_hardware_bindings, CrucibleHardwareBinding, i);
+        const char *strings[] = {
+            row->id, row->bank, row->channel, row->rank,
+            row->firmware, row->state,
+        };
+
+        qemu_crucible_fault_vmstate_put_u16(encoded, row->record_kind);
+        qemu_crucible_fault_vmstate_put_u16(encoded, row->error_class);
+        qemu_crucible_fault_vmstate_put_u16(encoded, row->mechanism);
+        qemu_crucible_fault_vmstate_put_u16(encoded, row->visibility_mask);
+        qemu_crucible_fault_vmstate_put_u32(encoded, row->bank_number);
+        qemu_crucible_fault_vmstate_put_u32(encoded, row->bank_count);
+        qemu_crucible_fault_vmstate_put_u32(encoded, row->vector);
+        qemu_crucible_fault_vmstate_put_u32(encoded, row->reserved0);
+        qemu_crucible_fault_vmstate_put_u64(encoded, row->status_required);
+        qemu_crucible_fault_vmstate_put_u64(encoded, row->status_allowed);
+        qemu_crucible_fault_vmstate_put_u64(encoded, row->syndrome_required);
+        qemu_crucible_fault_vmstate_put_u64(encoded, row->syndrome_allowed);
+        qemu_crucible_fault_vmstate_put_u64(encoded, row->model_phase_mask);
+        qemu_crucible_fault_vmstate_put_u16(encoded, row->privilege_mask);
+        qemu_crucible_fault_vmstate_put_u8(encoded, row->corrected);
+        qemu_crucible_fault_vmstate_put_u8(encoded, row->maskable);
+        qemu_crucible_fault_vmstate_put_u8(encoded, row->vmstate);
+        qemu_crucible_fault_vmstate_put_u8(encoded, row->reserved1);
+        qemu_crucible_fault_vmstate_put_u16(encoded, 0);
+        for (size_t string = 0; string < G_N_ELEMENTS(strings); string++) {
+            size_t length = strlen(strings[string]);
+
+            if (length > UINT16_MAX) {
+                return false;
+            }
+            qemu_crucible_fault_vmstate_put_u16(encoded, length);
+            qemu_crucible_fault_vmstate_put_bytes(
+                encoded, strings[string], length);
+        }
+        qemu_crucible_fault_vmstate_put_bytes(encoded, binding->id, 32);
+        qemu_crucible_fault_vmstate_put_bytes(encoded, binding->bank, 32);
+        qemu_crucible_fault_vmstate_put_bytes(encoded, binding->channel, 32);
+        qemu_crucible_fault_vmstate_put_bytes(encoded, binding->rank, 32);
+        qemu_crucible_fault_vmstate_put_bytes(encoded, binding->firmware, 32);
+        qemu_crucible_fault_vmstate_put_bytes(encoded, binding->state, 32);
+    }
+    qemu_plugin_crucible_sha256_bytes(
+        encoded->data, encoded->len, identity);
+    return true;
+}
+
+static gint crucible_hardware_vmstate_pending_compare(
+    gconstpointer left, gconstpointer right)
+{
+    const CrucibleHardwarePending *a = *(CrucibleHardwarePending *const *)left;
+    const CrucibleHardwarePending *b = *(CrucibleHardwarePending *const *)right;
+
+    return (a->cpu->cpu_index > b->cpu->cpu_index) -
+           (a->cpu->cpu_index < b->cpu->cpu_index);
+}
+
+static bool crucible_hardware_vmstate_exception_equal(
+    const CPUFaultException *a, const CPUFaultException *b)
+{
+    return a->architecture == b->architecture && a->record == b->record &&
+        a->vector == b->vector && a->syndrome == b->syndrome &&
+        a->fault_address == b->fault_address &&
+        a->has_fault_address == b->has_fault_address &&
+        a->before_instruction == b->before_instruction &&
+        a->maskable == b->maskable &&
+        a->x86_machine_check.bank == b->x86_machine_check.bank &&
+        a->x86_machine_check.status == b->x86_machine_check.status &&
+        a->x86_machine_check.global_status ==
+            b->x86_machine_check.global_status &&
+        a->x86_machine_check.address == b->x86_machine_check.address &&
