+static void crucible_interrupt_vmstate_put_event(
+    GByteArray *payload, const QemuCrucibleInterruptEvent *event)
+{
+    qemu_crucible_fault_vmstate_put_u16(payload, event->family);
+    qemu_crucible_fault_vmstate_put_u16(payload, event->trigger);
+    qemu_crucible_fault_vmstate_put_u16(payload, event->polarity);
+    qemu_crucible_fault_vmstate_put_u16(payload, event->model_phase);
+    qemu_crucible_fault_vmstate_put_u32(payload, event->target_vcpu);
+    qemu_crucible_fault_vmstate_put_u32(payload, event->vector);
+    qemu_crucible_fault_vmstate_put_u32(payload, event->controller_source);
+    qemu_crucible_fault_vmstate_put_u16(payload, event->priority);
+    qemu_crucible_fault_vmstate_put_u16(payload, event->disposition);
+    qemu_crucible_fault_vmstate_put_u16(payload, event->release_phase);
+    qemu_crucible_fault_vmstate_put_u8(payload, event->retain_pending);
+    qemu_crucible_fault_vmstate_put_u8(payload, 0);
+    qemu_crucible_fault_vmstate_put_u64(payload, event->source_sequence);
+    qemu_crucible_fault_vmstate_put_u64(payload, event->routing_generation);
+    qemu_crucible_fault_vmstate_put_u32(payload, event->duplicate_ordinal);
+    qemu_crucible_fault_vmstate_put_u32(payload, 0);
+}
+
+static bool crucible_interrupt_vmstate_get_event(
+    QemuCrucibleFaultVmstateReader *reader,
+    QemuCrucibleInterruptEvent *event)
+{
+    uint8_t retain_pending, reserved8;
+    uint32_t reserved32;
+
+    return qemu_crucible_fault_vmstate_get_u16(reader, &event->family) &&
+        qemu_crucible_fault_vmstate_get_u16(reader, &event->trigger) &&
+        qemu_crucible_fault_vmstate_get_u16(reader, &event->polarity) &&
+        qemu_crucible_fault_vmstate_get_u16(reader, &event->model_phase) &&
+        qemu_crucible_fault_vmstate_get_u32(reader, &event->target_vcpu) &&
+        qemu_crucible_fault_vmstate_get_u32(reader, &event->vector) &&
+        qemu_crucible_fault_vmstate_get_u32(
+            reader, &event->controller_source) &&
+        qemu_crucible_fault_vmstate_get_u16(reader, &event->priority) &&
+        qemu_crucible_fault_vmstate_get_u16(reader, &event->disposition) &&
+        qemu_crucible_fault_vmstate_get_u16(reader, &event->release_phase) &&
+        qemu_crucible_fault_vmstate_get_u8(reader, &retain_pending) &&
+        qemu_crucible_fault_vmstate_get_u8(reader, &reserved8) &&
+        qemu_crucible_fault_vmstate_get_u64(
+            reader, &event->source_sequence) &&
+        qemu_crucible_fault_vmstate_get_u64(
+            reader, &event->routing_generation) &&
+        qemu_crucible_fault_vmstate_get_u32(
+            reader, &event->duplicate_ordinal) &&
+        qemu_crucible_fault_vmstate_get_u32(reader, &reserved32) &&
+        retain_pending <= 1 && reserved8 == 0 && reserved32 == 0 &&
+        (event->retain_pending = retain_pending, true);
+}
+
+static bool crucible_interrupt_vmstate_event_valid(
+    const QemuCrucibleInterruptEvent *event, guint *row_index_out)
+{
+    for (guint i = 0; i < crucible_interrupt_manifest->len; i++) {
+        const CrucibleInterruptCapability *row = &g_array_index(
+            crucible_interrupt_manifest, CrucibleInterruptCapability, i);
+
+        if (row->family == event->family &&
+            row->trigger == event->trigger &&
+            row->polarity == event->polarity &&
+            event->vector >= row->vector_start &&
+            event->vector <= row->replacement_vector_end &&
+            crucible_interrupt_target_allowed(row, event->target_vcpu) &&
+            event->model_phase != 0 && event->model_phase <= 64 &&
+            (row->model_phase_mask &
+             (1ULL << (event->model_phase - 1))) != 0 &&
+            event->release_phase <= 64 && event->disposition <= 4) {
+            if (row_index_out) {
+                *row_index_out = i;
+            }
+            return true;
+        }
+    }
+    return false;
+}
