+} CrucibleMemoryVmstate;
+
+typedef struct CrucibleMemoryVmstateRetention {
+    uint64_t offset;
+    CrucibleRetentionCell cell;
+} CrucibleMemoryVmstateRetention;
+
+typedef struct CrucibleMemoryVmstateRow {
+    CrucibleDramCoordinate coordinate;
+    uint64_t count;
+} CrucibleMemoryVmstateRow;
