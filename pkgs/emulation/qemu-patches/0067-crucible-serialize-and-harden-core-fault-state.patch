+static void crucible_node_vmstate_put_event(
+    GByteArray *payload, const CrucibleNodeEvent *queued)
+{
+    const struct qemu_plugin_crucible_fault_event *event = &queued->event;
+
+    qemu_crucible_fault_vmstate_put_u16(payload, event->command_kind);
+    qemu_crucible_fault_vmstate_put_u16(payload, event->outcome);
+    qemu_crucible_fault_vmstate_put_u16(payload, event->model_phase);
+    qemu_crucible_fault_vmstate_put_u16(payload, event->target_kind);
+    qemu_crucible_fault_vmstate_put_u32(payload, event->reserved);
+    qemu_crucible_fault_vmstate_put_u64(payload, event->event_sequence);
+    qemu_crucible_fault_vmstate_put_u64(payload,
+                                        event->rule_command_sequence);
+    qemu_crucible_fault_vmstate_put_u64(payload, event->observed_icount);
+    qemu_crucible_fault_vmstate_put_u64(payload, event->generation);
+    qemu_crucible_fault_vmstate_put_bytes(payload, event->binding_hash, 32);
+    qemu_crucible_fault_vmstate_put_bytes(payload, event->opportunity_hash,
+                                          32);
+    qemu_crucible_fault_vmstate_put_bytes(payload, event->action_hash, 32);
+    qemu_crucible_fault_vmstate_put_bytes(payload, event->target_hash, 32);
+    qemu_crucible_fault_vmstate_put_bytes(payload, event->before_hash, 32);
+    qemu_crucible_fault_vmstate_put_bytes(payload, event->after_hash, 32);
+    qemu_crucible_fault_vmstate_put_u32(payload, queued->payload_length);
+    qemu_crucible_fault_vmstate_put_bytes(
+        payload, queued->payload ? queued->payload->data :
+                                   queued->inline_payload,
+        queued->payload_length);
+}
+
+static bool crucible_node_vmstate_get_event(
+    QemuCrucibleFaultVmstateReader *reader, CrucibleNodeEvent *queued)
+{
+    struct qemu_plugin_crucible_fault_event *event = &queued->event;
+    QemuCrucibleFaultRule event_rule = { 0 };
+    const NodeSchemaField *schema;
+    size_t schema_count;
+    const uint8_t *evidence;
+    uint32_t evidence_len;
+
+    if (!qemu_crucible_fault_vmstate_get_u16(reader, &event->command_kind) ||
+        !qemu_crucible_fault_vmstate_get_u16(reader, &event->outcome) ||
+        !qemu_crucible_fault_vmstate_get_u16(reader, &event->model_phase) ||
+        !qemu_crucible_fault_vmstate_get_u16(reader, &event->target_kind) ||
+        !qemu_crucible_fault_vmstate_get_u32(reader, &event->reserved) ||
+        !qemu_crucible_fault_vmstate_get_u64(reader,
+                                              &event->event_sequence) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            reader, &event->rule_command_sequence) ||
+        !qemu_crucible_fault_vmstate_get_u64(reader,
+                                              &event->observed_icount) ||
+        !qemu_crucible_fault_vmstate_get_u64(reader, &event->generation) ||
+        !qemu_crucible_fault_vmstate_get_bytes(reader,
+                                                event->binding_hash, 32) ||
+        !qemu_crucible_fault_vmstate_get_bytes(
+            reader, event->opportunity_hash, 32) ||
+        !qemu_crucible_fault_vmstate_get_bytes(reader,
+                                                event->action_hash, 32) ||
+        !qemu_crucible_fault_vmstate_get_bytes(reader,
+                                                event->target_hash, 32) ||
+        !qemu_crucible_fault_vmstate_get_bytes(reader,
+                                                event->before_hash, 32) ||
+        !qemu_crucible_fault_vmstate_get_bytes(reader,
+                                                event->after_hash, 32) ||
+        !qemu_crucible_fault_vmstate_get_u32(reader, &evidence_len) ||
+        evidence_len > CRUCIBLE_FAULT_HARD_PAYLOAD_BYTES ||
+        !qemu_crucible_fault_vmstate_get_view(reader, &evidence,
+                                               evidence_len) ||
+        event->reserved != 0 || event->event_sequence == 0 ||
+        event->rule_command_sequence == 0 || event->generation == 0 ||
+        event->outcome < CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED ||
+        event->outcome > CRUCIBLE_FAULT_EVENT_OUTCOME_RECOVERED ||
+        event->model_phase < CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY ||
+        event->model_phase > CRUCIBLE_FAULT_PHASE_DEVICE ||
+        !node_schema_for(event->command_kind, &schema, &schema_count) ||
+        !node_target_schema_for(event->target_kind,
+                                &schema, &schema_count)) {
+        return false;
+    }
+    event_rule.command_kind = event->command_kind;
+    event_rule.target_kind = event->target_kind;
+    if (!node_target_pair_valid(&event_rule)) {
+        return false;
+    }
+    queued->payload_length = evidence_len;
+    if (evidence_len <= sizeof(queued->inline_payload)) {
+        memcpy(queued->inline_payload, evidence, evidence_len);
+    } else {
+        queued->payload = g_byte_array_sized_new(evidence_len);
+        g_byte_array_append(queued->payload, evidence, evidence_len);
+    }
+    return true;
+}
+
+void qemu_crucible_fault_rule_vmstate_save(
+    GByteArray *payload, const QemuCrucibleFaultRule *rule)
+{
+    qemu_crucible_fault_vmstate_put_u16(payload, rule->command_phase);
+    qemu_crucible_fault_vmstate_put_u16(payload, 0);
+    qemu_crucible_fault_vmstate_put_u32(payload, rule->semantic_version);
+    qemu_crucible_fault_vmstate_put_u64(payload, rule->command_sequence);
+    qemu_crucible_fault_vmstate_put_u64(payload, rule->opportunity_count);
+    qemu_crucible_fault_vmstate_put_u64(payload, rule->applied_count);
+    qemu_crucible_fault_vmstate_put_bytes(payload, rule->binding_hash, 32);
+    qemu_crucible_fault_vmstate_put_bytes(payload, rule->target_node_hash,
+                                          32);
+    qemu_crucible_fault_vmstate_put_u32(payload, rule->payload_len);
+    qemu_crucible_fault_vmstate_put_bytes(payload, rule->payload,
+                                          rule->payload_len);
+}
+
+QemuCrucibleFaultRule *qemu_crucible_fault_rule_vmstate_load(
+    QemuCrucibleFaultVmstateReader *reader)
+{
+    struct qemu_plugin_crucible_fault_command command = { 0 };
+    QemuCrucibleFaultRule *rule = g_new0(QemuCrucibleFaultRule, 1);
+    const uint8_t *rule_payload;
+    uint16_t reserved;
+    uint32_t rule_payload_len;
+
+    if (!qemu_crucible_fault_vmstate_get_u16(reader, &command.phase) ||
+        !qemu_crucible_fault_vmstate_get_u16(reader, &reserved) ||
+        !qemu_crucible_fault_vmstate_get_u32(
+            reader, &command.semantic_version) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            reader, &command.command_sequence) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            reader, &rule->opportunity_count) ||
+        !qemu_crucible_fault_vmstate_get_u64(reader,
+                                              &rule->applied_count) ||
+        !qemu_crucible_fault_vmstate_get_bytes(reader,
+                                                command.binding_hash, 32) ||
+        !qemu_crucible_fault_vmstate_get_bytes(
+            reader, command.target_node_hash, 32) ||
+        !qemu_crucible_fault_vmstate_get_u32(reader, &rule_payload_len) ||
+        reserved != 0 ||
+        rule->opportunity_count == UINT64_MAX ||
+        rule->applied_count > rule->opportunity_count ||
+        rule_payload_len < CRUCIBLE_NODE_FAULT_PAYLOAD_HEADER_V1_BYTES ||
+        rule_payload_len > CRUCIBLE_FAULT_HARD_PAYLOAD_BYTES ||
+        !qemu_crucible_fault_vmstate_get_view(
+            reader, &rule_payload, rule_payload_len)) {
+        g_free(rule);
+        return NULL;
+    }
+    command.command_kind = node_get_u16(
+        rule_payload + CRUCIBLE_NODE_FAULT_PAYLOAD_COMMAND_KIND_OFFSET);
+    if (node_parse(&command, rule_payload, rule_payload_len, rule) != 0) {
+        node_rule_clear(rule);
+        g_free(rule);
+        return NULL;
+    }
+    rule->references = 1;
+    return rule;
+}
+
+static int crucible_node_vmstate_save(GByteArray *payload)
+{
+    CrucibleNodeEvent *event;
+
+    node_rules_ensure();
+    node_events_ensure();
+    if (crucible_node_rules->len > CRUCIBLE_NODE_VMSTATE_MAX_RULES ||
+        crucible_node_event_count > CRUCIBLE_NODE_EVENT_CAPACITY - 1 ||
+        crucible_node_event_reserved > UINT32_MAX ||
+        crucible_node_event_count + crucible_node_event_reserved >
+            CRUCIBLE_NODE_EVENT_CAPACITY - 1) {
+        return -E2BIG;
+    }
+    qemu_crucible_fault_vmstate_put_bytes(payload,
+                                          CRUCIBLE_NODE_VMSTATE_MAGIC, 8);
+    qemu_crucible_fault_vmstate_put_u32(payload, crucible_node_rules->len);
+    qemu_crucible_fault_vmstate_put_u32(payload,
+                                        crucible_node_event_count);
+    qemu_crucible_fault_vmstate_put_u32(payload,
+                                        crucible_node_event_reserved);
+    qemu_crucible_fault_vmstate_put_u16(
+        payload, crucible_node_terminal_resource_kind);
+    qemu_crucible_fault_vmstate_put_u8(payload,
+                                       crucible_node_event_terminal);
+    qemu_crucible_fault_vmstate_put_u8(payload,
+                                       crucible_node_event_force_terminal);
+    qemu_crucible_fault_vmstate_put_u64(payload,
+                                        crucible_node_event_sequence);
+    qemu_crucible_fault_vmstate_put_u64(
+        payload, crucible_node_event_sequence_reserved);
+    qemu_crucible_fault_vmstate_put_u64(
+        payload, crucible_node_terminal_current);
+    qemu_crucible_fault_vmstate_put_u64(
+        payload, crucible_node_terminal_requested);
+    qemu_crucible_fault_vmstate_put_u64(
+        payload, crucible_node_terminal_configured);
+    qemu_crucible_fault_vmstate_put_u64(payload,
+                                        crucible_node_terminal_hard);
+    for (guint i = 0; i < crucible_node_rules->len; i++) {
+        QemuCrucibleFaultRule *rule = g_ptr_array_index(
+            crucible_node_rules, i);
+
+        qemu_crucible_fault_rule_vmstate_save(payload, rule);
+    }
+    QTAILQ_FOREACH(event, &crucible_node_events, link) {
+        crucible_node_vmstate_put_event(payload, event);
+    }
+    return 0;
+}
+
+static int crucible_node_vmstate_prepare(const uint8_t *payload,
+                                         size_t payload_len,
+                                         void **staged_out)
+{
+    QemuCrucibleFaultVmstateReader reader = {
+        .data = payload,
+        .length = payload_len,
+    };
+    CrucibleNodeVmstate *state = g_new0(CrucibleNodeVmstate, 1);
+    uint8_t magic[8], terminal, force_terminal;
+    uint32_t rule_count, event_count;
+    int status = -EINVAL;
+
+    state->rules = g_ptr_array_new_with_free_func(
+        (GDestroyNotify)node_rule_unref);
+    state->events = g_ptr_array_new_with_free_func(
+        crucible_node_vmstate_event_free);
+    if (!qemu_crucible_fault_vmstate_get_bytes(&reader, magic,
+                                                sizeof(magic)) ||
+        memcmp(magic, CRUCIBLE_NODE_VMSTATE_MAGIC, sizeof(magic)) != 0 ||
+        !qemu_crucible_fault_vmstate_get_u32(&reader, &rule_count) ||
+        !qemu_crucible_fault_vmstate_get_u32(&reader, &event_count) ||
+        !qemu_crucible_fault_vmstate_get_u32(&reader,
+                                              &state->event_reserved) ||
+        !qemu_crucible_fault_vmstate_get_u16(
+            &reader, &state->terminal_resource_kind) ||
+        !qemu_crucible_fault_vmstate_get_u8(&reader, &terminal) ||
+        !qemu_crucible_fault_vmstate_get_u8(&reader, &force_terminal) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            &reader, &state->event_sequence) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            &reader, &state->event_sequence_reserved) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            &reader, &state->terminal_current) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            &reader, &state->terminal_requested) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            &reader, &state->terminal_configured) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            &reader, &state->terminal_hard) || terminal > 1 ||
+        force_terminal > 1 ||
+        rule_count > CRUCIBLE_NODE_VMSTATE_MAX_RULES ||
+        event_count > CRUCIBLE_NODE_EVENT_CAPACITY - 1 ||
+        state->event_reserved > CRUCIBLE_NODE_EVENT_CAPACITY - 1 ||
+        event_count + state->event_reserved >
+            CRUCIBLE_NODE_EVENT_CAPACITY - 1 ||
+        state->event_sequence_reserved != state->event_reserved ||
+        state->event_sequence > UINT64_MAX -
+            state->event_sequence_reserved) {
+        goto fail;
+    }
+    state->event_terminal = terminal;
+    state->event_force_terminal = force_terminal;
+    for (uint32_t i = 0; i < rule_count; i++) {
+        QemuCrucibleFaultRule *rule =
+            qemu_crucible_fault_rule_vmstate_load(&reader);
+
+        if (!rule) {
+            goto fail;
+        }
+        if (rule->operation != CRUCIBLE_NODE_FAULT_OPERATION_UPSERT) {
+            node_rule_clear(rule);
+            g_free(rule);
+            status = -EINVAL;
+            goto fail;
+        }
+        if (i != 0) {
+            QemuCrucibleFaultRule *previous = g_ptr_array_index(
+                state->rules, i - 1);
+
+            if (node_rule_compare(&previous, &rule) >= 0) {
+                node_rule_clear(rule);
+                g_free(rule);
+                status = -EINVAL;
+                goto fail;
+            }
+        }
+        g_ptr_array_add(state->rules, rule);
+    }
+    for (uint32_t i = 0; i < event_count; i++) {
+        CrucibleNodeEvent *event = g_new0(CrucibleNodeEvent, 1);
+
+        if (!crucible_node_vmstate_get_event(&reader, event) ||
+            event->event.event_sequence > state->event_sequence ||
+            (i != 0 && event->event.event_sequence <=
+                ((CrucibleNodeEvent *)g_ptr_array_index(
+                    state->events, i - 1))->event.event_sequence)) {
+            crucible_node_vmstate_event_free(event);
+            goto fail;
+        }
+        g_ptr_array_add(state->events, event);
+    }
+    if (!qemu_crucible_fault_vmstate_reader_finished(&reader)) {
+        goto fail;
+    }
+    qemu_crucible_fault_vmstate_expect_reservations(
+        state->event_reserved);
+    *staged_out = state;
+    g_assert(!crucible_node_vmstate_prepared);
+    crucible_node_vmstate_prepared = state;
+    return 0;
+
+fail:
+    crucible_node_vmstate_free(state);
+    return status;
+}
+
+static void crucible_node_vmstate_commit(void *opaque)
+{
+    CrucibleNodeVmstate *state = opaque;
+    CrucibleNodeEvent *queued;
+
+    node_events_ensure();
+    g_assert(crucible_node_vmstate_prepared == state);
+    crucible_node_vmstate_prepared = NULL;
+    while ((queued = QTAILQ_FIRST(&crucible_node_events))) {
+        QTAILQ_REMOVE(&crucible_node_events, queued, link);
+        g_clear_pointer(&queued->payload, g_byte_array_unref);
+        queued->payload_length = 0;
+        QTAILQ_INSERT_TAIL(&crucible_node_free_events, queued, link);
+    }
+    node_rules_ensure();
+    g_ptr_array_unref(crucible_node_rules);
+    crucible_node_rules = g_steal_pointer(&state->rules);
+    crucible_node_event_count = 0;
+    for (guint i = 0; i < state->events->len; i++) {
+        CrucibleNodeEvent *source = g_ptr_array_index(state->events, i);
+        CrucibleNodeEvent *destination = QTAILQ_FIRST(
+            &crucible_node_free_events);
+
+        g_assert(destination);
+        QTAILQ_REMOVE(&crucible_node_free_events, destination, link);
+        destination->event = source->event;
+        destination->payload_length = source->payload_length;
+        memcpy(destination->inline_payload, source->inline_payload,
+               sizeof(destination->inline_payload));
+        destination->payload = g_steal_pointer(&source->payload);
+        QTAILQ_INSERT_TAIL(&crucible_node_events, destination, link);
+        crucible_node_event_count++;
+    }
+    crucible_node_event_sequence = state->event_sequence;
+    crucible_node_event_reserved = state->event_reserved;
+    crucible_node_event_sequence_reserved = state->event_sequence_reserved;
+    crucible_node_event_terminal = state->event_terminal;
+    crucible_node_event_force_terminal = state->event_force_terminal;
+    crucible_node_terminal_resource_kind = state->terminal_resource_kind;
+    crucible_node_terminal_current = state->terminal_current;
+    crucible_node_terminal_requested = state->terminal_requested;
+    crucible_node_terminal_configured = state->terminal_configured;
+    crucible_node_terminal_hard = state->terminal_hard;
+    node_memory_index_rebuild();
+    g_ptr_array_set_size(state->events, 0);
+    crucible_node_vmstate_free(state);
+}
+
+QemuCrucibleFaultRule *qemu_crucible_fault_vmstate_rule_lookup_staged(
+    uint16_t command_kind, const uint8_t binding_hash[32],
+    uint64_t generation)
+{
+    if (!crucible_node_vmstate_prepared) {
+        return NULL;
+    }
+    for (guint i = 0; i < crucible_node_vmstate_prepared->rules->len; i++) {
+        QemuCrucibleFaultRule *rule = g_ptr_array_index(
+            crucible_node_vmstate_prepared->rules, i);
+
+        if (rule->command_kind == command_kind &&
+            rule->generation == generation &&
+            memcmp(rule->binding_hash, binding_hash, 32) == 0) {
+            return node_rule_ref(rule);
+        }
+    }
+    return NULL;
+}
+
+bool qemu_crucible_fault_rule_foreach_staged(
+    uint16_t command_kind, QemuCrucibleFaultRuleVisitFn visit,
+    void *opaque)
+{
+    if (!crucible_node_vmstate_prepared || !visit) {
+        return false;
+    }
+    for (guint i = 0; i < crucible_node_vmstate_prepared->rules->len; i++) {
+        QemuCrucibleFaultRule *rule = g_ptr_array_index(
+            crucible_node_vmstate_prepared->rules, i);
+
+        if (rule->command_kind == command_kind) {
+            visit(rule, opaque);
+        }
+    }
+    return true;
+}
+
+static const QemuCrucibleFaultVmstateSection
+crucible_node_vmstate_section = {
+    .name = "node-rules",
+    .version = 1,
+    .save = crucible_node_vmstate_save,
+    .prepare = crucible_node_vmstate_prepare,
+    .commit = crucible_node_vmstate_commit,
+    .free_staged = crucible_node_vmstate_free,
+};
+
+static bool crucible_memory_vmstate_rule(
+    const QemuCrucibleFaultRule *rule)
+{
+    return rule->target_kind == CRUCIBLE_NODE_FAULT_TARGET_MEMORY ||
+           rule->command_kind ==
+               CRUCIBLE_FAULT_COMMAND_MEMORY_ACCESS_TRANSFORM ||
+           rule->command_kind == CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE ||
+           rule->command_kind == CRUCIBLE_FAULT_COMMAND_MEMORY_SERVICE;
+}
+
+static void crucible_memory_vmstate_put_rule_id(
+    GByteArray *payload, const QemuCrucibleFaultRule *rule)
+{
+    qemu_crucible_fault_rule_reference_vmstate_save(payload, rule);
+}
+
+void qemu_crucible_fault_rule_reference_vmstate_save(
+    GByteArray *payload, const QemuCrucibleFaultRule *rule)
+{
+    qemu_crucible_fault_vmstate_put_u16(payload, rule->command_kind);
+    qemu_crucible_fault_vmstate_put_u16(payload, 0);
+    qemu_crucible_fault_vmstate_put_u64(payload, rule->generation);
+    qemu_crucible_fault_vmstate_put_bytes(payload, rule->binding_hash, 32);
+}
+
+static QemuCrucibleFaultRule *crucible_memory_vmstate_get_rule_id(
+    QemuCrucibleFaultVmstateReader *reader)
+{
+    return qemu_crucible_fault_rule_reference_vmstate_load(reader);
+}
+
+QemuCrucibleFaultRule *qemu_crucible_fault_rule_reference_vmstate_load(
+    QemuCrucibleFaultVmstateReader *reader)
+{
+    uint8_t binding_hash[32];
+    uint16_t command_kind, reserved;
+    uint64_t generation;
+
+    if (!qemu_crucible_fault_vmstate_get_u16(reader, &command_kind) ||
+        !qemu_crucible_fault_vmstate_get_u16(reader, &reserved) ||
+        !qemu_crucible_fault_vmstate_get_u64(reader, &generation) ||
+        !qemu_crucible_fault_vmstate_get_bytes(reader, binding_hash, 32) ||
+        reserved != 0 || generation == 0) {
+        return NULL;
+    }
+    return qemu_crucible_fault_vmstate_rule_lookup_staged(
+        command_kind, binding_hash, generation);
+}
+
+static int crucible_memory_vmstate_save(GByteArray *payload)
+{
+    g_autoptr(GArray) retries = g_array_new(
+        false, false, sizeof(CrucibleMemoryVmstateRetry));
+    uint32_t rule_count = 0;
+    GHashTableIter iterator;
+    gpointer key, value;
+
+    if (crucible_memory_transaction.active ||
+        crucible_memory_transaction.lock_held ||
+        crucible_memory_post_state.active || crucible_memory_matches_in_use ||
+        crucible_memory_preflight_collecting ||
+        crucible_memory_resource_planning ||
+        (crucible_memory_pending_services &&
+         crucible_memory_pending_services->len != 0) ||
+        crucible_memory_reserved_virtual_time != 0 ||
+        (crucible_memory_reserved_counters &&
+         g_hash_table_size(crucible_memory_reserved_counters) != 0) ||
+        (crucible_memory_reserved_rows &&
+         g_hash_table_size(crucible_memory_reserved_rows) != 0) ||
+        (crucible_memory_reserved_retention &&
+         g_hash_table_size(crucible_memory_reserved_retention) != 0) ||
+        (crucible_memory_reserved_ledgers &&
+         g_hash_table_size(crucible_memory_reserved_ledgers) != 0)) {
+        return -EBUSY;
+    }
+    node_rules_ensure();
+    for (guint i = 0; i < crucible_node_rules->len; i++) {
+        QemuCrucibleFaultRule *rule = g_ptr_array_index(
+            crucible_node_rules, i);
+
+        if (crucible_memory_vmstate_rule(rule)) {
+            rule_count++;
+        }
+    }
+    if (crucible_memory_retry_states) {
+        g_hash_table_iter_init(&iterator, crucible_memory_retry_states);
+        while (g_hash_table_iter_next(&iterator, &key, &value)) {
+            CrucibleMemoryVmstateRetry retry = {
+                .key = *(CrucibleMemoryRetryKey *)key,
+                .state = *(CrucibleMemoryRetryState *)value,
+            };
+
+            g_array_append_val(retries, retry);
+        }
+        g_array_sort(retries, crucible_memory_vmstate_retry_compare);
+    }
+    qemu_crucible_fault_vmstate_put_bytes(payload, "CRUCMVS1", 8);
+    qemu_crucible_fault_vmstate_put_u32(payload, rule_count);
+    qemu_crucible_fault_vmstate_put_u32(payload, retries->len);
+    qemu_crucible_fault_vmstate_put_u64(payload,
+                                        crucible_memory_access_sequence);
+    qemu_crucible_fault_vmstate_put_u64(payload,
+                                        crucible_memory_retention_next_ns);
+    for (guint i = 0; i < crucible_node_rules->len; i++) {
+        QemuCrucibleFaultRule *rule = g_ptr_array_index(
+            crucible_node_rules, i);
+        g_autoptr(GArray) cells = g_array_new(
+            false, false, sizeof(CrucibleMemoryVmstateRetention));
+        g_autoptr(GArray) rows = g_array_new(
+            false, false, sizeof(CrucibleMemoryVmstateRow));
+        uint32_t translation_count = rule->translations ?
+            rule->translations->len : 0;
+
+        if (!crucible_memory_vmstate_rule(rule)) {
+            continue;
+        }
+        if (rule->retention_cells) {
+            g_hash_table_iter_init(&iterator, rule->retention_cells);
+            while (g_hash_table_iter_next(&iterator, &key, &value)) {
+                CrucibleMemoryVmstateRetention cell = {
+                    .offset = *(uint64_t *)key,
+                    .cell = *(CrucibleRetentionCell *)value,
+                };
+
+                g_array_append_val(cells, cell);
+            }
+            g_array_sort(cells,
+                         crucible_memory_vmstate_retention_compare);
+        }
+        if (rule->row_counters) {
+            g_hash_table_iter_init(&iterator, rule->row_counters);
+            while (g_hash_table_iter_next(&iterator, &key, &value)) {
+                CrucibleMemoryVmstateRow row = {
+                    .coordinate = *(CrucibleDramCoordinate *)key,
+                    .count = *(uint64_t *)value,
+                };
+
+                g_array_append_val(rows, row);
+            }
+            g_array_sort(rows, crucible_memory_vmstate_row_compare);
+        }
+        if (cells->len > CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT ||
+            rows->len > CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT ||
+            translation_count > CRUCIBLE_NODE_MEMORY_MATCH_LIMIT) {
+            return -E2BIG;
+        }
+        crucible_memory_vmstate_put_rule_id(payload, rule);
+        qemu_crucible_fault_vmstate_put_u64(payload,
+                                            rule->last_exposure_ns);
+        qemu_crucible_fault_vmstate_put_u64(payload,
+                                            rule->retention_next_ns);
+        qemu_crucible_fault_vmstate_put_u8(payload,
+                                           rule->exposure_initialized);
+        qemu_crucible_fault_vmstate_put_u8(payload,
+                                           rule->retention_scheduled);
+        qemu_crucible_fault_vmstate_put_u8(payload,
+                                           rule->translation_stale);
+        qemu_crucible_fault_vmstate_put_u8(
+            payload, rule->translation_error_reported);
+        qemu_crucible_fault_vmstate_put_u64(
+            payload, rule->service_ledger ? rule->service_ledger->ready_ns : 0);
+        qemu_crucible_fault_vmstate_put_u32(payload, cells->len);
+        qemu_crucible_fault_vmstate_put_u32(payload, rows->len);
+        qemu_crucible_fault_vmstate_put_u32(payload, translation_count);
+        qemu_crucible_fault_vmstate_put_u32(payload, 0);
+        qemu_crucible_fault_vmstate_put_bytes(payload,
+                                              rule->translation_hash, 32);
+        for (guint cell_index = 0; cell_index < cells->len; cell_index++) {
+            CrucibleMemoryVmstateRetention *cell = &g_array_index(
+                cells, CrucibleMemoryVmstateRetention, cell_index);
+
+            qemu_crucible_fault_vmstate_put_u64(payload, cell->offset);
+            for (size_t bit = 0; bit < G_N_ELEMENTS(cell->cell.refresh_ns);
+                 bit++) {
+                qemu_crucible_fault_vmstate_put_u64(
+                    payload, cell->cell.refresh_ns[bit]);
+            }
+            qemu_crucible_fault_vmstate_put_u8(payload,
+                                               cell->cell.decayed_mask);
+        }
+        for (guint row_index = 0; row_index < rows->len; row_index++) {
+            CrucibleMemoryVmstateRow *row = &g_array_index(
+                rows, CrucibleMemoryVmstateRow, row_index);
+
+            qemu_crucible_fault_vmstate_put_u64(payload,
+                                                row->coordinate.row);
+            qemu_crucible_fault_vmstate_put_u16(payload,
+                                                row->coordinate.channel);
+            qemu_crucible_fault_vmstate_put_u16(payload,
+                                                row->coordinate.rank);
+            qemu_crucible_fault_vmstate_put_u16(payload,
+                                                row->coordinate.bank);
+            qemu_crucible_fault_vmstate_put_u16(payload, 0);
+            qemu_crucible_fault_vmstate_put_u64(payload, row->count);
+        }
+        for (uint32_t translation_index = 0;
+             translation_index < translation_count; translation_index++) {
+            CrucibleNodeTranslation *translation = &g_array_index(
+                rule->translations, CrucibleNodeTranslation,
+                translation_index);
+
+            qemu_crucible_fault_vmstate_put_u64(
+                payload, translation->virtual_page);
+            qemu_crucible_fault_vmstate_put_u64(
+                payload, translation->physical_page);
+            qemu_crucible_fault_vmstate_put_u64(payload,
+                                                translation->page_size);
+            qemu_crucible_fault_vmstate_put_u32(
+                payload, translation->covered_bytes);
+            qemu_crucible_fault_vmstate_put_u16(
+                payload, translation->attrs.requester_id);
+            qemu_crucible_fault_vmstate_put_u8(payload,
+                                               translation->attrs.pid);
+            qemu_crucible_fault_vmstate_put_u8(payload,
+                                               translation->attrs.space);
+            qemu_crucible_fault_vmstate_put_u8(payload,
+                                               translation->attrs.secure);
+            qemu_crucible_fault_vmstate_put_u8(payload,
+                                               translation->attrs.user);
+            qemu_crucible_fault_vmstate_put_u8(payload,
+                                               translation->attrs.memory);
+            qemu_crucible_fault_vmstate_put_u8(payload,
+                                               translation->attrs.debug);
+            qemu_crucible_fault_vmstate_put_u8(
+                payload, translation->attrs.unspecified);
+            qemu_crucible_fault_vmstate_put_u8(payload,
+                                               translation->readable);
+            qemu_crucible_fault_vmstate_put_u8(payload,
+                                               translation->writable);
+            qemu_crucible_fault_vmstate_put_u8(payload,
+                                               translation->executable);
+            qemu_crucible_fault_vmstate_put_u8(payload,
+                                               translation->user);
+            qemu_crucible_fault_vmstate_put_u8(payload, 0);
+        }
+    }
+    for (guint i = 0; i < retries->len; i++) {
+        CrucibleMemoryVmstateRetry *retry = &g_array_index(
+            retries, CrucibleMemoryVmstateRetry, i);
+        const CrucibleMemoryRetryKey *key = &retry->key;
+
+        qemu_crucible_fault_vmstate_put_u64(payload, key->address);
+        qemu_crucible_fault_vmstate_put_u64(payload, key->length);
+        qemu_crucible_fault_vmstate_put_u64(payload, key->observed_icount);
+        qemu_crucible_fault_vmstate_put_u64(payload, key->instruction_pc);
+        qemu_crucible_fault_vmstate_put_u64(
+            payload, key->page_table_target_vaddr);
+        qemu_crucible_fault_vmstate_put_u32(payload, key->access_class);
+        qemu_crucible_fault_vmstate_put_u32(payload, key->actor);
+        qemu_crucible_fault_vmstate_put_u32(payload,
+                                            key->instruction_ordinal);
+        qemu_crucible_fault_vmstate_put_u32(payload,
+                                            key->page_table_level);
+        qemu_crucible_fault_vmstate_put_u32(payload,
+                                            key->page_table_stage);
+        qemu_crucible_fault_vmstate_put_u32(
+            payload, key->initiating_access_class);
+        qemu_crucible_fault_vmstate_put_u8(payload, key->has_instruction);
+        qemu_crucible_fault_vmstate_put_u8(payload, key->streaming);
+        qemu_crucible_fault_vmstate_put_u16(payload, 0);
+        qemu_crucible_fault_vmstate_put_u64(
+            payload, retry->state.last_access_sequence);
+        qemu_crucible_fault_vmstate_put_u32(payload,
+                                            retry->state.retry_ordinal);
+        qemu_crucible_fault_vmstate_put_u32(payload, 0);
+    }
+    return 0;
+}
+
+static void crucible_memory_vmstate_free(void *opaque)
+{
+    CrucibleMemoryVmstate *state = opaque;
+
+    if (!state) {
+        return;
+    }
+    if (state->ledgers) {
+        for (guint i = 0; i < state->ledgers->len; i++) {
+            CrucibleMemoryVmstateLedger *ledger = &g_array_index(
+                state->ledgers, CrucibleMemoryVmstateLedger, i);
+
+            qemu_crucible_fault_rule_unref(ledger->rule);
+        }
+        g_array_unref(state->ledgers);
+    }
+    g_clear_pointer(&state->retry_states, g_hash_table_unref);
+    g_free(state);
+}
