+        a->x86_machine_check.corrected == b->x86_machine_check.corrected &&
+        a->x86_machine_check.has_address ==
+            b->x86_machine_check.has_address &&
+        a->x86_machine_check.has_misc == b->x86_machine_check.has_misc &&
+        a->aarch64_ras.esr == b->aarch64_ras.esr &&
+        a->aarch64_ras.far == b->aarch64_ras.far &&
+        a->aarch64_ras.disr == b->aarch64_ras.disr &&
+        a->aarch64_ras.asynchronous == b->aarch64_ras.asynchronous &&
