+static int crucible_interrupt_vmstate_save(GByteArray *payload)
+{
+    g_autoptr(GArray) provenance = g_array_new(
+        false, true, sizeof(CrucibleInterruptVmstateProvenance));
+    GHashTableIter iterator;
+    gpointer key, value;
+    uint8_t identity[32];
+    uint32_t deferred_count = crucible_interrupt_deferred ?
+        crucible_interrupt_deferred->len : 0;
+    uint32_t impulse_count = crucible_interrupt_impulses ?
+        crucible_interrupt_impulses->len : 0;
+    uint32_t storm_count = crucible_interrupt_storms ?
+        crucible_interrupt_storms->len : 0;
+    uint32_t deferred_reserved = qatomic_read(
+        &crucible_interrupt_deferred_reserved);
+
+    if (!crucible_interrupt_vmstate_identity(identity) ||
+        crucible_interrupt_pending_commit ||
+        crucible_interrupt_current_source != 0 ||
+        crucible_interrupt_current_polarity != 0 ||
+        crucible_interrupt_current_sequence != 0 ||
+        crucible_interrupt_current_route_generation != 0 ||
+        deferred_count > CRUCIBLE_INTERRUPT_DEFERRED_CAPACITY ||
+        deferred_count != deferred_reserved ||
+        impulse_count > CRUCIBLE_FAULT_DEFAULT_COMMAND_CAPACITY ||
+        storm_count > CRUCIBLE_FAULT_DEFAULT_COMMAND_CAPACITY ||
+        (crucible_interrupt_event_terminal_latched &&
+         (deferred_count != 0 || impulse_count != 0 || storm_count != 0))) {
+        return -EBUSY;
+    }
+    if (crucible_interrupt_provenance) {
+        g_hash_table_iter_init(&iterator, crucible_interrupt_provenance);
+        while (g_hash_table_iter_next(&iterator, &key, &value)) {
+            CrucibleInterruptVmstateProvenance entry = {
+                .key = *(CrucibleInterruptProvenanceKey *)key,
+                .event = *(QemuCrucibleInterruptEvent *)value,
+            };
+
+            g_array_append_val(provenance, entry);
+        }
+    }
+    if (provenance->len > CRUCIBLE_INTERRUPT_PROVENANCE_CAPACITY) {
+        return -EINVAL;
+    }
+    g_array_sort(provenance,
+                 crucible_interrupt_vmstate_provenance_compare);
+    qemu_crucible_fault_vmstate_put_bytes(payload, "CRUCIVS1", 8);
+    qemu_crucible_fault_vmstate_put_bytes(payload, identity, 32);
+    qemu_crucible_fault_vmstate_put_u64(
+        payload, qatomic_read(&crucible_interrupt_next_source_sequence));
+    qemu_crucible_fault_vmstate_put_u64(
+        payload, qatomic_read(&crucible_interrupt_next_route_generation));
+    qemu_crucible_fault_vmstate_put_u32(payload, deferred_count);
+    qemu_crucible_fault_vmstate_put_u32(payload, impulse_count);
+    qemu_crucible_fault_vmstate_put_u32(payload, storm_count);
+    qemu_crucible_fault_vmstate_put_u32(payload, provenance->len);
+    qemu_crucible_fault_vmstate_put_u32(payload, deferred_reserved);
+    qemu_crucible_fault_vmstate_put_u8(
+        payload, crucible_interrupt_event_terminal_latched);
+    qemu_crucible_fault_vmstate_put_u8(payload, 0);
+    qemu_crucible_fault_vmstate_put_u16(payload, 0);
+    for (uint32_t i = 0; i < deferred_count; i++) {
+        CrucibleInterruptDeferred *deferred = g_ptr_array_index(
+            crucible_interrupt_deferred, i);
+        uint64_t deadline = timer_expire_time_ns(deferred->timer);
+
+        if (!timer_pending(deferred->timer) || deadline > INT64_MAX ||
+            !deferred->inject || deferred->event.family >=
+                G_N_ELEMENTS(crucible_interrupt_injectors) ||
+            deferred->inject != crucible_interrupt_injectors[
+                deferred->event.family].inject ||
+            deferred->opaque != crucible_interrupt_injectors[
+                deferred->event.family].opaque) {
+            return -EINVAL;
+        }
+        crucible_interrupt_vmstate_put_event(payload, &deferred->event);
+        qemu_crucible_fault_rule_vmstate_save(payload, deferred->rule);
+        qemu_crucible_fault_vmstate_put_u64(payload, deferred->delay_ns);
+        qemu_crucible_fault_vmstate_put_u64(payload, deadline);
+        qemu_crucible_fault_vmstate_put_bytes(
+            payload, deferred->before_hash, 32);
+    }
+    for (uint32_t i = 0; i < impulse_count; i++) {
+        CrucibleInterruptImpulse *impulse = g_ptr_array_index(
+            crucible_interrupt_impulses, i);
+        size_t remaining = qemu_crucible_fault_event_reservation_remaining(
+            impulse->event_reservation);
+
+        if (remaining == 0 || remaining > UINT32_MAX) {
+            return -EINVAL;
+        }
+        qemu_crucible_fault_rule_vmstate_save(payload, impulse->rule);
+        qemu_crucible_fault_vmstate_put_u64(
+            payload, impulse->command_icount);
+        qemu_crucible_fault_vmstate_put_bytes(
+            payload, impulse->before_hash, 32);
+        qemu_crucible_fault_vmstate_put_u32(payload, remaining);
+        qemu_crucible_fault_vmstate_put_u32(payload, 0);
+    }
+    for (uint32_t i = 0; i < storm_count; i++) {
+        CrucibleInterruptStorm *storm = g_ptr_array_index(
+            crucible_interrupt_storms, i);
+        guint row_index;
+
+        for (row_index = 0; row_index < crucible_interrupt_manifest->len;
+             row_index++) {
+            if (storm->row == &g_array_index(
+                    crucible_interrupt_manifest,
+                    CrucibleInterruptCapability, row_index)) {
+                break;
+            }
+        }
+        if (row_index == crucible_interrupt_manifest->len || storm->firing ||
+            storm->target_vcpu_count > UINT32_MAX ||
+            (storm->completed != (storm->timer == NULL)) ||
+            (!storm->completed &&
+             (!timer_pending(storm->timer) ||
+              timer_expire_time_ns(storm->timer) !=
+                  (uint64_t)storm->next_deadline_ns))) {
+            return -EBUSY;
+        }
+        qemu_crucible_fault_rule_reference_vmstate_save(
+            payload, storm->rule);
+        qemu_crucible_fault_vmstate_put_u32(payload, row_index);
+        qemu_crucible_fault_vmstate_put_u32(
+            payload, storm->target_vcpu_count);
+        for (size_t target = 0; target < storm->target_vcpu_count; target++) {
+            qemu_crucible_fault_vmstate_put_u32(
+                payload, storm->target_vcpus[target]);
+        }
+        qemu_crucible_fault_vmstate_put_u32(payload, storm->vector);
+        qemu_crucible_fault_vmstate_put_u64(payload, storm->period_ns);
+        qemu_crucible_fault_vmstate_put_u64(
+            payload, storm->next_deadline_ns);
+        qemu_crucible_fault_vmstate_put_u32(payload, storm->burst);
+        qemu_crucible_fault_vmstate_put_u32(payload, storm->total);
+        qemu_crucible_fault_vmstate_put_u32(payload, storm->emitted);
+        qemu_crucible_fault_vmstate_put_u16(payload, storm->priority);
+        qemu_crucible_fault_vmstate_put_u8(payload, storm->retain_pending);
+        qemu_crucible_fault_vmstate_put_u8(payload, storm->seen);
+        qemu_crucible_fault_vmstate_put_u8(payload, storm->completed);
+        qemu_crucible_fault_vmstate_put_u8(payload, 0);
+        qemu_crucible_fault_vmstate_put_u16(payload, 0);
+    }
+    for (guint i = 0; i < provenance->len; i++) {
+        CrucibleInterruptVmstateProvenance *entry = &g_array_index(
+            provenance, CrucibleInterruptVmstateProvenance, i);
+
+        qemu_crucible_fault_vmstate_put_u16(payload, entry->key.family);
+        qemu_crucible_fault_vmstate_put_u16(payload, 0);
+        qemu_crucible_fault_vmstate_put_u32(
+            payload, entry->key.target_vcpu);
+        qemu_crucible_fault_vmstate_put_u32(payload, entry->key.vector);
+        crucible_interrupt_vmstate_put_event(payload, &entry->event);
+    }
+    return 0;
+}
+
+static int crucible_interrupt_vmstate_prepare(
+    const uint8_t *payload, size_t payload_len, void **staged_out)
+{
+    QemuCrucibleFaultVmstateReader reader = {
+        .data = payload,
+        .length = payload_len,
+    };
+    CrucibleInterruptVmstate *state = g_new0(
+        CrucibleInterruptVmstate, 1);
+    uint8_t magic[8], saved_identity[32], current_identity[32];
+    uint8_t terminal, reserved8;
+    uint16_t reserved16;
+    uint32_t deferred_count, impulse_count, storm_count, provenance_count;
+
+    state->deferred = g_ptr_array_new_with_free_func(
+        crucible_interrupt_vmstate_deferred_free);
+    state->impulses = g_ptr_array_new_with_free_func(
+        crucible_interrupt_vmstate_impulse_free);
+    state->storms = g_ptr_array_new_with_free_func(
+        crucible_interrupt_vmstate_storm_free);
+    state->provenance = g_array_new(
+        false, true, sizeof(CrucibleInterruptVmstateProvenance));
+    if (!qemu_crucible_fault_vmstate_get_bytes(&reader, magic, 8) ||
+        memcmp(magic, "CRUCIVS1", 8) != 0 ||
+        !qemu_crucible_fault_vmstate_get_bytes(
+            &reader, saved_identity, 32) ||
+        !crucible_interrupt_vmstate_identity(current_identity) ||
+        memcmp(saved_identity, current_identity, 32) != 0 ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            &reader, &state->next_source_sequence) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            &reader, &state->next_route_generation) ||
+        !qemu_crucible_fault_vmstate_get_u32(&reader, &deferred_count) ||
+        !qemu_crucible_fault_vmstate_get_u32(&reader, &impulse_count) ||
+        !qemu_crucible_fault_vmstate_get_u32(&reader, &storm_count) ||
+        !qemu_crucible_fault_vmstate_get_u32(&reader, &provenance_count) ||
+        !qemu_crucible_fault_vmstate_get_u32(
+            &reader, &state->deferred_reserved) ||
+        !qemu_crucible_fault_vmstate_get_u8(&reader, &terminal) ||
+        !qemu_crucible_fault_vmstate_get_u8(&reader, &reserved8) ||
+        !qemu_crucible_fault_vmstate_get_u16(&reader, &reserved16) ||
+        deferred_count > CRUCIBLE_INTERRUPT_DEFERRED_CAPACITY ||
+        deferred_count != state->deferred_reserved ||
+        impulse_count > CRUCIBLE_FAULT_DEFAULT_COMMAND_CAPACITY ||
+        storm_count > CRUCIBLE_FAULT_DEFAULT_COMMAND_CAPACITY ||
+        provenance_count > CRUCIBLE_INTERRUPT_PROVENANCE_CAPACITY ||
+        terminal > 1 || reserved8 != 0 || reserved16 != 0 ||
+        (terminal &&
+         (deferred_count != 0 || impulse_count != 0 || storm_count != 0))) {
+        goto fail;
+    }
+    state->event_terminal = terminal;
+    for (uint32_t i = 0; i < deferred_count; i++) {
+        CrucibleInterruptVmstateDeferred *deferred = g_new0(
+            CrucibleInterruptVmstateDeferred, 1);
+        uint64_t deadline;
+
+        if (!crucible_interrupt_vmstate_get_event(
+                &reader, &deferred->event)) {
+            g_free(deferred);
+            goto fail;
+        }
+        deferred->rule = qemu_crucible_fault_rule_vmstate_load(&reader);
+        if (!deferred->rule ||
+            qemu_crucible_fault_rule_command_kind(deferred->rule) !=
+                CRUCIBLE_FAULT_COMMAND_INTERRUPT_DISPOSITION ||
+            qemu_crucible_fault_rule_operation(deferred->rule) !=
+                CRUCIBLE_NODE_FAULT_OPERATION_APPLY ||
+            qemu_crucible_fault_interrupt_validate(deferred->rule) != 0 ||
+            !crucible_interrupt_vmstate_event_valid(
+                &deferred->event, NULL) ||
+            deferred->event.family >=
+                G_N_ELEMENTS(crucible_interrupt_injectors) ||
+            !crucible_interrupt_injectors[
+                deferred->event.family].inject ||
+            !qemu_crucible_fault_vmstate_get_u64(
+                &reader, &deferred->delay_ns) ||
+            !qemu_crucible_fault_vmstate_get_u64(&reader, &deadline) ||
+            deadline > INT64_MAX || deferred->delay_ns > INT64_MAX ||
+            !qemu_crucible_fault_vmstate_get_bytes(
+                &reader, deferred->before_hash, 32) ||
+            deferred->event.source_sequence >
+                state->next_source_sequence ||
+            deferred->event.routing_generation >
+                state->next_route_generation) {
+            crucible_interrupt_vmstate_deferred_free(deferred);
+            goto fail;
+        }
+        deferred->deadline_ns = deadline;
+        g_ptr_array_add(state->deferred, deferred);
+    }
+    for (uint32_t i = 0; i < impulse_count; i++) {
+        CrucibleInterruptVmstateImpulse *impulse = g_new0(
+            CrucibleInterruptVmstateImpulse, 1);
+        uint32_t reserved32;
+
+        impulse->rule = qemu_crucible_fault_rule_vmstate_load(&reader);
+        if (!impulse->rule ||
+            qemu_crucible_fault_rule_command_kind(impulse->rule) !=
+                CRUCIBLE_FAULT_COMMAND_INTERRUPT_DISPOSITION ||
+            qemu_crucible_fault_rule_operation(impulse->rule) !=
+                CRUCIBLE_NODE_FAULT_OPERATION_APPLY ||
+            qemu_crucible_fault_interrupt_validate(impulse->rule) != 0 ||
+            !qemu_crucible_fault_vmstate_get_u64(
+                &reader, &impulse->command_icount) ||
+            !qemu_crucible_fault_vmstate_get_bytes(
+                &reader, impulse->before_hash, 32) ||
+            !qemu_crucible_fault_vmstate_get_u32(
+                &reader, &impulse->reservation_remaining) ||
+            !qemu_crucible_fault_vmstate_get_u32(
+                &reader, &reserved32) ||
+            impulse->reservation_remaining == 0 || reserved32 != 0 ||
+            (i != 0 && qemu_crucible_fault_rule_command_sequence(
+                ((CrucibleInterruptVmstateImpulse *)g_ptr_array_index(
+                    state->impulses, i - 1))->rule) >=
+                qemu_crucible_fault_rule_command_sequence(impulse->rule))) {
+            crucible_interrupt_vmstate_impulse_free(impulse);
+            goto fail;
+        }
+        g_ptr_array_add(state->impulses, impulse);
+    }
+    for (uint32_t i = 0; i < storm_count; i++) {
+        CrucibleInterruptVmstateStorm *storm = g_new0(
+            CrucibleInterruptVmstateStorm, 1);
+        uint64_t deadline;
+        uint8_t retain_pending, seen, completed, reserved8_storm;
+        uint16_t reserved16_storm;
+        uint32_t *expected_targets = NULL;
+        size_t expected_count = 0;
+        uint16_t expected_priority;
+        bool expected_retain;
+
+        storm->rule = qemu_crucible_fault_rule_reference_vmstate_load(
+            &reader);
+        if (!storm->rule ||
+            qemu_crucible_fault_rule_command_kind(storm->rule) !=
+                CRUCIBLE_FAULT_COMMAND_INTERRUPT_STORM ||
+            qemu_crucible_fault_interrupt_validate(storm->rule) != 0 ||
+            !qemu_crucible_fault_vmstate_get_u32(
+                &reader, &storm->row_index) ||
+            storm->row_index >= crucible_interrupt_manifest->len ||
+            !qemu_crucible_fault_vmstate_get_u32(
+                &reader, &storm->target_vcpu_count) ||
+            storm->target_vcpu_count > crucible_interrupt_target_count) {
+            crucible_interrupt_vmstate_storm_free(storm);
+            goto fail;
+        }
+        storm->target_vcpus = g_new(
+            uint32_t, storm->target_vcpu_count);
+        for (uint32_t target = 0; target < storm->target_vcpu_count;
+             target++) {
+            if (!qemu_crucible_fault_vmstate_get_u32(
+                    &reader, &storm->target_vcpus[target])) {
+                crucible_interrupt_vmstate_storm_free(storm);
+                goto fail;
+            }
+        }
+        if (!qemu_crucible_fault_vmstate_get_u32(
+                &reader, &storm->vector) ||
+            !qemu_crucible_fault_vmstate_get_u64(
+                &reader, &storm->period_ns) ||
+            !qemu_crucible_fault_vmstate_get_u64(&reader, &deadline) ||
+            deadline > INT64_MAX ||
+            !qemu_crucible_fault_vmstate_get_u32(&reader, &storm->burst) ||
+            !qemu_crucible_fault_vmstate_get_u32(&reader, &storm->total) ||
+            !qemu_crucible_fault_vmstate_get_u32(&reader, &storm->emitted) ||
+            !qemu_crucible_fault_vmstate_get_u16(
+                &reader, &storm->priority) ||
+            !qemu_crucible_fault_vmstate_get_u8(
+                &reader, &retain_pending) ||
+            !qemu_crucible_fault_vmstate_get_u8(&reader, &seen) ||
+            !qemu_crucible_fault_vmstate_get_u8(&reader, &completed) ||
+            !qemu_crucible_fault_vmstate_get_u8(
+                &reader, &reserved8_storm) ||
+            !qemu_crucible_fault_vmstate_get_u16(
+                &reader, &reserved16_storm) ||
+            retain_pending > 1 || seen != 1 || completed > 1 ||
+            reserved8_storm != 0 || reserved16_storm != 0 ||
+            storm->period_ns == 0 || storm->period_ns > INT64_MAX ||
+            storm->burst == 0 || storm->total == 0 ||
+            storm->emitted > storm->total ||
+            (completed != (storm->emitted == storm->total)) ||
+            (completed != (storm->target_vcpu_count == 0))) {
+            crucible_interrupt_vmstate_storm_free(storm);
+            goto fail;
+        }
+        storm->next_deadline_ns = deadline;
+        storm->retain_pending = retain_pending;
+        storm->seen = seen;
+        storm->completed = completed;
+        if (!crucible_interrupt_storm_targets_copy(
+                storm->rule, &expected_targets, &expected_count) ||
+            (!storm->completed &&
+             (expected_count != storm->target_vcpu_count ||
+              memcmp(expected_targets, storm->target_vcpus,
+                     expected_count * sizeof(*expected_targets)) != 0)) ||
+            !crucible_interrupt_storm_routing(
+                storm->rule,
+                &g_array_index(crucible_interrupt_manifest,
+                               CrucibleInterruptCapability,
+                               storm->row_index),
+                expected_targets[0], storm->vector,
+                &expected_priority, &expected_retain) ||
+            expected_priority != storm->priority ||
+            expected_retain != storm->retain_pending) {
+            g_free(expected_targets);
+            crucible_interrupt_vmstate_storm_free(storm);
+            goto fail;
+        }
+        g_free(expected_targets);
+        g_ptr_array_add(state->storms, storm);
+    }
+    for (uint32_t i = 0; i < provenance_count; i++) {
+        CrucibleInterruptVmstateProvenance entry = { 0 };
+        uint16_t reserved;
+
+        if (!qemu_crucible_fault_vmstate_get_u16(
+                &reader, &entry.key.family) ||
+            !qemu_crucible_fault_vmstate_get_u16(&reader, &reserved) ||
+            !qemu_crucible_fault_vmstate_get_u32(
+                &reader, &entry.key.target_vcpu) ||
+            !qemu_crucible_fault_vmstate_get_u32(
+                &reader, &entry.key.vector) ||
+            !crucible_interrupt_vmstate_get_event(&reader, &entry.event) ||
+            reserved != 0 || entry.key.family != entry.event.family ||
+            entry.key.target_vcpu != entry.event.target_vcpu ||
+            entry.key.vector != entry.event.vector ||
+            entry.key.family == QEMU_CRUCIBLE_INTERRUPT_X86_NMI ||
+            !crucible_interrupt_vmstate_event_valid(&entry.event, NULL) ||
+            entry.event.source_sequence > state->next_source_sequence ||
+            entry.event.routing_generation > state->next_route_generation ||
+            (i != 0 && crucible_interrupt_vmstate_provenance_compare(
+                &g_array_index(state->provenance,
+                               CrucibleInterruptVmstateProvenance, i - 1),
+                &entry) >= 0)) {
+            goto fail;
+        }
+        g_array_append_val(state->provenance, entry);
+    }
+    if (!qemu_crucible_fault_vmstate_reader_finished(&reader)) {
+        goto fail;
+    }
+    for (guint i = 0; i < state->impulses->len; i++) {
+        CrucibleInterruptVmstateImpulse *impulse = g_ptr_array_index(
+            state->impulses, i);
+
+        qemu_crucible_fault_vmstate_count_reservations(
+            impulse->reservation_remaining);
+        impulse->reservation =
+            qemu_crucible_fault_event_reservation_restore(
+                impulse->reservation_remaining);
+        if (!impulse->reservation) {
+            goto fail;
+        }
+    }
+    state->restored_deferred = g_ptr_array_new_with_free_func(
+        crucible_interrupt_restored_deferred_free);
+    state->restored_impulses = g_ptr_array_new_with_free_func(
+        crucible_interrupt_restored_impulse_free);
+    state->restored_storms = g_ptr_array_new_with_free_func(
+        (GDestroyNotify)crucible_interrupt_storm_free);
+    for (guint i = 0; i < state->deferred->len; i++) {
+        CrucibleInterruptVmstateDeferred *source = g_ptr_array_index(
+            state->deferred, i);
+        CrucibleInterruptDeferred *deferred = g_new0(
+            CrucibleInterruptDeferred, 1);
+        CrucibleInterruptInjector *injector =
+            &crucible_interrupt_injectors[source->event.family];
+
+        deferred->event = source->event;
+        deferred->inject = injector->inject;
+        deferred->opaque = injector->opaque;
+        deferred->rule = source->rule;
+        source->rule = NULL;
+        deferred->delay_ns = source->delay_ns;
+        memcpy(deferred->before_hash, source->before_hash, 32);
+        deferred->timer = timer_new_ns(
+            QEMU_CLOCK_VIRTUAL, crucible_interrupt_deferred_cb, deferred);
+        g_ptr_array_add(state->restored_deferred, deferred);
+    }
+    for (guint i = 0; i < state->impulses->len; i++) {
+        CrucibleInterruptVmstateImpulse *source = g_ptr_array_index(
+            state->impulses, i);
+        CrucibleInterruptImpulse *impulse = g_new0(
+            CrucibleInterruptImpulse, 1);
+
+        impulse->rule = source->rule;
+        source->rule = NULL;
+        impulse->command_icount = source->command_icount;
+        memcpy(impulse->before_hash, source->before_hash, 32);
+        impulse->event_reservation = source->reservation;
+        source->reservation = NULL;
+        g_ptr_array_add(state->restored_impulses, impulse);
+    }
+    for (guint i = 0; i < state->storms->len; i++) {
+        CrucibleInterruptVmstateStorm *source = g_ptr_array_index(
+            state->storms, i);
+        CrucibleInterruptStorm *storm = g_new0(CrucibleInterruptStorm, 1);
+
+        storm->rule = source->rule;
+        source->rule = NULL;
+        storm->row = &g_array_index(
+            crucible_interrupt_manifest, CrucibleInterruptCapability,
+            source->row_index);
+        storm->target_vcpus = g_steal_pointer(&source->target_vcpus);
+        storm->target_vcpu_count = source->target_vcpu_count;
+        storm->vector = source->vector;
+        storm->period_ns = source->period_ns;
+        storm->next_deadline_ns = source->next_deadline_ns;
+        storm->burst = source->burst;
+        storm->total = source->total;
+        storm->emitted = source->emitted;
+        storm->priority = source->priority;
+        storm->retain_pending = source->retain_pending;
+        storm->seen = source->seen;
+        storm->completed = source->completed;
+        if (!storm->completed) {
+            storm->timer = timer_new_ns(
+                QEMU_CLOCK_VIRTUAL, crucible_interrupt_storm_cb, storm);
+        }
+        g_ptr_array_add(state->restored_storms, storm);
+    }
+    state->restored_provenance = g_hash_table_new_full(
+        crucible_interrupt_provenance_hash,
+        crucible_interrupt_provenance_equal, g_free, g_free);
+    for (guint i = 0; i < state->provenance->len; i++) {
+        CrucibleInterruptVmstateProvenance *source = &g_array_index(
+            state->provenance, CrucibleInterruptVmstateProvenance, i);
+        CrucibleInterruptProvenanceKey *key = g_new(
+            CrucibleInterruptProvenanceKey, 1);
+        QemuCrucibleInterruptEvent *event = g_new(
+            QemuCrucibleInterruptEvent, 1);
+
+        *key = source->key;
+        *event = source->event;
+        g_hash_table_insert(state->restored_provenance, key, event);
+    }
+    qemu_crucible_fault_vmstate_count_deferred(state->impulses->len);
+    *staged_out = state;
+    return 0;
+
+fail:
+    crucible_interrupt_vmstate_free(state);
+    return -EINVAL;
+}
+
+static void crucible_interrupt_vmstate_commit(void *opaque)
+{
+    CrucibleInterruptVmstate *state = opaque;
+
+    while (crucible_interrupt_deferred &&
+           crucible_interrupt_deferred->len != 0) {
+        CrucibleInterruptDeferred *deferred = g_ptr_array_index(
+            crucible_interrupt_deferred, 0);
+
+        g_ptr_array_remove_index(crucible_interrupt_deferred, 0);
+        timer_del(deferred->timer);
+        timer_free(deferred->timer);
+        qemu_crucible_fault_rule_unref(deferred->rule);
+        g_free(deferred);
+    }
+    qatomic_set(&crucible_interrupt_deferred_reserved, 0);
+    while (crucible_interrupt_impulses &&
+           crucible_interrupt_impulses->len != 0) {
+        CrucibleInterruptImpulse *impulse = g_ptr_array_index(
+            crucible_interrupt_impulses, 0);
+
+        g_ptr_array_remove_index(crucible_interrupt_impulses, 0);
+        qemu_crucible_fault_event_reservation_release(
+            impulse->event_reservation);
+        qemu_crucible_fault_rule_unref(impulse->rule);
+        g_free(impulse);
+    }
+    while (crucible_interrupt_storms &&
+           crucible_interrupt_storms->len != 0) {
+        CrucibleInterruptStorm *storm = g_ptr_array_index(
+            crucible_interrupt_storms, 0);
+
+        g_ptr_array_remove_index(crucible_interrupt_storms, 0);
+        crucible_interrupt_storm_free(storm);
+    }
+    g_clear_pointer(&crucible_interrupt_deferred, g_ptr_array_unref);
+    g_clear_pointer(&crucible_interrupt_impulses, g_ptr_array_unref);
+    g_clear_pointer(&crucible_interrupt_storms, g_ptr_array_unref);
+    crucible_interrupt_deferred =
+        g_steal_pointer(&state->restored_deferred);
+    crucible_interrupt_impulses =
+        g_steal_pointer(&state->restored_impulses);
+    crucible_interrupt_storms = g_steal_pointer(&state->restored_storms);
+    g_ptr_array_set_free_func(crucible_interrupt_deferred, NULL);
+    g_ptr_array_set_free_func(crucible_interrupt_impulses, NULL);
+    g_ptr_array_set_free_func(crucible_interrupt_storms, NULL);
+    for (guint i = 0; i < crucible_interrupt_deferred->len; i++) {
+        CrucibleInterruptDeferred *deferred = g_ptr_array_index(
+            crucible_interrupt_deferred, i);
+        CrucibleInterruptVmstateDeferred *source = g_ptr_array_index(
+            state->deferred, i);
+
+        timer_mod_ns(deferred->timer, source->deadline_ns);
+    }
+    qatomic_set(&crucible_interrupt_deferred_reserved,
+                state->deferred_reserved);
+    for (guint i = 0; i < crucible_interrupt_storms->len; i++) {
+        CrucibleInterruptStorm *storm = g_ptr_array_index(
+            crucible_interrupt_storms, i);
+        if (!storm->completed) {
+            timer_mod_ns(storm->timer, storm->next_deadline_ns);
+        }
+    }
+    g_clear_pointer(&crucible_interrupt_provenance, g_hash_table_unref);
+    crucible_interrupt_provenance =
+        g_steal_pointer(&state->restored_provenance);
+    qatomic_set(&crucible_interrupt_next_source_sequence,
+                state->next_source_sequence);
+    qatomic_set(&crucible_interrupt_next_route_generation,
+                state->next_route_generation);
+    crucible_interrupt_event_terminal_latched = state->event_terminal;
+    crucible_interrupt_vmstate_free(state);
+}
+
+static const QemuCrucibleFaultVmstateSection
+crucible_interrupt_vmstate_section = {
+    .name = "interrupt",
+    .version = 1,
+    .save = crucible_interrupt_vmstate_save,
+    .prepare = crucible_interrupt_vmstate_prepare,
+    .commit = crucible_interrupt_vmstate_commit,
+    .free_staged = crucible_interrupt_vmstate_free,
+};
+
+static void crucible_interrupt_vmstate_register(void)
+{
+    qemu_crucible_fault_vmstate_register(
+        &crucible_interrupt_vmstate_section);
+}
+
+type_init(crucible_interrupt_vmstate_register)
