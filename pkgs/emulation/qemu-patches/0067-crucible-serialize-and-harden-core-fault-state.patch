+        crucible_fault_command_vmstate_free_completed(completed);
+    }
+    g_clear_pointer(&state->seen_sequences, g_hash_table_unref);
+    g_free(state);
+}
+
+static void crucible_fault_command_registry_hash(uint8_t digest[32])
+{
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    uint8_t scalar[8];
+    gsize digest_len = 32;
+
+    for (size_t i = 0; i < crucible_fault_handlers->len; i++) {
+        const QemuCrucibleFaultHandler *handler =
+            g_ptr_array_index(crucible_fault_handlers, i);
+        const struct qemu_plugin_crucible_fault_capability *capability =
+            &handler->capability;
+        size_t name_len = strlen(capability->name);
+        size_t schema_len = strlen(capability->payload_schema);
+
+        stw_be_p(scalar, capability->command_kind);
+        stw_be_p(scalar + 2, capability->scope);
+        stl_be_p(scalar + 4, capability->semantic_version);
+        g_checksum_update(checksum, scalar, sizeof(scalar));
+        stl_be_p(scalar, capability->phase_mask);
+        stl_be_p(scalar + 4, capability->maximum_payload_bytes);
+        g_checksum_update(checksum, scalar, sizeof(scalar));
+        stl_be_p(scalar, capability->maximum_pending_commands);
+        stl_be_p(scalar + 4, capability->required_feature_bits);
+        g_checksum_update(checksum, scalar, sizeof(scalar));
+        stl_be_p(scalar, name_len);
+        stl_be_p(scalar + 4, schema_len);
+        g_checksum_update(checksum, scalar, sizeof(scalar));
+        g_checksum_update(checksum, (const uint8_t *)capability->name,
+                          name_len);
+        g_checksum_update(checksum,
+                          (const uint8_t *)capability->payload_schema,
+                          schema_len);
+    }
+    g_checksum_get_digest(checksum, digest, &digest_len);
+    g_assert(digest_len == 32);
+}
+
+static gint crucible_fault_command_u64_compare(gconstpointer left,
+                                                gconstpointer right)
+{
+    uint64_t a = *(const uint64_t *)left;
+    uint64_t b = *(const uint64_t *)right;
+
+    return a == b ? 0 : (a < b ? -1 : 1);
+}
+
+static int crucible_fault_command_vmstate_save(GByteArray *payload)
+{
+    g_autoptr(GArray) seen = g_array_new(false, false, sizeof(uint64_t));
+    CruciblePendingFault *pending;
+    CrucibleCompletedFault *completed;
+    GHashTableIter iterator;
+    gpointer key;
+    uint8_t registry_hash[32];
+    uint8_t reserved[24] = { 0 };
+
+    qemu_crucible_fault_registry_seal();
+    g_mutex_lock(&crucible_fault_lock);
+    if (crucible_pending_count > CRUCIBLE_FAULT_RESULT_QUEUE_CAPACITY ||
+        crucible_completed_count > CRUCIBLE_FAULT_RESULT_QUEUE_CAPACITY ||
+        crucible_deferred_count > CRUCIBLE_FAULT_RESULT_QUEUE_CAPACITY ||
+        g_hash_table_size(crucible_seen_sequences) >
+            CRUCIBLE_FAULT_SEQUENCE_WINDOW) {
+        g_mutex_unlock(&crucible_fault_lock);
+        return -E2BIG;
+    }
+    crucible_fault_command_registry_hash(registry_hash);
+    g_byte_array_append(payload,
+                        (const uint8_t *)CRUCIBLE_COMMAND_VMSTATE_MAGIC, 8);
+    crucible_fault_vmstate_append_u32(
+        payload, CRUCIBLE_COMMAND_VMSTATE_VERSION);
+    crucible_fault_vmstate_append_u32(payload, 0);
+    crucible_fault_vmstate_append_u64(payload,
+                                      crucible_max_command_sequence);
+    crucible_fault_vmstate_append_u32(payload, crucible_pending_count);
+    crucible_fault_vmstate_append_u32(payload, crucible_completed_count);
+    crucible_fault_vmstate_append_u32(payload, crucible_deferred_count);
+    crucible_fault_vmstate_append_u32(
+        payload, g_hash_table_size(crucible_seen_sequences));
+    g_byte_array_append(payload, registry_hash, sizeof(registry_hash));
+    g_byte_array_append(payload, reserved, sizeof(reserved));
+    g_assert(payload->len == CRUCIBLE_COMMAND_VMSTATE_HEADER_BYTES);
+
+    QTAILQ_FOREACH(pending, &crucible_pending_faults, link) {
+        if (pending->payload_len > UINT32_MAX) {
+            g_mutex_unlock(&crucible_fault_lock);
+            return -E2BIG;
+        }
+        crucible_fault_vmstate_encode_command(payload, &pending->command);
+        crucible_fault_vmstate_append_u32(payload, pending->payload_len);
+        g_byte_array_append(payload, pending->payload, pending->payload_len);
+    }
+    QTAILQ_FOREACH(completed, &crucible_completed_faults, link) {
+        if (completed->payload->len > UINT32_MAX) {
+            g_mutex_unlock(&crucible_fault_lock);
+            return -E2BIG;
+        }
+        crucible_fault_vmstate_encode_result(payload, &completed->result);
+        crucible_fault_vmstate_append_u32(payload, completed->payload->len);
+        g_byte_array_append(payload, completed->payload->data,
+                            completed->payload->len);
+    }
+    g_hash_table_iter_init(&iterator, crucible_seen_sequences);
+    while (g_hash_table_iter_next(&iterator, &key, NULL)) {
+        uint64_t sequence = *(const uint64_t *)key;
+
+        g_array_append_val(seen, sequence);
+    }
+    g_array_sort(seen, crucible_fault_command_u64_compare);
+    for (size_t i = 0; i < seen->len; i++) {
+        crucible_fault_vmstate_append_u64(
+            payload, g_array_index(seen, uint64_t, i));
+    }
+    g_mutex_unlock(&crucible_fault_lock);
+    return 0;
+}
+
+static bool crucible_fault_command_vmstate_header_valid(
+    const uint8_t *payload, size_t payload_len, uint32_t *pending_count,
+    uint32_t *completed_count, uint32_t *deferred_count,
+    uint32_t *seen_count, uint64_t *max_sequence)
+{
+    uint8_t registry_hash[32];
+
+    if (payload_len < CRUCIBLE_COMMAND_VMSTATE_HEADER_BYTES ||
+        memcmp(payload, CRUCIBLE_COMMAND_VMSTATE_MAGIC, 8) != 0 ||
+        ldl_be_p(payload + 8) != CRUCIBLE_COMMAND_VMSTATE_VERSION ||
+        ldl_be_p(payload + 12) != 0 ||
+        memcmp(payload + 72, (uint8_t[24]) { 0 }, 24) != 0) {
+        return false;
+    }
+    *max_sequence = ldq_be_p(payload + 16);
+    *pending_count = ldl_be_p(payload + 24);
+    *completed_count = ldl_be_p(payload + 28);
+    *deferred_count = ldl_be_p(payload + 32);
+    *seen_count = ldl_be_p(payload + 36);
+    if (*pending_count > CRUCIBLE_FAULT_RESULT_QUEUE_CAPACITY ||
+        *completed_count > CRUCIBLE_FAULT_RESULT_QUEUE_CAPACITY ||
+        *deferred_count > CRUCIBLE_FAULT_RESULT_QUEUE_CAPACITY ||
+        *seen_count > CRUCIBLE_FAULT_SEQUENCE_WINDOW ||
+        (uint64_t)*pending_count + *completed_count + *deferred_count >
+            CRUCIBLE_FAULT_RESULT_QUEUE_CAPACITY) {
+        return false;
+    }
+    crucible_fault_command_registry_hash(registry_hash);
+    return memcmp(payload + 40, registry_hash, sizeof(registry_hash)) == 0;
+}
+
+static int crucible_fault_command_vmstate_prepare(
+    const uint8_t *payload, size_t payload_len, void **staged)
+{
+    CrucibleFaultCommandVmstate *state = g_new0(CrucibleFaultCommandVmstate, 1);
+    uint32_t pending_count;
+    uint32_t completed_count;
+    uint32_t deferred_count;
+    uint32_t seen_count;
+    uint64_t max_sequence;
+    uint64_t prior_sequence = 0;
+    CruciblePendingFault *prior_pending = NULL;
+    size_t offset = CRUCIBLE_COMMAND_VMSTATE_HEADER_BYTES;
+    int status = -EINVAL;
+
+    qemu_crucible_fault_registry_seal();
+    QTAILQ_INIT(&state->pending);
+    QTAILQ_INIT(&state->completed);
+    state->seen_sequences = g_hash_table_new_full(
+        g_int64_hash, g_int64_equal, g_free, NULL);
+    if (!crucible_fault_command_vmstate_header_valid(
+            payload, payload_len, &pending_count, &completed_count,
+            &deferred_count, &seen_count, &max_sequence)) {
+        goto fail;
+    }
+    for (uint32_t i = 0; i < pending_count; i++) {
+        CruciblePendingFault *pending = g_new0(CruciblePendingFault, 1);
+        const uint8_t *bytes;
+        uint32_t length;
+
+        if (!crucible_fault_vmstate_decode_command(
+                payload, payload_len, &offset, &pending->command) ||
+            !crucible_fault_vmstate_take(payload, payload_len, &offset, 4,
+                                         &bytes)) {
+            g_free(pending);
+            goto fail;
+        }
+        length = ldl_be_p(bytes);
+        if (length > CRUCIBLE_FAULT_HARD_PAYLOAD_BYTES ||
+            !crucible_fault_vmstate_take(payload, payload_len, &offset,
+                                         length, &bytes) ||
+            pending->command.abi_major != CRUCIBLE_FAULT_COMMAND_ABI_MAJOR ||
+            pending->command.abi_minor != CRUCIBLE_FAULT_COMMAND_ABI_MINOR ||
+            pending->command.reserved != 0 ||
+            pending->command.command_flags &
+                ~CRUCIBLE_FAULT_COMMAND_FLAG_PREPARE_ONLY ||
+            pending->command.command_sequence == 0 ||
+            pending->command.target_icount >
+                pending->command.authorization_ceiling_icount ||
+            pending->command.phase < CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY ||
+            pending->command.phase > CRUCIBLE_FAULT_PHASE_DEVICE) {
+            g_free(pending);
+            goto fail;
+        }
+        pending->handler = crucible_fault_find_handler(
+            pending->command.command_kind,
+            pending->command.semantic_version);
+        if (!pending->handler ||
+            !(pending->handler->capability.phase_mask &
+              (1U << (pending->command.phase - 1))) ||
+            length > pending->handler->capability.maximum_payload_bytes ||
+            (pending->handler->validate &&
+             pending->handler->validate(&pending->command, bytes, length))) {
+            g_free(pending);
+            goto fail;
+        }
+        pending->payload = g_memdup2(bytes, length);
+        pending->payload_len = length;
+        if (pending->handler->arm &&
+            pending->handler->arm(&pending->command, pending->payload,
+                                  length, &pending->handler_state)) {
+            crucible_fault_command_vmstate_free_pending(pending);
+            goto fail;
+        }
+        if (prior_pending &&
+            crucible_fault_pending_compare(prior_pending, pending) >= 0) {
+            crucible_fault_command_vmstate_free_pending(pending);
+            goto fail;
+        }
+        QTAILQ_INSERT_TAIL(&state->pending, pending, link);
+        prior_pending = pending;
+        state->pending_count++;
+    }
+    for (uint32_t i = 0; i < completed_count; i++) {
+        CrucibleCompletedFault *completed = g_new0(CrucibleCompletedFault, 1);
+        const uint8_t *bytes;
+        uint32_t length;
+
+        if (!crucible_fault_vmstate_decode_result(
+                payload, payload_len, &offset, &completed->result) ||
+            !crucible_fault_vmstate_take(payload, payload_len, &offset, 4,
+                                         &bytes)) {
+            g_free(completed);
+            goto fail;
+        }
+        length = ldl_be_p(bytes);
+        if (length > CRUCIBLE_FAULT_HARD_PAYLOAD_BYTES ||
+            !crucible_fault_vmstate_take(payload, payload_len, &offset,
+                                         length, &bytes) ||
+            completed->result.reserved != 0 ||
+            completed->result.command_sequence == 0 ||
+            completed->result.capability_version != 1) {
+            g_free(completed);
+            goto fail;
+        }
+        completed->payload = g_byte_array_sized_new(length);
+        g_byte_array_append(completed->payload, bytes, length);
+        QTAILQ_INSERT_TAIL(&state->completed, completed, link);
+        state->completed_count++;
+    }
+    for (uint32_t i = 0; i < seen_count; i++) {
+        const uint8_t *bytes;
+        guint64 *sequence;
+
+        if (!crucible_fault_vmstate_take(payload, payload_len, &offset, 8,
+                                         &bytes)) {
+            goto fail;
+        }
+        sequence = g_new(guint64, 1);
+        *sequence = ldq_be_p(bytes);
+        if (*sequence == 0 || *sequence > max_sequence ||
+            (i != 0 && *sequence <= prior_sequence) ||
+            max_sequence - *sequence >= CRUCIBLE_FAULT_SEQUENCE_WINDOW) {
+            g_free(sequence);
+            goto fail;
+        }
+        prior_sequence = *sequence;
+        g_hash_table_add(state->seen_sequences, sequence);
+    }
+    if (offset != payload_len ||
+        (seen_count != 0 && prior_sequence != max_sequence)) {
+        goto fail;
+    }
+    for (CruciblePendingFault *pending = QTAILQ_FIRST(&state->pending);
+         pending; pending = QTAILQ_NEXT(pending, link)) {
+        guint64 sequence = pending->command.command_sequence;
+
+        if (!g_hash_table_contains(state->seen_sequences, &sequence)) {
+            goto fail;
+        }
+    }
+    state->deferred_count = deferred_count;
+    state->max_command_sequence = max_sequence;
+    qemu_crucible_fault_vmstate_expect_deferred(deferred_count);
+    *staged = state;
+    return 0;
+
+fail:
+    crucible_fault_command_vmstate_free(state);
+    return status;
+}
+
+static void crucible_fault_command_vmstate_commit(void *opaque)
+{
+    CrucibleFaultCommandVmstate *state = opaque;
+    CruciblePendingFault *pending;
+    CrucibleCompletedFault *completed;
+
+    g_mutex_lock(&crucible_fault_lock);
+    while ((pending = QTAILQ_FIRST(&crucible_pending_faults))) {
+        QTAILQ_REMOVE(&crucible_pending_faults, pending, link);
+        crucible_fault_command_vmstate_free_pending(pending);
+    }
+    while ((completed = QTAILQ_FIRST(&crucible_completed_faults))) {
+        QTAILQ_REMOVE(&crucible_completed_faults, completed, link);
+        crucible_fault_command_vmstate_free_completed(completed);
+    }
+    while ((pending = QTAILQ_FIRST(&state->pending))) {
+        QTAILQ_REMOVE(&state->pending, pending, link);
+        QTAILQ_INSERT_TAIL(&crucible_pending_faults, pending, link);
+    }
+    while ((completed = QTAILQ_FIRST(&state->completed))) {
+        QTAILQ_REMOVE(&state->completed, completed, link);
+        QTAILQ_INSERT_TAIL(&crucible_completed_faults, completed, link);
+    }
+    g_hash_table_unref(crucible_seen_sequences);
+    crucible_seen_sequences = g_steal_pointer(&state->seen_sequences);
+    crucible_pending_count = state->pending_count;
+    crucible_completed_count = state->completed_count;
+    crucible_deferred_count = state->deferred_count;
+    crucible_max_command_sequence = state->max_command_sequence;
+    g_mutex_unlock(&crucible_fault_lock);
+    crucible_fault_command_vmstate_free(state);
+}
+
+static const QemuCrucibleFaultVmstateSection
+    crucible_fault_command_vmstate_section = {
+        .name = "command",
+        .version = CRUCIBLE_COMMAND_VMSTATE_VERSION,
+        .save = crucible_fault_command_vmstate_save,
+        .prepare = crucible_fault_command_vmstate_prepare,
+        .commit = crucible_fault_command_vmstate_commit,
+        .free_staged = crucible_fault_command_vmstate_free,
+    };
+
 static void crucible_fault_register_abi_handlers(void)
 {
     qemu_crucible_fault_register(&crucible_capability_query_handler);
     qemu_crucible_fault_register(&crucible_boundary_probe_handler);
+    qemu_crucible_fault_vmstate_register(
+        &crucible_fault_command_vmstate_section);
 }
 
 type_init(crucible_fault_register_abi_handlers)
