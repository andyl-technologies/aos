+    g_clear_pointer(&state->restored_impulses, g_ptr_array_unref);
+    g_clear_pointer(&state->restored_storms, g_ptr_array_unref);
+    g_clear_pointer(&state->restored_provenance, g_hash_table_unref);
+    g_free(state);
