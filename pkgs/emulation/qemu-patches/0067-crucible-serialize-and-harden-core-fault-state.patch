+static int crucible_hardware_vmstate_save(GByteArray *payload)
+{
+    g_autoptr(GPtrArray) sorted = g_ptr_array_new();
+    uint8_t identity[32];
+    uint32_t count = crucible_hardware_pending ?
+        crucible_hardware_pending->len : 0;
+
+    if (!crucible_hardware_vmstate_identity(identity) || count > 4096 ||
+        (crucible_hardware_terminal && count != 0)) {
+        return -EINVAL;
+    }
+    for (uint32_t i = 0; i < count; i++) {
+        CrucibleHardwarePending *pending = g_ptr_array_index(
+            crucible_hardware_pending, i);
+
+        if (!pending->cpu || !pending->reservation) {
+            return -EINVAL;
+        }
+        g_ptr_array_add(sorted, pending);
+    }
+    g_ptr_array_sort(sorted, crucible_hardware_vmstate_pending_compare);
+    qemu_crucible_fault_vmstate_put_bytes(payload, "CRUCHVS1", 8);
+    qemu_crucible_fault_vmstate_put_bytes(payload, identity, 32);
+    qemu_crucible_fault_vmstate_put_u32(payload, count);
+    qemu_crucible_fault_vmstate_put_u8(
+        payload, crucible_hardware_terminal);
+    qemu_crucible_fault_vmstate_put_u8(payload, 0);
+    qemu_crucible_fault_vmstate_put_u16(payload, 0);
+    for (uint32_t i = 0; i < count; i++) {
+        CrucibleHardwarePending *pending = g_ptr_array_index(sorted, i);
+        size_t remaining = qemu_crucible_fault_event_reservation_remaining(
+            pending->reservation);
+
+        if (remaining == 0 || remaining > UINT32_MAX ||
+            (i != 0 && ((CrucibleHardwarePending *)g_ptr_array_index(
+                sorted, i - 1))->cpu->cpu_index >= pending->cpu->cpu_index)) {
+            return -EINVAL;
+        }
+        qemu_crucible_fault_vmstate_put_u32(
+            payload, pending->cpu->cpu_index);
+        qemu_crucible_fault_vmstate_put_u32(payload, pending->row_index);
+        qemu_crucible_fault_vmstate_put_u16(
+            payload, pending->ghes_source_id);
+        qemu_crucible_fault_vmstate_put_u16(payload, 0);
+        qemu_crucible_fault_vmstate_put_u64(
+            payload, pending->command_icount);
+        qemu_crucible_fault_vmstate_put_u64(payload, pending->address);
+        qemu_crucible_fault_vmstate_put_u64(
+            payload, pending->ecc_syndrome);
+        qemu_crucible_fault_vmstate_put_u32(payload, remaining);
+        qemu_crucible_fault_vmstate_put_u32(payload, 0);
+        qemu_crucible_fault_vmstate_put_bytes(
+            payload, pending->before_hash, 32);
+        qemu_crucible_fault_vmstate_put_bytes(payload, pending->id, 32);
+        qemu_crucible_fault_vmstate_put_bytes(payload, pending->bank, 32);
+        qemu_crucible_fault_vmstate_put_bytes(payload, pending->channel, 32);
+        qemu_crucible_fault_vmstate_put_bytes(payload, pending->rank, 32);
+        qemu_crucible_fault_vmstate_put_bytes(payload, pending->firmware, 32);
+        qemu_crucible_fault_vmstate_put_bytes(payload, pending->state, 32);
+        qemu_crucible_fault_rule_vmstate_save(payload, pending->rule);
+        crucible_hardware_vmstate_put_exception(
+            payload, &pending->exception);
+        crucible_hardware_vmstate_put_cpu_state(
+            payload, &pending->before_cpu_state);
+        crucible_hardware_vmstate_put_cpu_state(
+            payload, &pending->queued_cpu_state);
+        crucible_hardware_vmstate_put_ghes_state(
+            payload, &pending->before_ghes_state);
+        crucible_hardware_vmstate_put_ghes_state(
+            payload, &pending->queued_ghes_state);
+    }
+    return 0;
+}
