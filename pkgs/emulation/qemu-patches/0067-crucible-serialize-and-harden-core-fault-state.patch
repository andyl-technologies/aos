+static void crucible_hardware_vmstate_free(void *opaque)
+{
+    CrucibleHardwareVmstate *state = opaque;
+
+    if (!state) {
+        return;
+    }
+    g_clear_pointer(&state->pending, g_ptr_array_unref);
+    g_free(state);
+}
