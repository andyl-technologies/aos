+static void crucible_hardware_vmstate_commit(void *opaque)
+{
+    CrucibleHardwareVmstate *state = opaque;
+
+    g_clear_pointer(&crucible_hardware_pending, g_ptr_array_unref);
+    crucible_hardware_pending = g_steal_pointer(&state->pending);
+    crucible_hardware_terminal = state->terminal;
+    crucible_hardware_vmstate_free(state);
+}
