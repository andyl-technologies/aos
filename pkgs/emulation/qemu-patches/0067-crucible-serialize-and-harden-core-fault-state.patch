+ */
+
+#include "qemu/osdep.h"
+#include "migration/qemu-file.h"
+#include "migration/register.h"
+#include "qapi/error.h"
+#include "qemu/bswap.h"
+#include "qemu/crucible-fault.h"
+#include "qemu/error-report.h"
+#include "qemu/module.h"
+#include "qemu/qemu-plugin.h"
+#include "qemu/units.h"
+#include "system/system.h"
+
+#define CRUCIBLE_FAULT_VMSTATE_MAGIC "CRUCFVM1"
+#define CRUCIBLE_FAULT_VMSTATE_VERSION 1
+#define CRUCIBLE_FAULT_VMSTATE_MAX_SECTIONS 10
+#define CRUCIBLE_FAULT_VMSTATE_MAX_NAME_BYTES 32
+#define CRUCIBLE_FAULT_VMSTATE_MAX_SECTION_BYTES (64 * MiB)
+#define CRUCIBLE_FAULT_VMSTATE_MAX_TOTAL_BYTES (256 * MiB)
+
+typedef struct CrucibleFaultVmstateStaged {
+    const QemuCrucibleFaultVmstateSection *section;
+    const uint8_t *payload;
+    size_t payload_len;
+    void *state;
+} CrucibleFaultVmstateStaged;
+
+static GPtrArray *crucible_fault_vmstate_sections;
+static bool crucible_fault_vmstate_enabled;
+static Notifier crucible_fault_vmstate_machine_done;
+static size_t crucible_fault_vmstate_expected_reservations;
+static size_t crucible_fault_vmstate_counted_reservations;
+static size_t crucible_fault_vmstate_expected_deferred;
+static size_t crucible_fault_vmstate_counted_deferred;
+static bool crucible_fault_vmstate_has_expected_reservations;
+static bool crucible_fault_vmstate_has_expected_deferred;
+
+static const char *const crucible_fault_vmstate_required[] = {
+    "command",
+    "cpu",
+    "hardware-error",
+    "interrupt",
+    "lifecycle",
+    "memory",
+    "node-rules",
+    "vcpu-service",
+};
+
+static int crucible_fault_vmstate_section_compare(gconstpointer left,
+                                                  gconstpointer right)
+{
+    const QemuCrucibleFaultVmstateSection *a = *(const void *const *)left;
+    const QemuCrucibleFaultVmstateSection *b = *(const void *const *)right;
+
+    return strcmp(a->name, b->name);
+}
+
+void qemu_crucible_fault_vmstate_register(
+    const QemuCrucibleFaultVmstateSection *section)
+{
+    g_assert(section && section->name && section->version != 0);
+    g_assert(section->save && section->prepare && section->commit &&
+             section->free_staged);
+    g_assert(strlen(section->name) <= CRUCIBLE_FAULT_VMSTATE_MAX_NAME_BYTES);
+    if (!crucible_fault_vmstate_sections) {
+        crucible_fault_vmstate_sections = g_ptr_array_new();
+    }
+    for (size_t i = 0; i < crucible_fault_vmstate_sections->len; i++) {
+        const QemuCrucibleFaultVmstateSection *existing =
+            g_ptr_array_index(crucible_fault_vmstate_sections, i);
+        g_assert(strcmp(existing->name, section->name) != 0);
+    }
+    g_ptr_array_add(crucible_fault_vmstate_sections, (void *)section);
+    g_ptr_array_sort(crucible_fault_vmstate_sections,
+                     crucible_fault_vmstate_section_compare);
+}
+
+void qemu_crucible_fault_vmstate_expect_reservations(size_t count)
+{
+    g_assert(!crucible_fault_vmstate_has_expected_reservations);
+    crucible_fault_vmstate_expected_reservations = count;
+    crucible_fault_vmstate_has_expected_reservations = true;
+}
+
+void qemu_crucible_fault_vmstate_count_reservations(size_t count)
+{
+    g_assert(crucible_fault_vmstate_counted_reservations <=
+             SIZE_MAX - count);
+    crucible_fault_vmstate_counted_reservations += count;
+}
+
+void qemu_crucible_fault_vmstate_expect_deferred(size_t count)
+{
+    g_assert(!crucible_fault_vmstate_has_expected_deferred);
+    crucible_fault_vmstate_expected_deferred = count;
+    crucible_fault_vmstate_has_expected_deferred = true;
+}
+
+void qemu_crucible_fault_vmstate_count_deferred(size_t count)
+{
+    g_assert(crucible_fault_vmstate_counted_deferred <= SIZE_MAX - count);
+    crucible_fault_vmstate_counted_deferred += count;
+}
+
+static int crucible_fault_vmstate_registry_validate(void)
+{
+    if (!crucible_fault_vmstate_sections ||
+        crucible_fault_vmstate_sections->len !=
+            G_N_ELEMENTS(crucible_fault_vmstate_required)) {
+        return -EINVAL;
+    }
+    for (size_t i = 0; i < G_N_ELEMENTS(crucible_fault_vmstate_required); i++) {
+        const QemuCrucibleFaultVmstateSection *section =
+            g_ptr_array_index(crucible_fault_vmstate_sections, i);
+        if (strcmp(section->name, crucible_fault_vmstate_required[i]) != 0) {
+            return -EINVAL;
+        }
+    }
+    return 0;
+}
+
+void qemu_crucible_fault_vmstate_put_u8(GByteArray *bytes, uint8_t value)
+{
