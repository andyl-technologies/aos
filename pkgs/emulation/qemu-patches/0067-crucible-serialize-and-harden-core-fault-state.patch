+static int crucible_memory_vmstate_retention_compare(gconstpointer left,
+                                                      gconstpointer right)
+{
+    const CrucibleMemoryVmstateRetention *a = left;
+    const CrucibleMemoryVmstateRetention *b = right;
+
+    return a->offset == b->offset ? 0 : (a->offset < b->offset ? -1 : 1);
+}
+
+static int crucible_memory_vmstate_row_compare(gconstpointer left,
+                                                gconstpointer right)
+{
+    const CrucibleMemoryVmstateRow *a = left;
+    const CrucibleMemoryVmstateRow *b = right;
+
+#define CMP(field) do { \
+    if (a->coordinate.field != b->coordinate.field) { \
+        return a->coordinate.field < b->coordinate.field ? -1 : 1; \
+    } \
+} while (0)
+    CMP(row);
+    CMP(channel);
+    CMP(rank);
+    CMP(bank);
+#undef CMP
+    return 0;
+}
+
+static int crucible_memory_vmstate_retry_compare(gconstpointer left,
+                                                  gconstpointer right)
+{
+    const CrucibleMemoryVmstateRetry *a = left;
+    const CrucibleMemoryVmstateRetry *b = right;
+
+#define CMP(field) do { \
+    if (a->key.field != b->key.field) { \
+        return a->key.field < b->key.field ? -1 : 1; \
+    } \
+} while (0)
+    CMP(address);
+    CMP(length);
+    CMP(observed_icount);
+    CMP(instruction_pc);
+    CMP(page_table_target_vaddr);
+    CMP(access_class);
+    CMP(actor);
+    CMP(instruction_ordinal);
+    CMP(page_table_level);
+    CMP(page_table_stage);
+    CMP(initiating_access_class);
+    CMP(has_instruction);
+    CMP(streaming);
+#undef CMP
+    return 0;
+}
