+
+static void crucible_fault_vmstate_sha256(const uint8_t *bytes, size_t len,
+                                          uint8_t digest[32])
+{
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    gsize digest_len = 32;
+
+    g_checksum_update(checksum, bytes, len);
+    g_checksum_get_digest(checksum, digest, &digest_len);
+    g_assert(digest_len == 32);
+}
+
+static int crucible_fault_vmstate_save_prepare(void *opaque, Error **errp)
+{
+    int status = crucible_fault_vmstate_registry_validate();
+
+    if (status != 0) {
+        error_setg(errp, "Crucible fault VMState registry is incomplete");
+    }
+    return status;
+}
+
+static void crucible_fault_vmstate_save(QEMUFile *file, void *opaque)
+{
+    g_autoptr(GByteArray) encoded = g_byte_array_new();
+    uint8_t digest[32];
+    int status;
+
+    g_byte_array_append(encoded,
+                        (const uint8_t *)CRUCIBLE_FAULT_VMSTATE_MAGIC, 8);
+    qemu_crucible_fault_vmstate_put_u32(encoded,
+                                        CRUCIBLE_FAULT_VMSTATE_VERSION);
+    qemu_crucible_fault_vmstate_put_u32(
+        encoded, crucible_fault_vmstate_sections->len);
+    for (size_t i = 0; i < crucible_fault_vmstate_sections->len; i++) {
+        const QemuCrucibleFaultVmstateSection *section =
+            g_ptr_array_index(crucible_fault_vmstate_sections, i);
+        g_autoptr(GByteArray) payload = g_byte_array_new();
+        size_t name_len = strlen(section->name);
+
+        status = section->save(payload);
+        if (status != 0 ||
+            payload->len > CRUCIBLE_FAULT_VMSTATE_MAX_SECTION_BYTES ||
+            name_len > CRUCIBLE_FAULT_VMSTATE_MAX_NAME_BYTES ||
+            encoded->len > CRUCIBLE_FAULT_VMSTATE_MAX_TOTAL_BYTES - 16 ||
+            encoded->len + 16 >
+                CRUCIBLE_FAULT_VMSTATE_MAX_TOTAL_BYTES - name_len ||
+            encoded->len + 16 + name_len >
+                CRUCIBLE_FAULT_VMSTATE_MAX_TOTAL_BYTES - payload->len) {
+            qemu_file_set_error(file, status != 0 ? status : -E2BIG);
+            return;
+        }
+        qemu_crucible_fault_vmstate_put_u16(encoded, name_len);
+        qemu_crucible_fault_vmstate_put_u16(encoded, 0);
+        qemu_crucible_fault_vmstate_put_u32(encoded, section->version);
+        qemu_crucible_fault_vmstate_put_u64(encoded, payload->len);
+        g_byte_array_append(encoded, (const uint8_t *)section->name, name_len);
+        g_byte_array_append(encoded, payload->data, payload->len);
+    }
+    if (encoded->len > CRUCIBLE_FAULT_VMSTATE_MAX_TOTAL_BYTES) {
+        qemu_file_set_error(file, -E2BIG);
+        return;
+    }
+    crucible_fault_vmstate_sha256(encoded->data, encoded->len, digest);
+    qemu_put_be64(file, encoded->len);
+    qemu_put_buffer(file, encoded->data, encoded->len);
+    qemu_put_buffer(file, digest, sizeof(digest));
+}
+
+static const QemuCrucibleFaultVmstateSection *
+crucible_fault_vmstate_find(const uint8_t *name, size_t name_len)
+{
+    for (size_t i = 0; i < crucible_fault_vmstate_sections->len; i++) {
+        const QemuCrucibleFaultVmstateSection *section =
+            g_ptr_array_index(crucible_fault_vmstate_sections, i);
+
+        if (strlen(section->name) == name_len &&
+            memcmp(section->name, name, name_len) == 0) {
+            return section;
+        }
+    }
+    return NULL;
+}
+
+static int crucible_fault_vmstate_load(QEMUFile *file, void *opaque,
+                                       int version_id)
+{
+    g_autofree uint8_t *encoded = NULL;
+    g_autoptr(GArray) staged = g_array_new(false, true,
+                                           sizeof(CrucibleFaultVmstateStaged));
+    bool seen[CRUCIBLE_FAULT_VMSTATE_MAX_SECTIONS] = { false };
+    uint8_t expected_digest[32];
+    uint8_t actual_digest[32];
+    uint64_t encoded_len;
+    size_t offset = 0;
+    uint32_t count;
+    int status = -EINVAL;
+
+    crucible_fault_vmstate_expected_reservations = 0;
+    crucible_fault_vmstate_counted_reservations = 0;
+    crucible_fault_vmstate_expected_deferred = 0;
+    crucible_fault_vmstate_counted_deferred = 0;
+    crucible_fault_vmstate_has_expected_reservations = false;
+    crucible_fault_vmstate_has_expected_deferred = false;
+
+    if (version_id != 1 || crucible_fault_vmstate_registry_validate() != 0) {
+        return -EINVAL;
+    }
+    encoded_len = qemu_get_be64(file);
+    if (encoded_len < 16 ||
+        encoded_len > CRUCIBLE_FAULT_VMSTATE_MAX_TOTAL_BYTES) {
+        return -E2BIG;
+    }
+    encoded = g_malloc(encoded_len);
+    if (qemu_get_buffer(file, encoded, encoded_len) != encoded_len ||
+        qemu_get_buffer(file, expected_digest, sizeof(expected_digest)) !=
+            sizeof(expected_digest)) {
+        return -EIO;
+    }
+    crucible_fault_vmstate_sha256(encoded, encoded_len, actual_digest);
+    if (memcmp(expected_digest, actual_digest, sizeof(actual_digest)) != 0 ||
+        memcmp(encoded, CRUCIBLE_FAULT_VMSTATE_MAGIC, 8) != 0 ||
+        ldl_be_p(encoded + 8) != CRUCIBLE_FAULT_VMSTATE_VERSION) {
+        return -EINVAL;
+    }
+    count = ldl_be_p(encoded + 12);
+    offset = 16;
+    if (count != crucible_fault_vmstate_sections->len) {
+        return -EINVAL;
+    }
+    for (uint32_t i = 0; i < count; i++) {
+        const QemuCrucibleFaultVmstateSection *section;
+        CrucibleFaultVmstateStaged item = { 0 };
+        uint16_t name_len;
+        uint32_t section_version;
+        uint64_t payload_len;
+        size_t section_index;
+
+        if (offset > encoded_len || encoded_len - offset < 16) {
+            goto cleanup;
+        }
+        name_len = lduw_be_p(encoded + offset);
+        if (lduw_be_p(encoded + offset + 2) != 0) {
+            goto cleanup;
+        }
+        section_version = ldl_be_p(encoded + offset + 4);
+        payload_len = ldq_be_p(encoded + offset + 8);
+        offset += 16;
+        if (name_len == 0 || name_len > CRUCIBLE_FAULT_VMSTATE_MAX_NAME_BYTES ||
+            payload_len > CRUCIBLE_FAULT_VMSTATE_MAX_SECTION_BYTES ||
+            offset > encoded_len || encoded_len - offset < name_len ||
+            encoded_len - offset - name_len < payload_len) {
+            goto cleanup;
+        }
+        section = crucible_fault_vmstate_find(encoded + offset, name_len);
+        if (!section || section->version != section_version) {
+            goto cleanup;
+        }
+        section_index = 0;
+        while (g_ptr_array_index(crucible_fault_vmstate_sections,
+                                 section_index) != section) {
+            section_index++;
+        }
+        if (seen[section_index] || section_index != i) {
+            goto cleanup;
+        }
+        seen[section_index] = true;
+        offset += name_len;
+        item.section = section;
+        item.payload = encoded + offset;
+        item.payload_len = payload_len;
+        g_array_append_val(staged, item);
+        offset += payload_len;
+    }
+    if (offset != encoded_len) {
+        status = -EINVAL;
+        goto cleanup;
+    }
+    for (size_t pass = 0; pass < 2; pass++) {
+        for (size_t i = 0; i < staged->len; i++) {
+            CrucibleFaultVmstateStaged *item = &g_array_index(
+                staged, CrucibleFaultVmstateStaged, i);
+            bool node_rules = strcmp(item->section->name, "node-rules") == 0;
+
+            if (node_rules != (pass == 0)) {
+                continue;
+            }
+            status = item->section->prepare(item->payload, item->payload_len,
+                                            &item->state);
+            if (status != 0) {
+                goto cleanup;
+            }
+        }
+    }
+    if (!crucible_fault_vmstate_has_expected_reservations ||
+        !crucible_fault_vmstate_has_expected_deferred ||
+        crucible_fault_vmstate_expected_reservations !=
+            crucible_fault_vmstate_counted_reservations ||
+        crucible_fault_vmstate_expected_deferred !=
+            crucible_fault_vmstate_counted_deferred) {
+        status = -EINVAL;
+        goto cleanup;
+    }
+    qemu_crucible_fault_vmstate_restoring(true);
+    for (size_t pass = 0; pass < 3; pass++) {
+        for (size_t i = 0; i < staged->len; i++) {
+            CrucibleFaultVmstateStaged *item = &g_array_index(
+                staged, CrucibleFaultVmstateStaged, i);
+            bool node_rules = strcmp(item->section->name, "node-rules") == 0;
+            bool command = strcmp(item->section->name, "command") == 0;
+
+            if ((pass == 0 && !node_rules) ||
+                (pass == 1 && (node_rules || command)) ||
+                (pass == 2 && !command)) {
+                continue;
+            }
+            item->section->commit(item->state);
+            item->state = NULL;
+        }
+    }
+    qemu_crucible_fault_vmstate_restoring(false);
+    status = 0;
+
+cleanup:
+    for (size_t i = 0; i < staged->len; i++) {
+        CrucibleFaultVmstateStaged *item = &g_array_index(
+            staged, CrucibleFaultVmstateStaged, i);
+        if (item->state) {
+            item->section->free_staged(item->state);
+        }
+    }
+    return status;
+}
+
+static bool crucible_fault_vmstate_active(void *opaque)
+{
+    return qemu_plugin_crucible_single_threaded_rr() &&
+        qemu_crucible_fault_lifecycle_process_bound();
+}
+
+static const SaveVMHandlers crucible_fault_vmstate_handlers = {
+    .save_prepare = crucible_fault_vmstate_save_prepare,
+    .save_state = crucible_fault_vmstate_save,
+    .load_state = crucible_fault_vmstate_load,
+    .is_active = crucible_fault_vmstate_active,
+};
+
+static void crucible_fault_vmstate_machine_done_notify(
+    Notifier *notifier, void *opaque)
+{
+    int status;
+
+    (void)notifier;
+    (void)opaque;
+    status = register_savevm_live("crucible-fault", 0, 1,
+                                  &crucible_fault_vmstate_handlers, NULL);
+    if (status != 0) {
+        error_report("Crucible fault VMState registration failed: %d",
+                     status);
+        abort();
+    }
+}
+
+int qemu_crucible_fault_vmstate_enable(void)
+{
+    if (crucible_fault_vmstate_enabled) {
+        return -EALREADY;
+    }
+    crucible_fault_vmstate_machine_done.notify =
+        crucible_fault_vmstate_machine_done_notify;
+    qemu_add_machine_init_done_notifier(
+        &crucible_fault_vmstate_machine_done);
+    crucible_fault_vmstate_enabled = true;
+    return 0;
+}
