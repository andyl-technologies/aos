+/*
+ * Linear owner of one exact retained template barrier across fork().
+ *
+ * The source-process terminal action verifies but does not release the
+ * reusable template barrier.  The immediate-child terminal action verifies
+ * the copied generation and releases it before reconstructed event-loop work
+ * is allowed to run.  Only one transaction may be active in each process
+ * incarnation.
+ */
+typedef struct QemuBhTimerHotForkRetainedTransaction {
+    uint64_t barrier_generation;
+    int64_t barrier_owner_thread_id;
+    int64_t parent_process_id;
+    int64_t parent_thread_id;
+    bool active;
+    bool child_released;
+} QemuBhTimerHotForkRetainedTransaction;
+
 /*
  * Gate AioContext polling and dispatch, AioHandler lifecycle and callbacks,
