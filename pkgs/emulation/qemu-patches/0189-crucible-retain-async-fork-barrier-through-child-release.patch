+int qemu_bh_timer_hot_fork_begin_retained_transaction(
+    QemuBhTimerHotForkRetainedTransaction *transaction,
+    uint64_t expected_barrier_generation)
+{
+    QemuBhTimerHotForkBarrierInventory inventory;
+    int64_t thread_id = qemu_get_thread_id();
+
+    if (!transaction || transaction->active || transaction->child_released ||
+        expected_barrier_generation == 0 ||
+        expected_barrier_generation == UINT64_MAX || getpid() <= 1 ||
+        thread_id <= 0 || crucible_hot_fork_bh_timer_admission_depth != 0 ||
+        qatomic_cmpxchg(&crucible_hot_fork_bh_timer_transaction_active,
+                        0, 1) != 0) {
+        return -EINVAL;
+    }
+
+    qemu_bh_timer_hot_fork_barrier(
+        QEMU_BH_TIMER_HOT_FORK_BARRIER_QUERY, &inventory);
+    if (!inventory.held || !inventory.quiescent ||
+        inventory.generation != expected_barrier_generation ||
+        inventory.owner_thread_id <= 0) {
+        qatomic_set(&crucible_hot_fork_bh_timer_transaction_active, 0);
+        return -EBUSY;
+    }
+
+    *transaction = (QemuBhTimerHotForkRetainedTransaction) {
+        .barrier_generation = inventory.generation,
+        .barrier_owner_thread_id = inventory.owner_thread_id,
+        .parent_process_id = getpid(),
+        .parent_thread_id = thread_id,
+        .active = true,
+    };
+    return 0;
+}
+
+int qemu_bh_timer_hot_fork_release_parent_retained_transaction(
+    QemuBhTimerHotForkRetainedTransaction *transaction)
+{
+    QemuBhTimerHotForkBarrierInventory inventory;
+
+    if (!transaction || !transaction->active || transaction->child_released ||
+        transaction->parent_process_id != getpid() ||
+        transaction->parent_thread_id != qemu_get_thread_id() ||
+        !qatomic_read(&crucible_hot_fork_bh_timer_transaction_active)) {
+        return -EPERM;
+    }
+
+    qemu_bh_timer_hot_fork_barrier(
+        QEMU_BH_TIMER_HOT_FORK_BARRIER_QUERY, &inventory);
+    if (!inventory.held || !inventory.quiescent ||
+        inventory.generation != transaction->barrier_generation ||
+        inventory.owner_thread_id != transaction->barrier_owner_thread_id) {
+        return -EPERM;
+    }
+
+    transaction->active = false;
+    qatomic_set(&crucible_hot_fork_bh_timer_transaction_active, 0);
+    return 0;
+}
+
+int qemu_bh_timer_hot_fork_release_child_retained_transaction(
+    QemuBhTimerHotForkRetainedTransaction *transaction)
+{
+    QemuBhTimerHotForkBarrierInventory inventory;
+    uint64_t released_generation;
+
+    if (!transaction || !transaction->active || transaction->child_released ||
+        transaction->parent_process_id <= 1 ||
+        transaction->parent_process_id == getpid() ||
+        qemu_get_thread_id() != getpid() ||
+        !qatomic_read(&crucible_hot_fork_bh_timer_transaction_active)) {
+        return -EPERM;
+    }
+
+    qemu_bh_timer_hot_fork_barrier(
+        QEMU_BH_TIMER_HOT_FORK_BARRIER_QUERY, &inventory);
+    if (!inventory.held || !inventory.quiescent ||
+        inventory.generation != transaction->barrier_generation ||
+        inventory.owner_thread_id != transaction->barrier_owner_thread_id) {
+        return -EPERM;
+    }
+
+    released_generation = transaction->barrier_generation + 1;
+    qemu_bh_timer_hot_fork_barrier(
+        QEMU_BH_TIMER_HOT_FORK_BARRIER_RELEASE, &inventory);
+    transaction->active = false;
+    transaction->child_released = true;
+    qatomic_set(&crucible_hot_fork_bh_timer_transaction_active, 0);
+    if (inventory.held || inventory.owner_thread_id != 0 ||
+        inventory.generation != released_generation) {
+        return -EPROTO;
+    }
+    return 0;
+}
+
 /* Called concurrently from any thread */
 static void aio_bh_enqueue(QEMUBH *bh, unsigned new_flags)
 {
