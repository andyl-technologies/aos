+static int crucible_register_cursor(const CrucibleRegisterApply *apply,
+                                    uint16_t model_phase,
+                                    struct qemu_plugin_rr_cursor *rr)
+{
+    CPUState *next_cpu;
+
+    if (model_phase != QEMU_CRUCIBLE_MODEL_PHASE_AFTER_INSTRUCTION) {
+        return qemu_plugin_rr_cursor(rr);
+    }
+
+    rr->current_vcpu = qemu_plugin_crucible_rr_current_vcpu();
+    rr->cursor_position = qemu_plugin_crucible_rr_cursor_position();
+    rr->rr_switch_quantum = qemu_plugin_crucible_rr_switch_quantum();
+    if (rr->current_vcpu != apply->cpu->cpu_index ||
+        rr->rr_switch_quantum == 0 ||
+        rr->cursor_position > rr->rr_switch_quantum) {
+        return -1;
+    }
+
+    /*
+     * The live cursor counts the prefix retired before the current plugin
+     * callback.  An after-instruction mutation belongs to the following
+     * coordinate, including the canonical handoff at a quantum terminal.
+     */
+    if (rr->cursor_position < rr->rr_switch_quantum) {
+        rr->cursor_position++;
+    }
+    if (rr->cursor_position != rr->rr_switch_quantum) {
+        return 0;
+    }
+
+    next_cpu = CPU_NEXT(apply->cpu);
+    if (!next_cpu) {
+        next_cpu = first_cpu;
+    }
+    if (!next_cpu) {
+        return -1;
+    }
+    rr->current_vcpu = next_cpu->cpu_index;
+    rr->cursor_position = 0;
+    return 0;
+}
