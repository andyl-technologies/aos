+static CrucibleHotForkBhTimerBarrierState *
+crucible_hot_fork_bh_timer_barrier(
+    QemuBhTimerHotForkBarrierOperation operation)
+{
+    CrucibleHotForkBhTimerBarrierState *report =
+        g_new0(CrucibleHotForkBhTimerBarrierState, 1);
+    QemuBhTimerHotForkBarrierInventory inventory;
+
+    qemu_bh_timer_hot_fork_barrier(operation, &inventory);
+    report->schema_version = 1;
+    report->generation = inventory.generation;
+    report->owner_thread_id = inventory.owner_thread_id;
+    report->held = inventory.held;
+    report->complete = inventory.complete;
+    report->bottom_halves_complete = inventory.bottom_halves_complete;
+    report->timers_complete = inventory.timers_complete;
+    report->admissions_in_flight = inventory.admissions_in_flight;
+    report->bottom_half_count = inventory.bottom_half_count;
+    report->pending_bottom_halves = inventory.pending_bottom_halves;
+    report->scheduled_bottom_halves = inventory.scheduled_bottom_halves;
+    report->active_bottom_half_callbacks =
+        inventory.active_bottom_half_callbacks;
+    report->pending_timers = inventory.pending_timers;
+    report->active_timer_callbacks = inventory.active_timer_callbacks;
+    report->quiescent = inventory.quiescent;
+    return report;
+}
