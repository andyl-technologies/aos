+#ifndef QEMU_CRUCIBLE_HOT_FORK_ASYNC_H
+#define QEMU_CRUCIBLE_HOT_FORK_ASYNC_H
+
+typedef enum QemuBhTimerHotForkBarrierOperation {
+    QEMU_BH_TIMER_HOT_FORK_BARRIER_HOLD,
+    QEMU_BH_TIMER_HOT_FORK_BARRIER_QUERY,
+    QEMU_BH_TIMER_HOT_FORK_BARRIER_RELEASE,
+} QemuBhTimerHotForkBarrierOperation;
+
+typedef struct QemuBhTimerHotForkBarrierInventory {
+    uint64_t generation;
+    int64_t owner_thread_id;
+    uint64_t admissions_in_flight;
+    uint64_t bottom_half_count;
+    uint64_t pending_bottom_halves;
+    uint64_t scheduled_bottom_halves;
+    uint64_t active_bottom_half_callbacks;
+    uint64_t pending_timers;
+    uint64_t active_timer_callbacks;
+    bool held;
+    bool bottom_halves_complete;
+    bool timers_complete;
+    bool complete;
+    bool quiescent;
+} QemuBhTimerHotForkBarrierInventory;
+
+/*
+ * Gate bottom-half and timer-source mutation while a hot-fork transaction is
+ * retained.  Blocking admission is for producers; try admission is for event
+ * loop dispatch, which parks already-queued work rather than blocking QMP.
+ * Nested work remains inside the outer admission that caused it.
+ */
+void qemu_bh_timer_hot_fork_admission_begin(void);
+bool qemu_bh_timer_hot_fork_admission_try_begin(void);
+void qemu_bh_timer_hot_fork_admission_end(void);
+void qemu_bh_timer_hot_fork_barrier(
+    QemuBhTimerHotForkBarrierOperation operation,
+    QemuBhTimerHotForkBarrierInventory *inventory);
+
+#endif
