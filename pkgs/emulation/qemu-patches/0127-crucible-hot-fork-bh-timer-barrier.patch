 static void __attribute__((__constructor__))
 crucible_hot_fork_aio_inventory_init(void)
 {
     qemu_mutex_init(&crucible_hot_fork_aio_lock);
+    qemu_mutex_init(&crucible_hot_fork_bh_timer_barrier_lock);
+    qemu_event_init(&crucible_hot_fork_bh_timer_barrier_release, true);
+}
+
+bool qemu_bh_timer_hot_fork_admission_try_begin(void)
+{
+    int held;
+
+    if (crucible_hot_fork_bh_timer_admission_depth != 0) {
+        assert(crucible_hot_fork_bh_timer_admission_depth != UINT32_MAX);
+        crucible_hot_fork_bh_timer_admission_depth++;
+        return true;
+    }
+
+    held = qatomic_read(&crucible_hot_fork_bh_timer_barrier_held);
+    if (held) {
+        return false;
+    }
+
+    qatomic_inc(&crucible_hot_fork_bh_timer_admissions);
+    smp_mb_global();
+    held = qatomic_read(&crucible_hot_fork_bh_timer_barrier_held);
+    if (held) {
+        qatomic_dec(&crucible_hot_fork_bh_timer_admissions);
+        return false;
+    }
+
+    crucible_hot_fork_bh_timer_admission_depth = 1;
+    return true;
+}
+
+void qemu_bh_timer_hot_fork_admission_begin(void)
+{
+    while (!qemu_bh_timer_hot_fork_admission_try_begin()) {
+        qemu_event_wait(&crucible_hot_fork_bh_timer_barrier_release);
+    }
+}
+
+void qemu_bh_timer_hot_fork_admission_end(void)
+{
+    assert(crucible_hot_fork_bh_timer_admission_depth != 0);
+    crucible_hot_fork_bh_timer_admission_depth--;
+    if (crucible_hot_fork_bh_timer_admission_depth == 0) {
+        smp_mb_global();
+        qatomic_dec(&crucible_hot_fork_bh_timer_admissions);
+    }
 }
 
