+CrucibleHotForkBhTimerBarrierState *
+qmp_crucible_hot_fork_bh_timer_barrier(
+    CrucibleHotForkBhTimerBarrierAction action, Error **errp)
+{
+    CrucibleHotForkBhTimerBarrierState *report = NULL;
+    QemuBhTimerHotForkBarrierOperation operation;
+
+    g_mutex_lock(&crucible_hot_fork_template_lock);
+    switch (action) {
+    case CRUCIBLE_HOT_FORK_BH_TIMER_BARRIER_ACTION_HOLD:
+        if (crucible_hot_fork_template_active) {
+            error_setg(errp, "Crucible hot-fork template transaction owns "
+                       "the bottom-half/timer barrier");
+            goto out;
+        }
+        if (!crucible_hot_fork_exact_paused_boundary()) {
+            error_setg(errp, "Crucible hot-fork bottom-half/timer barrier "
+                       "requires an exact paused/device-flush boundary");
+            goto out;
+        }
+        operation = QEMU_BH_TIMER_HOT_FORK_BARRIER_HOLD;
+        break;
+    case CRUCIBLE_HOT_FORK_BH_TIMER_BARRIER_ACTION_QUERY:
+        operation = QEMU_BH_TIMER_HOT_FORK_BARRIER_QUERY;
+        break;
+    case CRUCIBLE_HOT_FORK_BH_TIMER_BARRIER_ACTION_RELEASE:
+        if (crucible_hot_fork_template_active) {
+            error_setg(errp, "Crucible hot-fork template transaction owns "
+                       "the bottom-half/timer barrier");
+            goto out;
+        }
+        operation = QEMU_BH_TIMER_HOT_FORK_BARRIER_RELEASE;
+        break;
+    default:
+        error_setg(errp, "Unknown Crucible hot-fork bottom-half/timer "
+                   "barrier action");
+        goto out;
+    }
+
+    report = crucible_hot_fork_bh_timer_barrier(operation);
+out:
+    g_mutex_unlock(&crucible_hot_fork_template_lock);
+    return report;
+}
