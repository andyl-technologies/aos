+##
+# @CrucibleHotForkBhTimerBarrierAction:
+#
+# Operation over QEMU's reversible bottom-half and timer-source barrier.
+#
+# @hold: park new producers and callback dispatch while already-admitted work
+#     drains
+#
+# @query: observe the barrier without changing it
+#
+# @release: reopen source admission and wake parked producers
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'enum': 'CrucibleHotForkBhTimerBarrierAction',
+  'data': [ 'hold', 'query', 'release' ] }
+
+##
+# @CrucibleHotForkBhTimerBarrierState:
+#
+# Exact retained state of the bottom-half and timer-source barrier. Pending
+# bottom halves and timers are inherited parked work and need not be empty.
+#
+# @schema-version: barrier contract version, currently 1
+#
+# @generation: process-local hold/release generation
+#
+# @owner-thread-id: coordinator thread that acquired the barrier, or zero when
+#     released
+#
+# @held: whether producer admission and callback dispatch are parked
+#
+# @complete: whether both bounded source inventories were complete
+#
+# @bottom-halves-complete: whether the bottom-half inventory was stable and
+#     complete
+#
+# @timers-complete: whether the live-timer inventory was complete
+#
+# @admissions-in-flight: outer source operations admitted before the hold
+#
+# @bottom-half-count: exact allocated bottom-half count
+#
+# @pending-bottom-halves: exact queued bottom-half count
+#
+# @scheduled-bottom-halves: exact queued callback count
+#
+# @active-bottom-half-callbacks: exact executing bottom-half callback count
+#
+# @pending-timers: exact armed timer count
+#
+# @active-timer-callbacks: exact executing timer callback count
+#
+# @quiescent: whether a complete held barrier has no admitted source operation
+#     or executing callback; pending work remains parked
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'struct': 'CrucibleHotForkBhTimerBarrierState',
+  'data': { 'schema-version': 'uint32',
+            'generation': 'uint64',
+            'owner-thread-id': 'int64',
+            'held': 'bool',
+            'complete': 'bool',
+            'bottom-halves-complete': 'bool',
+            'timers-complete': 'bool',
+            'admissions-in-flight': 'uint64',
+            'bottom-half-count': 'uint64',
+            'pending-bottom-halves': 'uint64',
+            'scheduled-bottom-halves': 'uint64',
+            'active-bottom-half-callbacks': 'uint64',
+            'pending-timers': 'uint64',
+            'active-timer-callbacks': 'uint64',
+            'quiescent': 'bool' } }
+
+##
+# @crucible-hot-fork-bh-timer-barrier:
+#
+# Holds, observes, or releases the reversible bottom-half and timer-source
+# barrier. The command returns without waiting for already-admitted work.
+#
+# @action: requested barrier operation
+#
+# Returns: @CrucibleHotForkBhTimerBarrierState
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'command': 'crucible-hot-fork-bh-timer-barrier',
+  'data': { 'action': 'CrucibleHotForkBhTimerBarrierAction' },
+  'returns': 'CrucibleHotForkBhTimerBarrierState',
+  'allow-oob': true }
+
