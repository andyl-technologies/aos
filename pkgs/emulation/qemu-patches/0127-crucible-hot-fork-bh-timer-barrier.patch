     g_assert(!aio_poll(ctx, false));
 }
 
+static void test_hot_fork_bh_timer_barrier(void)
+{
+    BHTestData bh_data = { .n = 0, .max = 1 };
+    TimerTestData timer_data = {
+        .clock_type = QEMU_CLOCK_REALTIME,
+        .max = 1,
+        .ns = 1,
+        .ctx = ctx,
+    };
+    QemuBhTimerHotForkBarrierInventory barrier;
+
+    bh_data.bh = aio_bh_new(ctx, bh_test_cb, &bh_data);
+    aio_timer_init(ctx, &timer_data.timer, timer_data.clock_type,
+                   SCALE_NS, timer_test_cb, &timer_data);
+
+    /* An admitted callback may finish and park its final source mutations. */
+    qemu_bh_timer_hot_fork_admission_begin();
+    qemu_bh_timer_hot_fork_barrier(QEMU_BH_TIMER_HOT_FORK_BARRIER_HOLD,
+                                   &barrier);
+    g_assert_true(barrier.held);
+    g_assert_cmpuint(barrier.admissions_in_flight, ==, 1);
+    g_assert_false(barrier.quiescent);
+
+    qemu_bh_schedule(bh_data.bh);
+    timer_mod_ns(&timer_data.timer,
+                 qemu_clock_get_ns(timer_data.clock_type));
+    qemu_bh_timer_hot_fork_admission_end();
+
+    qemu_bh_timer_hot_fork_barrier(QEMU_BH_TIMER_HOT_FORK_BARRIER_QUERY,
+                                   &barrier);
+    g_assert_true(barrier.complete);
+    g_assert_true(barrier.quiescent);
+    g_assert_cmpuint(barrier.admissions_in_flight, ==, 0);
+    g_assert_cmpuint(barrier.pending_bottom_halves, >=, 1);
+    g_assert_cmpuint(barrier.pending_timers, >=, 1);
+
+    /* Dispatch declines admission while both queued sources remain parked. */
+    g_assert_false(qemu_bh_timer_hot_fork_admission_try_begin());
+    aio_poll(ctx, false);
+    g_assert_cmpint(bh_data.n, ==, 0);
+    g_assert_cmpint(timer_data.n, ==, 0);
+
+    qemu_bh_timer_hot_fork_barrier(QEMU_BH_TIMER_HOT_FORK_BARRIER_RELEASE,
+                                   &barrier);
+    g_assert_false(barrier.held);
+    g_assert_false(barrier.quiescent);
+    g_assert_cmpint(barrier.owner_thread_id, ==, 0);
+
+    aio_poll(ctx, false);
+    g_assert_cmpint(bh_data.n, ==, 1);
+    g_assert_cmpint(timer_data.n, ==, 1);
+
+    qemu_bh_delete(bh_data.bh);
+    aio_poll(ctx, false);
+    timer_del(&timer_data.timer);
+    timer_deinit(&timer_data.timer);
+}
