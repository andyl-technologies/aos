+void qemu_bh_timer_hot_fork_barrier(
+    QemuBhTimerHotForkBarrierOperation operation,
+    QemuBhTimerHotForkBarrierInventory *inventory)
+{
+    QemuBhHotForkInventory bottom_halves;
+#ifdef CONFIG_POSIX
+    QemuTimerHotForkInventory timers;
+#endif
+    size_t index;
+
+    *inventory = (QemuBhTimerHotForkBarrierInventory) { 0 };
+    qemu_mutex_lock(&crucible_hot_fork_bh_timer_barrier_lock);
+    switch (operation) {
+    case QEMU_BH_TIMER_HOT_FORK_BARRIER_HOLD:
+        if (!qatomic_read(&crucible_hot_fork_bh_timer_barrier_held)) {
+            qemu_event_reset(&crucible_hot_fork_bh_timer_barrier_release);
+            qatomic_set(&crucible_hot_fork_bh_timer_barrier_owner,
+                        qemu_get_thread_id());
+            smp_mb_global();
+            qatomic_set(&crucible_hot_fork_bh_timer_barrier_held, 1);
+            crucible_hot_fork_bh_timer_barrier_generation++;
+            assert(crucible_hot_fork_bh_timer_barrier_generation != 0);
+        }
+        break;
+    case QEMU_BH_TIMER_HOT_FORK_BARRIER_QUERY:
+        break;
+    case QEMU_BH_TIMER_HOT_FORK_BARRIER_RELEASE:
+        if (qatomic_read(&crucible_hot_fork_bh_timer_barrier_held)) {
+            qatomic_set(&crucible_hot_fork_bh_timer_barrier_held, 0);
+            qatomic_set(&crucible_hot_fork_bh_timer_barrier_owner, 0);
+            crucible_hot_fork_bh_timer_barrier_generation++;
+            assert(crucible_hot_fork_bh_timer_barrier_generation != 0);
+            qemu_event_set(&crucible_hot_fork_bh_timer_barrier_release);
+        }
+        break;
+    default:
+        g_assert_not_reached();
+    }
+
+    qemu_bh_hot_fork_inventory(&bottom_halves);
+#ifdef CONFIG_POSIX
+    qemu_timer_hot_fork_inventory(&timers);
+#endif
+    inventory->generation = crucible_hot_fork_bh_timer_barrier_generation;
+    inventory->owner_thread_id =
+        qatomic_read(&crucible_hot_fork_bh_timer_barrier_owner);
+    inventory->admissions_in_flight =
+        qatomic_read(&crucible_hot_fork_bh_timer_admissions);
+    inventory->bottom_half_count = bottom_halves.entry_count;
+    for (index = 0; index < bottom_halves.entry_count; index++) {
+        QemuBhHotForkInventoryEntry *entry = &bottom_halves.entries[index];
+
+        inventory->pending_bottom_halves += entry->pending;
+        inventory->scheduled_bottom_halves += entry->scheduled;
+        inventory->active_bottom_half_callbacks += entry->active_callbacks;
+    }
+#ifdef CONFIG_POSIX
+    for (index = 0; index < timers.entry_count; index++) {
+        QemuTimerHotForkInventoryEntry *entry = &timers.entries[index];
+
+        inventory->pending_timers += entry->pending;
+        inventory->active_timer_callbacks += entry->callback_active;
+    }
+#endif
+    inventory->held =
+        qatomic_read(&crucible_hot_fork_bh_timer_barrier_held) != 0;
+    inventory->bottom_halves_complete =
+        !bottom_halves.overflowed && bottom_halves.stable;
+#ifdef CONFIG_POSIX
+    inventory->timers_complete = !timers.overflowed;
+#endif
+    inventory->complete = inventory->bottom_halves_complete &&
+        inventory->timers_complete;
+    inventory->quiescent = inventory->held && inventory->complete &&
+        inventory->admissions_in_flight == 0 &&
+        inventory->active_bottom_half_callbacks == 0 &&
+        inventory->active_timer_callbacks == 0;
+#ifdef CONFIG_POSIX
+    qemu_timer_hot_fork_inventory_destroy(&timers);
+#endif
+    qemu_bh_hot_fork_inventory_destroy(&bottom_halves);
+    qemu_mutex_unlock(&crucible_hot_fork_bh_timer_barrier_lock);
+}
