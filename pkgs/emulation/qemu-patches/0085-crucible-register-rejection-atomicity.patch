-                       sizeof(register_state_before)) != 0) {
-                result->status = CRUCIBLE_FAULT_STATUS_INTERNAL_ERROR;
-                return -EIO;
-            }
-            memcpy(result->before_hash, register_state_before, 32);
-            memcpy(result->after_hash, register_state_after, 32);
+            memcpy(result->before_hash,
+                   register_state_before.canonical_register_hash, 32);
+            memcpy(result->after_hash,
+                   register_state_after_validation.canonical_register_hash,
