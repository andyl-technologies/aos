+    QEMU_PLUGIN_CRUCIBLE_REGISTER_SIDE_EFFECT_TLB = 0,
+    QEMU_PLUGIN_CRUCIBLE_REGISTER_SIDE_EFFECT_TB = 1,
+    QEMU_PLUGIN_CRUCIBLE_REGISTER_SIDE_EFFECT_FLAGS = 2,
