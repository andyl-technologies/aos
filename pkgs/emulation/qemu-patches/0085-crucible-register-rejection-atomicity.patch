             result->status = status == -ENOTSUP ?
                 CRUCIBLE_FAULT_STATUS_UNSUPPORTED_CAPABILITY :
                 CRUCIBLE_FAULT_STATUS_INVALID_TARGET;
@@ -3452,6 +3494,12 @@ static int node_prepare(
     }
     if (command->command_flags & CRUCIBLE_FAULT_COMMAND_FLAG_PREPARE_ONLY) {
         if (node_hash_nonzero(command->expected_precondition_hash)) {
