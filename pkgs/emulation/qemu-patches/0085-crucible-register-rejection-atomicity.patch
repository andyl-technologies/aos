+++ b/plugins/crucible-fault-node.c
@@ -3286,6 +3286,22 @@ static int node_memory_resolve_target(QemuCrucibleFaultRule *rule,
     return 0;
 }
 
+static int node_register_rejection_unchanged(
+    const struct qemu_plugin_crucible_register_rejection_observation *before,
+    struct qemu_plugin_crucible_fault_result *result)
+{
+    struct qemu_plugin_crucible_register_rejection_observation after;
+
+    if (!before || !result ||
+        qemu_plugin_crucible_register_rejection_observe(&after) != 0 ||
+        memcmp(before, &after, sizeof(*before)) != 0) {
+        return -EIO;
+    }
+    memcpy(result->before_hash, before->canonical_register_hash, 32);
+    memcpy(result->after_hash, after.canonical_register_hash, 32);
+    return 0;
+}
+
 static int node_prepare(
     const struct qemu_plugin_crucible_fault_command *command,
     const uint8_t *payload, size_t payload_len, void *state,
@@ -3293,19 +3309,45 @@ static int node_prepare(
     GByteArray *result_payload)
 {
     CrucibleNodeStaging *staging = state;
-    uint8_t register_state_before[32] = { 0 };
+    struct qemu_plugin_crucible_register_rejection_observation
+        register_state_before = { 0 };
+    struct qemu_plugin_crucible_register_rejection_observation
+        register_state_after_validation = { 0 };
     bool register_state_captured = false;
     int status;
 
+    if (staging->rule.command_kind ==
+            CRUCIBLE_FAULT_COMMAND_CPU_REGISTER_TRANSFORM) {
+        status = qemu_plugin_crucible_register_rejection_observe(
+            &register_state_before);
+        if (status != 0) {
+            result->status = CRUCIBLE_FAULT_STATUS_INTERNAL_ERROR;
+            return status;
+        }
+        register_state_captured = true;
+    }
+
     staging->prior = node_find_rule(staging->rule.command_kind,
                                     staging->rule.binding_hash, NULL);
     if (staging->prior &&
         staging->rule.generation <= staging->prior->generation) {
+        if (register_state_captured &&
+            node_register_rejection_unchanged(
+                &register_state_before, result) != 0) {
+            result->status = CRUCIBLE_FAULT_STATUS_INTERNAL_ERROR;
+            return -EIO;
+        }
         result->status = CRUCIBLE_FAULT_STATUS_PRECONDITION_MISMATCH;
         return -EINVAL;
     }
     if (staging->rule.operation == CRUCIBLE_NODE_FAULT_OPERATION_REMOVE &&
         !staging->prior) {
+        if (register_state_captured &&
+            node_register_rejection_unchanged(
+                &register_state_before, result) != 0) {
+            result->status = CRUCIBLE_FAULT_STATUS_INTERNAL_ERROR;
+            return -EIO;
+        }
         result->status = CRUCIBLE_FAULT_STATUS_PRECONDITION_MISMATCH;
         return -ENOENT;
     }
@@ -3324,26 +3366,26 @@ static int node_prepare(
     }
     if (staging->rule.command_kind ==
             CRUCIBLE_FAULT_COMMAND_CPU_REGISTER_TRANSFORM) {
-        status = qemu_crucible_fault_register_state_fingerprint(
-            register_state_before);
+        status = qemu_plugin_crucible_register_rejection_observe(
+            &register_state_before);
         if (status != 0) {
             result->status = CRUCIBLE_FAULT_STATUS_INTERNAL_ERROR;
             return status;
         }
-        register_state_captured = true;
         status = qemu_crucible_fault_register_validate(&staging->rule);
+        if (qemu_plugin_crucible_register_rejection_observe(
+                &register_state_after_validation) != 0 ||
+            memcmp(&register_state_before, &register_state_after_validation,
+                   sizeof(register_state_before)) != 0) {
+            result->status = CRUCIBLE_FAULT_STATUS_INTERNAL_ERROR;
+            return -EIO;
+        }
         if (status != 0) {
-            uint8_t register_state_after[32];
-
-            if (qemu_crucible_fault_register_state_fingerprint(
-                    register_state_after) != 0 ||
