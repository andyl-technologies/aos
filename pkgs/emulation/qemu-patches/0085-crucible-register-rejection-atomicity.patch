 #ifndef CONFIG_USER_ONLY
 static bool qemu_plugin_crucible_vcpu_register_read_allowed(void)
 {
+    uint64_t owner = qemu_plugin_crucible_rr_current_vcpu();
+
     /*
-     * In deterministic single-thread RR, current_cpu proves that one vCPU is
-     * executing and every other realized vCPU is quiescent.  Terminal state
-     * capture instead stops the VM and holds the BQL while inspecting all
-     * vCPUs.  Refuse every concurrent or unowned observation context.
+     * An exact deterministic RR callback must prove that current_cpu is the
+     * serialized owner; the execution mode alone is not ownership. Terminal
+     * state capture instead stops the VM and holds the BQL while inspecting
+     * all vCPUs. Refuse every concurrent, stale, or unowned context.
      */
-    return (qemu_plugin_crucible_single_threaded_rr() && current_cpu) ||
+    return (qemu_plugin_crucible_single_threaded_rr() && current_cpu &&
+            qemu_plugin_crucible_exact_boundary_active() &&
+            owner != UINT64_MAX && current_cpu->cpu_index == owner) ||
         (bql_locked() && !runstate_is_running());
 }
 
diff --git a/plugins/crucible-fault-node.c b/plugins/crucible-fault-node.c
