diff --git a/plugins/crucible-fault-register.c b/plugins/crucible-fault-register.c
index b6a4ed0cc..994c1957e 100644
--- a/plugins/crucible-fault-register.c
+++ b/plugins/crucible-fault-register.c
@@ -58,6 +58,33 @@ static uint8_t crucible_register_architecture_identity[32];
 static bool crucible_register_architecture_bound;
 static bool crucible_register_bindings_sealed;
 static bool crucible_register_handler_registered;
+static uint64_t crucible_register_side_effect_counts[
+    QEMU_PLUGIN_CRUCIBLE_REGISTER_SIDE_EFFECT_COUNT];
+static __thread unsigned int crucible_register_side_effect_scope_depth;
+
+void qemu_crucible_fault_register_side_effect_scope_enter(void)
+{
+    crucible_register_side_effect_scope_depth++;
+}
+
+void qemu_crucible_fault_register_side_effect_scope_leave(void)
+{
+    g_assert(crucible_register_side_effect_scope_depth != 0);
+    crucible_register_side_effect_scope_depth--;
+}
+
+void qemu_crucible_fault_register_side_effect_observed(uint32_t effects)
+{
+    if (crucible_register_side_effect_scope_depth == 0) {
+        return;
+    }
+    for (size_t bit = 0;
+         bit < QEMU_PLUGIN_CRUCIBLE_REGISTER_SIDE_EFFECT_COUNT; bit++) {
+        if (effects & (1U << bit)) {
+            qatomic_fetch_add(&crucible_register_side_effect_counts[bit], 1);
+        }
+    }
+}
 
 static bool crucible_register_mask_test(const uint8_t *mask, uint32_t bit)
 {
@@ -349,7 +376,7 @@ int qemu_plugin_crucible_fault_register_read(unsigned int vcpu_index,
                                 CrucibleRegisterCapability,
                                 numeric_id - 1);
     if (capability->numeric_id != numeric_id ||
-        !crucible_register_cpu_matches_manifest(cpu)) {
+        !crucible_register_all_cpus_match_manifest()) {
         return -EINVAL;
     }
     bytes = DIV_ROUND_UP(capability->width_bits, 8);
@@ -358,7 +385,8 @@ int qemu_plugin_crucible_fault_register_read(unsigned int vcpu_index,
         return -ENOSPC;
     }
     if (!qemu_plugin_crucible_single_threaded_rr() || !current_cpu ||
-        current_cpu != cpu) {
+        current_cpu != cpu ||
+        qemu_plugin_crucible_rr_current_vcpu() != vcpu_index) {
         return -EPERM;
     }
 
@@ -778,6 +806,59 @@ int qemu_crucible_fault_register_state_fingerprint(uint8_t output[32])
     return digest_len == 32 ? 0 : -EIO;
 }
 
+int qemu_plugin_crucible_register_rejection_observe(
+    struct qemu_plugin_crucible_register_rejection_observation *out)
+{
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    int cpu_count = qemu_plugin_num_vcpus();
+    gsize digest_len = sizeof(out->canonical_register_hash);
+
+    if (!out || cpu_count <= 0 || !checksum) {
+        return -EINVAL;
+    }
+    memset(out, 0, sizeof(*out));
+    g_checksum_update(
+        checksum,
+        (const uint8_t *)"crucible.canonical-register-rejection.v1\0",
+        strlen("crucible.canonical-register-rejection.v1") + 1);
+    for (int index = 0; index < cpu_count; index++) {
+        g_autofree uint8_t *bytes = NULL;
+        size_t length = 0;
+        uint64_t retired = 0;
+        uint8_t framing[24];
+
+        if (!qemu_get_cpu(index)) {
+            return -EIO;
+        }
+        (void)qemu_plugin_read_vcpu_regs(index, NULL, 0, &length,
+                                         &retired);
+        if (length == 0) {
+            return -EIO;
+        }
+        bytes = g_malloc(length);
+        if (qemu_plugin_read_vcpu_regs(index, bytes, length, &length,
+                                       &retired) != 0) {
+            return -EIO;
+        }
+        stq_le_p(framing, index);
+        stq_le_p(framing + 8, length);
+        stq_le_p(framing + 16, retired);
+        g_checksum_update(checksum, framing, sizeof(framing));
+        g_checksum_update(checksum, bytes, length);
+    }
+    g_checksum_get_digest(checksum, out->canonical_register_hash,
+                          &digest_len);
+    if (digest_len != sizeof(out->canonical_register_hash)) {
+        return -EIO;
+    }
+    for (size_t bit = 0;
+         bit < QEMU_PLUGIN_CRUCIBLE_REGISTER_SIDE_EFFECT_COUNT; bit++) {
+        out->side_effect_counts[bit] = qatomic_read(
+            &crucible_register_side_effect_counts[bit]);
+    }
+    return 0;
+}
+
 static int crucible_register_execution_fingerprint(
     uint64_t icount, const struct qemu_plugin_rr_cursor *rr,
     uint8_t output[32])
@@ -1048,7 +1129,8 @@ static int crucible_register_result_decode(
     bool mask_nonzero = false;
 
     if (!cpu || !register_identity || !root || !apply || !mask_out ||
-        !value_out || qdict_size(root) != 2) {
+        !value_out || qdict_size(root) != 2 ||
+        !crucible_register_all_cpus_match_manifest()) {
         return -EINVAL;
     }
     kind = qdict_get_try_str(root, "kind");
