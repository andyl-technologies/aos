                       staging->before_hash,
                       sizeof(staging->before_hash)) != 0) {
         if (register_state_captured) {
-            uint8_t register_state_after[32];
-
-            if (qemu_crucible_fault_register_state_fingerprint(
-                    register_state_after) != 0 ||
-                memcmp(register_state_before, register_state_after,
-                       sizeof(register_state_before)) != 0) {
+            if (node_register_rejection_unchanged(
+                    &register_state_before, result) != 0) {
                 result->status = CRUCIBLE_FAULT_STATUS_INTERNAL_ERROR;
                 return -EIO;
             }
