+static int verify_fork_child_endpoints(void *opaque)
+{
+    ForkChildVerification *verification = opaque;
+    char byte = 'f';
+    uint64_t wake = 1;
+
+    if (send(verification->control_fd, &byte, 1, 0) != 1) {
+        return errno != 0 ? -errno : -EIO;
+    }
+    if (write(verification->wake_fd, &wake, sizeof(wake)) != sizeof(wake)) {
+        return errno != 0 ? -errno : -EIO;
+    }
+    return 0;
+}
+
+static void write_child_result(int fd, int result)
+{
+    ssize_t written;
+
+    do {
+        written = write(fd, &result, sizeof(result));
+    } while (written < 0 && errno == EINTR);
+}
+
+static int read_child_result(int fd)
+{
+    int result = -EIO;
+    ssize_t received;
+
+    do {
+        received = read(fd, &result, sizeof(result));
+    } while (received < 0 && errno == EINTR);
+    g_assert_cmpint(received, ==, sizeof(result));
+    return result;
+}
+
+static void wait_for_child(pid_t child)
+{
+    int status;
+    pid_t waited;
+
+    do {
+        waited = waitpid(child, &status, 0);
+    } while (waited < 0 && errno == EINTR);
+    g_assert_cmpint(waited, ==, child);
+    g_assert_true(WIFEXITED(status));
+    g_assert_cmpint(WEXITSTATUS(status), ==, 0);
+}
