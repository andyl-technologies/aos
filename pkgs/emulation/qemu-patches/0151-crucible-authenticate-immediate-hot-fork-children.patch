+static int crucible_hot_fork_pidfd_open(pid_t pid)
+{
+    return syscall(__NR_pidfd_open, pid, 0);
+}
+
+static int crucible_hot_fork_pidfd_probe(int pidfd)
+{
+    return syscall(__NR_pidfd_send_signal, pidfd, 0, NULL, 0);
+}
+
+int qemu_crucible_hot_fork_capture_parent_identity(
+    QemuCrucibleHotForkParentIdentity *identity)
+{
+    int pidfd;
+
+    if (!identity) {
+        return -EINVAL;
+    }
+    identity->parent_pid = -1;
+    identity->parent_pidfd = -1;
+
+    pidfd = crucible_hot_fork_pidfd_open(getpid());
+    if (pidfd < 0) {
+        return -errno;
+    }
+    if (fcntl(pidfd, F_GETFD) < 0) {
+        int result = -errno;
+
+        close(pidfd);
+        return result;
+    }
+
+    identity->parent_pid = getpid();
+    identity->parent_pidfd = pidfd;
+    return 0;
+}
+
+int qemu_crucible_hot_fork_authenticate_immediate_child(
+    const QemuCrucibleHotForkParentIdentity *identity)
+{
+    pid_t child_pid;
+
+    if (!identity || identity->parent_pid <= 1 ||
+        identity->parent_pidfd < 0) {
+        return -EINVAL;
+    }
+
+    child_pid = getpid();
+    if (child_pid == identity->parent_pid ||
+        getppid() != identity->parent_pid) {
+        return -EPERM;
+    }
+
+    if (prctl(PR_SET_PDEATHSIG, SIGKILL, 0, 0, 0) < 0) {
+        return -errno;
+    }
+    if (getppid() != identity->parent_pid) {
+        return -ESRCH;
+    }
+    if (crucible_hot_fork_pidfd_probe(identity->parent_pidfd) < 0) {
+        return -errno;
+    }
+    if (getppid() != identity->parent_pid) {
+        return -ESRCH;
+    }
+    return 0;
+}
+
+void qemu_crucible_hot_fork_release_parent_identity(
+    QemuCrucibleHotForkParentIdentity *identity)
+{
+    if (!identity) {
+        return;
+    }
+    if (identity->parent_pidfd >= 0) {
+        close(identity->parent_pidfd);
+    }
+    identity->parent_pid = -1;
+    identity->parent_pidfd = -1;
+}
