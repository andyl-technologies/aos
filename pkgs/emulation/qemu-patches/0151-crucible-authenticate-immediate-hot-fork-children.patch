+static void test_immediate_child_replaces_parent_endpoints(void)
+{
+    QemuCrucibleHotForkParentIdentity identity;
+    QemuCrucibleHotForkDescriptorReplacement replacements[2];
+    ForkChildVerification verification;
+    int old_control[2];
+    int new_control[2];
+    int child_result[2];
+    int old_wake;
+    int new_wake;
+    uint64_t wake = 0;
+    char byte = 'p';
+    pid_t child;
+
+    g_assert_cmpint(qemu_crucible_hot_fork_capture_parent_identity(&identity),
+                    ==, 0);
+    g_assert_cmpint(qemu_crucible_hot_fork_authenticate_immediate_child(
+                        &identity),
+                    ==, -EPERM);
+    g_assert_cmpint(socketpair(AF_UNIX, SOCK_STREAM, 0, old_control), ==, 0);
+    g_assert_cmpint(socketpair(AF_UNIX, SOCK_STREAM, 0, new_control), ==, 0);
+    g_assert_cmpint(pipe2(child_result, O_CLOEXEC), ==, 0);
+    old_wake = eventfd(0, EFD_CLOEXEC | EFD_NONBLOCK);
+    new_wake = eventfd(0, EFD_CLOEXEC);
+    g_assert_cmpint(old_wake, >=, 0);
+    g_assert_cmpint(new_wake, >=, 0);
+
+    replacements[0] = (QemuCrucibleHotForkDescriptorReplacement) {
+        .source_fd = new_control[0],
+        .target_fd = old_control[0],
+    };
+    replacements[1] = (QemuCrucibleHotForkDescriptorReplacement) {
+        .source_fd = new_wake,
+        .target_fd = old_wake,
+    };
+    verification = (ForkChildVerification) {
+        .control_fd = old_control[0],
+        .wake_fd = old_wake,
+    };
+
+    child = fork();
+    g_assert_cmpint(child, >=, 0);
+    if (child == 0) {
+        int result;
+
+        close(child_result[0]);
+        result = qemu_crucible_hot_fork_authenticate_immediate_child(
+            &identity);
+        if (result == 0) {
+            result = qemu_crucible_hot_fork_replace_endpoint_descriptors(
+                replacements, verify_fork_child_endpoints, &verification);
+        }
+        qemu_crucible_hot_fork_release_parent_identity(&identity);
+        write_child_result(child_result[1], result);
+        _exit(0);
+    }
+
+    close(child_result[1]);
+    close(new_control[0]);
+    g_assert_cmpint(read_child_result(child_result[0]), ==, 0);
+    g_assert_cmpint(recv(new_control[1], &byte, 1, 0), ==, 1);
+    g_assert_cmpint(byte, ==, 'f');
+    g_assert_cmpint(read(new_wake, &wake, sizeof(wake)), ==, sizeof(wake));
+    g_assert_cmpuint(wake, ==, 1);
+
+    g_assert_cmpint(send(old_control[1], &byte, 1, 0), ==, 1);
+    g_assert_cmpint(recv(old_control[0], &byte, 1, 0), ==, 1);
+    g_assert_cmpint(read(old_wake, &wake, sizeof(wake)), ==, -1);
+    g_assert_cmpint(errno, ==, EAGAIN);
+    wait_for_child(child);
+
+    qemu_crucible_hot_fork_release_parent_identity(&identity);
+    close(child_result[0]);
+    close(old_control[0]);
+    close(old_control[1]);
+    close(new_control[1]);
+    close(old_wake);
+    close(new_wake);
+}
