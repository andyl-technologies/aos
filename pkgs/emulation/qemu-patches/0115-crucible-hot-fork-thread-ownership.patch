+void qemu_thread_hot_fork_set_current_disposition(
+    QemuThreadHotForkDisposition disposition)
+{
+    QemuHotForkThreadRecord *record = qemu_hot_fork_current_thread;
+    int err;
+
+    assert(record);
+    assert(disposition != QEMU_THREAD_HOT_FORK_COORDINATOR);
+    err = pthread_mutex_lock(&qemu_hot_fork_thread_lock);
+    if (err) {
+        error_exit(err, __func__);
+    }
+    if (record->disposition != disposition) {
+        record->disposition = disposition;
+        qemu_hot_fork_thread_generation++;
+    }
+    err = pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+    if (err) {
+        error_exit(err, __func__);
+    }
+}
