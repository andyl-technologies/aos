+            if (left[left_index].source_fd == right[right_index].source_fd ||
+                left[left_index].source_fd == right[right_index].target_fd ||
+                left[left_index].target_fd == right[right_index].source_fd) {
+                return true;
+            }
+        }
+    }
+    return false;
