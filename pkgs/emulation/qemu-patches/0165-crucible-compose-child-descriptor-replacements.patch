+static bool crucible_hot_fork_replacement_equal(
+    const QemuCrucibleHotForkDescriptorReplacement *left,
+    const QemuCrucibleHotForkDescriptorReplacement *right)
+{
+    return left->source_fd == right->source_fd &&
+        left->target_fd == right->target_fd;
+}
+
+static bool crucible_hot_fork_replacement_table_valid(
+    const QemuCrucibleHotForkDescriptorReplacement *replacements,
+    size_t count)
+{
+    if (count != 0 && !replacements) {
+        return false;
+    }
+    for (size_t index = 0; index < count; index++) {
+        int source = replacements[index].source_fd;
+        int target = replacements[index].target_fd;
+
+        if (source < 0 || target < 0 || source == target ||
+            (index != 0 && replacements[index - 1].target_fd >= target)) {
+            return false;
+        }
+        for (size_t other = 0; other < index; other++) {
+            if (source == replacements[other].source_fd ||
+                source == replacements[other].target_fd ||
+                target == replacements[other].source_fd) {
+                return false;
+            }
+        }
+    }
+    return true;
+}
+
+static bool crucible_hot_fork_replacement_tables_conflict(
+    const QemuCrucibleHotForkDescriptorReplacement *left,
+    size_t left_count,
+    const QemuCrucibleHotForkDescriptorReplacement *right,
+    size_t right_count)
+{
+    for (size_t left_index = 0; left_index < left_count; left_index++) {
+        for (size_t right_index = 0; right_index < right_count; right_index++) {
+            if (left[left_index].target_fd == right[right_index].target_fd) {
+                if (!crucible_hot_fork_replacement_equal(
