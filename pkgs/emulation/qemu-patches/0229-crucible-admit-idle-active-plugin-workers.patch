diff --git a/system/crucible-hot-fork-plugin-child.c b/system/crucible-hot-fork-plugin-child.c
index df4eb34b5..ca14cb74d 100644
--- a/system/crucible-hot-fork-plugin-child.c
+++ b/system/crucible-hot-fork-plugin-child.c
@@ -2094,6 +2094,19 @@ static bool crucible_hot_fork_plugin_child_identity_matches(
         status->source_mapping_length == plan->source_mapping_length &&
         status->source_mapping_offset == plan->source_mapping_offset &&
         status->worker_mask == plan->worker_mask &&
+        (status->parked_worker_mask & ~status->worker_mask) == 0;
+}
+
+/*
+ * A held child has every replacement worker parked behind the hold with
+ * nothing pending or in flight.  An active child's workers are live: an
+ * idle worker parks at its receive safe point and a busy one carries an
+ * item, so only the held state constrains those masks.
+ */
+static bool crucible_hot_fork_plugin_child_workers_held(
+    const struct qemu_plugin_crucible_hot_fork_child_status *status)
+{
+    return status->parked_worker_mask == status->worker_mask &&
         status->pending_worker_mask == 0 &&
         status->worker_operations_in_flight == 0;
 }
@@ -2116,8 +2129,7 @@ static bool crucible_hot_fork_plugin_child_status_matches(
         status->phase == (active ?
             QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PHASE_ACTIVE :
             QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PHASE_WORKERS_HELD) &&
-        status->parked_worker_mask ==
-            (active ? 0 : status->worker_mask);
+        (active || crucible_hot_fork_plugin_child_workers_held(status));
 }
 
 /*
@@ -2137,7 +2149,8 @@ static bool crucible_hot_fork_plugin_child_workers_settling(
              QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_MAPPING_INSTALLED) &&
         status->phase ==
             QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PHASE_WORKERS_HELD &&
-        (status->parked_worker_mask & ~status->worker_mask) == 0;
+        status->pending_worker_mask == 0 &&
+        status->worker_operations_in_flight == 0;
 }
 
 /* Bound on the replacement workers reaching their parked safe point. */
@@ -2249,11 +2262,15 @@ int qemu_crucible_hot_fork_activate_plugin_child(
     result = qemu_plugin_crucible_hot_fork_child_runtime(
         QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_RELEASE, NULL, &inventory);
     if (result != 0) {
+        crucible_hot_fork_plugin_child_report_status(
+            reinitializer, "release failed", result);
         return result;
     }
     reinitializer->inventory = inventory;
     if (!crucible_hot_fork_plugin_child_status_matches(
             reinitializer, true)) {
+        crucible_hot_fork_plugin_child_report_status(
+            reinitializer, "activation status mismatch", -EPROTO);
         return -EPROTO;
     }
     reinitializer->activated = true;
