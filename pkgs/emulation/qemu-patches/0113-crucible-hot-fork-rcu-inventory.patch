+static int qemu_rcu_hot_fork_entry_compare(const void *left,
+                                           const void *right)
+{
+    const QemuRcuHotForkInventoryEntry *a = left;
+    const QemuRcuHotForkInventoryEntry *b = right;
+
+    return (a->thread_id > b->thread_id) - (a->thread_id < b->thread_id);
+}
+
+void qemu_rcu_hot_fork_inventory(QemuRcuHotForkInventory *inventory)
+{
+    struct rcu_reader_data *reader;
+    size_t retained = 0;
+    size_t index = 0;
+
+    memset(inventory, 0, sizeof(*inventory));
+    qemu_mutex_lock(&rcu_registry_lock);
+    QLIST_FOREACH(reader, &registry, node) {
+        if (retained == QEMU_RCU_HOT_FORK_INVENTORY_MAX) {
+            inventory->overflowed = true;
+            break;
+        }
+        retained++;
+    }
+    inventory->entries = g_new0(QemuRcuHotForkInventoryEntry, retained);
+    QLIST_FOREACH(reader, &registry, node) {
+        if (index == retained) {
+            break;
+        }
+        inventory->entries[index].thread_id = reader->thread_id;
+        inventory->entries[index].active = qatomic_read(&reader->ctr) != 0;
+        index++;
+    }
+    inventory->generation = rcu_hot_fork_generation;
+    inventory->entry_count = retained;
+    inventory->pending_callbacks =
+        qatomic_read(&rcu_hot_fork_pending_callbacks);
+    inventory->drain_active = qatomic_read(&in_drain_call_rcu) != 0;
+    qemu_mutex_unlock(&rcu_registry_lock);
+
+    qsort(inventory->entries, inventory->entry_count,
+          sizeof(*inventory->entries), qemu_rcu_hot_fork_entry_compare);
+}
+
+void qemu_rcu_hot_fork_inventory_destroy(QemuRcuHotForkInventory *inventory)
+{
+    g_free(inventory->entries);
+    memset(inventory, 0, sizeof(*inventory));
+}
