+CrucibleHotForkRcuInventory *
+qmp_query_crucible_hot_fork_rcu_inventory(Error **errp)
+{
+    CrucibleHotForkRcuInventory *report =
+        g_new0(CrucibleHotForkRcuInventory, 1);
+
+    (void)errp;
+    report->schema_version = 1;
+#ifdef CONFIG_POSIX
+    QemuRcuHotForkInventory inventory;
+    CrucibleHotForkRcuReaderList **tail = &report->readers;
+    uint32_t active_readers = 0;
+    int64_t previous_thread_id = 0;
+    bool valid_identifiers = true;
+    size_t index;
+
+    qemu_rcu_hot_fork_inventory(&inventory);
+    report->generation = inventory.generation;
+    for (index = 0; index < inventory.entry_count; index++) {
+        QemuRcuHotForkInventoryEntry *source = &inventory.entries[index];
+        CrucibleHotForkRcuReader *reader =
+            g_new0(CrucibleHotForkRcuReader, 1);
+        CrucibleHotForkRcuReaderList *node =
+            g_new0(CrucibleHotForkRcuReaderList, 1);
+
+        reader->thread_id = source->thread_id;
+        reader->active = source->active;
+        if (source->thread_id <= 0 ||
+            (index != 0 && source->thread_id <= previous_thread_id)) {
+            valid_identifiers = false;
+        }
+        previous_thread_id = source->thread_id;
+        if (source->active) {
+            active_readers++;
+        }
+        node->value = reader;
+        *tail = node;
+        tail = &node->next;
+    }
+    report->registered_readers = inventory.entry_count;
+    report->active_readers = active_readers;
+    report->pending_callbacks = inventory.pending_callbacks;
+    report->drain_active = inventory.drain_active;
+    report->overflowed = inventory.overflowed;
+    report->complete = !inventory.overflowed && valid_identifiers;
+    qemu_rcu_hot_fork_inventory_destroy(&inventory);
+#else
+    report->complete = false;
+    report->overflowed = true;
+#endif
+    return report;
+}
