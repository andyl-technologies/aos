+##
+# @CrucibleHotForkRcuReader:
+#
+# One thread registered as an RCU read-side participant.
+#
+# @thread-id: positive operating-system thread identifier
+#
+# @active: whether the reader was inside a read-side critical section at the
+#     instant the registry lock was held
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'struct': 'CrucibleHotForkRcuReader',
+  'data': { 'thread-id': 'int64',
+            'active': 'bool' } }
+
+##
+# @CrucibleHotForkRcuInventory:
+#
+# Bounded observational snapshot of QEMU's registered RCU readers and callback
+# state.  This report is audit evidence, not an RCU barrier or fork
+# authorization.  Reader activity and callback state may change immediately
+# after the query returns.
+#
+# @schema-version: inventory contract version, currently 1
+#
+# @generation: monotonic process-local reader register/unregister counter
+#
+# @complete: true exactly when the reader registry did not overflow and every
+#     retained reader has a unique positive thread identifier
+#
+# @overflowed: whether one or more registered readers exceeded the retained
+#     registry bound
+#
+# @registered-readers: number of retained registered readers
+#
+# @active-readers: number of retained readers active in a read-side critical
+#     section
+#
+# @pending-callbacks: callbacks submitted but not yet completed, conservatively
+#     incremented before queue publication and decremented only after callback
+#     return
+#
+# @drain-active: whether drain_call_rcu() is currently active
+#
+# @readers: every retained reader, sorted by @thread-id and bounded to 65536
+#     entries
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'struct': 'CrucibleHotForkRcuInventory',
+  'data': { 'schema-version': 'uint32',
+            'generation': 'uint64',
+            'complete': 'bool',
+            'overflowed': 'bool',
+            'registered-readers': 'uint32',
+            'active-readers': 'uint32',
+            'pending-callbacks': 'uint64',
+            'drain-active': 'bool',
+            'readers': [ 'CrucibleHotForkRcuReader' ] } }
+
+##
+# @query-crucible-hot-fork-rcu-inventory:
+#
+# Query the bounded RCU state visible at one registry-lock observation.  This
+# command does not drain callbacks, hold readers quiescent, advance readiness
+# proof bit 4, or otherwise authorize a fork.
+#
+# Returns: @CrucibleHotForkRcuInventory
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'command': 'query-crucible-hot-fork-rcu-inventory',
+  'returns': 'CrucibleHotForkRcuInventory' }
+
 ##
 # @SHUTDOWN:
 #
