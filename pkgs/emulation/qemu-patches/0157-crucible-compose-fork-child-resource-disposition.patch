+static void test_child_resource_preflight_preserves_descriptors(void)
+{
+    QemuCrucibleHotForkDescriptorTableTransaction transaction = {
+        .parent_pid = 2,
+        .child_pid = getpid(),
+        .active = true,
+    };
+    QemuCrucibleHotForkDescriptorReplacement replacements[2];
+    uint64_t page_size = qemu_real_host_page_size();
+    QemuCrucibleHotForkSharedMapping unretained_mapping = {
+        .start = qemu_real_host_page_size(),
+        .length = qemu_real_host_page_size(),
+        .offset = 0,
+    };
+    ChildResourceReinitializer reinitializer = {
+        .installed_mapping = MAP_FAILED,
+    };
+    int descriptors[4];
+    int retained_fds[2];
+    int unretained_backing;
+
+    for (size_t index = 0; index < G_N_ELEMENTS(descriptors); index++) {
+        descriptors[index] = eventfd(0, EFD_CLOEXEC);
+        g_assert_cmpint(descriptors[index], >=, 0);
+    }
+    replacements[0] = (QemuCrucibleHotForkDescriptorReplacement) {
+        .source_fd = descriptors[0],
+        .target_fd = descriptors[1],
+    };
+    replacements[1] = (QemuCrucibleHotForkDescriptorReplacement) {
+        .source_fd = descriptors[2],
+        .target_fd = descriptors[3],
+    };
+    retained_fds[0] = descriptors[1];
+    retained_fds[1] = descriptors[3];
+    qsort(retained_fds, G_N_ELEMENTS(retained_fds),
+          sizeof(retained_fds[0]), compare_descriptors);
+    unretained_backing = memfd_create(
+        "crucible-hot-fork-unretained", MFD_CLOEXEC | MFD_ALLOW_SEALING);
+    g_assert_cmpint(unretained_backing, >=, 0);
+    g_assert_cmpint(ftruncate(unretained_backing, page_size), ==, 0);
+    g_assert_cmpint(fcntl(unretained_backing, F_ADD_SEALS, F_SEAL_SHRINK),
+                    ==, 0);
+    unretained_mapping.backing_fd = unretained_backing;
+
+    g_assert_cmpint(qemu_crucible_hot_fork_apply_child_resources(
+                        &transaction, replacements, retained_fds,
+                        G_N_ELEMENTS(retained_fds), accept_endpoints, NULL,
+                        reinitialize_child_resources, &reinitializer,
+                        &unretained_mapping, 1),
+                    ==, -EINVAL);
+    g_assert_true(transaction.active);
+    g_assert_false(transaction.descriptors_applied);
+    g_assert_false(transaction.child_reinitialized);
+    g_assert_false(transaction.mappings_verified);
+    g_assert_false(reinitializer.called);
+    for (size_t index = 0; index < G_N_ELEMENTS(descriptors); index++) {
+        g_assert_cmpint(fcntl(descriptors[index], F_GETFD), >=, 0);
+        close(descriptors[index]);
+    }
+    close(unretained_backing);
 }
 
