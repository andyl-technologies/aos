 }
+
+int qemu_crucible_hot_fork_apply_child_resources(
+    QemuCrucibleHotForkDescriptorTableTransaction *transaction,
+    const QemuCrucibleHotForkDescriptorReplacement replacements[2],
+    const int *retained_fds,
+    size_t retained_fd_count,
+    QemuCrucibleHotForkDescriptorVerifier verify_descriptors,
+    void *descriptor_opaque,
+    QemuCrucibleHotForkChildReinitializer reinitialize,
+    void *reinitialize_opaque,
+    const QemuCrucibleHotForkSharedMapping *shared_mappings,
+    size_t shared_mapping_count)
+{
+    int result;
+
+    if (!transaction) {
+        return -EINVAL;
+    }
+    if (!transaction->active || transaction->parent_pid <= 1 ||
+        transaction->child_pid != getpid()) {
+        return -EPERM;
+    }
+    if (!verify_descriptors || !reinitialize ||
+        !crucible_hot_fork_retained_table_is_valid(
+            replacements, retained_fds, retained_fd_count) ||
+        !crucible_hot_fork_shared_mapping_table_is_valid(
+            shared_mappings, shared_mapping_count) ||
+        !crucible_hot_fork_mapping_backings_are_retained(
+            shared_mappings, shared_mapping_count,
+            retained_fds, retained_fd_count)) {
+        return -EINVAL;
+    }
+
+    result = qemu_crucible_hot_fork_apply_descriptor_table(
+        transaction, replacements, retained_fds, retained_fd_count,
+        verify_descriptors, descriptor_opaque);
+    if (result != 0) {
+        return result;
+    }
+
+    result = reinitialize(reinitialize_opaque);
+    if (result > 0 || result == -EUCLEAN) {
+        result = -EPROTO;
+    }
+    if (result != 0) {
+        transaction->descriptors_applied = false;
+        return result;
+    }
+    transaction->child_reinitialized = true;
+
+    return qemu_crucible_hot_fork_verify_mapping_table(
+        transaction, shared_mappings, shared_mapping_count);
+}
