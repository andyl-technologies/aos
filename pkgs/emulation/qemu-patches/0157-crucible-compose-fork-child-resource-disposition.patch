+static bool crucible_hot_fork_mapping_backings_are_retained(
+    const QemuCrucibleHotForkSharedMapping *mappings,
+    size_t mapping_count,
+    const int *retained_fds,
+    size_t retained_fd_count)
+{
+    for (size_t mapping = 0; mapping < mapping_count; mapping++) {
+        size_t lower = 0;
+        size_t upper = retained_fd_count;
+
+        while (lower < upper) {
+            size_t middle = lower + (upper - lower) / 2;
+
+            if (retained_fds[middle] < mappings[mapping].backing_fd) {
+                lower = middle + 1;
+            } else {
+                upper = middle;
+            }
+        }
+        if (lower == retained_fd_count ||
+            retained_fds[lower] != mappings[mapping].backing_fd) {
+            return false;
+        }
+    }
+    return true;
+}
