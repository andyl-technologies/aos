+/**
+ * qemu_crucible_hot_fork_apply_child_resources() - rebuild child resources
+ * @transaction: active authenticated immediate-child transaction
+ * @replacements: exact control and wake source-to-target descriptor pairs
+ * @retained_fds: sorted final descriptor table retained by the child
+ * @retained_fd_count: number of entries in @retained_fds
+ * @verify_descriptors: complete installed descriptor-table verifier
+ * @descriptor_opaque: caller-owned value passed to @verify_descriptors
+ * @reinitialize: child-only mapping and held-worker reconstruction operation
+ * @reinitialize_opaque: caller-owned value passed to @reinitialize
+ * @shared_mappings: exact writable shared VMAs expected after reconstruction
+ * @shared_mapping_count: number of entries in @shared_mappings
+ *
+ * Validates every immutable table before mutation, closes descriptor admission,
+ * applies the exact retained descriptor table, invokes one child reinitializer,
+ * and then authenticates the resulting writable-shared mapping table.  The
+ * reinitializer must leave every recreated worker and callback path held; this
+ * operation does not release guest or canonical-event admission. Every mapping
+ * backing descriptor must appear in the exact retained descriptor table.
+ *
+ * Once descriptor replacement begins, every nonzero result is destructive:
+ * the caller must terminate or quarantine the child.  A zero result records
+ * all three completed phases in @transaction.  This composition covers only
+ * the explicitly supplied resources and does not itself acknowledge QEMU
+ * readiness bit 7 or 8.
+ *
+ * Returns zero after exact descriptor, reinitializer, and mapping disposition,
+ * or a negative errno-style status on failure.
+ */
+int qemu_crucible_hot_fork_apply_child_resources(
+    QemuCrucibleHotForkDescriptorTableTransaction *transaction,
+    const QemuCrucibleHotForkDescriptorReplacement
+        replacements[QEMU_CRUCIBLE_HOT_FORK_ENDPOINT_REPLACEMENT_COUNT],
+    const int *retained_fds,
+    size_t retained_fd_count,
+    QemuCrucibleHotForkDescriptorVerifier verify_descriptors,
+    void *descriptor_opaque,
+    QemuCrucibleHotForkChildReinitializer reinitialize,
+    void *reinitialize_opaque,
+    const QemuCrucibleHotForkSharedMapping *shared_mappings,
+    size_t shared_mapping_count);
+
 #endif
