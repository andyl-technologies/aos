@@ -31,6 +31,7 @@
 #include "qemu/main-loop.h"
 #include "qemu/notify.h"
 #include "qemu/guest-random.h"
+#include "qemu/accel.h"
 #include "qemu/plugin.h"
 #include "exec/cpu-common.h"
 #include "accel/tcg/cpu-loop.h"
@@ -64,6 +65,33 @@ void rr_kick_vcpu_thread(CPUState *unused)
 static QEMUTimer *rr_kick_vcpu_timer;
 static CPUState *rr_current_cpu;
 
+static bool rr_crucible_sim_mode(void)
+{
+    return strcmp(current_accel_name(), "sim") == 0 &&
+           icount_enabled() == ICOUNT_PRECISE;
+}
+
+static bool rr_crucible_sim_single_vcpu(void)
+{
+    return rr_crucible_sim_mode() && first_cpu && !CPU_NEXT(first_cpu);
+}
+
+static CPUState *rr_crucible_sim_loop_cpu(CPUState *cpu)
+{
+    if (rr_crucible_sim_single_vcpu()) {
+        return first_cpu;
+    }
+    return cpu;
+}
+
+static void rr_crucible_sim_reset_exit_request(CPUState *cpu)
+{
+    if (!cpu) {
+        return;
+    }
+    qatomic_set_mb(&cpu->exit_request, 0);
+}
+
 static inline int64_t rr_next_kick_time(void)
 {
     return qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + TCG_KICK_PERIOD;
@@ -227,26 +255,6 @@ static void *rr_cpu_thread_fn(void *arg)
         /* Only used for icount_enabled() */
         int64_t cpu_budget = 0;
 
-        if (cpu) {
-            /*
-             * This could even reset exit_request for all CPUs, but in practice
