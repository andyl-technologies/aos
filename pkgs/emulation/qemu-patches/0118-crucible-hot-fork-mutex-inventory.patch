+void qemu_mutex_hot_fork_inventory(QemuMutexHotForkInventory *inventory)
+{
+    QemuMutex *mutex;
+    size_t count = 0;
+
+    *inventory = (QemuMutexHotForkInventory) { 0 };
+    crucible_hot_fork_mutex_registry_lock();
+    inventory->generation = crucible_hot_fork_mutex_generation;
+    for (mutex = crucible_hot_fork_mutexes; mutex;
+         mutex = mutex->crucible_hot_fork_next) {
+        if (count == QEMU_HOT_FORK_MUTEX_INVENTORY_MAX) {
+            inventory->overflowed = true;
+            break;
+        }
+        count++;
+    }
+    inventory->entries = g_new0(QemuMutexHotForkInventoryEntry, count);
+    inventory->entry_count = count;
+    count = 0;
+    for (mutex = crucible_hot_fork_mutexes; mutex;
+         mutex = mutex->crucible_hot_fork_next) {
+        QemuMutexHotForkInventoryEntry *entry;
+
+        if (count == inventory->entry_count) {
+            break;
+        }
+        entry = &inventory->entries[count++];
+        entry->mutex_id = mutex->crucible_hot_fork_id;
+        entry->owner_thread_id = qatomic_read(
+            &mutex->crucible_hot_fork_owner_thread_id);
+        entry->recursion_depth = qatomic_read(
+            &mutex->crucible_hot_fork_recursion_depth);
+        entry->acquisition_waiters = qatomic_read(
+            &mutex->crucible_hot_fork_acquisition_waiters);
+        entry->condition_waiters = qatomic_read(
+            &mutex->crucible_hot_fork_condition_waiters);
+        entry->recursive = mutex->crucible_hot_fork_recursive;
+        entry->unlock_active = qatomic_read(
+            &mutex->crucible_hot_fork_unlock_active);
+        entry->ownership_valid = qatomic_read(
+            &mutex->crucible_hot_fork_ownership_valid);
+    }
+    crucible_hot_fork_mutex_registry_unlock();
+}
+
+void qemu_mutex_hot_fork_inventory_destroy(
+    QemuMutexHotForkInventory *inventory)
+{
+    g_free(inventory->entries);
+    *inventory = (QemuMutexHotForkInventory) { 0 };
+}
