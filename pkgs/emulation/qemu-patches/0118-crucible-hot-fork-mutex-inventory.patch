+    qatomic_inc(&mutex->crucible_hot_fork_condition_waiters);
+    if (owner != qemu_get_thread_id() || depth != 1 ||
+        mutex->crucible_hot_fork_recursive) {
+        qatomic_set(&mutex->crucible_hot_fork_ownership_valid, false);
+    }
+    qatomic_set(&mutex->crucible_hot_fork_recursion_depth, 0);
+    qatomic_set(&mutex->crucible_hot_fork_owner_thread_id, 0);
+    crucible_hot_fork_mutex_registry_unlock();
+}
+
+static void crucible_hot_fork_mutex_condition_wait_end(QemuMutex *mutex)
+{
+    int64_t owner;
+    uint32_t depth;
+
+    crucible_hot_fork_mutex_registry_lock();
+    owner = qatomic_read(&mutex->crucible_hot_fork_owner_thread_id);
+    depth = qatomic_read(&mutex->crucible_hot_fork_recursion_depth);
+
+    if (owner != 0 || depth != 0) {
+        qatomic_set(&mutex->crucible_hot_fork_ownership_valid, false);
+    }
+    qatomic_set(&mutex->crucible_hot_fork_owner_thread_id,
+                qemu_get_thread_id());
+    qatomic_set(&mutex->crucible_hot_fork_recursion_depth, 1);
+    qatomic_dec(&mutex->crucible_hot_fork_condition_waiters);
+    crucible_hot_fork_mutex_registry_unlock();
