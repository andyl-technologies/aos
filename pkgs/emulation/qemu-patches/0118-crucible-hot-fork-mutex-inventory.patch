+CrucibleHotForkMutexInventory *
+qmp_query_crucible_hot_fork_mutex_inventory(Error **errp)
+{
+#ifdef CONFIG_POSIX
+    CrucibleHotForkMutexInventory *report =
+        g_new0(CrucibleHotForkMutexInventory, 1);
+    QemuMutexHotForkInventory inventory;
+    CrucibleHotForkMutexList **tail = &report->mutexes;
+    uint64_t previous_mutex_id = 0;
+    bool valid_entries = true;
+    size_t index;
+
+    report->schema_version = 1;
+    qemu_mutex_hot_fork_inventory(&inventory);
+    report->generation = inventory.generation;
+    for (index = 0; index < inventory.entry_count; index++) {
+        QemuMutexHotForkInventoryEntry *source = &inventory.entries[index];
+        CrucibleHotForkMutex *mutex =
+            g_new0(CrucibleHotForkMutex, 1);
+        CrucibleHotForkMutexList *node =
+            g_new0(CrucibleHotForkMutexList, 1);
+
+        mutex->mutex_id = source->mutex_id;
+        mutex->owner_thread_id = source->owner_thread_id;
+        mutex->recursion_depth = source->recursion_depth;
+        mutex->acquisition_waiters = source->acquisition_waiters;
+        mutex->condition_waiters = source->condition_waiters;
+        mutex->recursive = source->recursive;
+        mutex->unlock_active = source->unlock_active;
+        mutex->ownership_valid = source->ownership_valid;
+        if (source->mutex_id == 0 ||
+            (index != 0 && source->mutex_id <= previous_mutex_id) ||
+            source->owner_thread_id < 0 ||
+            ((source->owner_thread_id == 0) !=
+             (source->recursion_depth == 0))) {
+            valid_entries = false;
+        }
+        previous_mutex_id = source->mutex_id;
+        if (source->recursive) {
+            report->recursive_mutexes++;
+        }
+        if (source->owner_thread_id > 0) {
+            report->owned_mutexes++;
+        }
+        report->acquisition_waiters += source->acquisition_waiters;
+        report->condition_waiters += source->condition_waiters;
+        if (source->unlock_active) {
+            report->unlock_transitions++;
+        }
+        if (!source->ownership_valid) {
+            report->invalid_mutexes++;
+        }
+        node->value = mutex;
+        *tail = node;
+        tail = &node->next;
+    }
+    report->mutex_count = inventory.entry_count;
+    report->overflowed = inventory.overflowed;
+    report->complete = !inventory.overflowed && valid_entries &&
+        report->invalid_mutexes == 0;
+    qemu_mutex_hot_fork_inventory_destroy(&inventory);
+    return report;
+#else
+    error_setg(errp, "Crucible hot-fork mutex inventory requires POSIX");
+    return NULL;
+#endif
+}
