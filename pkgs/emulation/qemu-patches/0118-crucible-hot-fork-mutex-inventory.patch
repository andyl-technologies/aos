+static void crucible_hot_fork_mutex_registry_lock(void)
+{
+    int err = pthread_mutex_lock(&crucible_hot_fork_mutex_registry_guard);
+
+    if (err) {
+        error_exit(err, __func__);
+    }
+}
+
+static void crucible_hot_fork_mutex_registry_unlock(void)
+{
+    int err = pthread_mutex_unlock(&crucible_hot_fork_mutex_registry_guard);
+
+    if (err) {
+        error_exit(err, __func__);
+    }
+}
+
+static void crucible_hot_fork_mutex_register(QemuMutex *mutex, bool recursive)
+{
+    crucible_hot_fork_mutex_registry_lock();
+    mutex->crucible_hot_fork_id = crucible_hot_fork_mutex_next_id++;
+    assert(mutex->crucible_hot_fork_id != 0);
+    mutex->crucible_hot_fork_owner_thread_id = 0;
+    mutex->crucible_hot_fork_recursion_depth = 0;
+    mutex->crucible_hot_fork_acquisition_waiters = 0;
+    mutex->crucible_hot_fork_condition_waiters = 0;
+    mutex->crucible_hot_fork_recursive = recursive;
+    mutex->crucible_hot_fork_unlock_active = false;
+    mutex->crucible_hot_fork_ownership_valid = true;
+    mutex->crucible_hot_fork_next = NULL;
+    mutex->crucible_hot_fork_prev = crucible_hot_fork_mutexes_tail;
+    *crucible_hot_fork_mutexes_tail = mutex;
+    crucible_hot_fork_mutexes_tail = &mutex->crucible_hot_fork_next;
+    crucible_hot_fork_mutex_generation++;
+    crucible_hot_fork_mutex_registry_unlock();
+}
+
+static void crucible_hot_fork_mutex_unregister(QemuMutex *mutex)
+{
+    crucible_hot_fork_mutex_registry_lock();
+    *mutex->crucible_hot_fork_prev = mutex->crucible_hot_fork_next;
+    if (mutex->crucible_hot_fork_next) {
+        mutex->crucible_hot_fork_next->crucible_hot_fork_prev =
+            mutex->crucible_hot_fork_prev;
+    } else {
+        crucible_hot_fork_mutexes_tail = mutex->crucible_hot_fork_prev;
+    }
+    mutex->crucible_hot_fork_next = NULL;
+    mutex->crucible_hot_fork_prev = NULL;
+    crucible_hot_fork_mutex_generation++;
+    crucible_hot_fork_mutex_registry_unlock();
