+        if (depth == UINT32_MAX) {
+            qatomic_set(&mutex->crucible_hot_fork_ownership_valid, false);
+        } else {
+            qatomic_set(&mutex->crucible_hot_fork_recursion_depth, depth + 1);
+        }
+    } else {
+        if (owner != 0 || depth != 0) {
+            qatomic_set(&mutex->crucible_hot_fork_ownership_valid, false);
+        }
+        qatomic_set(&mutex->crucible_hot_fork_owner_thread_id, thread_id);
+        qatomic_set(&mutex->crucible_hot_fork_recursion_depth, 1);
+    }
+    qatomic_dec(&mutex->crucible_hot_fork_acquisition_waiters);
+    crucible_hot_fork_mutex_registry_unlock();
