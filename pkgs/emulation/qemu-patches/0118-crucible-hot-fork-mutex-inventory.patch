+
+static void crucible_hot_fork_mutex_unlock_begin(QemuMutex *mutex)
+{
+    int64_t thread_id;
+    int64_t owner;
+    uint32_t depth;
+
+    crucible_hot_fork_mutex_registry_lock();
+    thread_id = qemu_get_thread_id();
+    owner = qatomic_read(&mutex->crucible_hot_fork_owner_thread_id);
+    depth = qatomic_read(&mutex->crucible_hot_fork_recursion_depth);
+
+    qatomic_set(&mutex->crucible_hot_fork_unlock_active, true);
+    if (owner != thread_id || depth == 0) {
+        qatomic_set(&mutex->crucible_hot_fork_ownership_valid, false);
+    }
+    if (mutex->crucible_hot_fork_recursive && depth > 1) {
+        qatomic_set(&mutex->crucible_hot_fork_recursion_depth, depth - 1);
+    } else {
+        qatomic_set(&mutex->crucible_hot_fork_recursion_depth, 0);
+        qatomic_set(&mutex->crucible_hot_fork_owner_thread_id, 0);
+    }
+    crucible_hot_fork_mutex_registry_unlock();
+}
+
+static void crucible_hot_fork_mutex_unlock_end(QemuMutex *mutex)
