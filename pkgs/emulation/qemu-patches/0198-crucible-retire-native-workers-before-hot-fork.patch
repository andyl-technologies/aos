+    sigemptyset(&unblocked);
+    sigaddset(&unblocked, SIGALRM);
+    g_assert_cmpint(sigprocmask(SIG_UNBLOCK, &unblocked, NULL), ==, 0);
+    alarm(seconds);
+}
