+bool qemu_aio_hot_fork_thread_pools_empty(void)
+{
+    AioContext *ctx;
+    size_t count = 0;
+    QEMU_LOCK_GUARD(&crucible_hot_fork_aio_lock);
+
+    QTAILQ_FOREACH(ctx, &crucible_hot_fork_aio_contexts,
+                   crucible_hot_fork_node) {
+        if (++count > QEMU_AIO_HOT_FORK_INVENTORY_MAX ||
+            qatomic_read(&ctx->thread_pool)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+bool qemu_aio_hot_fork_prepare_thread_pools(Error **errp)
+{
+    AioContext *main_ctx = qemu_get_aio_context();
+    AioContext *ctx;
+    ThreadPoolAio *pool;
+    size_t count = 0;
+    bool supported = true;
+
+    if (!main_ctx || !qemu_in_main_thread() ||
+        qemu_get_current_aio_context() != main_ctx) {
+        error_setg(errp, "Crucible native worker retirement requires "
+                   "the main AioContext");
+        return false;
+    }
+    if (!qemu_bh_timer_hot_fork_admission_try_begin()) {
+        error_setg(errp, "Crucible native workers must retire before AIO barriers");
+        return false;
+    }
+
+    qemu_mutex_lock(&crucible_hot_fork_aio_lock);
+    QTAILQ_FOREACH(ctx, &crucible_hot_fork_aio_contexts,
+                   crucible_hot_fork_node) {
+        if (++count > QEMU_AIO_HOT_FORK_INVENTORY_MAX ||
+            (ctx != main_ctx && qatomic_read(&ctx->thread_pool))) {
+            supported = false;
+            break;
+        }
+    }
+    qemu_mutex_unlock(&crucible_hot_fork_aio_lock);
+    pool = qatomic_read(&main_ctx->thread_pool);
+    if (!supported || !thread_pool_is_empty_aio(pool)) {
+        error_setg(errp, "Crucible native worker retirement requires "
+                   "drained main-context work only");
+        qemu_bh_timer_hot_fork_admission_end();
+        return false;
+    }
+
+    /*
+     * Destroy the live workers and their synchronization objects in the parent.
+     * Copying idle counts or resetting inherited condition variables in the
+     * child would leave requests waiting for threads that no longer exist.
+     * Neither native guest state nor pool sizing policy changes; after abort
+     * or child reconstruction, ordinary I/O creates a fresh pool lazily.
+     */
+    qatomic_set(&main_ctx->thread_pool, NULL);
+    thread_pool_free_aio(pool);
+    qemu_bh_timer_hot_fork_admission_end();
+    return true;
+}
+
