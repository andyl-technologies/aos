+static void test_hot_fork_unowned_writable_source(void)
+{
+    QDict *options = qdict_new();
+    BlockDriverState *node;
+    QemuBlockBackendHotForkInventory backends;
+
+    qdict_put_str(options, "driver", "null-co");
+    qdict_put_str(options, "node-name", "crucible-unowned-vmstate");
+    qdict_put_int(options, "size", 4096);
+    node = bdrv_open(NULL, NULL, options, BDRV_O_RDWR, &error_abort);
+    g_assert_nonnull(node);
+    qemu_block_backend_hot_fork_inventory(&backends);
+    g_assert_cmpuint(backends.entry_count, ==, 0);
+    qemu_block_backend_hot_fork_inventory_destroy(&backends);
+
+    /* Backend enumeration alone misses the production VMState node shape. */
+    g_assert_false(qemu_block_hot_fork_all_sources_read_only(NULL));
+    bdrv_unref(node);
+    g_assert_true(qemu_block_hot_fork_all_sources_read_only(&error_abort));
+}
