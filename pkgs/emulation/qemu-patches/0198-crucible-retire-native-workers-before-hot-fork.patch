+static void test_hot_fork_native_io_after_worker_retirement(void)
+{
+    char source_path[] = "/tmp/qemu-hot-fork-io-source-XXXXXX";
+    char child_path[] = "/tmp/qemu-hot-fork-io-child-XXXXXX";
+    AioContext *ctx = qemu_get_aio_context();
+    int original_min = ctx->thread_pool_min;
+    int original_max = ctx->thread_pool_max;
+    QemuBlockBackendHotForkReadOnlySource *source;
+    BlockBackend *blk, *private;
+    QDict *options;
+    uint8_t original[1024], observed[1024], changed[512];
+    int source_fd = mkstemp(source_path);
+    int child_fd = mkstemp(child_path);
+    pid_t child;
+    int status;
+
+    g_assert_cmpint(source_fd, >=, 0);
+    g_assert_cmpint(child_fd, >=, 0);
+    close(source_fd);
+    close(child_fd);
+    bdrv_img_create(source_path, "qcow2", NULL, NULL, NULL,
+                    HOT_FORK_SNAPSHOT_SIZE, BDRV_O_RDWR, true, &error_abort);
+    bdrv_img_create(child_path, "qcow2", source_path, "qcow2", NULL,
+                    HOT_FORK_SNAPSHOT_SIZE, BDRV_O_RDWR, true, &error_abort);
+    options = qdict_new();
+    qdict_put_str(options, "driver", "qcow2");
+    qdict_put_str(options, "node-name", "crucible-frozen-io-source");
+    qdict_put_str(options, "file.driver", "file");
+    qdict_put_str(options, "file.filename", source_path);
+    blk = blk_new_open(NULL, NULL, options, BDRV_O_RDWR, &error_abort);
+    g_assert_nonnull(blk);
+    ctx->thread_pool_min = 1;
+    /* No child may mask the inherited-worker bug by spawning a spare worker. */
+    ctx->thread_pool_max = 1;
+    thread_pool_update_params(aio_get_thread_pool(ctx), ctx);
+    memset(original, 0x37, sizeof(original));
+    memset(changed, 0xa5, sizeof(changed));
+    g_assert_cmpint(blk_pwrite(blk, 0, sizeof(original), original, 0), ==, 0);
+    source = qemu_block_backend_hot_fork_read_only_source_new(blk, &error_abort);
+    g_assert_true(qemu_block_backend_hot_fork_read_only_source_freeze(
+        source, &error_abort));
+    g_assert_true(qemu_block_hot_fork_all_sources_read_only(&error_abort));
+    g_assert_nonnull(ctx->thread_pool);
+
+    /* The inherited idle count cannot service even a native read. */
+    child = fork();
+    g_assert_cmpint(child, >=, 0);
+    if (child == 0) {
+        test_hot_fork_child_alarm(2);
+        blk_pread(blk, 0, sizeof(observed), observed, 0);
+        _exit(1);
+    }
+    g_assert_cmpint(waitpid(child, &status, 0), ==, child);
+    g_assert_true(WIFSIGNALED(status));
+    g_assert_cmpint(WTERMSIG(status), ==, SIGALRM);
+
+    g_assert_true(qemu_aio_hot_fork_prepare_thread_pools(&error_abort));
+    g_assert_true(qemu_aio_hot_fork_thread_pools_empty());
+    child = fork();
+    g_assert_cmpint(child, >=, 0);
+    if (child == 0) {
+        test_hot_fork_child_alarm(10);
+        g_assert_null(ctx->thread_pool);
+        g_assert_cmpint(blk_pread(blk, 0, sizeof(observed), observed, 0), ==, 0);
+        g_assert_cmpmem(observed, sizeof(observed), original, sizeof(original));
+        g_assert_nonnull(ctx->thread_pool);
+
+        options = qdict_new();
+        qdict_put_str(options, "driver", "qcow2");
+        qdict_put_str(options, "file.driver", "file");
+        qdict_put_str(options, "file.filename", child_path);
+        qdict_put_str(options, "backing", "crucible-frozen-io-source");
+        private = blk_new_open(NULL, NULL, options, BDRV_O_RDWR, &error_abort);
+        g_assert_nonnull(private);
+        g_assert_cmpint(blk_pwrite(private, 0, sizeof(changed), changed, 0), ==, 0);
+        g_assert_cmpint(blk_flush(private), ==, 0);
+        blk_unref(private);
+        _exit(0);
+    }
+    g_assert_cmpint(waitpid(child, &status, 0), ==, child);
+    g_assert_true(WIFEXITED(status));
+    g_assert_cmpint(WEXITSTATUS(status), ==, 0);
+
+    /* Read the child's durable image through a fresh graph, not its caches. */
+    options = qdict_new();
+    qdict_put_str(options, "driver", "qcow2");
+    qdict_put_str(options, "file.driver", "file");
+    qdict_put_str(options, "file.filename", child_path);
+    private = blk_new_open(NULL, NULL, options, 0, &error_abort);
+    g_assert_cmpint(blk_pread(private, 0, sizeof(observed), observed, 0), ==, 0);
+    g_assert_cmpmem(observed, sizeof(changed), changed, sizeof(changed));
+    g_assert_cmpmem(observed + sizeof(changed), sizeof(changed),
+                    original + sizeof(changed), sizeof(changed));
+    blk_unref(private);
+    g_assert_cmpint(blk_pread(blk, 0, sizeof(observed), observed, 0), ==, 0);
+    g_assert_cmpmem(observed, sizeof(observed), original, sizeof(original));
+    g_assert_true(qemu_block_backend_hot_fork_read_only_source_restore(
+        source, &error_abort));
+    g_assert_true(qemu_block_backend_hot_fork_read_only_source_free(
+        source, &error_abort));
+    blk_unref(blk);
+    ctx->thread_pool_min = original_min;
+    ctx->thread_pool_max = original_max;
+    g_assert_true(qemu_aio_hot_fork_prepare_thread_pools(&error_abort));
+    unlink(child_path);
+    unlink(source_path);
+}
