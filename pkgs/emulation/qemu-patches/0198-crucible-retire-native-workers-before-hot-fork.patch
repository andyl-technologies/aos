+static int test_hot_fork_worker_request(void *opaque)
+{
+    return 0;
+}
+
+static void test_hot_fork_worker_completed(void *opaque, int ret)
+{
+    g_assert_cmpint(ret, ==, 0);
+    *(bool *)opaque = true;
+}
+
+static void test_hot_fork_pending_native_worker(void)
+{
+    AioContext *ctx = qemu_get_aio_context();
+    bool completed = false;
+    ThreadPoolAio *pool;
+
+    thread_pool_submit_aio(test_hot_fork_worker_request, NULL,
+                           test_hot_fork_worker_completed, &completed);
+    pool = ctx->thread_pool;
+    g_assert_nonnull(pool);
+    g_assert_false(qemu_aio_hot_fork_prepare_thread_pools(NULL));
+    g_assert_true(pool == ctx->thread_pool);
+    g_assert_false(completed);
+    while (!completed) {
+        aio_poll(ctx, true);
+    }
+    g_assert_true(qemu_aio_hot_fork_prepare_thread_pools(&error_abort));
+    g_assert_null(ctx->thread_pool);
+    g_assert_true(qemu_aio_hot_fork_thread_pools_empty());
+}
+
+static void test_hot_fork_native_worker_retirement_rejections(void)
+{
+    AioContext *ctx = qemu_get_aio_context();
+    AioContext *foreign = aio_context_new(&error_abort);
+    ThreadPoolAio *main_pool = aio_get_thread_pool(ctx);
+    ThreadPoolAio *foreign_pool = aio_get_thread_pool(foreign);
+    QemuBhTimerHotForkBarrierInventory barrier;
+
+    /* A foreign context must reject the entire operation without effects. */
+    g_assert_false(qemu_aio_hot_fork_prepare_thread_pools(NULL));
+    g_assert_true(ctx->thread_pool == main_pool);
+    g_assert_true(foreign->thread_pool == foreign_pool);
+    g_assert_false(qemu_aio_hot_fork_thread_pools_empty());
+    aio_context_unref(foreign);
+
+    /* Retirement cannot wait behind barriers owned by its own coordinator. */
+    qemu_bh_timer_hot_fork_barrier(QEMU_BH_TIMER_HOT_FORK_BARRIER_HOLD,
+                                  &barrier);
+    g_assert_true(barrier.held);
+    g_assert_false(qemu_aio_hot_fork_prepare_thread_pools(NULL));
+    g_assert_true(ctx->thread_pool == main_pool);
+    qemu_bh_timer_hot_fork_barrier(QEMU_BH_TIMER_HOT_FORK_BARRIER_RELEASE,
+                                  &barrier);
+    g_assert_false(barrier.held);
+    g_assert_true(qemu_aio_hot_fork_prepare_thread_pools(&error_abort));
+    g_assert_null(ctx->thread_pool);
+    g_assert_true(qemu_aio_hot_fork_thread_pools_empty());
+}
