+    return true;
+}
+
+static void rr_crucible_sim_maybe_rearm_idle_callback(
+    bool *idle_reported, bool *idle_advance_waiting)
+{
+    if (!rr_crucible_sim_mode() || !*idle_advance_waiting ||
+        qemu_plugin_time_advance_is_pending()) {
+        return;
+    }
+
+    /*
+     * Completion ran in the normal main loop without making a vCPU runnable.
+     * Re-enter the idle callback for the next authorized jump instead of
+     * reporting a guest resume that never happened.
+     */
+    *idle_advance_waiting = false;
+    *idle_reported = false;
+}
+
+static void rr_crucible_sim_process_queued_idle_advance(
+    CPUState *cpu, bool idle_callback_fired, bool idle_advance_waiting)
+{
+    if (!rr_crucible_sim_mode() || !idle_callback_fired ||
+        !idle_advance_waiting) {
+        return;
+    }
+
+    /*
+     * The all-idle callback just queued exactly one vCPU work item. Process it
+     * before testing all_cpu_threads_idle(), whose work-list check would
+     * otherwise misclassify the queue handoff as a guest resume.
+     */
+    qemu_wait_io_event_common(cpu);
+}
+
+static void rr_crucible_sim_maybe_fire_resume_callback(CPUState *cpu,
+                                                       bool *idle_reported)
+{
+    if (!rr_crucible_sim_mode() || !*idle_reported) {
+        return;
+    }
+
+    qemu_plugin_maybe_fire_vcpu_resume_cb(cpu);
+    *idle_reported = false;
+}
