+static bool crucible_shmem_plugin_state_matches(
+    const uint8_t *state, uint32_t state_len, uint64_t request_epoch,
+    uint32_t next_request_id)
+{
+    return state &&
+           state_len >= CRUCIBLE_BLOCK_TRANSPORT_STATE_HEADER_SIZE &&
+           memcmp(state, "CBTS", 4) == 0 && lduw_le_p(state + 4) == 1 &&
+           lduw_le_p(state + 6) == 0 &&
+           ldq_le_p(state + 8) == request_epoch &&
+           ldl_le_p(state + 16) == next_request_id;
+}
+
+static int crucible_shmem_pre_save(void *opaque)
+{
+    BDRVCrucibleShmemState *s = opaque;
+    int64_t len;
+    int64_t written;
+
+    if (!crucible_blk_transport_save_cb ||
+        !crucible_blk_transport_restore_cb) {
+        return -ENODEV;
+    }
+    qemu_mutex_lock(&s->pending_lock);
+    s->vmstate_request_epoch = s->request_epoch;
+    s->vmstate_next_request_id = s->next_request_id;
+    s->vmstate_recovery_deadline_ns = s->recovery_deadline_ns;
+    s->vmstate_recovery_unadmitted = s->recovery_unadmitted;
+    s->vmstate_recovery_failure = s->recovery_failure;
+    qemu_mutex_unlock(&s->pending_lock);
+    len = crucible_blk_transport_save_cb(NULL, 0,
+                                         crucible_blk_event_userdata);
+    if (len < CRUCIBLE_BLOCK_TRANSPORT_STATE_HEADER_SIZE ||
+        len > CRUCIBLE_BLOCK_TRANSPORT_STATE_MAX || len > UINT32_MAX) {
+        return -EINVAL;
+    }
+    g_free(s->vmstate_plugin_state);
+    s->vmstate_plugin_state = g_try_malloc(len);
+    if (!s->vmstate_plugin_state) {
+        s->vmstate_plugin_state_len = 0;
+        return -ENOMEM;
+    }
+    s->vmstate_plugin_state_len = len;
+    written = crucible_blk_transport_save_cb(s->vmstate_plugin_state,
+                                              s->vmstate_plugin_state_len,
+                                              crucible_blk_event_userdata);
+    if (written != len ||
+        !crucible_shmem_plugin_state_matches(
+            s->vmstate_plugin_state, s->vmstate_plugin_state_len,
+            s->vmstate_request_epoch, s->vmstate_next_request_id)) {
+        return -EINVAL;
+    }
+    return 0;
+}
+
+static int crucible_shmem_pre_load(void *opaque)
+{
+    BDRVCrucibleShmemState *s = opaque;
+
+    g_free(s->vmstate_plugin_state);
+    s->vmstate_plugin_state = NULL;
+    s->vmstate_plugin_state_len = 0;
+    return 0;
+}
+
+static int crucible_shmem_post_load(void *opaque, int version_id)
+{
+    BDRVCrucibleShmemState *s = opaque;
+
+    if (version_id != 1 ||
+        s->vmstate_recovery_unadmitted > 1 ||
+        s->vmstate_recovery_failure < CRUCIBLE_BLOCK_ERROR_MIN ||
+        s->vmstate_recovery_failure > CRUCIBLE_BLOCK_ERROR_MAX ||
+        s->vmstate_plugin_state_len > CRUCIBLE_BLOCK_TRANSPORT_STATE_MAX ||
+        !crucible_shmem_plugin_state_matches(
+            s->vmstate_plugin_state, s->vmstate_plugin_state_len,
+            s->vmstate_request_epoch, s->vmstate_next_request_id) ||
+        !crucible_blk_transport_restore_cb) {
+        return -EINVAL;
+    }
+    if (crucible_blk_transport_restore_cb(
+            s->vmstate_plugin_state, s->vmstate_plugin_state_len,
+            s->vmstate_request_epoch, s->vmstate_next_request_id,
+            crucible_blk_event_userdata) != 0) {
+        return -EINVAL;
+    }
+    qemu_mutex_lock(&s->pending_lock);
+    s->request_epoch = s->vmstate_request_epoch;
+    s->next_request_id = s->vmstate_next_request_id;
+    s->recovery_deadline_ns = s->vmstate_recovery_deadline_ns;
+    s->recovery_unadmitted = s->vmstate_recovery_unadmitted;
+    s->recovery_failure = s->vmstate_recovery_failure;
+    qemu_mutex_unlock(&s->pending_lock);
+    return 0;
+}
