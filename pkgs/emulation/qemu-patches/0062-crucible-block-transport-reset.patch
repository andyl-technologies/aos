+static int crucible_shmem_get_plugin_state(QEMUFile *f, void *opaque,
+                                            size_t size,
+                                            const VMStateField *field)
+{
+    BDRVCrucibleShmemState *s = opaque;
+    uint8_t *state;
+    uint32_t len;
+
+    (void)size;
+    (void)field;
+    len = qemu_get_be32(f);
+    if (qemu_file_get_error(f) ||
+        len < CRUCIBLE_BLOCK_TRANSPORT_STATE_HEADER_SIZE ||
+        len > CRUCIBLE_BLOCK_TRANSPORT_STATE_MAX) {
+        return -EINVAL;
+    }
+    state = g_try_malloc(len);
+    if (!state) {
+        return -ENOMEM;
+    }
+    if (qemu_get_buffer(f, state, len) != len) {
+        g_free(state);
+        return -EINVAL;
+    }
+    g_free(s->vmstate_plugin_state);
+    s->vmstate_plugin_state = state;
+    s->vmstate_plugin_state_len = len;
+    return 0;
+}
