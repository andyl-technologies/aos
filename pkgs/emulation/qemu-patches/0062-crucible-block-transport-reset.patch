+        virtio_blk_init_request(s, virtio_get_queue(vdev, vq_idx), req);
+        req->next = head;
+        head = req;
+    }
+    WITH_QEMU_LOCK_GUARD(&s->rq_lock) {
+        while (head) {
+            VirtIOBlockReq *req = head;
