+static int virtio_blk_get_dropped_requests(QEMUFile *f, void *opaque,
+                                            size_t size,
+                                            const VMStateField *field)
+{
+    VirtIOBlock *s = opaque;
+    VirtIODevice *vdev = VIRTIO_DEVICE(s);
+    VirtIOBlockReq *head = NULL;
+    uint32_t count;
+    uint32_t i;
+
+    (void)size;
+    (void)field;
+    if (!blk_bs(s->blk) || !blk_bs(s->blk)->drv ||
+        !blk_bs(s->blk)->drv->bdrv_guest_completion_dropped) {
+        return -EINVAL;
+    }
+    count = qemu_get_be32(f);
+    if (qemu_file_get_error(f) ||
+        count > VIRTIO_BLK_DROPPED_REQUESTS_MAX ||
+        count > (uint64_t)s->conf.num_queues * s->conf.queue_size) {
+        return -EINVAL;
+    }
+    for (i = 0; i < count; i++) {
+        uint32_t vq_idx = qemu_get_be32(f);
+        VirtIOBlockReq *req;
+
+        if (qemu_file_get_error(f) || vq_idx >= s->conf.num_queues) {
+            goto fail;
+        }
+        req = qemu_get_virtqueue_element_checked(
+            vdev, f, sizeof(VirtIOBlockReq));
+        if (!req) {
