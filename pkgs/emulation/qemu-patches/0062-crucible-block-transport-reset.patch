+static int crucible_shmem_next_request_identity(BDRVCrucibleShmemState *s,
+                                                uint64_t *epoch,
+                                                uint32_t *request_id)
 {
+    qemu_mutex_lock(&s->pending_lock);
     if (s->next_request_id == UINT32_MAX) {
+        qemu_mutex_unlock(&s->pending_lock);
         return -EOVERFLOW;
     }
 
+    *epoch = s->request_epoch;
     *request_id = s->next_request_id++;
+    qemu_mutex_unlock(&s->pending_lock);
     return 0;
 }
 
+static int coroutine_fn
+crucible_shmem_admit_after_recovery(BDRVCrucibleShmemState *s)
+{
+    while (true) {
+        int64_t deadline;
+        int64_t now;
+        uint8_t unadmitted;
+        uint8_t failure;
+
+        qemu_mutex_lock(&s->pending_lock);
+        deadline = s->recovery_deadline_ns;
+        unadmitted = s->recovery_unadmitted;
+        failure = s->recovery_failure;
+        qemu_mutex_unlock(&s->pending_lock);
+        now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+        if (now >= deadline) {
+            return 0;
+        }
+        if (unadmitted == 0) {
+            return -crucible_shmem_failure_errno(failure);
+        }
+        qemu_co_sleep_ns(QEMU_CLOCK_VIRTUAL, deadline - now);
+    }
+}
