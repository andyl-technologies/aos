+static int crucible_shmem_failure_errno(uint8_t failure)
+{
+    static const int errors[] = {
+        ENOMEDIUM, EROFS, EINVAL, EBUSY, ETIMEDOUT, EIO,
+        EILSEQ, EIO, ENOSPC, ENOENT, ESTALE,
+    };
+
+    return failure >= CRUCIBLE_BLOCK_ERROR_MIN &&
+           failure <= G_N_ELEMENTS(errors) ? errors[failure - 1] : EIO;
+}
+
+static bool crucible_shmem_response_header_valid(const uint8_t *event,
+                                                 size_t len)
+{
+    uint32_t count;
+
+    if (len < CRUCIBLE_BLOCK_RESPONSE_HEADER_SIZE ||
+        event[1] != CRUCIBLE_BLOCK_WIRE_VERSION || event[2] != 0 ||
+        event[3] != 0) {
+        return false;
+    }
+    count = ldl_le_p(event + 16);
+    return count == len - CRUCIBLE_BLOCK_RESPONSE_HEADER_SIZE;
+}
+
+typedef struct CrucibleBlockResetDecoded {
+    uint64_t next_epoch;
+    int64_t recovery_deadline_ns;
+    uint8_t request_id_rule;
+    uint8_t unadmitted;
+    uint8_t failure;
+    bool notify_topology;
+} CrucibleBlockResetDecoded;
+
+static bool crucible_shmem_validate_reset(BDRVCrucibleShmemState *s,
+                                          const uint8_t *event, size_t len,
+                                          CrucibleBlockResetDecoded *decoded)
+{
+    const uint8_t *reset;
+    uint64_t next_epoch;
+    uint64_t recovery_ns;
+    int64_t now_ns;
+
+    if (len != CRUCIBLE_BLOCK_EVENT_SIZE ||
+        !crucible_shmem_response_header_valid(event, len) ||
+        event[0] != CRUCIBLE_BLOCK_STATUS_RESET) {
+        return false;
+    }
+    reset = event + 20;
+    next_epoch = ldq_le_p(reset);
+    recovery_ns = ldq_le_p(reset + 8);
+    if ((reset[16] == 0 && next_epoch != s->request_epoch) ||
+        (reset[16] == 1 &&
+         (s->request_epoch == UINT64_MAX || next_epoch != s->request_epoch + 1)) ||
+        reset[16] > 1 || reset[17] > 1 || reset[18] > 1 ||
+        reset[20] > 1 || reset[21] > 2 || reset[22] > 2 ||
+        reset[19] < CRUCIBLE_BLOCK_ERROR_MIN ||
+        reset[19] > CRUCIBLE_BLOCK_ERROR_MAX || reset[23] > 3 ||
+        reset[24] > 4 || reset[25] > 1 || reset[26] > 1 ||
+        !buffer_is_zero(reset + 27, 5)) {
+        return false;
+    }
+    now_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    if (recovery_ns > INT64_MAX || now_ns > INT64_MAX - (int64_t)recovery_ns) {
+        return false;
+    }
+
+    decoded->next_epoch = next_epoch;
+    decoded->recovery_deadline_ns = now_ns + (int64_t)recovery_ns;
+    decoded->request_id_rule = reset[16];
+    decoded->unadmitted = reset[20];
+    decoded->failure = reset[19];
+    decoded->notify_topology = reset[17] == 1;
+    return true;
+}
+
+static void crucible_shmem_apply_reset(BDRVCrucibleShmemState *s,
+                                       const CrucibleBlockResetDecoded *reset)
+{
+    qemu_mutex_lock(&s->pending_lock);
+    s->request_epoch = reset->next_epoch;
+    if (reset->request_id_rule == 1) {
+        s->next_request_id = 0;
+    }
+    s->recovery_deadline_ns = reset->recovery_deadline_ns;
+    s->recovery_unadmitted = reset->unadmitted;
+    s->recovery_failure = reset->failure;
+    qemu_mutex_unlock(&s->pending_lock);
+}
+
+static bool crucible_shmem_poll_events(BDRVCrucibleShmemState *s)
+{
+    uint8_t event[CRUCIBLE_BLOCK_EVENT_SIZE];
+    int64_t ret;
+
+    if (!crucible_blk_event_cb) {
+        return true;
+    }
+    do {
+        CrucibleBlockResetDecoded reset = { 0 };
+        bool is_reset = false;
+
+        ret = crucible_blk_event_cb(event, sizeof(event),
+                                    crucible_blk_event_userdata);
+        if (ret < 0) {
+            return false;
+        }
+        if (ret == 0) {
+            continue;
+        }
+        if (!crucible_shmem_response_header_valid(event, ret)) {
+            return false;
+        }
+        switch (event[0]) {
+        case CRUCIBLE_BLOCK_STATUS_RESET:
+            if (!crucible_shmem_validate_reset(s, event, ret, &reset)) {
+                return false;
+            }
+            is_reset = true;
+            break;
+        case CRUCIBLE_BLOCK_STATUS_DUPLICATE_IGNORED:
+            if (ret != CRUCIBLE_BLOCK_RESPONSE_HEADER_SIZE) {
+                return false;
+            }
+            break;
+        case CRUCIBLE_BLOCK_STATUS_DUPLICATE_ERROR:
+            if (ret != CRUCIBLE_BLOCK_RESPONSE_HEADER_SIZE + 1 ||
+                event[CRUCIBLE_BLOCK_RESPONSE_HEADER_SIZE] <
+                    CRUCIBLE_BLOCK_ERROR_MIN ||
+                event[CRUCIBLE_BLOCK_RESPONSE_HEADER_SIZE] >
+                    CRUCIBLE_BLOCK_ERROR_MAX) {
+                return false;
+            }
+            break;
+        default:
+            return false;
+        }
+        if (!crucible_blk_event_commit_cb ||
+            crucible_blk_event_commit_cb(crucible_blk_event_userdata) != 0) {
+            return false;
+        }
+        if (is_reset) {
+            crucible_shmem_apply_reset(s, &reset);
+        }
+        if (is_reset && reset.notify_topology) {
+            bdrv_notify_topology_change(s->bs);
+        }
+    } while (ret > 0);
+    return true;
+}
