+static void test_child_resource_plan_composition_is_exact(void)
+{
+    uint64_t page_size = qemu_real_host_page_size();
+    struct qemu_plugin_crucible_hot_fork_child_plan plan = {
+        .schema_version = QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PLAN_VERSION,
+        .struct_size = sizeof(plan),
+        .parent_process_generation = 10,
+        .child_process_generation = 11,
+        .template_generation = 1,
+        .private_ring_generation = 2,
+        .plugin_endpoint_generation = 3,
+        .plugin_barrier_generation = 4,
+        .control_socket_cookie = 5,
+        .wake_eventfd_id = 6,
+        .shmem_device = 7,
+        .shmem_inode = 8,
+        .shmem_length = page_size,
+        .source_mapping_start = page_size,
+        .source_mapping_length = page_size,
+        .source_mapping_offset = 0,
+        .private_ring_fd = 7,
+        .control_fd = 3,
+        .wake_fd = 5,
+        .reserved_fd = -1,
+        .worker_mask = QEMU_PLUGIN_CRUCIBLE_WORKER_REQUIRED,
+    };
+    QemuCrucibleHotForkPluginChildResourcePlan plugin;
+    g_autofree QemuCrucibleHotForkChildResourcePlan *resources =
+        g_new0(QemuCrucibleHotForkChildResourcePlan, 1);
+    const int retained_fds[] = { 4, 9 };
+    const int unsorted_fds[] = { 9, 4 };
+    const int source_fd[] = { 31 };
+    QemuCrucibleHotForkSharedMapping mapping = {
+        .start = 3 * page_size,
+        .length = page_size,
+        .offset = 0,
+        .backing_fd = 9,
+    };
+    QemuCrucibleHotForkSharedMapping overlap = {
+        .start = page_size,
+        .length = page_size,
+        .offset = 0,
+        .backing_fd = 9,
+    };
+    QemuCrucibleHotForkSharedMapping missing_backing = {
+        .start = 5 * page_size,
+        .length = page_size,
+        .offset = 0,
+        .backing_fd = 10,
+    };
+
+    g_assert_cmpint(qemu_crucible_hot_fork_prepare_plugin_child_resources(
+                        &plugin, &plan, 31, 32),
+                    ==, 0);
+    g_assert_cmpint(qemu_crucible_hot_fork_begin_child_resource_plan(
+                        resources, &plugin),
+                    ==, 0);
+    g_assert_true(resources->building);
+    g_assert_false(resources->sealed);
+    g_assert_cmpint(qemu_crucible_hot_fork_merge_child_resource_contribution(
+                        resources, retained_fds, G_N_ELEMENTS(retained_fds),
+                        &mapping, 1),
+                    ==, 0);
+    g_assert_cmpuint(resources->retained_fd_count, ==, 5);
+    g_assert_cmpint(resources->retained_fds[0], ==, 3);
+    g_assert_cmpint(resources->retained_fds[1], ==, 4);
+    g_assert_cmpint(resources->retained_fds[2], ==, 5);
+    g_assert_cmpint(resources->retained_fds[3], ==, 7);
+    g_assert_cmpint(resources->retained_fds[4], ==, 9);
+    g_assert_cmpuint(resources->shared_mapping_count, ==, 2);
+    g_assert_cmpuint(resources->shared_mappings[0].start, ==, page_size);
+    g_assert_cmpuint(resources->shared_mappings[1].start, ==, 3 * page_size);
+
+    g_assert_cmpint(qemu_crucible_hot_fork_merge_child_resource_contribution(
+                        resources, retained_fds, G_N_ELEMENTS(retained_fds),
+                        &mapping, 1),
+                    ==, 0);
+    g_assert_cmpuint(resources->retained_fd_count, ==, 5);
+    g_assert_cmpuint(resources->shared_mapping_count, ==, 2);
+    g_assert_cmpint(qemu_crucible_hot_fork_merge_child_resource_contribution(
+                        resources, unsorted_fds,
+                        G_N_ELEMENTS(unsorted_fds), NULL, 0),
+                    ==, -EINVAL);
+    g_assert_cmpint(qemu_crucible_hot_fork_merge_child_resource_contribution(
+                        resources, source_fd, G_N_ELEMENTS(source_fd), NULL,
+                        0),
+                    ==, -EINVAL);
+    g_assert_cmpint(qemu_crucible_hot_fork_merge_child_resource_contribution(
+                        resources, NULL, 0, &overlap, 1),
+                    ==, -EINVAL);
+    g_assert_cmpint(qemu_crucible_hot_fork_merge_child_resource_contribution(
+                        resources, NULL, 0, &missing_backing, 1),
+                    ==, -EINVAL);
+    g_assert_cmpuint(resources->retained_fd_count, ==, 5);
+    g_assert_cmpuint(resources->shared_mapping_count, ==, 2);
+
+    g_assert_cmpint(qemu_crucible_hot_fork_seal_child_resource_plan(resources),
+                    ==, 0);
+    g_assert_false(resources->building);
+    g_assert_true(resources->sealed);
+    g_assert_true(
+        qemu_crucible_hot_fork_child_resource_plan_contains_plugin(
+            resources, &plugin));
+    g_assert_cmpint(qemu_crucible_hot_fork_merge_child_resource_contribution(
+                        resources, NULL, 0, NULL, 0),
+                    ==, -EPERM);
+    resources->retained_fds[1] = resources->retained_fds[0];
+    g_assert_false(
+        qemu_crucible_hot_fork_child_resource_plan_contains_plugin(
+            resources, &plugin));
+    qemu_crucible_hot_fork_reset_child_resource_plan(resources);
+    g_assert_false(
+        qemu_crucible_hot_fork_child_resource_plan_contains_plugin(
+            resources, &plugin));
+}
