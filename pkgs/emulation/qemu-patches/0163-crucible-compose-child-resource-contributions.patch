+static bool crucible_hot_fork_plugin_resources_valid(
+    const QemuCrucibleHotForkPluginChildResourcePlan *resources)
+{
+    return resources && resources->prepared &&
+        qemu_crucible_hot_fork_plugin_child_resources_prepared_for(
+            resources, &resources->plan,
+            resources->replacements[0].source_fd,
+            resources->replacements[1].source_fd);
+}
+
+static bool crucible_hot_fork_fd_table_valid(const int *fds, size_t count)
+{
+    size_t index;
+
+    if (count != 0 && !fds) {
+        return false;
+    }
+    for (index = 0; index < count; index++) {
+        if (fds[index] < 0 ||
+            (index != 0 && fds[index - 1] >= fds[index])) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool crucible_hot_fork_fd_table_contains(
+    const int *fds, size_t count, int fd)
+{
+    size_t low = 0;
+    size_t high = count;
+
+    while (low < high) {
+        size_t middle = low + (high - low) / 2;
+
+        if (fds[middle] < fd) {
+            low = middle + 1;
+        } else {
+            high = middle;
+        }
+    }
+    return low < count && fds[low] == fd;
+}
+
+static bool crucible_hot_fork_mapping_equal(
+    const QemuCrucibleHotForkSharedMapping *left,
+    const QemuCrucibleHotForkSharedMapping *right)
+{
+    return left->start == right->start && left->length == right->length &&
+        left->offset == right->offset &&
+        left->backing_fd == right->backing_fd;
+}
+
+static bool crucible_hot_fork_mapping_valid(
+    const QemuCrucibleHotForkSharedMapping *mapping)
+{
+    uint64_t page_size = qemu_real_host_page_size();
+
+    return mapping->start != 0 && mapping->length != 0 &&
+        mapping->backing_fd >= 0 &&
+        QEMU_IS_ALIGNED(mapping->start, page_size) &&
+        QEMU_IS_ALIGNED(mapping->length, page_size) &&
+        QEMU_IS_ALIGNED(mapping->offset, page_size) &&
+        mapping->start <= UINTPTR_MAX && mapping->length <= SIZE_MAX &&
+        mapping->start <= UINTPTR_MAX - mapping->length &&
+        mapping->offset <= UINT64_MAX - mapping->length;
+}
+
+static bool crucible_hot_fork_mapping_table_valid(
+    const QemuCrucibleHotForkSharedMapping *mappings, size_t count)
+{
+    size_t index;
+
+    if (count != 0 && !mappings) {
+        return false;
+    }
+    for (index = 0; index < count; index++) {
+        if (!crucible_hot_fork_mapping_valid(&mappings[index]) ||
+            (index != 0 && mappings[index - 1].start +
+                    mappings[index - 1].length > mappings[index].start)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static size_t crucible_hot_fork_fd_union_count(
+    const int *left, size_t left_count, const int *right, size_t right_count)
+{
+    size_t left_index = 0;
+    size_t right_index = 0;
+    size_t count = 0;
+
+    while (left_index < left_count || right_index < right_count) {
+        if (right_index == right_count ||
+            (left_index < left_count &&
+             left[left_index] < right[right_index])) {
+            left_index++;
+        } else if (left_index == left_count ||
+                   right[right_index] < left[left_index]) {
+            right_index++;
+        } else {
+            left_index++;
+            right_index++;
+        }
+        count++;
+    }
+    return count;
+}
+
+static int crucible_hot_fork_mapping_union_count(
+    const QemuCrucibleHotForkSharedMapping *left, size_t left_count,
+    const QemuCrucibleHotForkSharedMapping *right, size_t right_count,
+    size_t *union_count)
+{
+    const QemuCrucibleHotForkSharedMapping *previous = NULL;
+    size_t left_index = 0;
+    size_t right_index = 0;
+    size_t count = 0;
+
+    while (left_index < left_count || right_index < right_count) {
+        const QemuCrucibleHotForkSharedMapping *next;
+
+        if (right_index == right_count ||
+            (left_index < left_count &&
+             left[left_index].start < right[right_index].start)) {
+            next = &left[left_index++];
+        } else if (left_index == left_count ||
+                   right[right_index].start < left[left_index].start) {
+            next = &right[right_index++];
+        } else if (crucible_hot_fork_mapping_equal(
+                       &left[left_index], &right[right_index])) {
+            next = &left[left_index++];
+            right_index++;
+        } else {
+            return -EINVAL;
+        }
+
+        if (previous && previous->start + previous->length > next->start) {
+            return -EINVAL;
+        }
+        previous = next;
+        count++;
+    }
+    *union_count = count;
+    return 0;
+}
+
+static void crucible_hot_fork_merge_fd_tables(
+    int *left, size_t left_count, const int *right, size_t right_count,
+    size_t union_count)
+{
+    size_t left_index = left_count;
+    size_t right_index = right_count;
+    size_t output_index = union_count;
+
+    while (output_index != 0) {
+        int value;
+
+        if (right_index == 0 ||
+            (left_index != 0 &&
+             left[left_index - 1] > right[right_index - 1])) {
+            value = left[--left_index];
+        } else if (left_index == 0 ||
+                   right[right_index - 1] > left[left_index - 1]) {
+            value = right[--right_index];
+        } else {
+            value = left[--left_index];
+            right_index--;
+        }
+        left[--output_index] = value;
+    }
+}
+
+static void crucible_hot_fork_merge_mapping_tables(
+    QemuCrucibleHotForkSharedMapping *left, size_t left_count,
+    const QemuCrucibleHotForkSharedMapping *right, size_t right_count,
+    size_t union_count)
+{
+    size_t left_index = left_count;
+    size_t right_index = right_count;
+    size_t output_index = union_count;
+
+    while (output_index != 0) {
+        QemuCrucibleHotForkSharedMapping value;
+
+        if (right_index == 0 ||
+            (left_index != 0 &&
+             left[left_index - 1].start > right[right_index - 1].start)) {
+            value = left[--left_index];
+        } else if (left_index == 0 ||
+                   right[right_index - 1].start > left[left_index - 1].start) {
+            value = right[--right_index];
+        } else {
+            value = left[--left_index];
+            right_index--;
+        }
+        left[--output_index] = value;
+    }
+}
+
+int qemu_crucible_hot_fork_begin_child_resource_plan(
+    QemuCrucibleHotForkChildResourcePlan *resources,
+    const QemuCrucibleHotForkPluginChildResourcePlan *plugin)
+{
+    QemuCrucibleHotForkPluginChildResourcePlan plugin_copy;
+
+    if (!resources || !crucible_hot_fork_plugin_resources_valid(plugin)) {
+        return -EINVAL;
+    }
+
+    plugin_copy = *plugin;
+    *resources = (QemuCrucibleHotForkChildResourcePlan) { 0 };
+    resources->plugin = plugin_copy;
+    memcpy(resources->retained_fds, plugin_copy.retained_fds,
+           sizeof(plugin_copy.retained_fds));
+    resources->retained_fd_count =
+        QEMU_CRUCIBLE_HOT_FORK_PLUGIN_CHILD_RETAINED_FD_COUNT;
+    memcpy(resources->shared_mappings, plugin_copy.shared_mappings,
+           sizeof(plugin_copy.shared_mappings));
+    resources->shared_mapping_count =
+        QEMU_CRUCIBLE_HOT_FORK_PLUGIN_CHILD_SHARED_MAPPING_COUNT;
+    resources->building = true;
+    return 0;
+}
+
+int qemu_crucible_hot_fork_merge_child_resource_contribution(
+    QemuCrucibleHotForkChildResourcePlan *resources,
+    const int *retained_fds, size_t retained_fd_count,
+    const QemuCrucibleHotForkSharedMapping *shared_mappings,
+    size_t shared_mapping_count)
+{
+    size_t fd_union_count;
+    size_t mapping_union_count;
+    size_t index;
+    int result;
+
+    if (!resources || !resources->building || resources->sealed) {
+        return -EPERM;
+    }
+    if (retained_fd_count > QEMU_CRUCIBLE_HOT_FORK_MAX_RETAINED_DESCRIPTORS ||
+        shared_mapping_count > QEMU_CRUCIBLE_HOT_FORK_MAX_SHARED_MAPPINGS) {
+        return -E2BIG;
+    }
+    if (!crucible_hot_fork_fd_table_valid(retained_fds, retained_fd_count) ||
+        !crucible_hot_fork_mapping_table_valid(
+            shared_mappings, shared_mapping_count)) {
+        return -EINVAL;
+    }
+
+    for (index = 0; index < retained_fd_count; index++) {
+        if (retained_fds[index] ==
+                resources->plugin.replacements[0].source_fd ||
+            retained_fds[index] ==
+                resources->plugin.replacements[1].source_fd) {
+            return -EINVAL;
+        }
+    }
+    fd_union_count = crucible_hot_fork_fd_union_count(
+        resources->retained_fds, resources->retained_fd_count,
+        retained_fds, retained_fd_count);
+    if (fd_union_count > QEMU_CRUCIBLE_HOT_FORK_MAX_RETAINED_DESCRIPTORS) {
+        return -E2BIG;
+    }
+
+    result = crucible_hot_fork_mapping_union_count(
+        resources->shared_mappings, resources->shared_mapping_count,
+        shared_mappings, shared_mapping_count, &mapping_union_count);
+    if (result != 0) {
+        return result;
+    }
+    if (mapping_union_count > QEMU_CRUCIBLE_HOT_FORK_MAX_SHARED_MAPPINGS) {
+        return -E2BIG;
+    }
+    for (index = 0; index < shared_mapping_count; index++) {
+        int backing_fd = shared_mappings[index].backing_fd;
+
+        if (!crucible_hot_fork_fd_table_contains(
+                resources->retained_fds, resources->retained_fd_count,
+                backing_fd) &&
+            !crucible_hot_fork_fd_table_contains(
+                retained_fds, retained_fd_count, backing_fd)) {
+            return -EINVAL;
+        }
+    }
+
+    crucible_hot_fork_merge_fd_tables(
+        resources->retained_fds, resources->retained_fd_count,
+        retained_fds, retained_fd_count, fd_union_count);
+    resources->retained_fd_count = fd_union_count;
+    crucible_hot_fork_merge_mapping_tables(
+        resources->shared_mappings, resources->shared_mapping_count,
+        shared_mappings, shared_mapping_count, mapping_union_count);
+    resources->shared_mapping_count = mapping_union_count;
+    return 0;
+}
+
+static bool crucible_hot_fork_plan_contains_plugin(
+    const QemuCrucibleHotForkChildResourcePlan *resources,
+    const QemuCrucibleHotForkPluginChildResourcePlan *plugin)
+{
+    const QemuCrucibleHotForkSharedMapping *plugin_mapping;
+    size_t index;
+
+    if (!crucible_hot_fork_plugin_resources_valid(plugin) ||
+        !qemu_crucible_hot_fork_plugin_child_resources_prepared_for(
+            &resources->plugin, &plugin->plan,
+            plugin->replacements[0].source_fd,
+            plugin->replacements[1].source_fd)) {
+        return false;
+    }
+    for (index = 0;
+         index < QEMU_CRUCIBLE_HOT_FORK_PLUGIN_CHILD_RETAINED_FD_COUNT;
+         index++) {
+        if (!crucible_hot_fork_fd_table_contains(
+                resources->retained_fds, resources->retained_fd_count,
+                plugin->retained_fds[index])) {
+            return false;
+        }
+    }
+    plugin_mapping = &plugin->shared_mappings[0];
+    for (index = 0; index < resources->shared_mapping_count; index++) {
+        if (resources->shared_mappings[index].start == plugin_mapping->start) {
+            return crucible_hot_fork_mapping_equal(
+                &resources->shared_mappings[index], plugin_mapping);
+        }
+        if (resources->shared_mappings[index].start > plugin_mapping->start) {
+            break;
+        }
+    }
+    return false;
+}
+
+static bool crucible_hot_fork_child_resource_plan_valid(
+    const QemuCrucibleHotForkChildResourcePlan *resources,
+    const QemuCrucibleHotForkPluginChildResourcePlan *plugin)
+{
+    size_t index;
+
+    if (!resources ||
+        resources->retained_fd_count >
+            QEMU_CRUCIBLE_HOT_FORK_MAX_RETAINED_DESCRIPTORS ||
+        resources->shared_mapping_count >
+            QEMU_CRUCIBLE_HOT_FORK_MAX_SHARED_MAPPINGS ||
+        !crucible_hot_fork_fd_table_valid(
+            resources->retained_fds, resources->retained_fd_count) ||
+        !crucible_hot_fork_mapping_table_valid(
+            resources->shared_mappings, resources->shared_mapping_count) ||
+        !crucible_hot_fork_plan_contains_plugin(resources, plugin) ||
+        crucible_hot_fork_fd_table_contains(
+            resources->retained_fds, resources->retained_fd_count,
+            resources->plugin.replacements[0].source_fd) ||
+        crucible_hot_fork_fd_table_contains(
+            resources->retained_fds, resources->retained_fd_count,
+            resources->plugin.replacements[1].source_fd)) {
+        return false;
+    }
+    for (index = 0; index < resources->shared_mapping_count; index++) {
+        if (!crucible_hot_fork_fd_table_contains(
+                resources->retained_fds, resources->retained_fd_count,
+                resources->shared_mappings[index].backing_fd)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+int qemu_crucible_hot_fork_seal_child_resource_plan(
+    QemuCrucibleHotForkChildResourcePlan *resources)
+{
+    if (!resources || !resources->building || resources->sealed) {
+        return -EPERM;
+    }
+    if (!crucible_hot_fork_child_resource_plan_valid(
+            resources, &resources->plugin)) {
+        return -EINVAL;
+    }
+    resources->building = false;
+    resources->sealed = true;
+    return 0;
+}
+
+bool qemu_crucible_hot_fork_child_resource_plan_contains_plugin(
+    const QemuCrucibleHotForkChildResourcePlan *resources,
+    const QemuCrucibleHotForkPluginChildResourcePlan *plugin)
+{
+    return resources && resources->sealed && !resources->building &&
+        crucible_hot_fork_child_resource_plan_valid(resources, plugin);
+}
+
+void qemu_crucible_hot_fork_reset_child_resource_plan(
+    QemuCrucibleHotForkChildResourcePlan *resources)
+{
+    if (resources) {
+        *resources = (QemuCrucibleHotForkChildResourcePlan) { 0 };
+    }
+}
