+static void test_child_resource_plan_bounds_are_exact(void)
+{
+    uint64_t page_size = qemu_real_host_page_size();
+    struct qemu_plugin_crucible_hot_fork_child_plan plan = {
+        .schema_version = QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PLAN_VERSION,
+        .struct_size = sizeof(plan),
+        .parent_process_generation = 10,
+        .child_process_generation = 11,
+        .template_generation = 1,
+        .private_ring_generation = 2,
+        .plugin_endpoint_generation = 3,
+        .plugin_barrier_generation = 4,
+        .control_socket_cookie = 5,
+        .wake_eventfd_id = 6,
+        .shmem_device = 7,
+        .shmem_inode = 8,
+        .shmem_length = page_size,
+        .source_mapping_start = page_size,
+        .source_mapping_length = page_size,
+        .source_mapping_offset = 0,
+        .private_ring_fd = 7,
+        .control_fd = 3,
+        .wake_fd = 5,
+        .reserved_fd = -1,
+        .worker_mask = QEMU_PLUGIN_CRUCIBLE_WORKER_REQUIRED,
+    };
+    QemuCrucibleHotForkPluginChildResourcePlan plugin;
+    g_autofree QemuCrucibleHotForkChildResourcePlan *resources =
+        g_new0(QemuCrucibleHotForkChildResourcePlan, 1);
+    g_autofree int *retained_fds = g_new(int,
+        QEMU_CRUCIBLE_HOT_FORK_MAX_RETAINED_DESCRIPTORS);
+    g_autofree QemuCrucibleHotForkSharedMapping *mappings =
+        g_new(QemuCrucibleHotForkSharedMapping,
+              QEMU_CRUCIBLE_HOT_FORK_MAX_SHARED_MAPPINGS);
+    size_t index;
+
+    g_assert_cmpint(qemu_crucible_hot_fork_prepare_plugin_child_resources(
+                        &plugin, &plan, 31, 32),
+                    ==, 0);
+    for (index = 0;
+         index < QEMU_CRUCIBLE_HOT_FORK_MAX_RETAINED_DESCRIPTORS;
+         index++) {
+        retained_fds[index] = 100 + index;
+    }
+    g_assert_cmpint(qemu_crucible_hot_fork_begin_child_resource_plan(
+                        resources, &plugin),
+                    ==, 0);
+    g_assert_cmpint(qemu_crucible_hot_fork_merge_child_resource_contribution(
+                        resources, retained_fds,
+                        QEMU_CRUCIBLE_HOT_FORK_MAX_RETAINED_DESCRIPTORS - 3,
+                        NULL, 0),
+                    ==, 0);
+    g_assert_cmpuint(resources->retained_fd_count, ==,
+                     QEMU_CRUCIBLE_HOT_FORK_MAX_RETAINED_DESCRIPTORS);
+    g_assert_cmpint(qemu_crucible_hot_fork_merge_child_resource_contribution(
+                        resources,
+                        &retained_fds[
+                            QEMU_CRUCIBLE_HOT_FORK_MAX_RETAINED_DESCRIPTORS -
+                            3],
+                        1, NULL, 0),
+                    ==, -E2BIG);
+
+    qemu_crucible_hot_fork_reset_child_resource_plan(resources);
+    g_assert_cmpint(qemu_crucible_hot_fork_begin_child_resource_plan(
+                        resources, &plugin),
+                    ==, 0);
+    for (index = 0;
+         index < QEMU_CRUCIBLE_HOT_FORK_MAX_SHARED_MAPPINGS;
+         index++) {
+        mappings[index] = (QemuCrucibleHotForkSharedMapping) {
+            .start = (3 + 2 * index) * page_size,
+            .length = page_size,
+            .offset = index * page_size,
+            .backing_fd = plan.private_ring_fd,
+        };
+    }
+    g_assert_cmpint(qemu_crucible_hot_fork_merge_child_resource_contribution(
+                        resources, NULL, 0, mappings,
+                        QEMU_CRUCIBLE_HOT_FORK_MAX_SHARED_MAPPINGS - 1),
+                    ==, 0);
+    g_assert_cmpuint(resources->shared_mapping_count, ==,
+                     QEMU_CRUCIBLE_HOT_FORK_MAX_SHARED_MAPPINGS);
+    g_assert_cmpint(qemu_crucible_hot_fork_merge_child_resource_contribution(
+                        resources,
+                        NULL, 0,
+                        &mappings[
+                            QEMU_CRUCIBLE_HOT_FORK_MAX_SHARED_MAPPINGS - 1],
+                        1),
+                    ==, -E2BIG);
+    g_assert_cmpint(qemu_crucible_hot_fork_seal_child_resource_plan(resources),
+                    ==, 0);
+}
