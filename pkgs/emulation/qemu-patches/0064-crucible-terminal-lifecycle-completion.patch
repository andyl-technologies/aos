+static int crucible_lifecycle_terminal_exit_code(uint32_t transition)
+{
+    switch (transition) {
+    case CRUCIBLE_LIFECYCLE_CRASH:
+        return CRUCIBLE_LIFECYCLE_EXIT_CRASH;
+    case CRUCIBLE_LIFECYCLE_POWER_OFF:
+        return CRUCIBLE_LIFECYCLE_EXIT_POWER_OFF;
+    case CRUCIBLE_LIFECYCLE_PERMANENT_FAILURE:
+        return CRUCIBLE_LIFECYCLE_EXIT_PERMANENT_FAILURE;
+    default:
+        return 0;
+    }
+}
+
+int qemu_plugin_crucible_lifecycle_complete_terminal_exit(void)
+{
+    int exit_code;
+
+    if (!crucible_lifecycle_mode() ||
+        crucible_lifecycle_terminal_transition == 0) {
+        return 0;
+    }
+    exit_code = crucible_lifecycle_terminal_exit_code(
+        crucible_lifecycle_terminal_transition);
+    if (exit_code == 0 || crucible_lifecycle_terminal_exit_requested) {
+        return 0;
+    }
+    crucible_lifecycle_terminal_exit_requested = true;
+    qemu_system_shutdown_request_with_code(
+        SHUTDOWN_CAUSE_HOST_ERROR, exit_code);
+    return exit_code;
+}
