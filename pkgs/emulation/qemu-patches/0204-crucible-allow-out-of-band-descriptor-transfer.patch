 #    The 'closefd' command can be used to explicitly close the file
 #    descriptor when it is no longer needed.
 #
+# .. note:: Crucible permits out-of-band execution.  A retained hot-fork
+#    template parks main-loop dispatch, so descriptor transfer for its
+#    branch-private resources must complete on the monitor thread.
+#
 # .. qmp-example::
 #
 #     -> { "execute": "getfd", "arguments": { "fdname": "fd1" } }
 #     <- { "return": {} }
 ##
-{ 'command': 'getfd', 'data': {'fdname': 'str'}, 'if': 'CONFIG_POSIX' }
+{ 'command': 'getfd', 'data': {'fdname': 'str'}, 'if': 'CONFIG_POSIX',
+  'allow-oob': true }
 
