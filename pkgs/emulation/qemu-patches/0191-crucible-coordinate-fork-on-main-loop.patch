diff --git a/tests/unit/test-crucible-hot-fork-coordinator.c b/tests/unit/test-crucible-hot-fork-coordinator.c
new file mode 100644
index 000000000..2236413b6
--- /dev/null
+++ b/tests/unit/test-crucible-hot-fork-coordinator.c
@@ -0,0 +1,184 @@
+/*
+ * Crucible main-loop hot-fork coordinator tests.
+ *
+ * Copyright (c) Andyl, Inc.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+
+#include "qapi/error.h"
+#include "qemu/atomic.h"
+#include "qemu/main-loop.h"
+#include "qemu/notify.h"
+#include "qemu/rcu.h"
+#include "qemu/thread.h"
+#include "system/crucible-hot-fork-coordinator.h"
+
+typedef struct CoordinatorChildReport {
+    pid_t process_id;
+    int64_t thread_id;
+    unsigned int prepare_calls;
+    unsigned int parent_calls;
+    unsigned int child_calls;
+} CoordinatorChildReport;
+
+typedef struct CoordinatorTestState {
+    QemuCrucibleHotForkMainLoopOperation operation;
+    QemuThread submitter;
+    pid_t source_process_id;
+    pid_t submitted_child_pid;
+    pid_t parent_child_pid;
+    int64_t main_thread_id;
+    int64_t prepare_thread_id;
+    int64_t parent_thread_id;
+    int64_t submitter_thread_id;
+    int report_pipe[2];
+    int submit_result;
+    unsigned int prepare_calls;
+    unsigned int parent_calls;
+    unsigned int child_calls;
+    int submission_done;
+} CoordinatorTestState;
+
+static CoordinatorTestState coordinator_test;
+
+static int coordinator_prepare(void *opaque)
+{
+    CoordinatorTestState *state = opaque;
+
+    state->prepare_calls++;
+    state->prepare_thread_id = qemu_get_thread_id();
+    return 0;
+}
+
+static int coordinator_parent(pid_t child_pid, void *opaque)
+{
+    CoordinatorTestState *state = opaque;
+
+    state->parent_calls++;
+    state->parent_thread_id = qemu_get_thread_id();
+    state->parent_child_pid = child_pid;
+    return child_pid > 0 ? 0 : -ECHILD;
+}
+
+static int coordinator_child(void *opaque)
+{
+    CoordinatorTestState *state = opaque;
+    CoordinatorChildReport report;
+    ssize_t written;
+
+    state->child_calls++;
+    report = (CoordinatorChildReport) {
+        .process_id = getpid(),
+        .thread_id = qemu_get_thread_id(),
+        .prepare_calls = state->prepare_calls,
+        .parent_calls = state->parent_calls,
+        .child_calls = state->child_calls,
+    };
+    do {
+        written = write(state->report_pipe[1], &report, sizeof(report));
+    } while (written < 0 && errno == EINTR);
+    if (written != (ssize_t)sizeof(report)) {
+        _exit(EXIT_FAILURE);
+    }
+
+    /*
+     * The production callback reconstructs every main-loop dependency before
+     * returning.  This focused bridge test deliberately owns none of those
+     * subsystem transactions, so terminate after reporting the fork context
+     * rather than re-entering their copied locks.
+     */
+    _exit(EXIT_SUCCESS);
+}
+
+static void *coordinator_submit(void *opaque)
+{
+    CoordinatorTestState *state = opaque;
+
+    state->submitter_thread_id = qemu_get_thread_id();
+    state->submit_result = qemu_crucible_hot_fork_main_loop_fork(
+        &state->operation, &state->submitted_child_pid);
+    qatomic_set(&state->submission_done, 1);
+    qemu_notify_event();
+    return NULL;
+}
+
+static void test_main_loop_owns_fork(void)
+{
+    CoordinatorChildReport report;
+    int child_status;
+    ssize_t received;
+
+    coordinator_test = (CoordinatorTestState) {
+        .operation = {
+            .prepare = coordinator_prepare,
+            .parent = coordinator_parent,
+            .child = coordinator_child,
+        },
+        .source_process_id = getpid(),
+        .main_thread_id = qemu_get_thread_id(),
+        .submitted_child_pid = -1,
+        .parent_child_pid = -1,
+        .submit_result = -EINPROGRESS,
+    };
+    coordinator_test.operation.opaque = &coordinator_test;
+    g_assert_cmpint(pipe2(coordinator_test.report_pipe, O_CLOEXEC), ==, 0);
+
+    qemu_thread_create(&coordinator_test.submitter, "fork submitter",
+                       coordinator_submit, &coordinator_test,
+                       QEMU_THREAD_JOINABLE);
+    while (!qatomic_read(&coordinator_test.submission_done)) {
+        main_loop_wait(false);
+    }
+    qemu_thread_join(&coordinator_test.submitter);
+    g_assert_cmpint(coordinator_test.submit_result, ==, 0);
+    g_assert_cmpint(coordinator_test.submitted_child_pid, >, 0);
+    g_assert_cmpint(coordinator_test.parent_child_pid, ==,
+                    coordinator_test.submitted_child_pid);
+    g_assert_cmpuint(coordinator_test.prepare_calls, ==, 1);
+    g_assert_cmpuint(coordinator_test.parent_calls, ==, 1);
+    g_assert_cmpuint(coordinator_test.child_calls, ==, 0);
+    g_assert_cmpint(coordinator_test.prepare_thread_id, ==,
+                    coordinator_test.main_thread_id);
+    g_assert_cmpint(coordinator_test.parent_thread_id, ==,
+                    coordinator_test.main_thread_id);
+    g_assert_cmpint(coordinator_test.submitter_thread_id, !=,
+                    coordinator_test.main_thread_id);
+
+    do {
+        received = read(coordinator_test.report_pipe[0], &report,
+                        sizeof(report));
+    } while (received < 0 && errno == EINTR);
+    g_assert_cmpint(received, ==, (ssize_t)sizeof(report));
+    g_assert_cmpint(report.process_id, ==,
+                    coordinator_test.submitted_child_pid);
+    g_assert_cmpint(report.thread_id, ==, report.process_id);
+    g_assert_cmpuint(report.prepare_calls, ==, 1);
+    g_assert_cmpuint(report.parent_calls, ==, 0);
+    g_assert_cmpuint(report.child_calls, ==, 1);
+    g_assert_cmpint(waitpid(coordinator_test.submitted_child_pid,
+                            &child_status, 0), ==,
+                    coordinator_test.submitted_child_pid);
+    g_assert_true(WIFEXITED(child_status));
+    g_assert_cmpint(WEXITSTATUS(child_status), ==, EXIT_SUCCESS);
+
+    close(coordinator_test.report_pipe[0]);
+    close(coordinator_test.report_pipe[1]);
+}
+
+int main(int argc, char **argv)
+{
+    qemu_init_main_loop(&error_abort);
+    /*
+     * System startup disables generic pthread_atfork handling before the
+     * retained hot-fork transaction owns RCU disposition.  Reproduce that
+     * steady-state prerequisite in this focused coordinator bridge test.
+     */
+    rcu_disable_atfork();
+    qemu_crucible_hot_fork_main_loop_coordinator_init(&error_abort);
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/crucible/hot-fork/coordinator/main-loop-owned-fork",
+                    test_main_loop_owns_fork);
+    return g_test_run();
+}
