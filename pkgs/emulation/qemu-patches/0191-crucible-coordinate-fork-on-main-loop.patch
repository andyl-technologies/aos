diff --git a/include/system/crucible-hot-fork-coordinator.h b/include/system/crucible-hot-fork-coordinator.h
new file mode 100644
index 000000000..77f94c86c
--- /dev/null
+++ b/include/system/crucible-hot-fork-coordinator.h
@@ -0,0 +1,50 @@
+/*
+ * Crucible main-loop hot-fork coordinator.
+ *
+ * Copyright (c) Andyl, Inc.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef QEMU_CRUCIBLE_HOT_FORK_COORDINATOR_H
+#define QEMU_CRUCIBLE_HOT_FORK_COORDINATOR_H
+
+#include "qapi/error.h"
+
+typedef int (*QemuCrucibleHotForkPrepare)(void *opaque);
+typedef int (*QemuCrucibleHotForkParent)(pid_t child_pid, void *opaque);
+typedef int (*QemuCrucibleHotForkChild)(void *opaque);
+
+/*
+ * Immutable callbacks for one main-loop-owned fork transaction.
+ *
+ * The opaque value and every object reachable through it must be valid in
+ * both process incarnations.  Preparation runs on the source main-loop thread
+ * and must either complete one fork-ready transaction or fail without leaving
+ * partial authority.  The parent callback receives -1 after fork failure and
+ * the positive child PID after success.  The child callback runs immediately
+ * after the coordinator wake descriptor is closed and before main-loop work
+ * resumes.  It must arm parent-death containment and authenticate the direct
+ * child before performing any reconstructive or externally visible work.
+ */
+typedef struct QemuCrucibleHotForkMainLoopOperation {
+    QemuCrucibleHotForkPrepare prepare;
+    QemuCrucibleHotForkParent parent;
+    QemuCrucibleHotForkChild child;
+    void *opaque;
+} QemuCrucibleHotForkMainLoopOperation;
+
+/* Install the single system-emulator coordinator on the main-loop thread. */
+void qemu_crucible_hot_fork_main_loop_coordinator_init(Error **errp);
+
+/*
+ * Submit one exact operation from a non-main-loop thread and wait for its
+ * parent disposition.  A successful result returns the positive direct-child
+ * PID.  An error after fork also returns that positive PID so the operation
+ * owner can retain or quarantine its direct-child authority.  The child never
+ * returns through this caller's copied stack.
+ */
+int qemu_crucible_hot_fork_main_loop_fork(
+    const QemuCrucibleHotForkMainLoopOperation *operation,
+    pid_t *child_pid);
+
+#endif
diff --git a/system/crucible-hot-fork-coordinator.c b/system/crucible-hot-fork-coordinator.c
new file mode 100644
index 000000000..76c45e406
--- /dev/null
+++ b/system/crucible-hot-fork-coordinator.c
@@ -0,0 +1,215 @@
+/*
+ * Crucible main-loop hot-fork coordinator.
+ *
+ * Copyright (c) Andyl, Inc.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+
+#include "qemu/event_notifier.h"
+#include "qemu/main-loop.h"
+#include "qemu/notify.h"
+#include "qemu/thread.h"
+#include "system/crucible-hot-fork-coordinator.h"
+
+typedef struct QemuCrucibleHotForkCoordinator {
+    QemuMutex lock;
+    QemuCond completed_cond;
+    EventNotifier wake;
+    Notifier poll_notifier;
+    QemuCrucibleHotForkMainLoopOperation operation;
+    int64_t main_thread_id;
+    int result;
+    pid_t child_pid;
+    size_t poll_index;
+    bool initialized;
+    bool busy;
+    bool executing;
+    bool completed;
+} QemuCrucibleHotForkCoordinator;
+
+static QemuCrucibleHotForkCoordinator crucible_hot_fork_coordinator;
+
+static void crucible_hot_fork_complete_parent(
+    int result, pid_t child_pid)
+{
+    QemuCrucibleHotForkCoordinator *coordinator =
+        &crucible_hot_fork_coordinator;
+
+    qemu_mutex_lock(&coordinator->lock);
+    coordinator->result = result;
+    coordinator->child_pid = child_pid;
+    coordinator->executing = false;
+    coordinator->completed = true;
+    qemu_cond_signal(&coordinator->completed_cond);
+    qemu_mutex_unlock(&coordinator->lock);
+}
+
+static void crucible_hot_fork_execute_main_loop_request(void)
+{
+    QemuCrucibleHotForkCoordinator *coordinator =
+        &crucible_hot_fork_coordinator;
+    QemuCrucibleHotForkMainLoopOperation operation;
+    pid_t child_pid;
+    int parent_result;
+    int result;
+
+    qemu_mutex_lock(&coordinator->lock);
+    if (!coordinator->busy || coordinator->executing ||
+        coordinator->completed) {
+        qemu_mutex_unlock(&coordinator->lock);
+        return;
+    }
+    operation = coordinator->operation;
+    coordinator->executing = true;
+    qemu_mutex_unlock(&coordinator->lock);
+
+    result = operation.prepare(operation.opaque);
+    if (result != 0) {
+        crucible_hot_fork_complete_parent(result, -1);
+        return;
+    }
+
+    child_pid = fork();
+    if (child_pid == 0) {
+        /*
+         * The copied waiter and notifier are parent-only.  Close the raw wake
+         * descriptor before the child opens its exact descriptor transaction;
+         * no other thread exists and the coordinator lock was not held.
+         */
+        event_notifier_cleanup(&coordinator->wake);
+        coordinator->initialized = false;
+        coordinator->busy = false;
+        coordinator->executing = false;
+        coordinator->completed = false;
+        result = operation.child(operation.opaque);
+        if (result != 0) {
+            _exit(EXIT_FAILURE);
+        }
+        return;
+    }
+
+    if (child_pid < 0) {
+        result = -errno;
+    }
+    parent_result = operation.parent(child_pid, operation.opaque);
+    if (parent_result != 0) {
+        result = parent_result;
+    }
+    crucible_hot_fork_complete_parent(result, child_pid);
+}
+
+static void crucible_hot_fork_main_loop_poll(Notifier *notifier, void *opaque)
+{
+    QemuCrucibleHotForkCoordinator *coordinator =
+        container_of(notifier, QemuCrucibleHotForkCoordinator, poll_notifier);
+    MainLoopPoll *poll = opaque;
+    GPollFD descriptor;
+
+    if (!coordinator->initialized) {
+        return;
+    }
+    descriptor = (GPollFD) {
+        .fd = event_notifier_get_fd(&coordinator->wake),
+        .events = G_IO_IN | G_IO_ERR | G_IO_HUP,
+    };
+    switch (poll->state) {
+    case MAIN_LOOP_POLL_FILL:
+        coordinator->poll_index = poll->pollfds->len;
+        g_array_append_val(poll->pollfds, descriptor);
+        qemu_mutex_lock(&coordinator->lock);
+        if (coordinator->busy && !coordinator->completed) {
+            poll->timeout = 0;
+        }
+        qemu_mutex_unlock(&coordinator->lock);
+        break;
+    case MAIN_LOOP_POLL_OK:
+    case MAIN_LOOP_POLL_ERR:
+        descriptor = g_array_index(
+            poll->pollfds, GPollFD, coordinator->poll_index);
+        if (descriptor.revents & (G_IO_IN | G_IO_ERR | G_IO_HUP)) {
+            event_notifier_test_and_clear(&coordinator->wake);
+            crucible_hot_fork_execute_main_loop_request();
+        }
+        break;
+    default:
+        g_assert_not_reached();
+    }
+}
+
+void qemu_crucible_hot_fork_main_loop_coordinator_init(Error **errp)
+{
+    QemuCrucibleHotForkCoordinator *coordinator =
+        &crucible_hot_fork_coordinator;
+    int result;
+
+    if (coordinator->initialized) {
+        error_setg(errp, "Crucible hot-fork coordinator already initialized");
+        return;
+    }
+
+    qemu_mutex_init(&coordinator->lock);
+    qemu_cond_init(&coordinator->completed_cond);
+    result = event_notifier_init(&coordinator->wake, 0);
+    if (result != 0) {
+        qemu_cond_destroy(&coordinator->completed_cond);
+        qemu_mutex_destroy(&coordinator->lock);
+        error_setg_errno(errp, -result,
+                         "Could not create Crucible hot-fork coordinator");
+        return;
+    }
+
+    coordinator->main_thread_id = qemu_get_thread_id();
+    coordinator->poll_notifier.notify = crucible_hot_fork_main_loop_poll;
+    coordinator->initialized = true;
+    main_loop_poll_add_notifier(&coordinator->poll_notifier);
+}
+
+int qemu_crucible_hot_fork_main_loop_fork(
+    const QemuCrucibleHotForkMainLoopOperation *operation,
+    pid_t *child_pid)
+{
+    QemuCrucibleHotForkCoordinator *coordinator =
+        &crucible_hot_fork_coordinator;
+    int result;
+
+    if (!operation || !operation->prepare || !operation->parent ||
+        !operation->child || !child_pid || !coordinator->initialized ||
+        coordinator->main_thread_id == qemu_get_thread_id()) {
+        return -EINVAL;
+    }
+    *child_pid = -1;
+
+    qemu_mutex_lock(&coordinator->lock);
+    if (coordinator->busy) {
+        qemu_mutex_unlock(&coordinator->lock);
+        return -EBUSY;
+    }
+    coordinator->operation = *operation;
+    coordinator->result = -EINPROGRESS;
+    coordinator->child_pid = -1;
+    coordinator->busy = true;
+    coordinator->executing = false;
+    coordinator->completed = false;
+    result = event_notifier_set(&coordinator->wake);
+    if (result != 0) {
+        coordinator->operation =
+            (QemuCrucibleHotForkMainLoopOperation) { 0 };
+        coordinator->busy = false;
+        qemu_mutex_unlock(&coordinator->lock);
+        return result;
+    }
+    while (!coordinator->completed) {
+        qemu_cond_wait(&coordinator->completed_cond, &coordinator->lock);
+    }
+
+    result = coordinator->result;
+    *child_pid = coordinator->child_pid;
+    coordinator->operation =
+        (QemuCrucibleHotForkMainLoopOperation) { 0 };
+    coordinator->busy = false;
+    coordinator->completed = false;
+    qemu_mutex_unlock(&coordinator->lock);
+    return result;
+}
