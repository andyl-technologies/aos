 #include "system/kvm.h"
 #include "system/runstate.h"
 #include "system/runstate-action.h"
@@ -73,6 +74,60 @@ void qmp_stop(Error **errp)
     }
 }
 
+enum {
+    CRUCIBLE_HOT_FORK_PROOF_PRECISE_ICOUNT = 1U << 0,
+    CRUCIBLE_HOT_FORK_PROOF_SINGLE_THREADED_SIM_RR = 1U << 1,
+    CRUCIBLE_HOT_FORK_PROOF_EXACT_PAUSED_BOUNDARY = 1U << 2,
+    CRUCIBLE_HOT_FORK_PROOF_AIO_BH_TIMERS = 1U << 3,
+    CRUCIBLE_HOT_FORK_PROOF_RCU = 1U << 4,
+    CRUCIBLE_HOT_FORK_PROOF_BLOCK_SNAPSHOT = 1U << 5,
+    CRUCIBLE_HOT_FORK_PROOF_PLUGIN_RINGS = 1U << 6,
+    CRUCIBLE_HOT_FORK_PROOF_MAPPING_DESCRIPTORS = 1U << 7,
+    CRUCIBLE_HOT_FORK_PROOF_CHILD_REINITIALIZATION = 1U << 8,
+};
+
+#define CRUCIBLE_HOT_FORK_REQUIRED_PROOFS \
+    (CRUCIBLE_HOT_FORK_PROOF_PRECISE_ICOUNT | \
+     CRUCIBLE_HOT_FORK_PROOF_SINGLE_THREADED_SIM_RR | \
+     CRUCIBLE_HOT_FORK_PROOF_EXACT_PAUSED_BOUNDARY | \
+     CRUCIBLE_HOT_FORK_PROOF_AIO_BH_TIMERS | \
+     CRUCIBLE_HOT_FORK_PROOF_RCU | \
+     CRUCIBLE_HOT_FORK_PROOF_BLOCK_SNAPSHOT | \
+     CRUCIBLE_HOT_FORK_PROOF_PLUGIN_RINGS | \
+     CRUCIBLE_HOT_FORK_PROOF_MAPPING_DESCRIPTORS | \
+     CRUCIBLE_HOT_FORK_PROOF_CHILD_REINITIALIZATION)
+
+CrucibleHotForkReadiness *qmp_query_crucible_hot_fork_readiness(Error **errp)
+{
+    CrucibleHotForkReadiness *report = g_new0(CrucibleHotForkReadiness, 1);
+    uint64_t acknowledged = 0;
+
+    (void)errp;
+    if (icount_enabled() == ICOUNT_PRECISE) {
+        acknowledged |= CRUCIBLE_HOT_FORK_PROOF_PRECISE_ICOUNT;
+    }
+    if (qemu_plugin_crucible_single_threaded_rr()) {
+        acknowledged |= CRUCIBLE_HOT_FORK_PROOF_SINGLE_THREADED_SIM_RR;
+    }
+    if (runstate_check(RUN_STATE_PAUSED) &&
+        qemu_plugin_crucible_vmstop_pending() &&
+        !qemu_plugin_crucible_vmstop_admission_pending() &&
+        qemu_plugin_crucible_vmstop_flush_status() == 0) {
+        acknowledged |= CRUCIBLE_HOT_FORK_PROOF_EXACT_PAUSED_BOUNDARY;
+    }
+
+    /*
+     * The remaining proof classes deliberately stay clear until their
+     * subsystem-owned barriers and child reconstruction hooks land.  In
+     * particular, ordinary paused state is not evidence for any of them.
+     */
+    report->schema_version = 1;
+    report->required_proofs = CRUCIBLE_HOT_FORK_REQUIRED_PROOFS;
+    report->acknowledged_proofs = acknowledged;
+    report->ready = acknowledged == CRUCIBLE_HOT_FORK_REQUIRED_PROOFS;
+    return report;
+}
+
 void qmp_cont(Error **errp)
 {
     BlockBackend *blk;
diff --git a/qapi/run-state.json b/qapi/run-state.json
