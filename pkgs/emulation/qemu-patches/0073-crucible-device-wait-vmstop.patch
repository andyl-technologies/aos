+static void qemu_plugin_control_boundary_complete_bh(void *opaque)
+{
+    (void)opaque;
+
+    /*
+     * A control wake can arrive while an idle-time advance is between its
+     * QEMU clock mutation and plugin commit.  Keep yielding through the same
+     * two-pass barrier until that commit clears the RR fence; acknowledging
+     * earlier would expose a raw clock with a stale logical-time offset.
+     */
+    if (qatomic_load_acquire(&qemu_plugin_time_advance_pending)) {
+        /*
+         * One-shot BHs are inserted at the head of the AioContext queue, so a
+         * self-rescheduling waiter would starve the time-advance completion.
+         * Relinquish the coalescing token instead; that completion is already
+         * queued and schedules a fresh control boundary after its commit.
+         */
+        qatomic_store_release(&qemu_plugin_control_boundary_scheduled, 0);
+        return;
+    }
+
+    qatomic_store_release(&qemu_plugin_control_boundary_scheduled, 0);
+    qemu_plugin_fire_control_boundary_cb(first_cpu);
+}
+
+static void qemu_plugin_control_boundary_barrier_bh(void *opaque)
+{
+    (void)opaque;
+    /*
+     * Wake notifiers can schedule device-coroutine bottom halves. Complete
+     * the control boundary on the following main-loop pass so every bottom
+     * half captured by the wake is visible before the plugin acknowledges it.
+     */
+    aio_bh_schedule_oneshot(qemu_get_aio_context(),
+                            qemu_plugin_control_boundary_complete_bh, NULL);
+}
+
+static void qemu_plugin_schedule_control_boundary(void)
+{
+    if (qatomic_cmpxchg(&qemu_plugin_control_boundary_scheduled, 0, 1) != 0) {
+        return;
+    }
+    aio_bh_schedule_oneshot(qemu_get_aio_context(),
+                            qemu_plugin_control_boundary_barrier_bh, NULL);
+}
