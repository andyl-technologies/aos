+/**
+ * typedef qemu_plugin_9p_burst_cb_t - shmem 9p burst callback
+ * @userdata: a pointer supplied when callbacks were registered
+ *
+ * Called before and after one virtio-9p queue-drain burst. The plugin uses
+ * this to hold device-I/O virtual-time suppression across every raw 9p request
+ * generated by the burst.
+ */
+typedef void (*qemu_plugin_9p_burst_cb_t)(void *userdata);
+
+/**
+ * typedef qemu_plugin_9p_submit_cb_t - shmem 9p submit callback
+ * @request_id: device-assigned request id
+ * @data: raw 9p request message bytes, including the 7-byte 9p header
+ * @len: byte length of @data
+ * @response_capacity: byte capacity available in the guest response virtqueue
+ * @userdata: a pointer supplied when callbacks were registered
+ *
+ * Returns: 0 when the request was accepted, nonzero on fail-loud rejection.
+ */
+typedef int (*qemu_plugin_9p_submit_cb_t)(uint32_t request_id,
+                                          const uint8_t *data,
+                                          size_t len,
+                                          size_t response_capacity,
+                                          void *userdata);
+
+/**
+ * typedef qemu_plugin_9p_poll_cb_t - shmem 9p completion poll callback
+ * @request_id: request id being polled
+ * @data: raw 9p response output buffer
+ * @capacity: byte capacity of @data
+ * @userdata: a pointer supplied when callbacks were registered
+ *
+ * Returns: nonnegative response payload length on success, -1 on device error,
+ * and QEMU_PLUGIN_9P_POLL_PENDING when no response is ready yet.
+ */
+typedef int64_t (*qemu_plugin_9p_poll_cb_t)(uint32_t request_id,
+                                            uint8_t *data,
+                                            size_t capacity,
+                                            void *userdata);
+
+#define QEMU_PLUGIN_9P_POLL_PENDING (-2)
+
