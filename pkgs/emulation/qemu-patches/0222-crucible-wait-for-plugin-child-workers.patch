+static bool crucible_hot_fork_plugin_child_workers_settling(
+    const QemuCrucibleHotForkPluginChildReinitializer *reinitializer)
+{
+    const struct qemu_plugin_crucible_hot_fork_child_status *status =
+        &reinitializer->inventory.status;
+
+    return crucible_hot_fork_plugin_child_identity_matches(reinitializer) &&
+        status->flags ==
+            (QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_CALLBACKS_HELD |
+             QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_MAPPING_INSTALLED) &&
+        status->phase ==
+            QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PHASE_WORKERS_HELD &&
+        (status->parked_worker_mask & ~status->worker_mask) == 0;
+}
+
+/* Bound on the replacement workers reaching their parked safe point. */
