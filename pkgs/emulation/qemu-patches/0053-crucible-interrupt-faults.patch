+static uint64_t crucible_interrupt_counter_next(uint64_t *counter,
+                                                const char *name)
+{
+    uint64_t current;
+
+    do {
+        current = qatomic_read(counter);
+        if (current == UINT64_MAX) {
+            error_report("Crucible interrupt %s exhausted", name);
+            abort();
+        }
+    } while (qatomic_cmpxchg(counter, current, current + 1) != current);
+    return current + 1;
+}
+
+static int crucible_interrupt_target_compare(const void *left,
+                                             const void *right)
+{
+    uint32_t a = *(const uint32_t *)left;
+    uint32_t b = *(const uint32_t *)right;
+
+    return (a > b) - (a < b);
+}
