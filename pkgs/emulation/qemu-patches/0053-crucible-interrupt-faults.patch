+typedef struct CrucibleInterruptProvenanceKey {
+    uint16_t family;
+    uint32_t target_vcpu;
+    uint32_t vector;
+} CrucibleInterruptProvenanceKey;
+
+static GHashTable *crucible_interrupt_provenance;
+
+static guint crucible_interrupt_provenance_hash(gconstpointer opaque)
+{
+    const CrucibleInterruptProvenanceKey *key = opaque;
+
+    return key->family ^ key->target_vcpu ^ key->vector;
+}
+
+static gboolean crucible_interrupt_provenance_equal(gconstpointer left,
+                                                     gconstpointer right)
+{
+    const CrucibleInterruptProvenanceKey *a = left;
+    const CrucibleInterruptProvenanceKey *b = right;
+
+    return a->family == b->family &&
+           a->target_vcpu == b->target_vcpu && a->vector == b->vector;
+}
+
+static void crucible_interrupt_provenance_ensure(void)
+{
+    if (!crucible_interrupt_provenance) {
+        crucible_interrupt_provenance = g_hash_table_new_full(
+            crucible_interrupt_provenance_hash,
+            crucible_interrupt_provenance_equal, g_free, g_free);
+    }
+}
+
+bool qemu_crucible_fault_interrupt_provenance_can_set(
+    const QemuCrucibleInterruptEvent *event)
+{
+    CrucibleInterruptProvenanceKey key = {
+        .family = event->family,
+        .target_vcpu = event->target_vcpu,
+        .vector = event->vector,
+    };
+
+    return !crucible_interrupt_provenance ||
+        g_hash_table_contains(crucible_interrupt_provenance, &key) ||
+        g_hash_table_size(crucible_interrupt_provenance) <
+            CRUCIBLE_INTERRUPT_PROVENANCE_CAPACITY;
+}
+
+bool qemu_crucible_fault_interrupt_provenance_set(
+    const QemuCrucibleInterruptEvent *event, bool replace)
+{
+    CrucibleInterruptProvenanceKey lookup = {
+        .family = event->family,
+        .target_vcpu = event->target_vcpu,
+        .vector = event->vector,
+    };
+    CrucibleInterruptProvenanceKey *key;
+    QemuCrucibleInterruptEvent *copy;
+
+    crucible_interrupt_provenance_ensure();
+    if (!replace && g_hash_table_contains(crucible_interrupt_provenance,
+                                          &lookup)) {
+        return true;
+    }
+    if (!qemu_crucible_fault_interrupt_provenance_can_set(event)) {
+        return false;
+    }
+    key = g_new(CrucibleInterruptProvenanceKey, 1);
+    *key = lookup;
+    copy = g_new(QemuCrucibleInterruptEvent, 1);
+    *copy = *event;
+    g_hash_table_replace(crucible_interrupt_provenance, key, copy);
+    return true;
+}
+
+bool qemu_crucible_fault_interrupt_provenance_get(
+    uint16_t family, uint32_t target_vcpu, uint32_t vector,
+    QemuCrucibleInterruptEvent *event)
+{
+    CrucibleInterruptProvenanceKey key = {
+        .family = family,
+        .target_vcpu = target_vcpu,
+        .vector = vector,
+    };
+    QemuCrucibleInterruptEvent *stored;
+
+    if (!crucible_interrupt_provenance) {
+        return false;
+    }
+    stored = g_hash_table_lookup(crucible_interrupt_provenance, &key);
+    if (!stored) {
+        return false;
+    }
+    *event = *stored;
+    return true;
+}
+
+void qemu_crucible_fault_interrupt_provenance_clear(
+    uint16_t family, uint32_t target_vcpu, uint32_t vector)
+{
+    CrucibleInterruptProvenanceKey key = {
+        .family = family,
+        .target_vcpu = target_vcpu,
+        .vector = vector,
+    };
+
+    if (crucible_interrupt_provenance) {
+        g_hash_table_remove(crucible_interrupt_provenance, &key);
+    }
+}
+
+void qemu_crucible_fault_interrupt_provenance_clear_target(
+    uint16_t family, uint32_t target_vcpu)
+{
+    GHashTableIter iterator;
+    gpointer opaque;
+
+    if (!crucible_interrupt_provenance) {
+        return;
+    }
+    g_hash_table_iter_init(&iterator, crucible_interrupt_provenance);
+    while (g_hash_table_iter_next(&iterator, &opaque, NULL)) {
+        const CrucibleInterruptProvenanceKey *key = opaque;
+
+        if (key->family == family && key->target_vcpu == target_vcpu) {
+            g_hash_table_iter_remove(&iterator);
+        }
+    }
+}
