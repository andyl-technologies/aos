+bool qemu_crucible_fault_interrupt_register_injector(
+    uint16_t family, QemuCrucibleInterruptInjectFn inject,
+    void *opaque)
+{
+    CrucibleInterruptInjector *injector;
+
+    if (!inject || family == 0 ||
+        family >= G_N_ELEMENTS(crucible_interrupt_injectors)) {
+        return false;
+    }
+    injector = &crucible_interrupt_injectors[family];
+    if (injector->inject) {
+        return injector->inject == inject && injector->opaque == opaque;
+    }
+    injector->inject = inject;
+    injector->opaque = opaque;
+    return true;
+}
+
+bool qemu_crucible_fault_interrupt_register_route_validator(
+    uint16_t family, QemuCrucibleInterruptRouteValidateFn validate,
+    void *opaque)
+{
+    CrucibleInterruptInjector *injector;
+
+    if (!validate || family == 0 ||
+        family >= G_N_ELEMENTS(crucible_interrupt_injectors)) {
+        return false;
+    }
+    injector = &crucible_interrupt_injectors[family];
+    if (injector->validate) {
+        return injector->validate == validate && injector->opaque == opaque;
+    }
+    if (injector->opaque && injector->opaque != opaque) {
+        return false;
+    }
+    injector->validate = validate;
+    injector->opaque = opaque;
+    return true;
+}
+
+bool qemu_crucible_fault_interrupt_route_valid(
+    const QemuCrucibleInterruptEvent *event)
+{
+    CrucibleInterruptInjector *injector;
+
+    if (!event || event->family == 0 ||
+        event->family >= G_N_ELEMENTS(crucible_interrupt_injectors)) {
+        return false;
+    }
+    injector = &crucible_interrupt_injectors[event->family];
+    return !injector->validate ||
+        injector->validate(event, injector->opaque);
+}
