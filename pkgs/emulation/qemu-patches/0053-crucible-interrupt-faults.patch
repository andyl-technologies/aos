+static bool gicv3_crucible_route_validate(
+    const QemuCrucibleInterruptEvent *event, void *opaque)
+{
+    GICv3State *s = opaque;
+    GICv3CPUState *cs;
+    uint64_t idbits, config_base;
+    uint8_t config, pending_byte;
+    uint8_t priority;
+
+    if (event->target_vcpu >= s->num_cpu) {
+        return false;
+    }
+    cs = &s->cpu[event->target_vcpu];
+    if (event->family != QEMU_CRUCIBLE_INTERRUPT_ARM_GIC_LPI) {
+        if (event->vector >= s->num_irq) {
+            return false;
+        }
+        if (!event->release_phase) {
+            return true;
+        }
+        return event->vector < GIC_INTERNAL ?
+            !(cs->gicr_ipendr0 & (1U << event->vector)) :
+            !gicv3_gicd_pending_test(s, event->vector);
+    }
+    if (event->vector < GICV3_LPI_INTID_START) {
+        return false;
+    }
+    idbits = MIN(FIELD_EX64(cs->gicr_propbaser,
+                           GICR_PROPBASER, IDBITS),
+                 GICD_TYPER_IDBITS);
+    if (!(cs->gicr_ctlr & GICR_CTLR_ENABLE_LPIS) ||
+        event->vector > (1ULL << (idbits + 1)) - 1) {
+        return false;
+    }
+    config_base = cs->gicr_propbaser & R_GICR_PROPBASER_PHYADDR_MASK;
+    if (address_space_read(
+            &s->dma_as,
+            config_base + event->vector - GICV3_LPI_INTID_START,
+            MEMTXATTRS_UNSPECIFIED, &config, sizeof(config)) != MEMTX_OK ||
+        !(config & LPI_CTE_ENABLED)) {
+        return false;
+    }
+    if (s->gicd_ctlr & GICD_CTLR_DS) {
+        priority = config & LPI_PRIORITY_MASK;
+    } else {
+        priority = ((config & LPI_PRIORITY_MASK) >> 1) | 0x80;
+    }
+    if (event->priority != priority || event->source_sequence == 0) {
+        return event->priority == priority;
+    }
+    if (address_space_read(
+            &s->dma_as,
+            (cs->gicr_pendbaser & R_GICR_PENDBASER_PHYADDR_MASK) +
+                event->vector / 8,
+            MEMTXATTRS_UNSPECIFIED, &pending_byte,
+            sizeof(pending_byte)) != MEMTX_OK) {
+        return false;
+    }
+    if (event->release_phase &&
+        extract32(pending_byte, event->vector % 8, 1)) {
+        return false;
+    }
+    return (event->retain_pending &&
+            extract32(pending_byte, event->vector % 8, 1)) ||
+        qemu_crucible_fault_interrupt_provenance_can_set(event);
+}
