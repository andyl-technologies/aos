+static bool crucible_interrupt_same_coordinate(
+    const QemuCrucibleFaultRule *left, const QemuCrucibleFaultRule *right)
+{
+    const uint8_t *left_controller, *right_controller;
+    const uint8_t *left_source, *right_source;
+    uint32_t left_controller_len, right_controller_len;
+    uint32_t left_source_len, right_source_len;
+    uint32_t left_vcpu, right_vcpu, left_vector, right_vector;
+
+    return qemu_crucible_fault_rule_model_phase(left) ==
+               qemu_crucible_fault_rule_model_phase(right) &&
+           qemu_crucible_fault_rule_field(
+               left, CRUCIBLE_NODE_FAULT_FIELD_T1,
+               CRUCIBLE_NODE_FAULT_FIELD_TYPE_HASH,
+               &left_controller, &left_controller_len) &&
+           qemu_crucible_fault_rule_field(
+               right, CRUCIBLE_NODE_FAULT_FIELD_T1,
+               CRUCIBLE_NODE_FAULT_FIELD_TYPE_HASH,
+               &right_controller, &right_controller_len) &&
+           left_controller_len == 32 && right_controller_len == 32 &&
+           memcmp(left_controller, right_controller, 32) == 0 &&
+           qemu_crucible_fault_rule_field(
+               left, CRUCIBLE_NODE_FAULT_FIELD_T2,
+               CRUCIBLE_NODE_FAULT_FIELD_TYPE_HASH,
+               &left_source, &left_source_len) &&
+           qemu_crucible_fault_rule_field(
+               right, CRUCIBLE_NODE_FAULT_FIELD_T2,
+               CRUCIBLE_NODE_FAULT_FIELD_TYPE_HASH,
+               &right_source, &right_source_len) &&
+           left_source_len == 32 && right_source_len == 32 &&
+           memcmp(left_source, right_source, 32) == 0 &&
+           crucible_interrupt_rule_u32(
+               left, CRUCIBLE_NODE_FAULT_FIELD_T3, &left_vcpu) &&
+           crucible_interrupt_rule_u32(
+               right, CRUCIBLE_NODE_FAULT_FIELD_T3, &right_vcpu) &&
+           left_vcpu == right_vcpu &&
+           crucible_interrupt_rule_u32(
+               left, CRUCIBLE_NODE_FAULT_FIELD_T4, &left_vector) &&
+           crucible_interrupt_rule_u32(
+               right, CRUCIBLE_NODE_FAULT_FIELD_T4, &right_vector) &&
+           left_vector == right_vector;
+}
+
+typedef struct CrucibleInterruptConflict {
+    const QemuCrucibleFaultRule *candidate;
+    bool conflict;
+} CrucibleInterruptConflict;
+
+static void crucible_interrupt_conflict_visit(
+    const QemuCrucibleFaultRule *existing, void *opaque)
+{
+    CrucibleInterruptConflict *conflict = opaque;
+
+    if (memcmp(qemu_crucible_fault_rule_binding_hash(existing),
+               qemu_crucible_fault_rule_binding_hash(conflict->candidate),
+               32) != 0 &&
+        crucible_interrupt_same_coordinate(existing, conflict->candidate)) {
+        conflict->conflict = true;
+    }
+}
+
+static bool crucible_interrupt_storm_routing(
+    const QemuCrucibleFaultRule *rule,
+    const CrucibleInterruptCapability *row, uint32_t selected_vcpu,
+    uint32_t vector,
+    uint16_t *priority, bool *retain_pending)
+{
+    const QObject *object = qemu_crucible_fault_rule_json(
+        rule, CRUCIBLE_NODE_FAULT_FIELD_P6);
+    const QDict *routing = qobject_to(QDict, object);
+    const QList *targets;
+    const QListEntry *entry;
+    uint64_t raw_priority;
+    bool retain;
+    bool selected = false;
+
+    if (!routing) {
+        return false;
+    }
+    raw_priority = qnum_get_uint(qobject_to(
+        QNum, qdict_get(routing, "priority")));
+    if (raw_priority > UINT8_MAX) {
+        return false;
+    }
+    retain = qdict_get_bool(routing, "retain_pending");
+    targets = qobject_to(QList, qdict_get(routing, "target_vcpus"));
+    QLIST_FOREACH_ENTRY(targets, entry) {
+        uint64_t target = qnum_get_uint(
+            qobject_to(QNum, qlist_entry_obj(entry)));
+        QemuCrucibleInterruptEvent event;
+
+        if (target > UINT32_MAX ||
+            !crucible_interrupt_target_allowed(row, target)) {
+            return false;
+        }
+        event = (QemuCrucibleInterruptEvent) {
+            .family = row->family,
+            .trigger = row->trigger,
+            .polarity = row->polarity,
+            .model_phase = QEMU_CRUCIBLE_INTERRUPT_PHASE_ROUTE,
+            .target_vcpu = target,
+            .vector = vector,
+            .controller_source = UINT32_MAX,
+            .priority = raw_priority,
+            .retain_pending = retain,
+        };
+        if (crucible_interrupt_injectors[row->family].validate &&
+            !crucible_interrupt_injectors[row->family].validate(
+                &event, crucible_interrupt_injectors[row->family].opaque)) {
+            return false;
+        }
+        selected |= target == selected_vcpu;
+    }
+    if (!selected) {
+        return false;
+    }
+    switch (row->family) {
+    case QEMU_CRUCIBLE_INTERRUPT_X86_PIC:
+        if (raw_priority != (vector & 7)) {
+            return false;
+        }
+        break;
+    case QEMU_CRUCIBLE_INTERRUPT_X86_NMI:
+        if (raw_priority != 0) {
+            return false;
+        }
+        break;
+    case QEMU_CRUCIBLE_INTERRUPT_X86_LOCAL_APIC_FIXED:
+    case QEMU_CRUCIBLE_INTERRUPT_X86_IPI:
+    case QEMU_CRUCIBLE_INTERRUPT_X86_IO_APIC:
+    case QEMU_CRUCIBLE_INTERRUPT_X86_MSI:
+    case QEMU_CRUCIBLE_INTERRUPT_X86_MSIX:
+    case QEMU_CRUCIBLE_INTERRUPT_X86_TIMER:
+        if (raw_priority != (vector >> 4)) {
+            return false;
+        }
+        break;
+    default:
+        break;
+    }
+    *priority = raw_priority;
+    *retain_pending = retain;
+    return true;
+}
+
+static bool crucible_interrupt_storm_targets_copy(
+    const QemuCrucibleFaultRule *rule, uint32_t **targets_out,
+    size_t *count_out)
+{
+    const QDict *routing = qobject_to(QDict,
+        qemu_crucible_fault_rule_json(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_P6));
+    const QList *targets;
+    const QListEntry *entry;
+    uint32_t *copy;
+    size_t index = 0;
+
+    if (!routing) {
+        return false;
+    }
+    targets = qobject_to(QList, qdict_get(routing, "target_vcpus"));
+    copy = g_new(uint32_t, qlist_size(targets));
+    QLIST_FOREACH_ENTRY(targets, entry) {
+        copy[index++] = qnum_get_uint(
+            qobject_to(QNum, qlist_entry_obj(entry)));
+    }
+    *targets_out = copy;
+    *count_out = index;
+    return index != 0;
+}
+
+int qemu_crucible_fault_interrupt_validate(const QemuCrucibleFaultRule *rule)
+{
+    const uint8_t *controller, *source, *data;
+    uint32_t controller_len, source_len, length;
+    uint32_t target_vcpu, vector, replacement;
+    uint32_t disposition, copies;
+    uint64_t delay_ns, gap_ns;
+    uint16_t storm_priority;
+    bool storm_retain_pending;
+    uint32_t storm_burst, storm_total;
+    uint64_t storm_period, storm_cycles;
+    CrucibleInterruptConflict conflict = { .candidate = rule };
+    uint16_t model_phase;
+
+    if (!rule || !crucible_interrupt_bindings_sealed ||
+        !qemu_crucible_fault_rule_field(rule, CRUCIBLE_NODE_FAULT_FIELD_T1,
+                                        CRUCIBLE_NODE_FAULT_FIELD_TYPE_HASH,
+                                        &controller, &controller_len) ||
+        !qemu_crucible_fault_rule_field(rule, CRUCIBLE_NODE_FAULT_FIELD_T2,
+                                        CRUCIBLE_NODE_FAULT_FIELD_TYPE_HASH,
+                                        &source, &source_len) ||
+        !qemu_crucible_fault_rule_field(rule, CRUCIBLE_NODE_FAULT_FIELD_T3,
+                                        CRUCIBLE_NODE_FAULT_FIELD_TYPE_U32,
+                                        &data, &length) || length != 4) {
+        return -EINVAL;
+    }
+    target_vcpu = ldl_le_p(data);
+    if (!qemu_crucible_fault_rule_field(rule, CRUCIBLE_NODE_FAULT_FIELD_T4,
+                                        CRUCIBLE_NODE_FAULT_FIELD_TYPE_U32,
+                                        &data, &length) || length != 4) {
+        return -EINVAL;
+    }
+    vector = ldl_le_p(data);
+    model_phase = qemu_crucible_fault_rule_model_phase(rule);
+    for (guint i = 0; i < crucible_interrupt_manifest->len; i++) {
+        const CrucibleInterruptCapability *row = &g_array_index(
+            crucible_interrupt_manifest, CrucibleInterruptCapability, i);
+        const CrucibleInterruptBinding *binding = &g_array_index(
+            crucible_interrupt_bindings, CrucibleInterruptBinding, i);
+
+        if (controller_len != 32 || source_len != 32 ||
+            memcmp(binding->controller, controller, 32) != 0 ||
+            memcmp(binding->source, source, 32) != 0) {
+            continue;
+        }
+        if (vector < row->vector_start || vector > row->vector_end ||
+            !crucible_interrupt_target_allowed(row, target_vcpu) ||
+            model_phase == 0 || model_phase > 64) {
+            return -EINVAL;
+        }
+        if (qemu_crucible_fault_rule_command_kind(rule) ==
+            CRUCIBLE_FAULT_COMMAND_INTERRUPT_STORM) {
+            int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+
+            if (!crucible_interrupt_rule_u64(
+                    rule, CRUCIBLE_NODE_FAULT_FIELD_P3, &storm_period) ||
+                !crucible_interrupt_rule_u32(
+                    rule, CRUCIBLE_NODE_FAULT_FIELD_P4, &storm_burst) ||
+                !crucible_interrupt_rule_u32(
+                    rule, CRUCIBLE_NODE_FAULT_FIELD_P5, &storm_total) ||
+                storm_period == 0 || storm_burst == 0 || storm_total == 0 ||
+                storm_period > INT64_MAX || now < 0) {
+                return -EINVAL;
+            }
+            storm_cycles = (uint64_t)storm_total / storm_burst +
+                (storm_total % storm_burst != 0);
+            if (storm_cycles > (uint64_t)(INT64_MAX - now) / storm_period) {
+                return -ERANGE;
+            }
+            if (model_phase != QEMU_CRUCIBLE_INTERRUPT_PHASE_RAISE ||
+                !crucible_interrupt_injectors[row->family].inject ||
+                !crucible_interrupt_storm_routing(
+                    rule, row, target_vcpu, vector, &storm_priority,
+                    &storm_retain_pending)) {
+                return -EINVAL;
+            }
+        } else if (!(row->model_phase_mask &
+                     (1ULL << (model_phase - 1)))) {
+            return -EINVAL;
+        }
+        if (qemu_crucible_fault_rule_command_kind(rule) ==
+            CRUCIBLE_FAULT_COMMAND_INTERRUPT_DISPOSITION &&
+            (!crucible_interrupt_rule_u32(
+                 rule, CRUCIBLE_NODE_FAULT_FIELD_P1, &disposition) ||
+             !crucible_interrupt_rule_u64(
+                 rule, CRUCIBLE_NODE_FAULT_FIELD_P2, &delay_ns) ||
+             !crucible_interrupt_rule_u32(
+                 rule, CRUCIBLE_NODE_FAULT_FIELD_P3, &copies) ||
+             !crucible_interrupt_rule_u64(
+                 rule, CRUCIBLE_NODE_FAULT_FIELD_P4, &gap_ns) ||
+             !crucible_interrupt_rule_u32(
+                 rule, CRUCIBLE_NODE_FAULT_FIELD_P5, &replacement))) {
+            return -EINVAL;
+        }
+        if (qemu_crucible_fault_rule_command_kind(rule) ==
+            CRUCIBLE_FAULT_COMMAND_INTERRUPT_DISPOSITION) {
+            if ((disposition == 1 &&
+                 (delay_ns != 0 || copies != 0 || gap_ns != 0 ||
+                  replacement != 0)) ||
+                (disposition == 2 &&
+                 (delay_ns == 0 || delay_ns > INT64_MAX || copies != 0 ||
+                  gap_ns != 0 || replacement != 0)) ||
+                (disposition == 3 &&
+                 (delay_ns != 0 || copies == 0 || copies > 256 ||
+                  replacement != 0 ||
+                  (gap_ns != 0 && copies > INT64_MAX / gap_ns))) ||
+                (disposition == 4 &&
+                 (delay_ns != 0 || copies != 0 || gap_ns != 0 ||
+                  replacement < row->replacement_vector_start ||
+                  replacement > row->replacement_vector_end)) ||
+                disposition < 1 || disposition > 4) {
+                return -EINVAL;
+            }
+        }
+        if (qemu_crucible_fault_rule_command_kind(rule) ==
+            CRUCIBLE_FAULT_COMMAND_INTERRUPT_DISPOSITION) {
+            qemu_crucible_fault_rule_foreach(
+                CRUCIBLE_FAULT_COMMAND_INTERRUPT_DISPOSITION,
+                crucible_interrupt_conflict_visit, &conflict);
+            if (conflict.conflict) {
+                return -EEXIST;
+            }
+        }
+        return 0;
+    }
+    return -ENOENT;
+}
+
+static bool crucible_interrupt_rule_u32(const QemuCrucibleFaultRule *rule,
+                                        uint16_t tag, uint32_t *value)
+{
+    const uint8_t *data;
+    uint32_t length;
+
+    if (!qemu_crucible_fault_rule_field(
+            rule, tag, CRUCIBLE_NODE_FAULT_FIELD_TYPE_U32,
+            &data, &length) || length != 4) {
+        return false;
+    }
+    *value = ldl_le_p(data);
+    return true;
+}
+
+static bool crucible_interrupt_rule_u64(const QemuCrucibleFaultRule *rule,
+                                        uint16_t tag, uint64_t *value)
+{
+    const uint8_t *data;
+    uint32_t length;
+
+    if (!qemu_crucible_fault_rule_field(
+            rule, tag, CRUCIBLE_NODE_FAULT_FIELD_TYPE_U64,
+            &data, &length) || length != 8) {
+        return false;
+    }
+    *value = ldq_le_p(data);
+    return true;
+}
+
+static const CrucibleInterruptCapability *crucible_interrupt_event_row(
+    const QemuCrucibleInterruptEvent *event, guint *row_index)
+{
+    for (guint i = 0; i < crucible_interrupt_manifest->len; i++) {
+        const CrucibleInterruptCapability *row = &g_array_index(
+            crucible_interrupt_manifest, CrucibleInterruptCapability, i);
+
+        if (row->family == event->family && row->trigger == event->trigger &&
+            event->vector >= row->vector_start &&
+            event->vector <= row->vector_end &&
+            crucible_interrupt_target_allowed(row, event->target_vcpu) &&
+            event->model_phase != 0 && event->model_phase <= 64 &&
+            (row->model_phase_mask &
+             (1ULL << (event->model_phase - 1)))) {
+            if (row_index) {
+                *row_index = i;
+            }
+            return row;
+        }
+    }
+    return NULL;
+}
+
+static bool crucible_interrupt_rule_matches(
+    const QemuCrucibleFaultRule *rule,
+    const QemuCrucibleInterruptEvent *event,
+    const CrucibleInterruptCapability *row,
+    const CrucibleInterruptBinding *binding)
+{
+    const uint8_t *controller, *source;
+    uint32_t controller_len, source_len, vcpu, vector;
+
+    return qemu_crucible_fault_rule_command_kind(rule) ==
+               CRUCIBLE_FAULT_COMMAND_INTERRUPT_DISPOSITION &&
+           qemu_crucible_fault_rule_model_phase(rule) == event->model_phase &&
+           qemu_crucible_fault_rule_field(
+               rule, CRUCIBLE_NODE_FAULT_FIELD_T1,
+               CRUCIBLE_NODE_FAULT_FIELD_TYPE_HASH,
+               &controller, &controller_len) && controller_len == 32 &&
+           qemu_crucible_fault_rule_field(
+               rule, CRUCIBLE_NODE_FAULT_FIELD_T2,
+               CRUCIBLE_NODE_FAULT_FIELD_TYPE_HASH,
+               &source, &source_len) && source_len == 32 &&
+           memcmp(controller, binding->controller, 32) == 0 &&
+           memcmp(source, binding->source, 32) == 0 &&
+           crucible_interrupt_rule_u32(
+               rule, CRUCIBLE_NODE_FAULT_FIELD_T3, &vcpu) &&
+           vcpu == event->target_vcpu &&
+           crucible_interrupt_rule_u32(
+               rule, CRUCIBLE_NODE_FAULT_FIELD_T4, &vector) &&
+           vector == event->vector && row != NULL;
+}
+
+static void crucible_interrupt_match_visit(
+    const QemuCrucibleFaultRule *rule, void *opaque)
+{
+    CrucibleInterruptMatch *match = opaque;
+
+    if (crucible_interrupt_rule_matches(
+            rule, match->event, match->row, match->binding)) {
+        if (match->rule) {
+            match->conflict = true;
+            if (memcmp(qemu_crucible_fault_rule_binding_hash(rule),
+                       qemu_crucible_fault_rule_binding_hash(match->rule),
+                       32) < 0) {
+                match->rule = rule;
+            }
+            return;
+        }
+        match->rule = rule;
+    }
+}
+
+static void crucible_interrupt_record(
+    const QemuCrucibleFaultRule *rule,
+    const QemuCrucibleInterruptEvent *before,
+    const QemuCrucibleInterruptEvent *after, uint32_t disposition,
+    uint64_t delay_ns, uint32_t copies, uint64_t gap_ns,
+    uint16_t outcome, const uint8_t state_before[32]);
+static void crucible_interrupt_terminal_error(
+    const QemuCrucibleFaultRule *rule, uint32_t code);
+
+static void crucible_interrupt_deferred_cb(void *opaque)
+{
+    CrucibleInterruptDeferred *deferred = opaque;
+    CrucibleInterruptInjector *injector =
+        &crucible_interrupt_injectors[deferred->event.family];
+    QemuCrucibleFaultRule *terminal_rule = NULL;
+    bool stores_provenance = deferred->event.family !=
+        QEMU_CRUCIBLE_INTERRUPT_X86_NMI;
+    uint16_t outcome = CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED;
+
+    deferred->event.release_phase = deferred->event.model_phase;
+    if (stores_provenance &&
+        !qemu_crucible_fault_interrupt_provenance_can_set(
+            &deferred->event)) {
+        outcome = CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR;
+    } else if (injector->validate &&
+        !injector->validate(&deferred->event, injector->opaque)) {
+        outcome = CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR;
+    } else {
+        if (stores_provenance &&
+            !qemu_crucible_fault_interrupt_provenance_set(
+                &deferred->event, !deferred->event.retain_pending)) {
+            g_assert_not_reached();
+        }
+        deferred->inject(&deferred->event, deferred->opaque);
+    }
+    crucible_interrupt_record(
+        deferred->rule, &deferred->event, &deferred->event, 6,
+        deferred->delay_ns, 0, 0,
+        outcome, deferred->before_hash);
+    if (outcome == CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR) {
+        terminal_rule = qemu_crucible_fault_rule_copy(deferred->rule);
+    }
+    for (guint i = 0; crucible_interrupt_deferred &&
+                        i < crucible_interrupt_deferred->len; i++) {
+        if (g_ptr_array_index(crucible_interrupt_deferred, i) == deferred) {
+            g_ptr_array_remove_index(crucible_interrupt_deferred, i);
+            break;
+        }
+    }
+    timer_free(deferred->timer);
+    qemu_crucible_fault_rule_unref(deferred->rule);
+    g_free(deferred);
+    qatomic_dec(&crucible_interrupt_deferred_reserved);
+    if (terminal_rule) {
+        crucible_interrupt_terminal_error(terminal_rule, 3);
+        qemu_crucible_fault_rule_unref(terminal_rule);
+    }
+}
+
+static void crucible_interrupt_schedule(
+    const QemuCrucibleFaultRule *rule,
+    const QemuCrucibleInterruptEvent *event,
+    QemuCrucibleInterruptInjectFn inject, void *opaque, uint64_t delay_ns)
+{
+    CrucibleInterruptDeferred *deferred;
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+
+    g_assert(rule && inject && delay_ns <= INT64_MAX &&
+             now <= INT64_MAX - (int64_t)delay_ns);
+    deferred = g_new0(CrucibleInterruptDeferred, 1);
+    deferred->event = *event;
+    deferred->inject = inject;
+    deferred->opaque = opaque;
+    deferred->rule = qemu_crucible_fault_rule_copy(rule);
+    deferred->delay_ns = delay_ns;
+    if (qemu_crucible_fault_execution_fingerprint(
+            qemu_crucible_fault_observed_icount(),
+            deferred->before_hash) != 0) {
+        memset(deferred->before_hash, 0, sizeof(deferred->before_hash));
+    }
+    deferred->timer = timer_new_ns(
+        QEMU_CLOCK_VIRTUAL, crucible_interrupt_deferred_cb, deferred);
+    if (!crucible_interrupt_deferred) {
+        crucible_interrupt_deferred = g_ptr_array_new();
+    }
+    g_ptr_array_add(crucible_interrupt_deferred, deferred);
+    timer_mod_ns(deferred->timer, now + delay_ns);
+}
+
+static bool crucible_interrupt_queue_reserve(uint32_t slots,
+                                             uint64_t maximum_delay_ns)
+{
+    uint32_t used;
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+
+    if (slots > CRUCIBLE_INTERRUPT_DEFERRED_CAPACITY ||
+        maximum_delay_ns > INT64_MAX ||
+        now > INT64_MAX - (int64_t)maximum_delay_ns) {
+        return false;
+    }
+    do {
+        used = qatomic_read(&crucible_interrupt_deferred_reserved);
+        if (used > CRUCIBLE_INTERRUPT_DEFERRED_CAPACITY - slots) {
+            return false;
+        }
+    } while (qatomic_cmpxchg(&crucible_interrupt_deferred_reserved,
+                            used, used + slots) != used);
+    return true;
+}
+
+static void crucible_interrupt_sha256(const uint8_t *data, size_t length,
+                                      uint8_t digest[32])
+{
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    gsize digest_len = 32;
+
+    g_checksum_update(checksum, data, length);
+    g_checksum_get_digest(checksum, digest, &digest_len);
+    g_assert(digest_len == 32);
+}
+
+static void crucible_interrupt_record(
+    const QemuCrucibleFaultRule *rule,
+    const QemuCrucibleInterruptEvent *before,
+    const QemuCrucibleInterruptEvent *after, uint32_t disposition,
+    uint64_t delay_ns, uint32_t copies, uint64_t gap_ns,
+    uint16_t outcome, const uint8_t state_before[32])
+{
+    uint8_t evidence[160] = { 0 };
+    uint8_t before_hash[32], after_hash[32], opportunity_hash[32];
+    uint64_t icount = qemu_crucible_fault_observed_icount();
+
+    memcpy(evidence, "CRUCIRQ1", 8);
+    stw_le_p(evidence + 8, 1);
+    stw_le_p(evidence + 10, crucible_interrupt_scope);
+    stw_le_p(evidence + 12, before->family);
+    stw_le_p(evidence + 14, before->trigger);
+    stw_le_p(evidence + 16, before->polarity);
+    stw_le_p(evidence + 18, before->model_phase);
+    stl_le_p(evidence + 20, before->target_vcpu);
+    stl_le_p(evidence + 24, before->vector);
+    stl_le_p(evidence + 28, after->vector);
+    stl_le_p(evidence + 32, disposition);
+    stl_le_p(evidence + 36, copies);
+    stq_le_p(evidence + 40, delay_ns);
+    stq_le_p(evidence + 48, gap_ns);
+    stq_le_p(evidence + 56, before->source_sequence);
+    stq_le_p(evidence + 64, before->routing_generation);
+    stl_le_p(evidence + 72, before->duplicate_ordinal);
+    stl_le_p(evidence + 76, before->controller_source);
+    stq_le_p(evidence + 80, icount);
+    if (state_before) {
+        memcpy(before_hash, state_before, sizeof(before_hash));
+    } else if (qemu_crucible_fault_execution_fingerprint(
+                   icount, before_hash) != 0) {
+        memset(before_hash, 0, sizeof(before_hash));
+    }
+    memcpy(evidence + 96, before_hash, 32);
+    if (qemu_crucible_fault_execution_fingerprint(
+            icount, after_hash) != 0) {
+        memset(after_hash, 0, sizeof(after_hash));
+    }
+    memcpy(evidence + 128, after_hash, 32);
+    crucible_interrupt_sha256(evidence, sizeof(evidence), opportunity_hash);
+    qemu_crucible_fault_rule_event(
+        rule, outcome, icount,
+        opportunity_hash, before_hash, after_hash,
+        evidence, sizeof(evidence));
+}
+
+static void crucible_interrupt_terminal_error(
+    const QemuCrucibleFaultRule *rule, uint32_t code)
+{
+    uint8_t evidence[64] = { 0 };
+    uint8_t state[32], opportunity[32];
+    uint64_t icount = qemu_crucible_fault_observed_icount();
+
+    if (crucible_interrupt_event_terminal_latched) {
+        return;
+    }
+    memcpy(evidence, "CRUCIER1", 8);
+    stl_le_p(evidence + 8, code);
+    stq_le_p(evidence + 16, icount);
+    if (qemu_crucible_fault_execution_fingerprint(icount, state) != 0) {
+        memset(state, 0, sizeof(state));
+    }
+    crucible_interrupt_sha256(evidence, sizeof(evidence), opportunity);
+    qemu_crucible_fault_rule_event(
+        rule, CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR, icount,
+        opportunity, state, state, evidence, sizeof(evidence));
+    qemu_crucible_fault_interrupt_event_terminal();
+    qemu_crucible_fault_notify_events();
+    qemu_system_vmstop_request_prepare();
+    qemu_system_vmstop_request(RUN_STATE_INTERNAL_ERROR);
+}
+
+static int crucible_interrupt_disposition_impulse(
+    const QemuCrucibleFaultRule *rule, uint64_t observed_icount,
+    uint8_t before_hash[32], uint8_t after_hash[32], GByteArray *evidence,
+    uint16_t *outcome,
+    QemuCrucibleFaultEventReservation **event_reservation)
+{
+    CrucibleInterruptImpulse *impulse;
+
+    if (!event_reservation || !*event_reservation ||
+        qemu_crucible_fault_interrupt_validate(rule) != 0) {
+        return -EINVAL;
+    }
+    for (guint i = 0; crucible_interrupt_impulses &&
+                        i < crucible_interrupt_impulses->len; i++) {
+        CrucibleInterruptImpulse *pending =
+            g_ptr_array_index(crucible_interrupt_impulses, i);
+
+        if (crucible_interrupt_same_coordinate(rule, pending->rule)) {
+            return -EEXIST;
+        }
+    }
+    impulse = g_new0(CrucibleInterruptImpulse, 1);
+    impulse->rule = qemu_crucible_fault_rule_copy(rule);
+    impulse->command_icount = observed_icount;
+    memcpy(impulse->before_hash, before_hash, 32);
+    impulse->event_reservation = *event_reservation;
+    *event_reservation = NULL;
+    if (!crucible_interrupt_impulses) {
+        crucible_interrupt_impulses = g_ptr_array_new();
+    }
+    g_ptr_array_add(crucible_interrupt_impulses, impulse);
+    memcpy(after_hash, before_hash, 32);
+    g_byte_array_set_size(evidence, 0);
+    *outcome = CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED;
+    return QEMU_CRUCIBLE_FAULT_IMPULSE_DEFERRED;
+}
+
+bool qemu_crucible_fault_interrupt_intercept(
+    QemuCrucibleInterruptEvent *event,
+    QemuCrucibleInterruptInjectFn inject, void *opaque)
+{
+    CrucibleInterruptMatch match = { .event = event };
+    QemuCrucibleInterruptEvent original;
+    CrucibleInterruptImpulse *impulse = NULL;
+    uint32_t disposition, copies, replacement;
+    uint64_t delay_ns, gap_ns;
+    guint row_index, impulse_index = 0;
+
+    if (!event) {
+        return true;
+    }
+    if (event->release_phase == event->model_phase) {
+        event->release_phase = 0;
+        event->disposition = 0;
+        return true;
+    }
+    if (!crucible_interrupt_bindings_sealed) {
+        return true;
+    }
+    match.row = crucible_interrupt_event_row(event, &row_index);
+    if (!match.row) {
+        return true;
+    }
+    match.binding = &g_array_index(
+        crucible_interrupt_bindings, CrucibleInterruptBinding, row_index);
+    qemu_crucible_fault_rule_foreach(
+        CRUCIBLE_FAULT_COMMAND_INTERRUPT_DISPOSITION,
+        crucible_interrupt_match_visit, &match);
+    if (match.conflict) {
+        original = *event;
+        crucible_interrupt_pending_commit = g_new0(
+            CrucibleInterruptCommit, 1);
+        crucible_interrupt_pending_commit->rule =
+            qemu_crucible_fault_rule_copy(match.rule);
+        crucible_interrupt_pending_commit->before = original;
+        crucible_interrupt_pending_commit->after = original;
+        crucible_interrupt_pending_commit->outcome =
+            CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR;
+        if (qemu_crucible_fault_execution_fingerprint(
+                qemu_crucible_fault_observed_icount(),
+                crucible_interrupt_pending_commit->before_hash) != 0) {
+            memset(crucible_interrupt_pending_commit->before_hash, 0,
+                   sizeof(crucible_interrupt_pending_commit->before_hash));
+        }
+        return false;
+    }
+    for (guint i = 0; crucible_interrupt_impulses &&
+                        i < crucible_interrupt_impulses->len; i++) {
+        CrucibleInterruptImpulse *candidate =
+            g_ptr_array_index(crucible_interrupt_impulses, i);
+        if (crucible_interrupt_rule_matches(
+                candidate->rule, event, match.row, match.binding)) {
+            if (match.rule) {
+                continue;
+            }
+            match.rule = candidate->rule;
+            impulse = candidate;
+            impulse_index = i;
+        }
+    }
+    if (!match.rule ||
+        !crucible_interrupt_rule_u32(
+            match.rule, CRUCIBLE_NODE_FAULT_FIELD_P1, &disposition) ||
+        !crucible_interrupt_rule_u64(
+            match.rule, CRUCIBLE_NODE_FAULT_FIELD_P2, &delay_ns) ||
+        !crucible_interrupt_rule_u32(
+            match.rule, CRUCIBLE_NODE_FAULT_FIELD_P3, &copies) ||
+        !crucible_interrupt_rule_u64(
+            match.rule, CRUCIBLE_NODE_FAULT_FIELD_P4, &gap_ns) ||
+        !crucible_interrupt_rule_u32(
+            match.rule, CRUCIBLE_NODE_FAULT_FIELD_P5, &replacement)) {
+        return true;
+    }
+    original = *event;
+    event->disposition = disposition;
+    g_assert(crucible_interrupt_pending_commit == NULL);
+    crucible_interrupt_pending_commit = g_new0(
+        CrucibleInterruptCommit, 1);
+    crucible_interrupt_pending_commit->rule =
+        qemu_crucible_fault_rule_copy(match.rule);
+    crucible_interrupt_pending_commit->before = original;
+    crucible_interrupt_pending_commit->after = *event;
+    crucible_interrupt_pending_commit->disposition = disposition;
+    crucible_interrupt_pending_commit->delay_ns = delay_ns;
+    crucible_interrupt_pending_commit->copies = copies;
+    crucible_interrupt_pending_commit->gap_ns = gap_ns;
+    crucible_interrupt_pending_commit->outcome =
+        CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED;
+    if (qemu_crucible_fault_execution_fingerprint(
+            qemu_crucible_fault_observed_icount(),
+            crucible_interrupt_pending_commit->before_hash) != 0) {
+        memset(crucible_interrupt_pending_commit->before_hash, 0,
+               sizeof(crucible_interrupt_pending_commit->before_hash));
+    }
+    if (impulse) {
+        qemu_crucible_fault_event_reservation_consume(
+            impulse->event_reservation);
+        g_ptr_array_remove_index(crucible_interrupt_impulses, impulse_index);
+        crucible_interrupt_pending_commit->impulse = impulse;
+    }
+    if ((disposition == 2 &&
+         !crucible_interrupt_queue_reserve(1, delay_ns)) ||
+        (disposition == 3 &&
+         !crucible_interrupt_queue_reserve(
+             copies, gap_ns * copies))) {
+        crucible_interrupt_pending_commit->outcome =
+            CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR;
+        return false;
+    }
+    if (disposition == 2) {
+        crucible_interrupt_schedule(
+            match.rule, event, inject, opaque, delay_ns);
+    }
+    if (disposition == 3) {
+        for (uint32_t i = 1; i <= copies; i++) {
+            QemuCrucibleInterruptEvent child = *event;
+            uint64_t child_delay;
+
+            child.duplicate_ordinal = i;
+            child_delay = gap_ns * i;
+            crucible_interrupt_schedule(
+                match.rule, &child, inject, opaque, child_delay);
+        }
+    } else if (disposition == 4) {
+        event->vector = replacement;
+    }
+    crucible_interrupt_pending_commit->after = *event;
+    return disposition != 1 && disposition != 2;
+}
+
+void qemu_crucible_fault_interrupt_commit_error(void)
+{
+    if (crucible_interrupt_pending_commit) {
+        crucible_interrupt_pending_commit->outcome =
+            CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR;
+    }
+}
+
+void qemu_crucible_fault_interrupt_committed(
+    const QemuCrucibleInterruptEvent *event)
+{
+    CrucibleInterruptCommit *commit = crucible_interrupt_pending_commit;
+
+    if (!commit) {
+        return;
+    }
+    crucible_interrupt_pending_commit = NULL;
+    if (!event) {
+        event = &commit->after;
+    }
+    crucible_interrupt_record(
+        commit->rule, &commit->before, event, commit->disposition,
+        commit->delay_ns, commit->copies, commit->gap_ns,
+        commit->outcome, commit->before_hash);
+    if (commit->impulse) {
+        CrucibleInterruptImpulse *impulse = commit->impulse;
+        uint8_t after_hash[32];
+        uint8_t applied[64] = { 0 };
+        uint64_t applied_icount = qemu_crucible_fault_observed_icount();
+
+        memcpy(applied, "CRUCIAPL", 8);
+        stw_le_p(applied + 8, event->family);
+        stw_le_p(applied + 10, event->trigger);
+        stw_le_p(applied + 12, event->model_phase);
+        stw_le_p(applied + 14, event->disposition);
+        stl_le_p(applied + 16, event->target_vcpu);
+        stl_le_p(applied + 20, event->vector);
+        stq_le_p(applied + 24, event->source_sequence);
+        stq_le_p(applied + 32, applied_icount);
+        crucible_interrupt_sha256(applied, sizeof(applied), after_hash);
+        if (commit->outcome == CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED) {
+            qemu_crucible_fault_complete_deferred(
+                impulse->rule, impulse->command_icount, applied_icount,
+                impulse->before_hash, after_hash);
+        } else {
+            qemu_crucible_fault_fail_deferred(
+                impulse->rule, applied_icount, impulse->before_hash);
+        }
+        qemu_crucible_fault_event_reservation_release(
+            impulse->event_reservation);
+        qemu_crucible_fault_rule_unref(impulse->rule);
+        g_free(impulse);
+    }
+    if (commit->outcome == CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR) {
+        crucible_interrupt_terminal_error(commit->rule, 2);
+    }
+    qemu_crucible_fault_rule_unref(commit->rule);
+    g_free(commit);
+}
+
+static void crucible_interrupt_storm_free(CrucibleInterruptStorm *storm)
+{
+    if (storm->timer) {
+        timer_del(storm->timer);
+        timer_free(storm->timer);
+    }
+    qemu_crucible_fault_rule_unref(storm->rule);
+    g_free(storm->target_vcpus);
+    g_free(storm);
+}
+
+static void crucible_interrupt_storm_cb(void *opaque)
+{
+    CrucibleInterruptStorm *storm = opaque;
+    CrucibleInterruptInjector *injector =
+        &crucible_interrupt_injectors[storm->row->family];
+    uint32_t count = MIN(storm->burst, storm->total - storm->emitted);
+
+    storm->firing = true;
+    if (!injector->inject || count == 0) {
+        crucible_interrupt_terminal_error(storm->rule, 10);
+        storm->firing = false;
+        for (guint i = 0; i < crucible_interrupt_storms->len; i++) {
+            if (g_ptr_array_index(crucible_interrupt_storms, i) == storm) {
+                g_ptr_array_remove_index(crucible_interrupt_storms, i);
+                break;
+            }
+        }
+        crucible_interrupt_storm_free(storm);
+        return;
+    }
+    for (uint32_t i = 0;
+         i < count && !crucible_interrupt_event_terminal_latched; i++) {
+        uint64_t source_sequence =
+            qemu_crucible_fault_interrupt_source_next_sequence();
+        uint64_t routing_generation =
+            qemu_crucible_fault_interrupt_current_routing_generation();
+
+        for (size_t target = 0;
+             target < storm->target_vcpu_count; target++) {
+            uint8_t before_hash[32];
+            uint16_t outcome = CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED;
+            QemuCrucibleInterruptEvent event = {
+                .family = storm->row->family,
+                .trigger = storm->row->trigger,
+                .polarity = storm->row->polarity,
+                .model_phase = QEMU_CRUCIBLE_INTERRUPT_PHASE_ROUTE,
+                .target_vcpu = storm->target_vcpus[target],
+                .vector = storm->vector,
+                .controller_source = storm->row->family ==
+                        QEMU_CRUCIBLE_INTERRUPT_ARM_GIC_SGI ?
+                    crucible_interrupt_boot_target : UINT32_MAX,
+                .priority = storm->priority,
+                .retain_pending = storm->retain_pending,
+                .source_sequence = source_sequence,
+                .routing_generation = routing_generation,
+                .duplicate_ordinal = storm->emitted + i,
+            };
+
+            if (qemu_crucible_fault_execution_fingerprint(
+                    qemu_crucible_fault_observed_icount(),
+                    before_hash) != 0) {
+                memset(before_hash, 0, sizeof(before_hash));
+            }
+
+            if (injector->validate &&
+                !injector->validate(&event, injector->opaque)) {
+                outcome = CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR;
+            } else if (qemu_crucible_fault_interrupt_intercept(
+                           &event, injector->inject, injector->opaque)) {
+                injector->inject(&event, injector->opaque);
+            }
+            qemu_crucible_fault_interrupt_committed(&event);
+            if (crucible_interrupt_event_terminal_latched) {
+                break;
+            }
+            crucible_interrupt_record(
+                storm->rule, &event, &event, 5, storm->period_ns,
+                storm->burst, 0, outcome, before_hash);
+            if (outcome == CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR) {
+                crucible_interrupt_terminal_error(storm->rule, 4);
+                break;
+            }
+        }
+    }
+    storm->firing = false;
+    storm->emitted += count;
+    if (crucible_interrupt_event_terminal_latched) {
+        for (guint i = 0; i < crucible_interrupt_storms->len; i++) {
+            if (g_ptr_array_index(crucible_interrupt_storms, i) == storm) {
+                g_ptr_array_remove_index(crucible_interrupt_storms, i);
+                break;
+            }
+        }
+        crucible_interrupt_storm_free(storm);
+        return;
+    }
+    if (storm->emitted < storm->total) {
+        storm->next_deadline_ns += storm->period_ns;
+        timer_mod_ns(storm->timer, storm->next_deadline_ns);
+    } else {
+        timer_free(storm->timer);
+        storm->timer = NULL;
+        g_clear_pointer(&storm->target_vcpus, g_free);
+        storm->target_vcpu_count = 0;
+        storm->completed = true;
+    }
+}
+
+static CrucibleInterruptStorm *crucible_interrupt_storm_find(
+    const QemuCrucibleFaultRule *rule)
+{
+    const uint8_t *binding = qemu_crucible_fault_rule_binding_hash(rule);
+
+    for (guint i = 0; crucible_interrupt_storms &&
+                        i < crucible_interrupt_storms->len; i++) {
+        CrucibleInterruptStorm *storm =
+            g_ptr_array_index(crucible_interrupt_storms, i);
+
+        if (memcmp(qemu_crucible_fault_rule_binding_hash(storm->rule),
+                   binding, 32) == 0 &&
+            qemu_crucible_fault_rule_generation(storm->rule) ==
+                qemu_crucible_fault_rule_generation(rule)) {
+            return storm;
+        }
+    }
+    return NULL;
+}
+
+static void crucible_interrupt_storm_visit(
+    const QemuCrucibleFaultRule *rule, void *opaque)
+{
+    CrucibleInterruptStorm *storm;
+    const uint8_t *controller, *source;
+    uint32_t controller_len, source_len;
+    uint32_t target_vcpu, vector, burst, total;
+    uint16_t priority;
+    bool retain_pending;
+    uint64_t period_ns;
+    guint row_index = 0;
+    int64_t now;
+
+    (void)opaque;
+    storm = crucible_interrupt_storm_find(rule);
+    if (storm) {
+        storm->seen = true;
+        return;
+    }
+    if (!qemu_crucible_fault_rule_field(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_T1,
+            CRUCIBLE_NODE_FAULT_FIELD_TYPE_HASH,
+            &controller, &controller_len) || controller_len != 32 ||
+        !qemu_crucible_fault_rule_field(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_T2,
+            CRUCIBLE_NODE_FAULT_FIELD_TYPE_HASH,
+            &source, &source_len) || source_len != 32 ||
+        !crucible_interrupt_rule_u32(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_T3, &target_vcpu) ||
+        !crucible_interrupt_rule_u32(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_T4, &vector) ||
+        !crucible_interrupt_rule_u64(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_P3, &period_ns) ||
+        !crucible_interrupt_rule_u32(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_P4, &burst) ||
+        !crucible_interrupt_rule_u32(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_P5, &total)) {
+        crucible_interrupt_terminal_error(rule, 5);
+        return;
+    }
+    for (; row_index < crucible_interrupt_bindings->len; row_index++) {
+        const CrucibleInterruptBinding *binding = &g_array_index(
+            crucible_interrupt_bindings, CrucibleInterruptBinding,
+            row_index);
+
+        if (memcmp(binding->controller, controller, 32) == 0 &&
+            memcmp(binding->source, source, 32) == 0) {
+            break;
+        }
+    }
+    if (row_index == crucible_interrupt_bindings->len) {
+        crucible_interrupt_terminal_error(rule, 6);
+        return;
+    }
+    if (!crucible_interrupt_injectors[
+            g_array_index(crucible_interrupt_manifest,
+                          CrucibleInterruptCapability, row_index).family]
+             .inject) {
+        crucible_interrupt_terminal_error(rule, 7);
+        return;
+    }
+    if (!crucible_interrupt_storm_routing(
+            rule,
+            &g_array_index(crucible_interrupt_manifest,
+                           CrucibleInterruptCapability, row_index),
+            target_vcpu, vector, &priority, &retain_pending)) {
+        crucible_interrupt_terminal_error(rule, 8);
+        return;
+    }
+    storm = g_new0(CrucibleInterruptStorm, 1);
+    storm->rule = qemu_crucible_fault_rule_copy(rule);
+    storm->row = &g_array_index(
+        crucible_interrupt_manifest, CrucibleInterruptCapability,
+        row_index);
+    if (!crucible_interrupt_storm_targets_copy(
+            rule, &storm->target_vcpus, &storm->target_vcpu_count)) {
+        qemu_crucible_fault_rule_unref(storm->rule);
+        g_free(storm);
+        crucible_interrupt_terminal_error(rule, 9);
+        return;
+    }
+    storm->vector = vector;
+    storm->period_ns = period_ns;
+    storm->burst = burst;
+    storm->total = total;
+    storm->priority = priority;
+    storm->retain_pending = retain_pending;
+    storm->seen = true;
+    storm->timer = timer_new_ns(
+        QEMU_CLOCK_VIRTUAL, crucible_interrupt_storm_cb, storm);
+    now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    storm->next_deadline_ns = now + period_ns;
+    if (!crucible_interrupt_storms) {
+        crucible_interrupt_storms = g_ptr_array_new();
+    }
+    g_ptr_array_add(crucible_interrupt_storms, storm);
+    timer_mod_ns(storm->timer, storm->next_deadline_ns);
+}
+
+void qemu_crucible_fault_interrupt_rules_changed(void)
+{
+    if (crucible_interrupt_event_terminal_latched) {
+        return;
+    }
+    for (guint i = 0; crucible_interrupt_storms &&
+                        i < crucible_interrupt_storms->len; i++) {
+        CrucibleInterruptStorm *storm =
+            g_ptr_array_index(crucible_interrupt_storms, i);
+        storm->seen = false;
+    }
+    qemu_crucible_fault_rule_foreach(
+        CRUCIBLE_FAULT_COMMAND_INTERRUPT_STORM,
+        crucible_interrupt_storm_visit, NULL);
+    for (guint i = 0; crucible_interrupt_storms &&
+                        i < crucible_interrupt_storms->len;) {
+        CrucibleInterruptStorm *storm =
+            g_ptr_array_index(crucible_interrupt_storms, i);
+        if (storm->seen) {
+            i++;
+            continue;
+        }
+        g_ptr_array_remove_index(crucible_interrupt_storms, i);
+        crucible_interrupt_storm_free(storm);
+    }
+}
+
+void qemu_crucible_fault_interrupt_event_terminal(void)
+{
+    crucible_interrupt_event_terminal_latched = true;
+    while (crucible_interrupt_impulses &&
+           crucible_interrupt_impulses->len != 0) {
+        CrucibleInterruptImpulse *impulse =
+            g_ptr_array_index(crucible_interrupt_impulses, 0);
+
+        g_ptr_array_remove_index(crucible_interrupt_impulses, 0);
+        qemu_crucible_fault_fail_deferred(
+            impulse->rule, impulse->command_icount,
+            impulse->before_hash);
+        qemu_crucible_fault_event_reservation_release(
+            impulse->event_reservation);
+        qemu_crucible_fault_rule_unref(impulse->rule);
+        g_free(impulse);
+    }
+    while (crucible_interrupt_deferred &&
+           crucible_interrupt_deferred->len != 0) {
+        CrucibleInterruptDeferred *deferred =
+            g_ptr_array_index(crucible_interrupt_deferred, 0);
+
+        g_ptr_array_remove_index(crucible_interrupt_deferred, 0);
+        timer_del(deferred->timer);
+        timer_free(deferred->timer);
+        qemu_crucible_fault_rule_unref(deferred->rule);
+        g_free(deferred);
+        qatomic_dec(&crucible_interrupt_deferred_reserved);
+    }
+    for (guint i = 0; crucible_interrupt_storms &&
+                        i < crucible_interrupt_storms->len;) {
+        CrucibleInterruptStorm *storm =
+            g_ptr_array_index(crucible_interrupt_storms, i);
+
+        if (storm->firing) {
+            i++;
+            continue;
+        }
+        g_ptr_array_remove_index(crucible_interrupt_storms, i);
+        crucible_interrupt_storm_free(storm);
+    }
+}
+
+bool qemu_crucible_fault_interrupt_ensure_registered(void)
+{
+    uint32_t boundary = 1U << (CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY - 1);
+    const char *control_name;
+    const char *storm_name;
+
+    if (crucible_interrupt_handlers_registered) {
+        return true;
+    }
+    if (!crucible_interrupt_manifest_init()) {
+        return false;
+    }
+    control_name = crucible_interrupt_scope == CRUCIBLE_INTERRUPT_SCOPE_X86_64 ?
+        "qemu.interrupt.control.x86_64.v1" :
+        "qemu.interrupt.control.aarch64.v1";
+    storm_name = crucible_interrupt_scope == CRUCIBLE_INTERRUPT_SCOPE_X86_64 ?
+        "qemu.interrupt.storm.x86_64.v1" :
+        "qemu.interrupt.storm.aarch64.v1";
+    qemu_crucible_fault_node_register(
+        CRUCIBLE_FAULT_COMMAND_INTERRUPT_DISPOSITION,
+        crucible_interrupt_scope, boundary, control_name,
+        crucible_interrupt_disposition_impulse);
+    qemu_crucible_fault_node_register(
+        CRUCIBLE_FAULT_COMMAND_INTERRUPT_STORM,
+        crucible_interrupt_scope, boundary, storm_name, NULL);
+    crucible_interrupt_handlers_registered = true;
+    return true;
+}
