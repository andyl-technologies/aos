+static bool crucible_interrupt_manifest_init(void)
+{
+    CPUState *cpu;
+    CPUClass *cc;
+    size_t count = 0;
+
+    if (crucible_interrupt_manifest) {
+        return true;
+    }
+    cpu = qemu_get_cpu(0);
+    if (!cpu) {
+        return false;
+    }
+    cc = CPU_GET_CLASS(cpu);
+    crucible_interrupt_scope = cc->crucible_register_scope;
+    if (crucible_interrupt_scope == CRUCIBLE_INTERRUPT_SCOPE_X86_64) {
+        crucible_interrupt_templates = crucible_interrupt_x86_templates;
+        crucible_interrupt_template_count =
+            G_N_ELEMENTS(crucible_interrupt_x86_templates);
+    } else if (crucible_interrupt_scope ==
+               CRUCIBLE_INTERRUPT_SCOPE_AARCH64) {
+        crucible_interrupt_templates = crucible_interrupt_arm_templates;
+        crucible_interrupt_template_count =
+            G_N_ELEMENTS(crucible_interrupt_arm_templates);
+    } else {
+        return false;
+    }
+    if (crucible_interrupt_template_count == 0) {
+        return false;
+    }
+    CPU_FOREACH(cpu) {
+        count++;
+    }
+    if (count == 0 || count > 4096) {
+        return false;
+    }
+    crucible_interrupt_targets = g_new(uint32_t, count);
+    crucible_interrupt_target_count = count;
+    count = 0;
+    CPU_FOREACH(cpu) {
+        crucible_interrupt_targets[count++] = cpu->cpu_index;
+    }
+    qsort(crucible_interrupt_targets, count,
+          sizeof(*crucible_interrupt_targets),
+          crucible_interrupt_target_compare);
+    crucible_interrupt_boot_target = crucible_interrupt_targets[0];
+    crucible_interrupt_manifest = g_array_sized_new(
+        false, true, sizeof(CrucibleInterruptCapability),
+        crucible_interrupt_template_count);
+    crucible_interrupt_bindings = g_array_sized_new(
+        false, true, sizeof(CrucibleInterruptBinding),
+        crucible_interrupt_template_count);
+    for (size_t i = 0; i < crucible_interrupt_template_count; i++) {
+        const CrucibleInterruptTemplate *template =
+            &crucible_interrupt_templates[i];
+        const CrucibleInterruptRealizedFamily *realized =
+            &crucible_interrupt_realized[template->family];
+        if (!realized->controller_version) {
+            continue;
+        }
+        CrucibleInterruptCapability row = {
+            .family = template->family,
+            .trigger = template->trigger,
+            .polarity = template->polarity,
+            .delivery_drop = template->delivery_drop,
+            .vector_start = template->vector_start,
+            .vector_end = MIN(template->vector_end,
+                              realized->vector_end),
+            .replacement_vector_start = template->replacement_vector_start,
+            .replacement_vector_end = MIN(
+                template->replacement_vector_end, realized->vector_end),
+            .priority = template->priority,
+            .vmstate = 1,
+            .model_phase_mask = realized->model_phase_mask,
+            .id = template->id,
+            .controller = template->controller,
+            .source = template->source,
+            .controller_version = realized->controller_version,
+            .target_vcpus = template->family ==
+                    QEMU_CRUCIBLE_INTERRUPT_X86_PIC ?
+                &crucible_interrupt_boot_target :
+                crucible_interrupt_targets,
+            .target_vcpu_count = template->family ==
+                    QEMU_CRUCIBLE_INTERRUPT_X86_PIC ?
+                1 : MIN(crucible_interrupt_target_count,
+                        realized->target_vcpu_count),
+        };
+        CrucibleInterruptBinding binding = { 0 };
+
+        if (row.vector_end < row.vector_start ||
+            row.target_vcpu_count == 0) {
+            continue;
+        }
+        g_array_append_val(crucible_interrupt_manifest, row);
+        g_array_append_val(crucible_interrupt_bindings, binding);
+    }
+    return crucible_interrupt_manifest->len != 0;
+}
+
+size_t qemu_plugin_crucible_fault_interrupt_manifest(
+    CrucibleInterruptCapability *out, size_t capacity,
+    uint16_t *architecture)
+{
+    if (!architecture || !crucible_interrupt_manifest_init()) {
+        return 0;
+    }
+    *architecture = crucible_interrupt_scope;
+    if (out && capacity >= crucible_interrupt_manifest->len) {
+        memcpy(out, crucible_interrupt_manifest->data,
+               crucible_interrupt_manifest->len * sizeof(*out));
+    }
+    return crucible_interrupt_manifest->len;
+}
+
+int qemu_plugin_crucible_fault_interrupt_bind(
+    uint32_t row_index, const uint8_t id[32],
+    const uint8_t controller[32], const uint8_t source[32])
+{
+    CrucibleInterruptBinding *binding;
+    uint8_t zero[32] = { 0 };
+
+    if (!id || !controller || !source || crucible_interrupt_bindings_sealed ||
+        !crucible_interrupt_manifest_init() ||
+        row_index >= crucible_interrupt_bindings->len ||
+        memcmp(id, zero, 32) == 0 || memcmp(controller, zero, 32) == 0 ||
+        memcmp(source, zero, 32) == 0) {
+        return -EINVAL;
+    }
+    binding = &g_array_index(crucible_interrupt_bindings,
+                             CrucibleInterruptBinding, row_index);
+    if (binding->bound) {
+        return -EEXIST;
+    }
+    for (guint i = 0; i < crucible_interrupt_bindings->len; i++) {
+        CrucibleInterruptBinding *other = &g_array_index(
+            crucible_interrupt_bindings, CrucibleInterruptBinding, i);
+
+        if (other->bound && memcmp(other->id, id, 32) == 0) {
+            return -EEXIST;
+        }
+    }
+    memcpy(binding->id, id, 32);
+    memcpy(binding->controller, controller, 32);
+    memcpy(binding->source, source, 32);
+    binding->bound = true;
+    return 0;
+}
+
+int qemu_plugin_crucible_fault_interrupt_bindings_seal(void)
+{
+    if (crucible_interrupt_bindings_sealed ||
+        !crucible_interrupt_bindings ||
+        crucible_interrupt_bindings->len != crucible_interrupt_manifest->len) {
+        return -EINVAL;
+    }
+    for (guint i = 0; i < crucible_interrupt_bindings->len; i++) {
+        if (!g_array_index(crucible_interrupt_bindings,
+                           CrucibleInterruptBinding, i).bound) {
+            return -EINVAL;
+        }
+    }
+    crucible_interrupt_bindings_sealed = true;
+    return 0;
+}
+
+static bool crucible_interrupt_target_allowed(
+    const CrucibleInterruptCapability *row, uint32_t vcpu)
+{
+    for (size_t i = 0; i < row->target_vcpu_count; i++) {
+        if (row->target_vcpus[i] == vcpu) {
+            return true;
+        }
+    }
+    return false;
+}
