+bool qemu_crucible_fault_interrupt_register_family(
+    uint16_t family, uint64_t model_phase_mask,
+    const char *controller_version, uint32_t vector_end,
+    uint32_t target_vcpu_count)
+{
+    CrucibleInterruptRealizedFamily *realized;
+
+    if (family == 0 || family >= G_N_ELEMENTS(crucible_interrupt_realized) ||
+        model_phase_mask == 0 || !controller_version ||
+        target_vcpu_count == 0 ||
+        !g_utf8_validate(controller_version, -1, NULL) ||
+        !g_str_is_ascii(controller_version)) {
+        return false;
+    }
+    if (crucible_interrupt_manifest) {
+        return false;
+    }
+    realized = &crucible_interrupt_realized[family];
+    if (realized->controller_version) {
+        return strcmp(realized->controller_version, controller_version) == 0 &&
+               realized->model_phase_mask == model_phase_mask &&
+               realized->vector_end == vector_end &&
+               realized->target_vcpu_count == target_vcpu_count;
+    }
+    realized->controller_version = g_strdup(controller_version);
+    realized->model_phase_mask = model_phase_mask;
+    realized->vector_end = vector_end;
+    realized->target_vcpu_count = target_vcpu_count;
+    return true;
+}
