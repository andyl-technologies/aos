+static void gicv3_crucible_interrupt_inject(
+    const QemuCrucibleInterruptEvent *event, void *opaque)
+{
+    GICv3State *s = opaque;
+    GICv3CPUState *cs;
+
+    if (event->target_vcpu >= s->num_cpu) {
+        error_report("Crucible GICv3 injection target disappeared");
+        abort();
+    }
+    cs = &s->cpu[event->target_vcpu];
+    if (event->vector < GIC_INTERNAL) {
+        bool pending = cs->gicr_ipendr0 & (1U << event->vector);
+
+        cs->gicr_ipendr0 |= 1U << event->vector;
+        if (!pending || !event->retain_pending) {
+            cs->crucible_interrupt_family[event->vector] = event->family;
+            cs->crucible_interrupt_source_sequence[event->vector] =
+                event->source_sequence;
+            cs->crucible_interrupt_routing_generation[event->vector] =
+                event->routing_generation;
+            cs->crucible_interrupt_priority[event->vector] =
+                event->priority;
+            cs->crucible_interrupt_priority_valid |= 1U << event->vector;
+        }
+        gicv3_redist_update(cs);
+    } else if (event->vector < s->num_irq) {
+        bool pending = s->pending[BIT32_WORD(event->vector)] &
+            BIT32_MASK(event->vector);
+
+        if (!pending || !event->retain_pending) {
+            s->crucible_interrupt_target[event->vector] =
+                event->target_vcpu;
+        }
+        gicv3_gicd_pending_set(s, event->vector);
+        if (!pending || !event->retain_pending) {
+            s->crucible_interrupt_family[event->vector] = event->family;
+            s->crucible_interrupt_source_sequence[event->vector] =
+                event->source_sequence;
+            s->crucible_interrupt_routing_generation[event->vector] =
+                event->routing_generation;
+            s->crucible_interrupt_priority[event->vector] = event->priority;
+            s->crucible_interrupt_priority_valid[
+                BIT32_WORD(event->vector)] |= BIT32_MASK(event->vector);
+        }
+        gicv3_update(s, event->vector, 1);
+    } else if (event->vector >= GICV3_LPI_INTID_START &&
+               event->vector <= ((1U << 24) - 1)) {
+        uint64_t pending_base = cs->gicr_pendbaser &
+            R_GICR_PENDBASER_PHYADDR_MASK;
+        uint8_t pending_byte;
+        bool pending;
+
+        if (address_space_read(
+                &s->dma_as, pending_base + event->vector / 8,
+                MEMTXATTRS_UNSPECIFIED, &pending_byte,
+                sizeof(pending_byte)) != MEMTX_OK) {
+            return;
+        }
+        pending = extract32(pending_byte, event->vector % 8, 1);
+        if (!pending || !event->retain_pending) {
+            if (!qemu_crucible_fault_interrupt_provenance_set(event, true)) {
+                return;
+            }
+        }
+        gicv3_redist_process_lpi(cs, event->vector, 1);
+    } else {
+        error_report("Crucible GICv3 injection vector disappeared");
+        abort();
+    }
+}
