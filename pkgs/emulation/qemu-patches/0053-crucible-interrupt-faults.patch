+static void apic_crucible_inject(const QemuCrucibleInterruptEvent *event,
+                                 void *opaque)
+{
+    APICCommonState *s = opaque;
+
+    apic_set_irq_with_source(
+        s, event->vector,
+        event->trigger == QEMU_CRUCIBLE_INTERRUPT_TRIGGER_LEVEL ?
+            APIC_TRIGGER_LEVEL : APIC_TRIGGER_EDGE,
+        event->family, event->polarity, event->retain_pending,
+        event->source_sequence,
+        event->routing_generation);
+}
+
+static void apic_crucible_inject_target(
+    const QemuCrucibleInterruptEvent *event, void *opaque)
+{
+    CPUState *cpu = qemu_get_cpu(event->target_vcpu);
+    X86CPU *x86_cpu;
+
+    (void)opaque;
+    if (!cpu) {
+        error_report("Crucible APIC injection target disappeared");
+        abort();
+    }
+    x86_cpu = X86_CPU(cpu);
+    if (!x86_cpu->apic_state) {
+        error_report("Crucible APIC injection target has no local APIC");
+        abort();
+    }
+    if (event->family == QEMU_CRUCIBLE_INTERRUPT_X86_NMI) {
+        apic_crucible_nmi_inject(
+            event, APIC_COMMON(x86_cpu->apic_state));
+    } else {
+        apic_crucible_inject(event, APIC_COMMON(x86_cpu->apic_state));
+    }
+}
+
+static bool apic_crucible_route_validate(
+    const QemuCrucibleInterruptEvent *event, void *opaque)
+{
+    CPUState *cpu;
+    X86CPU *x86_cpu;
+
+    (void)opaque;
+    cpu = qemu_get_cpu(event->target_vcpu);
+    if (!cpu) {
+        return false;
+    }
+    x86_cpu = X86_CPU(cpu);
+    if (!x86_cpu->apic_state) {
+        return false;
+    }
+    if (event->family == QEMU_CRUCIBLE_INTERRUPT_X86_NMI) {
+        return event->vector == 2;
+    }
+    return event->vector >= 16 && event->vector <= 255 &&
+        (!event->release_phase ||
+         !apic_get_bit(APIC_COMMON(x86_cpu->apic_state)->irr,
+                       event->vector));
+}
+
+static bool apic_crucible_route(APICCommonState *s, CPUState *src_cpu,
+                                int vector_num, int trigger_mode,
+                                uint16_t fallback_family,
+                                uint64_t source_sequence,
+                                uint64_t routing_generation)
+{
+    QemuCrucibleInterruptEvent event = {
+        .family = src_cpu ? QEMU_CRUCIBLE_INTERRUPT_X86_IPI :
+            qemu_crucible_fault_interrupt_source_current(fallback_family),
+        .trigger = trigger_mode == APIC_TRIGGER_LEVEL ?
+            QEMU_CRUCIBLE_INTERRUPT_TRIGGER_LEVEL :
+            QEMU_CRUCIBLE_INTERRUPT_TRIGGER_EDGE,
+        .polarity = qemu_crucible_fault_interrupt_source_current_polarity(
+            QEMU_CRUCIBLE_INTERRUPT_POLARITY_HIGH),
+        .model_phase = QEMU_CRUCIBLE_INTERRUPT_PHASE_ROUTE,
+        .target_vcpu = CPU(s->cpu)->cpu_index,
+        .vector = vector_num,
+        .priority = vector_num >> 4,
+        .source_sequence = source_sequence,
+        .routing_generation = routing_generation,
+    };
+
+    if (qemu_crucible_fault_interrupt_intercept(
+            &event, apic_crucible_inject, s)) {
+        if (event.vector != vector_num &&
+            (apic_get_bit(s->irr, event.vector) ||
+             apic_get_bit(s->isr, event.vector))) {
+            qemu_crucible_fault_interrupt_commit_error();
+            qemu_crucible_fault_interrupt_committed(&event);
+            return false;
+        }
+        event.priority = event.vector >> 4;
+        apic_crucible_inject(&event, s);
+        qemu_crucible_fault_interrupt_committed(&event);
+        return true;
+    }
+    if (event.disposition == 1 && trigger_mode == APIC_TRIGGER_LEVEL &&
+        event.family == QEMU_CRUCIBLE_INTERRUPT_X86_IO_APIC) {
+        ioapic_eoi_broadcast(vector_num);
+    }
+    qemu_crucible_fault_interrupt_committed(&event);
+    return false;
+}
