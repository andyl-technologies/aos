diff --git a/accel/tcg/icount-common.c b/accel/tcg/icount-common.c
index 263674246..d8554b767 100644
--- a/accel/tcg/icount-common.c
+++ b/accel/tcg/icount-common.c
@@ -105,6 +105,20 @@ uint64_t icount_crucible_rr_cursor_position(void)
     return timers_state.crucible_rr_cursor_position;
 }
 
+void icount_crucible_rr_snapshot_resume_prepare(void)
+{
+    if (icount_crucible_rr_switch_quantum() != 0 &&
+        timers_state.crucible_rr_cursor_valid) {
+        /*
+         * A loaded snapshot selects its serialized owner before consulting the
+         * new RR thread's local loop cursor. Give source-side continuation the
+         * same one-shot selection so snapshot creation cannot change the next
+         * vCPU or discard a nonzero intra-turn position.
+         */
+        timers_state.crucible_rr_selection_pending = true;
+    }
+}
+
 uint64_t icount_crucible_rr_cursor_position_observed(CPUState *cpu)
 {
     uint64_t quantum = icount_crucible_rr_switch_quantum();
