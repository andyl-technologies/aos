+/** Architecture-owned description of one register-fault target. */
+typedef struct CrucibleCPURegisterCapability {
+    uint32_t numeric_id;
+    char *name;
+    uint32_t width_bits;
+    uint16_t group;
+    uint64_t model_phase_mask;
+    uint32_t side_effects;
+    uint32_t capabilities;
+    uint8_t *writable_mask;
+    uint8_t *reserved_mask;
+    uint8_t *ignored_mask;
+    uint8_t *read_only_mask;
+    size_t mask_bytes;
+} CrucibleCPURegisterCapability;
+
+/*
+ * The architecture owns target enumeration and read/write semantics.  A
+ * successful descriptor call transfers its name and mask allocations to the
+ * caller, which releases them with g_free().  Numeric IDs are architecture ABI,
+ * not GDB register numbers or CPU-structure offsets.
+ */
