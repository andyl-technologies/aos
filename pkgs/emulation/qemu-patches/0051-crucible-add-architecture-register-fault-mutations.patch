+    CPUState *cpu, uint32_t numeric_id, uint8_t *value, size_t value_len);
+typedef int (*CrucibleCPURegisterWriteFn)(
+    CPUState *cpu, uint32_t numeric_id, const uint8_t *value,
+    size_t value_len, uint32_t *performed_side_effects);
