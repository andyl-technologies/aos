index 0000000..f6a31a3
--- /dev/null
+++ b/target/arm/crucible-register.c
@@ -0,0 +1,424 @@
+/*
+ * Crucible AArch64 architecture register fault targets
+ *
+ * Copyright (c) 2026 ANDYL Technologies
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "cpu.h"
+#include "cpregs.h"
+#include "internals.h"
+#include "exec/tb-flush.h"
+
+#define CRUCIBLE_REG_GROUP_GPR 1
+#define CRUCIBLE_REG_GROUP_CONTROL_FLOW 2
+#define CRUCIBLE_REG_GROUP_FLAGS 3
+#define CRUCIBLE_REG_GROUP_SYSTEM 6
+#define CRUCIBLE_REG_GROUP_FLOAT 8
+#define CRUCIBLE_REG_GROUP_VECTOR 9
+
+#define CRUCIBLE_REG_CAP_IMPULSE (1U << 0)
+#define CRUCIBLE_REG_CAP_PERSISTENT (1U << 1)
+#define CRUCIBLE_REG_CAP_VMSTATE (1U << 2)
+#define CRUCIBLE_REG_SIDE_TB (1U << 1)
+#define CRUCIBLE_REG_SIDE_FLAGS (1U << 2)
+#define CRUCIBLE_REG_SIDE_INTERRUPT (1U << 3)
+#define CRUCIBLE_REG_SIDE_CONTROL_FLOW (1U << 5)
+#define CRUCIBLE_REG_PHASES ((UINT64_C(1) << 10) | (UINT64_C(1) << 11))
+
+enum {
+    A64_CRUCIBLE_X_FIRST = 1,
+    A64_CRUCIBLE_X_LAST = 31,
+    A64_CRUCIBLE_SP = 32,
+    A64_CRUCIBLE_PC = 33,
+    A64_CRUCIBLE_PSTATE = 34,
+    A64_CRUCIBLE_V_FIRST = 35,
+    A64_CRUCIBLE_V_LAST = 66,
+    A64_CRUCIBLE_FPSR = 67,
+    A64_CRUCIBLE_FPCR = 68,
+    A64_CRUCIBLE_BASE_COUNT = A64_CRUCIBLE_FPCR,
+    A64_CRUCIBLE_SVE_Z_COUNT = 32,
+    A64_CRUCIBLE_SVE_P_COUNT = 16,
+    A64_CRUCIBLE_SVE_COUNT = 49,
+};
+
+static void a64_crucible_masks(CrucibleCPURegisterCapability *capability,
+                                uint64_t writable)
+{
+    size_t bytes = DIV_ROUND_UP(capability->width_bits, 8);
+
+    capability->mask_bytes = bytes;
+    capability->writable_mask = g_malloc0(bytes);
+    capability->reserved_mask = g_malloc0(bytes);
+    capability->ignored_mask = g_malloc0(bytes);
+    capability->read_only_mask = g_malloc0(bytes);
+    memset(capability->reserved_mask, 0xff, bytes);
+    if (capability->width_bits % 8) {
+        capability->reserved_mask[bytes - 1] =
+            (1U << (capability->width_bits % 8)) - 1;
+    }
+    for (uint32_t bit = 0; bit < MIN(capability->width_bits, 64); bit++) {
+        if (writable & (UINT64_C(1) << bit)) {
+            capability->writable_mask[bit / 8] |= 1U << (bit % 8);
+            capability->reserved_mask[bit / 8] &= ~(1U << (bit % 8));
+        }
+    }
+}
+
+static void a64_crucible_all_writable(
+    CrucibleCPURegisterCapability *capability)
+{
+    size_t bytes = DIV_ROUND_UP(capability->width_bits, 8);
+
+    a64_crucible_masks(capability, UINT64_MAX);
+    if (capability->width_bits > 64) {
+        memset(capability->writable_mask + 8, 0xff, bytes - 8);
+        memset(capability->reserved_mask + 8, 0, bytes - 8);
+        if (capability->width_bits % 8) {
+            capability->writable_mask[bytes - 1] =
+                (1U << (capability->width_bits % 8)) - 1;
+        }
+    }
+    capability->model_phase_mask = CRUCIBLE_REG_PHASES;
+    capability->capabilities = CRUCIBLE_REG_CAP_IMPULSE |
+        CRUCIBLE_REG_CAP_PERSISTENT | CRUCIBLE_REG_CAP_VMSTATE;
+}
+
+static void a64_crucible_writable(
+    CrucibleCPURegisterCapability *capability, uint64_t writable)
+{
+    a64_crucible_masks(capability, writable);
+    capability->model_phase_mask = CRUCIBLE_REG_PHASES;
+    capability->capabilities = CRUCIBLE_REG_CAP_IMPULSE |
+        CRUCIBLE_REG_CAP_PERSISTENT | CRUCIBLE_REG_CAP_VMSTATE;
+}
+
+static void a64_crucible_read_only(
+    CrucibleCPURegisterCapability *capability)
+{
+    size_t bytes = DIV_ROUND_UP(capability->width_bits, 8);
+
+    a64_crucible_masks(capability, 0);
+    memcpy(capability->read_only_mask, capability->reserved_mask, bytes);
+    memset(capability->reserved_mask, 0, bytes);
+    capability->capabilities = CRUCIBLE_REG_CAP_VMSTATE;
+}
+
+static bool a64_crucible_has_sve(ARMCPU *cpu)
+{
+    return cpu_isar_feature(aa64_sve, cpu) && cpu->sve_max_vq != 0;
+}
+
+static gint a64_crucible_compare_key(gconstpointer a, gconstpointer b)
+{
+    uint32_t left = *(const uint32_t *)a;
+    uint32_t right = *(const uint32_t *)b;
+
+    return left > right ? 1 : left < right ? -1 : 0;
+}
+
+static GArray *a64_crucible_sysreg_keys(ARMCPU *cpu)
+{
+    GArray *keys = g_array_new(false, false, sizeof(uint32_t));
+    GHashTableIter iter;
+    gpointer raw_key;
+    gpointer raw_value;
+
+    g_hash_table_iter_init(&iter, cpu->cp_regs);
+    while (g_hash_table_iter_next(&iter, &raw_key, &raw_value)) {
+        ARMCPRegInfo *ri = raw_value;
+        uint32_t key = (uintptr_t)raw_key;
+
+        if (ri->state == ARM_CP_STATE_AA64 &&
+            !(ri->type & (ARM_CP_NO_RAW | ARM_CP_NO_GDB))) {
+            g_array_append_val(keys, key);
+        }
+    }
+    g_array_sort(keys, a64_crucible_compare_key);
+    return keys;
+}
+
+static size_t a64_crucible_fixed_count(ARMCPU *cpu)
+{
+    return A64_CRUCIBLE_BASE_COUNT +
+        (a64_crucible_has_sve(cpu) ? A64_CRUCIBLE_SVE_COUNT : 0);
+}
+
+static const ARMCPRegInfo *a64_crucible_sysreg(ARMCPU *cpu, uint32_t id)
+{
+    g_autoptr(GArray) keys = a64_crucible_sysreg_keys(cpu);
+    size_t fixed = a64_crucible_fixed_count(cpu);
+    size_t index;
+
+    if (id <= fixed) {
+        return NULL;
+    }
+    index = id - fixed - 1;
+    if (index >= keys->len) {
+        return NULL;
+    }
+    return get_arm_cp_reginfo(cpu->cp_regs,
+                              g_array_index(keys, uint32_t, index));
+}
+
+static char *a64_crucible_sysreg_name(const ARMCPRegInfo *ri, uint32_t key)
+{
+    g_autofree char *stem = g_ascii_strdown(ri->name ?: "unnamed", -1);
+
+    for (char *p = stem; *p; p++) {
+        if (!g_ascii_isalnum(*p)) {
+            *p = '-';
+        }
+    }
+    return g_strdup_printf("sysreg-%s-%08x", stem, key);
+}
+
+size_t aarch64_crucible_register_count(CPUState *cs)
+{
+    ARMCPU *cpu = ARM_CPU(cs);
+    g_autoptr(GArray) keys = a64_crucible_sysreg_keys(cpu);
+
+    return a64_crucible_fixed_count(cpu) + keys->len;
+}
+
+bool aarch64_crucible_register_describe(
+    CPUState *cs, size_t index,
+    CrucibleCPURegisterCapability *capability)
+{
+    ARMCPU *cpu = ARM_CPU(cs);
+    bool sve = a64_crucible_has_sve(cpu);
+    uint32_t id = index + 1;
+    size_t fixed = a64_crucible_fixed_count(cpu);
+
+    if (!capability || id > aarch64_crucible_register_count(cs)) {
+        return false;
+    }
+    *capability = (CrucibleCPURegisterCapability) { .numeric_id = id };
+    if (id >= A64_CRUCIBLE_X_FIRST && id <= A64_CRUCIBLE_X_LAST) {
+        capability->name = g_strdup_printf("x%u", id - 1);
+        capability->width_bits = 64;
+        capability->group = CRUCIBLE_REG_GROUP_GPR;
+        a64_crucible_all_writable(capability);
+    } else if (id == A64_CRUCIBLE_SP) {
+        capability->name = g_strdup("sp");
+        capability->width_bits = 64;
+        capability->group = CRUCIBLE_REG_GROUP_GPR;
+        a64_crucible_all_writable(capability);
+    } else if (id == A64_CRUCIBLE_PC) {
+        capability->name = g_strdup("pc");
+        capability->width_bits = 64;
+        capability->group = CRUCIBLE_REG_GROUP_CONTROL_FLOW;
+        capability->side_effects = CRUCIBLE_REG_SIDE_TB |
+            CRUCIBLE_REG_SIDE_CONTROL_FLOW;
+        a64_crucible_all_writable(capability);
+    } else if (id == A64_CRUCIBLE_PSTATE) {
+        capability->name = g_strdup("pstate");
+        capability->width_bits = 32;
+        capability->group = CRUCIBLE_REG_GROUP_FLAGS;
+        capability->side_effects = CRUCIBLE_REG_SIDE_TB |
+            CRUCIBLE_REG_SIDE_FLAGS | CRUCIBLE_REG_SIDE_INTERRUPT;
+        a64_crucible_writable(capability, PSTATE_NZCV | PSTATE_DAIF);
+    } else if (id >= A64_CRUCIBLE_V_FIRST && id <= A64_CRUCIBLE_V_LAST) {
+        capability->name = g_strdup_printf("v%u", id - A64_CRUCIBLE_V_FIRST);
+        capability->width_bits = 128;
+        capability->group = CRUCIBLE_REG_GROUP_VECTOR;
+        a64_crucible_all_writable(capability);
+    } else if (id == A64_CRUCIBLE_FPSR || id == A64_CRUCIBLE_FPCR) {
+        capability->name = g_strdup(id == A64_CRUCIBLE_FPSR ? "fpsr" : "fpcr");
+        capability->width_bits = 32;
+        capability->group = CRUCIBLE_REG_GROUP_FLOAT;
+        capability->side_effects = CRUCIBLE_REG_SIDE_FLAGS;
+        a64_crucible_writable(capability, id == A64_CRUCIBLE_FPSR ?
+                               FPSCR_FPSR_MASK : FPSCR_FPCR_MASK);
+    } else if (sve && id <= fixed) {
+        uint32_t relative = id - A64_CRUCIBLE_BASE_COUNT - 1;
+
+        capability->group = CRUCIBLE_REG_GROUP_VECTOR;
+        if (relative < A64_CRUCIBLE_SVE_Z_COUNT) {
+            capability->name = g_strdup_printf("z%u", relative);
+            capability->width_bits = cpu->sve_max_vq * 128;
+        } else if (relative < A64_CRUCIBLE_SVE_Z_COUNT +
+                   A64_CRUCIBLE_SVE_P_COUNT) {
+            capability->name = g_strdup_printf(
+                "p%u", relative - A64_CRUCIBLE_SVE_Z_COUNT);
+            capability->width_bits = cpu->sve_max_vq * 16;
+        } else {
+            capability->name = g_strdup("ffr");
+            capability->width_bits = cpu->sve_max_vq * 16;
+        }
+        a64_crucible_all_writable(capability);
+    } else {
+        g_autoptr(GArray) keys = a64_crucible_sysreg_keys(cpu);
+        size_t sys_index = id - fixed - 1;
+        uint32_t key = g_array_index(keys, uint32_t, sys_index);
+        const ARMCPRegInfo *ri = get_arm_cp_reginfo(cpu->cp_regs, key);
+
+        capability->name = a64_crucible_sysreg_name(ri, key);
+        capability->width_bits = cpreg_field_is_64bit(ri) ? 64 : 32;
+        capability->group = CRUCIBLE_REG_GROUP_SYSTEM;
+        a64_crucible_read_only(capability);
+    }
+    return capability->name != NULL;
+}
+
+static int a64_crucible_width(ARMCPU *cpu, uint32_t id)
+{
+    size_t fixed = a64_crucible_fixed_count(cpu);
+
+    if (id >= A64_CRUCIBLE_X_FIRST && id <= A64_CRUCIBLE_PC) {
+        return 8;
+    }
+    if (id == A64_CRUCIBLE_PSTATE || id == A64_CRUCIBLE_FPSR ||
+        id == A64_CRUCIBLE_FPCR) {
+        return 4;
+    }
+    if (id >= A64_CRUCIBLE_V_FIRST && id <= A64_CRUCIBLE_V_LAST) {
+        return 16;
+    }
+    if (a64_crucible_has_sve(cpu) && id > A64_CRUCIBLE_BASE_COUNT &&
+        id <= fixed) {
+        uint32_t relative = id - A64_CRUCIBLE_BASE_COUNT - 1;
+        return relative < A64_CRUCIBLE_SVE_Z_COUNT ?
+            cpu->sve_max_vq * 16 : cpu->sve_max_vq * 2;
+    }
+    const ARMCPRegInfo *ri = a64_crucible_sysreg(cpu, id);
+    return ri ? (cpreg_field_is_64bit(ri) ? 8 : 4) : -EINVAL;
+}
+
+int aarch64_crucible_register_read(
+    CPUState *cs, uint32_t id, uint8_t *value, size_t value_len)
+{
+    ARMCPU *cpu = ARM_CPU(cs);
+    CPUARMState *env = &cpu->env;
+    int expected = a64_crucible_width(cpu, id);
+    uint64_t scalar = 0;
+
+    if (!value || expected < 0 || value_len != expected) {
+        return -EINVAL;
+    }
+    if (id >= A64_CRUCIBLE_X_FIRST && id <= A64_CRUCIBLE_X_LAST) {
+        scalar = env->xregs[id - 1];
+    } else if (id == A64_CRUCIBLE_SP) {
+        scalar = env->xregs[31];
+    } else if (id == A64_CRUCIBLE_PC) {
+        scalar = env->pc;
+    } else if (id == A64_CRUCIBLE_PSTATE) {
+        scalar = pstate_read(env);
+    } else if (id >= A64_CRUCIBLE_V_FIRST && id <= A64_CRUCIBLE_V_LAST) {
+        uint64_t *reg = aa64_vfp_qreg(env, id - A64_CRUCIBLE_V_FIRST);
+        stq_le_p(value, reg[0]);
+        stq_le_p(value + 8, reg[1]);
+        return expected;
+    } else if (id == A64_CRUCIBLE_FPSR) {
+        scalar = vfp_get_fpsr(env);
+    } else if (id == A64_CRUCIBLE_FPCR) {
+        scalar = vfp_get_fpcr(env);
+    } else if (a64_crucible_has_sve(cpu) &&
+               id > A64_CRUCIBLE_BASE_COUNT &&
+               id <= a64_crucible_fixed_count(cpu)) {
+        uint32_t relative = id - A64_CRUCIBLE_BASE_COUNT - 1;
+
+        if (relative < A64_CRUCIBLE_SVE_Z_COUNT) {
+            for (int vq = 0; vq < cpu->sve_max_vq; vq++) {
+                stq_le_p(value + vq * 16, env->vfp.zregs[relative].d[vq * 2]);
+                stq_le_p(value + vq * 16 + 8,
+                         env->vfp.zregs[relative].d[vq * 2 + 1]);
+            }
+        } else {
+            uint32_t preg = relative - A64_CRUCIBLE_SVE_Z_COUNT;
+            for (int vq = 0; vq < cpu->sve_max_vq; vq += 4) {
+                size_t offset = (vq / 4) * 8;
+                size_t chunk = MIN(8, expected - offset);
+                uint8_t encoded[8];
+
+                stq_le_p(encoded, env->vfp.pregs[preg].p[vq / 4]);
+                memcpy(value + offset, encoded, chunk);
+            }
+        }
+        return expected;
+    } else {
+        const ARMCPRegInfo *ri = a64_crucible_sysreg(cpu, id);
+        scalar = read_raw_cp_reg(env, ri);
+    }
+    if (expected == 4) {
+        stl_le_p(value, scalar);
+    } else {
+        stq_le_p(value, scalar);
+    }
+    return expected;
+}
+
+int aarch64_crucible_register_write(
+    CPUState *cs, uint32_t id, const uint8_t *value,
+    size_t value_len, uint32_t *performed_side_effects)
+{
+    ARMCPU *cpu = ARM_CPU(cs);
+    CPUARMState *env = &cpu->env;
+    int expected = a64_crucible_width(cpu, id);
+    uint64_t scalar;
+    uint32_t effects = 0;
+
+    if (!value || !performed_side_effects || expected < 0 ||
+        value_len != expected || id > a64_crucible_fixed_count(cpu)) {
+        return -EINVAL;
+    }
+    scalar = expected == 4 ? ldl_le_p(value) : ldq_le_p(value);
+    if (id >= A64_CRUCIBLE_X_FIRST && id <= A64_CRUCIBLE_X_LAST) {
+        env->xregs[id - 1] = scalar;
+    } else if (id == A64_CRUCIBLE_SP) {
+        env->xregs[31] = scalar;
+    } else if (id == A64_CRUCIBLE_PC) {
+        env->pc = scalar;
+        effects = CRUCIBLE_REG_SIDE_TB | CRUCIBLE_REG_SIDE_CONTROL_FLOW;
+    } else if (id == A64_CRUCIBLE_PSTATE) {
+        uint32_t old = pstate_read(env);
+        pstate_write(env, (old & ~(PSTATE_NZCV | PSTATE_DAIF)) |
+                     (scalar & (PSTATE_NZCV | PSTATE_DAIF)));
+        arm_rebuild_hflags(env);
+        effects = CRUCIBLE_REG_SIDE_TB | CRUCIBLE_REG_SIDE_FLAGS |
+            CRUCIBLE_REG_SIDE_INTERRUPT;
+    } else if (id >= A64_CRUCIBLE_V_FIRST && id <= A64_CRUCIBLE_V_LAST) {
+        uint64_t *reg = aa64_vfp_qreg(env, id - A64_CRUCIBLE_V_FIRST);
+        reg[0] = ldq_le_p(value);
+        reg[1] = ldq_le_p(value + 8);
+    } else if (id == A64_CRUCIBLE_FPSR) {
+        vfp_set_fpsr(env, scalar);
+        effects = CRUCIBLE_REG_SIDE_FLAGS;
+    } else if (id == A64_CRUCIBLE_FPCR) {
+        vfp_set_fpcr(env, scalar);
+        effects = CRUCIBLE_REG_SIDE_FLAGS;
+    } else if (a64_crucible_has_sve(cpu) &&
+               id > A64_CRUCIBLE_BASE_COUNT &&
+               id <= a64_crucible_fixed_count(cpu)) {
+        uint32_t relative = id - A64_CRUCIBLE_BASE_COUNT - 1;
+
+        if (relative < A64_CRUCIBLE_SVE_Z_COUNT) {
+            for (int vq = 0; vq < cpu->sve_max_vq; vq++) {
+                env->vfp.zregs[relative].d[vq * 2] =
+                    ldq_le_p(value + vq * 16);
+                env->vfp.zregs[relative].d[vq * 2 + 1] =
+                    ldq_le_p(value + vq * 16 + 8);
+            }
+        } else {
+            uint32_t preg = relative - A64_CRUCIBLE_SVE_Z_COUNT;
+            for (int vq = 0; vq < cpu->sve_max_vq; vq += 4) {
+                size_t offset = (vq / 4) * 8;
+                size_t chunk = MIN(8, expected - offset);
+                uint8_t encoded[8];
+
+                stq_le_p(encoded, env->vfp.pregs[preg].p[vq / 4]);
+                memcpy(encoded, value + offset, chunk);
+                env->vfp.pregs[preg].p[vq / 4] = ldq_le_p(encoded);
+            }
+        }
+    } else {
+        return -EINVAL;
+    }
+    if (effects & CRUCIBLE_REG_SIDE_TB) {
+        tb_flush(cs);
+    }
+    *performed_side_effects = effects;
+    return expected;
+}
