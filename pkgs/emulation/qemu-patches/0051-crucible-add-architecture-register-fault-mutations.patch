diff --git a/target/i386/crucible-register.c b/target/i386/crucible-register.c
new file mode 100644
index 0000000..5719f83
--- /dev/null
+++ b/target/i386/crucible-register.c
@@ -0,0 +1,532 @@
+/*
+ * Crucible x86-64 architecture register fault targets
+ *
+ * Copyright (c) 2026 ANDYL Technologies
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "cpu.h"
+#include "exec/cputlb.h"
+#include "exec/tb-flush.h"
+#include "hw/i386/apic.h"
+#include "tcg/helper-tcg.h"
+
+#define CRUCIBLE_REG_GROUP_GPR 1
+#define CRUCIBLE_REG_GROUP_CONTROL_FLOW 2
+#define CRUCIBLE_REG_GROUP_FLAGS 3
+#define CRUCIBLE_REG_GROUP_SEGMENT 4
+#define CRUCIBLE_REG_GROUP_CONTROL 5
+#define CRUCIBLE_REG_GROUP_SYSTEM 6
+#define CRUCIBLE_REG_GROUP_DEBUG 7
+#define CRUCIBLE_REG_GROUP_FLOAT 8
+#define CRUCIBLE_REG_GROUP_VECTOR 9
+
+#define CRUCIBLE_REG_CAP_IMPULSE (1U << 0)
+#define CRUCIBLE_REG_CAP_PERSISTENT (1U << 1)
+#define CRUCIBLE_REG_CAP_VMSTATE (1U << 2)
+#define CRUCIBLE_REG_SIDE_TLB (1U << 0)
+#define CRUCIBLE_REG_SIDE_TB (1U << 1)
+#define CRUCIBLE_REG_SIDE_FLAGS (1U << 2)
+#define CRUCIBLE_REG_SIDE_INTERRUPT (1U << 3)
+#define CRUCIBLE_REG_SIDE_CONTROL_FLOW (1U << 5)
+#define CRUCIBLE_REG_PHASES ((UINT64_C(1) << 10) | (UINT64_C(1) << 11))
+
+enum {
+    X86_CRUCIBLE_GPR_FIRST = 1,
+    X86_CRUCIBLE_GPR_LAST = 16,
+    X86_CRUCIBLE_RIP = 17,
+    X86_CRUCIBLE_RFLAGS = 18,
+    X86_CRUCIBLE_SEG_FIRST = 19,
+    X86_CRUCIBLE_SEG_LAST = 42,
+    X86_CRUCIBLE_KERNEL_GS_BASE = 43,
+    X86_CRUCIBLE_CR0 = 44,
+    X86_CRUCIBLE_CR2 = 45,
+    X86_CRUCIBLE_CR3 = 46,
+    X86_CRUCIBLE_CR4 = 47,
+    X86_CRUCIBLE_CR8 = 48,
+    X86_CRUCIBLE_EFER = 49,
+    X86_CRUCIBLE_DR_FIRST = 50,
+    X86_CRUCIBLE_DR_LAST = 57,
+    X86_CRUCIBLE_ST_FIRST = 58,
+    X86_CRUCIBLE_ST_LAST = 65,
+    X86_CRUCIBLE_MM_FIRST = 66,
+    X86_CRUCIBLE_MM_LAST = 73,
+    X86_CRUCIBLE_FPU_CONTROL = 74,
+    X86_CRUCIBLE_FPU_STATUS = 75,
+    X86_CRUCIBLE_FPU_TAG = 76,
+    X86_CRUCIBLE_FPU_OPCODE = 77,
+    X86_CRUCIBLE_FPU_IP = 78,
+    X86_CRUCIBLE_FPU_DP = 79,
+    X86_CRUCIBLE_XMM_FIRST = 80,
+    X86_CRUCIBLE_XMM_LAST = 95,
+    X86_CRUCIBLE_MXCSR = 96,
+    X86_CRUCIBLE_REGISTER_COUNT = X86_CRUCIBLE_MXCSR,
+};
+
+static const int x86_crucible_gpr_map[16] = {
+    R_EAX, R_EBX, R_ECX, R_EDX, R_ESI, R_EDI, R_EBP, R_ESP,
+    8, 9, 10, 11, 12, 13, 14, 15,
+};
+
+static const char * const x86_crucible_gpr_names[16] = {
+    "rax", "rbx", "rcx", "rdx", "rsi", "rdi", "rbp", "rsp",
+    "r8", "r9", "r10", "r11", "r12", "r13", "r14", "r15",
+};
+
+static const char * const x86_crucible_segment_names[6] = {
+    "cs", "ss", "ds", "es", "fs", "gs",
+};
+
+static const X86Seg x86_crucible_segment_map[6] = {
+    R_CS, R_SS, R_DS, R_ES, R_FS, R_GS,
+};
+
+static void x86_crucible_masks(CrucibleCPURegisterCapability *capability,
+                               uint64_t writable)
+{
+    size_t bytes = DIV_ROUND_UP(capability->width_bits, 8);
+
+    capability->mask_bytes = bytes;
+    capability->writable_mask = g_malloc0(bytes);
+    capability->reserved_mask = g_malloc0(bytes);
+    capability->ignored_mask = g_malloc0(bytes);
+    capability->read_only_mask = g_malloc0(bytes);
+    memset(capability->reserved_mask, 0xff, bytes);
+    if (capability->width_bits % 8) {
+        capability->reserved_mask[bytes - 1] =
+            (1U << (capability->width_bits % 8)) - 1;
+    }
+    for (uint32_t bit = 0; bit < MIN(capability->width_bits, 64); bit++) {
+        if (writable & (UINT64_C(1) << bit)) {
+            capability->writable_mask[bit / 8] |= 1U << (bit % 8);
+            capability->reserved_mask[bit / 8] &= ~(1U << (bit % 8));
+        }
+    }
+}
+
+static void x86_crucible_all_writable(
+    CrucibleCPURegisterCapability *capability)
+{
+    size_t bytes = DIV_ROUND_UP(capability->width_bits, 8);
+
+    x86_crucible_masks(capability, UINT64_MAX);
+    if (capability->width_bits > 64) {
+        memset(capability->writable_mask + 8, 0xff, bytes - 8);
+        memset(capability->reserved_mask + 8, 0, bytes - 8);
+        if (capability->width_bits % 8) {
+            capability->writable_mask[bytes - 1] =
+                (1U << (capability->width_bits % 8)) - 1;
+        }
+    }
+    capability->model_phase_mask = CRUCIBLE_REG_PHASES;
+    capability->capabilities = CRUCIBLE_REG_CAP_IMPULSE |
+        CRUCIBLE_REG_CAP_PERSISTENT | CRUCIBLE_REG_CAP_VMSTATE;
+}
+
+static void x86_crucible_writable(
+    CrucibleCPURegisterCapability *capability, uint64_t writable)
+{
+    x86_crucible_masks(capability, writable);
+    capability->model_phase_mask = CRUCIBLE_REG_PHASES;
+    capability->capabilities = CRUCIBLE_REG_CAP_IMPULSE |
+        CRUCIBLE_REG_CAP_PERSISTENT | CRUCIBLE_REG_CAP_VMSTATE;
+}
+
+static void x86_crucible_read_only(
+    CrucibleCPURegisterCapability *capability)
+{
+    size_t bytes = DIV_ROUND_UP(capability->width_bits, 8);
+
+    x86_crucible_masks(capability, 0);
+    memcpy(capability->read_only_mask, capability->reserved_mask, bytes);
+    memset(capability->reserved_mask, 0, bytes);
+    capability->capabilities = CRUCIBLE_REG_CAP_VMSTATE;
+}
+
+size_t x86_crucible_register_count(CPUState *cs)
+{
+    return X86_CPU(cs) ? X86_CRUCIBLE_REGISTER_COUNT : 0;
+}
+
+bool x86_crucible_register_describe(
+    CPUState *cs, size_t index,
+    CrucibleCPURegisterCapability *capability)
+{
+    CPUX86State *env = &X86_CPU(cs)->env;
+    uint32_t id = index + 1;
+
+    if (!X86_CPU(cs) || !capability || id > X86_CRUCIBLE_REGISTER_COUNT) {
+        return false;
+    }
+    *capability = (CrucibleCPURegisterCapability) {
+        .numeric_id = id,
+    };
+    if (id >= X86_CRUCIBLE_GPR_FIRST && id <= X86_CRUCIBLE_GPR_LAST) {
+        capability->name = g_strdup(x86_crucible_gpr_names[id - 1]);
+        capability->width_bits = 64;
+        capability->group = CRUCIBLE_REG_GROUP_GPR;
+        x86_crucible_all_writable(capability);
+    } else if (id == X86_CRUCIBLE_RIP) {
+        capability->name = g_strdup("rip");
+        capability->width_bits = 64;
+        capability->group = CRUCIBLE_REG_GROUP_CONTROL_FLOW;
+        capability->side_effects = CRUCIBLE_REG_SIDE_TB |
+            CRUCIBLE_REG_SIDE_CONTROL_FLOW;
+        x86_crucible_all_writable(capability);
+    } else if (id == X86_CRUCIBLE_RFLAGS) {
+        capability->name = g_strdup("rflags");
+        capability->width_bits = 64;
+        capability->group = CRUCIBLE_REG_GROUP_FLAGS;
+        capability->side_effects = CRUCIBLE_REG_SIDE_TB |
+            CRUCIBLE_REG_SIDE_FLAGS | CRUCIBLE_REG_SIDE_INTERRUPT;
+        x86_crucible_writable(capability, UINT64_C(0x003f7fd5));
+        capability->read_only_mask[0] |= 1U << 1;
+        capability->reserved_mask[0] &= ~(1U << 1);
+    } else if (id >= X86_CRUCIBLE_SEG_FIRST && id <= X86_CRUCIBLE_SEG_LAST) {
+        uint32_t relative = id - X86_CRUCIBLE_SEG_FIRST;
+        uint32_t segment = relative / 4;
+        uint32_t field = relative % 4;
+        static const char * const suffixes[4] = {
+            "selector", "base", "limit", "attributes",
+        };
+
+        capability->name = g_strdup_printf(
+            "%s-%s", x86_crucible_segment_names[segment], suffixes[field]);
+        capability->width_bits = field == 0 ? 16 :
+            ((field == 2 || field == 3) ? 32 : 64);
+        capability->group = CRUCIBLE_REG_GROUP_SEGMENT;
+        if (field == 0) {
+            capability->side_effects = CRUCIBLE_REG_SIDE_TLB |
+                CRUCIBLE_REG_SIDE_TB | CRUCIBLE_REG_SIDE_FLAGS |
+                CRUCIBLE_REG_SIDE_INTERRUPT;
+            x86_crucible_all_writable(capability);
+        } else {
+            /* Hidden cache fields are diagnostic-only fault references. */
+            x86_crucible_read_only(capability);
+        }
+    } else if (id == X86_CRUCIBLE_KERNEL_GS_BASE) {
+        capability->name = g_strdup("kernel-gs-base");
+        capability->width_bits = 64;
+        capability->group = CRUCIBLE_REG_GROUP_SYSTEM;
+        capability->side_effects = CRUCIBLE_REG_SIDE_TLB |
+            CRUCIBLE_REG_SIDE_TB;
+        x86_crucible_all_writable(capability);
+    } else if (id >= X86_CRUCIBLE_CR0 && id <= X86_CRUCIBLE_EFER) {
+        static const char * const names[6] = {
+            "cr0", "cr2", "cr3", "cr4", "cr8", "efer",
+        };
+        uint64_t writable = UINT64_MAX;
+
+        capability->name = g_strdup(names[id - X86_CRUCIBLE_CR0]);
+        capability->width_bits = 64;
+        capability->group = id == X86_CRUCIBLE_EFER ?
+            CRUCIBLE_REG_GROUP_SYSTEM : CRUCIBLE_REG_GROUP_CONTROL;
+        switch (id) {
+        case X86_CRUCIBLE_CR0:
+        case X86_CRUCIBLE_CR4:
+        case X86_CRUCIBLE_EFER:
+            capability->side_effects = CRUCIBLE_REG_SIDE_TLB |
+                CRUCIBLE_REG_SIDE_TB | CRUCIBLE_REG_SIDE_FLAGS;
+            break;
+        case X86_CRUCIBLE_CR3:
+            capability->side_effects = CRUCIBLE_REG_SIDE_TLB;
+            break;
+        case X86_CRUCIBLE_CR8:
+            capability->side_effects = CRUCIBLE_REG_SIDE_INTERRUPT;
+            break;
+        default:
+            break;
+        }
+        if (id == X86_CRUCIBLE_CR0) {
+            writable = CR0_PE_MASK | CR0_MP_MASK | CR0_EM_MASK | CR0_TS_MASK |
+                CR0_NE_MASK | CR0_WP_MASK | CR0_AM_MASK |
+                CR0_NW_MASK | CR0_CD_MASK | CR0_PG_MASK;
+        } else if (id == X86_CRUCIBLE_CR4) {
+            writable = ~cr4_reserved_bits(env);
+        } else if (id == X86_CRUCIBLE_CR8) {
+            writable = 0x0f;
+        } else if (id == X86_CRUCIBLE_EFER) {
+            writable = MSR_EFER_SCE | MSR_EFER_LME | MSR_EFER_NXE |
+                MSR_EFER_SVME | MSR_EFER_FFXSR;
+        }
+        x86_crucible_writable(capability, writable);
+        if (id == X86_CRUCIBLE_CR0) {
+            capability->read_only_mask[0] |= CR0_ET_MASK;
+            capability->reserved_mask[0] &= ~CR0_ET_MASK;
+        }
+    } else if (id >= X86_CRUCIBLE_DR_FIRST && id <= X86_CRUCIBLE_DR_LAST) {
+        capability->name = g_strdup_printf("dr%u", id - X86_CRUCIBLE_DR_FIRST);
+        capability->width_bits = 64;
+        capability->group = CRUCIBLE_REG_GROUP_DEBUG;
+        x86_crucible_read_only(capability);
+    } else if (id >= X86_CRUCIBLE_ST_FIRST && id <= X86_CRUCIBLE_ST_LAST) {
+        capability->name = g_strdup_printf("st%u", id - X86_CRUCIBLE_ST_FIRST);
+        capability->width_bits = 80;
+        capability->group = CRUCIBLE_REG_GROUP_FLOAT;
+        x86_crucible_all_writable(capability);
+    } else if (id >= X86_CRUCIBLE_MM_FIRST && id <= X86_CRUCIBLE_MM_LAST) {
+        capability->name = g_strdup_printf("mm%u", id - X86_CRUCIBLE_MM_FIRST);
+        capability->width_bits = 64;
+        capability->group = CRUCIBLE_REG_GROUP_FLOAT;
+        x86_crucible_all_writable(capability);
+    } else if (id >= X86_CRUCIBLE_FPU_CONTROL && id <= X86_CRUCIBLE_FPU_DP) {
+        static const char * const names[6] = {
+            "fpu-control", "fpu-status", "fpu-abridged-tag", "fpu-opcode",
+            "fpu-instruction-pointer", "fpu-data-pointer",
+        };
+        static const uint32_t widths[6] = { 16, 16, 8, 16, 64, 64 };
+        uint32_t relative = id - X86_CRUCIBLE_FPU_CONTROL;
+
+        capability->name = g_strdup(names[relative]);
+        capability->width_bits = widths[relative];
+        capability->group = CRUCIBLE_REG_GROUP_FLOAT;
+        capability->side_effects = relative < 3 ?
+            CRUCIBLE_REG_SIDE_FLAGS : 0;
+        if (id == X86_CRUCIBLE_FPU_CONTROL) {
+            x86_crucible_writable(capability, 0x1f3f);
+        } else if (id == X86_CRUCIBLE_FPU_OPCODE) {
+            x86_crucible_writable(capability, 0x07ff);
+        } else {
+            x86_crucible_all_writable(capability);
+        }
+    } else if (id >= X86_CRUCIBLE_XMM_FIRST && id <= X86_CRUCIBLE_XMM_LAST) {
+        capability->name = g_strdup_printf("xmm%u", id - X86_CRUCIBLE_XMM_FIRST);
+        capability->width_bits = 128;
+        capability->group = CRUCIBLE_REG_GROUP_VECTOR;
+        x86_crucible_all_writable(capability);
+    } else if (id == X86_CRUCIBLE_MXCSR) {
+        capability->name = g_strdup("mxcsr");
+        capability->width_bits = 32;
+        capability->group = CRUCIBLE_REG_GROUP_FLOAT;
+        capability->side_effects = CRUCIBLE_REG_SIDE_FLAGS;
+        x86_crucible_writable(capability, 0x0000ffff);
+    }
+    return capability->name != NULL;
+}
+
+static int x86_crucible_exact_length(uint32_t id)
+{
+    if (id >= X86_CRUCIBLE_ST_FIRST && id <= X86_CRUCIBLE_ST_LAST) {
+        return 10;
+    }
+    if (id >= X86_CRUCIBLE_XMM_FIRST && id <= X86_CRUCIBLE_XMM_LAST) {
+        return 16;
+    }
+    if ((id >= X86_CRUCIBLE_SEG_FIRST && id <= X86_CRUCIBLE_SEG_LAST &&
+         (id - X86_CRUCIBLE_SEG_FIRST) % 4 == 0) ||
+        (id >= X86_CRUCIBLE_FPU_CONTROL && id <= X86_CRUCIBLE_FPU_OPCODE &&
+         id != X86_CRUCIBLE_FPU_TAG)) {
+        return 2;
+    }
+    if (id == X86_CRUCIBLE_FPU_TAG) {
+        return 1;
+    }
+    if (id >= X86_CRUCIBLE_SEG_FIRST && id <= X86_CRUCIBLE_SEG_LAST &&
+        (id - X86_CRUCIBLE_SEG_FIRST) % 4 == 2) {
+        return 4;
+    }
+    if (id == X86_CRUCIBLE_MXCSR) {
+        return 4;
+    }
+    return 8;
+}
+
+int x86_crucible_register_read(
+    CPUState *cs, uint32_t id, uint8_t *value, size_t value_len)
+{
+    X86CPU *cpu = X86_CPU(cs);
+    CPUX86State *env = &cpu->env;
+    int expected = x86_crucible_exact_length(id);
+    uint64_t result = 0;
+
+    if (!value || id == 0 || id > X86_CRUCIBLE_REGISTER_COUNT ||
+        value_len != expected) {
+        return -EINVAL;
+    }
+    if (id >= X86_CRUCIBLE_GPR_FIRST && id <= X86_CRUCIBLE_GPR_LAST) {
+        result = env->regs[x86_crucible_gpr_map[id - 1]];
+    } else if (id == X86_CRUCIBLE_RIP) {
+        result = env->eip;
+    } else if (id == X86_CRUCIBLE_RFLAGS) {
+        result = env->eflags;
+    } else if (id >= X86_CRUCIBLE_SEG_FIRST && id <= X86_CRUCIBLE_SEG_LAST) {
+        uint32_t relative = id - X86_CRUCIBLE_SEG_FIRST;
+        SegmentCache *segment = &env->segs[x86_crucible_segment_map[relative / 4]];
+
+        switch (relative % 4) {
+        case 0: result = segment->selector; break;
+        case 1: result = segment->base; break;
+        case 2: result = segment->limit; break;
+        case 3: result = segment->flags; break;
+        }
+    } else if (id == X86_CRUCIBLE_KERNEL_GS_BASE) {
+        result = env->kernelgsbase;
+    } else if (id >= X86_CRUCIBLE_CR0 && id <= X86_CRUCIBLE_CR4) {
+        static const int cr_map[4] = { 0, 2, 3, 4 };
+        result = env->cr[cr_map[id - X86_CRUCIBLE_CR0]];
+    } else if (id == X86_CRUCIBLE_CR8) {
+        result = cpu_get_apic_tpr(cpu->apic_state);
+    } else if (id == X86_CRUCIBLE_EFER) {
+        result = env->efer;
+    } else if (id >= X86_CRUCIBLE_DR_FIRST && id <= X86_CRUCIBLE_DR_LAST) {
+        result = env->dr[id - X86_CRUCIBLE_DR_FIRST];
+    } else if (id >= X86_CRUCIBLE_ST_FIRST && id <= X86_CRUCIBLE_ST_LAST) {
+        floatx80 *fp = &env->fpregs[(id - X86_CRUCIBLE_ST_FIRST +
+                                     env->fpstt) % 8].d;
+        stq_le_p(value, fp->low);
+        stw_le_p(value + 8, fp->high);
+        return expected;
+    } else if (id >= X86_CRUCIBLE_MM_FIRST && id <= X86_CRUCIBLE_MM_LAST) {
+        result = env->fpregs[id - X86_CRUCIBLE_MM_FIRST].mmx._q_MMXReg[0];
+    } else if (id == X86_CRUCIBLE_FPU_CONTROL) {
+        result = env->fpuc;
+    } else if (id == X86_CRUCIBLE_FPU_STATUS) {
+        result = (env->fpus & ~0x3800) | ((env->fpstt & 7) << 11);
+    } else if (id == X86_CRUCIBLE_FPU_TAG) {
+        for (size_t i = 0; i < 8; i++) {
+            result |= (uint64_t)(env->fptags[i] != 0) << i;
+        }
+    } else if (id == X86_CRUCIBLE_FPU_OPCODE) {
+        result = env->fpop;
+    } else if (id == X86_CRUCIBLE_FPU_IP) {
+        result = env->fpip;
+    } else if (id == X86_CRUCIBLE_FPU_DP) {
+        result = env->fpdp;
+    } else if (id >= X86_CRUCIBLE_XMM_FIRST && id <= X86_CRUCIBLE_XMM_LAST) {
+        ZMMReg *reg = &env->xmm_regs[id - X86_CRUCIBLE_XMM_FIRST];
+        stq_le_p(value, reg->ZMM_Q(0));
+        stq_le_p(value + 8, reg->ZMM_Q(1));
+        return expected;
+    } else if (id == X86_CRUCIBLE_MXCSR) {
+        update_mxcsr_from_sse_status(env);
+        result = env->mxcsr;
+    }
+    if (expected == 1) {
+        value[0] = result;
+    } else if (expected == 2) {
+        stw_le_p(value, result);
+    } else if (expected == 4) {
+        stl_le_p(value, result);
+    } else {
+        stq_le_p(value, result);
+    }
+    return expected;
+}
+
+int x86_crucible_register_write(
+    CPUState *cs, uint32_t id, const uint8_t *value,
+    size_t value_len, uint32_t *performed_side_effects)
+{
+    X86CPU *cpu = X86_CPU(cs);
+    CPUX86State *env = &cpu->env;
+    int expected = x86_crucible_exact_length(id);
+    uint64_t input;
+    uint32_t effects = 0;
+
+    if (!value || !performed_side_effects || id == 0 ||
+        id > X86_CRUCIBLE_REGISTER_COUNT || value_len != expected ||
+        (id >= X86_CRUCIBLE_DR_FIRST && id <= X86_CRUCIBLE_DR_LAST) ||
+        (id >= X86_CRUCIBLE_SEG_FIRST && id <= X86_CRUCIBLE_SEG_LAST &&
+         (id - X86_CRUCIBLE_SEG_FIRST) % 4 != 0)) {
+        return -EINVAL;
+    }
+    input = expected == 1 ? value[0] :
+        (expected == 2 ? lduw_le_p(value) :
+         (expected == 4 ? ldl_le_p(value) : ldq_le_p(value)));
+    if (id >= X86_CRUCIBLE_GPR_FIRST && id <= X86_CRUCIBLE_GPR_LAST) {
+        env->regs[x86_crucible_gpr_map[id - 1]] = input;
+    } else if (id == X86_CRUCIBLE_RIP) {
+        env->eip = input;
+        effects = CRUCIBLE_REG_SIDE_TB | CRUCIBLE_REG_SIDE_CONTROL_FLOW;
+    } else if (id == X86_CRUCIBLE_RFLAGS) {
+        cpu_load_eflags(env, input, 0x003f7fd5U);
+        effects = CRUCIBLE_REG_SIDE_TB | CRUCIBLE_REG_SIDE_FLAGS |
+            CRUCIBLE_REG_SIDE_INTERRUPT;
+    } else if (id >= X86_CRUCIBLE_SEG_FIRST && id <= X86_CRUCIBLE_SEG_LAST) {
+        uint32_t relative = id - X86_CRUCIBLE_SEG_FIRST;
+        X86Seg sreg = x86_crucible_segment_map[relative / 4];
+        SegmentCache segment = env->segs[sreg];
+
+        switch (relative % 4) {
+        case 0: segment.selector = input; break;
+        case 1: segment.base = input; break;
+        case 2: segment.limit = input; break;
+        case 3: segment.flags = input; break;
+        }
+        cpu_x86_load_seg_cache(env, sreg, segment.selector, segment.base,
+                               segment.limit, segment.flags);
+        effects = CRUCIBLE_REG_SIDE_TLB | CRUCIBLE_REG_SIDE_TB |
+            CRUCIBLE_REG_SIDE_FLAGS | CRUCIBLE_REG_SIDE_INTERRUPT;
+    } else if (id == X86_CRUCIBLE_KERNEL_GS_BASE) {
+        env->kernelgsbase = input;
+        effects = CRUCIBLE_REG_SIDE_TLB | CRUCIBLE_REG_SIDE_TB;
+    } else if (id == X86_CRUCIBLE_CR0) {
+        if (!(env->cr[0] & CR0_PG_MASK) && (input & CR0_PG_MASK) &&
+            (env->efer & MSR_EFER_LME) && !(env->cr[4] & CR4_PAE_MASK)) {
+            return -EINVAL;
+        }
+        cpu_x86_update_cr0(env, input);
+        effects = CRUCIBLE_REG_SIDE_TLB | CRUCIBLE_REG_SIDE_TB |
+            CRUCIBLE_REG_SIDE_FLAGS;
+    } else if (id == X86_CRUCIBLE_CR2) {
+        env->cr[2] = input;
+    } else if (id == X86_CRUCIBLE_CR3) {
+        cpu_x86_update_cr3(env, input);
+        effects = CRUCIBLE_REG_SIDE_TLB;
+    } else if (id == X86_CRUCIBLE_CR4) {
+        cpu_x86_update_cr4(env, input);
+        effects = CRUCIBLE_REG_SIDE_TLB | CRUCIBLE_REG_SIDE_TB |
+            CRUCIBLE_REG_SIDE_FLAGS;
+    } else if (id == X86_CRUCIBLE_CR8) {
+        cpu_set_apic_tpr(cpu->apic_state, input);
+        effects = CRUCIBLE_REG_SIDE_INTERRUPT;
+    } else if (id == X86_CRUCIBLE_EFER) {
+        cpu_load_efer(env, input);
+        effects = CRUCIBLE_REG_SIDE_TLB | CRUCIBLE_REG_SIDE_TB |
+            CRUCIBLE_REG_SIDE_FLAGS;
+    } else if (id >= X86_CRUCIBLE_ST_FIRST && id <= X86_CRUCIBLE_ST_LAST) {
+        floatx80 *fp = &env->fpregs[(id - X86_CRUCIBLE_ST_FIRST +
+                                     env->fpstt) % 8].d;
+        fp->low = ldq_le_p(value);
+        fp->high = lduw_le_p(value + 8);
+    } else if (id >= X86_CRUCIBLE_MM_FIRST && id <= X86_CRUCIBLE_MM_LAST) {
+        env->fpregs[id - X86_CRUCIBLE_MM_FIRST].mmx._q_MMXReg[0] = input;
+    } else if (id == X86_CRUCIBLE_FPU_CONTROL) {
+        cpu_set_fpuc(env, input);
+        effects = CRUCIBLE_REG_SIDE_FLAGS;
+    } else if (id == X86_CRUCIBLE_FPU_STATUS) {
+        env->fpstt = (input >> 11) & 7;
+        env->fpus = input & ~0x3800;
+        effects = CRUCIBLE_REG_SIDE_FLAGS;
+    } else if (id == X86_CRUCIBLE_FPU_TAG) {
+        for (size_t i = 0; i < 8; i++) {
+            env->fptags[i] = (input >> i) & 1;
+        }
+        effects = CRUCIBLE_REG_SIDE_FLAGS;
+    } else if (id == X86_CRUCIBLE_FPU_OPCODE) {
+        env->fpop = input;
+    } else if (id == X86_CRUCIBLE_FPU_IP) {
+        env->fpip = input;
+    } else if (id == X86_CRUCIBLE_FPU_DP) {
+        env->fpdp = input;
+    } else if (id >= X86_CRUCIBLE_XMM_FIRST && id <= X86_CRUCIBLE_XMM_LAST) {
+        ZMMReg *reg = &env->xmm_regs[id - X86_CRUCIBLE_XMM_FIRST];
+        reg->ZMM_Q(0) = ldq_le_p(value);
+        reg->ZMM_Q(1) = ldq_le_p(value + 8);
+    } else if (id == X86_CRUCIBLE_MXCSR) {
+        cpu_set_mxcsr(env, input);
+        effects = CRUCIBLE_REG_SIDE_FLAGS;
+    } else {
+        return -EINVAL;
+    }
+    if (effects & CRUCIBLE_REG_SIDE_TLB) {
+        tlb_flush(cs);
+    }
+    if (effects & CRUCIBLE_REG_SIDE_TB) {
+        tb_flush(cs);
+    }
+    *performed_side_effects = effects;
+    return expected;
+}
