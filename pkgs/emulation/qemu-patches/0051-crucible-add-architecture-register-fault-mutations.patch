diff --git a/plugins/crucible-fault-register.c b/plugins/crucible-fault-register.c
new file mode 100644
index 0000000..63478a5
--- /dev/null
+++ b/plugins/crucible-fault-register.c
@@ -0,0 +1,664 @@
+/*
+ * Crucible architecture register fault targets
+ *
+ * Copyright (c) 2026 ANDYL Technologies
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "hw/core/cpu.h"
+#include "qemu/crucible-fault.h"
+#include "qemu/error-report.h"
+#include "qemu/module.h"
+#include "qemu/qemu-plugin.h"
+
+#define CRUCIBLE_REGISTER_CAP_IMPULSE (1U << 0)
+#define CRUCIBLE_REGISTER_CAP_PERSISTENT (1U << 1)
+#define CRUCIBLE_REGISTER_SCOPE_X86_64 2
+#define CRUCIBLE_REGISTER_SCOPE_AARCH64 3
+#define CRUCIBLE_REGISTER_SCOPE_ALL 1
+
+typedef struct qemu_plugin_crucible_fault_register_capability
+    CrucibleRegisterCapability;
+
+typedef struct CrucibleRegisterTarget {
+    uint32_t numeric_id;
+    uint32_t width_bits;
+} CrucibleRegisterTarget;
+
+typedef struct CrucibleRegisterApply {
+    CPUState *cpu;
+    const CrucibleRegisterTarget *target;
+    const CrucibleRegisterCapability *capability;
+    uint32_t first_bit;
+    uint32_t bit_count;
+    uint32_t mutation_kind;
+    const uint8_t *mask;
+    uint32_t mask_len;
+    const uint8_t *value;
+    uint32_t value_len;
+} CrucibleRegisterApply;
+
+typedef struct CrucibleRegisterVisit {
+    CPUState *cpu;
+    uint16_t model_phase;
+    uint64_t icount;
+} CrucibleRegisterVisit;
+
+static const char *crucible_cpu_model;
+static GArray *crucible_register_manifest;
+static GArray *crucible_register_targets;
+static GHashTable *crucible_register_bindings;
+static uint16_t crucible_register_scope;
+
+static bool crucible_register_mask_test(const uint8_t *mask, uint32_t bit)
+{
+    return (mask[bit / 8] & (1U << (bit % 8))) != 0;
+}
+
+static bool crucible_register_capability_valid(
+    const CrucibleCPURegisterCapability *capability)
+{
+    uint32_t known_side_effects = (1U << 0) | (1U << 1) | (1U << 2) |
+        (1U << 3) | (1U << 4) | (1U << 5);
+    uint32_t known_capabilities = CRUCIBLE_REGISTER_CAP_IMPULSE |
+        CRUCIBLE_REGISTER_CAP_PERSISTENT | (1U << 2);
+
+    if (!capability->writable_mask || !capability->reserved_mask ||
+        !capability->ignored_mask || !capability->read_only_mask ||
+        capability->group == 0 ||
+        capability->side_effects & ~known_side_effects ||
+        capability->capabilities & ~known_capabilities ||
+        ((capability->capabilities & CRUCIBLE_REGISTER_CAP_PERSISTENT) != 0) !=
+            (capability->model_phase_mask != 0)) {
+        return false;
+    }
+    for (uint32_t bit = 0; bit < capability->width_bits; bit++) {
+        unsigned int classes =
+            crucible_register_mask_test(capability->writable_mask, bit) +
+            crucible_register_mask_test(capability->reserved_mask, bit) +
+            crucible_register_mask_test(capability->ignored_mask, bit) +
+            crucible_register_mask_test(capability->read_only_mask, bit);
+
+        if (classes != 1) {
+            return false;
+        }
+    }
+    for (uint32_t bit = capability->width_bits;
+         bit < capability->mask_bytes * 8; bit++) {
+        if (crucible_register_mask_test(capability->writable_mask, bit) ||
+            crucible_register_mask_test(capability->reserved_mask, bit) ||
+            crucible_register_mask_test(capability->ignored_mask, bit) ||
+            crucible_register_mask_test(capability->read_only_mask, bit)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static void crucible_register_manifest_clear(void)
+{
+    if (crucible_register_manifest) {
+        for (guint i = 0; i < crucible_register_manifest->len; i++) {
+            CrucibleRegisterCapability *row =
+                &g_array_index(crucible_register_manifest,
+                               CrucibleRegisterCapability, i);
+            g_free((char *)row->name);
+            g_free((uint8_t *)row->writable_mask);
+            g_free((uint8_t *)row->reserved_mask);
+            g_free((uint8_t *)row->ignored_mask);
+            g_free((uint8_t *)row->read_only_mask);
+        }
+        g_array_free(crucible_register_manifest, true);
+        crucible_register_manifest = NULL;
+    }
+    g_clear_pointer(&crucible_register_targets, g_array_unref);
+}
+
+static bool crucible_register_manifest_init(void)
+{
+    CPUState *cpu = qemu_get_cpu(0);
+    CPUClass *cc;
+    g_autoptr(GHashTable) names = NULL;
+    size_t target_count;
+
+    if (crucible_register_manifest) {
+        return true;
+    }
+    if (!cpu) {
+        return false;
+    }
+    cc = CPU_GET_CLASS(cpu);
+    if (cc->crucible_register_scope != CRUCIBLE_REGISTER_SCOPE_X86_64 &&
+        cc->crucible_register_scope != CRUCIBLE_REGISTER_SCOPE_AARCH64) {
+        return false;
+    }
+    crucible_register_scope = cc->crucible_register_scope;
+    if (!cc->crucible_register_count || !cc->crucible_register_describe ||
+        !cc->crucible_register_read || !cc->crucible_register_write) {
+        return false;
+    }
+    g_free((char *)crucible_cpu_model);
+    crucible_cpu_model = g_strdup(object_get_typename(OBJECT(cpu)));
+    target_count = cc->crucible_register_count(cpu);
+    names = g_hash_table_new_full(g_str_hash, g_str_equal, g_free, NULL);
+    if (target_count == 0 || target_count > 4096 || !names) {
+        return false;
+    }
+    crucible_register_manifest = g_array_sized_new(
+        false, true,
+        sizeof(CrucibleRegisterCapability),
+        target_count);
+    crucible_register_targets = g_array_sized_new(
+        false, true, sizeof(CrucibleRegisterTarget), target_count);
+    for (size_t index = 0; index < target_count; index++) {
+        CrucibleRegisterCapability row = { 0 };
+        CrucibleRegisterTarget target = { 0 };
+        CrucibleCPURegisterCapability architecture = { 0 };
+
+        if (!cc->crucible_register_describe(cpu, index, &architecture) ||
+            architecture.numeric_id == 0 || !architecture.name ||
+            strlen(architecture.name) > 96 || architecture.width_bits == 0 ||
+            architecture.width_bits > 65536 || architecture.mask_bytes !=
+                DIV_ROUND_UP(architecture.width_bits, 8) ||
+            !crucible_register_capability_valid(&architecture) ||
+            g_hash_table_contains(names, architecture.name)) {
+            g_free(architecture.name);
+            g_free(architecture.writable_mask);
+            g_free(architecture.reserved_mask);
+            g_free(architecture.ignored_mask);
+            g_free(architecture.read_only_mask);
+            goto fail;
+        }
+        if (architecture.numeric_id != index + 1 ||
+            (index > 0 && architecture.numeric_id <=
+                g_array_index(crucible_register_targets,
+                              CrucibleRegisterTarget, index - 1).numeric_id)) {
+            g_free(architecture.name);
+            g_free(architecture.writable_mask);
+            g_free(architecture.reserved_mask);
+            g_free(architecture.ignored_mask);
+            g_free(architecture.read_only_mask);
+            goto fail;
+        }
+        g_hash_table_add(names, g_strdup(architecture.name));
+        target.numeric_id = architecture.numeric_id;
+        target.width_bits = architecture.width_bits;
+        row.numeric_id = target.numeric_id;
+        row.width_bits = target.width_bits;
+        row.group = architecture.group;
+        row.model_phase_mask = architecture.model_phase_mask;
+        row.side_effects = architecture.side_effects;
+        row.capabilities = architecture.capabilities;
+        row.name = architecture.name;
+        row.writable_mask = architecture.writable_mask;
+        row.reserved_mask = architecture.reserved_mask;
+        row.ignored_mask = architecture.ignored_mask;
+        row.read_only_mask = architecture.read_only_mask;
+        row.mask_bytes = architecture.mask_bytes;
+        g_array_append_val(crucible_register_manifest, row);
+        g_array_append_val(crucible_register_targets, target);
+    }
+    if (crucible_register_manifest->len == 0) {
+        goto fail;
+    }
+    return true;
+
+fail:
+    crucible_register_manifest_clear();
+    return false;
+}
+
+size_t qemu_plugin_crucible_fault_register_manifest(
+    CrucibleRegisterCapability *out,
+    size_t capacity, uint16_t *architecture, const char **cpu_model)
+{
+    if (!architecture || !cpu_model || !crucible_register_manifest_init()) {
+        return 0;
+    }
+    *architecture = crucible_register_scope;
+    *cpu_model = crucible_cpu_model;
+    if (out && capacity >= crucible_register_manifest->len) {
+        memcpy(out, crucible_register_manifest->data,
+               crucible_register_manifest->len * sizeof(*out));
+    }
+    return crucible_register_manifest->len;
+}
+
+int qemu_plugin_crucible_fault_register_bind(const uint8_t identity[32],
+                                             uint32_t numeric_id)
+{
+    GBytes *key;
+
+    if (!identity || numeric_id == 0 ||
+        !crucible_register_manifest_init() ||
+        numeric_id > crucible_register_manifest->len) {
+        return -EINVAL;
+    }
+    if (!crucible_register_bindings) {
+        crucible_register_bindings = g_hash_table_new_full(
+            g_bytes_hash, g_bytes_equal,
+            (GDestroyNotify)g_bytes_unref, NULL);
+    }
+    key = g_bytes_new(identity, 32);
+    if (g_hash_table_contains(crucible_register_bindings, key)) {
+        g_bytes_unref(key);
+        return -EEXIST;
+    }
+    g_hash_table_insert(crucible_register_bindings, key,
+                        GUINT_TO_POINTER(numeric_id));
+    return 0;
+}
+
+static const CrucibleRegisterTarget *crucible_register_target(
+    const uint8_t identity[32],
+    const CrucibleRegisterCapability **capability)
+{
+    g_autoptr(GBytes) key = NULL;
+    gpointer binding;
+    uint32_t numeric_id;
+
+    if (!identity || !crucible_register_bindings) {
+        return NULL;
+    }
+    key = g_bytes_new_static(identity, 32);
+    binding = g_hash_table_lookup(crucible_register_bindings, key);
+    numeric_id = GPOINTER_TO_UINT(binding);
+    if (numeric_id == 0 || numeric_id > crucible_register_targets->len) {
+        return NULL;
+    }
+    *capability = &g_array_index(
+        crucible_register_manifest,
+        CrucibleRegisterCapability,
+        numeric_id - 1);
+    return &g_array_index(crucible_register_targets,
+                          CrucibleRegisterTarget, numeric_id - 1);
+}
+
+static bool crucible_register_field(const QemuCrucibleFaultRule *rule,
+                                    uint16_t tag, uint16_t type,
+                                    const uint8_t **data, uint32_t *length)
+{
+    return qemu_crucible_fault_rule_field(rule, tag, type, data, length);
+}
+
+static bool crucible_register_field_u32(const QemuCrucibleFaultRule *rule,
+                                        uint16_t tag, uint32_t *value)
+{
+    const uint8_t *data;
+    uint32_t length;
+
+    if (!crucible_register_field(rule, tag,
+            CRUCIBLE_NODE_FAULT_FIELD_TYPE_U32, &data, &length) ||
+        length != sizeof(*value)) {
+        return false;
+    }
+    *value = ldl_le_p(data);
+    return true;
+}
+
+static bool crucible_register_decode(const QemuCrucibleFaultRule *rule,
+                                     CrucibleRegisterApply *apply)
+{
+    const uint8_t *identity;
+    uint32_t identity_len;
+    uint32_t vcpu;
+    const uint8_t *present;
+    uint32_t present_len;
+
+    if (!crucible_register_field_u32(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_T1, &vcpu) ||
+        !crucible_register_field(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_T3,
+            CRUCIBLE_NODE_FAULT_FIELD_TYPE_HASH,
+            &identity, &identity_len) || identity_len != 32 ||
+        !crucible_register_field_u32(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_P2, &apply->first_bit) ||
+        !crucible_register_field_u32(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_P3, &apply->bit_count) ||
+        !crucible_register_field_u32(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_P4, &apply->mutation_kind) ||
+        !crucible_register_field(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_P5,
+            CRUCIBLE_NODE_FAULT_FIELD_TYPE_BYTES,
+            &apply->mask, &apply->mask_len) ||
+        !crucible_register_field(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_P6,
+            CRUCIBLE_NODE_FAULT_FIELD_TYPE_BOOL,
+            &present, &present_len) || present_len != 1 ||
+        !crucible_register_field(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_P7,
+            CRUCIBLE_NODE_FAULT_FIELD_TYPE_BYTES,
+            &apply->value, &apply->value_len)) {
+        return false;
+    }
+    apply->cpu = qemu_get_cpu(vcpu);
+    apply->target = crucible_register_target(identity, &apply->capability);
+    if (!apply->cpu || !apply->target ||
+        apply->bit_count == 0 ||
+        apply->first_bit > apply->target->width_bits ||
+        apply->bit_count > apply->target->width_bits - apply->first_bit ||
+        apply->mask_len != DIV_ROUND_UP(apply->bit_count, 8) ||
+        apply->value_len != (present[0] ? apply->mask_len : 1) ||
+        apply->mutation_kind < 1 || apply->mutation_kind > 3 ||
+        present[0] != (apply->mutation_kind != 1)) {
+        return false;
+    }
+    for (uint32_t bit = 0; bit < apply->bit_count; bit++) {
+        if (crucible_register_mask_test(apply->mask, bit) &&
+            !crucible_register_mask_test(
+                apply->capability->writable_mask,
+                apply->first_bit + bit)) {
+            return false;
+        }
+    }
+    for (uint32_t bit = apply->bit_count;
+         bit < apply->mask_len * 8; bit++) {
+        if (crucible_register_mask_test(apply->mask, bit) ||
+            (present[0] && crucible_register_mask_test(apply->value, bit))) {
+            return false;
+        }
+    }
+    return true;
+}
+
+int qemu_crucible_fault_register_validate(const QemuCrucibleFaultRule *rule)
+{
+    CrucibleRegisterApply apply = { 0 };
+    uint16_t operation = qemu_crucible_fault_rule_operation(rule);
+
+    if (operation == CRUCIBLE_NODE_FAULT_OPERATION_REMOVE) {
+        return 0;
+    }
+
+    if (!crucible_register_decode(rule, &apply)) {
+        return -ENOENT;
+    }
+    uint16_t phase = qemu_crucible_fault_rule_model_phase(rule);
+
+    if ((operation == CRUCIBLE_NODE_FAULT_OPERATION_APPLY &&
+         !(apply.capability->capabilities & CRUCIBLE_REGISTER_CAP_IMPULSE)) ||
+        (operation == CRUCIBLE_NODE_FAULT_OPERATION_UPSERT &&
+         (phase == 0 || phase > 64 ||
+          !(apply.capability->capabilities &
+            CRUCIBLE_REGISTER_CAP_PERSISTENT) ||
+          !(apply.capability->model_phase_mask &
+            (UINT64_C(1) << (phase - 1)))))) {
+        return -ENOTSUP;
+    }
+    return 0;
+}
+
+static void crucible_register_sha256(const uint8_t *bytes, size_t length,
+                                     uint8_t output[32])
+{
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    gsize digest_len = 32;
+
+    g_checksum_update(checksum, bytes, length);
+    g_checksum_get_digest(checksum, output, &digest_len);
+    g_assert(digest_len == 32);
+}
+
+static int crucible_register_execution_fingerprint(
+    uint64_t icount, const struct qemu_plugin_rr_cursor *rr,
+    uint8_t output[32])
+{
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    CPUState *cpu;
+    gsize digest_len = 32;
+    uint8_t coordinate[32];
+
+    g_checksum_update(checksum,
+                      (const uint8_t *)"crucible.register-fingerprint.v1\0",
+                      strlen("crucible.register-fingerprint.v1") + 1);
+    stq_le_p(coordinate, icount);
+    stq_le_p(coordinate + 8, rr->current_vcpu);
+    stq_le_p(coordinate + 16, rr->cursor_position);
+    stq_le_p(coordinate + 24, rr->rr_switch_quantum);
+    g_checksum_update(checksum, coordinate, sizeof(coordinate));
+    CPU_FOREACH(cpu) {
+        g_autofree uint8_t *registers = NULL;
+        size_t required = 0;
+        uint64_t stamp = 0;
+        uint8_t framing[12];
+
+        if (qemu_plugin_read_vcpu_regs(cpu->cpu_index, NULL, 0,
+                                      &required, &stamp) == 0 ||
+            required == 0) {
+            return -EIO;
+        }
+        registers = g_try_malloc(required);
+        if (!registers ||
+            qemu_plugin_read_vcpu_regs(cpu->cpu_index, registers, required,
+                                      &required, &stamp) != 0) {
+            return -EIO;
+        }
+        if (cpu->cpu_index < 0) {
+            return -EIO;
+        }
+        stl_le_p(framing, cpu->cpu_index);
+        stq_le_p(framing + 4, required);
+        g_checksum_update(checksum, framing, sizeof(framing));
+        g_checksum_update(checksum, registers, required);
+    }
+    g_checksum_get_digest(checksum, output, &digest_len);
+    return digest_len == 32 ? 0 : -EIO;
+}
+
+static void crucible_register_transform(const CrucibleRegisterApply *apply,
+                                        uint8_t *value)
+{
+    for (uint32_t bit = 0; bit < apply->bit_count; bit++) {
+        uint32_t target_bit = apply->first_bit + bit;
+        uint8_t target_mask = 1U << (target_bit % 8);
+        bool selected = crucible_register_mask_test(apply->mask, bit);
+        bool replacement = apply->mutation_kind != 1 &&
+            crucible_register_mask_test(apply->value, bit);
+
+        if (!selected) {
+            continue;
+        }
+        if (apply->mutation_kind == 1) {
+            value[target_bit / 8] ^= target_mask;
+        } else if (replacement) {
+            value[target_bit / 8] |= target_mask;
+        } else {
+            value[target_bit / 8] &= ~target_mask;
+        }
+    }
+}
+
+static int crucible_register_apply(const CrucibleRegisterApply *apply,
+                                   uint64_t icount,
+                                   uint16_t model_phase,
+                                   uint8_t before_hash[32],
+                                   uint8_t after_hash[32],
+                                   GByteArray *evidence)
+{
+    g_autoptr(GByteArray) before = g_byte_array_new();
+    g_autoptr(GByteArray) after = g_byte_array_new();
+    g_autofree uint8_t *desired = NULL;
+    struct qemu_plugin_rr_cursor rr = { 0 };
+    uint8_t fingerprint[32];
+    uint8_t header[128] = { 0 };
+    uint32_t performed_side_effects = 0;
+    size_t bytes = DIV_ROUND_UP(apply->target->width_bits, 8);
+    CPUClass *cc = CPU_GET_CLASS(apply->cpu);
+
+    g_byte_array_set_size(before, bytes);
+    g_byte_array_set_size(after, bytes);
+    if (cc->crucible_register_read(
+            apply->cpu, apply->target->numeric_id,
+            before->data, bytes) != bytes) {
+        return -EIO;
+    }
+    desired = g_memdup2(before->data, bytes);
+    crucible_register_transform(apply, desired);
+    if (cc->crucible_register_write(
+            apply->cpu, apply->target->numeric_id, desired, bytes,
+            &performed_side_effects) != bytes) {
+        return -EIO;
+    }
+    if (performed_side_effects != apply->capability->side_effects ||
+        cc->crucible_register_read(
+            apply->cpu, apply->target->numeric_id,
+            after->data, bytes) != bytes ||
+        memcmp(after->data, desired, bytes) != 0) {
+        return -EIO;
+    }
+    crucible_register_sha256(before->data, before->len, before_hash);
+    crucible_register_sha256(after->data, after->len, after_hash);
+    if (qemu_plugin_rr_cursor(&rr) != 0 ||
+        rr.current_vcpu != apply->cpu->cpu_index ||
+        crucible_register_execution_fingerprint(
+            icount, &rr, fingerprint) != 0) {
+        return -EIO;
+    }
+    memcpy(header, "CRUCQRW1", 8);
+    stw_le_p(header + 8, 1);
+    stw_le_p(header + 10, crucible_register_scope);
+    stw_le_p(header + 12, model_phase);
+    stl_le_p(header + 16, apply->cpu->cpu_index);
+    stl_le_p(header + 20, apply->target->numeric_id);
+    stl_le_p(header + 24, apply->mutation_kind);
+    stl_le_p(header + 28, apply->capability->side_effects);
+    stl_le_p(header + 32, performed_side_effects);
+    stl_le_p(header + 36, apply->first_bit);
+    stl_le_p(header + 40, apply->bit_count);
+    stl_le_p(header + 44, before->len);
+    stl_le_p(header + 48, after->len);
+    stq_le_p(header + 56, icount);
+    stq_le_p(header + 64, rr.current_vcpu);
+    stq_le_p(header + 72, rr.cursor_position);
+    stq_le_p(header + 80, rr.rr_switch_quantum);
+    memcpy(header + 88, fingerprint, sizeof(fingerprint));
+    g_byte_array_append(evidence, header, sizeof(header));
+    g_byte_array_append(evidence, before->data, before->len);
+    g_byte_array_append(evidence, after->data, after->len);
+    return 0;
+}
+
+static int crucible_register_impulse(
+    const QemuCrucibleFaultRule *rule, uint64_t observed_icount,
+    uint8_t before_hash[32], uint8_t after_hash[32], GByteArray *evidence,
+    uint16_t *outcome)
+{
+    CrucibleRegisterApply apply = { 0 };
+
+    if (!crucible_register_decode(rule, &apply)) {
+        return -EINVAL;
+    }
+    *outcome = CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED;
+    return crucible_register_apply(
+        &apply, observed_icount, qemu_crucible_fault_rule_model_phase(rule),
+                                   before_hash, after_hash, evidence);
+}
+
+static void crucible_register_persistent_visit(
+    const QemuCrucibleFaultRule *rule_const, void *opaque)
+{
+    QemuCrucibleFaultRule *rule = (QemuCrucibleFaultRule *)rule_const;
+    CrucibleRegisterVisit *visit = opaque;
+    CrucibleRegisterApply apply = { 0 };
+    g_autoptr(GByteArray) evidence = NULL;
+    uint8_t before_hash[32];
+    uint8_t after_hash[32];
+    uint8_t opportunity_hash[32];
+
+    if (qemu_crucible_fault_rule_model_phase(rule) != visit->model_phase ||
+        !crucible_register_decode(rule, &apply) ||
+        apply.cpu != visit->cpu ||
+        !(apply.capability->capabilities &
+          CRUCIBLE_REGISTER_CAP_PERSISTENT) ||
+        !qemu_crucible_fault_rule_occurs(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_P8)) {
+        return;
+    }
+    evidence = g_byte_array_new();
+    if (crucible_register_apply(&apply, visit->icount, visit->model_phase,
+                                before_hash, after_hash, evidence) != 0) {
+        error_report("Crucible register capability changed after admission");
+        abort();
+    }
+    crucible_register_sha256(evidence->data, evidence->len,
+                             opportunity_hash);
+    qemu_crucible_fault_rule_event(
+        rule, CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED, visit->icount,
+        opportunity_hash, before_hash, after_hash,
+        evidence->data, evidence->len);
+}
+
+static void crucible_register_active_visit(
+    const QemuCrucibleFaultRule *rule, void *opaque)
+{
+    (void)rule;
+    *(bool *)opaque = true;
+}
+
+bool qemu_crucible_fault_register_rules_active(void)
+{
+    bool active = false;
+
+    qemu_crucible_fault_rule_foreach(
+        CRUCIBLE_FAULT_COMMAND_CPU_REGISTER_TRANSFORM,
+        crucible_register_active_visit, &active);
+    return active;
+}
+
+void qemu_crucible_fault_register_instruction_boundary(
+    CPUState *cpu, uint16_t model_phase, uint64_t icount)
+{
+    CrucibleRegisterVisit visit = {
+        .cpu = cpu,
+        .model_phase = model_phase,
+        .icount = icount,
+    };
+
+    qemu_crucible_fault_rule_foreach(
+        CRUCIBLE_FAULT_COMMAND_CPU_REGISTER_TRANSFORM,
+        crucible_register_persistent_visit, &visit);
+}
+
+void qemu_crucible_fault_register_execution_begin(CPUState *cpu)
+{
+    g_assert(!cpu->crucible_register_instruction_active);
+    cpu->crucible_register_before_icount =
+        qemu_crucible_fault_observed_icount();
+    cpu->crucible_register_instruction_active = true;
+}
+
+void qemu_crucible_fault_register_execution_complete(CPUState *cpu)
+{
+    uint64_t after_icount;
+
+    if (!cpu->crucible_register_instruction_active) {
+        return;
+    }
+    after_icount = qemu_crucible_fault_observed_icount();
+    cpu->crucible_register_instruction_active = false;
+    if (after_icount == cpu->crucible_register_before_icount) {
+        return;
+    }
+    if (cpu->crucible_register_before_icount == UINT64_MAX ||
+        after_icount != cpu->crucible_register_before_icount + 1) {
+        error_report("Crucible register fault boundary retired more than one instruction");
+        abort();
+    }
+    qemu_crucible_fault_register_instruction_boundary(
+        cpu, QEMU_CRUCIBLE_MODEL_PHASE_AFTER_INSTRUCTION, after_icount);
+}
+
+static void crucible_register_faults_register(void)
+{
+    const uint32_t boundary =
+        1U << (CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY - 1);
+    uint16_t scope = CRUCIBLE_REGISTER_SCOPE_ALL;
+    qemu_crucible_fault_node_register(
+        CRUCIBLE_FAULT_COMMAND_CPU_REGISTER_TRANSFORM, scope, boundary,
+        "qemu.register.mutate.v1",
+        crucible_register_impulse);
+}
+
+type_init(crucible_register_faults_register)
