+/*
+ * ARM interrupt-controller delivery is already serialized by the single RR
+ * thread. There is therefore no target-side pending queue to drain at the RR
+ * handoff points shared with the x86 APIC adapter.
+ */
+void crucible_sim_det_ipi_drain_pending(void)
+{
+}
+
+int crucible_sim_det_ipi_deliver_commanded(unsigned int target_vcpu,
+                                           unsigned int vector)
+{
+    CPUState *dst_cpu;
+    uint64_t delivery_icount;
+    unsigned int src_vcpu = UINT_MAX;
+
+    if (vector > UINT8_MAX) {
+        return -1;
+    }
+    dst_cpu = qemu_get_cpu(target_vcpu);
+    if (!dst_cpu) {
+        return -1;
+    }
+
+    cpu_interrupt(dst_cpu, CPU_INTERRUPT_HARD);
+    if (current_cpu) {
+        src_vcpu = current_cpu->cpu_index;
+    }
+    delivery_icount = qemu_plugin_icount_raw();
+    qemu_plugin_crucible_maybe_fire_ipi_delivery_cb(
+        0, delivery_icount, src_vcpu, dst_cpu->cpu_index, 0, vector);
+    return 0;
+}
