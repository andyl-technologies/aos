+static void *monitor_registry_worker(void *opaque)
+{
+    void *result;
+
+    qemu_thread_hot_fork_set_current_disposition(
+        QEMU_THREAD_HOT_FORK_MONITOR_RESTART);
+    rcu_register_thread();
+    result = registry_worker(opaque);
+    rcu_unregister_thread();
+    return result;
+}
+
+static void start_registry_worker_thread(
+    RegistryWorkerThread *worker, const char *name,
+    void *(*start_routine)(void *))
+{
+    g_assert_cmpint(pipe2(worker->ready, O_CLOEXEC), ==, 0);
+    g_assert_cmpint(pipe2(worker->release, O_CLOEXEC), ==, 0);
+    worker->worker = (RegistryWorker) {
+        .ready_fd = worker->ready[1],
+        .release_fd = worker->release[0],
+    };
+    qemu_thread_create(&worker->thread, name, start_routine, &worker->worker,
+                       QEMU_THREAD_JOINABLE);
+    g_assert_cmpint(read_child_result(worker->ready[0]), ==, 0);
+}
+
+static void stop_registry_worker_thread(RegistryWorkerThread *worker)
+{
+    write_child_result(worker->release[1], 0);
+    qemu_thread_join(&worker->thread);
+    close(worker->release[0]);
+    close(worker->release[1]);
+    close(worker->ready[0]);
+    close(worker->ready[1]);
+}
