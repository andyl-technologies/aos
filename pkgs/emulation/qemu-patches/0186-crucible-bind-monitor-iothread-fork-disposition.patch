+int qemu_thread_hot_fork_bind_monitor_restart(int64_t thread_id)
+{
+    QemuHotForkThreadRecord *match = NULL;
+    GList *node;
+    int err;
+
+    if (thread_id <= 0) {
+        return -EINVAL;
+    }
+    err = pthread_mutex_lock(&qemu_hot_fork_thread_lock);
+    if (err) {
+        error_exit(err, __func__);
+    }
+    for (node = qemu_hot_fork_threads; node; node = node->next) {
+        QemuHotForkThreadRecord *record = node->data;
+
+        if (record->thread_id == thread_id) {
+            if (match) {
+                match = NULL;
+                break;
+            }
+            match = record;
+        }
+    }
+    if (!match || !match->tracked ||
+        match->disposition != QEMU_THREAD_HOT_FORK_UNCLASSIFIED_AIO) {
+        err = pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+        if (err) {
+            error_exit(err, __func__);
+        }
+        return -ESTALE;
+    }
+    match->disposition = QEMU_THREAD_HOT_FORK_MONITOR_RESTART;
+    qemu_hot_fork_thread_generation++;
+    err = pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+    if (err) {
+        error_exit(err, __func__);
+    }
+    return 0;
+}
+
