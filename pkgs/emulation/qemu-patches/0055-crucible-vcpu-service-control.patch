 }
 
+bool icount_crucible_instructions_to_ns(uint64_t instructions,
+                                        int64_t *nanoseconds)
+{
+    __uint128_t scaled;
+
+    if (!nanoseconds) {
+        return false;
+    }
+    scaled = (__uint128_t)instructions <<
+             qatomic_read(&timers_state.icount_time_shift);
+    if (scaled > INT64_MAX) {
+        return false;
+    }
+    *nanoseconds = scaled;
+    return true;
+}
