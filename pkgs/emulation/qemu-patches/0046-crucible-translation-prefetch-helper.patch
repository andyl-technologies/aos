diff --git a/accel/tcg/crucible-translation-prefetch.c b/accel/tcg/crucible-translation-prefetch.c
new file mode 100644
index 000000000..cef62a21f
--- /dev/null
+++ b/accel/tcg/crucible-translation-prefetch.c
@@ -0,0 +1,153 @@
+/*
+ * Crucible experimental translation-block helper
+ *
+ * This path is deliberately off by default.  At a demand translation miss the
+ * RR vCPU remains stopped, so its architectural state is immutable, while a
+ * dedicated registered TCG context generates the block.  Moving generation to
+ * another host thread is not assumed deterministic: RFC 0010 PERF-32 admits it
+ * only when the real cold-boot fingerprint corpus proves byte identity.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/atomic.h"
+#include "qemu/notify.h"
+#include "qemu/rcu.h"
+#include "qemu/thread.h"
+#include "qemu/error-report.h"
+#include "system/system.h"
+#include "system/tcg.h"
+#include "exec/cpu-common.h"
+#include "exec/translation-block.h"
+#include "hw/core/cpu.h"
+#include "tcg/startup.h"
+
+#include "internal-common.h"
+
+typedef struct CrucibleTranslationRequest {
+    CPUState *cpu;
+    vaddr pc;
+    uint64_t cs_base;
+    uint32_t flags;
+    int cflags;
+    TranslationBlock *result;
+    QemuEvent done;
+} CrucibleTranslationRequest;
+
+typedef struct CrucibleTranslationHelper {
+    QemuMutex lock;
+    QemuCond request_ready;
+    QemuEvent thread_ready;
+    QemuThread thread;
+    CrucibleTranslationRequest *request;
+    Notifier exit_notifier;
+    uint64_t requests;
+    uint64_t completions;
+    bool started;
+} CrucibleTranslationHelper;
+
+static CrucibleTranslationHelper helper;
+
+static void crucible_translation_prefetch_write_report(Notifier *notifier,
+                                                       void *opaque)
+{
+    const char *path = crucible_translation_prefetch_report_path();
+    g_autofree char *contents = NULL;
+    g_autoptr(GError) error = NULL;
+
+    if (!path || !path[0]) {
+        return;
+    }
+
+    contents = g_strdup_printf(
+        "enabled=%s\n"
+        "mode=dedicated-demand-tcg-helper\n"
+        "helper_thread_started=%s\n"
+        "requests=%" PRIu64 "\n"
+        "completions=%" PRIu64 "\n",
+        crucible_translation_prefetch_enabled() ? "true" : "false",
+        helper.started ? "true" : "false",
+        qatomic_read(&helper.requests),
+        qatomic_read(&helper.completions));
+    if (!g_file_set_contents(path, contents, -1, &error)) {
+        warn_report("cannot write Crucible translation-prefetch report %s: %s",
+                    path, error->message);
+    }
+}
+
+static void *crucible_translation_prefetch_thread(void *opaque)
+{
+    rcu_register_thread();
+    tcg_register_thread();
+    qemu_event_set(&helper.thread_ready);
+
+    for (;;) {
+        CrucibleTranslationRequest *request;
+
+        qemu_mutex_lock(&helper.lock);
+        while (!helper.request) {
+            qemu_cond_wait(&helper.request_ready, &helper.lock);
+        }
+        request = helper.request;
+        helper.request = NULL;
+        qemu_mutex_unlock(&helper.lock);
+
+        current_cpu = request->cpu;
+        mmap_lock();
+        request->result = tb_gen_code(request->cpu, request->pc,
+                                      request->cs_base, request->flags,
+                                      request->cflags);
+        mmap_unlock();
+        current_cpu = NULL;
+
+        qatomic_inc(&helper.completions);
+        qemu_event_set(&request->done);
+    }
+
+    return NULL;
+}
+
+void crucible_translation_prefetch_start(void)
+{
+    helper.exit_notifier.notify =
+        crucible_translation_prefetch_write_report;
+    qemu_add_exit_notifier(&helper.exit_notifier);
+
+    if (!crucible_translation_prefetch_enabled()) {
+        return;
+    }
+
+    qemu_mutex_init(&helper.lock);
+    qemu_cond_init(&helper.request_ready);
+    qemu_event_init(&helper.thread_ready, false);
+    qemu_thread_create(&helper.thread, "crucible-tb-helper",
+                       crucible_translation_prefetch_thread, NULL,
+                       QEMU_THREAD_DETACHED);
+    qemu_event_wait(&helper.thread_ready);
+    helper.started = true;
+}
+
+TranslationBlock *crucible_translation_prefetch_generate(
+    CPUState *cpu, vaddr pc, uint64_t cs_base, uint32_t flags, int cflags)
+{
+    CrucibleTranslationRequest request = {
+        .cpu = cpu,
+        .pc = pc,
+        .cs_base = cs_base,
+        .flags = flags,
+        .cflags = cflags,
+    };
+
+    g_assert(helper.started);
+    qemu_event_init(&request.done, false);
+
+    qemu_mutex_lock(&helper.lock);
+    g_assert(!helper.request);
+    helper.request = &request;
+    qatomic_inc(&helper.requests);
+    qemu_cond_signal(&helper.request_ready);
+    qemu_mutex_unlock(&helper.lock);
+
+    qemu_event_wait(&request.done);
+    qemu_event_destroy(&request.done);
+    return request.result;
+}
