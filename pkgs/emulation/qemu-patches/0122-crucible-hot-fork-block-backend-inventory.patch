   'returns': 'CrucibleHotForkAioHandlerInventory',
   'allow-oob': true }
 
+##
+# @CrucibleHotForkBlockBackend:
+#
+# One allocated BlockBackend in the process-local registry.
+#
+# @backend-id: positive stable process-local backend identity
+#
+# @context-id: positive process-local owning AioContext identity
+#
+# @reference-count: current positive backend reference count
+#
+# @name: monitor name, empty for a hidden backend
+#
+# @named: whether this backend is monitor-visible
+#
+# @name-valid: whether @name was bounded and valid UTF-8
+#
+# @root-present: whether a block graph root is attached
+#
+# @device-attached: whether a device model is attached
+#
+# @permissions: requested BLK_PERM_* mask
+#
+# @shared-permissions: shareable BLK_PERM_* mask
+#
+# @write-permission: whether @permissions contains BLK_PERM_WRITE
+#
+# @permissions-disabled: whether migration or inactive state suppresses the
+#     requested permissions
+#
+# @quiesce-depth: instantaneous nested drained-section depth
+#
+# @in-flight: instantaneous backend I/O request count
+#
+# @request-queuing-disabled: whether requests fail instead of waiting while
+#     the backend is drained
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'struct': 'CrucibleHotForkBlockBackend',
+  'data': { 'backend-id': 'uint64',
+            'context-id': 'uint64',
+            'reference-count': 'uint32',
+            'name': 'str',
+            'named': 'bool',
+            'name-valid': 'bool',
+            'root-present': 'bool',
+            'device-attached': 'bool',
+            'permissions': 'uint64',
+            'shared-permissions': 'uint64',
+            'write-permission': 'bool',
+            'permissions-disabled': 'bool',
+            'quiesce-depth': 'uint32',
+            'in-flight': 'uint32',
+            'request-queuing-disabled': 'bool' } }
+
+##
+# @CrucibleHotForkBlockBackendInventory:
+#
+# Bounded observational snapshot of every allocated BlockBackend.  This
+# report does not traverse the block graph, drain I/O, retain immutable write
+# roots, acknowledge readiness proof bit 5, or authorize a fork.
+#
+# @schema-version: inventory contract version, currently 1
+#
+# @generation: monotonic process-local backend lifecycle and structural-state
+#     generation; quiesce and in-flight counts are instantaneous
+#
+# @complete: true exactly when the registry did not overflow and every entry
+#     is structurally valid
+#
+# @overflowed: whether allocated backends exceeded the retained bound
+#
+# @backend-count: number of retained allocated backends
+#
+# @named-backends: retained monitor-visible backends
+#
+# @rooted-backends: retained backends with an attached graph root
+#
+# @device-backends: retained backends attached to a device model
+#
+# @writable-backends: retained backends requesting BLK_PERM_WRITE
+#
+# @quiesced-backends: retained backends with nonzero @quiesce-depth
+#
+# @in-flight: checked sum of retained @in-flight values
+#
+# @backends: allocated backends sorted by @backend-id and bounded to 65536
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'struct': 'CrucibleHotForkBlockBackendInventory',
+  'data': { 'schema-version': 'uint32',
+            'generation': 'uint64',
+            'complete': 'bool',
+            'overflowed': 'bool',
+            'backend-count': 'uint32',
+            'named-backends': 'uint32',
+            'rooted-backends': 'uint32',
+            'device-backends': 'uint32',
+            'writable-backends': 'uint32',
+            'quiesced-backends': 'uint32',
+            'in-flight': 'uint64',
+            'backends': [ 'CrucibleHotForkBlockBackend' ] } }
+
+##
+# @query-crucible-hot-fork-block-backend-inventory:
+#
+# Query every allocated BlockBackend.  This OOB command is observational and
+# cannot acknowledge the immutable writable-block-root readiness proof.
+#
+# Returns: @CrucibleHotForkBlockBackendInventory
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'command': 'query-crucible-hot-fork-block-backend-inventory',
+  'returns': 'CrucibleHotForkBlockBackendInventory',
+  'allow-oob': true }
+
 ##
 # @CrucibleHotForkMutex:
 #
