 include/system/block-backend-global-state.h |  36 +++++
 monitor/qmp-cmds.c                          |  64 ++++++++
 qapi/run-state.json                         | 119 ++++++++++++++
 4 files changed, 389 insertions(+)

diff --git a/block/block-backend.c b/block/block-backend.c
index a402db13f..e9ad4b55d 100644
--- a/block/block-backend.c
+++ b/block/block-backend.c
@@ -92,6 +92,20 @@ struct BlockBackend {
      * Accessed with atomic ops.
      */
     unsigned int in_flight;
+
+    /* Crucible hot-fork observational inventory state. */
+    uint64_t crucible_hot_fork_id;
+    uint64_t crucible_hot_fork_context_id;
+    uint32_t crucible_hot_fork_reference_count;
+    uint64_t crucible_hot_fork_permissions;
+    uint64_t crucible_hot_fork_shared_permissions;
+    bool crucible_hot_fork_named;
+    bool crucible_hot_fork_name_valid;
+    bool crucible_hot_fork_root_present;
+    bool crucible_hot_fork_device_attached;
+    bool crucible_hot_fork_permissions_disabled;
+    char crucible_hot_fork_name[QEMU_BLOCK_BACKEND_HOT_FORK_NAME_MAX + 1];
+    QTAILQ_ENTRY(BlockBackend) crucible_hot_fork_node;
 };
 
 typedef struct BlockBackendAIOCB {
@@ -118,6 +132,142 @@ static QTAILQ_HEAD(, BlockBackend) block_backends =
 static QTAILQ_HEAD(, BlockBackend) monitor_block_backends =
     QTAILQ_HEAD_INITIALIZER(monitor_block_backends);
 
+static QemuMutex crucible_hot_fork_block_backend_lock;
+static QTAILQ_HEAD(, BlockBackend) crucible_hot_fork_block_backends =
+    QTAILQ_HEAD_INITIALIZER(crucible_hot_fork_block_backends);
+static uint64_t crucible_hot_fork_block_backend_next_id = 1;
+static uint64_t crucible_hot_fork_block_backend_generation;
+
+static void __attribute__((__constructor__))
+crucible_hot_fork_block_backend_inventory_init(void)
+{
+    qemu_mutex_init(&crucible_hot_fork_block_backend_lock);
+}
+
+static bool crucible_hot_fork_block_backend_sync_locked(BlockBackend *blk)
+{
+    const char *name = blk->name ?: "";
+    size_t name_length = strlen(name);
+    bool name_valid = name_length <= QEMU_BLOCK_BACKEND_HOT_FORK_NAME_MAX &&
+                      g_utf8_validate(name, name_length, NULL);
+    uint64_t context_id = blk->ctx->crucible_hot_fork_id;
+    bool changed =
+        blk->crucible_hot_fork_context_id != context_id ||
+        blk->crucible_hot_fork_reference_count != blk->refcnt ||
+        blk->crucible_hot_fork_permissions != blk->perm ||
+        blk->crucible_hot_fork_shared_permissions != blk->shared_perm ||
+        blk->crucible_hot_fork_named != (blk->name != NULL) ||
+        blk->crucible_hot_fork_name_valid != name_valid ||
+        blk->crucible_hot_fork_root_present != (blk->root != NULL) ||
+        blk->crucible_hot_fork_device_attached != (blk->dev != NULL) ||
+        blk->crucible_hot_fork_permissions_disabled != blk->disable_perm ||
+        strcmp(blk->crucible_hot_fork_name,
+               name_valid ? name : "<invalid>") != 0;
+
+    blk->crucible_hot_fork_context_id = context_id;
+    blk->crucible_hot_fork_reference_count = blk->refcnt;
+    blk->crucible_hot_fork_permissions = blk->perm;
+    blk->crucible_hot_fork_shared_permissions = blk->shared_perm;
+    blk->crucible_hot_fork_named = blk->name != NULL;
+    blk->crucible_hot_fork_name_valid = name_valid;
+    blk->crucible_hot_fork_root_present = blk->root != NULL;
+    blk->crucible_hot_fork_device_attached = blk->dev != NULL;
+    blk->crucible_hot_fork_permissions_disabled = blk->disable_perm;
+    g_strlcpy(blk->crucible_hot_fork_name,
+              name_valid ? name : "<invalid>",
+              sizeof(blk->crucible_hot_fork_name));
+    return changed;
+}
+
+static void crucible_hot_fork_block_backend_changed(BlockBackend *blk)
+{
+    QEMU_LOCK_GUARD(&crucible_hot_fork_block_backend_lock);
+
+    if (crucible_hot_fork_block_backend_sync_locked(blk)) {
+        crucible_hot_fork_block_backend_generation++;
+    }
+}
+
+static void crucible_hot_fork_block_backend_register(BlockBackend *blk)
+{
+    QEMU_LOCK_GUARD(&crucible_hot_fork_block_backend_lock);
+
+    blk->crucible_hot_fork_id =
+        crucible_hot_fork_block_backend_next_id++;
+    assert(blk->crucible_hot_fork_id != 0);
+    crucible_hot_fork_block_backend_sync_locked(blk);
+    QTAILQ_INSERT_TAIL(&crucible_hot_fork_block_backends, blk,
+                       crucible_hot_fork_node);
+    crucible_hot_fork_block_backend_generation++;
+}
+
+static void crucible_hot_fork_block_backend_unregister(BlockBackend *blk)
+{
+    QEMU_LOCK_GUARD(&crucible_hot_fork_block_backend_lock);
+
+    QTAILQ_REMOVE(&crucible_hot_fork_block_backends, blk,
+                  crucible_hot_fork_node);
+    crucible_hot_fork_block_backend_generation++;
+}
+
+void qemu_block_backend_hot_fork_inventory(
+    QemuBlockBackendHotForkInventory *inventory)
+{
+    BlockBackend *blk;
+    size_t count = 0;
+
+    *inventory = (QemuBlockBackendHotForkInventory) { 0 };
+    QEMU_LOCK_GUARD(&crucible_hot_fork_block_backend_lock);
+    inventory->generation = crucible_hot_fork_block_backend_generation;
+    QTAILQ_FOREACH(blk, &crucible_hot_fork_block_backends,
+                   crucible_hot_fork_node) {
+        if (count == QEMU_BLOCK_BACKEND_HOT_FORK_INVENTORY_MAX) {
+            inventory->overflowed = true;
+            break;
+        }
+        count++;
+    }
+
+    inventory->entries =
+        g_new0(QemuBlockBackendHotForkInventoryEntry, count);
+    inventory->entry_count = count;
+    count = 0;
+    QTAILQ_FOREACH(blk, &crucible_hot_fork_block_backends,
+                   crucible_hot_fork_node) {
+        QemuBlockBackendHotForkInventoryEntry *entry;
+
+        if (count == inventory->entry_count) {
+            break;
+        }
+        entry = &inventory->entries[count++];
+        entry->backend_id = blk->crucible_hot_fork_id;
+        entry->context_id = blk->crucible_hot_fork_context_id;
+        entry->reference_count = blk->crucible_hot_fork_reference_count;
+        entry->permissions = blk->crucible_hot_fork_permissions;
+        entry->shared_permissions =
+            blk->crucible_hot_fork_shared_permissions;
+        entry->quiesce_depth = qatomic_read(&blk->quiesce_counter);
+        entry->in_flight = qatomic_read(&blk->in_flight);
+        entry->named = blk->crucible_hot_fork_named;
+        entry->name_valid = blk->crucible_hot_fork_name_valid;
+        entry->root_present = blk->crucible_hot_fork_root_present;
+        entry->device_attached = blk->crucible_hot_fork_device_attached;
+        entry->permissions_disabled =
+            blk->crucible_hot_fork_permissions_disabled;
+        entry->request_queuing_disabled =
+            qatomic_read(&blk->disable_request_queuing);
+        g_strlcpy(entry->name, blk->crucible_hot_fork_name,
+                  sizeof(entry->name));
+    }
+}
+
+void qemu_block_backend_hot_fork_inventory_destroy(
+    QemuBlockBackendHotForkInventory *inventory)
+{
+    g_free(inventory->entries);
+    *inventory = (QemuBlockBackendHotForkInventory) { 0 };
+}
