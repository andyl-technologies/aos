diff --git a/include/system/block-backend-global-state.h b/include/system/block-backend-global-state.h
index 35b5e8380..f3a987f27 100644
--- a/include/system/block-backend-global-state.h
+++ b/include/system/block-backend-global-state.h
@@ -15,6 +15,42 @@
 
 #include "block-backend-common.h"
 
+#define QEMU_BLOCK_BACKEND_HOT_FORK_INVENTORY_MAX 65536
+#define QEMU_BLOCK_BACKEND_HOT_FORK_NAME_MAX 255
+
+typedef struct QemuBlockBackendHotForkInventoryEntry {
+    uint64_t backend_id;
+    uint64_t context_id;
+    uint32_t reference_count;
+    uint64_t permissions;
+    uint64_t shared_permissions;
+    uint32_t quiesce_depth;
+    uint32_t in_flight;
+    bool named;
+    bool name_valid;
+    bool root_present;
+    bool device_attached;
+    bool permissions_disabled;
+    bool request_queuing_disabled;
+    char name[QEMU_BLOCK_BACKEND_HOT_FORK_NAME_MAX + 1];
+} QemuBlockBackendHotForkInventoryEntry;
+
+typedef struct QemuBlockBackendHotForkInventory {
+    uint64_t generation;
+    bool overflowed;
+    size_t entry_count;
+    QemuBlockBackendHotForkInventoryEntry *entries;
+} QemuBlockBackendHotForkInventory;
+
+/*
+ * Capture every allocated BlockBackend for hot-fork auditing.  This is an
+ * observational snapshot, not a block-graph drain or retained fork barrier.
+ */
+void qemu_block_backend_hot_fork_inventory(
+    QemuBlockBackendHotForkInventory *inventory);
+void qemu_block_backend_hot_fork_inventory_destroy(
+    QemuBlockBackendHotForkInventory *inventory);
+
 /*
  * Global state (GS) API. These functions run under the BQL.
  *
diff --git a/monitor/qmp-cmds.c b/monitor/qmp-cmds.c
index 9ebdfed65..efd498d2d 100644
--- a/monitor/qmp-cmds.c
+++ b/monitor/qmp-cmds.c
@@ -371,6 +371,70 @@ qmp_query_crucible_hot_fork_aio_handler_inventory(Error **errp)
 #endif
 }
 
+CrucibleHotForkBlockBackendInventory *
+qmp_query_crucible_hot_fork_block_backend_inventory(Error **errp)
+{
+    CrucibleHotForkBlockBackendInventory *report =
+        g_new0(CrucibleHotForkBlockBackendInventory, 1);
+    QemuBlockBackendHotForkInventory inventory;
+    CrucibleHotForkBlockBackendList **tail = &report->backends;
+    uint64_t previous_backend_id = 0;
+    bool valid_entries = true;
+    size_t index;
+
+    (void)errp;
+    report->schema_version = 1;
+    qemu_block_backend_hot_fork_inventory(&inventory);
+    report->generation = inventory.generation;
+    for (index = 0; index < inventory.entry_count; index++) {
+        QemuBlockBackendHotForkInventoryEntry *source =
+            &inventory.entries[index];
+        CrucibleHotForkBlockBackend *backend =
+            g_new0(CrucibleHotForkBlockBackend, 1);
+        CrucibleHotForkBlockBackendList *node =
+            g_new0(CrucibleHotForkBlockBackendList, 1);
+
+        backend->backend_id = source->backend_id;
+        backend->context_id = source->context_id;
+        backend->reference_count = source->reference_count;
+        backend->name = g_strdup(source->name);
+        backend->named = source->named;
+        backend->name_valid = source->name_valid;
+        backend->root_present = source->root_present;
+        backend->device_attached = source->device_attached;
+        backend->permissions = source->permissions;
+        backend->shared_permissions = source->shared_permissions;
+        backend->write_permission =
+            (source->permissions & BLK_PERM_WRITE) != 0;
+        backend->permissions_disabled = source->permissions_disabled;
+        backend->quiesce_depth = source->quiesce_depth;
+        backend->in_flight = source->in_flight;
+        backend->request_queuing_disabled =
+            source->request_queuing_disabled;
+        if (source->backend_id == 0 || source->context_id == 0 ||
+            source->reference_count == 0 || !source->name_valid ||
+            source->named != (source->name[0] != '\0') ||
+            (index != 0 && source->backend_id <= previous_backend_id)) {
+            valid_entries = false;
+        }
+        previous_backend_id = source->backend_id;
+        report->named_backends += source->named;
+        report->rooted_backends += source->root_present;
+        report->device_backends += source->device_attached;
+        report->writable_backends += backend->write_permission;
+        report->quiesced_backends += source->quiesce_depth != 0;
+        report->in_flight += source->in_flight;
+        node->value = backend;
+        *tail = node;
+        tail = &node->next;
+    }
+    report->backend_count = inventory.entry_count;
+    report->overflowed = inventory.overflowed;
+    report->complete = !inventory.overflowed && valid_entries;
+    qemu_block_backend_hot_fork_inventory_destroy(&inventory);
+    return report;
+}
