+int qemu_plugin_crucible_fault_system_manifest(
+    struct qemu_plugin_crucible_fault_system_manifest *out)
+{
+    g_autoptr(GByteArray) sections = NULL;
+
+    if (!out || crucible_fault_vmstate_registry_validate() != 0 ||
+        strcmp(QEMU_CRUCIBLE_BUILD_ID, "unconfigured") == 0 ||
+        strcmp(QEMU_CRUCIBLE_PATCH_SERIES_HASH, "unconfigured") == 0 ||
+        strcmp(QEMU_CRUCIBLE_SHMEM_HEADER_HASH, "unconfigured") == 0) {
+        return -EINVAL;
+    }
+    sections = g_byte_array_new();
+    for (size_t i = 0; i < crucible_fault_vmstate_sections->len; i++) {
+        const QemuCrucibleFaultVmstateSection *section =
+            g_ptr_array_index(crucible_fault_vmstate_sections, i);
+        uint8_t version[4];
+
+        g_byte_array_append(sections, (const uint8_t *)section->name,
+                            strlen(section->name) + 1);
+        stl_be_p(version, section->version);
+        g_byte_array_append(sections, version, sizeof(version));
+    }
+    *out = (struct qemu_plugin_crucible_fault_system_manifest) {
+        .semantic_version = 1,
+        .vmstate_format_version = CRUCIBLE_FAULT_VMSTATE_VERSION,
+        .vmstate_section_count = crucible_fault_vmstate_sections->len,
+        .system_capability = "qemu.fault-system.complete.v1",
+        .vmstate_capability = "qemu.fault-vmstate.v1",
+        .qemu_build_id = QEMU_CRUCIBLE_BUILD_ID,
+        .qemu_patch_series_hash = QEMU_CRUCIBLE_PATCH_SERIES_HASH,
+        .shmem_header_hash = QEMU_CRUCIBLE_SHMEM_HEADER_HASH,
+    };
+    crucible_fault_vmstate_sha256(
+        sections->data, sections->len, out->vmstate_sections_sha256);
+    return 0;
+}
