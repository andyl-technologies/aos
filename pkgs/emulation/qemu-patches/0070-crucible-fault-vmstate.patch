+/** Immutable identity for the complete realized Crucible fault system. */
+struct qemu_plugin_crucible_fault_system_manifest {
+    uint32_t semantic_version;
+    uint32_t vmstate_format_version;
+    uint32_t vmstate_section_count;
+    uint32_t reserved;
+    uint8_t vmstate_sections_sha256[32];
+    const char *system_capability;
+    const char *vmstate_capability;
+    const char *qemu_build_id;
+    const char *qemu_patch_series_hash;
+    const char *shmem_header_hash;
+};
+
+/**
+ * qemu_plugin_crucible_fault_system_manifest() - query final fault identity
+ * @out: complete destination row
+ *
+ * Returns zero only after the realized VMState registry is exact and complete.
+ * A negative errno means the process must not pass Crucible launch admission.
+ */
+QEMU_PLUGIN_API
+int qemu_plugin_crucible_fault_system_manifest(
+    struct qemu_plugin_crucible_fault_system_manifest *out);
+
