+int qemu_crucible_hot_fork_prepare_qmp_child_reinitializer(
+    QemuCrucibleHotForkQmpChildReinitializer *reinitializer,
+    const QemuCrucibleHotForkQmpChildResourcePlan *resources,
+    uint64_t template_generation, uint64_t qmp_generation)
+{
+    if (!reinitializer || !resources || !resources->prepared ||
+        resources->retained_fd < 0 || resources->socket_cookie == 0 ||
+        template_generation == 0 || qmp_generation == 0) {
+        return -EINVAL;
+    }
+
+    *reinitializer = (QemuCrucibleHotForkQmpChildReinitializer) {
+        .retained_fd = resources->retained_fd,
+        .socket_cookie = resources->socket_cookie,
+        .template_generation = template_generation,
+        .qmp_generation = qmp_generation,
+        .prepared = true,
+    };
+    return 0;
+}
+
+bool qemu_crucible_hot_fork_qmp_child_reinitializer_prepared_for(
+    const QemuCrucibleHotForkQmpChildReinitializer *reinitializer,
+    const QemuCrucibleHotForkQmpChildResourcePlan *resources,
+    uint64_t template_generation, uint64_t qmp_generation)
+{
+    QemuCrucibleHotForkQmpChildReinitializer expected = { 0 };
+
+    return reinitializer && reinitializer->prepared &&
+        !reinitializer->attempted && !reinitializer->initialized &&
+        qemu_crucible_hot_fork_prepare_qmp_child_reinitializer(
+            &expected, resources, template_generation, qmp_generation) == 0 &&
+        reinitializer->retained_fd == expected.retained_fd &&
+        reinitializer->socket_cookie == expected.socket_cookie &&
+        reinitializer->template_generation == expected.template_generation &&
+        reinitializer->qmp_generation == expected.qmp_generation;
+}
+
+static bool crucible_hot_fork_qmp_child_status_matches(
+    const QemuCrucibleHotForkQmpChildReinitializer *reinitializer)
+{
+    const QemuCrucibleHotForkQmpChildStatus *status = &reinitializer->status;
+
+    return status->schema_version ==
+            QEMU_CRUCIBLE_HOT_FORK_QMP_CHILD_REINITIALIZER_VERSION &&
+        status->struct_size == sizeof(*status) &&
+        status->template_generation == reinitializer->template_generation &&
+        status->qmp_generation == reinitializer->qmp_generation &&
+        status->socket_cookie == reinitializer->socket_cookie &&
+        status->retained_fd == reinitializer->retained_fd &&
+        status->flags == QEMU_CRUCIBLE_HOT_FORK_QMP_CHILD_FLAGS_COMPLETE &&
+        status->reserved == 0 && status->monitor_count == 1 &&
+        status->queued_request_count == 0 &&
+        status->parser_buffered_bytes == 0;
+}
+
+int qemu_crucible_hot_fork_reinitialize_qmp_child(
+    QemuCrucibleHotForkQmpChildReinitializer *reinitializer,
+    QemuCrucibleHotForkQmpChildRuntime runtime, void *opaque)
+{
+    int result;
+
+    if (!reinitializer || !reinitializer->prepared ||
+        reinitializer->attempted) {
+        return -EPERM;
+    }
+    if (!runtime) {
+        return -EINVAL;
+    }
+
+    reinitializer->attempted = true;
+    result = runtime(reinitializer->retained_fd,
+                     reinitializer->socket_cookie,
+                     reinitializer->template_generation,
+                     reinitializer->qmp_generation,
+                     &reinitializer->status, opaque);
+    if (result != 0) {
+        return result;
+    }
+    if (!crucible_hot_fork_qmp_child_status_matches(reinitializer)) {
+        return -EPROTO;
+    }
+
+    reinitializer->initialized = true;
+    return 0;
+}
+
+void qemu_crucible_hot_fork_reset_qmp_child_reinitializer(
+    QemuCrucibleHotForkQmpChildReinitializer *reinitializer)
+{
+    if (reinitializer) {
+        *reinitializer = (QemuCrucibleHotForkQmpChildReinitializer) { 0 };
+    }
+}
