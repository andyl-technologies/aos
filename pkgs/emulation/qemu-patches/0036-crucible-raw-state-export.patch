+        struct qemu_plugin_crucible_ram_region *current =
+            &g_array_index(collected,
+                           struct qemu_plugin_crucible_ram_region,
+                           index);
+
+        if (current->guest_physical_base == region->guest_physical_base) {
+            candidate = current;
+            break;
+        }
+    }
+    if (!candidate || !crucible_ram_region_equal(candidate, region)) {
+        return -ESTALE;
+    }
+    if (length != 0) {
+        hwaddr physical = region->guest_physical_base + offset;
+        MemTxResult result = address_space_read(&address_space_memory,
+                                                physical,
+                                                MEMTXATTRS_UNSPECIFIED,
+                                                bytes, length);
+
+        if (result != MEMTX_OK) {
+            memset(bytes, 0, length);
+            return -EIO;
+        }
+    }
+    return 0;
+}
+
+int qemu_plugin_crucible_vmstate_snapshot_begin(
+    struct qemu_plugin_crucible_vmstate_snapshot **snapshot_out)
+{
+    struct qemu_plugin_crucible_vmstate_snapshot *snapshot;
+    QIOChannelBuffer *buffer;
+    QEMUFile *file;
+    int status;
+    int close_status;
+
+    if (!snapshot_out) {
+        return -EINVAL;
+    }
+    *snapshot_out = NULL;
+    status = crucible_require_paused_bql();
+    if (status != 0) {
+        return status;
+    }
+    if (crucible_terminal_vmstate_export_latched) {
+        return -EALREADY;
+    }
+    status = migration_crucible_raw_state_export_admit();
+    if (status != 0) {
+        return status;
+    }
+
+    /* pre_save callbacks below may mutate bookkeeping: resume is forbidden. */
+    crucible_terminal_vmstate_export_latched = true;
+    buffer = qio_channel_buffer_new(4096);
+    file = qemu_file_new_output(QIO_CHANNEL(buffer));
+    status = qemu_save_device_state(file);
+    if (status == 0) {
+        status = qemu_fflush(file);
+    }
+    if (status == 0) {
+        status = qemu_file_get_error(file);
+    }
+    if (status == 0 && buffer->usage == 0) {
+        status = -EIO;
+    }
+    snapshot = NULL;
+    if (status == 0) {
+        snapshot = g_new0(struct qemu_plugin_crucible_vmstate_snapshot, 1);
+        snapshot->data = g_memdup2(buffer->data, buffer->usage);
+        snapshot->size = buffer->usage;
+    }
+    close_status = qemu_fclose(file);
+    object_unref(OBJECT(buffer));
+    if (status == 0 && close_status != 0) {
+        status = close_status;
+    }
+    if (status != 0) {
+        if (snapshot) {
+            g_free(snapshot->data);
+            g_free(snapshot);
+        }
+        return status;
+    }
+    *snapshot_out = snapshot;
+    return 0;
+}
+
+int qemu_plugin_crucible_vmstate_snapshot_size(
+    const struct qemu_plugin_crucible_vmstate_snapshot *snapshot,
+    uint64_t *size_out)
+{
+    if (!snapshot || !size_out) {
+        return -EINVAL;
+    }
+    *size_out = snapshot->size;
+    return 0;
+}
+
+int qemu_plugin_crucible_vmstate_snapshot_copy(
+    const struct qemu_plugin_crucible_vmstate_snapshot *snapshot,
+    uint64_t offset,
+    void *bytes,
+    uint64_t length)
+{
+    uint64_t size;
+
+    if (!snapshot || (!bytes && length != 0)) {
+        return -EINVAL;
+    }
+    size = snapshot->size;
+    if (offset > size || length > size - offset || length > SIZE_MAX) {
+        return -ERANGE;
+    }
+    if (length != 0) {
+        memcpy(bytes, snapshot->data + offset, length);
+    }
+    return 0;
+}
+
+void qemu_plugin_crucible_vmstate_snapshot_free(
+    struct qemu_plugin_crucible_vmstate_snapshot *snapshot)
+{
+    if (snapshot) {
+        g_free(snapshot->data);
+        g_free(snapshot);
+    }
+}
