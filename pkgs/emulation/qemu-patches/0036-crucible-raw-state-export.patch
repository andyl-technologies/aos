+struct CrucibleTerminalPauseRequest {
+    qemu_plugin_crucible_terminal_paused_cb_t callback;
+    void *userdata;
+};
+
+static bool crucible_terminal_vmstate_export_latched;
+static struct CrucibleTerminalPauseRequest *crucible_terminal_pause_pending;
+
+bool qemu_crucible_terminal_vmstate_exported(void)
+{
+    return crucible_terminal_vmstate_export_latched;
+}
+
+static int crucible_require_paused_bql(void)
+{
+    if (!bql_locked()) {
+        return -EPERM;
+    }
+    if (!runstate_check(RUN_STATE_PAUSED)) {
+        return -EBUSY;
+    }
+    return 0;
+}
+
+static void crucible_terminal_pause_bh(void *opaque)
+{
+    struct CrucibleTerminalPauseRequest *request = opaque;
+    int status = 0;
+
+    if (!bql_locked()) {
+        status = -EPERM;
+    } else if (runstate_is_running()) {
+        status = vm_stop(RUN_STATE_PAUSED);
+        if (status == 0) {
+            aio_bh_schedule_oneshot(qemu_get_aio_context(),
+                                    crucible_terminal_pause_bh, request);
+            return;
+        }
+    } else if (!runstate_check(RUN_STATE_PAUSED)) {
+        status = -ECANCELED;
+    }
+    qatomic_set(&crucible_terminal_pause_pending, NULL);
+    request->callback(status, request->userdata);
+    g_free(request);
+}
+
+int qemu_plugin_crucible_request_terminal_pause(
+    qemu_plugin_crucible_terminal_paused_cb_t callback,
+    void *userdata)
+{
+    struct CrucibleTerminalPauseRequest *request;
+    struct CrucibleTerminalPauseRequest *prior;
+
+    if (!callback) {
+        return -EINVAL;
+    }
+    if (qatomic_read(&crucible_terminal_vmstate_export_latched)) {
+        return -EALREADY;
+    }
+    request = g_new0(struct CrucibleTerminalPauseRequest, 1);
+    request->callback = callback;
+    request->userdata = userdata;
+    prior = qatomic_cmpxchg(&crucible_terminal_pause_pending, NULL, request);
+    if (prior != NULL) {
+        g_free(request);
+        return -EALREADY;
+    }
+    aio_bh_schedule_oneshot(qemu_get_aio_context(),
+                            crucible_terminal_pause_bh, request);
+    return 0;
+}
+
+static bool crucible_collect_ram_region(const MemoryRegionSection *section,
+                                        void *opaque)
+{
+    struct CrucibleRamRegions *state = opaque;
+    struct qemu_plugin_crucible_ram_region region = { 0 };
+    MemoryRegion *mr = section->mr;
+    const char *name;
+    size_t name_length;
+
+    if (!memory_region_is_ram(mr)) {
+        return false;
+    }
+    if (memory_region_is_protected(mr)) {
+        state->status = -ENOTSUP;
+        return true;
+    }
+    if (section->readonly || memory_region_is_rom(mr) ||
+        memory_region_is_ram_device(mr)) {
+        return false;
+    }
+    if (int128_gethi(section->size) != 0) {
+        state->status = -EOVERFLOW;
+        return true;
+    }
+    region.guest_physical_base = section->offset_within_address_space;
+    region.length = int128_getlo(section->size);
+    region.memory_region_offset = section->offset_within_region;
+    if (region.length == 0 ||
+        UINT64_MAX - region.guest_physical_base < region.length - 1) {
+        state->status = -EOVERFLOW;
+        return true;
+    }
+    name = memory_region_name(mr);
+    if (!name) {
+        state->status = -ENODATA;
+        return true;
+    }
+    name_length = strlen(name);
+    if (name_length >= sizeof(region.memory_region_name)) {
+        state->status = -ENAMETOOLONG;
+        return true;
+    }
+    memcpy(region.memory_region_name, name, name_length + 1);
+    g_array_append_val(state->regions, region);
+    return false;
+}
+
+static int crucible_ram_regions_collect(GArray **regions_out)
+{
+    FlatView *view;
+    struct CrucibleRamRegions state;
+    int status;
+
+    if (!regions_out) {
+        return -EINVAL;
+    }
+    *regions_out = NULL;
+    status = crucible_require_paused_bql();
+    if (status != 0) {
+        return status;
+    }
+    if (crucible_terminal_vmstate_export_latched) {
+        return -ESHUTDOWN;
+    }
+    status = migration_crucible_raw_state_export_admit();
+    if (status != 0) {
+        return status;
+    }
+    state.regions = g_array_new(false, false,
+                                sizeof(struct qemu_plugin_crucible_ram_region));
+    state.status = 0;
+    view = address_space_to_flatview(&address_space_memory);
+    flatview_for_each_section(view, crucible_collect_ram_region, &state);
+    if (state.status != 0) {
+        g_array_free(state.regions, true);
+        return state.status;
+    }
+    *regions_out = state.regions;
+    return 0;
+}
+
+int qemu_plugin_crucible_guest_ram_regions(
+    struct qemu_plugin_crucible_ram_region *regions,
+    uint64_t capacity,
+    uint64_t *count_out)
+{
+    g_autoptr(GArray) collected = NULL;
+    int status;
+
+    if (!count_out || (!regions && capacity != 0)) {
+        return -EINVAL;
+    }
+    *count_out = 0;
+    status = crucible_ram_regions_collect(&collected);
+    if (status != 0) {
+        return status;
+    }
+    *count_out = collected->len;
+    if (capacity < collected->len) {
+        return -ENOSPC;
+    }
+    if (collected->len != 0) {
+        memcpy(regions, collected->data,
+               collected->len * sizeof(*regions));
+    }
+    return 0;
+}
