+static bool crucible_ram_region_equal(
+    const struct qemu_plugin_crucible_ram_region *left,
+    const struct qemu_plugin_crucible_ram_region *right)
+{
+    return left->guest_physical_base == right->guest_physical_base &&
+           left->length == right->length &&
+           left->memory_region_offset == right->memory_region_offset &&
+           memcmp(left->memory_region_name, right->memory_region_name,
+                  sizeof(left->memory_region_name)) == 0;
+}
