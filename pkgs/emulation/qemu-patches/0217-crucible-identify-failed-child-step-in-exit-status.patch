+/*
+ * Exit status base of a child that failed reconstruction.  The status is
+ * this base plus the failed step, numbered in the order the steps run in
+ * crucible_hot_fork_finish_child_operation: 1 process contract, 2 descriptor
+ * table, 3 runtime reconstruction, 4 resource plan, 5 diagnostics resources,
+ * 6 QMP resources, 7 console resources, 8 resource plan completion, 9 runtime
+ * resource plan, 10 plugin activation, 11 vCPU restart, 12 block barrier
+ * release, 13 child file installation, 14 empty native release, 15 monitor
+ * input release.  Guarded launch gives the child no stderr; the source
+ * reports the status through crucible-hot-fork-child-process after reap.
+ */
+#define CRUCIBLE_HOT_FORK_CHILD_STEP_EXIT_BASE 64
+
+static void G_NORETURN crucible_hot_fork_child_exit_at(unsigned int step)
+{
+    _exit(CRUCIBLE_HOT_FORK_CHILD_STEP_EXIT_BASE + step);
+}
