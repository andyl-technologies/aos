+int qemu_chr_socket_hot_fork_rehome_child_context(
+    QemuChrSocketHotForkChildBasis *basis, GMainContext *inherited,
+    GMainContext *replacement)
+{
+    Chardev *chr;
+    int result = 0;
+
+    if (!basis || !basis->prepared || !basis->chardev || !replacement ||
+        !object_dynamic_cast(OBJECT(basis->chardev), TYPE_CHARDEV_SOCKET)) {
+        return -EINVAL;
+    }
+    if (basis->source_pid == getpid() || !basis->input_held) {
+        return -EPERM;
+    }
+
+    chr = basis->chardev;
+    qemu_mutex_lock(&chr->chr_write_lock);
+    if (!tcp_chr_hot_fork_child_is_held_locked(basis, inherited)) {
+        result = -ESTALE;
+        goto out;
+    }
+    /*
+     * The hold proves that no read or HUP source is attached, so the move
+     * is two pointer updates; the sources that release attaches follow the
+     * chardev's context.
+     */
+    chr->gcontext = replacement;
+    basis->context = replacement;
+out:
+    qemu_mutex_unlock(&chr->chr_write_lock);
+    return result;
+}
