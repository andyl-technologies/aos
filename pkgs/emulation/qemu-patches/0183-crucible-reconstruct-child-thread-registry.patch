+int qemu_thread_hot_fork_begin_registry_transaction(
+    QemuThreadHotForkRegistryTransaction *transaction)
+{
+    QemuHotForkThreadRecord *coordinator;
+    GList *node;
+    size_t coordinator_count = 0;
+    int64_t thread_id = qemu_get_thread_id();
+    int err;
+
+    if (!transaction || transaction->active ||
+        transaction->coordinator_record || getpid() <= 1 || thread_id <= 0) {
+        return -EINVAL;
+    }
+    coordinator = qemu_hot_fork_register_coordinator();
+    if (!coordinator) {
+        return -EPERM;
+    }
+
+    crucible_hot_fork_mutex_registry_lock();
+    err = pthread_mutex_lock(&qemu_hot_fork_thread_lock);
+    if (err) {
+        error_exit(err, __func__);
+    }
+    for (node = qemu_hot_fork_threads; node; node = node->next) {
+        QemuHotForkThreadRecord *record = node->data;
+
+        if (record->disposition == QEMU_THREAD_HOT_FORK_COORDINATOR) {
+            coordinator_count++;
+        }
+    }
+    if (qemu_hot_fork_thread_overflow != 0 ||
+        qemu_hot_fork_thread_starts_in_flight != 0 ||
+        qemu_hot_fork_thread_count == 0 ||
+        coordinator_count != 1 ||
+        qemu_hot_fork_coordinator_thread_id != thread_id ||
+        qemu_hot_fork_current_thread != coordinator ||
+        coordinator->thread_id != thread_id || !coordinator->tracked ||
+        coordinator->disposition != QEMU_THREAD_HOT_FORK_COORDINATOR ||
+        !qemu_hot_fork_registered_mutexes_quiescent() ||
+        qemu_hot_fork_thread_generation == UINT64_MAX) {
+        err = pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+        if (err) {
+            error_exit(err, __func__);
+        }
+        crucible_hot_fork_mutex_registry_unlock();
+        return -EBUSY;
+    }
+
+    *transaction = (QemuThreadHotForkRegistryTransaction) {
+        .thread_generation = qemu_hot_fork_thread_generation,
+        .parent_process_id = getpid(),
+        .parent_thread_id = thread_id,
+        .coordinator_record = coordinator,
+        .active = true,
+    };
+    return 0;
+}
