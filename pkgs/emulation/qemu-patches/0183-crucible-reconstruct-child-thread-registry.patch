+static void test_registry_transaction_rejects_locked_mutex(void)
+{
+    QemuThreadHotForkRegistryTransaction transaction = { 0 };
+    QemuMutex mutex;
+
+    qemu_mutex_init(&mutex);
+    qemu_mutex_lock(&mutex);
+    g_assert_cmpint(qemu_thread_hot_fork_begin_registry_transaction(
+                        &transaction),
+                    ==, -EBUSY);
+    g_assert_false(transaction.active);
+    qemu_mutex_unlock(&mutex);
+
+    g_assert_cmpint(qemu_thread_hot_fork_begin_registry_transaction(
+                        &transaction),
+                    ==, 0);
+    g_assert_true(transaction.active);
+    g_assert_cmpint(qemu_thread_hot_fork_release_parent_registry_transaction(
+                        &transaction),
+                    ==, 0);
+    qemu_mutex_destroy(&mutex);
+}
