+static bool qemu_hot_fork_registered_mutexes_quiescent(void)
+{
+    QemuMutex *mutex;
+    size_t count = 0;
+
+    for (mutex = crucible_hot_fork_mutexes; mutex;
+         mutex = mutex->crucible_hot_fork_next) {
+        if (count++ == QEMU_HOT_FORK_MUTEX_INVENTORY_MAX ||
+            !mutex->initialized ||
+            !qatomic_read(&mutex->crucible_hot_fork_ownership_valid) ||
+            qatomic_read(&mutex->crucible_hot_fork_owner_thread_id) != 0 ||
+            qatomic_read(&mutex->crucible_hot_fork_recursion_depth) != 0 ||
+            qatomic_read(&mutex->crucible_hot_fork_acquisition_waiters) != 0 ||
+            qatomic_read(&mutex->crucible_hot_fork_condition_waiters) != 0 ||
+            qatomic_read(&mutex->crucible_hot_fork_unlock_active)) {
+            return false;
+        }
+    }
+    return true;
+}
