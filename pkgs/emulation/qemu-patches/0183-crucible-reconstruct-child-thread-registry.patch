+typedef struct RegistryWorker {
+    int ready_fd;
+    int release_fd;
+} RegistryWorker;
+
+static void *registry_worker(void *opaque)
+{
+    RegistryWorker *worker = opaque;
+
+    write_child_result(worker->ready_fd, 0);
+    (void)read_child_result(worker->release_fd);
+    return NULL;
+}
