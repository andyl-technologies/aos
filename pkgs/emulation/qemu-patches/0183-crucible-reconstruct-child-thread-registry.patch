+int qemu_thread_hot_fork_release_parent_registry_transaction(
+    QemuThreadHotForkRegistryTransaction *transaction)
+{
+    int err;
+
+    if (!transaction || !transaction->active ||
+        transaction->child_reconstructed ||
+        transaction->parent_process_id != getpid() ||
+        transaction->parent_thread_id != qemu_get_thread_id() ||
+        transaction->coordinator_record != qemu_hot_fork_current_thread ||
+        transaction->thread_generation != qemu_hot_fork_thread_generation) {
+        return -EPERM;
+    }
+
+    transaction->active = false;
+    err = pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+    if (err) {
+        error_exit(err, __func__);
+    }
+    crucible_hot_fork_mutex_registry_unlock();
+    return 0;
+}
