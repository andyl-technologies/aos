+/*
+ * Freeze the registered QEMU thread and mutex state across one fork.
+ *
+ * The caller must be the sole registered coordinator.  All registered
+ * QemuMutex instances must be unlocked, stable, and free of waiters.  Success
+ * intentionally retains both registry locks; the caller must next fork and
+ * invoke exactly one of the parent-release or child-reconstruction operations
+ * in each resulting process.
+ */
+int qemu_thread_hot_fork_begin_registry_transaction(
+    QemuThreadHotForkRegistryTransaction *transaction);
+
+/*
+ * Release the unchanged parent copy of a registry transaction.
+ */
+int qemu_thread_hot_fork_release_parent_registry_transaction(
+    QemuThreadHotForkRegistryTransaction *transaction);
+
+/*
+ * Rebuild the immediate child's registry around the surviving coordinator.
+ *
+ * Failure leaves the inherited registry locks held and requires the fork child
+ * to terminate without entering QEMU or creating a thread.
+ */
+int qemu_thread_hot_fork_reconstruct_child_registry(
+    QemuThreadHotForkRegistryTransaction *transaction);
