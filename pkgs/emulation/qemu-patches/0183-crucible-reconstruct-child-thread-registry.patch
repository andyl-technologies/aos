+int qemu_thread_hot_fork_reconstruct_child_registry(
+    QemuThreadHotForkRegistryTransaction *transaction)
+{
+    QemuHotForkThreadRecord *coordinator;
+    GList *coordinator_node = NULL;
+    GList *node;
+    int64_t child_thread_id = qemu_get_thread_id();
+    int err;
+
+    if (!transaction || !transaction->active ||
+        transaction->child_reconstructed ||
+        transaction->parent_process_id <= 1 ||
+        transaction->parent_process_id == getpid() ||
+        transaction->parent_process_id != getppid() ||
+        transaction->parent_thread_id <= 0 || child_thread_id <= 0 ||
+        transaction->thread_generation != qemu_hot_fork_thread_generation) {
+        return -EPERM;
+    }
+    coordinator = transaction->coordinator_record;
+    for (node = qemu_hot_fork_threads; node; node = node->next) {
+        if (node->data == coordinator) {
+            if (coordinator_node) {
+                return -EPROTO;
+            }
+            coordinator_node = node;
+        }
+    }
+    if (!coordinator_node || !coordinator->tracked ||
+        coordinator->thread_id != transaction->parent_thread_id ||
+        coordinator->disposition != QEMU_THREAD_HOT_FORK_COORDINATOR ||
+        !qemu_hot_fork_registered_mutexes_quiescent()) {
+        return -EPROTO;
+    }
+
+    coordinator_node->prev = NULL;
+    coordinator_node->next = NULL;
+    coordinator->thread_id = child_thread_id;
+    qemu_hot_fork_threads = coordinator_node;
+    qemu_hot_fork_thread_count = 1;
+    qemu_hot_fork_thread_overflow = 0;
+    qemu_hot_fork_thread_starts_in_flight = 0;
+    qemu_hot_fork_coordinator_thread_id = child_thread_id;
+    qemu_hot_fork_current_thread = coordinator;
+    qemu_hot_fork_thread_generation++;
+    transaction->active = false;
+    transaction->child_reconstructed = true;
+
+    err = pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+    if (err) {
+        error_exit(err, __func__);
+    }
+    crucible_hot_fork_mutex_registry_unlock();
+    return 0;
 }
 
