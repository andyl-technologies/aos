+/*
+ * Linear owner of the QEMU thread/mutex registry locks across one fork.
+ *
+ * The coordinator begins this transaction immediately before fork().  The
+ * parent releases its copy, while the immediate child consumes its inherited
+ * copy to discard vanished thread records and bind the surviving coordinator
+ * to the child's process-local thread ID.  The private record pointer is
+ * authenticated against the locked registry before either terminal action.
+ */
+typedef struct QemuThreadHotForkRegistryTransaction {
+    uint64_t thread_generation;
+    int64_t parent_process_id;
+    int64_t parent_thread_id;
+    void *coordinator_record;
+    bool active;
+    bool child_reconstructed;
+} QemuThreadHotForkRegistryTransaction;
+
