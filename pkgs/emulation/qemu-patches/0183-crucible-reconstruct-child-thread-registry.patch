+static void test_child_registry_rebuild_preserves_parent(void)
+{
+    QemuThreadHotForkRegistryTransaction transaction = { 0 };
+    QemuThreadHotForkInventory initial;
+    QemuThreadHotForkInventory before;
+    QemuThreadHotForkInventory after;
+    RegistryWorker worker;
+    QemuThread thread;
+    int ready[2];
+    int release[2];
+    int child_result[2];
+    size_t initial_entry_count;
+    int result = -EBUSY;
+    pid_t child;
+
+    qemu_thread_hot_fork_inventory(&initial);
+    g_assert_cmpuint(initial.overflow_count, ==, 0);
+    initial_entry_count = initial.entry_count;
+    qemu_thread_hot_fork_inventory_destroy(&initial);
+
+    g_assert_cmpint(pipe2(ready, O_CLOEXEC), ==, 0);
+    g_assert_cmpint(pipe2(release, O_CLOEXEC), ==, 0);
+    g_assert_cmpint(pipe2(child_result, O_CLOEXEC), ==, 0);
+    worker = (RegistryWorker) {
+        .ready_fd = ready[1],
+        .release_fd = release[0],
+    };
+    qemu_thread_create(&thread, "fork-registry-test", registry_worker, &worker,
+                       QEMU_THREAD_JOINABLE);
+    g_assert_cmpint(read_child_result(ready[0]), ==, 0);
+
+    qemu_thread_hot_fork_inventory(&before);
+    g_assert_cmpuint(before.entry_count, ==, initial_entry_count + 1);
+    g_assert_cmpuint(before.overflow_count, ==, 0);
+    for (unsigned int attempt = 0; attempt < 1000; attempt++) {
+        result =
+            qemu_thread_hot_fork_begin_registry_transaction(&transaction);
+        if (result != -EBUSY) {
+            break;
+        }
+        g_usleep(1000);
+    }
+    g_assert_cmpint(result, ==, 0);
+
+    /*
+     * Production system QEMU has already disabled the generic RCU atfork
+     * callback.  The future fork owner must compose RCU child reconstruction
+     * explicitly with this registry transaction.
+     */
+    rcu_disable_atfork();
+    child = fork();
+    g_assert_cmpint(child, >=, 0);
+    if (child == 0) {
+        QemuThreadHotForkInventory child_inventory;
+        int result =
+            qemu_thread_hot_fork_reconstruct_child_registry(&transaction);
+
+        if (result == 0) {
+            qemu_thread_hot_fork_inventory(&child_inventory);
+            if (child_inventory.entry_count != 1 ||
+                child_inventory.overflow_count != 0 ||
+                child_inventory.entries[0].thread_id !=
+                    qemu_get_thread_id() ||
+                child_inventory.entries[0].disposition !=
+                    QEMU_THREAD_HOT_FORK_COORDINATOR) {
+                result = -EPROTO;
+            }
+            qemu_thread_hot_fork_inventory_destroy(&child_inventory);
+        }
+        write_child_result(child_result[1], result);
+        _exit(0);
+    }
+    rcu_enable_atfork();
+
+    g_assert_cmpint(qemu_thread_hot_fork_release_parent_registry_transaction(
+                        &transaction),
+                    ==, 0);
+    close(child_result[1]);
+    g_assert_cmpint(read_child_result(child_result[0]), ==, 0);
+    wait_for_child(child);
+
+    qemu_thread_hot_fork_inventory(&after);
+    g_assert_cmpuint(after.generation, ==, before.generation);
+    g_assert_cmpuint(after.entry_count, ==, before.entry_count);
+    g_assert_cmpuint(after.overflow_count, ==, before.overflow_count);
+    for (size_t index = 0; index < before.entry_count; index++) {
+        g_assert_cmpint(after.entries[index].thread_id, ==,
+                        before.entries[index].thread_id);
+        g_assert_cmpint(after.entries[index].disposition, ==,
+                        before.entries[index].disposition);
+    }
+
+    write_child_result(release[1], 0);
+    qemu_thread_join(&thread);
+    qemu_thread_hot_fork_inventory_destroy(&after);
+    qemu_thread_hot_fork_inventory_destroy(&before);
+    close(child_result[0]);
+    close(release[0]);
+    close(release[1]);
+    close(ready[0]);
+    close(ready[1]);
+}
