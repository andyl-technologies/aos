+static void qemu_hot_fork_thread_start_begin(void)
+{
+    int err = pthread_mutex_lock(&qemu_hot_fork_thread_lock);
+
+    if (err) {
+        error_exit(err, __func__);
+    }
+    if (qemu_hot_fork_thread_starts_in_flight == SIZE_MAX ||
+        qemu_hot_fork_thread_generation == UINT64_MAX) {
+        error_exit(EOVERFLOW, __func__);
+    }
+    qemu_hot_fork_thread_starts_in_flight++;
+    qemu_hot_fork_thread_generation++;
+    err = pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+    if (err) {
+        error_exit(err, __func__);
+    }
+}
+
+static void qemu_hot_fork_thread_start_end(void)
+{
+    int err = pthread_mutex_lock(&qemu_hot_fork_thread_lock);
+
+    if (err) {
+        error_exit(err, __func__);
+    }
+    assert(qemu_hot_fork_thread_starts_in_flight > 0);
+    if (qemu_hot_fork_thread_generation == UINT64_MAX) {
+        error_exit(EOVERFLOW, __func__);
+    }
+    qemu_hot_fork_thread_starts_in_flight--;
+    qemu_hot_fork_thread_generation++;
+    err = pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+    if (err) {
+        error_exit(err, __func__);
+    }
+}
