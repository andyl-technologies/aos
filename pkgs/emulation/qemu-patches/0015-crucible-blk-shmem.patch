diff --git a/include/qemu/qemu-plugin.h b/include/qemu/qemu-plugin.h
index 138f791..477db80 100644
--- a/include/qemu/qemu-plugin.h
+++ b/include/qemu/qemu-plugin.h
@@ -164,6 +164,44 @@ typedef void (*qemu_plugin_tcg_exec_cb_t)(unsigned int vcpu_index,
                                           uint64_t icount,
                                           void *userdata);
 
+/**
+ * typedef qemu_plugin_blk_submit_cb_t - shmem block submit callback
+ * @request_id: driver-assigned request id
+ * @op: one of QEMU_PLUGIN_BLK_OP_*
+ * @offset: byte offset for read/write requests
+ * @data: write payload, or NULL for read/flush
+ * @len: requested byte count or write payload length
+ * @userdata: a pointer supplied when callbacks were registered
+ *
+ * Returns: 0 when the request was accepted, nonzero on fail-loud rejection.
+ */
+typedef int (*qemu_plugin_blk_submit_cb_t)(uint32_t request_id,
+                                           uint32_t op,
+                                           uint64_t offset,
+                                           const uint8_t *data,
+                                           size_t len,
+                                           void *userdata);
+
+/**
+ * typedef qemu_plugin_blk_poll_cb_t - shmem block completion poll callback
+ * @request_id: request id being polled
+ * @data: read response output buffer, or NULL for zero-payload completions
+ * @capacity: byte capacity of @data
+ * @userdata: a pointer supplied when callbacks were registered
+ *
+ * Returns: nonnegative response payload length on success, -1 on device error,
+ * and QEMU_PLUGIN_BLK_POLL_PENDING when no response is ready yet.
+ */
+typedef int64_t (*qemu_plugin_blk_poll_cb_t)(uint32_t request_id,
+                                             uint8_t *data,
+                                             size_t capacity,
+                                             void *userdata);
+
+#define QEMU_PLUGIN_BLK_OP_READ 0u
+#define QEMU_PLUGIN_BLK_OP_WRITE 1u
+#define QEMU_PLUGIN_BLK_OP_FLUSH 2u
+#define QEMU_PLUGIN_BLK_POLL_PENDING 0
+
 /**
  * qemu_plugin_uninstall() - Uninstall a plugin
  * @id: this plugin's opaque ID
@@ -876,6 +914,20 @@ QEMU_PLUGIN_API
 void qemu_plugin_register_tcg_exec_cb(qemu_plugin_tcg_exec_cb_t cb,
                                        void *userdata);
 
+/**
+ * qemu_plugin_register_blk_cb() - register shmem block callbacks
+ * @submit_cb: request submit callback, or NULL to disable shmem forwarding
+ * @poll_cb: completion poll callback, or NULL to disable shmem forwarding
+ * @userdata: opaque pointer passed to both callbacks
+ *
+ * The crucible-shmem block driver is inert unless both callbacks are
+ * registered and the driver is selected explicitly.
+ */
+QEMU_PLUGIN_API
+void qemu_plugin_register_blk_cb(qemu_plugin_blk_submit_cb_t submit_cb,
+                                 qemu_plugin_blk_poll_cb_t poll_cb,
+                                 void *userdata);
+
 /**
