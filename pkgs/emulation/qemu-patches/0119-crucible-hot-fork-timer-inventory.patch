+static CrucibleHotForkTimerClock
+crucible_hot_fork_timer_clock(QEMUClockType type)
+{
+    switch (type) {
+    case QEMU_CLOCK_REALTIME:
+        return CRUCIBLE_HOT_FORK_TIMER_CLOCK_REALTIME;
+    case QEMU_CLOCK_VIRTUAL:
+        return CRUCIBLE_HOT_FORK_TIMER_CLOCK_VIRTUAL;
+    case QEMU_CLOCK_HOST:
+        return CRUCIBLE_HOT_FORK_TIMER_CLOCK_HOST;
+    case QEMU_CLOCK_VIRTUAL_RT:
+        return CRUCIBLE_HOT_FORK_TIMER_CLOCK_VIRTUAL_REALTIME;
+    default:
+        abort();
+    }
+}
+
+CrucibleHotForkTimerInventory *
+qmp_query_crucible_hot_fork_timer_inventory(Error **errp)
+{
+#ifdef CONFIG_POSIX
+    CrucibleHotForkTimerInventory *report =
+        g_new0(CrucibleHotForkTimerInventory, 1);
+    QemuTimerHotForkInventory inventory;
+    CrucibleHotForkTimerList **tail = &report->timers;
+    uint64_t previous_timer_id = 0;
+    bool valid_entries = true;
+    size_t index;
+
+    (void)errp;
+    report->schema_version = 1;
+    qemu_timer_hot_fork_inventory(&inventory);
+    report->generation = inventory.generation;
+    for (index = 0; index < inventory.entry_count; index++) {
+        QemuTimerHotForkInventoryEntry *source = &inventory.entries[index];
+        CrucibleHotForkTimer *timer = g_new0(CrucibleHotForkTimer, 1);
+        CrucibleHotForkTimerList *node =
+            g_new0(CrucibleHotForkTimerList, 1);
+
+        timer->timer_id = source->timer_id;
+        timer->timer_list_id = source->timer_list_id;
+        timer->clock = crucible_hot_fork_timer_clock(source->clock_type);
+        timer->expire_time_ns = source->expire_time_ns;
+        timer->scale = source->scale;
+        timer->attributes = source->attributes;
+        timer->pending = source->pending;
+        timer->callback_active = source->callback_active;
+        if (source->timer_id == 0 || source->timer_list_id == 0 ||
+            (index != 0 && source->timer_id <= previous_timer_id) ||
+            source->scale == 0 ||
+            (!source->pending && !source->callback_active) ||
+            (source->pending != (source->expire_time_ns >= 0))) {
+            valid_entries = false;
+        }
+        previous_timer_id = source->timer_id;
+        report->pending_timers += source->pending;
+        report->active_callbacks += source->callback_active;
+        node->value = timer;
+        *tail = node;
+        tail = &node->next;
+    }
+    report->timer_count = inventory.entry_count;
+    report->overflowed = inventory.overflowed;
+    report->complete = !inventory.overflowed && valid_entries;
+    qemu_timer_hot_fork_inventory_destroy(&inventory);
+    return report;
+#else
+    error_setg(errp, "Crucible hot-fork timer inventory requires POSIX");
+    return NULL;
+#endif
+}
