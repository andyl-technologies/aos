+##
+# @CrucibleHotForkRcuBarrierAction:
+#
+# Operation over QEMU's process-lifetime reversible RCU admission barrier.
+#
+# @hold: reject every new outer read-side entry and callback submission while
+#     already-admitted work drains
+#
+# @query: observe the barrier without changing it
+#
+# @release: reopen admission and wake parked submitters
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'enum': 'CrucibleHotForkRcuBarrierAction',
+  'data': [ 'hold', 'query', 'release' ] }
+
+##
+# @CrucibleHotForkRcuBarrierState:
+#
+# Exact retained state of QEMU's RCU admission and drain barrier.
+#
+# @schema-version: barrier contract version, currently 1
+#
+# @generation: process-local hold/release generation
+#
+# @owner-thread-id: coordinator thread that acquired the barrier, or zero when
+#     the barrier is released
+#
+# @held: whether new outer readers and callback submitters are parked
+#
+# @complete: whether the complete bounded reader registry was observed
+#
+# @registered-readers: exact retained registered-reader count
+#
+# @active-readers: registered readers currently inside an outer critical section
+#
+# @admissions-in-flight: entries between admission and publication into the
+#     reader/callback state counted below
+#
+# @pending-callbacks: callbacks submitted but not yet completed
+#
+# @drain-active: whether a synchronous drain operation is active
+#
+# @quiescent: whether a complete held barrier has no admitted reader, callback,
+#     admission transition, or drain operation remaining
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'struct': 'CrucibleHotForkRcuBarrierState',
+  'data': { 'schema-version': 'uint32',
+            'generation': 'uint64',
+            'owner-thread-id': 'int64',
+            'held': 'bool',
+            'complete': 'bool',
+            'registered-readers': 'uint64',
+            'active-readers': 'uint64',
+            'admissions-in-flight': 'uint64',
+            'pending-callbacks': 'uint64',
+            'drain-active': 'bool',
+            'quiescent': 'bool' } }
+
+##
+# @crucible-hot-fork-rcu-barrier:
+#
+# Holds, observes, or releases the reversible RCU admission barrier. The
+# command returns without waiting for already-admitted readers or callbacks.
+#
+# @action: requested barrier operation
+#
+# Returns: @CrucibleHotForkRcuBarrierState
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'command': 'crucible-hot-fork-rcu-barrier',
+  'data': { 'action': 'CrucibleHotForkRcuBarrierAction' },
+  'returns': 'CrucibleHotForkRcuBarrierState',
+  'allow-oob': true }
