+    inventory->owner_thread_id =
+        qatomic_read(&rcu_hot_fork_barrier_owner);
+    inventory->registered_readers = readers.entry_count;
+    for (index = 0; index < readers.entry_count; index++) {
+        if (readers.entries[index].active) {
+            inventory->active_readers++;
+        }
+    }
+    inventory->admissions_in_flight =
+        qatomic_read(&rcu_hot_fork_admissions);
+    inventory->pending_callbacks = readers.pending_callbacks;
+    inventory->held = qatomic_read(&rcu_hot_fork_barrier_held) != 0;
