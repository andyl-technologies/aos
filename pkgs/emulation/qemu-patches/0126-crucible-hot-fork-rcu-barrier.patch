+        if (!qatomic_read(&rcu_hot_fork_barrier_held)) {
+            qemu_event_reset(&rcu_hot_fork_barrier_release);
+            qatomic_set(&rcu_hot_fork_barrier_owner, qemu_get_thread_id());
+            smp_mb_global();
+            qatomic_set(&rcu_hot_fork_barrier_held, 1);
+            rcu_hot_fork_barrier_generation++;
+            assert(rcu_hot_fork_barrier_generation != 0);
+        }
+        break;
+    case QEMU_RCU_HOT_FORK_BARRIER_QUERY:
+        break;
+    case QEMU_RCU_HOT_FORK_BARRIER_RELEASE:
+        if (qatomic_read(&rcu_hot_fork_barrier_held)) {
+            qatomic_set(&rcu_hot_fork_barrier_held, 0);
+            qatomic_set(&rcu_hot_fork_barrier_owner, 0);
+            rcu_hot_fork_barrier_generation++;
+            assert(rcu_hot_fork_barrier_generation != 0);
+            qemu_event_set(&rcu_hot_fork_barrier_release);
+        }
+        break;
+    default:
+        g_assert_not_reached();
