diff --git a/tests/unit/test-rcu-list.c b/tests/unit/test-rcu-list.c
index 8f0adb8b0..25d351de3 100644
--- a/tests/unit/test-rcu-list.c
+++ b/tests/unit/test-rcu-list.c
@@ -330,6 +330,65 @@ static void usage(int argc, char *argv[])
 
 static int gtest_seconds;
 
+static QemuEvent barrier_reader_registered;
+static QemuEvent barrier_reader_start;
+static int barrier_reader_attempting;
+static int barrier_reader_entered;
+
+static void *rcu_barrier_reader(void *opaque)
+{
+    (void)opaque;
+    rcu_register_thread();
+    qemu_event_set(&barrier_reader_registered);
+    qemu_event_wait(&barrier_reader_start);
+    qatomic_set(&barrier_reader_attempting, 1);
+    rcu_read_lock();
+    qatomic_set(&barrier_reader_entered, 1);
+    rcu_read_unlock();
+    rcu_unregister_thread();
+    return NULL;
+}
+
+static void gtest_rcu_hot_fork_barrier(void)
+{
+    QemuRcuHotForkBarrierInventory inventory;
+    QemuThread reader;
+
+    qatomic_set(&barrier_reader_attempting, 0);
+    qatomic_set(&barrier_reader_entered, 0);
+    qemu_event_init(&barrier_reader_registered, false);
+    qemu_event_init(&barrier_reader_start, false);
+    qemu_thread_create(&reader, "barrier-reader", rcu_barrier_reader, NULL,
+                       QEMU_THREAD_JOINABLE);
+    qemu_event_wait(&barrier_reader_registered);
+
+    qemu_rcu_hot_fork_barrier(QEMU_RCU_HOT_FORK_BARRIER_HOLD, &inventory);
+    g_assert_true(inventory.held);
+    g_assert_true(inventory.quiescent);
+    g_assert_cmpint(inventory.owner_thread_id, ==, qemu_get_thread_id());
+
+    qemu_event_set(&barrier_reader_start);
+    while (!qatomic_read(&barrier_reader_attempting)) {
+        g_thread_yield();
+    }
+    g_usleep(10000);
+    g_assert_cmpint(qatomic_read(&barrier_reader_entered), ==, 0);
+
+    qemu_rcu_hot_fork_barrier(QEMU_RCU_HOT_FORK_BARRIER_QUERY, &inventory);
+    g_assert_true(inventory.held);
+    g_assert_true(inventory.quiescent);
+    g_assert_cmpuint(inventory.admissions_in_flight, ==, 0);
+
+    qemu_rcu_hot_fork_barrier(QEMU_RCU_HOT_FORK_BARRIER_RELEASE, &inventory);
+    g_assert_false(inventory.held);
+    g_assert_false(inventory.quiescent);
+    g_assert_cmpint(inventory.owner_thread_id, ==, 0);
+    qemu_thread_join(&reader);
+    g_assert_cmpint(qatomic_read(&barrier_reader_entered), ==, 1);
+    qemu_event_destroy(&barrier_reader_registered);
+    qemu_event_destroy(&barrier_reader_start);
+}
+
 static void gtest_rcuq_one(void)
 {
     rcu_qtest("rcuqtest", gtest_seconds / 4, 1);
@@ -362,6 +421,8 @@ int main(int argc, char *argv[])
             g_test_add_func("/rcu/"TEST_NAME"/single-threaded", gtest_rcuq_one);
             g_test_add_func("/rcu/"TEST_NAME"/short-few", gtest_rcuq_few);
             g_test_add_func("/rcu/"TEST_NAME"/long-many", gtest_rcuq_many);
+            g_test_add_func("/rcu/hot-fork/barrier",
+                            gtest_rcu_hot_fork_barrier);
             g_test_in_charge = 1;
             return g_test_run();
         }
