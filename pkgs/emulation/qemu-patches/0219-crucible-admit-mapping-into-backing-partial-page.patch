+static void test_mapping_table_admits_backing_partial_page(void)
+{
+    QemuCrucibleHotForkDescriptorTableTransaction transaction = {
+        .parent_pid = getpid(),
+        .child_pid = getpid(),
+        .active = false,
+        .descriptors_applied = true,
+        .mappings_verified = false,
+    };
+    uint64_t page_size = qemu_real_host_page_size();
+    /* An exact protocol length one byte past a page boundary. */
+    int backing_fd = create_sealed_mapping_backing(
+        "crucible-hot-fork-partial", page_size + 1);
+    void *mapping = mmap(NULL, 2 * page_size, PROT_READ | PROT_WRITE,
+                         MAP_SHARED, backing_fd, 0);
+    QemuCrucibleHotForkSharedMapping shared_mapping = {
+        .start = (uintptr_t)mapping,
+        .length = 2 * page_size,
+        .offset = 0,
+        .backing_fd = backing_fd,
+    };
+
+    g_assert_true(mapping != MAP_FAILED);
+    /* Reaching past the final partial page is still rejected. */
+    shared_mapping.length = 3 * page_size;
+    g_assert_cmpint(qemu_crucible_hot_fork_verify_mapping_table(
+                        &transaction, &shared_mapping, 1),
+                    ==, -EINVAL);
+    g_assert_false(transaction.mappings_verified);
+
+    /*
+     * The page-rounded extent of that length is admitted by the table
+     * check; whether the process scan then matches depends on the test
+     * process's other shared mappings, which this test does not own.
+     */
+    shared_mapping.length = 2 * page_size;
+    g_assert_cmpint(qemu_crucible_hot_fork_verify_mapping_table(
+                        &transaction, &shared_mapping, 1),
+                    !=, -EINVAL);
+    g_assert_cmpint(munmap(mapping, 2 * page_size), ==, 0);
+    close(backing_fd);
+}
+
