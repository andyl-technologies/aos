diff --git a/plugins/crucible-fault-accelerator.c b/plugins/crucible-fault-accelerator.c
new file mode 100644
index 0000000..fd148da
--- /dev/null
+++ b/plugins/crucible-fault-accelerator.c
@@ -0,0 +1,642 @@
+/*
+ * Crucible deterministic accelerator fault device integration
+ *
+ * Copyright (c) 2026 ANDYL Technologies
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/bswap.h"
+#include "qemu/crucible-fault.h"
+#include "qemu/error-report.h"
+#include "qemu/module.h"
+#include "qobject/qdict.h"
+#include "qobject/qnum.h"
+#include "qobject/qstring.h"
+#include "system/cpu-timers.h"
+
+#define CRUCIBLE_ACCELERATOR_STATUS_UNAVAILABLE 4
+#define CRUCIBLE_ACCELERATOR_STATUS_UNCORRECTABLE 5
+#define CRUCIBLE_ACCELERATOR_EVIDENCE_BYTES 256
+
+enum CrucibleAcceleratorLifecycle {
+    CRUCIBLE_ACCELERATOR_PRESENT = 1,
+    CRUCIBLE_ACCELERATOR_DISAPPEARED = 2,
+};
+
+typedef struct CrucibleAcceleratorState {
+    uint32_t lifecycle;
+    uint64_t reset_generation;
+    uint64_t job_sequence;
+    uint64_t service_remainder;
+    uint64_t memory_generation;
+    bool terminal;
+    GPtrArray *lifecycle_rules;
+    GPtrArray *result_rules;
+    GPtrArray *memory_rules;
+    GPtrArray *service_rules;
+} CrucibleAcceleratorState;
+
+typedef struct CrucibleAcceleratorVmstate {
+    uint32_t lifecycle;
+    uint64_t reset_generation;
+    uint64_t job_sequence;
+    uint64_t service_remainder;
+    uint64_t memory_generation;
+    uint8_t terminal;
+} CrucibleAcceleratorVmstate;
+
+static CrucibleAcceleratorState crucible_accelerator;
+static QemuCrucibleAcceleratorLifecycleFn accelerator_lifecycle_callback;
+static void *accelerator_lifecycle_opaque;
+static uint8_t accelerator_registered_device[32];
+
+void qemu_crucible_fault_accelerator_device_register(
+    const uint8_t device_id[32], QemuCrucibleAcceleratorLifecycleFn callback,
+    void *opaque)
+{
+    g_assert(device_id && callback && opaque && !accelerator_lifecycle_callback);
+    memcpy(accelerator_registered_device, device_id, 32);
+    accelerator_lifecycle_callback = callback;
+    accelerator_lifecycle_opaque = opaque;
+}
+
+void qemu_crucible_fault_accelerator_device_unregister(void *opaque)
+{
+    g_assert(opaque == accelerator_lifecycle_opaque);
+    accelerator_lifecycle_callback = NULL;
+    accelerator_lifecycle_opaque = NULL;
+    memset(accelerator_registered_device, 0,
+           sizeof(accelerator_registered_device));
+}
+
+/* Keep this public object identity byte-for-byte equal to the host codec. */
+void qemu_crucible_fault_accelerator_device_id(uint8_t output[32])
+{
+    static const uint64_t initial[4] = {
+        UINT64_C(0x243f6a8885a308d3), UINT64_C(0x13198a2e03707344),
+        UINT64_C(0xa4093822299f31d0), UINT64_C(0x082efa98ec4e6c89),
+    };
+    static const char *parts[] = {
+        "crucible.content-hash.v1", "crucible.fault-object.v1",
+        "accelerator-0",
+    };
+    uint64_t lanes[4];
+    uint64_t written = 0;
+
+    memcpy(lanes, initial, sizeof(lanes));
+    for (size_t part = 0; part < G_N_ELEMENTS(parts); part++) {
+        size_t length = strlen(parts[part]);
+        uint64_t words = length;
+
+#define MIX(value) do { \
+        uint64_t mix_value = (value); \
+        for (size_t lane = 0; lane < 4; lane++) { \
+            uint32_t rotation = 13 + lane * 7; \
+            uint64_t salt = lane * UINT64_C(0xd6e8feb86659fd93); \
+            lanes[lane] ^= mix_value + salt; \
+            lanes[lane] = rol64(lanes[lane], rotation) * \
+                          UINT64_C(0x9e3779b185ebca87); \
+            lanes[lane] ^= lanes[lane] >> 33; \
+        } \
+    } while (0)
+        MIX(words);
+        written += 8;
+        for (size_t offset = 0; offset < length; offset += 8) {
+            uint8_t word[8] = { 0 };
+            size_t take = MIN((size_t)8, length - offset);
+
+            memcpy(word, parts[part] + offset, take);
+            MIX(ldq_le_p(word));
+        }
+        written += length;
+    }
+#undef MIX
+    for (size_t lane = 0; lane < 4; lane++) {
+        uint64_t word = lanes[lane] + written +
+            lane * UINT64_C(0x9e3779b97f4a7c15);
+
+        word ^= word >> 30;
+        word *= UINT64_C(0xbf58476d1ce4e5b9);
+        word ^= word >> 27;
+        word *= UINT64_C(0x94d049bb133111eb);
+        word ^= word >> 31;
+        stq_le_p(output + lane * 8, word);
+    }
+}
+
+static bool accelerator_field(const QemuCrucibleFaultRule *rule,
+                              uint16_t tag, uint16_t type,
+                              const uint8_t **data, uint32_t *length)
+{
+    return qemu_crucible_fault_rule_field(rule, tag, type, data, length);
+}
+
+static bool accelerator_u32(const QemuCrucibleFaultRule *rule,
+                            uint16_t tag, uint32_t *value)
+{
+    const uint8_t *data;
+    uint32_t length;
+
+    if (!accelerator_field(rule, tag, CRUCIBLE_NODE_FAULT_FIELD_TYPE_U32,
+                           &data, &length) || length != 4) {
+        return false;
+    }
+    *value = ldl_le_p(data);
+    return true;
+}
+
+static bool accelerator_ratio(const QemuCrucibleFaultRule *rule,
+                              uint64_t *numerator, uint64_t *denominator)
+{
+    const uint8_t *data;
+    uint32_t length;
+
+    if (!accelerator_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P1,
+                           CRUCIBLE_NODE_FAULT_FIELD_TYPE_RATIO,
+                           &data, &length) || length != 16) {
+        return false;
+    }
+    *numerator = ldq_le_p(data);
+    *denominator = ldq_le_p(data + 8);
+    return *numerator != 0 && *numerator <= *denominator;
+}
+
+static bool accelerator_target_matches(const QemuCrucibleFaultRule *rule,
+                                       const uint8_t device_id[32])
+{
+    const uint8_t *target;
+    uint32_t length;
+
+    return accelerator_field(rule, CRUCIBLE_NODE_FAULT_FIELD_T1,
+                             CRUCIBLE_NODE_FAULT_FIELD_TYPE_HASH,
+                             &target, &length) && length == 32 &&
+           memcmp(target, device_id, 32) == 0;
+}
+
+static void accelerator_rule_unref(gpointer opaque)
+{
+    qemu_crucible_fault_rule_unref(opaque);
+}
+
+static GPtrArray *accelerator_rule_array(void)
+{
+    return g_ptr_array_new_with_free_func(accelerator_rule_unref);
+}
+
+static void accelerator_state_ensure(void)
+{
+    if (!crucible_accelerator.lifecycle_rules) {
+        crucible_accelerator.lifecycle = CRUCIBLE_ACCELERATOR_PRESENT;
+        crucible_accelerator.lifecycle_rules = accelerator_rule_array();
+        crucible_accelerator.result_rules = accelerator_rule_array();
+        crucible_accelerator.memory_rules = accelerator_rule_array();
+        crucible_accelerator.service_rules = accelerator_rule_array();
+    }
+}
+
+static void accelerator_collect_rule(const QemuCrucibleFaultRule *rule,
+                                     void *opaque)
+{
+    GPtrArray *rules = opaque;
+
+    g_ptr_array_add(rules, qemu_crucible_fault_rule_ref(
+                              (QemuCrucibleFaultRule *)rule));
+}
+
+int qemu_crucible_fault_accelerator_validate(
+    const QemuCrucibleFaultRule *rule)
+{
+    uint8_t device_id[32];
+    uint16_t kind = qemu_crucible_fault_rule_command_kind(rule);
+    uint16_t operation = qemu_crucible_fault_rule_operation(rule);
+
+    qemu_crucible_fault_accelerator_device_id(device_id);
+    if (!accelerator_target_matches(rule, device_id)) {
+        return -EINVAL;
+    }
+    if (!accelerator_lifecycle_callback ||
+        memcmp(accelerator_registered_device, device_id, 32) != 0) {
+        return -ENOTSUP;
+    }
+    if (operation == CRUCIBLE_NODE_FAULT_OPERATION_REMOVE) {
+        return 0;
+    }
+    if (kind == CRUCIBLE_FAULT_COMMAND_ACCELERATOR_LIFECYCLE) {
+        uint32_t transition, queue_policy, memory_policy;
+
+        return accelerator_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P2,
+                               &transition) && transition >= 1 &&
+               transition <= 3 &&
+               accelerator_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P3,
+                               &queue_policy) && queue_policy >= 1 &&
+               queue_policy <= 3 &&
+               accelerator_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P4,
+                               &memory_policy) && memory_policy >= 1 &&
+               memory_policy <= 3 ? 0 : -EINVAL;
+    }
+    if (kind == CRUCIBLE_FAULT_COMMAND_ACCELERATOR_SERVICE) {
+        uint64_t numerator, denominator;
+
+        return accelerator_ratio(rule, &numerator, &denominator) ? 0 : -EINVAL;
+    }
+    return kind == CRUCIBLE_FAULT_COMMAND_ACCELERATOR_RESULT_TRANSFORM ||
+           kind == CRUCIBLE_FAULT_COMMAND_ACCELERATOR_MEMORY_EVENT ? 0 :
+           -ENOTSUP;
+}
+
+static void accelerator_rebuild_rules(void)
+{
+    GPtrArray *lifecycle = accelerator_rule_array();
+    GPtrArray *result = accelerator_rule_array();
+    GPtrArray *memory = accelerator_rule_array();
+    GPtrArray *service = accelerator_rule_array();
+
+    qemu_crucible_fault_rule_foreach(
+        CRUCIBLE_FAULT_COMMAND_ACCELERATOR_LIFECYCLE,
+        accelerator_collect_rule, lifecycle);
+    qemu_crucible_fault_rule_foreach(
+        CRUCIBLE_FAULT_COMMAND_ACCELERATOR_RESULT_TRANSFORM,
+        accelerator_collect_rule, result);
+    qemu_crucible_fault_rule_foreach(
+        CRUCIBLE_FAULT_COMMAND_ACCELERATOR_MEMORY_EVENT,
+        accelerator_collect_rule, memory);
+    qemu_crucible_fault_rule_foreach(
+        CRUCIBLE_FAULT_COMMAND_ACCELERATOR_SERVICE,
+        accelerator_collect_rule, service);
+    g_clear_pointer(&crucible_accelerator.lifecycle_rules, g_ptr_array_unref);
+    g_clear_pointer(&crucible_accelerator.result_rules, g_ptr_array_unref);
+    g_clear_pointer(&crucible_accelerator.memory_rules, g_ptr_array_unref);
+    g_clear_pointer(&crucible_accelerator.service_rules, g_ptr_array_unref);
+    crucible_accelerator.lifecycle_rules = lifecycle;
+    crucible_accelerator.result_rules = result;
+    crucible_accelerator.memory_rules = memory;
+    crucible_accelerator.service_rules = service;
+}
+
+void qemu_crucible_fault_accelerator_rules_changed(
+    const QemuCrucibleFaultRule *transition_rule,
+    QemuCrucibleFaultEventReservation **event_reservation)
+{
+    uint8_t device_id[32];
+    uint32_t transition;
+
+    accelerator_state_ensure();
+    accelerator_rebuild_rules();
+    if (!transition_rule ||
+        qemu_crucible_fault_rule_command_kind(transition_rule) !=
+            CRUCIBLE_FAULT_COMMAND_ACCELERATOR_LIFECYCLE ||
+        qemu_crucible_fault_rule_operation(transition_rule) ==
+            CRUCIBLE_NODE_FAULT_OPERATION_REMOVE ||
+        !accelerator_u32(transition_rule, CRUCIBLE_NODE_FAULT_FIELD_P2,
+                         &transition)) {
+        return;
+    }
+    qemu_crucible_fault_accelerator_device_id(device_id);
+    if (!accelerator_target_matches(transition_rule, device_id)) {
+        return;
+    }
+    if (transition == 1) {
+        crucible_accelerator.lifecycle = CRUCIBLE_ACCELERATOR_DISAPPEARED;
+    } else if (transition == 2) {
+        crucible_accelerator.lifecycle = CRUCIBLE_ACCELERATOR_PRESENT;
+        crucible_accelerator.reset_generation++;
+        crucible_accelerator.memory_generation++;
+        crucible_accelerator.service_remainder = 0;
+    } else {
+        crucible_accelerator.lifecycle = CRUCIBLE_ACCELERATOR_PRESENT;
+        crucible_accelerator.reset_generation++;
+    }
+    uint32_t queue_policy, memory_policy;
+    if (!accelerator_u32(transition_rule, CRUCIBLE_NODE_FAULT_FIELD_P3,
+                         &queue_policy) ||
+        !accelerator_u32(transition_rule, CRUCIBLE_NODE_FAULT_FIELD_P4,
+                         &memory_policy) || !accelerator_lifecycle_callback) {
+        error_report("Crucible accelerator lifecycle target disappeared");
+        abort();
+    }
+    accelerator_lifecycle_callback(accelerator_lifecycle_opaque, transition,
+                                   queue_policy, memory_policy);
+    (void)event_reservation;
+}
+
+static bool accelerator_scale_service(uint64_t input, uint64_t numerator,
+                                      uint64_t denominator,
+                                      uint64_t *remainder, uint64_t *output)
+{
+    __uint128_t scaled = (__uint128_t)input * denominator + *remainder;
+    __uint128_t quotient = scaled / numerator;
+
+    if (quotient == 0 || quotient > UINT64_MAX) {
+        return false;
+    }
+    *output = quotient;
+    *remainder = scaled % numerator;
+    return true;
+}
+
+bool qemu_crucible_fault_accelerator_submit(
+    const uint8_t device_id[32], uint16_t class_id, uint16_t job_kind,
+    uint16_t queue_id, uint64_t sequence, uint64_t *service_units,
+    const uint8_t *input, size_t input_len, size_t output_capacity,
+    uint16_t *status)
+{
+    uint64_t numerator = 1, denominator = 1;
+
+    (void)class_id;
+    (void)job_kind;
+    (void)queue_id;
+    (void)sequence;
+    (void)input;
+    (void)input_len;
+    accelerator_state_ensure();
+    uint8_t expected[32];
+
+    qemu_crucible_fault_accelerator_device_id(expected);
+    if (!service_units || !status || crucible_accelerator.terminal ||
+        memcmp(expected, device_id, 32) != 0) {
+        return false;
+    }
+    if (crucible_accelerator.lifecycle ==
+            CRUCIBLE_ACCELERATOR_DISAPPEARED) {
+        *status = CRUCIBLE_ACCELERATOR_STATUS_UNAVAILABLE;
+        return true;
+    }
+    for (guint i = 0; i < crucible_accelerator.memory_rules->len; i++) {
+        QemuCrucibleFaultRule *rule = g_ptr_array_index(
+            crucible_accelerator.memory_rules, i);
+        uint32_t ecc;
+
+        if (!accelerator_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P4, &ecc)) {
+            continue;
+        }
+        if (ecc == 2 && output_capacity != 0) {
+            *status = CRUCIBLE_ACCELERATOR_STATUS_UNCORRECTABLE;
+            crucible_accelerator.memory_generation++;
+            return true;
+        }
+    }
+    for (guint i = 0; i < crucible_accelerator.service_rules->len; i++) {
+        QemuCrucibleFaultRule *rule = g_ptr_array_index(
+            crucible_accelerator.service_rules, i);
+        uint64_t candidate_numerator, candidate_denominator;
+
+        if (accelerator_ratio(rule, &candidate_numerator,
+                              &candidate_denominator) &&
+            (__uint128_t)candidate_numerator * denominator <
+                (__uint128_t)numerator * candidate_denominator) {
+            numerator = candidate_numerator;
+            denominator = candidate_denominator;
+        }
+    }
+    if (!accelerator_scale_service(*service_units, numerator, denominator,
+                                   &crucible_accelerator.service_remainder,
+                                   service_units)) {
+        qemu_crucible_fault_accelerator_event_terminal();
+        return false;
+    }
+    if (crucible_accelerator.job_sequence == UINT64_MAX) {
+        qemu_crucible_fault_accelerator_event_terminal();
+        return false;
+    }
+    crucible_accelerator.job_sequence++;
+    *status = 0;
+    return true;
+}
+
+static bool accelerator_json_u64(const QObject *object, uint64_t *value)
+{
+    QNum *number = qobject_to(QNum, object);
+
+    if (!number || number->kind == QNUM_DOUBLE ||
+        (number->kind == QNUM_I64 && qnum_get_int(number) < 0)) {
+        return false;
+    }
+    *value = qnum_get_uint(number);
+    return true;
+}
+
+static GByteArray *accelerator_hex(const char *value)
+{
+    size_t length = strlen(value);
+    GByteArray *bytes;
+
+    if (length == 0 || (length & 1) != 0) {
+        return NULL;
+    }
+    bytes = g_byte_array_sized_new(length / 2);
+    for (size_t i = 0; i < length; i += 2) {
+        int high = g_ascii_xdigit_value(value[i]);
+        int low = g_ascii_xdigit_value(value[i + 1]);
+        uint8_t byte;
+
+        if (high < 0 || low < 0) {
+            g_byte_array_unref(bytes);
+            return NULL;
+        }
+        byte = (high << 4) | low;
+        g_byte_array_append(bytes, &byte, 1);
+    }
+    return bytes;
+}
+
+bool qemu_crucible_fault_accelerator_complete(
+    const uint8_t device_id[32], uint16_t class_id, uint16_t job_kind,
+    uint16_t queue_id, uint64_t sequence, uint8_t *output,
+    size_t output_len, uint16_t *status)
+{
+    uint8_t expected[32];
+
+    (void)class_id;
+    (void)sequence;
+    accelerator_state_ensure();
+    qemu_crucible_fault_accelerator_device_id(expected);
+    if (!status || memcmp(expected, device_id, 32) != 0 ||
+        (output_len != 0 && !output) || crucible_accelerator.terminal) {
+        return false;
+    }
+    if (crucible_accelerator.lifecycle ==
+            CRUCIBLE_ACCELERATOR_DISAPPEARED) {
+        *status = CRUCIBLE_ACCELERATOR_STATUS_UNAVAILABLE;
+        return true;
+    }
+    for (guint i = 0; i < crucible_accelerator.memory_rules->len; i++) {
+        QemuCrucibleFaultRule *rule = g_ptr_array_index(
+            crucible_accelerator.memory_rules, i);
+        uint32_t ecc;
+
+        if (accelerator_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P4, &ecc) &&
+            ecc == 2) {
+            *status = CRUCIBLE_ACCELERATOR_STATUS_UNCORRECTABLE;
+            crucible_accelerator.memory_generation++;
+            return true;
+        }
+    }
+    for (guint i = 0; i < crucible_accelerator.result_rules->len; i++) {
+        QemuCrucibleFaultRule *rule = g_ptr_array_index(
+            crucible_accelerator.result_rules, i);
+        QDict *selector = qobject_to(QDict, qemu_crucible_fault_rule_json(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_P1));
+        QDict *mutation = qobject_to(QDict, qemu_crucible_fault_rule_json(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_P2));
+        uint64_t offset;
+        QNum *queue;
+        g_autoptr(GByteArray) mask = NULL;
+        g_autoptr(GByteArray) value = NULL;
+
+        QString *job_name;
+        QString *mask_text;
+        QString *value_text;
+
+        if (!selector || !mutation ||
+            !accelerator_json_u64(qdict_get(mutation, "offset"), &offset)) {
+            return false;
+        }
+        job_name = qobject_to(QString, qdict_get(selector, "job_kind"));
+        mask_text = qobject_to(QString, qdict_get(mutation, "mask"));
+        value_text = qobject_to(QString, qdict_get(mutation, "value"));
+        if (!job_name || !mask_text || !value_text) {
+            return false;
+        }
+        queue = qobject_to(QNum, qdict_get(selector, "queue"));
+        if (queue && qnum_get_uint(queue) != queue_id) {
+            continue;
+        }
+        /* Closed job kind 1 is named matrix-multiply by the public manifest. */
+        const char *expected_job = class_id == 1 ? "vector-add" :
+                                   class_id == 2 ? "matrix-multiply" :
+                                   class_id == 3 ? "lookup-table" : NULL;
+        if (job_kind != 1 || !expected_job ||
+            strcmp(qstring_get_str(job_name), expected_job) != 0) {
+            continue;
+        }
+        if (!qemu_crucible_fault_rule_occurs_nested(
+                rule, CRUCIBLE_NODE_FAULT_FIELD_P1, "occurrence")) {
+            continue;
+        }
+        mask = accelerator_hex(qstring_get_str(mask_text));
+        value = accelerator_hex(qstring_get_str(value_text));
+        if (!mask || !value || mask->len != value->len ||
+            offset > output_len || mask->len > output_len - offset) {
+            return false;
+        }
+        for (guint byte = 0; byte < mask->len; byte++) {
+            output[offset + byte] = (output[offset + byte] & ~mask->data[byte]) |
+                                    (value->data[byte] & mask->data[byte]);
+        }
+    }
+    return true;
+}
+
+void qemu_crucible_fault_accelerator_reset(const uint8_t device_id[32])
+{
+    uint8_t expected[32];
+
+    qemu_crucible_fault_accelerator_device_id(expected);
+    if (memcmp(expected, device_id, 32) == 0) {
+        crucible_accelerator.reset_generation++;
+        crucible_accelerator.service_remainder = 0;
+    }
+}
+
+void qemu_crucible_fault_accelerator_event_terminal(void)
+{
+    crucible_accelerator.terminal = true;
+}
+
+static int accelerator_vmstate_save(GByteArray *payload)
+{
+    accelerator_state_ensure();
+    qemu_crucible_fault_vmstate_put_u32(payload,
+                                        crucible_accelerator.lifecycle);
+    qemu_crucible_fault_vmstate_put_u64(payload,
+                                        crucible_accelerator.reset_generation);
+    qemu_crucible_fault_vmstate_put_u64(payload,
+                                        crucible_accelerator.job_sequence);
+    qemu_crucible_fault_vmstate_put_u64(payload,
+                                        crucible_accelerator.service_remainder);
+    qemu_crucible_fault_vmstate_put_u64(payload,
+                                        crucible_accelerator.memory_generation);
+    qemu_crucible_fault_vmstate_put_u8(payload,
+                                       crucible_accelerator.terminal);
+    return 0;
+}
+
+static int accelerator_vmstate_prepare(const uint8_t *payload,
+                                       size_t payload_len, void **staged)
+{
+    QemuCrucibleFaultVmstateReader reader = {
+        .data = payload,
+        .length = payload_len,
+    };
+    CrucibleAcceleratorVmstate *state = g_new0(
+        CrucibleAcceleratorVmstate, 1);
+
+    if (!qemu_crucible_fault_vmstate_get_u32(&reader, &state->lifecycle) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            &reader, &state->reset_generation) ||
+        !qemu_crucible_fault_vmstate_get_u64(&reader, &state->job_sequence) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            &reader, &state->service_remainder) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            &reader, &state->memory_generation) ||
+        !qemu_crucible_fault_vmstate_get_u8(&reader, &state->terminal) ||
+        state->lifecycle < CRUCIBLE_ACCELERATOR_PRESENT ||
+        state->lifecycle > CRUCIBLE_ACCELERATOR_DISAPPEARED ||
+        !qemu_crucible_fault_vmstate_reader_finished(&reader)) {
+        g_free(state);
+        return -EINVAL;
+    }
+    *staged = state;
+    return 0;
+}
+
+static void accelerator_vmstate_commit(void *opaque)
+{
+    CrucibleAcceleratorVmstate *state = opaque;
+
+    accelerator_state_ensure();
+    crucible_accelerator.lifecycle = state->lifecycle;
+    crucible_accelerator.reset_generation = state->reset_generation;
+    crucible_accelerator.job_sequence = state->job_sequence;
+    crucible_accelerator.service_remainder = state->service_remainder;
+    crucible_accelerator.memory_generation = state->memory_generation;
+    crucible_accelerator.terminal = state->terminal;
+    g_free(state);
+}
+
+static const QemuCrucibleFaultVmstateSection accelerator_vmstate_section = {
+    .name = "accelerator",
+    .version = 1,
+    .save = accelerator_vmstate_save,
+    .prepare = accelerator_vmstate_prepare,
+    .commit = accelerator_vmstate_commit,
+    .free_staged = g_free,
+};
+
+static void accelerator_fault_register(void)
+{
+    uint32_t boundary = 1U << (CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY - 1);
+    uint32_t device = 1U << (CRUCIBLE_FAULT_PHASE_DEVICE - 1);
+
+    qemu_crucible_fault_node_register(
+        CRUCIBLE_FAULT_COMMAND_ACCELERATOR_LIFECYCLE,
+        CRUCIBLE_FAULT_CAPABILITY_SCOPE_ACCELERATOR, boundary | device,
+        "qemu.accelerator.lifecycle.v1", NULL);
+    qemu_crucible_fault_node_register(
+        CRUCIBLE_FAULT_COMMAND_ACCELERATOR_RESULT_TRANSFORM,
+        CRUCIBLE_FAULT_CAPABILITY_SCOPE_ACCELERATOR, device,
+        "qemu.accelerator.result-transform.v1", NULL);
+    qemu_crucible_fault_node_register(
+        CRUCIBLE_FAULT_COMMAND_ACCELERATOR_MEMORY_EVENT,
+        CRUCIBLE_FAULT_CAPABILITY_SCOPE_ACCELERATOR, boundary | device,
+        "qemu.accelerator.memory-event.v1", NULL);
+    qemu_crucible_fault_node_register(
+        CRUCIBLE_FAULT_COMMAND_ACCELERATOR_SERVICE,
+        CRUCIBLE_FAULT_CAPABILITY_SCOPE_ACCELERATOR, boundary | device,
+        "qemu.accelerator.service.v1", NULL);
+    qemu_crucible_fault_vmstate_register(&accelerator_vmstate_section);
+}
+
+type_init(accelerator_fault_register)
