diff --git a/hw/virtio/virtio-crucible-accelerator-pci.c b/hw/virtio/virtio-crucible-accelerator-pci.c
new file mode 100644
index 0000000..63b8124
--- /dev/null
+++ b/hw/virtio/virtio-crucible-accelerator-pci.c
@@ -0,0 +1,77 @@
+/*
+ * Virtio Crucible accelerator PCI binding
+ *
+ * Copyright (C) 2026 ANDYL Technologies
+ *
+ * This work is licensed under the terms of the GNU GPL, version 2 or later.
+ * See the COPYING file in the top-level directory.
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/module.h"
+#include "hw/virtio/virtio-crucible-accelerator.h"
+#include "hw/virtio/virtio-pci.h"
+
+#define TYPE_VIRTIO_CRUCIBLE_ACCELERATOR_PCI \
+    "virtio-crucible-accelerator-pci-base"
+
+typedef struct VirtIOCrucibleAcceleratorPCI {
+    VirtIOPCIProxy parent_obj;
+    VirtIOCrucibleAccelerator vdev;
+} VirtIOCrucibleAcceleratorPCI;
+
+DECLARE_INSTANCE_CHECKER(VirtIOCrucibleAcceleratorPCI,
+                         VIRTIO_CRUCIBLE_ACCELERATOR_PCI,
+                         TYPE_VIRTIO_CRUCIBLE_ACCELERATOR_PCI)
+
+static void accelerator_pci_realize(VirtIOPCIProxy *proxy, Error **errp)
+{
+    VirtIOCrucibleAcceleratorPCI *dev =
+        VIRTIO_CRUCIBLE_ACCELERATOR_PCI(proxy);
+
+    if (proxy->nvectors == DEV_NVECTORS_UNSPECIFIED) {
+        proxy->nvectors = 2;
+    }
+    qdev_realize(DEVICE(&dev->vdev), BUS(&proxy->bus), errp);
+}
+
+static void accelerator_pci_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    VirtioPCIClass *vpc = VIRTIO_PCI_CLASS(klass);
+    PCIDeviceClass *pc = PCI_DEVICE_CLASS(klass);
+
+    vpc->realize = accelerator_pci_realize;
+    pc->vendor_id = PCI_VENDOR_ID_REDHAT_QUMRANET;
+    /* Private modern-only binding for experimental virtio device ID 65535. */
+    pc->device_id = 0x10ff;
+    pc->revision = VIRTIO_PCI_ABI_VERSION;
+    pc->class_id = PCI_CLASS_PROCESSOR_CO;
+    set_bit(DEVICE_CATEGORY_MISC, dc->categories);
+}
+
+static void accelerator_pci_instance_init(Object *object)
+{
+    VirtIOCrucibleAcceleratorPCI *dev =
+        VIRTIO_CRUCIBLE_ACCELERATOR_PCI(object);
+
+    virtio_instance_init_common(object, &dev->vdev, sizeof(dev->vdev),
+                                TYPE_VIRTIO_CRUCIBLE_ACCELERATOR);
+}
+
+static const VirtioPCIDeviceTypeInfo accelerator_pci_info = {
+    .base_name = TYPE_VIRTIO_CRUCIBLE_ACCELERATOR_PCI,
+    .generic_name = "virtio-crucible-accelerator-pci",
+    .non_transitional_name = "virtio-crucible-accelerator-pci-non-transitional",
+    .instance_size = sizeof(VirtIOCrucibleAcceleratorPCI),
+    .instance_init = accelerator_pci_instance_init,
+    .class_init = accelerator_pci_class_init,
+};
+
+static void accelerator_pci_register(void)
+{
+    virtio_pci_types_register(&accelerator_pci_info);
+}
+
+type_init(accelerator_pci_register)
diff --git a/hw/virtio/virtio-crucible-accelerator.c b/hw/virtio/virtio-crucible-accelerator.c
new file mode 100644
index 0000000..57b3c60
--- /dev/null
+++ b/hw/virtio/virtio-crucible-accelerator.c
@@ -0,0 +1,410 @@
+/*
+ * Crucible deterministic accelerator co-simulation device
+ *
+ * Copyright (C) 2026 ANDYL Technologies
+ *
+ * This work is licensed under the terms of the GNU GPL, version 2 or later.
+ * See the COPYING file in the top-level directory.
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/iov.h"
+#include "qemu/module.h"
+#include "qemu/crucible-fault.h"
+#include "qemu/qemu-plugin.h"
+#include "hw/virtio/virtio-crucible-accelerator.h"
+#include "migration/qemu-file-types.h"
+#include "migration/qemu-file.h"
+#include "migration/vmstate.h"
+#include "system/crucible-plugin-wake.h"
+
+typedef struct VirtIOCrucibleAcceleratorRequest {
+    QTAILQ_ENTRY(VirtIOCrucibleAcceleratorRequest) link;
+    VirtQueueElement *element;
+    VirtIOCrucibleAcceleratorJob job;
+} VirtIOCrucibleAcceleratorRequest;
+
+static qemu_plugin_accelerator_submit_cb_t accelerator_submit_cb;
+static qemu_plugin_accelerator_poll_cb_t accelerator_poll_cb;
+static qemu_plugin_accelerator_wait_cb_t accelerator_wait_cb;
+static qemu_plugin_accelerator_restore_cb_t accelerator_restore_cb;
+static void *accelerator_userdata;
+
+static void accelerator_complete(VirtIOCrucibleAccelerator *dev,
+                                 VirtIOCrucibleAcceleratorRequest *request,
+                                 uint16_t status, uint8_t *output,
+                                 size_t output_len);
+
+void qemu_plugin_register_accelerator_cb(
+    qemu_plugin_accelerator_submit_cb_t submit_cb,
+    qemu_plugin_accelerator_poll_cb_t poll_cb,
+    qemu_plugin_accelerator_wait_cb_t wait_cb,
+    qemu_plugin_accelerator_restore_cb_t restore_cb, void *userdata)
+{
+    accelerator_submit_cb = submit_cb;
+    accelerator_poll_cb = poll_cb;
+    accelerator_wait_cb = wait_cb;
+    accelerator_restore_cb = restore_cb;
+    accelerator_userdata = userdata;
+}
+
+static bool accelerator_callbacks_ready(void)
+{
+    return accelerator_submit_cb && accelerator_poll_cb &&
+           accelerator_wait_cb && accelerator_restore_cb;
+}
+
+static bool accelerator_job_valid(const VirtIOCrucibleAcceleratorJob *job,
+                                  size_t out_bytes, size_t in_bytes)
+{
+    uint16_t class_id = le16_to_cpu(job->class_id);
+    uint32_t input_len = le32_to_cpu(job->input_len);
+    uint32_t output_capacity = le32_to_cpu(job->output_capacity);
+
+    return le16_to_cpu(job->protocol_version) == 1 && class_id >= 1 &&
+           class_id <= 3 && le16_to_cpu(job->job_kind) != 0 &&
+           le64_to_cpu(job->sequence) != 0 &&
+           le64_to_cpu(job->service_units) != 0 &&
+           input_len <= VIRTIO_CRUCIBLE_ACCELERATOR_DATA_MAX &&
+           output_capacity <= VIRTIO_CRUCIBLE_ACCELERATOR_DATA_MAX &&
+           out_bytes == sizeof(*job) + input_len &&
+           in_bytes >= sizeof(*job) + output_capacity &&
+           job->status == 0 && job->output_len == 0;
+}
+
+static void accelerator_drop_pending(VirtIOCrucibleAccelerator *dev,
+                                     uint16_t status)
+{
+    VirtIOCrucibleAcceleratorRequest *request, *next;
+
+    QTAILQ_FOREACH_SAFE(request, &dev->pending, link, next) {
+        accelerator_complete(dev, request, status, NULL, 0);
+    }
+}
+
+static void accelerator_fault_lifecycle(void *opaque, uint32_t transition,
+                                        uint32_t queue_policy,
+                                        uint32_t memory_policy)
+{
+    VirtIOCrucibleAccelerator *dev = opaque;
+
+    if ((transition == 1 || transition == 2) && queue_policy != 1) {
+        accelerator_drop_pending(dev, 4);
+    }
+    if (transition == 2 || queue_policy == 3 || memory_policy == 3) {
+        virtio_reset(VIRTIO_DEVICE(dev));
+    }
+    virtio_notify_config(VIRTIO_DEVICE(dev));
+}
+
+static void accelerator_complete(VirtIOCrucibleAccelerator *dev,
+                                 VirtIOCrucibleAcceleratorRequest *request,
+                                 uint16_t status, uint8_t *output,
+                                 size_t output_len)
+{
+    VirtIODevice *vdev = VIRTIO_DEVICE(dev);
+    VirtIOCrucibleAcceleratorJob result = request->job;
+
+    if (!qemu_crucible_fault_accelerator_complete(
+            dev->config.device_id, le16_to_cpu(request->job.class_id),
+            le16_to_cpu(request->job.job_kind),
+            le16_to_cpu(request->job.queue_id),
+            le64_to_cpu(request->job.sequence), output,
+            output_len, &status)) {
+        status = 1;
+        output_len = 0;
+    }
+
+    result.status = cpu_to_le32(status);
+    result.output_len = cpu_to_le32(output_len);
+    iov_from_buf(request->element->in_sg, request->element->in_num,
+                 0, &result, sizeof(result));
+    if (output_len != 0) {
+        iov_from_buf(request->element->in_sg, request->element->in_num,
+                     sizeof(result), output, output_len);
+    }
+    virtqueue_push(dev->vq, request->element, sizeof(result) + output_len);
+    virtio_notify(vdev, dev->vq);
+    QTAILQ_REMOVE(&dev->pending, request, link);
+    dev->pending_count--;
+    g_free(request->element);
+    g_free(request);
+}
+
+static void accelerator_poll(VirtIOCrucibleAccelerator *dev)
+{
+    VirtIOCrucibleAcceleratorRequest *request, *next;
+    uint8_t output[VIRTIO_CRUCIBLE_ACCELERATOR_DATA_MAX];
+
+    QTAILQ_FOREACH_SAFE(request, &dev->pending, link, next) {
+        uint16_t status = 0;
+        int64_t len = accelerator_poll_cb(
+            le64_to_cpu(request->job.sequence), &status,
+            output, sizeof(output),
+            accelerator_userdata);
+
+        if (len == QEMU_PLUGIN_ACCELERATOR_POLL_PENDING) {
+            accelerator_wait_cb(le64_to_cpu(request->job.sequence),
+                                accelerator_userdata);
+            continue;
+        }
+        if (len < 0 || len > le32_to_cpu(request->job.output_capacity)) {
+            accelerator_complete(dev, request, 1, NULL, 0);
+        } else {
+            accelerator_complete(dev, request, status, output, len);
+        }
+    }
+}
+
+static void accelerator_handle_output(VirtIODevice *vdev, VirtQueue *vq)
+{
+    VirtIOCrucibleAccelerator *dev = VIRTIO_CRUCIBLE_ACCELERATOR(vdev);
+    VirtQueueElement *element;
+
+    if (!accelerator_callbacks_ready()) {
+        virtio_error(vdev, "accelerator transport callbacks are unavailable");
+        return;
+    }
+    accelerator_poll(dev);
+    while (dev->pending_count < VIRTIO_CRUCIBLE_ACCELERATOR_QUEUE_SIZE &&
+           (element = virtqueue_pop(vq, sizeof(*element)))) {
+        VirtIOCrucibleAcceleratorRequest *request;
+        VirtIOCrucibleAcceleratorJob job;
+        uint8_t input[VIRTIO_CRUCIBLE_ACCELERATOR_DATA_MAX];
+        uint16_t fault_status = 0;
+        uint64_t service_units;
+        size_t out_bytes = iov_size(element->out_sg, element->out_num);
+        size_t in_bytes = iov_size(element->in_sg, element->in_num);
+
+        if (out_bytes < sizeof(job) ||
+            iov_to_buf(element->out_sg, element->out_num, 0,
+                       &job, sizeof(job)) != sizeof(job) ||
+            !accelerator_job_valid(&job, out_bytes, in_bytes)) {
+            VirtIOCrucibleAcceleratorJob error = {
+                .status = cpu_to_le32(1),
+            };
+            iov_from_buf(element->in_sg, element->in_num, 0,
+                         &error, sizeof(error));
+            virtqueue_push(vq, element, sizeof(error));
+            virtio_notify(vdev, vq);
+            g_free(element);
+            continue;
+        }
+        service_units = le64_to_cpu(job.service_units);
+        if (
+            iov_to_buf(element->out_sg, element->out_num, sizeof(job),
+                       input, le32_to_cpu(job.input_len)) !=
+                           le32_to_cpu(job.input_len) ||
+            !qemu_crucible_fault_accelerator_submit(
+                dev->config.device_id, le16_to_cpu(job.class_id),
+                le16_to_cpu(job.job_kind), le16_to_cpu(job.queue_id),
+                le64_to_cpu(job.sequence), &service_units, input,
+                le32_to_cpu(job.input_len),
+                le32_to_cpu(job.output_capacity), &fault_status) ||
+            fault_status != 0 ||
+            accelerator_submit_cb(le64_to_cpu(job.sequence),
+                                  dev->config.device_id,
+                                  le16_to_cpu(job.class_id),
+                                  le16_to_cpu(job.job_kind),
+                                  le16_to_cpu(job.queue_id),
+                                  service_units, input,
+                                  le32_to_cpu(job.input_len),
+                                  le32_to_cpu(job.output_capacity),
+                                  accelerator_userdata) != 0) {
+            VirtIOCrucibleAcceleratorJob error = {
+                .status = cpu_to_le32(1),
+            };
+            iov_from_buf(element->in_sg, element->in_num, 0,
+                         &error, sizeof(error));
+            virtqueue_push(vq, element, sizeof(error));
+            virtio_notify(vdev, vq);
+            g_free(element);
+            continue;
+        }
+        job.service_units = cpu_to_le64(service_units);
+        request = g_new0(VirtIOCrucibleAcceleratorRequest, 1);
+        request->element = element;
+        request->job = job;
+        QTAILQ_INSERT_TAIL(&dev->pending, request, link);
+        dev->pending_count++;
+    }
+    accelerator_poll(dev);
+}
+
+static void accelerator_wake(Notifier *notifier, void *data)
+{
+    VirtIOCrucibleAccelerator *dev = container_of(
+        notifier, VirtIOCrucibleAccelerator, wake_notifier);
+
+    if ((QemuPluginWakeEvent)(intptr_t)data == QEMU_PLUGIN_WAKE_EVENT_FAILED) {
+        virtio_error(VIRTIO_DEVICE(dev),
+                     "accelerator scheduler wake descriptor failed");
+        return;
+    }
+    if ((QemuPluginWakeEvent)(intptr_t)data == QEMU_PLUGIN_WAKE_EVENT_DRAINED) {
+        accelerator_poll(dev);
+    }
+}
+
+static void accelerator_save(VirtIODevice *vdev, QEMUFile *f)
+{
+    VirtIOCrucibleAccelerator *dev = VIRTIO_CRUCIBLE_ACCELERATOR(vdev);
+    VirtIOCrucibleAcceleratorRequest *request;
+
+    qemu_put_be32(f, dev->pending_count);
+    QTAILQ_FOREACH(request, &dev->pending, link) {
+        qemu_put_buffer(f, (const uint8_t *)&request->job,
+                        sizeof(request->job));
+        qemu_put_virtqueue_element(vdev, f, request->element);
+    }
+}
+
+static int accelerator_load(VirtIODevice *vdev, QEMUFile *f, int version_id)
+{
+    VirtIOCrucibleAccelerator *dev = VIRTIO_CRUCIBLE_ACCELERATOR(vdev);
+    uint32_t count = qemu_get_be32(f);
+    uint32_t i;
+
+    if (count > VIRTIO_CRUCIBLE_ACCELERATOR_QUEUE_SIZE) {
+        return -EINVAL;
+    }
+    for (i = 0; i < count; i++) {
+        VirtIOCrucibleAcceleratorRequest *request = g_new0(
+            VirtIOCrucibleAcceleratorRequest, 1);
+        size_t out_bytes;
+        size_t in_bytes;
+
+        if (qemu_get_buffer(f, (uint8_t *)&request->job,
+                            sizeof(request->job)) != sizeof(request->job)) {
+            g_free(request);
+            return -EIO;
+        }
+        request->element = qemu_get_virtqueue_element_checked(
+            vdev, f, sizeof(*request->element));
+        if (!request->element) {
+            g_free(request);
+            return -EINVAL;
+        }
+        out_bytes = iov_size(request->element->out_sg,
+                             request->element->out_num);
+        in_bytes = iov_size(request->element->in_sg,
+                            request->element->in_num);
+        if (!accelerator_job_valid(&request->job, out_bytes, in_bytes)) {
+            g_free(request->element);
+            g_free(request);
+            return -EINVAL;
+        }
+        if (accelerator_restore_cb(
+                le64_to_cpu(request->job.sequence), dev->config.device_id,
+                le16_to_cpu(request->job.class_id),
+                le16_to_cpu(request->job.job_kind),
+                le16_to_cpu(request->job.queue_id),
+                le64_to_cpu(request->job.service_units),
+                le32_to_cpu(request->job.output_capacity),
+                accelerator_userdata) != 0) {
+            g_free(request->element);
+            g_free(request);
+            return -EINVAL;
+        }
+        QTAILQ_INSERT_TAIL(&dev->pending, request, link);
+        dev->pending_count++;
+    }
+    return 0;
+}
+
+static void accelerator_get_config(VirtIODevice *vdev, uint8_t *config)
+{
+    VirtIOCrucibleAccelerator *dev = VIRTIO_CRUCIBLE_ACCELERATOR(vdev);
+    memcpy(config, &dev->config, sizeof(dev->config));
+}
+
+static void accelerator_realize(DeviceState *device, Error **errp)
+{
+    VirtIOCrucibleAccelerator *dev = VIRTIO_CRUCIBLE_ACCELERATOR(device);
+    VirtIODevice *vdev = VIRTIO_DEVICE(device);
+
+    if (!accelerator_callbacks_ready()) {
+        error_setg(errp, "Crucible accelerator callbacks must be registered");
+        return;
+    }
+    virtio_init(vdev, VIRTIO_ID_CRUCIBLE_ACCELERATOR,
+                sizeof(dev->config));
+    dev->vq = virtio_add_queue(vdev,
+                               VIRTIO_CRUCIBLE_ACCELERATOR_QUEUE_SIZE,
+                               accelerator_handle_output);
+    QTAILQ_INIT(&dev->pending);
+    dev->wake_notifier.notify = accelerator_wake;
+    qemu_plugin_wake_notifier_add(&dev->wake_notifier);
+    dev->wake_registered = true;
+    dev->config.protocol_version = cpu_to_le16(1);
+    dev->config.class_mask = cpu_to_le16(0x7);
+    dev->config.queue_depth = cpu_to_le32(
+        VIRTIO_CRUCIBLE_ACCELERATOR_QUEUE_SIZE);
+    dev->config.data_max = cpu_to_le32(VIRTIO_CRUCIBLE_ACCELERATOR_DATA_MAX);
+    qemu_crucible_fault_accelerator_device_id(dev->config.device_id);
+    qemu_crucible_fault_accelerator_device_register(
+        dev->config.device_id, accelerator_fault_lifecycle, dev);
+}
+
+static void accelerator_unrealize(DeviceState *device)
+{
+    VirtIOCrucibleAccelerator *dev = VIRTIO_CRUCIBLE_ACCELERATOR(device);
+    VirtIODevice *vdev = VIRTIO_DEVICE(device);
+
+    qemu_crucible_fault_accelerator_device_unregister(dev);
+
+    if (dev->wake_registered) {
+        qemu_plugin_wake_notifier_remove(&dev->wake_notifier);
+        dev->wake_registered = false;
+    }
+    g_assert(QTAILQ_EMPTY(&dev->pending));
+    virtio_del_queue(vdev, 0);
+    virtio_cleanup(vdev);
+}
+
+static void accelerator_reset(DeviceState *device)
+{
+    VirtIOCrucibleAccelerator *dev = VIRTIO_CRUCIBLE_ACCELERATOR(device);
+
+    qemu_crucible_fault_accelerator_reset(dev->config.device_id);
+}
+
+static const VMStateDescription vmstate_accelerator = {
+    .name = "virtio-crucible-accelerator",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_VIRTIO_DEVICE,
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void accelerator_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    VirtioDeviceClass *vdc = VIRTIO_DEVICE_CLASS(klass);
+
+    dc->vmsd = &vmstate_accelerator;
+    set_bit(DEVICE_CATEGORY_MISC, dc->categories);
+    vdc->realize = accelerator_realize;
+    vdc->unrealize = accelerator_unrealize;
+    vdc->get_config = accelerator_get_config;
+    device_class_set_legacy_reset(dc, accelerator_reset);
+    vdc->save = accelerator_save;
+    vdc->load = accelerator_load;
+}
+
+static const TypeInfo accelerator_info = {
+    .name = TYPE_VIRTIO_CRUCIBLE_ACCELERATOR,
+    .parent = TYPE_VIRTIO_DEVICE,
+    .instance_size = sizeof(VirtIOCrucibleAccelerator),
+    .class_init = accelerator_class_init,
+};
+
+static void accelerator_register_types(void)
+{
+    type_register_static(&accelerator_info);
+}
+
+type_init(accelerator_register_types)
