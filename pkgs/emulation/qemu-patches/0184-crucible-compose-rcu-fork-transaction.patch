+int qemu_crucible_hot_fork_begin_runtime_transaction(
+    QemuCrucibleHotForkRuntimeTransaction *transaction)
+{
+    int result;
+
+    if (!transaction || transaction->active ||
+        transaction->child_reconstructed || transaction->rcu.active ||
+        transaction->registry.active) {
+        return -EINVAL;
+    }
+
+    result = qemu_rcu_hot_fork_begin_transaction(&transaction->rcu);
+    if (result < 0) {
+        return result;
+    }
+    result = qemu_thread_hot_fork_begin_registry_transaction(
+        &transaction->registry);
+    if (result < 0) {
+        int release_result = qemu_rcu_hot_fork_release_parent_transaction(
+            &transaction->rcu);
+
+        return release_result < 0 ? release_result : result;
+    }
+
+    transaction->active = true;
+    return 0;
+}
+
+int qemu_crucible_hot_fork_release_parent_runtime_transaction(
+    QemuCrucibleHotForkRuntimeTransaction *transaction)
+{
+    int result;
+
+    if (!transaction || !transaction->active ||
+        transaction->child_reconstructed) {
+        return -EINVAL;
+    }
+
+    result = qemu_thread_hot_fork_release_parent_registry_transaction(
+        &transaction->registry);
+    if (result < 0) {
+        return result;
+    }
+    result = qemu_rcu_hot_fork_release_parent_transaction(&transaction->rcu);
+    if (result < 0) {
+        return result;
+    }
+
+    transaction->active = false;
+    return 0;
+}
+
+int qemu_crucible_hot_fork_reconstruct_child_runtime(
+    QemuCrucibleHotForkRuntimeTransaction *transaction)
+{
+    int result;
+
+    if (!transaction || !transaction->active ||
+        transaction->child_reconstructed) {
+        return -EINVAL;
+    }
+
+    result = qemu_thread_hot_fork_reconstruct_child_registry(
+        &transaction->registry);
+    if (result < 0) {
+        return result;
+    }
+    result = qemu_rcu_hot_fork_reconstruct_child(&transaction->rcu);
+    if (result < 0) {
+        return result;
+    }
+
+    transaction->active = false;
+    transaction->child_reconstructed = true;
+    return 0;
+}
