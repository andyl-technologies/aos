+int qemu_rcu_hot_fork_begin_transaction(
+    QemuRcuHotForkTransaction *transaction)
+{
+    QemuRcuHotForkBarrierInventory inventory;
+    struct rcu_reader_data *reader = get_ptr_rcu_reader();
+    int64_t thread_id = qemu_get_thread_id();
+    bool registered;
+
+    if (!transaction || transaction->active ||
+        transaction->coordinator_reader || getpid() <= 1 || thread_id <= 0 ||
+        qatomic_cmpxchg(&rcu_hot_fork_transaction_active, 0, 1) != 0) {
+        return -EINVAL;
+    }
+
+    qemu_rcu_hot_fork_barrier(QEMU_RCU_HOT_FORK_BARRIER_HOLD, &inventory);
+    if (!inventory.held || !inventory.quiescent ||
+        inventory.owner_thread_id != thread_id) {
+        if (inventory.held && inventory.owner_thread_id == thread_id) {
+            qemu_rcu_hot_fork_barrier(QEMU_RCU_HOT_FORK_BARRIER_RELEASE,
+                                      &inventory);
+        }
+        qatomic_set(&rcu_hot_fork_transaction_active, 0);
+        return -EBUSY;
+    }
+
+    qemu_mutex_lock(&rcu_registry_lock);
+    registered = qemu_rcu_hot_fork_reader_is_registered(reader);
+    if (!registered || reader->thread_id != thread_id || reader->depth != 0 ||
+        qatomic_read(&reader->ctr) != 0 ||
+        rcu_hot_fork_generation == UINT64_MAX) {
+        qemu_mutex_unlock(&rcu_registry_lock);
+        qemu_rcu_hot_fork_barrier(QEMU_RCU_HOT_FORK_BARRIER_RELEASE,
+                                  &inventory);
+        qatomic_set(&rcu_hot_fork_transaction_active, 0);
+        return -EBUSY;
+    }
+
+    *transaction = (QemuRcuHotForkTransaction) {
+        .reader_generation = rcu_hot_fork_generation,
+        .barrier_generation = inventory.generation,
+        .parent_process_id = getpid(),
+        .parent_thread_id = thread_id,
+        .coordinator_reader = reader,
+        .active = true,
+    };
+    qemu_mutex_unlock(&rcu_registry_lock);
+    rcu_disable_atfork();
+    return 0;
+}
+
+int qemu_rcu_hot_fork_release_parent_transaction(
+    QemuRcuHotForkTransaction *transaction)
+{
+    QemuRcuHotForkBarrierInventory inventory;
+    struct rcu_reader_data *reader = get_ptr_rcu_reader();
+    bool valid;
+
+    if (!transaction || !transaction->active ||
+        transaction->child_reconstructed ||
+        transaction->parent_process_id != getpid() ||
+        transaction->parent_thread_id != qemu_get_thread_id() ||
+        transaction->coordinator_reader != reader ||
+        !qatomic_read(&rcu_hot_fork_transaction_active)) {
+        return -EPERM;
+    }
+
+    qemu_mutex_lock(&rcu_registry_lock);
+    valid = transaction->reader_generation == rcu_hot_fork_generation &&
+        qemu_rcu_hot_fork_reader_is_registered(reader) &&
+        reader->thread_id == transaction->parent_thread_id &&
+        reader->depth == 0 && qatomic_read(&reader->ctr) == 0;
+    qemu_mutex_unlock(&rcu_registry_lock);
+    if (!valid) {
+        return -EPERM;
+    }
+
+    qemu_rcu_hot_fork_barrier(QEMU_RCU_HOT_FORK_BARRIER_QUERY, &inventory);
+    if (!inventory.held || !inventory.quiescent ||
+        inventory.generation != transaction->barrier_generation ||
+        inventory.owner_thread_id != transaction->parent_thread_id) {
+        return -EPERM;
+    }
+
+    transaction->active = false;
+    rcu_enable_atfork();
+    qemu_rcu_hot_fork_barrier(QEMU_RCU_HOT_FORK_BARRIER_RELEASE, &inventory);
+    qatomic_set(&rcu_hot_fork_transaction_active, 0);
+    return 0;
+}
