@@ -175,6 +175,27 @@
 ##
 { 'command': 'cont' }
 
+##
+# @crucible-complete-terminal-lifecycle:
+#
+# Authorize the pending Crucible terminal lifecycle decision without resuming
+# guest execution.  The two SHA-256 values bind the command to the exact
+# authenticated fault action and evidence emitted by this process generation.
+# Repeating the identical command is idempotent; changing any argument is an
+# error.  The command is unavailable when no terminal decision is pending.
+#
+# @action-sha256: Lowercase hexadecimal SHA-256 of the resolved fault action.
+#
+# @evidence-sha256: Lowercase hexadecimal SHA-256 of the CRUCLIF evidence.
+#
+# @process-generation: Nonzero host-supervised process generation.
+#
+# Since: 10.0
+##
+{ 'command': 'crucible-complete-terminal-lifecycle',
+  'data': { 'action-sha256': 'str', 'evidence-sha256': 'str',
+            'process-generation': 'uint64' } }
+
 ##
 # @x-exit-preconfig:
