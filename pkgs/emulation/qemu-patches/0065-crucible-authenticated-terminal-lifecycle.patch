+static int crucible_lifecycle_hex_nibble(char value)
+{
+    if (value >= '0' && value <= '9') {
+        return value - '0';
+    }
+    if (value >= 'a' && value <= 'f') {
+        return value - 'a' + 10;
+    }
+    return -1;
+}
+
+static bool crucible_lifecycle_parse_sha256(const char *text,
+                                            uint8_t digest[32])
+{
+    if (!text || strlen(text) != 64) {
+        return false;
+    }
+    for (size_t index = 0; index < 32; index++) {
+        int high = crucible_lifecycle_hex_nibble(text[index * 2]);
+        int low = crucible_lifecycle_hex_nibble(text[index * 2 + 1]);
+
+        if (high < 0 || low < 0) {
+            return false;
+        }
+        digest[index] = (high << 4) | low;
+    }
+    return true;
+}
+
