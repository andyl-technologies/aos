+CrucibleHotForkAioHandlerInventory *
+qmp_query_crucible_hot_fork_aio_handler_inventory(Error **errp)
+{
+#ifdef CONFIG_POSIX
+    CrucibleHotForkAioHandlerInventory *report =
+        g_new0(CrucibleHotForkAioHandlerInventory, 1);
+    QemuAioHandlerHotForkInventory inventory;
+    CrucibleHotForkAioHandlerList **tail = &report->handlers;
+    uint64_t previous_handler_id = 0;
+    bool valid_entries = true;
+    size_t index;
+
+    (void)errp;
+    report->schema_version = 1;
+    qemu_aio_handler_hot_fork_inventory(&inventory);
+    report->generation = inventory.generation;
+    for (index = 0; index < inventory.entry_count; index++) {
+        QemuAioHandlerHotForkInventoryEntry *source =
+            &inventory.entries[index];
+        CrucibleHotForkAioHandler *handler =
+            g_new0(CrucibleHotForkAioHandler, 1);
+        CrucibleHotForkAioHandlerList *node =
+            g_new0(CrucibleHotForkAioHandlerList, 1);
+
+        handler->handler_id = source->handler_id;
+        handler->context_id = source->context_id;
+        handler->fd = source->fd;
+        handler->deleted = source->deleted;
+        handler->read_callback = source->io_read;
+        handler->write_callback = source->io_write;
+        handler->poll_callback = source->io_poll;
+        handler->poll_ready_callback = source->io_poll_ready;
+        handler->poll_begin_callback = source->io_poll_begin;
+        handler->poll_end_callback = source->io_poll_end;
+        handler->active_callbacks = source->active_callbacks;
+        if (source->handler_id == 0 || source->context_id == 0 ||
+            source->fd < 0 ||
+            (index != 0 && source->handler_id <= previous_handler_id) ||
+            (!source->io_read && !source->io_write && !source->io_poll)) {
+            valid_entries = false;
+        }
+        previous_handler_id = source->handler_id;
+        report->read_handlers += source->io_read;
+        report->write_handlers += source->io_write;
+        report->poll_handlers += source->io_poll;
+        report->deleted_handlers += source->deleted;
+        report->active_callbacks += source->active_callbacks;
+        node->value = handler;
+        *tail = node;
+        tail = &node->next;
+    }
+    report->handler_count = inventory.entry_count;
+    report->overflowed = inventory.overflowed;
+    report->complete = !inventory.overflowed && valid_entries;
+    qemu_aio_handler_hot_fork_inventory_destroy(&inventory);
+    return report;
+#else
+    error_setg(errp, "Crucible hot-fork AIO-handler inventory requires POSIX");
+    return NULL;
+#endif
+}
