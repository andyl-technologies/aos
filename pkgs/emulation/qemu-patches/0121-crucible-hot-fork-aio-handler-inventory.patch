 /* Stop userspace polling on a handler if it isn't active for some time */
 #define POLL_IDLE_INTERVAL_NS (7 * NANOSECONDS_PER_SECOND)
 
+static QemuMutex crucible_hot_fork_aio_handler_lock;
+static QTAILQ_HEAD(, AioHandler) crucible_hot_fork_aio_handlers =
+    QTAILQ_HEAD_INITIALIZER(crucible_hot_fork_aio_handlers);
+static uint64_t crucible_hot_fork_aio_handler_next_id = 1;
+static uint64_t crucible_hot_fork_aio_handler_generation;
+
+static void __attribute__((__constructor__))
+crucible_hot_fork_aio_handler_inventory_init(void)
+{
+    qemu_mutex_init(&crucible_hot_fork_aio_handler_lock);
+}
+
+static void crucible_hot_fork_aio_handler_changed(void)
+{
+    crucible_hot_fork_aio_handler_generation++;
+}
+
+static void crucible_hot_fork_aio_handler_register(AioContext *ctx,
+                                                   AioHandler *node)
+{
+    QEMU_LOCK_GUARD(&crucible_hot_fork_aio_handler_lock);
+
+    node->crucible_hot_fork_id = crucible_hot_fork_aio_handler_next_id++;
+    assert(node->crucible_hot_fork_id != 0);
+    node->crucible_hot_fork_context_id = ctx->crucible_hot_fork_id;
+    assert(node->crucible_hot_fork_context_id != 0);
+    QTAILQ_INSERT_TAIL(&crucible_hot_fork_aio_handlers, node,
+                       crucible_hot_fork_node);
+    crucible_hot_fork_aio_handler_changed();
+}
+
+static void crucible_hot_fork_aio_handler_mark_deleted(AioHandler *node)
+{
+    QEMU_LOCK_GUARD(&crucible_hot_fork_aio_handler_lock);
+
+    if (!node->crucible_hot_fork_deleted) {
+        node->crucible_hot_fork_deleted = true;
+        crucible_hot_fork_aio_handler_changed();
+    }
+}
+
+static void crucible_hot_fork_aio_handler_update_poll(
+    AioHandler *node, IOHandler *io_poll_begin, IOHandler *io_poll_end)
+{
+    QEMU_LOCK_GUARD(&crucible_hot_fork_aio_handler_lock);
+
+    if (node->io_poll_begin != io_poll_begin ||
+        node->io_poll_end != io_poll_end) {
+        node->io_poll_begin = io_poll_begin;
+        node->io_poll_end = io_poll_end;
+        crucible_hot_fork_aio_handler_changed();
+    }
+}
+
+static void crucible_hot_fork_aio_handler_callback_begin(AioHandler *node)
+{
+    uint32_t active = qatomic_read(&node->crucible_hot_fork_active_callbacks);
+
+    /* A handler's owning AioContext serializes its callback transitions. */
+    assert(active != UINT32_MAX);
+    qatomic_set(&node->crucible_hot_fork_active_callbacks, active + 1);
+}
+
+static void crucible_hot_fork_aio_handler_callback_end(AioHandler *node)
+{
+    uint32_t active = qatomic_read(&node->crucible_hot_fork_active_callbacks);
+
+    assert(active > 0);
+    qatomic_set(&node->crucible_hot_fork_active_callbacks, active - 1);
+}
+
+static void crucible_hot_fork_aio_handler_free(AioHandler *node)
+{
+    qemu_mutex_lock(&crucible_hot_fork_aio_handler_lock);
+    QTAILQ_REMOVE(&crucible_hot_fork_aio_handlers, node,
+                  crucible_hot_fork_node);
+    crucible_hot_fork_aio_handler_changed();
+    qemu_mutex_unlock(&crucible_hot_fork_aio_handler_lock);
+    g_free(node);
+}
+
+void qemu_aio_handler_hot_fork_inventory(
+    QemuAioHandlerHotForkInventory *inventory)
+{
+    AioHandler *node;
+    size_t count = 0;
+
+    *inventory = (QemuAioHandlerHotForkInventory) { 0 };
+    QEMU_LOCK_GUARD(&crucible_hot_fork_aio_handler_lock);
+    inventory->generation = crucible_hot_fork_aio_handler_generation;
+    QTAILQ_FOREACH(node, &crucible_hot_fork_aio_handlers,
+                   crucible_hot_fork_node) {
+        if (count == QEMU_AIO_HANDLER_HOT_FORK_INVENTORY_MAX) {
+            inventory->overflowed = true;
+            break;
+        }
+        count++;
+    }
+
+    inventory->entries = g_new0(QemuAioHandlerHotForkInventoryEntry, count);
+    inventory->entry_count = count;
+    count = 0;
+    QTAILQ_FOREACH(node, &crucible_hot_fork_aio_handlers,
+                   crucible_hot_fork_node) {
+        QemuAioHandlerHotForkInventoryEntry *entry;
+
+        if (count == inventory->entry_count) {
+            break;
+        }
+        entry = &inventory->entries[count++];
+        entry->handler_id = node->crucible_hot_fork_id;
+        entry->context_id = node->crucible_hot_fork_context_id;
+        entry->fd = node->pfd.fd;
+        entry->active_callbacks =
+            qatomic_read(&node->crucible_hot_fork_active_callbacks);
+        entry->deleted = node->crucible_hot_fork_deleted;
+        entry->io_read = node->io_read != NULL;
+        entry->io_write = node->io_write != NULL;
+        entry->io_poll = node->io_poll != NULL;
+        entry->io_poll_ready = node->io_poll_ready != NULL;
+        entry->io_poll_begin = node->io_poll_begin != NULL;
+        entry->io_poll_end = node->io_poll_end != NULL;
+    }
+}
+
+void qemu_aio_handler_hot_fork_inventory_destroy(
+    QemuAioHandlerHotForkInventory *inventory)
+{
+    g_free(inventory->entries);
+    *inventory = (QemuAioHandlerHotForkInventory) { 0 };
+}
