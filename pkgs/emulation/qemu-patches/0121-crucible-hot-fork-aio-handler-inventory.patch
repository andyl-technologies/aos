+##
+# @CrucibleHotForkAioHandler:
+#
+# One allocated POSIX AioHandler in the process-local registry.
+#
+# @handler-id: positive stable process-local handler identity
+#
+# @context-id: positive process-local owning AioContext identity
+#
+# @fd: nonnegative process-local file descriptor
+#
+# @deleted: whether removal has been requested but allocation remains live
+#
+# @read-callback: whether a read callback is installed
+#
+# @write-callback: whether a write callback is installed
+#
+# @poll-callback: whether a userspace polling callback is installed
+#
+# @poll-ready-callback: whether a polling-ready callback is installed
+#
+# @poll-begin-callback: whether a polling-entry callback is installed
+#
+# @poll-end-callback: whether a polling-exit callback is installed
+#
+# @active-callbacks: number of this handler's callbacks currently executing
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'struct': 'CrucibleHotForkAioHandler',
+  'data': { 'handler-id': 'uint64',
+            'context-id': 'uint64',
+            'fd': 'int64',
+            'deleted': 'bool',
+            'read-callback': 'bool',
+            'write-callback': 'bool',
+            'poll-callback': 'bool',
+            'poll-ready-callback': 'bool',
+            'poll-begin-callback': 'bool',
+            'poll-end-callback': 'bool',
+            'active-callbacks': 'uint32' } }
+
+##
+# @CrucibleHotForkAioHandlerInventory:
+#
+# Bounded observational snapshot of every allocated POSIX AioHandler,
+# including handlers awaiting deferred deletion.  This report does not drain,
+# park, or retain an AIO-handler barrier.
+#
+# @schema-version: inventory contract version, currently 1
+#
+# @generation: monotonic process-local lifecycle and callback-set generation;
+#     active callback counts are instantaneous
+#
+# @complete: true exactly when the registry did not overflow and every entry
+#     is structurally valid
+#
+# @overflowed: whether allocated handlers exceeded the retained bound
+#
+# @handler-count: number of retained allocated handlers
+#
+# @read-handlers: retained handlers with a read callback
+#
+# @write-handlers: retained handlers with a write callback
+#
+# @poll-handlers: retained handlers with a userspace polling callback
+#
+# @deleted-handlers: retained handlers awaiting deferred deletion
+#
+# @active-callbacks: checked sum of retained @active-callbacks
+#
+# @handlers: allocated handlers sorted by @handler-id and bounded to 65536
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'struct': 'CrucibleHotForkAioHandlerInventory',
+  'data': { 'schema-version': 'uint32',
+            'generation': 'uint64',
+            'complete': 'bool',
+            'overflowed': 'bool',
+            'handler-count': 'uint32',
+            'read-handlers': 'uint32',
+            'write-handlers': 'uint32',
+            'poll-handlers': 'uint32',
+            'deleted-handlers': 'uint32',
+            'active-callbacks': 'uint64',
+            'handlers': [ 'CrucibleHotForkAioHandler' ] } }
+
+##
+# @query-crucible-hot-fork-aio-handler-inventory:
+#
+# Query every allocated POSIX AioHandler.  This command is observational and
+# cannot acknowledge the AIO/BH/timer readiness proof.
+#
+# Returns: @CrucibleHotForkAioHandlerInventory
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'command': 'query-crucible-hot-fork-aio-handler-inventory',
+  'returns': 'CrucibleHotForkAioHandlerInventory',
+  'allow-oob': true }
+
 ##
 # @CrucibleHotForkMutex:
 #
