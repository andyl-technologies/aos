+##
+# @CrucibleHotForkChildFile:
+#
+# One caller-owned empty destination for the unique originally writable
+# native leaf beneath a retained source root. Exactly one of @device and
+# @node-name selects the root.
+#
+# @device: name of the retained BlockBackend whose root owns the leaf
+#
+# @node-name: node name of a parentless retained native root
+#
+# @fdname: standard-QMP name of the empty, writable, regular destination file
+#
+# @expected-device: expected destination st_dev identity
+#
+# @expected-inode: expected destination st_ino identity
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'struct': 'CrucibleHotForkChildFile',
+  'data': { '*device': 'str',
+            '*node-name': 'str',
+            'fdname': 'str',
+            'expected-device': 'uint64',
+            'expected-inode': 'uint64' } }
+
+##
+# @CrucibleHotForkChildFilesAction:
+#
+# @stage: duplicate and authenticate every destination for one future child
+#
+# @query: observe the retained child-private file plan
+#
+# @release: close the retained duplicates after the fork outcome is known
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'enum': 'CrucibleHotForkChildFilesAction',
+  'data': [ 'stage', 'query', 'release' ] }
+
+##
+# @CrucibleHotForkChildFilesState:
+#
+# Exact one-shot child-private native file plan for a future hot-fork child.
+# Fork preparation copies every originally writable native leaf into its
+# staged destination while the sources stay frozen; the immediate child
+# adopts those copies and independent read-only descriptors before it can
+# resume.
+#
+# @schema-version: child file plan status version, currently 1
+#
+# @generation: monotonically increasing source-QEMU plan generation
+#
+# @template-generation: exact retained template generation
+#
+# @staged: whether every destination duplicate is retained
+#
+# @consumed: whether a child was created from this one-shot plan
+#
+# @maximum-bytes: aggregate logical source-byte budget for private copies
+#
+# @files: the staged destinations in stage order
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'struct': 'CrucibleHotForkChildFilesState',
+  'data': { 'schema-version': 'uint32',
+            'generation': 'uint64',
+            'template-generation': 'uint64',
+            'staged': 'bool',
+            'consumed': 'bool',
+            'maximum-bytes': 'uint64',
+            'files': [ 'CrucibleHotForkChildFile' ] } }
+
+##
+# @crucible-hot-fork-child-files:
+#
+# Stages, observes, or releases the one-shot child-private native file plan.
+# Stage duplicates every destination through standard QMP `getfd`, requires
+# each to be an empty writable regular file with the expected identity, and
+# binds the plan to the retained template. Fork preparation resolves each
+# root to its unique originally writable native leaf, copies the frozen bytes,
+# and rejects a nonempty native graph without a staged plan or a staged plan
+# without native roots. Release requires the exact retained generation and is
+# rejected during a fork operation.
+#
+# @action: stage, query, or release the child file plan
+#
+# @files: complete destination list supplied only with @stage
+#
+# @maximum-bytes: nonzero aggregate source-byte budget supplied only with
+#     @stage
+#
+# @expected-generation: exact retained plan generation supplied only with
+#     @release
+#
+# Returns: @CrucibleHotForkChildFilesState
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'command': 'crucible-hot-fork-child-files',
+  'data': { 'action': 'CrucibleHotForkChildFilesAction',
+            '*files': [ 'CrucibleHotForkChildFile' ],
+            '*maximum-bytes': 'uint64',
+            '*expected-generation': 'uint64' },
+  'returns': 'CrucibleHotForkChildFilesState',
+  'allow-oob': true }
+
