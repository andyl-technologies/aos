+CrucibleHotForkChildFilesState *qmp_crucible_hot_fork_child_files(
+    CrucibleHotForkChildFilesAction action,
+    bool has_files, CrucibleHotForkChildFileList *files,
+    bool has_maximum_bytes, uint64_t maximum_bytes,
+    bool has_expected_generation, uint64_t expected_generation,
+    Error **errp)
+{
+    CrucibleHotForkChildFilesStage *stage =
+        &crucible_hot_fork_child_files_stage;
+    CrucibleHotForkChildFilesState *report = NULL;
+    CrucibleHotForkPluginBarrierState *plugin_barrier = NULL;
+    CrucibleHotForkChildFileList *entry;
+    GArray *candidates = NULL;
+    size_t count = 0;
+
+    g_mutex_lock(&crucible_hot_fork_template_lock);
+    switch (action) {
+    case CRUCIBLE_HOT_FORK_CHILD_FILES_ACTION_STAGE:
+        for (entry = has_files ? files : NULL; entry; entry = entry->next) {
+            count++;
+        }
+        if (count == 0 || count > CRUCIBLE_HOT_FORK_CHILD_FILES_MAX ||
+            !has_maximum_bytes || maximum_bytes == 0 ||
+            maximum_bytes == UINT64_MAX || has_expected_generation) {
+            error_setg(errp, "Crucible hot-fork child files require one "
+                       "bounded destination list and byte budget");
+            goto out;
+        }
+        if (!crucible_hot_fork_template_active) {
+            error_setg(errp, "Crucible hot-fork child files require an "
+                       "active retained template");
+            goto out;
+        }
+        if (crucible_hot_fork_child_active) {
+            error_setg(errp, "A Crucible hot-fork child stages no child "
+                       "file plan");
+            goto out;
+        }
+        if (!crucible_hot_fork_resource_stage_allowed(
+                &plugin_barrier, errp)) {
+            goto out;
+        }
+        if (stage->staged) {
+            error_setg(errp, "A Crucible hot-fork child file plan is "
+                       "already staged");
+            goto out;
+        }
+        if (stage->generation == UINT64_MAX) {
+            error_setg(errp, "Crucible hot-fork child file plan generation "
+                       "is exhausted");
+            goto out;
+        }
+        candidates = g_array_new(false, true,
+                                 sizeof(CrucibleHotForkChildFileStage));
+        for (entry = files; entry; entry = entry->next) {
+            CrucibleHotForkChildFile *file = entry->value;
+            CrucibleHotForkChildFileStage candidate = { .fd = -1 };
+            struct stat status;
+            int flags;
+
+            if (!file->device == !file->node_name ||
+                (file->device && !*file->device) ||
+                (file->node_name && !*file->node_name) ||
+                !crucible_hot_fork_private_ring_fd_name_valid(file->fdname) ||
+                file->expected_device == 0 || file->expected_inode == 0) {
+                error_setg(errp, "Crucible hot-fork child file requires one "
+                           "root selector, a valid descriptor name, and a "
+                           "nonzero destination identity");
+                goto out;
+            }
+            if (crucible_hot_fork_child_file_conflicts(candidates, file)) {
+                error_setg(errp, "Crucible hot-fork child files must name "
+                           "distinct roots, descriptors, and destinations");
+                goto out;
+            }
+            candidate.fd = monitor_dup_fd(monitor_cur(), file->fdname, errp);
+            if (candidate.fd < 0) {
+                goto out;
+            }
+            flags = fcntl(candidate.fd, F_GETFL);
+            if (flags < 0 || fstat(candidate.fd, &status) < 0 ||
+                !S_ISREG(status.st_mode) || status.st_nlink != 1 ||
+                status.st_size != 0 || (flags & O_ACCMODE) != O_RDWR ||
+                (flags & O_APPEND) ||
+                (uint64_t)status.st_dev != file->expected_device ||
+                (uint64_t)status.st_ino != file->expected_inode) {
+                close(candidate.fd);
+                error_setg(errp, "Crucible hot-fork child file destination "
+                           "must be an empty writable regular file with the "
+                           "expected identity");
+                goto out;
+            }
+            candidate.device = g_strdup(file->device);
+            candidate.node_name = g_strdup(file->node_name);
+            candidate.fdname = g_strdup(file->fdname);
+            candidate.expected_device = file->expected_device;
+            candidate.expected_inode = file->expected_inode;
+            g_array_append_val(candidates, candidate);
+        }
+        stage->files = candidates;
+        candidates = NULL;
+        stage->staged = true;
+        stage->consumed = false;
+        stage->maximum_bytes = maximum_bytes;
+        stage->template_generation = crucible_hot_fork_template_generation;
+        stage->generation++;
+        report = crucible_hot_fork_child_files_report();
+        break;
+    case CRUCIBLE_HOT_FORK_CHILD_FILES_ACTION_QUERY:
+        if (has_files || has_maximum_bytes || has_expected_generation) {
+            error_setg(errp, "Crucible hot-fork child files query accepts "
+                       "no plan basis");
+            goto out;
+        }
+        report = crucible_hot_fork_child_files_report();
+        break;
+    case CRUCIBLE_HOT_FORK_CHILD_FILES_ACTION_RELEASE:
+        if (has_files || has_maximum_bytes || !has_expected_generation ||
+            !stage->staged || expected_generation != stage->generation) {
+            error_setg(errp, "Crucible hot-fork child files release requires "
+                       "the exact retained plan generation");
+            goto out;
+        }
+        if (crucible_hot_fork_operation_active) {
+            error_setg(errp, "Cannot release child files during a hot-fork "
+                       "operation");
+            goto out;
+        }
+        crucible_hot_fork_child_files_stage_clear(true);
+        report = crucible_hot_fork_child_files_report();
+        break;
+    default:
+        g_assert_not_reached();
+    }
+out:
+    crucible_hot_fork_child_file_candidates_destroy(candidates);
+    g_free(plugin_barrier);
+    g_mutex_unlock(&crucible_hot_fork_template_lock);
+    return report;
+}
