+static CrucibleHotForkChildFilesState *
+crucible_hot_fork_child_files_report(void)
+{
+    CrucibleHotForkChildFilesStage *stage =
+        &crucible_hot_fork_child_files_stage;
+    CrucibleHotForkChildFilesState *report =
+        g_new0(CrucibleHotForkChildFilesState, 1);
+    CrucibleHotForkChildFileList **tail = &report->files;
+    size_t index;
+
+    report->schema_version = 1;
+    report->generation = stage->generation;
+    report->template_generation = stage->template_generation;
+    report->staged = stage->staged;
+    report->consumed = stage->consumed;
+    report->maximum_bytes = stage->maximum_bytes;
+    for (index = 0; stage->files && index < stage->files->len; index++) {
+        CrucibleHotForkChildFileStage *file = &g_array_index(
+            stage->files, CrucibleHotForkChildFileStage, index);
+        CrucibleHotForkChildFile *entry = g_new0(CrucibleHotForkChildFile, 1);
+
+        entry->device = g_strdup(file->device);
+        entry->node_name = g_strdup(file->node_name);
+        entry->fdname = g_strdup(file->fdname);
+        entry->expected_device = file->expected_device;
+        entry->expected_inode = file->expected_inode;
+        QAPI_LIST_APPEND(tail, entry);
+    }
+    return report;
+}
