+ssize_t qemu_block_hot_fork_child_files_descriptors(
+    const QemuBlockHotForkChildFiles *plan, int *descriptors, size_t maximum)
+{
+    size_t index, count = 0;
+
+    GLOBAL_STATE_CODE();
+    if (!plan || plan->owner != getpid() || plan->consumed || !descriptors) {
+        return -1;
+    }
+    for (index = 0; index < plan->files->len; index++) {
+        const HotForkChildFileEntry *entry =
+            &g_array_index(plan->files, HotForkChildFileEntry, index);
+
+        if (maximum - count < 2) {
+            return -1;
+        }
+        descriptors[count++] = entry->source.descriptor;
+        descriptors[count++] = entry->prepared_fd;
+    }
+    return count;
+}
