+/*
+ * Runs on the source main loop inside the fork transaction, after every
+ * generation precondition held. Every frozen native root must resolve to one
+ * staged destination; the prepared plan's descriptors are excluded from the
+ * child's descriptor disposition so adoption can rebind them.
+ */
+static int crucible_hot_fork_prepare_child_files(
+    CrucibleHotForkOperation *operation)
+{
+    CrucibleHotForkChildFilesStage *stage =
+        &crucible_hot_fork_child_files_stage;
+    g_autofree QemuBlockHotForkChildFile *files = NULL;
+    g_autofree int *descriptors = NULL;
+    QemuBlockHotForkChildFiles *plan;
+    Error *local_err = NULL;
+    ssize_t count;
+    size_t index;
+
+    if (!crucible_hot_fork_child_files_bound() ||
+        operation->child_files_generation != stage->generation) {
+        return -ENOTSUP;
+    }
+    files = g_new0(QemuBlockHotForkChildFile, stage->files->len);
+    for (index = 0; index < stage->files->len; index++) {
+        CrucibleHotForkChildFileStage *file = &g_array_index(
+            stage->files, CrucibleHotForkChildFileStage, index);
+        BlockDriverState *root =
+            bdrv_lookup_bs(file->device, file->node_name, NULL);
+        struct stat status;
+
+        if (!root ||
+            !qemu_block_hot_fork_source_set_writable_leaf(
+                crucible_hot_fork_template_sources, root,
+                &files[index].node, NULL) ||
+            fstat(file->fd, &status) < 0 ||
+            (uint64_t)status.st_dev != file->expected_device ||
+            (uint64_t)status.st_ino != file->expected_inode) {
+            return -ENOENT;
+        }
+        files[index].descriptor = file->fd;
+    }
+    plan = qemu_block_hot_fork_child_files_prepare(
+        crucible_hot_fork_template_sources, files, stage->files->len,
+        stage->maximum_bytes, NULL);
+    if (!plan) {
+        return -EIO;
+    }
+    descriptors = g_new0(int, QEMU_CRUCIBLE_HOT_FORK_MAX_RETAINED_DESCRIPTORS);
+    count = qemu_block_hot_fork_child_files_descriptors(
+        plan, descriptors, QEMU_CRUCIBLE_HOT_FORK_MAX_RETAINED_DESCRIPTORS);
+    for (index = 0; count >= 0 && index < (size_t)count; index++) {
+        if (crucible_hot_fork_operation_add_excluded_fd(
+                operation, descriptors[index]) != 0) {
+            count = -1;
+        }
+    }
+    if (count < 0) {
+        if (!qemu_block_hot_fork_child_files_free(plan, &local_err)) {
+            error_free(local_err);
+        }
+        return -E2BIG;
+    }
+    operation->child_files = plan;
+    crucible_hot_fork_child_files_plan = plan;
+    return 0;
+}
