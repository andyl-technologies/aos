+bool qemu_block_hot_fork_source_set_writable_leaf(
+    const QemuBlockHotForkSourceSet *set, BlockDriverState *root,
+    BlockDriverState **leaf, Error **errp)
+{
+    QemuBlockBackendHotForkReadOnlySource *source = NULL;
+    size_t index, visit, found = 0;
+
+    GLOBAL_STATE_CODE();
+    if (!leaf) {
+        error_setg(errp, "Crucible writable leaf lookup requires a result");
+        return false;
+    }
+    *leaf = NULL;
+    if (!set || set->owner != getpid() || !root) {
+        error_setg(errp, "Crucible source set does not own the requested root");
+        return false;
+    }
+    for (index = 0; index < set->sources->len; index++) {
+        QemuBlockBackendHotForkReadOnlySource *candidate =
+            g_ptr_array_index(set->sources, index);
+
+        if (candidate->root == root) {
+            source = candidate;
+            break;
+        }
+    }
+    if (!source) {
+        error_setg(errp, "Crucible source set does not own the requested root");
+        return false;
+    }
+    if (!source_matches(source, errp)) {
+        return false;
+    }
+    for (visit = 0; visit < source->graph->len; visit++) {
+        ReadOnlySourceNode *node =
+            &g_array_index(source->graph, ReadOnlySourceNode, visit);
+
+        if (node->file_pinned && !node->file.read_only) {
+            *leaf = node->node;
+            found++;
+        }
+    }
+    if (found != 1) {
+        *leaf = NULL;
+        error_setg(errp, "Crucible source root does not own exactly one "
+                   "originally writable native leaf");
+        return false;
+    }
+    return true;
+}
