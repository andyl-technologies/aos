+static void crucible_hot_fork_child_file_candidates_destroy(GArray *candidates)
+{
+    size_t index;
+
+    if (!candidates) {
+        return;
+    }
+    for (index = 0; index < candidates->len; index++) {
+        CrucibleHotForkChildFileStage *file =
+            &g_array_index(candidates, CrucibleHotForkChildFileStage, index);
+
+        if (file->fd >= 0) {
+            close(file->fd);
+        }
+        g_free(file->device);
+        g_free(file->node_name);
+        g_free(file->fdname);
+    }
+    g_array_free(candidates, true);
+}
+
+static bool crucible_hot_fork_child_file_conflicts(
+    const GArray *candidates, const CrucibleHotForkChildFile *file)
+{
+    size_t index;
+
+    for (index = 0; index < candidates->len; index++) {
+        const CrucibleHotForkChildFileStage *prior =
+            &g_array_index(candidates, CrucibleHotForkChildFileStage, index);
+
+        if (strcmp(prior->fdname, file->fdname) == 0 ||
+            (prior->expected_device == file->expected_device &&
+             prior->expected_inode == file->expected_inode) ||
+            (file->device && prior->device &&
+             strcmp(prior->device, file->device) == 0) ||
+            (file->node_name && prior->node_name &&
+             strcmp(prior->node_name, file->node_name) == 0)) {
+            return true;
+        }
+    }
+    return false;
+}
