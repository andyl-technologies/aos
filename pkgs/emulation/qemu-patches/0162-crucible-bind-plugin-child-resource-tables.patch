+static void crucible_hot_fork_sort_three_fds(int fds[3])
+{
+    int temporary;
+
+    if (fds[0] > fds[1]) {
+        temporary = fds[0];
+        fds[0] = fds[1];
+        fds[1] = temporary;
+    }
+    if (fds[1] > fds[2]) {
+        temporary = fds[1];
+        fds[1] = fds[2];
+        fds[2] = temporary;
+    }
+    if (fds[0] > fds[1]) {
+        temporary = fds[0];
+        fds[0] = fds[1];
+        fds[1] = temporary;
+    }
+}
+
+int qemu_crucible_hot_fork_prepare_plugin_child_resources(
+    QemuCrucibleHotForkPluginChildResourcePlan *resources,
+    const struct qemu_plugin_crucible_hot_fork_child_plan *plan,
+    int control_source_fd, int wake_source_fd)
+{
+    QemuCrucibleHotForkPluginChildResourcePlan prepared = { 0 };
+
+    if (!resources ||
+        !qemu_crucible_hot_fork_plugin_child_plan_valid(plan) ||
+        control_source_fd < 0 || wake_source_fd < 0 ||
+        control_source_fd == wake_source_fd ||
+        control_source_fd == plan->private_ring_fd ||
+        control_source_fd == plan->control_fd ||
+        control_source_fd == plan->wake_fd ||
+        wake_source_fd == plan->private_ring_fd ||
+        wake_source_fd == plan->control_fd ||
+        wake_source_fd == plan->wake_fd) {
+        return -EINVAL;
+    }
+
+    prepared.plan = *plan;
+    prepared.replacements[0] = (QemuCrucibleHotForkDescriptorReplacement) {
+        .source_fd = control_source_fd,
+        .target_fd = plan->control_fd,
+    };
+    prepared.replacements[1] = (QemuCrucibleHotForkDescriptorReplacement) {
+        .source_fd = wake_source_fd,
+        .target_fd = plan->wake_fd,
+    };
+    prepared.retained_fds[0] = plan->private_ring_fd;
+    prepared.retained_fds[1] = plan->control_fd;
+    prepared.retained_fds[2] = plan->wake_fd;
+    crucible_hot_fork_sort_three_fds(prepared.retained_fds);
+    prepared.shared_mappings[0] = (QemuCrucibleHotForkSharedMapping) {
+        .start = plan->source_mapping_start,
+        .length = plan->source_mapping_length,
+        .offset = plan->source_mapping_offset,
+        .backing_fd = plan->private_ring_fd,
+    };
+    prepared.prepared = true;
+    *resources = prepared;
+    return 0;
+}
+
+bool qemu_crucible_hot_fork_plugin_child_resources_prepared_for(
+    const QemuCrucibleHotForkPluginChildResourcePlan *resources,
+    const struct qemu_plugin_crucible_hot_fork_child_plan *plan,
+    int control_source_fd, int wake_source_fd)
+{
+    QemuCrucibleHotForkPluginChildResourcePlan expected = { 0 };
+
+    return resources && resources->prepared &&
+        qemu_crucible_hot_fork_prepare_plugin_child_resources(
+            &expected, plan, control_source_fd, wake_source_fd) == 0 &&
+        crucible_hot_fork_plugin_child_plans_equal(
+            &resources->plan, &expected.plan) &&
+        resources->replacements[0].source_fd ==
+            expected.replacements[0].source_fd &&
+        resources->replacements[0].target_fd ==
+            expected.replacements[0].target_fd &&
+        resources->replacements[1].source_fd ==
+            expected.replacements[1].source_fd &&
+        resources->replacements[1].target_fd ==
+            expected.replacements[1].target_fd &&
+        resources->retained_fds[0] == expected.retained_fds[0] &&
+        resources->retained_fds[1] == expected.retained_fds[1] &&
+        resources->retained_fds[2] == expected.retained_fds[2] &&
+        resources->shared_mappings[0].start ==
+            expected.shared_mappings[0].start &&
+        resources->shared_mappings[0].length ==
+            expected.shared_mappings[0].length &&
+        resources->shared_mappings[0].offset ==
+            expected.shared_mappings[0].offset &&
+        resources->shared_mappings[0].backing_fd ==
+            expected.shared_mappings[0].backing_fd;
+}
