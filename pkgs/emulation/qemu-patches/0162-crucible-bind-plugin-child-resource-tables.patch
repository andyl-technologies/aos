+static void test_plugin_child_resource_plan_is_exact(void)
+{
+    uint64_t page_size = qemu_real_host_page_size();
+    struct qemu_plugin_crucible_hot_fork_child_plan plan = {
+        .schema_version = QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PLAN_VERSION,
+        .struct_size = sizeof(plan),
+        .parent_process_generation = 10,
+        .child_process_generation = 11,
+        .template_generation = 1,
+        .private_ring_generation = 2,
+        .plugin_endpoint_generation = 3,
+        .plugin_barrier_generation = 4,
+        .control_socket_cookie = 5,
+        .wake_eventfd_id = 6,
+        .shmem_device = 7,
+        .shmem_inode = 8,
+        .shmem_length = page_size,
+        .source_mapping_start = page_size,
+        .source_mapping_length = page_size,
+        .source_mapping_offset = 0,
+        .private_ring_fd = 7,
+        .control_fd = 3,
+        .wake_fd = 5,
+        .reserved_fd = -1,
+        .worker_mask = QEMU_PLUGIN_CRUCIBLE_WORKER_REQUIRED,
+    };
+    QemuCrucibleHotForkPluginChildResourcePlan resources;
+    struct qemu_plugin_crucible_hot_fork_child_plan foreign_plan;
+
+    g_assert_cmpint(qemu_crucible_hot_fork_prepare_plugin_child_resources(
+                        &resources, &plan, 31, 32),
+                    ==, 0);
+    g_assert_cmpint(resources.replacements[0].source_fd, ==, 31);
+    g_assert_cmpint(resources.replacements[0].target_fd, ==, 3);
+    g_assert_cmpint(resources.replacements[1].source_fd, ==, 32);
+    g_assert_cmpint(resources.replacements[1].target_fd, ==, 5);
+    g_assert_cmpint(resources.retained_fds[0], ==, 3);
+    g_assert_cmpint(resources.retained_fds[1], ==, 5);
+    g_assert_cmpint(resources.retained_fds[2], ==, 7);
+    g_assert_cmpuint(resources.shared_mappings[0].start, ==, page_size);
+    g_assert_cmpuint(resources.shared_mappings[0].length, ==, page_size);
+    g_assert_cmpuint(resources.shared_mappings[0].offset, ==, 0);
+    g_assert_cmpint(resources.shared_mappings[0].backing_fd, ==, 7);
+    g_assert_true(qemu_crucible_hot_fork_plugin_child_resources_prepared_for(
+        &resources, &plan, 31, 32));
+    g_assert_false(qemu_crucible_hot_fork_plugin_child_resources_prepared_for(
+        &resources, &plan, 32, 31));
+
+    foreign_plan = plan;
+    foreign_plan.plugin_endpoint_generation++;
+    g_assert_false(qemu_crucible_hot_fork_plugin_child_resources_prepared_for(
+        &resources, &foreign_plan, 31, 32));
+    resources.retained_fds[0] = 4;
+    g_assert_false(qemu_crucible_hot_fork_plugin_child_resources_prepared_for(
+        &resources, &plan, 31, 32));
+    qemu_crucible_hot_fork_reset_plugin_child_resources(&resources);
+    g_assert_false(qemu_crucible_hot_fork_plugin_child_resources_prepared_for(
+        &resources, &plan, 31, 32));
+    g_assert_cmpint(qemu_crucible_hot_fork_prepare_plugin_child_resources(
+                        &resources, &plan, plan.private_ring_fd, 32),
+                    ==, -EINVAL);
+}
