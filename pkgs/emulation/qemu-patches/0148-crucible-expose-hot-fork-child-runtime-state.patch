+CrucibleHotForkChildRuntimeState *
+qmp_query_crucible_hot_fork_child_runtime(Error **errp)
+{
+    CrucibleHotForkChildRuntimeState *report = NULL;
+    QemuPluginCrucibleHotForkChildRuntimeInventory runtime;
+    QemuPluginCrucibleHotForkInventory resources;
+    const struct qemu_plugin_crucible_hot_fork_child_status *status;
+    int result;
+
+    g_mutex_lock(&crucible_hot_fork_template_lock);
+    result = qemu_plugin_crucible_hot_fork_child_runtime(
+        QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_QUERY, NULL, &runtime);
+    if (result != 0) {
+        error_setg_errno(errp, -result,
+                         "Crucible hot-fork child-runtime query failed");
+        goto out;
+    }
+    qemu_plugin_crucible_hot_fork_inventory(&resources);
+    if (runtime.registered &&
+        (!runtime.manifest_consistent || !resources.complete ||
+         resources.manifest.plugin_id != runtime.plugin_id ||
+         resources.manifest.process_generation == 0)) {
+        error_setg(errp, "Crucible hot-fork child runtime is not bound to "
+                   "one complete plugin resource manifest");
+        goto out;
+    }
+
+    report = g_new0(CrucibleHotForkChildRuntimeState, 1);
+    status = &runtime.status;
+    report->schema_version =
+        QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_STATUS_VERSION;
+    report->generation = runtime.generation;
+    report->registered = runtime.registered;
+    report->manifest_consistent = runtime.manifest_consistent;
+    report->plugin_id = runtime.registered ? runtime.plugin_id : 0;
+    report->process_generation = runtime.manifest_consistent ?
+        resources.manifest.process_generation : 0;
+    switch (status->phase) {
+    case QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PHASE_TEMPLATE:
+        report->phase = CRUCIBLE_HOT_FORK_CHILD_RUNTIME_PHASE_TEMPLATE;
+        break;
+    case QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PHASE_INITIALIZING:
+        report->phase = CRUCIBLE_HOT_FORK_CHILD_RUNTIME_PHASE_INITIALIZING;
+        break;
+    case QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PHASE_WORKERS_HELD:
+        report->phase = CRUCIBLE_HOT_FORK_CHILD_RUNTIME_PHASE_WORKERS_HELD;
+        break;
+    case QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PHASE_ACTIVE:
+        report->phase = CRUCIBLE_HOT_FORK_CHILD_RUNTIME_PHASE_ACTIVE;
+        break;
+    case QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PHASE_FAILED:
+        report->phase = CRUCIBLE_HOT_FORK_CHILD_RUNTIME_PHASE_FAILED;
+        break;
+    default:
+        g_assert_not_reached();
+    }
+    report->callbacks_held = (status->flags &
+        QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_CALLBACKS_HELD) != 0;
+    report->mapping_installed = (status->flags &
+        QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_MAPPING_INSTALLED) != 0;
+    report->workers_ready = (status->flags &
+        QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_WORKERS_READY) != 0;
+    report->active = (status->flags &
+        QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_ACTIVE) != 0;
+    report->failed = (status->flags &
+        QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_FAILED) != 0;
+    report->parent_process_generation = status->parent_process_generation;
+    report->child_process_generation = status->child_process_generation;
+    report->template_generation = status->template_generation;
+    report->private_ring_generation = status->private_ring_generation;
+    report->plugin_endpoint_generation =
+        status->plugin_endpoint_generation;
+    report->plugin_barrier_generation = status->plugin_barrier_generation;
+    report->control_socket_cookie = status->control_socket_cookie;
+    report->wake_eventfd_id = status->wake_eventfd_id;
+    report->worker_mask = status->worker_mask;
+    report->parked_worker_mask = status->parked_worker_mask;
+    report->pending_worker_mask = status->pending_worker_mask;
+    report->worker_operations_in_flight =
+        status->worker_operations_in_flight;
+    report->readiness_proof_acknowledged = false;
+out:
+    g_mutex_unlock(&crucible_hot_fork_template_lock);
+    return report;
+}
