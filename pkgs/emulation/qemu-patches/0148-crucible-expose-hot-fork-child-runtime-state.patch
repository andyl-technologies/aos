+##
+# @CrucibleHotForkChildRuntimePhase:
+#
+# Process-local phase reported by the registered fork-child reinitializer.
+#
+# @template: the template process has not installed a child resource plan
+#
+# @initializing: child reconstruction has started but is not complete
+#
+# @workers-held: the private mapping and replacement workers are installed
+#     behind their inherited holds
+#
+# @active: child admission was released into ordinary execution
+#
+# @failed: child reconstruction failed closed
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'enum': 'CrucibleHotForkChildRuntimePhase',
+  'data': [ 'template', 'initializing', 'workers-held', 'active', 'failed' ] }
+
+##
+# @CrucibleHotForkChildRuntimeState:
+#
+# Exact QEMU-owned observation of the registered plugin child-runtime
+# operation. Querying invokes only the operation's observational action; it
+# does not fork, install resources, release admission, or acknowledge proof
+# bit 8.
+#
+# @schema-version: child-runtime status contract version, currently 2
+#
+# @generation: process-local registration/status mutation generation
+#
+# @registered: whether one process-lifetime child-runtime callback is installed
+#
+# @manifest-consistent: whether the callback and complete resource manifest
+#     name the same plugin
+#
+# @plugin-id: nonzero plugin identity while registered, otherwise zero
+#
+# @process-generation: exact current manifest process generation while the
+#     runtime is manifest-consistent, otherwise zero
+#
+# @phase: current child-runtime phase
+#
+# @callbacks-held: whether inherited callback admission remains held
+#
+# @mapping-installed: whether the branch-private setup mapping is installed
+#
+# @workers-ready: whether every sealed child worker is recreated and held
+#
+# @active: whether child admission was released; equivalent to @phase active
+#
+# @failed: whether reconstruction failed; equivalent to @phase failed
+#
+# @parent-process-generation: exact parent generation accepted by a child
+#     transition, or zero in the template phase
+#
+# @child-process-generation: checked immediate successor installed in the
+#     child, or zero in the template phase
+#
+# @template-generation: exact source template generation, or zero before
+#     child initialization
+#
+# @private-ring-generation: exact staged private-ring generation, or zero
+#     before child initialization
+#
+# @plugin-endpoint-generation: exact staged endpoint generation, or zero
+#     before child initialization
+#
+# @plugin-barrier-generation: exact inherited barrier generation, or zero
+#     before child initialization
+#
+# @control-socket-cookie: authenticated replacement socket identity, or zero
+#     before child initialization
+#
+# @wake-eventfd-id: authenticated replacement eventfd identity, or zero before
+#     child initialization
+#
+# @worker-mask: complete sealed process-worker mask
+#
+# @parked-worker-mask: worker classes parked at an operation boundary
+#
+# @pending-worker-mask: parked workers retaining one pre-admission item
+#
+# @worker-operations-in-flight: admitted worker operations not yet returned
+#
+# @readiness-proof-acknowledged: always false; registration and observation do
+#     not prove every QEMU child reinitializer
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'struct': 'CrucibleHotForkChildRuntimeState',
+  'data': { 'schema-version': 'uint32',
+            'generation': 'uint64',
+            'registered': 'bool',
+            'manifest-consistent': 'bool',
+            'plugin-id': 'uint64',
+            'process-generation': 'uint64',
+            'phase': 'CrucibleHotForkChildRuntimePhase',
+            'callbacks-held': 'bool',
+            'mapping-installed': 'bool',
+            'workers-ready': 'bool',
+            'active': 'bool',
+            'failed': 'bool',
+            'parent-process-generation': 'uint64',
+            'child-process-generation': 'uint64',
+            'template-generation': 'uint64',
+            'private-ring-generation': 'uint64',
+            'plugin-endpoint-generation': 'uint64',
+            'plugin-barrier-generation': 'uint64',
+            'control-socket-cookie': 'uint64',
+            'wake-eventfd-id': 'uint64',
+            'worker-mask': 'uint64',
+            'parked-worker-mask': 'uint64',
+            'pending-worker-mask': 'uint64',
+            'worker-operations-in-flight': 'uint64',
+            'readiness-proof-acknowledged': 'bool' } }
+
+##
+# @query-crucible-hot-fork-child-runtime:
+#
+# Observes the exact registered plugin child-runtime operation and its resource
+# manifest binding. The command never initializes or releases a child.
+#
+# Returns: @CrucibleHotForkChildRuntimeState
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'command': 'query-crucible-hot-fork-child-runtime',
+  'returns': 'CrucibleHotForkChildRuntimeState',
+  'allow-oob': true }
+
 ##
 # @CrucibleHotForkRcuBarrierAction:
 #
