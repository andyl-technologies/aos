+static int crucible_hot_fork_finish_parent_operation(
+    pid_t child_pid, void *opaque)
+{
+    CrucibleHotForkOperation *operation = opaque;
+    int result;
+
+    (void)child_pid;
+    if (!operation || !operation->prepared) {
+        return -EINVAL;
+    }
+    result = qemu_crucible_hot_fork_release_parent_runtime_transaction(
+        &operation->runtime);
+    qemu_crucible_hot_fork_release_parent_identity(
+        &operation->parent_identity);
+    operation->prepared = false;
+    return result;
+}
