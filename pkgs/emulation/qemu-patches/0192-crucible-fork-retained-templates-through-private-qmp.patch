+static int crucible_hot_fork_finish_child_operation(void *opaque)
+{
+    CrucibleHotForkOperation *operation = opaque;
+    QemuCrucibleHotForkDescriptorTableTransaction descriptors = { 0 };
+    QemuCrucibleHotForkDescriptorTableProof proof = { 0 };
+    QemuCrucibleHotForkChildResourcePlan resources = { 0 };
+    QemuBlockBackendHotForkBarrierInventory block = { 0 };
+    int result;
+
+    if (!operation || !operation->prepared) {
+        return -EINVAL;
+    }
+    result = qemu_crucible_hot_fork_begin_descriptor_table(
+        &operation->parent_identity, &descriptors);
+    if (result == 0) {
+        result = qemu_crucible_hot_fork_reconstruct_child_runtime(
+            &operation->runtime, &descriptors);
+    }
+    if (result == 0) {
+        result = qemu_crucible_hot_fork_begin_child_resource_plan(
+            &resources, &operation->plugin_resources);
+    }
+    if (result == 0) {
+        result = qemu_crucible_hot_fork_merge_diagnostics_child_resources(
+            &resources, &operation->diagnostics_resources);
+    }
+    if (result == 0) {
+        result = qemu_crucible_hot_fork_merge_qmp_child_resources(
+            &resources, &operation->qmp_resources);
+    }
+    if (result == 0) {
+        result = qemu_crucible_hot_fork_complete_child_resource_plan(
+            &resources, &descriptors, operation->excluded_fds,
+            operation->excluded_fd_count, &proof);
+    }
+    if (result == 0) {
+        result = qemu_crucible_hot_fork_apply_child_runtime_resource_plan(
+            &resources, &descriptors, &operation->runtime,
+            qemu_crucible_hot_fork_verify_child_descriptor_table, &proof,
+            &operation->plugin_reinitializer,
+            &operation->qmp_reinitializer);
+    }
+    if (result == 0) {
+        result = qemu_crucible_hot_fork_activate_plugin_child(
+            &operation->plugin_reinitializer);
+    }
+    if (result == 0 &&
+        (!qemu_block_backend_hot_fork_barrier(
+             QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_RELEASE, &block) ||
+         block.held || block.snapshot_bound)) {
+        result = -EPROTO;
+    }
+    qemu_block_backend_hot_fork_barrier_inventory_destroy(&block);
+    if (result != 0) {
+        return result;
+    }
+
+    crucible_hot_fork_child_resource_plan = resources;
+    crucible_hot_fork_plugin_child_reinitializer =
+        operation->plugin_reinitializer;
+    crucible_hot_fork_qmp_child_basis = operation->monitor_basis;
+    crucible_hot_fork_qmp_child_reinitializer =
+        operation->qmp_reinitializer;
+    crucible_hot_fork_qmp_child_reinitializer.runtime_opaque =
+        &crucible_hot_fork_qmp_child_basis;
+    g_clear_pointer(&crucible_hot_fork_template_snapshot_bindings, g_free);
+    crucible_hot_fork_template_snapshot_binding_count = 0;
+    crucible_hot_fork_template_active = false;
+    crucible_hot_fork_template_abort_requested = false;
+    crucible_hot_fork_template_block_transition_scheduled = false;
+    crucible_hot_fork_template_phase =
+        CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_IDLE;
+    crucible_hot_fork_operation_active = false;
+    crucible_hot_fork_child_active = true;
+    operation->prepared = false;
+
+    return monitor_hot_fork_release_child_protocol_input(
+        &crucible_hot_fork_qmp_child_basis);
+}
+
+CrucibleHotForkState *qmp_crucible_hot_fork(
+    uint64_t template_generation, uint64_t private_ring_generation,
+    uint64_t diagnostic_generation, uint64_t qmp_generation,
+    uint64_t monitor_generation, uint64_t plugin_endpoint_generation,
+    uint64_t plugin_barrier_generation, uint64_t rcu_barrier_generation,
+    uint64_t bh_timer_barrier_generation,
+    uint64_t block_barrier_generation,
+    uint64_t parent_process_generation, uint64_t child_process_generation,
+    Error **errp)
+{
+    CrucibleHotForkOperation operation = {
+        .template_generation = template_generation,
+        .private_ring_generation = private_ring_generation,
+        .diagnostic_generation = diagnostic_generation,
+        .qmp_generation = qmp_generation,
+        .monitor_generation = monitor_generation,
+        .plugin_endpoint_generation = plugin_endpoint_generation,
+        .plugin_barrier_generation = plugin_barrier_generation,
+        .rcu_barrier_generation = rcu_barrier_generation,
+        .bh_timer_barrier_generation = bh_timer_barrier_generation,
+        .block_barrier_generation = block_barrier_generation,
+        .parent_process_generation = parent_process_generation,
+        .child_process_generation = child_process_generation,
+        .parent_identity = { .parent_pid = -1, .parent_pidfd = -1 },
+    };
+    QemuCrucibleHotForkMainLoopOperation request = {
+        .prepare = crucible_hot_fork_prepare_operation,
+        .parent = crucible_hot_fork_finish_parent_operation,
+        .child = crucible_hot_fork_finish_child_operation,
+        .opaque = &operation,
+    };
+    CrucibleHotForkState *report;
+    pid_t child_pid = -1;
+    int result;
+
+    g_mutex_lock(&crucible_hot_fork_template_lock);
+    if (crucible_hot_fork_operation_active) {
+        g_mutex_unlock(&crucible_hot_fork_template_lock);
+        error_setg(errp, "A Crucible hot-fork operation is already active");
+        return NULL;
+    }
+    crucible_hot_fork_operation_active = true;
+    g_mutex_unlock(&crucible_hot_fork_template_lock);
+
+    result = qemu_crucible_hot_fork_main_loop_fork(&request, &child_pid);
+
+    g_mutex_lock(&crucible_hot_fork_template_lock);
+    crucible_hot_fork_operation_active = false;
+    g_mutex_unlock(&crucible_hot_fork_template_lock);
+    if (child_pid <= 0) {
+        error_setg_errno(errp, result < 0 ? -result : EPROTO,
+                         "Could not complete Crucible hot-fork preparation");
+        return NULL;
+    }
+
+    report = g_new0(CrucibleHotForkState, 1);
+    report->schema_version = 1;
+    report->outcome = result == 0 ?
+        CRUCIBLE_HOT_FORK_OUTCOME_FORKED :
+        CRUCIBLE_HOT_FORK_OUTCOME_PARENT_DISPOSITION_FAILED;
+    report->parent_status = result;
+    report->child_pid = child_pid;
+    report->template_generation = template_generation;
+    report->private_ring_generation = private_ring_generation;
+    report->diagnostic_generation = diagnostic_generation;
+    report->qmp_generation = qmp_generation;
+    report->monitor_generation = monitor_generation;
+    report->plugin_endpoint_generation = plugin_endpoint_generation;
+    report->plugin_barrier_generation = plugin_barrier_generation;
+    report->rcu_barrier_generation = rcu_barrier_generation;
+    report->bh_timer_barrier_generation = bh_timer_barrier_generation;
+    report->block_barrier_generation = block_barrier_generation;
+    report->parent_process_generation = parent_process_generation;
+    report->child_process_generation = child_process_generation;
+    return report;
+}
