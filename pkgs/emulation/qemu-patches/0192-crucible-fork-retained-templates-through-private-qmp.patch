+static int crucible_hot_fork_operation_add_excluded_fd(
+    CrucibleHotForkOperation *operation, int descriptor)
+{
+    size_t index = 0;
+
+    if (!operation || descriptor < 0) {
+        return -EINVAL;
+    }
+    while (index < operation->excluded_fd_count &&
+           operation->excluded_fds[index] < descriptor) {
+        index++;
+    }
+    if (index < operation->excluded_fd_count &&
+        operation->excluded_fds[index] == descriptor) {
+        return -EINVAL;
+    }
+    if (operation->excluded_fd_count ==
+        QEMU_CRUCIBLE_HOT_FORK_MAX_RETAINED_DESCRIPTORS) {
+        return -E2BIG;
+    }
+    memmove(&operation->excluded_fds[index + 1],
+            &operation->excluded_fds[index],
+            (operation->excluded_fd_count - index) *
+                sizeof(operation->excluded_fds[0]));
+    operation->excluded_fds[index] = descriptor;
+    operation->excluded_fd_count++;
+    return 0;
+}
