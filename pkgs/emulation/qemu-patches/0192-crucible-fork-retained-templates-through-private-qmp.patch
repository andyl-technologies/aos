+static bool crucible_hot_fork_parse_descriptor_name(
+    const char *name, int *descriptor)
+{
+    uint64_t value = 0;
+
+    if (!name || !descriptor || name[0] == '\0') {
+        return false;
+    }
+    for (size_t index = 0; name[index] != '\0'; index++) {
+        unsigned char byte = name[index];
+
+        if (!qemu_isdigit(byte) || value > (INT_MAX - (byte - '0')) / 10) {
+            return false;
+        }
+        value = value * 10 + (byte - '0');
+    }
+    *descriptor = value;
+    return true;
+}
+
+static bool crucible_hot_fork_insert_descriptor(
+    int *descriptors, size_t *count, int descriptor)
+{
+    size_t index;
+
+    if (!descriptors || !count || descriptor < 0 ||
+        *count >= QEMU_CRUCIBLE_HOT_FORK_MAX_RETAINED_DESCRIPTORS) {
+        return false;
+    }
+    for (index = 0; index < *count && descriptors[index] < descriptor;
+         index++) {
+    }
+    if (index < *count && descriptors[index] == descriptor) {
+        return true;
+    }
+    memmove(&descriptors[index + 1], &descriptors[index],
+            (*count - index) * sizeof(*descriptors));
+    descriptors[index] = descriptor;
+    (*count)++;
+    return true;
+}
+
+static int crucible_hot_fork_scan_child_descriptors(
+    int descriptors[QEMU_CRUCIBLE_HOT_FORK_MAX_RETAINED_DESCRIPTORS],
+    size_t *descriptor_count)
+{
+#ifdef __linux__
+    char buffer[4096];
+    int directory_fd;
+    int result = 0;
+
+    if (!descriptors || !descriptor_count) {
+        return -EINVAL;
+    }
+    *descriptor_count = 0;
+    directory_fd = open("/proc/self/fd", O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+    if (directory_fd < 0) {
+        return -errno;
+    }
+    for (;;) {
+        long length = syscall(SYS_getdents64, directory_fd,
+                              buffer, sizeof(buffer));
+        size_t offset = 0;
+
+        if (length < 0) {
+            if (errno == EINTR) {
+                continue;
+            }
+            result = -errno;
+            break;
+        }
+        if (length == 0) {
+            break;
+        }
+        while (offset < (size_t)length) {
+            QemuCrucibleLinuxDirent64 *entry =
+                (QemuCrucibleLinuxDirent64 *)&buffer[offset];
+            size_t header = offsetof(QemuCrucibleLinuxDirent64, name);
+            size_t name_bytes;
+            int descriptor;
+
+            if (entry->record_length < header + 2 ||
+                entry->record_length > (size_t)length - offset) {
+                result = -EPROTO;
+                goto out;
+            }
+            name_bytes = entry->record_length - header;
+            if (!memchr(entry->name, '\0', name_bytes)) {
+                result = -EPROTO;
+                goto out;
+            }
+            if (strcmp(entry->name, ".") != 0 &&
+                strcmp(entry->name, "..") != 0 &&
+                (!crucible_hot_fork_parse_descriptor_name(
+                     entry->name, &descriptor) ||
+                 (descriptor != directory_fd &&
+                  !crucible_hot_fork_insert_descriptor(
+                      descriptors, descriptor_count, descriptor)))) {
+                result = *descriptor_count >=
+                    QEMU_CRUCIBLE_HOT_FORK_MAX_RETAINED_DESCRIPTORS ?
+                    -E2BIG : -EPROTO;
+                goto out;
+            }
+            offset += entry->record_length;
+        }
+    }
+out:
+    close(directory_fd);
+    return result;
+#else
+    return -ENOTSUP;
+#endif
+}
