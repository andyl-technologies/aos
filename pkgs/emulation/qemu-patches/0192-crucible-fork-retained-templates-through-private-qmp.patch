+static const QemuCrucibleHotForkDescriptorReplacement *
+crucible_hot_fork_replacement_for_target(
+    const QemuCrucibleHotForkChildResourcePlan *resources, int target)
+{
+    for (size_t index = 0; index < resources->replacement_count; index++) {
+        if (resources->replacements[index].target_fd == target) {
+            return &resources->replacements[index];
+        }
+    }
+    return NULL;
+}
+
+static bool crucible_hot_fork_replacement_source(
+    const QemuCrucibleHotForkChildResourcePlan *resources, int descriptor)
+{
+    for (size_t index = 0; index < resources->replacement_count; index++) {
+        if (resources->replacements[index].source_fd == descriptor) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static int crucible_hot_fork_capture_descriptor_identity(
+    int identity_fd, int descriptor_flags_fd,
+    QemuCrucibleHotForkRetainedDescriptorIdentity *identity)
+{
+    struct stat metadata;
+    int status_flags;
+    int descriptor_flags;
+
+    if (identity_fd < 0 || descriptor_flags_fd < 0 || !identity ||
+        fstat(identity_fd, &metadata) != 0) {
+        return errno != 0 ? -errno : -EINVAL;
+    }
+    status_flags = fcntl(identity_fd, F_GETFL);
+    if (status_flags < 0) {
+        return -errno;
+    }
+    descriptor_flags = fcntl(descriptor_flags_fd, F_GETFD);
+    if (descriptor_flags < 0) {
+        return -errno;
+    }
+    *identity = (QemuCrucibleHotForkRetainedDescriptorIdentity) {
+        .fd = descriptor_flags_fd,
+        .device = metadata.st_dev,
+        .inode = metadata.st_ino,
+        .mode = metadata.st_mode,
+        .special_device = metadata.st_rdev,
+        .status_flags = status_flags,
+        .descriptor_flags = descriptor_flags,
+    };
+    return 0;
+}
+
+int qemu_crucible_hot_fork_complete_child_resource_plan(
+    QemuCrucibleHotForkChildResourcePlan *resources,
+    const QemuCrucibleHotForkDescriptorTableTransaction *transaction,
+    const int *excluded_fds, size_t excluded_fd_count,
+    QemuCrucibleHotForkDescriptorTableProof *proof)
+{
+    int live[QEMU_CRUCIBLE_HOT_FORK_MAX_RETAINED_DESCRIPTORS];
+    int retained[QEMU_CRUCIBLE_HOT_FORK_MAX_RETAINED_DESCRIPTORS];
+    size_t live_count = 0;
+    size_t retained_count = 0;
+    int result;
+
+    if (!resources || !transaction || !proof || proof->prepared ||
+        !resources->building || resources->sealed || resources->attempted ||
+        resources->applied || !transaction->active ||
+        transaction->parent_pid <= 1 || transaction->child_pid != getpid() ||
+        excluded_fd_count > QEMU_CRUCIBLE_HOT_FORK_MAX_RETAINED_DESCRIPTORS ||
+        (excluded_fd_count != 0 && !excluded_fds)) {
+        return -EINVAL;
+    }
+    for (size_t index = 0; index < excluded_fd_count; index++) {
+        if (excluded_fds[index] < 0 ||
+            (index != 0 && excluded_fds[index - 1] >= excluded_fds[index])) {
+            return -EINVAL;
+        }
+    }
+    *proof = (QemuCrucibleHotForkDescriptorTableProof) { 0 };
+
+    result = crucible_hot_fork_scan_child_descriptors(live, &live_count);
+    if (result != 0) {
+        return result;
+    }
+    for (size_t index = 0; index < excluded_fd_count; index++) {
+        if (!crucible_hot_fork_fd_table_contains(
+                live, live_count, excluded_fds[index]) ||
+            crucible_hot_fork_fd_table_contains(
+                resources->retained_fds, resources->retained_fd_count,
+                excluded_fds[index]) ||
+            crucible_hot_fork_replacement_for_target(
+                resources, excluded_fds[index])) {
+            return -EINVAL;
+        }
+    }
+    for (size_t index = 0; index < resources->replacement_count; index++) {
+        if (!crucible_hot_fork_fd_table_contains(
+                live, live_count, resources->replacements[index].source_fd) ||
+            !crucible_hot_fork_fd_table_contains(
+                live, live_count, resources->replacements[index].target_fd)) {
+            return -ESTALE;
+        }
+    }
+
+    for (size_t index = 0; index < live_count; index++) {
+        int descriptor = live[index];
+
+        if (crucible_hot_fork_fd_table_contains(
+                excluded_fds, excluded_fd_count, descriptor) ||
+            crucible_hot_fork_replacement_source(resources, descriptor)) {
+            continue;
+        }
+        retained[retained_count++] = descriptor;
+    }
+    result = qemu_crucible_hot_fork_merge_child_resource_contribution(
+        resources, NULL, 0, retained, retained_count, NULL, 0);
+    if (result != 0) {
+        return result;
+    }
+    result = qemu_crucible_hot_fork_seal_child_resource_plan(resources);
+    if (result != 0) {
+        return result;
+    }
+
+    proof->retained_count = resources->retained_fd_count;
+    for (size_t index = 0; index < resources->retained_fd_count; index++) {
+        int descriptor = resources->retained_fds[index];
+        const QemuCrucibleHotForkDescriptorReplacement *replacement =
+            crucible_hot_fork_replacement_for_target(resources, descriptor);
+        int identity_fd = replacement ? replacement->source_fd : descriptor;
+
+        result = crucible_hot_fork_capture_descriptor_identity(
+            identity_fd, descriptor, &proof->retained[index]);
+        if (result != 0) {
+            return result;
+        }
+    }
+    for (size_t index = 0; index < excluded_fd_count; index++) {
+        if (!crucible_hot_fork_insert_descriptor(
+                proof->closed, &proof->closed_count, excluded_fds[index])) {
+            return -E2BIG;
+        }
+    }
+    for (size_t index = 0; index < resources->replacement_count; index++) {
+        if (!crucible_hot_fork_insert_descriptor(
+                proof->closed, &proof->closed_count,
+                resources->replacements[index].source_fd)) {
+            return -E2BIG;
+        }
+    }
+    proof->prepared = true;
+    return 0;
+}
+
+int qemu_crucible_hot_fork_verify_child_descriptor_table(void *opaque)
+{
+    QemuCrucibleHotForkDescriptorTableProof *proof = opaque;
+    size_t retained_index = 0;
+
+    if (!proof || !proof->prepared ||
+        proof->retained_count >
+            QEMU_CRUCIBLE_HOT_FORK_MAX_RETAINED_DESCRIPTORS ||
+        proof->closed_count >
+            QEMU_CRUCIBLE_HOT_FORK_MAX_RETAINED_DESCRIPTORS) {
+        return -EINVAL;
+    }
+    for (size_t index = 0; index < proof->retained_count; index++) {
+        QemuCrucibleHotForkRetainedDescriptorIdentity observed;
+        QemuCrucibleHotForkRetainedDescriptorIdentity *expected =
+            &proof->retained[index];
+        int result = crucible_hot_fork_capture_descriptor_identity(
+            expected->fd, expected->fd, &observed);
+
+        if (expected->fd < 0 ||
+            (index != 0 && proof->retained[index - 1].fd >= expected->fd)) {
+            return -EINVAL;
+        }
+        if (result != 0) {
+            return result;
+        }
+        if (observed.fd != expected->fd ||
+            observed.device != expected->device ||
+            observed.inode != expected->inode ||
+            observed.mode != expected->mode ||
+            observed.special_device != expected->special_device ||
+            observed.status_flags != expected->status_flags ||
+            observed.descriptor_flags != expected->descriptor_flags) {
+            return -ESTALE;
+        }
+    }
+    for (size_t index = 0; index < proof->closed_count; index++) {
+        while (retained_index < proof->retained_count &&
+               proof->retained[retained_index].fd < proof->closed[index]) {
+            retained_index++;
+        }
+        if (proof->closed[index] < 0 ||
+            (index != 0 && proof->closed[index - 1] >= proof->closed[index]) ||
+            (retained_index < proof->retained_count &&
+             proof->retained[retained_index].fd == proof->closed[index])) {
+            return -EINVAL;
+        }
+        errno = 0;
+        if (fcntl(proof->closed[index], F_GETFD) >= 0 || errno != EBADF) {
+            return -ESTALE;
+        }
+    }
+    return 0;
+}
