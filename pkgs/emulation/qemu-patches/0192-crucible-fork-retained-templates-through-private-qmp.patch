+static int crucible_hot_fork_prepare_operation(void *opaque)
+{
+    CrucibleHotForkOperation *operation = opaque;
+    CrucibleHotForkPluginBarrierState *plugin_barrier = NULL;
+    CrucibleHotForkRcuBarrierState *rcu_barrier = NULL;
+    CrucibleHotForkBhTimerBarrierState *bh_timer_barrier = NULL;
+    CrucibleHotForkBlockBarrierState *block_barrier = NULL;
+    struct qemu_plugin_crucible_hot_fork_child_plan child_plan = { 0 };
+    QIONetListener *listener;
+    int result = -ESTALE;
+
+    if (!operation || operation->prepared) {
+        return -EINVAL;
+    }
+
+    g_mutex_lock(&crucible_hot_fork_template_lock);
+    plugin_barrier = crucible_hot_fork_plugin_barrier(
+        QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_QUERY, NULL);
+    rcu_barrier = crucible_hot_fork_rcu_barrier(
+        QEMU_RCU_HOT_FORK_BARRIER_QUERY);
+    bh_timer_barrier = crucible_hot_fork_bh_timer_barrier(
+        QEMU_BH_TIMER_HOT_FORK_BARRIER_QUERY);
+    block_barrier = crucible_hot_fork_block_barrier(
+        QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_QUERY, NULL);
+    if (!crucible_hot_fork_operation_active || !plugin_barrier ||
+        !block_barrier || !crucible_hot_fork_template_active ||
+        crucible_hot_fork_template_phase !=
+            CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BARRIERS_HELD ||
+        !crucible_hot_fork_exact_paused_boundary() ||
+        operation->template_generation !=
+            crucible_hot_fork_template_generation ||
+        operation->private_ring_generation !=
+            crucible_hot_fork_private_ring_stage.generation ||
+        operation->diagnostic_generation !=
+            crucible_hot_fork_diagnostic_stage.generation ||
+        operation->qmp_generation != crucible_hot_fork_qmp_stage.generation ||
+        operation->monitor_generation !=
+            crucible_hot_fork_qmp_stage.monitor_generation ||
+        operation->plugin_endpoint_generation !=
+            crucible_hot_fork_plugin_endpoint_stage.generation ||
+        operation->plugin_barrier_generation != plugin_barrier->generation ||
+        operation->rcu_barrier_generation != rcu_barrier->generation ||
+        operation->bh_timer_barrier_generation !=
+            bh_timer_barrier->generation ||
+        operation->block_barrier_generation != block_barrier->generation ||
+        !plugin_barrier->quiescent || !rcu_barrier->quiescent ||
+        !bh_timer_barrier->quiescent || !block_barrier->quiescent ||
+        !block_barrier->snapshot_complete ||
+        !crucible_hot_fork_plugin_child_plan_bound(
+            plugin_barrier, NULL, NULL) ||
+        !crucible_hot_fork_current_plugin_child_plan(
+            plugin_barrier, &child_plan) ||
+        operation->parent_process_generation !=
+            child_plan.parent_process_generation ||
+        operation->child_process_generation !=
+            child_plan.child_process_generation ||
+        !crucible_hot_fork_plugin_child_resource_plan_bound(plugin_barrier) ||
+        !crucible_hot_fork_diagnostic_resource_plan_bound() ||
+        !crucible_hot_fork_qmp_resource_plan_bound() ||
+        !monitor_hot_fork_child_basis_matches_current(
+            &crucible_hot_fork_qmp_child_basis,
+            operation->monitor_generation)) {
+        goto unlock;
+    }
+
+    operation->plugin_resources =
+        crucible_hot_fork_plugin_child_resources;
+    operation->diagnostics_resources =
+        crucible_hot_fork_diagnostics_child_resources;
+    operation->qmp_resources = crucible_hot_fork_qmp_child_resources;
+    operation->plugin_reinitializer =
+        crucible_hot_fork_plugin_child_reinitializer;
+    operation->qmp_reinitializer =
+        crucible_hot_fork_qmp_child_reinitializer;
+    operation->monitor_basis = crucible_hot_fork_qmp_child_basis;
+    operation->qmp_reinitializer.runtime_opaque = &operation->monitor_basis;
+    operation->excluded_fd_count = 0;
+
+    result = crucible_hot_fork_operation_add_excluded_fd(
+        operation, operation->monitor_basis.socket.sioc->fd);
+    listener = operation->monitor_basis.socket.listener;
+    if (result == 0 && !listener) {
+        result = -EINVAL;
+    }
+    for (size_t index = 0;
+         result == 0 && index < listener->nsioc; index++) {
+        if (!listener->sioc[index]) {
+            result = -EINVAL;
+            break;
+        }
+        result = crucible_hot_fork_operation_add_excluded_fd(
+            operation, listener->sioc[index]->fd);
+    }
+unlock:
+    g_free(plugin_barrier);
+    g_free(rcu_barrier);
+    g_free(bh_timer_barrier);
+    qapi_free_CrucibleHotForkBlockBarrierState(block_barrier);
+    g_mutex_unlock(&crucible_hot_fork_template_lock);
+    if (result != 0) {
+        return result;
+    }
+
+    result = qemu_crucible_hot_fork_capture_parent_identity(
+        &operation->parent_identity);
+    if (result != 0) {
+        return result;
+    }
+    result = qemu_crucible_hot_fork_begin_retained_runtime_transaction(
+        &operation->runtime, operation->rcu_barrier_generation,
+        operation->bh_timer_barrier_generation);
+    if (result != 0) {
+        qemu_crucible_hot_fork_release_parent_identity(
+            &operation->parent_identity);
+        return result;
+    }
+    operation->prepared = true;
+    return 0;
+}
