+static int ram_writer_closed_locked(const QemuThreadRamWriterTransaction *owner)
+{
+    QemuHotForkThreadRecord *record = owner->cpu ? owner->record : NULL;
+    uint64_t parked = owner->cpu ? 1 : 0;
