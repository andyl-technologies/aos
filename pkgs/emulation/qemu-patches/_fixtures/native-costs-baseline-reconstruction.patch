--- a/plugins/crucible-fault-clock.c
+++ b/plugins/crucible-fault-clock.c
@@ -408,15 +408,37 @@ static bool crucible_clock_multiply_ratio(
 static CrucibleClockSource *crucible_clock_source_by_kind(
     uint16_t kind, uint32_t instance)
 {
+    static __thread guint tsc_index = G_MAXUINT;
+
     if (!crucible_clock_sources) {
         return NULL;
     }
+
+    /*
+     * Cache only a search position. Registration can grow the array and
+     * manifest finalization sorts it, so resolve and validate the current
+     * row on every hit. Activation and clock values remain live reads.
+     */
+    if (kind == QEMU_CRUCIBLE_CLOCK_X86_TSC &&
+        tsc_index < crucible_clock_sources->len) {
+        CrucibleClockSource *source = &g_array_index(
+            crucible_clock_sources, CrucibleClockSource, tsc_index);
+
+        if (source->capability.source_kind == kind &&
+            source->instance == instance) {
+            return source;
+        }
+    }
+
     for (guint i = 0; i < crucible_clock_sources->len; i++) {
         CrucibleClockSource *source = &g_array_index(
             crucible_clock_sources, CrucibleClockSource, i);
 
         if (source->capability.source_kind == kind &&
             source->instance == instance) {
+            if (kind == QEMU_CRUCIBLE_CLOCK_X86_TSC) {
+                tsc_index = i;
+            }
             return source;
         }
     }
