+static unsigned int crucible_sim_det_ipi_trace_vector(
+    const CrucibleSimDetIpiEvent *event)
+{
+    switch (event->delivery_mode) {
+    case APIC_DM_LOWPRI:
+    case APIC_DM_FIXED:
+    case APIC_DM_SIPI:
+        return event->vector_num;
+    default:
+        return UINT_MAX;
+    }
