+
+static void crucible_sim_det_ipi_deliver_event(
+    const CrucibleSimDetIpiEvent *event)
+{
+    APICCommonState *target_apic = event->target_apic;
+    CPUState *dst_cpu;
+    uint64_t delivery_icount;
+
+    if (target_apic == NULL || target_apic->cpu == NULL) {
+        return;
+    }
+
+    dst_cpu = CPU(target_apic->cpu);
+    switch (event->delivery_mode) {
+    case APIC_DM_LOWPRI:
+    case APIC_DM_FIXED:
+        apic_set_irq(target_apic, event->vector_num, event->trigger_mode);
+        break;
+    case APIC_DM_SMI:
+        cpu_interrupt(dst_cpu, CPU_INTERRUPT_SMI);
+        break;
+    case APIC_DM_NMI:
+        cpu_interrupt(dst_cpu, CPU_INTERRUPT_NMI);
+        break;
+    case APIC_DM_INIT:
+        cpu_interrupt(dst_cpu, CPU_INTERRUPT_INIT);
+        break;
+    case APIC_DM_SIPI:
+        apic_startup(target_apic, event->vector_num);
+        break;
+    default:
+        return;
+    }
