+void crucible_sim_det_ipi_drain_pending(void)
+{
+    crucible_sim_det_ipi_draining = true;
+    while (!g_queue_is_empty(&crucible_sim_det_ipi_queue)) {
+        CrucibleSimDetIpiEvent *event =
+            g_queue_pop_head(&crucible_sim_det_ipi_queue);
+
+        crucible_sim_det_ipi_deliver_event(event);
+        g_free(event);
+    }
+    crucible_sim_det_ipi_draining = false;
+}
