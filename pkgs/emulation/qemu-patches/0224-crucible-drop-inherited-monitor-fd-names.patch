+/* Names each local-state predicate on the child's diagnostics stream. */
+static void monitor_hot_fork_child_report_local_state(MonitorQMP *qmp_mon)
+{
+    Monitor *mon = &qmp_mon->common;
+
+    qemu_mutex_lock(&mon->mon_lock);
+    fprintf(stderr,
+            "crucible hot-fork monitor child local state: fd-names-empty %d "
+            "outbuf %d outbuf-len %zu out-watch %u mux-out %d reset-seen %d "
+            "frontend-open %d\n",
+            QLIST_EMPTY(&mon->fds), mon->outbuf != NULL,
+            mon->outbuf ? (size_t)mon->outbuf->len : (size_t)0,
+            mon->out_watch, mon->mux_out, mon->reset_seen,
+            mon->chr.fe_is_open);
+    qemu_mutex_unlock(&mon->mon_lock);
+}
