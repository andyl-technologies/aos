+/*
+ * A hot-fork child inherits the names its source registered with getfd,
+ * but the child's descriptor table transaction has already closed or
+ * replaced every number they refer to.  Drop the names without touching
+ * the table; the transaction, not this registry, owns the child's
+ * descriptors.  Returns how many names were dropped.
+ */
+static unsigned int monitor_hot_fork_child_drop_fd_names(Monitor *mon)
+{
+    mon_fd_t *monfd;
+    mon_fd_t *next;
+    unsigned int dropped = 0;
+
+    QEMU_LOCK_GUARD(&mon->mon_lock);
+    QLIST_FOREACH_SAFE(monfd, &mon->fds, next, next) {
+        QLIST_REMOVE(monfd, next);
+        g_free(monfd->name);
+        g_free(monfd);
+        dropped++;
+    }
+    return dropped;
+}
+
 void monitor_fdsets_cleanup(void)
 {
     MonFdset *mon_fdset;
@@ -550,4 +573,6 @@ static void __attribute__((__constructor__)) monitor_fds_init(void)
 {
     qemu_mutex_init(&mon_fdsets_lock);
     monitor_hot_fork_register_fdsets_empty(monitor_fdsets_is_empty);
+    monitor_hot_fork_register_drop_fd_names(
+        monitor_hot_fork_child_drop_fd_names);
 }
