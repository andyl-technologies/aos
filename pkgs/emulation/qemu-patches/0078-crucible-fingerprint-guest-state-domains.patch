+static int qemu_plugin_crucible_save_fingerprint_device_state(QEMUFile *file)
+{
+    g_autoptr(GArray) interrupt_requests =
+        g_array_new(false, false, sizeof(int));
+    CPUState *cpu;
+    bool acquired_bql = false;
+    size_t index = 0;
+    int status;
+
+    if (!bql_locked()) {
+        bql_lock();
+        acquired_bql = true;
+    }
+    CPU_FOREACH(cpu) {
+        int interrupt_request = cpu->interrupt_request;
+
+        g_array_append_val(interrupt_requests, interrupt_request);
+        cpu->interrupt_request &=
+            ~(CPU_INTERRUPT_EXITTB |
+              cpu->cc->crucible_fingerprint_transient_interrupt_mask);
+    }
+    status = qemu_save_device_state_domains(
+        file, QEMU_CRUCIBLE_LIFECYCLE_STATE_VOLATILE |
+              QEMU_CRUCIBLE_LIFECYCLE_STATE_DEVICE);
+    CPU_FOREACH(cpu) {
+        g_assert(index < interrupt_requests->len);
+        cpu->interrupt_request =
+            g_array_index(interrupt_requests, int, index++);
+    }
+    if (acquired_bql) {
+        bql_unlock();
+    }
+    return status;
+}
+
 int qemu_plugin_crucible_device_state_sha256(uint8_t digest_out[32],
                                              uint64_t *bytes_out)
 {
@@ -956,7 +994,7 @@ int qemu_plugin_crucible_device_state_sha256(uint8_t digest_out[32],
     *bytes_out = 0;
     buffer = qio_channel_buffer_new(4096);
     file = qemu_file_new_output(QIO_CHANNEL(buffer));
-    status = qemu_save_device_state(file);
+    status = qemu_plugin_crucible_save_fingerprint_device_state(file);
     if (status == 0) {
