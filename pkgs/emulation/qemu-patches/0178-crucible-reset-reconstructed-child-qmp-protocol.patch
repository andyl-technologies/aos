+static bool monitor_hot_fork_child_local_state_clean(MonitorQMP *qmp_mon)
+{
+    Monitor *mon = &qmp_mon->common;
+    bool clean;
+
+    qemu_mutex_lock(&mon->mon_lock);
+    clean = QLIST_EMPTY(&mon->fds) && mon->outbuf &&
+        mon->outbuf->len == 0 && mon->out_watch == 0 &&
+        mon->mux_out == 0 && mon->reset_seen == 0 &&
+        mon->chr.fe_is_open;
+    qemu_mutex_unlock(&mon->mon_lock);
+    return clean;
+}
+
+/*
+ * Global fdsets are system-emulator state, while this file is also linked
+ * into tools such as qemu-storage-daemon.  Require the system-only owner to
+ * register its exact inventory check instead of weakening non-system builds
+ * with a stub that could report a false clean state.
+ */
+static bool (*monitor_hot_fork_fdsets_empty)(void);
+
+void monitor_hot_fork_register_fdsets_empty(bool (*check)(void))
+{
+    assert(check);
+    assert(!monitor_hot_fork_fdsets_empty);
+    monitor_hot_fork_fdsets_empty = check;
+}
+
+int monitor_hot_fork_reconstruct_child_protocol_held(
+    MonitorHotForkChildBasis *basis, int replacement_fd,
+    uint64_t expected_socket_cookie)
+{
+    MonitorHotForkInventory inventory;
+    MonitorQMP *qmp_mon;
+    Monitor *mon;
+    int result;
+
+    if (!basis || !basis->prepared || !basis->monitor ||
+        !basis->iothread || !basis->dispatcher || !basis->chardev ||
+        basis->socket.source_pid <= 0) {
+        return -EINVAL;
+    }
+    if (basis->socket.source_pid == getpid() || basis->attempted ||
+        basis->socket.attempted) {
+        return -EPERM;
+    }
+
+    qemu_mutex_lock(&monitor_lock);
+    monitor_hot_fork_inventory_locked(&inventory);
+    mon = QTAILQ_FIRST(&mon_list);
+    qmp_mon = basis->monitor;
+    if (!monitor_hot_fork_inventory_is_supported(&inventory) ||
+        inventory.generation != basis->generation || !mon ||
+        QTAILQ_NEXT(mon, entry) || !monitor_is_qmp(mon) ||
+        qmp_mon != container_of(mon, MonitorQMP, common) ||
+        basis->iothread != mon_iothread ||
+        basis->dispatcher != qmp_dispatcher_co ||
+        basis->chardev != monitor_hot_fork_child_chardev(qmp_mon) ||
+        qmp_dispatcher_co_shutdown ||
+        !monitor_hot_fork_child_local_state_clean(qmp_mon) ||
+        !monitor_hot_fork_fdsets_empty ||
+        !monitor_hot_fork_fdsets_empty()) {
+        result = -ESTALE;
+        goto out;
+    }
+
+    result = qemu_chr_socket_hot_fork_reconstruct_child_held(
+        &basis->socket, replacement_fd, expected_socket_cookie);
+    if (result != 0) {
+        goto out;
+    }
+    basis->attempted = true;
+
+    result = monitor_qmp_hot_fork_reset_protocol_held(qmp_mon);
+    if (result == 0) {
+        basis->parser_reset = true;
+        basis->capabilities_reset = true;
+        basis->inherited_protocol_disposed = true;
+        basis->input_held = basis->socket.input_held;
+        result = basis->input_held ? 0 : -EPROTO;
+    }
+out:
+    qemu_mutex_unlock(&monitor_lock);
+    return result;
+}
