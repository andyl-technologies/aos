@@ -12,6 +12,9 @@
  */
 
 #include "qemu/osdep.h"
+#ifdef CONFIG_LINUX
+#include <sys/syscall.h>
+#endif
 #include "qom/object.h"
 #include "qom/object_interfaces.h"
 #include "qemu/module.h"
@@ -399,6 +402,59 @@ void iothread_destroy(IOThread *iothread)
     object_unparent(OBJECT(iothread));
 }
 
+int iothread_hot_fork_reconstruct_child(
+    IOThread *iothread, int64_t inherited_thread_id,
+    int64_t source_process_id, int64_t *replacement_thread_id)
+{
+#ifdef CONFIG_LINUX
+    g_autofree char *thread_name = NULL;
+    int64_t current_thread_id = qemu_get_thread_id();
+    long live_thread;
+
+    if (!iothread || !replacement_thread_id || inherited_thread_id <= 0 ||
+        source_process_id <= 0) {
+        return -EINVAL;
+    }
+    *replacement_thread_id = 0;
+    if (source_process_id == getpid()) {
+        return -EPERM;
+    }
+    if (iothread->thread_id != inherited_thread_id ||
+        inherited_thread_id == current_thread_id || !iothread->ctx ||
+        !iothread->worker_context || !iothread->main_loop ||
+        iothread->stopping || !iothread->running ||
+        !qatomic_read(&iothread->run_gcontext)) {
+        return -ESTALE;
+    }
+
+    errno = 0;
+    live_thread = syscall(SYS_tgkill, getpid(), inherited_thread_id, 0);
+    if (live_thread == 0 || errno != ESRCH) {
+        return -EBUSY;
+    }
+
+    /*
+     * No caller uses the initialization semaphore after IOThread creation
+     * returns.  Recreate it rather than inheriting any implementation-private
+     * generation; the admitted fork boundary proves that it has no waiter.
+     */
+    qemu_sem_destroy(&iothread->init_done_sem);
+    qemu_sem_init(&iothread->init_done_sem, 0);
+    iothread->thread_id = -1;
+    thread_name = g_strdup_printf("IO %s",
+                                  object_get_canonical_path_component(
+                                      OBJECT(iothread)));
+    qemu_thread_create(&iothread->thread, thread_name, iothread_run,
+                       iothread, QEMU_THREAD_JOINABLE);
+    qemu_sem_wait(&iothread->init_done_sem);
+    assert(iothread->thread_id > 0);
+    *replacement_thread_id = iothread->thread_id;
+    return 0;
+#else
+    return -ENOTSUP;
+#endif
+}
