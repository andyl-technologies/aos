+void icount_crucible_rr_yield_cpu(CPUState *cpu)
+{
+    CPUState *next;
+
+    if (!cpu || icount_crucible_rr_switch_quantum() == 0) {
+        return;
+    }
+    if (!timers_state.crucible_rr_cursor_valid ||
+        timers_state.crucible_rr_current_vcpu != cpu->cpu_index) {
+        error_report("crucible RR yield owner mismatch: owner=%" PRIu64
+                     " yielded-vcpu=%d",
+                     timers_state.crucible_rr_current_vcpu, cpu->cpu_index);
+        abort();
+    }
+
+    /*
+     * A guest PAUSE is an explicit deterministic scheduler yield.  Commit the
+     * early handoff as canonical cursor state rather than retaining a partial
+     * turn: retaining it lets a lock owner reacquire before a waiting vCPU can
+     * run and can starve firmware or guest spin locks forever.
+     */
+    next = CPU_NEXT(cpu);
+    if (!next) {
+        next = first_cpu;
+    }
+    g_assert(next);
+    timers_state.crucible_rr_current_vcpu = next->cpu_index;
+    timers_state.crucible_rr_cursor_position = 0;
+    timers_state.crucible_rr_selection_pending = true;
+}
