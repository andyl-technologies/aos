+/*
+ * 0: no handoff; 1: the RR writer owes the handoff; 2: the control BH owns
+ * the deferral; 3: the BH relinquished its scheduling token.
+ */
+static int qemu_plugin_crucible_guest_pause_handoff;
+
+void qemu_plugin_crucible_guest_pause_handoff_begin(void)
+{
+    if (qatomic_cmpxchg(&qemu_plugin_crucible_guest_pause_handoff, 0, 1) != 0) {
+        error_report("Crucible guest PAUSE handoff already pending");
+        abort();
+    }
+}
+
+bool qemu_plugin_crucible_guest_pause_handoff_pending(void)
+{
+    return qatomic_load_acquire(
+        &qemu_plugin_crucible_guest_pause_handoff) != 0;
+}
+
+void qemu_plugin_crucible_guest_pause_handoff_complete(void)
+{
+    int state;
+
+    state = qatomic_cmpxchg(&qemu_plugin_crucible_guest_pause_handoff, 1, 0);
+    if (state == 1) {
+        return;
+    }
+    if (state == 3 &&
+        qatomic_cmpxchg(&qemu_plugin_crucible_guest_pause_handoff, 3, 0) == 3) {
+        qemu_plugin_schedule_control_boundary();
+        return;
+    }
+
+    error_report("Crucible guest PAUSE handoff completion had state %d", state);
+    abort();
+}
 
