+static bool crucible_node_event_envelope_valid(
+    const struct qemu_plugin_crucible_fault_event *event,
+    const uint8_t *payload, size_t payload_len)
+{
+    uint32_t request_len;
+    uint32_t evidence_len;
+    uint8_t digest[32];
+    const uint8_t *request;
+    const uint8_t *evidence;
+
+    if (payload_len < CRUCIBLE_NODE_EVENT_ENVELOPE_HEADER_BYTES ||
+        payload_len > CRUCIBLE_NODE_EVENT_ENVELOPE_MAX_BYTES ||
+        memcmp(payload, CRUCIBLE_NODE_EVENT_ENVELOPE_MAGIC, 8) != 0 ||
+        node_get_u16(payload + 8) != 1 ||
+        node_get_u16(payload + 10) != 0 ||
+        node_get_u32(payload + 20) != 0) {
+        return false;
+    }
+    request_len = node_get_u32(payload + 12);
+    evidence_len = node_get_u32(payload + 16);
+    if (request_len < CRUCIBLE_NODE_FAULT_PAYLOAD_HEADER_V1_BYTES ||
+        request_len > CRUCIBLE_FAULT_HARD_PAYLOAD_BYTES ||
+        evidence_len == 0 ||
+        evidence_len > CRUCIBLE_FAULT_HARD_PAYLOAD_BYTES ||
+        request_len > payload_len - CRUCIBLE_NODE_EVENT_ENVELOPE_HEADER_BYTES ||
+        evidence_len != payload_len -
+            CRUCIBLE_NODE_EVENT_ENVELOPE_HEADER_BYTES - request_len) {
+        return false;
+    }
+    request = payload + CRUCIBLE_NODE_EVENT_ENVELOPE_HEADER_BYTES;
+    evidence = request + request_len;
+    node_sha256(request, request_len, digest);
+    if (memcmp(digest, payload + 24, 32) != 0) {
+        return false;
+    }
+    node_sha256(evidence, evidence_len, digest);
+    if (memcmp(digest, payload + 56, 32) != 0) {
+        return false;
+    }
+    return memcmp(request, CRUCIBLE_NODE_MAGIC, 8) == 0 &&
+           node_get_u16(
+               request + CRUCIBLE_NODE_FAULT_PAYLOAD_COMMAND_KIND_OFFSET) ==
+               event->command_kind &&
+           node_get_u16(
+               request + CRUCIBLE_NODE_FAULT_PAYLOAD_TARGET_KIND_OFFSET) ==
+               event->target_kind &&
+           node_get_u16(
+               request + CRUCIBLE_NODE_FAULT_PAYLOAD_MODEL_PHASE_OFFSET) ==
+               event->model_phase &&
+           node_get_u64(
+               request + CRUCIBLE_NODE_FAULT_PAYLOAD_GENERATION_OFFSET) ==
+               event->generation &&
+           memcmp(payload + 88, event->binding_hash, 32) == 0 &&
+           node_get_u64(payload + 120) == event->rule_command_sequence &&
+           (event->command_kind !=
+                CRUCIBLE_FAULT_COMMAND_ACCELERATOR_RESULT_TRANSFORM ||
+            memcmp(payload + 160, event->opportunity_hash, 32) == 0) &&
+           memcmp(request + CRUCIBLE_NODE_FAULT_PAYLOAD_ACTION_HASH_OFFSET,
+                  event->action_hash, 32) == 0 &&
+           memcmp(request + CRUCIBLE_NODE_FAULT_PAYLOAD_TARGET_HASH_OFFSET,
+                  event->target_hash, 32) == 0;
+}
