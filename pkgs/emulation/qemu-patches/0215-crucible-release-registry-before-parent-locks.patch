+static void test_registered_mutex_use_while_retained_aborts(void)
+{
+    if (g_test_subprocess()) {
+        QemuThreadHotForkRegistryTransaction transaction = { 0 };
+        RegistryWorkerThread monitor_worker;
+        QemuMutex mutex;
+
+        start_registry_worker_thread(&monitor_worker, "IO mon_iothread",
+                                     monitor_registry_worker);
+        qemu_mutex_init(&mutex);
+        g_assert_cmpint(qemu_thread_hot_fork_begin_registry_transaction(
+                            &transaction),
+                        ==, 0);
+        /* The retained guard would otherwise deadlock this lock. */
+        qemu_mutex_lock(&mutex);
+        g_assert_not_reached();
+    }
+    g_test_trap_subprocess(NULL, 0, 0);
+    g_test_trap_assert_failed();
+    g_test_trap_assert_stderr("*registry transaction is retained*");
+}
