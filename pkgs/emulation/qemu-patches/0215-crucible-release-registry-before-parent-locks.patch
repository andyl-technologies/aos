diff --git a/system/crucible-hot-fork-coordinator.c b/system/crucible-hot-fork-coordinator.c
index 38566eaed..20f445664 100644
--- a/system/crucible-hot-fork-coordinator.c
+++ b/system/crucible-hot-fork-coordinator.c
@@ -207,13 +207,20 @@ static void crucible_hot_fork_execute_main_loop_request(void)
 
     if (child_pid < 0) {
         result = -errno;
-    } else {
-        crucible_hot_fork_retain_child(coordinator, child_pid);
     }
+    /*
+     * The parent callback releases the runtime transaction that still holds
+     * the registered-mutex guard across fork().  Retaining the child takes
+     * the coordinator's own registered lock, so it must wait for that
+     * release; the child is retained whatever the callback reports.
+     */
     parent_result = operation.parent(child_pid, operation.opaque);
     if (parent_result != 0) {
         result = parent_result;
     }
+    if (child_pid > 0) {
+        crucible_hot_fork_retain_child(coordinator, child_pid);
+    }
     crucible_hot_fork_complete_parent(result, child_pid);
 }
 
