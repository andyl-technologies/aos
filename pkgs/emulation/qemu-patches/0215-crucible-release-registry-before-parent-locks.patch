diff --git a/util/qemu-thread-posix.c b/util/qemu-thread-posix.c
index 5ac7bfedd..4fc3e938a 100644
--- a/util/qemu-thread-posix.c
+++ b/util/qemu-thread-posix.c
@@ -52,19 +52,36 @@ static void error_exit(int err, const char *msg)
     abort();
 }
 
+/*
+ * Whether the calling thread holds the registry guard.  A registry
+ * transaction retains the guard across fork(), so any registered mutex
+ * operation on the coordinator thread before the transaction is released
+ * would deadlock silently; fail fast and name the cause instead.
+ */
+static __thread bool crucible_hot_fork_mutex_registry_held;
+
 static void crucible_hot_fork_mutex_registry_lock(void)
 {
-    int err = pthread_mutex_lock(&crucible_hot_fork_mutex_registry_guard);
+    int err;
 
+    if (crucible_hot_fork_mutex_registry_held) {
+        fprintf(stderr, "qemu: registered mutex used while the Crucible "
+                "hot-fork registry transaction is retained\n");
+        abort();
+    }
+    err = pthread_mutex_lock(&crucible_hot_fork_mutex_registry_guard);
     if (err) {
         error_exit(err, __func__);
     }
+    crucible_hot_fork_mutex_registry_held = true;
 }
 
 static void crucible_hot_fork_mutex_registry_unlock(void)
 {
-    int err = pthread_mutex_unlock(&crucible_hot_fork_mutex_registry_guard);
+    int err;
 
+    crucible_hot_fork_mutex_registry_held = false;
+    err = pthread_mutex_unlock(&crucible_hot_fork_mutex_registry_guard);
     if (err) {
         error_exit(err, __func__);
     }
