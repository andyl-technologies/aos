+int monitor_dup_fd(Monitor *mon, const char *fdname, Error **errp)
+{
+    mon_fd_t *monfd;
+
+    QEMU_LOCK_GUARD(&mon->mon_lock);
+    QLIST_FOREACH(monfd, &mon->fds, next) {
+        int fd;
+
+        if (strcmp(monfd->name, fdname) != 0) {
+            continue;
+        }
+
+        fd = qemu_dup_flags(monfd->fd, O_CLOEXEC);
+        if (fd < 0) {
+            error_setg_errno(errp, errno,
+                             "Could not duplicate file descriptor named '%s'",
+                             fdname);
+        }
+        return fd;
+    }
+
+    error_setg(errp, "File descriptor named '%s' has not been found", fdname);
+    return -1;
+}
