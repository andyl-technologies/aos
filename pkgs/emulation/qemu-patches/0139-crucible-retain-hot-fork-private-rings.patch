+##
+# @CrucibleHotForkPrivateRingAction:
+#
+# Operation over QEMU's retained duplicate of one branch-private shared-ring
+# mapping descriptor.
+#
+# @stage: duplicate and authenticate one standard-QMP `getfd` entry
+#
+# @query: observe the retained descriptor without changing it
+#
+# @release: close the exact QEMU-retained duplicate; the monitor's `getfd`
+#     entry remains separately owned until standard QMP `closefd`
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'enum': 'CrucibleHotForkPrivateRingAction',
+  'data': [ 'stage', 'query', 'release' ] }
+
+##
+# @CrucibleHotForkPrivateRingState:
+#
+# Exact QEMU-owned state for one authenticated private-ring descriptor. This is
+# a template-side retention primitive only: it neither remaps a fork child nor
+# completes the inherited-resource disposition table, so readiness proof bits
+# 6 and 7 remain clear.
+#
+# @schema-version: retained-descriptor contract version, currently 1
+#
+# @generation: process-local positive mutation generation, or zero initially
+#
+# @staged: whether QEMU retains an independently duplicated descriptor
+#
+# @fdname: exact standard-QMP name while @staged
+#
+# @device: authenticated descriptor device identity, or zero when absent
+#
+# @inode: authenticated descriptor inode identity, or zero when absent
+#
+# @length: authenticated descriptor length, or zero when absent
+#
+# @shrink-sealed: whether `F_SEAL_SHRINK` was present at adoption
+#
+# @disposition-complete: always false until the complete child disposition
+#     transaction lands
+#
+# @readiness-proof-acknowledged: always false; this primitive acknowledges no
+#     hot-fork readiness proof
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'struct': 'CrucibleHotForkPrivateRingState',
+  'data': { 'schema-version': 'uint32',
+            'generation': 'uint64',
+            'staged': 'bool',
+            '*fdname': 'str',
+            'device': 'uint64',
+            'inode': 'uint64',
+            'length': 'uint64',
+            'shrink-sealed': 'bool',
+            'disposition-complete': 'bool',
+            'readiness-proof-acknowledged': 'bool' } }
+
+##
+# @crucible-hot-fork-private-rings:
+#
+# Retains or observes one authenticated duplicate of a standard-QMP `getfd`
+# entry for future child private-ring remapping. Stage requires the exact
+# device, inode, and length and accepts only a regular shrink-sealed descriptor.
+# Query accepts no descriptor fields. Release requires the same exact basis as
+# stage and does not close the separately owned standard-QMP name.
+#
+# @action: requested retained-descriptor operation
+#
+# @fdname: exact standard-QMP name, required for @stage and @release
+#
+# @expected-device: exact expected `st_dev`, required for @stage and @release
+#
+# @expected-inode: exact expected `st_ino`, required for @stage and @release
+#
+# @expected-length: exact expected `st_size`, required for @stage and @release
+#
+# Returns: @CrucibleHotForkPrivateRingState
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'command': 'crucible-hot-fork-private-rings',
+  'data': { 'action': 'CrucibleHotForkPrivateRingAction',
+            '*fdname': 'str',
+            '*expected-device': 'uint64',
+            '*expected-inode': 'uint64',
+            '*expected-length': 'uint64' },
+  'returns': 'CrucibleHotForkPrivateRingState',
+  'allow-oob': true }
+
 ##
 # @CrucibleHotForkMutex:
 #
