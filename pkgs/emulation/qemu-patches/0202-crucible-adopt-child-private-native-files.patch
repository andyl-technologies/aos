+/* Bound native files independently of the complete graph visit bound. */
+#define HOT_FORK_CHILD_MAX_FILES 4096
+#define HOT_FORK_CHILD_COPY_CHUNK (64 * 1024)
+
+typedef struct HotForkChildFileEntry {
+    BlockDriverState *node;
+    BdrvCrucibleHotForkFileState source;
+    struct stat destination;
+    off_t source_size;
+    bool private_file;
+    int destination_fd;
+    int prepared_fd;
+} HotForkChildFileEntry;
+
+struct QemuBlockHotForkChildFiles {
+    QemuBlockHotForkSourceSet *sources;
+    GArray *files;
+    pid_t owner;
+    bool consumed;
+};
+
+static void child_files_destroy(QemuBlockHotForkChildFiles *plan)
+{
+    size_t index;
+
+    for (index = 0; index < plan->files->len; index++) {
+        HotForkChildFileEntry *entry =
+            &g_array_index(plan->files, HotForkChildFileEntry, index);
+
+        if (entry->prepared_fd >= 0) {
+            close(entry->prepared_fd);
+        }
+    }
+    g_array_free(plan->files, true);
+    g_free(plan);
+}
+
+static bool child_files_capture(QemuBlockHotForkChildFiles *plan, Error **errp)
+{
+    g_autoptr(GHashTable) seen = g_hash_table_new(g_direct_hash, g_direct_equal);
+    size_t index, visit;
+    GRAPH_RDLOCK_GUARD_MAINLOOP();
+
+    for (index = 0; index < plan->sources->sources->len; index++) {
+        QemuBlockBackendHotForkReadOnlySource *source =
+            g_ptr_array_index(plan->sources->sources, index);
+
+        for (visit = 0; visit < source->graph->len; visit++) {
+            ReadOnlySourceNode *node =
+                &g_array_index(source->graph, ReadOnlySourceNode, visit);
+            HotForkChildFileEntry entry = {
+                .node = node->node,
+                .private_file = !node->file.read_only,
+                .destination_fd = -1,
+                .prepared_fd = -1,
+            };
+
+            if (!node->file_pinned || !g_hash_table_add(seen, node->node)) {
+                continue;
+            }
+            if (plan->files->len == HOT_FORK_CHILD_MAX_FILES ||
+                !node->driver->bdrv_crucible_hot_fork_file_child ||
+                !node->driver->bdrv_crucible_hot_fork_file(
+                    node->node, BDRV_CRUCIBLE_HOT_FORK_FILE_QUERY,
+                    &entry.source, errp) || !entry.source.read_only) {
+                if (!errp || !*errp) {
+                    error_setg(errp, "Crucible child lacks a bounded frozen "
+                               "file disposition");
+                }
+                return false;
+            }
+            g_array_append_val(plan->files, entry);
+        }
+    }
+    return true;
+}
+
+static bool child_files_bind(QemuBlockHotForkChildFiles *plan,
+                             const QemuBlockHotForkChildFile *files,
+                             size_t count, uint64_t maximum_bytes, Error **errp)
+{
+    size_t index, candidate, other, matched = 0;
+    uint64_t total = 0;
+
+    for (index = 0; index < plan->files->len; index++) {
+        HotForkChildFileEntry *entry =
+            &g_array_index(plan->files, HotForkChildFileEntry, index);
+        struct stat source;
+        int flags;
+
+        if (!entry->private_file) {
+            continue;
+        }
+        for (candidate = 0; candidate < count; candidate++) {
+            if (files[candidate].node == entry->node) {
+                if (entry->destination_fd >= 0) {
+                    error_setg(errp, "Crucible child file has duplicate replacements");
+                    return false;
+                }
+                entry->destination_fd = files[candidate].descriptor;
+                matched++;
+            }
+        }
+        flags = entry->destination_fd < 0 ? -1 :
+            fcntl(entry->destination_fd, F_GETFL);
+        if (flags < 0 ||
+            fstat(entry->destination_fd, &entry->destination) < 0 ||
+            !S_ISREG(entry->destination.st_mode) ||
+            entry->destination.st_nlink != 1 ||
+            entry->destination.st_size != 0 ||
+            (flags & O_ACCMODE) != O_RDWR || (flags & O_APPEND) ||
+            fstat(entry->source.descriptor, &source) < 0 ||
+            source.st_size < 0 ||
+            (uint64_t)source.st_size > maximum_bytes - total) {
+            error_setg(errp, "Crucible child requires empty private files "
+                       "within its byte budget");
+            return false;
+        }
+        total += source.st_size;
+        entry->source_size = source.st_size;
+        for (other = 0; other < plan->files->len; other++) {
+            HotForkChildFileEntry *prior =
+                &g_array_index(plan->files, HotForkChildFileEntry, other);
+
+            if ((entry->destination.st_dev == prior->source.device &&
+                 entry->destination.st_ino == prior->source.inode) ||
+                (other < index && prior->private_file &&
+                 entry->destination.st_dev == prior->destination.st_dev &&
+                 entry->destination.st_ino == prior->destination.st_ino)) {
+                error_setg(errp, "Crucible child file aliases a source or "
+                           "another replacement");
+                return false;
+            }
+        }
+    }
+    if (matched != count) {
+        error_setg(errp, "Crucible child file list contains an unowned replacement");
+        return false;
+    }
+    return true;
+}
+
+static int child_file_open(int descriptor, int flags, Error **errp)
+{
+    char path[64];
+    int opened;
+
+    g_snprintf(path, sizeof(path), "/proc/self/fd/%d", descriptor);
+    opened = open(path, flags | O_CLOEXEC);
+    if (opened < 0) {
+        error_setg_errno(errp, errno, "Cannot open Crucible child file capability");
+    }
+    return opened;
+}
+
+static bool child_file_copy(int source, int destination, off_t size, Error **errp)
+{
+    g_autofree uint8_t *buffer = NULL;
+    off_t offset = 0;
+
+#ifdef FICLONE
+    if (ioctl(destination, FICLONE, source) == 0) {
+        goto sync;
+    }
+    if (errno != EOPNOTSUPP && errno != ENOTTY && errno != EXDEV && errno != EINVAL) {
+        error_setg_errno(errp, errno, "Cannot clone Crucible child file");
+        return false;
+    }
+#endif
+    /* Sparse copying is the correctness fallback, not a reflink requirement. */
+    buffer = g_malloc(HOT_FORK_CHILD_COPY_CHUNK);
+    while (offset < size) {
+        size_t length = MIN(size - offset, HOT_FORK_CHILD_COPY_CHUNK);
+        size_t read_bytes = 0, written = 0, index;
+        uint8_t nonzero = 0;
+
+        while (read_bytes < length) {
+            ssize_t result = pread(source, buffer + read_bytes,
+                                    length - read_bytes, offset + read_bytes);
+            if (result < 0 && errno == EINTR) {
+                continue;
+            }
+            if (result <= 0) {
+                error_setg_errno(errp, result < 0 ? errno : EIO,
+                                 "Cannot read frozen Crucible source file");
+                return false;
+            }
+            read_bytes += result;
+        }
+        for (index = 0; index < length; index++) {
+            nonzero |= buffer[index];
+        }
+        while (nonzero && written < length) {
+            ssize_t result = pwrite(destination, buffer + written,
+                                     length - written, offset + written);
+            if (result < 0 && errno == EINTR) {
+                continue;
+            }
+            if (result <= 0) {
+                error_setg_errno(errp, result < 0 ? errno : EIO,
+                                 "Cannot write private Crucible child file");
+                return false;
+            }
+            written += result;
+        }
+        offset += length;
+    }
+    if (ftruncate(destination, size) < 0) {
+        error_setg_errno(errp, errno, "Cannot size private Crucible child file");
+        return false;
+    }
+#ifdef FICLONE
+sync:
+#endif
+    if (fdatasync(destination) < 0) {
+        error_setg_errno(errp, errno, "Cannot sync private Crucible child file");
+        return false;
+    }
+    return true;
+}
+
+static bool child_file_prepare(HotForkChildFileEntry *entry, Error **errp)
+{
+    struct stat source, destination, after;
+    int reader = -1, writer = -1;
+    bool prepared = false;
+
+    reader = child_file_open(entry->source.descriptor, O_RDONLY, errp);
+    if (reader < 0) {
+        goto out;
+    }
+    if (fstat(reader, &source) < 0 || source.st_dev != entry->source.device ||
+        source.st_ino != entry->source.inode ||
+        (entry->private_file && source.st_size != entry->source_size)) {
+        error_setg(errp, "Crucible source file changed before private copy");
+        goto out;
+    }
+    if (entry->private_file) {
+        writer = child_file_open(entry->destination_fd, O_RDWR, errp);
+        if (writer < 0) {
+            goto out;
+        }
+        if (fstat(writer, &destination) < 0 || destination.st_size != 0 ||
+            destination.st_dev != entry->destination.st_dev ||
+            destination.st_ino != entry->destination.st_ino) {
+            error_setg(errp, "Crucible private destination changed before copy");
+            goto out;
+        }
+        if (!child_file_copy(reader, writer, source.st_size, errp)) {
+            goto out;
+        }
+        if (fstat(writer, &entry->destination) < 0 ||
+            entry->destination.st_size != source.st_size) {
+            error_setg(errp, "Crucible private copy has an unexpected length");
+            goto out;
+        }
+    }
+    if (fstat(reader, &after) < 0 || source.st_size != after.st_size ||
+        source.st_mtim.tv_sec != after.st_mtim.tv_sec ||
+        source.st_mtim.tv_nsec != after.st_mtim.tv_nsec) {
+        error_setg(errp, "Frozen Crucible source changed during private copy");
+        goto out;
+    }
+    entry->prepared_fd = child_file_open(entry->private_file ? writer : reader,
+                                          entry->source.flags, errp);
+    prepared = entry->prepared_fd >= 0;
+out:
+    if (reader >= 0) {
+        close(reader);
+    }
+    if (writer >= 0) {
+        close(writer);
+    }
+    return prepared;
+}
+
+QemuBlockHotForkChildFiles *qemu_block_hot_fork_child_files_prepare(
+    QemuBlockHotForkSourceSet *set, const QemuBlockHotForkChildFile *files,
+    size_t count, uint64_t maximum_bytes, Error **errp)
+{
+    QemuBlockHotForkSourceSetInventory inventory;
+    QemuBlockHotForkChildFiles *plan;
+    size_t index;
+
+    GLOBAL_STATE_CODE();
+    if (count > HOT_FORK_CHILD_MAX_FILES || (count && !files) ||
+        !qemu_block_hot_fork_source_set_query(set, &inventory, errp) ||
+        !inventory.frozen || set->child_plan_active) {
+        if (!errp || !*errp) {
+            error_setg(errp, "Crucible child files require one complete "
+                       "frozen source set");
+        }
+        return NULL;
+    }
+    plan = g_new0(QemuBlockHotForkChildFiles, 1);
+    plan->sources = set;
+    plan->owner = getpid();
+    plan->files = g_array_new(false, false, sizeof(HotForkChildFileEntry));
+    if (!child_files_capture(plan, errp) ||
+        !child_files_bind(plan, files, count, maximum_bytes, errp)) {
+        goto fail;
+    }
+    for (index = 0; index < plan->files->len; index++) {
+        if (!child_file_prepare(
+                &g_array_index(plan->files, HotForkChildFileEntry, index), errp)) {
+            goto fail;
+        }
+    }
+    set->child_plan_active = true;
+    return plan;
+fail:
+    child_files_destroy(plan);
+    return NULL;
+}
+
+bool qemu_block_hot_fork_child_files_free(QemuBlockHotForkChildFiles *plan,
+                                         Error **errp)
+{
+    GLOBAL_STATE_CODE();
+    if (!plan || plan->owner != getpid() || plan->consumed ||
+        !plan->sources->child_plan_active) {
+        error_setg(errp, "Crucible child file plan lost its parent owner");
+        return false;
+    }
+    plan->sources->child_plan_active = false;
+    child_files_destroy(plan);
+    return true;
+}
+
+bool qemu_block_hot_fork_child_files_install(QemuBlockHotForkChildFiles *plan,
+                                            Error **errp)
+{
+    QemuBlockHotForkSourceSet *set;
+    QemuBlockBackendHotForkBarrierInventory barrier;
+    size_t index, visit;
+    bool held;
+
+    GLOBAL_STATE_CODE();
+    if (!plan || plan->owner <= 1 || plan->owner != getppid() ||
+        plan->owner == getpid() || plan->consumed ||
+        !source_set_complete_owned(plan->sources, plan->owner, errp) ||
+        !qemu_aio_hot_fork_thread_pools_empty() ||
+        !qemu_block_hot_fork_all_sources_read_only(errp)) {
+        if (!errp || !*errp) {
+            error_setg(errp, "Crucible file installation requires a "
+                       "quiescent immediate child");
+        }
+        return false;
+    }
+    if (!qemu_block_backend_hot_fork_barrier(
+            QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_QUERY, &barrier)) {
+        error_setg(errp, "Cannot inspect child block barriers");
+        return false;
+    }
+    held = barrier.held || barrier.graph_held;
+    qemu_block_backend_hot_fork_barrier_inventory_destroy(&barrier);
+    if (held) {
+        error_setg(errp, "Crucible file installation requires released block barriers");
+        return false;
+    }
+    set = plan->sources;
+    plan->consumed = true;
+    {
+        GRAPH_RDLOCK_GUARD_MAINLOOP();
+        for (index = 0; index < plan->files->len; index++) {
+            HotForkChildFileEntry *entry =
+                &g_array_index(plan->files, HotForkChildFileEntry, index);
+            struct stat actual;
+            dev_t device = entry->private_file ?
+                entry->destination.st_dev : entry->source.device;
+            ino_t inode = entry->private_file ?
+                entry->destination.st_ino : entry->source.inode;
+
+            if (fstat(entry->prepared_fd, &actual) < 0 ||
+                actual.st_dev != device || actual.st_ino != inode ||
+                (entry->private_file &&
+                 (actual.st_size != entry->destination.st_size ||
+                  actual.st_mtim.tv_sec != entry->destination.st_mtim.tv_sec ||
+                  actual.st_mtim.tv_nsec != entry->destination.st_mtim.tv_nsec)) ||
+                !entry->node->drv->bdrv_crucible_hot_fork_file_child(
+                    entry->node, plan->owner, entry->prepared_fd, errp)) {
+                if (!errp || !*errp) {
+                    error_setg(errp, "Crucible prepared child file lost its identity");
+                }
+                return false;
+            }
+        }
+        for (index = 0; index < set->sources->len; index++) {
+            QemuBlockBackendHotForkReadOnlySource *source =
+                g_ptr_array_index(set->sources, index);
+
+            source->owner = getpid();
+            for (visit = 0; visit < source->graph->len; visit++) {
+                ReadOnlySourceNode *node =
+                    &g_array_index(source->graph, ReadOnlySourceNode, visit);
+                if (node->file_pinned &&
+                    !node->driver->bdrv_crucible_hot_fork_file(
+                        node->node, BDRV_CRUCIBLE_HOT_FORK_FILE_QUERY,
+                        &node->file, errp)) {
+                    return false;
+                }
+            }
+        }
+    }
+    set->owner = getpid();
+    set->child_plan_active = false;
+    if (!qemu_block_hot_fork_source_set_restore(set, errp) ||
+        !qemu_block_hot_fork_source_set_free(set, errp)) {
+        return false;
+    }
+    child_files_destroy(plan);
+    return true;
+}
