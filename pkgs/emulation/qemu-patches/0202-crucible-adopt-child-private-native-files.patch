+/*
+ * Prepares exact private file copies while the complete source set is frozen.
+ * Destination descriptors must be unique, empty, writable regular files and
+ * must not alias any source. The caller retains them, including partial copies
+ * on I/O failure. maximum_bytes bounds their aggregate logical source length.
+ * Read-only leaves get independent read-only descriptors for the same inode.
+ * A source set permits one outstanding plan and cannot restore before release.
+ * The coordinator must bind it to one fork and release the parent copy after
+ * that fork; reusing its private destinations for another child is forbidden.
+ * This native primitive does not authorize the production physical fork.
+ */
+QemuBlockHotForkChildFiles *qemu_block_hot_fork_child_files_prepare(
+    QemuBlockHotForkSourceSet *set, const QemuBlockHotForkChildFile *files,
+    size_t count, uint64_t maximum_bytes, Error **errp);
+
+/* Releases a prepared plan in its parent without changing source permissions. */
+bool qemu_block_hot_fork_child_files_free(QemuBlockHotForkChildFiles *plan,
+                                         Error **errp);
+
+/*
+ * Adopts the complete prepared file set only in its immediate fork child,
+ * outside block barriers and after native worker retirement. It preserves the
+ * graph and cached bytes, rebinds native file locks, restores original root
+ * access against the private files, and releases the child's source capability.
+ * The caller must terminate the child on any failure after adoption begins;
+ * the parent plan, graph, files, and source capabilities remain unchanged.
+ * Success consumes both the inherited plan and its source set.
+ */
+bool qemu_block_hot_fork_child_files_install(QemuBlockHotForkChildFiles *plan,
+                                            Error **errp);
 
