+static bool GRAPH_RDLOCK raw_crucible_hot_fork_file_child(
+    BlockDriverState *bs, pid_t parent, int descriptor, Error **errp)
+{
+#ifdef __linux__
+    BDRVRawState *s = bs->opaque;
+    BdrvCrucibleHotForkFileState original;
+    struct stat metadata, opened;
+    char path[64];
+    int flags, retained;
+
+    GLOBAL_STATE_CODE();
+    if (parent <= 1 || parent != getppid() || parent == getpid() ||
+        s->crucible_source_owner != parent || !s->crucible_source_pins ||
+        s->use_linux_aio || s->use_linux_io_uring ||
+        !raw_crucible_hot_fork_file(bs, BDRV_CRUCIBLE_HOT_FORK_FILE_QUERY,
+                                    &original, errp)) {
+        if (!errp || !*errp) {
+            error_setg(errp, "Crucible file adoption requires its immediate child");
+        }
+        return false;
+    }
+    flags = descriptor < 0 ? -1 : fcntl(descriptor, F_GETFL);
+    if (!original.read_only || descriptor == s->fd || flags < 0 ||
+        fstat(descriptor, &metadata) < 0 || !S_ISREG(metadata.st_mode) ||
+        flags != original.flags) {
+        error_setg(errp, "Crucible child file must preserve frozen access flags");
+        return false;
+    }
+    /* dup() would retain locks through the parent's staged open description. */
+    g_snprintf(path, sizeof(path), "/proc/self/fd/%d", descriptor);
+    retained = qemu_open(path, flags, errp);
+    if (retained < 0) {
+        return false;
+    }
+    if (fstat(retained, &opened) < 0 || opened.st_dev != metadata.st_dev ||
+        opened.st_ino != metadata.st_ino) {
+        qemu_close(retained);
+        error_setg(errp, "Crucible child file changed during independent reopen");
+        return false;
+    }
+    /* Locks belong to open file descriptions, not inherited cached bitmasks. */
+    if (s->use_lock &&
+        (raw_apply_lock_bytes(NULL, retained, s->perm, ~s->shared_perm,
+                              false, errp) < 0 ||
+         raw_check_lock_bytes(retained, s->perm, s->shared_perm, errp) < 0)) {
+        qemu_close(retained);
+        return false;
+    }
+    qemu_close(s->fd);
+    s->fd = retained;
+    s->locked_perm = s->use_lock ? s->perm : 0;
+    s->locked_shared_perm = s->use_lock ? BLK_PERM_ALL & ~s->shared_perm : 0;
+    s->crucible_source_owner = getpid();
+    s->crucible_child_descriptor = true;
+    return true;
+#else
+    error_setg(errp, "Crucible child file adoption requires Linux");
+    return false;
+#endif
+}
