+    g_assert_null(qemu_block_hot_fork_child_files_prepare(
+        sources, files, G_N_ELEMENTS(files), 0, NULL));
+    g_assert_null(qemu_block_hot_fork_child_files_prepare(
+        sources, files, 1, 16 * HOT_FORK_SNAPSHOT_SIZE, NULL));
+    memcpy(wrong, files, sizeof(files));
+    wrong[1].descriptor = wrong[0].descriptor;
+    g_assert_null(qemu_block_hot_fork_child_files_prepare(
+        sources, wrong, G_N_ELEMENTS(wrong), 16 * HOT_FORK_SNAPSHOT_SIZE, NULL));
+    memcpy(wrong, files, sizeof(files));
+    wrong[1].node = fixture.roots[2].root->file->bs;
+    g_assert_null(qemu_block_hot_fork_child_files_prepare(
+        sources, wrong, G_N_ELEMENTS(wrong), 16 * HOT_FORK_SNAPSHOT_SIZE, NULL));
+
+    plan = qemu_block_hot_fork_child_files_prepare(
+        sources, files, G_N_ELEMENTS(files), 16 * HOT_FORK_SNAPSHOT_SIZE,
+        &error_abort);
