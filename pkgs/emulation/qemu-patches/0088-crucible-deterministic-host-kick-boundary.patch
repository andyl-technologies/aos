diff --git a/accel/tcg/tcg-accel-ops-rr.c b/accel/tcg/tcg-accel-ops-rr.c
index 54ed19223..fccb3f282 100644
--- a/accel/tcg/tcg-accel-ops-rr.c
+++ b/accel/tcg/tcg-accel-ops-rr.c
@@ -46,11 +46,63 @@
 #include "system/crucible-sim-ipi.h"
 #include "system/crucible-sim-preemption.h"
 
+static bool rr_crucible_sim_mode(void);
+static CPUState *rr_current_cpu;
+
 /* Kick all RR vCPUs */
 void rr_kick_vcpu_thread(CPUState *unused)
 {
     CPUState *cpu;
+    bool stateful_exit = false;
 
+    if (rr_crucible_sim_mode() &&
+        icount_crucible_rr_switch_quantum() != 0 &&
+        icount_get_raw_observed() > 0 &&
+        qatomic_read(&rr_current_cpu) != NULL) {
+        /*
+         * Host work and main-loop notifications may request a generic vCPU
+         * kick at host-dependent times.  Do not end a running translation
+         * block for those latency hints: the deterministic RR budget reaches
+         * a finite boundary where level-triggered work is observed.
+         *
+         * Before the first guest instruction, cpu_resume() clears the stop
+         * flags before issuing the kick that starts the RR thread.  That kick
+         * cannot choose an architectural coordinate because none exists yet,
+         * and a single-vCPU loop has no alternate RR CPU to force progress.
+         * Retain upstream behavior at icount zero; once execution begins, the
+         * pinned finite quantum supplies the deterministic return boundary.
+         * Between slices, retain the kick so an already-waiting RR thread
+         * receives the exit request needed to re-enter its run loop.
+         *
+         * Stop, unplug, and halted transitions are different.  Their state is
+         * already committed before qemu_cpu_kick(), and a stopped or sleeping
+         * vCPU cannot reach another RR boundary by retiring instructions.
+         * Preserve upstream's exit request for those level-triggered states so
+         * pause, shutdown, hot-unplug, and interrupt wakeups remain live. An
+         * already-published interrupt request is guest-visible state, not a
+         * latency hint, and must retain the same exit path.
+         */
+        CPU_FOREACH(cpu) {
+            if (qemu_plugin_crucible_terminal_pause_pending() ||
+                cpu->stop || cpu->unplug || cpu->halted ||
+                cpu->stopped ||
+                qatomic_read(&cpu->interrupt_request)) {
+                stateful_exit = true;
+                break;
+            }
+        }
+        if (stateful_exit) {
+            /*
+             * RR vCPUs share one host thread.  The committed transition may
+             * target a non-current vCPU, so exit every CPUState exactly as
+             * upstream does to guarantee that the active TCG slice returns.
+             */
+            CPU_FOREACH(cpu) {
+                cpu_exit(cpu);
+            }
+        }
+        return;
+    }
     CPU_FOREACH(cpu) {
         cpu_exit(cpu);
     };
@@ -69,7 +121,6 @@ void rr_kick_vcpu_thread(CPUState *unused)
  */
 
 static QEMUTimer *rr_kick_vcpu_timer;
-static CPUState *rr_current_cpu;
 
 #define RR_CRUCIBLE_SIM_TCG_BATCH_LIMIT 4
 
