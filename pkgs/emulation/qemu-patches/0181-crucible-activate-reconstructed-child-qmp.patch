+typedef enum MonitorHotForkProtocolOperation {
+    MONITOR_HOT_FORK_PROTOCOL_GREET_HELD,
+    MONITOR_HOT_FORK_PROTOCOL_RELEASE_INPUT,
+} MonitorHotForkProtocolOperation;
+
+typedef struct MonitorHotForkProtocolTransition {
+    MonitorHotForkChildBasis *basis;
+    MonitorHotForkProtocolOperation operation;
+    int result;
+} MonitorHotForkProtocolTransition;
+
+static bool monitor_hot_fork_child_protocol_is_held(MonitorQMP *qmp_mon)
+{
+    bool held = true;
+    QMPCapability capability;
+
+    qemu_rec_mutex_lock(&qmp_mon->qmp_parser_lock);
+    qemu_mutex_lock(&qmp_mon->qmp_queue_lock);
+    held = qmp_mon->commands == &qmp_cap_negotiation_commands &&
+        g_queue_is_empty(qmp_mon->qmp_requests) &&
+        qmp_mon->parser.token_size == 0 &&
+        g_queue_is_empty(&qmp_mon->parser.tokens) &&
+        qmp_mon->parser.brace_count == 0 &&
+        qmp_mon->parser.bracket_count == 0 &&
+        (!qmp_mon->parser.lexer.token ||
+         qmp_mon->parser.lexer.token->len == 0) &&
+        qmp_mon->parser.lexer.state == qmp_mon->parser.lexer.start_state;
+    for (capability = 0; held && capability < QMP_CAPABILITY__MAX;
+         capability++) {
+        held = !qmp_mon->capab[capability] &&
+            qmp_mon->capab_offered[capability] ==
+                (capability == QMP_CAPABILITY_OOB);
+    }
+    held = held && qmp_mon->common.use_io_thread;
+    qemu_mutex_unlock(&qmp_mon->qmp_queue_lock);
+    qemu_rec_mutex_unlock(&qmp_mon->qmp_parser_lock);
+    return held;
+}
+
+static bool monitor_hot_fork_child_output_is_flushed(MonitorQMP *qmp_mon)
+{
+    Monitor *mon = &qmp_mon->common;
+    bool flushed;
+
+    qemu_mutex_lock(&mon->mon_lock);
+    flushed = mon->outbuf && mon->outbuf->len == 0;
+    qemu_mutex_unlock(&mon->mon_lock);
+    return flushed;
+}
+
+static void monitor_hot_fork_child_protocol_transition_bh(void *opaque)
+{
+    MonitorHotForkProtocolTransition *transition = opaque;
+    MonitorHotForkChildBasis *basis = transition->basis;
+    Monitor *listed;
+
+    transition->result = -ESTALE;
+    if (qemu_get_thread_id() != basis->iothread_thread_id ||
+        basis->iothread != mon_iothread ||
+        basis->iothread_context !=
+            iothread_get_g_main_context(basis->iothread) ||
+        basis->dispatcher != qmp_dispatcher_co ||
+        qmp_dispatcher_co_shutdown ||
+        !monitor_qmp_hot_fork_dispatcher_is_idle(basis->dispatcher)) {
+        return;
+    }
+
+    qemu_mutex_lock(&monitor_lock);
+    listed = QTAILQ_FIRST(&mon_list);
+    if (monitor_hot_fork_generation_overflowed ||
+        monitor_hot_fork_generation != basis->generation || !listed ||
+        QTAILQ_NEXT(listed, entry) || !monitor_is_qmp(listed) ||
+        basis->monitor != container_of(listed, MonitorQMP, common) ||
+        basis->chardev != monitor_hot_fork_child_chardev(basis->monitor) ||
+        !basis->attempted || !basis->inherited_protocol_disposed ||
+        !basis->dispatcher_rebuilt || !basis->iothread_rebuilt ||
+        !basis->parser_reset || !basis->capabilities_reset ||
+        !basis->input_held || basis->input_released ||
+        !monitor_hot_fork_child_protocol_is_held(basis->monitor) ||
+        !qemu_chr_socket_hot_fork_child_input_is_held(
+            &basis->socket, basis->iothread_context)) {
+        goto out;
+    }
+
+    switch (transition->operation) {
+    case MONITOR_HOT_FORK_PROTOCOL_GREET_HELD:
+        if (basis->greeting_emitted ||
+            !monitor_hot_fork_child_local_state_clean(basis->monitor)) {
+            goto out;
+        }
+        qemu_chr_be_event(basis->chardev, CHR_EVENT_OPENED);
+        basis->greeting_emitted = true;
+        transition->result = 0;
+        break;
+    case MONITOR_HOT_FORK_PROTOCOL_RELEASE_INPUT:
+        if (!basis->greeting_emitted) {
+            transition->result = -EPROTO;
+            goto out;
+        }
+        monitor_flush(&basis->monitor->common);
+        if (!monitor_hot_fork_child_output_is_flushed(basis->monitor)) {
+            transition->result = -EAGAIN;
+            goto out;
+        }
+        transition->result = qemu_chr_socket_hot_fork_release_child_input(
+            &basis->socket, basis->iothread_context);
+        if (transition->result != 0) {
+            goto out;
+        }
+        basis->input_held = false;
+        basis->input_released = true;
+        break;
+    default:
+        transition->result = -EINVAL;
+        goto out;
+    }
+out:
+    qemu_mutex_unlock(&monitor_lock);
+}
+
+static int monitor_hot_fork_run_child_protocol_transition(
+    MonitorHotForkChildBasis *basis, MonitorHotForkProtocolOperation operation)
+{
+    MonitorHotForkProtocolTransition transition = {
+        .basis = basis,
+        .operation = operation,
+        .result = -ESTALE,
+    };
+
+    if (!basis || !basis->prepared || !basis->monitor ||
+        !basis->iothread || !basis->dispatcher || !basis->chardev ||
+        !basis->iothread_context || basis->socket.source_pid <= 0) {
+        return -EINVAL;
+    }
+    if (basis->socket.source_pid == getpid() || basis->input_released) {
+        return -EPERM;
+    }
+    if (!qemu_bh_timer_hot_fork_admission_try_begin()) {
+        return -EBUSY;
+    }
+    aio_wait_bh_oneshot(iothread_get_aio_context(basis->iothread),
+                        monitor_hot_fork_child_protocol_transition_bh,
+                        &transition);
+    qemu_bh_timer_hot_fork_admission_end();
+    return transition.result;
+}
+
+int monitor_hot_fork_greet_child_protocol_held(
+    MonitorHotForkChildBasis *basis)
+{
+    if (basis && basis->greeting_emitted) {
+        return -EPERM;
+    }
+    return monitor_hot_fork_run_child_protocol_transition(
+        basis, MONITOR_HOT_FORK_PROTOCOL_GREET_HELD);
+}
+
+int monitor_hot_fork_release_child_protocol_input(
+    MonitorHotForkChildBasis *basis)
+{
+    return monitor_hot_fork_run_child_protocol_transition(
+        basis, MONITOR_HOT_FORK_PROTOCOL_RELEASE_INPUT);
+}
