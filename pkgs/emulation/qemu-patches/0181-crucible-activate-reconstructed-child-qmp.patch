+static bool tcp_chr_hot_fork_child_is_held_locked(
+    const QemuChrSocketHotForkChildBasis *basis, GMainContext *context)
+{
+    Chardev *chr = basis->chardev;
+    SocketChardev *s = SOCKET_CHARDEV(chr);
+
+    return basis->prepared && basis->source_pid > 0 &&
+        basis->source_pid != getpid() && basis->attempted &&
+        basis->inherited_disposed && basis->replacement_attached &&
+        basis->input_held && basis->frontend &&
+        basis->frontend->chr == chr && chr->be == basis->frontend &&
+        basis->context == context && chr->gcontext == context &&
+        qemu_chr_has_feature(chr, QEMU_CHAR_FEATURE_GCONTEXT) &&
+        !qemu_chr_replay(chr) && s->state == TCP_CHARDEV_STATE_CONNECTED &&
+        s->addr == basis->address && s->addr &&
+        s->addr->type == SOCKET_ADDRESS_TYPE_UNIX && s->is_listen &&
+        s->listener == basis->listener && s->ioc == basis->replacement_ioc &&
+        s->sioc == basis->replacement_sioc && s->ioc && s->sioc &&
+        s->ioc == QIO_CHANNEL(s->sioc) &&
+        s->crucible_hot_fork_connection_generation ==
+            basis->replacement_connection_generation &&
+        basis->replacement_connection_generation != 0 &&
+        basis->replacement_socket_cookie != 0 && !chr->gsource &&
+        !s->hup_source && !s->tls_creds && !s->tls_authz && !s->is_telnet &&
+        !s->is_tn3270 && !s->is_websock && !s->telnet_source &&
+        !s->telnet_init && !s->reconnect_timer &&
+        s->reconnect_time_ms == 0 && !s->connect_task &&
+        !s->read_msgfds && s->read_msgfds_num == 0 &&
+        !s->write_msgfds && s->write_msgfds_num == 0 && s->registered_yank;
+}
+
+bool qemu_chr_socket_hot_fork_child_input_is_held(
+    QemuChrSocketHotForkChildBasis *basis, GMainContext *context)
+{
+    Chardev *chr;
+    bool held;
+
+    if (!basis || !basis->prepared || !basis->chardev ||
+        !object_dynamic_cast(OBJECT(basis->chardev), TYPE_CHARDEV_SOCKET)) {
+        return false;
+    }
+
+    chr = basis->chardev;
+    qemu_mutex_lock(&chr->chr_write_lock);
+    held = tcp_chr_hot_fork_child_is_held_locked(basis, context);
+    qemu_mutex_unlock(&chr->chr_write_lock);
+    return held;
+}
+
+int qemu_chr_socket_hot_fork_release_child_input(
+    QemuChrSocketHotForkChildBasis *basis, GMainContext *context)
+{
+    Chardev *chr;
+    SocketChardev *s;
+    int result = 0;
+
+    if (!basis || !basis->prepared || !basis->chardev ||
+        !object_dynamic_cast(OBJECT(basis->chardev), TYPE_CHARDEV_SOCKET)) {
+        return -EINVAL;
+    }
+    if (basis->source_pid == getpid() || !basis->input_held) {
+        return -EPERM;
+    }
+
+    chr = basis->chardev;
+    s = SOCKET_CHARDEV(chr);
+    qemu_mutex_lock(&chr->chr_write_lock);
+    if (!tcp_chr_hot_fork_child_is_held_locked(basis, context)) {
+        result = -ESTALE;
+        goto out;
+    }
+
+    update_ioc_handlers(s);
+    assert(chr->gsource);
+    assert(s->hup_source);
+    basis->input_held = false;
+out:
+    qemu_mutex_unlock(&chr->chr_write_lock);
+    return result;
+}
