+/**
+ * typedef qemu_plugin_crucible_fault_completion_cb_t - fault result callback
+ * @userdata: opaque pointer supplied when the callback was registered
+ *
+ * The callback runs after a fault result has been published and after the
+ * fault transport lock has been released, while QEMU is still stopped at the
+ * dispatch boundary.  It may poll the result and submit a follow-up command
+ * for that same boundary.
+ */
+typedef void (*qemu_plugin_crucible_fault_completion_cb_t)(void *userdata);
+
 /**
  * typedef qemu_plugin_vcpu_idle_resume_cb_t - sim idle/resume callback
  * @vcpu_index: the vCPU index entering or leaving the all-idle boundary
@@ -1920,6 +1931,19 @@ int qemu_plugin_crucible_fault_poll(
     struct qemu_plugin_crucible_fault_result *result,
     uint8_t *payload, size_t payload_capacity, size_t *payload_length);
 
+/**
+ * qemu_plugin_register_crucible_fault_completion_cb() - register completion
+ * @cb: callback invoked after each boundary-dispatched result, or NULL to clear
+ * @userdata: opaque pointer supplied to @cb
+ *
+ * Registering a callback lets a GPL-side controller complete a prepare/commit
+ * transaction without allowing the guest to retire another instruction.  A
+ * callback may poll and submit, but must not recursively dispatch boundaries.
+ */
+QEMU_PLUGIN_API
+void qemu_plugin_register_crucible_fault_completion_cb(
+    qemu_plugin_crucible_fault_completion_cb_t cb, void *userdata);
+
