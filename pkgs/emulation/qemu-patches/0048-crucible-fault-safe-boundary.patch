+int64_t qemu_crucible_fault_clamp_budget(uint16_t phase,
+                                         uint64_t current_icount,
+                                         int64_t budget)
+{
+    uint64_t next;
+    uint64_t remaining;
+
+    if (budget <= 0) {
+        return budget;
+    }
+    next = qemu_crucible_fault_next_icount(phase);
+    if (current_icount >= next) {
+        return 0;
+    }
+    remaining = next - current_icount;
+    if (remaining > INT64_MAX || (uint64_t)budget <= remaining) {
+        return budget;
+    }
+    return remaining;
+}
