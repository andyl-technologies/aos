+CrucibleHotForkChildProcessState *qmp_crucible_hot_fork_child_process(
+    CrucibleHotForkChildProcessAction action, uint64_t generation,
+    Error **errp)
+{
+    QemuCrucibleHotForkChildProcessState state = { 0 };
+    CrucibleHotForkChildProcessState *report;
+    int result;
+
+    switch (action) {
+    case CRUCIBLE_HOT_FORK_CHILD_PROCESS_ACTION_QUERY:
+        result = qemu_crucible_hot_fork_child_process_query(
+            generation, &state);
+        break;
+    case CRUCIBLE_HOT_FORK_CHILD_PROCESS_ACTION_RELEASE:
+        result = qemu_crucible_hot_fork_child_process_release(
+            generation, &state);
+        break;
+    default:
+        g_assert_not_reached();
+    }
+    if (result != 0) {
+        error_setg_errno(errp, -result,
+                         "Could not operate on Crucible hot-fork child");
+        return NULL;
+    }
+
+    report = g_new0(CrucibleHotForkChildProcessState, 1);
+    report->schema_version = 1;
+    report->generation = state.generation;
+    report->child_pid = state.process_id;
+    report->status = state.status;
+    report->retained = state.retained;
+    switch (state.phase) {
+    case QEMU_CRUCIBLE_HOT_FORK_CHILD_RUNNING:
+        report->phase = CRUCIBLE_HOT_FORK_CHILD_PROCESS_PHASE_RUNNING;
+        break;
+    case QEMU_CRUCIBLE_HOT_FORK_CHILD_EXITED:
+        report->phase = CRUCIBLE_HOT_FORK_CHILD_PROCESS_PHASE_EXITED;
+        break;
+    case QEMU_CRUCIBLE_HOT_FORK_CHILD_SIGNALED:
+        report->phase = CRUCIBLE_HOT_FORK_CHILD_PROCESS_PHASE_SIGNALED;
+        break;
+    default:
+        g_assert_not_reached();
+    }
+    return report;
+}
