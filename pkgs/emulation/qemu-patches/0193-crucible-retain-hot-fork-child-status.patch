+##
+# @CrucibleHotForkChildProcessAction:
+#
+# Parent-owned operation over one exact retained fork-child status record.
+#
+# @query: observe the running or reaped child without releasing its status
+#
+# @release: remove one reaped status record; a running child is rejected
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'enum': 'CrucibleHotForkChildProcessAction',
+  'data': [ 'query', 'release' ] }
+
+##
+# @CrucibleHotForkChildProcessPhase:
+#
+# Parent-owned process state after one retained-template fork.
+#
+# @running: the direct child has not produced a final wait status
+#
+# @exited: the child exited normally and @status is its exit code
+#
+# @signaled: the child terminated from a signal and @status is that signal
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'enum': 'CrucibleHotForkChildProcessPhase',
+  'data': [ 'running', 'exited', 'signaled' ] }
+
+##
+# @CrucibleHotForkChildProcessState:
+#
+# Exact bounded status retained by the source QEMU that owns waitpid(2) for a
+# hot-fork child. Query and release perform a nonblocking wait while the child
+# remains live. The record remains queryable after reap until explicit release,
+# preventing PID reuse from changing its identity.
+#
+# @schema-version: child-process status contract version, currently 1
+#
+# @generation: exact nonzero child-process generation from the fork request
+#
+# @child-pid: positive direct-child process ID returned by fork(2)
+#
+# @phase: current parent-owned process phase
+#
+# @status: zero while running; exit code for @exited; signal for @signaled
+#
+# @retained: true for query and false after successful release
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'struct': 'CrucibleHotForkChildProcessState',
+  'data': { 'schema-version': 'uint32',
+            'generation': 'uint64',
+            'child-pid': 'int64',
+            'phase': 'CrucibleHotForkChildProcessPhase',
+            'status': 'int64',
+            'retained': 'bool' } }
+
+##
+# @crucible-hot-fork-child-process:
+#
+# Queries or releases the source QEMU's exact waitpid(2) authority for one
+# fork child. A generation is reserved before fork and is unique among every
+# running or reaped retained child. Release fails until the child is reaped.
+#
+# @action: requested parent-owned status operation
+#
+# @generation: exact child-process generation from the fork request
+#
+# Returns: @CrucibleHotForkChildProcessState
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'command': 'crucible-hot-fork-child-process',
+  'data': { 'action': 'CrucibleHotForkChildProcessAction',
+            'generation': 'uint64' },
+  'returns': 'CrucibleHotForkChildProcessState',
+  'allow-oob': true }
+
 ##
 # @CrucibleHotForkPrivateRingAction:
 #
diff --git a/system/crucible-hot-fork-coordinator.c b/system/crucible-hot-fork-coordinator.c
index 76c45e406..131fdfd2c 100644
--- a/system/crucible-hot-fork-coordinator.c
+++ b/system/crucible-hot-fork-coordinator.c
@@ -13,6 +13,22 @@
 #include "qemu/thread.h"
 #include "system/crucible-hot-fork-coordinator.h"
 
+#define CRUCIBLE_HOT_FORK_MAX_RETAINED_CHILDREN 4096
+
+typedef enum QemuCrucibleHotForkRetainedChildPhase {
+    CRUCIBLE_HOT_FORK_CHILD_UNUSED,
+    CRUCIBLE_HOT_FORK_CHILD_RESERVED,
+    CRUCIBLE_HOT_FORK_CHILD_RUNNING,
+    CRUCIBLE_HOT_FORK_CHILD_REAPED,
+} QemuCrucibleHotForkRetainedChildPhase;
+
+typedef struct QemuCrucibleHotForkRetainedChild {
+    uint64_t generation;
+    pid_t process_id;
+    int wait_status;
+    QemuCrucibleHotForkRetainedChildPhase phase;
+} QemuCrucibleHotForkRetainedChild;
+
 typedef struct QemuCrucibleHotForkCoordinator {
     QemuMutex lock;
     QemuCond completed_cond;
@@ -22,15 +38,80 @@ typedef struct QemuCrucibleHotForkCoordinator {
     int64_t main_thread_id;
     int result;
     pid_t child_pid;
+    size_t child_slot;
     size_t poll_index;
     bool initialized;
     bool busy;
     bool executing;
     bool completed;
+    QemuCrucibleHotForkRetainedChild
+        children[CRUCIBLE_HOT_FORK_MAX_RETAINED_CHILDREN];
 } QemuCrucibleHotForkCoordinator;
 
 static QemuCrucibleHotForkCoordinator crucible_hot_fork_coordinator;
 
+static int crucible_hot_fork_reserve_child_locked(
+    QemuCrucibleHotForkCoordinator *coordinator, uint64_t generation,
+    size_t *slot)
+{
+    size_t available = CRUCIBLE_HOT_FORK_MAX_RETAINED_CHILDREN;
+
+    if (generation == 0 || !slot) {
+        return -EINVAL;
+    }
+    for (size_t index = 0;
+         index < CRUCIBLE_HOT_FORK_MAX_RETAINED_CHILDREN; index++) {
+        QemuCrucibleHotForkRetainedChild *child =
+            &coordinator->children[index];
+
+        if (child->phase != CRUCIBLE_HOT_FORK_CHILD_UNUSED &&
+            child->generation == generation) {
+            return -EEXIST;
+        }
+        if (available == CRUCIBLE_HOT_FORK_MAX_RETAINED_CHILDREN &&
+            child->phase == CRUCIBLE_HOT_FORK_CHILD_UNUSED) {
+            available = index;
+        }
+    }
+    if (available == CRUCIBLE_HOT_FORK_MAX_RETAINED_CHILDREN) {
+        return -ENOSPC;
+    }
+
+    coordinator->children[available] =
+        (QemuCrucibleHotForkRetainedChild) {
+            .generation = generation,
+            .process_id = -1,
+            .phase = CRUCIBLE_HOT_FORK_CHILD_RESERVED,
+        };
+    *slot = available;
+    return 0;
+}
+
+static void crucible_hot_fork_release_reserved_child_locked(
+    QemuCrucibleHotForkCoordinator *coordinator)
+{
+    QemuCrucibleHotForkRetainedChild *child =
+        &coordinator->children[coordinator->child_slot];
+
+    g_assert(child->phase == CRUCIBLE_HOT_FORK_CHILD_RESERVED);
+    *child = (QemuCrucibleHotForkRetainedChild) { 0 };
+}
+
+static void crucible_hot_fork_retain_child(
+    QemuCrucibleHotForkCoordinator *coordinator, pid_t process_id)
+{
+    QemuCrucibleHotForkRetainedChild *child =
+        &coordinator->children[coordinator->child_slot];
+
+    qemu_mutex_lock(&coordinator->lock);
+    g_assert(child->phase == CRUCIBLE_HOT_FORK_CHILD_RESERVED);
+    g_assert(process_id > 0);
+    child->process_id = process_id;
+    child->phase = CRUCIBLE_HOT_FORK_CHILD_RUNNING;
+    qemu_mutex_unlock(&coordinator->lock);
+
+}
