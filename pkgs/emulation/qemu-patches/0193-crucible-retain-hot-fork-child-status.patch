+static int crucible_hot_fork_child_process_state_locked(
+    QemuCrucibleHotForkCoordinator *coordinator, uint64_t generation,
+    QemuCrucibleHotForkChildProcessState *state, size_t *slot)
+{
+    if (generation == 0 || !state) {
+        return -EINVAL;
+    }
+    for (size_t index = 0;
+         index < CRUCIBLE_HOT_FORK_MAX_RETAINED_CHILDREN; index++) {
+        QemuCrucibleHotForkRetainedChild *child =
+            &coordinator->children[index];
+
+        if (child->phase == CRUCIBLE_HOT_FORK_CHILD_UNUSED ||
+            child->phase == CRUCIBLE_HOT_FORK_CHILD_RESERVED ||
+            child->generation != generation) {
+            continue;
+        }
+        if (child->phase == CRUCIBLE_HOT_FORK_CHILD_RUNNING) {
+            pid_t waited;
+
+            do {
+                waited = waitpid(child->process_id, &child->wait_status,
+                                 WNOHANG);
+            } while (waited < 0 && errno == EINTR);
+            if (waited < 0) {
+                return -errno;
+            }
+            if (waited == child->process_id) {
+                child->phase = CRUCIBLE_HOT_FORK_CHILD_REAPED;
+            } else if (waited != 0) {
+                return -EPROTO;
+            }
+        }
+        *state = (QemuCrucibleHotForkChildProcessState) {
+            .generation = child->generation,
+            .process_id = child->process_id,
+            .phase = QEMU_CRUCIBLE_HOT_FORK_CHILD_RUNNING,
+            .retained = true,
+        };
+        if (child->phase == CRUCIBLE_HOT_FORK_CHILD_REAPED) {
+            if (WIFEXITED(child->wait_status)) {
+                state->phase = QEMU_CRUCIBLE_HOT_FORK_CHILD_EXITED;
+                state->status = WEXITSTATUS(child->wait_status);
+            } else if (WIFSIGNALED(child->wait_status)) {
+                state->phase = QEMU_CRUCIBLE_HOT_FORK_CHILD_SIGNALED;
+                state->status = WTERMSIG(child->wait_status);
+            } else {
+                return -EPROTO;
+            }
+        }
+        if (slot) {
+            *slot = index;
+        }
+        return 0;
+    }
+    return -ENOENT;
+}
+
+int qemu_crucible_hot_fork_child_process_query(
+    uint64_t generation, QemuCrucibleHotForkChildProcessState *state)
+{
+    QemuCrucibleHotForkCoordinator *coordinator =
+        &crucible_hot_fork_coordinator;
+    int result;
+
+    if (!coordinator->initialized) {
+        return -EINVAL;
+    }
+    qemu_mutex_lock(&coordinator->lock);
+    result = crucible_hot_fork_child_process_state_locked(
+        coordinator, generation, state, NULL);
+    qemu_mutex_unlock(&coordinator->lock);
+    return result;
+}
+
+int qemu_crucible_hot_fork_child_process_release(
+    uint64_t generation, QemuCrucibleHotForkChildProcessState *state)
+{
+    QemuCrucibleHotForkCoordinator *coordinator =
+        &crucible_hot_fork_coordinator;
+    size_t slot = 0;
+    int result;
+
+    if (!coordinator->initialized) {
+        return -EINVAL;
+    }
+    qemu_mutex_lock(&coordinator->lock);
+    result = crucible_hot_fork_child_process_state_locked(
+        coordinator, generation, state, &slot);
+    if (result == 0 &&
+        coordinator->children[slot].phase !=
+            CRUCIBLE_HOT_FORK_CHILD_REAPED) {
+        result = -EBUSY;
+    }
+    if (result == 0) {
+        coordinator->children[slot] =
+            (QemuCrucibleHotForkRetainedChild) { 0 };
+        state->retained = false;
+    }
+    qemu_mutex_unlock(&coordinator->lock);
+    return result;
+}
