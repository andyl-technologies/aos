+static void test_validate_node_result_evidence(
+    const uint8_t *evidence, size_t evidence_len,
+    const struct qemu_plugin_crucible_fault_result *result)
+{
+    uint16_t expected_operation = test_mode == TEST_MODE_PERSISTENT ?
+        CRUCIBLE_NODE_FAULT_OPERATION_UPSERT :
+        CRUCIBLE_NODE_FAULT_OPERATION_APPLY;
+    uint8_t digest[32];
+
+    if (evidence_len != CRUCIBLE_NODE_FAULT_EVIDENCE_V1_BYTES ||
+        memcmp(evidence + CRUCIBLE_NODE_FAULT_EVIDENCE_MAGIC_OFFSET,
+               "CRUCNEV1", 8) != 0 ||
+        test_get_u16(evidence +
+                     CRUCIBLE_NODE_FAULT_EVIDENCE_VERSION_OFFSET) != 1 ||
+        test_get_u16(evidence +
+                     CRUCIBLE_NODE_FAULT_EVIDENCE_COMMAND_KIND_OFFSET) !=
+            CRUCIBLE_FAULT_COMMAND_CPU_REGISTER_TRANSFORM ||
+        test_get_u16(evidence +
+                     CRUCIBLE_NODE_FAULT_EVIDENCE_OPERATION_OFFSET) !=
+            expected_operation ||
+        test_get_u16(evidence +
+                     CRUCIBLE_NODE_FAULT_EVIDENCE_TARGET_KIND_OFFSET) !=
+            CRUCIBLE_NODE_FAULT_TARGET_REGISTER ||
+        test_get_u16(evidence +
+                     CRUCIBLE_NODE_FAULT_EVIDENCE_MODEL_PHASE_OFFSET) !=
+            test_model_phase ||
+        test_get_u16(evidence +
+                     CRUCIBLE_NODE_FAULT_EVIDENCE_RESERVED_OFFSET) != 0 ||
+        test_get_u64(evidence +
+                     CRUCIBLE_NODE_FAULT_EVIDENCE_GENERATION_OFFSET) != 1 ||
+        test_get_u64(evidence +
+                     CRUCIBLE_NODE_FAULT_EVIDENCE_PRIOR_GENERATION_OFFSET) !=
+            0 ||
+        memcmp(evidence + CRUCIBLE_NODE_FAULT_EVIDENCE_ACTION_HASH_OFFSET,
+               test_action_hash, 32) != 0 ||
+        memcmp(evidence + CRUCIBLE_NODE_FAULT_EVIDENCE_TARGET_HASH_OFFSET,
+               test_target_hash, 32) != 0 ||
+        memcmp(evidence + CRUCIBLE_NODE_FAULT_EVIDENCE_SCHEMA_HASH_OFFSET,
+               test_payload + CRUCIBLE_NODE_FAULT_PAYLOAD_SCHEMA_HASH_OFFSET,
+               32) != 0 ||
+        memcmp(evidence + CRUCIBLE_NODE_FAULT_EVIDENCE_BEFORE_SHA256_OFFSET,
+               result->before_hash, 32) != 0 ||
+        memcmp(evidence + CRUCIBLE_NODE_FAULT_EVIDENCE_AFTER_SHA256_OFFSET,
+               result->after_hash, 32) != 0) {
+        test_fail("typed node result evidence is not canonical");
+    }
+    test_sha256(test_payload, test_payload_len, digest);
+    if (memcmp(evidence +
+               CRUCIBLE_NODE_FAULT_EVIDENCE_REQUEST_SHA256_OFFSET,
+               digest, 32) != 0) {
+        test_fail("typed node result does not bind the request payload");
+    }
+    test_sha256(evidence, evidence_len, digest);
+    if (memcmp(digest, result->evidence_hash, 32) != 0) {
+        test_fail("typed node result evidence hash does not match framing");
+    }
+}
