+#include "qemu/cutils.h"
 #include "qemu/plugin.h"
 #include "qemu/crucible-hot-fork-plugin.h"
 #include "qemu/ctype.h"
@@ -367,6 +370,21 @@ typedef struct CrucibleHotForkPrivateRingStage {
 
 static CrucibleHotForkPrivateRingStage crucible_hot_fork_private_ring_stage;
 
+typedef struct CrucibleHotForkPluginEndpointStage {
+    bool staged;
+    int control_fd;
+    int wake_fd;
+    char *control_fdname;
+    char *wake_fdname;
+    uint64_t control_socket_cookie;
+    uint64_t wake_eventfd_id;
+    uint64_t private_ring_generation;
+    uint64_t generation;
+} CrucibleHotForkPluginEndpointStage;
+
+static CrucibleHotForkPluginEndpointStage
+    crucible_hot_fork_plugin_endpoint_stage;
+
 static void crucible_hot_fork_template_schedule_block_transition(void);
 
 static bool crucible_hot_fork_private_ring_fd_name_valid(const char *name)
@@ -390,6 +408,120 @@ static bool crucible_hot_fork_private_ring_fd_name_valid(const char *name)
     return true;
