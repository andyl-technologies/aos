+static bool crucible_hot_fork_read_fdinfo(int fd, char *buffer,
+                                          size_t buffer_size, Error **errp)
+{
+    char path[64];
+    size_t used = 0;
+    int info_fd;
+
+    if (buffer_size < 2) {
+        error_setg(errp, "Crucible hot-fork fdinfo buffer is too small");
+        return false;
+    }
+    snprintf(path, sizeof(path), "/proc/self/fdinfo/%d", fd);
+    info_fd = open(path, O_RDONLY | O_CLOEXEC);
+    if (info_fd < 0) {
+        error_setg_errno(errp, errno,
+                         "Could not open Crucible hot-fork fdinfo");
+        return false;
+    }
+    while (used < buffer_size - 1) {
+        ssize_t length = read(info_fd, buffer + used,
+                              buffer_size - 1 - used);
+
+        if (length > 0) {
+            used += length;
+            continue;
+        }
+        if (length == 0) {
+            break;
+        }
+        if (errno == EINTR) {
+            continue;
+        }
+        error_setg_errno(errp, errno,
+                         "Could not read Crucible hot-fork fdinfo");
+        close(info_fd);
+        return false;
+    }
+    if (used == buffer_size - 1) {
+        char extra;
+        ssize_t length;
+
+        do {
+            length = read(info_fd, &extra, 1);
+        } while (length < 0 && errno == EINTR);
+        if (length != 0) {
+            if (length < 0) {
+                error_setg_errno(errp, errno,
+                                 "Could not finish Crucible hot-fork fdinfo");
+            } else {
+                error_setg(errp, "Crucible hot-fork fdinfo exceeds its bound");
+            }
+            close(info_fd);
+            return false;
+        }
+    }
+    close(info_fd);
+    buffer[used] = '\0';
+    return true;
+}
+
+static bool crucible_hot_fork_eventfd_id(int fd, uint64_t *eventfd_id,
+                                         Error **errp)
+{
+    char buffer[4096];
+    char *cursor;
+    bool found = false;
+
+    if (!crucible_hot_fork_read_fdinfo(fd, buffer, sizeof(buffer), errp)) {
+        return false;
+    }
+    cursor = buffer;
+    while (*cursor != '\0') {
+        char *line_end = strchr(cursor, '\n');
+        size_t line_length = line_end ? (size_t)(line_end - cursor) :
+                                        strlen(cursor);
+        static const char prefix[] = "eventfd-id:";
+
+        if (line_length >= sizeof(prefix) - 1 &&
+            memcmp(cursor, prefix, sizeof(prefix) - 1) == 0) {
+            char value[64];
+            const char *value_start = cursor + sizeof(prefix) - 1;
+            size_t value_length = line_length - (sizeof(prefix) - 1);
+            const char *end = NULL;
+            uint64_t parsed;
+
+            while (value_length > 0 && qemu_isspace(*value_start)) {
+                value_start++;
+                value_length--;
+            }
+            if (found || value_length == 0 || value_length >= sizeof(value)) {
+                error_setg(errp, "Invalid Crucible hot-fork eventfd identity");
+                return false;
+            }
+            memcpy(value, value_start, value_length);
+            value[value_length] = '\0';
+            if (qemu_strtou64(value, &end, 10, &parsed) < 0 ||
+                !end || *end != '\0' || parsed == 0) {
+                error_setg(errp, "Invalid Crucible hot-fork eventfd identity");
+                return false;
+            }
+            *eventfd_id = parsed;
+            found = true;
+        }
+        if (!line_end) {
+            break;
+        }
+        cursor = line_end + 1;
+    }
+    if (!found) {
+        error_setg(errp, "Crucible hot-fork wake descriptor is not an eventfd");
+    }
+    return found;
+}
+
 static CrucibleHotForkPrivateRingState *
 crucible_hot_fork_private_ring_report(void)
