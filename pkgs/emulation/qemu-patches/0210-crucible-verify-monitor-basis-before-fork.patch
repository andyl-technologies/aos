     }
     return NULL;
 }
@@ -4294,9 +4299,7 @@ static int crucible_hot_fork_prepare_operation(void *opaque)
         !crucible_hot_fork_diagnostic_resource_plan_bound() ||
         !crucible_hot_fork_qmp_resource_plan_bound() ||
