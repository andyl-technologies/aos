diff --git a/include/qemu/qemu-plugin.h b/include/qemu/qemu-plugin.h
--- a/include/qemu/qemu-plugin.h
+++ b/include/qemu/qemu-plugin.h
@@ -1012,5 +1012,17 @@ QEMU_PLUGIN_API
 void qemu_plugin_crucible_pause_vm(void);
-
+
+/**
+ * qemu_plugin_clock_deadline_ns() - return next virtual-clock timer expiry time
+ *
+ * Returns the exact virtual-clock timestamp for the next QEMU_CLOCK_VIRTUAL
+ * timer deadline, or a negative value when no virtual-clock timer is armed.
+ *
+ * This AOS Crucible extension is required for exact idle fast-forward and never
+ * consults QEMU_CLOCK_REALTIME or QEMU_CLOCK_HOST.
+ */
+QEMU_PLUGIN_API
+int64_t qemu_plugin_clock_deadline_ns(void);
+
 /**
  * qemu_plugin_scoreboard_new() - alloc a new scoreboard
  * @element_size: size (in bytes) for one entry
diff --git a/plugins/api.c b/plugins/api.c
--- a/plugins/api.c
+++ b/plugins/api.c
@@ -692,2 +692,13 @@ void qemu_plugin_crucible_pause_vm(void)
 }
+
+int64_t qemu_plugin_clock_deadline_ns(void)
+{
+    int64_t delta = qemu_clock_deadline_ns_all(QEMU_CLOCK_VIRTUAL,
+                                              QEMU_TIMER_ATTR_ALL);
+
+    if (delta < 0) {
+        return -1;
+    }
+    return qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + delta;
+}
 #endif
