+static void test_hot_fork_block_barrier(void)
+{
+    QDict *options = qdict_new();
+    BlockBackend *blk;
+    QemuBlockBackendHotForkBarrierInventory barrier;
+
+    qdict_put_str(options, "driver", "null-co");
+    qdict_put_int(options, "size", 4096);
+    blk = blk_new_open(NULL, NULL, options, BDRV_O_RDWR, &error_abort);
+
+    g_assert_true(qemu_block_backend_hot_fork_barrier(
+        QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_HOLD, &barrier));
+    g_assert_true(barrier.held);
+    g_assert_true(barrier.complete);
+    g_assert_true(barrier.quiescent);
+    g_assert_cmpuint(barrier.generation, >, 0);
+    g_assert_cmpint(barrier.owner_thread_id, >, 0);
+    g_assert_cmpuint(barrier.backend_count, >=, 1);
+    g_assert_cmpuint(barrier.rooted_backends, >=, 1);
+    g_assert_cmpuint(barrier.writable_backends, >=, 1);
+    g_assert_cmpuint(barrier.quiesced_rooted_backends,
+                     ==, barrier.rooted_backends);
+    g_assert_cmpuint(barrier.in_flight, ==, 0);
+
+    g_assert_true(qemu_block_backend_hot_fork_barrier(
+        QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_RELEASE, &barrier));
+    g_assert_false(barrier.held);
+    g_assert_false(barrier.quiescent);
+    g_assert_cmpint(barrier.owner_thread_id, ==, 0);
+
+    blk_unref(blk);
+}
