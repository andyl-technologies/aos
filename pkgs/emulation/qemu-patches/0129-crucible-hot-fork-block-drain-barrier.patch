+CrucibleHotForkBlockBarrierState *
+qmp_crucible_hot_fork_block_barrier(
+    CrucibleHotForkBlockBarrierAction action, Error **errp)
+{
+    QemuBlockBackendHotForkBarrierOperation operation;
+    QemuBlockBackendHotForkBarrierInventory inventory;
+    CrucibleHotForkBlockBarrierState *report;
+
+    switch (action) {
+    case CRUCIBLE_HOT_FORK_BLOCK_BARRIER_ACTION_HOLD:
+        if (!crucible_hot_fork_exact_paused_boundary()) {
+            error_setg(errp, "Crucible hot-fork block barrier hold requires "
+                       "an exact paused/device-flush boundary");
+            return NULL;
+        }
+        operation = QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_HOLD;
+        break;
+    case CRUCIBLE_HOT_FORK_BLOCK_BARRIER_ACTION_QUERY:
+        operation = QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_QUERY;
+        break;
+    case CRUCIBLE_HOT_FORK_BLOCK_BARRIER_ACTION_RELEASE:
+        operation = QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_RELEASE;
+        break;
+    default:
+        g_assert_not_reached();
+    }
+
+    if (!qemu_block_backend_hot_fork_barrier(operation, &inventory)) {
+        error_setg(errp, "Crucible hot-fork block drain is unavailable in "
+                   "the current replay or AioContext mode");
+        return NULL;
+    }
+
+    report = g_new0(CrucibleHotForkBlockBarrierState, 1);
+    report->schema_version = 1;
+    report->generation = inventory.generation;
+    report->owner_thread_id = inventory.owner_thread_id;
+    report->held = inventory.held;
+    report->complete = inventory.complete;
+    report->backend_count = inventory.backend_count;
+    report->rooted_backends = inventory.rooted_backends;
+    report->writable_backends = inventory.writable_backends;
+    report->quiesced_rooted_backends =
+        inventory.quiesced_rooted_backends;
+    report->in_flight = inventory.in_flight;
+    report->quiescent = inventory.quiescent;
+    return report;
+}
