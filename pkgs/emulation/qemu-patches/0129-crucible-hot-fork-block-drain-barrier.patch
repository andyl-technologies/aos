+bool qemu_block_backend_hot_fork_barrier(
+    QemuBlockBackendHotForkBarrierOperation operation,
+    QemuBlockBackendHotForkBarrierInventory *inventory)
+{
+    QemuBlockBackendHotForkInventory backends;
+    uint64_t previous_backend_id = 0;
+    bool valid_entries = true;
+    size_t index;
+
+    GLOBAL_STATE_CODE();
+    *inventory = (QemuBlockBackendHotForkBarrierInventory) { 0 };
+
+    switch (operation) {
+    case QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_HOLD:
+        if (!crucible_hot_fork_block_barrier_held) {
+            if (replay_events_enabled() ||
+                qemu_get_current_aio_context() != qemu_get_aio_context()) {
+                return false;
+            }
+            bdrv_drain_all_begin_nopoll();
+            crucible_hot_fork_block_barrier_owner = qemu_get_thread_id();
+            crucible_hot_fork_block_barrier_held = true;
+            crucible_hot_fork_block_barrier_generation++;
+            assert(crucible_hot_fork_block_barrier_generation != 0);
+        }
+        break;
+    case QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_QUERY:
+        break;
+    case QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_RELEASE:
+        if (crucible_hot_fork_block_barrier_held) {
+            bdrv_drain_all_end();
+            crucible_hot_fork_block_barrier_held = false;
+            crucible_hot_fork_block_barrier_owner = 0;
+            crucible_hot_fork_block_barrier_generation++;
+            assert(crucible_hot_fork_block_barrier_generation != 0);
+        }
+        break;
+    default:
+        g_assert_not_reached();
+    }
+
+    qemu_block_backend_hot_fork_inventory(&backends);
+    inventory->generation = crucible_hot_fork_block_barrier_generation;
+    inventory->owner_thread_id = crucible_hot_fork_block_barrier_owner;
+    inventory->held = crucible_hot_fork_block_barrier_held;
+    inventory->backend_count = backends.entry_count;
+    for (index = 0; index < backends.entry_count; index++) {
+        QemuBlockBackendHotForkInventoryEntry *entry =
+            &backends.entries[index];
+
+        if (entry->backend_id == 0 || entry->context_id == 0 ||
+            entry->reference_count == 0 || !entry->name_valid ||
+            (index != 0 && entry->backend_id <= previous_backend_id)) {
+            valid_entries = false;
+        }
+        previous_backend_id = entry->backend_id;
+        inventory->rooted_backends += entry->root_present;
+        inventory->writable_backends +=
+            (entry->permissions & BLK_PERM_WRITE) != 0;
+        inventory->quiesced_rooted_backends +=
+            entry->root_present && entry->quiesce_depth != 0;
+        inventory->in_flight += entry->in_flight;
+    }
+    inventory->complete = !backends.overflowed && valid_entries;
+    inventory->quiescent = inventory->held && inventory->complete &&
+        inventory->in_flight == 0 &&
+        inventory->quiesced_rooted_backends == inventory->rooted_backends;
+    qemu_block_backend_hot_fork_inventory_destroy(&backends);
+    return true;
+}
