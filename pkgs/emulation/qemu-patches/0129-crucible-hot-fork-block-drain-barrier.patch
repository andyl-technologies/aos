   'returns': 'CrucibleHotForkBlockBackendInventory',
   'allow-oob': true }
 
+##
+# @CrucibleHotForkBlockBarrierAction:
+#
+# Operation over QEMU's reversible all-block drain section.
+#
+# @hold: quiesce every block node without waiting for already-issued I/O
+#
+# @query: observe the retained drain section without changing it
+#
+# @release: leave the all-block drain section and resume external clients
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'enum': 'CrucibleHotForkBlockBarrierAction',
+  'data': [ 'hold', 'query', 'release' ] }
+
+##
+# @CrucibleHotForkBlockBarrierState:
+#
+# Exact retained state of QEMU's native all-block drain section. This barrier
+# does not create or authenticate an immutable external snapshot.
+#
+# @schema-version: barrier contract version, currently 1
+#
+# @generation: process-local hold/release generation
+#
+# @owner-thread-id: coordinator thread that acquired the barrier, or zero when
+#     the barrier is released
+#
+# @held: whether the all-block drain section remains retained
+#
+# @complete: whether the bounded BlockBackend inventory was complete
+#
+# @backend-count: exact allocated BlockBackend count
+#
+# @rooted-backends: exact backends with a block root
+#
+# @writable-backends: exact backends requesting write permission
+#
+# @quiesced-rooted-backends: exact rooted backends inside a drain section
+#
+# @in-flight: checked aggregate BlockBackend I/O count
+#
+# @quiescent: whether every rooted backend is quiesced and no I/O is in flight
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'struct': 'CrucibleHotForkBlockBarrierState',
+  'data': { 'schema-version': 'uint32',
+            'generation': 'uint64',
+            'owner-thread-id': 'int64',
+            'held': 'bool',
+            'complete': 'bool',
+            'backend-count': 'uint64',
+            'rooted-backends': 'uint64',
+            'writable-backends': 'uint64',
+            'quiesced-rooted-backends': 'uint64',
+            'in-flight': 'uint64',
+            'quiescent': 'bool' } }
+
+##
+# @crucible-hot-fork-block-barrier:
+#
+# Holds, observes, or releases QEMU's reversible all-block drain section. Hold
+# and release execute on the main AioContext under the BQL.
+#
+# @action: requested barrier operation
+#
+# Returns: @CrucibleHotForkBlockBarrierState
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'command': 'crucible-hot-fork-block-barrier',
+  'data': { 'action': 'CrucibleHotForkBlockBarrierAction' },
+  'returns': 'CrucibleHotForkBlockBarrierState' }
+
 ##
 # @CrucibleHotForkPluginResourceInventory:
 #
