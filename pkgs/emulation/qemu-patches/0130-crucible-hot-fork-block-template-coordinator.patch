+static CrucibleHotForkBlockBarrierState *
+crucible_hot_fork_block_barrier(
+    QemuBlockBackendHotForkBarrierOperation operation, Error **errp)
+{
+    QemuBlockBackendHotForkBarrierInventory inventory;
+    CrucibleHotForkBlockBarrierState *report;
+
+    if (!qemu_block_backend_hot_fork_barrier(operation, &inventory)) {
+        error_setg(errp, "Crucible hot-fork block drain is unavailable in "
+                   "the current replay or AioContext mode");
+        return NULL;
+    }
+
+    report = g_new0(CrucibleHotForkBlockBarrierState, 1);
+    report->schema_version = 1;
+    report->generation = inventory.generation;
+    report->owner_thread_id = inventory.owner_thread_id;
+    report->held = inventory.held;
+    report->complete = inventory.complete;
+    report->backend_count = inventory.backend_count;
+    report->rooted_backends = inventory.rooted_backends;
+    report->writable_backends = inventory.writable_backends;
+    report->quiesced_rooted_backends =
+        inventory.quiesced_rooted_backends;
+    report->in_flight = inventory.in_flight;
+    report->quiescent = inventory.quiescent;
+    return report;
+}
+
+typedef enum CrucibleHotForkTemplatePhase {
+    CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_IDLE,
+    CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BLOCK_HOLD_PENDING,
+    CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BLOCK_HELD,
+    CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BARRIERS_HELD,
+    CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BLOCK_RELEASE_PENDING,
+    CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_COMPLETED,
+} CrucibleHotForkTemplatePhase;
+
 static GMutex crucible_hot_fork_template_lock;
 static uint64_t crucible_hot_fork_template_generation;
 static bool crucible_hot_fork_template_active;
+static bool crucible_hot_fork_template_block_transition_scheduled;
+static bool crucible_hot_fork_template_abort_requested;
+static CrucibleHotForkTemplatePhase crucible_hot_fork_template_phase;
+static CrucibleHotForkTemplateOutcome crucible_hot_fork_template_completion;
+
+static void crucible_hot_fork_template_schedule_block_transition(void);
+
+static void crucible_hot_fork_template_complete(
+    CrucibleHotForkTemplateOutcome outcome)
+{
+    crucible_hot_fork_template_active = false;
+    crucible_hot_fork_template_abort_requested = false;
+    crucible_hot_fork_template_phase =
+        CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_COMPLETED;
+    crucible_hot_fork_template_completion = outcome;
+}
+
+static void crucible_hot_fork_template_block_transition(void *opaque)
+{
+    QemuBlockBackendHotForkBarrierInventory inventory;
+    bool success;
+
+    (void)opaque;
+    g_mutex_lock(&crucible_hot_fork_template_lock);
+    crucible_hot_fork_template_block_transition_scheduled = false;
+    switch (crucible_hot_fork_template_phase) {
+    case CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BLOCK_HOLD_PENDING:
+        if (crucible_hot_fork_template_abort_requested) {
+            crucible_hot_fork_template_complete(
+                CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_ABORTED);
+            break;
+        }
+        success = qemu_block_backend_hot_fork_barrier(
+            QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_HOLD, &inventory);
+        if (!success || !inventory.held) {
+            crucible_hot_fork_template_complete(
+                CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_BLOCKED);
+            break;
+        }
+        if (inventory.owner_thread_id <= 0) {
+            success = qemu_block_backend_hot_fork_barrier(
+                QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_RELEASE, &inventory);
+            if (success && !inventory.held) {
+                crucible_hot_fork_template_complete(
+                    CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_BLOCKED);
+            } else {
+                crucible_hot_fork_template_completion =
+                    CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_BLOCKED;
+                crucible_hot_fork_template_phase =
+                    CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BLOCK_RELEASE_PENDING;
+                crucible_hot_fork_template_schedule_block_transition();
+            }
+            break;
+        }
+        crucible_hot_fork_template_phase =
+            CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BLOCK_HELD;
+        break;
+    case CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BLOCK_RELEASE_PENDING:
+        success = qemu_block_backend_hot_fork_barrier(
+            QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_RELEASE, &inventory);
+        if (success && !inventory.held) {
+            crucible_hot_fork_template_complete(
+                crucible_hot_fork_template_completion);
+        }
+        break;
+    default:
+        break;
+    }
+    g_mutex_unlock(&crucible_hot_fork_template_lock);
+}
+
+static void crucible_hot_fork_template_schedule_block_transition(void)
+{
+    if (crucible_hot_fork_template_block_transition_scheduled) {
+        return;
+    }
+
+    crucible_hot_fork_template_block_transition_scheduled = true;
+    aio_bh_schedule_oneshot(qemu_get_aio_context(),
+                            crucible_hot_fork_template_block_transition,
+                            NULL);
+}
+
+static bool crucible_hot_fork_template_reserves_barriers(void)
+{
+    return crucible_hot_fork_template_phase !=
+        CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_IDLE;
+}
 
