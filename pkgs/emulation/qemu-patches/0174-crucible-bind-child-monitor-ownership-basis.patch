+int monitor_hot_fork_prepare_child_basis(
+    MonitorHotForkChildBasis *basis, uint64_t expected_generation)
+{
+    MonitorHotForkInventory inventory;
+    Monitor *mon;
+    int result = 0;
+
+    if (!basis || expected_generation == 0) {
+        return -EINVAL;
+    }
+
+    qemu_mutex_lock(&monitor_lock);
+    monitor_hot_fork_inventory_locked(&inventory);
+    if (!monitor_hot_fork_inventory_is_supported(&inventory)) {
+        result = -ENOTSUP;
+        goto out;
+    }
+    if (inventory.generation != expected_generation) {
+        result = -ESTALE;
+        goto out;
+    }
+    mon = QTAILQ_FIRST(&mon_list);
+    if (!mon || QTAILQ_NEXT(mon, entry) || !monitor_is_qmp(mon) ||
+        !mon_iothread || !qmp_dispatcher_co || qmp_dispatcher_co_shutdown) {
+        result = -EPROTO;
+        goto out;
+    }
+
+    *basis = (MonitorHotForkChildBasis) {
+        .generation = expected_generation,
+        .monitor = container_of(mon, MonitorQMP, common),
+        .iothread = mon_iothread,
+        .dispatcher = qmp_dispatcher_co,
+        .prepared = true,
+    };
+out:
+    qemu_mutex_unlock(&monitor_lock);
+    return result;
+}
+
+bool monitor_hot_fork_child_basis_prepared_for(
+    const MonitorHotForkChildBasis *basis, uint64_t expected_generation)
+{
+    return basis && basis->prepared && expected_generation != 0 &&
+        basis->generation == expected_generation && basis->monitor &&
+        basis->iothread && basis->dispatcher;
+}
+
+bool monitor_hot_fork_child_basis_matches_current(
+    const MonitorHotForkChildBasis *basis, uint64_t expected_generation)
+{
+    MonitorHotForkInventory inventory;
+    Monitor *mon;
+    bool matches;
+
+    if (!monitor_hot_fork_child_basis_prepared_for(
+            basis, expected_generation)) {
+        return false;
+    }
+
+    qemu_mutex_lock(&monitor_lock);
+    monitor_hot_fork_inventory_locked(&inventory);
+    mon = QTAILQ_FIRST(&mon_list);
+    matches = monitor_hot_fork_inventory_is_supported(&inventory) &&
+        inventory.generation == expected_generation && mon &&
+        !QTAILQ_NEXT(mon, entry) && monitor_is_qmp(mon) &&
+        basis->monitor == container_of(mon, MonitorQMP, common) &&
+        basis->iothread == mon_iothread &&
+        basis->dispatcher == qmp_dispatcher_co &&
+        !qmp_dispatcher_co_shutdown;
+    qemu_mutex_unlock(&monitor_lock);
+    return matches;
+}
+
+void monitor_hot_fork_reset_child_basis(MonitorHotForkChildBasis *basis)
+{
+    if (basis) {
+        *basis = (MonitorHotForkChildBasis) { 0 };
+    }
+}
+
 static void monitor_iothread_init(void)
 {
     mon_iothread = iothread_create("mon_iothread", &error_abort);
