diff --git a/include/qemu/crucible-hot-fork-child.h b/include/qemu/crucible-hot-fork-child.h
new file mode 100644
index 000000000..e08d5749b
--- /dev/null
+++ b/include/qemu/crucible-hot-fork-child.h
@@ -0,0 +1,48 @@
+/*
+ * Crucible hot-fork child resource disposition helpers
+ *
+ * Copyright (c) Andyl, Inc.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef QEMU_CRUCIBLE_HOT_FORK_CHILD_H
+#define QEMU_CRUCIBLE_HOT_FORK_CHILD_H
+
+#define QEMU_CRUCIBLE_HOT_FORK_ENDPOINT_REPLACEMENT_COUNT 2
+
+typedef struct QemuCrucibleHotForkDescriptorReplacement {
+    int source_fd;
+    int target_fd;
+} QemuCrucibleHotForkDescriptorReplacement;
+
+typedef int (*QemuCrucibleHotForkDescriptorVerifier)(void *opaque);
+
+/**
+ * qemu_crucible_hot_fork_replace_endpoint_descriptors() - replace endpoints
+ * @replacements: exact control and wake source-to-target descriptor pairs
+ * @verify: callback that authenticates both installed target descriptions
+ * @opaque: caller-owned value passed to @verify
+ *
+ * Replaces exactly two pairwise-distinct destination descriptor slots while
+ * retaining rollback copies of both prior descriptions.  Destination
+ * close-on-exec flags are preserved.  The replacement commits only after
+ * @verify accepts both installed descriptions; successful commit closes the
+ * source descriptors, while a rejected verification restores both targets and
+ * leaves both sources open.
+ *
+ * This primitive is intended only for the quiescent immediate child of an
+ * authenticated Crucible fork transaction.  The caller must terminate that
+ * child after any error.  In particular, -EUCLEAN means that rollback could
+ * not be proved and no descriptor may be used.
+ *
+ * Returns zero after exact replacement and verification, a negative errno-style
+ * status when validation, replacement, or verification fails with complete
+ * rollback, or -EUCLEAN when rollback itself is incomplete.
+ */
+int qemu_crucible_hot_fork_replace_endpoint_descriptors(
+    const QemuCrucibleHotForkDescriptorReplacement
+        replacements[QEMU_CRUCIBLE_HOT_FORK_ENDPOINT_REPLACEMENT_COUNT],
+    QemuCrucibleHotForkDescriptorVerifier verify,
+    void *opaque);
+
+#endif
