+static int create_sealed_mapping_backing(const char *name, uint64_t length)
+{
+    int fd = memfd_create(name, MFD_CLOEXEC | MFD_ALLOW_SEALING);
+
+    g_assert_cmpint(fd, >=, 0);
+    g_assert_cmpint(ftruncate(fd, length), ==, 0);
+    g_assert_cmpint(fcntl(fd, F_ADD_SEALS, F_SEAL_SHRINK), ==, 0);
+    return fd;
+}
+
+static void test_mapping_table_rejects_wrong_shared_backing(void)
+{
+    QemuCrucibleHotForkDescriptorTableTransaction transaction = {
+        .parent_pid = getpid(),
+        .child_pid = getpid(),
+        .active = false,
+        .descriptors_applied = true,
+        .mappings_verified = false,
+    };
+    uint64_t page_size = qemu_real_host_page_size();
+    int actual_fd = create_sealed_mapping_backing(
+        "crucible-hot-fork-actual", page_size);
+    int wrong_fd = create_sealed_mapping_backing(
+        "crucible-hot-fork-wrong", page_size);
+    void *mapping = mmap(NULL, page_size, PROT_READ | PROT_WRITE,
+                         MAP_SHARED, actual_fd, 0);
+    QemuCrucibleHotForkSharedMapping shared_mapping = {
+        .start = (uintptr_t)mapping,
+        .length = page_size,
+        .offset = 0,
+        .backing_fd = wrong_fd,
+    };
+
+    g_assert_true(mapping != MAP_FAILED);
+    g_assert_cmpint(qemu_crucible_hot_fork_verify_mapping_table(
+                        &transaction, &shared_mapping, 1),
+                    ==, -EPERM);
+    g_assert_false(transaction.descriptors_applied);
+    g_assert_false(transaction.mappings_verified);
+    g_assert_cmpint(munmap(mapping, page_size), ==, 0);
+    close(actual_fd);
+    close(wrong_fd);
+}
