+static bool crucible_hot_fork_parse_decimal(const char *bytes, size_t length,
+                                            uint64_t *value)
+{
+    uint64_t parsed = 0;
+
+    if (length == 0) {
+        return false;
+    }
+    for (size_t index = 0; index < length; index++) {
+        unsigned int digit;
+
+        if (bytes[index] < '0' || bytes[index] > '9') {
+            return false;
+        }
+        digit = bytes[index] - '0';
+        if (parsed > (UINT64_MAX - digit) / 10) {
+            return false;
+        }
+        parsed = parsed * 10 + digit;
+    }
+    *value = parsed;
+    return true;
+}
+
+static const char *crucible_hot_fork_next_mapping_field(
+    const char *cursor, const char *record_end, const char **field_end)
+{
+    while (cursor < record_end && *cursor == ' ') {
+        cursor++;
+    }
+    if (cursor == record_end) {
+        return NULL;
+    }
+    *field_end = memchr(cursor, ' ', record_end - cursor);
+    if (!*field_end) {
+        *field_end = record_end;
+    }
+    return cursor;
+}
