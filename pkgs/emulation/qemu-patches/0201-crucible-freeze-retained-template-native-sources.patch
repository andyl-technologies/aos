+static void test_hot_fork_frozen_snapshot_binding(
+    BlockBackend *backend, const QemuBlockBackendHotForkSnapshotBinding *binding)
+{
+    QemuBlockHotForkSourceRoot root = { backend, blk_bs(backend) };
+    QemuBlockHotForkSourceSet *sources =
+        qemu_block_hot_fork_source_set_new(&root, 1, &error_abort);
+    QemuBlockBackendHotForkBarrierInventory barrier;
+    QemuBlockBackendHotForkSnapshotBinding wrong = *binding;
+
+    g_assert_true(qemu_block_backend_hot_fork_barrier(
+        QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_HOLD, &barrier));
+    qemu_block_backend_hot_fork_barrier_inventory_destroy(&barrier);
+    g_assert_false(qemu_block_backend_hot_fork_snapshot_bind_frozen(
+        sources, binding, 1, &barrier, NULL));
+    g_assert_true(qemu_block_backend_hot_fork_barrier(
+        QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_RELEASE, &barrier));
+    qemu_block_backend_hot_fork_barrier_inventory_destroy(&barrier);
+
+    g_assert_true(qemu_block_hot_fork_source_set_freeze(sources, &error_abort));
+    g_assert_true(qemu_block_backend_hot_fork_barrier(
+        QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_HOLD, &barrier));
+    g_assert_cmpuint(barrier.writable_rooted_backends, ==, 0);
+    qemu_block_backend_hot_fork_barrier_inventory_destroy(&barrier);
+    g_assert_false(qemu_block_backend_hot_fork_snapshot_bind(
+        binding, 1, &barrier, NULL));
+    g_assert_false(qemu_block_backend_hot_fork_snapshot_bind_frozen(
+        NULL, binding, 1, &barrier, NULL));
+    g_assert_false(qemu_block_backend_hot_fork_snapshot_bind_frozen(
+        sources, NULL, 0, &barrier, NULL));
+    g_strlcpy(wrong.overlay_node_name, "wrong-overlay", sizeof(wrong.overlay_node_name));
+    g_assert_false(qemu_block_backend_hot_fork_snapshot_bind_frozen(
+        sources, &wrong, 1, &barrier, NULL));
+    g_assert_true(qemu_block_backend_hot_fork_snapshot_bind_frozen(
+        sources, binding, 1, &barrier, &error_abort));
+    g_assert_true(barrier.snapshot_complete);
+    g_assert_true(barrier.snapshot_sources.frozen);
+    g_assert_cmpuint(barrier.snapshot_root_count, ==, 1);
+    g_assert_cmpuint(barrier.writable_rooted_backends, ==, 0);
+    g_assert_cmpuint(barrier.snapshot_sources.roots, ==, 1);
+    g_assert_cmpuint(barrier.snapshot_sources.nodes, ==, 4);
+    g_assert_cmpuint(barrier.snapshot_sources.originally_writable_roots, ==, 1);
+    g_assert_cmpuint(barrier.snapshot_sources.originally_writable_backends, ==, 1);
+    qemu_block_backend_hot_fork_barrier_inventory_destroy(&barrier);
+    g_assert_false(qemu_block_hot_fork_source_set_restore(sources, NULL));
+    g_assert_true(qemu_block_backend_hot_fork_barrier(
+        QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_RELEASE, &barrier));
+    g_assert_false(barrier.snapshot_sources.frozen);
+    g_assert_cmpuint(barrier.snapshot_sources.roots, ==, 0);
+    g_assert_cmpuint(barrier.snapshot_sources.nodes, ==, 0);
+    g_assert_cmpuint(barrier.snapshot_sources.originally_writable_roots, ==, 0);
+    g_assert_cmpuint(barrier.snapshot_sources.originally_writable_backends, ==, 0);
+    qemu_block_backend_hot_fork_barrier_inventory_destroy(&barrier);
+    g_assert_true(qemu_block_hot_fork_source_set_restore(sources, &error_abort));
+    g_assert_true(qemu_block_hot_fork_source_set_free(sources, &error_abort));
+}
