+            !qemu_block_hot_fork_source_set_free(set, NULL) &&
+            qemu_block_hot_fork_source_set_release_empty_child(set, NULL);
+
+        _exit(released ? 0 : 1);
+    }
+    g_assert_cmpint(waitpid(child, &status, 0), ==, child);
+    g_assert_true(WIFEXITED(status));
+    g_assert_cmpint(WEXITSTATUS(status), ==, 0);
+    /* Child container disposal cannot consume the parent's retained owner. */
+    g_assert_true(qemu_block_hot_fork_source_set_query(set, &inventory,
