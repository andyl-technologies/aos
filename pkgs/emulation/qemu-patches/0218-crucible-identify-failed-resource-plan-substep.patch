     const QemuCrucibleHotForkSharedMapping *shared_mappings,
     size_t shared_mapping_count);
 
+/*
+ * Sub-step of the child resource plan application that is running or that
+ * failed, for the child's exit status: 1 plan preconditions, 2 descriptor
+ * table, 3 child runtime start, 4 plugin reinitialization, 5 child runtime
+ * finish, 6 QMP reinitialization, 7 console reinitialization, 8 mapping
+ * table verification, 9 runtime disposition, 10 diagnostics target.  The
+ * preconditions of the application record 11 arguments, 12 plan and
+ * descriptor transaction state, 13 runtime transaction state, 14 plan
+ * validity, 15 plugin reinitializer, 16 QMP reinitializer, 17 console
+ * reinitializer.  Zero means the application has not started.
+ */
+void qemu_crucible_hot_fork_note_child_detail(unsigned int detail);
+unsigned int qemu_crucible_hot_fork_child_detail(void);
+
 #endif
diff --git a/monitor/qmp-cmds.c b/monitor/qmp-cmds.c
index d7caa7f41..387bba11b 100644
--- a/monitor/qmp-cmds.c
+++ b/monitor/qmp-cmds.c
@@ -4596,11 +4596,19 @@ static int crucible_hot_fork_apply_child_process_contract(
  * release, 13 child file installation, 14 empty native release, 15 monitor
  * input release.  Guarded launch gives the child no stderr; the source
  * reports the status through crucible-hot-fork-child-process after reap.
+ * A failure inside step 9 instead exits with the detail base plus the
+ * sub-step recorded by the child resource plan application.
  */
 #define CRUCIBLE_HOT_FORK_CHILD_STEP_EXIT_BASE 64
+#define CRUCIBLE_HOT_FORK_CHILD_DETAIL_EXIT_BASE 96
 
 static void G_NORETURN crucible_hot_fork_child_exit_at(unsigned int step)
 {
+    unsigned int detail = qemu_crucible_hot_fork_child_detail();
+
+    if (step == 9 && detail != 0) {
+        _exit(CRUCIBLE_HOT_FORK_CHILD_DETAIL_EXIT_BASE + detail);
+    }
     _exit(CRUCIBLE_HOT_FORK_CHILD_STEP_EXIT_BASE + step);
 }
 
