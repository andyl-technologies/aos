+int64_t icount_get_raw_observed(void)
+{
+    CPUState *cpu = current_cpu;
+    int64_t icount;
+    unsigned start;
+
+    do {
+        int64_t executed = 0;
+
+        start = seqlock_read_begin(&timers_state.vm_clock_seqlock);
+        icount = qatomic_read_i64(&timers_state.qemu_icount);
+        if (cpu && cpu->running) {
+            executed = icount_get_executed(cpu);
+            if (executed < 0 || icount > INT64_MAX - executed) {
+                return -1;
+            }
+            icount += executed;
+        }
+    } while (seqlock_read_retry(&timers_state.vm_clock_seqlock, start));
+
+    return icount;
+}
