--- a/plugins/crucible-fault-lifecycle.c
+++ b/plugins/crucible-fault-lifecycle.c
@@ -117,7 +117,7 @@ static uint32_t crucible_lifecycle_terminal_transition;
 static bool crucible_lifecycle_terminal_exit_requested;
 static uint8_t crucible_lifecycle_terminal_action_sha256[32];
 static uint8_t crucible_lifecycle_terminal_evidence_sha256[32];
-static uint64_t crucible_lifecycle_terminal_process_generation;
+static uint64_t crucible_lifecycle_process_generation;
 
 static void crucible_lifecycle_sha256(const uint8_t *data, size_t length,
                                       uint8_t digest[32]);
