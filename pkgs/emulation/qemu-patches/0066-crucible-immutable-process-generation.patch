+++ b/include/qemu/qemu-plugin.h
@@ -2091,6 +2091,19 @@ struct qemu_plugin_crucible_fault_result {
     uint8_t evidence_hash[32];
 };
 
+/**
+ * qemu_plugin_crucible_lifecycle_set_process_generation() - bind generation
+ * @process_generation: nonzero host-provisioned process generation
+ *
+ * Binds the immutable generation before fault commands are admitted.  A second
+ * call, including one that repeats the same value, is rejected.
+ *
+ * Returns zero on success or a negative errno value on failure.
+ */
+QEMU_PLUGIN_API
+int qemu_plugin_crucible_lifecycle_set_process_generation(
+    uint64_t process_generation);
+
