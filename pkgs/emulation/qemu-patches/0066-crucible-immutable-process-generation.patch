            qemu_crucible_fault_rule_action_hash(rule), 32);
     crucible_lifecycle_sha256(
@@ -189,6 +188,23 @@ static void crucible_lifecycle_stage_terminal(
         crucible_lifecycle_terminal_evidence_sha256);
 }
 
+int qemu_plugin_crucible_lifecycle_set_process_generation(
+    uint64_t process_generation)
+{
+    if (!crucible_lifecycle_mode()) {
+        return -EPERM;
+    }
+    if (process_generation == 0) {
+        return -EINVAL;
+    }
+    if (crucible_lifecycle_process_generation != 0 ||
+        crucible_lifecycle_terminal_transition != 0) {
+        return -EALREADY;
+    }
+    crucible_lifecycle_process_generation = process_generation;
+    return 0;
+}
+
