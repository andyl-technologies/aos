+    RR_TCG_EXEC_ACTIVE_WAKE_PENDING,
 };
 
+static bool rr_crucible_sim_complete_wake_boundary(void)
+{
+    while (true) {
+        unsigned int completed_state;
+        unsigned int state = qatomic_read(&rr_tcg_exec_state);
+
+        if (state == RR_TCG_EXEC_STARTING_WAKE_ARMING ||
+            state == RR_TCG_EXEC_IDLE_WAKE_ARMING) {
+            cpu_relax();
+            continue;
+        }
+        completed_state =
+            state == RR_TCG_EXEC_STARTING ?
+                RR_TCG_EXEC_STARTING : RR_TCG_EXEC_IDLE;
+
+        if (qatomic_cmpxchg(&rr_tcg_exec_state, state,
+                            completed_state) == state) {
+            return state == RR_TCG_EXEC_IDLE_WAKE_PENDING ||
+                   state == RR_TCG_EXEC_ACTIVE_WAKE_PENDING;
+        }
+    }
+}
+
+static void rr_crucible_sim_complete_initial_wait(void)
+{
+    while (true) {
+        unsigned int state = qatomic_read(&rr_tcg_exec_state);
+
+        if (state == RR_TCG_EXEC_STARTING_WAKE_ARMING) {
+            cpu_relax();
+            continue;
+        }
+        if (state == RR_TCG_EXEC_STARTING &&
+            qatomic_cmpxchg(&rr_tcg_exec_state,
+                            RR_TCG_EXEC_STARTING,
+                            RR_TCG_EXEC_IDLE) == RR_TCG_EXEC_STARTING) {
+            return;
+        }
+    }
+}
+
+static bool rr_crucible_sim_prepare_tcg(void)
+{
+    while (true) {
+        unsigned int state = qatomic_read(&rr_tcg_exec_state);
+
+        if (state == RR_TCG_EXEC_IDLE) {
+            if (qatomic_cmpxchg(&rr_tcg_exec_state,
+                                RR_TCG_EXEC_IDLE,
+                                RR_TCG_EXEC_ACTIVE) != RR_TCG_EXEC_IDLE) {
+                continue;
+            }
+            return false;
+        }
+        if (state == RR_TCG_EXEC_ACTIVE) {
+            return false;
+        }
+        if (state == RR_TCG_EXEC_STARTING ||
+            state == RR_TCG_EXEC_STARTING_WAKE_ARMING ||
+            state == RR_TCG_EXEC_IDLE_WAKE_ARMING) {
+            cpu_relax();
+            continue;
+        }
+        /* Active wakes remain pending across every partial RR slice. */
+        if (state == RR_TCG_EXEC_ACTIVE_WAKE_PENDING &&
+            icount_crucible_rr_cursor_position() != 0) {
+            return false;
+        }
+        if (qatomic_cmpxchg(&rr_tcg_exec_state, state,
+                            RR_TCG_EXEC_IDLE) == state) {
+            return true;
+        }
+    }
+}
