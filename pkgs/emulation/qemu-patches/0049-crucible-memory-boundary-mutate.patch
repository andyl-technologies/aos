+static bool test_corrupt_commit_precondition;
+static bool test_tamper_after_prepare;
+static bool test_expect_tb_invalidation;
+static bool test_expect_execution_effect;
+static bool test_expect_unchanged_byte;
+static bool test_defer_submit;
+static bool test_current_tb_target;
+static bool test_submitted;
+static uint32_t test_expected_translations;
+static uint32_t test_minimum_fragments = 1;
+static uint8_t test_expected_translation[32];
+static uint8_t *test_before_data;
+static uint8_t *test_after_data;
