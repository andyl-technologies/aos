+static uint64_t test_execution_result_address;
+static uint64_t test_unchanged_address;
+static bool test_validated;
+static uint8_t test_action_hashes[2][32];
+
+static uint16_t test_get_u16(const uint8_t *bytes)
+{
+    return bytes[0] | (uint16_t)bytes[1] << 8;
+}
+
+static uint32_t test_get_u32(const uint8_t *bytes)
+{
+    return bytes[0] | (uint32_t)bytes[1] << 8 |
+           (uint32_t)bytes[2] << 16 | (uint32_t)bytes[3] << 24;
+}
+
+static uint64_t test_get_u64(const uint8_t *bytes)
+{
+    return test_get_u32(bytes) | (uint64_t)test_get_u32(bytes + 4) << 32;
+}
+
+static void test_put_u16(uint8_t *bytes, uint16_t value)
+{
+    bytes[0] = value;
+    bytes[1] = value >> 8;
+}
+
+static void test_put_u32(uint8_t *bytes, uint32_t value)
+{
+    for (size_t i = 0; i < 4; i++) {
+        bytes[i] = value >> (8 * i);
+    }
+}
+
+static void test_put_u64(uint8_t *bytes, uint64_t value)
+{
+    for (size_t i = 0; i < 8; i++) {
+        bytes[i] = value >> (8 * i);
+    }
+}
+
+static void test_fail(const char *message)
+{
+    g_printerr("Crucible memory mutation live test failed: %s\n", message);
+    abort();
+}
+
+static bool test_read_target_memory(uint64_t address, GByteArray *data,
+                                    size_t length)
+{
+    if (test_address_space == CRUCIBLE_MEMORY_MUTATION_ADDRESS_GPA) {
+        return qemu_plugin_crucible_read_memory_paddr(address, data, length);
+    }
+    return qemu_plugin_read_memory_vaddr(address, data, length);
+}
+
+static uint8_t *test_build_batch(const uint8_t *first, size_t first_len,
+                                 const uint8_t *second, size_t second_len,
+                                 size_t *batch_len)
+{
+    size_t count = second ? 2 : 1;
+    size_t records_len = count * CRUCIBLE_MEMORY_MUTATION_BATCH_RECORD_V1_BYTES +
+                         first_len + second_len;
+    uint8_t *batch = g_malloc0(
+        CRUCIBLE_MEMORY_MUTATION_BATCH_HEADER_V1_BYTES + records_len);
+    size_t offset = CRUCIBLE_MEMORY_MUTATION_BATCH_BODY_OFFSET;
+
+    memcpy(batch, CRUCIBLE_MEMORY_MUTATION_BATCH_MAGIC_V1, 8);
+    test_put_u16(batch + CRUCIBLE_MEMORY_MUTATION_BATCH_VERSION_OFFSET,
+                 CRUCIBLE_MEMORY_MUTATION_BATCH_VERSION_V1);
+    test_put_u32(batch + CRUCIBLE_MEMORY_MUTATION_BATCH_COUNT_OFFSET, count);
+    test_put_u32(batch + CRUCIBLE_MEMORY_MUTATION_BATCH_RECORDS_LENGTH_OFFSET,
+                 records_len);
+    memcpy(batch + offset, test_action_hashes[0], 32);
+    test_put_u32(batch + offset +
+                     CRUCIBLE_MEMORY_MUTATION_BATCH_RECORD_LENGTH_OFFSET,
+                 first_len);
+    offset += CRUCIBLE_MEMORY_MUTATION_BATCH_RECORD_V1_BYTES;
+    memcpy(batch + offset, first, first_len);
+    offset += first_len;
+    if (second) {
+        memcpy(batch + offset, test_action_hashes[1], 32);
+        test_put_u32(batch + offset +
+                         CRUCIBLE_MEMORY_MUTATION_BATCH_RECORD_LENGTH_OFFSET,
+                     second_len);
+        offset += CRUCIBLE_MEMORY_MUTATION_BATCH_RECORD_V1_BYTES;
+        memcpy(batch + offset, second, second_len);
+        offset += second_len;
+    }
+    *batch_len = offset;
+    return batch;
+}
+
+static const uint8_t *test_batch_evidence_action(const uint8_t *evidence,
+                                                  size_t evidence_len,
+                                                  size_t index,
+                                                  size_t *action_len)
+{
+    uint32_t count;
+    size_t offset = CRUCIBLE_MEMORY_MUTATION_BATCH_EVIDENCE_BODY_OFFSET;
+
+    if (evidence_len < CRUCIBLE_MEMORY_MUTATION_BATCH_EVIDENCE_HEADER_V1_BYTES ||
+        memcmp(evidence, CRUCIBLE_MEMORY_MUTATION_BATCH_EVIDENCE_MAGIC_V1,
+               8) != 0 ||
+        test_get_u16(evidence +
+                     CRUCIBLE_MEMORY_MUTATION_BATCH_EVIDENCE_VERSION_OFFSET) !=
+            CRUCIBLE_MEMORY_MUTATION_BATCH_EVIDENCE_VERSION_V1) {
+        test_fail("batch evidence header is not canonical");
+    }
+    count = test_get_u32(
+        evidence + CRUCIBLE_MEMORY_MUTATION_BATCH_EVIDENCE_COUNT_OFFSET);
+    if (count != (test_overlap_order ? 2 : 1) || index >= count ||
+        CRUCIBLE_MEMORY_MUTATION_BATCH_EVIDENCE_HEADER_V1_BYTES +
+                test_get_u32(evidence +
+                    CRUCIBLE_MEMORY_MUTATION_BATCH_EVIDENCE_RECORDS_LENGTH_OFFSET) !=
+            evidence_len) {
+        test_fail("batch evidence action count or length is incorrect");
+    }
+    for (size_t current = 0; current < count; current++) {
+        size_t record_end = offset +
+            CRUCIBLE_MEMORY_MUTATION_BATCH_EVIDENCE_RECORD_V1_BYTES;
+        size_t nested_len;
+
+        if (record_end > evidence_len ||
+            memcmp(evidence + offset, test_action_hashes[current], 32) != 0) {
+            test_fail("batch evidence action identity is incorrect");
+        }
+        nested_len = test_get_u32(
+            evidence + offset +
+            CRUCIBLE_MEMORY_MUTATION_BATCH_RECORD_LENGTH_OFFSET);
+        if (record_end + nested_len > evidence_len) {
+            test_fail("batch evidence nested record exceeds its envelope");
+        }
+        if (current == index) {
+            *action_len = nested_len;
+            return evidence + record_end;
+        }
+        offset = record_end + nested_len;
+    }
+    test_fail("batch evidence action was not found");
+    return NULL;
+}
+
+static void test_validate_action_evidence(const uint8_t *evidence,
+                                          size_t evidence_len, size_t index)
+{
+    uint8_t overlap_before = index == 0 ? 0x5a : 0x0f;
+    uint8_t overlap_after = index == 0 ? 0x0f : 0xa5;
+    const uint8_t *expected_before = test_overlap_order ?
+        &overlap_before : test_before_data;
+    const uint8_t *expected_after = test_overlap_order ?
+        &overlap_after : test_after_data;
+    uint32_t expected_length = test_overlap_order ? 1 : test_length;
+    uint32_t translations;
+    uint32_t fragments;
+    uint32_t mappings;
+    uint32_t dirty_ranges;
+    uint32_t inline_len;
+    uint32_t expected_inline_len;
+    size_t fragments_offset;
+    size_t inline_offset;
+    bool saw_tb_invalidation = false;
+
+    if (evidence_len < CRUCIBLE_MEMORY_MUTATION_EVIDENCE_HEADER_V1_BYTES ||
+        memcmp(evidence, CRUCIBLE_MEMORY_MUTATION_EVIDENCE_MAGIC_V1, 8) != 0 ||
+        test_get_u16(evidence +
+                     CRUCIBLE_MEMORY_MUTATION_EVIDENCE_VERSION_OFFSET) !=
+            CRUCIBLE_MEMORY_MUTATION_EVIDENCE_VERSION_V1 ||
+        test_get_u64(evidence +
+                     CRUCIBLE_MEMORY_MUTATION_EVIDENCE_OBSERVED_ICOUNT_OFFSET) !=
+            test_icount ||
+        test_get_u64(evidence +
+                     CRUCIBLE_MEMORY_MUTATION_EVIDENCE_ADDRESS_OFFSET) !=
+            test_address ||
+        test_get_u16(evidence +
+                     CRUCIBLE_MEMORY_MUTATION_EVIDENCE_ADDRESS_SPACE_OFFSET) !=
+            test_address_space ||
+        test_get_u16(evidence +
+                     CRUCIBLE_MEMORY_MUTATION_EVIDENCE_TRANSFORM_OFFSET) !=
+            test_transform ||
+        test_get_u32(evidence +
+                     CRUCIBLE_MEMORY_MUTATION_EVIDENCE_LENGTH_OFFSET) !=
+            expected_length ||
+        memcmp(evidence +
+                   CRUCIBLE_MEMORY_MUTATION_EVIDENCE_TRANSLATION_SHA256_OFFSET,
+               test_expected_translation, 32) != 0) {
+        test_fail("per-action evidence header is not canonical");
+    }
+    translations = test_get_u32(evidence +
+        CRUCIBLE_MEMORY_MUTATION_EVIDENCE_TRANSLATION_COUNT_OFFSET);
+    fragments = test_get_u32(evidence +
+        CRUCIBLE_MEMORY_MUTATION_EVIDENCE_FRAGMENT_COUNT_OFFSET);
+    mappings = test_get_u32(evidence +
+        CRUCIBLE_MEMORY_MUTATION_EVIDENCE_MAPPING_COUNT_OFFSET);
+    dirty_ranges = test_get_u32(evidence +
+        CRUCIBLE_MEMORY_MUTATION_EVIDENCE_DIRTY_COUNT_OFFSET);
+    inline_len = test_get_u32(evidence +
+        CRUCIBLE_MEMORY_MUTATION_EVIDENCE_INLINE_LENGTH_OFFSET);
+    expected_inline_len = expected_length <=
+        CRUCIBLE_MEMORY_MUTATION_EVIDENCE_INLINE_BYTES ? expected_length : 0;
+    fragments_offset = CRUCIBLE_MEMORY_MUTATION_EVIDENCE_HEADER_V1_BYTES +
+        translations * CRUCIBLE_MEMORY_TRANSLATION_RECORD_V1_BYTES;
+    for (uint32_t i = 0; i < fragments; i++) {
+        size_t flags_offset = fragments_offset +
+            i * CRUCIBLE_MEMORY_MUTATION_FRAGMENT_V1_BYTES +
+            CRUCIBLE_MEMORY_MUTATION_FRAGMENT_FLAGS_OFFSET;
+
+        if (test_get_u16(evidence + flags_offset) &
+            CRUCIBLE_MEMORY_MUTATION_FRAGMENT_TB_INVALIDATED) {
+            saw_tb_invalidation = true;
+        }
+    }
+    inline_offset = CRUCIBLE_MEMORY_MUTATION_EVIDENCE_HEADER_V1_BYTES +
+        translations * CRUCIBLE_MEMORY_TRANSLATION_RECORD_V1_BYTES +
+        fragments * CRUCIBLE_MEMORY_MUTATION_FRAGMENT_V1_BYTES +
+        mappings * CRUCIBLE_MEMORY_MAPPING_RECORD_V1_BYTES +
+        dirty_ranges * CRUCIBLE_MEMORY_DIRTY_RANGE_V1_BYTES;
+    if (translations != test_expected_translations ||
+        fragments < test_minimum_fragments || mappings == 0 ||
+        dirty_ranges == 0 || inline_len != expected_inline_len ||
+        inline_offset + 2 * expected_inline_len != evidence_len ||
+        (expected_inline_len != 0 &&
+         (memcmp(evidence + inline_offset, expected_before,
+                 expected_length) != 0 ||
+          memcmp(evidence + inline_offset + expected_length, expected_after,
+                 expected_length) != 0))) {
+        test_fail("per-action evidence records or inline bytes are incomplete");
+    }
+    if (test_expect_tb_invalidation &&
+        (!(test_get_u16(evidence +
+            CRUCIBLE_MEMORY_MUTATION_EVIDENCE_FLAGS_OFFSET) &
+           CRUCIBLE_MEMORY_MUTATION_EVIDENCE_FLAG_TB_INVALIDATED) ||
+         !saw_tb_invalidation)) {
+        test_fail("mutation did not publish required TB invalidation evidence");
+    }
+}
+
+static void test_validate_result(void)
+{
+    struct qemu_plugin_crucible_fault_result result = { 0 };
+    size_t evidence_len = 0;
+    int status = qemu_plugin_crucible_fault_poll(
+        &result, test_evidence, 2 * 1024 * 1024, &evidence_len);
+
+    if (status == 0) {
+        return;
+    }
+    if (status != 1 ||
+        result.command_kind != CRUCIBLE_FAULT_COMMAND_MEMORY_MUTATION ||
+        result.command_sequence != (test_prepared ? 2 : 1) ||
+        (result.status != CRUCIBLE_FAULT_STATUS_MALFORMED_COMMAND &&
+         result.observed_icount != test_icount) ||
+        result.applied_icount !=
+            (result.status == CRUCIBLE_FAULT_STATUS_APPLIED ? test_icount : 0)) {
+        test_fail("result status, sequence, or boundary metadata is incorrect");
+    }
+    if (!test_prepared &&
+        test_expected_status != CRUCIBLE_FAULT_STATUS_APPLIED &&
+        !test_corrupt_commit_precondition && !test_tamper_after_prepare) {
+        if (result.status != test_expected_status || evidence_len != 0 ||
+            memcmp(result.after_hash, result.before_hash, 32) != 0) {
+            test_fail("rejected preparation published evidence or changed bytes");
+        }
+        if (test_expect_unchanged_byte &&
+            (!test_read_target_memory(test_unchanged_address,
+                                      test_observed_byte, 1) ||
+             test_observed_byte->data[0] != test_before)) {
+            test_fail("rejected batch changed its valid prefix");
+        }
+        test_validated = true;
+        g_printerr("CRUCIBLE_MEMORY_MUTATION_LIVE_PASS\n");
+        qemu_plugin_request_shutdown(0);
+        return;
+    }
+    if (!test_prepared) {
+        uint64_t commit_icount = qemu_plugin_icount_raw();
+
+        if (result.status != CRUCIBLE_FAULT_STATUS_PREPARED) {
+            g_printerr("prepare status=%u expected=%u\n", result.status,
+                       CRUCIBLE_FAULT_STATUS_PREPARED);
+            test_fail("preparation returned the wrong status");
+        }
+        if (evidence_len <
+            CRUCIBLE_MEMORY_MUTATION_BATCH_EVIDENCE_HEADER_V1_BYTES) {
+            g_printerr("prepare evidence length=%zu minimum=%u\n",
+                       evidence_len,
+                       CRUCIBLE_MEMORY_MUTATION_BATCH_EVIDENCE_HEADER_V1_BYTES);
+            test_fail("preparation omitted batch evidence");
+        }
+        if (!test_read_target_memory(test_address,
+                                     test_observed_byte, test_length)) {
+            test_fail("preparation memory verification read failed");
+        }
+        if (memcmp(test_observed_byte->data, test_before_data,
+                   test_length) != 0) {
+            test_fail("preparation changed memory");
+        }
+        test_batch_evidence_action(test_evidence, evidence_len, 0,
+                                   &(size_t){ 0 });
+        test_prepared_evidence = g_memdup2(test_evidence, evidence_len);
+        test_prepared_evidence_len = evidence_len;
+        memcpy(test_deferred_payload +
+                   CRUCIBLE_MEMORY_MUTATION_BATCH_PRECONDITION_OFFSET,
+               test_evidence +
+                   CRUCIBLE_MEMORY_MUTATION_BATCH_EVIDENCE_PRECONDITION_OFFSET,
+               32);
+        memcpy(test_deferred_command.expected_precondition_hash,
+               test_evidence +
+                   CRUCIBLE_MEMORY_MUTATION_BATCH_EVIDENCE_PRECONDITION_OFFSET,
+               32);
+        if (test_corrupt_commit_precondition) {
+            test_deferred_command.expected_precondition_hash[0] ^= 0xff;
+            test_deferred_payload[
+                CRUCIBLE_MEMORY_MUTATION_BATCH_PRECONDITION_OFFSET] ^= 0xff;
+        }
+        if (test_tamper_after_prepare) {
+            size_t nested = CRUCIBLE_MEMORY_MUTATION_BATCH_BODY_OFFSET +
+                CRUCIBLE_MEMORY_MUTATION_BATCH_RECORD_V1_BYTES;
+            test_deferred_payload[nested +
+                CRUCIBLE_MEMORY_MUTATION_BODY_OFFSET + test_length] ^= 0xff;
+        }
+        test_deferred_command.command_flags = 0;
+        test_deferred_command.command_sequence = 2;
+        test_deferred_command.target_icount = commit_icount;
+        test_deferred_command.authorization_ceiling_icount = commit_icount;
+        test_icount = commit_icount;
+        if (qemu_plugin_crucible_fault_submit(
+                &test_deferred_command, test_deferred_payload,
+                test_deferred_payload_len) != 0) {
+            test_fail("QEMU rejected commit after successful preparation");
+        }
+        test_prepared = true;
+        qemu_plugin_force_vcpu_exit();
+        return;
+    }
+    if (result.status != test_expected_status) {
+        test_fail("commit result status is incorrect");
+    }
+    if (test_expected_status != CRUCIBLE_FAULT_STATUS_APPLIED) {
+        if (evidence_len != 0 ||
+            !test_read_target_memory(test_address,
+                                     test_observed_byte, test_length) ||
+            memcmp(test_observed_byte->data, test_before_data,
+                   test_length) != 0) {
+            test_fail("rejected commit changed memory or published evidence");
+        }
+    } else {
+        bool memory_read = test_read_target_memory(
+            test_address, test_observed_byte, test_length);
+        if (evidence_len != test_prepared_evidence_len) {
+            g_printerr("prepared evidence length=%zu commit length=%zu\n",
+                       test_prepared_evidence_len, evidence_len);
+            test_fail("commit evidence length differs from preparation");
+        }
+        if (memcmp(test_evidence, test_prepared_evidence, evidence_len) != 0) {
+            for (size_t i = 0; i < evidence_len; i++) {
+                if (test_evidence[i] != test_prepared_evidence[i]) {
+                    g_printerr("first evidence difference offset=%zu prepared=%02x commit=%02x\n",
+                               i, test_prepared_evidence[i], test_evidence[i]);
+                    break;
+                }
+            }
+            test_fail("commit evidence bytes differ from preparation");
+        }
+        if (!memory_read) {
+            test_fail("could not read final memory");
+        }
+        if (memcmp(test_observed_byte->data, test_after_data,
+                   test_length) != 0) {
+            g_printerr("final first byte=%02x expected=%02x\n",
+                       test_observed_byte->data[0], test_after_data[0]);
+            test_fail("commit evidence or final memory differs from preparation");
+        }
+        for (size_t i = 0; i < (test_overlap_order ? 2 : 1); i++) {
+            size_t action_len;
+            const uint8_t *action = test_batch_evidence_action(
+                test_evidence, evidence_len, i, &action_len);
+            test_validate_action_evidence(action, action_len, i);
+        }
+        if (test_evidence_path &&
+            !g_file_set_contents(test_evidence_path,
+                                 (const char *)test_evidence,
+                                 evidence_len, NULL)) {
+            test_fail("could not write the requested batch evidence file");
+        }
+    }
+    test_validated = true;
+    g_printerr("CRUCIBLE_MEMORY_MUTATION_LIVE_PASS\n");
+    qemu_plugin_request_shutdown(0);
+}
+
+static void test_fault_completion(void *opaque)
+{
+    (void)opaque;
+    if (!test_validated) {
+        test_validate_result();
+    }
+}
+
+static void test_tb_exec(unsigned int cpu_index, void *opaque)
+{
+    (void)cpu_index;
+    (void)opaque;
+    if (!test_submitted) {
+        uint64_t current_icount;
+
+        if (!qemu_plugin_read_memory_vaddr(test_paging_ready_address,
+                                           test_paging_ready, 1) ||
+            test_paging_ready->data[0] != 0x5a) {
+            return;
+        }
+        current_icount = qemu_plugin_icount_raw();
+        if (test_current_tb_target) {
+            test_icount = current_icount;
+        } else {
+            if (UINT64_MAX - current_icount < test_icount) {
+                test_fail("deferred target icount overflows u64");
+            }
+            test_icount += current_icount;
+        }
+        test_deferred_command.target_icount = test_icount;
+        test_deferred_command.authorization_ceiling_icount = test_icount;
+        if (qemu_plugin_crucible_fault_submit(
+                &test_deferred_command, test_deferred_payload,
+                test_deferred_payload_len) != 0) {
+            test_fail(
+                "QEMU rejected deferred live memory mutation command");
+        }
+        test_submitted = true;
+        if (test_current_tb_target) {
+            qemu_plugin_force_vcpu_exit();
+        }
+        return;
+    }
+    if (test_expect_execution_effect &&
+        (!qemu_plugin_read_memory_vaddr(test_execution_result_address,
+                                        test_observed_byte, 1) ||
+         test_observed_byte->data[0] != test_after)) {
+        return;
+    }
+    if (!test_validated) {
+        test_validate_result();
+    }
+}
+
+static void test_tb_trans(qemu_plugin_id_t id, struct qemu_plugin_tb *tb)
+{
+    (void)id;
+    qemu_plugin_register_vcpu_tb_exec_cb(
+        tb, test_tb_exec, QEMU_PLUGIN_CB_NO_REGS, NULL);
+}
+
+static void test_exit(qemu_plugin_id_t id, void *opaque)
+{
+    (void)id;
+    (void)opaque;
+    if (!test_validated) {
+        test_fail("applied result was not validated before process exit");
+    }
+    g_free(test_before_data);
+    g_free(test_after_data);
+    g_free(test_before_hex);
+    g_free(test_after_hex);
+    g_free(test_evidence_path);
+    g_free(test_evidence);
+    g_free(test_prepared_evidence);
+    g_free(test_deferred_payload);
+    g_byte_array_unref(test_paging_ready);
+    g_byte_array_unref(test_observed_byte);
+}
+
+static bool test_parse_u64(const char *argument, const char *prefix,
+                           uint64_t *value)
+{
+    const char *text;
+    char *end;
+
+    if (!g_str_has_prefix(argument, prefix)) {
+        return false;
+    }
+    text = argument + strlen(prefix);
+    *value = g_ascii_strtoull(text, &end, 0);
+    if (!text[0] || *end) {
+        test_fail("plugin numeric argument is malformed");
+    }
+    return true;
+}
+
+static bool test_parse_name(const char *argument, const char *prefix,
+                            const char **value)
+{
+    if (!g_str_has_prefix(argument, prefix)) {
+        return false;
+    }
+    *value = argument + strlen(prefix);
+    if (!**value) {
+        test_fail("plugin named argument is empty");
+    }
+    return true;
+}
+
+static bool test_parse_digest(const char *argument, const char *prefix,
+                              uint8_t digest[32])
+{
+    const char *text;
+
+    if (!test_parse_name(argument, prefix, &text)) {
+        return false;
+    }
+    if (strlen(text) != 64) {
+        test_fail("translation digest must contain 64 hexadecimal digits");
+    }
+    for (size_t i = 0; i < 32; i++) {
+        int high = g_ascii_xdigit_value(text[2 * i]);
+        int low = g_ascii_xdigit_value(text[2 * i + 1]);
+
+        if (high < 0 || low < 0) {
+            test_fail("translation digest contains a non-hexadecimal digit");
+        }
+        digest[i] = high << 4 | low;
+    }
+    return true;
+}
+
+static void test_decode_bytes(const char *text, uint8_t repeated,
+                              uint8_t *bytes)
+{
+    if (!text) {
+        memset(bytes, repeated, test_length);
+        return;
+    }
+    if (strlen(text) != 2 * test_length) {
+        test_fail("byte string length does not match mutation length");
+    }
+    for (size_t i = 0; i < test_length; i++) {
+        int high = g_ascii_xdigit_value(text[2 * i]);
+        int low = g_ascii_xdigit_value(text[2 * i + 1]);
+
+        if (high < 0 || low < 0) {
+            test_fail("byte string contains a non-hexadecimal digit");
+        }
+        bytes[i] = high << 4 | low;
+    }
+}
+
+QEMU_PLUGIN_EXPORT int qemu_plugin_install(qemu_plugin_id_t id,
+                                           const qemu_info_t *info,
+                                           int argc, char **argv)
+{
+    struct qemu_plugin_crucible_fault_command command = { 0 };
+    struct qemu_plugin_crucible_fault_capability capabilities[64];
+    g_autofree uint8_t *payload = NULL;
+    uint64_t parsed;
+    size_t count;
+    size_t payload_len;
+    uint32_t wire_length;
+    const char *name;
+
+    if (!info->system_emulation || info->system.smp_vcpus != 1 ||
+        (strcmp(info->target_name, "x86_64") != 0 &&
+         strcmp(info->target_name, "aarch64") != 0)) {
+        test_fail("test requires one x86_64 or aarch64 system vCPU");
+    }
+    for (int i = 0; i < argc; i++) {
+        if (test_parse_u64(argv[i], "address=", &test_address)) {
+            continue;
+        }
+        if (test_parse_u64(argv[i], "before=", &parsed)) {
+            if (parsed > UINT8_MAX) {
+                test_fail("before byte exceeds u8");
+            }
+            test_before = parsed;
+            continue;
+        }
+        if (test_parse_u64(argv[i], "after=", &parsed)) {
+            if (parsed > UINT8_MAX) {
+                test_fail("after byte exceeds u8");
+            }
+            test_after = parsed;
+            continue;
+        }
+        if (test_parse_u64(argv[i], "length=", &parsed)) {
+            if (parsed == 0 || parsed > CRUCIBLE_MEMORY_MUTATION_HARD_BYTES) {
+                test_fail("length is outside the supported mutation bound");
+            }
+            test_length = parsed;
+            continue;
+        }
+        if (test_parse_u64(argv[i], "vcpu=", &parsed)) {
+            if (parsed > UINT32_MAX) {
+                test_fail("vCPU index exceeds u32");
+            }
+            test_vcpu = parsed;
+            continue;
+        }
+        if (test_parse_u64(argv[i], "icount=", &test_icount)) {
+            continue;
+        }
+        if (test_parse_u64(argv[i], "translations=", &parsed)) {
+            if (parsed > UINT32_MAX) {
+                test_fail("translation count exceeds u32");
+            }
+            test_expected_translations = parsed;
+            continue;
+        }
+        if (test_parse_u64(argv[i], "fragments=", &parsed)) {
+            if (parsed == 0 || parsed > UINT32_MAX) {
+                test_fail("minimum fragment count is invalid");
+            }
+            test_minimum_fragments = parsed;
+            continue;
+        }
+        if (test_parse_u64(argv[i], "execution-result=", &parsed)) {
+            test_execution_result_address = parsed;
+            test_expect_execution_effect = true;
+            continue;
+        }
+        if (test_parse_u64(argv[i], "unchanged-vaddr=", &parsed)) {
+            test_unchanged_address = parsed;
+            test_expect_unchanged_byte = true;
+            continue;
+        }
+        if (test_parse_u64(argv[i], "paging-ready=", &parsed)) {
+            test_paging_ready_address = parsed;
+            continue;
+        }
+        if (test_parse_digest(argv[i], "translation=",
+                              test_expected_translation)) {
+            continue;
+        }
+        if (test_parse_name(argv[i], "before-bytes=", &name)) {
+            g_free(test_before_hex);
+            test_before_hex = g_strdup(name);
+            continue;
+        }
+        if (test_parse_name(argv[i], "after-bytes=", &name)) {
+            g_free(test_after_hex);
+            test_after_hex = g_strdup(name);
+            continue;
+        }
+        if (test_parse_name(argv[i], "evidence=", &name)) {
+            g_free(test_evidence_path);
+            test_evidence_path = g_strdup(name);
+            continue;
+        }
+        if (test_parse_name(argv[i], "address-space=", &name)) {
+            if (strcmp(name, "gpa") == 0) {
+                test_address_space = CRUCIBLE_MEMORY_MUTATION_ADDRESS_GPA;
+            } else if (strcmp(name, "gva") == 0) {
+                test_address_space = CRUCIBLE_MEMORY_MUTATION_ADDRESS_GVA;
+            } else {
+                test_fail("address-space must be gpa or gva");
+            }
+            continue;
+        }
+        if (test_parse_name(argv[i], "transform=", &name)) {
+            if (strcmp(name, "replace") == 0) {
+                test_transform = CRUCIBLE_MEMORY_MUTATION_TRANSFORM_REPLACE;
+            } else if (strcmp(name, "bit-flip") == 0) {
+                test_transform = CRUCIBLE_MEMORY_MUTATION_TRANSFORM_BIT_FLIP;
+            } else {
+                test_fail("transform must be replace or bit-flip");
+            }
+            continue;
+        }
+        if (test_parse_name(argv[i], "status=", &name)) {
+            if (strcmp(name, "applied") == 0) {
+                test_expected_status = CRUCIBLE_FAULT_STATUS_APPLIED;
+            } else if (strcmp(name, "precondition-mismatch") == 0) {
+                test_expected_status =
+                    CRUCIBLE_FAULT_STATUS_PRECONDITION_MISMATCH;
+                test_corrupt_commit_precondition = true;
+            } else if (strcmp(name, "prepared-state-mismatch") == 0) {
+                test_expected_status =
+                    CRUCIBLE_FAULT_STATUS_PRECONDITION_MISMATCH;
+                test_tamper_after_prepare = true;
+            } else if (strcmp(name, "invalid-target") == 0) {
+                test_expected_status = CRUCIBLE_FAULT_STATUS_INVALID_TARGET;
+            } else if (strcmp(name, "malformed-command") == 0) {
+                test_expected_status = CRUCIBLE_FAULT_STATUS_MALFORMED_COMMAND;
+            } else {
+                test_fail("unsupported expected result status");
+            }
+            continue;
+        }
+        if (test_parse_name(argv[i], "tb-invalidated=", &name)) {
+            if (strcmp(name, "required") != 0) {
+                test_fail("tb-invalidated must be required");
+            }
+            test_expect_tb_invalidation = true;
+            continue;
+        }
+        if (test_parse_name(argv[i], "submit=", &name)) {
+            if (strcmp(name, "paging-ready") != 0) {
+                test_fail("submit must be paging-ready");
+            }
+            test_defer_submit = true;
+            continue;
+        }
+        if (test_parse_name(argv[i], "target-mode=", &name)) {
+            if (strcmp(name, "current-tb") != 0) {
+                test_fail("target-mode must be current-tb");
+            }
+            test_current_tb_target = true;
+            continue;
+        }
+        if (test_parse_name(argv[i], "malformed=", &name)) {
+            if (strcmp(name, "zero-length") == 0) {
+                test_malformed = 1;
+            } else if (strcmp(name, "overflow") == 0) {
+                test_malformed = 2;
+            } else if (strcmp(name, "over-limit") == 0) {
+                test_malformed = 3;
+            } else {
+                test_fail("unsupported malformed payload case");
+            }
+            test_expected_status = CRUCIBLE_FAULT_STATUS_MALFORMED_COMMAND;
+            continue;
+        }
+        if (test_parse_name(argv[i], "mode=", &name)) {
+            if (strcmp(name, "overlap-order") == 0) {
+                test_overlap_order = true;
+            } else {
+                test_fail("unsupported live test mode");
+            }
+            continue;
+        }
+        test_fail("unknown plugin argument");
+    }
+    count = qemu_plugin_crucible_fault_capabilities(NULL, 0);
+    bool found_memory = false;
+    if (count < 3 || count > G_N_ELEMENTS(capabilities) ||
+        qemu_plugin_crucible_fault_capabilities(
+            capabilities, G_N_ELEMENTS(capabilities)) != count) {
+        test_fail("fault capability registry could not be copied atomically");
+    }
+    for (size_t i = 0; i < count; i++) {
+        if (capabilities[i].command_kind ==
+            CRUCIBLE_FAULT_COMMAND_MEMORY_MUTATION &&
+            capabilities[i].required_feature_bits ==
+                CRUCIBLE_FAULT_CAPABILITY_FEATURE_MEMORY_MUTATION &&
+            capabilities[i].semantic_version ==
+                CRUCIBLE_FAULT_COMMAND_SEMANTIC_VERSION &&
+            capabilities[i].phase_mask ==
+                1U << (CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY - 1) &&
+            capabilities[i].maximum_payload_bytes ==
+                CRUCIBLE_FAULT_HARD_PAYLOAD_BYTES &&
+            capabilities[i].maximum_pending_commands ==
+                CRUCIBLE_FAULT_DEFAULT_COMMAND_CAPACITY &&
+            capabilities[i].scope ==
+                (strcmp(info->target_name, "x86_64") == 0 ?
+                     QEMU_PLUGIN_CRUCIBLE_FAULT_SCOPE_X86_64 :
+                     QEMU_PLUGIN_CRUCIBLE_FAULT_SCOPE_AARCH64) &&
+            strcmp(capabilities[i].name,
+                   strcmp(info->target_name, "x86_64") == 0 ?
+                       "qemu.memory.mutate.x86_64.v1" :
+                       "qemu.memory.mutate.aarch64.v1") == 0 &&
+            strcmp(capabilities[i].payload_schema,
+                   "crucible.memory-mutation-batch-payload.v1") == 0) {
+            if (found_memory) {
+                test_fail("memory mutation capability was duplicated");
+            }
+            found_memory = true;
+        }
+    }
+    if (!found_memory) {
+        test_fail("memory mutation capability was not advertised exactly");
+    }
+    if (test_current_tb_target && !test_defer_submit) {
+        test_fail("current-tb target mode requires deferred submission");
+    }
+    if (test_address_space == CRUCIBLE_MEMORY_MUTATION_ADDRESS_GPA) {
+        test_vcpu = CRUCIBLE_MEMORY_MUTATION_NO_VCPU;
+        memset(test_expected_translation, 0, 32);
+        test_expected_translations = 0;
+    } else if (test_vcpu == CRUCIBLE_MEMORY_MUTATION_NO_VCPU) {
+        test_fail("GVA mutation requires an explicit vCPU index");
+    }
+    if (test_overlap_order &&
+        (test_address_space != CRUCIBLE_MEMORY_MUTATION_ADDRESS_GPA ||
+         test_transform != CRUCIBLE_MEMORY_MUTATION_TRANSFORM_REPLACE ||
+         test_length != 1 || test_malformed ||
+         test_expected_status != CRUCIBLE_FAULT_STATUS_APPLIED ||
+         test_before != 0x5a || test_after != 0xa5 ||
+         test_before_hex || test_after_hex || test_defer_submit)) {
+        test_fail("overlap-order mode requires its canonical byte defaults");
+    }
+    if (test_expect_execution_effect &&
+        test_expected_status != CRUCIBLE_FAULT_STATUS_APPLIED) {
+        test_fail("execution-result requires an applied mutation");
+    }
+    if (test_expect_unchanged_byte &&
+        test_expected_status == CRUCIBLE_FAULT_STATUS_APPLIED) {
+        test_fail("unchanged-vaddr requires a rejected mutation");
+    }
+    wire_length = test_malformed == 1 ? 0 :
+                  test_malformed == 2 ? 2 :
+                  test_malformed == 3 ?
+                      CRUCIBLE_MEMORY_MUTATION_HARD_BYTES + 1 : test_length;
+    if (test_malformed == 2) {
+        test_address = UINT64_MAX;
+    }
+    payload_len = CRUCIBLE_MEMORY_MUTATION_BODY_OFFSET + wire_length;
+    if (test_transform == CRUCIBLE_MEMORY_MUTATION_TRANSFORM_REPLACE) {
+        payload_len += wire_length;
+    }
+    payload = g_malloc0(payload_len);
+    test_before_data = g_malloc(test_length);
+    test_after_data = g_malloc(test_length);
+    test_decode_bytes(test_before_hex, test_before, test_before_data);
+    test_decode_bytes(test_after_hex, test_after, test_after_data);
+    memcpy(payload, CRUCIBLE_MEMORY_MUTATION_PAYLOAD_MAGIC_V1, 8);
+    test_put_u16(payload + CRUCIBLE_MEMORY_MUTATION_VERSION_OFFSET,
+                 CRUCIBLE_MEMORY_MUTATION_PAYLOAD_VERSION_V1);
+    test_put_u16(payload + CRUCIBLE_MEMORY_MUTATION_ADDRESS_SPACE_OFFSET,
+                 test_address_space);
+    test_put_u16(payload + CRUCIBLE_MEMORY_MUTATION_TRANSFORM_OFFSET,
+                 test_transform);
+    test_put_u16(payload + CRUCIBLE_MEMORY_MUTATION_ATOMICITY_OFFSET,
+                 CRUCIBLE_MEMORY_MUTATION_ATOMIC_ALL_OR_NOTHING);
+    test_put_u32(payload + CRUCIBLE_MEMORY_MUTATION_VCPU_INDEX_OFFSET,
+                 test_vcpu);
+    test_put_u32(payload + CRUCIBLE_MEMORY_MUTATION_LENGTH_OFFSET,
+                 wire_length);
+    test_put_u64(payload + CRUCIBLE_MEMORY_MUTATION_ADDRESS_OFFSET,
+                 test_address);
+    test_put_u32(payload + CRUCIBLE_MEMORY_MUTATION_MASK_LENGTH_OFFSET,
+                 wire_length);
+    test_put_u32(payload + CRUCIBLE_MEMORY_MUTATION_VALUES_LENGTH_OFFSET,
+                 test_transform == CRUCIBLE_MEMORY_MUTATION_TRANSFORM_REPLACE ?
+                     wire_length : 0);
+    memset(payload + CRUCIBLE_MEMORY_MUTATION_TRANSLATION_SHA256_OFFSET, 0,
+           32);
+    if (test_transform == CRUCIBLE_MEMORY_MUTATION_TRANSFORM_REPLACE) {
+        memset(payload + CRUCIBLE_MEMORY_MUTATION_BODY_OFFSET, 0xff,
+               wire_length);
+    } else {
+        for (size_t i = 0; i < wire_length; i++) {
+            payload[CRUCIBLE_MEMORY_MUTATION_BODY_OFFSET + i] =
+                test_before_data[i % test_length] ^
+                test_after_data[i % test_length];
+        }
+    }
+    if (test_transform == CRUCIBLE_MEMORY_MUTATION_TRANSFORM_REPLACE) {
+        for (size_t i = 0; i < wire_length; i++) {
+            payload[CRUCIBLE_MEMORY_MUTATION_BODY_OFFSET + wire_length + i] =
+                test_after_data[i % test_length];
+        }
+    }
+    command.abi_major = CRUCIBLE_FAULT_COMMAND_ABI_MAJOR;
+    command.abi_minor = CRUCIBLE_FAULT_COMMAND_ABI_MINOR;
+    command.command_kind = CRUCIBLE_FAULT_COMMAND_MEMORY_MUTATION;
+    command.phase = CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY;
+    command.semantic_version = CRUCIBLE_FAULT_COMMAND_SEMANTIC_VERSION;
+    command.command_sequence = 1;
+    memset(command.target_node_hash, 0x11, 32);
+    command.target_icount = test_icount;
+    command.authorization_ceiling_icount = test_icount;
+    command.command_flags = CRUCIBLE_FAULT_COMMAND_FLAG_PREPARE_ONLY;
+    memset(command.expected_precondition_hash, 0, 32);
+    memset(test_action_hashes[0], 0x21, 32);
+    memset(test_action_hashes[1], 0x22, 32);
+    if (test_overlap_order) {
+        uint8_t intermediate = 0x0f;
+        g_autofree uint8_t *second = g_memdup2(payload, payload_len);
+        uint8_t *batch;
+
+        payload[CRUCIBLE_MEMORY_MUTATION_BODY_OFFSET + wire_length] =
+            intermediate;
+        batch = test_build_batch(payload, payload_len, second, payload_len,
+                                 &test_deferred_payload_len);
+        g_free(g_steal_pointer(&payload));
+        payload = batch;
+        payload_len = test_deferred_payload_len;
+    } else {
+        uint8_t *batch = test_build_batch(payload, payload_len, NULL, 0,
+                                          &test_deferred_payload_len);
+
+        g_free(g_steal_pointer(&payload));
+        payload = batch;
+        payload_len = test_deferred_payload_len;
+    }
+    test_deferred_command = command;
+    test_deferred_payload = g_steal_pointer(&payload);
+    test_deferred_payload_len = payload_len;
+    if (!test_defer_submit) {
+        if (qemu_plugin_crucible_fault_submit(
+                &test_deferred_command, test_deferred_payload,
+                test_deferred_payload_len) != 0) {
+            test_fail("QEMU rejected live memory mutation preparation");
+        }
+        test_submitted = true;
+    }
+    test_evidence = g_malloc0(2 * 1024 * 1024);
+    test_paging_ready = g_byte_array_new();
+    test_observed_byte = g_byte_array_new();
+    qemu_plugin_register_vcpu_tb_trans_cb(id, test_tb_trans);
+    qemu_plugin_register_crucible_fault_completion_cb(
+        test_fault_completion, NULL);
+    qemu_plugin_register_atexit_cb(id, test_exit, NULL);
+    return 0;
+}
