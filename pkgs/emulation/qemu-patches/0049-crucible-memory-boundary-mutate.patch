diff --git a/plugins/crucible-fault-memory.c b/plugins/crucible-fault-memory.c
new file mode 100644
index 0000000..b1422b8
--- /dev/null
+++ b/plugins/crucible-fault-memory.c
@@ -0,0 +1,1394 @@
+/*
+ * Crucible deterministic guest-RAM boundary mutation
+ *
+ * Copyright (c) 2026 ANDYL Technologies
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "exec/address-spaces.h"
+#include "exec/cpu-common.h"
+#include "exec/memory.h"
+#include "hw/core/cpu.h"
+#include "qemu/crucible-fault.h"
+#include "qemu/module.h"
+#include "qom/object.h"
+
+#define CRUCIBLE_MEMORY_MAX_MAPPINGS 16384
+#define CRUCIBLE_MEMORY_DIRTY_PAGE_SIZE 4096
+
+typedef struct CrucibleMemoryMapping {
+    MemoryRegion *mr;
+    uint8_t *host;
+    uint64_t gpa;
+    uint64_t length;
+    uint64_t mr_offset;
+    uint64_t ram_block_offset;
+    uint8_t mr_identity[32];
+    uint8_t ram_block_identity[32];
+} CrucibleMemoryMapping;
+
+typedef struct CrucibleMemoryTranslation {
+    uint64_t virtual_page;
+    uint64_t physical_page;
+    uint64_t page_size;
+    uint16_t permissions;
+    uint16_t attributes;
+    uint32_t covered_bytes;
+} CrucibleMemoryTranslation;
+
+typedef struct CrucibleMemoryFragment {
+    CrucibleMemoryMapping *mapping;
+    uint64_t gpa;
+    uint32_t request_offset;
+    uint32_t length;
+    uint32_t flags;
+    uint64_t mr_offset;
+    uint64_t ram_block_offset;
+    uint8_t mr_identity[32];
+    uint8_t ram_block_identity[32];
+} CrucibleMemoryFragment;
+
+typedef struct CrucibleMemoryDirtyRange {
+    uint8_t ram_block_identity[32];
+    uint64_t offset;
+    uint64_t end;
+} CrucibleMemoryDirtyRange;
+
+typedef struct CrucibleMemoryMutation {
+    uint16_t address_space;
+    uint16_t transform;
+    uint32_t vcpu_index;
+    uint64_t address;
+    uint32_t length;
+    bool prepare_only;
+    uint8_t expected_translation[32];
+    uint8_t *mask;
+    uint8_t *values;
+    GArray *mappings;
+    GArray *translations;
+    GArray *fragments;
+    GArray *dirty_ranges;
+    GByteArray *before;
+    GByteArray *after;
+    uint8_t translation_hash[32];
+    uint8_t mapping_hash[32];
+    uint8_t dirty_hash[32];
+    uint8_t before_hash[32];
+    uint8_t after_hash[32];
+    uint8_t precondition_hash[32];
+} CrucibleMemoryMutation;
+
+typedef struct CrucibleMemoryBatchAction {
+    uint8_t action_hash[32];
+    CrucibleMemoryMutation *mutation;
+    GByteArray *evidence;
+} CrucibleMemoryBatchAction;
+
+typedef struct CrucibleMemoryBatch {
+    bool prepare_only;
+    uint8_t expected_precondition[32];
+    uint8_t precondition_hash[32];
+    GPtrArray *actions;
+} CrucibleMemoryBatch;
+
+typedef struct CrucibleMemoryMapCollector {
+    GArray *mappings;
+    int status;
+} CrucibleMemoryMapCollector;
+
+static uint16_t crucible_lduw(const uint8_t *bytes, size_t offset)
+{
+    return lduw_le_p(bytes + offset);
+}
+
+static uint32_t crucible_ldl(const uint8_t *bytes, size_t offset)
+{
+    return ldl_le_p(bytes + offset);
+}
+
+static uint64_t crucible_ldq(const uint8_t *bytes, size_t offset)
+{
+    return ldq_le_p(bytes + offset);
+}
+
+static void crucible_sha256_parts(const void *first, size_t first_len,
+                                  const void *second, size_t second_len,
+                                  uint8_t digest[32])
+{
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    gsize digest_len = 32;
+
+    g_checksum_update(checksum, first, first_len);
+    if (second_len) {
+        g_checksum_update(checksum, second, second_len);
+    }
+    g_checksum_get_digest(checksum, digest, &digest_len);
+    g_assert(digest_len == 32);
+}
+
+static void crucible_checksum_u16(GChecksum *checksum, uint16_t value)
+{
+    uint8_t bytes[2];
+
+    stw_le_p(bytes, value);
+    g_checksum_update(checksum, bytes, sizeof(bytes));
+}
+
+static void crucible_checksum_u32(GChecksum *checksum, uint32_t value)
+{
+    uint8_t bytes[4];
+
+    stl_le_p(bytes, value);
+    g_checksum_update(checksum, bytes, sizeof(bytes));
+}
+
+static void crucible_checksum_u64(GChecksum *checksum, uint64_t value)
+{
+    uint8_t bytes[8];
+
+    stq_le_p(bytes, value);
+    g_checksum_update(checksum, bytes, sizeof(bytes));
+}
+
+static void crucible_checksum_finish(GChecksum *checksum, uint8_t digest[32])
+{
+    gsize digest_len = 32;
+
+    g_checksum_get_digest(checksum, digest, &digest_len);
+    g_assert(digest_len == 32);
+}
+
+static void crucible_memory_precondition(
+    const CrucibleMemoryMutation *mutation, const uint8_t before_hash[32],
+    const uint8_t after_hash[32], uint8_t digest[32])
+{
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+
+    g_checksum_update(
+        checksum,
+        (const uint8_t *)CRUCIBLE_MEMORY_MUTATION_PRECONDITION_SHA256_DOMAIN_V1,
+        CRUCIBLE_MEMORY_MUTATION_PRECONDITION_SHA256_DOMAIN_V1_BYTES);
+    g_checksum_update(checksum, before_hash, 32);
+    g_checksum_update(checksum, after_hash, 32);
+    g_checksum_update(checksum, mutation->translation_hash, 32);
+    g_checksum_update(checksum, mutation->mapping_hash, 32);
+    crucible_checksum_finish(checksum, digest);
+}
+
+static bool crucible_digest_is_zero(const uint8_t digest[32])
+{
+    uint8_t combined = 0;
+
+    for (size_t i = 0; i < 32; i++) {
+        combined |= digest[i];
+    }
+    return combined == 0;
+}
+
+static int crucible_memory_parse(const uint8_t *payload, size_t payload_len,
+                                 CrucibleMemoryMutation *mutation,
+                                 bool allocate,
+                                 bool allow_unresolved_translation)
+{
+    uint32_t length;
+    uint32_t mask_length;
+    uint32_t values_length;
+    size_t expected;
+
+    if (!payload || !mutation ||
+        payload_len < CRUCIBLE_MEMORY_MUTATION_PAYLOAD_HEADER_V1_BYTES ||
+        memcmp(payload, CRUCIBLE_MEMORY_MUTATION_PAYLOAD_MAGIC_V1, 8) != 0 ||
+        crucible_lduw(payload, CRUCIBLE_MEMORY_MUTATION_VERSION_OFFSET) !=
+            CRUCIBLE_MEMORY_MUTATION_PAYLOAD_VERSION_V1 ||
+        crucible_lduw(payload, CRUCIBLE_MEMORY_MUTATION_ATOMICITY_OFFSET) !=
+            CRUCIBLE_MEMORY_MUTATION_ATOMIC_ALL_OR_NOTHING) {
+        return -EINVAL;
+    }
+    for (size_t i = CRUCIBLE_MEMORY_MUTATION_RESERVED_OFFSET;
+         i < CRUCIBLE_MEMORY_MUTATION_BODY_OFFSET; i++) {
+        if (payload[i] != 0) {
+            return -EINVAL;
+        }
+    }
+    length = crucible_ldl(payload, CRUCIBLE_MEMORY_MUTATION_LENGTH_OFFSET);
+    mask_length = crucible_ldl(payload,
+                               CRUCIBLE_MEMORY_MUTATION_MASK_LENGTH_OFFSET);
+    values_length = crucible_ldl(payload,
+                                 CRUCIBLE_MEMORY_MUTATION_VALUES_LENGTH_OFFSET);
+    expected = CRUCIBLE_MEMORY_MUTATION_BODY_OFFSET +
+               (size_t)mask_length + values_length;
+    if (length == 0 || length > CRUCIBLE_MEMORY_MUTATION_HARD_BYTES ||
+        mask_length != length ||
+        payload_len > CRUCIBLE_FAULT_HARD_PAYLOAD_BYTES ||
+        expected != payload_len) {
+        return -EINVAL;
+    }
+    mutation->address_space = crucible_lduw(
+        payload, CRUCIBLE_MEMORY_MUTATION_ADDRESS_SPACE_OFFSET);
+    mutation->transform = crucible_lduw(
+        payload, CRUCIBLE_MEMORY_MUTATION_TRANSFORM_OFFSET);
+    mutation->vcpu_index = crucible_ldl(
+        payload, CRUCIBLE_MEMORY_MUTATION_VCPU_INDEX_OFFSET);
+    mutation->address = crucible_ldq(payload,
+                                     CRUCIBLE_MEMORY_MUTATION_ADDRESS_OFFSET);
+    mutation->length = length;
+    if (mutation->address > UINT64_MAX - (length - 1) ||
+        (mutation->transform == CRUCIBLE_MEMORY_MUTATION_TRANSFORM_BIT_FLIP &&
+         values_length != 0) ||
+        (mutation->transform == CRUCIBLE_MEMORY_MUTATION_TRANSFORM_REPLACE &&
+         values_length != length) ||
+        (mutation->transform != CRUCIBLE_MEMORY_MUTATION_TRANSFORM_BIT_FLIP &&
+         mutation->transform != CRUCIBLE_MEMORY_MUTATION_TRANSFORM_REPLACE)) {
+        return -EINVAL;
+    }
+    memcpy(mutation->expected_translation,
+           payload + CRUCIBLE_MEMORY_MUTATION_TRANSLATION_SHA256_OFFSET, 32);
+    if ((mutation->address_space == CRUCIBLE_MEMORY_MUTATION_ADDRESS_GPA &&
+         (mutation->vcpu_index != CRUCIBLE_MEMORY_MUTATION_NO_VCPU ||
+          !crucible_digest_is_zero(mutation->expected_translation))) ||
+        (mutation->address_space == CRUCIBLE_MEMORY_MUTATION_ADDRESS_GVA &&
+         (mutation->vcpu_index == CRUCIBLE_MEMORY_MUTATION_NO_VCPU ||
+          (allow_unresolved_translation &&
+           !crucible_digest_is_zero(mutation->expected_translation)) ||
+          (!allow_unresolved_translation &&
+           crucible_digest_is_zero(mutation->expected_translation)))) ||
+        (mutation->address_space != CRUCIBLE_MEMORY_MUTATION_ADDRESS_GPA &&
+         mutation->address_space != CRUCIBLE_MEMORY_MUTATION_ADDRESS_GVA)) {
+        return -EINVAL;
+    }
+    if (allocate) {
+        mutation->mask = g_memdup2(
+            payload + CRUCIBLE_MEMORY_MUTATION_BODY_OFFSET, length);
+        if (values_length) {
+            mutation->values = g_memdup2(
+                payload + CRUCIBLE_MEMORY_MUTATION_BODY_OFFSET + length,
+                length);
+        }
+    }
+    return 0;
+}
+
+static void crucible_memory_mutation_free(CrucibleMemoryMutation *mutation)
+{
+    if (!mutation) {
+        return;
+    }
+    g_free(mutation->mask);
+    g_free(mutation->values);
+    g_clear_pointer(&mutation->mappings, g_array_unref);
+    g_clear_pointer(&mutation->translations, g_array_unref);
+    g_clear_pointer(&mutation->fragments, g_array_unref);
+    g_clear_pointer(&mutation->dirty_ranges, g_array_unref);
+    g_clear_pointer(&mutation->before, g_byte_array_unref);
+    g_clear_pointer(&mutation->after, g_byte_array_unref);
+    g_free(mutation);
+}
+
+static void crucible_memory_batch_action_free(gpointer opaque)
+{
+    CrucibleMemoryBatchAction *action = opaque;
+
+    if (!action) {
+        return;
+    }
+    crucible_memory_mutation_free(action->mutation);
+    g_clear_pointer(&action->evidence, g_byte_array_unref);
+    g_free(action);
+}
+
+static void crucible_memory_batch_free(void *opaque)
+{
+    CrucibleMemoryBatch *batch = opaque;
+
+    if (!batch) {
+        return;
+    }
+    g_clear_pointer(&batch->actions, g_ptr_array_unref);
+    g_free(batch);
+}
+
+static int crucible_memory_batch_parse(
+    const struct qemu_plugin_crucible_fault_command *command,
+    const uint8_t *payload, size_t payload_len, bool allocate,
+    CrucibleMemoryBatch **batch_out)
+{
+    bool prepare_only = command->command_flags &
+                        CRUCIBLE_FAULT_COMMAND_FLAG_PREPARE_ONLY;
+    g_autoptr(GPtrArray) actions = g_ptr_array_new_with_free_func(
+        crucible_memory_batch_action_free);
+    uint32_t count;
+    uint32_t records_length;
+    uint64_t total_changed = 0;
+    size_t offset;
+
+    if (command->phase != CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY ||
+        crucible_digest_is_zero(command->target_node_hash) || !payload ||
+        payload_len < CRUCIBLE_MEMORY_MUTATION_BATCH_HEADER_V1_BYTES ||
+        payload_len > CRUCIBLE_FAULT_HARD_PAYLOAD_BYTES ||
+        memcmp(payload, CRUCIBLE_MEMORY_MUTATION_BATCH_MAGIC_V1, 8) != 0 ||
+        crucible_lduw(payload, CRUCIBLE_MEMORY_MUTATION_BATCH_VERSION_OFFSET) !=
+            CRUCIBLE_MEMORY_MUTATION_BATCH_VERSION_V1 ||
+        crucible_lduw(payload, 10) != 0) {
+        return -EINVAL;
+    }
+    for (size_t i = CRUCIBLE_MEMORY_MUTATION_BATCH_RESERVED_OFFSET;
+         i < CRUCIBLE_MEMORY_MUTATION_BATCH_BODY_OFFSET; i++) {
+        if (payload[i] != 0) {
+            return -EINVAL;
+        }
+    }
+    count = crucible_ldl(payload, CRUCIBLE_MEMORY_MUTATION_BATCH_COUNT_OFFSET);
+    records_length = crucible_ldl(
+        payload, CRUCIBLE_MEMORY_MUTATION_BATCH_RECORDS_LENGTH_OFFSET);
+    if (count == 0 || count > CRUCIBLE_MEMORY_MUTATION_BATCH_MAX_ACTIONS ||
+        records_length !=
+            payload_len - CRUCIBLE_MEMORY_MUTATION_BATCH_BODY_OFFSET ||
+        (prepare_only &&
+         (!crucible_digest_is_zero(command->expected_precondition_hash) ||
+          !crucible_digest_is_zero(
+              payload + CRUCIBLE_MEMORY_MUTATION_BATCH_PRECONDITION_OFFSET))) ||
+        (!prepare_only &&
+         (crucible_digest_is_zero(command->expected_precondition_hash) ||
+          memcmp(command->expected_precondition_hash,
+                 payload + CRUCIBLE_MEMORY_MUTATION_BATCH_PRECONDITION_OFFSET,
+                 32) != 0))) {
+        return -EINVAL;
+    }
+    offset = CRUCIBLE_MEMORY_MUTATION_BATCH_BODY_OFFSET;
+    for (uint32_t index = 0; index < count; index++) {
+        CrucibleMemoryBatchAction *action;
+        uint32_t nested_length;
+        size_t nested_offset;
+        size_t nested_end;
+
+        if (offset > payload_len -
+                         CRUCIBLE_MEMORY_MUTATION_BATCH_RECORD_V1_BYTES) {
+            return -EINVAL;
+        }
+        nested_length = crucible_ldl(
+            payload + offset,
+            CRUCIBLE_MEMORY_MUTATION_BATCH_RECORD_LENGTH_OFFSET);
+        nested_offset = offset +
+                        CRUCIBLE_MEMORY_MUTATION_BATCH_RECORD_BODY_OFFSET;
+        if (nested_length > payload_len - nested_offset) {
+            return -EINVAL;
+        }
+        nested_end = nested_offset + nested_length;
+        for (size_t i =
+                 offset + CRUCIBLE_MEMORY_MUTATION_BATCH_RECORD_RESERVED_OFFSET;
+             i < nested_offset; i++) {
+            if (payload[i] != 0) {
+                return -EINVAL;
+            }
+        }
+        action = g_new0(CrucibleMemoryBatchAction, 1);
+        memcpy(action->action_hash,
+               payload + offset +
+                   CRUCIBLE_MEMORY_MUTATION_BATCH_RECORD_ACTION_HASH_OFFSET,
+               32);
+        if (crucible_digest_is_zero(action->action_hash)) {
+            crucible_memory_batch_action_free(action);
+            return -EINVAL;
+        }
+        for (guint earlier = 0; earlier < actions->len; earlier++) {
+            CrucibleMemoryBatchAction *candidate =
+                g_ptr_array_index(actions, earlier);
+            if (memcmp(candidate->action_hash, action->action_hash, 32) == 0) {
+                crucible_memory_batch_action_free(action);
+                return -EINVAL;
+            }
+        }
+        action->mutation = g_new0(CrucibleMemoryMutation, 1);
+        action->mutation->prepare_only = true;
+        if (crucible_memory_parse(payload + nested_offset, nested_length,
+                                  action->mutation, allocate, true) != 0) {
+            crucible_memory_batch_action_free(action);
+            return -EINVAL;
+        }
+        total_changed += action->mutation->length;
+        if (total_changed >
+            CRUCIBLE_MEMORY_MUTATION_BATCH_MAX_CHANGED_BYTES) {
+            crucible_memory_batch_action_free(action);
+            return -E2BIG;
+        }
+        g_ptr_array_add(actions, action);
+        offset = nested_end;
+    }
+    if (offset != payload_len) {
+        return -EINVAL;
+    }
+    if (allocate) {
+        CrucibleMemoryBatch *batch = g_new0(CrucibleMemoryBatch, 1);
+        batch->prepare_only = prepare_only;
+        memcpy(batch->expected_precondition,
+               command->expected_precondition_hash, 32);
+        batch->actions = g_steal_pointer(&actions);
+        *batch_out = batch;
+    }
+    return 0;
+}
+
+static int crucible_memory_validate(
+    const struct qemu_plugin_crucible_fault_command *command,
+    const uint8_t *payload, size_t payload_len)
+{
+    return crucible_memory_batch_parse(command, payload, payload_len, false,
+                                       NULL);
+}
+
+static int crucible_memory_arm(
+    const struct qemu_plugin_crucible_fault_command *command,
+    const uint8_t *payload, size_t payload_len, void **state_out)
+{
+    CrucibleMemoryBatch *batch = NULL;
+    int status = crucible_memory_batch_parse(
+        command, payload, payload_len, true, &batch);
+
+    if (status != 0) {
+        return status;
+    }
+    *state_out = batch;
+    return 0;
+}
+
+static void crucible_memory_identity_region(MemoryRegion *mr,
+                                            uint8_t digest[32], int *status)
+{
+    g_autofree char *owner_path = NULL;
+    g_autoptr(GChecksum) checksum = NULL;
+    Object *owner = memory_region_owner(mr);
+    const char *name = memory_region_name(mr);
+    size_t owner_len;
+    size_t name_len;
+
+    if (!owner || !name || !name[0]) {
+        *status = -ENODATA;
+        return;
+    }
+    owner_path = object_get_canonical_path(owner);
+    if (!owner_path || !owner_path[0] ||
+        strlen(owner_path) > UINT32_MAX || strlen(name) > UINT32_MAX) {
+        *status = -ENODATA;
+        return;
+    }
+    owner_len = strlen(owner_path);
+    name_len = strlen(name);
+    checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    g_checksum_update(checksum,
+        (const guchar *)CRUCIBLE_MEMORY_REGION_IDENTITY_SHA256_DOMAIN_V1,
+        CRUCIBLE_MEMORY_REGION_IDENTITY_SHA256_DOMAIN_V1_BYTES);
+    crucible_checksum_u32(checksum, owner_len);
+    g_checksum_update(checksum, (const guchar *)owner_path, owner_len);
+    crucible_checksum_u32(checksum, name_len);
+    g_checksum_update(checksum, (const guchar *)name, name_len);
+    crucible_checksum_finish(checksum, digest);
+}
+
+static void crucible_memory_identity_ram_block(RAMBlock *block,
+                                               uint8_t digest[32], int *status)
+{
+    g_autoptr(GChecksum) checksum = NULL;
+    const char *id = qemu_ram_get_idstr(block);
+    size_t id_len;
+
+    if (!id || !id[0] || strlen(id) > UINT32_MAX) {
+        *status = -ENODATA;
+        return;
+    }
+    id_len = strlen(id);
+    checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    g_checksum_update(checksum,
+        (const guchar *)CRUCIBLE_MEMORY_RAM_BLOCK_IDENTITY_SHA256_DOMAIN_V1,
+        CRUCIBLE_MEMORY_RAM_BLOCK_IDENTITY_SHA256_DOMAIN_V1_BYTES);
+    crucible_checksum_u32(checksum, id_len);
+    g_checksum_update(checksum, (const guchar *)id, id_len);
+    crucible_checksum_finish(checksum, digest);
+}
+
+static bool crucible_memory_collect_mapping(
+    const MemoryRegionSection *section, void *opaque)
+{
+    CrucibleMemoryMapCollector *collector = opaque;
+    CrucibleMemoryMapping mapping = { 0 };
+    RAMBlock *block;
+    ram_addr_t block_offset;
+
+    if (!memory_region_is_ram(section->mr)) {
+        return false;
+    }
+    if (memory_region_is_protected(section->mr)) {
+        return false;
+    }
+    if (section->readonly || memory_region_is_rom(section->mr) ||
+        memory_region_is_ram_device(section->mr)) {
+        return false;
+    }
+    if (collector->mappings->len >= CRUCIBLE_MEMORY_MAX_MAPPINGS ||
+        int128_gethi(section->size) != 0) {
+        collector->status = -E2BIG;
+        return true;
+    }
+    mapping.mr = section->mr;
+    mapping.gpa = section->offset_within_address_space;
+    mapping.length = int128_getlo(section->size);
+    mapping.mr_offset = section->offset_within_region;
+    if (mapping.length == 0 ||
+        mapping.gpa > UINT64_MAX - (mapping.length - 1) ||
+        mapping.mr_offset > UINT64_MAX - (mapping.length - 1)) {
+        collector->status = -EOVERFLOW;
+        return true;
+    }
+    mapping.host = memory_region_get_ram_ptr(mapping.mr) + mapping.mr_offset;
+    block = qemu_ram_block_from_host(mapping.host, false, &block_offset);
+    if (!block || block_offset > UINT64_MAX - (mapping.length - 1)) {
+        collector->status = -ENODATA;
+        return true;
+    }
+    mapping.ram_block_offset = block_offset;
+    crucible_memory_identity_region(mapping.mr, mapping.mr_identity,
+                                    &collector->status);
+    if (collector->status == 0) {
+        crucible_memory_identity_ram_block(block, mapping.ram_block_identity,
+                                           &collector->status);
+    }
+    if (collector->status != 0) {
+        return true;
+    }
+    g_array_append_val(collector->mappings, mapping);
+    return false;
+}
+
+static void crucible_memory_encode_mapping(const CrucibleMemoryMapping *mapping,
+                                           uint8_t bytes[104])
+{
+    memset(bytes, 0, 104);
+    stq_le_p(bytes + CRUCIBLE_MEMORY_MAPPING_GPA_OFFSET, mapping->gpa);
+    stq_le_p(bytes + CRUCIBLE_MEMORY_MAPPING_LENGTH_OFFSET, mapping->length);
+    stq_le_p(bytes + CRUCIBLE_MEMORY_MAPPING_REGION_OFFSET,
+             mapping->mr_offset);
+    stq_le_p(bytes + CRUCIBLE_MEMORY_MAPPING_RAM_BLOCK_OFFSET,
+             mapping->ram_block_offset);
+    memcpy(bytes + CRUCIBLE_MEMORY_MAPPING_REGION_IDENTITY_OFFSET,
+           mapping->mr_identity, 32);
+    memcpy(bytes + CRUCIBLE_MEMORY_MAPPING_RAM_BLOCK_IDENTITY_OFFSET,
+           mapping->ram_block_identity, 32);
+}
+
+static int crucible_memory_collect_mappings(CrucibleMemoryMutation *mutation)
+{
+    CrucibleMemoryMapCollector collector = {
+        .mappings = g_array_new(false, false, sizeof(CrucibleMemoryMapping)),
+    };
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    FlatView *view = address_space_to_flatview(&address_space_memory);
+
+    flatview_for_each_section(view, crucible_memory_collect_mapping,
+                              &collector);
+    if (collector.status != 0 || collector.mappings->len == 0) {
+        g_array_unref(collector.mappings);
+        return collector.status ? collector.status : -ENODATA;
+    }
+    g_checksum_update(checksum,
+        (const guchar *)CRUCIBLE_MEMORY_MAPPING_SHA256_DOMAIN_V1,
+        CRUCIBLE_MEMORY_MAPPING_SHA256_DOMAIN_V1_BYTES);
+    crucible_checksum_u32(checksum, collector.mappings->len);
+    for (guint i = 0; i < collector.mappings->len; i++) {
+        CrucibleMemoryMapping *mapping = &g_array_index(
+            collector.mappings, CrucibleMemoryMapping, i);
+        uint8_t encoded[CRUCIBLE_MEMORY_MAPPING_RECORD_V1_BYTES];
+
+        crucible_memory_encode_mapping(mapping, encoded);
+        g_checksum_update(checksum, encoded, sizeof(encoded));
+    }
+    crucible_checksum_finish(checksum, mutation->mapping_hash);
+    mutation->mappings = collector.mappings;
+    return 0;
+}
+
+static void crucible_memory_encode_translation(
+    const CrucibleMemoryTranslation *translation, uint8_t bytes[32])
+{
+    memset(bytes, 0, 32);
+    stq_le_p(bytes + CRUCIBLE_MEMORY_TRANSLATION_VIRTUAL_PAGE_OFFSET,
+             translation->virtual_page);
+    stq_le_p(bytes + CRUCIBLE_MEMORY_TRANSLATION_PHYSICAL_PAGE_OFFSET,
+             translation->physical_page);
+    stq_le_p(bytes + CRUCIBLE_MEMORY_TRANSLATION_PAGE_SIZE_OFFSET,
+             translation->page_size);
+    stw_le_p(bytes + CRUCIBLE_MEMORY_TRANSLATION_PERMISSIONS_OFFSET,
+             translation->permissions);
+    stw_le_p(bytes + CRUCIBLE_MEMORY_TRANSLATION_ATTRIBUTES_OFFSET,
+             translation->attributes);
+    stl_le_p(bytes + CRUCIBLE_MEMORY_TRANSLATION_COVERED_BYTES_OFFSET,
+             translation->covered_bytes);
+}
+
+static int crucible_memory_translate(CrucibleMemoryMutation *mutation)
+{
+    g_autoptr(GChecksum) checksum = NULL;
+    uint64_t current = mutation->address;
+    uint32_t remaining = mutation->length;
+    CPUState *cpu;
+
+    mutation->translations = g_array_new(
+        false, false, sizeof(CrucibleMemoryTranslation));
+    if (mutation->address_space == CRUCIBLE_MEMORY_MUTATION_ADDRESS_GPA) {
+        memset(mutation->translation_hash, 0, 32);
+        return 0;
+    }
+    cpu = qemu_get_cpu(mutation->vcpu_index);
+    if (!cpu) {
+        return -ENOENT;
+    }
+    while (remaining) {
+        CPUFaultTranslation resolved;
+        CrucibleMemoryTranslation translation = { 0 };
+        uint64_t offset;
+        uint64_t available;
+
+        if (!cpu_get_fault_translation(cpu, current, &resolved) ||
+            resolved.page_size == 0 ||
+            current % resolved.page_size > resolved.physical_address) {
+            return -EFAULT;
+        }
+        offset = current % resolved.page_size;
+        translation.virtual_page = current - offset;
+        translation.physical_page = resolved.physical_address - offset;
+        translation.page_size = resolved.page_size;
+        available = resolved.page_size - offset;
+        translation.covered_bytes = MIN((uint64_t)remaining, available);
+        translation.permissions = CRUCIBLE_MEMORY_TRANSLATION_PERMISSION_READ |
+                                  CRUCIBLE_MEMORY_TRANSLATION_PERMISSION_WRITE;
+        if (resolved.executable) {
+            translation.permissions |=
+                CRUCIBLE_MEMORY_TRANSLATION_PERMISSION_EXECUTE;
+        }
+        if (resolved.user) {
+            translation.permissions |=
+                CRUCIBLE_MEMORY_TRANSLATION_PERMISSION_USER;
+            translation.attributes |=
+                CRUCIBLE_MEMORY_TRANSLATION_ATTRIBUTE_USER;
+        }
+        if (resolved.attrs.secure) {
+            translation.attributes |=
+                CRUCIBLE_MEMORY_TRANSLATION_ATTRIBUTE_SECURE;
+        }
+        g_array_append_val(mutation->translations, translation);
+        current += translation.covered_bytes;
+        remaining -= translation.covered_bytes;
+    }
+    checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    g_checksum_update(checksum,
+        (const guchar *)CRUCIBLE_MEMORY_TRANSLATION_SHA256_DOMAIN_V1,
+        CRUCIBLE_MEMORY_TRANSLATION_SHA256_DOMAIN_V1_BYTES);
+    crucible_checksum_u32(checksum, mutation->vcpu_index);
+    crucible_checksum_u32(checksum, mutation->translations->len);
+    for (guint i = 0; i < mutation->translations->len; i++) {
+        CrucibleMemoryTranslation *translation = &g_array_index(
+            mutation->translations, CrucibleMemoryTranslation, i);
+        uint8_t encoded[CRUCIBLE_MEMORY_TRANSLATION_RECORD_V1_BYTES];
+
+        crucible_memory_encode_translation(translation, encoded);
+        g_checksum_update(checksum, encoded, sizeof(encoded));
+    }
+    crucible_checksum_finish(checksum, mutation->translation_hash);
+    if (!mutation->prepare_only &&
+        memcmp(mutation->translation_hash, mutation->expected_translation,
+               32) != 0) {
+        return -ESTALE;
+    }
+    return 0;
+}
+
+static CrucibleMemoryMapping *crucible_memory_find_mapping(
+    CrucibleMemoryMutation *mutation, uint64_t gpa)
+{
+    for (guint i = 0; i < mutation->mappings->len; i++) {
+        CrucibleMemoryMapping *mapping = &g_array_index(
+            mutation->mappings, CrucibleMemoryMapping, i);
+
+        if (gpa >= mapping->gpa && gpa - mapping->gpa < mapping->length) {
+            return mapping;
+        }
+    }
+    return NULL;
+}
+
+static int crucible_memory_append_physical_fragments(
+    CrucibleMemoryMutation *mutation, uint64_t gpa, uint32_t request_offset,
+    uint32_t length, bool invalidate_tb)
+{
+    while (length) {
+        CrucibleMemoryMapping *mapping =
+            crucible_memory_find_mapping(mutation, gpa);
+        CrucibleMemoryFragment fragment = { 0 };
+        uint64_t mapping_offset;
+        uint64_t available;
+
+        if (!mapping) {
+            return -EFAULT;
+        }
+        mapping_offset = gpa - mapping->gpa;
+        available = mapping->length - mapping_offset;
+        fragment.mapping = mapping;
+        fragment.gpa = gpa;
+        fragment.request_offset = request_offset;
+        fragment.length = MIN((uint64_t)length, available);
+        fragment.flags = invalidate_tb ?
+            CRUCIBLE_MEMORY_MUTATION_FRAGMENT_TB_INVALIDATED : 0;
+        fragment.mr_offset = mapping->mr_offset + mapping_offset;
+        fragment.ram_block_offset = mapping->ram_block_offset + mapping_offset;
+        memcpy(fragment.mr_identity, mapping->mr_identity, 32);
+        memcpy(fragment.ram_block_identity, mapping->ram_block_identity, 32);
+        g_array_append_val(mutation->fragments, fragment);
+        gpa += fragment.length;
+        request_offset += fragment.length;
+        length -= fragment.length;
+    }
+    return 0;
+}
+
+static int crucible_memory_resolve_fragments(CrucibleMemoryMutation *mutation)
+{
+    mutation->fragments = g_array_new(false, false,
+                                      sizeof(CrucibleMemoryFragment));
+    if (mutation->address_space == CRUCIBLE_MEMORY_MUTATION_ADDRESS_GPA) {
+        return crucible_memory_append_physical_fragments(
+            mutation, mutation->address, 0, mutation->length, true);
+    }
+    uint32_t request_offset = 0;
+    for (guint i = 0; i < mutation->translations->len; i++) {
+        CrucibleMemoryTranslation *translation = &g_array_index(
+            mutation->translations, CrucibleMemoryTranslation, i);
+        uint64_t virtual_address = mutation->address + request_offset;
+        uint64_t gpa = translation->physical_page +
+                       (virtual_address - translation->virtual_page);
+        bool invalidate_tb = translation->permissions &
+                             CRUCIBLE_MEMORY_TRANSLATION_PERMISSION_EXECUTE;
+        int status = crucible_memory_append_physical_fragments(
+            mutation, gpa, request_offset, translation->covered_bytes,
+            invalidate_tb);
+
+        if (status != 0) {
+            return status;
+        }
+        request_offset += translation->covered_bytes;
+    }
+    return request_offset == mutation->length ? 0 : -EFAULT;
+}
+
+static int crucible_dirty_compare(gconstpointer left, gconstpointer right)
+{
+    const CrucibleMemoryDirtyRange *a = left;
+    const CrucibleMemoryDirtyRange *b = right;
+    int identity = memcmp(a->ram_block_identity, b->ram_block_identity, 32);
+
+    if (identity) {
+        return identity;
+    }
+    return a->offset < b->offset ? -1 : a->offset > b->offset;
+}
+
+static void crucible_memory_encode_dirty(
+    const CrucibleMemoryDirtyRange *range, uint8_t bytes[48])
+{
+    uint64_t pages = (range->end - range->offset) /
+                     CRUCIBLE_MEMORY_DIRTY_PAGE_SIZE;
+
+    g_assert(pages > 0 && pages <= UINT32_MAX);
+    memset(bytes, 0, 48);
+    memcpy(bytes + CRUCIBLE_MEMORY_DIRTY_RANGE_RAM_BLOCK_IDENTITY_OFFSET,
+           range->ram_block_identity, 32);
+    stq_le_p(bytes + CRUCIBLE_MEMORY_DIRTY_RANGE_RAM_BLOCK_OFFSET,
+             range->offset);
+    stl_le_p(bytes + CRUCIBLE_MEMORY_DIRTY_RANGE_PAGE_COUNT_OFFSET, pages);
+    stl_le_p(bytes + CRUCIBLE_MEMORY_DIRTY_RANGE_PAGE_SIZE_OFFSET,
+             CRUCIBLE_MEMORY_DIRTY_PAGE_SIZE);
+}
+
+static int crucible_memory_derive_dirty(CrucibleMemoryMutation *mutation)
+{
+    GArray *raw = g_array_new(false, false, sizeof(CrucibleMemoryDirtyRange));
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+
+    mutation->dirty_ranges = g_array_new(
+        false, false, sizeof(CrucibleMemoryDirtyRange));
+    for (guint i = 0; i < mutation->fragments->len; i++) {
+        CrucibleMemoryFragment *fragment = &g_array_index(
+            mutation->fragments, CrucibleMemoryFragment, i);
+        CrucibleMemoryDirtyRange range = { 0 };
+        uint64_t last = fragment->ram_block_offset + fragment->length - 1;
+
+        memcpy(range.ram_block_identity, fragment->ram_block_identity, 32);
+        range.offset = fragment->ram_block_offset /
+                       CRUCIBLE_MEMORY_DIRTY_PAGE_SIZE *
+                       CRUCIBLE_MEMORY_DIRTY_PAGE_SIZE;
+        range.end = (last / CRUCIBLE_MEMORY_DIRTY_PAGE_SIZE + 1) *
+                    CRUCIBLE_MEMORY_DIRTY_PAGE_SIZE;
+        if (range.end <= range.offset) {
+            g_array_unref(raw);
+            return -EOVERFLOW;
+        }
+        g_array_append_val(raw, range);
+    }
+    g_array_sort(raw, crucible_dirty_compare);
+    for (guint i = 0; i < raw->len; i++) {
+        CrucibleMemoryDirtyRange range = g_array_index(
+            raw, CrucibleMemoryDirtyRange, i);
+        if (mutation->dirty_ranges->len) {
+            CrucibleMemoryDirtyRange *previous = &g_array_index(
+                mutation->dirty_ranges, CrucibleMemoryDirtyRange,
+                mutation->dirty_ranges->len - 1);
+            if (memcmp(previous->ram_block_identity,
+                       range.ram_block_identity, 32) == 0 &&
+                range.offset <= previous->end) {
+                previous->end = MAX(previous->end, range.end);
+                continue;
+            }
+        }
+        g_array_append_val(mutation->dirty_ranges, range);
+    }
+    g_array_unref(raw);
+    g_checksum_update(checksum,
+        (const guchar *)CRUCIBLE_MEMORY_DIRTY_SHA256_DOMAIN_V1,
+        CRUCIBLE_MEMORY_DIRTY_SHA256_DOMAIN_V1_BYTES);
+    crucible_checksum_u32(checksum, mutation->dirty_ranges->len);
+    for (guint i = 0; i < mutation->dirty_ranges->len; i++) {
+        CrucibleMemoryDirtyRange *range = &g_array_index(
+            mutation->dirty_ranges, CrucibleMemoryDirtyRange, i);
+        uint8_t encoded[CRUCIBLE_MEMORY_DIRTY_RANGE_V1_BYTES];
+
+        if ((range->end - range->offset) /
+            CRUCIBLE_MEMORY_DIRTY_PAGE_SIZE > UINT32_MAX) {
+            return -EOVERFLOW;
+        }
+        crucible_memory_encode_dirty(range, encoded);
+        g_checksum_update(checksum, encoded, sizeof(encoded));
+    }
+    crucible_checksum_finish(checksum, mutation->dirty_hash);
+    return 0;
+}
+
+static void crucible_memory_capture_bytes(CrucibleMemoryMutation *mutation)
+{
+    mutation->before = g_byte_array_sized_new(mutation->length);
+    mutation->after = g_byte_array_sized_new(mutation->length);
+    g_byte_array_set_size(mutation->before, mutation->length);
+    g_byte_array_set_size(mutation->after, mutation->length);
+    for (guint i = 0; i < mutation->fragments->len; i++) {
+        CrucibleMemoryFragment *fragment = &g_array_index(
+            mutation->fragments, CrucibleMemoryFragment, i);
+        memcpy(mutation->before->data + fragment->request_offset,
+               fragment->mapping->host +
+                   (fragment->mr_offset - fragment->mapping->mr_offset),
+               fragment->length);
+    }
+}
+
+static void crucible_memory_apply_transform(CrucibleMemoryMutation *mutation)
+{
+    for (uint32_t i = 0; i < mutation->length; i++) {
+        uint8_t before = mutation->before->data[i];
+
+        if (mutation->transform ==
+            CRUCIBLE_MEMORY_MUTATION_TRANSFORM_BIT_FLIP) {
+            mutation->after->data[i] = before ^ mutation->mask[i];
+        } else {
+            mutation->after->data[i] =
+                (before & ~mutation->mask[i]) |
+                (mutation->values[i] & mutation->mask[i]);
+        }
+    }
+}
+
+static void crucible_memory_overlay_prior(
+    CrucibleMemoryBatch *batch, guint action_index,
+    CrucibleMemoryMutation *mutation)
+{
+    for (guint prior_index = 0; prior_index < action_index; prior_index++) {
+        CrucibleMemoryBatchAction *prior_action =
+            g_ptr_array_index(batch->actions, prior_index);
+        CrucibleMemoryMutation *prior = prior_action->mutation;
+
+        for (guint current_index = 0;
+             current_index < mutation->fragments->len; current_index++) {
+            CrucibleMemoryFragment *current = &g_array_index(
+                mutation->fragments, CrucibleMemoryFragment, current_index);
+            uint64_t current_end = current->ram_block_offset + current->length;
+
+            for (guint fragment_index = 0;
+                 fragment_index < prior->fragments->len; fragment_index++) {
+                CrucibleMemoryFragment *earlier = &g_array_index(
+                    prior->fragments, CrucibleMemoryFragment, fragment_index);
+                uint64_t earlier_end = earlier->ram_block_offset +
+                                       earlier->length;
+                uint64_t start;
+                uint64_t end;
+
+                if (memcmp(current->ram_block_identity,
+                           earlier->ram_block_identity, 32) != 0) {
+                    continue;
+                }
+                start = MAX(current->ram_block_offset,
+                            earlier->ram_block_offset);
+                end = MIN(current_end, earlier_end);
+                if (start >= end) {
+                    continue;
+                }
+                memcpy(
+                    mutation->before->data + current->request_offset +
+                        (start - current->ram_block_offset),
+                    prior->after->data + earlier->request_offset +
+                        (start - earlier->ram_block_offset),
+                    end - start);
+            }
+        }
+    }
+}
+
+static void crucible_memory_encode_fragment(
+    const CrucibleMemoryFragment *fragment, uint8_t bytes[104])
+{
+    memset(bytes, 0, 104);
+    stq_le_p(bytes + CRUCIBLE_MEMORY_MUTATION_FRAGMENT_GPA_OFFSET,
+             fragment->gpa);
+    stl_le_p(bytes + CRUCIBLE_MEMORY_MUTATION_FRAGMENT_REQUEST_OFFSET,
+             fragment->request_offset);
+    stl_le_p(bytes + CRUCIBLE_MEMORY_MUTATION_FRAGMENT_LENGTH_OFFSET,
+             fragment->length);
+    stl_le_p(bytes + CRUCIBLE_MEMORY_MUTATION_FRAGMENT_FLAGS_OFFSET,
+             fragment->flags);
+    stq_le_p(bytes + CRUCIBLE_MEMORY_MUTATION_FRAGMENT_REGION_OFFSET,
+             fragment->mr_offset);
+    stq_le_p(bytes + CRUCIBLE_MEMORY_MUTATION_FRAGMENT_RAM_BLOCK_OFFSET,
+             fragment->ram_block_offset);
+    memcpy(bytes + CRUCIBLE_MEMORY_MUTATION_FRAGMENT_REGION_IDENTITY_OFFSET,
+           fragment->mr_identity, 32);
+    memcpy(bytes + CRUCIBLE_MEMORY_MUTATION_FRAGMENT_RAM_BLOCK_IDENTITY_OFFSET,
+           fragment->ram_block_identity, 32);
+}
+
+static void crucible_memory_node_fingerprint(
+    const struct qemu_plugin_crucible_fault_command *command,
+    const CrucibleMemoryMutation *mutation, uint64_t observed_icount,
+    const uint8_t before_hash[32], const uint8_t after_hash[32],
+    bool invalidated, uint64_t invalidated_start, uint64_t invalidated_end,
+    uint8_t digest[32])
+{
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    uint8_t present = invalidated;
+
+    g_checksum_update(checksum,
+        (const guchar *)CRUCIBLE_MEMORY_BOUNDARY_FINGERPRINT_SHA256_DOMAIN_V1,
+        CRUCIBLE_MEMORY_BOUNDARY_FINGERPRINT_SHA256_DOMAIN_V1_BYTES);
+    g_checksum_update(checksum, command->target_node_hash, 32);
+    crucible_checksum_u64(checksum, observed_icount);
+    crucible_checksum_u16(checksum, mutation->address_space);
+    crucible_checksum_u16(checksum, mutation->transform);
+    crucible_checksum_u32(checksum, mutation->vcpu_index);
+    crucible_checksum_u64(checksum, mutation->address);
+    crucible_checksum_u32(checksum, mutation->length);
+    g_checksum_update(checksum, before_hash, 32);
+    g_checksum_update(checksum, after_hash, 32);
+    g_checksum_update(checksum, mutation->translation_hash, 32);
+    g_checksum_update(checksum, mutation->mapping_hash, 32);
+    g_checksum_update(checksum, mutation->dirty_hash, 32);
+    g_checksum_update(checksum, &present, 1);
+    crucible_checksum_u64(checksum, invalidated_start);
+    crucible_checksum_u64(checksum, invalidated_end);
+    crucible_checksum_finish(checksum, digest);
+}
+
+static void crucible_memory_build_evidence(
+    const struct qemu_plugin_crucible_fault_command *command,
+    CrucibleMemoryMutation *mutation,
+    struct qemu_plugin_crucible_fault_result *result,
+    GByteArray *payload)
+{
+    uint32_t inline_len = mutation->length <=
+                          CRUCIBLE_MEMORY_MUTATION_EVIDENCE_INLINE_BYTES ?
+                          mutation->length : 0;
+    bool invalidated = false;
+    uint64_t invalidated_start = UINT64_MAX;
+    uint64_t invalidated_end = 0;
+    uint16_t flags = inline_len ?
+        CRUCIBLE_MEMORY_MUTATION_EVIDENCE_FLAG_INLINE_BYTES : 0;
+    uint8_t node_fingerprint[32];
+    size_t body_size;
+
+    for (guint i = 0; i < mutation->fragments->len; i++) {
+        CrucibleMemoryFragment *fragment = &g_array_index(
+            mutation->fragments, CrucibleMemoryFragment, i);
+        if (fragment->flags &
+            CRUCIBLE_MEMORY_MUTATION_FRAGMENT_TB_INVALIDATED) {
+            invalidated = true;
+            invalidated_start = MIN(invalidated_start, fragment->gpa);
+            invalidated_end = MAX(invalidated_end,
+                                  fragment->gpa + fragment->length - 1);
+        }
+    }
+    if (invalidated) {
+        flags |= CRUCIBLE_MEMORY_MUTATION_EVIDENCE_FLAG_TB_INVALIDATED;
+    } else {
+        invalidated_start = 0;
+    }
+    crucible_memory_node_fingerprint(
+        command, mutation, result->observed_icount, result->before_hash,
+        result->after_hash, invalidated, invalidated_start, invalidated_end,
+        node_fingerprint);
+    body_size = mutation->translations->len *
+                    CRUCIBLE_MEMORY_TRANSLATION_RECORD_V1_BYTES +
+                mutation->fragments->len *
+                    CRUCIBLE_MEMORY_MUTATION_FRAGMENT_V1_BYTES +
+                mutation->mappings->len *
+                    CRUCIBLE_MEMORY_MAPPING_RECORD_V1_BYTES +
+                mutation->dirty_ranges->len *
+                    CRUCIBLE_MEMORY_DIRTY_RANGE_V1_BYTES +
+                2 * inline_len;
+    g_byte_array_set_size(payload,
+        CRUCIBLE_MEMORY_MUTATION_EVIDENCE_HEADER_V1_BYTES + body_size);
+    memset(payload->data, 0,
+           CRUCIBLE_MEMORY_MUTATION_EVIDENCE_HEADER_V1_BYTES);
+    memcpy(payload->data, CRUCIBLE_MEMORY_MUTATION_EVIDENCE_MAGIC_V1, 8);
+    stw_le_p(payload->data + CRUCIBLE_MEMORY_MUTATION_EVIDENCE_VERSION_OFFSET,
+             CRUCIBLE_MEMORY_MUTATION_EVIDENCE_VERSION_V1);
+    stw_le_p(payload->data + CRUCIBLE_MEMORY_MUTATION_EVIDENCE_FLAGS_OFFSET,
+             flags);
+    stw_le_p(payload->data +
+             CRUCIBLE_MEMORY_MUTATION_EVIDENCE_ADDRESS_SPACE_OFFSET,
+             mutation->address_space);
+    stw_le_p(payload->data + CRUCIBLE_MEMORY_MUTATION_EVIDENCE_TRANSFORM_OFFSET,
+             mutation->transform);
+    stl_le_p(payload->data +
+             CRUCIBLE_MEMORY_MUTATION_EVIDENCE_VCPU_INDEX_OFFSET,
+             mutation->vcpu_index);
+    stl_le_p(payload->data + CRUCIBLE_MEMORY_MUTATION_EVIDENCE_LENGTH_OFFSET,
+             mutation->length);
+    stq_le_p(payload->data + CRUCIBLE_MEMORY_MUTATION_EVIDENCE_ADDRESS_OFFSET,
+             mutation->address);
+    stq_le_p(payload->data +
+             CRUCIBLE_MEMORY_MUTATION_EVIDENCE_OBSERVED_ICOUNT_OFFSET,
+             result->observed_icount);
+    stl_le_p(payload->data +
+             CRUCIBLE_MEMORY_MUTATION_EVIDENCE_TRANSLATION_COUNT_OFFSET,
+             mutation->translations->len);
+    stl_le_p(payload->data +
+             CRUCIBLE_MEMORY_MUTATION_EVIDENCE_FRAGMENT_COUNT_OFFSET,
+             mutation->fragments->len);
+    stl_le_p(payload->data +
+             CRUCIBLE_MEMORY_MUTATION_EVIDENCE_MAPPING_COUNT_OFFSET,
+             mutation->mappings->len);
+    stl_le_p(payload->data +
+             CRUCIBLE_MEMORY_MUTATION_EVIDENCE_DIRTY_COUNT_OFFSET,
+             mutation->dirty_ranges->len);
+    stl_le_p(payload->data +
+             CRUCIBLE_MEMORY_MUTATION_EVIDENCE_INLINE_LENGTH_OFFSET,
+             inline_len);
+    memcpy(payload->data +
+           CRUCIBLE_MEMORY_MUTATION_EVIDENCE_BEFORE_SHA256_OFFSET,
+           result->before_hash, 32);
+    memcpy(payload->data +
+           CRUCIBLE_MEMORY_MUTATION_EVIDENCE_AFTER_SHA256_OFFSET,
+           result->after_hash, 32);
+    memcpy(payload->data +
+           CRUCIBLE_MEMORY_MUTATION_EVIDENCE_TRANSLATION_SHA256_OFFSET,
+           mutation->translation_hash, 32);
+    memcpy(payload->data +
+           CRUCIBLE_MEMORY_MUTATION_EVIDENCE_MAPPING_SHA256_OFFSET,
+           mutation->mapping_hash, 32);
+    memcpy(payload->data +
+           CRUCIBLE_MEMORY_MUTATION_EVIDENCE_DIRTY_SHA256_OFFSET,
+           mutation->dirty_hash, 32);
+    stq_le_p(payload->data +
+             CRUCIBLE_MEMORY_MUTATION_EVIDENCE_INVALIDATED_START_OFFSET,
+             invalidated_start);
+    stq_le_p(payload->data +
+             CRUCIBLE_MEMORY_MUTATION_EVIDENCE_INVALIDATED_END_OFFSET,
+             invalidated_end);
+    memcpy(payload->data +
+           CRUCIBLE_MEMORY_MUTATION_EVIDENCE_TARGET_NODE_HASH_OFFSET,
+           command->target_node_hash, 32);
+    memcpy(payload->data +
+           CRUCIBLE_MEMORY_MUTATION_EVIDENCE_NODE_FINGERPRINT_OFFSET,
+           node_fingerprint, 32);
+
+    size_t offset = CRUCIBLE_MEMORY_MUTATION_EVIDENCE_HEADER_V1_BYTES;
+    for (guint i = 0; i < mutation->translations->len; i++) {
+        CrucibleMemoryTranslation *translation = &g_array_index(
+            mutation->translations, CrucibleMemoryTranslation, i);
+        crucible_memory_encode_translation(translation, payload->data + offset);
+        offset += CRUCIBLE_MEMORY_TRANSLATION_RECORD_V1_BYTES;
+    }
+    for (guint i = 0; i < mutation->fragments->len; i++) {
+        CrucibleMemoryFragment *fragment = &g_array_index(
+            mutation->fragments, CrucibleMemoryFragment, i);
+        crucible_memory_encode_fragment(fragment, payload->data + offset);
+        offset += CRUCIBLE_MEMORY_MUTATION_FRAGMENT_V1_BYTES;
+    }
+    for (guint i = 0; i < mutation->mappings->len; i++) {
+        CrucibleMemoryMapping *mapping = &g_array_index(
+            mutation->mappings, CrucibleMemoryMapping, i);
+        crucible_memory_encode_mapping(mapping, payload->data + offset);
+        offset += CRUCIBLE_MEMORY_MAPPING_RECORD_V1_BYTES;
+    }
+    for (guint i = 0; i < mutation->dirty_ranges->len; i++) {
+        CrucibleMemoryDirtyRange *range = &g_array_index(
+            mutation->dirty_ranges, CrucibleMemoryDirtyRange, i);
+        crucible_memory_encode_dirty(range, payload->data + offset);
+        offset += CRUCIBLE_MEMORY_DIRTY_RANGE_V1_BYTES;
+    }
+    if (inline_len) {
+        memcpy(payload->data + offset, mutation->before->data, inline_len);
+        offset += inline_len;
+        memcpy(payload->data + offset, mutation->after->data, inline_len);
+    }
+    crucible_sha256_parts(payload->data, payload->len, NULL, 0,
+                          result->evidence_hash);
+}
+
+static void crucible_memory_batch_precondition(CrucibleMemoryBatch *batch)
+{
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+
+    g_checksum_update(
+        checksum,
+        (const uint8_t *)
+            CRUCIBLE_MEMORY_MUTATION_BATCH_PRECONDITION_SHA256_DOMAIN_V1,
+        CRUCIBLE_MEMORY_MUTATION_BATCH_PRECONDITION_SHA256_DOMAIN_V1_BYTES);
+    crucible_checksum_u32(checksum, batch->actions->len);
+    for (guint i = 0; i < batch->actions->len; i++) {
+        CrucibleMemoryBatchAction *action =
+            g_ptr_array_index(batch->actions, i);
+
+        g_checksum_update(checksum, action->action_hash, 32);
+        g_checksum_update(checksum, action->mutation->precondition_hash, 32);
+    }
+    crucible_checksum_finish(checksum, batch->precondition_hash);
+}
+
+static void crucible_memory_batch_state_hash(
+    CrucibleMemoryBatch *batch, bool after, uint8_t digest[32])
+{
+    const char *domain = after ?
+        CRUCIBLE_MEMORY_MUTATION_BATCH_AFTER_SHA256_DOMAIN_V1 :
+        CRUCIBLE_MEMORY_MUTATION_BATCH_BEFORE_SHA256_DOMAIN_V1;
+    size_t domain_len = after ?
+        CRUCIBLE_MEMORY_MUTATION_BATCH_AFTER_SHA256_DOMAIN_V1_BYTES :
+        CRUCIBLE_MEMORY_MUTATION_BATCH_BEFORE_SHA256_DOMAIN_V1_BYTES;
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+
+    g_checksum_update(checksum, (const uint8_t *)domain, domain_len);
+    crucible_checksum_u32(checksum, batch->actions->len);
+    for (guint i = 0; i < batch->actions->len; i++) {
+        CrucibleMemoryBatchAction *action =
+            g_ptr_array_index(batch->actions, i);
+        g_checksum_update(checksum, action->action_hash, 32);
+        g_checksum_update(checksum, after ? action->mutation->after_hash :
+                                      action->mutation->before_hash, 32);
+    }
+    crucible_checksum_finish(checksum, digest);
+}
+
+static int crucible_memory_build_batch_evidence(
+    CrucibleMemoryBatch *batch,
+    struct qemu_plugin_crucible_fault_result *result,
+    GByteArray *payload)
+{
+    size_t total = CRUCIBLE_MEMORY_MUTATION_BATCH_EVIDENCE_HEADER_V1_BYTES;
+
+    for (guint i = 0; i < batch->actions->len; i++) {
+        CrucibleMemoryBatchAction *action =
+            g_ptr_array_index(batch->actions, i);
+
+        if (action->evidence->len > UINT32_MAX ||
+            total > CRUCIBLE_FAULT_HARD_PAYLOAD_BYTES -
+                        CRUCIBLE_MEMORY_MUTATION_BATCH_EVIDENCE_RECORD_V1_BYTES ||
+            action->evidence->len >
+                CRUCIBLE_FAULT_HARD_PAYLOAD_BYTES - total -
+                    CRUCIBLE_MEMORY_MUTATION_BATCH_EVIDENCE_RECORD_V1_BYTES) {
+            return -E2BIG;
+        }
+        total += CRUCIBLE_MEMORY_MUTATION_BATCH_EVIDENCE_RECORD_V1_BYTES +
+                 action->evidence->len;
+    }
+    g_byte_array_set_size(payload, total);
+    memset(payload->data, 0,
+           CRUCIBLE_MEMORY_MUTATION_BATCH_EVIDENCE_HEADER_V1_BYTES);
+    memcpy(payload->data, CRUCIBLE_MEMORY_MUTATION_BATCH_EVIDENCE_MAGIC_V1, 8);
+    stw_le_p(payload->data +
+                 CRUCIBLE_MEMORY_MUTATION_BATCH_EVIDENCE_VERSION_OFFSET,
+             CRUCIBLE_MEMORY_MUTATION_BATCH_EVIDENCE_VERSION_V1);
+    stl_le_p(payload->data +
+                 CRUCIBLE_MEMORY_MUTATION_BATCH_EVIDENCE_COUNT_OFFSET,
+             batch->actions->len);
+    memcpy(payload->data +
+               CRUCIBLE_MEMORY_MUTATION_BATCH_EVIDENCE_PRECONDITION_OFFSET,
+           batch->precondition_hash, 32);
+    stl_le_p(
+        payload->data +
+            CRUCIBLE_MEMORY_MUTATION_BATCH_EVIDENCE_RECORDS_LENGTH_OFFSET,
+        total - CRUCIBLE_MEMORY_MUTATION_BATCH_EVIDENCE_BODY_OFFSET);
+
+    size_t offset = CRUCIBLE_MEMORY_MUTATION_BATCH_EVIDENCE_BODY_OFFSET;
+    for (guint i = 0; i < batch->actions->len; i++) {
+        CrucibleMemoryBatchAction *action =
+            g_ptr_array_index(batch->actions, i);
+
+        memcpy(payload->data + offset, action->action_hash, 32);
+        stl_le_p(payload->data + offset +
+                     CRUCIBLE_MEMORY_MUTATION_BATCH_RECORD_LENGTH_OFFSET,
+                 action->evidence->len);
+        memset(payload->data + offset +
+                   CRUCIBLE_MEMORY_MUTATION_BATCH_RECORD_RESERVED_OFFSET,
+               0, 4);
+        offset += CRUCIBLE_MEMORY_MUTATION_BATCH_EVIDENCE_RECORD_V1_BYTES;
+        memcpy(payload->data + offset, action->evidence->data,
+               action->evidence->len);
+        offset += action->evidence->len;
+    }
+    crucible_sha256_parts(payload->data, payload->len, NULL, 0,
+                          result->evidence_hash);
+    return 0;
+}
+
+static int crucible_memory_prepare(
+    const struct qemu_plugin_crucible_fault_command *command,
+    const uint8_t *payload, size_t payload_len, void *state,
+    struct qemu_plugin_crucible_fault_result *result,
+    GByteArray *result_payload)
+{
+    CrucibleMemoryBatch *batch = state;
+    int status = 0;
+
+    (void)payload;
+    (void)payload_len;
+    for (guint i = 0; i < batch->actions->len; i++) {
+        CrucibleMemoryBatchAction *action =
+            g_ptr_array_index(batch->actions, i);
+        CrucibleMemoryMutation *mutation = action->mutation;
+        struct qemu_plugin_crucible_fault_result action_result = {
+            .observed_icount = result->observed_icount,
+        };
+
+        status = crucible_memory_collect_mappings(mutation);
+        if (status == 0) {
+            status = crucible_memory_translate(mutation);
+        }
+        if (status == 0) {
+            status = crucible_memory_resolve_fragments(mutation);
+        }
+        if (status == 0) {
+            status = crucible_memory_derive_dirty(mutation);
+        }
+        if (status != 0) {
+            break;
+        }
+        crucible_memory_capture_bytes(mutation);
+        crucible_memory_overlay_prior(batch, i, mutation);
+        crucible_memory_apply_transform(mutation);
+        crucible_sha256_parts(mutation->before->data, mutation->before->len,
+                              NULL, 0, mutation->before_hash);
+        crucible_sha256_parts(mutation->after->data, mutation->after->len,
+                              NULL, 0, mutation->after_hash);
+        crucible_memory_precondition(
+            mutation, mutation->before_hash, mutation->after_hash,
+            mutation->precondition_hash);
+        memcpy(action_result.before_hash, mutation->before_hash, 32);
+        memcpy(action_result.after_hash, mutation->after_hash, 32);
+        action->evidence = g_byte_array_new();
+        crucible_memory_build_evidence(
+            command, mutation, &action_result, action->evidence);
+    }
+    if (status != 0) {
+        result->status =
+            status == -E2BIG ? CRUCIBLE_FAULT_STATUS_RESOURCE_LIMIT :
+            status == -ESTALE ? CRUCIBLE_FAULT_STATUS_PRECONDITION_MISMATCH :
+            CRUCIBLE_FAULT_STATUS_INVALID_TARGET;
+        return status;
+    }
+    crucible_memory_batch_precondition(batch);
+    if (!batch->prepare_only &&
+        memcmp(batch->precondition_hash, batch->expected_precondition, 32) != 0) {
+        result->status = CRUCIBLE_FAULT_STATUS_PRECONDITION_MISMATCH;
+        return -ESTALE;
+    }
+    crucible_memory_batch_state_hash(batch, false, result->before_hash);
+    crucible_memory_batch_state_hash(batch, true, result->after_hash);
+    status = crucible_memory_build_batch_evidence(batch, result,
+                                                  result_payload);
+    if (status != 0) {
+        result->status = CRUCIBLE_FAULT_STATUS_RESOURCE_LIMIT;
+    }
+    return status;
+}
+
+static void crucible_memory_commit(
+    const struct qemu_plugin_crucible_fault_command *command,
+    const uint8_t *payload, size_t payload_len, void *state,
+    struct qemu_plugin_crucible_fault_result *result,
+    GByteArray *result_payload)
+{
+    CrucibleMemoryBatch *batch = state;
+
+    (void)command;
+    (void)payload;
+    (void)payload_len;
+    (void)result_payload;
+    for (guint action_index = 0;
+         action_index < batch->actions->len; action_index++) {
+        CrucibleMemoryBatchAction *action =
+            g_ptr_array_index(batch->actions, action_index);
+        CrucibleMemoryMutation *mutation = action->mutation;
+
+        for (guint i = 0; i < mutation->fragments->len; i++) {
+            CrucibleMemoryFragment *fragment = &g_array_index(
+                mutation->fragments, CrucibleMemoryFragment, i);
+            memory_region_fault_commit_ram(
+                fragment->mapping->mr, fragment->mr_offset,
+                mutation->after->data + fragment->request_offset,
+                fragment->length);
+        }
+    }
+    result->status = CRUCIBLE_FAULT_STATUS_APPLIED;
+    result->applied_icount = result->observed_icount;
+}
+
+static QemuCrucibleFaultHandler crucible_memory_handler = {
+    .capability = {
+        .command_kind = CRUCIBLE_FAULT_COMMAND_MEMORY_MUTATION,
+        .scope = QEMU_PLUGIN_CRUCIBLE_FAULT_SCOPE_ALL,
+        .semantic_version = CRUCIBLE_FAULT_COMMAND_SEMANTIC_VERSION,
+        .phase_mask = 1U << (CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY - 1),
+        .maximum_payload_bytes = CRUCIBLE_FAULT_HARD_PAYLOAD_BYTES,
+        .maximum_pending_commands = CRUCIBLE_FAULT_DEFAULT_COMMAND_CAPACITY,
+        .required_feature_bits =
+            CRUCIBLE_FAULT_CAPABILITY_FEATURE_MEMORY_MUTATION,
+        .name = "qemu.memory.mutate.unregistered.v1",
+        .payload_schema = "crucible.memory-mutation-batch-payload.v1",
+    },
+    .validate = crucible_memory_validate,
+    .arm = crucible_memory_arm,
+    .prepare = crucible_memory_prepare,
+    .commit = crucible_memory_commit,
+    .free_state = crucible_memory_batch_free,
+};
+
+void qemu_crucible_fault_memory_register(uint16_t scope, const char *name)
+{
+    static bool registered;
+
+    g_assert(scope == QEMU_PLUGIN_CRUCIBLE_FAULT_SCOPE_X86_64 ||
+             scope == QEMU_PLUGIN_CRUCIBLE_FAULT_SCOPE_AARCH64);
+    g_assert(name);
+    if (registered) {
+        g_assert(crucible_memory_handler.capability.scope == scope);
+        g_assert(strcmp(crucible_memory_handler.capability.name, name) == 0);
+        return;
+    }
+    crucible_memory_handler.capability.scope = scope;
+    crucible_memory_handler.capability.name = name;
+    qemu_crucible_fault_register(&crucible_memory_handler);
+    registered = true;
+}
