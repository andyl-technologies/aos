+static int crucible_fault_pending_compare(const CruciblePendingFault *a,
+                                          const CruciblePendingFault *b)
+{
+    int order;
+
+    if (a->command.target_icount != b->command.target_icount) {
+        return a->command.target_icount < b->command.target_icount ? -1 : 1;
+    }
+    if (a->command.phase != b->command.phase) {
+        return a->command.phase < b->command.phase ? -1 : 1;
+    }
+    if (a->handler->capability.command_kind !=
+        b->handler->capability.command_kind) {
+        return a->handler->capability.command_kind <
+               b->handler->capability.command_kind ? -1 : 1;
+    }
+    order = memcmp(a->command.binding_hash, b->command.binding_hash, 32);
+    if (order) {
+        return order;
+    }
+    order = memcmp(a->command.opportunity_hash,
+                   b->command.opportunity_hash, 32);
+    if (order) {
+        return order;
+    }
+    if (a->command.command_sequence != b->command.command_sequence) {
+        return a->command.command_sequence < b->command.command_sequence ?
+               -1 : 1;
+    }
+    return 0;
