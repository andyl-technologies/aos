+bool x86_cpu_get_fault_translation(CPUState *cs, vaddr addr,
+                                   CPUFaultTranslation *result)
+{
+    CPUX86State *env = cpu_env(cs);
+    TranslateResult out;
+    TranslateFault err;
+    int mmu_idx = cpu_mmu_index(cs, false);
+    TranslateParams in = {
+        .addr = addr,
+        .access_type = MMU_DATA_STORE,
+        .update_page_tables = false,
+    };
+
+    if (env->hflags2 & HF2_NPT_MASK) {
+        return false;
+    }
+    if (is_mmu_index_32(mmu_idx)) {
+        in.addr = (uint32_t)addr;
+    }
+    if (env->cr[0] & CR0_PG_MASK) {
+        in.cr3 = env->cr[3];
+        in.mmu_idx = mmu_idx;
+        in.ptw_idx = MMU_PHYS_IDX;
+        in.pg_mode = get_pg_mode(env);
+        if (in.pg_mode & PG_MODE_LMA) {
+            int shift = in.pg_mode & PG_MODE_LA57 ? 56 : 47;
+            int64_t sext = (int64_t)addr >> shift;
+
+            if (sext != 0 && sext != -1) {
+                return false;
+            }
+        }
+        if (!mmu_translate(env, &in, &out, &err, 0)) {
+            return false;
+        }
+    } else {
+        out.paddr = addr & x86_get_a20_mask(env);
+        out.prot = PAGE_READ | PAGE_WRITE | PAGE_EXEC;
+        out.page_size = TARGET_PAGE_SIZE;
+    }
+    if (!(out.prot & PAGE_READ) || !(out.prot & PAGE_WRITE) ||
+        out.page_size <= 0) {
+        return false;
+    }
+    result->physical_address = out.paddr;
+    result->page_size = out.page_size;
+    result->attrs = cpu_get_mem_attrs(env);
+    result->readable = out.prot & PAGE_READ;
+    result->writable = out.prot & PAGE_WRITE;
+    result->executable = out.prot & PAGE_EXEC;
+    result->user = is_mmu_index_user(mmu_idx);
+    return true;
+}
