+    report->negotiating_monitors = inventory.negotiating_monitors;
+    report->oob_enabled_monitors = inventory.oob_enabled_monitors;
+    report->queued_requests = inventory.queued_requests;
+    report->parser_buffered_bytes = inventory.parser_buffered_bytes;
+    report->partial_parsers = inventory.partial_parsers;
+    report->unstable_monitors = inventory.unstable_monitors;
+    return report;
+}
