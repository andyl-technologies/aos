+void monitor_hot_fork_inventory(MonitorHotForkInventory *inventory)
+{
+    Monitor *mon;
+
+    memset(inventory, 0, sizeof(*inventory));
+    qemu_mutex_lock(&monitor_lock);
+    inventory->generation = monitor_hot_fork_generation;
+    inventory->overflowed = monitor_hot_fork_generation_overflowed;
+
+    QTAILQ_FOREACH(mon, &mon_list, entry) {
+        MonitorQMP *qmp_mon;
+        uint64_t parser_bytes;
+        bool parser_partial;
+
+        if (inventory->monitor_count == MONITOR_HOT_FORK_INVENTORY_MAX) {
+            inventory->overflowed = true;
+            break;
+        }
+        inventory->monitor_count++;
+        inventory->io_thread_monitors += mon->use_io_thread;
+        inventory->suspended_monitors += qatomic_read(&mon->suspend_cnt) != 0;
+        if (!monitor_is_qmp(mon)) {
+            inventory->hmp_monitors++;
+            continue;
+        }
+
+        inventory->qmp_monitors++;
+        qmp_mon = container_of(mon, MonitorQMP, common);
+        if (qemu_rec_mutex_trylock(&qmp_mon->qmp_parser_lock) != 0) {
+            inventory->unstable_monitors++;
+            continue;
+        }
+        qemu_mutex_lock(&qmp_mon->qmp_queue_lock);
+        inventory->negotiating_monitors +=
+            qmp_mon->commands == &qmp_cap_negotiation_commands;
+        inventory->oob_enabled_monitors +=
+            qmp_mon->capab[QMP_CAPABILITY_OOB];
+        if (UINT64_MAX - inventory->queued_requests <
+            qmp_mon->qmp_requests->length) {
+            inventory->overflowed = true;
+        } else {
+            inventory->queued_requests += qmp_mon->qmp_requests->length;
+        }
+        parser_bytes = qmp_mon->parser.token_size;
+        if (qmp_mon->parser.lexer.state !=
+            qmp_mon->parser.lexer.start_state &&
+            qmp_mon->parser.lexer.token) {
+            if (UINT64_MAX - parser_bytes < qmp_mon->parser.lexer.token->len) {
+                inventory->overflowed = true;
+                parser_bytes = UINT64_MAX;
+            } else {
+                parser_bytes += qmp_mon->parser.lexer.token->len;
+            }
+        }
+        if (UINT64_MAX - inventory->parser_buffered_bytes < parser_bytes) {
+            inventory->overflowed = true;
+        } else {
+            inventory->parser_buffered_bytes += parser_bytes;
+        }
+        parser_partial = parser_bytes != 0 ||
+            !g_queue_is_empty(&qmp_mon->parser.tokens) ||
+            qmp_mon->parser.brace_count != 0 ||
+            qmp_mon->parser.bracket_count != 0 ||
+            qmp_mon->parser.lexer.state !=
+                qmp_mon->parser.lexer.start_state;
+        inventory->partial_parsers += parser_partial;
+        qemu_mutex_unlock(&qmp_mon->qmp_queue_lock);
+        qemu_rec_mutex_unlock(&qmp_mon->qmp_parser_lock);
+    }
+    inventory->complete = !inventory->overflowed &&
+        inventory->unstable_monitors == 0;
+    qemu_mutex_unlock(&monitor_lock);
+}
