+##
+# @CrucibleHotForkMonitorInventory:
+#
+# Bounded observational snapshot of QEMU monitor, dispatcher-queue, and JSON
+# parser state.  Busy parser state makes the report incomplete rather than
+# blocking while the global monitor-list lock is held.
+#
+# @schema-version: inventory contract version, currently 1
+#
+# @generation: monotonic process-local monitor create/destroy counter
+#
+# @complete: true exactly when the inventory did not overflow and every QMP
+#     parser was observed without racing another input callback
+#
+# @overflowed: whether the monitor or aggregate bound was exceeded
+#
+# @monitor-count: retained monitors, bounded to 256
+#
+# @qmp-monitors: retained QMP monitors
+#
+# @hmp-monitors: retained human monitors
+#
+# @io-thread-monitors: retained monitors using the monitor I/O thread
+#
+# @suspended-monitors: retained monitors whose input is suspended
+#
+# @negotiating-monitors: QMP monitors awaiting capabilities negotiation
+#
+# @oob-enabled-monitors: QMP monitors with OOB commands enabled
+#
+# @queued-requests: queued in-band QMP requests
+#
+# @parser-buffered-bytes: bytes retained by partial JSON parser state
+#
+# @partial-parsers: parsers retaining a partial JSON message
+#
+# @unstable-monitors: QMP monitors whose parser lock was busy
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'struct': 'CrucibleHotForkMonitorInventory',
+  'data': { 'schema-version': 'uint32',
+            'generation': 'uint64',
+            'complete': 'bool',
+            'overflowed': 'bool',
+            'monitor-count': 'uint32',
+            'qmp-monitors': 'uint32',
+            'hmp-monitors': 'uint32',
+            'io-thread-monitors': 'uint32',
+            'suspended-monitors': 'uint32',
+            'negotiating-monitors': 'uint32',
+            'oob-enabled-monitors': 'uint32',
+            'queued-requests': 'uint64',
+            'parser-buffered-bytes': 'uint64',
+            'partial-parsers': 'uint32',
+            'unstable-monitors': 'uint32' } }
+
+##
+# @query-crucible-hot-fork-monitor-inventory:
+#
+# Query one bounded monitor and parser snapshot.  This command is
+# observational: it does not rebuild child monitor state or authorize a fork.
+#
+# Returns: @CrucibleHotForkMonitorInventory
+#
+# Since: 10.0 (Crucible downstream extension)
+##
+{ 'command': 'query-crucible-hot-fork-monitor-inventory',
+  'returns': 'CrucibleHotForkMonitorInventory',
+  'allow-oob': true }
+
 ##
 # @CrucibleHotForkTimerClock:
 #
