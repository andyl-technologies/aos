+static bool crucible_instruction_rule_u32(
+    const QemuCrucibleFaultRule *rule, uint16_t tag, uint32_t *value)
+{
+    const uint8_t *data;
+    uint32_t length;
+
+    if (!qemu_crucible_fault_rule_field(
+            rule, tag, CRUCIBLE_NODE_FAULT_FIELD_TYPE_U32,
+            &data, &length) || length != 4) {
+        return false;
+    }
+    *value = ldl_le_p(data);
+    return true;
+}
+
+static bool crucible_instruction_rule_hash(
+    const QemuCrucibleFaultRule *rule, uint16_t tag,
+    const uint8_t **value)
+{
+    uint32_t length;
+
+    return qemu_crucible_fault_rule_field(
+               rule, tag, CRUCIBLE_NODE_FAULT_FIELD_TYPE_HASH,
+               value, &length) && length == 32;
+}
