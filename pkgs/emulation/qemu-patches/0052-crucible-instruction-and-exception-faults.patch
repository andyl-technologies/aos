+
+        selector_len = sizeof(fp_compare);
+        selector_bytes = g_realloc(selector_bytes, selector_len);
+        memcpy(selector_bytes, fp_compare, selector_len);
+    } else if (test_mode == TEST_REJECT_X86_SSE_PREFIX) {
+        static const uint8_t invalid_movaps[] = { 0xf3, 0x0f, 0x28, 0xc0 };
+
+        selector_len = sizeof(invalid_movaps);
+        selector_bytes = g_realloc(selector_bytes, selector_len);
+        memcpy(selector_bytes, invalid_movaps, selector_len);
+    } else if (test_mode == TEST_REJECT_X86_FAR_REGISTER) {
+        static const uint8_t invalid_far_call[] = { 0xff, 0xd8 };
+
+        selector_len = sizeof(invalid_far_call);
+        selector_bytes = g_realloc(selector_bytes, selector_len);
+        memcpy(selector_bytes, invalid_far_call, selector_len);
+    } else if (test_mode == TEST_REJECT_A64_SHIFT_IMM6) {
+        static const uint8_t invalid_add_shift[] = { 0x00, 0x80, 0x00, 0x0b };
+
+        selector_len = sizeof(invalid_add_shift);
+        selector_bytes = g_realloc(selector_bytes, selector_len);
+        memcpy(selector_bytes, invalid_add_shift, selector_len);
+    } else if (test_mode == TEST_REJECT_A64_VECTOR_MODE) {
+        static const uint8_t invalid_vector_store[] = {
+            0x00, 0x08, 0x00, 0x3c,
+        };
+
+        selector_len = sizeof(invalid_vector_store);
+        selector_bytes = g_realloc(selector_bytes, selector_len);
+        memcpy(selector_bytes, invalid_vector_store, selector_len);
+    } else if (test_mode == TEST_REJECT_A64_EXCEPTION_ENCODING) {
+        static const uint8_t invalid_exception[] = { 0x00, 0x00, 0x00, 0xd4 };
+
+        selector_len = sizeof(invalid_exception);
+        selector_bytes = g_realloc(selector_bytes, selector_len);
+        memcpy(selector_bytes, invalid_exception, selector_len);
+    } else if (test_mode == TEST_REJECT_A64_FP_TYPE) {
+        static const uint8_t invalid_fp_type[] = { 0x00, 0x28, 0xe0, 0x1e };
+
+        selector_len = sizeof(invalid_fp_type);
+        selector_bytes = g_realloc(selector_bytes, selector_len);
+        memcpy(selector_bytes, invalid_fp_type, selector_len);
+    } else if (test_mode == TEST_REJECT_A64_VECTOR_SIZE) {
+        static const uint8_t invalid_vector_size[] = { 0x00, 0xd4, 0x60, 0x0e };
+
+        selector_len = sizeof(invalid_vector_size);
+        selector_bytes = g_realloc(selector_bytes, selector_len);
+        memcpy(selector_bytes, invalid_vector_size, selector_len);
+    }
+    if (alternate_selector) {
+        static const uint8_t x86_alternate[] = { 0x48, 0x01, 0xc0 };
+        static const uint8_t aarch64_alternate[] = {
+            0x00, 0x00, 0x00, 0x91,
+        };
+        const uint8_t *alternate = test_architecture == 2 ?
+            x86_alternate : aarch64_alternate;
+        size_t alternate_len = test_architecture == 2 ?
+            sizeof(x86_alternate) : sizeof(aarch64_alternate);
+
+        selector_bytes = g_realloc(selector_bytes, alternate_len);
+        memcpy(selector_bytes, alternate, alternate_len);
+        selector_len = alternate_len;
+    }
+    instruction_hex = test_encode_hex(selector_bytes, selector_len);
+    opcode_class = test_mode == TEST_REJECT_OPCODE_CLASS ?
+        g_strdup_printf("%u", test_architecture == 2 ?
+                        0x01000008U : 0x02000007U) :
+        g_strdup("null");
+    g_autofree char *selector = g_strdup_printf(
+        "CRUCJSN1{\"input_state_sha256\":%s,"
+        "\"instruction_bytes\":\"%s\","
+        "\"occurrence\":{\"kind\":\"periodic\",\"parameters\":{"
+        "\"count\":1,\"first\":%" G_GUINT64_FORMAT
+        ",\"period\":1}},"
+        "\"opcode_class\":%s,\"pc_length\":%zu,"
+        "\"pc_start\":%" G_GUINT64_FORMAT "}",
+        input_state, instruction_hex, occurrence_first, opcode_class,
+        selector_len, test_pc);
+    g_autofree char *mask = g_malloc0(test_register_bytes * 2 + 1);
+    g_autofree char *value = g_malloc0(test_register_bytes * 2 + 1);
+    g_autofree char *mutation = NULL;
+    uint8_t header[CRUCIBLE_NODE_FAULT_PAYLOAD_HEADER_V1_BYTES] = { 0 };
+    uint8_t zero_hash[32] = { 0 };
+    uint8_t zero_byte = 0;
+    uint8_t action_hash[32];
+    uint8_t target_hash[32];
+    uint8_t schema_hash[32];
+    uint32_t mutation_kind = 0;
+    uint32_t replay_count = 0;
+
+    memset(mask, '0', test_register_bytes * 2);
+    mask[0] = '0';
+    mask[1] = '1';
+    memset(value, '0', test_register_bytes * 2);
+    value[0] = '4';
+    value[1] = '2';
+    mutation = compose_replace ?
+        g_strdup_printf(
+            "CRUCJSN1{\"kind\":\"replace\","
+            "\"parameters\":{\"value\":\"%s\"}}", value) :
+        g_strdup_printf(
+            "CRUCJSN1{\"kind\":\"bit_flip\","
+            "\"parameters\":{\"mask\":\"%s\"}}", mask);
+    switch (test_mode) {
+    case TEST_RESULT:
+    case TEST_RESULT_COMPOSE:
+    case TEST_RESULT_INPUT:
+    case TEST_RESULT_INPUT_COMPOSE:
+    case TEST_RESULT_FAULT_RETRY:
+    case TEST_EVENT_SATURATION:
+    case TEST_RESULT_LOAD:
+    case TEST_RESULT_FP_SIMD:
+    case TEST_REJECT_DESTINATION:
+    case TEST_REJECT_A64_CMP_SP:
+    case TEST_REJECT_A64_FP_COMPARE_DESTINATION:
+        mutation_kind = 1;
+        break;
+    case TEST_SKIP:
+    case TEST_REJECT_OVERLAP:
+    case TEST_EXCLUSIVE_SELECTORS:
+    case TEST_SKIP_CONTROL:
+    case TEST_SKIP_EXCEPTION:
+    case TEST_SKIP_LOAD:
+    case TEST_SKIP_STORE:
+    case TEST_SKIP_FP_SIMD:
+    case TEST_INPUT_MISMATCH:
+    case TEST_REJECT_ATOMIC_SKIP:
+    case TEST_REJECT_BYTES:
+    case TEST_REJECT_OPCODE_CLASS:
+    case TEST_REJECT_PREFIX:
+    case TEST_REJECT_LOCK:
+    case TEST_REJECT_X86_SSE_PREFIX:
+    case TEST_REJECT_X86_FAR_REGISTER:
+    case TEST_REJECT_A64_SHIFT_IMM6:
+    case TEST_REJECT_A64_VECTOR_MODE:
+    case TEST_REJECT_A64_EXCEPTION_ENCODING:
+    case TEST_REJECT_A64_FP_TYPE:
+    case TEST_REJECT_A64_VECTOR_SIZE:
+        mutation_kind = 2;
+        break;
+    case TEST_REPLAY:
+    case TEST_REPLAY_STORE:
+    case TEST_REPLAY_ATOMIC:
+    case TEST_REPLAY_DEVICE:
+    case TEST_REPLAY_LOAD:
+    case TEST_REPLAY_FP_SIMD:
+    case TEST_REPLAY_SELF_MODIFY:
+    case TEST_REPLAY_EXCEPTION:
+    case TEST_REJECT_CONTROL_REPLAY:
+        mutation_kind = 3;
+        replay_count = 2;
+        break;
+    default:
+        test_fail("exception mode used an instruction payload");
+    }
+    test_identity(action_hash, 0xa1,
+                  mutation_kind + (compose_replace ? 16 : 0));
+    test_identity(target_hash, 0xa2, 0);
+    test_identity(schema_hash, 0xa3, 1);
+    memcpy(header + CRUCIBLE_NODE_FAULT_PAYLOAD_MAGIC_OFFSET,
+           "CRUCNOD1", 8);
+    test_put_u16(header + CRUCIBLE_NODE_FAULT_PAYLOAD_VERSION_OFFSET,
+                 CRUCIBLE_NODE_FAULT_PAYLOAD_VERSION_V1);
+    test_put_u16(header + CRUCIBLE_NODE_FAULT_PAYLOAD_COMMAND_KIND_OFFSET,
+                 CRUCIBLE_FAULT_COMMAND_CPU_INSTRUCTION_TRANSFORM);
+    test_put_u16(header + CRUCIBLE_NODE_FAULT_PAYLOAD_OPERATION_OFFSET,
+                 operation);
+    test_put_u16(header + CRUCIBLE_NODE_FAULT_PAYLOAD_TARGET_KIND_OFFSET,
+                 CRUCIBLE_NODE_FAULT_TARGET_VCPU);
+    test_put_u16(header + CRUCIBLE_NODE_FAULT_PAYLOAD_MODEL_PHASE_OFFSET,
+                 test_model_phase);
+    test_put_u64(header + CRUCIBLE_NODE_FAULT_PAYLOAD_GENERATION_OFFSET, 1);
+    memcpy(header + CRUCIBLE_NODE_FAULT_PAYLOAD_ACTION_HASH_OFFSET,
+           action_hash, 32);
+    memcpy(header + CRUCIBLE_NODE_FAULT_PAYLOAD_TARGET_HASH_OFFSET,
+           target_hash, 32);
+    memcpy(header + CRUCIBLE_NODE_FAULT_PAYLOAD_SCHEMA_HASH_OFFSET,
+           schema_hash, 32);
+    test_put_u16(header + CRUCIBLE_NODE_FAULT_PAYLOAD_FIELD_COUNT_OFFSET, 6);
+    g_byte_array_append(payload, header, sizeof(header));
+    test_append_field(payload, CRUCIBLE_NODE_FAULT_FIELD_P1,
+                      CRUCIBLE_NODE_FAULT_FIELD_TYPE_BYTES,
+                      selector, strlen(selector));
+    test_append_u32(payload, CRUCIBLE_NODE_FAULT_FIELD_P2, mutation_kind);
+    test_append_field(payload, CRUCIBLE_NODE_FAULT_FIELD_P3,
+                      CRUCIBLE_NODE_FAULT_FIELD_TYPE_HASH,
+                      mutation_kind == 1 ? test_register_identity : zero_hash,
+                      32);
+    test_append_field(payload, CRUCIBLE_NODE_FAULT_FIELD_P4,
+                      CRUCIBLE_NODE_FAULT_FIELD_TYPE_BYTES,
+                      mutation_kind == 1 ? (uint8_t *)mutation : &zero_byte,
+                      mutation_kind == 1 ? strlen(mutation) : 1);
+    test_append_u32(payload, CRUCIBLE_NODE_FAULT_FIELD_P5, replay_count);
+    test_append_u32(payload, CRUCIBLE_NODE_FAULT_FIELD_T1, 0);
+    *payload_len = payload->len;
+    return g_byte_array_free(g_steal_pointer(&payload), false);
+}
+
+static uint8_t *test_build_exception_payload(size_t *payload_len)
+{
+    g_autoptr(GByteArray) payload = g_byte_array_sized_new(512);
+    const char *architecture = test_architecture == 2 ? "x86_64" : "aarch64";
+    uint32_t vector = test_architecture == 2 ? 6 : 1;
+    uint32_t syndrome = test_architecture == 2 ? 0 : 0x02000000;
+    g_autofree char *exception = g_strdup_printf(
+        "CRUCJSN1{\"architecture\":\"%s\","
+        "\"before_instruction\":%s,\"fault_address\":null,"
+        "\"maskable\":false,\"record\":{"
+        "\"kind\":\"architecture_default\"},"
+        "\"syndrome\":%u,\"vector\":%u}", architecture,
+        test_model_phase == TEST_MODEL_PHASE_BEFORE_INSTRUCTION ?
+        "true" : "false", syndrome, vector);
+    uint8_t header[CRUCIBLE_NODE_FAULT_PAYLOAD_HEADER_V1_BYTES] = { 0 };
+    uint8_t action_hash[32];
+    uint8_t target_hash[32];
+    uint8_t schema_hash[32];
+
+    test_identity(action_hash, 0xa1, vector);
+    test_identity(target_hash, 0xa2, 0);
+    test_identity(schema_hash, 0xa3, 1);
+    memcpy(header + CRUCIBLE_NODE_FAULT_PAYLOAD_MAGIC_OFFSET,
+           "CRUCNOD1", 8);
+    test_put_u16(header + CRUCIBLE_NODE_FAULT_PAYLOAD_VERSION_OFFSET,
+                 CRUCIBLE_NODE_FAULT_PAYLOAD_VERSION_V1);
+    test_put_u16(header + CRUCIBLE_NODE_FAULT_PAYLOAD_COMMAND_KIND_OFFSET,
+                 CRUCIBLE_FAULT_COMMAND_CPU_EXCEPTION);
+    test_put_u16(header + CRUCIBLE_NODE_FAULT_PAYLOAD_OPERATION_OFFSET,
+                 CRUCIBLE_NODE_FAULT_OPERATION_APPLY);
+    test_put_u16(header + CRUCIBLE_NODE_FAULT_PAYLOAD_TARGET_KIND_OFFSET,
+                 CRUCIBLE_NODE_FAULT_TARGET_VCPU);
+    test_put_u16(header + CRUCIBLE_NODE_FAULT_PAYLOAD_MODEL_PHASE_OFFSET,
+                 test_model_phase);
+    test_put_u64(header + CRUCIBLE_NODE_FAULT_PAYLOAD_GENERATION_OFFSET, 1);
+    memcpy(header + CRUCIBLE_NODE_FAULT_PAYLOAD_ACTION_HASH_OFFSET,
+           action_hash, 32);
+    memcpy(header + CRUCIBLE_NODE_FAULT_PAYLOAD_TARGET_HASH_OFFSET,
+           target_hash, 32);
+    memcpy(header + CRUCIBLE_NODE_FAULT_PAYLOAD_SCHEMA_HASH_OFFSET,
+           schema_hash, 32);
+    test_put_u16(header + CRUCIBLE_NODE_FAULT_PAYLOAD_FIELD_COUNT_OFFSET, 2);
+    g_byte_array_append(payload, header, sizeof(header));
+    test_append_field(payload, CRUCIBLE_NODE_FAULT_FIELD_P1,
+                      CRUCIBLE_NODE_FAULT_FIELD_TYPE_BYTES,
+                      exception, strlen(exception));
+    test_append_u32(payload, CRUCIBLE_NODE_FAULT_FIELD_T1, 0);
+    *payload_len = payload->len;
+    return g_byte_array_free(g_steal_pointer(&payload), false);
+}
+
+static bool test_rejects(void)
+{
+    return test_mode == TEST_REJECT_ATOMIC_SKIP ||
+           test_mode == TEST_REJECT_CONTROL_REPLAY ||
+           test_mode == TEST_REJECT_DESTINATION ||
+           test_mode == TEST_REJECT_BYTES ||
+           test_mode == TEST_REJECT_OPCODE_CLASS ||
+           test_mode == TEST_REJECT_PREFIX ||
+           test_mode == TEST_REJECT_LOCK ||
+           test_mode == TEST_REJECT_A64_CMP_SP ||
+           test_mode == TEST_REJECT_A64_FP_COMPARE_DESTINATION ||
+           test_mode == TEST_REJECT_X86_SSE_PREFIX ||
+           test_mode == TEST_REJECT_X86_FAR_REGISTER ||
+           test_mode == TEST_REJECT_A64_SHIFT_IMM6 ||
+           test_mode == TEST_REJECT_A64_VECTOR_MODE ||
+           test_mode == TEST_REJECT_A64_EXCEPTION_ENCODING ||
+           test_mode == TEST_REJECT_A64_FP_TYPE ||
+           test_mode == TEST_REJECT_A64_VECTOR_SIZE;
+}
+
+static bool test_exception(void)
+{
+    return test_mode == TEST_EXCEPTION_BEFORE ||
+           test_mode == TEST_EXCEPTION_AFTER;
+}
+
+static void test_finish(void)
+{
+    if (test_finished || !test_event_validated ||
+        (!test_rejects() && !test_guest_validated)) {
+        return;
+    }
+    test_finished = true;
+    g_printerr("CRUCIBLE_INSTRUCTION_LIVE_PASS architecture=%u mode=%u "
+               "pc=%" G_GUINT64_FORMAT " replay_events=%u\n",
+               test_architecture, test_mode, test_pc, test_replay_events);
+    qemu_plugin_request_shutdown(0);
+}
+
+static void test_validate_instruction_event(
+    const struct qemu_plugin_crucible_fault_event *event,
+    const uint8_t *evidence, size_t evidence_len)
+{
+    uint8_t digest[32];
+    uint32_t expected_kind = test_result_mode() ? 1 :
+        (test_skip_mode() ? 2 : 3);
+    uint32_t ordinal;
+    uint32_t total;
+    uint32_t detail_len;
+    uint8_t before_state[32];
+    uint8_t after_state[32];
+
+    if (evidence_len < TEST_INSTRUCTION_EVIDENCE_HEADER_BYTES) {
+        test_fail("instruction evidence header is truncated");
+    }
+    test_instruction_state_sha256(
+        evidence + 416, evidence + 288, evidence + 352,
+        test_get_u64(evidence + 480), test_get_u64(evidence + 496),
+        before_state);
+    test_instruction_state_sha256(
+        evidence + 448, evidence + 320, evidence + 384,
+        test_get_u64(evidence + 488), test_get_u64(evidence + 504),
+        after_state);
+
+    if (evidence_len < TEST_INSTRUCTION_EVIDENCE_HEADER_BYTES ||
+        memcmp(evidence, "CRUCINS1", 8) != 0 ||
+        test_get_u16(evidence + 8) != 3 ||
+        test_get_u16(evidence + 10) != test_architecture ||
+        test_get_u32(evidence + 12) != expected_kind ||
+        test_get_u64(evidence + 32) != test_pc ||
+        test_get_u64(evidence + 48) != event->observed_icount ||
+        test_get_u32(evidence + 56) != test_instruction_len ||
+        test_get_u32(evidence + 160) != 0 ||
+        test_get_u32(evidence + 528) == 0 ||
+        test_get_u32(evidence + 528) > 2 ||
+        test_get_u32(evidence + 532) !=
+            (test_mode == TEST_INPUT_MISMATCH || test_input_bound_mode()) ||
+        (test_input_bound_mode() &&
+         memcmp(evidence + 536, evidence + 568, 32) != 0) ||
+        (!test_input_bound_mode() &&
+         !test_bytes_equal(evidence + 536, 32,
+                           test_mode == TEST_INPUT_MISMATCH ? 0xff : 0)) ||
+        !memcmp(evidence + 568, (uint8_t[32]) { 0 }, 32) ||
+        memcmp(evidence + 600, (uint8_t[8]) { 0 }, 8) != 0 ||
+        test_get_u64(evidence + 480) == 0 ||
+        test_get_u64(evidence + 488) == 0 ||
+        test_get_u64(evidence + 496) == 0 ||
+        test_get_u64(evidence + 504) == 0 ||
+        test_get_u64(evidence + 512) == UINT64_MAX ||
+        !memcmp(evidence + 192, (uint8_t[32]) { 0 }, 32) ||
+        memcmp(evidence + 192, test_instruction_manifest_sha256, 32) != 0 ||
+        !memcmp(evidence + 224, (uint8_t[32]) { 0 }, 32) ||
+        !memcmp(evidence + 288, (uint8_t[32]) { 0 }, 32) ||
+        !memcmp(evidence + 320, (uint8_t[32]) { 0 }, 32) ||
+        !memcmp(evidence + 352, (uint8_t[32]) { 0 }, 32) ||
+        !memcmp(evidence + 384, (uint8_t[32]) { 0 }, 32) ||
+        memcmp(evidence + 96, event->before_hash, 32) != 0 ||
+        memcmp(evidence + 128, event->after_hash, 32) != 0 ||
+        memcmp(evidence + 96, before_state, 32) != 0 ||
+        memcmp(evidence + 128, after_state, 32) != 0) {
+        test_fail("instruction evidence header is invalid");
+    }
+    detail_len = test_get_u32(evidence + 60);
+    if (TEST_INSTRUCTION_EVIDENCE_HEADER_BYTES + test_instruction_len +
+            detail_len != evidence_len ||
+        memcmp(evidence + TEST_INSTRUCTION_EVIDENCE_HEADER_BYTES,
+               test_instruction_bytes, test_instruction_len) != 0) {
+        test_fail("instruction evidence payload is invalid");
+    }
+    test_sha256(evidence, evidence_len, digest);
+    if (memcmp(digest, event->opportunity_hash, 32) != 0) {
+        test_fail("instruction evidence digest is invalid");
+    }
+    if (test_mode == TEST_INPUT_MISMATCH &&
+        memcmp(evidence + 96, evidence + 128, 32) != 0) {
+        test_fail("input-state mismatch changed system state");
+    }
+    if (test_mode == TEST_REPLAY_SELF_MODIFY) {
+        ordinal = test_get_u32(evidence + 16);
+        total = test_get_u32(evidence + 20);
+        if (total != 2 || ordinal != test_replay_events) {
+            test_fail("self-modifying replay ordinal is invalid");
+        }
+        if (event->outcome == CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED &&
+            test_replay_events == 0 && detail_len == 0) {
+            test_replay_events = 1;
+            return;
+        }
+        if (event->outcome == CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR &&
+            test_replay_events == 1 && detail_len == test_instruction_len) {
+            test_event_validated = true;
+            test_guest_validated = true;
+            return;
+        }
+        g_printerr("self-modifying replay outcome=%u ordinal=%u total=%u "
+                   "detail_len=%u replay_events=%u\n",
+                   event->outcome, ordinal, total, detail_len,
+                   test_replay_events);
+        test_fail("self-modifying replay did not fail closed");
+    }
+    if (test_mode == TEST_REPLAY_EXCEPTION) {
+        ordinal = test_get_u32(evidence + 16);
+        total = test_get_u32(evidence + 20);
+        if (total != 2 || ordinal != test_replay_events || detail_len != 0) {
+            test_fail("exceptional replay ordinal is invalid");
+        }
+        if (event->outcome == CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED &&
+            test_replay_events == 0) {
+            test_replay_events = 1;
+            return;
+        }
+        if (event->outcome == CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR &&
+            test_replay_events == 1) {
+            test_event_validated = true;
+            test_guest_validated = true;
+            return;
+        }
+        test_fail("natural replay exception did not fail closed");
+    }
+    if (test_mode == TEST_REPLAY_STORE ||
+        test_mode == TEST_REPLAY_ATOMIC) {
+        test_replay_ram_changed |=
+            memcmp(evidence + 288, evidence + 320, 32) != 0;
+    }
+    if (test_mode == TEST_REPLAY_DEVICE) {
+        const uint8_t *detail = evidence +
+            TEST_INSTRUCTION_EVIDENCE_HEADER_BYTES + test_instruction_len;
+
+        if (!test_port_io_evidence(detail, detail_len)) {
+            test_fail("device replay lacks an actual port-I/O transcript");
+        }
+    }
+    if (test_result_mode()) {
+        const uint8_t *detail = evidence +
+            TEST_INSTRUCTION_EVIDENCE_HEADER_BYTES + test_instruction_len;
+
+        if (detail_len < 160 || memcmp(detail, "CRUCQRW1", 8) != 0 ||
+            test_get_u32(evidence + 164) == 0) {
+            test_fail("result corruption lacks register evidence");
+        }
+        if (test_compose_mode()) {
+            uint8_t expected_binding =
+                test_compose_events == 0 ? 0x20 : 0x21;
+
+            if (test_compose_events >= 2 ||
+                !test_bytes_equal(event->binding_hash, 32,
+                                  expected_binding)) {
+                test_fail("result contributors are not canonically ordered");
+            }
+            test_compose_events++;
+            test_event_validated = test_compose_events == 2;
+        } else {
+            test_event_validated = true;
+        }
+        g_printerr("CRUCIBLE_MATCHED_INPUT_STATE=");
+        for (size_t index = 0; index < 32; index++) {
+            g_printerr("%02x", evidence[568 + index]);
+        }
+        g_printerr("\n");
+        return;
+    }
+    ordinal = test_get_u32(evidence + 16);
+    total = test_get_u32(evidence + 20);
+    if (test_skip_mode()) {
+        if (ordinal != 0 || total != 0 || detail_len != 0) {
+            test_fail("skip evidence counter treatment is invalid");
+        }
+        if (test_mode == TEST_SKIP_STORE &&
+            memcmp(evidence + 288, evidence + 320, 32) != 0) {
+            test_fail("skipped store changed the canonical RAM root");
+        }
+        test_event_validated = true;
+        return;
+    }
+    if (total != 2 || ordinal != test_replay_events ||
+        (test_mode == TEST_REPLAY_DEVICE ? detail_len == 0 :
+                                           detail_len != 0)) {
+        test_fail("replay ordinal sequence is invalid");
+    }
+    test_replay_events++;
+    if (test_replay_events == 3 &&
+        (test_mode == TEST_REPLAY_STORE ||
+         test_mode == TEST_REPLAY_ATOMIC) && !test_replay_ram_changed) {
+        test_fail("RAM replay never changed guest RAM evidence");
+    }
+    test_event_validated = test_replay_events == 3;
+}
+
+static void test_poll_events(void)
+{
+    struct qemu_plugin_crucible_fault_event event;
+    uint8_t evidence[16384];
+    size_t evidence_len;
+    int status;
+
+    do {
+        evidence_len = 0;
+        memset(&event, 0, sizeof(event));
+        status = qemu_plugin_crucible_fault_event_poll(
+            &event, evidence, sizeof(evidence), &evidence_len);
+        if (status < 0) {
+            test_fail("fault event polling failed");
+        }
+        if (status != 1) {
+            continue;
+        }
+        if (test_saturation_mode()) {
+            if (evidence_len == 128 &&
+                memcmp(evidence, "CRUCQFL1", 8) == 0) {
+                if (event.outcome != CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR ||
+                    test_get_u32(evidence + 8) != 1 ||
+                    test_get_u32(evidence + 12) < 4095 ||
+                    test_get_u32(evidence + 16) != 4096 ||
+                    test_get_u16(evidence + 66) != 1 ||
+                    memcmp(evidence + 32, event.opportunity_hash, 32) != 0) {
+                    test_fail("terminal event-capacity evidence is invalid");
+                }
+                test_event_validated = true;
+                test_guest_validated = true;
+            } else {
+                if (event.outcome != CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED ||
+                    evidence_len < TEST_INSTRUCTION_EVIDENCE_HEADER_BYTES ||
+                    memcmp(evidence, "CRUCINS1", 8) != 0) {
+                    test_fail("pre-terminal saturation event is invalid");
+                }
+                test_replay_events++;
+            }
+            continue;
+        }
+        if (test_control_plane_mode()) {
+            test_fail("control-plane selector test emitted an event");
+        }
+        if (test_rejects()) {
+            test_fail("rejected instruction rule emitted an event");
+        }
+        if (test_exception()) {
+            uint32_t vector = test_architecture == 2 ? 6 : 1;
+            uint64_t syndrome = test_architecture == 2 ? 0 : 0x02000000;
+            uint8_t digest[32];
+
+            if (event.command_kind != CRUCIBLE_FAULT_COMMAND_CPU_EXCEPTION ||
+                event.outcome != CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED ||
+                evidence_len != 192 ||
+                memcmp(evidence, "CRUCEXC1", 8) != 0 ||
+                test_get_u16(evidence + 8) != 2 ||
+                test_get_u16(evidence + 10) != test_architecture ||
+                test_get_u16(evidence + 12) != test_model_phase ||
+                test_get_u32(evidence + 16) != 0 ||
+                test_get_u32(evidence + 20) != vector ||
+                test_get_u64(evidence + 24) != syndrome ||
+                evidence[48] != 0 || evidence[50] != 0 ||
+                evidence[51] != 1 ||
+                test_get_u64(evidence + 56) != event.observed_icount ||
+                test_get_u64(evidence + 64) == 0 ||
+                test_get_u32(evidence + 72) != vector ||
+                evidence[76] != 0 ||
+                test_get_u64(evidence + 80) != syndrome ||
+                memcmp(evidence + 96, event.before_hash, 32) != 0 ||
+                memcmp(evidence + 128, event.after_hash, 32) != 0 ||
+                memcmp(evidence + 160, (uint8_t[32]) { 0 }, 32) != 0) {
+                g_printerr("exception event kind=%u outcome=%u len=%zu "
+                           "version=%u architecture=%u phase=%u vcpu=%u "
+                           "vector=%u syndrome=%" G_GUINT64_FORMAT " "
+                           "flags=%u/%u/%u/%u delivered=%"
+                           G_GUINT64_FORMAT " pc=%" G_GUINT64_FORMAT " "
+                           "delivered_vector=%u address_flag=%u "
+                           "delivered_syndrome=%" G_GUINT64_FORMAT "\n",
+                           event.command_kind, event.outcome, evidence_len,
+                           test_get_u16(evidence + 8),
+                           test_get_u16(evidence + 10),
+                           test_get_u16(evidence + 12),
+                           test_get_u32(evidence + 16),
+                           test_get_u32(evidence + 20),
+                           test_get_u64(evidence + 24), evidence[48],
+                           evidence[49], evidence[50], evidence[51],
+                           test_get_u64(evidence + 56),
+                           test_get_u64(evidence + 64),
+                           test_get_u32(evidence + 72), evidence[76],
+                           test_get_u64(evidence + 80));
+                test_fail("exception evidence is invalid");
+            }
+            test_sha256(evidence, evidence_len, digest);
+            if (memcmp(digest, event.opportunity_hash, 32) != 0) {
+                test_fail("exception evidence digest is invalid");
+            }
+            test_event_validated = true;
+        } else if (event.command_kind ==
+                   CRUCIBLE_FAULT_COMMAND_CPU_INSTRUCTION_TRANSFORM) {
+            bool replay_error_outcome =
+                (test_mode == TEST_REPLAY_SELF_MODIFY ||
+                 test_mode == TEST_REPLAY_EXCEPTION) &&
+                (event.outcome == CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED ||
+                 event.outcome == CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR);
+            uint16_t expected_outcome = test_mode == TEST_INPUT_MISMATCH ?
+                CRUCIBLE_FAULT_EVENT_OUTCOME_SUPPRESSED :
+                CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED;
+
+            if ((!replay_error_outcome && event.outcome != expected_outcome) ||
+                event.model_phase != test_model_phase ||
+                event.target_kind != CRUCIBLE_NODE_FAULT_TARGET_VCPU) {
+                test_fail("instruction event identity is invalid");
+            }
+            test_validate_instruction_event(&event, evidence, evidence_len);
+        }
+    } while (status == 1);
+}
