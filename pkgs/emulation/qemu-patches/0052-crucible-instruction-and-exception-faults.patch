+static bool crucible_register_hex(const QObject *object, uint8_t *output,
+                                  size_t output_len)
+{
+    QString *string = qobject_to(QString, object);
+    const char *hex;
+
+    if (!string) {
+        return false;
+    }
+    hex = qstring_get_str(string);
+    if (strlen(hex) != output_len * 2) {
+        return false;
+    }
+    for (size_t i = 0; i < output_len; i++) {
+        int high = g_ascii_xdigit_value(hex[i * 2]);
+        int low = g_ascii_xdigit_value(hex[i * 2 + 1]);
+
+        if (high < 0 || low < 0) {
+            return false;
+        }
+        output[i] = (high << 4) | low;
+    }
