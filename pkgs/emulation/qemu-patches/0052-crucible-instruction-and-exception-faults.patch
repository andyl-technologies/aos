diff --git a/plugins/crucible-fault-instruction.c b/plugins/crucible-fault-instruction.c
new file mode 100644
index 0000000000000000000000000000000000000000..8c56d0d15e44bf18e0c5fda084a9db876535650f
--- /dev/null
+++ b/plugins/crucible-fault-instruction.c
@@ -0,0 +1,2825 @@
+/*
+ * Crucible architecture instruction faults
