+static void test_submit_commit(
+    const struct qemu_plugin_crucible_fault_result *prepared)
+{
+    if (prepared->status != CRUCIBLE_FAULT_STATUS_PREPARED ||
+        prepared->applied_icount != 0 ||
+        memcmp(prepared->before_hash, prepared->after_hash, 32) != 0) {
+        g_printerr("prepare result status=%u sequence=%" G_GUINT64_FORMAT
+                   " applied=%" G_GUINT64_FORMAT " hash_equal=%u\n",
+                   prepared->status, prepared->command_sequence,
+                   prepared->applied_icount,
+                   memcmp(prepared->before_hash, prepared->after_hash,
+                          32) == 0);
+        test_fail("fault preparation result is invalid");
+    }
+    if (test_compose_mode() &&
+        prepared->command_sequence == 1) {
+        memcpy(test_compose_precondition, prepared->before_hash, 32);
+        test_command2.target_icount = prepared->observed_icount + 32;
+        test_command2.authorization_ceiling_icount =
+            test_command2.target_icount;
+        if (qemu_plugin_crucible_fault_submit(
+                &test_command2, test_payload2, test_payload2_len) != 0) {
+            test_fail("second fault preparation submission failed");
+        }
+        qemu_plugin_force_vcpu_exit();
+        return;
+    }
+    if (test_compose_mode()) {
+        uint64_t target_icount;
+
+        if (prepared->command_sequence != 2 ||
+            memcmp(test_compose_precondition, prepared->before_hash, 32) != 0) {
+            test_fail("composed fault preparations observed different state");
+        }
+        target_icount = prepared->observed_icount + 32;
+        test_command.command_flags = 0;
+        test_command.command_sequence = 3;
+        test_command.target_icount = target_icount;
+        test_command.authorization_ceiling_icount = target_icount;
+        memcpy(test_command.expected_precondition_hash,
+               test_compose_precondition, 32);
+        test_command2.command_flags = 0;
+        test_command2.command_sequence = 4;
+        test_command2.target_icount = target_icount;
+        test_command2.authorization_ceiling_icount = target_icount;
+        memcpy(test_command2.expected_precondition_hash,
+               test_compose_precondition, 32);
+        if (qemu_plugin_crucible_fault_submit(
+                &test_command, test_payload, test_payload_len) != 0 ||
+            qemu_plugin_crucible_fault_submit(
+                &test_command2, test_payload2, test_payload2_len) != 0) {
+            test_fail("composed fault commit submission failed");
+        }
+        test_commit_submitted = true;
+        qemu_plugin_force_vcpu_exit();
+        return;
+    }
+    if (test_control_plane_mode() && prepared->command_sequence == 3) {
+        test_command2.command_flags = 0;
+        test_command2.command_sequence = 4;
+        test_command2.target_icount = prepared->observed_icount + 32;
+        test_command2.authorization_ceiling_icount =
+            test_command2.target_icount;
+        memcpy(test_command2.expected_precondition_hash,
+               prepared->before_hash, 32);
+        if (qemu_plugin_crucible_fault_submit(
+                &test_command2, test_payload2, test_payload2_len) != 0) {
+            test_fail("second fault commit submission failed");
+        }
+        qemu_plugin_force_vcpu_exit();
+        return;
+    }
+    if (prepared->command_sequence != 1) {
+        test_fail("fault preparation sequence is invalid");
+    }
+    test_command.command_flags = 0;
+    test_command.command_sequence = 2;
+    test_command.target_icount = prepared->observed_icount + 32;
+    test_command.authorization_ceiling_icount = test_command.target_icount;
+    memcpy(test_command.expected_precondition_hash, prepared->before_hash, 32);
+    if (qemu_plugin_crucible_fault_submit(
+            &test_command, test_payload, test_payload_len) != 0) {
+        test_fail("fault commit submission failed");
+    }
+    test_commit_submitted = true;
+    qemu_plugin_force_vcpu_exit();
+}
