+static void crucible_instruction_sha256(const uint8_t *data, size_t length,
+                                        uint8_t digest[32])
+{
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    gsize digest_len = 32;
+
+    g_checksum_update(checksum, data, length);
+    g_checksum_get_digest(checksum, digest, &digest_len);
+    g_assert(digest_len == 32);
+}
+
+size_t qemu_plugin_crucible_fault_instruction_manifest(
+    uint8_t *manifest, size_t capacity, uint8_t sha256[32],
+    uint16_t *architecture)
+{
+    CPUState *cpu = qemu_get_cpu(0);
+    size_t length = strlen(crucible_instruction_manifest_v1);
+
+    if (!cpu || !sha256 || !architecture ||
+        (capacity != 0 && !manifest)) {
+        return 0;
+    }
+    *architecture = CPU_GET_CLASS(cpu)->crucible_register_scope;
+    if (*architecture != CRUCIBLE_INSTRUCTION_SCOPE_X86_64 &&
+        *architecture != CRUCIBLE_INSTRUCTION_SCOPE_AARCH64) {
+        return 0;
+    }
+    crucible_instruction_sha256(
+        (const uint8_t *)crucible_instruction_manifest_v1,
+        length, sha256);
+    if (capacity >= length) {
+        memcpy(manifest, crucible_instruction_manifest_v1, length);
+    }
+    return length;
+}
+
+static void crucible_instruction_system_digest(
+    const uint8_t cpu_sha256[32], const uint8_t ram_sha256[32],
+    const uint8_t device_sha256[32], uint64_t ram_bytes,
+    uint64_t device_bytes, uint8_t digest[32])
+{
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    uint8_t lengths[16];
+    gsize digest_len = 32;
+
+    stq_le_p(lengths, ram_bytes);
+    stq_le_p(lengths + 8, device_bytes);
+    g_checksum_update(
+        checksum, (const uint8_t *)"crucible.instruction-state.v1\0",
+        strlen("crucible.instruction-state.v1") + 1);
+    g_checksum_update(checksum, cpu_sha256, 32);
+    g_checksum_update(checksum, ram_sha256, 32);
+    g_checksum_update(checksum, device_sha256, 32);
+    g_checksum_update(checksum, lengths, sizeof(lengths));
+    g_checksum_get_digest(checksum, digest, &digest_len);
+    g_assert(digest_len == 32);
+}
+
+static int crucible_instruction_system_snapshot(
+    uint64_t observed_icount, CrucibleInstructionState *state)
+{
+    if (qemu_crucible_fault_execution_fingerprint(
+            observed_icount, state->cpu_sha256) != 0 ||
+        qemu_plugin_crucible_guest_ram_sha256(
+            state->ram_sha256, &state->ram_bytes) != 0 ||
+        qemu_plugin_crucible_device_state_sha256(
+            state->device_sha256, &state->device_bytes) != 0) {
+        return -EIO;
+    }
+    crucible_instruction_system_digest(
+        state->cpu_sha256, state->ram_sha256, state->device_sha256,
+        state->ram_bytes, state->device_bytes, state->state_sha256);
+    return 0;
+}
