+static void test_completion(void *opaque)
+{
+    struct qemu_plugin_crucible_fault_result result;
+    uint8_t evidence[16384];
+    size_t evidence_len;
+    int status;
+
+    (void)opaque;
+    do {
+        evidence_len = 0;
+        memset(&result, 0, sizeof(result));
+        status = qemu_plugin_crucible_fault_poll(
+            &result, evidence, sizeof(evidence), &evidence_len);
+        if (status < 0) {
+            test_fail("fault result polling failed");
+        }
+        if (status != 1 || result.command_kind != test_command.command_kind) {
+            continue;
+        }
+        if (result.command_sequence == 1 ||
+            (test_compose_mode() &&
+             result.command_sequence == 2) ||
+            (test_mode == TEST_EXCLUSIVE_SELECTORS &&
+             result.command_sequence == 3)) {
+            if (test_rejects()) {
+                uint16_t expected =
+                    (test_mode == TEST_REJECT_DESTINATION ||
+                     test_mode == TEST_REJECT_A64_CMP_SP) ?
+                    CRUCIBLE_FAULT_STATUS_INVALID_TARGET :
+                    CRUCIBLE_FAULT_STATUS_UNSUPPORTED_CAPABILITY;
+
+                if (result.status != expected || result.applied_icount != 0 ||
+                    evidence_len != 0) {
+                    g_printerr("rejection status=%u expected=%u applied=%"
+                               G_GUINT64_FORMAT " evidence=%zu\n",
+                               result.status, expected,
+                               result.applied_icount, evidence_len);
+                    test_fail("instruction rejection was not atomic");
+                }
+                test_event_validated = true;
+                test_guest_validated = true;
+            } else {
+                if (test_commit_submitted &&
+                    result.command_sequence == 1) {
+                    test_fail("fault preparation completed twice");
+                }
+                test_validate_rule_evidence(
+                    &result, evidence, evidence_len,
+                    result.command_sequence == 1 ? test_payload :
+                                                   test_payload2,
+                    result.command_sequence == 1 ? test_payload_len :
+                                                   test_payload2_len,
+                    test_control_plane_mode() ?
+                        (result.command_sequence == 1 ?
+                            CRUCIBLE_NODE_FAULT_OPERATION_UPSERT :
+                            (test_mode == TEST_EXCLUSIVE_SELECTORS ?
+                                CRUCIBLE_NODE_FAULT_OPERATION_UPSERT :
+                                CRUCIBLE_NODE_FAULT_OPERATION_APPLY)) :
+                        (test_saturation_mode() ?
+                            CRUCIBLE_NODE_FAULT_OPERATION_UPSERT :
+                            CRUCIBLE_NODE_FAULT_OPERATION_APPLY));
+                test_submit_commit(&result);
+            }
+        } else if (test_saturation_mode() &&
+                   result.command_sequence == 2) {
+            if (result.status != CRUCIBLE_FAULT_STATUS_APPLIED ||
+                result.applied_icount < result.observed_icount) {
+                test_fail("saturation producer was not installed");
+            }
+            test_validate_rule_evidence(
+                &result, evidence, evidence_len,
+                test_payload, test_payload_len,
+                CRUCIBLE_NODE_FAULT_OPERATION_UPSERT);
+            test_rule_installed = true;
+        } else if (test_control_plane_mode() &&
+                   result.command_sequence == 2) {
+            if (result.status != CRUCIBLE_FAULT_STATUS_APPLIED ||
+                result.applied_icount < result.observed_icount) {
+                test_fail("first persistent selector was not installed");
+            }
+            test_validate_rule_evidence(
+                &result, evidence, evidence_len,
+                test_payload, test_payload_len,
+                CRUCIBLE_NODE_FAULT_OPERATION_UPSERT);
+            test_command2.command_flags =
+                CRUCIBLE_FAULT_COMMAND_FLAG_PREPARE_ONLY;
+            test_command2.command_sequence = 3;
+            test_command2.target_icount = result.observed_icount + 32;
+            test_command2.authorization_ceiling_icount =
+                test_command2.target_icount;
+            memset(test_command2.expected_precondition_hash, 0, 32);
+            if (qemu_plugin_crucible_fault_submit(
+                    &test_command2, test_payload2,
+                    test_payload2_len) != 0) {
+                test_fail("second selector preparation submission failed");
+            }
+            qemu_plugin_force_vcpu_exit();
+        } else if (test_control_plane_mode() &&
+                   result.command_sequence == 3 &&
+                   test_mode == TEST_REJECT_OVERLAP) {
+            if (result.status != CRUCIBLE_FAULT_STATUS_INVALID_TARGET ||
+                result.applied_icount != 0 || evidence_len != 0) {
+                test_fail("overlapping instruction conflict was not atomic");
+            }
+            test_event_validated = true;
+            test_guest_validated = true;
+        } else if ((!test_compose_mode() &&
+                    !test_control_plane_mode() &&
+                    result.command_sequence == 2) ||
+                   (test_compose_mode() &&
+                    (result.command_sequence == 3 ||
+                     result.command_sequence == 4))) {
+            bool expected_fail_closed =
+                test_mode == TEST_REPLAY_SELF_MODIFY ||
+                test_mode == TEST_REPLAY_EXCEPTION;
+            uint16_t expected_status = expected_fail_closed ?
+                CRUCIBLE_FAULT_STATUS_INTERNAL_ERROR :
+                CRUCIBLE_FAULT_STATUS_APPLIED;
+            bool coordinate_valid =
+                expected_fail_closed ? result.applied_icount == 0 :
+                result.applied_icount >= result.observed_icount;
+
+            if (result.status != expected_status || !coordinate_valid) {
+                g_printerr("commit result status=%u observed=%"
+                           G_GUINT64_FORMAT " applied=%" G_GUINT64_FORMAT
+                           " evidence=%zu\n", result.status,
+                           result.observed_icount, result.applied_icount,
+                           evidence_len);
+                test_fail("fault commit was not applied");
+            }
+            if (evidence_len != 0 ||
+                memcmp(result.evidence_hash,
+                       (uint8_t[32]) { 0 }, 32) != 0) {
+                test_fail("deferred fault completion carried premature "
+                          "evidence");
+            }
+            if (test_compose_mode()) {
+                test_compose_completions++;
+                test_rule_installed = test_compose_completions == 2;
+            } else {
+                test_rule_installed = true;
+            }
+        } else if (test_mode == TEST_EXCLUSIVE_SELECTORS &&
+                   result.command_sequence == 4) {
+            if (result.status != CRUCIBLE_FAULT_STATUS_APPLIED ||
+                result.applied_icount < result.observed_icount) {
+                test_fail("mutually exclusive selector was rejected");
+            }
+            test_validate_rule_evidence(
+                &result, evidence, evidence_len,
+                test_payload2, test_payload2_len,
+                CRUCIBLE_NODE_FAULT_OPERATION_UPSERT);
+            test_event_validated = true;
+            test_guest_validated = true;
+        } else {
+            test_fail("unexpected fault command sequence");
+        }
+    } while (status == 1);
+    test_poll_events();
+    test_observe_guest();
+    test_finish();
+}
