+static void test_append_field(GByteArray *payload, uint16_t tag,
+                              uint16_t type, const void *value,
+                              uint32_t length)
+{
+    uint8_t header[CRUCIBLE_NODE_FAULT_FIELD_HEADER_V1_BYTES] = { 0 };
+
+    test_put_u16(header + CRUCIBLE_NODE_FAULT_FIELD_TAG_OFFSET, tag);
+    test_put_u16(header + CRUCIBLE_NODE_FAULT_FIELD_TYPE_OFFSET, type);
+    test_put_u32(header + CRUCIBLE_NODE_FAULT_FIELD_LENGTH_OFFSET, length);
+    g_byte_array_append(payload, header, sizeof(header));
+    if (length != 0) {
+        g_byte_array_append(payload, value, length);
+    }
+}
+
+static void test_append_u32(GByteArray *payload, uint16_t tag, uint32_t value)
