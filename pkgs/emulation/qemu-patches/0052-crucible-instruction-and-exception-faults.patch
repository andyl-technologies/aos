+static bool crucible_instruction_json_u64(const QObject *object,
+                                          uint64_t *value)
+{
+    QNum *number = qobject_to(QNum, object);
+
+    return number && number->kind != QNUM_DOUBLE &&
+           qnum_get_try_uint(number, value);
+}
+
+static bool crucible_instruction_json_u32(const QObject *object,
+                                          uint32_t *value)
+{
+    uint64_t wide;
+
+    if (!crucible_instruction_json_u64(object, &wide) ||
+        wide > UINT32_MAX) {
+        return false;
+    }
+    *value = wide;
+    return true;
+}
+
+static bool crucible_instruction_json_null(const QObject *object)
+{
+    return object && qobject_type(object) == QTYPE_QNULL;
+}
+
+static bool crucible_instruction_hex(const QObject *object, uint8_t *output,
+                                     uint32_t *output_len)
+{
+    QString *string = qobject_to(QString, object);
+    const char *hex;
+    size_t length;
+
+    if (!string) {
+        return false;
+    }
+    hex = qstring_get_str(string);
+    length = strlen(hex);
+    if (length == 0 || length > CRUCIBLE_INSTRUCTION_MAX_BYTES * 2 ||
+        length % 2 != 0) {
+        return false;
+    }
+    *output_len = length / 2;
+    for (uint32_t i = 0; i < *output_len; i++) {
+        int high = g_ascii_xdigit_value(hex[i * 2]);
+        int low = g_ascii_xdigit_value(hex[i * 2 + 1]);
+
+        if (high < 0 || low < 0) {
+            return false;
+        }
+        output[i] = (high << 4) | low;
+    }
+    return true;
+}
+
+static bool crucible_instruction_sha256_hex(const QObject *object,
+                                            uint8_t output[32])
+{
+    QString *string = qobject_to(QString, object);
+    const char *hex;
+
+    if (!string) {
+        return false;
+    }
+    hex = qstring_get_str(string);
+    if (strlen(hex) != 64) {
+        return false;
+    }
+    for (uint32_t i = 0; i < 32; i++) {
+        int high = g_ascii_xdigit_value(hex[i * 2]);
+        int low = g_ascii_xdigit_value(hex[i * 2 + 1]);
+
+        if (high < 0 || low < 0) {
+            return false;
+        }
+        output[i] = (high << 4) | low;
+    }
+    return true;
+}
+
+static bool crucible_instruction_selector(
+    const QemuCrucibleFaultRule *rule, CrucibleInstructionSelector *selector)
+{
+    QDict *dict = qobject_to(
+        QDict, qemu_crucible_fault_rule_json(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_P1));
+    QObject *bytes;
+    QObject *input_state;
+    QObject *opcode;
+
+    memset(selector, 0, sizeof(*selector));
+    if (!dict || qdict_size(dict) != 6 ||
+        !crucible_instruction_json_u64(
+            qdict_get(dict, "pc_start"), &selector->pc_start) ||
+        !crucible_instruction_json_u64(
+            qdict_get(dict, "pc_length"), &selector->pc_length) ||
+        selector->pc_length == 0 ||
+        selector->pc_start > UINT64_MAX - selector->pc_length) {
+        return false;
+    }
+    bytes = qdict_get(dict, "instruction_bytes");
+    if (!crucible_instruction_json_null(bytes)) {
+        selector->has_bytes = true;
+        if (!crucible_instruction_hex(
+                bytes, selector->bytes, &selector->bytes_len)) {
+            return false;
+        }
+    }
+    opcode = qdict_get(dict, "opcode_class");
+    if (!crucible_instruction_json_null(opcode)) {
+        selector->has_opcode_class = true;
+        if (!crucible_instruction_json_u32(
+                opcode, &selector->opcode_class)) {
+            return false;
+        }
+    }
+    input_state = qdict_get(dict, "input_state_sha256");
+    if (!crucible_instruction_json_null(input_state)) {
+        selector->has_input_state_sha256 = true;
+        if (!crucible_instruction_sha256_hex(
+                input_state, selector->input_state_sha256)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static void crucible_instruction_destination(
+    CrucibleInstructionMetadata *metadata, uint32_t numeric_id)
+{
+    for (uint32_t i = 0; i < metadata->destination_count; i++) {
+        if (metadata->destinations[i] == numeric_id) {
+            return;
+        }
+    }
+    if (numeric_id != 0 &&
+        metadata->destination_count < CRUCIBLE_INSTRUCTION_MAX_DESTINATIONS) {
+        metadata->destinations[metadata->destination_count++] = numeric_id;
+    }
+}
