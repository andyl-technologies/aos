+static void test_exec(unsigned int cpu_index, uint64_t icount, void *opaque)
+{
+    (void)cpu_index;
+    (void)opaque;
+    if (test_exception() && !test_prepare_submitted &&
+        test_target_translations != 0) {
+        test_command.target_icount = icount + 64;
+        test_command.authorization_ceiling_icount =
+            test_command.target_icount;
+        if (qemu_plugin_crucible_fault_submit(
+                &test_command, test_payload, test_payload_len) != 0) {
+            test_fail("fault preparation submission failed");
+        }
+        test_prepare_submitted = true;
+        qemu_plugin_force_vcpu_exit();
+    }
+    if (!test_saturation_mode()) {
+        test_poll_events();
+    }
+    test_observe_guest();
+    test_finish();
+}
