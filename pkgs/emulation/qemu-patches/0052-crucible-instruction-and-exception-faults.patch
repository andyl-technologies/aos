+static uint16_t test_get_u16(const uint8_t *bytes)
+{
+    return bytes[0] | (uint16_t)bytes[1] << 8;
+}
+
+static uint32_t test_get_u32(const uint8_t *bytes)
+{
+    return bytes[0] | (uint32_t)bytes[1] << 8 |
+           (uint32_t)bytes[2] << 16 | (uint32_t)bytes[3] << 24;
+}
+
+static uint64_t test_get_u64(const uint8_t *bytes)
+{
+    return test_get_u32(bytes) | (uint64_t)test_get_u32(bytes + 4) << 32;
+}
+
+static bool test_bytes_equal(const uint8_t *bytes, size_t length,
+                             uint8_t expected)
+{
+    for (size_t i = 0; i < length; i++) {
+        if (bytes[i] != expected) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static void test_put_u16(uint8_t *bytes, uint16_t value)
+{
+    bytes[0] = value;
+    bytes[1] = value >> 8;
+}
+
+static void test_put_u32(uint8_t *bytes, uint32_t value)
+{
+    for (size_t i = 0; i < sizeof(value); i++) {
+        bytes[i] = value >> (i * 8);
+    }
+}
+
+static void test_put_u64(uint8_t *bytes, uint64_t value)
+{
+    for (size_t i = 0; i < sizeof(value); i++) {
+        bytes[i] = value >> (i * 8);
+    }
+}
+
+static void test_sha256(const uint8_t *bytes, size_t length,
+                        uint8_t digest[32])
+{
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    gsize digest_len = 32;
+
+    g_checksum_update(checksum, bytes, length);
+    g_checksum_get_digest(checksum, digest, &digest_len);
+    if (digest_len != 32) {
+        test_fail("SHA-256 framing failed");
+    }
+}
+
+static void test_instruction_state_sha256(
+    const uint8_t cpu_sha256[32], const uint8_t ram_sha256[32],
+    const uint8_t device_sha256[32], uint64_t ram_bytes,
+    uint64_t device_bytes, uint8_t digest[32])
+{
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    uint8_t lengths[16];
+    gsize digest_len = 32;
+
+    test_put_u64(lengths, ram_bytes);
+    test_put_u64(lengths + 8, device_bytes);
+    g_checksum_update(
+        checksum, (const uint8_t *)"crucible.instruction-state.v1\0",
+        strlen("crucible.instruction-state.v1") + 1);
+    g_checksum_update(checksum, cpu_sha256, 32);
+    g_checksum_update(checksum, ram_sha256, 32);
+    g_checksum_update(checksum, device_sha256, 32);
+    g_checksum_update(checksum, lengths, sizeof(lengths));
+    g_checksum_get_digest(checksum, digest, &digest_len);
+    if (digest_len != 32) {
+        test_fail("instruction-state SHA-256 framing failed");
+    }
+}
+
+static bool test_port_io_evidence(const uint8_t *evidence, size_t length)
+{
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    uint8_t digest[32];
+    gsize digest_len = sizeof(digest);
+    uint32_t count;
+    uint32_t value_bytes = 0;
+
+    if (length < 56 || memcmp(evidence, "CRUCIOP1", 8) != 0 ||
+        test_get_u16(evidence + 8) != 1 ||
+        test_get_u16(evidence + 10) != 24 ||
+        !test_bytes_equal(evidence + 20, 4, 0)) {
+        return false;
+    }
+    count = test_get_u32(evidence + 12);
+    if (count == 0 || count > 8 || length != 56 + count * 24) {
+        return false;
+    }
+    g_checksum_update(
+        checksum, (const uint8_t *)"crucible.port-io.v1\0",
+        strlen("crucible.port-io.v1") + 1);
+    g_checksum_update(checksum, evidence + 56, count * 24);
+    g_checksum_get_digest(checksum, digest, &digest_len);
+    if (digest_len != sizeof(digest) ||
+        memcmp(digest, evidence + 24, sizeof(digest)) != 0) {
+        return false;
+    }
+    for (uint32_t index = 0; index < count; index++) {
+        const uint8_t *entry = evidence + 56 + index * 24;
+        uint8_t size = entry[1];
+
+        if (entry[0] > 1 || (size != 1 && size != 2 && size != 4) ||
+            entry[2] != 1 || entry[3] != 0 ||
+            !test_bytes_equal(entry + 8 + size, 16 - size, 0)) {
+            return false;
+        }
+        value_bytes += size;
+    }
+    return value_bytes == test_get_u32(evidence + 16);
+}
