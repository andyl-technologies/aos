+static int crucible_instruction_rule_compare(gconstpointer left,
+                                             gconstpointer right)
+{
+    const QemuCrucibleFaultRule *a = *(const void * const *)left;
+    const QemuCrucibleFaultRule *b = *(const void * const *)right;
+    int order;
+
+    order = memcmp(qemu_crucible_fault_rule_binding_hash(a),
+                   qemu_crucible_fault_rule_binding_hash(b), 32);
+    if (order != 0) {
+        return order;
+    }
+    order = memcmp(qemu_crucible_fault_rule_action_hash(a),
+                   qemu_crucible_fault_rule_action_hash(b), 32);
+    if (order != 0) {
+        return order;
+    }
+    if (qemu_crucible_fault_rule_command_sequence(a) !=
+        qemu_crucible_fault_rule_command_sequence(b)) {
+        return qemu_crucible_fault_rule_command_sequence(a) <
+                       qemu_crucible_fault_rule_command_sequence(b) ? -1 : 1;
+    }
+    return 0;
+}
+
+static bool crucible_instruction_fail_closed(
+    CPUState *cpu, CrucibleInstructionContext *context)
+{
+    if (crucible_instruction_event_terminal_latched) {
+        crucible_instruction_context_clear(context);
+        cpu_exit(cpu);
+        return true;
+    }
+    if (context->contributors) {
+        for (guint i = 0; i < context->contributors->len; i++) {
+            CrucibleInstructionContributor *contributor =
+                g_ptr_array_index(context->contributors, i);
+
+            if (!contributor->terminalized &&
+                qemu_crucible_fault_rule_operation(contributor->rule) ==
+                CRUCIBLE_NODE_FAULT_OPERATION_APPLY) {
+                crucible_instruction_impulse_fail(
+                    contributor->rule,
+                    context->command_before_state.state_sha256);
+            }
+        }
+    } else if (context->rule &&
+        qemu_crucible_fault_rule_operation(context->rule) ==
+            CRUCIBLE_NODE_FAULT_OPERATION_APPLY) {
+        crucible_instruction_impulse_fail(
+            context->rule, context->command_before_state.state_sha256);
+    }
+    if (context->exception_rule) {
+        qemu_crucible_fault_fail_deferred(
+            context->exception_rule, context->exception_command_icount,
+            context->exception_before_hash);
+    }
+    if (context->exception_event_reservation) {
+        qemu_crucible_fault_event_reservation_release(
+            context->exception_event_reservation);
+        context->exception_event_reservation = NULL;
+    }
+    qemu_crucible_fault_rule_unref(context->exception_rule);
+    context->exception_rule = NULL;
+    context->exception_pending = false;
+    context->exception_in_flight = false;
+    crucible_instruction_context_clear(context);
+    qemu_system_vmstop_request_prepare();
+    qemu_system_vmstop_request(RUN_STATE_INTERNAL_ERROR);
+    cpu_exit(cpu);
+    return true;
+}
