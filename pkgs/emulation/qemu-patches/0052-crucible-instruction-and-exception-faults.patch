+static CrucibleInstructionContext *
+crucible_instruction_context(CPUState *cpu, bool create)
+{
+    CrucibleInstructionContext *context;
+
+    if (!crucible_instruction_contexts) {
+        if (!create) {
+            return NULL;
+        }
+        crucible_instruction_contexts = g_hash_table_new_full(
+            g_direct_hash, g_direct_equal, NULL, g_free);
+    }
+    context = g_hash_table_lookup(crucible_instruction_contexts, cpu);
+    if (!context && create) {
+        context = g_new0(CrucibleInstructionContext, 1);
+        g_hash_table_insert(crucible_instruction_contexts, cpu, context);
+    }
+    return context;
+}
