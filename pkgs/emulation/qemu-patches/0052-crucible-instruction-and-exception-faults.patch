+static void test_exit(qemu_plugin_id_t id, void *opaque)
+{
+    (void)id;
+    (void)opaque;
+    if (!test_finished) {
+        if (test_saturation_mode()) {
+            test_poll_events();
+            test_finish();
+        }
+    }
+    if (!test_finished) {
+        g_printerr("unfinished instruction state commit=%u installed=%u "
+                   "event=%u guest=%u replay_events=%u translations=%u "
+                   "translations_after_install=%u "
+                   "tb_pc=%" G_GUINT64_FORMAT " tb_index=%zu "
+                   "tb_instructions=%zu "
+                   "translated_len=%zu bytes_equal=%u "
+                   "guest_state_read=%u selected=%u "
+                   "iterations=%u\n",
+                   test_commit_submitted, test_rule_installed,
+                   test_event_validated, test_guest_validated,
+                   test_replay_events, test_target_translations,
+                   test_target_translations_after_install,
+                   test_target_tb_pc, test_target_tb_index,
+                   test_target_tb_instructions,
+                   test_translated_instruction_len,
+                   test_translated_instruction_len == test_instruction_len &&
+                   memcmp(test_translated_instruction,
+                          test_instruction_bytes,
+                          test_instruction_len) == 0,
+                   test_last_guest_state_read, test_last_selected,
+                   test_last_iterations);
+        test_fail("instruction scenario did not finish");
+    }
+    g_free(test_instruction_bytes);
+    g_free(test_payload);
+    g_free(test_payload2);
+    g_free(test_input_state_json);
+}
