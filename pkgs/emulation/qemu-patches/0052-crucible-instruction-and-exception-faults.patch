  *
@@ -73,6 +74,7 @@ struct DisasContextBase {
     int max_insns;
     bool plugin_enabled;
     bool fake_insn;
+    bool crucible_fault_boundary_exit;
     struct TCGOp *insn_start;
     void *host_addr[2];
 
