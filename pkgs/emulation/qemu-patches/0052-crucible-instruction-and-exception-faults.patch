+static void test_validate_rule_evidence(
+    const struct qemu_plugin_crucible_fault_result *result,
+    const uint8_t *evidence, size_t evidence_len,
+    const uint8_t *payload, size_t payload_len, uint16_t operation)
+{
+    uint8_t digest[32];
+
+    if (evidence_len != CRUCIBLE_NODE_FAULT_EVIDENCE_V1_BYTES ||
+        memcmp(evidence + CRUCIBLE_NODE_FAULT_EVIDENCE_MAGIC_OFFSET,
+               "CRUCNEV1", 8) != 0 ||
+        test_get_u16(evidence +
+                     CRUCIBLE_NODE_FAULT_EVIDENCE_VERSION_OFFSET) !=
+            CRUCIBLE_NODE_FAULT_PAYLOAD_VERSION_V1 ||
+        test_get_u16(evidence +
+                     CRUCIBLE_NODE_FAULT_EVIDENCE_COMMAND_KIND_OFFSET) !=
+            test_command.command_kind ||
+        test_get_u16(evidence +
+                     CRUCIBLE_NODE_FAULT_EVIDENCE_OPERATION_OFFSET) !=
+            operation ||
+        test_get_u16(evidence +
+                     CRUCIBLE_NODE_FAULT_EVIDENCE_TARGET_KIND_OFFSET) !=
+            CRUCIBLE_NODE_FAULT_TARGET_VCPU ||
+        test_get_u16(evidence +
+                     CRUCIBLE_NODE_FAULT_EVIDENCE_MODEL_PHASE_OFFSET) !=
+            test_model_phase ||
+        test_get_u64(evidence +
+                     CRUCIBLE_NODE_FAULT_EVIDENCE_GENERATION_OFFSET) != 1) {
+        g_printerr("rule evidence status=%u len=%zu magic=%.8s "
+                   "version=%u kind=%u "
+                   "operation=%u target=%u phase=%u generation=%"
+                   G_GUINT64_FORMAT "\n", result->status, evidence_len,
+                   evidence,
+                   test_get_u16(evidence +
+                       CRUCIBLE_NODE_FAULT_EVIDENCE_VERSION_OFFSET),
+                   test_get_u16(evidence +
+                       CRUCIBLE_NODE_FAULT_EVIDENCE_COMMAND_KIND_OFFSET),
+                   test_get_u16(evidence +
+                       CRUCIBLE_NODE_FAULT_EVIDENCE_OPERATION_OFFSET),
+                   test_get_u16(evidence +
+                       CRUCIBLE_NODE_FAULT_EVIDENCE_TARGET_KIND_OFFSET),
+                   test_get_u16(evidence +
+                       CRUCIBLE_NODE_FAULT_EVIDENCE_MODEL_PHASE_OFFSET),
+                   test_get_u64(evidence +
+                       CRUCIBLE_NODE_FAULT_EVIDENCE_GENERATION_OFFSET));
+        test_fail("rule evidence fields are invalid");
+    }
+    test_sha256(payload, payload_len, digest);
+    if (memcmp(evidence + CRUCIBLE_NODE_FAULT_EVIDENCE_REQUEST_SHA256_OFFSET,
+               digest, 32) != 0) {
+        test_fail("rule evidence request digest is invalid");
+    }
+    test_sha256(evidence, evidence_len, digest);
+    if (memcmp(result->evidence_hash, digest, 32) != 0) {
+        test_fail("rule result evidence digest is invalid");
+    }
+}
