+QEMU_PLUGIN_EXPORT int qemu_plugin_install(qemu_plugin_id_t id,
+                                           const qemu_info_t *info,
+                                           int argc, char **argv)
+{
+    struct qemu_plugin_crucible_fault_register_capability *rows;
+    const char *cpu_model;
+    uint16_t observed_architecture;
+    uint8_t instruction_manifest_sha256[32];
+    size_t instruction_manifest_len;
+    size_t row_count;
+
+    (void)info;
+    if ((argc != 8 && argc != 9) ||
+        !g_str_has_prefix(argv[0], "architecture=") ||
+        !g_str_has_prefix(argv[1], "mode=") ||
+        !g_str_has_prefix(argv[2], "pc=") ||
+        !g_str_has_prefix(argv[3], "bytes=") ||
+        !g_str_has_prefix(argv[4], "register=") ||
+        !g_str_has_prefix(argv[5], "selected-address=") ||
+        !g_str_has_prefix(argv[6], "iterations-address=") ||
+        !g_str_has_prefix(argv[7], "exception-address=") ||
+        (argc == 9 && !g_str_has_prefix(argv[8], "input-state="))) {
+        test_fail("instruction test arguments are invalid");
+    }
+    test_architecture = g_ascii_strtoull(argv[0] + 13, NULL, 10);
+    test_mode = test_parse_mode(argv[1] + 5);
+    test_pc = g_ascii_strtoull(argv[2] + 3, NULL, 0);
+    test_instruction_bytes = test_decode_hex(
+        argv[3] + 6, &test_instruction_len);
+    test_selected_address = g_ascii_strtoull(argv[5] + 17, NULL, 0);
+    test_iterations_address = g_ascii_strtoull(argv[6] + 19, NULL, 0);
+    test_exception_address = g_ascii_strtoull(argv[7] + 18, NULL, 0);
+    if (argc == 9) {
+        size_t input_state_len;
+        g_autofree uint8_t *input_state =
+            test_decode_hex(argv[8] + 12, &input_state_len);
+
+        if (input_state_len != 32 ||
+            !test_input_bound_mode()) {
+            test_fail("input-state argument is invalid for this mode");
+        }
+        test_input_state_json =
+            g_strdup_printf("\"%s\"", argv[8] + 12);
+    } else if (test_input_bound_mode()) {
+        test_fail("input-bound result mode requires an input-state digest");
+    }
+    test_model_phase = test_result_mode() ||
+                       test_mode == TEST_EXCEPTION_AFTER ?
+        TEST_MODEL_PHASE_AFTER_INSTRUCTION :
+        TEST_MODEL_PHASE_BEFORE_INSTRUCTION;
+    if (qemu_plugin_crucible_fault_capabilities(NULL, 0) < 6) {
+        test_fail("instruction capabilities are unavailable");
+    }
+    instruction_manifest_len =
+        qemu_plugin_crucible_fault_instruction_manifest(
+            NULL, 0, instruction_manifest_sha256, &observed_architecture);
+    if (instruction_manifest_len == 0 || instruction_manifest_len > 16384 ||
+        observed_architecture != test_architecture ||
+        !memcmp(instruction_manifest_sha256, (uint8_t[32]) { 0 }, 32)) {
+        test_fail("instruction manifest is unavailable");
+    }
+    memcpy(test_instruction_manifest_sha256,
+           instruction_manifest_sha256, 32);
+    row_count = qemu_plugin_crucible_fault_register_manifest(
+        NULL, 0, &observed_architecture, &cpu_model);
+    if (row_count == 0 || row_count > 4096 ||
+        observed_architecture != test_architecture || !cpu_model) {
+        test_fail("register manifest is unavailable");
+    }
+    rows = g_new0(struct qemu_plugin_crucible_fault_register_capability,
+                  row_count);
+    if (qemu_plugin_crucible_fault_register_manifest(
+            rows, row_count, &observed_architecture, &cpu_model) != row_count) {
+        test_fail("register manifest changed");
+    }
+    uint8_t architecture_identity[32];
+
+    test_identity(architecture_identity, 0xb1, test_architecture);
+    if (qemu_plugin_crucible_fault_register_bind_architecture(
+            architecture_identity) != 0) {
+        test_fail("architecture binding failed");
+    }
+    for (size_t i = 0; i < row_count; i++) {
+        uint8_t identity[32];
+
+        test_identity(identity, 0xb2, rows[i].numeric_id);
+        if (qemu_plugin_crucible_fault_register_bind(
+                identity, rows[i].numeric_id) != 0) {
+            test_fail("register binding failed");
+        }
+        if (strcmp(rows[i].name, argv[4] + 9) == 0) {
+            test_register_id = rows[i].numeric_id;
+            test_register_bytes = (rows[i].width_bits + 7) / 8;
+            memcpy(test_register_identity, identity, 32);
+        }
+    }
+    g_free(rows);
+    if (test_register_id == 0 || test_register_bytes == 0 ||
+        qemu_plugin_crucible_fault_register_bindings_seal() != 0) {
+        test_fail("selected register binding failed");
+    }
+    if (test_mode == TEST_REJECT_DESTINATION) {
+        test_identity(test_register_identity, 0xb2,
+                      test_architecture == 2 ? 2 : 2);
+    }
+    test_payload = test_exception() ?
+        test_build_exception_payload(&test_payload_len) :
+        test_build_instruction_payload(
+            &test_payload_len, false, false,
+            test_control_plane_mode() ?
+                CRUCIBLE_NODE_FAULT_OPERATION_UPSERT :
+                (test_saturation_mode() ?
+                    CRUCIBLE_NODE_FAULT_OPERATION_UPSERT :
+                    CRUCIBLE_NODE_FAULT_OPERATION_APPLY),
+            (test_control_plane_mode() || test_saturation_mode()) ?
+                UINT64_C(0x100000000) : 1);
+    if (test_compose_mode()) {
+        test_payload2 = test_build_instruction_payload(
+            &test_payload2_len, true, false,
+            CRUCIBLE_NODE_FAULT_OPERATION_APPLY, 1);
+    } else if (test_control_plane_mode()) {
+        test_payload2 = test_build_instruction_payload(
+            &test_payload2_len, false,
+            test_mode == TEST_EXCLUSIVE_SELECTORS,
+            test_mode == TEST_EXCLUSIVE_SELECTORS ?
+                CRUCIBLE_NODE_FAULT_OPERATION_UPSERT :
+                CRUCIBLE_NODE_FAULT_OPERATION_APPLY,
+            UINT64_C(0x100000000));
+    }
+    memset(&test_command, 0, sizeof(test_command));
+    test_command.abi_major = CRUCIBLE_FAULT_COMMAND_ABI_MAJOR;
+    test_command.abi_minor = CRUCIBLE_FAULT_COMMAND_ABI_MINOR;
+    test_command.command_kind = test_exception() ?
+        CRUCIBLE_FAULT_COMMAND_CPU_EXCEPTION :
+        CRUCIBLE_FAULT_COMMAND_CPU_INSTRUCTION_TRANSFORM;
+    test_command.command_flags = CRUCIBLE_FAULT_COMMAND_FLAG_PREPARE_ONLY;
+    test_command.phase = CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY;
+    test_command.semantic_version = CRUCIBLE_FAULT_COMMAND_SEMANTIC_VERSION;
+    test_command.command_sequence = 1;
+    memset(test_command.target_node_hash, 0x11, 32);
+    memset(test_command.binding_hash, 0x21, 32);
+    if (test_compose_mode() || test_control_plane_mode()) {
+        test_command2 = test_command;
+        test_command2.command_sequence = 2;
+        memset(test_command2.binding_hash, 0x20, 32);
+    }
+    test_command.target_icount = 64;
+    test_command.authorization_ceiling_icount = 64;
+    qemu_plugin_register_crucible_fault_completion_cb(test_completion, NULL);
+    qemu_plugin_register_tcg_exec_cb(test_exec, NULL);
+    qemu_plugin_register_vcpu_tb_trans_cb(id, test_tb_trans);
+    qemu_plugin_register_atexit_cb(id, test_exit, NULL);
+    if (!test_exception()) {
+        if (qemu_plugin_crucible_fault_submit(
+                &test_command, test_payload, test_payload_len) != 0) {
+            test_fail("fault preparation submission failed");
+        }
+        test_prepare_submitted = true;
+    }
+    return 0;
+}
