+static bool crucible_instruction_metadata(
+    CPUState *cpu, TranslationBlock *tb, uint64_t pc,
+    CrucibleInstructionMetadata *metadata)
+{
+    CPUClass *cc = CPU_GET_CLASS(cpu);
+    g_autofree uint8_t *page = NULL;
+
+    memset(metadata, 0, sizeof(*metadata));
+    if (!tb || tb->icount != 1 || tb->size == 0 ||
+        tb->size > CRUCIBLE_INSTRUCTION_MAX_BYTES ||
+        tb->page_addr[0] == (tb_page_addr_t)-1 ||
+        cpu_memory_rw_debug(cpu, pc, metadata->bytes,
+                            tb->size, false) != 0) {
+        return false;
+    }
+    metadata->architecture = cc->crucible_register_scope;
+    metadata->vcpu = cpu->cpu_index;
+    metadata->pc = pc;
+    metadata->physical_address = tb->page_addr[0] +
+        (pc & CRUCIBLE_INSTRUCTION_TARGET_PAGE_OFFSET_MASK);
+    metadata->tb_flags = tb->flags;
+    metadata->tb_cflags = tb->cflags;
+    metadata->length = tb->size;
+    page = g_try_malloc(CRUCIBLE_INSTRUCTION_TARGET_PAGE_BYTES);
+    if (!page) {
+        return false;
+    }
+    for (uint32_t index = 0; index < ARRAY_SIZE(metadata->code_page);
+         index++) {
+        if (tb->page_addr[index] == (tb_page_addr_t)-1) {
+            break;
+        }
+        metadata->code_page[index] = tb->page_addr[index];
+        cpu_physical_memory_read(
+            metadata->code_page[index], page,
+            CRUCIBLE_INSTRUCTION_TARGET_PAGE_BYTES);
+        crucible_instruction_sha256(
+            page, CRUCIBLE_INSTRUCTION_TARGET_PAGE_BYTES,
+            metadata->code_page_sha256[index]);
+        metadata->code_page_count++;
+    }
+    if (metadata->code_page_count == 0) {
+        return false;
+    }
+    if (metadata->architecture == CRUCIBLE_INSTRUCTION_SCOPE_X86_64) {
+        metadata->opcode_class = crucible_instruction_x86_classify(metadata);
+    } else if (metadata->architecture ==
+               CRUCIBLE_INSTRUCTION_SCOPE_AARCH64) {
+        metadata->opcode_class =
+            crucible_instruction_aarch64_classify(metadata);
+    }
+    return metadata->architecture == CRUCIBLE_INSTRUCTION_SCOPE_X86_64 ||
+           metadata->architecture == CRUCIBLE_INSTRUCTION_SCOPE_AARCH64;
+}
+
+static bool crucible_instruction_matches(
+    const CrucibleInstructionSelector *selector,
+    const CrucibleInstructionMetadata *metadata)
+{
+    uint64_t end = selector->pc_start + selector->pc_length;
+
+    return metadata->pc >= selector->pc_start && metadata->pc < end &&
+           (!selector->has_bytes ||
+            (selector->bytes_len == metadata->length &&
+             memcmp(selector->bytes, metadata->bytes,
+                    metadata->length) == 0)) &&
+           (!selector->has_opcode_class ||
+            selector->opcode_class == metadata->opcode_class);
+}
+
+static bool crucible_instruction_has_destination(
+    const CrucibleInstructionMetadata *metadata, uint32_t numeric_id)
+{
+    for (uint32_t i = 0; i < metadata->destination_count; i++) {
+        if (metadata->destinations[i] == numeric_id) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static bool crucible_instruction_class_supported(uint16_t architecture,
+                                                 uint32_t opcode_class)
+{
+    if (architecture == CRUCIBLE_INSTRUCTION_SCOPE_X86_64) {
+        return opcode_class >= CRUCIBLE_INSTRUCTION_CLASS_X86_INTEGER &&
+               opcode_class <= CRUCIBLE_INSTRUCTION_CLASS_X86_DEVICE_IO;
+    }
+    if (architecture == CRUCIBLE_INSTRUCTION_SCOPE_AARCH64) {
+        return opcode_class >= CRUCIBLE_INSTRUCTION_CLASS_A64_INTEGER &&
+               opcode_class <= CRUCIBLE_INSTRUCTION_CLASS_A64_EXCEPTION;
+    }
+    return false;
+}
+
+static bool crucible_instruction_mutation_supported(uint32_t opcode_class,
+                                                    uint32_t mutation_kind)
+{
+    switch (opcode_class) {
+    case CRUCIBLE_INSTRUCTION_CLASS_X86_INTEGER:
+    case CRUCIBLE_INSTRUCTION_CLASS_X86_LOAD:
+    case CRUCIBLE_INSTRUCTION_CLASS_X86_FP_SIMD:
+    case CRUCIBLE_INSTRUCTION_CLASS_A64_INTEGER:
+    case CRUCIBLE_INSTRUCTION_CLASS_A64_LOAD:
+    case CRUCIBLE_INSTRUCTION_CLASS_A64_FP_SIMD:
+        return mutation_kind >= 1 && mutation_kind <= 3;
+    case CRUCIBLE_INSTRUCTION_CLASS_X86_CONTROL_FLOW:
+    case CRUCIBLE_INSTRUCTION_CLASS_X86_EXCEPTION:
+    case CRUCIBLE_INSTRUCTION_CLASS_A64_CONTROL_FLOW:
+    case CRUCIBLE_INSTRUCTION_CLASS_A64_EXCEPTION:
+        return mutation_kind == 2;
+    case CRUCIBLE_INSTRUCTION_CLASS_X86_STORE:
+    case CRUCIBLE_INSTRUCTION_CLASS_A64_STORE:
+        return mutation_kind == 2 || mutation_kind == 3;
+    case CRUCIBLE_INSTRUCTION_CLASS_X86_ATOMIC:
+    case CRUCIBLE_INSTRUCTION_CLASS_A64_ATOMIC:
+    case CRUCIBLE_INSTRUCTION_CLASS_X86_DEVICE_IO:
+        return mutation_kind == 3;
+    default:
+        return false;
+    }
+}
+
+static void crucible_instruction_match_visit(
+    const QemuCrucibleFaultRule *rule_const, void *opaque)
+{
+    QemuCrucibleFaultRule *rule = (QemuCrucibleFaultRule *)rule_const;
+    CrucibleInstructionMatch *match = opaque;
+    CrucibleInstructionSelector selector;
+    uint32_t target_vcpu;
+    uint32_t mutation_kind;
+    uint32_t replay_count;
+
+    if (!crucible_instruction_rule_u32(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_T1, &target_vcpu) ||
+        target_vcpu != match->cpu->cpu_index ||
+        !crucible_instruction_rule_u32(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_P2, &mutation_kind) ||
+        !crucible_instruction_rule_u32(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_P5, &replay_count) ||
+        !crucible_instruction_selector(rule, &selector) ||
+        !crucible_instruction_matches(&selector, match->metadata)) {
+        return;
+    }
+    match->matches++;
+    g_ptr_array_add(match->rules, rule);
+    match->rule = rule;
+    match->mutation_kind = mutation_kind;
+    match->replay_count = replay_count;
+}
+
+static void crucible_instruction_index_visit(
+    const QemuCrucibleFaultRule *rule_const, void *opaque)
+{
+    GArray *index = opaque;
+    CrucibleInstructionSelector selector;
+    CrucibleInstructionIndexEntry entry = { 0 };
+
+    if (!crucible_instruction_selector(rule_const, &selector) ||
+        !crucible_instruction_rule_u32(
+            rule_const, CRUCIBLE_NODE_FAULT_FIELD_T1, &entry.vcpu)) {
+        error_report("Crucible admitted instruction rule became invalid");
+        abort();
+    }
+    entry.interval.start = selector.pc_start;
+    entry.interval.last = selector.pc_start + selector.pc_length - 1;
+    entry.rule = (QemuCrucibleFaultRule *)rule_const;
+    g_array_append_val(index, entry);
+}
+
+static void crucible_instruction_index_rebuild(bool flush)
+{
+    CPUState *flush_cpu;
+
+    memset(&crucible_instruction_root, 0, sizeof(crucible_instruction_root));
+    g_clear_pointer(&crucible_instruction_index, g_array_unref);
+    crucible_instruction_index = g_array_new(
+        false, false, sizeof(CrucibleInstructionIndexEntry));
+    qemu_crucible_fault_rule_foreach(
+        CRUCIBLE_FAULT_COMMAND_CPU_INSTRUCTION_TRANSFORM,
+        crucible_instruction_index_visit, crucible_instruction_index);
+    for (guint i = 0; crucible_instruction_impulses &&
+                        i < crucible_instruction_impulses->len; i++) {
+        CrucibleInstructionImpulse *impulse =
+            g_ptr_array_index(crucible_instruction_impulses, i);
+
+        crucible_instruction_index_visit(
+            impulse->rule, crucible_instruction_index);
+    }
+    for (guint i = 0; i < crucible_instruction_index->len; i++) {
+        CrucibleInstructionIndexEntry *entry = &g_array_index(
+            crucible_instruction_index, CrucibleInstructionIndexEntry, i);
+
+        interval_tree_insert(&entry->interval, &crucible_instruction_root);
+    }
+    flush_cpu = flush ? (current_cpu ? current_cpu : qemu_get_cpu(0)) : NULL;
+    if (flush_cpu != NULL) {
+        tb_flush(flush_cpu);
+        cpu_exit(flush_cpu);
+    }
+}
+
+void qemu_crucible_fault_instruction_rules_changed(void)
+{
+    crucible_instruction_index_rebuild(true);
+}
+
+static void crucible_instruction_impulse_remove(
+    QemuCrucibleFaultRule *rule)
+{
+    for (guint i = 0; crucible_instruction_impulses &&
+                        i < crucible_instruction_impulses->len; i++) {
+        CrucibleInstructionImpulse *impulse =
+            g_ptr_array_index(crucible_instruction_impulses, i);
+
+        if (impulse->rule == rule) {
+            g_ptr_array_remove_index(crucible_instruction_impulses, i);
+            crucible_instruction_index_rebuild(false);
+            return;
+        }
+    }
+    error_report("Crucible instruction impulse rule was not active");
+    abort();
+}
+
+static uint64_t crucible_instruction_impulse_command_icount(
+    QemuCrucibleFaultRule *rule)
+{
+    for (guint i = 0; crucible_instruction_impulses &&
+                        i < crucible_instruction_impulses->len; i++) {
+        CrucibleInstructionImpulse *impulse =
+            g_ptr_array_index(crucible_instruction_impulses, i);
+
+        if (impulse->rule == rule) {
+            return impulse->command_icount;
+        }
+    }
+    error_report("Crucible instruction impulse coordinate was lost");
+    abort();
+}
+
+static void crucible_instruction_impulse_complete(
+    QemuCrucibleFaultRule *rule, uint64_t observed_icount,
+    const uint8_t before_hash[32], const uint8_t after_hash[32])
+{
+    uint64_t command_icount;
+
+    if (crucible_instruction_event_terminal_latched) {
+        return;
+    }
+    if (qemu_crucible_fault_rule_operation(rule) !=
+        CRUCIBLE_NODE_FAULT_OPERATION_APPLY) {
+        return;
+    }
+    command_icount = crucible_instruction_impulse_command_icount(rule);
+    qemu_crucible_fault_rule_ref(rule);
+    crucible_instruction_impulse_remove(rule);
+    qemu_crucible_fault_complete_deferred(
+        rule, command_icount, observed_icount, before_hash, after_hash);
+    qemu_crucible_fault_rule_unref(rule);
+}
+
+static void crucible_instruction_impulse_fail(
+    QemuCrucibleFaultRule *rule, const uint8_t before_hash[32])
+{
+    if (crucible_instruction_event_terminal_latched) {
+        return;
+    }
+    uint64_t command_icount =
+        crucible_instruction_impulse_command_icount(rule);
+
+    qemu_crucible_fault_rule_ref(rule);
+    crucible_instruction_impulse_remove(rule);
+    qemu_crucible_fault_fail_deferred(
+        rule, command_icount, before_hash);
+    qemu_crucible_fault_rule_unref(rule);
+}
+
+static void crucible_instruction_index_match(
+    CrucibleInstructionMatch *match)
+{
+    IntervalTreeNode *node;
+    uint64_t pc = match->metadata->pc;
+
+    for (node = interval_tree_iter_first(&crucible_instruction_root, pc, pc);
+         node;
+         node = interval_tree_iter_next(node, pc, pc)) {
+        CrucibleInstructionIndexEntry *entry = container_of(
+            node, CrucibleInstructionIndexEntry, interval);
+
+        if (entry->vcpu == match->cpu->cpu_index) {
+            crucible_instruction_match_visit(entry->rule, match);
+        }
+    }
+}
+
+static bool crucible_instruction_index_contains(uint32_t vcpu, uint64_t pc)
+{
+    IntervalTreeNode *node;
+
+    for (node = interval_tree_iter_first(&crucible_instruction_root, pc, pc);
+         node;
+         node = interval_tree_iter_next(node, pc, pc)) {
+        CrucibleInstructionIndexEntry *entry = container_of(
+            node, CrucibleInstructionIndexEntry, interval);
+
+        if (entry->vcpu == vcpu) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static bool crucible_instruction_index_conflicts(
+    const QemuCrucibleFaultRule *rule,
+    const CrucibleInstructionSelector *selector, uint32_t vcpu,
+    uint32_t mutation_kind)
+{
+    IntervalTreeNode *node;
+    uint64_t last = selector->pc_start + selector->pc_length - 1;
+
+    if (qemu_crucible_fault_rule_operation(rule) ==
+            CRUCIBLE_NODE_FAULT_OPERATION_REMOVE ||
+        !crucible_instruction_index) {
+        return false;
+    }
+    for (node = interval_tree_iter_first(
+             &crucible_instruction_root, selector->pc_start, last);
+         node;
+         node = interval_tree_iter_next(
+             node, selector->pc_start, last)) {
+        CrucibleInstructionIndexEntry *entry = container_of(
+            node, CrucibleInstructionIndexEntry, interval);
+
+        if (entry->vcpu == vcpu) {
+            CrucibleInstructionSelector other_selector;
+            CrucibleInstructionMetadata metadata = { 0 };
+            uint32_t other_mutation_kind;
+            bool replacement =
+                qemu_crucible_fault_rule_operation(rule) ==
+                    CRUCIBLE_NODE_FAULT_OPERATION_UPSERT &&
+                qemu_crucible_fault_rule_operation(entry->rule) ==
+                    CRUCIBLE_NODE_FAULT_OPERATION_UPSERT &&
+                memcmp(qemu_crucible_fault_rule_binding_hash(entry->rule),
+                       qemu_crucible_fault_rule_binding_hash(rule), 32) == 0;
+
+            bool exclusive = false;
+
+            if (!crucible_instruction_selector(
+                    entry->rule, &other_selector) ||
+                !crucible_instruction_rule_u32(
+                    entry->rule, CRUCIBLE_NODE_FAULT_FIELD_P2,
+                    &other_mutation_kind)) {
+                return true;
+            }
+            if (selector->has_bytes && other_selector.has_bytes &&
+                (selector->bytes_len != other_selector.bytes_len ||
+                 memcmp(selector->bytes, other_selector.bytes,
+                        selector->bytes_len) != 0)) {
+                exclusive = true;
+            } else if (selector->has_opcode_class &&
+                       other_selector.has_opcode_class &&
+                       selector->opcode_class !=
+                           other_selector.opcode_class) {
+                exclusive = true;
+            } else if (selector->has_bytes != other_selector.has_bytes) {
+                const CrucibleInstructionSelector *byte_selector =
+                    selector->has_bytes ? selector : &other_selector;
+                const CrucibleInstructionSelector *class_selector =
+                    selector->has_bytes ? &other_selector : selector;
+
+                if (class_selector->has_opcode_class) {
+                    metadata.architecture =
+                        CPU_GET_CLASS(qemu_get_cpu(vcpu))->
+                            crucible_register_scope;
+                    metadata.length = byte_selector->bytes_len;
+                    memcpy(metadata.bytes, byte_selector->bytes,
+                           byte_selector->bytes_len);
+                    metadata.opcode_class = metadata.architecture ==
+                            CRUCIBLE_INSTRUCTION_SCOPE_X86_64 ?
+                        crucible_instruction_x86_classify(&metadata) :
+                        crucible_instruction_aarch64_classify(&metadata);
+                    exclusive = metadata.opcode_class != 0 &&
+                        metadata.opcode_class !=
+                            class_selector->opcode_class;
+                }
+            }
+            if (!replacement && !exclusive &&
+                !(mutation_kind == 1 && other_mutation_kind == 1)) {
+                return true;
+            }
+        }
+    }
+    return false;
+}
+
+static void crucible_instruction_evidence(
+    const CrucibleInstructionMetadata *metadata, uint32_t mutation_kind,
+    uint32_t replay_ordinal, uint32_t replay_total,
+    uint64_t observed_icount,
+    const CrucibleInstructionState *before,
+    const CrucibleInstructionState *after, const uint8_t *detail,
+    size_t detail_len, GByteArray *evidence)
+{
+    uint8_t header[CRUCIBLE_INSTRUCTION_EVIDENCE_HEADER_BYTES] = { 0 };
+    uint8_t bytes_hash[32];
+    uint8_t manifest_hash[32];
+
+    crucible_instruction_sha256(
+        metadata->bytes, metadata->length, bytes_hash);
+    crucible_instruction_sha256(
+        (const uint8_t *)crucible_instruction_manifest_v1,
+        strlen(crucible_instruction_manifest_v1), manifest_hash);
+    memcpy(header, "CRUCINS1", 8);
+    stw_le_p(header + 8, 3);
+    stw_le_p(header + 10, metadata->architecture);
+    stl_le_p(header + 12, mutation_kind);
+    stl_le_p(header + 16, replay_ordinal);
+    stl_le_p(header + 20, replay_total);
+    stl_le_p(header + 24, metadata->opcode_class);
+    stl_le_p(header + 28, metadata->flags);
+    stq_le_p(header + 32, metadata->pc);
+    stq_le_p(header + 40, metadata->physical_address);
+    stq_le_p(header + 48, observed_icount);
+    stl_le_p(header + 56, metadata->length);
+    stl_le_p(header + 60, detail_len);
+    memcpy(header + 64, bytes_hash, 32);
+    memcpy(header + 96, before->state_sha256, 32);
+    memcpy(header + 128, after->state_sha256, 32);
+    stl_le_p(header + 160, metadata->vcpu);
+    stl_le_p(header + 164, metadata->destination_count);
+    for (uint32_t i = 0; i < metadata->destination_count; i++) {
+        stl_le_p(header + 168 + i * 4, metadata->destinations[i]);
+    }
+    stl_le_p(header + 184, metadata->tb_flags);
+    stl_le_p(header + 188, metadata->tb_cflags);
+    memcpy(header + 192, manifest_hash, 32);
+    memcpy(header + 224, metadata->code_page_sha256[0], 32);
+    memcpy(header + 256, metadata->code_page_sha256[1], 32);
+    memcpy(header + 288, before->ram_sha256, 32);
+    memcpy(header + 320, after->ram_sha256, 32);
+    memcpy(header + 352, before->device_sha256, 32);
+    memcpy(header + 384, after->device_sha256, 32);
+    memcpy(header + 416, before->cpu_sha256, 32);
+    memcpy(header + 448, after->cpu_sha256, 32);
+    stq_le_p(header + 480, before->ram_bytes);
+    stq_le_p(header + 488, after->ram_bytes);
+    stq_le_p(header + 496, before->device_bytes);
+    stq_le_p(header + 504, after->device_bytes);
+    stq_le_p(header + 512, metadata->code_page[0]);
+    stq_le_p(header + 520, metadata->code_page[1]);
+    stl_le_p(header + 528, metadata->code_page_count);
+    stl_le_p(header + 532, metadata->has_input_state_sha256);
+    memcpy(header + 536, metadata->input_state_sha256, 32);
+    memcpy(header + 568, metadata->matched_input_state_sha256, 32);
+    g_byte_array_append(evidence, header, sizeof(header));
+    g_byte_array_append(evidence, metadata->bytes, metadata->length);
+    if (detail_len != 0) {
+        g_byte_array_append(evidence, detail, detail_len);
+    }
+}
+
+static bool crucible_instruction_event(
+    QemuCrucibleFaultRule *rule,
+    const CrucibleInstructionMetadata *metadata, uint32_t mutation_kind,
+    uint32_t replay_ordinal, uint32_t replay_total,
+    uint16_t outcome, uint64_t observed_icount,
+    const CrucibleInstructionState *before,
+    const CrucibleInstructionState *after,
+    const uint8_t *detail, size_t detail_len)
+{
+    g_autoptr(GByteArray) evidence = g_byte_array_new();
+    uint8_t opportunity_hash[32];
+
+    crucible_instruction_evidence(
+        metadata, mutation_kind, replay_ordinal, replay_total,
+        observed_icount, before, after, detail, detail_len,
+        evidence);
+    crucible_instruction_sha256(
+        evidence->data, evidence->len, opportunity_hash);
+    if (qemu_crucible_fault_rule_operation(rule) ==
+            CRUCIBLE_NODE_FAULT_OPERATION_APPLY) {
+        bool consumed = false;
+
+        for (guint i = 0; crucible_instruction_impulses &&
+                            i < crucible_instruction_impulses->len; i++) {
+            CrucibleInstructionImpulse *impulse =
+                g_ptr_array_index(crucible_instruction_impulses, i);
+
+            if (impulse->rule == rule) {
+                qemu_crucible_fault_event_reservation_consume(
+                    impulse->event_reservation);
+                consumed = true;
+                break;
+            }
+        }
+        if (!consumed) {
+            error_report("Crucible instruction event lost its reservation");
+            abort();
+        }
+    }
+    qemu_crucible_fault_rule_event(
+        rule, outcome, observed_icount, opportunity_hash,
+        before->state_sha256, after->state_sha256,
+        evidence->data, evidence->len);
+    return !crucible_instruction_event_terminal_latched;
+}
+
+static void crucible_instruction_context_clear(
+    CrucibleInstructionContext *context)
+{
+    CPUFaultException pending = context->pending_exception;
+    QemuCrucibleFaultRule *exception_rule = context->exception_rule;
+    uint8_t exception_before_hash[32];
+    uint64_t exception_command_icount = context->exception_command_icount;
+    uint16_t pending_phase = context->pending_exception_phase;
+    QemuCrucibleFaultEventReservation *exception_event_reservation =
+        context->exception_event_reservation;
+    bool exception_pending = context->exception_pending;
+    bool exception_in_flight = context->exception_in_flight;
+    bool stop_after_exception = context->stop_after_exception;
+
+    g_clear_pointer(&context->port_io_entries, g_byte_array_unref);
+    g_clear_pointer(&context->contributors, g_ptr_array_unref);
+
+    memcpy(exception_before_hash, context->exception_before_hash,
+           sizeof(exception_before_hash));
+
+    qemu_crucible_fault_rule_unref(context->rule);
+    memset(context, 0, sizeof(*context));
+    context->pending_exception = pending;
+    context->exception_rule = exception_rule;
+    memcpy(context->exception_before_hash, exception_before_hash,
+           sizeof(exception_before_hash));
+    context->exception_command_icount = exception_command_icount;
+    context->pending_exception_phase = pending_phase;
+    context->exception_event_reservation = exception_event_reservation;
+    context->exception_pending = exception_pending;
+    context->exception_in_flight = exception_in_flight;
+    context->stop_after_exception = stop_after_exception;
+}
+
+void qemu_crucible_fault_instruction_port_io(
+    CPUState *cpu, bool is_write, uint32_t port, const uint8_t *value,
+    uint8_t size, bool completed)
+{
+    CrucibleInstructionContext *context;
+    uint8_t entry[CRUCIBLE_INSTRUCTION_PORT_IO_ENTRY_BYTES] = { 0 };
+
+    if (crucible_instruction_event_terminal_latched || !cpu || !value) {
+        return;
+    }
+    context = crucible_instruction_context(cpu, false);
+    if (!context || !context->executing || !context->rule ||
+        context->metadata.opcode_class !=
+            CRUCIBLE_INSTRUCTION_CLASS_X86_DEVICE_IO) {
+        return;
+    }
+    if ((size != 1 && size != 2 && size != 4) ||
+        context->port_io_entries->len /
+                CRUCIBLE_INSTRUCTION_PORT_IO_ENTRY_BYTES >=
+            CRUCIBLE_INSTRUCTION_PORT_IO_MAX_ENTRIES) {
+        error_report("Crucible device instruction produced invalid port I/O");
+        abort();
+    }
+    entry[0] = is_write;
+    entry[1] = size;
+    entry[2] = completed;
+    stl_le_p(entry + 4, port);
+    memcpy(entry + 8, value, size);
+    g_byte_array_append(context->port_io_entries, entry, sizeof(entry));
+    context->port_io_bytes += size;
+}
+
+static GByteArray *crucible_instruction_port_io_evidence(
+    const CrucibleInstructionContext *context)
+{
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    GByteArray *evidence;
+    uint8_t header[CRUCIBLE_INSTRUCTION_PORT_IO_HEADER_BYTES] = { 0 };
+    uint8_t digest[32];
+    gsize digest_len = sizeof(digest);
+    uint32_t entry_count;
+
+    if (!context->port_io_entries ||
+        context->port_io_entries->len == 0 ||
+        context->port_io_entries->len %
+                CRUCIBLE_INSTRUCTION_PORT_IO_ENTRY_BYTES != 0) {
+        return NULL;
+    }
+    entry_count = context->port_io_entries->len /
+                  CRUCIBLE_INSTRUCTION_PORT_IO_ENTRY_BYTES;
+    for (uint32_t index = 0; index < entry_count; index++) {
+        if (context->port_io_entries->data[
+                index * CRUCIBLE_INSTRUCTION_PORT_IO_ENTRY_BYTES + 2] == 0) {
+            return NULL;
+        }
+    }
+    g_checksum_update(
+        checksum, (const uint8_t *)"crucible.port-io.v1\0",
+        strlen("crucible.port-io.v1") + 1);
+    g_checksum_update(checksum, context->port_io_entries->data,
+                      context->port_io_entries->len);
+    g_checksum_get_digest(checksum, digest, &digest_len);
+    g_assert(digest_len == sizeof(digest));
+
+    memcpy(header, "CRUCIOP1", 8);
+    stw_le_p(header + 8, 1);
+    stw_le_p(header + 10, CRUCIBLE_INSTRUCTION_PORT_IO_ENTRY_BYTES);
+    stl_le_p(header + 12, entry_count);
+    stl_le_p(header + 16, context->port_io_bytes);
+    memcpy(header + 24, digest, sizeof(digest));
+    evidence = g_byte_array_sized_new(
+        sizeof(header) + context->port_io_entries->len);
+    g_byte_array_append(evidence, header, sizeof(header));
+    g_byte_array_append(evidence, context->port_io_entries->data,
+                        context->port_io_entries->len);
+    return evidence;
+}
+
+static bool crucible_instruction_consume_skip(CPUState *cpu)
+{
+    if (cpu->neg.icount_decr.u16.low == 0) {
+        int64_t refill = MIN(INT64_C(0xffff), cpu->icount_extra);
+
+        if (refill <= 0) {
+            return false;
+        }
+        cpu->neg.icount_decr.u16.low = refill;
+        cpu->icount_extra -= refill;
+    }
+    cpu->neg.icount_decr.u16.low--;
+    return true;
+}
+
+bool qemu_crucible_fault_instruction_prepare(CPUState *cpu,
+                                             TranslationBlock *tb,
+                                             uint64_t pc,
+                                             uint64_t observed_icount)
+{
+    CrucibleInstructionContext *context =
+        crucible_instruction_context(cpu, false);
+    CrucibleInstructionMetadata metadata;
+    CrucibleInstructionSelector selected;
+    g_autoptr(GPtrArray) matched_rules = g_ptr_array_new();
+    bool all_result_transforms = true;
+    CrucibleInstructionMatch match = {
+        .cpu = cpu,
+        .metadata = &metadata,
+        .rules = matched_rules,
+    };
+
+    if (crucible_instruction_event_terminal_latched) {
+        if (context) {
+            crucible_instruction_context_clear(context);
+        }
+        return true;
+    }
+
+    if ((!context || (!context->rule && !context->replaying)) &&
+        !crucible_instruction_rule_registry_active()) {
+        return false;
+    }
+    if (!context) {
+        context = crucible_instruction_context(cpu, true);
+    }
+    if (!context->replaying && !context->rule &&
+        !crucible_instruction_index_contains(cpu->cpu_index, pc)) {
+        return false;
+    }
+    if (!crucible_instruction_metadata(cpu, tb, pc, &metadata)) {
+        error_report("Crucible could not resolve one-instruction metadata");
+        abort();
+    }
+    if (context->replaying) {
+        if (metadata.pc != context->metadata.pc ||
+            metadata.length != context->metadata.length ||
+            metadata.code_page_count !=
+                context->metadata.code_page_count ||
+            memcmp(metadata.code_page, context->metadata.code_page,
+                   sizeof(metadata.code_page)) != 0 ||
+            memcmp(metadata.code_page_sha256,
+                   context->metadata.code_page_sha256,
+                   sizeof(metadata.code_page_sha256)) != 0 ||
+            memcmp(metadata.bytes, context->metadata.bytes,
+                   metadata.length) != 0) {
+            CrucibleInstructionState current = { 0 };
+
+            if (crucible_instruction_system_snapshot(
+                    observed_icount, &current) != 0) {
+                error_report("Crucible could not fingerprint replay mismatch");
+                abort();
+            }
+            if (!crucible_instruction_event(
+                context->rule, &context->metadata,
+                context->mutation_kind, context->replay_ordinal,
+                context->replay_total, CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR,
+                observed_icount, &context->before_state, &current,
+                metadata.bytes, metadata.length)) {
+                crucible_instruction_context_clear(context);
+                return true;
+            }
+            error_report("Crucible replay instruction bytes changed");
+            return crucible_instruction_fail_closed(cpu, context);
+        }
+        metadata.has_input_state_sha256 =
+            context->metadata.has_input_state_sha256;
+        memcpy(metadata.input_state_sha256,
+               context->metadata.input_state_sha256, 32);
+        memcpy(metadata.matched_input_state_sha256,
+               context->metadata.matched_input_state_sha256, 32);
+        context->metadata = metadata;
+        return false;
+    }
+    crucible_instruction_index_match(&match);
+    if (match.matches == 0) {
+        crucible_instruction_context_clear(context);
+        return false;
+    }
+    for (guint i = 0; i < matched_rules->len; i++) {
+        uint32_t candidate_kind;
+
+        if (!crucible_instruction_rule_u32(
+                g_ptr_array_index(matched_rules, i),
+                CRUCIBLE_NODE_FAULT_FIELD_P2, &candidate_kind)) {
+            error_report("Crucible instruction rule changed after admission");
+            abort();
+        }
+        all_result_transforms &= candidate_kind == 1;
+    }
+    if (match.matches != 1 && !all_result_transforms) {
+        CrucibleInstructionState state = { 0 };
+
+        if (crucible_instruction_system_snapshot(
+                observed_icount, &state) != 0) {
+            error_report("Crucible could not fingerprint instruction conflict");
+            abort();
+        }
+        memcpy(metadata.matched_input_state_sha256,
+               state.state_sha256, 32);
+        error_report(
+            "Conflicting Crucible instruction faults escaped admission");
+        qemu_system_vmstop_request_prepare();
+        qemu_system_vmstop_request(RUN_STATE_INTERNAL_ERROR);
+        cpu_exit(cpu);
+        return true;
+    }
+    g_ptr_array_sort(matched_rules, crucible_instruction_rule_compare);
+    match.rule = g_ptr_array_index(matched_rules, 0);
+    if (!crucible_instruction_rule_u32(
+            match.rule, CRUCIBLE_NODE_FAULT_FIELD_P2,
+            &match.mutation_kind) ||
+        !crucible_instruction_rule_u32(
+            match.rule, CRUCIBLE_NODE_FAULT_FIELD_P5,
+            &match.replay_count)) {
+        error_report("Crucible instruction rule changed after admission");
+        abort();
+    }
+    if (!crucible_instruction_selector(match.rule, &selected)) {
+        error_report("Crucible instruction selector changed after admission");
+        abort();
+    }
+    metadata.has_input_state_sha256 = selected.has_input_state_sha256;
+    memcpy(metadata.input_state_sha256, selected.input_state_sha256, 32);
+    if (metadata.opcode_class == 0) {
+        CrucibleInstructionState state = { 0 };
+
+        if (!qemu_crucible_fault_rule_occurs_nested(
+                match.rule, CRUCIBLE_NODE_FAULT_FIELD_P1,
+                "occurrence")) {
+            crucible_instruction_context_clear(context);
+            return false;
+        }
+        if (crucible_instruction_system_snapshot(
+                observed_icount, &state) != 0) {
+            error_report(
+                "Crucible could not fingerprint unclassified instruction");
+            abort();
+        }
+        if (!crucible_instruction_event(
+            match.rule, &metadata, match.mutation_kind, 0,
+            match.replay_count, CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR,
+            observed_icount, &state, &state, NULL, 0)) {
+            crucible_instruction_context_clear(context);
+            return true;
+        }
+        if (qemu_crucible_fault_rule_operation(match.rule) ==
+            CRUCIBLE_NODE_FAULT_OPERATION_APPLY) {
+            crucible_instruction_impulse_fail(match.rule, state.state_sha256);
+        }
+        error_report("Crucible selected an unclassified instruction");
+        return crucible_instruction_fail_closed(cpu, context);
+    }
+    if (all_result_transforms) {
+        crucible_instruction_context_clear(context);
+        context->metadata = metadata;
+        context->mutation_kind = 1;
+        if (crucible_instruction_system_snapshot(
+                observed_icount, &context->before_state) != 0) {
+            error_report("Crucible could not capture instruction input state");
+            abort();
+        }
+        context->command_before_state = context->before_state;
+        memcpy(context->metadata.matched_input_state_sha256,
+               context->before_state.state_sha256, 32);
+        context->contributors = g_ptr_array_new_with_free_func(
+            crucible_instruction_contributor_free);
+        for (guint i = 0; i < matched_rules->len; i++) {
+            QemuCrucibleFaultRule *candidate =
+                g_ptr_array_index(matched_rules, i);
+            CrucibleInstructionContributor *contributor;
+            CrucibleInstructionMetadata candidate_metadata = metadata;
+            CrucibleInstructionSelector candidate_selector;
+
+            if (!crucible_instruction_selector(
+                    candidate, &candidate_selector)) {
+                error_report(
+                    "Crucible instruction selector changed after admission");
+                abort();
+            }
+            candidate_metadata.has_input_state_sha256 =
+                candidate_selector.has_input_state_sha256;
+            memcpy(candidate_metadata.input_state_sha256,
+                   candidate_selector.input_state_sha256, 32);
+            memcpy(candidate_metadata.matched_input_state_sha256,
+                   context->before_state.state_sha256, 32);
+            if (candidate_selector.has_input_state_sha256 &&
+                memcmp(candidate_selector.input_state_sha256,
+                       context->before_state.state_sha256, 32) != 0) {
+                if (!qemu_crucible_fault_rule_occurs_nested(
+                        candidate, CRUCIBLE_NODE_FAULT_FIELD_P1,
+                        "occurrence")) {
+                    continue;
+                }
+                if (!crucible_instruction_event(
+                    candidate, &candidate_metadata, 1, 0, 0,
+                    CRUCIBLE_FAULT_EVENT_OUTCOME_SUPPRESSED,
+                    observed_icount, &context->before_state,
+                    &context->before_state, NULL, 0)) {
+                    crucible_instruction_context_clear(context);
+                    return true;
+                }
+                crucible_instruction_impulse_complete(
+                    candidate, observed_icount,
+                    context->command_before_state.state_sha256,
+                    context->before_state.state_sha256);
+                continue;
+            }
+            contributor = g_new0(CrucibleInstructionContributor, 1);
+            contributor->rule = qemu_crucible_fault_rule_ref(candidate);
+            contributor->selector = candidate_selector;
+            g_ptr_array_add(context->contributors, contributor);
+        }
+        if (context->contributors->len == 0) {
+            crucible_instruction_context_clear(context);
+            return false;
+        }
+        context->rule = qemu_crucible_fault_rule_ref(
+            ((CrucibleInstructionContributor *)g_ptr_array_index(
+                context->contributors, 0))->rule);
+        return false;
+    }
+    if (match.mutation_kind != 1 &&
+        !qemu_crucible_fault_rule_occurs_nested(
+            match.rule, CRUCIBLE_NODE_FAULT_FIELD_P1, "occurrence")) {
+        crucible_instruction_context_clear(context);
+        return false;
+    }
+    crucible_instruction_context_clear(context);
+    context->rule = qemu_crucible_fault_rule_ref(match.rule);
+    context->metadata = metadata;
+    context->mutation_kind = match.mutation_kind;
+    context->replay_total = match.replay_count;
+    context->replay_remaining = match.replay_count;
+    if (crucible_instruction_system_snapshot(
+            observed_icount, &context->before_state) != 0) {
+        error_report("Crucible could not capture instruction input state");
+        abort();
+    }
+    context->command_before_state = context->before_state;
+    memcpy(context->metadata.matched_input_state_sha256,
+           context->before_state.state_sha256, 32);
+    if (context->metadata.has_input_state_sha256 &&
+        memcmp(context->metadata.input_state_sha256,
+               context->before_state.state_sha256, 32) != 0) {
+        if (context->mutation_kind == 1 &&
+            !qemu_crucible_fault_rule_occurs_nested(
+                context->rule, CRUCIBLE_NODE_FAULT_FIELD_P1,
+                "occurrence")) {
+            crucible_instruction_context_clear(context);
+            return false;
+        }
+        if (!crucible_instruction_event(
+            context->rule, &context->metadata, context->mutation_kind,
+            0, context->replay_total,
+            CRUCIBLE_FAULT_EVENT_OUTCOME_SUPPRESSED, observed_icount,
+            &context->before_state, &context->before_state, NULL, 0)) {
+            crucible_instruction_context_clear(context);
+            return true;
+        }
+        crucible_instruction_impulse_complete(
+            context->rule, observed_icount,
+            context->command_before_state.state_sha256,
+            context->before_state.state_sha256);
+        crucible_instruction_context_clear(context);
+        return false;
+    }
+    if (match.mutation_kind == 1) {
+        const uint8_t *identity;
+        uint32_t numeric_id;
+
+        if (!crucible_instruction_rule_hash(
+                context->rule, CRUCIBLE_NODE_FAULT_FIELD_P3, &identity) ||
+            qemu_crucible_fault_register_numeric_id(
+                identity, &numeric_id) != 0 ||
+            !crucible_instruction_has_destination(&metadata, numeric_id)) {
+            if (!crucible_instruction_event(
+                context->rule, &metadata, match.mutation_kind, 0, 0,
+                CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR, observed_icount,
+                &context->before_state, &context->before_state,
+                NULL, 0)) {
+                crucible_instruction_context_clear(context);
+                return true;
+            }
+            error_report(
+                "Crucible instruction result target is not a decoded "
+                "destination");
+            return crucible_instruction_fail_closed(cpu, context);
+        }
+    }
+    if (match.mutation_kind == 2) {
+        CrucibleInstructionState after = { 0 };
+        uint64_t after_icount;
+
+        if (metadata.flags & CRUCIBLE_INSTRUCTION_FLAG_INDIVISIBLE ||
+            metadata.pc > UINT64_MAX - metadata.length) {
+            if (!crucible_instruction_event(
+                context->rule, &metadata, match.mutation_kind, 0, 0,
+                CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR, observed_icount,
+                &context->before_state, &context->before_state,
+                NULL, 0)) {
+                crucible_instruction_context_clear(context);
+                return true;
+            }
+            error_report("Crucible instruction is not safely skippable");
+            return crucible_instruction_fail_closed(cpu, context);
+        }
+        if (!crucible_instruction_consume_skip(cpu)) {
+            error_report("Crucible skipped-instruction accounting failed");
+            abort();
+        }
+        cpu_set_pc(cpu, metadata.pc + metadata.length);
+        after_icount = qemu_crucible_fault_observed_icount();
+        if (after_icount != observed_icount + 1 ||
+            crucible_instruction_system_snapshot(
+                after_icount, &after) != 0) {
+            error_report("Crucible skipped-instruction accounting failed");
+            abort();
+        }
+        if (!crucible_instruction_event(
+            context->rule, &metadata, match.mutation_kind, 0, 0,
+            CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED, after_icount,
+            &context->before_state, &after, NULL, 0)) {
+            crucible_instruction_context_clear(context);
+            return true;
+        }
+        crucible_instruction_impulse_complete(
+            context->rule, after_icount,
+            context->command_before_state.state_sha256,
+            after.state_sha256);
+        crucible_instruction_context_clear(context);
+        qemu_crucible_fault_register_instruction_boundary(
+            cpu, QEMU_CRUCIBLE_MODEL_PHASE_AFTER_INSTRUCTION,
+            after_icount);
+        return true;
+    }
+    if (match.mutation_kind == 3 &&
+        metadata.flags & CRUCIBLE_INSTRUCTION_FLAG_CONTROL_FLOW) {
+        if (!crucible_instruction_event(
+            context->rule, &metadata, match.mutation_kind, 0,
+            match.replay_count, CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR,
+            observed_icount, &context->before_state,
+            &context->before_state, NULL, 0)) {
+            crucible_instruction_context_clear(context);
+            return true;
+        }
+        error_report(
+            "Crucible control-flow instruction has no replay contract");
+        return crucible_instruction_fail_closed(cpu, context);
+    }
+    return false;
+}
+
+void qemu_crucible_fault_instruction_execution_begin(
+    CPUState *cpu, uint64_t pc)
+{
+    CrucibleInstructionContext *context =
+        crucible_instruction_context(cpu, false);
+
+    if (crucible_instruction_event_terminal_latched) {
+        if (context) {
+            crucible_instruction_context_clear(context);
+        }
+        return;
+    }
+    if (!context || !context->rule) {
+        return;
+    }
+    if (context->executing || pc != context->metadata.pc ||
+        crucible_instruction_system_snapshot(
+            qemu_crucible_fault_observed_icount(),
+            &context->before_state) != 0) {
+        error_report("Crucible instruction execution context is inconsistent");
+        abort();
+    }
+    g_clear_pointer(&context->port_io_entries, g_byte_array_unref);
+    context->port_io_bytes = 0;
+    if (context->metadata.opcode_class ==
+            CRUCIBLE_INSTRUCTION_CLASS_X86_DEVICE_IO) {
+        context->port_io_entries = g_byte_array_new();
+    }
+    context->executing = true;
+}
+
+void qemu_crucible_fault_instruction_execution_complete(
+    CPUState *cpu, uint64_t observed_icount, bool exceptional)
+{
+    CrucibleInstructionContext *context =
+        crucible_instruction_context(cpu, false);
+    CrucibleInstructionState after = { 0 };
+    g_autoptr(GByteArray) port_io_evidence = NULL;
+
+    if (crucible_instruction_event_terminal_latched) {
+        if (context) {
+            crucible_instruction_context_clear(context);
+        }
+        return;
+    }
+    if (!context || !context->executing || !context->rule) {
+        return;
+    }
+    context->executing = false;
+    if (context->contributors && exceptional) {
+        /* Result faults select only instructions that commit a result. */
+        crucible_instruction_context_clear(context);
+        return;
+    }
+    if (context->contributors) {
+        for (guint i = 0; i < context->contributors->len; i++) {
+            CrucibleInstructionContributor *contributor =
+                g_ptr_array_index(context->contributors, i);
+            CrucibleInstructionMetadata metadata = context->metadata;
+            CrucibleInstructionState transform_before = { 0 };
+            const uint8_t *destination;
+            const QObject *mutation = qemu_crucible_fault_rule_json(
+                contributor->rule, CRUCIBLE_NODE_FAULT_FIELD_P4);
+            g_autoptr(GByteArray) detail = g_byte_array_new();
+            uint8_t register_before_hash[32];
+            uint8_t register_after_hash[32];
+
+            if (!qemu_crucible_fault_rule_occurs_nested(
+                    contributor->rule, CRUCIBLE_NODE_FAULT_FIELD_P1,
+                    "occurrence")) {
+                continue;
+            }
+            if (crucible_instruction_system_snapshot(
+                    observed_icount, &transform_before) != 0 ||
+                !crucible_instruction_rule_hash(
+                    contributor->rule, CRUCIBLE_NODE_FAULT_FIELD_P3,
+                    &destination) ||
+                qemu_crucible_fault_register_result_transform(
+                    cpu, destination, mutation, observed_icount,
+                    QEMU_CRUCIBLE_MODEL_PHASE_AFTER_INSTRUCTION,
+                    register_before_hash, register_after_hash, detail) != 0 ||
+                detail->len < 152 ||
+                memcmp(detail->data, "CRUCQRW1", 8) != 0 ||
+                crucible_instruction_system_snapshot(
+                    observed_icount, &after) != 0) {
+                error_report(
+                    "Crucible instruction result transform became invalid");
+                crucible_instruction_fail_closed(cpu, context);
+                return;
+            }
+            metadata.has_input_state_sha256 =
+                contributor->selector.has_input_state_sha256;
+            memcpy(metadata.input_state_sha256,
+                   contributor->selector.input_state_sha256, 32);
+            if (!crucible_instruction_event(
+                contributor->rule, &metadata, 1, 0, 0,
+                CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED, observed_icount,
+                &transform_before, &after, detail->data, detail->len)) {
+                crucible_instruction_context_clear(context);
+                return;
+            }
+            crucible_instruction_impulse_complete(
+                contributor->rule, observed_icount,
+                context->command_before_state.state_sha256,
+                after.state_sha256);
+            contributor->terminalized =
+                qemu_crucible_fault_rule_operation(contributor->rule) ==
+                    CRUCIBLE_NODE_FAULT_OPERATION_APPLY;
+        }
+        crucible_instruction_context_clear(context);
+        return;
+    }
+    if (crucible_instruction_system_snapshot(
+            observed_icount, &after) != 0) {
+        error_report("Crucible could not fingerprint instruction completion");
+        abort();
+    }
+    if (!exceptional && context->mutation_kind == 3 &&
+        context->metadata.opcode_class ==
+            CRUCIBLE_INSTRUCTION_CLASS_X86_DEVICE_IO) {
+        port_io_evidence =
+            crucible_instruction_port_io_evidence(context);
+        if (!port_io_evidence) {
+            if (!crucible_instruction_event(
+                context->rule, &context->metadata,
+                context->mutation_kind, context->replay_ordinal,
+                context->replay_total,
+                CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR, observed_icount,
+                &context->before_state, &after, NULL, 0)) {
+                crucible_instruction_context_clear(context);
+                return;
+            }
+            error_report(
+                "Crucible device replay observed no port-I/O transaction");
+            crucible_instruction_fail_closed(cpu, context);
+            return;
+        }
+    }
+    if (!crucible_instruction_event(
+        context->rule, &context->metadata,
+        context->mutation_kind, context->replay_ordinal,
+        context->replay_total,
+        exceptional ? CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR :
+                      CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED,
+        observed_icount, &context->before_state, &after,
+        port_io_evidence ? port_io_evidence->data : NULL,
+        port_io_evidence ? port_io_evidence->len : 0)) {
+        crucible_instruction_context_clear(context);
+        return;
+    }
+    if (exceptional) {
+        crucible_instruction_fail_closed(cpu, context);
+        return;
+    }
+    if (context->mutation_kind != 3 || context->replay_remaining == 0) {
+        crucible_instruction_impulse_complete(
+            context->rule, observed_icount,
+            context->command_before_state.state_sha256,
+            after.state_sha256);
+        crucible_instruction_context_clear(context);
+        return;
+    }
+    context->replay_remaining--;
+    context->replay_ordinal++;
+    context->replaying = true;
+    cpu_set_pc(cpu, context->metadata.pc);
+    cpu_exit(cpu);
+}
+
+static bool crucible_instruction_rule_shape(
+    const QemuCrucibleFaultRule *rule, CPUState **cpu_out,
+    CrucibleInstructionSelector *selector_out, uint32_t *mutation_kind)
+{
+    CrucibleInstructionSelector selector;
+    uint32_t target_vcpu;
+    uint32_t replay_count;
+    CPUState *cpu;
+
+    if (!crucible_instruction_rule_u32(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_T1, &target_vcpu)) {
+        return false;
+    }
+    cpu = qemu_get_cpu(target_vcpu);
+    if (!cpu ||
+        !crucible_instruction_rule_u32(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_P2, mutation_kind) ||
+        !crucible_instruction_rule_u32(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_P5, &replay_count) ||
+        !crucible_instruction_selector(rule, &selector) ||
+        *mutation_kind < 1 || *mutation_kind > 3) {
+        return false;
+    }
+    if ((*mutation_kind == 1 &&
+         qemu_crucible_fault_rule_model_phase(rule) !=
+             QEMU_CRUCIBLE_MODEL_PHASE_AFTER_INSTRUCTION) ||
+        ((*mutation_kind == 2 || *mutation_kind == 3) &&
+         qemu_crucible_fault_rule_model_phase(rule) !=
+             QEMU_CRUCIBLE_MODEL_PHASE_BEFORE_INSTRUCTION) ||
+        (*mutation_kind == 3 &&
+         (replay_count == 0 || replay_count > 256)) ||
+        (*mutation_kind != 3 && replay_count != 0)) {
+        return false;
+    }
+    *cpu_out = cpu;
+    *selector_out = selector;
+    return true;
+}
+
+size_t qemu_crucible_fault_instruction_event_budget(
+    const QemuCrucibleFaultRule *rule)
+{
+    CrucibleInstructionSelector selector;
+    uint32_t mutation_kind;
+    uint32_t replay_count;
+    CPUState *cpu;
+
+    if (!crucible_instruction_rule_shape(
+            rule, &cpu, &selector, &mutation_kind)) {
+        return 0;
+    }
+    if (mutation_kind != 3) {
+        return 1;
+    }
+    if (!crucible_instruction_rule_u32(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_P5, &replay_count)) {
+        return 0;
+    }
+    return (size_t)replay_count + 1;
+}
+
+int qemu_crucible_fault_instruction_validate(
+    const QemuCrucibleFaultRule *rule)
+{
+    CrucibleInstructionSelector selector;
+    CrucibleInstructionMetadata metadata = { 0 };
+    const uint8_t *destination;
+    uint32_t mutation_kind;
+    uint32_t numeric_id;
+    CPUState *cpu;
+
+    if (!crucible_instruction_rule_shape(
+            rule, &cpu, &selector, &mutation_kind) ||
+        (CPU_GET_CLASS(cpu)->crucible_register_scope !=
+             CRUCIBLE_INSTRUCTION_SCOPE_X86_64 &&
+         CPU_GET_CLASS(cpu)->crucible_register_scope !=
+             CRUCIBLE_INSTRUCTION_SCOPE_AARCH64)) {
+        return -EINVAL;
+    }
+    if (crucible_instruction_index_conflicts(
+            rule, &selector, cpu->cpu_index, mutation_kind)) {
+        return -EBUSY;
+    }
+    metadata.architecture = CPU_GET_CLASS(cpu)->crucible_register_scope;
+    if (selector.has_bytes) {
+        metadata.length = selector.bytes_len;
+        memcpy(metadata.bytes, selector.bytes, selector.bytes_len);
+        metadata.opcode_class = metadata.architecture ==
+                CRUCIBLE_INSTRUCTION_SCOPE_X86_64 ?
+            crucible_instruction_x86_classify(&metadata) :
+            crucible_instruction_aarch64_classify(&metadata);
+        if (metadata.opcode_class == 0 ||
+            (selector.has_opcode_class &&
+             selector.opcode_class != metadata.opcode_class)) {
+            return -ENOTSUP;
+        }
+    }
+    if (selector.has_opcode_class &&
+        !crucible_instruction_class_supported(
+            metadata.architecture, selector.opcode_class)) {
+        return -ENOTSUP;
+    }
+    if ((!selector.has_bytes && !selector.has_opcode_class) ||
+        !crucible_instruction_mutation_supported(
+            selector.has_bytes ? metadata.opcode_class :
+                                 selector.opcode_class,
+            mutation_kind)) {
+        return -ENOTSUP;
+    }
+    if (mutation_kind == 1 &&
+        (!selector.has_bytes ||
+         !crucible_instruction_rule_hash(
+             rule, CRUCIBLE_NODE_FAULT_FIELD_P3, &destination) ||
+         qemu_crucible_fault_register_numeric_id(
+             destination, &numeric_id) != 0 ||
+         !crucible_instruction_has_destination(&metadata, numeric_id) ||
+         qemu_crucible_fault_register_result_validate(
+             cpu, destination,
+             qemu_crucible_fault_rule_json(
+                 rule, CRUCIBLE_NODE_FAULT_FIELD_P4),
+             QEMU_CRUCIBLE_MODEL_PHASE_AFTER_INSTRUCTION) != 0)) {
+        return -EINVAL;
+    }
+    if (selector.has_bytes && mutation_kind == 2 &&
+        metadata.flags & CRUCIBLE_INSTRUCTION_FLAG_INDIVISIBLE) {
+        return -ENOTSUP;
+    }
+    return 0;
+}
+
+int qemu_crucible_fault_exception_validate(
+    const QemuCrucibleFaultRule *rule)
+{
+    CPUFaultException exception;
+    CrucibleInstructionContext *context;
+    uint32_t target_vcpu;
+    CPUState *cpu;
+
+    if (!crucible_instruction_rule_u32(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_T1, &target_vcpu)) {
+        return -EINVAL;
+    }
+    cpu = qemu_get_cpu(target_vcpu);
+    context = cpu ? crucible_instruction_context(cpu, false) : NULL;
+
+    if (!cpu ||
+        (context &&
+         (context->exception_pending || context->exception_in_flight)) ||
+        !qemu_crucible_fault_exception_decode(
+            qemu_crucible_fault_rule_json(
+                rule, CRUCIBLE_NODE_FAULT_FIELD_P1), &exception) ||
+        exception.record != CPU_FAULT_EXCEPTION_ARCHITECTURE_DEFAULT ||
+        (qemu_crucible_fault_rule_model_phase(rule) !=
+             QEMU_CRUCIBLE_MODEL_PHASE_BEFORE_INSTRUCTION &&
+         qemu_crucible_fault_rule_model_phase(rule) !=
+             QEMU_CRUCIBLE_MODEL_PHASE_AFTER_INSTRUCTION) ||
+        exception.before_instruction !=
+            (qemu_crucible_fault_rule_model_phase(rule) ==
+             QEMU_CRUCIBLE_MODEL_PHASE_BEFORE_INSTRUCTION) ||
+        !cpu_validate_fault_exception(cpu, &exception)) {
+        return -EINVAL;
+    }
+    return 0;
+}
+
+static int crucible_instruction_exception_impulse(
+    const QemuCrucibleFaultRule *rule, uint64_t observed_icount,
+    uint8_t before_hash[32], uint8_t after_hash[32], GByteArray *evidence,
+    uint16_t *outcome,
+    QemuCrucibleFaultEventReservation **event_reservation)
+{
+    CrucibleInstructionContext *context;
+    CPUFaultException exception;
+    uint32_t target_vcpu;
+    CPUState *cpu;
+    uint8_t record[192] = { 0 };
+
+    if (qemu_crucible_fault_exception_validate(rule) != 0 ||
+        !crucible_instruction_rule_u32(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_T1, &target_vcpu)) {
+        return -EINVAL;
+    }
+    cpu = qemu_get_cpu(target_vcpu);
+    if (!cpu ||
+        !qemu_crucible_fault_exception_decode(
+            qemu_crucible_fault_rule_json(
+                rule, CRUCIBLE_NODE_FAULT_FIELD_P1), &exception)) {
+        return -EINVAL;
+    }
+    context = crucible_instruction_context(cpu, true);
+    if (context->exception_pending || context->exception_in_flight ||
+        !event_reservation ||
+        !*event_reservation) {
+        return -EBUSY;
+    }
+    if (qemu_crucible_fault_execution_fingerprint(
+            observed_icount, before_hash) != 0) {
+        return -EIO;
+    }
+    memcpy(after_hash, before_hash, 32);
+    memcpy(record, "CRUCEXC1", 8);
+    stw_le_p(record + 8, 2);
+    stw_le_p(record + 10, CPU_GET_CLASS(cpu)->crucible_register_scope);
+    stw_le_p(record + 12, qemu_crucible_fault_rule_model_phase(rule));
+    stl_le_p(record + 16, target_vcpu);
+    stl_le_p(record + 20, exception.vector);
+    stq_le_p(record + 24, exception.syndrome);
+    stq_le_p(record + 32, exception.fault_address);
+    stq_le_p(record + 40, observed_icount);
+    record[48] = exception.has_fault_address;
+    record[49] = exception.before_instruction;
+    record[50] = exception.maskable;
+    memcpy(record + 96, before_hash, 32);
+    g_byte_array_append(evidence, record, sizeof(record));
+    context->pending_exception = exception;
+    context->exception_rule = qemu_crucible_fault_rule_copy(rule);
+    memcpy(context->exception_before_hash, before_hash, 32);
+    context->exception_command_icount = observed_icount;
+    context->pending_exception_phase =
+        qemu_crucible_fault_rule_model_phase(rule);
+    context->exception_event_reservation = *event_reservation;
+    *event_reservation = NULL;
+    context->exception_pending = true;
+    *outcome = CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED;
+    return QEMU_CRUCIBLE_FAULT_IMPULSE_DEFERRED;
+}
+
+static void crucible_instruction_impulse_free(gpointer opaque)
+{
+    CrucibleInstructionImpulse *impulse = opaque;
+
+    if (impulse->event_reservation) {
+        qemu_crucible_fault_event_reservation_release(
+            impulse->event_reservation);
+    }
+    qemu_crucible_fault_rule_unref(impulse->rule);
+    g_free(impulse);
+}
+
+static int crucible_instruction_transform_impulse(
+    const QemuCrucibleFaultRule *rule, uint64_t observed_icount,
+    uint8_t before_hash[32], uint8_t after_hash[32], GByteArray *evidence,
+    uint16_t *outcome,
+    QemuCrucibleFaultEventReservation **event_reservation)
+{
+    CrucibleInstructionImpulse *impulse;
+
+    if (!event_reservation || !*event_reservation ||
+        qemu_crucible_fault_instruction_validate(rule) != 0 ||
+        qemu_crucible_fault_execution_fingerprint(
+            observed_icount, before_hash) != 0) {
+        return -EINVAL;
+    }
+    memcpy(after_hash, before_hash, 32);
+    g_byte_array_set_size(evidence, 0);
+    impulse = g_new0(CrucibleInstructionImpulse, 1);
+    impulse->rule = qemu_crucible_fault_rule_copy(rule);
+    impulse->command_icount = observed_icount;
+    memcpy(impulse->before_hash, before_hash, 32);
+    impulse->event_reservation = *event_reservation;
+    *event_reservation = NULL;
+    if (!crucible_instruction_impulses) {
+        crucible_instruction_impulses = g_ptr_array_new_with_free_func(
+            crucible_instruction_impulse_free);
+    }
+    g_ptr_array_add(crucible_instruction_impulses, impulse);
+    qemu_crucible_fault_instruction_rules_changed();
+    *outcome = CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED;
+    return QEMU_CRUCIBLE_FAULT_IMPULSE_DEFERRED;
+}
+
+void qemu_crucible_fault_instruction_boundary_exception(
+    CPUState *cpu, uint16_t model_phase, uint64_t observed_icount)
+{
+    CrucibleInstructionContext *context =
+        crucible_instruction_context(cpu, false);
+    CPUFaultException exception;
+
+    (void)observed_icount;
+    if (crucible_instruction_event_terminal_latched) {
+        if (context) {
+            crucible_instruction_context_clear(context);
+        }
+        return;
+    }
+    if (!context || !context->exception_pending ||
+        context->pending_exception_phase != model_phase) {
+        return;
+    }
+    exception = context->pending_exception;
+    context->exception_pending = false;
+    context->exception_in_flight = true;
+    if (context->rule) {
+        if (context->mutation_kind == 3 && context->replaying) {
+            CrucibleInstructionState after = { 0 };
+
+            if (crucible_instruction_system_snapshot(
+                    observed_icount, &after) != 0) {
+                error_report(
+                    "Crucible could not fingerprint interrupted replay");
+                abort();
+            }
+            if (!crucible_instruction_event(
+                context->rule, &context->metadata,
+                context->mutation_kind, context->replay_ordinal,
+                context->replay_total, CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR,
+                observed_icount, &context->before_state,
+                &after, NULL, 0)) {
+                crucible_instruction_context_clear(context);
+                return;
+            }
+            crucible_instruction_impulse_fail(
+                context->rule,
+                context->command_before_state.state_sha256);
+            context->stop_after_exception = true;
+        }
+        crucible_instruction_context_clear(context);
+    }
+    cpu_inject_fault_exception(cpu, &exception, 0);
+}
+
+void qemu_crucible_fault_instruction_exception_delivered(
+    CPUState *cpu, uint32_t vector, uint64_t syndrome,
+    bool has_fault_address, uint64_t fault_address)
+{
+    CrucibleInstructionContext *context =
+        crucible_instruction_context(cpu, false);
+    CPUFaultException *exception;
+    uint64_t observed_icount;
+    uint8_t after_hash[32];
+    uint8_t opportunity_hash[32];
+    uint8_t record[192] = { 0 };
+
+    if (!context || !context->exception_in_flight) {
+        return;
+    }
+    exception = &context->pending_exception;
+    if (exception->vector != vector || exception->syndrome != syndrome ||
+        exception->has_fault_address != has_fault_address ||
+        (has_fault_address && exception->fault_address != fault_address)) {
+        error_report("Crucible delivered exception differs from request");
+        crucible_instruction_fail_closed(cpu, context);
+        return;
+    }
+    observed_icount = qemu_crucible_fault_observed_icount();
+    if (qemu_crucible_fault_execution_fingerprint(
+            observed_icount, after_hash) != 0) {
+        error_report("Crucible could not fingerprint delivered exception");
+        crucible_instruction_fail_closed(cpu, context);
+        return;
+    }
+    memcpy(record, "CRUCEXC1", 8);
+    stw_le_p(record + 8, 2);
+    stw_le_p(record + 10, CPU_GET_CLASS(cpu)->crucible_register_scope);
+    stw_le_p(record + 12, context->pending_exception_phase);
+    stl_le_p(record + 16, cpu->cpu_index);
+    stl_le_p(record + 20, exception->vector);
+    stq_le_p(record + 24, exception->syndrome);
+    stq_le_p(record + 32, exception->fault_address);
+    stq_le_p(record + 40, context->exception_command_icount);
+    record[48] = exception->has_fault_address;
+    record[49] = exception->before_instruction;
+    record[50] = exception->maskable;
+    record[51] = 1;
+    stq_le_p(record + 56, observed_icount);
+    stq_le_p(record + 64, cpu->cc->get_pc(cpu));
+    stl_le_p(record + 72, vector);
+    record[76] = has_fault_address;
+    stq_le_p(record + 80, syndrome);
+    stq_le_p(record + 88, fault_address);
+    memcpy(record + 96, context->exception_before_hash, 32);
+    memcpy(record + 128, after_hash, 32);
+    crucible_instruction_sha256(record, sizeof(record), opportunity_hash);
+    qemu_crucible_fault_event_reservation_consume(
+        context->exception_event_reservation);
+    qemu_crucible_fault_rule_event(
+        context->exception_rule, CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED,
+        observed_icount, opportunity_hash, context->exception_before_hash,
+        after_hash, record, sizeof(record));
+    if (crucible_instruction_event_terminal_latched) {
+        crucible_instruction_context_clear(context);
+        return;
+    }
+    qemu_crucible_fault_complete_deferred(
+        context->exception_rule, context->exception_command_icount,
+        observed_icount, context->exception_before_hash, after_hash);
+    qemu_crucible_fault_event_reservation_release(
+        context->exception_event_reservation);
+    context->exception_event_reservation = NULL;
+    qemu_crucible_fault_rule_unref(context->exception_rule);
+    context->exception_rule = NULL;
+    context->exception_in_flight = false;
+    memset(&context->pending_exception, 0,
+           sizeof(context->pending_exception));
+    if (context->stop_after_exception) {
+        context->stop_after_exception = false;
+        qemu_system_vmstop_request_prepare();
+        qemu_system_vmstop_request(RUN_STATE_INTERNAL_ERROR);
+        cpu_exit(cpu);
+    }
+}
+
+static bool crucible_instruction_rule_registry_active(void)
+{
+    return crucible_instruction_index &&
+           crucible_instruction_index->len != 0;
+}
+
+static bool crucible_instruction_contexts_active(void)
+{
+    GHashTableIter iterator;
+    gpointer value;
+
+    if (!crucible_instruction_contexts) {
+        return false;
+    }
+    g_hash_table_iter_init(&iterator, crucible_instruction_contexts);
+    while (g_hash_table_iter_next(&iterator, NULL, &value)) {
+        CrucibleInstructionContext *context = value;
+
+        if (context->rule || context->replaying ||
+            context->exception_pending || context->exception_in_flight ||
+            context->executing) {
+            return true;
+        }
+    }
+    return false;
+}
+
+bool qemu_crucible_fault_instruction_context_active(void)
+{
+    return crucible_instruction_contexts_active();
+}
+
+bool qemu_crucible_fault_instruction_pc_active(CPUState *cpu, uint64_t pc)
+{
+    CrucibleInstructionContext *context =
+        crucible_instruction_context(cpu, false);
+
+    return (context && (context->rule || context->replaying)) ||
+        crucible_instruction_index_contains(cpu->cpu_index, pc);
+}
+
+bool qemu_crucible_fault_instruction_rules_active(void)
+{
+    return crucible_instruction_rule_registry_active() ||
+           crucible_instruction_contexts_active();
+}
+
+void qemu_crucible_fault_instruction_event_terminal(void)
+{
+    GHashTableIter iterator;
+    gpointer value;
+
+    crucible_instruction_event_terminal_latched = true;
+    while (crucible_instruction_impulses &&
+           crucible_instruction_impulses->len != 0) {
+        CrucibleInstructionImpulse *impulse =
+            g_ptr_array_index(crucible_instruction_impulses, 0);
+        QemuCrucibleFaultRule *rule =
+            qemu_crucible_fault_rule_ref(impulse->rule);
+        uint64_t command_icount = impulse->command_icount;
+        uint8_t before_hash[32];
+
+        memcpy(before_hash, impulse->before_hash, 32);
+        crucible_instruction_impulse_remove(rule);
+        qemu_crucible_fault_fail_deferred(
+            rule, command_icount, before_hash);
+        qemu_crucible_fault_rule_unref(rule);
+    }
+    if (!crucible_instruction_contexts) {
+        return;
+    }
+    g_hash_table_iter_init(&iterator, crucible_instruction_contexts);
+    while (g_hash_table_iter_next(&iterator, NULL, &value)) {
+        CrucibleInstructionContext *context = value;
+
+        if (context->exception_rule) {
+            qemu_crucible_fault_fail_deferred(
+                context->exception_rule,
+                context->exception_command_icount,
+                context->exception_before_hash);
+            qemu_crucible_fault_rule_unref(context->exception_rule);
+            context->exception_rule = NULL;
+            if (context->exception_event_reservation) {
+                qemu_crucible_fault_event_reservation_release(
+                    context->exception_event_reservation);
+                context->exception_event_reservation = NULL;
+            }
+            context->exception_pending = false;
+            context->exception_in_flight = false;
+        }
+    }
+}
+
+bool qemu_crucible_fault_instruction_ensure_registered(void)
+{
+    CPUState *cpu = qemu_get_cpu(0);
+    const uint32_t instruction_boundaries =
+        (1U << (CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY - 1)) |
+        (1U << (CRUCIBLE_FAULT_PHASE_BEFORE_INSTRUCTION - 1)) |
+        (1U << (CRUCIBLE_FAULT_PHASE_AFTER_INSTRUCTION - 1));
+
+    if (crucible_instruction_registered) {
+        return true;
+    }
+    if (!cpu || !qemu_crucible_fault_register_ensure_registered()) {
+        return false;
+    }
+    qemu_crucible_fault_node_register(
+        CRUCIBLE_FAULT_COMMAND_CPU_INSTRUCTION_TRANSFORM,
+        CPU_GET_CLASS(cpu)->crucible_register_scope,
+        instruction_boundaries, "qemu.cpu.instruction-transform.v1",
+        crucible_instruction_transform_impulse);
+    qemu_crucible_fault_node_register(
+        CRUCIBLE_FAULT_COMMAND_CPU_EXCEPTION,
+        CPU_GET_CLASS(cpu)->crucible_register_scope,
+        instruction_boundaries, "qemu.cpu.exception.v1",
+        crucible_instruction_exception_impulse);
+    crucible_instruction_registered = true;
+    return true;
+}
