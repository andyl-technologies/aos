+static uint32_t crucible_instruction_aarch64_classify(
+    CrucibleInstructionMetadata *metadata)
+{
+    uint32_t insn;
+    uint32_t rd;
+
+    if (metadata->length != 4) {
+        return 0;
+    }
+    insn = ldl_le_p(metadata->bytes);
+    rd = insn & 31;
+    if ((insn & 0x7c000000U) == 0x14000000U ||
+        (insn & 0x7e000000U) == 0x34000000U ||
+        (insn & 0x7e000000U) == 0x36000000U ||
+        (insn & 0xfffffc1fU) == 0xd61f0000U ||
+        (insn & 0xfffffc1fU) == 0xd63f0000U ||
+        (insn & 0xfffffc1fU) == 0xd65f0000U) {
+        metadata->flags |= CRUCIBLE_INSTRUCTION_FLAG_CONTROL_FLOW;
+        crucible_instruction_destination(metadata, 33);
+        if ((insn & 0xfc000000U) == 0x94000000U ||
+            (insn & 0xfffffc1fU) == 0xd63f0000U) {
+            crucible_instruction_destination(metadata, 31);
+        }
+        return CRUCIBLE_INSTRUCTION_CLASS_A64_CONTROL_FLOW;
+    }
+    if ((insn & 0xffff0000U) == 0 ||
+        (insn & 0xffe0001fU) == 0xd4000001U ||
+        (insn & 0xffe0001fU) == 0xd4000002U ||
+        (insn & 0xffe0001fU) == 0xd4000003U ||
+        (insn & 0xffe0001fU) == 0xd4200000U ||
+        (insn & 0xffe0001fU) == 0xd4400000U) {
+        metadata->flags |= CRUCIBLE_INSTRUCTION_FLAG_EXCEPTION;
+        return CRUCIBLE_INSTRUCTION_CLASS_A64_EXCEPTION;
+    }
+    if ((insn & 0x3f200c00U) == 0x38200000U &&
+        ((insn >> 12) & 0xfU) <= 8) {
+        metadata->flags |= CRUCIBLE_INSTRUCTION_FLAG_ATOMIC |
+                           CRUCIBLE_INSTRUCTION_FLAG_MEMORY |
+                           CRUCIBLE_INSTRUCTION_FLAG_INDIVISIBLE;
+        if (rd != 31) {
+            crucible_instruction_destination(metadata, rd + 1);
+        }
+        return CRUCIBLE_INSTRUCTION_CLASS_A64_ATOMIC;
+    } else if (((insn & 0x3b000000U) == 0x38000000U ||
+                (insn & 0x3b000000U) == 0x39000000U) &&
+               ((insn >> 22) & 3U) <= 1) {
+        bool load = ((insn >> 22) & 3U) == 1;
+        bool vector = insn & (1U << 26);
+        uint32_t rn = (insn >> 5) & 31;
+        uint32_t mode = (insn >> 10) & 3;
+
+        if (vector && (insn & 0x3b000000U) == 0x38000000U &&
+            mode == 2) {
+            return 0;
+        }
+
+        metadata->flags |= CRUCIBLE_INSTRUCTION_FLAG_MEMORY;
+        if (load && (vector || rd != 31)) {
+            crucible_instruction_destination(
+                metadata, vector ? 35 + rd : rd + 1);
+        }
+        if ((insn & 0x3b000000U) == 0x38000000U &&
+            (mode == 1 || mode == 3) && rn != 31) {
+            crucible_instruction_destination(metadata, rn + 1);
+        }
+        return load ? CRUCIBLE_INSTRUCTION_CLASS_A64_LOAD :
+                      CRUCIBLE_INSTRUCTION_CLASS_A64_STORE;
+    }
+    if (((insn & 0xff20fc00U) == 0x1e202800U &&
+         ((insn >> 22) & 3U) <= 1) ||
+        ((insn & 0xbf20fc00U) == 0x0e20d400U &&
+         (!(insn & (1U << 22)) || (insn & (1U << 30))))) {
+        crucible_instruction_destination(metadata, 35 + rd);
+        return CRUCIBLE_INSTRUCTION_CLASS_A64_FP_SIMD;
+    }
+    if ((insn & 0x1f000000U) == 0x10000000U) {
+        if (rd != 31) {
+            crucible_instruction_destination(metadata, rd + 1);
+        }
+        return CRUCIBLE_INSTRUCTION_CLASS_A64_INTEGER;
+    }
+    if ((insn & 0x1f000000U) == 0x0a000000U &&
+        ((insn & (1U << 31)) || !(insn & (1U << 15)))) {
+        if (rd != 31) {
+            crucible_instruction_destination(metadata, rd + 1);
+        }
+        if (((insn >> 29) & 3U) == 3U) {
+            crucible_instruction_destination(metadata, 34);
+        }
+        return CRUCIBLE_INSTRUCTION_CLASS_A64_INTEGER;
+    }
+    if ((insn & 0x1f200000U) == 0x0b000000U &&
+        ((insn >> 22) & 3U) != 3U &&
+        ((insn & (1U << 31)) || !(insn & (1U << 15)))) {
+        if (rd != 31) {
+            crucible_instruction_destination(metadata, rd + 1);
+        }
+        if (insn & (1U << 29)) {
+            crucible_instruction_destination(metadata, 34);
+        }
+        return CRUCIBLE_INSTRUCTION_CLASS_A64_INTEGER;
+    }
+    if ((insn & 0x1f800000U) == 0x11000000U) {
+        bool set_flags = insn & (1U << 29);
+
+        if (rd != 31) {
+            crucible_instruction_destination(metadata, rd + 1);
+        } else if (!set_flags) {
+            crucible_instruction_destination(metadata, 32);
+        }
+        if (set_flags) {
+            crucible_instruction_destination(metadata, 34);
+        }
+        return CRUCIBLE_INSTRUCTION_CLASS_A64_INTEGER;
+    }
+    if ((insn & 0x1f800000U) == 0x12800000U &&
+        ((insn >> 29) & 3U) != 1U &&
+        ((insn & (1U << 31)) || !(insn & (1U << 22)))) {
+        if (rd != 31) {
+            crucible_instruction_destination(metadata, rd + 1);
+        }
+        return CRUCIBLE_INSTRUCTION_CLASS_A64_INTEGER;
+    }
+    if ((insn & 0x1fe0fc00U) == 0x1a000000U) {
+        if (rd != 31) {
+            crucible_instruction_destination(metadata, rd + 1);
+        }
+        if (insn & (1U << 29)) {
+            crucible_instruction_destination(metadata, 34);
+        }
+        return CRUCIBLE_INSTRUCTION_CLASS_A64_INTEGER;
+    }
+    return 0;
+}
