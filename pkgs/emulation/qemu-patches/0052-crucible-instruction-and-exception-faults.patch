+static bool test_read_u32(uint64_t address, uint32_t *value)
+{
+    g_autoptr(GByteArray) bytes = g_byte_array_new();
+
+    if (!address || !qemu_plugin_read_memory_vaddr(address, bytes, 4) ||
+        bytes->len != 4) {
+        return false;
+    }
+    *value = test_get_u32(bytes->data);
+    return true;
+}
+
+static void test_observe_guest(void)
+{
+    uint32_t selected;
+    uint32_t iterations;
+    uint32_t exceptions;
+
+    if (!test_rule_installed || test_rejects()) {
+        return;
+    }
+    if (test_exception()) {
+        if (test_read_u32(test_exception_address, &exceptions) &&
+            exceptions == 1) {
+            test_guest_validated = true;
+        }
+        return;
+    }
+    if (!test_read_u32(test_selected_address, &selected) ||
+        !test_read_u32(test_iterations_address, &iterations)) {
+        return;
+    }
+    test_last_selected = selected;
+    test_last_iterations = iterations;
+    test_last_guest_state_read = true;
+    if (test_compose_mode() && selected == 0x43) {
+        test_guest_validated = true;
+        return;
+    }
+    if (test_result_mode() && selected == 0x41) {
+        test_guest_validated = true;
+        return;
+    }
+    if (iterations < 4) {
+        return;
+    }
+    if (test_result_mode()) {
+        return;
+    } else if (test_mode == TEST_INPUT_MISMATCH) {
+        test_guest_validated = selected == iterations ||
+                               selected == iterations + 1;
+    } else if (test_mode == TEST_SKIP_LOAD ||
+               test_mode == TEST_SKIP_FP_SIMD ||
+               test_mode == TEST_REPLAY_FP_SIMD) {
+        test_guest_validated = selected == 0x41;
+    } else if (test_mode == TEST_REPLAY_LOAD) {
+        test_guest_validated = selected == 0x40;
+    } else if (test_mode == TEST_SKIP_STORE ||
+               test_mode == TEST_SKIP_CONTROL ||
+               test_mode == TEST_SKIP_EXCEPTION) {
+        test_guest_validated = selected == 0;
+    } else if (test_mode == TEST_REPLAY_STORE) {
+        test_guest_validated = selected ==
+            (test_architecture == 2 ? 3 : 12);
+    } else if (test_skip_mode()) {
+        test_guest_validated = selected + 1 == iterations;
+    } else if (test_mode == TEST_REPLAY_DEVICE) {
+        /* The event validator requires a completed port-I/O transcript. */
+        test_guest_validated = true;
+    } else if (test_mode == TEST_REPLAY_ATOMIC) {
+        test_guest_validated = selected == 3;
+    } else if (test_replay_mode()) {
+        test_guest_validated = selected == iterations + 2;
+    }
+}
