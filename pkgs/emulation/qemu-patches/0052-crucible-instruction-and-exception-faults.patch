+QemuCrucibleFaultEventReservation *
+qemu_crucible_fault_event_reserve(size_t count)
+{
+    QemuCrucibleFaultEventReservation *reservation;
+    size_t used = MIN(crucible_node_event_count,
+                      (size_t)CRUCIBLE_NODE_EVENT_CAPACITY - 1);
+    size_t available = CRUCIBLE_NODE_EVENT_CAPACITY - 1 - used;
+
+    available -= MIN(crucible_node_event_reserved, available);
+    if (count == 0 || crucible_node_event_terminal || count > available ||
+        crucible_node_event_reserved > SIZE_MAX - count ||
+        crucible_node_event_sequence > UINT64_MAX - 1 - count ||
+        crucible_node_event_sequence_reserved >
+            UINT64_MAX - 1 - crucible_node_event_sequence - count) {
+        return NULL;
+    }
+    reservation = g_new0(QemuCrucibleFaultEventReservation, 1);
+    reservation->remaining = count;
+    crucible_node_event_reserved += count;
+    crucible_node_event_sequence_reserved += count;
+    return reservation;
+}
+
+void qemu_crucible_fault_event_reservation_consume(
+    QemuCrucibleFaultEventReservation *reservation)
+{
+    if (!reservation || reservation->remaining == 0 ||
+        crucible_node_event_reserved == 0) {
+        error_report("Invalid Crucible fault-event reservation consume");
+        abort();
+    }
+    reservation->remaining--;
+    crucible_node_event_reserved--;
+    crucible_node_event_sequence_reserved--;
+}
+
+void qemu_crucible_fault_event_reservation_release(
+    QemuCrucibleFaultEventReservation *reservation)
+{
+    if (!reservation ||
+        crucible_node_event_reserved < reservation->remaining ||
+        crucible_node_event_sequence_reserved < reservation->remaining) {
+        error_report("Invalid Crucible fault-event reservation release");
+        abort();
+    }
+    crucible_node_event_reserved -= reservation->remaining;
+    crucible_node_event_sequence_reserved -= reservation->remaining;
+    g_free(reservation);
+}
