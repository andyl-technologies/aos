diff --git a/accel/tcg/cpu-exec.c b/accel/tcg/cpu-exec.c
index 777ccacd02c2a86ac1a933db761bce3fb676244d..55c096523e811c9b73281e212e9be85a1b4e060a 100644
--- a/accel/tcg/cpu-exec.c
+++ b/accel/tcg/cpu-exec.c
@@ -532,6 +532,8 @@ static void cpu_exec_longjmp_cleanup(CPUState *cpu)
 {
     /* Non-buggy compilers preserve this; assert the correct value. */
     g_assert(cpu == current_cpu);
+    qemu_crucible_fault_instruction_execution_complete(
+        cpu, qemu_crucible_fault_observed_icount(), true);
     qemu_crucible_fault_register_execution_complete(cpu);
     qemu_crucible_fault_memory_fetch_stage_discard(cpu);
 
@@ -575,6 +577,8 @@ void cpu_exec_step_atomic(CPUState *cpu)
     uint64_t cs_base;
     uint32_t flags, cflags;
     int tb_exit;
+    bool skip_instruction;
+    bool fault_boundary;
 
     if (sigsetjmp(cpu->jmp_env, 0) == 0) {
         start_exclusive();
@@ -583,12 +587,23 @@ void cpu_exec_step_atomic(CPUState *cpu)
         cpu->running = true;
 
         do {
-            if (unlikely(qemu_crucible_fault_register_boundaries_active())) {
+            bool before_dispatched =
+                qemu_crucible_fault_register_boundaries_active();
+
+            if (unlikely(before_dispatched)) {
                 qemu_crucible_fault_register_instruction_boundary(
                     cpu, QEMU_CRUCIBLE_MODEL_PHASE_BEFORE_INSTRUCTION,
                     qemu_crucible_fault_observed_icount());
             }
             cpu_get_tb_cpu_state(env, &pc, &cs_base, &flags);
+            fault_boundary = qemu_crucible_fault_instruction_pc_active(
+                cpu, pc);
+            if (unlikely(fault_boundary && !before_dispatched)) {
+                qemu_crucible_fault_register_instruction_boundary(
+                    cpu, QEMU_CRUCIBLE_MODEL_PHASE_BEFORE_INSTRUCTION,
+                    qemu_crucible_fault_observed_icount());
+            }
+            fault_boundary |= before_dispatched;
 
             cflags = curr_cflags(cpu);
             /* Execute in a serial context. */
@@ -611,15 +626,27 @@ void cpu_exec_step_atomic(CPUState *cpu)
             }
         } while (qemu_crucible_fault_memory_fetch_service_apply(cpu));
 
-        cpu_exec_enter(cpu);
-        if (unlikely(qemu_crucible_fault_register_boundaries_active())) {
-            qemu_crucible_fault_register_execution_begin(cpu);
+        skip_instruction =
+            unlikely(fault_boundary) &&
+            qemu_crucible_fault_instruction_prepare(
+                cpu, tb, pc, qemu_crucible_fault_observed_icount());
+        if (!skip_instruction) {
+            cpu_exec_enter(cpu);
+            if (unlikely(fault_boundary)) {
+                qemu_crucible_fault_register_execution_begin(cpu);
+            }
+            qemu_crucible_fault_instruction_execution_begin(cpu, pc);
+            /* execute the generated code */
+            trace_exec_tb(tb, pc);
+            cpu_tb_exec(cpu, tb, &tb_exit);
+            qemu_crucible_fault_instruction_execution_complete(
+                cpu, qemu_crucible_fault_observed_icount(), false);
+            qemu_crucible_fault_register_execution_complete(cpu);
+            cpu_exec_exit(cpu);
+        }
+        if (unlikely(fault_boundary)) {
+            qatomic_set_mb(&cpu->exit_request, 1);
         }
-        /* execute the generated code */
-        trace_exec_tb(tb, pc);
-        cpu_tb_exec(cpu, tb, &tb_exit);
-        qemu_crucible_fault_register_execution_complete(cpu);
-        cpu_exec_exit(cpu);
         qemu_crucible_fault_memory_service_apply(cpu);
     } else {
         cpu_exec_longjmp_cleanup(cpu);
@@ -917,17 +944,23 @@ static inline bool cpu_handle_interrupt(CPUState *cpu,
 
 static inline void cpu_loop_exec_tb(CPUState *cpu, TranslationBlock *tb,
                                     vaddr pc, TranslationBlock **last_tb,
-                                    int *tb_exit)
+                                    int *tb_exit, bool fault_boundary)
 {
     trace_exec_tb(tb, pc);
-    if (unlikely(qemu_crucible_fault_register_boundaries_active())) {
+    if (unlikely(fault_boundary)) {
         qemu_crucible_fault_register_execution_begin(cpu);
     }
+    qemu_crucible_fault_instruction_execution_begin(cpu, pc);
     tb = cpu_tb_exec(cpu, tb, tb_exit);
+    qemu_crucible_fault_instruction_execution_complete(
+        cpu, qemu_crucible_fault_observed_icount(), false);
     qemu_crucible_fault_register_execution_complete(cpu);
+    if (unlikely(fault_boundary)) {
+        qatomic_set_mb(&cpu->exit_request, 1);
+    }
     if (*tb_exit != TB_EXIT_REQUESTED) {
         *last_tb = (qemu_crucible_fault_memory_fetch_rules_active() ||
-                    qemu_crucible_fault_register_boundaries_active()) ?
+                    fault_boundary) ?
             NULL : tb;
         return;
     }
@@ -984,13 +1017,25 @@ cpu_exec_loop(CPUState *cpu, SyncClocks *sc)
             vaddr pc;
             uint64_t cs_base;
             uint32_t flags, cflags;
+            bool before_dispatched;
+            bool fault_boundary;
 
-            if (unlikely(qemu_crucible_fault_register_boundaries_active())) {
+            before_dispatched =
+                qemu_crucible_fault_register_boundaries_active();
+            if (unlikely(before_dispatched)) {
                 qemu_crucible_fault_register_instruction_boundary(
                     cpu, QEMU_CRUCIBLE_MODEL_PHASE_BEFORE_INSTRUCTION,
                     qemu_crucible_fault_observed_icount());
             }
             cpu_get_tb_cpu_state(cpu_env(cpu), &pc, &cs_base, &flags);
+            fault_boundary = qemu_crucible_fault_instruction_pc_active(
+                cpu, pc);
+            if (unlikely(fault_boundary && !before_dispatched)) {
+                qemu_crucible_fault_register_instruction_boundary(
+                    cpu, QEMU_CRUCIBLE_MODEL_PHASE_BEFORE_INSTRUCTION,
+                    qemu_crucible_fault_observed_icount());
+            }
+            fault_boundary |= before_dispatched;
 
             /*
              * When requested, use an exact setting for cflags for the next
@@ -1011,7 +1056,7 @@ cpu_exec_loop(CPUState *cpu, SyncClocks *sc)
             }
 
             if (unlikely(qemu_crucible_fault_memory_fetch_rules_active() ||
-                         qemu_crucible_fault_register_boundaries_active())) {
+                         fault_boundary)) {
                 cflags &= ~CF_COUNT_MASK;
                 cflags |= CF_NO_GOTO_TB | CF_NO_GOTO_PTR | 1;
                 last_tb = NULL;
@@ -1056,13 +1101,22 @@ cpu_exec_loop(CPUState *cpu, SyncClocks *sc)
                 last_tb = NULL;
                 continue;
             }
+            if (unlikely(fault_boundary) &&
+                qemu_crucible_fault_instruction_prepare(
+                    cpu, tb, pc, qemu_crucible_fault_observed_icount())) {
+                last_tb = NULL;
+                qatomic_set_mb(&cpu->exit_request, 1);
+                qemu_crucible_fault_memory_service_apply(cpu);
+                continue;
+            }
 
             /* See if we can patch the calling TB. */
             if (last_tb) {
                 tb_add_jump(last_tb, tb_exit, tb);
             }
 
-            cpu_loop_exec_tb(cpu, tb, pc, &last_tb, &tb_exit);
+            cpu_loop_exec_tb(
+                cpu, tb, pc, &last_tb, &tb_exit, fault_boundary);
             if (qemu_crucible_fault_memory_service_apply(cpu)) {
                 last_tb = NULL;
             }
diff --git a/accel/tcg/translator.c b/accel/tcg/translator.c
index d56305f9767bed98cf651dbc988eda0f8fc729e3..633961198315ee75a353f480bc9ebc1745ab0cc9 100644
--- a/accel/tcg/translator.c
+++ b/accel/tcg/translator.c
@@ -113,7 +113,8 @@ bool translator_is_same_page(const DisasContextBase *db, vaddr addr)
 bool translator_use_goto_tb(DisasContextBase *db, vaddr dest)
 {
     /* Suppress goto_tb if requested. */
-    if (tb_cflags(db->tb) & CF_NO_GOTO_TB) {
+    if ((tb_cflags(db->tb) & CF_NO_GOTO_TB) ||
+        db->crucible_fault_boundary_exit) {
         return false;
     }
 
@@ -154,6 +155,7 @@ void translator_loop(CPUState *cpu, TranslationBlock *tb, int *max_insns,
 
     plugin_enabled = plugin_gen_tb_start(cpu, db);
     db->plugin_enabled = plugin_enabled;
+    db->crucible_fault_boundary_exit = false;
 
     while (true) {
         *max_insns = ++db->num_insns;
@@ -232,6 +234,19 @@ void translator_loop(CPUState *cpu, TranslationBlock *tb, int *max_insns,
             plugin_gen_insn_end();
         }
 
+        if (db->is_jmp == DISAS_NEXT) {
+            bool current_fault = qemu_crucible_fault_instruction_pc_active(
+                cpu, db->crucible_fetch_start);
+            bool next_fault = qemu_crucible_fault_instruction_pc_active(
+                cpu, db->pc_next);
+
+            if (current_fault || next_fault) {
+                db->crucible_fault_boundary_exit = next_fault;
+                db->is_jmp = DISAS_TOO_MANY;
+                break;
+            }
+        }
+
         /* Stop translation if translate_insn so indicated.  */
         if (db->is_jmp != DISAS_NEXT) {
             break;
diff --git a/include/exec/translator.h b/include/exec/translator.h
