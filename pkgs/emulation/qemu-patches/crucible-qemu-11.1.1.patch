+static void check_booke_deadline(__int128 now, __int128 expected)
+{
+    CPUPPCState environment = { 0 };
+    ppc_tb_t timebase = { .tb_freq = 512000000, .tb_offset = 17 };
+    QEMUTimer *timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, NULL, NULL);
+
+    observed_ps = now;
+    environment.tb_env = &timebase;
+    environment.spr[SPR_BOOKE_TSR] = TSR_FIS;
+    if (qemu_timer_tcg_ps_enabled()) {
+        timer_mod_ps_wide(timer, 23);
+    } else {
+        timer_mod_ns(timer, 23);
+    }
+    booke_update_fixed_timer(&environment, 16, timer, TSR_FIS);
+
+    g_assert_true(timer_pending(timer));
+    if (qemu_timer_tcg_ps_enabled()) {
+        g_assert_true(timer_expire_time_ps_wide(timer) == expected);
+    } else {
+        int64_t nanoseconds;
+        uint16_t phase;
+
+        g_assert_cmpint(timer_expire_time_ns_phase(timer, &nanoseconds,
+                                                  &phase), ==, 1);
+        g_assert_true((__int128)nanoseconds * PICOSECONDS_PER_NANOSECOND +
+                      phase == expected);
+    }
+    timer_free(timer);
+}
