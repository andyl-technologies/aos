+
+static void test_restore_identity(gconstpointer data)
+{
+    unsigned int field = GPOINTER_TO_UINT(data);
+    QemuCrucibleCheckpointPlacementOwner *owner = &checkpoint_placement_owner;
+    int original_fd;
+
+    if (!fixture_enter_subprocess()) {
+        return;
+    }
+    fixture_prepare(2);
+    original_fd = owner->cancellation_fd;
+    g_assert_cmpint(qemu_crucible_checkpoint_placement_detach_v1(owner), ==, 0);
+    if (field == 0) {
+        owner->cancellation_fd++;
+    } else if (field == 1) {
+        qatomic_set(&ram_scheduled.callback, NULL);
+    } else {
+        qatomic_set(&ram_scheduled.opaque, NULL);
+    }
+
+    g_assert_cmpint(qemu_crucible_checkpoint_placement_restore_v1(owner), ==,
+                    -ESTALE);
+    g_assert_true(owner->detached);
+    g_assert_cmpuint(ram_scheduled.state, ==, 93);
+    g_assert_cmpuint(fixture_write_calls, ==, 0);
+
+    /* Correcting the fixture tuple cannot erase the real first refusal. */
+    owner->cancellation_fd = original_fd;
+    qatomic_set(&ram_scheduled.callback, fixture_callback);
+    qatomic_set(&ram_scheduled.opaque, &fixture_callback_opaque);
+    g_assert_cmpint(qemu_crucible_checkpoint_placement_restore_v1(owner), ==,
+                    -ESTALE);
+    g_assert_cmpuint(fixture_cas_calls, ==, 1);
+    fixture_assert_event_untouched();
+}
+
+static void test_wake_interruption(void)
+{
+    QemuCrucibleCheckpointPlacementOwner *owner = &checkpoint_placement_owner;
+
+    if (!fixture_enter_subprocess()) {
+        return;
+    }
+    fixture_prepare(2);
+    g_assert_cmpint(qemu_crucible_checkpoint_placement_detach_v1(owner), ==, 0);
+    fixture_write_error = EINTR;
+
+    g_assert_cmpint(qemu_crucible_checkpoint_placement_restore_v1(owner), ==,
+                    -EINTR);
+    g_assert_cmpuint(fixture_write_calls, ==, 1);
+    g_assert_cmpint(owner->post_status, ==, -EINTR);
+    g_assert_cmpint(owner->first_status, ==, -EINTR);
+    g_assert_true(owner->detached);
+    g_assert_cmpuint(ram_scheduled.state, ==, 93);
+    fixture_write_error = 0;
+    fixture_stop_generation++;
+    g_assert_cmpint(qemu_crucible_checkpoint_placement_restore_v1(owner), ==,
+                    -EINTR);
+    g_assert_cmpint(qemu_crucible_checkpoint_placement_detach_v1(owner), ==,
+                    -EINTR);
+    g_assert_cmpuint(fixture_write_calls, ==, 1);
+    g_assert_cmpuint(fixture_cas_calls, ==, 1);
+    fixture_assert_event_untouched();
+}
+
+static void test_wake_descriptor_failure(void)
+{
+    QemuCrucibleCheckpointPlacementOwner *owner = &checkpoint_placement_owner;
+
+    if (!fixture_enter_subprocess()) {
+        return;
+    }
+    fixture_prepare(2);
+    g_assert_cmpint(qemu_crucible_checkpoint_placement_detach_v1(owner), ==, 0);
+    /* Test-only invalid wake descriptor; the real cancellation owner survives. */
+    crucible_hot_fork_coordinator.wake.wfd = -1;
+
+    g_assert_cmpint(qemu_crucible_checkpoint_placement_restore_v1(owner), ==,
+                    -EBADF);
+    g_assert_cmpint(owner->first_status, ==, -EBADF);
+    g_assert_cmpint(owner->post_status, ==, -EBADF);
+    g_assert_true(owner->detached);
+    g_assert_cmpuint(fixture_write_calls, ==, 1);
+    g_assert_cmpuint(fixture_cas_calls, ==, 1);
+    fixture_assert_event_untouched();
+}
+
+static void fixture_layout(void)
+{
+#define REPORT_MEMBER(member) \
+    g_print("placement.%s=%zu/%zu\n", #member, \
+            offsetof(QemuCrucibleCheckpointPlacementOwner, member), \
+            sizeof(checkpoint_placement_owner.member))
+    g_print("placement.size=%zu alignment=%zu\n",
+            sizeof(checkpoint_placement_owner),
+            _Alignof(QemuCrucibleCheckpointPlacementOwner));
+    g_print("mailbox.size=%zu coordinator.size=%zu metadata.total=%" PRIu64 "\n",
+            sizeof(ram_scheduled), sizeof(crucible_hot_fork_coordinator),
+            qemu_crucible_ram_main_loop_metadata_bytes());
+    REPORT_MEMBER(process_id);
+    REPORT_MEMBER(owner_thread_id);
+    REPORT_MEMBER(published);
+    REPORT_MEMBER(transaction);
+    REPORT_MEMBER(stopped_generation);
+    REPORT_MEMBER(cancellation_fd);
+    REPORT_MEMBER(saved_cancellation_fd);
+    REPORT_MEMBER(saved_state);
+    REPORT_MEMBER(saved_callback);
+    REPORT_MEMBER(saved_opaque);
+    REPORT_MEMBER(first_status);
+    REPORT_MEMBER(post_status);
+    REPORT_MEMBER(detached);
+#undef REPORT_MEMBER
+}
+
+int main(int argc, char **argv)
+{
+    if (argc == 2 && !strcmp(argv[1], "--layout")) {
+        fixture_layout();
+        return 0;
+    }
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/checkpoint-placement/queued", test_queued_round_trip);
+    g_test_add_func("/checkpoint-placement/empty", test_empty_round_trip);
+    g_test_add_func("/checkpoint-placement/dispatch-gate", test_dispatch_gate);
+    g_test_add_func("/checkpoint-placement/pending", test_pending_phases);
+    g_test_add_func("/checkpoint-placement/cas-loss", test_lost_cas);
+    g_test_add_func("/checkpoint-placement/foreign",
+                    test_foreign_and_unpublished);
+    g_test_add_func("/checkpoint-placement/stopped", test_stopped_gate);
+    g_test_add_func("/checkpoint-placement/cold-bql", test_cold_and_bql_gate);
+    g_test_add_data_func("/checkpoint-placement/identity/event",
+                         GUINT_TO_POINTER(0), test_restore_identity);
+    g_test_add_data_func("/checkpoint-placement/identity/callback",
+                         GUINT_TO_POINTER(1), test_restore_identity);
+    g_test_add_data_func("/checkpoint-placement/identity/opaque",
+                         GUINT_TO_POINTER(2), test_restore_identity);
+    g_test_add_func("/checkpoint-placement/interruption",
+                    test_wake_interruption);
+    g_test_add_func("/checkpoint-placement/wake-failure",
+                    test_wake_descriptor_failure);
+    return g_test_run();
+}
