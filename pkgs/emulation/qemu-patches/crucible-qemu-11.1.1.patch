+static bool parent_park_write_progress_valid(
+    const QemuCrucibleParkReturnWriteProgress *progress, int callback_status)
+{
+    if (progress->first_status > 0 || progress->post_status > 0 ||
+        callback_status > 0 || progress->write_attempted > 1 ||
+        progress->return_published > 1 || progress->writer_released > 1 ||
+        progress->publication_uncertain > 1 ||
+        ((progress->return_published || progress->writer_released ||
+          progress->publication_uncertain) && !progress->write_attempted)) {
+        return false;
+    }
+    return progress->write_attempted ||
+        (progress->first_status < 0 && callback_status < 0);
+}
+#endif
