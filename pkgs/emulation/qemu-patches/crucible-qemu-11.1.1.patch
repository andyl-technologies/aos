+        }
+    }
+}
+
+static void assert_record_refusal(const uint8_t *wire, size_t length)
+{
+    QemuCrucibleDeviceWorkspaceWireRecord record;
+    uint8_t sentinel[sizeof(record)];
+
+    memset(&record, 0x5a, sizeof(record));
+    memcpy(sentinel, &record, sizeof(sentinel));
+    g_assert_cmpint(qemu_crucible_device_workspace_decode(
+                        wire, length, &record), <, 0);
+    g_assert_cmpmem(&record, sizeof(record), sentinel, sizeof(sentinel));
+}
+
+static void test_record_refusals(void)
+{
+    uint8_t wire[129];
+
+    fixture_record(wire, 1, 0);
+    wire[128] = 0x7b;
+    assert_record_refusal(NULL, 128);
+    assert_record_refusal(wire, 0);
+    assert_record_refusal(wire, 127);
+    assert_record_refusal(wire, 129);
+    g_assert_cmpint(qemu_crucible_device_workspace_decode(
+                        wire, 128, NULL), <, 0);
+
+    wire[0] = 'X';
+    assert_record_refusal(wire, 128);
+    fixture_record(wire, 1, 0);
+    fixture_be32(wire, 8, 2);
+    assert_record_refusal(wire, 128);
+    fixture_record(wire, 0, 0);
+    assert_record_refusal(wire, 128);
+    fixture_record(wire, 3, 0);
+    assert_record_refusal(wire, 128);
+
+    fixture_record(wire, 1, 0);
+    fixture_be64(wire, 120, 65535);
+    assert_record_refusal(wire, 128);
+    fixture_be64(wire, 120, 65537);
+    assert_record_refusal(wire, 128);
+}
+
+static void fixture_startup(uint8_t *wire, uint64_t device,
+                            uint32_t descriptor)
+{
+    memset(wire, 0, 128);
+    memcpy(wire, "CRUCSTP1", 8);
+    fixture_be32(wire, 8, 2);
+    fixture_be32(wire, 12, 128);
+    for (size_t index = 0; index < 32; index++) {
+        wire[16 + index] = 0xb0 + index;
+    }
+
+    fixture_be64(wire, 48, FIXTURE_TOTAL);
+    fixture_be64(wire, 56, FIXTURE_METADATA);
+    fixture_be64(wire, 64, FIXTURE_RESIDENT);
+    fixture_be64(wire, 72, 77);
+    fixture_be64(wire, 80, FIXTURE_PROCESS);
+    fixture_be64(wire, 88, device);
+    fixture_be64(wire, 96, FIXTURE_INODE);
+    fixture_be32(wire, 104, descriptor);
+    fixture_be32(wire, 108, 1);
+    fixture_be64(wire, 112, FIXTURE_ACCOUNT);
+    fixture_be64(wire, 120, FIXTURE_TOTAL);
+}
+
+static void assert_startup(const QemuCrucibleOriginalStartupWireRecord *record,
+                           uint64_t device, uint32_t descriptor)
+{
+    g_assert_cmpuint(record->schema_version, ==, 2);
+    g_assert_cmpuint(record->record_bytes, ==, 128);
