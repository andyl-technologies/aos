+    assert(advance_receiver_protocol_post(&receiver, &native_post, &recipient_post,
+                                          &cohort_post, &final) == -EPERM);
+    assert(native_calls == 1 && recipient_calls == 2 && identity_calls == 1);
+    assert(native_post == -EPERM && recipient_post == -ENOKEY);
