+        compiled = subprocess.run(command, capture_output=True, text=True)
+        (output / f"{name}.compile.log").write_text(compiled.stdout + compiled.stderr)
+        compiled.check_returncode()
+        result = subprocess.run([str(binary)], cwd=output, capture_output=True,
+                                text=True, timeout=30)
+        (output / f"{name}.run.log").write_text(result.stdout + result.stderr)
+        if name == "positive":
+            assert result.returncode == 0, result.stderr
+        elif result.returncode != -6 or "Assertion" not in result.stderr or expected not in result.stderr:
+            raise RuntimeError(f"{name}: unexpected result {result.returncode}: {result.stderr}")
+        results[name] = {"returncode": result.returncode,
+                         "stdout": result.stdout, "stderr": result.stderr}
+    (output / "results.json").write_text(json.dumps(results, indent=2) + "\n")
+    print(f"PASS ordinary read/refusal component and {len(omissions)} independent omissions; no selected child")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/unit/test-crucible-interrupt-catalogue.py b/tests/unit/test-crucible-interrupt-catalogue.py
new file mode 100644
index 0000000000000000000000000000000000000000..8d6c941a32835d17e8c53ace624bf9bb644dba88
--- /dev/null
+++ b/tests/unit/test-crucible-interrupt-catalogue.py
@@ -0,0 +1,247 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Exercise literal interrupt rows, actual family registration and typed bounds.
+
+CPU/cohort and realized device evidence are component inputs. They do not issue
+Source constructor ownership, fund producer allocations or qualify activation.
+"""
+
+import argparse
+import json
+import os
+from pathlib import Path
+import runpy
+import shlex
+import subprocess
+
+
+INPUTS = r"""
+static CPUState input_cpus[CRUCIBLE_INTERRUPT_CPU_CAPACITY + 1];
+static CPUClass input_class;
+static bool selected, present;
+CPUTailQ cpus_queue = QTAILQ_HEAD_INITIALIZER(cpus_queue);
+
+static CPUState *input_lookup(int index)
+{
+    assert(index == 0);
+    return present ? &input_cpus[0] : NULL;
+}
+
+#undef CPU_GET_CLASS
+#define CPU_GET_CLASS(cpu) (&input_class)
+#define qemu_get_cpu input_lookup
+#define qemu_plugin_crucible_startup_source_retained() selected
+"""
+
+CHECKS = r"""
+static void reset(uint16_t architecture, size_t cpus)
+{
+    for (size_t family = 0; family < G_N_ELEMENTS(crucible_interrupt_realized); family++) {
+        g_free(crucible_interrupt_realized[family].controller_version);
+    }
+    memset(crucible_interrupt_realized, 0, sizeof(crucible_interrupt_realized));
+    memset(&crucible_interrupt_catalogue, 0, sizeof(crucible_interrupt_catalogue));
+    crucible_interrupt_bindings_sealed = false;
+    selected = false;
+    present = true;
+    input_class.crucible_register_scope = architecture;
+    QTAILQ_INIT(&cpus_queue);
+    assert(cpus <= G_N_ELEMENTS(input_cpus));
+    for (size_t index = 0; index < cpus; index++) {
+        input_cpus[index].cpu_index = cpus - index - 1;
+        QTAILQ_INSERT_TAIL(&cpus_queue, &input_cpus[index], node);
+    }
+}
+
+static void register_families(void)
+{
+    for (size_t family = 1; family < G_N_ELEMENTS(crucible_interrupt_realized); family++) {
+        assert(qemu_crucible_fault_interrupt_register_family(
+            family, UINT64_C(1) << family, "realized-controller-v1", 16777215, 4096));
+    }
+}
+
+static void check_architecture(uint16_t architecture, size_t cpus, size_t expected)
+{
+    CrucibleInterruptCapability rows[CRUCIBLE_INTERRUPT_MANIFEST_CAPACITY] = { 0 };
+    uint16_t observed = 0;
+
+    reset(architecture, cpus);
+    register_families();
+    assert(crucible_fault_interrupt_manifest_body(rows, G_N_ELEMENTS(rows), &observed) == expected);
+    assert(observed == architecture);
+    assert(crucible_interrupt_catalogue.initialized);
+    assert(!crucible_interrupt_catalogue.overflow);
+    assert(crucible_interrupt_catalogue.target_count == cpus);
+    for (size_t index = 0; index < cpus; index++) {
+        assert(crucible_interrupt_catalogue.targets[index] == index);
+    }
+    assert(crucible_fault_interrupt_bindings_seal_body() == -EINVAL);
+    for (size_t index = 0; index < expected; index++) {
+        const CrucibleInterruptCapability *row = &rows[index];
+        const CrucibleInterruptRealizedFamily *realized = &crucible_interrupt_realized[row->family];
+        uint8_t id[32] = { index + 1 };
+
+        assert(row->controller_version == realized->controller_version);
+        assert(row->model_phase_mask == realized->model_phase_mask);
+        assert(row->vector_end <= realized->vector_end);
+        assert(row->vector_start <= row->vector_end);
+        if (row->family == QEMU_CRUCIBLE_INTERRUPT_X86_PIC) {
+            assert(row->target_vcpu_count == 1);
+            assert(row->target_vcpus == &crucible_interrupt_catalogue.boot_target);
+        } else {
+            assert(row->target_vcpu_count == cpus);
+            assert(row->target_vcpus == crucible_interrupt_catalogue.targets);
+        }
+        assert(crucible_fault_interrupt_bind_body(index, id, id, id) == 0);
+        assert(crucible_fault_interrupt_bind_body(index, id, id, id) == -EEXIST);
+    }
+    uint8_t id[32] = { 1 };
+    assert(crucible_fault_interrupt_bind_body(expected, id, id, id) == -EINVAL);
+    assert(crucible_fault_interrupt_bindings_seal_body() == 0);
+    assert(crucible_fault_interrupt_bindings_seal_body() == -EINVAL);
+
+    CrucibleInterruptCatalogue before = crucible_interrupt_catalogue;
+    selected = true;
+    observed = UINT16_MAX;
+    assert(crucible_fault_interrupt_manifest_body(NULL, 0, &observed) == 0);
+    assert(observed == UINT16_MAX);
+    assert(memcmp(&before, &crucible_interrupt_catalogue, sizeof(before)) == 0);
+}
+
+int main(void)
+{
+    uint16_t observed = UINT16_MAX;
+
+    reset(CRUCIBLE_INTERRUPT_SCOPE_X86_64, 1);
+    assert(!qemu_crucible_fault_interrupt_register_family(0, 1, "v1", 255, 1));
+    assert(!qemu_crucible_fault_interrupt_register_family(3, 0, "v1", 255, 1));
+    assert(!qemu_crucible_fault_interrupt_register_family(3, 1, "v1", 255, 0));
+    assert(crucible_fault_interrupt_manifest_body(NULL, 0, &observed) == 0);
+    assert(observed == UINT16_MAX);
+    assert(crucible_fault_interrupt_manifest_body(NULL, 0, &observed) == 0);
+    assert(!crucible_interrupt_catalogue.count);
+
+    reset(CRUCIBLE_INTERRUPT_SCOPE_X86_64, 2);
+    assert(qemu_crucible_fault_interrupt_register_family(3, 1, "ioapic-v1", 15, 2));
+    assert(!crucible_interrupt_manifest_init());
+    assert(!crucible_interrupt_catalogue.count);
+    reset(CRUCIBLE_INTERRUPT_SCOPE_X86_64, 2);
+    assert(qemu_crucible_fault_interrupt_register_family(3, 1, "ioapic-v1", 31, 1));
+    assert(crucible_interrupt_manifest_init());
+    assert(crucible_interrupt_catalogue.count == 4);
+    for (size_t index = 0; index < 4; index++) {
+        assert(crucible_interrupt_catalogue.rows[index].vector_end == 31);
+        assert(crucible_interrupt_catalogue.rows[index].target_vcpu_count == 1);
+    }
+
+    reset(CRUCIBLE_INTERRUPT_SCOPE_AARCH64, 1);
+    assert(qemu_crucible_fault_interrupt_register_family(12, 1, "its-v1", 255, 1));
+    assert(!crucible_interrupt_manifest_init());
+    assert(!crucible_interrupt_catalogue.count);
+    reset(CRUCIBLE_INTERRUPT_SCOPE_AARCH64, 1);
+    assert(qemu_crucible_fault_interrupt_register_family(12, 1, "its-v1", 8192, 1));
+    assert(crucible_interrupt_manifest_init());
+    assert(crucible_interrupt_catalogue.count == 1);
+    assert(crucible_interrupt_catalogue.rows[0].vector_end == 8192);
+
+    check_architecture(CRUCIBLE_INTERRUPT_SCOPE_X86_64, 1, 13);
+    check_architecture(CRUCIBLE_INTERRUPT_SCOPE_X86_64, 4096, 13);
+    check_architecture(CRUCIBLE_INTERRUPT_SCOPE_AARCH64, 3, 8);
+    selected = false;
+
+    reset(CRUCIBLE_INTERRUPT_SCOPE_X86_64, 4097);
+    register_families();
+    assert(!crucible_interrupt_manifest_init());
+    assert(crucible_interrupt_catalogue.overflow);
+    assert(!crucible_interrupt_catalogue.initialized);
+    assert(!crucible_interrupt_catalogue.count);
+    assert(!crucible_interrupt_catalogue.target_count);
+    assert(!crucible_interrupt_manifest_init());
+
+    reset(CRUCIBLE_INTERRUPT_SCOPE_X86_64, 1);
+    register_families();
+    assert(crucible_interrupt_manifest_init());
+    CrucibleInterruptCatalogue before = crucible_interrupt_catalogue;
+    CrucibleInterruptCapability extra = { .id = "overflow" };
+    assert(!crucible_interrupt_catalogue_append(&extra));
+    assert(crucible_interrupt_catalogue.overflow);
+    assert(crucible_interrupt_catalogue.count == 13);
+    assert(memcmp(before.rows, crucible_interrupt_catalogue.rows, sizeof(before.rows)) == 0);
+    observed = UINT16_MAX;
+    assert(crucible_fault_interrupt_manifest_body(NULL, 0, &observed) == 0);
+    assert(observed == UINT16_MAX);
+    assert(crucible_fault_interrupt_bindings_seal_body() == -EINVAL);
+    assert(qemu_crucible_fault_interrupt_catalogue_fixed_storage_bytes_v1() ==
+           sizeof(crucible_interrupt_catalogue));
+    puts("PASS literal interrupt typed catalogue, realized evidence, bindings and sticky bounds; no lifecycle authority");
+    return 0;
+}
+"""
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--source-root", type=Path,
+                        default=Path(__file__).resolve().parents[2])
+    parser.add_argument("--output-dir", type=Path, required=True)
+    arguments = parser.parse_args()
+    source = arguments.source_root.resolve()
+    output = arguments.output_dir.resolve()
+    output.mkdir(parents=True, exist_ok=True)
+
+    extract = runpy.run_path(str(source / "tests/unit/extract-crucible-startup-source-controls.py"))
+    body = (source / "plugins/crucible-fault-interrupt.c").read_text()
+    literal = body[body.index("#define CRUCIBLE_INTERRUPT_SCOPE_X86_64"):
+                   body.index("bool qemu_crucible_fault_interrupt_register_family(")]
+    for signature in (
+        "bool qemu_crucible_fault_interrupt_register_family(",
+        "static int crucible_interrupt_target_compare(",
+        "static bool crucible_interrupt_manifest_init(",
+        "static size_t crucible_fault_interrupt_manifest_body(",
+        "static int crucible_fault_interrupt_bind_body(",
+        "static int crucible_fault_interrupt_bindings_seal_body(",
+    ):
+        literal += "\n\n" + extract["function"](body, signature)
+    # Keep the input cohort one CPU beyond the independently checked public
+    # bound. Its macros do not replace any catalogue logic.
+    split = literal.index("typedef struct qemu_plugin_crucible_fault_interrupt_capability")
+    inputs = INPUTS.replace("CRUCIBLE_INTERRUPT_CPU_CAPACITY + 1", "4097")
+    literal = literal[:split] + inputs + literal[split:]
+    variants = {
+        "positive": literal,
+        "permit-selected-lazy-birth": literal.replace(
+            "if (qemu_plugin_crucible_startup_source_retained())", "if (false)"),
+        "permit-overflow-publication": literal.replace(
+            "if (crucible_interrupt_catalogue.overflow)", "if (false)"),
+        "omit-realized-controller": literal.replace(
+            "if (!realized->controller_version)", "if (false)"),
+    }
+    proof = {}
+    for name, definitions in variants.items():
+        if name != "positive" and definitions == literal:
+            raise ValueError(f"negative control did not change the literal builder: {name}")
+        generated = output / f"{name}.c"
+        generated.write_text('#include "qemu/osdep.h"\n#include <assert.h>\n'
+                             '#include "hw/core/cpu.h"\n#include "qemu/crucible-fault.h"\n' +
+                             definitions + CHECKS)
+        binary = output / name
+        command = [*shlex.split(os.environ.get("CC", "cc")),
+                   *shlex.split(os.environ.get("CFLAGS", "")),
+                   str(generated), "-o", str(binary),
+                   *shlex.split(os.environ.get("LDFLAGS", ""))]
+        (output / f"{name}.compile-command.json").write_text(json.dumps(command, indent=2) + "\n")
+        subprocess.run(command, check=True)
+        result = subprocess.run([str(binary)], text=True, stdout=subprocess.PIPE,
+                                stderr=subprocess.STDOUT, timeout=30, cwd=output)
+        (output / f"{name}.log").write_text(result.stdout)
+        expected = 0 if name == "positive" else -6
+        if result.returncode != expected:
+            raise RuntimeError(f"unexpected {name} outcome: {result.returncode}\n{result.stdout}")
+        proof[name] = {"returncode": result.returncode, "output": result.stdout}
+    (output / "proof.json").write_text(json.dumps(proof, indent=2) + "\n")
+    print(proof["positive"]["output"], end="")
+    print("PASS selected-birth, overflow-publication and realized-evidence omissions reached assertions")
+
+
+if __name__ == "__main__":
+    main()
