+int qobject_input_visitor_new_source(QObject *root, Visitor **out)
+{
+    QemuCrucibleQmpAllocationOwner *owner;
+    QemuCrucibleQmpAllocationOwner *root_owner;
+    QObjectInputVisitor *qiv;
+    unsigned kind;
+    void *body = NULL;
+    int status;
+
+    if (!root || !out || *out) {
+        return -EINVAL;
+    }
+    status = qemu_crucible_qmp_scope_identity_current(&owner);
+    if (!status) {
+        status = qobject_source_graph_current(root);
+    }
+    if (!status && root != QOBJECT(&qnull_)) {
+        status = qemu_crucible_qmp_object_observe(root, &kind, &root_owner);
+        if (!status && root_owner != owner) {
+            status = -EXDEV;
+        }
+    }
+    if (!status) {
+        status = qemu_crucible_qmp_visitor_allocate(
+            QEMU_CRUCIBLE_QMP_VISITOR_INPUT, &body);
+    }
+    if (body) {
+        qiv = body;
+        qobject_input_visitor_init(qiv);
+        qiv->source = true;
+        qiv->source_owner = owner;
+        qiv->source_status = status;
+        qiv->visitor.compat_policy = compat_policy;
+        qiv->visitor.type_int64 = qobject_input_type_int64;
+        qiv->visitor.type_uint64 = qobject_input_type_uint64;
+        qiv->visitor.type_bool = qobject_input_type_bool;
+        qiv->visitor.type_str = qobject_input_type_str;
+        qiv->visitor.type_number = qobject_input_type_number;
+        qiv->visitor.type_any = qobject_input_type_any;
+        qiv->visitor.type_null = qobject_input_type_null;
+        *out = &qiv->visitor;
+    }
+    if (status) {
+        return status;
+    }
+    qiv = body;
+    qiv->root = qobject_ref(root);
+    /* Cleanup storage is admitted before conversion can publish arguments or
+     * invoke a handler. Later physical cleanup uses this exact retained body. */
+    status = qapi_dealloc_visitor_new_source(&qiv->source_dealloc);
+    input_source_result(qiv, status);
+    return status;
+}
+
+int qapi_source_input_dealloc_borrow(Visitor *input, Visitor **out)
+{
+    QObjectInputVisitor *qiv;
+    int status;
+
+    if (!out || *out) {
+        return -EINVAL;
+    }
+    status = input_source_identity(input);
+    if (status) {
+        return status;
+    }
+    qiv = to_qiv(input);
+    if (!qiv->source_dealloc) {
+        return -ENOKEY;
+    }
+    if (qiv->source_dealloc_borrowed) {
+        return -EBUSY;
+    }
+    qiv->source_dealloc_borrowed = true;
+    *out = qiv->source_dealloc;
+    return 0;
+}
