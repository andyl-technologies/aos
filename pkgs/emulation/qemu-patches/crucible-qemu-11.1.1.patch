+    if (status) {
+        return status;
+    }
+    if (!out || !requested || requested > worker->workspace->request_bytes ||
+        requested > SSIZE_MAX ||
+        callback_child_output_overlap(out, sizeof(*out), &startup_source, sizeof(startup_source)) ||
+        callback_child_output_overlap(out, sizeof(*out), reference, sizeof(*reference)) ||
+        callback_child_output_overlap(out, sizeof(*out), worker->workspace->address,
+                                      worker->workspace->request_bytes)) {
+        return -EINVAL;
+    }
