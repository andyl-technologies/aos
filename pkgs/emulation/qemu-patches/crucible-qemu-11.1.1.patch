+_Static_assert(QEMU_CRUCIBLE_PROCESS_PURPOSE_ROLES_OFFSET +
+               QEMU_CRUCIBLE_PROCESS_PURPOSE_ROLE_COUNT *
+               QEMU_CRUCIBLE_PROCESS_PURPOSE_ROLE_BYTES ==
+               QEMU_CRUCIBLE_PROCESS_PURPOSE_LOCAL_EXTENT_OFFSET,
+               "canonical rows end before local subdivision");
+_Static_assert(QEMU_CRUCIBLE_PROCESS_FAMILY_OFFSET +
+               QEMU_CRUCIBLE_PROCESS_FAMILY_BYTES == 1000,
+               "family ends before standing descriptor witnesses");
+_Static_assert(1024 + QEMU_CRUCIBLE_STANDING_PAYLOAD_BYTES ==
+               QEMU_CRUCIBLE_PROCESS_PURPOSE_BYTES,
+               "standing payload closes exact record");
