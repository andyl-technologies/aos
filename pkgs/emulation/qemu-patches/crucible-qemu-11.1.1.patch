+    path = root / "tests/unit/test-crucible-memory-service-ticket.py"
+    spec = importlib.util.spec_from_file_location("ticket_fixture", path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def source_cuts(source, fixture):
+    fetch_start = source.index("            if (cpu->crucible_fetch_service_ticks &&")
+    fetch = fixture.definition(source, fetch_start)
+    skipped_start = source.index("                if (cpu->crucible_memory_service_ticks) {")
+    skipped = fixture.definition(source, skipped_start)
+    post_start = source.index("            if (cpu->crucible_memory_service_ticks &&")
+    post = fixture.definition(source, post_start)
+    assert fetch.count("qemu_crucible_fault_memory_fetch_service_apply(cpu)") == 1
+    assert skipped.count("qemu_crucible_fault_memory_service_apply(cpu)") == 1
+    assert post.count("qemu_crucible_fault_memory_service_apply(cpu)") == 1
+    assert source.count("qemu_crucible_fault_memory_fetch_service_apply(cpu)") == 2
+    assert source.count("qemu_crucible_fault_memory_service_apply(cpu)") == 3
+    return fetch, skipped, post
+
+
+SUPPORT = r"""
+static uint64_t virtual_tick;
+static unsigned advances, fetch_calls, memory_calls;
+static bool rule_linked;
+static CPUState *current_cpu = &only_cpu;
+static struct { bool streaming; uint32_t actor; } crucible_memory_transaction;
+
+static bool icount_crucible_advance_virtual_time_by_ticks(uint64_t delay)
+{
+    if (delay > UINT64_MAX - virtual_tick) {
+        return false;
+    }
+    virtual_tick += delay;
+    advances++;
+    return true;
+}
+
+static CPUState *qemu_get_cpu(uint32_t actor)
+{
+    return actor == only_cpu.cpu_index ? &only_cpu : NULL;
+}
+
+#define qatomic_set_mb(pointer, value) (*(pointer) = (value))
