+    bool have_overlay_stat = false;
+    bool have_read = false;
+    bool have_write = false;
+
+    QLIST_FOREACH(original, &fdset->fds, next) {
+        struct stat current_stat;
+        int flags = fcntl(original->fd, F_GETFL);
+
+        if (!original->opaque || flags < 0 || !(flags & O_DIRECT) ||
+            fstat(original->fd, &current_stat) < 0 ||
+            !S_ISREG(current_stat.st_mode)) {
+            goto invalid;
+        }
+        if (strcmp(original->opaque, "crucible-root-overlay-read") == 0 &&
+            (flags & O_ACCMODE) == O_RDONLY && !have_read) {
+            have_read = true;
+        } else if (strcmp(original->opaque,
+                          "crucible-root-overlay-write") == 0 &&
