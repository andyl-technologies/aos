+static QIOChannelBuffer *save_chipset(rc4030State *chipset)
+{
+    QIOChannelBuffer *output = qio_channel_buffer_new(256);
+    QIOChannelBuffer *input;
+    QEMUFile *file = qemu_file_new_output(QIO_CHANNEL(output));
+    Error *error = NULL;
+
+    g_assert_cmpint(vmstate_save_state(file, &vmstate_rc4030, chipset, NULL,
+                                      &error), ==, 0);
+    g_assert_null(error);
+    qemu_put_byte(file, 0);
+    qemu_fflush(file);
+    input = qio_channel_buffer_new(output->usage);
+    input->usage = output->usage;
+    memcpy(input->data, output->data, output->usage);
+    qemu_fclose(file);
+    object_unref(OBJECT(output));
+    return input;
+}
