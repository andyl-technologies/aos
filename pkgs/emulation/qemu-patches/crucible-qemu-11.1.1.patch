+static void fingerprint_retirement_history(int first, int post)
+{
+    if (logical_physical_debt.pending) {
+        if (first && !logical_physical_debt.first_status) {
+            logical_physical_debt.first_status = first;
+        }
+        if (post && !logical_physical_debt.post_status) {
+            logical_physical_debt.post_status = post;
+        }
+    }
+    if (!candidate_fingerprint_deferred.rearm_deferred) {
+        return;
+    }
+    if (first && !candidate_fingerprint_deferred.first_status) {
+        candidate_fingerprint_deferred.first_status = first;
+    }
+    if (post && !candidate_fingerprint_deferred.post_status) {
+        candidate_fingerprint_deferred.post_status = post;
+    }
