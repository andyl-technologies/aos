+    .name = "timer",
+    .load = load_timer_ns_floor,
+    .save = save_timer_ns_floor,
+};
+
+/*
+ * Legacy eight-byte timer fields need an ns-horizon projection before an
+ * exact owner subsection can restore the authoritative deadline.  Ceil each
+ * representable projection so an older reader cannot observe an early expiry.
+ * Active deadlines that would encode as the -1 sentinel project to zero
+ * instead.  At the positive horizon, the base necessarily saturates up to
+ * 999ps early; the required exact subsection restores the phase before a
+ * current reader can run the timer.
+ */
+static bool load_timer_ns_projection(QEMUFile *f, void *pv, size_t size,
+                                     const VMStateField *field, Error **errp)
+{
+    QEMUTimer *timer = pv;
+    int64_t expiry_ns = qemu_get_sbe64(f);
+
+    if (expiry_ns == -1) {
+        timer_del(timer);
+    } else if (!timer_mod_ns_phase(timer, expiry_ns, 0)) {
+        error_setg(errp, "timer projection cannot be restored");
+        return false;
+    }
+    return true;
+}
+
+static bool save_timer_ns_projection(QEMUFile *f, void *pv, size_t size,
+                                     const VMStateField *field,
+                                     JSONWriter *vmdesc, Error **errp)
+{
+    QEMUTimer *timer = pv;
+    uint16_t phase_ps;
+    int64_t expiry_ns;
+    int status;
+
+    status = timer_expire_time_ns_phase(timer, &expiry_ns, &phase_ps);
+    if (status < 0) {
+        error_setg(errp, "timer projection exceeds the nanosecond horizon");
+        return false;
+    }
+    if (!status) {
+        qemu_put_sbe64(f, -1);
+        return true;
+    }
+
+    if (phase_ps && expiry_ns != INT64_MAX) {
+        expiry_ns++;
+    }
+    if (expiry_ns == -1) {
+        expiry_ns = 0;
+    }
+    qemu_put_sbe64(f, expiry_ns);
+    return true;
+}
