+static bool rr_crucible_sim_complete_wake_boundary(void)
+{
+    while (true) {
+        RRCrucibleSimWakeConsumeResult result;
+        RRCrucibleSimWakeSnapshot snapshot = { 0 };
+
+        if (!rr_crucible_sim_wake_consume_snapshot(
+                &rr_tcg_exec_state, &rr_wake_publish_generation,
+                rr_wake_consumed_generation, &snapshot)) {
+            cpu_relax();
+            continue;
+        }
+        if (snapshot.publication_pending) {
+            /*
+             * Observe every work FIFO after the producer's release
+             * publication and before acknowledging that generation. A
+             * producer racing this drain either changes the generation before
+             * collapse or claims the state that collapse must compare.
+             */
+            rr_crucible_sim_drain_vcpu_work();
+        }
+        result = rr_crucible_sim_wake_try_collapse(
+            &rr_tcg_exec_state, &rr_wake_publish_generation,
+            &rr_wake_consumed_generation, &snapshot);
+
+        if (result != RR_TCG_WAKE_CONSUME_RETRY) {
+            return rr_crucible_sim_dispatch_wait_requires_rescan(result);
+        }
+        cpu_relax();
+    }
+}
+
+/*
+ * Arm the level-triggered RR event before the final durable predicate scan.
+ * qemu_cpu_kick() broadcasts halt_cond before its RR hook publishes the wake
+ * generation, so a condition-variable wait here could miss that producer.
+ * The hook sets this event after publication, closing both sides of the race.
+ */
+static void rr_crucible_sim_prepark(
+    bool awaiting_time_advance_completion,
+    bool awaiting_control_boundary_completion)
+{
+    bool replay_was_owned = rr_replay_mutex_owned;
+    bool control_pending;
+    bool lifecycle_pending;
+    bool time_advance_pending;
+    bool wake_pending;
+    bool work_pending;
+
+    qemu_event_reset(&rr_dispatch_ceiling_event);
+    wake_pending = rr_crucible_sim_complete_wake_boundary();
+    control_pending = qemu_plugin_crucible_rr_control_boundary_pending();
+    lifecycle_pending = qemu_force_shutdown_requested() ||
+                        !runstate_is_running() ||
+                        rr_crucible_sim_stop_or_unplug_pending() ||
+                        qemu_plugin_crucible_vmstop_pending();
+    work_pending = rr_crucible_sim_vcpu_work_pending();
+    time_advance_pending = qemu_plugin_time_advance_is_pending();
+    if (rr_crucible_sim_prepark_requires_rescan(
+            wake_pending, control_pending, lifecycle_pending, work_pending,
+            time_advance_pending, awaiting_time_advance_completion,
+            awaiting_control_boundary_completion)) {
+        return;
+    }
+
+    rr_replay_mutex_unlock();
+    bql_unlock();
+    qemu_event_wait(&rr_dispatch_ceiling_event);
+    /* Preserve each caller's entry state across the unlocked park. */
+    if (replay_was_owned) {
+        rr_replay_mutex_lock();
+    }
+    bql_lock();
+}
+
+static void rr_crucible_sim_wait_at_dispatch_ceiling(void)
+{
+    bool replay_was_owned = rr_replay_mutex_owned;
+    bool wait_traced = false;
+
+    g_assert(!rr_crucible_sim_quantum_dispatch_fence() || replay_was_owned);
+
+    while (true) {
+        bool external_work_pending;
+
+        /* Reset before testing the durable predicates to close set-before-wait. */
+        qemu_event_reset(&rr_dispatch_ceiling_event);
+        if (qemu_force_shutdown_requested()) {
+            /* Terminal shutdown releases the scheduler token immediately. */
+            return;
+        }
+        external_work_pending =
+            rr_crucible_sim_external_main_loop_work_pending();
+        if (external_work_pending ||
+            rr_crucible_sim_wake_boundary_pending()) {
+            /*
+             * Admit one pass before consuming the boundary wake. Host polling
+             * may publish readiness before or after the wake producer runs,
+             * but that timing cannot change which pass precedes guest resume.
+             */
+            if (!external_work_pending) {
+                aio_notify(qemu_get_aio_context());
+            }
+            rr_crucible_sim_handoff_main_loop();
+            if (rr_crucible_sim_complete_wake_boundary()) {
+                return;
+            }
+            continue;
+        }
+        if (qemu_plugin_crucible_rr_control_boundary_pending() ||
+            qemu_force_shutdown_requested() ||
+            !runstate_is_running() ||
+            rr_crucible_sim_stop_or_unplug_pending() ||
+            qemu_plugin_crucible_vmstop_pending() ||
+            qemu_plugin_time_advance_is_pending()) {
+            return;
+        }
+        if (rr_crucible_sim_vcpu_work_pending()) {
+            rr_crucible_sim_drain_vcpu_work();
+            continue;
+        }
+
+        if (!wait_traced) {
+            trace_crucible_sim_rr_dispatch_ceiling_wait(
+                qemu_get_thread_id(), &rr_dispatch_ceiling_event.value,
+                sizeof(rr_dispatch_ceiling_event.value));
+            wait_traced = true;
+        }
+        /* Let the main loop service the eventfd and publish the wake predicate. */
+        rr_replay_mutex_unlock();
+        bql_unlock();
+        qemu_event_wait(&rr_dispatch_ceiling_event);
+        /* Queue before BQL so the completed pass cannot lap the RR thread. */
+        if (replay_was_owned) {
+            rr_replay_mutex_lock();
+        }
+        bql_lock();
+    }
+}
+
+static void rr_crucible_sim_acknowledge_control_boundary(void)
+{
+    g_assert(bql_locked());
+    g_assert(qatomic_read(&rr_tcg_exec_state) == RR_TCG_EXEC_IDLE);
+    /*
+     * The scheduling token is installed before this wait. The completion BH
+     * either authenticates the exact boundary or cancels it for a lifecycle
+     * transition, then publishes completion before its sole release wake.
+     */
+    while (qemu_plugin_crucible_rr_control_boundary_pending()) {
+        if (qemu_plugin_time_advance_settle_is_pending()) {
+            /* The outer loop finalizes the advance from its idle boundary. */
+            return;
+        }
+        if (!runstate_is_running() ||
+            rr_crucible_sim_stop_or_unplug_pending() ||
+            qemu_plugin_crucible_vmstop_pending()) {
+            rr_crucible_sim_complete_wake_boundary();
+            qemu_plugin_crucible_rr_control_boundary_cancel();
+            return;
+        }
+        qemu_plugin_crucible_rr_control_boundary_acknowledge();
+        if (qemu_plugin_time_advance_is_pending()) {
+            /*
+             * The control BH relinquishes its token until the time-advance
+             * FIFO marker rearms it. Ignore those two requests while parked,
+             * but retain the durable wake/work/lifecycle scan.
+             */
+            rr_crucible_sim_prepark(true, true);
+            rr_crucible_sim_drain_vcpu_work();
+        } else {
+            qemu_cond_wait_bql(first_cpu->halt_cond);
+        }
+        rr_crucible_sim_complete_wake_boundary();
+        g_assert(qatomic_read(&rr_tcg_exec_state) == RR_TCG_EXEC_IDLE);
+    }
+}
+
+static void rr_crucible_sim_complete_initial_wait(void)
+{
+    while (true) {
+        unsigned int state = qatomic_read(&rr_tcg_exec_state);
+
+        if (state == RR_TCG_EXEC_STARTING_WAKE_ARMING) {
+            cpu_relax();
+            continue;
+        }
+        if (state == RR_TCG_EXEC_STARTING &&
+            qatomic_cmpxchg(&rr_tcg_exec_state,
+                            RR_TCG_EXEC_STARTING,
+                            RR_TCG_EXEC_IDLE) == RR_TCG_EXEC_STARTING) {
+            return;
+        }
+    }
+}
+
+static bool rr_crucible_sim_prepare_tcg(void)
+{
+    while (true) {
+        unsigned int state = qatomic_read(&rr_tcg_exec_state);
+
+        if (state == RR_TCG_EXEC_IDLE) {
+            if (qatomic_cmpxchg(&rr_tcg_exec_state,
+                                RR_TCG_EXEC_IDLE,
+                                RR_TCG_EXEC_ACTIVE) != RR_TCG_EXEC_IDLE) {
+                continue;
+            }
+            return false;
+        }
+        if (state == RR_TCG_EXEC_ACTIVE) {
+            return false;
+        }
+        if (state == RR_TCG_EXEC_STARTING ||
+            rr_crucible_sim_wake_state_is_arming(state)) {
+            cpu_relax();
+            continue;
+        }
+        /* Active wakes remain pending across every partial RR slice. */
+        if (state == RR_TCG_EXEC_ACTIVE_WAKE_PENDING &&
+            icount_crucible_rr_cursor_position() != 0) {
+            return false;
+        }
+        if (qatomic_cmpxchg(&rr_tcg_exec_state, state,
+                            RR_TCG_EXEC_IDLE) == state) {
+            return true;
+        }
+    }
+}
 
 /* Kick all RR vCPUs */
+void rr_crucible_sim_notify_dispatch_ceiling(void)
+{
+    if (qatomic_load_acquire(&rr_dispatch_ceiling_event_initialized)) {
+        qemu_event_set(&rr_dispatch_ceiling_event);
+    }
+}
