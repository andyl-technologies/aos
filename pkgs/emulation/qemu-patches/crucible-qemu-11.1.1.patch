+{
+    g_assert_true(userdata == &actual_child);
+    borrow_returns++;
+    *locally_returned = 0;
+    if (qemu_mutex_trylock(&actual_child.journal)) {
+        return -EBUSY;
+    }
+    if (!actual_child.owned || actual_child.process != getpid() ||
+        actual_child.holder != payload_holder || *payload_holder != &actual_child.pending ||
+        payload_serial != actual_child.serial || !actual_child.borrow_held ||
+        !qemu_thread_is_self(&actual_child.borrow_thread) ||
+        actual_child.borrow_holder != holder || *holder != &actual_child.borrow_record ||
+        !actual_child.borrow_serial_holder ||
+        *actual_child.borrow_serial_holder != serial || serial != actual_child.borrow_counter) {
+        qemu_mutex_unlock(&actual_child.journal);
+        return -ESTALE;
+    }
+    if (borrow_mode == 5) {
+        qemu_mutex_unlock(&actual_child.journal);
+        return -EBUSY;
+    }
+    if (borrow_mode == 7) {
+        *locally_returned = 1; /* A scalar cannot conceal retained real fields. */
+        qemu_mutex_unlock(&actual_child.journal);
+        return -EIO;
+    }
+    actual_child.borrow_held = false;
+    *holder = NULL;
+    if (borrow_mode != 8) {
+        *actual_child.borrow_serial_holder = 0;
+    }
+    actual_child.borrow_holder = NULL;
+    actual_child.borrow_serial_holder = NULL;
+    *locally_returned = 1;
+    qemu_mutex_unlock(&actual_child.journal);
+    return borrow_mode == 6 ? -EIO : 0;
+}
+
+static void prepare_payload(bool legacy)
+{
+    QemuCrucibleCallbackChildOwner *owner = &startup_source.callbacks.owner;
+    QemuCrucibleSourceControlBinding *component = &startup_source.control_callback;
+    QemuCrucibleCommandConsumerMember *member = NULL;
+    int status;
+
+    prepare();
+    payload_fixture = true;
+    qemu_mutex_init(&actual_child.journal);
+    startup_source.command_member = (QemuCrucibleCommandConsumerMember) { 0 };
+    owner->child = &child;
+    owner->runtime = &startup_source.runtime_purpose;
+    owner->runtime_base = (uintptr_t)&paid_runtime;
+    owner->runtime_extent = sizeof(paid_runtime);
+    owner->process = getpid();
+    component_holder = component;
+    component->holder = &component_holder;
+    component->child_owner = owner;
+    component->runtime = owner->runtime;
+    component->userdata = &actual_child;
+    component->enrolled = true;
+    startup_source.setup_slot.transferred = true;
+    startup_source.setup_slot.runtime = owner->runtime;
+    startup_source.setup_slot.mapping = &modeled_mapping;
+    g_assert_cmpint(qemu_plugin_crucible_startup_source_command_member_create_v3(
+        1, component, reader, park_writer, NULL, module_release, &member), ==, -EINVAL);
+    g_assert_null(member);
+    g_assert_false(startup_source.command_member.attempted);
+    g_assert_cmpint(qemu_plugin_crucible_startup_source_command_member_create_v3(
+        1, component, reader, park_writer, module_claim, NULL, &member), ==, -EINVAL);
+    g_assert_null(member);
+    g_assert_false(startup_source.command_member.attempted);
+    g_assert_cmpint(qemu_plugin_crucible_startup_source_command_member_create_v4(
+        1, component, reader, park_writer, module_claim, module_release,
+        module_borrow_acquire, NULL, &member), ==, -EINVAL);
+    g_assert_null(member);
+    g_assert_false(startup_source.command_member.attempted);
+    g_assert_cmpint(qemu_plugin_crucible_startup_source_command_member_create_v4(
+        1, component, reader, park_writer, module_claim, module_release,
+        NULL, module_borrow_release, &member), ==, -EINVAL);
+    g_assert_null(member);
+    g_assert_false(startup_source.command_member.attempted);
+    if (fixture_member_v4) {
+        status = qemu_plugin_crucible_startup_source_command_member_create_v4(
+            1, component, reader, park_writer, module_claim, module_release,
+            module_borrow_acquire, module_borrow_release, &member);
+    } else if (legacy) {
+        status = qemu_plugin_crucible_startup_source_command_member_create_v2(
+            1, component, reader, park_writer, &member);
+    } else {
+        status = qemu_plugin_crucible_startup_source_command_member_create_v3(
+            1, component, reader, park_writer, module_claim, module_release, &member);
+    }
+    g_assert_cmpint(status, ==, 0);
+    g_assert_nonnull(member);
+    g_assert_cmpint(qemu_plugin_crucible_startup_source_command_member_transfer_v1(
+        1, &member, &paid_runtime.member), ==, 0);
+    g_assert_null(member);
+    g_assert_true(paid_runtime.member == &startup_source.command_member);
+    g_assert_cmpint(qemu_plugin_crucible_startup_source_command_member_create_v3(
+        1, component, reader, park_writer, module_claim, module_release, &member), ==, -EBUSY);
+    g_assert_null(member);
+    g_assert_true(paid_runtime.member->payload_claim == (legacy ? NULL : module_claim));
+    g_assert_true(paid_runtime.member->payload_release == (legacy ? NULL : module_release));
+    g_assert_true(paid_runtime.member->payload_borrow_acquire ==
+                  (fixture_member_v4 ? module_borrow_acquire : NULL));
+    g_assert_true(paid_runtime.member->payload_borrow_release ==
+                  (fixture_member_v4 ? module_borrow_release : NULL));
+    g_assert_cmpint(qemu_plugin_crucible_startup_source_command_member_create_v4(
+        1, component, reader, park_writer, module_claim, module_release,
+        module_borrow_acquire, module_borrow_release, &member), ==, -EBUSY);
+    g_assert_null(member);
+}
