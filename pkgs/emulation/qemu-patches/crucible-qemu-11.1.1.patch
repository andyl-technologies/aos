+    g_test_add_func("/crucible/hot-fork/coordinator/ram-abort-refusal",
+                    test_ram_abort_failure_preserves_stopped_authority);
+    g_test_add_func("/crucible/hot-fork/coordinator/runtime-parent-refusal",
+                    test_runtime_parent_failure_does_not_resume_ram);
+    g_test_add_func("/crucible/hot-fork/coordinator/ram-resume-refusal",
+                    test_ram_parent_resume_failure_preserves_stopped_authority);
+    g_test_add_func("/crucible/hot-fork/coordinator/ram-child-rebind-refusal",
+                    test_ram_child_rebind_failure_exits_before_child_reset);
+    g_test_add_func("/crucible/hot-fork/coordinator/child-contract-refusal",
+                    test_child_contract_refusal_precedes_rebind);
+    g_test_add_func("/crucible/ram/main-loop/scheduled-boundaries",
+                    test_ram_scheduled_boundaries);
+    g_test_add_func("/crucible/ram/main-loop/coalesced-rerun",
+                    test_ram_scheduled_coalesced_rerun);
