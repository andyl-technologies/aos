+int qemu_crucible_device_state_sha256(uint8_t digest_out[32],
+                                      uint64_t *bytes_out)
+{
+    if (!qemu_plugin_crucible_exact_boundary_active() || !bql_locked()) {
+        return -EPERM;
+    }
+    return crucible_hash_device_projection(digest_out, bytes_out);
+}
+
+int qemu_crucible_instruction_device_state_sha256(uint8_t digest_out[32],
+                                                  uint64_t *bytes_out)
+{
+    struct qemu_plugin_rr_cursor rr;
+    bool acquired_bql = false;
+    int status;
+
+    /*
+     * Instruction fault dispatch runs between single-instruction TBs on the
+     * serialized RR owner while the vCPU thread has released the BQL.  Validate
+     * that exact execution context before taking the BQL needed to serialize
+     * the device projection with the main loop.  The generic observer API
+     * remains restricted to an externally established exact BQL boundary.
+     */
+    if (!qemu_plugin_crucible_single_threaded_rr() || !current_cpu ||
+        qemu_plugin_rr_cursor(&rr) != 0) {
+        return -EPERM;
+    }
+    if (!bql_locked()) {
+        bql_lock();
+        acquired_bql = true;
+    }
+    status = crucible_hash_device_projection(digest_out, bytes_out);
+    if (acquired_bql) {
+        bql_unlock();
+    }
+    return status;
+}
+
+static bool crucible_fingerprint_runstate_admitted(void)
+{
+    if (vm_get_suspended()) {
+        return false;
+    }
+    if (runstate_is_running()) {
+        return true;
+    }
+    return runstate_check(RUN_STATE_PAUSED) &&
+           qemu_plugin_crucible_vmstop_quiesced();
+}
