+#define COORDINATOR_MAX_EVENTS 16
+
+typedef enum CoordinatorEvent {
+    COORDINATOR_RUNTIME_PREPARE = 16,
+    COORDINATOR_RUNTIME_PARENT,
+    COORDINATOR_BLOCK_CHILD_RESET,
+    COORDINATOR_RUNTIME_CHILD,
+    COORDINATOR_CHILD_CONTRACT,
+} CoordinatorEvent;
+
+typedef struct CoordinatorChildReport {
+    pid_t process_id;
+    int64_t thread_id;
+    unsigned int prepare_calls;
+    unsigned int parent_calls;
+    unsigned int child_calls;
+    unsigned int seal_reset_calls;
+    unsigned int event_count;
+    uint32_t events[COORDINATOR_MAX_EVENTS];
+    int parent_death_signal;
+} CoordinatorChildReport;
+
+typedef struct CoordinatorTestState {
+    QemuCrucibleHotForkMainLoopOperation operation;
+    QemuThread submitter;
+    pid_t source_process_id;
+    pid_t submitted_child_pid;
+    pid_t parent_child_pid;
+    int64_t main_thread_id;
+    int64_t prepare_thread_id;
+    int64_t parent_thread_id;
+    int64_t submitter_thread_id;
+    int report_pipe[2];
+    int submit_result;
+    unsigned int prepare_calls;
+    unsigned int parent_calls;
+    unsigned int child_calls;
+    int submission_done;
+    uint64_t child_process_contract_generation;
+    unsigned int event_count;
+    uint32_t events[COORDINATOR_MAX_EVENTS];
+    uint32_t failed_ram_operation;
+    int ram_error;
+    int prepare_error;
+    int parent_error;
+    int child_contract_error;
+    struct rlimit parent_memlock;
+    bool runtime_guard_held;
+    bool pager_stopped;
+    bool child_service_ready;
+} CoordinatorTestState;
+
+static CoordinatorTestState coordinator_test;
+static unsigned int seal_reset_calls;
+
+static void coordinator_record_event(uint32_t event)
+{
+    CoordinatorTestState *state = &coordinator_test;
+
+    g_assert_cmpuint(state->event_count, <, COORDINATOR_MAX_EVENTS);
+    state->events[state->event_count++] = event;
+}
+
+int qemu_plugin_crucible_ram_lifecycle(uint32_t operation,
+                                     uint64_t source_generation)
+{
+    CoordinatorTestState *state = &coordinator_test;
+
+    g_assert_cmpuint(source_generation, ==,
+                     COORDINATOR_RAM_SOURCE_GENERATION);
+    coordinator_record_event(operation);
+
+    switch (operation) {
+    case QEMU_PLUGIN_CRUCIBLE_RAM_PREPARE_FORK:
+        g_assert_false(state->runtime_guard_held);
+        state->pager_stopped = true;
+        break;
+    case QEMU_PLUGIN_CRUCIBLE_RAM_FINAL_SEAL:
+        g_assert_true(state->runtime_guard_held);
+        g_assert_true(state->pager_stopped);
+        break;
+    case QEMU_PLUGIN_CRUCIBLE_RAM_REBIND_CHILD:
+        g_assert_cmpint(getpid(), !=, state->source_process_id);
+        g_assert_true(state->pager_stopped);
+        struct rlimit lock_limit;
+        g_assert_cmpint(getrlimit(RLIMIT_MEMLOCK, &lock_limit), ==, 0);
+        g_assert_cmpuint(lock_limit.rlim_cur, ==, 0);
+        g_assert_cmpuint(lock_limit.rlim_max, ==, 0);
+        break;
+    case QEMU_PLUGIN_CRUCIBLE_RAM_RESUME_PARENT:
+    case QEMU_PLUGIN_CRUCIBLE_RAM_ABORT_FORK:
+        g_assert_cmpint(getpid(), ==, state->source_process_id);
+        g_assert_false(state->runtime_guard_held);
+        break;
+    default:
+        g_assert_not_reached();
+    }
+
+    if (operation == state->failed_ram_operation) {
+        return state->ram_error;
+    }
+    if (operation == QEMU_PLUGIN_CRUCIBLE_RAM_REBIND_CHILD) {
+        state->child_service_ready = true;
+    } else if (operation == QEMU_PLUGIN_CRUCIBLE_RAM_RESUME_PARENT ||
+               operation == QEMU_PLUGIN_CRUCIBLE_RAM_ABORT_FORK) {
+        state->pager_stopped = false;
+    }
+    return 0;
+}
+
+void qemu_crucible_block_seal_child_reset(void)
+{
+    g_assert_true(coordinator_test.child_service_ready);
+    coordinator_record_event(COORDINATOR_BLOCK_CHILD_RESET);
+    seal_reset_calls++;
+}
+
+static int coordinator_prepare(void *opaque)
+{
+    CoordinatorTestState *state = opaque;
+
+    state->prepare_calls++;
+    state->prepare_thread_id = qemu_get_thread_id();
+    g_assert_true(state->pager_stopped);
+    coordinator_record_event(COORDINATOR_RUNTIME_PREPARE);
+    if (state->prepare_error == 0) {
+        state->runtime_guard_held = true;
+    }
+    return state->prepare_error;
+}
+
+static int coordinator_parent(pid_t child_pid, void *opaque)
+{
+    CoordinatorTestState *state = opaque;
+
+    state->parent_calls++;
+    state->parent_thread_id = qemu_get_thread_id();
+    state->parent_child_pid = child_pid;
+    coordinator_record_event(COORDINATOR_RUNTIME_PARENT);
+    if (state->parent_error == 0) {
+        state->runtime_guard_held = false;
+    }
+    return state->parent_error;
+}
+
+static int coordinator_child_contract(void *opaque)
+{
+    CoordinatorTestState *state = opaque;
+    struct rlimit limit = { .rlim_cur = 0, .rlim_max = 0 };
+
+    g_assert_cmpint(getpid(), !=, state->source_process_id);
+    g_assert_false(state->child_service_ready);
+    coordinator_record_event(COORDINATOR_CHILD_CONTRACT);
+    if (state->child_contract_error != 0) {
+        return state->child_contract_error;
+    }
+    return setrlimit(RLIMIT_MEMLOCK, &limit) == 0 ? 0 : -errno;
+}
+
+static int coordinator_child_ram_work(void *opaque)
+{
+    unsigned int *completed = opaque;
+
+    g_assert_true(bql_locked());
+    (*completed)++;
+    return 0;
+}
+
+static int coordinator_child(void *opaque)
+{
+    CoordinatorTestState *state = opaque;
+    CoordinatorChildReport report;
+    ssize_t written;
+    int parent_death_signal;
+    unsigned int completed = 0;
+
+    g_assert_true(state->child_service_ready);
+    g_assert_cmpint(qemu_plugin_crucible_ram_child_runtime_ready_v1(), ==, 0);
+    g_assert_cmpint(qemu_crucible_ram_run_on_main_loop(
+        coordinator_child_ram_work, &completed), ==, -EINVAL);
+    g_assert_cmpint(qemu_crucible_ram_schedule_on_main_loop(
+        coordinator_child_ram_work, &completed), ==, -EINVAL);
+    g_assert_cmpint(
+        qemu_crucible_hot_fork_main_loop_coordinator_rebind_child(), ==, 0);
+    g_assert_cmpint(qemu_plugin_crucible_ram_child_runtime_ready_v1(), ==, 0);
+    g_assert_cmpint(
+        qemu_crucible_hot_fork_main_loop_coordinator_rebind_child(), ==, -EBUSY);
+    g_assert_cmpint(
+        qemu_crucible_hot_fork_main_loop_coordinator_child_ready(), ==, 0);
+    g_assert_cmpint(qemu_plugin_crucible_ram_child_runtime_ready_v1(), ==, 1);
+    g_assert_cmpint(qemu_crucible_ram_run_on_main_loop(
+        coordinator_child_ram_work, &completed), ==, 0);
+    g_assert_cmpuint(completed, ==, 1);
+    ram_test_paused = true;
+    ram_test_quiesced = true;
+    g_assert_cmpint(qemu_crucible_ram_schedule_on_main_loop(
+        coordinator_child_ram_work, &completed), ==, 0);
+    main_loop_wait(true);
+    g_assert_cmpuint(completed, ==, 2);
+    g_assert_cmpint(prctl(PR_GET_PDEATHSIG, &parent_death_signal), ==, 0);
+    g_assert_cmpint(parent_death_signal, ==, SIGKILL);
+    coordinator_record_event(COORDINATOR_RUNTIME_CHILD);
+    state->child_calls++;
+    report = (CoordinatorChildReport) {
+        .process_id = getpid(),
+        .thread_id = qemu_get_thread_id(),
+        .prepare_calls = state->prepare_calls,
+        .parent_calls = state->parent_calls,
+        .child_calls = state->child_calls,
+        .seal_reset_calls = seal_reset_calls,
+        .event_count = state->event_count,
+        .parent_death_signal = parent_death_signal,
+    };
+    memcpy(report.events, state->events, sizeof(report.events));
+    do {
+        written = write(state->report_pipe[1], &report, sizeof(report));
+    } while (written < 0 && errno == EINTR);
+    if (written != (ssize_t)sizeof(report)) {
+        _exit(EXIT_FAILURE);
+    }
+
+    /*
+     * The production callback reconstructs every main-loop dependency before
+     * returning.  This focused bridge test deliberately owns none of those
+     * subsystem transactions, so terminate after reporting the fork context
+     * rather than re-entering their copied locks.
+     */
+    _exit(EXIT_SUCCESS);
+}
+
+static void *coordinator_submit(void *opaque)
+{
+    CoordinatorTestState *state = opaque;
+
+    state->submitter_thread_id = qemu_get_thread_id();
+    state->submit_result = qemu_crucible_hot_fork_main_loop_fork(
+        &state->operation, state->child_process_contract_generation,
+        &state->submitted_child_pid);
+    qatomic_set(&state->submission_done, 1);
+    qemu_notify_event();
+    return NULL;
+}
+
+static void coordinator_submit_transaction(
+    uint64_t child_process_contract_generation)
+{
+    coordinator_test.submitted_child_pid = -1;
+    coordinator_test.parent_child_pid = -1;
+    coordinator_test.submit_result = -EINPROGRESS;
+    coordinator_test.prepare_calls = 0;
+    coordinator_test.parent_calls = 0;
+    coordinator_test.child_calls = 0;
+    coordinator_test.submission_done = 0;
+    coordinator_test.event_count = 0;
+    coordinator_test.child_process_contract_generation =
+        child_process_contract_generation;
+
+    qemu_thread_create(&coordinator_test.submitter, "fork submitter",
+                       coordinator_submit, &coordinator_test,
+                       QEMU_THREAD_JOINABLE);
+    bql_lock();
+    while (!qatomic_read(&coordinator_test.submission_done)) {
+        main_loop_wait(false);
+    }
+    bql_unlock();
+    qemu_thread_join(&coordinator_test.submitter);
+}
+
+static CoordinatorChildReport coordinator_submit_child(
+    uint64_t child_process_contract_generation)
+{
+    static const uint32_t parent_events[] = {
+        QEMU_PLUGIN_CRUCIBLE_RAM_PREPARE_FORK,
+        COORDINATOR_RUNTIME_PREPARE,
+        QEMU_PLUGIN_CRUCIBLE_RAM_FINAL_SEAL,
+        COORDINATOR_RUNTIME_PARENT,
+        QEMU_PLUGIN_CRUCIBLE_RAM_RESUME_PARENT,
+    };
+    static const uint32_t child_events[] = {
+        QEMU_PLUGIN_CRUCIBLE_RAM_PREPARE_FORK,
+        COORDINATOR_RUNTIME_PREPARE,
+        QEMU_PLUGIN_CRUCIBLE_RAM_FINAL_SEAL,
+        COORDINATOR_CHILD_CONTRACT,
+        QEMU_PLUGIN_CRUCIBLE_RAM_REBIND_CHILD,
+        COORDINATOR_BLOCK_CHILD_RESET,
+        COORDINATOR_RUNTIME_CHILD,
+    };
+    CoordinatorChildReport report;
+    ssize_t received;
+
+    coordinator_submit_transaction(child_process_contract_generation);
+    g_assert_cmpint(coordinator_test.submit_result, ==, 0);
+    g_assert_cmpint(coordinator_test.submitted_child_pid, >, 0);
+    g_assert_cmpint(coordinator_test.parent_child_pid, ==,
+                    coordinator_test.submitted_child_pid);
+    g_assert_cmpuint(coordinator_test.prepare_calls, ==, 1);
+    g_assert_cmpuint(coordinator_test.parent_calls, ==, 1);
+    g_assert_cmpuint(coordinator_test.child_calls, ==, 0);
+    g_assert_cmpint(coordinator_test.prepare_thread_id, ==,
+                    coordinator_test.main_thread_id);
+    g_assert_cmpint(coordinator_test.parent_thread_id, ==,
+                    coordinator_test.main_thread_id);
+    g_assert_cmpint(coordinator_test.submitter_thread_id, !=,
+                    coordinator_test.main_thread_id);
+    g_assert_false(coordinator_test.pager_stopped);
+    g_assert_cmpuint(coordinator_test.event_count, ==,
+                     G_N_ELEMENTS(parent_events));
+    g_assert_cmpmem(coordinator_test.events, sizeof(parent_events),
+                    parent_events, sizeof(parent_events));
+
+    do {
+        received = read(coordinator_test.report_pipe[0], &report,
+                        sizeof(report));
+    } while (received < 0 && errno == EINTR);
+    g_assert_cmpint(received, ==, (ssize_t)sizeof(report));
+    g_assert_cmpint(report.process_id, ==,
+                    coordinator_test.submitted_child_pid);
+    g_assert_cmpint(report.thread_id, ==, report.process_id);
+    g_assert_cmpuint(report.prepare_calls, ==, 1);
+    g_assert_cmpuint(report.parent_calls, ==, 0);
+    g_assert_cmpuint(report.seal_reset_calls, ==, 1);
+    g_assert_cmpuint(report.child_calls, ==, 1);
+    g_assert_cmpint(report.parent_death_signal, ==, SIGKILL);
+    g_assert_cmpuint(report.event_count, ==, G_N_ELEMENTS(child_events));
+    g_assert_cmpmem(report.events, sizeof(child_events),
+                    child_events, sizeof(child_events));
+
+    return report;
+}
+
+static QemuCrucibleHotForkChildProcessState coordinator_await_child_status(
+    uint64_t child_process_contract_generation, int exit_status)
+{
+    QemuCrucibleHotForkChildProcessState process = { 0 };
+
+    for (unsigned int poll = 0; ; poll++) {
+        g_assert_cmpint(qemu_crucible_hot_fork_child_process_query(
+                            child_process_contract_generation,
+                            &process), ==, 0);
+        if (process.phase != QEMU_CRUCIBLE_HOT_FORK_CHILD_RUNNING) {
+            break;
+        }
+        g_assert_cmpuint(poll, <, 1000);
+        g_usleep(1000);
+    }
+    g_assert_cmpint(process.phase, ==,
+                    QEMU_CRUCIBLE_HOT_FORK_CHILD_EXITED);
+    g_assert_cmpint(process.status, ==, exit_status);
+    g_assert_true(process.retained);
+
+    return process;
