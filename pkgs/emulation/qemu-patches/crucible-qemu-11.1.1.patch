+int qemu_plugin_crucible_ram_capture_observation_only_v1(
+    uint64_t generation, uint64_t owner_token, uint32_t *out)
+{
+    if (!out || !capture_valid(generation, owner_token)) {
+        return -ESTALE;
+    }
+    *out = capture_observation_only;
+    return 0;
+}
