+int qemu_plugin_crucible_ram_control_actor_quiesce_v1(
+    qemu_plugin_id_t id, qemu_plugin_crucible_ram_control_actor_v1 *actor)
+{
+#ifdef CONFIG_LINUX
+    uint64_t bounded_ns;
+    int status = ram_control_parent_slice(actor, id, &bounded_ns);
+    int post;
+
+    if (status) {
+        return status;
+    }
+    status = pthread_mutex_trylock(&actor->dispatch_mutex);
+    if (status) {
+        return status == EBUSY ? -EAGAIN : -status;
+    }
+    if (!actor->born || !actor->ready || actor->joined || actor->returned ||
+        actor->terminal_pending || actor->first_status || actor->post_status ||
+        actor->receipt.uncertain || !actor->service_registered) {
+        status = -ESTALE;
+    } else if (actor->pause.requested || actor->pause.held ||
+               actor->request_pause.requested || actor->request_pause.held) {
+        status = -EBUSY;
+    } else {
+        status = qemu_thread_ram_actor_enrollment_current(
+            actor->thread_binding, actor->thread_id);
+        if (!status) {
+            status = qemu_crucible_ram_service_actor_enrollment_current(
+                actor, actor->service_generation, actor->thread_id);
+        }
+        if (!status) {
+            qatomic_store_release(&actor->quiesce_requested, true);
+        } else if (status == 1) {
+            status = -EAGAIN;
+        }
+    }
+    {
+        int unlock = pthread_mutex_unlock(&actor->dispatch_mutex);
+
+        if (unlock) {
+            ram_control_failure(actor, -unlock, true);
+            status = status ? status : -unlock;
+        }
+    }
+    /* Every effectful gate cut records its independent original post. The
+     * worker observes the gate via its finite native receive loop slices. */
+    post = ram_control_parent_slice(actor, id, &bounded_ns);
+    if (post) {
+        ram_control_failure(actor, post, true);
+        status = status ? status : post;
+    }
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_ram_control_actor_quiesce_join_v1(
+    qemu_plugin_id_t id, qemu_plugin_crucible_ram_control_actor_v1 *actor)
+{
+#ifdef CONFIG_LINUX
+    void *returned = NULL;
+    uint64_t bounded_ns;
+    int status;
+    int post;
+
+    for (;;) {
+        status = ram_control_parent_slice(actor, id, &bounded_ns);
+        if (status) {
+            return qatomic_load_acquire(&actor->quiesce_requested) ?
+                ram_control_failure(actor, status, false) : status;
+        }
+        if (!qatomic_load_acquire(&actor->quiesce_requested) || actor->joined ||
+            !qatomic_load_acquire(&actor->born)) {
+            return actor->joined ? -EALREADY : -EPERM;
+        }
+        if (!qatomic_load_acquire(&actor->returned)) {
+            status = ram_control_parent_wait(actor, id, bounded_ns);
+            if (status) {
+                return status;
+            }
+            continue;
+        }
+        if (!qatomic_load_acquire(&actor->graceful_return) ||
+            !qatomic_load_acquire(&actor->dispatch_ended) ||
+            actor->service_registered || actor->record_in_flight ||
+            actor->receipt.active || actor->receipt.moved ||
+            actor->receipt.uncertain || actor->receipt.frame_bytes ||
+            actor->receipt.alias_count || actor->receipt.record.held ||
+            actor->receipt.record.callback_active || actor->pause.requested ||
+            actor->pause.held || actor->request_pause.requested ||
+            actor->request_pause.held || actor->first_status ||
+            actor->post_status || actor->entry_status) {
+            return ram_control_failure(actor, -EINPROGRESS, true);
+        }
+        actor->join_attempted = true;
+        status = qemu_thread_bounded_tryjoin(&actor->thread, actor,
+                                             &actor->creation_receipt, &returned);
+        actor->join_result = status;
+        actor->join_errno = status < 0 ? -status : 0;
+        if (!status) {
+            /* Physical join occurs before any storage reuse. The dangling
+             * registry binding is cleared, never inspected after retirement. */
+            actor->joined = true;
+            actor->thread_binding = NULL;
+            status = startup_task_physical_return(&actor->task_reserved);
+            if (status) {
+                return ram_control_failure(actor, status, true);
+            }
+            break;
+        }
+        if (status != -EBUSY) {
+            return ram_control_failure(actor, status, false);
+        }
+        status = ram_control_parent_wait(actor, id, bounded_ns);
+        if (status) {
+            return status;
+        }
+    }
+    if (returned || !qatomic_load_acquire(&actor->returned) ||
+        !qatomic_load_acquire(&actor->graceful_return) ||
+        actor->service_registered || actor->record_in_flight ||
+        actor->receipt.active || actor->receipt.moved || actor->receipt.uncertain ||
+        actor->receipt.frame_bytes || actor->receipt.alias_count ||
+        actor->receipt.record.held || actor->receipt.record.callback_active ||
+        actor->first_status || actor->post_status || actor->entry_status) {
+        status = ram_control_failure(actor, -EINPROGRESS, true);
+    }
+    post = ram_control_parent_slice(actor, id, &bounded_ns);
+    if (post) {
+        ram_control_failure(actor, post, true);
+        status = status ? status : post;
+    }
+    if (!status) {
+        /* The same paid stack, endpoint and callback allocation stay retained.
+         * Ordinary terminal join remains the separate stack-retiring API. */
+        actor->parent_joined = true;
+    }
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_ram_control_actor_parent_rearm_v1(
+    qemu_plugin_id_t id, qemu_plugin_crucible_ram_control_actor_v1 *actor,
+    qemu_plugin_crucible_ram_parent_original_v1 *original)
+{
+#if defined(CONFIG_LINUX) && defined(__x86_64__) && !defined(__ILP32__)
+    uint64_t bounded_ns;
+    int status = ram_control_parent_original_current(actor, id, original,
+                                                      &bounded_ns);
+    int post;
+
+    if (status) {
+        return status;
+    }
+    if (original->rearm_attempted || !actor->parent_joined || !actor->joined ||
+        !actor->returned || !actor->graceful_return || !actor->dispatch_ended ||
+        !actor->quiesce_requested || !actor->stack || actor->stack_uncertain ||
+        !actor->charge.held || actor->receipt.active || actor->receipt.moved ||
+        actor->receipt.uncertain || actor->record_in_flight ||
+        actor->receipt.frame_bytes || actor->receipt.alias_count ||
+        actor->receipt.record.held || actor->receipt.record.callback_active ||
+        actor->service_registered || actor->thread_binding ||
+        actor->pause.requested || actor->pause.held ||
+        actor->request_pause.requested || actor->request_pause.held ||
+        actor->first_status || actor->post_status || actor->entry_status ||
+        actor->incarnation == UINT64_MAX) {
+        return -EINPROGRESS;
+    }
+    status = qemu_thread_bounded_identity_return(&actor->thread, actor,
+                                                 &actor->creation_receipt);
+    if (status) {
+        return ram_control_failure(actor, status, true);
+    }
+    original->rearm_attempted = true;
+    /* Exactly the retired physical incarnation's transient publication fields
+     * change. The callback-owned endpoint/session/cursor and entry stay intact;
+     * neither a descriptor nor a caller-supplied sequence authorizes birth. */
+    actor->incarnation++;
+    actor->creator_published = false;
+    actor->qualification_published = false;
+    actor->entry_released = false;
+    actor->entry_allowed = false;
+    actor->qualification_status = 0;
+    actor->terminal_pending = false;
+    actor->quiesce_requested = false;
+    actor->dispatch_ended = false;
+    actor->graceful_return = false;
+    actor->parent_joined = false;
+    actor->born = false;
+    actor->ready = false;
+    actor->returned = false;
+    actor->joined = false;
+    actor->join_attempted = false;
+    actor->join_result = 0;
+    actor->join_errno = 0;
+    actor->thread_id = 0;
+    actor->service_generation = 0;
+    status = startup_task_reserve(&actor->task_reserved);
+    if (status) {
+        return ram_control_failure(actor, status, false);
+    }
+    status = qemu_thread_create_bounded(&actor->thread, "crucible-ram",
+                                        ram_control_entry, actor,
+                                        actor->stack, actor->stack_bytes,
+                                        &actor->creation_receipt);
+    if (actor->creation_receipt.born) {
+        qatomic_store_release(&actor->born, true);
+    } else if (actor->task_reserved) {
+        startup_task_physical_return(&actor->task_reserved);
+    }
+    if (status) {
+        ram_control_failure(actor, status, actor->creation_receipt.born);
+        qatomic_store_release(&actor->creator_published, true);
+        qatomic_store_release(&actor->entry_released, true);
+        return status;
+    }
+    qatomic_store_release(&actor->born, true);
+    /* Current loan is consumed for this incarnation; retained Source checks
+     * qualify actual new registry/service2 ownership before dispatch release. */
+    post = ram_control_parent_slice(actor, id, &bounded_ns);
+    if (post) {
+        ram_control_failure(actor, post, true);
+        status = post;
+    } else {
+        qatomic_store_release(&actor->ready, true);
+    }
+    qatomic_store_release(&actor->creator_published, true);
+    if (!status) {
+        status = ram_control_creator_enrollment(actor, id, true);
+    }
+    if (!status) {
+        qatomic_store_release(&actor->entry_allowed, true);
+    }
+    qatomic_store_release(&actor->entry_released, true);
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
