+        uint16_t expected_phase_ps = t->expires_phase_ps;
+
+        if (!qemu_timer_tcg_ps_enabled() && expected_phase_ps) {
+            if (expected_ns == INT64_MAX) {
+                return -EINVAL;
+            }
+            expected_ns++;
+            expected_phase_ps = 0;
+        }
+
+        if (timer_expire_time_ns_phase(&t->qtimer, &deadline_ns,
+                                       &deadline_phase_ps) != 1 ||
+            deadline_ns != expected_ns ||
