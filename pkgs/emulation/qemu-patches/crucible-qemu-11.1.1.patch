+
+static int64_t test_virtual_clock_ps(void)
+{
+    return observed_ps;
+}
+
+static QEMUFile *open_test_file(int fd, bool writing)
+{
+    QIOChannel *channel;
+    QEMUFile *file;
+    int copy = dup(fd);
+
+    g_assert_cmpint(copy, >=, 0);
+    g_assert_cmpint(lseek(copy, 0, SEEK_SET), >=, 0);
+    if (writing) {
+        g_assert_cmpint(ftruncate(copy, 0), ==, 0);
+    }
+    channel = QIO_CHANNEL(qio_channel_file_new_fd(copy));
+    file = writing ? qemu_file_new_output(channel) :
+                     qemu_file_new_input(channel);
+    object_unref(OBJECT(channel));
+    return file;
+}
+
+static void test_mos6522_subnanosecond_phase_and_restore(void)
+{
+    const uint64_t frequency = 783360;
+    const __int128 horizon_ps = (__int128)INT64_MAX *
+                                PICOSECONDS_PER_NANOSECOND + 999;
+    const __int128 load_ps = -1500;
+    const __int128 deadline_ps = mos6522_deadline_ps(load_ps, 1, frequency);
+    const __int128 long_deadline_ps = horizon_ps - 320;
+    Object *source_object = object_new(TYPE_TEST_MOS6522);
+    Object *restored_object = object_new(TYPE_TEST_MOS6522);
+    MOS6522State *source = MOS6522(source_object);
+    MOS6522State *restored = MOS6522(restored_object);
+    g_autofree char *path = NULL;
+    QEMUFile *file;
+    Error *error = NULL;
+    int64_t split_ns;
+    uint16_t split_subns;
+    int fd;
+
+    g_assert_true(qemu_time_split_ps(-1, &split_ns, &split_subns));
+    g_assert_cmpint(split_ns, ==, -1);
+    g_assert_cmpuint(split_subns, ==, 999);
+
+    g_assert_true(via_next_period(-1, 1000, horizon_ps) == 0);
+    g_assert_true(via_next_period(-1000, 1000, horizon_ps) == 0);
+    g_assert_true(via_next_period(0, 1000, horizon_ps) == 1000);
+
+    g_assert_true(deadline_ps > load_ps + 1000);
+    g_assert_cmpuint(mos6522_elapsed_ticks_ps(deadline_ps - 1, load_ps,
+                                               frequency), ==, 0);
+    g_assert_cmpuint(mos6522_elapsed_ticks_ps(deadline_ps, load_ps,
+                                               frequency), ==, 1);
+    g_assert_true(mos6522_deadline_ps(load_ps + 1, 1, frequency) ==
+                  deadline_ps + 1);
+    g_assert_true(mos6522_deadline_ps(horizon_ps - 100, 1, frequency) ==
+                  horizon_ps);
+
+    source->timers[0].latch = 0xffff;
+    source->timers[0].counter_value = 1;
+    g_assert_true(qemu_time_split_ps(load_ps,
+                                    &source->timers[0].load_time,
+                                    &source->timers[0].load_time_subns));
+    g_assert_true(qemu_time_split_ps(
+        deadline_ps, &source->timers[0].next_irq_time,
+        &source->timers[0].next_irq_time_subns));
+    timer_mod_ps_wide(source->timers[0].timer, deadline_ps);
+    source->timers[1].next_irq_time =
+        long_deadline_ps / PICOSECONDS_PER_NANOSECOND;
+    source->timers[1].next_irq_time_subns =
+        long_deadline_ps % PICOSECONDS_PER_NANOSECOND;
+    timer_mod_ps_wide(source->timers[1].timer, long_deadline_ps);
+
+    fd = g_file_open_tmp("mos6522-clock-XXXXXX", &path, NULL);
+    g_assert_cmpint(fd, >=, 0);
+    unlink(path);
+
+    file = open_test_file(fd, true);
+    g_assert_cmpint(vmstate_save_state(file, &vmstate_mos6522, source,
+                                       NULL, &error), ==, 0);
+    g_assert_null(error);
+    qemu_put_byte(file, QEMU_VM_EOF);
+    g_assert_cmpint(qemu_fclose(file), ==, 0);
+
+    file = open_test_file(fd, false);
+    g_assert_cmpint(vmstate_load_state(file, &vmstate_mos6522, restored,
+                                       1, &error), ==, 0);
+    g_assert_null(error);
+    qemu_fclose(file);
+
+    g_assert_true(restored->ps_clock_loaded);
+    g_assert_cmpint(restored->timers[0].load_time, ==, -2);
+    g_assert_cmpuint(restored->timers[0].load_time_subns, ==, 500);
+    g_assert_cmpint(restored->timers[0].next_irq_time, ==,
+                    source->timers[0].next_irq_time);
+    g_assert_cmpuint(restored->timers[0].next_irq_time_subns, ==,
+                     source->timers[0].next_irq_time_subns);
+    g_assert_true(timer_expire_time_ps_wide(restored->timers[0].timer) ==
+                  deadline_ps);
+    g_assert_true(timer_expire_time_ps_wide(restored->timers[1].timer) ==
+                  long_deadline_ps);
+    g_assert_cmpuint(mos6522_elapsed_ticks_ps(deadline_ps - 1,
+                                               restored->timers[0].load_time *
+                                               PICOSECONDS_PER_NANOSECOND +
+                                               restored->timers[0].load_time_subns,
+                                               frequency), ==, 0);
+
+    object_unref(source_object);
+    object_unref(restored_object);
+    close(fd);
+}
+
+static void test_exact_timer_codec_negative_deadline(void)
+{
+    TestExactTimerState source = {
+        .timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, NULL, NULL),
+    };
+    TestExactTimerState restored = {
+        .timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, NULL, NULL),
+    };
+    uint8_t encoded[11];
+    g_autofree char *path = NULL;
+    QEMUFile *file;
+    Error *error = NULL;
+    int fd;
+
+    timer_mod_ps_wide(source.timer, -357);
+    fd = g_file_open_tmp("exact-timer-codec-XXXXXX", &path, NULL);
+    g_assert_cmpint(fd, >=, 0);
+    unlink(path);
+
+    file = open_test_file(fd, true);
+    g_assert_cmpint(vmstate_save_state(file, &vmstate_test_exact_timer,
+                                       &source, NULL, &error), ==, 0);
+    g_assert_null(error);
+    g_assert_cmpint(qemu_fclose(file), ==, 0);
+
+    g_assert_cmpint(pread(fd, encoded, sizeof(encoded), 0), ==,
+                    sizeof(encoded));
+    g_assert_cmphex(encoded[0], ==, 1);
+    for (size_t i = 1; i < 9; i++) {
+        g_assert_cmphex(encoded[i], ==, 0xff);
+    }
+    g_assert_cmphex(encoded[9], ==, 0x02);
+    g_assert_cmphex(encoded[10], ==, 0x83);
+
+    file = open_test_file(fd, false);
+    g_assert_cmpint(vmstate_load_state(file, &vmstate_test_exact_timer,
+                                       &restored, 1, &error), ==, 0);
+    g_assert_null(error);
+    qemu_fclose(file);
+    g_assert_true(timer_pending(restored.timer));
+    g_assert_true(timer_expire_time_ps_wide(restored.timer) == -357);
+
+    timer_free(source.timer);
+    timer_free(restored.timer);
+    close(fd);
+}
+
+static void assert_timer_projection(__int128 deadline_ps, bool active,
+                                    int64_t expected_ns)
+{
+    TestExactTimerState source = {
+        .timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, NULL, NULL),
+    };
+    TestExactTimerState restored = {
+        .timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, NULL, NULL),
+    };
+    g_autofree char *path = NULL;
+    uint64_t encoded;
+    QEMUFile *file;
+    Error *error = NULL;
+    int fd;
+
+    if (active) {
+        timer_mod_ps_wide(source.timer, deadline_ps);
+    }
+    fd = g_file_open_tmp("timer-projection-XXXXXX", &path, NULL);
+    g_assert_cmpint(fd, >=, 0);
+    unlink(path);
+
+    file = open_test_file(fd, true);
+    g_assert_cmpint(vmstate_save_state(file, &vmstate_test_timer_projection,
+                                       &source, NULL, &error), ==, 0);
+    g_assert_null(error);
+    g_assert_cmpint(qemu_fclose(file), ==, 0);
+
+    g_assert_cmpint(pread(fd, &encoded, sizeof(encoded), 0), ==,
+                    sizeof(encoded));
+    g_assert_cmpint((int64_t)be64_to_cpu(encoded), ==, expected_ns);
+
+    file = open_test_file(fd, false);
+    g_assert_cmpint(vmstate_load_state(file, &vmstate_test_timer_projection,
+                                       &restored, 1, &error), ==, 0);
+    g_assert_null(error);
+    qemu_fclose(file);
+    if (expected_ns == -1) {
+        g_assert_false(timer_pending(restored.timer));
+    } else {
+        g_assert_true(timer_pending(restored.timer));
+        g_assert_true(timer_expire_time_ps_wide(restored.timer) ==
+                      (__int128)expected_ns * PICOSECONDS_PER_NANOSECOND);
+    }
+
+    timer_free(source.timer);
+    timer_free(restored.timer);
+    close(fd);
+}
+
+static void test_timer_ns_projection(void)
+{
+    const __int128 horizon_ps = (__int128)INT64_MAX *
+                                PICOSECONDS_PER_NANOSECOND + 999;
+
+    assert_timer_projection(0, false, -1);
+    assert_timer_projection(-1000, true, 0);
+    assert_timer_projection(-357, true, 0);
+    assert_timer_projection(1357, true, 2);
+    assert_timer_projection(horizon_ps, true, INT64_MAX);
+}
+
+int main(int argc, char **argv)
+{
+    module_call_init(MODULE_INIT_QOM);
+    type_register_static(&test_sysbus_device_type_info);
+    type_register_static(&test_mos6522_type_info);
+    qemu_init_main_loop(&error_abort);
+    qemu_timer_enable_tcg_ps_clock(test_virtual_clock_ps, NULL);
+
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/crucible/mos6522/subnanosecond-phase-restore",
+                    test_mos6522_subnanosecond_phase_and_restore);
+    g_test_add_func("/crucible/timer-codec/negative-deadline",
+                    test_exact_timer_codec_negative_deadline);
+    g_test_add_func("/crucible/timer-codec/ns-projection",
+                    test_timer_ns_projection);
+    return g_test_run();
+}
diff --git a/tests/unit/test-crucible-mutex-owner-cache.py b/tests/unit/test-crucible-mutex-owner-cache.py
new file mode 100644
index 0000000000000000000000000000000000000000..e5d8e0a48837ade8f6ad2789fe9642ce194a47a0
--- /dev/null
+++ b/tests/unit/test-crucible-mutex-owner-cache.py
@@ -0,0 +1,583 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Exercise production mutex ownership with real Linux fork and pthread IDs.
+
+Tracking, cache and native child-registry bodies execute here.
+The RCU child callback body is real; its initializer and restart-thread topology
+are bounded providers. This is not a linked QEMU checkpoint/guest test.
+"""
+
+import argparse
+import json
+import os
+from pathlib import Path
+import runpy
+import shlex
+import subprocess
+
+
+ROOT = Path(__file__).resolve().parents[2]
+EXTRACT = runpy.run_path(str(Path(__file__).with_name(
+    "extract-crucible-startup-source-controls.py")))
+
+
+def definition(source, signature):
+    for _, _, _, body in EXTRACT["function_definitions"](source):
+        if body.startswith(signature):
+            return body.rstrip()
+    raise ValueError(f"function definition missing: {signature}")
+
+PRELUDE = r"""
+#include "qemu/osdep.h"
+#include <assert.h>
+#include <errno.h>
+#include <inttypes.h>
+#include <limits.h>
+#include <sched.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <sys/wait.h>
+#include <unistd.h>
+#include <glib.h>
+#include "qemu/atomic.h"
+#include "qemu/thread.h"
+
+static __thread unsigned int tid_reads;
+static __thread int failed_tid;
+static bool fail_registration;
+
+int qemu_get_thread_id(void)
+{
+    tid_reads++;
+    if (failed_tid) {
+        int result = failed_tid;
+        failed_tid = 0;
+        return result;
+    }
+    return syscall(SYS_gettid);
+}
+
+static int cache_atfork(void (*prepare)(void), void (*parent)(void),
+                        void (*child)(void))
+{
+    if (fail_registration) {
+        return ENOMEM;
+    }
+    return pthread_atfork(prepare, parent, child);
+}
+#define pthread_atfork cache_atfork
+#define error_report(...) fprintf(stderr, __VA_ARGS__)
+
+static void qemu_mutex_post_init(QemuMutex *mutex)
+{
+    mutex->initialized = true;
+}
+
+static void qemu_mutex_pre_lock(QemuMutex *mutex, const char *file, int line)
+{
+    (void)mutex;
+    (void)file;
+    (void)line;
+}
+
+static void qemu_mutex_post_lock(QemuMutex *mutex, const char *file, int line)
+{
+    (void)mutex;
+    (void)file;
+    (void)line;
+}
+
+static void qemu_mutex_pre_unlock(QemuMutex *mutex, const char *file, int line)
+{
+    (void)mutex;
+    (void)file;
+    (void)line;
+}
+"""
+
+CHECKS = r"""
+static QemuMutex mutex;
+static QemuRecMutex recursive;
+static int atfork_depth = 1;
+static struct { unsigned int value; } registry;
+static unsigned int early_child_calls, late_child_calls;
+static int64_t early_child_owner, late_child_owner, worker_owner;
+
+static void cached_identity(void)
+{
+    unsigned int before = tid_reads;
+
+    for (unsigned int i = 0; i < 1000; i++) {
+        g_assert_cmpint(qemu_thread_current_id(), ==, syscall(SYS_gettid));
+    }
+    g_assert_cmpuint(tid_reads, ==, before);
+}
+
+static void first_access_before_mutex(void)
+{
+    int64_t parent = syscall(SYS_gettid);
+    pid_t child;
+    int status;
+
+    g_assert_false(crucible_mutex_owner_cache_enabled);
+    g_assert_cmpuint(tid_reads, ==, 0);
+    g_assert_cmpint(qemu_thread_current_id(), ==, parent);
+    g_assert_true(crucible_mutex_owner_cache_enabled);
+    g_assert_cmpuint(tid_reads, ==, 1);
+    cached_identity();
+    child = fork();
+    g_assert_cmpint(child, >=, 0);
+    if (!child) {
+        g_assert_cmpint(crucible_mutex_owner_cached_thread_id, ==, 0);
+        g_assert_cmpint(qemu_thread_current_id(), ==, syscall(SYS_gettid));
+        g_assert_cmpint(qemu_thread_current_id(), !=, parent);
+        g_assert_cmpuint(tid_reads, ==, 2);
+        cached_identity();
+        _exit(0);
+    }
+    g_assert_cmpint(waitpid(child, &status, 0), ==, child);
+    g_assert_true(WIFEXITED(status));
+    g_assert_cmpint(WEXITSTATUS(status), ==, 0);
+    g_assert_cmpint(crucible_mutex_owner_cached_thread_id, ==, 0);
+    g_assert_cmpint(qemu_thread_current_id(), ==, parent);
+    g_assert_cmpuint(tid_reads, ==, 2);
+    cached_identity();
+    puts("PASS production mutex owner cache: first access before mutex, real fork IDs, cached identity without repeated syscalls");
+}
+
+static CrucibleHotForkMutexEntry *entry(QemuMutex *target)
+{
+    return &crucible_hot_fork_mutexes[target->crucible_hot_fork_slot];
+}
+
+static void assert_owner(QemuMutex *target)
+{
+    g_assert_cmpint(entry(target)->owner_thread_id, ==, syscall(SYS_gettid));
+    g_assert_true(entry(target)->ownership_valid);
+    g_assert_cmpuint(entry(target)->recursion_depth, >, 0);
+}
+
+static void lock(QemuMutex *target)
+{
+    qemu_mutex_lock_impl(target, __FILE__, __LINE__);
+    assert_owner(target);
+}
+
+static void unlock(QemuMutex *target)
+{
+    qemu_mutex_unlock_impl(target, __FILE__, __LINE__);
+    g_assert_true(entry(target)->ownership_valid);
+    g_assert_cmpuint(entry(target)->recursion_depth, ==, 0);
+}
+
+static QemuMutex contended_lock;
+static pthread_barrier_t contention_start;
+
+typedef struct MutexOwnershipWorker {
+    int64_t thread_id;
+    unsigned int completed;
+} MutexOwnershipWorker;
+
+static void contention_start_wait(void)
+{
+    int status = pthread_barrier_wait(&contention_start);
+
+    g_assert_true(status == 0 || status == PTHREAD_BARRIER_SERIAL_THREAD);
+}
+
+static void *contending_mutex_worker(void *opaque)
+{
+    MutexOwnershipWorker *result = opaque;
+
+    contention_start_wait();
+    result->thread_id = syscall(SYS_gettid);
+    for (unsigned int i = 0; i < 1000; i++) {
+        lock(&contended_lock);
+        assert_owner(&contended_lock);
+        sched_yield();
+        assert_owner(&contended_lock);
+        /* The next worker can own the registry slot as soon as unlock returns. */
+        qemu_mutex_unlock_impl(&contended_lock, __FILE__, __LINE__);
+        result->completed++;
+    }
+    g_assert_cmpuint(tid_reads, ==, 1);
+    return NULL;
+}
+
+static void contending_mutex_ownership(void)
+{
+    MutexOwnershipWorker workers[2] = { 0 };
+    pthread_t threads[2];
+    int64_t parent = syscall(SYS_gettid);
+
+    qemu_mutex_init(&contended_lock);
+    g_assert_cmpint(pthread_barrier_init(&contention_start, NULL, 3), ==, 0);
+    lock(&contended_lock);
+    for (unsigned int i = 0; i < 2; i++) {
+        g_assert_cmpint(pthread_create(&threads[i], NULL,
+                                      contending_mutex_worker, &workers[i]),
+                        ==, 0);
+    }
+    contention_start_wait();
+    /* Both workers must really block behind the published native owner. */
+    for (unsigned int attempts = 0;
+         attempts < 1000000 &&
+         qatomic_read(&entry(&contended_lock)->acquisition_waiters) != 2;
+         attempts++) {
+        sched_yield();
+    }
+    g_assert_cmpuint(qatomic_read(&entry(&contended_lock)->acquisition_waiters),
+                     ==, 2);
+    qemu_mutex_unlock_impl(&contended_lock, __FILE__, __LINE__);
+    for (unsigned int i = 0; i < 2; i++) {
+        g_assert_cmpint(pthread_join(threads[i], NULL), ==, 0);
+        g_assert_cmpuint(workers[i].completed, ==, 1000);
+        g_assert_cmpint(workers[i].thread_id, !=, parent);
+    }
+    g_assert_cmpint(workers[0].thread_id, !=, workers[1].thread_id);
+    g_assert_cmpint(crucible_mutex_owner_cached_thread_id, ==, parent);
+    g_assert_cmpint(pthread_barrier_destroy(&contention_start), ==, 0);
+    qemu_mutex_destroy(&contended_lock);
+}
+
+static void early_prepare(void)
+{
+    if (atfork_depth < 1) {
+        return;
+    }
+    g_assert_true(crucible_mutex_owner_cache_suspended);
+    lock(&mutex);
+    unlock(&mutex);
+    /* An older prepare callback must not repopulate an inherited parent ID. */
+    g_assert_cmpint(crucible_mutex_owner_cached_thread_id, ==, 0);
+}
+
+static void rcu_init_complete(void)
+{
+    g_assert_true(crucible_mutex_owner_cache_suspended);
+    lock(&mutex);
+    early_child_owner = entry(&mutex)->owner_thread_id;
+    unlock(&mutex);
+    g_assert_cmpint(crucible_mutex_owner_cached_thread_id, ==, 0);
+    early_child_calls++;
+}
+
+static void late_child(void)
+{
+    if (atfork_depth < 1) {
+        return;
+    }
+    g_assert_false(crucible_mutex_owner_cache_suspended);
+    lock(&mutex);
+    late_child_owner = entry(&mutex)->owner_thread_id;
+    unlock(&mutex);
+    late_child_calls++;
+}
+
+static void wait_child(pid_t child)
+{
+    int status;
+    g_assert_cmpint(waitpid(child, &status, 0), ==, child);
+    g_assert_true(WIFEXITED(status));
+    g_assert_cmpint(WEXITSTATUS(status), ==, 0);
+}
+
+static void *worker(void *unused)
+{
+    (void)unused;
+    lock(&mutex);
+    worker_owner = entry(&mutex)->owner_thread_id;
+    unlock(&mutex);
+    for (unsigned int i = 0; i < 100; i++) {
+        lock(&mutex);
+        unlock(&mutex);
+    }
+    g_assert_cmpuint(tid_reads, ==, 1);
+    cached_identity();
+    return NULL;
+}
+
+static void steady_and_worker(void)
+{
+    pthread_t thread;
+    int64_t parent = syscall(SYS_gettid);
+    unsigned int before;
+
+    lock(&mutex);
+    unlock(&mutex);
+    before = tid_reads;
+    for (unsigned int i = 0; i < 1000; i++) {
+        lock(&mutex);
+        unlock(&mutex);
+    }
+    g_assert_cmpuint(tid_reads, ==, before);
+    cached_identity();
+    g_assert_cmpint(pthread_create(&thread, NULL, worker, NULL), ==, 0);
+    g_assert_cmpint(pthread_join(thread, NULL), ==, 0);
+    g_assert_cmpint(worker_owner, !=, parent);
+    g_assert_cmpint(crucible_mutex_owner_cached_thread_id, ==, parent);
+
+    qemu_rec_mutex_init(&recursive);
+    lock(&recursive.m);
+    lock(&recursive.m);
+    g_assert_cmpuint(entry(&recursive.m)->recursion_depth, ==, 2);
+    qemu_mutex_unlock_impl(&recursive.m, __FILE__, __LINE__);
+    assert_owner(&recursive.m);
+    unlock(&recursive.m);
+    g_assert_cmpint(qemu_mutex_trylock_impl(&mutex, __FILE__, __LINE__), ==, 0);
+    assert_owner(&mutex);
+    unlock(&mutex);
+
+    lock(&mutex);
+    crucible_hot_fork_mutex_condition_wait_begin(&mutex);
+    g_assert_cmpint(entry(&mutex)->condition_waiter_thread_id, ==, parent);
+    g_assert_cmpuint(entry(&mutex)->condition_waiters, ==, 1);
+    g_assert_cmpint(pthread_mutex_unlock(&mutex.lock), ==, 0);
+    g_assert_cmpint(pthread_mutex_lock(&mutex.lock), ==, 0);
+    crucible_hot_fork_mutex_condition_wait_end(&mutex);
+    assert_owner(&mutex);
+    unlock(&mutex);
+    g_assert_cmpuint(tid_reads, ==, before);
+
+    crucible_mutex_owner_cache_resume();
+    failed_tid = -1;
+    g_assert_cmpint(crucible_mutex_owner_thread_id(), ==, -1);
+    g_assert_cmpint(crucible_mutex_owner_cached_thread_id, ==, 0);
+    g_assert_cmpint(crucible_mutex_owner_thread_id(), ==, parent);
+}
+
+static void ordinary_forks(void)
+{
+    int64_t parent = syscall(SYS_gettid);
+    for (unsigned int i = 0; i < 4; i++) {
+        unsigned int before;
+        pid_t child = fork();
+        g_assert_cmpint(child, >=, 0);
+        if (!child) {
+            g_assert_cmpuint(early_child_calls, ==, 1);
+            g_assert_cmpuint(late_child_calls, ==, 1);
+            g_assert_cmpint(early_child_owner, ==, syscall(SYS_gettid));
+            g_assert_cmpint(late_child_owner, ==, syscall(SYS_gettid));
+            g_assert_cmpint(early_child_owner, !=, parent);
+            before = tid_reads;
+            lock(&mutex);
+            unlock(&mutex);
+            g_assert_cmpuint(tid_reads, ==, before);
+            _exit(0);
+        }
+        wait_child(child);
+        g_assert_cmpuint(early_child_calls, ==, 0);
+        g_assert_cmpuint(late_child_calls, ==, 0);
+        lock(&mutex);
+        unlock(&mutex);
+        g_assert_cmpint(crucible_mutex_owner_cached_thread_id, ==, parent);
+    }
+}
+
+static void native_reconstruction(void)
+{
+    QemuHotForkThreadRecord coordinator = {
+        .thread_id = syscall(SYS_gettid), .tracked = true,
+        .disposition = QEMU_THREAD_HOT_FORK_COORDINATOR,
+    };
+    QemuHotForkThreadRecord rcu = {
+        .thread_id = coordinator.thread_id + 1000000, .tracked = true,
+        .disposition = QEMU_THREAD_HOT_FORK_RCU_RESTART,
+    };
+    QemuHotForkThreadRecord monitor = {
+        .thread_id = coordinator.thread_id + 1000001, .tracked = true,
+        .disposition = QEMU_THREAD_HOT_FORK_MONITOR_RESTART,
+    };
+    QemuThreadHotForkRegistryTransaction transaction = {
+        .thread_generation = 1, .parent_process_id = getpid(),
+        .parent_thread_id = coordinator.thread_id,
+        .coordinator_record = &coordinator,
+        .restart_thread_ids = { rcu.thread_id, monitor.thread_id },
+        .restart_thread_count = 2,
+        .carried_mutexes = {{ mutex.crucible_hot_fork_registration_id,
+                             mutex.crucible_hot_fork_slot }},
+        .carried_count = 1, .active = true,
+    };
+    pid_t child;
+
+    qemu_hot_fork_thread_generation = 1;
+    qemu_hot_fork_thread_count = 3;
+    qemu_hot_fork_coordinator_thread_id = coordinator.thread_id;
+    qemu_hot_fork_current_thread = &coordinator;
+    qemu_hot_fork_threads = g_list_append(qemu_hot_fork_threads, &coordinator);
+    qemu_hot_fork_threads = g_list_append(qemu_hot_fork_threads, &rcu);
+    qemu_hot_fork_threads = g_list_append(qemu_hot_fork_threads, &monitor);
+    atfork_depth = 0;
+    lock(&mutex);
+    crucible_hot_fork_mutex_registry_lock();
+    g_assert_cmpint(pthread_mutex_lock(&qemu_hot_fork_thread_lock), ==, 0);
+    child = fork();
+    g_assert_cmpint(child, >=, 0);
+    if (!child) {
+        /* Model an inherited cache when a caller bypasses atfork reset. */
+        crucible_mutex_owner_cached_thread_id = transaction.parent_thread_id;
+        g_assert_cmpint(qemu_thread_hot_fork_reconstruct_child_registry(
+                            &transaction), ==, 0);
+        g_assert_true(transaction.child_reconstructed);
+        g_assert_cmpint(crucible_mutex_owner_cached_thread_id, ==,
+                        syscall(SYS_gettid));
+        g_assert_cmpint(qemu_thread_current_id(), ==, syscall(SYS_gettid));
+        cached_identity();
+        assert_owner(&mutex);
+        unlock(&mutex);
+        lock(&mutex);
+        unlock(&mutex);
+        g_assert_cmpint(coordinator.thread_id, ==, syscall(SYS_gettid));
+        _exit(0);
+    }
+    g_assert_cmpint(qemu_thread_hot_fork_release_parent_registry_transaction(
+                        &transaction), ==, 0);
+    unlock(&mutex);
+    wait_child(child);
+    g_assert_cmpint(coordinator.thread_id, ==, syscall(SYS_gettid));
+    g_list_free(qemu_hot_fork_threads);
+    qemu_hot_fork_threads = NULL;
+}
+
+static void registration_failure(void)
+{
+    unsigned int before;
+    fail_registration = true;
+    before = tid_reads;
+    for (unsigned int i = 0; i < 10; i++) {
+        g_assert_cmpint(qemu_thread_current_id(), ==, syscall(SYS_gettid));
+    }
+    g_assert_cmpuint(tid_reads, ==, before + 10);
+    g_assert_false(crucible_mutex_owner_cache_enabled);
+    qemu_mutex_init(&mutex);
+    g_assert_false(crucible_mutex_owner_cache_enabled);
+    before = tid_reads;
+    for (unsigned int i = 0; i < 10; i++) {
+        lock(&mutex);
+        unlock(&mutex);
+    }
+    g_assert_cmpuint(tid_reads, ==, before + 20);
+    g_assert_cmpint(crucible_mutex_owner_cached_thread_id, ==, 0);
+    qemu_mutex_destroy(&mutex);
+    puts("PASS production mutex owner cache: registration failure uses uncached IDs");
+}
+"""
+
+MAIN = r"""
+int main(int argc, char **argv)
+{
+    if (argc == 2 && strcmp(argv[1], "first-access") == 0) {
+        first_access_before_mutex();
+        return 0;
+    }
+    if (argc == 2 && strcmp(argv[1], "registration-failure") == 0) {
+        registration_failure();
+        return 0;
+    }
+    /* RCU registers its child callback before its first tracked mutex exists. */
+    g_assert_cmpint(pthread_atfork(early_prepare, NULL, rcu_init_child), ==, 0);
+    qemu_mutex_init(&mutex);
+    g_assert_true(crucible_mutex_owner_cache_enabled);
+    g_assert_cmpint(pthread_atfork(NULL, NULL, late_child), ==, 0);
+    steady_and_worker();
+    contending_mutex_ownership();
+    ordinary_forks();
+    native_reconstruction();
+    qemu_mutex_destroy(&recursive.m);
+    qemu_mutex_destroy(&mutex);
+    puts("PASS production mutex owner cache: no steady syscalls, contending mutex-registry handoffs, real fork ownership, atfork ordering, native refresh");
+    return 0;
+}
+"""
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--output-dir", type=Path, required=True)
+    parser.add_argument("--negative-control", choices=[
+        "cache", "atfork", "native",
+    ])
+    arguments = parser.parse_args()
+    arguments.output_dir.mkdir(parents=True, exist_ok=True)
+    source = (ROOT / "util/qemu-thread-posix.c").read_text()
+    mutex_globals = source[source.index("static pthread_mutex_t crucible_hot_fork_mutex_registry_guard"):
+                           source.index("/*\n * This is not defined on Linux")]
+    mutex_globals += "\nstatic __thread bool crucible_hot_fork_mutex_registry_held;\n"
+    thread_globals = source[source.index("struct QemuThreadRamActorBinding {"):
+                            source.index("static pthread_mutex_t ram_writer_lock")]
+    thread_globals += "\nstatic char qemu_hot_fork_registry_blocker[256];\n"
+    carriers = source[source.index("typedef struct CrucibleHotForkMutexCarrier {"):
+                      source.index("static bool crucible_hot_fork_carrier_is_restart_thread(")]
+    signatures = [
+        "static void crucible_hot_fork_mutex_registry_lock(",
+        "static void crucible_hot_fork_mutex_registry_unlock(",
+        "static void crucible_hot_fork_mutex_latch_inconsistent(",
+        "static void crucible_hot_fork_mutex_changed(",
+        "static void crucible_hot_fork_mutex_slots_init(",
+        "static size_t crucible_hot_fork_mutex_address_hash(",
+        "static bool crucible_hot_fork_mutex_address_find(",
+        "static bool crucible_hot_fork_mutex_address_insert(",
+        "static bool crucible_hot_fork_mutex_address_remove(",
+        "static void crucible_hot_fork_mutex_address_rebuild(",
+        "static bool crucible_hot_fork_mutex_entry_quiescent(",
+        "static CrucibleHotForkMutexEntry *crucible_hot_fork_mutex_entry(",
+        "static void crucible_hot_fork_mutex_register(",
+        "static void crucible_hot_fork_mutex_wait_begin(",
+        "static void crucible_hot_fork_mutex_wait_cancel(",
+        "static void crucible_hot_fork_mutex_acquired(",
+        "static void crucible_hot_fork_mutex_unlock_begin(",
+        "static void crucible_hot_fork_mutex_unlock_end(",
+        "static void crucible_hot_fork_mutex_condition_wait_begin(",
+        "static void crucible_hot_fork_mutex_condition_wait_end(",
+        "void qemu_mutex_init(", "void qemu_mutex_destroy(",
+        "void qemu_mutex_lock_impl(", "int qemu_mutex_trylock_impl(",
+        "void qemu_mutex_unlock_impl(", "void qemu_rec_mutex_init(",
+        "static bool crucible_hot_fork_carrier_is_restart_thread(",
+        "static CrucibleHotForkMutexDisposition crucible_hot_fork_mutex_disposition(",
+        "static bool qemu_hot_fork_registered_mutexes_carried(",
+        "static CrucibleHotForkMutexEntry *crucible_hot_fork_registered_mutex(",
+        "static bool crucible_hot_fork_registration_equal(",
+        "static bool qemu_hot_fork_copied_thread_list_matches(",
+        "static void crucible_hot_fork_mutex_adopt_in_child(",
+        "int qemu_thread_hot_fork_release_parent_registry_transaction(",
+        "int qemu_thread_hot_fork_reconstruct_child_registry(",
+    ]
+    bodies = "\n\n".join(definition(source, signature) for signature in signatures)
+    if arguments.negative_control == "cache":
+        cached = definition(mutex_globals, "static int64_t crucible_mutex_owner_thread_id(")
+        mutex_globals = mutex_globals.replace(cached,
