+/* Volatile fixed byte providers prevent source calls to libc. Configured
+ * code still must prove no compiler-generated PLT/TLS/allocator dependency.
+ */
+static int preexec_setup_compare(const void *first, const void *second, size_t bytes)
+{
+    const volatile uint8_t *left = first;
+    const volatile uint8_t *right = second;
+
+    for (size_t index = 0; index < bytes; index++) {
+        if (left[index] != right[index]) {
+            return left[index] < right[index] ? -1 : 1;
+        }
+    }
+    return 0;
+}
+
+static void *preexec_setup_copy(void *destination, const void *source, size_t bytes)
+{
+    volatile uint8_t *out = destination;
+    const volatile uint8_t *in = source;
+
+    for (size_t index = 0; index < bytes; index++) {
+        out[index] = in[index];
+    }
+    return destination;
+}
