+SOURCE_INPUTS = (
+    "accel/tcg/tcg-accel-ops-rr.c",
+    "plugins/api-system.c",
+    "plugins/crucible-native-invocation.c",
+    "plugins/crucible-startup-source.c",
+    "plugins/crucible-callback-publication.inc.h",
+    "util/event.c",
+    "util/qemu-thread-posix.c",
+    "util/qsp.c",
+)
+
+# These literal inputs are absent from the owning extractor's inventory. Their
+# pins bind the same reviewed source cohort and cannot replace existing pins.
+SUPPLEMENTAL_SOURCE_HASHES = {
+    "util/event.c":
+        "bc9693b7bf9efef552377aa484ed5b8892cfc6f866964d87895923e914591033",
+    "util/qsp.c":
+        "0ae990c42b035709ec7e321a76458823cbddfc6771894790cf796a03d76483cd",
+}
+
+
+def validated_sources(root):
+    # Reuse the owning extractor's pins without running its unrelated emitters
+    # or reading its whole inventory. Every consumed literal input needs a pin.
+    authoritative = EXTRACT["SOURCE_HASHES"]
+    supplemental = set(SUPPLEMENTAL_SOURCE_HASHES)
+    inputs = set(SOURCE_INPUTS)
+    if (len(inputs) != len(SOURCE_INPUTS) or
+            supplemental != inputs - authoritative.keys()):
+        raise ValueError("settle-prepark source pin inventory changed")
+
+    sources = {}
+    for name in SOURCE_INPUTS:
+        expected = (authoritative[name] if name in authoritative else
+                    SUPPLEMENTAL_SOURCE_HASHES[name])
+        data = (root / name).read_bytes()
+        if hashlib.sha256(data).hexdigest() != expected:
+            raise ValueError(f"source changed: {name}")
+        sources[name] = data.decode()
+    return sources
+
+
+def definition(source, signature):
+    for _, _, _, body in EXTRACT["function_definitions"](source):
+        if body.startswith(signature):
+            return body.rstrip()
+    raise ValueError(f"function definition missing: {signature}")
+
+
+def selected(source, name):
+    for current, _, _, body in EXTRACT["function_definitions"](source):
+        if current == name:
+            return body
+    raise ValueError(f"function definition missing: {name}")
+
+
+def ordinary_native_dependencies(sources, api):
+    native = sources["plugins/crucible-native-invocation.c"]
+    source = sources["plugins/crucible-startup-source.c"]
+    publication = sources["plugins/crucible-callback-publication.inc.h"]
+    thread = sources["util/qemu-thread-posix.c"]
+    declarations = EXTRACT["body_cut"](
+        api, "static struct {\n    QemuCrucibleNativeRegistration *control;",
+        "static qemu_plugin_time_advance_cb_t")
+    declarations += EXTRACT["body_cut"](
+        source, "static QemuCrucibleStartupSourceControl startup_source = {",
+        "static int startup_failure(")
+    declarations += "\nstruct qemu_plugin_state plugin;\n"
+    names = (
+        "qemu_plugin_crucible_native_group_member_count_v1",
+        "native_selection", "native_dispatch_hint", "registry_process_current",
+        "registry_identity_locked", "registry_current_locked", "group_index",
+        "group_source_object_identity", "group_identity_locked", "top_locked",
+        "frame_member_locked", "registration_locked", "frame_reclaim_locked",
+        "frame_identity_locked", "frame_cpu_pin_return",
+        "qemu_plugin_crucible_native_enter_v1",
+        "qemu_plugin_crucible_native_mask_v1",
+        "qemu_plugin_crucible_native_exit_v1",
+        "qemu_plugin_crucible_native_group_use_begin_v1",
+        "qemu_plugin_crucible_native_group_use_end_v1",
+    )
+    bodies = [selected(publication, name) for name in (
+        "qemu_crucible_startup_source_native_selection_v1",
+        "qemu_crucible_startup_source_native_dispatch_hint_v1",
+    )]
+    bodies += [selected(thread, name) for name in
+               ("qemu_thread_get_self", "qemu_thread_is_self")]
+    # Canonical unselected state never enters these registry locks.
+    for name in ("qemu_mutex_lock_impl", "qemu_mutex_unlock_impl",
+                 "qemu_rec_mutex_lock_impl", "qemu_rec_mutex_unlock_impl"):
+        signature = selected(thread, name).split("{", 1)[0]
