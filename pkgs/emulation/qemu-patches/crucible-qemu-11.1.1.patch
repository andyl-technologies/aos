+    g_test_add_func("/crucible/idle-wait/core/stop-before-park",
+                    test_stop_before_park_requires_rescan);
+    g_test_add_func("/crucible/idle-wait/core/unplug-before-park",
+                    test_unplug_before_park_requires_rescan);
+    g_test_add_func("/crucible/idle-wait/core/cpu-list-invalidation",
