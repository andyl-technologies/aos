+int qemu_crucible_parent_park_terminal_write_v2(QemuCrucibleParentParkReceive *receive)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleParentParkReceive *owner = &startup_source.parent_park_receive;
+    QemuCrucibleCommandConsumerMember *member = &startup_source.command_member;
+    QemuCrucibleParkReturnWriterRole *writer = &member->park_writer;
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    QemuCrucibleParkReturnWriteProgress progress = { 0 };
+    int callback_status;
+    int first;
+    int status = parent_park_main_identity(true);
+
+    if (status) {
+        return status;
+    }
+    status = parent_park_receive_identity(receive);
+    if (status) {
+        return status;
+    }
+    if (qatomic_cmpxchg(&owner->busy, false, true)) {
+        return -EBUSY;
+    }
+    qemu_mutex_lock(&commands->mutex);
+    status = command_member_identity_locked(member);
+    if (!status && (owner->creating || !owner->terminal_ready ||
+                    !owner->request_returned || !owner->descriptors_returned ||
+                    !owner->prepared_returned || owner->borrowers ||
+                    owner->metadata_users ||
+                    writer->receive != owner || writer->attempted ||
+                    writer->invoking || writer->uncertain ||
+                    writer->loan_sequence != owner->binding.loan_sequence ||
+                    writer->request_correlation != owner->binding.request_correlation ||
+                    member->park_writer_users)) {
+        status = -EBUSY;
+    }
+    if (status) {
+        qemu_mutex_unlock(&commands->mutex);
+        qatomic_store_release(&owner->busy, false);
+        return status;
+    }
+    writer->attempted = true;
+    writer->invoking = true;
+    member->park_writer_users++;
+    parent_park_terminal_encode(owner, writer->wire);
+    qemu_mutex_unlock(&commands->mutex);
+
+    SOURCE_CALLBACK_MASKED_INVOKE(
+        callback_status, &writer->callback, writer->callback, member->child->address,
+        writer->wire, sizeof(writer->wire), &progress, member->child->address);
+
+    qemu_mutex_lock(&commands->mutex);
+    /* Preserve every born/uncertain write observation before signed status or
+     * protocol validation. A negative callback never authorizes replay. */
+    writer->progress = progress;
+    writer->callback_status = callback_status;
+    writer->validation_status =
+        parent_park_write_progress_valid(&progress, callback_status) ?
+        0 : -EPROTO;
+    writer->uncertain = writer->validation_status || progress.publication_uncertain ||
+        (progress.write_attempted && !progress.writer_released);
+    first = progress.first_status < 0 ? progress.first_status :
+        callback_status < 0 ? callback_status :
+        writer->validation_status ? writer->validation_status :
+        progress.post_status < 0 ? progress.post_status :
+        writer->uncertain ? -EBUSY :
+        !progress.return_published ? -EIO : 0;
+    parent_park_fail(owner, first, false);
+    qemu_mutex_unlock(&commands->mutex);
+
+    /* Final pair observations preceded physical return. After the original
+     * request and descriptors return, only retained transport identity may be
+     * checked; a writer call cannot resurrect a policy or request borrow. */
+    qemu_mutex_lock(&commands->mutex);
+    status = command_member_identity_locked(member);
+    if (!status && (writer->receive != owner ||
+                    writer->loan_sequence != owner->binding.loan_sequence ||
+                    writer->request_correlation != owner->binding.request_correlation ||
+                    member->park_writer_users != 1)) {
+        status = -ESTALE;
+    }
+    if (status) {
+        writer->uncertain = true;
+        parent_park_fail(owner, status, true);
+    } else if (!writer->uncertain) {
+        member->park_writer_users--;
+        owner->terminal_published = progress.return_published;
+    }
+    writer->invoking = false;
+    status = owner->first_status;
+    qemu_mutex_unlock(&commands->mutex);
+    qatomic_store_release(&owner->busy, false);
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
