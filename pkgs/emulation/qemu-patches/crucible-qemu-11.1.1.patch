+FUNCTION_DEFINITION = re.compile(
+    r"(?m)^(?:(?:static|inline|extern)\s+)*"
+    r"(?:[A-Za-z_]\w*\s+)+"
+    r"(?:\*\s*(?:(?:const|volatile|restrict)\s+)*)*"
+    r"([A-Za-z_]\w*)\s*\([^;{}]*?\)\s*\n\{")
