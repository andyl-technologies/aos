+/* Corroborates a separately authenticated physical edge; this predicate
+ * neither observes the callback nor grants an Original or a storage loan. */
+static bool initial_register_borrow_closed_facts(
+    const QemuCrucibleInitialRegisterWorkspaceOwner *owner,
+    bool authenticated, int first, int post)
+{
