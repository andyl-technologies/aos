+    if (!s->vapic_paddr) {
+        *tpr = s->tpr;
+        return true;
+    }
+    WITH_RCU_READ_LOCK_GUARD() {
+        region = address_space_translate(&address_space_memory,
+                                         s->vapic_paddr, &offset, &length,
+                                         false, MEMTXATTRS_UNSPECIFIED);
+        if (!region || !memory_region_is_ram(region) ||
+            memory_region_is_ram_device(region) ||
+            length < sizeof(vapic_state)) {
+            error_setg(errp,
+                       "APIC VAPIC state at 0x%" HWADDR_PRIx
+                       " is not backed by ordinary guest RAM",
+                       s->vapic_paddr);
+            return false;
+        }
+        memcpy(&vapic_state,
+               (uint8_t *)memory_region_get_ram_ptr(region) + offset,
+               sizeof(vapic_state));
+    }
+    *tpr = vapic_state.tpr;
+    return true;
