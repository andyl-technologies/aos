+            .function = accelerator_restore_cb,
+            .userdata = accelerator_userdata,
+            .userdata_coordinate = &accelerator_userdata,
+            .kind = QEMU_CRUCIBLE_NATIVE_REGISTERED,
+        };
+        return true;
+    case 5:
+        *out = (QemuCrucibleNativeGroupDescriptorView) {
+            .coordinate = &accelerator_restore_commit_cb,
+            .function = accelerator_restore_commit_cb,
+            .userdata = accelerator_userdata,
+            .userdata_coordinate = &accelerator_userdata,
+            .kind = QEMU_CRUCIBLE_NATIVE_REGISTERED,
+        };
+        return true;
+    case 6:
