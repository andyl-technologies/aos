diff --git a/tests/unit/test-crucible-ahci-fingerprint.c b/tests/unit/test-crucible-ahci-fingerprint.c
new file mode 100644
index 0000000000000000000000000000000000000000..b0522d7ecc1acfddf400f671a89967e58a28b1da
--- /dev/null
+++ b/tests/unit/test-crucible-ahci-fingerprint.c
@@ -0,0 +1,145 @@
+/*
+ * ICH9 AHCI fingerprint projection tests
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+#include "qemu/osdep.h"
+
+#include "hw/ide/ich-fingerprint.h"
+#include "io/channel-file.h"
+#include "qemu/module.h"
+
+static GBytes *project_ahci(AHCIState *ahci, bool expected_success)
+{
+    char *path = NULL;
+    int read_fd;
+    int write_fd = g_file_open_tmp("qemu-ahci-fingerprint-XXXXXX", &path,
+                                   NULL);
+    QIOChannelFile *channel;
+    QEMUFile *file;
+    Error *error = NULL;
+    struct stat stat_buffer;
+    bool success;
+
+    g_assert_cmpint(write_fd, >=, 0);
+    read_fd = dup(write_fd);
+    g_assert_cmpint(read_fd, >=, 0);
+    unlink(path);
+    g_free(path);
+    channel = qio_channel_file_new_fd(write_fd);
+    file = qemu_file_new_output(QIO_CHANNEL(channel));
+
+    success = ich9_ahci_state_fingerprint_validate(ahci, &error);
+    g_assert_cmpint(success, ==, expected_success);
+    if (success) {
+        ich9_ahci_state_fingerprint_put(file, ahci);
+    }
+    if (!success) {
+        g_assert_nonnull(error);
+        error_free(error);
+        qemu_fclose(file);
+        g_assert_cmpint(fstat(read_fd, &stat_buffer), ==, 0);
+        g_assert_cmpuint(stat_buffer.st_size, ==, 0);
+        object_unref(OBJECT(channel));
+        close(read_fd);
+        return NULL;
+    }
+    g_assert_null(error);
+    g_assert_cmpint(qemu_fflush(file), ==, 0);
+    g_assert_cmpint(qemu_fclose(file), ==, 0);
+
+    g_assert_cmpint(fstat(read_fd, &stat_buffer), ==, 0);
+    g_autofree uint8_t *data = g_malloc(stat_buffer.st_size);
+    g_assert_cmpint(pread(read_fd, data, stat_buffer.st_size, 0), ==,
+                    stat_buffer.st_size);
+    GBytes *bytes = g_bytes_new(data, stat_buffer.st_size);
+    object_unref(OBJECT(channel));
+    close(read_fd);
+    return bytes;
+}
+
+static void initialize_ahci(AHCIState *ahci, AHCIDevice *port)
+{
+    memset(ahci, 0, sizeof(*ahci));
+    memset(port, 0, sizeof(*port));
+    ahci->ports = 1;
+    ahci->dev = port;
+    port->port_no = 0;
+    port->port.max_units = 1;
+    port->port.ifs[0].unit = 0;
+}
+
+static void test_ahci_retry_state(void)
+{
+    AHCIState ahci;
+    AHCIDevice port;
+    g_autoptr(GBytes) baseline = NULL;
+    g_autoptr(GBytes) retry = NULL;
+    g_autoptr(GBytes) inactive_history = NULL;
+
+    initialize_ahci(&ahci, &port);
+    baseline = project_ahci(&ahci, true);
+
+    port.port.retry_sector_num = 17;
+    port.port.retry_nsector = 2;
+    inactive_history = project_ahci(&ahci, true);
+    g_assert_true(g_bytes_equal(baseline, inactive_history));
+
+    port.port.error_status = 1;
+    retry = project_ahci(&ahci, true);
+    g_assert_false(g_bytes_equal(inactive_history, retry));
+}
+
+static void test_ahci_inactive_ncq_history(void)
+{
+    AHCIState ahci;
+    AHCIDevice port;
+    g_autoptr(GBytes) first = NULL;
+    g_autoptr(GBytes) second = NULL;
+
+    initialize_ahci(&ahci, &port);
+    port.ncq_tfs[3].sector_count = 8;
+    port.ncq_tfs[3].lba = 0x1234;
+    port.ncq_tfs[3].tag = 9;
+    port.ncq_tfs[3].slot = 11;
+    first = project_ahci(&ahci, true);
+
+    port.ncq_tfs[3].sector_count = 16;
+    port.ncq_tfs[3].lba = 0x5678;
+    port.ncq_tfs[3].tag = 13;
+    port.ncq_tfs[3].slot = 15;
+    second = project_ahci(&ahci, true);
+    g_assert_true(g_bytes_equal(first, second));
+}
+
+static void test_ahci_rejects_ide_and_invalid_ncq(void)
+{
+    AHCIState ahci;
+    AHCIDevice port;
+
+    initialize_ahci(&ahci, &port);
+    port.port.ifs[0].blk = (BlockBackend *)(uintptr_t)1;
+    g_assert_null(project_ahci(&ahci, false));
+
+    port.port.ifs[0].blk = NULL;
+    port.ncq_tfs[1].used = true;
+    g_assert_null(project_ahci(&ahci, false));
+
+    port.ncq_tfs[1].halt = true;
+    port.ncq_tfs[1].slot = 1;
+    port.ncq_tfs[1].tag = 1;
+    g_assert_null(project_ahci(&ahci, false));
+}
+
+int main(int argc, char **argv)
+{
+    module_call_init(MODULE_INIT_QOM);
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/crucible/ahci/retry-state", test_ahci_retry_state);
+    g_test_add_func("/crucible/ahci/inactive-ncq-history",
+                    test_ahci_inactive_ncq_history);
+    g_test_add_func("/crucible/ahci/reject-ide-invalid-ncq",
+                    test_ahci_rejects_ide_and_invalid_ncq);
+    return g_test_run();
+}
