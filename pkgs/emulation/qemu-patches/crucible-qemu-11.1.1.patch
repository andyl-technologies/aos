+static bool virtio_9p_fingerprint_projection(QEMUFile *f,
+                                             const void *opaque,
+                                             Error **errp)
+{
+    const V9fsVirtioState *v = opaque;
+    const char *mount_tag = v->state.fsconf.tag ? v->state.fsconf.tag : "";
+    const char *fsdev_id = v->state.fsconf.fsdev_id ?
+        v->state.fsconf.fsdev_id : "";
+    size_t mount_tag_length = strlen(mount_tag);
+    size_t fsdev_id_length = strlen(fsdev_id);
+    uint32_t active_elements = 0;
+
+    if (mount_tag_length > UINT16_MAX || fsdev_id_length > UINT16_MAX ||
+        v->config_size > UINT32_MAX) {
+        error_setg(errp, "virtio-9p projection has invalid configuration");
+        return false;
+    }
+    if (v->crucible_9p_pending_pdu &&
+        (v->crucible_9p_pending_pdu->idx >= MAX_REQ ||
+         !v->elems[v->crucible_9p_pending_pdu->idx] ||
+         v->crucible_9p_pending_response_capacity > UINT32_MAX)) {
+        error_setg(errp, "virtio-9p projection has invalid continuation");
+        return false;
+    }
+    if (!virtio_save_fingerprint_projection(f, VIRTIO_DEVICE(v), errp)) {
+        return false;
+    }
+
+    qemu_put_be16(f, mount_tag_length);
+    qemu_put_buffer(f, (const uint8_t *)mount_tag, mount_tag_length);
+    qemu_put_be16(f, fsdev_id_length);
+    qemu_put_buffer(f, (const uint8_t *)fsdev_id, fsdev_id_length);
+    qemu_put_be32(f, v->config_size);
+    qemu_put_be32(f, v->next_crucible_9p_request_id);
+    qemu_put_byte(f, v->crucible_9p_burst_active);
+    for (size_t index = 0; index < MAX_REQ; index++) {
+        if (v->elems[index]) {
+            active_elements++;
+        }
+    }
+    qemu_put_be32(f, active_elements);
+    for (size_t index = 0; index < MAX_REQ; index++) {
+        const V9fsPDU *pdu = &v->state.pdus[index];
+
+        if (!v->elems[index]) {
+            continue;
+        }
+        qemu_put_be32(f, index);
+        qemu_put_be32(f, pdu->size);
+        qemu_put_be16(f, pdu->tag);
+        qemu_put_byte(f, pdu->id);
+        qemu_put_byte(f, pdu->cancelled);
+        qemu_put_virtqueue_element(VIRTIO_DEVICE(v), f, v->elems[index]);
+    }
+    qemu_put_byte(f, v->crucible_9p_pending_pdu != NULL);
+    if (v->crucible_9p_pending_pdu) {
+        qemu_put_be32(f, v->crucible_9p_pending_pdu->idx);
+        qemu_put_be32(f, v->crucible_9p_pending_request_id);
+        qemu_put_be32(f, v->crucible_9p_pending_response_capacity);
+    }
+    return qemu_file_get_error(f) == 0;
+}
