+int qemu_plugin_crucible_checkpoint_candidate_read_observe_v1(
+    qemu_plugin_id_t id,
+    qemu_plugin_crucible_checkpoint_candidate_read_v1 *loan,
+    struct qemu_plugin_crucible_checkpoint_candidate_read_status_v1 *out)
+{
+    QemuCrucibleCheckpointHeldTransaction *owner = &checkpoint_transaction;
