+int qemu_plugin_crucible_advance_receiver_observe_v1(
+    QemuCrucibleSourceAdvanceReceiver *receiver, uint32_t version, size_t bytes,
+    struct qemu_plugin_crucible_advance_receiver_observation_v1 *out)
+{
+#if defined(CONFIG_LINUX) && defined(__x86_64__) && !defined(__ILP32__)
+    struct qemu_plugin_crucible_advance_receiver_observation_v1 observed;
+    int first = advance_observation_output(receiver, version, bytes, out,
+                                            sizeof(*out), _Alignof(*out));
+    int post;
+
+    if (first) {
+        return first;
+    }
+    first = advance_observation_current(receiver, QEMU_CRUCIBLE_ADVANCE_CALLBACK_ACQUIRE);
+    observed = (struct qemu_plugin_crucible_advance_receiver_observation_v1) {
+        .schema_version = 1,
+        .struct_size = sizeof(observed),
+        .binding = receiver->binding,
+    };
+    post = advance_observation_current(receiver, QEMU_CRUCIBLE_ADVANCE_CALLBACK_ACQUIRE);
+    advance_observation_record(receiver, first, post);
+    if (!first && !post) {
+        *out = observed;
+    }
+    return first ? first : post;
+#else
+    return -ENOTSUP;
+#endif
+}
