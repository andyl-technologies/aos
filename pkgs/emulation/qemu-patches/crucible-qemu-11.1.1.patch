+    owner->current_attempted = true;
+    owner->current_post_recorded = true;
+    if (!owner->current_first_status) {
+        owner->current_first_status = first;
+    }
+    if (!owner->current_post_status) {
+        owner->current_post_status = post;
+    }
+    if (!owner->first_status) {
+        owner->first_status = first ? first : post;
+    }
+}
