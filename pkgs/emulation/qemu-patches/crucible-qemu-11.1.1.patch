+int qemu_plugin_crucible_fingerprint_worker_material_read_v2(
+    QemuCrucibleFingerprintWorker *worker, const QemuCrucibleFingerprintWorkRef *reference,
+    size_t requested, struct qemu_plugin_crucible_fingerprint_material_read_v1 *out)
+{
+    struct qemu_plugin_crucible_fingerprint_material_read_v1 receipt;
+    QemuCrucibleFingerprintMaterial *material;
+    uint64_t slice, progress;
+    ssize_t physical_result;
+    int first;
+    int status = qemu_plugin_crucible_fingerprint_worker_material_current_v2(
+        worker, reference, &slice);
