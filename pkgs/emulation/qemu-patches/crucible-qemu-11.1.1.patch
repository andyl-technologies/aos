+    with_machine(qemu, plugin, "aarch64", check_pflash)
+
+    print("aarch64_projection_repeat_nonmutation=true")
+    print("aarch64_virtio_net_bh_projection=true")
+    print("virtio_net_scheduler_kind_sensitivity=true")
+    print("acpi_ged_event_sensitivity=true")
+    print("acpi_ged_inactive_history_convergence=true")
+    print("gic_pending_sensitivity=true")
+    print("gic_inactive_history_convergence=true")
+    print("gic_reset_convergence=true")
+    print("pflash_active_buffer_sensitivity=true")
+    print("pflash_inactive_history_convergence=true")
