+            g_assert_false(preexec_setup_owner.descriptor_roster_known);
+        }
+    } else {
+        g_assert_cmpuint(preexec_setup_owner.descriptor_count, ==, 0);
+    }
+    g_assert_cmpint(preexec_setup_receive_once(), ==, expected);
+}
