diff --git a/plugins/crucible-clock-custody.inc.h b/plugins/crucible-clock-custody.inc.h
new file mode 100644
index 0000000000000000000000000000000000000000..608a1a66b260f3e915671af94dca8ff245e01bad
--- /dev/null
+++ b/plugins/crucible-clock-custody.inc.h
@@ -0,0 +1,456 @@
+/*
+ * Actual Source software-APIC registration and physical callback joins
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifdef CONFIG_LINUX
+static int clock_owner_identity(QemuCrucibleCpuSourceAllocationOwner *owner)
+{
+    int status = cpu_allocation_identity_locked(owner);
+
+    if (!status) {
+        status = cpu_metadata_account_identity(&startup_source.cpu_metadata_account);
+    }
+    return status;
+}
+
+/* The actual initialized Native observer runs outside the Source mutex. */
+static int clock_child_observe(CPUState *cpu, QemuCrucibleClockChildView *view)
+{
+    CPUClass *klass;
+
+    if (!cpu || !view || !bql_locked() || !OBJECT(cpu)->ref) {
+        return -EPERM;
+    }
+    klass = CPU_GET_CLASS(cpu);
+    return klass->crucible_clock_child_observe ?
+        klass->crucible_clock_child_observe(cpu, view) : -ENOTSUP;
+}
+
+static int clock_allocation_observe(Object *object,
+    QemuCrucibleCpuSourceAllocationOwner **owner, uint64_t *generation)
+{
+    QemuCrucibleCpuAllocationReceipt *receipt = NULL;
+
+    return qemu_crucible_startup_source_cpu_instance_identity_v1(
+        object, owner, &receipt, generation);
+}
+
+static bool clock_registration_returned(const QemuCrucibleClockSourceJournal *clock)
+{
+    return !clock->active && clock->unregister_attempted &&
+        clock->row_removed && clock->unregister_post_recorded &&
+        !clock->unregister_first_status && !clock->unregister_post_status &&
+        !clock->callback.held;
+}
+
+static bool clock_journal_closed(const QemuCrucibleClockSourceJournal *clock)
+{
+    return clock->held && clock_registration_returned(clock);
+}
+
+int qemu_crucible_source_clock_register_begin_v1(
+    CPUState *cpu, QemuCrucibleClockStorage *storage, QEMUTimer *timer)
+{
+    QemuCrucibleObservationConstructionBinding *binding = NULL;
+    QemuCrucibleClockChildView view = { 0 };
+    QemuCrucibleCpuSourceAllocationOwner *owner = NULL, *parent = NULL;
+    uint64_t generation = 0, parent_generation = 0;
+    int status;
+
+    status = qemu_crucible_startup_source_observation_construction_borrow_v1(&binding);
+    if (!status) {
+        status = clock_child_observe(cpu, &view);
+    }
+    if (!status && (!storage || view.storage != storage ||
+        view.timer != timer || !storage->constructing ||
+        storage->construction_process != getpid() ||
+        !qemu_thread_is_self(&storage->construction_thread) ||
+        !storage->construction_serial || !view.child ||
+        !OBJECT(cpu)->ref || !view.child->ref)) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        status = clock_allocation_observe(OBJECT(cpu), &parent, &parent_generation);
+    }
+    if (!status) {
+        status = clock_allocation_observe(view.child, &owner, &generation);
+    }
+    if (!status) {
+        size_t child_bytes = object_get_instance_size(view.child);
+        size_t parent_bytes = object_get_instance_size(OBJECT(cpu));
+        uintptr_t base = (uintptr_t)view.child;
+        uintptr_t scratch = (uintptr_t)storage;
+        uintptr_t timer_base = (uintptr_t)timer;
+
+        if (owner->payload_bytes != child_bytes || parent->payload_bytes != parent_bytes ||
+            child_bytes > UINTPTR_MAX - base || scratch < base ||
+            sizeof(*storage) > child_bytes || scratch - base > child_bytes - sizeof(*storage) ||
+            timer_base < base || sizeof(*timer) > child_bytes ||
+            timer_base - base > child_bytes - sizeof(*timer) ||
+            !(scratch + sizeof(*storage) <= timer_base ||
+              timer_base + sizeof(*timer) <= scratch)) {
+            status = -EOVERFLOW;
+        }
+    }
+    if (!status && storage->owner) {
+        status = qemu_crucible_fault_clock_storage_current_v1(storage, false);
+    }
+    if (status) {
+        return status;
+    }
+    /* Reject inherited process state before touching its registry mutex. */
+    if (getpid() != startup_source.owner_process) {
+        return -EPERM;
+    }
+    pthread_mutex_lock(&startup_source.cpu_allocations.lock);
+    status = clock_owner_identity(owner);
+    if (!status) {
+        status = clock_owner_identity(parent);
+    }
+    if (!status && (owner == parent || owner->binding != binding ||
+        parent->binding != binding || owner->clock.held || owner->getter.held ||
+        owner->clock.callback.held || parent->clock_children == UINT_MAX ||
+        owner->request_serial != generation ||
+        parent->request_serial != parent_generation)) {
+        status = -ESTALE;
+    }
+    if (!status && (storage->owner || owner->clock.storage) &&
+        (storage->owner != owner || owner->clock.storage != storage ||
+         !storage->unregister_returned ||
+         !clock_registration_returned(&owner->clock))) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        uint64_t callback_serial = owner->clock.callback_serial;
+
+        owner->clock = (QemuCrucibleClockSourceJournal) {
+            .storage = storage, .parent = parent, .cpu = cpu,
+            .child = view.child, .timer = timer,
+            .generation = generation, .parent_generation = parent_generation,
+            .construction_serial = storage->construction_serial,
+            .callback_serial = callback_serial, .held = true,
+        };
+        parent->clock_children++;
+        storage->owner = owner;
+        storage->unregister_returned = false;
+    }
+    pthread_mutex_unlock(&startup_source.cpu_allocations.lock);
+    return status;
+}
+
+int qemu_crucible_source_clock_register_post_v1(
+    QemuCrucibleClockStorage *storage, int first_status)
+{
+    /* This same Main Original observation is independent even when first failed
+     * before a Source header was retained. It never replaces the first cause. */
+    int post = qemu_crucible_startup_source_observation_construction_current_v1(
+        &startup_source.standing.construction);
+    QemuCrucibleCpuSourceAllocationOwner *owner = storage ? storage->owner : NULL;
+    int linked = qemu_crucible_fault_clock_storage_current_v1(storage, true);
+    int status;
+
+    /* Reject inherited process state before touching its registry mutex. */
+    if (getpid() != startup_source.owner_process) {
+        return first_status ? first_status : -EPERM;
+    }
+    pthread_mutex_lock(&startup_source.cpu_allocations.lock);
+    status = clock_owner_identity(owner);
+    if (!status && (owner->clock.storage != storage || !owner->clock.held ||
+        owner->clock.register_post_recorded)) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        owner->clock.first_status = first_status;
+        owner->clock.post_status = post ? post : (first_status ? 0 : linked);
+        owner->clock.register_post_recorded = true;
+        owner->clock.active = !first_status && !linked && !post;
+    }
+    pthread_mutex_unlock(&startup_source.cpu_allocations.lock);
+    return first_status ? first_status : (post ? post : (status ? status : linked));
+}
+
+int qemu_crucible_source_clock_unregister_begin_v1(
+    QemuCrucibleClockStorage *storage)
+{
+    QemuCrucibleCpuSourceAllocationOwner *owner = storage ? storage->owner : NULL;
+    int status;
+
+    if (!bql_locked()) {
+        return -EPERM;
+    }
+    /* Reject inherited process state before touching its registry mutex. */
+    if (getpid() != startup_source.owner_process) {
+        return -EPERM;
+    }
+    pthread_mutex_lock(&startup_source.cpu_allocations.lock);
+    status = clock_owner_identity(owner);
+    if (!status && (owner->clock.storage != storage || !owner->clock.held)) {
+        status = -ESTALE;
+    }
+    if (!status && owner->getter.held) {
+        status = -EBUSY;
+    }
+    if (!status) {
+        owner->clock.active = false;
+        owner->clock.unregister_attempted = true;
+    }
+    pthread_mutex_unlock(&startup_source.cpu_allocations.lock);
+    return status;
+}
+
+
+static void clock_registration_close_locked(QemuCrucibleCpuSourceAllocationOwner *owner)
+{
+    QemuCrucibleClockSourceJournal *clock = &owner->clock;
+
+    if (!owner->getter.held && clock_journal_closed(clock)) {
+        /* Only retained external headers are consulted here. The actual final
+         * callback unref may already have freed both APIC and CPU payloads. */
+        if (clock_owner_identity(clock->parent) || !clock->parent->clock_children) {
+            return;
+        }
+        clock->parent->clock_children--;
+        clock->held = false;
+    }
+}
+
+int qemu_crucible_source_clock_unregister_post_v1(
+    QemuCrucibleClockStorage *storage, int first_status)
+{
+    QemuCrucibleCpuSourceAllocationOwner *owner = storage ? storage->owner : NULL;
+    int removed = qemu_crucible_fault_clock_storage_current_v1(storage, false);
+    int status;
+
+    /* Reject inherited process state before touching its registry mutex. */
+    if (getpid() != startup_source.owner_process) {
+        return first_status ? first_status : -EPERM;
+    }
+    pthread_mutex_lock(&startup_source.cpu_allocations.lock);
+    status = clock_owner_identity(owner);
+    if (!status && (owner->clock.storage != storage || !owner->clock.held ||
+        !owner->clock.unregister_attempted)) {
+        status = -ESTALE;
+    }
+    if (!status && !owner->clock.unregister_post_recorded) {
+        owner->clock.unregister_first_status = first_status;
+        owner->clock.unregister_post_status = removed;
+        owner->clock.row_removed = !removed;
+        owner->clock.unregister_post_recorded = true;
+        clock_registration_close_locked(owner);
+    }
+    if (!status) {
+        status = owner->clock.unregister_first_status ?
+            owner->clock.unregister_first_status : owner->clock.unregister_post_status;
+    }
+    pthread_mutex_unlock(&startup_source.cpu_allocations.lock);
+    return first_status ? first_status : status;
+}
+
+static int clock_callback_provider_current(
+    const QemuCrucibleClockSourceJournal *clock,
+    QemuCrucibleTimerCallbackFrame *frame, bool returned)
+{
+    if (!frame) {
+        return -EINVAL;
+    }
+    return frame->timer ? qemu_crucible_timer_callback_frame_current_v1(
+        frame, frame->timer, frame->callback, frame->opaque, returned) :
+        qemu_crucible_clock_callback_frame_current_v1(frame,
+            clock->storage->row, frame->callback, frame->opaque, returned);
+}
+
+int qemu_crucible_source_clock_callback_begin_v1(
+    QemuCrucibleCpuSourceAllocationOwner *owner,
+    QemuCrucibleTimerCallbackFrame *frame,
+    QemuCrucibleClockCallbackLease **holder)
+{
+    QemuCrucibleClockSourceJournal *clock;
+    QemuCrucibleClockCallbackLease *lease;
+    QemuCrucibleClockChildView view = { 0 };
+    QemuCrucibleCpuSourceAllocationOwner *observed = NULL;
+    uint64_t generation = 0;
+    int status;
+
+    if (!holder || *holder || !bql_locked()) {
+        return -EPERM;
+    }
+    /* Reject inherited process state before touching its registry mutex. */
+    if (getpid() != startup_source.owner_process) {
+        return -EPERM;
+    }
+    pthread_mutex_lock(&startup_source.cpu_allocations.lock);
+    status = clock_owner_identity(owner);
+    if (!status && (!owner->clock.held || !owner->clock.active ||
+        owner->clock.callback.held || owner->clock.callback_serial == UINT64_MAX)) {
+        status = -EPERM;
+    }
+    if (status) {
+        pthread_mutex_unlock(&startup_source.cpu_allocations.lock);
+        return status;
+    }
+    clock = &owner->clock;
+    lease = &clock->callback;
+    *lease = (QemuCrucibleClockCallbackLease) {
+        .owner = owner, .frame = frame, .holder = holder,
+        .process = getpid(), .serial = ++clock->callback_serial, .held = true,
+    };
+    qemu_thread_get_self(&lease->thread);
+    *holder = lease;
+    pthread_mutex_unlock(&startup_source.cpu_allocations.lock);
+
+    status = clock_callback_provider_current(clock, frame, false);
+    if (!status && (frame->holder != holder ||
+        (frame->timer && frame->timer != clock->timer) ||
+        clock->storage->construction_serial != clock->construction_serial)) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        lease->provider_serial = frame->serial;
+        status = qemu_crucible_fault_clock_storage_callback_current_v1(
+            clock->storage, frame->timer, frame->callback, frame->opaque);
+    }
+    /* Active admission is protected by the real BQL and closes before the
+     * actual parent child-reference is dropped. Never resurrect ref0. */
+    if (!status && (!OBJECT(clock->cpu)->ref || !clock->child->ref)) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        object_ref(OBJECT(clock->cpu));
+        lease->cpu_pinned = true;
+        object_ref(clock->child);
+        lease->child_pinned = true;
+        status = clock_child_observe(clock->cpu, &view);
+    }
+    if (!status && (view.child != clock->child || view.storage != clock->storage ||
+        view.timer != clock->timer)) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        status = clock_allocation_observe(clock->child, &observed, &generation);
+        if (!status && (observed != owner || generation != clock->generation)) {
+            status = -ESTALE;
+        }
+    }
+    if (!status) {
+        observed = NULL;
+        generation = 0;
+        status = clock_allocation_observe(OBJECT(clock->cpu), &observed, &generation);
+        if (!status && (observed != clock->parent ||
+            generation != clock->parent_generation)) {
+            status = -ESTALE;
+        }
+    }
+    lease->first_status = status;
+    return status;
+}
+
+/* Saved facts suffice after physical unref; never inspect released payloads. */
+static bool clock_callback_closed(const QemuCrucibleClockCallbackLease *lease)
+{
+    return lease->held && lease->serial && lease->provider_serial &&
+        lease->post_recorded && !lease->post_status &&
+        (lease->callback_returned != lease->not_entered) &&
+        (!lease->child_pinned ||
+         (lease->child_unref_attempted && lease->child_unref_returned)) &&
+        (!lease->cpu_pinned ||
+         (lease->cpu_unref_attempted && lease->cpu_unref_returned));
+}
+
+int qemu_crucible_source_clock_callback_end_v1(
+    QemuCrucibleTimerCallbackFrame *frame,
+    QemuCrucibleClockCallbackLease **holder)
+{
+    QemuCrucibleClockCallbackLease *lease = holder ? *holder : NULL;
+    QemuCrucibleCpuSourceAllocationOwner *owner;
+    QemuCrucibleClockSourceJournal *clock;
+    QemuCrucibleCpuSourceAllocationOwner *observed = NULL;
+    uint64_t generation = 0;
+    int post, status;
+
+    if (!lease || !bql_locked()) {
+        return -EPERM;
+    }
+    /* Reject inherited process state before touching its registry mutex. */
+    if (getpid() != startup_source.owner_process) {
+        return -EPERM;
+    }
+    pthread_mutex_lock(&startup_source.cpu_allocations.lock);
+    /* Nominal registry membership precedes every candidate lease field. */
+    for (owner = startup_source.cpu_allocations.owners; owner; owner = owner->next) {
+        if (&owner->clock.callback == lease) {
+            break;
+        }
+    }
+    status = clock_owner_identity(owner);
+    if (!status && (&owner->clock.callback != lease || !lease->held ||
+        lease->owner != owner || lease->holder != holder || lease->frame != frame ||
+        !lease->serial ||
+        lease->process != getpid() || !qemu_thread_is_self(&lease->thread) ||
+        lease->serial != owner->clock.callback_serial)) {
+        status = -ESTALE;
+    }
+    pthread_mutex_unlock(&startup_source.cpu_allocations.lock);
+    if (status) {
+        return status;
+    }
+    clock = &owner->clock;
+    /* This independent post executes on successful, failed and not-entered
+     * paths. First cause and actual provider return remain distinct. */
+    if (!lease->post_recorded) {
+        post = clock_callback_provider_current(clock, frame, frame->entered);
+        if (!post && (frame->holder != holder || !lease->provider_serial ||
+            frame->serial != lease->provider_serial)) {
+            post = -ESTALE;
+        }
+        if (!post) {
+            lease->callback_returned = frame->entered && frame->returned;
+            lease->not_entered = !frame->entered && !frame->returned;
+        }
+        if (!post && lease->child_pinned) {
+            post = clock_allocation_observe(clock->child, &observed, &generation);
+            if (!post && (observed != owner || generation != clock->generation)) {
+                post = -ESTALE;
+            }
+        }
+        if (!post && lease->cpu_pinned) {
+            observed = NULL;
+            generation = 0;
+            post = clock_allocation_observe(OBJECT(clock->cpu), &observed, &generation);
+            if (!post && (observed != clock->parent ||
+                generation != clock->parent_generation)) {
+                post = -ESTALE;
+            }
+        }
+        lease->post_status = post;
+        lease->post_recorded = true;
+    }
+    post = lease->post_status;
+    if (!lease->callback_returned && !lease->not_entered) {
+        return post ? post : -EBUSY;
+    }
+    /* No Source mutex or class callback spans either physical unref. APIC
+     * finalizer/unregister may reenter while CPU and both journals remain. */
+    if (lease->child_pinned && !lease->child_unref_attempted) {
+        lease->child_unref_attempted = true;
+        object_unref(clock->child);
+        lease->child_unref_returned = true;
+    }
+    if (lease->cpu_pinned && !lease->cpu_unref_attempted) {
+        lease->cpu_unref_attempted = true;
+        object_unref(OBJECT(clock->cpu));
+        lease->cpu_unref_returned = true;
+    }
+    pthread_mutex_lock(&startup_source.cpu_allocations.lock);
+    status = clock_owner_identity(owner);
+    if (!status && clock_callback_closed(lease)) {
+        lease->held = false;
+        *holder = NULL;
+        clock_registration_close_locked(owner);
+    }
+    pthread_mutex_unlock(&startup_source.cpu_allocations.lock);
+    return lease->first_status ? lease->first_status :
+        (lease->post_status ? lease->post_status : status);
+}
+#else
+/* Owned APIC publication is Linux-only, as are its real allocation receipts. */
+#endif
diff --git a/plugins/crucible-command-consumer.inc.h b/plugins/crucible-command-consumer.inc.h
new file mode 100644
index 0000000000000000000000000000000000000000..e127890106b42778422ee1a28f97090d2c04a5b0
--- /dev/null
+++ b/plugins/crucible-command-consumer.inc.h
@@ -0,0 +1,756 @@
+/*
+ * Source-owned configured command-consumer allocation custody
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifdef CONFIG_LINUX
+static int command_registry_identity(qemu_plugin_id_t id)
+{
+    QemuCrucibleCommandConsumerRegistry *registry = &startup_source.commands;
+    pid_t process = getpid();
+
+    /* Reject an inherited registry before locking its copied mutex. */
+    if (!qatomic_load_acquire(&startup_source.module_custody_published) ||
+        process != startup_source.owner_process ||
+        id != startup_source.saved.plugin_id || !qatomic_load_acquire(&registry->initialized) ||
+        registry->process != process) {
+        return -EPERM;
+    }
+    return 0;
+}
+
+static int command_storage_identity_locked(
+    QemuCrucibleCommandConsumerStorage *storage)
+{
+    QemuCrucibleStartupRuntimePurpose *runtime = &startup_source.runtime_purpose;
+
+    if (storage != &startup_source.commands.storage) {
+        return -EPERM;
+    }
+    if (!storage->attempted || !storage->held || storage->runtime != runtime ||
+        storage->process != startup_source.commands.process ||
+        storage->process_generation != startup_source.original.process_generation ||
+        storage->account_generation != startup_source.standing.initial.account_generation ||
+        storage->installer.ctx != startup_source.saved.ctx ||
+        storage->installer.module != startup_source.saved.module ||
+        storage->installer.install != startup_source.saved.install ||
+        storage->claim != &startup_source.commands.claim ||
+        !startup_source.commands.claim.payload_claimed ||
+        storage->request_index >= runtime->configured_count ||
+        storage->request != &runtime->configured_requests[storage->request_index] ||
+        storage->extent != storage->request->extent ||
+        storage->alignment < storage->request->alignment ||
+        storage->fixed_native_extent != startup_source.metadata_partition.fixed_native_extent ||
+        !runtime->charge.held || !startup_source.checkpoint_storage.fixed_charge.held ||
+        (!storage->transferred &&
+         (storage->holder != &storage->creation_owner ||
+          storage->creation_owner != storage)) ||
+        (storage->transferred && storage->holder != storage->runtime_holder)) {
+        return -ESTALE;
+    }
+    if (storage->transferred) {
+        QemuCrucibleFingerprintCompletionBinding *completion =
+            &startup_source.fingerprint_completion;
+        uintptr_t field = (uintptr_t)storage->runtime_holder;
+
+        /* Saved address/size alone do not permit a nominated field read.
+         * Recheck the actual retained parent and its immutable paid row first. */
+        if (!completion->enrolled || completion->runtime != runtime ||
+            (uintptr_t)completion->userdata != storage->runtime_base ||
+            runtime->configured_requests[0].extent != storage->runtime_extent ||
+            !storage->runtime_base || storage->runtime_extent < sizeof(void *) ||
+            storage->runtime_extent > UINTPTR_MAX - storage->runtime_base ||
+            field < storage->runtime_base || field % _Alignof(void *) ||
+            field - storage->runtime_base > storage->runtime_extent - sizeof(void *)) {
+            return -ESTALE;
+        }
+        if (*storage->runtime_holder != storage) {
+            return -ESTALE;
+        }
+    }
+    return 0;
+}
+#endif
+
+int qemu_plugin_crucible_command_consumer_storage_create_v1(
+    qemu_plugin_id_t id, QemuCrucibleStartupRuntimePurpose *runtime,
+    QemuCrucibleCommandConsumerRequest *claim, QemuCrucibleCommandConsumerStorage **out)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *registry = &startup_source.commands;
+    QemuCrucibleCommandConsumerStorage *storage = &registry->storage;
+    const QemuCrucibleProcessPurposeRequest *request;
+    void *address = NULL;
+    size_t extent;
+    size_t alignment;
+    int first;
+    int post;
+
+    if (!startup_invocation(id) || !out || *out) {
+        return -EPERM;
+    }
+    first = startup_runtime_admission(id, runtime);
+    if (first) {
+        return first;
+    }
+    first = command_registry_identity(id);
+    if (first) {
+        return first;
+    }
+    qemu_mutex_lock(&registry->mutex);
+    if (claim != &registry->claim) {
+        first = -EPERM;
+    } else if (!claim->attempted || !claim->held || claim->canonical_owner != claim ||
+               claim->runtime != runtime || claim->process != registry->process ||
+               claim->payload_claimed || !claim->request ||
+               claim->request_index >= runtime->configured_count ||
+               claim->request != &runtime->configured_requests[claim->request_index] ||
+               claim->extent != claim->request->extent ||
+               claim->alignment != claim->request->alignment ||
+               claim->process_generation != startup_source.original.process_generation ||
+               claim->account_generation != startup_source.standing.initial.account_generation ||
+               claim->fixed_native_extent != runtime->fixed_native_extent ||
+               !startup_source.checkpoint_storage.fixed_charge.held) {
+        first = -ESTALE;
+    }
+    if (first) {
+        qemu_mutex_unlock(&registry->mutex);
+        return first;
+    }
+    request = claim->request;
+    extent = (size_t)request->extent;
+    alignment = (size_t)request->alignment;
+    if ((uint64_t)extent != request->extent ||
+        (uint64_t)alignment != request->alignment) {
+        qemu_mutex_unlock(&registry->mutex);
+        return -EOVERFLOW;
+    }
+    alignment = MAX(alignment, sizeof(void *));
+    qemu_mutex_unlock(&registry->mutex);
+    qemu_mutex_lock(&registry->mutex);
+    if (storage->attempted || claim->payload_claimed) {
+        qemu_mutex_unlock(&registry->mutex);
+        return -EALREADY;
+    }
+    claim->payload_claimed = true;
+    *storage = (QemuCrucibleCommandConsumerStorage) {
+        .runtime = runtime,
+        .installer = startup_source.saved,
+        .creation_owner = storage,
+        .holder = &storage->creation_owner,
+        .request = request,
+        .request_index = claim->request_index,
+        .claim = claim,
+        .extent = extent,
+        .alignment = alignment,
+        .fixed_native_extent = runtime->fixed_native_extent,
+        .process_generation = startup_source.original.process_generation,
+        .account_generation = startup_source.standing.initial.account_generation,
+        .process = registry->process,
+        .attempted = true,
+        .held = true,
+        .allocation_active = true,
+    };
+    *out = storage;
+    qemu_mutex_unlock(&registry->mutex);
+
+    /* This allocation consumes a subset of the same already-admitted V3
+     * payload row. It never reserves a second account or refunds that prefix.
+     * The caller must replace the old raw child allocator, not run both. */
+    first = startup_process_purpose_live();
+    if (!first) {
+        first = posix_memalign(&address, alignment, extent);
+        first = first ? -first : 0;
+    }
+    qemu_mutex_lock(&registry->mutex);
+    storage->address = address;
+    storage->allocated = address != NULL;
+    storage->first_status = first;
+    qemu_mutex_unlock(&registry->mutex);
+    /* Retain actual born memory before the independent installing post, even
+     * when that post refuses. No field or allocator is hidden under the lock. */
+    post = startup_process_purpose_live();
+    qemu_mutex_lock(&registry->mutex);
+    storage->post_status = post;
+    storage->allocation_active = false;
+    qemu_mutex_unlock(&registry->mutex);
+    if (post) {
+        crucible_metadata_partition_record_post(&startup_source.metadata_partition, post);
+    }
+    if (first || post) {
+        startup_failure(first ? first : post);
+    }
+    return first ? first : post;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_crucible_command_consumer_storage_identity_v1(
+    qemu_plugin_id_t id, QemuCrucibleCommandConsumerStorage *storage)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *registry = &startup_source.commands;
+    int status = command_registry_identity(id);
+
+    if (status) {
+        return status;
+    }
+    qemu_mutex_lock(&registry->mutex);
+    status = command_storage_identity_locked(storage);
+    qemu_mutex_unlock(&registry->mutex);
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_command_consumer_storage_initialize_v1(
+    qemu_plugin_id_t id, QemuCrucibleCommandConsumerStorage *storage,
+    int (*initializer)(void *, size_t, size_t, void *, uint32_t *),
+    int (*destructor)(void *, size_t, size_t, uint32_t *),
+    void *initialization_input)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *registry = &startup_source.commands;
+    QemuThread thread;
+    void *address;
+    size_t extent;
+    size_t alignment;
+    int first = command_registry_identity(id);
+    int post;
+
+    if (first || !startup_invocation(id) || !initializer || !destructor) {
+        return first ? first : -EPERM;
+    }
+    first = startup_process_purpose_live();
+    if (!first) {
+        first = qemu_crucible_startup_source_fingerprint_context_identity_v1(id);
+    }
+    if (first) {
+        return first;
+    }
+    qemu_thread_get_self(&thread);
+    qemu_mutex_lock(&registry->mutex);
+    first = command_storage_identity_locked(storage);
+    if (!first && (!storage->allocated || storage->allocation_active ||
+                   storage->initialization_attempted || storage->closing ||
+                   storage->first_status || storage->post_status)) {
+        first = -EBUSY;
+    }
+    if (first) {
+        qemu_mutex_unlock(&registry->mutex);
+        return first;
+    }
+    address = storage->address;
+    extent = storage->extent;
+    alignment = storage->alignment;
+    storage->initialization_thread = thread;
+    storage->initializer = initializer;
+    storage->destructor = destructor;
+    storage->initialization_output = 0;
+    storage->initialization_attempted = true;
+    storage->initialization_active = true;
+    qemu_mutex_unlock(&registry->mutex);
+
+    /* This entered callback alone writes its transient output cell. Exported
+     * getters never read that cell; its result becomes canonical under the
+     * mutex only after the callback returns. Its input is not retained. */
+    SOURCE_CALLBACK_MASKED_INVOKE(
+        first, &storage->initializer, initializer, initialization_input,
+        address, extent, alignment, initialization_input,
+        &storage->initialization_output);
+    qemu_mutex_lock(&registry->mutex);
+    storage->initialize_first_status = first;
+    storage->initialization_returned = true;
+    storage->initialization_active = false;
+    storage->initialized = storage->placement_attempted &&
+                           storage->initialization_output == 1;
+    if (storage->initialization_output > 1 ||
+        (storage->placement_attempted && !storage->initialized) ||
+        (!storage->placement_attempted && storage->initialization_output)) {
+        storage->initialization_uncertain = true;
+        if (!first) {
+            storage->initialize_first_status = first = -EPROTO;
+        }
+    } else if (!first && !storage->initialized) {
+        storage->initialize_first_status = first = -EPROTO;
+    }
+    qemu_mutex_unlock(&registry->mutex);
+    /* A successfully placed body survives a negative initializer projection
+     * or installing post, and still requires its exact typed destructor. */
+    post = startup_process_purpose_live();
+    qemu_mutex_lock(&registry->mutex);
+    storage->initialize_post_status = post;
+    qemu_mutex_unlock(&registry->mutex);
+    if (post) {
+        crucible_metadata_partition_record_post(&startup_source.metadata_partition, post);
+    }
+    return first ? first : post;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_command_consumer_storage_transfer_v1(
+    qemu_plugin_id_t id, QemuCrucibleStartupRuntimePurpose *runtime,
+    QemuCrucibleCommandConsumerStorage **projection,
+    QemuCrucibleCommandConsumerStorage **runtime_field)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *registry = &startup_source.commands;
+    QemuCrucibleCommandConsumerStorage *storage = &registry->storage;
+    int status = command_registry_identity(id);
+    int post;
+
+    if (!status) {
+        status = setup_owned_runtime_field_current(id, runtime, runtime_field);
+    }
+    if (status) {
+        return status;
+    }
+    if (!projection || projection == runtime_field ||
+        (void *)runtime_field == (void *)startup_source.fingerprint_completion.module_view_holder ||
+        (void *)runtime_field == (void *)startup_source.fingerprint_completion.publication_holder ||
+        (void *)runtime_field == (void *)startup_source.control_callback.holder ||
+        (void *)runtime_field == (void *)startup_source.setup_mapping.holder ||
+        (void *)runtime_field == (void *)startup_source.setup_handshake.holder ||
+        (void *)runtime_field == (void *)startup_source.setup_slot.holder) {
+        return -EINVAL;
+    }
+    qemu_mutex_lock(&registry->mutex);
+    status = command_storage_identity_locked(storage);
+    if (!status && (storage->runtime != runtime || storage->transferred ||
+                    storage->allocation_active || storage->initialization_active ||
+                    storage->closing || *projection != storage || *runtime_field)) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        *runtime_field = storage;
+        storage->creation_owner = NULL;
+        *projection = NULL;
+        storage->runtime_holder = runtime_field;
+        storage->runtime_base = (uintptr_t)startup_source.fingerprint_completion.userdata;
+        storage->runtime_extent = runtime->configured_requests[0].extent;
+        storage->holder = runtime_field;
+        storage->transferred = true;
+    }
+    qemu_mutex_unlock(&registry->mutex);
+    if (status) {
+        return status;
+    }
+    post = startup_process_purpose_live();
+    if (post) {
+        crucible_metadata_partition_record_post(&startup_source.metadata_partition, post);
+    }
+    return post;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_command_consumer_storage_use_borrow_v1(
+    qemu_plugin_id_t id, QemuCrucibleCommandConsumerStorage *storage,
+    QemuCrucibleCommandConsumerUse **projection, uint64_t *serial)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *registry = &startup_source.commands;
+    QemuCrucibleCommandConsumerUse *use = &registry->use;
+    QemuThread thread;
+    int status = command_registry_identity(id);
+
+    if (status || !projection || !serial || !qemu_in_main_thread()) {
+        return status ? status : -EPERM;
+    }
+    /* A live caller pair is return custody, including on PendingUse. */
+    if (*projection || *serial) {
+        return -EINVAL;
+    }
+    status = qemu_crucible_startup_source_fingerprint_context_identity_v1(id);
+    if (status) {
+        return status;
+    }
+    qemu_thread_get_self(&thread);
+    qemu_mutex_lock(&registry->mutex);
+    status = command_storage_identity_locked(storage);
+    if (!status && (!storage->initialized || storage->closing ||
+                    storage->initialization_active || storage->destructor_attempted ||
+                    storage->first_status || storage->post_status ||
+                    storage->initialize_first_status || storage->initialize_post_status)) {
+        status = -EPERM;
+    }
+    if (!status && use->held) {
+        /* Exactly this preeffect contention has no new loan or body effect.
+         * Reentrant factual access must defer; arbitrary errno is not retry. */
+        status = QEMU_CRUCIBLE_COMMAND_STORAGE_PENDING_USE;
+    }
+    if (!status && registry->use_serial == UINT64_MAX) {
+        status = -EOVERFLOW;
+    }
+    if (!status) {
+        *use = (QemuCrucibleCommandConsumerUse) {
+            .storage = storage,
+            .canonical_owner = use,
+            .thread = thread,
+            .serial = ++registry->use_serial,
+            .process = registry->process,
+            .held = true,
+        };
+        *projection = use;
+        *serial = use->serial;
+    }
+    qemu_mutex_unlock(&registry->mutex);
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_command_consumer_storage_use_current_v1(
+    qemu_plugin_id_t id, QemuCrucibleCommandConsumerUse *use,
+    uint64_t serial, void **address, size_t *bytes, size_t *alignment)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *registry = &startup_source.commands;
+    int status = command_registry_identity(id);
+
+    if (status || !address || !bytes || !alignment) {
+        return status ? status : -EINVAL;
+    }
+    *address = NULL;
+    *bytes = 0;
+    *alignment = 0;
+    qemu_mutex_lock(&registry->mutex);
+    if (use != &registry->use) {
+        status = -EPERM;
+    } else if (!use->held || use->canonical_owner != use ||
+               use->serial != serial || !serial ||
+               use->process != registry->process ||
+               !qemu_thread_is_self(&use->thread)) {
+        status = -ESTALE;
+    } else {
+        status = command_storage_identity_locked(use->storage);
+    }
+    if (!status && (!use->storage->initialized || use->storage->closing ||
+                    use->storage->destructor_attempted)) {
+        status = -EPERM;
+    }
+    if (!status) {
+        *address = use->storage->address;
+        *bytes = use->storage->extent;
+        *alignment = use->storage->alignment;
+    }
+    qemu_mutex_unlock(&registry->mutex);
+    /* This physical use protects the private body from destruction only. It
+     * does not authorize a command pump, guest effect, Original or Root. */
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_command_consumer_storage_use_return_v1(
+    qemu_plugin_id_t id, QemuCrucibleCommandConsumerUse **projection,
+    uint64_t serial)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *registry = &startup_source.commands;
+    QemuCrucibleCommandConsumerUse *use = &registry->use;
+    int status = command_registry_identity(id);
+
+    if (status || !projection) {
+        return status ? status : -EINVAL;
+    }
+    qemu_mutex_lock(&registry->mutex);
+    if (!use->held || use->canonical_owner != use || use->serial != serial ||
+        !serial || !qemu_thread_is_self(&use->thread) || *projection != use) {
+        status = -ESTALE;
+    } else {
+        use->held = false;
+        use->canonical_owner = NULL;
+        *projection = NULL;
+    }
+    qemu_mutex_unlock(&registry->mutex);
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_command_consumer_storage_observe_v1(
+    qemu_plugin_id_t id, QemuCrucibleCommandConsumerStorage *storage,
+    struct qemu_plugin_crucible_command_storage_status_v1 *out)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *registry = &startup_source.commands;
+    int status = command_registry_identity(id);
+
+    if (status || !out) {
+        return status ? status : -EINVAL;
+    }
+    qemu_mutex_lock(&registry->mutex);
+    if (storage != &registry->storage) {
+        status = -EPERM;
+    } else if (!storage->attempted) {
+        status = -ENOKEY;
+    } else {
+        /* Observe only Source journals, including terminal tombstones. Never
+         * read the callback scratch output or the possibly destroyed body. */
+        *out = (struct qemu_plugin_crucible_command_storage_status_v1) {
+            .schema_version = 1,
+            .struct_size = sizeof(*out),
+            .extent_bytes = storage->extent,
+            .physical_alignment = storage->alignment,
+            .allocation_first = storage->first_status,
+            .allocation_post = storage->post_status,
+            .initialization_first = storage->initialize_first_status,
+            .initialization_post = storage->initialize_post_status,
+            .destruction_first = storage->destructor_first_status,
+            .destruction_post = storage->destructor_post_status,
+            .allocation_return_post = storage->allocation_return_post,
+            .allocated = storage->allocated,
+            .initialization_attempted = storage->initialization_attempted,
+            .placement_attempted = storage->placement_attempted,
+            .initialization_returned = storage->initialization_returned,
+            .initialized = storage->initialized,
+            .initialization_uncertain = storage->initialization_uncertain,
+            .destruction_attempted = storage->destructor_attempted,
+            .destruction_returned = storage->destructor_returned,
+            .destroyed = storage->destroyed,
+            .destruction_uncertain = storage->destructor_uncertain,
+            .free_attempted = storage->free_attempted,
+            .physical_returned = storage->physical_returned,
+            .held = storage->held,
+            .transferred = storage->transferred,
+            .use_held = registry->use.held,
+        };
+    }
+    qemu_mutex_unlock(&registry->mutex);
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_command_consumer_storage_holder_observe_v1(
+    qemu_plugin_id_t id, QemuCrucibleCommandConsumerStorage **runtime_field,
+    QemuCrucibleCommandConsumerStorage **projection)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *registry = &startup_source.commands;
+    QemuCrucibleCommandConsumerStorage *storage = &registry->storage;
+    int status = command_registry_identity(id);
+
+    if (status || !projection) {
+        return status ? status : -EINVAL;
+    }
+    qemu_mutex_lock(&registry->mutex);
+    /* Compare with actual saved custody, even if the nominated input is bad. */
+    if (projection == &storage->creation_owner ||
+        projection == storage->holder || projection == storage->runtime_holder ||
+        projection == runtime_field) {
+        status = -EINVAL;
+    } else if (!storage->attempted || !storage->held) {
+        status = -ENOKEY;
+    } else if (storage->transferred && runtime_field != storage->runtime_holder) {
+        /* Authenticate the exact saved field before reading its contents. */
+        status = -EPERM;
+    } else if (!storage->transferred && runtime_field != NULL) {
+        status = -EPERM;
+    } else {
+        status = command_storage_identity_locked(storage);
+    }
+    if (!status) {
+        *projection = storage;
+    }
+    qemu_mutex_unlock(&registry->mutex);
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_command_consumer_storage_return_v1(
+    qemu_plugin_id_t id, QemuCrucibleCommandConsumerStorage **holder)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *registry = &startup_source.commands;
+    QemuCrucibleCommandConsumerStorage *storage = &registry->storage;
+    int (*destructor)(void *, size_t, size_t, uint32_t *);
+    void *address;
+    size_t extent;
+    size_t alignment;
+    bool needs_destruction;
+    bool already_freed;
+    int first = command_registry_identity(id);
+    int post = 0;
+
+    if (first || !holder || !startup_owner()) {
+        return first ? first : -EPERM;
+    }
+    qemu_mutex_lock(&registry->mutex);
+    first = command_storage_identity_locked(storage);
+    if (!first && ((storage->transferred && holder != storage->runtime_holder) ||
+                   *holder != storage)) {
+        first = -EPERM;
+    }
+    if (!first && (storage->allocation_active || storage->initialization_active ||
+                   storage->closing || registry->use.held ||
+                   storage->callback_child_held ||
+                   storage->initialization_uncertain || storage->destructor_uncertain)) {
+        first = -EBUSY;
+    }
+    if (first) {
+        qemu_mutex_unlock(&registry->mutex);
+        return first;
+    }
+    address = storage->address;
+    extent = storage->extent;
+    alignment = storage->alignment;
+    destructor = storage->destructor;
+    needs_destruction = storage->initialized && !storage->destroyed;
+    already_freed = storage->physical_returned;
+    if (needs_destruction && (!destructor || storage->destructor_attempted)) {
+        qemu_mutex_unlock(&registry->mutex);
+        return -ESTALE;
+    }
+    if (!already_freed && storage->free_attempted) {
+        qemu_mutex_unlock(&registry->mutex);
+        return -ESTALE;
+    }
+    storage->closing = true;
+    qemu_mutex_unlock(&registry->mutex);
+
+    if (needs_destruction) {
+        /* Only this real callback needs module-code custody. Pre-effect
+         * refusal does not mark destruction attempted or consume the owner. */
+        first = qemu_crucible_startup_source_fingerprint_context_identity_v1(id);
+        if (first) {
+            qemu_mutex_lock(&registry->mutex);
+            storage->closing = false;
+            qemu_mutex_unlock(&registry->mutex);
+            return first;
+        }
+        qemu_mutex_lock(&registry->mutex);
+        storage->destruction_output = 0;
+        storage->destructor_attempted = true;
+        qemu_mutex_unlock(&registry->mutex);
+        SOURCE_CALLBACK_MASKED_INVOKE(
+            first, &storage->destructor, destructor, NULL,
+            address, extent, alignment, &storage->destruction_output);
+        qemu_mutex_lock(&registry->mutex);
+        storage->destructor_first_status = first;
+        storage->destructor_returned = true;
+        storage->destroyed = !first && storage->destruction_output == 1;
+        if (first || storage->destruction_output != 1) {
+            storage->destructor_uncertain = true;
+            if (!first) {
+                storage->destructor_first_status = first = -EPROTO;
+            }
+        }
+        qemu_mutex_unlock(&registry->mutex);
+        post = qemu_crucible_startup_source_fingerprint_context_identity_v1(id);
+        qemu_mutex_lock(&registry->mutex);
+        storage->destructor_post_status = post;
+        if (first || post) {
+            /* A completed drop with negative post is DESTROYED but not freed.
+             * A negative/unknown drop is uncertain and cannot be repeated.
+             * Both phases retain the canonical owner and prohibit typed use. */
+            storage->closing = false;
+        }
+        qemu_mutex_unlock(&registry->mutex);
+        if (first || post) {
+            return first ? first : post;
+        }
+    }
+    if (!already_freed) {
+        /* Reauthenticate actual allocation/field custody independently of
+         * module code or time. A later DESTROYED retirement skips drop. */
+        qemu_mutex_lock(&registry->mutex);
+        first = command_storage_identity_locked(storage);
+        if (!first && (registry->use.held || storage->callback_child_held ||
+                       storage->free_attempted ||
+                       (storage->initialized && !storage->destroyed))) {
+            first = -EBUSY;
+        }
+        if (!first) {
+            storage->free_attempted = true;
+        } else {
+            storage->closing = false;
+        }
+        qemu_mutex_unlock(&registry->mutex);
+        if (first) {
+            return first;
+        }
+        /* Same allocator, exact saved address, once only. The admitted
+         * process payload prefix remains charged after physical release. */
+        free(address);
+        qemu_mutex_lock(&registry->mutex);
+        storage->address = NULL;
+        storage->allocated = false;
+        storage->physical_returned = true;
+        post = command_storage_identity_locked(storage);
+        storage->allocation_return_post = post;
+        if (post) {
+            storage->closing = false;
+        }
+        qemu_mutex_unlock(&registry->mutex);
+        if (post) {
+            /* Known free is retained independently of field disposition.
+             * A later identity-only retry may consume custody, never free. */
+            return post;
+        }
+    }
+    qemu_mutex_lock(&registry->mutex);
+    first = command_storage_identity_locked(storage);
+    if (!first) {
+        storage->closing = false;
+        storage->held = false;
+        storage->creation_owner = NULL;
+        storage->holder = NULL;
+        storage->runtime_holder = NULL;
+        storage->claim->held = false;
+        storage->claim->canonical_owner = NULL;
+        *holder = NULL;
+    } else {
+        storage->closing = false;
+    }
+    qemu_mutex_unlock(&registry->mutex);
+    return first;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_command_consumer_storage_placement_begin_v1(
+    qemu_plugin_id_t id, QemuCrucibleCommandConsumerStorage *storage)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *registry = &startup_source.commands;
+    int status = command_registry_identity(id);
+
+    if (status || !startup_invocation(id)) {
+        return status ? status : -EPERM;
+    }
+    status = startup_process_purpose_live();
+    if (status) {
+        return status;
+    }
+    qemu_mutex_lock(&registry->mutex);
+    status = command_storage_identity_locked(storage);
+    if (!status && (!storage->initialization_active || storage->placement_attempted ||
+                    !qemu_thread_is_self(&storage->initialization_thread))) {
+        status = -EPERM;
+    }
+    if (!status) {
+        /* The real typed initializer must call this immediately before its
+         * first placement write. A missing completion after this cut is
+         * uncertain, even if the callback returned a negative result. */
+        storage->placement_attempted = true;
+    }
+    qemu_mutex_unlock(&registry->mutex);
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
diff --git a/plugins/crucible-command-membership.inc.h b/plugins/crucible-command-membership.inc.h
new file mode 100644
index 0000000000000000000000000000000000000000..cfded1410f5f6933a4cfda9f7924683af98f4db9
--- /dev/null
+++ b/plugins/crucible-command-membership.inc.h
@@ -0,0 +1,686 @@
+/*
+ * Nominal membership of the actual contained command consumer.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+/* A complete copied table is a registration invariant, never an operation
+ * issuer. Older editions retain the all-zero absence representation. */
+static bool command_member_advance_callbacks_valid(
+    const struct qemu_plugin_crucible_advance_callbacks_v1 *advance)
+{
+    return advance->schema_version == 1 &&
+        advance->struct_size == sizeof(*advance) && advance->enter &&
+        advance->current && advance->handoff_post && advance->publish &&
+        advance->return_child;
+}
+
+static bool command_member_advance_callbacks_absent(
+    const struct qemu_plugin_crucible_advance_callbacks_v1 *advance)
+{
+    return !advance->schema_version && !advance->struct_size &&
+        !advance->enter && !advance->current && !advance->handoff_post &&
+        !advance->publish && !advance->return_child;
+}
+
+static bool command_member_advance_receiver_callbacks_valid(
+    const struct qemu_plugin_crucible_advance_receiver_callbacks_v1 *receiver)
+{
+    return receiver->schema_version == 1 &&
+        receiver->struct_size == sizeof(*receiver) && receiver->acquire &&
+        receiver->current && receiver->cleanup_enter &&
+        receiver->cleanup_current && receiver->membership_return &&
+        receiver->command_return && receiver->cleanup_guard_return &&
+        receiver->cleanup_return;
+}
+
+static bool command_member_advance_receiver_callbacks_absent(
+    const struct qemu_plugin_crucible_advance_receiver_callbacks_v1 *receiver)
+{
+    return !receiver->schema_version && !receiver->struct_size &&
+        !receiver->acquire && !receiver->current && !receiver->cleanup_enter &&
+        !receiver->cleanup_current && !receiver->membership_return &&
+        !receiver->command_return && !receiver->cleanup_guard_return &&
+        !receiver->cleanup_return;
+}
+
+#ifdef CONFIG_LINUX
+/* Geometry refuses before either table is read. Stable backing remains the
+ * caller's C obligation; these checks neither probe it nor issue an owner. */
+static bool command_member_advance_table_geometry(
+    const struct qemu_plugin_crucible_advance_callbacks_v1 *advance,
+    const struct qemu_plugin_crucible_advance_receiver_callbacks_v1 *receiver,
+    QemuCrucibleCommandConsumerMember **out)
+{
+    uintptr_t address = (uintptr_t)advance;
+    uintptr_t receiver_address = (uintptr_t)receiver;
+    uintptr_t output_address = (uintptr_t)out;
+
+    return advance && receiver && out &&
+        address % _Alignof(*advance) == 0 &&
+        address <= UINTPTR_MAX - sizeof(*advance) &&
+        receiver_address % _Alignof(*receiver) == 0 &&
+        receiver_address <= UINTPTR_MAX - sizeof(*receiver) &&
+        output_address % _Alignof(*out) == 0 &&
+        output_address <= UINTPTR_MAX - sizeof(*out) &&
+        !callback_child_output_overlap(advance, sizeof(*advance), receiver,
+                                       sizeof(*receiver)) &&
+        !callback_child_output_overlap(out, sizeof(*out), receiver,
+                                       sizeof(*receiver)) &&
+        !callback_child_output_overlap(out, sizeof(*out), advance,
+                                       sizeof(*advance));
+}
+
+static int command_member_identity_locked(QemuCrucibleCommandConsumerMember *member)
+{
+    QemuCrucibleSourceControlBinding *component = &startup_source.control_callback;
+    QemuCrucibleCallbackChildOwner *owner = &startup_source.callbacks.owner;
+    QemuCrucibleSetupSlotOwner *slot = &startup_source.setup_slot;
+    int status;
+
+    /* Select the real Source slot before reading any nominated member. */
+    if (member != &startup_source.command_member) {
+        return -EPERM;
+    }
+    if (member->canonical_owner != member || !member->attempted ||
+        !member->held || member->returned || !member->reader ||
+        member->publisher_lender != startup_source.publisher_lender ||
+        (member->publisher_returned && !member->closing) ||
+        (!!member->payload_claim != !!member->payload_release) ||
+        (!!member->payload_borrow_acquire != !!member->payload_borrow_release) ||
+        (member->payload_borrow_acquire && !member->payload_claim) ||
+        (!!member->action_enter != !!member->action_current) ||
+        (!!member->action_enter != !!member->action_post) ||
+        (!!member->action_enter != !!member->action_return) ||
+        (member->action_enter && !member->payload_borrow_acquire) ||
+        (!command_member_advance_callbacks_absent(&member->advance) &&
+         (!member->action_enter ||
+          !command_member_advance_callbacks_valid(&member->advance) ||
+          !command_member_advance_receiver_callbacks_valid(&member->advance_receiver))) ||
+        (command_member_advance_callbacks_absent(&member->advance) &&
+         !command_member_advance_receiver_callbacks_absent(&member->advance_receiver)) ||
+        !member->park_writer.born || !member->park_writer.callback ||
+        member->park_writer.member != member || member->component != component ||
+        member->child_owner != owner || member->child != owner->child ||
+        member->bridge != owner->bridge || member->runtime != owner->runtime ||
+        member->slot != slot || member->mapping != slot->mapping ||
+        component->command_member != member || slot->command_member != member ||
+        component->child_owner != owner || !component->attempted ||
+        !component->holder || *component->holder != component ||
+        component->runtime != member->runtime ||
+        component->userdata != member->child->address ||
+        member->process != startup_source.commands.process ||
+        member->process_generation != startup_source.original.process_generation ||
+        member->account_generation != startup_source.standing.initial.account_generation ||
+        member->installer.ctx != startup_source.saved.ctx ||
+        member->installer.module != startup_source.saved.module ||
+        member->installer.install != startup_source.saved.install ||
+        member->installer.plugin_id != startup_source.saved.plugin_id ||
+        slot->runtime != member->runtime || !slot->transferred) {
+        return -ESTALE;
+    }
+    status = callback_child_owner_identity_locked(owner);
+    if (!status) {
+        status = setup_slot_identity(member->installer.plugin_id, slot);
+    }
+    if (status) {
+        return status;
+    }
+    if (!member->transferred) {
+        return member->creation_owner == member &&
+            member->holder == &member->creation_owner ? 0 : -ESTALE;
+    }
+
+    uintptr_t field = (uintptr_t)member->runtime_holder;
+
+    if (member->creation_owner || member->holder != member->runtime_holder ||
+        member->runtime_base != owner->runtime_base ||
+        member->runtime_extent != owner->runtime_extent ||
+        !member->runtime_base || member->runtime_extent < sizeof(*member->runtime_holder) ||
+        member->runtime_extent > UINTPTR_MAX - member->runtime_base ||
+        field < member->runtime_base ||
+        field % _Alignof(QemuCrucibleCommandConsumerMember *) ||
+        field - member->runtime_base >
+            member->runtime_extent - sizeof(*member->runtime_holder)) {
+        return -ESTALE;
+    }
+    return *member->runtime_holder == member ? 0 : -ESTALE;
+}
+
+static int command_member_live_locked(QemuCrucibleCommandConsumerMember *member)
+{
+    int status = command_member_identity_locked(member);
+
+    if (!status && member->transition_active) {
+        return -EBUSY;
+    }
+    if (!status && (!member->transferred || member->closing ||
+                    member->first_status || member->post_status ||
+                    !member->component->enrolled || member->component->first_status ||
+                    member->slot->post_status || member->mapping->closing ||
+                    member->mapping->physical_returned)) {
+        status = -ESTALE;
+    }
+    return status ? status : callback_registration_owner_live_locked(member->child_owner);
+}
+#endif
+
+static int command_member_create(
+    qemu_plugin_id_t id, QemuCrucibleSourceControlBinding *component,
+    QemuCrucibleCommandRequestReader reader, QemuCrucibleParkReturnWriter writer,
+    QemuCrucibleModuleRequestPayloadClaim payload_claim,
+    QemuCrucibleModuleRequestPayloadRelease payload_release,
+    QemuCrucibleModuleRequestPayloadBorrowAcquire payload_borrow_acquire,
+    QemuCrucibleModuleRequestPayloadBorrowRelease payload_borrow_release,
+    QemuCrucibleModuleFingerprintActionEnter action_enter,
+    QemuCrucibleModuleFingerprintActionCurrent action_current,
+    QemuCrucibleModuleFingerprintActionPost action_post,
+    QemuCrucibleModuleFingerprintActionReturn action_return,
+    const struct qemu_plugin_crucible_advance_callbacks_v1 *advance,
+    const struct qemu_plugin_crucible_advance_receiver_callbacks_v1 *receiver,
+    QemuCrucibleCommandConsumerMember **out)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    QemuCrucibleCommandConsumerMember *member = &startup_source.command_member;
+    QemuCrucibleCallbackChildOwner *owner = &startup_source.callbacks.owner;
+    QemuCrucibleSetupSlotOwner *slot = &startup_source.setup_slot;
+    struct qemu_plugin_crucible_advance_callbacks_v1 copied_advance = { 0 };
+    struct qemu_plugin_crucible_advance_receiver_callbacks_v1 copied_receiver = { 0 };
+    int first = command_registry_identity(id);
+    int post;
+    int result;
+
+    if (first || !out || !reader || !writer || !startup_invocation(id) ||
+        startup_source.install_returned) {
+        return first ? first : -EPERM;
+    }
+    if (!!advance != !!receiver) {
+        return -EINVAL;
+    }
+    if (advance) {
+        if (!command_member_advance_table_geometry(advance, receiver, out)) {
+            return -EINVAL;
+        }
+        qemu_mutex_lock(&commands->mutex);
+        if (callback_child_output_conflicts_locked(advance, sizeof(*advance)) ||
+            callback_child_output_conflicts_locked(receiver, sizeof(*receiver)) ||
+            callback_child_output_conflicts_locked(out, sizeof(*out))) {
+            first = -EINVAL;
+        } else {
+            copied_advance = *advance;
+            copied_receiver = *receiver;
+            if (!command_member_advance_callbacks_valid(&copied_advance) ||
+                !command_member_advance_receiver_callbacks_valid(&copied_receiver)) {
+                first = -EINVAL;
+            }
+        }
+        qemu_mutex_unlock(&commands->mutex);
+        if (first) {
+            return first;
+        }
+    }
+    first = source_control_component_identity(component);
+    if (!first) {
+        first = qemu_plugin_crucible_startup_setup_slot_current_v1(id, slot);
+    }
+    if (!first) {
+        first = startup_runtime_admission(id, &startup_source.runtime_purpose);
+    }
+    if (first) {
+        return first;
+    }
+    qemu_mutex_lock(&commands->mutex);
+    if ((advance && callback_child_output_conflicts_locked(advance,
+                                                          sizeof(*advance))) ||
+        (receiver && callback_child_output_conflicts_locked(receiver,
+                                                           sizeof(*receiver))) ||
+        callback_child_output_conflicts_locked(out, sizeof(*out)) || *out) {
+        first = -EINVAL;
+    } else {
+        first = callback_registration_owner_live_locked(owner);
+    }
+    if (!first) {
+        first = setup_slot_identity(id, slot);
+    }
+    if (!first && (member->attempted || component != &startup_source.control_callback ||
+                   !component->enrolled || component->first_status ||
+                   component->child_owner != owner || component->command_member ||
+                   !component->holder || *component->holder != component ||
+                   component->runtime != owner->runtime ||
+                   component->userdata != owner->child->address ||
+                   slot->command_member || !slot->transferred ||
+                   slot->runtime != owner->runtime || slot->post_status ||
+                   slot->mapping->closing || slot->mapping->physical_returned)) {
+        first = -EBUSY;
+    }
+    if (first) {
+        qemu_mutex_unlock(&commands->mutex);
+        return first;
+    }
+
+    /* The component already retains the genuine completed child's independent
+     * Bridge borrower. This member keeps that component and the received VMA
+     * slot alive before publishing even a negative-post creation projection. */
+    *member = (QemuCrucibleCommandConsumerMember) {
+        .canonical_owner = member,
+        .creation_owner = member,
+        .holder = &member->creation_owner,
+        .component = component,
+        .child_owner = owner,
+        .child = owner->child,
+        .bridge = owner->bridge,
+        .runtime = owner->runtime,
+        .slot = slot,
+        .mapping = slot->mapping,
+        .publisher_lender = startup_source.publisher_lender,
+        .installer = owner->installer,
+        .reader = reader,
+        .payload_claim = payload_claim,
+        .payload_release = payload_release,
+        .payload_borrow_acquire = payload_borrow_acquire,
+        .payload_borrow_release = payload_borrow_release,
+        .action_enter = action_enter,
+        .action_current = action_current,
+        .action_post = action_post,
+        .action_return = action_return,
+        .advance = copied_advance,
+        .advance_receiver = copied_receiver,
+        .park_writer = {
+            .member = member,
+            .callback = writer,
+            .born = true,
+        },
+        .process_generation = owner->process_generation,
+        .account_generation = owner->account_generation,
+        .process = owner->process,
+        .attempted = true,
+        .held = true,
+        .transition_active = true,
+    };
+    component->command_member = member;
+    slot->command_member = member;
+    *out = member;
+    qemu_mutex_unlock(&commands->mutex);
+
+    /* This is a physical receiver-service child of the already retained
+     * Source session. It issues neither producer membership nor an action.
+     * Retain the member/component/Bridge/slot on every negative child outcome. */
+    if (member->publisher_lender) {
+#if defined(__x86_64__) && !defined(__ILP32__)
+        first = qemu_crucible_preexec_publisher_member_borrow_v1(
+            member->publisher_lender, member);
+#else
+        first = -ENOTSUP;
+#endif
+    }
+    post = startup_runtime_admission(id, member->runtime);
+    qemu_mutex_lock(&commands->mutex);
+    member->first_status = first;
+    member->post_status = post;
+    result = command_member_identity_locked(member);
+    if (!result) {
+        member->transition_active = false;
+    }
+    if (first || post) {
+        result = first ? first : post;
+    }
+    qemu_mutex_unlock(&commands->mutex);
+    if (post) {
+        crucible_metadata_partition_record_post(&startup_source.metadata_partition, post);
+    }
+    return result;
+#else
+    return -ENOTSUP;
+#endif
+}
+
