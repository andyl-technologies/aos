+typedef struct CharSocketFdConfigLock {
+    QemuMutex *lock;
+    GMainContext *context;
+    QemuSemaphore held;
+    QemuSemaphore release;
+} CharSocketFdConfigLock;
+
+static void *char_socket_fd_config_lock_thread(void *opaque)
+{
+    CharSocketFdConfigLock *fixture = opaque;
+
+    if (fixture->context) {
+        g_assert_true(g_main_context_acquire(fixture->context));
+    } else {
+        qemu_mutex_lock(fixture->lock);
+    }
+    qemu_sem_post(&fixture->held);
+    qemu_sem_wait(&fixture->release);
+
+    if (fixture->context) {
+        g_main_context_release(fixture->context);
+    } else {
+        qemu_mutex_unlock(fixture->lock);
+    }
+    return NULL;
+}
+
+static void char_socket_fd_config_foreign_lock(CharFrontend *frontend,
+                                                bool context_lock)
+{
+    CharSocketFdConfigLock fixture = {
+        .lock = &frontend->chr->chr_write_lock,
+        .context = context_lock ? frontend->chr->gcontext : NULL,
+    };
+    QemuThread thread;
+
+    if (context_lock) {
+        g_assert_nonnull(fixture.context);
+    }
+    qemu_sem_init(&fixture.held, 0);
+    qemu_sem_init(&fixture.release, 0);
+    qemu_thread_create(&thread, "char-config-lock",
+                       char_socket_fd_config_lock_thread, &fixture,
+                       QEMU_THREAD_JOINABLE);
+    qemu_sem_wait(&fixture.held);
+
+    if (context_lock) {
+        g_assert_false(g_main_context_acquire(fixture.context));
+    } else {
+        g_assert_cmpint(qemu_mutex_trylock(fixture.lock), !=, 0);
+    }
+    g_assert_true(qemu_chr_socket_fd_preserve_blocking_configured(frontend));
+    qemu_sem_post(&fixture.release);
+    g_assert_null(qemu_thread_join(&thread));
+    g_assert_true(qemu_chr_socket_fd_preserve_blocking_configured(frontend));
+
+    qemu_sem_destroy(&fixture.release);
+    qemu_sem_destroy(&fixture.held);
+}
