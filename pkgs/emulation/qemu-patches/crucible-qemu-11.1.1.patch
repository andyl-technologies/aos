+int qemu_crucible_checkpoint_inventory_metadata_holder_current_v1(
+    QemuCrucibleCheckpointInventoryLoan *loan,
+    QemuCrucibleCheckpointInventoryMetadataBorrow **holder)
+{
+    int status = checkpoint_inventory_identity(loan);
+
+    if (status || holder != &loan->metadata_borrow) {
+        return status ? status : -EPERM;
+    }
+    /* Compare only the canonical prebirth-paid field's actual address. No
+     * escaped caller address is dereferenced and no Original is queried. */
+    return 0;
+}
