+/* Sim uses exact picoseconds, with a fixed 20 GIPS instruction model. */
+#define CRUCIBLE_SIM_TICKS_PER_NS ICOUNT_PS_PER_NS
+#define CRUCIBLE_SIM_TICKS_PER_INSTRUCTION 50
+
+static inline int64_t icount_instruction_ps(bool sim, int shift)
+{
+    if (sim) {
+        return CRUCIBLE_SIM_TICKS_PER_INSTRUCTION;
+    }
+
+    g_assert(shift >= 0 && shift <= ICOUNT_MAX_SHIFT_NS);
+    return ICOUNT_PS_PER_NS << shift;
