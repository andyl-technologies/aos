+static inline int64_t icount_round_duration_ps(int64_t deadline_ps,
+                                               int64_t instruction_ps)
+{
+    g_assert(instruction_ps > 0);
+    if (deadline_ps <= 0) {
+        return 0;
+    }
+    return deadline_ps / instruction_ps +
+           (deadline_ps % instruction_ps != 0);
+}
