+    g_assert_cmpint(crucible_metadata_controller_reserve(
+        &partition, fixture_requests, &output), ==, -ECANCELED);
+    g_assert_cmpint(crucible_metadata_partition_status(
+        &partition, -ETIMEDOUT), ==, -ECANCELED);
