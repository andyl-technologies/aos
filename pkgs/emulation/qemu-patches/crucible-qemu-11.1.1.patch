+static void rr_crucible_sim_main_loop_poll_ready(int poll_result,
+                                                 int64_t timeout_ns)
+{
+    bool deadline_ready = poll_result == 0 && timeout_ns >= 0;
+    uint64_t generation;
+
+    if (!rr_crucible_sim_quantum_dispatch_fence() ||
+        (poll_result <= 0 && !deadline_ready)) {
+        return;
+    }
+
+    generation = qatomic_fetch_inc(
+        &rr_external_main_loop_work_published) + 1;
+    trace_crucible_sim_main_loop_poll_ready(generation, poll_result,
+                                            timeout_ns);
+    rr_crucible_sim_notify_dispatch_ceiling();
+}
+
+static void rr_crucible_sim_main_loop_poll(Notifier *notifier, void *opaque)
+{
+    MainLoopPoll *poll = opaque;
+    uint64_t requested;
+
+    (void)notifier;
+    if (poll->state == MAIN_LOOP_POLL_FILL) {
+        /* Empty follow-up passes must park until real host work is ready. */
+        poll->timeout = UINT32_MAX;
+        qatomic_store_release(
+            &rr_chained_main_loop_work_polling,
+            qatomic_load_acquire(&rr_chained_main_loop_work_published));
+        return;
+    }
+    if (poll->state == MAIN_LOOP_POLL_OK ||
+        poll->state == MAIN_LOOP_POLL_ERR) {
+        qatomic_store_release(
+            &rr_external_main_loop_work_polling,
+            qatomic_load_acquire(&rr_external_main_loop_work_published));
+        /* os_host_main_loop_wait() has dispatched the ready host sources. */
+        qatomic_store_release(
+            &rr_external_main_loop_work_completed,
+            qatomic_load_acquire(&rr_external_main_loop_work_polling));
+        return;
+    }
+    g_assert(poll->state == MAIN_LOOP_POLL_DONE);
+
+    qatomic_store_release(
+        &rr_vcpu_main_loop_work_completed,
+        qatomic_load_acquire(&rr_vcpu_main_loop_work_published));
+    qatomic_store_release(
+        &rr_chained_main_loop_work_completed,
+        qatomic_load_acquire(&rr_chained_main_loop_work_polling));
+    qatomic_store_release(&rr_main_loop_dispatch_active, false);
+
+    requested = qatomic_load_acquire(&rr_main_loop_dispatch_requested);
+    if (requested !=
+        qatomic_load_acquire(&rr_main_loop_dispatch_completed)) {
+        qatomic_store_release(&rr_main_loop_dispatch_completed, requested);
+        rr_crucible_sim_notify_dispatch_ceiling();
+    }
+}
+
+static void rr_crucible_sim_main_loop_replay_released(void)
+{
+    uint64_t completed =
+        qatomic_load_acquire(&rr_main_loop_dispatch_completed);
+
+    while (qatomic_load_acquire(&rr_main_loop_dispatch_acknowledged) <
+           completed) {
+        qemu_event_reset(&rr_main_loop_resume_event);
+        if (qatomic_load_acquire(&rr_main_loop_dispatch_acknowledged) >=
+            completed) {
+            break;
+        }
+        qemu_event_wait(&rr_main_loop_resume_event);
+    }
+
+    if (qatomic_xchg(&rr_main_loop_poll_priming, false)) {
+        rr_crucible_sim_notify_dispatch_ceiling();
+    }
+}
