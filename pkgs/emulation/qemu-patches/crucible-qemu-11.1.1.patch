+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Check the literal complete-cohort comparison without issuing an owner.
+
+Local mapped-word and journal inputs exercise physical leaves only. They do not
+construct a paid session, recipient, module owner, Original or selected entry.
+Every omission is independently rebuilt against the same unchanged assertions.
+"""
+
+import argparse
+import json
+import os
+from pathlib import Path
+import resource
+import runpy
+import shlex
+import subprocess
+
+
+def content_controls(body):
+    import re
+
+    checks = ["int main(void) {",
+              "QemuCrucibleBoundaryActionRecord left = { .planned_count = 4 };",
+              "QemuCrucibleBoundaryActionRecord right = left;",
+              "assert(advance_cohort_equal(&left, &right));"]
+    controls = {"positive": body}
+    fields = re.findall(r"left->([a-z_]+) != right->\1", body)
+    for field in fields:
+        checks.extend(["right = left;", f"right.{field}++;",
+                       "assert(!advance_cohort_equal(&left, &right));"])
+        predicate = f"left->{field} != right->{field}"
+        controls["omit-cohort-" + field] = body.replace(predicate, "false")
+    for prefix, stem in (("binding", "binding"), ("rows[3]", "row")):
+        start = body.index("const QemuCrucibleProducingActionRow *a") if stem == "row" else 0
+        part = body[start:] if stem == "row" else body[:body.index("for (size_t index")]
+        for field in re.findall(r"a->([a-z_]+) != b->\1", part):
+            checks.extend(["right = left;", f"right.{prefix}.{field}++;",
+                           "assert(!advance_cohort_equal(&left, &right));"])
+            controls["omit-" + stem + "-" + field] = body.replace(
+                f"a->{field} != b->{field}", "false")
+        arrays = ("source_capability", "source_reservation") if stem == "binding" else ("lender_capability",)
+        for field in arrays:
+            for index in (0, 31):
+                checks.extend(["right = left;", f"right.{prefix}.{field}[{index}]++;",
+                               "assert(!advance_cohort_equal(&left, &right));"])
+            controls["omit-" + stem + "-" + field] = body.replace(
+                f"memcmp(a->{field}, b->{field}, 32)", "false")
+    checks.extend(["left.planned_count = right.planned_count = 5;",
+                   "assert(!advance_cohort_equal(&left, &right));",
+                   'puts("PASS complete cohort content leaf; no membership or Original");',
+                   "return 0; }"])
+    controls["restrict-capacity"] = body.replace(
+        "left->planned_count > QEMU_CRUCIBLE_ACTION_PARENT_CAPACITY",
+        "left->planned_count >= QEMU_CRUCIBLE_ACTION_PARENT_CAPACITY")
+    return controls, "\n".join(checks)
+
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("source", type=Path)
+    parser.add_argument("output", type=Path)
+    args = parser.parse_args()
+    source = args.source.resolve()
+    output = args.output.resolve()
+    output.mkdir(parents=True, exist_ok=True)
+    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
+
+    extract = runpy.run_path(str(source / "tests/unit/extract-crucible-startup-source-controls.py"))
+    receiver = (source / "plugins/crucible-advance-receiver.inc.h").read_text()
+    bodies = extract["function"](receiver, "static bool advance_cohort_equal(")
+    before = ('#include "qemu/osdep.h"\n'
+              '#include "plugins/crucible-startup-source.h"\n')
+    controls, checks = content_controls(bodies)
+    proof = {}
+    for name, body in controls.items():
+        if name != "positive" and body == bodies:
+            raise ValueError("unchanged omission: " + name)
+        c_file = output / (name + ".c")
+        binary = output / name
+        c_file.write_text(before + "\n" + body + "\n" + checks)
+        command = [os.environ.get("CC", "cc"), *shlex.split(os.environ.get("CFLAGS", "")),
+                   str(c_file), "-o", str(binary),
+                   *shlex.split(os.environ.get("LDFLAGS", ""))]
+        (output / (name + ".command.json")).write_text(json.dumps(command, indent=2) + "\n")
+        compiled = subprocess.run(command, text=True, stdout=subprocess.PIPE,
+                                  stderr=subprocess.STDOUT)
+        (output / (name + ".compile.log")).write_text(compiled.stdout)
+        compiled.check_returncode()
+        result = subprocess.run([str(binary)], text=True, stdout=subprocess.PIPE,
+                                stderr=subprocess.STDOUT, timeout=30)
+        (output / (name + ".log")).write_text(result.stdout)
+        expected = 0 if name == "positive" else -6
+        if result.returncode != expected:
+            raise RuntimeError(f"{name}: expected {expected}, got {result.returncode}")
+        proof[name] = {"returncode": result.returncode, "output": result.stdout}
+    (output / "proof.json").write_text(json.dumps(proof, indent=2) + "\n")
+    print(proof["positive"]["output"], end="")
+    print(f"PASS {len(controls) - 2} independently rebuilt omissions and one capacity restriction")
+
+
+if __name__ == "__main__":
+    main()
