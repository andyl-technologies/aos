+/* A successful seal is single-use for one stopped source process. */
+static GPtrArray *crucible_block_sealed_roots;
+static uint64_t crucible_block_seal_backend_generation;
+static uint64_t crucible_block_seal_graph_generation;
+static uint64_t crucible_block_seal_barrier_generation;
+static uint64_t crucible_block_seal_runstate_generation;
+static uint64_t crucible_block_seal_vmstop_generation;
+static uint64_t crucible_block_seal_vmstop_request_generation;
+static pid_t crucible_block_seal_pid;
+static bool crucible_block_seal_receipt_invalidated;
+static const QemuBlockHotForkSourceSet *crucible_block_seal_sources;
+
+static void crucible_block_seal_receipt_dispose(void)
+{
+    g_clear_pointer(&crucible_block_sealed_roots, g_ptr_array_unref);
+    crucible_block_seal_backend_generation = 0;
+    crucible_block_seal_graph_generation = 0;
+    crucible_block_seal_barrier_generation = 0;
+    crucible_block_seal_runstate_generation = 0;
+    crucible_block_seal_vmstop_generation = 0;
+    crucible_block_seal_vmstop_request_generation = 0;
+    crucible_block_seal_pid = 0;
+    crucible_block_seal_receipt_invalidated = false;
+    crucible_block_seal_sources = NULL;
+}
+
+void qemu_crucible_block_seal_child_reset(void)
+{
+    /* A forked child cannot inherit source-process receipt authority. */
+    if (crucible_block_seal_pid != getpid()) {
+        crucible_block_seal_receipt_dispose();
+    }
+}
+
+static bool crucible_block_seal_stop_provenance_current(void)
+{
+    uint64_t runstate = qemu_runstate_transition_generation();
+    uint64_t vmstop = qemu_plugin_crucible_vmstop_generation();
+    uint64_t request = qemu_vmstop_request_generation();
+
+    return runstate != UINT64_MAX && vmstop != UINT64_MAX &&
+        request != UINT64_MAX && vmstop != 0 &&
+        runstate == crucible_block_seal_runstate_generation &&
+        vmstop == crucible_block_seal_vmstop_generation &&
+        request == crucible_block_seal_vmstop_request_generation;
+}
+
+static bool crucible_block_seal_boundary(void)
+{
+    return runstate_check(RUN_STATE_PAUSED) &&
+        qemu_plugin_crucible_vmstop_pending() &&
+        !qemu_plugin_crucible_vmstop_admission_pending() &&
+        qemu_plugin_crucible_vmstop_flush_status() == 0 &&
+        (!qemu_plugin_crucible_vmstop_cold_origin() ||
+         qemu_crucible_cold_stop_receipt_valid());
+}
+
+static bool GRAPH_RDLOCK crucible_block_seal_file(
+    BlockDriverState *root, char **path,
+    BdrvCrucibleHotForkFileState *file, Error **errp)
+{
+    BlockDriverState *leaf;
+    struct stat metadata;
+    char descriptor_path[64], resolved[PATH_MAX + 1];
+    ssize_t length;
+
+    if (!root || !root->drv ||
+        strcmp(root->drv->format_name, "qcow2") != 0 ||
+        !root->file || !(leaf = root->file->bs) || !leaf->drv ||
+        strcmp(leaf->drv->format_name, "file") != 0 ||
+        !leaf->drv->bdrv_crucible_hot_fork_file ||
+        !leaf->drv->bdrv_crucible_hot_fork_file(
+            leaf, BDRV_CRUCIBLE_HOT_FORK_FILE_QUERY, file, errp)) {
+        if (!errp || !*errp) {
+            error_setg(errp, "Crucible block seal requires a file-backed qcow2 root");
+        }
+        return false;
+    }
+    /* Native descriptor custody remains authoritative after fdset opening or
+     * child adoption; a launch filename can still name the parent's inode. */
+    g_snprintf(descriptor_path, sizeof(descriptor_path), "/proc/self/fd/%d",
+               file->descriptor);
+    length = readlink(descriptor_path, resolved, PATH_MAX);
+    if (length <= 0 || length == PATH_MAX) {
+        error_setg(errp, "Crucible block seal file has no bounded native path");
+        return false;
+    }
+    resolved[length] = '\0';
+    if (fstat(file->descriptor, &metadata) < 0 ||
+        !S_ISREG(metadata.st_mode) ||
+        metadata.st_dev != file->device || metadata.st_ino != file->inode) {
+        error_setg(errp, "Crucible block seal lost its native regular descriptor");
+        return false;
+    }
+    *path = g_strdup(resolved);
+    return true;
+}
+
+static bool GRAPH_RDLOCK crucible_block_seal_empty(
+    BlockDriverState *overlay, BlockDriverState *snapshot,
+    uint64_t *virtual_size, Error **errp)
+{
+    int64_t length = bdrv_getlength(overlay);
+    int64_t offset = 0;
+
+    if (length < 0 || length != bdrv_getlength(snapshot)) {
+        error_setg(errp, "Crucible block seal overlay and snapshot sizes differ");
+        return false;
+    }
+    while (offset < length) {
+        int64_t bytes = length - offset;
+        int64_t pnum = 0;
+        int allocated = bdrv_is_allocated_above(
+            overlay, snapshot, false, offset, bytes, &pnum);
+
+        if (allocated < 0 || allocated != 0 || pnum <= 0 || pnum > bytes) {
+            error_setg(errp, "Crucible block seal overlay is not empty at "
+                       "offset %" PRId64,
+                       offset);
+            return false;
+        }
+        offset += pnum;
+    }
+    *virtual_size = length;
+    return true;
+}
+
+static CrucibleHotForkBlockSealedRoot *
+crucible_block_seal_copy_root(const CrucibleHotForkBlockSealedRoot *source)
+{
+    CrucibleHotForkBlockSealedRoot *copy = g_new0(
+        CrucibleHotForkBlockSealedRoot, 1);
+
+    *copy = *source;
+    copy->backend_name = g_strdup(source->backend_name);
+    copy->overlay_node_name = g_strdup(source->overlay_node_name);
+    copy->snapshot_node_name = g_strdup(source->snapshot_node_name);
+    copy->snapshot_file_path = g_strdup(source->snapshot_file_path);
+    return copy;
+}
+
+static bool crucible_block_seal_receipt_current(void)
+{
+    size_t index;
+
+    for (index = 0; index < crucible_block_sealed_roots->len; index++) {
+        CrucibleHotForkBlockSealedRoot *root =
+            g_ptr_array_index(crucible_block_sealed_roots, index);
+        BlockBackend *backend = blk_by_name(root->backend_name);
+        BlockDriverState *overlay = backend ? blk_bs(backend) : NULL;
+        BlockDriverState *snapshot;
+        BdrvCrucibleHotForkFileState file;
+        g_autofree char *path = NULL;
+        Error *local_err = NULL;
+        bool current;
+
+        if (!overlay) {
+            return false;
+        }
+        {
+            GRAPH_RDLOCK_GUARD_MAINLOOP();
+            snapshot = bdrv_cow_bs(overlay);
+            current = snapshot &&
+                strcmp(bdrv_get_node_name(overlay),
+                       root->overlay_node_name) == 0 &&
+                strcmp(bdrv_get_node_name(snapshot),
+                       root->snapshot_node_name) == 0 &&
+                bdrv_is_writable(overlay) && bdrv_is_read_only(snapshot) &&
+                crucible_block_seal_file(snapshot, &path, &file,
+                                         &local_err) &&
+                file.read_only &&
+                file.device == root->snapshot_file_device &&
+                file.inode == root->snapshot_file_inode;
+        }
+        error_free(local_err);
+        if (!current) {
+            return false;
+        }
+    }
+    return true;
+}
+
+bool qemu_crucible_block_seal_source_acquire(
+    const QemuBlockHotForkSourceSet *sources, Error **errp)
+{
+    GLOBAL_STATE_CODE();
+    if (!crucible_block_sealed_roots) {
+        return true;
+    }
+    if (crucible_block_seal_pid != getpid() ||
+        crucible_block_seal_receipt_invalidated ||
+        (crucible_block_seal_sources && crucible_block_seal_sources != sources) ||
+        !crucible_block_seal_stop_provenance_current() ||
+        !crucible_block_seal_boundary() ||
+        !qemu_block_hot_fork_source_set_restored_current(sources, errp) ||
+        !crucible_block_seal_receipt_current()) {
+        if (!errp || !*errp) {
+            error_setg(errp, "Crucible block seal lost its original source owner");
+        }
+        return false;
+    }
+    crucible_block_seal_sources = sources;
+    return true;
+}
+
+bool qemu_crucible_block_seal_source_release(
+    const QemuBlockHotForkSourceSet *sources, Error **errp)
+{
+    QemuBlockBackendHotForkBarrierInventory barrier;
+    bool released;
+
+    GLOBAL_STATE_CODE();
+    if (!crucible_block_sealed_roots) {
+        return true;
+    }
+    /* Membership precedes source inspection; another set cannot retire debt. */
+    if (crucible_block_seal_pid != getpid() ||
+        !sources || sources != crucible_block_seal_sources ||
+        !qemu_block_hot_fork_source_set_restored_current(sources, errp) ||
+        !crucible_block_seal_receipt_current() ||
+        !qemu_block_backend_hot_fork_barrier(
+            QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_QUERY, &barrier)) {
+        if (!errp || !*errp) {
+            error_setg(errp, "Crucible block seal retains its original source debt");
+        }
+        return false;
+    }
+    released = !barrier.held && !barrier.graph_held && !barrier.snapshot_bound;
+    qemu_block_backend_hot_fork_barrier_inventory_destroy(&barrier);
+    if (!released) {
+        error_setg(errp, "Crucible block seal still retains native barriers");
+        return false;
+    }
+    /* The immutable backing graph remains; only its completed receipt retires.
+     * A later seal must validate and physically seal the new writable root. */
+    crucible_block_seal_receipt_dispose();
+    return true;
+}
+
+CrucibleHotForkBlockSealState *
+qmp_query_crucible_hot_fork_block_seal(Error **errp)
+{
+    QemuBlockBackendHotForkInventory inventory;
+    BdrvGraphHotForkBarrierState graph;
+    QemuBlockBackendHotForkBarrierInventory barrier;
+    CrucibleHotForkBlockSealState *state = g_new0(
+        CrucibleHotForkBlockSealState, 1);
+    CrucibleHotForkBlockSealCandidateList **candidate_tail =
+        &state->candidates;
+    CrucibleHotForkBlockSealedRootList **sealed_tail =
+        &state->sealed_roots;
+    bool inventory_overflowed;
+    size_t index;
+
+    GLOBAL_STATE_CODE();
+    qemu_block_backend_hot_fork_inventory(&inventory);
+    bdrv_graph_hot_fork_barrier(BDRV_GRAPH_HOT_FORK_BARRIER_QUERY, &graph);
+    if (qemu_block_backend_hot_fork_barrier(
+            QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_QUERY, &barrier)) {
+        state->barrier_held = barrier.held && barrier.graph_held;
+        state->barrier_generation = barrier.generation;
+        state->barrier_quiescent = barrier.quiescent;
+        qemu_block_backend_hot_fork_barrier_inventory_destroy(&barrier);
+    }
+    state->schema_version = 1;
+    state->qemu_pid = getpid();
+    state->backend_generation = inventory.generation;
+    state->graph_mutation_generation = graph.mutation_generation;
+
+    for (index = 0; index < inventory.entry_count; index++) {
+        QemuBlockBackendHotForkInventoryEntry *entry = &inventory.entries[index];
+        CrucibleHotForkBlockSealCandidate *candidate;
+        CrucibleHotForkBlockSealCandidateList *link;
+        BlockBackend *backend;
+        BlockDriverState *root;
+        BdrvCrucibleHotForkFileState file = { 0 };
+        g_autofree char *path = NULL;
+        Error *local_err = NULL;
+        int64_t size;
+
+        if (!entry->root_present || entry->external_shared ||
+            !(entry->permissions & BLK_PERM_WRITE)) {
+            continue;
+        }
+        candidate = g_new0(CrucibleHotForkBlockSealCandidate, 1);
+        candidate->backend_id = entry->backend_id;
+        candidate->backend_name = g_strdup(entry->name);
+        candidate->root_node_name = g_strdup("");
+        candidate->file_path = g_strdup("");
+        backend = entry->named ? blk_by_name(entry->name) : NULL;
+        root = backend ? blk_bs(backend) : NULL;
+        if (root) {
+            GRAPH_RDLOCK_GUARD_MAINLOOP();
+            g_free(candidate->root_node_name);
+            candidate->root_node_name = g_strdup(bdrv_get_node_name(root));
+            if (crucible_block_seal_file(root, &path, &file, &local_err) &&
+                (size = bdrv_getlength(root)) >= 0) {
+                g_free(candidate->file_path);
+                candidate->file_path = g_strdup(path);
+                candidate->file_device = file.device;
+                candidate->file_inode = file.inode;
+                candidate->virtual_size = size;
+            }
+        }
+        error_free(local_err);
+        link = g_new0(CrucibleHotForkBlockSealCandidateList, 1);
+        link->value = candidate;
+        *candidate_tail = link;
+        candidate_tail = &link->next;
+    }
+    inventory_overflowed = inventory.overflowed;
+    qemu_block_backend_hot_fork_inventory_destroy(&inventory);
+
+    if (crucible_block_sealed_roots &&
+        !crucible_block_seal_receipt_invalidated) {
+        bool current = crucible_block_seal_pid == getpid() &&
+            crucible_block_seal_stop_provenance_current() &&
+            crucible_block_seal_boundary() && !inventory_overflowed &&
+            !graph.writer_active && !graph.waiting_writers &&
+            state->barrier_held && state->barrier_quiescent &&
+            state->barrier_generation ==
+                crucible_block_seal_barrier_generation &&
+            crucible_block_seal_backend_generation ==
+                state->backend_generation &&
+            crucible_block_seal_graph_generation ==
+                state->graph_mutation_generation &&
+            crucible_block_seal_receipt_current();
+
+        if (current) {
+            state->receipt_generation = 1;
+            for (index = 0; index < crucible_block_sealed_roots->len; index++) {
+                CrucibleHotForkBlockSealedRootList *link = g_new0(
+                    CrucibleHotForkBlockSealedRootList, 1);
+
+                link->value = crucible_block_seal_copy_root(
+                    g_ptr_array_index(crucible_block_sealed_roots, index));
+                *sealed_tail = link;
+                sealed_tail = &link->next;
+            }
+        } else {
+            crucible_block_seal_receipt_invalidated = true;
+        }
+    }
+    return state;
+}
+
+bool qemu_crucible_block_seal_ready(void)
+{
+    CrucibleHotForkBlockSealState *state;
+    QemuBlockBackendHotForkInventory inventory;
+    BdrvGraphHotForkBarrierState graph;
+    bool ready;
+
+    if (!bql_locked()) {
+        return false;
+    }
+    qemu_block_backend_hot_fork_inventory(&inventory);
+    bdrv_graph_hot_fork_barrier(BDRV_GRAPH_HOT_FORK_BARRIER_QUERY, &graph);
+    ready = !inventory.overflowed && !graph.writer_active &&
+        !graph.waiting_writers;
+    qemu_block_backend_hot_fork_inventory_destroy(&inventory);
+    if (!ready) {
+        crucible_block_seal_receipt_invalidated = true;
+        return false;
+    }
+
+    state = qmp_query_crucible_hot_fork_block_seal(NULL);
+    ready = state->receipt_generation != 0;
+
+    qapi_free_CrucibleHotForkBlockSealState(state);
+    return ready;
+}
+
+static bool crucible_block_seal_validate(
+    CrucibleHotForkBlockSealRequestList *roots,
+    uint64_t expected_backend_generation,
+    uint64_t expected_graph_generation, bool check_backend_generation,
+    Error **errp)
+{
+    QemuBlockBackendHotForkInventory inventory;
+    BdrvGraphHotForkBarrierState graph;
+    CrucibleHotForkBlockSealRequestList *request = roots;
+    size_t index;
+    bool valid = false;
+
+    qemu_block_backend_hot_fork_inventory(&inventory);
+    bdrv_graph_hot_fork_barrier(BDRV_GRAPH_HOT_FORK_BARRIER_QUERY, &graph);
+    if (inventory.overflowed || graph.held || graph.writer_active ||
+        graph.waiting_writers ||
+        (check_backend_generation &&
+         inventory.generation != expected_backend_generation) ||
+        graph.mutation_generation != expected_graph_generation) {
+        error_setg(errp, "Crucible block seal backend or graph generation is stale");
+        goto out;
+    }
+    for (index = 0; index < inventory.entry_count; index++) {
+        QemuBlockBackendHotForkInventoryEntry *entry = &inventory.entries[index];
+        CrucibleHotForkBlockSealRequest *item;
+        BlockBackend *backend;
+        BlockDriverState *snapshot;
+        BlockDriverState *overlay;
+        BdrvCrucibleHotForkFileState file;
+        BdrvCrucibleHotForkFileState overlay_file;
+        BdrvChild *parent;
+        g_autofree char *path = NULL;
+        g_autofree char *overlay_path = NULL;
+        unsigned parent_count = 0;
+
+        if (!entry->root_present || entry->external_shared ||
+            !(entry->permissions & BLK_PERM_WRITE)) {
+            continue;
+        }
+        if (!request || !entry->named || !entry->name_valid) {
+            error_setg(errp, "Crucible block seal lacks one writable rooted backend");
+            goto out;
+        }
+        item = request->value;
+        if (!item || item->backend_id != entry->backend_id ||
+            strcmp(item->backend_name, entry->name) != 0 ||
+            !id_wellformed(item->backend_name) ||
+            !id_wellformed(item->snapshot_node_name) ||
+            !id_wellformed(item->overlay_node_name)) {
+            error_setg(errp, "Crucible block seal backend identity or order differs");
+            goto out;
+        }
+        backend = blk_by_name(item->backend_name);
+        snapshot = backend ? blk_bs(backend) : NULL;
+        overlay = bdrv_find_node(item->overlay_node_name);
+        if (!snapshot || !overlay || snapshot == overlay) {
+            error_setg(errp, "Crucible block seal root or overlay is missing");
+            goto out;
+        }
+        {
+            GRAPH_RDLOCK_GUARD_MAINLOOP();
+            QLIST_FOREACH(parent, &snapshot->parents, next_parent) {
+                parent_count++;
+            }
+            if (parent_count != 1 || !QLIST_EMPTY(&overlay->parents) ||
+                bdrv_cow_bs(overlay) || !bdrv_is_writable(snapshot) ||
+                !bdrv_is_writable(overlay) ||
+                !overlay->drv ||
+                strcmp(overlay->drv->format_name, "qcow2") != 0 ||
+                overlay->backing_file[0] ||
+                strcmp(bdrv_get_node_name(snapshot),
+                       item->snapshot_node_name) != 0 ||
+                !crucible_block_seal_file(snapshot, &path, &file, errp) ||
+                !crucible_block_seal_file(overlay, &overlay_path,
+                                          &overlay_file, errp) ||
+                overlay_file.read_only ||
+                strcmp(path, overlay_path) == 0 ||
+                (overlay_file.device == file.device &&
+                 overlay_file.inode == file.inode)) {
+                if (!errp || !*errp) {
+                    error_setg(errp, "Crucible block seal requires one named "
+                               "qcow2 root and separate empty file-backed "
+                               "overlay");
+                }
+                goto out;
+            }
+            if (file.device != item->snapshot_file_device ||
+                file.inode != item->snapshot_file_inode) {
+                error_setg(errp, "Crucible block seal file identity changed");
+                goto out;
+            }
+        }
+        request = request->next;
+    }
+    if (request || roots == NULL) {
+        error_setg(errp, "Crucible block seal has extra roots or no writable roots");
+        goto out;
+    }
+    valid = true;
+out:
+    qemu_block_backend_hot_fork_inventory_destroy(&inventory);
+    return valid;
+}
+
+CrucibleHotForkBlockSealState *qmp_crucible_hot_fork_block_seal(
+    int64_t expected_qemu_pid, uint64_t expected_backend_generation,
+    uint64_t expected_graph_mutation_generation,
+    CrucibleHotForkBlockSealRequestList *roots, Error **errp)
+{
+    CrucibleHotForkBlockSealRequestList *request;
+    ExternalSnapshotState **snapshots = NULL;
+    GPtrArray *sealed = NULL;
+    Transaction *transaction = NULL;
+    BlockReopenQueue *reopen = NULL;
+    Error *local_err = NULL;
+    QemuBlockBackendHotForkBarrierInventory barrier;
+    size_t count = 0;
+    size_t index = 0;
+    int flush_status;
+    uint64_t runstate_generation;
+    uint64_t vmstop_generation;
+    uint64_t vmstop_request_generation;
+
+    GLOBAL_STATE_CODE();
+    if (crucible_block_sealed_roots &&
+        crucible_block_seal_pid != getpid()) {
+        qemu_crucible_block_seal_child_reset();
+    }
+    if (expected_qemu_pid != getpid() || !crucible_block_seal_boundary() ||
+        crucible_block_sealed_roots) {
+        error_setg(errp, "Crucible block seal requires one exact stopped "
+                   "source process");
+        return NULL;
+    }
+    runstate_generation = qemu_runstate_transition_generation();
+    vmstop_generation = qemu_plugin_crucible_vmstop_generation();
+    vmstop_request_generation = qemu_vmstop_request_generation();
+    if (runstate_generation == UINT64_MAX || !vmstop_generation ||
+        vmstop_generation == UINT64_MAX ||
+        vmstop_request_generation == UINT64_MAX) {
+        error_setg(errp, "Crucible block seal stop provenance is exhausted");
+        return NULL;
+    }
+    for (request = roots; request; request = request->next) {
+        if (++count > QEMU_BLOCK_BACKEND_HOT_FORK_INVENTORY_MAX) {
+            error_setg(errp, "Crucible block seal root count exceeds native bound");
+            return NULL;
+        }
+    }
+    if (!crucible_block_seal_validate(
+            roots, expected_backend_generation,
+            expected_graph_mutation_generation, true, errp)) {
+        return NULL;
+    }
+
+    bdrv_drain_all();
+    flush_status = bdrv_flush_all();
+    if (flush_status < 0) {
+        error_setg_errno(errp, -flush_status,
+                         "Crucible block seal could not flush all devices");
+        return NULL;
+    }
+    if (!crucible_block_seal_boundary() ||
+        runstate_generation != qemu_runstate_transition_generation() ||
+        vmstop_generation != qemu_plugin_crucible_vmstop_generation() ||
+        vmstop_request_generation != qemu_vmstop_request_generation() ||
+        !crucible_block_seal_validate(
+            roots, expected_backend_generation,
+            expected_graph_mutation_generation, false, errp)) {
+        if (!errp || !*errp) {
+            error_setg(errp, "Crucible block seal stop changed during flush");
+        }
+        return NULL;
+    }
+
+    transaction = tran_new();
+    snapshots = g_new0(ExternalSnapshotState *, count);
+    sealed = g_ptr_array_new_with_free_func(
+        (GDestroyNotify)qapi_free_CrucibleHotForkBlockSealedRoot);
+    for (request = roots; request; request = request->next, index++) {
+        BlockdevSnapshot snapshot = {
+            .node = request->value->snapshot_node_name,
+            .overlay = request->value->overlay_node_name,
+        };
+        TransactionAction action = {
+            .type = TRANSACTION_ACTION_KIND_BLOCKDEV_SNAPSHOT,
+            .u.blockdev_snapshot.data = &snapshot,
+        };
+
+        external_snapshot_action(&action, transaction, &snapshots[index],
+                                 &local_err);
+        if (local_err) {
+            goto abort;
+        }
+    }
+
+    index = 0;
+    for (request = roots; request; request = request->next, index++) {
+        ExternalSnapshotState *snapshot = snapshots[index];
+        CrucibleHotForkBlockSealedRoot *root = g_new0(
+            CrucibleHotForkBlockSealedRoot, 1);
+        BdrvCrucibleHotForkFileState file;
+        g_autofree char *path = NULL;
+
+        {
+            GRAPH_RDLOCK_GUARD_MAINLOOP();
+            if (!snapshot->overlay_appended ||
+                bdrv_cow_bs(snapshot->new_bs) != snapshot->old_bs ||
+                !crucible_block_seal_file(snapshot->old_bs, &path, &file,
+                                          &local_err) ||
+                file.device != request->value->snapshot_file_device ||
+                file.inode != request->value->snapshot_file_inode ||
+                !crucible_block_seal_empty(snapshot->new_bs,
+                                            snapshot->old_bs,
+                                            &root->virtual_size, &local_err)) {
+                if (!local_err) {
+                    error_setg(&local_err, "Crucible block seal graph changed "
+                               "during append");
+                }
+            }
+        }
+        if (local_err) {
+            qapi_free_CrucibleHotForkBlockSealedRoot(root);
+            goto abort;
+        }
+        root->backend_id = request->value->backend_id;
+        root->backend_name = g_strdup(request->value->backend_name);
+        root->overlay_node_name = g_strdup(request->value->overlay_node_name);
+        root->snapshot_node_name = g_strdup(request->value->snapshot_node_name);
+        root->snapshot_file_path = g_strdup(path);
+        root->snapshot_file_device = file.device;
+        root->snapshot_file_inode = file.inode;
+        root->overlay_empty = true;
+        g_ptr_array_add(sealed, root);
+
+        QDict *options = qdict_new();
+        qdict_put_bool(options, BDRV_OPT_READ_ONLY, true);
+        reopen = bdrv_reopen_queue(reopen, snapshot->old_bs, options, true);
+    }
+    if (bdrv_reopen_multiple(reopen, &local_err) < 0) {
+        reopen = NULL;
+        goto abort;
+    }
+    reopen = NULL;
+
+    for (index = 0; index < count; index++) {
+        ExternalSnapshotState *snapshot = snapshots[index];
+        BdrvCrucibleHotForkFileState file;
+        g_autofree char *path = NULL;
+
+        GRAPH_RDLOCK_GUARD_MAINLOOP();
+        if (!bdrv_is_read_only(snapshot->old_bs) ||
+            !crucible_block_seal_file(snapshot->old_bs, &path, &file,
+                                      &local_err) || !file.read_only) {
+            if (!local_err) {
+                error_setg(&local_err, "Crucible block seal did not close "
+                           "writable file custody");
+            }
+            goto reopen_abort;
+        }
+        ((CrucibleHotForkBlockSealedRoot *)
+            g_ptr_array_index(sealed, index))->snapshot_read_only = true;
+    }
+    if (!crucible_block_seal_boundary() ||
+        runstate_generation != qemu_runstate_transition_generation() ||
+        vmstop_generation != qemu_plugin_crucible_vmstop_generation() ||
+        vmstop_request_generation != qemu_vmstop_request_generation()) {
+        error_setg(&local_err, "Crucible block seal stop changed before commit");
+        goto reopen_abort;
+    }
+    if (!qemu_block_backend_hot_fork_barrier(
+            QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_HOLD, &barrier)) {
+        error_setg(&local_err, "Crucible block seal could not retain the "
+                   "block barrier");
+        goto reopen_abort;
+    }
+    if (!barrier.quiescent || barrier.snapshot_bound) {
+        qemu_block_backend_hot_fork_barrier_inventory_destroy(&barrier);
+        qemu_block_backend_hot_fork_barrier(
+            QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_RELEASE, &barrier);
+        qemu_block_backend_hot_fork_barrier_inventory_destroy(&barrier);
+        error_setg(&local_err, "Crucible block seal did not reach a quiescent barrier");
+        goto reopen_abort;
+    }
+    crucible_block_seal_barrier_generation = barrier.generation;
+    qemu_block_backend_hot_fork_barrier_inventory_destroy(&barrier);
+    tran_commit(transaction);
+    transaction = NULL;
+    g_free(snapshots);
+    snapshots = NULL;
+    crucible_block_sealed_roots = sealed;
+    crucible_block_seal_pid = getpid();
+    crucible_block_seal_runstate_generation = runstate_generation;
+    crucible_block_seal_vmstop_generation = vmstop_generation;
+    crucible_block_seal_vmstop_request_generation =
+        vmstop_request_generation;
+
+    {
+        QemuBlockBackendHotForkInventory inventory;
+        BdrvGraphHotForkBarrierState graph;
+
+        qemu_block_backend_hot_fork_inventory(&inventory);
+        bdrv_graph_hot_fork_barrier(BDRV_GRAPH_HOT_FORK_BARRIER_QUERY, &graph);
+        crucible_block_seal_backend_generation = inventory.generation;
+        crucible_block_seal_graph_generation = graph.mutation_generation;
+        qemu_block_backend_hot_fork_inventory_destroy(&inventory);
+    }
+    return qmp_query_crucible_hot_fork_block_seal(errp);
+
+reopen_abort:
+    reopen = NULL;
+    for (index = 0; index < count; index++) {
+        QDict *options = qdict_new();
+
+        qdict_put_bool(options, BDRV_OPT_READ_ONLY, false);
+        reopen = bdrv_reopen_queue(reopen, snapshots[index]->old_bs,
+                                   options, true);
+    }
+    {
+        Error *restore_err = NULL;
+
+        if (bdrv_reopen_multiple(reopen, &restore_err) < 0) {
+            error_report_err(restore_err);
+            /* A partly sealed graph cannot be returned as a live source. */
+            abort();
+        }
+    }
+    reopen = NULL;
+abort:
+    bdrv_reopen_queue_free(reopen);
+    tran_abort(transaction);
+    g_ptr_array_free(sealed, true);
+    g_free(snapshots);
+    error_propagate(errp, local_err);
+    return NULL;
+}
