+int qemu_plugin_crucible_checkpoint_original_query_slice_v1(
+    qemu_plugin_id_t id, uint64_t *bounded_ns)
+{
+    QemuCrucibleCheckpointInvocationLoan *loan =
+        &checkpoint_transaction.invocation;
+    int status;
+
+    if (checkpoint_transaction.inventory.active &&
+        checkpoint_transaction.inventory.observer_invoking &&
+        id == checkpoint_transaction.pager.installer.plugin_id) {
+        return qemu_crucible_checkpoint_inventory_current_v1(
+            &checkpoint_transaction.inventory, bounded_ns);
+    }
+    status = checkpoint_invocation_current(loan);
+    if (status) {
+        return status;
+    }
+    if (id != checkpoint_transaction.pager.installer.plugin_id) {
+        return -EPERM;
+    }
+    return qemu_crucible_checkpoint_original_query_slice_v1(loan, bounded_ns);
+}
+
+int qemu_plugin_crucible_checkpoint_original_check_v1(qemu_plugin_id_t id)
+{
+    uint64_t slice;
+
+    return qemu_plugin_crucible_checkpoint_original_query_slice_v1(id, &slice);
+}
+
+/* The callback owns its real admission guard across these native effects.
+ * The containing purpose also retains execution/producer exclusion. Neither
+ * an id nor a copied lock/status flag constructs either physical owner.
+ */
+#ifdef CONFIG_LINUX
+static int checkpoint_placement_invocation(qemu_plugin_id_t id, uint32_t action)
+{
+    QemuCrucibleCheckpointInvocationLoan *loan =
+        &checkpoint_transaction.invocation;
+    int status = checkpoint_invocation_current(loan);
+
+    if (status) {
+        return status;
+    }
+    if (id != checkpoint_transaction.pager.installer.plugin_id ||
+        loan->action != action || !loan->placement) {
+        return -EPERM;
+    }
+    /* Both SDK versions reach this cut. Neither can detach or restore without
+     * the SAME actual physical proof and verified callback/opaque tuple.
+     */
+    status = checkpoint_proof_current(id, &checkpoint_transaction.proof);
+    if (status) {
+        return status;
+    }
+    if (!checkpoint_transaction.proof.placement_tuple_bound) {
+        return -EPERM;
+    }
+    return qemu_crucible_checkpoint_main_loop_current();
+}
+
+#endif
+
+int qemu_plugin_crucible_checkpoint_placement_detach_v1(
+    qemu_plugin_id_t id,
+    struct qemu_plugin_crucible_checkpoint_placement_disposition *out)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCheckpointHeldTransaction *owner = &checkpoint_transaction;
+    struct qemu_plugin_crucible_checkpoint_placement_disposition observed = {
+        .schema_version = QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PLACEMENT_SCHEMA_VERSION,
+        .struct_size = sizeof(observed),
+        .disposition = QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PLACEMENT_HELD,
+    };
+    uint64_t slice;
+    int post;
+    int status = checkpoint_placement_invocation(
+        id, QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PAGER_PREPARE);
+
+    if (status) {
+        return status;
+    }
+    if (!out) {
+        return -EINVAL;
+    }
+    status = checkpoint_live(owner, &slice, false);
+    if (status) {
+        return status;
+    }
+    status = qemu_crucible_checkpoint_placement_detach_expected_v2(
+        owner->invocation.placement, owner->proof.placement_callback,
+        owner->proof.placement_opaque);
+    if (status == -EINPROGRESS) {
+        return status;
+    }
+    if (status && status != -EALREADY) {
+        checkpoint_fail(owner, status, false);
+    } else {
+        status = qemu_crucible_checkpoint_placement_observe_v1(
+            owner->invocation.placement, &observed.accepted_placement_generation,
+            &observed.held_kind);
+        if (status) {
+            checkpoint_fail(owner, status, false);
+        } else {
+            observed.native_transaction_generation =
+                owner->request->coordinates.native_transaction_generation;
+            if (owner->placement_journal_valid &&
+                (owner->placement_journal.native_transaction_generation !=
+                     observed.native_transaction_generation ||
+                 owner->placement_journal.accepted_placement_generation !=
+                     observed.accepted_placement_generation ||
+                 owner->placement_journal.held_kind != observed.held_kind ||
+                 owner->placement_journal.disposition != observed.disposition)) {
+                status = checkpoint_fail(owner, -ESTALE, false);
+            } else {
+                owner->placement_journal = observed;
+                owner->placement_journal_valid = true;
+                owner->mailbox_detached = true;
+            }
+        }
+    }
+    post = checkpoint_live(owner, &slice, true);
+    if (status || post) {
+        return owner->first_status;
+    }
+    *out = owner->placement_journal;
+    return 0;
+#else
+    (void)id;
+    (void)out;
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_checkpoint_placement_detach_v2(
+    qemu_plugin_id_t id, qemu_plugin_crucible_checkpoint_proof_handle_v1 *hold,
+    int (*expected_callback)(void *), void *expected_opaque,
+    struct qemu_plugin_crucible_checkpoint_placement_disposition *out)
+{
+    int status = checkpoint_proof_current(id, hold);
+
+    if (status) {
+        return status;
+    }
+    if (!out || checkpoint_transaction.invocation.action !=
+                    QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PAGER_PREPARE) {
+        return !out ? -EINVAL : -EPERM;
+    }
+    if (hold->placement_tuple_bound &&
+        (hold->placement_callback != expected_callback ||
+         hold->placement_opaque != expected_opaque)) {
+        return checkpoint_fail(&checkpoint_transaction, -ESTALE, false);
+    }
+    hold->placement_callback = expected_callback;
+    hold->placement_opaque = expected_opaque;
+    hold->placement_tuple_bound = true;
+    return qemu_plugin_crucible_checkpoint_placement_detach_v1(id, out);
+}
+
+int qemu_plugin_crucible_checkpoint_placement_restore_v2(
+    qemu_plugin_id_t id, qemu_plugin_crucible_checkpoint_proof_handle_v1 *hold,
+    struct qemu_plugin_crucible_checkpoint_placement_disposition *out)
+{
+    int status = checkpoint_proof_current(id, hold);
+
+    if (status) {
+        return status;
+    }
+    if (!hold->placement_tuple_bound) {
+        return -EPERM;
+    }
+    return qemu_plugin_crucible_checkpoint_placement_restore_v1(id, out);
+}
+
+int qemu_plugin_crucible_checkpoint_placement_restore_v1(
+    qemu_plugin_id_t id,
+    struct qemu_plugin_crucible_checkpoint_placement_disposition *out)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCheckpointHeldTransaction *owner = &checkpoint_transaction;
+    uint64_t slice;
+    uint64_t generation;
+    uint32_t kind;
+    int post;
+    int status = checkpoint_placement_invocation(
+        id, QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PAGER_RELEASE);
+
+    if (status) {
+        return status;
+    }
+    if (!out) {
+        return -EINVAL;
+    }
+    if (owner->restoration_attempted) {
+        return -EALREADY;
+    }
+    if (owner->invocation.readers ||
+        !qatomic_load_acquire(&owner->request->final_disposition_published)) {
+        return -EINPROGRESS;
+    }
+    /* Identity-only RELEASE already proves the same actual held owner. An
+     * expired/cancelled original is recorded without suppressing safe restore;
+     * structural mailbox uncertainty still refuses and keeps its journal. */
+    checkpoint_live(owner, &slice, false);
+    if (!owner->placement_journal_valid) {
+        return checkpoint_fail(owner, -EPERM, false);
+    }
+    status = qemu_crucible_checkpoint_placement_observe_v1(
+        owner->invocation.placement, &generation, &kind);
+    if (!status &&
+        (generation != owner->placement_journal.accepted_placement_generation ||
+         kind != owner->placement_journal.held_kind ||
+         owner->placement_journal.native_transaction_generation !=
+             owner->request->coordinates.native_transaction_generation)) {
+        status = -ESTALE;
+    }
+    if (status) {
+        return checkpoint_fail(owner, status, false);
+    }
+    owner->restoration_attempted = true;
+    status = qemu_crucible_checkpoint_placement_restore_v1(
+        owner->invocation.placement);
+    if (status) {
+        checkpoint_fail(owner, status, true);
+    } else {
+        /* Record physical restore before returning to local journal/open. */
+        owner->mailbox_restored = true;
+        owner->placement_journal.disposition =
+            QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PLACEMENT_RESTORED;
+    }
+    post = checkpoint_live(owner, &slice, true);
+    if (status || post || qatomic_read(&owner->first_status)) {
+        return qatomic_read(&owner->first_status);
+    }
+    *out = owner->placement_journal;
+    return 0;
+#else
+    (void)id;
+    (void)out;
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_crucible_checkpoint_read_begin_v1(
+    QemuCrucibleCheckpointInvocationLoan *loan,
+    QemuCrucibleCheckpointReadLoan **out)
+{
+    int status = checkpoint_invocation_current(loan);
+
+    if (status) {
+        return status;
+    }
+    if (!out) {
+        return -EINVAL;
+    }
+    if (qatomic_cmpxchg(&loan->reader_cut, 0, 1) != 0) {
+        return -EAGAIN;
+    }
+    if (loan->readers == UINT_MAX || checkpoint_read.active) {
+        status = loan->readers == UINT_MAX ? -EOVERFLOW : -EBUSY;
+    } else {
+        status = qemu_crucible_checkpoint_original_check_v1(loan);
+        if (!status) {
+            checkpoint_read.process_id = getpid();
+            qemu_thread_get_self(&checkpoint_read.thread);
+            checkpoint_read.invocation = loan;
+            checkpoint_read.active = true;
+            loan->readers++;
+            *out = &checkpoint_read;
+        }
+    }
+    qatomic_store_release(&loan->reader_cut, 0);
+    return status;
+}
+
+int qemu_crucible_checkpoint_read_end_v1(
+    QemuCrucibleCheckpointReadLoan *loan, int status)
+{
+    QemuCrucibleCheckpointInvocationLoan *invocation;
+    QemuCrucibleCheckpointHeldTransaction *owner;
+    uint64_t slice;
+
+    if (loan != &checkpoint_read ||
+        !qatomic_load_acquire(&checkpoint_transaction.published) ||
+        checkpoint_transaction.process_id != getpid() ||
+        !qemu_thread_is_self(&checkpoint_transaction.thread)) {
+        return -EPERM;
+    }
+    if (!loan->active || loan->process_id != getpid() ||
+        !qemu_thread_is_self(&loan->thread)) {
+        return -EPERM;
+    }
+    invocation = loan->invocation;
+    owner = invocation->transaction;
+    if (status > 0) {
+        return -EINVAL;
+    }
+    if (status < 0) {
+        checkpoint_fail(owner, status, false);
+    }
+    if (qatomic_cmpxchg(&invocation->reader_cut, 0, 1) != 0) {
+        return owner->first_status ? owner->first_status : -EAGAIN;
+    }
+    if (!invocation->readers) {
+        qatomic_store_release(&invocation->reader_cut, 0);
+        return checkpoint_fail(owner, -ESTALE, true);
+    }
+    /* Raw original post is independent of a negative read result. The actual
+     * returning borrow retires only after this observation; the whole original
+     * and its cancellation alias stay retained, including post uncertainty.
+     */
+    checkpoint_live(owner, &slice, true);
+    invocation->readers--;
+    loan->active = false;
+    qatomic_store_release(&invocation->reader_cut, 0);
+    /* Returning this read does not complete the original or close its event. */
+    return owner->first_status;
+}
+
+#ifdef CONFIG_LINUX
+static bool checkpoint_status_matches(
+    const struct qemu_plugin_crucible_checkpoint_pager_invocation *call,
+    const struct qemu_plugin_crucible_checkpoint_pager_status *status)
+{
+    return status->schema_version == call->schema_version &&
+        status->struct_size == sizeof(*status) &&
+        status->action == call->action &&
+        status->native_transaction_generation ==
+            call->native_transaction_generation &&
+        status->process_generation == call->process_generation &&
+        status->arena_generation == call->arena_generation &&
+        status->topology_generation == call->topology_generation &&
+        status->plugin_owner_generation && status->first_status <= 0 &&
+        status->post_status <= 0;
+}
+
+#endif
+
+int qemu_crucible_checkpoint_invoke_v1(
+    QemuCrucibleCheckpointHeldTransaction *owner, uint32_t action,
+    uint32_t disposition,
+    struct qemu_plugin_crucible_checkpoint_pager_status *out)
+{
+#ifdef CONFIG_LINUX
+    struct qemu_plugin_crucible_checkpoint_pager_invocation call;
+    struct qemu_plugin_crucible_checkpoint_pager_status observed = { 0 };
+    QemuCrucibleCheckpointPlacementOwner *placement;
+    QemuCrucibleCheckpointRequestLoan *request;
+    qemu_plugin_crucible_checkpoint_pager_cb_t callback;
+    uint64_t slice;
+    bool cleanup = action == QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PAGER_RELEASE;
+    int status = cleanup ? checkpoint_identity(owner) : checkpoint_current(owner);
+
+    if (status) {
+        return status;
+    }
+    status = qemu_crucible_checkpoint_main_loop_current();
+    if (status || !owner->stopped || !out || owner->locally_disposed) {
+        return status ? status : -EPERM;
+    }
+    if (action < QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PAGER_PREPARE ||
+        action > QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PAGER_RELEASE ||
+        (action != QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PAGER_RELEASE && disposition) ||
+        (action == QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PAGER_RELEASE &&
+         (!disposition ||
+          disposition > QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PAGER_INVALIDATE))) {
+        return -EINVAL;
+    }
+    request = owner->request;
+    if (!request->provider_acquired || !request->provider_owner ||
+        request->provider_ended || !request->request_owner ||
+        !request->containing_purpose ||
+        checkpoint_stop_owner.transaction != owner ||
+        !qatomic_load_acquire(&checkpoint_stop_owner.published)) {
+        return checkpoint_unavailable();
+    }
+    if (action != QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PAGER_PREPARE &&
+        !owner->pager_held) {
+        return -EPERM;
+    }
+    if (owner->candidate_read.active) {
+        return -EINPROGRESS;
+    }
+    if (qatomic_cmpxchg(&owner->invoking, false, true)) {
+        return -EBUSY;
+    }
+    owner->cleanup_invoking = cleanup;
+    if (!cleanup) {
+        status = checkpoint_provider_check_main(request);
+        if (status) {
+            checkpoint_fail(owner, status, false);
+            goto done;
+        }
+    }
+    status = checkpoint_live(owner, &slice, false);
+    if (status && !cleanup) {
+        goto done;
+    }
+    if (action == QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PAGER_RELEASE &&
+        (!qatomic_load_acquire(&request->final_disposition_published) ||
+         owner->invocation.readers || owner->release_started)) {
+        status = owner->release_started ? -EALREADY : -EINPROGRESS;
+        goto done;
+    }
+    status = qemu_crucible_checkpoint_placement_bind_v1(
+        owner, owner->stopped_generation, owner->cancellation_fd, &placement);
+    if (status) {
+        goto done;
+    }
+    if (action == QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PAGER_RELEASE) {
+        /* The callback must restore INSIDE its same admission guard before
+         * journal/open. Main-loop/BQL/non-yield and the genuine containing
+         * execution/producer lease span that restore and the callback return.
+         * The independent producer lease's real publisher remains unavailable.
+         */
+        owner->release_started = true;
+    }
+    call = request->coordinates;
+    call.schema_version = QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PAGER_SCHEMA_VERSION;
+    call.struct_size = sizeof(call);
+    call.action = action;
+    call.disposition = disposition;
+    call.cancellation_fd = owner->cancellation_fd;
+    call.cancellation_device = request->cancellation_device;
+    call.cancellation_inode = request->cancellation_inode;
+    call.cancellation_event_id = request->cancellation_event_id;
+    call.reserved = 0;
+    callback = action == QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PAGER_PREPARE ?
+        owner->pager.prepare :
+        action == QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PAGER_CHECK ?
+        owner->pager.check : owner->pager.release;
+    owner->invocation.process_id = owner->process_id;
+    owner->invocation.thread = owner->thread;
+    owner->invocation.transaction = owner;
+    owner->invocation.action = action;
+    owner->invocation.placement = placement;
+    owner->invocation.active = true;
+    if (action == QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PAGER_PREPARE) {
+        owner->prepare_called = true;
+        owner->pager_held = true; /* Attempt custody survives a negative callback. */
+    }
+    status = callback(owner->pager.installer.plugin_id, &call, &observed,
+                      owner->pager.userdata);
+    if (cleanup) {
+        /* The callback's local proof return does not establish this event. */
+        owner->release_callback_returned = true;
+    }
+    if (!status && observed.state !=
+                       QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PAGER_PENDING) {
+        if (!qatomic_load_acquire(&owner->proof.retained) ||
+            !owner->proof.placement_tuple_bound) {
+            status = -EPROTO;
+        } else {
+            status = qemu_crucible_checkpoint_native_fence_check_v1(
+                owner, owner->proof.fence);
+        }
+    }
+    owner->invocation.active = false;
+    if (!status && !cleanup) {
+        status = checkpoint_provider_check_main(request);
+    }
+    if (status) {
+        checkpoint_fail(owner, status < 0 ? status : -EPROTO, false);
+        /* A negative callback leaves its output without authority. The raw
+         * post and actual native return journal remain available independently. */
+        goto callback_post;
+    }
+    if (owner->invocation.readers || owner->proof.borrowers) {
+        status = checkpoint_fail(owner, -EPROTO, false);
+        goto callback_post;
+    }
+    if (qemu_crucible_checkpoint_main_loop_current() ||
+        !qemu_crucible_checkpoint_pager_binding_current(&owner->pager) ||
+        !checkpoint_status_matches(&call, &observed)) {
+        status = checkpoint_fail(owner, -EPROTO, true);
+        goto callback_post;
+    }
+    if (observed.state == QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PAGER_DISPOSED) {
+        if (action != QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PAGER_RELEASE ||
+            !owner->mailbox_restored ||
+            (owner->proof.retained && !owner->proof.returned)) {
+            status = checkpoint_fail(owner, -EPROTO, true);
+            goto callback_post;
+        }
+        /* Physical local disposition and retained native cleanup differ. */
+        owner->locally_disposed = true;
+    } else if (observed.state != QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PAGER_PENDING &&
+               observed.state != QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PAGER_SETTLED_HELD &&
+               observed.state != QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PAGER_TERMINAL_RETAINED) {
+        status = checkpoint_fail(owner, -EPROTO, true);
+        goto callback_post;
+    }
+    if (action == QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PAGER_PREPARE) {
+        if (observed.state == QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PAGER_SETTLED_HELD &&
+            !owner->mailbox_detached) {
+            status = checkpoint_fail(owner, -EPROTO, true);
+            goto callback_post;
+        }
+        owner->pager_held = true;
+    }
+    if (observed.first_status || observed.post_status) {
+        if (observed.first_status) {
+            checkpoint_fail(owner, observed.first_status, false);
+        }
+        if (observed.post_status) {
+            checkpoint_fail(owner, observed.post_status, true);
+        }
+        status = owner->first_status;
+        goto callback_post;
+    }
+callback_post:
+    /* This raw post also runs after callback/status failure. Saved first and
+     * independent post never depend on a callback returning success.
+     */
+    {
+        int post = checkpoint_live(owner, &slice, true);
+
+        if (!status) {
+            status = post;
+        }
+    }
+    if (action == QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PAGER_RELEASE &&
+        owner->mailbox_restored && owner->proof.returned &&
+        !owner->invocation.active && !owner->invocation.readers &&
+        !owner->proof.borrowers &&
+        !qemu_crucible_checkpoint_main_loop_current() &&
+        qemu_crucible_checkpoint_pager_binding_current(&owner->pager)) {
+        /* This is safe same-owned cleanup permission, not original acceptance
+         * or producer reopening. Saved first/post survive independently.
+         * The native physical fence remains pinned through actual local return.
+         */
+        /* Callback Status is not the owner journal. In particular a negative
+         * callback may leave its output untouched after authentic local return.
+         * Actual restore, return, callback return and raw post establish this
+         * cleanup stage independently of Status.DISPOSED or runtime gate release.
+         */
+        owner->locally_disposed = true;
+        qatomic_store_release(&owner->proof.local_disposition_allowed, true);
+    }
+    if (!status) {
+        status = qatomic_read(&owner->first_status);
+        if (!status) {
+            status = qatomic_read(&owner->post_status);
+        }
+    }
+    if (!status) {
+        *out = observed;
+    }
+done:
+    owner->cleanup_invoking = false;
+    qatomic_store_release(&owner->invoking, false);
+    return status;
+#else
+    int status = checkpoint_current(owner);
+
+    (void)action;
+    (void)disposition;
+    (void)out;
+    return status ? status : checkpoint_fail(owner, -ENOTSUP, false);
+#endif
+}
