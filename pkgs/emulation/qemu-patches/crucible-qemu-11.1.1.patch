+static bool fdmon_epoll_child_fd_retained(
+    int fd, const int *retained_fds, size_t retained_count)
+{
+    size_t lower = 0;
+    size_t upper = retained_count;
+
+    while (lower < upper) {
+        size_t middle = lower + (upper - lower) / 2;
+
+        if (retained_fds[middle] < fd) {
+            lower = middle + 1;
+        } else {
+            upper = middle;
+        }
+    }
+    return lower < retained_count && retained_fds[lower] == fd;
+}
+
+int fdmon_epoll_reconstruct_child(
+    AioContext *ctx, const int *retained_fds, size_t retained_count)
+{
+    AioHandler *node;
+    bool active = ctx->fdmon_ops == &fdmon_epoll_ops;
+    char descriptor_path[64];
+    char descriptor_kind[32];
+    ssize_t kind_length;
+    int private_fd;
+
+    if ((active && !ctx->epollfd_tag) ||
+        (!active && ctx->epollfd_tag)) {
+        return -EPROTO;
+    }
+    QLIST_FOREACH_RCU(node, &ctx->aio_handlers, node) {
+        if (QLIST_IS_INSERTED(node, node_deleted) || !node->pfd.events) {
+            continue;
+        }
+        /* These nodes remain eligible for later polling and upgrades. Only
+         * their original owners may dispose them; omission is not disposal. */
+        if (!fdmon_epoll_child_fd_retained(node->pfd.fd, retained_fds,
+                                         retained_count)) {
+            return -EPERM;
+        }
+        if (fcntl(node->pfd.fd, F_GETFD) < 0) {
+            return -errno;
+        }
+    }
+    if (ctx->epollfd < 0) {
+        return active ? -EPROTO : 0;
+    }
+    /* The verified descriptor table retains this FD. Refuse a closed one
+     * before allocation can reuse its number and conceal missing custody. */
+    if (fcntl(ctx->epollfd, F_GETFD) < 0) {
+        return -errno;
+    }
+    if (!fdmon_epoll_child_fd_retained(ctx->epollfd, retained_fds,
+                                     retained_count)) {
+        return -EPERM;
+    }
+    snprintf(descriptor_path, sizeof(descriptor_path),
+             "/proc/self/fd/%d", ctx->epollfd);
+    kind_length = readlink(descriptor_path, descriptor_kind,
+                           sizeof(descriptor_kind) - 1);
+    if (kind_length < 0) {
+        return -errno;
+    }
+    descriptor_kind[kind_length] = '\0';
+    if (strcmp(descriptor_kind, "anon_inode:[eventpoll]") != 0) {
+        return -ESTALE;
+    }
+    private_fd = epoll_create1(EPOLL_CLOEXEC);
+    if (private_fd < 0) {
+        return -errno;
+    }
+
+    if (active) {
+        QLIST_FOREACH_RCU(node, &ctx->aio_handlers, node) {
+            struct epoll_event event;
+
+            if (QLIST_IS_INSERTED(node, node_deleted) || !node->pfd.events) {
+                continue;
+            }
+            event = (struct epoll_event) {
+                .data.ptr = node,
+                .events = epoll_events_from_pfd(node->pfd.events),
+            };
+            if (epoll_ctl(private_fd, EPOLL_CTL_ADD, node->pfd.fd, &event)) {
+                int result = -errno;
+
+                close(private_fd);
+                return result;
+            }
+        }
+    }
+
+    /* The inherited epoll object belongs to both processes. Never update or
+     * disable it: close only this child's reference and replace its local tag.
+     * A poll context also needs a private standby FD for its future upgrade. */
+    if (ctx->epollfd_tag) {
+        g_source_remove_unix_fd(&ctx->source, ctx->epollfd_tag);
+    }
+    close(ctx->epollfd);
+    ctx->epollfd = private_fd;
+    ctx->epollfd_tag = active ?
+        g_source_add_unix_fd(&ctx->source, private_fd, G_IO_IN) : NULL;
+    return 0;
+}
