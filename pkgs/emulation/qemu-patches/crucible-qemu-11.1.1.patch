+static bool GRAPH_RDLOCK raw_crucible_hot_fork_file(
+    BlockDriverState *bs, BdrvCrucibleHotForkFileAction action,
+    BdrvCrucibleHotForkFileState *state, Error **errp)
+{
+    BDRVRawState *s = bs->opaque;
+    struct stat metadata;
+    int flags = -1;
+    int stat_result = -1;
+    int stat_errno = EBADF;
+
+    GLOBAL_STATE_CODE();
+    if (s->fd >= 0) {
+        stat_result = fstat(s->fd, &metadata);
+        stat_errno = stat_result < 0 ? errno : 0;
+    }
+    if (s->fd < 0 || s->reopen_state || s->perm_change_fd ||
+        stat_result < 0 || !S_ISREG(metadata.st_mode) ||
+        (flags = fcntl(s->fd, F_GETFL)) < 0) {
+        /*
+         * A fork child reads this on its diagnostics stream, so it names
+         * which of the settled-descriptor conditions the node failed.
+         */
+        error_setg(errp,
+                   "Crucible source node %s requires a settled regular-file "
+                   "descriptor (fd %d, reopen %d, perm-change %d, fstat %s, "
+                   "regular %d, flags %d)",
+                   bdrv_get_node_name(bs), s->fd, s->reopen_state != NULL,
+                   s->perm_change_fd,
+                   stat_result < 0 ? strerror(stat_errno) : "ok",
+                   stat_result == 0 && S_ISREG(metadata.st_mode), flags);
+        return false;
+    }
+    switch (action) {
+    case BDRV_CRUCIBLE_HOT_FORK_FILE_PIN:
+        if (s->crucible_source_pins == UINT_MAX) {
+            error_setg(errp, "Crucible file source pin count is exhausted");
+            return false;
+        }
+        if (!s->crucible_source_pins) {
+            s->crucible_source_owner = getpid();
+        }
+        s->crucible_source_pins++;
+        break;
+    case BDRV_CRUCIBLE_HOT_FORK_FILE_UNPIN:
+        if (!s->crucible_source_pins) {
+            error_setg(errp, "Crucible file source has no retained pin");
+            return false;
+        }
+        s->crucible_source_pins--;
+        break;
+    case BDRV_CRUCIBLE_HOT_FORK_FILE_QUERY:
+        break;
+    default:
+        error_setg(errp, "Invalid Crucible file source action");
+        return false;
+    }
+    *state = (BdrvCrucibleHotForkFileState) {
+        .device = metadata.st_dev,
+        .inode = metadata.st_ino,
+        .descriptor = s->fd,
+        .flags = flags,
+        .read_only = (flags & O_ACCMODE) == O_RDONLY,
+    };
+    return true;
+}
+
+static bool GRAPH_RDLOCK raw_crucible_hot_fork_file_child(
+    BlockDriverState *bs, pid_t parent, int descriptor, Error **errp)
+{
+#ifdef __linux__
+    BDRVRawState *s = bs->opaque;
+    BdrvCrucibleHotForkFileState original;
+    struct stat metadata, opened;
+    char path[64];
+    int flags, retained;
+
+    GLOBAL_STATE_CODE();
+    if (parent <= 1 || parent != getppid() || parent == getpid() ||
+        s->crucible_source_owner != parent || !s->crucible_source_pins ||
+        s->use_linux_aio || s->use_linux_io_uring ||
+        !raw_crucible_hot_fork_file(bs, BDRV_CRUCIBLE_HOT_FORK_FILE_QUERY,
+                                    &original, errp)) {
+        if (!errp || !*errp) {
+            error_setg(errp, "Crucible file adoption requires its immediate child");
+        }
+        return false;
+    }
+    flags = descriptor < 0 ? -1 : fcntl(descriptor, F_GETFL);
+    if (!original.read_only || descriptor == s->fd || flags < 0 ||
+        fstat(descriptor, &metadata) < 0 || !S_ISREG(metadata.st_mode) ||
+        flags != original.flags) {
+        error_setg(errp, "Crucible child file must preserve frozen access flags");
+        return false;
+    }
+    /* dup() would retain locks through the parent's staged open description. */
+    g_snprintf(path, sizeof(path), "/proc/self/fd/%d", descriptor);
+    retained = qemu_open(path, flags, errp);
+    if (retained < 0) {
+        return false;
+    }
+    if (fstat(retained, &opened) < 0 || opened.st_dev != metadata.st_dev ||
+        opened.st_ino != metadata.st_ino) {
+        qemu_close(retained);
+        error_setg(errp, "Crucible child file changed during independent reopen");
+        return false;
+    }
+    /* Locks belong to open file descriptions, not inherited cached bitmasks. */
+    if (s->use_lock &&
+        (raw_apply_lock_bytes(NULL, retained, s->perm, ~s->shared_perm,
+                              false, errp) < 0 ||
+         raw_check_lock_bytes(retained, s->perm, s->shared_perm, errp) < 0)) {
+        qemu_close(retained);
+        return false;
+    }
+    qemu_close(s->fd);
+    s->fd = retained;
+    s->locked_perm = s->use_lock ? s->perm : 0;
+    s->locked_shared_perm = s->use_lock ? BLK_PERM_ALL & ~s->shared_perm : 0;
+    s->crucible_source_owner = getpid();
+    s->crucible_child_descriptor = true;
+    return true;
+#else
+    error_setg(errp, "Crucible child file adoption requires Linux");
+    return false;
+#endif
+}
