+        qemu_crucible_fault_vmstate_put_u64(bytes, row->model_phase_mask);
+        qemu_crucible_fault_vmstate_put_u8(bytes, row->vmstate);
+        qemu_crucible_fault_vmstate_put_u8(bytes, row->monotonicity);
+        qemu_crucible_fault_vmstate_put_u64(bytes, (uint64_t)row->epoch_ns);
+        live_manifest_string(bytes, row->id);
+        live_manifest_string(bytes, row->implementation);
+        live_manifest_identity("clock", "id", row->id, id);
+        qemu_crucible_fault_vmstate_put_bytes(bytes, id, sizeof(id));
+        assert(qemu_plugin_crucible_fault_clock_bind(i, id) == 0);
+    }
+    live_manifest_record("ordinary-clock-manifest.bin", bytes, digest);
+    assert(qemu_plugin_crucible_fault_clock_bindings_seal(digest) == 0);
+    g_free(rows);
+}
+
+static void live_hardware_manifest_bind(void)
+{
+    struct qemu_plugin_crucible_fault_hardware_error_capability *rows;
+    g_autoptr(GByteArray) bytes = g_byte_array_new();
