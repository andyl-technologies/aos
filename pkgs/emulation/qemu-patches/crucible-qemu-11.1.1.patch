+    g_assert_cmpuint(timer_expire_time_ns(restored.fit_timer), ==, 2);
+
+    /* A representable exact source projects by the existing ceiling policy. */
+    restored.timer_vmstate_loaded = false;
+    bytes->data[8] = 1;
+    stq_be_p(bytes->data + 59, 1001);
+    g_assert_cmpint(load_timer_state(&restored, bytes, 2), ==, 0);
+    ppc_timer_state_apply(&restored);
+    g_assert_cmpuint(timer_expire_time_ns(restored.fit_timer), ==, 2);
+
+    restored.timer_vmstate_loaded = false;
+    timer_mod_ns(restored.fit_timer, 23);
+    stq_be_p(bytes->data + 27, UINT64_C(1) << 56);
+    g_assert_cmpint(load_timer_state(&restored, bytes, 2), <, 0);
+    g_assert_cmpuint(timer_expire_time_ns(restored.fit_timer), ==, 23);
+
+    /* Ordinary-mode metadata cannot carry a fractional deadline. */
+    restored.timer_vmstate_loaded = false;
+    bytes->data[8] = 0;
+    stq_be_p(bytes->data + 27, 0);
+    g_assert_cmpint(load_timer_state(&restored, bytes, 2), <, 0);
+    g_assert_cmpuint(timer_expire_time_ns(restored.fit_timer), ==, 23);
+
+    /* The retained PIT target is exact-mode state, even while disarmed. */
+    stq_be_p(bytes->data + 59, 2000);
+    stq_be_p(bytes->data + 91, 1);
+    g_assert_cmpint(load_timer_state(&restored, bytes, 2), <, 0);
+    g_assert_cmpuint(timer_expire_time_ns(restored.fit_timer), ==, 23);
+
+    g_byte_array_unref(bytes);
+    timer_free(source.fit_timer);
+    timer_free(restored.fit_timer);
+}
