+QemuCrucibleNativeGroupUse qemu_plugin_crucible_native_vcpu_init_use_begin_v1(
+    QemuCrucibleNativeRegistration *const *slot,
+    QemuCrucibleNativeGroupContextDescriptorObserver observe, void *context,
+    size_t member, CPUState *cpu, QemuCrucibleNativeGroupDescriptorView *actual)
+{
+    QemuCrucibleNativeGroupUse use =
+        qemu_plugin_crucible_native_group_use_begin_context_v1(
+            slot, observe, context, member, actual);
+#if defined(CONFIG_LINUX) && !defined(CONFIG_USER_ONLY)
+    QemuCrucibleCpuSourceAllocationOwner *owner = NULL;
+    QemuCrucibleCpuAllocationReceipt *receipt = NULL;
+    uint64_t generation = 0;
+    bool pinned = false;
+
+    if (!use.record) {
+        use.invocation_status = -ENOENT;
+        return use;
+    }
+    use.invocation_status = -EPERM;
+    if (cpu && object_dynamic_cast(OBJECT(cpu), TYPE_CPU)) {
+        qemu_rec_mutex_lock(&plugin.lock);
+        if (vcpu_init_cpu_current_locked(cpu)) {
+            object_ref(OBJECT(cpu));
+            pinned = true;
+        }
+        qemu_rec_mutex_unlock(&plugin.lock);
+    }
+    if (pinned) {
+        use.invocation_status =
+            qemu_crucible_startup_source_cpu_instance_identity_v1(
+                OBJECT(cpu), &owner, &receipt, &generation);
+        if (!use.invocation_status) {
+            use.invocation = native_vcpu_init_enter(use.record, cpu, owner,
+                receipt, generation, &use.invocation_status);
+        }
+        if (!use.invocation.frame) {
+            object_unref(OBJECT(cpu));
+        }
+    }
+    /* The real pinned group survives every refused factual observation.
+     * Installation's first/post/return journals keep their original meaning. */
+    qemu_mutex_lock(&use.record->owner->mutex);
+    if (use.invocation_status && !use.record->group->first_invocation_status) {
+        use.record->group->first_invocation_status = use.invocation_status;
+    }
+    qemu_mutex_unlock(&use.record->owner->mutex);
+#else
+    use.invocation_status = -ENOTSUP;
+#endif
+    return use;
+}
+
+int qemu_plugin_crucible_native_group_use_post_v1(
+    const QemuCrucibleNativeGroupUse *use,
+    QemuCrucibleNativeRegistration *const *slot,
+    QemuCrucibleNativeGroupDescriptorObserver observe, size_t member,
+    const QemuCrucibleNativeGroupDescriptorView *expected)
+{
+    QemuCrucibleNativeGroupDescriptorView actual = { 0 };
+    QemuCrucibleNativeRegistration *record;
+    QemuCrucibleNativeInvocationRegistry *registry;
+    QemuCrucibleNativeRegistrationGroup *group;
+    pid_t process = getpid();
+    int status = 0;
+
+    if (!use || !slot || !observe || !expected) {
+        return -EINVAL;
+    }
+    /* The actual caller still holds the reference acquired by begin. Reject
+     * inherited registration state before either potentially inherited lock. */
+    record = use->record;
+    if (record && !registry_process_current(record->owner, process)) {
+        return -EPERM;
+    }
+    qemu_rec_mutex_lock(&plugin.lock);
+    if (!observe(member, &actual) || qatomic_load_acquire(slot) != record ||
+        actual.coordinate != expected->coordinate ||
+        actual.function != expected->function ||
+        actual.userdata != expected->userdata ||
+        actual.userdata_coordinate != expected->userdata_coordinate ||
+        actual.kind != expected->kind) {
+        status = -ESTALE;
+    }
+    if (!record) {
+        /* A legacy unselected callback has no retained association. Selected
+         * material may never reinterpret a missing owner as that ordinary case. */
+        if (!status && qatomic_load_acquire(&qemu_crucible_selected_process_id)) {
+            status = -ENOKEY;
+        }
+    } else {
+        registry = record->owner;
+        group = record->group;
+        qemu_mutex_lock(&registry->mutex);
+        if (!status && (!registry_current_locked(registry, process) ||
+            !group_identity_locked(registry, group) || group->terminal ||
+            member >= group->member_count || &group->members[member] != record ||
+            !group->module_retained || !record->descriptor_retained ||
+            !record->references || record->coordinate != expected->coordinate ||
+            record->function != expected->function ||
+            record->userdata != expected->userdata ||
+            record->userdata_coordinate != expected->userdata_coordinate ||
+            record->kind != expected->kind)) {
+            status = -ESTALE;
+        }
+        qemu_mutex_unlock(&registry->mutex);
+    }
+    qemu_rec_mutex_unlock(&plugin.lock);
+    return status;
+}
+
+void qemu_plugin_crucible_native_group_use_end_v1(QemuCrucibleNativeGroupUse use)
+{
+    qemu_plugin_crucible_native_exit_v1(use.invocation);
+    qemu_plugin_crucible_native_exit_v1(use.mask);
+    if (use.record && registry_process_current(use.record->owner, getpid())) {
+        qemu_mutex_lock(&use.record->owner->mutex);
+        assert(use.record->references);
+        use.record->references--;
+        qemu_mutex_unlock(&use.record->owner->mutex);
+    }
+}
