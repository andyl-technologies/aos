+
+#define STARTUP_EVENT_FD 12
+#define STARTUP_FDINFO_LIMIT 4096
+
+extern struct qemu_plugin_state plugin;
+
+/* Process-private phases; no native ordinal is a public protocol value. */
+enum StartupSourcePhase {
+    STARTUP_SOURCE_EMPTY,
+    STARTUP_SOURCE_INSTALLING,
+    STARTUP_SOURCE_ACQUIRED,
+    STARTUP_SOURCE_FAILED,
+    STARTUP_SOURCE_REGISTERED,
+    STARTUP_SOURCE_RETURNED,
+};
+
+/* Unknown module calls cannot inherit a selected native parent. Preserve
+ * the exact original function, userdata and arguments; exit before interpreting
+ * its signed result. These cuts never create callback ownership or time. */
+#define SOURCE_CALLBACK_MASKED_INVOKE(result, coordinate, function, userdata, ...) \
+    do { \
+        __auto_type source_callback_function = (function); \
+        QemuCrucibleNativeInvocationTicket source_callback_ticket = \
+            qemu_plugin_crucible_native_mask_v1( \
+                (coordinate), (void *)source_callback_function, (userdata)); \
+        (result) = source_callback_function(__VA_ARGS__); \
+        qemu_plugin_crucible_native_exit_v1(source_callback_ticket); \
+    } while (0)
+
+static bool pending_constructor_closed(void);
+static bool pending_constructor_no_birth(void);
+static int pending_constructor_receive_current(QemuCrucibleSourceAdvanceReceiver *receiver);
+
+static QemuCrucibleStartupSourceControl startup_source = {
+    .event_fd = -1,
+    .metadata_fd = -1,
+    .purpose_plan_fd = -1,
+    .socket_ingress.observation.descriptor = -1,
+    .ram_control_actor.observation.descriptor = -1,
+    .qmp_allocations.observation.descriptor = -1,
+    .checkpoint_storage.observation.descriptor = -1,
+    .control_callback.observation.descriptor = -1,
+    .wake_keeper.observation.descriptor = -1,
+    .standing.observation.descriptor = -1,
+    .standing.cancellation_fd = -1,
+    .parent_park_receive.basis_fd = -1,
+    .parent_park_receive.cancellation_fd = -1,
+    .parent_park_receive.metadata_fd = -1,
+    .parent_park_receive.observation.descriptor = -1,
+    .standing.construction_storage.observation.descriptor = -1,
+#ifdef CONFIG_LINUX
+    .cpu_allocations.lock = PTHREAD_MUTEX_INITIALIZER,
+#endif
+};
+
+static int startup_failure(int status);
+static int standing_operation_current(struct QemuCrucibleFingerprintOperation *operation);
+static bool standing_operation_identity(struct QemuCrucibleFingerprintOperation *operation);
+static bool standing_construction_operation_identity(void);
+static bool standing_operation_return_identity(struct QemuCrucibleFingerprintOperation *operation);
+#ifdef CONFIG_LINUX
+static bool fingerprint_materials_held(void);
+static int action_original_frozen_slice(QemuCrucibleActionOriginal *action,
+                                        uint64_t now, uint64_t *slice);
+static bool fingerprint_work_held(QemuCrucibleFingerprintWorker *worker);
+static bool fingerprint_output_workspace_overlap(const void *output, size_t bytes);
+static bool callback_child_output_overlap(const void *output, size_t bytes,
+                                          const void *field, size_t field_bytes);
+static int required_workers_plan(QemuCrucibleStartupRuntimePurpose *runtime);
+static QemuCrucibleFingerprintMaterial *fingerprint_current_capture(void);
+static void cpu_allocation_reap_returned(void);
+static uint64_t cpu_allocation_metadata_bytes(void);
+#if defined(CONFIG_TCG) && defined(CONFIG_PLUGIN)
+static void cpu_tlb_reap_locked(void);
+static uint64_t cpu_tlb_metadata_bytes_locked(void);
+static int cpu_tlb_header_identity(QemuCrucibleCpuTlbSourceOwner *owner);
+#endif
+static int cpu_metadata_account_issue(QemuCrucibleObservationConstructionBinding *binding);
+
+/* Only actual Source thread owners hold these embedded reservation cells.
+ * The inherited Main task occupies one issued slot. Concurrent non-Source
+ * births remain subject to the SAME kernel pids.max; their census is never a
+ * grant. An actual EAGAIN is a typed failed birth, without a cap increase. */
+static int startup_task_reserve(bool *owner_slot)
+{
+    QemuCrucibleSourceTaskLedger *ledger = &startup_source.task_ledger;
+    uint64_t limit = startup_source.process_purpose_record.task_limit;
+    int status = 0;
+
+    if ((owner_slot != &startup_source.fingerprint_worker.native.task_reserved &&
+         owner_slot != &startup_source.ram_control_actor.task_reserved &&
+         owner_slot != &startup_source.run_worker.native.task_reserved &&
+         owner_slot != &startup_source.teardown_worker.native.task_reserved) ||
+        !qatomic_load_acquire(&startup_source.commands.initialized) ||
+        !qatomic_load_acquire(&startup_source.process_purpose_complete) ||
+        getpid() != startup_source.owner_process) {
+        return -ENOKEY;
+    }
+    qemu_mutex_lock(&startup_source.commands.mutex);
+    if (*owner_slot) {
+        status = -EALREADY;
+    } else if (!limit || ledger->live_reserved >= limit - 1 ||
+               ledger->births_reserved == UINT64_MAX) {
+        status = -EAGAIN;
+    } else {
+        ledger->births_reserved++;
+        ledger->live_reserved++;
+        *owner_slot = true;
