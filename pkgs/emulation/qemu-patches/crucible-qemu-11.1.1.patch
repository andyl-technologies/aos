+static void test_dispatch_gate(void)
+{
+    if (!fixture_enter_subprocess()) {
+        return;
+    }
+    fixture_prepare(2);
+    fixture_dispatch_status = -EINPROGRESS;
+
+    crucible_ram_execute_scheduled();
+    crucible_ram_execute_scheduled();
+
+    g_assert_cmpuint(fixture_dispatch_calls, ==, 2);
+    g_assert_cmpuint(fixture_cas_calls, ==, 0);
+    g_assert_cmpuint(fixture_callback_calls, ==, 0);
+    g_assert_cmpuint(ram_scheduled.state, ==, 90);
+    g_assert_true(ram_scheduled.callback == fixture_callback);
+    g_assert_true(ram_scheduled.opaque == &fixture_callback_opaque);
+
+    fixture_dispatch_status = 0;
+    crucible_ram_execute_scheduled();
+
+    g_assert_cmpuint(fixture_dispatch_calls, ==, 3);
+    g_assert_cmpuint(fixture_callback_calls, ==, 1);
+    g_assert_cmpuint(ram_scheduled.state, ==, 88);
+    fixture_assert_event_untouched();
+}
