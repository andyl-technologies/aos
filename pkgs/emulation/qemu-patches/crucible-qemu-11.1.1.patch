+static bool test_replay_mode(void)
+{
+    return test_mode == TEST_REPLAY || test_mode == TEST_REPLAY_STORE ||
+           test_mode == TEST_REPLAY_ATOMIC ||
+           test_mode == TEST_REPLAY_DEVICE ||
+           test_mode == TEST_REPLAY_LOAD ||
