+/*
+ * Adopts the complete prepared file set only in its immediate fork child,
+ * outside block barriers and after native worker retirement. It preserves the
+ * graph and cached bytes, rebinds native file locks, restores original root
+ * access against the private files, and releases the child's source capability.
+ * The caller must terminate the child on any failure after adoption begins;
+ * the parent plan, graph, files, and source capabilities remain unchanged.
+ * Success consumes both the inherited plan and its source set.
+ */
+bool qemu_block_hot_fork_child_files_install(QemuBlockHotForkChildFiles *plan,
+                                            Error **errp);
+
+/*
+ * Resolves the unique originally writable native leaf beneath one retained
+ * root of a frozen source set. Roots with no or several such leaves and nodes
+ * that are not retained roots fail closed without effects.
+ */
+bool qemu_block_hot_fork_source_set_writable_leaf(
+    const QemuBlockHotForkSourceSet *set, BlockDriverState *root,
+    BlockDriverState **leaf, Error **errp);
+
+/*
+ * Lists every descriptor the immediate child must inherit for one prepared
+ * plan: the pinned source descriptors the inherited graph still references and
+ * the prepared replacements. Returns the count, or -1 when the plan is not
+ * this process's unconsumed plan or maximum is too small.
+ */
+ssize_t qemu_block_hot_fork_child_files_descriptors(
+    const QemuBlockHotForkChildFiles *plan, int *descriptors, size_t maximum);
+
+/* Explicit process-local ownership, never a wire representation. */
+typedef struct QemuBlockHotForkSourceRoot {
+    BlockBackend *backend; /* NULL only for a named, parentless native root. */
+    BlockDriverState *root;
+} QemuBlockHotForkSourceRoot;
+
+/*
+ * Retains an explicitly supplied, complete native source closure under BQL.
+ * The caller has stopped guest execution and owns all supplied lifecycles.
+ * Every allocated block node, backend, and graph consumer must belong to the
+ * supplied roots. Already read-only roots retain that access on restoration.
+ * Unknown drivers, missing roots, and duplicate owners fail without effects.
+ * This does not validate external snapshot content or install child graphs.
+ */
+QemuBlockHotForkSourceSet *qemu_block_hot_fork_source_set_new(
+    const QemuBlockHotForkSourceRoot *roots, size_t count, Error **errp);
+
+/*
+ * Revalidates closure before any transition and retains partial failure for
+ * explicit recovery. Freeze precedes block/AIO barriers. Original root counts
+ * are provenance, not replacements for the live backend permission inventory.
+ */
+bool qemu_block_hot_fork_source_set_freeze(QemuBlockHotForkSourceSet *set,
+                                         Error **errp);
+bool qemu_block_hot_fork_source_set_query(
+    const QemuBlockHotForkSourceSet *set,
+    QemuBlockHotForkSourceSetInventory *inventory, Error **errp);
+
+/* Authenticates one retained backend and returns its original permissions. */
+bool qemu_block_hot_fork_source_set_backend_permissions(
+    const QemuBlockHotForkSourceSet *set, BlockBackend *backend,
+    uint64_t *permissions, Error **errp);
+
+/*
+ * Binds immutable snapshot roots using a complete frozen source-set capability.
+ * Original permissions select the roots; current permissions must stay read-only.
+ * The retained barrier report carries source provenance separately from live
+ * writable-backend counts. It does not authorize child-private graph handoff.
+ */
+bool qemu_block_backend_hot_fork_snapshot_bind_frozen(
+    const QemuBlockHotForkSourceSet *sources,
+    const QemuBlockBackendHotForkSnapshotBinding *bindings, size_t count,
+    QemuBlockBackendHotForkBarrierInventory *inventory, Error **errp);
+
+/*
+ * Restores all owned sources after barriers are released, even when an extra
+ * unowned node has invalidated closure. A changed owned graph fails closed.
+ * Both operations reject inherited parent tokens in a forked child. Release
+ * requires every source to have returned to its original access state.
+ */
+bool qemu_block_hot_fork_source_set_restore(QemuBlockHotForkSourceSet *set,
+                                          Error **errp);
+bool qemu_block_hot_fork_source_set_free(QemuBlockHotForkSourceSet *set,
+                                       Error **errp);
+
+/*
+ * Adopts, restores, and releases an inherited external-only child source set.
+ */
+bool qemu_block_hot_fork_source_set_release_external_child(
+    QemuBlockHotForkSourceSet *set, Error **errp);
