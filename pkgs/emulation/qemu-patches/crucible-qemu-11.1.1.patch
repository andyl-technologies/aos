+bool qemu_plugin_crucible_native_idle_resume_descriptor_observe_v1(
+    size_t member, QemuCrucibleNativeGroupDescriptorView *out)
+{
+    if (!out) {
+        return false;
+    }
+
+    switch (member) {
+    case 0:
+        *out = (QemuCrucibleNativeGroupDescriptorView) {
+            .coordinate = &qemu_plugin_vcpu_idle_resume_idle_cb,
+            .function = qemu_plugin_vcpu_idle_resume_idle_cb,
+            .userdata = qemu_plugin_vcpu_idle_resume_userdata,
+            .userdata_coordinate = &qemu_plugin_vcpu_idle_resume_userdata,
+            .kind = QEMU_CRUCIBLE_NATIVE_REGISTERED,
+        };
+        return true;
+    case 1:
+        *out = (QemuCrucibleNativeGroupDescriptorView) {
+            .coordinate = &qemu_plugin_vcpu_idle_resume_resume_cb,
+            .function = qemu_plugin_vcpu_idle_resume_resume_cb,
+            .userdata = qemu_plugin_vcpu_idle_resume_userdata,
+            .userdata_coordinate = &qemu_plugin_vcpu_idle_resume_userdata,
+            .kind = QEMU_CRUCIBLE_NATIVE_REGISTERED,
+        };
+        return true;
+    default:
+        return false;
+    }
+}
