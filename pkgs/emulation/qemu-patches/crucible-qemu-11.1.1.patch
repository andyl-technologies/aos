+CrucibleFingerprintProjectionManifest *
+qmp_query_crucible_fingerprint_projection_manifest(Error **errp)
+{
+    static const char hex[] = "0123456789abcdef";
+    const uint32_t domains = QEMU_CRUCIBLE_LIFECYCLE_STATE_VOLATILE |
+                             QEMU_CRUCIBLE_LIFECYCLE_STATE_DEVICE |
+                             QEMU_CRUCIBLE_LIFECYCLE_STATE_CONTROL;
+    CrucibleFingerprintProjectionManifest *manifest;
+    uint8_t digest[32];
+    uint64_t sections;
+    char digest_hex[65];
+    int result;
+
+    result = qemu_fingerprint_projection_schema_sha256(domains, digest,
+                                                       &sections);
+    if (result != 0) {
+        error_setg_errno(errp, result > 0 ? result : -result,
+                         "Crucible fingerprint projection manifest is incomplete");
+        return NULL;
+    }
+    for (size_t i = 0; i < sizeof(digest); i++) {
+        digest_hex[i * 2] = hex[digest[i] >> 4];
+        digest_hex[i * 2 + 1] = hex[digest[i] & 0xf];
+    }
+    digest_hex[64] = '\0';
+
+    manifest = g_new0(CrucibleFingerprintProjectionManifest, 1);
+    manifest->schema_version = 4;
+    manifest->sections = sections;
+    manifest->digest = g_strdup(digest_hex);
+    CrucibleFingerprintProjectionManifestRowList **tail = &manifest->rows;
+    result = qemu_fingerprint_projection_manifest_foreach(
+        domains, append_fingerprint_projection_manifest_row, &tail);
+    if (result != 0) {
+        qapi_free_CrucibleFingerprintProjectionManifest(manifest);
+        error_setg_errno(errp, result > 0 ? result : -result,
+                         "Crucible fingerprint projection rows are incomplete");
+        return NULL;
+    }
+    return manifest;
+}
