+static int i2c_address_compare(const void *left, const void *right)
+{
+    const uint8_t *left_address = left;
+    const uint8_t *right_address = right;
+
+    return (*left_address > *right_address) -
+           (*left_address < *right_address);
+}
+
+static bool i2c_bus_fingerprint_projection(QEMUFile *f, const void *opaque,
+                                           Error **errp)
+{
+    const I2CBus *bus = opaque;
+    uint8_t addresses[UINT8_MAX + 1];
+    const I2CNode *node;
+    size_t count = 0;
+
+    if (bus->bh || !QSIMPLEQ_EMPTY(&bus->pending_masters)) {
+        error_setg(errp, "I2C bus is not quiescent for projection");
+        return false;
+    }
+    QLIST_FOREACH(node, &bus->current_devs, next) {
+        if (count == ARRAY_SIZE(addresses)) {
+            error_setg(errp, "I2C projection has too many active devices");
+            return false;
+        }
+        addresses[count++] = node->elt->address;
+    }
+    qsort(addresses, count, sizeof(addresses[0]), i2c_address_compare);
+
+    qemu_put_byte(f, bus->broadcast);
+    qemu_put_be16(f, count);
+    qemu_put_buffer(f, addresses, count);
+    return true;
+}
+
+static const CrucibleFingerprintProjection i2c_bus_fingerprint = {
+    .schema = "crucible.qemu.i2c-bus.v1",
+    .version = 1,
+    .save = i2c_bus_fingerprint_projection,
+};
