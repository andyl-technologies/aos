+
+static int dirty_retirement_step(void)
+{
+    DirtyMemoryRetirement *state = &ram_list.dirty_retirement;
+    QemuCrucibleRamReturnJournal *journal = &state->returned;
+    DirtyMemoryBlocks *blocks;
+    uint64_t report_bytes;
+    int status;
+
+    if (journal->phase == RAM_RETURN_FREE_RETURNED) {
+        if (state->cursor_active && journal->address == state->stop_address &&
+            journal->serial == state->stop_serial) {
+            state->stop_reached = true;
+        }
+        status = qemu_crucible_ram_return_settle(journal);
+        if (status) {
+            return dirty_retirement_status(status);
+        }
+    }
+    if (state->cursor_active && state->stop_reached) {
+        return 0;
+    }
+    if (journal->phase == RAM_RETURN_FREE_STARTED) {
+        return dirty_retirement_status(-EINPROGRESS);
+    }
+    qemu_mutex_lock_ramlist();
+    blocks = state->ready_head;
+    qemu_mutex_unlock_ramlist();
+    if (!blocks) {
+        return 0;
+    }
+    status = qemu_crucible_ram_return_prepare(&blocks->metadata_owner, journal);
+    if (status) {
+        return dirty_retirement_status(status);
+    }
+    if (journal->phase != RAM_RETURN_CLAIMED) {
+        return dirty_retirement_status(-EINPROGRESS);
+    }
+    qemu_mutex_lock_ramlist();
+    if (state->ready_head != blocks ||
+        blocks->phase != DIRTY_HEADER_RETURN_CLAIMED) {
+        qemu_mutex_unlock_ramlist();
+        return dirty_retirement_status(-ESTALE);
+    }
+    state->ready_head = blocks->ready_next;
+    if (!state->ready_head) {
+        state->ready_tail = NULL;
+    }
+    if (blocks->owner_prev) {
+        blocks->owner_prev->owner_next = blocks->owner_next;
+    } else {
+        state->owners = blocks->owner_next;
+    }
+    if (blocks->owner_next) {
+        blocks->owner_next->owner_prev = blocks->owner_prev;
+    }
