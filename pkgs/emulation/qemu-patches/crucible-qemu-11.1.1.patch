+static void test_append_u32(GByteArray *payload, uint16_t tag, uint32_t value)
+{
+    uint8_t bytes[4];
+
+    test_put_u32(bytes, value);
+    test_append_field(payload, tag, CRUCIBLE_NODE_FAULT_FIELD_TYPE_U32,
+                      bytes, sizeof(bytes));
+}
