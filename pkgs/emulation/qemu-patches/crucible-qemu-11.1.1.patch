+int qemu_plugin_crucible_ram_control_dispatch_wait_v1(
+    qemu_plugin_id_t id, qemu_plugin_crucible_ram_control_actor_v1 *actor)
+{
+    return qemu_plugin_crucible_ram_control_dispatch_wait_v2(
+        id, actor, QEMU_PLUGIN_CRUCIBLE_RAM_WAIT_READ);
