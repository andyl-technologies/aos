+/* Machine registration is excluded; timer engine bodies remain literal. */
+#undef opts_init
+#define opts_init(function) \
+    static void (*const fixture_##function)(void) G_GNUC_UNUSED = function;
+#include "../../hw/acpi/core.c"
+
+static char *fixture_executable;
+
+static __int128 observed_ps;
+static unsigned nanosecond_reads;
+
+static __int128 expiry_ps(const QEMUTimer *timer)
+{
+    return qemu_timer_tcg_ps_enabled() ? timer_expire_time_ps_wide(timer) :
+        (__int128)timer_expire_time_ns(timer) * PICOSECONDS_PER_NANOSECOND;
+}
+
+int64_t cpu_get_clock(void)
+{
+    __int128 nanoseconds = observed_ps / PICOSECONDS_PER_NANOSECOND;
+
+    nanosecond_reads++;
+    if (nanoseconds < INT64_MIN || nanoseconds > INT64_MAX) {
+        g_error("Diagnostic nanosecond projection exceeds the API range");
+    }
+    return nanoseconds;
+}
+
+bool icount_crucible_sim_mode(void)
+{
+    return false;
+}
+
+static __int128 observed_clock_ps(void)
+{
+    return observed_ps;
+}
+
+/* No transform is installed: fault paths must not become timer permission. */
+bool qemu_crucible_fault_clock_source_active(uint16_t kind, uint32_t instance)
+{
+    g_assert_cmpuint(kind, ==, QEMU_CRUCIBLE_CLOCK_X86_ACPI_PM_TIMER);
+    g_assert_cmpuint(instance, ==, 0);
+    return false;
+}
+
+bool qemu_crucible_fault_clock_source_rebase(uint16_t kind, uint32_t instance,
+                                            uint64_t raw)
+{
+    g_assert_cmpuint(kind, ==, QEMU_CRUCIBLE_CLOCK_X86_ACPI_PM_TIMER);
+    return true;
+}
+
+bool qemu_crucible_fault_clock_timer_fire(
+    uint16_t kind, uint32_t instance, uint16_t role, uint32_t index,
+    uint64_t sequence, uint64_t guest, uint64_t scheduler, uint64_t generation)
+{
+    g_assert_cmpuint(generation, ==, 0);
+    return true;
+}
+
+bool qemu_crucible_fault_clock_read_ticks(
+    uint16_t kind, uint32_t instance, uint64_t raw, uint64_t opportunity,
