+     * This remains reachable after first/post failure or semantic expiry. */
+    status = qemu_crucible_checkpoint_inventory_metadata_return_current_v1(loan);
+    if (status) {
+        return status;
+    }
+    borrow->held = false;
+    borrow->owner_holder = NULL;
+    borrow->loan = NULL;
+    *out = NULL;
+    return 0;
