+bool pci_device_fingerprint_validate(const PCIDevice *dev, Error **errp)
+{
+    uint32_t config_size;
+
+    if (!dev || !dev->config) {
+        error_setg(errp, "PCI device has no configuration projection");
+        return false;
+    }
+    config_size = pci_config_size(dev);
+    if (config_size != PCI_CONFIG_SPACE_SIZE &&
+        config_size != PCIE_CONFIG_SPACE_SIZE) {
+        error_setg(errp, "PCI device has invalid configuration size");
+        return false;
+    }
+
+    return true;
+}
+
+void pci_device_fingerprint_put(QEMUFile *f, const PCIDevice *dev)
+{
+    uint16_t status;
+    uint32_t config_size = pci_config_size(dev);
+
+    status = pci_get_word(dev->config + PCI_STATUS);
+    if (dev->irq_state != 0) {
+        status |= PCI_STATUS_INTERRUPT;
+    } else {
+        status &= ~PCI_STATUS_INTERRUPT;
+    }
+    qemu_put_be32(f, config_size);
+    for (uint32_t offset = 0; offset < config_size; offset++) {
+        uint8_t value = dev->config[offset];
+
+        if (offset == PCI_STATUS) {
+            value = status;
+        } else if (offset == PCI_STATUS + 1) {
+            value = status >> 8;
+        }
+        qemu_put_byte(f, value);
+    }
+    for (int irq = 0; irq < PCI_NUM_PINS; irq++) {
+        qemu_put_be32(f, (dev->irq_state >> irq) & 1);
+    }
+}
+
+bool pci_device_fingerprint_projection(QEMUFile *f, const PCIDevice *dev,
+                                       Error **errp)
+{
+    if (!pci_device_fingerprint_validate(dev, errp)) {
+        return false;
+    }
+
+    pci_device_fingerprint_put(f, dev);
+    return true;
+}
