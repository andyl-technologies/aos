+typedef struct Handshake { GAsyncQueue *published, *acknowledged; } Handshake;
+
+static gpointer queue_writer(gpointer opaque)
+{
+    Handshake *handshake = opaque;
+    for (unsigned int i = 0; i < 1000; i++) {
+        struct qemu_plugin_crucible_fault_command item = command(100 + i);
+        g_assert_cmpint(qemu_plugin_crucible_fault_submit(&item, NULL, 0), ==, 0);
+        g_async_queue_push(handshake->published, GINT_TO_POINTER(1));
+        g_async_queue_pop(handshake->acknowledged);
+        g_assert_cmpint(qemu_plugin_crucible_fault_cancel(item.command_sequence),
+                        ==, 0);
+        g_async_queue_push(handshake->published, GINT_TO_POINTER(2));
+        g_async_queue_pop(handshake->acknowledged);
+    }
+    return NULL;
+}
+
+static bool race_done;
+
+static gpointer racing_writer(gpointer opaque)
+{
+    (void)opaque;
+    for (unsigned int i = 0; i < 10000; i++) {
+        struct qemu_plugin_crucible_fault_command item = command(2000 + i);
+        g_assert_cmpint(qemu_plugin_crucible_fault_submit(&item, NULL, 0), ==, 0);
+        g_assert_cmpint(qemu_plugin_crucible_fault_cancel(item.command_sequence),
+                        ==, 0);
+    }
+    qatomic_store_release(&race_done, true);
+    return NULL;
+}
+
+static void concurrent_checks(void)
+{
+    Handshake handshake = { g_async_queue_new(), g_async_queue_new() };
+    GThread *writer = g_thread_new("fault-writer", queue_writer, &handshake);
+    for (unsigned int i = 0; i < 1000; i++) {
+        g_assert_cmpint(GPOINTER_TO_INT(g_async_queue_pop(handshake.published)),
+                        ==, 1);
+        g_assert_true(qemu_crucible_fault_has_pending_at_or_before(1, raw_now));
+        g_async_queue_push(handshake.acknowledged, GINT_TO_POINTER(1));
+        g_assert_cmpint(GPOINTER_TO_INT(g_async_queue_pop(handshake.published)),
+                        ==, 2);
+        empty_queries();
+        g_async_queue_push(handshake.acknowledged, GINT_TO_POINTER(1));
+    }
+    g_thread_join(writer);
+    g_async_queue_unref(handshake.published);
+    g_async_queue_unref(handshake.acknowledged);
+
+    writer = g_thread_new("racing-writer", racing_writer, NULL);
+    do {
+        qemu_crucible_fault_has_pending_at_or_before(1, raw_now);
+        qemu_crucible_fault_next_icount(1);
+        qemu_crucible_fault_next_boundary_deadline(1);
+    } while (!qatomic_load_acquire(&race_done));
+    g_thread_join(writer);
+    empty_queries();
+    g_assert_cmpuint(qatomic_load_acquire(&crucible_pending_count), ==, 0);
+}
