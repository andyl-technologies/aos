+def baseline_names(source):
+    """Give baseline entry points distinct names for the differential link."""
+    for name in ["qemu_crucible_fault_rule_foreach",
+                 "qemu_crucible_fault_register_rules_active",
+                 "qemu_crucible_fault_register_boundaries_active",
+                 "crucible_register_active_visit"]:
+        source = source.replace(name, "baseline_" + name)
+    return source
+
+
+def type_definition(source, signature):
+    """Extract a complete production type, including its typedef name."""
+    body = definition(source, signature)
+    end = source.index(signature) + len(body)
+    return body + source[end:source.index(";", end) + 1]
+
+
+def production_parts(baseline_ref=None, abi_header=None):
+    """Extract old and new source bodies and the actual accessed rule layout."""
