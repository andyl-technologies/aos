+
+    edu_worker_pause(edu);
+    if (!edu_state_valid(edu, &local_err)) {
+        error_report_err(local_err);
+        edu_worker_resume(edu);
+        return -EINVAL;
+    }
+    return 0;
+}
+
+static void edu_post_save(void *opaque)
+{
+    edu_worker_resume(opaque);
+}
