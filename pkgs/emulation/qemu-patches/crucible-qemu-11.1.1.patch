+    qemu_plugin_crucible_checkpoint_provider_end_cb_t end, void *userdata)
+{
+    int status;
+
+    if (qemu_crucible_resident_service_birth_blocked_v1()) {
+        return -EBUSY;
+    }
+    if (!startup_invocation(id)) {
+        return -EPERM;
+    }
+    status = startup_active(id);
+    if (status) {
+        return status;
+    }
+    if (startup_source.provider_attempted) {
+        return -EALREADY;
+    }
+    if (!acquire || !check || !end || !userdata ||
+        !qatomic_load_acquire(&startup_source.checkpoint_pager_registered) ||
+        userdata != startup_source.checkpoint_pager_userdata ||
+        startup_source.ram_control_actor.attempted) {
+        return -EINVAL;
+    }
+    startup_source.provider_attempted = true;
+    status = qemu_plugin_crucible_startup_source_check_v1(id);
+    if (status) {
+        return status;
+    }
+    startup_source.provider_acquire = acquire;
+    startup_source.provider_check = check;
+    startup_source.provider_end = end;
+    startup_source.provider_userdata = userdata;
+    qatomic_store_release(&startup_source.provider_registered, true);
+    return 0;
+}
