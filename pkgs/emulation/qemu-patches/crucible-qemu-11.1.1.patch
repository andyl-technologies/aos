+/* Record the actual successful reservation at its producer edge. Later
+ * storage receipts use this journal, never infer a payer from prefix capacity. */
+static int preexec_setup_fixed_owner_retain(void)
+{
+    QemuCruciblePreexecSetupOwner *owner = &preexec_setup_owner;
+    int status;
+
+    if (owner->fixed_owner_retained || owner->fixed_owner_charge) {
+        return -EALREADY;
+    }
+    status = preexec_setup_provisional_native(sizeof(*owner));
+    if (!status) {
+        owner->fixed_owner_charge = sizeof(*owner);
+        owner->fixed_owner_retained = true;
+    }
+    return status;
+}
+
+/* One close only, with the exact raw result journaled before any bookkeeping.
+ * Failed close retains its numeric identity as uncertain; it is never retried.
+ * Successful request retirement says nothing about allocator/kernel cache RSS.
+ */
+static int preexec_setup_close_owned(int *fd)
+{
+    long status;
+
+    if (*fd < 0) {
+        return -EALREADY;
+    }
+    status = preexec_setup_syscall5(SYS_close, *fd, 0, 0, 0, 0);
+    if (status < 0) {
+        if (!preexec_setup_owner.close_status) {
+            preexec_setup_owner.close_status = status;
+        }
+        return status;
+    }
+    *fd = -1;
+    return 0;
+}
+
+static size_t preexec_setup_string_length(const char *text, size_t capacity)
+{
+    size_t length = 0;
+
+    while (length < capacity && text[length]) {
+        length++;
+    }
+    return length;
+}
+
+static int preexec_setup_metadata_read(int directory, const char *name,
+                                       size_t *bytes)
+{
+    QemuCruciblePreexecSetupOwner *owner = &preexec_setup_owner;
+    long status;
+    int closed;
+
+    if (owner->metadata_reader >= 0 || owner->close_status) {
+        return -EBUSY;
+    }
+    status = preexec_setup_syscall5(SYS_openat, directory,
+        (long)(uintptr_t)name, O_RDONLY | O_CLOEXEC | O_NONBLOCK | O_NOFOLLOW,
+        0, 0);
+    if (status < 0) {
+        return status;
+    }
+    owner->metadata_reader = status;
+    status = preexec_setup_syscall5(SYS_read, owner->metadata_reader,
+        (long)(uintptr_t)owner->metadata_bytes,
+        sizeof(owner->metadata_bytes) - 1, 0, 0);
+    /* A bounded read plus one nonblocking EOF probe proves the whole file.
+     * Neither operation retries EINTR; a short line is not completeness.
+     */
+    if (status > 0 && status < sizeof(owner->metadata_bytes) - 1 &&
+        owner->metadata_bytes[status - 1] == '\n') {
+        size_t count = status;
+        uint8_t trailing;
+
+        status = preexec_setup_syscall5(SYS_read, owner->metadata_reader,
+            (long)(uintptr_t)&trailing, 1, 0, 0);
+        if (status > 0) {
+            status = -E2BIG;
+        } else if (!status) {
+            owner->metadata_bytes[count] = 0;
+            *bytes = count;
+        }
+    } else if (status >= 0) {
+        status = -E2BIG;
+    }
+    closed = preexec_setup_close_owned(&owner->metadata_reader);
+    return status ? status : closed;
+}
+
+static int preexec_setup_path_unescape(const char *input, size_t bytes,
+                                       char *out, size_t capacity)
+{
+    size_t used = 0;
+
+    for (size_t index = 0; index < bytes; index++) {
+        unsigned char byte = input[index];
+
+        if (byte == '\\') {
+            unsigned value = 0;
+
+            if (bytes - index < 4) {
+                return -EINVAL;
+            }
+            for (size_t digit = 1; digit <= 3; digit++) {
+                if (input[index + digit] < '0' || input[index + digit] > '7') {
+                    return -EINVAL;
+                }
+                value = value * 8 + input[index + digit] - '0';
+            }
+            if (!value || value > UCHAR_MAX) {
+                return -EINVAL;
+            }
+            byte = value;
+            index += 3;
+        }
+        if (!byte || used + 1 >= capacity) {
+            return -E2BIG;
+        }
+        out[used++] = byte;
+    }
+    out[used] = 0;
+    return used && out[0] == '/' ? 0 : -EINVAL;
+}
+
+static int preexec_setup_cgroup_mapping(void)
+{
+    QemuCruciblePreexecSetupOwner *owner = &preexec_setup_owner;
+    size_t bytes;
+    size_t cursor = 0;
+    bool found = false;
+    int status = preexec_setup_metadata_read(AT_FDCWD, "/proc/self/cgroup", &bytes);
+
+    if (status) {
+        return status;
+    }
+    while (cursor < bytes) {
+        size_t end = cursor;
+
+        while (end < bytes && owner->metadata_bytes[end] != '\n') {
+            end++;
+        }
+        if (end - cursor > 3 &&
+            !preexec_setup_compare(owner->metadata_bytes + cursor, "0::", 3)) {
+            if (found) {
+                return -EINVAL;
+            }
+            status = preexec_setup_path_unescape(owner->metadata_bytes + cursor + 3,
+                end - cursor - 3, owner->cgroup_path, sizeof(owner->cgroup_path));
+            if (status) {
+                return status;
+            }
+            found = true;
+        }
+        cursor = end + 1;
+    }
+    if (!found) {
+        return -ENOTSUP;
+    }
+    status = preexec_setup_metadata_read(AT_FDCWD, "/proc/self/mountinfo", &bytes);
+    if (status) {
+        return status;
+    }
+    cursor = 0;
+    found = false;
+    while (cursor < bytes) {
+        char *fields[6];
+        size_t lengths[6];
+        size_t end = cursor;
+        size_t scan = cursor;
+        size_t field = 0;
+        size_t separator = 0;
+        char root[4096];
+
+        while (end < bytes && owner->metadata_bytes[end] != '\n') {
+            end++;
+        }
+        while (scan < end && field < 6) {
+            size_t start = scan;
+
+            while (scan < end && owner->metadata_bytes[scan] != ' ') {
+                scan++;
+            }
+            fields[field] = owner->metadata_bytes + start;
+            lengths[field++] = scan - start;
+            scan++;
+        }
+        if (field != 6) {
+            return -EINVAL;
+        }
+        while (scan + 2 < end) {
+            if (owner->metadata_bytes[scan] == '-' &&
+                owner->metadata_bytes[scan + 1] == ' ') {
+                separator = scan + 2;
+                break;
+            }
+            while (scan < end && owner->metadata_bytes[scan] != ' ') {
+                scan++;
+            }
+            scan++;
+        }
+        if (separator && end - separator > 8 &&
+            !preexec_setup_compare(owner->metadata_bytes + separator, "cgroup2 ", 8)) {
+            size_t root_bytes;
+            size_t group_bytes;
+            const char *suffix;
+            size_t mount_bytes;
+            size_t suffix_bytes;
+
+            status = preexec_setup_path_unescape(fields[3], lengths[3],
+                root, sizeof(root));
+            if (status) {
+                return status;
+            }
+            root_bytes = preexec_setup_string_length(root, sizeof(root));
+            group_bytes = preexec_setup_string_length(owner->cgroup_path,
+                                                       sizeof(owner->cgroup_path));
+            if (root_bytes <= group_bytes &&
+                !preexec_setup_compare(root, owner->cgroup_path, root_bytes) &&
+                (root_bytes == 1 || group_bytes == root_bytes ||
+                 owner->cgroup_path[root_bytes] == '/')) {
+                if (found) {
+                    return -ENOTSUP;
+                }
+                status = preexec_setup_path_unescape(fields[4], lengths[4],
+                    owner->cgroup_mount, sizeof(owner->cgroup_mount));
+                if (status) {
+                    return status;
+                }
+                suffix = owner->cgroup_path + (root_bytes == 1 ? 0 : root_bytes);
+                mount_bytes = preexec_setup_string_length(owner->cgroup_mount,
+                    sizeof(owner->cgroup_mount));
+                suffix_bytes = preexec_setup_string_length(suffix,
+                    sizeof(owner->cgroup_path));
+                if (mount_bytes + suffix_bytes + 1 > sizeof(owner->cgroup_target)) {
+                    return -E2BIG;
+                }
+                preexec_setup_copy(owner->cgroup_target, owner->cgroup_mount,
+                                   mount_bytes);
+                preexec_setup_copy(owner->cgroup_target + mount_bytes, suffix,
+                                   suffix_bytes + 1);
+                found = true;
+            }
+        }
+        cursor = end + 1;
+    }
+    return found ? 0 : -ENOTSUP;
+}
+
+/* Every real directory component is opened without following a symlink. The
+ * selected child identity comes from the kernel path/mount mapping above;
+ * no delegated root pathname or workload-root identity is assumed.
+ */
+static int preexec_setup_cgroup_open(void)
+{
+    QemuCruciblePreexecSetupOwner *owner = &preexec_setup_owner;
+    size_t cursor = 1;
+    long status = preexec_setup_syscall5(SYS_openat, AT_FDCWD,
+        (long)(uintptr_t)"/", O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW,
+        0, 0);
+
+    if (status < 0) {
+        return status;
+    }
+    owner->walking_directory = status;
+    while (owner->cgroup_target[cursor]) {
+        size_t start = cursor;
+        size_t count;
+
+        while (owner->cgroup_target[cursor] && owner->cgroup_target[cursor] != '/') {
+            cursor++;
+        }
+        count = cursor - start;
+        if (!count) {
+            cursor++;
+            continue;
+        }
+        if (count > NAME_MAX || (count == 1 && owner->cgroup_target[start] == '.') ||
+            (count == 2 && !preexec_setup_compare(owner->cgroup_target + start,
+                                                  "..", 2))) {
+            return -EINVAL;
+        }
+        preexec_setup_copy(owner->cgroup_component, owner->cgroup_target + start,
+                           count);
+        owner->cgroup_component[count] = 0;
+        status = preexec_setup_syscall5(SYS_openat, owner->walking_directory,
+            (long)(uintptr_t)owner->cgroup_component,
+            O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW, 0, 0);
+        if (status < 0) {
+            return status;
+        }
+        owner->cgroup_directory = status;
+        status = preexec_setup_close_owned(&owner->walking_directory);
+        if (status) {
+            return status;
+        }
+        owner->walking_directory = owner->cgroup_directory;
+        owner->cgroup_directory = -1;
+        if (owner->cgroup_target[cursor] == '/') {
+            cursor++;
+        }
+    }
+    owner->cgroup_directory = owner->walking_directory;
+    owner->walking_directory = -1;
+    status = preexec_setup_syscall5(SYS_fstat, owner->cgroup_directory,
+        (long)(uintptr_t)&owner->cgroup_identity, 0, 0, 0);
+    if (status < 0) {
+        return status;
+    }
+    return owner->cgroup_identity.st_dev == owner->plan.purpose.child_cgroup_device &&
+        owner->cgroup_identity.st_ino == owner->plan.purpose.child_cgroup_inode ?
+        0 : -ESTALE;
+}
+
+static int preexec_setup_decimal(const char *bytes, size_t length,
+                                 size_t *cursor, uint64_t *value)
+{
+    uint64_t number = 0;
+    size_t start = *cursor;
+
+    while (*cursor < length && bytes[*cursor] >= '0' && bytes[*cursor] <= '9') {
+        unsigned digit = bytes[(*cursor)++] - '0';
+
+        if (number > (UINT64_MAX - digit) / 10) {
+            return -EOVERFLOW;
+        }
+        number = number * 10 + digit;
+    }
+    if (*cursor == start) {
+        return -EINVAL;
+    }
+    *value = number;
+    return 0;
+}
+
+static int preexec_setup_cgroup(void)
+{
+    QemuCruciblePreexecSetupOwner *owner = &preexec_setup_owner;
+    const char *names[3] = { "memory.max", "pids.max", "memory.swap.max" };
+    const uint64_t expected[3] = {
+        owner->plan.purpose.memory_limit, owner->plan.purpose.task_limit, 0,
+    };
+    size_t bytes;
+    uint64_t quota;
+    uint64_t period;
+    int status = preexec_setup_cgroup_mapping();
+    if (!status) {
+        status = preexec_setup_cgroup_open();
+    }
+    if (status) {
+        return status;
+    }
+    for (size_t index = 0; index < 3; index++) {
+        size_t cursor = 0;
+        uint64_t value;
+
+        status = preexec_setup_metadata_read(owner->cgroup_directory,
+                                             names[index], &bytes);
+        if (!status) {
+            status = preexec_setup_decimal(owner->metadata_bytes, bytes,
+                                           &cursor, &value);
+        }
+        if (status || cursor + 1 != bytes || owner->metadata_bytes[cursor] != '\n' ||
+            value != expected[index]) {
+            return status ? status : -ESTALE;
+        }
+    }
+    status = preexec_setup_metadata_read(owner->cgroup_directory, "cpu.max", &bytes);
+    if (!status) {
+        size_t cursor = 0;
+
+        status = preexec_setup_decimal(owner->metadata_bytes, bytes, &cursor, &quota);
+        if (!status && cursor < bytes && owner->metadata_bytes[cursor++] == ' ') {
+            status = preexec_setup_decimal(owner->metadata_bytes, bytes,
+                                           &cursor, &period);
+        } else if (!status) {
+            status = -EINVAL;
+        }
+        if (!status && (cursor + 1 != bytes || owner->metadata_bytes[cursor] != '\n' ||
+            period != 100000 || owner->plan.purpose.vcpu_limit > UINT64_MAX / 100000 ||
+            quota != owner->plan.purpose.vcpu_limit * 100000)) {
+            status = -ESTALE;
+        }
+    }
+    if (!status) {
+        owner->cgroup_corroborated = true;
+    }
+    return status;
+}
+
+#include "crucible-preexec-family.inc.h"
+
+static int preexec_setup_fd_event_id(int fd, uint64_t *event_id)
+{
+    char path[64] = "/proc/self/fdinfo/";
+    char digits[16];
+    size_t used = 0;
+    size_t prefix = sizeof("/proc/self/fdinfo/") - 1;
+    size_t bytes;
+    unsigned number;
+    bool found = false;
+    uint64_t observed = 0;
+    int status;
+
+    if (fd < 0) {
+        return -EBADF;
+    }
+    number = fd;
+    do {
+        digits[used++] = '0' + number % 10;
+        number /= 10;
+    } while (number);
+    for (size_t index = 0; index < used; index++) {
+        path[prefix + index] = digits[used - index - 1];
+    }
+    path[prefix + used] = 0;
+    status = preexec_setup_metadata_read(AT_FDCWD, path, &bytes);
+    if (status) {
+        return status;
+    }
+    for (size_t cursor = 0; cursor < bytes;) {
+        size_t end = cursor;
+
+        while (end < bytes && preexec_setup_owner.metadata_bytes[end] != '\n') {
+            end++;
+        }
+        if (end - cursor >= sizeof("eventfd-id:") - 1 &&
+            !preexec_setup_compare(preexec_setup_owner.metadata_bytes + cursor,
+                "eventfd-id:", sizeof("eventfd-id:") - 1)) {
+            size_t position = cursor + sizeof("eventfd-id:") - 1;
+
+            if (found) {
+                return -ESTALE;
+            }
+            while (position < end &&
+                   (preexec_setup_owner.metadata_bytes[position] == ' ' ||
+                    preexec_setup_owner.metadata_bytes[position] == '\t')) {
+                position++;
+            }
+            status = preexec_setup_decimal(preexec_setup_owner.metadata_bytes,
+                                           end, &position, &observed);
+            if (status || position != end || observed > INT_MAX) {
+                return status ? status : -ESTALE;
+            }
+            found = true;
+        }
+        cursor = end + 1;
+    }
+    if (!found) {
+        return -ESTALE;
+    }
+    /* Source128 encodes kernel eventfd-id plus one, permitting kernel id0. */
+    *event_id = observed + 1;
+    return 0;
+}
+
+static int preexec_setup_original_live(void)
+{
+    QemuCruciblePreexecSetupOwner *owner = &preexec_setup_owner;
+    const QemuCrucibleOriginalStartupWireRecord *original = &owner->plan.startup;
+    struct timespec time;
+    struct stat identity;
+    struct pollfd event = { .fd = 12, .events = POLLIN };
+    uint64_t event_id;
+    uint64_t now;
+    long status;
+
+    if (!owner->plan_validated || original->cancellation_descriptor != 12) {
+        return -EPERM;
+    }
+    status = preexec_setup_syscall5(SYS_fstat, 12,
+        (long)(uintptr_t)&identity, 0, 0, 0);
+    if (status < 0) {
+        return status;
+    }
+    if ((uint64_t)identity.st_dev != original->cancellation_device ||
+        (uint64_t)identity.st_ino != original->cancellation_inode) {
+        return -ESTALE;
+    }
+    status = preexec_setup_syscall5(SYS_fcntl, 12, F_GETFL, 0, 0, 0);
+    if (status < 0 || !(status & O_NONBLOCK)) {
+        return status < 0 ? status : -ESTALE;
+    }
+    status = preexec_setup_syscall5(SYS_fcntl, 12, F_GETFD, 0, 0, 0);
+    if (status < 0 || (status & FD_CLOEXEC)) {
+        return status < 0 ? status : -ESTALE;
+    }
+    status = preexec_setup_fd_event_id(12, &event_id);
+    if (status || event_id != original->cancellation_event_id) {
+        return status ? status : -ESTALE;
+    }
+    status = preexec_setup_syscall5(SYS_poll,
+        (long)(uintptr_t)&event, 1, 0, 0, 0);
+    if (status < 0) {
+        return status;
+    }
+    if (status || event.revents) {
+        return -ECANCELED;
+    }
+    status = preexec_setup_syscall5(SYS_clock_gettime, CLOCK_MONOTONIC,
+        (long)(uintptr_t)&time, 0, 0, 0);
+    if (status < 0) {
+        return status;
+    }
+    if (time.tv_sec < 0 || time.tv_nsec < 0 || time.tv_nsec >= 1000000000 ||
+        (uint64_t)time.tv_sec >
+            (UINT64_MAX - (uint64_t)time.tv_nsec) / 1000000000) {
+        return -EOVERFLOW;
+    }
+    now = (uint64_t)time.tv_sec * 1000000000 + time.tv_nsec;
+    if (now < original->original_start_ns ||
+        now < owner->plan.purpose.containing_start) {
+        return -ESTALE;
+    }
+    if (now >= original->absolute_end_ns ||
+        now >= owner->plan.purpose.containing_end) {
+        return -ETIMEDOUT;
+    }
+    return 0;
+}
+
+static int preexec_setup_aliases(void)
+{
+    QemuCruciblePreexecSetupOwner *owner = &preexec_setup_owner;
+    struct stat memory;
+    struct stat inherited_memory;
+    struct stat workspace;
+    uint64_t wake;
+    uint64_t inherited_wake;
+    uint64_t region = preexec_setup_be64(owner->frame +
+        QEMU_CRUCIBLE_PREEXEC_SETUP_PAYLOAD_OFFSET);
+    long status;
+
+    if (owner->source_published || owner->memory_alias_identity_known) {
+        return -EALREADY;
+    }
+    status = preexec_setup_syscall5(SYS_fstat, owner->descriptors[0],
+        (long)(uintptr_t)&memory, 0, 0, 0);
+    if (status < 0) {
+        return status;
+    }
+    status = preexec_setup_syscall5(SYS_fstat,
+        QEMU_CRUCIBLE_PREEXEC_SETUP_INHERITED_MEMORY_FD,
+        (long)(uintptr_t)&inherited_memory, 0, 0, 0);
+    if (status < 0) {
+        return status;
+    }
+    if (!S_ISREG(memory.st_mode) || memory.st_size < 0 ||
+        (uint64_t)memory.st_size != region || memory.st_dev != inherited_memory.st_dev ||
+        memory.st_ino != inherited_memory.st_ino) {
+        return -ESTALE;
+    }
+    status = preexec_setup_fd_event_id(owner->descriptors[1], &wake);
+    if (!status) {
+        status = preexec_setup_fd_event_id(
+            QEMU_CRUCIBLE_PREEXEC_SETUP_INHERITED_WAKE_FD, &inherited_wake);
+    }
+    if (status || wake != inherited_wake) {
+        return status ? status : -ESTALE;
+    }
+    owner->wake_event_id = wake;
+    if (owner->plan.workspace_bytes) {
+        status = preexec_setup_syscall5(SYS_fstat, owner->descriptors[QEMU_CRUCIBLE_PREEXEC_SETUP_WORKSPACE_INDEX],
+            (long)(uintptr_t)&workspace, 0, 0, 0);
+        if (status < 0) {
+            return status;
+        }
+        if (!S_ISREG(workspace.st_mode) || workspace.st_size < 0 ||
+            (uint64_t)workspace.st_size != owner->plan.workspace.allocation_extent ||
+            (uint64_t)workspace.st_dev != owner->plan.workspace.device ||
+            (uint64_t)workspace.st_ino != owner->plan.workspace.inode) {
+            return -ESTALE;
+        }
+    }
+    owner->memory_alias_identity = memory;
+    owner->memory_alias_identity_known = true;
+    return 0;
+}
