+int qemu_plugin_crucible_startup_source_command_receive_create_v1(
+    qemu_plugin_id_t id, QemuCrucibleCommandConsumerMember *member,
+    QemuCrucibleCommandReceiveOwner **out, uint64_t *serial)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    QemuCrucibleCommandReceiveOwner *owner = &startup_source.command_receive;
+    QemuThread thread;
+    int first = command_registry_identity(id);
+    int reader_status = 0;
+    int post;
+    int result;
+    int identity;
+    uint64_t born_serial;
+
+    if (first || !out || !serial || !startup_owner() || bql_locked() || qemu_in_coroutine()) {
+        return first ? first : -EPERM;
+    }
+    qemu_thread_get_self(&thread);
+    qemu_mutex_lock(&commands->mutex);
+    if (callback_child_output_conflicts_locked(out, sizeof(*out)) ||
+        callback_child_output_conflicts_locked(serial, sizeof(*serial)) ||
+        callback_child_output_overlap(out, sizeof(*out), serial, sizeof(*serial)) ||
+        *out || *serial) {
+        first = -EINVAL;
+    } else {
+        first = command_member_live_locked(member);
+    }
+    if (!first && (owner->held || member->receive_users || member->action_users ||
+                   startup_source.command_receive_serial == UINT64_MAX ||
+                   !startup_source.standing.retained || !startup_source.standing.lender)) {
+        first = -EBUSY;
+    }
+    if (first) {
+        qemu_mutex_unlock(&commands->mutex);
+        return first;
+    }
+
+    /* Source owns the receive transaction before invoking any module code or
+     * corroborating a publisher record. A negative result keeps this exact
+     * output/serial and the real member/transport dependency. */
+    *owner = (QemuCrucibleCommandReceiveOwner) {
+        .canonical_owner = owner,
+        .creation_owner = owner,
+        .holder = &owner->creation_owner,
+        .member = member,
+        .reader = member->reader,
+        .thread = thread,
+        .lender = startup_source.standing.lender,
+        .serial = ++startup_source.command_receive_serial,
+        .process = commands->process,
+        .held = true,
+        .creation_active = true,
+    };
+    born_serial = owner->serial;
+    member->receive_users++;
+    *out = owner;
+    *serial = owner->serial;
+    first = ready_delivery_receive_bind_locked(owner);
+    qemu_mutex_unlock(&commands->mutex);
+
+    if (!first) {
+        first = standing_boundary();
+    }
+    qemu_mutex_lock(&commands->mutex);
+    owner->first_status = first;
+    if (!first) {
+        owner->publisher = startup_source.standing.current.action;
+        owner->publisher_sequence = startup_source.standing.sequence;
+        owner->invocation_attempted = true;
+        owner->invocation_active = true;
+    }
+    qemu_mutex_unlock(&commands->mutex);
+    if (!first) {
+        /* The first constructor bound this exact reader to the genuine child.
+         * Inflight fields have a single writer while observers refuse active
+         * invocation. No ledger/native lock or dequeue spans this callback. */
+        SOURCE_CALLBACK_MASKED_INVOKE(
+            reader_status, &member->reader, owner->reader, member->child->address,
+            &owner->inflight_facts, &owner->inflight_progress, member->child->address);
+        qemu_mutex_lock(&commands->mutex);
+        owner->facts = owner->inflight_facts;
+        owner->progress = owner->inflight_progress;
+        owner->reader_status = reader_status;
+        owner->invocation_returned = true;
+        owner->invocation_active = false;
+        /* Save even valid zero-valued requests and received-before-post
+         * refusals before interpreting any result or phase acknowledgement. */
+        owner->progress_valid = command_receive_progress_valid(&owner->progress, reader_status);
+        if (!owner->progress_valid) {
+            owner->validation_status = -EPROTO;
+            owner->terminal_uncertain = true;
+        } else if (owner->progress.read_attempted && !owner->progress.reader_released) {
+            owner->validation_status = -EIO;
+            owner->terminal_uncertain = true;
+        }
+        qemu_mutex_unlock(&commands->mutex);
+    }
+
+    post = standing_boundary();
+    qemu_mutex_lock(&commands->mutex);
+    owner->post_status = post;
+    if (!post && owner->progress_valid) {
+        owner->post_status = command_receive_publisher_corroboration(
+            owner, &startup_source.standing.current.action);
+    }
+    result = command_receive_result_locked(owner);
+    identity = command_receive_identity_locked(owner, born_serial);
+
+    if (!identity) {
+        owner->creation_active = false;
+    } else {
+        owner->terminal_uncertain = true;
+        if (!result) {
+            result = identity;
+        }
+    }
+    qemu_mutex_unlock(&commands->mutex);
+    return result;
+#else
+    return -ENOTSUP;
+#endif
+}
