new file mode 100644
index 0000000000000000000000000000000000000000..74f76ce9c42cee9ebd27167bc4ee13b493f3b2a9
--- /dev/null
+++ b/tests/qtest/crucible-exact-tb-exit.py
@@ -0,0 +1,85 @@
+# Copyright (c) Andyl, Inc.
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Checks that an x86 OUT callback exits before a chained TB executes."""
+
+import argparse
+import os
+import subprocess
+import tempfile
+
+
+TIMEOUT_SECONDS = 10
+
+
+def build_bios(path):
+    """Builds a minimal BIOS whose first I/O instruction terminates its TB."""
+    bios = bytearray(65536)
+    bios[:17] = bytes(
+        (
+            0xFA,              # cli
+            0xB0, 0x5A,        # mov $0x5a, %al
+            0xE6, 0xE7,        # out %al, $0xe7
+            0x90, 0x90, 0x90,  # instructions that a stale soft kick executes
+            0x90, 0x90, 0x90,
+            0x90, 0x90, 0x90,
+            0x90,
+            0xEB, 0xFE,        # terminal loop
+        )
+    )
+    bios[-16:-11] = bytes((0xEA, 0x00, 0x00, 0x00, 0xF0))
+    with open(path, "wb") as output:
+        output.write(bios)
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--qemu", required=True)
+    parser.add_argument("--plugin", required=True)
+    arguments = parser.parse_args()
+
+    with tempfile.TemporaryDirectory(prefix="exact-tb-exit-") as temp_dir:
+        bios = os.path.join(temp_dir, "bios.bin")
+        build_bios(bios)
+        result_read, result_write = os.pipe()
+        command = [
+            arguments.qemu,
+            "-machine", "pc-q35-9.2",
+            "-cpu", "qemu64",
+            "-smp", "1",
+            "-nodefaults",
+            "-display", "none",
+            "-serial", "none",
+            "-bios", bios,
+            "-icount", "shift=0,align=off,sleep=off,rr_switch_quantum=4096",
+            "-accel", "sim,thread=single",
+            "-plugin", f"{arguments.plugin},result-fd={result_write}",
+        ]
+        process = subprocess.Popen(
+            command,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            pass_fds=(result_write,),
+        )
+        os.close(result_write)
+        try:
+            stdout, stderr = process.communicate(timeout=TIMEOUT_SECONDS)
+        except subprocess.TimeoutExpired:
+            process.kill()
+            stdout, stderr = process.communicate()
+            raise AssertionError(
+                f"QEMU exact-exit test timed out: {stderr.decode(errors='replace')}"
+            )
+        result = os.read(result_read, 4096).decode(errors="replace").strip()
+        os.close(result_read)
+
+    if process.returncode != 0 or not result.startswith("PASS "):
+        raise AssertionError(
+            f"exact TB exit failed: status={process.returncode} result={result!r} "
+            f"stdout={stdout.decode(errors='replace')!r} "
+            f"stderr={stderr.decode(errors='replace')!r}"
+        )
+    print(result)
+
+
+if __name__ == "__main__":
+    main()
