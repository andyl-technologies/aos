+static void test_clock_phase_projection(void)
+{
+    int64_t ref_ns = -1;
+    uint16_t phase_ps = 500;
+
+    g_assert_true(npcm_clk_project_ref_to_ns(&ref_ns, &phase_ps));
+    g_assert_cmpint(ref_ns, ==, 0);
+    g_assert_cmpuint(phase_ps, ==, 0);
