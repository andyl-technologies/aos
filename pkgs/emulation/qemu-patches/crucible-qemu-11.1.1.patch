+static void test_plugin_child_reinitializer_is_held_and_one_shot(void)
+{
+    uint64_t page_size = qemu_real_host_page_size();
+    struct qemu_plugin_crucible_hot_fork_child_plan plan = {
+        .schema_version = QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PLAN_VERSION,
+        .struct_size = sizeof(plan),
+        .parent_process_generation = 10,
+        .child_process_generation = 11,
+        .template_generation = 1,
+        .private_ring_generation = 2,
+        .plugin_endpoint_generation = 3,
+        .plugin_barrier_generation = 4,
+        .control_socket_cookie = 5,
+        .wake_eventfd_id = 6,
+        .shmem_device = 7,
+        .shmem_inode = 8,
+        .shmem_length = page_size,
+        .source_mapping_start = page_size,
+        .source_mapping_length = page_size,
+        .source_mapping_offset = 0,
+        .private_ring_fd = 3,
+        .control_fd = 4,
+        .wake_fd = 5,
+        .reserved_fd = -1,
+        .worker_mask = QEMU_PLUGIN_CRUCIBLE_WORKER_REQUIRED,
+    };
+    QemuCrucibleHotForkPluginChildReinitializer reinitializer;
+    struct qemu_plugin_crucible_hot_fork_child_plan foreign_plan;
+
+    fake_plugin_child_runtime = (FakePluginChildRuntime) {
+        .phase = QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PHASE_INITIALIZING,
+    };
+    g_assert_cmpint(qemu_crucible_hot_fork_prepare_plugin_child_reinitializer(
+                        &reinitializer, &plan),
+                    ==, 0);
+    g_assert_true(
+        qemu_crucible_hot_fork_plugin_child_reinitializer_prepared_for(
+            &reinitializer, &plan));
+    foreign_plan = plan;
+    foreign_plan.plugin_endpoint_generation++;
+    g_assert_false(
+        qemu_crucible_hot_fork_plugin_child_reinitializer_prepared_for(
+            &reinitializer, &foreign_plan));
+    qemu_crucible_hot_fork_reset_plugin_child_reinitializer(&reinitializer);
+    g_assert_false(
+        qemu_crucible_hot_fork_plugin_child_reinitializer_prepared_for(
+            &reinitializer, &plan));
+    g_assert_cmpint(qemu_crucible_hot_fork_prepare_plugin_child_reinitializer(
+                        &reinitializer, &plan),
+                    ==, 0);
+    g_assert_cmpint(qemu_crucible_hot_fork_reinitialize_plugin_child(
+                        &reinitializer),
+                    ==, -EPROTO);
+    g_assert_true(reinitializer.attempted);
+    g_assert_false(reinitializer.initialized);
+    g_assert_cmpuint(fake_plugin_child_runtime.calls, ==, 1);
+    g_assert_cmpint(qemu_crucible_hot_fork_reinitialize_plugin_child(
+                        &reinitializer),
+                    ==, -EPERM);
+    g_assert_cmpuint(fake_plugin_child_runtime.calls, ==, 1);
+
+    /*
+     * Replacement workers park from their own threads after initialization
+     * returns, so the reinitializer queries until the held status is
+     * complete.
+     */
+    qemu_crucible_hot_fork_reset_plugin_child_reinitializer(&reinitializer);
+    g_assert_cmpint(qemu_crucible_hot_fork_prepare_plugin_child_reinitializer(
+                        &reinitializer, &plan),
+                    ==, 0);
+    fake_plugin_child_runtime = (FakePluginChildRuntime) {
+        .phase = QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PHASE_WORKERS_HELD,
+        .settle_queries = 3,
+    };
+    g_assert_cmpint(qemu_crucible_hot_fork_reinitialize_plugin_child(
+                        &reinitializer),
+                    ==, 0);
+    g_assert_true(reinitializer.initialized);
+    g_assert_cmpuint(fake_plugin_child_runtime.calls, ==, 4);
+    g_assert_cmpuint(fake_plugin_child_runtime.settle_queries, ==, 0);
+
+    /*
+     * Released workers are live: an idle one parks at its receive safe
+     * point, which activation must admit.
+     */
+    fake_plugin_child_runtime.idle_after_release = true;
+    g_assert_cmpint(qemu_crucible_hot_fork_activate_plugin_child(
+                        &reinitializer),
+                    ==, 0);
+    g_assert_true(reinitializer.activated);
+    g_assert_cmpuint(fake_plugin_child_runtime.calls, ==, 5);
+    g_assert_cmpint(qemu_crucible_hot_fork_activate_plugin_child(
+                        &reinitializer),
+                    ==, -EPERM);
+
+    plan.source_mapping_length--;
+    g_assert_cmpint(qemu_crucible_hot_fork_prepare_plugin_child_reinitializer(
+                        &reinitializer, &plan),
+                    ==, -EINVAL);
+}
