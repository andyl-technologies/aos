+static int cxl_component_timing_pre_save(void *opaque)
+{
+    CXLComponentState *cxl_cstate = opaque;
+    uint32_t *registers = cxl_cstate->crb.cache_mem_registers;
+    int type;
+
+    for (type = 0; type < CXL_BISTATE_MAX; type++) {
+        BIState *state = &cxl_cstate->bi_state[type];
+
+        state->control = ldl_le_p(registers + cxl_bi_control_offsets[type]);
+        state->status = ldl_le_p(registers + cxl_bi_status_offsets[type]);
+    }
+    return 0;
+}
+
+static bool cxl_component_timing_post_load(void *opaque, int version_id,
+                                           Error **errp)
+{
+    CXLComponentState *cxl_cstate = opaque;
+    uint32_t *registers = cxl_cstate->crb.cache_mem_registers;
+    int type;
+
+    for (type = 0; type < CXL_BISTATE_MAX; type++) {
+        BIState *state = &cxl_cstate->bi_state[type];
+
+        if (state->last_commit_phase_ps >= PICOSECONDS_PER_NANOSECOND ||
+            (!state->commit_pending &&
+             (state->last_commit_ns || state->last_commit_phase_ps))) {
+            error_setg(errp, "invalid CXL BI timing state");
+            return false;
+        }
+        if (state->commit_pending && !qemu_timer_tcg_ps_enabled() &&
+            !cxl_timing_project_to_ms(&state->last_commit_ns,
+                                      &state->last_commit_phase_ps, errp)) {
+            return false;
+        }
+        stl_le_p(registers + cxl_bi_control_offsets[type], state->control);
+        stl_le_p(registers + cxl_bi_status_offsets[type], state->status);
+    }
+
+    cxl_cstate->timing_vmstate_loaded = true;
+    return true;
+}
