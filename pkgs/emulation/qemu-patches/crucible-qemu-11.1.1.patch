+typedef struct CrucibleSelectableReset {
+    struct qemu_plugin_crucible_selectable_reset_request request;
+    uint8_t *bytes;
+    uint64_t observation_generation;
+    int status;
+    bool terminal;
+    bool event_sent;
+} CrucibleSelectableReset;
+
+/* BQL-owned, VM-wide identities; neither reconnect nor reset renews them. */
+static CrucibleSelectableReset *crucible_selectable_reset;
+static uint64_t crucible_selectable_reset_correlation;
+static uint64_t crucible_selectable_reset_generation;
+
+/* Restore entries can release BQL while doing I/O. This single atomic gate
+ * excludes a staged reset across the entire real operation, including nested
+ * device/state loads; it owns no allocation, timer, or resource authority. */
+static uint32_t crucible_selectable_operation;
+#define CRUCIBLE_SELECTABLE_RESET_EXCLUSIVE UINT32_MAX
+#define CRUCIBLE_SELECTABLE_RESTORE_UNCERTAIN (UINT32_MAX - 1)
+static bool crucible_selectable_reset_conflict;
+
+bool qemu_crucible_selectable_resume_blocked(void)
+{
+    return qatomic_read(&crucible_selectable_operation) ==
+        CRUCIBLE_SELECTABLE_RESET_EXCLUSIVE;
+}
+
+int qemu_crucible_selectable_restore_begin(void)
+{
+    uint32_t current = qatomic_read(&crucible_selectable_operation);
+
+    for (;;) {
+        uint32_t previous;
+
+        if (current >= CRUCIBLE_SELECTABLE_RESTORE_UNCERTAIN - 1) {
+            return -EBUSY;
+        }
+        previous = qatomic_cmpxchg(&crucible_selectable_operation,
+                                  current, current + 1);
+        if (previous == current) {
+            return 0;
+        }
+        current = previous;
+    }
+}
+
+void qemu_crucible_selectable_restore_end(void)
+{
+    uint32_t current = qatomic_read(&crucible_selectable_operation);
+
+    for (;;) {
+        uint32_t previous;
+
+        if (current == CRUCIBLE_SELECTABLE_RESTORE_UNCERTAIN) {
+            return;
+        }
+        assert(current && current < CRUCIBLE_SELECTABLE_RESTORE_UNCERTAIN);
+        previous = qatomic_cmpxchg(&crucible_selectable_operation,
+                                  current, current - 1);
+        if (previous == current) {
+            return;
+        }
+        current = previous;
+    }
+}
+
+void qemu_crucible_selectable_restore_uncertain(void)
+{
+    /* Keep a destructive failure unavailable to a later experimental reset.
+     * Ordinary reset behavior is unchanged when no selectable token exists. */
+    uint32_t previous = qatomic_xchg(&crucible_selectable_operation,
+                                    CRUCIBLE_SELECTABLE_RESTORE_UNCERTAIN);
+
+    assert(previous && previous != CRUCIBLE_SELECTABLE_RESET_EXCLUSIVE);
+}
