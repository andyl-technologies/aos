+int qemu_crucible_startup_source_publisher_module_identity_v1(
+    QemuCruciblePublisherSessionLender *lender, const void *child,
+    QemuCruciblePublisherModuleView *view, int returning, int *returned)
+{
+    QemuCruciblePublisherModuleService *service = &startup_source.publisher_module;
+    int status = startup_setup_service_identity(startup_source.saved.plugin_id);
+
+    if (status) {
+        return status;
+    }
+    if (child != service || lender != service->lender ||
+        !service->transition_active || (!!returning != service->closing) ||
+        (returning ? view != NULL || returned != &service->returned :
+                     view != &service->view || returned != NULL)) {
+        return -ESTALE;
+    }
+    if (service->transferred && !returning) {
+        return -EPERM;
+    }
+    if (returning) {
+        return startup_setup_service_return_boundary_current(service);
+    }
+    return 0;
+}
+
+static void startup_setup_service_return_finish(
+    QemuCruciblePublisherModuleService *service, int identity)
+{
+    if (!identity && service->returned) {
+        service->creation_owner = NULL;
+        service->holder = NULL;
+        service->held = false;
+    }
+    service->transition_active = false;
+}
