+    cpu_status.fw_remove = true;
+    g_assert_null(project_hotplug(&pm, false));
+
+    cpu_status.fw_remove = false;
+    pm.acpi_memory_hotplug.dev_count = 1;
+    pm.acpi_memory_hotplug.devs = &memory_status;
