+static void test_mutex_registry_reuses_quiescent_abandoned_address(void)
+{
+    QemuMutexHotForkInventory before;
+    QemuMutexHotForkInventory abandoned;
+    QemuMutexHotForkInventory reused;
+    QemuMutexHotForkInventory after;
+    TestMutexMapping mapping = reserve_test_mutex_mapping();
+    QemuMutex *mutex = (QemuMutex *)mapping.mutex_address;
+    uint64_t abandoned_id;
+    uint32_t abandoned_slot;
+
+    qemu_mutex_hot_fork_inventory(&before);
+    g_assert_false(before.overflowed);
+    qemu_mutex_init(mutex);
+    abandoned_id = mutex->crucible_hot_fork_registration_id;
+    abandoned_slot = mutex->crucible_hot_fork_slot;
+    abandon_test_mutex_mapping(&mapping);
+
+    /* An abandoned address is opaque registry data, not live storage. */
+    qemu_mutex_hot_fork_inventory(&abandoned);
+    g_assert_false(abandoned.overflowed);
+    g_assert_cmpuint(abandoned.entry_count, ==, before.entry_count + 1);
+
+    mutex = map_test_mutex_page(&mapping, PROT_READ | PROT_WRITE);
+    qemu_mutex_init(mutex);
+    g_assert_cmpuint(mutex->crucible_hot_fork_slot, ==, abandoned_slot);
+    g_assert_cmpuint(mutex->crucible_hot_fork_registration_id, !=,
+                     abandoned_id);
+    qemu_mutex_hot_fork_inventory(&reused);
+    g_assert_false(reused.overflowed);
+    g_assert_cmpuint(reused.entry_count, ==, before.entry_count + 1);
+
+    qemu_mutex_lock(mutex);
+    qemu_mutex_unlock(mutex);
+    qemu_mutex_destroy(mutex);
+    release_test_mutex_mapping(&mapping);
+    qemu_mutex_hot_fork_inventory(&after);
+    g_assert_false(after.overflowed);
+    g_assert_cmpuint(after.entry_count, ==, before.entry_count);
+
+    qemu_mutex_hot_fork_inventory_destroy(&after);
+    qemu_mutex_hot_fork_inventory_destroy(&reused);
+    qemu_mutex_hot_fork_inventory_destroy(&abandoned);
+    qemu_mutex_hot_fork_inventory_destroy(&before);
+}
