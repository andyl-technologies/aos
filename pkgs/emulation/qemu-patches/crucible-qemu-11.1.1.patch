+static int node_parse(const struct qemu_plugin_crucible_fault_command *command,
+                      const uint8_t *payload, size_t payload_len,
+                      QemuCrucibleFaultRule *rule)
+{
+    const NodeSchemaField *parameters;
+    const NodeSchemaField *targets;
+    size_t parameter_count;
+    size_t target_count;
+    size_t offset;
+    uint16_t previous_tag = 0;
+
+    if (payload_len < CRUCIBLE_NODE_FAULT_PAYLOAD_HEADER_V1_BYTES ||
+        payload_len > CRUCIBLE_FAULT_HARD_PAYLOAD_BYTES ||
+        memcmp(payload, CRUCIBLE_NODE_MAGIC, 8) != 0 ||
+        node_get_u16(payload + CRUCIBLE_NODE_FAULT_PAYLOAD_VERSION_OFFSET) !=
+            CRUCIBLE_NODE_FAULT_PAYLOAD_VERSION_V1 ||
+        node_get_u16(payload +
+                     CRUCIBLE_NODE_FAULT_PAYLOAD_RESERVED_OFFSET) != 0 ||
+        node_get_u16(
+            payload +
+            CRUCIBLE_NODE_FAULT_PAYLOAD_TRAILING_RESERVED_OFFSET) != 0) {
+        return -EINVAL;
+    }
+    memset(rule, 0, sizeof(*rule));
+    rule->command_kind = node_get_u16(
+        payload + CRUCIBLE_NODE_FAULT_PAYLOAD_COMMAND_KIND_OFFSET);
+    rule->operation = node_get_u16(
+        payload + CRUCIBLE_NODE_FAULT_PAYLOAD_OPERATION_OFFSET);
+    rule->target_kind = node_get_u16(
+        payload + CRUCIBLE_NODE_FAULT_PAYLOAD_TARGET_KIND_OFFSET);
+    rule->model_phase = node_get_u16(
+        payload + CRUCIBLE_NODE_FAULT_PAYLOAD_MODEL_PHASE_OFFSET);
+    rule->generation = node_get_u64(
+        payload + CRUCIBLE_NODE_FAULT_PAYLOAD_GENERATION_OFFSET);
+    rule->field_count = node_get_u16(
+        payload + CRUCIBLE_NODE_FAULT_PAYLOAD_FIELD_COUNT_OFFSET);
+    rule->command_sequence = command->command_sequence;
+    rule->command_phase = command->phase;
+    rule->semantic_version = command->semantic_version;
+    memcpy(rule->binding_hash, command->binding_hash, 32);
+    memcpy(rule->opportunity_hash, command->opportunity_hash, 32);
+    memcpy(rule->target_node_hash, command->target_node_hash, 32);
+    memcpy(rule->action_hash,
+           payload + CRUCIBLE_NODE_FAULT_PAYLOAD_ACTION_HASH_OFFSET, 32);
+    memcpy(rule->target_hash,
+           payload + CRUCIBLE_NODE_FAULT_PAYLOAD_TARGET_HASH_OFFSET, 32);
+    memcpy(rule->schema_hash,
+           payload + CRUCIBLE_NODE_FAULT_PAYLOAD_SCHEMA_HASH_OFFSET, 32);
+    if (rule->command_kind != command->command_kind ||
+        !node_operation_valid(rule->command_kind, rule->operation) ||
+        rule->model_phase == 0 || rule->generation == 0 ||
+        rule->field_count > CRUCIBLE_NODE_FAULT_MAX_FIELDS_V1 ||
+        !node_hash_nonzero(rule->binding_hash) ||
+        (rule->command_kind ==
+             CRUCIBLE_FAULT_COMMAND_ACCELERATOR_RESULT_TRANSFORM &&
+         rule->operation != CRUCIBLE_NODE_FAULT_OPERATION_REMOVE &&
+         !node_hash_nonzero(rule->opportunity_hash)) ||
+        !node_hash_nonzero(rule->action_hash) ||
+        !node_hash_nonzero(rule->target_hash) ||
+        !node_hash_nonzero(rule->schema_hash) ||
+        !node_schema_for(rule->command_kind, &parameters, &parameter_count) ||
+        !node_target_schema_for(rule->target_kind, &targets, &target_count)) {
+        return -EINVAL;
+    }
+    if (rule->command_kind ==
+        CRUCIBLE_FAULT_COMMAND_CPU_REGISTER_TRANSFORM) {
+        if ((rule->operation == CRUCIBLE_NODE_FAULT_OPERATION_APPLY &&
+             !((command->phase ==
+                    CRUCIBLE_FAULT_PHASE_BEFORE_INSTRUCTION &&
+                rule->model_phase ==
+                    QEMU_CRUCIBLE_MODEL_PHASE_BEFORE_INSTRUCTION) ||
+               (command->phase ==
+                    CRUCIBLE_FAULT_PHASE_AFTER_INSTRUCTION &&
+                rule->model_phase ==
+                    QEMU_CRUCIBLE_MODEL_PHASE_AFTER_INSTRUCTION))) ||
+            (rule->operation != CRUCIBLE_NODE_FAULT_OPERATION_APPLY &&
+             command->phase != CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY)) {
+            return -EINVAL;
+        }
+    }
+    rule->payload = g_memdup2(payload, payload_len);
+    rule->payload_len = payload_len;
+    offset = CRUCIBLE_NODE_FAULT_PAYLOAD_HEADER_V1_BYTES;
+    for (size_t i = 0; i < rule->field_count; i++) {
+        CrucibleNodeField *field = &rule->fields[i];
+        size_t end;
+
+        if (offset > payload_len || payload_len - offset <
+            CRUCIBLE_NODE_FAULT_FIELD_HEADER_V1_BYTES) {
+            return -EINVAL;
+        }
+        field->tag = node_get_u16(rule->payload + offset +
+                                  CRUCIBLE_NODE_FAULT_FIELD_TAG_OFFSET);
+        field->type = node_get_u16(rule->payload + offset +
+                                   CRUCIBLE_NODE_FAULT_FIELD_TYPE_OFFSET);
+        field->length = node_get_u32(rule->payload + offset +
+                                     CRUCIBLE_NODE_FAULT_FIELD_LENGTH_OFFSET);
+        offset += CRUCIBLE_NODE_FAULT_FIELD_HEADER_V1_BYTES;
+        end = offset + field->length;
+        if (end < offset || end > payload_len || field->tag <= previous_tag) {
+            return -EINVAL;
+        }
+        field->data = rule->payload + offset;
+        if (!node_field_value_valid(field->type, field->data, field->length)) {
+            return -EINVAL;
+        }
+        previous_tag = field->tag;
+        offset = end;
+    }
+    if (offset != payload_len) {
+        return -EINVAL;
+    }
+    if (!node_target_pair_valid(rule)) {
+        return -EINVAL;
+    }
+    if (rule->operation == CRUCIBLE_NODE_FAULT_OPERATION_REMOVE) {
+        return rule->field_count == 0 ? 0 : -EINVAL;
+    }
+    if (rule->operation == CRUCIBLE_NODE_FAULT_OPERATION_APPLY &&
+        !crucible_node_impulses[rule->command_kind]) {
+        return -EINVAL;
+    }
+    if (rule->field_count != parameter_count + target_count) {
+        return -EINVAL;
+    }
+    for (size_t i = 0; i < parameter_count; i++) {
+        if (!node_field_matches(rule, &parameters[i])) {
+            return -EINVAL;
+        }
+    }
+    for (size_t i = 0; i < target_count; i++) {
+        if (!node_field_matches(rule, &targets[i])) {
+            return -EINVAL;
+        }
+    }
+    return node_rule_policies_valid(rule) &&
+           node_rule_cross_fields_valid(rule) ? 0 : -EINVAL;
+}
+
+static void node_staging_clear(CrucibleNodeStaging *staging)
+{
+    g_auto(CrucibleNodeStorageOperation) operation =
+        node_storage_operation_begin();
+    CrucibleNodeStorageControl *control;
+    uint64_t issuance;
+
+    if (!operation.entered || !staging) {
+        return;
+    }
+    control = node_storage_retire_begin(staging, CRUCIBLE_NODE_STORAGE_STAGING);
+    if (!control) {
+        return;
+    }
+    issuance = control->issuance;
+    node_rule_clear(&staging->rule, control);
+    if (staging->impulse_evidence) {
+        g_byte_array_unref(staging->impulse_evidence);
+        control->references_returned |= CRUCIBLE_NODE_REF_IMPULSE_EVIDENCE;
+    }
+    if (staging->event_reservation) {
+        const void *reservation = staging->event_reservation;
+        uint64_t reservation_issuance =
+            staging->event_reservation->storage.issuance;
+
+        qemu_crucible_fault_event_reservation_release(
+            staging->event_reservation);
+        if (!node_storage_returned(reservation, reservation_issuance,
+                                   CRUCIBLE_NODE_STORAGE_RESERVATION)) {
+            control->post_status = -EBUSY;
+            return;
+        }
+        control->references_returned |= CRUCIBLE_NODE_REF_EVENT_RESERVATION;
+    }
+    if (!node_storage_unpublish(control)) {
+        return;
+    }
+    g_free(staging);
+    node_storage_retire_post(staging, issuance, CRUCIBLE_NODE_STORAGE_STAGING);
+}
+
+static int node_parse_owned(QemuCrucibleFaultRegistration *owner,
+    const struct qemu_plugin_crucible_fault_command *command,
+    const uint8_t *payload, size_t payload_len, QemuCrucibleFaultRule *rule)
+{
+    CrucibleNodeJsonJournal *journal;
+    int first, post;
+
+    if (command->command_kind != CRUCIBLE_FAULT_COMMAND_NODE_HANG) {
+        return node_parse(command, payload, payload_len, rule);
+    }
+    g_mutex_lock(&crucible_node_registrations.lock);
+    if (!owner || owner->holder != owner || owner->closing ||
+        owner->process != getpid()) {
+        g_mutex_unlock(&crucible_node_registrations.lock);
+        return -EPERM;
+    }
+    journal = g_new0(CrucibleNodeJsonJournal, 1);
+    journal->next = owner->json;
+    owner->json = journal;
+    g_mutex_unlock(&crucible_node_registrations.lock);
+
+    first = qobject_construction_begin(&journal->holder);
+    if (first) {
+        journal->post_status = first;
+        return first;
+    }
+    first = node_parse(command, payload, payload_len, rule);
+    post = qobject_construction_end(journal->holder);
+    journal->first_status = first;
+    journal->post_status = post;
+    return first ? first : post;
+}
+
+static int node_validate(
+    const struct qemu_plugin_crucible_fault_command *command,
+    const uint8_t *payload, size_t payload_len)
+{
+    QemuCrucibleFaultRule rule = { 0 };
+    QemuCrucibleFaultRegistration *owner = NULL;
+    int status;
+
+    if (command->command_kind == CRUCIBLE_FAULT_COMMAND_NODE_HANG) {
+        g_mutex_lock(&crucible_node_registrations.lock);
+        for (owner = crucible_node_registrations.head; owner; owner = owner->next) {
+            CrucibleNodeOwnedHandler *producer = container_of(
+                owner, CrucibleNodeOwnedHandler, registration);
+
+            if (owner->validation.holder == &owner->validation &&
+                !qemu_crucible_fault_validation_current_v1(
+                    &producer->handler, command, payload, payload_len)) {
+                break;
+            }
+        }
+        g_mutex_unlock(&crucible_node_registrations.lock);
+    }
+    status = node_parse_owned(owner, command, payload, payload_len, &rule);
+
+    node_rule_clear(&rule, NULL);
+    return status;
+}
+
+static int node_arm(const struct qemu_plugin_crucible_fault_command *command,
+                    const uint8_t *payload, size_t payload_len,
+                    void **state_out)
+{
+    g_auto(CrucibleNodeStorageOperation) operation =
+        node_storage_operation_begin();
+    QemuCrucibleFaultPendingControl *pending = NULL;
+    CrucibleNodeStaging *staging;
+    CrucibleNodeRegistrationChild *child = NULL;
+    uint64_t issuance;
+    int status;
+
+    if (qemu_plugin_crucible_startup_source_retained()) {
+        return -ENOKEY;
+    }
+    if (!operation.entered) {
+        return -EPERM;
+    }
+    status = qemu_crucible_fault_node_pending_callback_v1(
+        command, payload, payload_len, CRUCIBLE_PENDING_ARM, &pending);
+    if (status) {
+        return status;
+    }
+    issuance = node_storage_admit(CRUCIBLE_NODE_STORAGE_STAGING);
+    if (!issuance) {
+        return -EBUSY;
+    }
+    status = node_registration_child_acquire(pending->registration,
+        CRUCIBLE_NODE_STORAGE_STAGING, &child);
+    if (status) {
+        return status;
+    }
+    staging = g_new0(CrucibleNodeStaging, 1);
+    node_storage_publish(&staging->storage, staging, staging, &staging->rule,
+                         CRUCIBLE_NODE_STORAGE_STAGING, issuance,
+                         pending->registration, child);
+    pending->state_issuance = issuance;
+    *state_out = staging;
+    status = node_parse_owned(pending->registration, command, payload, payload_len,
+                              &staging->rule);
+    staging->storage.first_status = status;
+
+    if (status != 0) {
+        /* The pending child owns this born output, including parse failure. */
+        return status;
+    }
+    staging->impulse = crucible_node_impulses[command->command_kind];
+    pending = NULL;
+    status = qemu_crucible_fault_node_pending_callback_v1(
+        command, payload, payload_len, CRUCIBLE_PENDING_ARM, &pending);
+    staging->storage.post_status = status;
+    return status;
+}
+
+static void node_encode_evidence(CrucibleNodeStaging *staging,
+                                 GByteArray *payload)
+{
+    uint8_t evidence[CRUCIBLE_NODE_FAULT_EVIDENCE_V1_BYTES] = { 0 };
+
+    memcpy(evidence + CRUCIBLE_NODE_FAULT_EVIDENCE_MAGIC_OFFSET,
+           CRUCIBLE_NODE_EVIDENCE_MAGIC, 8);
+    stw_le_p(evidence + CRUCIBLE_NODE_FAULT_EVIDENCE_VERSION_OFFSET,
+             CRUCIBLE_NODE_FAULT_PAYLOAD_VERSION_V1);
+    stw_le_p(evidence + CRUCIBLE_NODE_FAULT_EVIDENCE_COMMAND_KIND_OFFSET,
+             staging->rule.command_kind);
+    stw_le_p(evidence + CRUCIBLE_NODE_FAULT_EVIDENCE_OPERATION_OFFSET,
+             staging->rule.operation);
+    stw_le_p(evidence + CRUCIBLE_NODE_FAULT_EVIDENCE_TARGET_KIND_OFFSET,
+             staging->rule.target_kind);
+    stw_le_p(evidence + CRUCIBLE_NODE_FAULT_EVIDENCE_MODEL_PHASE_OFFSET,
+             staging->rule.model_phase);
+    stq_le_p(evidence + CRUCIBLE_NODE_FAULT_EVIDENCE_GENERATION_OFFSET,
+             staging->rule.generation);
+    stq_le_p(evidence + CRUCIBLE_NODE_FAULT_EVIDENCE_PRIOR_GENERATION_OFFSET,
+             staging->prior ? staging->prior->generation : 0);
+    memcpy(evidence + CRUCIBLE_NODE_FAULT_EVIDENCE_ACTION_HASH_OFFSET,
+           staging->rule.action_hash, 32);
+    memcpy(evidence + CRUCIBLE_NODE_FAULT_EVIDENCE_TARGET_HASH_OFFSET,
+           staging->rule.target_hash, 32);
+    memcpy(evidence + CRUCIBLE_NODE_FAULT_EVIDENCE_SCHEMA_HASH_OFFSET,
+           staging->rule.schema_hash, 32);
+    memcpy(evidence + CRUCIBLE_NODE_FAULT_EVIDENCE_REQUEST_SHA256_OFFSET,
+           staging->request_hash, 32);
+    memcpy(evidence + CRUCIBLE_NODE_FAULT_EVIDENCE_BEFORE_SHA256_OFFSET,
+           staging->before_hash, 32);
+    memcpy(evidence + CRUCIBLE_NODE_FAULT_EVIDENCE_AFTER_SHA256_OFFSET,
+           staging->after_hash, 32);
+    g_byte_array_append(payload, evidence, sizeof(evidence));
+}
+
+GByteArray *qemu_crucible_fault_node_result_payload(
+    const QemuCrucibleFaultRule *rule, const uint8_t before_hash[32],
+    const uint8_t after_hash[32])
+{
+    CrucibleNodeStaging staging = { 0 };
+    GByteArray *payload;
+
+    g_assert(rule && before_hash && after_hash);
+    staging.rule = *rule;
+    node_sha256(rule->payload, rule->payload_len, staging.request_hash);
+    memcpy(staging.before_hash, before_hash, 32);
+    memcpy(staging.after_hash, after_hash, 32);
+    payload = g_byte_array_sized_new(
+        CRUCIBLE_NODE_FAULT_EVIDENCE_V1_BYTES);
+    node_encode_evidence(&staging, payload);
+    return payload;
+}
+
+static bool node_memory_gpa_is_ram(uint64_t start, uint64_t length)
+{
+    uint64_t current = start;
+    uint64_t remaining = length;
+
+    while (remaining != 0) {
+        hwaddr translated;
+        hwaddr available = remaining;
+        MemoryRegion *region = address_space_translate(
+            &address_space_memory, current, &translated, &available, false,
+            MEMTXATTRS_UNSPECIFIED);
+
+        if (!region || available == 0 || !memory_region_is_ram(region) ||
+            memory_region_is_ram_device(region) ||
+            memory_region_is_rom(region)) {
+            return false;
+        }
+        current += available;
+        remaining -= available;
+    }
+    return true;
+}
+
+static bool node_memory_translation_equal(
+    const CPUFaultTranslation *left, const CPUFaultTranslation *right)
+{
+    return left->physical_address == right->physical_address &&
+           left->page_size == right->page_size &&
+           memcmp(&left->attrs, &right->attrs, sizeof(left->attrs)) == 0 &&
+           left->readable == right->readable &&
+           left->writable == right->writable &&
+           left->executable == right->executable &&
+           left->user == right->user;
+}
+
+static void crucible_memory_translation_encode(
+    const CrucibleNodeTranslation *translation, uint8_t encoded[48]);
+
+static bool node_memory_translate_rule(QemuCrucibleFaultRule *rule,
+                                       CPUState *cpu, uint64_t address,
+                                       CPUFaultTranslation *result)
+{
+    const MMUAccessType access_types[] = {
+        MMU_INST_FETCH, MMU_DATA_LOAD, MMU_DATA_STORE,
+    };
+    uint32_t classes = 0;
+    bool required[3] = { true, true, true };
+    bool have_result = false;
+
+    if (rule->command_kind ==
+        CRUCIBLE_FAULT_COMMAND_MEMORY_ACCESS_TRANSFORM) {
+        g_assert(node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P8,
+                                &classes));
+        required[0] = classes & QEMU_CRUCIBLE_MEMORY_FETCH;
+        required[1] = classes & QEMU_CRUCIBLE_MEMORY_CPU_LOAD;
+        required[2] = classes & QEMU_CRUCIBLE_MEMORY_CPU_STORE;
+        if (!required[0] && !required[1] && !required[2]) {
+            return false;
+        }
+    }
+    for (size_t i = 0; i < G_N_ELEMENTS(access_types); i++) {
+        CPUFaultTranslation current;
+
+        if (!required[i]) {
+            continue;
+        }
+        if (!cpu_get_fault_translation(cpu, address, access_types[i],
+                                       &current)) {
+            if (rule->command_kind ==
+                CRUCIBLE_FAULT_COMMAND_MEMORY_ACCESS_TRANSFORM) {
+                return false;
+            }
+            continue;
+        }
+        if (!have_result) {
+            *result = current;
+            have_result = true;
+        } else if (!node_memory_translation_equal(result, &current)) {
+            return false;
+        }
+    }
+    return have_result;
+}
+
+static int node_memory_resolve_target(QemuCrucibleFaultRule *rule)
+{
+    g_autoptr(GChecksum) checksum = NULL;
+    uint64_t start, length;
+    uint32_t vcpu;
+    bool has_vcpu;
+
+    if (rule->target_kind != CRUCIBLE_NODE_FAULT_TARGET_MEMORY ||
+        !node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_T2, &start) ||
+        !node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_T5, &length) ||
+        !node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_T3, &has_vcpu) ||
+        !node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_T4, &vcpu)) {
+        return -EINVAL;
+    }
+    rule->translations = g_array_new(
+        false, false, sizeof(CrucibleNodeTranslation));
+    if (rule->command_kind == CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE) {
+        uint32_t region_kind;
+
+        g_assert(node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P3,
+                                &region_kind));
+        if (region_kind == 2) {
+            QDict *process = qobject_to(
+                QDict, node_field(rule,
+                    CRUCIBLE_NODE_FAULT_FIELD_P4)->json);
+            QDict *parameters = qdict_get_qdict(process, "parameters");
+            uint64_t interval;
+
+            if (length > CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT) {
+                return -ENOSPC;
+            }
+            /* Retention intervals are virtual-time durations, not icounts. */
+            rule->last_exposure_tick = node_virtual_now_tick();
+            interval = node_retention_interval_ticks(parameters);
+            if (rule->last_exposure_tick > UINT64_MAX - interval) {
+                return -ENOSPC;
+            }
+            rule->retention_next_tick = rule->last_exposure_tick + interval;
+            rule->exposure_initialized = true;
+            rule->retention_scheduled = true;
+        } else if (region_kind == 3) {
+            QDict *process = qobject_to(
+                QDict, node_field(rule,
+                    CRUCIBLE_NODE_FAULT_FIELD_P4)->json);
+            QDict *parameters = qdict_get_qdict(process, "parameters");
+            uint64_t row_bytes, records, evidence_bytes;
+            uint64_t aggressors, span;
+
+            g_assert(node_json_u64(qdict_get(parameters, "row_bytes"),
+                                   &row_bytes));
+            if (length > CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT) {
+                return -ENOSPC;
+            }
+            span = MIN(length, UINT64_C(4096));
+            aggressors = row_bytes < CRUCIBLE_DRAM_INTERLEAVE_BYTES ?
+                span / row_bytes + (span % row_bytes != 0) :
+                span / CRUCIBLE_DRAM_INTERLEAVE_BYTES +
+                    (span % CRUCIBLE_DRAM_INTERLEAVE_BYTES != 0);
+            records = row_bytes / CRUCIBLE_DRAM_INTERLEAVE_BYTES +
+                      (row_bytes % CRUCIBLE_DRAM_INTERLEAVE_BYTES != 0);
+            if (records > UINT64_MAX / 2) {
+                return -ENOSPC;
+            }
+            records *= 2;
+            if (aggressors != 0 &&
+                (records > UINT64_MAX / aggressors ||
+                 aggressors > UINT64_MAX / 64)) {
+                return -ENOSPC;
+            }
+            records *= aggressors;
+            if (records > (CRUCIBLE_FAULT_HARD_PAYLOAD_BYTES -
+                           (480 + 3 * 4096)) / 96) {
+                return -ENOSPC;
+            }
+            evidence_bytes = 480 + 3 * 4096 + records * 96;
+            if (evidence_bytes > UINT64_MAX - aggressors * 64) {
+                return -ENOSPC;
+            }
+            evidence_bytes += aggressors * 64;
+            if (evidence_bytes > CRUCIBLE_FAULT_HARD_PAYLOAD_BYTES) {
+                return -ENOSPC;
+            }
+        }
+    }
+    if (!has_vcpu) {
+        return node_memory_gpa_is_ram(start, length) ? 0 : -EFAULT;
+    }
+
+    CPUState *cpu = qemu_get_cpu(vcpu);
+    uint64_t current = start;
+    uint64_t remaining = length;
+
+    if (!cpu) {
+        return -ENOENT;
+    }
+    while (remaining != 0) {
+        CPUFaultTranslation resolved;
+        CrucibleNodeTranslation translation = { 0 };
+        uint64_t offset, available;
+
+        if (!node_memory_translate_rule(rule, cpu, current, &resolved) ||
+            resolved.page_size == 0) {
+            return -EFAULT;
+        }
+        offset = current % resolved.page_size;
+        if (offset > resolved.physical_address) {
+            return -EFAULT;
+        }
+        translation.virtual_page = current - offset;
+        translation.physical_page = resolved.physical_address - offset;
+        translation.page_size = resolved.page_size;
+        translation.attrs = resolved.attrs;
+        translation.readable = resolved.readable;
+        translation.writable = resolved.writable;
+        translation.executable = resolved.executable;
+        translation.user = resolved.user;
+        available = resolved.page_size - offset;
+        translation.covered_bytes = MIN(remaining, available);
+        if (!node_memory_gpa_is_ram(resolved.physical_address,
+                                    translation.covered_bytes)) {
+            return -EFAULT;
+        }
+        g_array_append_val(rule->translations, translation);
+        current += translation.covered_bytes;
+        remaining -= translation.covered_bytes;
+    }
+
+    checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    g_checksum_update(checksum, (const uint8_t *)"CRUCNTX1", 8);
+    for (guint i = 0; i < rule->translations->len; i++) {
+        CrucibleNodeTranslation *translation = &g_array_index(
+            rule->translations, CrucibleNodeTranslation, i);
+        uint8_t encoded[48];
+
+        crucible_memory_translation_encode(translation, encoded);
+        g_checksum_update(checksum, encoded, sizeof(encoded));
+    }
+    gsize digest_length = sizeof(rule->translation_hash);
+
+    g_checksum_get_digest(checksum, rule->translation_hash, &digest_length);
+    g_assert(digest_length == sizeof(rule->translation_hash));
+    return 0;
+}
+
+static int node_register_rejection_unchanged(
+    const uint8_t before[32],
+    struct qemu_plugin_crucible_fault_result *result)
+{
+    uint8_t after[32];
+
+    if (!before || !result ||
+        qemu_crucible_fault_register_state_fingerprint(after) != 0 ||
+        memcmp(before, after, sizeof(after)) != 0) {
+        return -EIO;
+    }
+    memcpy(result->before_hash, before, 32);
+    memcpy(result->after_hash, after, 32);
+    return 0;
+}
+
+static int node_staging_enter(
+    const struct qemu_plugin_crucible_fault_command *command,
+    const uint8_t *payload, size_t payload_len, CrucibleNodeStaging *staging,
+    QemuCrucibleFaultPendingCallback callback)
+{
+    QemuCrucibleFaultPendingControl *pending = NULL;
+    CrucibleNodeStorageControl *actual;
+    int status = qemu_crucible_fault_node_pending_callback_v1(
+        command, payload, payload_len, callback, &pending);
+
+    if (status || !node_storage_process_current()) {
+        return status ? status : -EPERM;
+    }
+    g_mutex_lock(&crucible_node_storage.lock);
+    actual = node_storage_find_locked(staging, CRUCIBLE_NODE_STORAGE_STAGING);
+    status = actual && actual->origin == pending->registration &&
+        pending->handler_state == staging && !actual->post_status ? 0 : -EPERM;
+    g_mutex_unlock(&crucible_node_storage.lock);
+    return status;
+}
+
+#include "crucible-fault-envelope.inc.h"
+
+static QemuCrucibleFaultEventReservation *node_event_reserve_owned(
+    size_t count, QemuCrucibleFaultRegistration *origin);
+
+static QemuCrucibleFaultEventReservation *node_staging_event_reserve(
+    CrucibleNodeStaging *staging, size_t count)
+{
+    QemuCrucibleFaultEventReservation *reservation =
+        node_event_reserve_owned(count, staging->storage.origin);
+
+    if (reservation &&
+        staging->rule.command_kind == CRUCIBLE_FAULT_COMMAND_NODE_HANG &&
+        !node_envelope_prepare(reservation, &staging->rule, 0)) {
+        qemu_crucible_fault_event_reservation_release(reservation);
+        return NULL;
+    }
+    return reservation;
+}
+
+static int node_prepare(
+    const struct qemu_plugin_crucible_fault_command *command,
+    const uint8_t *payload, size_t payload_len, void *state,
+    struct qemu_plugin_crucible_fault_result *result,
+    GByteArray *result_payload)
+{
+    g_auto(CrucibleNodeStorageOperation) operation =
+        node_storage_operation_begin();
+    CrucibleNodeStaging *staging = state;
+    uint8_t register_state_before[32] = { 0 };
+    uint8_t register_state_after_validation[32] = { 0 };
+    bool register_state_captured = false;
+    int status;
+
+    if (!operation.entered) {
+        return -EPERM;
+    }
+    status = node_staging_enter(command, payload, payload_len, staging,
+                                CRUCIBLE_PENDING_PREPARE);
+    if (status) {
+        return status;
+    }
+    /* Cross-grant service is limited to the serialized CPU byte ticket. */
+    if (staging->rule.command_kind ==
+            CRUCIBLE_FAULT_COMMAND_MEMORY_SERVICE &&
+        staging->rule.operation == CRUCIBLE_NODE_FAULT_OPERATION_UPSERT &&
+        !node_memory_service_actor_is_fw_cfg(&staging->rule) &&
+        crucible_sim_shmem_dispatch_registered()) {
+        uint64_t start, length;
+        uint32_t target_vcpu;
+        bool has_vcpu;
+
+        if (!node_rule_memory_range(&staging->rule, &start, &length) ||
+            length != 1 ||
+            !node_field_bool(&staging->rule,
+                             CRUCIBLE_NODE_FAULT_FIELD_T3, &has_vcpu) ||
+            !node_field_u32(&staging->rule,
+                            CRUCIBLE_NODE_FAULT_FIELD_T4, &target_vcpu) ||
+            !has_vcpu ||
+            !qemu_crucible_fault_cpu_memory_ticket_supported(
+                qemu_get_cpu(target_vcpu))) {
+            result->status = CRUCIBLE_FAULT_STATUS_UNSUPPORTED_CAPABILITY;
+            return -ENOTSUP;
+        }
+    }
+
+    if (staging->rule.command_kind ==
+            CRUCIBLE_FAULT_COMMAND_CPU_REGISTER_TRANSFORM) {
+        status = qemu_crucible_fault_register_state_fingerprint(
+            register_state_before);
+        if (status != 0) {
+            result->status = CRUCIBLE_FAULT_STATUS_INTERNAL_ERROR;
+            return status;
+        }
+        register_state_captured = true;
+    }
+
+    staging->prior = node_find_rule(staging->rule.command_kind,
+                                    staging->rule.binding_hash, NULL);
+    if (staging->prior &&
+        staging->rule.generation <= staging->prior->generation) {
+        if (register_state_captured &&
+            node_register_rejection_unchanged(
+                register_state_before, result) != 0) {
+            result->status = CRUCIBLE_FAULT_STATUS_INTERNAL_ERROR;
+            return -EIO;
+        }
+        result->status = CRUCIBLE_FAULT_STATUS_PRECONDITION_MISMATCH;
+        return -EINVAL;
+    }
+    if (staging->rule.operation == CRUCIBLE_NODE_FAULT_OPERATION_REMOVE &&
+        !staging->prior) {
+        if (register_state_captured &&
+            node_register_rejection_unchanged(
+                register_state_before, result) != 0) {
+            result->status = CRUCIBLE_FAULT_STATUS_INTERNAL_ERROR;
+            return -EIO;
+        }
+        result->status = CRUCIBLE_FAULT_STATUS_PRECONDITION_MISMATCH;
+        return -ENOENT;
+    }
+    if (staging->rule.operation == CRUCIBLE_NODE_FAULT_OPERATION_UPSERT &&
+        staging->rule.target_kind == CRUCIBLE_NODE_FAULT_TARGET_MEMORY) {
+        status = node_memory_resolve_target(&staging->rule);
+        if (status != 0) {
+            result->status = CRUCIBLE_FAULT_STATUS_INVALID_TARGET;
+            return status;
+        }
+        if (!node_memory_rule_admissible(&staging->rule)) {
+            result->status = CRUCIBLE_FAULT_STATUS_RESOURCE_LIMIT;
+            return -ENOSPC;
+        }
+    }
+    if (staging->rule.command_kind ==
+            CRUCIBLE_FAULT_COMMAND_CPU_REGISTER_TRANSFORM) {
+        status = qemu_crucible_fault_register_state_fingerprint(
+            register_state_before);
+        if (status != 0) {
+            result->status = CRUCIBLE_FAULT_STATUS_INTERNAL_ERROR;
+            return status;
+        }
+        status = qemu_crucible_fault_register_validate(&staging->rule);
+        if (qemu_crucible_fault_register_state_fingerprint(
+                register_state_after_validation) != 0 ||
+            memcmp(register_state_before, register_state_after_validation,
+                   sizeof(register_state_before)) != 0) {
+            result->status = CRUCIBLE_FAULT_STATUS_INTERNAL_ERROR;
+            return -EIO;
+        }
+        if (status != 0) {
+            memcpy(result->before_hash,
+                   register_state_before, 32);
+            memcpy(result->after_hash,
+                   register_state_after_validation, 32);
+            result->status = status == -ENOTSUP ?
+                CRUCIBLE_FAULT_STATUS_UNSUPPORTED_CAPABILITY :
+                CRUCIBLE_FAULT_STATUS_INVALID_TARGET;
+            return status;
+        }
+    }
+    if (staging->rule.command_kind ==
+            CRUCIBLE_FAULT_COMMAND_CPU_INSTRUCTION_TRANSFORM) {
+        status = qemu_crucible_fault_instruction_validate(&staging->rule);
+        if (status != 0) {
+            result->status = status == -ENOTSUP ?
+                CRUCIBLE_FAULT_STATUS_UNSUPPORTED_CAPABILITY :
+                CRUCIBLE_FAULT_STATUS_INVALID_TARGET;
+            return status;
+        }
+    }
+    if (staging->rule.command_kind == CRUCIBLE_FAULT_COMMAND_CPU_EXCEPTION) {
+        status = qemu_crucible_fault_exception_validate(&staging->rule);
+        if (status != 0) {
+            result->status = status == -ENOTSUP ?
+                CRUCIBLE_FAULT_STATUS_UNSUPPORTED_CAPABILITY :
+                CRUCIBLE_FAULT_STATUS_INVALID_TARGET;
+            return status;
+        }
+    }
+    if (staging->rule.command_kind ==
+            CRUCIBLE_FAULT_COMMAND_MEMORY_ECC_EVENT) {
+        status = qemu_crucible_fault_hardware_ecc_validate(&staging->rule);
+        if (status != 0) {
+            result->status = status == -ENOTSUP ?
+                CRUCIBLE_FAULT_STATUS_UNSUPPORTED_CAPABILITY :
+                CRUCIBLE_FAULT_STATUS_INVALID_TARGET;
+            return status;
+        }
+    }
+    if (staging->rule.command_kind ==
+            CRUCIBLE_FAULT_COMMAND_INTERRUPT_DISPOSITION ||
+        staging->rule.command_kind == CRUCIBLE_FAULT_COMMAND_INTERRUPT_STORM) {
+        status = qemu_crucible_fault_interrupt_validate(&staging->rule);
+        if (status != 0) {
+            result->status = status == -ENOTSUP ?
+                CRUCIBLE_FAULT_STATUS_UNSUPPORTED_CAPABILITY :
+                CRUCIBLE_FAULT_STATUS_INVALID_TARGET;
+            return status;
+        }
+    }
+    if (staging->rule.command_kind == CRUCIBLE_FAULT_COMMAND_CPU_SERVICE ||
+        staging->rule.command_kind == CRUCIBLE_FAULT_COMMAND_CPU_VCPU_STATE) {
+        status = qemu_crucible_fault_vcpu_service_validate(&staging->rule);
+        if (status != 0) {
+            result->status = status == -ENOTSUP ?
+                CRUCIBLE_FAULT_STATUS_UNSUPPORTED_CAPABILITY :
+                CRUCIBLE_FAULT_STATUS_INVALID_TARGET;
+            return status;
+        }
+    }
+    if (staging->rule.command_kind == CRUCIBLE_FAULT_COMMAND_NODE_LIFECYCLE ||
+        staging->rule.command_kind == CRUCIBLE_FAULT_COMMAND_NODE_HANG) {
+        status = qemu_crucible_fault_lifecycle_validate(&staging->rule);
+        if (status != 0) {
+            result->status = status == -ENOTSUP ?
+                CRUCIBLE_FAULT_STATUS_UNSUPPORTED_CAPABILITY :
+                CRUCIBLE_FAULT_STATUS_INVALID_TARGET;
+            return status;
+        }
+    }
+    if (staging->rule.command_kind ==
+            CRUCIBLE_FAULT_COMMAND_CLOCK_TRANSFORM ||
+        staging->rule.command_kind ==
+            CRUCIBLE_FAULT_COMMAND_CLOCK_SOURCE_STATE) {
+        status = qemu_crucible_fault_clock_validate(&staging->rule);
+        if (status != 0) {
+            result->status = status == -ENOTSUP ?
+                CRUCIBLE_FAULT_STATUS_UNSUPPORTED_CAPABILITY :
+                CRUCIBLE_FAULT_STATUS_INVALID_TARGET;
+            return status;
+        }
+    }
+    if (staging->rule.command_kind ==
+            CRUCIBLE_FAULT_COMMAND_ACCELERATOR_LIFECYCLE ||
+        staging->rule.command_kind ==
+            CRUCIBLE_FAULT_COMMAND_ACCELERATOR_RESULT_TRANSFORM ||
+        staging->rule.command_kind ==
+            CRUCIBLE_FAULT_COMMAND_ACCELERATOR_MEMORY_EVENT ||
+        staging->rule.command_kind ==
+            CRUCIBLE_FAULT_COMMAND_ACCELERATOR_SERVICE) {
+        status = qemu_crucible_fault_accelerator_validate(&staging->rule);
+        if (status != 0) {
+            result->status = status == -ENOTSUP ?
+                CRUCIBLE_FAULT_STATUS_UNSUPPORTED_CAPABILITY :
+                CRUCIBLE_FAULT_STATUS_INVALID_TARGET;
+            return status;
+        }
+    }
+    node_sha256(payload, payload_len, staging->request_hash);
+    node_rules_digest_with(NULL, false, staging->before_hash);
+    if (staging->rule.command_kind ==
+            CRUCIBLE_FAULT_COMMAND_NODE_LIFECYCLE &&
+        staging->rule.operation == CRUCIBLE_NODE_FAULT_OPERATION_APPLY) {
+        status = qemu_crucible_fault_lifecycle_precondition(
+            &staging->rule, staging->before_hash);
+        if (status != 0) {
+            result->status = CRUCIBLE_FAULT_STATUS_INTERNAL_ERROR;
+            return status;
+        }
+    }
+    if (command->command_flags & CRUCIBLE_FAULT_COMMAND_FLAG_PREPARE_ONLY) {
+        if (node_hash_nonzero(command->expected_precondition_hash)) {
+            if (register_state_captured &&
+                node_register_rejection_unchanged(
+                    register_state_before, result) != 0) {
+                result->status = CRUCIBLE_FAULT_STATUS_INTERNAL_ERROR;
+                return -EIO;
+            }
+            result->status = CRUCIBLE_FAULT_STATUS_MALFORMED_COMMAND;
+            return -EINVAL;
+        }
+    } else if (memcmp(command->expected_precondition_hash,
+                      staging->before_hash,
+                      sizeof(staging->before_hash)) != 0) {
+        if (register_state_captured) {
+            if (node_register_rejection_unchanged(
+                    register_state_before, result) != 0) {
+                result->status = CRUCIBLE_FAULT_STATUS_INTERNAL_ERROR;
+                return -EIO;
+            }
+        }
+        result->status = CRUCIBLE_FAULT_STATUS_PRECONDITION_MISMATCH;
+        return -ESTALE;
+    }
+    if (staging->rule.operation == CRUCIBLE_NODE_FAULT_OPERATION_UPSERT) {
+        node_rules_digest_with(&staging->rule, false, staging->after_hash);
+    } else if (staging->rule.operation ==
+               CRUCIBLE_NODE_FAULT_OPERATION_REMOVE) {
+        node_rules_digest_with(&staging->rule, true, staging->after_hash);
+    } else {
+        size_t event_budget =
+            staging->rule.command_kind ==
+                    CRUCIBLE_FAULT_COMMAND_CPU_INSTRUCTION_TRANSFORM ?
+                qemu_crucible_fault_instruction_event_budget(
+                    &staging->rule) : 1;
+
+        staging->event_reservation =
+            node_staging_event_reserve(staging, event_budget);
+        if (!staging->event_reservation) {
+            result->status = CRUCIBLE_FAULT_STATUS_RESOURCE_LIMIT;
+            return -ENOSPC;
+        }
+        memcpy(staging->after_hash, staging->before_hash, 32);
+    }
+    if ((staging->rule.operation ==
+             CRUCIBLE_NODE_FAULT_OPERATION_UPSERT ||
+         staging->rule.operation ==
+             CRUCIBLE_NODE_FAULT_OPERATION_REMOVE) &&
+        staging->rule.command_kind ==
+            CRUCIBLE_FAULT_COMMAND_CPU_VCPU_STATE) {
+        staging->event_reservation = node_staging_event_reserve(staging, 1);
+        if (!staging->event_reservation) {
+            result->status = CRUCIBLE_FAULT_STATUS_RESOURCE_LIMIT;
+            return -ENOSPC;
+        }
+    }
+    if ((staging->rule.operation ==
+             CRUCIBLE_NODE_FAULT_OPERATION_UPSERT ||
+         staging->rule.operation ==
+             CRUCIBLE_NODE_FAULT_OPERATION_REMOVE) &&
+        staging->rule.command_kind ==
+            CRUCIBLE_FAULT_COMMAND_CLOCK_SOURCE_STATE) {
+        size_t event_budget = qemu_crucible_fault_clock_event_budget(
+            &staging->rule);
+
+        if (event_budget != 0) {
+            staging->event_reservation =
+                node_staging_event_reserve(staging, event_budget);
+            if (!staging->event_reservation) {
+                result->status = CRUCIBLE_FAULT_STATUS_RESOURCE_LIMIT;
+                return -ENOSPC;
+            }
+        }
+    }
+    if (staging->rule.operation ==
+            CRUCIBLE_NODE_FAULT_OPERATION_UPSERT &&
+        staging->rule.command_kind ==
+            CRUCIBLE_FAULT_COMMAND_ACCELERATOR_LIFECYCLE) {
+        staging->event_reservation = node_staging_event_reserve(staging, 1);
+        if (!staging->event_reservation) {
+            result->status = CRUCIBLE_FAULT_STATUS_RESOURCE_LIMIT;
+            return -ENOSPC;
+        }
+    }
+    if (staging->rule.operation ==
+            CRUCIBLE_NODE_FAULT_OPERATION_UPSERT &&
+        staging->rule.command_kind == CRUCIBLE_FAULT_COMMAND_NODE_HANG) {
+        size_t event_budget =
+            qemu_crucible_fault_lifecycle_event_budget(&staging->rule);
+
+        staging->event_reservation =
+            node_staging_event_reserve(staging, event_budget);
+        if (!staging->event_reservation) {
+            result->status = CRUCIBLE_FAULT_STATUS_RESOURCE_LIMIT;
+            return -ENOSPC;
+        }
+    }
+    if (command->command_flags & CRUCIBLE_FAULT_COMMAND_FLAG_PREPARE_ONLY) {
+        /* Preparation authenticates frozen current state without mutation. */
+        memcpy(staging->after_hash, staging->before_hash, 32);
+    }
+    memcpy(result->before_hash, staging->before_hash, 32);
+    memcpy(result->after_hash, staging->after_hash, 32);
+    node_encode_evidence(staging, result_payload);
+    node_sha256(result_payload->data, result_payload->len,
+                result->evidence_hash);
+    return 0;
+}
+
+static void node_event_enqueue(const QemuCrucibleFaultRule *rule,
+                               uint16_t outcome, uint64_t observed_icount,
+                               const uint8_t opportunity_hash[32],
+                               const uint8_t before_hash[32],
+                               const uint8_t after_hash[32],
+                               const uint8_t *evidence, size_t evidence_len);
+
+static void node_event_enqueue_owned(const QemuCrucibleFaultRule *rule,
+                               uint16_t outcome, uint64_t observed_icount,
+                               const uint8_t opportunity_hash[32],
+                               const uint8_t before_hash[32],
+                               const uint8_t after_hash[32],
+                               const uint8_t *evidence, size_t evidence_len,
+                               QemuCrucibleFaultEventReservation *reservation)
+{
+    g_auto(CrucibleNodeStorageOperation) operation = node_storage_operation_begin();
+    uint8_t terminal_evidence[128] = { 0 };
+    uint8_t envelope_header[CRUCIBLE_NODE_EVENT_ENVELOPE_HEADER_BYTES] = { 0 };
+    g_autoptr(GByteArray) envelope = NULL;
+    bool terminal = false;
+    CrucibleNodeEvent *queued;
+    int64_t observed_tick = qemu_plugin_sim_tick_observed();
+
+    if (!operation.entered) {
+        error_report("Crucible event publication lost its actual storage operation");
+        abort();
+    }
+    if (observed_tick < 0) {
+        error_report("Crucible fault event observed invalid logical tick");
+        abort();
+    }
+
+    node_events_ensure();
+    if (crucible_node_event_terminal) {
+        return;
+    }
+    if (crucible_node_event_sequence_reserved >=
+            UINT64_MAX - 1 - crucible_node_event_sequence) {
+        crucible_node_terminal_resource_kind =
+            CRUCIBLE_NODE_RESOURCE_COUNTER;
+        crucible_node_terminal_current =
+            crucible_node_event_sequence +
+            crucible_node_event_sequence_reserved;
+        crucible_node_terminal_requested = UINT64_MAX;
+        crucible_node_terminal_configured = UINT64_MAX;
+        crucible_node_terminal_hard = UINT64_MAX;
+        crucible_node_event_force_terminal = true;
+    }
+    if (crucible_node_event_force_terminal ||
+        crucible_node_event_count + crucible_node_event_reserved >=
+            CRUCIBLE_NODE_EVENT_CAPACITY - 1 ||
+        evidence_len == 0 || evidence_len > CRUCIBLE_FAULT_HARD_PAYLOAD_BYTES) {
+        uint8_t attempted_hash[32];
+
+        memcpy(terminal_evidence,
+               crucible_node_terminal_resource_kind ? "CRUCLIM1" :
+                                                      "CRUCQFL1",
+               8);
+        stl_le_p(terminal_evidence + 8,
+                 crucible_node_event_force_terminal ? 3 :
+                 (crucible_node_event_count +
+                      crucible_node_event_reserved >=
+                  CRUCIBLE_NODE_EVENT_CAPACITY - 1 ? 1 : 2));
+        stl_le_p(terminal_evidence + 12,
+                 crucible_node_event_count +
+                 crucible_node_event_reserved);
+        stl_le_p(terminal_evidence + 16, CRUCIBLE_NODE_EVENT_CAPACITY);
+        stw_le_p(terminal_evidence + 20, outcome);
+        stq_le_p(terminal_evidence + 24, evidence_len);
+        stw_le_p(terminal_evidence + 64,
+                 crucible_node_terminal_resource_kind);
+        stw_le_p(terminal_evidence + 66, 1);
+        stq_le_p(terminal_evidence + 72,
+                 crucible_node_terminal_current);
+        stq_le_p(terminal_evidence + 80,
+                 crucible_node_terminal_requested);
+        stq_le_p(terminal_evidence + 88,
+                 crucible_node_terminal_configured);
+        stq_le_p(terminal_evidence + 96,
+                 crucible_node_terminal_hard);
+        node_sha256(evidence, evidence_len, attempted_hash);
+        memcpy(terminal_evidence + 32, attempted_hash,
+               sizeof(attempted_hash));
+        evidence = terminal_evidence;
+        evidence_len = sizeof(terminal_evidence);
+        outcome = CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR;
+        crucible_node_event_terminal = true;
+        crucible_node_event_force_terminal = false;
+        crucible_node_terminal_resource_kind = 0;
+        terminal = true;
+    }
+    memcpy(envelope_header, CRUCIBLE_NODE_EVENT_ENVELOPE_MAGIC, 8);
+    stw_le_p(envelope_header + 8, 1);
+    stl_le_p(envelope_header + 12, rule->payload_len);
+    stl_le_p(envelope_header + 16, evidence_len);
+    node_sha256(rule->payload, rule->payload_len, envelope_header + 24);
+    node_sha256(evidence, evidence_len, envelope_header + 56);
+    memcpy(envelope_header + 88, rule->binding_hash, 32);
+    stq_le_p(envelope_header + 120, rule->command_sequence);
+    memcpy(envelope_header + 128, rule->target_node_hash, 32);
+    memcpy(envelope_header + 160, rule->opportunity_hash, 32);
+    queued = QTAILQ_FIRST(&crucible_node_free_events);
+    g_assert(queued);
+    g_assert(crucible_node_event_sequence != UINT64_MAX);
+    size_t envelope_length = sizeof(envelope_header) + rule->payload_len + evidence_len;
+    CrucibleNodeEnvelope *owned = NULL;
+
+    g_assert(envelope_length <= CRUCIBLE_NODE_EVENT_ENVELOPE_MAX_BYTES);
+    if (rule->command_kind == CRUCIBLE_FAULT_COMMAND_NODE_HANG) {
+        if (reservation) {
+            owned = node_envelope_emit(reservation, queued, rule, envelope_length);
+        } else if (terminal) {
+            QemuCrucibleFaultRegistration *origin = NULL;
+
+            /* Preserve the existing dedicated emergency row. Cross-family
+             * failures can name the real transition rule outside its normal
+             * 2/3-event plan. This is explicit ordinary emergency allocation. */
+            if (node_storage_rule_origin(rule, &origin)) {
+                owned = node_envelope_new(origin, queued, rule->payload,
+                    rule->payload_len, rule->command_sequence,
+                    CRUCIBLE_NODE_ENVELOPE_EMERGENCY_ROLE, envelope_length);
+            }
+        }
+        if (!owned) {
+            error_report("Crucible hang event lost its exact prepaid envelope");
+            abort();
+        }
+        memcpy(owned->bytes, envelope_header, sizeof(envelope_header));
+        memcpy(owned->bytes + sizeof(envelope_header), rule->payload, rule->payload_len);
+        memcpy(owned->bytes + sizeof(envelope_header) + rule->payload_len,
+               evidence, evidence_len);
+    } else {
+        envelope = g_byte_array_sized_new(envelope_length);
+        g_byte_array_append(envelope, envelope_header, sizeof(envelope_header));
+        g_byte_array_append(envelope, rule->payload, rule->payload_len);
+        g_byte_array_append(envelope, evidence, evidence_len);
+    }
+    QTAILQ_REMOVE(&crucible_node_free_events, queued, link);
+    memset(&queued->event, 0, sizeof(queued->event));
+    queued->event.command_kind = rule->command_kind;
+    queued->event.outcome = outcome;
+    queued->event.model_phase = rule->model_phase;
+    queued->event.target_kind = rule->target_kind;
+    queued->event.evidence_length = evidence_len;
+    queued->event.event_sequence = ++crucible_node_event_sequence;
+    queued->event.rule_command_sequence = rule->command_sequence;
+    queued->event.observed_icount = observed_icount;
+    queued->event.observed_tick = observed_tick;
+    queued->event.generation = rule->generation;
+    memcpy(queued->event.binding_hash, rule->binding_hash, 32);
+    memcpy(queued->event.opportunity_hash, opportunity_hash, 32);
+    memcpy(queued->event.action_hash, rule->action_hash, 32);
+    memcpy(queued->event.target_hash, rule->target_hash, 32);
+    memcpy(queued->event.before_hash, before_hash, 32);
+    memcpy(queued->event.after_hash, after_hash, 32);
+    queued->payload_length = envelope_length;
+    if (owned) {
+        queued->payload = NULL;
+    } else if (envelope->len <= sizeof(queued->inline_payload)) {
+        queued->payload = NULL;
+        memcpy(queued->inline_payload, envelope->data, envelope->len);
+    } else {
+        queued->payload = g_steal_pointer(&envelope);
+    }
+    QTAILQ_INSERT_TAIL(&crucible_node_events, queued, link);
+    crucible_node_event_count++;
+    if (terminal) {
+        qemu_crucible_fault_instruction_event_terminal();
+        qemu_crucible_fault_interrupt_event_terminal();
+        qemu_crucible_fault_hardware_error_event_terminal();
+        qemu_crucible_fault_vcpu_service_event_terminal();
+        qemu_crucible_fault_clock_event_terminal();
+        qemu_crucible_fault_accelerator_event_terminal();
+        qemu_crucible_fault_notify_events();
+        qemu_system_vmstop_request_prepare();
+        qemu_system_vmstop_request(RUN_STATE_INTERNAL_ERROR);
+    }
+}
+
+void qemu_crucible_fault_internal_terminal(
+    const QemuCrucibleFaultRule *rule, uint16_t subsystem)
+{
+    uint8_t evidence[32] = { 0 };
+    uint8_t hashes[32] = { 0 };
+
+    if (crucible_node_event_terminal || !rule) {
+        qemu_crucible_fault_notify_events();
+        qemu_system_vmstop_request_prepare();
+        qemu_system_vmstop_request(RUN_STATE_INTERNAL_ERROR);
+        return;
+    }
+    memcpy(evidence, "CRUCFAT1", 8);
+    stw_le_p(evidence + 8, 1);
+    stw_le_p(evidence + 10, subsystem);
+    stq_le_p(evidence + 16, qemu_crucible_fault_observed_icount());
+    crucible_node_terminal_resource_kind =
+        CRUCIBLE_NODE_RESOURCE_ARITHMETIC;
+    crucible_node_terminal_current = 0;
+    crucible_node_terminal_requested = 1;
+    crucible_node_terminal_configured = UINT64_MAX;
+    crucible_node_terminal_hard = UINT64_MAX;
+    crucible_node_event_force_terminal = true;
+    node_event_enqueue(
+        rule, CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR,
+        qemu_crucible_fault_observed_icount(), hashes, hashes, hashes,
+        evidence, sizeof(evidence));
+}
+
+static void node_event_enqueue(const QemuCrucibleFaultRule *rule,
+                               uint16_t outcome, uint64_t observed_icount,
+                               const uint8_t opportunity_hash[32],
+                               const uint8_t before_hash[32],
+                               const uint8_t after_hash[32],
+                               const uint8_t *evidence, size_t evidence_len)
+{
+    node_event_enqueue_owned(rule, outcome, observed_icount, opportunity_hash,
+                             before_hash, after_hash, evidence, evidence_len, NULL);
+}
+
+static void node_commit(
+    const struct qemu_plugin_crucible_fault_command *command,
+    const uint8_t *payload, size_t payload_len, void *state,
+    struct qemu_plugin_crucible_fault_result *result,
+    GByteArray *result_payload)
+{
+    g_auto(CrucibleNodeStorageOperation) operation =
+        node_storage_operation_begin();
+    CrucibleNodeStaging *staging = state;
+    guint index;
+
+    if (!operation.entered ||
+        node_staging_enter(command, payload, payload_len, staging,
+                           CRUCIBLE_PENDING_COMMIT)) {
+        error_report("Crucible node commit lost its actual entered staging owner");
+        abort();
+    }
+    if (staging->rule.operation == CRUCIBLE_NODE_FAULT_OPERATION_UPSERT) {
+        QemuCrucibleFaultRule *replacement = node_rule_copy(&staging->rule);
+
+        if (!node_memory_service_ledger_acquire(replacement)) {
+            error_report("Crucible memory service scope lost after prepare");
+            abort();
+        }
+        if (node_find_rule(replacement->command_kind,
+                           replacement->binding_hash, &index)) {
+            g_ptr_array_remove_index(crucible_node_rules, index);
+        }
+        g_ptr_array_add(crucible_node_rules, replacement);
+        g_ptr_array_sort(crucible_node_rules, node_rule_compare);
+        node_memory_index_rebuild();
+        if (staging->rule.command_kind ==
+            CRUCIBLE_FAULT_COMMAND_CPU_INSTRUCTION_TRANSFORM) {
+            qemu_crucible_fault_instruction_rules_changed();
+        }
+        qemu_crucible_fault_interrupt_rules_changed();
+        qemu_crucible_fault_vcpu_service_rules_changed(
+            &staging->rule, &staging->event_reservation);
+        qemu_crucible_fault_lifecycle_rules_changed(
+            &staging->rule, &staging->event_reservation);
+        qemu_crucible_fault_clock_rules_changed(
+            &staging->rule,
+            &staging->event_reservation);
+        qemu_crucible_fault_accelerator_rules_changed(
+            &staging->rule, &staging->event_reservation);
+        if (staging->event_reservation) {
+            qemu_crucible_fault_event_reservation_release(
+                staging->event_reservation);
+            staging->event_reservation = NULL;
+        }
+        node_memory_retention_deadline_recompute();
+    } else if (staging->rule.operation ==
+               CRUCIBLE_NODE_FAULT_OPERATION_REMOVE) {
+        g_assert(node_find_rule(staging->rule.command_kind,
+                                staging->rule.binding_hash, &index));
+        g_ptr_array_remove_index(crucible_node_rules, index);
+        node_memory_index_rebuild();
+        if (staging->rule.command_kind ==
+            CRUCIBLE_FAULT_COMMAND_CPU_INSTRUCTION_TRANSFORM) {
+            qemu_crucible_fault_instruction_rules_changed();
+        }
+        qemu_crucible_fault_interrupt_rules_changed();
+        qemu_crucible_fault_vcpu_service_rules_changed(
+            &staging->rule, &staging->event_reservation);
+        qemu_crucible_fault_lifecycle_rules_changed(
+            &staging->rule, &staging->event_reservation);
+        qemu_crucible_fault_clock_rules_changed(
+            &staging->rule,
+            &staging->event_reservation);
+        qemu_crucible_fault_accelerator_rules_changed(
+            &staging->rule, &staging->event_reservation);
+        if (staging->event_reservation) {
+            qemu_crucible_fault_event_reservation_release(
+                staging->event_reservation);
+            staging->event_reservation = NULL;
+        }
+        node_memory_retention_deadline_recompute();
+    } else {
+        uint8_t opportunity_hash[32];
+
+        staging->impulse_evidence = g_byte_array_new();
+        staging->impulse_outcome = CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED;
+        if (staging->impulse) {
+            int status = staging->impulse(
+                &staging->rule, result->observed_icount,
+                staging->before_hash, staging->after_hash,
+                staging->impulse_evidence, &staging->impulse_outcome,
+                &staging->event_reservation);
+            if (status != 0 &&
+                status != QEMU_CRUCIBLE_FAULT_IMPULSE_DEFERRED &&
+                status != QEMU_CRUCIBLE_FAULT_IMPULSE_ARMED) {
+                error_report(
+                    "Crucible prepared node impulse failed during commit");
+                abort();
+            }
+            if (status == QEMU_CRUCIBLE_FAULT_IMPULSE_DEFERRED) {
+                g_byte_array_set_size(result_payload, 0);
+                memcpy(result->before_hash, staging->before_hash, 32);
+                memcpy(result->after_hash, staging->before_hash, 32);
+                result->status =
+                    QEMU_CRUCIBLE_FAULT_STATUS_DEFERRED_INTERNAL;
+                result->applied_icount = 0;
+                return;
+            }
+            if (status == QEMU_CRUCIBLE_FAULT_IMPULSE_ARMED) {
+                g_assert(!staging->event_reservation);
+                g_byte_array_set_size(result_payload, 0);
+                node_encode_evidence(staging, result_payload);
+                node_sha256(result_payload->data, result_payload->len,
+                            result->evidence_hash);
+                memcpy(result->before_hash, staging->before_hash, 32);
+                memcpy(result->after_hash, staging->after_hash, 32);
+                result->status = CRUCIBLE_FAULT_STATUS_APPLIED;
+                result->applied_icount = result->observed_icount;
+                return;
+            }
+        }
+        if (staging->impulse_evidence->len == 0) {
+            g_byte_array_append(staging->impulse_evidence,
+                                staging->request_hash, 32);
+        }
+        node_sha256(staging->impulse_evidence->data,
+                    staging->impulse_evidence->len, opportunity_hash);
+        qemu_crucible_fault_event_reservation_consume(
+            staging->event_reservation);
+        node_event_enqueue(&staging->rule, staging->impulse_outcome,
+                           result->observed_icount, opportunity_hash,
+                           staging->before_hash, staging->after_hash,
+                           staging->impulse_evidence->data,
+                           staging->impulse_evidence->len);
+        qemu_crucible_fault_event_reservation_release(
+            staging->event_reservation);
+        staging->event_reservation = NULL;
+        g_byte_array_set_size(result_payload, 0);
+        node_encode_evidence(staging, result_payload);
+        node_sha256(result_payload->data, result_payload->len,
+                    result->evidence_hash);
+        memcpy(result->before_hash, staging->before_hash, 32);
+        memcpy(result->after_hash, staging->after_hash, 32);
+    }
+    result->status = CRUCIBLE_FAULT_STATUS_APPLIED;
+    result->applied_icount = result->observed_icount;
+}
+
+bool qemu_crucible_fault_node_register(uint16_t command_kind, uint16_t scope,
+                                       uint32_t phase_mask, const char *name,
+                                       QemuCrucibleFaultImpulseFn impulse)
+{
+    CrucibleNodeOwnedHandler *producer;
+    QemuCrucibleFaultRegistration *registration;
+    QemuCrucibleFaultHandler *handler;
+    int status;
+
+    /* No actual selected producer pays this allocation or registry storage.
+     * Refuse before the unselected allocator, not after a nominal owner birth. */
+    if (qemu_plugin_crucible_startup_source_retained() ||
+        !node_registration_process_current()) {
+        return false;
+    }
+    g_mutex_lock(&crucible_node_registrations.lock);
+    if (command_kind == CRUCIBLE_FAULT_COMMAND_NODE_HANG &&
+        (crucible_node_registrations.hang_retired ||
+         crucible_node_registrations.returning.active)) {
+        g_mutex_unlock(&crucible_node_registrations.lock);
+        return false;
+    }
+    g_mutex_unlock(&crucible_node_registrations.lock);
+    producer = g_new0(CrucibleNodeOwnedHandler, 1);
+    registration = &producer->registration;
+    handler = &producer->handler;
+    registration->holder = registration;
+    registration->impulse = impulse;
+    registration->process = getpid();
+    qemu_thread_get_self(&registration->creator);
+
+    handler->capability.command_kind = command_kind;
+    handler->capability.scope = scope;
+    handler->capability.semantic_version =
+        CRUCIBLE_FAULT_COMMAND_SEMANTIC_VERSION;
+    handler->capability.phase_mask = phase_mask;
+    handler->capability.maximum_payload_bytes =
+        CRUCIBLE_FAULT_HARD_PAYLOAD_BYTES;
+    handler->capability.maximum_pending_commands =
+        CRUCIBLE_FAULT_DEFAULT_COMMAND_CAPACITY;
+    switch (command_kind) {
+    case CRUCIBLE_FAULT_COMMAND_CPU_REGISTER_TRANSFORM:
+        handler->capability.required_feature_bits =
+            CRUCIBLE_FAULT_CAPABILITY_FEATURE_REGISTER_MUTATION;
+        break;
+    case CRUCIBLE_FAULT_COMMAND_INTERRUPT_DISPOSITION:
+    case CRUCIBLE_FAULT_COMMAND_INTERRUPT_STORM:
+        handler->capability.required_feature_bits =
+            CRUCIBLE_FAULT_CAPABILITY_FEATURE_INTERRUPT;
+        break;
+    case CRUCIBLE_FAULT_COMMAND_CPU_INSTRUCTION_TRANSFORM:
+        handler->capability.required_feature_bits =
+            CRUCIBLE_FAULT_CAPABILITY_FEATURE_INSTRUCTION;
+        break;
+    case CRUCIBLE_FAULT_COMMAND_CPU_EXCEPTION:
+        handler->capability.required_feature_bits =
+            CRUCIBLE_FAULT_CAPABILITY_FEATURE_INSTRUCTION |
+            CRUCIBLE_FAULT_CAPABILITY_FEATURE_HARDWARE_ERROR;
+        break;
+    case CRUCIBLE_FAULT_COMMAND_MEMORY_ECC_EVENT:
+        handler->capability.required_feature_bits =
+            CRUCIBLE_FAULT_CAPABILITY_FEATURE_HARDWARE_ERROR;
+        break;
+    case CRUCIBLE_FAULT_COMMAND_CPU_SERVICE:
+    case CRUCIBLE_FAULT_COMMAND_CPU_VCPU_STATE:
+        handler->capability.required_feature_bits =
+            CRUCIBLE_FAULT_CAPABILITY_FEATURE_VCPU_SERVICE;
+        break;
+    case CRUCIBLE_FAULT_COMMAND_NODE_LIFECYCLE:
+    case CRUCIBLE_FAULT_COMMAND_NODE_HANG:
+        handler->capability.required_feature_bits =
+            CRUCIBLE_FAULT_CAPABILITY_FEATURE_NODE_LIFECYCLE;
+        break;
+    case CRUCIBLE_FAULT_COMMAND_CLOCK_TRANSFORM:
+    case CRUCIBLE_FAULT_COMMAND_CLOCK_SOURCE_STATE:
+        handler->capability.required_feature_bits =
+            CRUCIBLE_FAULT_CAPABILITY_FEATURE_GUEST_CLOCK;
+        break;
+    case CRUCIBLE_FAULT_COMMAND_MEMORY_ACCESS_TRANSFORM:
+    case CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE:
+    case CRUCIBLE_FAULT_COMMAND_MEMORY_SERVICE:
+        handler->capability.required_feature_bits =
+            CRUCIBLE_FAULT_CAPABILITY_FEATURE_MEMORY_ACCESS;
+        break;
+    default:
+        handler->capability.required_feature_bits = 0;
+        break;
+    }
+    handler->capability.name = name;
+    switch (command_kind) {
+    case CRUCIBLE_FAULT_COMMAND_CPU_REGISTER_TRANSFORM:
+        handler->capability.payload_schema =
+            "crucible.node-fault-payload.v1";
+        break;
+    case CRUCIBLE_FAULT_COMMAND_CPU_INSTRUCTION_TRANSFORM:
+        handler->capability.payload_schema =
+            "crucible.node-fault-payload.v1;"
+            "instruction-classes=x86.integer(89,8b,01,03,29,2b,31,33,"
+            "39,3b,85,b8-bf,c7,ff/0-1),x86.control-flow(70-7f,80-8f,"
+            "e8,e9,eb,c2,c3,ca,cb,cf,ff/2-5),x86.load(8b,03,2b,33,"
+            "0fb6-0fb7,0fbe-0fbf,ff/6,sse-load),x86.store(89,01,29,31,"
+            "c7,ff/0-1,sse-store),x86.atomic(86,87,0fb0-0fb1,0fc0-0fc1),"
+            "x86.fp-simd(0f10-11,0f28-29,0f58-59,0f5c,0f5e,"
+            "66-or-f3-0f6f-7f),x86.exception(cc,cd,ce,f1,0f0b),"
+            "x86.device-io(e4-e7,ec-ef),aarch64.integer(data-processing),"
+            "aarch64.control-flow(branch),aarch64.load-store,"
+            "aarch64.atomic,"
+            "aarch64.fp-simd,aarch64.exception;replay-max=256";
+        break;
+    case CRUCIBLE_FAULT_COMMAND_CPU_EXCEPTION:
+        handler->capability.payload_schema =
+            "crucible.node-fault-payload.v1;"
+            "exception-records=architecture-default;"
+            "hardware-error-classes=manifest-v1";
+        break;
+    case CRUCIBLE_FAULT_COMMAND_MEMORY_ECC_EVENT:
+        handler->capability.payload_schema =
+            "crucible.node-fault-payload.v1;hardware-error-manifest=v1";
+        break;
+    case CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE:
+        handler->capability.payload_schema =
+            "crucible.node-fault-payload.v1;dram=2c2r16b64;"
+            "page-table-walk=x86_64,aarch64";
+        break;
+    case CRUCIBLE_FAULT_COMMAND_MEMORY_ACCESS_TRANSFORM:
+        handler->capability.payload_schema =
+            "crucible.node-fault-payload.v1;atomic-widths=1,2,4,8,16;"
+            "page-table-walk=x86_64,aarch64";
+        break;
+    case CRUCIBLE_FAULT_COMMAND_MEMORY_SERVICE:
+        handler->capability.payload_schema =
+            "crucible.node-fault-payload.v1;"
+            "page-table-walk=x86_64,aarch64;latency-unit=ps;"
+            "actor=cpu-all,cpu-single-access,fw-cfg-payload";
+        break;
+    default:
+        handler->capability.payload_schema =
+            "crucible.node-fault-payload.v1;"
+            "page-table-walk=x86_64,aarch64";
+        break;
+    }
+    handler->validate = node_validate;
+    handler->arm = node_arm;
+    handler->prepare = node_prepare;
+    handler->commit = node_commit;
+    handler->free_state = (QemuCrucibleFaultFreeFn)node_staging_clear;
+    g_mutex_lock(&crucible_node_registrations.lock);
+    registration->next = crucible_node_registrations.head;
+    crucible_node_registrations.head = registration;
+    registration->issuing = true;
+    g_mutex_unlock(&crucible_node_registrations.lock);
+
+    status = qemu_crucible_fault_register_node_owned_v1(
+        registration, &registration->holder);
+    g_mutex_lock(&crucible_node_registrations.lock);
+    registration->first_status = status;
+    if (!status) {
+        registration->registry_published = true;
+    }
+    registration->attempt_returned = true;
+    registration->issuing = false;
+    g_mutex_unlock(&crucible_node_registrations.lock);
+    /* The real producer/handler/impulse and registry edge remain permanently
+     * retained. This result is not a byte grant or a physical return receipt. */
+    return !status;
+}
+
+static void node_rule_visit_owned(QemuCrucibleFaultRule *rule,
+    QemuCrucibleFaultRuleVisitFn visit, void *opaque)
+{
+    QemuCrucibleFaultRegistration *origin;
+    CrucibleNodeRegistrationChild *child = NULL;
+
+    if (!node_storage_rule_origin(rule, &origin) ||
+        node_registration_child_acquire(origin, CRUCIBLE_NODE_STORAGE_KINDS + 1,
+                                        &child)) {
+        error_report("Crucible rule reader lost its actual parent");
+        abort();
+    }
+    node_rule_ref(rule);
+    if (child) {
+        g_mutex_lock(&crucible_node_registrations.lock);
+        child->resource = rule;
+        child->visit = visit;
+        child->opaque = opaque;
+        child->born = true;
+        child->callback_entered = true;
+        g_mutex_unlock(&crucible_node_registrations.lock);
+    }
+
+    visit(rule, opaque);
+
+    if (child) {
+        g_mutex_lock(&crucible_node_registrations.lock);
+        child->callback_returned = true;
+        g_mutex_unlock(&crucible_node_registrations.lock);
+    }
+    node_rule_unref(rule);
+    if (child) {
+        g_mutex_lock(&crucible_node_registrations.lock);
+        child->post_status = child->process == getpid() &&
+            qemu_thread_is_self(&child->thread) && child->visit == visit &&
+            child->opaque == opaque && child->resource == rule &&
+            !child->parent->closing ? 0 : -EPERM;
+        child->callback_post_returned = true;
+        g_mutex_unlock(&crucible_node_registrations.lock);
+    }
+}
+
+void qemu_crucible_fault_rule_foreach(uint16_t command_kind,
+                                      QemuCrucibleFaultRuleVisitFn visit,
+                                      void *opaque)
+{
+    g_auto(CrucibleNodeStorageOperation) operation = node_storage_operation_begin();
+
+    if (!operation.entered || !visit) {
+        return;
+    }
+    node_rules_ensure();
+    for (guint i = 0; i < crucible_node_rules->len; i++) {
+        QemuCrucibleFaultRule *rule = g_ptr_array_index(crucible_node_rules, i);
+        if (rule->command_kind == command_kind) {
+            node_rule_visit_owned(rule, visit, opaque);
+        }
+    }
+}
