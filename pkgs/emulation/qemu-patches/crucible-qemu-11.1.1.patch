+static inline int qemu_crucible_shared_region_layout_compute(
+    uint32_t vm_count, uint32_t frame_queue_capacity,
+    uint32_t fault_payload_arena_bytes, QemuCrucibleSharedRegionLayout *out)
+{
+    if (!out || vm_count > CRUCIBLE_SHMEM_MAX_VM_NODES ||
+        !frame_queue_capacity || (frame_queue_capacity & (frame_queue_capacity - 1)) ||
+        fault_payload_arena_bytes < CRUCIBLE_FAULT_DEFAULT_PAYLOAD_ARENA_BYTES ||
+        fault_payload_arena_bytes > CRUCIBLE_FAULT_HARD_PAYLOAD_ARENA_BYTES) {
+        return -EINVAL;
+    }
+
+    out->node_slots_offset = UINT64_C(256);
+
+    out->node_slots_extent = UINT64_C(32) * UINT64_C(768);
+
+    if (out->node_slots_extent > UINT64_MAX - out->node_slots_offset) {
+        return -EOVERFLOW;
+    }
+    out->frame_ring_headers_offset = out->node_slots_offset + out->node_slots_extent;
+
+    out->frame_ring_count = (uint64_t)vm_count * UINT64_C(6);
+
+    if (UINT64_C(128) && out->frame_ring_count > UINT64_MAX / UINT64_C(128)) {
+        return -EOVERFLOW;
+    }
+    out->frame_ring_headers_extent = out->frame_ring_count * UINT64_C(128);
+
+    if (out->frame_ring_headers_extent > UINT64_MAX - out->frame_ring_headers_offset) {
+        return -EOVERFLOW;
+    }
+    out->frame_ring_data_offset = out->frame_ring_headers_offset + out->frame_ring_headers_extent;
+
+    if ((uint64_t)frame_queue_capacity && out->frame_ring_count > UINT64_MAX / (uint64_t)frame_queue_capacity) {
+        return -EOVERFLOW;
+    }
+    out->frame_entries_count = out->frame_ring_count * (uint64_t)frame_queue_capacity;
+
+    if (UINT64_C(4640) && out->frame_entries_count > UINT64_MAX / UINT64_C(4640)) {
+        return -EOVERFLOW;
+    }
+    out->frame_entries_extent = out->frame_entries_count * UINT64_C(4640);
+
+    if (out->frame_entries_extent > UINT64_MAX - out->frame_ring_data_offset) {
+        return -EOVERFLOW;
+    }
+    out->frame_data_end = out->frame_ring_data_offset + out->frame_entries_extent;
+
+    if (out->frame_data_end > UINT64_MAX - UINT64_C(127)) {
+        return -EOVERFLOW;
+    }
+    out->coverage_headers_offset = (out->frame_data_end + UINT64_C(127)) & ~UINT64_C(127);
