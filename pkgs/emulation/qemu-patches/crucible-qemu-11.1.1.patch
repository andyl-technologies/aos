+static bool command_receive_progress_valid(const QemuCrucibleCommandReceiveProgress *progress,
+                                           int reader_status)
+{
+    if (progress->first_status > 0 || progress->post_status > 0 || reader_status > 0 ||
+        progress->read_attempted > 1 || progress->request_received > 1 ||
+        progress->reader_released > 1 ||
+        (progress->request_received && !progress->read_attempted) ||
+        (progress->reader_released && !progress->read_attempted)) {
+        return false;
+    }
+    /* Before-entry refusal has no local reader to release. A silent all-zero
+     * output cannot certify that the genuinely registered reader ran. */
+    return progress->read_attempted || (progress->first_status < 0 && reader_status < 0);
+}
+
+static int command_receive_result_locked(QemuCrucibleCommandReceiveOwner *owner)
+{
+    /* Keep the reader's initiating cause before synthesized uncertainty.
+     * Its independent post precedes protocol validation and Source post. */
+    if (owner->progress.first_status < 0) {
+        return owner->progress.first_status;
+    }
+    if (owner->reader_status < 0) {
+        return owner->reader_status;
+    }
+    if (owner->first_status) {
+        return owner->first_status;
+    }
+    if (owner->progress.post_status < 0) {
+        return owner->progress.post_status;
+    }
+    if (owner->validation_status) {
+        return owner->validation_status;
+    }
+    return owner->post_status;
+}
