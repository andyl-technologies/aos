diff --git a/hw/net/e1000-fingerprint.h b/hw/net/e1000-fingerprint.h
new file mode 100644
index 0000000000000000000000000000000000000000..5fbd6efd3db4444b957b3934af04fd554a23df83
--- /dev/null
+++ b/hw/net/e1000-fingerprint.h
@@ -0,0 +1,112 @@
+/*
+ * Intel e1000 fingerprint projection internals
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+#ifndef HW_NET_E1000_FINGERPRINT_H
+#define HW_NET_E1000_FINGERPRINT_H
+
+#include "e1000x_common.h"
+#include "migration/qemu-file.h"
+#include "qapi/error.h"
+
+#define E1000_FINGERPRINT_HEADER_SIZE 256
+#define E1000_FINGERPRINT_DATA_SIZE 0x10000
+#define E1000_FINGERPRINT_EEPROM_WORDS 64
+#define E1000_FINGERPRINT_PHY_WORDS 0x20
+#define E1000_FINGERPRINT_MAC_REGS 0x8000
+
+typedef struct E1000FingerprintState {
+    uint32_t rxbuf_size;
+    uint32_t rxbuf_min_shift;
+    uint32_t eecd_val_in;
+    uint16_t eecd_bitnum_in;
+    uint16_t eecd_bitnum_out;
+    uint16_t eecd_reading;
+    uint32_t eecd_old_eecd;
+    const e1000x_txd_props *main_tx_props;
+    const e1000x_txd_props *tso_tx_props;
+    uint16_t tx_size;
+    uint16_t tx_tso_frames;
+    uint8_t tx_sum_needed;
+    const uint8_t *tx_header;
+    const uint8_t *tx_data;
+    const uint16_t *eeprom_data;
+    const uint16_t *phy_reg;
+    const uint32_t *mac_reg;
+    uint32_t compat_flags;
+    bool tso_state_present;
+    bool mit_irq_level;
+} E1000FingerprintState;
+
+static inline bool e1000_fingerprint_state_valid(
+    const E1000FingerprintState *state, Error **errp)
+{
+    if (!state || !state->main_tx_props || !state->tx_header ||
+        !state->tx_data || !state->eeprom_data || !state->phy_reg ||
+        !state->mac_reg ||
+        (state->tso_state_present && !state->tso_tx_props)) {
+        error_setg(errp, "e1000 fingerprint has incomplete state");
+        return false;
+    }
+    return true;
+}
+
+static inline void e1000_fingerprint_put_tx_props(
+    QEMUFile *f, const e1000x_txd_props *props)
+{
+    qemu_put_byte(f, props->ipcss);
+    qemu_put_byte(f, props->ipcso);
+    qemu_put_be16(f, props->ipcse);
+    qemu_put_byte(f, props->tucss);
+    qemu_put_byte(f, props->tucso);
+    qemu_put_be16(f, props->tucse);
+    qemu_put_be32(f, props->paylen);
+    qemu_put_byte(f, props->hdr_len);
+    qemu_put_be16(f, props->mss);
+    qemu_put_byte(f, props->ip);
+    qemu_put_byte(f, props->tcp);
+}
+
+static inline bool e1000_state_fingerprint_projection(
+    QEMUFile *f, const E1000FingerprintState *state, Error **errp)
+{
+    if (!e1000_fingerprint_state_valid(state, errp)) {
+        return false;
+    }
+
+    qemu_put_be32(f, state->compat_flags);
+    qemu_put_byte(f, state->tso_state_present);
+    qemu_put_be32(f, state->rxbuf_size);
+    qemu_put_be32(f, state->rxbuf_min_shift);
+    qemu_put_be32(f, state->eecd_val_in);
+    qemu_put_be16(f, state->eecd_bitnum_in);
+    qemu_put_be16(f, state->eecd_bitnum_out);
+    qemu_put_be16(f, state->eecd_reading);
+    qemu_put_be32(f, state->eecd_old_eecd);
+    e1000_fingerprint_put_tx_props(f, state->main_tx_props);
+    qemu_put_be16(f, state->tx_size);
+    qemu_put_be16(f, state->tx_tso_frames);
+    qemu_put_byte(f, state->tx_sum_needed);
+    qemu_put_buffer(f, state->tx_header, E1000_FINGERPRINT_HEADER_SIZE);
+    qemu_put_buffer(f, state->tx_data, E1000_FINGERPRINT_DATA_SIZE);
+
+    for (size_t index = 0; index < E1000_FINGERPRINT_EEPROM_WORDS; index++) {
+        qemu_put_be16(f, state->eeprom_data[index]);
+    }
+    for (size_t index = 0; index < E1000_FINGERPRINT_PHY_WORDS; index++) {
+        qemu_put_be16(f, state->phy_reg[index]);
+    }
+    for (size_t index = 0; index < E1000_FINGERPRINT_MAC_REGS; index++) {
+        qemu_put_be32(f, state->mac_reg[index]);
+    }
+
+    qemu_put_byte(f, state->mit_irq_level);
+    if (state->tso_state_present) {
+        e1000_fingerprint_put_tx_props(f, state->tso_tx_props);
+    }
+    return qemu_file_get_error(f) == 0;
+}
+
+#endif
