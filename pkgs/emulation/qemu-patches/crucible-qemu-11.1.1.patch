+int qemu_crucible_startup_source_reserve_control_metadata_v1(
+    qemu_plugin_id_t id, const uint64_t requests[4], uint64_t *reserved)
+{
+#ifdef CONFIG_LINUX
+    uint64_t tentative;
+    uint64_t bounded_ns;
+#endif
+    uint64_t native_generation;
+    int result;
+
+    if (!startup_invocation(id) || !startup_source.acquisition_attempted ||
+        startup_source.saved.plugin_id != id ||
+        startup_source.saved.ctx != startup_source.current.ctx ||
+        startup_source.saved.module != startup_source.current.module ||
+        startup_source.saved.install != startup_source.current.install) {
+        return -EPERM;
+    }
+    result = startup_active(id);
+
+    if (result) {
+        return result;
+    }
+    if (!reserved || !requests ||
+        !qatomic_load_acquire(&startup_source.original_record_complete)) {
+        return startup_failure(-EINVAL);
+    }
+    native_generation = qemu_crucible_fault_lifecycle_process_generation();
+    if (native_generation) {
+        result = qemu_crucible_startup_source_generation_check(
+            native_generation, false);
+        if (result) {
+            return result;
+        }
+    }
+#ifdef CONFIG_LINUX
+    result = startup_live_slice(&bounded_ns);
+    if (result) {
+        return result;
+    }
+    if (qatomic_load_acquire(&startup_source.metadata_partition.published) &&
+        startup_source.metadata_partition.total !=
+            startup_source.original.original_total_bytes) {
+        return startup_failure(-ESTALE);
+    }
+    result = crucible_metadata_controller_reserve(
+        &startup_source.metadata_partition, requests, &tentative);
+    if (result) {
+        return startup_failure(result);
+    }
+    /* The debit survives failed postcheck, readiness and install return. */
+    result = startup_live_slice(&bounded_ns);
+    if (result) {
+        crucible_metadata_partition_record_post(
+            &startup_source.metadata_partition, result);
+        return result;
+    }
+    *reserved = tentative;
+    return 0;
+#else
+    return startup_failure(-ENOTSUP);
+#endif
+}
