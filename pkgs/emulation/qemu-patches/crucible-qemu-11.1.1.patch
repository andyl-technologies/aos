+        crucible_checksum_u64(checksum, domain);
+        crucible_checksum_string(checksum, projection->schema);
+        crucible_checksum_u64(checksum, projection->version);
+    }
+    crucible_checksum_string(checksum, "read-only-sections-end");
+    g_checksum_get_digest(checksum, digest, &digest_length);
