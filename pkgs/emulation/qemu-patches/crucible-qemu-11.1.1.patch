+static bool virtio_pci_validate_fingerprint_projection(DeviceState *d,
+                                                        Error **errp)
+{
+    VirtIOPCIProxy *proxy = to_virtio_pci_proxy(d);
+    VirtIODevice *vdev = virtio_bus_get_device(&proxy->bus);
+
+    if (!vdev || !pci_device_fingerprint_validate(&proxy->pci_dev, errp) ||
+        !msix_fingerprint_validate(&proxy->pci_dev, errp)) {
+        return false;
+    }
+
+    return true;
+}
+
+static void virtio_pci_put_fingerprint_projection(DeviceState *d,
+                                                   QEMUFile *f)
+{
+    VirtIOPCIProxy *proxy = to_virtio_pci_proxy(d);
+    VirtIODevice *vdev = virtio_bus_get_device(&proxy->bus);
+    uint32_t active_queues = 0;
+
+    pci_device_fingerprint_put(f, &proxy->pci_dev);
+    msix_fingerprint_put(f, &proxy->pci_dev);
+    qemu_put_byte(f, virtio_pci_modern(proxy));
+    if (!virtio_pci_modern(proxy)) {
+        return;
+    }
+
+    qemu_put_be32(f, proxy->dfselect);
+    qemu_put_be32(f, proxy->gfselect);
+    for (size_t index = 0; index < ARRAY_SIZE(proxy->guest_features); index++) {
+        qemu_put_be32(f, proxy->guest_features[index]);
+    }
+    for (size_t index = 0; index < VIRTIO_QUEUE_MAX; index++) {
+        if (virtio_queue_get_num(vdev, index) != 0) {
+            active_queues++;
+        }
+    }
+    qemu_put_be32(f, active_queues);
+    for (size_t index = 0; index < VIRTIO_QUEUE_MAX; index++) {
+        const VirtIOPCIQueue *queue = &proxy->vqs[index];
+
+        if (virtio_queue_get_num(vdev, index) == 0) {
+            continue;
+        }
+        qemu_put_be16(f, index);
+        qemu_put_be16(f, queue->num);
+        qemu_put_byte(f, queue->enabled);
+        qemu_put_be64(f, deposit64(queue->desc[0], 32, 32, queue->desc[1]));
+        qemu_put_be64(f, deposit64(queue->avail[0], 32, 32, queue->avail[1]));
+        qemu_put_be64(f, deposit64(queue->used[0], 32, 32, queue->used[1]));
+    }
+}
