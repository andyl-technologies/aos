+#if defined(CONFIG_LINUX) && defined(CONFIG_TCG) && defined(CONFIG_PLUGIN)
+/* These cells are born with the initial control header. Runtime requests reuse
+ * only their genuine native row; no header or bookkeeping factory runs under
+ * replay. A returned payload leaves its debit here until physical settlement. */
+typedef struct QemuCrucibleCpuTlbSourceRow {
+    QemuCrucibleCpuTlbAllocationRequest *request;
+    QemuCrucibleMetadataCharge charge;
+    uint64_t serial;
+} QemuCrucibleCpuTlbSourceRow;
+
+struct QemuCrucibleCpuTlbTransitionOwner {
+    QemuCrucibleCpuTlbSourceOwner *storage_owner;
+    QemuCrucibleCpuTlbTransitionRequest *request;
+    QemuThread creator;
+    uint64_t serial;
+    size_t mmu;
+    bool held;
+};
+
+struct QemuCrucibleCpuTlbSourceOwner {
+    QemuCrucibleCpuTlbSourceOwner *next;
+    QemuCrucibleCpuTlbSourceOwner *parent_next;
+    QemuCrucibleCpuSourceAllocationOwner *parent;
+    QemuCrucibleObservationConstructionBinding *binding;
+    QemuCrucibleCpuMetadataAccount *account;
+    QemuCrucibleCpuTlbStorageRequest *request;
+    QemuCrucibleCpuTlbStorage *control;
+    QemuCrucibleMetadataCharge charge;
+    pid_t process;
+    uint64_t serial;
+    size_t row_count;
+    size_t storage_bytes;
+    size_t control_bytes;
+    size_t control_alignment;
+    size_t control_offset;
+    size_t rows_offset;
+    size_t transitions_offset;
+    bool control_lent;
+    bool result_observed;
+};
+
+static QemuCrucibleCpuTlbSourceOwner *cpu_tlb_find_locked(
+    const QemuCrucibleCpuTlbSourceOwner *candidate)
+{
+    QemuCrucibleCpuTlbSourceOwner *owner;
+
+    for (owner = startup_source.cpu_allocations.tlb_owners; owner;
+         owner = owner->next) {
+        if (owner == candidate) {
+            return owner;
+        }
+    }
+    return NULL;
+}
+
+static int cpu_tlb_storage_geometry(size_t control_bytes, size_t alignment,
+                                    size_t rows, size_t *row_offset,
+                                    size_t *transition_offset, size_t *bytes)
+{
+    size_t row_bytes;
+    size_t transition_bytes;
+    size_t prefix;
+
+    if (!control_bytes || !alignment || (alignment & (alignment - 1)) ||
+        !rows || rows % 2 ||
+        rows > SIZE_MAX / sizeof(QemuCrucibleCpuTlbSourceRow) ||
+        rows / 2 > SIZE_MAX / sizeof(QemuCrucibleCpuTlbTransitionOwner)) {
+        return -EOVERFLOW;
+    }
+    row_bytes = rows * sizeof(QemuCrucibleCpuTlbSourceRow);
+    transition_bytes = rows / 2 * sizeof(QemuCrucibleCpuTlbTransitionOwner);
+    if (row_bytes > SIZE_MAX - sizeof(QemuCrucibleCpuTlbSourceOwner) ||
+        transition_bytes > SIZE_MAX - sizeof(QemuCrucibleCpuTlbSourceOwner) -
+            row_bytes) {
+        return -EOVERFLOW;
+    }
+    *row_offset = sizeof(QemuCrucibleCpuTlbSourceOwner);
+    *transition_offset = *row_offset + row_bytes;
+    prefix = *transition_offset + transition_bytes;
+    if (alignment - 1 > SIZE_MAX - prefix ||
+        control_bytes > SIZE_MAX - prefix - (alignment - 1)) {
+        return -EOVERFLOW;
+    }
+    *bytes = prefix + alignment - 1 + control_bytes;
+    return 0;
+}
+
+static int cpu_tlb_pending_retire_locked(void)
+{
+    QemuCrucibleCpuSourceAllocationRegistry *registry =
+        &startup_source.cpu_allocations;
+    int status;
+
+    if (!registry->tlb_pending_charge.held) {
+        return 0;
+    }
+    if (!registry->tlb_pending_physical_return) {
+        return -EBUSY;
+    }
+    status = crucible_metadata_native_retire(
+        &startup_source.metadata_partition, &registry->tlb_pending_charge);
+    if (!registry->tlb_pending_charge.held) {
+        registry->tlb_pending_physical_return = false;
+    }
+    return status;
+}
+
+int qemu_crucible_startup_source_cpu_tlb_storage_admit_v1(
+    QemuCrucibleCpuTlbStorageRequest *request,
+    QemuCrucibleCpuTlbSourceOwner **out)
+{
+    QemuCrucibleObservationConstructionBinding *binding = NULL;
+    QemuCrucibleCpuMetadataAccount *account = NULL;
+    QemuCrucibleCpuSourceAllocationOwner *parent = NULL;
+    QemuCrucibleCpuTlbSourceOwner *owner;
+    QemuCrucibleCpuSourceAllocationRegistry *registry =
+        &startup_source.cpu_allocations;
+    uint64_t serial = 0;
+    size_t control_bytes = 0, alignment = 0, rows = 0;
+    size_t row_offset = 0, transition_offset = 0, bytes = 0;
+    uintptr_t control;
+    int status;
+
+    if (!out || *out) {
+        return -EINVAL;
+    }
+    status = qemu_crucible_cpu_tlb_storage_request_current_v1(
+        request, &binding, &account, &parent, &serial,
+        &control_bytes, &alignment, &rows);
+    if (!status) {
+        status = cpu_metadata_account_identity(account);
+    }
+    if (!status && (binding != account->binding || !serial)) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        status = cpu_tlb_storage_geometry(control_bytes, alignment, rows,
+                                         &row_offset, &transition_offset, &bytes);
+    }
+    if (status) {
+        return status;
+    }
+    status = pthread_mutex_trylock(&registry->lock);
+    if (status) {
+        return -status;
+    }
+    status = cpu_allocation_identity_locked(parent);
+    if (!status) {
+        status = cpu_tlb_pending_retire_locked();
+    }
+    if (!status) {
+        status = crucible_metadata_native_admit(account->partition, bytes,
+                                               &registry->tlb_pending_charge);
+        if (status && registry->tlb_pending_charge.held) {
+            /* The newly attempted header allocator has not been entered. */
+            registry->tlb_pending_physical_return = true;
+            cpu_tlb_pending_retire_locked();
+        }
+    }
+    if (status) {
+        pthread_mutex_unlock(&registry->lock);
+        return status;
+    }
+    owner = g_try_malloc0(bytes);
+    if (!owner) {
+        registry->tlb_pending_physical_return = true;
+        cpu_tlb_pending_retire_locked();
+        pthread_mutex_unlock(&registry->lock);
+        return -ENOMEM;
+    }
+    control = ((uintptr_t)owner + transition_offset +
+               rows / 2 * sizeof(QemuCrucibleCpuTlbTransitionOwner) +
+               alignment - 1) & ~(uintptr_t)(alignment - 1);
+    owner->parent = parent;
+    owner->binding = binding;
+    owner->account = account;
+    owner->request = request;
+    owner->process = getpid();
+    owner->serial = serial;
+    owner->row_count = rows;
+    owner->storage_bytes = bytes;
+    owner->control_bytes = control_bytes;
+    owner->control_alignment = alignment;
+    owner->control_offset = control - (uintptr_t)owner;
+    owner->rows_offset = row_offset;
+    owner->transitions_offset = transition_offset;
+    owner->charge = registry->tlb_pending_charge;
+    registry->tlb_pending_charge = (QemuCrucibleMetadataCharge) { 0 };
+    owner->next = registry->tlb_owners;
+    registry->tlb_owners = owner;
+    owner->parent_next = parent->tlb_children;
+    parent->tlb_children = owner;
+    *out = owner;
+
+    /* Parent storage cannot retire while this actual intrusive child remains.
+     * Output custody precedes the independent constructor semantic check. */
+    status = qemu_crucible_startup_source_observation_construction_current_v1(binding);
+    pthread_mutex_unlock(&registry->lock);
+    return status;
+}
+
+int qemu_crucible_startup_source_cpu_tlb_storage_borrow_v1(
+    QemuCrucibleCpuTlbStorageRequest *request,
+    QemuCrucibleCpuTlbSourceOwner *candidate, QemuCrucibleCpuTlbStorage **out)
+{
+    QemuCrucibleObservationConstructionBinding *binding = NULL;
+    QemuCrucibleCpuMetadataAccount *account = NULL;
+    QemuCrucibleCpuSourceAllocationOwner *parent = NULL;
+    QemuCrucibleCpuTlbSourceOwner *owner;
+    uint64_t serial = 0;
+    size_t bytes = 0, alignment = 0, rows = 0;
+    int status;
+
+    if (!out || *out) {
+        return -EINVAL;
+    }
+    status = pthread_mutex_trylock(&startup_source.cpu_allocations.lock);
+    if (status) {
+        return -status;
+    }
+    owner = cpu_tlb_find_locked(candidate);
+    if (!owner || owner->process != getpid() || !owner->charge.held ||
+        owner->request != request || owner->control_lent) {
+        status = -ESTALE;
+    } else {
+        status = cpu_tlb_header_identity(owner);
+        if (!status) {
+            status = qemu_crucible_cpu_tlb_storage_request_identity_v1(
+                request, &binding, &account, &parent, &serial,
+                &bytes, &alignment, &rows);
+        }
+        if (!status && (binding != owner->binding || account != owner->account ||
+            parent != owner->parent || serial != owner->serial ||
+            bytes != owner->control_bytes || alignment != owner->control_alignment ||
+            rows != owner->row_count)) {
+            status = -ESTALE;
+        }
+        if (!status) {
+            owner->control = (void *)((uint8_t *)owner + owner->control_offset);
+            owner->control_lent = true;
+            *out = owner->control;
+        }
+    }
+    pthread_mutex_unlock(&startup_source.cpu_allocations.lock);
+    return status;
+}
+
+int qemu_crucible_startup_source_cpu_tlb_storage_result_v1(
+    QemuCrucibleCpuTlbStorageRequest *request,
+    QemuCrucibleCpuTlbSourceOwner *candidate)
+{
+    QemuCrucibleCpuTlbSourceOwner *owner;
+    QemuCrucibleCpuTlbStorage *control = NULL;
+    int status = pthread_mutex_trylock(&startup_source.cpu_allocations.lock);
+
+    if (status) {
+        return -status;
+    }
+    owner = cpu_tlb_find_locked(candidate);
+    if (!owner || owner->process != getpid() || owner->request != request ||
+        !owner->charge.held || !owner->control_lent || owner->result_observed) {
+        status = -ESTALE;
+    } else {
+        status = cpu_tlb_header_identity(owner);
+        if (!status) {
+            status = qemu_crucible_cpu_tlb_storage_result_identity_v1(
+                request, owner, &control);
+        }
+        if (!status && control != owner->control) {
+            status = -ESTALE;
+        }
+        if (!status) {
+            owner->result_observed = true;
+            status = qemu_crucible_startup_source_observation_construction_current_v1(
+                owner->binding);
+        }
+    }
+    pthread_mutex_unlock(&startup_source.cpu_allocations.lock);
+    return status;
+}
+
+static QemuCrucibleCpuTlbSourceRow *cpu_tlb_rows(QemuCrucibleCpuTlbSourceOwner *owner)
+{
+    return (void *)((uint8_t *)owner + owner->rows_offset);
+}
+
+static QemuCrucibleCpuTlbTransitionOwner *cpu_tlb_transitions(
+    QemuCrucibleCpuTlbSourceOwner *owner)
+{
+    return (void *)((uint8_t *)owner + owner->transitions_offset);
+}
+
+/* Call only after registry membership, or under the exact entered transition
+ * loan. The held partition lane prevents header retirement for that loan. */
+static int cpu_tlb_header_identity(QemuCrucibleCpuTlbSourceOwner *owner)
+{
+    QemuCrucibleCpuTlbSourceOwner *child;
+    size_t rows_offset = 0, transitions_offset = 0, bytes = 0;
+    uintptr_t control;
+    int status;
+
+    if (!owner || owner->process != getpid() || !owner->charge.held ||
+        !owner->parent || !owner->serial) {
+        return -ESTALE;
+    }
+    status = cpu_metadata_account_identity(owner->account);
+    if (!status) {
+        status = cpu_tlb_storage_geometry(owner->control_bytes,
+            owner->control_alignment, owner->row_count, &rows_offset,
+            &transitions_offset, &bytes);
+    }
+    if (status) {
+        return status;
+    }
+    if (bytes > UINTPTR_MAX - (uintptr_t)owner) {
+        return -EOVERFLOW;
+    }
+    control = ((uintptr_t)owner + transitions_offset + owner->row_count / 2 *
+               sizeof(QemuCrucibleCpuTlbTransitionOwner) +
+               owner->control_alignment - 1) &
+              ~(uintptr_t)(owner->control_alignment - 1);
+    if (owner->storage_bytes != bytes || owner->charge.bytes != bytes ||
+        owner->rows_offset != rows_offset ||
+        owner->transitions_offset != transitions_offset ||
+        owner->control_offset != control - (uintptr_t)owner ||
+        owner->binding != owner->account->binding ||
+        !owner->parent->charge.held || owner->parent->process != owner->process ||
+        owner->parent->partition != owner->account->partition ||
+        (owner->control_lent && owner->control != (void *)control)) {
+        return -ESTALE;
+    }
+    for (child = owner->parent->tlb_children; child; child = child->parent_next) {
+        if (child == owner) {
+            return 0;
+        }
+    }
+    return -ESTALE;
+}
+
+static int cpu_tlb_storage_identity(QemuCrucibleCpuTlbSourceOwner *owner)
+{
+    QemuCrucibleCpuMetadataAccount *native_account = NULL;
+    QemuCrucibleCpuSourceAllocationOwner *native_parent = NULL;
+    uint64_t serial = 0;
+    int status = cpu_tlb_header_identity(owner);
+
+    if (!status && !owner->control_lent) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        status = qemu_crucible_cpu_tlb_storage_instance_identity_v1(
+            owner->control, owner, &native_account, &native_parent, &serial);
+    }
+    if (!status && (native_account != owner->account ||
+        native_parent != owner->parent || serial != owner->serial)) {
+        status = -ESTALE;
+    }
+    return status;
+}
+
+/* The active pointer is installed only by the genuine begin below. It selects
+ * one actual fixed Source holder, not an accounting flag nominated by Native.
+ * That holder owns the same bank lane until the independent physical end. */
+static int cpu_tlb_transition_identity(QemuCrucibleCpuTlbTransitionOwner *candidate)
+{
+    QemuCrucibleCpuMetadataAccount *account = &startup_source.cpu_metadata_account;
+    QemuCrucibleCpuTlbSourceOwner *owner;
+    int status;
+
+    if (!candidate || candidate != qatomic_load_acquire(&account->active_transition)) {
+        return -ESTALE;
+    }
+    if (!candidate->held || !qemu_thread_is_self(&candidate->creator) ||
+        !qatomic_read(&account->partition->accounting_busy)) {
+        return -ESTALE;
+    }
+    owner = candidate->storage_owner;
+    if (!owner || owner->account != account ||
+        candidate->mmu >= owner->row_count / 2 ||
+        candidate != &cpu_tlb_transitions(owner)[candidate->mmu]) {
+        return -ESTALE;
+    }
+    status = cpu_tlb_storage_identity(owner);
+    return status;
+}
+
+/* The caller already owns this partition's real accounting lane. Reentering
+ * the ordinary helper would conflict with that same loan. No new subdivision
+ * or running Original is created by these exact debit/return cuts. */
+static int cpu_tlb_debit(QemuCrucibleMetadataPartition *partition,
+                         uint64_t bytes, QemuCrucibleMetadataCharge *charge)
+{
+    uint64_t available;
+    int status = crucible_metadata_partition_admission_status(partition);
+
+    if (status) {
+        return status;
+    }
+    if (!bytes || !charge || charge->held ||
+        !qatomic_load_acquire(&partition->published) ||
+        !qatomic_load_acquire(&partition->controller_retained) ||
+        !crucible_metadata_partition_residual_valid(partition)) {
+        return -ESTALE;
+    }
+    if (partition->fixed_native_extent > partition->native_extent) {
+        return -ENOSPC;
+    }
+    available = partition->native_extent - partition->fixed_native_extent;
+    if (partition->inventory_allowance > available) {
+        return -ENOSPC;
+    }
+    available -= partition->inventory_allowance;
+    if (partition->native_live > available || bytes > available - partition->native_live) {
+        return -ENOSPC;
+    }
+    partition->native_live += bytes;
+    *charge = (QemuCrucibleMetadataCharge) { .bytes = bytes, .held = true };
+    return 0;
+}
+
+static int cpu_tlb_retire(QemuCrucibleMetadataPartition *partition,
+                          QemuCrucibleMetadataCharge *charge)
+{
+    if (!charge->held) {
+        return 0;
+    }
+    if (charge->bytes > partition->native_live) {
+        return -EOVERFLOW;
+    }
+    partition->native_live -= charge->bytes;
+    *charge = (QemuCrucibleMetadataCharge) { 0 };
+    return 0;
+}
+
+int qemu_crucible_startup_source_cpu_tlb_transition_begin_v1(
+    QemuCrucibleCpuTlbSourceOwner *candidate,
+    QemuCrucibleCpuTlbTransitionRequest *request,
+    QemuCrucibleCpuTlbTransitionOwner **out)
+{
+    QemuCrucibleCpuTlbSourceOwner *owner;
+    QemuCrucibleCpuTlbTransitionOwner *transition;
+    QemuCrucibleCpuTlbStorage *control = NULL;
+    size_t mmu = 0;
+    uint64_t serial = 0;
+    int status;
+
+    if (!out || *out) {
+        return -EINVAL;
+    }
+    /* Authenticate the retained inline Source/process lender before any
+     * reconsiderable result. An inherited busy registry cannot hide an old
+     * parent's account identity failure. No nominated header is read here. */
+    status = cpu_metadata_account_identity(&startup_source.cpu_metadata_account);
+    if (status) {
+        return status;
+    }
+    status = pthread_mutex_trylock(&startup_source.cpu_allocations.lock);
+    if (status == EBUSY) {
+        /* This exact trylock cut precedes header lookup, lane entry, row or
+         * Source borrower publication. Native keeps the existing arrays. */
+        return QEMU_CRUCIBLE_CPU_TLB_PENDING_STORAGE_REGISTRY;
+    }
+    if (status) {
+        return -status;
+    }
+    owner = cpu_tlb_find_locked(candidate);
+    status = owner ? cpu_tlb_storage_identity(owner) : -ESTALE;
+    if (!status) {
+        status = qemu_crucible_cpu_tlb_transition_request_current_v1(
+            owner->control, owner, request, &control, &mmu, &serial);
+    }
+    if (!status && (control != owner->control || mmu >= owner->row_count / 2)) {
+        status = -ESTALE;
+    }
+    if (status) {
+        pthread_mutex_unlock(&startup_source.cpu_allocations.lock);
+        return status;
+    }
+    transition = &cpu_tlb_transitions(owner)[mmu];
+    if (transition->held) {
+        status = -EBUSY;
+    } else if (!crucible_metadata_partition_enter(owner->account->partition)) {
+        /* Only this exact preeffect busy bank cut is reconsiderable. */
+        status = QEMU_CRUCIBLE_CPU_TLB_PENDING_ACCOUNT_ADMISSION;
+    } else {
+        status = qatomic_load_acquire(&owner->account->active_transition) ?
+            -ESTALE : qemu_crucible_startup_source_cpu_metadata_account_current_v1(
+                owner->account);
+        if (status) {
+            crucible_metadata_partition_leave(owner->account->partition);
+        } else {
+            transition->storage_owner = owner;
+            transition->request = request;
+            transition->mmu = mmu;
+            transition->serial = serial;
+            qemu_thread_get_self(&transition->creator);
+            transition->held = true;
+            qatomic_store_release(&owner->account->active_transition, transition);
+            *out = transition;
+        }
+    }
+    pthread_mutex_unlock(&startup_source.cpu_allocations.lock);
+    return status;
+}
+
+int qemu_crucible_startup_source_cpu_tlb_transition_end_v1(
+    QemuCrucibleCpuTlbTransitionOwner **out)
+{
+    QemuCrucibleCpuTlbTransitionOwner *transition;
+    QemuCrucibleCpuMetadataAccount *account;
+    size_t mmu = 0;
+    uint64_t serial = 0;
+    int status;
+
+    if (!out || !*out) {
+        return -EINVAL;
+    }
+    transition = *out;
+    status = cpu_tlb_transition_identity(transition);
+    if (!status) {
+        status = qemu_crucible_cpu_tlb_transition_identity_v1(
+            transition->storage_owner->control, transition->storage_owner,
+            transition->request, &mmu, &serial);
+    }
+    if (!status && (mmu != transition->mmu || serial != transition->serial)) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        status = qemu_crucible_cpu_tlb_transition_returned_current_v1(
+            transition->storage_owner->control, transition->storage_owner,
+            transition->request);
+    }
+    if (status) {
+        return status;
+    }
+    account = transition->storage_owner->account;
+    transition->held = false;
+    transition->request = NULL;
+    qatomic_store_release(&account->active_transition, NULL);
+    *out = NULL;
+    crucible_metadata_partition_leave(account->partition);
+    return 0;
+}
+
+static int cpu_tlb_row_identity(QemuCrucibleCpuTlbTransitionOwner *transition,
+                                QemuCrucibleCpuTlbAllocationRequest *request,
+                                QemuCrucibleCpuTlbSourceRow **out,
+                                uint64_t *serial)
+{
+    QemuCrucibleCpuTlbSourceOwner *owner;
+    QemuCrucibleCpuTlbStorage *control = NULL;
+    size_t row = 0;
+    int status = cpu_tlb_transition_identity(transition);
+
+    if (status) {
+        return status;
+    }
+    owner = transition->storage_owner;
+    status = qemu_crucible_cpu_tlb_allocation_identity_v1(
+        owner->control, owner, request, &control, &row, serial);
+    if (!status && (control != owner->control || row >= owner->row_count ||
+                   row / 2 != transition->mmu)) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        *out = &cpu_tlb_rows(owner)[row];
+    }
+    return status;
+}
+
+int qemu_crucible_startup_source_cpu_tlb_array_admit_v1(
+    QemuCrucibleCpuTlbTransitionOwner *transition,
+    QemuCrucibleCpuTlbAllocationRequest *request)
+{
+    QemuCrucibleCpuTlbSourceRow *cell = NULL;
+    QemuCrucibleCpuTlbTransitionRequest *native_transition = NULL;
+    QemuCrucibleCpuTlbSourceOwner *owner;
+    size_t row = 0, bytes = 0, alignment = 0;
+    uint64_t serial = 0, current_serial = 0;
+    int status = cpu_tlb_row_identity(transition, request, &cell, &serial);
+
+    if (status) {
+        return status;
+    }
+    owner = transition->storage_owner;
+    status = qemu_crucible_cpu_tlb_allocation_request_current_v1(
+        owner->control, owner, request, &native_transition,
+        &row, &current_serial, &bytes, &alignment);
+    if (status) {
+        return status;
+    }
+    if (native_transition != transition->request || serial != current_serial ||
+        cell->request || cell->charge.held || !bytes || !alignment ||
+        (alignment & (alignment - 1))) {
+        return -ESTALE;
+    }
+    /* Preserve this actual preallocator journal even if the debit refuses. */
+    cell->request = request;
+    cell->serial = serial;
+    status = cpu_tlb_debit(owner->account->partition, bytes, &cell->charge);
+    return status;
+}
+
+int qemu_crucible_startup_source_cpu_tlb_array_result_v1(
+    QemuCrucibleCpuTlbTransitionOwner *transition,
+    QemuCrucibleCpuTlbAllocationRequest *request)
+{
+    QemuCrucibleCpuTlbSourceRow *cell = NULL;
+    QemuCrucibleCpuTlbSourceOwner *owner;
+    uint64_t serial = 0;
+    void *payload = NULL;
+    int status = cpu_tlb_row_identity(transition, request, &cell, &serial);
+
+    if (status) {
+        return status;
+    }
+    owner = transition->storage_owner;
+    if (cell->request != request || cell->serial != serial || !cell->charge.held) {
+        return -ESTALE;
+    }
+    status = qemu_crucible_cpu_tlb_allocation_result_identity_v1(
+        owner->control, owner, request, serial, &payload);
+    if (!status) {
+        /* Native already saved this actual allocator result in the retained
+         * row before calling Source. The nominal request/control loan retains
+         * that output across this independent accounting check. */
+        status = qemu_crucible_startup_source_cpu_metadata_account_current_v1(
+            owner->account);
