+    out->fault_commands_ring_count = (uint64_t)vm_count * UINT64_C(1);
+
+    if (UINT64_C(128) && out->fault_commands_ring_count > UINT64_MAX / UINT64_C(128)) {
+        return -EOVERFLOW;
+    }
+    out->fault_commands_headers_extent = out->fault_commands_ring_count * UINT64_C(128);
+
+    if (out->fault_commands_headers_extent > UINT64_MAX - out->fault_commands_headers_offset) {
+        return -EOVERFLOW;
+    }
+    out->fault_commands_data_offset = out->fault_commands_headers_offset + out->fault_commands_headers_extent;
+
+    if (UINT64_C(4096) && out->fault_commands_ring_count > UINT64_MAX / UINT64_C(4096)) {
+        return -EOVERFLOW;
