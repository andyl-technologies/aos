+    } else {
+        status = object_native_observer_identity_locked();
+        if (!status && request->phase != OBJECT_NATIVE_ALLOCATION_IDLE) {
+            status = -EBUSY;
+        }
+        if (!status && native_allocations.generation == UINT64_MAX) {
+            status = -EOVERFLOW;
+        }
+        if (!status) {
+            *request = (QemuCrucibleCpuAllocationRequest) {
+                .type = type, .parent = parent, .kind = kind,
+                .phase = OBJECT_NATIVE_ALLOCATION_BEFORE,
+                .generation = ++native_allocations.generation,
+            };
+            ops = observer->ops;
+            userdata = observer->userdata;
+        }
