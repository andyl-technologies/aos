@@ -0,0 +1,486 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Prove crossing-count bookkeeping with extracted native mutation bodies.
+
+The page-collection fixture supplies the real tagged iterator, collection,
+invalidation range and pthread page locks. This fixture additionally extracts
+tb_link_page, do_tb_phys_invalidate and the recursive full-list clear. QHT,
+jump unlinking and JIT transitions are explicit providers. Their results select
+native branches; they do not implement page-list bookkeeping.
+
+The proofs cover tagged memberships, aliases, mixed lists, duplicate rollback,
+hash-only invalidation and failed hash removal, finite and saturated counters,
+empty-list recovery, full flush, retry after a list mutation and retained fork
+copies. Fork proves ordinary process-private copying, not the full hot-fork
+lifecycle. Native precise-SMC cleanup runs through the original fixture too.
+These unit proofs do not qualify MTTCG, guest SMC, replay or performance.
+
+Use --emit-only to write the extracted fixture without compiling or running it.
+Compiler and linker settings are supplied through CC, CFLAGS and LDFLAGS just
+as for test-crucible-tcg-page-collection.py. Each causal --negative must fail
+a native assertion, rather than a source-text expectation.
+"""
+
+import argparse
+import importlib.util
+import json
+import os
+from pathlib import Path
+import shlex
+import subprocess
+import sys
+
+
+ROOT = Path(__file__).resolve().parents[2]
+NEGATIVES = (
+    "omit-increment", "premature-zero", "wrap-count", "miss-empty-reset",
+    "miss-flush-reset", "decrement-hash-only", "cache-across-retry",
+)
+
+
+PROVIDERS = r"""
+static struct {
+    int htable;
+    unsigned int tb_phys_invalidate_count;
+} tb_ctx;
+static TranslationBlock *fixture_duplicate;
+static bool fixture_hash_remove = true;
+static bool fixture_jump_lock;
+static TranslationBlock *fixture_retry_tb;
+
+void tb_unlock_pages(TranslationBlock *tb);
+TranslationBlock *tb_link_page(TranslationBlock *tb);
+
+#define V_L2_SIZE MAX_PAGES
+#define qatomic_set(ptr, value) (*(ptr) = (value))
+
+static void assert_memory_lock(void) { }
+static void qemu_thread_jit_write(void) { }
+static void qemu_thread_jit_execute(void) { }
+
+/* The separate jump-lock provider does not replace any page lock. */
+static void qemu_spin_lock(QemuSpin *lock)
+{
+    for (unsigned int i = 0; i < MAX_PAGES; i++) {
+        if (lock == &fixture_pages[i].lock) {
+            fixture_page_spin_lock(lock);
+            return;
+        }
+    }
+    assert(!fixture_jump_lock);
+    fixture_jump_lock = true;
+}
+
+static void qemu_spin_unlock(QemuSpin *lock)
+{
+    for (unsigned int i = 0; i < MAX_PAGES; i++) {
+        if (lock == &fixture_pages[i].lock) {
+            fixture_page_spin_unlock(lock);
+            return;
+        }
+    }
+    assert(fixture_jump_lock);
+    fixture_jump_lock = false;
+}
+
+static uint32_t tb_hash_func(tb_page_addr_t page, uint64_t pc, uint32_t flags,
+                             uint64_t base, uint32_t cflags)
+{
+    (void)page;
+    (void)pc;
+    (void)flags;
+    (void)base;
+    (void)cflags;
+    return 0;
+}
+
+static bool qht_remove(int *table, TranslationBlock *tb, uint32_t hash)
+{
+    assert(table == &tb_ctx.htable && hash == 0);
+    if (!fixture_hash_remove || !tb->fixture_in_hash) {
+        return false;
+    }
+    tb->fixture_in_hash = false;
+    return true;
+}
+
+static bool qht_insert(int *table, TranslationBlock *tb, uint32_t hash,
+                       void **existing)
+{
+    assert(table == &tb_ctx.htable && hash == 0);
+    *existing = fixture_duplicate;
+    tb->fixture_in_hash = !fixture_duplicate;
+    return !fixture_duplicate;
+}
+
+static void tb_jmp_cache_inval_tb(TranslationBlock *tb)
+{
+    assert(tb->cflags & CF_INVALID);
+    invalidated++;
+}
+
+static void tb_remove_from_jmp_list(TranslationBlock *tb, int slot)
+{
+    assert(tb->cflags & CF_INVALID);
+    assert(slot == 0 || slot == 1);
+}
+
+static void tb_jmp_unlink(TranslationBlock *tb)
+{
+    assert(tb->cflags & CF_INVALID);
+}
+
+"""
+
+
+EXERCISE = r"""
+static void lock_tb_pages(TranslationBlock *tb)
+{
+    tb_page_addr_t first = tb_page_addr0(tb) >> TARGET_PAGE_BITS;
+    tb_page_addr_t second = tb_page_addr1(tb) >> TARGET_PAGE_BITS;
+
+    /* Setup locks without adding collection trace events. */
+    assert(pthread_mutex_lock(&fixture_pages[first].lock) == 0);
+    assert(!held[first]);
+    held[first] = true;
+    if (tb_spans_distinct_pages(tb)) {
+        assert(pthread_mutex_lock(&fixture_pages[second].lock) == 0);
+        assert(!held[second]);
+        held[second] = true;
+    }
+}
+
+static void check_counts(unsigned int first, uint32_t first_count,
+                         unsigned int second, uint32_t second_count)
+{
+    assert_no_pages_locked();
+    /* Assertions also obey the lock ownership rule. */
+    assert(pthread_mutex_lock(&fixture_pages[first].lock) == 0);
+    assert(fixture_pages[first].crossing_tb_count == first_count);
+    assert(pthread_mutex_unlock(&fixture_pages[first].lock) == 0);
+    if (first != second) {
+        assert(pthread_mutex_lock(&fixture_pages[second].lock) == 0);
+        assert(fixture_pages[second].crossing_tb_count == second_count);
+        assert(pthread_mutex_unlock(&fixture_pages[second].lock) == 0);
+    }
+}
+
+static void remove_membership(TranslationBlock *tb)
+{
+    lock_tb_pages(tb);
+    tb_remove(tb);
+    tb_unlock_pages(tb);
+}
+
+static void set_count(unsigned int index, uint32_t count)
+{
+    assert_no_pages_locked();
+    assert(pthread_mutex_lock(&fixture_pages[index].lock) == 0);
+    fixture_pages[index].crossing_tb_count = count;
+    assert(pthread_mutex_unlock(&fixture_pages[index].lock) == 0);
+}
+
+static void fixture_insert_during_retry(void)
+{
+    /* A competing writer can record a crossing while retry dropped locks. */
+    assert_no_pages_locked();
+    fixture_mutate_on_unlock = false;
+    add_tb(fixture_retry_tb, 3, 6, 4090);
+}
+
+static void check_mutation_paths(void)
+{
+    TranslationBlock blocks[6];
+
+    reset_fixture();
+    add_tb(&blocks[0], 2, -1, 0);
+    add_tb(&blocks[1], 5, 5, 4090);
+    check_counts(2, 0, 5, 0);
+    add_tb(&blocks[2], 2, 5, 4090);
+    add_tb(&blocks[3], 5, 2, 4090);
+    check_counts(2, 2, 5, 2);
+    assert((fixture_pages[2].first_tb & 1) == 1);
+    assert((fixture_pages[5].first_tb & 1) == 0);
+
+    /* Remove an interior tag-zero, then the last crossing on mixed lists. */
+    remove_membership(&blocks[2]);
+    check_counts(2, 1, 5, 1);
+    check_collection("mixed-crossing", 2, 2, (1u << 2) | (1u << 5),
+                     "L2 L5 U2 U5 ");
+    remove_membership(&blocks[3]);
+    check_counts(2, 0, 5, 0);
+    tree_creations = entry_allocations = membership_visits = 0;
+    check_collection("last-crossing-removed", 2, 2, 1u << 2, "L2 U2 ");
+    assert(membership_visits == 0);
+    remove_membership(&blocks[0]);
+    remove_membership(&blocks[1]);
+    check_counts(2, 0, 5, 0);
+    puts("membership-tags-aliases-mixed: passed");
+
+    reset_fixture();
+    add_tb(&blocks[0], 2, 5, 4090);
+    blocks[1] = (TranslationBlock) { .page_addr = {2 * PAGE_SIZE, 5 * PAGE_SIZE} };
+    fixture_duplicate = &blocks[0];
+    lock_tb_pages(&blocks[1]);
+    assert(tb_link_page(&blocks[1]) == &blocks[0]);
+    fixture_duplicate = NULL;
+    check_counts(2, 1, 5, 1);
+    assert(fixture_pages[2].first_tb == (uintptr_t)&blocks[0]);
+    assert(fixture_pages[5].first_tb == ((uintptr_t)&blocks[0] | 1));
+    remove_membership(&blocks[0]);
+    lock_tb_pages(&blocks[1]);
+    assert(tb_link_page(&blocks[1]) == &blocks[1]);
+    check_counts(2, 1, 5, 1);
+    remove_membership(&blocks[1]);
+    check_counts(2, 0, 5, 0);
+    puts("membership-native-qht-rollback: passed");
+
+    reset_fixture();
+    add_tb(&blocks[0], 2, 5, 4090);
+    fixture_hash_remove = false;
+    lock_tb_pages(&blocks[0]);
+    do_tb_phys_invalidate(&blocks[0], true);
+    tb_unlock_pages(&blocks[0]);
+    assert(blocks[0].cflags & CF_INVALID);
+    check_counts(2, 1, 5, 1);
+    fixture_hash_remove = true;
+    do_tb_phys_invalidate(&blocks[0], false);
+    assert(!blocks[0].fixture_in_hash);
+    check_counts(2, 1, 5, 1);
+    check_collection("retained-invalid", 2, 2, (1u << 2) | (1u << 5),
+                     "L2 L5 U2 U5 ");
+    lock_tb_pages(&blocks[0]);
+    do_tb_phys_invalidate(&blocks[0], true);
+    tb_unlock_pages(&blocks[0]);
+    check_counts(2, 1, 5, 1);
+    remove_membership(&blocks[0]);
+    check_counts(2, 0, 5, 0);
+    puts("membership-native-retained-invalid: passed");
+}
+
+static void check_saturation_and_flush(void)
+{
+    TranslationBlock blocks[4];
+    void *leaves[MAX_PAGES] = { fixture_pages };
+    void *branches[MAX_PAGES] = { leaves };
+    void *root = branches;
+
+    reset_fixture();
+    add_tb(&blocks[0], 2, -1, 0);
+    add_tb(&blocks[1], 5, 5, 4090);
+    set_count(2, UINT32_MAX - 1);
+    set_count(5, UINT32_MAX - 1);
+    add_tb(&blocks[2], 2, 5, 4090);
+    check_counts(2, UINT32_MAX, 5, UINT32_MAX);
+    add_tb(&blocks[3], 5, 2, 4090);
+    check_counts(2, UINT32_MAX, 5, UINT32_MAX);
+    remove_membership(&blocks[2]);
+    check_counts(2, UINT32_MAX, 5, UINT32_MAX);
+    remove_membership(&blocks[3]);
+    check_counts(2, UINT32_MAX, 5, UINT32_MAX);
+    check_collection("sticky-unknown", 2, 2, 1u << 2, "L2 U2 ");
+    assert(membership_visits > 0);
+    remove_membership(&blocks[0]);
+    remove_membership(&blocks[1]);
+    check_counts(2, 0, 5, 0);
+
+    add_tb(&blocks[0], 2, 5, 4090);
+    set_count(2, UINT32_MAX);
+    tb_remove_all_1(2, &root);
+    check_counts(2, 0, 5, 0);
+    for (unsigned int i = 0; i < MAX_PAGES; i++) {
+        assert(!fixture_pages[i].first_tb);
+    }
+    add_tb(&blocks[0], 2, -1, 0);
+    tree_creations = entry_allocations = membership_visits = 0;
+    check_collection("after-flush", 2, 2, 1u << 2, "L2 U2 ");
+    assert(membership_visits == 0);
+    puts("membership-saturation-empty-flush: passed");
+}
+
+static void check_retry_mutation(void)
+{
+    TranslationBlock blocks[2];
+
+    reset_fixture();
+    add_tb(&blocks[0], 5, 2, 4090);
+    present[3] = true;
+    fixture_retry_tb = &blocks[1];
+    fixture_mutate_on_unlock = true;
+    transient_busy_index = 2;
+    check_collection("retry-list-mutated", 3, 5, 0x6c,
+                     "L3 L5 B2 U3 U5 L2 L3 L5 L6 U2 U3 U5 U6 ");
+    check_counts(3, 1, 6, 1);
+    puts("membership-retry-fresh-count: passed");
+}
+
+static void check_fork_copy(void)
+{
+    TranslationBlock blocks[2];
+    pid_t child;
+    int status;
+
+    reset_fixture();
+    add_tb(&blocks[0], 2, 5, 4090);
+    add_tb(&blocks[1], 2, -1, 0);
+    assert(fflush(NULL) == 0);
+    child = fork();
+    assert(child >= 0);
+    if (child == 0) {
+        check_counts(2, 1, 5, 1);
+        do_tb_phys_invalidate(&blocks[0], false);
+        check_counts(2, 1, 5, 1);
+        check_collection("fork-child-retained", 2, 2,
+                         (1u << 2) | (1u << 5), "L2 L5 U2 U5 ");
+        remove_membership(&blocks[0]);
+        check_counts(2, 0, 5, 0);
+        _exit(0);
+    }
+    assert(waitpid(child, &status, 0) == child);
+    assert(WIFEXITED(status) && WEXITSTATUS(status) == 0);
+    check_counts(2, 1, 5, 1);
+    assert(blocks[0].fixture_in_hash && !(blocks[0].cflags & CF_INVALID));
+    remove_membership(&blocks[0]);
+    check_counts(2, 0, 5, 0);
+    puts("membership-retained-fork-copy: passed");
+}
+
+int main(void)
+{
+    assert(fixture_page_collection_main() == 0);
+    for (unsigned int i = 0; i < MAX_PAGES; i++) {
+        assert(pthread_mutex_init(&fixture_pages[i].lock, NULL) == 0);
+    }
+
+    check_mutation_paths();
+    check_saturation_and_flush();
+    check_retry_mutation();
+    check_fork_copy();
+    assert_no_pages_locked();
+
+    for (unsigned int i = 0; i < MAX_PAGES; i++) {
+        assert(pthread_mutex_destroy(&fixture_pages[i].lock) == 0);
+    }
+    puts("crossing-membership: passed");
+    return 0;
+}
+"""
+
+
+def fixture_source(source_root, negative=None):
+    """Compose exact native definitions with explicit lifecycle providers."""
+    path = Path(__file__).with_name("test-crucible-tcg-page-collection.py")
+    spec = importlib.util.spec_from_file_location("page_collection_fixture", path)
+    collection = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(collection)
+    source = collection.fixture_source(source_root)
+    maintenance = (source_root / "accel/tcg/tb-maint.c").read_text()
+    system = maintenance[maintenance.index("struct PageDesc {"):]
+    header = (source_root / "include/exec/translation-block.h").read_text()
+    flags = "\n".join(line for line in header.splitlines()
+                      if line.startswith(("#define CF_INVALID ",
+                                          "#define CF_PCREL ")))
+    source = source.replace("#include <setjmp.h>",
+                            "#include <setjmp.h>\n#include <unistd.h>\n"
+                            "#include <sys/wait.h>\n" + flags)
+    source = source.replace("    uint32_t cflags;", "    uint32_t cflags;\n"
+                            "    uint64_t pc, cs_base;\n    uint32_t flags;\n"
+                            "    QemuSpin jmp_lock;\n    bool fixture_in_hash;")
+    source = source.replace("static void qemu_spin_lock(",
+                            "static void fixture_page_spin_lock(")
+    source = source.replace("static void qemu_spin_unlock(",
+                            "static void fixture_page_spin_unlock(")
+    source = source.replace("    /* Native insertion checks lock ownership",
+                            "    tb->fixture_in_hash = true;\n"
+                            "    /* Native insertion checks lock ownership")
+    stub = collection.definition(source, "static void do_tb_phys_invalidate(")
+    native_invalidate = collection.definition(system,
+                                               "static void do_tb_phys_invalidate(")
+    source = source.replace(stub, PROVIDERS + "\n" + native_invalidate)
+    source = source.replace("int main(void)", "static int fixture_page_collection_main(void)")
+
+    # Retry injection runs only after the final collection lock was released.
+    unlock = collection.definition(source, "static void fixture_page_spin_unlock(")
+    changed_unlock = unlock.replace(
+        "    assert(pthread_mutex_unlock(lock) == 0);",
+        "    assert(pthread_mutex_unlock(lock) == 0);\n"
+        "    if (fixture_mutate_on_unlock && index == 5) {\n"
+        "        fixture_insert_during_retry();\n    }")
+    source = source.replace(unlock, changed_unlock)
+    # The injection state is declared before the lock provider it extends.
+    declarations = ("static bool fixture_mutate_on_unlock;\n"
+                    "static void fixture_insert_during_retry(void);\n")
+    source = source.replace("static void fixture_page_spin_unlock(",
+                            declarations + "\nstatic void fixture_page_spin_unlock(", 1)
+
+    extra = "\n".join(collection.definition(system, signature) for signature in (
+        "void tb_unlock_pages(", "TranslationBlock *tb_link_page(",
+        "static void tb_remove_all_1(",
+    ))
+    source += "\n" + extra + "\n" + EXERCISE
+    mutations = {
+        "omit-increment": ("static void tb_page_add(",
+                           "p->crossing_tb_count++;", "(void)p;"),
+        "premature-zero": ("static void tb_page_remove(",
+                           "pd->crossing_tb_count--;", "pd->crossing_tb_count = 0;"),
+        "wrap-count": ("static void tb_page_add(",
+                       " && p->crossing_tb_count != UINT32_MAX", ""),
+        "miss-empty-reset": ("static void tb_page_remove(",
+                             "pd->crossing_tb_count = 0;", "(void)pd;"),
+        "miss-flush-reset": ("static void tb_remove_all_1(",
+                             "pd[i].crossing_tb_count = 0;", "(void)pd;"),
+        "decrement-hash-only": ("static void do_tb_phys_invalidate(",
+                                "if (rm_from_page_list)", "if (true)"),
+    }
+    if negative == "cache-across-retry":
+        body = collection.definition(source, "static void page_collection_lock(")
+        changed = body.replace("    tb_page_addr_t index;",
+                               "    tb_page_addr_t index;\n"
+                               "    bool cached_zero[MAX_PAGES] = { false };")
+        changed = changed.replace("if (pd->crossing_tb_count == 0)",
+                                  "if (cached_zero[index] ||\n"
+                                  "            (cached_zero[index] = "
+                                  "pd->crossing_tb_count == 0))")
+        source = source.replace(body, changed, 1)
+    elif negative:
+        signature, before, after = mutations[negative]
+        body = collection.definition(source, signature)
+        if before not in body:
+            raise ValueError("Negative control requires its native operation")
+        source = source.replace(body, body.replace(before, after, 1), 1)
+    return source
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--source-root", type=Path, default=ROOT)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    parser.add_argument("--emit-only", action="store_true")
+    parser.add_argument("--negative", choices=NEGATIVES)
+    args = parser.parse_args()
+    args.output_dir.mkdir(parents=True, exist_ok=True)
+    source = args.output_dir / "crossing-membership.c"
+    executable = args.output_dir / "crossing-membership"
+    source.write_text(fixture_source(args.source_root, args.negative))
+    command = shlex.split(os.environ.get("CC", "cc"))
+    command += shlex.split(os.environ.get("CFLAGS", ""))
+    command += ["-UNDEBUG", "-std=gnu11", "-Wall", "-Werror", "-pthread",
+                "-I" + str(args.source_root / "include"),
+                str(source), "-o", str(executable)]
+    command += shlex.split(os.environ.get("LDFLAGS", ""))
+    (args.output_dir / "compile-command.json").write_text(
+        json.dumps(command, indent=2) + "\n")
+    if args.emit_only:
+        return
+
+    subprocess.run(command, check=True)
+    result = subprocess.run([str(executable)], capture_output=True, text=True,
+                            timeout=15)
+    (args.output_dir / "stdout.txt").write_text(result.stdout)
+    (args.output_dir / "stderr.txt").write_text(result.stderr)
+    print(result.stdout, end="")
+    print(result.stderr, end="", file=sys.stderr)
+    result.check_returncode()
+
+
+if __name__ == "__main__":
+    main()
