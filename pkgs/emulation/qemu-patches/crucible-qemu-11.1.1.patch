+static int crucible_memory_vmstate_save(GByteArray *payload)
+{
+    node_rules_ensure();
+    return crucible_memory_vmstate_encode(payload);
+}
+
+static int crucible_memory_fingerprint_projection(GByteArray *payload)
+{
+    if (!crucible_node_rules) {
+        return -ENODATA;
+    }
+    return crucible_memory_vmstate_encode(payload);
+}
