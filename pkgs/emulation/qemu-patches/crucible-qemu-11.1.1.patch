+static void test_publisher_module_facts(void)
+{
+    PreexecPublisherSessionJournal session = { 0 };
+    QemuCruciblePublisherModuleView view;
+    QemuCruciblePublisherModuleView unchanged;
+    PreexecPublisherMappingJournal *mapping =
+        &preexec_setup_owner.publisher_storage.session.mapping;
+    _Alignas(uint64_t) unsigned char span[64];
+    int service;
+    int other;
+    int returned = 0;
+
+    /* Local records prove only debt and span predicates. The sole Source
+     * reciprocal below refuses; no module, Original or session is issued. */
+    session.module_service = &service;
+    g_assert_cmpint(preexec_publisher_session_busy(&session), ==, true);
+    g_assert_cmpint(preexec_publisher_module_drop(&session, &other), ==, -EBUSY);
+    session.member = &other;
+    g_assert_cmpint(preexec_publisher_module_drop(&session, &service), ==, -EBUSY);
+    session.member = NULL;
+    session.live_operations = 1;
