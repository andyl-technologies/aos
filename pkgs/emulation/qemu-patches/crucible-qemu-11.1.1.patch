+static void scenario_checkpoint_foreign_registry_context(void)
+{
+    struct qemu_plugin_ctx *foreign_ctx;
+    struct qemu_plugin_ctx foreign_before;
+    QemuCrucibleStartupInstallerBinding saved;
+    uint8_t userdata_before[sizeof(checkpoint_userdata)];
+
+    fixture_prepare(0, false);
+    g_assert_cmpint(fixture_acquire(), ==, 0);
+    saved = startup_source.saved;
+    memset(checkpoint_userdata, 0xc5, sizeof(checkpoint_userdata));
+    memcpy(userdata_before, checkpoint_userdata, sizeof(userdata_before));
+
+    /* Both contexts stay live. Only the same-id registry value is foreign;
+     * the real current and saved installer bindings remain unchanged. */
+    foreign_ctx = g_new0(struct qemu_plugin_ctx, 1);
+    foreign_ctx->id = fixture.ctx.id;
+    foreign_ctx->handle = g_module_open(NULL, G_MODULE_BIND_LOCAL);
+    g_assert_nonnull(foreign_ctx->handle);
+    foreign_ctx->installing = true;
+    memcpy(&foreign_before, foreign_ctx, sizeof(foreign_before));
+    g_assert_false(g_hash_table_replace(plugin.id_ht, &foreign_ctx->id,
+                                       &foreign_ctx->id));
+    g_assert_true(g_hash_table_lookup(plugin.id_ht, &fixture.ctx.id) ==
+                  &foreign_ctx->id);
+    g_assert_true(&foreign_ctx->id != &fixture.ctx.id);
+
+    g_assert_cmpint(fixture_register_checkpoint(), ==, -EPERM);
+    g_assert_cmpint(startup_source.first_negative_status, ==, -EPERM);
+    g_assert_true(startup_source.checkpoint_pager_attempted);
+    assert_checkpoint_unpublished();
+    g_assert_cmpmem(checkpoint_userdata, sizeof(checkpoint_userdata),
+                    userdata_before, sizeof(userdata_before));
+    g_assert_cmpmem(&startup_source.saved, sizeof(startup_source.saved),
+                    &saved, sizeof(saved));
+    g_assert_true(startup_source.current.ctx == &fixture.ctx);
+    g_assert_true(startup_source.current.module == fixture.ctx.handle);
+    g_assert_true(startup_source.current.install == fixture_install);
+    g_assert_cmpmem(foreign_ctx, sizeof(*foreign_ctx),
+                    &foreign_before, sizeof(foreign_before));
+    g_assert_true(g_hash_table_lookup(plugin.id_ht, &fixture.ctx.id) ==
+                  &foreign_ctx->id);
+    g_assert_nonnull(g_module_name(fixture.ctx.handle));
+    g_assert_nonnull(g_module_name(foreign_ctx->handle));
+
+    /* Restore the actual key/value before ending the foreign allocation and
+     * its independent module reference. Restoration cannot clear first cause. */
+    g_assert_false(g_hash_table_replace(plugin.id_ht, &fixture.ctx.id,
+                                       &fixture.ctx.id));
+    g_assert_true(g_hash_table_lookup(plugin.id_ht, &fixture.ctx.id) ==
+                  &fixture.ctx.id);
+    g_assert_true(g_module_close(foreign_ctx->handle));
+    g_free(foreign_ctx);
+    g_assert_cmpint(fixture_register_checkpoint(), ==, -EPERM);
+    assert_checkpoint_unpublished();
+    assert_checkpoint_lifetime();
+}
