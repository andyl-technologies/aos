+static int crucible_hot_fork_apply_child_resource_plan(
+    QemuCrucibleHotForkChildResourcePlan *resources,
+    QemuCrucibleHotForkDescriptorTableTransaction *transaction,
+    QemuCrucibleHotForkRuntimeTransaction *runtime,
+    QemuCrucibleHotForkDescriptorVerifier verify_descriptors,
+    void *descriptor_opaque,
+    QemuCrucibleHotForkPluginChildReinitializer *plugin_reinitializer,
+    QemuCrucibleHotForkQmpChildReinitializer *qmp_reinitializer,
+    QemuCrucibleHotForkConsoleChildReinitializer *console_reinitializer)
+{
+    QemuCrucibleHotForkChildSubsystemReinitializers reinitializers = {
+        .runtime = runtime,
+        .descriptors = transaction,
+        .resources = resources,
+        .plugin = plugin_reinitializer,
+        .qmp = qmp_reinitializer,
+        .console = console_reinitializer,
+    };
+    int result;
+
+    qemu_crucible_hot_fork_note_child_detail(11);
+    if (!resources || !transaction || !verify_descriptors ||
+        !plugin_reinitializer || !qmp_reinitializer ||
+        !console_reinitializer) {
+        return -EINVAL;
+    }
+    qemu_crucible_hot_fork_note_child_detail(12);
+    if (!resources->sealed || resources->building || resources->attempted ||
+        resources->applied || !transaction->active ||
+        transaction->parent_pid <= 1 || transaction->child_pid != getpid()) {
+        return -EPERM;
+    }
+    qemu_crucible_hot_fork_note_child_detail(13);
+    if (runtime &&
+        (!runtime->active || !runtime->child_prepared ||
+         runtime->child_workers_started || runtime->child_reconstructed ||
+         runtime->async_retained != runtime->async.active ||
+         runtime->rcu.parent_process_id != transaction->parent_pid)) {
+        return -EPERM;
+    }
+    qemu_crucible_hot_fork_note_child_detail(14);
+    if (!crucible_hot_fork_child_resource_plan_valid(
+            resources, &resources->plugin)) {
+        return -EINVAL;
+    }
+    qemu_crucible_hot_fork_note_child_detail(15);
+    if (!qemu_crucible_hot_fork_plugin_child_reinitializer_prepared_for(
+            plugin_reinitializer, &resources->plugin.plan)) {
+        return -EINVAL;
+    }
+    qemu_crucible_hot_fork_note_child_detail(16);
+    if (!qemu_crucible_hot_fork_qmp_child_reinitializer_prepared_for(
+            qmp_reinitializer, &resources->qmp,
+            qmp_reinitializer->runtime,
+            qmp_reinitializer->runtime_opaque)) {
+        return -EINVAL;
+    }
+    qemu_crucible_hot_fork_note_child_detail(17);
+    if (!qemu_crucible_hot_fork_console_child_reinitializer_prepared_for(
+            console_reinitializer, &resources->console,
+            console_reinitializer->runtime,
+            console_reinitializer->runtime_opaque)) {
+        return -EINVAL;
+    }
+
+    resources->attempted = true;
+    result = qemu_crucible_hot_fork_apply_child_resources(
+        transaction, resources->replacements, resources->replacement_count,
+        resources->retained_fds, resources->retained_fd_count,
+        verify_descriptors, descriptor_opaque,
+        crucible_hot_fork_reinitialize_child_subsystems, &reinitializers,
+        resources->shared_mappings, resources->shared_mapping_count);
+    if (result == 0) {
+        qemu_crucible_hot_fork_note_child_detail(9);
+    }
+    if (result == 0 && runtime &&
+        (runtime->active || !runtime->child_reconstructed ||
+         runtime->async.active)) {
+        result = -EPROTO;
+    }
+    if (result == 0) {
+        qemu_crucible_hot_fork_note_child_detail(10);
+        result = crucible_hot_fork_authenticate_diagnostics_target(
+            &resources->diagnostics);
+    }
+    if (result == 0) {
+        resources->applied = true;
+    }
+    return result;
+}
