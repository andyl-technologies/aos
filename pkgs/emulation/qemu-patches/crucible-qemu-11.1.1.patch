+
+static void fixture_workspace_checks(unsigned edition)
+{
+    QemuCruciblePreexecSetupOwner *owner = &preexec_setup_owner;
+    QemuCrucibleWorkspacePurposeOwner observed = { 0 };
+    unsigned saved_edition = owner->selected_edition;
+    unsigned saved_schema = owner->plan.schema;
+    size_t saved_count = owner->descriptor_count;
+    int *slot = &owner->descriptors[QEMU_CRUCIBLE_PREEXEC_SETUP_WORKSPACE_INDEX];
+    struct stat identity;
+
+    /* Only factual roster syntax is exercised here. No real Source, payer or
+     * Original exists in this fixture, and no workspace role is issued. */
+    for (unsigned candidate = 0; candidate <= 7; candidate++) {
+        for (unsigned schema = 0; schema <= 10; schema++) {
+            for (size_t count = 0; count <= 10; count++) {
+                bool expected = (candidate == 5 && schema == 8 && count == 6) ||
+                                (candidate == 6 && schema == 9 && count == 9);
+
+                owner->selected_edition = candidate;
+                owner->plan.schema = schema;
+                owner->descriptor_count = count;
+                g_assert_cmpint(preexec_workspace_roster_matches(owner), ==, expected);
+            }
+        }
+    }
+    owner->selected_edition = edition;
+    owner->plan.schema = edition == 5 ? 8 : 9;
+    owner->descriptor_count = saved_count;
+    g_assert_true(preexec_workspace_roster_matches(owner));
+
+    /* The alias really arrived through SCM_RIGHTS. This leaf observation is
+     * deliberately not a canonical workspace or ownership provider. */
+    g_assert_cmpint(fstat(*slot, &identity), ==, 0);
+    observed.descriptor_slot = slot;
+    observed.descriptor = *slot;
+    observed.allocation_extent = QEMU_CRUCIBLE_PROCESS_WORKSPACE_ALLOCATION_BYTES;
+    observed.device = identity.st_dev;
+    observed.inode = identity.st_ino;
+    g_assert_cmpint(preexec_workspace_alias_current(&observed), ==, 0);
+    observed.allocation_extent--;
+    g_assert_cmpint(preexec_workspace_alias_current(&observed), ==, -ESTALE);
+    observed.allocation_extent++;
+    observed.inode++;
+    g_assert_cmpint(preexec_workspace_alias_current(&observed), ==, -ESTALE);
+    observed.inode--;
+    observed.close_attempted = true;
+    g_assert_cmpint(preexec_workspace_alias_current(&observed), ==, -ESTALE);
+
+    owner->plan.workspace_bytes = 128;
+    g_assert_cmpint(preexec_workspace_construct(owner), <, 0);
+    g_assert_false(owner->workspace.attempted);
+    owner->plan.workspace_bytes = 0;
+    g_assert_cmpint(preexec_workspace_construct(owner), ==, 0);
+    g_assert_false(owner->workspace.attempted);
+    owner->selected_edition = saved_edition;
+    owner->plan.schema = saved_schema;
+}
