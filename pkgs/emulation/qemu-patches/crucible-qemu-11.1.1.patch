+#define qemu_plugin_crucible_native_advance_entry_current_v1(...) refuse_native()
+#define qemu_crucible_preexec_publisher_recipient_current_v1(...) refuse_recipient()
+#define advance_receiver_identity(...) refuse_identity()
+#define advance_publication_current(...) (abort(), -EFAULT)
