+static void test_fractional_virtual_timer_fires_without_instruction(void)
+{
+    QEMUTimer *timer;
+    uint64_t raw_icount = 7;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
