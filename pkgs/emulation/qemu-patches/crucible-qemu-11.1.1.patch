diff --git a/target/arm/crucible-fingerprint.h b/target/arm/crucible-fingerprint.h
new file mode 100644
index 0000000000000000000000000000000000000000..611e1fe055c3d66c75646978a4e2d604a43b7e74
--- /dev/null
+++ b/target/arm/crucible-fingerprint.h
@@ -0,0 +1,132 @@
+/*
+ * ARM CPU fingerprint projection internals
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef TARGET_ARM_CRUCIBLE_FINGERPRINT_H
+#define TARGET_ARM_CRUCIBLE_FINGERPRINT_H
+
+#include "cpu.h"
+#include "migration/qemu-file.h"
+#include "qapi/error.h"
+#include "qemu/timer.h"
+
+static inline void arm_cpu_fingerprint_put_timer(
+    QEMUFile *f, const QEMUTimer *timer)
+{
+    bool present = timer != NULL;
+    bool pending = present && timer_pending(timer);
+
+    qemu_put_byte(f, present);
+    qemu_put_byte(f, pending);
+    if (pending) {
+        bool exact_ps = qemu_timer_exact_virtual_ps_enabled();
+        __int128 expiry = exact_ps ? timer_expire_time_ps_wide(timer) :
+                                     timer_expire_time_ns(timer);
+        unsigned __int128 bits = expiry;
+
+        /* Preserve far-future and negative picosecond deadlines exactly. */
+        qemu_put_byte(f, exact_ps);
+        qemu_put_be64(f, (uint64_t)(bits >> 64));
+        qemu_put_be64(f, (uint64_t)bits);
+    }
+}
+
+static inline bool arm_cpu_crucible_clock_fingerprint_needed(
+    const ARMCPU *cpu)
+{
+    for (size_t i = 0; i < NUM_GTIMERS; i++) {
+        if (cpu->crucible_gt_timer_arm_sequence[i] != 0) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static inline bool arm_cpu_continuation_fingerprint_validate(
+    const ARMCPU *cpu, Error **errp)
+{
+    const CPUARMState *env = &cpu->env;
+
+    if ((env->crucible_hardware_error.synchronous_pending &&
+         env->crucible_hardware_error.asynchronous_pending) ||
+        (env->crucible_hardware_error.fatal &&
+         !env->crucible_hardware_error.synchronous_pending &&
+         !env->crucible_hardware_error.asynchronous_pending)) {
+        error_setg(errp, "ARM CPU has invalid hardware-error state");
+        return false;
+    }
+
+    return true;
+}
+
+static inline void arm_cpu_continuation_fingerprint_put(
+    QEMUFile *f, const ARMCPU *cpu)
+{
+    const CPUARMState *env = &cpu->env;
+    const CPUState *cs = &cpu->parent_obj;
+    bool clock_present;
+    bool hardware_error_pending =
+        env->crucible_hardware_error.synchronous_pending ||
+        env->crucible_hardware_error.asynchronous_pending ||
+        env->crucible_hardware_error.fatal;
+
+    qemu_put_be64(f, env->exclusive_addr);
+    if (env->exclusive_addr != UINT64_MAX) {
+        qemu_put_be64(f, env->exclusive_val);
+        qemu_put_be64(f, env->exclusive_high);
+    }
+
+    qemu_put_byte(f, cs->exception_index != -1);
+    if (cs->exception_index != -1) {
+        qemu_put_be64(f, env->exception.syndrome);
+        qemu_put_be64(f, env->exception.vaddress);
+        qemu_put_be32(f, env->exception.fsr);
+        qemu_put_be32(f, env->exception.target_el);
+    }
+
+    qemu_put_byte(f, env->serror.pending);
+    if (env->serror.pending) {
+        qemu_put_byte(f, env->serror.has_esr);
+        if (env->serror.has_esr) {
+            qemu_put_be64(f, env->serror.esr);
+        }
+    }
+
+    qemu_put_byte(f, hardware_error_pending);
+    if (hardware_error_pending) {
+        qemu_put_be32(f, env->crucible_hardware_error.syndrome);
+        qemu_put_be64(f, env->crucible_hardware_error.address);
+        qemu_put_be64(f, env->crucible_hardware_error.disr);
+        qemu_put_byte(f,
+                      env->crucible_hardware_error.synchronous_pending);
+        qemu_put_byte(f,
+                      env->crucible_hardware_error.asynchronous_pending);
+        qemu_put_byte(f, env->crucible_hardware_error.fatal);
+    }
+
+    qemu_put_byte(f, env->ext_dabt_raised);
+    qemu_put_be32(f, env->irq_line_state);
+    qemu_put_byte(f, env->event_register);
+    qemu_put_be32(f, cpu->power_state);
+
+    for (size_t timer = 0; timer < NUM_GTIMERS; timer++) {
+        arm_cpu_fingerprint_put_timer(f, cpu->gt_timer[timer]);
+    }
+
+    clock_present = arm_cpu_crucible_clock_fingerprint_needed(cpu);
+    qemu_put_byte(f, clock_present);
+    if (clock_present) {
+        for (size_t timer = 0; timer < NUM_GTIMERS; timer++) {
+            qemu_put_be64(f, cpu->crucible_gt_guest_deadline_ps[timer]);
+            qemu_put_be64(f,
+                          cpu->crucible_gt_transform_generation[timer]);
+            qemu_put_be64(f,
+                          cpu->crucible_gt_timer_arm_sequence[timer]);
+        }
+    }
+
+    arm_cpu_fingerprint_put_timer(f, cpu->wfxt_timer);
+}
+
+#endif
diff --git a/target/arm/crucible-register.c b/target/arm/crucible-register.c
new file mode 100644
index 0000000000000000000000000000000000000000..89718011350d0fdda469f15515d7a916d75b1b4d
--- /dev/null
+++ b/target/arm/crucible-register.c
@@ -0,0 +1,976 @@
+/*
+ * Crucible AArch64 architecture register fault targets
+ *
+ * Copyright (c) 2026 ANDYL Technologies
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "cpu.h"
+#include "hw/core/crucible-register-helpers.h"
+#include "cpregs.h"
+#include "internals.h"
+#include "exec/tb-flush.h"
+#include "qemu/crucible-fault.h"
+#include "qemu/main-loop.h"
+
+int aarch64_crucible_register_qom_child(CPUState *cpu, Object **out)
+{
+    if (!cpu || !out || !bql_locked()) {
+        return -EINVAL;
+    }
+    /* cp_regs, raw callbacks and timer/machine effects have separate owners;
+     * none is a separately parented register-read QOM child on this CPU. */
+    *out = NULL;
+    return 0;
+}
+
+#define CRUCIBLE_REG_GROUP_GPR 1
+#define CRUCIBLE_REG_GROUP_CONTROL_FLOW 2
+#define CRUCIBLE_REG_GROUP_FLAGS 3
+#define CRUCIBLE_REG_GROUP_SYSTEM 6
+#define CRUCIBLE_REG_GROUP_FLOAT 8
+#define CRUCIBLE_REG_GROUP_VECTOR 9
+
+#define CRUCIBLE_REG_CAP_IMPULSE (1U << 0)
+#define CRUCIBLE_REG_CAP_PERSISTENT (1U << 1)
+#define CRUCIBLE_REG_CAP_VMSTATE (1U << 2)
+#define CRUCIBLE_REG_SIDE_TB (1U << 1)
+#define CRUCIBLE_REG_SIDE_FLAGS (1U << 2)
+#define CRUCIBLE_REG_SIDE_INTERRUPT (1U << 3)
+#define CRUCIBLE_REG_SIDE_CONTROL_FLOW (1U << 5)
+#define CRUCIBLE_REG_PHASES ((UINT64_C(1) << 10) | (UINT64_C(1) << 11))
+
+enum {
+    A64_CRUCIBLE_X_FIRST = 1,
+    A64_CRUCIBLE_X_LAST = 31,
+    A64_CRUCIBLE_SP = 32,
+    A64_CRUCIBLE_PC = 33,
+    A64_CRUCIBLE_PSTATE = 34,
+    A64_CRUCIBLE_V_FIRST = 35,
+    A64_CRUCIBLE_V_LAST = 66,
+    A64_CRUCIBLE_FPSR = 67,
+    A64_CRUCIBLE_FPCR = 68,
+    A64_CRUCIBLE_BASE_COUNT = A64_CRUCIBLE_FPCR,
+    A64_CRUCIBLE_SVE_Z_COUNT = 32,
+    A64_CRUCIBLE_SVE_P_COUNT = 16,
+    A64_CRUCIBLE_SVE_COUNT = 49,
+};
+
+static void a64_crucible_masks(CrucibleCPURegisterCapability *capability,
+                                uint64_t writable)
+{
+    size_t bytes = DIV_ROUND_UP(capability->width_bits, 8);
+
+    capability->mask_bytes = bytes;
+    memset(capability->writable_mask, 0, bytes);
+    memset(capability->ignored_mask, 0, bytes);
+    memset(capability->read_only_mask, 0, bytes);
+    memset(capability->reserved_mask, 0xff, bytes);
+    if (capability->width_bits % 8) {
+        capability->reserved_mask[bytes - 1] =
+            (1U << (capability->width_bits % 8)) - 1;
+    }
+    for (uint32_t bit = 0; bit < MIN(capability->width_bits, 64); bit++) {
+        if (writable & (UINT64_C(1) << bit)) {
+            capability->writable_mask[bit / 8] |= 1U << (bit % 8);
+            capability->reserved_mask[bit / 8] &= ~(1U << (bit % 8));
+        }
+    }
+}
+
+static void a64_crucible_all_writable(
+    CrucibleCPURegisterCapability *capability)
+{
+    size_t bytes = DIV_ROUND_UP(capability->width_bits, 8);
+
+    a64_crucible_masks(capability, UINT64_MAX);
+    if (capability->width_bits > 64) {
+        memset(capability->writable_mask + 8, 0xff, bytes - 8);
+        memset(capability->reserved_mask + 8, 0, bytes - 8);
+        if (capability->width_bits % 8) {
+            capability->writable_mask[bytes - 1] =
+                (1U << (capability->width_bits % 8)) - 1;
+        }
+    }
+    capability->model_phase_mask = CRUCIBLE_REG_PHASES;
+    capability->capabilities = CRUCIBLE_REG_CAP_IMPULSE |
+        CRUCIBLE_REG_CAP_PERSISTENT | CRUCIBLE_REG_CAP_VMSTATE;
+}
+
+static void a64_crucible_writable(
+    CrucibleCPURegisterCapability *capability, uint64_t writable)
+{
+    a64_crucible_masks(capability, writable);
+    capability->model_phase_mask = CRUCIBLE_REG_PHASES;
+    capability->capabilities = CRUCIBLE_REG_CAP_IMPULSE |
+        CRUCIBLE_REG_CAP_PERSISTENT | CRUCIBLE_REG_CAP_VMSTATE;
+}
+
+static void a64_crucible_read_only(
+    CrucibleCPURegisterCapability *capability)
+{
+    size_t bytes = DIV_ROUND_UP(capability->width_bits, 8);
+
+    a64_crucible_masks(capability, 0);
+    memcpy(capability->read_only_mask, capability->reserved_mask, bytes);
+    memset(capability->reserved_mask, 0, bytes);
+    capability->model_phase_mask = 0;
+    capability->side_effects = 0;
+    capability->capabilities = CRUCIBLE_REG_CAP_VMSTATE;
+}
+
+static bool a64_crucible_has_sve(ARMCPU *cpu)
+{
+    return cpu_isar_feature(aa64_sve, cpu) && cpu->sve_max_vq != 0;
+}
+
+static size_t a64_crucible_exception_count(CPUARMState *env)
+{
+    return 2 + (arm_feature(env, ARM_FEATURE_EL2) ? 2 : 0) +
+        (arm_feature(env, ARM_FEATURE_EL3) ? 2 : 0);
+}
+
+static bool a64_crucible_exception_register(
+    ARMCPU *cpu, uint32_t id, unsigned int *el, bool *is_spsr)
+{
+    CPUARMState *env = &cpu->env;
+    uint32_t relative;
+
+    if (id <= A64_CRUCIBLE_BASE_COUNT ||
+        id > A64_CRUCIBLE_BASE_COUNT + a64_crucible_exception_count(env)) {
+        return false;
+    }
+    relative = id - A64_CRUCIBLE_BASE_COUNT - 1;
+    if (relative < 2) {
+        *el = 1;
+    } else if (arm_feature(env, ARM_FEATURE_EL2) && relative < 4) {
+        *el = 2;
+        relative -= 2;
+    } else {
+        *el = 3;
+        relative -= arm_feature(env, ARM_FEATURE_EL2) ? 4 : 2;
+    }
+    *is_spsr = relative == 1;
+    return true;
+}
+
+static bool a64_crucible_is_explicit_exception_sysreg(
+    const ARMCPRegInfo *ri)
+{
+    return ri->name &&
+        (g_str_equal(ri->name, "ELR_EL1") ||
+         g_str_equal(ri->name, "SPSR_EL1") ||
+         g_str_equal(ri->name, "ELR_EL2") ||
+         g_str_equal(ri->name, "SPSR_EL2") ||
+         g_str_equal(ri->name, "ELR_EL3") ||
+         g_str_equal(ri->name, "SPSR_EL3"));
+}
+
+static gint a64_crucible_compare_key(gconstpointer a, gconstpointer b)
+{
+    uint32_t left = *(const uint32_t *)a;
+    uint32_t right = *(const uint32_t *)b;
+
+    return left > right ? 1 : left < right ? -1 : 0;
+}
+
+static bool a64_crucible_sysreg_in_manifest(const ARMCPRegInfo *ri)
+{
+    return ri->state == ARM_CP_STATE_AA64 &&
+        !(ri->type & (ARM_CP_NO_RAW | ARM_CP_NO_GDB)) &&
+        !a64_crucible_is_explicit_exception_sysreg(ri);
+}
+
+static GArray *a64_crucible_sysreg_keys(ARMCPU *cpu)
+{
+    GArray *keys = g_array_new(false, false, sizeof(uint32_t));
+    GHashTableIter iter;
+    gpointer raw_key;
+    gpointer raw_value;
+
+    g_hash_table_iter_init(&iter, cpu->cp_regs);
+    while (g_hash_table_iter_next(&iter, &raw_key, &raw_value)) {
+        ARMCPRegInfo *ri = raw_value;
+        uint32_t key = (uintptr_t)raw_key;
+
+        if (a64_crucible_sysreg_in_manifest(ri)) {
+            g_array_append_val(keys, key);
+        }
+    }
+    g_array_sort(keys, a64_crucible_compare_key);
+    return keys;
+}
+
+static size_t a64_crucible_fixed_count(ARMCPU *cpu)
+{
+    return A64_CRUCIBLE_BASE_COUNT +
+        a64_crucible_exception_count(&cpu->env) +
+        (a64_crucible_has_sve(cpu) ? A64_CRUCIBLE_SVE_COUNT : 0);
+}
+
+static const ARMCPRegInfo *a64_crucible_sysreg(ARMCPU *cpu, uint32_t id)
+{
+    g_autoptr(GArray) keys = a64_crucible_sysreg_keys(cpu);
+    size_t fixed = a64_crucible_fixed_count(cpu);
+    size_t index;
+
+    if (id <= fixed) {
+        return NULL;
+    }
+    index = id - fixed - 1;
+    if (index >= keys->len) {
+        return NULL;
+    }
+    return get_arm_cp_reginfo(cpu->cp_regs,
+                              g_array_index(keys, uint32_t, index));
+}
+
+size_t aarch64_crucible_register_count(CPUState *cs)
+{
+    ARMCPU *cpu = ARM_CPU(cs);
+    GHashTableIter iter;
+    gpointer raw_value;
+    size_t count = a64_crucible_fixed_count(cpu);
+
+    /* Preflight observes the actual realized registry without constructing a
+     * sorted workspace. The allocating descriptor wrapper still owns its
+     * separate storage. */
+    g_hash_table_iter_init(&iter, cpu->cp_regs);
+    while (g_hash_table_iter_next(&iter, NULL, &raw_value)) {
+        if (a64_crucible_sysreg_in_manifest(raw_value)) {
+            if (count == SIZE_MAX) {
+                return SIZE_MAX;
+            }
+            count++;
+        }
+    }
+    return count;
+}
+
+static bool a64_crucible_sysreg_shape(
+    const ARMCPRegInfo *ri, uint32_t key, char *name, size_t capacity,
+    size_t *name_bytes, uint32_t *width_bits)
+{
+    CrucibleRegisterNameBuilder builder = {
+        .destination = name, .capacity = capacity,
+    };
+    const unsigned char *stem = (const unsigned char *)(ri->name ?: "unnamed");
+
+    crucible_register_name_text(&builder, "sysreg-");
+    for (; *stem; stem++) {
+        char value = g_ascii_tolower(*stem);
+
+        if (!g_ascii_isalnum(value)) {
+            value = '-';
+        }
+        crucible_register_name_append(&builder, &value, 1);
+    }
+    crucible_register_name_text(&builder, "-");
+    crucible_register_name_hex_key(&builder, key);
+    if (builder.failed) {
+        return false;
+    }
+    *name_bytes = builder.length + 1;
+    *width_bits = cpreg_field_type(ri) == MO_64 ? 64 : 32;
+    return true;
+}
+
+static bool aarch64_crucible_register_shape(
+    CPUState *cs, size_t index, const CrucibleCPURegisterKeyView *keys,
+    char *name, size_t capacity, size_t *name_bytes, uint32_t *width_bits)
+{
+    ARMCPU *cpu = ARM_CPU(cs);
+    CrucibleRegisterNameBuilder builder = {
+        .destination = name, .capacity = capacity,
+    };
+    size_t fixed = a64_crucible_fixed_count(cpu);
+    unsigned int exception_el;
+    bool exception_spsr;
+    uint32_t width, id;
+
+    if (index >= UINT32_MAX) {
+        return false;
+    }
+    id = index + 1;
+    if (id <= A64_CRUCIBLE_X_LAST) {
+        crucible_register_name_text(&builder, "x");
+        crucible_register_name_decimal(&builder, id - 1);
+        width = 64;
+    } else if (id == A64_CRUCIBLE_SP || id == A64_CRUCIBLE_PC) {
+        crucible_register_name_text(
+            &builder, id == A64_CRUCIBLE_SP ? "sp" : "pc");
+        width = 64;
+    } else if (id == A64_CRUCIBLE_PSTATE) {
+        crucible_register_name_text(&builder, "pstate");
+        width = 32;
+    } else if (id <= A64_CRUCIBLE_V_LAST) {
+        crucible_register_name_text(&builder, "v");
+        crucible_register_name_decimal(&builder, id - A64_CRUCIBLE_V_FIRST);
+        width = 128;
+    } else if (id == A64_CRUCIBLE_FPSR || id == A64_CRUCIBLE_FPCR) {
+        crucible_register_name_text(
+            &builder, id == A64_CRUCIBLE_FPSR ? "fpsr" : "fpcr");
+        width = 32;
+    } else if (a64_crucible_exception_register(
+                   cpu, id, &exception_el, &exception_spsr)) {
+        crucible_register_name_text(
+            &builder, exception_spsr ? "spsr-el" : "elr-el");
+        crucible_register_name_decimal(&builder, exception_el);
+        width = 64;
+    } else if (a64_crucible_has_sve(cpu) && id <= fixed) {
+        uint32_t relative = id - A64_CRUCIBLE_BASE_COUNT -
+            a64_crucible_exception_count(&cpu->env) - 1;
+
+        if (cpu->sve_max_vq > UINT32_MAX / 128) {
+            return false;
+        }
+        if (relative < A64_CRUCIBLE_SVE_Z_COUNT) {
+            crucible_register_name_text(&builder, "z");
+            crucible_register_name_decimal(&builder, relative);
+            width = cpu->sve_max_vq * 128;
+        } else if (relative < A64_CRUCIBLE_SVE_Z_COUNT +
+                   A64_CRUCIBLE_SVE_P_COUNT) {
+            crucible_register_name_text(&builder, "p");
+            crucible_register_name_decimal(
+                &builder, relative - A64_CRUCIBLE_SVE_Z_COUNT);
+            width = cpu->sve_max_vq * 16;
+        } else {
+            crucible_register_name_text(&builder, "ffr");
+            width = cpu->sve_max_vq * 16;
+        }
+    } else {
+        size_t sys_index = index - fixed;
+        const ARMCPRegInfo *ri;
+        uint32_t key;
+
+        if (!keys || sys_index >= keys->count) {
+            return false;
+        }
+        key = keys->keys[sys_index];
+        ri = get_arm_cp_reginfo(cpu->cp_regs, key);
+        return ri && a64_crucible_sysreg_in_manifest(ri) &&
+            a64_crucible_sysreg_shape(ri, key, name, capacity,
+                                      name_bytes, width_bits);
+    }
+    if (builder.failed) {
+        return false;
+    }
+    *name_bytes = builder.length + 1;
+    *width_bits = width;
+    return true;
+}
+
+bool aarch64_crucible_register_geometry(
+    CPUState *cs, CrucibleCPURegisterGeometry *out)
+{
+    CrucibleCPURegisterGeometry geometry = { .cpu = cs };
+    GHashTableIter iter;
+    gpointer raw_key, raw_value;
+    ARMCPU *cpu;
+    size_t fixed;
+
+    if (!cs || !out) {
+        return false;
+    }
+    cpu = ARM_CPU(cs);
+    fixed = a64_crucible_fixed_count(cpu);
+    for (size_t index = 0; index < fixed; index++) {
+        size_t name_bytes;
+        uint32_t width_bits;
+
+        if (!aarch64_crucible_register_shape(cs, index, NULL, NULL, 0,
+                                             &name_bytes, &width_bits) ||
+            !crucible_register_geometry_add(&geometry, name_bytes,
+                                             width_bits)) {
+            return false;
+        }
+    }
+    g_hash_table_iter_init(&iter, cpu->cp_regs);
+    while (g_hash_table_iter_next(&iter, &raw_key, &raw_value)) {
+        const ARMCPRegInfo *ri = raw_value;
+        size_t name_bytes;
+        uint32_t width_bits;
+
+        if (!a64_crucible_sysreg_in_manifest(ri)) {
+            continue;
+        }
+        if (geometry.register_count == UINT32_MAX ||
+            !a64_crucible_sysreg_shape(ri, (uintptr_t)raw_key, NULL, 0,
+                                       &name_bytes, &width_bits) ||
+            !crucible_register_geometry_add(&geometry, name_bytes,
+                                             width_bits)) {
+            return false;
+        }
+        geometry.key_count++;
+    }
+    *out = geometry;
+    return true;
+}
+
+static bool aarch64_crucible_register_keys_current(
+    CPUState *cs, const CrucibleCPURegisterKeyView *view,
+    const CrucibleCPURegisterGeometry *geometry)
+{
+    ARMCPU *cpu = ARM_CPU(cs);
+
+    if (!view || view->cpu != cs || view->count != geometry->key_count ||
+        (view->count && !view->keys)) {
+        return false;
+    }
+    /* Strict order, actual eligibility and independently counted cardinality
+     * establish the factual set; these bytes still issue no authority. */
+    for (size_t index = 0; index < view->count; index++) {
+        const ARMCPRegInfo *ri =
+            get_arm_cp_reginfo(cpu->cp_regs, view->keys[index]);
+
+        if ((index && view->keys[index - 1] >= view->keys[index]) ||
+            !ri || !a64_crucible_sysreg_in_manifest(ri)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+bool aarch64_crucible_register_keys_into(
+    CPUState *cs, uint32_t *keys, size_t capacity,
+    CrucibleCPURegisterKeyView *out)
+{
+    CrucibleCPURegisterGeometry geometry, current;
+    CrucibleCPURegisterKeyView view;
+    GHashTableIter iter;
+    gpointer raw_key, raw_value;
+    size_t count = 0;
+    ARMCPU *cpu;
+
+    if (!out || !aarch64_crucible_register_geometry(cs, &geometry) ||
+        capacity < geometry.key_count || (geometry.key_count && !keys) ||
+        geometry.key_count > SIZE_MAX / sizeof(*keys) ||
+        !crucible_register_spans_disjoint(
+            keys, geometry.key_count * sizeof(*keys), out, sizeof(*out))) {
+        return false;
+    }
+    cpu = ARM_CPU(cs);
+    g_hash_table_iter_init(&iter, cpu->cp_regs);
+    while (g_hash_table_iter_next(&iter, &raw_key, &raw_value)) {
+        if (a64_crucible_sysreg_in_manifest(raw_value)) {
+            if (count >= geometry.key_count) {
+                return false;
+            }
+            keys[count++] = (uintptr_t)raw_key;
+        }
+    }
+    if (count != geometry.key_count) {
+        return false;
+    }
+    crucible_register_keys_sort(keys, count);
+    view = (CrucibleCPURegisterKeyView) {
+        .cpu = cs, .keys = keys, .count = count,
+    };
+    if (!aarch64_crucible_register_geometry(cs, &current) ||
+        !crucible_register_geometry_equal(&geometry, &current) ||
+        !aarch64_crucible_register_keys_current(cs, &view, &current)) {
+        return false;
+    }
+    *out = view;
+    return true;
+}
+
+static bool aarch64_crucible_register_describe_prepaid(
+    CPUState *cs, size_t index,
+    const CrucibleCPURegisterKeyView *keys,
+    const CrucibleCPURegisterBuffers *buffers,
+    CrucibleCPURegisterCapability *capability)
+{
+    ARMCPU *cpu = ARM_CPU(cs);
+    bool sve = a64_crucible_has_sve(cpu);
+    uint32_t id = index + 1;
+    size_t fixed = a64_crucible_fixed_count(cpu);
+    size_t exception_count = a64_crucible_exception_count(&cpu->env);
+    unsigned int exception_el;
+    bool exception_spsr;
+
+    if (!capability || id > aarch64_crucible_register_count(cs)) {
+        return false;
+    }
+    *capability = (CrucibleCPURegisterCapability) {
+        .numeric_id = id, .name = buffers->name,
+        .writable_mask = buffers->writable_mask,
+        .reserved_mask = buffers->reserved_mask,
+        .ignored_mask = buffers->ignored_mask,
+        .read_only_mask = buffers->read_only_mask,
+    };
+    if (id >= A64_CRUCIBLE_X_FIRST && id <= A64_CRUCIBLE_X_LAST) {
+        capability->width_bits = 64;
+        capability->group = CRUCIBLE_REG_GROUP_GPR;
+        a64_crucible_all_writable(capability);
+    } else if (id == A64_CRUCIBLE_SP) {
+        capability->width_bits = 64;
+        capability->group = CRUCIBLE_REG_GROUP_GPR;
+        a64_crucible_all_writable(capability);
+    } else if (id == A64_CRUCIBLE_PC) {
+        capability->width_bits = 64;
+        capability->group = CRUCIBLE_REG_GROUP_CONTROL_FLOW;
+        capability->side_effects = CRUCIBLE_REG_SIDE_TB |
+            CRUCIBLE_REG_SIDE_CONTROL_FLOW;
+        a64_crucible_all_writable(capability);
+    } else if (id == A64_CRUCIBLE_PSTATE) {
+        capability->width_bits = 32;
+        capability->group = CRUCIBLE_REG_GROUP_FLAGS;
+        capability->side_effects = CRUCIBLE_REG_SIDE_TB |
+            CRUCIBLE_REG_SIDE_FLAGS | CRUCIBLE_REG_SIDE_INTERRUPT;
+        a64_crucible_writable(capability, PSTATE_NZCV | PSTATE_DAIF);
+    } else if (id >= A64_CRUCIBLE_V_FIRST && id <= A64_CRUCIBLE_V_LAST) {
+        capability->width_bits = 128;
+        capability->group = CRUCIBLE_REG_GROUP_VECTOR;
+        a64_crucible_all_writable(capability);
+    } else if (id == A64_CRUCIBLE_FPSR || id == A64_CRUCIBLE_FPCR) {
+        capability->width_bits = 32;
+        capability->group = CRUCIBLE_REG_GROUP_FLOAT;
+        capability->side_effects = CRUCIBLE_REG_SIDE_FLAGS;
+        a64_crucible_writable(capability, id == A64_CRUCIBLE_FPSR ?
+                               FPSCR_FPSR_MASK : FPSCR_FPCR_MASK);
+    } else if (a64_crucible_exception_register(
+                   cpu, id, &exception_el, &exception_spsr)) {
+        capability->width_bits = 64;
+        capability->group = exception_spsr ? CRUCIBLE_REG_GROUP_FLAGS :
+            CRUCIBLE_REG_GROUP_CONTROL_FLOW;
+        capability->side_effects = 0;
+        if (exception_spsr) {
+            a64_crucible_writable(
+                capability, PSTATE_NZCV | PSTATE_DAIF | PSTATE_BTYPE |
+                PSTATE_SSBS | PSTATE_IL | PSTATE_SS | PSTATE_PAN |
+                PSTATE_UAO | PSTATE_DIT | PSTATE_TCO | PSTATE_M);
+        } else {
+            a64_crucible_all_writable(capability);
+        }
+    } else if (sve && id <= fixed) {
+        uint32_t relative = id - A64_CRUCIBLE_BASE_COUNT -
+            exception_count - 1;
+
+        capability->group = CRUCIBLE_REG_GROUP_VECTOR;
+        if (relative < A64_CRUCIBLE_SVE_Z_COUNT) {
+            capability->width_bits = cpu->sve_max_vq * 128;
+        } else if (relative < A64_CRUCIBLE_SVE_Z_COUNT +
+                   A64_CRUCIBLE_SVE_P_COUNT) {
+            capability->width_bits = cpu->sve_max_vq * 16;
+        } else {
+            capability->width_bits = cpu->sve_max_vq * 16;
+        }
+        a64_crucible_all_writable(capability);
+    } else {
+        size_t sys_index = id - fixed - 1;
+        uint32_t key = keys->keys[sys_index];
+        const ARMCPRegInfo *ri = get_arm_cp_reginfo(cpu->cp_regs, key);
+
+        capability->width_bits = cpreg_field_type(ri) == MO_64 ? 64 : 32;
+        capability->group = CRUCIBLE_REG_GROUP_SYSTEM;
+        a64_crucible_read_only(capability);
+    }
+    return capability->name != NULL;
+}
+
+bool aarch64_crucible_register_describe_into(
+    CPUState *cs, size_t index, const CrucibleCPURegisterGeometry *expected,
+    const CrucibleCPURegisterKeyView *keys,
+    const CrucibleCPURegisterBuffers *buffers,
+    CrucibleCPURegisterCapability *out)
+{
+    CrucibleCPURegisterGeometry current;
+    CrucibleCPURegisterCapability capability;
+    size_t name_bytes;
+    uint32_t width_bits;
+
+    if (!out || !aarch64_crucible_register_geometry(cs, &current) ||
+        !crucible_register_geometry_equal(expected, &current) ||
+        !aarch64_crucible_register_keys_current(cs, keys, &current) ||
+        !aarch64_crucible_register_shape(cs, index, keys, NULL, 0,
+                                       &name_bytes, &width_bits) ||
+        !crucible_register_buffers_fit(buffers, name_bytes,
+                                      ((uint64_t)width_bits + 7) / 8) ||
+        !crucible_register_output_spans(buffers, name_bytes,
+                                       ((uint64_t)width_bits + 7) / 8,
+                                       expected, keys, out)) {
+        return false;
+    }
+    if (!aarch64_crucible_register_shape(cs, index, keys,
+                                       buffers->name, buffers->name_capacity,
+                                       &name_bytes, &width_bits) ||
+        !aarch64_crucible_register_describe_prepaid(cs, index, keys,
+                                                  buffers, &capability)) {
+        return false;
+    }
+    *out = capability;
+    return true;
+}
+
+bool aarch64_crucible_register_describe(
+    CPUState *cs, size_t index, CrucibleCPURegisterCapability *out)
+{
+    CrucibleCPURegisterGeometry geometry;
+    CrucibleCPURegisterKeyView view;
+    CrucibleCPURegisterCapability capability;
+    CrucibleCPURegisterBuffers buffers;
+    g_autofree uint32_t *keys = NULL;
+    size_t name_bytes, mask_bytes;
+    uint32_t width_bits;
+
+    if (!out || !aarch64_crucible_register_geometry(cs, &geometry) ||
+        index >= geometry.register_count) {
+        return false;
+    }
+    if (geometry.key_count > SIZE_MAX / sizeof(*keys)) {
+        return false;
+    }
+    if (geometry.key_count) {
+        keys = g_new(uint32_t, geometry.key_count);
+    }
+    if (!aarch64_crucible_register_keys_into(cs, keys, geometry.key_count,
+                                             &view) ||
+        !aarch64_crucible_register_shape(cs, index, &view, NULL, 0,
+                                       &name_bytes, &width_bits)) {
+        return false;
+    }
+    mask_bytes = ((uint64_t)width_bits + 7) / 8;
+    buffers = (CrucibleCPURegisterBuffers) {
+        .name = g_malloc(name_bytes), .name_capacity = name_bytes,
+        .writable_mask = g_malloc0(mask_bytes),
+        .reserved_mask = g_malloc0(mask_bytes),
+        .ignored_mask = g_malloc0(mask_bytes),
+        .read_only_mask = g_malloc0(mask_bytes),
+        .mask_capacity = mask_bytes,
+    };
+    if (!aarch64_crucible_register_describe_into(cs, index, &geometry, &view,
+                                               &buffers, &capability)) {
+        g_free(buffers.name);
+        g_free(buffers.writable_mask);
+        g_free(buffers.reserved_mask);
+        g_free(buffers.ignored_mask);
+        g_free(buffers.read_only_mask);
+        return false;
+    }
+    *out = capability;
+    return true;
+}
+
+static const ARMCPRegInfo *a64_crucible_sysreg_from_keys(
+    ARMCPU *cpu, uint32_t id, const CrucibleCPURegisterKeyView *keys)
+{
+    size_t fixed = a64_crucible_fixed_count(cpu);
+    size_t index;
+
+    if (!keys) {
+        return a64_crucible_sysreg(cpu, id);
+    }
+    if (id <= fixed) {
+        return NULL;
+    }
+    index = id - fixed - 1;
+    return index < keys->count ?
+        get_arm_cp_reginfo(cpu->cp_regs, keys->keys[index]) : NULL;
+}
+
+static int a64_crucible_width(
+    ARMCPU *cpu, uint32_t id, const CrucibleCPURegisterKeyView *keys)
+{
+    size_t fixed = a64_crucible_fixed_count(cpu);
+    size_t exception_count = a64_crucible_exception_count(&cpu->env);
+    unsigned int exception_el;
+    bool exception_spsr;
+
+    if (id >= A64_CRUCIBLE_X_FIRST && id <= A64_CRUCIBLE_PC) {
+        return 8;
+    }
+    if (id == A64_CRUCIBLE_PSTATE || id == A64_CRUCIBLE_FPSR ||
+        id == A64_CRUCIBLE_FPCR) {
+        return 4;
+    }
+    if (id >= A64_CRUCIBLE_V_FIRST && id <= A64_CRUCIBLE_V_LAST) {
+        return 16;
+    }
+    if (a64_crucible_exception_register(
+            cpu, id, &exception_el, &exception_spsr)) {
+        return 8;
+    }
+    if (a64_crucible_has_sve(cpu) &&
+        id > A64_CRUCIBLE_BASE_COUNT + exception_count &&
+        id <= fixed) {
+        uint32_t relative = id - A64_CRUCIBLE_BASE_COUNT -
+            exception_count - 1;
+        return relative < A64_CRUCIBLE_SVE_Z_COUNT ?
+            cpu->sve_max_vq * 16 : cpu->sve_max_vq * 2;
+    }
+    const ARMCPRegInfo *ri = a64_crucible_sysreg_from_keys(cpu, id, keys);
+    return ri ? (cpreg_field_type(ri) == MO_64 ? 8 : 4) : -EINVAL;
+}
+
+static int aarch64_crucible_register_read_with_keys(
+    CPUState *cs, uint32_t id, const CrucibleCPURegisterKeyView *keys,
+    uint8_t *value, size_t value_len)
+{
+    ARMCPU *cpu = ARM_CPU(cs);
+    CPUARMState *env = &cpu->env;
+    int expected = a64_crucible_width(cpu, id, keys);
+    uint64_t scalar = 0;
+    unsigned int exception_el;
+    bool exception_spsr;
+
+    if (!value || expected < 0 || value_len != expected) {
+        return -EINVAL;
+    }
+    if (id >= A64_CRUCIBLE_X_FIRST && id <= A64_CRUCIBLE_X_LAST) {
+        scalar = env->xregs[id - 1];
+    } else if (id == A64_CRUCIBLE_SP) {
+        scalar = env->xregs[31];
+    } else if (id == A64_CRUCIBLE_PC) {
+        scalar = env->pc;
+    } else if (id == A64_CRUCIBLE_PSTATE) {
+        scalar = pstate_read(env);
+    } else if (id >= A64_CRUCIBLE_V_FIRST && id <= A64_CRUCIBLE_V_LAST) {
+        uint64_t *reg = aa64_vfp_qreg(env, id - A64_CRUCIBLE_V_FIRST);
+        stq_le_p(value, reg[0]);
+        stq_le_p(value + 8, reg[1]);
+        return expected;
+    } else if (id == A64_CRUCIBLE_FPSR) {
+        scalar = vfp_get_fpsr(env);
+    } else if (id == A64_CRUCIBLE_FPCR) {
+        scalar = vfp_get_fpcr(env);
+    } else if (a64_crucible_exception_register(
+                   cpu, id, &exception_el, &exception_spsr)) {
+        scalar = exception_spsr ?
+            env->banked_spsr[aarch64_banked_spsr_index(exception_el)] :
+            env->elr_el[exception_el];
+    } else if (a64_crucible_has_sve(cpu) &&
+               id > A64_CRUCIBLE_BASE_COUNT +
+                    a64_crucible_exception_count(env) &&
+               id <= a64_crucible_fixed_count(cpu)) {
+        uint32_t relative = id - A64_CRUCIBLE_BASE_COUNT -
+            a64_crucible_exception_count(env) - 1;
+
+        if (relative < A64_CRUCIBLE_SVE_Z_COUNT) {
+            for (int vq = 0; vq < cpu->sve_max_vq; vq++) {
+                stq_le_p(value + vq * 16, env->vfp.zregs[relative].d[vq * 2]);
+                stq_le_p(value + vq * 16 + 8,
+                         env->vfp.zregs[relative].d[vq * 2 + 1]);
+            }
+        } else {
+            uint32_t preg = relative - A64_CRUCIBLE_SVE_Z_COUNT;
+            for (int vq = 0; vq < cpu->sve_max_vq; vq += 4) {
+                size_t offset = (vq / 4) * 8;
+                size_t chunk = MIN(8, expected - offset);
+                uint8_t encoded[8];
+
+                stq_le_p(encoded, env->vfp.pregs[preg].p[vq / 4]);
+                memcpy(value + offset, encoded, chunk);
+            }
+        }
+        return expected;
+    } else {
+        const ARMCPRegInfo *ri = a64_crucible_sysreg_from_keys(cpu, id, keys);
+        scalar = read_raw_cp_reg(env, ri);
+    }
+    if (expected == 4) {
+        stl_le_p(value, scalar);
+    } else {
+        stq_le_p(value, scalar);
+    }
+    return expected;
+}
+
+static int aarch64_crucible_register_validate_write_with_keys(
+    CPUState *cs, uint32_t id, const CrucibleCPURegisterKeyView *keys,
+    const uint8_t *value, size_t value_len)
+{
+    ARMCPU *cpu = ARM_CPU(cs);
+    int expected = a64_crucible_width(cpu, id, keys);
+
+    if (!value || expected < 0 || value_len != expected ||
+        id > a64_crucible_fixed_count(cpu)) {
+        return -EINVAL;
+    }
+    return expected;
+}
+
+static int aarch64_crucible_register_write_with_keys(
+    CPUState *cs, uint32_t id, const CrucibleCPURegisterKeyView *keys,
+    const uint8_t *value,
+    size_t value_len, uint32_t *performed_side_effects)
+{
+    ARMCPU *cpu = ARM_CPU(cs);
+    CPUARMState *env = &cpu->env;
+    int expected = a64_crucible_width(cpu, id, keys);
+    uint64_t scalar;
+    uint32_t effects = 0;
+    unsigned int exception_el;
+    bool exception_spsr;
+
+    if (!performed_side_effects || expected < 0 ||
+        aarch64_crucible_register_validate_write_with_keys(
+            cs, id, keys, value, value_len) != expected) {
+        return -EINVAL;
+    }
+    /* Vector/predicate writes consume their own exact bytes below. */
+    scalar = expected == 4 ? ldl_le_p(value) :
+        expected == 8 ? ldq_le_p(value) : 0;
+    if (id >= A64_CRUCIBLE_X_FIRST && id <= A64_CRUCIBLE_X_LAST) {
+        env->xregs[id - 1] = scalar;
+    } else if (id == A64_CRUCIBLE_SP) {
+        env->xregs[31] = scalar;
+    } else if (id == A64_CRUCIBLE_PC) {
+        env->pc = scalar;
+        effects = CRUCIBLE_REG_SIDE_TB | CRUCIBLE_REG_SIDE_CONTROL_FLOW;
+    } else if (id == A64_CRUCIBLE_PSTATE) {
+        uint32_t old = pstate_read(env);
+        pstate_write(env, (old & ~(PSTATE_NZCV | PSTATE_DAIF)) |
+                     (scalar & (PSTATE_NZCV | PSTATE_DAIF)));
+        arm_rebuild_hflags(env);
+        effects = CRUCIBLE_REG_SIDE_TB | CRUCIBLE_REG_SIDE_FLAGS |
+            CRUCIBLE_REG_SIDE_INTERRUPT;
+    } else if (id >= A64_CRUCIBLE_V_FIRST && id <= A64_CRUCIBLE_V_LAST) {
+        uint64_t *reg = aa64_vfp_qreg(env, id - A64_CRUCIBLE_V_FIRST);
+        reg[0] = ldq_le_p(value);
+        reg[1] = ldq_le_p(value + 8);
+    } else if (id == A64_CRUCIBLE_FPSR) {
+        vfp_set_fpsr(env, scalar);
+        effects = CRUCIBLE_REG_SIDE_FLAGS;
+    } else if (id == A64_CRUCIBLE_FPCR) {
+        vfp_set_fpcr(env, scalar);
+        effects = CRUCIBLE_REG_SIDE_FLAGS;
+    } else if (a64_crucible_exception_register(
+                   cpu, id, &exception_el, &exception_spsr)) {
+        if (exception_spsr) {
+            const uint64_t writable = PSTATE_NZCV | PSTATE_DAIF |
+                PSTATE_BTYPE | PSTATE_SSBS | PSTATE_IL | PSTATE_SS |
+                PSTATE_PAN | PSTATE_UAO | PSTATE_DIT | PSTATE_TCO |
+                PSTATE_M;
+            uint64_t *spsr = &env->banked_spsr[
+                aarch64_banked_spsr_index(exception_el)];
+
+            *spsr = (*spsr & ~writable) | (scalar & writable);
+        } else {
+            env->elr_el[exception_el] = scalar;
+        }
+    } else if (a64_crucible_has_sve(cpu) &&
+               id > A64_CRUCIBLE_BASE_COUNT +
+                    a64_crucible_exception_count(env) &&
+               id <= a64_crucible_fixed_count(cpu)) {
+        uint32_t relative = id - A64_CRUCIBLE_BASE_COUNT -
+            a64_crucible_exception_count(env) - 1;
+
+        if (relative < A64_CRUCIBLE_SVE_Z_COUNT) {
+            for (int vq = 0; vq < cpu->sve_max_vq; vq++) {
+                env->vfp.zregs[relative].d[vq * 2] =
+                    ldq_le_p(value + vq * 16);
+                env->vfp.zregs[relative].d[vq * 2 + 1] =
+                    ldq_le_p(value + vq * 16 + 8);
+            }
+        } else {
+            uint32_t preg = relative - A64_CRUCIBLE_SVE_Z_COUNT;
+            for (int vq = 0; vq < cpu->sve_max_vq; vq += 4) {
+                size_t offset = (vq / 4) * 8;
+                size_t chunk = MIN(8, expected - offset);
+                uint8_t encoded[8];
+
+                stq_le_p(encoded, env->vfp.pregs[preg].p[vq / 4]);
+                memcpy(encoded, value + offset, chunk);
+                env->vfp.pregs[preg].p[vq / 4] = ldq_le_p(encoded);
+            }
+        }
+    } else {
+        goto invalid;
+    }
+    if (effects & CRUCIBLE_REG_SIDE_TB) {
+        tb_flush__exclusive_or_serial();
+    }
+    if (effects & CRUCIBLE_REG_SIDE_CONTROL_FLOW) {
+        cpu_exit(cs);
+    }
+    *performed_side_effects = effects;
+    return expected;
+
+invalid:
+    return -EINVAL;
+}
+
+int aarch64_crucible_register_read(
+    CPUState *cs, uint32_t id, uint8_t *value, size_t value_len)
+{
+    return aarch64_crucible_register_read_with_keys(cs, id, NULL, value, value_len);
+}
+
+int aarch64_crucible_register_validate_write(
+    CPUState *cs, uint32_t id, const uint8_t *value, size_t value_len)
+{
+    return aarch64_crucible_register_validate_write_with_keys(
+        cs, id, NULL, value, value_len);
+}
+
+int aarch64_crucible_register_write(
+    CPUState *cs, uint32_t id, const uint8_t *value,
+    size_t value_len, uint32_t *performed_side_effects)
+{
+    return aarch64_crucible_register_write_with_keys(
+        cs, id, NULL, value, value_len, performed_side_effects);
+}
+
+static bool aarch64_crucible_register_access_current(
+    CPUState *cs, uint32_t id,
+    const CrucibleCPURegisterGeometry *expected,
+    const CrucibleCPURegisterKeyView *keys,
+    const uint8_t *value, size_t value_len, uint32_t *effects)
+{
+    CrucibleCPURegisterGeometry current;
+    size_t name_bytes;
+    uint32_t width_bits;
+
+    return cs && crucible_register_value_spans(
+        value, value_len, expected, keys, effects, ARM_CPU(cs), sizeof(ARMCPU)) &&
+        aarch64_crucible_register_geometry(cs, &current) &&
+        crucible_register_geometry_equal(expected, &current) &&
+        aarch64_crucible_register_keys_current(cs, keys, &current) &&
+        id && id <= current.register_count &&
+        aarch64_crucible_register_shape(cs, id - 1, keys, NULL, 0,
+            &name_bytes, &width_bits) &&
+        value_len == ((uint64_t)width_bits + 7) / 8;
+}
+
+int aarch64_crucible_register_read_into(
+    CPUState *cs, uint32_t id,
+    const CrucibleCPURegisterGeometry *geometry,
+    const CrucibleCPURegisterKeyView *keys, uint8_t *value, size_t value_len)
+{
+    if (!aarch64_crucible_register_access_current(
+            cs, id, geometry, keys, value, value_len, NULL)) {
+        return -EINVAL;
+    }
+    return aarch64_crucible_register_read_with_keys(cs, id, keys, value, value_len);
+}
+
+int aarch64_crucible_register_validate_write_into(
+    CPUState *cs, uint32_t id,
+    const CrucibleCPURegisterGeometry *geometry,
+    const CrucibleCPURegisterKeyView *keys,
+    const uint8_t *value, size_t value_len)
+{
+    if (!aarch64_crucible_register_access_current(
+            cs, id, geometry, keys, value, value_len, NULL)) {
+        return -EINVAL;
+    }
+    return aarch64_crucible_register_validate_write_with_keys(
+        cs, id, keys, value, value_len);
+}
+
+int aarch64_crucible_register_write_into(
+    CPUState *cs, uint32_t id,
+    const CrucibleCPURegisterGeometry *geometry,
+    const CrucibleCPURegisterKeyView *keys,
+    const uint8_t *value, size_t value_len, uint32_t *performed_side_effects)
+{
+    if (!performed_side_effects || !aarch64_crucible_register_access_current(
+            cs, id, geometry, keys, value, value_len, performed_side_effects)) {
+        return -EINVAL;
+    }
+    return aarch64_crucible_register_write_with_keys(
+        cs, id, keys, value, value_len, performed_side_effects);
+}
