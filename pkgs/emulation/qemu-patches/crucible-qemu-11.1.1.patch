+
+#ifndef HW_CHAR_PARALLEL_ISA_FINGERPRINT_H
+#define HW_CHAR_PARALLEL_ISA_FINGERPRINT_H
+
+#include "hw/char/parallel-isa.h"
+#include "migration/qemu-file.h"
+
+static inline bool parallel_isa_state_fingerprint_projection(
+    QEMUFile *f, const ISAParallelState *parallel)
+{
+    const ParallelState *state = &parallel->state;
+
+    qemu_put_byte(f, state->dataw);
+    qemu_put_byte(f, state->datar);
+    qemu_put_byte(f, state->status);
+    qemu_put_byte(f, state->control);
