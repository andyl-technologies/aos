+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Extract bounded checkpoint mailbox bodies with explicit fixture boundaries."""
+
+import argparse
+import hashlib
+import importlib.util
+from pathlib import Path
+
+SOURCE_HASHES = {
+    'system/crucible-hot-fork-coordinator.c':
+        'a8db45cdd7a6aebebe44990565c08eed6a833a05ea7f77958ffa12bd2017b65b',
+    'include/system/crucible-ram-quiescence.h':
