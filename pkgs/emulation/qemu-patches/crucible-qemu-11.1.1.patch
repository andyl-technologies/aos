+int qemu_crucible_checkpoint_candidate_ram_begin_v1(
+    QemuCrucibleCheckpointHeldTransaction *owner, uint64_t topology)
+{
+    struct qemu_plugin_crucible_checkpoint_pager_status observed;
+    int status = checkpoint_identity(owner);
+
+    if (status || !owner->candidate_started || !owner->capture_alias_moved ||
+        !owner->stopped || owner->candidate_ended || !topology ||
+        owner->release_started || owner->candidate_collector_token) {
+        return status ? status : -EPERM;
+    }
+    /* Main/BQL acquires the actual physical owner outside module callbacks.
+     * Its token survives partial begin/cleanup failure. A PREPARE response
+     * neither creates this token nor substitutes a copied transaction id.
+     */
+    owner->candidate_collector_topology = topology;
+    status = qemu_plugin_crucible_ram_physical_begin_v1(
+        topology, &owner->candidate_collector_token);
+    if (status) {
+        return checkpoint_fail(owner, status, false);
+    }
+    status = qemu_crucible_checkpoint_invoke_v1(
+        owner, QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PAGER_PREPARE, 0, &observed);
+    if (status) {
+        return status;
+    }
+    if (observed.state == QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PAGER_PENDING) {
+        return -EINPROGRESS;
+    }
+    status = qemu_crucible_checkpoint_invoke_v1(
+        owner, QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PAGER_CHECK, 0, &observed);
+    if (status) {
+        return status;
+    }
+    return observed.state == QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PAGER_SETTLED_HELD &&
+        owner->proof.retained && owner->mailbox_detached ? 0 : -EINPROGRESS;
+}
