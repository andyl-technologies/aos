diff --git a/accel/tcg/tcg-accel-ops-preemption.c b/accel/tcg/tcg-accel-ops-preemption.c
new file mode 100644
index 0000000000000000000000000000000000000000..76140d303d1b89512472ebc4f0d0577a1472a20c
--- /dev/null
+++ b/accel/tcg/tcg-accel-ops-preemption.c
@@ -0,0 +1,302 @@
+/*
+ * QEMU TCG Crucible commanded preemption injection.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/accel.h"
+#include "qemu/error-report.h"
+#include "qemu/module.h"
+#include "migration/qemu-file.h"
+#include "migration/vmstate.h"
+#include "plugins/qemu-plugin.h"
+#include "exec/cpu-common.h"
+#include "exec/icount.h"
+#include "system/cpu-timers.h"
+#include "system/crucible-sim-preemption.h"
+#include "tcg-accel-ops-sim-shmem.h"
+
+/* A target without this adapter cannot admit an interrupt command. */
+extern int crucible_sim_det_ipi_deliver_commanded(unsigned int target_vcpu,
+                                                 unsigned int vector)
+    __attribute__((weak));
+
+typedef struct CrucibleSimPreemptionCommand {
+    bool pending;
+    uint64_t at_tick;
+    unsigned int kind;
+    uint32_t arg0;
+    uint32_t arg1;
+    uint32_t arg2;
+} CrucibleSimPreemptionCommand;
+
+static CrucibleSimPreemptionCommand crucible_sim_preemption_command;
+
+static int crucible_sim_preemption_validate_vcpu(uint32_t vcpu);
+
+static bool crucible_sim_preemption_vmstate_needed(void *opaque)
+{
+    return icount_crucible_sim_mode();
+}
+
+static int crucible_sim_preemption_vmstate_pre_save(void *opaque)
+{
+    CrucibleSimPreemptionCommand *command = opaque;
+    int64_t current_tick = icount_crucible_sim_tick_observed();
+
+    if (!command->pending) {
+        memset(command, 0, sizeof(*command));
+        return 0;
+    }
+    if (current_tick < 0 || command->at_tick < (uint64_t)current_tick) {
+        return -EINVAL;
+    }
+    return 0;
+}
+
+static int crucible_sim_preemption_vmstate_post_load(void *opaque,
+                                                    int version_id)
+{
+    CrucibleSimPreemptionCommand *command = opaque;
+
+    if (version_id != 1) {
+        return -EINVAL;
+    }
+    if (!command->pending) {
+        return command->at_tick == 0 && command->kind == 0 &&
+               command->arg0 == 0 && command->arg1 == 0 &&
+               command->arg2 == 0 ? 0 : -EINVAL;
+    }
+    if (command->at_tick > INT64_MAX || command->arg2 != 0) {
+        return -EINVAL;
+    }
+    switch (command->kind) {
+    case QEMU_PLUGIN_PREEMPTION_KIND_VCPU_SWITCH:
+        return command->arg0 != command->arg1 &&
+               crucible_sim_preemption_validate_vcpu(command->arg0) == 0 &&
+               crucible_sim_preemption_validate_vcpu(command->arg1) == 0 ?
+               0 : -EINVAL;
+    case QEMU_PLUGIN_PREEMPTION_KIND_INTERRUPT_AT:
+        return crucible_sim_det_ipi_deliver_commanded &&
+               command->arg1 <= UINT8_MAX &&
+               crucible_sim_preemption_validate_vcpu(command->arg0) == 0 ?
+               0 : -EINVAL;
+    default:
+        return -EINVAL;
+    }
+}
+
+static bool crucible_sim_preemption_fingerprint(QEMUFile *file,
+                                               const void *opaque,
+                                               Error **errp)
+{
+    const CrucibleSimPreemptionCommand *command = opaque;
+
+    qemu_put_byte(file, command->pending);
+    qemu_put_be64(file, command->pending ? command->at_tick : 0);
+    qemu_put_be32(file, command->pending ? command->kind : 0);
+    qemu_put_be32(file, command->pending ? command->arg0 : 0);
+    qemu_put_be32(file, command->pending ? command->arg1 : 0);
+    qemu_put_be32(file, command->pending ? command->arg2 : 0);
+    return true;
+}
+
+static const CrucibleFingerprintProjection crucible_sim_preemption_projection = {
+    .schema = "crucible.qemu.sim-preemption.v1",
+    .version = 1,
+    .save = crucible_sim_preemption_fingerprint,
+};
+
+static const VMStateDescription vmstate_crucible_sim_preemption = {
+    .name = "crucible/sim-preemption",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .needed = crucible_sim_preemption_vmstate_needed,
+    .pre_save = crucible_sim_preemption_vmstate_pre_save,
+    .post_load = crucible_sim_preemption_vmstate_post_load,
+    .crucible_fingerprint_projection = &crucible_sim_preemption_projection,
+    .fields = (const VMStateField[]) {
+        VMSTATE_BOOL(pending, CrucibleSimPreemptionCommand),
+        VMSTATE_UINT64(at_tick, CrucibleSimPreemptionCommand),
+        VMSTATE_UINT32(kind, CrucibleSimPreemptionCommand),
+        VMSTATE_UINT32(arg0, CrucibleSimPreemptionCommand),
+        VMSTATE_UINT32(arg1, CrucibleSimPreemptionCommand),
+        VMSTATE_UINT32(arg2, CrucibleSimPreemptionCommand),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static void crucible_sim_preemption_vmstate_register(void)
+{
+    vmstate_register(NULL, 0, &vmstate_crucible_sim_preemption,
+                     &crucible_sim_preemption_command);
+}
+
+type_init(crucible_sim_preemption_vmstate_register)
+
+static bool crucible_sim_preemption_mode(void)
+{
+    return current_accel_is_sim() &&
+           icount_enabled() == ICOUNT_PRECISE &&
+           icount_crucible_rr_switch_quantum() != 0 &&
+           crucible_sim_shmem_dispatch_registered();
+}
+
+static int crucible_sim_preemption_validate_vcpu(uint32_t vcpu)
+{
+    return qemu_get_cpu(vcpu) != NULL ? 0 : -1;
+}
+
+static int crucible_sim_preemption_validate_window(uint64_t at_tick,
+                                                   uint64_t deadline_tick,
+                                                   uint64_t ceiling_tick)
+{
+    int64_t current_tick = icount_crucible_sim_tick_observed();
+    uint64_t published_ceiling = crucible_sim_shmem_logical_ceiling();
+
+    if (current_tick < 0 || deadline_tick > ceiling_tick ||
+        ceiling_tick > published_ceiling ||
+        ceiling_tick > INT64_MAX ||
+        at_tick < deadline_tick || at_tick > ceiling_tick ||
+        at_tick < (uint64_t)current_tick) {
+        return -1;
+    }
+    return 0;
+}
+
+int crucible_sim_preemption_enqueue(uint64_t at_tick,
+                                    uint64_t deadline_tick,
+                                    uint64_t ceiling_tick,
+                                    unsigned int kind, uint32_t arg0,
+                                    uint32_t arg1, uint32_t arg2)
+{
+    if (!crucible_sim_preemption_mode()) {
+        return -1;
+    }
+    if (crucible_sim_preemption_validate_window(at_tick, deadline_tick,
+                                                ceiling_tick) != 0) {
+        return -2;
+    }
+    if (crucible_sim_preemption_command.pending) {
+        return -3;
+    }
+
+    switch (kind) {
+    case QEMU_PLUGIN_PREEMPTION_KIND_VCPU_SWITCH:
+        if (arg2 != 0 || arg0 == arg1 ||
+            crucible_sim_preemption_validate_vcpu(arg0) != 0 ||
+            crucible_sim_preemption_validate_vcpu(arg1) != 0) {
+            return -4;
+        }
+        break;
+    case QEMU_PLUGIN_PREEMPTION_KIND_INTERRUPT_AT:
+        if (!crucible_sim_det_ipi_deliver_commanded ||
+            arg2 != 0 || arg1 > UINT8_MAX ||
+            crucible_sim_preemption_validate_vcpu(arg0) != 0) {
+            return -5;
+        }
+        break;
+    default:
+        return -6;
+    }
+
+    crucible_sim_preemption_command = (CrucibleSimPreemptionCommand) {
+        .pending = true,
+        .at_tick = at_tick,
+        .kind = kind,
+        .arg0 = arg0,
+        .arg1 = arg1,
+        .arg2 = arg2,
+    };
+    return 0;
+}
+
+int64_t crucible_sim_preemption_clamp_cpu_budget(int64_t cpu_budget)
+{
+    int64_t current_tick;
+    uint64_t remaining_instructions;
+
+    if (!crucible_sim_preemption_command.pending || cpu_budget <= 0) {
+        return cpu_budget;
+    }
+    current_tick = icount_crucible_sim_tick_observed();
+    if (current_tick < 0) {
+        error_report("Crucible preemption observed negative logical time");
+        abort();
+    }
+    if ((uint64_t)current_tick >= crucible_sim_preemption_command.at_tick) {
+        return 0;
+    }
+
+    remaining_instructions =
+        (crucible_sim_preemption_command.at_tick - (uint64_t)current_tick) /
+        CRUCIBLE_SIM_TICKS_PER_INSTRUCTION;
+    if (remaining_instructions > (uint64_t)INT64_MAX ||
+        (uint64_t)cpu_budget <= remaining_instructions) {
+        return cpu_budget;
+    }
+    return (int64_t)remaining_instructions;
+}
+
+uint64_t crucible_sim_preemption_next_tick(void)
+{
+    return crucible_sim_preemption_command.pending ?
+        crucible_sim_preemption_command.at_tick : UINT64_MAX;
+}
+
+bool crucible_sim_preemption_apply_due(CPUState **cpu)
+{
+    CrucibleSimPreemptionCommand command;
+    CPUState *target_cpu;
+    int64_t current_tick;
+
+    if (!crucible_sim_preemption_command.pending) {
+        return false;
+    }
+
+    current_tick = icount_crucible_sim_tick_observed();
+    if (current_tick < 0 ||
+        (uint64_t)current_tick < crucible_sim_preemption_command.at_tick) {
+        return false;
+    }
+    if ((uint64_t)current_tick > crucible_sim_preemption_command.at_tick) {
+        error_report("crucible preemption missed commanded tick: "
+                     "current=%" PRIu64 " commanded=%" PRIu64,
+                     (uint64_t)current_tick,
+                     crucible_sim_preemption_command.at_tick);
+        abort();
+    }
+
+    command = crucible_sim_preemption_command;
+    memset(&crucible_sim_preemption_command, 0,
+           sizeof(crucible_sim_preemption_command));
+
+    switch (command.kind) {
+    case QEMU_PLUGIN_PREEMPTION_KIND_VCPU_SWITCH:
+        if (!cpu || !*cpu ||
+            !icount_crucible_rr_commanded_switch(command.arg0,
+                                                 command.arg1)) {
+            error_report("crucible preemption vCPU switch owner mismatch: "
+                         "owner=%" PRIu64 " commanded=%u",
+                         icount_crucible_rr_current_vcpu(), command.arg0);
+            abort();
+        }
+        target_cpu = qemu_get_cpu(command.arg1);
+        if (!target_cpu) {
+            error_report("crucible preemption vCPU switch target missing");
+            abort();
+        }
+        *cpu = target_cpu;
+        current_cpu = target_cpu;
+        return true;
+    case QEMU_PLUGIN_PREEMPTION_KIND_INTERRUPT_AT:
+        if (crucible_sim_det_ipi_deliver_commanded(command.arg0,
+                                                   command.arg1) != 0) {
+            error_report("crucible preemption interrupt target missing");
+            abort();
+        }
+        return true;
+    default:
+        error_report("crucible preemption unknown kind");
+        abort();
+    }
+}
