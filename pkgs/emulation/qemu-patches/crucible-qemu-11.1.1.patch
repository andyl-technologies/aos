+static void test_grandchild_cannot_use_parent_identity(void)
+{
+    QemuCrucibleHotForkParentIdentity identity;
+    int grandchild_result[2];
+    pid_t child;
+
+    g_assert_cmpint(qemu_crucible_hot_fork_capture_parent_identity(&identity),
+                    ==, 0);
+    g_assert_cmpint(pipe2(grandchild_result, O_CLOEXEC), ==, 0);
+
+    child = fork();
+    g_assert_cmpint(child, >=, 0);
+    if (child == 0) {
+        pid_t grandchild = fork();
+
+        if (grandchild < 0) {
+            write_child_result(grandchild_result[1], -errno);
+            _exit(0);
+        }
+        if (grandchild == 0) {
+            int result =
+                qemu_crucible_hot_fork_authenticate_immediate_child(&identity);
+
+            write_child_result(grandchild_result[1], result);
+            _exit(0);
+        }
+        waitpid(grandchild, NULL, 0);
+        _exit(0);
+    }
+
+    close(grandchild_result[1]);
+    g_assert_cmpint(read_child_result(grandchild_result[0]), ==, -EPERM);
+    wait_for_child(child);
+    qemu_crucible_hot_fork_release_parent_identity(&identity);
+    close(grandchild_result[0]);
+}
+
+static void test_adopted_child_captures_fresh_parent_identity(void)
+{
+    QemuCrucibleHotForkParentIdentity identity;
+    int descendant_result[2];
+    pid_t child;
+
+    g_assert_cmpint(qemu_crucible_hot_fork_capture_parent_identity(&identity),
+                    ==, 0);
+    g_assert_cmpint(pipe2(descendant_result, O_CLOEXEC), ==, 0);
+
+    child = fork();
+    g_assert_cmpint(child, >=, 0);
+    if (child == 0) {
+        QemuCrucibleHotForkParentIdentity promoted_identity;
+        int result = qemu_crucible_hot_fork_authenticate_immediate_child(
+            &identity);
+
+        if (result == 0) {
+            result = qemu_crucible_hot_fork_adopt_child_as_parent();
+        }
+        if (result == 0) {
+            result = qemu_crucible_hot_fork_capture_parent_identity(
+                &promoted_identity);
+        }
+        if (result == 0) {
+            pid_t descendant = fork();
+
+            if (descendant < 0) {
+                result = -errno;
+            } else if (descendant == 0) {
+                result = qemu_crucible_hot_fork_authenticate_immediate_child(
+                    &promoted_identity);
+                write_child_result(descendant_result[1], result);
+                _exit(0);
+            } else {
+                waitpid(descendant, NULL, 0);
+                qemu_crucible_hot_fork_release_parent_identity(
+                    &promoted_identity);
+                _exit(0);
+            }
+        }
+        write_child_result(descendant_result[1], result);
+        _exit(0);
+    }
+
+    close(descendant_result[1]);
+    g_assert_cmpint(read_child_result(descendant_result[0]), ==, 0);
+    wait_for_child(child);
+    qemu_crucible_hot_fork_release_parent_identity(&identity);
+    close(descendant_result[0]);
+}
