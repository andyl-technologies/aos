+static void crucible_clock_rearm_source(CrucibleClockSource *source)
+{
+    if (!source->rearm_timers) {
+        return;
+    }
+    g_assert(!crucible_clock_rearming_timers);
+    crucible_clock_rearming_timers = true;
+#ifdef CONFIG_LINUX
+    if (source->custody_owner) {
+        QemuCrucibleClockCallbackLease *lease = NULL;
+        QemuCrucibleTimerCallbackFrame frame = {
+            .previous = crucible_clock_registry.callback_frame,
+            .source = source, .callback = source->rearm_timers,
+            .holder = &lease,
+            .opaque = source->timer_opaque, .process = getpid(),
+        };
+        int first, post;
+
+        if (!bql_locked() || crucible_clock_registry.callback_serial == UINT64_MAX) {
+            error_report("Crucible clock callback serial or BQL is unavailable");
+            abort();
+        }
+        frame.serial = ++crucible_clock_registry.callback_serial;
+        qemu_thread_get_self(&frame.thread);
+        crucible_clock_registry.callback_frame = &frame;
+        first = qemu_crucible_source_clock_callback_begin_v1(
+            source->custody_owner, &frame, &lease);
+        if (!first) {
+            frame.entered = true;
+            frame.callback(frame.opaque);
+            frame.returned = true;
+        }
+        post = qemu_crucible_source_clock_callback_end_v1(&frame, &lease);
+        /* No source/opaque dereference follows physical callback unref. */
+        crucible_clock_registry.callback_frame = frame.previous;
+        if (first || post || lease) {
+            error_report("Crucible clock callback custody did not close");
+            abort();
+        }
+    } else
+#endif
+    {
+        source->rearm_timers(source->timer_opaque);
+    }
+    crucible_clock_rearming_timers = false;
+}
