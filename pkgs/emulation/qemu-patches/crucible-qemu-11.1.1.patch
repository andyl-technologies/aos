+static void checkpoint_capture_alias_abort(
+    QemuCrucibleCheckpointHeldTransaction *owner, int first)
+{
+    checkpoint_fail(owner, first, false);
+    for (unsigned role = 0; role < 3; role++) {
+        int fd = owner->capture_alias_fd[role];
+
+        if (fd < 0) {
+            continue;
+        }
+        /* Consume ownership before close: an error must never close a later
+         * file that happens to reuse this descriptor number.
+         */
+        owner->capture_alias_fd[role] = -1;
+        owner->candidate_aliases_closed |= 1U << role;
+        if (close(fd) < 0) {
+            owner->candidate_alias_uncertain = true;
+            checkpoint_fail(owner, -errno, true);
+        }
+    }
+    owner->capture_alias_active = false;
+}
+
+int qemu_crucible_checkpoint_capture_alias_begin_v1(void *monitor)
+{
+    QemuCrucibleCheckpointHeldTransaction *owner = &checkpoint_transaction;
+    int status = qemu_crucible_checkpoint_capture_request_current_v1(monitor);
+
+    if (status) {
+        return status;
+    }
+    if (owner->capture_alias_attempted || owner->capture_alias_active ||
+        owner->capture_alias_moved) {
+        return -EALREADY;
+    }
+    for (unsigned role = 0; role < 3; role++) {
+        owner->capture_alias_fd[role] = -1;
+    }
+    owner->capture_alias_active = true;
+    return 0;
+}
+
+int qemu_crucible_checkpoint_capture_alias_acquire_v1(
+    unsigned role, const char *fdname, Error **errp)
+{
+    QemuCrucibleCheckpointHeldTransaction *owner = &checkpoint_transaction;
+    int fd;
+    int status = checkpoint_identity(owner);
+
+    if (status || role >= 3 || !fdname ||
+        !owner->capture_alias_active || owner->capture_alias_moved ||
+        owner->request->monitor != monitor_cur() ||
+        owner->capture_alias_attempted != (1U << role) - 1) {
+        return status ? status : -EPERM;
+    }
+    /* The nominal holder records this effect before getfd removes the
+     * Monitor's named alias. No caller-supplied fd can populate the holder.
+     */
+    owner->capture_alias_attempted |= 1U << role;
+    fd = monitor_get_fd(monitor_cur(), fdname, errp);
+    if (fd < 0) {
+        checkpoint_capture_alias_abort(owner, -EBADF);
+        return -EBADF;
+    }
+    owner->capture_alias_fd[role] = fd;
+    return 0;
+}
