+        !bql_locked() || !cpu || !data || len == 0 ||
+        !runstate_check(RUN_STATE_PAUSED) ||
+        !qemu_plugin_crucible_vmstop_pending() ||
+        qemu_plugin_crucible_vmstop_admission_pending() ||
+        qemu_plugin_crucible_vmstop_flush_status() != 0 ||
+        addr > UINT64_MAX - (len - 1)) {
+        return false;
+    }
+
+    fragments = g_array_new(false, false,
+                            sizeof(QemuPluginCrucibleSelectableRamFragment));
+    g_array_set_clear_func(
+        fragments, qemu_plugin_crucible_selectable_ram_fragment_clear);
+    cpu_synchronize_state(cpu);
+    while (remaining != 0) {
+        TranslateForDebugResult translated;
+        QemuPluginCrucibleSelectableRamFragment fragment;
+        hwaddr page_size;
+        hwaddr page_base;
+        hwaddr page_available;
+        hwaddr region_available;
+        int asidx;
+
+        if (!cpu_translate_for_debug(cpu, current, &translated)) {
+            return false;
+        }
+        translated.lg_page_size = MIN(translated.lg_page_size,
+                                      TARGET_PAGE_BITS);
+        page_size = 1ULL << translated.lg_page_size;
+        page_base = ROUND_DOWN(translated.physaddr, page_size);
+        page_available = page_base + page_size - translated.physaddr;
+        region_available = MIN((hwaddr)remaining, page_available);
+        asidx = cpu_asidx_from_attrs(cpu, translated.attrs);
+        fragment.region = address_space_translate(
+            cpu_get_address_space(cpu, asidx), translated.physaddr,
+            &fragment.region_offset, &region_available, true,
+            translated.attrs);
+        if (!fragment.region || region_available == 0 ||
+            !memory_region_is_ram(fragment.region) ||
+            memory_region_is_rom(fragment.region) ||
+            memory_region_is_ram_device(fragment.region) ||
+            memory_region_is_protected(fragment.region)) {
+            return false;
+        }
+        fragment.source_offset = source_offset;
+        fragment.length = region_available;
+        memory_region_ref(fragment.region);
+        g_array_append_val(fragments, fragment);
+        current += region_available;
+        source_offset += region_available;
+        remaining -= region_available;
+    }
+
+    for (size_t index = 0; index < fragments->len; index++) {
+        QemuPluginCrucibleSelectableRamFragment *fragment = &g_array_index(
+            fragments, QemuPluginCrucibleSelectableRamFragment, index);
+
+        memory_region_fault_commit_ram(
+            fragment->region, fragment->region_offset,
+            data + fragment->source_offset, fragment->length);
+    }
+    return true;
+}
+
+int qemu_plugin_crucible_complete_selectable_reply(
+    uint64_t request_sequence, uint64_t logical_boundary_icount,
+    uint64_t expected_completed_requests, uint32_t vcpu_index,
+    struct qemu_plugin_crucible_selectable_reply_status *status)
+{
+    qemu_plugin_crucible_selectable_reply_cb_t cb;
+    void *userdata;
+    uint64_t raw_icount_before;
+    int result;
+
+    if (!status || request_sequence == 0 || expected_completed_requests == 0) {
+        return -EINVAL;
+    }
+    memset(status, 0, sizeof(*status));
+    qemu_mutex_lock(&qemu_plugin_crucible_barrier_operation_lock);
+    if (!bql_locked() || !runstate_check(RUN_STATE_PAUSED) ||
+        !qemu_plugin_crucible_vmstop_pending() ||
+        qemu_plugin_crucible_vmstop_admission_pending() ||
+        qemu_plugin_crucible_vmstop_flush_status() != 0) {
+        qemu_mutex_unlock(&qemu_plugin_crucible_barrier_operation_lock);
+        return -EPROTO;
+    }
+    raw_icount_before = qemu_plugin_icount_raw();
+    qemu_mutex_lock(&qemu_plugin_crucible_resource_lock);
+    cb = qemu_plugin_crucible_selectable_reply_cb;
+    userdata = qemu_plugin_crucible_selectable_reply_userdata;
+    qemu_mutex_unlock(&qemu_plugin_crucible_resource_lock);
+    if (!cb || !userdata) {
+        qemu_mutex_unlock(&qemu_plugin_crucible_barrier_operation_lock);
+        return -ENODEV;
+    }
+
+    qemu_plugin_crucible_selectable_reply_active = true;
+    qemu_plugin_crucible_selectable_reply_raw_icount = raw_icount_before;
+    qemu_plugin_crucible_selectable_reply_vcpu_index = vcpu_index;
+    result = cb(request_sequence, raw_icount_before,
+                logical_boundary_icount, expected_completed_requests,
+                vcpu_index, status, userdata);
+    qemu_plugin_crucible_selectable_reply_active = false;
+    qemu_plugin_crucible_selectable_reply_raw_icount = 0;
+    qemu_plugin_crucible_selectable_reply_vcpu_index = 0;
+    if (result != 0) {
+        memset(status, 0, sizeof(*status));
+        qemu_mutex_unlock(&qemu_plugin_crucible_barrier_operation_lock);
+        return result;
+    }
+    if (!bql_locked() || !runstate_check(RUN_STATE_PAUSED) ||
+        !qemu_plugin_crucible_vmstop_pending() ||
+        qemu_plugin_crucible_vmstop_admission_pending() ||
+        qemu_plugin_crucible_vmstop_flush_status() != 0 ||
+        qemu_plugin_icount_raw() != raw_icount_before ||
+        status->schema_version !=
+            QEMU_PLUGIN_CRUCIBLE_SELECTABLE_REPLY_STATUS_VERSION ||
+        status->struct_size != sizeof(*status) || status->reserved != 0 ||
+        status->request_sequence != request_sequence ||
+        status->raw_boundary_icount != raw_icount_before ||
+        status->logical_boundary_icount != logical_boundary_icount ||
+        status->vcpu_index != vcpu_index ||
+        status->completed_requests != expected_completed_requests) {
+        memset(status, 0, sizeof(*status));
+        qemu_mutex_unlock(&qemu_plugin_crucible_barrier_operation_lock);
+        return -EPROTO;
+    }
+    qemu_mutex_unlock(&qemu_plugin_crucible_barrier_operation_lock);
+    return 0;
+}
+
+void qemu_plugin_crucible_callback_registered(qemu_plugin_id_t plugin_id,
+                                              uint64_t callback_mask)
+{
+    QEMU_LOCK_GUARD(&qemu_plugin_crucible_resource_lock);
+
+    if (callback_mask == 0 ||
+        (callback_mask & ~QEMU_PLUGIN_CRUCIBLE_CALLBACK_ALL) != 0) {
+        return;
+    }
+    if (plugin_id != 0) {
+        if (qemu_plugin_crucible_observed_plugin_id == 0) {
+            qemu_plugin_crucible_observed_plugin_id = plugin_id;
+        } else if (qemu_plugin_crucible_observed_plugin_id != plugin_id) {
+            qemu_plugin_crucible_callback_plugin_conflict = true;
+        }
+    }
+    if ((qemu_plugin_crucible_resource_inventory.observed_callback_mask &
+         callback_mask) != callback_mask) {
+        qemu_plugin_crucible_resource_inventory.observed_callback_mask |=
+            callback_mask;
+        qemu_plugin_crucible_resource_inventory.generation++;
+    }
+}
+
+int qemu_plugin_crucible_register_resource_manifest(
+    const struct qemu_plugin_crucible_resource_manifest *manifest)
+{
+    uint64_t optional_callbacks;
+    uint64_t observed_callbacks;
+    QEMU_LOCK_GUARD(&qemu_plugin_crucible_resource_lock);
+
+    observed_callbacks =
+        qemu_plugin_crucible_resource_inventory.observed_callback_mask;
+
+    if (!manifest ||
+        manifest->schema_version !=
+            QEMU_PLUGIN_CRUCIBLE_RESOURCE_MANIFEST_VERSION ||
+        manifest->struct_size != sizeof(*manifest) ||
+        manifest->process_generation == 0 || manifest->plugin_id == 0 ||
+        manifest->node_count == 0 ||
+        manifest->slot_index >= manifest->node_count ||
+        manifest->control_fd < 0 || manifest->wake_fd < 0 ||
+        manifest->control_fd == manifest->wake_fd ||
+        manifest->shmem_inode == 0 || manifest->shmem_length == 0 ||
+        (manifest->resource_mask & ~QEMU_PLUGIN_CRUCIBLE_RESOURCE_ALL) != 0 ||
+        (manifest->callback_mask & ~QEMU_PLUGIN_CRUCIBLE_CALLBACK_ALL) != 0 ||
+        (manifest->resource_mask & QEMU_PLUGIN_CRUCIBLE_RESOURCE_REQUIRED) !=
+            QEMU_PLUGIN_CRUCIBLE_RESOURCE_REQUIRED ||
+        (manifest->callback_mask & QEMU_PLUGIN_CRUCIBLE_CALLBACK_REQUIRED) !=
+            QEMU_PLUGIN_CRUCIBLE_CALLBACK_REQUIRED ||
+        (manifest->worker_mask & ~QEMU_PLUGIN_CRUCIBLE_WORKER_ALL) != 0 ||
+        (manifest->worker_mask & QEMU_PLUGIN_CRUCIBLE_WORKER_REQUIRED) !=
+            QEMU_PLUGIN_CRUCIBLE_WORKER_REQUIRED ||
+        (((manifest->worker_mask &
+           QEMU_PLUGIN_CRUCIBLE_WORKER_FINGERPRINT) != 0) !=
+         ((manifest->resource_mask &
+           QEMU_PLUGIN_CRUCIBLE_RESOURCE_FINGERPRINT) != 0))) {
+        return -EINVAL;
+    }
+    if (qemu_plugin_crucible_resource_inventory.registered) {
+        return memcmp(&qemu_plugin_crucible_resource_inventory.manifest,
+                      manifest, sizeof(*manifest)) == 0 ? 0 : -EALREADY;
+    }
+    if (qemu_plugin_crucible_callback_plugin_conflict ||
+        qemu_plugin_crucible_observed_plugin_id != manifest->plugin_id ||
+        qemu_plugin_wake_fd != manifest->wake_fd ||
+        observed_callbacks != manifest->callback_mask) {
+        error_report("Crucible resource manifest mismatch: conflict=%d "
+                     "observed_plugin=%" PRIu64 " manifest_plugin=%" PRIu64 " "
+                     "observed_wake=%d manifest_wake=%d "
+                     "observed_callbacks=%" PRIx64
+                     " manifest_callbacks=%" PRIx64,
+                     qemu_plugin_crucible_callback_plugin_conflict,
+                     qemu_plugin_crucible_observed_plugin_id,
+                     manifest->plugin_id, qemu_plugin_wake_fd,
+                     manifest->wake_fd,
+                     observed_callbacks, manifest->callback_mask);
+        return -EPROTO;
+    }
+
+    optional_callbacks = manifest->callback_mask &
+        ~QEMU_PLUGIN_CRUCIBLE_CALLBACK_REQUIRED;
+    if (((manifest->resource_mask &
+          (QEMU_PLUGIN_CRUCIBLE_RESOURCE_COVERAGE |
+           QEMU_PLUGIN_CRUCIBLE_RESOURCE_WHITEBOX)) != 0) !=
+        ((optional_callbacks &
+          QEMU_PLUGIN_CRUCIBLE_CALLBACK_TB_TRANSLATION) != 0) ||
+        ((manifest->resource_mask & QEMU_PLUGIN_CRUCIBLE_RESOURCE_COVERAGE) !=
+         0) !=
+        ((optional_callbacks & QEMU_PLUGIN_CRUCIBLE_CALLBACK_FLUSH) != 0)) {
+        return -EPROTO;
+    }
+
+    qemu_plugin_crucible_resource_inventory.manifest = *manifest;
+    qemu_plugin_crucible_resource_inventory.registered = true;
+    qemu_plugin_crucible_resource_inventory.complete = true;
+    qemu_plugin_crucible_resource_inventory.generation++;
+    return 0;
+}
+
+void qemu_plugin_crucible_hot_fork_inventory(
+    QemuPluginCrucibleHotForkInventory *inventory)
+{
+    QEMU_LOCK_GUARD(&qemu_plugin_crucible_resource_lock);
+
+    *inventory = qemu_plugin_crucible_resource_inventory;
+    inventory->complete = inventory->registered && inventory->complete &&
+        !qemu_plugin_crucible_callback_plugin_conflict &&
+        inventory->manifest.callback_mask == inventory->observed_callback_mask;
+}
