+#ifdef CONFIG_LINUX
+/* Native's exact typed use remains held by the CPU child. This subloan never
+ * broadens generic use-count permission or creates a second CPU/QOM owner. */
+static int initial_register_borrow_facts(
+    QemuCrucibleInitialRegisterWorkspaceOwner *owner, CPUState *cpu,
+    struct QemuCrucibleInitialCpuParticipant *participant,
+    QemuCrucibleInitialRegisterWorkspaceOwner **holder)
+{
+    return owner->borrow_held && owner->borrow_holder == holder && holder &&
+        *holder == owner && cpu == owner->constructor_cpu &&
+        owner->process == getpid() && owner->borrow_serial &&
+        qemu_thread_is_self(&owner->borrow_thread) &&
+        owner->borrow_participant == participant &&
+        owner->borrow_child && owner->borrow_child_serial &&
+        owner->borrow_child == participant->native_child &&
+        owner->borrow_child_serial == participant->native_child_serial &&
+        participant->binding == owner->account->binding &&
+        participant->operation_serial == owner->operation_serial &&
+        participant->group_serial == owner->group_serial ? 0 : -ESTALE;
+}
+
+static int initial_register_borrow_post(
+    CPUState *cpu, QemuCrucibleInitialRegisterWorkspaceOwner *owner,
+    QemuCrucibleInitialRegisterWorkspaceOwner **holder, bool *authenticated)
