+ */
+
+#include "qemu/osdep.h"
+
+#include <poll.h>
+
+#include "exec/icount.h"
+#include "system/memory.h"
+#include "system/physmem.h"
+#include "system/ram_addr.h"
+#include "system/ramblock.h"
+#include "io/channel-watch.h"
+#include "migration/global_state.h"
+#include "migration/qemu-file.h"
+#include "migration/savevm.h"
+#include "qapi/error.h"
+#include "qemu/iov.h"
+#include "qemu/module.h"
+#include "qemu/plugin.h"
+#include "plugins/qemu-plugin.h"
+#include "qemu/units.h"
+#include "system/cpu-timers.h"
+#include "system/crucible-checkpoint.h"
+#include "system/runstate.h"
+#include "system/tcg.h"
+#include "migration/misc.h"
+
+#define CRUCIBLE_CHECKPOINT_SCHEMA_VERSION 1
+#define CRUCIBLE_CHECKPOINT_RAM_MAGIC "CRUCRAM1"
+#define CRUCIBLE_CHECKPOINT_RAM_HEADER_BYTES 232
+#define CRUCIBLE_CHECKPOINT_RAM_RECORD_HEADER_BYTES 16
+#define CRUCIBLE_CHECKPOINT_RAM_RECORD_MAX_BYTES (4 * MiB)
+#define CRUCIBLE_CHECKPOINT_RAM_REGION_MAX 1024
+#define CRUCIBLE_CHECKPOINT_RAM_REGION_NAME_MAX 255
+
+/*
+ * CRUCRAM1 is little-endian. Its fixed header contains schema, direct/delta
+ * kind, target page size, topology/record counts, total bytes, and six SHA-256
+ * identities (candidate then parent checkpoint/target/frontier). Each sorted
+ * RAMBlock topology entry contains used length, maximum length, backing page
+ * size, and a length-prefixed QEMU RAMBlock id. Each payload record contains
+ * RAMBlock index, length, block-relative offset, and at most 4 MiB of bytes.
+ * A future loader must authenticate and validate every topology and record
+ * before applying RAM, then call qemu_load_device_state() while still paused.
+ */
+
+#define TYPE_QIO_CHANNEL_CRUCIBLE_CHECKPOINT \
+    "qio-channel-crucible-checkpoint"
+OBJECT_DECLARE_SIMPLE_TYPE(QIOChannelCrucibleCheckpoint,
+                           QIO_CHANNEL_CRUCIBLE_CHECKPOINT)
+
+struct QIOChannelCrucibleCheckpoint {
+    QIOChannel parent;
+    int fd;
+    int cancellation_fd;
+    uint64_t maximum_bytes;
+    uint64_t written;
+    GChecksum *checksum;
+    bool sink;
+    bool closed;
+};
+
+typedef struct CrucibleCheckpointRamRegion {
+    uint64_t length;
+    uint64_t maximum_length;
+    uint64_t page_size;
+    ram_addr_t dirty_base;
+    RAMBlock *ram_block;
+    char name[CRUCIBLE_CHECKPOINT_RAM_REGION_NAME_MAX + 1];
+} CrucibleCheckpointRamRegion;
+
+typedef struct CrucibleCheckpointRamTopology {
+    GArray *regions;
+    uint64_t payload_bytes;
+    uint64_t record_count;
+    uint8_t digest[32];
+    char digest_hex[65];
+    int status;
+} CrucibleCheckpointRamTopology;
+
+typedef struct CrucibleCheckpointWriter {
+    int fd;
+    int cancellation_fd;
+    uint64_t maximum_bytes;
+    uint64_t written;
+} CrucibleCheckpointWriter;
+
+typedef struct CrucibleCheckpointAuthority {
+    bool epoch_active;
+    uint64_t epoch_generation;
+    bool candidate_active;
+    CrucibleCheckpointRamKind candidate_kind;
+    char *committed_checkpoint_sha256;
+    char *committed_target_sha256;
+    char *committed_frontier_sha256;
+    char *candidate_checkpoint_sha256;
+    char *candidate_target_sha256;
+    char *candidate_frontier_sha256;
+    uint8_t committed_topology_digest[32];
+    uint8_t candidate_topology_digest[32];
+    uint8_t candidate_device_digest[32];
+    uint64_t candidate_dirty_generation;
+    uint64_t candidate_maximum_device_bytes;
+} CrucibleCheckpointAuthority;
+
+static CrucibleCheckpointAuthority crucible_checkpoint_authority;
+static uint64_t crucible_checkpoint_dirty_generation;
+static VMChangeStateEntry *crucible_checkpoint_vmstate_handler;
+
+static int crucible_checkpoint_clear_private_dirty_block(
+    RAMBlock *ram_block, void *opaque);
+static int crucible_checkpoint_set_private_dirty_block(
+    RAMBlock *ram_block, void *opaque);
+
+void qemu_crucible_checkpoint_dirty_generation_advance(void)
+{
+    qatomic_inc(&crucible_checkpoint_dirty_generation);
+}
+
+static bool crucible_checkpoint_cancelled(int cancellation_fd, Error **errp)
+{
+    struct pollfd poll_fd = {
+        .fd = cancellation_fd,
+        .events = POLLIN,
+    };
+    int status;
+
+    if (cancellation_fd < 0) {
+        return false;
+    }
+    do {
+        status = poll(&poll_fd, 1, 0);
+    } while (status < 0 && errno == EINTR);
+    if (status < 0) {
+        error_setg_errno(errp, errno,
+                         "Could not poll Crucible checkpoint cancellation");
+        return true;
+    }
+    if (status == 0) {
+        return false;
+    }
+    if (poll_fd.revents & POLLIN) {
+        error_setg(errp, "Crucible checkpoint capture was cancelled");
+    } else {
+        error_setg(errp, "Crucible checkpoint cancellation descriptor failed");
+    }
+    return true;
+}
+
+static ssize_t crucible_checkpoint_channel_writev(
+    QIOChannel *ioc,
+    const struct iovec *iov,
+    size_t niov,
+    int *fds G_GNUC_UNUSED,
+    size_t nfds G_GNUC_UNUSED,
+    int flags G_GNUC_UNUSED,
+    Error **errp)
+{
+    QIOChannelCrucibleCheckpoint *channel =
+        QIO_CHANNEL_CRUCIBLE_CHECKPOINT(ioc);
+    size_t bytes = iov_size(iov, niov);
+    ssize_t written;
+
+    if (channel->closed) {
+        error_setg(errp, "Crucible checkpoint channel is closed");
+        return -1;
+    }
+    if (bytes > channel->maximum_bytes - channel->written) {
+        error_setg(errp, "Crucible checkpoint device VMState exceeds its "
+                   "maximum byte count");
+        return -1;
+    }
+    if (crucible_checkpoint_cancelled(channel->cancellation_fd, errp)) {
+        return -1;
+    }
+
+    if (channel->sink) {
+        written = bytes;
+    } else {
+        do {
+            written = writev(channel->fd, iov, niov);
+        } while (written < 0 && errno == EINTR);
+    }
+    if (written <= 0) {
+        error_setg_errno(errp, written == 0 ? EIO : errno,
+                         "Could not write Crucible checkpoint device VMState");
+        return -1;
+    }
+    for (size_t index = 0, remaining = written;
+         index < niov && remaining != 0; index++) {
+        size_t hashed = MIN(remaining, iov[index].iov_len);
+
+        g_checksum_update(channel->checksum, iov[index].iov_base, hashed);
+        remaining -= hashed;
+    }
+    channel->written += written;
+    return written;
+}
+
+static ssize_t crucible_checkpoint_channel_readv(
+    QIOChannel *ioc G_GNUC_UNUSED,
+    const struct iovec *iov G_GNUC_UNUSED,
+    size_t niov G_GNUC_UNUSED,
+    int **fds G_GNUC_UNUSED,
+    size_t *nfds G_GNUC_UNUSED,
+    int flags G_GNUC_UNUSED,
+    Error **errp)
+{
+    error_setg_errno(errp, ENOTSUP,
+                     "Crucible checkpoint output channel is write-only");
+    return -1;
+}
+
+static int crucible_checkpoint_channel_close(QIOChannel *ioc, Error **errp)
+{
+    QIOChannelCrucibleCheckpoint *channel =
+        QIO_CHANNEL_CRUCIBLE_CHECKPOINT(ioc);
+    int status = 0;
+
+    if (channel->closed) {
+        return 0;
+    }
+    if (channel->sink) {
+        channel->closed = true;
+        return 0;
+    }
+    if (fdatasync(channel->fd) < 0) {
+        error_setg_errno(errp, errno,
+                         "Could not synchronize Crucible checkpoint VMState");
+        status = -1;
+    }
+    if (close(channel->fd) < 0 && status == 0) {
+        error_setg_errno(errp, errno,
+                         "Could not close Crucible checkpoint VMState");
+        status = -1;
+    }
+    channel->fd = -1;
+    channel->closed = true;
+    return status;
+}
+
+static GSource *crucible_checkpoint_channel_create_watch(
+    QIOChannel *ioc,
+    GIOCondition condition)
+{
+    QIOChannelCrucibleCheckpoint *channel =
+        QIO_CHANNEL_CRUCIBLE_CHECKPOINT(ioc);
+
+    return qio_channel_create_fd_watch(ioc, channel->fd, condition);
+}
+
+static int crucible_checkpoint_channel_set_blocking(
+    QIOChannel *ioc G_GNUC_UNUSED,
+    bool enabled G_GNUC_UNUSED,
+    Error **errp G_GNUC_UNUSED)
+{
+    return 0;
+}
+
+static void crucible_checkpoint_channel_finalize(Object *object)
+{
+    QIOChannelCrucibleCheckpoint *channel =
+        QIO_CHANNEL_CRUCIBLE_CHECKPOINT(object);
+
+    if (channel->fd >= 0) {
+        close(channel->fd);
+        channel->fd = -1;
+    }
+    g_clear_pointer(&channel->checksum, g_checksum_free);
+}
+
+static void crucible_checkpoint_channel_class_init(
+    ObjectClass *object_class,
+    const void *class_data G_GNUC_UNUSED)
+{
+    QIOChannelClass *channel_class = QIO_CHANNEL_CLASS(object_class);
+
+    channel_class->io_writev = crucible_checkpoint_channel_writev;
+    channel_class->io_readv = crucible_checkpoint_channel_readv;
+    channel_class->io_close = crucible_checkpoint_channel_close;
+    channel_class->io_create_watch = crucible_checkpoint_channel_create_watch;
+    channel_class->io_set_blocking = crucible_checkpoint_channel_set_blocking;
+}
+
+static const TypeInfo crucible_checkpoint_channel_type_info = {
+    .parent = TYPE_QIO_CHANNEL,
+    .name = TYPE_QIO_CHANNEL_CRUCIBLE_CHECKPOINT,
+    .instance_size = sizeof(QIOChannelCrucibleCheckpoint),
+    .instance_finalize = crucible_checkpoint_channel_finalize,
+    .class_init = crucible_checkpoint_channel_class_init,
+};
+
+static void crucible_checkpoint_channel_register_types(void)
+{
+    type_register_static(&crucible_checkpoint_channel_type_info);
+}
+
+type_init(crucible_checkpoint_channel_register_types);
+
+static QIOChannelCrucibleCheckpoint *crucible_checkpoint_channel_new(
+    int fd,
+    int cancellation_fd,
+    uint64_t maximum_bytes)
+{
+    QIOChannelCrucibleCheckpoint *channel = QIO_CHANNEL_CRUCIBLE_CHECKPOINT(
+        object_new(TYPE_QIO_CHANNEL_CRUCIBLE_CHECKPOINT));
+
+    channel->fd = fd;
+    channel->cancellation_fd = cancellation_fd;
+    channel->maximum_bytes = maximum_bytes;
+    channel->checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    channel->sink = fd < 0;
+    return channel;
+}
+
+static bool crucible_checkpoint_checked_add(
+    uint64_t *total,
+    uint64_t increment,
+    Error **errp)
+{
+    if (increment > UINT64_MAX - *total) {
+        error_setg(errp, "Crucible checkpoint byte count overflowed");
+        return false;
+    }
+    *total += increment;
+    return true;
+}
+
+static bool crucible_checkpoint_identity(
+    const char *identity,
+    uint8_t digest[32],
+    Error **errp)
+{
+    if (!identity || strlen(identity) != 64) {
+        error_setg(errp, "Crucible checkpoint identities must be 64 lowercase "
+                   "hexadecimal bytes");
+        return false;
+    }
+    for (size_t index = 0; index < 32; index++) {
+        int high = g_ascii_xdigit_value(identity[index * 2]);
+        int low = g_ascii_xdigit_value(identity[index * 2 + 1]);
+
+        if (high < 0 || low < 0 || g_ascii_isupper(identity[index * 2]) ||
+            g_ascii_isupper(identity[index * 2 + 1])) {
+            error_setg(errp, "Crucible checkpoint identities must be 64 "
+                       "lowercase hexadecimal bytes");
+            return false;
+        }
+        digest[index] = (high << 4) | low;
+    }
+    return true;
+}
+
+static bool crucible_checkpoint_exact_paused_boundary(void)
+{
+    return runstate_check(RUN_STATE_PAUSED) && tcg_enabled() &&
+        icount_enabled() == ICOUNT_PRECISE &&
+        qemu_plugin_crucible_single_threaded_rr() == 1 &&
+        qemu_plugin_crucible_vmstop_pending() &&
+        !qemu_plugin_crucible_vmstop_admission_pending() &&
+        qemu_plugin_crucible_vmstop_flush_status() == 0;
+}
+
+static int crucible_checkpoint_collect_region(RAMBlock *ram_block, void *opaque)
+{
+    CrucibleCheckpointRamTopology *topology = opaque;
+    CrucibleCheckpointRamRegion region = { 0 };
+    const char *name;
+    size_t name_length;
+
+    /* QEMU's RAM migration set is the complete mutable RAM excluded by
+     * qemu_save_device_state(), including RAM-backed device memory. */
+    if (!qemu_ram_is_migratable(ram_block)) {
+        return 0;
+    }
+    if (!ram_block->mr || !ram_block->host ||
+        memory_region_is_protected(ram_block->mr)) {
+        topology->status = -ENOTSUP;
+        return topology->status;
+    }
+    if (topology->regions->len >= CRUCIBLE_CHECKPOINT_RAM_REGION_MAX) {
+        topology->status = -E2BIG;
+        return topology->status;
+    }
+
+    region.length = qemu_ram_get_used_length(ram_block);
+    region.maximum_length = qemu_ram_get_max_length(ram_block);
+    region.page_size = qemu_ram_pagesize(ram_block);
+    if (region.length == 0 || region.maximum_length < region.length ||
+        !QEMU_IS_ALIGNED(region.length, TARGET_PAGE_SIZE) ||
+        region.page_size == 0 ||
+        !QEMU_IS_ALIGNED(region.page_size, TARGET_PAGE_SIZE)) {
+        topology->status = -ERANGE;
+        return topology->status;
+    }
+
+    name = qemu_ram_get_idstr(ram_block);
+    name_length = name ? strlen(name) : 0;
+    if (!name || name_length == 0 ||
+        name_length > CRUCIBLE_CHECKPOINT_RAM_REGION_NAME_MAX) {
+        topology->status = name ? -ENAMETOOLONG : -ENODATA;
+        return topology->status;
+    }
+
+    region.dirty_base = qemu_ram_get_offset(ram_block);
+    region.ram_block = ram_block;
+    memcpy(region.name, name, name_length + 1);
+    g_array_append_val(topology->regions, region);
+    return 0;
+}
+
+static gint crucible_checkpoint_compare_regions(gconstpointer left,
+                                                gconstpointer right)
+{
+    const CrucibleCheckpointRamRegion *left_region = left;
+    const CrucibleCheckpointRamRegion *right_region = right;
+
+    return strcmp(left_region->name, right_region->name);
+}
+
+static void crucible_checkpoint_checksum_u64(GChecksum *checksum, uint64_t value)
+{
+    value = cpu_to_le64(value);
+    g_checksum_update(checksum, (const uint8_t *)&value, sizeof(value));
+}
+
+static bool crucible_checkpoint_topology_finalize(
+    CrucibleCheckpointRamTopology *topology,
+    Error **errp)
+{
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    gsize digest_length = sizeof(topology->digest);
+
+    if (!checksum) {
+        error_setg(errp, "Could not allocate Crucible topology digest");
+        return false;
+    }
+    g_array_sort(topology->regions, crucible_checkpoint_compare_regions);
+    for (guint index = 0; index < topology->regions->len; index++) {
+        CrucibleCheckpointRamRegion *region = &g_array_index(
+            topology->regions, CrucibleCheckpointRamRegion, index);
+        size_t name_length = strlen(region->name);
+
+        if (index > 0) {
+            CrucibleCheckpointRamRegion *previous = &g_array_index(
+                topology->regions, CrucibleCheckpointRamRegion, index - 1);
+
+            if (strcmp(previous->name, region->name) == 0) {
+                error_setg(errp, "Crucible checkpoint RAM block identities "
+                           "are not unique");
+                return false;
+            }
+        }
+        crucible_checkpoint_checksum_u64(checksum, region->length);
+        crucible_checkpoint_checksum_u64(checksum, region->maximum_length);
+        crucible_checkpoint_checksum_u64(checksum, region->page_size);
+        crucible_checkpoint_checksum_u64(checksum, name_length);
+        g_checksum_update(checksum, (const uint8_t *)region->name,
+                          name_length);
+    }
+    g_checksum_get_digest(checksum, topology->digest, &digest_length);
+    if (digest_length != sizeof(topology->digest)) {
+        error_setg(errp, "Could not finalize Crucible topology digest");
+        return false;
+    }
+    memcpy(topology->digest_hex, g_checksum_get_string(checksum), 65);
+    return true;
+}
+
+static bool crucible_checkpoint_collect_topology(
+    CrucibleCheckpointRamTopology *topology,
+    Error **errp)
+{
+    memset(topology, 0, sizeof(*topology));
+    topology->regions = g_array_new(false, false,
+                                    sizeof(CrucibleCheckpointRamRegion));
+    qemu_ram_foreach_block(crucible_checkpoint_collect_region, topology);
+    if (topology->status != 0) {
+        error_setg_errno(errp, -topology->status,
+                         "Could not collect Crucible checkpoint RAM topology");
+        return false;
+    }
+    if (topology->regions->len == 0) {
+        error_setg(errp, "Crucible checkpoint found no writable guest RAM");
+        return false;
+    }
+    return crucible_checkpoint_topology_finalize(topology, errp);
+}
+
+static bool crucible_checkpoint_next_dirty_run(
+    const CrucibleCheckpointRamRegion *region,
+    uint64_t search_offset,
+    uint64_t *offset_out,
+    uint64_t *length_out)
+{
+    DirtyMemoryBlocks *blocks;
+    unsigned long page =
+        (region->dirty_base + search_offset) >> TARGET_PAGE_BITS;
+    unsigned long end =
+        (region->dirty_base + region->length) >> TARGET_PAGE_BITS;
+    unsigned long first = end;
+
+    WITH_RCU_READ_LOCK_GUARD() {
+        blocks = qatomic_rcu_read(
+            &ram_list.dirty_memory[DIRTY_MEMORY_CRUCIBLE_CHECKPOINT]);
+        while (page < end) {
+            unsigned long base =
+                page / DIRTY_MEMORY_BLOCK_SIZE * DIRTY_MEMORY_BLOCK_SIZE;
+            unsigned long index = base / DIRTY_MEMORY_BLOCK_SIZE;
+            unsigned long offset = page - base;
+            unsigned long limit = MIN(DIRTY_MEMORY_BLOCK_SIZE, end - base);
+            unsigned long found = find_next_bit(
+                blocks->blocks[index], limit, offset);
+
+            if (found < limit) {
+                first = base + found;
+                break;
+            }
+            page = base + limit;
+        }
+        if (first < end) {
+            unsigned long run_limit = MIN(
+                end, first +
+                    CRUCIBLE_CHECKPOINT_RAM_RECORD_MAX_BYTES /
+                        TARGET_PAGE_SIZE);
+
+            page = first;
+            while (page < run_limit) {
+                unsigned long base =
+                    page / DIRTY_MEMORY_BLOCK_SIZE * DIRTY_MEMORY_BLOCK_SIZE;
+                unsigned long index = base / DIRTY_MEMORY_BLOCK_SIZE;
+                unsigned long offset = page - base;
+                unsigned long limit = MIN(DIRTY_MEMORY_BLOCK_SIZE,
+                                          run_limit - base);
+                unsigned long clean = find_next_zero_bit(
+                    blocks->blocks[index], limit, offset);
+
+                page = base + clean;
+                if (clean < limit) {
+                    break;
+                }
+            }
+        }
+    }
+    if (first == end) {
+        return false;
+    }
+    *offset_out = (first << TARGET_PAGE_BITS) - region->dirty_base;
+    *length_out = (page - first) << TARGET_PAGE_BITS;
+    return true;
+}
+
+static bool crucible_checkpoint_measure_ram(
+    CrucibleCheckpointRamTopology *topology,
+    CrucibleCheckpointRamKind kind,
+    Error **errp)
+{
+    uint64_t total = CRUCIBLE_CHECKPOINT_RAM_HEADER_BYTES;
+
+    for (guint index = 0; index < topology->regions->len; index++) {
+        CrucibleCheckpointRamRegion *region = &g_array_index(
+            topology->regions, CrucibleCheckpointRamRegion, index);
+        uint64_t offset = 0;
+
+        if (!crucible_checkpoint_checked_add(
+                &total, 28 + strlen(region->name), errp)) {
+            return false;
+        }
+        while (offset < region->length) {
+            uint64_t record_bytes = 0;
+
+            if (kind == CRUCIBLE_CHECKPOINT_RAM_KIND_DIRECT) {
+                record_bytes = MIN(region->length - offset,
+                                   CRUCIBLE_CHECKPOINT_RAM_RECORD_MAX_BYTES);
+            } else if (!crucible_checkpoint_next_dirty_run(
+                           region, offset, &offset, &record_bytes)) {
+                break;
+            }
+            if (!crucible_checkpoint_checked_add(
+                    &topology->payload_bytes, record_bytes, errp) ||
+                !crucible_checkpoint_checked_add(
+                    &total,
+                    CRUCIBLE_CHECKPOINT_RAM_RECORD_HEADER_BYTES +
+                        record_bytes,
+                    errp)) {
+                return false;
+            }
+            topology->record_count++;
+            offset += record_bytes;
+        }
+    }
+    topology->payload_bytes = total;
+    return true;
+}
+
+static bool crucible_checkpoint_writer_write(
+    CrucibleCheckpointWriter *writer,
+    const void *bytes,
+    size_t length,
+    Error **errp)
+{
+    const uint8_t *cursor = bytes;
+
+    if (length > writer->maximum_bytes - writer->written) {
+        error_setg(errp, "Crucible checkpoint RAM exceeds its maximum byte "
+                   "count");
+        return false;
+    }
+    while (length != 0) {
+        ssize_t written;
+
+        if (crucible_checkpoint_cancelled(writer->cancellation_fd, errp)) {
+            return false;
+        }
+        do {
+            written = write(writer->fd, cursor, length);
+        } while (written < 0 && errno == EINTR);
+        if (written <= 0) {
+            error_setg_errno(errp, written == 0 ? EIO : errno,
+                             "Could not write Crucible checkpoint RAM");
+            return false;
+        }
+        cursor += written;
+        length -= written;
+        writer->written += written;
+    }
+    return true;
+}
+
+static bool crucible_checkpoint_writer_u32(
+    CrucibleCheckpointWriter *writer,
+    uint32_t value,
+    Error **errp)
+{
+    value = cpu_to_le32(value);
+    return crucible_checkpoint_writer_write(writer, &value, sizeof(value),
+                                            errp);
+}
+
+static bool crucible_checkpoint_writer_u64(
+    CrucibleCheckpointWriter *writer,
+    uint64_t value,
+    Error **errp)
+{
+    value = cpu_to_le64(value);
+    return crucible_checkpoint_writer_write(writer, &value, sizeof(value),
+                                            errp);
+}
+
+static bool crucible_checkpoint_write_ram_header(
+    CrucibleCheckpointWriter *writer,
+    const CrucibleCheckpointRamTopology *topology,
+    CrucibleCheckpointRamKind kind,
+    const uint8_t checkpoint_digest[32],
+    const uint8_t target_digest[32],
+    const uint8_t frontier_digest[32],
+    const uint8_t parent_checkpoint_digest[32],
+    const uint8_t parent_target_digest[32],
+    const uint8_t parent_frontier_digest[32],
+    Error **errp)
+{
+    return crucible_checkpoint_writer_write(
+               writer, CRUCIBLE_CHECKPOINT_RAM_MAGIC, 8, errp) &&
+        crucible_checkpoint_writer_u32(
+            writer, CRUCIBLE_CHECKPOINT_SCHEMA_VERSION, errp) &&
+        crucible_checkpoint_writer_u32(writer, kind + 1, errp) &&
+        crucible_checkpoint_writer_u32(writer, TARGET_PAGE_SIZE, errp) &&
+        crucible_checkpoint_writer_u32(writer, topology->regions->len, errp) &&
+        crucible_checkpoint_writer_u64(writer, topology->record_count, errp) &&
+        crucible_checkpoint_writer_u64(writer, topology->payload_bytes, errp) &&
+        crucible_checkpoint_writer_write(writer, checkpoint_digest, 32, errp) &&
+        crucible_checkpoint_writer_write(writer, target_digest, 32, errp) &&
+        crucible_checkpoint_writer_write(writer, frontier_digest, 32, errp) &&
+        crucible_checkpoint_writer_write(
+            writer, parent_checkpoint_digest, 32, errp) &&
+        crucible_checkpoint_writer_write(writer, parent_target_digest, 32,
+                                         errp) &&
+        crucible_checkpoint_writer_write(writer, parent_frontier_digest, 32,
+                                         errp);
+}
+
+static bool crucible_checkpoint_write_topology(
+    CrucibleCheckpointWriter *writer,
+    const CrucibleCheckpointRamTopology *topology,
+    Error **errp)
+{
+    for (guint index = 0; index < topology->regions->len; index++) {
+        CrucibleCheckpointRamRegion *region = &g_array_index(
+            topology->regions, CrucibleCheckpointRamRegion, index);
+        size_t name_length = strlen(region->name);
+
+        if (!crucible_checkpoint_writer_u64(
+                writer, region->length, errp) ||
+            !crucible_checkpoint_writer_u64(
+                writer, region->maximum_length, errp) ||
+            !crucible_checkpoint_writer_u64(writer, region->page_size, errp) ||
+            !crucible_checkpoint_writer_u32(writer, name_length, errp) ||
+            !crucible_checkpoint_writer_write(writer, region->name,
+                                               name_length, errp)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool crucible_checkpoint_write_ram_records(
+    CrucibleCheckpointWriter *writer,
+    const CrucibleCheckpointRamTopology *topology,
+    CrucibleCheckpointRamKind kind,
+    Error **errp)
+{
+    g_autofree uint8_t *buffer =
+        g_malloc(CRUCIBLE_CHECKPOINT_RAM_RECORD_MAX_BYTES);
+
+    for (guint index = 0; index < topology->regions->len; index++) {
+        CrucibleCheckpointRamRegion *region = &g_array_index(
+            topology->regions, CrucibleCheckpointRamRegion, index);
+        uint64_t offset = 0;
+
+        while (offset < region->length) {
+            uint64_t record_bytes = 0;
+            if (kind == CRUCIBLE_CHECKPOINT_RAM_KIND_DIRECT) {
+                record_bytes = MIN(region->length - offset,
+                                   CRUCIBLE_CHECKPOINT_RAM_RECORD_MAX_BYTES);
+            } else if (!crucible_checkpoint_next_dirty_run(
+                           region, offset, &offset, &record_bytes)) {
+                break;
+            }
+
+            memcpy(buffer,
+                   (uint8_t *)qemu_ram_get_host_addr(region->ram_block) +
+                       offset,
+                   record_bytes);
+            if (!crucible_checkpoint_writer_u32(writer, index, errp) ||
+                !crucible_checkpoint_writer_u32(
+                    writer, record_bytes, errp) ||
+                !crucible_checkpoint_writer_u64(writer, offset, errp) ||
+                !crucible_checkpoint_writer_write(
+                    writer, buffer, record_bytes, errp)) {
+                return false;
+            }
+            offset += record_bytes;
+        }
+    }
+    return true;
+}
+
+static bool crucible_checkpoint_output_file(
+    int fd,
+    const char *description,
+    struct stat *stat_buffer,
+    Error **errp)
+{
+    int flags;
+
+    if (fd < 0 || fstat(fd, stat_buffer) < 0) {
+        error_setg_errno(errp, errno,
+                         "Could not inspect Crucible checkpoint %s", description);
+        return false;
+    }
+    flags = fcntl(fd, F_GETFL);
+    if (!S_ISREG(stat_buffer->st_mode) || flags < 0 ||
+        (flags & O_ACCMODE) == O_RDONLY) {
+        error_setg(errp, "Crucible checkpoint %s must be a writable regular "
+                   "file", description);
+        return false;
+    }
+    return true;
+}
+
+static bool crucible_checkpoint_prepare_output_file(
+    int fd,
+    const char *description,
+    Error **errp)
+{
+    if (ftruncate(fd, 0) < 0 || lseek(fd, 0, SEEK_SET) < 0) {
+        error_setg_errno(errp, errno,
+                         "Could not prepare Crucible checkpoint %s", description);
+        return false;
+    }
+    return true;
+}
+
+static int crucible_checkpoint_save_device_state(
+    int fd,
+    int cancellation_fd,
+    uint64_t maximum_bytes,
+    uint64_t *written_out,
+    uint8_t digest_out[32],
+    Error **errp)
+{
+    QIOChannelCrucibleCheckpoint *channel =
+        crucible_checkpoint_channel_new(fd, cancellation_fd, maximum_bytes);
+    QEMUFile *file = qemu_file_new_output(QIO_CHANNEL(channel));
+    int status;
+    int close_status;
+    gsize digest_length = 32;
+
+    global_state_store();
+    qemu_savevm_send_header(file);
+    status = qemu_save_device_state(file, errp);
+    if (status == 0) {
+        status = qemu_fflush(file);
+    }
+    if (status == 0) {
+        status = qemu_file_get_error_obj(file, errp);
+    }
+    *written_out = channel->written;
+    close_status = qemu_fclose(file);
+    if (status == 0 && close_status >= 0) {
+        g_checksum_get_digest(channel->checksum, digest_out, &digest_length);
+        if (digest_length != 32) {
+            error_setg(errp, "Could not finalize Crucible checkpoint device "
+                       "VMState digest");
+            status = -EIO;
+        }
+    }
+    object_unref(OBJECT(channel));
+    if (status == 0 && close_status < 0) {
+        status = close_status;
+        if (!*errp) {
+            error_setg(errp, "Could not close Crucible checkpoint device "
+                       "VMState");
+        }
+    }
+    if (status != 0 && !*errp) {
+        error_setg_errno(errp, status < 0 ? -status : EIO,
+                         "Could not serialize Crucible checkpoint device "
+                         "VMState");
+    }
+    return status;
+}
+
+static void crucible_checkpoint_candidate_clear(void)
+{
+    /*
+     * A successful capture retains the migration/raw-state reservation for
+     * the candidate's entire lifetime. Release it only after invalidating the
+     * candidate so no competing state operation can observe it as active.
+     */
+    bool release_capture = crucible_checkpoint_authority.candidate_active;
+
+    g_clear_pointer(&crucible_checkpoint_authority
+                         .candidate_checkpoint_sha256,
+                    g_free);
+    g_clear_pointer(&crucible_checkpoint_authority.candidate_target_sha256,
+                    g_free);
+    g_clear_pointer(&crucible_checkpoint_authority.candidate_frontier_sha256,
+                    g_free);
+    memset(crucible_checkpoint_authority.candidate_topology_digest, 0,
+           sizeof(crucible_checkpoint_authority.candidate_topology_digest));
+    memset(crucible_checkpoint_authority.candidate_device_digest, 0,
+           sizeof(crucible_checkpoint_authority.candidate_device_digest));
+    crucible_checkpoint_authority.candidate_dirty_generation = 0;
+    crucible_checkpoint_authority.candidate_maximum_device_bytes = 0;
+    crucible_checkpoint_authority.candidate_active = false;
+    if (release_capture) {
+        migration_crucible_checkpoint_capture_end();
+    }
+}
+
+static void crucible_checkpoint_committed_clear(void)
+{
+    g_clear_pointer(&crucible_checkpoint_authority
+                         .committed_checkpoint_sha256,
+                    g_free);
+    g_clear_pointer(&crucible_checkpoint_authority.committed_target_sha256,
+                    g_free);
+    g_clear_pointer(&crucible_checkpoint_authority.committed_frontier_sha256,
+                    g_free);
+    memset(crucible_checkpoint_authority.committed_topology_digest, 0,
+           sizeof(crucible_checkpoint_authority.committed_topology_digest));
+    crucible_checkpoint_authority.epoch_active = false;
+}
+
+void qemu_crucible_checkpoint_restore_authority_failed(void)
+{
+    crucible_checkpoint_candidate_clear();
+    crucible_checkpoint_committed_clear();
+    if (global_dirty_tracking & GLOBAL_DIRTY_CRUCIBLE_CHECKPOINT) {
+        qemu_ram_foreach_block(crucible_checkpoint_set_private_dirty_block,
+                               NULL);
+    }
+}
+
+bool qemu_crucible_checkpoint_restore_authority_succeeded(
+    const char *checkpoint_sha256,
+    const char *target_sha256,
+    const char *frontier_sha256,
+    const uint8_t topology_digest[32],
+    Error **errp)
+{
+    Error *local_error = NULL;
+    uint64_t validated_dirty_generation;
+
+    if (!(global_dirty_tracking & GLOBAL_DIRTY_CRUCIBLE_CHECKPOINT) &&
+        !memory_global_dirty_log_start(
+            GLOBAL_DIRTY_CRUCIBLE_CHECKPOINT, &local_error)) {
+        error_propagate_prepend(errp, local_error,
+                                "Could not start restored Crucible checkpoint "
+                                "dirty epoch: ");
+        return false;
+    }
+
+    validated_dirty_generation =
+        qatomic_read(&crucible_checkpoint_dirty_generation);
+    crucible_checkpoint_candidate_clear();
+    crucible_checkpoint_committed_clear();
+    qemu_ram_foreach_block(crucible_checkpoint_clear_private_dirty_block,
+                           NULL);
+    /* Pair prior RAM validation with the generation sample after clearing. */
+    smp_mb();
+    if (qatomic_read(&crucible_checkpoint_dirty_generation) !=
+        validated_dirty_generation) {
+        qemu_ram_foreach_block(crucible_checkpoint_set_private_dirty_block,
+                               NULL);
+        error_setg(errp, "Restored Crucible checkpoint changed while its "
+                   "dirty epoch was advancing");
+        return false;
+    }
+    crucible_checkpoint_authority.committed_checkpoint_sha256 =
+        g_strdup(checkpoint_sha256);
+    crucible_checkpoint_authority.committed_target_sha256 =
+        g_strdup(target_sha256);
+    crucible_checkpoint_authority.committed_frontier_sha256 =
+        g_strdup(frontier_sha256);
+    memcpy(crucible_checkpoint_authority.committed_topology_digest,
+           topology_digest,
+           sizeof(crucible_checkpoint_authority.committed_topology_digest));
+    crucible_checkpoint_authority.epoch_active = true;
+    crucible_checkpoint_authority.epoch_generation++;
+    return true;
+}
+
+static void crucible_checkpoint_vmstate_changed(
+    void *opaque G_GNUC_UNUSED,
+    bool running,
+    RunState state G_GNUC_UNUSED)
+{
+    if (running && crucible_checkpoint_authority.candidate_active) {
+        /* A resumed candidate is stale. Keep every dirty bit and the prior
+         * committed authority so a later pause cannot commit it. */
+        crucible_checkpoint_candidate_clear();
+    }
+}
+
+bool qemu_crucible_checkpoint_candidate_active(void)
+{
+    return crucible_checkpoint_authority.candidate_active;
+}
+
+static CrucibleCheckpointEpochState *crucible_checkpoint_epoch_report(void)
+{
+    CrucibleCheckpointEpochState *report =
+        g_new0(CrucibleCheckpointEpochState, 1);
+
+    report->schema_version = CRUCIBLE_CHECKPOINT_SCHEMA_VERSION;
+    report->epoch_active = crucible_checkpoint_authority.epoch_active;
+    report->epoch_generation =
+        crucible_checkpoint_authority.epoch_generation;
+    report->candidate_active =
+        crucible_checkpoint_authority.candidate_active;
+    if (crucible_checkpoint_authority.epoch_active) {
+        report->committed_checkpoint_sha256 = g_strdup(
+            crucible_checkpoint_authority.committed_checkpoint_sha256);
+        report->committed_target_sha256 = g_strdup(
+            crucible_checkpoint_authority.committed_target_sha256);
+        report->committed_frontier_sha256 = g_strdup(
+            crucible_checkpoint_authority.committed_frontier_sha256);
+    }
+    if (crucible_checkpoint_authority.candidate_active) {
+        report->candidate_checkpoint_sha256 = g_strdup(
+            crucible_checkpoint_authority.candidate_checkpoint_sha256);
+        report->candidate_target_sha256 = g_strdup(
+            crucible_checkpoint_authority.candidate_target_sha256);
+        report->candidate_frontier_sha256 = g_strdup(
+            crucible_checkpoint_authority.candidate_frontier_sha256);
+    }
+    return report;
+}
+
+static bool crucible_checkpoint_candidate_matches(
+    const char *checkpoint_sha256,
+    const char *target_sha256,
+    const char *frontier_sha256)
+{
+    return crucible_checkpoint_authority.candidate_active &&
+        strcmp(checkpoint_sha256,
+               crucible_checkpoint_authority.candidate_checkpoint_sha256) == 0 &&
+        strcmp(target_sha256,
+               crucible_checkpoint_authority.candidate_target_sha256) == 0 &&
+        strcmp(frontier_sha256,
+               crucible_checkpoint_authority.candidate_frontier_sha256) == 0;
+}
+
+static void crucible_checkpoint_clear_private_dirty_range(
+    ram_addr_t start,
+    ram_addr_t length)
+{
+    DirtyMemoryBlocks *blocks;
+    unsigned long end = TARGET_PAGE_ALIGN(start + length) >> TARGET_PAGE_BITS;
+    unsigned long page = start >> TARGET_PAGE_BITS;
+    bool cleared = false;
+
+    WITH_RCU_READ_LOCK_GUARD() {
+        blocks = qatomic_rcu_read(
+            &ram_list.dirty_memory[DIRTY_MEMORY_CRUCIBLE_CHECKPOINT]);
+        while (page < end) {
+            unsigned long index = page / DIRTY_MEMORY_BLOCK_SIZE;
+            unsigned long offset = page % DIRTY_MEMORY_BLOCK_SIZE;
+            unsigned long count = MIN(end - page,
+                                      DIRTY_MEMORY_BLOCK_SIZE - offset);
+
+            cleared |= bitmap_test_and_clear_atomic(
+                blocks->blocks[index], offset, count);
+            page += count;
+        }
+    }
+
+    if (cleared) {
+        /* Re-arm translated guest writes without clearing other clients. */
+        physical_memory_dirty_bits_cleared(start, length);
+    }
+}
+
+static int crucible_checkpoint_clear_private_dirty_block(
+    RAMBlock *ram_block,
+    void *opaque G_GNUC_UNUSED)
+{
+    crucible_checkpoint_clear_private_dirty_range(
+        qemu_ram_get_offset(ram_block), qemu_ram_get_used_length(ram_block));
+    return 0;
+}
+
+static int crucible_checkpoint_set_private_dirty_block(
+    RAMBlock *ram_block,
+    void *opaque G_GNUC_UNUSED)
+{
+    physical_memory_set_dirty_range(
+        qemu_ram_get_offset(ram_block), qemu_ram_get_used_length(ram_block),
+        1 << DIRTY_MEMORY_CRUCIBLE_CHECKPOINT);
+    return 0;
+}
+
+CrucibleCheckpointCapture *qemu_crucible_checkpoint_capture(
+    CrucibleCheckpointRamKind kind,
+    int ram_fd,
+    int device_fd,
+    int cancellation_fd,
+    const char *checkpoint_sha256,
+    const char *target_sha256,
+    const char *frontier_sha256,
+    bool has_parent_checkpoint_sha256,
+    const char *parent_checkpoint_sha256,
+    bool has_parent_target_sha256,
+    const char *parent_target_sha256,
+    bool has_parent_frontier_sha256,
+    const char *parent_frontier_sha256,
+    uint64_t maximum_ram_bytes,
+    uint64_t maximum_device_bytes,
+    Error **errp)
+{
+    g_autoptr(GArray) regions = NULL;
+    g_autoptr(GArray) captured_regions = NULL;
+    CrucibleCheckpointRamTopology topology;
+    CrucibleCheckpointRamTopology captured_topology;
+    CrucibleCheckpointCapture *report = NULL;
+    CrucibleCheckpointWriter writer = {
+        .fd = ram_fd,
+        .cancellation_fd = cancellation_fd,
+        .maximum_bytes = maximum_ram_bytes,
+    };
+    uint8_t checkpoint_digest[32];
+    uint8_t target_digest[32];
+    uint8_t frontier_digest[32];
+    uint8_t parent_checkpoint_digest[32] = { 0 };
+    uint8_t parent_target_digest[32] = { 0 };
+    uint8_t parent_frontier_digest[32] = { 0 };
+    uint8_t device_digest[32];
+    struct stat ram_stat;
+    struct stat device_stat;
+    uint64_t device_bytes = 0;
+    uint64_t capture_dirty_generation;
+    bool parent_complete = has_parent_checkpoint_sha256 &&
+        has_parent_target_sha256 && has_parent_frontier_sha256;
+    bool parent_absent = !has_parent_checkpoint_sha256 &&
+        !has_parent_target_sha256 && !has_parent_frontier_sha256;
+    bool capture_reserved = false;
+    int status;
+
+    if (!crucible_checkpoint_exact_paused_boundary()) {
+        error_setg(errp, "Crucible checkpoint capture requires the exact "
+                   "paused deterministic simulator boundary");
+        goto out;
+    }
+    if (crucible_checkpoint_authority.candidate_active) {
+        error_setg(errp, "A Crucible checkpoint candidate is already active");
+        goto out;
+    }
+    if (maximum_ram_bytes == 0 || maximum_device_bytes == 0 ||
+        maximum_ram_bytes > INT64_MAX || maximum_device_bytes > INT64_MAX) {
+        error_setg(errp, "Crucible checkpoint byte ceilings must be positive "
+                   "signed file offsets");
+        goto out;
+    }
+    if (!crucible_checkpoint_identity(checkpoint_sha256, checkpoint_digest,
+                                      errp) ||
+        !crucible_checkpoint_identity(target_sha256, target_digest, errp) ||
+        !crucible_checkpoint_identity(frontier_sha256, frontier_digest,
+                                      errp)) {
+        goto out;
+    }
+    if (kind == CRUCIBLE_CHECKPOINT_RAM_KIND_DIRECT && !parent_absent) {
+        error_setg(errp, "A direct Crucible checkpoint cannot name a parent");
+        goto out;
+    }
+    if (kind == CRUCIBLE_CHECKPOINT_RAM_KIND_DELTA) {
+        if (!parent_complete || !crucible_checkpoint_authority.epoch_active) {
+            error_setg(errp, "A delta Crucible checkpoint requires one complete "
+                       "committed parent identity");
+            goto out;
+        }
+        if (!crucible_checkpoint_identity(parent_checkpoint_sha256,
+                                          parent_checkpoint_digest, errp) ||
+            !crucible_checkpoint_identity(parent_target_sha256,
+                                          parent_target_digest, errp) ||
+            !crucible_checkpoint_identity(parent_frontier_sha256,
+                                          parent_frontier_digest, errp)) {
+            goto out;
+        }
+        if (strcmp(parent_checkpoint_sha256,
+                   crucible_checkpoint_authority.committed_checkpoint_sha256) ||
+            strcmp(parent_target_sha256,
+                   crucible_checkpoint_authority.committed_target_sha256) ||
+            strcmp(parent_frontier_sha256,
+                   crucible_checkpoint_authority.committed_frontier_sha256)) {
+            error_setg(errp, "Crucible checkpoint delta parent does not match "
+                       "committed authority");
+            goto out;
+        }
+    }
+    if (!crucible_checkpoint_output_file(ram_fd, "RAM file", &ram_stat,
+                                         errp) ||
+        !crucible_checkpoint_output_file(device_fd, "device VMState file",
+                                         &device_stat, errp)) {
+        goto out;
+    }
+    if (ram_stat.st_dev == device_stat.st_dev &&
+        ram_stat.st_ino == device_stat.st_ino) {
+        error_setg(errp, "Crucible checkpoint output files must not alias");
+        goto out;
+    }
+
+    status = migration_crucible_checkpoint_capture_begin();
+    if (status != 0) {
+        error_setg_errno(errp, -status,
+                         "Crucible checkpoint state capture is unavailable");
+        goto out;
+    }
+    capture_reserved = true;
+    if (!(global_dirty_tracking & GLOBAL_DIRTY_CRUCIBLE_CHECKPOINT) &&
+        !memory_global_dirty_log_start(
+            GLOBAL_DIRTY_CRUCIBLE_CHECKPOINT, errp)) {
+        error_prepend(errp, "Could not start Crucible checkpoint dirty "
+                      "tracking: ");
+        goto out;
+    }
+    if (!crucible_checkpoint_collect_topology(&topology, errp)) {
+        regions = topology.regions;
+        goto out;
+    }
+    regions = topology.regions;
+    if (kind == CRUCIBLE_CHECKPOINT_RAM_KIND_DELTA &&
+        memcmp(topology.digest,
+               crucible_checkpoint_authority.committed_topology_digest,
+               sizeof(topology.digest)) != 0) {
+        error_setg(errp, "Crucible checkpoint delta RAM topology does not match "
+                   "its committed parent");
+        goto out;
+    }
+    if (!crucible_checkpoint_prepare_output_file(
+            ram_fd, "RAM file", errp) ||
+        !crucible_checkpoint_prepare_output_file(
+            device_fd, "device VMState file", errp)) {
+        goto out;
+    }
+
+    /* qemu_save_device_state() has the same deterministic pre-save callbacks
+     * as QEMU's existing snapshot contract. Run them before RAM is measured
+     * and copied so any callback RAM effects are part of this candidate. */
+    status = crucible_checkpoint_save_device_state(
+        device_fd, cancellation_fd, maximum_device_bytes, &device_bytes,
+        device_digest, errp);
+    device_fd = -1;
+    if (status != 0 || device_bytes == 0) {
+        if (status == 0) {
+            error_setg(errp, "Crucible checkpoint device VMState was empty");
+        }
+        goto out;
+    }
+    if (!crucible_checkpoint_collect_topology(&captured_topology, errp)) {
+        captured_regions = captured_topology.regions;
+        goto out;
+    }
+    captured_regions = captured_topology.regions;
+    if (memcmp(topology.digest, captured_topology.digest,
+               sizeof(topology.digest)) != 0) {
+        error_setg(errp, "Crucible checkpoint RAM topology changed during "
+                   "device pre-save");
+        goto out;
+    }
+    capture_dirty_generation =
+        qatomic_read(&crucible_checkpoint_dirty_generation);
+    if (!crucible_checkpoint_measure_ram(&captured_topology, kind, errp) ||
+        captured_topology.payload_bytes > maximum_ram_bytes) {
+        if (!*errp) {
+            error_setg(errp, "Crucible checkpoint RAM exceeds its maximum byte "
+                       "count");
+        }
+        goto out;
+    }
+    if (!crucible_checkpoint_write_ram_header(
+            &writer, &captured_topology, kind, checkpoint_digest, target_digest,
+            frontier_digest, parent_checkpoint_digest, parent_target_digest,
+            parent_frontier_digest, errp) ||
+        !crucible_checkpoint_write_topology(
+            &writer, &captured_topology, errp) ||
+        !crucible_checkpoint_write_ram_records(
+            &writer, &captured_topology, kind, errp) ||
+        writer.written != captured_topology.payload_bytes ||
+        qatomic_read(&crucible_checkpoint_dirty_generation) !=
+            capture_dirty_generation) {
+        if (!*errp) {
+            error_setg(errp, "Crucible checkpoint RAM byte count changed during "
+                       "capture");
+        }
+        goto out;
+    }
+    if (fdatasync(ram_fd) < 0) {
+        error_setg_errno(errp, errno,
+                         "Could not synchronize Crucible checkpoint RAM");
+        goto out;
+    }
+
+    crucible_checkpoint_authority.candidate_active = true;
+    crucible_checkpoint_authority.candidate_kind = kind;
+    crucible_checkpoint_authority.candidate_checkpoint_sha256 =
+        g_strdup(checkpoint_sha256);
+    crucible_checkpoint_authority.candidate_target_sha256 =
+        g_strdup(target_sha256);
+    crucible_checkpoint_authority.candidate_frontier_sha256 =
+        g_strdup(frontier_sha256);
+    memcpy(crucible_checkpoint_authority.candidate_topology_digest,
+           captured_topology.digest, sizeof(captured_topology.digest));
+    memcpy(crucible_checkpoint_authority.candidate_device_digest,
+           device_digest, sizeof(device_digest));
+    crucible_checkpoint_authority.candidate_dirty_generation =
+        capture_dirty_generation;
+    crucible_checkpoint_authority.candidate_maximum_device_bytes =
+        maximum_device_bytes;
+    if (!crucible_checkpoint_vmstate_handler) {
+        crucible_checkpoint_vmstate_handler = qemu_add_vm_change_state_handler(
+            crucible_checkpoint_vmstate_changed, NULL);
+    }
+
+    report = g_new0(CrucibleCheckpointCapture, 1);
+    report->schema_version = CRUCIBLE_CHECKPOINT_SCHEMA_VERSION;
+    report->kind = kind;
+    report->checkpoint_sha256 = g_strdup(checkpoint_sha256);
+    report->target_sha256 = g_strdup(target_sha256);
+    report->frontier_sha256 = g_strdup(frontier_sha256);
+    report->topology_sha256 = g_strdup(captured_topology.digest_hex);
+    report->ram_regions = captured_topology.regions->len;
+    report->ram_records = captured_topology.record_count;
+    report->ram_bytes = writer.written;
+    report->device_bytes = device_bytes;
+
+out:
+    /*
+     * A successful candidate keeps exclusive migration/raw-state authority
+     * until commit, abort, or invalidation clears the candidate.
+     */
+    if (capture_reserved && !report) {
+        migration_crucible_checkpoint_capture_end();
+    }
+    if (ram_fd >= 0) {
+        close(ram_fd);
+    }
+    if (device_fd >= 0) {
+        close(device_fd);
+    }
+    return report;
+}
+
+CrucibleCheckpointEpochState *qemu_crucible_checkpoint_commit(
+    const char *checkpoint_sha256,
+    const char *target_sha256,
+    const char *frontier_sha256,
+    Error **errp)
+{
+    g_autoptr(GArray) regions = NULL;
+    CrucibleCheckpointRamTopology topology;
+    Error *local_error = NULL;
+    uint8_t device_digest[32];
+    uint64_t device_bytes;
+    uint64_t validated_dirty_generation;
+    int status;
+
+    /*
+     * The successful capture that created the candidate still owns the
+     * migration/raw-state reservation. candidate_clear() releases it only
+     * after this validation and dirty-bitmap transition finish.
+     */
+    if (!crucible_checkpoint_exact_paused_boundary()) {
+        error_setg(errp, "Crucible checkpoint commit requires the exact paused "
+                   "deterministic simulator boundary");
+        return NULL;
+    }
+    if (!crucible_checkpoint_candidate_matches(
+            checkpoint_sha256, target_sha256, frontier_sha256)) {
+        error_setg(errp, "Crucible checkpoint commit identity does not match "
+                   "the active candidate");
+        return NULL;
+    }
+    if (qatomic_read(&crucible_checkpoint_dirty_generation) !=
+        crucible_checkpoint_authority.candidate_dirty_generation) {
+        error_setg(errp, "Crucible checkpoint candidate became stale after a "
+                   "RAM write");
+        return NULL;
+    }
+    if (!crucible_checkpoint_collect_topology(&topology, errp)) {
+        regions = topology.regions;
+        return NULL;
+    }
+    regions = topology.regions;
+    if (memcmp(topology.digest,
+               crucible_checkpoint_authority.candidate_topology_digest,
+               sizeof(topology.digest)) != 0) {
+        error_setg(errp, "Crucible checkpoint candidate RAM topology became "
+                   "stale");
+        return NULL;
+    }
+    status = crucible_checkpoint_save_device_state(
+        -1, -1,
+        crucible_checkpoint_authority.candidate_maximum_device_bytes,
+        &device_bytes, device_digest, errp);
+    if (status != 0 || device_bytes == 0) {
+        if (status == 0) {
+            error_setg(errp, "Crucible checkpoint validation VMState was "
+                       "empty");
+        }
+        return NULL;
+    }
+    if (memcmp(device_digest,
+               crucible_checkpoint_authority.candidate_device_digest,
+               sizeof(device_digest)) != 0 ||
+        qatomic_read(&crucible_checkpoint_dirty_generation) !=
+            crucible_checkpoint_authority.candidate_dirty_generation) {
+        error_setg(errp, "Crucible checkpoint candidate device or RAM state "
+                   "became stale");
+        return NULL;
+    }
+    validated_dirty_generation =
+        crucible_checkpoint_authority.candidate_dirty_generation;
+    if (!crucible_checkpoint_authority.epoch_active &&
+        !memory_global_dirty_log_start(
+            GLOBAL_DIRTY_CRUCIBLE_CHECKPOINT, &local_error)) {
+        error_propagate_prepend(errp, local_error,
+                                "Could not start Crucible checkpoint dirty "
+                                "epoch: ");
+        return NULL;
+    }
+
+    /* QMP owns the BQL and the exact paused/device-flushed boundary across
+     * validation and clear. A violating RAM writer advances the generation;
+     * restore an all-dirty private bitmap before refusing the commit. */
+    qemu_ram_foreach_block(crucible_checkpoint_clear_private_dirty_block,
+                           NULL);
+    /* Pair prior candidate validation with the generation sample after clear. */
+    smp_mb();
+    if (qatomic_read(&crucible_checkpoint_dirty_generation) !=
+        validated_dirty_generation) {
+        qemu_ram_foreach_block(crucible_checkpoint_set_private_dirty_block,
+                               NULL);
+        error_setg(errp, "Crucible checkpoint candidate changed while its "
+                   "dirty epoch was advancing");
+        return NULL;
+    }
+    g_free(crucible_checkpoint_authority.committed_checkpoint_sha256);
+    g_free(crucible_checkpoint_authority.committed_target_sha256);
+    g_free(crucible_checkpoint_authority.committed_frontier_sha256);
+    crucible_checkpoint_authority.committed_checkpoint_sha256 =
+        g_strdup(checkpoint_sha256);
+    crucible_checkpoint_authority.committed_target_sha256 =
+        g_strdup(target_sha256);
+    crucible_checkpoint_authority.committed_frontier_sha256 =
+        g_strdup(frontier_sha256);
+    memcpy(crucible_checkpoint_authority.committed_topology_digest,
+           crucible_checkpoint_authority.candidate_topology_digest,
+           sizeof(crucible_checkpoint_authority.committed_topology_digest));
+    crucible_checkpoint_authority.epoch_active = true;
+    crucible_checkpoint_authority.epoch_generation++;
+    crucible_checkpoint_candidate_clear();
+    return crucible_checkpoint_epoch_report();
+}
+
+CrucibleCheckpointEpochState *qemu_crucible_checkpoint_abort(
+    const char *checkpoint_sha256,
+    const char *target_sha256,
+    const char *frontier_sha256,
+    Error **errp)
+{
+    if (!crucible_checkpoint_candidate_matches(
+            checkpoint_sha256, target_sha256, frontier_sha256)) {
+        error_setg(errp, "Crucible checkpoint abort identity does not match "
+                   "the active candidate");
+        return NULL;
+    }
+    crucible_checkpoint_candidate_clear();
+    return crucible_checkpoint_epoch_report();
+}
+
+CrucibleCheckpointEpochState *qemu_query_crucible_checkpoint_epoch(void)
+{
+    return crucible_checkpoint_epoch_report();
+}
diff --git a/system/crucible-hot-fork-coordinator.c b/system/crucible-hot-fork-coordinator.c
new file mode 100644
index 0000000000000000000000000000000000000000..e8f027d4691f650dec356f26638c11943a6cc7bf
--- /dev/null
+++ b/system/crucible-hot-fork-coordinator.c
@@ -0,0 +1,552 @@
+/*
+ * Crucible main-loop hot-fork coordinator.
+ *
