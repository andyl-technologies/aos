+    qemu_plugin_crucible_rr_control_boundary_acknowledge();
+    service_events();
+    g_assert_cmpuint(control_calls, ==, 1);
+    g_assert_cmpuint(qemu_plugin_rr_control_complete_generation, ==, 1);
+    g_assert_false(qemu_plugin_crucible_vmstop_pending());
