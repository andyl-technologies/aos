+static int operational_read(uint64_t address, uint8_t *bytes, uint32_t valid)
+{
+    qemu_plugin_crucible_ram_operational_read_v1 reader =
+        qatomic_load_acquire(&operational_reader);
+
+    if (reader) {
+        /* A cold read authenticates staging; it never populates guest RAM. */
+        return reader(address, bytes, valid);
+    }
+    memcpy(bytes, (const void *)(uintptr_t)address, valid);
+    return 0;
+}
+
+static bool capture_authorized(void)
+{
+    return bql_locked() && replay_mode == REPLAY_MODE_NONE &&
+        ((fault_root_writer_scope && current_cpu &&
+          replay_mutex_owned()) ||
+         (qemu_plugin_crucible_exact_boundary_active() &&
+          (qemu_plugin_crucible_control_boundary_active() ||
+         (runstate_check(RUN_STATE_PAUSED) &&
+           qemu_plugin_crucible_vmstop_quiesced()))));
+}
+
+/* Token possession alone does not authorize a diagnostic RAM read. The
+ * retained record binds the original paused owner and its immutable stop. */
+static bool diagnostic_capture_authorized(uint64_t token)
+{
+    const CrucibleRamOwnerDiagnostic *owner = NULL;
+
+    for (size_t index = 0; index < G_N_ELEMENTS(owner_diagnostics); index++) {
+        if (token && owner_diagnostics[index].attempted &&
+            owner_diagnostics[index].token == token) {
+            owner = &owner_diagnostics[index];
+            break;
+        }
+    }
+    return owner && !owner->first_status && !owner->proc_close_status &&
+        !owner->release_status &&
+        token == physical_token && !current_cpu &&
+        replay_mode == REPLAY_MODE_NONE &&
+        owner->topology_generation == physical_topology &&
+        physical_topology == qatomic_read(&topology_generation) &&
+        owner->vmstop_generation == qemu_plugin_crucible_vmstop_generation() &&
+        owner->raw_icount == (uint64_t)icount_get_raw_observed() &&
+        qemu_crucible_ram_owner_closure_current(token) &&
+        physical_device_generation == qemu_crucible_ram_physical_device_generation() &&
+        physical_listener_generation == qemu_crucible_ram_physical_listener_generation() &&
+        qatomic_load_acquire(&root_reader_registration.state) == ROOT_READERS_READY &&
+        !qemu_plugin_crucible_control_boundary_active() &&
+        !qemu_plugin_crucible_exact_boundary_active() &&
+        !restore_staged && !restore_destructive && !mutation_writer_scope &&
+        !mutation_preflight_scope && !admission_grant_open && admission_grant_applied;
+}
+
+uint64_t qemu_crucible_ram_inventory_body_bytes(unsigned capacity)
+{
+    size_t pointers;
+    size_t bytes;
+
+    if (capacity > 4096 ||
+        !g_size_checked_mul(&pointers, capacity, sizeof(CrucibleRamRegion *)) ||
+        !g_size_checked_add(&bytes, sizeof(CrucibleRamInventory), pointers)) {
+        return 0;
+    }
+    return bytes;
+}
+
+QemuCrucibleRamReturnJournal *qemu_crucible_ram_inventory_return_journal(unsigned row)
+{
+    return row < G_N_ELEMENTS(inventory_owners) ?
+           &inventory_owners[row].returned : NULL;
+}
+
+int qemu_crucible_ram_metadata_owner_current(
+    QemuCrucibleRamMetadataOwner *owner, QemuCrucibleRamReturnJournal *journal)
+{
+    int context = qemu_crucible_ram_metadata_return_context();
+
+    if (context <= 0 || !bql_locked()) {
+        return context < 0 ? context : -EPERM;
+    }
+    for (size_t index = 0; index < G_N_ELEMENTS(inventory_owners); index++) {
+        CrucibleRamInventoryOwner *row = &inventory_owners[index];
+        bool matched = false;
+
+        if (journal != &row->returned) {
+            continue;
+        }
+        if (row->sort_scratch && owner == &row->scratch_owner) {
+            matched = owner->address == (uintptr_t)row->sort_scratch &&
+                owner->bytes == row->scratch_bytes;
+        } else if (row->current_region &&
+                   owner == &row->current_region->metadata_owner) {
+            matched = (row->mr_phase == RAM_MR_NOT_OWED ||
+                       row->mr_phase == RAM_MR_RETURNED) &&
+                owner->address == (uintptr_t)row->current_region &&
+                owner->bytes == sizeof(CrucibleRamRegion);
+        } else if (row->constructing_region &&
+                   owner == &row->constructing_region->metadata_owner) {
+            matched = !row->constructing_region->memory_region_held &&
+                owner->address == (uintptr_t)row->constructing_region &&
+                owner->bytes == sizeof(CrucibleRamRegion);
+        } else if (row->array && owner == &row->container_owner) {
+            matched = row->state == RAM_INVENTORY_CLOSING && !row->references &&
+                !row->current_region && !row->constructing_region &&
+                !row->sort_scratch && row->cleanup_index == row->array->len &&
+                owner->address == (uintptr_t)row->array &&
+                owner->bytes == qemu_crucible_ram_inventory_body_bytes(
+                    row->array->capacity);
+        }
+        if (!matched || qatomic_cmpxchg(&owner->returning, 0, 1)) {
+            return -EBUSY;
+        }
+        return 0;
+    }
+    return qemu_crucible_ram_dirty_metadata_owner_current(owner, journal);
+}
+
+static int region_inventory_members(uint64_t *count, uint64_t *topology)
+{
+    RAMBlock *block;
+    int status = 0;
+
+    *count = 0;
+    qemu_mutex_lock_ramlist();
+    *topology = qatomic_read(&topology_generation);
+    RAMBLOCK_FOREACH(block) {
+        if (*count == UINT64_MAX) {
+            status = -EOVERFLOW;
+            break;
+        }
+        (*count)++;
+    }
+    qemu_mutex_unlock_ramlist();
+    return status;
+}
+
+static int region_inventory_new(CrucibleRamInventory **result)
+{
+    QemuCrucibleMetadataBirthLoan birth = { 0 };
+    CrucibleRamInventoryOwner *row = NULL;
+    CrucibleRamInventory *array;
+    uint64_t topology;
+    uint64_t members;
+    unsigned capacity;
+    unsigned index;
+    bool selected = qemu_crucible_startup_source_control_metadata_bytes() != 0;
+    int status;
+
+    if (!bql_locked()) {
+        return -EPERM;
+    }
+    status = qemu_crucible_startup_source_native_metadata_check();
+    if (status) {
+        return status;
+    }
+    status = region_inventory_members(&members, &topology);
+    if (status) {
+        return status;
+    }
+    /* Ordinary small inventories pay their exact current count. Above the
+     * historical capture maximum, do not allocate an unusable larger body or
+     * preempt the existing ordered block/id refusals with an early ENOSPC. */
+    capacity = MIN(members, UINT64_C(4096));
+    if (selected) {
+        status = qemu_crucible_startup_source_native_metadata_preentry();
+        if (status) {
+            return status;
+        }
+        for (index = 0; index < G_N_ELEMENTS(inventory_owners); index++) {
+            if (qatomic_cmpxchg(&inventory_owners[index].state,
+                               RAM_INVENTORY_FREE, RAM_INVENTORY_CONSTRUCTING) ==
+                RAM_INVENTORY_FREE) {
+                row = &inventory_owners[index];
+                break;
+            }
+        }
+        if (!row) {
+            return -EBUSY;
+        }
+        capacity = 4096;
+        status = qemu_crucible_startup_source_ram_inventory_birth_begin(
+            index, capacity, &birth);
+        if (status) {
+            row->state = RAM_INVENTORY_RETAINED;
+            return status;
+        }
+    }
+    array = g_malloc0(qemu_crucible_ram_inventory_body_bytes(capacity));
+    array->capacity = capacity;
+    array->references = 1;
+    array->topology = topology;
+    array->owner = row;
+    if (row) {
+        row->array = array;
+        row->references = 1;
+        row->incarnation = birth.serial;
+        crucible_ram_metadata_birth_transfer(&birth, &row->container_owner,
+            array, qemu_crucible_ram_inventory_body_bytes(capacity));
+        row->state = RAM_INVENTORY_LIVE;
+        status = qemu_crucible_startup_source_ram_metadata_birth_finish(&birth);
+        if (status) {
+            row->references = 0;
+            array->references = 0;
+            row->cleanup_status = status;
+            row->state = RAM_INVENTORY_CLOSING;
+            return status;
+        }
+    }
+    *result = array;
+    return 0;
+}
+
+static int region_inventory_ref(CrucibleRamInventory *array,
+                                CrucibleRamInventory **result)
+{
+    int status = qemu_crucible_startup_source_native_metadata_check();
+    unsigned references;
+
+    if (status) {
+        return status;
+    }
+    references = qatomic_read(&array->references);
+    for (;;) {
+        unsigned observed;
+
+        if (!references || references == UINT_MAX) {
+            return -EOVERFLOW;
+        }
+        if (array->owner &&
+            (!bql_locked() ||
+             (array->owner != &inventory_owners[0] &&
+              array->owner != &inventory_owners[1]) ||
+             array->owner->state != RAM_INVENTORY_LIVE ||
+             array->owner->array != array ||
+             array->owner->references != references)) {
+            return -ESTALE;
+        }
+        observed = qatomic_cmpxchg(&array->references, references, references + 1);
+        if (observed == references) {
+            break;
+        }
+        references = observed;
+    }
+    if (array->owner) {
+        array->owner->references++;
+    }
+    *result = array;
+    return 0;
+}
+
+static int inventory_journal_continue(CrucibleRamInventoryOwner *row)
+{
+    int status;
+
+    if (row->returned.phase == RAM_RETURN_EMPTY ||
+        row->returned.phase == RAM_RETURN_CLAIMED ||
+        row->returned.phase == RAM_RETURN_SETTLED) {
+        return 0;
+    }
+    if (row->returned.phase != RAM_RETURN_FREE_RETURNED) {
+        return -EINPROGRESS;
+    }
+    status = qemu_crucible_startup_source_ram_return_settle(&row->returned);
+    if (status && !row->cleanup_status) {
+        row->cleanup_status = status;
+    }
+    if (!status && row->returned_kind == 1) {
+        row->scratch_owner = (QemuCrucibleRamMetadataOwner) { 0 };
+        row->scratch_bytes = 0;
+    }
+    return status;
+}
+
+static int inventory_body_return(CrucibleRamInventoryOwner *row, unsigned kind)
+{
+    QemuCrucibleRamMetadataOwner *owner;
+    void *body;
+    int status = inventory_journal_continue(row);
+
+    if (status) {
+        return status;
+    }
+    if (kind == 0) {
+        CrucibleRamRegion *region = row->current_region ?
+            row->current_region : row->constructing_region;
+
+        if (!region) {
+            return -ESTALE;
+        }
+        body = region;
+        owner = &region->metadata_owner;
+    } else if (kind == 1) {
+        body = row->sort_scratch;
+        owner = &row->scratch_owner;
+    } else {
+        body = row->array;
+        owner = &row->container_owner;
+    }
+    status = qemu_crucible_startup_source_ram_return_prepare(owner, &row->returned);
+    if (status) {
+        if (!row->cleanup_status) {
+            row->cleanup_status = status;
+        }
+        return status;
+    }
+    if (row->returned.phase != RAM_RETURN_CLAIMED) {
+        return -EINPROGRESS;
+    }
+    row->returned_kind = kind;
+    if (kind == 0) {
+        if (body == row->current_region) {
+            row->current_region = NULL;
+        } else {
+            row->constructing_region = NULL;
+        }
+        row->mr_phase = RAM_MR_NOT_OWED;
+    } else if (kind == 1) {
+        row->sort_scratch = NULL;
+    } else {
+        row->array = NULL;
+    }
+    row->returned.phase = RAM_RETURN_FREE_STARTED;
+    g_free(body);
+    row->returned.phase = RAM_RETURN_FREE_RETURNED;
+    return inventory_journal_continue(row);
+}
+
+static void region_free(CrucibleRamRegion *region)
+{
+    assert(!region->metadata_owner.keeper);
+    if (region->memory_region_held) {
+        region->memory_region_held = false;
+        memory_region_unref(region->block->mr);
+    }
+    g_free(region);
+}
+
+static int region_inventory_cleanup_continue(QemuCrucibleRamCleanupTicket *ticket,
+                                             QemuCrucibleRamReturnDisposition *out)
+{
+    CrucibleRamInventoryOwner *row;
+    uint64_t incarnation;
+    int status;
+
+    *out = (QemuCrucibleRamReturnDisposition) {
+        .physical = RAM_PHYSICAL_PENDING,
+        .debt = RAM_DEBT_RETAINED,
+        .continuation = *ticket,
+    };
+    status = qemu_crucible_startup_source_ram_metadata_keeper_current();
+    if (status) {
+        return status;
+    }
+    if (!bql_locked() || ticket->row >= G_N_ELEMENTS(inventory_owners) ||
+        !ticket->incarnation) {
+        return -EPERM;
+    }
+    row = &inventory_owners[ticket->row];
+    if (row->incarnation != ticket->incarnation) {
+        return -ESTALE;
+    }
+    if (row->state == RAM_INVENTORY_FREE) {
+        *ticket = (QemuCrucibleRamCleanupTicket) { 0 };
+        out->continuation = *ticket;
+        out->physical = RAM_PHYSICAL_RETURNED;
+        out->debt = RAM_DEBT_SETTLED;
+        return 0;
+    }
+    if (row->state != RAM_INVENTORY_CLOSING || row->references || row->cleanup_busy) {
+        return -EBUSY;
+    }
+    row->cleanup_busy = true;
+    status = inventory_journal_continue(row);
+    if (status) {
+        goto done;
+    }
+    if (row->sort_scratch) {
+        status = inventory_body_return(row, 1);
+        if (status) {
+            goto done;
+        }
+    }
+    if (row->constructing_region) {
+        status = inventory_body_return(row, 0);
+        if (status) {
+            goto done;
+        }
+    }
+    while (row->current_region || (row->array &&
+                                  row->cleanup_index < row->array->len)) {
+        if (!row->current_region) {
+            row->current_region = row->array->entries[row->cleanup_index];
+            row->array->entries[row->cleanup_index++] = NULL;
+            row->mr_phase = row->current_region->memory_region_held ?
+                RAM_MR_HELD : RAM_MR_NOT_OWED;
+        }
+        if (row->mr_phase == RAM_MR_HELD) {
+            MemoryRegion *mr = row->current_region->block->mr;
+
+            /* RR CPUs may hold BQL and retire ready dirty headers, but this
+             * row retains Main's MR callout custody until Main resumes it. */
+            if (current_cpu || !qemu_in_main_thread() || qemu_in_coroutine()) {
+                status = -EPERM;
+                goto done;
+            }
+            row->current_region->memory_region_held = false;
+            row->mr_phase = RAM_MR_RETURN_STARTED;
+            memory_region_unref(mr);
+            row->mr_phase = RAM_MR_RETURNED;
+        }
+        if (row->mr_phase == RAM_MR_RETURN_STARTED) {
+            status = -EINPROGRESS;
+            goto done;
+        }
+        status = inventory_body_return(row, 0);
+        if (status) {
+            goto done;
+        }
+    }
+    if (row->array) {
+        status = inventory_body_return(row, 2);
+        if (status) {
+            goto done;
+        }
+    }
+    incarnation = row->incarnation;
+    status = row->cleanup_status;
+    *row = (CrucibleRamInventoryOwner) { .incarnation = incarnation };
+    *ticket = (QemuCrucibleRamCleanupTicket) { 0 };
+    out->physical = RAM_PHYSICAL_RETURNED;
+    out->debt = RAM_DEBT_SETTLED;
+    out->continuation = *ticket;
+    return status;
+
+done:
+    row->cleanup_busy = false;
+    if (!row->array && !row->current_region && !row->constructing_region &&
+        !row->sort_scratch && row->returned.phase == RAM_RETURN_FREE_RETURNED) {
+        out->physical = RAM_PHYSICAL_RETURNED;
+    }
+    out->effect_status = row->cleanup_status;
+    out->settlement_status = row->returned.settlement_status;
+    return status;
+}
+
+static int region_inventory_release(CrucibleRamInventory **projection,
+                                    QemuCrucibleRamReturnDisposition *out)
+{
+    CrucibleRamInventory *array;
+    CrucibleRamInventoryOwner *row;
+    QemuCrucibleRamCleanupTicket ticket;
+    int status;
+
+    *out = (QemuCrucibleRamReturnDisposition) { 0 };
+    if (qemu_plugin_crucible_startup_source_retained()) {
+        status = qemu_crucible_startup_source_ram_metadata_keeper_current();
+        if (status) {
+            return status;
+        }
+    }
+    array = *projection;
+    if (!array) {
+        return 0;
+    }
+    row = array->owner;
+    if (row) {
+        if (!bql_locked() ||
+            (row != &inventory_owners[0] && row != &inventory_owners[1]) ||
+            row->array != array || row->state != RAM_INVENTORY_LIVE ||
+            !row->references || row->references != array->references) {
+            return -ESTALE;
+        }
+        row->references--;
+        array->references--;
+        *projection = NULL;
+        out->projection_consumed = true;
+        if (row->references) {
+            return 0;
+        }
+        row->state = RAM_INVENTORY_CLOSING;
+        ticket = (QemuCrucibleRamCleanupTicket) {
+            .row = row - inventory_owners,
+            .incarnation = row->incarnation,
+        };
+        QemuCrucibleRamReturnDisposition cleanup;
+
+        out->physical = RAM_PHYSICAL_PENDING;
+        out->debt = RAM_DEBT_RETAINED;
+        out->continuation = ticket;
+        status = region_inventory_cleanup_continue(&ticket, &cleanup);
+        *out = cleanup;
+        out->projection_consumed = true;
+        return status;
+    }
+    *projection = NULL;
+    out->projection_consumed = true;
+    if (qatomic_fetch_dec(&array->references) == 1) {
+        for (size_t index = 0; index < array->len; index++) {
+            region_free(array->entries[index]);
+        }
+        g_free(array);
+        out->physical = RAM_PHYSICAL_RETURNED;
+    }
+    return 0;
+}
+
+static int region_inventory_drop(CrucibleRamInventory **projection)
+{
+    QemuCrucibleRamReturnDisposition out;
+    int status = region_inventory_release(projection, &out);
+
+    if (status) {
+        qemu_crucible_ram_return_record(status);
+        qemu_crucible_ram_diagnostic_fail(status);
+    }
+    return status;
+}
+
+static int region_inventory_drop_preserving(CrucibleRamInventory **projection, int first)
+{
+    int status = region_inventory_drop(projection);
+
+    return first ? first : status;
+}
+
+static int region_inventory_return(CrucibleRamInventory **projection,
+                                    InventoryProjectionReturn *returned)
+{
+    QemuCrucibleRamReturnDisposition out;
+    int context = qemu_crucible_ram_metadata_return_context();
+    int status;
+
+    if (context < 0) {
+        return context;
+    }
+    if (returned->consumed || returned->disposition.projection_consumed) {
+        returned->consumed = true;
+        if (*projection) {
+            return -ESTALE;
+        }
+        if (returned->disposition.continuation.incarnation) {
+            status = region_inventory_cleanup_continue(
+                &returned->disposition.continuation, &out);
+            returned->disposition = out;
+        } else {
+            status = 0;
+        }
+    } else {
+        status = region_inventory_release(projection, &returned->disposition);
+        if (returned->disposition.projection_consumed) {
+            returned->consumed = true;
+        }
+    }
+    if (status) {
+        if (!returned->first_status) {
+            returned->first_status = status;
+        }
+        qemu_crucible_ram_return_record(status);
+    }
+    return returned->first_status ? returned->first_status : status;
+}
+
+static bool inventory_return_pending(const InventoryProjectionReturn *returned)
+{
+    return returned->disposition.continuation.incarnation != 0;
+}
+
+static int fingerprint_publication_cleanup_continue(void)
+{
+    int status;
+
+    if (!fingerprint_publication.return_pending) {
+        return 0;
+    }
+    status = region_inventory_return(&fingerprint_publication.regions,
+                                     &fingerprint_publication.inventory_return);
+    fingerprint_publication.return_pending =
+        inventory_return_pending(&fingerprint_publication.inventory_return);
+    return status;
+}
+
+int qemu_crucible_ram_metadata_cleanup_before_entry(void)
+{
+    int context = qemu_crucible_ram_metadata_return_context();
+    int first = 0, status;
+
+    if (context <= 0) {
+        return context;
+    }
+    if (!bql_locked()) {
+        return -EPERM;
+    }
+    status = fingerprint_publication_cleanup_continue();
+    if (status) {
+        first = status;
+    }
+    for (unsigned index = 0; index < G_N_ELEMENTS(inventory_owners); index++) {
+        CrucibleRamInventoryOwner *row = &inventory_owners[index];
+        QemuCrucibleRamReturnDisposition out;
+        QemuCrucibleRamCleanupTicket ticket;
+
+        if (row->state != RAM_INVENTORY_CLOSING) {
+            continue;
+        }
+        ticket = (QemuCrucibleRamCleanupTicket) { index, row->incarnation };
+        status = region_inventory_cleanup_continue(&ticket, &out);
+        if (!first) {
+            first = status;
+        }
+    }
+    status = qemu_crucible_ram_dirty_retirement_continue();
+    return first ? first : status;
+}
+
+/* The constructor anchored this before any fallible birth finish or placement. */
+static int region_unpublished_free(CrucibleRamRegion *region)
+{
+    if (!region->metadata_owner.keeper) {
+        assert(!region->memory_region_held);
+        g_free(region);
+        return 0;
+    }
+    return inventory_body_return(region->inventory->owner, 0);
+}
+
+static int region_compare(gconstpointer left, gconstpointer right)
+{
+    const CrucibleRamRegion *a = *(CrucibleRamRegion *const *)left;
+    const CrucibleRamRegion *b = *(CrucibleRamRegion *const *)right;
+
+    return strcmp((const char *)a->descriptor.id,
+                  (const char *)b->descriptor.id);
+}
+
+static int region_inventory_sort(CrucibleRamInventory *array)
+{
+    QemuCrucibleMetadataBirthLoan birth = { 0 };
+    CrucibleRamInventoryOwner *row = array->owner;
+    CrucibleRamRegion **scratch;
+    uint64_t topology;
+    uint64_t bytes;
+    uint64_t count;
+    bool ordered = true;
+    int status;
+
+    status = region_inventory_members(&count, &topology);
+    if (status) {
+        return status;
+    }
+    if (topology != array->topology || count != array->len) {
+        return -ESTALE;
+    }
+    for (size_t index = 1; index < array->len; index++) {
+        if (region_compare(&array->entries[index - 1], &array->entries[index]) > 0) {
+            ordered = false;
+            break;
+        }
+    }
+    if (ordered) {
+        return 0;
+    }
+    bytes = (uint64_t)array->len * sizeof(*scratch);
+    if (row) {
+        status = inventory_journal_continue(row);
+        if (status || row->sort_scratch || row->scratch_owner.keeper) {
+            return status ? status : -EBUSY;
+        }
+        status = qemu_crucible_startup_source_ram_region_birth_begin(bytes, &birth);
+        if (status) {
+            return status;
+        }
+    }
+    scratch = g_malloc(bytes);
+    if (row) {
+        row->sort_scratch = scratch;
+        row->scratch_bytes = bytes;
+        crucible_ram_metadata_birth_transfer(&birth, &row->scratch_owner,
+                                             scratch, bytes);
+        status = qemu_crucible_startup_source_ram_metadata_birth_finish(&birth);
+        if (status) {
+            return status;
+        }
+    }
+    /* Each pass is stable. Equal keys take the earlier member; no comparator
+     * callback or opaque sort allocation enters this paid workspace. */
+    for (size_t width = 1; width < array->len; width *= 2) {
+        for (size_t start = 0; start < array->len; start += 2 * width) {
+            size_t middle = MIN(start + width, array->len);
+            size_t end = MIN(start + 2 * width, array->len);
+            size_t left = start, right = middle;
+
+            for (size_t output = start; output < end; output++) {
+                if (left < middle &&
+                    (right == end || region_compare(&array->entries[left],
+                                                    &array->entries[right]) <= 0)) {
+                    scratch[output] = array->entries[left++];
+                } else {
+                    scratch[output] = array->entries[right++];
+                }
+            }
+        }
+        memcpy(array->entries, scratch, bytes);
+    }
+    if (row) {
+        return inventory_body_return(row, 1);
+    }
+    g_free(scratch);
+    return 0;
+}
+
+/* ROM_DEVICE owns a RAMBlock even though MemoryRegion::ram is false. Its
+ * bytes remain mutable device state, including while guest reads use ROMD.
+ */
+static bool region_has_logical_ram_backing(const RAMBlock *block)
+{
+    return block->host && block->mr &&
+        (memory_region_is_ram(block->mr) || block->mr->rom_device);
+}
+
+static int capture_region_add(RAMBlock *block, void *opaque)
+{
+    CrucibleRamInventory *regions = opaque;
+    CrucibleRamRegion *region;
+    size_t id_length;
+    QemuCrucibleMetadataBirthLoan birth = { 0 };
+    int admission_status;
+
+    if (!region_has_logical_ram_backing(block)) {
+        /* The inventory must not silently omit an unrepresented RAM block. */
+        return -ENOTSUP;
+    }
+    id_length = strlen(block->idstr);
+    if (id_length == 0 || id_length >= 256 ||
+        !g_utf8_validate(block->idstr, id_length, NULL) ||
+        block->used_length == 0) {
+        return -EINVAL;
+    }
+    for (size_t index = 0; index < id_length; index++) {
+        if ((uint8_t)block->idstr[index] < 0x20 || block->idstr[index] == 0x7f) {
+            return -EINVAL;
+        }
+    }
+    if (regions->len >= 4096 ||
+        (uint64_t)(regions->len + 1) * sizeof(*region) > metadata_budget) {
+        return -ENOSPC;
+    }
+    if (regions->len >= regions->capacity) {
+        return -ESTALE;
+    }
+    admission_status = qemu_crucible_startup_source_ram_region_birth_begin(
+        sizeof(*region), &birth);
+    if (admission_status) {
+        return admission_status;
+    }
+    region = g_new0(CrucibleRamRegion, 1);
+    region->inventory = regions;
+    if (birth.owner) {
+        assert(regions->owner && !regions->owner->constructing_region);
+        regions->owner->constructing_region = region;
+        crucible_ram_metadata_birth_transfer(&birth,
+            &region->metadata_owner, region, sizeof(*region));
+        admission_status =
+            qemu_crucible_startup_source_ram_metadata_birth_finish(&birth);
+        if (admission_status) {
+            int cleanup = region_unpublished_free(region);
+
+            qemu_crucible_ram_return_record(cleanup);
+            return admission_status;
+        }
+    }
+    region->block = block;
+    region->fingerprint_ram_offset = block->offset;
+    if (!admission_regions && !qemu_crucible_ram_paging_requested()) {
+        region->admitted_resident_region = block->mr;
+        region->admitted_resident_host = (uintptr_t)block->host;
+    }
+    region->descriptor.id_length = id_length;
+    memcpy(region->descriptor.id, block->idstr, id_length);
+    region->descriptor.logical_length = block->used_length;
+    /* Guest read-only access is not evidence of immutable host contents.
+     * Firmware/flash device writes remain visible to the logical RAM root.
+     */
+    region->descriptor.region_class = memory_region_is_ram_device(block->mr) ||
+        block->mr->rom_device || memory_region_is_rom(block->mr) ||
+        block->mr->readonly ? 2 : 1;
+    region->descriptor.scope_mask = 7;
+    if (!admission_regions && qemu_crucible_ram_paging_requested()) {
+        int status = arena_placement_authority(block, &region->arena_flags);
+
+        if (status) {
+            int cleanup = region_unpublished_free(region);
+
+            qemu_crucible_ram_return_record(cleanup);
+            return status;
+        }
+    }
+    if (admission_regions) {
+        bool matched = false;
+
+        for (size_t index = 0; index < admission_regions->len; index++) {
+            CrucibleRamRegion *admitted = region_inventory_index(admission_regions, index);
+
+            if (admitted->block == block) {
+                if (admitted->descriptor.logical_length != block->used_length ||
+                    admitted->descriptor.id_length != id_length ||
+                    memcmp(admitted->descriptor.id, block->idstr, id_length)) {
+                    qemu_crucible_ram_return_record(region_unpublished_free(region));
+                    return -ESTALE;
+                }
+                /* Guest mapping permissions/ROMD mode may change without
+                 * changing the admitted logical owner or its region class. */
+                region->descriptor = admitted->descriptor;
+                region->arena_flags = admitted->arena_flags;
+                region->admitted_resident_region = admitted->admitted_resident_region;
+                region->admitted_resident_host = admitted->admitted_resident_host;
+                matched = true;
+                break;
+            }
+        }
+        if (!matched) {
+            qemu_crucible_ram_return_record(region_unpublished_free(region));
+            return -ESTALE;
+        }
+    }
+    memory_region_ref(block->mr);
+    region->memory_region_held = true;
+    regions->entries[regions->len++] = region;
+    if (regions->owner) {
+        regions->owner->constructing_region = NULL;
+    }
+    return 0;
+}
+
+static int seal_admission_inventory(Error **errp)
+{
+    CrucibleRamInventory *regions;
+    uint64_t logical_bytes = 0;
+    uint64_t native_floor;
+    uint64_t inventory_allowance;
+    uint64_t controller_metadata;
+    int status;
+
+    if (!bql_locked() || !metadata_budget || !admission_observer ||
+        admission_regions || capture_active) {
+        error_setg(errp, "logical RAM admission owner is absent or already sealed");
+        return -EINVAL;
+    }
+    if (qemu_crucible_ram_paging_requested()) {
+        uint64_t count;
+
+        status = qemu_crucible_ram_physical_device_inventory(&count, errp);
+        if (!status) {
+            status = qemu_crucible_ram_physical_listener_inventory(&count, errp);
+        }
+        if (status) {
+            return status;
+        }
+    }
+    status = region_inventory_new(&regions);
+    if (status) {
+        error_setg(errp, "logical RAM container admission failed (%d)", status);
+        return status;
+    }
+    status = qemu_ram_foreach_block(capture_region_add, regions);
+    if (!status && (!regions->len || regions->len > 4096)) {
+        status = -E2BIG;
+    }
+    if (!status) {
+        status = region_inventory_sort(regions);
+    }
+    for (size_t index = 0; !status && index < regions->len; index++) {
+        CrucibleRamRegion *region = region_inventory_index(regions, index);
+
+        if (index) {
+            CrucibleRamRegion *previous = region_inventory_index(regions, index - 1);
+
+            if (!strcmp((const char *)previous->descriptor.id,
+                        (const char *)region->descriptor.id)) {
+                status = -EINVAL;
+                break;
+            }
+        }
+        if (region->descriptor.logical_length > UINT64_MAX - logical_bytes) {
+            status = -EOVERFLOW;
+            break;
+        }
+        logical_bytes += region->descriptor.logical_length;
+    }
+    /* Collection refusal is primary. Do not query later metadata or publish
+     * the observer's admission window for an incomplete inventory. */
+    if (status) {
+        goto inventory_failed;
+    }
+    if (qatomic_read(&research_resident.state) == RESEARCH_RESIDENT_SEALING &&
+        (logical_bytes > research_resident.full_resident ||
+         logical_bytes > research_resident.full_backing)) {
+        status = -ENOSPC;
+        goto inventory_failed;
+    }
+    /* Two actual container capacities may coexist. BQL serializes their pure
+     * sorts, so one measured pointer workspace overlaps them. The per-region
+     * +32 remains a conservative allowance, not allocator-backing evidence.
+     * Dirty reports still include all physically retained RCU generations. */
+    uint64_t containers = qemu_crucible_ram_inventory_body_bytes(regions->capacity);
+    uint64_t sort_bytes = (uint64_t)regions->len * sizeof(CrucibleRamRegion *);
+    uint64_t owners = qemu_crucible_ram_owner_metadata_bytes();
+
+    native_floor = (uint64_t)regions->len * 2 * (sizeof(CrucibleRamRegion) + 32);
+    if (!containers || containers > (UINT64_MAX - native_floor) / 2) {
+        status = -EOVERFLOW;
+        goto inventory_failed;
+    }
+    native_floor += 2 * containers;
+    if (sort_bytes > UINT64_MAX - native_floor ||
+        owners > UINT64_MAX - native_floor - sort_bytes) {
+        status = -EOVERFLOW;
+        goto inventory_failed;
+    }
+    native_floor += sort_bytes + owners;
+    if (qatomic_read(&research_resident.state) == RESEARCH_RESIDENT_SEALING) {
+        /* This actual retained state is charged before TOTAL is partitioned. */
+        native_floor += sizeof(research_resident);
+    }
+    status = qemu_crucible_ram_dirty_rearm_metadata_bytes(&admitted_rearm_metadata);
+    if (!status && admitted_rearm_metadata <= UINT64_MAX - native_floor) {
+        native_floor += admitted_rearm_metadata;
+    } else if (!status) {
+        status = -EOVERFLOW;
+    }
+    if (qatomic_read(&native_metadata_live) > UINT64_MAX - native_floor) {
+        status = -EOVERFLOW;
+    } else {
+        native_floor += qatomic_read(&native_metadata_live);
+    }
+    /* Fixed Source storage is one term, not native_metadata_live again. */
+    if (qemu_crucible_startup_source_metadata_bytes() >
+        UINT64_MAX - native_floor) {
+        status = -EOVERFLOW;
+    } else {
+        native_floor += qemu_crucible_startup_source_metadata_bytes();
+    }
+    if (sizeof(root_reader_registration) > UINT64_MAX - native_floor) {
+        status = -EOVERFLOW;
+    } else {
+        native_floor += sizeof(root_reader_registration);
+    }
+    if (sizeof(diagnostic_failure) + sizeof(owner_diagnostics) +
+        sizeof(owner_diagnostic_stops) + sizeof(capture_owner_token) +
+        sizeof(checkpoint_native_fence) +
+        sizeof(checkpoint_native_fence_cut) > UINT64_MAX - native_floor) {
+        status = -EOVERFLOW;
+    } else {
+        native_floor += sizeof(diagnostic_failure) + sizeof(owner_diagnostics) +
+            sizeof(owner_diagnostic_stops) + sizeof(capture_owner_token) +
+            sizeof(checkpoint_native_fence) +
+            sizeof(checkpoint_native_fence_cut);
+    }
+    if (status) {
+        goto inventory_failed;
+    }
+    inventory_allowance = metadata_budget > native_floor ?
+        metadata_budget - native_floor : 0;
+    controller_metadata = qemu_crucible_startup_source_control_metadata_bytes();
+    inventory_allowance = controller_metadata >= inventory_allowance ? 0 :
+        inventory_allowance - controller_metadata;
+    status = qemu_crucible_startup_source_inventory_allowance_limit_v2(
+        metadata_budget, native_floor, &inventory_allowance);
+    if (status) {
+        goto inventory_failed;
+    }
+    /* The observer receives this allowance before an explicit grant call.
+     * Reserve it under the same native charge cut before either publication. */
+    status = qemu_crucible_startup_source_inventory_allowance_reserve(
+        inventory_allowance);
+    if (status) {
+        goto inventory_failed;
+    }
+    admission = (struct qemu_plugin_crucible_ram_admission_v1) {
+        .schema = 1,
+        .region_count = regions->len,
+        .topology_generation = qatomic_read(&topology_generation),
+        .logical_bytes = logical_bytes,
+        .native_metadata_bytes = native_floor,
+        .native_scratch_bytes = 16 * 1024,
+    };
+    admission_regions = regions;
+    /* An ordinary inventory may accept a larger authenticated TOTAL. With D
+     * retained, this already reserved allowance must remain identical. */
+    /* N is still the native report; D and this reserved allowance remain
+     * separate purposes. Observer failure never refunds either retained debit. */
+    rust_metadata_budget = inventory_allowance;
+    admission_grant_open = true;
+    admission_grant_owner = qemu_get_thread_id();
+    status = admission_observer(&admission, rust_metadata_budget);
+    admission_grant_open = false;
+    admission_grant_owner = 0;
+    if (!status && !rust_metadata_budget) {
+        status = -ENOSPC;
+    }
+    if (status || admission.topology_generation != qatomic_read(&topology_generation)) {
+        status = region_inventory_drop_preserving(&admission_regions, status);
+        rust_metadata_budget = 0;
+        memset(&admission, 0, sizeof(admission));
+        error_setg(errp, "logical RAM observer admission failed (%d)", status);
+        return status ? status : -ESTALE;
+    }
+    return 0;
+
+inventory_failed:
+    status = region_inventory_drop_preserving(&regions, status);
+    error_setg(errp, "logical RAM native inventory admission failed (%d)", status);
+    return status;
+}
+
+int qemu_crucible_ram_seal_admission(Error **errp)
+{
+    int status;
+
+    if (bql_locked()) {
+        status = qemu_crucible_ram_metadata_cleanup_before_entry();
+        if (status) {
+            error_setg_errno(errp, -status, "RAM metadata cleanup remains pending");
+            return status;
+        }
+    }
+    if (!bql_locked() ||
+        qatomic_read(&research_resident.state) == RESEARCH_RESIDENT_ABSENT) {
+        return seal_admission_inventory(errp);
+    }
+    if (qatomic_read(&research_resident.state) != RESEARCH_RESIDENT_REQUESTED ||
+        metadata_budget != research_resident.total_metadata) {
+        qatomic_set(&research_resident.state, RESEARCH_RESIDENT_FAILED);
+        error_setg(errp, "experimental resident admission is not pending");
+        return -EPERM;
+    }
+    if (qatomic_cmpxchg(&research_resident.state, RESEARCH_RESIDENT_REQUESTED,
+                       RESEARCH_RESIDENT_SEALING) != RESEARCH_RESIDENT_REQUESTED) {
+        error_setg(errp, "experimental resident transition was refused");
+        return -ENOTSUP;
+    }
+    status = research_resident_cancellation_status(
+        research_resident.cancellation_fd);
+    if (status) {
+        qatomic_set(&research_resident.state, RESEARCH_RESIDENT_FAILED);
+        error_setg(errp, "experimental resident admission canceled (%d)", status);
+        return status;
+    }
+
+    status = seal_admission_inventory(errp);
+    if (status) {
+        qatomic_set(&research_resident.state, RESEARCH_RESIDENT_FAILED);
+        return status;
+    }
+    status = research_resident_cancellation_status(
+        research_resident.cancellation_fd);
+    if (!status &&
+        qatomic_read(&research_resident.state) != RESEARCH_RESIDENT_SEALING) {
+        status = -ENOTSUP;
+    }
+    if (!status && (!admission_grant_applied || !rust_metadata_budget ||
+                    admission.schema != 1 || !admission.topology_generation ||
+                    admission.topology_generation != qatomic_read(&topology_generation))) {
+        status = -ESTALE;
+    }
+    if (!status && qatomic_cmpxchg(&research_resident.state, RESEARCH_RESIDENT_SEALING,
+                                  RESEARCH_RESIDENT_SEALED) != RESEARCH_RESIDENT_SEALING) {
+        status = -ENOTSUP;
+    }
+    if (status) {
+        qatomic_set(&research_resident.state, RESEARCH_RESIDENT_FAILED);
+        status = region_inventory_drop_preserving(&admission_regions, status);
+        rust_metadata_budget = 0;
+        memset(&admission, 0, sizeof(admission));
+        error_setg(errp, "experimental resident admission did not settle (%d)", status);
+        return status;
+    }
+    research_resident.sealed_topology = admission.topology_generation;
+    return 0;
+}
+
+static int research_resident_before_resume(void)
+{
+    uint64_t stop_generation = qemu_plugin_crucible_vmstop_generation();
+    int status;
+
+    /* This is the explicitly weaker experimental placement class. It is not
+     * an ordinary pager callback or a physical residency certificate. */
+    if (qatomic_read(&research_resident.state) != RESEARCH_RESIDENT_SEALED ||
+        !runstate_check(RUN_STATE_PAUSED) ||
+        !qemu_plugin_crucible_vmstop_quiesced() || !admission_regions ||
+        !stop_generation || stop_generation == UINT64_MAX ||
+        !admission_grant_applied || admission_grant_open ||
+        admission.topology_generation != research_resident.sealed_topology ||
+        admission.topology_generation != qatomic_read(&topology_generation)) {
+        qatomic_set(&research_resident.state, RESEARCH_RESIDENT_FAILED);
+        return -EPERM;
+    }
+    status = research_resident_cancellation_status(
+        research_resident.cancellation_fd);
+    if (!status &&
+        qatomic_read(&research_resident.state) != RESEARCH_RESIDENT_SEALED) {
+        status = -ENOTSUP;
+    }
+    if (!status && stop_generation != qemu_plugin_crucible_vmstop_generation()) {
+        status = -ESTALE;
+    }
+    if (status) {
+        qatomic_set(&research_resident.state, RESEARCH_RESIDENT_FAILED);
+    }
+    return status;
+}
+
+static void capture_clear_dirty(RAMBlock *block)
+{
+    ram_addr_t start = block->offset;
+    ram_addr_t length = block->used_length;
+    unsigned long page = start >> TARGET_PAGE_BITS;
+    unsigned long end = TARGET_PAGE_ALIGN(start + length) >> TARGET_PAGE_BITS;
+    DirtyMemoryBlocks *blocks;
+    bool cleared = false;
+
+    WITH_RCU_READ_LOCK_GUARD() {
+        blocks = qatomic_rcu_read(&ram_list.dirty_memory[DIRTY_MEMORY_CRUCIBLE_RAM]);
+        while (page < end) {
+            unsigned long index = page / DIRTY_MEMORY_BLOCK_SIZE;
+            unsigned long offset = page % DIRTY_MEMORY_BLOCK_SIZE;
+            unsigned long count = MIN(end - page, DIRTY_MEMORY_BLOCK_SIZE - offset);
+
+            cleared |= bitmap_test_and_clear_atomic(blocks->blocks[index], offset, count);
+            page += count;
+        }
+    }
+    if (cleared) {
+        /* This consumer never clears migration/checkpoint/VGA/code bits. */
+        physical_memory_dirty_bits_cleared(start, length);
+    }
+}
+
+#ifdef CONFIG_LINUX
+/* A private mapping of a mutable file is not an immutable snapshot. Seals
+ * prevent writes and extent changes through every descriptor to this inode. */
+static int immutable_file_authority(RAMBlock *block, struct stat *backing)
+{
+    const int required = F_SEAL_WRITE | F_SEAL_GROW | F_SEAL_SHRINK | F_SEAL_SEAL;
+    int seals = fcntl(block->fd, F_GET_SEALS);
+
+    if (seals < 0 || (seals & required) != required ||
+        fstat(block->fd, backing) < 0 || !S_ISREG(backing->st_mode) ||
+        backing->st_size < 0 || block->fd_offset > (uint64_t)backing->st_size ||
+        block->used_length > (uint64_t)backing->st_size - block->fd_offset) {
+        return -ENOTSUP;
+    }
+    return 0;
+}
+
+/* PREALLOC describes allocator ownership, not sharing or immutability. Check
+ * the realized VMAs without expanding the region to neighbouring host pages.
+ * This runs under the static topology owner before guest execution, and again
+ * under physical exclusion before the pager uses the admitted addresses. */
+static int arena_mapping_authority(RAMBlock *block, bool file,
+                                   const struct stat *backing, bool *readonly)
+{
+    FILE *maps = fopen("/proc/self/maps", "r");
+    uint64_t cursor = (uintptr_t)block->host;
+    uint64_t limit = cursor + block->used_length;
+    char line[4096];
+    bool saw_readonly = false;
+    bool saw_writable = false;
+    int status = -ENOTSUP;
+
+    if (!maps) {
+        return -errno;
+    }
+    while (fgets(line, sizeof(line), maps)) {
+        uint64_t start, end, offset, inode;
+        unsigned device_major, device_minor;
+        char permissions[5];
+
+        if (!strchr(line, '\n') ||
+            sscanf(line, "%" SCNx64 "-%" SCNx64 " %4s %" SCNx64
+                   " %x:%x %" SCNu64, &start, &end, permissions, &offset,
+                   &device_major, &device_minor, &inode) != 7 || start >= end) {
+            status = -EINVAL;
+            break;
+        }
+        if (end <= cursor) {
+            continue;
+        }
+        if (start > cursor || permissions[0] != 'r' ||
+            (permissions[1] != 'w' && permissions[1] != '-')) {
+            break;
+        }
+        if (file) {
+            uint64_t mapped_offset;
+            uint64_t expected_offset;
+
+            if (offset > UINT64_MAX - (cursor - start) ||
+                block->fd_offset > UINT64_MAX - (cursor - (uintptr_t)block->host)) {
+                status = -EOVERFLOW;
+                break;
+            }
+            mapped_offset = offset + cursor - start;
+            expected_offset = block->fd_offset + cursor - (uintptr_t)block->host;
+            if (inode != (uint64_t)backing->st_ino ||
+                device_major != major(backing->st_dev) ||
+                device_minor != minor(backing->st_dev) ||
+                mapped_offset != expected_offset ||
+                (permissions[3] != 'p' && permissions[3] != 's') ||
+                (permissions[3] == 's' && permissions[1] == 'w')) {
+                break;
+            }
+        } else if (permissions[3] != 'p' || inode != 0 ||
+                   device_major != 0 || device_minor != 0 ||
+                   permissions[1] != 'w') {
+            break;
+        }
+        saw_writable |= permissions[1] == 'w';
+        saw_readonly |= permissions[1] == '-';
+        cursor = MIN(end, limit);
+        if (cursor == limit) {
+            if (saw_writable && saw_readonly) {
+                break;
+            }
+            *readonly = saw_readonly;
+            status = 0;
+            break;
+        }
+    }
+    if (ferror(maps)) {
+        status = -EIO;
+    }
+    fclose(maps);
+    return status;
+}
+#endif
+
+static int arena_placement_authority(RAMBlock *block, uint64_t *flags)
+{
+#ifdef CONFIG_LINUX
+    struct stat backing;
+    bool readonly;
+    bool file = block->fd >= 0;
+    int status;
+    const uint32_t unsupported = RAM_PMEM | RAM_PROTECTED | RAM_GUEST_MEMFD |
+        RAM_PRIVATE;
+
+    if (!block->host || !block->used_length ||
+        block->used_length > UINTPTR_MAX - (uintptr_t)block->host ||
+        block->flags & unsupported || qemu_real_host_page_size() != RAM_PAGE_BYTES ||
+        qemu_ram_pagesize(block) != RAM_PAGE_BYTES) {
+        return -ENOTSUP;
+    }
+    if (file && immutable_file_authority(block, &backing)) {
+        return -ENOTSUP;
+    }
+    if (!file && block->flags & (RAM_SHARED | RAM_NAMED_FILE | RAM_READONLY |
+                                RAM_READONLY_FD)) {
+        return -ENOTSUP;
+    }
+    status = arena_mapping_authority(block, file, file ? &backing : NULL, &readonly);
+    if (status) {
+        return status;
+    }
+    if (!file && !(block->flags & RAM_PREALLOC) &&
+        (uintptr_t)block->host % RAM_PAGE_BYTES == 0 &&
+        block->used_length % RAM_PAGE_BYTES == 0) {
+        *flags = QEMU_PLUGIN_CRUCIBLE_RAM_ARENA_PAGEABLE;
+    } else {
+        *flags = QEMU_PLUGIN_CRUCIBLE_RAM_ARENA_PINNED;
+        if (file) {
+            *flags |= QEMU_PLUGIN_CRUCIBLE_RAM_ARENA_IMMUTABLE_FILE;
+        }
+        if (readonly) {
+            *flags |= QEMU_PLUGIN_CRUCIBLE_RAM_ARENA_HOST_READONLY;
+        }
+    }
+    return 0;
+#else
+    return -ENOTSUP;
+#endif
+}
