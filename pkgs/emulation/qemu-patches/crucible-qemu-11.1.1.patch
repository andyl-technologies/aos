+static void control_stop_main_return(void)
+{
+    int status;
+
+    if (control_stop_storage.main.borrow) {
+        status = qemu_crucible_source_action_original_return_v1(
+            control_stop_storage.main.borrow);
+        if (!control_stop_storage.main.return_status) {
+            control_stop_storage.main.return_status = status;
+        }
+        /* Signed failure and physical closure are independent. An action's
+         * retained children still need the payload, CPU and Native frame. */
+        if (qemu_crucible_source_action_original_closed_v1(
+                control_stop_storage.main.borrow)) {
+            goto retained;
+        }
+    }
+    if (control_stop_storage.main.ticket.frame &&
+        qemu_plugin_crucible_native_main_control_current_v1(
+            &control_stop_storage.main.ticket, true)) {
+        if (control_stop_storage.main.borrow) {
+            status = qemu_crucible_source_main_payload_return_v1(
+                control_stop_storage.main.borrow);
+            if (!control_stop_storage.main.payload_return_status) {
+                control_stop_storage.main.payload_return_status = status;
+            }
+        }
+        status = qemu_plugin_crucible_native_main_control_cpu_return_v1(
+            &control_stop_storage.main.ticket);
+        if (!control_stop_storage.main.return_status) {
+            control_stop_storage.main.return_status = status;
+        }
+    }
+    if (control_stop_storage.main.ticket.frame &&
+        !qemu_plugin_crucible_native_main_control_current_v1(
+            &control_stop_storage.main.ticket, true)) {
+        status = control_stop_storage.main.borrow ?
+            qemu_crucible_source_main_control_return_v1(&control_stop_storage.main.borrow) :
+            qemu_plugin_crucible_native_main_control_finish_v1(
+                &control_stop_storage.main.ticket, NULL);
+        if (!control_stop_storage.main.return_status) {
+            control_stop_storage.main.return_status = status;
+        }
+    }
+
+retained:
+    control_stop_storage.main.held = control_stop_storage.main.ticket.frame ||
+        control_stop_storage.main.borrow;
+    control_stop_storage.main.returned = !control_stop_storage.main.held;
+}
