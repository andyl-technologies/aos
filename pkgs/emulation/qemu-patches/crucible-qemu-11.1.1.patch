+static CrucibleRamRegion *fixture_metadata_region(CrucibleRamInventory *array,
+                                                  RAMBlock *block,
+                                                  const char *id)
+{
+    CrucibleRamInventoryOwner *row = array->owner;
+    QemuCrucibleMetadataBirthLoan birth = { 0 };
+    CrucibleRamRegion *region;
+
+    g_assert_cmpuint(array->len, <, array->capacity);
+    g_assert_null(row->constructing_region);
+    g_assert_cmpint(qemu_crucible_startup_source_ram_region_birth_begin(
+                       sizeof(*region), &birth), ==, 0);
+    region = g_new0(CrucibleRamRegion, 1);
+    region->inventory = array;
+    row->constructing_region = region;
+    crucible_ram_metadata_birth_transfer(&birth, &region->metadata_owner,
+                                         region, sizeof(*region));
+    g_assert_cmpint(qemu_crucible_startup_source_ram_metadata_birth_finish(
+                       &birth), ==, 0);
+    region->block = block;
+    g_strlcpy((char *)region->descriptor.id, id, sizeof(region->descriptor.id));
+    if (block && block->mr) {
+        memory_region_ref(block->mr);
+        region->memory_region_held = true;
+    }
+    array->entries[array->len++] = region;
+    row->constructing_region = NULL;
+    return region;
