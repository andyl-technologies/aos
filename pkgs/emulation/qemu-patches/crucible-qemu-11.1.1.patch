+static int crucible_shmem_failure_errno(uint8_t failure)
+{
+    static const int errors[] = {
+        ENOMEDIUM, EROFS, EINVAL, EBUSY, ETIMEDOUT, EIO,
+        EILSEQ, EIO, ENOSPC, ENOENT, ESTALE,
+    };
+
+    return failure >= CRUCIBLE_BLOCK_ERROR_MIN &&
+           failure <= G_N_ELEMENTS(errors) ? errors[failure - 1] : EIO;
+}
+
+static bool crucible_shmem_response_header_valid(const uint8_t *event,
+                                                 size_t len)
+{
+    uint32_t count;
+
+    if (len < CRUCIBLE_BLOCK_RESPONSE_HEADER_SIZE ||
+        event[1] != CRUCIBLE_BLOCK_WIRE_VERSION || event[2] != 0 ||
+        event[3] != 0) {
+        return false;
+    }
+    count = ldl_le_p(event + 16);
+    return count == len - CRUCIBLE_BLOCK_RESPONSE_HEADER_SIZE;
+}
+
+typedef struct CrucibleBlockResetDecoded {
+    uint64_t next_epoch;
+    int64_t recovery_deadline_ns;
+    uint16_t recovery_phase_ps;
+    uint8_t request_id_rule;
+    uint8_t unadmitted;
+    uint8_t failure;
+    bool notify_topology;
+} CrucibleBlockResetDecoded;
+
+static bool crucible_shmem_validate_reset(BDRVCrucibleShmemState *s,
+                                          const uint8_t *event, size_t len,
+                                          CrucibleBlockResetDecoded *decoded)
+{
+    const uint8_t *reset;
+    uint64_t next_epoch;
+    uint64_t recovery_ns;
+    int64_t now_ns;
+
+    if (len != CRUCIBLE_BLOCK_EVENT_SIZE ||
+        !crucible_shmem_response_header_valid(event, len) ||
+        event[0] != CRUCIBLE_BLOCK_STATUS_RESET) {
+        return false;
+    }
+    reset = event + 20;
+    next_epoch = ldq_le_p(reset);
+    recovery_ns = ldq_le_p(reset + 8);
+    if ((reset[16] == 0 && next_epoch != s->request_epoch) ||
+        (reset[16] == 1 &&
+         (s->request_epoch == UINT64_MAX || next_epoch != s->request_epoch + 1)) ||
+        reset[16] > 1 || reset[17] > 1 || reset[18] > 1 ||
+        reset[20] > 1 || reset[21] > 2 || reset[22] > 2 ||
+        reset[19] < CRUCIBLE_BLOCK_ERROR_MIN ||
+        reset[19] > CRUCIBLE_BLOCK_ERROR_MAX || reset[23] > 3 ||
+        reset[24] > 4 || reset[25] > 1 || reset[26] > 1 ||
+        !buffer_is_zero(reset + 27, 5)) {
+        return false;
+    }
+    if (qemu_timer_tcg_ps_enabled()) {
+        __int128 target_ps;
+
+        target_ps = qemu_clock_get_ps_wide(QEMU_CLOCK_VIRTUAL) +
+                    (__int128)recovery_ns * PICOSECONDS_PER_NANOSECOND;
+        if (!qemu_time_split_ps(target_ps,
+                                &decoded->recovery_deadline_ns,
+                                &decoded->recovery_phase_ps)) {
+            return false;
+        }
+    } else {
+        now_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+        if (now_ns < 0 || recovery_ns > INT64_MAX ||
+            now_ns > INT64_MAX - (int64_t)recovery_ns) {
+            return false;
+        }
+        decoded->recovery_deadline_ns = now_ns + (int64_t)recovery_ns;
+        decoded->recovery_phase_ps = 0;
+    }
+
+    decoded->next_epoch = next_epoch;
+    decoded->request_id_rule = reset[16];
+    decoded->unadmitted = reset[20];
+    decoded->failure = reset[19];
+    decoded->notify_topology = reset[17] == 1;
+    return true;
+}
+
+static void crucible_shmem_apply_reset(BDRVCrucibleShmemState *s,
+                                       const CrucibleBlockResetDecoded *reset)
+{
+    qemu_mutex_lock(&s->pending_lock);
+    s->request_epoch = reset->next_epoch;
+    if (reset->request_id_rule == 1) {
+        s->next_request_id = 0;
+    }
+    s->recovery_deadline_ns = reset->recovery_deadline_ns;
+    s->recovery_phase_ps = reset->recovery_phase_ps;
+    s->recovery_unadmitted = reset->unadmitted;
+    s->recovery_failure = reset->failure;
+    qemu_mutex_unlock(&s->pending_lock);
+}
+
+static bool crucible_shmem_poll_events(BDRVCrucibleShmemState *s)
+{
+    uint8_t event[CRUCIBLE_BLOCK_EVENT_SIZE];
+    int64_t ret;
+
+    if (!crucible_blk_event_cb) {
+        return true;
+    }
+    do {
+        CrucibleBlockResetDecoded reset = { 0 };
+        bool is_reset = false;
+
+        ret = crucible_group_call_blk_event_cb(event, sizeof(event),
+                                    crucible_blk_event_userdata);
+        if (ret < 0) {
+            return false;
+        }
+        if (ret == 0) {
+            continue;
+        }
+        if (!crucible_shmem_response_header_valid(event, ret)) {
+            return false;
+        }
+        switch (event[0]) {
+        case CRUCIBLE_BLOCK_STATUS_RESET:
+            if (!crucible_shmem_validate_reset(s, event, ret, &reset)) {
+                return false;
+            }
+            is_reset = true;
+            break;
+        case CRUCIBLE_BLOCK_STATUS_DUPLICATE_IGNORED:
+            if (ret != CRUCIBLE_BLOCK_RESPONSE_HEADER_SIZE) {
+                return false;
+            }
+            break;
+        case CRUCIBLE_BLOCK_STATUS_DUPLICATE_ERROR:
+            if (ret != CRUCIBLE_BLOCK_RESPONSE_HEADER_SIZE + 1 ||
+                event[CRUCIBLE_BLOCK_RESPONSE_HEADER_SIZE] <
+                    CRUCIBLE_BLOCK_ERROR_MIN ||
+                event[CRUCIBLE_BLOCK_RESPONSE_HEADER_SIZE] >
+                    CRUCIBLE_BLOCK_ERROR_MAX) {
+                return false;
+            }
+            break;
+        default:
+            return false;
+        }
+        if (!crucible_blk_event_commit_cb ||
+            crucible_group_call_blk_event_commit_cb(crucible_blk_event_userdata) != 0) {
+            return false;
+        }
+        if (is_reset) {
+            crucible_shmem_apply_reset(s, &reset);
+        }
+        if (is_reset && reset.notify_topology) {
+            bdrv_notify_topology_change(s->bs);
+        }
+    } while (ret > 0);
+    return true;
+}
+
+static void crucible_shmem_wake(Notifier *notifier, void *data)
+{
+    BDRVCrucibleShmemState *s = container_of(notifier,
+                                              BDRVCrucibleShmemState,
+                                              wake_notifier);
+    CoQueue waiters;
+    QemuPluginWakeEvent event = (QemuPluginWakeEvent)(intptr_t)data;
+
+    if (!crucible_shmem_poll_events(s)) {
+        event = QEMU_PLUGIN_WAKE_EVENT_FAILED;
+    }
+    qemu_mutex_lock(&s->pending_lock);
+    if (event == QEMU_PLUGIN_WAKE_EVENT_FAILED) {
+        s->wake_failed = true;
+    } else if (event != QEMU_PLUGIN_WAKE_EVENT_DRAINED) {
+        qemu_mutex_unlock(&s->pending_lock);
+        return;
+    } else if (qemu_plugin_crucible_vmstop_pending()) {
+        /*
+         * An exact checkpoint has already published its frozen coordinate and
+         * queued native VM stop.  The host rings the control fd solely to hand
+         * the BQL back to QEMU's main loop.  Resuming a parked request here
+         * could admit a new deterministic completion beyond that coordinate,
+         * making the already-published pause impossible to drain.
+         */
+        qemu_mutex_unlock(&s->pending_lock);
+        return;
+    }
+    s->wake_generation++;
+
+    /*
+     * The wake-fd handler already runs in QEMU's normal main-loop context.
+     * Resume every request coroutine there; never nest the main loop from a
+     * device, plugin, or vCPU callback.
+     */
+    waiters = s->pending_requests;
+    qemu_co_queue_init(&s->pending_requests);
+    qemu_mutex_unlock(&s->pending_lock);
+    qemu_co_enter_all(&waiters, NULL);
+}
+
+static int crucible_shmem_open(BlockDriverState *bs, QDict *options,
+                               int flags, Error **errp)
+{
+    BDRVCrucibleShmemState *s = bs->opaque;
+    QemuOpts *opts;
+    uint64_t length;
+
+    opts = qemu_opts_create(&crucible_shmem_runtime_opts, NULL, 0,
+                            &error_abort);
+    qemu_opts_absorb_qdict(opts, options, &error_abort);
+    length = qemu_opt_get_size(opts, CRUCIBLE_SHMEM_OPT_SIZE,
+                               CRUCIBLE_SHMEM_DEFAULT_SIZE);
+    qemu_opts_del(opts);
+
+    if (length == 0 || length > INT64_MAX) {
+        error_setg(errp, "crucible-shmem size is invalid");
+        return -EINVAL;
+    }
+    if (crucible_blk_state) {
+        error_setg(errp, "only one crucible-shmem block backend is supported");
+        return -EBUSY;
+    }
+
+    s->bs = bs;
+    s->length = length;
+    s->request_epoch = 0;
+    s->next_request_id = 0;
+    s->recovery_deadline_ns = 0;
+    s->recovery_phase_ps = 0;
+    s->recovery_unadmitted = 0;
+    s->recovery_failure = 7;
+    s->vmstate_plugin_state = NULL;
+    s->vmstate_plugin_state_len = 0;
+    qemu_mutex_init(&s->pending_lock);
+    qemu_co_queue_init(&s->pending_requests);
+    s->wake_generation = 0;
+    s->wake_notifier.notify = crucible_shmem_wake;
+    s->wake_failed = false;
+    s->vmstate_registered = false;
+    if (vmstate_register_any(NULL, &vmstate_crucible_shmem, s) < 0) {
+        qemu_mutex_destroy(&s->pending_lock);
+        error_setg(errp, "cannot register crucible-shmem migration state");
+        return -EINVAL;
+    }
+    s->vmstate_registered = true;
+    s->wake_registered = true;
+    qemu_plugin_wake_notifier_add(&s->wake_notifier);
+    crucible_blk_state = s;
+    bs->bl.request_alignment = 1;
+    return 0;
+}
+
+static void crucible_shmem_close(BlockDriverState *bs)
+{
+    BDRVCrucibleShmemState *s = bs->opaque;
+
+    if (s->wake_registered) {
+        qemu_plugin_wake_notifier_remove(&s->wake_notifier);
+        s->wake_registered = false;
+    }
+    if (s->vmstate_registered) {
+        vmstate_unregister(NULL, &vmstate_crucible_shmem, s);
+        s->vmstate_registered = false;
+    }
+    /* Block graph draining must finish every request before close. */
+    qemu_mutex_lock(&s->pending_lock);
+    g_assert(qemu_co_queue_empty(&s->pending_requests));
+    qemu_mutex_unlock(&s->pending_lock);
+    qemu_mutex_destroy(&s->pending_lock);
+    g_free(s->vmstate_plugin_state);
+    s->vmstate_plugin_state = NULL;
+    s->vmstate_plugin_state_len = 0;
+    g_assert(crucible_blk_state == s);
+    crucible_blk_state = NULL;
+}
+
+static int64_t coroutine_fn
+crucible_shmem_co_getlength(BlockDriverState *bs)
+{
+    BDRVCrucibleShmemState *s = bs->opaque;
+
+    return s->length;
+}
+
+static int crucible_shmem_check_range(BlockDriverState *bs, int64_t offset,
+                                      int64_t bytes, bool is_write)
+{
+    BDRVCrucibleShmemState *s = bs->opaque;
+
+    if (offset < 0 || bytes < 0) {
+        return -EINVAL;
+    }
+    if (offset > s->length || bytes > s->length - offset) {
+        return is_write ? -ENOSPC : -EINVAL;
+    }
+    if ((uint64_t)bytes > SIZE_MAX) {
+        return -EOVERFLOW;
+    }
+    return 0;
+}
+
+static int crucible_shmem_next_request_identity(BDRVCrucibleShmemState *s,
+                                                uint64_t *epoch,
+                                                uint32_t *request_id)
+{
+    qemu_mutex_lock(&s->pending_lock);
+    if (s->next_request_id == UINT32_MAX) {
+        qemu_mutex_unlock(&s->pending_lock);
+        return -EOVERFLOW;
+    }
+
+    *epoch = s->request_epoch;
+    *request_id = s->next_request_id++;
+    qemu_mutex_unlock(&s->pending_lock);
+    return 0;
+}
+
+static void crucible_shmem_recovery_wake(void *opaque)
+{
+    qemu_co_sleep_wake(opaque);
+}
+
+static void coroutine_fn crucible_shmem_sleep_until_ps(__int128 deadline_ps)
+{
+    AioContext *ctx = qemu_get_current_aio_context();
+    QemuCoSleep sleep = { 0 };
+    QEMUTimer timer;
+
+    aio_timer_init(ctx, &timer, QEMU_CLOCK_VIRTUAL, SCALE_NS,
+                   crucible_shmem_recovery_wake, &sleep);
+    timer_mod_ps_wide(&timer, deadline_ps);
+    qemu_co_sleep(&sleep);
+    timer_del(&timer);
+}
+
+static int coroutine_fn
+crucible_shmem_admit_after_recovery(BDRVCrucibleShmemState *s)
+{
+    while (true) {
+        int64_t deadline;
+        uint16_t phase_ps;
+        uint8_t unadmitted;
+        uint8_t failure;
+
+        qemu_mutex_lock(&s->pending_lock);
+        deadline = s->recovery_deadline_ns;
+        phase_ps = s->recovery_phase_ps;
+        unadmitted = s->recovery_unadmitted;
+        failure = s->recovery_failure;
+        qemu_mutex_unlock(&s->pending_lock);
+        if (qemu_timer_tcg_ps_enabled()) {
+            __int128 deadline_ps;
+
+            if (!qemu_time_join_ps(deadline, phase_ps, &deadline_ps)) {
+                return -EINVAL;
+            }
+            if (qemu_clock_get_ps_wide(QEMU_CLOCK_VIRTUAL) >= deadline_ps) {
+                return 0;
+            }
+            if (unadmitted == 0) {
+                return -crucible_shmem_failure_errno(failure);
+            }
+            crucible_shmem_sleep_until_ps(deadline_ps);
+        } else {
+            int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+
+            if (now >= deadline) {
+                return 0;
+            }
+            if (unadmitted == 0) {
+                return -crucible_shmem_failure_errno(failure);
+            }
+            qemu_co_sleep_ns(QEMU_CLOCK_VIRTUAL, deadline - now);
+        }
+    }
+}
+
+static void coroutine_fn
+crucible_shmem_wait_one_poll(BlockDriverState *bs,
+                             uint64_t observed_generation)
+{
+    BDRVCrucibleShmemState *s = bs->opaque;
+
+    qemu_mutex_lock(&s->pending_lock);
+    if (s->wake_failed || s->wake_generation != observed_generation) {
+        qemu_mutex_unlock(&s->pending_lock);
+        return;
+    }
+    qemu_co_queue_wait(&s->pending_requests, &s->pending_lock);
+    qemu_mutex_unlock(&s->pending_lock);
+}
+
+static int64_t coroutine_fn
+crucible_shmem_poll_until_ready(BlockDriverState *bs, uint64_t epoch,
+                                uint32_t request_id,
+                                uint8_t *data, size_t capacity)
+{
+    BDRVCrucibleShmemState *s = bs->opaque;
+    int64_t ret;
+    uint64_t observed_generation;
+
+    while (true) {
+        qemu_mutex_lock(&s->pending_lock);
+        if (s->wake_failed) {
+            qemu_mutex_unlock(&s->pending_lock);
+            return -EIO;
+        }
+        observed_generation = s->wake_generation;
+        qemu_mutex_unlock(&s->pending_lock);
+        if (!crucible_blk_callbacks_ready()) {
+            return -ENODEV;
+        }
+        qemu_plugin_crucible_exact_boundary_enter();
+        ret = crucible_group_call_blk_poll_cb(epoch, request_id, data, capacity,
+                                   crucible_blk_userdata);
+        qemu_plugin_crucible_exact_boundary_leave();
+        if (ret != QEMU_PLUGIN_BLK_POLL_PENDING) {
+            /*
+             * A single wake may publish a primary completion followed by an
+             * asynchronous reset event.  The event is intentionally hidden
+             * while the primary response is at the head of the shared ring.
+             * Poll again after consuming that response so the event cannot be
+             * stranded waiting for an edge that the producer already sent.
+             */
+            if (!crucible_shmem_poll_events(s)) {
+                return -EIO;
+            }
+            return ret;
+        }
+        if (crucible_blk_wait_cb) {
+            /*
+             * Re-fire for every pending poll.  If the host had not published
+             * the deterministic completion deadline at the first wait, its
+             * wake-fd notification resumes this coroutine and the next pass
+             * observes that deadline without exposing host timing to the guest.
+             */
+            crucible_group_call_blk_wait_cb(request_id, crucible_blk_wait_userdata);
+        }
+        crucible_shmem_wait_one_poll(bs, observed_generation);
+    }
+}
+
+static int crucible_shmem_decode_poll_result(int64_t poll_ret,
+                                             size_t in_capacity)
+{
+    int64_t typed_error_min = QEMU_PLUGIN_BLK_POLL_ERROR(
+        QEMU_PLUGIN_BLK_POLL_ERROR_MAX);
+    int64_t typed_error_max = QEMU_PLUGIN_BLK_POLL_ERROR(1);
+
+    if (poll_ret == -1) {
+        return -EIO;
+    }
+    if (poll_ret >= typed_error_min && poll_ret <= typed_error_max) {
+        return (int)(poll_ret + QEMU_PLUGIN_BLK_POLL_ERROR_BASE);
+    }
+    if (poll_ret < -1 || (uint64_t)poll_ret > in_capacity) {
+        return -EOVERFLOW;
+    }
+    return (int)poll_ret;
+}
+
+static int coroutine_fn
+crucible_shmem_submit_and_wait(BlockDriverState *bs, uint32_t op,
+                               uint64_t offset, const uint8_t *out_data,
+                               size_t out_len, uint8_t *in_data,
+                               size_t in_capacity)
+{
+    BDRVCrucibleShmemState *s = bs->opaque;
+    uint64_t epoch;
+    uint32_t request_id;
+    int ret;
+    int64_t poll_ret;
+
+    if (!crucible_blk_callbacks_ready()) {
+        return -ENOMEDIUM;
+    }
+
+retry_new_identity:
+    ret = crucible_shmem_admit_after_recovery(s);
+    if (ret < 0) {
+        return ret;
+    }
+    ret = crucible_shmem_next_request_identity(s, &epoch, &request_id);
+    if (ret < 0) {
+        return ret;
+    }
+
+submit_identity:
+    ret = crucible_group_call_blk_submit_cb(epoch, request_id, op, offset,
+                                 out_data, out_len,
+                                 crucible_blk_userdata);
+    if (ret != 0) {
+        return -EIO;
+    }
+
+    poll_ret = crucible_shmem_poll_until_ready(bs, epoch, request_id, in_data,
+                                               in_capacity);
+    if (poll_ret == QEMU_PLUGIN_BLK_RETRY_PRESERVE_ID) {
+        ret = crucible_shmem_admit_after_recovery(s);
+        if (ret < 0) {
+            return ret;
+        }
+        goto submit_identity;
+    }
+    if (poll_ret == QEMU_PLUGIN_BLK_RETRY_NEW_ID) {
+        goto retry_new_identity;
+    }
+    if (poll_ret == QEMU_PLUGIN_BLK_DROP_COMPLETION) {
+        return -ECANCELED;
+    }
+    return crucible_shmem_decode_poll_result(poll_ret, in_capacity);
+}
+
+static int coroutine_fn GRAPH_RDLOCK
+crucible_shmem_co_preadv(BlockDriverState *bs, int64_t offset,
+                         int64_t bytes, QEMUIOVector *qiov,
+                         BdrvRequestFlags flags)
+{
+    g_autofree uint8_t *buf = NULL;
+    int ret;
+
+    ret = crucible_shmem_check_range(bs, offset, bytes, false);
+    if (ret < 0) {
+        return ret;
+    }
+
+    buf = g_malloc(bytes);
+    ret = crucible_shmem_submit_and_wait(bs, QEMU_PLUGIN_BLK_OP_READ,
+                                         offset, NULL, (size_t)bytes, buf,
+                                         (size_t)bytes);
+    if (ret < 0) {
+        return ret;
+    }
+    if (ret != bytes) {
+        return -EIO;
+    }
+
+    qemu_iovec_from_buf(qiov, 0, buf, bytes);
+    return 0;
+}
+
+static int coroutine_fn GRAPH_RDLOCK
+crucible_shmem_co_pwritev(BlockDriverState *bs, int64_t offset,
+                          int64_t bytes, QEMUIOVector *qiov,
+                          BdrvRequestFlags flags)
+{
+    g_autofree uint8_t *buf = NULL;
+    int ret;
+
+    ret = crucible_shmem_check_range(bs, offset, bytes, true);
+    if (ret < 0) {
+        return ret;
+    }
+
+    buf = g_malloc(bytes);
+    qemu_iovec_to_buf(qiov, 0, buf, bytes);
+    ret = crucible_shmem_submit_and_wait(bs, QEMU_PLUGIN_BLK_OP_WRITE,
+                                         offset, buf, (size_t)bytes, NULL, 0);
+    if (ret < 0) {
+        return ret;
+    }
+    if (ret != 0) {
+        return -EIO;
+    }
+
+    return 0;
+}
+
+static int coroutine_fn GRAPH_RDLOCK
+crucible_shmem_co_flush(BlockDriverState *bs)
+{
+    int ret;
+
+    if (qemu_plugin_crucible_vmstop_pending()) {
+        /*
+         * Exact checkpoint captures the plugin transport and Apache-side
+         * durability continuation as state.  QEMU's synthetic stop-time flush
+         * must neither mutate that continuation nor create a request after the
+         * host proved the transport quiescent.  Guest-issued flushes and
+         * ordinary QEMU stops retain the production request path below.
+         */
+        return 0;
+    }
+
+    ret = crucible_shmem_submit_and_wait(bs, QEMU_PLUGIN_BLK_OP_FLUSH,
+                                         0, NULL, 0, NULL, 0);
+    if (ret < 0) {
+        return ret;
+    }
+    return ret == 0 ? 0 : -EIO;
+}
+
+static int coroutine_fn GRAPH_RDLOCK
+crucible_shmem_co_pdiscard(BlockDriverState *bs, int64_t offset,
+                           int64_t bytes)
+{
+    int ret;
+
+    ret = crucible_shmem_check_range(bs, offset, bytes, true);
+    if (ret < 0) {
+        return ret;
+    }
+
+    ret = crucible_shmem_submit_and_wait(bs, QEMU_PLUGIN_BLK_OP_DISCARD,
+                                         offset, NULL, (size_t)bytes,
+                                         NULL, 0);
+    if (ret < 0) {
+        return ret;
+    }
+    return ret == 0 ? 0 : -EIO;
+}
+
+static void crucible_shmem_refresh_filename(BlockDriverState *bs)
+{
+    pstrcpy(bs->exact_filename, sizeof(bs->exact_filename),
+            "crucible-shmem://");
+}
+
+static bool crucible_shmem_plugin_state_matches(
+    const uint8_t *state, uint32_t state_len, uint64_t request_epoch,
+    uint32_t next_request_id)
+{
+    return state &&
+           state_len >= CRUCIBLE_BLOCK_TRANSPORT_STATE_HEADER_SIZE &&
+           memcmp(state, "CBTS", 4) == 0 && lduw_le_p(state + 4) == 1 &&
+           lduw_le_p(state + 6) == 0 &&
+           ldq_le_p(state + 8) == request_epoch &&
+           ldl_le_p(state + 16) == next_request_id;
+}
+
+static int crucible_shmem_pre_save(void *opaque)
+{
+    BDRVCrucibleShmemState *s = opaque;
+    int64_t len;
+    int64_t written;
+
+    if (!crucible_blk_transport_save_cb ||
+        !crucible_blk_transport_restore_cb) {
+        return -ENODEV;
+    }
+    qemu_mutex_lock(&s->pending_lock);
+    s->vmstate_request_epoch = s->request_epoch;
+    s->vmstate_next_request_id = s->next_request_id;
+    s->vmstate_recovery_deadline_ns = s->recovery_deadline_ns;
+    s->vmstate_recovery_phase_ps = s->recovery_phase_ps;
+    s->vmstate_recovery_unadmitted = s->recovery_unadmitted;
+    s->vmstate_recovery_failure = s->recovery_failure;
+    qemu_mutex_unlock(&s->pending_lock);
+    len = crucible_group_call_blk_transport_save_cb(NULL, 0,
+                                         crucible_blk_event_userdata);
+    if (len < CRUCIBLE_BLOCK_TRANSPORT_STATE_HEADER_SIZE ||
+        len > CRUCIBLE_BLOCK_TRANSPORT_STATE_MAX || len > UINT32_MAX) {
+        return -EINVAL;
+    }
+    g_free(s->vmstate_plugin_state);
+    s->vmstate_plugin_state = g_try_malloc(len);
+    if (!s->vmstate_plugin_state) {
+        s->vmstate_plugin_state_len = 0;
+        return -ENOMEM;
+    }
+    s->vmstate_plugin_state_len = len;
+    written = crucible_group_call_blk_transport_save_cb(s->vmstate_plugin_state,
+                                              s->vmstate_plugin_state_len,
+                                              crucible_blk_event_userdata);
+    if (written != len ||
+        !crucible_shmem_plugin_state_matches(
+            s->vmstate_plugin_state, s->vmstate_plugin_state_len,
+            s->vmstate_request_epoch, s->vmstate_next_request_id)) {
+        return -EINVAL;
+    }
+    return 0;
+}
+
+static int crucible_shmem_pre_load(void *opaque)
+{
+    BDRVCrucibleShmemState *s = opaque;
+
+    g_free(s->vmstate_plugin_state);
+    s->vmstate_plugin_state = NULL;
+    s->vmstate_plugin_state_len = 0;
+    return 0;
+}
+
+static int crucible_shmem_post_load(void *opaque, int version_id)
+{
+    BDRVCrucibleShmemState *s = opaque;
+
+    if (version_id != 2 ||
+        s->vmstate_recovery_phase_ps >= PICOSECONDS_PER_NANOSECOND ||
+        s->vmstate_recovery_unadmitted > 1 ||
+        s->vmstate_recovery_failure < CRUCIBLE_BLOCK_ERROR_MIN ||
+        s->vmstate_recovery_failure > CRUCIBLE_BLOCK_ERROR_MAX ||
+        s->vmstate_plugin_state_len > CRUCIBLE_BLOCK_TRANSPORT_STATE_MAX ||
+        !crucible_shmem_plugin_state_matches(
+            s->vmstate_plugin_state, s->vmstate_plugin_state_len,
+            s->vmstate_request_epoch, s->vmstate_next_request_id) ||
+        !crucible_blk_transport_restore_cb) {
+        return -EINVAL;
+    }
+    if (!qemu_timer_tcg_ps_enabled() &&
+        s->vmstate_recovery_phase_ps != 0) {
+        if (s->vmstate_recovery_deadline_ns != INT64_MAX) {
+            s->vmstate_recovery_deadline_ns++;
+        }
+        s->vmstate_recovery_phase_ps = 0;
+    }
+    if (crucible_group_call_blk_transport_restore_cb(
+            s->vmstate_plugin_state, s->vmstate_plugin_state_len,
+            s->vmstate_request_epoch, s->vmstate_next_request_id,
+            crucible_blk_event_userdata) != 0) {
+        return -EINVAL;
+    }
+    qemu_mutex_lock(&s->pending_lock);
+    s->request_epoch = s->vmstate_request_epoch;
+    s->next_request_id = s->vmstate_next_request_id;
+    s->recovery_deadline_ns = s->vmstate_recovery_deadline_ns;
+    s->recovery_phase_ps = s->vmstate_recovery_phase_ps;
+    s->recovery_unadmitted = s->vmstate_recovery_unadmitted;
+    s->recovery_failure = s->vmstate_recovery_failure;
+    qemu_mutex_unlock(&s->pending_lock);
+    return 0;
+}
+
+static int crucible_shmem_get_plugin_state(QEMUFile *f, void *opaque,
+                                            size_t size,
+                                            const VMStateField *field)
+{
+    BDRVCrucibleShmemState *s = opaque;
+    uint8_t *state;
+    uint32_t len;
+
+    (void)size;
+    (void)field;
+    len = qemu_get_be32(f);
+    if (qemu_file_get_error(f) ||
+        len < CRUCIBLE_BLOCK_TRANSPORT_STATE_HEADER_SIZE ||
+        len > CRUCIBLE_BLOCK_TRANSPORT_STATE_MAX) {
+        return -EINVAL;
+    }
+    state = g_try_malloc(len);
+    if (!state) {
+        return -ENOMEM;
+    }
+    if (qemu_get_buffer(f, state, len) != len) {
+        g_free(state);
+        return -EINVAL;
+    }
+    g_free(s->vmstate_plugin_state);
+    s->vmstate_plugin_state = state;
+    s->vmstate_plugin_state_len = len;
+    return 0;
+}
+
+static int crucible_shmem_put_plugin_state(QEMUFile *f, void *opaque,
+                                            size_t size,
+                                            const VMStateField *field,
+                                            JSONWriter *vmdesc)
+{
+    BDRVCrucibleShmemState *s = opaque;
+
+    (void)size;
+    (void)field;
+    (void)vmdesc;
+    if (!s->vmstate_plugin_state ||
+        s->vmstate_plugin_state_len <
+            CRUCIBLE_BLOCK_TRANSPORT_STATE_HEADER_SIZE ||
+        s->vmstate_plugin_state_len >
+            CRUCIBLE_BLOCK_TRANSPORT_STATE_MAX) {
+        return -EINVAL;
+    }
+    qemu_put_be32(f, s->vmstate_plugin_state_len);
+    qemu_put_buffer(f, s->vmstate_plugin_state,
+                    s->vmstate_plugin_state_len);
+    return qemu_file_get_error(f);
+}
+
+static const VMStateInfo vmstate_info_crucible_plugin_state = {
+    .name = "crucible block transport state",
+    .get = crucible_shmem_get_plugin_state,
+    .put = crucible_shmem_put_plugin_state,
+};
+
+static bool crucible_shmem_fingerprint_projection(QEMUFile *f,
+                                                  const void *opaque,
+                                                  Error **errp)
+{
+    BDRVCrucibleShmemState *s = (void *)opaque;
+    g_autofree uint8_t *transport = NULL;
+    uint64_t request_epoch;
+    uint32_t next_request_id;
+    int64_t recovery_deadline_ns;
+    uint16_t recovery_phase_ps;
+    uint8_t recovery_unadmitted;
+    uint8_t recovery_failure;
+    int64_t length;
+    int64_t written;
+
+    if (!crucible_blk_transport_save_cb) {
+        error_setg(errp, "Crucible block transport projection is unavailable");
+        return false;
+    }
+
+    qemu_mutex_lock(&s->pending_lock);
+    request_epoch = s->request_epoch;
+    next_request_id = s->next_request_id;
+    recovery_deadline_ns = s->recovery_deadline_ns;
+    recovery_phase_ps = s->recovery_phase_ps;
+    recovery_unadmitted = s->recovery_unadmitted;
+    recovery_failure = s->recovery_failure;
+    qemu_mutex_unlock(&s->pending_lock);
+
+    length = crucible_group_call_blk_transport_save_cb(NULL, 0,
+                                             crucible_blk_event_userdata);
+    if (length < CRUCIBLE_BLOCK_TRANSPORT_STATE_HEADER_SIZE ||
+        length > CRUCIBLE_BLOCK_TRANSPORT_STATE_MAX || length > UINT32_MAX) {
+        error_setg(errp, "Crucible block transport projection length is invalid");
+        return false;
+    }
+    transport = g_try_malloc(length);
+    if (!transport) {
+        error_setg(errp, "Crucible block transport projection allocation failed");
+        return false;
+    }
+    written = crucible_group_call_blk_transport_save_cb(transport, length,
+                                              crucible_blk_event_userdata);
+    if (written != length ||
+        !crucible_shmem_plugin_state_matches(
+            transport, length, request_epoch, next_request_id)) {
+        error_setg(errp, "Crucible block transport projection is inconsistent");
+        return false;
+    }
+
+    qemu_put_be64(f, request_epoch);
+    qemu_put_be32(f, next_request_id);
+    qemu_put_be64(f, recovery_deadline_ns);
+    qemu_put_be16(f, recovery_phase_ps);
+    qemu_put_byte(f, recovery_unadmitted);
+    qemu_put_byte(f, recovery_failure);
+    qemu_put_be32(f, length);
+    qemu_put_buffer(f, transport, length);
