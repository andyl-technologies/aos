+/* The service journal is in the already charged Source layout. Its holder
+ * does not depend on publishing a usable view into arbitrary caller storage. */
+static bool startup_setup_output_disjoint(const void *output, size_t bytes)
+{
+    uintptr_t address = (uintptr_t)output;
+    uintptr_t source = (uintptr_t)&startup_source;
+
+    return output && bytes && bytes <= UINTPTR_MAX - address &&
+        !(address < source + sizeof(startup_source) && source < address + bytes);
+}
+
+static int startup_setup_service_output_check(uint32_t version, size_t bytes,
+    const struct qemu_plugin_crucible_setup_borrow_v4 *out)
+{
+    return version == 4 && bytes == sizeof(*out) &&
+        startup_setup_output_disjoint(out, bytes) ? 0 : -EINVAL;
+}
