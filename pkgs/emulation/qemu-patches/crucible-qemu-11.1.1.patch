diff --git a/tests/qtest/crucible-multiboot-gap.py b/tests/qtest/crucible-multiboot-gap.py
new file mode 100644
index 0000000000000000000000000000000000000000..fbcdc73a9615040844d1669d733fb6d755087aa1
--- /dev/null
+++ b/tests/qtest/crucible-multiboot-gap.py
@@ -0,0 +1,202 @@
+# Copyright (c) 2026 ANDYL Technologies
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Checks loader gaps and refuses SIM execution without its admitted owner."""
+
+import argparse
+import os
+import socket
+import struct
+import subprocess
+import tempfile
+
+
+GAP_ADDRESS = 0x101000
+PAGE_SIZE = 0x1000
+MAX_DIAGNOSTIC_BYTES = 64 * 1024
+
+
+def write_two_segment_kernel(path):
+    """Writes an ELF32 multiboot image with one page between PT_LOAD ranges."""
+    image = bytearray(0x3000)
+    ident = b"\x7fELF\x01\x01\x01" + bytes(9)
+    image[:52] = struct.pack(
+        "<16sHHIIIIIHHHHHH", ident, 2, 3, 1, 0x100200, 52, 0, 0,
+        52, 32, 2, 0, 0, 0,
+    )
+    image[52:84] = struct.pack(
+        "<IIIIIIII", 1, 0, 0x100000, 0x100000,
+        PAGE_SIZE, PAGE_SIZE, 5, PAGE_SIZE,
+    )
+    image[84:116] = struct.pack(
+        "<IIIIIIII", 1, 0x2000, 0x102000, 0x102000,
+        PAGE_SIZE, PAGE_SIZE, 6, PAGE_SIZE,
+    )
+
+    magic = 0x1BADB002
+    flags = 0
+    image[0x100:0x10C] = struct.pack(
+        "<III", magic, flags, (-magic - flags) & 0xFFFFFFFF,
+    )
+    image[0x200:0x207] = b"\xb0\x10\xe6\xf4\xf4\xeb\xfd"
+    image[0x2000:0x3000] = b"D" * PAGE_SIZE
+
+    with open(path, "wb") as kernel:
+        kernel.write(image)
+
+
+def qtest_read(connection, address, length):
+    """Reads one bounded guest-physical range from the qtest channel."""
+    connection.sendall(f"read 0x{address:x} 0x{length:x}\n".encode())
+    response = bytearray()
+    while b"\n" not in response:
+        chunk = connection.recv(length * 2 + 16 - len(response))
+        if not chunk:
+            raise AssertionError("qtest channel closed before its response")
+        response.extend(chunk)
+        if len(response) > length * 2 + 15:
+            raise AssertionError("qtest response exceeds its bounded range")
+    prefix = b"OK 0x"
+    if not response.startswith(prefix) or not response.endswith(b"\n"):
+        raise AssertionError(f"qtest read failed: {response!r}")
+    return bytes.fromhex(response[len(prefix):-1].decode())
+
+
+def verify_direct_kernel_boot(qemu, kernel_path, data_dir, accelerator,
+                              resident_plugin=None):
+    """Checks ordinary guest entry or the mandatory ownerless SIM refusal."""
+    command = [
+        qemu,
+        "-L", data_dir,
+        "-machine", "pc-q35-9.2",
+        "-cpu", "qemu64",
+        "-m", "16M",
+        "-nodefaults",
+        "-display", "none",
+        "-serial", "none",
+        "-monitor", "none",
+        "-accel", f"{accelerator},thread=single",
+        "-icount", "shift=0,sleep=off",
+        "-kernel", kernel_path,
+        "-device", "isa-debug-exit,iobase=0xf4,iosize=0x04",
+        "-no-reboot",
+    ]
+    if resident_plugin is not None:
+        command.extend(["-plugin", resident_plugin])
+    try:
+        result = subprocess.run(
+            command,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            timeout=30,
+            check=False,
+        )
+    except subprocess.TimeoutExpired as error:
+        raise AssertionError(
+            "direct multiboot guest did not reach its debug exit before "
+            f"timeout: stderr={error.stderr!r}"
+        ) from error
+    stderr = result.stderr[:MAX_DIAGNOSTIC_BYTES].decode(errors="replace")
+    if accelerator == "sim" and resident_plugin is None:
+        if result.returncode != 1 or (
+            "logical RAM admission owner is absent or already sealed" not in stderr
+        ):
+            raise AssertionError(
+                "unmanaged SIM execution did not fail at RAM admission: "
+                f"status={result.returncode} stderr={stderr!r}"
+            )
+    elif result.returncode != 33:
+        raise AssertionError(
+            "ordinary multiboot guest did not reach its debug exit: "
+            f"status={result.returncode} stderr={stderr!r}"
+        )
+
+
+def verify_paused_loader(qemu, kernel_path, data_dir, qtest_path,
+                         accelerator, resident_plugin=None):
+    """Checks the same page oracle before execution under an explicit owner."""
+    listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+    listener.bind(qtest_path)
+    listener.listen(1)
+    listener.settimeout(10)
+    command = [
+        qemu,
+        "-L", data_dir,
+        "-machine", "pc-q35-9.2",
+        "-cpu", "qemu64",
+        "-m", "16M",
+        "-nodefaults",
+        "-display", "none",
+        "-serial", "none",
+        "-monitor", "none",
+        "-S",
+        "-accel", f"{accelerator},thread=single",
+        "-icount", "shift=0,sleep=off",
+        "-kernel", kernel_path,
+        "-qtest", f"unix:{qtest_path}",
+    ]
+    if resident_plugin is not None:
+        command.extend(["-plugin", resident_plugin])
+    process = subprocess.Popen(command, stdout=subprocess.PIPE,
+                               stderr=subprocess.PIPE)
+    try:
+        connection, _ = listener.accept()
+        with connection:
+            connection.settimeout(10)
+            gap = qtest_read(connection, GAP_ADDRESS, PAGE_SIZE)
+            second_segment = qtest_read(connection, 0x102000, PAGE_SIZE)
+        if gap != bytes(PAGE_SIZE):
+            raise AssertionError("multiboot inter-PT_LOAD gap was not zero")
+        if second_segment != b"D" * PAGE_SIZE:
+            raise AssertionError("multiboot second PT_LOAD payload changed")
+    except Exception as error:
+        process.terminate()
+        try:
+            stdout, stderr = process.communicate(timeout=10)
+        except subprocess.TimeoutExpired:
+            process.kill()
+            stdout, stderr = process.communicate(timeout=10)
+        raise AssertionError(
+            "paused loader oracle failed: "
+            f"status={process.returncode} "
+            f"stdout={stdout[:MAX_DIAGNOSTIC_BYTES]!r} "
+            f"stderr={stderr[:MAX_DIAGNOSTIC_BYTES]!r}"
+        ) from error
+    finally:
+        if process.poll() is None:
+            process.terminate()
+        process.wait(timeout=10)
+        listener.close()
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--qemu", required=True)
+    parser.add_argument(
+        "--data-dir", required=True,
+        help="Firmware directory available before QEMU installation",
+    )
+    parser.add_argument("--resident-plugin", required=True,
+                        help="Bounded resident logical-RAM component observer")
+    args = parser.parse_args()
+
+    with tempfile.TemporaryDirectory(prefix="multiboot-gap-") as directory:
+        kernel_path = os.path.join(directory, "two-segment.elf")
+        qtest_path = os.path.join(directory, "qtest.sock")
+        write_two_segment_kernel(kernel_path)
+
+        verify_paused_loader(args.qemu, kernel_path, args.data_dir,
+                             qtest_path, "tcg")
+        verify_paused_loader(args.qemu, kernel_path, args.data_dir,
+                             qtest_path + "-sim", "sim", args.resident_plugin)
+        verify_direct_kernel_boot(args.qemu, kernel_path, args.data_dir, "tcg")
+        verify_direct_kernel_boot(args.qemu, kernel_path, args.data_dir, "sim")
+        verify_direct_kernel_boot(args.qemu, kernel_path, args.data_dir,
+                                  "sim", args.resident_plugin)
+    print("multiboot_loader_intersegment_gap_zero=true")
+    print("multiboot_sim_unmanaged_execution_refused=true")
+    print("multiboot_resident_sim_intersegment_gap_zero=true")
+    print("multiboot_resident_sim_guest_entry=true")
+
+
+if __name__ == "__main__":
+    main()
