+int qemu_crucible_fault_node_validation_owned_v1(
+    const QemuCrucibleFaultHandler *handler);
+/* Only the actual Submit/restore dispatch interval permits node validation.
+ * These process-private helpers issue no allocation or registration grant. */
+int qemu_crucible_fault_validation_current_v1(
+    const QemuCrucibleFaultHandler *handler,
+    const struct qemu_plugin_crucible_fault_command *command,
