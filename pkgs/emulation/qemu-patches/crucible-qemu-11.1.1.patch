+static int preexec_setup_identity(void)
+{
+    uint32_t users[3];
+    uint32_t groups[3];
+    long status = preexec_setup_syscall5(SYS_getresuid,
+        (long)(uintptr_t)&users[0], (long)(uintptr_t)&users[1],
+        (long)(uintptr_t)&users[2], 0, 0);
+
+    if (status < 0) {
+        return (int)status;
+    }
+    status = preexec_setup_syscall5(SYS_getresgid,
+        (long)(uintptr_t)&groups[0], (long)(uintptr_t)&groups[1],
+        (long)(uintptr_t)&groups[2], 0, 0);
+    if (status < 0) {
+        return (int)status;
+    }
+    if (!users[0] || users[0] != users[1] || users[0] != users[2] ||
+        !groups[0] || groups[0] != groups[1] || groups[0] != groups[2]) {
+        return -EPERM;
+    }
+    status = preexec_setup_syscall5(SYS_getgroups, 0, 0, 0, 0, 0);
+    if (status != 0) {
+        return status < 0 ? (int)status : -EPERM;
+    }
+    /* The genuine peer/carrier/family must already be retained before record
+     * identities can corroborate this actual kernel credential. Main's peer
+     * identity intentionally differs; the receiver never installs credentials.
+     */
+    if (preexec_setup_owner.family_corroborated) {
+        if (users[0] != preexec_setup_owner.plan.purpose.child_uid ||
+            groups[0] != preexec_setup_owner.plan.purpose.child_gid) {
+            return -ESTALE;
+        }
+        if (!preexec_setup_owner.source_published) {
+            preexec_setup_owner.identity_corroborated = true;
+        }
+    }
+    return 0;
+}
