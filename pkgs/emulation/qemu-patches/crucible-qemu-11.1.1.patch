+def run_late_ceiling_test(qemu, plugin, bios):
+    busy_bios = bytearray(open(bios, "rb").read())
+    busy_bios[-16:-13] = bytes((0xFA, 0xEB, 0xFD))
+    with tempfile.NamedTemporaryFile(prefix="late-ceiling-bios-") as bios_file:
+        bios_file.write(busy_bios)
+        bios_file.flush()
+        live = LiveQemu(
+            qemu,
+            plugin,
+            bios_file.name,
+            dispatch_ceiling=INITIAL_DISPATCH_CEILING,
+            rr_switch_quantum=RR_SWITCH_QUANTUM,
+            x86_smp="4,maxcpus=4",
+        )
+
+    try:
+        initial_events = [live.marker() for _ in range(4)]
+        expected_work = [
+            ("work", vcpu_index) for vcpu_index in range(4)
+        ]
+        if initial_events != expected_work:
+            raise AssertionError(
+                f"unexpected initial vCPU work: {initial_events!r}"
+            )
+
+        status = live.qmp("query-status")
+        if status != {"status": "running", "running": True}:
+            raise AssertionError(
+                f"queued main-loop poll did not complete: {status!r}"
+            )
+
+        dispatch_icounts = []
+        while not dispatch_icounts or (
+            dispatch_icounts[-1] != INITIAL_DISPATCH_CEILING
+        ):
+            marker = live.marker()
+            event, icount = marker
+            if event == "dispatch":
+                if (
+                    icount == 0
+                    or icount > INITIAL_DISPATCH_CEILING
+                    or icount % RR_SWITCH_QUANTUM != 0
+                ):
+                    raise AssertionError(
+                        f"unexpected initial dispatch boundary: {icount}"
+                    )
+                dispatch_icounts.append(icount)
+                continue
+            if event == "park" or (event == "result" and icount == 9):
+                continue
+            if event != "work":
+                raise AssertionError(
+                    f"unexpected initial ceiling marker: {(event, icount)!r}"
+                )
+        expected_dispatches = [
+            icount
+            for icount in range(
+                RR_SWITCH_QUANTUM,
+                INITIAL_DISPATCH_CEILING + 1,
+                RR_SWITCH_QUANTUM,
+            )
+        ]
+        if dispatch_icounts != expected_dispatches:
+            raise AssertionError(
+                "unexpected initial dispatch progression: "
+                f"{dispatch_icounts!r}"
+            )
+
+        park_deadline = time.monotonic() + TIMEOUT_SECONDS
+        live.wait_for_rr_dispatch_event(park_deadline)
+
+        status = live.qmp("query-status")
+        if status != {"status": "running", "running": True}:
+            raise AssertionError(
+                "main loop did not remain live at the dispatch ceiling: "
+                f"{status!r}"
+            )
+
+        live.control_state[8:16] = NEXT_DISPATCH_CEILING.to_bytes(
+            8, byteorder=sys.byteorder
+        )
+        live.control_state.flush()
+        os.eventfd_write(live.wake_fd, 1)
+
+        resume_deadline = time.monotonic() + TIMEOUT_SECONDS
+        resume_events = []
+        while True:
+            event, value = live.marker(resume_deadline)
+            if event == "dispatch":
+                if value == NEXT_DISPATCH_CEILING:
+                    resume_events.append((event, value))
+                    break
+                if value == INITIAL_DISPATCH_CEILING:
+                    continue
+                raise AssertionError(
+                    f"unexpected resumed dispatch boundary: {value}"
+                )
+            if event == "control":
+                resume_events.append((event, value))
+                continue
+            if event == "park" or (event == "result" and value == 9):
+                continue
+            raise AssertionError(
+                f"unexpected late-ceiling marker: {(event, value)!r}"
+            )
+        expected_control = ("control", (INITIAL_DISPATCH_CEILING, 1))
+        expected_dispatch = ("dispatch", NEXT_DISPATCH_CEILING)
+        if resume_events != [expected_control, expected_dispatch]:
+            raise AssertionError(
+                f"unexpected late-ceiling resume events: {resume_events!r}"
+            )
+    finally:
+        live.close()
+    return tuple(event for event, _value in resume_events)
+
