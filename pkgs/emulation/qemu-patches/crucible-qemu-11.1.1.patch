+#define CRUCIBLE_COMMAND_VMSTATE_MAGIC "CRUFCMD4"
+#define CRUCIBLE_COMMAND_VMSTATE_VERSION 4
+#define CRUCIBLE_COMMAND_VMSTATE_HEADER_BYTES 96
+#define CRUCIBLE_COMMAND_VMSTATE_COMMAND_BYTES 184
+#define CRUCIBLE_COMMAND_VMSTATE_RESULT_BYTES 152
+
+static void crucible_fault_vmstate_append_u16(GByteArray *bytes,
+                                               uint16_t value)
+{
+    uint8_t encoded[2];
+
+    stw_be_p(encoded, value);
+    g_byte_array_append(bytes, encoded, sizeof(encoded));
+}
+
+static void crucible_fault_vmstate_append_u32(GByteArray *bytes,
+                                               uint32_t value)
+{
+    uint8_t encoded[4];
+
+    stl_be_p(encoded, value);
+    g_byte_array_append(bytes, encoded, sizeof(encoded));
+}
+
+static void crucible_fault_vmstate_append_u64(GByteArray *bytes,
+                                               uint64_t value)
+{
+    uint8_t encoded[8];
+
+    stq_be_p(encoded, value);
+    g_byte_array_append(bytes, encoded, sizeof(encoded));
+}
+
+static bool crucible_fault_vmstate_take(const uint8_t *payload,
+                                        size_t payload_len, size_t *offset,
+                                        size_t length, const uint8_t **value)
+{
+    if (*offset > payload_len || payload_len - *offset < length) {
+        return false;
+    }
+    *value = payload + *offset;
+    *offset += length;
+    return true;
+}
+
+static void crucible_fault_vmstate_encode_command(
+    GByteArray *bytes,
+    const struct qemu_plugin_crucible_fault_command *command)
+{
+    crucible_fault_vmstate_append_u16(bytes, command->abi_major);
+    crucible_fault_vmstate_append_u16(bytes, command->abi_minor);
+    crucible_fault_vmstate_append_u16(bytes, command->command_kind);
+    crucible_fault_vmstate_append_u16(bytes, command->command_flags);
+    crucible_fault_vmstate_append_u16(bytes, command->phase);
+    crucible_fault_vmstate_append_u16(bytes, command->reserved);
+    crucible_fault_vmstate_append_u32(bytes, command->semantic_version);
+    crucible_fault_vmstate_append_u64(bytes, command->command_sequence);
+    g_byte_array_append(bytes, command->target_node_hash, 32);
+    crucible_fault_vmstate_append_u64(bytes, command->target_icount);
+    crucible_fault_vmstate_append_u64(
+        bytes, command->authorization_ceiling_icount);
+    crucible_fault_vmstate_append_u64(bytes, command->target_tick);
+    crucible_fault_vmstate_append_u64(
+        bytes, command->authorization_ceiling_tick);
+    g_byte_array_append(bytes, command->binding_hash, 32);
+    g_byte_array_append(bytes, command->opportunity_hash, 32);
+    g_byte_array_append(bytes, command->expected_precondition_hash, 32);
+}
+
+static bool crucible_fault_vmstate_decode_command(
+    const uint8_t *payload, size_t payload_len, size_t *offset,
+    struct qemu_plugin_crucible_fault_command *command)
+{
+    const uint8_t *encoded;
+
+    if (!crucible_fault_vmstate_take(payload, payload_len, offset,
+                                     CRUCIBLE_COMMAND_VMSTATE_COMMAND_BYTES,
+                                     &encoded)) {
+        return false;
+    }
+    memset(command, 0, sizeof(*command));
+    command->abi_major = lduw_be_p(encoded);
+    command->abi_minor = lduw_be_p(encoded + 2);
+    command->command_kind = lduw_be_p(encoded + 4);
+    command->command_flags = lduw_be_p(encoded + 6);
+    command->phase = lduw_be_p(encoded + 8);
+    command->reserved = lduw_be_p(encoded + 10);
+    command->semantic_version = ldl_be_p(encoded + 12);
+    command->command_sequence = ldq_be_p(encoded + 16);
+    memcpy(command->target_node_hash, encoded + 24, 32);
+    command->target_icount = ldq_be_p(encoded + 56);
+    command->authorization_ceiling_icount = ldq_be_p(encoded + 64);
+    command->target_tick = ldq_be_p(encoded + 72);
+    command->authorization_ceiling_tick = ldq_be_p(encoded + 80);
+    memcpy(command->binding_hash, encoded + 88, 32);
+    memcpy(command->opportunity_hash, encoded + 120, 32);
+    memcpy(command->expected_precondition_hash, encoded + 152, 32);
+    return true;
+}
+
+static void crucible_fault_vmstate_encode_result(
+    GByteArray *bytes,
+    const struct qemu_plugin_crucible_fault_result *result)
+{
+    crucible_fault_vmstate_append_u16(bytes, result->command_kind);
