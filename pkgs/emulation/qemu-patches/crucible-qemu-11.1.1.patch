+static uint64_t accelerator_get_features(VirtIODevice *vdev,
+                                         uint64_t features, Error **errp)
+{
+    (void)vdev;
+    (void)errp;
+    return features;
+}
+
+static void accelerator_realize(DeviceState *device, Error **errp)
+{
+    VirtIOCrucibleAccelerator *dev = VIRTIO_CRUCIBLE_ACCELERATOR(device);
+    VirtIODevice *vdev = VIRTIO_DEVICE(device);
+
+    if (strcmp(current_accel_name(), "sim") != 0) {
+        error_setg(errp, "virtio-crucible-accelerator requires -accel sim");
+        return;
+    }
+    virtio_init_named(vdev, VIRTIO_ID_CRUCIBLE_ACCELERATOR,
+                      sizeof(dev->config),
+                      "virtio-crucible-accelerator");
+    dev->vq = virtio_add_queue(vdev,
+                               VIRTIO_CRUCIBLE_ACCELERATOR_QUEUE_SIZE,
+                               accelerator_handle_output);
+    QTAILQ_INIT(&dev->pending);
+    dev->wake_notifier.notify = accelerator_wake;
+    qemu_plugin_wake_notifier_add(&dev->wake_notifier);
+    dev->wake_registered = true;
+    dev->config.protocol_version = cpu_to_le16(1);
+    dev->config.class_mask = cpu_to_le16(0x7);
+    dev->config.flags = cpu_to_le32(
+        VIRTIO_CRUCIBLE_ACCELERATOR_FLAG_PRESENT);
+    dev->config.queue_depth = cpu_to_le32(
+        VIRTIO_CRUCIBLE_ACCELERATOR_QUEUE_SIZE);
+    dev->config.data_max = cpu_to_le32(VIRTIO_CRUCIBLE_ACCELERATOR_DATA_MAX);
+    qemu_crucible_fault_accelerator_device_id(dev->config.device_id);
+    qemu_crucible_fault_accelerator_device_register(
+        dev->config.device_id, accelerator_fault_lifecycle, dev);
+}
+
+static void accelerator_unrealize(DeviceState *device)
+{
+    VirtIOCrucibleAccelerator *dev = VIRTIO_CRUCIBLE_ACCELERATOR(device);
+    VirtIODevice *vdev = VIRTIO_DEVICE(device);
+
+    qemu_crucible_fault_accelerator_device_unregister(dev);
+
+    if (dev->wake_registered) {
+        qemu_plugin_wake_notifier_remove(&dev->wake_notifier);
+        dev->wake_registered = false;
+    }
+    accelerator_drop_pending(dev, 4);
+    virtio_del_queue(vdev, 0);
+    virtio_cleanup(vdev);
+}
+
+static void accelerator_reset(DeviceState *device)
+{
+    VirtIOCrucibleAccelerator *dev = VIRTIO_CRUCIBLE_ACCELERATOR(device);
+
+    accelerator_drop_pending(dev, 4);
+    qemu_crucible_fault_accelerator_reset(dev->config.device_id);
+}
+
+static bool accelerator_fingerprint_projection(QEMUFile *f,
+                                               const void *opaque,
+                                               Error **errp)
+{
+    const VirtIOCrucibleAccelerator *dev = opaque;
+    const VirtIOCrucibleAcceleratorRequest *request;
+    uint32_t count = 0;
+
+    QTAILQ_FOREACH(request, &dev->pending, link) {
+        count++;
+        if (!request->element) {
+            error_setg(errp, "accelerator projection has no request element");
+            return false;
+        }
+    }
+    if (count != dev->pending_count ||
+        count > VIRTIO_CRUCIBLE_ACCELERATOR_QUEUE_SIZE) {
+        error_setg(errp, "accelerator projection has invalid pending queue");
+        return false;
+    }
+    if (!virtio_save_fingerprint_projection(f, VIRTIO_DEVICE(dev), errp)) {
+        return false;
+    }
+    qemu_put_buffer(f, (const uint8_t *)&dev->config, sizeof(dev->config));
+    qemu_put_be32(f, count);
+    QTAILQ_FOREACH(request, &dev->pending, link) {
+        qemu_put_buffer(f, (const uint8_t *)&request->job,
+                        sizeof(request->job));
+        qemu_put_virtqueue_element(VIRTIO_DEVICE(dev), f, request->element);
+    }
+    return qemu_file_get_error(f) == 0;
+}
+
+static const CrucibleFingerprintProjection accelerator_fingerprint = {
+    .schema = "crucible.qemu.virtio-crucible-accelerator.v3",
+    .version = 3,
+    .save = accelerator_fingerprint_projection,
+};
