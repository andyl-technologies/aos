+        &qmp_main_dispatch_request->mon->parent_obj == mon) {
+        QMPRequest *request = qmp_main_dispatch_request;
+
+        request->dispatch_post_status = qemu_crucible_qmp_scope_end(
+            &request->dispatch_scope);
+        if (request->dispatch_post_status) {
+            request->mon->crucible_parser_post_status = request->dispatch_post_status;
+            return request->dispatch_post_status;
+        }
+        request->dispatch_borrow = NULL;
+        qmp_main_dispatch_request = NULL;
+    }
+    return 0;
+}
