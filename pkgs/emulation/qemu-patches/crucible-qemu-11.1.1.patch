+static void live_node_field(GByteArray *payload, uint16_t tag, uint16_t type,
+                            const void *data, uint32_t length)
+{
+    uint8_t header[CRUCIBLE_NODE_FAULT_FIELD_HEADER_V1_BYTES] = { 0 };
+
+    stw_le_p(header + CRUCIBLE_NODE_FAULT_FIELD_TAG_OFFSET, tag);
+    stw_le_p(header + CRUCIBLE_NODE_FAULT_FIELD_TYPE_OFFSET, type);
+    stl_le_p(header + CRUCIBLE_NODE_FAULT_FIELD_LENGTH_OFFSET, length);
+    g_byte_array_append(payload, header, sizeof(header));
+    g_byte_array_append(payload, data, length);
+}
+
+static GByteArray *live_node_hang_payload(uint16_t operation,
+                                         uint64_t generation)
+{
+    GByteArray *payload = g_byte_array_sized_new(512);
+    uint8_t value[32];
+    const char scope[] = CRUCIBLE_NODE_FAULT_POLICY_JSON_MAGIC_V1 "{\"kind\":\"node\"}";
+#ifdef CRUCIBLE_NODE_LIVE_WATCHDOG
+    const char watchdog[] = CRUCIBLE_NODE_FAULT_POLICY_JSON_MAGIC_V1
+        "{\"kind\":\"transition_after\",\"parameters\":{"
+        "\"boot_policy\":{\"kind\":\"immediate\"},"
+        "\"device_state_policy\":\"preserve\",\"downtime_nanos\":0,"
+        "\"timeout_nanos\":1,\"transition\":\"power_off\","
+        "\"volatile_state_policy\":\"preserve\"}}";
+#else
+    const char watchdog[] = CRUCIBLE_NODE_FAULT_POLICY_JSON_MAGIC_V1 "{\"kind\":\"disabled\"}";
+#endif
+
+    g_byte_array_set_size(payload, CRUCIBLE_NODE_FAULT_PAYLOAD_HEADER_V1_BYTES);
+    memset(payload->data, 0, payload->len);
+    memcpy(payload->data, CRUCIBLE_NODE_MAGIC, 8);
+    stw_le_p(payload->data + CRUCIBLE_NODE_FAULT_PAYLOAD_VERSION_OFFSET,
+             CRUCIBLE_NODE_FAULT_PAYLOAD_VERSION_V1);
+    stw_le_p(payload->data + CRUCIBLE_NODE_FAULT_PAYLOAD_COMMAND_KIND_OFFSET,
+             CRUCIBLE_FAULT_COMMAND_NODE_HANG);
+    stw_le_p(payload->data + CRUCIBLE_NODE_FAULT_PAYLOAD_OPERATION_OFFSET,
+             operation);
+    stw_le_p(payload->data + CRUCIBLE_NODE_FAULT_PAYLOAD_TARGET_KIND_OFFSET,
+             CRUCIBLE_NODE_FAULT_TARGET_NODE);
+    stw_le_p(payload->data + CRUCIBLE_NODE_FAULT_PAYLOAD_MODEL_PHASE_OFFSET,
+             QEMU_CRUCIBLE_MODEL_PHASE_ARM);
+    stq_le_p(payload->data + CRUCIBLE_NODE_FAULT_PAYLOAD_GENERATION_OFFSET,
+             generation);
+    memset(payload->data + CRUCIBLE_NODE_FAULT_PAYLOAD_ACTION_HASH_OFFSET, 1, 32);
+    memset(payload->data + CRUCIBLE_NODE_FAULT_PAYLOAD_TARGET_HASH_OFFSET, 2, 32);
+    memset(payload->data + CRUCIBLE_NODE_FAULT_PAYLOAD_SCHEMA_HASH_OFFSET, 3, 32);
+    if (operation == CRUCIBLE_NODE_FAULT_OPERATION_REMOVE) {
+        return payload;
+    }
+    stw_le_p(payload->data + CRUCIBLE_NODE_FAULT_PAYLOAD_FIELD_COUNT_OFFSET, 4);
+    stl_le_p(value, 1);
+    live_node_field(payload, CRUCIBLE_NODE_FAULT_FIELD_P1,
+                    CRUCIBLE_NODE_FAULT_FIELD_TYPE_U32, value, 4);
+    live_node_field(payload, CRUCIBLE_NODE_FAULT_FIELD_P2,
+                    CRUCIBLE_NODE_FAULT_FIELD_TYPE_BYTES, scope,
+                    sizeof(scope) - 1);
+    memset(value, 4, sizeof(value));
+    live_node_field(payload, CRUCIBLE_NODE_FAULT_FIELD_P3,
+                    CRUCIBLE_NODE_FAULT_FIELD_TYPE_HASH, value, sizeof(value));
+    live_node_field(payload, CRUCIBLE_NODE_FAULT_FIELD_P4,
+                    CRUCIBLE_NODE_FAULT_FIELD_TYPE_BYTES, watchdog,
+                    sizeof(watchdog) - 1);
+    return payload;
+}
