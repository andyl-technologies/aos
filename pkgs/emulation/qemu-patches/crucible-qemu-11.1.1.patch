+static int inventory_capture_return_identity(
+    QemuCrucibleCheckpointInventoryLoan *parent,
+    QemuCrucibleRamInventoryCaptureLoan *loan)
+{
+    int context = qemu_crucible_ram_metadata_return_context();
+
+    if (context < 0) {
+        return context;
+    }
+    if (loan != &inventory_capture || !loan->active || loan->parent != parent ||
+        loan->process != getpid() || !qemu_thread_is_self(&loan->thread) ||
+        !qemu_in_main_thread() || !bql_locked() || qemu_in_coroutine()) {
+        return -EPERM;
+    }
+    if (!loan->cleanup_pending) {
+        return qemu_crucible_ram_inventory_capture_identity_v1(parent, loan);
+    }
+    if ((!loan->inventory_return.consumed &&
+         !loan->inventory_return.disposition.projection_consumed) ||
+        loan->regions || loan->source_capture || capture_active ||
+        !inventory_return_pending(&loan->inventory_return)) {
+        return -ESTALE;
+    }
+    return 0;
+}
+
+static int inventory_capture_current(QemuCrucibleRamInventoryCaptureLoan *loan)
+{
+    uint64_t slice;
+    int status;
+
+    if (loan != &inventory_capture) {
+        return -EPERM;
+    }
+    status = qemu_crucible_ram_inventory_capture_identity_v1(loan->parent, loan);
+    if (!status) {
+        status = qemu_crucible_checkpoint_inventory_current_v1(loan->parent, &slice);
+    }
+    if (!status && (loan->regions != admission_regions ||
+                    loan->topology != qatomic_read(&topology_generation) ||
+                    loan->topology != admission.topology_generation)) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        WITH_RCU_READ_LOCK_GUARD() {
+            for (size_t index = 0; index < loan->regions->len; index++) {
+                const CrucibleRamRegion *region = region_inventory_index(loan->regions, index);
+                RAMBlock *block;
+                bool found = false;
+
+                RAMBLOCK_FOREACH(block) {
+                    if (block == region->block) {
+                        found = true;
+                        break;
+                    }
+                }
+                if (!found || strlen(block->idstr) != region->descriptor.id_length ||
+                    memcmp(block->idstr, region->descriptor.id, region->descriptor.id_length) ||
+                    block->used_length != region->descriptor.logical_length ||
+                    block->offset != region->fingerprint_ram_offset ||
+                    block->used_length > (ram_addr_t)-1 - block->offset) {
+                    return -ESTALE;
+                }
+            }
+        }
+    }
+    return status;
+}
