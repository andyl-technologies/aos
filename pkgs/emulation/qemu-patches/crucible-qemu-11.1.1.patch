+int qemu_plugin_crucible_parent_park_drain_original_query_slice_v1(
+    qemu_plugin_id_t id, uint64_t *remaining_ns)
+{
+#ifdef CONFIG_LINUX
+    return parent_park_callback_slice(id, remaining_ns);
+#else
+    return -ENOTSUP;
+#endif
+}
