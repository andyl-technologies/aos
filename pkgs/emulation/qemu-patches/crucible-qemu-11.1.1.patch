+int qapi_source_visitor_selected(Visitor *visitor, bool *selected)
+{
+    QemuCrucibleQmpAllocationOwner *owner;
+    unsigned kind;
+    int status;
+
+    if (!visitor || !selected) {
+        return -EINVAL;
+    }
+    *selected = false;
+    if (!qemu_crucible_qmp_visitor_loan_current(visitor, NULL)) {
+        *selected = true;
+        return 0;
+    }
+    status = qemu_crucible_qmp_visitor_observe(visitor, &kind, &owner);
+    if (status == -ENOENT) {
+        return 0;
+    }
+    if (status) {
+        return status;
+    }
+    if (kind == QEMU_CRUCIBLE_QMP_VISITOR_INPUT) {
+        status = input_source_identity(visitor);
+    } else if (kind == QEMU_CRUCIBLE_QMP_VISITOR_OUTPUT) {
+        status = qapi_source_output_status(visitor);
+        /* The actual compiled registry class remains Source even after a
+         * constructor/conversion/cleanup refusal. Status is observed separately. */
+        *selected = true;
+        return 0;
+    } else if (kind == QEMU_CRUCIBLE_QMP_VISITOR_DEALLOC) {
+        status = qapi_source_dealloc_status(visitor);
+        /* A retained raw failure does not make the known visitor generic. */
+        *selected = true;
+        return 0;
+    } else {
+        return -ESTALE;
+    }
+    *selected = !status;
+    return status;
+}
+
+int qapi_source_visitor_status(Visitor *visitor)
+{
+    QemuCrucibleQmpAllocationOwner *owner;
+    unsigned kind;
+    int status;
+
+    if (!visitor) {
+        return -EINVAL;
+    }
+    if (!qemu_crucible_qmp_visitor_loan_current(visitor, NULL)) {
+        return qapi_source_dealloc_status(visitor);
+    }
+    status = qemu_crucible_qmp_visitor_observe(visitor, &kind, &owner);
+    if (status == -ENOENT) {
+        return 0;
+    }
+    if (status) {
+        return status;
+    }
+    if (kind == QEMU_CRUCIBLE_QMP_VISITOR_DEALLOC) {
+        return qapi_source_dealloc_status(visitor);
+    }
+    if (kind == QEMU_CRUCIBLE_QMP_VISITOR_OUTPUT) {
+        return qapi_source_output_status(visitor);
+    }
+    if (kind != QEMU_CRUCIBLE_QMP_VISITOR_INPUT) {
+        return -ESTALE;
+    }
+    status = input_source_identity(visitor);
+    if (status) {
+        return status;
+    }
+    return to_qiv(visitor)->source_status;
+}
