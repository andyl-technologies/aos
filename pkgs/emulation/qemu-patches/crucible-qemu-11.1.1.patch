+    memset(digest, 0, 32);
+    *sections_out = 0;
+    checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    if (!checksum) {
+        return -ENOMEM;
+    }
+    crucible_checksum_string(checksum,
+                             "crucible.qemu.device-projection-schema.v3");
