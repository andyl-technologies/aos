+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Check literal evidence and retained action/construction clock limits.
+
+These pure checks issue no action, subscriber, operation, activation or physical
+receipt. The mandatory launched lifecycle remains a separate requirement.
+"""
+
+import argparse
+import json
+import os
+from pathlib import Path
+import runpy
+import shlex
+import subprocess
+
+
+CHECKS = r"""
+#include <assert.h>
+
+int main(void)
+{
+    QemuCrucibleActionOriginal action = {
+        .native_class = QEMU_CRUCIBLE_STANDING_INITIALIZATION_CLASS,
+        .evidence = {
+            .schema_version = 1,
+            .struct_size = sizeof(action.evidence),
+            .primary_class = QEMU_CRUCIBLE_STANDING_INITIALIZATION_CLASS,
+            .required_units = 1,
+        },
+    };
+    uint64_t slice = 0;
+
+    assert(action_original_evidence(&action, true) == 0);
+    action.entered = action.evidence;
+    action.evidence.completed_required_units = 1;
+    assert(action_original_evidence(&action, false) == 0);
+    action.evidence.completed_required_units = 0;
+    assert(action_original_evidence(&action, false) == -EPROTO);
+    action.evidence.completed_required_units = 1;
+    action.evidence.required_units = 2;
+    assert(action_original_evidence(&action, false) == -EPROTO);
+    action.evidence.required_units = 1;
