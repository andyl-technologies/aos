+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Exercise literal architecture writers with caller-owned component storage.
+
+CPU feature/registry inputs are factual component inputs. These tests issue no
+Source payer, construction participant, borrowed Original or activation.
+"""
+
+import argparse
+from concurrent.futures import ThreadPoolExecutor
+import json
+import os
+from pathlib import Path
+import shlex
+import runpy
+import subprocess
+
+
+OBSERVERS = r"""
+static size_t allocation_calls;
+static gpointer counted_malloc(gsize size)
+{
+    allocation_calls++;
+    return g_malloc(size);
+}
+static gpointer counted_malloc0(gsize size)
+{
+    allocation_calls++;
+    return g_malloc0(size);
+}
+static gpointer counted_malloc_n(gsize count, gsize size)
+{
+    allocation_calls++;
+    return g_malloc_n(count, size);
+}
+static gchar *counted_strdup(const gchar *text)
+{
+    allocation_calls++;
+    return g_strdup(text);
+}
+static gchar *counted_strdup_printf(const gchar *format, ...) G_GNUC_PRINTF(1, 2);
+static gchar *counted_strdup_printf(const gchar *format, ...)
+{
+    va_list arguments;
+    gchar *result;
+
+    allocation_calls++;
+    va_start(arguments, format);
+    result = g_strdup_vprintf(format, arguments);
+    va_end(arguments);
+    return result;
+}
+static gchar *counted_strdown(const gchar *text, gssize length)
+{
+    allocation_calls++;
+    return g_ascii_strdown(text, length);
+}
+static GArray *counted_array(gboolean terminated, gboolean clear, guint size)
+{
+    allocation_calls++;
+    return g_array_new(terminated, clear, size);
+}
+#define g_malloc counted_malloc
+#define g_malloc0 counted_malloc0
+#define g_malloc_n counted_malloc_n
+#define g_array_new counted_array
+#define g_strdup counted_strdup
+#define g_strdup_printf counted_strdup_printf
+#define g_ascii_strdown counted_strdown
+"""
+
+CHECKS = r"""
+static char name_storage[512];
+static uint8_t masks[4][512];
+static uint32_t key_storage[32];
+static CrucibleCPURegisterBuffers buffers;
+static CrucibleCPURegisterCapability result;
+
+static void reset_storage(void)
+{
+    memset(name_storage, 0xa5, sizeof(name_storage));
+    memset(masks, 0xa5, sizeof(masks));
+    memset(&result, 0xa5, sizeof(result));
+    buffers = (CrucibleCPURegisterBuffers) {
+        .name = name_storage, .name_capacity = sizeof(name_storage),
+        .writable_mask = masks[0], .reserved_mask = masks[1],
+        .ignored_mask = masks[2], .read_only_mask = masks[3],
+        .mask_capacity = sizeof(masks[0]),
+    };
+}
+
+static void unchanged(void)
+{
+    unsigned char expected[sizeof(result)];
+
+    memset(expected, 0xa5, sizeof(expected));
+    assert(!memcmp(&result, expected, sizeof(result)));
+    for (size_t index = 0; index < sizeof(name_storage); index++) {
+        assert((unsigned char)name_storage[index] == 0xa5);
+    }
+    for (size_t row = 0; row < 4; row++) {
+        for (size_t index = 0; index < sizeof(masks[row]); index++) {
+            assert(masks[row][index] == 0xa5);
+        }
+    }
+}
+
+static void check_checked_geometry(void)
+{
+    CrucibleCPURegisterGeometry geometry = { .cpu = cs };
+    CrucibleCPURegisterGeometry saved;
+    uint32_t keys[257];
+
+    geometry.name_bytes = SIZE_MAX;
+    saved = geometry;
+    assert(!crucible_register_geometry_add(&geometry, 1, 64));
+    assert(!memcmp(&geometry, &saved, sizeof(saved)));
+    geometry.name_bytes = 0;
+    geometry.mask_bytes = SIZE_MAX;
+    saved = geometry;
+    assert(!crucible_register_geometry_add(&geometry, 1, 64));
+    assert(!memcmp(&geometry, &saved, sizeof(saved)));
+    geometry.mask_bytes = 0;
+    geometry.register_count = SIZE_MAX;
+    saved = geometry;
+    assert(!crucible_register_geometry_add(&geometry, 1, 64));
+    assert(!memcmp(&geometry, &saved, sizeof(saved)));
+    for (size_t count = 0; count <= G_N_ELEMENTS(keys); count++) {
+        for (size_t index = 0; index < count; index++) {
+            keys[index] = count - index;
+        }
+        allocation_calls = 0;
+        crucible_register_keys_sort(keys, count);
+        assert(allocation_calls == 0);
+        for (size_t index = 0; index < count; index++) {
+            assert(keys[index] == index + 1);
+        }
+    }
+}
+
+static void check_image(size_t expected_rows, size_t expected_keys)
+{
+    CrucibleCPURegisterGeometry geometry, foreign;
+    CrucibleCPURegisterKeyView view, bad;
+    CPUState foreign_cpu;
+    size_t names = 0, mask_bytes = 0, max_name = 0, max_mask = 0;
+
+    allocation_calls = 0;
+    assert(GEOMETRY(cs, &geometry));
+    assert(geometry.cpu == cs && geometry.register_count == expected_rows);
+    assert(geometry.key_count == expected_keys);
+    assert(KEYS(cs, key_storage, G_N_ELEMENTS(key_storage), &view));
+    assert(view.cpu == cs && view.count == expected_keys);
+    assert(allocation_calls == 0);
+    CHECK_KEY_ORDER(view);
+
+    for (size_t index = 0; index < geometry.register_count; index++) {
+        CrucibleCPURegisterCapability allocated;
+        reset_storage();
+        allocation_calls = 0;
+        assert(DESCRIBE(cs, index, &geometry, &view, &buffers, &result));
+        assert(allocation_calls == 0);
+        assert(result.name == name_storage && result.numeric_id == index + 1);
+        assert(result.mask_bytes == (result.width_bits + 7) / 8);
+        assert(result.writable_mask == masks[0] && result.reserved_mask == masks[1]);
+        assert(result.ignored_mask == masks[2] && result.read_only_mask == masks[3]);
+        CHECK_ROW(index, result);
+        names += strlen(result.name) + 1;
+        mask_bytes += result.mask_bytes;
+        max_name = MAX(max_name, strlen(result.name) + 1);
+        max_mask = MAX(max_mask, result.mask_bytes);
+        for (size_t byte = 0; byte < result.mask_bytes; byte++) {
+            unsigned full = byte + 1 == result.mask_bytes && result.width_bits % 8 ?
+                (1U << (result.width_bits % 8)) - 1 : 255;
+            assert((masks[0][byte] | masks[1][byte] | masks[2][byte] |
+                    masks[3][byte]) == full);
+            for (size_t left = 0; left < 4; left++) {
+                for (size_t right = left + 1; right < 4; right++) {
+                    assert(!(masks[left][byte] & masks[right][byte]));
+                }
+            }
+        }
+        assert(ALLOCATING(cs, index, &allocated));
+        assert(allocation_calls >= 5);
+        assert(!strcmp(result.name, allocated.name));
+        assert(allocated.name != name_storage);
+        assert(result.width_bits == allocated.width_bits &&
+               result.group == allocated.group &&
+               result.model_phase_mask == allocated.model_phase_mask &&
+               result.side_effects == allocated.side_effects &&
+               result.capabilities == allocated.capabilities);
+        uint8_t *owned[] = { allocated.writable_mask, allocated.reserved_mask,
+            allocated.ignored_mask, allocated.read_only_mask };
+        for (size_t mask = 0; mask < 4; mask++) {
+            assert(owned[mask] != masks[mask]);
+            assert(!memcmp(owned[mask], masks[mask], result.mask_bytes));
+            for (size_t other = mask + 1; other < 4; other++) {
+                assert(owned[mask] != owned[other]);
+            }
+            g_free(owned[mask]);
+        }
+        g_free(allocated.name);
+    }
+    assert(names == geometry.name_bytes && mask_bytes == geometry.mask_bytes);
+    assert(max_name == geometry.max_name_bytes && max_mask == geometry.max_mask_bytes);
+
+    reset_storage();
+    buffers.name_capacity = 1;
+    assert(!DESCRIBE(cs, 0, &geometry, &view, &buffers, &result));
+    unchanged();
+    reset_storage();
+    buffers.mask_capacity = 0;
+    assert(!DESCRIBE(cs, 0, &geometry, &view, &buffers, &result));
+    unchanged();
+    reset_storage();
+    foreign = geometry;
+    foreign.cpu = &foreign_cpu;
+    assert(!DESCRIBE(cs, 0, &foreign, &view, &buffers, &result));
+    unchanged();
+    bad = view;
+    bad.cpu = &foreign_cpu;
+    assert(!DESCRIBE(cs, 0, &geometry, &bad, &buffers, &result));
+    unchanged();
+    assert(!DESCRIBE(cs, geometry.register_count, &geometry, &view, &buffers, &result));
+    unchanged();
+    buffers.reserved_mask = buffers.writable_mask;
+    assert(!DESCRIBE(cs, 0, &geometry, &view, &buffers, &result));
+    unchanged();
+    reset_storage();
+    buffers.name = (char *)&result;
+    assert(!DESCRIBE(cs, 0, &geometry, &view, &buffers, &result));
+    unchanged();
+    reset_storage();
+    CHECK_BAD_KEYS(geometry, view);
+    CHANGE_GEOMETRY();
+    assert(!DESCRIBE(cs, 0, &geometry, &view, &buffers, &result));
+    unchanged();
+    RESTORE_GEOMETRY();
+}
+"""
+
+ARM_INPUTS = r"""
+static ARMCPU input_cpu;
+static CPUState *cs = &input_cpu.parent_obj;
+#undef ARM_CPU
+#define ARM_CPU(cpu) (&input_cpu)
+__ACTUAL_CPREG_LOOKUP__
+#define GEOMETRY aarch64_crucible_register_geometry
+#define KEYS aarch64_crucible_register_keys_into
+#define DESCRIBE aarch64_crucible_register_describe_into
+#define ALLOCATING aarch64_crucible_register_describe
+#define CHANGE_GEOMETRY() do { saved_vq = input_cpu.sve_max_vq; \
+    input_cpu.sve_max_vq = saved_vq == 1 ? 16 : 1; \
+    FIELD_DP64_IDREG(&input_cpu.isar, ID_AA64PFR0, SVE, 1); } while (0)
+#define RESTORE_GEOMETRY() do { input_cpu.sve_max_vq = saved_vq; \
+    FIELD_DP64_IDREG(&input_cpu.isar, ID_AA64PFR0, SVE, saved_sve); } while (0)
+static unsigned saved_sve, saved_vq;
+static ARMCPRegInfo rows[] = {
+    { .name = "UPPER / Name", .state = ARM_CP_STATE_AA64, .type = ARM_CP_64BIT },
+    { .name = NULL, .state = ARM_CP_STATE_AA64 },
+    { .name = "ordinary", .state = ARM_CP_STATE_AA64 },
+    { .name = "hidden", .state = ARM_CP_STATE_AA64, .type = ARM_CP_NO_RAW },
+    { .name = "ELR_EL1", .state = ARM_CP_STATE_AA64 },
+    { .name = "aa32", .state = ARM_CP_STATE_AA32 },
+};
+static void check_key_order(CrucibleCPURegisterKeyView view)
+{
+    GArray *old = a64_crucible_sysreg_keys(&input_cpu);
+    assert(view.count == old->len);
+    assert(view.count == 3);
+    for (size_t index = 0; index < view.count; index++) {
+        assert(view.keys[index] == g_array_index(old, uint32_t, index));
+    }
+    assert(view.keys[0] == 2 && view.keys[1] == 7 && view.keys[2] == 19);
+    g_array_unref(old);
+}
+#define CHECK_KEY_ORDER(view) check_key_order(view)
+static void check_row(size_t index, CrucibleCPURegisterCapability row)
+{
+    if (index == 0) { assert(!strcmp(row.name, "x0") && row.width_bits == 64); }
+    if (index == 34) { assert(!strcmp(row.name, "v0") && row.width_bits == 128); }
+    size_t fixed = a64_crucible_fixed_count(&input_cpu);
+    if (index == fixed) {
+        assert(!strcmp(row.name, "sysreg-unnamed-00000002") && row.width_bits == 64);
+    }
+    if (index == fixed + 1) {
+        assert(!strcmp(row.name, "sysreg-upper---name-00000007") && row.width_bits == 64);
+    }
+    if (!strncmp(row.name, "z", 1)) { assert(row.width_bits == input_cpu.sve_max_vq * 128); }
+    if ((!strncmp(row.name, "p", 1) && strcmp(row.name, "pc") && strcmp(row.name, "pstate")) ||
+        !strcmp(row.name, "ffr")) { assert(row.width_bits == input_cpu.sve_max_vq * 16); }
+}
+#define CHECK_ROW(index, row) check_row(index, row)
+static void check_bad_keys(CrucibleCPURegisterGeometry geometry,
+                           CrucibleCPURegisterKeyView view)
+{
+    CrucibleCPURegisterKeyView bad = view, untouched;
+    uint32_t copied[32];
+    union {
+        CrucibleCPURegisterKeyView view;
+        uint32_t keys[32];
+    } alias;
+    unsigned char alias_before[sizeof(alias)];
+
+    memset(&alias, 0xa5, sizeof(alias));
+    memcpy(alias_before, &alias, sizeof(alias));
+    assert(!KEYS(cs, alias.keys, G_N_ELEMENTS(alias.keys), &alias.view));
+    assert(!memcmp(alias_before, &alias, sizeof(alias)));
+    memcpy(copied, view.keys, view.count * sizeof(*copied));
+    bad.keys = copied;
+    copied[1] = copied[0];
+    assert(!DESCRIBE(cs, 0, &geometry, &bad, &buffers, &result));
+    unchanged();
+    copied[1] = view.keys[2];
+    copied[2] = view.keys[1];
+    assert(!DESCRIBE(cs, 0, &geometry, &bad, &buffers, &result));
+    unchanged();
+    copied[1] = 999;
+    assert(!DESCRIBE(cs, 0, &geometry, &bad, &buffers, &result));
+    unchanged();
+    rows[0].type |= ARM_CP_NO_RAW;
+    assert(!DESCRIBE(cs, 0, &geometry, &view, &buffers, &result));
+    unchanged();
+    rows[0].type &= ~ARM_CP_NO_RAW;
+    /* Same count/geometry, changed actual eligible membership. */
+    g_hash_table_steal(input_cpu.cp_regs, GUINT_TO_POINTER(7));
+    g_hash_table_insert(input_cpu.cp_regs, GUINT_TO_POINTER(8), &rows[0]);
+    assert(!DESCRIBE(cs, 0, &geometry, &view, &buffers, &result));
+    unchanged();
+    g_hash_table_steal(input_cpu.cp_regs, GUINT_TO_POINTER(8));
+    g_hash_table_insert(input_cpu.cp_regs, GUINT_TO_POINTER(7), &rows[0]);
+    memset(copied, 0xa5, sizeof(copied));
+    memset(&bad, 0xa5, sizeof(bad));
+    untouched = bad;
+    assert(!KEYS(cs, copied, view.count - 1, &bad));
+    assert(!memcmp(&bad, &untouched, sizeof(bad)));
+    for (size_t index = 0; index < G_N_ELEMENTS(copied); index++) {
+        assert(copied[index] == UINT32_C(0xa5a5a5a5));
+    }
+}
+#define CHECK_BAD_KEYS(geometry, view) check_bad_keys(geometry, view)
+int main(void)
+{
+    check_checked_geometry();
+    input_cpu.cp_regs = g_hash_table_new(g_direct_hash, g_direct_equal);
+    unsigned keys[] = { 7, 2, 19, 4, 5, 6 };
+    for (size_t index = 0; index < G_N_ELEMENTS(rows); index++) {
+        g_hash_table_insert(input_cpu.cp_regs, GUINT_TO_POINTER(keys[index]), &rows[index]);
+    }
+    for (unsigned features = 0; features < 4; features++) {
+        input_cpu.env.features =
+            (features & 1 ? UINT64_C(1) << ARM_FEATURE_EL2 : 0) |
+            (features & 2 ? UINT64_C(1) << ARM_FEATURE_EL3 : 0);
+        for (unsigned sve = 0; sve < 3; sve++) {
+            saved_sve = sve != 0;
+            FIELD_DP64_IDREG(&input_cpu.isar, ID_AA64PFR0, SVE, saved_sve);
+            input_cpu.sve_max_vq = sve == 2 ? 16 : sve;
+            check_image(73 + (features & 1 ? 2 : 0) + (features & 2 ? 2 : 0) +
+                        (sve ? 49 : 0), 3);
+        }
+    }
+    g_hash_table_unref(input_cpu.cp_regs);
+    puts("PASS actual AArch64 geometry, caller-buffer writers, eligibility, order, EL/SVE widths and legacy ownership; no issuer");
+    return 0;
+}
+"""
+
+X86_INPUTS = r"""
+static X86CPU input_cpu;
+static CPUState *cs = &input_cpu.parent_obj;
+#undef X86_CPU
+#define X86_CPU(cpu) (&input_cpu)
+#define GEOMETRY x86_crucible_register_geometry
+#define KEYS x86_crucible_register_keys_into
+#define DESCRIBE x86_crucible_register_describe_into
+#define ALLOCATING x86_crucible_register_describe
+#define CHECK_KEY_ORDER(view) assert((view).keys == NULL && (view).count == 0)
+#define CHANGE_GEOMETRY() (input_cpu.env.features[FEAT_1_ECX] ^= CPUID_EXT_AVX)
+#define RESTORE_GEOMETRY() CHANGE_GEOMETRY()
+static void check_row(size_t index, CrucibleCPURegisterCapability row)
+{
+    if (index == 0) { assert(!strcmp(row.name, "rax") && row.width_bits == 64); }
+    if (index == 57) { assert(!strcmp(row.name, "st0") && row.width_bits == 80); }
+    if (!strncmp(row.name, "xmm", 3)) { assert(row.width_bits == 128); }
+    if (!strncmp(row.name, "ymm", 3)) { assert(row.width_bits == 128); }
+    if (!strncmp(row.name, "zmm", 3)) {
+        assert(row.width_bits == (strstr(row.name, "upper") ? 256 : 512));
+    }
+}
+#define CHECK_ROW(index, row) check_row(index, row)
+#define CHECK_BAD_KEYS(geometry, view) do { \
+    CrucibleCPURegisterKeyView bad = (view); \
+    bad.keys = key_storage; \
+    assert(!DESCRIBE(cs, 0, &(geometry), &bad, &buffers, &result)); \
+    unchanged(); \
+} while (0)
+int main(void)
+{
+    check_checked_geometry();
+    input_cpu.phys_bits = 48;
+    for (unsigned features = 0; features < 128; features++) {
+        input_cpu.env.features[FEAT_1_EDX] =
+            (features & 1 ? CPUID_SEP : 0) | (features & 2 ? CPUID_PAT : 0);
+        input_cpu.env.features[FEAT_8000_0001_EDX] =
+            (features & 4 ? CPUID_EXT2_SYSCALL : 0) | (features & 8 ? CPUID_EXT2_RDTSCP : 0);
+        input_cpu.env.features[FEAT_1_ECX] = features & 16 ? CPUID_EXT_AVX : 0;
+        input_cpu.env.features[FEAT_7_0_EBX] = features & 32 ? CPUID_7_0_EBX_AVX512F : 0;
+        input_cpu.env.features[FEAT_7_0_ECX] = features & 64 ? CPUID_7_0_ECX_PKU : 0;
+        check_image(96 + (features & 1 ? 3 : 0) + (features & 2 ? 1 : 0) +
+                    (features & 4 ? 4 : 0) + (features & 8 ? 1 : 0) +
+                    (features & 16 ? 16 : 0) + (features & 32 ? 40 : 0) +
+                    (features & 64 ? 1 : 0), 0);
+    }
+    puts("PASS actual x86 geometry, caller-buffer writers, feature widths and legacy ownership; no issuer");
+    return 0;
+}
+"""
+
+
+def translation_unit(source, architecture):
+    body = (source / f"target/{architecture}/crucible-register.c").read_text()
+    prefix = body[body.index("#define CRUCIBLE_REG_GROUP_GPR"):
+                  body.index("static int a64_crucible_width(" if architecture == "arm"
+                             else "static int x86_crucible_exact_length(")]
+    helper = (source / "include/hw/core/crucible-register-helpers.h").read_text()
+    headers = ('#define COMPILING_PER_TARGET\n'
+               '#define CONFIG_TARGET "x86_64-softmmu-config-target.h"\n'
+               if architecture == "i386" else "")
+    headers += '#include "qemu/osdep.h"\n#include <assert.h>\n#define CPU_DEFS_H\n'
+    headers += f'#include "target/{architecture}/cpu.h"\n'
+    if architecture == "arm":
+        headers += '#include "target/arm/cpregs.h"\n#include "target/arm/internals.h"\n'
+    inputs = ARM_INPUTS if architecture == "arm" else X86_INPUTS
+    if architecture == "arm":
+        extract = runpy.run_path(str(source / "tests/unit/extract-crucible-startup-source-controls.py"))
+        lookup = extract["function"](
+            (source / "target/arm/helper.c").read_text(),
+            "const ARMCPRegInfo *get_arm_cp_reginfo(")
+        inputs = inputs.replace("__ACTUAL_CPREG_LOOKUP__", lookup)
+    # Helpers used by architecture-specific checks are defined after the literal
+    # producer; the common checker calls their prototypes, then their bodies.
+    split = inputs.index("static void check_row") if architecture == "i386" else inputs.index("static void check_key_order")
+    declarations, checks = inputs[:split], inputs[split:]
+    declarations += '\nstatic void unchanged(void);\n'
+    declarations += 'static void check_row(size_t, CrucibleCPURegisterCapability);\n'
+    if architecture == "arm":
+        declarations += 'static void check_key_order(CrucibleCPURegisterKeyView);\n'
+        declarations += 'static void check_bad_keys(CrucibleCPURegisterGeometry, CrucibleCPURegisterKeyView);\n'
+        declarations += '#define CHECK_KEY_ORDER(view) check_key_order(view)\n'
+        declarations += '#define CHECK_ROW(index, row) check_row(index, row)\n'
+        declarations += '#define CHECK_BAD_KEYS(geometry, view) check_bad_keys(geometry, view)\n'
+    else:
+        # Preserve the multi-line CHECK_BAD_KEYS definition before common use.
+        macro_start = checks.index("#define CHECK_BAD_KEYS")
+        macro_end = checks.index("int main(void)")
