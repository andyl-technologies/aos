+    crucible_hot_fork_qmp_child_reinitializer;
+static QemuChrSocketHotForkChildBasis crucible_hot_fork_console_child_basis;
+static QemuCrucibleHotForkConsoleChildResourcePlan
+    crucible_hot_fork_console_child_resources;
+static QemuCrucibleHotForkConsoleChildReinitializer
+    crucible_hot_fork_console_child_reinitializer;
+static QemuCrucibleHotForkChildResourcePlan
+    crucible_hot_fork_child_resource_plan;
+static bool crucible_hot_fork_operation_active;
+static bool crucible_hot_fork_child_active;
+
+CrucibleHotForkRamState *qmp_crucible_hot_fork_child_ram(
+    CrucibleHotForkRamAction action,
+    const char *plan_fdname, const char *control_fdname,
+    const char *source_fdname, const char *spill_fdname,
+    bool has_template_generation,
+    uint64_t template_generation, bool has_process_contract_generation,
+    uint64_t process_contract_generation, bool has_generation,
+    uint64_t generation, Error **errp)
+{
+    const bool has_plan_fdname = plan_fdname != NULL;
+    const bool has_control_fdname = control_fdname != NULL;
+    const bool has_source_fdname = source_fdname != NULL;
+    const bool has_spill_fdname = spill_fdname != NULL;
+    const QemuCrucibleRamForkStage *stage;
+    CrucibleHotForkRamState *report = NULL;
+    int plan_fd = -1;
+    int control_fd = -1;
+    int source_fd = -1;
+    int spill_fd = -1;
+    int result = 0;
+
+    g_mutex_lock(&crucible_hot_fork_template_lock);
+    if (crucible_hot_fork_operation_active) {
+        error_setg(errp, "RAM child authority is owned by an active fork");
+        goto out;
+    }
+    switch (action) {
+    case CRUCIBLE_HOT_FORK_RAM_ACTION_STAGE:
+        if (!has_plan_fdname || !has_control_fdname || !has_spill_fdname ||
+            !has_template_generation || !has_process_contract_generation ||
+            has_generation || !plan_fdname || !control_fdname ||
+            !strcmp(spill_fdname, plan_fdname) ||
+            !strcmp(spill_fdname, control_fdname) ||
+            (source_fdname && !strcmp(spill_fdname, source_fdname)) ||
+            !strcmp(plan_fdname, control_fdname) ||
+            (has_source_fdname && (!source_fdname ||
+                !strcmp(source_fdname, plan_fdname) ||
+                !strcmp(source_fdname, control_fdname))) ||
+            template_generation != crucible_hot_fork_template_generation ||
+            !crucible_hot_fork_child_process_contract_stage.staged ||
+            crucible_hot_fork_child_process_contract_stage.consumed ||
+            process_contract_generation !=
+                crucible_hot_fork_child_process_contract_stage.generation) {
+            error_setg(errp, "RAM child plan lacks its exact retained contract");
+            goto out;
+        }
+        plan_fd = monitor_dup_fd(monitor_cur(), plan_fdname, errp);
+        if (plan_fd < 0) {
+            goto out;
+        }
+        control_fd = monitor_dup_fd(monitor_cur(), control_fdname, errp);
+        if (control_fd < 0) {
+            goto out;
+        }
+        if (has_source_fdname) {
+            source_fd = monitor_dup_fd(monitor_cur(), source_fdname, errp);
+            if (source_fd < 0) {
+                goto out;
+            }
+        }
+        spill_fd = monitor_dup_fd(monitor_cur(), spill_fdname, errp);
+        if (spill_fd < 0) {
+            goto out;
+        }
+        result = qemu_crucible_ram_fork_stage(
+            plan_fd, control_fd, source_fd, spill_fd,
+            crucible_hot_fork_child_process_contract_stage.cancellation_fd,
+            template_generation, process_contract_generation, &generation);
+        break;
+    case CRUCIBLE_HOT_FORK_RAM_ACTION_QUERY:
+        if (has_plan_fdname || has_control_fdname || has_source_fdname || has_spill_fdname ||
+            has_template_generation || has_process_contract_generation ||
+            has_generation) {
+            error_setg(errp, "RAM child query has unexpected stage fields");
+            goto out;
+        }
+        break;
+    case CRUCIBLE_HOT_FORK_RAM_ACTION_RELEASE:
+        if (!has_generation || has_plan_fdname || has_control_fdname ||
+            has_source_fdname || has_spill_fdname || has_template_generation ||
+            has_process_contract_generation) {
+            error_setg(errp, "RAM child release requires its exact generation");
+            goto out;
+        }
+        result = qemu_crucible_ram_fork_stage_release(generation);
+        break;
+    default:
+        result = -EINVAL;
+    }
+    if (result) {
+        error_setg_errno(errp, result < 0 ? -result : EIO,
+                         "Could not retain independent child RAM authority");
+        goto out;
+    }
+    stage = qemu_crucible_ram_fork_stage_query();
+    report = g_new0(CrucibleHotForkRamState, 1);
+    report->schema_version = 1;
+    report->generation = stage->generation;
+    report->template_generation = stage->template_generation;
+    report->process_contract_generation = stage->process_contract_generation;
+    report->staged = stage->plan != NULL;
+    report->consumed = stage->consumed;
+    report->source_bound = stage->source_fd >= 0;
+out:
+    if (spill_fd >= 0) {
+        close(spill_fd);
+    }
+    if (source_fd >= 0) {
+        close(source_fd);
+    }
+    if (control_fd >= 0) {
+        close(control_fd);
+    }
+    if (plan_fd >= 0) {
+        close(plan_fd);
+    }
+    g_mutex_unlock(&crucible_hot_fork_template_lock);
+    return report;
+}
+
+typedef struct CrucibleHotForkOperation {
+    uint64_t template_generation;
+    uint64_t private_ring_generation;
+    uint64_t diagnostic_generation;
+    uint64_t qmp_generation;
+    uint64_t console_generation;
+    uint64_t monitor_generation;
+    uint64_t plugin_endpoint_generation;
+    uint64_t plugin_barrier_generation;
+    uint64_t rcu_barrier_generation;
+    uint64_t async_worker_barrier_generation;
+    uint64_t block_barrier_generation;
+    uint64_t parent_process_generation;
+    uint64_t child_process_generation;
+    uint64_t child_process_contract_generation;
+    uint64_t child_files_generation;
+    int child_process_cgroup_fd;
+    int child_process_cgroup_procs_fd;
+    int child_process_cancellation_fd;
+    uint64_t maximum_file_bytes;
+    uint64_t maximum_locked_bytes;
+    QemuBlockHotForkChildFiles *child_files;
+    QemuCrucibleHotForkParentIdentity parent_identity;
+    QemuCrucibleHotForkRuntimeTransaction runtime;
+    QemuCrucibleHotForkPluginChildResourcePlan plugin_resources;
+    QemuCrucibleHotForkDiagnosticsChildResourcePlan diagnostics_resources;
+    QemuCrucibleHotForkQmpChildResourcePlan qmp_resources;
+    QemuCrucibleHotForkConsoleChildResourcePlan console_resources;
+    QemuCrucibleHotForkPluginChildReinitializer plugin_reinitializer;
+    QemuCrucibleHotForkQmpChildReinitializer qmp_reinitializer;
+    QemuCrucibleHotForkConsoleChildReinitializer console_reinitializer;
+    MonitorHotForkChildBasis monitor_basis;
+    QemuChrSocketHotForkChildBasis console_basis;
+    int excluded_fds[QEMU_CRUCIBLE_HOT_FORK_MAX_RETAINED_DESCRIPTORS];
+    size_t excluded_fd_count;
+    bool prepared;
+    /* Static description of the first basis that blocked preparation. */
+    const char *blocker;
+    /* Owned until the dispatching QMP caller formats the refusal. */
+    Error *child_files_error;
+    /*
+     * The dispatching monitor thread verified the child monitor basis before
+     * submitting this operation.  It holds its recursive parser lock while
+     * it waits, so the main loop cannot observe that monitor as stable; the
+     * inventory is frozen for the same reason.
+     */
+    bool monitor_basis_verified;
+} CrucibleHotForkOperation;
+
+/*
+ * This exact callback and opaque basis are retained before fork. The child
+ * resource transaction therefore cannot substitute a different monitor
+ * implementation after descriptor mutation has begun.
+ */
+/*
+ * Written to the child's stderr, already routed to its branch-private
+ * diagnostics stream, so the host learns which QMP reconstruction stage
+ * failed and how far the basis got; the exit status names only the step.
+ */
+static void crucible_hot_fork_qmp_child_report(
+    const MonitorHotForkChildBasis *basis, const char *stage, int result)
+{
+    fprintf(stderr,
+            "crucible hot-fork qmp child %s failed: result %d attempted %d "
+            "disposed %d dispatcher %d iothread %d parser %d capabilities "
+            "%d input-held %d greeted %d socket(attempted %d disposed %d "
+            "attached %d input-held %d)\n",
+            stage, result, basis->attempted,
+            basis->inherited_protocol_disposed, basis->dispatcher_rebuilt,
+            basis->iothread_rebuilt, basis->parser_reset,
+            basis->capabilities_reset, basis->input_held,
+            basis->greeting_emitted, basis->socket.attempted,
+            basis->socket.inherited_disposed,
+            basis->socket.replacement_attached, basis->socket.input_held);
+}
+
+static int crucible_hot_fork_reinitialize_child_qmp(
+    int retained_fd, uint64_t socket_cookie, uint64_t template_generation,
+    uint64_t qmp_generation, uint64_t monitor_generation,
+    QemuCrucibleHotForkQmpChildStatus *status, void *opaque)
+{
+    MonitorHotForkChildBasis *basis = opaque;
+    int result;
+
+    if (!status || !basis) {
+        return -EINVAL;
+    }
+    if (!crucible_hot_fork_qmp_stage.staged ||
+        retained_fd != crucible_hot_fork_qmp_stage.fd ||
+        socket_cookie != crucible_hot_fork_qmp_stage.socket_cookie ||
+        template_generation !=
+            crucible_hot_fork_qmp_stage.template_generation ||
+        qmp_generation != crucible_hot_fork_qmp_stage.generation ||
+        monitor_generation !=
+            crucible_hot_fork_qmp_stage.monitor_generation ||
+        !monitor_hot_fork_child_basis_prepared_for(
+            basis, monitor_generation)) {
+        return -ESTALE;
+    }
+
+    result = monitor_hot_fork_reconstruct_child_protocol_held(
+        basis, retained_fd, socket_cookie);
+    if (result != 0) {
+        crucible_hot_fork_qmp_child_report(basis, "reconstruct", result);
+        return result;
+    }
+    result = monitor_hot_fork_greet_child_protocol_held(basis);
+    if (result != 0) {
+        crucible_hot_fork_qmp_child_report(basis, "greet", result);
+        return result;
+    }
+    if (!basis->attempted || !basis->inherited_protocol_disposed ||
+        !basis->dispatcher_rebuilt || !basis->iothread_rebuilt ||
+        !basis->parser_reset || !basis->capabilities_reset ||
+        !basis->input_held || !basis->greeting_emitted ||
+        basis->input_released || !basis->socket.inherited_disposed ||
+        !basis->socket.replacement_attached || !basis->socket.input_held) {
+        return -EPROTO;
+    }
+
+    *status = (QemuCrucibleHotForkQmpChildStatus) {
+        .schema_version =
+            QEMU_CRUCIBLE_HOT_FORK_QMP_CHILD_REINITIALIZER_VERSION,
+        .struct_size = sizeof(*status),
+        .template_generation = template_generation,
+        .qmp_generation = qmp_generation,
+        .monitor_generation = monitor_generation,
+        .socket_cookie = socket_cookie,
+        .retained_fd = retained_fd,
+        .flags = QEMU_CRUCIBLE_HOT_FORK_QMP_CHILD_FLAGS_COMPLETE,
+        .monitor_count = 1,
+    };
+    return 0;
+}
+
+static int crucible_hot_fork_reinitialize_child_console(
+    int retained_fd, uint64_t socket_cookie, uint64_t template_generation,
+    uint64_t console_generation,
+    QemuCrucibleHotForkConsoleChildStatus *status, void *opaque)
+{
+    QemuChrSocketHotForkChildBasis *basis = opaque;
+    int result;
+
+    /*
+     * The console chardev runs on GLib's default main context, which the
+     * basis records as NULL; the child's main thread, the continuation of
+     * the forking thread, still owns that context.  Only the staged
+     * identity and the bound objects are required here.
+     */
+    if (!status || !basis || !crucible_hot_fork_console_stage.staged ||
+        retained_fd != crucible_hot_fork_console_stage.fd ||
+        socket_cookie != crucible_hot_fork_console_stage.socket_cookie ||
+        template_generation !=
+            crucible_hot_fork_console_stage.template_generation ||
+        console_generation != crucible_hot_fork_console_stage.generation ||
+        !basis->prepared || !basis->chardev || !basis->frontend) {
+        /* Written to the child's diagnostics stream, like the QMP stages. */
+        fprintf(stderr,
+                "crucible hot-fork console child basis is stale: staged %d "
+                "fd %d/%d cookie-match %d template-generation-match %d "
+                "generation-match %d prepared %d chardev %d frontend %d\n",
+                crucible_hot_fork_console_stage.staged, retained_fd,
+                crucible_hot_fork_console_stage.fd,
+                socket_cookie == crucible_hot_fork_console_stage.socket_cookie,
+                template_generation ==
+                    crucible_hot_fork_console_stage.template_generation,
+                console_generation ==
+                    crucible_hot_fork_console_stage.generation,
+                basis ? basis->prepared : 0,
+                basis ? basis->chardev != NULL : 0,
+                basis ? basis->frontend != NULL : 0);
+        return -ESTALE;
+    }
+
+    result = qemu_chr_socket_hot_fork_reconstruct_child_held(
+        basis, retained_fd, socket_cookie);
+    if (result != 0) {
+        fprintf(stderr, "crucible hot-fork console child reconstruct "
+                "failed: result %d\n", result);
+        return result;
+    }
+    result = qemu_chr_socket_hot_fork_release_child_input(
+        basis, basis->context);
+    if (result != 0 || !basis->attempted || !basis->inherited_disposed ||
+        !basis->replacement_attached || basis->input_held) {
+        fprintf(stderr, "crucible hot-fork console child release failed: "
+                "result %d attempted %d disposed %d attached %d "
+                "input-held %d\n", result, basis->attempted,
+                basis->inherited_disposed, basis->replacement_attached,
+                basis->input_held);
+        return result != 0 ? result : -EPROTO;
+    }
+
+    *status = (QemuCrucibleHotForkConsoleChildStatus) {
+        .schema_version =
+            QEMU_CRUCIBLE_HOT_FORK_CONSOLE_CHILD_REINITIALIZER_VERSION,
+        .struct_size = sizeof(*status),
+        .template_generation = template_generation,
+        .console_generation = console_generation,
+        .socket_cookie = socket_cookie,
+        .retained_fd = retained_fd,
+        .flags = QEMU_CRUCIBLE_HOT_FORK_CONSOLE_CHILD_FLAGS_COMPLETE,
+    };
+    return 0;
+}
