+    g_assert_false(npcm_clk_project_ref_to_ns(&ref_ns, &phase_ps));
+    g_assert_cmpint(ref_ns, ==, 0);
+    g_assert_cmpuint(phase_ps, ==, PICOSECONDS_PER_NANOSECOND);
