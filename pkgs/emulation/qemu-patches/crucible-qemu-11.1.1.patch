+static QemuCrucibleFingerprintMainExecution fingerprint_main_execution;
+
+static void fingerprint_main_ready_dispatch(
+    QemuCrucibleFingerprintMainReadyFrame *frame,
+    int poll_result, int64_t timeout_ns);
+
+static int fingerprint_main_creator_current(void)
+{
+    QemuCrucibleHotForkCoordinator *coordinator = &crucible_hot_fork_coordinator;
+
+    /* This record was published by the real main-loop initialization call,
+     * before configured CPU construction. It is creator provenance only. */
+    return qatomic_load_acquire(&coordinator->initialized) &&
+        coordinator->process_id == getpid() &&
+        coordinator->main_thread_id == qemu_get_thread_id() &&
+        !qatomic_load_acquire(&coordinator->child_runtime_pending) &&
+        !current_cpu && !qemu_in_coroutine() ? 0 : -EPERM;
+}
+
+static int fingerprint_main_watcher_current(
+    QemuCrucibleFingerprintMainExecution *execution)
+{
+    QemuCrucibleFingerprintWakeWatcher *watcher;
+    QemuCrucibleFingerprintWakeKeeper *keeper;
+    uint64_t registration_serial;
+    int fd;
+    int status = qemu_plugin_crucible_installed_wake_watcher_borrow_v1(
+        &watcher, &fd, &registration_serial, &keeper);
+
+    if (status) {
+        return status;
