+static int fingerprint_root_observe(
+    qemu_plugin_crucible_ram_root_observer_v2 observer, uint32_t scope,
+    uint8_t root[32], uint64_t *logical_bytes)
+{
+    int first, post = 0, status, ended = 0, writer_return = 0;
+
+    if (!qemu_crucible_startup_source_fingerprint_enrollment_required_v1()) {
+        return observer(scope, 0, root, logical_bytes, NULL);
+    }
+    if (fingerprint_root_frame.active || fingerprint_root_frame.serial == UINT64_MAX) {
+        return -EBUSY;
+    }
+    if (logical_capture->active && logical_capture->source_claim) {
+        qemu_plugin_crucible_logical_capture_v1 *selector = NULL;
+        qemu_plugin_id_t id;
+
+        if (current_cpu) {
+            return -EBUSY;
+        }
+        first = qemu_crucible_startup_source_fingerprint_root_creator_v1(&id);
+        if (!first) {
+            first = qemu_plugin_crucible_ram_logical_capture_return_v1(id, &selector);
+        }
+        if (first || logical_capture->source_claim) {
+            return first ? first : -EBUSY;
+        }
+    }
+    if (fingerprint_root_writer) {
+        first = qemu_crucible_observation_writer_creator_current_v1(fingerprint_root_writer);
+        if (first) {
+            /* A retained foreign CPU gate is contained to its genuine creator;
+             * Main never relabels it or calls creator-only physical return. */
+            return first;
+        }
+        first = qemu_crucible_observation_writer_return_v1(&fingerprint_root_writer);
+        fingerprint_root_outcome.writer_return_status = first;
+        if (first || fingerprint_root_writer) {
+            return first ? first : -EBUSY;
+        }
+    }
+    first = fingerprint_root_background_return();
+    if (first) {
+        return first;
+    }
+    first = fingerprint_root_return_old_borrow();
+    if (first) {
+        return first;
+    }
+    if (fingerprint_root_operation) {
+        if (current_cpu) {
+            /* CPU/RR never invokes Main-only module cleanup. */
+            return -EBUSY;
+        }
+        first = fingerprint_root_return_old_module_view();
+        if (first) {
+            return first;
+        }
+        first = qemu_crucible_startup_source_fingerprint_operation_end_v1(
+            &fingerprint_root_operation);
+        fingerprint_root_outcome.old_return_status = first;
+        fingerprint_root_outcome.owner_retained = fingerprint_root_operation != NULL;
+        if (first || fingerprint_root_operation) {
+            return first ? first : -EBUSY;
+        }
+    }
+    first = fingerprint_root_cleanup_cpu_end();
+    if (first) {
+        return first;
+    }
+    if (fingerprint_root_execution) {
+        /* A passive old CPU receipt cannot be overwritten by a new Root. */
+        return -EBUSY;
+    }
+    if (logical_capture->active && !logical_capture->source_claim &&
+        !logical_capture->progress.borrowed && !logical_capture->progress.published) {
+        /* All genuine old owners have physically returned. This retires only
+         * native custody; it cannot accept a view or acknowledge dirty bits. */
+        logical_capture->outer_owner_retained = false;
+        logical_capture->writer_owner_retained = false;
+        if (fingerprint_publication.borrowed && !fingerprint_publication.observed.settled) {
+            struct qemu_plugin_crucible_logical_publication_status_v1 saved =
+                fingerprint_publication.observed;
