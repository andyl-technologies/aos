+#ifndef QEMU_CRUCIBLE_HOT_FORK_ASYNC_H
+#define QEMU_CRUCIBLE_HOT_FORK_ASYNC_H
+
+#include "qemu/crucible-park-census.h"
+
+typedef enum QemuAsyncWorkerHotForkBarrierOperation {
+    QEMU_ASYNC_WORKER_HOT_FORK_BARRIER_HOLD,
+    QEMU_ASYNC_WORKER_HOT_FORK_BARRIER_QUERY,
+    QEMU_ASYNC_WORKER_HOT_FORK_BARRIER_RELEASE,
+} QemuAsyncWorkerHotForkBarrierOperation;
+
+typedef struct QemuAsyncWorkerHotForkBarrierInventory {
+    uint64_t generation;
+    int64_t owner_thread_id;
+    uint64_t admissions_in_flight;
+    uint64_t bottom_half_count;
+    uint64_t pending_bottom_halves;
+    uint64_t scheduled_bottom_halves;
+    uint64_t active_bottom_half_callbacks;
+    uint64_t pending_timers;
+    uint64_t active_timer_callbacks;
+    uint64_t aio_context_count;
+    uint64_t active_aio_polls;
+    uint64_t active_aio_dispatches;
+    uint64_t queued_coroutines;
+    uint64_t aio_handler_count;
+    uint64_t active_aio_handler_callbacks;
+    bool held;
+    bool bottom_halves_complete;
+    bool timers_complete;
+    bool aio_contexts_complete;
+    bool aio_handlers_complete;
+    bool complete;
+    bool quiescent;
+} QemuAsyncWorkerHotForkBarrierInventory;
+
+/*
+ * Linear owner of one exact retained template barrier across fork().
+ *
+ * The source-process terminal action verifies but does not release the
+ * reusable template barrier.  The immediate-child terminal action verifies
+ * the copied generation and releases it before reconstructed event-loop work
+ * is allowed to run.  Only one transaction may be active in each process
+ * incarnation.
+ */
+typedef struct QemuAsyncWorkerHotForkRetainedTransaction {
+    uint64_t barrier_generation;
+    int64_t barrier_owner_thread_id;
+    int64_t parent_process_id;
+    int64_t parent_thread_id;
+    bool active;
+    bool child_released;
+} QemuAsyncWorkerHotForkRetainedTransaction;
+
+/*
+ * Gate AioContext polling and dispatch, AioHandler lifecycle and callbacks,
+ * coroutine scheduling and entry, and asynchronous-worker mutation while
+ * a hot-fork transaction is retained.  Blocking admission is for producers;
+ * try admission is for the GLib event loop, which parks already-queued work
+ * rather than blocking OOB QMP.  Nested work remains inside the outer
+ * admission that caused it.
+ */
+void qemu_async_worker_hot_fork_admission_begin(void);
+bool qemu_async_worker_hot_fork_admission_try_begin(void);
+void qemu_async_worker_hot_fork_admission_end(void);
+int qemu_async_worker_hot_fork_census(
+    QemuAsyncWorkerHotForkBarrierOperation operation,
+    QemuCrucibleParkCensus *out);
+
+void qemu_async_worker_hot_fork_barrier_capture(
+    QemuCrucibleNativeParkCapture *capture,
+    QemuAsyncWorkerHotForkBarrierOperation operation,
+    QemuAsyncWorkerHotForkBarrierInventory *inventory);
+
+void qemu_async_worker_hot_fork_barrier(
+    QemuAsyncWorkerHotForkBarrierOperation operation,
+    QemuAsyncWorkerHotForkBarrierInventory *inventory);
+int qemu_async_worker_hot_fork_begin_retained_transaction(
+    QemuAsyncWorkerHotForkRetainedTransaction *transaction,
+    uint64_t expected_barrier_generation);
+int qemu_async_worker_hot_fork_release_parent_retained_transaction(
+    QemuAsyncWorkerHotForkRetainedTransaction *transaction);
+int qemu_async_worker_hot_fork_release_child_retained_transaction(
+    QemuAsyncWorkerHotForkRetainedTransaction *transaction);
+
+#endif
