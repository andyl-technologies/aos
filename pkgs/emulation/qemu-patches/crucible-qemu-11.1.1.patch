diff --git a/system/crucible-preexec-ram.inc.h b/system/crucible-preexec-ram.inc.h
new file mode 100644
index 0000000000000000000000000000000000000000..e1eda5efbd1c2db8ce485fce38f76bbe3d8e26ab
--- /dev/null
+++ b/system/crucible-preexec-ram.inc.h
@@ -0,0 +1,144 @@
+/*
+ * Genuine retained inherited RAM endpoint under the selected preexec issuer
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Included once in preexec-setup.c; no numeric FD setter or descriptor birth.
+ */
+
+static int preexec_ram_endpoint_observe(QemuCruciblePreexecSetupOwner *owner,
+                                       uint64_t *device, uint64_t *inode,
+                                       uint64_t *cookie)
+{
+    struct stat identity;
+    struct {
+        int process;
+        uint32_t user;
+        uint32_t group;
+    } peer;
+    uint64_t observed_cookie;
+    socklen_t length;
+    int value;
+    long status;
+
+    status = preexec_setup_syscall5(SYS_fstat, QEMU_CRUCIBLE_PREEXEC_RAM_CONTROL_FD,
+        (long)(uintptr_t)&identity, 0, 0, 0);
+    if (status < 0) {
+        return (int)status;
+    }
+    if (!S_ISSOCK(identity.st_mode)) {
+        return -EPROTOTYPE;
+    }
+    if ((uint64_t)identity.st_dev == (uint64_t)owner->control_identity.st_dev &&
+        (uint64_t)identity.st_ino == (uint64_t)owner->control_identity.st_ino) {
+        return -EPERM;
+    }
+    length = sizeof(value);
+    status = preexec_setup_syscall5(SYS_getsockopt,
+        QEMU_CRUCIBLE_PREEXEC_RAM_CONTROL_FD, SOL_SOCKET, SO_DOMAIN,
+        (long)(uintptr_t)&value, (long)(uintptr_t)&length);
+    if (status < 0 || length != sizeof(value) || value != AF_UNIX) {
+        return status < 0 ? (int)status : -EPROTOTYPE;
+    }
+    length = sizeof(value);
+    status = preexec_setup_syscall5(SYS_getsockopt,
+        QEMU_CRUCIBLE_PREEXEC_RAM_CONTROL_FD, SOL_SOCKET, SO_TYPE,
+        (long)(uintptr_t)&value, (long)(uintptr_t)&length);
+    if (status < 0 || length != sizeof(value) || value != SOCK_STREAM) {
+        return status < 0 ? (int)status : -EPROTOTYPE;
+    }
+    length = sizeof(peer);
+    status = preexec_setup_syscall5(SYS_getsockopt,
+        QEMU_CRUCIBLE_PREEXEC_RAM_CONTROL_FD, SOL_SOCKET, SO_PEERCRED,
+        (long)(uintptr_t)&peer, (long)(uintptr_t)&length);
+    if (status < 0 || length != sizeof(peer)) {
+        return status < 0 ? (int)status : -EPROTO;
+    }
+    if (peer.process != owner->peer_process || peer.user != owner->peer_user ||
+        peer.group != owner->peer_group) {
+        return -EPERM;
+    }
+    length = sizeof(observed_cookie);
+    status = preexec_setup_syscall5(SYS_getsockopt,
+        QEMU_CRUCIBLE_PREEXEC_RAM_CONTROL_FD, SOL_SOCKET, SO_COOKIE,
+        (long)(uintptr_t)&observed_cookie, (long)(uintptr_t)&length);
+    if (status < 0 || length != sizeof(observed_cookie)) {
+        return status < 0 ? (int)status : -EPROTO;
+    }
+    *device = identity.st_dev;
+    *inode = identity.st_ino;
+    *cookie = observed_cookie;
+    return 0;
+}
+
+static int preexec_ram_endpoint_construct(QemuCruciblePreexecSetupOwner *owner)
+{
+    QemuCrucibleRamEndpointPurposeOwner *endpoint = &owner->ram_endpoint;
+    const QemuCrucibleProcessPurposeRecord *record = &owner->plan.purpose;
+    int status;
+
+    if (!record->ram_endpoint_present) {
+        return 0;
+    }
+    status = qemu_crucible_preexec_purpose_check_v3(owner);
+    if (status) {
+        return status;
+    }
+    if (endpoint->attempted) {
+        return -EALREADY;
+    }
+    /* Physical inherited9 was assigned before exec under this same containing
+     * original and disjoint share. Its fixed holder is included in the native
+     * singleton debit before this cut; no new alias/resource bank is born. */
+    endpoint->attempted = true;
+    endpoint->issuer = owner;
+    endpoint->process = owner->process_id;
+    endpoint->descriptor = QEMU_CRUCIBLE_PREEXEC_RAM_CONTROL_FD;
+    status = preexec_ram_endpoint_observe(owner, &endpoint->device,
+                                         &endpoint->inode, &endpoint->cookie);
+    if (!status && (endpoint->device != record->ram_socket_device ||
+                   endpoint->inode != record->ram_socket_inode ||
+                   endpoint->cookie != record->ram_socket_cookie ||
+                   record->ram_owner_generation != owner->incarnation.generation)) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        status = preexec_setup_original_live();
+    }
+    if (!status) {
+        endpoint->published = true;
+    }
+    return status;
+}
+
+int qemu_crucible_preexec_ram_endpoint_check_v1(
+    QemuCruciblePreexecPurposeOwner *held,
+    QemuCrucibleRamEndpointPurposeOwner *endpoint, int *descriptor)
+{
+    QemuCruciblePreexecSetupOwner *owner = &preexec_setup_owner;
+    uint64_t device, inode, cookie;
+    long process = preexec_setup_syscall5(SYS_getpid, 0, 0, 0, 0, 0);
+    int status;
+
+    if (held != owner || process != owner->process_id ||
+        endpoint != &owner->ram_endpoint || !descriptor) {
+        return -EPERM;
+    }
+    if (!owner->source_published || !owner->peer_validated ||
+        !owner->plan_validated || !owner->plan.purpose.ram_endpoint_present ||
+        !endpoint->published || endpoint->issuer != owner ||
+        endpoint->process != process ||
+        endpoint->descriptor != QEMU_CRUCIBLE_PREEXEC_RAM_CONTROL_FD) {
+        return -ENOKEY;
+    }
+    status = preexec_ram_endpoint_observe(owner, &device, &inode, &cookie);
+    if (!status && (device != endpoint->device || inode != endpoint->inode ||
+                   cookie != endpoint->cookie ||
+                   owner->incarnation.generation !=
+                       owner->plan.purpose.ram_owner_generation)) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        *descriptor = endpoint->descriptor;
+    }
+    return status;
+}
