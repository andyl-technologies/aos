+    if (!startup_owner() || !startup_source.scope_active ||
+        startup_source.current.ctx != ctx) {
+        return result;
+    }
+    if (qatomic_load_acquire(&startup_source.module_custody_published) &&
+        startup_source.acquisition_attempted &&
+        startup_source.saved.ctx == ctx) {
+        startup_source.install_returned = true;
+        startup_source.birth_closed = true;
+        if (install_status != 0) {
+            startup_failure(install_status < 0 ? install_status : -EPROTO);
+        } else if (!startup_source.registration_completed) {
+            startup_failure(-EPROTO);
+        }
+#ifdef CONFIG_LINUX
+        if (!install_status && startup_source.runtime_purpose.configured_attempted) {
+            int required = qemu_plugin_crucible_required_workers_current_v1(
+                startup_source.saved.plugin_id, &startup_source.runtime_purpose);
+
+            if (required) {
+                startup_failure(required);
+            }
+        }
+#endif
+        if (startup_source.first_negative_status != 0) {
+            result = startup_source.first_negative_status;
+        } else {
+            startup_source.phase = STARTUP_SOURCE_RETURNED;
+        }
+    }
+    startup_source.scope_active = false;
+    startup_source.current = (QemuCrucibleStartupInstallerBinding) { 0 };
+    return result;
+}
+
+bool qemu_plugin_crucible_startup_source_retained(void)
+{
+    return qatomic_load_acquire(&startup_source.custody_retained);
+}
+
+bool qemu_crucible_startup_source_retains_ctx(struct qemu_plugin_ctx *ctx)
+{
+    return qatomic_load_acquire(&startup_source.module_custody_published) &&
+        startup_source.saved.ctx == ctx;
+}
+
+bool qemu_crucible_startup_source_retains_id(qemu_plugin_id_t id)
+{
+    return qatomic_load_acquire(&startup_source.module_custody_published) &&
+        startup_source.saved.plugin_id == id;
+}
+
+bool qemu_crucible_startup_source_total_matches(uint64_t total)
+{
+    return !qatomic_load_acquire(&startup_source.total_pinned) ||
+        startup_source.original.original_total_bytes == total;
+}
+
+int qemu_crucible_startup_source_generation_check(uint64_t generation,
+                                                 bool child_rebind)
+{
+    if (!qemu_plugin_crucible_startup_source_retained()) {
+        return 0;
+    }
+    if (!startup_owner() ||
+        !startup_invocation(startup_source.saved.plugin_id)) {
+        return -EPERM;
+    }
+    if (startup_source.first_negative_status != 0) {
+        return startup_source.first_negative_status;
+    }
+    /* Initial custody cannot authorize a separately admitted child. */
+    if (child_rebind) {
+        return startup_failure(-EPERM);
+    }
+    if (!qatomic_load_acquire(&startup_source.total_pinned) ||
+        generation != startup_source.original.process_generation) {
+        return startup_failure(-ESTALE);
+    }
+    return 0;
+}
+
+uint64_t qemu_crucible_startup_source_metadata_bytes(void)
+{
+    uint64_t extent;
+    uint64_t ram_metadata;
+
+    if (!qemu_plugin_crucible_startup_source_retained()) {
+        return 0;
+    }
+    extent = sizeof(startup_source);
+    ram_metadata = qemu_crucible_ram_metadata_fixed_storage_bytes();
+
+    if (!ram_metadata || ram_metadata > UINT64_MAX - extent) {
+        return UINT64_MAX;
+    }
+    extent += ram_metadata;
+    if (!qatomic_load_acquire(&startup_source.process_purpose_complete)) {
+        return extent;
+    }
+    /* These actual selected prefix requests are already held in native_live.
+     * Reporting them excludes them from the later observer allowance once;
+     * it neither debits again nor reports region/dirty charges a second time.
+     * A maximal refusal sentinel forces the existing checked floor to fail. */
+    if (startup_source.preexec_native_extent > UINT64_MAX - extent) {
+        return UINT64_MAX;
+    }
+    extent += startup_source.preexec_native_extent;
+#ifdef CONFIG_LINUX
+    uint64_t cpu_allocations = cpu_allocation_metadata_bytes();
+
+    if (cpu_allocations > UINT64_MAX - extent) {
+        return UINT64_MAX;
+    }
+    extent += cpu_allocations;
+    if (startup_source.initial_register_workspace.charge.held) {
+        uint64_t workspace = startup_source.initial_register_workspace.charge.bytes;
+
+        /* This exact mapping already occupies native_live, including retained
+         * no-map or physically-returned-but-unretired attempts. Exclude it
+         * once from observer allowance, without a second debit or refund. */
+        if (workspace > UINT64_MAX - extent) {
+            return UINT64_MAX;
+        }
+        extent += workspace;
+    }
+#endif
+    if (startup_source.standing.construction_storage.fixed_charge.held) {
+        uint64_t construction = startup_source.standing.construction_storage.fixed_charge.bytes;
+
+        if (construction > UINT64_MAX - extent) {
+            return UINT64_MAX;
+        }
+        extent += construction;
+    }
+    for (size_t index = 0; index < 3; index++) {
+        uint64_t loader = startup_source.loader_admissions[index].charge.held ?
+            startup_source.loader_admissions[index].charge.bytes : 0;
+
+        if (loader > UINT64_MAX - extent) {
+            return UINT64_MAX;
+        }
+        extent += loader;
+    }
+    if (startup_source.monitor_purpose.fixed_charge.held) {
+        uint64_t monitor = startup_source.monitor_purpose.fixed_charge.bytes;
+
+        if (monitor > UINT64_MAX - extent) {
+            return UINT64_MAX;
+        }
+        extent += monitor;
+    }
+    if (startup_source.socket_ingress.fixed_charge.held) {
+        uint64_t ingress = startup_source.socket_ingress.fixed_charge.bytes;
+
+        if (ingress > UINT64_MAX - extent) {
+            return UINT64_MAX;
+        }
+        extent += ingress;
+    }
+    if (startup_source.socket_ingress.charge.held) {
+        uint64_t ingress = startup_source.socket_ingress.charge.bytes;
+
+        if (ingress > UINT64_MAX - extent) {
+            return UINT64_MAX;
+        }
+        extent += ingress;
+    }
+    return extent;
+}
+
+uint64_t qemu_crucible_startup_source_control_metadata_bytes(void)
+{
+    if (!qemu_plugin_crucible_startup_source_retained() ||
+        getpid() != startup_source.owner_process ||
+        !qatomic_load_acquire(
+            &startup_source.metadata_partition.controller_retained)) {
+        return 0;
+    }
+    return startup_source.metadata_partition.controller_extent;
+}
+
+/* This terminal observation grants no original or allocation ownership. */
+int qemu_crucible_startup_source_metadata_partition_status(void)
+{
+    int status;
+
+    if (!qemu_plugin_crucible_startup_source_retained()) {
+        return 0;
+    }
+    if (getpid() != startup_source.owner_process) {
+        return -EPERM;
+    }
+    if (!qatomic_load_acquire(
+            &startup_source.metadata_partition.controller_retained)) {
+        return 0;
+    }
+    if (startup_source.first_negative_status) {
+        return startup_source.first_negative_status;
+    }
+    status = qatomic_read(&startup_source.metadata_partition.first_status);
+    return status ? status :
+        qatomic_read(&startup_source.metadata_partition.post_status);
+}
+
+int qemu_crucible_startup_source_native_metadata_check(void)
+{
+    bool raw_creator;
+    bool runtime_actor;
+    int status;
+
+    if (!qemu_plugin_crucible_startup_source_retained()) {
+        return 0;
+    }
+    if (getpid() != startup_source.owner_process) {
+        return -EPERM;
+    }
+#ifndef _WIN32
+    status = qemu_descriptor_table_status();
+    if (status) {
+        return status;
+    }
+#endif
+    /* No selected operation exists before the controller publication. Read
+     * its immutable extent only after the matching acquire in other callers. */
+    if (!qatomic_load_acquire(
+            &startup_source.metadata_partition.controller_retained)) {
+        return 0;
+    }
+    /* Actor exclusion precedes Original selection. The raw creator can own
+     * pre-module construction; its identity must not select Setup first. */
+    raw_creator = native_metadata_raw_creator();
+    runtime_actor =
+        qatomic_load_acquire(&startup_source.module_custody_published) &&
+        bql_locked();
+    if (!raw_creator && !runtime_actor) {
+        return -EPERM;
+    }
+#ifdef CONFIG_LINUX
+    QemuCrucibleCheckpointInventoryMetadataBorrow *inventory =
+        &startup_source.checkpoint_inventory_metadata;
+
+    if (runtime_actor && qemu_in_main_thread() && !current_cpu &&
+        !qemu_in_coroutine() && inventory->held) {
+        /* Only the actual native region-inventory pin call can select this
+         * borrower. ENOENT is its definite outside-phase observation, never an
+         * expiry/failure bypass. Original80 current runs before any ledger cut. */
+        status = qemu_crucible_checkpoint_inventory_metadata_pin_current_v1(
+            inventory->loan);
+        if (!status) {
+            return qemu_crucible_startup_source_checkpoint_inventory_metadata_current_v1(
+                inventory);
+        }
+        if (status != -ENOENT) {
+            return status;
+        }
+    }
+    /* Runtime inventory/resources use the genuinely entered operation on the
+     * SAME ledger. Completed installing Setup is never replayed as its clock. */
+    if (bql_locked() && standing_construction_operation_identity()) {
+        status = qemu_crucible_startup_source_observation_construction_current_v1(
+            &startup_source.standing.construction);
+        return status ? status : crucible_metadata_partition_admission_status(
+            &startup_source.metadata_partition);
+    }
+    if (runtime_actor &&
+        standing_operation_identity(&startup_source.standing.operation)) {
+        status = standing_operation_current(&startup_source.standing.operation);
+        return status ? status : crucible_metadata_partition_admission_status(
+            &startup_source.metadata_partition);
+    }
+#endif
+    /* With no BQL the raw creator touched no mutable operation fields. With
+     * BQL, any genuine entered construction already returned its own result. */
+    if (raw_creator) {
+        int saved = crucible_metadata_partition_admission_status(
+            &startup_source.metadata_partition);
+
+        return saved ? saved : qemu_crucible_preexec_purpose_check_v3(
+            startup_source.preexec_purpose_owner);
+    }
+    /* Only runtime_actor reaches saved: module publication and BQL preceded
+     * every runtime probe, and neither replaces actual installer identity. */
+    if (!startup_invocation(startup_source.saved.plugin_id)) {
+        return -EPERM;
+    }
+    /* The completed installer original cannot issue later dynamic work.
+     * A genuine later allocation owner is a separate integration prerequisite. */
+    status = qemu_plugin_crucible_startup_source_check_v1(
+        startup_source.saved.plugin_id);
+    if (status) {
+        return status;
+    }
+    status = qemu_crucible_startup_source_metadata_partition_status();
+    if (status) {
+        return status;
+    }
+    if (startup_source.metadata_partition.process_extent) {
+        if (!qatomic_load_acquire(&startup_source.process_purpose_complete) ||
+            !startup_source.preexec_purpose_owner ||
+            !startup_source.process_contract_owner ||
+            !startup_source.incarnation_purpose_owner) {
+#ifdef CONFIG_LINUX
+            return startup_failure(-ENOKEY);
+#else
+            return startup_failure(-ENOTSUP);
+#endif
+        }
+#ifdef CONFIG_LINUX
+        return startup_process_purpose_live();
+#else
+        return startup_failure(-ENOTSUP);
+#endif
+    }
+    return 0;
+}
+
+/* Identity corroboration only. This neither observes an Original nor admits
+ * a debit: the owned pre/post checks still authenticate the actual operation.
+ * In particular, BQL/Main alone does not replace the real inventory holder. */
+int qemu_crucible_startup_source_native_metadata_preentry(void)
+{
+    if (!qemu_plugin_crucible_startup_source_retained() ||
+        getpid() != startup_source.owner_process) {
+        return -EPERM;
+    }
+    if (native_metadata_raw_creator()) {
+        return 0;
+    }
+    if (!qatomic_load_acquire(&startup_source.module_custody_published) ||
+        !bql_locked()) {
+        return -EPERM;
+    }
+    if (startup_invocation(startup_source.saved.plugin_id)) {
+        return 0;
+    }
+#ifdef CONFIG_LINUX
+    if (standing_construction_operation_identity() ||
+        standing_operation_identity(&startup_source.standing.operation)) {
+        return 0;
+    }
+    if (startup_source.checkpoint_inventory_metadata.held &&
+        !checkpoint_inventory_metadata_identity(
+            &startup_source.checkpoint_inventory_metadata)) {
+        return 0;
+    }
+#endif
+    return -EPERM;
+}
+
+/* The actual owner is already claimed. Observe the post independently even
+ * after an initial refusal; publish the first failure only after saving both. */
+static int native_metadata_admit_owned(
+    uint64_t bytes, QemuCrucibleMetadataAdmission *admission, int first)
+{
+    int pre = qemu_crucible_startup_source_native_metadata_check();
+
+    if (!first) {
+        first = pre;
+    }
+    if (!first) {
+        first = crucible_metadata_native_admit(
+            &startup_source.metadata_partition, bytes, &admission->charge);
+    }
+    admission->first_status = first;
+    admission->post_attempted = true;
+    admission->post_status =
+        qemu_crucible_startup_source_native_metadata_check();
+    crucible_metadata_partition_record_post(
+        &startup_source.metadata_partition, admission->post_status);
+    if (first) {
+        startup_failure(first);
+    }
+    return first ? first : admission->post_status;
+}
+
+int qemu_crucible_startup_source_native_metadata_admit(
+    uint64_t bytes, QemuCrucibleMetadataAdmission *admission)
+{
+    int identity;
+
+    if (!qemu_crucible_startup_source_control_metadata_bytes()) {
+        /* Preserve ordinary caller storage and the existing initial check. */
+        return qemu_crucible_startup_source_native_metadata_check();
+    }
+    identity = qemu_crucible_startup_source_native_metadata_preentry();
+
+    if (identity) {
+        return identity;
+    }
+    if (!bytes || !admission) {
+        return -EINVAL;
+    }
+    if (admission->charge.held || admission->charge.bytes ||
+        admission->first_status || admission->post_status ||
+        admission->post_attempted) {
+        return -EALREADY;
+    }
+    return native_metadata_admit_owned(bytes, admission, 0);
+}
+
+enum NativeMetadataBirthState {
+    NATIVE_METADATA_BIRTH_FREE,
+    NATIVE_METADATA_BIRTH_CLAIMING,
+    NATIVE_METADATA_BIRTH_ACTIVE,
+    NATIVE_METADATA_BIRTH_FINISHING,
+    NATIVE_METADATA_BIRTH_RETAINED,
+};
+
+static bool native_metadata_birth_identity(QemuCrucibleMetadataBirth *birth)
+{
+    return birth == &startup_source.inventory_birth[0] ||
+        birth == &startup_source.inventory_birth[1] ||
+        birth == &startup_source.region_birth ||
+        birth == &startup_source.dirty_birth;
+}
+
+static int native_metadata_birth_begin(QemuCrucibleMetadataBirth *birth,
+                                      uint64_t bytes, int first,
+                                      QemuCrucibleMetadataBirthLoan *out)
+{
+    int status;
+    int creator_tid;
+
+    if (!qemu_crucible_startup_source_control_metadata_bytes()) {
+        return qemu_crucible_startup_source_native_metadata_check();
+    }
+    status = qemu_crucible_startup_source_native_metadata_preentry();
+    if (status) {
+        return status;
+    }
+    if (!out || out->owner || out->admission) {
+        return -EINVAL;
+    }
+    creator_tid = native_metadata_thread_id();
+    if (!creator_tid) {
+        return -ENOTSUP;
+    }
+    if (qatomic_cmpxchg(&birth->state, NATIVE_METADATA_BIRTH_FREE,
+                       NATIVE_METADATA_BIRTH_CLAIMING) !=
+        NATIVE_METADATA_BIRTH_FREE) {
+        /* No new bracket or debit began; preserve the incumbent owner. */
+        return -EBUSY;
+    }
+    qemu_thread_get_self(&birth->creator);
+    qatomic_store_release(&birth->creator_tid, creator_tid);
+    QemuCrucibleRamMetadataKeeper *keeper = &startup_source.ram_metadata_keeper;
+    uint64_t serial = 0;
+    int identity = qemu_crucible_startup_source_ram_metadata_keeper_current();
+
+    if (!first) {
+        first = identity;
+    }
+    if (!first) {
+        serial = qatomic_read(&keeper->next_serial);
+        for (;;) {
+            uint64_t observed;
+
+            if (!serial || serial == UINT64_MAX) {
+                first = -EOVERFLOW;
+                serial = 0;
+                break;
+            }
+            observed = qatomic_cmpxchg(&keeper->next_serial, serial, serial + 1);
+            if (observed == serial) {
+                break;
+            }
+            serial = observed;
+        }
+    }
+    birth->serial = serial;
+    birth->requested_bytes = bytes;
+    *out = (QemuCrucibleMetadataBirthLoan) {
+        .owner = birth,
+        .admission = &birth->admission,
+        .keeper = keeper,
+        .serial = serial,
+    };
+    status = native_metadata_admit_owned(bytes, &birth->admission, first);
+    if (!status && (!birth->admission.charge.held ||
+                    birth->admission.charge.bytes != bytes)) {
+        status = -EPROTO;
+    }
+    birth->transfer_status = status;
+    qatomic_store_release(&birth->state, status ?
+        NATIVE_METADATA_BIRTH_RETAINED : NATIVE_METADATA_BIRTH_ACTIVE);
+    return status;
+}
+
+int qemu_crucible_startup_source_ram_inventory_birth_begin(
+    unsigned row, unsigned capacity, QemuCrucibleMetadataBirthLoan *out)
+{
+    uint64_t bytes = qemu_crucible_ram_inventory_body_bytes(capacity);
+
+    if (row >= G_N_ELEMENTS(startup_source.inventory_birth) || !bytes) {
+        return -EINVAL;
+    }
+    return native_metadata_birth_begin(&startup_source.inventory_birth[row],
+                                        bytes, 0, out);
+}
+
+int qemu_crucible_startup_source_ram_region_birth_begin(
+    uint64_t bytes, QemuCrucibleMetadataBirthLoan *out)
+{
+    if (!bytes) {
+        return -EINVAL;
+    }
+    return native_metadata_birth_begin(&startup_source.region_birth,
+                                        bytes, 0, out);
+}
+
+int qemu_crucible_startup_source_ram_dirty_birth_begin(
+    uint64_t bytes, QemuCrucibleMetadataBirthLoan *out)
+{
+    if (!bytes) {
+        return -EINVAL;
+    }
+    return native_metadata_birth_begin(&startup_source.dirty_birth,
+                                        bytes, 0, out);
+}
+
+int qemu_crucible_startup_source_ram_metadata_birth_finish(
+    QemuCrucibleMetadataBirthLoan *loan)
+{
+    QemuCrucibleMetadataBirth *birth;
+    int creator_tid;
+    int status;
+
+    /* Acquire identity publication independently of caller pthread history.
+     * This is retained physical custody, with no Original/live-time gate. */
+    if (!qemu_plugin_crucible_startup_source_retained() ||
+        !loan || !native_metadata_birth_identity(loan->owner) ||
+        loan->admission != &loan->owner->admission ||
+        getpid() != startup_source.owner_process) {
+        return -EPERM;
+    }
+    birth = loan->owner;
+    if (loan->keeper != &startup_source.ram_metadata_keeper ||
+        !loan->serial || loan->serial != birth->serial) {
+        return -EPERM;
+    }
+    /* Reject a foreign actor before any phase mutation or plain creator read.
+     * The exact QemuThread check remains mandatory after phase acquisition. */
+    creator_tid = native_metadata_thread_id();
+    if (!creator_tid ||
+        creator_tid != qatomic_load_acquire(&birth->creator_tid)) {
+        return -EPERM;
+    }
+    if (qatomic_cmpxchg(&birth->state, NATIVE_METADATA_BIRTH_ACTIVE,
+                       NATIVE_METADATA_BIRTH_FINISHING) !=
+        NATIVE_METADATA_BIRTH_ACTIVE) {
+        return -EBUSY;
+    }
+    /* Only the authenticated creator can own this transition. The phase
+     * protects its plain identity and receipt through complete transfer. */
+    if (!qemu_thread_is_self(&birth->creator)) {
+        qatomic_store_release(&birth->state, NATIVE_METADATA_BIRTH_ACTIVE);
+        return -EPERM;
+    }
+    status = birth->admission.first_status ? birth->admission.first_status :
+        birth->admission.post_status;
+    if (!status && (!birth->admission.post_attempted ||
+                    birth->admission.charge.held ||
+                    birth->admission.charge.bytes)) {
+        status = -EBUSY;
+    }
+    birth->finish_status = status;
+    if (status) {
+        qatomic_store_release(&birth->state, NATIVE_METADATA_BIRTH_RETAINED);
+        return status;
+    }
+    /* Every requested byte now resides on actual allocated destinations.
+     * Clearing this loan changes no ledger balance or allocator history. */
+    birth->admission = (QemuCrucibleMetadataAdmission) { 0 };
+    birth->requested_bytes = 0;
+    birth->transfer_status = 0;
+    qatomic_store_release(&birth->creator_tid, 0);
+    *loan = (QemuCrucibleMetadataBirthLoan) { 0 };
+    qatomic_store_release(&birth->state, NATIVE_METADATA_BIRTH_FREE);
+    return 0;
+}
+
+int qemu_crucible_startup_source_ram_metadata_keeper_current(void)
+{
+    QemuCrucibleRamMetadataKeeper *keeper = &startup_source.ram_metadata_keeper;
+
+    /* A child refuses its copied parent owner before touching any native
+     * owner, journal or mutable account. Expiry cannot prevent physical return. */
+    if (!qemu_plugin_crucible_startup_source_retained() ||
+        getpid() != startup_source.owner_process) {
+        return -EPERM;
+    }
+    if (keeper->process != startup_source.owner_process ||
+        keeper->partition != &startup_source.metadata_partition ||
+        !keeper->payer || keeper->payer != startup_source.preexec_purpose_owner ||
+        !keeper->process_generation || !keeper->account_generation ||
+        keeper->process_generation !=
+            startup_source.process_purpose_record.process_generation ||
+        keeper->account_generation !=
+            startup_source.process_purpose_record.account_generation) {
+        return -ESTALE;
+    }
+    return 0;
+}
+
+void qemu_crucible_startup_source_ram_return_record(int status)
+{
+    if (status < 0 && qemu_plugin_crucible_startup_source_retained() &&
+        getpid() == startup_source.owner_process) {
+        crucible_metadata_partition_record_post(
+            &startup_source.metadata_partition, status);
+    }
+}
+
+static bool ram_return_journal_identity(QemuCrucibleRamReturnJournal *journal)
+{
+    QemuCrucibleRamMetadataKeeper *keeper = &startup_source.ram_metadata_keeper;
+
+    return journal && (journal == keeper->inventory_returns[0] ||
+                       journal == keeper->inventory_returns[1] ||
+                       journal == keeper->dirty_return);
+}
+
+int qemu_crucible_startup_source_ram_return_prepare(
+    QemuCrucibleRamMetadataOwner *owner,
+    QemuCrucibleRamReturnJournal *journal)
+{
+    QemuCrucibleRamMetadataKeeper *keeper = &startup_source.ram_metadata_keeper;
+    int status = qemu_crucible_startup_source_ram_metadata_keeper_current();
+
+    if (status) {
+        return status;
+    }
+    if (!bql_locked() || !ram_return_journal_identity(journal)) {
+        return -EPERM;
+    }
+    if (journal->phase == RAM_RETURN_CLAIMED && journal->owner == owner &&
+        journal->keeper == keeper) {
+        return 0;
+    }
+    if (journal->phase != RAM_RETURN_EMPTY && journal->phase != RAM_RETURN_SETTLED) {
+        return -EBUSY;
+    }
+    if (!owner || owner->keeper != keeper || !owner->serial || !owner->address ||
+        !owner->bytes || !owner->admission.charge.held ||
+        owner->admission.charge.bytes != owner->bytes) {
+        return -ESTALE;
+    }
+    status = qemu_crucible_ram_metadata_owner_current(owner, journal);
+    if (status) {
+        return status;
+    }
+    /* Actual native membership and returning phase are held through this
+     * pure move. No callback, allocation or fallible observation intervenes. */
+    *journal = (QemuCrucibleRamReturnJournal) {
+        .keeper = keeper,
+        .owner = owner,
+        .serial = owner->serial,
+        .address = owner->address,
+        .bytes = owner->bytes,
+        .admission = owner->admission,
+        .phase = RAM_RETURN_CLAIMED,
+    };
+    owner->admission.charge = (QemuCrucibleMetadataCharge) { 0 };
+    return 0;
+}
+
+int qemu_crucible_startup_source_native_metadata_retire(
+    QemuCrucibleRamReturnJournal *journal)
+{
+    QemuCrucibleRamMetadataKeeper *keeper = &startup_source.ram_metadata_keeper;
+    int status = qemu_crucible_startup_source_ram_metadata_keeper_current();
+
+    if (status) {
+        return status;
+    }
+    if (!bql_locked() || !ram_return_journal_identity(journal) ||
+        journal->keeper != keeper) {
+        return -EPERM;
+    }
+    if (journal->phase == RAM_RETURN_SETTLED) {
+        return 0;
+    }
+    if (journal->phase != RAM_RETURN_FREE_RETURNED ||
+        !journal->admission.charge.held ||
+        journal->admission.charge.bytes != journal->bytes) {
+        return -EBUSY;
+    }
+    status = crucible_metadata_native_retire(keeper->partition,
+                                            &journal->admission.charge);
+    journal->settlement_status = status;
+    if (status) {
+        if (!journal->first_status) {
+            journal->first_status = status;
+        }
+        crucible_metadata_partition_record_post(keeper->partition, status);
+    } else {
+        journal->phase = RAM_RETURN_SETTLED;
+        journal->owner = NULL;
+    }
+    return status;
+}
