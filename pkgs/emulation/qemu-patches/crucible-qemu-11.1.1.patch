+static qemu_plugin_sim_shmem_max_advance_icount_cb_t crucible_max_advance_icount_cb;
+static qemu_plugin_sim_shmem_logical_ceiling_cb_t crucible_logical_ceiling_cb;
+static void *crucible_sim_shmem_userdata;
+static qemu_plugin_sim_shmem_publish_icount_cb_t crucible_observe_icount_cb;
+static qemu_plugin_sim_shmem_max_advance_icount_cb_t
+    crucible_observer_max_advance_icount_cb;
+static void *crucible_sim_observer_userdata;
+
+static QemuCrucibleNativeRegistration *native_shmem_dispatch_members[3];
+
+size_t qemu_plugin_crucible_native_shmem_dispatch_descriptor_storage_bytes_v1(void)
+{
+    return sizeof(native_shmem_dispatch_members);
+}
+
+bool qemu_plugin_crucible_native_shmem_dispatch_descriptor_observe_v1(
+    size_t member, QemuCrucibleNativeGroupDescriptorView *out)
+{
+    if (!out) {
+        return false;
+    }
+
+    switch (member) {
+    case 0:
+        *out = (QemuCrucibleNativeGroupDescriptorView) {
+            .coordinate = &crucible_publish_icount_cb,
+            .function = crucible_publish_icount_cb,
+            .userdata = crucible_sim_shmem_userdata,
+            .userdata_coordinate = &crucible_sim_shmem_userdata,
+            .kind = QEMU_CRUCIBLE_NATIVE_REGISTERED,
+        };
+        return true;
+    case 1:
+        *out = (QemuCrucibleNativeGroupDescriptorView) {
+            .coordinate = &crucible_max_advance_icount_cb,
+            .function = crucible_max_advance_icount_cb,
+            .userdata = crucible_sim_shmem_userdata,
+            .userdata_coordinate = &crucible_sim_shmem_userdata,
+            .kind = QEMU_CRUCIBLE_NATIVE_MAX_ADVANCE,
+        };
+        return true;
+    case 2:
+        *out = (QemuCrucibleNativeGroupDescriptorView) {
+            .coordinate = &crucible_logical_ceiling_cb,
+            .function = crucible_logical_ceiling_cb,
+            .userdata = crucible_sim_shmem_userdata,
+            .userdata_coordinate = &crucible_sim_shmem_userdata,
+            .kind = QEMU_CRUCIBLE_NATIVE_REGISTERED,
+        };
+        return true;
+    default:
+        return false;
+    }
+}
+
+void qemu_plugin_register_sim_shmem_dispatch_cb(
+    qemu_plugin_sim_shmem_publish_icount_cb_t publish_icount_cb,
+    qemu_plugin_sim_shmem_max_advance_icount_cb_t max_advance_icount_cb,
+    qemu_plugin_sim_shmem_logical_ceiling_cb_t logical_ceiling_cb,
+    void *userdata)
+{
+#ifdef CONFIG_PLUGIN
+    QemuCrucibleNativeGroupRegistrar registrar;
+    QemuCrucibleNativeGroupDescriptorView actual;
+    const QemuCrucibleNativeGroupDescriptorView expected[] = {
+        {
+            .coordinate = &crucible_publish_icount_cb,
+            .function = publish_icount_cb,
+            .userdata = userdata,
+            .userdata_coordinate = &crucible_sim_shmem_userdata,
+            .kind = QEMU_CRUCIBLE_NATIVE_REGISTERED,
+        },
+        {
+            .coordinate = &crucible_max_advance_icount_cb,
+            .function = max_advance_icount_cb,
+            .userdata = userdata,
+            .userdata_coordinate = &crucible_sim_shmem_userdata,
+            .kind = QEMU_CRUCIBLE_NATIVE_MAX_ADVANCE,
+        },
+        {
+            .coordinate = &crucible_logical_ceiling_cb,
+            .function = logical_ceiling_cb,
+            .userdata = userdata,
+            .userdata_coordinate = &crucible_sim_shmem_userdata,
+            .kind = QEMU_CRUCIBLE_NATIVE_REGISTERED,
+        },
+    };
+
+    if (qemu_plugin_crucible_native_group_begin_v1(
+            QEMU_CRUCIBLE_NATIVE_GROUP_SHMEM_DISPATCH, expected, ARRAY_SIZE(expected),
+            &registrar) ||
+        qemu_plugin_crucible_native_group_effect_begin_v1(&registrar)) {
+        qemu_plugin_crucible_native_group_finish_v1(&registrar);
+        return;
+    }
+
+    qemu_plugin_crucible_native_group_member_attempt_v1(&registrar, 0);
+    qemu_plugin_crucible_native_registration_release_v1(native_shmem_dispatch_members[0]);
+    qatomic_store_release(&native_shmem_dispatch_members[0],
+        qemu_plugin_crucible_native_group_member_v1(&registrar, 0));
+    qemu_plugin_crucible_native_group_member_attempt_v1(&registrar, 1);
+    qemu_plugin_crucible_native_registration_release_v1(native_shmem_dispatch_members[1]);
+    qatomic_store_release(&native_shmem_dispatch_members[1],
+        qemu_plugin_crucible_native_group_member_v1(&registrar, 1));
+    qemu_plugin_crucible_native_group_member_attempt_v1(&registrar, 2);
+    qemu_plugin_crucible_native_registration_release_v1(native_shmem_dispatch_members[2]);
+    qatomic_store_release(&native_shmem_dispatch_members[2],
+        qemu_plugin_crucible_native_group_member_v1(&registrar, 2));
+
+#endif
+    if (publish_icount_cb && max_advance_icount_cb &&
+        logical_ceiling_cb &&
+        qemu_crucible_fault_memory_service_rules_active()) {
+        error_report("Crucible memory service cannot enter host-granted "
+                     "sim time without a checkpointable completion ticket");
+        abort();
+    }
+    if (publish_icount_cb && max_advance_icount_cb && logical_ceiling_cb &&
+        qemu_crucible_fault_vmstate_enable() != 0) {
+        error_report("Crucible host dispatch could not enable fault VMState");
+        abort();
+    }
+
+    crucible_sim_shmem_userdata = userdata;
+    crucible_max_advance_icount_cb = max_advance_icount_cb;
+    crucible_logical_ceiling_cb = logical_ceiling_cb;
+    crucible_publish_icount_cb = publish_icount_cb;
+
+#ifdef CONFIG_PLUGIN
+    if (qemu_plugin_crucible_native_shmem_dispatch_descriptor_observe_v1(0, &actual)) {
+        qemu_plugin_crucible_native_group_member_installed_v1(
+            &registrar, 0, &actual);
+    }
+    if (qemu_plugin_crucible_native_shmem_dispatch_descriptor_observe_v1(1, &actual)) {
+        qemu_plugin_crucible_native_group_member_installed_v1(
+            &registrar, 1, &actual);
+    }
+    if (qemu_plugin_crucible_native_shmem_dispatch_descriptor_observe_v1(2, &actual)) {
+        qemu_plugin_crucible_native_group_member_installed_v1(
+            &registrar, 2, &actual);
+    }
+    qemu_plugin_crucible_native_group_effect_end_v1(&registrar);
+    qemu_plugin_crucible_native_group_finish_v1(&registrar);
+#endif
+
+    if (publish_icount_cb && max_advance_icount_cb && logical_ceiling_cb) {
+        qemu_plugin_crucible_callback_registered(
+            0, QEMU_PLUGIN_CRUCIBLE_CALLBACK_SIM_SHMEM);
+    }
+}
+
+/* First refusal and independent descriptor post survive physical use return.
+ * Neither scalar values nor these factual results issue scheduler authority. */
+typedef struct CrucibleShmemCallbackResult {
+    int first_status;
+    int post_status;
+} CrucibleShmemCallbackResult;
+
+static CrucibleShmemCallbackResult crucible_group_call_publish_icount_cb(
+    uint64_t current_icount, void *userdata)
+{
+    CrucibleShmemCallbackResult result = { 0 };
+
+#ifdef CONFIG_PLUGIN
+    QemuCrucibleNativeGroupDescriptorView actual;
+    QemuCrucibleNativeGroupUse use =
+        qemu_plugin_crucible_native_group_use_begin_v1(
+            &native_shmem_dispatch_members[0],
+            qemu_plugin_crucible_native_shmem_dispatch_descriptor_observe_v1,
+            0, &actual);
+
+    (void)userdata;
+    if (!actual.function ||
+        (!use.record && qatomic_load_acquire(&qemu_crucible_selected_process_id))) {
+        result.first_status = -ENOKEY;
+    } else {
+        ((qemu_plugin_sim_shmem_publish_icount_cb_t)actual.function)(
+            current_icount, actual.userdata);
+    }
+    result.post_status = qemu_plugin_crucible_native_group_use_post_v1(
+        &use, &native_shmem_dispatch_members[0],
+        qemu_plugin_crucible_native_shmem_dispatch_descriptor_observe_v1,
+        0, &actual);
+    qemu_plugin_crucible_native_group_use_end_v1(use);
+#else
+    crucible_publish_icount_cb(current_icount, userdata);
+#endif
+    return result;
+}
+
+static CrucibleShmemCallbackResult crucible_group_call_max_advance_icount_cb(
+    void *userdata, uint64_t *out)
+{
+    CrucibleShmemCallbackResult result = { 0 };
+    uint64_t candidate = 0;
+
+#ifdef CONFIG_PLUGIN
+    QemuCrucibleNativeGroupDescriptorView actual;
+    QemuCrucibleNativeGroupUse use =
+        qemu_plugin_crucible_native_group_use_begin_v1(
+            &native_shmem_dispatch_members[1],
+            qemu_plugin_crucible_native_shmem_dispatch_descriptor_observe_v1,
+            1, &actual);
+
+    (void)userdata;
+    if (!actual.function ||
+        (!use.record && qatomic_load_acquire(&qemu_crucible_selected_process_id))) {
+        result.first_status = -ENOKEY;
+    } else {
+        candidate = ((qemu_plugin_sim_shmem_max_advance_icount_cb_t)actual.function)(
+            actual.userdata);
+    }
+    result.post_status = qemu_plugin_crucible_native_group_use_post_v1(
+        &use, &native_shmem_dispatch_members[1],
+        qemu_plugin_crucible_native_shmem_dispatch_descriptor_observe_v1,
+        1, &actual);
+    qemu_plugin_crucible_native_group_use_end_v1(use);
+#else
+    candidate = crucible_max_advance_icount_cb(userdata);
+#endif
+    if (!result.first_status && !result.post_status) {
+        *out = candidate;
+    }
+    return result;
+}
+
+static CrucibleShmemCallbackResult crucible_group_call_logical_ceiling_cb(
+    void *userdata, uint64_t *out)
+{
+    CrucibleShmemCallbackResult result = { 0 };
+    uint64_t candidate = 0;
+
+#ifdef CONFIG_PLUGIN
+    QemuCrucibleNativeGroupDescriptorView actual;
+    QemuCrucibleNativeGroupUse use =
+        qemu_plugin_crucible_native_group_use_begin_v1(
+            &native_shmem_dispatch_members[2],
+            qemu_plugin_crucible_native_shmem_dispatch_descriptor_observe_v1,
+            2, &actual);
+
+    (void)userdata;
+    if (!actual.function ||
+        (!use.record && qatomic_load_acquire(&qemu_crucible_selected_process_id))) {
+        result.first_status = -ENOKEY;
+    } else {
+        candidate = ((qemu_plugin_sim_shmem_logical_ceiling_cb_t)actual.function)(
+            actual.userdata);
+    }
+    result.post_status = qemu_plugin_crucible_native_group_use_post_v1(
+        &use, &native_shmem_dispatch_members[2],
+        qemu_plugin_crucible_native_shmem_dispatch_descriptor_observe_v1,
+        2, &actual);
+    qemu_plugin_crucible_native_group_use_end_v1(use);
+#else
+    candidate = crucible_logical_ceiling_cb(userdata);
+#endif
+    if (!result.first_status && !result.post_status) {
+        *out = candidate;
+    }
+    return result;
+}
+
+static void crucible_shmem_callback_require_return(CrucibleShmemCallbackResult result)
+{
+    if (result.first_status || result.post_status) {
+        error_report("Crucible shmem callback refused: first=%d post=%d",
+                     result.first_status, result.post_status);
+        abort();
+    }
+}
+
+void qemu_plugin_register_sim_shmem_observer_cb(
+    qemu_plugin_sim_shmem_publish_icount_cb_t observe_icount_cb,
+    qemu_plugin_sim_shmem_max_advance_icount_cb_t max_advance_icount_cb,
+    void *userdata)
+{
+    QemuCrucibleNativeRegistrar registrar;
+
+    qemu_plugin_crucible_native_registrar_begin_current_v1(
+        QEMU_CRUCIBLE_CALLBACK_SHMEM_OBSERVER_ADVANCE, &registrar);
+    qemu_plugin_crucible_native_registration_retire_v1(&crucible_observer_max_advance_icount_cb);
+    qemu_plugin_crucible_native_registrar_attach_v1(
+        &registrar, registrar.ctx, &crucible_observer_max_advance_icount_cb,
+        max_advance_icount_cb, userdata, QEMU_CRUCIBLE_NATIVE_MAX_ADVANCE);
+    crucible_sim_observer_userdata = userdata;
+    crucible_observer_max_advance_icount_cb = max_advance_icount_cb;
+    qemu_plugin_crucible_native_registrar_finish_v1(&registrar);
+
+    qemu_plugin_crucible_native_registrar_begin_current_v1(
+        QEMU_CRUCIBLE_CALLBACK_SHMEM_OBSERVER_NOTIFY, &registrar);
+    qemu_plugin_crucible_native_registration_retire_v1(&crucible_observe_icount_cb);
+    qemu_plugin_crucible_native_registrar_attach_v1(
+        &registrar, registrar.ctx, &crucible_observe_icount_cb,
+        observe_icount_cb, userdata, QEMU_CRUCIBLE_NATIVE_REGISTERED);
+    crucible_observe_icount_cb = observe_icount_cb;
+    qemu_plugin_crucible_native_registrar_finish_v1(&registrar);
+
+}
+
+bool crucible_sim_shmem_dispatch_registered(void)
+{
+    return crucible_publish_icount_cb != NULL &&
+           crucible_max_advance_icount_cb != NULL &&
+           crucible_logical_ceiling_cb != NULL;
+}
+
+bool crucible_sim_observer_registered(void)
+{
+    return crucible_observe_icount_cb != NULL &&
+           crucible_observer_max_advance_icount_cb != NULL;
+}
+
+void crucible_sim_shmem_publish_current_icount(uint64_t current_icount)
+{
+    if (crucible_publish_icount_cb ||
+        qatomic_load_acquire(&native_shmem_dispatch_members[0])) {
+        qemu_plugin_crucible_exact_boundary_enter();
+        QemuCrucibleNativeInvocationTicket native =
+            qemu_plugin_crucible_native_enter_v1(
+                NULL, &crucible_publish_icount_cb, crucible_publish_icount_cb,
+                crucible_sim_shmem_userdata, QEMU_CRUCIBLE_NATIVE_REGISTERED);
+
+        CrucibleShmemCallbackResult result = crucible_group_call_publish_icount_cb(
+            current_icount, crucible_sim_shmem_userdata);
+
+        qemu_plugin_crucible_native_exit_v1(native);
+        qemu_plugin_crucible_exact_boundary_leave();
+        crucible_shmem_callback_require_return(result);
+    }
+    crucible_current_icount = current_icount;
+}
+
+void crucible_sim_observer_notify_current_icount(uint64_t current_icount)
+{
+    crucible_current_icount = current_icount;
+    if (crucible_observe_icount_cb) {
+        qemu_plugin_crucible_exact_boundary_enter();
+        QemuCrucibleNativeInvocationTicket native =
+            qemu_plugin_crucible_native_enter_v1(
+                NULL, &crucible_observe_icount_cb, crucible_observe_icount_cb,
+                crucible_sim_observer_userdata, QEMU_CRUCIBLE_NATIVE_REGISTERED);
+
+        crucible_observe_icount_cb(current_icount, crucible_sim_observer_userdata);
+        qemu_plugin_crucible_native_exit_v1(native);
+        qemu_plugin_crucible_exact_boundary_leave();
+    }
+}
+
+uint64_t crucible_sim_shmem_current_icount(void)
+{
+    return crucible_current_icount;
+}
+
+uint64_t crucible_sim_shmem_max_advance_icount(void)
+{
+    if (crucible_max_advance_icount_cb ||
+        qatomic_load_acquire(&native_shmem_dispatch_members[1])) {
+        uint64_t result;
+
+        qemu_plugin_crucible_exact_boundary_enter();
+        QemuCrucibleNativeInvocationTicket native =
+            qemu_plugin_crucible_native_enter_v1(
+                NULL, &crucible_max_advance_icount_cb, crucible_max_advance_icount_cb,
+                crucible_sim_shmem_userdata, QEMU_CRUCIBLE_NATIVE_MAX_ADVANCE);
+
+        CrucibleShmemCallbackResult call = crucible_group_call_max_advance_icount_cb(
+            crucible_sim_shmem_userdata, &result);
+
+        qemu_plugin_crucible_native_exit_v1(native);
+        qemu_plugin_crucible_exact_boundary_leave();
+        crucible_shmem_callback_require_return(call);
+        return result;
+    }
+
+    return UINT64_MAX;
+}
+
+uint64_t crucible_sim_shmem_logical_ceiling(void)
+{
+    uint64_t ceiling;
+
+    if (!crucible_logical_ceiling_cb &&
+        !qatomic_load_acquire(&native_shmem_dispatch_members[2])) {
+        return 0;
+    }
+
+    qemu_plugin_crucible_exact_boundary_enter();
+    QemuCrucibleNativeInvocationTicket native =
+        qemu_plugin_crucible_native_enter_v1(
+                NULL, &crucible_logical_ceiling_cb, crucible_logical_ceiling_cb,
+                crucible_sim_shmem_userdata, QEMU_CRUCIBLE_NATIVE_REGISTERED);
+
+    CrucibleShmemCallbackResult call = crucible_group_call_logical_ceiling_cb(
+        crucible_sim_shmem_userdata, &ceiling);
+
+    qemu_plugin_crucible_native_exit_v1(native);
+    qemu_plugin_crucible_exact_boundary_leave();
+    crucible_shmem_callback_require_return(call);
+    return ceiling;
+}
+
+uint64_t crucible_sim_observer_max_advance_icount(void)
+{
+    if (crucible_observer_max_advance_icount_cb) {
+        uint64_t result;
+
+        qemu_plugin_crucible_exact_boundary_enter();
+        QemuCrucibleNativeInvocationTicket native =
+            qemu_plugin_crucible_native_enter_v1(
+                NULL, &crucible_observer_max_advance_icount_cb,
+                crucible_observer_max_advance_icount_cb,
+                crucible_sim_observer_userdata, QEMU_CRUCIBLE_NATIVE_MAX_ADVANCE);
+
+        result = crucible_observer_max_advance_icount_cb(
+            crucible_sim_observer_userdata);
+        qemu_plugin_crucible_native_exit_v1(native);
+        qemu_plugin_crucible_exact_boundary_leave();
+        return result;
+    }
+
+    return UINT64_MAX;
+}
+
+static int64_t crucible_sim_clamp_cpu_budget(uint64_t current_icount,
+                                             int64_t cpu_budget,
+                                             uint64_t max_advance_icount)
+{
+    uint64_t remaining;
+
+    if (cpu_budget <= 0) {
+        return cpu_budget;
+    }
+    if (current_icount >= max_advance_icount) {
+        return 0;
+    }
+
+    remaining = max_advance_icount - current_icount;
+    if (remaining > (uint64_t)INT64_MAX || (uint64_t)cpu_budget <= remaining) {
+        return cpu_budget;
+    }
+    return (int64_t)remaining;
+}
+
+int64_t crucible_sim_shmem_clamp_cpu_budget(uint64_t current_icount,
+                                            int64_t cpu_budget,
+                                            uint64_t max_advance_icount)
+{
+    return crucible_sim_clamp_cpu_budget(current_icount, cpu_budget,
+                                         max_advance_icount);
+}
+
+int64_t crucible_sim_observer_clamp_cpu_budget(uint64_t current_icount,
+                                               int64_t cpu_budget)
+{
+    return crucible_sim_clamp_cpu_budget(
+        current_icount, cpu_budget,
+        crucible_sim_observer_max_advance_icount());
+}
+
+bool crucible_sim_shmem_may_advance_to(uint64_t candidate_icount)
+{
+    return candidate_icount <= crucible_sim_shmem_max_advance_icount();
+}
