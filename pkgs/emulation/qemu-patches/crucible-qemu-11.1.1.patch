+int qemu_plugin_inject_preemption(uint64_t at_tick,
+                                  uint64_t deadline_tick,
+                                  uint64_t ceiling_tick,
+                                  unsigned int kind, uint32_t arg0,
+                                  uint32_t arg1, uint32_t arg2)
+{
+    return crucible_sim_preemption_enqueue(at_tick, deadline_tick,
+                                           ceiling_tick, kind, arg0, arg1,
+                                           arg2);
+}
+
+static void qemu_plugin_wake_fd_read(void *opaque)
+{
+    int fd = (intptr_t)opaque;
+    uint8_t buffer[256];
+    CPUState *cpu;
+    bool drained = false;
+    bool watcher_entered = fingerprint_wake_read_enter(fd);
+
+    for (;;) {
+        ssize_t ret = read(fd, buffer, sizeof(buffer));
+
+        if (ret > 0) {
+            drained = true;
+            continue;
+        }
+        if (ret < 0 && errno == EINTR) {
+            continue;
+        }
+        if (ret < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) {
+            bool single_threaded_rr = drained && first_cpu &&
+                qemu_plugin_crucible_single_threaded_rr();
+
+            if (drained) {
+                notifier_list_notify(&qemu_plugin_wake_notifiers,
+                                     (void *)(intptr_t)QEMU_PLUGIN_WAKE_EVENT_DRAINED);
+            }
+            if (drained && qemu_plugin_crucible_vmstop_pending()) {
+                qemu_plugin_trace_stop_context(CRUCIBLE_STOP_READER_DRAINED);
+            }
+            if (single_threaded_rr &&
+                qemu_plugin_crucible_vmstop_quiesced()) {
+                qemu_plugin_trace_control_delivery("wake-stopped");
+                /*
+                 * A stopped RR thread cannot claim a native request.  Device
+                 * notifiers have already settled under the BQL, so transfer
+                 * any older request to the existing two-pass main-loop owner
+                 * and let it acknowledge this exact paused boundary.
+                 */
+                qemu_plugin_crucible_rr_control_boundary_defer();
+            } else if (single_threaded_rr) {
+                qemu_plugin_request_rr_control_boundary();
+            } else if (drained && first_cpu) {
+                qemu_plugin_schedule_control_boundary();
+                /* Preserve the generic wake for every MTTCG vCPU. */
+                CPU_FOREACH(cpu) {
+                    tcg_kick_vcpu_thread(cpu);
+                }
+            }
+            if (drained && qemu_plugin_crucible_rr_control_boundary_pending()) {
+                qemu_plugin_trace_rr_control_boundary_state("wake-drain");
+            }
+            if (drained) {
+                qemu_plugin_control_drain_notify();
+            }
+            fingerprint_wake_read_return(watcher_entered);
+            return;
+        }
+        qemu_plugin_trace_stop_context(ret == 0 ? CRUCIBLE_STOP_READER_EOF :
+                                                 CRUCIBLE_STOP_READER_ERROR);
+        if (ret == 0) {
+            error_report("Crucible plugin wake fd %d reached EOF", fd);
+        } else {
+            error_report("Crucible plugin wake fd %d read failed: %s",
+                         fd, strerror(errno));
+        }
+        notifier_list_notify(&qemu_plugin_wake_notifiers,
+                             (void *)(intptr_t)QEMU_PLUGIN_WAKE_EVENT_FAILED);
+        qemu_plugin_unregister_wake_fd(fd);
+        qemu_system_shutdown_request(SHUTDOWN_CAUSE_HOST_ERROR);
+        if (first_cpu) {
+            qemu_cpu_kick(first_cpu);
+        }
+        fingerprint_wake_read_return(watcher_entered);
+        return;
+    }
+}
+
+int qemu_plugin_register_wake_fd(int fd)
+{
+    QemuCrucibleFingerprintWakeWatcher *watcher = &fingerprint_wake_watcher;
+    bool selected = qemu_crucible_startup_source_fingerprint_enrollment_required_v1();
+    int flags, status;
+
+    if (fd < 0) {
+        return -1;
+    }
+    flags = fcntl(fd, F_GETFL);
+    if (flags < 0 || !(flags & O_NONBLOCK)) {
+        return -1;
+    }
+    if (qatomic_read(&qemu_plugin_wake_fd) >= 0) {
+        if (qatomic_read(&qemu_plugin_wake_fd) != fd) {
+            return -EBUSY;
+        }
+        if (!selected) {
+            return 0;
+        }
+        status = qemu_plugin_crucible_wake_watcher_current_v1(watcher, fd);
+        if (status) {
+            return status;
+        }
+        status = qemu_crucible_startup_source_watcher_current_v1(
+            watcher->keeper, watcher);
+        if (status) {
+            return status;
+        }
+        return watcher->execution_enroll_status;
+    }
+    if (selected) {
+        /* Return only the same physically retained failed registration.
+         * This retry never acquires a new role or queries an Original. */
+        if (watcher->held) {
+            status = fingerprint_wake_watcher_return();
+            if (status || watcher->held) {
+                return status ? status : -EBUSY;
+            }
+        }
+        /* Source authenticates its already-imported wake role and the exact
+         * accepted compiled holder floor before the first Native field write. */
+        status = qemu_crucible_startup_source_watcher_prebirth_current_v1(fd);
+        if (status) {
+            return status;
+        }
+        if (watcher->held || fingerprint_wake_registration_serial == UINT64_MAX) {
+            return -EBUSY;
+        }
+        *watcher = (QemuCrucibleFingerprintWakeWatcher) {
+            .fd = fd,
+            .handler = qemu_plugin_wake_fd_read,
+            .process = getpid(),
+            .registration_serial = ++fingerprint_wake_registration_serial,
+            .held = true,
+            .issuing = true,
+        };
+        qemu_thread_get_self(&watcher->installer_thread);
+        status = qemu_crucible_startup_source_watcher_borrow_v1(
+            fd, watcher, &watcher->keeper);
+        watcher->issuing = false;
+        watcher->first_status = status;
+        if (status || !watcher->keeper) {
+            /* No handler was published. Preserve a born-negative borrowed
+             * role and authenticate its identity-only physical return. */
+            watcher->handler_removed = true;
+            if (!watcher->keeper) {
+                watcher->held = false;
+            }
+            return status ? status : -EPROTO;
+        }
+    }
+    qatomic_set(&qemu_plugin_wake_fd, fd);
+    qemu_plugin_control_drain_invalidate();
+    aio_set_fd_handler(qemu_get_aio_context(), fd,
+                       qemu_plugin_wake_fd_read, NULL, NULL, NULL,
+                       (void *)(intptr_t)fd);
+    if (selected) {
+        watcher->handler_registered = true;
+        /* Enroll only after the real handler publication. The Native carrier
+         * and Source borrower save this durable output before signed failure;
+         * a failed ready registration never erases the live handler/role. */
+        status = qemu_crucible_fingerprint_main_execution_enroll_v1(
+            watcher, watcher->registration_serial, watcher->keeper,
+            &watcher->execution);
+        watcher->execution_enroll_status = status;
+        if (!watcher->first_status) {
+            watcher->first_status = status;
+        }
+        return status;
+    }
+    return 0;
+}
+
+int qemu_plugin_crucible_control_drain_watch(Notifier *notifier,
+                                           uint64_t *generation)
+{
+    int state;
+
+    g_assert(bql_locked());
+    state = qemu_plugin_control_drain_wake_state();
+    if (state < 0 || qemu_plugin_control_drain_generation == UINT64_MAX) {
+        return state < 0 ? state : -EOVERFLOW;
+    }
+    *generation = qemu_plugin_control_drain_generation;
+    notifier_list_add(&qemu_plugin_control_drain_notifiers, notifier);
+    return 0;
+}
+
+void qemu_plugin_crucible_control_drain_unwatch(Notifier *notifier)
+{
+    g_assert(bql_locked());
+    notifier_remove(notifier);
+}
+
+int qemu_plugin_crucible_control_drain_service(uint64_t generation)
+{
+    int state;
+
+    g_assert(bql_locked());
+    if (generation == UINT64_MAX ||
+        generation != qemu_plugin_control_drain_generation ||
+        qatomic_read(&qemu_plugin_wake_fd) < 0) {
+        return -ESTALE;
+    }
+    if (qemu_force_shutdown_requested()) {
+        return -ECANCELED;
+    }
+    state = qemu_plugin_control_drain_wake_state();
+    if (state < 0) {
+        qemu_plugin_control_drain_invalidate();
+        return state;
+    }
+    if (state > 0) {
+        /* Consume only bytes on the original registered descriptor. */
+        qemu_plugin_wake_fd_read(
+            (void *)(intptr_t)qatomic_read(&qemu_plugin_wake_fd));
+        if (generation != qemu_plugin_control_drain_generation) {
+            return -ESTALE;
+        }
+    }
+    state = qemu_plugin_control_drain_wake_state();
+    if (state < 0) {
+        qemu_plugin_control_drain_invalidate();
+        return state;
+    }
+    return qemu_plugin_crucible_control_drain_settled() &&
+        qemu_plugin_quiesced_control_boundary_available();
+}
