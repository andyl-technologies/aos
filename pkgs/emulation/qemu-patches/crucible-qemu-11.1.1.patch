+    group = record->group;
+    if (!registry_process_current(registry, getpid()) ||
+        native_dispatch_hint() != registry) {
+        return -EPERM;
+    }
+    qemu_rec_mutex_lock(&plugin.lock);
+    if (main_control_cpu_current_locked(cpu) &&
+        object_dynamic_cast(OBJECT(cpu), TYPE_CPU)) {
+        object_ref(OBJECT(cpu));
+        pinned = true;
+    }
+    qemu_rec_mutex_unlock(&plugin.lock);
+    if (!pinned) {
+        return -ENOKEY;
+    }
