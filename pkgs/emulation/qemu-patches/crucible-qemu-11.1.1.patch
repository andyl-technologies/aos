+static int produce_exact_stream(unsigned scenario)
+{
+    uint32_t length;
+    ICH9LPCState lpc = { 0 };
+    GByteArray *output;
+
+    initialize_fixture(&lpc, true);
+    observed_ps = scenario == 1 ? ((__int128)1 << 120) + 357 : 357;
+    tco_timer_reload(&lpc.pm.tco_regs);
+    ich9_pm_update_swsmi_timer(&lpc.pm, true);
+    ich9_pm_update_periodic_timer(&lpc.pm, true);
+    if (scenario == 2) {
+        for (unsigned index = 0; index < 3; index++) {
+            timer_mod_ps_wide(ich9_aux_timer(&lpc.pm, index), -1);
+        }
+    }
+    if (scenario == 3) {
+        /* The actual prior 11-byte field writer, never a legacy reader. */
+        const VMStateDescription old_timer = {
+            .name = "ich9_pm/tco-timer-ps",
+            .version_id = 1,
+            .minimum_version_id = 1,
+            .fields = (const VMStateField[]) {
+                VMSTATE_TIMER_NS_PHASE_PTR(tco_regs.tco_timer,
+                                           ICH9LPCPMRegs),
+                VMSTATE_END_OF_LIST(),
+            },
+        };
+        const VMStateDescription old_stream = {
+            .name = auxiliary_stream.name,
+            .version_id = 1,
+            .minimum_version_id = 1,
+            .pre_save = auxiliary_stream.pre_save,
+            .fields = auxiliary_stream.fields,
+            .subsections = (const VMStateDescription * const []) {
+                &old_timer, NULL,
+            },
+        };
+        output = save_description(&lpc.pm, &old_stream);
+    } else {
+        output = save_auxiliary(&lpc.pm);
+    }
+    length = output->len;
+    /* Bounded test IPC only; this is not a process protocol fixture. */
+    g_assert_cmpint(write(STDOUT_FILENO, &length, sizeof(length)), ==,
+                    sizeof(length));
+    g_assert_cmpint(write(STDOUT_FILENO, output->data, length), ==, length);
+    return 0;
+}
