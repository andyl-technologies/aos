+static void test_round_trip(gconstpointer opaque)
+{
+    unsigned index = GPOINTER_TO_UINT(opaque);
+    const __int128 deadlines[] = {
+        ((__int128)1 << 120) + 357, -((__int128)1 << 120) + 357,
+        coordinate(INT64_MIN, 0), coordinate(INT64_MAX, UINT64_MAX),
+        -1, 0, 999, 1000,
+    };
+    MC146818RtcState source, destination;
+    GByteArray *bytes;
+    bool pending = index < ARRAY_SIZE(deadlines);
+    __int128 deadline = pending ? deadlines[index] : 0;
+
+    initialize_timers(&source);
+    initialize_timers(&destination);
+    source.calendar_origin_ps = deadline;
+    source.next_periodic_ps = deadline;
+    source.next_alarm_ps = deadline;
+    if (pending) {
+        for (unsigned timer = 0; timer < 3; timer++) {
+            timer_mod_ps_wide(rtc_wide_timer(&source, timer), deadline);
+        }
+    }
+    bytes = save_state(&source);
+    timer_mod_ps_wide(destination.periodic_timer, 1);
+
+    g_assert_cmpint(load_state(&destination, bytes), ==, 0);
+    assert_coordinate(destination.calendar_origin_ps, deadline);
+    assert_coordinate(destination.next_periodic_ps, deadline);
+    assert_coordinate(destination.next_alarm_ps, deadline);
+    for (unsigned timer = 0; timer < 3; timer++) {
+        g_assert_cmpint(timer_pending(rtc_wide_timer(&destination, timer)),
+                        ==, pending);
+        if (pending) {
+            assert_coordinate(timer_expire_time_ps_wide(
+                                  rtc_wide_timer(&destination, timer)), deadline);
+        }
+    }
+
+    g_byte_array_unref(bytes);
+    destroy_timers(&source);
+    destroy_timers(&destination);
+}
+
+static size_t section_offset(GByteArray *bytes)
+{
+    const char *name = "mc146818rtc/timer-wide";
+
+    for (size_t index = 0; index + strlen(name) < bytes->len; index++) {
+        if (!memcmp(bytes->data + index, name, strlen(name))) {
+            return index - 2;
+        }
+    }
+    g_assert_not_reached();
+}
+
+static void test_malformed(gconstpointer opaque)
+{
+    unsigned index = GPOINTER_TO_UINT(opaque);
+    MC146818RtcState source, destination;
+    GByteArray *bytes;
+    size_t section, payload;
+
+    initialize_timers(&source);
+    initialize_timers(&destination);
+    source.calendar_origin_ps = 357;
+    source.next_periodic_ps = 7357;
+    source.next_alarm_ps = 12357;
+    timer_mod_ps_wide(source.periodic_timer, 7357);
+    bytes = save_state(&source);
+    section = section_offset(bytes);
+    payload = section + 2 + strlen("mc146818rtc/timer-wide") + 4;
+
+    switch (index) {
+    case 0:
+        g_byte_array_set_size(bytes, section + 1);
+        bytes->data[section] = QEMU_VM_EOF;
+        break;
+    case 1:
+        bytes->data[payload] = 2;
+        break;
+    case 2:
+        bytes->data[payload + 1] = 3;
+        break;
+    case 3:
+        bytes->data[payload + 2] = 8;
+        break;
+    case 4:
+        bytes->data[payload + 2] = 0;
+        break;
+    case 5:
+        bytes->data[payload - 1] = 2;
+        break;
+    case 6: {
+        GByteArray *duplicate = g_byte_array_new();
+
+        g_byte_array_append(duplicate, bytes->data + section,
+                             bytes->len - section - 1);
+        g_byte_array_set_size(bytes, bytes->len - 1);
+        g_byte_array_append(bytes, duplicate->data, duplicate->len);
+        g_byte_array_append(bytes, (const uint8_t[]){ QEMU_VM_EOF }, 1);
+        g_byte_array_unref(duplicate);
+        break;
+    }
+    case 7:
+        g_byte_array_set_size(bytes, payload + 20);
+        break;
+    case 8:
+        bytes->data[payload] = 0;
+        break;
+    default: {
+        const char *legacy_name = index == 9 ? "mc146818rtc/timers-ps" :
+                                               "mc146818rtc/crucible-clock";
+        GByteArray *legacy = g_byte_array_new();
+        uint8_t header[] = { QEMU_VM_SUBSECTION, strlen(legacy_name) };
+
+        g_byte_array_append(legacy, bytes->data, section);
+        g_byte_array_append(legacy, header, sizeof(header));
+        g_byte_array_append(legacy, (const uint8_t *)legacy_name,
+                             strlen(legacy_name));
+        g_byte_array_append(legacy, bytes->data + payload - 4,
+                             bytes->len - payload + 4);
+        g_byte_array_unref(bytes);
+        bytes = legacy;
+        break;
+    }
+    }
+    for (unsigned timer = 0; timer < 3; timer++) {
+        timer_mod_ps_wide(rtc_wide_timer(&destination, timer), 1);
+    }
+
+    g_assert_cmpint(load_state(&destination, bytes), <, 0);
+    for (unsigned timer = 0; timer < 3; timer++) {
+        g_assert_false(timer_pending(rtc_wide_timer(&destination, timer)));
+    }
+
+    g_byte_array_unref(bytes);
+    destroy_timers(&source);
+    destroy_timers(&destination);
+}
