+#include "system/runstate.h"
+
+#define CRUCIBLE_LIFECYCLE_EVIDENCE_BYTES 304
+#define CRUCIBLE_LIFECYCLE_TERMINAL_CAUSE_DIRECT 1
+#define CRUCIBLE_LIFECYCLE_TERMINAL_CAUSE_READY_EXHAUSTED 2
+#define CRUCIBLE_LIFECYCLE_TERMINAL_CAUSE_FAIL_CLOSED 3
+#define CRUCIBLE_LIFECYCLE_TERMINAL_PREEXIT_VALID (1U << 0)
+#define CRUCIBLE_LIFECYCLE_TERMINAL_EXIT_REQUIRED (1U << 1)
+#define CRUCIBLE_LIFECYCLE_EXIT_CRASH 70
+#define CRUCIBLE_LIFECYCLE_EXIT_POWER_OFF 71
+#define CRUCIBLE_LIFECYCLE_EXIT_PERMANENT_FAILURE 72
+#define CRUCIBLE_HANG_EVIDENCE_BYTES 192
+#define CRUCIBLE_WATCHDOG_COMPOSITION_EVIDENCE_BYTES 192
+#define CRUCIBLE_LIFECYCLE_VMSTATE_MAX_PRESERVED_BYTES (48 * MiB)
+
+enum CrucibleLifecycleTransition {
+    CRUCIBLE_LIFECYCLE_BOOT = 1,
+    CRUCIBLE_LIFECYCLE_CRASH = 2,
+    CRUCIBLE_LIFECYCLE_RESET = 3,
+    CRUCIBLE_LIFECYCLE_POWER_OFF = 4,
+    CRUCIBLE_LIFECYCLE_POWER_CYCLE = 5,
+    CRUCIBLE_LIFECYCLE_PERMANENT_FAILURE = 6,
+};
+
+enum CrucibleHangEventKind {
+    CRUCIBLE_HANG_ACTIVATED = 1,
+    CRUCIBLE_HANG_RECOVERED = 2,
+    CRUCIBLE_HANG_WATCHDOG = 3,
+};
+
+enum CrucibleBootPolicyKind {
+    CRUCIBLE_BOOT_IMMEDIATE = 1,
+    CRUCIBLE_BOOT_REQUIRE_READY = 2,
+};
+
+typedef struct CrucibleLifecyclePlan {
+    uint32_t transition;
+    uint64_t downtime;
+    uint32_t volatile_policy;
+    uint32_t device_policy;
+    uint32_t boot_policy;
+    const char *ready_marker;
+    uint32_t maximum_attempts;
+    uint64_t retry_delay;
+    uint32_t exhausted_transition;
+} CrucibleLifecyclePlan;
+
+typedef struct CrucibleLifecyclePendingReset {
+    QemuCrucibleFaultRule *rule;
+    QemuCrucibleFaultEventReservation *reservation;
+    uint64_t observed_icount;
+    uint8_t before_hash[32];
+    uint8_t evidence[CRUCIBLE_LIFECYCLE_EVIDENCE_BYTES];
+    uint8_t *preserved_state;
+    size_t preserved_state_len;
+    bool complete_deferred;
+    char *ready_marker;
+    uint32_t boot_policy;
+    uint32_t maximum_attempts;
+    uint32_t attempt;
+    uint64_t retry_delay;
+    uint64_t ready_deadline_ns;
+    uint32_t exhausted_transition;
+    bool waiting_ready;
+    uint32_t vmstate_reservation_remaining;
+} CrucibleLifecyclePendingReset;
+
+typedef struct CrucibleHangState {
+    QemuCrucibleFaultRule *rule;
+    QemuCrucibleFaultEventReservation *activation_reservation;
+    QemuCrucibleFaultEventReservation *watchdog_reservation;
+    QemuCrucibleFaultEventReservation *recovery_reservation;
+    uint64_t entered_icount;
+    uint64_t entered_virtual_ns;
+    uint64_t watchdog_deadline_ns;
+    bool watchdog_enabled;
+    bool watchdog_fired;
+    uint32_t vmstate_activation_remaining;
+    uint32_t vmstate_watchdog_remaining;
+    uint32_t vmstate_recovery_remaining;
+} CrucibleHangState;
+
+typedef struct CrucibleHangApply {
+    bool node_hung;
+    GArray *vcpu_hung;
+} CrucibleHangApply;
+
+typedef struct CrucibleLifecycleVmstate {
+    CrucibleLifecyclePendingReset pending_reset;
+    GPtrArray *hangs;
+    GArray *vcpu_hung;
+    uint64_t next_watchdog_ns;
+    uint64_t process_generation;
+    uint32_t terminal_transition;
+    bool node_hung;
+    bool terminal_exit_requested;
+    bool replacement_handoff;
+    uint8_t terminal_action_sha256[32];
+    uint8_t terminal_evidence_sha256[32];
+} CrucibleLifecycleVmstate;
+
+static CrucibleLifecyclePendingReset crucible_lifecycle_pending_reset;
+static bool crucible_lifecycle_node_hung;
+static GArray *crucible_lifecycle_vcpu_hung;
+static GPtrArray *crucible_lifecycle_hangs;
+static uint64_t crucible_lifecycle_next_watchdog_ns = UINT64_MAX;
+static bool crucible_lifecycle_watchdog_transition_active;
+static uint32_t crucible_lifecycle_terminal_transition;
+static bool crucible_lifecycle_terminal_exit_requested;
+static uint8_t crucible_lifecycle_terminal_action_sha256[32];
+static uint8_t crucible_lifecycle_terminal_evidence_sha256[32];
+static uint64_t crucible_lifecycle_process_generation;
+
+bool qemu_crucible_fault_lifecycle_process_bound(void)
+{
+    return crucible_lifecycle_process_generation != 0;
+}
+
+static void crucible_lifecycle_sha256(const uint8_t *data, size_t length,
+                                      uint8_t digest[32]);
+
+static void crucible_lifecycle_terminal_evidence_digest(
+    const uint8_t *evidence, size_t evidence_len, uint8_t digest[32])
+{
+    uint8_t canonical[CRUCIBLE_LIFECYCLE_EVIDENCE_BYTES];
+
+    g_assert(evidence_len == sizeof(canonical));
+    memcpy(canonical, evidence, sizeof(canonical));
+    memset(canonical + 24, 0, 8);
+    crucible_lifecycle_sha256(canonical, sizeof(canonical), digest);
+}
+
+static bool crucible_lifecycle_mode(void)
+{
+    return strcmp(current_accel_name(), "sim") == 0 &&
+           icount_enabled() == ICOUNT_PRECISE;
+}
+
+uint64_t qemu_crucible_fault_lifecycle_process_generation(void)
+{
+    return crucible_lifecycle_process_generation;
+}
+
+int qemu_crucible_fault_lifecycle_rebind_process_generation(
+    uint64_t parent_process_generation,
+    uint64_t child_process_generation)
+{
+    if (!crucible_lifecycle_mode() || parent_process_generation == 0 ||
+        parent_process_generation == UINT64_MAX ||
+        child_process_generation != parent_process_generation + 1) {
+        return -EINVAL;
+    }
+    if (crucible_lifecycle_process_generation != parent_process_generation ||
+        crucible_lifecycle_terminal_transition != 0) {
+        return -EPROTO;
+    }
+    crucible_lifecycle_process_generation = child_process_generation;
+    return 0;
+}
+
+static int crucible_lifecycle_terminal_exit_code(uint32_t transition)
+{
+    switch (transition) {
+    case CRUCIBLE_LIFECYCLE_CRASH:
+        return CRUCIBLE_LIFECYCLE_EXIT_CRASH;
+    case CRUCIBLE_LIFECYCLE_POWER_OFF:
+        return CRUCIBLE_LIFECYCLE_EXIT_POWER_OFF;
+    case CRUCIBLE_LIFECYCLE_PERMANENT_FAILURE:
+        return CRUCIBLE_LIFECYCLE_EXIT_PERMANENT_FAILURE;
+    default:
+        return 0;
+    }
+}
+
+static int crucible_lifecycle_hex_nibble(char value)
+{
+    if (value >= '0' && value <= '9') {
+        return value - '0';
+    }
+    if (value >= 'a' && value <= 'f') {
+        return value - 'a' + 10;
+    }
+    return -1;
+}
+
+static bool crucible_lifecycle_parse_sha256(const char *text,
+                                            uint8_t digest[32])
+{
+    if (!text || strlen(text) != 64) {
+        return false;
+    }
+    for (size_t index = 0; index < 32; index++) {
+        int high = crucible_lifecycle_hex_nibble(text[index * 2]);
+        int low = crucible_lifecycle_hex_nibble(text[index * 2 + 1]);
+
+        if (high < 0 || low < 0) {
+            return false;
+        }
+        digest[index] = (high << 4) | low;
+    }
+    return true;
+}
+
+static void crucible_lifecycle_stage_terminal(
+    const QemuCrucibleFaultRule *rule, uint32_t transition,
+    const uint8_t *evidence, size_t evidence_len)
+{
+    g_assert(rule && evidence && evidence_len != 0);
+    g_assert(crucible_lifecycle_terminal_exit_code(transition) != 0);
+    g_assert(crucible_lifecycle_terminal_transition == 0);
+
+    crucible_lifecycle_terminal_transition = transition;
+    crucible_lifecycle_terminal_exit_requested = false;
+    memcpy(crucible_lifecycle_terminal_action_sha256,
+           qemu_crucible_fault_rule_action_hash(rule), 32);
+    crucible_lifecycle_terminal_evidence_digest(
+        evidence, evidence_len,
+        crucible_lifecycle_terminal_evidence_sha256);
+    if (qemu_plugin_crucible_vmstop_admit_internal() != 0) {
+        error_report("Crucible terminal lifecycle could not stop at its "
+                     "authorized boundary");
+        abort();
+    }
+}
+
+int qemu_plugin_crucible_lifecycle_set_process_generation(
+    uint64_t process_generation)
+{
+    if (!crucible_lifecycle_mode()) {
+        return -EPERM;
+    }
+    if (process_generation == 0) {
+        return -EINVAL;
+    }
+    if (crucible_lifecycle_process_generation != 0 ||
+        crucible_lifecycle_terminal_transition != 0) {
+        return -EALREADY;
+    }
+    crucible_lifecycle_process_generation = process_generation;
+    if (qemu_crucible_fault_vmstate_enable() != 0) {
+        crucible_lifecycle_process_generation = 0;
+        return -EIO;
+    }
+    return 0;
+}
+
+int qemu_plugin_crucible_lifecycle_complete_terminal_exit(
+    const char *action_sha256, const char *evidence_sha256,
+    uint64_t process_generation, bool *already_authorized,
+    int *exit_code)
+{
+    uint8_t action[32];
+    uint8_t evidence[32];
+    int code;
+
+    if (!already_authorized || !exit_code || process_generation == 0 ||
+        !crucible_lifecycle_parse_sha256(action_sha256, action) ||
+        !crucible_lifecycle_parse_sha256(evidence_sha256, evidence)) {
+        return -EINVAL;
+    }
+    *already_authorized = false;
+    *exit_code = 0;
+    if (!crucible_lifecycle_mode() ||
+        crucible_lifecycle_terminal_transition == 0) {
+        return -ENOENT;
+    }
+    if (crucible_lifecycle_process_generation == 0 ||
+        process_generation != crucible_lifecycle_process_generation) {
+        return -EACCES;
+    }
+    code = crucible_lifecycle_terminal_exit_code(
+        crucible_lifecycle_terminal_transition);
+    if (code == 0 ||
+        memcmp(action, crucible_lifecycle_terminal_action_sha256, 32) != 0 ||
+        memcmp(evidence,
+               crucible_lifecycle_terminal_evidence_sha256, 32) != 0) {
+        return -EACCES;
+    }
+    if (crucible_lifecycle_terminal_exit_requested) {
+        *already_authorized = true;
+        *exit_code = code;
+        return 0;
+    }
+    crucible_lifecycle_terminal_exit_requested = true;
+    qemu_system_shutdown_request_with_code(
+        SHUTDOWN_CAUSE_HOST_ERROR, code);
+    *exit_code = code;
+    return 0;
+}
+
+static bool crucible_lifecycle_field(
+    const QemuCrucibleFaultRule *rule, uint16_t tag, uint16_t type,
+    const uint8_t **data, uint32_t *length)
+{
+    return qemu_crucible_fault_rule_field(rule, tag, type, data, length);
+}
+
+static bool crucible_lifecycle_u32(
+    const QemuCrucibleFaultRule *rule, uint16_t tag, uint32_t *value)
+{
+    const uint8_t *data;
+    uint32_t length;
+
+    if (!crucible_lifecycle_field(rule, tag,
+            CRUCIBLE_NODE_FAULT_FIELD_TYPE_U32, &data, &length) ||
+        length != sizeof(*value)) {
+        return false;
+    }
+    *value = ldl_le_p(data);
+    return true;
+}
+
+static bool crucible_lifecycle_u64(
+    const QemuCrucibleFaultRule *rule, uint16_t tag, uint64_t *value)
+{
+    const uint8_t *data;
+    uint32_t length;
+
+    if (!crucible_lifecycle_field(rule, tag,
+            CRUCIBLE_NODE_FAULT_FIELD_TYPE_U64, &data, &length) ||
+        length != sizeof(*value)) {
+        return false;
+    }
+    *value = ldq_le_p(data);
+    return true;
+}
+
+static bool crucible_lifecycle_json_u64(const QObject *object,
+                                        uint64_t *value)
+{
+    QNum *number = qobject_to(QNum, object);
+
+    return number && number->kind != QNUM_DOUBLE &&
+           qnum_get_try_uint(number, value);
+}
+
+static bool crucible_lifecycle_transition_name(const char *name,
+                                               uint32_t *transition)
+{
+    static const char *const names[] = {
+        NULL, "boot", "crash", "reset", "power_off", "power_cycle",
+        "permanent_failure",
+    };
+
+    if (!name) {
+        return false;
+    }
+    for (uint32_t value = CRUCIBLE_LIFECYCLE_BOOT;
+         value <= CRUCIBLE_LIFECYCLE_PERMANENT_FAILURE; value++) {
+        if (strcmp(name, names[value]) == 0) {
+            *transition = value;
+            return true;
+        }
+    }
+    return false;
+}
+
+static bool crucible_lifecycle_state_policy(const QObject *object,
+                                            bool device,
+                                            uint32_t *policy)
+{
+    QString *string = qobject_to(QString, object);
+    const char *name = string ? qstring_get_str(string) : NULL;
+
+    if (name && strcmp(name, "preserve") == 0) {
+        *policy = 1;
+        return true;
+    }
+    if (name && strcmp(name, "clear") == 0) {
+        *policy = 2;
+        return true;
+    }
+    if (device && name && strcmp(name, "device_reset") == 0) {
+        *policy = 3;
+        return true;
+    }
+    return false;
+}
+
+static bool crucible_lifecycle_boot_policy(const QObject *object,
+                                           CrucibleLifecyclePlan *plan)
+{
+    QDict *policy = qobject_to(QDict, object);
+    QDict *parameters;
+    const char *kind;
+    const char *marker;
+    const char *exhausted;
+    uint64_t attempts;
+
+    kind = policy ? qdict_get_try_str(policy, "kind") : NULL;
+    if (!kind) {
+        return false;
+    }
+    if (strcmp(kind, "immediate") == 0) {
+        plan->boot_policy = CRUCIBLE_BOOT_IMMEDIATE;
+        plan->ready_marker = NULL;
+        plan->maximum_attempts = 1;
+        plan->retry_delay = 0;
+        plan->exhausted_transition = 0;
+        return true;
+    }
+    if (strcmp(kind, "require_ready") != 0) {
+        return false;
+    }
+    parameters = qdict_get_qdict(policy, "parameters");
+    marker = parameters ? qdict_get_try_str(parameters, "ready_marker") : NULL;
+    exhausted = parameters ? qdict_get_try_str(parameters, "exhausted") : NULL;
+    if (!marker || !*marker || !exhausted ||
+        !crucible_lifecycle_json_u64(
+            qdict_get(parameters, "maximum_attempts"), &attempts) ||
+        attempts == 0 || attempts > UINT32_MAX ||
+        !crucible_lifecycle_json_u64(
+            qdict_get(parameters, "retry_delay_nanos"), &plan->retry_delay) ||
+        !crucible_lifecycle_transition_name(
+            exhausted, &plan->exhausted_transition) ||
+        (plan->exhausted_transition != CRUCIBLE_LIFECYCLE_CRASH &&
+         plan->exhausted_transition != CRUCIBLE_LIFECYCLE_POWER_OFF &&
+         plan->exhausted_transition !=
+             CRUCIBLE_LIFECYCLE_PERMANENT_FAILURE)) {
+        return false;
+    }
+    plan->boot_policy = CRUCIBLE_BOOT_REQUIRE_READY;
+    plan->ready_marker = marker;
+    plan->maximum_attempts = attempts;
+    return true;
+}
+
+static bool crucible_lifecycle_direct_plan(
+    const QemuCrucibleFaultRule *rule, CrucibleLifecyclePlan *plan)
+{
+    const QObject *boot_policy = qemu_crucible_fault_rule_json(
+        rule, CRUCIBLE_NODE_FAULT_FIELD_P3);
+
+    return crucible_lifecycle_u32(
+               rule, CRUCIBLE_NODE_FAULT_FIELD_P1, &plan->transition) &&
+           crucible_lifecycle_u64(
+               rule, CRUCIBLE_NODE_FAULT_FIELD_P2, &plan->downtime) &&
+           crucible_lifecycle_u32(
+               rule, CRUCIBLE_NODE_FAULT_FIELD_P4,
+               &plan->volatile_policy) &&
+           crucible_lifecycle_u32(
+               rule, CRUCIBLE_NODE_FAULT_FIELD_P5, &plan->device_policy) &&
+           crucible_lifecycle_boot_policy(boot_policy, plan);
+}
+
+static bool crucible_lifecycle_watchdog_plan(
+    const QemuCrucibleFaultRule *rule, CrucibleLifecyclePlan *plan,
+    uint64_t *timeout)
+{
+    QDict *watchdog = qobject_to(QDict, qemu_crucible_fault_rule_json(
+        rule, CRUCIBLE_NODE_FAULT_FIELD_P4));
+    QDict *parameters;
+    const char *kind;
+    QString *transition;
+
+    kind = watchdog ? qdict_get_try_str(watchdog, "kind") : NULL;
+    if (!kind || strcmp(kind, "transition_after") != 0) {
+        return false;
+    }
+    parameters = qdict_get_qdict(watchdog, "parameters");
+    transition = parameters ?
+        qobject_to(QString, qdict_get(parameters, "transition")) : NULL;
+    return parameters && transition &&
+           crucible_lifecycle_json_u64(
+               qdict_get(parameters, "timeout_nanos"), timeout) &&
+           *timeout != 0 &&
+           crucible_lifecycle_json_u64(
+               qdict_get(parameters, "downtime_nanos"), &plan->downtime) &&
+           crucible_lifecycle_transition_name(
+               qstring_get_str(transition), &plan->transition) &&
+           crucible_lifecycle_state_policy(
+               qdict_get(parameters, "volatile_state_policy"), false,
+               &plan->volatile_policy) &&
+           crucible_lifecycle_state_policy(
+               qdict_get(parameters, "device_state_policy"), true,
+               &plan->device_policy) &&
+           crucible_lifecycle_boot_policy(
+               qdict_get(parameters, "boot_policy"), plan);
+}
+
+static void crucible_lifecycle_sha256(const uint8_t *data, size_t length,
+                                      uint8_t digest[32])
+{
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    gsize digest_length = 32;
+
+    g_checksum_update(checksum, data, length);
+    g_checksum_get_digest(checksum, digest, &digest_length);
+    g_assert(digest_length == 32);
+}
+
+static bool crucible_lifecycle_snapshot(uint8_t digest[32],
+                                        uint64_t *ram_bytes,
+                                        uint64_t *device_bytes)
+{
+    uint8_t material[64] = { 0 };
+    uint8_t device_digest[32];
+    uint64_t ram_hash;
+
+    ram_hash = qemu_crucible_ram_hash(ram_bytes);
+    if (qemu_crucible_device_state_sha256(
+            device_digest, device_bytes) != 0) {
+        return false;
+    }
+    memcpy(material, "CRUCLFS1", 8);
+    stq_le_p(material + 8, ram_hash);
+    stq_le_p(material + 16, *ram_bytes);
+    stq_le_p(material + 24, *device_bytes);
+    memcpy(material + 32, device_digest, 32);
+    crucible_lifecycle_sha256(material, sizeof(material), digest);
+    return true;
+}
+
+int qemu_crucible_fault_lifecycle_precondition(
+    const QemuCrucibleFaultRule *rule,
+    uint8_t digest[32])
+{
+    uint64_t ram_bytes;
+    uint64_t device_bytes;
+
+    if (qemu_crucible_fault_rule_command_kind(rule) !=
+            CRUCIBLE_FAULT_COMMAND_NODE_LIFECYCLE ||
+        qemu_crucible_fault_rule_operation(rule) !=
+            CRUCIBLE_NODE_FAULT_OPERATION_APPLY) {
+        return -EINVAL;
+    }
+    return crucible_lifecycle_snapshot(
+        digest, &ram_bytes, &device_bytes) ? 0 : -EIO;
+}
+
+static int crucible_lifecycle_capture_state(uint32_t domains,
+                                            uint8_t **state,
+                                            size_t *state_len)
+{
+    Error *local_err = NULL;
+    QIOChannelBuffer *buffer;
+    QEMUFile *file;
+    int status;
+    int close_status;
+
+    *state = NULL;
+    *state_len = 0;
+    if (domains == 0) {
+        return 0;
+    }
+    buffer = qio_channel_buffer_new(4096);
+    file = qemu_file_new_output(QIO_CHANNEL(buffer));
+    status = qemu_save_device_state_domains(file, domains, &local_err);
+    if (status != 0 && local_err) {
+        error_report_err(g_steal_pointer(&local_err));
+    }
+    if (status == 0) {
+        status = qemu_fflush(file);
+    }
+    if (status == 0) {
+        status = qemu_file_get_error(file);
+    }
+    if (status == 0 && buffer->usage == 0) {
+        status = -EIO;
+    }
+    if (status == 0) {
+        *state = g_memdup2(buffer->data, buffer->usage);
+        *state_len = buffer->usage;
+    }
+    close_status = qemu_fclose(file);
+    object_unref(OBJECT(buffer));
+    if (status == 0 && close_status != 0) {
+        status = close_status;
+    }
+    if (status != 0) {
+        g_clear_pointer(state, g_free);
+        *state_len = 0;
+    }
+    return status;
+}
+
+static int crucible_lifecycle_restore_state(const uint8_t *state,
+                                             size_t state_len)
+{
+    Error *local_err = NULL;
+    QIOChannelBuffer *buffer;
+    QEMUFile *file;
+    int status;
+    int close_status;
+
+    if (!state_len) {
+        return 0;
+    }
+    buffer = qio_channel_buffer_new(state_len);
+    memcpy(buffer->data, state, state_len);
+    buffer->usage = state_len;
+    file = qemu_file_new_input(QIO_CHANNEL(buffer));
+    status = qemu_load_device_state(file, &local_err);
+    if (status != 0 && local_err) {
+        error_report_err(g_steal_pointer(&local_err));
+    }
+    close_status = qemu_fclose(file);
+    object_unref(OBJECT(buffer));
+    return status == 0 ? close_status : status;
+}
+
+static void crucible_lifecycle_pending_clear(
+    CrucibleLifecyclePendingReset *pending)
+{
+    qemu_crucible_fault_event_reservation_release(pending->reservation);
+    qemu_crucible_fault_rule_unref(pending->rule);
+    g_free(pending->preserved_state);
+    g_free(pending->ready_marker);
+    memset(pending, 0, sizeof(*pending));
+}
+
+static int crucible_lifecycle_clear_ram_block(RAMBlock *block, void *opaque)
+{
+    uint64_t *cleared = opaque;
+
+    if (!block->mr || !memory_region_is_ram(block->mr) ||
+        memory_region_is_rom(block->mr) ||
+        memory_region_is_nonvolatile(block->mr)) {
+        return 0;
+    }
+    memset(block->host, 0, block->used_length);
+    memory_region_set_dirty(block->mr, 0, block->used_length);
+    if (*cleared > UINT64_MAX - block->used_length) {
+        return -EOVERFLOW;
+    }
+    *cleared += block->used_length;
+    return 0;
+}
+
+static bool crucible_lifecycle_clear_ram(uint64_t *cleared)
+{
+    CPUState *cpu;
+
+    *cleared = 0;
+    if (qemu_ram_foreach_block(
+            crucible_lifecycle_clear_ram_block, cleared) != 0) {
+        return false;
+    }
+    cpu = qemu_get_cpu(0);
+    if (!cpu) {
+        return false;
+    }
+    tb_flush__exclusive_or_serial();
+    return true;
+}
+
+static void crucible_lifecycle_evidence_begin(
+    uint8_t evidence[CRUCIBLE_LIFECYCLE_EVIDENCE_BYTES],
+    const QemuCrucibleFaultRule *rule, uint32_t transition,
+    uint64_t downtime, uint32_t volatile_policy, uint32_t device_policy,
+    uint64_t observed_icount, int64_t virtual_before,
+    uint64_t ram_bytes, uint64_t device_bytes)
+{
+    memcpy(evidence, "CRUCLIF1", 8);
+    stw_le_p(evidence + 8, 1);
+    stw_le_p(evidence + 10, transition);
+    stl_le_p(evidence + 12, volatile_policy);
+    stl_le_p(evidence + 16, device_policy);
+    stq_le_p(evidence + 24, observed_icount);
+    stq_le_p(evidence + 32, virtual_before);
+    stq_le_p(evidence + 40, downtime);
+    stq_le_p(evidence + 48, ram_bytes);
+    stq_le_p(evidence + 56, device_bytes);
+    memcpy(evidence + 64, qemu_crucible_fault_rule_binding_hash(rule), 32);
+}
+
+static int crucible_lifecycle_advance_downtime(uint64_t downtime,
+                                               int64_t *after)
+{
+    int64_t before = icount_get_observed();
+
+    if (downtime > INT64_MAX || before > INT64_MAX - (int64_t)downtime) {
+        return -EOVERFLOW;
+    }
+    *after = before + downtime;
+    if (downtime != 0) {
+        icount_advance_virtual_time_to_ns(*after);
+    }
+    return 0;
+}
+
+static int crucible_lifecycle_execute(
+    const QemuCrucibleFaultRule *rule, uint64_t observed_icount,
+    const CrucibleLifecyclePlan *plan, bool complete_deferred,
+    uint8_t before_hash[32], uint8_t after_hash[32], GByteArray *evidence,
+    uint16_t *outcome,
+    QemuCrucibleFaultEventReservation **event_reservation)
+{
+    uint8_t bytes[CRUCIBLE_LIFECYCLE_EVIDENCE_BYTES] = { 0 };
+    g_autofree uint8_t *preserved_state = NULL;
+    uint32_t transition = plan->transition;
+    uint32_t volatile_policy = plan->volatile_policy;
+    uint32_t device_policy = plan->device_policy;
+    uint32_t preserved_domains = 0;
+    uint64_t downtime = plan->downtime;
+    uint64_t ram_bytes, device_bytes, cleared = 0;
+    size_t preserved_state_len = 0;
+    int64_t virtual_before = icount_get_observed();
+    int64_t virtual_after;
+    bool reset_transition;
+
+    if (crucible_lifecycle_terminal_transition != 0 ||
+        !crucible_lifecycle_snapshot(before_hash, &ram_bytes,
+                                      &device_bytes)) {
+        return -EINVAL;
+    }
+    reset_transition = transition == CRUCIBLE_LIFECYCLE_BOOT ||
+                       transition == CRUCIBLE_LIFECYCLE_RESET ||
+                       transition == CRUCIBLE_LIFECYCLE_POWER_CYCLE;
+    if (reset_transition) {
+        CrucibleLifecyclePendingReset *pending =
+            &crucible_lifecycle_pending_reset;
+
+        if (pending->rule || !event_reservation || !*event_reservation) {
+            return -EBUSY;
+        }
+        if (volatile_policy == 1) {
+            preserved_domains |= QEMU_CRUCIBLE_LIFECYCLE_STATE_VOLATILE;
+        }
+        if (device_policy == 1) {
+            preserved_domains |= QEMU_CRUCIBLE_LIFECYCLE_STATE_DEVICE;
+        }
+        if (crucible_lifecycle_capture_state(
+                preserved_domains, &preserved_state,
+                &preserved_state_len) != 0) {
+            return -EIO;
+        }
+    }
+    if (crucible_lifecycle_advance_downtime(
+            downtime, &virtual_after) != 0) {
+        return -EOVERFLOW;
+    }
+    if (volatile_policy == 2 && !crucible_lifecycle_clear_ram(&cleared)) {
+        return -EIO;
+    }
+    crucible_lifecycle_evidence_begin(
+        bytes, rule, transition, downtime, volatile_policy, device_policy,
+        observed_icount, virtual_before, ram_bytes, device_bytes);
+    stw_le_p(bytes + 8, 4);
+    stl_le_p(bytes + 192, plan->boot_policy);
+    stl_le_p(bytes + 196, 1);
+    stl_le_p(bytes + 200, plan->maximum_attempts);
+    stl_le_p(bytes + 204, plan->exhausted_transition);
+    stq_le_p(bytes + 208, plan->retry_delay);
+    stq_le_p(bytes + 216, UINT64_MAX);
+    if (plan->ready_marker) {
+        crucible_lifecycle_sha256(
+            (const uint8_t *)plan->ready_marker,
+            strlen(plan->ready_marker), bytes + 224);
+    }
+    stq_le_p(bytes + 96, virtual_after);
+    stq_le_p(bytes + 104, cleared);
+    stl_le_p(bytes + 20, preserved_domains);
+    if (reset_transition) {
+        CrucibleLifecyclePendingReset *pending =
+            &crucible_lifecycle_pending_reset;
+
+        pending->rule = qemu_crucible_fault_rule_copy(rule);
+        pending->reservation = *event_reservation;
+        *event_reservation = NULL;
+        pending->observed_icount = observed_icount;
+        memcpy(pending->before_hash, before_hash, 32);
+        memcpy(pending->evidence, bytes, sizeof(bytes));
+        pending->preserved_state = g_steal_pointer(&preserved_state);
+        pending->preserved_state_len = preserved_state_len;
+        pending->complete_deferred = complete_deferred;
+        pending->boot_policy = plan->boot_policy;
+        pending->ready_marker = g_strdup(plan->ready_marker);
+        pending->maximum_attempts = plan->maximum_attempts;
+        pending->attempt = 1;
+        pending->retry_delay = plan->retry_delay;
+        pending->ready_deadline_ns = UINT64_MAX;
+        pending->exhausted_transition = plan->exhausted_transition;
+        qemu_system_reset_request(SHUTDOWN_CAUSE_HOST_QMP_SYSTEM_RESET);
+        return QEMU_CRUCIBLE_FAULT_IMPULSE_DEFERRED;
+    }
+
+    {
+        uint8_t current_hash[32];
+        uint8_t terminal_material[48] = { 0 };
+
+        if (!crucible_lifecycle_snapshot(
+                current_hash, &ram_bytes, &device_bytes)) {
+            return -EIO;
+        }
+        memcpy(terminal_material, "CRUCTRM1", 8);
+        stl_le_p(terminal_material + 8, transition);
+        memcpy(terminal_material + 16, current_hash, 32);
+        crucible_lifecycle_sha256(
+            terminal_material, sizeof(terminal_material), after_hash);
+        memcpy(bytes + 256, current_hash, sizeof(current_hash));
+    }
+    stl_le_p(bytes + 288, transition);
+    stl_le_p(bytes + 292, CRUCIBLE_LIFECYCLE_TERMINAL_CAUSE_DIRECT);
+    stl_le_p(bytes + 296,
+             CRUCIBLE_LIFECYCLE_TERMINAL_PREEXIT_VALID |
+             CRUCIBLE_LIFECYCLE_TERMINAL_EXIT_REQUIRED);
+    stq_le_p(bytes + 112, ram_bytes);
+    stq_le_p(bytes + 120, device_bytes);
+    memcpy(bytes + 128, before_hash, 32);
+    memcpy(bytes + 160, after_hash, 32);
+    g_byte_array_append(evidence, bytes, sizeof(bytes));
+    *outcome = CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED;
+    if (crucible_lifecycle_terminal_exit_code(transition) == 0) {
+        return -EINVAL;
+    }
+    crucible_lifecycle_stage_terminal(
+        rule, transition, bytes, sizeof(bytes));
+    return 0;
+}
+
+static void crucible_lifecycle_pending_fail_closed(
+    CrucibleLifecyclePendingReset *pending)
+{
+    uint8_t opportunity_hash[32], after_hash[32], current_hash[32];
+    uint8_t terminal_material[48] = { 0 };
+    uint64_t ram_bytes, device_bytes;
+    uint32_t flags = CRUCIBLE_LIFECYCLE_TERMINAL_EXIT_REQUIRED;
+
+    memcpy(after_hash, pending->before_hash, sizeof(after_hash));
+    if (crucible_lifecycle_snapshot(
+            current_hash, &ram_bytes, &device_bytes)) {
+        memcpy(terminal_material, "CRUCTRM1", 8);
+        stl_le_p(terminal_material + 8,
+                 CRUCIBLE_LIFECYCLE_PERMANENT_FAILURE);
+        memcpy(terminal_material + 16, current_hash, 32);
+        crucible_lifecycle_sha256(
+            terminal_material, sizeof(terminal_material), after_hash);
+        stq_le_p(pending->evidence + 112, ram_bytes);
+        stq_le_p(pending->evidence + 120, device_bytes);
+        memcpy(pending->evidence + 256, current_hash, 32);
+        flags |= CRUCIBLE_LIFECYCLE_TERMINAL_PREEXIT_VALID;
+    }
+    memcpy(pending->evidence + 128, pending->before_hash, 32);
+    memcpy(pending->evidence + 160, after_hash, 32);
+    stl_le_p(pending->evidence + 288,
+             CRUCIBLE_LIFECYCLE_PERMANENT_FAILURE);
+    stl_le_p(pending->evidence + 292,
+             CRUCIBLE_LIFECYCLE_TERMINAL_CAUSE_FAIL_CLOSED);
+    stl_le_p(pending->evidence + 296, flags);
+    crucible_lifecycle_sha256(
+        pending->evidence, sizeof(pending->evidence), opportunity_hash);
+    qemu_crucible_fault_event_reservation_consume(
+        pending->reservation);
+    qemu_crucible_fault_rule_event(
+        pending->rule, CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR,
+        pending->observed_icount, opportunity_hash,
+        pending->before_hash, after_hash,
+        pending->evidence, sizeof(pending->evidence));
+    if (pending->complete_deferred) {
+        qemu_crucible_fault_fail_deferred(
+            pending->rule, pending->observed_icount,
+            pending->before_hash);
+    }
+    crucible_lifecycle_stage_terminal(
+        pending->rule, CRUCIBLE_LIFECYCLE_PERMANENT_FAILURE,
+        pending->evidence, sizeof(pending->evidence));
+    crucible_lifecycle_pending_clear(pending);
+}
+
+static bool crucible_lifecycle_pending_complete(
+    CrucibleLifecyclePendingReset *pending, uint64_t completed_icount)
+{
+    uint8_t after_hash[32], opportunity_hash[32];
+    uint64_t ram_bytes, device_bytes;
+    uint32_t transition;
+
+    if (!crucible_lifecycle_u32(
+            pending->rule, CRUCIBLE_NODE_FAULT_FIELD_P1, &transition) ||
+        !crucible_lifecycle_snapshot(after_hash, &ram_bytes, &device_bytes)) {
+        crucible_lifecycle_pending_fail_closed(pending);
+        return false;
+    }
+    stq_le_p(pending->evidence + 112, ram_bytes);
+    stq_le_p(pending->evidence + 120, device_bytes);
+    memcpy(pending->evidence + 128, pending->before_hash, 32);
+    memcpy(pending->evidence + 160, after_hash, 32);
+    stl_le_p(pending->evidence + 288, transition);
+    crucible_lifecycle_sha256(pending->evidence,
+                              sizeof(pending->evidence), opportunity_hash);
+    qemu_crucible_fault_event_reservation_consume(pending->reservation);
+    qemu_crucible_fault_rule_event(
+        pending->rule, CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED,
+        pending->observed_icount, opportunity_hash,
+        pending->before_hash, after_hash,
+        pending->evidence, sizeof(pending->evidence));
+    if (pending->complete_deferred) {
+        qemu_crucible_fault_complete_deferred(
+            pending->rule, pending->observed_icount, completed_icount,
+            pending->before_hash, after_hash);
+    }
+    crucible_lifecycle_pending_clear(pending);
+    return true;
+}
+
+static int crucible_lifecycle_impulse(
+    const QemuCrucibleFaultRule *rule, uint64_t observed_icount,
+    uint8_t before_hash[32], uint8_t after_hash[32], GByteArray *evidence,
+    uint16_t *outcome,
+    QemuCrucibleFaultEventReservation **event_reservation)
+{
+    CrucibleLifecyclePlan plan;
+
+    if (!crucible_lifecycle_direct_plan(rule, &plan)) {
+        return -EINVAL;
+    }
+    return crucible_lifecycle_execute(
+        rule, observed_icount, &plan, true, before_hash, after_hash,
+        evidence, outcome, event_reservation);
+}
+
+void qemu_crucible_fault_lifecycle_reset_complete(void)
+{
+    CrucibleLifecyclePendingReset *pending =
+        &crucible_lifecycle_pending_reset;
+    int64_t now;
+
+    if (!pending->rule) {
+        return;
+    }
+    if (crucible_lifecycle_restore_state(
+            pending->preserved_state, pending->preserved_state_len) != 0) {
+        crucible_lifecycle_pending_fail_closed(pending);
+        return;
+    }
+    if (pending->boot_policy == CRUCIBLE_BOOT_REQUIRE_READY) {
+        now = icount_get_observed();
+        if (now < 0 || pending->retry_delay > INT64_MAX - now) {
+            crucible_lifecycle_pending_fail_closed(pending);
+            return;
+        }
+        pending->waiting_ready = true;
+        pending->ready_deadline_ns = now + pending->retry_delay;
+        stl_le_p(pending->evidence + 196, pending->attempt);
+        stq_le_p(pending->evidence + 216, pending->ready_deadline_ns);
+        return;
+    }
+    crucible_lifecycle_pending_complete(
+        pending, MAX(pending->observed_icount, qemu_plugin_icount_raw()));
+}
+
+int qemu_plugin_crucible_fault_ready_marker(
+    const char *marker, size_t marker_len, uint64_t observed_icount)
+{
+    CrucibleLifecyclePendingReset *pending =
+        &crucible_lifecycle_pending_reset;
+    bool completed;
+
+    if (!marker || marker_len == 0 || marker_len > 255) {
+        return -EINVAL;
+    }
+    if (!crucible_lifecycle_mode() ||
+        !qemu_plugin_crucible_single_threaded_rr() ||
+        !qemu_plugin_crucible_control_boundary_active() ||
+        !qemu_plugin_crucible_exact_boundary_active() || !bql_locked()) {
+        return -EPERM;
+    }
+    if (!pending->rule || !pending->waiting_ready ||
+        strlen(pending->ready_marker) != marker_len ||
+        memcmp(pending->ready_marker, marker, marker_len) != 0) {
+        return 0;
+    }
+    if (observed_icount != qemu_plugin_icount_raw()) {
+        return -EINVAL;
+    }
+    pending->waiting_ready = false;
+    completed = crucible_lifecycle_pending_complete(pending, observed_icount);
+    return completed ? 1 : -EIO;
+}
+
+static bool crucible_lifecycle_vcpu_exists(uint32_t target)
+{
+    return qemu_get_cpu(target) != NULL;
+}
+
+int qemu_crucible_fault_lifecycle_validate(
+    const QemuCrucibleFaultRule *rule)
+{
+    uint16_t kind = qemu_crucible_fault_rule_command_kind(rule);
+    uint32_t value;
+
+    if (!crucible_lifecycle_mode()) {
+        return -ENOTSUP;
+    }
+    if (kind == CRUCIBLE_FAULT_COMMAND_NODE_LIFECYCLE) {
+        CrucibleLifecyclePlan plan;
+
+        return qemu_crucible_fault_rule_operation(rule) ==
+                   CRUCIBLE_NODE_FAULT_OPERATION_APPLY &&
+               crucible_lifecycle_direct_plan(rule, &plan) &&
+               plan.transition >= CRUCIBLE_LIFECYCLE_BOOT &&
+               plan.transition <= CRUCIBLE_LIFECYCLE_PERMANENT_FAILURE &&
+               plan.volatile_policy >= 1 && plan.volatile_policy <= 2 &&
+               plan.device_policy >= 1 && plan.device_policy <= 3 &&
+               plan.downtime <= INT64_MAX ? 0 : -EINVAL;
+    }
+    if (kind == CRUCIBLE_FAULT_COMMAND_NODE_HANG) {
+        const QObject *object;
+        QDict *scope;
+        QList *list;
+        QListEntry *entry;
+
+        if (qemu_crucible_fault_rule_operation(rule) ==
+                CRUCIBLE_NODE_FAULT_OPERATION_REMOVE) {
+            return 0;
+        }
+        if (!crucible_lifecycle_u32(
+                rule, CRUCIBLE_NODE_FAULT_FIELD_P1, &value)) {
+            return -EINVAL;
+        }
+        {
+            CrucibleLifecyclePlan plan;
+            uint64_t timeout;
+            QDict *watchdog = qobject_to(
+                QDict, qemu_crucible_fault_rule_json(
+                    rule, CRUCIBLE_NODE_FAULT_FIELD_P4));
+            const char *watchdog_kind =
+                watchdog ? qdict_get_try_str(watchdog, "kind") : NULL;
+
+            if (!watchdog_kind ||
+                (strcmp(watchdog_kind, "disabled") != 0 &&
+                 (!crucible_lifecycle_watchdog_plan(
+                      rule, &plan, &timeout) ||
+                  timeout > INT64_MAX || plan.downtime > INT64_MAX))) {
+                return -EINVAL;
+            }
+        }
+        if (value == 1) {
+            return 0;
+        }
+        object = qemu_crucible_fault_rule_json(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_P2);
+        scope = qobject_to(QDict, object);
+        list = scope ? qobject_to(QList, qdict_get(scope, "parameters")) : NULL;
+        if (value != 2 || !list || qlist_empty(list)) {
+            return value == 3 ? 0 : -EINVAL;
+        }
+        QLIST_FOREACH_ENTRY(list, entry) {
+            uint64_t vcpu = qnum_get_uint(
+                qobject_to(QNum, qlist_entry_obj(entry)));
+
+            if (vcpu > UINT32_MAX || !crucible_lifecycle_vcpu_exists(vcpu)) {
+                return -EINVAL;
+            }
+        }
+        return 0;
+    }
+    return -EINVAL;
+}
+
+size_t qemu_crucible_fault_lifecycle_event_budget(
+    const QemuCrucibleFaultRule *rule)
+{
+    CrucibleLifecyclePlan plan;
+    uint64_t timeout;
+
+    if (qemu_crucible_fault_rule_command_kind(rule) !=
+            CRUCIBLE_FAULT_COMMAND_NODE_HANG ||
+        qemu_crucible_fault_rule_operation(rule) !=
+            CRUCIBLE_NODE_FAULT_OPERATION_UPSERT) {
+        return 0;
+    }
+    return crucible_lifecycle_watchdog_plan(rule, &plan, &timeout) ? 3 : 2;
+}
+
+static void crucible_lifecycle_apply_hang(
+    const QemuCrucibleFaultRule *rule, void *opaque)
+{
+    CrucibleHangApply *apply = opaque;
+    const QObject *object;
+    QDict *scope;
+    QList *list;
+    QListEntry *entry;
+    uint32_t kind;
+
+    if (!crucible_lifecycle_u32(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_P1, &kind)) {
+        abort();
+    }
+    if (kind == 1) {
+        apply->node_hung = true;
+        return;
+    }
+    if (kind != 2) {
+        return;
+    }
+    object = qemu_crucible_fault_rule_json(
+        rule, CRUCIBLE_NODE_FAULT_FIELD_P2);
+    scope = qobject_to(QDict, object);
+    list = scope ? qobject_to(QList, qdict_get(scope, "parameters")) : NULL;
+    if (!list) {
+        abort();
+    }
+    QLIST_FOREACH_ENTRY(list, entry) {
+        uint64_t vcpu = qnum_get_uint(
+            qobject_to(QNum, qlist_entry_obj(entry)));
+
+        if (vcpu >= apply->vcpu_hung->len) {
+            abort();
+        }
+        g_array_index(apply->vcpu_hung, bool, vcpu) = true;
+    }
+}
+
+static void crucible_hang_state_free(gpointer opaque)
+{
+    CrucibleHangState *state = opaque;
+
+    if (!state) {
+        return;
+    }
+    if (state->activation_reservation) {
+        qemu_crucible_fault_event_reservation_release(
+            state->activation_reservation);
+    }
+    if (state->watchdog_reservation) {
+        qemu_crucible_fault_event_reservation_release(
+            state->watchdog_reservation);
+    }
+    if (state->recovery_reservation) {
+        qemu_crucible_fault_event_reservation_release(
+            state->recovery_reservation);
+    }
+    qemu_crucible_fault_rule_unref(state->rule);
+    g_free(state);
+}
+
+static void crucible_hang_digest(const GPtrArray *states,
+                                 uint8_t digest[32])
+{
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    gsize digest_length = 32;
+
+    g_checksum_update(checksum, (const uint8_t *)"CRUCHGS1", 8);
+    if (states) {
+        for (guint index = 0; index < states->len; index++) {
+            CrucibleHangState *state = g_ptr_array_index(states, index);
+            uint8_t scalar[40] = { 0 };
+
+            stq_le_p(scalar, qemu_crucible_fault_rule_generation(
+                state->rule));
+            stq_le_p(scalar + 8, state->entered_icount);
+            stq_le_p(scalar + 16, state->entered_virtual_ns);
+            stq_le_p(scalar + 24, state->watchdog_deadline_ns);
+            scalar[32] = state->watchdog_enabled;
+            scalar[33] = state->watchdog_fired;
+            g_checksum_update(
+                checksum, qemu_crucible_fault_rule_binding_hash(state->rule),
+                32);
+            g_checksum_update(checksum, scalar, sizeof(scalar));
+        }
+    }
+    g_checksum_get_digest(checksum, digest, &digest_length);
+    g_assert(digest_length == 32);
+}
+
+static void crucible_hang_event(
+    CrucibleHangState *state, uint32_t event_kind,
+    QemuCrucibleFaultEventReservation **reservation,
+    const uint8_t before_hash[32], const uint8_t after_hash[32])
+{
+    uint8_t evidence[CRUCIBLE_HANG_EVIDENCE_BYTES] = { 0 };
+    uint8_t opportunity_hash[32];
+    uint32_t scope;
+    uint64_t now = icount_get_observed();
+
+    if (!reservation || !*reservation ||
+        !crucible_lifecycle_u32(
+            state->rule, CRUCIBLE_NODE_FAULT_FIELD_P1, &scope)) {
+        error_report("Crucible hang transition lacked reserved evidence");
+        abort();
+    }
+    memcpy(evidence, "CRUCHNG1", 8);
+    stw_le_p(evidence + 8, 1);
+    stw_le_p(evidence + 10, event_kind);
+    stl_le_p(evidence + 12, scope);
+    stq_le_p(evidence + 16, state->entered_icount);
+    stq_le_p(evidence + 24, state->entered_virtual_ns);
+    stq_le_p(evidence + 32, now);
+    stq_le_p(evidence + 40, state->watchdog_deadline_ns);
+    stq_le_p(evidence + 48,
+             qemu_crucible_fault_rule_generation(state->rule));
+    stq_le_p(evidence + 56, qemu_plugin_icount_raw());
+    memcpy(evidence + 64,
+           qemu_crucible_fault_rule_binding_hash(state->rule), 32);
+    memcpy(evidence + 96,
+           qemu_crucible_fault_rule_action_hash(state->rule), 32);
+    memcpy(evidence + 128, before_hash, 32);
+    memcpy(evidence + 160, after_hash, 32);
+    crucible_lifecycle_sha256(
+        evidence, sizeof(evidence), opportunity_hash);
+    qemu_crucible_fault_event_reservation_consume(*reservation);
+    qemu_crucible_fault_rule_event(
+        state->rule, CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED,
+        qemu_plugin_icount_raw(), opportunity_hash, before_hash, after_hash,
+        evidence, sizeof(evidence));
+    qemu_crucible_fault_event_reservation_release(*reservation);
+    *reservation = NULL;
+}
+
+typedef struct CrucibleHangRebuild {
+    GPtrArray *previous;
+    GPtrArray *next;
+    const QemuCrucibleFaultRule *transition_rule;
+    QemuCrucibleFaultEventReservation **event_reservation;
+} CrucibleHangRebuild;
+
+static CrucibleHangState *crucible_hang_previous_take(
+    CrucibleHangRebuild *rebuild, const QemuCrucibleFaultRule *rule)
+{
+    for (guint index = 0; index < rebuild->previous->len; index++) {
+        CrucibleHangState *state =
+            g_ptr_array_index(rebuild->previous, index);
+
+        if (qemu_crucible_fault_rule_generation(state->rule) ==
+                qemu_crucible_fault_rule_generation(rule) &&
+            memcmp(qemu_crucible_fault_rule_binding_hash(state->rule),
+                   qemu_crucible_fault_rule_binding_hash(rule), 32) == 0) {
+            return g_ptr_array_steal_index(rebuild->previous, index);
+        }
+    }
+    return NULL;
+}
+
+static void crucible_hang_rebuild_visit(
+    const QemuCrucibleFaultRule *rule, void *opaque)
+{
+    CrucibleHangRebuild *rebuild = opaque;
+    CrucibleHangState *state =
+        crucible_hang_previous_take(rebuild, rule);
+    CrucibleLifecyclePlan plan;
+    uint64_t timeout;
+    int64_t entered_virtual_ns;
+
+    if (state) {
+        g_ptr_array_add(rebuild->next, state);
+        return;
+    }
+    if (!rebuild->transition_rule || !rebuild->event_reservation ||
+        !*rebuild->event_reservation ||
+        memcmp(qemu_crucible_fault_rule_binding_hash(rule),
+               qemu_crucible_fault_rule_binding_hash(
+                   rebuild->transition_rule), 32) != 0) {
+        error_report("Crucible hang activation lacked prepared evidence");
+        abort();
+    }
+    state = g_new0(CrucibleHangState, 1);
+    state->rule = qemu_crucible_fault_rule_copy(rule);
+    state->entered_icount = qemu_plugin_icount_raw();
+    entered_virtual_ns = icount_get_observed();
+    if (entered_virtual_ns < 0) {
+        error_report("Crucible hang entered at negative virtual time");
+        abort();
+    }
+    state->entered_virtual_ns = entered_virtual_ns;
+    state->watchdog_enabled = crucible_lifecycle_watchdog_plan(
+        rule, &plan, &timeout);
+    if (state->watchdog_enabled) {
+        if (timeout > INT64_MAX - entered_virtual_ns) {
+            error_report("Crucible watchdog deadline overflowed after prepare");
+            abort();
+        }
+        state->watchdog_deadline_ns = state->entered_virtual_ns + timeout;
+    } else {
+        state->watchdog_deadline_ns = UINT64_MAX;
+    }
+    {
+        state->activation_reservation =
+            qemu_crucible_fault_event_reservation_split(
+                *rebuild->event_reservation, 1);
+        state->recovery_reservation =
+            qemu_crucible_fault_event_reservation_split(
+                *rebuild->event_reservation, 1);
+        if (state->watchdog_enabled) {
+            state->watchdog_reservation =
+                qemu_crucible_fault_event_reservation_split(
+                    *rebuild->event_reservation, 1);
+        }
+    }
+    g_ptr_array_add(rebuild->next, state);
+}
+
+static void crucible_hang_effective_recompute(void)
+{
+    CPUState *cpu;
+    guint count = 0;
+    CrucibleHangApply apply = { 0 };
+    GArray *next;
+
+    CPU_FOREACH(cpu) {
+        if (cpu->cpu_index < 0 || (guint)cpu->cpu_index != count) {
+            abort();
+        }
+        if (count == G_MAXUINT) {
+            abort();
+        }
+        count++;
+    }
+    next = g_array_sized_new(false, true, sizeof(bool), count);
+    g_array_set_size(next, count);
+    apply.vcpu_hung = next;
+    if (crucible_lifecycle_hangs) {
+        for (guint index = 0;
+             index < crucible_lifecycle_hangs->len; index++) {
+            CrucibleHangState *state =
+                g_ptr_array_index(crucible_lifecycle_hangs, index);
+
+            if (!state->watchdog_fired) {
+                crucible_lifecycle_apply_hang(state->rule, &apply);
+            }
+        }
+    }
+    if (crucible_lifecycle_vcpu_hung) {
+        g_array_unref(crucible_lifecycle_vcpu_hung);
+    }
+    crucible_lifecycle_vcpu_hung = next;
+    crucible_lifecycle_node_hung = apply.node_hung;
+}
+
+void qemu_crucible_fault_lifecycle_rules_changed(
+    const QemuCrucibleFaultRule *transition_rule,
+    QemuCrucibleFaultEventReservation **event_reservation)
+{
+    GPtrArray *previous;
+    GPtrArray *next_hangs;
+    CrucibleHangRebuild rebuild;
+    uint8_t before_hash[32], after_hash[32];
+
+    if (!crucible_lifecycle_mode()) {
+        return;
+    }
+    previous = crucible_lifecycle_hangs ?
+        crucible_lifecycle_hangs :
+        g_ptr_array_new_with_free_func(crucible_hang_state_free);
+    next_hangs = g_ptr_array_new_with_free_func(crucible_hang_state_free);
+    crucible_hang_digest(previous, before_hash);
+    rebuild = (CrucibleHangRebuild) {
+        .previous = previous,
+        .next = next_hangs,
+        .transition_rule = transition_rule,
+        .event_reservation = event_reservation,
+    };
+    qemu_crucible_fault_rule_foreach(
+        CRUCIBLE_FAULT_COMMAND_NODE_HANG,
+        crucible_hang_rebuild_visit, &rebuild);
+    crucible_hang_digest(next_hangs, after_hash);
+    for (guint index = 0; index < previous->len; index++) {
+        CrucibleHangState *state = g_ptr_array_index(previous, index);
+
+        if (state->recovery_reservation) {
+            crucible_hang_event(
+                state, CRUCIBLE_HANG_RECOVERED,
+                &state->recovery_reservation, before_hash, after_hash);
+        }
+    }
+    for (guint index = 0; index < next_hangs->len; index++) {
+        CrucibleHangState *state = g_ptr_array_index(next_hangs, index);
+        if (state->activation_reservation) {
+            crucible_hang_event(
+                state, CRUCIBLE_HANG_ACTIVATED,
+                &state->activation_reservation,
+                before_hash, after_hash);
+        }
+    }
+    g_ptr_array_unref(previous);
+    crucible_lifecycle_hangs = next_hangs;
+    crucible_lifecycle_next_watchdog_ns = UINT64_MAX;
+    for (guint index = 0; index < next_hangs->len; index++) {
+        CrucibleHangState *state = g_ptr_array_index(next_hangs, index);
+
+        if (state->watchdog_enabled && !state->watchdog_fired) {
+            crucible_lifecycle_next_watchdog_ns = MIN(
+                crucible_lifecycle_next_watchdog_ns,
+                state->watchdog_deadline_ns);
+        }
+    }
+    crucible_hang_effective_recompute();
+}
+
+bool qemu_crucible_fault_node_hung(void)
+{
+    return crucible_lifecycle_node_hung;
+}
+
+bool qemu_crucible_fault_vcpu_hung(uint32_t vcpu)
+{
+    return crucible_lifecycle_vcpu_hung &&
+           vcpu < crucible_lifecycle_vcpu_hung->len &&
+           g_array_index(crucible_lifecycle_vcpu_hung, bool, vcpu);
+}
+
+static void crucible_lifecycle_watchdog_recompute(void)
+{
+    crucible_lifecycle_next_watchdog_ns = UINT64_MAX;
+    if (!crucible_lifecycle_hangs) {
+        return;
+    }
+    for (guint index = 0; index < crucible_lifecycle_hangs->len; index++) {
+        CrucibleHangState *state =
+            g_ptr_array_index(crucible_lifecycle_hangs, index);
+
+        if (state->watchdog_enabled && !state->watchdog_fired) {
+            crucible_lifecycle_next_watchdog_ns = MIN(
+                crucible_lifecycle_next_watchdog_ns,
+                state->watchdog_deadline_ns);
+        }
+    }
+}
+
+static unsigned int crucible_lifecycle_transition_rank(uint32_t transition)
+{
+    switch (transition) {
+    case CRUCIBLE_LIFECYCLE_BOOT:
+        return 1;
+    case CRUCIBLE_LIFECYCLE_RESET:
+        return 2;
+    case CRUCIBLE_LIFECYCLE_POWER_CYCLE:
+        return 3;
+    case CRUCIBLE_LIFECYCLE_CRASH:
+        return 4;
+    case CRUCIBLE_LIFECYCLE_POWER_OFF:
+        return 5;
+    case CRUCIBLE_LIFECYCLE_PERMANENT_FAILURE:
+        return 6;
+    default:
+        return 0;
+    }
+}
+
+static unsigned int crucible_lifecycle_device_policy_rank(uint32_t policy)
+{
+    switch (policy) {
+    case 1: /* preserve */
+        return 1;
+    case 3: /* device_reset */
+        return 2;
+    case 2: /* clear */
+        return 3;
+    default:
+        return 0;
+    }
+}
+
+static void crucible_lifecycle_plan_compose(
+    CrucibleLifecyclePlan *resolved, const CrucibleLifecyclePlan *candidate)
+{
+    if (crucible_lifecycle_transition_rank(candidate->transition) >
+        crucible_lifecycle_transition_rank(resolved->transition)) {
+        resolved->transition = candidate->transition;
+        resolved->boot_policy = candidate->boot_policy;
+        resolved->ready_marker = candidate->ready_marker;
+        resolved->maximum_attempts = candidate->maximum_attempts;
+        resolved->retry_delay = candidate->retry_delay;
+        resolved->exhausted_transition = candidate->exhausted_transition;
+    }
+    resolved->downtime = MAX(resolved->downtime, candidate->downtime);
+    if (candidate->volatile_policy == 2) {
+        resolved->volatile_policy = 2;
+    }
+    if (crucible_lifecycle_device_policy_rank(candidate->device_policy) >
+        crucible_lifecycle_device_policy_rank(resolved->device_policy)) {
+        resolved->device_policy = candidate->device_policy;
+    }
+}
+
+static bool crucible_lifecycle_watchdog_wins(
+    const CrucibleHangState *candidate,
+    const CrucibleLifecyclePlan *candidate_plan,
+    const CrucibleHangState *winner,
+    const CrucibleLifecyclePlan *winner_plan)
+{
+    unsigned int candidate_rank =
+        crucible_lifecycle_transition_rank(candidate_plan->transition);
+    unsigned int winner_rank =
+        crucible_lifecycle_transition_rank(winner_plan->transition);
+
+    return candidate_rank > winner_rank ||
+           (candidate_rank == winner_rank &&
+            memcmp(qemu_crucible_fault_rule_binding_hash(candidate->rule),
+                   qemu_crucible_fault_rule_binding_hash(winner->rule),
+                   32) < 0);
+}
+
+static void crucible_lifecycle_watchdog_composition_event(
+    CrucibleHangState *state, const CrucibleHangState *winner,
+    const CrucibleLifecyclePlan *requested,
+    const CrucibleLifecyclePlan *resolved, uint64_t observed_icount,
+    uint64_t observed_virtual_ns, const uint8_t before_hash[32],
+    const uint8_t after_hash[32])
+{
+    uint8_t evidence[CRUCIBLE_WATCHDOG_COMPOSITION_EVIDENCE_BYTES] = { 0 };
+    uint8_t opportunity_hash[32];
+
+    if (!state->watchdog_reservation) {
+        error_report("Crucible composed watchdog lacked reserved evidence");
+        abort();
+    }
+    memcpy(evidence, "CRUCWDC1", 8);
+    stw_le_p(evidence + 8, 1);
+    stw_le_p(evidence + 10, requested->transition);
+    stw_le_p(evidence + 12, resolved->transition);
+    stl_le_p(evidence + 16, requested->volatile_policy);
+    stl_le_p(evidence + 20, requested->device_policy);
+    stl_le_p(evidence + 24, resolved->volatile_policy);
+    stl_le_p(evidence + 28, resolved->device_policy);
+    stq_le_p(evidence + 32, requested->downtime);
+    stq_le_p(evidence + 40, resolved->downtime);
+    stq_le_p(evidence + 48, state->watchdog_deadline_ns);
+    stq_le_p(evidence + 56, observed_virtual_ns);
+    memcpy(evidence + 64,
+           qemu_crucible_fault_rule_binding_hash(state->rule), 32);
+    memcpy(evidence + 96,
+           qemu_crucible_fault_rule_binding_hash(winner->rule), 32);
+    memcpy(evidence + 128,
+           qemu_crucible_fault_rule_action_hash(state->rule), 32);
+    memcpy(evidence + 160,
+           qemu_crucible_fault_rule_action_hash(winner->rule), 32);
+    crucible_lifecycle_sha256(evidence, sizeof(evidence), opportunity_hash);
+    qemu_crucible_fault_event_reservation_consume(
+        state->watchdog_reservation);
+    qemu_crucible_fault_rule_event(
+        state->rule, CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED,
+        observed_icount, opportunity_hash, before_hash, after_hash,
+        evidence, sizeof(evidence));
+    qemu_crucible_fault_event_reservation_release(
+        state->watchdog_reservation);
+    state->watchdog_reservation = NULL;
+}
+
+static void crucible_lifecycle_watchdog_boundary(
+    uint16_t phase, uint64_t observed_icount)
+{
+    g_autoptr(GPtrArray) due = NULL;
+    CrucibleHangState *winner = NULL;
+    CrucibleLifecyclePlan winner_plan = { 0 };
+    CrucibleLifecyclePlan resolved = { 0 };
+    uint8_t hang_before_hash[32], hang_after_hash[32];
+    uint64_t now;
+
+    if (phase == CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY &&
+        crucible_lifecycle_mode() &&
+        crucible_lifecycle_pending_reset.rule &&
+        crucible_lifecycle_pending_reset.waiting_ready) {
+        CrucibleLifecyclePendingReset *pending =
+            &crucible_lifecycle_pending_reset;
+        int64_t ready_now = icount_get_observed();
+
+        if (ready_now < 0) {
+            crucible_lifecycle_pending_fail_closed(pending);
+            return;
+        }
+        if ((uint64_t)ready_now >= pending->ready_deadline_ns) {
+            if (pending->attempt < pending->maximum_attempts) {
+                pending->attempt++;
+                pending->waiting_ready = false;
+                stl_le_p(pending->evidence + 196, pending->attempt);
+                qemu_system_reset_request(
+                    SHUTDOWN_CAUSE_HOST_QMP_SYSTEM_RESET);
+            } else {
+                uint8_t current_hash[32], terminal_hash[32];
+                uint8_t material[48] = { 0 };
+                uint64_t ram_bytes, device_bytes;
+                uint32_t transition = pending->exhausted_transition;
+
+                if (!crucible_lifecycle_snapshot(
+                        current_hash, &ram_bytes, &device_bytes)) {
+                    crucible_lifecycle_pending_fail_closed(pending);
+                    return;
+                }
+                memcpy(material, "CRUCTRM1", 8);
+                stl_le_p(material + 8, transition);
+                memcpy(material + 16, current_hash, 32);
+                crucible_lifecycle_sha256(
+                    material, sizeof(material), terminal_hash);
+                memcpy(pending->evidence + 256,
+                       current_hash, sizeof(current_hash));
+                stl_le_p(pending->evidence + 288, transition);
+                stl_le_p(pending->evidence + 292,
+                         CRUCIBLE_LIFECYCLE_TERMINAL_CAUSE_READY_EXHAUSTED);
+                stl_le_p(pending->evidence + 296,
+                         CRUCIBLE_LIFECYCLE_TERMINAL_PREEXIT_VALID |
+                         CRUCIBLE_LIFECYCLE_TERMINAL_EXIT_REQUIRED);
+                stl_le_p(pending->evidence + 196, pending->attempt);
+                stl_le_p(pending->evidence + 204, transition);
+                stq_le_p(pending->evidence + 112, ram_bytes);
+                stq_le_p(pending->evidence + 120, device_bytes);
+                memcpy(pending->evidence + 128,
+                       pending->before_hash, 32);
+                memcpy(pending->evidence + 160, terminal_hash, 32);
+                {
+                    uint8_t opportunity_hash[32];
+
+                    crucible_lifecycle_sha256(
+                        pending->evidence, sizeof(pending->evidence),
+                        opportunity_hash);
+                    qemu_crucible_fault_event_reservation_consume(
+                        pending->reservation);
+                    qemu_crucible_fault_rule_event(
+                        pending->rule,
+                        CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED,
+                        observed_icount, opportunity_hash,
+                        pending->before_hash, terminal_hash,
+                        pending->evidence, sizeof(pending->evidence));
+                    if (pending->complete_deferred) {
+                        qemu_crucible_fault_complete_deferred(
+                            pending->rule, pending->observed_icount,
+                            observed_icount, pending->before_hash,
+                            terminal_hash);
+                    }
+                }
+                if (crucible_lifecycle_terminal_exit_code(transition) == 0 ||
+                    crucible_lifecycle_terminal_transition != 0) {
+                    abort();
+                }
+                crucible_lifecycle_stage_terminal(
+                    pending->rule, transition,
+                    pending->evidence, sizeof(pending->evidence));
+                crucible_lifecycle_pending_clear(pending);
+            }
+        }
+        return;
+    }
+    if (phase != CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY ||
+        !crucible_lifecycle_mode() || !crucible_lifecycle_hangs ||
+        crucible_lifecycle_pending_reset.rule) {
+        return;
+    }
+    now = icount_get_observed();
+    due = g_ptr_array_new();
+    for (guint index = 0; index < crucible_lifecycle_hangs->len; index++) {
+        CrucibleHangState *state =
+            g_ptr_array_index(crucible_lifecycle_hangs, index);
+        CrucibleLifecyclePlan plan;
+        uint64_t timeout;
+
+        if (!state->watchdog_enabled || state->watchdog_fired ||
+            state->watchdog_deadline_ns > now) {
+            continue;
+        }
+        if (!state->watchdog_reservation ||
+            !crucible_lifecycle_watchdog_plan(
+                state->rule, &plan, &timeout)) {
+            error_report("Crucible watchdog lost its prepared plan");
+            abort();
+        }
+        g_ptr_array_add(due, state);
+        if (!winner) {
+            winner = state;
+            winner_plan = plan;
+            resolved = plan;
+        } else {
+            crucible_lifecycle_plan_compose(&resolved, &plan);
+            if (crucible_lifecycle_watchdog_wins(
+                    state, &plan, winner, &winner_plan)) {
+                winner = state;
+                winner_plan = plan;
+            }
+        }
+    }
+    if (!winner) {
+        crucible_lifecycle_watchdog_recompute();
+        return;
+    }
+    resolved.boot_policy = winner_plan.boot_policy;
+    resolved.ready_marker = winner_plan.ready_marker;
+    resolved.maximum_attempts = winner_plan.maximum_attempts;
+    resolved.retry_delay = winner_plan.retry_delay;
+    resolved.exhausted_transition = winner_plan.exhausted_transition;
+    g_assert(!crucible_lifecycle_watchdog_transition_active);
+    crucible_lifecycle_watchdog_transition_active = true;
+    crucible_hang_digest(crucible_lifecycle_hangs, hang_before_hash);
+    for (guint index = 0; index < due->len; index++) {
+        CrucibleHangState *state = g_ptr_array_index(due, index);
+
+        state->watchdog_fired = true;
+    }
+    crucible_hang_digest(crucible_lifecycle_hangs, hang_after_hash);
+    crucible_hang_effective_recompute();
+    for (guint index = 0; index < due->len; index++) {
+        CrucibleHangState *state = g_ptr_array_index(due, index);
+
+        crucible_hang_event(
+            state, CRUCIBLE_HANG_RECOVERED,
+            &state->recovery_reservation,
+            hang_before_hash, hang_after_hash);
+    }
+    for (guint index = 0; index < due->len; index++) {
+        CrucibleHangState *state = g_ptr_array_index(due, index);
+        CrucibleLifecyclePlan requested;
+        uint64_t timeout;
+
+        if (state == winner) {
+            continue;
+        }
+        if (!crucible_lifecycle_watchdog_plan(
+                state->rule, &requested, &timeout)) {
+            error_report("Crucible composed watchdog lost its plan");
+            abort();
+        }
+        crucible_lifecycle_watchdog_composition_event(
+            state, winner, &requested, &resolved, observed_icount, now,
+            hang_before_hash, hang_after_hash);
+    }
+    {
+        g_autoptr(GByteArray) evidence = g_byte_array_new();
+        uint8_t before_hash[32], after_hash[32], opportunity_hash[32];
+        uint16_t outcome = CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED;
+        int status;
+
+        status = crucible_lifecycle_execute(
+            winner->rule, observed_icount, &resolved, false,
+            before_hash, after_hash, evidence, &outcome,
+            &winner->watchdog_reservation);
+        crucible_lifecycle_watchdog_transition_active = false;
+        if (status != 0 &&
+            status != QEMU_CRUCIBLE_FAULT_IMPULSE_DEFERRED) {
+            error_report("Crucible prepared watchdog transition failed: %d",
+                         status);
+            abort();
+        }
+        if (status == 0) {
+            if (evidence->len == 0) {
+                error_report("Crucible watchdog transition omitted evidence");
+                abort();
+            }
+            crucible_lifecycle_sha256(
+                evidence->data, evidence->len, opportunity_hash);
+            qemu_crucible_fault_event_reservation_consume(
+                winner->watchdog_reservation);
+            qemu_crucible_fault_rule_event(
+                winner->rule, outcome, observed_icount, opportunity_hash,
+                before_hash, after_hash, evidence->data, evidence->len);
+            qemu_crucible_fault_event_reservation_release(
+                winner->watchdog_reservation);
+            winner->watchdog_reservation = NULL;
+        }
+    }
+    crucible_lifecycle_watchdog_recompute();
+}
+
+static uint64_t crucible_lifecycle_watchdog_deadline(uint16_t phase)
+{
+    uint64_t deadline;
+
+    if (phase != CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY ||
+        !crucible_lifecycle_mode()) {
+        return UINT64_MAX;
+    }
+    deadline = crucible_lifecycle_next_watchdog_ns;
+    if (crucible_lifecycle_pending_reset.rule &&
+        crucible_lifecycle_pending_reset.waiting_ready) {
+        deadline = MIN(
+            deadline, crucible_lifecycle_pending_reset.ready_deadline_ns);
+    }
+    return deadline;
+}
+
+static size_t crucible_lifecycle_vmstate_reservation_remaining(
+    QemuCrucibleFaultEventReservation *reservation)
+{
+    return qemu_crucible_fault_event_reservation_remaining(reservation);
+}
+
+static int crucible_lifecycle_vmstate_save(GByteArray *payload)
+{
+    CrucibleLifecyclePendingReset *pending =
+        &crucible_lifecycle_pending_reset;
+    uint32_t hang_count = crucible_lifecycle_hangs ?
+        crucible_lifecycle_hangs->len : 0;
+    uint32_t vcpu_count = crucible_lifecycle_vcpu_hung ?
+        crucible_lifecycle_vcpu_hung->len : 0;
+    size_t pending_reservation =
+        crucible_lifecycle_vmstate_reservation_remaining(
+            pending->reservation);
+
+    if (crucible_lifecycle_process_generation == 0 || hang_count > 4096 ||
+        vcpu_count > 4096 || pending_reservation > UINT32_MAX ||
+        pending->preserved_state_len >
+            CRUCIBLE_LIFECYCLE_VMSTATE_MAX_PRESERVED_BYTES ||
+        (!!pending->rule != !!pending->reservation) ||
+        (!!pending->rule != (pending->preserved_state_len != 0 ||
+                             pending->boot_policy != 0)) ||
+        (pending->waiting_ready && !pending->ready_marker) ||
+        (crucible_lifecycle_terminal_transition == 0 &&
+         crucible_lifecycle_terminal_exit_requested)) {
+        return -EINVAL;
+    }
+    qemu_crucible_fault_vmstate_put_bytes(payload, "CRUCLVS1", 8);
+    qemu_crucible_fault_vmstate_put_u64(
+        payload, crucible_lifecycle_process_generation);
+    qemu_crucible_fault_vmstate_put_u64(
+        payload, crucible_lifecycle_next_watchdog_ns);
+    qemu_crucible_fault_vmstate_put_u32(
+        payload, crucible_lifecycle_terminal_transition);
+    qemu_crucible_fault_vmstate_put_u32(payload, hang_count);
+    qemu_crucible_fault_vmstate_put_u32(payload, vcpu_count);
+    qemu_crucible_fault_vmstate_put_u8(
+        payload, crucible_lifecycle_node_hung);
+    qemu_crucible_fault_vmstate_put_u8(
+        payload, crucible_lifecycle_terminal_exit_requested);
+    qemu_crucible_fault_vmstate_put_u8(payload, pending->rule != NULL);
+    qemu_crucible_fault_vmstate_put_u8(payload, 0);
+    qemu_crucible_fault_vmstate_put_bytes(
+        payload, crucible_lifecycle_terminal_action_sha256, 32);
+    qemu_crucible_fault_vmstate_put_bytes(
+        payload, crucible_lifecycle_terminal_evidence_sha256, 32);
+    for (uint32_t i = 0; i < vcpu_count; i++) {
+        qemu_crucible_fault_vmstate_put_u8(
+            payload, g_array_index(
+                crucible_lifecycle_vcpu_hung, bool, i));
+    }
+    if (pending->rule) {
+        size_t marker_len = pending->ready_marker ?
+            strlen(pending->ready_marker) : 0;
+
+        if (marker_len > UINT8_MAX) {
+            return -EINVAL;
+        }
+        qemu_crucible_fault_vmstate_put_u8(
+            payload, pending->complete_deferred);
+        qemu_crucible_fault_vmstate_put_u8(
+            payload, pending->waiting_ready);
+        qemu_crucible_fault_vmstate_put_u8(payload, marker_len);
+        qemu_crucible_fault_vmstate_put_u8(payload, 0);
+        qemu_crucible_fault_vmstate_put_u32(payload, pending_reservation);
+        qemu_crucible_fault_vmstate_put_u64(
+            payload, pending->observed_icount);
+        qemu_crucible_fault_vmstate_put_u32(
+            payload, pending->boot_policy);
+        qemu_crucible_fault_vmstate_put_u32(
+            payload, pending->maximum_attempts);
+        qemu_crucible_fault_vmstate_put_u32(payload, pending->attempt);
+        qemu_crucible_fault_vmstate_put_u32(
+            payload, pending->exhausted_transition);
+        qemu_crucible_fault_vmstate_put_u64(payload, pending->retry_delay);
+        qemu_crucible_fault_vmstate_put_u64(
+            payload, pending->ready_deadline_ns);
+        qemu_crucible_fault_vmstate_put_u64(
+            payload, pending->preserved_state_len);
+        qemu_crucible_fault_vmstate_put_bytes(
+            payload, pending->before_hash, 32);
+        qemu_crucible_fault_vmstate_put_bytes(
+            payload, pending->evidence, sizeof(pending->evidence));
+        qemu_crucible_fault_vmstate_put_bytes(
+            payload, pending->ready_marker, marker_len);
+        qemu_crucible_fault_vmstate_put_bytes(
+            payload, pending->preserved_state,
+            pending->preserved_state_len);
+        if (pending->complete_deferred) {
+            qemu_crucible_fault_rule_vmstate_save(payload, pending->rule);
+        } else {
+            qemu_crucible_fault_rule_reference_vmstate_save(
+                payload, pending->rule);
+        }
+    }
+    for (uint32_t i = 0; i < hang_count; i++) {
+        CrucibleHangState *hang = g_ptr_array_index(
+            crucible_lifecycle_hangs, i);
+        size_t activation =
+            crucible_lifecycle_vmstate_reservation_remaining(
+                hang->activation_reservation);
+        size_t watchdog =
+            crucible_lifecycle_vmstate_reservation_remaining(
+                hang->watchdog_reservation);
+        size_t recovery =
+            crucible_lifecycle_vmstate_reservation_remaining(
+                hang->recovery_reservation);
+
+        if (activation > UINT32_MAX || watchdog > UINT32_MAX ||
+            recovery > UINT32_MAX ||
+            (hang->watchdog_fired && watchdog != 0 &&
+             !crucible_lifecycle_watchdog_transition_active) ||
+            (!hang->watchdog_enabled && watchdog != 0)) {
+            return -EINVAL;
+        }
+        qemu_crucible_fault_rule_reference_vmstate_save(
+            payload, hang->rule);
+        qemu_crucible_fault_vmstate_put_u64(
+            payload, hang->entered_icount);
+        qemu_crucible_fault_vmstate_put_u64(
+            payload, hang->entered_virtual_ns);
+        qemu_crucible_fault_vmstate_put_u64(
+            payload, hang->watchdog_deadline_ns);
+        qemu_crucible_fault_vmstate_put_u32(payload, activation);
+        qemu_crucible_fault_vmstate_put_u32(payload, watchdog);
+        qemu_crucible_fault_vmstate_put_u32(payload, recovery);
+        qemu_crucible_fault_vmstate_put_u8(
+            payload, hang->watchdog_enabled);
+        qemu_crucible_fault_vmstate_put_u8(payload, hang->watchdog_fired);
+        qemu_crucible_fault_vmstate_put_u16(payload, 0);
+    }
+    return 0;
+}
+
+static void crucible_lifecycle_vmstate_free(void *opaque)
+{
+    CrucibleLifecycleVmstate *state = opaque;
+
+    if (!state) {
+        return;
+    }
+    qemu_crucible_fault_rule_unref(state->pending_reset.rule);
+    g_free(state->pending_reset.preserved_state);
+    g_free(state->pending_reset.ready_marker);
+    g_clear_pointer(&state->hangs, g_ptr_array_unref);
+    g_clear_pointer(&state->vcpu_hung, g_array_unref);
+    g_free(state);
+}
+
+static bool crucible_lifecycle_vmstate_hash_zero(const uint8_t hash[32])
+{
+    uint8_t zero[32] = { 0 };
+
+    return memcmp(hash, zero, sizeof(zero)) == 0;
+}
+
+static int crucible_lifecycle_vmstate_prepare(
+    const uint8_t *payload, size_t payload_len, void **staged_out)
+{
+    QemuCrucibleFaultVmstateReader reader = {
+        .data = payload,
+        .length = payload_len,
+    };
+    CrucibleLifecycleVmstate *state = g_new0(
+        CrucibleLifecycleVmstate, 1);
+    CrucibleLifecyclePendingReset *pending = &state->pending_reset;
+    uint8_t magic[8], node_hung, exit_requested, has_pending, reserved8;
+    uint32_t hang_count, vcpu_count;
+
+    state->hangs = g_ptr_array_new_with_free_func(
+        crucible_hang_state_free);
+    if (!qemu_crucible_fault_vmstate_get_bytes(&reader, magic, 8) ||
+        memcmp(magic, "CRUCLVS1", 8) != 0 ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            &reader, &state->process_generation) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            &reader, &state->next_watchdog_ns) ||
+        !qemu_crucible_fault_vmstate_get_u32(
+            &reader, &state->terminal_transition) ||
+        !qemu_crucible_fault_vmstate_get_u32(&reader, &hang_count) ||
+        !qemu_crucible_fault_vmstate_get_u32(&reader, &vcpu_count) ||
+        !qemu_crucible_fault_vmstate_get_u8(&reader, &node_hung) ||
+        !qemu_crucible_fault_vmstate_get_u8(&reader, &exit_requested) ||
+        !qemu_crucible_fault_vmstate_get_u8(&reader, &has_pending) ||
+        !qemu_crucible_fault_vmstate_get_u8(&reader, &reserved8) ||
+        !qemu_crucible_fault_vmstate_get_bytes(
+            &reader, state->terminal_action_sha256, 32) ||
+        !qemu_crucible_fault_vmstate_get_bytes(
+            &reader, state->terminal_evidence_sha256, 32) ||
+        state->process_generation == 0 ||
+        hang_count > 4096 ||
+        vcpu_count > 4096 || node_hung > 1 || exit_requested > 1 ||
+        has_pending > 1 || reserved8 != 0 ||
+        (state->terminal_transition != 0 &&
+         crucible_lifecycle_terminal_exit_code(
+             state->terminal_transition) == 0) ||
+        (state->terminal_transition == 0 &&
+         (exit_requested ||
+          !crucible_lifecycle_vmstate_hash_zero(
+              state->terminal_action_sha256) ||
+          !crucible_lifecycle_vmstate_hash_zero(
+              state->terminal_evidence_sha256)))) {
+        goto fail;
+    }
+    if (state->process_generation != crucible_lifecycle_process_generation) {
+        if (state->process_generation == UINT64_MAX ||
+            state->process_generation + 1 !=
+                crucible_lifecycle_process_generation ||
+            state->terminal_transition == 0) {
+            goto fail;
+        }
+        state->replacement_handoff = true;
+    }
+    state->node_hung = node_hung;
+    state->terminal_exit_requested = exit_requested;
+    state->vcpu_hung = g_array_sized_new(
+        false, true, sizeof(bool), vcpu_count);
+    for (uint32_t i = 0; i < vcpu_count; i++) {
+        uint8_t hung;
+        bool value;
+
+        if (!qemu_crucible_fault_vmstate_get_u8(&reader, &hung) || hung > 1) {
+            goto fail;
+        }
+        value = hung;
+        g_array_append_val(state->vcpu_hung, value);
+    }
+    if (has_pending) {
+        const uint8_t *marker, *preserved;
+        uint8_t complete_deferred, waiting_ready, marker_len;
+        uint64_t preserved_len;
+        CrucibleLifecyclePlan plan = { 0 };
+        uint64_t timeout;
+
+        if (!qemu_crucible_fault_vmstate_get_u8(
+                &reader, &complete_deferred) ||
+            !qemu_crucible_fault_vmstate_get_u8(&reader, &waiting_ready) ||
+            !qemu_crucible_fault_vmstate_get_u8(&reader, &marker_len) ||
+            !qemu_crucible_fault_vmstate_get_u8(&reader, &reserved8) ||
+            !qemu_crucible_fault_vmstate_get_u32(
+                &reader, &pending->vmstate_reservation_remaining) ||
+            !qemu_crucible_fault_vmstate_get_u64(
+                &reader, &pending->observed_icount) ||
+            !qemu_crucible_fault_vmstate_get_u32(
+                &reader, &pending->boot_policy) ||
+            !qemu_crucible_fault_vmstate_get_u32(
+                &reader, &pending->maximum_attempts) ||
+            !qemu_crucible_fault_vmstate_get_u32(
+                &reader, &pending->attempt) ||
+            !qemu_crucible_fault_vmstate_get_u32(
+                &reader, &pending->exhausted_transition) ||
+            !qemu_crucible_fault_vmstate_get_u64(
+                &reader, &pending->retry_delay) ||
+            !qemu_crucible_fault_vmstate_get_u64(
+                &reader, &pending->ready_deadline_ns) ||
+            !qemu_crucible_fault_vmstate_get_u64(
+                &reader, &preserved_len) ||
+            !qemu_crucible_fault_vmstate_get_bytes(
+                &reader, pending->before_hash, 32) ||
+            !qemu_crucible_fault_vmstate_get_bytes(
+                &reader, pending->evidence, sizeof(pending->evidence)) ||
+            !qemu_crucible_fault_vmstate_get_view(
+                &reader, &marker, marker_len) ||
+            preserved_len > CRUCIBLE_LIFECYCLE_VMSTATE_MAX_PRESERVED_BYTES ||
+            !qemu_crucible_fault_vmstate_get_view(
+                &reader, &preserved, preserved_len) ||
+            complete_deferred > 1 || waiting_ready > 1 || reserved8 != 0 ||
+            (marker_len != 0 &&
+             (!g_utf8_validate((const char *)marker, marker_len, NULL) ||
+              memchr(marker, '\0', marker_len) != NULL)) ||
+            pending->vmstate_reservation_remaining == 0 ||
+            pending->maximum_attempts == 0 || pending->attempt == 0 ||
+            pending->attempt > pending->maximum_attempts) {
+            goto fail;
+        }
+        pending->complete_deferred = complete_deferred;
+        pending->waiting_ready = waiting_ready;
+        pending->ready_marker = marker_len ?
+            g_strndup((const char *)marker, marker_len) : NULL;
+        pending->preserved_state = preserved_len ?
+            g_memdup2(preserved, preserved_len) : NULL;
+        pending->preserved_state_len = preserved_len;
+        pending->rule = complete_deferred ?
+            qemu_crucible_fault_rule_vmstate_load(&reader) :
+            qemu_crucible_fault_rule_reference_vmstate_load(&reader);
+        if (!pending->rule ||
+            (complete_deferred &&
+             (qemu_crucible_fault_rule_command_kind(pending->rule) !=
+                  CRUCIBLE_FAULT_COMMAND_NODE_LIFECYCLE ||
+              qemu_crucible_fault_rule_operation(pending->rule) !=
+                  CRUCIBLE_NODE_FAULT_OPERATION_APPLY ||
+              !crucible_lifecycle_direct_plan(pending->rule, &plan))) ||
+            (!complete_deferred &&
+             (qemu_crucible_fault_rule_command_kind(pending->rule) !=
+                  CRUCIBLE_FAULT_COMMAND_NODE_HANG ||
+              !crucible_lifecycle_watchdog_plan(
+                  pending->rule, &plan, &timeout))) ||
+            plan.boot_policy != pending->boot_policy ||
+            plan.maximum_attempts != pending->maximum_attempts ||
+            plan.retry_delay != pending->retry_delay ||
+            plan.exhausted_transition != pending->exhausted_transition ||
+            (!!plan.ready_marker != !!pending->ready_marker) ||
+            (plan.ready_marker && strcmp(
+                plan.ready_marker, pending->ready_marker) != 0) ||
+            (pending->waiting_ready &&
+             pending->boot_policy != CRUCIBLE_BOOT_REQUIRE_READY) ||
+            (pending->waiting_ready &&
+             pending->ready_deadline_ns == UINT64_MAX)) {
+            goto fail;
+        }
+        qemu_crucible_fault_vmstate_count_reservations(
+            pending->vmstate_reservation_remaining);
+        pending->reservation =
+            qemu_crucible_fault_event_reservation_restore(
+                pending->vmstate_reservation_remaining);
+        if (!pending->reservation) {
+            goto fail;
+        }
+        pending->vmstate_reservation_remaining = 0;
+        if (pending->complete_deferred) {
+            qemu_crucible_fault_vmstate_count_deferred(1);
+        }
+    }
+    for (uint32_t i = 0; i < hang_count; i++) {
+        CrucibleHangState *hang = g_new0(CrucibleHangState, 1);
+        uint8_t enabled, fired;
+        uint16_t reserved16;
+        CrucibleLifecyclePlan plan;
+        uint64_t timeout;
+
+        hang->rule = qemu_crucible_fault_rule_reference_vmstate_load(
+            &reader);
+        if (!hang->rule ||
+            !qemu_crucible_fault_vmstate_get_u64(
+                &reader, &hang->entered_icount) ||
+            !qemu_crucible_fault_vmstate_get_u64(
+                &reader, &hang->entered_virtual_ns) ||
+            !qemu_crucible_fault_vmstate_get_u64(
+                &reader, &hang->watchdog_deadline_ns) ||
+            !qemu_crucible_fault_vmstate_get_u32(
+                &reader, &hang->vmstate_activation_remaining) ||
+            !qemu_crucible_fault_vmstate_get_u32(
+                &reader, &hang->vmstate_watchdog_remaining) ||
+            !qemu_crucible_fault_vmstate_get_u32(
+                &reader, &hang->vmstate_recovery_remaining) ||
+            !qemu_crucible_fault_vmstate_get_u8(&reader, &enabled) ||
+            !qemu_crucible_fault_vmstate_get_u8(&reader, &fired) ||
+            !qemu_crucible_fault_vmstate_get_u16(&reader, &reserved16) ||
+            enabled > 1 || fired > 1 || reserved16 != 0 ||
+            qemu_crucible_fault_rule_command_kind(hang->rule) !=
+                CRUCIBLE_FAULT_COMMAND_NODE_HANG ||
+            qemu_crucible_fault_rule_operation(hang->rule) !=
+                CRUCIBLE_NODE_FAULT_OPERATION_UPSERT ||
+            qemu_crucible_fault_lifecycle_validate(hang->rule) != 0 ||
+            (i != 0 && memcmp(
+                qemu_crucible_fault_rule_binding_hash(
+                    ((CrucibleHangState *)g_ptr_array_index(
+                        state->hangs, i - 1))->rule),
+                qemu_crucible_fault_rule_binding_hash(hang->rule), 32) >= 0)) {
+            crucible_hang_state_free(hang);
+            goto fail;
+        }
+        hang->watchdog_enabled = enabled;
+        hang->watchdog_fired = fired;
+        if (hang->vmstate_activation_remaining != 0 ||
+            (hang->watchdog_fired &&
+             (hang->vmstate_watchdog_remaining != 0 ||
+              hang->vmstate_recovery_remaining != 0)) ||
+            (!hang->watchdog_fired &&
+             (hang->vmstate_recovery_remaining != 1 ||
+              hang->vmstate_watchdog_remaining !=
+                  (uint32_t)hang->watchdog_enabled)) ||
+            (crucible_lifecycle_watchdog_plan(
+                 hang->rule, &plan, &timeout) != hang->watchdog_enabled) ||
+            (hang->watchdog_enabled &&
+             (timeout > UINT64_MAX - hang->entered_virtual_ns ||
+              hang->watchdog_deadline_ns !=
+                  hang->entered_virtual_ns + timeout)) ||
+            (!hang->watchdog_enabled &&
+             hang->watchdog_deadline_ns != UINT64_MAX)) {
+            crucible_hang_state_free(hang);
+            goto fail;
+        }
+        qemu_crucible_fault_vmstate_count_reservations(
+            hang->vmstate_activation_remaining +
+            hang->vmstate_watchdog_remaining +
+            hang->vmstate_recovery_remaining);
+        if (hang->vmstate_activation_remaining) {
+            hang->activation_reservation =
+                qemu_crucible_fault_event_reservation_restore(
+                    hang->vmstate_activation_remaining);
+        }
+        if (hang->vmstate_watchdog_remaining) {
+            hang->watchdog_reservation =
+                qemu_crucible_fault_event_reservation_restore(
+                    hang->vmstate_watchdog_remaining);
+        }
+        if (hang->vmstate_recovery_remaining) {
+            hang->recovery_reservation =
+                qemu_crucible_fault_event_reservation_restore(
+                    hang->vmstate_recovery_remaining);
+        }
+        if ((hang->vmstate_activation_remaining &&
+             !hang->activation_reservation) ||
+            (hang->vmstate_watchdog_remaining &&
+             !hang->watchdog_reservation) ||
+            (hang->vmstate_recovery_remaining &&
+             !hang->recovery_reservation)) {
+            crucible_hang_state_free(hang);
+            goto fail;
+        }
+        hang->vmstate_activation_remaining = 0;
+        hang->vmstate_watchdog_remaining = 0;
+        hang->vmstate_recovery_remaining = 0;
+        g_ptr_array_add(state->hangs, hang);
+    }
+    if (!qemu_crucible_fault_vmstate_reader_finished(&reader)) {
+        goto fail;
+    }
+    {
+        CrucibleHangApply apply = {
+            .vcpu_hung = g_array_sized_new(
+                false, true, sizeof(bool), vcpu_count),
+        };
+        uint64_t next_watchdog = UINT64_MAX;
+
+        g_array_set_size(apply.vcpu_hung, vcpu_count);
+        for (guint i = 0; i < state->hangs->len; i++) {
+            CrucibleHangState *hang = g_ptr_array_index(state->hangs, i);
+
+            if (!hang->watchdog_fired) {
+                crucible_lifecycle_apply_hang(hang->rule, &apply);
+            }
+            if (hang->watchdog_enabled && !hang->watchdog_fired) {
+                next_watchdog = MIN(
+                    next_watchdog, hang->watchdog_deadline_ns);
+            }
+        }
+        if (apply.node_hung != state->node_hung ||
+            apply.vcpu_hung->len != state->vcpu_hung->len ||
+            memcmp(apply.vcpu_hung->data, state->vcpu_hung->data,
+                   state->vcpu_hung->len * sizeof(bool)) != 0 ||
+            next_watchdog != state->next_watchdog_ns) {
+            g_array_unref(apply.vcpu_hung);
+            goto fail;
+        }
+        g_array_unref(apply.vcpu_hung);
+    }
+    *staged_out = state;
+    return 0;
+
+fail:
+    crucible_lifecycle_vmstate_free(state);
+    return -EINVAL;
+}
+
+static void crucible_lifecycle_vmstate_commit(void *opaque)
+{
+    CrucibleLifecycleVmstate *state = opaque;
+
+    if (crucible_lifecycle_pending_reset.rule) {
+        crucible_lifecycle_pending_clear(
+            &crucible_lifecycle_pending_reset);
+    }
+    if (state->pending_reset.rule) {
+        crucible_lifecycle_pending_reset = state->pending_reset;
+        memset(&state->pending_reset, 0, sizeof(state->pending_reset));
+    } else {
+        memset(&crucible_lifecycle_pending_reset, 0,
+               sizeof(crucible_lifecycle_pending_reset));
+    }
+    g_clear_pointer(&crucible_lifecycle_hangs, g_ptr_array_unref);
+    crucible_lifecycle_hangs = g_steal_pointer(&state->hangs);
+    g_clear_pointer(&crucible_lifecycle_vcpu_hung, g_array_unref);
+    crucible_lifecycle_vcpu_hung = g_steal_pointer(&state->vcpu_hung);
+    crucible_lifecycle_node_hung = state->node_hung;
+    crucible_lifecycle_next_watchdog_ns = state->next_watchdog_ns;
+    if (state->replacement_handoff) {
+        crucible_lifecycle_terminal_transition = 0;
+        crucible_lifecycle_terminal_exit_requested = false;
+        memset(crucible_lifecycle_terminal_action_sha256, 0, 32);
+        memset(crucible_lifecycle_terminal_evidence_sha256, 0, 32);
+    } else {
+        crucible_lifecycle_terminal_transition = state->terminal_transition;
+        crucible_lifecycle_terminal_exit_requested =
+            state->terminal_exit_requested;
+        memcpy(crucible_lifecycle_terminal_action_sha256,
+               state->terminal_action_sha256, 32);
+        memcpy(crucible_lifecycle_terminal_evidence_sha256,
+               state->terminal_evidence_sha256, 32);
+    }
+    crucible_lifecycle_vmstate_free(state);
+}
+
+static const QemuCrucibleFaultVmstateSection
+crucible_lifecycle_vmstate_section = {
+    .name = "lifecycle",
+    .version = 1,
+    .save = crucible_lifecycle_vmstate_save,
+    .fingerprint_projection = crucible_lifecycle_vmstate_save,
+    .prepare = crucible_lifecycle_vmstate_prepare,
+    .commit = crucible_lifecycle_vmstate_commit,
+    .free_staged = crucible_lifecycle_vmstate_free,
+};
+
+static void crucible_lifecycle_register(void)
+{
+    const uint32_t boundary =
+        1U << (CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY - 1);
+
+    qemu_crucible_fault_node_register(
+        CRUCIBLE_FAULT_COMMAND_NODE_LIFECYCLE,
+        QEMU_PLUGIN_CRUCIBLE_FAULT_SCOPE_ALL, boundary,
+        "qemu.node.lifecycle.v1", crucible_lifecycle_impulse);
+    qemu_crucible_fault_node_register(
+        CRUCIBLE_FAULT_COMMAND_NODE_HANG,
+        QEMU_PLUGIN_CRUCIBLE_FAULT_SCOPE_ALL, boundary,
+        "qemu.node.hang.v1", NULL);
+    qemu_crucible_fault_boundary_observer_register(
+        crucible_lifecycle_watchdog_boundary);
+    qemu_crucible_fault_boundary_deadline_register(
+        crucible_lifecycle_watchdog_deadline);
+    qemu_crucible_fault_vmstate_register(
+        &crucible_lifecycle_vmstate_section);
+}
+
+type_init(crucible_lifecycle_register)
diff --git a/plugins/crucible-fault-memory.c b/plugins/crucible-fault-memory.c
new file mode 100644
index 0000000000000000000000000000000000000000..4e4c1457c80b594038357e0ca8c1023110ac0e31
--- /dev/null
+++ b/plugins/crucible-fault-memory.c
@@ -0,0 +1,1396 @@
+/*
+ * Crucible deterministic guest-RAM boundary mutation
+ *
+ * Copyright (c) 2026 ANDYL Technologies
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "system/address-spaces.h"
+#include "exec/cpu-common.h"
+#include "system/memory.h"
+#include "system/ramblock.h"
+#include "hw/core/cpu.h"
+#include "qemu/crucible-fault.h"
+#include "qemu/module.h"
+#include "qom/object.h"
+
+#define CRUCIBLE_MEMORY_MAX_MAPPINGS 16384
+#define CRUCIBLE_MEMORY_DIRTY_PAGE_SIZE 4096
+
+typedef struct CrucibleMemoryMapping {
+    MemoryRegion *mr;
+    uint8_t *host;
+    uint64_t gpa;
+    uint64_t length;
+    uint64_t mr_offset;
+    uint64_t ram_block_offset;
+    uint8_t mr_identity[32];
+    uint8_t ram_block_identity[32];
+} CrucibleMemoryMapping;
+
+typedef struct CrucibleMemoryTranslation {
+    uint64_t virtual_page;
+    uint64_t physical_page;
+    uint64_t page_size;
+    uint16_t permissions;
+    uint16_t attributes;
+    uint32_t covered_bytes;
+} CrucibleMemoryTranslation;
+
+typedef struct CrucibleMemoryFragment {
+    CrucibleMemoryMapping *mapping;
+    uint64_t gpa;
+    uint32_t request_offset;
+    uint32_t length;
+    uint32_t flags;
+    uint64_t mr_offset;
+    uint64_t ram_block_offset;
+    uint8_t mr_identity[32];
+    uint8_t ram_block_identity[32];
+} CrucibleMemoryFragment;
+
+typedef struct CrucibleMemoryDirtyRange {
+    uint8_t ram_block_identity[32];
+    uint64_t offset;
+    uint64_t end;
+} CrucibleMemoryDirtyRange;
+
+typedef struct CrucibleMemoryMutation {
+    uint16_t address_space;
+    uint16_t transform;
+    uint32_t vcpu_index;
+    uint64_t address;
+    uint32_t length;
+    bool prepare_only;
+    uint8_t expected_translation[32];
+    uint8_t *mask;
+    uint8_t *values;
+    GArray *mappings;
+    GArray *translations;
+    GArray *fragments;
+    GArray *dirty_ranges;
+    GByteArray *before;
+    GByteArray *after;
+    uint8_t translation_hash[32];
+    uint8_t mapping_hash[32];
+    uint8_t dirty_hash[32];
+    uint8_t before_hash[32];
+    uint8_t after_hash[32];
+    uint8_t precondition_hash[32];
+} CrucibleMemoryMutation;
+
+typedef struct CrucibleMemoryBatchAction {
+    uint8_t action_hash[32];
+    CrucibleMemoryMutation *mutation;
+    GByteArray *evidence;
+} CrucibleMemoryBatchAction;
+
+typedef struct CrucibleMemoryBatch {
+    bool prepare_only;
+    uint8_t expected_precondition[32];
+    uint8_t precondition_hash[32];
+    GPtrArray *actions;
+} CrucibleMemoryBatch;
+
+typedef struct CrucibleMemoryMapCollector {
+    GArray *mappings;
+    int status;
+} CrucibleMemoryMapCollector;
+
+static uint16_t crucible_lduw(const uint8_t *bytes, size_t offset)
+{
+    return lduw_le_p(bytes + offset);
+}
+
+static uint32_t crucible_ldl(const uint8_t *bytes, size_t offset)
+{
+    return ldl_le_p(bytes + offset);
+}
+
+static uint64_t crucible_ldq(const uint8_t *bytes, size_t offset)
+{
+    return ldq_le_p(bytes + offset);
+}
+
+static void crucible_sha256_parts(const void *first, size_t first_len,
+                                  const void *second, size_t second_len,
+                                  uint8_t digest[32])
+{
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    gsize digest_len = 32;
+
+    g_checksum_update(checksum, first, first_len);
+    if (second_len) {
+        g_checksum_update(checksum, second, second_len);
+    }
+    g_checksum_get_digest(checksum, digest, &digest_len);
+    g_assert(digest_len == 32);
+}
+
+static void crucible_checksum_u16(GChecksum *checksum, uint16_t value)
+{
+    uint8_t bytes[2];
+
+    stw_le_p(bytes, value);
+    g_checksum_update(checksum, bytes, sizeof(bytes));
+}
+
+static void crucible_checksum_u32(GChecksum *checksum, uint32_t value)
+{
+    uint8_t bytes[4];
+
+    stl_le_p(bytes, value);
+    g_checksum_update(checksum, bytes, sizeof(bytes));
+}
+
+static void crucible_checksum_u64(GChecksum *checksum, uint64_t value)
+{
+    uint8_t bytes[8];
+
+    stq_le_p(bytes, value);
+    g_checksum_update(checksum, bytes, sizeof(bytes));
+}
+
+static void crucible_checksum_finish(GChecksum *checksum, uint8_t digest[32])
+{
+    gsize digest_len = 32;
+
+    g_checksum_get_digest(checksum, digest, &digest_len);
+    g_assert(digest_len == 32);
+}
+
+static void crucible_memory_precondition(
+    const CrucibleMemoryMutation *mutation, const uint8_t before_hash[32],
+    const uint8_t after_hash[32], uint8_t digest[32])
+{
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+
+    g_checksum_update(
+        checksum,
+        (const uint8_t *)CRUCIBLE_MEMORY_MUTATION_PRECONDITION_SHA256_DOMAIN_V1,
+        CRUCIBLE_MEMORY_MUTATION_PRECONDITION_SHA256_DOMAIN_V1_BYTES);
+    g_checksum_update(checksum, before_hash, 32);
+    g_checksum_update(checksum, after_hash, 32);
+    g_checksum_update(checksum, mutation->translation_hash, 32);
+    g_checksum_update(checksum, mutation->mapping_hash, 32);
+    crucible_checksum_finish(checksum, digest);
+}
+
+static bool crucible_digest_is_zero(const uint8_t digest[32])
+{
+    uint8_t combined = 0;
+
+    for (size_t i = 0; i < 32; i++) {
+        combined |= digest[i];
+    }
+    return combined == 0;
+}
+
+static int crucible_memory_parse(const uint8_t *payload, size_t payload_len,
+                                 CrucibleMemoryMutation *mutation,
+                                 bool allocate,
+                                 bool allow_unresolved_translation)
+{
+    uint32_t length;
+    uint32_t mask_length;
+    uint32_t values_length;
+    size_t expected;
+
+    if (!payload || !mutation ||
+        payload_len < CRUCIBLE_MEMORY_MUTATION_PAYLOAD_HEADER_V1_BYTES ||
+        memcmp(payload, CRUCIBLE_MEMORY_MUTATION_PAYLOAD_MAGIC_V1, 8) != 0 ||
+        crucible_lduw(payload, CRUCIBLE_MEMORY_MUTATION_VERSION_OFFSET) !=
+            CRUCIBLE_MEMORY_MUTATION_PAYLOAD_VERSION_V1 ||
+        crucible_lduw(payload, CRUCIBLE_MEMORY_MUTATION_ATOMICITY_OFFSET) !=
+            CRUCIBLE_MEMORY_MUTATION_ATOMIC_ALL_OR_NOTHING) {
+        return -EINVAL;
+    }
+    for (size_t i = CRUCIBLE_MEMORY_MUTATION_RESERVED_OFFSET;
+         i < CRUCIBLE_MEMORY_MUTATION_BODY_OFFSET; i++) {
+        if (payload[i] != 0) {
+            return -EINVAL;
+        }
+    }
+    length = crucible_ldl(payload, CRUCIBLE_MEMORY_MUTATION_LENGTH_OFFSET);
+    mask_length = crucible_ldl(payload,
+                               CRUCIBLE_MEMORY_MUTATION_MASK_LENGTH_OFFSET);
+    values_length = crucible_ldl(payload,
+                                 CRUCIBLE_MEMORY_MUTATION_VALUES_LENGTH_OFFSET);
+    expected = CRUCIBLE_MEMORY_MUTATION_BODY_OFFSET +
+               (size_t)mask_length + values_length;
+    if (length == 0 || length > CRUCIBLE_MEMORY_MUTATION_HARD_BYTES ||
+        mask_length != length ||
+        payload_len > CRUCIBLE_FAULT_HARD_PAYLOAD_BYTES ||
+        expected != payload_len) {
+        return -EINVAL;
+    }
+    mutation->address_space = crucible_lduw(
+        payload, CRUCIBLE_MEMORY_MUTATION_ADDRESS_SPACE_OFFSET);
+    mutation->transform = crucible_lduw(
+        payload, CRUCIBLE_MEMORY_MUTATION_TRANSFORM_OFFSET);
+    mutation->vcpu_index = crucible_ldl(
+        payload, CRUCIBLE_MEMORY_MUTATION_VCPU_INDEX_OFFSET);
+    mutation->address = crucible_ldq(payload,
+                                     CRUCIBLE_MEMORY_MUTATION_ADDRESS_OFFSET);
+    mutation->length = length;
+    if (mutation->address > UINT64_MAX - (length - 1) ||
+        (mutation->transform == CRUCIBLE_MEMORY_MUTATION_TRANSFORM_BIT_FLIP &&
+         values_length != 0) ||
+        (mutation->transform == CRUCIBLE_MEMORY_MUTATION_TRANSFORM_REPLACE &&
+         values_length != length) ||
+        (mutation->transform != CRUCIBLE_MEMORY_MUTATION_TRANSFORM_BIT_FLIP &&
+         mutation->transform != CRUCIBLE_MEMORY_MUTATION_TRANSFORM_REPLACE)) {
+        return -EINVAL;
+    }
+    memcpy(mutation->expected_translation,
+           payload + CRUCIBLE_MEMORY_MUTATION_TRANSLATION_SHA256_OFFSET, 32);
+    if ((mutation->address_space == CRUCIBLE_MEMORY_MUTATION_ADDRESS_GPA &&
+         (mutation->vcpu_index != CRUCIBLE_MEMORY_MUTATION_NO_VCPU ||
+          !crucible_digest_is_zero(mutation->expected_translation))) ||
+        (mutation->address_space == CRUCIBLE_MEMORY_MUTATION_ADDRESS_GVA &&
+         (mutation->vcpu_index == CRUCIBLE_MEMORY_MUTATION_NO_VCPU ||
+          (allow_unresolved_translation &&
+           !crucible_digest_is_zero(mutation->expected_translation)) ||
+          (!allow_unresolved_translation &&
+           crucible_digest_is_zero(mutation->expected_translation)))) ||
+        (mutation->address_space != CRUCIBLE_MEMORY_MUTATION_ADDRESS_GPA &&
+         mutation->address_space != CRUCIBLE_MEMORY_MUTATION_ADDRESS_GVA)) {
+        return -EINVAL;
+    }
+    if (allocate) {
+        mutation->mask = g_memdup2(
+            payload + CRUCIBLE_MEMORY_MUTATION_BODY_OFFSET, length);
+        if (values_length) {
+            mutation->values = g_memdup2(
+                payload + CRUCIBLE_MEMORY_MUTATION_BODY_OFFSET + length,
+                length);
+        }
+    }
+    return 0;
+}
+
+static void crucible_memory_mutation_free(CrucibleMemoryMutation *mutation)
+{
+    if (!mutation) {
+        return;
+    }
+    g_free(mutation->mask);
+    g_free(mutation->values);
+    g_clear_pointer(&mutation->mappings, g_array_unref);
+    g_clear_pointer(&mutation->translations, g_array_unref);
+    g_clear_pointer(&mutation->fragments, g_array_unref);
+    g_clear_pointer(&mutation->dirty_ranges, g_array_unref);
+    g_clear_pointer(&mutation->before, g_byte_array_unref);
+    g_clear_pointer(&mutation->after, g_byte_array_unref);
+    g_free(mutation);
+}
+
+static void crucible_memory_batch_action_free(gpointer opaque)
+{
+    CrucibleMemoryBatchAction *action = opaque;
+
+    if (!action) {
+        return;
+    }
+    crucible_memory_mutation_free(action->mutation);
+    g_clear_pointer(&action->evidence, g_byte_array_unref);
+    g_free(action);
+}
+
+static void crucible_memory_batch_free(void *opaque)
+{
+    CrucibleMemoryBatch *batch = opaque;
+
+    if (!batch) {
+        return;
+    }
+    g_clear_pointer(&batch->actions, g_ptr_array_unref);
+    g_free(batch);
+}
+
+static int crucible_memory_batch_parse(
+    const struct qemu_plugin_crucible_fault_command *command,
+    const uint8_t *payload, size_t payload_len, bool allocate,
+    CrucibleMemoryBatch **batch_out)
+{
+    bool prepare_only = command->command_flags &
+                        CRUCIBLE_FAULT_COMMAND_FLAG_PREPARE_ONLY;
+    g_autoptr(GPtrArray) actions = g_ptr_array_new_with_free_func(
+        crucible_memory_batch_action_free);
+    uint32_t count;
+    uint32_t records_length;
+    uint64_t total_changed = 0;
+    size_t offset;
+
+    if (command->phase != CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY ||
+        crucible_digest_is_zero(command->target_node_hash) || !payload ||
+        payload_len < CRUCIBLE_MEMORY_MUTATION_BATCH_HEADER_V1_BYTES ||
+        payload_len > CRUCIBLE_FAULT_HARD_PAYLOAD_BYTES ||
+        memcmp(payload, CRUCIBLE_MEMORY_MUTATION_BATCH_MAGIC_V1, 8) != 0 ||
+        crucible_lduw(payload, CRUCIBLE_MEMORY_MUTATION_BATCH_VERSION_OFFSET) !=
+            CRUCIBLE_MEMORY_MUTATION_BATCH_VERSION_V1 ||
+        crucible_lduw(payload, 10) != 0) {
+        return -EINVAL;
+    }
+    for (size_t i = CRUCIBLE_MEMORY_MUTATION_BATCH_RESERVED_OFFSET;
+         i < CRUCIBLE_MEMORY_MUTATION_BATCH_BODY_OFFSET; i++) {
+        if (payload[i] != 0) {
+            return -EINVAL;
+        }
+    }
+    count = crucible_ldl(payload, CRUCIBLE_MEMORY_MUTATION_BATCH_COUNT_OFFSET);
+    records_length = crucible_ldl(
+        payload, CRUCIBLE_MEMORY_MUTATION_BATCH_RECORDS_LENGTH_OFFSET);
+    if (count == 0 || count > CRUCIBLE_MEMORY_MUTATION_BATCH_MAX_ACTIONS ||
+        records_length !=
+            payload_len - CRUCIBLE_MEMORY_MUTATION_BATCH_BODY_OFFSET ||
+        (prepare_only &&
+         (!crucible_digest_is_zero(command->expected_precondition_hash) ||
+          !crucible_digest_is_zero(
+              payload + CRUCIBLE_MEMORY_MUTATION_BATCH_PRECONDITION_OFFSET))) ||
+        (!prepare_only &&
+         (crucible_digest_is_zero(command->expected_precondition_hash) ||
+          memcmp(command->expected_precondition_hash,
+                 payload + CRUCIBLE_MEMORY_MUTATION_BATCH_PRECONDITION_OFFSET,
+                 32) != 0))) {
+        return -EINVAL;
+    }
+    offset = CRUCIBLE_MEMORY_MUTATION_BATCH_BODY_OFFSET;
+    for (uint32_t index = 0; index < count; index++) {
+        CrucibleMemoryBatchAction *action;
+        uint32_t nested_length;
+        size_t nested_offset;
+        size_t nested_end;
+
+        if (offset > payload_len -
+                         CRUCIBLE_MEMORY_MUTATION_BATCH_RECORD_V1_BYTES) {
+            return -EINVAL;
+        }
+        nested_length = crucible_ldl(
+            payload + offset,
+            CRUCIBLE_MEMORY_MUTATION_BATCH_RECORD_LENGTH_OFFSET);
+        nested_offset = offset +
+                        CRUCIBLE_MEMORY_MUTATION_BATCH_RECORD_BODY_OFFSET;
+        if (nested_length > payload_len - nested_offset) {
+            return -EINVAL;
+        }
+        nested_end = nested_offset + nested_length;
+        for (size_t i =
+                 offset + CRUCIBLE_MEMORY_MUTATION_BATCH_RECORD_RESERVED_OFFSET;
+             i < nested_offset; i++) {
+            if (payload[i] != 0) {
+                return -EINVAL;
+            }
+        }
+        action = g_new0(CrucibleMemoryBatchAction, 1);
+        memcpy(action->action_hash,
+               payload + offset +
+                   CRUCIBLE_MEMORY_MUTATION_BATCH_RECORD_ACTION_HASH_OFFSET,
+               32);
+        if (crucible_digest_is_zero(action->action_hash)) {
+            crucible_memory_batch_action_free(action);
+            return -EINVAL;
+        }
+        for (guint earlier = 0; earlier < actions->len; earlier++) {
+            CrucibleMemoryBatchAction *candidate =
+                g_ptr_array_index(actions, earlier);
+            if (memcmp(candidate->action_hash, action->action_hash, 32) == 0) {
+                crucible_memory_batch_action_free(action);
+                return -EINVAL;
+            }
+        }
+        action->mutation = g_new0(CrucibleMemoryMutation, 1);
+        action->mutation->prepare_only = true;
+        if (crucible_memory_parse(payload + nested_offset, nested_length,
+                                  action->mutation, allocate, true) != 0) {
+            crucible_memory_batch_action_free(action);
+            return -EINVAL;
+        }
+        total_changed += action->mutation->length;
+        if (total_changed >
+            CRUCIBLE_MEMORY_MUTATION_BATCH_MAX_CHANGED_BYTES) {
+            crucible_memory_batch_action_free(action);
+            return -E2BIG;
+        }
+        g_ptr_array_add(actions, action);
+        offset = nested_end;
+    }
+    if (offset != payload_len) {
+        return -EINVAL;
+    }
+    if (allocate) {
+        CrucibleMemoryBatch *batch = g_new0(CrucibleMemoryBatch, 1);
+        batch->prepare_only = prepare_only;
+        memcpy(batch->expected_precondition,
+               command->expected_precondition_hash, 32);
+        batch->actions = g_steal_pointer(&actions);
+        *batch_out = batch;
+    }
+    return 0;
+}
+
+static int crucible_memory_validate(
+    const struct qemu_plugin_crucible_fault_command *command,
+    const uint8_t *payload, size_t payload_len)
+{
+    return crucible_memory_batch_parse(command, payload, payload_len, false,
+                                       NULL);
+}
+
+static int crucible_memory_arm(
+    const struct qemu_plugin_crucible_fault_command *command,
+    const uint8_t *payload, size_t payload_len, void **state_out)
+{
+    CrucibleMemoryBatch *batch = NULL;
+    int status = crucible_memory_batch_parse(
+        command, payload, payload_len, true, &batch);
+
+    if (status != 0) {
+        return status;
+    }
+    *state_out = batch;
+    return 0;
+}
+
+static void crucible_memory_identity_region(MemoryRegion *mr,
+                                            uint8_t digest[32], int *status)
+{
+    g_autofree char *owner_path = NULL;
+    g_autoptr(GChecksum) checksum = NULL;
+    Object *owner = memory_region_owner(mr);
+    const char *name = memory_region_name(mr);
+    size_t owner_len;
+    size_t name_len;
+
+    if (!owner || !name || !name[0]) {
+        *status = -ENODATA;
+        return;
+    }
+    owner_path = object_get_canonical_path(owner);
+    if (!owner_path || !owner_path[0] ||
+        strlen(owner_path) > UINT32_MAX || strlen(name) > UINT32_MAX) {
+        *status = -ENODATA;
+        return;
+    }
+    owner_len = strlen(owner_path);
+    name_len = strlen(name);
+    checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    g_checksum_update(checksum,
+        (const guchar *)CRUCIBLE_MEMORY_REGION_IDENTITY_SHA256_DOMAIN_V1,
+        CRUCIBLE_MEMORY_REGION_IDENTITY_SHA256_DOMAIN_V1_BYTES);
+    crucible_checksum_u32(checksum, owner_len);
+    g_checksum_update(checksum, (const guchar *)owner_path, owner_len);
+    crucible_checksum_u32(checksum, name_len);
+    g_checksum_update(checksum, (const guchar *)name, name_len);
+    crucible_checksum_finish(checksum, digest);
+}
+
+static void crucible_memory_identity_ram_block(RAMBlock *block,
+                                               uint8_t digest[32], int *status)
+{
+    g_autoptr(GChecksum) checksum = NULL;
+    const char *id = qemu_ram_get_idstr(block);
+    size_t id_len;
+
+    if (!id || !id[0] || strlen(id) > UINT32_MAX) {
+        *status = -ENODATA;
+        return;
+    }
+    id_len = strlen(id);
+    checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    g_checksum_update(checksum,
+        (const guchar *)CRUCIBLE_MEMORY_RAM_BLOCK_IDENTITY_SHA256_DOMAIN_V1,
+        CRUCIBLE_MEMORY_RAM_BLOCK_IDENTITY_SHA256_DOMAIN_V1_BYTES);
+    crucible_checksum_u32(checksum, id_len);
+    g_checksum_update(checksum, (const guchar *)id, id_len);
+    crucible_checksum_finish(checksum, digest);
+}
+
+static bool crucible_memory_collect_mapping(
+    const MemoryRegionSection *section, void *opaque)
+{
+    CrucibleMemoryMapCollector *collector = opaque;
+    CrucibleMemoryMapping mapping = { 0 };
+    RAMBlock *block;
+    ram_addr_t block_offset;
+
+    if (!memory_region_is_ram(section->mr)) {
+        return false;
+    }
+    if (memory_region_is_protected(section->mr)) {
+        return false;
+    }
+    if (section->readonly || memory_region_is_rom(section->mr) ||
+        memory_region_is_ram_device(section->mr)) {
+        return false;
+    }
+    if (collector->mappings->len >= CRUCIBLE_MEMORY_MAX_MAPPINGS ||
+        int128_gethi(section->size) != 0) {
+        collector->status = -E2BIG;
+        return true;
+    }
+    mapping.mr = section->mr;
+    mapping.gpa = section->offset_within_address_space;
+    mapping.length = int128_getlo(section->size);
+    mapping.mr_offset = section->offset_within_region;
+    if (mapping.length == 0 ||
+        mapping.gpa > UINT64_MAX - (mapping.length - 1) ||
+        mapping.mr_offset > UINT64_MAX - (mapping.length - 1)) {
+        collector->status = -EOVERFLOW;
+        return true;
+    }
+    mapping.host = memory_region_get_ram_ptr(mapping.mr) + mapping.mr_offset;
+    block = qemu_ram_block_from_host(mapping.host, false, &block_offset);
+    if (!block || block_offset > UINT64_MAX - (mapping.length - 1)) {
+        collector->status = -ENODATA;
+        return true;
+    }
+    mapping.ram_block_offset = block_offset;
+    crucible_memory_identity_region(mapping.mr, mapping.mr_identity,
+                                    &collector->status);
+    if (collector->status == 0) {
+        crucible_memory_identity_ram_block(block, mapping.ram_block_identity,
+                                           &collector->status);
+    }
+    if (collector->status != 0) {
+        return true;
+    }
+    g_array_append_val(collector->mappings, mapping);
+    return false;
+}
+
+static void crucible_memory_encode_mapping(const CrucibleMemoryMapping *mapping,
+                                           uint8_t bytes[104])
+{
+    memset(bytes, 0, 104);
+    stq_le_p(bytes + CRUCIBLE_MEMORY_MAPPING_GPA_OFFSET, mapping->gpa);
+    stq_le_p(bytes + CRUCIBLE_MEMORY_MAPPING_LENGTH_OFFSET, mapping->length);
+    stq_le_p(bytes + CRUCIBLE_MEMORY_MAPPING_REGION_OFFSET,
+             mapping->mr_offset);
+    stq_le_p(bytes + CRUCIBLE_MEMORY_MAPPING_RAM_BLOCK_OFFSET,
+             mapping->ram_block_offset);
+    memcpy(bytes + CRUCIBLE_MEMORY_MAPPING_REGION_IDENTITY_OFFSET,
+           mapping->mr_identity, 32);
+    memcpy(bytes + CRUCIBLE_MEMORY_MAPPING_RAM_BLOCK_IDENTITY_OFFSET,
+           mapping->ram_block_identity, 32);
+}
+
+static int crucible_memory_collect_mappings(CrucibleMemoryMutation *mutation)
+{
+    CrucibleMemoryMapCollector collector = {
+        .mappings = g_array_new(false, false, sizeof(CrucibleMemoryMapping)),
+    };
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    FlatView *view = address_space_to_flatview(&address_space_memory);
+
+    flatview_for_each_section(view, crucible_memory_collect_mapping,
+                              &collector);
+    if (collector.status != 0 || collector.mappings->len == 0) {
+        g_array_unref(collector.mappings);
+        return collector.status ? collector.status : -ENODATA;
+    }
+    g_checksum_update(checksum,
+        (const guchar *)CRUCIBLE_MEMORY_MAPPING_SHA256_DOMAIN_V1,
+        CRUCIBLE_MEMORY_MAPPING_SHA256_DOMAIN_V1_BYTES);
+    crucible_checksum_u32(checksum, collector.mappings->len);
+    for (guint i = 0; i < collector.mappings->len; i++) {
+        CrucibleMemoryMapping *mapping = &g_array_index(
+            collector.mappings, CrucibleMemoryMapping, i);
+        uint8_t encoded[CRUCIBLE_MEMORY_MAPPING_RECORD_V1_BYTES];
+
+        crucible_memory_encode_mapping(mapping, encoded);
+        g_checksum_update(checksum, encoded, sizeof(encoded));
+    }
+    crucible_checksum_finish(checksum, mutation->mapping_hash);
+    mutation->mappings = collector.mappings;
+    return 0;
+}
+
+static void crucible_memory_encode_translation(
+    const CrucibleMemoryTranslation *translation, uint8_t bytes[32])
+{
+    memset(bytes, 0, 32);
+    stq_le_p(bytes + CRUCIBLE_MEMORY_TRANSLATION_VIRTUAL_PAGE_OFFSET,
+             translation->virtual_page);
+    stq_le_p(bytes + CRUCIBLE_MEMORY_TRANSLATION_PHYSICAL_PAGE_OFFSET,
+             translation->physical_page);
+    stq_le_p(bytes + CRUCIBLE_MEMORY_TRANSLATION_PAGE_SIZE_OFFSET,
+             translation->page_size);
+    stw_le_p(bytes + CRUCIBLE_MEMORY_TRANSLATION_PERMISSIONS_OFFSET,
+             translation->permissions);
+    stw_le_p(bytes + CRUCIBLE_MEMORY_TRANSLATION_ATTRIBUTES_OFFSET,
+             translation->attributes);
+    stl_le_p(bytes + CRUCIBLE_MEMORY_TRANSLATION_COVERED_BYTES_OFFSET,
+             translation->covered_bytes);
+}
+
+static int crucible_memory_translate(CrucibleMemoryMutation *mutation)
+{
+    g_autoptr(GChecksum) checksum = NULL;
+    uint64_t current = mutation->address;
+    uint32_t remaining = mutation->length;
+    CPUState *cpu;
+
+    mutation->translations = g_array_new(
+        false, false, sizeof(CrucibleMemoryTranslation));
+    if (mutation->address_space == CRUCIBLE_MEMORY_MUTATION_ADDRESS_GPA) {
+        memset(mutation->translation_hash, 0, 32);
+        return 0;
+    }
+    cpu = qemu_get_cpu(mutation->vcpu_index);
+    if (!cpu) {
+        return -ENOENT;
+    }
+    while (remaining) {
+        CPUFaultTranslation resolved;
+        CrucibleMemoryTranslation translation = { 0 };
+        uint64_t offset;
+        uint64_t available;
+
+        if (!cpu_get_fault_translation(cpu, current, MMU_DATA_STORE,
+                                       &resolved) ||
+            resolved.page_size == 0 ||
+            current % resolved.page_size > resolved.physical_address) {
+            return -EFAULT;
+        }
+        offset = current % resolved.page_size;
+        translation.virtual_page = current - offset;
+        translation.physical_page = resolved.physical_address - offset;
+        translation.page_size = resolved.page_size;
+        available = resolved.page_size - offset;
+        translation.covered_bytes = MIN((uint64_t)remaining, available);
+        translation.permissions = CRUCIBLE_MEMORY_TRANSLATION_PERMISSION_READ |
+                                  CRUCIBLE_MEMORY_TRANSLATION_PERMISSION_WRITE;
+        if (resolved.executable) {
+            translation.permissions |=
+                CRUCIBLE_MEMORY_TRANSLATION_PERMISSION_EXECUTE;
+        }
+        if (resolved.user) {
+            translation.permissions |=
+                CRUCIBLE_MEMORY_TRANSLATION_PERMISSION_USER;
+            translation.attributes |=
+                CRUCIBLE_MEMORY_TRANSLATION_ATTRIBUTE_USER;
+        }
+        if (resolved.attrs.secure) {
+            translation.attributes |=
+                CRUCIBLE_MEMORY_TRANSLATION_ATTRIBUTE_SECURE;
+        }
+        g_array_append_val(mutation->translations, translation);
+        current += translation.covered_bytes;
+        remaining -= translation.covered_bytes;
+    }
+    checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    g_checksum_update(checksum,
+        (const guchar *)CRUCIBLE_MEMORY_TRANSLATION_SHA256_DOMAIN_V1,
+        CRUCIBLE_MEMORY_TRANSLATION_SHA256_DOMAIN_V1_BYTES);
+    crucible_checksum_u32(checksum, mutation->vcpu_index);
+    crucible_checksum_u32(checksum, mutation->translations->len);
+    for (guint i = 0; i < mutation->translations->len; i++) {
+        CrucibleMemoryTranslation *translation = &g_array_index(
+            mutation->translations, CrucibleMemoryTranslation, i);
+        uint8_t encoded[CRUCIBLE_MEMORY_TRANSLATION_RECORD_V1_BYTES];
+
+        crucible_memory_encode_translation(translation, encoded);
+        g_checksum_update(checksum, encoded, sizeof(encoded));
+    }
+    crucible_checksum_finish(checksum, mutation->translation_hash);
+    if (!mutation->prepare_only &&
+        memcmp(mutation->translation_hash, mutation->expected_translation,
+               32) != 0) {
+        return -ESTALE;
+    }
+    return 0;
+}
+
+static CrucibleMemoryMapping *crucible_memory_find_mapping(
+    CrucibleMemoryMutation *mutation, uint64_t gpa)
+{
+    for (guint i = 0; i < mutation->mappings->len; i++) {
+        CrucibleMemoryMapping *mapping = &g_array_index(
+            mutation->mappings, CrucibleMemoryMapping, i);
+
+        if (gpa >= mapping->gpa && gpa - mapping->gpa < mapping->length) {
+            return mapping;
+        }
+    }
+    return NULL;
+}
+
+static int crucible_memory_append_physical_fragments(
+    CrucibleMemoryMutation *mutation, uint64_t gpa, uint32_t request_offset,
+    uint32_t length, bool invalidate_tb)
+{
+    while (length) {
+        CrucibleMemoryMapping *mapping =
+            crucible_memory_find_mapping(mutation, gpa);
+        CrucibleMemoryFragment fragment = { 0 };
+        uint64_t mapping_offset;
+        uint64_t available;
+
+        if (!mapping) {
+            return -EFAULT;
+        }
+        mapping_offset = gpa - mapping->gpa;
+        available = mapping->length - mapping_offset;
+        fragment.mapping = mapping;
+        fragment.gpa = gpa;
+        fragment.request_offset = request_offset;
+        fragment.length = MIN((uint64_t)length, available);
+        fragment.flags = invalidate_tb ?
+            CRUCIBLE_MEMORY_MUTATION_FRAGMENT_TB_INVALIDATED : 0;
+        fragment.mr_offset = mapping->mr_offset + mapping_offset;
+        fragment.ram_block_offset = mapping->ram_block_offset + mapping_offset;
+        memcpy(fragment.mr_identity, mapping->mr_identity, 32);
+        memcpy(fragment.ram_block_identity, mapping->ram_block_identity, 32);
+        g_array_append_val(mutation->fragments, fragment);
+        gpa += fragment.length;
+        request_offset += fragment.length;
+        length -= fragment.length;
+    }
+    return 0;
+}
+
+static int crucible_memory_resolve_fragments(CrucibleMemoryMutation *mutation)
+{
+    mutation->fragments = g_array_new(false, false,
+                                      sizeof(CrucibleMemoryFragment));
+    if (mutation->address_space == CRUCIBLE_MEMORY_MUTATION_ADDRESS_GPA) {
+        return crucible_memory_append_physical_fragments(
+            mutation, mutation->address, 0, mutation->length, true);
+    }
+    uint32_t request_offset = 0;
+    for (guint i = 0; i < mutation->translations->len; i++) {
+        CrucibleMemoryTranslation *translation = &g_array_index(
+            mutation->translations, CrucibleMemoryTranslation, i);
+        uint64_t virtual_address = mutation->address + request_offset;
+        uint64_t gpa = translation->physical_page +
+                       (virtual_address - translation->virtual_page);
+        bool invalidate_tb = translation->permissions &
+                             CRUCIBLE_MEMORY_TRANSLATION_PERMISSION_EXECUTE;
+        int status = crucible_memory_append_physical_fragments(
+            mutation, gpa, request_offset, translation->covered_bytes,
+            invalidate_tb);
+
+        if (status != 0) {
+            return status;
+        }
+        request_offset += translation->covered_bytes;
+    }
+    return request_offset == mutation->length ? 0 : -EFAULT;
+}
+
+static int crucible_dirty_compare(gconstpointer left, gconstpointer right)
+{
+    const CrucibleMemoryDirtyRange *a = left;
+    const CrucibleMemoryDirtyRange *b = right;
+    int identity = memcmp(a->ram_block_identity, b->ram_block_identity, 32);
+
+    if (identity) {
+        return identity;
+    }
+    return a->offset < b->offset ? -1 : a->offset > b->offset;
+}
+
+static void crucible_memory_encode_dirty(
+    const CrucibleMemoryDirtyRange *range, uint8_t bytes[48])
+{
+    uint64_t pages = (range->end - range->offset) /
+                     CRUCIBLE_MEMORY_DIRTY_PAGE_SIZE;
+
+    g_assert(pages > 0 && pages <= UINT32_MAX);
+    memset(bytes, 0, 48);
+    memcpy(bytes + CRUCIBLE_MEMORY_DIRTY_RANGE_RAM_BLOCK_IDENTITY_OFFSET,
+           range->ram_block_identity, 32);
+    stq_le_p(bytes + CRUCIBLE_MEMORY_DIRTY_RANGE_RAM_BLOCK_OFFSET,
+             range->offset);
+    stl_le_p(bytes + CRUCIBLE_MEMORY_DIRTY_RANGE_PAGE_COUNT_OFFSET, pages);
+    stl_le_p(bytes + CRUCIBLE_MEMORY_DIRTY_RANGE_PAGE_SIZE_OFFSET,
+             CRUCIBLE_MEMORY_DIRTY_PAGE_SIZE);
+}
+
+static int crucible_memory_derive_dirty(CrucibleMemoryMutation *mutation)
+{
+    GArray *raw = g_array_new(false, false, sizeof(CrucibleMemoryDirtyRange));
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+
+    mutation->dirty_ranges = g_array_new(
+        false, false, sizeof(CrucibleMemoryDirtyRange));
+    for (guint i = 0; i < mutation->fragments->len; i++) {
+        CrucibleMemoryFragment *fragment = &g_array_index(
+            mutation->fragments, CrucibleMemoryFragment, i);
+        CrucibleMemoryDirtyRange range = { 0 };
+        uint64_t last = fragment->ram_block_offset + fragment->length - 1;
+
+        memcpy(range.ram_block_identity, fragment->ram_block_identity, 32);
+        range.offset = fragment->ram_block_offset /
+                       CRUCIBLE_MEMORY_DIRTY_PAGE_SIZE *
+                       CRUCIBLE_MEMORY_DIRTY_PAGE_SIZE;
+        range.end = (last / CRUCIBLE_MEMORY_DIRTY_PAGE_SIZE + 1) *
+                    CRUCIBLE_MEMORY_DIRTY_PAGE_SIZE;
+        if (range.end <= range.offset) {
+            g_array_unref(raw);
+            return -EOVERFLOW;
+        }
+        g_array_append_val(raw, range);
+    }
+    g_array_sort(raw, crucible_dirty_compare);
+    for (guint i = 0; i < raw->len; i++) {
+        CrucibleMemoryDirtyRange range = g_array_index(
+            raw, CrucibleMemoryDirtyRange, i);
+        if (mutation->dirty_ranges->len) {
+            CrucibleMemoryDirtyRange *previous = &g_array_index(
+                mutation->dirty_ranges, CrucibleMemoryDirtyRange,
+                mutation->dirty_ranges->len - 1);
+            if (memcmp(previous->ram_block_identity,
+                       range.ram_block_identity, 32) == 0 &&
+                range.offset <= previous->end) {
+                previous->end = MAX(previous->end, range.end);
+                continue;
+            }
+        }
+        g_array_append_val(mutation->dirty_ranges, range);
+    }
+    g_array_unref(raw);
+    g_checksum_update(checksum,
+        (const guchar *)CRUCIBLE_MEMORY_DIRTY_SHA256_DOMAIN_V1,
+        CRUCIBLE_MEMORY_DIRTY_SHA256_DOMAIN_V1_BYTES);
+    crucible_checksum_u32(checksum, mutation->dirty_ranges->len);
+    for (guint i = 0; i < mutation->dirty_ranges->len; i++) {
+        CrucibleMemoryDirtyRange *range = &g_array_index(
+            mutation->dirty_ranges, CrucibleMemoryDirtyRange, i);
+        uint8_t encoded[CRUCIBLE_MEMORY_DIRTY_RANGE_V1_BYTES];
+
+        if ((range->end - range->offset) /
+            CRUCIBLE_MEMORY_DIRTY_PAGE_SIZE > UINT32_MAX) {
+            return -EOVERFLOW;
+        }
+        crucible_memory_encode_dirty(range, encoded);
+        g_checksum_update(checksum, encoded, sizeof(encoded));
+    }
+    crucible_checksum_finish(checksum, mutation->dirty_hash);
+    return 0;
+}
+
+static void crucible_memory_capture_bytes(CrucibleMemoryMutation *mutation)
+{
+    mutation->before = g_byte_array_sized_new(mutation->length);
+    mutation->after = g_byte_array_sized_new(mutation->length);
+    g_byte_array_set_size(mutation->before, mutation->length);
+    g_byte_array_set_size(mutation->after, mutation->length);
+    for (guint i = 0; i < mutation->fragments->len; i++) {
+        CrucibleMemoryFragment *fragment = &g_array_index(
+            mutation->fragments, CrucibleMemoryFragment, i);
+        memcpy(mutation->before->data + fragment->request_offset,
+               fragment->mapping->host +
+                   (fragment->mr_offset - fragment->mapping->mr_offset),
+               fragment->length);
+    }
+}
+
+static void crucible_memory_apply_transform(CrucibleMemoryMutation *mutation)
+{
+    for (uint32_t i = 0; i < mutation->length; i++) {
+        uint8_t before = mutation->before->data[i];
+
+        if (mutation->transform ==
+            CRUCIBLE_MEMORY_MUTATION_TRANSFORM_BIT_FLIP) {
+            mutation->after->data[i] = before ^ mutation->mask[i];
+        } else {
+            mutation->after->data[i] =
+                (before & ~mutation->mask[i]) |
+                (mutation->values[i] & mutation->mask[i]);
+        }
+    }
+}
+
+static void crucible_memory_overlay_prior(
+    CrucibleMemoryBatch *batch, guint action_index,
+    CrucibleMemoryMutation *mutation)
+{
+    for (guint prior_index = 0; prior_index < action_index; prior_index++) {
+        CrucibleMemoryBatchAction *prior_action =
+            g_ptr_array_index(batch->actions, prior_index);
+        CrucibleMemoryMutation *prior = prior_action->mutation;
+
+        for (guint current_index = 0;
+             current_index < mutation->fragments->len; current_index++) {
+            CrucibleMemoryFragment *current = &g_array_index(
+                mutation->fragments, CrucibleMemoryFragment, current_index);
+            uint64_t current_end = current->ram_block_offset + current->length;
+
+            for (guint fragment_index = 0;
+                 fragment_index < prior->fragments->len; fragment_index++) {
+                CrucibleMemoryFragment *earlier = &g_array_index(
+                    prior->fragments, CrucibleMemoryFragment, fragment_index);
+                uint64_t earlier_end = earlier->ram_block_offset +
+                                       earlier->length;
+                uint64_t start;
+                uint64_t end;
+
+                if (memcmp(current->ram_block_identity,
+                           earlier->ram_block_identity, 32) != 0) {
+                    continue;
+                }
+                start = MAX(current->ram_block_offset,
+                            earlier->ram_block_offset);
+                end = MIN(current_end, earlier_end);
+                if (start >= end) {
+                    continue;
+                }
+                memcpy(
+                    mutation->before->data + current->request_offset +
+                        (start - current->ram_block_offset),
+                    prior->after->data + earlier->request_offset +
+                        (start - earlier->ram_block_offset),
+                    end - start);
+            }
+        }
+    }
+}
+
+static void crucible_memory_encode_fragment(
+    const CrucibleMemoryFragment *fragment, uint8_t bytes[104])
+{
+    memset(bytes, 0, 104);
+    stq_le_p(bytes + CRUCIBLE_MEMORY_MUTATION_FRAGMENT_GPA_OFFSET,
+             fragment->gpa);
+    stl_le_p(bytes + CRUCIBLE_MEMORY_MUTATION_FRAGMENT_REQUEST_OFFSET,
+             fragment->request_offset);
+    stl_le_p(bytes + CRUCIBLE_MEMORY_MUTATION_FRAGMENT_LENGTH_OFFSET,
+             fragment->length);
+    stl_le_p(bytes + CRUCIBLE_MEMORY_MUTATION_FRAGMENT_FLAGS_OFFSET,
+             fragment->flags);
+    stq_le_p(bytes + CRUCIBLE_MEMORY_MUTATION_FRAGMENT_REGION_OFFSET,
+             fragment->mr_offset);
+    stq_le_p(bytes + CRUCIBLE_MEMORY_MUTATION_FRAGMENT_RAM_BLOCK_OFFSET,
+             fragment->ram_block_offset);
+    memcpy(bytes + CRUCIBLE_MEMORY_MUTATION_FRAGMENT_REGION_IDENTITY_OFFSET,
+           fragment->mr_identity, 32);
+    memcpy(bytes + CRUCIBLE_MEMORY_MUTATION_FRAGMENT_RAM_BLOCK_IDENTITY_OFFSET,
+           fragment->ram_block_identity, 32);
+}
+
+static void crucible_memory_node_fingerprint(
+    const struct qemu_plugin_crucible_fault_command *command,
+    const CrucibleMemoryMutation *mutation, uint64_t observed_icount,
+    const uint8_t before_hash[32], const uint8_t after_hash[32],
+    bool invalidated, uint64_t invalidated_start, uint64_t invalidated_end,
+    uint8_t digest[32])
+{
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    uint8_t present = invalidated;
+
+    g_checksum_update(checksum,
+        (const guchar *)CRUCIBLE_MEMORY_BOUNDARY_FINGERPRINT_SHA256_DOMAIN_V1,
+        CRUCIBLE_MEMORY_BOUNDARY_FINGERPRINT_SHA256_DOMAIN_V1_BYTES);
+    g_checksum_update(checksum, command->target_node_hash, 32);
+    crucible_checksum_u64(checksum, observed_icount);
+    crucible_checksum_u16(checksum, mutation->address_space);
+    crucible_checksum_u16(checksum, mutation->transform);
+    crucible_checksum_u32(checksum, mutation->vcpu_index);
+    crucible_checksum_u64(checksum, mutation->address);
+    crucible_checksum_u32(checksum, mutation->length);
+    g_checksum_update(checksum, before_hash, 32);
+    g_checksum_update(checksum, after_hash, 32);
+    g_checksum_update(checksum, mutation->translation_hash, 32);
+    g_checksum_update(checksum, mutation->mapping_hash, 32);
+    g_checksum_update(checksum, mutation->dirty_hash, 32);
+    g_checksum_update(checksum, &present, 1);
+    crucible_checksum_u64(checksum, invalidated_start);
+    crucible_checksum_u64(checksum, invalidated_end);
+    crucible_checksum_finish(checksum, digest);
+}
+
+static void crucible_memory_build_evidence(
+    const struct qemu_plugin_crucible_fault_command *command,
+    CrucibleMemoryMutation *mutation,
+    struct qemu_plugin_crucible_fault_result *result,
+    GByteArray *payload)
+{
+    uint32_t inline_len = mutation->length <=
+                          CRUCIBLE_MEMORY_MUTATION_EVIDENCE_INLINE_BYTES ?
+                          mutation->length : 0;
+    bool invalidated = false;
+    uint64_t invalidated_start = UINT64_MAX;
+    uint64_t invalidated_end = 0;
+    uint16_t flags = inline_len ?
+        CRUCIBLE_MEMORY_MUTATION_EVIDENCE_FLAG_INLINE_BYTES : 0;
+    uint8_t node_fingerprint[32];
+    size_t body_size;
+
+    for (guint i = 0; i < mutation->fragments->len; i++) {
+        CrucibleMemoryFragment *fragment = &g_array_index(
+            mutation->fragments, CrucibleMemoryFragment, i);
+        if (fragment->flags &
+            CRUCIBLE_MEMORY_MUTATION_FRAGMENT_TB_INVALIDATED) {
+            invalidated = true;
+            invalidated_start = MIN(invalidated_start, fragment->gpa);
+            invalidated_end = MAX(invalidated_end,
+                                  fragment->gpa + fragment->length - 1);
+        }
+    }
+    if (invalidated) {
+        flags |= CRUCIBLE_MEMORY_MUTATION_EVIDENCE_FLAG_TB_INVALIDATED;
+    } else {
+        invalidated_start = 0;
+    }
+    crucible_memory_node_fingerprint(
+        command, mutation, result->observed_icount, result->before_hash,
+        result->after_hash, invalidated, invalidated_start, invalidated_end,
+        node_fingerprint);
+    body_size = mutation->translations->len *
+                    CRUCIBLE_MEMORY_TRANSLATION_RECORD_V1_BYTES +
+                mutation->fragments->len *
+                    CRUCIBLE_MEMORY_MUTATION_FRAGMENT_V1_BYTES +
+                mutation->mappings->len *
+                    CRUCIBLE_MEMORY_MAPPING_RECORD_V1_BYTES +
+                mutation->dirty_ranges->len *
+                    CRUCIBLE_MEMORY_DIRTY_RANGE_V1_BYTES +
+                2 * inline_len;
+    g_byte_array_set_size(payload,
+        CRUCIBLE_MEMORY_MUTATION_EVIDENCE_HEADER_V1_BYTES + body_size);
+    memset(payload->data, 0,
+           CRUCIBLE_MEMORY_MUTATION_EVIDENCE_HEADER_V1_BYTES);
+    memcpy(payload->data, CRUCIBLE_MEMORY_MUTATION_EVIDENCE_MAGIC_V1, 8);
+    stw_le_p(payload->data + CRUCIBLE_MEMORY_MUTATION_EVIDENCE_VERSION_OFFSET,
+             CRUCIBLE_MEMORY_MUTATION_EVIDENCE_VERSION_V1);
+    stw_le_p(payload->data + CRUCIBLE_MEMORY_MUTATION_EVIDENCE_FLAGS_OFFSET,
+             flags);
+    stw_le_p(payload->data +
+             CRUCIBLE_MEMORY_MUTATION_EVIDENCE_ADDRESS_SPACE_OFFSET,
+             mutation->address_space);
+    stw_le_p(payload->data + CRUCIBLE_MEMORY_MUTATION_EVIDENCE_TRANSFORM_OFFSET,
+             mutation->transform);
+    stl_le_p(payload->data +
+             CRUCIBLE_MEMORY_MUTATION_EVIDENCE_VCPU_INDEX_OFFSET,
+             mutation->vcpu_index);
+    stl_le_p(payload->data + CRUCIBLE_MEMORY_MUTATION_EVIDENCE_LENGTH_OFFSET,
+             mutation->length);
+    stq_le_p(payload->data + CRUCIBLE_MEMORY_MUTATION_EVIDENCE_ADDRESS_OFFSET,
+             mutation->address);
+    stq_le_p(payload->data +
+             CRUCIBLE_MEMORY_MUTATION_EVIDENCE_OBSERVED_ICOUNT_OFFSET,
+             result->observed_icount);
+    stl_le_p(payload->data +
+             CRUCIBLE_MEMORY_MUTATION_EVIDENCE_TRANSLATION_COUNT_OFFSET,
+             mutation->translations->len);
+    stl_le_p(payload->data +
+             CRUCIBLE_MEMORY_MUTATION_EVIDENCE_FRAGMENT_COUNT_OFFSET,
+             mutation->fragments->len);
+    stl_le_p(payload->data +
+             CRUCIBLE_MEMORY_MUTATION_EVIDENCE_MAPPING_COUNT_OFFSET,
+             mutation->mappings->len);
+    stl_le_p(payload->data +
+             CRUCIBLE_MEMORY_MUTATION_EVIDENCE_DIRTY_COUNT_OFFSET,
+             mutation->dirty_ranges->len);
+    stl_le_p(payload->data +
+             CRUCIBLE_MEMORY_MUTATION_EVIDENCE_INLINE_LENGTH_OFFSET,
+             inline_len);
+    memcpy(payload->data +
+           CRUCIBLE_MEMORY_MUTATION_EVIDENCE_BEFORE_SHA256_OFFSET,
+           result->before_hash, 32);
+    memcpy(payload->data +
+           CRUCIBLE_MEMORY_MUTATION_EVIDENCE_AFTER_SHA256_OFFSET,
+           result->after_hash, 32);
+    memcpy(payload->data +
+           CRUCIBLE_MEMORY_MUTATION_EVIDENCE_TRANSLATION_SHA256_OFFSET,
+           mutation->translation_hash, 32);
+    memcpy(payload->data +
+           CRUCIBLE_MEMORY_MUTATION_EVIDENCE_MAPPING_SHA256_OFFSET,
+           mutation->mapping_hash, 32);
+    memcpy(payload->data +
+           CRUCIBLE_MEMORY_MUTATION_EVIDENCE_DIRTY_SHA256_OFFSET,
+           mutation->dirty_hash, 32);
+    stq_le_p(payload->data +
+             CRUCIBLE_MEMORY_MUTATION_EVIDENCE_INVALIDATED_START_OFFSET,
+             invalidated_start);
+    stq_le_p(payload->data +
+             CRUCIBLE_MEMORY_MUTATION_EVIDENCE_INVALIDATED_END_OFFSET,
+             invalidated_end);
+    memcpy(payload->data +
+           CRUCIBLE_MEMORY_MUTATION_EVIDENCE_TARGET_NODE_HASH_OFFSET,
+           command->target_node_hash, 32);
+    memcpy(payload->data +
+           CRUCIBLE_MEMORY_MUTATION_EVIDENCE_NODE_FINGERPRINT_OFFSET,
+           node_fingerprint, 32);
+
+    size_t offset = CRUCIBLE_MEMORY_MUTATION_EVIDENCE_HEADER_V1_BYTES;
+    for (guint i = 0; i < mutation->translations->len; i++) {
+        CrucibleMemoryTranslation *translation = &g_array_index(
+            mutation->translations, CrucibleMemoryTranslation, i);
+        crucible_memory_encode_translation(translation, payload->data + offset);
+        offset += CRUCIBLE_MEMORY_TRANSLATION_RECORD_V1_BYTES;
+    }
+    for (guint i = 0; i < mutation->fragments->len; i++) {
+        CrucibleMemoryFragment *fragment = &g_array_index(
+            mutation->fragments, CrucibleMemoryFragment, i);
+        crucible_memory_encode_fragment(fragment, payload->data + offset);
+        offset += CRUCIBLE_MEMORY_MUTATION_FRAGMENT_V1_BYTES;
+    }
+    for (guint i = 0; i < mutation->mappings->len; i++) {
+        CrucibleMemoryMapping *mapping = &g_array_index(
+            mutation->mappings, CrucibleMemoryMapping, i);
+        crucible_memory_encode_mapping(mapping, payload->data + offset);
+        offset += CRUCIBLE_MEMORY_MAPPING_RECORD_V1_BYTES;
+    }
+    for (guint i = 0; i < mutation->dirty_ranges->len; i++) {
+        CrucibleMemoryDirtyRange *range = &g_array_index(
+            mutation->dirty_ranges, CrucibleMemoryDirtyRange, i);
+        crucible_memory_encode_dirty(range, payload->data + offset);
+        offset += CRUCIBLE_MEMORY_DIRTY_RANGE_V1_BYTES;
+    }
+    if (inline_len) {
+        memcpy(payload->data + offset, mutation->before->data, inline_len);
+        offset += inline_len;
+        memcpy(payload->data + offset, mutation->after->data, inline_len);
+    }
+    crucible_sha256_parts(payload->data, payload->len, NULL, 0,
+                          result->evidence_hash);
+}
+
+static void crucible_memory_batch_precondition(CrucibleMemoryBatch *batch)
+{
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+
+    g_checksum_update(
+        checksum,
+        (const uint8_t *)
+            CRUCIBLE_MEMORY_MUTATION_BATCH_PRECONDITION_SHA256_DOMAIN_V1,
+        CRUCIBLE_MEMORY_MUTATION_BATCH_PRECONDITION_SHA256_DOMAIN_V1_BYTES);
+    crucible_checksum_u32(checksum, batch->actions->len);
+    for (guint i = 0; i < batch->actions->len; i++) {
+        CrucibleMemoryBatchAction *action =
+            g_ptr_array_index(batch->actions, i);
+
+        g_checksum_update(checksum, action->action_hash, 32);
+        g_checksum_update(checksum, action->mutation->precondition_hash, 32);
+    }
+    crucible_checksum_finish(checksum, batch->precondition_hash);
+}
+
+static void crucible_memory_batch_state_hash(
+    CrucibleMemoryBatch *batch, bool after, uint8_t digest[32])
+{
+    const char *domain = after ?
+        CRUCIBLE_MEMORY_MUTATION_BATCH_AFTER_SHA256_DOMAIN_V1 :
+        CRUCIBLE_MEMORY_MUTATION_BATCH_BEFORE_SHA256_DOMAIN_V1;
+    size_t domain_len = after ?
+        CRUCIBLE_MEMORY_MUTATION_BATCH_AFTER_SHA256_DOMAIN_V1_BYTES :
+        CRUCIBLE_MEMORY_MUTATION_BATCH_BEFORE_SHA256_DOMAIN_V1_BYTES;
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+
+    g_checksum_update(checksum, (const uint8_t *)domain, domain_len);
+    crucible_checksum_u32(checksum, batch->actions->len);
+    for (guint i = 0; i < batch->actions->len; i++) {
+        CrucibleMemoryBatchAction *action =
+            g_ptr_array_index(batch->actions, i);
+        g_checksum_update(checksum, action->action_hash, 32);
+        g_checksum_update(checksum, after ? action->mutation->after_hash :
+                                      action->mutation->before_hash, 32);
+    }
+    crucible_checksum_finish(checksum, digest);
+}
+
+static int crucible_memory_build_batch_evidence(
+    CrucibleMemoryBatch *batch,
+    struct qemu_plugin_crucible_fault_result *result,
+    GByteArray *payload)
+{
+    size_t total = CRUCIBLE_MEMORY_MUTATION_BATCH_EVIDENCE_HEADER_V1_BYTES;
+
+    for (guint i = 0; i < batch->actions->len; i++) {
+        CrucibleMemoryBatchAction *action =
+            g_ptr_array_index(batch->actions, i);
+
+        if (action->evidence->len > UINT32_MAX ||
+            total > CRUCIBLE_FAULT_HARD_PAYLOAD_BYTES -
+                        CRUCIBLE_MEMORY_MUTATION_BATCH_EVIDENCE_RECORD_V1_BYTES ||
+            action->evidence->len >
+                CRUCIBLE_FAULT_HARD_PAYLOAD_BYTES - total -
+                    CRUCIBLE_MEMORY_MUTATION_BATCH_EVIDENCE_RECORD_V1_BYTES) {
+            return -E2BIG;
+        }
+        total += CRUCIBLE_MEMORY_MUTATION_BATCH_EVIDENCE_RECORD_V1_BYTES +
+                 action->evidence->len;
+    }
+    g_byte_array_set_size(payload, total);
+    memset(payload->data, 0,
+           CRUCIBLE_MEMORY_MUTATION_BATCH_EVIDENCE_HEADER_V1_BYTES);
+    memcpy(payload->data, CRUCIBLE_MEMORY_MUTATION_BATCH_EVIDENCE_MAGIC_V1, 8);
+    stw_le_p(payload->data +
+                 CRUCIBLE_MEMORY_MUTATION_BATCH_EVIDENCE_VERSION_OFFSET,
+             CRUCIBLE_MEMORY_MUTATION_BATCH_EVIDENCE_VERSION_V1);
+    stl_le_p(payload->data +
+                 CRUCIBLE_MEMORY_MUTATION_BATCH_EVIDENCE_COUNT_OFFSET,
+             batch->actions->len);
+    memcpy(payload->data +
+               CRUCIBLE_MEMORY_MUTATION_BATCH_EVIDENCE_PRECONDITION_OFFSET,
+           batch->precondition_hash, 32);
+    stl_le_p(
+        payload->data +
+            CRUCIBLE_MEMORY_MUTATION_BATCH_EVIDENCE_RECORDS_LENGTH_OFFSET,
+        total - CRUCIBLE_MEMORY_MUTATION_BATCH_EVIDENCE_BODY_OFFSET);
+
+    size_t offset = CRUCIBLE_MEMORY_MUTATION_BATCH_EVIDENCE_BODY_OFFSET;
+    for (guint i = 0; i < batch->actions->len; i++) {
+        CrucibleMemoryBatchAction *action =
+            g_ptr_array_index(batch->actions, i);
+
+        memcpy(payload->data + offset, action->action_hash, 32);
+        stl_le_p(payload->data + offset +
+                     CRUCIBLE_MEMORY_MUTATION_BATCH_RECORD_LENGTH_OFFSET,
+                 action->evidence->len);
+        memset(payload->data + offset +
+                   CRUCIBLE_MEMORY_MUTATION_BATCH_RECORD_RESERVED_OFFSET,
+               0, 4);
+        offset += CRUCIBLE_MEMORY_MUTATION_BATCH_EVIDENCE_RECORD_V1_BYTES;
+        memcpy(payload->data + offset, action->evidence->data,
+               action->evidence->len);
+        offset += action->evidence->len;
+    }
+    crucible_sha256_parts(payload->data, payload->len, NULL, 0,
+                          result->evidence_hash);
+    return 0;
+}
+
+static int crucible_memory_prepare(
+    const struct qemu_plugin_crucible_fault_command *command,
+    const uint8_t *payload, size_t payload_len, void *state,
+    struct qemu_plugin_crucible_fault_result *result,
+    GByteArray *result_payload)
+{
+    CrucibleMemoryBatch *batch = state;
+    int status = 0;
+
+    (void)payload;
+    (void)payload_len;
+    for (guint i = 0; i < batch->actions->len; i++) {
+        CrucibleMemoryBatchAction *action =
+            g_ptr_array_index(batch->actions, i);
+        CrucibleMemoryMutation *mutation = action->mutation;
+        struct qemu_plugin_crucible_fault_result action_result = {
+            .observed_icount = result->observed_icount,
+        };
+
+        status = crucible_memory_collect_mappings(mutation);
+        if (status == 0) {
+            status = crucible_memory_translate(mutation);
+        }
+        if (status == 0) {
+            status = crucible_memory_resolve_fragments(mutation);
+        }
+        if (status == 0) {
+            status = crucible_memory_derive_dirty(mutation);
+        }
+        if (status != 0) {
+            break;
+        }
+        crucible_memory_capture_bytes(mutation);
+        crucible_memory_overlay_prior(batch, i, mutation);
+        crucible_memory_apply_transform(mutation);
+        crucible_sha256_parts(mutation->before->data, mutation->before->len,
+                              NULL, 0, mutation->before_hash);
+        crucible_sha256_parts(mutation->after->data, mutation->after->len,
+                              NULL, 0, mutation->after_hash);
+        crucible_memory_precondition(
+            mutation, mutation->before_hash, mutation->after_hash,
+            mutation->precondition_hash);
+        memcpy(action_result.before_hash, mutation->before_hash, 32);
+        memcpy(action_result.after_hash, mutation->after_hash, 32);
+        action->evidence = g_byte_array_new();
+        crucible_memory_build_evidence(
+            command, mutation, &action_result, action->evidence);
+    }
+    if (status != 0) {
+        result->status =
+            status == -E2BIG ? CRUCIBLE_FAULT_STATUS_RESOURCE_LIMIT :
+            status == -ESTALE ? CRUCIBLE_FAULT_STATUS_PRECONDITION_MISMATCH :
+            CRUCIBLE_FAULT_STATUS_INVALID_TARGET;
+        return status;
+    }
+    crucible_memory_batch_precondition(batch);
+    if (!batch->prepare_only &&
+        memcmp(batch->precondition_hash, batch->expected_precondition, 32) != 0) {
+        result->status = CRUCIBLE_FAULT_STATUS_PRECONDITION_MISMATCH;
+        return -ESTALE;
+    }
+    crucible_memory_batch_state_hash(batch, false, result->before_hash);
+    crucible_memory_batch_state_hash(batch, true, result->after_hash);
+    status = crucible_memory_build_batch_evidence(batch, result,
+                                                  result_payload);
+    if (status != 0) {
+        result->status = CRUCIBLE_FAULT_STATUS_RESOURCE_LIMIT;
+    }
+    return status;
+}
+
+static void crucible_memory_commit(
+    const struct qemu_plugin_crucible_fault_command *command,
+    const uint8_t *payload, size_t payload_len, void *state,
+    struct qemu_plugin_crucible_fault_result *result,
+    GByteArray *result_payload)
+{
+    CrucibleMemoryBatch *batch = state;
+
+    (void)command;
+    (void)payload;
+    (void)payload_len;
+    (void)result_payload;
+    for (guint action_index = 0;
+         action_index < batch->actions->len; action_index++) {
+        CrucibleMemoryBatchAction *action =
+            g_ptr_array_index(batch->actions, action_index);
+        CrucibleMemoryMutation *mutation = action->mutation;
+
+        for (guint i = 0; i < mutation->fragments->len; i++) {
+            CrucibleMemoryFragment *fragment = &g_array_index(
+                mutation->fragments, CrucibleMemoryFragment, i);
+            memory_region_fault_commit_ram(
+                fragment->mapping->mr, fragment->mr_offset,
+                mutation->after->data + fragment->request_offset,
+                fragment->length);
+        }
+    }
+    result->status = CRUCIBLE_FAULT_STATUS_APPLIED;
+    result->applied_icount = result->observed_icount;
+}
+
+static QemuCrucibleFaultHandler crucible_memory_handler = {
+    .capability = {
+        .command_kind = CRUCIBLE_FAULT_COMMAND_MEMORY_MUTATION,
+        .scope = QEMU_PLUGIN_CRUCIBLE_FAULT_SCOPE_ALL,
+        .semantic_version = CRUCIBLE_FAULT_COMMAND_SEMANTIC_VERSION,
+        .phase_mask = 1U << (CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY - 1),
+        .maximum_payload_bytes = CRUCIBLE_FAULT_HARD_PAYLOAD_BYTES,
+        .maximum_pending_commands = CRUCIBLE_FAULT_DEFAULT_COMMAND_CAPACITY,
+        .required_feature_bits =
+            CRUCIBLE_FAULT_CAPABILITY_FEATURE_MEMORY_MUTATION,
+        .name = "qemu.memory.mutate.unregistered.v1",
+        .payload_schema = "crucible.memory-mutation-batch-payload.v1",
+    },
+    .validate = crucible_memory_validate,
+    .arm = crucible_memory_arm,
+    .prepare = crucible_memory_prepare,
+    .commit = crucible_memory_commit,
+    .free_state = crucible_memory_batch_free,
+};
+
+void qemu_crucible_fault_memory_register(uint16_t scope, const char *name)
+{
+    static bool registered;
+
+    g_assert(scope == QEMU_PLUGIN_CRUCIBLE_FAULT_SCOPE_X86_64 ||
+             scope == QEMU_PLUGIN_CRUCIBLE_FAULT_SCOPE_AARCH64);
+    g_assert(name);
+    if (registered) {
+        g_assert(crucible_memory_handler.capability.scope == scope);
+        g_assert(strcmp(crucible_memory_handler.capability.name, name) == 0);
+        return;
+    }
+    crucible_memory_handler.capability.scope = scope;
+    crucible_memory_handler.capability.name = name;
+    qemu_crucible_fault_register(&crucible_memory_handler);
+    registered = true;
+}
