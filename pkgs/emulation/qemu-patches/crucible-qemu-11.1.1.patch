+
+void rr_crucible_sim_trace_control_delivery(const char *phase,
+                                           uint64_t request_generation,
+                                           uint64_t ack_generation,
+                                           uint64_t complete_generation,
+                                           uintptr_t rr_schedule_token,
+                                           uintptr_t schedule_token,
+                                           bool deferred,
+                                           uintptr_t schedule_sequence)
+{
+    unsigned int index;
+    uint64_t previous_request;
+    uintptr_t previous_sequence;
+    bool emit;
+    pid_t pid;
+    char states[64];
+
+    if (!rr_crucible_sim_mode() ||
+        !trace_event_get_state_backends(TRACE_CRUCIBLE_SIM_RR_CONTROL_DELIVERY)) {
+        return;
+    }
+    pid = getpid();
+    if (qatomic_read(&rr_control_delivery_trace_pid) != pid) {
+        /* Native transition call sites hold BQL; a child owns a fresh cache. */
+        for (index = 0; index < ARRAY_SIZE(rr_control_delivery_trace_seen);
+             index++) {
+            qatomic_set(&rr_control_delivery_trace_seen[index].request_generation,
+                        0);
+            qatomic_set(&rr_control_delivery_trace_seen[index].schedule_sequence,
+                        0);
+            qatomic_set(&rr_control_delivery_trace_seen[index].emitted, false);
+        }
+        qatomic_set(&rr_control_delivery_trace_pid, pid);
+    }
+    for (index = 0; index < ARRAY_SIZE(rr_control_delivery_trace_phases); index++) {
+        if (strcmp(phase, rr_control_delivery_trace_phases[index]) == 0) {
+            break;
+        }
+    }
+    if (index == ARRAY_SIZE(rr_control_delivery_trace_phases)) {
+        return;
+    }
+
+    /*
+     * Diagnostic maxima suppress repeated scans without a lock or a global
+     * budget that could hide a later request. Independent atomic claims can
+     * emit bounded duplicates; they never authenticate native ownership.
+     */
+    emit = !qatomic_xchg(&rr_control_delivery_trace_seen[index].emitted, true);
+    previous_request = qatomic_read(
+        &rr_control_delivery_trace_seen[index].request_generation);
+    if (request_generation > previous_request &&
+        qatomic_cmpxchg(
+            &rr_control_delivery_trace_seen[index].request_generation,
+            previous_request, request_generation) == previous_request) {
+        emit = true;
+    }
+    previous_sequence = qatomic_read(
+        &rr_control_delivery_trace_seen[index].schedule_sequence);
+    if (schedule_sequence > previous_sequence &&
+        qatomic_cmpxchg(
+            &rr_control_delivery_trace_seen[index].schedule_sequence,
+            previous_sequence, schedule_sequence) == previous_sequence) {
+        emit = true;
+    }
+    if (emit) {
+        uint64_t owner = icount_crucible_rr_current_vcpu();
+        char row[512];
+        int length;
+        int saved_errno;
+
+        g_snprintf(states, sizeof(states), "state=%u runstate=%u",
+                   qatomic_read(&rr_tcg_exec_state), runstate_get());
+        trace_crucible_sim_rr_control_delivery(
+            phase, request_generation, ack_generation, complete_generation,
+            rr_schedule_token, schedule_token, deferred, states, owner, pid);
+
+        /* Mirror the same emitted diagnostic row; stream failures are advisory. */
+        saved_errno = errno;
+        length = g_snprintf(
+            row, sizeof(row),
+            "crucible_sim_rr_control_delivery phase=%s request=%" PRIu64
+            " ack=%" PRIu64 " complete=%" PRIu64 " rr_token=0x%" PRIxPTR
+            " token=0x%" PRIxPTR " deferred=%d %s owner=%" PRIu64
+            " pid=%" PRId64 "\n",
+            phase, request_generation, ack_generation, complete_generation,
+            rr_schedule_token, schedule_token, deferred, states, owner,
+            (int64_t)pid);
+        if (length > 0 && length < (int)sizeof(row)) {
+            (void)fwrite(row, length, 1, stderr);
+        }
+        errno = saved_errno;
+    }
+}
