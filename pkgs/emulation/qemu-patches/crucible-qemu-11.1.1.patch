new file mode 100644
index 0000000000000000000000000000000000000000..4f2f94357df898a2996bd7aa7ade03e415692cd2
--- /dev/null
+++ b/tests/unit/test-crucible-ram-mapping-journal.py
@@ -0,0 +1,381 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Run the real shared anonymous mmap body and exact physical journal controls.
+
+Syscall refusal injection returns a real negative before that syscall's effect;
+all successful mappings and returns use actual mmap/munmap. No RAMBlock owner,
+Source, initialized machine, byte payer or read permission is fabricated. The
+one deliberately failed unmap remains mapped until process exit: its retained
+journal is never retried or adopted. Production constructor/installation and
+getter-child joins are compiled separately, not issued by this component.
+"""
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import runpy
+import shlex
+import subprocess
+
+PREFIX = r'''
+/* The complete utility archive also contains the genuine adapter owner. */
+#define qemu_anon_ram_alloc_owned component_anon_ram_alloc_owned
+#include "qemu/osdep.h"
+#include "qemu/mmap-alloc.h"
+#include "qemu/rcu.h"
+#include "util/trace.h"
+#include <sys/wait.h>
+#include <sys/prctl.h>
+
+static bool fail_reserve, fail_activate, fail_trim, fail_unmap;
+static unsigned reserve_calls, activate_calls, unmap_calls;
+static bool fail_prefix, fail_suffix, fail_cleanup, cleanup_pending;
+static void *last_reservation, *last_activation;
+static size_t last_reservation_bytes, last_activation_bytes;
+
+static void *observed_mmap(void *address, size_t bytes, int prot, int flags,
+                           int fd, off_t offset)
+{
+    if (prot == PROT_NONE) {
+        reserve_calls++;
+        if (fail_reserve) {
+            errno = ENOMEM;
+            return MAP_FAILED;
+        }
+    } else {
+        activate_calls++;
+        if (fail_activate) {
+            errno = EIO;
+            return MAP_FAILED;
+        }
+    }
+    void *result = mmap(address, bytes, prot, flags, fd, offset);
+
+    if (result != MAP_FAILED) {
+        if (prot == PROT_NONE) {
+            last_reservation = result;
+            last_reservation_bytes = bytes;
+        } else {
+            last_activation = result;
+            last_activation_bytes = bytes;
+        }
+    }
+    return result;
+}
+
+static int observed_munmap(void *address, size_t bytes)
+{
+    unmap_calls++;
+    if (cleanup_pending && fail_cleanup) {
+        errno = EACCES;
+        return -1;
+    }
+    if ((fail_prefix && address == last_reservation &&
+         (uintptr_t)address < (uintptr_t)last_activation &&
+         bytes == (uintptr_t)last_activation - (uintptr_t)address) ||
+        (fail_suffix && address == last_activation + last_activation_bytes +
+         qemu_real_host_page_size())) {
+        cleanup_pending = true;
+        errno = EIO;
+        return -1;
+    }
+    if (fail_trim || fail_unmap) {
+        fail_trim = false;
+        errno = EIO;
+        return -1;
+    }
+    return munmap(address, bytes);
+}
+
+#define mmap observed_mmap
+#define munmap observed_munmap
+'''
+
+CHECKS = r'''
+#undef mmap
+#undef munmap
+
+/* Real ambient spacer mappings let the unchanged allocator obtain different
+ * kernel-selected alignment offsets. No successful syscall is substituted.
+ * If either actual trim branch cannot be reached in this fixed bound, fail. */
+static void check_failed_cleanup(bool suffix)
+{
+    const size_t page = qemu_real_host_page_size();
+    QemuRamMappingJournal journals[16] = { 0 };
+    void *spacers[16] = { 0 };
+    bool reached = false;
+    size_t count = 0;
+
+    for (; count < ARRAY_SIZE(journals); count++) {
+        QemuRamMappingJournal *journal = &journals[count];
+
+        cleanup_pending = false;
+        fail_prefix = !suffix;
+        fail_suffix = suffix;
+        fail_cleanup = true;
+        void *result = qemu_ram_mmap_owned(page, page * 8, journal);
+
+        fail_prefix = false;
+        fail_suffix = false;
+        fail_cleanup = false;
+        if (cleanup_pending) {
+            assert(result == MAP_FAILED && journal->first_status == -EIO);
+            assert(journal->unmap_attempted && !journal->unmap_returned);
+            assert(journal->unmap_status == -EACCES && !journal->complete);
+            if (suffix) {
+                assert(journal->suffix_attempted && !journal->suffix_returned);
+                assert(journal->reservation == last_activation);
+                assert(journal->reservation_bytes == last_reservation_bytes -
+                       ((uintptr_t)last_activation - (uintptr_t)last_reservation));
+                assert(!journal->prefix_attempted || journal->prefix_returned);
+            } else {
+                assert(journal->prefix_attempted && !journal->prefix_returned);
+                assert(journal->reservation == last_reservation);
+                assert(journal->reservation_bytes == last_reservation_bytes);
+                assert(!journal->suffix_attempted);
+            }
+            unsigned before = unmap_calls;
+            assert(qemu_ram_munmap_owned(journal) == -EACCES);
+            assert(unmap_calls == before && journal->first_status == -EIO);
+            reached = true;
+            break;
+        }
+        assert(result != MAP_FAILED && journal->complete);
+        assert(qemu_ram_munmap_owned(journal) == 0);
+        spacers[count] = mmap(NULL, page, PROT_READ | PROT_WRITE,
+                              MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+        assert(spacers[count] != MAP_FAILED);
+    }
+    for (size_t index = 0; index < ARRAY_SIZE(spacers); index++) {
+        if (spacers[index]) {
+            assert(munmap(spacers[index], page) == 0);
+        }
+    }
+    assert(reached);
+    printf("PASS actual failed %s cleanup retains exact range; no retry\n",
+           suffix ? "suffix" : "prefix");
+    /* The failed journal and its mapping must outlive the test. The child
+     * process below retains this real stack until process exit, never reuse. */
+    fflush(stdout);
+    _exit(0);
+}
+
+/* The linked utility/QOM runtime starts a real RCU worker before main.
+ * Wait for its actual callback path before inheriting process-private mutexes.
+ * This is ordinary component initialization, never a Source/fork authority. */
+static pid_t component_fork(void)
+{
+    QemuRcuHotForkInventory inventory;
+
+    drain_call_rcu();
+    qemu_rcu_hot_fork_inventory(&inventory);
+    assert(!inventory.overflowed && inventory.entry_count == 2);
+    assert(!inventory.pending_callbacks && !inventory.drain_active);
+    qemu_rcu_hot_fork_inventory_destroy(&inventory);
+    return fork();
+}
+
+int main(void)
+{
+    const size_t page = qemu_real_host_page_size();
+    QemuRamMappingJournal live = { 0 }, copied, invalid = { 0 };
+    QemuRamMappingJournal no_map = { 0 }, activation = { 0 }, trim = { 0 };
+    QemuRamMappingJournal negative = { 0 }, adapter = { 0 };
+    QemuRamMappingJournal occupied = { .bytes = 1 };
+    unsigned before;
+    uint64_t alignment = 0;
+    pid_t child;
+    int status;
+
+    /* Intentional assertion mutants must not start an external core writer. */
+    assert(prctl(PR_SET_DUMPABLE, 0) == 0);
+    assert(prctl(PR_GET_DUMPABLE) == 0);
+
+    /* Actual production wrapper and actual shared mmap implementation. */
+    uint8_t *bytes = qemu_anon_ram_alloc_owned(page, &alignment, &adapter);
+    assert(bytes && alignment == QEMU_VMALLOC_ALIGN);
+    assert(adapter.address == bytes && adapter.complete);
+    memset(bytes, 0x37, page);
+    assert(qemu_ram_munmap_owned(&adapter) == 0 && adapter.unmap_returned);
+
+    before = reserve_calls;
+    assert(qemu_ram_mmap_owned(page, page, &occupied) == MAP_FAILED);
+    assert(errno == EINVAL && occupied.bytes == 1 && reserve_calls == before);
+    assert(qemu_ram_mmap_owned(SIZE_MAX, page, &invalid) == MAP_FAILED);
+    assert(errno == EOVERFLOW && !invalid.canonical);
+    assert(reserve_calls == before);
+    assert(qemu_ram_mmap_owned(page + 1, page, &invalid) == MAP_FAILED);
+    assert(errno == EINVAL && reserve_calls == before);
+    assert(qemu_ram_mmap_owned(page, page + 1, &invalid) == MAP_FAILED);
+    assert(errno == EINVAL && reserve_calls == before);
+
+    bytes = qemu_ram_mmap_owned(page, page * 8, &live);
+    assert(bytes != MAP_FAILED && live.canonical == &live);
+    assert(live.reserve_attempted && live.reserve_returned);
+    assert(live.activate_attempted && live.activate_returned && live.complete);
+    assert(live.bytes == page && live.guard_bytes == page);
+    assert(live.reservation == bytes && live.reservation_bytes == page * 2);
+    assert(live.prefix_attempted == live.prefix_returned);
+    assert(live.suffix_attempted == live.suffix_returned);
+    assert(live.prefix_attempted || live.suffix_attempted);
+    memset(bytes, 0x59, page);
+    copied = live;
+    before = unmap_calls;
+    assert(qemu_ram_munmap_owned(&copied) == -EPERM);
+    assert(unmap_calls == before);
+    child = component_fork();
+    assert(child >= 0);
+    if (!child) {
+        _exit(qemu_ram_munmap_owned(&live) == -EPERM ? 0 : 1);
+    }
+    assert(waitpid(child, &status, 0) == child);
+    assert(WIFEXITED(status) && WEXITSTATUS(status) == 0);
+    assert(qemu_ram_mmap_owned(page, page, &live) == MAP_FAILED);
+    assert(qemu_ram_munmap_owned(&live) == 0 && live.unmap_returned);
+    assert(live.unmap_attempted && !live.first_status);
+    before = unmap_calls;
+    assert(qemu_ram_munmap_owned(&live) == 0 && unmap_calls == before);
+    assert(qemu_ram_mmap_owned(page, page, &live) == MAP_FAILED);
+
+    fail_reserve = true;
+    before = activate_calls;
+    assert(qemu_ram_mmap_owned(page, page, &no_map) == MAP_FAILED);
+    assert(no_map.reserve_attempted && !no_map.reserve_returned);
+    assert(no_map.first_status == -ENOMEM && !no_map.activate_attempted);
+    assert(activate_calls == before && !no_map.unmap_attempted);
+    fail_reserve = false;
+    assert(qemu_ram_munmap_owned(&no_map) == -ENOMEM);
+
+    fail_activate = true;
+    assert(qemu_ram_mmap_owned(page, page, &activation) == MAP_FAILED);
+    assert(activation.reserve_returned && activation.activate_attempted);
+    assert(!activation.activate_returned && !activation.complete);
+    assert(activation.unmap_attempted && activation.unmap_returned);
+    assert(activation.first_status == -EIO);
+    fail_activate = false;
+    before = unmap_calls;
+    assert(qemu_ram_munmap_owned(&activation) == 0 && unmap_calls == before);
+    assert(activation.first_status == -EIO);
+
+    for (unsigned suffix = 0; suffix < 2; suffix++) {
+        child = component_fork();
+        assert(child >= 0);
+        if (!child) {
+            check_failed_cleanup(suffix);
+        }
+        assert(waitpid(child, &status, 0) == child);
+        assert(WIFEXITED(status) && WEXITSTATUS(status) == 0);
+    }
+
+    fail_trim = true;
+    assert(qemu_ram_mmap_owned(page, page * 8, &trim) == MAP_FAILED);
+    assert(trim.activate_returned && !trim.complete && trim.first_status == -EIO);
+    assert((trim.prefix_attempted && !trim.prefix_returned) ||
+           (trim.suffix_attempted && !trim.suffix_returned));
+    assert(trim.unmap_attempted && trim.unmap_returned);
+
+    assert(qemu_ram_mmap_owned(page, page, &negative) != MAP_FAILED);
+    fail_unmap = true;
+    before = unmap_calls;
+    assert(qemu_ram_munmap_owned(&negative) == -EIO);
+    assert(negative.unmap_attempted && !negative.unmap_returned);
+    assert(negative.unmap_status == -EIO && negative.first_status == -EIO);
+    assert(unmap_calls == before + 1);
+    fail_unmap = false;
+    before = unmap_calls;
+    assert(qemu_ram_munmap_owned(&negative) == -EIO && unmap_calls == before);
+    assert(qemu_ram_mmap_owned(page, page, &negative) == MAP_FAILED);
+    assert(!negative.unmap_returned && negative.first_status == -EIO);
+    puts("PASS actual anonymous mapping, cleanup and retained failed return; no Source");
+    return 0;
+}
+'''
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--source-root", type=Path, default=Path(__file__).resolve().parents[2])
+    parser.add_argument("--output-dir", type=Path, required=True)
+    parser.add_argument("--qemu-util", type=Path, required=True)
+    parser.add_argument("--qom-object", type=Path, action="append", default=[])
+    args = parser.parse_args()
+    root, output = args.source_root.resolve(), args.output_dir.resolve()
+    output.mkdir(parents=True, exist_ok=True)
+    function = runpy.run_path(str(root / "tests/unit/extract-crucible-startup-source-controls.py"))["function"]
+    mapping = (root / "util/mmap-alloc.c").read_text()
+    adapter = function((root / "util/oslib-posix.c").read_text(), "void *qemu_anon_ram_alloc_owned(")
+    literal = PREFIX + mapping + adapter + CHECKS
+    defects = {
+        "prefix-retained-geometry": ("journal->first_status = -errno;", "journal->first_status = -errno; journal->reservation_bytes--;", "journal->reservation_bytes == last_reservation_bytes"),
+        "suffix-retained-geometry": ("journal->first_status = -errno;", "journal->first_status = -errno; journal->reservation_bytes--;", "journal->reservation_bytes == last_reservation_bytes -"),
+        "unused-storage": ("memcmp(journal, &unused, sizeof(*journal))", "false", "qemu_ram_mmap_owned(page, page, &occupied) == MAP_FAILED"),
+        "geometry": ("size > SIZE_MAX - align || size > SIZE_MAX - guard_pagesize", "false", "errno == EOVERFLOW"),
+        "reserve-attempt": ("journal->reserve_attempted = true;", "", "qemu_ram_munmap_owned(&adapter) == 0 && adapter.unmap_returned"),
+        "reserve-return": ("journal->reserve_returned = true;", "", "adapter.unmap_returned"),
+        "activate-attempt": ("journal->activate_attempted = true;", "", "live.activate_attempted && live.activate_returned"),
+        "activate-return": ("journal->activate_returned = true;", "", "live.activate_attempted && live.activate_returned && live.complete"),
+        "complete": ("journal->complete = true;", "", "adapter.address == bytes && adapter.complete"),
+        "trim-return": ("journal->prefix_returned = true;", "", "attempted == live."),
+        "canonical": ("journal->canonical != journal ||", "false ||", "qemu_ram_munmap_owned(&copied) == -EPERM"),
+        "process": ("journal->process != getpid()", "false", "WIFEXITED(status) && WEXITSTATUS(status) == 0"),
+        "unmap-attempt": ("journal->unmap_attempted = true;", "", "live.unmap_attempted && !live.first_status"),
+        "physical-unmap": ("status = munmap(journal->reservation, journal->reservation_bytes);", "status = 0;", "journal->unmap_attempted && !journal->unmap_returned"),
+        "unmap-return": ("journal->unmap_returned = status == 0;", "journal->unmap_returned = true;", "journal->unmap_attempted && !journal->unmap_returned"),
+        "no-retry": ("if (journal->unmap_attempted) {", "if (false) {", "qemu_ram_munmap_owned(&live) == 0 && unmap_calls == before"),
+        "first-cause": ("journal->first_status = -errno;", "journal->first_status = 0;", "no_map.first_status == -ENOMEM"),
+        "trim-cleanup": ("qemu_ram_munmap_owned(journal);", "", "activation.unmap_attempted && activation.unmap_returned"),
+    }
+    # The kernel may leave either trim empty. Remove both independent receipt
+    # writes together: the real geometry guarantees at least one is reached.
+    # This control does not claim that both syscall branches ran.
+    results = {}
+    for name in ["positive", *defects]:
+        body = literal
+        if name != "positive":
+            before, after, expected = defects[name]
+            if before not in mapping:
+                raise RuntimeError(f"{name}: absent production anchor")
+            if name in ("prefix-retained-geometry", "suffix-retained-geometry"):
+                branch = "prefix" if name.startswith("prefix") else "suffix"
+                start = mapping.index(f"journal->{branch}_attempted = true;")
+                end = mapping.index(f"journal->{branch}_returned = true;", start)
+                original = mapping[start:end]
+                assert original.count(before) == 1
+                changed = mapping[:start] + original.replace(before, after, 1) + mapping[end:]
+            else:
+                changed = mapping.replace(before, after)
+            if name == "trim-return":
+                changed = changed.replace("journal->suffix_returned = true;", "")
+            body = PREFIX + changed + adapter + CHECKS
+        generated, binary = output / f"{name}.c", output / name
+        generated.write_text(body)
+        command = [*shlex.split(os.environ["CC"]), *shlex.split(os.environ["CFLAGS"]),
+                   "-ffunction-sections", "-fdata-sections", str(generated), "-o", str(binary),
+                   "-Wl,--gc-sections", "-Wl,--start-group", str(args.qemu_util.resolve()),
+                   *[str(path.resolve()) for path in args.qom_object], "-Wl,--end-group",
+                   *shlex.split(os.environ.get("LDFLAGS", ""))]
+        (output / f"{name}.command.json").write_text(json.dumps(command, indent=2) + "\n")
+        compiled = subprocess.run(command, capture_output=True, text=True)
+        (output / f"{name}.compile.log").write_text(compiled.stdout + compiled.stderr)
+        if compiled.returncode:
+            raise RuntimeError(f"{name} compile failed: {compiled.stderr}")
+        result = subprocess.run([str(binary)], cwd=output, capture_output=True, text=True, timeout=30)
+        (output / f"{name}.run.log").write_text(result.stdout + result.stderr)
+        if name == "positive":
+            assert result.returncode == 0, result.stderr
+        elif result.returncode != -6 or "Assertion" not in result.stderr or expected not in result.stderr:
+            raise RuntimeError(f"{name} missed intended assertion: {result.returncode}\n{result.stderr}")
+        results[name] = {"returncode": result.returncode, "stdout": result.stdout, "stderr": result.stderr}
+    (output / "results.json").write_text(json.dumps(results, indent=2) + "\n")
+    (output / "utility.json").write_text(json.dumps({
+        "path": str(args.qemu_util.resolve()),
+        "sha256": hashlib.sha256(args.qemu_util.read_bytes()).hexdigest(),
+        "qom_objects": {str(path.resolve()): hashlib.sha256(path.read_bytes()).hexdigest()
+                        for path in args.qom_object},
+    }, indent=2) + "\n")
