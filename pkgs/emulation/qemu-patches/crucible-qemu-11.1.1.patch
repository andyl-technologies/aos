+/* Exact canonical entered field, including its real suppression receipt. No
+ * callback is invoked here and the outer Main-top predicate is not reused. */
+int qemu_crucible_source_advance_callback_frame_current_v1(
+    QemuCrucibleNativeInvocationTicket *main,
+    QemuCrucibleNativeInvocationTicket *control,
+    QemuCrucibleNativeInvocationTicket *mask)
+{
+#if defined(CONFIG_LINUX) && defined(__x86_64__) && !defined(__ILP32__)
+    QemuCrucibleSourceAdvanceReceiver *receiver = &startup_source.advance_receiver;
+    QemuCrucibleAdvanceCallbackFrame *frame = &receiver->callback;
+    int status = advance_receiver_identity(receiver);
+
+    if (status) {
+        return status;
+    }
+    if (main != receiver->main || control != receiver->control ||
+        mask != &frame->mask || frame->receiver != receiver ||
+        !frame->entered || frame->returned ||
+        frame->kind <= QEMU_CRUCIBLE_ADVANCE_CALLBACK_NONE ||
+        frame->kind > QEMU_CRUCIBLE_ADVANCE_CALLBACK_PENDING_RETURNED_CURRENT ||
+        !frame->serial || frame->serial == UINT64_MAX ||
+        frame->serial != receiver->next_callback_serial || receiver->main_returned ||
+        !receiver->recipient) {
+        return -EPERM;
+    }
+    status = qemu_plugin_crucible_source_advance_native_holder_current_v1(main, control);
+    if (!status) {
+        status = qemu_crucible_preexec_publisher_recipient_identity_v1(
+            receiver->lender, receiver->recipient, receiver);
+    }
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
