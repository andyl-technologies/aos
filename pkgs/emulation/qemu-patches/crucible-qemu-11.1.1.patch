+int qemu_crucible_ram_fingerprint_retirement_phase_current_v1(
+    qemu_plugin_id_t id, qemu_plugin_crucible_fingerprint_retirement_v1 *loan,
+    qemu_plugin_crucible_fingerprint_operation_v1 **operation, uint32_t *phase)
+{
+    int status;
