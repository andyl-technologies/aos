@@ -0,0 +1,638 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Exercise production RR FIFO barriers and ordinary CPU event processing.
+
+The wrapper, global drain, wait path, common events, FIFO implementation,
+accelerator getter, plugin pending predicates, pause/resume and kick bodies are
+extracted from this source tree. GLib mutexes and QEMU queue/atomic macros are
+real. CPU topology, BQL/exclusive arbitration, host wake scheduling, plugin halt
+callbacks and timers are bounded providers. This proves local ordering and
+progress under those providers, not running guests, migration streams, a full
+QEMU process, concurrent producers or latency. No Git metadata or generated
+protocol header is required; the default works in a source archive.
+"""
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import shlex
+import subprocess
+
+
+ROOT = Path(__file__).resolve().parents[2]
+RR = "accel/tcg/tcg-accel-ops-rr.c"
+NEGATIVES = ["wrong-mode", "skipped-common", "missing-pre-drain",
+             "missing-fixed-point", "missing-owner-restoration"]
+BASELINE_COMMIT = "f9a79a88ac52a502fd174c263a8a749debc4dbdd"
+BASELINE_HASHES = {
+    "rr_crucible_sim_process_vcpu_events":
+        "379ac45f75c582ae5232b4b629350dd439f1fa8c4df45eeddb7f7e7fdff65f05",
+    "rr_crucible_sim_drain_vcpu_work":
+        "332b54edf243f49abfabdca79f32d96bf98b6c82ac0e8e7c85cb059574c88387",
+}
+
+
+def definition(source, signature):
+    """Extract one complete function without changing its body."""
+    start = source.index(signature)
+    opening = source.index("{", start)
+    depth = 0
+    for index in range(opening, len(source)):
+        if source[index] == "{":
+            depth += 1
+        elif source[index] == "}":
+            depth -= 1
+            if depth == 0:
+                return source[start:index + 1]
+    raise AssertionError(f"unterminated definition: {signature}")
+
+
+# Captured production wrappers before the mode guards; no history dependency.
+BASELINE = r"""
+static void old_process_vcpu_events(CPUState *cpu)
+{
+    CPUState *saved_cpu = current_cpu;
+
+    /* Exclusive work must name its FIFO owner, even on the shared RR thread. */
+    current_cpu = cpu;
+    /* Finish invalidation before stop acknowledgment permits capture or fork. */
+    process_queued_cpu_work(cpu);
+    qemu_process_cpu_events_common(cpu);
+    current_cpu = saved_cpu;
+}
+
+static void old_drain_vcpu_work(void)
+{
+    CPUState *saved_cpu = current_cpu;
+    CPUState *cpu;
+
+    /* A sibling's global flush must finish before any vCPU acknowledges stop. */
+    do {
+        CPU_FOREACH(cpu) {
+            current_cpu = cpu;
+            process_queued_cpu_work(cpu);
+        }
+    } while (rr_crucible_sim_vcpu_work_pending());
+    current_cpu = saved_cpu;
+
+    CPU_FOREACH(cpu) {
+        old_process_vcpu_events(cpu);
+    }
+}
+"""
+
+PRELUDE = r"""
+#include "qemu/osdep.h"
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <glib.h>
+#include "qemu/atomic.h"
+#include "qemu/queue.h"
+#include "qom/object.h"
+
+#define ICOUNT_PRECISE 1
+#define QEMU_CLOCK_VIRTUAL 1
+#define QEMU_PLUGIN_TIME_ADVANCE_ARMED 2
+#define QEMU_PLUGIN_CRUCIBLE_VMSTOP_IDLE 0
+#define RR_TCG_EXEC_IDLE 0
+#define CPU_FOREACH(cpu) for ((cpu) = first_cpu; (cpu); (cpu) = (cpu)->next)
+
+typedef GMutex FixtureMutex;
+typedef struct { int kind; } QemuCond;
+typedef struct CPUState CPUState;
+typedef union { unsigned long host_ulong; } run_on_cpu_data;
+typedef void (*run_on_cpu_func)(CPUState *, run_on_cpu_data);
+@WORK_ITEM@
+
+struct CPUState {
+    CPUState *next;
+    int cpu_index, exception_index;
+    bool stop, stopped, unplug, halted, thread_kicked, exit_request;
+    FixtureMutex work_mutex;
+    QemuCond *halt_cond;
+    QSIMPLEQ_HEAD(, qemu_work_item) work_list;
+};
+
+struct AccelState { bool is_sim; };
+struct MachineState { AccelState *accelerator; };
+struct AccelOpsClass { void (*kick_vcpu_thread)(CPUState *); };
+typedef enum {
+    QEMU_PLUGIN_CRUCIBLE_IDLE_CALLBACK_COMPLETE,
+    QEMU_PLUGIN_CRUCIBLE_IDLE_CALLBACK_RESCAN
+} QemuPluginCrucibleIdleCallbackDisposition;
