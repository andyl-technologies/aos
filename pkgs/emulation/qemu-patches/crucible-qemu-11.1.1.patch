+            .source_id = id,
+            .process = getpid(),
+        };
+        qemu_thread_get_self(&observation_writer.thread);
+        if (current_cpu && qatomic_read(&current_cpu->running)) {
+            status = cpu_boundary_current_locked(
+                current_cpu, cpu_boundary.generation);
