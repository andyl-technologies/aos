+    elif arguments.negative_control == "native":
+        refresh = "    crucible_mutex_owner_cache_refresh(child_thread_id);\n"
+        assert bodies.count(refresh) == 1
+        bodies = bodies.replace(refresh, "")
+    rcu_child = definition((ROOT / "util/rcu.c").read_text(),
+                           "static void rcu_init_child(void)")
+    error_exit = definition(source, "static void error_exit(")
+    generated = arguments.output_dir / "mutex-owner-cache.c"
+    generated.write_text(PRELUDE + error_exit + "\n" + mutex_globals + thread_globals +
+                         carriers + bodies + CHECKS + rcu_child + MAIN)
+    binary = arguments.output_dir / "mutex-owner-cache"
+    command = [os.environ.get("CC", "cc"),
