+CrucibleCheckpointTopology *qmp_crucible_checkpoint_prepare_topology(
+    const char *root_fdname, const char *cancellation_fdname,
+    const char *checkpoint_sha256, const char *target_sha256,
+    const char *frontier_sha256, Error **errp)
+{
+#ifdef CONFIG_PLUGIN
+    QemuCrucibleCheckpointInventoryLoan *inventory = NULL;
+    CrucibleCheckpointTopology *report = NULL;
+    int root_fd = -1;
+    int cancellation_fd = -1;
+    int semantic_status = 0;
+    int status;
+
+    status = qemu_crucible_checkpoint_inventory_prepare_current_v1(monitor_cur());
+    if (status) {
+        error_setg_errno(errp, -status,
+                         "Checkpoint topology has no ready receiving request");
+        return NULL;
+    }
+    status = qemu_crucible_checkpoint_inventory_begin_v1(monitor_cur(), &inventory);
+    if (status) {
+        goto out;
+    }
+
+    root_fd = monitor_get_fd(monitor_cur(), root_fdname, errp);
+    if (root_fd < 0) {
+        status = -EBADF;
+        goto out;
+    }
+    status = qemu_crucible_checkpoint_inventory_output_adopt_v1(inventory,
+                                                               &root_fd);
+    if (status) {
+        goto out;
+    }
+    cancellation_fd = monitor_get_fd(monitor_cur(), cancellation_fdname, errp);
+    if (cancellation_fd < 0) {
+        status = -EBADF;
+        goto out;
+    }
+    status = qemu_crucible_checkpoint_inventory_cancellation_adopt_v1(
+        inventory, &cancellation_fd);
+    if (status) {
+        goto out;
+    }
+
+    report = qemu_crucible_checkpoint_prepare_topology(
+        &inventory, checkpoint_sha256, target_sha256, frontier_sha256,
+        &semantic_status, errp);
+    status = semantic_status;
+out:
+    /* Adopt updates each local slot before its fallible identity observation.
+     * Only aliases that never moved to the inventory remain ours to close. */
+    if (root_fd >= 0 && close(root_fd) < 0 && !status) {
+        status = -errno;
+    }
+    if (cancellation_fd >= 0 && close(cancellation_fd) < 0 && !status) {
+        status = -errno;
+    }
+    if (inventory) {
+        int returned = qemu_crucible_checkpoint_inventory_output_close_v1(inventory);
+        int post;
+
+        if (!status) {
+            status = returned;
+        }
+        post = qemu_crucible_checkpoint_inventory_post_v1(inventory, status);
+        returned = qemu_crucible_checkpoint_inventory_end_v1(&inventory, status);
+        if (!status) {
+            status = post ? post : returned;
+        }
+    }
+    if (status && !*errp) {
+        error_setg_errno(errp, -status,
+                         "Checkpoint topology inventory did not complete");
+    }
+    return report;
+#else
+    error_setg(errp, "Checkpoint topology requires plugin receiving support");
+    return NULL;
+#endif
+}
+
+static bool crucible_checkpoint_decode_arm_digest(
+    const char *text, uint8_t digest[32], Error **errp)
+{
+    uint8_t decoded[32];
+
+    if (strlen(text) != 64) {
+        error_setg(errp, "Checkpoint ARM digest must have 64 lowercase hex digits");
+        return false;
+    }
+    for (size_t index = 0; index < sizeof(decoded); index++) {
+        unsigned byte = 0;
+
+        for (unsigned digit = 0; digit < 2; digit++) {
+            unsigned char value = text[2 * index + digit];
+            if (value >= '0' && value <= '9') {
+                value -= '0';
+            } else if (value >= 'a' && value <= 'f') {
+                value = value - 'a' + 10;
+            } else {
+                error_setg(errp, "Checkpoint ARM digest is not canonical hex");
+                return false;
+            }
+            byte = 16 * byte + value;
+        }
+        decoded[index] = byte;
+    }
+    memcpy(digest, decoded, sizeof(decoded));
+    return true;
+}
+
+CrucibleCheckpointBegin *qmp_crucible_checkpoint_begin(
+    const char *arm_request_digest, uint64_t request_generation, Error **errp)
+{
+    uint8_t digest[32];
+    uint64_t epoch;
+    CrucibleCheckpointBegin *result;
+    int status = -ENOTSUP;
+
+    if (!crucible_checkpoint_decode_arm_digest(arm_request_digest, digest, errp)) {
+        return NULL;
+    }
+#ifdef CONFIG_PLUGIN
+    status = qemu_crucible_checkpoint_begin_main_v1(digest, request_generation,
+                                                  &epoch);
+#endif
+    if (status) {
+        error_setg_errno(errp, -status, "Checkpoint Main handoff is incomplete");
+        return NULL;
+    }
+    result = g_new0(CrucibleCheckpointBegin, 1);
+    result->arm_request_digest = g_strdup(arm_request_digest);
+    result->request_generation = request_generation;
+    result->connection_epoch = epoch;
+    return result;
+}
+
+CrucibleCheckpointBegin *qmp_crucible_checkpoint_end(
+    const char *arm_request_digest, uint64_t request_generation, Error **errp)
+{
+    uint8_t digest[32];
+    uint64_t epoch;
+    CrucibleCheckpointBegin *result;
+    int status = -ENOTSUP;
+
+    if (!crucible_checkpoint_decode_arm_digest(arm_request_digest, digest, errp)) {
+        return NULL;
+    }
+#ifdef CONFIG_PLUGIN
+    status = qemu_crucible_checkpoint_end_main_v1(digest, request_generation,
+                                                &epoch);
+#endif
+    if (status) {
+        error_setg_errno(errp, -status, "Checkpoint Main end is incomplete");
+        return NULL;
+    }
+    result = g_new0(CrucibleCheckpointBegin, 1);
+    result->arm_request_digest = g_strdup(arm_request_digest);
+    result->request_generation = request_generation;
+    result->connection_epoch = epoch;
+    return result;
+}
+
+CrucibleCheckpointCapture *qmp_crucible_checkpoint_capture(
+    bool initial_required,
+    uint64_t topology_admission_generation,
+    const char *ram_fdname,
+    const char *device_fdname,
+    const char *cancellation_fdname,
+    const char *checkpoint_sha256,
+    const char *target_sha256,
+    const char *frontier_sha256,
+    const char *parent_checkpoint_sha256,
+    const char *parent_target_sha256,
+    const char *parent_frontier_sha256,
+    uint64_t maximum_ram_bytes,
+    uint64_t maximum_device_bytes,
+    Error **errp)
+{
+    CrucibleCheckpointCapture *report;
+    int ram_fd;
+    int device_fd;
+    int cancellation_fd;
+    int request_status;
+    int aliases[3];
+
+#ifdef CONFIG_PLUGIN
+    request_status = qemu_crucible_checkpoint_capture_alias_begin_v1(monitor_cur());
+#else
+    request_status = -ENOTSUP;
+#endif
+    if (request_status) {
+        error_setg_errno(errp, -request_status,
+                         "Checkpoint capture has no ready receiving request");
+        return NULL;
+    }
+#ifdef CONFIG_PLUGIN
+    request_status = qemu_crucible_checkpoint_capture_alias_acquire_v1(
+        0, ram_fdname, errp);
+    if (!request_status) {
+        request_status = qemu_crucible_checkpoint_capture_alias_acquire_v1(
+            1, device_fdname, errp);
+    }
+    if (!request_status) {
+        request_status = qemu_crucible_checkpoint_capture_alias_acquire_v1(
+            2, cancellation_fdname, errp);
+    }
+    if (!request_status) {
+        request_status = qemu_crucible_checkpoint_capture_alias_move_v1(aliases);
+    }
+    if (request_status) {
+        if (!*errp) {
+            error_setg_errno(errp, -request_status,
+                             "Checkpoint capture alias transfer failed");
+        }
+        return NULL;
+    }
+    ram_fd = aliases[0];
+    device_fd = aliases[1];
+    cancellation_fd = aliases[2];
+#else
+    return NULL;
+#endif
+
+    report = qemu_crucible_checkpoint_capture(
+        initial_required, topology_admission_generation,
+        ram_fd, device_fd, cancellation_fd, checkpoint_sha256,
+        target_sha256, frontier_sha256, parent_checkpoint_sha256 != NULL,
+        parent_checkpoint_sha256, parent_target_sha256 != NULL,
+        parent_target_sha256, parent_frontier_sha256 != NULL,
+        parent_frontier_sha256, maximum_ram_bytes, maximum_device_bytes, errp);
+    /* Capture now owns all three exact aliases in every outcome. The Root's
+     * original event alias is a distinct native owner, never donated here.
+     */
+    return report;
+}
