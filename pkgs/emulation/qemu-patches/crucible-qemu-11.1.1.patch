+/*
+ * Allocation-free helpers for factual register descriptions
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef HW_CORE_CRUCIBLE_REGISTER_HELPERS_H
+#define HW_CORE_CRUCIBLE_REGISTER_HELPERS_H
+
+#include "hw/core/cpu.h"
+
+/* A NULL destination measures exact geometry without constructing payload. */
+typedef struct CrucibleRegisterNameBuilder {
+    char *destination;
+    size_t capacity;
+    size_t length;
+    bool failed;
+} CrucibleRegisterNameBuilder;
+
+static inline void crucible_register_name_append(
+    CrucibleRegisterNameBuilder *builder, const char *text, size_t length)
+{
+    if (builder->failed || length >= SIZE_MAX - builder->length ||
+        (builder->destination &&
+         builder->length + length >= builder->capacity)) {
+        builder->failed = true;
+        return;
+    }
+    if (builder->destination) {
+        memcpy(builder->destination + builder->length, text, length);
+        builder->destination[builder->length + length] = 0;
+    }
+    builder->length += length;
+}
+
+static inline void crucible_register_name_text(
+    CrucibleRegisterNameBuilder *builder, const char *text)
+{
+    crucible_register_name_append(builder, text, strlen(text));
+}
+
+static inline void crucible_register_name_decimal(
+    CrucibleRegisterNameBuilder *builder, uint32_t value)
+{
+    char digits[10];
+    size_t offset = sizeof(digits);
+
+    do {
+        digits[--offset] = '0' + value % 10;
+        value /= 10;
+    } while (value);
+    crucible_register_name_append(builder, digits + offset,
+                                  sizeof(digits) - offset);
+}
+
+static inline void crucible_register_name_hex_key(
+    CrucibleRegisterNameBuilder *builder, uint32_t value)
+{
+    static const char digits[] = "0123456789abcdef";
+    char encoded[8];
+
+    for (size_t index = 0; index < sizeof(encoded); index++) {
+        encoded[index] = digits[(value >> (28 - 4 * index)) & 15];
+    }
+    crucible_register_name_append(builder, encoded, sizeof(encoded));
+}
+
+static inline bool crucible_register_geometry_add(
+    CrucibleCPURegisterGeometry *geometry, size_t name_bytes,
+    uint32_t width_bits)
+{
+    size_t mask_bytes = ((uint64_t)width_bits + 7) / 8;
+
+    if (!name_bytes || !width_bits || geometry->register_count == SIZE_MAX ||
+        name_bytes > SIZE_MAX - geometry->name_bytes ||
+        mask_bytes > SIZE_MAX - geometry->mask_bytes) {
+        return false;
+    }
+    geometry->register_count++;
+    geometry->name_bytes += name_bytes;
+    geometry->mask_bytes += mask_bytes;
+    geometry->max_name_bytes = MAX(geometry->max_name_bytes, name_bytes);
+    geometry->max_mask_bytes = MAX(geometry->max_mask_bytes, mask_bytes);
+    return true;
+}
+
+static inline bool crucible_register_geometry_equal(
+    const CrucibleCPURegisterGeometry *left,
+    const CrucibleCPURegisterGeometry *right)
+{
+    return left && right && left->cpu == right->cpu &&
+        left->register_count == right->register_count &&
+        left->key_count == right->key_count &&
+        left->name_bytes == right->name_bytes &&
+        left->mask_bytes == right->mask_bytes &&
+        left->max_name_bytes == right->max_name_bytes &&
+        left->max_mask_bytes == right->max_mask_bytes;
+}
+
+static inline bool crucible_register_buffers_fit(
+    const CrucibleCPURegisterBuffers *buffers, size_t name_bytes,
+    size_t mask_bytes)
+{
+    return buffers && buffers->name && buffers->name_capacity >= name_bytes &&
+        buffers->writable_mask && buffers->reserved_mask &&
+        buffers->ignored_mask && buffers->read_only_mask &&
+        buffers->mask_capacity >= mask_bytes;
+}
+
+/* Checked address spans are only storage facts, never object identity. */
+static inline bool crucible_register_spans_disjoint(
+    const void *left, size_t left_bytes, const void *right, size_t right_bytes)
+{
+    uintptr_t first = (uintptr_t)left;
+    uintptr_t second = (uintptr_t)right;
+
+    if ((left_bytes && !left) || (right_bytes && !right) ||
+        left_bytes > UINTPTR_MAX - first ||
+        right_bytes > UINTPTR_MAX - second) {
+        return false;
+    }
+    return !left_bytes || !right_bytes || first + left_bytes <= second ||
+        second + right_bytes <= first;
+}
+
+static inline bool crucible_register_output_spans(
+    const CrucibleCPURegisterBuffers *buffers, size_t name_bytes,
+    size_t mask_bytes, const CrucibleCPURegisterGeometry *geometry,
+    const CrucibleCPURegisterKeyView *keys,
+    CrucibleCPURegisterCapability *out)
+{
+    const void *writes[] = { buffers->name, buffers->writable_mask,
+        buffers->reserved_mask, buffers->ignored_mask, buffers->read_only_mask,
+        out };
+    size_t lengths[] = { name_bytes, mask_bytes, mask_bytes, mask_bytes,
+        mask_bytes, sizeof(*out) };
+    const void *reads[] = { buffers, geometry, keys, keys->keys };
+    size_t read_lengths[] = {
+        sizeof(*buffers), sizeof(*geometry), sizeof(*keys), 0,
+    };
+
+    if (keys->count > SIZE_MAX / sizeof(*keys->keys)) {
+        return false;
+    }
+    read_lengths[3] = keys->count * sizeof(*keys->keys);
+    for (size_t index = 0; index < G_N_ELEMENTS(writes); index++) {
+        for (size_t other = index + 1; other < G_N_ELEMENTS(writes); other++) {
+            if (!crucible_register_spans_disjoint(
+                    writes[index], lengths[index],
+                    writes[other], lengths[other])) {
+                return false;
+            }
+        }
+        for (size_t other = 0; other < G_N_ELEMENTS(reads); other++) {
+            if (!crucible_register_spans_disjoint(
+                    writes[index], lengths[index],
+                    reads[other], read_lengths[other])) {
+                return false;
+            }
+        }
+    }
+    return true;
+}
+
+static inline bool crucible_register_value_spans(
+    const void *value, size_t value_bytes,
+    const CrucibleCPURegisterGeometry *geometry,
+    const CrucibleCPURegisterKeyView *keys, uint32_t *effects,
+    const void *cpu, size_t cpu_bytes)
+{
+    const void *inputs[] = { geometry, keys, NULL, cpu };
+    size_t lengths[] = { sizeof(*geometry), sizeof(*keys), 0, cpu_bytes };
+
+    if (!geometry || !keys || !value || !value_bytes || !cpu || !cpu_bytes ||
+        (uintptr_t)geometry % _Alignof(CrucibleCPURegisterGeometry) ||
+        (uintptr_t)keys % _Alignof(CrucibleCPURegisterKeyView) ||
+        keys->count > SIZE_MAX / sizeof(*keys->keys) ||
+        (keys->count && (uintptr_t)keys->keys % _Alignof(uint32_t)) ||
+        (effects && (uintptr_t)effects % _Alignof(uint32_t))) {
+        return false;
+    }
+    inputs[2] = keys->keys;
+    lengths[2] = keys->count * sizeof(*keys->keys);
+    for (size_t index = 0; index < G_N_ELEMENTS(inputs); index++) {
+        if ((index < G_N_ELEMENTS(inputs) - 1 &&
+             !crucible_register_spans_disjoint(
+                 cpu, cpu_bytes, inputs[index], lengths[index])) ||
+            !crucible_register_spans_disjoint(
+                value, value_bytes, inputs[index], lengths[index]) ||
+            (effects && !crucible_register_spans_disjoint(
+                effects, sizeof(*effects), inputs[index], lengths[index]))) {
+            return false;
+        }
+    }
+    return !effects || crucible_register_spans_disjoint(
+        value, value_bytes, effects, sizeof(*effects));
+}
+
+static inline void crucible_register_key_sift(
+    uint32_t *keys, size_t root, size_t length)
+{
+    while (root < length / 2) {
+        size_t child = root * 2 + 1;
+        uint32_t saved;
+
+        if (child + 1 < length && keys[child] < keys[child + 1]) {
+            child++;
+        }
+        if (keys[root] >= keys[child]) {
+            return;
+        }
+        saved = keys[root];
+        keys[root] = keys[child];
+        keys[child] = saved;
+        root = child;
+    }
+}
+
+/* libc and GLib sorting may allocate scratch storage. This heap sort uses
+ * only the caller-prepaid key span, with no stack proportional to the cohort. */
+static inline void crucible_register_keys_sort(uint32_t *keys, size_t count)
+{
+    for (size_t start = count / 2; start; start--) {
+        crucible_register_key_sift(keys, start - 1, count);
+    }
+    for (size_t end = count; end > 1; end--) {
+        uint32_t saved = keys[0];
+
+        keys[0] = keys[end - 1];
+        keys[end - 1] = saved;
+        crucible_register_key_sift(keys, 0, end - 1);
+    }
+}
+
+#endif
