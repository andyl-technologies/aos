+ROOT = Path(__file__).resolve().parents[2]
+definition = runpy.run_path(str(Path(__file__).with_name(
+    "test-crucible-net-output-stop.py")))["definition"]
+
+
+# Captured byte-for-byte from the signed baseline; usable without Git history.
+BASELINE_COMMIT = 'ee97d5506f9e2c38614fbdec732ea58dad89b0a4'
+BASELINE_HASHES = {
+    "static void node_rules_ensure(void)\n{": "46258101abb7f50bb9f30af2930464eb57fc532d5e8f821e48b1e8ea5dea6dda",
+    "void qemu_crucible_fault_rule_foreach(": "b9475e3e3d77ac079d6ae22859dfa37e9ea5f76403930275be1c9ac90cc23a9f",
+    "static void crucible_register_active_visit(": "fc593fb044f5ab4ecc4d3932a89913b3a6da09baa3c64e262648b0e81d2f6b92",
+    "bool qemu_crucible_fault_register_rules_active(": "62f1e672c0544f84b8f0a3c29b23f7cd8b686c00744d733c68c180a66cd7c3d5",
+    "bool qemu_crucible_fault_register_boundaries_active(": "715cf483cc4caab05f3c40cd57fde1796de7eed1556cb7ac9e02d5329132553d"
+}
+BASELINE_BODIES = r"""
+static void node_rules_ensure(void)
+{
+    if (!crucible_node_rules) {
+        crucible_node_rules = g_ptr_array_new_with_free_func(
+            (GDestroyNotify)node_rule_unref);
+    }
+}
+
+void qemu_crucible_fault_rule_foreach(uint16_t command_kind,
+                                      QemuCrucibleFaultRuleVisitFn visit,
+                                      void *opaque)
+{
+    node_rules_ensure();
+    for (guint i = 0; i < crucible_node_rules->len; i++) {
+        QemuCrucibleFaultRule *rule = g_ptr_array_index(crucible_node_rules, i);
+        if (rule->command_kind == command_kind) {
+            visit(rule, opaque);
+        }
+    }
+}
+
+static void crucible_register_active_visit(
+    const QemuCrucibleFaultRule *rule, void *opaque)
+{
+    (void)rule;
+    *(bool *)opaque = true;
+}
+
+bool qemu_crucible_fault_register_rules_active(void)
+{
+    bool active = false;
+
+    qemu_crucible_fault_rule_foreach(
+        CRUCIBLE_FAULT_COMMAND_CPU_REGISTER_TRANSFORM,
+        crucible_register_active_visit, &active);
+    return active;
+}
+
+bool qemu_crucible_fault_register_boundaries_active(void)
+{
+    return qemu_crucible_fault_register_rules_active() ||
+        qemu_crucible_fault_instruction_context_active() ||
+        qemu_crucible_fault_next_icount(
+            CRUCIBLE_FAULT_PHASE_BEFORE_INSTRUCTION) != UINT64_MAX ||
+        qemu_crucible_fault_next_icount(
+            CRUCIBLE_FAULT_PHASE_AFTER_INSTRUCTION) != UINT64_MAX;
+}
+"""
+
+PRELUDE = r"""
+#include "qemu/osdep.h"
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/wait.h>
+#include <unistd.h>
+#include <glib.h>
+
+typedef struct QObject QObject;
+typedef struct CrucibleMemoryServiceLedger CrucibleMemoryServiceLedger;
+typedef struct QemuCrucibleFaultRule QemuCrucibleFaultRule;
+typedef void (*QemuCrucibleFaultRuleVisitFn)(
+    const QemuCrucibleFaultRule *rule, void *opaque);
+"""
+
+# This query fixture owns a model vector, not a production storage registry.
+# Keep the actual operation predicates and recursive lock around the query;
+# the explicitly unselected boundary grants no production lifetime custody.
+OPERATION_ADAPTER = r"""
+#include "qemu/atomic.h"
+static struct {
+    GRecMutex operations;
+    pid_t process;
+} crucible_node_storage;
+
+static bool qemu_plugin_crucible_startup_source_retained(void)
+{
+    return false;
+}
+"""
+
+PROVIDERS = r"""
+static GPtrArray *crucible_node_rules;
+static unsigned int destroyed;
+static bool context_active;
+static uint64_t before_deadline = UINT64_MAX, after_deadline = UINT64_MAX;
+static unsigned int conditions[3], condition_count;
+
+static void node_rule_unref(QemuCrucibleFaultRule *rule)
+{
+    destroyed++;
+    g_free(rule);
+}
+
+bool qemu_crucible_fault_instruction_context_active(void)
+{
+    g_assert_cmpuint(condition_count, <, G_N_ELEMENTS(conditions));
+    conditions[condition_count++] = 1;
+    return context_active;
+}
+
+uint64_t qemu_crucible_fault_next_icount(uint16_t phase)
+{
+    g_assert_cmpuint(condition_count, <, G_N_ELEMENTS(conditions));
+    g_assert_true(phase == CRUCIBLE_FAULT_PHASE_BEFORE_INSTRUCTION ||
+                  phase == CRUCIBLE_FAULT_PHASE_AFTER_INSTRUCTION);
+    conditions[condition_count++] = phase;
+    return phase == CRUCIBLE_FAULT_PHASE_BEFORE_INSTRUCTION ?
+        before_deadline : after_deadline;
+}
+
+typedef struct KindRead {
+    const QemuCrucibleFaultRule *rule;
+    uint16_t kind;
+} KindRead;
+
+static KindRead reads[32];
+static unsigned int read_count;
+
+static uint16_t fixture_command_kind(const QemuCrucibleFaultRule *rule)
+{
+    g_assert_cmpuint(read_count, <, G_N_ELEMENTS(reads));
+    reads[read_count++] = (KindRead){rule, rule->command_kind};
+    return rule->command_kind;
+}
+"""
+
+CHECKS = r"""
+static void clear_rules(void)
+{
+    g_clear_pointer(&crucible_node_rules, g_ptr_array_unref);
+}
+
+static QemuCrucibleFaultRule *new_rule(uint16_t kind)
+{
+    QemuCrucibleFaultRule *rule = g_new0(QemuCrucibleFaultRule, 1);
+
+    rule->command_kind = kind;
+    return rule;
+}
+
+static void set_rules(const uint16_t *kinds, guint length)
+{
+    clear_rules();
+    node_rules_ensure();
+    for (guint i = 0; i < length; i++) {
+        g_ptr_array_add(crucible_node_rules, new_rule(kinds[i]));
+    }
+}
+
+static void assert_complete_reads(void)
+{
+    g_assert_nonnull(crucible_node_rules);
+    g_assert_cmpuint(read_count, ==, crucible_node_rules->len);
+    for (guint i = 0; i < read_count; i++) {
+        const QemuCrucibleFaultRule *rule =
+            g_ptr_array_index(crucible_node_rules, i);
+
+        g_assert_true(reads[i].rule == rule);
+        g_assert_cmpuint(reads[i].kind, ==, rule->command_kind);
+    }
+}
+
+static void compare_query(uint16_t kind)
+{
+    KindRead observed[32];
+    bool old_result = false;
+    bool expected = false;
+
+    for (guint i = 0; i < crucible_node_rules->len; i++) {
+        const QemuCrucibleFaultRule *rule =
+            g_ptr_array_index(crucible_node_rules, i);
+
+        if (rule->command_kind == kind) {
+            expected = true;
+        }
+    }
+
+    read_count = 0;
+    bool result = qemu_crucible_fault_rule_kind_present(kind);
+    g_assert_cmpint(result, ==, expected);
+    assert_complete_reads();
+    memcpy(observed, reads, read_count * sizeof(*reads));
+
+    read_count = 0;
+    baseline_qemu_crucible_fault_rule_foreach(
+        kind, baseline_crucible_register_active_visit, &old_result);
+    g_assert_cmpint(result, ==, old_result);
+    assert_complete_reads();
+    for (guint i = 0; i < read_count; i++) {
+        g_assert_true(observed[i].rule == reads[i].rule);
+        g_assert_cmpuint(observed[i].kind, ==, reads[i].kind);
+    }
+}
+
+static void check_initializer(void)
+{
+    clear_rules();
+    read_count = 0;
+    g_assert_false(qemu_crucible_fault_rule_kind_present(20));
+    g_assert_nonnull(crucible_node_rules);
+    assert_complete_reads();
+    GPtrArray *first = crucible_node_rules;
+
+    g_assert_false(qemu_crucible_fault_rule_kind_present(0));
+    g_assert_true(first == crucible_node_rules);
