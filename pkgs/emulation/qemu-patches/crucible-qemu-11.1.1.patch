+    release_calls++;
+    if (callback_reentry) {
+        callback_transition_checks();
+    }
+    if (qemu_mutex_trylock(&actual_child.journal)) {
+        return -EBUSY;
+    }
+    if (!actual_child.owned || actual_child.process != getpid() ||
+        holder != actual_child.holder || *holder != &actual_child.pending ||
+        serial != actual_child.serial) {
+        qemu_mutex_unlock(&actual_child.journal);
+        return -ESTALE;
+    }
+    if (actual_child.borrow_held) {
+        qemu_mutex_unlock(&actual_child.journal);
+        return -EBUSY;
+    }
+    if (release_failure || contradict_release) {
+        qemu_mutex_unlock(&actual_child.journal);
+        return release_failure;
+    }
+    actual_child.pending.value = 0;
+    actual_child.owned = false;
+    actual_child.holder = NULL;
+    destruction_calls++;
