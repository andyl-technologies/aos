+static void test_child_registry_rebuild_preserves_parent(void)
+{
+    QemuCrucibleHotForkRuntimeTransaction transaction = { 0 };
+    QemuThreadHotForkInventory before;
+    QemuThreadHotForkInventory after;
+    QemuRcuHotForkInventory rcu_before;
+    QemuRcuHotForkInventory rcu_after;
+    RegistryWorkerThread monitor_worker;
+    int child_result[2];
+    int result;
+    pid_t child;
+
+    g_assert_cmpint(pipe2(child_result, O_CLOEXEC), ==, 0);
+    start_registry_worker_thread(&monitor_worker, "IO mon_iothread",
+                                 monitor_registry_worker);
+
+    qemu_thread_hot_fork_inventory(&before);
+    g_assert_cmpuint(before.entry_count, ==, 3);
+    g_assert_cmpuint(before.overflow_count, ==, 0);
+    qemu_rcu_hot_fork_inventory(&rcu_before);
+    g_assert_false(rcu_before.overflowed);
+    for (unsigned int attempt = 0; attempt < 1000; attempt++) {
+        result = qemu_crucible_hot_fork_begin_runtime_transaction(
+            &transaction);
+        if (result != -EBUSY) {
+            break;
+        }
+        g_usleep(1000);
+    }
+    g_assert_cmpint(result, ==, 0);
+
+    child = fork();
+    g_assert_cmpint(child, >=, 0);
+    if (child == 0) {
+        QemuThreadHotForkInventory child_inventory;
+        QemuRcuHotForkInventory child_rcu;
+        int child_status = qemu_thread_hot_fork_reconstruct_child_registry(
+            &transaction.registry);
+
+        if (child_status == 0) {
+            child_status = qemu_rcu_hot_fork_prepare_child(&transaction.rcu);
+        }
+
+        if (child_status == 0) {
+            qemu_thread_hot_fork_inventory(&child_inventory);
+            qemu_rcu_hot_fork_inventory(&child_rcu);
+            if (child_inventory.entry_count != 1 ||
+                child_inventory.overflow_count != 0 ||
+                child_rcu.entry_count != 1 || child_rcu.overflowed ||
+                child_inventory.entries[0].disposition !=
+                    QEMU_THREAD_HOT_FORK_COORDINATOR ||
+                child_inventory.entries[0].thread_id != qemu_get_thread_id()) {
+                child_status = -EPROTO;
+            }
+            qemu_thread_hot_fork_inventory_destroy(&child_inventory);
+            qemu_rcu_hot_fork_inventory_destroy(&child_rcu);
+        }
+        write_child_result(child_result[1], child_status);
+        _exit(0);
+    }
+
+    g_assert_cmpint(qemu_crucible_hot_fork_release_parent_runtime_transaction(
+                        &transaction),
+                    ==, 0);
+    close(child_result[1]);
+    g_assert_cmpint(read_child_result(child_result[0]), ==, 0);
+    wait_for_child(child);
+
+    qemu_thread_hot_fork_inventory(&after);
+    g_assert_cmpuint(after.generation, ==, before.generation);
+    g_assert_cmpuint(after.entry_count, ==, before.entry_count);
+    g_assert_cmpuint(after.overflow_count, ==, before.overflow_count);
+    for (size_t index = 0; index < before.entry_count; index++) {
+        g_assert_cmpint(after.entries[index].thread_id, ==,
+                        before.entries[index].thread_id);
+        g_assert_cmpint(after.entries[index].disposition, ==,
+                        before.entries[index].disposition);
+    }
+    qemu_rcu_hot_fork_inventory(&rcu_after);
+    g_assert_cmpuint(rcu_after.generation, ==, rcu_before.generation);
+    g_assert_cmpuint(rcu_after.entry_count, ==, rcu_before.entry_count);
+    g_assert_false(rcu_after.overflowed);
+
+    qemu_thread_hot_fork_inventory_destroy(&after);
+    qemu_thread_hot_fork_inventory_destroy(&before);
+    qemu_rcu_hot_fork_inventory_destroy(&rcu_after);
+    qemu_rcu_hot_fork_inventory_destroy(&rcu_before);
+    close(child_result[0]);
+    stop_registry_worker_thread(&monitor_worker);
+}
