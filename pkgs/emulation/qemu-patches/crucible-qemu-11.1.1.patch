+int qemu_plugin_crucible_register_resident_fingerprint_retirement_v1(
+    qemu_plugin_id_t id,
+    qemu_plugin_crucible_fingerprint_borrow_cb_t borrow,
+    qemu_plugin_crucible_fingerprint_operation_cb_t rearm,
+    qemu_plugin_crucible_fingerprint_operation_cb_t check,
+    qemu_plugin_crucible_fingerprint_end_cb_t end,
+    void *userdata)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleResidentFingerprintPurpose *purpose = &startup_source.resident_fingerprint;
+    QemuCrucibleFingerprintCompletionBinding *completion =
+        &startup_source.fingerprint_completion;
+    gpointer registered;
+    int status;
+
+    if (!startup_invocation(id)) {
+        return -EPERM;
+    }
+    status = startup_active(id);
+    if (status) {
+        return status;
+    }
+    if (purpose->attempted ||
+        qatomic_load_acquire(&startup_source.fingerprint_retirement_attempted)) {
+        return -EALREADY;
+    }
+    if (!borrow || !rearm || !check || !end || !userdata ||
+        userdata != completion->userdata || startup_source.ram_control_actor.attempted) {
+        return -EINVAL;
+    }
+    status = fingerprint_completion_identity(completion);
+    if (!status) {
+        status = qemu_crucible_startup_source_fingerprint_observer_current_v1(
+            startup_source.standing.observer);
+    }
+    if (!status) {
+        status = startup_runtime_admission(
+            id, &startup_source.runtime_purpose);
+    }
+    if (!status) {
+        status = qemu_crucible_checkpoint_storage_current_v1();
+    }
+    if (status) {
+        return status;
+    }
+
+    /* Source's genuine preexec sizeof floor paid this complete registrar
+     * before birth. The retained Runtime row0 and enrolled fields lend actual
+     * module custody; absent page workers never manufacture a pager purpose. */
+    *purpose = (QemuCrucibleResidentFingerprintPurpose) {
+        .installer = startup_source.saved,
+        .runtime = &startup_source.runtime_purpose,
+        .completion = completion,
+        .observer = startup_source.standing.observer,
+        .userdata = userdata,
+        .process = getpid(),
+        .attempted = true,
+    };
+    qatomic_store_release(&startup_source.fingerprint_retirement_attempted, true);
+    status = qemu_rec_mutex_trylock(&plugin.lock);
+    if (status) {
+        return startup_failure(status);
+    }
+    registered = plugin.id_ht ? g_hash_table_lookup(plugin.id_ht, &id) : NULL;
+    if (registered != &startup_source.current.ctx->id ||
+        startup_source.current.ctx->resetting || startup_source.current.ctx->uninstalling ||
+        startup_source.current.ctx != purpose->installer.ctx ||
+        startup_source.current.module != purpose->installer.module ||
+        startup_source.current.install != purpose->installer.install) {
+        qemu_rec_mutex_unlock(&plugin.lock);
+        return startup_failure(-EPERM);
+    }
+    qemu_rec_mutex_unlock(&plugin.lock);
+
+    status = qemu_plugin_crucible_startup_source_check_v1(id);
+    if (status) {
+        return status;
+    }
+    startup_source.fingerprint_borrow = borrow;
+    startup_source.fingerprint_rearm = rearm;
+    startup_source.fingerprint_check = check;
+    startup_source.fingerprint_end = end;
+    startup_source.fingerprint_userdata = userdata;
+    startup_source.fingerprint_resident_purpose = purpose;
+    /* Registration retains a nominal runtime relation. Only the later real
+     * Root loan's admitted resident inventory and writer proof admit a borrow. */
+    qatomic_store_release(&purpose->enrolled, true);
+    qatomic_store_release(&startup_source.fingerprint_retirement_registered, true);
+    return 0;
+#else
+    return -ENOTSUP;
+#endif
+}
