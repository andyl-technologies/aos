+        ("*recipient_post = qemu_crucible_preexec_publisher_recipient_current_v1(\n        receiver->lender, receiver->recipient, receiver);", "*recipient_post = 0;"),
+        ("*cohort_post = advance_receiver_identity(receiver);", "*cohort_post = 0;"),
