+static bool pic_crucible_interrupt_route_validate(
+    const QemuCrucibleInterruptEvent *event, void *opaque)
+{
+    PICCommonState *pic;
+    int irq;
+
+    (void)opaque;
+    if (event->family != QEMU_CRUCIBLE_INTERRUPT_X86_PIC) {
+        return false;
+    }
+    if (event->controller_source < 16) {
+        pic = event->controller_source < 8 ? isa_pic : slave_pic;
+        irq = event->controller_source & 7;
+    } else {
+        irq = event->vector & 15;
+        pic = irq < 8 ? isa_pic : slave_pic;
+        irq &= 7;
+    }
+    return event->priority == irq &&
+        (!event->release_phase || !(pic->irr & (1U << irq)));
+}
