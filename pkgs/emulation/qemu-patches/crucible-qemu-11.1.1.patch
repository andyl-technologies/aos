+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    QemuCrucibleCommandReceiveOwner *owner = &startup_source.command_receive;
+    uintptr_t field = (uintptr_t)runtime_field;
+    int status = command_registry_identity(id);
+
+    if (status || !projection || !runtime_field || !startup_owner()) {
+        return status ? status : -EPERM;
+    }
+    qemu_mutex_lock(&commands->mutex);
+    if (callback_child_output_conflicts_locked(projection, sizeof(*projection)) ||
+        callback_child_output_conflicts_locked(runtime_field, sizeof(*runtime_field)) ||
+        callback_child_output_overlap(projection, sizeof(*projection), runtime_field, sizeof(*runtime_field))) {
+        status = -EINVAL;
+    } else {
+        status = command_receive_identity_locked(owner, serial);
+    }
+    if (!status && owner->creation_active) {
+        status = -EBUSY;
+    }
+    if (!status && (*projection != owner || owner->transferred ||
+                    owner->invocation_active || !owner->member->runtime_base ||
+                    owner->member->runtime_extent < sizeof(*runtime_field) ||
+                    owner->member->runtime_extent > UINTPTR_MAX - owner->member->runtime_base ||
+                    field < owner->member->runtime_base ||
+                    field % _Alignof(QemuCrucibleCommandReceiveOwner *) ||
+                    field - owner->member->runtime_base >
+                        owner->member->runtime_extent - sizeof(*runtime_field) || *runtime_field)) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        *runtime_field = owner;
+        owner->runtime_holder = runtime_field;
+        owner->holder = runtime_field;
+        owner->runtime_base = owner->member->runtime_base;
+        owner->runtime_extent = owner->member->runtime_extent;
+        owner->transferred = true;
+        owner->creation_owner = NULL;
+        *projection = NULL;
+    }
+    qemu_mutex_unlock(&commands->mutex);
+    /* This identity move admits no semantic work or new Original query. It
+     * also moves a born-negative/uncertain receive without erasing its debt. */
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
