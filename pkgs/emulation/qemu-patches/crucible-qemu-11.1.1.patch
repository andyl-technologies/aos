+    g_assert_cmpuint(barrier.writable_backends, >=, 1);
+    g_assert_cmpuint(barrier.quiesced_rooted_backends,
+                     ==, barrier.rooted_backends);
+    g_assert_cmpuint(barrier.in_flight, ==, 0);
+
+    qemu_thread_create(&thread, "block-barrier-query",
+                       test_hot_fork_block_barrier_query, &query,
+                       QEMU_THREAD_JOINABLE);
+    qemu_thread_join(&thread);
+    g_assert_true(query.success);
+    g_assert_cmpuint(query.inventory.generation, ==, barrier.generation);
+    g_assert_true(query.inventory.held);
+    g_assert_true(query.inventory.complete);
+    g_assert_true(query.inventory.quiescent);
+    g_assert_true(query.inventory.graph_held);
+    g_assert_true(query.inventory.graph_stable);
+    g_assert_cmpuint(query.inventory.graph_mutation_generation,
+                     ==, barrier.graph_mutation_generation);
+    g_assert_cmpuint(query.inventory.backend_count,
+                     ==, barrier.backend_count);
+    g_assert_cmpuint(query.inventory.rooted_backends,
+                     ==, barrier.rooted_backends);
+
+    g_assert_true(qemu_block_backend_hot_fork_barrier(
+        QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_RELEASE, &barrier));
+    g_assert_false(barrier.held);
+    g_assert_false(barrier.graph_held);
+    g_assert_false(barrier.graph_stable);
+    g_assert_false(barrier.quiescent);
+    g_assert_cmpint(barrier.owner_thread_id, ==, 0);
+
+    graph_mutation_generation = barrier.graph_mutation_generation;
+    blk_unref(blk);
+    bdrv_graph_wrlock();
+    bdrv_graph_wrunlock();
+    g_assert_true(qemu_block_backend_hot_fork_barrier(
+        QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_QUERY, &barrier));
+    g_assert_cmpuint(barrier.graph_mutation_generation,
+                     >, graph_mutation_generation);
+}
