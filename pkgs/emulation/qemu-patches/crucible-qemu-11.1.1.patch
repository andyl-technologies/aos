+
+static void test_startup_refusals(void)
+{
+    static const size_t nonzero_offsets[] = { 48, 56, 72, 80, 96, 112, 120 };
+    static const uint32_t invalid_descriptors[] = {
+        0, 2, (uint32_t)INT_MAX + 1, UINT32_MAX,
+    };
+    static const uint32_t invalid_flags[] = { 0, 2, 3, UINT32_MAX };
+    uint8_t wire[129];
+
+    fixture_startup(wire, 0, 3);
+    wire[128] = 0x7b;
+    assert_startup_refusal(NULL, 128);
+    assert_startup_refusal(wire, 0);
+    assert_startup_refusal(wire, 127);
