+static GArray *crucible_internal_get_vcpu_registers(unsigned int vcpu_index)
+{
+    CPUState *cpu = qemu_get_cpu(vcpu_index);
+
+    if (!cpu) {
+        return NULL;
+    }
+
+    g_autoptr(GArray) regs = gdb_get_register_list(cpu);
+    return create_register_handles(regs);
+}
+
+static int crucible_internal_read_vcpu_register(
+    unsigned int vcpu_index, struct qemu_plugin_register *reg,
+    GByteArray *buf)
+{
+    CPUState *cpu = qemu_get_cpu(vcpu_index);
+
+    if (!cpu || !buf) {
+        return -1;
+    }
+    return gdb_read_register(cpu, buf, GPOINTER_TO_INT(reg) >> 1);
+}
+
+static bool qemu_plugin_crucible_write_u64(uint8_t *out,
+                                           size_t capacity,
+                                           size_t *offset,
+                                           uint64_t value)
+{
+    size_t start = *offset;
+
+    *offset += sizeof(value);
+    if (start > capacity || capacity - start < sizeof(value)) {
+        return false;
+    }
+
+    for (size_t i = 0; i < sizeof(value); i++) {
+        out[start + i] = (value >> (i * 8)) & 0xffU;
+    }
+    return true;
+}
+
+static bool qemu_plugin_crucible_write_bytes(uint8_t *out,
+                                             size_t capacity,
+                                             size_t *offset,
+                                             const uint8_t *bytes,
+                                             size_t len)
+{
+    size_t start = *offset;
+
+    *offset += len;
+    if (len == 0) {
+        return true;
+    }
+    if (!bytes || start > capacity || capacity - start < len) {
+        return false;
+    }
+
+    memcpy(out + start, bytes, len);
+    return true;
+}
+
+static bool qemu_plugin_crucible_write_cstr(uint8_t *out,
+                                            size_t capacity,
+                                            size_t *offset,
+                                            const char *text)
+{
+    size_t len = text ? strlen(text) : 0;
+    bool wrote_len;
+    bool wrote_bytes;
+
+    wrote_len = qemu_plugin_crucible_write_u64(out, capacity, offset, len);
+    wrote_bytes = qemu_plugin_crucible_write_bytes(out, capacity, offset,
+                                                   (const uint8_t *)text, len);
+    return wrote_len && wrote_bytes;
+}
+
+static int crucible_read_vcpu_regs_unchecked(
+    unsigned int vcpu_index, uint8_t *out_register_bytes,
+    size_t out_register_capacity, size_t *out_register_len,
+    uint64_t *out_retired_instruction_count)
+{
+    CPUState *cpu = qemu_get_cpu(vcpu_index);
+    g_autoptr(GArray) descriptors = NULL;
+    g_autoptr(GByteArray) buffer = NULL;
+    size_t offset = 0;
+    bool ok = true;
+
+    if (!out_register_len || !out_retired_instruction_count ||
+        (!out_register_bytes && out_register_capacity != 0) || !cpu) {
+        return -1;
+    }
+
+    *out_register_len = 0;
+    *out_retired_instruction_count = 0;
+
+    descriptors = crucible_internal_get_vcpu_registers(vcpu_index);
+    if (!descriptors || descriptors->len == 0) {
+        return -1;
+    }
+
+    buffer = g_byte_array_new();
+    if (!buffer) {
+        return -1;
+    }
+
+    ok &= qemu_plugin_crucible_write_cstr(out_register_bytes,
+                                          out_register_capacity,
+                                          &offset,
+                                          "aos-qemu-vcpu-regs-v1");
+    ok &= qemu_plugin_crucible_write_u64(out_register_bytes,
+                                         out_register_capacity,
+                                         &offset,
+                                         vcpu_index);
+    ok &= qemu_plugin_crucible_write_u64(out_register_bytes,
+                                         out_register_capacity,
+                                         &offset,
+                                         descriptors->len);
+
+    for (unsigned int i = 0; i < descriptors->len; i++) {
+        const qemu_plugin_reg_descriptor *reg =
+            &g_array_index(descriptors, qemu_plugin_reg_descriptor, i);
+        int size;
+
+        g_byte_array_set_size(buffer, 0);
+        size = crucible_internal_read_vcpu_register(vcpu_index,
+                                                       reg->handle,
+                                                       buffer);
+        if (size < 0 || (size_t)size != buffer->len) {
+            return -1;
+        }
+
+        ok &= qemu_plugin_crucible_write_cstr(out_register_bytes,
+                                              out_register_capacity,
+                                              &offset,
+                                              reg->name);
+        ok &= qemu_plugin_crucible_write_cstr(out_register_bytes,
+                                              out_register_capacity,
+                                              &offset,
+                                              reg->feature);
+        ok &= qemu_plugin_crucible_write_u64(out_register_bytes,
+                                             out_register_capacity,
+                                             &offset,
+                                             (uint64_t)size);
+        ok &= qemu_plugin_crucible_write_bytes(out_register_bytes,
+                                               out_register_capacity,
+                                               &offset,
+                                               buffer->data,
+                                               buffer->len);
+    }
+
+    /*
+     * The aggregate sample icount belongs to the caller's trace sample.
+     * qemu_plugin_icount_raw() is not valid in every plugin callback context,
+     * so the canonical register export keeps this ABI field deterministic and
+     * side-effect-free instead of sampling raw icount here.
+     */
+    *out_register_len = offset;
+    return ok ? 0 : -1;
+}
+
+static __thread unsigned int crucible_device_projection_depth;
+
+static void crucible_device_projection_enter(void)
+{
+    g_assert(bql_locked());
+    g_assert(crucible_device_projection_depth == 0);
+    crucible_device_projection_depth++;
+}
+
+static void crucible_device_projection_leave(void)
+{
+    g_assert(crucible_device_projection_depth == 1);
+    crucible_device_projection_depth--;
+}
+
+int qemu_crucible_internal_read_vcpu_regs(
+    unsigned int vcpu_index, uint8_t *out_register_bytes,
+    size_t out_register_capacity, size_t *out_register_len,
+    uint64_t *out_retired_instruction_count)
+{
+    if (crucible_device_projection_depth != 1 || !bql_locked()) {
+        return -1;
+    }
+    return crucible_read_vcpu_regs_unchecked(
+        vcpu_index, out_register_bytes, out_register_capacity,
+        out_register_len, out_retired_instruction_count);
+}
+
+int qemu_plugin_read_vcpu_regs(unsigned int vcpu_index,
+                               uint8_t *out_register_bytes,
+                               size_t out_register_capacity,
+                               size_t *out_register_len,
+                               uint64_t *out_retired_instruction_count)
+{
+    if (!qemu_plugin_crucible_vcpu_register_read_allowed()) {
+        return -1;
+    }
+    return crucible_read_vcpu_regs_unchecked(
+        vcpu_index, out_register_bytes, out_register_capacity,
+        out_register_len, out_retired_instruction_count);
+}
