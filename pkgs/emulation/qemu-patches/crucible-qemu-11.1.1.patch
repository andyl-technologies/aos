+    }
+    if (operation_class == 5) {
+        qemu_plugin_crucible_fingerprint_baseline_v1 *baseline = NULL;
+
+        status = qemu_crucible_ram_fingerprint_baseline_borrow_v1(id, &baseline);
+        if (status || !baseline) {
+            return status ? status : -ESTALE;
+        }
+    }
+    if (observation_writer) {
+        if (observation_writer != fingerprint_root_writer) {
+            return -EPERM;
+        }
+        status = qemu_crucible_observation_writer_current_v1(observation_writer);
+    } else {
+        status = !current_cpu && qemu_in_main_thread() &&
+            writer_fence == &checkpoint_native_fence ?
+            qemu_crucible_checkpoint_native_fence_check_v1(
+                checkpoint_native_fence.transaction, writer_fence) : -ENOTSUP;
+    }
+    if (status) {
+        return status;
+    }
+    if (!(global_dirty_tracking & GLOBAL_DIRTY_CRUCIBLE_RAM) &&
+        (operation_class != 4 || current_cpu)) {
+        /* Cold logging initialization is a genuine Main class4 effect. Never
+         * start listener callbacks or an initializer from CPU replay context. */
+        return -ENOTSUP;
+    }
+    if (logical_physical_debt.pending &&
+        (logical_physical_debt.regions != admission_regions ||
+         logical_physical_debt.topology != qatomic_read(&topology_generation))) {
+        return -ESTALE;
+    }
+    status = region_inventory_ref(admission_regions, &retained);
+    if (status) {
+        return status;
+    }
+    *claim = (struct QemuCrucibleLogicalCapture) {
+        .id = id,
+        .operation = operation,
+        .writer_fence = writer_fence,
+        .observation_writer = observation_writer,
+        .regions = retained,
+        .process = getpid(),
+        .topology = qatomic_read(&topology_generation),
+        .dirty = qatomic_read(&dirty_generation),
+        .initializing = operation_class == 4,
+        .operation_class = operation_class,
+    };
+    qemu_thread_get_self(&claim->thread);
+    qatomic_store_release(&claim->active, true);
+    status = logical_capture_geometry_current();
+    if (!status) {
+        claim->geometry_pinned = true;
+        if (retired) {
+            claim->publication = &fingerprint_publication;
+            fingerprint_publication.claim = claim;
+        } else {
+            struct qemu_plugin_crucible_fingerprint_original_v1 original;
+            CrucibleRamInventory *publication_regions = NULL;
+
+            status = qemu_plugin_crucible_fingerprint_operation_observe_v1(operation, &original);
+            if (!status) {
+                status = region_inventory_ref(retained, &publication_regions);
+            }
+            if (!status) {
+                fingerprint_publication = (struct QemuCrucibleLogicalPublication) {
+                    .claim = claim,
+                    .holder = publication_field,
+                    .regions = publication_regions,
+                    .original = original,
+                    .process = getpid(),
+                    .borrowed = true,
+                    .observed = {
+                        .schema_version = 1,
+                        .struct_size = sizeof(fingerprint_publication.observed),
+                        .plugin_id = id,
+                        .frame_serial = fingerprint_root_frame.serial,
+                        .topology_generation = claim->topology,
+                        .dirty_generation = claim->dirty,
+                        .operation_serial = original.operation_serial,
+                        .supervisor_origin_ns = original.supervisor_origin_ns,
+                        .operation_class = original.class_index,
+                        .cpu_replay_context = current_cpu != NULL,
+                    },
+                };
+                memcpy(fingerprint_publication.observed.supervisor_capability,
+                       original.supervisor_capability, 32);
+                claim->publication = &fingerprint_publication;
+                *publication_field = &fingerprint_publication;
+            }
+        }
+    }
+    if (!status) {
+        /* Source publishes actual custody through the real native holder
+         * before returning signed status, including a born-negative result. */
+        status = retired ? qemu_crucible_startup_source_logical_capture_rebind_v1(
+            operation, retired, claim, &claim->source_claim) :
+            qemu_crucible_startup_source_logical_capture_attach_v1(
+                id, operation, claim, &claim->source_claim);
+        if (!status && claim->source_claim != claim) {
+            status = -EPROTO;
+        }
+    }
+    if (!status) {
+        claim->attached = true;
+        if (claim->initializing) {
+            /* Reserve the real future publication inventory before reads,
+             * under this same actual entered initialization holder. */
+            status = region_inventory_ref(retained, &claim->baseline_pending_regions);
+            require_full = 1;
+        }
+    }
+    if (!status) {
+        capture_observation_only = true;
+        status = ram_capture_begin(require_full, 0, out);
+        if (!status) {
+            claim->generation = capture_generation;
+            /* Publish the exact born header facts before fallible projection.
+             * Pending facts corroborate only this actual loan, never acceptance. */
+            fingerprint_publication.observed.capture_generation = capture_generation;
+            fingerprint_publication.observed.topology_generation = capture_topology_generation;
+            fingerprint_publication.observed.dirty_generation = capture_dirty_generation;
+            fingerprint_publication.observed.full_capture = capture_full;
+            /* Logging may have legitimately published initial dirty marks. */
+            claim->dirty = capture_dirty_generation;
+            if (ordinary_fingerprint.operation_borrowed) {
+                ordinary_fingerprint.operation_capture_generation = capture_generation;
+                ordinary_fingerprint.topology = capture_topology_generation;
+                ordinary_fingerprint.dirty = capture_dirty_generation;
+            }
+            status = logical_capture_geometry_current();
+            if (!status && !logical_capture_versions_current()) {
+                status = -ESTALE;
+            }
+        }
+    }
+    if (status && !claim->first_status) {
+        claim->first_status = status;
+    }
+    return status;
+}
