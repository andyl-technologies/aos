+static void test_decrementer_wide(void)
+{
+    PowerPCCPU cpu = { 0 };
+    ppc_tb_t timebase = { .decr_freq = 512000000 };
+    QEMUTimer *timer;
+    __int128 now = ((__int128)1 << 120) + 357;
+    /*
+     * Independently computed ceil((floor(now * 512MHz / 1e12) + 7)
+     *                             * 1e12 / 512MHz) - now.
+     */
+    __int128 expected = now + 12489;
+
+    initialize_clock(true);
+    timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, NULL, NULL);
+    cpu.env.tb_env = &timebase;
+    observed_ps = now;
+    __cpu_ppc_store_decr(&cpu, now, &timebase.decr_next, timer,
+                         diagnostic_decr_raise,
+                         diagnostic_decr_lower, 0, 0, 7, 32);
+
+    g_assert_true(timer_pending(timer));
+    g_assert_true(timer_expire_time_ps_wide(timer) == expected);
+    g_assert_cmpuint(timebase.decr_next, ==,
+                     ppc_ps_to_tb(timebase.decr_freq, now) + 7);
+    g_assert_true(ppc_decr_target_ps(&timebase) == expected);
+    timer_free(timer);
+}
