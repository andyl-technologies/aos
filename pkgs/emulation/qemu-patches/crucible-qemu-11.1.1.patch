+        cpu_relax();
+    }
+}
+
+int qemu_crucible_observation_cpu_boundary_begin_v1(
+    QemuCrucibleObservationCpuBoundaryScope *scope, void *cpu,
+    QemuCrucibleObservationCpuBoundaryPhase phase)
+{
+    int status = 0;
+
+    if (!scope || scope->active || !cpu ||
+        (phase != QEMU_CRUCIBLE_CPU_BOUNDARY_BEFORE_INSTRUCTION &&
+         phase != QEMU_CRUCIBLE_CPU_BOUNDARY_AFTER_INSTRUCTION &&
+         phase != QEMU_CRUCIBLE_CPU_BOUNDARY_EXCEPTION_RETURN)) {
+        return -EINVAL;
+    }
