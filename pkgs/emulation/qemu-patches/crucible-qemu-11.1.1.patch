+static int advance_observation_current(QemuCrucibleSourceAdvanceReceiver *receiver,
+                                       QemuCrucibleAdvanceCallbackKind kind)
+{
+    int status = advance_receiver_identity(receiver);
+
+    if (!status && receiver->callback.kind != kind) {
+        status = -EPERM;
+    }
+    if (!status) {
+        status = qemu_plugin_crucible_native_advance_callback_current_v1(
+            receiver->main, receiver->control, &receiver->callback.mask);
+    }
+    if (!status) {
+        status = qemu_crucible_preexec_publisher_recipient_current_v1(
+            receiver->lender, receiver->recipient, receiver);
+    }
+    if (!status) {
+        status = advance_publication_current(receiver);
+    }
+    if (!status) {
+        status = qemu_crucible_preexec_publisher_recipient_current_v1(
+            receiver->lender, receiver->recipient, receiver);
+    }
+    return status;
+}
+
+static void advance_observation_record(QemuCrucibleSourceAdvanceReceiver *receiver,
+                                        int first, int post)
+{
+    if (!receiver->callback.observation_first_status) {
+        receiver->callback.observation_first_status = first;
+    }
+    if (!receiver->callback.observation_post_status) {
+        receiver->callback.observation_post_status = post;
+    }
+}
