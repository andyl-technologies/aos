+static bool crucible_memory_vmstate_get_translation(
+    QemuCrucibleFaultVmstateReader *reader,
+    CrucibleNodeTranslation *translation)
+{
+    uint16_t requester_id;
+    uint8_t pid, space, secure, attrs_user, memory, debug, unspecified;
+    uint8_t readable, writable, executable, user, reserved;
+
+    if (!qemu_crucible_fault_vmstate_get_u64(
+            reader, &translation->virtual_page) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            reader, &translation->physical_page) ||
+        !qemu_crucible_fault_vmstate_get_u64(reader,
+                                              &translation->page_size) ||
+        !qemu_crucible_fault_vmstate_get_u32(
+            reader, &translation->covered_bytes) ||
+        !qemu_crucible_fault_vmstate_get_u16(reader, &requester_id) ||
+        !qemu_crucible_fault_vmstate_get_u8(reader, &pid) ||
+        !qemu_crucible_fault_vmstate_get_u8(reader, &space) ||
+        !qemu_crucible_fault_vmstate_get_u8(reader, &secure) ||
+        !qemu_crucible_fault_vmstate_get_u8(reader, &attrs_user) ||
+        !qemu_crucible_fault_vmstate_get_u8(reader, &memory) ||
+        !qemu_crucible_fault_vmstate_get_u8(reader, &debug) ||
+        !qemu_crucible_fault_vmstate_get_u8(reader, &unspecified) ||
+        !qemu_crucible_fault_vmstate_get_u8(reader, &readable) ||
+        !qemu_crucible_fault_vmstate_get_u8(reader, &writable) ||
+        !qemu_crucible_fault_vmstate_get_u8(reader, &executable) ||
+        !qemu_crucible_fault_vmstate_get_u8(reader, &user) ||
+        !qemu_crucible_fault_vmstate_get_u8(reader, &reserved) ||
+        translation->page_size == 0 || translation->covered_bytes == 0 ||
+        translation->covered_bytes > translation->page_size || space > 3 ||
+        secure > 1 || attrs_user > 1 || memory > 1 || debug > 1 ||
+        unspecified > 1 || readable > 1 || writable > 1 || executable > 1 ||
+        user > 1 || reserved != 0) {
+        return false;
+    }
+    translation->attrs.pid = pid;
+    translation->attrs.requester_id = requester_id;
+    translation->attrs.space = space;
+    translation->attrs.secure = secure;
+    translation->attrs.user = attrs_user;
+    translation->attrs.memory = memory;
+    translation->attrs.debug = debug;
+    translation->attrs.unspecified = unspecified;
+    translation->readable = readable;
+    translation->writable = writable;
+    translation->executable = executable;
+    translation->user = user;
+    return true;
+}
+
+static void crucible_memory_translation_encode(
+    const CrucibleNodeTranslation *translation, uint8_t encoded[48])
+{
+    memset(encoded, 0, 48);
+    stq_le_p(encoded, translation->virtual_page);
+    stq_le_p(encoded + 8, translation->physical_page);
+    stq_le_p(encoded + 16, translation->page_size);
+    stl_le_p(encoded + 24, translation->covered_bytes);
+    stw_le_p(encoded + 28, translation->attrs.requester_id);
+    encoded[30] = translation->attrs.pid;
+    encoded[31] = translation->attrs.space;
+    encoded[32] = translation->attrs.secure;
+    encoded[33] = translation->attrs.user;
+    encoded[34] = translation->attrs.memory;
+    encoded[35] = translation->attrs.debug;
+    encoded[36] = translation->attrs.unspecified;
+    encoded[40] = translation->readable;
+    encoded[41] = translation->writable;
+    encoded[42] = translation->executable;
+    encoded[43] = translation->user;
+}
+
+static bool crucible_memory_vmstate_translations_valid(
+    QemuCrucibleFaultRule *rule)
+{
+    g_autoptr(GChecksum) checksum = NULL;
+    uint8_t digest[32];
+    gsize digest_len = sizeof(digest);
+    uint64_t start, length, current, remaining;
+    uint32_t vcpu;
+    bool has_vcpu;
+
+    if (!node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_T2, &start) ||
+        !node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_T5, &length) ||
+        !node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_T3, &has_vcpu) ||
+        !node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_T4, &vcpu)) {
+        return false;
+    }
+    if (!has_vcpu) {
+        uint8_t zero[32] = { 0 };
+
+        return (!rule->translations || rule->translations->len == 0) &&
+               memcmp(rule->translation_hash, zero, sizeof(zero)) == 0;
+    }
+    if (!qemu_get_cpu(vcpu)) {
+        return false;
+    }
+    checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    g_checksum_update(checksum, (const uint8_t *)"CRUCNTX1", 8);
+    current = start;
+    remaining = length;
+    for (guint i = 0; rule->translations &&
+         i < rule->translations->len; i++) {
+        const CrucibleNodeTranslation *translation = &g_array_index(
+            rule->translations, CrucibleNodeTranslation, i);
+        uint8_t encoded[48];
+        uint64_t offset, physical;
+        uint64_t covered;
+
+        if (translation->page_size == 0) {
+            return false;
+        }
+        offset = current % translation->page_size;
+        if (current < offset ||
+            translation->virtual_page != current - offset ||
+            translation->physical_page > UINT64_MAX - offset) {
+            return false;
+        }
+        physical = translation->physical_page + offset;
+        covered = MIN(remaining, translation->page_size - offset);
+        if (translation->covered_bytes != covered || covered == 0 ||
+            !node_memory_gpa_is_ram(physical, covered) ||
+            current > UINT64_MAX - covered) {
+            return false;
+        }
+        crucible_memory_translation_encode(translation, encoded);
+        g_checksum_update(checksum, encoded, sizeof(encoded));
+        current += covered;
+        remaining -= covered;
+    }
+    if (remaining != 0) {
+        return false;
+    }
+    g_checksum_get_digest(checksum, digest, &digest_len);
+    return digest_len == sizeof(digest) &&
+           memcmp(digest, rule->translation_hash, sizeof(digest)) == 0;
+}
+
+static bool crucible_memory_vmstate_get_retry(
+    QemuCrucibleFaultVmstateReader *reader,
+    CrucibleMemoryVmstateRetry *retry)
+{
+    uint8_t has_instruction, streaming;
+    uint16_t reserved16;
+    uint32_t page_table_level, reserved32;
+
+    if (!qemu_crucible_fault_vmstate_get_u64(reader, &retry->key.address) ||
+        !qemu_crucible_fault_vmstate_get_u64(reader, &retry->key.length) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            reader, &retry->key.observed_icount) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            reader, &retry->key.instruction_pc) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            reader, &retry->key.page_table_target_vaddr) ||
+        !qemu_crucible_fault_vmstate_get_u32(
+            reader, &retry->key.access_class) ||
+        !qemu_crucible_fault_vmstate_get_u32(reader, &retry->key.actor) ||
+        !qemu_crucible_fault_vmstate_get_u32(reader, &page_table_level) ||
+        !qemu_crucible_fault_vmstate_get_u32(
+            reader, &retry->key.page_table_stage) ||
+        !qemu_crucible_fault_vmstate_get_u32(
+            reader, &retry->key.initiating_access_class) ||
+        !qemu_crucible_fault_vmstate_get_u8(reader, &has_instruction) ||
+        !qemu_crucible_fault_vmstate_get_u8(reader, &streaming) ||
+        !qemu_crucible_fault_vmstate_get_u16(reader, &reserved16) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            reader, &retry->state.last_access_sequence) ||
+        !qemu_crucible_fault_vmstate_get_u32(
+            reader, &retry->state.retry_ordinal) ||
+        !qemu_crucible_fault_vmstate_get_u32(reader, &reserved32) ||
+        has_instruction > 1 || streaming > 1 || reserved16 != 0 ||
+        reserved32 != 0 || retry->state.last_access_sequence == 0) {
+        return false;
+    }
+    retry->key.page_table_level = (int32_t)page_table_level;
+    retry->key.has_instruction = has_instruction;
+    retry->key.streaming = streaming;
+    return true;
+}
+
+static int crucible_memory_vmstate_prepare(const uint8_t *payload,
+                                           size_t payload_len,
+                                           void **staged_out)
+{
+    QemuCrucibleFaultVmstateReader reader = {
+        .data = payload,
+        .length = payload_len,
+    };
+    CrucibleMemoryVmstate *state = g_new0(CrucibleMemoryVmstate, 1);
+    g_autoptr(GHashTable) seen = g_hash_table_new(
+        g_direct_hash, g_direct_equal);
+    g_autoptr(GHashTable) ledger_values = g_hash_table_new_full(
+        g_str_hash, g_str_equal, g_free, g_free);
+    uint8_t magic[8];
+    uint32_t rule_count, retry_count;
+    int status = -EINVAL;
+
+    state->ledgers = g_array_new(
+        false, false, sizeof(CrucibleMemoryVmstateLedger));
+    state->service_ledgers = g_hash_table_new_full(
+        g_str_hash, g_str_equal, NULL, node_memory_service_ledger_free);
+    state->retry_states = g_hash_table_new_full(
+        node_memory_retry_key_hash, node_memory_retry_key_equal,
+        g_free, g_free);
+    if (!qemu_crucible_fault_vmstate_get_bytes(&reader, magic, 8) ||
+        memcmp(magic, "CRUCMVS3", 8) != 0 ||
+        !qemu_crucible_fault_vmstate_get_u32(&reader, &rule_count) ||
+        !qemu_crucible_fault_vmstate_get_u32(&reader, &retry_count) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            &reader, &state->access_sequence) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            &reader, &state->retention_next_tick) ||
+        rule_count > CRUCIBLE_NODE_VMSTATE_MAX_RULES ||
+        retry_count > CRUCIBLE_NODE_MEMORY_RETRY_LIMIT) {
+        goto fail;
+    }
+    for (uint32_t i = 0; i < rule_count; i++) {
+        QemuCrucibleFaultRule *rule = crucible_memory_vmstate_get_rule_id(
+            &reader);
+        CrucibleMemoryVmstateLedger ledger;
+        uint8_t exposure, scheduled, stale, translation_error;
+        uint32_t cell_count, row_count, translation_count, reserved;
+
+        if (!rule || !crucible_memory_vmstate_rule(rule) ||
+            g_hash_table_contains(seen, rule) ||
+            !qemu_crucible_fault_vmstate_get_u64(
+                &reader, &rule->last_exposure_tick) ||
+            !qemu_crucible_fault_vmstate_get_u64(
+                &reader, &rule->retention_next_tick) ||
+            !qemu_crucible_fault_vmstate_get_u8(&reader, &exposure) ||
+            !qemu_crucible_fault_vmstate_get_u8(&reader, &scheduled) ||
+            !qemu_crucible_fault_vmstate_get_u8(&reader, &stale) ||
+            !qemu_crucible_fault_vmstate_get_u8(
+                &reader, &translation_error) ||
+            !qemu_crucible_fault_vmstate_get_u64(&reader,
+                                                  &ledger.ready_tick) ||
+            !qemu_crucible_fault_vmstate_get_u32(&reader, &cell_count) ||
+            !qemu_crucible_fault_vmstate_get_u32(&reader, &row_count) ||
+            !qemu_crucible_fault_vmstate_get_u32(
+                &reader, &translation_count) ||
+            !qemu_crucible_fault_vmstate_get_u32(&reader, &reserved) ||
+            !qemu_crucible_fault_vmstate_get_bytes(
+                &reader, rule->translation_hash, 32) || exposure > 1 ||
+            scheduled > 1 || stale > 1 || translation_error > 1 ||
+            reserved != 0 || cell_count > CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT ||
+            row_count > CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT ||
+            translation_count > CRUCIBLE_NODE_MEMORY_MATCH_LIMIT ||
+            (rule->command_kind != CRUCIBLE_FAULT_COMMAND_MEMORY_SERVICE &&
+             ledger.ready_tick != 0)) {
+            qemu_crucible_fault_rule_unref(rule);
+            goto fail;
+        }
+        if (rule->command_kind == CRUCIBLE_FAULT_COMMAND_MEMORY_SERVICE) {
+            g_autofree char *ledger_key = node_memory_service_ledger_key(rule);
+            uint64_t *existing = ledger_key ?
+                g_hash_table_lookup(ledger_values, ledger_key) : NULL;
+            CrucibleMemoryServiceLedger *prepared_ledger = ledger_key ?
+                g_hash_table_lookup(state->service_ledgers, ledger_key) :
+                NULL;
+
+            if (!ledger_key || (existing && *existing != ledger.ready_tick)) {
+                qemu_crucible_fault_rule_unref(rule);
+                goto fail;
+            }
+            if (!existing) {
+                uint64_t *stored = g_new(uint64_t, 1);
+
+                *stored = ledger.ready_tick;
+                g_hash_table_insert(ledger_values,
+                                    g_steal_pointer(&ledger_key), stored);
+            }
+            if (!prepared_ledger) {
+                prepared_ledger = g_new0(CrucibleMemoryServiceLedger, 1);
+                prepared_ledger->key = node_memory_service_ledger_key(rule);
+                g_assert(prepared_ledger->key);
+                g_hash_table_insert(state->service_ledgers,
+                                    prepared_ledger->key, prepared_ledger);
+            }
+            g_assert(prepared_ledger->references != UINT32_MAX);
+            prepared_ledger->references++;
+            prepared_ledger->ready_tick = ledger.ready_tick;
+            ledger.prepared_ledger = prepared_ledger;
+        }
+        g_hash_table_add(seen, rule);
+        rule->exposure_initialized = exposure;
+        rule->retention_scheduled = scheduled;
+        rule->translation_stale = stale;
+        rule->translation_error_reported = translation_error;
+        g_clear_pointer(&rule->retention_cells, g_hash_table_unref);
+        g_clear_pointer(&rule->row_counters, g_hash_table_unref);
+        g_clear_pointer(&rule->translations, g_array_unref);
+        if (cell_count != 0) {
+            rule->retention_cells = g_hash_table_new_full(
+                g_int64_hash, g_int64_equal, g_free, g_free);
+        }
+        uint64_t previous_offset = 0;
+        for (uint32_t cell_index = 0; cell_index < cell_count; cell_index++) {
+            uint64_t *offset = g_new(uint64_t, 1);
+            CrucibleRetentionCell *cell = g_new0(CrucibleRetentionCell, 1);
+
+            if (!qemu_crucible_fault_vmstate_get_u64(&reader, offset)) {
+                g_free(offset);
+                g_free(cell);
+                qemu_crucible_fault_rule_unref(rule);
+                goto fail;
+            }
+            for (size_t bit = 0; bit < G_N_ELEMENTS(cell->refresh_tick); bit++) {
+                if (!qemu_crucible_fault_vmstate_get_u64(
+                        &reader, &cell->refresh_tick[bit])) {
+                    g_free(offset);
+                    g_free(cell);
+                    qemu_crucible_fault_rule_unref(rule);
+                    goto fail;
+                }
+            }
+            if (!qemu_crucible_fault_vmstate_get_u8(
+                    &reader, &cell->decayed_mask) ||
+                (cell_index != 0 && *offset <= previous_offset)) {
+                g_free(offset);
+                g_free(cell);
+                qemu_crucible_fault_rule_unref(rule);
+                goto fail;
+            }
+            previous_offset = *offset;
+            g_hash_table_insert(rule->retention_cells, offset, cell);
+        }
+        if (row_count != 0) {
+            rule->row_counters = g_hash_table_new_full(
+                node_dram_coordinate_hash, node_dram_coordinate_equal,
+                g_free, g_free);
+        }
+        CrucibleMemoryVmstateRow previous_row = { 0 };
+        for (uint32_t row_index = 0; row_index < row_count; row_index++) {
+            CrucibleDramCoordinate *coordinate = g_new0(
+                CrucibleDramCoordinate, 1);
+            uint64_t *count = g_new(uint64_t, 1);
+
+            if (!qemu_crucible_fault_vmstate_get_u64(
+                    &reader, &coordinate->row) ||
+                !qemu_crucible_fault_vmstate_get_u16(
+                    &reader, &coordinate->channel) ||
+                !qemu_crucible_fault_vmstate_get_u16(
+                    &reader, &coordinate->rank) ||
+                !qemu_crucible_fault_vmstate_get_u16(
+                    &reader, &coordinate->bank) ||
+                !qemu_crucible_fault_vmstate_get_u16(
+                    &reader, &coordinate->reserved) ||
+                !qemu_crucible_fault_vmstate_get_u64(&reader, count) ||
+                coordinate->reserved != 0 ||
+                coordinate->channel >= CRUCIBLE_DRAM_CHANNELS ||
+                coordinate->rank >= CRUCIBLE_DRAM_RANKS ||
+                coordinate->bank >= CRUCIBLE_DRAM_BANKS || *count == 0) {
+                g_free(coordinate);
+                g_free(count);
+                qemu_crucible_fault_rule_unref(rule);
+                goto fail;
+            }
+            CrucibleMemoryVmstateRow current_row = {
+                .coordinate = *coordinate,
+            };
+            if (row_index != 0 && crucible_memory_vmstate_row_compare(
+                    &previous_row, &current_row) >= 0) {
+                g_free(coordinate);
+                g_free(count);
+                qemu_crucible_fault_rule_unref(rule);
+                goto fail;
+            }
+            previous_row = current_row;
+            g_hash_table_insert(rule->row_counters, coordinate, count);
+        }
+        if (translation_count != 0) {
+            rule->translations = g_array_sized_new(
+                false, false, sizeof(CrucibleNodeTranslation),
+                translation_count);
+        }
+        for (uint32_t translation_index = 0;
+             translation_index < translation_count; translation_index++) {
+            CrucibleNodeTranslation translation = { 0 };
+
+            if (!crucible_memory_vmstate_get_translation(
+                    &reader, &translation)) {
+                qemu_crucible_fault_rule_unref(rule);
+                goto fail;
+            }
+            g_array_append_val(rule->translations, translation);
+        }
+        if (!crucible_memory_vmstate_translations_valid(rule)) {
+            qemu_crucible_fault_rule_unref(rule);
+            goto fail;
+        }
+        ledger.rule = rule;
+        g_array_append_val(state->ledgers, ledger);
+    }
+    uint64_t expected_retention_next_tick = UINT64_MAX;
+    for (guint i = 0; i < state->ledgers->len; i++) {
+        const CrucibleMemoryVmstateLedger *ledger = &g_array_index(
+            state->ledgers, CrucibleMemoryVmstateLedger, i);
+        uint64_t start, length;
+        QDict *parameters;
+
+        if (node_memory_retention_rule(
+                ledger->rule, &start, &length, &parameters) &&
+            ledger->rule->retention_scheduled) {
+            expected_retention_next_tick = MIN(
+                expected_retention_next_tick,
+                ledger->rule->retention_next_tick);
+        }
+    }
+    if (state->retention_next_tick != expected_retention_next_tick) {
+        goto fail;
+    }
+    uint32_t expected_rule_count = 0;
+    for (guint i = 0; i < crucible_node_vmstate_prepared->rules->len; i++) {
+        QemuCrucibleFaultRule *rule = g_ptr_array_index(
+            crucible_node_vmstate_prepared->rules, i);
+
+        expected_rule_count += crucible_memory_vmstate_rule(rule);
+    }
+    if (g_hash_table_size(seen) != rule_count ||
+        expected_rule_count != rule_count) {
+        goto fail;
+    }
+    CrucibleMemoryVmstateRetry previous_retry = { 0 };
+    for (uint32_t i = 0; i < retry_count; i++) {
+        CrucibleMemoryVmstateRetry retry = { 0 };
+        CrucibleMemoryRetryKey *key;
+        CrucibleMemoryRetryState *retry_state;
+
+        if (!crucible_memory_vmstate_get_retry(&reader, &retry) ||
+            retry.state.last_access_sequence > state->access_sequence ||
+            (i != 0 && crucible_memory_vmstate_retry_compare(
+                &previous_retry, &retry) >= 0)) {
+            goto fail;
+        }
+        previous_retry = retry;
+        key = g_memdup2(&retry.key, sizeof(retry.key));
+        retry_state = g_memdup2(&retry.state, sizeof(retry.state));
+        g_hash_table_insert(state->retry_states, key, retry_state);
+    }
+    if (!qemu_crucible_fault_vmstate_reader_finished(&reader)) {
+        goto fail;
+    }
+    node_memory_index_build(crucible_node_vmstate_prepared->rules,
+                            &state->gpa_index, &state->gva_index,
+                            &state->binding_order, &state->access_classes);
+    *staged_out = state;
+    return 0;
+
+fail:
+    crucible_memory_vmstate_free(state);
+    return status;
+}
+
+static void crucible_memory_vmstate_commit(void *opaque)
+{
+    CrucibleMemoryVmstate *state = opaque;
+
+    g_clear_pointer(&crucible_memory_retry_states, g_hash_table_unref);
+    crucible_memory_retry_states = g_steal_pointer(&state->retry_states);
+    crucible_memory_access_sequence = state->access_sequence;
+    crucible_memory_retention_next_tick = state->retention_next_tick;
+    g_clear_pointer(&crucible_memory_service_ledgers, g_hash_table_unref);
+    crucible_memory_service_ledgers =
+        g_steal_pointer(&state->service_ledgers);
+    for (guint i = 0; i < state->ledgers->len; i++) {
+        CrucibleMemoryVmstateLedger *ledger = &g_array_index(
+            state->ledgers, CrucibleMemoryVmstateLedger, i);
+
+        ledger->rule->service_ledger = ledger->prepared_ledger;
+    }
+    node_memory_index_install(g_steal_pointer(&state->gpa_index),
+                              g_steal_pointer(&state->gva_index),
+                              g_steal_pointer(&state->binding_order),
+                              state->access_classes, first_cpu);
+    node_memory_retention_deadline_recompute();
+    crucible_memory_vmstate_free(state);
+}
+
+static const QemuCrucibleFaultVmstateSection
+crucible_memory_vmstate_section = {
+    .name = "memory",
+    .version = 4,
+    .save = crucible_memory_vmstate_save,
+    .fingerprint_projection = crucible_memory_fingerprint_projection,
+    .prepare = crucible_memory_vmstate_prepare,
+    .commit = crucible_memory_vmstate_commit,
+    .free_staged = crucible_memory_vmstate_free,
+};
+
+static void crucible_memory_access_faults_register(void)
+{
+    const uint32_t boundary =
+        1U << (CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY - 1);
+
+    qemu_mutex_init(&crucible_memory_transaction_lock);
+
+    qemu_crucible_fault_node_register(
+        CRUCIBLE_FAULT_COMMAND_MEMORY_ACCESS_TRANSFORM,
+        QEMU_PLUGIN_CRUCIBLE_FAULT_SCOPE_ALL, boundary,
+        "qemu.memory.access-transform.v1", NULL);
+    qemu_crucible_fault_node_register(
+        CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE,
+        QEMU_PLUGIN_CRUCIBLE_FAULT_SCOPE_ALL, boundary,
+        "qemu.memory.region-state.v1", NULL);
+    qemu_crucible_fault_node_register(
+        CRUCIBLE_FAULT_COMMAND_MEMORY_SERVICE,
+        QEMU_PLUGIN_CRUCIBLE_FAULT_SCOPE_ALL, boundary,
+        "qemu.memory.service.v3", NULL);
+    qemu_crucible_fault_boundary_observer_register(
+        node_memory_retention_boundary);
+    qemu_crucible_fault_boundary_observer_register(
+        node_cpu_memory_service_boundary);
+    qemu_crucible_fault_boundary_deadline_register(
+        node_memory_retention_deadline);
+    qemu_crucible_fault_boundary_deadline_register(
+        node_cpu_memory_service_deadline);
+    qemu_crucible_fault_vmstate_register(&crucible_node_vmstate_section);
+    qemu_crucible_fault_vmstate_register(&crucible_memory_vmstate_section);
+    qemu_crucible_fault_vmstate_register(
+        &crucible_cpu_memory_ticket_vmstate_section);
+}
+
+type_init(crucible_memory_access_faults_register)
diff --git a/plugins/crucible-fault-pending.inc.h b/plugins/crucible-fault-pending.inc.h
new file mode 100644
index 0000000000000000000000000000000000000000..4ac22b2f99e14b6bb2420ff5f2d0ded5ece1a395
--- /dev/null
+++ b/plugins/crucible-fault-pending.inc.h
@@ -0,0 +1,714 @@
+/*
+ * Actual pending-command and command-VMState custody
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+static struct {
+    GMutex lock;
+    pid_t process;
+    CrucibleFaultCommandVmstate *stages;
+    uint64_t stage_issuance;
+    struct {
+        const QemuCrucibleFaultHandler *handler;
+        const struct qemu_plugin_crucible_fault_command *command;
+        QemuCrucibleFaultPendingControl *control;
+        QemuThread thread;
+        bool calling;
+    } birth;
+    struct {
+        QemuCrucibleFaultPendingControl *control;
+        const struct qemu_plugin_crucible_fault_command *command;
+        const uint8_t *payload;
+        size_t payload_len;
+        QemuCrucibleFaultPendingCallback kind;
+        QemuThread thread;
+        bool calling;
+    } callback;
+    struct {
+        QemuCrucibleFaultPendingControl *control;
+        CruciblePendingFault *row;
+        CrucibleFaultCommandVmstate *stage;
+        QemuThread thread;
+        uint64_t issuance;
+        bool active;
+        bool state_returned;
+        bool payload_returned;
+        bool row_returned;
+        bool control_returned;
+        int first_status;
+        int post_status;
+    } retirement;
+    struct {
+        CrucibleFaultCommandVmstate *holder;
+        QemuThread thread;
+        uint64_t issuance;
+        bool active;
+        bool physically_returned;
+        int first_status;
+        int post_status;
+    } stage_retirement;
+} crucible_fault_pending_custody;
+
+static uint64_t crucible_fault_pending_fixed_storage_bytes(void)
+{
+    return sizeof(crucible_fault_pending_custody);
+}
+
+static bool crucible_pending_process_current(void)
+{
+    pid_t process = qatomic_load_acquire(&crucible_fault_pending_custody.process);
+
+    if (!process) {
+        process = qatomic_cmpxchg(&crucible_fault_pending_custody.process, 0, getpid());
+        if (!process) {
+            process = getpid();
+        }
+    }
+    return process == getpid();
+}
+
+/* The caller holds the actual custody mutex. Never inspect a foreign stage. */
+static bool crucible_pending_stage_current_locked(CrucibleFaultCommandVmstate *stage)
+{
+    CrucibleFaultCommandVmstate *actual;
+
+    for (actual = crucible_fault_pending_custody.stages; actual;
+         actual = actual->owner_next) {
+        if (actual == stage) {
+            return actual->holder == actual && actual->process == getpid() &&
+                actual->issuance;
+        }
+    }
+    return false;
+}
+
+static CrucibleFaultCommandVmstate *crucible_pending_stage_new(void)
+{
+    CrucibleFaultCommandVmstate *state;
+
+    if (qemu_plugin_crucible_startup_source_retained() ||
+        !crucible_pending_process_current()) {
+        return NULL;
+    }
+    g_mutex_lock(&crucible_fault_pending_custody.lock);
+    if (crucible_fault_pending_custody.stage_retirement.active ||
+        crucible_fault_pending_custody.stage_issuance == UINT64_MAX) {
+        g_mutex_unlock(&crucible_fault_pending_custody.lock);
+        return NULL;
+    }
+    crucible_fault_pending_custody.stage_issuance++;
+    state = g_new0(CrucibleFaultCommandVmstate, 1);
+    state->holder = state;
+    state->process = getpid();
+    state->issuance = crucible_fault_pending_custody.stage_issuance;
+    state->constructing = true;
+    state->busy = true;
+    qemu_thread_get_self(&state->owner_thread);
+    state->owner_next = crucible_fault_pending_custody.stages;
+    crucible_fault_pending_custody.stages = state;
+    g_mutex_unlock(&crucible_fault_pending_custody.lock);
+    return state;
+}
+
+static int crucible_pending_stage_publish(CrucibleFaultCommandVmstate *stage)
+{
+    int status = -EPERM;
+
+    if (!crucible_pending_process_current()) {
+        return status;
+    }
+    g_mutex_lock(&crucible_fault_pending_custody.lock);
+    if (crucible_pending_stage_current_locked(stage)) {
+        if (stage->constructing && stage->busy && !stage->cleaning &&
+            qemu_thread_is_self(&stage->owner_thread)) {
+            stage->constructing = false;
+            stage->prepared = true;
+            stage->busy = false;
+            status = 0;
+        }
+        stage->post_status = status;
+    }
+    g_mutex_unlock(&crucible_fault_pending_custody.lock);
+    return status;
+}
+
+static void crucible_pending_stage_outcome(CrucibleFaultCommandVmstate *stage,
+                                          int first)
+{
+    if (!crucible_pending_process_current()) {
+        return;
+    }
+    g_mutex_lock(&crucible_fault_pending_custody.lock);
+    if (crucible_pending_stage_current_locked(stage)) {
+        stage->first_status = first;
+    }
+    g_mutex_unlock(&crucible_fault_pending_custody.lock);
+}
+
+static bool crucible_pending_stage_commit_begin(CrucibleFaultCommandVmstate *stage)
+{
+    bool entered = false;
+
+    if (!crucible_pending_process_current()) {
+        return false;
+    }
+    g_mutex_lock(&crucible_fault_pending_custody.lock);
+    if (crucible_pending_stage_current_locked(stage) && stage->prepared &&
+        !stage->busy && !stage->cleaning) {
+        stage->committing = true;
+        stage->busy = true;
+        qemu_thread_get_self(&stage->owner_thread);
+        entered = true;
+    }
+    g_mutex_unlock(&crucible_fault_pending_custody.lock);
+    return entered;
+}
+
+static bool crucible_pending_stage_free_begin(CrucibleFaultCommandVmstate *stage)
+{
+    bool entered = false;
+
+    if (!crucible_pending_process_current()) {
+        return false;
+    }
+    g_mutex_lock(&crucible_fault_pending_custody.lock);
+    if (crucible_pending_stage_current_locked(stage) && !stage->cleaning &&
+        (!stage->busy || ((stage->constructing || stage->committing) &&
+                         qemu_thread_is_self(&stage->owner_thread)))) {
+        stage->cleaning = true;
+        stage->busy = true;
+        qemu_thread_get_self(&stage->owner_thread);
+        entered = true;
+    }
+    g_mutex_unlock(&crucible_fault_pending_custody.lock);
+    return entered;
+}
+
+int qemu_crucible_fault_pending_birth_current_v1(
+    const QemuCrucibleFaultHandler *handler,
+    const struct qemu_plugin_crucible_fault_command *command,
+    QemuCrucibleFaultPendingControl **out)
+{
+    int status;
+
+    if (!crucible_pending_process_current()) {
+        return -EPERM;
+    }
+    g_mutex_lock(&crucible_fault_pending_custody.lock);
+    status = crucible_fault_pending_custody.birth.calling &&
+        crucible_fault_pending_custody.birth.handler == handler &&
+        crucible_fault_pending_custody.birth.command == command &&
+        out == &crucible_fault_pending_custody.birth.control &&
+        qemu_thread_is_self(&crucible_fault_pending_custody.birth.thread) ? 0 : -EPERM;
+    g_mutex_unlock(&crucible_fault_pending_custody.lock);
+    return status;
+}
+
+int qemu_crucible_fault_pending_returning_v1(
+    QemuCrucibleFaultPendingControl *control)
+{
+    int status;
+
+    if (!crucible_pending_process_current()) {
+        return -EPERM;
+    }
+    g_mutex_lock(&crucible_fault_pending_custody.lock);
+    /* This remains valid after actual control free. No field in that freed
+     * allocation is read; the real entered destructor owns this paid cursor. */
+    status = crucible_fault_pending_custody.retirement.active &&
+        crucible_fault_pending_custody.retirement.control == control &&
+        crucible_fault_pending_custody.retirement.state_returned &&
+        crucible_fault_pending_custody.retirement.payload_returned &&
+        crucible_fault_pending_custody.retirement.row_returned &&
+        qemu_thread_is_self(&crucible_fault_pending_custody.retirement.thread) ? 0 : -EPERM;
+    g_mutex_unlock(&crucible_fault_pending_custody.lock);
+    return status;
+}
+
+static int crucible_pending_new(const QemuCrucibleFaultHandler *handler,
+    const struct qemu_plugin_crucible_fault_command *command,
+    const uint8_t *payload, size_t payload_len,
+    CrucibleFaultCommandVmstate *stage, CruciblePendingFault **out)
+{
+    QemuCrucibleFaultPendingControl *control = NULL;
+    CruciblePendingFault *pending;
+    int status = qemu_crucible_fault_node_validation_owned_v1(handler);
+
+    if (status && status != -ENOENT) {
+        return status;
+    }
+    if (!status) {
+        if (qemu_plugin_crucible_startup_source_retained()) {
+            return -ENOKEY;
+        }
+        if (!crucible_pending_process_current()) {
+            return -EPERM;
+        }
+        g_mutex_lock(&crucible_fault_pending_custody.lock);
+        if (crucible_fault_pending_custody.birth.calling ||
+            (stage && (!crucible_pending_stage_current_locked(stage) ||
+                       !stage->constructing || !stage->busy || stage->cleaning ||
+                       !qemu_thread_is_self(&stage->owner_thread) || stage->retiring_child))) {
+            g_mutex_unlock(&crucible_fault_pending_custody.lock);
+            return -EBUSY;
+        }
+        crucible_fault_pending_custody.birth.handler = handler;
+        crucible_fault_pending_custody.birth.command = command;
+        crucible_fault_pending_custody.birth.control = NULL;
+        qemu_thread_get_self(&crucible_fault_pending_custody.birth.thread);
+        crucible_fault_pending_custody.birth.calling = true;
+        g_mutex_unlock(&crucible_fault_pending_custody.lock);
+
+        status = qemu_crucible_fault_node_pending_acquire_v1(
+            handler, command, &crucible_fault_pending_custody.birth.control);
+
+        if (!crucible_pending_process_current()) {
+            return status ? status : -EPERM;
+        }
+        g_mutex_lock(&crucible_fault_pending_custody.lock);
+        control = crucible_fault_pending_custody.birth.control;
+        crucible_fault_pending_custody.birth.calling = false;
+        if (!status && !control) {
+            status = -EPROTO;
+        }
+        if (!status && stage) {
+            control->stage = stage;
+            control->stage_issuance = stage->issuance;
+            control->stage_next = stage->children;
+            stage->children = control;
+        }
+        g_mutex_unlock(&crucible_fault_pending_custody.lock);
+        if (status) {
+            return status;
+        }
+    }
+
+    pending = g_new0(CruciblePendingFault, 1);
+    pending->control = control;
+    if (control) {
+        control->row = pending;
+        control->row_attempt_returned = true;
+    }
+    memcpy(&pending->command, command, sizeof(*command));
+    pending->handler = handler;
+    pending->payload = g_memdup2(payload, payload_len);
+    pending->payload_len = payload_len;
+    if (control) {
+        control->payload = pending->payload;
+        control->payload_len = payload_len;
+        control->payload_attempt_returned = true;
+    }
+    *out = pending;
+    return 0;
+}
+
+/* No callback or queue observation substitutes for these exact row checks. */
+static bool crucible_pending_row_current_locked(CruciblePendingFault *pending)
+{
+    QemuCrucibleFaultPendingControl *control = pending->control;
+
+    return control->row == pending && control->handler == pending->handler &&
+        control->row_attempt_returned && !control->row_returned &&
+        control->payload_attempt_returned && !control->payload_returned &&
+        !memcmp(&control->command, &pending->command, sizeof(pending->command)) &&
+        control->payload == pending->payload && control->payload_len == pending->payload_len &&
+        control->handler_state == pending->handler_state && !control->post_status;
+}
+
+static int crucible_pending_callback_begin(CruciblePendingFault *pending,
+                                           QemuCrucibleFaultPendingCallback callback)
+{
+    QemuCrucibleFaultPendingControl *control = pending->control;
+    int status;
+
+    if (!control) {
+        return 0;
+    }
+    status = qemu_crucible_fault_node_pending_current_v1(control);
+    if (status || !crucible_pending_process_current()) {
+        return status ? status : -EPERM;
+    }
+    g_mutex_lock(&crucible_fault_pending_custody.lock);
+    if (crucible_fault_pending_custody.callback.calling ||
+        !crucible_pending_row_current_locked(pending) ||
+        control->callback_active || control->callback_entered[callback]) {
+        status = -EPERM;
+    } else {
+        control->callback_active = true;
+        control->callback_entered[callback] = true;
+        qemu_thread_get_self(&control->callback_thread);
+        crucible_fault_pending_custody.callback.control = control;
+        crucible_fault_pending_custody.callback.command = &pending->command;
+        crucible_fault_pending_custody.callback.payload = pending->payload;
+        crucible_fault_pending_custody.callback.payload_len = pending->payload_len;
+        crucible_fault_pending_custody.callback.kind = callback;
+        crucible_fault_pending_custody.callback.calling = true;
+        qemu_thread_get_self(&crucible_fault_pending_custody.callback.thread);
+    }
+    g_mutex_unlock(&crucible_fault_pending_custody.lock);
+    return status;
+}
+
+static int crucible_pending_callback_post(CruciblePendingFault *pending,
+    QemuCrucibleFaultPendingCallback callback, int first)
+{
+    QemuCrucibleFaultPendingControl *control = pending->control;
+    bool state_returned = false;
+    int state_post = 0;
+    int post;
+
+    if (!control) {
+        return 0;
+    }
+    if (!crucible_pending_process_current()) {
+        return -EPERM;
+    }
+    g_mutex_lock(&crucible_fault_pending_custody.lock);
+    /* Born arm output and the physical callback return precede post checks. */
+    if (callback == CRUCIBLE_PENDING_ARM) {
+        control->handler_state = pending->handler_state;
+    }
+    control->callback_returned[callback] = true;
+    control->callback_first[callback] = first;
+    if (first && !control->first_status) {
+        control->first_status = first;
+    }
+    post = crucible_fault_pending_custody.callback.calling &&
+        crucible_fault_pending_custody.callback.control == control &&
+        crucible_fault_pending_custody.callback.kind == callback &&
+        qemu_thread_is_self(&crucible_fault_pending_custody.callback.thread) &&
+        control->callback_active &&
+        qemu_thread_is_self(&control->callback_thread) &&
+        control->row == pending && control->handler == pending->handler &&
+        !memcmp(&control->command, &pending->command, sizeof(pending->command)) ? 0 : -EPERM;
+    g_mutex_unlock(&crucible_fault_pending_custody.lock);
+    if (!post) {
+        post = qemu_crucible_fault_node_pending_current_v1(control);
+    }
+    if (callback == CRUCIBLE_PENDING_FREE_STATE && pending->handler_state) {
+        state_post = qemu_crucible_fault_node_state_returned_v1(
+            control, pending->handler_state, control->state_issuance, &state_returned);
+    }
+    if (!post) {
+        post = state_post;
+    }
+    g_mutex_lock(&crucible_fault_pending_custody.lock);
+    if (state_returned) {
+        control->state_returned = true;
+        pending->handler_state = NULL;
+    }
+    control->callback_post[callback] = post;
+    if (post) {
+        control->post_status = post;
+    } else {
+        if (callback == CRUCIBLE_PENDING_FREE_STATE) {
+            control->state_returned = true;
+            pending->handler_state = NULL;
+        }
+        control->callback_active = false;
+        crucible_fault_pending_custody.callback.calling = false;
+    }
+    g_mutex_unlock(&crucible_fault_pending_custody.lock);
+    return post;
+}
+
+int qemu_crucible_fault_pending_callback_current_v1(
+    QemuCrucibleFaultPendingControl *control,
+    const struct qemu_plugin_crucible_fault_command *command,
+    const uint8_t *payload, size_t payload_len,
+    QemuCrucibleFaultPendingCallback callback)
+{
+    int status = -EPERM;
+
+    if (!command || (unsigned)callback >= CRUCIBLE_PENDING_CALLBACKS ||
+        !crucible_pending_process_current()) {
+        return status;
+    }
+    g_mutex_lock(&crucible_fault_pending_custody.lock);
+    if (crucible_fault_pending_custody.callback.calling &&
+        crucible_fault_pending_custody.callback.control == control &&
+        crucible_fault_pending_custody.callback.command == command &&
+        crucible_fault_pending_custody.callback.payload == payload &&
+        crucible_fault_pending_custody.callback.payload_len == payload_len &&
+        crucible_fault_pending_custody.callback.kind == callback &&
+        qemu_thread_is_self(&crucible_fault_pending_custody.callback.thread) &&
+        control->callback_active && control->callback_entered[callback] &&
+        !control->callback_returned[callback] && !control->post_status) {
+        status = 0;
+    }
+    g_mutex_unlock(&crucible_fault_pending_custody.lock);
+    return status;
+}
+
+int qemu_crucible_fault_pending_state_returning_v1(
+    QemuCrucibleFaultPendingControl *control, const void *state,
+    uint64_t issuance)
+{
+    int status = -EPERM;
+
+    if (!crucible_pending_process_current()) {
+        return status;
+    }
+    g_mutex_lock(&crucible_fault_pending_custody.lock);
+    if (crucible_fault_pending_custody.callback.calling &&
+        crucible_fault_pending_custody.callback.control == control &&
+        crucible_fault_pending_custody.callback.kind == CRUCIBLE_PENDING_FREE_STATE &&
+        qemu_thread_is_self(&crucible_fault_pending_custody.callback.thread) &&
+        control->callback_active && control->callback_returned[CRUCIBLE_PENDING_FREE_STATE] &&
+        control->handler_state == state && control->state_issuance == issuance) {
+        status = 0;
+    }
+    g_mutex_unlock(&crucible_fault_pending_custody.lock);
+    return status;
+}
+
+static int crucible_pending_locate(CruciblePendingFault *pending,
+                                   QemuCrucibleFaultPendingLocation location)
+{
+    QemuCrucibleFaultPendingControl *control = pending->control;
+    int status;
+
+    if (!control) {
+        return 0;
+    }
+    status = qemu_crucible_fault_node_pending_current_v1(control);
+    if (status || !crucible_pending_process_current()) {
+        return status ? status : -EPERM;
+    }
+    g_mutex_lock(&crucible_fault_pending_custody.lock);
+    if (!crucible_pending_row_current_locked(pending) || control->callback_active) {
+        status = -EPERM;
+    } else {
+        control->location = location;
+    }
+    g_mutex_unlock(&crucible_fault_pending_custody.lock);
+    return status;
+}
+
+static int crucible_pending_arm(CruciblePendingFault *pending)
+{
+    int first;
+    int post;
+
+    if (!pending->handler->arm) {
+        return 0;
+    }
+    post = crucible_pending_callback_begin(pending, CRUCIBLE_PENDING_ARM);
+    if (post) {
+        return post;
+    }
+    first = pending->handler->arm(&pending->command, pending->payload,
+                                  pending->payload_len, &pending->handler_state);
+    post = crucible_pending_callback_post(pending, CRUCIBLE_PENDING_ARM, first);
+    return first ? first : post;
+}
+
+static int crucible_pending_destroy(CruciblePendingFault *pending)
+{
+    QemuCrucibleFaultPendingControl *control = pending->control;
+    CrucibleFaultCommandVmstate *stage = NULL;
+    bool control_returned = false;
+    int status;
+
+    if (!control) {
+        if (pending->handler->free_state) {
+            pending->handler->free_state(pending->handler_state);
+        }
+        g_free(pending->payload);
+        g_free(pending);
+        return 0;
+    }
+    status = qemu_crucible_fault_node_pending_current_v1(control);
+    if (status || !crucible_pending_process_current()) {
+        return status ? status : -EPERM;
+    }
+    g_mutex_lock(&crucible_fault_pending_custody.lock);
+    if (!crucible_pending_row_current_locked(pending) || control->callback_active ||
+        crucible_fault_pending_custody.retirement.active) {
+        g_mutex_unlock(&crucible_fault_pending_custody.lock);
+        return -EPERM;
+    }
+    stage = control->stage;
+    if (stage && (!crucible_pending_stage_current_locked(stage) ||
+                  stage->issuance != control->stage_issuance || stage->retiring_child)) {
+        g_mutex_unlock(&crucible_fault_pending_custody.lock);
+        return -EPERM;
+    }
+    crucible_fault_pending_custody.retirement.control = control;
+    crucible_fault_pending_custody.retirement.row = pending;
+    crucible_fault_pending_custody.retirement.stage = stage;
+    crucible_fault_pending_custody.retirement.issuance = control->issuance;
+    crucible_fault_pending_custody.retirement.active = true;
+    crucible_fault_pending_custody.retirement.state_returned = false;
+    crucible_fault_pending_custody.retirement.payload_returned = false;
+    crucible_fault_pending_custody.retirement.row_returned = false;
+    crucible_fault_pending_custody.retirement.control_returned = false;
+    crucible_fault_pending_custody.retirement.first_status = control->first_status;
+    crucible_fault_pending_custody.retirement.post_status = 0;
+    qemu_thread_get_self(&crucible_fault_pending_custody.retirement.thread);
+    control->location = CRUCIBLE_PENDING_RETIRING;
+    g_mutex_unlock(&crucible_fault_pending_custody.lock);
+
+    if (pending->handler->free_state) {
+        status = crucible_pending_callback_begin(pending, CRUCIBLE_PENDING_FREE_STATE);
+        if (status) {
+            return status;
+        }
+        pending->handler->free_state(pending->handler_state);
+        status = crucible_pending_callback_post(pending, CRUCIBLE_PENDING_FREE_STATE, 0);
+        if (status) {
+            return status;
+        }
+    } else if (pending->handler_state) {
+        return -ENOTSUP;
+    } else {
+        /* A real completed arm with no born state has no state borrower. */
+        control->state_returned = true;
+    }
+    g_free(pending->payload);
+    pending->payload = NULL;
+    control->payload_returned = true;
+    g_free(pending);
+    control->row_returned = true;
+
+    if (!crucible_pending_process_current()) {
+        return -EPERM;
+    }
+    g_mutex_lock(&crucible_fault_pending_custody.lock);
+    crucible_fault_pending_custody.retirement.state_returned = control->state_returned;
+    crucible_fault_pending_custody.retirement.payload_returned = true;
+    crucible_fault_pending_custody.retirement.row_returned = true;
+    if (stage) {
+        QemuCrucibleFaultPendingControl **link;
+
+        for (link = &stage->children; *link && *link != control;
+             link = &(*link)->stage_next) {
+        }
+        if (!*link) {
+            g_mutex_unlock(&crucible_fault_pending_custody.lock);
+            return -EPERM;
+        }
+        *link = control->stage_next;
+        stage->retiring_child = control;
+        stage->child_physically_returned = false;
+        control->stage = NULL;
+    }
+    g_mutex_unlock(&crucible_fault_pending_custody.lock);
+
+    status = qemu_crucible_fault_node_pending_return_v1(control, &control_returned);
+    if (!status && !control_returned) {
+        status = -EIO;
+    }
+
+    if (!crucible_pending_process_current()) {
+        return status ? status : -EPERM;
+    }
+    g_mutex_lock(&crucible_fault_pending_custody.lock);
+    /* Never inspect the freed row/control. Both real cursors retain debt on a
+     * failed post even when the corresponding physical return already occurred. */
+    crucible_fault_pending_custody.retirement.control_returned = control_returned;
+    crucible_fault_pending_custody.retirement.post_status = status;
+    if (stage && control_returned) {
+        stage->child_physically_returned = true;
+    }
+    if (!status && control_returned) {
+        if (stage) {
+            stage->retiring_child = NULL;
+        }
+        crucible_fault_pending_custody.retirement.active = false;
+    }
+    g_mutex_unlock(&crucible_fault_pending_custody.lock);
+    return status;
+}
+
+static int crucible_pending_stage_transfer(CruciblePendingFault *pending,
+                                          CrucibleFaultCommandVmstate *stage)
+{
+    QemuCrucibleFaultPendingControl *control = pending->control;
+    QemuCrucibleFaultPendingControl **link;
+    int status;
+
+    if (!control) {
+        return 0;
+    }
+    status = qemu_crucible_fault_node_pending_current_v1(control);
+    if (status || !crucible_pending_process_current()) {
+        return status ? status : -EPERM;
+    }
+    g_mutex_lock(&crucible_fault_pending_custody.lock);
+    if (!crucible_pending_stage_current_locked(stage) || stage->retiring_child ||
+        !stage->committing || !stage->busy || stage->cleaning ||
+        !qemu_thread_is_self(&stage->owner_thread) ||
+        control->stage != stage || control->stage_issuance != stage->issuance ||
+        control->location != CRUCIBLE_PENDING_STAGED ||
+        !crucible_pending_row_current_locked(pending) || control->callback_active) {
+        g_mutex_unlock(&crucible_fault_pending_custody.lock);
+        return -EPERM;
+    }
+    for (link = &stage->children; *link && *link != control;
+         link = &(*link)->stage_next) {
+    }
+    if (!*link) {
+        g_mutex_unlock(&crucible_fault_pending_custody.lock);
+        return -EPERM;
+    }
+    /* The caller has performed the actual queue handoff under the fault lock.
+     * This exact child leaves its real staging parent only at that handoff. */
+    *link = control->stage_next;
+    control->stage = NULL;
+    control->location = CRUCIBLE_PENDING_QUEUED;
+    g_mutex_unlock(&crucible_fault_pending_custody.lock);
+    return 0;
+}
+
+static bool crucible_pending_stage_retire_begin(CrucibleFaultCommandVmstate *stage)
+{
+    CrucibleFaultCommandVmstate **link;
+
+    if (!crucible_pending_process_current()) {
+        return false;
+    }
+    g_mutex_lock(&crucible_fault_pending_custody.lock);
+    if (!crucible_pending_stage_current_locked(stage) || !stage->cleaning ||
+        !stage->busy || !qemu_thread_is_self(&stage->owner_thread) || stage->children ||
+        stage->retiring_child || crucible_fault_pending_custody.stage_retirement.active) {
+        g_mutex_unlock(&crucible_fault_pending_custody.lock);
+        return false;
+    }
+    crucible_fault_pending_custody.stage_retirement.holder = stage;
+    crucible_fault_pending_custody.stage_retirement.issuance = stage->issuance;
+    crucible_fault_pending_custody.stage_retirement.active = true;
+    crucible_fault_pending_custody.stage_retirement.physically_returned = false;
+    crucible_fault_pending_custody.stage_retirement.first_status = stage->first_status;
+    crucible_fault_pending_custody.stage_retirement.post_status = stage->post_status;
+    qemu_thread_get_self(&crucible_fault_pending_custody.stage_retirement.thread);
+    for (link = &crucible_fault_pending_custody.stages; *link != stage;
+         link = &(*link)->owner_next) {
+    }
+    *link = stage->owner_next;
+    stage->holder = NULL;
+    g_mutex_unlock(&crucible_fault_pending_custody.lock);
+    return true;
+}
+
+static void crucible_pending_stage_retire_post(
+    CrucibleFaultCommandVmstate *stage, uint64_t issuance)
+{
+    if (!crucible_pending_process_current()) {
+        return;
+    }
+    g_mutex_lock(&crucible_fault_pending_custody.lock);
+    if (!crucible_fault_pending_custody.stage_retirement.active ||
+        crucible_fault_pending_custody.stage_retirement.holder != stage ||
+        crucible_fault_pending_custody.stage_retirement.issuance != issuance) {
+        g_mutex_unlock(&crucible_fault_pending_custody.lock);
+        return;
+    }
+    crucible_fault_pending_custody.stage_retirement.physically_returned = true;
+    if (qemu_thread_is_self(&crucible_fault_pending_custody.stage_retirement.thread)) {
+        crucible_fault_pending_custody.stage_retirement.holder = NULL;
+        crucible_fault_pending_custody.stage_retirement.active = false;
+    } else {
+        crucible_fault_pending_custody.stage_retirement.post_status = -EPERM;
+    }
+    g_mutex_unlock(&crucible_fault_pending_custody.lock);
+}
diff --git a/plugins/crucible-fault-register.c b/plugins/crucible-fault-register.c
new file mode 100644
index 0000000000000000000000000000000000000000..feb483444e8a71c0c2c1170f7aeca146ee043a3d
--- /dev/null
+++ b/plugins/crucible-fault-register.c
@@ -0,0 +1,1748 @@
+/*
+ * Crucible architecture register fault targets
+ *
+ * Copyright (c) 2026 ANDYL Technologies
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "hw/core/cpu.h"
+#include "hw/core/boards.h"
+#include "qemu/main-loop.h"
+#include "qemu/crucible-register-workspace.h"
+#ifdef CONFIG_LINUX
+#include "crucible-startup-source.h"
+#endif
+#include "qemu/bswap.h"
+#include "qemu/crucible-fault.h"
+#include "qemu/error-report.h"
+#include "qemu/plugin.h"
+#include "plugins/qemu-plugin.h"
+#include "qobject/qdict.h"
+#include "qobject/qstring.h"
+
+#define CRUCIBLE_REGISTER_CAP_IMPULSE (1U << 0)
+#define CRUCIBLE_REGISTER_CAP_PERSISTENT (1U << 1)
+#define CRUCIBLE_REGISTER_CAP_VMSTATE (1U << 2)
+#define CRUCIBLE_REGISTER_SCOPE_X86_64 2
+#define CRUCIBLE_REGISTER_SCOPE_AARCH64 3
+
+typedef struct qemu_plugin_crucible_fault_register_capability
+    CrucibleRegisterCapability;
+
+typedef struct CrucibleRegisterApply {
+    CPUState *cpu;
+    const CrucibleRegisterTarget *target;
+    const CrucibleRegisterCapability *capability;
+    uint32_t first_bit;
+    uint32_t bit_count;
+    uint32_t mutation_kind;
+    const uint8_t *mask;
+    uint32_t mask_len;
+    const uint8_t *value;
+    uint32_t value_len;
+} CrucibleRegisterApply;
+
+typedef struct CrucibleRegisterVisit {
+    CPUState *cpu;
+    uint16_t model_phase;
+    uint64_t icount;
+} CrucibleRegisterVisit;
+
+static const char *crucible_cpu_model;
+static GArray *crucible_register_manifest;
+static GArray *crucible_register_targets;
+static GHashTable *crucible_register_bindings;
+static GHashTable *crucible_register_numeric_bindings;
+static uint16_t crucible_register_scope;
+static uint8_t crucible_register_architecture_identity[32];
+static bool crucible_register_architecture_bound;
+static bool crucible_register_bindings_sealed;
+static bool crucible_register_handler_registered;
+
+static bool crucible_register_mask_test(const uint8_t *mask, uint32_t bit)
+{
+    return (mask[bit / 8] & (1U << (bit % 8))) != 0;
+}
+
+static bool crucible_register_capability_valid(
+    const CrucibleCPURegisterCapability *capability)
+{
+    uint32_t known_side_effects = (1U << 0) | (1U << 1) | (1U << 2) |
+        (1U << 3) | (1U << 4) | (1U << 5);
+    uint32_t known_capabilities = CRUCIBLE_REGISTER_CAP_IMPULSE |
+        CRUCIBLE_REGISTER_CAP_PERSISTENT | (1U << 2);
+    bool writable = false;
+    bool mutable = capability->capabilities &
+        (CRUCIBLE_REGISTER_CAP_IMPULSE | CRUCIBLE_REGISTER_CAP_PERSISTENT);
+
+    if (!capability->writable_mask || !capability->reserved_mask ||
+        !capability->ignored_mask || !capability->read_only_mask ||
+        capability->group == 0 ||
+        capability->side_effects & ~known_side_effects ||
+        capability->capabilities & ~known_capabilities ||
+        ((capability->capabilities & CRUCIBLE_REGISTER_CAP_PERSISTENT) != 0 &&
+         capability->model_phase_mask == 0)) {
+        return false;
+    }
+    for (uint32_t bit = 0; bit < capability->width_bits; bit++) {
+        unsigned int classes =
+            crucible_register_mask_test(capability->writable_mask, bit) +
+            crucible_register_mask_test(capability->reserved_mask, bit) +
+            crucible_register_mask_test(capability->ignored_mask, bit) +
+            crucible_register_mask_test(capability->read_only_mask, bit);
+
+        if (classes != 1) {
+            return false;
+        }
+        if (crucible_register_mask_test(capability->writable_mask, bit)) {
+            writable = true;
+        }
+    }
+    for (uint32_t bit = capability->width_bits;
+         bit < capability->mask_bytes * 8; bit++) {
+        if (crucible_register_mask_test(capability->writable_mask, bit) ||
+            crucible_register_mask_test(capability->reserved_mask, bit) ||
+            crucible_register_mask_test(capability->ignored_mask, bit) ||
+            crucible_register_mask_test(capability->read_only_mask, bit)) {
+            return false;
+        }
+    }
+    if (writable != mutable ||
+        (mutable && (capability->model_phase_mask == 0 ||
+         !(capability->capabilities & CRUCIBLE_REGISTER_CAP_VMSTATE))) ||
+        (!mutable && (capability->model_phase_mask != 0 ||
+                      capability->side_effects != 0))) {
+        return false;
+    }
+    return true;
+}
+
+#include "crucible-register-workspace.inc.h"
+#include "crucible-register-read.inc.h"
+
+static void crucible_register_manifest_clear(void)
+{
+    if (crucible_register_manifest) {
+        for (guint i = 0; i < crucible_register_manifest->len; i++) {
+            CrucibleRegisterCapability *row =
+                &g_array_index(crucible_register_manifest,
+                               CrucibleRegisterCapability, i);
+            g_free((char *)row->name);
+            g_free((uint8_t *)row->writable_mask);
+            g_free((uint8_t *)row->reserved_mask);
+            g_free((uint8_t *)row->ignored_mask);
+            g_free((uint8_t *)row->read_only_mask);
+        }
+        g_array_free(crucible_register_manifest, true);
+        crucible_register_manifest = NULL;
+    }
+    g_clear_pointer(&crucible_register_targets, g_array_unref);
+}
+
+static bool crucible_register_manifest_init(void)
+{
+    CPUState *cpu;
+    CPUClass *cc;
+    g_autoptr(GHashTable) names = NULL;
+    size_t target_count;
+
+    /* Internal lazy callers cannot borrow the selected constructor merely by
+     * finding cached rows. Its architecture payload still needs a real payer. */
+    if (qemu_plugin_crucible_startup_source_retained()) {
+        return false;
+    }
+    cpu = qemu_get_cpu(0);
+    if (crucible_register_manifest) {
+        return true;
+    }
+    if (!cpu) {
+        return false;
+    }
+    cc = CPU_GET_CLASS(cpu);
+    if (cc->crucible_register_scope != CRUCIBLE_REGISTER_SCOPE_X86_64 &&
+        cc->crucible_register_scope != CRUCIBLE_REGISTER_SCOPE_AARCH64) {
+        return false;
+    }
+    crucible_register_scope = cc->crucible_register_scope;
+    if (!cc->crucible_register_count || !cc->crucible_register_describe ||
+        !cc->crucible_register_read ||
+        !cc->crucible_register_validate_write ||
+        !cc->crucible_register_write) {
+        return false;
+    }
+    g_free((char *)crucible_cpu_model);
+    crucible_cpu_model = g_strdup(object_get_typename(OBJECT(cpu)));
+    target_count = cc->crucible_register_count(cpu);
+    names = g_hash_table_new_full(g_str_hash, g_str_equal, g_free, NULL);
+    if (target_count == 0 || target_count > 4096 || !names) {
+        return false;
+    }
+    crucible_register_manifest = g_array_sized_new(
+        false, true,
+        sizeof(CrucibleRegisterCapability),
+        target_count);
+    crucible_register_targets = g_array_sized_new(
+        false, true, sizeof(CrucibleRegisterTarget), target_count);
+    for (size_t index = 0; index < target_count; index++) {
+        CrucibleRegisterCapability row = { 0 };
+        CrucibleRegisterTarget target = { 0 };
+        CrucibleCPURegisterCapability architecture = { 0 };
+
+        if (!cc->crucible_register_describe(cpu, index, &architecture) ||
+            architecture.numeric_id == 0 || !architecture.name ||
+            strlen(architecture.name) > 96 || architecture.width_bits == 0 ||
+            architecture.width_bits > 65536 || architecture.mask_bytes !=
+                DIV_ROUND_UP(architecture.width_bits, 8) ||
+            !crucible_register_capability_valid(&architecture) ||
+            g_hash_table_contains(names, architecture.name)) {
+            g_free(architecture.name);
+            g_free(architecture.writable_mask);
+            g_free(architecture.reserved_mask);
+            g_free(architecture.ignored_mask);
+            g_free(architecture.read_only_mask);
+            goto fail;
+        }
+        if (architecture.numeric_id != index + 1 ||
+            (index > 0 && architecture.numeric_id <=
+                g_array_index(crucible_register_targets,
+                              CrucibleRegisterTarget, index - 1).numeric_id)) {
+            g_free(architecture.name);
+            g_free(architecture.writable_mask);
+            g_free(architecture.reserved_mask);
+            g_free(architecture.ignored_mask);
+            g_free(architecture.read_only_mask);
+            goto fail;
+        }
+        g_hash_table_add(names, g_strdup(architecture.name));
+        target.numeric_id = architecture.numeric_id;
+        target.width_bits = architecture.width_bits;
+        row.numeric_id = target.numeric_id;
+        row.width_bits = target.width_bits;
+        row.group = architecture.group;
+        row.model_phase_mask = architecture.model_phase_mask;
+        row.side_effects = architecture.side_effects;
+        row.capabilities = architecture.capabilities;
+        row.name = architecture.name;
+        row.writable_mask = architecture.writable_mask;
+        row.reserved_mask = architecture.reserved_mask;
+        row.ignored_mask = architecture.ignored_mask;
+        row.read_only_mask = architecture.read_only_mask;
+        row.mask_bytes = architecture.mask_bytes;
+        g_array_append_val(crucible_register_manifest, row);
+        g_array_append_val(crucible_register_targets, target);
+    }
+    if (crucible_register_manifest->len == 0) {
+        goto fail;
+    }
+    return true;
+
+fail:
+    crucible_register_manifest_clear();
+    return false;
+}
+
+static size_t crucible_fault_register_manifest_body(
+    CrucibleRegisterCapability *out,
+    size_t capacity, uint16_t *architecture, const char **cpu_model)
+{
+    if (!architecture || !cpu_model || !crucible_register_manifest_init()) {
+        return 0;
+    }
+    *architecture = crucible_register_scope;
+    *cpu_model = crucible_cpu_model;
+    if (out && capacity >= crucible_register_manifest->len) {
+        memcpy(out, crucible_register_manifest->data,
+               crucible_register_manifest->len * sizeof(*out));
+    }
+    return crucible_register_manifest->len;
+}
+
+size_t qemu_plugin_crucible_fault_register_manifest(
+    CrucibleRegisterCapability *out,
+    size_t capacity, uint16_t *architecture, const char **cpu_model)
+{
+    int status = qemu_plugin_crucible_initial_cpu_sdk_begin_v1();
+
+    if (status) {
+        return 0;
+    }
+    if (qemu_plugin_crucible_startup_source_retained()) {
+        status = crucible_register_initial_manifest_attempt(
+            out, capacity, architecture, cpu_model);
+        status = qemu_plugin_crucible_initial_cpu_sdk_post_v1(status);
+        if (status) {
+            return 0;
+        }
+        /* The actual mapping remains retained after scoped physical return.
+         * Publish only after both independent posts and loan closure. */
+        *architecture = crucible_register_workspace.manifest.scope;
+        *cpu_model = crucible_register_workspace.manifest.model;
+        if (out && capacity >= crucible_register_workspace.manifest.count) {
+            memcpy(out, crucible_register_workspace.manifest.rows,
+                   crucible_register_workspace.manifest.count * sizeof(*out));
+        }
+        return crucible_register_workspace.manifest.count;
+    }
+    size_t result = crucible_fault_register_manifest_body(
+        out, capacity, architecture, cpu_model);
+
+    status = qemu_plugin_crucible_initial_cpu_sdk_post_v1(0);
+    return status ? 0 : result;
+}
+
+static void crucible_register_observed_capability_clear(
+    CrucibleCPURegisterCapability *capability)
+{
+    g_free(capability->name);
+    g_free(capability->writable_mask);
+    g_free(capability->reserved_mask);
+    g_free(capability->ignored_mask);
+    g_free(capability->read_only_mask);
+}
+
+static bool crucible_register_cpu_row_matches_manifest(
+    CPUState *cpu, size_t index)
+{
+    CPUClass *cc = CPU_GET_CLASS(cpu);
+    const CrucibleRegisterCapability *expected = &g_array_index(
+        crucible_register_manifest, CrucibleRegisterCapability, index);
+    CrucibleCPURegisterCapability observed = { 0 };
+    bool matches = false;
+
+    matches = cc->crucible_register_describe(
+            cpu, index, &observed) &&
+        crucible_register_capability_valid(&observed) &&
+        observed.numeric_id == expected->numeric_id &&
+        observed.width_bits == expected->width_bits &&
+        observed.group == expected->group &&
+        observed.model_phase_mask == expected->model_phase_mask &&
+        observed.side_effects == expected->side_effects &&
+        observed.capabilities == expected->capabilities &&
+        observed.mask_bytes == expected->mask_bytes && observed.name &&
+        strcmp(observed.name, expected->name) == 0 &&
+        memcmp(observed.writable_mask, expected->writable_mask,
+               expected->mask_bytes) == 0 &&
+        memcmp(observed.reserved_mask, expected->reserved_mask,
+               expected->mask_bytes) == 0 &&
+        memcmp(observed.ignored_mask, expected->ignored_mask,
+               expected->mask_bytes) == 0 &&
+        memcmp(observed.read_only_mask, expected->read_only_mask,
+               expected->mask_bytes) == 0;
+    crucible_register_observed_capability_clear(&observed);
+    return matches;
+}
+
+static bool crucible_register_cpu_matches_manifest(CPUState *cpu)
+{
+    CPUClass *cc;
+
+    if (!cpu || !crucible_register_manifest) {
+        return false;
+    }
+    cc = CPU_GET_CLASS(cpu);
+    if (cc->crucible_register_scope != crucible_register_scope ||
+        !cc->crucible_register_count || !cc->crucible_register_describe ||
+        !cc->crucible_register_read ||
+        !cc->crucible_register_validate_write ||
+        !cc->crucible_register_write ||
+        cc->crucible_register_count(cpu) != crucible_register_manifest->len ||
+        strcmp(object_get_typename(OBJECT(cpu)), crucible_cpu_model) != 0) {
+        return false;
+    }
+    for (guint index = 0; index < crucible_register_manifest->len; index++) {
+        if (!crucible_register_cpu_row_matches_manifest(cpu, index)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool crucible_register_all_cpus_match_manifest(void)
+{
+    CPUState *cpu;
+    bool found = false;
+
+    CPU_FOREACH(cpu) {
+        found = true;
+        if (!crucible_register_cpu_matches_manifest(cpu)) {
+            return false;
+        }
+    }
+    return found;
+}
+
+int qemu_plugin_crucible_fault_register_read(unsigned int vcpu_index,
+                                             uint32_t numeric_id,
+                                             uint8_t *out_value,
+                                             size_t out_value_capacity,
+                                             size_t *out_value_len)
+{
+    const CrucibleRegisterCapability *capability;
+    CPUState *cpu = qemu_get_cpu(vcpu_index);
+    CPUClass *cc;
+    size_t bytes;
+
+    if (!out_value_len || (!out_value && out_value_capacity != 0) || !cpu ||
+        numeric_id == 0 || !crucible_register_manifest_init() ||
+        numeric_id > crucible_register_manifest->len) {
+        return -EINVAL;
+    }
+    capability = &g_array_index(crucible_register_manifest,
+                                CrucibleRegisterCapability,
+                                numeric_id - 1);
+    if (capability->numeric_id != numeric_id ||
+        !crucible_register_all_cpus_match_manifest()) {
+        return -EINVAL;
+    }
+    bytes = DIV_ROUND_UP(capability->width_bits, 8);
+    *out_value_len = bytes;
+    if (!out_value || out_value_capacity < bytes) {
+        return -ENOSPC;
+    }
+    if (!qemu_plugin_crucible_single_threaded_rr() || !current_cpu ||
+        current_cpu != cpu ||
+        qemu_crucible_internal_rr_current_vcpu() != vcpu_index) {
+        return -EPERM;
+    }
+
+    cc = CPU_GET_CLASS(cpu);
+    if (!cc->crucible_register_read ||
+        cc->crucible_register_read(cpu, numeric_id, out_value, bytes) !=
+            bytes) {
+        return -EIO;
+    }
+    return 0;
+}
+
+static int crucible_fault_register_bind_body(const uint8_t identity[32],
+                                             uint32_t numeric_id)
+{
+    GBytes *key;
+
+    if (!identity || crucible_register_bindings_sealed || numeric_id == 0 ||
+        !crucible_register_manifest_init() ||
+        numeric_id > crucible_register_manifest->len) {
+        return -EINVAL;
+    }
+    if (!crucible_register_bindings) {
+        crucible_register_bindings = g_hash_table_new_full(
+            g_bytes_hash, g_bytes_equal,
+            (GDestroyNotify)g_bytes_unref, NULL);
+        crucible_register_numeric_bindings = g_hash_table_new(
+            g_direct_hash, g_direct_equal);
+    }
+    key = g_bytes_new(identity, 32);
+    if (g_hash_table_contains(crucible_register_bindings, key) ||
+        g_hash_table_contains(crucible_register_numeric_bindings,
+                              GUINT_TO_POINTER(numeric_id))) {
+        g_bytes_unref(key);
+        return -EEXIST;
+    }
+    g_hash_table_insert(crucible_register_bindings, key,
+                        GUINT_TO_POINTER(numeric_id));
+    g_hash_table_insert(crucible_register_numeric_bindings,
+                        GUINT_TO_POINTER(numeric_id), key);
+    return 0;
+}
+
+int qemu_plugin_crucible_fault_register_bind(const uint8_t identity[32],
+                                             uint32_t numeric_id)
+{
+    int status = qemu_plugin_crucible_initial_cpu_sdk_begin_v1();
+
+    if (status) {
+        return status;
+    }
+    int result = crucible_fault_register_bind_body(identity, numeric_id);
+
+    status = qemu_plugin_crucible_initial_cpu_sdk_post_v1(result);
+    return status ? status : result;
+}
+
+static int crucible_fault_register_bind_architecture_body(
+    const uint8_t identity[32])
+{
+    uint8_t zero[32] = { 0 };
+
+    if (!identity || crucible_register_bindings_sealed ||
+        crucible_register_architecture_bound ||
+        memcmp(identity, zero, sizeof(zero)) == 0 ||
+        !crucible_register_manifest_init()) {
+        return -EINVAL;
+    }
+    memcpy(crucible_register_architecture_identity, identity, 32);
+    crucible_register_architecture_bound = true;
+    return 0;
+}
+
+int qemu_plugin_crucible_fault_register_bind_architecture(
+    const uint8_t identity[32])
+{
+    int status = qemu_plugin_crucible_initial_cpu_sdk_begin_v1();
+
+    if (status) {
+        return status;
+    }
+    int result = crucible_fault_register_bind_architecture_body(identity);
+
+    status = qemu_plugin_crucible_initial_cpu_sdk_post_v1(result);
+    return status ? status : result;
+}
+
+static int crucible_fault_register_bindings_seal_body(void)
+{
+    if (crucible_register_bindings_sealed ||
+        !crucible_register_manifest_init() ||
+        !crucible_register_all_cpus_match_manifest() ||
+        !crucible_register_architecture_bound ||
+        !crucible_register_bindings || !crucible_register_numeric_bindings ||
+        g_hash_table_size(crucible_register_bindings) !=
+            crucible_register_manifest->len ||
+        g_hash_table_size(crucible_register_numeric_bindings) !=
+            crucible_register_manifest->len) {
+        return -EINVAL;
+    }
+    crucible_register_bindings_sealed = true;
+    return 0;
+}
+
+int qemu_plugin_crucible_fault_register_bindings_seal(void)
+{
+    int status = qemu_plugin_crucible_initial_cpu_sdk_begin_v1();
+
+    if (status) {
+        return status;
+    }
+    int result = crucible_fault_register_bindings_seal_body();
+
+    status = qemu_plugin_crucible_initial_cpu_sdk_post_v1(result);
+    return status ? status : result;
+}
+
+static const CrucibleRegisterTarget *crucible_register_target(
+    const uint8_t identity[32],
+    const CrucibleRegisterCapability **capability)
+{
+    g_autoptr(GBytes) key = NULL;
+    gpointer binding;
+    uint32_t numeric_id;
+
+    if (!identity || !crucible_register_bindings) {
+        return NULL;
+    }
+    key = g_bytes_new_static(identity, 32);
+    binding = g_hash_table_lookup(crucible_register_bindings, key);
+    numeric_id = GPOINTER_TO_UINT(binding);
+    if (numeric_id == 0 || numeric_id > crucible_register_targets->len) {
+        return NULL;
+    }
+    *capability = &g_array_index(
+        crucible_register_manifest,
+        CrucibleRegisterCapability,
+        numeric_id - 1);
+    return &g_array_index(crucible_register_targets,
+                          CrucibleRegisterTarget, numeric_id - 1);
+}
+
+int qemu_crucible_fault_register_numeric_id(
+    const uint8_t register_identity[32], uint32_t *numeric_id)
+{
+    const CrucibleRegisterCapability *capability;
+    const CrucibleRegisterTarget *target;
+
+    if (!numeric_id) {
+        return -ENOENT;
+    }
+    target = crucible_register_target(register_identity, &capability);
+    if (!target ||
+        !(capability->capabilities & CRUCIBLE_REGISTER_CAP_IMPULSE)) {
+        return -ENOENT;
+    }
+    *numeric_id = target->numeric_id;
+    return 0;
+}
+
+bool qemu_crucible_fault_register_vmstate_identity(uint8_t identity[32])
+{
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    uint8_t scope[2];
+    gsize identity_len = 32;
+
+    if (!identity || !crucible_register_bindings_sealed ||
+        !crucible_register_architecture_bound ||
+        !crucible_register_manifest || !crucible_register_numeric_bindings ||
+        !crucible_cpu_model) {
+        return false;
+    }
+    stw_le_p(scope, crucible_register_scope);
+    g_checksum_update(checksum, (const uint8_t *)"CRUCRVS1", 8);
+    g_checksum_update(checksum, scope, sizeof(scope));
+    g_checksum_update(checksum, crucible_register_architecture_identity, 32);
+    g_checksum_update(checksum, (const uint8_t *)crucible_cpu_model,
+                      strlen(crucible_cpu_model) + 1);
+    for (guint numeric_id = 1;
+         numeric_id <= crucible_register_manifest->len; numeric_id++) {
+        GBytes *binding = g_hash_table_lookup(
+            crucible_register_numeric_bindings,
+            GUINT_TO_POINTER(numeric_id));
+        gsize binding_len;
+        const uint8_t *bytes;
+
+        if (!binding) {
+            return false;
+        }
+        bytes = g_bytes_get_data(binding, &binding_len);
+        if (binding_len != 32) {
+            return false;
+        }
+        g_checksum_update(checksum, bytes, binding_len);
+    }
+    g_checksum_get_digest(checksum, identity, &identity_len);
+    g_assert(identity_len == 32);
+    return true;
+}
+
+static bool crucible_register_field(const QemuCrucibleFaultRule *rule,
+                                    uint16_t tag, uint16_t type,
+                                    const uint8_t **data, uint32_t *length)
+{
+    return qemu_crucible_fault_rule_field(rule, tag, type, data, length);
+}
+
+static bool crucible_register_field_u32(const QemuCrucibleFaultRule *rule,
+                                        uint16_t tag, uint32_t *value)
+{
+    const uint8_t *data;
+    uint32_t length;
+
+    if (!crucible_register_field(rule, tag,
+            CRUCIBLE_NODE_FAULT_FIELD_TYPE_U32, &data, &length) ||
+        length != sizeof(*value)) {
+        return false;
+    }
+    *value = ldl_le_p(data);
+    return true;
+}
+
+static bool crucible_register_decode(const QemuCrucibleFaultRule *rule,
+                                     CrucibleRegisterApply *apply)
+{
+    const uint8_t *identity;
+    const uint8_t *architecture_identity;
+    const uint8_t *action_identity;
+    uint32_t identity_len;
+    uint32_t architecture_identity_len;
+    uint32_t action_identity_len;
+    uint32_t vcpu;
+    uint32_t target_first_bit;
+    uint32_t target_bit_count;
+    const uint8_t *present;
+    uint32_t present_len;
+
+    if (!crucible_register_bindings_sealed ||
+        !crucible_register_field_u32(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_T1, &vcpu) ||
+        !crucible_register_field(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_T2,
+            CRUCIBLE_NODE_FAULT_FIELD_TYPE_HASH,
+            &architecture_identity, &architecture_identity_len) ||
+        architecture_identity_len != 32 ||
+        !crucible_register_field(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_T3,
+            CRUCIBLE_NODE_FAULT_FIELD_TYPE_HASH,
+            &identity, &identity_len) || identity_len != 32 ||
+        !crucible_register_field_u32(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_T4, &target_first_bit) ||
+        !crucible_register_field_u32(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_T5, &target_bit_count) ||
+        !crucible_register_field(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_P1,
+            CRUCIBLE_NODE_FAULT_FIELD_TYPE_HASH,
+            &action_identity, &action_identity_len) ||
+        action_identity_len != 32 ||
+        !crucible_register_field_u32(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_P2, &apply->first_bit) ||
+        !crucible_register_field_u32(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_P3, &apply->bit_count) ||
+        !crucible_register_field_u32(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_P4, &apply->mutation_kind) ||
+        !crucible_register_field(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_P5,
+            CRUCIBLE_NODE_FAULT_FIELD_TYPE_BYTES,
+            &apply->mask, &apply->mask_len) ||
+        !crucible_register_field(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_P6,
+            CRUCIBLE_NODE_FAULT_FIELD_TYPE_BOOL,
+            &present, &present_len) || present_len != 1 ||
+        !crucible_register_field(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_P7,
+            CRUCIBLE_NODE_FAULT_FIELD_TYPE_BYTES,
+            &apply->value, &apply->value_len)) {
+        return false;
+    }
+    apply->cpu = qemu_get_cpu(vcpu);
+    apply->target = crucible_register_target(identity, &apply->capability);
+    if (!apply->cpu || !apply->target ||
+        !crucible_register_cpu_matches_manifest(apply->cpu) ||
+        memcmp(architecture_identity,
+               crucible_register_architecture_identity, 32) != 0 ||
+        memcmp(action_identity, identity, 32) != 0 ||
+        target_first_bit != apply->first_bit ||
+        target_bit_count != apply->bit_count ||
+        apply->bit_count == 0 ||
+        apply->first_bit > apply->target->width_bits ||
+        apply->bit_count > apply->target->width_bits - apply->first_bit ||
+        apply->mask_len != DIV_ROUND_UP(apply->bit_count, 8) ||
+        apply->value_len != (present[0] ? apply->mask_len : 1) ||
+        apply->mutation_kind < 1 || apply->mutation_kind > 3 ||
+        present[0] != (apply->mutation_kind != 1)) {
+        return false;
+    }
+    for (uint32_t bit = 0; bit < apply->bit_count; bit++) {
+        if (crucible_register_mask_test(apply->mask, bit) &&
+            !crucible_register_mask_test(
+                apply->capability->writable_mask,
+                apply->first_bit + bit)) {
+            return false;
+        }
+    }
+    for (uint32_t bit = apply->bit_count;
+         bit < apply->mask_len * 8; bit++) {
+        if (crucible_register_mask_test(apply->mask, bit) ||
+            (present[0] && crucible_register_mask_test(apply->value, bit))) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static void crucible_register_transform(const CrucibleRegisterApply *apply,
+                                        uint8_t *value);
+
+int qemu_crucible_fault_register_validate(const QemuCrucibleFaultRule *rule)
+{
+    CrucibleRegisterApply apply = { 0 };
+    uint16_t operation = qemu_crucible_fault_rule_operation(rule);
+
+    if (operation == CRUCIBLE_NODE_FAULT_OPERATION_REMOVE) {
+        return 0;
+    }
+
+    if (!crucible_register_decode(rule, &apply)) {
+        return -ENOENT;
+    }
+    uint16_t phase = qemu_crucible_fault_rule_model_phase(rule);
+
+    if (phase == 0 || phase > 64 ||
+        !(apply.capability->model_phase_mask & (UINT64_C(1) << (phase - 1))) ||
+        (operation == CRUCIBLE_NODE_FAULT_OPERATION_APPLY &&
+         !(apply.capability->capabilities & CRUCIBLE_REGISTER_CAP_IMPULSE)) ||
+        (operation == CRUCIBLE_NODE_FAULT_OPERATION_UPSERT &&
+         (apply.mutation_kind != 2 ||
+          !(apply.capability->capabilities &
+            CRUCIBLE_REGISTER_CAP_PERSISTENT) ||
+          !(apply.capability->model_phase_mask &
+            (UINT64_C(1) << (phase - 1)))))) {
+        return -ENOTSUP;
+    }
+    if (operation == CRUCIBLE_NODE_FAULT_OPERATION_APPLY) {
+        CPUClass *cc = CPU_GET_CLASS(apply.cpu);
+        size_t bytes = DIV_ROUND_UP(apply.target->width_bits, 8);
+        g_autofree uint8_t *desired = g_try_malloc(bytes);
+
+        if (!desired ||
+            cc->crucible_register_read(
+                apply.cpu, apply.target->numeric_id,
+                desired, bytes) != bytes) {
+            return -EIO;
+        }
+        crucible_register_transform(&apply, desired);
+        if (cc->crucible_register_validate_write(
+                apply.cpu, apply.target->numeric_id,
+                desired, bytes) != bytes) {
+            return -EINVAL;
+        }
+    }
+    return 0;
+}
+
+typedef struct CrucibleRegisterStreamSpan {
+    const void *address;
+    size_t bytes;
+} CrucibleRegisterStreamSpan;
+
+static bool crucible_register_stream_input(
+    const CrucibleRegisterStreamSpan *writes, size_t count,
+    const void *input, size_t bytes)
+{
+    for (size_t index = 0; index < count; index++) {
+        if (!crucible_register_spans_disjoint(
+                writes[index].address, writes[index].bytes, input, bytes)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool crucible_register_stream_preflight(
+    const QemuCrucibleRegisterFingerprintManifest *manifest,
+    const QemuCrucibleRegisterFingerprintCpu *cohort, size_t cpu_count,
+    const QemuCrucibleRegisterFingerprintStorage *storage,
+    const struct qemu_plugin_rr_cursor *rr,
+    uint8_t execution[32], uint8_t registers[32])
+{
+    CrucibleRegisterStreamSpan writes[10];
+    CPUState *cpu;
+    size_t actual_count = 0;
+    uint64_t row_bytes = 0;
+
+    if (!manifest || !cohort || !storage ||
+        (uintptr_t)manifest % _Alignof(*manifest) ||
+        (uintptr_t)cohort % _Alignof(*cohort) ||
+        (uintptr_t)storage % _Alignof(*storage) ||
+        !crucible_register_spans_disjoint(manifest, sizeof(*manifest), NULL, 0) ||
+        !crucible_register_spans_disjoint(storage, sizeof(*storage), NULL, 0)) {
+        return false;
+    }
+    if (!storage->scratch ||
+        (!execution && !registers) || (execution && !rr) ||
+        !bql_locked() || !cpu_count || cpu_count > UINT32_MAX ||
+        cpu_count > SIZE_MAX / sizeof(*cohort) ||
+        (rr && (uintptr_t)rr % _Alignof(*rr)) ||
+        (uintptr_t)storage->scratch % _Alignof(*storage->scratch) ||
+        !manifest->rows || !manifest->model || !manifest->count ||
+        manifest->count > 4096 ||
+        (uintptr_t)manifest->rows % _Alignof(*manifest->rows) ||
+        manifest->count > SIZE_MAX / sizeof(*manifest->rows) ||
+        storage->key_capacity > SIZE_MAX / sizeof(*storage->keys) ||
+        (storage->key_capacity &&
+         (uintptr_t)storage->keys % _Alignof(*storage->keys))) {
+        return false;
+    }
+    writes[0] = (CrucibleRegisterStreamSpan) {
+        storage->scratch, sizeof(*storage->scratch),
+    };
+    writes[1] = (CrucibleRegisterStreamSpan) {
+        storage->keys, storage->key_capacity * sizeof(*storage->keys),
+    };
+    writes[2] = (CrucibleRegisterStreamSpan) {
+        storage->candidate.name, storage->candidate.name_capacity,
+    };
+    writes[3] = (CrucibleRegisterStreamSpan) {
+        storage->candidate.writable_mask, storage->candidate.mask_capacity,
+    };
+    writes[4] = (CrucibleRegisterStreamSpan) {
+        storage->candidate.reserved_mask, storage->candidate.mask_capacity,
+    };
+    writes[5] = (CrucibleRegisterStreamSpan) {
+        storage->candidate.ignored_mask, storage->candidate.mask_capacity,
+    };
+    writes[6] = (CrucibleRegisterStreamSpan) {
+        storage->candidate.read_only_mask, storage->candidate.mask_capacity,
+    };
+    writes[7] = (CrucibleRegisterStreamSpan) {
+        storage->value, storage->value_capacity,
+    };
+    writes[8] = (CrucibleRegisterStreamSpan) { execution, execution ? 32 : 0 };
+    writes[9] = (CrucibleRegisterStreamSpan) { registers, registers ? 32 : 0 };
+    for (size_t index = 0; index < G_N_ELEMENTS(writes); index++) {
+        /* Even unused tail capacity must have a valid, nonwrapping extent. */
+        if (!crucible_register_spans_disjoint(
+                writes[index].address, writes[index].bytes, NULL, 0)) {
+            return false;
+        }
+        for (size_t other = index + 1; other < G_N_ELEMENTS(writes); other++) {
+            if (!crucible_register_spans_disjoint(
+                    writes[index].address, writes[index].bytes,
+                    writes[other].address, writes[other].bytes)) {
+                return false;
+            }
+        }
+    }
+#define STREAM_INPUT(address, bytes) \
+    crucible_register_stream_input(writes, G_N_ELEMENTS(writes), address, bytes)
+    if (!STREAM_INPUT(manifest, sizeof(*manifest)) ||
+        !STREAM_INPUT(cohort, cpu_count * sizeof(*cohort)) ||
+        !STREAM_INPUT(storage, sizeof(*storage)) ||
+        !STREAM_INPUT(rr, rr ? sizeof(*rr) : 0) ||
+        !STREAM_INPUT(manifest->rows, manifest->count * sizeof(*manifest->rows)) ||
+        !STREAM_INPUT(manifest->model, strlen(manifest->model) + 1)) {
+        return false;
+    }
+    for (size_t index = 0; index < manifest->count; index++) {
+        const CrucibleRegisterCapability *row = &manifest->rows[index];
+        size_t bytes = ((uint64_t)row->width_bits + 7) / 8;
+
+        if (row->numeric_id != index + 1 || !row->width_bits ||
+            row->width_bits > 65536 || row->mask_bytes != bytes || !row->name ||
+            strnlen(row->name, 97) > 96 || bytes > storage->value_capacity ||
+            !STREAM_INPUT(row->name, strlen(row->name) + 1) ||
+            !STREAM_INPUT(row->writable_mask, bytes) ||
+            !STREAM_INPUT(row->reserved_mask, bytes) ||
+            !STREAM_INPUT(row->ignored_mask, bytes) ||
+            !STREAM_INPUT(row->read_only_mask, bytes)) {
+            return false;
+        }
+        row_bytes += 16 + bytes;
+    }
+    /* Both domains and the optional coordinate fit before either hash starts. */
+    if (row_bytes > (UINT64_MAX / 8 - 65) / cpu_count ||
+        (execution && rr->current_vcpu >= cpu_count)) {
+        return false;
+    }
+    for (size_t index = 0; index < cpu_count; index++) {
+        CrucibleCPURegisterGeometry geometry;
+        CPUClass *cc;
+
+        cpu = cohort[index].cpu;
+        if (!cpu || cohort[index].instance_bytes !=
+                object_get_instance_size(OBJECT(cpu)) ||
+            !STREAM_INPUT(cpu, cohort[index].instance_bytes) ||
+            !cpu->created || !cpu->stopped || qatomic_read(&cpu->running) ||
+            cpu->cpu_index < 0 || (size_t)cpu->cpu_index >= cpu_count) {
+            return false;
+        }
+        for (size_t other = 0; other < index; other++) {
+            if (cohort[other].cpu == cpu ||
+                cohort[other].cpu->cpu_index == cpu->cpu_index) {
+                return false;
+            }
+        }
+        cc = CPU_GET_CLASS(cpu);
+        if (cc->crucible_register_scope != manifest->scope ||
+            strcmp(object_get_typename(OBJECT(cpu)), manifest->model) ||
+            !cc->crucible_register_geometry || !cc->crucible_register_keys_into ||
+            !cc->crucible_register_describe_into ||
+            !cc->crucible_register_read_into ||
+            !cc->crucible_register_geometry(cpu, &geometry) ||
+            geometry.cpu != cpu || geometry.register_count != manifest->count ||
+            geometry.key_count > storage->key_capacity ||
+            !crucible_register_buffers_fit(&storage->candidate,
+                geometry.max_name_bytes, geometry.max_mask_bytes) ||
+            geometry.max_mask_bytes > storage->value_capacity) {
+            return false;
+        }
+    }
+    CPU_FOREACH(cpu) {
+        bool found = false;
+
+        for (size_t index = 0; index < cpu_count; index++) {
+            found |= cohort[index].cpu == cpu;
+        }
+        if (!found || actual_count == cpu_count) {
+            return false;
+        }
+        actual_count++;
+    }
+#undef STREAM_INPUT
+    return actual_count == cpu_count;
+}
+
+static bool crucible_register_stream_row_matches(
+    const CrucibleRegisterCapability *expected,
+    const CrucibleCPURegisterCapability *observed)
+{
+    return crucible_register_capability_valid(observed) && observed->name &&
+        observed->numeric_id == expected->numeric_id &&
+        observed->width_bits == expected->width_bits &&
+        observed->group == expected->group &&
+        observed->model_phase_mask == expected->model_phase_mask &&
+        observed->side_effects == expected->side_effects &&
+        observed->capabilities == expected->capabilities &&
+        observed->mask_bytes == expected->mask_bytes &&
+        strcmp(observed->name, expected->name) == 0 &&
+        memcmp(observed->writable_mask, expected->writable_mask,
+               expected->mask_bytes) == 0 &&
+        memcmp(observed->reserved_mask, expected->reserved_mask,
+               expected->mask_bytes) == 0 &&
+        memcmp(observed->ignored_mask, expected->ignored_mask,
+               expected->mask_bytes) == 0 &&
+        memcmp(observed->read_only_mask, expected->read_only_mask,
+               expected->mask_bytes) == 0;
+}
+
+int qemu_crucible_fault_register_fingerprints_into_v1(
+    const QemuCrucibleRegisterFingerprintManifest *manifest,
+    const QemuCrucibleRegisterFingerprintCpu *cohort, size_t cpu_count,
+    const QemuCrucibleRegisterFingerprintStorage *storage,
+    uint64_t observed_icount, const struct qemu_plugin_rr_cursor *rr,
+    uint8_t execution[32], uint8_t registers[32])
+{
+    QemuCrucibleRegisterFingerprintScratch *scratch;
+    int status;
+
+    if (!crucible_register_stream_preflight(
+            manifest, cohort, cpu_count, storage, rr, execution, registers)) {
+        return -EINVAL;
+    }
+    scratch = storage->scratch;
+    if (execution) {
+        status = qcrypto_sha256_init(&scratch->execution);
+        if (status) {
+            return status;
+        }
+        status = qcrypto_sha256_update(&scratch->execution,
+            "crucible.register-fingerprint.v1", 33);
+        if (status) {
+            return status;
+        }
+        stq_le_p(scratch->coordinate, observed_icount);
+        stq_le_p(scratch->coordinate + 8, rr->current_vcpu);
+        stq_le_p(scratch->coordinate + 16, rr->cursor_position);
+        stq_le_p(scratch->coordinate + 24, rr->rr_switch_quantum);
+        status = qcrypto_sha256_update(
+            &scratch->execution, scratch->coordinate, 32);
+        if (status) {
+            return status;
+        }
+    }
+    if (registers) {
+        status = qcrypto_sha256_init(&scratch->registers);
+        if (status) {
+            return status;
+        }
+        status = qcrypto_sha256_update(&scratch->registers,
+            "crucible.register-state.v1", 27);
+        if (status) {
+            return status;
+        }
+    }
+    for (size_t cpu_index = 0; cpu_index < cpu_count; cpu_index++) {
+        CPUState *cpu = NULL;
+        CPUClass *cc;
+
+        /* The retained input may be unordered; no allocating sort is needed. */
+        for (size_t index = 0; index < cpu_count; index++) {
+            if ((size_t)cohort[index].cpu->cpu_index == cpu_index) {
+                cpu = cohort[index].cpu;
+                break;
+            }
+        }
+        cc = CPU_GET_CLASS(cpu);
+        if (!cc->crucible_register_geometry(cpu, &scratch->geometry) ||
+            !cc->crucible_register_keys_into(cpu, storage->keys,
+                storage->key_capacity, &scratch->keys)) {
+            return -EIO;
+        }
+        for (size_t index = 0; index < manifest->count; index++) {
+            const CrucibleRegisterCapability *row = &manifest->rows[index];
+            size_t bytes = row->mask_bytes;
+
+            if (!cc->crucible_register_describe_into(cpu, index,
+                    &scratch->geometry, &scratch->keys, &storage->candidate,
+                    &scratch->candidate) ||
+                !crucible_register_stream_row_matches(row, &scratch->candidate)) {
+                return -EIO;
+            }
+            status = crucible_register_stream_read(
+                manifest, storage, cpu, row->numeric_id,
+                &scratch->geometry, &scratch->keys, storage->value, bytes);
+            if (status) {
+                return status;
+            }
+            stl_le_p(scratch->framing, cpu->cpu_index);
+            stl_le_p(scratch->framing + 4, row->numeric_id);
+            stq_le_p(scratch->framing + 8, bytes);
+            if (execution) {
+                status = qcrypto_sha256_update(
+                    &scratch->execution, scratch->framing, 16);
+                if (status) {
+                    return status;
+                }
+                status = qcrypto_sha256_update(
+                    &scratch->execution, storage->value, bytes);
+                if (status) {
+                    return status;
+                }
+            }
+            if (registers) {
+                status = qcrypto_sha256_update(
+                    &scratch->registers, scratch->framing, 16);
+                if (status) {
+                    return status;
+                }
+                status = qcrypto_sha256_update(
+                    &scratch->registers, storage->value, bytes);
+                if (status) {
+                    return status;
+                }
+            }
+        }
+    }
+    if (execution) {
+        status = qcrypto_sha256_finalize(
+            &scratch->execution, scratch->digests[0], 32);
+        if (status) {
+            return status;
+        }
+    }
+    if (registers) {
+        status = qcrypto_sha256_finalize(
+            &scratch->registers, scratch->digests[1], 32);
+        if (status) {
+            return status;
+        }
+    }
+    if (execution) {
+        memcpy(execution, scratch->digests[0], 32);
+    }
+    if (registers) {
+        memcpy(registers, scratch->digests[1], 32);
+    }
+    return 0;
+}
+
+static void crucible_register_sha256(const uint8_t *bytes, size_t length,
+                                     uint8_t output[32])
+{
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    gsize digest_len = 32;
+
+    g_checksum_update(checksum, bytes, length);
+    g_checksum_get_digest(checksum, output, &digest_len);
+    g_assert(digest_len == 32);
+}
+
+static gint crucible_register_cpu_index_compare(gconstpointer left,
+                                                gconstpointer right)
+{
+    const CPUState *left_cpu = *(CPUState * const *)left;
+    const CPUState *right_cpu = *(CPUState * const *)right;
+
+    return (left_cpu->cpu_index > right_cpu->cpu_index) -
+           (left_cpu->cpu_index < right_cpu->cpu_index);
+}
+
+static int crucible_register_state_update(GChecksum *checksum,
+                                          GChecksum *second_checksum,
+                                          size_t *cpu_count)
+{
+    g_autoptr(GPtrArray) cpus = g_ptr_array_new();
+    CPUState *cpu;
+
+    CPU_FOREACH(cpu) {
+        if (cpu->cpu_index < 0) {
+            return -EIO;
+        }
+        g_ptr_array_add(cpus, cpu);
+    }
+    if (cpus->len == 0) {
+        return -EIO;
+    }
+    if (cpu_count) {
+        *cpu_count = cpus->len;
+    }
+    g_ptr_array_sort(cpus, crucible_register_cpu_index_compare);
+    for (guint cpu_index = 0; cpu_index < cpus->len; cpu_index++) {
+        cpu = g_ptr_array_index(cpus, cpu_index);
+        CPUClass *cc = CPU_GET_CLASS(cpu);
+
+        if ((guint)cpu->cpu_index != cpu_index ||
+            !crucible_register_cpu_matches_manifest(cpu)) {
+            return -EIO;
+        }
+        for (guint index = 0; index < crucible_register_manifest->len;
+             index++) {
+            const CrucibleRegisterCapability *row =
+                &g_array_index(crucible_register_manifest,
+                               CrucibleRegisterCapability, index);
+            size_t bytes = DIV_ROUND_UP(row->width_bits, 8);
+            g_autofree uint8_t *value = g_try_malloc(bytes);
+            uint8_t framing[16];
+
+            if (!value || cc->crucible_register_read(
+                    cpu, row->numeric_id, value, bytes) != bytes) {
+                return -EIO;
+            }
+            stl_le_p(framing, cpu->cpu_index);
+            stl_le_p(framing + 4, row->numeric_id);
+            stq_le_p(framing + 8, bytes);
+            g_checksum_update(checksum, framing, sizeof(framing));
+            g_checksum_update(checksum, value, bytes);
+            if (second_checksum) {
+                g_checksum_update(second_checksum, framing, sizeof(framing));
+                g_checksum_update(second_checksum, value, bytes);
+            }
+        }
+    }
+    return 0;
+}
+
+int qemu_crucible_fault_register_state_fingerprint(uint8_t output[32])
+{
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    gsize digest_len = 32;
+
+    if (!output || !qemu_plugin_crucible_single_threaded_rr() ||
+        !current_cpu || !crucible_register_manifest_init()) {
+        return -EPERM;
+    }
+    g_checksum_update(
+        checksum,
+        (const uint8_t *)"crucible.register-state.v1\0",
+        strlen("crucible.register-state.v1") + 1);
+    if (crucible_register_state_update(checksum, NULL, NULL) != 0) {
+        return -EIO;
+    }
+    g_checksum_get_digest(checksum, output, &digest_len);
+    return digest_len == 32 ? 0 : -EIO;
+}
+
+static int crucible_register_execution_fingerprint(
+    uint64_t icount, const struct qemu_plugin_rr_cursor *rr,
+    uint8_t output[32])
+{
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    gsize digest_len = 32;
+    size_t cpu_count;
+    uint8_t coordinate[32];
+
+    g_checksum_update(checksum,
+                      (const uint8_t *)"crucible.register-fingerprint.v1\0",
+                      strlen("crucible.register-fingerprint.v1") + 1);
+    stq_le_p(coordinate, icount);
+    stq_le_p(coordinate + 8, rr->current_vcpu);
+    stq_le_p(coordinate + 16, rr->cursor_position);
+    stq_le_p(coordinate + 24, rr->rr_switch_quantum);
+    g_checksum_update(checksum, coordinate, sizeof(coordinate));
+    if (crucible_register_state_update(checksum, NULL, &cpu_count) != 0 ||
+        rr->current_vcpu >= cpu_count) {
+        return -EIO;
+    }
+    g_checksum_get_digest(checksum, output, &digest_len);
+    return digest_len == 32 ? 0 : -EIO;
+}
+
+int qemu_crucible_fault_execution_fingerprint(
+    uint64_t observed_icount, uint8_t fingerprint[32])
+{
+    struct qemu_plugin_rr_cursor rr = { 0 };
+
+    if (!fingerprint || qemu_plugin_rr_cursor(&rr) != 0) {
+        return -EINVAL;
+    }
+    return crucible_register_execution_fingerprint(
+        observed_icount, &rr, fingerprint);
+}
+
+int qemu_crucible_fault_execution_and_register_fingerprints(
+    uint64_t observed_icount, uint8_t execution_fingerprint[32],
+    uint8_t register_fingerprint[32])
+{
+    g_autoptr(GChecksum) execution = g_checksum_new(G_CHECKSUM_SHA256);
+    g_autoptr(GChecksum) registers = g_checksum_new(G_CHECKSUM_SHA256);
+    struct qemu_plugin_rr_cursor rr = { 0 };
+    gsize execution_len = 32;
+    gsize register_len = 32;
+    size_t cpu_count;
+    uint8_t coordinate[32];
+
+    if (!execution_fingerprint || !register_fingerprint ||
+        qemu_plugin_rr_cursor(&rr) != 0) {
+        return -EINVAL;
+    }
+    g_checksum_update(
+        execution,
+        (const uint8_t *)"crucible.register-fingerprint.v1\0",
+        strlen("crucible.register-fingerprint.v1") + 1);
+    stq_le_p(coordinate, observed_icount);
+    stq_le_p(coordinate + 8, rr.current_vcpu);
+    stq_le_p(coordinate + 16, rr.cursor_position);
+    stq_le_p(coordinate + 24, rr.rr_switch_quantum);
+    g_checksum_update(execution, coordinate, sizeof(coordinate));
+    g_checksum_update(
+        registers,
+        (const uint8_t *)"crucible.register-state.v1\0",
+        strlen("crucible.register-state.v1") + 1);
+    if (crucible_register_state_update(
+            execution, registers, &cpu_count) != 0 ||
+        rr.current_vcpu >= cpu_count) {
+        return -EIO;
+    }
+    g_checksum_get_digest(
+        execution, execution_fingerprint, &execution_len);
+    g_checksum_get_digest(registers, register_fingerprint, &register_len);
+    return execution_len == 32 && register_len == 32 ? 0 : -EIO;
+}
+
+static void crucible_register_transform(const CrucibleRegisterApply *apply,
+                                        uint8_t *value)
+{
+    for (uint32_t bit = 0; bit < apply->bit_count; bit++) {
+        uint32_t target_bit = apply->first_bit + bit;
+        uint8_t target_mask = 1U << (target_bit % 8);
+        bool selected = crucible_register_mask_test(apply->mask, bit);
+        bool replacement = apply->mutation_kind != 1 &&
+            crucible_register_mask_test(apply->value, bit);
+
+        if (!selected) {
+            continue;
+        }
+        if (apply->mutation_kind == 1) {
+            value[target_bit / 8] ^= target_mask;
+        } else if (replacement) {
+            value[target_bit / 8] |= target_mask;
+        } else {
+            value[target_bit / 8] &= ~target_mask;
+        }
+    }
+}
+
+static int crucible_register_cursor(const CrucibleRegisterApply *apply,
+                                    uint16_t model_phase,
+                                    struct qemu_plugin_rr_cursor *rr)
+{
+    CPUState *next_cpu;
+
+    if (model_phase != QEMU_CRUCIBLE_MODEL_PHASE_AFTER_INSTRUCTION) {
+        return qemu_plugin_rr_cursor(rr);
+    }
+
+    rr->current_vcpu = qemu_crucible_internal_rr_current_vcpu();
+    rr->cursor_position = qemu_crucible_internal_rr_cursor_position();
+    rr->rr_switch_quantum = qemu_crucible_internal_rr_switch_quantum();
+    if (rr->current_vcpu != apply->cpu->cpu_index ||
+        rr->rr_switch_quantum == 0 ||
+        rr->cursor_position > rr->rr_switch_quantum) {
+        return -1;
+    }
+
+    /*
+     * The internal live cursor includes the instruction retired before this
+     * after-instruction callback. Canonicalize its terminal position to the
+     * following RR owner without advancing the coordinate a second time.
+     */
+    if (rr->cursor_position != rr->rr_switch_quantum) {
+        return 0;
+    }
+
+    next_cpu = CPU_NEXT(apply->cpu);
+    if (!next_cpu) {
+        next_cpu = first_cpu;
+    }
+    if (!next_cpu) {
+        return -1;
+    }
+    rr->current_vcpu = next_cpu->cpu_index;
+    rr->cursor_position = 0;
+    return 0;
+}
+
+static int crucible_register_apply(const CrucibleRegisterApply *apply,
+                                   uint64_t icount,
+                                   uint16_t model_phase,
+                                   uint8_t before_hash[32],
+                                   uint8_t after_hash[32],
+                                   GByteArray *evidence)
+{
+    g_autoptr(GByteArray) before = g_byte_array_new();
+    g_autoptr(GByteArray) after = g_byte_array_new();
+    g_autofree uint8_t *desired = NULL;
+    struct qemu_plugin_rr_cursor rr = { 0 };
+    uint8_t baseline_fingerprint[32];
+    uint8_t fingerprint[32];
+    uint8_t header[168] = { 0 };
+    uint32_t performed_side_effects = 0;
+    uint32_t rollback_side_effects = 0;
+    size_t bytes = DIV_ROUND_UP(apply->target->width_bits, 8);
+    CPUClass *cc = CPU_GET_CLASS(apply->cpu);
+    const char *failure_stage = NULL;
+    int64_t observed_tick = qemu_plugin_sim_tick_observed();
+
+    if (observed_tick < 0 ||
+        crucible_register_cursor(apply, model_phase, &rr) != 0 ||
+        (model_phase != QEMU_CRUCIBLE_MODEL_PHASE_AFTER_INSTRUCTION &&
+         rr.current_vcpu != apply->cpu->cpu_index) ||
+        rr.rr_switch_quantum == 0 ||
+        rr.cursor_position >= rr.rr_switch_quantum) {
+        error_report("Crucible register mutation lost RR cursor ownership "
+                     "for register %u at phase %u icount %" PRIu64,
+                     apply->target->numeric_id, model_phase, icount);
+        return -EXDEV;
+    }
+    g_byte_array_set_size(before, bytes);
+    g_byte_array_set_size(after, bytes);
+    if (cc->crucible_register_read(
+            apply->cpu, apply->target->numeric_id,
+            before->data, bytes) != bytes) {
+        error_report("Crucible register mutation could not read register %u",
+                     apply->target->numeric_id);
+        return -EIO;
+    }
+    desired = g_memdup2(before->data, bytes);
+    crucible_register_transform(apply, desired);
+    if (cc->crucible_register_validate_write(
+            apply->cpu, apply->target->numeric_id,
+            desired, bytes) != bytes) {
+        error_report("Crucible register mutation became invalid for register %u",
+                     apply->target->numeric_id);
+        return -EINVAL;
+    }
+    if (crucible_register_execution_fingerprint(
+            icount, &rr, baseline_fingerprint) != 0) {
+        error_report("Crucible register mutation could not fingerprint "
+                     "baseline state for register %u",
+                     apply->target->numeric_id);
+        return -EIO;
+    }
+    if (cc->crucible_register_write(
+            apply->cpu, apply->target->numeric_id, desired, bytes,
+            &performed_side_effects) != bytes) {
+        error_report("Crucible register mutation could not write register %u",
+                     apply->target->numeric_id);
+        return -EIO;
+    }
+    if (performed_side_effects != apply->capability->side_effects ||
+        cc->crucible_register_read(
+            apply->cpu, apply->target->numeric_id,
+            after->data, bytes) != bytes ||
+        memcmp(after->data, desired, bytes) != 0) {
+        failure_stage = "architectural readback";
+        goto rollback;
+    }
+    crucible_register_sha256(before->data, before->len, before_hash);
+    crucible_register_sha256(after->data, after->len, after_hash);
+    if (crucible_register_execution_fingerprint(
+            icount, &rr, fingerprint) != 0) {
+        failure_stage = "execution fingerprint";
+        goto rollback;
+    }
+    memcpy(header, "CRUCQRW2", 8);
+    stw_le_p(header + 8, 2);
+    stw_le_p(header + 10, crucible_register_scope);
+    stw_le_p(header + 12, model_phase);
+    stl_le_p(header + 16, apply->cpu->cpu_index);
+    stl_le_p(header + 20, apply->target->numeric_id);
+    stl_le_p(header + 24, apply->mutation_kind);
+    stl_le_p(header + 28, apply->capability->side_effects);
+    stl_le_p(header + 32, performed_side_effects);
+    stl_le_p(header + 36, apply->first_bit);
+    stl_le_p(header + 40, apply->bit_count);
+    stl_le_p(header + 44, before->len);
+    stl_le_p(header + 48, after->len);
+    stl_le_p(header + 52, apply->mask_len);
+    stq_le_p(header + 56, icount);
+    stq_le_p(header + 64, rr.current_vcpu);
+    stq_le_p(header + 72, rr.cursor_position);
+    stq_le_p(header + 80, rr.rr_switch_quantum);
+    memcpy(header + 88, fingerprint, sizeof(fingerprint));
+    memcpy(header + 120, baseline_fingerprint,
+           sizeof(baseline_fingerprint));
+    stl_le_p(header + 152, apply->value_len);
+    stq_le_p(header + 160, observed_tick);
+    g_byte_array_append(evidence, header, sizeof(header));
+    g_byte_array_append(evidence, before->data, before->len);
+    g_byte_array_append(evidence, after->data, after->len);
+    g_byte_array_append(evidence, apply->mask, apply->mask_len);
+    g_byte_array_append(evidence, apply->value, apply->value_len);
+    return 0;
+
+rollback:
+    error_report("Crucible register mutation failed %s for register %u",
+                 failure_stage, apply->target->numeric_id);
+    if (cc->crucible_register_write(
+            apply->cpu, apply->target->numeric_id, before->data, bytes,
+            &rollback_side_effects) != bytes ||
+        rollback_side_effects != apply->capability->side_effects ||
+        cc->crucible_register_read(
+            apply->cpu, apply->target->numeric_id,
+            after->data, bytes) != bytes ||
+        memcmp(after->data, before->data, bytes) != 0) {
+        error_report("Crucible register mutation rollback failed");
+        abort();
+    }
+    return -EIO;
+}
+
+static bool crucible_register_hex(const QObject *object, uint8_t *output,
+                                  size_t output_len)
+{
+    QString *string = qobject_to(QString, object);
+    const char *hex;
+
+    if (!string) {
+        return false;
+    }
+    hex = qstring_get_str(string);
+    if (strlen(hex) != output_len * 2) {
+        return false;
+    }
+    for (size_t i = 0; i < output_len; i++) {
+        int high = g_ascii_xdigit_value(hex[i * 2]);
+        int low = g_ascii_xdigit_value(hex[i * 2 + 1]);
+
+        if (high < 0 || low < 0) {
+            return false;
+        }
+        output[i] = (high << 4) | low;
+    }
+    return true;
+}
+
+static int crucible_register_result_decode(
+    CPUState *cpu, const uint8_t register_identity[32],
+    const QObject *mutation, uint16_t model_phase,
+    CrucibleRegisterApply *apply, uint8_t **mask_out, uint8_t **value_out)
+{
+    const CrucibleRegisterCapability *capability;
+    const CrucibleRegisterTarget *target;
+    uint8_t *mask;
+    uint8_t *value;
+    QDict *root = qobject_to(QDict, mutation);
+    QDict *parameters;
+    const char *kind;
+    size_t bytes;
+    bool mask_nonzero = false;
+
+    if (!cpu || !register_identity || !root || !apply || !mask_out ||
+        !value_out || qdict_size(root) != 2 ||
+        !crucible_register_all_cpus_match_manifest()) {
+        return -EINVAL;
+    }
+    kind = qdict_get_try_str(root, "kind");
+    parameters = qobject_to(QDict, qdict_get(root, "parameters"));
+    if (!kind || !parameters) {
+        return -EINVAL;
+    }
+    target = crucible_register_target(register_identity, &capability);
+    if (!target ||
+        !(capability->capabilities & CRUCIBLE_REGISTER_CAP_IMPULSE) ||
+        model_phase == 0 || model_phase > 64 ||
+        !(capability->model_phase_mask & (UINT64_C(1) << (model_phase - 1)))) {
+        return -EINVAL;
+    }
+    bytes = DIV_ROUND_UP(target->width_bits, 8);
+    mask = g_malloc0(bytes);
+    value = g_malloc0(bytes);
+    if (strcmp(kind, "bit_flip") == 0 && qdict_size(parameters) == 1 &&
+        crucible_register_hex(qdict_get(parameters, "mask"), mask, bytes)) {
+        apply->mutation_kind = 1;
+        apply->value_len = 1;
+    } else if (strcmp(kind, "stuck") == 0 &&
+               qdict_size(parameters) == 2 &&
+               crucible_register_hex(qdict_get(parameters, "mask"),
+                                      mask, bytes) &&
+               crucible_register_hex(qdict_get(parameters, "value"),
+                                      value, bytes)) {
+        apply->mutation_kind = 2;
+        apply->value_len = bytes;
+    } else if (strcmp(kind, "replace") == 0 &&
+               qdict_size(parameters) == 1 &&
+               crucible_register_hex(qdict_get(parameters, "value"),
+                                      value, bytes)) {
+        memset(mask, UINT8_MAX, bytes);
+        if (target->width_bits % 8 != 0) {
+            mask[bytes - 1] = (1U << (target->width_bits % 8)) - 1;
+        }
+        apply->mutation_kind = 3;
+        apply->value_len = bytes;
+    } else {
+        g_free(mask);
+        g_free(value);
+        return -EINVAL;
+    }
+    for (size_t i = 0; i < bytes; i++) {
+        mask_nonzero |= mask[i] != 0;
+    }
+    if (!mask_nonzero) {
+        g_free(mask);
+        g_free(value);
+        return -EINVAL;
+    }
+    for (uint32_t bit = 0; bit < target->width_bits; bit++) {
+        if (crucible_register_mask_test(mask, bit) &&
+            !crucible_register_mask_test(capability->writable_mask, bit)) {
+            g_free(mask);
+            g_free(value);
+            return -EINVAL;
+        }
+    }
+    apply->cpu = cpu;
+    apply->target = target;
+    apply->capability = capability;
+    apply->first_bit = 0;
+    apply->bit_count = target->width_bits;
+    apply->mask = mask;
+    apply->mask_len = bytes;
+    apply->value = value;
+    *mask_out = mask;
+    *value_out = value;
+    return 0;
+}
+
+int qemu_crucible_fault_register_result_validate(
+    CPUState *cpu, const uint8_t register_identity[32],
+    const QObject *mutation, uint16_t model_phase)
+{
+    CrucibleRegisterApply apply = { 0 };
+    g_autofree uint8_t *mask = NULL;
+    g_autofree uint8_t *value = NULL;
+
+    return crucible_register_result_decode(
+        cpu, register_identity, mutation, model_phase,
+        &apply, &mask, &value);
+}
+
+int qemu_crucible_fault_register_result_transform(
+    CPUState *cpu, const uint8_t register_identity[32],
+    const QObject *mutation, uint64_t observed_icount,
+    uint16_t model_phase, uint8_t before_hash[32],
+    uint8_t after_hash[32], GByteArray *evidence)
+{
+    CrucibleRegisterApply apply = { 0 };
+    g_autofree uint8_t *mask = NULL;
+    g_autofree uint8_t *value = NULL;
+
+    if (!before_hash || !after_hash || !evidence ||
+        crucible_register_result_decode(
+            cpu, register_identity, mutation, model_phase,
+            &apply, &mask, &value) != 0) {
+        return -EINVAL;
+    }
+    return crucible_register_apply(&apply, observed_icount, model_phase,
+                                   before_hash, after_hash, evidence);
+}
+
+static int crucible_register_impulse(
+    const QemuCrucibleFaultRule *rule, uint64_t observed_icount,
+    uint8_t before_hash[32], uint8_t after_hash[32], GByteArray *evidence,
+    uint16_t *outcome,
+    QemuCrucibleFaultEventReservation **event_reservation)
+{
+    CrucibleRegisterApply apply = { 0 };
+
+    (void)event_reservation;
+
+    if (!crucible_register_decode(rule, &apply)) {
+        return -EINVAL;
+    }
+    *outcome = CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED;
+    return crucible_register_apply(
+        &apply, observed_icount, qemu_crucible_fault_rule_model_phase(rule),
+                                   before_hash, after_hash, evidence);
+}
+
+static void crucible_register_persistent_visit(
+    const QemuCrucibleFaultRule *rule_const, void *opaque)
+{
+    QemuCrucibleFaultRule *rule = (QemuCrucibleFaultRule *)rule_const;
+    CrucibleRegisterVisit *visit = opaque;
+    CrucibleRegisterApply apply = { 0 };
+    g_autoptr(GByteArray) evidence = NULL;
+    uint8_t before_hash[32];
+    uint8_t after_hash[32];
+    uint8_t opportunity_hash[32];
+
+    if (qemu_crucible_fault_rule_model_phase(rule) != visit->model_phase ||
+        !crucible_register_decode(rule, &apply) ||
+        apply.cpu != visit->cpu ||
+        !(apply.capability->capabilities &
+          CRUCIBLE_REGISTER_CAP_PERSISTENT) ||
+        !qemu_crucible_fault_rule_occurs(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_P8)) {
+        return;
+    }
+    evidence = g_byte_array_new();
+    if (crucible_register_apply(&apply, visit->icount, visit->model_phase,
+                                before_hash, after_hash, evidence) != 0) {
+        error_report("Crucible register capability changed after admission");
+        abort();
+    }
+    crucible_register_sha256(evidence->data, evidence->len,
+                             opportunity_hash);
+    qemu_crucible_fault_rule_event(
+        rule, CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED, visit->icount,
+        opportunity_hash, before_hash, after_hash,
+        evidence->data, evidence->len);
+}
+
+bool qemu_crucible_fault_register_rules_active(void)
+{
+    return qemu_crucible_fault_rule_kind_present(
+        CRUCIBLE_FAULT_COMMAND_CPU_REGISTER_TRANSFORM);
+}
+
+bool qemu_crucible_fault_register_boundaries_active(void)
+{
+    return qemu_crucible_fault_register_rules_active() ||
+        qemu_crucible_fault_instruction_context_active() ||
+        qemu_crucible_fault_next_icount(
+            CRUCIBLE_FAULT_PHASE_BEFORE_INSTRUCTION) != UINT64_MAX ||
+        qemu_crucible_fault_next_icount(
+            CRUCIBLE_FAULT_PHASE_AFTER_INSTRUCTION) != UINT64_MAX;
+}
+
+void qemu_crucible_fault_register_instruction_boundary(
+    CPUState *cpu, uint16_t model_phase, uint64_t icount)
+{
+    CrucibleRegisterVisit visit = {
+        .cpu = cpu,
+        .model_phase = model_phase,
+        .icount = icount,
+    };
+
+    qemu_crucible_fault_dispatch_boundary(
+        model_phase == QEMU_CRUCIBLE_MODEL_PHASE_BEFORE_INSTRUCTION ?
+        CRUCIBLE_FAULT_PHASE_BEFORE_INSTRUCTION :
+        CRUCIBLE_FAULT_PHASE_AFTER_INSTRUCTION,
+        icount);
+    qemu_crucible_fault_rule_foreach(
+        CRUCIBLE_FAULT_COMMAND_CPU_REGISTER_TRANSFORM,
+        crucible_register_persistent_visit, &visit);
+    qemu_crucible_fault_instruction_boundary_exception(
+        cpu, model_phase, icount);
+}
+
+void qemu_crucible_fault_register_execution_begin(CPUState *cpu)
+{
+    g_assert(!cpu->crucible_register_instruction_active);
+    cpu->crucible_register_before_icount =
+        qemu_crucible_fault_observed_icount();
+    cpu->crucible_register_instruction_active = true;
+}
+
+void qemu_crucible_fault_register_execution_complete(CPUState *cpu)
+{
+    uint64_t after_icount;
+
+    if (!cpu->crucible_register_instruction_active) {
+        return;
+    }
+    after_icount = qemu_crucible_fault_observed_icount();
+    cpu->crucible_register_instruction_active = false;
+    if (after_icount == cpu->crucible_register_before_icount) {
+        return;
+    }
+    if (cpu->crucible_register_before_icount == UINT64_MAX ||
+        after_icount != cpu->crucible_register_before_icount + 1) {
+        error_report("Crucible register fault boundary retired more than one instruction");
+        abort();
+    }
+    qemu_crucible_fault_register_instruction_boundary(
+        cpu, QEMU_CRUCIBLE_MODEL_PHASE_AFTER_INSTRUCTION, after_icount);
+}
+
+bool qemu_crucible_fault_register_ensure_registered(void)
+{
+    const uint32_t boundary =
+        (1U << (CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY - 1)) |
+        (1U << (CRUCIBLE_FAULT_PHASE_BEFORE_INSTRUCTION - 1)) |
+        (1U << (CRUCIBLE_FAULT_PHASE_AFTER_INSTRUCTION - 1));
+    if (crucible_register_handler_registered) {
+        return true;
+    }
+    if (!crucible_register_manifest_init()) {
+        return false;
+    }
+    if (!qemu_crucible_fault_node_register(
+            CRUCIBLE_FAULT_COMMAND_CPU_REGISTER_TRANSFORM,
+            crucible_register_scope, boundary,
+            "qemu.register.mutate.v1",
+            crucible_register_impulse)) {
+        return false;
+    }
+    crucible_register_handler_registered = true;
+    return true;
+}
diff --git a/plugins/crucible-fault-registration.inc.h b/plugins/crucible-fault-registration.inc.h
new file mode 100644
index 0000000000000000000000000000000000000000..e481f87d4bae8a8886dc7ba333c12218b44c46ad
--- /dev/null
+++ b/plugins/crucible-fault-registration.inc.h
@@ -0,0 +1,958 @@
+/*
+ * Actual node producer registration owner; no selected allocation payer
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+typedef struct CrucibleNodeValidationChild {
+    struct CrucibleNodeValidationChild *holder;
+    struct qemu_plugin_crucible_fault_command command;
+    const QemuCrucibleFaultHandler *handler;
+    const uint8_t *payload;
+    size_t payload_len;
+    QemuThread thread;
+    pid_t process;
+    uint64_t issuance;
+    int first_status;
+    int post_status;
+    bool entered;
+    bool physically_returned;
+} CrucibleNodeValidationChild;
+
+typedef struct CrucibleNodeJsonJournal {
+    struct CrucibleNodeJsonJournal *next;
+    QObjectConstructionJournal *holder;
+    QObjectConstructionReceipt receipt;
+    int first_status;
+    int post_status;
+    bool returned;
+} CrucibleNodeJsonJournal;
+
+struct QemuCrucibleFaultRegistration {
+    QemuCrucibleFaultRegistration *next;
+    QemuCrucibleFaultRegistration *holder;
+    QemuCrucibleFaultImpulseFn impulse;
+    QemuThread creator;
+    pid_t process;
+    int first_status;
+    bool issuing;
+    bool attempt_returned;
+    bool registry_published;
+    bool impulse_published;
+    bool closing;
+    uint64_t child_issuance;
+    CrucibleNodeRegistrationChild *children;
+    CrucibleNodeJsonJournal *json;
+    CrucibleNodeValidationChild validation;
+    QemuCrucibleFaultPendingControl *pending;
+    uint64_t pending_issuance;
+    struct {
+        QemuCrucibleFaultPendingControl *holder;
+        uint64_t issuance;
+        int first_status;
+        int post_status;
+        bool active;
+        bool physically_returned;
+        bool state_returned;
+        bool payload_returned;
+        bool row_returned;
+        bool callback_entered[CRUCIBLE_PENDING_CALLBACKS];
+        bool callback_returned[CRUCIBLE_PENDING_CALLBACKS];
+        int callback_first[CRUCIBLE_PENDING_CALLBACKS];
+        int callback_post[CRUCIBLE_PENDING_CALLBACKS];
+    } pending_retirement;
+};
+
+typedef struct CrucibleNodeOwnedHandler {
+    QemuCrucibleFaultHandler handler;
+    QemuCrucibleFaultRegistration registration;
+} CrucibleNodeOwnedHandler;
+
+static struct {
+    GMutex lock;
+    QemuCrucibleFaultRegistration *head;
+    pid_t process;
+    struct {
+        QemuCrucibleFaultRegistration **holder;
+        QemuCrucibleFaultRegistration *owner;
+        CrucibleNodeOwnedHandler *producer;
+        CrucibleNodeRegistrationChild *child;
+        CrucibleNodeJsonJournal *json;
+        QemuThread thread;
+        uint64_t issuance;
+        uint64_t child_controls_returned;
+        uint64_t child_control_bytes_returned;
+        uint64_t producer_bytes_returned;
+        uint64_t json_controls_returned;
+        uint64_t json_payload_bytes;
+        uint64_t json_control_bytes;
+        uint64_t json_allocations_returned;
+        bool registry_removed;
+        bool impulse_removed;
+        bool physically_returned;
+        bool active;
+        int first_status;
+        int post_status;
+    } returning;
+    bool hang_retired;
+} crucible_node_registrations;
+
+uint64_t qemu_crucible_fault_node_registration_fixed_storage_bytes_v1(void)
+{
+    return sizeof(crucible_node_registrations) + node_storage_fixed_bytes() +
+        qobject_construction_fixed_bytes() +
+        qemu_crucible_fault_restore_fixed_bytes_v1();
+}
+
+/* Record only the real current process, never an issuer or allocation grant.
+ * Once set, copied registries refuse before touching an inherited mutex. */
+static bool node_registration_process_current(void)
+{
+    pid_t process = qatomic_load_acquire(&crucible_node_registrations.process);
+
+    if (!process) {
+        process = qatomic_cmpxchg(&crucible_node_registrations.process, 0, getpid());
+        if (!process) {
+            process = getpid();
+        }
+    }
+    return process == getpid();
+}
+
+/* The returned owner is usable only while holding the real producer mutex. */
+static QemuCrucibleFaultRegistration *node_validation_owner_locked(
+    const QemuCrucibleFaultHandler *handler)
+{
+    QemuCrucibleFaultRegistration *actual;
+
+    for (actual = crucible_node_registrations.head; actual; actual = actual->next) {
+        CrucibleNodeOwnedHandler *producer = container_of(
+            actual, CrucibleNodeOwnedHandler, registration);
+
+        if (&producer->handler == handler) {
+            return actual;
+        }
+    }
+    return NULL;
+}
+
+static int node_registration_child_acquire(
+    QemuCrucibleFaultRegistration *parent, unsigned kind,
+    CrucibleNodeRegistrationChild **out)
+{
+    QemuCrucibleFaultRegistration *actual;
+    CrucibleNodeRegistrationChild *child;
+
+    if (!parent) {
+        return 0;
+    }
+    if (!node_registration_process_current() || !out || *out) {
+        return -EPERM;
+    }
+    g_mutex_lock(&crucible_node_registrations.lock);
+    for (actual = crucible_node_registrations.head; actual && actual != parent;
+         actual = actual->next) {
+    }
+    if (!actual || actual->holder != actual || actual->closing) {
+        g_mutex_unlock(&crucible_node_registrations.lock);
+        return -EPERM;
+    }
+    CrucibleNodeOwnedHandler *producer = container_of(
+        actual, CrucibleNodeOwnedHandler, registration);
+
+    if (producer->handler.capability.command_kind != CRUCIBLE_FAULT_COMMAND_NODE_HANG) {
+        g_mutex_unlock(&crucible_node_registrations.lock);
+        return 0;
+    }
+    if (!actual->registry_published || !actual->impulse_published ||
+        actual->issuing || !actual->attempt_returned ||
+        actual->child_issuance == UINT64_MAX) {
+        g_mutex_unlock(&crucible_node_registrations.lock);
+        return -EBUSY;
+    }
+    child = g_new0(CrucibleNodeRegistrationChild, 1);
+    child->parent = actual;
+    child->issuance = ++actual->child_issuance;
+    child->kind = kind;
+    child->process = getpid();
+    qemu_thread_get_self(&child->thread);
+    child->next = actual->children;
+    actual->children = child;
+    *out = child;
+    g_mutex_unlock(&crucible_node_registrations.lock);
+    return 0;
+}
+
+static void node_registration_child_born(CrucibleNodeRegistrationChild *child,
+    void *allocation, const void *resource, uint64_t issuance)
+{
+    if (!child) {
+        return;
+    }
+    g_mutex_lock(&crucible_node_registrations.lock);
+    if (child->born || child->process != getpid() ||
+        !qemu_thread_is_self(&child->thread) || child->parent->closing) {
+        if (!child->post_status) {
+            child->post_status = -EPERM;
+        }
+    } else {
+        child->allocation = allocation;
+        child->resource = resource;
+        child->storage_issuance = issuance;
+        child->born = true;
+    }
+    g_mutex_unlock(&crucible_node_registrations.lock);
+}
+
+static void node_registration_child_returned(CrucibleNodeRegistrationChild *child,
+    void *allocation, uint64_t issuance, int post_status)
+{
+    if (!child) {
+        return;
+    }
+    g_mutex_lock(&crucible_node_registrations.lock);
+    if (!child->born || child->physically_returned || child->post_status ||
+        child->process != getpid() || child->allocation != allocation ||
+        child->storage_issuance != issuance) {
+        if (!child->post_status) {
+            child->post_status = -EPERM;
+        }
+    } else {
+        /* The real destructor already freed its allocation. This independent
+         * journal survives reuse of the storage kind's transient cursor. */
+        child->physically_returned = true;
+        child->post_status = post_status;
+    }
+    g_mutex_unlock(&crucible_node_registrations.lock);
+}
+
+/* The actual ordinary consumer constructor owns both this allocation and its
+ * separately retained parent child. No handler flag or decoded row issues it. */
+void *qemu_crucible_fault_rule_dependent_new_v1(
+    const QemuCrucibleFaultRule *rule, size_t extent)
+{
+    g_auto(CrucibleNodeStorageOperation) operation = node_storage_operation_begin();
+    QemuCrucibleFaultRegistration *origin;
+    CrucibleNodeRegistrationChild *child = NULL;
+    void *allocation;
+
+    if (!operation.entered || !extent || !node_storage_rule_origin(rule, &origin) ||
+        !origin || node_registration_child_acquire(
+            origin, CRUCIBLE_NODE_STORAGE_KINDS, &child) || !child) {
+        return NULL;
+    }
+    allocation = g_malloc0(extent);
+    node_registration_child_born(child, allocation, allocation, child->issuance);
+    return allocation;
+}
+
+int qemu_crucible_fault_rule_dependent_free_v1(void *allocation)
+{
+    g_auto(CrucibleNodeStorageOperation) operation = node_storage_operation_begin();
+    QemuCrucibleFaultRegistration *owner;
+    CrucibleNodeRegistrationChild *child = NULL;
+
+    if (!operation.entered || !allocation || !node_registration_process_current()) {
+        return -EPERM;
+    }
+    g_mutex_lock(&crucible_node_registrations.lock);
+    for (owner = crucible_node_registrations.head; owner; owner = owner->next) {
+        for (child = owner->children; child; child = child->next) {
+            if (child->kind == CRUCIBLE_NODE_STORAGE_KINDS &&
+                child->allocation == allocation && !child->physically_returned) {
+                break;
+            }
+        }
+        if (child) {
+            break;
+        }
+    }
+    if (!child || !child->born || child->returning || child->post_status ||
+        child->process != getpid() || !qemu_thread_is_self(&child->thread)) {
+        g_mutex_unlock(&crucible_node_registrations.lock);
+        return -EPERM;
+    }
+    child->returning = true;
+    g_mutex_unlock(&crucible_node_registrations.lock);
+
+    g_free(allocation);
+    node_registration_child_returned(child, allocation, child->issuance, 0);
+    return child->post_status;
+}
+
+static QemuCrucibleFaultRegistration *node_registration_restore_owner(uint16_t kind)
+{
+    QemuCrucibleFaultRegistration *actual = NULL;
+
+    if (kind != CRUCIBLE_FAULT_COMMAND_NODE_HANG ||
+        qemu_crucible_fault_vmstate_restore_current_v1()) {
+        return NULL;
+    }
+    g_mutex_lock(&crucible_node_registrations.lock);
+    for (actual = crucible_node_registrations.head; actual; actual = actual->next) {
+        CrucibleNodeOwnedHandler *producer = container_of(
+            actual, CrucibleNodeOwnedHandler, registration);
+
+        if (producer->handler.capability.command_kind == kind &&
+            actual->holder == actual && actual->process == getpid() &&
+            actual->attempt_returned && actual->registry_published &&
+            actual->impulse_published && !actual->closing) {
+            break;
+        }
+    }
+    g_mutex_unlock(&crucible_node_registrations.lock);
+    return actual;
+}
+
+int qemu_crucible_fault_node_validation_owned_v1(
+    const QemuCrucibleFaultHandler *handler)
+{
+    bool owned;
+
+    if (!node_registration_process_current()) {
+        return -EPERM;
+    }
+    g_mutex_lock(&crucible_node_registrations.lock);
+    owned = node_validation_owner_locked(handler) != NULL;
+    g_mutex_unlock(&crucible_node_registrations.lock);
+    return owned ? 0 : -ENOENT;
+}
+
+int qemu_crucible_fault_node_validate_v1(
+    const QemuCrucibleFaultHandler *handler,
+    const struct qemu_plugin_crucible_fault_command *command,
+    const uint8_t *payload, size_t payload_len)
+{
+    QemuCrucibleFaultRegistration *owner;
+    CrucibleNodeValidationChild *child;
+    uint64_t issuance;
+    int first;
+    int post;
+
+    if (qemu_plugin_crucible_startup_source_retained()) {
+        return -ENOKEY;
+    }
+    if (!command || (payload_len && !payload) ||
+        !node_registration_process_current()) {
+        return -EPERM;
+    }
+    post = qemu_crucible_fault_validation_current_v1(
+        handler, command, payload, payload_len);
+    if (post) {
+        return post;
+    }
+    g_mutex_lock(&crucible_node_registrations.lock);
+    owner = node_validation_owner_locked(handler);
+    if (!owner || owner->holder != owner || owner->process != getpid() ||
+        owner->issuing || owner->closing || !owner->attempt_returned ||
+        !owner->registry_published || !owner->impulse_published ||
+        !handler->validate ||
+        command->command_kind != handler->capability.command_kind ||
+        command->semantic_version != handler->capability.semantic_version) {
+        g_mutex_unlock(&crucible_node_registrations.lock);
+        return -EPERM;
+    }
+    child = &owner->validation;
+    if (child->holder || child->issuance == UINT64_MAX) {
+        g_mutex_unlock(&crucible_node_registrations.lock);
+        return -EBUSY;
+    }
+    issuance = ++child->issuance;
+    child->holder = child;
+    memcpy(&child->command, command, sizeof(*command));
+    child->handler = handler;
+    child->payload = payload;
+    child->payload_len = payload_len;
+    child->process = getpid();
+    qemu_thread_get_self(&child->thread);
+    child->first_status = 0;
+    child->post_status = 0;
+    child->entered = true;
+    child->physically_returned = false;
+    g_mutex_unlock(&crucible_node_registrations.lock);
+
+    first = handler->validate(command, payload, payload_len);
+
+    /* Save the actual call's return before independent post authentication.
+     * A nonlocal exit never reaches this journal and retains the born child. */
+    if (!node_registration_process_current()) {
+        return first ? first : -EPERM;
+    }
+    g_mutex_lock(&crucible_node_registrations.lock);
+    child->first_status = first;
+    child->physically_returned = true;
+    post = node_validation_owner_locked(handler) == owner &&
+        owner->holder == owner && owner->process == getpid() &&
+        owner->registry_published && owner->impulse_published &&
+        !owner->issuing && owner->attempt_returned &&
+        child->holder == child && child->issuance == issuance &&
+        child->entered && child->handler == handler &&
+        child->process == getpid() && qemu_thread_is_self(&child->thread) &&
+        !memcmp(&child->command, command, sizeof(*command)) &&
+        child->payload == payload && child->payload_len == payload_len ? 0 : -EPERM;
+    g_mutex_unlock(&crucible_node_registrations.lock);
+    if (!post) {
+        post = qemu_crucible_fault_validation_current_v1(
+            handler, command, payload, payload_len);
+    }
+    g_mutex_lock(&crucible_node_registrations.lock);
+    child->post_status = post;
+    if (!post) {
+        child->holder = NULL;
+    }
+    g_mutex_unlock(&crucible_node_registrations.lock);
+    return first ? first : post;
+}
+
+static QemuCrucibleFaultRegistration *node_pending_owner_locked(
+    QemuCrucibleFaultPendingControl *control)
+{
+    QemuCrucibleFaultRegistration *owner;
+
+    for (owner = crucible_node_registrations.head; owner; owner = owner->next) {
+        QemuCrucibleFaultPendingControl *actual;
+
+        for (actual = owner->pending; actual; actual = actual->next) {
+            if (actual == control) {
+                return owner;
+            }
+        }
+    }
+    return NULL;
+}
+
+int qemu_crucible_fault_node_pending_acquire_v1(
+    const QemuCrucibleFaultHandler *handler,
+    const struct qemu_plugin_crucible_fault_command *command,
+    QemuCrucibleFaultPendingControl **out)
+{
+    QemuCrucibleFaultRegistration *owner;
+    QemuCrucibleFaultPendingControl *control;
+    int post;
+
+    if (qemu_plugin_crucible_startup_source_retained()) {
+        return -ENOKEY;
+    }
+    if (!out || *out || !command || !node_registration_process_current()) {
+        return -EPERM;
+    }
+    post = qemu_crucible_fault_pending_birth_current_v1(handler, command, out);
+    if (post) {
+        return post;
+    }
+    g_mutex_lock(&crucible_node_registrations.lock);
+    owner = node_validation_owner_locked(handler);
+    if (!owner || owner->holder != owner || owner->process != getpid() ||
+        owner->issuing || owner->closing || !owner->attempt_returned ||
+        !owner->registry_published || !owner->impulse_published ||
+        owner->pending_retirement.active || owner->pending_issuance == UINT64_MAX ||
+        command->command_kind != handler->capability.command_kind ||
+        command->semantic_version != handler->capability.semantic_version) {
+        g_mutex_unlock(&crucible_node_registrations.lock);
+        return -EPERM;
+    }
+    /* Only the real unselected producer uses its ordinary allocator here.
+     * The parent's issuance is reserved before the first allocation effect. */
+    owner->pending_issuance++;
+    control = g_new0(QemuCrucibleFaultPendingControl, 1);
+    control->holder = control;
+    control->registration = owner;
+    control->handler = handler;
+    memcpy(&control->command, command, sizeof(*command));
+    control->process = getpid();
+    qemu_thread_get_self(&control->creator);
+    control->issuance = owner->pending_issuance;
+    control->location = CRUCIBLE_PENDING_CONSTRUCTING;
+    control->next = owner->pending;
+    owner->pending = control;
+    *out = control;
+    g_mutex_unlock(&crucible_node_registrations.lock);
+
+    post = qemu_crucible_fault_pending_birth_current_v1(handler, command, out);
+    g_mutex_lock(&crucible_node_registrations.lock);
+    control->post_status = post;
+    g_mutex_unlock(&crucible_node_registrations.lock);
+    return post;
+}
+
+int qemu_crucible_fault_node_pending_current_v1(
+    QemuCrucibleFaultPendingControl *control)
+{
+    QemuCrucibleFaultRegistration *owner;
+    int status = -EPERM;
+
+    if (!node_registration_process_current()) {
+        return -EPERM;
+    }
+    g_mutex_lock(&crucible_node_registrations.lock);
+    owner = node_pending_owner_locked(control);
+    if (owner && owner->holder == owner && owner->process == getpid() &&
+        control->holder == control && control->registration == owner &&
+        control->process == getpid() && control->issuance) {
+        status = 0;
+    }
+    g_mutex_unlock(&crucible_node_registrations.lock);
+    return status;
+}
+
+int qemu_crucible_fault_node_pending_callback_v1(
+    const struct qemu_plugin_crucible_fault_command *command,
+    const uint8_t *payload, size_t payload_len,
+    QemuCrucibleFaultPendingCallback callback,
+    QemuCrucibleFaultPendingControl **out)
+{
+    QemuCrucibleFaultRegistration *owner;
+    int status = -EPERM;
+
+    if (!out || *out || !command ||
+        (unsigned)callback >= CRUCIBLE_PENDING_CALLBACKS ||
+        !node_registration_process_current()) {
+        return -EPERM;
+    }
+    g_mutex_lock(&crucible_node_registrations.lock);
+    for (owner = crucible_node_registrations.head; owner; owner = owner->next) {
+        QemuCrucibleFaultPendingControl *control;
+
+        for (control = owner->pending; control; control = control->next) {
+            if (control->holder == control && control->registration == owner &&
+                owner->holder == owner && owner->process == getpid() &&
+                control->process == getpid() &&
+                !qemu_crucible_fault_pending_callback_current_v1(
+                    control, command, payload, payload_len, callback)) {
+                *out = control;
+                status = 0;
+                break;
+            }
+        }
+    }
+    g_mutex_unlock(&crucible_node_registrations.lock);
+    return status;
+}
+
+int qemu_crucible_fault_node_pending_return_v1(
+    QemuCrucibleFaultPendingControl *control, bool *physically_returned)
+{
+    QemuCrucibleFaultRegistration *owner;
+    QemuCrucibleFaultPendingControl **link;
+    int post;
+
+    if (!physically_returned || *physically_returned) {
+        return -EINVAL;
+    }
+    post = qemu_crucible_fault_node_pending_current_v1(control);
+    if (post) {
+        return post;
+    }
+    post = qemu_crucible_fault_pending_returning_v1(control);
+    if (post) {
+        return post;
+    }
+    g_mutex_lock(&crucible_node_registrations.lock);
+    owner = node_pending_owner_locked(control);
+    if (!owner || owner->pending_retirement.active ||
+        !control->row_attempt_returned || !control->row_returned ||
+        !control->payload_attempt_returned || !control->payload_returned ||
+        !control->state_returned || control->callback_active || control->post_status) {
+        g_mutex_unlock(&crucible_node_registrations.lock);
+        return -EBUSY;
+    }
+    for (size_t callback = 0; callback < CRUCIBLE_PENDING_CALLBACKS; callback++) {
+        if (control->callback_entered[callback] && !control->callback_returned[callback]) {
+            g_mutex_unlock(&crucible_node_registrations.lock);
+            return -EPERM;
+        }
+    }
+    owner->pending_retirement.holder = control;
+    owner->pending_retirement.issuance = control->issuance;
+    owner->pending_retirement.first_status = control->first_status;
+    owner->pending_retirement.post_status = control->post_status;
+    owner->pending_retirement.active = true;
+    owner->pending_retirement.physically_returned = false;
+    owner->pending_retirement.state_returned = control->state_returned;
+    owner->pending_retirement.payload_returned = control->payload_returned;
+    owner->pending_retirement.row_returned = control->row_returned;
+    memcpy(owner->pending_retirement.callback_entered, control->callback_entered,
+           sizeof(control->callback_entered));
+    memcpy(owner->pending_retirement.callback_returned, control->callback_returned,
+           sizeof(control->callback_returned));
+    memcpy(owner->pending_retirement.callback_first, control->callback_first,
+           sizeof(control->callback_first));
+    memcpy(owner->pending_retirement.callback_post, control->callback_post,
+           sizeof(control->callback_post));
+    for (link = &owner->pending; *link != control; link = &(*link)->next) {
+        /* Membership was authenticated under this same mutex. */
+    }
+    *link = control->next;
+    control->holder = NULL;
+    g_mutex_unlock(&crucible_node_registrations.lock);
+
+    g_free(control);
+
+    if (!node_registration_process_current()) {
+        return -EPERM;
+    }
+    /* The prepaid parent cursor, not freed control storage, owns this fact. */
+    g_mutex_lock(&crucible_node_registrations.lock);
+    owner->pending_retirement.physically_returned = true;
+    *physically_returned = true;
+    g_mutex_unlock(&crucible_node_registrations.lock);
+    post = qemu_crucible_fault_pending_returning_v1(control);
+    g_mutex_lock(&crucible_node_registrations.lock);
+    owner->pending_retirement.post_status = post;
+    if (!post) {
+        owner->pending_retirement.holder = NULL;
+        owner->pending_retirement.active = false;
+    }
+    g_mutex_unlock(&crucible_node_registrations.lock);
+    return post;
+}
+
+int qemu_crucible_fault_node_registration_identity_v1(
+    QemuCrucibleFaultRegistration *registration,
+    QemuCrucibleFaultRegistration **holder, bool issuing,
+    const QemuCrucibleFaultHandler **handler)
+{
+    QemuCrucibleFaultRegistration *actual;
+    int status = -EPERM;
+
+    if (!handler || *handler) {
+        return -EINVAL;
+    }
+    if (!node_registration_process_current()) {
+        return -EPERM;
+    }
+    g_mutex_lock(&crucible_node_registrations.lock);
+    for (actual = crucible_node_registrations.head; actual; actual = actual->next) {
+        if (actual == registration) {
+            CrucibleNodeOwnedHandler *producer = container_of(
+                actual, CrucibleNodeOwnedHandler, registration);
+
+            if (actual->process == getpid() &&
+                holder == &actual->holder && *holder == actual &&
+                actual->issuing == issuing &&
+                (issuing || actual->attempt_returned) &&
+                (!issuing || (!actual->attempt_returned &&
+                    qemu_thread_is_self(&actual->creator))) &&
+                (!actual->impulse_published ||
+                    crucible_node_impulses[producer->handler.capability.command_kind] ==
+                        actual->impulse)) {
+                *handler = &producer->handler;
+                status = 0;
+            }
+            break;
+        }
+    }
+    g_mutex_unlock(&crucible_node_registrations.lock);
+    return status;
+}
+
+int qemu_crucible_fault_node_registration_publish_v1(
+    QemuCrucibleFaultRegistration *registration,
+    QemuCrucibleFaultRegistration **holder,
+    const QemuCrucibleFaultHandler *handler)
+{
+    const QemuCrucibleFaultHandler *actual_handler = NULL;
+    QemuCrucibleFaultRegistration *existing;
+    int status = qemu_crucible_fault_node_registration_identity_v1(
+        registration, holder, true, &actual_handler);
+
+    if (status || actual_handler != handler) {
+        return status ? status : -EPERM;
+    }
+    status = qemu_crucible_fault_registration_append_current_v1(
+        registration, holder, handler);
+    if (status) {
+        return status;
+    }
+    /* The real fault mutex excludes duplicate/seal/append races at this call.
+     * The producer mutex serializes actual impulse-table publication. */
+    g_mutex_lock(&crucible_node_registrations.lock);
+    if (registration->impulse_published) {
+        status = -EALREADY;
+    }
+    if (handler->capability.command_kind == CRUCIBLE_FAULT_COMMAND_NODE_HANG &&
+        (crucible_node_registrations.hang_retired ||
+         crucible_node_registrations.returning.active)) {
+        status = -EBUSY;
+    }
+    for (existing = crucible_node_registrations.head; !status && existing;
+         existing = existing->next) {
+        CrucibleNodeOwnedHandler *producer = container_of(
+            existing, CrucibleNodeOwnedHandler, registration);
+
+        if (existing->impulse_published &&
+            producer->handler.capability.command_kind == handler->capability.command_kind) {
+            status = -EEXIST;
+        }
+    }
+    if (!status) {
+        crucible_node_impulses[handler->capability.command_kind] = registration->impulse;
+        registration->impulse_published = true;
+    }
+    g_mutex_unlock(&crucible_node_registrations.lock);
+    return status;
+}
+
+int qemu_crucible_fault_node_registration_retire_begin_v1(
+    QemuCrucibleFaultRegistration *registration,
+    QemuCrucibleFaultRegistration **holder)
+{
+    const QemuCrucibleFaultHandler *handler = NULL;
+    CrucibleNodeRegistrationChild *child;
+    CrucibleNodeJsonJournal *json;
+    int status, post;
+    uint64_t child_count = 0;
+    uint64_t json_bytes = 0, control_bytes = 0, allocations = 0;
+
+    status = qemu_crucible_fault_registration_retiring_current_v1(
+        registration, holder, false);
+    if (status) {
+        return status;
+    }
+    status = qemu_crucible_fault_node_registration_identity_v1(
+        registration, holder, false, &handler);
+    if (status) {
+        return status;
+    }
+    if (handler->capability.command_kind != CRUCIBLE_FAULT_COMMAND_NODE_HANG) {
+        return -ENOTSUP;
+    }
+    /* Never wait for a storage caller while holding the fault lock. Submit's
+     * natural order is fault -> storage operation -> producer. */
+    if (!bql_locked() || !qemu_plugin_crucible_single_threaded_rr() ||
+        !qemu_plugin_crucible_vmstop_quiesced() || !runstate_check(RUN_STATE_PAUSED)) {
+        return -EPERM;
+    }
+    status = qemu_crucible_fault_vmstate_restore_exclude_v1(registration, holder);
+    if (status) {
+        return status;
+    }
+    if (!g_rec_mutex_trylock(&crucible_node_storage.operations)) {
+        status = qemu_crucible_fault_vmstate_restore_exclusion_return_v1(
+            registration, holder, false);
+        return status ? status : -EBUSY;
+    }
+    g_mutex_lock(&crucible_node_registrations.lock);
+    if (crucible_node_registrations.returning.active || registration->closing ||
+        registration->pending || registration->pending_retirement.active ||
+        registration->validation.holder || registration->validation.post_status ||
+        registration->child_issuance == UINT64_MAX) {
+        status = -EBUSY;
+        goto refuse;
+    }
+    for (child = registration->children; child; child = child->next) {
+        bool returned = child->kind == CRUCIBLE_NODE_STORAGE_KINDS + 1 ?
+            child->callback_entered && child->callback_returned &&
+                child->callback_post_returned : child->physically_returned;
+
+        child_count++;
+        if (child->parent != registration || child->process != getpid() ||
+            !child->born || !returned || child->post_status ||
+            (child->payload_owed && !child->payload_returned)) {
+            status = -EBUSY;
+            goto refuse;
+        }
+    }
+    if (child_count != registration->child_issuance ||
+        child_count > UINT64_MAX / sizeof(*child)) {
+        status = -EBUSY;
+        goto refuse;
+    }
+    for (json = registration->json; json; json = json->next) {
+        if (json->post_status) {
+            status = json->post_status;
+            goto refuse;
+        }
+        if (!json->returned) {
+            status = qobject_construction_return(&json->holder, &json->receipt);
+            /* A failed post can follow actual journal destruction. Preserve
+             * consumption and its cause before refusing the enclosing owner. */
+            if (json->receipt.physically_returned) {
+                json->returned = true;
+            }
+            if (!status && !json->receipt.physically_returned) {
+                status = -EIO;
+            }
+            if (status) {
+                /* A consumed holder cannot be retried. Missing physical facts
+                 * retain uncertainty rather than authorize outer destruction. */
+                if ((json->receipt.physically_returned || !json->holder) &&
+                    !json->post_status) {
+                    json->post_status = status;
+                }
+                goto refuse;
+            }
+        }
+        if (json_bytes > UINT64_MAX - json->receipt.payload_bytes ||
+            json->receipt.control_bytes > UINT64_MAX - sizeof(*json) ||
+            control_bytes > UINT64_MAX - json->receipt.control_bytes - sizeof(*json) ||
+            allocations > UINT64_MAX - json->receipt.allocations_returned) {
+            status = -EOVERFLOW;
+            goto refuse;
+        }
+        json_bytes += json->receipt.payload_bytes;
+        control_bytes += json->receipt.control_bytes + sizeof(*json);
+        allocations += json->receipt.allocations_returned;
+    }
+    registration->closing = true;
+    crucible_node_registrations.returning.holder = holder;
+    crucible_node_registrations.returning.owner = registration;
+    crucible_node_registrations.returning.producer = container_of(
+        registration, CrucibleNodeOwnedHandler, registration);
+    crucible_node_registrations.returning.child = registration->children;
+    crucible_node_registrations.returning.json = registration->json;
+    crucible_node_registrations.returning.issuance = ++registration->child_issuance;
+    crucible_node_registrations.returning.child_controls_returned = 0;
+    crucible_node_registrations.returning.child_control_bytes_returned = 0;
+    crucible_node_registrations.returning.producer_bytes_returned = 0;
+    crucible_node_registrations.returning.json_controls_returned = 0;
+    crucible_node_registrations.returning.json_payload_bytes = 0;
+    crucible_node_registrations.returning.json_control_bytes = 0;
+    crucible_node_registrations.returning.json_allocations_returned = 0;
+    crucible_node_registrations.returning.first_status = registration->first_status;
+    crucible_node_registrations.returning.post_status = 0;
+    crucible_node_registrations.returning.registry_removed = false;
+    crucible_node_registrations.returning.impulse_removed = false;
+    crucible_node_registrations.returning.physically_returned = false;
+    crucible_node_registrations.returning.active = true;
+    qemu_thread_get_self(&crucible_node_registrations.returning.thread);
+    g_mutex_unlock(&crucible_node_registrations.lock);
+    /* The real removal interval retains this recursive operation until finish. */
+    return 0;
+
+refuse:
+    g_mutex_unlock(&crucible_node_registrations.lock);
+    g_rec_mutex_unlock(&crucible_node_storage.operations);
+    post = qemu_crucible_fault_vmstate_restore_exclusion_return_v1(
+        registration, holder, false);
+
+    return status ? status : post;
+}
+
+int qemu_crucible_fault_node_registration_retire_finish_v1(
+    QemuCrucibleFaultRegistration *registration,
+    QemuCrucibleFaultRegistration **holder)
+{
+    QemuCrucibleFaultRegistration **link;
+    CrucibleNodeRegistrationChild *child;
+    CrucibleNodeJsonJournal *json;
+    CrucibleNodeOwnedHandler *producer;
+    int post;
+
+    post = qemu_crucible_fault_registration_retiring_current_v1(
+        registration, holder, true);
+    if (post) {
+        g_mutex_lock(&crucible_node_registrations.lock);
+        if (crucible_node_registrations.returning.active &&
+            crucible_node_registrations.returning.holder == holder &&
+            qemu_thread_is_self(&crucible_node_registrations.returning.thread)) {
+            crucible_node_registrations.returning.post_status = post;
+            g_mutex_unlock(&crucible_node_registrations.lock);
+            g_rec_mutex_unlock(&crucible_node_storage.operations);
+        } else {
+            g_mutex_unlock(&crucible_node_registrations.lock);
+        }
+        return post;
+    }
+    g_mutex_lock(&crucible_node_registrations.lock);
+    if (!crucible_node_registrations.returning.active ||
+        crucible_node_registrations.returning.owner != registration ||
+        crucible_node_registrations.returning.holder != holder ||
+        !qemu_thread_is_self(&crucible_node_registrations.returning.thread)) {
+        g_mutex_unlock(&crucible_node_registrations.lock);
+        return -EPERM;
+    }
+    producer = crucible_node_registrations.returning.producer;
+    crucible_node_registrations.returning.registry_removed = true;
+    registration->registry_published = false;
+    if (!registration->closing ||
+        crucible_node_impulses[CRUCIBLE_FAULT_COMMAND_NODE_HANG] !=
+            registration->impulse) {
+        crucible_node_registrations.returning.post_status = -EPERM;
+        g_mutex_unlock(&crucible_node_registrations.lock);
+        g_rec_mutex_unlock(&crucible_node_storage.operations);
+        return -EPERM;
+    }
+    crucible_node_impulses[CRUCIBLE_FAULT_COMMAND_NODE_HANG] = NULL;
+    registration->impulse_published = false;
+    crucible_node_registrations.returning.impulse_removed = true;
+    crucible_node_registrations.hang_retired = true;
+
+    while ((child = crucible_node_registrations.returning.child)) {
+        crucible_node_registrations.returning.child = child->next;
+        if (!crucible_node_registrations.returning.first_status) {
+            crucible_node_registrations.returning.first_status = child->first_status;
+        }
+        g_free(child);
+        crucible_node_registrations.returning.child_controls_returned++;
+        crucible_node_registrations.returning.child_control_bytes_returned +=
+            sizeof(*child);
+    }
+    while ((json = crucible_node_registrations.returning.json)) {
+        crucible_node_registrations.returning.json = json->next;
+        crucible_node_registrations.returning.json_payload_bytes +=
+            json->receipt.payload_bytes;
+        crucible_node_registrations.returning.json_control_bytes +=
+            json->receipt.control_bytes + sizeof(*json);
+        crucible_node_registrations.returning.json_allocations_returned +=
+            json->receipt.allocations_returned;
+        if (!crucible_node_registrations.returning.first_status) {
+            crucible_node_registrations.returning.first_status = json->first_status;
+        }
+        g_free(json);
+        crucible_node_registrations.returning.json_controls_returned++;
+    }
+    for (link = &crucible_node_registrations.head; *link != registration;
+         link = &(*link)->next) {
+    }
+    *link = registration->next;
+    registration->holder = NULL;
+    g_free(producer);
+    crucible_node_registrations.returning.producer_bytes_returned = sizeof(*producer);
+    crucible_node_registrations.returning.physically_returned = true;
+    /* Only the external cursor is read after producer free. */
+    post = qemu_crucible_fault_registration_retiring_current_v1(
+        registration, holder, true);
+    if (!post) {
+        post = qemu_crucible_fault_vmstate_restore_exclusion_return_v1(
+            registration, holder, true);
+    }
+    crucible_node_registrations.returning.post_status = post;
+    if (!post) {
+        crucible_node_registrations.returning.active = false;
+    }
+    g_mutex_unlock(&crucible_node_registrations.lock);
+    g_rec_mutex_unlock(&crucible_node_storage.operations);
+    return post;
+}
+
+int qemu_crucible_fault_node_registration_return_v1(
+    QemuCrucibleFaultRegistration **holder)
+{
+    QemuCrucibleFaultRegistration *actual;
+    int status;
+
+    if (qemu_plugin_crucible_startup_source_retained()) {
+        return -ENOKEY;
+    }
+    if (!node_registration_process_current()) {
+        return -EPERM;
+    }
+    g_mutex_lock(&crucible_node_registrations.lock);
+    if (crucible_node_registrations.returning.active &&
+        crucible_node_registrations.returning.holder == holder) {
+        /* A refused post never replays a completed destructor or dereferences
+         * an interior field after its producer allocation returned. */
+        status = crucible_node_registrations.returning.post_status;
+        g_mutex_unlock(&crucible_node_registrations.lock);
+        return status ? status : -EBUSY;
+    }
+    for (actual = crucible_node_registrations.head; actual; actual = actual->next) {
+        if (holder == &actual->holder && actual->holder == actual) {
+            break;
+        }
+    }
+    g_mutex_unlock(&crucible_node_registrations.lock);
+    if (!actual) {
+        return -EPERM;
+    }
+    return qemu_crucible_fault_registration_retire_v1(actual, holder);
+}
diff --git a/plugins/crucible-fault-storage.inc.h b/plugins/crucible-fault-storage.inc.h
new file mode 100644
index 0000000000000000000000000000000000000000..fea9a5c56160bad3474708c2b4f6cbaff6f271a7
--- /dev/null
+++ b/plugins/crucible-fault-storage.inc.h
@@ -0,0 +1,397 @@
+/*
+ * Actual node rule and event-reservation storage custody
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+typedef enum CrucibleNodeStorageKind {
+    CRUCIBLE_NODE_STORAGE_STAGING,
+    CRUCIBLE_NODE_STORAGE_RULE,
+    CRUCIBLE_NODE_STORAGE_RESERVATION,
+    CRUCIBLE_NODE_STORAGE_KINDS,
+} CrucibleNodeStorageKind;
+
+#define CRUCIBLE_NODE_ENVELOPE_CHILD (CRUCIBLE_NODE_STORAGE_KINDS + 2)
+#define CRUCIBLE_NODE_RESTORE_EVENT_CHILD (CRUCIBLE_NODE_STORAGE_KINDS + 3)
+#define CRUCIBLE_NODE_ENVELOPE_EMERGENCY_ROLE 4
+
+typedef enum CrucibleNodeReturnedReference {
+    CRUCIBLE_NODE_REF_ROW_COUNTS = UINT64_C(1) << 0,
+    CRUCIBLE_NODE_REF_TRANSLATIONS = UINT64_C(1) << 1,
+    CRUCIBLE_NODE_REF_RETENTION_CELLS = UINT64_C(1) << 2,
+    CRUCIBLE_NODE_REF_ROW_COUNTERS = UINT64_C(1) << 3,
+    CRUCIBLE_NODE_REF_MUTATION_RECORDS = UINT64_C(1) << 4,
+    CRUCIBLE_NODE_REF_COUNTER_RECORDS = UINT64_C(1) << 5,
+    CRUCIBLE_NODE_REF_SERVICE_LEDGER = UINT64_C(1) << 6,
+    CRUCIBLE_NODE_REF_IMPULSE_EVIDENCE = UINT64_C(1) << 16,
+    CRUCIBLE_NODE_REF_EVENT_RESERVATION = UINT64_C(1) << 17,
+} CrucibleNodeReturnedReference;
+
+typedef struct CrucibleNodeRegistrationChild {
+    struct CrucibleNodeRegistrationChild *next;
+    QemuCrucibleFaultRegistration *parent;
+    void *allocation;
+    const void *resource;
+    QemuThread thread;
+    pid_t process;
+    uint64_t issuance;
+    uint64_t storage_issuance;
+    unsigned kind;
+    bool returning;
+    QemuCrucibleFaultRuleVisitFn visit;
+    void *opaque;
+    bool callback_entered;
+    bool callback_returned;
+    bool callback_post_returned;
+    bool born;
+    bool physically_returned;
+    bool payload_owed;
+    bool payload_returned;
+    int first_status;
+    int post_status;
+    /* Envelope controls survive their typed body and actual container. */
+    const void *envelope_custodian;
+    uint64_t envelope_extent;
+    uint64_t envelope_capacity;
+    uint64_t envelope_handoffs;
+    uint64_t envelope_sequence;
+    unsigned envelope_role;
+    uint8_t envelope_request_hash[32];
+} CrucibleNodeRegistrationChild;
+
+static int node_registration_child_acquire(
+    QemuCrucibleFaultRegistration *parent, unsigned kind,
+    CrucibleNodeRegistrationChild **out);
+static void node_registration_child_born(CrucibleNodeRegistrationChild *child,
+    void *allocation, const void *resource, uint64_t issuance);
+static void node_registration_child_returned(CrucibleNodeRegistrationChild *child,
+    void *allocation, uint64_t issuance, int post_status);
+
+typedef struct CrucibleNodeStorageControl {
+    struct CrucibleNodeStorageControl *next;
+    struct CrucibleNodeStorageControl *holder;
+    void *allocation;
+    const void *resource;
+    const QemuCrucibleFaultRule *rule;
+    QemuCrucibleFaultRegistration *origin;
+    CrucibleNodeRegistrationChild *child;
+    QemuThread creator;
+    pid_t process;
+    uint64_t issuance;
+    uint64_t references_returned;
+    size_t json_references_returned;
+    bool payload_returned;
+    bool retiring;
+    int first_status;
+    int post_status;
+    CrucibleNodeStorageKind kind;
+} CrucibleNodeStorageControl;
+
+static struct {
+    GMutex lock;
+    GRecMutex operations;
+    pid_t process;
+    uint64_t issuance;
+    CrucibleNodeStorageControl *head;
+    struct {
+        void *holder;
+        const void *resource;
+        QemuCrucibleFaultRegistration *origin;
+        CrucibleNodeRegistrationChild *child;
+        QemuThread thread;
+        uint64_t issuance;
+        uint64_t references_returned;
+        size_t json_references_returned;
+        bool payload_returned;
+        bool active;
+        bool physically_returned;
+        bool post_returned;
+        int first_status;
+        int post_status;
+    } returning[CRUCIBLE_NODE_STORAGE_KINDS];
+} crucible_node_storage;
+
+static uint64_t node_storage_fixed_bytes(void)
+{
+    return sizeof(crucible_node_storage);
+}
+
+static bool node_storage_process_current(void)
+{
+    pid_t process = qatomic_load_acquire(&crucible_node_storage.process);
+
+    if (!process) {
+        process = qatomic_cmpxchg(&crucible_node_storage.process, 0, getpid());
+        if (!process) {
+            process = getpid();
+        }
+    }
+    return process == getpid();
+}
+
+/* Ordinary callers must own a valid reference for the whole use. This scope
+ * serializes reference/quota changes and nested destruction plus receipt
+ * observation; membership by itself is not a concurrent lifetime borrow.
+ * Selected callers have no payer for the recursive lock's opaque backing. */
+typedef struct CrucibleNodeStorageOperation {
+    bool entered;
+} CrucibleNodeStorageOperation;
+
+static CrucibleNodeStorageOperation node_storage_operation_begin(void)
+{
+    CrucibleNodeStorageOperation operation = { false };
+
+    if (!qemu_plugin_crucible_startup_source_retained() &&
+        node_storage_process_current()) {
+        g_rec_mutex_lock(&crucible_node_storage.operations);
+        operation.entered = true;
+    }
+    return operation;
+}
+
+static void node_storage_operation_clear(CrucibleNodeStorageOperation *operation)
+{
+    if (operation->entered) {
+        g_rec_mutex_unlock(&crucible_node_storage.operations);
+    }
+}
+
+G_DEFINE_AUTO_CLEANUP_CLEAR_FUNC(CrucibleNodeStorageOperation,
+                               node_storage_operation_clear)
+
+/* Only actual constructors call these helpers. An issuance or parsed row is
+ * not an allocation grant; selected construction refuses before its allocator. */
+static uint64_t node_storage_admit(CrucibleNodeStorageKind kind)
+{
+    uint64_t issuance = 0;
+
+    if (qemu_plugin_crucible_startup_source_retained() ||
+        !node_storage_process_current()) {
+        return 0;
+    }
+    g_mutex_lock(&crucible_node_storage.lock);
+    if (!crucible_node_storage.returning[kind].active &&
+        crucible_node_storage.issuance != UINT64_MAX) {
+        issuance = ++crucible_node_storage.issuance;
+    }
+    g_mutex_unlock(&crucible_node_storage.lock);
+    return issuance;
+}
+
+static void node_storage_publish(CrucibleNodeStorageControl *control,
+    void *allocation, const void *resource, const QemuCrucibleFaultRule *rule,
+    CrucibleNodeStorageKind kind, uint64_t issuance,
+    QemuCrucibleFaultRegistration *origin,
+    CrucibleNodeRegistrationChild *child)
+{
+    control->holder = control;
+    control->allocation = allocation;
+    control->resource = resource;
+    control->rule = rule;
+    control->kind = kind;
+    control->issuance = issuance;
+    control->origin = origin;
+    control->child = child;
+    node_registration_child_born(child, allocation, resource, issuance);
+    control->process = getpid();
+    qemu_thread_get_self(&control->creator);
+    g_mutex_lock(&crucible_node_storage.lock);
+    control->next = crucible_node_storage.head;
+    crucible_node_storage.head = control;
+    g_mutex_unlock(&crucible_node_storage.lock);
+}
+
+/* The caller holds the storage mutex. Authenticate membership before fields. */
+static CrucibleNodeStorageControl *node_storage_find_locked(
+    const void *resource, CrucibleNodeStorageKind kind)
+{
+    CrucibleNodeStorageControl *actual;
+
+    for (actual = crucible_node_storage.head; actual; actual = actual->next) {
+        if (actual->resource == resource && actual->kind == kind) {
+            return actual->holder == actual && actual->process == getpid() &&
+                actual->issuance && !actual->retiring &&
+                !actual->post_status ? actual : NULL;
+        }
+    }
+    return NULL;
+}
+
+static bool node_storage_rule_origin(const QemuCrucibleFaultRule *rule,
+                                    QemuCrucibleFaultRegistration **origin)
+{
+    CrucibleNodeStorageControl *actual;
+    bool current = false;
+
+    if (!rule || !origin || !node_storage_process_current()) {
+        return false;
+    }
+    g_mutex_lock(&crucible_node_storage.lock);
+    for (actual = crucible_node_storage.head; actual; actual = actual->next) {
+        if (actual->rule == rule && actual->holder == actual &&
+            actual->process == getpid() && actual->issuance &&
+            !actual->retiring && !actual->post_status) {
+            *origin = actual->origin;
+            current = true;
+            break;
+        }
+    }
+    g_mutex_unlock(&crucible_node_storage.lock);
+    return current;
+}
+
+/* Reserve the real cursor before the first destructor effect. Membership stays
+ * live while child references and payload are being returned. */
+static CrucibleNodeStorageControl *node_storage_retire_begin(
+    const void *resource, CrucibleNodeStorageKind kind)
+{
+    CrucibleNodeStorageControl *control;
+
+    if (!node_storage_process_current()) {
+        return NULL;
+    }
+    g_mutex_lock(&crucible_node_storage.lock);
+    control = node_storage_find_locked(resource, kind);
+    if (!control || crucible_node_storage.returning[kind].active) {
+        g_mutex_unlock(&crucible_node_storage.lock);
+        return NULL;
+    }
+    control->retiring = true;
+    if (control->child) {
+        control->child->first_status = control->first_status;
+    }
+    crucible_node_storage.returning[kind].holder = control->allocation;
+    crucible_node_storage.returning[kind].resource = resource;
+    crucible_node_storage.returning[kind].origin = control->origin;
+    crucible_node_storage.returning[kind].child = control->child;
+    crucible_node_storage.returning[kind].issuance = control->issuance;
+    crucible_node_storage.returning[kind].references_returned = 0;
+    crucible_node_storage.returning[kind].json_references_returned = 0;
+    crucible_node_storage.returning[kind].payload_returned = false;
+    crucible_node_storage.returning[kind].physically_returned = false;
+    crucible_node_storage.returning[kind].post_returned = false;
+    crucible_node_storage.returning[kind].first_status = control->first_status;
+    crucible_node_storage.returning[kind].post_status = control->post_status;
+    crucible_node_storage.returning[kind].active = true;
+    qemu_thread_get_self(&crucible_node_storage.returning[kind].thread);
+    g_mutex_unlock(&crucible_node_storage.lock);
+    return control;
+}
+
+static bool node_storage_unpublish(CrucibleNodeStorageControl *control)
+{
+    CrucibleNodeStorageControl **link;
+    CrucibleNodeStorageKind kind = control->kind;
+
+    g_mutex_lock(&crucible_node_storage.lock);
+    if (!crucible_node_storage.returning[kind].active ||
+        crucible_node_storage.returning[kind].holder != control->allocation ||
+        crucible_node_storage.returning[kind].issuance != control->issuance ||
+        !qemu_thread_is_self(&crucible_node_storage.returning[kind].thread)) {
+        control->post_status = -EPERM;
+        g_mutex_unlock(&crucible_node_storage.lock);
+        return false;
+    }
+    for (link = &crucible_node_storage.head; *link && *link != control;
+         link = &(*link)->next) {
+    }
+    if (!*link) {
+        control->post_status = -EPERM;
+        g_mutex_unlock(&crucible_node_storage.lock);
+        return false;
+    }
+    crucible_node_storage.returning[kind].references_returned =
+        control->references_returned;
+    crucible_node_storage.returning[kind].json_references_returned =
+        control->json_references_returned;
+    crucible_node_storage.returning[kind].payload_returned =
+        control->payload_returned;
+    *link = control->next;
+    control->holder = NULL;
+    g_mutex_unlock(&crucible_node_storage.lock);
+    return true;
+}
+
+/* Only the actual destructor calls this after free. It never reads the freed
+ * allocation/control. A failed post leaves the paid nominal cursor occupied. */
+static void node_storage_retire_post(void *allocation, uint64_t issuance,
+                                    CrucibleNodeStorageKind kind)
+{
+    if (!node_storage_process_current()) {
+        return;
+    }
+    g_mutex_lock(&crucible_node_storage.lock);
+    if (crucible_node_storage.returning[kind].active &&
+        crucible_node_storage.returning[kind].holder == allocation &&
+        crucible_node_storage.returning[kind].issuance == issuance) {
+        crucible_node_storage.returning[kind].physically_returned = true;
+        if (qemu_thread_is_self(&crucible_node_storage.returning[kind].thread)) {
+            crucible_node_storage.returning[kind].post_returned = true;
+            if (kind != CRUCIBLE_NODE_STORAGE_STAGING) {
+                crucible_node_storage.returning[kind].holder = NULL;
+                crucible_node_storage.returning[kind].active = false;
+            }
+        } else {
+            crucible_node_storage.returning[kind].post_status = -EPERM;
+        }
+        node_registration_child_returned(
+            crucible_node_storage.returning[kind].child, allocation, issuance,
+            crucible_node_storage.returning[kind].post_status);
+    }
+    g_mutex_unlock(&crucible_node_storage.lock);
+}
+
+static bool node_storage_returned(const void *resource, uint64_t issuance,
+                                  CrucibleNodeStorageKind kind)
+{
+    bool returned;
+
+    if (!node_storage_process_current()) {
+        return false;
+    }
+    g_mutex_lock(&crucible_node_storage.lock);
+    returned = !crucible_node_storage.returning[kind].active &&
+        crucible_node_storage.returning[kind].resource == resource &&
+        crucible_node_storage.returning[kind].issuance == issuance &&
+        crucible_node_storage.returning[kind].physically_returned &&
+        !crucible_node_storage.returning[kind].post_status;
+    g_mutex_unlock(&crucible_node_storage.lock);
+    return returned;
+}
+
+int qemu_crucible_fault_node_state_returned_v1(
+    QemuCrucibleFaultPendingControl *control, const void *state,
+    uint64_t issuance, bool *physically_returned)
+{
+    int status = -EBUSY;
+    CrucibleNodeStorageKind kind = CRUCIBLE_NODE_STORAGE_STAGING;
+
+    if (!physically_returned || *physically_returned ||
+        !node_storage_process_current()) {
+        return -EPERM;
+    }
+    status = qemu_crucible_fault_node_pending_current_v1(control);
+    if (!status) {
+        status = qemu_crucible_fault_pending_state_returning_v1(
+            control, state, issuance);
+    }
+    if (status) {
+        return status;
+    }
+    status = -EBUSY;
+    g_mutex_lock(&crucible_node_storage.lock);
+    if (crucible_node_storage.returning[kind].resource == state &&
+        crucible_node_storage.returning[kind].issuance == issuance) {
+        *physically_returned =
+            crucible_node_storage.returning[kind].physically_returned;
+        if (*physically_returned &&
+            crucible_node_storage.returning[kind].active &&
+            crucible_node_storage.returning[kind].post_returned &&
+            !crucible_node_storage.returning[kind].post_status &&
+            qemu_thread_is_self(&crucible_node_storage.returning[kind].thread)) {
+            crucible_node_storage.returning[kind].holder = NULL;
+            crucible_node_storage.returning[kind].active = false;
+            status = 0;
+        }
+    }
+    g_mutex_unlock(&crucible_node_storage.lock);
+    return status;
+}
diff --git a/plugins/crucible-fault-vcpu-service.c b/plugins/crucible-fault-vcpu-service.c
new file mode 100644
index 0000000000000000000000000000000000000000..fdfa46c14e970b71817c656df1f8b9c49eed4dcd
--- /dev/null
+++ b/plugins/crucible-fault-vcpu-service.c
@@ -0,0 +1,1484 @@
+/*
+ * Crucible deterministic vCPU service and fixed-topology eligibility faults
+ *
+ * Copyright (c) 2026 ANDYL Technologies
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "exec/icount.h"
+#include "hw/core/cpu.h"
+#include "qemu/accel.h"
+#include "qemu/bswap.h"
+#include "qemu/crucible-fault.h"
+#include "qemu/error-report.h"
+#include "qemu/module.h"
+#include "qemu/plugin.h"
+#include "plugins/qemu-plugin.h"
+#include "qobject/qlist.h"
+#include "qobject/qnum.h"
+#include "system/cpu-timers.h"
+#include "system/runstate.h"
+
+#define CRUCIBLE_VCPU_SERVICE_EVIDENCE_BYTES 192
+#define CRUCIBLE_VCPU_STATE_EVIDENCE_BYTES 192
+#define CRUCIBLE_VCPU_SERVICE_MAX_VCPUS 4096
+
+enum CrucibleVcpuFaultState {
+    CRUCIBLE_VCPU_ONLINE = 1,
+    CRUCIBLE_VCPU_OFFLINE = 2,
+    CRUCIBLE_VCPU_STALLED = 3,
+};
+
+enum CrucibleVcpuServiceDiscipline {
+    CRUCIBLE_VCPU_WORK_CONSERVING = 1,
+    CRUCIBLE_VCPU_STRICT_CAP = 2,
+};
+
+typedef struct CrucibleVcpuService {
+    uint64_t numerator;
+    uint64_t denominator;
+    uint64_t quantum;
+    uint64_t remainder;
+    uint64_t window_remainder_before;
+    uint64_t credit_remaining;
+    uint64_t window_credit;
+    uint64_t window_retired;
+    uint64_t denied_pending;
+    uint64_t skipped_selections;
+    uint64_t window_sequence;
+    uint64_t grant_own;
+    uint64_t grant_borrowed;
+    uint64_t window_own_retired;
+    uint64_t window_borrowed_retired;
+    uint64_t donated_credit;
+    uint32_t discipline;
+    uint32_t state;
+    GPtrArray *service_rules;
+    QemuCrucibleFaultRule *controller_rule;
+    QemuCrucibleFaultRule *state_rule;
+    QemuCrucibleFaultEventReservation *window_reservation;
+} CrucibleVcpuService;
+
+typedef struct CrucibleVcpuRuleApply {
+    const QemuCrucibleFaultRule *rule;
+    bool state_rule;
+} CrucibleVcpuRuleApply;
+
+static GArray *crucible_vcpu_services;
+static bool crucible_vcpu_service_terminal;
+
+typedef struct CrucibleVcpuVmstate {
+    GArray *services;
+    GArray *reservation_remaining;
+    bool terminal;
+} CrucibleVcpuVmstate;
+
+static bool crucible_vcpu_service_mode(void)
+{
+    return current_accel_is_sim() &&
+           icount_enabled() == ICOUNT_PRECISE &&
+           icount_crucible_rr_switch_quantum() != 0;
+}
+
+static bool crucible_vcpu_field(const QemuCrucibleFaultRule *rule,
+                                uint16_t tag, uint16_t type,
+                                const uint8_t **data, uint32_t *length)
+{
+    return qemu_crucible_fault_rule_field(rule, tag, type, data, length);
+}
+
+static bool crucible_vcpu_u32(const QemuCrucibleFaultRule *rule,
+                              uint16_t tag, uint32_t *value)
+{
+    const uint8_t *data;
+    uint32_t length;
+
+    if (!crucible_vcpu_field(rule, tag,
+            CRUCIBLE_NODE_FAULT_FIELD_TYPE_U32, &data, &length) ||
+        length != sizeof(*value)) {
+        return false;
+    }
+    *value = ldl_le_p(data);
+    return true;
+}
+
+static bool crucible_vcpu_u64(const QemuCrucibleFaultRule *rule,
+                              uint16_t tag, uint64_t *value)
+{
+    const uint8_t *data;
+    uint32_t length;
+
+    if (!crucible_vcpu_field(rule, tag,
+            CRUCIBLE_NODE_FAULT_FIELD_TYPE_U64, &data, &length) ||
+        length != sizeof(*value)) {
+        return false;
+    }
+    *value = ldq_le_p(data);
+    return true;
+}
+
+static bool crucible_vcpu_ratio(const QemuCrucibleFaultRule *rule,
+                                uint64_t *numerator, uint64_t *denominator)
+{
+    const uint8_t *data;
+    uint32_t length;
+
+    if (!crucible_vcpu_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P2,
+            CRUCIBLE_NODE_FAULT_FIELD_TYPE_RATIO, &data, &length) ||
+        length != 16) {
+        return false;
+    }
+    *numerator = ldq_le_p(data);
+    *denominator = ldq_le_p(data + 8);
+    return *numerator != 0 && *numerator <= *denominator;
+}
+
+static uint64_t crucible_vcpu_gcd(uint64_t left, uint64_t right)
+{
+    while (right != 0) {
+        uint64_t remainder = left % right;
+
+        left = right;
+        right = remainder;
+    }
+    return left;
+}
+
+static bool crucible_vcpu_target(const QemuCrucibleFaultRule *rule,
+                                 uint32_t *vcpu)
+{
+    return crucible_vcpu_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_T1, vcpu);
+}
+
+static bool crucible_vcpu_exists(uint32_t target)
+{
+    CPUState *cpu;
+
+    CPU_FOREACH(cpu) {
+        if (cpu->cpu_index == target) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static bool crucible_vcpu_rule_selects(const QemuCrucibleFaultRule *rule,
+                                       uint32_t target)
+{
+    const QObject *object = qemu_crucible_fault_rule_json(
+        rule, CRUCIBLE_NODE_FAULT_FIELD_P1);
+    QList *list = qobject_to(QList, object);
+    QListEntry *entry;
+
+    if (!list) {
+        return false;
+    }
+    QLIST_FOREACH_ENTRY(list, entry) {
+        if (qnum_get_uint(qobject_to(QNum, qlist_entry_obj(entry))) == target) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static size_t crucible_vcpu_count(void)
+{
+    CPUState *cpu;
+    size_t count = 0;
+
+    CPU_FOREACH(cpu) {
+        if (cpu->cpu_index != count ||
+            count == CRUCIBLE_VCPU_SERVICE_MAX_VCPUS) {
+            return 0;
+        }
+        count++;
+    }
+    return count;
+}
+
+int qemu_crucible_fault_vcpu_service_validate(
+    const QemuCrucibleFaultRule *rule)
+{
+    uint16_t operation = qemu_crucible_fault_rule_operation(rule);
+    uint16_t kind = qemu_crucible_fault_rule_command_kind(rule);
+    uint32_t target;
+
+    if (!crucible_vcpu_service_mode()) {
+        return -ENOTSUP;
+    }
+    if (operation == CRUCIBLE_NODE_FAULT_OPERATION_REMOVE) {
+        return 0;
+    }
+    if (kind == CRUCIBLE_FAULT_COMMAND_CPU_VCPU_STATE) {
+        uint32_t state;
+
+        return crucible_vcpu_target(rule, &target) &&
+               crucible_vcpu_exists(target) &&
+               crucible_vcpu_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P1, &state) &&
+               state >= CRUCIBLE_VCPU_ONLINE &&
+               state <= CRUCIBLE_VCPU_STALLED ? 0 : -EINVAL;
+    }
+    if (kind == CRUCIBLE_FAULT_COMMAND_CPU_SERVICE) {
+        const QObject *object = qemu_crucible_fault_rule_json(
+            rule, CRUCIBLE_NODE_FAULT_FIELD_P1);
+        QList *list = qobject_to(QList, object);
+        QListEntry *entry;
+        uint64_t numerator, denominator, quantum;
+        uint32_t discipline;
+
+        if (!list || qlist_empty(list) ||
+            !crucible_vcpu_ratio(rule, &numerator, &denominator) ||
+            crucible_vcpu_gcd(numerator, denominator) != 1 ||
+            !crucible_vcpu_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_P3, &quantum) ||
+            quantum == 0 ||
+            quantum > INT64_MAX ||
+            !crucible_vcpu_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P4,
+                               &discipline) ||
+            discipline < CRUCIBLE_VCPU_WORK_CONSERVING ||
+            discipline > CRUCIBLE_VCPU_STRICT_CAP) {
+            return -EINVAL;
+        }
+        QLIST_FOREACH_ENTRY(list, entry) {
+            uint64_t value = qnum_get_uint(
+                qobject_to(QNum, qlist_entry_obj(entry)));
+
+            if (value > UINT32_MAX || !crucible_vcpu_exists(value)) {
+                return -EINVAL;
+            }
+        }
+        if (qemu_crucible_fault_rule_target_kind(rule) ==
+                CRUCIBLE_NODE_FAULT_TARGET_VCPU &&
+            (!crucible_vcpu_target(rule, &target) ||
+             !crucible_vcpu_rule_selects(rule, target))) {
+            return -EINVAL;
+        }
+        return 0;
+    }
+    return -EINVAL;
+}
+
+static void crucible_vcpu_service_clear(CrucibleVcpuService *service)
+{
+    if (service->window_reservation) {
+        qemu_crucible_fault_event_reservation_release(
+            service->window_reservation);
+    }
+    if (service->service_rules) {
+        g_ptr_array_unref(service->service_rules);
+    }
+    if (service->state_rule) {
+        qemu_crucible_fault_rule_unref(service->state_rule);
+    }
+    memset(service, 0, sizeof(*service));
+}
+
+static void crucible_vcpu_service_init(CrucibleVcpuService *service)
+{
+    memset(service, 0, sizeof(*service));
+    service->numerator = 1;
+    service->denominator = 1;
+    service->quantum = icount_crucible_rr_switch_quantum();
+    service->discipline = CRUCIBLE_VCPU_STRICT_CAP;
+    service->state = CRUCIBLE_VCPU_ONLINE;
+    service->service_rules = g_ptr_array_new_with_free_func(
+        (GDestroyNotify)qemu_crucible_fault_rule_unref);
+}
+
+static bool crucible_vcpu_ratio_less(uint64_t left_n, uint64_t left_d,
+                                     uint64_t right_n, uint64_t right_d)
+{
+    return (__uint128_t)left_n * right_d < (__uint128_t)right_n * left_d;
+}
+
+static void crucible_vcpu_apply_rule(const QemuCrucibleFaultRule *rule,
+                                     void *opaque)
+{
+    CrucibleVcpuRuleApply *apply = opaque;
+    uint16_t kind = qemu_crucible_fault_rule_command_kind(rule);
+
+    if (apply->state_rule !=
+        (kind == CRUCIBLE_FAULT_COMMAND_CPU_VCPU_STATE)) {
+        return;
+    }
+    if (kind == CRUCIBLE_FAULT_COMMAND_CPU_VCPU_STATE) {
+        uint32_t target, state;
+        CrucibleVcpuService *service;
+
+        if (!crucible_vcpu_target(rule, &target) ||
+            target >= crucible_vcpu_services->len ||
+            !crucible_vcpu_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P1, &state)) {
+            abort();
+        }
+        service = &g_array_index(
+            crucible_vcpu_services, CrucibleVcpuService, target);
+        /* Offline dominates stalled, and both dominate online. */
+        if ((state == CRUCIBLE_VCPU_OFFLINE &&
+             service->state != CRUCIBLE_VCPU_OFFLINE) ||
+            (state == CRUCIBLE_VCPU_STALLED &&
+             service->state == CRUCIBLE_VCPU_ONLINE)) {
+            service->state = state;
+            if (service->state_rule) {
+                qemu_crucible_fault_rule_unref(service->state_rule);
+            }
+            service->state_rule = qemu_crucible_fault_rule_ref(
+                (QemuCrucibleFaultRule *)rule);
+        }
+        return;
+    }
+
+    for (guint index = 0; index < crucible_vcpu_services->len; index++) {
+        CrucibleVcpuService *service;
+        uint64_t numerator, denominator, quantum;
+        uint32_t discipline;
+        bool first_rule;
+
+        if (!crucible_vcpu_rule_selects(rule, index)) {
+            continue;
+        }
+        service = &g_array_index(
+            crucible_vcpu_services, CrucibleVcpuService, index);
+        if (!crucible_vcpu_ratio(rule, &numerator, &denominator) ||
+            !crucible_vcpu_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_P3, &quantum) ||
+            !crucible_vcpu_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P4,
+                               &discipline)) {
+            abort();
+        }
+        first_rule = service->service_rules->len == 0;
+        g_ptr_array_add(service->service_rules,
+            qemu_crucible_fault_rule_ref((QemuCrucibleFaultRule *)rule));
+        if (first_rule ||
+            crucible_vcpu_ratio_less(numerator, denominator,
+                                     service->numerator,
+                                     service->denominator)) {
+            service->numerator = numerator;
+            service->denominator = denominator;
+            service->quantum = quantum;
+            service->discipline = discipline;
+            service->controller_rule = (QemuCrucibleFaultRule *)rule;
+        } else if (!crucible_vcpu_ratio_less(
+                       service->numerator, service->denominator,
+                       numerator, denominator)) {
+            service->quantum = MIN(service->quantum, quantum);
+            if (discipline > service->discipline) {
+                service->discipline = discipline;
+                service->controller_rule = (QemuCrucibleFaultRule *)rule;
+            }
+        }
+    }
+}
+
+static bool crucible_vcpu_service_rules_equal(
+    const CrucibleVcpuService *left, const CrucibleVcpuService *right)
+{
+    if (left->numerator != right->numerator ||
+        left->denominator != right->denominator ||
+        left->quantum != right->quantum ||
+        left->discipline != right->discipline ||
+        left->controller_rule != right->controller_rule ||
+        left->service_rules->len != right->service_rules->len) {
+        return false;
+    }
+    for (guint i = 0; i < left->service_rules->len; i++) {
+        if (g_ptr_array_index(left->service_rules, i) !=
+            g_ptr_array_index(right->service_rules, i)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static void crucible_vcpu_service_preserve_ledger(
+    CrucibleVcpuService *next, CrucibleVcpuService *previous)
+{
+    next->remainder = previous->remainder;
+    next->window_remainder_before = previous->window_remainder_before;
+    next->credit_remaining = previous->credit_remaining;
+    next->window_credit = previous->window_credit;
+    next->window_retired = previous->window_retired;
+    next->denied_pending = previous->denied_pending;
+    next->window_sequence = previous->window_sequence;
+    next->grant_own = previous->grant_own;
+    next->grant_borrowed = previous->grant_borrowed;
+    next->window_own_retired = previous->window_own_retired;
+    next->window_borrowed_retired = previous->window_borrowed_retired;
+    next->donated_credit = previous->donated_credit;
+    next->window_reservation = previous->window_reservation;
+    previous->window_reservation = NULL;
+}
+
+static void crucible_vcpu_state_event(
+    uint32_t vcpu, uint32_t old_state, const CrucibleVcpuService *service,
+    const QemuCrucibleFaultRule *transition_rule,
+    QemuCrucibleFaultEventReservation **event_reservation);
+static void crucible_vcpu_interrupt_window(CPUState *cpu,
+                                           CrucibleVcpuService *service);
+
+void qemu_crucible_fault_vcpu_service_rules_changed(
+    const QemuCrucibleFaultRule *transition_rule,
+    QemuCrucibleFaultEventReservation **event_reservation)
+{
+    size_t count;
+    CrucibleVcpuRuleApply apply = { 0 };
+    GArray *previous = crucible_vcpu_services;
+    GArray *next;
+
+    if (!crucible_vcpu_service_mode()) {
+        return;
+    }
+    count = crucible_vcpu_count();
+    if (count == 0) {
+        abort();
+    }
+    next = g_array_sized_new(
+        false, true, sizeof(CrucibleVcpuService), count);
+    g_array_set_size(next, count);
+    crucible_vcpu_services = next;
+    for (guint i = 0; i < next->len; i++) {
+        crucible_vcpu_service_init(&g_array_index(
+            next, CrucibleVcpuService, i));
+    }
+    qemu_crucible_fault_rule_foreach(
+        CRUCIBLE_FAULT_COMMAND_CPU_SERVICE,
+        crucible_vcpu_apply_rule, &apply);
+    apply.state_rule = true;
+    qemu_crucible_fault_rule_foreach(
+        CRUCIBLE_FAULT_COMMAND_CPU_VCPU_STATE,
+        crucible_vcpu_apply_rule, &apply);
+    if (previous) {
+        g_assert(previous->len == next->len);
+        for (guint i = 0; i < next->len; i++) {
+            CrucibleVcpuService *old_service = &g_array_index(
+                previous, CrucibleVcpuService, i);
+            CrucibleVcpuService *new_service = &g_array_index(
+                next, CrucibleVcpuService, i);
+            uint32_t old_state = old_service->state;
+
+            new_service->window_sequence = old_service->window_sequence;
+            new_service->skipped_selections = old_service->skipped_selections;
+            if (crucible_vcpu_service_rules_equal(old_service,
+                                                  new_service)) {
+                crucible_vcpu_service_preserve_ledger(new_service,
+                                                      old_service);
+            } else {
+                CPUState *cpu = qemu_get_cpu(i);
+
+                if (!cpu) {
+                    abort();
+                }
+                crucible_vcpu_interrupt_window(cpu, old_service);
+            }
+            if (old_state != new_service->state) {
+                if (!transition_rule || !event_reservation ||
+                    !*event_reservation) {
+                    error_report("Crucible vCPU state transition lacked "
+                                 "reserved evidence capacity");
+                    abort();
+                }
+                crucible_vcpu_state_event(i, old_state, new_service,
+                                          transition_rule,
+                                          event_reservation);
+            }
+        }
+        for (guint i = 0; i < previous->len; i++) {
+            crucible_vcpu_service_clear(&g_array_index(
+                previous, CrucibleVcpuService, i));
+        }
+        g_array_unref(previous);
+    } else {
+        for (guint i = 0; i < next->len; i++) {
+            CrucibleVcpuService *new_service = &g_array_index(
+                next, CrucibleVcpuService, i);
+
+            if (new_service->state != CRUCIBLE_VCPU_ONLINE) {
+                if (!transition_rule || !event_reservation ||
+                    !*event_reservation) {
+                    error_report("Crucible initial vCPU state transition "
+                                 "lacked reserved evidence capacity");
+                    abort();
+                }
+                crucible_vcpu_state_event(
+                    i, CRUCIBLE_VCPU_ONLINE, new_service,
+                    transition_rule, event_reservation);
+            }
+        }
+    }
+}
+
+static CrucibleVcpuService *crucible_vcpu_service_for(CPUState *cpu)
+{
+    if (!crucible_vcpu_services || !cpu || cpu->cpu_index < 0 ||
+        (guint)cpu->cpu_index >= crucible_vcpu_services->len) {
+        return NULL;
+    }
+    return &g_array_index(crucible_vcpu_services,
+                          CrucibleVcpuService, cpu->cpu_index);
+}
+
+bool qemu_crucible_fault_vcpu_service_eligible(CPUState *cpu)
+{
+    CrucibleVcpuService *service = crucible_vcpu_service_for(cpu);
+
+    if (qemu_crucible_fault_cpu_memory_tickets_exist &&
+        qemu_crucible_fault_cpu_memory_ticket_pending(cpu)) {
+        return false;
+    }
+    if (crucible_vcpu_service_mode() && cpu &&
+        (qemu_crucible_fault_node_hung() ||
+         qemu_crucible_fault_vcpu_hung(cpu->cpu_index))) {
+        return false;
+    }
+    if (!crucible_vcpu_service_mode() || !service) {
+        return true;
+    }
+    return service->state == CRUCIBLE_VCPU_ONLINE;
+}
+
+void qemu_crucible_fault_vcpu_service_skipped(CPUState *cpu)
+{
+    CrucibleVcpuService *service = crucible_vcpu_service_for(cpu);
+
+    if (crucible_vcpu_service_mode() && service &&
+        service->skipped_selections != UINT64_MAX) {
+        service->skipped_selections++;
+    }
+}
+
+static void crucible_vcpu_sha256(const uint8_t *data, size_t length,
+                                 uint8_t digest[32])
+{
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    gsize digest_length = 32;
+
+    g_checksum_update(checksum, data, length);
+    g_checksum_get_digest(checksum, digest, &digest_length);
+    g_assert(digest_length == 32);
+}
+
+static void crucible_vcpu_state_event(
+    uint32_t vcpu, uint32_t old_state, const CrucibleVcpuService *service,
+    const QemuCrucibleFaultRule *transition_rule,
+    QemuCrucibleFaultEventReservation **event_reservation)
+{
+    struct qemu_plugin_rr_cursor rr = { 0 };
+    uint8_t evidence[CRUCIBLE_VCPU_STATE_EVIDENCE_BYTES] = { 0 };
+    uint8_t snapshot[CRUCIBLE_VCPU_STATE_EVIDENCE_BYTES];
+    uint8_t before_hash[32], after_hash[32], opportunity_hash[32];
+    const uint8_t *recovery_hash;
+    uint32_t recovery_length;
+    bool has_recovery_field = crucible_vcpu_field(
+        transition_rule, CRUCIBLE_NODE_FAULT_FIELD_P3,
+        CRUCIBLE_NODE_FAULT_FIELD_TYPE_HASH,
+        &recovery_hash, &recovery_length) && recovery_length == 32;
+    bool has_recovery = false;
+
+    if (has_recovery_field) {
+        for (size_t i = 0; i < recovery_length; i++) {
+            has_recovery |= recovery_hash[i] != 0;
+        }
+    }
+
+    if (qemu_plugin_rr_cursor(&rr) != 0) {
+        rr.current_vcpu = icount_crucible_rr_current_vcpu();
+        rr.cursor_position = qemu_crucible_internal_rr_cursor_position();
+        rr.rr_switch_quantum = icount_crucible_rr_switch_quantum();
+    }
+    memcpy(evidence, "CRUCVST1", 8);
+    stw_le_p(evidence + 8, 1);
+    stw_le_p(evidence + 10,
+             qemu_crucible_fault_rule_operation(transition_rule));
+    stl_le_p(evidence + 12, vcpu);
+    stl_le_p(evidence + 16, old_state);
+    stl_le_p(evidence + 20, service->state);
+    stq_le_p(evidence + 24, qemu_plugin_icount_raw());
+    stq_le_p(evidence + 32, rr.current_vcpu);
+    stq_le_p(evidence + 40, rr.cursor_position);
+    stq_le_p(evidence + 48, rr.rr_switch_quantum);
+    stq_le_p(evidence + 56, service->numerator);
+    stq_le_p(evidence + 64, service->denominator);
+    stq_le_p(evidence + 72, service->quantum);
+    stq_le_p(evidence + 80, service->credit_remaining);
+    stq_le_p(evidence + 88, service->remainder);
+    stq_le_p(evidence + 96, service->window_sequence);
+    stq_le_p(evidence + 104, service->skipped_selections);
+    stq_le_p(evidence + 112,
+             service->controller_rule ?
+                 qemu_crucible_fault_rule_generation(
+                     service->controller_rule) : 0);
+    stl_le_p(evidence + 120, has_recovery);
+    stl_le_p(evidence + 124,
+             service->service_rules ? service->service_rules->len : 0);
+    if (has_recovery) {
+        memcpy(evidence + 128, recovery_hash, 32);
+    }
+    memcpy(evidence + 160,
+           qemu_crucible_fault_rule_binding_hash(transition_rule), 32);
+
+    memcpy(snapshot, evidence, sizeof(snapshot));
+    memcpy(snapshot, "CRUCVSB1", 8);
+    stl_le_p(snapshot + 20, old_state);
+    crucible_vcpu_sha256(snapshot, sizeof(snapshot), before_hash);
+    memcpy(snapshot, evidence, sizeof(snapshot));
+    memcpy(snapshot, "CRUCVSA1", 8);
+    stl_le_p(snapshot + 16, service->state);
+    crucible_vcpu_sha256(snapshot, sizeof(snapshot), after_hash);
+    crucible_vcpu_sha256(evidence, sizeof(evidence), opportunity_hash);
+
+    qemu_crucible_fault_event_reservation_consume(*event_reservation);
+    qemu_crucible_fault_rule_event(
+        transition_rule, CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED,
+        qemu_plugin_icount_raw(), opportunity_hash,
+        before_hash, after_hash, evidence, sizeof(evidence));
+    qemu_crucible_fault_event_reservation_release(*event_reservation);
+    *event_reservation = NULL;
+}
+
+static void crucible_vcpu_window_event(CPUState *cpu,
+                                       CrucibleVcpuService *service,
+                                       uint64_t remainder_before,
+                                       int64_t virtual_before,
+                                       int64_t virtual_after,
+                                       bool configuration_interrupted)
+{
+    struct qemu_plugin_rr_cursor rr = { 0 };
+    uint8_t evidence[CRUCIBLE_VCPU_SERVICE_EVIDENCE_BYTES] = { 0 };
+    uint8_t before_hash[32], after_hash[32], opportunity_hash[32];
+
+    if (crucible_vcpu_service_terminal ||
+        service->service_rules->len == 0) {
+        return;
+    }
+    if (!service->window_reservation) {
+        error_report("Crucible vCPU service window lost its event "
+                     "reservation");
+        abort();
+    }
+    if (qemu_plugin_rr_cursor(&rr) != 0) {
+        rr.current_vcpu = icount_crucible_rr_current_vcpu();
+        rr.cursor_position = qemu_crucible_internal_rr_cursor_position();
+        rr.rr_switch_quantum = icount_crucible_rr_switch_quantum();
+    }
+    /* Version 2 records exact ps ticks at 88 and 96; 112 remains raw icount. */
+    memcpy(evidence, "CRUCVCS2", 8);
+    stl_le_p(evidence + 8, cpu->cpu_index);
+    stl_le_p(evidence + 12, service->discipline);
+    stq_le_p(evidence + 16, ++service->window_sequence);
+    stq_le_p(evidence + 24, service->numerator);
+    stq_le_p(evidence + 32, service->denominator);
+    stq_le_p(evidence + 40, service->quantum);
+    stq_le_p(evidence + 48, remainder_before);
+    stq_le_p(evidence + 56, service->remainder);
+    stq_le_p(evidence + 64, service->window_credit);
+    stq_le_p(evidence + 72, service->window_retired);
+    stq_le_p(evidence + 80, service->denied_pending);
+    stq_le_p(evidence + 88, virtual_before);
+    stq_le_p(evidence + 96, virtual_after);
+    stq_le_p(evidence + 104, service->skipped_selections);
+    stq_le_p(evidence + 112, qemu_plugin_icount_raw());
+    stl_le_p(evidence + 120, service->state);
+    stl_le_p(evidence + 124, service->service_rules->len);
+    stq_le_p(evidence + 128, service->window_own_retired);
+    stq_le_p(evidence + 136, service->window_borrowed_retired);
+    stq_le_p(evidence + 144, service->donated_credit);
+    stq_le_p(evidence + 152,
+             service->controller_rule ?
+                 qemu_crucible_fault_rule_generation(
+                     service->controller_rule) : 0);
+    stq_le_p(evidence + 160, rr.current_vcpu);
+    stq_le_p(evidence + 168, rr.cursor_position);
+    stq_le_p(evidence + 176, rr.rr_switch_quantum);
+    stl_le_p(evidence + 184,
+             (service->grant_own != 0) |
+             (configuration_interrupted ? 2U : 0U));
+    stl_le_p(evidence + 188, service->grant_borrowed != 0);
+    crucible_vcpu_sha256(evidence, 64, before_hash);
+    crucible_vcpu_sha256(evidence, 160, after_hash);
+    crucible_vcpu_sha256(evidence, sizeof(evidence), opportunity_hash);
+    for (guint index = 0; index < service->service_rules->len; index++) {
+        qemu_crucible_fault_event_reservation_consume(
+            service->window_reservation);
+        qemu_crucible_fault_rule_event(
+            g_ptr_array_index(service->service_rules, index),
+            CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED,
+            qemu_plugin_icount_raw(), opportunity_hash,
+            before_hash, after_hash, evidence, sizeof(evidence));
+    }
+    qemu_crucible_fault_event_reservation_release(
+        service->window_reservation);
+    service->window_reservation = NULL;
+    service->skipped_selections = 0;
+}
+
+static bool crucible_vcpu_reserve_window(CrucibleVcpuService *service)
+{
+    uint8_t evidence[64] = { 0 };
+    uint8_t digest[32];
+    QemuCrucibleFaultRule *rule;
+
+    g_assert(service->service_rules->len != 0);
+    g_assert(!service->window_reservation);
+    service->window_reservation = qemu_crucible_fault_event_reserve(
+        service->service_rules->len);
+    if (service->window_reservation) {
+        return true;
+    }
+    rule = g_ptr_array_index(service->service_rules, 0);
+    memcpy(evidence, "CRUCVCL1", 8);
+    stq_le_p(evidence + 8, service->service_rules->len);
+    stq_le_p(evidence + 16, service->window_sequence + 1);
+    stq_le_p(evidence + 24, qemu_plugin_icount_raw());
+    crucible_vcpu_sha256(evidence, sizeof(evidence), digest);
+    qemu_crucible_fault_rule_event(
+        rule, CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR,
+        qemu_plugin_icount_raw(), digest, digest, digest,
+        evidence, sizeof(evidence));
+    qemu_crucible_fault_vcpu_service_event_terminal();
+    qemu_system_vmstop_request_prepare();
+    qemu_system_vmstop_request(RUN_STATE_INTERNAL_ERROR);
+    return false;
+}
+
+static void crucible_vcpu_close_window(CPUState *cpu,
+                                       CrucibleVcpuService *service,
+                                       uint64_t remainder_before)
+{
+    int64_t before = icount_crucible_sim_tick_observed();
+    int64_t after;
+    uint64_t denied_ticks;
+
+    /* Service credits are instructions; the sim clock advances in ps ticks. */
+    if (before < 0 || service->denied_pending >
+            INT64_MAX / CRUCIBLE_SIM_TICKS_PER_INSTRUCTION) {
+        abort();
+    }
+    denied_ticks = service->denied_pending *
+                   CRUCIBLE_SIM_TICKS_PER_INSTRUCTION;
+    if (!icount_crucible_advance_virtual_time_by_ticks(denied_ticks)) {
+        abort();
+    }
+    after = icount_crucible_sim_tick_observed();
+    if (after < 0) {
+        abort();
+    }
+    crucible_vcpu_window_event(cpu, service, remainder_before, before, after,
+                               false);
+    service->window_credit = 0;
+    service->window_retired = 0;
+    service->denied_pending = 0;
+    service->window_own_retired = 0;
+    service->window_borrowed_retired = 0;
+}
+
+static void crucible_vcpu_interrupt_window(CPUState *cpu,
+                                           CrucibleVcpuService *service)
+{
+    int64_t now;
+
+    if (!service->window_reservation) {
+        return;
+    }
+    now = icount_crucible_sim_tick_observed();
+    if (now < 0) {
+        abort();
+    }
+    service->grant_own = 0;
+    service->grant_borrowed = 0;
+    crucible_vcpu_window_event(cpu, service,
+                               service->window_remainder_before,
+                               now, now, true);
+}
+
+static bool crucible_vcpu_refill(CPUState *cpu,
+                                 CrucibleVcpuService *service)
+{
+    __uint128_t scaled = (__uint128_t)service->quantum *
+                         service->numerator + service->remainder;
+
+    if (!crucible_vcpu_reserve_window(service)) {
+        return false;
+    }
+    service->donated_credit = 0;
+    service->window_remainder_before = service->remainder;
+    service->credit_remaining = scaled / service->denominator;
+    service->remainder = scaled % service->denominator;
+    service->window_credit = service->credit_remaining;
+    service->denied_pending = service->quantum - service->credit_remaining;
+    if (service->credit_remaining == 0) {
+        crucible_vcpu_close_window(
+            cpu, service, service->window_remainder_before);
+    }
+    return true;
+}
+
+static uint64_t crucible_vcpu_available_donations(
+    const CrucibleVcpuService *recipient, uint32_t recipient_vcpu)
+{
+    __uint128_t total = 0;
+
+    if (!recipient->controller_rule ||
+        recipient->discipline != CRUCIBLE_VCPU_WORK_CONSERVING) {
+        return 0;
+    }
+    for (guint i = 0; i < crucible_vcpu_services->len; i++) {
+        const CrucibleVcpuService *donor = &g_array_index(
+            crucible_vcpu_services, CrucibleVcpuService, i);
+
+        if (i != recipient_vcpu &&
+            donor->controller_rule == recipient->controller_rule &&
+            donor->discipline == CRUCIBLE_VCPU_WORK_CONSERVING) {
+            total += donor->donated_credit;
+        }
+    }
+    return total > UINT64_MAX ? UINT64_MAX : (uint64_t)total;
+}
+
+static void crucible_vcpu_consume_donations(
+    const CrucibleVcpuService *recipient, uint32_t recipient_vcpu,
+    uint64_t amount)
+{
+    for (guint i = 0;
+         i < crucible_vcpu_services->len && amount != 0; i++) {
+        CrucibleVcpuService *donor = &g_array_index(
+            crucible_vcpu_services, CrucibleVcpuService, i);
+        uint64_t consumed;
+
+        if (i == recipient_vcpu ||
+            donor->controller_rule != recipient->controller_rule ||
+            donor->discipline != CRUCIBLE_VCPU_WORK_CONSERVING) {
+            continue;
+        }
+        consumed = MIN(amount, donor->donated_credit);
+        donor->donated_credit -= consumed;
+        amount -= consumed;
+    }
+    if (amount != 0) {
+        error_report("Crucible vCPU service donation ledger underflow");
+        abort();
+    }
+}
+
+int64_t qemu_crucible_fault_vcpu_service_clamp_budget(
+    CPUState *cpu, int64_t budget)
+{
+    CrucibleVcpuService *service = crucible_vcpu_service_for(cpu);
+    uint64_t borrow_available, remaining_budget;
+
+    if (!crucible_vcpu_service_mode() || !service || budget <= 0 ||
+        service->service_rules->len == 0) {
+        return budget;
+    }
+    if (service->state != CRUCIBLE_VCPU_ONLINE) {
+        return 0;
+    }
+    service->grant_own = 0;
+    service->grant_borrowed = 0;
+    if (service->credit_remaining == 0) {
+        if (!crucible_vcpu_refill(cpu, service)) {
+            return 0;
+        }
+        if (service->credit_remaining == 0) {
+            return 0;
+        }
+    }
+    service->grant_own = MIN((uint64_t)budget,
+                             service->credit_remaining);
+    remaining_budget = (uint64_t)budget - service->grant_own;
+    borrow_available = crucible_vcpu_available_donations(
+        service, cpu->cpu_index);
+    service->grant_borrowed = MIN(remaining_budget, borrow_available);
+    return service->grant_own + service->grant_borrowed;
+}
+
+void qemu_crucible_fault_vcpu_service_account(
+    CPUState *cpu, uint64_t before_icount, uint64_t after_icount,
+    bool runnable_after)
+{
+    CrucibleVcpuService *service = crucible_vcpu_service_for(cpu);
+    uint64_t retired, own, borrowed;
+
+    if (!crucible_vcpu_service_mode() || !service ||
+        service->service_rules->len == 0) {
+        return;
+    }
+    if (after_icount < before_icount) {
+        abort();
+    }
+    retired = after_icount - before_icount;
+    if (retired > service->grant_own + service->grant_borrowed) {
+        abort();
+    }
+    own = MIN(retired, service->grant_own);
+    borrowed = retired - own;
+    if (own > service->credit_remaining ||
+        borrowed > crucible_vcpu_available_donations(
+            service, cpu->cpu_index)) {
+        abort();
+    }
+    service->credit_remaining -= own;
+    crucible_vcpu_consume_donations(service, cpu->cpu_index, borrowed);
+    service->window_retired += retired;
+    service->window_own_retired += own;
+    service->window_borrowed_retired += borrowed;
+    service->grant_own = 0;
+    service->grant_borrowed = 0;
+    if (!runnable_after && service->credit_remaining != 0 &&
+        service->discipline == CRUCIBLE_VCPU_WORK_CONSERVING) {
+        service->donated_credit = service->credit_remaining;
+        service->credit_remaining = 0;
+    }
+    if (service->credit_remaining == 0) {
+        crucible_vcpu_close_window(
+            cpu, service, service->window_remainder_before);
+    }
+}
+
+void qemu_crucible_fault_vcpu_service_event_terminal(void)
+{
+    if (crucible_vcpu_service_terminal) {
+        return;
+    }
+    crucible_vcpu_service_terminal = true;
+    if (!crucible_vcpu_services) {
+        return;
+    }
+    for (guint i = 0; i < crucible_vcpu_services->len; i++) {
+        CrucibleVcpuService *service = &g_array_index(
+            crucible_vcpu_services, CrucibleVcpuService, i);
+
+        if (service->window_reservation) {
+            qemu_crucible_fault_event_reservation_release(
+                service->window_reservation);
+            service->window_reservation = NULL;
+        }
+        service->grant_own = 0;
+        service->grant_borrowed = 0;
+        service->donated_credit = 0;
+    }
+}
+
+static void crucible_vcpu_vmstate_free(void *opaque)
+{
+    CrucibleVcpuVmstate *state = opaque;
+
+    if (!state) {
+        return;
+    }
+    if (state->services) {
+        for (guint i = 0; i < state->services->len; i++) {
+            crucible_vcpu_service_clear(&g_array_index(
+                state->services, CrucibleVcpuService, i));
+        }
+        g_array_unref(state->services);
+    }
+    g_clear_pointer(&state->reservation_remaining, g_array_unref);
+    g_free(state);
+}
+
+static void crucible_vcpu_vmstate_put_service(
+    GByteArray *payload, const CrucibleVcpuService *service)
+{
+#define PUT(field) qemu_crucible_fault_vmstate_put_u64(payload, service->field)
+    PUT(numerator);
+    PUT(denominator);
+    PUT(quantum);
+    PUT(remainder);
+    PUT(window_remainder_before);
+    PUT(credit_remaining);
+    PUT(window_credit);
+    PUT(window_retired);
+    PUT(denied_pending);
+    PUT(skipped_selections);
+    PUT(window_sequence);
+    PUT(grant_own);
+    PUT(grant_borrowed);
+    PUT(window_own_retired);
+    PUT(window_borrowed_retired);
+    PUT(donated_credit);
+#undef PUT
+    qemu_crucible_fault_vmstate_put_u32(payload, service->discipline);
+    qemu_crucible_fault_vmstate_put_u32(payload, service->state);
+}
+
+static bool crucible_vcpu_vmstate_get_service(
+    QemuCrucibleFaultVmstateReader *reader, CrucibleVcpuService *service)
+{
+#define GET(field) \
+    qemu_crucible_fault_vmstate_get_u64(reader, &service->field)
+    if (!GET(numerator) || !GET(denominator) || !GET(quantum) ||
+        !GET(remainder) || !GET(window_remainder_before) ||
+        !GET(credit_remaining) || !GET(window_credit) ||
+        !GET(window_retired) || !GET(denied_pending) ||
+        !GET(skipped_selections) || !GET(window_sequence) ||
+        !GET(grant_own) || !GET(grant_borrowed) ||
+        !GET(window_own_retired) || !GET(window_borrowed_retired) ||
+        !GET(donated_credit) ||
+        !qemu_crucible_fault_vmstate_get_u32(reader,
+                                              &service->discipline) ||
+        !qemu_crucible_fault_vmstate_get_u32(reader, &service->state)) {
+        return false;
+    }
+#undef GET
+    return service->numerator != 0 && service->denominator != 0 &&
+           service->numerator <= service->denominator &&
+           service->quantum != 0 && service->remainder < service->denominator &&
+           service->discipline >= CRUCIBLE_VCPU_WORK_CONSERVING &&
+           service->discipline <= CRUCIBLE_VCPU_STRICT_CAP &&
+           service->state >= CRUCIBLE_VCPU_ONLINE &&
+           service->state <= CRUCIBLE_VCPU_STALLED;
+}
+
+static bool crucible_vcpu_vmstate_configuration_valid(
+    const CrucibleVcpuService *service, uint32_t vcpu)
+{
+    uint64_t numerator = 1, denominator = 1;
+    uint64_t quantum = icount_crucible_rr_switch_quantum();
+    uint32_t discipline = CRUCIBLE_VCPU_STRICT_CAP;
+    QemuCrucibleFaultRule *controller = NULL;
+
+    for (guint i = 0; i < service->service_rules->len; i++) {
+        QemuCrucibleFaultRule *rule = g_ptr_array_index(
+            service->service_rules, i);
+        uint64_t next_numerator, next_denominator, next_quantum;
+        uint32_t next_discipline;
+        bool first = i == 0;
+
+        if (qemu_crucible_fault_rule_command_kind(rule) !=
+                CRUCIBLE_FAULT_COMMAND_CPU_SERVICE ||
+            !crucible_vcpu_rule_selects(rule, vcpu) ||
+            !crucible_vcpu_ratio(rule, &next_numerator, &next_denominator) ||
+            !crucible_vcpu_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_P3,
+                               &next_quantum) ||
+            !crucible_vcpu_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P4,
+                               &next_discipline)) {
+            return false;
+        }
+        if (first || crucible_vcpu_ratio_less(
+                next_numerator, next_denominator, numerator, denominator)) {
+            numerator = next_numerator;
+            denominator = next_denominator;
+            quantum = next_quantum;
+            discipline = next_discipline;
+            controller = rule;
+        } else if (!crucible_vcpu_ratio_less(
+                       numerator, denominator,
+                       next_numerator, next_denominator)) {
+            quantum = MIN(quantum, next_quantum);
+            if (next_discipline > discipline) {
+                discipline = next_discipline;
+                controller = rule;
+            }
+        }
+    }
+    if (service->state_rule) {
+        uint32_t target, state;
+
+        if (qemu_crucible_fault_rule_command_kind(service->state_rule) !=
+                CRUCIBLE_FAULT_COMMAND_CPU_VCPU_STATE ||
+            !crucible_vcpu_target(service->state_rule, &target) ||
+            target != vcpu ||
+            !crucible_vcpu_u32(service->state_rule,
+                               CRUCIBLE_NODE_FAULT_FIELD_P1, &state) ||
+            state != service->state) {
+            return false;
+        }
+    } else if (service->state != CRUCIBLE_VCPU_ONLINE) {
+        return false;
+    }
+    return service->numerator == numerator &&
+           service->denominator == denominator &&
+           service->quantum == quantum &&
+           service->discipline == discipline &&
+           service->controller_rule == controller;
+}
+
+static bool crucible_vcpu_vmstate_ledger_valid(
+    const CrucibleVcpuService *service, uint32_t reservation, bool terminal)
+{
+    __uint128_t scaled = (__uint128_t)service->quantum *
+                         service->numerator +
+                         service->window_remainder_before;
+    uint64_t expected_credit = scaled / service->denominator;
+    uint64_t expected_remainder = scaled % service->denominator;
+    bool has_window = service->window_credit != 0 ||
+                      service->window_retired != 0 ||
+                      service->denied_pending != 0 ||
+                      service->window_own_retired != 0 ||
+                      service->window_borrowed_retired != 0 ||
+                      service->credit_remaining != 0;
+
+    if (service->grant_own != 0 || service->grant_borrowed != 0 ||
+        service->window_remainder_before >= service->denominator ||
+        service->window_retired == UINT64_MAX ||
+        service->window_own_retired == UINT64_MAX ||
+        service->window_borrowed_retired == UINT64_MAX ||
+        service->window_sequence == UINT64_MAX ||
+        service->window_own_retired > UINT64_MAX -
+            service->window_borrowed_retired ||
+        service->window_retired != service->window_own_retired +
+            service->window_borrowed_retired) {
+        return false;
+    }
+    if (has_window) {
+        if ((!terminal && reservation != service->service_rules->len) ||
+            (terminal && reservation != 0) ||
+            service->service_rules->len == 0 ||
+            service->window_credit == 0 ||
+            service->credit_remaining == 0 ||
+            service->donated_credit != 0 ||
+            service->window_credit != expected_credit ||
+            service->remainder != expected_remainder ||
+            service->window_credit > service->quantum ||
+            service->denied_pending != service->quantum -
+                service->window_credit ||
+            service->window_own_retired > service->window_credit ||
+            service->credit_remaining != service->window_credit -
+                service->window_own_retired) {
+            return false;
+        }
+    } else if (reservation != 0 || service->credit_remaining != 0 ||
+               service->window_credit != 0 ||
+               service->window_retired != 0 ||
+               service->denied_pending != 0 ||
+               service->window_own_retired != 0 ||
+               service->window_borrowed_retired != 0) {
+        return false;
+    }
+    if (service->donated_credit != 0 &&
+        (terminal || has_window || service->service_rules->len == 0 ||
+         !service->controller_rule ||
+         service->discipline != CRUCIBLE_VCPU_WORK_CONSERVING ||
+         service->donated_credit > service->quantum)) {
+        return false;
+    }
+    return true;
+}
+
+typedef struct CrucibleVcpuVmstateCoverage {
+    GArray *services;
+    GArray *expected_state;
+    GPtrArray *expected_state_rule;
+    bool valid;
+} CrucibleVcpuVmstateCoverage;
+
+static void crucible_vcpu_vmstate_service_rule_coverage(
+    const QemuCrucibleFaultRule *rule, void *opaque)
+{
+    CrucibleVcpuVmstateCoverage *coverage = opaque;
+
+    for (guint vcpu = 0; vcpu < coverage->services->len; vcpu++) {
+        CrucibleVcpuService *service = &g_array_index(
+            coverage->services, CrucibleVcpuService, vcpu);
+        bool present = g_ptr_array_find(
+            service->service_rules, (gpointer)rule, NULL);
+
+        if (present != crucible_vcpu_rule_selects(rule, vcpu)) {
+            coverage->valid = false;
+        }
+    }
+}
+
+static void crucible_vcpu_vmstate_state_rule_coverage(
+    const QemuCrucibleFaultRule *rule, void *opaque)
+{
+    CrucibleVcpuVmstateCoverage *coverage = opaque;
+    uint32_t target, state;
+
+    if (!crucible_vcpu_target(rule, &target) ||
+        target >= coverage->services->len ||
+        !crucible_vcpu_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P1, &state)) {
+        coverage->valid = false;
+        return;
+    }
+    uint32_t *expected = &g_array_index(
+        coverage->expected_state, uint32_t, target);
+    if ((state == CRUCIBLE_VCPU_OFFLINE &&
+         *expected != CRUCIBLE_VCPU_OFFLINE) ||
+        (*expected == CRUCIBLE_VCPU_ONLINE &&
+         state == CRUCIBLE_VCPU_STALLED)) {
+        *expected = state;
+        g_ptr_array_index(coverage->expected_state_rule, target) =
+            (gpointer)rule;
+    }
+}
+
+static int crucible_vcpu_vmstate_save(GByteArray *payload)
+{
+    size_t count = crucible_vcpu_count();
+
+    if (count == 0 || count > CRUCIBLE_VCPU_SERVICE_MAX_VCPUS ||
+        (crucible_vcpu_services && crucible_vcpu_services->len != count)) {
+        return -EINVAL;
+    }
+    qemu_crucible_fault_vmstate_put_bytes(payload, "CRUCVVS1", 8);
+    qemu_crucible_fault_vmstate_put_u32(payload, count);
+    qemu_crucible_fault_vmstate_put_u8(payload,
+                                       crucible_vcpu_service_terminal);
+    qemu_crucible_fault_vmstate_put_u8(payload, 0);
+    qemu_crucible_fault_vmstate_put_u16(payload, 0);
+    for (uint32_t i = 0; i < count; i++) {
+        CrucibleVcpuService canonical_unconfigured;
+        CrucibleVcpuService *service;
+        size_t reservation;
+
+        if (crucible_vcpu_services) {
+            service = &g_array_index(crucible_vcpu_services,
+                                     CrucibleVcpuService, i);
+        } else {
+            /*
+             * A NULL array is the canonical state before any service rule
+             * change. Service callbacks cannot mutate accounting without an
+             * array, and this is the exact state installed for an empty rule
+             * set, so make that authority explicit in the saved image.
+             */
+            crucible_vcpu_service_init(&canonical_unconfigured);
+            service = &canonical_unconfigured;
+        }
+        reservation = qemu_crucible_fault_event_reservation_remaining(
+            service->window_reservation);
+        if (reservation > UINT32_MAX ||
+            (reservation != 0 &&
+             reservation != service->service_rules->len) ||
+            !crucible_vcpu_vmstate_ledger_valid(
+                service, reservation, crucible_vcpu_service_terminal)) {
+            if (!crucible_vcpu_services) {
+                crucible_vcpu_service_clear(&canonical_unconfigured);
+            }
+            return service->grant_own != 0 ||
+                   service->grant_borrowed != 0 ? -EBUSY : -EINVAL;
+        }
+        crucible_vcpu_vmstate_put_service(payload, service);
+        qemu_crucible_fault_vmstate_put_u32(
+            payload, service->service_rules->len);
+        qemu_crucible_fault_vmstate_put_u8(
+            payload, service->controller_rule != NULL);
+        qemu_crucible_fault_vmstate_put_u8(payload,
+                                           service->state_rule != NULL);
+        qemu_crucible_fault_vmstate_put_u16(payload, 0);
+        qemu_crucible_fault_vmstate_put_u32(payload, reservation);
+        qemu_crucible_fault_vmstate_put_u32(payload, 0);
+        for (guint rule_index = 0;
+             rule_index < service->service_rules->len; rule_index++) {
+            qemu_crucible_fault_rule_reference_vmstate_save(
+                payload, g_ptr_array_index(service->service_rules,
+                                            rule_index));
+        }
+        if (service->controller_rule) {
+            qemu_crucible_fault_rule_reference_vmstate_save(
+                payload, service->controller_rule);
+        }
+        if (service->state_rule) {
+            qemu_crucible_fault_rule_reference_vmstate_save(
+                payload, service->state_rule);
+        }
+        if (!crucible_vcpu_services) {
+            crucible_vcpu_service_clear(&canonical_unconfigured);
+        }
+    }
+    return 0;
+}
+
+static int crucible_vcpu_vmstate_prepare(const uint8_t *payload,
+                                         size_t payload_len,
+                                         void **staged_out)
+{
+    QemuCrucibleFaultVmstateReader reader = {
+        .data = payload,
+        .length = payload_len,
+    };
+    CrucibleVcpuVmstate *state = g_new0(CrucibleVcpuVmstate, 1);
+    uint8_t magic[8], terminal, reserved8;
+    uint16_t reserved16;
+    uint32_t count;
+
+    if (!qemu_crucible_fault_vmstate_get_bytes(&reader, magic, 8) ||
+        memcmp(magic, "CRUCVVS1", 8) != 0 ||
+        !qemu_crucible_fault_vmstate_get_u32(&reader, &count) ||
+        !qemu_crucible_fault_vmstate_get_u8(&reader, &terminal) ||
+        !qemu_crucible_fault_vmstate_get_u8(&reader, &reserved8) ||
+        !qemu_crucible_fault_vmstate_get_u16(&reader, &reserved16) ||
+        count != crucible_vcpu_count() || terminal > 1 ||
+        reserved8 != 0 || reserved16 != 0) {
+        goto fail;
+    }
+    state->terminal = terminal;
+    state->services = g_array_sized_new(
+        false, true, sizeof(CrucibleVcpuService), count);
+    state->reservation_remaining = g_array_sized_new(
+        false, true, sizeof(uint32_t), count);
+    g_array_set_size(state->services, count);
+    for (uint32_t i = 0; i < count; i++) {
+        CrucibleVcpuService *service = &g_array_index(
+            state->services, CrucibleVcpuService, i);
+        uint8_t has_controller, has_state;
+        uint16_t reserved;
+        uint32_t rule_count, reservation, reserved32;
+
+        service->service_rules = g_ptr_array_new_with_free_func(
+            (GDestroyNotify)qemu_crucible_fault_rule_unref);
+        if (!crucible_vcpu_vmstate_get_service(&reader, service) ||
+            !qemu_crucible_fault_vmstate_get_u32(&reader, &rule_count) ||
+            !qemu_crucible_fault_vmstate_get_u8(
+                &reader, &has_controller) ||
+            !qemu_crucible_fault_vmstate_get_u8(&reader, &has_state) ||
+            !qemu_crucible_fault_vmstate_get_u16(&reader, &reserved) ||
+            !qemu_crucible_fault_vmstate_get_u32(
+                &reader, &reservation) ||
+            !qemu_crucible_fault_vmstate_get_u32(&reader, &reserved32) ||
+            rule_count > CRUCIBLE_FAULT_DEFAULT_COMMAND_CAPACITY ||
+            has_controller > 1 || has_state > 1 || reserved != 0 ||
+            reserved32 != 0 ||
+            (reservation != 0 && reservation != rule_count)) {
+            goto fail;
+        }
+        for (uint32_t rule_index = 0; rule_index < rule_count; rule_index++) {
+            QemuCrucibleFaultRule *rule =
+                qemu_crucible_fault_rule_reference_vmstate_load(&reader);
+
+            if (!rule || g_ptr_array_find(service->service_rules,
+                                          rule, NULL)) {
+                qemu_crucible_fault_rule_unref(rule);
+                goto fail;
+            }
+            g_ptr_array_add(service->service_rules, rule);
+        }
+        if (has_controller) {
+            QemuCrucibleFaultRule *controller =
+                qemu_crucible_fault_rule_reference_vmstate_load(&reader);
+
+            if (!controller || !g_ptr_array_find(
+                    service->service_rules, controller, NULL)) {
+                qemu_crucible_fault_rule_unref(controller);
+                goto fail;
+            }
+            service->controller_rule = controller;
+            qemu_crucible_fault_rule_unref(controller);
+        }
+        if (has_state) {
+            service->state_rule =
+                qemu_crucible_fault_rule_reference_vmstate_load(&reader);
+            if (!service->state_rule) {
+                goto fail;
+            }
+        }
+        if (!crucible_vcpu_vmstate_configuration_valid(service, i)) {
+            goto fail;
+        }
+        if (!crucible_vcpu_vmstate_ledger_valid(
+                service, reservation, state->terminal)) {
+            goto fail;
+        }
+        g_array_append_val(state->reservation_remaining, reservation);
+    }
+    CrucibleVcpuVmstateCoverage coverage = {
+        .services = state->services,
+        .expected_state = g_array_sized_new(
+            false, true, sizeof(uint32_t), count),
+        .expected_state_rule = g_ptr_array_sized_new(count),
+        .valid = true,
+    };
+    g_array_set_size(coverage.expected_state, count);
+    g_ptr_array_set_size(coverage.expected_state_rule, count);
+    for (uint32_t i = 0; i < count; i++) {
+        g_array_index(coverage.expected_state, uint32_t, i) =
+            CRUCIBLE_VCPU_ONLINE;
+    }
+    if (!qemu_crucible_fault_rule_foreach_staged(
+            CRUCIBLE_FAULT_COMMAND_CPU_SERVICE,
+            crucible_vcpu_vmstate_service_rule_coverage, &coverage) ||
+        !qemu_crucible_fault_rule_foreach_staged(
+            CRUCIBLE_FAULT_COMMAND_CPU_VCPU_STATE,
+            crucible_vcpu_vmstate_state_rule_coverage, &coverage) ||
+        !coverage.valid) {
+        g_array_unref(coverage.expected_state);
+        g_ptr_array_unref(coverage.expected_state_rule);
+        goto fail;
+    }
+    for (uint32_t i = 0; i < count; i++) {
+        CrucibleVcpuService *service = &g_array_index(
+            state->services, CrucibleVcpuService, i);
+
+        if (service->state != g_array_index(
+                coverage.expected_state, uint32_t, i) ||
+            service->state_rule != g_ptr_array_index(
+                coverage.expected_state_rule, i)) {
+            coverage.valid = false;
+            break;
+        }
+    }
+    g_array_unref(coverage.expected_state);
+    g_ptr_array_unref(coverage.expected_state_rule);
+    if (!coverage.valid) {
+        goto fail;
+    }
+    if (!qemu_crucible_fault_vmstate_reader_finished(&reader)) {
+        goto fail;
+    }
+    for (guint i = 0; i < state->reservation_remaining->len; i++) {
+        uint32_t remaining = g_array_index(
+            state->reservation_remaining, uint32_t, i);
+
+        qemu_crucible_fault_vmstate_count_reservations(remaining);
+        if (remaining != 0) {
+            CrucibleVcpuService *service = &g_array_index(
+                state->services, CrucibleVcpuService, i);
+
+            service->window_reservation =
+                qemu_crucible_fault_event_reservation_restore(remaining);
+            if (!service->window_reservation) {
+                goto fail;
+            }
+        }
+    }
+    *staged_out = state;
+    return 0;
+
+fail:
+    crucible_vcpu_vmstate_free(state);
+    return -EINVAL;
+}
+
+static void crucible_vcpu_vmstate_commit(void *opaque)
+{
+    CrucibleVcpuVmstate *state = opaque;
+
+    if (crucible_vcpu_services) {
+        for (guint i = 0; i < crucible_vcpu_services->len; i++) {
+            crucible_vcpu_service_clear(&g_array_index(
+                crucible_vcpu_services, CrucibleVcpuService, i));
+        }
+        g_array_unref(crucible_vcpu_services);
+    }
+    crucible_vcpu_services = g_steal_pointer(&state->services);
+    crucible_vcpu_service_terminal = state->terminal;
+    crucible_vcpu_vmstate_free(state);
+}
+
+static const QemuCrucibleFaultVmstateSection
+crucible_vcpu_vmstate_section = {
+    .name = "vcpu-service",
+    .version = 1,
+    .save = crucible_vcpu_vmstate_save,
+    .fingerprint_projection = crucible_vcpu_vmstate_save,
+    .prepare = crucible_vcpu_vmstate_prepare,
+    .commit = crucible_vcpu_vmstate_commit,
+    .free_staged = crucible_vcpu_vmstate_free,
+};
+
+static void crucible_vcpu_service_register(void)
+{
+    const uint32_t boundary =
+        1U << (CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY - 1);
+
+    qemu_crucible_fault_node_register(
+        CRUCIBLE_FAULT_COMMAND_CPU_SERVICE,
+        QEMU_PLUGIN_CRUCIBLE_FAULT_SCOPE_ALL, boundary,
+        "qemu.cpu.service.v1", NULL);
+    qemu_crucible_fault_node_register(
+        CRUCIBLE_FAULT_COMMAND_CPU_VCPU_STATE,
+        QEMU_PLUGIN_CRUCIBLE_FAULT_SCOPE_ALL, boundary,
+        "qemu.cpu.vcpu-state.v1", NULL);
+    qemu_crucible_fault_vmstate_register(&crucible_vcpu_vmstate_section);
+}
+
+type_init(crucible_vcpu_service_register)
