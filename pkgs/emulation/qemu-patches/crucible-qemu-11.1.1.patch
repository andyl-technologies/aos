+static int advance_module_acquire(QemuCrucibleSourceAdvanceReceiver *receiver)
+{
+    QemuCrucibleCommandConsumerMember *member = receiver->member;
+    struct qemu_plugin_crucible_advance_receiver_disposition_v1 *disposition =
+        &receiver->receiver_disposition;
+    int first = advance_callback_begin(receiver, QEMU_CRUCIBLE_ADVANCE_CALLBACK_ACQUIRE,
+                                        member->advance_receiver.acquire);
+    int post;
+
+    if (first) {
+        receiver->module_not_entered = true;
+        return first;
+    }
+    *disposition = (struct qemu_plugin_crucible_advance_receiver_disposition_v1) {
+        .schema_version = 1,
+        .struct_size = sizeof(*disposition),
+    };
+    receiver->acquire_frame_serial = receiver->callback.serial;
+    receiver->acquire_entered = true;
+    first = member->advance_receiver.acquire(receiver,
+        &receiver->module_command, &receiver->module_command_serial,
+        &receiver->module_membership, &receiver->module_membership_serial,
+        &receiver->module_cleanup, &receiver->module_cleanup_serial,
+        disposition, member->component->userdata);
+    receiver->acquire_returned = true;
+    receiver->command_at_acquire = receiver->module_command;
+    receiver->membership_at_acquire = receiver->module_membership;
+    receiver->cleanup_at_acquire = receiver->module_cleanup;
+    receiver->acquired_command_serial = receiver->module_command_serial;
+    receiver->acquired_membership_serial = receiver->module_membership_serial;
+    receiver->acquired_cleanup_serial = receiver->module_cleanup_serial;
+    advance_callback_end(receiver);
+    receiver->acquired_disposition = *disposition;
+    receiver->acquire_status = first > 0 ? -EPROTO : first;
+    if (!advance_receiver_disposition_syntax(disposition)) {
+        if (!first) {
+            first = -EPROTO;
+        }
+        receiver->uncertain = true;
+    }
+    receiver->acquire_first_absent = receiver->acquire_status < 0 &&
+        disposition->known_absent == 1 &&
+        advance_receiver_disposition_syntax(disposition) &&
+        advance_module_outputs_absent(receiver);
+
+    if (!first) {
+        first = disposition->first_status ? disposition->first_status :
+            disposition->post_status;
+    }
+
+    /* A real independent callback post is attempted after every returned
+     * acquire, including negative first and changed/partial output fields. */
+    post = advance_callback_begin(receiver,
+        QEMU_CRUCIBLE_ADVANCE_CALLBACK_COMMAND_CURRENT, member->advance_receiver.current);
+    if (!post) {
+        receiver->command_borrow = (QemuCrucibleSourceAdvanceCommandBorrow) {
+            .receiver = receiver,
+            .serial = receiver->callback.serial,
+            .held = true,
+        };
+        *disposition = (struct qemu_plugin_crucible_advance_receiver_disposition_v1) {
+            .schema_version = 1,
+            .struct_size = sizeof(*disposition),
+        };
+        post = member->advance_receiver.current(
+            &receiver->module_command, receiver->module_command_serial,
+            &receiver->module_membership, receiver->module_membership_serial,
+            &receiver->module_cleanup, receiver->module_cleanup_serial,
+            &receiver->command_borrow, disposition, member->component->userdata);
+        advance_callback_end(receiver);
+        receiver->command_borrow.held = false;
+        receiver->acquire_post_absent = post < 0 && disposition->known_absent == 1 &&
+            advance_receiver_disposition_syntax(disposition) &&
+            advance_module_outputs_absent(receiver);
+        if (!advance_receiver_disposition_syntax(disposition) && !post) {
+            post = -EPROTO;
+        }
+        if (!post) {
+            post = disposition->first_status ? disposition->first_status :
+                disposition->post_status;
+        }
+    }
+    if (receiver->module_command != receiver->command_at_acquire ||
+        receiver->module_membership != receiver->membership_at_acquire ||
+        receiver->module_cleanup != receiver->cleanup_at_acquire ||
+        receiver->module_command_serial != receiver->acquired_command_serial ||
+        receiver->module_membership_serial != receiver->acquired_membership_serial ||
+        receiver->module_cleanup_serial != receiver->acquired_cleanup_serial) {
+        receiver->uncertain = true;
+        if (!post) {
+            post = -ESTALE;
+        }
+    }
+    receiver->acquire_post_status = post > 0 ? -EPROTO : post;
+    receiver->acquire_absent = receiver->acquire_first_absent &&
+        receiver->acquire_post_absent && advance_module_outputs_absent(receiver);
+    if (!first && !post && (!advance_module_outputs_complete(receiver) ||
+        receiver->acquired_disposition.known_absent || disposition->known_absent)) {
+        first = -EPROTO;
+        receiver->uncertain = true;
+    }
+    return first ? (first > 0 ? -EPROTO : first) : receiver->acquire_post_status;
+}
