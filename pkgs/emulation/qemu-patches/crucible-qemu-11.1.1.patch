+static void scenario_worker_policy_environment_refusals(void)
+{
+    static const char *const names[] = {
+        "MALLOC_ARENA_MAX", "MALLOC_PERTURB_", "GLIBC_TUNABLES",
+        "LD_PRELOAD", "LD_AUDIT",
+    };
+
+    for (size_t index = 0; index < G_N_ELEMENTS(names); index++) {
+        QemuCruciblePluginWorker worker = {
+            .thread_name = "crucible-run", .policy_descriptor = -1,
+            .layout = qemu_plugin_crucible_run_worker_layout_v1,
+        };
+        char *saved = g_strdup(getenv(names[index]));
+
+        /* Change the actual policy input after loader startup. No alternate
+         * allocator or fake libc version is installed by these controls. */
+        g_assert_cmpint(setenv(names[index], "", 1), ==, 0);
+        g_assert_cmpint(plugin_worker_backing(&worker), ==, -ENOTSUP);
+        g_assert_cmpuint(worker.residual_bytes, ==, 0);
+        g_assert_cmpint(worker.policy_descriptor, ==, -1);
+        g_assert_false(worker.policy_close_uncertain);
+        g_assert_false(worker.residual_charge.held);
+        g_assert_false(worker.stack_charge.held);
+        g_assert_false(worker.task_reserved);
+        g_assert_false(worker.birth.born);
+
+        if (saved) {
+            g_assert_cmpint(setenv(names[index], saved, 1), ==, 0);
+        } else {
+            g_assert_cmpint(unsetenv(names[index]), ==, 0);
+        }
+        g_free(saved);
+    }
+
+    /* The same real binary and unchanged cohort still plan after the exact
+     * forbidden input is removed. This is no construction or return proof. */
+    g_assert_cmpuint(fixture_required_worker_charge_bytes(), >, 0);
+}
