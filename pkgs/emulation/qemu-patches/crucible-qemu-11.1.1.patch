+static void test_timer_projection(gconstpointer opaque)
+{
+    unsigned index = GPOINTER_TO_UINT(opaque);
+    const __int128 deadlines[] = {
+        ((__int128)1 << 120) + 357, coordinate(INT64_MIN, 0), -1,
+    };
+    MC146818RtcState state;
+    QIOChannelBuffer *output = qio_channel_buffer_new(32);
+    QEMUFile *file = qemu_file_new_output(QIO_CHANNEL(output));
+
+    initialize_timers(&state);
+    if (index < ARRAY_SIZE(deadlines)) {
+        timer_mod_ps_wide(state.periodic_timer, deadlines[index]);
+    }
+    rtc_fingerprint_timer(file, state.periodic_timer);
+    g_assert_cmpint(qemu_fflush(file), ==, 0);
+
+    g_assert_cmpuint(output->usage, ==, index < ARRAY_SIZE(deadlines) ? 18 : 2);
+    g_assert_cmpuint(output->data[0], ==, 1);
+    g_assert_cmpuint(output->data[1], ==, index < ARRAY_SIZE(deadlines));
+    if (index < ARRAY_SIZE(deadlines)) {
+        g_assert_cmphex(ldq_be_p(output->data + 2), ==,
+                        (uint64_t)(deadlines[index] >> 64));
+        g_assert_cmphex(ldq_be_p(output->data + 10), ==,
+                        (uint64_t)deadlines[index]);
+    }
+
+    qemu_fclose(file);
+    object_unref(OBJECT(output));
+    destroy_timers(&state);
+}
+
+static void test_bounded_service_mapper(void)
+{
+    MC146818RtcState state = { .base_rtc = 951782400 };
+    uint64_t raw = 7357;
+
+    state.calendar_origin_ps = 357;
+    state.offset = 123;
+    state.crucible_epoch_ns = UINT64_C(951782400000000123);
+    g_assert_true(rtc_crucible_scheduler_to_raw(&state, 123457, &raw));
+    g_assert_cmpuint(raw, ==, 123100);
+
+    for (unsigned index = 0; index < 2; index++) {
+        state.calendar_origin_ps = index ? coordinate(INT64_MAX, UINT64_MAX) :
+                                           coordinate(INT64_MIN, 0);
+        raw = 7357;
+
+        g_assert_false(rtc_crucible_scheduler_to_raw(&state, 123457, &raw));
+        g_assert_cmpuint(raw, ==, 7357);
+    }
+    state.calendar_origin_ps = 0;
+    g_assert_false(rtc_crucible_scheduler_to_raw(&state,
+                                               (uint64_t)INT64_MAX + 1, &raw));
+    g_assert_cmpuint(raw, ==, 7357);
+}
+
+int main(int argc, char **argv)
+{
+    Error *error = NULL;
+
+    g_test_init(&argc, &argv, NULL);
