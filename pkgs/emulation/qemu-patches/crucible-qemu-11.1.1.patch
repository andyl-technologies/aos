+int qemu_plugin_rr_cursor(struct qemu_plugin_rr_cursor *out)
+{
+    CPUState *cpu = current_cpu;
+    CPUState *next_cpu;
+    bool exact_boundary = qemu_plugin_crucible_exact_boundary_active();
+    uint64_t current_vcpu = icount_crucible_rr_current_vcpu();
+    uint64_t cursor_position = exact_boundary ?
+        icount_crucible_rr_cursor_position() :
+        icount_crucible_rr_cursor_position_observed(cpu);
+    uint64_t rr_switch_quantum = icount_crucible_rr_switch_quantum();
+    int num_vcpus = qemu_plugin_num_vcpus();
+    bool genesis_cursor = exact_boundary && current_vcpu == UINT64_MAX &&
+        icount_get_raw_observed() == 0 && cursor_position == 0;
+    bool terminal_cursor = !exact_boundary && cpu &&
+        current_vcpu == (uint64_t)cpu->cpu_index &&
+        rr_switch_quantum != 0 && cursor_position == rr_switch_quantum;
+
+    if (terminal_cursor) {
+        next_cpu = CPU_NEXT(cpu);
+        if (!next_cpu) {
+            next_cpu = first_cpu;
+        }
+        if (!next_cpu) {
+            return -1;
+        }
+        current_vcpu = next_cpu->cpu_index;
+        cursor_position = 0;
+    }
+
+    if (!out || (!cpu && !exact_boundary) ||
+        (current_vcpu == UINT64_MAX && !genesis_cursor) ||
+        (cpu && cpu->cpu_index != current_vcpu && !exact_boundary &&
+         !terminal_cursor) ||
+        num_vcpus <= 0 ||
+        (current_vcpu != UINT64_MAX &&
+         current_vcpu >= (uint64_t)num_vcpus) || rr_switch_quantum == 0 ||
+        cursor_position >= rr_switch_quantum) {
+        return -1;
+    }
+
+    /*
+     * Before the first runnable selection, the serialized cursor is invalid by
+     * construction.  At an exact raw-zero boundary its unique next coordinate
+     * is nevertheless vCPU 0 at position 0.  Expose that canonical genesis
+     * coordinate without mutating TimersState; every non-genesis invalid cursor
+     * remains rejected.
+     */
+    out->current_vcpu = genesis_cursor ? 0 : current_vcpu;
+    out->cursor_position = cursor_position;
+    out->rr_switch_quantum = rr_switch_quantum;
+    return 0;
+}
+
+uint64_t qemu_crucible_internal_rr_current_vcpu(void)
+{
+    CPUState *cpu = current_cpu;
+    uint64_t owner = icount_crucible_rr_current_vcpu();
+
+    if (!cpu || owner == UINT64_MAX || cpu->cpu_index != owner) {
+        return UINT64_MAX;
+    }
+    return owner;
+}
+
+uint64_t qemu_crucible_internal_rr_cursor_position(void)
+{
+    return icount_crucible_rr_cursor_position_observed(current_cpu);
+}
+
+uint64_t qemu_crucible_internal_rr_switch_quantum(void)
+{
+    return icount_crucible_rr_switch_quantum();
+}
+
+struct CrucibleRamHash {
+    uint64_t hash;
+    uint64_t bytes;
+};
+
+static uint64_t crucible_fnv1a_u64(uint64_t hash, uint64_t value)
+{
+    for (int i = 0; i < 8; i++) {
+        hash ^= (value >> (i * 8)) & 0xffU;
+        hash *= 1099511628211ULL;
+    }
+    return hash;
+}
+
+static uint64_t crucible_fnv1a_bytes(uint64_t hash,
+                                     const uint8_t *bytes,
+                                     size_t len)
+{
+    for (size_t i = 0; i < len; i++) {
+        hash ^= bytes[i];
+        hash *= 1099511628211ULL;
+    }
+    return hash;
+}
+
+static int crucible_hash_ram_block(RAMBlock *block, void *opaque)
+{
+    struct CrucibleRamHash *state = opaque;
+
+    if (!block->host) {
+        return 0;
+    }
+
+    state->hash = crucible_fnv1a_bytes(state->hash,
+                                       (const uint8_t *)block->idstr,
+                                       strlen(block->idstr));
+    state->hash = crucible_fnv1a_u64(state->hash, block->used_length);
+    state->hash = crucible_fnv1a_bytes(state->hash, block->host,
+                                       block->used_length);
+    state->bytes += block->used_length;
+    return 0;
+}
+
+uint64_t qemu_crucible_ram_hash(uint64_t *bytes_out)
+{
+    struct CrucibleRamHash state = {
+        .hash = 1469598103934665603ULL,
+        .bytes = 0,
+    };
+
+    qemu_ram_foreach_block(crucible_hash_ram_block, &state);
+    if (bytes_out) {
+        *bytes_out = state.bytes;
+    }
+    return state.hash;
+}
+
+struct CrucibleSha256Ram {
+    GChecksum *checksum;
+    uint64_t bytes;
+};
+
+struct CrucibleFingerprintRamMaterial {
+    int fd;
+    uint64_t material_length;
+    uint64_t bytes;
+    int status;
+};
+
+static void crucible_checksum_u64(GChecksum *checksum, uint64_t value)
+{
+    uint8_t encoded[8];
+
+    for (size_t i = 0; i < sizeof(encoded); i++) {
+        encoded[sizeof(encoded) - i - 1] = value & 0xff;
+        value >>= 8;
+    }
+    g_checksum_update(checksum, encoded, sizeof(encoded));
+}
+
+static void crucible_checksum_bytes(GChecksum *checksum,
+                                    const void *bytes, size_t length)
+{
+    crucible_checksum_u64(checksum, length);
+    if (length != 0) {
+        g_checksum_update(checksum, bytes, length);
+    }
+}
+
+static int crucible_material_add_length(uint64_t *total, uint64_t length)
+{
+    if (length > UINT64_MAX - 8 || *total > UINT64_MAX - 8 - length) {
+        return -EOVERFLOW;
+    }
+    *total += 8 + length;
+    return 0;
+}
+
+static int crucible_material_write(int fd, const void *bytes, uint64_t length)
+{
+    const uint8_t *cursor = bytes;
+
+    while (length != 0) {
+        size_t chunk = MIN(length, (uint64_t)(64 * MiB));
+        ssize_t written = qemu_write_full(fd, cursor, chunk);
+
+        if (written != chunk) {
+            return written < 0 ? -errno : -EIO;
+        }
+        cursor += chunk;
+        length -= chunk;
+    }
+    return 0;
+}
+
+static int crucible_material_write_u64(int fd, uint64_t value)
+{
+    uint8_t encoded[8];
+
+    for (size_t i = 0; i < sizeof(encoded); i++) {
+        encoded[sizeof(encoded) - i - 1] = value & 0xff;
+        value >>= 8;
+    }
+    return crucible_material_write(fd, encoded, sizeof(encoded));
+}
+
+static int crucible_material_write_bytes(int fd, const void *bytes,
+                                         uint64_t length)
+{
+    int status = crucible_material_write_u64(fd, length);
+
+    if (status == 0) {
+        status = crucible_material_write(fd, bytes, length);
+    }
+    return status;
+}
+
+static bool crucible_fingerprint_ram_block(RAMBlock *block)
+{
+    return block->host && block->mr && memory_region_is_ram(block->mr) &&
+        !memory_region_is_rom(block->mr) &&
+        !memory_region_is_ram_device(block->mr);
+}
+
+static int crucible_plan_fingerprint_ram_block(RAMBlock *block, void *opaque)
+{
+    struct CrucibleFingerprintRamMaterial *state = opaque;
+    size_t name_length;
+
+    if (!crucible_fingerprint_ram_block(block) || state->status != 0) {
+        return state->status;
+    }
+    name_length = strlen(block->idstr);
+    state->status = crucible_material_add_length(
+        &state->material_length, name_length);
+    if (state->status == 0 && state->material_length > UINT64_MAX - 8) {
+        state->status = -EOVERFLOW;
+    }
+    if (state->status == 0) {
+        state->material_length += 8;
+        state->status = crucible_material_add_length(
+            &state->material_length, block->used_length);
+    }
+    if (state->status == 0 && block->used_length > UINT64_MAX - state->bytes) {
+        state->status = -EOVERFLOW;
+    }
+    if (state->status == 0) {
+        state->bytes += block->used_length;
+    }
+    return state->status;
+}
+
+static int crucible_write_fingerprint_ram_block(RAMBlock *block, void *opaque)
+{
+    struct CrucibleFingerprintRamMaterial *state = opaque;
+    size_t name_length;
+
+    if (!crucible_fingerprint_ram_block(block) || state->status != 0) {
+        return state->status;
+    }
+    name_length = strlen(block->idstr);
+    state->status = crucible_material_write_bytes(
+        state->fd, block->idstr, name_length);
+    if (state->status == 0) {
+        state->status = crucible_material_write_u64(
+            state->fd, block->used_length);
+    }
+    if (state->status == 0) {
+        state->status = crucible_material_write_bytes(
+            state->fd, block->host, block->used_length);
+    }
+    return state->status;
+}
+
+static int crucible_sha256_guest_ram_block(RAMBlock *block, void *opaque)
+{
+    struct CrucibleSha256Ram *state = opaque;
+
+    if (!block->host || !block->mr || !memory_region_is_ram(block->mr) ||
+        memory_region_is_rom(block->mr) ||
+        memory_region_is_ram_device(block->mr)) {
+        return 0;
+    }
+    crucible_checksum_bytes(state->checksum, block->idstr,
+                            strlen(block->idstr));
+    crucible_checksum_u64(state->checksum, block->used_length);
+    crucible_checksum_bytes(state->checksum, block->host,
+                            block->used_length);
+    state->bytes += block->used_length;
+    return 0;
+}
+
+int qemu_crucible_guest_ram_sha256(uint8_t digest_out[32],
+                                   uint64_t *bytes_out)
+{
+    g_autoptr(GChecksum) checksum = NULL;
+    struct CrucibleSha256Ram state;
+    gsize digest_length = 32;
+
+    if (!digest_out || !bytes_out) {
+        return -EINVAL;
+    }
+    memset(digest_out, 0, 32);
+    *bytes_out = 0;
+    checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    if (!checksum) {
+        return -ENOMEM;
+    }
+    state.checksum = checksum;
+    state.bytes = 0;
+    crucible_checksum_bytes(checksum, "crucible.qemu.guest-ram.v1",
+                            strlen("crucible.qemu.guest-ram.v1"));
+    qemu_ram_foreach_block(crucible_sha256_guest_ram_block, &state);
+    g_checksum_get_digest(checksum, digest_out, &digest_length);
+    if (digest_length != 32) {
+        memset(digest_out, 0, 32);
+        return -EIO;
+    }
+    *bytes_out = state.bytes;
+    return 0;
+}
+
+static int crucible_hash_device_projection(uint8_t digest_out[32],
+                                           uint64_t *bytes_out)
+{
+    static const char domain[] = "crucible.qemu.device-projection.v2";
+    QIOChannelFile *channel = NULL;
+    QEMUFile *file = NULL;
+    Error *local_err = NULL;
+    g_autoptr(GChecksum) checksum = NULL;
+    uint8_t buffer[64 * KiB];
+    gsize digest_length = 32;
+    uint64_t sections = 0;
+    off_t length;
+    int writer_fd = -1;
+    int fd = -1;
+    int close_status;
+    int status = 0;
+
+    if (!digest_out || !bytes_out) {
+        return -EINVAL;
+    }
+    memset(digest_out, 0, 32);
+    *bytes_out = 0;
+
+    fd = qemu_memfd_create("crucible-device-projection", GiB, false, 0,
+                           F_SEAL_GROW, NULL);
+    if (fd < 0) {
+        return -EIO;
+    }
+    writer_fd = dup(fd);
+    if (writer_fd < 0) {
+        status = -errno;
+        goto out;
+    }
+    channel = qio_channel_file_new_fd(writer_fd);
+    writer_fd = -1;
+    file = qemu_file_new_output(QIO_CHANNEL(channel));
+    crucible_device_projection_enter();
+    status = qemu_save_device_fingerprint_projection(
+        file, QEMU_CRUCIBLE_LIFECYCLE_STATE_VOLATILE |
+              QEMU_CRUCIBLE_LIFECYCLE_STATE_DEVICE,
+        &sections, &local_err);
+    crucible_device_projection_leave();
+    if (status != 0 && local_err) {
+        error_report_err(g_steal_pointer(&local_err));
+    }
+    if (status == 0) {
+        status = qemu_fflush(file);
+    }
+    if (status == 0) {
+        status = qemu_file_get_error(file);
+    }
+    close_status = qemu_fclose(file);
+    file = NULL;
+    if (status == 0 && close_status != 0) {
+        status = close_status;
+    }
+    object_unref(OBJECT(channel));
+    channel = NULL;
+    if (status != 0) {
+        goto out;
+    }
+
+    length = lseek(fd, 0, SEEK_CUR);
+    if (length <= 0 || sections == 0 || ftruncate(fd, length) != 0 ||
+        lseek(fd, 0, SEEK_SET) != 0 ||
+        fcntl(fd, F_ADD_SEALS,
+              F_SEAL_SHRINK | F_SEAL_WRITE | F_SEAL_SEAL) != 0) {
+        status = -EIO;
+        goto out;
+    }
+    checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    if (!checksum) {
+        status = -ENOMEM;
+        goto out;
+    }
+    crucible_checksum_bytes(checksum, domain, sizeof(domain) - 1);
+    for (;;) {
+        ssize_t count = read(fd, buffer, sizeof(buffer));
+
+        if (count > 0) {
+            g_checksum_update(checksum, buffer, count);
+        } else if (count == 0) {
+            break;
+        } else if (errno != EINTR) {
+            status = -errno;
+            goto out;
+        }
+    }
+    g_checksum_get_digest(checksum, digest_out, &digest_length);
+    if (digest_length != 32) {
+        status = -EIO;
+        goto out;
+    }
+    *bytes_out = length;
+
+out:
+    if (file) {
+        qemu_fclose(file);
+    }
+    if (channel) {
+        object_unref(OBJECT(channel));
+    }
+    if (writer_fd >= 0) {
+        close(writer_fd);
+    }
+    if (fd >= 0) {
+        close(fd);
+    }
+    if (status != 0) {
+        memset(digest_out, 0, 32);
+        *bytes_out = 0;
+    }
+    return status;
+}
+
+int qemu_crucible_device_state_sha256(uint8_t digest_out[32],
+                                      uint64_t *bytes_out)
+{
+    if (!qemu_plugin_crucible_exact_boundary_active() || !bql_locked()) {
+        return -EPERM;
+    }
+    return crucible_hash_device_projection(digest_out, bytes_out);
+}
+
+int qemu_crucible_instruction_device_state_sha256(uint8_t digest_out[32],
+                                                  uint64_t *bytes_out)
+{
+    struct qemu_plugin_rr_cursor rr;
+    bool acquired_bql = false;
+    int status;
+
+    /*
+     * Instruction fault dispatch runs between single-instruction TBs on the
+     * serialized RR owner while the vCPU thread has released the BQL.  Validate
+     * that exact execution context before taking the BQL needed to serialize
+     * the device projection with the main loop.  The generic observer API
+     * remains restricted to an externally established exact BQL boundary.
+     */
+    if (!qemu_plugin_crucible_single_threaded_rr() || !current_cpu ||
+        qemu_plugin_rr_cursor(&rr) != 0) {
+        return -EPERM;
+    }
+    if (!bql_locked()) {
+        bql_lock();
+        acquired_bql = true;
+    }
+    status = crucible_hash_device_projection(digest_out, bytes_out);
+    if (acquired_bql) {
+        bql_unlock();
+    }
+    return status;
+}
+
+static bool crucible_fingerprint_runstate_admitted(void)
+{
+    if (vm_get_suspended()) {
+        return false;
+    }
+    if (runstate_is_running()) {
+        return true;
+    }
+    return runstate_check(RUN_STATE_PAUSED) &&
+           qemu_plugin_crucible_vmstop_quiesced();
+}
+
+int qemu_plugin_crucible_capture_fingerprint_material(
+    struct qemu_plugin_crucible_fingerprint_material *out)
+{
+    QIOChannelFile *device_channel = NULL;
+    QEMUFile *file = NULL;
+    Error *local_err = NULL;
+    const char ram_domain[] = "crucible.qemu.guest-ram.v1";
+    const char device_domain[] = "crucible.qemu.device-projection.v2";
+    struct CrucibleFingerprintRamMaterial ram = {
+        .fd = -1,
+    };
+    uint64_t device_material_length = 0;
+    uint64_t device_projection_offset = 0;
+    uint64_t projected_sections = 0;
+    uint64_t device_schema_sections = 0;
+    const char *failure_stage = "validate capture authority";
+    int ram_fd_flags;
+    int ram_fd_seals;
+    int device_fd_flags;
+    int device_fd_seals;
+    int device_writer_fd = -1;
+    int close_status;
+    int status = 0;
+
+    if (!out) {
+        return -EINVAL;
+    }
+    memset(out, 0, sizeof(*out));
+    out->ram_fd = -1;
+    out->device_fd = -1;
+
+    /*
+     * The safe fingerprint observer invokes this export only from its explicit
+     * control-boundary callback after the plugin has quiesced every device
+     * worker. The control-boundary scope, exact-boundary scope, BQL, canonical
+     * running or plugin-quiesced runstate, and disabled record/replay mode are
+     * caller-owned admissions; silently acquiring them here would turn this
+     * into a racy generic sampler.
+     */
+    if (!qemu_plugin_crucible_control_boundary_active() ||
+        !qemu_plugin_crucible_exact_boundary_active() || !bql_locked() ||
+        !crucible_fingerprint_runstate_admitted() ||
+        replay_mode != REPLAY_MODE_NONE) {
+        return -EPERM;
+    }
+    status = crucible_material_add_length(
+        &ram.material_length, sizeof(ram_domain) - 1);
+    if (status == 0) {
+        failure_stage = "plan guest RAM material";
+        status = qemu_ram_foreach_block(
+            crucible_plan_fingerprint_ram_block, &ram);
+    }
+    if (status == 0) {
+        status = ram.status;
+    }
+
+    if (status == 0 && ram.bytes == 0) {
+        status = -ENODATA;
+    }
+    if (status == 0) {
+        failure_stage = "hash device projection schema";
+        status = qemu_fingerprint_projection_schema_sha256(
+            QEMU_CRUCIBLE_LIFECYCLE_STATE_VOLATILE |
+                QEMU_CRUCIBLE_LIFECYCLE_STATE_DEVICE |
+                QEMU_CRUCIBLE_LIFECYCLE_STATE_CONTROL,
+            out->device_schema_digest, &device_schema_sections);
+        if (status == 0 && device_schema_sections == 0) {
+            status = -EIO;
+        } else if (status == 0) {
+            out->device_schema_sections = device_schema_sections;
+        }
+    }
+    if (status == 0) {
+        if (ram.material_length > SIZE_MAX) {
+            status = -EOVERFLOW;
+            goto out;
+        }
+        failure_stage = "create guest RAM material memfd";
+        out->ram_fd = qemu_memfd_create(
+            "crucible-fingerprint-ram", ram.material_length, false, 0,
+            F_SEAL_SHRINK, &local_err);
+        if (out->ram_fd < 0) {
+            status = errno ? -errno : -EIO;
+            goto out;
+        }
+        failure_stage = "create device projection material memfd";
+        out->device_fd = qemu_memfd_create(
+            "crucible-fingerprint-device", GiB, false, 0, F_SEAL_GROW,
+            &local_err);
+        if (out->device_fd < 0) {
+            status = errno ? -errno : -EIO;
+            goto out;
+        }
+        if (out->ram_fd == out->device_fd) {
+            failure_stage = "validate distinct material memfds";
+            status = -EPROTO;
+            goto out;
+        }
+        ram.fd = out->ram_fd;
+        failure_stage = "write guest RAM material domain";
+        status = crucible_material_write_bytes(
+            out->ram_fd, ram_domain, sizeof(ram_domain) - 1);
+        if (status == 0) {
+            failure_stage = "write guest RAM material blocks";
+            status = qemu_ram_foreach_block(
+                crucible_write_fingerprint_ram_block, &ram);
+        }
+        if (status == 0) {
+            status = ram.status;
+        }
+        if (status == 0) {
+            failure_stage = "write device projection material domain";
+            status = crucible_material_write_bytes(
+                out->device_fd, device_domain, sizeof(device_domain) - 1);
+        }
+        if (status == 0) {
+            off_t start = lseek(out->device_fd, 0, SEEK_CUR);
+
+            failure_stage = "locate device projection material start";
+            if (start < 0) {
+                status = -errno;
+            } else if (start == 0) {
+                status = -ENODATA;
+            } else {
+                device_projection_offset = start;
+            }
+        }
+        if (status == 0) {
+            failure_stage = "duplicate device projection writer";
+            device_writer_fd = dup(out->device_fd);
+            if (device_writer_fd < 0) {
+                status = -errno;
+            }
+        }
+        if (status == 0) {
+            failure_stage = "serialize device projection material";
+            device_channel = qio_channel_file_new_fd(device_writer_fd);
+            device_writer_fd = -1;
+            file = qemu_file_new_output(QIO_CHANNEL(device_channel));
+            crucible_device_projection_enter();
+            status = qemu_save_device_fingerprint_projection(
+                file, QEMU_CRUCIBLE_LIFECYCLE_STATE_VOLATILE |
+                          QEMU_CRUCIBLE_LIFECYCLE_STATE_DEVICE |
+                          QEMU_CRUCIBLE_LIFECYCLE_STATE_CONTROL,
+                &projected_sections, &local_err);
+            crucible_device_projection_leave();
+        }
+        if (status == 0) {
+            failure_stage = "flush device projection material";
+            status = qemu_fflush(file);
+        }
+        if (status == 0) {
+            failure_stage = "read device projection writer status";
+            status = qemu_file_get_error(file);
+        }
+        if (file) {
+            close_status = qemu_fclose(file);
+            file = NULL;
+            if (status == 0 && close_status != 0) {
+                status = close_status;
+            }
+        }
+        if (device_channel) {
+            object_unref(OBJECT(device_channel));
+            device_channel = NULL;
+        }
+        if (status == 0) {
+            off_t end = lseek(out->device_fd, 0, SEEK_CUR);
+
+            failure_stage = "validate device projection material extent";
+            if (end < 0) {
+                status = -errno;
+            } else if (end == 0 ||
+                       (uint64_t)end <= device_projection_offset ||
+                       projected_sections == 0 ||
+                       projected_sections != device_schema_sections) {
+                status = -ENODATA;
+            } else {
+                device_material_length = end;
+            }
+        }
+        if (status == 0) {
+            failure_stage = "truncate device projection material";
+            if (ftruncate(out->device_fd, device_material_length) != 0) {
+                status = -errno;
+            }
+        }
+        if (status != 0) {
+            goto out;
+        }
+        failure_stage = "rewind guest RAM material";
+        off_t ram_offset = lseek(out->ram_fd, 0, SEEK_SET);
+        if (ram_offset < 0) {
+            status = -errno;
+            goto out;
+        }
+        if (ram_offset != 0) {
+            status = -EIO;
+            goto out;
+        }
+        failure_stage = "rewind device projection material";
+        off_t device_offset = lseek(out->device_fd, 0, SEEK_SET);
+        if (device_offset < 0) {
+            status = -errno;
+            goto out;
+        }
+        if (device_offset != 0) {
+            status = -EIO;
+            goto out;
+        }
+        failure_stage = "seal guest RAM material";
+        if (fcntl(out->ram_fd, F_ADD_SEALS,
+                  F_SEAL_GROW | F_SEAL_WRITE | F_SEAL_SEAL) != 0) {
+            status = -errno;
+            goto out;
+        }
+        failure_stage = "seal device projection material";
+        if (fcntl(out->device_fd, F_ADD_SEALS,
+                  F_SEAL_SHRINK | F_SEAL_GROW |
+                  F_SEAL_WRITE | F_SEAL_SEAL) != 0) {
+            status = -errno;
+            goto out;
+        }
+        failure_stage = "validate sealed material descriptors";
+        ram_fd_flags = fcntl(out->ram_fd, F_GETFD);
+        if (ram_fd_flags < 0) {
+            status = -errno;
+            goto out;
+        }
+        device_fd_flags = fcntl(out->device_fd, F_GETFD);
+        if (device_fd_flags < 0) {
+            status = -errno;
+            goto out;
+        }
+        ram_fd_seals = fcntl(out->ram_fd, F_GET_SEALS);
+        if (ram_fd_seals < 0) {
+            status = -errno;
+            goto out;
+        }
+        device_fd_seals = fcntl(out->device_fd, F_GET_SEALS);
+        if (device_fd_seals < 0) {
+            status = -errno;
+            goto out;
+        }
+        if ((ram_fd_flags & FD_CLOEXEC) == 0 ||
+            (device_fd_flags & FD_CLOEXEC) == 0 ||
+            ram_fd_seals != (F_SEAL_SEAL | F_SEAL_SHRINK |
+                             F_SEAL_GROW | F_SEAL_WRITE) ||
+            device_fd_seals != (F_SEAL_SEAL | F_SEAL_SHRINK |
+                                F_SEAL_GROW | F_SEAL_WRITE)) {
+            status = -EPROTO;
+            goto out;
+        }
+        out->ram_material_length = ram.material_length;
+        out->ram_bytes = ram.bytes;
+        out->device_material_length = device_material_length;
+        out->device_bytes = device_material_length - device_projection_offset;
+    }
+
+out:
+    if (file) {
+        close_status = qemu_fclose(file);
+        if (status == 0 && close_status != 0) {
+            status = close_status;
+        }
+    }
+    if (device_channel) {
+        object_unref(OBJECT(device_channel));
+    }
+    if (device_writer_fd >= 0) {
+        close(device_writer_fd);
+    }
+    if (status != 0) {
+        if (local_err) {
+            error_prepend(&local_err, "%s: ", failure_stage);
+            error_report_err(g_steal_pointer(&local_err));
+        } else {
+            error_report("%s failed: %s (%d)", failure_stage,
+                         strerror(-status), status);
+        }
+        if (out->ram_fd >= 0) {
+            close(out->ram_fd);
+        }
+        if (out->device_fd >= 0 && out->device_fd != out->ram_fd) {
+            close(out->device_fd);
+        }
+        memset(out, 0, sizeof(*out));
+        out->ram_fd = -1;
+        out->device_fd = -1;
+    }
+    return status;
+}
+
+int qemu_plugin_crucible_process_argv_attestation(
+    struct qemu_plugin_crucible_process_argv_attestation *out)
+{
+    if (!out) {
+        return -EINVAL;
+    }
+    memset(out, 0, sizeof(*out));
+    return qemu_crucible_process_argv_attestation(
+        &out->version, &out->argc, &out->raw_bytes, out->sha256);
+}
