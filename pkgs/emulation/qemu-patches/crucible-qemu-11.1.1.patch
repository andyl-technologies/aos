+#ifdef CONFIG_LINUX
+static int ram_control_receive_begin_locked(
+    qemu_plugin_id_t id, qemu_plugin_crucible_ram_control_actor_v1 *actor,
+    struct qemu_plugin_crucible_ram_control_receive_borrow_v1 *out)
+{
+#if defined(CONFIG_LINUX) && defined(__x86_64__) && !defined(__ILP32__)
+    QemuCrucibleRamControlReceive *receipt;
+    struct qemu_plugin_crucible_ram_control_receive_borrow_v1 borrowed;
+    int status = qemu_crucible_ram_control_actor_current(actor, id);
+
+    if (status || !out) {
+        return status ? status : -EINVAL;
+    }
+    if (qatomic_read(&actor->first_status)) {
+        return qatomic_read(&actor->first_status);
+    }
+    receipt = &actor->receipt;
+    if (receipt->active || receipt->uncertain || receipt->record.held ||
+        receipt->record.callback_active ||
+        (receipt->record.acquire_attempted && !receipt->record.released) ||
+        qatomic_load_acquire(&actor->idle)) {
+        return -EBUSY;
+    }
+    status = qemu_crucible_ram_control_actor_contract_current(actor);
+    if (!status) {
+        status = startup_descriptor_preflight(&actor->observation,
+                                               actor->descriptor_limit, 1);
+    }
+    if (status) {
+        return ram_control_failure(actor, status, false);
+    }
+    memset(&receipt->record, 0, sizeof(receipt->record));
+    receipt->frame_bytes = 0;
+    receipt->frame_extent = 0;
+    receipt->alias_count = 0;
+    receipt->first_alias = false;
+    memset(receipt->close_attempted, 0, sizeof(receipt->close_attempted));
+    receipt->moved = false;
+    receipt->active = true;
+    borrowed = (struct qemu_plugin_crucible_ram_control_receive_borrow_v1) {
+        .schema_version = 1,
+        .struct_size = sizeof(borrowed),
+        .loan = receipt,
+        .frame = receipt->frame,
+        .frame_capacity = sizeof(receipt->frame),
+    };
+    *out = borrowed;
+    return 0;
+#else
+    return -ENOTSUP;
+#endif
+}
