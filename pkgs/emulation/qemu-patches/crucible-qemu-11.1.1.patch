+#ifdef CONFIG_LINUX
+/* Later parent work needs its own authentic Main/QMP operation Original.
+ * Retained installer cleanup identity authenticates custody, but cannot issue
+ * that operation or reuse Setup's completed clock. The genuine native producer
+ * and current-original query are absent, so no successful slice is fabricated. */
+static int ram_control_parent_slice(QemuCrucibleRamControlActor *actor,
+                                     qemu_plugin_id_t id, uint64_t *bounded_ns)
+{
+    int status = ram_control_creator(actor, id);
+
+    if (status || !bounded_ns) {
+        return status ? status : -EINVAL;
+    }
+    if (!qatomic_load_acquire(&startup_source.parent_park_registered) ||
+        !startup_source.parent_park_callback ||
+        startup_source.parent_park_userdata != actor->userdata ||
+        actor->userdata != startup_source.checkpoint_pager_userdata ||
+        actor->userdata != startup_source.provider_userdata ||
+        !qatomic_load_acquire(&startup_source.checkpoint_pager_registered) ||
+        !qatomic_load_acquire(&startup_source.provider_registered)) {
+        return -ENOKEY;
+    }
+    /* This is an explicit unresolved issuer/query dependency, not a held flag
+     * or pointer-equality grant. Only the actual Main/Stopped retaining producer
+     * may replace this refusal with a query on its issued parent Original. */
+    return -ENOKEY;
+}
+
+static int ram_control_parent_wait(QemuCrucibleRamControlActor *actor,
+                                    qemu_plugin_id_t id, uint64_t bounded_ns)
+{
+    uint64_t current_slice;
+    int status = ram_control_parent_slice(actor, id, &current_slice);
+
+    if (status) {
+        return status;
+    }
+    if (!bounded_ns || !current_slice) {
+        return -ETIMEDOUT;
+    }
+    /* The genuine parent Original query/event loan is not yet implemented.
+     * Do not poll Source's retired Setup alias as a parent operation donor. */
+    return -ENOKEY;
+}
