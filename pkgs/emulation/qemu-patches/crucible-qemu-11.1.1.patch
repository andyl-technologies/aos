+static GByteArray *save_timer_state(ppc_tb_t *state)
+{
+    QIOChannelBuffer *channel = qio_channel_buffer_new(4096);
+    QEMUFile *file = qemu_file_new_output(QIO_CHANNEL(channel));
+    PowerPCCPU cpu = { .env.tb_env = state };
+    GByteArray *bytes = g_byte_array_new();
+    Error *error = NULL;
+
+    g_assert_cmpint(vmstate_save_state(file, &vmstate_ppc_timers, &cpu,
+                                      NULL, &error), ==, 0);
+    g_assert_null(error);
+    qemu_put_byte(file, QEMU_VM_EOF);
+    g_assert_cmpint(qemu_fflush(file), ==, 0);
+    g_byte_array_append(bytes, channel->data, channel->usage);
+    g_assert_cmpint(qemu_fclose(file), ==, 0);
+    object_unref(OBJECT(channel));
+    return bytes;
+}
+
+static int load_timer_state(ppc_tb_t *state, GByteArray *bytes, int version)
+{
+    QIOChannelBuffer *channel = qio_channel_buffer_new(bytes->len);
+    QEMUFile *file;
+    PowerPCCPU cpu = { .env.tb_env = state };
+    int result;
+    Error *error = NULL;
+
+    memcpy(channel->data, bytes->data, bytes->len);
+    channel->usage = bytes->len;
+    file = qemu_file_new_input(QIO_CHANNEL(channel));
+    result = vmstate_load_state(file, &vmstate_ppc_timers, &cpu, version,
+                                &error);
+    if (result < 0) {
+        g_test_message("load error: %s; mode=%u present=%u active=%u loaded=%u",
+                       error ? error_get_pretty(error) : "unspecified",
+                       state->timer_state_mode, state->timer_state_present,
+                       state->timer_state_active, state->timer_vmstate_loaded);
+    }
+    error_free(error);
+    qemu_fclose(file);
+    object_unref(OBJECT(channel));
+    return result;
+}
