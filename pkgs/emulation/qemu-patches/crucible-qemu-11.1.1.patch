+static void test_cross_mode(gconstpointer data)
+{
+    unsigned kind = GPOINTER_TO_UINT(data);
+    LoongArchCPU cpu = { 0 };
+    GByteArray *bytes;
+    __int128 deadline;
+    int descriptor;
+    char *path = NULL;
+    char *output = NULL;
+    char *errors = NULL;
+    char *kind_argument;
+    int status;
+    char *arguments[5];
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+    initialize_clock(true);
+    initialize_timer(&cpu);
+    switch (kind) {
+    case 0:
+        deadline = 140001;
+        break;
+    case 1:
+        deadline = ((__int128)1 << 120) + 357;
+        break;
+    case 2:
+        deadline = -((__int128)1 << 120) + 357;
+        break;
+    case 3:
+        deadline = (__int128)INT64_MAX * 1000 + 999;
+        break;
+    case 4:
+        deadline = -1001;
+        break;
+    case 5:
+        deadline = -1;
+        break;
+    case 6:
+        deadline = wide_time(INT64_MAX, UINT64_MAX);
+        break;
+    case 7:
+        deadline = (__int128)CONSTANT_TIMER_TICK_MASK * TIMER_PERIOD_PS;
+        break;
+    case 8:
+        deadline = (__int128)CONSTANT_TIMER_TICK_MASK * TIMER_PERIOD_PS + 1;
+        break;
+    default:
+        g_assert_not_reached();
+    }
+    timer_mod_ps_wide(&cpu.timer, deadline);
+    bytes = save_state(&timer_fixture, &cpu);
+    descriptor = g_file_open_tmp("loongarch-timer-wide-XXXXXX", &path, NULL);
+    g_assert_cmpint(descriptor, >=, 0);
+    close(descriptor);
+    g_assert_true(g_file_set_contents(path, (char *)bytes->data, bytes->len, NULL));
+    kind_argument = g_strdup_printf("%u", kind);
+    arguments[0] = (char *)program_path;
+    arguments[1] = (char *)"--import-ordinary";
+    arguments[2] = path;
+    arguments[3] = kind_argument;
+    arguments[4] = NULL;
+
+    g_assert_true(g_spawn_sync(NULL, arguments, NULL, 0, NULL, NULL,
+                              &output, &errors, &status, NULL));
+    if (status) {
+        g_test_message("ordinary import: %s", errors);
+    }
+    g_assert_true(WIFEXITED(status));
+    g_assert_cmpint(WEXITSTATUS(status), ==, 0);
+
+    g_assert_cmpint(unlink(path), ==, 0);
+    g_free(kind_argument);
+    g_free(output);
+    g_free(errors);
+    g_free(path);
+    destroy_timer(&cpu);
+    g_byte_array_unref(bytes);
+}
