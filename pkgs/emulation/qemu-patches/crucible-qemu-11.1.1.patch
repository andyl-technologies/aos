+static uint32_t arm_sysctl_24mhz_counter(void)
+{
+    if (qemu_timer_tcg_ps_enabled()) {
+        __int128 now_ps = qemu_clock_get_ps_wide(QEMU_CLOCK_VIRTUAL);
+        __int128 scaled_time = now_ps * 24000000;
+        __int128 ticks = scaled_time / PICOSECONDS_PER_SECOND;
+
+        if (scaled_time < 0 && scaled_time % PICOSECONDS_PER_SECOND) {
+            ticks--;
+        }
+        return (uint32_t)ticks;
+    }
+
+    return muldiv64(qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL), 24000000,
+                    NANOSECONDS_PER_SECOND);
+}
