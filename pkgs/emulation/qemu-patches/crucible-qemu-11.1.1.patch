index 0000000000000000000000000000000000000000..43fc2e788019da47087362648c66db0a0fc67272
--- /dev/null
+++ b/tests/unit/test-crucible-lazy-memory-identity.py
@@ -0,0 +1,414 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Exercise production memory guards and instruction identity helpers.
+
+Production eligibility, start, cleanup/finish, class predicates, begin wrapper
+and both identity helpers run unchanged. GLib holds the bounded memory index.
+TB region lookup, unwind data, observed icount, rule-family registries and
+transaction callback effects are bounded providers. No translated guest,
+real unwind-table decoding, exception longjmp, scheduler or native migration
+execution is claimed. Early C scope exits test the actual cleanup attribute;
+explicit finish/disarm models the existing call-site ownership convention.
+"""
+
+import argparse
+import json
+import os
+from pathlib import Path
+import runpy
+import shlex
+import subprocess
+
+
+ROOT = Path(__file__).resolve().parents[2]
+definition = runpy.run_path(str(Path(__file__).with_name(
+    "test-crucible-net-output-stop.py")))["definition"]
+
+PRELUDE = r"""
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <glib.h>
+
+typedef uint64_t vaddr;
+typedef struct CPUState { unsigned int cpu_index; } CPUState;
+typedef struct TranslationBlock { unsigned int icount; } TranslationBlock;
+typedef struct MMULookupLocals {
+    struct { unsigned int flags; } page[2];
+} MMULookupLocals;
+#define TLB_MMIO 1
+#define INSN_START_WORDS 2
+#define ICOUNT_PRECISE 1
+#define CRUCIBLE_FAULT_COMMAND_CPU_REGISTER_TRANSFORM 3
+
+bool cpu_get_fault_instruction_identity_with_tb(
+    uintptr_t, vaddr *, uint32_t *, const TranslationBlock **);
+bool cpu_get_fault_instruction_identity(uintptr_t, vaddr *, uint32_t *);
+bool qemu_crucible_fault_memory_rules_active(void);
+bool qemu_crucible_fault_memory_fetch_rules_active(void);
+bool qemu_crucible_fault_memory_cpu_rules_active(void);
+bool qemu_crucible_fault_register_rules_active(void);
+bool qemu_crucible_fault_instruction_rules_active(void);
+/* BEGIN_PROTOTYPE */
+
+static GPtrArray *crucible_node_rules;
+static GArray *crucible_memory_gpa_index, *crucible_memory_gva_index;
+static bool crucible_memory_recursive;
+static uint32_t crucible_memory_access_classes;
+static const char *accel = "sim";
+static int icount_mode = ICOUNT_PRECISE;
+static bool register_rule, instruction_rule, instruction_context;
+static unsigned int identities, regions, unwinds, observations;
+static unsigned int fetch_predicates, cpu_predicates, accelerator_reads;
+static unsigned int begins, ends;
+static bool transaction_open;
+static uintptr_t expected_ra = 0x12345;
+static TranslationBlock provided_tb = { .icount = 19 };
+static bool missing_tb;
+static int unwind_left = 7;
+static uint64_t raw_icount = UINT64_C(0x123456789abcdef);
+static uint64_t provided_pc = UINT64_C(0x8765432100);
+
+static struct {
+    unsigned int access_class, actor;
+    uint64_t address, observed, pc;
+    size_t length;
+    bool has_instruction;
+    uint32_t ordinal;
+} received;
+
+static bool current_accel_is_sim(void)
+{
+    accelerator_reads++;
+    return strcmp(accel, "sim") == 0;
+}
+
+static int icount_enabled(void)
+{
+    return icount_mode;
+}
+
+/* One region and one unwind row deliberately bound the helper's inputs. */
+static TranslationBlock *tcg_tb_lookup(uintptr_t ra)
+{
+    regions++;
+    g_assert_cmpuint(ra, ==, expected_ra);
+    return missing_tb ? NULL : &provided_tb;
+}
+
+static int cpu_unwind_data_from_tb(TranslationBlock *tb, uintptr_t ra,
+                                   uint64_t *data)
+{
+    unwinds++;
+    g_assert_true(tb == &provided_tb);
+    g_assert_cmpuint(ra, ==, expected_ra);
+    data[0] = provided_pc;
+    data[1] = UINT64_MAX;
+    return unwind_left;
+}
+
+static uint64_t qemu_crucible_fault_observed_icount(void)
+{
+    observations++;
+    return raw_icount;
+}
+
+static void node_memory_transaction_begin(
+    enum QemuCrucibleMemoryAccessClass access_class, uint32_t actor,
+    uint64_t address, size_t length, uint64_t observed, bool has_instruction,
+    uint64_t pc, uint32_t ordinal, bool fetch, bool cpu, const void *ticket)
+{
+    g_assert_false(transaction_open);
+    g_assert_false(fetch);
+    g_assert_true(cpu);
+    g_assert_null(ticket);
+    transaction_open = true;
+    begins++;
+    received.access_class = access_class;
+    received.actor = actor;
+    received.address = address;
+    received.length = length;
+    received.observed = observed;
+    received.has_instruction = has_instruction;
+    received.pc = pc;
+    received.ordinal = ordinal;
+}
+
+static void qemu_crucible_fault_memory_transaction_end(void)
+{
+    g_assert_true(transaction_open);
+    transaction_open = false;
+    ends++;
+}
+
+static bool qemu_crucible_fault_rule_kind_present(uint16_t command_kind)
+{
+    g_assert_cmpuint(command_kind, ==,
+                    CRUCIBLE_FAULT_COMMAND_CPU_REGISTER_TRANSFORM);
+    return register_rule;
+}
+
+static bool crucible_instruction_rule_registry_active(void)
+{
+    return instruction_rule;
+}
+
+static bool crucible_instruction_contexts_active(void)
+{
+    return instruction_context;
+}
+"""
+
+COUNTERS = r"""
+/* Count entry to the unchanged production identity and class predicates. */
+static bool counted_identity(uintptr_t ra, vaddr *pc, uint32_t *ordinal)
+{
+    identities++;
+    return cpu_get_fault_instruction_identity(ra, pc, ordinal);
+}
+#define cpu_get_fault_instruction_identity counted_identity
+
+static bool counted_fetch(void)
+{
+    fetch_predicates++;
+    return qemu_crucible_fault_memory_fetch_rules_active();
+}
+#define qemu_crucible_fault_memory_fetch_rules_active counted_fetch
+
+static bool counted_cpu(void)
+{
+    cpu_predicates++;
+    return qemu_crucible_fault_memory_cpu_rules_active();
+}
+#define qemu_crucible_fault_memory_cpu_rules_active counted_cpu
+"""
+
+CHECKS = r"""
