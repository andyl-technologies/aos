+        name_length = strlen(se->idstr);
+        if (name_length == 0 || name_length > UINT16_MAX) {
+            error_setg(errp, "invalid read-only fingerprint section name");
+            return -EINVAL;
+        }
+        qemu_put_be16(f, name_length);
+        qemu_put_buffer(f, (const uint8_t *)se->idstr, name_length);
+        qemu_put_be32(f, se->instance_id);
+        qemu_put_be32(f, projection->version);
