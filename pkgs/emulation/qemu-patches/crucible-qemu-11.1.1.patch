+}
+
+QemuCrucibleNativeInvocationRegistry *
+qemu_crucible_startup_source_native_selection_v1(void)
+{
+    /* Hint only. Publication requires a future actual child-bound Native
+     * proof. This successor intentionally leaves the pointer zero; neither
+     * prepared geometry nor ctx equality activates V2's broad admission. */
+    return qatomic_load_acquire(&startup_source.callbacks.selection);
+}
+
+QemuCrucibleNativeInvocationRegistry *const *
+qemu_crucible_startup_source_native_selection_address_v1(void)
+{
