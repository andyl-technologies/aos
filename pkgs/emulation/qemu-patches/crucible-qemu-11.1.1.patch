+int qemu_crucible_startup_source_fingerprint_operation_enter_v1(
+    qemu_plugin_crucible_fingerprint_operation_v1 **out)
+{
+    QemuCrucibleStandingSourcePurpose *purpose = &startup_source.standing;
+    struct QemuCrucibleFingerprintOperation *operation = &purpose->operation;
+    qemu_plugin_crucible_fingerprint_baseline_v1 *baseline = NULL;
+    QemuCrucibleFingerprintMaterial *capture = fingerprint_current_capture();
+    QemuCrucibleActionOriginal *action = startup_source.command_member.action_enter ?
+        &startup_source.action_original : NULL;
+    qemu_plugin_id_t id;
+    uint64_t now;
+    int status;
+
+    if (!out || *out || operation->held || purpose->cleanup_execution ||
+        (startup_source.fingerprint_capture.owner &&
+         (!capture || capture->root_attached ||
+          capture->operation.class_index != UINT32_MAX)) ||
+        purpose->cleanup_holder || startup_source.checkpoint_inventory_metadata.held ||
+        qatomic_load_acquire(&startup_source.resident_service_absence.held) ||
+        !bql_locked()) {
+        return -EBUSY;
+    }
+    status = qemu_crucible_startup_source_fingerprint_root_creator_v1(&id);
+    if (!status) {
+        cpu_allocation_reap_returned();
+    }
+    if (!status) {
+        status = qemu_crucible_ram_fingerprint_root_invocation_current_v1(id);
+    }
+    if (!status && !qemu_crucible_startup_source_fingerprint_retirement_idle_v1()) {
+        status = -EBUSY;
+    }
+    if (!status) {
+        status = standing_boundary();
+    }
+    if (!status && action) {
+        status = qemu_crucible_source_action_original_current_v1(action, id);
+    }
+    if (!status && !action) {
+        status = standing_refresh(false);
+    }
+    if (!status) {
+        status = standing_clock(&now);
+    }
+    if (!status) {
+        status = standing_limits_current(&purpose->current, now);
+    }
+    if (!status) {
+        status = qemu_crucible_ram_fingerprint_baseline_borrow_v1(id, &baseline);
+    }
+    if (!status && action) {
+        status = qemu_crucible_ram_fingerprint_action_root_baseline_v1(action, id, baseline);
+    }
+    if (status) {
+        return status;
+    }
+    if (purpose->operation_serial == UINT64_MAX) {
+        return -EOVERFLOW;
+    }
+    purpose->operation_serial++;
+    *operation = (struct QemuCrucibleFingerprintOperation) {
+        .process = getpid(), .plugin_id = id, .serial = purpose->operation_serial,
+        .action_original = action, .action_serial = action ? action->serial : 0,
+        .coroutine = qemu_in_coroutine() ? qemu_coroutine_self() : NULL,
+        .class_index = baseline ? QEMU_CRUCIBLE_STANDING_UPDATE_CLASS :
