+static void monitor_hot_fork_inventory_locked(
+    MonitorHotForkInventory *inventory, MonitorQMP *active_oob_monitor)
+{
+    Monitor *mon;
+
+    memset(inventory, 0, sizeof(*inventory));
+    inventory->generation = monitor_hot_fork_generation;
+    inventory->overflowed = monitor_hot_fork_generation_overflowed;
+
+    QTAILQ_FOREACH(mon, &mon_list, entry) {
+        MonitorQMP *qmp_mon;
+        uint64_t parser_bytes;
+        bool completed_active_oob_frame;
+        bool parser_partial;
+
+        if (inventory->monitor_count == MONITOR_HOT_FORK_INVENTORY_MAX) {
+            inventory->overflowed = true;
+            break;
+        }
+        inventory->monitor_count++;
+        inventory->io_thread_monitors += monitor_requires_iothread(mon);
+        inventory->suspended_monitors += qatomic_read(&mon->suspend_cnt) != 0;
+        qmp_mon = MONITOR_QMP(
+            object_dynamic_cast(OBJECT(mon), TYPE_MONITOR_QMP));
+        if (!qmp_mon) {
+            inventory->hmp_monitors++;
+            continue;
+        }
+
+        inventory->qmp_monitors++;
+        if (qemu_rec_mutex_trylock(&qmp_mon->qmp_parser_lock) != 0) {
+            inventory->unstable_monitors++;
+            continue;
+        }
+        qemu_mutex_lock(&qmp_mon->parent_obj.mon_lock);
+        inventory->negotiating_monitors +=
+            qmp_mon->commands == &qmp_cap_negotiation_commands;
+        inventory->oob_enabled_monitors +=
+            qmp_mon->capab[QMP_CAPABILITY_OOB];
+        qemu_mutex_unlock(&qmp_mon->parent_obj.mon_lock);
+
+        qemu_mutex_lock(&qmp_mon->qmp_queue_lock);
+        if (UINT64_MAX - inventory->queued_requests <
+            qmp_mon->qmp_requests->length) {
+            inventory->overflowed = true;
+        } else {
+            inventory->queued_requests += qmp_mon->qmp_requests->length;
+        }
+        completed_active_oob_frame = qmp_mon == active_oob_monitor &&
+            qmp_mon->active_oob_dispatch_depth == 1 &&
+            json_message_parser_is_emitting_complete_value(&qmp_mon->parser);
+        parser_bytes = completed_active_oob_frame ? 0 :
+            qmp_mon->parser.token_size;
+        if (qmp_mon->parser.lexer.state !=
+            qmp_mon->parser.lexer.start_state &&
+            qmp_mon->parser.lexer.token) {
+            if (UINT64_MAX - parser_bytes < qmp_mon->parser.lexer.token->len) {
+                inventory->overflowed = true;
+                parser_bytes = UINT64_MAX;
+            } else {
+                parser_bytes += qmp_mon->parser.lexer.token->len;
+            }
+        }
+        if (UINT64_MAX - inventory->parser_buffered_bytes < parser_bytes) {
+            inventory->overflowed = true;
+        } else {
+            inventory->parser_buffered_bytes += parser_bytes;
+        }
+        parser_partial = !completed_active_oob_frame &&
+            (parser_bytes != 0 ||
+            !g_queue_is_empty(qmp_mon->parser.parser.stack) ||
+            qmp_mon->parser.brace_count != 0 ||
+            qmp_mon->parser.bracket_count != 0 ||
+            qmp_mon->parser.lexer.state !=
+                qmp_mon->parser.lexer.start_state);
+        inventory->partial_parsers += parser_partial;
+        qemu_mutex_unlock(&qmp_mon->qmp_queue_lock);
+        qemu_rec_mutex_unlock(&qmp_mon->qmp_parser_lock);
+    }
+    inventory->complete = !inventory->overflowed &&
+        inventory->unstable_monitors == 0 &&
+        monitor_hot_fork_lifecycle_transitions == 0;
+}
+
+void monitor_hot_fork_inventory(MonitorHotForkInventory *inventory)
+{
+    qemu_mutex_lock(&monitor_lock);
+    monitor_hot_fork_inventory_locked(inventory, NULL);
+    qemu_mutex_unlock(&monitor_lock);
+}
+
+void monitor_hot_fork_inventory_for_active_oob(
+    MonitorHotForkInventory *inventory, MonitorQMP *active_oob_monitor)
+{
+    qemu_mutex_lock(&monitor_lock);
+    monitor_hot_fork_inventory_locked(inventory, active_oob_monitor);
+    qemu_mutex_unlock(&monitor_lock);
+}
+
+bool monitor_hot_fork_inventory_is_supported(
+    const MonitorHotForkInventory *inventory)
+{
+    return inventory && inventory->generation != 0 && inventory->complete &&
+        !inventory->overflowed && inventory->monitor_count == 1 &&
+        inventory->qmp_monitors == 1 && inventory->hmp_monitors == 0 &&
+        inventory->io_thread_monitors == 1 &&
+        inventory->suspended_monitors == 0 &&
+        inventory->negotiating_monitors == 0 &&
+        inventory->oob_enabled_monitors == 1 &&
+        inventory->queued_requests == 0 &&
+        inventory->parser_buffered_bytes == 0 &&
+        inventory->partial_parsers == 0 &&
+        inventory->unstable_monitors == 0;
+}
+
+static Chardev *monitor_hot_fork_child_chardev(MonitorQMP *monitor)
+{
+    Chardev *chardev;
+    ChardevClass *klass;
+
+    chardev = qemu_chr_fe_get_driver(&monitor->parent_obj.chr);
+    if (!chardev || chardev->fe != &monitor->parent_obj.chr ||
+        !qemu_chr_has_feature(chardev, QEMU_CHAR_FEATURE_GCONTEXT)) {
+        return NULL;
+    }
+    klass = CHARDEV_GET_CLASS(chardev);
+    if (!klass->chr_disconnect || !klass->chr_add_client) {
+        return NULL;
+    }
+    return chardev;
+}
+
+int monitor_hot_fork_prepare_child_basis(
+    MonitorHotForkChildBasis *basis, uint64_t expected_generation,
+    MonitorQMP *active_oob_monitor)
+{
+    MonitorHotForkInventory inventory;
+    QemuChrSocketHotForkChildBasis socket = { 0 };
+    Chardev *chardev;
+    GMainContext *context;
+    MonitorQMP *qmp_mon;
+    Monitor *mon;
+    int result = 0;
+
+    if (!basis || expected_generation == 0 || !active_oob_monitor) {
+        return -EINVAL;
+    }
+
+    qemu_mutex_lock(&monitor_lock);
+    monitor_hot_fork_inventory_locked(&inventory, active_oob_monitor);
+    if (!monitor_hot_fork_inventory_is_supported(&inventory)) {
+        result = -ENOTSUP;
+        goto out;
+    }
+    if (inventory.generation != expected_generation) {
+        result = -ESTALE;
+        goto out;
+    }
+    mon = QTAILQ_FIRST(&mon_list);
+    qmp_mon = mon ? MONITOR_QMP(
+        object_dynamic_cast(OBJECT(mon), TYPE_MONITOR_QMP)) : NULL;
+    if (!mon || QTAILQ_NEXT(mon, entry) || !qmp_mon ||
+        qmp_mon != active_oob_monitor ||
+        !mon_iothread || !qmp_dispatcher_co || qmp_dispatcher_co_shutdown) {
+        result = -EPROTO;
+        goto out;
+    }
+    chardev = monitor_hot_fork_child_chardev(qmp_mon);
+    if (!chardev) {
+        result = -ENOTSUP;
+        goto out;
+    }
+    context = iothread_get_g_main_context(mon_iothread);
+    result = qemu_chr_socket_hot_fork_prepare_child_basis(
+        &socket, chardev, &qmp_mon->parent_obj.chr, context);
+    if (result != 0) {
+        goto out;
+    }
+
+    *basis = (MonitorHotForkChildBasis) {
+        .generation = expected_generation,
+        .monitor = qmp_mon,
+        .iothread = mon_iothread,
+        .dispatcher = qmp_dispatcher_co,
+        .chardev = chardev,
+        .socket = socket,
+        .iothread_context = context,
+        .iothread_thread_id = mon_iothread->thread_id,
+        .prepared = true,
+    };
+out:
+    qemu_mutex_unlock(&monitor_lock);
+    return result;
+}
+
+bool monitor_hot_fork_child_basis_prepared_for(
+    const MonitorHotForkChildBasis *basis, uint64_t expected_generation)
+{
+    return basis && basis->prepared && expected_generation != 0 &&
+        basis->generation == expected_generation && basis->monitor &&
+        basis->iothread && basis->dispatcher && basis->iothread_context &&
+        basis->iothread_thread_id > 0;
+}
+
+bool monitor_hot_fork_child_disposition_prepared_for(
+    const MonitorHotForkChildBasis *basis, uint64_t expected_generation)
+{
+    return monitor_hot_fork_child_basis_prepared_for(
+               basis, expected_generation) && basis->chardev;
+}
+
+bool monitor_hot_fork_child_socket_resources_prepared_for(
+    const MonitorHotForkChildBasis *basis, uint64_t expected_generation)
+{
+    return monitor_hot_fork_child_disposition_prepared_for(
+               basis, expected_generation) &&
+        qemu_chr_socket_hot_fork_child_basis_matches(
+            &basis->socket, basis->chardev,
+            &basis->monitor->parent_obj.chr,
+            iothread_get_g_main_context(basis->iothread));
+}
+
+bool monitor_hot_fork_child_basis_matches_current(
+    const MonitorHotForkChildBasis *basis, uint64_t expected_generation)
+{
+    MonitorHotForkInventory inventory;
+    MonitorQMP *qmp_mon;
+    Monitor *mon;
+    bool matches;
+
+    if (!monitor_hot_fork_child_basis_prepared_for(
+            basis, expected_generation)) {
+        return false;
+    }
+
+    qemu_mutex_lock(&monitor_lock);
+    monitor_hot_fork_inventory_locked(&inventory, basis->monitor);
+    mon = QTAILQ_FIRST(&mon_list);
+    qmp_mon = mon ? MONITOR_QMP(
+        object_dynamic_cast(OBJECT(mon), TYPE_MONITOR_QMP)) : NULL;
+    matches = monitor_hot_fork_inventory_is_supported(&inventory) &&
+        inventory.generation == expected_generation && mon &&
+        !QTAILQ_NEXT(mon, entry) && qmp_mon && basis->monitor == qmp_mon &&
+        basis->iothread == mon_iothread &&
+        basis->iothread_context ==
+            iothread_get_g_main_context(basis->iothread) &&
+        basis->iothread_thread_id == basis->iothread->thread_id &&
+        basis->dispatcher == qmp_dispatcher_co &&
+        basis->chardev == monitor_hot_fork_child_chardev(basis->monitor) &&
+        monitor_hot_fork_child_socket_resources_prepared_for(
+            basis, expected_generation) &&
+        !qmp_dispatcher_co_shutdown;
+    qemu_mutex_unlock(&monitor_lock);
+    return matches;
+}
+
+static bool monitor_hot_fork_child_local_state_clean(MonitorQMP *qmp_mon)
+{
+    Monitor *mon = &qmp_mon->parent_obj;
+    bool clean;
+
+    qemu_mutex_lock(&mon->mon_lock);
+    clean = QLIST_EMPTY(&mon->fds) && mon->outbuf &&
+        mon->outbuf->len == 0 && mon->out_watch == 0 &&
+        mon->mux_out == 0 && mon->reset_seen == 0 &&
+        mon->chr.fe_is_open;
+    qemu_mutex_unlock(&mon->mon_lock);
+    return clean;
+}
+
+/* Names each local-state predicate on the child's diagnostics stream. */
+static void monitor_hot_fork_child_report_local_state(MonitorQMP *qmp_mon)
+{
+    Monitor *mon = &qmp_mon->parent_obj;
+
+    qemu_mutex_lock(&mon->mon_lock);
+    fprintf(stderr,
+            "crucible hot-fork monitor child local state: fd-names-empty %d "
+            "outbuf %d outbuf-len %zu out-watch %u mux-out %d reset-seen %d "
+            "frontend-open %d\n",
+            QLIST_EMPTY(&mon->fds), mon->outbuf != NULL,
+            mon->outbuf ? (size_t)mon->outbuf->len : (size_t)0,
+            mon->out_watch, mon->mux_out, mon->reset_seen,
+            mon->chr.fe_is_open);
+    qemu_mutex_unlock(&mon->mon_lock);
+}
+
+/*
+ * Global fdsets are system-emulator state, while this file is also linked
+ * into tools such as qemu-storage-daemon.  Require the system-only owner to
+ * register its exact inventory check instead of weakening non-system builds
+ * with a stub that could report a false clean state.
+ */
+static bool (*monitor_hot_fork_fdsets_empty)(void);
+
+void monitor_hot_fork_register_fdsets_empty(bool (*check)(void))
+{
+    assert(check);
+    assert(!monitor_hot_fork_fdsets_empty);
+    monitor_hot_fork_fdsets_empty = check;
+}
+
+/*
+ * The per-monitor getfd registry likewise lives with the system emulator;
+ * a build without it has no names for a child to drop.
+ */
+static unsigned int (*monitor_hot_fork_drop_fd_names)(Monitor *mon);
+
+void monitor_hot_fork_register_drop_fd_names(
+    unsigned int (*drop)(Monitor *mon))
+{
+    assert(drop);
+    assert(!monitor_hot_fork_drop_fd_names);
+    monitor_hot_fork_drop_fd_names = drop;
+}
+
+/* Names the failing stage on the child's diagnostics stream (its stderr). */
+static void monitor_hot_fork_report_child_stage(const char *stage, int result)
+{
+    fprintf(stderr, "crucible hot-fork monitor child %s stage failed: "
+            "result %d\n", stage, result);
+}
+
+int monitor_hot_fork_reconstruct_child_protocol_held(
+    MonitorHotForkChildBasis *basis, int replacement_fd,
+    uint64_t expected_socket_cookie)
+{
+    MonitorHotForkInventory inventory;
+    Coroutine *replacement_dispatcher = NULL;
+    int64_t replacement_iothread_id = 0;
+    MonitorQMP *current_qmp;
+    MonitorQMP *qmp_mon;
+    Monitor *mon;
+    int result;
+
+    if (!basis || !basis->prepared || !basis->monitor ||
+        !basis->iothread || !basis->dispatcher || !basis->chardev ||
+        basis->socket.source_pid <= 0) {
+        return -EINVAL;
+    }
+    if (basis->socket.source_pid == getpid() || basis->attempted ||
+        basis->socket.attempted) {
+        return -EPERM;
+    }
+
+    qemu_mutex_lock(&monitor_lock);
+    monitor_hot_fork_inventory_locked(&inventory, basis->monitor);
+    mon = QTAILQ_FIRST(&mon_list);
+    current_qmp = mon ? MONITOR_QMP(
+        object_dynamic_cast(OBJECT(mon), TYPE_MONITOR_QMP)) : NULL;
+    qmp_mon = basis->monitor;
+    /*
+     * The source's getfd names survive the fork while the numbers behind
+     * them did not: the child's descriptor table transaction closed or
+     * replaced each one before this reconstruction.  Drop the names so the
+     * inherited registry cannot be used to close a descriptor the
+     * transaction now owns; only then is the local state judged.
+     */
+    if (monitor_hot_fork_drop_fd_names) {
+        monitor_hot_fork_drop_fd_names(&qmp_mon->parent_obj);
+    }
+    /*
+     * The source's monitor thread was inside the fork command, so the
+     * current-monitor table binds that thread's leader coroutine to this
+     * monitor.  The thread is gone, but the C library hands its stack and
+     * thread-local storage to the replacement, whose leader then inherits
+     * the binding and trips dispatch's assertion that no monitor is
+     * current.  No coroutine in the child is inside a command: the
+     * dispatcher is idle and rebuilt below, and the forking thread was in
+     * the main loop, not a command.  Drop every binding.
+     */
+    g_hash_table_remove_all(coroutine_mon);
+    {
+        /*
+         * Each precondition is evaluated on its own so a stale basis names
+         * the one that moved; the child has no other way to say why its
+         * inherited monitor no longer matches the retained basis.
+         */
+        const bool supported =
+            monitor_hot_fork_inventory_is_supported(&inventory);
+        const bool generation_matches =
+            inventory.generation == basis->generation;
+        const bool single_qmp_monitor = mon && !QTAILQ_NEXT(mon, entry) &&
+            current_qmp && qmp_mon == current_qmp;
+        const bool iothread_matches = basis->iothread == mon_iothread &&
+            basis->iothread_context ==
+                iothread_get_g_main_context(basis->iothread);
+        const bool iothread_id_matches =
+            basis->iothread_thread_id == basis->iothread->thread_id;
+        const bool dispatcher_matches =
+            basis->dispatcher == qmp_dispatcher_co &&
+            !qmp_dispatcher_co_shutdown;
+        const bool dispatcher_idle =
+            monitor_qmp_hot_fork_dispatcher_is_idle(basis->dispatcher);
+        const bool chardev_matches = single_qmp_monitor &&
+            basis->chardev == monitor_hot_fork_child_chardev(qmp_mon);
+        const bool local_state_clean = single_qmp_monitor &&
+            monitor_hot_fork_child_local_state_clean(qmp_mon);
+        const bool fdsets_empty = monitor_hot_fork_fdsets_empty &&
+            monitor_hot_fork_fdsets_empty();
+
+        if (!supported || !generation_matches || !single_qmp_monitor ||
+            !iothread_matches || !iothread_id_matches ||
+            !dispatcher_matches || !dispatcher_idle || !chardev_matches ||
+            !local_state_clean || !fdsets_empty) {
+            if (single_qmp_monitor && !local_state_clean) {
+                monitor_hot_fork_child_report_local_state(qmp_mon);
+            }
+            fprintf(stderr,
+                    "crucible hot-fork monitor child basis is stale: "
+                    "supported %d generation %d single-qmp-monitor %d "
+                    "iothread %d iothread-id %d dispatcher %d "
+                    "dispatcher-idle %d chardev %d local-state-clean %d "
+                    "fdsets-empty %d\n",
+                    supported, generation_matches, single_qmp_monitor,
+                    iothread_matches, iothread_id_matches,
+                    dispatcher_matches, dispatcher_idle, chardev_matches,
+                    local_state_clean, fdsets_empty);
+            result = -ESTALE;
+            goto out;
+        }
+    }
+
+    result = qemu_chr_socket_hot_fork_reconstruct_child_held(
+        &basis->socket, replacement_fd, expected_socket_cookie);
+    if (result != 0) {
+        monitor_hot_fork_report_child_stage("socket", result);
+        goto out;
+    }
+    basis->attempted = true;
+
+    result = monitor_qmp_hot_fork_reset_protocol_held(qmp_mon);
+    if (result == 0) {
+        basis->parser_reset = true;
+        basis->capabilities_reset = true;
+        basis->inherited_protocol_disposed = true;
+        basis->input_held = basis->socket.input_held;
+        result = basis->input_held ? 0 : -EPROTO;
+    }
+    if (result != 0) {
+        monitor_hot_fork_report_child_stage("protocol reset", result);
+    }
+out:
+    qemu_mutex_unlock(&monitor_lock);
+    if (result == 0) {
+        result = monitor_qmp_hot_fork_rebuild_dispatcher_held(
+            basis->dispatcher, &replacement_dispatcher);
+        if (result != 0) {
+            monitor_hot_fork_report_child_stage("dispatcher", result);
+        }
+        if (result == 0) {
+            basis->dispatcher = replacement_dispatcher;
+            basis->dispatcher_rebuilt = true;
+            result = iothread_hot_fork_reconstruct_child(
+                basis->iothread, basis->iothread_thread_id,
+                basis->socket.source_pid, &replacement_iothread_id);
+            if (result != 0) {
+                monitor_hot_fork_report_child_stage("iothread", result);
+            }
+            if (result == 0) {
+                /*
+                 * The rebuilt thread runs a fresh GMainContext; the held
+                 * monitor socket and the basis follow it before any source
+                 * is attached.
+                 */
+                GMainContext *replacement_context =
+                    iothread_get_g_main_context(basis->iothread);
+
+                result = qemu_chr_socket_hot_fork_rehome_child_context(
+                    &basis->socket, basis->iothread_context,
+                    replacement_context);
+                if (result != 0) {
+                    monitor_hot_fork_report_child_stage("rehome", result);
+                } else {
+                    basis->iothread_context = replacement_context;
+                    basis->iothread_thread_id = replacement_iothread_id;
+                    basis->iothread_rebuilt = true;
+                }
+            }
+        }
+    }
+    return result;
+}
+
+typedef enum MonitorHotForkProtocolOperation {
+    MONITOR_HOT_FORK_PROTOCOL_GREET_HELD,
+    MONITOR_HOT_FORK_PROTOCOL_RELEASE_INPUT,
+} MonitorHotForkProtocolOperation;
+
+typedef struct MonitorHotForkProtocolTransition {
+    MonitorHotForkChildBasis *basis;
+    MonitorHotForkProtocolOperation operation;
+    int result;
+} MonitorHotForkProtocolTransition;
+
+static bool monitor_hot_fork_child_protocol_is_held(MonitorQMP *qmp_mon)
+{
+    bool held = true;
+    QMPCapability capability;
+
+    qemu_rec_mutex_lock(&qmp_mon->qmp_parser_lock);
+    qemu_mutex_lock(&qmp_mon->parent_obj.mon_lock);
+    qemu_mutex_lock(&qmp_mon->qmp_queue_lock);
+    held = qmp_mon->commands == &qmp_cap_negotiation_commands &&
+        g_queue_is_empty(qmp_mon->qmp_requests) &&
+        qmp_mon->parser.token_size == 0 &&
+        g_queue_is_empty(qmp_mon->parser.parser.stack) &&
+        qmp_mon->parser.brace_count == 0 &&
+        qmp_mon->parser.bracket_count == 0 &&
+        (!qmp_mon->parser.lexer.token ||
+         qmp_mon->parser.lexer.token->len == 0) &&
+        qmp_mon->parser.lexer.state == qmp_mon->parser.lexer.start_state;
+    for (capability = 0; held && capability < QMP_CAPABILITY__MAX;
+         capability++) {
+        held = !qmp_mon->capab[capability] &&
+            qmp_mon->capab_offered[capability] ==
+                (capability == QMP_CAPABILITY_OOB);
+    }
+    held = held && monitor_requires_iothread(&qmp_mon->parent_obj);
+    qemu_mutex_unlock(&qmp_mon->qmp_queue_lock);
+    qemu_mutex_unlock(&qmp_mon->parent_obj.mon_lock);
+    qemu_rec_mutex_unlock(&qmp_mon->qmp_parser_lock);
+    return held;
+}
+
+static bool monitor_hot_fork_child_output_is_flushed(MonitorQMP *qmp_mon)
+{
+    Monitor *mon = &qmp_mon->parent_obj;
+    bool flushed;
+
+    qemu_mutex_lock(&mon->mon_lock);
+    flushed = mon->outbuf && mon->outbuf->len == 0;
+    qemu_mutex_unlock(&mon->mon_lock);
+    return flushed;
+}
+
+static void monitor_hot_fork_child_protocol_transition_bh(void *opaque)
+{
+    MonitorHotForkProtocolTransition *transition = opaque;
+    MonitorHotForkChildBasis *basis = transition->basis;
+    Monitor *listed;
+
+    transition->result = -ESTALE;
+    {
+        /*
+         * Evaluated one by one so a stale transition names what moved on
+         * the child's diagnostics stream; the result alone says only that
+         * the rebuilt monitor no longer matches its basis.
+         */
+        const bool on_iothread =
+            qemu_get_thread_id() == basis->iothread_thread_id;
+        const bool iothread_matches = basis->iothread == mon_iothread &&
+            basis->iothread_context ==
+                iothread_get_g_main_context(basis->iothread);
+        const bool dispatcher_matches =
+            basis->dispatcher == qmp_dispatcher_co &&
+            !qmp_dispatcher_co_shutdown;
+        const bool dispatcher_idle =
+            monitor_qmp_hot_fork_dispatcher_is_idle(basis->dispatcher);
+
+        if (!on_iothread || !iothread_matches || !dispatcher_matches ||
+            !dispatcher_idle) {
+            fprintf(stderr,
+                    "crucible hot-fork monitor child transition %u is "
+                    "stale: on-iothread %d iothread %d dispatcher %d "
+                    "dispatcher-idle %d\n",
+                    transition->operation, on_iothread, iothread_matches,
+                    dispatcher_matches, dispatcher_idle);
+            return;
+        }
+    }
+
+    qemu_mutex_lock(&monitor_lock);
+    listed = QTAILQ_FIRST(&mon_list);
+    {
+        const bool generation_matches =
+            !monitor_hot_fork_generation_overflowed &&
+            monitor_hot_fork_generation == basis->generation;
+        const bool single_qmp_monitor = listed &&
+            !QTAILQ_NEXT(listed, entry) &&
+            object_dynamic_cast(OBJECT(listed), TYPE_MONITOR_QMP) ==
+                OBJECT(basis->monitor);
+        const bool chardev_matches = single_qmp_monitor &&
+            basis->chardev == monitor_hot_fork_child_chardev(basis->monitor);
+        const bool reconstructed = basis->attempted &&
+            basis->inherited_protocol_disposed && basis->dispatcher_rebuilt &&
+            basis->iothread_rebuilt && basis->parser_reset &&
+            basis->capabilities_reset && basis->input_held &&
+            !basis->input_released;
+        const bool protocol_held = single_qmp_monitor &&
+            monitor_hot_fork_child_protocol_is_held(basis->monitor);
+        const bool socket_input_held =
+            qemu_chr_socket_hot_fork_child_input_is_held(
+                &basis->socket, basis->iothread_context);
+
+        if (!generation_matches || !single_qmp_monitor ||
+            !chardev_matches || !reconstructed || !protocol_held ||
+            !socket_input_held) {
+            fprintf(stderr,
+                    "crucible hot-fork monitor child transition %u is "
+                    "stale: generation %d single-qmp-monitor %d chardev %d "
+                    "reconstructed %d protocol-held %d socket-input-held "
+                    "%d\n",
+                    transition->operation, generation_matches,
+                    single_qmp_monitor, chardev_matches, reconstructed,
+                    protocol_held, socket_input_held);
+            goto out;
+        }
+    }
+
+    switch (transition->operation) {
+    case MONITOR_HOT_FORK_PROTOCOL_GREET_HELD:
+        if (basis->greeting_emitted ||
+            !monitor_hot_fork_child_local_state_clean(basis->monitor)) {
+            fprintf(stderr, "crucible hot-fork monitor child greeting is "
+                    "stale: greeted %d\n", basis->greeting_emitted);
+            monitor_hot_fork_child_report_local_state(basis->monitor);
+            goto out;
+        }
+        qemu_chr_be_event(basis->chardev, CHR_EVENT_OPENED);
+        basis->greeting_emitted = true;
+        transition->result = 0;
+        break;
+    case MONITOR_HOT_FORK_PROTOCOL_RELEASE_INPUT:
+        if (!basis->greeting_emitted) {
+            transition->result = -EPROTO;
+            goto out;
+        }
+        monitor_flush(&basis->monitor->parent_obj);
+        if (!monitor_hot_fork_child_output_is_flushed(basis->monitor)) {
+            transition->result = -EAGAIN;
+            goto out;
+        }
+        transition->result = qemu_chr_socket_hot_fork_release_child_input(
+            &basis->socket, basis->iothread_context);
+        if (transition->result != 0) {
+            goto out;
+        }
+        basis->input_held = false;
+        basis->input_released = true;
+        break;
+    default:
+        transition->result = -EINVAL;
+        goto out;
+    }
+out:
+    qemu_mutex_unlock(&monitor_lock);
+}
+
+static int monitor_hot_fork_run_child_protocol_transition(
+    MonitorHotForkChildBasis *basis, MonitorHotForkProtocolOperation operation)
+{
+    MonitorHotForkProtocolTransition transition = {
+        .basis = basis,
+        .operation = operation,
+        .result = -ESTALE,
+    };
+
+    if (!basis || !basis->prepared || !basis->monitor ||
+        !basis->iothread || !basis->dispatcher || !basis->chardev ||
+        !basis->iothread_context || basis->socket.source_pid <= 0) {
+        return -EINVAL;
+    }
+    if (basis->socket.source_pid == getpid() || basis->input_released) {
+        return -EPERM;
+    }
+    if (!qemu_async_worker_hot_fork_admission_try_begin()) {
+        return -EBUSY;
+    }
+    aio_wait_bh_oneshot(iothread_get_aio_context(basis->iothread),
+                        monitor_hot_fork_child_protocol_transition_bh,
+                        &transition);
+    qemu_async_worker_hot_fork_admission_end();
+    return transition.result;
+}
+
+int monitor_hot_fork_greet_child_protocol_held(
+    MonitorHotForkChildBasis *basis)
+{
+    if (basis && basis->greeting_emitted) {
+        return -EPERM;
+    }
+    return monitor_hot_fork_run_child_protocol_transition(
+        basis, MONITOR_HOT_FORK_PROTOCOL_GREET_HELD);
+}
+
+int monitor_hot_fork_release_child_protocol_input(
+    MonitorHotForkChildBasis *basis)
+{
+    return monitor_hot_fork_run_child_protocol_transition(
+        basis, MONITOR_HOT_FORK_PROTOCOL_RELEASE_INPUT);
+}
+
+void monitor_hot_fork_reset_child_basis(MonitorHotForkChildBasis *basis)
+{
+    if (basis) {
+        *basis = (MonitorHotForkChildBasis) { 0 };
+    }
+}
