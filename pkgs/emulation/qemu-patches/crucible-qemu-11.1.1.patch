+    status = qemu_crucible_cpu_tlb_storage_constructor_identity_v1(
+        request, &binding, &parent_owner, &serial);
+    if (!status) {
+        status = object_native_cpu_tlb_request_storage_identity(
+            request, &cpu, &account, &storage);
+    }
+    if (status) {
+        return status;
+    }
+    if (!storage || !storage->active || storage->source != owner ||
+        storage->parent != parent_owner || storage->account != account ||
+        storage->serial != serial || OBJECT(storage->cpu) != cpu) {
+        return -ESTALE;
+    }
+    /* Source saves this genuine produced interior before semantic current. */
+    *out = storage;
+    return 0;
+}
+
+int qemu_crucible_cpu_tlb_storage_instance_identity_v1(
+    QemuCrucibleCpuTlbStorage *storage, QemuCrucibleCpuTlbSourceOwner *owner,
+    QemuCrucibleCpuMetadataAccount **account,
+    QemuCrucibleCpuSourceAllocationOwner **parent_owner, uint64_t *serial)
+{
+    /* Source first authenticates its actual retained header and exact aligned
+     * interior. These target facts neither mint a header nor query a clock. */
+    if (!storage || !owner || !account || *account || !parent_owner ||
+        *parent_owner || !serial || !storage->active || storage->source != owner ||
+        storage->process != getpid() || !storage->serial || !storage->account ||
+        !storage->parent) {
+        return -ESTALE;
+    }
+    *account = storage->account;
+    *parent_owner = storage->parent;
+    *serial = storage->serial;
+    return 0;
+}
+
+static bool tlb_metadata_storage_live(QemuCrucibleCpuTlbStorage *storage)
+{
+    return storage && storage->active &&
+        !qatomic_load_acquire(&storage->closed) && storage->source &&
+        storage->process == getpid() && storage->cpu &&
+        storage->cpu->crucible_tlb_storage == storage;
+}
+
+int qemu_crucible_cpu_tlb_storage_returned_current_v1(
+    QemuCrucibleCpuTlbStorage *storage, QemuCrucibleCpuTlbSourceOwner *owner)
+{
+    if (!storage || !owner || !storage->active || storage->source != owner ||
+        storage->process != getpid()) {
+        return -ESTALE;
+    }
+    if (!qatomic_load_acquire(&storage->closed)) {
+        return -EBUSY;
+    }
+    /* closed was emitted by the real destroy/abandoned-init producer, before
+     * CPU storage can disappear. Terminal checks do not dereference that CPU. */
+    for (size_t mmu = 0; mmu < NB_MMU_MODES; mmu++) {
+        if (storage->transitions[mmu].source ||
+            (storage->transitions[mmu].phase != CPU_TLB_TRANSITION_IDLE &&
+             storage->transitions[mmu].phase != CPU_TLB_TRANSITION_ENDED)) {
+            return -EBUSY;
+        }
+        for (size_t kind = 0; kind < CPU_TLB_ALLOCATION_KINDS; kind++) {
+            QemuCrucibleCpuTlbAllocationRequest *row = &storage->rows[mmu][kind];
+
+            if (row->phase != CPU_TLB_ALLOCATION_IDLE &&
+                qemu_crucible_cpu_tlb_allocation_returned_current_v1(
+                    storage, owner, row, row->serial)) {
+                return -EBUSY;
+            }
+        }
+    }
+    return 0;
+}
+
+int qemu_crucible_cpu_tlb_storage_identity_return_v1(
+    QemuCrucibleCpuTlbStorage **owner, QemuCrucibleCpuTlbSourceOwner *source)
+{
+    int status;
+
+    if (!owner || !*owner) {
+        return -EINVAL;
+    }
+    status = qemu_crucible_cpu_tlb_storage_returned_current_v1(*owner, source);
+    if (!status) {
+        for (size_t mmu = 0; mmu < NB_MMU_MODES; mmu++) {
+            for (size_t kind = 0; kind < CPU_TLB_ALLOCATION_KINDS; kind++) {
+                if ((*owner)->rows[mmu][kind].phase != CPU_TLB_ALLOCATION_IDLE) {
+                    return -EBUSY;
+                }
+            }
+        }
+        (*owner)->active = false;
+        *owner = NULL;
+    }
+    return status;
+}
+
+/* Source authenticates and retains its paid header and exact aligned storage
+ * before calling these lookups. Compare the nominated address against that
+ * real typed interior before reading any nominated request field. */
+static int tlb_metadata_transition_lookup(
+    QemuCrucibleCpuTlbStorage *storage, QemuCrucibleCpuTlbSourceOwner *source,
+    QemuCrucibleCpuTlbTransitionRequest *request)
+{
+    QemuCrucibleCpuMetadataAccount *account = NULL;
+    QemuCrucibleCpuSourceAllocationOwner *parent = NULL;
+    uint64_t serial = 0;
+    int status;
+
+    if (!request) {
+        return -EINVAL;
+    }
+    status = qemu_crucible_cpu_tlb_storage_instance_identity_v1(
+        storage, source, &account, &parent, &serial);
+    if (status) {
+        return status;
+    }
+    for (size_t mmu = 0; mmu < NB_MMU_MODES; mmu++) {
+        if (request == &storage->transitions[mmu]) {
+            return request->storage == storage && request->mmu == mmu ?
+                0 : -ESTALE;
+        }
+    }
+    return -ESTALE;
+}
+
+static int tlb_metadata_allocation_lookup(
+    QemuCrucibleCpuTlbStorage *storage, QemuCrucibleCpuTlbSourceOwner *source,
+    QemuCrucibleCpuTlbAllocationRequest *request)
+{
+    QemuCrucibleCpuMetadataAccount *account = NULL;
+    QemuCrucibleCpuSourceAllocationOwner *parent = NULL;
+    uint64_t serial = 0;
+    int status;
+
+    if (!request) {
+        return -EINVAL;
+    }
+    status = qemu_crucible_cpu_tlb_storage_instance_identity_v1(
+        storage, source, &account, &parent, &serial);
+    if (status) {
+        return status;
+    }
+    for (size_t mmu = 0; mmu < NB_MMU_MODES; mmu++) {
+        for (size_t kind = 0; kind < CPU_TLB_ALLOCATION_KINDS; kind++) {
+            if (request == &storage->rows[mmu][kind]) {
+                return request->storage == storage && request->mmu == mmu &&
+                    request->kind == (CpuTlbAllocationKind)kind ? 0 : -ESTALE;
+            }
+        }
+    }
+    return -ESTALE;
+}
+
+int qemu_crucible_cpu_tlb_transition_identity_v1(
+    QemuCrucibleCpuTlbStorage *storage, QemuCrucibleCpuTlbSourceOwner *source,
+    QemuCrucibleCpuTlbTransitionRequest *request, size_t *mmu, uint64_t *serial)
+{
+    int status;
+
+    if (!mmu || !serial) {
+        return -EINVAL;
+    }
+    status = tlb_metadata_transition_lookup(storage, source, request);
+    if (status) {
+        return status;
+    }
+    if (!request->serial) {
+        return -ESTALE;
+    }
+    *mmu = request->mmu;
+    *serial = request->serial;
+    return 0;
+}
+
+int qemu_crucible_cpu_tlb_transition_request_current_v1(
+    QemuCrucibleCpuTlbStorage *storage, QemuCrucibleCpuTlbSourceOwner *source,
+    QemuCrucibleCpuTlbTransitionRequest *request,
+    QemuCrucibleCpuTlbStorage **out, size_t *mmu, uint64_t *serial)
+{
+    int status;
+
+    if (!request || !out || *out || !mmu || !serial) {
+        return -EINVAL;
+    }
+    status = tlb_metadata_transition_lookup(storage, source, request);
+    if (status) {
+        return status;
+    }
+    if (!tlb_metadata_storage_live(storage) || request->mmu >= NB_MMU_MODES ||
+        request != &storage->transitions[request->mmu] ||
+        request->phase != CPU_TLB_TRANSITION_ENTERED || !request->serial) {
+        return -ESTALE;
+    }
+    *out = storage;
+    *mmu = request->mmu;
+    *serial = request->serial;
+    return 0;
+}
+
+int qemu_crucible_cpu_tlb_transition_returned_current_v1(
+    QemuCrucibleCpuTlbStorage *storage, QemuCrucibleCpuTlbSourceOwner *source,
+    QemuCrucibleCpuTlbTransitionRequest *request)
+{
+    int status;
+
+    if (!request) {
+        return -EINVAL;
+    }
+    status = tlb_metadata_transition_lookup(storage, source, request);
+    if (status) {
+        return status;
+    }
+    if (!tlb_metadata_storage_live(storage) || request->mmu >= NB_MMU_MODES ||
+        request != &storage->transitions[request->mmu] ||
+        request->phase != CPU_TLB_TRANSITION_RETURNING) {
+        return -ESTALE;
+    }
+    for (size_t kind = 0; kind < CPU_TLB_ALLOCATION_KINDS; kind++) {
+        CpuTlbAllocationPhase phase = storage->rows[request->mmu][kind].phase;
+
+        if (phase != CPU_TLB_ALLOCATION_IDLE && phase != CPU_TLB_ALLOCATION_LIVE) {
+            return -EBUSY;
+        }
+    }
+    return 0;
+}
+
+int qemu_crucible_cpu_tlb_allocation_identity_v1(
+    QemuCrucibleCpuTlbStorage *storage, QemuCrucibleCpuTlbSourceOwner *source,
+    QemuCrucibleCpuTlbAllocationRequest *request,
+    QemuCrucibleCpuTlbStorage **out, size_t *row, uint64_t *serial)
+{
+    int status;
+
+    if (!request || !out || *out || !row || !serial) {
+        return -EINVAL;
+    }
+    status = tlb_metadata_allocation_lookup(storage, source, request);
+    if (status) {
+        return status;
+    }
+    if (!storage || !storage->active || storage->process != getpid() ||
+        request->mmu >= NB_MMU_MODES || request->kind >= CPU_TLB_ALLOCATION_KINDS ||
+        request != &storage->rows[request->mmu][request->kind] || !request->serial) {
+        return -ESTALE;
+    }
+    /* The paid interior survives CPU free and captures a refused preallocator
+     * request before its independent accounting status. No clock is queried. */
+    *out = storage;
+    *row = request->mmu * CPU_TLB_ALLOCATION_KINDS + request->kind;
+    *serial = request->serial;
+    return 0;
+}
+
+int qemu_crucible_cpu_tlb_allocation_request_current_v1(
+    QemuCrucibleCpuTlbStorage *storage, QemuCrucibleCpuTlbSourceOwner *source,
+    QemuCrucibleCpuTlbAllocationRequest *request,
+    QemuCrucibleCpuTlbTransitionRequest **transition,
+    size_t *row, uint64_t *serial, size_t *bytes, size_t *alignment)
+{
+    int status;
+    size_t element;
+
+    if (!request || !transition || *transition || !row || !serial ||
+        !bytes || !alignment) {
+        return -EINVAL;
+    }
+    status = tlb_metadata_allocation_lookup(storage, source, request);
+    if (status) {
+        return status;
+    }
+    if (!tlb_metadata_storage_live(storage) || request->mmu >= NB_MMU_MODES ||
+        request->kind >= CPU_TLB_ALLOCATION_KINDS ||
+        request != &storage->rows[request->mmu][request->kind] ||
+        request->phase != CPU_TLB_ALLOCATION_BEFORE || !request->entries ||
+        !request->serial ||
+        storage->transitions[request->mmu].phase != CPU_TLB_TRANSITION_ENTERED ||
+        !storage->transitions[request->mmu].source) {
+        return -ESTALE;
+    }
+    if (request->kind == CPU_TLB_ALLOCATION_FAST) {
+        element = sizeof(CPUTLBEntry);
+        *alignment = _Alignof(CPUTLBEntry);
+    } else {
+        element = sizeof(CPUTLBEntryFull);
+        *alignment = _Alignof(CPUTLBEntryFull);
+    }
+    if (request->entries > SIZE_MAX / element) {
+        return -EOVERFLOW;
+    }
+    *transition = &storage->transitions[request->mmu];
+    *row = request->mmu * CPU_TLB_ALLOCATION_KINDS + request->kind;
+    *serial = request->serial;
+    *bytes = request->entries * element;
+    return 0;
+}
+
+int qemu_crucible_cpu_tlb_allocation_result_identity_v1(
+    QemuCrucibleCpuTlbStorage *storage, QemuCrucibleCpuTlbSourceOwner *source,
+    QemuCrucibleCpuTlbAllocationRequest *request,
+    uint64_t serial, void **payload)
+{
+    int status;
+
+    if (!request || !payload || *payload) {
+        return -EINVAL;
+    }
+    status = tlb_metadata_allocation_lookup(storage, source, request);
+    if (status) {
+        return status;
+    }
+    if (!tlb_metadata_storage_live(storage) || request->mmu >= NB_MMU_MODES ||
+        request->kind >= CPU_TLB_ALLOCATION_KINDS ||
+        request != &storage->rows[request->mmu][request->kind] ||
+        request->serial != serial || request->phase != CPU_TLB_ALLOCATION_RESULT ||
+        !request->allocator_entered || !request->allocator_returned ||
+        request->allocation_abandoned || request->free_returned) {
+        return -ESTALE;
+    }
+    /* A genuine g_try_new NULL is still a recorded allocator return. */
+    *payload = request->payload;
+    return 0;
+}
+
+int qemu_crucible_cpu_tlb_allocation_returned_current_v1(
+    QemuCrucibleCpuTlbStorage *storage, QemuCrucibleCpuTlbSourceOwner *source,
+    QemuCrucibleCpuTlbAllocationRequest *request, uint64_t serial)
+{
+    int status;
+
+    if (!request) {
+        return -EINVAL;
+    }
+    status = tlb_metadata_allocation_lookup(storage, source, request);
+    if (status) {
+        return status;
+    }
+    if (!storage || !storage->active || storage->process != getpid() ||
+        request->mmu >= NB_MMU_MODES || request->kind >= CPU_TLB_ALLOCATION_KINDS ||
+        request != &storage->rows[request->mmu][request->kind] ||
+        request->serial != serial || request->phase != CPU_TLB_ALLOCATION_RETURNED) {
+        return -ESTALE;
+    }
+    return request->free_returned ||
+        (request->allocation_abandoned && !request->allocator_entered) ?
+        0 : -EBUSY;
+}
+
+int qemu_crucible_cpu_tlb_allocation_identity_return_v1(
+    QemuCrucibleCpuTlbStorage *storage, QemuCrucibleCpuTlbSourceOwner *source,
+    QemuCrucibleCpuTlbAllocationRequest **owner, uint64_t serial)
+{
+    int status;
+
+    if (!owner || !*owner) {
+        return -EINVAL;
+    }
+    status = qemu_crucible_cpu_tlb_allocation_returned_current_v1(
+        storage, source, *owner, serial);
+    if (!status) {
+        (*owner)->phase = CPU_TLB_ALLOCATION_IDLE;
+        (*owner)->payload = NULL;
+        *owner = NULL;
+    }
+    return status;
+}
+
+static G_NORETURN void tlb_metadata_fail(int status)
+{
+    error_report("CPU TLB metadata custody failed: %s",
+                 strerror(status < 0 ? -status : EPROTO));
+    abort();
+}
+
+static QemuCrucibleCpuTlbStorage *tlb_metadata_storage_init(CPUState *cpu)
+{
+    QemuCrucibleCpuTlbStorageRequest *request = NULL;
+    QemuCrucibleObservationConstructionBinding *binding = NULL;
+    QemuCrucibleCpuSourceAllocationOwner *parent = NULL;
+    QemuCrucibleCpuMetadataAccount *account = NULL;
+    QemuCrucibleCpuTlbSourceOwner *owner = NULL;
+    QemuCrucibleCpuTlbStorage *storage = NULL;
+    uint64_t serial = 0;
+    int admission_status;
+    int storage_status;
+    int status;
+
+    status = object_native_cpu_tlb_request_begin(
+        OBJECT(cpu), cpu->thread, cpu->thread_free, &request);
+    if (status == -ENOENT) {
+        return NULL;
+    }
+    if (status) {
+        tlb_metadata_fail(status);
+    }
+    status = qemu_crucible_cpu_tlb_storage_constructor_current_v1(
+        request, &binding, &parent, &serial);
+    if (!status) {
+        status = qemu_crucible_startup_source_cpu_metadata_account_borrow_v1(
+            binding, &account);
+    }
+    if (account) {
+        int bind_status = object_native_cpu_tlb_request_account_bind(request, account);
+
+        if (!status) {
+            status = bind_status;
+        }
+    }
+    if (status || !account) {
+        int return_status = object_native_cpu_tlb_request_end(request);
+
+        if (return_status) {
+            error_report("CPU TLB constructor return failed: %s",
+                         strerror(-return_status));
+        }
+        tlb_metadata_fail(status);
+    }
+
+    admission_status = qemu_crucible_startup_source_cpu_tlb_storage_admit_v1(
+        request, &owner);
+    storage_status = owner ?
+        qemu_crucible_startup_source_cpu_tlb_storage_borrow_v1(
+            request, owner, &storage) : -ESTALE;
+    if (storage) {
+        /* A born-negative Source header retains this exact physical interior.
+         * Publish its native custody before any trailing semantic check. */
+        *storage = (QemuCrucibleCpuTlbStorage) {
+            .source = owner, .account = account, .parent = parent,
+            .cpu = cpu, .process = getpid(), .serial = serial, .active = true,
+        };
+        cpu->crucible_tlb_storage = storage;
+        for (size_t mmu = 0; mmu < NB_MMU_MODES; mmu++) {
+            storage->transitions[mmu].storage = storage;
+            storage->transitions[mmu].mmu = mmu;
+            for (size_t kind = 0; kind < CPU_TLB_ALLOCATION_KINDS; kind++) {
+                storage->rows[mmu][kind].storage = storage;
+                storage->rows[mmu][kind].mmu = mmu;
+                storage->rows[mmu][kind].kind = kind;
+            }
+        }
+        status = object_native_cpu_tlb_request_storage_bind(request, storage);
+    } else {
+        status = -ESTALE;
+    }
+    if (!status) {
+        status = admission_status ? admission_status : storage_status;
+    }
+    if (!status) {
+        status = qemu_crucible_startup_source_cpu_tlb_storage_result_v1(request, owner);
+    }
+    if (status) {
+        if (storage) {
+            qatomic_store_release(&storage->closed, true);
+            cpu->crucible_tlb_storage = NULL;
+        }
+        int return_status = object_native_cpu_tlb_request_end(request);
+
+        if (return_status) {
+            error_report("CPU TLB constructor return failed: %s",
+                         strerror(-return_status));
+        }
+        tlb_metadata_fail(status);
+    }
+    status = object_native_cpu_tlb_request_end(request);
+    if (status) {
+        tlb_metadata_fail(status);
+    }
+    return storage;
+}
+
+static int tlb_metadata_transition_begin(QemuCrucibleCpuTlbStorage *storage,
+                                         size_t mmu)
+{
+    QemuCrucibleCpuTlbTransitionRequest *request = &storage->transitions[mmu];
+
+    if (request->source ||
+        (request->phase != CPU_TLB_TRANSITION_IDLE &&
+         request->phase != CPU_TLB_TRANSITION_ENDED)) {
+        tlb_metadata_fail(-EBUSY);
+    }
+    if (request->serial == UINT64_MAX) {
+        tlb_metadata_fail(-EOVERFLOW);
+    }
+    request->serial++;
+    request->phase = CPU_TLB_TRANSITION_ENTERED;
+    /* This actual same-ledger reservation precedes any old-array free. It
+     * holds no native mutex and invokes no Source/module callback or clock. */
+    return qemu_crucible_startup_source_cpu_tlb_transition_begin_v1(
+        storage->source, request, &request->source);
+}
+
+static void tlb_metadata_transition_end(QemuCrucibleCpuTlbStorage *storage,
+                                        size_t mmu)
+{
+    QemuCrucibleCpuTlbTransitionRequest *request = &storage->transitions[mmu];
+    int status = 0;
+
+    request->phase = CPU_TLB_TRANSITION_RETURNING;
+    if (request->source) {
+        status = qemu_crucible_startup_source_cpu_tlb_transition_end_v1(
+            &request->source);
+    }
+    if (!request->source) {
+        request->phase = CPU_TLB_TRANSITION_ENDED;
+    }
+    if (status || request->source) {
+        tlb_metadata_fail(status);
+    }
+}
+
+static void *tlb_metadata_array_new(QemuCrucibleCpuTlbStorage *storage,
+                                    size_t mmu, CpuTlbAllocationKind kind,
+                                    size_t entries, bool try_allocate)
+{
+    QemuCrucibleCpuTlbAllocationRequest *request = &storage->rows[mmu][kind];
+    QemuCrucibleCpuTlbTransitionRequest *transition = &storage->transitions[mmu];
+    uint64_t serial = request->serial;
+    int status;
+
+    if (request->phase != CPU_TLB_ALLOCATION_IDLE || serial == UINT64_MAX) {
+        tlb_metadata_fail(-EBUSY);
+    }
+    *request = (QemuCrucibleCpuTlbAllocationRequest) {
+        .storage = storage, .entries = entries, .mmu = mmu, .kind = kind,
+        .serial = serial + 1, .phase = CPU_TLB_ALLOCATION_BEFORE,
+    };
+    status = qemu_crucible_startup_source_cpu_tlb_array_admit_v1(
+        transition->source, request);
+    if (status) {
+        /* Only this actual branch certifies that the allocator never ran.
+         * Signed identity/ledger failure is not an allocator OOM retry. */
+        request->allocation_abandoned = true;
+        request->phase = CPU_TLB_ALLOCATION_RETURNED;
+        int return_status = qemu_crucible_startup_source_cpu_tlb_array_return_v1(
+            transition->source, request);
+
+        if (return_status) {
+            error_report("CPU TLB abandoned request return failed: %s",
+                         strerror(return_status < 0 ? -return_status : EPROTO));
+        }
+        tlb_metadata_fail(status);
+    }
+    request->allocator_entered = true;
+    if (kind == CPU_TLB_ALLOCATION_FAST) {
+        request->payload = try_allocate ? g_try_new(CPUTLBEntry, entries) :
+            g_new(CPUTLBEntry, entries);
+    } else {
+        request->payload = try_allocate ? g_try_new(CPUTLBEntryFull, entries) :
+            g_new(CPUTLBEntryFull, entries);
+    }
+    request->allocator_returned = true;
+    request->phase = CPU_TLB_ALLOCATION_RESULT;
+    status = qemu_crucible_startup_source_cpu_tlb_array_result_v1(
+        transition->source, request);
+    if (status) {
+        tlb_metadata_fail(status);
+    }
+    request->phase = CPU_TLB_ALLOCATION_LIVE;
+    return request->payload;
+}
+
+static void tlb_metadata_array_free(QemuCrucibleCpuTlbStorage *storage,
+                                    size_t mmu, CpuTlbAllocationKind kind,
+                                    void *payload)
+{
+    QemuCrucibleCpuTlbAllocationRequest *request = &storage->rows[mmu][kind];
+    int status;
+
+    if (request->phase != CPU_TLB_ALLOCATION_LIVE ||
+        request->payload != payload || !request->allocator_returned) {
+        tlb_metadata_fail(-ESTALE);
+    }
+    request->phase = CPU_TLB_ALLOCATION_FREE;
+    g_free(payload);
+    request->free_returned = true;
+    request->phase = CPU_TLB_ALLOCATION_RETURNED;
+    status = qemu_crucible_startup_source_cpu_tlb_array_return_v1(
+        storage->transitions[mmu].source, request);
+    if (status) {
+        tlb_metadata_fail(status);
+    }
+    if (request->phase != CPU_TLB_ALLOCATION_IDLE) {
+        tlb_metadata_fail(-EBUSY);
+    }
+}
+
+static void tlb_metadata_array_destroy(QemuCrucibleCpuTlbStorage *storage,
+                                       size_t mmu, CpuTlbAllocationKind kind,
+                                       void *payload)
+{
+    QemuCrucibleCpuTlbAllocationRequest *request = &storage->rows[mmu][kind];
+
+    if (request->phase != CPU_TLB_ALLOCATION_LIVE ||
+        request->payload != payload || !request->allocator_returned) {
+        tlb_metadata_fail(-ESTALE);
+    }
+    /* Destruction admits no replacement. Physical free does not require an
+     * available ledger lane; the paid tombstone retains its charge custody. */
+    request->phase = CPU_TLB_ALLOCATION_FREE;
+    g_free(payload);
+    request->free_returned = true;
+    request->phase = CPU_TLB_ALLOCATION_RETURNED;
+}
+#endif
