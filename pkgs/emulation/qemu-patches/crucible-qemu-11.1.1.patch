+    memset(root, 0, 32);
+    *written = 0;
+    status = qemu_crucible_ram_diagnostic_failure();
+    if (status) {
+        return status;
+    }
+    /* The caller explicitly refreshes once before measuring/copying. Frozen
+     * final-seal callers use this cached view without RAM access/allocation.
+     */
+    status = diagnostic_root_result(
+        observer(scope, buffer, capacity, written, root, &logical_bytes),
+        root, &logical_bytes);
+    if (status) {
+        *written = 0;
+    }
+    return status;
+}
