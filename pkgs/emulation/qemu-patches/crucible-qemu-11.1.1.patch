+static void test_hot_fork_retained_async_worker_transaction(void)
+{
+    QemuAsyncWorkerHotForkRetainedTransaction transaction = { 0 };
+    QemuAsyncWorkerHotForkBarrierInventory barrier;
+    int child_status;
+    pid_t child;
+
+    qemu_async_worker_hot_fork_barrier(QEMU_ASYNC_WORKER_HOT_FORK_BARRIER_HOLD,
