+int qemu_plugin_crucible_ram_control_actor_start_v1(
+    qemu_plugin_id_t id, qemu_plugin_crucible_runtime_purpose_v2 *purpose,
+    uint64_t stack_bytes, qemu_plugin_crucible_ram_control_entry_cb_t entry,
+    void *userdata, qemu_plugin_crucible_ram_control_actor_v1 **out)
+{
+#if defined(CONFIG_LINUX) && defined(__x86_64__) && !defined(__ILP32__)
+    QemuCrucibleRamControlActor *actor = &startup_source.ram_control_actor;
+    struct qemu_plugin_crucible_ram_endpoint_borrow_v1 endpoint;
+    uint64_t extent;
+    int status;
+
+    /* Runtime admission binds this constructor to the actual Main creator.
+     * Refuse before endpoint borrowing, debit, mutex, mapping or thread birth;
+     * a live absence loan must not deadlock at the later registry freeze. */
+    if (qemu_crucible_resident_service_birth_blocked_v1()) {
+        return -EBUSY;
+    }
+    status = startup_runtime_admission(id, purpose);
+    if (status) {
+        return status;
+    }
+    if (!entry || !out || !userdata ||
+        stack_bytes != CRUCIBLE_RAM_CONTROL_STACK_BYTES ||
+        userdata != startup_source.checkpoint_pager_userdata ||
+        userdata != startup_source.provider_userdata ||
+        !qatomic_load_acquire(&startup_source.provider_registered) ||
+        !qatomic_load_acquire(&startup_source.checkpoint_finalize_registered) ||
+        !qatomic_load_acquire(&startup_source.record_binding.registered) ||
+        startup_source.record_binding.runtime != purpose ||
+        startup_source.record_binding.userdata != userdata) {
+        return -EINVAL;
+    }
+    if (actor->attempted) {
+        return -EALREADY;
+    }
+    status = qemu_plugin_crucible_startup_ram_endpoint_borrow_v1(id, purpose, &endpoint);
+    if (status) {
+        return status;
+    }
+    /* Singleton receipt/observation bodies were paid before Source birth.
+     * This charge covers the actual retained stack and QEMU creation bodies;
+     * it does not claim a later module allocation or decode another bank. */
+    extent = stack_bytes + qemu_thread_bounded_control_bytes(sizeof("crucible-ram"));
+    status = crucible_metadata_native_admit(&startup_source.metadata_partition,
+                                            extent, &actor->charge);
+    if (status) {
+        return status;
+    }
+    actor->attempted = true;
+    actor->incarnation = 1;
+    actor->purpose = purpose;
+    actor->ram_endpoint = endpoint.purpose;
+    actor->endpoint_descriptor = endpoint.descriptor;
+    actor->process = getpid();
+    actor->entry = entry;
+    actor->userdata = userdata;
+    actor->stack_bytes = stack_bytes;
+    qemu_thread_get_self(&actor->creator);
+    actor->receipt.aliases[0] = -1;
+    actor->receipt.aliases[1] = -1;
+    *out = actor;
+    status = pthread_mutex_init(&actor->dispatch_mutex, NULL);
+    if (status) {
+        return ram_control_failure(actor, -status, false);
+    }
+    status = pthread_cond_init(&actor->dispatch_condition, NULL);
+    if (status) {
+        return ram_control_failure(actor, -status, false);
+    }
+    actor->dispatch_mutex_initialized = true;
+    actor->stack = mmap(NULL, stack_bytes, PROT_READ | PROT_WRITE,
+                        MAP_PRIVATE | MAP_ANONYMOUS | MAP_STACK, -1, 0);
+    if (actor->stack == MAP_FAILED) {
+        actor->stack = NULL;
+        return ram_control_failure(actor, -errno, false);
+    }
+    status = qemu_crucible_ram_control_actor_contract_current(actor);
+    if (!status) {
+        status = startup_task_reserve(&actor->task_reserved);
+    }
+    if (!status) {
+        status = qemu_thread_create_bounded(&actor->thread, "crucible-ram",
+                                            ram_control_entry, actor,
+                                            actor->stack, actor->stack_bytes,
+                                            &actor->creation_receipt);
+    }
+    if (actor->creation_receipt.born) {
+        qatomic_store_release(&actor->born, true);
+    } else if (actor->task_reserved) {
+        startup_task_physical_return(&actor->task_reserved);
+    }
+    if (status) {
+        ram_control_failure(actor, status, actor->creation_receipt.born);
+        qatomic_store_release(&actor->creator_published, true);
+        qatomic_store_release(&actor->entry_released, true);
+        return status;
+    }
+    qatomic_store_release(&actor->born, true);
+    status = qemu_crucible_ram_control_actor_contract_current(actor);
+    if (!status) {
+        status = startup_runtime_admission(id, purpose);
+    }
+    if (status) {
+        ram_control_failure(actor, status, true);
+    } else {
+        qatomic_store_release(&actor->ready, true);
+        *out = actor;
+    }
+    qatomic_store_release(&actor->creator_published, true);
+    if (!status) {
+        status = ram_control_creator_enrollment(actor, id, false);
+    }
+    if (!status) {
+        qatomic_store_release(&actor->entry_allowed, true);
+    }
+    /* Every born path releases the actual wrapper, including failed post or
+     * cancellation. It never invokes Rust after failed creating authority. */
+    qatomic_store_release(&actor->entry_released, true);
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
