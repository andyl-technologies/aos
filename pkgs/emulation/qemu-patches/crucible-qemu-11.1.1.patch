+static void qemu_plugin_control_boundary_complete_bh(void *opaque)
+{
+    CPUState *cpu;
+    uintptr_t schedule_token = (uintptr_t)opaque;
+    uint64_t rr_ack_generation = qatomic_load_acquire(
+        &qemu_plugin_rr_control_ack_generation);
+    uint64_t rr_complete_generation = qatomic_load_acquire(
+        &qemu_plugin_rr_control_complete_generation);
+    uint64_t rr_request_generation = qatomic_load_acquire(
+        &qemu_plugin_rr_control_request_generation);
+    bool rr_lifecycle_cancel = false;
+    bool rr_request_acknowledged =
+        rr_ack_generation != rr_complete_generation;
+    bool rr_request_unacknowledged =
+        !rr_request_acknowledged &&
+        rr_request_generation != rr_ack_generation;
+    bool paused_owner = qatomic_load_acquire(
+        &qemu_plugin_control_boundary_deferred) &&
+        qemu_plugin_quiesced_control_boundary_available();
+
+    qemu_plugin_trace_control_delivery("complete-bh");
+    if (qatomic_load_acquire(&qemu_plugin_control_boundary_scheduled) !=
+        schedule_token) {
+        return;
+    }
+    if (qemu_plugin_crucible_single_threaded_rr() &&
+        qemu_force_shutdown_requested()) {
+        qemu_plugin_crucible_rr_control_boundary_cancel();
+        return;
+    }
+    if (!paused_owner &&
+        (rr_request_acknowledged || rr_request_unacknowledged)) {
+        rr_lifecycle_cancel = !first_cpu || !runstate_is_running() ||
+            qemu_plugin_crucible_vmstop_pending();
+        CPU_FOREACH(cpu) {
+            rr_lifecycle_cancel |= cpu->stop || cpu->unplug;
+        }
+        if (rr_lifecycle_cancel) {
+            if (qemu_plugin_crucible_vmstop_pending()) {
+                qemu_plugin_crucible_rr_control_boundary_defer();
+            } else {
+                qemu_plugin_crucible_rr_control_boundary_cancel();
+            }
+            if (first_cpu) {
+                qemu_cond_broadcast(first_cpu->halt_cond);
+                rr_crucible_sim_notify_dispatch_ceiling();
+            }
+            return;
+        }
+    }
+
+    if (!paused_owner && qatomic_load_acquire(
+            &qemu_plugin_control_boundary_deferred) &&
+        qemu_plugin_crucible_vmstop_pending()) {
+        qemu_plugin_crucible_rr_control_boundary_defer();
+        return;
+    }
+
+    if (rr_request_unacknowledged && !paused_owner) {
+        g_assert(qatomic_load_acquire(
+            &qemu_plugin_rr_control_schedule_token) != schedule_token);
+        /* Let the settled RR thread claim a fresh epoch before the sole C. */
+        qemu_plugin_release_control_boundary_schedule(schedule_token);
+        return;
+    }
+
+    /*
+     * A control wake can arrive while an idle-time advance is between its
+     * QEMU clock mutation and plugin commit.  Keep yielding through the same
+     * two-pass barrier until that commit clears the RR fence; acknowledging
+     * earlier would expose a raw clock with a stale logical-time offset.
+     */
+    if (qatomic_load_acquire(&qemu_plugin_time_advance_pending)) {
+        /*
+         * One-shot BHs are inserted at the head of the AioContext queue, so a
+         * self-rescheduling waiter would starve the time-advance completion.
+         * Relinquish the coalescing token instead; that completion is already
+         * queued and schedules a fresh control boundary after its commit.
+         */
+        qemu_plugin_crucible_rr_control_boundary_defer();
+        return;
+    }
+
+    if (!qemu_plugin_release_control_boundary_schedule(schedule_token)) {
+        return;
+    }
+    qatomic_store_release(&qemu_plugin_control_boundary_deferred, false);
+    if (paused_owner) {
+        /* The settled main-loop owner authenticates this paused coordinate. */
+        rr_ack_generation = rr_request_generation;
+        qatomic_store_release(&qemu_plugin_rr_control_ack_generation,
+                              rr_ack_generation);
+    }
+    if (rr_request_acknowledged || paused_owner) {
+        /*
+         * Complete the claimed generation before the callback. The BQL keeps
+         * RR fenced until the callback returns, while a nested wake can record
+         * a distinct next request without being folded into this claim.
+         */
+        qatomic_store_release(&qemu_plugin_rr_control_complete_generation,
+                              rr_ack_generation);
+        rr_crucible_sim_trace_control_boundary(
+            "complete", rr_request_generation, rr_ack_generation,
+            rr_ack_generation, schedule_token);
+    }
+    qemu_plugin_trace_rr_control_boundary_state("callback-enter");
+    qemu_plugin_trace_control_delivery("callback-enter");
+    qatomic_inc(&qemu_plugin_control_drain_callback_depth);
+    qemu_plugin_fire_control_boundary_cb(first_cpu);
+    qatomic_dec(&qemu_plugin_control_drain_callback_depth);
+    qatomic_fetch_inc(&qemu_plugin_control_boundary_generation);
+    /* Complete counters precede the callback; a drain waits for its return. */
+    qemu_plugin_control_drain_notify();
+    if (first_cpu && !qemu_plugin_crucible_vmstop_pending()) {
+        qemu_cpu_kick(first_cpu);
+    }
+}
+
+static void qemu_plugin_control_boundary_barrier_bh(void *opaque)
+{
+    uintptr_t schedule_token = (uintptr_t)opaque;
+
+    if (qatomic_load_acquire(&qemu_plugin_control_boundary_scheduled) !=
+        schedule_token) {
+        return;
+    }
+    /*
+     * Wake notifiers can schedule device-coroutine bottom halves. Complete
+     * the control boundary on the following main-loop pass so every bottom
+     * half captured by the wake is visible before the plugin acknowledges it.
+     */
+    aio_bh_schedule_oneshot(qemu_get_aio_context(),
+                            qemu_plugin_control_boundary_complete_bh, opaque);
+}
+
+static uintptr_t qemu_plugin_schedule_control_boundary(void)
+{
+    uintptr_t active_token;
+    uintptr_t schedule_token =
+        qatomic_fetch_inc(&qemu_plugin_control_boundary_schedule_sequence) + 1;
+
+    if (schedule_token == 0) {
+        error_report("Crucible control-boundary schedule token overflow");
+        abort();
+    }
+    active_token = qatomic_cmpxchg(&qemu_plugin_control_boundary_scheduled,
+                                   0, schedule_token);
+    if (active_token != 0) {
+        return active_token;
+    }
+    aio_bh_schedule_oneshot(qemu_get_aio_context(),
+                            qemu_plugin_control_boundary_barrier_bh,
+                            (void *)(uintptr_t)schedule_token);
+    return schedule_token;
+}
+
+bool qemu_plugin_crucible_rr_control_boundary_pending(void)
+{
+    return !qatomic_load_acquire(&qemu_plugin_control_boundary_deferred) &&
+           qatomic_load_acquire(&qemu_plugin_rr_control_request_generation) !=
+           qatomic_load_acquire(&qemu_plugin_rr_control_complete_generation);
+}
+
+bool qemu_plugin_crucible_control_boundary_outstanding(void)
+{
+    /* OOB reports may observe intent without BQL; mutation requires BQL. */
+    return qatomic_load_acquire(&qemu_plugin_control_boundary_deferred) ||
+        qatomic_load_acquire(&qemu_plugin_control_boundary_scheduled) != 0 ||
+        qatomic_load_acquire(&qemu_plugin_rr_control_request_generation) !=
+            qatomic_load_acquire(&qemu_plugin_rr_control_complete_generation);
+}
+
+bool qemu_plugin_crucible_control_drain_settled(void)
+{
+    return qatomic_load_acquire(&qemu_plugin_control_drain_callback_depth) == 0 &&
+        !qemu_plugin_time_advance_is_pending() &&
+        !qemu_plugin_crucible_control_boundary_outstanding() &&
+        qemu_plugin_control_drain_wake_state() == 0;
+}
+
+void qemu_plugin_crucible_rr_control_boundary_defer(void)
+{
+    uintptr_t schedule_token = qatomic_load_acquire(
+        &qemu_plugin_control_boundary_scheduled);
+
+    g_assert(bql_locked());
+    qatomic_store_release(&qemu_plugin_control_boundary_deferred, true);
+    if (schedule_token != 0) {
+        qemu_plugin_release_control_boundary_schedule(schedule_token);
+    }
+    /* Preserve request/ack/complete until a valid owner actually calls back. */
+    qemu_plugin_rearm_deferred_control_boundary();
+    qemu_plugin_trace_control_delivery("defer");
+}
+
+void qemu_plugin_crucible_rr_control_boundary_rearm(void)
+{
+    qemu_plugin_rearm_deferred_control_boundary();
+    qemu_plugin_control_drain_notify();
+}
+
+static void qemu_plugin_rearm_deferred_control_boundary(void)
+{
+    g_assert(bql_locked());
+    if (!qatomic_load_acquire(&qemu_plugin_control_boundary_deferred)) {
+        return;
+    }
+    if (!first_cpu) {
+        qemu_plugin_trace_stop_context(CRUCIBLE_STOP_REARM_NO_CPU);
+        return;
+    }
+    if (qemu_force_shutdown_requested()) {
+        qemu_plugin_trace_stop_context(CRUCIBLE_STOP_REARM_SHUTDOWN);
+        return;
+    }
+    if (qatomic_load_acquire(&qemu_plugin_time_advance_pending)) {
+        qemu_plugin_trace_stop_context(CRUCIBLE_STOP_REARM_ADVANCE);
+        return;
+    }
+    qemu_plugin_trace_control_delivery("rearm");
+    if (qemu_plugin_quiesced_control_boundary_available()) {
+        qemu_plugin_schedule_control_boundary();
+    } else if (!qemu_plugin_crucible_vmstop_pending() &&
+               runstate_is_running()) {
+        qatomic_store_release(&qemu_plugin_control_boundary_deferred, false);
+        if (!qemu_plugin_crucible_rr_control_boundary_pending()) {
+            /* A main-loop-only request needs a new running RR claim. */
+            qemu_plugin_request_rr_control_boundary();
+        } else {
+            qemu_plugin_schedule_control_boundary();
+        }
+    } else {
+        qemu_plugin_trace_stop_context(CRUCIBLE_STOP_REARM_NO_OWNER);
+    }
+}
+
+static bool qemu_plugin_quiesced_control_boundary_available(void)
+{
+    CPUState *cpu;
+
+    g_assert(bql_locked());
+    if (!first_cpu || !runstate_check(RUN_STATE_PAUSED) ||
+        !qemu_plugin_crucible_vmstop_quiesced() ||
+        qemu_force_shutdown_requested() || icount_enabled() != ICOUNT_PRECISE ||
+        !qemu_plugin_crucible_single_threaded_rr()) {
+        return false;
+    }
+    CPU_FOREACH(cpu) {
+        if (cpu->stop || cpu->unplug) {
+            return false;
+        }
+    }
+    return true;
+}
+
+void qemu_plugin_crucible_rr_control_boundary_acknowledge(void)
+{
+    uintptr_t schedule_token;
+    uint64_t ack_generation = qatomic_load_acquire(
+        &qemu_plugin_rr_control_ack_generation);
+    uint64_t complete_generation = qatomic_load_acquire(
+        &qemu_plugin_rr_control_complete_generation);
+    uint64_t request_generation = qatomic_load_acquire(
+        &qemu_plugin_rr_control_request_generation);
+
+    if (ack_generation != complete_generation) {
+        return;
+    }
+    if (request_generation == complete_generation) {
+        return;
+    }
+    schedule_token = qemu_plugin_schedule_control_boundary();
+    qatomic_store_release(&qemu_plugin_rr_control_ack_generation,
+                          request_generation);
+    qatomic_store_release(&qemu_plugin_rr_control_schedule_token,
+                          schedule_token);
+    rr_crucible_sim_trace_control_boundary(
+        "ack", request_generation, request_generation,
+        complete_generation, schedule_token);
+}
+
+void qemu_plugin_crucible_rr_control_boundary_cancel(void)
+{
+    uintptr_t schedule_token = qatomic_load_acquire(
+        &qemu_plugin_control_boundary_scheduled);
+    uintptr_t rr_schedule_token = qatomic_load_acquire(
+        &qemu_plugin_rr_control_schedule_token);
+    uint64_t request_generation = qatomic_load_acquire(
+        &qemu_plugin_rr_control_request_generation);
+    uint64_t complete_generation = qatomic_load_acquire(
+        &qemu_plugin_rr_control_complete_generation);
+
+    qatomic_store_release(&qemu_plugin_control_boundary_deferred, false);
+    if (schedule_token != 0) {
+        qatomic_cmpxchg(&qemu_plugin_control_boundary_scheduled,
+                        schedule_token, 0);
+        qatomic_cmpxchg(&qemu_plugin_rr_control_schedule_token,
+                        schedule_token, 0);
+    }
+    qatomic_store_release(&qemu_plugin_rr_control_ack_generation,
+                          request_generation);
+    qatomic_store_release(&qemu_plugin_rr_control_complete_generation,
+                          request_generation);
+    qemu_crucible_fault_lifecycle_ready_marker_cancel();
+    qemu_plugin_control_drain_invalidate();
+    qemu_plugin_trace_control_delivery("cancel");
+    if (request_generation != complete_generation) {
+        rr_crucible_sim_trace_control_boundary(
+            "cancel", request_generation, request_generation,
+            request_generation, rr_schedule_token);
+    }
+}
+
+static void qemu_plugin_request_rr_control_boundary(void)
+{
+    uint64_t acknowledged_generation = qatomic_load_acquire(
+        &qemu_plugin_rr_control_ack_generation);
+    uint64_t request_generation = qatomic_load_acquire(
+        &qemu_plugin_rr_control_request_generation);
+
+    /* Coalesce only while the RR thread has not claimed the prior request. */
+    if (request_generation != acknowledged_generation) {
+        qemu_plugin_trace_rr_control_boundary_state("coalesce");
+        return;
+    }
+    if (request_generation == UINT64_MAX) {
+        error_report("Crucible RR control request generation overflow");
+        abort();
+    }
+    qatomic_store_release(&qemu_plugin_rr_control_request_generation,
+                          request_generation + 1);
+    /*
+     * The durable request must wake a ceiling waiter even if the CPU kick
+     * coalesces with an already-pending RR wake-state transition.
+     */
+    rr_crucible_sim_notify_dispatch_ceiling();
+    rr_crucible_sim_trace_control_boundary(
+        "request", request_generation + 1, acknowledged_generation,
+        qatomic_load_acquire(&qemu_plugin_rr_control_complete_generation),
+        qatomic_load_acquire(&qemu_plugin_rr_control_schedule_token));
+    qemu_plugin_trace_control_delivery("request");
+    qemu_cpu_kick(first_cpu);
+}
+
+int qemu_plugin_request_control_boundary(void)
+{
+    if (!qemu_plugin_crucible_exact_boundary_active() || !current_cpu ||
+        icount_enabled() != ICOUNT_PRECISE ||
+        !qemu_plugin_crucible_single_threaded_rr()) {
+        return -EPERM;
+    }
+
+    qemu_plugin_schedule_control_boundary();
+    tcg_kick_vcpu_thread(current_cpu);
+    return 0;
+}
+
+int qemu_plugin_advance_time_ticks(int64_t target_tick)
+{
+    if (target_tick < 0) {
+        return -EINVAL;
+    }
+    if (strcmp(current_accel_name(), "sim") != 0) {
+        return -EPERM;
+    }
+    if (!has_control || !qemu_plugin_time_advance_cb) {
+        return -ENODEV;
+    }
+    if (qemu_plugin_crucible_vmstop_pending()) {
+        return -EBUSY;
+    }
+    if (qatomic_cmpxchg(&qemu_plugin_time_advance_pending, 0,
+                        QEMU_PLUGIN_TIME_ADVANCE_RESERVED) != 0) {
+        return -EBUSY;
+    }
+    if (!first_cpu) {
+        qatomic_store_release(&qemu_plugin_time_advance_pending, 0);
+        return -ENODEV;
+    }
+
+    qatomic_set(&qemu_plugin_time_advance_target, target_tick);
+    run_on_cpu(first_cpu, qemu_plugin_time_advance_arm_on_cpu,
+               RUN_ON_CPU_HOST_ULONG(0));
+    aio_bh_schedule_oneshot(qemu_get_aio_context(),
+                            qemu_plugin_advance_time_bh, NULL);
+    if (first_cpu) {
+        qemu_cpu_kick(first_cpu);
+    }
+    return 0;
+}
+
+int64_t qemu_plugin_sim_tick_observed(void)
+{
+    if (!current_accel_is_sim() ||
+        icount_enabled() != ICOUNT_PRECISE) {
+        return -1;
+    }
+
+    return icount_crucible_sim_tick_observed();
+}
+
+uint64_t qemu_plugin_icount_raw(void)
+{
+    int64_t raw_icount;
+
+    if (!icount_enabled()) {
+        return 0;
+    }
+
+    /*
+     * Plugin callbacks can run while translated code has temporarily made
+     * I/O unsafe.  Observe the committed count plus the current CPU's local
+     * execution instead of forcing an icount commit from that context.
+     */
+    raw_icount = icount_get_raw_observed();
+    if (raw_icount < 0) {
+        return 0;
+    }
+    return (uint64_t)raw_icount;
+}
+
+uint64_t qemu_crucible_fault_observed_icount(void)
+{
+    int64_t observed;
+
+    if (!icount_enabled()) {
+        return 0;
+    }
+    observed = icount_get_raw_observed();
+    return observed < 0 ? 0 : observed;
+}
+
+int qemu_plugin_icount_at_tb_entry(uint64_t tb_insns,
+                                   uint64_t *entry_icount)
+{
+    int64_t observed_icount;
+
+    if (!entry_icount || tb_insns == 0 || !current_cpu ||
+        !current_cpu->running ||
+        icount_enabled() != ICOUNT_PRECISE ||
+        !qemu_plugin_crucible_single_threaded_rr()) {
+        return -1;
+    }
+
+    observed_icount = icount_get_raw_observed();
+    if (observed_icount < 0 || (uint64_t)observed_icount < tb_insns) {
+        return -1;
+    }
+    *entry_icount = (uint64_t)observed_icount - tb_insns;
+    return 0;
+}
