+    if (status == 0 && out->ram_bytes == 0) {
+        status = -ENODATA;
+    }
+    out->schema = 2;
+    out->logical_edition = 1;
+    out->ram_scope = 0;
+    if (status == 0) {
+        failure_stage = "hash device projection schema";
+        status = qemu_fingerprint_projection_schema_sha256(
+            QEMU_CRUCIBLE_LIFECYCLE_STATE_VOLATILE |
+                QEMU_CRUCIBLE_LIFECYCLE_STATE_DEVICE |
+                QEMU_CRUCIBLE_LIFECYCLE_STATE_CONTROL,
+            out->device_schema_digest, &device_schema_sections);
+        if (status == 0 && device_schema_sections == 0) {
+            status = -EIO;
+        } else if (status == 0) {
+            out->device_schema_sections = device_schema_sections;
+        }
+    }
+    if (status == 0) {
+        failure_stage = "create device projection material memfd";
+        out->device_fd = qemu_memfd_create(
+            "crucible-fingerprint-device", GiB, false, 0, F_SEAL_GROW,
+            &local_err);
+        if (out->device_fd < 0) {
