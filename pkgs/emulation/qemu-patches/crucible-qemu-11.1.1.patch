+    types = source[source.index("typedef struct CrucibleClockBinding {"):
+                   source.index("static bool crucible_clock_registered;")]
+    signatures = [
+        "static CrucibleClockSource *crucible_clock_source_by_kind(",
+        "static gint crucible_clock_source_compare(",
+        "static bool crucible_clock_manifest_finalize(",
+        "int qemu_crucible_fault_clock_source_register(",
