+bool qemu_plugin_crucible_ram_actor_pause_identity(
+    QemuCrucibleRamActorPause *pause, void *actor, uint64_t generation,
+    uint64_t thread_id)
+{
+    /* Held lease coordinates stay immutable; this takes no mutex and invokes
+     * no callback. terminal_pending asynchronously poisons the proof. */
+    return pause && !qemu_plugin_crucible_ram_actor_pause_current(pause) &&
+        pause->actor == actor && pause->service_generation == generation &&
+        pause->thread_id == thread_id;
+}
