+static const char * const rr_control_delivery_trace_phases[] = {
+    "request", "defer", "rearm", "complete-bh", "callback-enter",
+    "registered-enter", "registered-return", "cancel", "advance-settled",
+    "wake-stopped",
+};
+
+static struct {
+    uint64_t request_generation;
+    uintptr_t schedule_sequence;
+    bool emitted;
+} rr_control_delivery_trace_seen[ARRAY_SIZE(rr_control_delivery_trace_phases)];
+static pid_t rr_control_delivery_trace_pid;
+
+bool rr_crucible_sim_control_delivery_trace_enabled(void)
+{
