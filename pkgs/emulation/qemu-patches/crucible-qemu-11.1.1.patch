+int qemu_plugin_crucible_ram_admission_grant_v1(
+    uint64_t generation, uint64_t total_metadata_bytes, uint64_t *rust_allowance)
+{
+    uint64_t controller_metadata;
+    uint64_t allowance;
+    int status;
+
+    if (!rust_allowance || !bql_locked() || !admission_grant_open ||
+        admission_grant_applied || admission_grant_owner != qemu_get_thread_id() ||
+        generation != admission.topology_generation ||
+        generation != qatomic_read(&topology_generation)) {
+        return -EPERM;
+    }
+    if (qatomic_read(&research_resident.state) != RESEARCH_RESIDENT_ABSENT &&
+        (qatomic_read(&research_resident.state) != RESEARCH_RESIDENT_SEALING ||
+         total_metadata_bytes != research_resident.total_metadata)) {
+        return -EPERM;
+    }
+    if (!qemu_crucible_startup_source_total_matches(total_metadata_bytes)) {
+        return -EPERM;
+    }
+    if (total_metadata_bytes <= admission.native_metadata_bytes) {
+        return -ENOSPC;
+    }
+    controller_metadata = qemu_crucible_startup_source_control_metadata_bytes();
+    if (controller_metadata) {
+        status = qemu_crucible_startup_source_metadata_partition_status();
+        if (status) {
+            return status;
+        }
+    }
+    if (controller_metadata >=
+        total_metadata_bytes - admission.native_metadata_bytes) {
+        return -ENOSPC;
+    }
+    allowance = total_metadata_bytes - admission.native_metadata_bytes -
+        controller_metadata;
+    status = qemu_crucible_startup_source_inventory_allowance_limit_v2(
+        total_metadata_bytes, admission.native_metadata_bytes, &allowance);
+    if (status) {
+        return status;
+    }
+    status = qemu_crucible_startup_source_inventory_allowance_reserve(allowance);
+    if (status) {
+        return status;
+    }
+    metadata_budget = total_metadata_bytes;
+    rust_metadata_budget = allowance;
+    *rust_allowance = rust_metadata_budget;
+    admission_grant_applied = true;
+    return 0;
+}
