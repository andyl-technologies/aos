+static void ct3_free_poison_list(CXLPoisonList *list)
+{
+    CXLPoison *entry;
+    CXLPoison *next;
+
+    QLIST_FOREACH_SAFE(entry, list, node, next) {
+        QLIST_REMOVE(entry, node);
+        g_free(entry);
+    }
