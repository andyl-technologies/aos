+int qemu_plugin_crucible_force_vcpu_tb_exit(void)
+{
+    if (!current_cpu || !current_cpu->running ||
+        icount_enabled() != ICOUNT_PRECISE ||
+        !qemu_plugin_crucible_single_threaded_rr()) {
+        return -EINVAL;
+    }
+
+    tcg_kick_vcpu_thread(current_cpu);
