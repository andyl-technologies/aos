+        fingerprint_root_frame.process != getpid() ||
+        !qemu_thread_is_self(&fingerprint_root_frame.thread) || !bql_locked() ||
+        qemu_in_coroutine() || candidate_capture.active || capture_owner_token) {
+        return status ? status : -EPERM;
