+static void node_owned_rule_destroy(QemuCrucibleFaultRule *rule)
+{
+    g_auto(CrucibleNodeStorageOperation) operation =
+        node_storage_operation_begin();
+    CrucibleNodeStorageControl *control;
+    void *allocation;
+    uint64_t issuance;
+
+    if (!operation.entered) {
+        return;
+    }
+    control = node_storage_retire_begin(rule, CRUCIBLE_NODE_STORAGE_RULE);
+
+    if (!control) {
+        return;
+    }
+    allocation = control->allocation;
+    issuance = control->issuance;
+    node_rule_clear(rule, control);
+    if (!node_storage_unpublish(control)) {
+        return;
+    }
+    g_free(allocation);
+    node_storage_retire_post(allocation, issuance, CRUCIBLE_NODE_STORAGE_RULE);
+}
+
+static void node_rule_unref(QemuCrucibleFaultRule *rule)
+{
+    g_auto(CrucibleNodeStorageOperation) operation =
+        node_storage_operation_begin();
+    QemuCrucibleFaultRegistration *origin;
+
+    if (!operation.entered || !rule) {
+        return;
+    }
+    if (!node_storage_rule_origin(rule, &origin) || !rule->references) {
+        return;
+    }
+    if (--rule->references == 0) {
+        node_owned_rule_destroy(rule);
+    }
+}
