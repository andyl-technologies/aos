+    def _read_chunk(self, fd, deadline, shutdown=False):
+        while True:
+            remaining = deadline - time.monotonic()
+            if remaining <= 0:
+                raise self._timeout_error(shutdown)
+
+            read_fds = [fd]
+            if fd != self.marker_fd and not self.marker_eof:
+                read_fds.append(self.marker_fd)
+            stderr_fd = self.process.stderr.fileno()
+            if shutdown and fd != stderr_fd:
+                read_fds.append(stderr_fd)
+            ready = select.select(read_fds, [], [], remaining)[0]
+            if not ready:
+                raise self._timeout_error(shutdown)
+            if shutdown:
+                self._drain_shutdown_fds(ready)
+            elif fd != self.marker_fd and self.marker_fd in ready:
+                marker_chunk = os.read(self.marker_fd, 4096)
+                if marker_chunk:
+                    self.marker_buffer.extend(marker_chunk)
+                else:
+                    self.marker_eof = True
+            if fd in ready:
+                chunk = os.read(fd, 4096)
+                if not chunk:
+                    if shutdown:
+                        stderr = self.shutdown_stderr_tail.decode(
+                            errors="replace"
+                        )
+                    else:
+                        stderr = self.process.stderr.read().decode(
+                            errors="replace"
+                        )
+                    status = self.process.poll()
+                    raise RuntimeError(
+                        f"QEMU stream closed with status {status}: {stderr}"
+                    )
+                return chunk
+
+    def _timeout_error(self, shutdown):
+        """Returns a retained scheduler diagnostic for one stuck live VM."""
+        if shutdown:
+            self._drain_shutdown_fds(
+                [self.marker_fd, self.process.stderr.fileno()]
+            )
+        task_states = []
+        task_root = f"/proc/{self.process.pid}/task"
+        try:
+            task_ids = sorted(os.listdir(task_root), key=int)
+        except (FileNotFoundError, PermissionError):
+            task_ids = []
+        for task_id in task_ids:
+            try:
+                with open(
+                    os.path.join(task_root, task_id, "wchan"),
+                    encoding="utf-8",
+                ) as wchan_file:
+                    wait_channel = wchan_file.read().strip()
+                with open(
+                    os.path.join(task_root, task_id, "comm"),
+                    encoding="utf-8",
+                ) as comm_file:
+                    name = comm_file.read().strip()
+            except (FileNotFoundError, PermissionError):
+                continue
+            task_states.append((int(task_id), name, wait_channel))
+
+        return TimeoutError(
+            "QEMU liveness operation timed out: "
+            f"pid={self.process.pid} "
+            f"tasks={task_states!r} "
+            f"events={self.events!r} "
+            f"marker_counts={dict(self.shutdown_marker_counts)!r} "
+            f"marker_tail={list(self.shutdown_marker_tail)!r} "
+            f"qmp_buffer={bytes(self.qmp_buffer)!r} "
+            f"stderr_buffer={bytes(self.stderr_buffer)!r} "
+            f"stderr_tail={self.shutdown_stderr_tail.decode(errors='replace')!r}"
+        )
+
+    def _read_qmp_message(self, deadline=None, shutdown=False):
+        if deadline is None:
+            deadline = time.monotonic() + TIMEOUT_SECONDS
+        stdout_fd = self.process.stdout.fileno()
+        while b"\n" not in self.qmp_buffer:
+            self.qmp_buffer.extend(
+                self._read_chunk(stdout_fd, deadline, shutdown=shutdown)
+            )
+        line, _, remainder = self.qmp_buffer.partition(b"\n")
+        self.qmp_buffer = bytearray(remainder)
+        return json.loads(line)
+
+    def qmp_send(self, execute, arguments=None):
+        """Sends one QMP command and returns its response identifier."""
+        self.command_id += 1
+        request = {"execute": execute, "id": self.command_id}
+        if arguments is not None:
+            request["arguments"] = arguments
+        self.process.stdin.write(json.dumps(request).encode() + b"\n")
+        self.process.stdin.flush()
+        self.qmp_command_names[self.command_id] = execute
+        return self.command_id
+
+    def qmp_wait(self, command_id, deadline=None, shutdown=False):
+        """Waits for one previously sent QMP command response."""
+        while True:
+            message = self._read_qmp_message(deadline, shutdown=shutdown)
+            if "event" in message:
+                self.events.append(message)
+                continue
+            if message.get("id") != command_id:
+                raise AssertionError(f"unexpected QMP response: {message!r}")
+            command_name = self.qmp_command_names.pop(
+                command_id, f"command {command_id}"
+            )
+            if "error" in message:
+                error = message["error"]
+                raise AssertionError(
+                    f"QMP {command_name} failed: {error!r}"
+                )
+            return message["return"]
+
+    def qmp(self, execute, arguments=None, deadline=None, shutdown=False):
+        command_id = self.qmp_send(execute, arguments)
+        return self.qmp_wait(
+            command_id, deadline=deadline, shutdown=shutdown
+        )
+
+    def _take_marker(self):
+        if self.marker_buffer[:1] == b"P" and len(self.marker_buffer) >= 17:
+            park_thread = int.from_bytes(
+                self.marker_buffer[1:9], byteorder=sys.byteorder
+            )
+            park_address = int.from_bytes(
+                self.marker_buffer[9:17], byteorder=sys.byteorder
+            )
+            del self.marker_buffer[:17]
+            return ("park", (park_thread, park_address))
+        if self.marker_buffer[:1] == b"R" and len(self.marker_buffer) >= 2:
+            status = self.marker_buffer[1]
+            del self.marker_buffer[:2]
+            return ("result", status)
+        if self.marker_buffer[:1] == b"W" and len(self.marker_buffer) >= 2:
+            vcpu_index = self.marker_buffer[1]
+            del self.marker_buffer[:2]
+            return ("work", vcpu_index)
+        if self.marker_buffer[:1] == b"N" and len(self.marker_buffer) >= 2:
+            vcpu_index = self.marker_buffer[1]
+            del self.marker_buffer[:2]
+            return ("control-wait-owner", vcpu_index)
+        if self.marker_buffer[:1] == b"K":
+            del self.marker_buffer[:1]
+            return ("control-arm-observed", None)
+        if self.marker_buffer[:1] == b"C" and len(self.marker_buffer) >= 17:
+            icount = int.from_bytes(
+                self.marker_buffer[1:9], byteorder=sys.byteorder
+            )
+            generation = int.from_bytes(
+                self.marker_buffer[9:17], byteorder=sys.byteorder
+            )
+            del self.marker_buffer[:17]
+            return ("control", (icount, generation))
+        if self.marker_buffer[:1] == b"D" and len(self.marker_buffer) >= 9:
+            icount = int.from_bytes(
+                self.marker_buffer[1:9], byteorder=sys.byteorder
+            )
+            del self.marker_buffer[:9]
+            return ("dispatch", icount)
+        if self.marker_buffer[:1] == b"V" and len(self.marker_buffer) >= 5:
+            status = int.from_bytes(
+                self.marker_buffer[1:5],
+                byteorder=sys.byteorder,
+                signed=True,
+            )
+            del self.marker_buffer[:5]
+            return ("vmstop", status)
+        if self.marker_buffer[:1] == b"A" and len(self.marker_buffer) >= 17:
+            status = int.from_bytes(
+                self.marker_buffer[1:5],
+                byteorder=sys.byteorder,
+                signed=True,
+            )
+            target = int.from_bytes(
+                self.marker_buffer[9:17],
+                byteorder=sys.byteorder,
+                signed=True,
+            )
+            del self.marker_buffer[:17]
+            return ("advance", (status, target))
+        if self.marker_buffer[:1] == b"Q" and len(self.marker_buffer) >= 13:
+            status = int.from_bytes(
+                self.marker_buffer[1:5], byteorder=sys.byteorder, signed=True
+            )
+            icount = int.from_bytes(
+                self.marker_buffer[5:13], byteorder=sys.byteorder
+            )
+            del self.marker_buffer[:13]
+            return ("control-work", (status, icount))
+        if self.marker_buffer[:1] == b"E":
+            del self.marker_buffer[:1]
+            return ("ordering-error", None)
+        return None
+
+    def _consume_shutdown_markers(self):
+        """Validates and summarizes complete markers without retaining chatter."""
+        while True:
+            marker = self._take_marker()
+            if marker is None:
+                break
+            if marker[0] == "ordering-error":
+                raise AssertionError(
+                    "idle wait resumed before its control boundary during shutdown"
+                )
+            if marker[0] == "result" and marker[1] not in (0, 1, 2, 3, 9):
+                raise AssertionError(
+                    f"unexpected idle-wait status during shutdown: {marker[1]}"
+                )
+            self.shutdown_marker_counts[marker[0]] += 1
+            self.shutdown_marker_tail.append(marker)
+        if len(self.marker_buffer) > 16:
+            raise AssertionError(
+                "invalid marker during QEMU shutdown: "
+                f"buffered={bytes(self.marker_buffer)!r}"
+            )
+
+    def _append_shutdown_stderr(self, chunk):
+        self.shutdown_stderr_tail.extend(chunk)
+        excess = len(self.shutdown_stderr_tail) - SHUTDOWN_STDERR_BYTES
+        if excess > 0:
+            del self.shutdown_stderr_tail[:excess]
+
+    def _drain_shutdown_fds(self, ready):
+        stderr_fd = self.process.stderr.fileno()
+        for fd in ready:
+            if fd not in (self.marker_fd, stderr_fd):
+                continue
+            while True:
+                try:
+                    chunk = os.read(fd, 64 * 1024)
+                except BlockingIOError:
+                    break
+                if not chunk:
+                    if fd == self.marker_fd:
+                        self.marker_eof = True
+                    break
+                if fd == self.marker_fd:
+                    self.marker_buffer.extend(chunk)
+                    self._consume_shutdown_markers()
+                elif fd == stderr_fd:
+                    self._append_shutdown_stderr(chunk)
+
+    def _wait_for_shutdown(self, deadline):
+        """Drains child pipes while waiting under the caller's fixed deadline."""
+        self._append_shutdown_stderr(self.stderr_buffer)
+        self.stderr_buffer.clear()
+        self._consume_shutdown_markers()
+
+        while self.process.poll() is None:
+            remaining = deadline - time.monotonic()
+            if remaining <= 0:
+                raise TimeoutError(
+                    "QEMU did not exit after QMP quit: "
+                    f"events={self.events!r} "
+                    f"marker_counts={dict(self.shutdown_marker_counts)!r} "
+                    f"marker_tail={list(self.shutdown_marker_tail)!r} "
+                    f"buffered_marker={bytes(self.marker_buffer)!r} "
+                    f"stderr_tail={self.shutdown_stderr_tail.decode(errors='replace')!r}"
+                )
+
+            read_fds = [self.marker_fd, self.process.stderr.fileno()]
+            ready = select.select(
+                read_fds, [], [], min(remaining, 0.05)
+            )[0]
+            self._drain_shutdown_fds(ready)
+
+        # Reap the child and consume data that became readable with its exit.
+        self.process.wait()
+        self._drain_shutdown_fds(
+            [self.marker_fd, self.process.stderr.fileno()]
+        )
+        self._consume_shutdown_markers()
+        if self.marker_buffer:
+            raise AssertionError(
+                "QEMU exited with a truncated marker: "
+                f"buffered={bytes(self.marker_buffer)!r}"
+            )
+
+    def marker(self, deadline=None):
+        if deadline is None:
+            deadline = time.monotonic() + TIMEOUT_SECONDS
+        while True:
+            marker = self._take_marker()
+            if marker is not None:
+                return marker
+            chunk = self._read_chunk(self.marker_fd, deadline)
+            self.marker_buffer.extend(chunk)
+
+    def assert_no_marker_pending(self):
+        """Requires the marker stream to have no already-published event."""
+        if select.select([self.marker_fd], [], [], 0)[0]:
+            chunk = os.read(self.marker_fd, 4096)
+            if chunk:
+                self.marker_buffer.extend(chunk)
+        marker = self._take_marker()
+        if marker is not None or self.marker_buffer:
+            raise AssertionError(
+                "unexpected additional marker after exact boundary: "
+                f"marker={marker!r} buffered={bytes(self.marker_buffer)!r}"
+            )
+
+    def wait_for_futex_entry(
+        self,
+        park_thread,
+        park_address,
+        deadline=None,
+        stable_duration=0,
+        poll_interval=0.01,
+    ):
+        machine = platform.machine()
+        if machine not in FUTEX_SYSCALLS:
+            raise AssertionError(
+                f"no FUTEX_WAIT syscall mapping for host {machine!r}"
+            )
+
+        expected_syscall = FUTEX_SYSCALLS[machine]
+        syscall_path = (
+            f"/proc/{self.process.pid}/task/{park_thread}/syscall"
+        )
+        if deadline is None:
+            deadline = time.monotonic() + TIMEOUT_SECONDS
+        stable_since = None
+        while time.monotonic() < deadline:
+            try:
+                with open(syscall_path, encoding="ascii") as syscall_file:
+                    fields = syscall_file.read().split()
+            except (FileNotFoundError, ProcessLookupError):
+                fields = []
+
+            if len(fields) >= 3 and fields[0] != "running":
+                syscall_number = int(fields[0], 0)
+                futex_address = int(fields[1], 0)
+                futex_operation = int(fields[2], 0)
+                if (
+                    syscall_number == expected_syscall
+                    and futex_address == park_address
+                    and futex_operation == FUTEX_WAIT
+                ):
+                    now = time.monotonic()
+                    if stable_since is None:
+                        stable_since = now
+                    if now - stable_since >= stable_duration:
+                        self.futex_entries_observed += 1
+                        return True
+                else:
+                    stable_since = None
+            else:
+                stable_since = None
+
+            if select.select([self.marker_fd], [], [], 0)[0]:
+                self.marker_buffer.extend(os.read(self.marker_fd, 4096))
+            marker = self._take_marker()
+            if marker is not None:
+                event, value = marker
+                if event == "result":
+                    if value not in (0, 1, 2, 3, 9):
+                        raise AssertionError(
+                            f"unexpected idle-wait status {value}"
+                        )
+                    return False
+                if event == "work":
+                    self.work_cpu_indices.add(value)
+                else:
+                    raise AssertionError(
+                        "overlapping idle-wait park publications"
+                    )
+            time.sleep(poll_interval)
+
+        raise TimeoutError("QEMU never entered the published FUTEX_WAIT")
+
+    def wait_for_latest_trace(self, pattern, deadline):
+        """Returns the newest persisted match for one enabled tracepoint."""
+        stderr_fd = self.process.stderr.fileno()
+        while True:
+            while select.select([stderr_fd], [], [], 0)[0]:
+                chunk = os.read(stderr_fd, 4096)
+                if not chunk:
+                    raise RuntimeError("QEMU stderr closed before trace event")
+                self.stderr_buffer.extend(chunk)
+
+            matches = list(pattern.finditer(self.stderr_buffer))
+            if matches:
+                match = matches[-1]
+                groups = match.groups()
+                del self.stderr_buffer[:match.end()]
+                return groups
+
+            remaining = deadline - time.monotonic()
+            if remaining <= 0:
+                raise self._timeout_error(False)
+            ready = select.select([stderr_fd], [], [], remaining)[0]
+            if not ready:
+                raise self._timeout_error(False)
+
+    def wait_for_infinite_host_poll_ready(self, generation, deadline):
+        """Returns a later positive readiness from an infinite host poll."""
+        stderr_fd = self.process.stderr.fileno()
+        while True:
+            while select.select([stderr_fd], [], [], 0)[0]:
+                chunk = os.read(stderr_fd, 4096)
+                if not chunk:
+                    raise RuntimeError(
+                        "QEMU stderr closed before infinite host poll"
+                    )
+                self.stderr_buffer.extend(chunk)
+
+            matches = list(
+                MAIN_LOOP_POLL_READY_TRACE.finditer(self.stderr_buffer)
+            )
+            for match in matches:
+                ready_generation = int(match.group(1))
+                poll_result = int(match.group(2))
+                timeout_ns = int(match.group(3))
+                if (
+                    ready_generation > generation
+                    and poll_result > 0
+                    and timeout_ns == -1
+                ):
+                    del self.stderr_buffer[:match.end()]
+                    return ready_generation
+            if matches:
+                del self.stderr_buffer[:matches[-1].end()]
+
+            remaining = deadline - time.monotonic()
+            if remaining <= 0:
+                raise self._timeout_error(False)
+            ready = select.select([stderr_fd], [], [], remaining)[0]
+            if not ready:
+                raise self._timeout_error(False)
+
+    def wait_for_host_poll_state(self, deadline):
+        """Returns the latest complete or pending host poll."""
+        stderr_fd = self.process.stderr.fileno()
+        while True:
+            while select.select([stderr_fd], [], [], 0)[0]:
+                chunk = os.read(stderr_fd, 4096)
+                if not chunk:
+                    raise RuntimeError("QEMU stderr closed before host poll")
+                self.stderr_buffer.extend(chunk)
+
+            enter_matches = list(
+                MAIN_LOOP_POLL_ENTER_TRACE.finditer(self.stderr_buffer)
+            )
+            ready_matches = list(
+                MAIN_LOOP_POLL_READY_TRACE.finditer(self.stderr_buffer)
+            )
+            latest_ready_end = ready_matches[-1].end() if ready_matches else -1
+            if enter_matches and enter_matches[-1].start() > latest_ready_end:
+                enter = enter_matches[-1]
+                timeout_ns = int(enter.group(1))
+                generation = (
+                    int(ready_matches[-1].group(1)) if ready_matches else 0
+                )
+                del self.stderr_buffer[:enter.end()]
+                return generation, 0, timeout_ns, True
+            if ready_matches:
+                ready_match = ready_matches[-1]
+                generation = int(ready_match.group(1))
+                poll_result = int(ready_match.group(2))
+                timeout_ns = int(ready_match.group(3))
+                del self.stderr_buffer[:ready_match.end()]
+                return generation, poll_result, timeout_ns, False
+
+            remaining = deadline - time.monotonic()
+            if remaining <= 0:
+                raise self._timeout_error(False)
+            ready = select.select([stderr_fd], [], [], remaining)[0]
+            if not ready:
+                raise self._timeout_error(False)
+
+    def wait_for_rr_dispatch_event(self, deadline):
+        machine = platform.machine()
+        if machine not in FUTEX_SYSCALLS:
+            raise AssertionError(
+                f"no futex syscall mapping for host {machine!r}"
+            )
+
+        stderr_fd = self.process.stderr.fileno()
+        while True:
+            match = RR_DISPATCH_EVENT_TRACE.search(self.stderr_buffer)
+            if match is not None:
+                rr_thread = int(match.group(1), 10)
+                event_address = int(match.group(2), 16)
+                event_size = int(match.group(3), 10)
+                del self.stderr_buffer[:match.end()]
+                break
+
+            remaining = deadline - time.monotonic()
+            if remaining <= 0:
+                raise TimeoutError("QEMU did not trace its RR ceiling wait")
+            ready = select.select([stderr_fd], [], [], remaining)[0]
+            if not ready:
+                raise TimeoutError("QEMU did not trace its RR ceiling wait")
+            chunk = os.read(stderr_fd, 4096)
+            if not chunk:
+                raise RuntimeError("QEMU stderr closed before RR ceiling wait")
+            self.stderr_buffer.extend(chunk)
+
+        address_space_end = 1 << (8 * struct.calcsize("P"))
+        if event_size <= 0:
+            raise AssertionError(
+                f"RR ceiling trace reported invalid event size: {event_size}"
+            )
+        if (
+            event_address >= address_space_end
+            or event_size > address_space_end - event_address
+        ):
+            raise AssertionError(
+                "RR ceiling trace event extent overflowed: "
+                f"address={event_address:#x} size={event_size}"
+            )
+        event_end = event_address + event_size
+
+        task_root = f"/proc/{self.process.pid}/task"
+        rr_threads = []
+        for task_name in os.listdir(task_root):
+            comm_path = os.path.join(task_root, task_name, "comm")
+            with open(comm_path, encoding="ascii") as comm_file:
+                if comm_file.read().strip() == "ALL CPUs/TCG":
+                    rr_threads.append(int(task_name))
+        if len(rr_threads) != 1:
+            raise AssertionError(
+                "expected exactly one ALL CPUs/TCG task, found "
+                f"{rr_threads!r}"
+            )
+        if rr_threads[0] != rr_thread:
+            raise AssertionError(
+                "RR ceiling trace named a different host task: "
+                f"trace={rr_thread} comm={rr_threads[0]}"
+            )
+
+        syscall_path = os.path.join(task_root, str(rr_thread), "syscall")
+        expected_syscall = FUTEX_SYSCALLS[machine]
+        while time.monotonic() < deadline:
+            with open(syscall_path, encoding="ascii") as syscall_file:
+                fields = syscall_file.read().split()
+            if len(fields) >= 3 and fields[0] != "running":
+                syscall_number = int(fields[0], 0)
+                futex_address = int(fields[1], 0)
+                futex_command = int(fields[2], 0) & FUTEX_CMD_MASK
+                if (
+                    syscall_number == expected_syscall
+                    and futex_address == event_address
+                    and futex_command == FUTEX_WAIT
+                ):
+                    break
+
+        else:
+            raise TimeoutError("sim RR thread did not enter its ceiling event futex")
+
+        event_mappings = []
+        futex_mappings = []
+        maps_path = f"/proc/{self.process.pid}/maps"
+        with open(maps_path, encoding="ascii") as maps_file:
+            for line in maps_file:
+                fields = line.split(maxsplit=5)
+                mapping_start, mapping_end = (
+                    int(value, 16) for value in fields[0].split("-", 1)
+                )
+                if mapping_start <= event_address and event_end <= mapping_end:
+                    event_mappings.append(fields)
+                if mapping_start <= futex_address < mapping_end:
+                    futex_mappings.append(fields)
+        if len(event_mappings) != 1 or futex_mappings != event_mappings:
+            raise AssertionError(
+                "RR ceiling event and futex do not share one mapping: "
+                f"event={event_address:#x} futex={futex_address:#x} "
+                f"event_mappings={event_mappings!r} "
+                f"futex_mappings={futex_mappings!r}"
+            )
+
+        mapping = event_mappings[0]
+        if mapping[1] != "rw-p":
+            raise AssertionError(
+                "RR ceiling event is outside writable private storage: "
+                f"event={event_address:#x} mapping={mapping!r}"
+            )
+        return "dispatch-event"
+
+    def wait_for_park(self):
+        deadline = time.monotonic() + TIMEOUT_SECONDS
+        while time.monotonic() < deadline:
+            event, value = self.marker()
+            if event == "park":
+                park_thread, park_address = value
+                if self.wait_for_futex_entry(
+                    park_thread, park_address, deadline
+                ):
+                    return
+                continue
+            if event == "work":
+                self.work_cpu_indices.add(value)
+                continue
+            if value not in (0, 1, 2, 3, 9):
+                raise AssertionError(f"unexpected idle-wait status {value}")
+        raise TimeoutError("QEMU did not reach an admitted idle wait")
+
+    def wait_for_work(self, vcpu_index):
+        deadline = time.monotonic() + TIMEOUT_SECONDS
+        while time.monotonic() < deadline:
+            event, value = self.marker()
+            if event == "work":
+                self.work_cpu_indices.add(value)
+                if value == vcpu_index:
+                    return
+                continue
+            if event == "park":
+                # CPU creation may publish a transitional park before its
+                # asynchronous initialization work reaches the RR thread.
+                # Wake that unproven publication and attest the park only
+                # after the target vCPU's work callback has run.
+                status = self.qmp("query-status")
+                if not status.get("running"):
+                    raise AssertionError(
+                        f"QEMU stopped while awaiting vCPU work: {status!r}"
+                    )
+                continue
+            if value not in (0, 1, 2, 3, 9):
+                raise AssertionError(f"unexpected idle-wait status {value}")
+        raise TimeoutError(f"vCPU {vcpu_index} work did not execute")
+
+    def qtest_command(self, command):
+        self.qtest.sendall(command.encode() + b"\n")
+        response = bytearray()
+        deadline = time.monotonic() + TIMEOUT_SECONDS
+        while b"\n" not in response:
+            remaining = deadline - time.monotonic()
+            if remaining <= 0:
+                raise TimeoutError(f"qtest command timed out: {command}")
+            read_fds = [self.qtest]
+            if not self.marker_eof:
+                read_fds.append(self.marker_fd)
+            ready = select.select(read_fds, [], [], remaining)[0]
+            if not ready:
+                raise TimeoutError(f"qtest command timed out: {command}")
+            if self.marker_fd in ready:
+                marker_chunk = os.read(self.marker_fd, 4096)
+                if marker_chunk:
+                    self.marker_buffer.extend(marker_chunk)
+                else:
+                    self.marker_eof = True
+            if self.qtest in ready:
+                chunk = self.qtest.recv(4096)
+                if not chunk:
+                    raise RuntimeError("qtest connection closed")
+                response.extend(chunk)
+        if response != b"OK\n":
+            raise AssertionError(f"qtest command failed: {response!r}")
+
+    def close(self):
+        try:
+            deadline = time.monotonic() + TIMEOUT_SECONDS
+            os.set_blocking(self.marker_fd, False)
+            os.set_blocking(self.process.stderr.fileno(), False)
+            if self.process.poll() is None:
+                self.qmp("quit", deadline=deadline, shutdown=True)
+            self._wait_for_shutdown(deadline)
+        finally:
+            if self.process.poll() is None:
+                self.process.kill()
+                self.process.wait()
+            self.qtest.close()
+            self.qtest_listener.close()
+            os.close(self.marker_fd)
+            self.control_state.close()
+            os.close(self.state_fd)
+            os.close(self.wake_fd)
+            self.temp_dir.cleanup()
+        if self.process.returncode != 0:
+            stderr = self.shutdown_stderr_tail.decode(errors="replace")
+            raise AssertionError(
+                f"QEMU exited with status {self.process.returncode}: {stderr}"
+            )
+
