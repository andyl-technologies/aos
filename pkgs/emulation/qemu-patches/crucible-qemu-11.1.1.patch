+    g_test_add_func("/crucible/idle-wait/timer-witness/stale-generation",
+                    test_timer_witness_rejects_stale_generation);
+    g_test_add_func("/crucible/idle-wait/rr-wake/pending-epoch-aba",
+                    test_rr_wake_pending_epoch_cannot_collapse_under_producer);
+    g_test_add_func("/crucible/idle-wait/rr-wake/dispatch-rescan",
