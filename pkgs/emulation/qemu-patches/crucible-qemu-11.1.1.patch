+static int checkpoint_inventory_custody_identity(QemuCrucibleCheckpointInventoryLoan *loan)
+{
+    QemuCrucibleCheckpointHeldTransaction *owner = &checkpoint_transaction;
+    QemuCrucibleCheckpointRequestLoan *request = &checkpoint_request;
+
+    if (loan != &owner->inventory || !loan->active ||
+        loan->transaction != owner || loan->request != request ||
+        loan->process != getpid() || !qemu_thread_is_self(&loan->thread) ||
+        !qemu_in_main_thread() || !bql_locked() || qemu_in_coroutine() ||
+        owner->request != request || request->monitor != monitor_cur() ||
+        !request->main_scope_active || request->end_requested ||
+        !request->provider_acquired || request->provider_ended ||
+        !loan->provider_owner || loan->provider_owner != request->provider_owner ||
+        !owner->stopped || loan->stop != &checkpoint_stop_owner ||
+        loan->stop->transaction != owner || !loan->stop->allocation_retained ||
+        !qatomic_load_acquire(&loan->stop->published) ||
+        loan->stopped_generation != loan->stop->completed_generation ||
+        loan->stopped_generation != owner->stopped_generation) {
+        return -EPERM;
+    }
+    return 0;
+}
+
+static int checkpoint_inventory_identity(QemuCrucibleCheckpointInventoryLoan *loan)
+{
+    int status = checkpoint_inventory_custody_identity(loan);
+
+    return status ? status : checkpoint_identity_base(loan->transaction);
+}
+
+static int checkpoint_inventory_admission_identity(void *monitor)
+{
+    QemuCrucibleCheckpointHeldTransaction *owner = &checkpoint_transaction;
+    QemuCrucibleCheckpointRequestLoan *request = &checkpoint_request;
+    int status = qemu_crucible_checkpoint_storage_current_v1();
+
+    if (!status) {
+        status = checkpoint_identity(owner);
+    }
+    if (status || owner->request != request || request->monitor != monitor ||
+        !request->main_scope_active || request->end_requested ||
+        request->snapshot_birth_pending || request->snapshot_issued ||
+        !request->provider_acquired || request->provider_ended || !request->provider_owner ||
+        request->request_owner != &checkpoint_main_owner ||
+        !qatomic_load_acquire(&checkpoint_main_owner.published) ||
+        !checkpoint_main_owner.allocation_retained || !owner->stopped ||
+        checkpoint_stop_owner.transaction != owner ||
+        !qatomic_load_acquire(&checkpoint_stop_owner.published) ||
+        checkpoint_stop_owner.completed_generation != owner->stopped_generation ||
+        owner->prepare_called || owner->pager_held || owner->proof.retained ||
+        owner->release_started || owner->candidate_started) {
+        return status ? status : -EPERM;
+    }
+    /* The used QMP prelude already observed the genuine Begin/Stop before fd
+     * take. This constructor records cleanup custody before trailing temporal
+     * refusal; identity alone cannot authorize metadata effects. */
+    return 0;
+}
