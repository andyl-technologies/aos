+static void fixture_seven_purpose(void)
+{
+    QemuCrucibleMetadataPartition *partition =
+        &startup_source.metadata_partition;
+    QemuCrucibleProcessPurposeRecord *record =
+        &startup_source.process_purpose_record;
+
+    record->original_total = fixture.total;
+    record->local_extent = fixture_local_extent(0);
+    record->gross_process = record->local_extent * 2;
+    record->assigned_outside = 128;
+    record->pending_cleanup = 32;
+    record->pending_workspace = 32;
+    record->pending_startup = 32;
+    record->assigned_startup = 32;
+    record->incarnation_guest = 4096;
+    record->live_incarnations = 1;
+    record->account_generation = 1;
+    record->memory_limit = record->local_extent;
+    record->writable_file_limit = 131072;
+    record->task_limit = 8;
+    record->fd_limit = 64;
+    record->vcpu_limit = 1;
+    record->artifact_digest[0] = 0x5a;
+    record->artifact_machine = 62;
+    record->child_cgroup_device = 0;
+    record->child_cgroup_inode = 17;
+    record->maximum_incarnations = 2;
+    record->subdivision_index = 0;
+    record->process_generation = startup_source.original.process_generation;
+    memcpy(record->containing_capability, startup_source.original.cap_id, 32);
+    record->containing_operation = startup_source.original.operation_id + 1;
+    record->containing_start = startup_source.original.original_start_ns;
+    record->containing_end = startup_source.original.absolute_end_ns;
+    record->containing_poll = startup_source.original.poll_ns;
+    partition->total = fixture.total;
+    partition->process_extent = record->local_extent;
+    /* This isolated seven-row recipe models the admitted local partition;
+     * artifact, namespace and compulsory native-prefix issuance remain seams.
+     */
+    partition->compulsory_extent = 4096;
+    for (size_t index = 0; index < 7; index++) {
+        seven_requests[index] = (QemuCrucibleProcessPurposeRequest) {
+            .extent = 64 + index * 16,
+            .alignment = 8,
+            .count = 1,
+        };
+        record->requests[index] = seven_requests[index];
+        partition->control_requests[index] = seven_requests[index].extent;
+        partition->control_alignments[index] = seven_requests[index].alignment;
+        partition->control_counts[index] = seven_requests[index].count;
+    }
+    startup_source.preexec_purpose_owner = &modeled_preexec_owner;
+    startup_source.process_contract_owner = &modeled_contract_owner;
+    startup_source.incarnation_purpose_owner = &modeled_incarnation_owner;
+    qatomic_store_release(&partition->published, true);
+    qatomic_store_release(&startup_source.process_purpose_complete, true);
+}
