+/* Without Source acquisition, the ordinary loader invariant still forbids
+ * uninstalling from the install callback. This literal entered guard must
+ * abort before the probe's modeled destructive continuation is reached. */
+static void test_installing_uninstall_rejected(void)
+{
+    if (!fixture_supports_selected_family()) {
+        g_test_skip("Selected prepared-family Source requires Linux/x86-64");
+        return;
+    }
+    if (g_test_subprocess()) {
+        fixture_prepare(0, false);
+        qemu_sem_init(&uninstall_entry_passed, 0);
+        g_assert_true(fixture.ctx.installing);
+        g_assert_false(qemu_plugin_crucible_startup_source_retained());
+        effect_reached = false;
+        probe_uninstall_ordered(fixture.ctx.id, false, false);
+        g_assert_not_reached();
+    }
+    g_test_trap_subprocess(NULL, 10000000, 0);
+    g_test_trap_assert_failed();
+    g_test_trap_assert_stderr(
+        "*Calling qemu_plugin_uninstall from the install function*");
+}
