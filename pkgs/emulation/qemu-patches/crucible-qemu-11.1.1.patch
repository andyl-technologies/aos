+        status = qemu_plugin_crucible_initial_cpu_callback_entered_v1(cpu);
+    }
+    if (!status) {
+        status = initial_cpu_identity(cpu, &cpu->crucible_initial_participant,
+                                     &participant);
+    }
+    if (!status && (!participant->entered || !participant->module_callback_active)) {
+        status = -EPERM;
+    }
+    if (!status) {
+        status = initial_cpu_child_source_current(participant, false);
+    }
+    if (status) {
+        return status;
+    }
+    /* Independently observe the actual retained VL frame and same Original,
+     * including after a failed first or changed mapped/workspace fields. */
+    *authenticated = true;
+    return initial_cpu_child_original_observe(participant, true);
+}
