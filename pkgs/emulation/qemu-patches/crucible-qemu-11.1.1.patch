+         * No initialized group, reference or Source owner is manufactured. */
+        native_shmem_dispatch_members[member] = &refused;
+    }
+    qemu_crucible_selected_process_id = selected ? getpid() : 0;
+    mutate_member = changed ? member : UINT_MAX;
+    switch (member) {
+    case 0:
+        result = crucible_group_call_publish_icount_cb(123, &diagnostic_userdata);
+        break;
+    case 1:
+        result = crucible_group_call_max_advance_icount_cb(&diagnostic_userdata, &out);
+        break;
+    default:
