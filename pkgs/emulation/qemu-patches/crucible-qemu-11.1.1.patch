+ * WebSocket, reconnect, connect-task, or queued descriptor-transfer state.
+ * The immutable basis retains the exact inherited channel, listener, read/HUP
+ * sources, frontend, and context for a later child-only disposition.  This
+ * operation is nondestructive.
+ *
+ * Returns: zero on success, or a negative errno value on rejection.
+ */
+int qemu_chr_socket_hot_fork_prepare_child_basis(
+    QemuChrSocketHotForkChildBasis *basis, Chardev *chardev,
+    CharFrontend *frontend, GMainContext *context);
+
+/**
+ * qemu_chr_socket_hot_fork_child_basis_matches() - revalidate socket basis
+ * @basis: previously prepared future-child socket resource basis
+ * @chardev: exact expected connected chardev
+ * @frontend: exact expected monitor frontend
+ * @context: exact expected GMainContext
+ *
+ * Returns: true exactly while every bound socket resource and restriction
+ * remains unchanged.
+ */
+bool qemu_chr_socket_hot_fork_child_basis_matches(
+    const QemuChrSocketHotForkChildBasis *basis, Chardev *chardev,
+    CharFrontend *frontend, GMainContext *context);
+
+/**
+ * qemu_chr_socket_hot_fork_reconstruct_child_held() - replace child socket
+ * @basis: exact inherited socket basis prepared before fork
+ * @replacement_fd: retained branch-private connected AF_UNIX stream
+ * @expected_socket_cookie: exact nonzero Linux SO_COOKIE for @replacement_fd
+ *
+ * Consumes the copied basis only in a different process incarnation. The
+ * operation revalidates every inherited object and the replacement endpoint
+ * before mutation, then destroys the child's inherited read/HUP sources and
+ * connection and installs a duplicate of @replacement_fd without attaching
+ * input sources or emitting an open event. The listener remains disabled.
+ * The monitor-owned caller composes parser and capability reset, dispatcher
+ * replacement, and monitor-I/O-thread reconstruction around this held socket.
+ * Greeting emission and input release remain later operations.
+ *
+ * The transition is one-shot. Once destructive work begins, failure never
+ * makes the basis reusable.
+ *
+ * Returns: zero after exact held replacement, -EPERM in the source process or
+ * after an earlier attempt, -ESTALE if the inherited basis changed, -ENOTSUP
+ * when exact Linux socket authentication is unavailable, or another negative
+ * errno value for an invalid or unusable replacement.
+ */
+int qemu_chr_socket_hot_fork_reconstruct_child_held(
+    QemuChrSocketHotForkChildBasis *basis, int replacement_fd,
+    uint64_t expected_socket_cookie);
+
+/**
+ * qemu_chr_socket_hot_fork_child_input_is_held() - validate held child input
+ * @basis: exact held child socket basis after successful reconstruction
+ * @context: exact replacement monitor I/O-thread GMainContext
+ *
+ * Returns: true exactly while the reconstructed child socket remains connected
+ * with no read or HUP source attached.
+ */
+bool qemu_chr_socket_hot_fork_child_input_is_held(
+    QemuChrSocketHotForkChildBasis *basis, GMainContext *context);
+
+/**
+ * qemu_chr_socket_hot_fork_rehome_child_context() - move held input's context
+ * @basis: exact held child socket basis after successful reconstruction
+ * @inherited: exact GMainContext the basis was reconstructed against
+ * @replacement: fresh GMainContext the rebuilt monitor I/O thread runs
+ *
+ * A hot-fork child rebuilds its monitor I/O thread's GMainContext, because
+ * GLib will not let a new thread acquire the inherited one.  While input is
+ * held no source is attached, so the held socket follows by recording the
+ * replacement as the chardev's and the basis's context; the sources that
+ * release attaches then land in it.
+ *
+ * Returns: zero after the move, -EPERM in the source process or after
+ * release, or -ESTALE if the held socket basis does not match @inherited.
+ */
+int qemu_chr_socket_hot_fork_rehome_child_context(
+    QemuChrSocketHotForkChildBasis *basis, GMainContext *inherited,
+    GMainContext *replacement);
+
+/**
+ * qemu_chr_socket_hot_fork_release_child_input() - attach child input sources
+ * @basis: exact held child socket basis after successful reconstruction
+ * @context: exact replacement monitor I/O-thread GMainContext
+ *
+ * Revalidates the complete child-only held socket state and attaches exactly
+ * one read source and one HUP source to @context.  The caller must run on the
+ * owner of @context after the replacement frontend's greeting has been sent.
+ *
+ * The transition is one-shot.  Rejection occurs before source attachment.
+ *
+ * Returns: zero after exact source attachment, -EPERM in the source process or
+ * after release, or -ESTALE if the reconstructed socket basis changed.
+ */
+int qemu_chr_socket_hot_fork_release_child_input(
+    QemuChrSocketHotForkChildBasis *basis, GMainContext *context);
+
 DECLARE_INSTANCE_CHECKER(SocketChardev, SOCKET_CHARDEV,
                          TYPE_CHARDEV_SOCKET)
 
