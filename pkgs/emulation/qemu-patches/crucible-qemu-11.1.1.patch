+static uint64_t fixture_required_worker_charge_bytes(void)
+{
+    QemuCruciblePluginWorker workers[] = {
+        { .thread_name = "crucible-run", .policy_descriptor = -1,
+          .layout = qemu_plugin_crucible_run_worker_layout_v1 },
+        { .thread_name = "crucible-drop", .policy_descriptor = -1,
+          .layout = qemu_plugin_crucible_teardown_worker_layout_v1 },
+    };
+    uint64_t bytes = 0;
+
+    /* Run the genuine preeffect backing calculation, including this binary's
+     * loaded TLS cohort and kernel allocator policy. No charge or task is
+     * issued by this calculation, and no worker is constructed or returned. */
+    for (size_t index = 0; index < G_N_ELEMENTS(workers); index++) {
+        QemuCruciblePluginWorker *worker = &workers[index];
+
+        g_assert_cmpint(plugin_worker_backing(worker), ==, 0);
+        g_assert_cmpuint(worker->residual_bytes, <=,
+                         UINT64_MAX - worker->layout.stack_bytes - bytes);
+        bytes += worker->residual_bytes + worker->layout.stack_bytes;
+        g_assert_cmpint(worker->policy_descriptor, ==, -1);
+        g_assert_false(worker->birth.born);
+        g_assert_false(worker->residual_charge.held);
+        g_assert_false(worker->stack_charge.held);
+    }
+    return bytes;
+}
