+void qemu_mutex_hot_fork_inventory(QemuMutexHotForkInventory *inventory)
+{
+    size_t count = 0;
+    size_t index;
+
+    *inventory = (QemuMutexHotForkInventory) { 0 };
+    crucible_hot_fork_mutex_registry_lock();
+    inventory->generation = crucible_hot_fork_mutex_generation;
+    inventory->overflowed = crucible_hot_fork_mutex_overflowed ||
+        crucible_hot_fork_mutex_inconsistent;
+    inventory->entries = g_new0(QemuMutexHotForkInventoryEntry,
+                                crucible_hot_fork_mutex_count);
+    inventory->entry_count = crucible_hot_fork_mutex_count;
+
+    for (index = 0; index < QEMU_HOT_FORK_MUTEX_INVENTORY_MAX; index++) {
+        CrucibleHotForkMutexEntry *mutex = &crucible_hot_fork_mutexes[index];
+        QemuMutexHotForkInventoryEntry *entry;
+
+        if (!mutex->active) {
+            continue;
+        }
+        g_assert(count < inventory->entry_count);
+        entry = &inventory->entries[count++];
+        entry->mutex_id = mutex->registration_id;
+        entry->owner_thread_id = qatomic_read(&mutex->owner_thread_id);
+        entry->recursion_depth = qatomic_read(&mutex->recursion_depth);
+        entry->acquisition_waiters = qatomic_read(
+            &mutex->acquisition_waiters);
+        entry->condition_waiters = qatomic_read(&mutex->condition_waiters);
+        entry->recursive = mutex->recursive;
+        entry->unlock_active = qatomic_read(&mutex->unlock_active);
+        entry->ownership_valid = qatomic_read(&mutex->ownership_valid);
+    }
+    g_assert(count == inventory->entry_count);
+    if (inventory->entry_count > 1) {
+        qsort(inventory->entries, inventory->entry_count,
+              sizeof(inventory->entries[0]),
+              crucible_hot_fork_mutex_inventory_entry_compare);
+    }
+    crucible_hot_fork_mutex_registry_unlock();
+}
+
+void qemu_mutex_hot_fork_inventory_destroy(
+    QemuMutexHotForkInventory *inventory)
+{
+    g_free(inventory->entries);
+    *inventory = (QemuMutexHotForkInventory) { 0 };
+}
