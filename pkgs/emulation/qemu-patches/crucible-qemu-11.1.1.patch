+}
+QemuCruciblePublisherServiceReturnResult
+qemu_crucible_startup_source_publisher_service_return_v1(
+    QemuCrucibleSourceControlBinding *component,
+    QemuCrucibleSourceControlBinding **holder,
+    QemuCruciblePublisherServiceReturnFrame *frame)
+{
+    source_return_calls++;
+    return (QemuCruciblePublisherServiceReturnResult) { .status = -ENOKEY };
+}
+int qemu_crucible_startup_source_control_component_identity_return_v1(
+    QemuCrucibleSourceControlBinding **holder)
+{
+    component_return_calls++;
