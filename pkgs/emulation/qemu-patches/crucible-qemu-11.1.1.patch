+static int node_rule_compare(gconstpointer left, gconstpointer right)
+{
+    const QemuCrucibleFaultRule *a = *(const void * const *)left;
+    const QemuCrucibleFaultRule *b = *(const void * const *)right;
+    int order;
+
+    order = memcmp(a->binding_hash, b->binding_hash, 32);
+    if (order) {
+        return order;
+    }
+    if (a->command_kind != b->command_kind) {
+        return a->command_kind < b->command_kind ? -1 : 1;
+    }
+    return a->generation == b->generation ? 0 :
+           (a->generation < b->generation ? -1 : 1);
+}
+
+static void node_rule_clear(QemuCrucibleFaultRule *rule,
+                            CrucibleNodeStorageControl *control)
+{
+    bool had_reference;
+
+    if (!rule) {
+        return;
+    }
+    for (size_t i = 0; i < rule->field_count; i++) {
+        had_reference = rule->fields[i].json != NULL;
+        qobject_unref(rule->fields[i].json);
+        if (control && had_reference) {
+            control->json_references_returned++;
+        }
+    }
+    had_reference = rule->row_counts != NULL;
+    g_clear_pointer(&rule->row_counts, g_array_unref);
+    if (control && had_reference) {
+        control->references_returned |= CRUCIBLE_NODE_REF_ROW_COUNTS;
+    }
+    had_reference = rule->translations != NULL;
+    g_clear_pointer(&rule->translations, g_array_unref);
+    if (control && had_reference) {
+        control->references_returned |= CRUCIBLE_NODE_REF_TRANSLATIONS;
+    }
+    had_reference = rule->retention_cells != NULL;
+    g_clear_pointer(&rule->retention_cells, g_hash_table_unref);
+    if (control && had_reference) {
+        control->references_returned |= CRUCIBLE_NODE_REF_RETENTION_CELLS;
+    }
+    had_reference = rule->row_counters != NULL;
+    g_clear_pointer(&rule->row_counters, g_hash_table_unref);
+    if (control && had_reference) {
+        control->references_returned |= CRUCIBLE_NODE_REF_ROW_COUNTERS;
+    }
+    had_reference = rule->evidence_mutation_records != NULL;
+    g_clear_pointer(&rule->evidence_mutation_records, g_byte_array_unref);
+    if (control && had_reference) {
+        control->references_returned |= CRUCIBLE_NODE_REF_MUTATION_RECORDS;
+    }
+    had_reference = rule->evidence_counter_records != NULL;
+    g_clear_pointer(&rule->evidence_counter_records, g_byte_array_unref);
+    if (control && had_reference) {
+        control->references_returned |= CRUCIBLE_NODE_REF_COUNTER_RECORDS;
+    }
+    had_reference = rule->service_ledger != NULL;
+    node_memory_service_ledger_release(rule->service_ledger);
+    if (control && had_reference) {
+        control->references_returned |= CRUCIBLE_NODE_REF_SERVICE_LEDGER;
+    }
+    rule->service_ledger = NULL;
+    had_reference = rule->payload != NULL;
+    if (control && control->child) {
+        control->child->payload_owed = had_reference;
+    }
+    g_free(rule->payload);
+    if (control && control->child && had_reference) {
+        control->child->payload_returned = true;
+    }
+    if (control && had_reference) {
+        control->payload_returned = true;
+    }
+    rule->payload = NULL;
+    rule->payload_len = 0;
+    rule->field_count = 0;
+}
+
+static QemuCrucibleFaultRule *node_rule_ref(QemuCrucibleFaultRule *rule)
+{
+    g_auto(CrucibleNodeStorageOperation) operation =
+        node_storage_operation_begin();
+    QemuCrucibleFaultRegistration *origin;
+
+    if (!operation.entered || !rule || !node_storage_rule_origin(rule, &origin)) {
+        error_report("Crucible rule reference lost actual storage owner");
+        abort();
+    }
+    g_assert(rule && rule->references != 0 &&
+             rule->references != UINT32_MAX);
+    rule->references++;
+    return rule;
+}
