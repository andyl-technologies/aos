+static bool physical_end_output_overlap(const void *out, const void *field,
+                                        size_t extent)
+{
+    uintptr_t start = (uintptr_t)out;
+    uintptr_t target = (uintptr_t)field;
+    size_t bytes = sizeof(struct qemu_plugin_crucible_ram_physical_end_v2);
+
+    return !out || bytes > UINTPTR_MAX - start || extent > UINTPTR_MAX - target ||
+        (start < target + extent && target < start + bytes);
+}
+
+static int physical_end_output_check(
+    const struct qemu_plugin_crucible_ram_physical_end_v2 *out)
+{
+    if (!qemu_in_main_thread() || !bql_locked() || qemu_in_coroutine()) {
+        return -EPERM;
+    }
+    /* No user header is read until both private owner domains and the retained
+     * workspace/holder spans have been excluded. This issues no admission. */
+    if (physical_end_output_overlap(out, &physical_token, sizeof(physical_token)) ||
+        physical_end_output_overlap(out, &physical_topology, sizeof(physical_topology)) ||
+        physical_end_output_overlap(out, &physical_borrow_generation, sizeof(physical_borrow_generation)) ||
+        physical_end_output_overlap(out, &physical_device_generation, sizeof(physical_device_generation)) ||
+        physical_end_output_overlap(out, &physical_listener_generation, sizeof(physical_listener_generation)) ||
+        physical_end_output_overlap(out, &checkpoint_native_fence, sizeof(checkpoint_native_fence)) ||
+        physical_end_output_overlap(out, &checkpoint_native_fence_cut, sizeof(checkpoint_native_fence_cut)) ||
+        physical_end_output_overlap(out, &fingerprint_root_background, sizeof(fingerprint_root_background)) ||
+        physical_end_output_overlap(out, owner_diagnostics, sizeof(owner_diagnostics)) ||
+        physical_end_output_overlap(out, &admission, sizeof(admission))) {
+        return -EINVAL;
