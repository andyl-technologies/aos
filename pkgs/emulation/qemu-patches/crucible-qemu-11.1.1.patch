+int qemu_crucible_preexec_standing_snapshot_v1(
+    QemuCrucibleStandingPurposeOwner *held, uint8_t *snapshot, uint64_t *sequence)
+{
+    QemuCruciblePreexecSetupOwner *owner = &preexec_setup_owner;
+
+    if (held != &owner->standing || !owner->standing.retained ||
+        !owner->source_published || !snapshot || !sequence ||
+        preexec_setup_syscall5(SYS_getpid, 0, 0, 0, 0, 0) != owner->process_id) {
+        return -EPERM;
+    }
+    return preexec_standing_snapshot(held, snapshot, sequence);
+}
