+    qemu_put_byte(f, lpc->apm.apms);
+    qemu_put_be16(f, acpi->pm1.evt.sts);
+    qemu_put_be16(f, acpi->pm1.evt.en);
+    qemu_put_be16(f, acpi->pm1.cnt.cnt);
+    ich9_put_timer(f, acpi->tmr.timer);
+    qemu_put_byte(f, qemu_timer_tcg_ps_enabled());
+    qemu_put_be64(f, (__uint128_t)overflow >> 64);
+    qemu_put_be64(f, overflow);
+    ich9_crucible_clock_fingerprint_projection(f, &acpi->tmr);
+    qemu_put_byte(f, acpi->gpe.len);
+    qemu_put_buffer(f, acpi->gpe.sts, acpi->gpe.len);
+    qemu_put_buffer(f, acpi->gpe.en, acpi->gpe.len);
+    qemu_put_be32(f, pm->smi_en);
+    qemu_put_be32(f, pm->smi_sts);
+
+    qemu_put_byte(f, pm->swsmi_timer_enabled);
+    if (pm->swsmi_timer_enabled) {
+        ich9_put_timer(f, pm->swsmi_timer);
+    }
+    qemu_put_byte(f, pm->periodic_timer_enabled);
+    if (pm->periodic_timer_enabled) {
