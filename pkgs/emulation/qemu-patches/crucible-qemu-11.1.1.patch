+    if (!completion->enrolled || completion->runtime != runtime ||
+        (uintptr_t)completion->userdata != child->runtime_base ||
+        runtime->configured_requests[0].extent != child->runtime_extent ||
+        child->holder != child->runtime_holder || !child->runtime_base ||
+        child->runtime_extent < sizeof(void *) ||
+        child->runtime_extent > UINTPTR_MAX - child->runtime_base ||
+        field < child->runtime_base || field % _Alignof(void *) ||
+        field - child->runtime_base > child->runtime_extent - sizeof(void *)) {
+        return -ESTALE;
+    }
