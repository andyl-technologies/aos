+static inline bool acpi_ged_fingerprint_validate(
+    const AcpiGedState *state, bool cpu_hotplug_present, Error **errp)
+{
+    const MemHotplugState *memory = &state->memhp_state;
+    const CPUHotplugState *cpus = &state->cpuhp_state;
+
+    if (!acpi_ged_pci_hotplug_fingerprint_validate(
+            &state->pcihp_state, errp)) {
+        return false;
+    }
+    if (memory->dev_count > ACPI_MAX_RAM_SLOTS ||
+        (memory->dev_count != 0 && !memory->devs) ||
+        cpus->dev_count > 4096 ||
+        (cpu_hotplug_present && cpus->dev_count != 0 && !cpus->devs)) {
+        error_setg(errp, "ACPI GED fingerprint has invalid hotplug geometry");
+        return false;
+    }
+
+    for (uint32_t i = 0; i < memory->dev_count; i++) {
+        if (memory->devs[i].is_removing) {
+            error_setg(errp,
+                       "ACPI GED cannot restore a pending memory removal");
+            return false;
+        }
+    }
+    if (cpu_hotplug_present) {
+        for (uint32_t i = 0; i < cpus->dev_count; i++) {
+            if (cpus->devs[i].fw_remove) {
+                error_setg(errp,
+                           "ACPI GED cannot restore a pending firmware CPU "
+                           "removal");
+                return false;
+            }
+        }
+    }
+
+    return true;
+}
+
+static inline bool acpi_ged_state_fingerprint_projection(
+    QEMUFile *f, const AcpiGedState *state, bool cpu_hotplug_present,
+    Error **errp)
+{
+    const MemHotplugState *memory = &state->memhp_state;
+    const CPUHotplugState *cpus = &state->cpuhp_state;
+    const AcpiPciHpState *pci = &state->pcihp_state;
+    bool ghes_present = state->ghes_state.hw_error_le != 0;
+    bool pci_hotplug_present = pci->use_acpi_hotplug_bridge;
+    bool hest_present = state->ghes_state.hest_addr_le != 0;
+
+    if (!acpi_ged_fingerprint_validate(state, cpu_hotplug_present, errp)) {
+        return false;
+    }
+
+    qemu_put_be32(f, state->ged_state.sel);
+    qemu_put_be32(f, memory->selector);
+    qemu_put_be32(f, memory->dev_count);
+    for (uint32_t i = 0; i < memory->dev_count; i++) {
+        const MemStatus *status = &memory->devs[i];
+
+        qemu_put_byte(f, status->is_enabled);
+        qemu_put_byte(f, status->is_inserting);
+        qemu_put_be32(f, status->ost_event);
+        qemu_put_be32(f, status->ost_status);
+    }
+
+    qemu_put_byte(f, cpu_hotplug_present);
+    if (cpu_hotplug_present) {
+        qemu_put_be32(f, cpus->selector);
+        qemu_put_byte(f, cpus->command);
+        qemu_put_be32(f, cpus->dev_count);
+        for (uint32_t i = 0; i < cpus->dev_count; i++) {
+            const AcpiCpuStatus *status = &cpus->devs[i];
+
+            qemu_put_byte(f, status->is_inserting);
+            qemu_put_byte(f, status->is_removing);
+            qemu_put_be32(f, status->ost_event);
+            qemu_put_be32(f, status->ost_status);
+        }
+    }
+
+    qemu_put_byte(f, ghes_present);
+    if (ghes_present) {
+        qemu_put_be64(f, state->ghes_state.hw_error_le);
+    }
+    qemu_put_byte(f, pci_hotplug_present);
+    if (pci_hotplug_present) {
+        qemu_put_be32(f, pci->hotplug_select);
+        for (size_t i = 0; i < ARRAY_SIZE(pci->acpi_pcihp_pci_status); i++) {
+            qemu_put_be32(f, pci->acpi_pcihp_pci_status[i].up);
+        }
+        qemu_put_be32(f, pci->acpi_index);
+    }
+    qemu_put_byte(f, hest_present);
+    if (hest_present) {
+        qemu_put_be64(f, state->ghes_state.hest_addr_le);
+    }
+
+    return true;
+}
+
+#endif
