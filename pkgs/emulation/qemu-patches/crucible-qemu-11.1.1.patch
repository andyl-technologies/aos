+static bool GRAPH_RDLOCK raw_crucible_hot_fork_file(
+    BlockDriverState *bs, BdrvCrucibleHotForkFileAction action,
+    BdrvCrucibleHotForkFileState *state, Error **errp)
+{
+    BDRVRawState *s = bs->opaque;
+    struct stat metadata;
+    int flags = -1;
+    int stat_result = -1;
+    int stat_errno = EBADF;
+
+    GLOBAL_STATE_CODE();
+    if (s->fd >= 0) {
+        stat_result = fstat(s->fd, &metadata);
+        stat_errno = stat_result < 0 ? errno : 0;
+    }
+    if (s->fd < 0 || s->reopen_state || s->perm_change_fd ||
+        stat_result < 0 || !S_ISREG(metadata.st_mode) ||
+        (flags = fcntl(s->fd, F_GETFL)) < 0) {
+        /*
+         * A fork child reads this on its diagnostics stream, so it names
+         * which of the settled-descriptor conditions the node failed.
+         */
+        error_setg(errp,
+                   "Crucible source node %s requires a settled regular-file "
+                   "descriptor (fd %d, reopen %d, perm-change %d, fstat %s, "
+                   "regular %d, flags %d)",
+                   bdrv_get_node_name(bs), s->fd, s->reopen_state != NULL,
+                   s->perm_change_fd,
+                   stat_result < 0 ? strerror(stat_errno) : "ok",
+                   stat_result == 0 && S_ISREG(metadata.st_mode), flags);
+        return false;
+    }
+    switch (action) {
+    case BDRV_CRUCIBLE_HOT_FORK_FILE_PIN:
+        if ((s->crucible_source_pins || s->crucible_child_descriptor) &&
+            s->crucible_source_owner != getpid()) {
+            error_setg(errp, "Crucible file pin requires current source custody");
+            return false;
+        }
+        if (s->crucible_source_pins == UINT_MAX) {
+            error_setg(errp, "Crucible file source pin count is exhausted");
+            return false;
+        }
+        if (!s->crucible_source_pins) {
+            s->crucible_source_owner = getpid();
+        }
+        s->crucible_source_pins++;
+        break;
+    case BDRV_CRUCIBLE_HOT_FORK_FILE_UNPIN:
+        if (!s->crucible_source_pins) {
+            error_setg(errp, "Crucible file source has no retained pin");
+            return false;
+        }
+        s->crucible_source_pins--;
+        break;
+    case BDRV_CRUCIBLE_HOT_FORK_FILE_QUERY:
+        break;
+    default:
+        error_setg(errp, "Invalid Crucible file source action");
+        return false;
+    }
+    *state = (BdrvCrucibleHotForkFileState) {
+        .device = metadata.st_dev,
+        .inode = metadata.st_ino,
+        .descriptor = s->fd,
+        .flags = flags,
+        .read_only = (flags & O_ACCMODE) == O_RDONLY,
+    };
+    return true;
+}
