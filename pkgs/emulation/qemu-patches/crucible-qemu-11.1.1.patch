+static bool ram_control_wait_pause_held(QemuCrucibleRamControlActor *actor,
+                                        QemuCrucibleRamActorPause *pause)
+{
+    /* Exact inline nominal pause journals were published only by the actual
+     * native collector/request issuer. A naked idle/requested bool is not proof. */
+    return (pause == &actor->pause || pause == &actor->request_pause) &&
+        pause->requested && pause->actor == actor &&
+        pause->process == getpid() && pause->owner_thread &&
+        pause->binding == actor->thread_binding && pause->thread_id == actor->thread_id &&
+        pause->service_generation == actor->service_generation &&
+        (pause == &actor->pause || pause->request);
+}
