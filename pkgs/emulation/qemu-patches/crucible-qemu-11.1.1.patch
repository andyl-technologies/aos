+int qemu_crucible_checkpoint_candidate_begin_v1(
+    int cancellation_fd, QemuCrucibleCheckpointHeldTransaction **out)
+{
+    QemuCrucibleCheckpointHeldTransaction *owner = &checkpoint_transaction;
+    uint64_t device, inode, event_id;
+    int status;
+
+    if (!out) {
+        return -EINVAL;
+    }
+    if (!qatomic_load_acquire(&owner->published)) {
+        return -ENOKEY;
+    }
+    status = checkpoint_identity(owner);
+    if (status || !owner->request->main_scope_active ||
+        !owner->request->provider_acquired ||
+        cancellation_fd == owner->cancellation_fd || owner->candidate_started ||
+        !owner->capture_alias_moved || owner->capture_alias_attempted != 7) {
+        return status ? status : -EPERM;
+    }
+    /* A genuine retained Main request scope spans this candidate entry.
+     * Matching digests or a paused counter cannot create that scope.
+     */
+    owner->candidate_started = true;
+    *out = owner;
+    status = qemu_crucible_received_cancellation_observe_v1(
+        cancellation_fd, &owner->metadata_fd, &owner->metadata_close_uncertain,
+        &owner->post_status, &device, &inode, &event_id);
+    if (!status && (device != owner->request->cancellation_device ||
+                    inode != owner->request->cancellation_inode ||
+                    event_id != owner->request->cancellation_event_id)) {
+        status = -ESTALE;
+    }
+    if (!status && !owner->stopped) {
+        status = qemu_crucible_checkpoint_bind_stop_v1(owner);
+    } else if (!status &&
+               (!qatomic_load_acquire(&checkpoint_stop_owner.published) ||
+                checkpoint_stop_owner.transaction != owner ||
+                checkpoint_stop_owner.completed_generation != owner->stopped_generation ||
+                owner->stopped_generation != qemu_plugin_crucible_vmstop_generation())) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        status = checkpoint_provider_check_main(owner->request);
+    }
+    if (!status && (owner->prepare_called || owner->pager_held ||
+                    owner->proof.retained || owner->mailbox_detached)) {
+        status = -EBUSY;
+    }
+    if (status) {
+        checkpoint_fail(owner, status, false);
+    }
+    return status;
+}
