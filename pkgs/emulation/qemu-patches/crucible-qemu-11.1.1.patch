+    }
+    /* A retained ordinary/cleanup or construction owner keeps its own native
+     * epoch. The already-born Receiving child can post/end a refused admission
+     * without borrowing that old Original or changing its physical custody. */
+    if (borrow->held || startup_source.standing.operation.held ||
+        startup_source.standing.cleanup_execution || startup_source.standing.cleanup_holder ||
+        startup_source.standing.construction.operation.held) {
+        return -EBUSY;
+    }
+    status = qemu_crucible_checkpoint_inventory_metadata_identity_v1(loan, &pager);
+    if (!status) {
+        status = qemu_crucible_checkpoint_inventory_metadata_holder_current_v1(loan, out);
+    }
+    if (status) {
+        return status;
+    }
+    if (!qemu_crucible_checkpoint_pager_binding_current(&pager) ||
+        pager.installer.ctx != startup_source.saved.ctx ||
+        pager.installer.module != startup_source.saved.module ||
+        pager.installer.install != startup_source.saved.install ||
+        pager.installer.plugin_id != startup_source.saved.plugin_id ||
