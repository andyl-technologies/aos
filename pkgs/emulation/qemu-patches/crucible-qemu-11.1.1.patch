+            return true;
+        }
+        status = qemu_crucible_qmp_allocation_observe(*obj, &owner, &extent);
+        if (!status && (owner != dv->source_owner || extent != unused)) {
+            status = -ESTALE;
+        }
+        dealloc_source_result(dv, status);
+        return !status;
+    }
     return true;
 }
 
 static void qapi_dealloc_end_struct(Visitor *v, void **obj)
 {
+    if (to_qdv(v)->source) {
+        dealloc_source_free(v, obj);
+        return;
+    }
+
     if (obj) {
         g_free(*obj);
     }
 }
 
