+static void scenario_metadata_return_dirty_phase(void)
+{
+    QemuCrucibleMetadataBirthLoan birth = { 0 };
+    DirtyMemoryBlocks *blocks;
+    DirtyMemoryRetirement *state = &ram_list.dirty_retirement;
+    uint64_t live;
+
+    fixture_inventory_purpose();
+    qemu_mutex_init(&ram_list.mutex);
+    g_assert_cmpint(qemu_crucible_startup_source_ram_dirty_birth_begin(
+                       sizeof(*blocks), &birth), ==, 0);
+    blocks = g_new0(DirtyMemoryBlocks, 1);
+    blocks->allocation_bytes = sizeof(*blocks);
+    blocks->phase = DIRTY_HEADER_ACTIVE;
+    blocks->client = DIRTY_MEMORY_CRUCIBLE_RAM;
+    state->owners = blocks;
+    crucible_ram_metadata_birth_transfer(&birth, &blocks->metadata_owner,
+                                         blocks, sizeof(*blocks));
+    g_assert_cmpint(qemu_crucible_startup_source_ram_metadata_birth_finish(
+                       &birth), ==, 0);
+    live = startup_source.metadata_partition.native_live;
+
+    g_assert_cmpint(qemu_crucible_ram_return_prepare(
+                       &blocks->metadata_owner, &state->returned), ==, -ESTALE);
+    blocks->phase = DIRTY_HEADER_QUEUED;
+    g_assert_cmpint(qemu_crucible_ram_return_prepare(
+                       &blocks->metadata_owner, &state->returned), ==, -ESTALE);
+    /* Modeled uncertainty can refuse, never prove a completed callback/free. */
+    state->returned.phase = RAM_RETURN_FREE_STARTED;
+    g_assert_cmpint(qemu_crucible_ram_return_prepare(
+                       &blocks->metadata_owner, &state->returned), ==, -EBUSY);
+    g_assert_cmpint(qemu_crucible_ram_dirty_retirement_continue(), ==, -EINPROGRESS);
+    g_assert_true(state->owners == blocks);
+    g_assert_null(state->ready_head);
+    g_assert_null(state->ready_tail);
+    g_assert_true(blocks->metadata_owner.admission.charge.held);
+    g_assert_cmpuint(blocks->metadata_owner.returning, ==, 0);
+    g_assert_cmpuint(startup_source.metadata_partition.native_live, ==, live);
+    /* Body and debt stay owned until process exit. No test sets a positive
+     * grace-complete phase or treats an RCU drain as physical settlement. */
+}
