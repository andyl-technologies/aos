+void qemu_plugin_register_blk_cb(qemu_plugin_blk_submit_cb_t submit_cb,
+                                 qemu_plugin_blk_poll_cb_t poll_cb,
+                                 void *userdata)
+{
+#ifdef CONFIG_PLUGIN
+    QemuCrucibleNativeGroupRegistrar registrar;
+    QemuCrucibleNativeGroupDescriptorView actual;
+    const QemuCrucibleNativeGroupDescriptorView expected[] = {
+        {
+            .coordinate = &crucible_blk_submit_cb,
+            .function = submit_cb,
+            .userdata = userdata,
+            .userdata_coordinate = &crucible_blk_userdata,
+            .kind = QEMU_CRUCIBLE_NATIVE_REGISTERED,
+        },
+        {
+            .coordinate = &crucible_blk_poll_cb,
+            .function = poll_cb,
+            .userdata = userdata,
+            .userdata_coordinate = &crucible_blk_userdata,
+            .kind = QEMU_CRUCIBLE_NATIVE_REGISTERED,
+        },
+    };
+
+    if (qemu_plugin_crucible_native_group_begin_v1(
+            QEMU_CRUCIBLE_NATIVE_GROUP_BLOCK_IO, expected, ARRAY_SIZE(expected),
+            &registrar) ||
+        qemu_plugin_crucible_native_group_effect_begin_v1(&registrar)) {
+        qemu_plugin_crucible_native_group_finish_v1(&registrar);
+        return;
+    }
