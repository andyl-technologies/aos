index 0000000000000000000000000000000000000000..387a4be7096bbc4208a63d0a84db7473b302dbc9
--- /dev/null
+++ b/tests/unit/test-crucible-apic-timer-wide-clock.c
@@ -0,0 +1,681 @@
+/*
+ * Literal APIC clock arithmetic and migration with a diagnostic clock.
+ * QOM registration, IRQ delivery and fault-service authority are excluded.
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+#include "qemu/osdep.h"
+#include "qemu/module.h"
+#include "qemu/main-loop.h"
+#include "system/cpu-timers.h"
+#include "io/channel-buffer.h"
+#include "../../migration/qemu-file.h"
+#include "migration/savevm.h"
+
+/* Retain the whole production body for dependency/compile checks, while the
+ * fixture does not register or claim a realized APIC/CPU class hierarchy.
+ */
+#undef type_init
+#define type_init(function) \
+    static void *const excluded_##function __attribute__((unused)) = function;
+#include "../../hw/intc/apic_common.c"
+
+static __int128 observed_ps;
+static unsigned fired;
+
+int64_t cpu_get_clock(void)
+{
+    g_assert_true(observed_ps / 1000 <= INT64_MAX);
+    g_assert_true(observed_ps / 1000 >= INT64_MIN);
+    return observed_ps / 1000;
+}
+
+static __int128 observed_clock_ps(void)
+{
+    return observed_ps;
+}
+
+static void timer_consumer(void *opaque)
+{
+    fired++;
+}
+
+static __int128 coordinate(int64_t hi, uint64_t lo)
+{
+    return (__int128)hi * ((__int128)1 << 64) + lo;
+}
+
+static void initialize_timer(APICCommonState *state)
+{
+    memset(state, 0, sizeof(*state));
+    state->initial_count = 6;
+    state->lvt[APIC_LVT_TIMER] = APIC_LVT_TIMER_PERIODIC;
+    state->timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, timer_consumer, state);
+}
+
+static void destroy_timer(APICCommonState *state)
+{
+    timer_free(state->timer);
+}
+
+/* The timer fields and exact subsection use production hooks. Other APIC
+ * registers, QOM class callbacks and architectural delivery are excluded.
+ */
+static int timer_fixture_pre_load(void *opaque)
+{
+    apic_timer_wide_pre_load(opaque);
+    return 0;
+}
+
+static int timer_fixture_post_load(void *opaque, int version)
+{
+    APICCommonState *state = opaque;
+    int status = apic_timer_validate_load(state);
+
+    if (!status) {
+        apic_timer_restore(state);
+    }
+    return status;
+}
+
+static const VMStateDescription timer_fixture = {
+    .name = "apic",
+    .version_id = 3,
+    .minimum_version_id = 3,
+    .pre_save = apic_timer_wide_pre_save,
+    .pre_load = timer_fixture_pre_load,
+    .post_load = timer_fixture_post_load,
+    .fields = (const VMStateField[]) {
+        VMSTATE_INT32(count_shift, APICCommonState),
+        VMSTATE_UINT32(initial_count, APICCommonState),
+        VMSTATE_UINT32_ARRAY(lvt, APICCommonState, APIC_LVT_NB),
+        VMSTATE_INT64(initial_count_load_time, APICCommonState),
+        VMSTATE_INT64(next_time, APICCommonState),
+        VMSTATE_INT64(timer_expiry, APICCommonState),
+        VMSTATE_END_OF_LIST(),
+    },
+    .subsections = (const VMStateDescription *const[]) {
+        &vmstate_apic_timer_wide,
+        NULL,
+    },
+};
+
+static GByteArray *save_state(APICCommonState *state)
+{
+    QIOChannelBuffer *output = qio_channel_buffer_new(4096);
+    QEMUFile *file = qemu_file_new_output(QIO_CHANNEL(output));
+    GByteArray *bytes = g_byte_array_new();
+    Error *error = NULL;
+
+    g_assert_cmpint(vmstate_save_state(file, &timer_fixture, state, NULL,
+                                      &error), ==, 0);
+    g_assert_null(error);
+    qemu_put_byte(file, QEMU_VM_EOF);
+    g_assert_cmpint(qemu_fflush(file), ==, 0);
+    g_byte_array_append(bytes, output->data, output->usage);
+    g_assert_cmpint(qemu_fclose(file), ==, 0);
+    object_unref(OBJECT(output));
+    return bytes;
+}
+
+static int load_state(APICCommonState *state, GByteArray *bytes)
+{
+    QIOChannelBuffer *input = qio_channel_buffer_new(bytes->len);
+    QEMUFile *file;
+    int status;
+
+    memcpy(input->data, bytes->data, bytes->len);
+    input->usage = bytes->len;
+    file = qemu_file_new_input(QIO_CHANNEL(input));
+    status = vmstate_load_state(file, &timer_fixture, state, 3, NULL);
+    qemu_fclose(file);
+    object_unref(OBJECT(input));
+    return status;
+}
+
+static void assert_coordinate(__int128 actual, __int128 expected)
+{
+    g_assert_cmpint((int64_t)(actual >> 64), ==, (int64_t)(expected >> 64));
+    g_assert_cmpuint((uint64_t)actual, ==, (uint64_t)expected);
+}
+
+static const struct {
+    int64_t origin_hi;
+    uint64_t origin_lo;
+    int64_t now_hi;
+    uint64_t now_lo;
+    uint32_t count;
+    int shift;
+    uint32_t expected;
+} counter_vectors[] = {
+    {
+        0, UINT64_C(0),
+        72057594037927936, UINT64_C(357),
+        UINT32_C(6), 0, 5,
+    },
+    {
+        -72057594037927936, UINT64_C(719),
+        72057594037927936, UINT64_C(357),
+        UINT32_C(10), 7, 5,
+    },
+    {
+        INT64_MIN, UINT64_C(0),
+        9223372036854775807, UINT64_C(18446744073709551615),
+        UINT32_C(4294967295), 7, 3813930958,
+    },
+    {
+        -1, UINT64_C(18446744073709551615),
+        0, UINT64_C(0),
+        UINT32_C(2), 0, 2,
+    },
+    {
+        0, UINT64_C(357),
+        0, UINT64_C(357),
+        UINT32_C(7), 0, 7,
+    },
+    {
+        0, UINT64_C(357),
+        0, UINT64_C(10357),
+        UINT32_C(7), 0, 5,
+    },
+    {
+        0, UINT64_C(357),
+        0, UINT64_C(20357),
+        UINT32_C(7), 0, 3,
+    },
+    {
+        72057594037927936, UINT64_C(357),
+        72057594037927936, UINT64_C(8357),
+        UINT32_C(6), 0, 5,
+    },
+    {
+        -72057594037927936, UINT64_C(357),
+        -72057594037927936, UINT64_C(8357),
+        UINT32_C(6), 0, 5,
+    },
+    {
+        INT64_MIN, UINT64_C(0),
+        INT64_MIN, UINT64_C(128000),
+        UINT32_C(4), 7, 3,
+    },
+    {
+        9223372036854775807, UINT64_C(18446744073709551615),
+        9223372036854775807, UINT64_C(18446744073709551615),
+        UINT32_C(31), 0, 31,
+    },
+    {
+        9223372036854775807, UINT64_C(18446744073709351616),
+        9223372036854775807, UINT64_C(18446744073709451616),
+        UINT32_C(31), 0, 27,
+    },
+};
+
+static void test_count(gconstpointer opaque)
+{
+    unsigned index = GPOINTER_TO_UINT(opaque);
+    APICCommonState state = { 0 };
+
+    state.initial_count_load_ps = coordinate(counter_vectors[index].origin_hi,
+                                              counter_vectors[index].origin_lo);
+    state.initial_count = counter_vectors[index].count;
+    state.count_shift = counter_vectors[index].shift;
+    state.lvt[APIC_LVT_TIMER] = APIC_LVT_TIMER_PERIODIC;
+
+    g_assert_cmpuint(apic_current_count_at_ps(
+                         &state, coordinate(counter_vectors[index].now_hi,
+                                             counter_vectors[index].now_lo)),
+                     ==, counter_vectors[index].expected);
+}
+
+static void test_schedule(gconstpointer opaque)
+{
+    unsigned index = GPOINTER_TO_UINT(opaque);
+    APICCommonState state = { 0 };
+    __int128 now, expected;
+
+    state.initial_count = 6;
+    state.lvt[APIC_LVT_TIMER] = APIC_LVT_TIMER_PERIODIC;
+    switch (index) {
+    case 0:
+        state.initial_count_load_ps = 0;
+        now = ((__int128)1 << 120) + 357;
+        expected = coordinate(INT64_C(72057594037927936), UINT64_C(5424));
+        break;
+    case 1:
+        state.initial_count_load_ps = -((__int128)1 << 120) + 357;
+        now = state.initial_count_load_ps + 8000;
+        expected = state.initial_count_load_ps + 14000;
+        break;
+    case 2:
+        state.initial_count_load_ps = coordinate(INT64_MIN, 0);
+        now = coordinate(INT64_MAX, UINT64_MAX) - 10000;
+        expected = now + 5545;
+        break;
+    case 3:
+        apic_timer_set_origin(&state, ((__int128)1 << 120) + 357);
+        now = state.initial_count_load_ps;
+        expected = now + 7000;
+        break;
+    case 4:
+        state.initial_count_load_ps = -7001;
+        now = -7001;
+        expected = -1;
+        break;
+    default:
+        state.initial_count_load_ps = 357;
+        now = 5357;
+        state.lvt[APIC_LVT_TIMER] = 0;
+        expected = 7357;
+        break;
+    }
+
+    g_assert_true(apic_next_timer_ps(&state, now));
+    assert_coordinate(state.next_time_ps, expected);
+}
+
+static void test_stopped(gconstpointer opaque)
+{
+    APICCommonState state = { 0 };
+    unsigned index = GPOINTER_TO_UINT(opaque);
+
+    state.initial_count = index == 1 ? 0 : 6;
+    state.lvt[APIC_LVT_TIMER] = index == 0 ? APIC_LVT_MASKED :
+                               index == 1 ? APIC_LVT_TIMER_PERIODIC : 0;
+    state.initial_count_load_ps = -((__int128)1 << 120);
+
+    g_assert_false(apic_next_timer_ps(&state, state.initial_count_load_ps + 6000));
+    g_assert_cmpint(state.timer_expiry, ==, -1);
+    g_assert_cmpuint(apic_current_count_at_ps(&state,
+                                            state.initial_count_load_ps + 6000),
+                     ==, 0);
+}
+
+static void test_round_trip(gconstpointer opaque)
+{
+    unsigned index = GPOINTER_TO_UINT(opaque);
+    const __int128 deadlines[] = {
+        ((__int128)1 << 120) + 357,
+        -((__int128)1 << 120) + 357,
+        coordinate(INT64_MIN, 0),
+        coordinate(INT64_MAX, UINT64_MAX),
+        -1, 0, 999, 1000,
+    };
+    APICCommonState source, destination;
+    GByteArray *bytes;
+    bool active = index < ARRAY_SIZE(deadlines);
+    __int128 deadline = active ? deadlines[index] : 0;
+
+    initialize_timer(&source);
+    initialize_timer(&destination);
+    source.initial_count_load_ps = deadline;
+    source.next_time_ps = deadline;
+    if (active) {
+        timer_mod_ps_wide(source.timer, deadline);
+    }
+    bytes = save_state(&source);
+    timer_mod_ps_wide(destination.timer, 1);
+
+    g_assert_cmpint(load_state(&destination, bytes), ==, 0);
+    assert_coordinate(destination.initial_count_load_ps, deadline);
+    assert_coordinate(destination.next_time_ps, deadline);
+    g_assert_cmpint(timer_pending(destination.timer), ==, active);
+    if (active) {
+        assert_coordinate(timer_expire_time_ps_wide(destination.timer), deadline);
+    }
+
+    g_byte_array_unref(bytes);
+    destroy_timer(&source);
+    destroy_timer(&destination);
+}
+
+static size_t section_offset(GByteArray *bytes)
+{
+    const char *name = "apic/timer-wide";
+
+    for (size_t index = 0; index + strlen(name) < bytes->len; index++) {
+        if (!memcmp(bytes->data + index, name, strlen(name))) {
+            g_assert_cmpint(bytes->data[index - 1], ==, strlen(name));
+            return index - 2;
+        }
+    }
+    g_assert_not_reached();
+}
+
+static void test_malformed(gconstpointer opaque)
+{
+    unsigned index = GPOINTER_TO_UINT(opaque);
+    APICCommonState source, destination;
+    GByteArray *bytes;
+    size_t section, payload;
+
+    initialize_timer(&source);
+    initialize_timer(&destination);
+    source.initial_count_load_ps = 357;
+    source.next_time_ps = 7357;
+    timer_mod_ps_wide(source.timer, 7357);
+    bytes = save_state(&source);
+    section = section_offset(bytes);
+    payload = section + 2 + strlen("apic/timer-wide") + 4;
+
+    switch (index) {
+    case 0:
+        g_byte_array_set_size(bytes, section + 1);
+        bytes->data[section] = QEMU_VM_EOF;
+        break;
+    case 1:
+        bytes->data[payload] = 2;
+        break;
+    case 2:
+        bytes->data[payload + 1] = 2;
+        break;
+    case 3:
+        bytes->data[payload + 1] = 0;
+        break;
+    case 4:
+        bytes->data[payload - 1] = 2;
+        break;
+    case 5: {
+        GByteArray *duplicate = g_byte_array_new();
+
+        g_byte_array_append(duplicate, bytes->data + section,
+                             bytes->len - section - 1);
+        g_byte_array_set_size(bytes, bytes->len - 1);
+        g_byte_array_append(bytes, duplicate->data, duplicate->len);
+        g_byte_array_append(bytes, (const uint8_t[]){ QEMU_VM_EOF }, 1);
+        g_byte_array_unref(duplicate);
+        break;
+    }
+    case 6:
+        g_byte_array_set_size(bytes, payload + 15);
+        break;
+    case 7:
+        bytes->data[0] = 0xff;
+        break;
+    case 8:
+        memset(bytes->data + 4, 0, 4);
+        break;
+    case 9:
+        bytes->data[8] = 0;
+        bytes->data[9] = 1;
+        break;
+    case 10:
+        bytes->data[payload] = 0;
+        break;
+    case 11:
+        bytes->data[section + 2 + strlen("apic/")] = 'x';
+        break;
+    default: {
+        const char *legacy_name = "apic/crucible-clock";
+        GByteArray *legacy = g_byte_array_new();
+        uint8_t header[] = { QEMU_VM_SUBSECTION, strlen(legacy_name) };
+
+        g_byte_array_append(legacy, bytes->data, section);
+        g_byte_array_append(legacy, header, sizeof(header));
+        g_byte_array_append(legacy, (const uint8_t *)legacy_name,
+                             strlen(legacy_name));
+        g_byte_array_append(legacy, bytes->data + payload - 4,
+                             bytes->len - payload + 4);
+        g_byte_array_unref(bytes);
+        bytes = legacy;
+        break;
+    }
+    }
+    timer_mod_ps_wide(destination.timer, 1);
+
+    g_assert_cmpint(load_state(&destination, bytes), <, 0);
+    g_assert_false(timer_pending(destination.timer));
+
+    g_byte_array_unref(bytes);
+    destroy_timer(&source);
+    destroy_timer(&destination);
+}
+
+static void test_overflow(void)
+{
+    if (g_test_subprocess()) {
+        APICCommonState state = { 0 };
+
+        state.initial_count = 6;
+        state.lvt[APIC_LVT_TIMER] = APIC_LVT_TIMER_PERIODIC;
+        state.initial_count_load_ps = coordinate(INT64_MAX, UINT64_MAX);
+        apic_next_timer_ps(&state, state.initial_count_load_ps);
+        g_assert_not_reached();
+    }
+    g_test_trap_subprocess(NULL, 0, 0);
+    g_test_trap_assert_failed();
+    g_test_trap_assert_stderr("*exceeds signed128*");
+}
+
+static void test_timer_callback(void)
+{
+    APICCommonState source, destination;
+    GByteArray *bytes;
+
+    initialize_timer(&source);
+    initialize_timer(&destination);
+    source.initial_count_load_ps = -7001;
+    source.next_time_ps = -1;
+    timer_mod_ps_wide(source.timer, -1);
+    bytes = save_state(&source);
+    timer_del(source.timer);
+    observed_ps = 0;
+    fired = 0;
+
+    g_assert_cmpint(load_state(&destination, bytes), ==, 0);
+    qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL);
+    g_assert_cmpuint(fired, ==, 1);
+    g_assert_false(timer_pending(destination.timer));
+
+    g_byte_array_unref(bytes);
+    destroy_timer(&source);
+    destroy_timer(&destination);
+}
+
+static void test_ordinary(void)
+{
+    if (g_test_subprocess()) {
+        APICCommonState state;
+        APICCommonState restored;
+        GByteArray *bytes;
+
+        initialize_timer(&state);
+        initialize_timer(&restored);
+        apic_timer_set_origin(&state, 357);
+        g_assert_true(apic_next_timer(&state, 357));
+        g_assert_cmpint(state.next_time, ==, 364);
+        state.crucible_timer_arm_sequence = 1;
+        timer_mod(state.timer, 364);
+        bytes = save_state(&state);
+
+        g_assert_cmpint(load_state(&restored, bytes), ==, 0);
+        g_assert_cmpint(restored.initial_count_load_time, ==, 357);
+        g_assert_cmpint(timer_expire_time_ns(restored.timer), ==, 364);
+
+        g_byte_array_unref(bytes);
+        destroy_timer(&state);
+        destroy_timer(&restored);
+        return;
+    }
+    g_setenv("APIC_TIMER_ORDINARY", "1", true);
+    g_test_trap_subprocess(NULL, 0, 0);
+    g_unsetenv("APIC_TIMER_ORDINARY");
+    g_test_trap_assert_passed();
+}
+
+static void test_cross_mode(gconstpointer opaque)
+{
+    unsigned index = GPOINTER_TO_UINT(opaque);
+    APICCommonState state;
+    GByteArray *bytes;
+
+    initialize_timer(&state);
+    if (g_test_subprocess()) {
+        gchar *contents = NULL;
+        gsize length = 0;
+        int status;
+        bool succeeds = index == 0 || index == 1 || index == 4 || index == 7;
+
+        g_assert_true(g_file_get_contents(g_getenv("APIC_TIMER_PAYLOAD"),
+                                         &contents, &length, NULL));
+        bytes = g_byte_array_new_take((uint8_t *)contents, length);
+        status = load_state(&state, bytes);
+        if (succeeds) {
+            g_assert_cmpint(status, ==, 0);
+            g_assert_cmpint(timer_pending(state.timer), ==, index != 4);
+            if (index != 4) {
+                int64_t expected = index == 0 ? 124 :
+                                   index == 1 ? 0 : INT64_MAX;
+
+                g_assert_cmpint(timer_expire_time_ns(state.timer), ==, expected);
+            }
+        } else {
+            g_assert_cmpint(status, <, 0);
+            g_assert_false(timer_pending(state.timer));
+        }
+        g_byte_array_unref(bytes);
+        destroy_timer(&state);
+        return;
+    }
+
+    state.initial_count_load_ps = 100357;
+    state.next_time_ps = 123457;
+    __int128 expiry = 123457;
+    switch (index) {
+    case 0:
+        break;
+    case 1:
+        state.initial_count_load_ps = -7001;
+        state.next_time_ps = -1;
+        expiry = -1;
+        break;
+    case 2:
+        state.initial_count_load_ps = ((__int128)1 << 120) + 357;
+        break;
+    case 3:
+        expiry = ((__int128)1 << 120) + 357;
+        break;
+    case 4:
+        break;
+    case 5:
+        state.initial_count_load_ps = -((__int128)1 << 120) + 357;
+        break;
+    case 6:
+        state.initial_count_load_ps = (__int128)INT64_MAX * 1000 + 1;
+        break;
+    default:
+        expiry = (__int128)INT64_MAX * 1000;
+        break;
+    }
+    if (index != 4) {
+        timer_mod_ps_wide(state.timer, expiry);
+    }
+    bytes = save_state(&state);
+    gchar *path = NULL;
+    int descriptor = g_file_open_tmp("apic-wide-import-XXXXXX", &path, NULL);
+
+    g_assert_cmpint(descriptor, >=, 0);
+    close(descriptor);
+    g_assert_true(g_file_set_contents(path, (const char *)bytes->data,
+                                     bytes->len, NULL));
+    g_setenv("APIC_TIMER_PAYLOAD", path, true);
+    g_setenv("APIC_TIMER_ORDINARY", "1", true);
+
+    g_test_trap_subprocess(NULL, 0, 0);
+    g_unsetenv("APIC_TIMER_ORDINARY");
+    g_unsetenv("APIC_TIMER_PAYLOAD");
+    unlink(path);
+    g_free(path);
+    g_byte_array_unref(bytes);
+    destroy_timer(&state);
+    g_test_trap_assert_passed();
+}
+
+static GByteArray *save_timer_fingerprint(APICCommonState *state)
+{
+    QIOChannelBuffer *output = qio_channel_buffer_new(4096);
+    QEMUFile *file = qemu_file_new_output(QIO_CHANNEL(output));
+    GByteArray *bytes = g_byte_array_new();
+
+    apic_timer_fingerprint(file, state);
+    g_assert_cmpint(qemu_fflush(file), ==, 0);
+    g_byte_array_append(bytes, output->data, output->usage);
+    qemu_fclose(file);
+    object_unref(OBJECT(output));
+    return bytes;
+}
+
+static void test_fingerprint(void)
+{
+    APICCommonState source;
+    GByteArray *first, *second;
+
+    initialize_timer(&source);
+    apic_timer_set_origin(&source, ((__int128)1 << 120) + 357);
+    source.next_time_ps = source.initial_count_load_ps + 7000;
+    timer_mod_ps_wide(source.timer, source.next_time_ps);
+    first = save_timer_fingerprint(&source);
+    source.initial_count_load_ps += (__int128)1 << 64;
+    second = save_timer_fingerprint(&source);
+
+    g_assert_cmpuint(first->len, ==, second->len);
+    g_assert_cmpint(memcmp(first->data, second->data, first->len), !=, 0);
+
+    g_byte_array_unref(first);
+    g_byte_array_unref(second);
+    destroy_timer(&source);
+}
+
+int main(int argc, char **argv)
+{
+    Error *error = NULL;
+
+    g_test_init(&argc, &argv, NULL);
+    module_call_init(MODULE_INIT_QOM);
+    qemu_init_main_loop(&error);
+    g_assert_null(error);
+    if (!g_getenv("APIC_TIMER_ORDINARY")) {
+        qemu_timer_enable_tcg_ps_clock(NULL, observed_clock_ps);
+    }
+    qemu_clock_enable(QEMU_CLOCK_VIRTUAL, true);
+
+    for (unsigned index = 0; index < ARRAY_SIZE(counter_vectors); index++) {
+        char *name = g_strdup_printf("/apic-wide/count/%u", index);
+
+        g_test_add_data_func(name, GUINT_TO_POINTER(index), test_count);
+        g_free(name);
+    }
+    for (unsigned index = 0; index < 6; index++) {
+        char *name = g_strdup_printf("/apic-wide/schedule/%u", index);
+
+        g_test_add_data_func(name, GUINT_TO_POINTER(index), test_schedule);
+        g_free(name);
+    }
+    for (unsigned index = 0; index < 3; index++) {
+        char *name = g_strdup_printf("/apic-wide/stopped/%u", index);
+
+        g_test_add_data_func(name, GUINT_TO_POINTER(index), test_stopped);
+        g_free(name);
+    }
+    for (unsigned index = 0; index < 9; index++) {
+        char *name = g_strdup_printf("/apic-wide/migration/%u", index);
+
+        g_test_add_data_func(name, GUINT_TO_POINTER(index), test_round_trip);
+        g_free(name);
+    }
+    for (unsigned index = 0; index < 13; index++) {
+        char *name = g_strdup_printf("/apic-wide/malformed/%u", index);
+
+        g_test_add_data_func(name, GUINT_TO_POINTER(index), test_malformed);
+        g_free(name);
+    }
+    for (unsigned index = 0; index < 8; index++) {
+        char *name = g_strdup_printf("/apic-wide/cross-mode/%u", index);
+
+        g_test_add_data_func(name, GUINT_TO_POINTER(index), test_cross_mode);
+        g_free(name);
+    }
+    g_test_add_func("/apic-wide/fingerprint", test_fingerprint);
+    g_test_add_func("/apic-wide/deadline-overflow", test_overflow);
+    g_test_add_func("/apic-wide/actual-timer-callback", test_timer_callback);
+    g_test_add_func("/apic-wide/ordinary", test_ordinary);
+    return g_test_run();
+}
