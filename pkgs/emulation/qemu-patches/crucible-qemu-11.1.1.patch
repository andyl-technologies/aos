+static int initial_register_workspace_dependencies_current(
+    QemuCrucibleInitialRegisterWorkspaceOwner *owner)
+{
+    QemuCrucibleRegisterWorkspaceLayout checked;
+    const QemuCrucibleRegisterWorkspaceSpan *span;
+    const QemuCrucibleRegisterCpuDependency *rows;
+    CPUState *cpu, *first = qemu_get_cpu(0);
+    CPUClass *first_class;
+    const char *model;
+    size_t count = 0, children = 0;
+    int status;
+
+    if (!first || owner->layout.geometry.cpu != first || !owner->charge.held ||
+        owner->charge.bytes != owner->layout.backing_bytes ||
+        !owner->mmap_attempted || !owner->mmap_returned || !owner->address ||
+        !crucible_register_workspace_layout(&owner->layout.geometry,
+            owner->layout.cpu_count, owner->layout.model_bytes,
+            owner->layout.page_bytes, &checked) ||
+        !crucible_register_workspace_equal(&owner->layout, &checked) ||
+        (uintptr_t)owner->address % checked.page_bytes ||
+        checked.backing_bytes > UINTPTR_MAX - (uintptr_t)owner->address) {
+        return -ESTALE;
+    }
+    span = &checked.part[CRUCIBLE_REGISTER_WORKSPACE_CPUS];
+    rows = (const void *)((const uint8_t *)owner->address + span->offset);
+    first_class = CPU_GET_CLASS(first);
+    model = object_get_typename(OBJECT(first));
+    if (!model || strlen(model) + 1 != checked.model_bytes ||
+        !current_machine || current_machine->smp.cpus != checked.cpu_count) {
+        return -ESTALE;
+    }
+    status = pthread_mutex_trylock(&startup_source.cpu_allocations.lock);
+    if (status) {
+        return -status;
+    }
+    CPU_FOREACH(cpu) {
+        QemuCrucibleCpuSourceAllocationOwner *actual = NULL;
+        QemuCrucibleCpuSourceAllocationOwner *child_owner = NULL;
+        Object *child = NULL;
+        CrucibleCPURegisterGeometry geometry;
+        CPUClass *cc = CPU_GET_CLASS(cpu);
+
+        if (count >= checked.cpu_count || cpu->cpu_index < 0 ||
+            (size_t)cpu->cpu_index != count || !cpu->created || !cpu->stopped ||
+            qatomic_read(&cpu->running) || cc != first_class ||
+            strcmp(object_get_typename(OBJECT(cpu)), model) ||
+            !cc->crucible_register_geometry ||
+            !cc->crucible_register_geometry(cpu, &geometry) ||
+            geometry.cpu != cpu ||
+            !initial_register_geometry_shape_matches(
+                &checked.geometry, &geometry)) {
+            status = -ESTALE;
+            break;
+        }
+        status = initial_register_cpu_owner_locked(cpu, &actual);
+        if (!status && (actual->register_workspace != owner ||
+            actual->binding != owner->account->binding ||
+            !actual->constructor_children ||
+            !initial_register_dependency_matches(&rows[count], cpu, actual,
+                object_get_instance_size(OBJECT(cpu))))) {
+            status = -ESTALE;
+        }
+        if (status) {
+            break;
+        }
+        status = initial_register_child_owner_locked(cpu, &child, &child_owner);
+        if (!status && (!initial_register_child_dependency_matches(
+                &rows[count], child, child_owner,
+                child ? object_get_instance_size(child) : 0) ||
+            (child && (child_owner->register_workspace != owner ||
+                child_owner->register_workspace_parent != cpu ||
+                child_owner->binding != owner->account->binding ||
+                !child_owner->constructor_children)))) {
+            status = -ESTALE;
+        }
+        if (status) {
+            break;
+        }
+        children += child != NULL;
+        count++;
+    }
+    if (!status && (!initial_register_cohort_complete(
+            count, checked.cpu_count, owner->pinned_cpus) ||
+        children != owner->pinned_children)) {
+        status = -ESTALE;
+    }
+    pthread_mutex_unlock(&startup_source.cpu_allocations.lock);
+    return status;
+}
