+/* Real inline futex helpers reach this deterministic scheduling endpoint. */
+static long fixture_futex_syscall(long number, ...)
+{
+    va_list arguments;
+    QemuEvent *ev;
+    int operation, expected;
+
+    g_assert_cmpint(number, ==, __NR_futex);
+    va_start(arguments, number);
+    ev = va_arg(arguments, void *);
+    operation = va_arg(arguments, int);
+    expected = va_arg(arguments, int);
+    va_end(arguments);
+    g_assert_true(ev == &rr_dispatch_ceiling_event);
+    if (operation == FUTEX_WAKE) {
+        g_assert_cmpint(expected, ==, INT_MAX);
+        g_assert_cmpuint(ev->value, ==, EV_SET);
+        wakeups++;
+        return 0;
+    }
+    g_assert_cmpint(operation, ==, FUTEX_WAIT);
+    g_assert_false(locked);
+    g_assert_false(rr_replay_mutex_owned);
+    g_assert_cmpuint((unsigned)expected, ==, (unsigned)EV_BUSY);
+    futex_waits++;
+    inject(AT_FUTEX);
+    if (qatomic_read(&ev->value) == EV_SET) {
+        return 0;
+    }
+    /* An unchanged BUSY event with no scheduled producer is a lost wake. */
+    if (!intentional_wait) {
+        blocked++;
+    }
+    qemu_event_set(ev);
+    return 0;
+}
