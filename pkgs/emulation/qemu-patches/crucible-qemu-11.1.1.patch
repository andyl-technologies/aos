+static void check_layout(size_t cpus, size_t model, size_t page)
+{
+    CrucibleCPURegisterGeometry input = geometry();
+    QemuCrucibleRegisterWorkspaceLayout layout, other;
+    size_t bytes[CRUCIBLE_REGISTER_WORKSPACE_PART_COUNT] = {
+        [CRUCIBLE_REGISTER_WORKSPACE_ROWS] = input.register_count *
+            sizeof(struct qemu_plugin_crucible_fault_register_capability),
+        [CRUCIBLE_REGISTER_WORKSPACE_TARGETS] = input.register_count *
+            sizeof(CrucibleRegisterTarget),
+        [CRUCIBLE_REGISTER_WORKSPACE_BINDINGS] = input.register_count *
+            sizeof(QemuCrucibleRegisterBinding),
+        [CRUCIBLE_REGISTER_WORKSPACE_NAME_INDEX] = input.register_count *
+            sizeof(const char *),
+        [CRUCIBLE_REGISTER_WORKSPACE_MODEL] = model,
+        [CRUCIBLE_REGISTER_WORKSPACE_NAMES] = input.name_bytes,
+        [CRUCIBLE_REGISTER_WORKSPACE_KEYS] = input.key_count * sizeof(uint32_t),
+        [CRUCIBLE_REGISTER_WORKSPACE_CANDIDATE] = sizeof(CrucibleCPURegisterCapability),
+        [CRUCIBLE_REGISTER_WORKSPACE_CANDIDATE_NAME] = input.max_name_bytes,
+        [CRUCIBLE_REGISTER_WORKSPACE_LOOKUP_KEYS] = input.key_count * sizeof(uint32_t),
+        [CRUCIBLE_REGISTER_WORKSPACE_CPUS] = cpus * sizeof(QemuCrucibleRegisterCpuDependency),
+        [CRUCIBLE_REGISTER_WORKSPACE_FINGERPRINT_SCRATCH] =
+            sizeof(QemuCrucibleRegisterFingerprintScratch),
+        [CRUCIBLE_REGISTER_WORKSPACE_FINGERPRINT_CPUS] =
+            cpus * sizeof(QemuCrucibleRegisterFingerprintCpu),
+    };
+
+    for (size_t i = CRUCIBLE_REGISTER_WORKSPACE_WRITABLE;
+         i <= CRUCIBLE_REGISTER_WORKSPACE_READ_ONLY; i++) {
+        bytes[i] = input.mask_bytes;
+    }
+    for (size_t i = CRUCIBLE_REGISTER_WORKSPACE_CANDIDATE_WRITABLE;
+         i <= CRUCIBLE_REGISTER_WORKSPACE_CANDIDATE_READ_ONLY; i++) {
+        bytes[i] = input.max_mask_bytes;
+    }
+    for (size_t i = CRUCIBLE_REGISTER_WORKSPACE_VALIDATION_DESIRED;
+         i < CRUCIBLE_REGISTER_WORKSPACE_FINGERPRINT_SCRATCH; i++) {
+        bytes[i] = input.max_mask_bytes;
+    }
+    assert(crucible_register_workspace_layout(&input, cpus, model, page, &layout));
+    assert(layout.backing_bytes >= layout.payload_bytes);
+    assert(layout.backing_bytes % page == 0);
+    assert(layout.backing_bytes - layout.payload_bytes < page);
+    assert(layout.cpu_count == cpus && layout.model_bytes == model);
+    for (size_t i = 0; i < CRUCIBLE_REGISTER_WORKSPACE_PART_COUNT; i++) {
+        QemuCrucibleRegisterWorkspaceSpan a = layout.part[i];
+
+        assert(a.bytes == bytes[i]);
+        assert(a.alignment && !(a.alignment & (a.alignment - 1)));
+        assert(a.offset % a.alignment == 0);
+        assert(a.offset <= layout.payload_bytes);
+        assert(a.bytes <= layout.payload_bytes - a.offset);
+        for (size_t j = i + 1; j < CRUCIBLE_REGISTER_WORKSPACE_PART_COUNT; j++) {
+            QemuCrucibleRegisterWorkspaceSpan b = layout.part[j];
+
+            assert(a.offset + a.bytes <= b.offset || b.offset + b.bytes <= a.offset);
+        }
+    }
+    other = layout;
+    assert(crucible_register_workspace_equal(&layout, &other));
+    for (size_t i = 0; i < CRUCIBLE_REGISTER_WORKSPACE_PART_COUNT; i++) {
+        other = layout;
+        other.part[i].bytes++;
+        assert(!crucible_register_workspace_equal(&layout, &other));
+    }
+    other = layout;
+    other.geometry.max_name_bytes++;
+    assert(!crucible_register_workspace_equal(&layout, &other));
+    other = layout;
+    other.geometry.max_mask_bytes++;
+    assert(!crucible_register_workspace_equal(&layout, &other));
+}
