+static bool frame_member_locked(QemuCrucibleNativeInvocationRegistry *registry,
+                                QemuCrucibleNativeInvocation *candidate)
+{
+    size_t i;
+
+    for (i = 0; i < ARRAY_SIZE(registry->frames); i++) {
+        if (candidate == &registry->frames[i]) {
+            return true;
+        }
+    }
+    return false;
