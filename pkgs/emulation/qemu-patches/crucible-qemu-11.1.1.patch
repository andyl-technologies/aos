+static bool rtc_crucible_scheduler_to_raw(
+    void *opaque, uint64_t scheduler_ps, uint64_t *raw_ps)
+{
+    MC146818RtcState *s = opaque;
+    __int128 seconds;
+    uint64_t phase;
+    __int128 epoch_ps = (__int128)s->crucible_epoch_ns * 1000;
+    __int128 epoch_seconds = rtc_div_floor(epoch_ps, PICOSECONDS_PER_SECOND);
+    __int128 raw_phase;
+    unsigned __int128 value;
+
+    if (scheduler_ps > INT64_MAX || rtc_clock != QEMU_CLOCK_VIRTUAL) {
+        return false;
+    }
+    rtc_guest_calendar_parts(s, scheduler_ps, &seconds, &phase);
+    raw_phase = (__int128)phase - epoch_ps % PICOSECONDS_PER_SECOND;
+    if (epoch_ps < 0 && epoch_ps % PICOSECONDS_PER_SECOND) {
+        raw_phase -= PICOSECONDS_PER_SECOND;
+    }
+    seconds += rtc_div_floor(raw_phase, PICOSECONDS_PER_SECOND) - epoch_seconds;
+    raw_phase %= PICOSECONDS_PER_SECOND;
+    if (raw_phase < 0) {
+        raw_phase += PICOSECONDS_PER_SECOND;
+    }
+    if (seconds < 0 || seconds > UINT64_MAX / PICOSECONDS_PER_SECOND) {
+        return false;
+    }
+    value = (unsigned __int128)seconds * PICOSECONDS_PER_SECOND + raw_phase;
+    if (value > UINT64_MAX) {
+        return false;
+    }
+    *raw_ps = value;
+    return true;
+}
