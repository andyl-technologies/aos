+static void put_riscv_insn(uint8_t *image, size_t index, uint32_t insn)
+{
+    for (size_t byte = 0; byte < sizeof(insn); byte++) {
+        image[index * sizeof(insn) + byte] = insn >> (byte * 8);
+    }
+}
+
+static void run_test_adaptive_itrigger(void)
+{
+    /* Set tdata1 to a 100-instruction M-mode trigger. */
+    static const uint32_t setup[] = {
+        0x001002b7, /* lui t0, 0x100: SiFive test device */
+        0x00300313, /* addi t1, zero, 3: trigger type */
+        0x03c31313, /* slli t1, t1, 60 */
+        0x06400393, /* addi t2, zero, 100: instruction count */
+        0x00a39393, /* slli t2, t2, 10 */
+        0x2003e393, /* ori t2, t2, 0x200: M-mode enable */
+        0x00736333, /* or t1, t1, t2 */
+        0x7a001073, /* csrw tselect, zero */
+        0x7a131073, /* csrw tdata1, t1 */
+    };
+    static const uint32_t finish[] = {
+        0x7a102473, /* csrr s0, tdata1 */
+        0x00a45413, /* srli s0, s0, 10 */
+        0x03241413, /* slli s0, s0, 50: isolate 14-bit count */
+        0x03245413, /* srli s0, s0, 50 */
+        0x00041a63, /* bne s0, zero, fail */
+        0x00005337, /* lui t1, 0x5 */
+        0x55530313, /* addi t1, t1, 0x555: pass */
+        0x0062a023, /* sw t1, 0(t0) */
+        0x0000006f, /* spin if test device did not exit */
+        0x00013337, /* fail: lui t1, 0x13 */
+        0x33330313, /* addi t1, t1, 0x333: failure exit code 1 */
+        0x0062a023, /* sw t1, 0(t0) */
+        0x0000006f,
+    };
+    enum { NOP_COUNT = 110 };
+    uint8_t image[(G_N_ELEMENTS(setup) + NOP_COUNT +
+                   G_N_ELEMENTS(finish)) * sizeof(uint32_t)];
+    g_autofree char *image_path = NULL;
+    g_autofree char *loader = NULL;
+    g_autofree char *stderr_text = NULL;
+    g_autoptr(GError) error = NULL;
+    int wait_status;
+    int fd;
+    size_t index = 0;
+
+    for (size_t i = 0; i < G_N_ELEMENTS(setup); i++) {
+        put_riscv_insn(image, index++, setup[i]);
+    }
+    for (size_t i = 0; i < NOP_COUNT; i++) {
+        put_riscv_insn(image, index++, 0x00000013); /* addi zero, zero, 0 */
+    }
+    for (size_t i = 0; i < G_N_ELEMENTS(finish); i++) {
+        put_riscv_insn(image, index++, finish[i]);
+    }
+
+    fd = g_file_open_tmp("riscv-itrigger-XXXXXX", &image_path, &error);
+    g_assert_no_error(error);
+    g_assert_cmpint(fd, >=, 0);
+    close(fd);
+    g_assert_true(g_file_set_contents(image_path, (char *)image,
+                                      sizeof(image), &error));
+    g_assert_no_error(error);
+
+    loader = g_strdup_printf("loader,file=%s,addr=0x80000000,cpu-num=0,"
+                             "force-raw=on", image_path);
+    char *args[] = {
