+int qemu_plugin_crucible_hot_fork_child_runtime(
+    uint32_t action,
+    const struct qemu_plugin_crucible_hot_fork_child_plan *plan,
+    QemuPluginCrucibleHotForkChildRuntimeInventory *inventory)
+{
+    struct qemu_plugin_crucible_hot_fork_child_status *status;
+    bool settling = false;
+    int result;
+
+    if (!inventory ||
+        (action != QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_INITIALIZE &&
+         action != QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_QUERY &&
+         action != QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_RELEASE) ||
+        (action == QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_INITIALIZE && !plan) ||
+        (action != QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_INITIALIZE &&
+         !fake_plugin_child_runtime.initialized)) {
+        return -EINVAL;
+    }
+    fake_plugin_child_runtime.calls++;
+    if (action != QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_RELEASE &&
+        fake_plugin_child_runtime.settle_queries > 0) {
+        fake_plugin_child_runtime.settle_queries--;
+        settling = true;
+    }
+    if (action == QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_INITIALIZE &&
+        fake_plugin_child_runtime.mapping) {
+        result = reinitialize_child_resources(
+            fake_plugin_child_runtime.mapping);
+        if (result != 0) {
+            return result;
+        }
+    }
+
+    if (action == QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_INITIALIZE) {
+        fake_plugin_child_runtime.plan = *plan;
+        fake_plugin_child_runtime.initialized = true;
+    } else {
+        plan = &fake_plugin_child_runtime.plan;
+    }
+
+    *inventory = (QemuPluginCrucibleHotForkChildRuntimeInventory) {
+        .generation = fake_plugin_child_runtime.calls,
+        .plugin_id = 1,
+        .registered = true,
+        .manifest_consistent = true,
+    };
+    status = &inventory->status;
+    *status = (struct qemu_plugin_crucible_hot_fork_child_status) {
+        .schema_version =
+            QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_STATUS_VERSION,
+        .struct_size = sizeof(*status),
+        .flags = action == QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_RELEASE ?
+            QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_MAPPING_INSTALLED |
+                QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_ACTIVE :
+            settling ?
+            QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_CALLBACKS_HELD |
+            QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_MAPPING_INSTALLED :
+            QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_CALLBACKS_HELD |
+            QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_MAPPING_INSTALLED |
+            QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_WORKERS_READY,
+        .phase = action == QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_RELEASE ?
+            QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PHASE_ACTIVE :
+            fake_plugin_child_runtime.phase,
+        .parent_process_generation = plan->parent_process_generation,
+        .child_process_generation = plan->child_process_generation,
+        .template_generation = plan->template_generation,
+        .private_ring_generation = plan->private_ring_generation,
+        .plugin_endpoint_generation = plan->plugin_endpoint_generation,
+        .plugin_barrier_generation = plan->plugin_barrier_generation,
+        .control_socket_cookie = plan->control_socket_cookie,
+        .wake_eventfd_id = plan->wake_eventfd_id,
+        .source_mapping_start = plan->source_mapping_start,
+        .source_mapping_length = plan->source_mapping_length,
+        .source_mapping_offset = plan->source_mapping_offset,
+        .worker_mask = plan->worker_mask,
+        .parked_worker_mask =
+            (action == QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_RELEASE &&
+             !fake_plugin_child_runtime.idle_after_release) ||
+            settling ? 0 : plan->worker_mask,
+    };
+    return 0;
+}
