+    stl_be_p(standing + 196, QEMU_CRUCIBLE_PRODUCER_RETENTION_EDITION);
+    memcpy(standing + 16,
+           wire + QEMU_CRUCIBLE_PROCESS_PURPOSE_CONTAINING_CAPABILITY_OFFSET, 32);
+    stq_be_p(standing + 48, 100);
+    stq_be_p(standing + 56, 1);
+    stq_be_p(standing + 72,
+             ldq_be_p(wire +
+                      QEMU_CRUCIBLE_PROCESS_PURPOSE_ACCOUNT_GENERATION_OFFSET));
+    stq_be_p(standing + 80,
+             ldq_be_p(wire +
+                      QEMU_CRUCIBLE_PROCESS_PURPOSE_PROCESS_GENERATION_OFFSET));
+    memcpy(standing + 88, standing + 16, 32);
+    memcpy(standing + 120, family_row(wire, 0) + FAMILY_ROW_ID, 32);
+    stq_be_p(standing + 152, 1);
+    stq_be_p(standing + 168, 19);
+    stq_be_p(standing + 176, 1);
+    memcpy(standing + 200,
