+static void test_standing_retention_edition(void)
+{
+    uint8_t wire[QEMU_CRUCIBLE_PROCESS_PURPOSE_BYTES];
+    QemuCrucibleStandingRecord out;
+    QemuCrucibleStandingRecord sentinel;
+    static const uint32_t unsupported[] = { 0, 2, UINT32_MAX };
+    uint8_t *standing = wire + STANDING_PAYLOAD;
+
+    fixture_purpose(wire);
+    g_assert_cmpint(qemu_crucible_standing_record_decode_v4(
+                       standing, QEMU_CRUCIBLE_STANDING_PAYLOAD_BYTES, &out), ==, 0);
+    g_assert_cmpuint(out.producer_retention_edition, ==, 1);
+    g_assert_cmpuint(QEMU_CRUCIBLE_STANDING_PAYLOAD_BYTES, ==, 1496);
+    g_assert_cmpuint(QEMU_CRUCIBLE_STANDING_MAPPING_BYTES, ==, 1504);
+
+    for (uint32_t version = 1; version < 4; version++) {
+        fixture_purpose(wire);
+        standing[7] = '0' + version;
+        stl_be_p(standing + 8, version);
+        assert_refusal(wire, sizeof(wire), -EPROTONOSUPPORT);
+    }
+    for (size_t index = 0; index < G_N_ELEMENTS(unsupported); index++) {
+        fixture_purpose(wire);
+        stl_be_p(standing + 196, unsupported[index]);
+        memset(&out, 0xa5, sizeof(out));
+        sentinel = out;
+        g_assert_cmpint(qemu_crucible_standing_record_decode_v4(
+                           standing, QEMU_CRUCIBLE_STANDING_PAYLOAD_BYTES,
+                           &out), ==, -EPROTONOSUPPORT);
+        g_assert_cmpmem(&out, sizeof(out), &sentinel, sizeof(sentinel));
+        assert_refusal(wire, sizeof(wire), -EPROTONOSUPPORT);
+    }
+    fixture_purpose(wire);
+    /* The declaration is BE32, not a native-endian one-byte flag. */
+    memset(standing + 196, 0, 4);
+    standing[196] = 1;
+    assert_refusal(wire, sizeof(wire), -EPROTONOSUPPORT);
+}
