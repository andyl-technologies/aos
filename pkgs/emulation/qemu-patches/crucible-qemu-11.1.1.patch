+    if (!token || token != physical_token || generation != physical_topology ||
+        generation != qatomic_read(&topology_generation) ||
+        physical_device_generation != qemu_crucible_ram_physical_device_generation() ||
+        physical_listener_generation != qemu_crucible_ram_physical_listener_generation()) {
+        return -ESTALE;
+    }
+    status = qemu_crucible_ram_owner_closure_validate(token);
+    if (!status) {
+        status = physical_owner_inventory(&borrow_generation);
+        if (!status && borrow_generation != physical_borrow_generation) {
+            status = -ESTALE;
+        }
+    }
+    return status;
+}
