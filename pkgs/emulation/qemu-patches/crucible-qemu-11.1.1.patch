+    edu->exact_state_loaded = false;
+    return 0;
+}
+
+static int edu_post_load(void *opaque, int version_id)
+{
+    EduState *edu = opaque;
+    Error *local_err = NULL;
+    bool valid = true;
+
+    if (icount_crucible_sim_mode() && !edu->exact_state_loaded) {
+        error_setg(&local_err, "EDU exact continuation state is missing");
+        valid = false;
+    } else if (!edu_state_valid(edu, &local_err)) {
+        valid = false;
+    }
+
+    if (valid && !edu_msi_enabled(edu)) {
+        pci_set_irq(&edu->pdev, edu->irq_status != 0);
+    }
+    edu_worker_resume(edu);
+    if (valid && edu->fact_irq_pending) {
+        qemu_bh_schedule(edu->fact_bh);
+    }
+    if (!valid) {
+        error_report_err(local_err);
+        return -EINVAL;
+    }
+    return 0;
+}
