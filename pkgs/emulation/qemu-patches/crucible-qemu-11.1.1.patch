+++ b/system/crucible-checkpoint-restore.c
@@ -0,0 +1,740 @@
+/*
+ * Crucible exact checkpoint direct/delta restore
+ *
+ * Copyright (c) 2026 Andyl, Inc.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+
+#include <poll.h>
+
+#include "exec/cpu-common.h"
+#include "exec/icount.h"
+#include "system/memory.h"
+#include "system/ramblock.h"
+#include "exec/tb-flush.h"
+#include "exec/target_page.h"
+#include "hw/core/cpu.h"
+#include "io/channel-file.h"
+#include "migration/misc.h"
+#include "migration/qemu-file.h"
+#include "migration/savevm.h"
+#include "qapi/error.h"
+#include "qemu/plugin.h"
+#include "plugins/qemu-plugin.h"
+#include "qemu/units.h"
+#include "system/cpu-timers.h"
+#include "system/crucible-checkpoint.h"
+#include "system/runstate.h"
+#include "system/tcg.h"
+
+#define CRUCIBLE_RESTORE_SCHEMA_VERSION 1
+#define CRUCIBLE_RESTORE_RAM_MAGIC "CRUCRAM1"
+#define CRUCIBLE_RESTORE_RAM_HEADER_BYTES 232
+#define CRUCIBLE_RESTORE_RECORD_HEADER_BYTES 16
+#define CRUCIBLE_RESTORE_RECORD_MAX_BYTES (4 * MiB)
+#define CRUCIBLE_RESTORE_REGION_MAX 1024
+#define CRUCIBLE_RESTORE_REGION_NAME_MAX 255
+#define CRUCIBLE_RESTORE_LAYER_MAX 1024
+#define CRUCIBLE_RESTORE_HASH_BUFFER_BYTES (64 * KiB)
+
+typedef struct CrucibleRestoreRegion {
+    RAMBlock *ram_block;
+    uint64_t length;
+} CrucibleRestoreRegion;
+
+typedef struct CrucibleRestoreLayer {
+    int fd;
+    uint64_t bytes;
+    dev_t device;
+    ino_t inode;
+    uint32_t kind;
+    uint8_t checkpoint[32];
+    uint8_t target[32];
+    uint8_t frontier[32];
+    uint8_t parent_checkpoint[32];
+    uint8_t parent_target[32];
+    uint8_t parent_frontier[32];
+    uint8_t topology[32];
+} CrucibleRestoreLayer;
+
+static bool crucible_restore_exact_paused_boundary(void)
+{
+    return runstate_check(RUN_STATE_PAUSED) && tcg_enabled() &&
+        icount_enabled() == ICOUNT_PRECISE &&
+        qemu_plugin_crucible_single_threaded_rr() == 1 &&
+        qemu_plugin_crucible_vmstop_pending() &&
+        !qemu_plugin_crucible_vmstop_admission_pending() &&
+        qemu_plugin_crucible_vmstop_flush_status() == 0;
+}
+
+static bool crucible_restore_cancelled(int fd, Error **errp)
+{
+    struct pollfd poll_fd = { .fd = fd, .events = POLLIN };
+    int status;
+
+    do {
+        status = poll(&poll_fd, 1, 0);
+    } while (status < 0 && errno == EINTR);
+    if (status < 0) {
+        error_setg_errno(errp, errno,
+                         "Could not poll Crucible checkpoint restore cancellation");
+        return true;
+    }
+    if (status == 0) {
+        return false;
+    }
+    if (poll_fd.revents & POLLIN) {
+        error_setg(errp, "Crucible checkpoint restore was cancelled");
+    } else {
+        error_setg(errp, "Crucible checkpoint restore cancellation descriptor failed");
+    }
+    return true;
+}
+
+static bool crucible_restore_read(int fd, uint64_t file_bytes,
+                                  uint64_t offset, void *buffer,
+                                  size_t length, int cancellation_fd,
+                                  Error **errp)
+{
+    uint8_t *cursor = buffer;
+
+    if (offset > file_bytes || length > file_bytes - offset) {
+        error_setg(errp, "Truncated Crucible checkpoint restore input");
+        return false;
+    }
+    while (length != 0) {
+        ssize_t bytes;
+
+        if (crucible_restore_cancelled(cancellation_fd, errp)) {
+            return false;
+        }
+        do {
+            bytes = pread(fd, cursor, length, offset);
+        } while (bytes < 0 && errno == EINTR);
+        if (bytes <= 0) {
+            error_setg_errno(errp, bytes == 0 ? EIO : errno,
+                             "Could not read Crucible checkpoint restore input");
+            return false;
+        }
+        cursor += bytes;
+        offset += bytes;
+        length -= bytes;
+    }
+    return true;
+}
+
+static bool crucible_restore_u32(int fd, uint64_t file_bytes,
+                                 uint64_t *offset, uint32_t *value,
+                                 int cancellation_fd, Error **errp)
+{
+    uint32_t encoded;
+
+    if (!crucible_restore_read(fd, file_bytes, *offset, &encoded,
+                               sizeof(encoded), cancellation_fd, errp)) {
+        return false;
+    }
+    *offset += sizeof(encoded);
+    *value = le32_to_cpu(encoded);
+    return true;
+}
+
+static bool crucible_restore_u64(int fd, uint64_t file_bytes,
+                                 uint64_t *offset, uint64_t *value,
+                                 int cancellation_fd, Error **errp)
+{
+    uint64_t encoded;
+
+    if (!crucible_restore_read(fd, file_bytes, *offset, &encoded,
+                               sizeof(encoded), cancellation_fd, errp)) {
+        return false;
+    }
+    *offset += sizeof(encoded);
+    *value = le64_to_cpu(encoded);
+    return true;
+}
+
+static bool crucible_restore_hex(const char *encoded, uint8_t digest[32],
+                                 const char *description, Error **errp)
+{
+    if (!encoded || strlen(encoded) != 64) {
+        error_setg(errp, "Crucible checkpoint %s must be 64 lowercase hexadecimal bytes",
+                   description);
+        return false;
+    }
+    for (size_t index = 0; index < 32; index++) {
+        int high = g_ascii_xdigit_value(encoded[index * 2]);
+        int low = g_ascii_xdigit_value(encoded[index * 2 + 1]);
+
+        if (high < 0 || low < 0 ||
+            g_ascii_isupper(encoded[index * 2]) ||
+            g_ascii_isupper(encoded[index * 2 + 1])) {
+            error_setg(errp, "Crucible checkpoint %s must be 64 lowercase "
+                       "hexadecimal bytes", description);
+            return false;
+        }
+        digest[index] = (high << 4) | low;
+    }
+    return true;
+}
+
+static bool crucible_restore_regular_input(int fd, uint64_t maximum_bytes,
+                                           uint64_t *bytes_out,
+                                           dev_t *device_out,
+                                           ino_t *inode_out,
+                                           const char *description,
+                                           Error **errp)
+{
+    struct stat stat_buffer;
+    int flags;
+#ifdef F_GET_SEALS
+    int seals;
+#endif
+
+    if (fd < 0 || fstat(fd, &stat_buffer) < 0) {
+        error_setg_errno(errp, errno, "Could not inspect Crucible checkpoint %s",
+                         description);
+        return false;
+    }
+    flags = fcntl(fd, F_GETFL);
+    if (!S_ISREG(stat_buffer.st_mode) || flags < 0 ||
+        (flags & O_ACCMODE) == O_WRONLY || stat_buffer.st_size <= 0 ||
+        maximum_bytes == 0 || maximum_bytes > INT64_MAX ||
+        stat_buffer.st_size > maximum_bytes) {
+        error_setg(errp, "Crucible checkpoint %s must be a nonempty bounded "
+                   "readable regular file", description);
+        return false;
+    }
+#ifdef F_GET_SEALS
+    seals = fcntl(fd, F_GET_SEALS);
+    if (seals < 0 ||
+        (seals & (F_SEAL_SEAL | F_SEAL_SHRINK | F_SEAL_GROW |
+                  F_SEAL_WRITE)) !=
+            (F_SEAL_SEAL | F_SEAL_SHRINK | F_SEAL_GROW | F_SEAL_WRITE)) {
+        error_setg(errp, "Crucible checkpoint %s must be an immutable sealed file",
+                   description);
+        return false;
+    }
+#else
+    error_setg(errp, "Crucible checkpoint immutable restore inputs are "
+               "unsupported on this host");
+    return false;
+#endif
+    *bytes_out = stat_buffer.st_size;
+    *device_out = stat_buffer.st_dev;
+    *inode_out = stat_buffer.st_ino;
+    return true;
+}
+
+static bool crucible_restore_authenticate(int fd, uint64_t bytes,
+                                          const char *expected_sha256,
+                                          int cancellation_fd,
+                                          Error **errp)
+{
+    g_autofree uint8_t *buffer = g_malloc(CRUCIBLE_RESTORE_HASH_BUFFER_BYTES);
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    uint8_t expected[32];
+    uint8_t observed[32];
+    gsize observed_length = sizeof(observed);
+    uint64_t offset = 0;
+
+    if (!checksum ||
+        !crucible_restore_hex(expected_sha256, expected, "content digest", errp)) {
+        return false;
+    }
+    while (offset < bytes) {
+        size_t chunk = MIN(bytes - offset,
+                           CRUCIBLE_RESTORE_HASH_BUFFER_BYTES);
+
+        if (!crucible_restore_read(fd, bytes, offset, buffer, chunk,
+                                   cancellation_fd, errp)) {
+            return false;
+        }
+        g_checksum_update(checksum, buffer, chunk);
+        offset += chunk;
+    }
+    g_checksum_get_digest(checksum, observed, &observed_length);
+    if (observed_length != sizeof(observed) ||
+        memcmp(expected, observed, sizeof(observed)) != 0) {
+        error_setg(errp, "Crucible checkpoint restore content digest mismatch");
+        return false;
+    }
+    return true;
+}
+
+static int crucible_restore_count_region(RAMBlock *ram_block, void *opaque)
+{
+    uint32_t *count = opaque;
+
+    if (qemu_ram_is_migratable(ram_block)) {
+        (*count)++;
+    }
+    return 0;
+}
+
+static void crucible_restore_checksum_u64(GChecksum *checksum, uint64_t value)
+{
+    value = cpu_to_le64(value);
+    g_checksum_update(checksum, (const uint8_t *)&value, sizeof(value));
+}
+
+static bool crucible_restore_parse_layer(CrucibleRestoreLayer *layer,
+                                         int cancellation_fd, bool apply,
+                                         Error **errp)
+{
+    g_autoptr(GArray) regions = g_array_new(false, false,
+                                            sizeof(CrucibleRestoreRegion));
+    g_autoptr(GChecksum) topology_checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    uint8_t magic[8];
+    uint32_t schema;
+    uint32_t target_page_size;
+    uint32_t region_count;
+    uint64_t record_count;
+    uint64_t total_bytes;
+    uint64_t offset = 0;
+    uint32_t live_region_count = 0;
+    char previous_name[CRUCIBLE_RESTORE_REGION_NAME_MAX + 1] = { 0 };
+    uint32_t direct_region = 0;
+    uint64_t direct_offset = 0;
+    uint32_t last_delta_region = UINT32_MAX;
+    uint64_t last_delta_end = 0;
+    gsize digest_length = sizeof(layer->topology);
+
+    if (!topology_checksum ||
+        !crucible_restore_read(layer->fd, layer->bytes, offset, magic,
+                               sizeof(magic), cancellation_fd, errp)) {
+        return false;
+    }
+    offset += sizeof(magic);
+    if (memcmp(magic, CRUCIBLE_RESTORE_RAM_MAGIC, sizeof(magic)) != 0 ||
+        !crucible_restore_u32(layer->fd, layer->bytes, &offset, &schema,
+                              cancellation_fd, errp) ||
+        !crucible_restore_u32(layer->fd, layer->bytes, &offset, &layer->kind,
+                              cancellation_fd, errp) ||
+        !crucible_restore_u32(layer->fd, layer->bytes, &offset,
+                              &target_page_size, cancellation_fd, errp) ||
+        !crucible_restore_u32(layer->fd, layer->bytes, &offset, &region_count,
+                              cancellation_fd, errp) ||
+        !crucible_restore_u64(layer->fd, layer->bytes, &offset, &record_count,
+                              cancellation_fd, errp) ||
+        !crucible_restore_u64(layer->fd, layer->bytes, &offset, &total_bytes,
+                              cancellation_fd, errp)) {
+        if (!*errp) {
+            error_setg(errp, "Invalid Crucible checkpoint RAM header");
+        }
+        return false;
+    }
+    if (schema != CRUCIBLE_RESTORE_SCHEMA_VERSION ||
+        (layer->kind != 1 && layer->kind != 2) ||
+        target_page_size != TARGET_PAGE_SIZE || region_count == 0 ||
+        region_count > CRUCIBLE_RESTORE_REGION_MAX ||
+        total_bytes != layer->bytes || record_count > layer->bytes / 16) {
+        error_setg(errp, "Invalid Crucible checkpoint RAM header bounds");
+        return false;
+    }
+    if (!crucible_restore_read(layer->fd, layer->bytes, offset,
+                               layer->checkpoint, 32, cancellation_fd, errp) ||
+        !crucible_restore_read(layer->fd, layer->bytes, offset + 32,
+                               layer->target, 32, cancellation_fd, errp) ||
+        !crucible_restore_read(layer->fd, layer->bytes, offset + 64,
+                               layer->frontier, 32, cancellation_fd, errp) ||
+        !crucible_restore_read(layer->fd, layer->bytes, offset + 96,
+                               layer->parent_checkpoint, 32,
+                               cancellation_fd, errp) ||
+        !crucible_restore_read(layer->fd, layer->bytes, offset + 128,
+                               layer->parent_target, 32,
+                               cancellation_fd, errp) ||
+        !crucible_restore_read(layer->fd, layer->bytes, offset + 160,
+                               layer->parent_frontier, 32,
+                               cancellation_fd, errp)) {
+        return false;
+    }
+    offset += 192;
+    if (offset != CRUCIBLE_RESTORE_RAM_HEADER_BYTES) {
+        error_setg(errp, "Internal Crucible checkpoint RAM header size mismatch");
+        return false;
+    }
+
+    qemu_ram_foreach_block(crucible_restore_count_region, &live_region_count);
+    if (live_region_count != region_count) {
+        error_setg(errp, "Crucible checkpoint RAM region count differs from "
+                   "the live machine");
+        return false;
+    }
+    for (uint32_t index = 0; index < region_count; index++) {
+        CrucibleRestoreRegion region;
+        uint64_t maximum_length;
+        uint64_t page_size;
+        uint32_t name_length;
+        char name[CRUCIBLE_RESTORE_REGION_NAME_MAX + 1];
+
+        if (!crucible_restore_u64(layer->fd, layer->bytes, &offset,
+                                  &region.length, cancellation_fd, errp) ||
+            !crucible_restore_u64(layer->fd, layer->bytes, &offset,
+                                  &maximum_length, cancellation_fd, errp) ||
+            !crucible_restore_u64(layer->fd, layer->bytes, &offset,
+                                  &page_size, cancellation_fd, errp) ||
+            !crucible_restore_u32(layer->fd, layer->bytes, &offset,
+                                  &name_length, cancellation_fd, errp) ||
+            name_length == 0 || name_length > CRUCIBLE_RESTORE_REGION_NAME_MAX ||
+            !crucible_restore_read(layer->fd, layer->bytes, offset, name,
+                                   name_length, cancellation_fd, errp)) {
+            if (!*errp) {
+                error_setg(errp, "Invalid Crucible checkpoint RAM topology entry");
+            }
+            return false;
+        }
+        offset += name_length;
+        name[name_length] = 0;
+        region.ram_block = qemu_ram_block_by_name(name);
+        if (memchr(name, 0, name_length) ||
+            (index != 0 && strcmp(previous_name, name) >= 0) ||
+            !region.ram_block ||
+            !qemu_ram_is_migratable(region.ram_block) ||
+            !region.ram_block->mr || !region.ram_block->host ||
+            memory_region_is_protected(region.ram_block->mr) ||
+            qemu_ram_get_used_length(region.ram_block) != region.length ||
+            qemu_ram_get_max_length(region.ram_block) != maximum_length ||
+            qemu_ram_pagesize(region.ram_block) != page_size ||
+            region.length == 0 ||
+            !QEMU_IS_ALIGNED(region.length, TARGET_PAGE_SIZE)) {
