+int qemu_plugin_crucible_fingerprint_retirement_return_v1(
+    qemu_plugin_id_t id, qemu_plugin_crucible_fingerprint_retirement_v1 **selector,
+    struct qemu_plugin_crucible_fingerprint_return_status_v1 *out)
+{
+    qemu_plugin_crucible_fingerprint_retirement_v1 *retained = NULL;
+    int status;
+
+    if (!selector || !*selector || !out) {
+        return -EINVAL;
+    }
+    status = qemu_crucible_startup_source_fingerprint_return_borrow_v1(id, &retained);
+    if (!status && retained != *selector) {
+        status = -EPERM;
+    }
+    if (!status) {
+        status = fingerprint_retirement_return_identity(retained);
+    }
+    if (status) {
+        return status;
+    }
+    /* Finite physical return before any fresh outer-operation admission. Only
+     * the exact existing end callback executes; no post/clock is replayed. */
+    retained->invoking = true;
+    retained->phase = 4;
+    status = qemu_crucible_startup_source_fingerprint_retirement_end_v1(retained);
+    retained->invoking = false;
+    retained->operation_borrowed =
+        !qemu_crucible_startup_source_fingerprint_retirement_idle_v1();
+    if (!retained->operation_borrowed) {
+        /* Physical consumption is recorded immediately even with a negative
+         * signed result. No alias may continue to name the returned selector. */
+        *selector = NULL;
+    }
+    retained->end_status = status;
+    fingerprint_retirement_history(retained->first_status, retained->post_status);
+    fingerprint_retirement_return_status(retained, status, out);
+    return status;
+}
