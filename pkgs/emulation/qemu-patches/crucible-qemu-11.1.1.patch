+
+static CrucibleHotForkDiagnosticState *
+crucible_hot_fork_diagnostic_report(void)
+{
+    CrucibleHotForkDiagnosticState *report =
+        g_new0(CrucibleHotForkDiagnosticState, 1);
+
+    report->schema_version = 1;
+    report->generation = crucible_hot_fork_diagnostic_stage.generation;
+    report->template_generation =
+        crucible_hot_fork_diagnostic_stage.template_generation;
+    report->staged = crucible_hot_fork_diagnostic_stage.staged;
+    if (report->staged) {
+        report->fdname = g_strdup(crucible_hot_fork_diagnostic_stage.fdname);
+    }
+    report->socket_cookie =
+        crucible_hot_fork_diagnostic_stage.socket_cookie;
+    report->source_fd = report->staged ?
+        crucible_hot_fork_diagnostic_stage.fd : -1;
+    report->target_fd = report->staged ?
+        QEMU_CRUCIBLE_HOT_FORK_DIAGNOSTIC_TARGET_FD : -1;
+    report->replacement_plan_bound =
+        crucible_hot_fork_diagnostic_resource_plan_bound();
+    report->nonblocking_unix_stream = report->staged;
+    report->disposition_complete = false;
+    report->readiness_proof_acknowledged = false;
+    return report;
+}
+
+static bool crucible_hot_fork_diagnostic_stage_matches(
+    const char *fdname, uint64_t socket_cookie)
+{
+    return crucible_hot_fork_diagnostic_stage.staged && fdname &&
+        strcmp(crucible_hot_fork_diagnostic_stage.fdname, fdname) == 0 &&
+        crucible_hot_fork_diagnostic_stage.socket_cookie == socket_cookie;
+}
+
+CrucibleHotForkDiagnosticState *
+qmp_crucible_hot_fork_child_diagnostics(
+    CrucibleHotForkDiagnosticAction action, const char *fdname,
+    bool has_expected_socket_cookie, uint64_t expected_socket_cookie,
+    Error **errp)
+{
+    CrucibleHotForkDiagnosticState *report = NULL;
+    CrucibleHotForkPluginBarrierState *plugin_barrier = NULL;
+    uint64_t observed_socket_cookie = 0;
+    uint64_t next_generation;
+    int candidate = -1;
+    int result;
+
+    g_autoptr(BQLLockAuto) admission_bql =
+        action != CRUCIBLE_HOT_FORK_DIAGNOSTIC_ACTION_QUERY ?
+        bql_auto_lock(__FILE__, __LINE__) : NULL;
+
+    g_mutex_lock(&crucible_hot_fork_template_lock);
+    switch (action) {
+    case CRUCIBLE_HOT_FORK_DIAGNOSTIC_ACTION_STAGE:
+        if (!fdname || !has_expected_socket_cookie ||
+            expected_socket_cookie == 0 ||
+            !crucible_hot_fork_private_ring_fd_name_valid(fdname)) {
+            error_setg(errp, "Crucible hot-fork diagnostics require one "
+                       "exact bounded descriptor identity");
+            goto out;
+        }
+        if (!crucible_hot_fork_template_active) {
+            error_setg(errp, "Crucible hot-fork diagnostics require an "
+                       "active retained template");
+            goto out;
+        }
+        if (!crucible_hot_fork_private_ring_stage.staged ||
+            crucible_hot_fork_private_ring_stage.template_generation !=
+                crucible_hot_fork_template_generation) {
+            error_setg(errp, "Crucible hot-fork diagnostics require private "
+                       "rings from the same template");
+            goto out;
+        }
+        if (!crucible_hot_fork_resource_stage_allowed(
+                &plugin_barrier, errp)) {
+            goto out;
+        }
+        candidate = monitor_dup_fd(monitor_cur(), fdname, errp);
+        if (candidate < 0) {
+            goto out;
+        }
+        if (!crucible_hot_fork_nonblocking_socket_cookie(
+                candidate, &observed_socket_cookie, errp)) {
+            goto out;
+        }
+        if (observed_socket_cookie != expected_socket_cookie) {
+            error_setg(errp, "Crucible hot-fork diagnostic identity mismatch");
+            goto out;
+        }
+        if (candidate == QEMU_CRUCIBLE_HOT_FORK_DIAGNOSTIC_TARGET_FD) {
+            error_setg(errp, "Crucible hot-fork diagnostic source aliases "
+                       "stderr");
+            goto out;
+        }
+        if (crucible_hot_fork_diagnostic_stage.staged) {
+            if (!crucible_hot_fork_diagnostic_stage_matches(
+                    fdname, expected_socket_cookie) ||
+                crucible_hot_fork_diagnostic_stage.template_generation !=
+                    crucible_hot_fork_template_generation) {
+                error_setg(errp, "Different Crucible hot-fork diagnostics "
+                           "are already staged");
+                goto out;
+            }
+            report = crucible_hot_fork_diagnostic_report();
+            goto out;
+        }
+        if (crucible_hot_fork_plugin_endpoint_stage.staged) {
+            error_setg(errp, "Crucible hot-fork diagnostics must be staged "
+                       "before plugin endpoints seal the child plan");
+            goto out;
+        }
+        if (crucible_hot_fork_diagnostic_stage.generation == UINT64_MAX) {
+            error_setg(errp, "Crucible hot-fork diagnostic generation is "
+                       "exhausted");
+            goto out;
+        }
+        result = qemu_crucible_hot_fork_prepare_diagnostics_child_resources(
+            &crucible_hot_fork_diagnostics_child_resources, candidate,
+            expected_socket_cookie);
+        if (result != 0) {
+            error_setg_errno(errp, -result,
+                             "Could not prepare Crucible hot-fork "
+                             "diagnostic resources");
+            goto out;
+        }
+        next_generation = crucible_hot_fork_diagnostic_stage.generation + 1;
+        crucible_hot_fork_diagnostic_stage.staged = true;
+        crucible_hot_fork_diagnostic_stage.fd = candidate;
+        candidate = -1;
+        crucible_hot_fork_diagnostic_stage.fdname = g_strdup(fdname);
+        crucible_hot_fork_diagnostic_stage.socket_cookie =
+            expected_socket_cookie;
+        crucible_hot_fork_diagnostic_stage.template_generation =
+            crucible_hot_fork_template_generation;
+        crucible_hot_fork_diagnostic_stage.generation = next_generation;
+        report = crucible_hot_fork_diagnostic_report();
+        break;
+    case CRUCIBLE_HOT_FORK_DIAGNOSTIC_ACTION_QUERY:
+        if (fdname || has_expected_socket_cookie) {
+            error_setg(errp, "Crucible hot-fork diagnostic query accepts no "
+                       "descriptor identity");
+            goto out;
+        }
+        report = crucible_hot_fork_diagnostic_report();
+        break;
+    case CRUCIBLE_HOT_FORK_DIAGNOSTIC_ACTION_RELEASE:
+        if (!fdname || !has_expected_socket_cookie ||
+            !crucible_hot_fork_diagnostic_stage_matches(
+                fdname, expected_socket_cookie)) {
+            error_setg(errp, "Crucible hot-fork diagnostic release requires "
+                       "the exact retained basis");
+            goto out;
+        }
+        if (!crucible_hot_fork_stage_release_allowed("diagnostics", errp)) {
+            goto out;
+        }
+        if (crucible_hot_fork_plugin_endpoint_stage.staged) {
+            error_setg(errp, "Cannot release Crucible hot-fork diagnostics "
+                       "before plugin endpoints release the sealed plan");
+            goto out;
+        }
+        if (crucible_hot_fork_qmp_stage.staged) {
+            error_setg(errp, "Cannot release Crucible hot-fork diagnostics "
+                       "before child QMP releases");
+            goto out;
+        }
+        if (crucible_hot_fork_console_stage.staged) {
+            error_setg(errp, "Cannot release Crucible hot-fork diagnostics "
+                       "before child console releases");
+            goto out;
+        }
+        close(crucible_hot_fork_diagnostic_stage.fd);
+        crucible_hot_fork_diagnostic_stage.fd = -1;
+        g_clear_pointer(&crucible_hot_fork_diagnostic_stage.fdname, g_free);
+        crucible_hot_fork_diagnostic_stage.staged = false;
+        crucible_hot_fork_diagnostic_stage.socket_cookie = 0;
+        crucible_hot_fork_diagnostic_stage.template_generation = 0;
+        qemu_crucible_hot_fork_reset_diagnostics_child_resources(
+            &crucible_hot_fork_diagnostics_child_resources);
+        crucible_hot_fork_diagnostic_stage.generation++;
+        assert(crucible_hot_fork_diagnostic_stage.generation != 0);
+        report = crucible_hot_fork_diagnostic_report();
+        break;
+    default:
+        g_assert_not_reached();
+    }
+out:
+    g_free(plugin_barrier);
+    if (candidate >= 0) {
+        close(candidate);
+    }
+    g_mutex_unlock(&crucible_hot_fork_template_lock);
+    return report;
+}
+
+static bool crucible_hot_fork_qmp_resource_plan_bound(void)
+{
+    if (crucible_hot_fork_child_active) {
+        return crucible_hot_fork_qmp_stage.staged &&
+            qemu_crucible_hot_fork_qmp_child_reinitializer_complete(
+                &crucible_hot_fork_qmp_child_reinitializer) &&
+            qemu_crucible_hot_fork_child_resource_plan_contains_qmp(
+                &crucible_hot_fork_child_resource_plan,
+                &crucible_hot_fork_qmp_child_resources);
+    }
+    return crucible_hot_fork_qmp_stage.staged &&
+        monitor_hot_fork_child_socket_resources_prepared_for(
+            &crucible_hot_fork_qmp_child_basis,
+            crucible_hot_fork_qmp_stage.monitor_generation) &&
+        qemu_crucible_hot_fork_qmp_child_resources_prepared_for(
+            &crucible_hot_fork_qmp_child_resources,
+            crucible_hot_fork_qmp_stage.fd,
+            crucible_hot_fork_qmp_stage.socket_cookie,
+            crucible_hot_fork_qmp_stage.template_generation,
+            crucible_hot_fork_qmp_stage.generation,
+            crucible_hot_fork_qmp_stage.monitor_generation) &&
+        qemu_crucible_hot_fork_qmp_child_reinitializer_bound_for(
+            &crucible_hot_fork_qmp_child_reinitializer,
+            &crucible_hot_fork_qmp_child_resources,
+            crucible_hot_fork_reinitialize_child_qmp,
+            &crucible_hot_fork_qmp_child_basis) &&
+        qemu_crucible_hot_fork_child_resource_plan_contains_qmp(
+            &crucible_hot_fork_child_resource_plan,
+            &crucible_hot_fork_qmp_child_resources);
+}
+
+static CrucibleHotForkQmpState *crucible_hot_fork_qmp_report(void)
+{
+    CrucibleHotForkQmpState *report =
+        g_new0(CrucibleHotForkQmpState, 1);
+    bool child_monitor_basis = crucible_hot_fork_child_active &&
+        crucible_hot_fork_qmp_child_basis.prepared &&
+        crucible_hot_fork_qmp_child_basis.generation ==
+            crucible_hot_fork_qmp_stage.monitor_generation;
+    bool child_monitor_disposition = child_monitor_basis &&
+        crucible_hot_fork_qmp_child_basis.attempted &&
+        crucible_hot_fork_qmp_child_basis.inherited_protocol_disposed &&
+        crucible_hot_fork_qmp_child_basis.dispatcher_rebuilt &&
+        crucible_hot_fork_qmp_child_basis.iothread_rebuilt &&
+        crucible_hot_fork_qmp_child_basis.parser_reset &&
+        crucible_hot_fork_qmp_child_basis.capabilities_reset &&
+        crucible_hot_fork_qmp_child_basis.greeting_emitted;
+    bool child_socket_resources = child_monitor_disposition &&
+        crucible_hot_fork_qmp_child_basis.socket.attempted &&
+        crucible_hot_fork_qmp_child_basis.socket.inherited_disposed &&
+        crucible_hot_fork_qmp_child_basis.socket.replacement_attached;
+
+    report->schema_version = 8;
+    report->generation = crucible_hot_fork_qmp_stage.generation;
+    report->template_generation =
+        crucible_hot_fork_qmp_stage.template_generation;
+    report->monitor_generation =
+        crucible_hot_fork_qmp_stage.monitor_generation;
+    report->staged = crucible_hot_fork_qmp_stage.staged;
+    if (report->staged) {
+        report->fdname = g_strdup(crucible_hot_fork_qmp_stage.fdname);
+    }
+    report->socket_cookie = crucible_hot_fork_qmp_stage.socket_cookie;
+    report->retained_fd = report->staged ?
+        crucible_hot_fork_qmp_stage.fd : -1;
+    report->resource_plan_bound = crucible_hot_fork_qmp_resource_plan_bound();
+    report->nonblocking_unix_stream = report->staged;
+    report->monitor_basis_bound = report->staged &&
+        (child_monitor_basis || monitor_hot_fork_child_basis_prepared_for(
+            &crucible_hot_fork_qmp_child_basis,
+            crucible_hot_fork_qmp_stage.monitor_generation));
+    report->monitor_disposition_bound = report->staged &&
+        (child_monitor_disposition ||
+         monitor_hot_fork_child_disposition_prepared_for(
+             &crucible_hot_fork_qmp_child_basis,
+             crucible_hot_fork_qmp_stage.monitor_generation));
+    report->monitor_socket_resources_bound = report->staged &&
+        (child_socket_resources ||
+         monitor_hot_fork_child_socket_resources_prepared_for(
+             &crucible_hot_fork_qmp_child_basis,
+             crucible_hot_fork_qmp_stage.monitor_generation));
+    report->reinitializer_prepared = report->staged &&
+        report->monitor_basis_bound && report->monitor_disposition_bound &&
+        report->monitor_socket_resources_bound &&
+        (crucible_hot_fork_child_active ?
+         qemu_crucible_hot_fork_qmp_child_reinitializer_bound_for(
+             &crucible_hot_fork_qmp_child_reinitializer,
+             &crucible_hot_fork_qmp_child_resources,
+             crucible_hot_fork_reinitialize_child_qmp,
+             &crucible_hot_fork_qmp_child_basis) :
+         qemu_crucible_hot_fork_qmp_child_reinitializer_prepared_for(
+             &crucible_hot_fork_qmp_child_reinitializer,
+             &crucible_hot_fork_qmp_child_resources,
+             crucible_hot_fork_reinitialize_child_qmp,
+             &crucible_hot_fork_qmp_child_basis));
+    report->reinitialized =
+        crucible_hot_fork_qmp_child_reinitializer.initialized;
+    report->disposition_complete =
+        qemu_crucible_hot_fork_qmp_child_reinitializer_complete(
+            &crucible_hot_fork_qmp_child_reinitializer);
+    report->readiness_proof_acknowledged =
+        crucible_hot_fork_child_active && report->resource_plan_bound &&
+        report->monitor_basis_bound && report->monitor_disposition_bound &&
+        report->monitor_socket_resources_bound &&
+        report->reinitializer_prepared && report->reinitialized &&
+        report->disposition_complete &&
+        crucible_hot_fork_qmp_child_basis.input_released &&
+        crucible_hot_fork_qmp_child_basis.socket.input_held == false;
+    return report;
+}
+
+static bool crucible_hot_fork_qmp_stage_matches(
+    const char *fdname, uint64_t socket_cookie)
+{
+    return crucible_hot_fork_qmp_stage.staged && fdname &&
+        strcmp(crucible_hot_fork_qmp_stage.fdname, fdname) == 0 &&
+        crucible_hot_fork_qmp_stage.socket_cookie == socket_cookie;
+}
+
+CrucibleHotForkQmpState *qmp_crucible_hot_fork_child_qmp(
+    CrucibleHotForkQmpAction action, const char *fdname,
+    bool has_expected_socket_cookie, uint64_t expected_socket_cookie,
+    Error **errp)
+{
+    MonitorQMP *active_oob_monitor = MONITOR_QMP(monitor_cur());
+    CrucibleHotForkQmpState *report = NULL;
+    CrucibleHotForkPluginBarrierState *plugin_barrier = NULL;
+    MonitorHotForkChildBasis candidate_basis = { 0 };
+    MonitorHotForkInventory monitor_inventory;
+    uint64_t observed_socket_cookie = 0;
+    uint64_t next_generation;
+    int candidate = -1;
+    int result;
+
+    g_autoptr(BQLLockAuto) admission_bql =
+        action != CRUCIBLE_HOT_FORK_QMP_ACTION_QUERY ?
+        bql_auto_lock(__FILE__, __LINE__) : NULL;
+
+    g_mutex_lock(&crucible_hot_fork_template_lock);
+    switch (action) {
+    case CRUCIBLE_HOT_FORK_QMP_ACTION_STAGE:
+        if (!fdname || !has_expected_socket_cookie ||
+            expected_socket_cookie == 0 ||
+            !crucible_hot_fork_private_ring_fd_name_valid(fdname)) {
+            error_setg(errp, "Crucible hot-fork child QMP requires one "
+                       "exact bounded descriptor identity");
+            goto out;
+        }
+        if (!crucible_hot_fork_template_active) {
+            error_setg(errp, "Crucible hot-fork child QMP requires an active "
+                       "retained template");
+            goto out;
+        }
+        if (!crucible_hot_fork_private_ring_stage.staged ||
+            crucible_hot_fork_private_ring_stage.template_generation !=
+                crucible_hot_fork_template_generation ||
+            !crucible_hot_fork_diagnostic_stage.staged ||
+            crucible_hot_fork_diagnostic_stage.template_generation !=
+                crucible_hot_fork_template_generation) {
+            error_setg(errp, "Crucible hot-fork child QMP requires private "
+                       "rings and diagnostics from the same template");
+            goto out;
+        }
+        if (!crucible_hot_fork_resource_stage_allowed(
+                &plugin_barrier, errp)) {
+            goto out;
+        }
+        monitor_hot_fork_inventory_for_active_oob(
+            &monitor_inventory, active_oob_monitor);
+        if (!monitor_hot_fork_inventory_is_supported(&monitor_inventory)) {
+            error_setg(errp, "Crucible hot-fork child QMP requires the "
+                       "complete supported monitor profile");
+            goto out;
+        }
+        result = monitor_hot_fork_prepare_child_basis(
+            &candidate_basis, monitor_inventory.generation,
+            active_oob_monitor);
+        if (result != 0) {
+            error_setg_errno(errp, -result,
+                             "Could not bind Crucible hot-fork child monitor "
+                             "basis");
+            goto out;
+        }
+        candidate = monitor_dup_fd(monitor_cur(), fdname, errp);
+        if (candidate < 0) {
+            goto out;
+        }
+        if (!crucible_hot_fork_nonblocking_socket_cookie(
+                candidate, &observed_socket_cookie, errp)) {
+            goto out;
+        }
+        if (observed_socket_cookie != expected_socket_cookie) {
+            error_setg(errp, "Crucible hot-fork child QMP identity mismatch");
+            goto out;
+        }
+        if (expected_socket_cookie ==
+                crucible_hot_fork_diagnostic_stage.socket_cookie) {
+            error_setg(errp, "Crucible hot-fork child QMP aliases the "
+                       "diagnostics stream");
+            goto out;
+        }
+        if (candidate == QEMU_CRUCIBLE_HOT_FORK_DIAGNOSTIC_TARGET_FD ||
+            candidate == crucible_hot_fork_diagnostic_stage.fd ||
+            candidate == crucible_hot_fork_private_ring_stage.fd) {
+            error_setg(errp, "Crucible hot-fork child QMP aliases another "
+                       "retained resource");
+            goto out;
+        }
+        if (crucible_hot_fork_qmp_stage.staged) {
+            if (!crucible_hot_fork_qmp_stage_matches(
+                    fdname, expected_socket_cookie) ||
+                crucible_hot_fork_qmp_stage.template_generation !=
+                    crucible_hot_fork_template_generation ||
+                crucible_hot_fork_qmp_stage.monitor_generation !=
+                    monitor_inventory.generation ||
+                !monitor_hot_fork_child_basis_matches_current(
+                    &crucible_hot_fork_qmp_child_basis,
+                    monitor_inventory.generation)) {
+                error_setg(errp, "Different Crucible hot-fork child QMP "
+                           "endpoint is already staged");
+                goto out;
+            }
+            report = crucible_hot_fork_qmp_report();
+            goto out;
+        }
+        if (crucible_hot_fork_plugin_endpoint_stage.staged) {
+            error_setg(errp, "Crucible hot-fork child QMP must be staged "
+                       "before plugin endpoints seal the child plan");
+            goto out;
+        }
+        if (crucible_hot_fork_qmp_stage.generation == UINT64_MAX) {
+            error_setg(errp, "Crucible hot-fork child QMP generation is "
+                       "exhausted");
+            goto out;
+        }
+        next_generation = crucible_hot_fork_qmp_stage.generation + 1;
+        result = qemu_crucible_hot_fork_prepare_qmp_child_resources(
+            &crucible_hot_fork_qmp_child_resources, candidate,
+            expected_socket_cookie, crucible_hot_fork_template_generation,
+            next_generation, monitor_inventory.generation);
+        if (result != 0) {
+            error_setg_errno(errp, -result,
+                             "Could not prepare Crucible hot-fork child QMP "
+                             "resources");
+            goto out;
+        }
+        result = qemu_crucible_hot_fork_prepare_qmp_child_reinitializer(
+            &crucible_hot_fork_qmp_child_reinitializer,
+            &crucible_hot_fork_qmp_child_resources,
+            crucible_hot_fork_reinitialize_child_qmp,
+            &crucible_hot_fork_qmp_child_basis);
+        if (result != 0) {
+            qemu_crucible_hot_fork_reset_qmp_child_resources(
+                &crucible_hot_fork_qmp_child_resources);
+            error_setg_errno(errp, -result,
+                             "Could not prepare Crucible hot-fork child QMP "
+                             "reinitializer");
+            goto out;
+        }
+        if (!monitor_hot_fork_child_basis_matches_current(
+                &candidate_basis, monitor_inventory.generation)) {
+            qemu_crucible_hot_fork_reset_qmp_child_reinitializer(
+                &crucible_hot_fork_qmp_child_reinitializer);
+            qemu_crucible_hot_fork_reset_qmp_child_resources(
+                &crucible_hot_fork_qmp_child_resources);
+            error_setg(errp, "Crucible hot-fork child monitor basis changed "
+                       "during endpoint staging");
+            goto out;
+        }
+        crucible_hot_fork_qmp_stage.staged = true;
+        crucible_hot_fork_qmp_stage.fd = candidate;
+        candidate = -1;
+        crucible_hot_fork_qmp_stage.fdname = g_strdup(fdname);
+        crucible_hot_fork_qmp_stage.socket_cookie = expected_socket_cookie;
+        crucible_hot_fork_qmp_stage.template_generation =
+            crucible_hot_fork_template_generation;
+        crucible_hot_fork_qmp_stage.monitor_generation =
+            monitor_inventory.generation;
+        crucible_hot_fork_qmp_stage.generation = next_generation;
+        crucible_hot_fork_qmp_child_basis = candidate_basis;
+        report = crucible_hot_fork_qmp_report();
+        break;
+    case CRUCIBLE_HOT_FORK_QMP_ACTION_QUERY:
+        if (fdname || has_expected_socket_cookie) {
+            error_setg(errp, "Crucible hot-fork child QMP query accepts no "
+                       "descriptor identity");
+            goto out;
+        }
+        report = crucible_hot_fork_qmp_report();
+        break;
+    case CRUCIBLE_HOT_FORK_QMP_ACTION_RELEASE:
+        if (!fdname || !has_expected_socket_cookie ||
+            !crucible_hot_fork_qmp_stage_matches(
+                fdname, expected_socket_cookie)) {
+            error_setg(errp, "Crucible hot-fork child QMP release requires "
+                       "the exact retained basis");
+            goto out;
+        }
+        if (!crucible_hot_fork_stage_release_allowed("child QMP", errp)) {
+            goto out;
+        }
+        if (crucible_hot_fork_plugin_endpoint_stage.staged) {
+            error_setg(errp, "Cannot release Crucible hot-fork child QMP "
+                       "before plugin endpoints release the sealed plan");
+            goto out;
+        }
+        close(crucible_hot_fork_qmp_stage.fd);
+        crucible_hot_fork_qmp_stage.fd = -1;
+        g_clear_pointer(&crucible_hot_fork_qmp_stage.fdname, g_free);
+        crucible_hot_fork_qmp_stage.staged = false;
+        crucible_hot_fork_qmp_stage.socket_cookie = 0;
+        crucible_hot_fork_qmp_stage.template_generation = 0;
+        crucible_hot_fork_qmp_stage.monitor_generation = 0;
+        monitor_hot_fork_reset_child_basis(
+            &crucible_hot_fork_qmp_child_basis);
+        qemu_crucible_hot_fork_reset_qmp_child_resources(
+            &crucible_hot_fork_qmp_child_resources);
+        qemu_crucible_hot_fork_reset_qmp_child_reinitializer(
+            &crucible_hot_fork_qmp_child_reinitializer);
+        crucible_hot_fork_qmp_stage.generation++;
+        assert(crucible_hot_fork_qmp_stage.generation != 0);
+        report = crucible_hot_fork_qmp_report();
+        break;
+    default:
+        g_assert_not_reached();
+    }
+out:
+    g_free(plugin_barrier);
+    if (candidate >= 0) {
+        close(candidate);
+    }
+    g_mutex_unlock(&crucible_hot_fork_template_lock);
+    return report;
+}
+
+static bool crucible_hot_fork_console_resource_plan_bound(void)
+{
+    if (crucible_hot_fork_child_active) {
+        return crucible_hot_fork_console_stage.staged &&
+            qemu_crucible_hot_fork_console_child_reinitializer_complete(
+                &crucible_hot_fork_console_child_reinitializer) &&
+            qemu_crucible_hot_fork_child_resource_plan_contains_console(
+                &crucible_hot_fork_child_resource_plan,
+                &crucible_hot_fork_console_child_resources);
+    }
+    return crucible_hot_fork_console_stage.staged &&
+        qemu_chr_socket_hot_fork_child_basis_matches(
+            &crucible_hot_fork_console_child_basis,
+            crucible_hot_fork_console_child_basis.chardev,
+            crucible_hot_fork_console_child_basis.frontend,
+            crucible_hot_fork_console_child_basis.context) &&
+        qemu_crucible_hot_fork_console_child_resources_prepared_for(
+            &crucible_hot_fork_console_child_resources,
+            crucible_hot_fork_console_stage.fd,
+            crucible_hot_fork_console_stage.socket_cookie,
+            crucible_hot_fork_console_stage.template_generation,
+            crucible_hot_fork_console_stage.generation) &&
+        qemu_crucible_hot_fork_console_child_reinitializer_prepared_for(
+            &crucible_hot_fork_console_child_reinitializer,
+            &crucible_hot_fork_console_child_resources,
+            crucible_hot_fork_reinitialize_child_console,
+            &crucible_hot_fork_console_child_basis) &&
+        qemu_crucible_hot_fork_child_resource_plan_contains_console(
+            &crucible_hot_fork_child_resource_plan,
+            &crucible_hot_fork_console_child_resources);
+}
+
+static CrucibleHotForkConsoleState *crucible_hot_fork_console_report(void)
+{
+    CrucibleHotForkConsoleState *report =
+        g_new0(CrucibleHotForkConsoleState, 1);
+    bool child_basis = crucible_hot_fork_child_active &&
+        crucible_hot_fork_console_child_basis.prepared &&
+        crucible_hot_fork_console_child_basis.attempted &&
+        crucible_hot_fork_console_child_basis.inherited_disposed &&
+        crucible_hot_fork_console_child_basis.replacement_attached;
+
+    report->schema_version = 1;
+    report->generation = crucible_hot_fork_console_stage.generation;
+    report->template_generation =
+        crucible_hot_fork_console_stage.template_generation;
+    report->staged = crucible_hot_fork_console_stage.staged;
+    if (report->staged) {
+        report->fdname = g_strdup(crucible_hot_fork_console_stage.fdname);
+    }
+    report->socket_cookie = crucible_hot_fork_console_stage.socket_cookie;
+    report->retained_fd = report->staged ?
+        crucible_hot_fork_console_stage.fd : -1;
+    report->resource_plan_bound =
+        crucible_hot_fork_console_resource_plan_bound();
+    report->nonblocking_unix_stream = report->staged;
+    report->console_basis_bound = report->staged &&
+        (child_basis || qemu_chr_socket_hot_fork_child_basis_matches(
+            &crucible_hot_fork_console_child_basis,
+            crucible_hot_fork_console_child_basis.chardev,
+            crucible_hot_fork_console_child_basis.frontend,
+            crucible_hot_fork_console_child_basis.context));
+    report->reinitializer_prepared = report->staged &&
+        (child_basis ?
+         crucible_hot_fork_console_child_reinitializer.prepared :
+         qemu_crucible_hot_fork_console_child_reinitializer_prepared_for(
+             &crucible_hot_fork_console_child_reinitializer,
+             &crucible_hot_fork_console_child_resources,
+             crucible_hot_fork_reinitialize_child_console,
+             &crucible_hot_fork_console_child_basis));
+    report->reinitialized =
+        crucible_hot_fork_console_child_reinitializer.initialized;
+    report->disposition_complete = report->reinitialized && child_basis;
+    report->readiness_proof_acknowledged = report->disposition_complete &&
+        !crucible_hot_fork_console_child_basis.input_held;
+    return report;
+}
+
+static bool crucible_hot_fork_console_stage_matches(
+    const char *fdname, uint64_t socket_cookie)
+{
+    return crucible_hot_fork_console_stage.staged && fdname &&
+        strcmp(crucible_hot_fork_console_stage.fdname, fdname) == 0 &&
+        crucible_hot_fork_console_stage.socket_cookie == socket_cookie;
+}
+
+CrucibleHotForkConsoleState *qmp_crucible_hot_fork_child_console(
+    CrucibleHotForkConsoleAction action, const char *fdname,
+    bool has_expected_socket_cookie, uint64_t expected_socket_cookie,
+    Error **errp)
+{
+    CrucibleHotForkConsoleState *report = NULL;
+    CrucibleHotForkPluginBarrierState *plugin_barrier = NULL;
+    QemuChrSocketHotForkChildBasis candidate_basis = { 0 };
+    Chardev *console;
+    uint64_t observed_socket_cookie = 0;
+    uint64_t next_generation;
+    int candidate = -1;
+    int result;
+
+    g_autoptr(BQLLockAuto) admission_bql =
+        action != CRUCIBLE_HOT_FORK_CONSOLE_ACTION_QUERY ?
+        bql_auto_lock(__FILE__, __LINE__) : NULL;
+
+    g_mutex_lock(&crucible_hot_fork_template_lock);
+    switch (action) {
+    case CRUCIBLE_HOT_FORK_CONSOLE_ACTION_STAGE:
+        if (!fdname || !has_expected_socket_cookie ||
+            expected_socket_cookie == 0 ||
+            !crucible_hot_fork_private_ring_fd_name_valid(fdname)) {
+            error_setg(errp, "Crucible hot-fork child console requires one "
+                       "exact bounded descriptor identity");
+            goto out;
+        }
+        if (!crucible_hot_fork_template_active ||
+            !crucible_hot_fork_qmp_stage.staged ||
+            crucible_hot_fork_qmp_stage.template_generation !=
+                crucible_hot_fork_template_generation) {
+            error_setg(errp, "Crucible hot-fork child console requires a "
+                       "matching retained template and child QMP endpoint");
+            goto out;
+        }
+        if (!crucible_hot_fork_resource_stage_allowed(
+                &plugin_barrier, errp)) {
+            goto out;
+        }
+        console = qemu_chr_find("crucible-console");
+        if (!console || !console->fe ||
+            !qemu_chr_has_feature(console, QEMU_CHAR_FEATURE_GCONTEXT)) {
+            error_setg(errp, "Crucible hot-fork requires the exact connected "
+                       "crucible-console frontend");
+            goto out;
+        }
+        result = qemu_chr_socket_hot_fork_prepare_child_basis(
+            &candidate_basis, console, console->fe, console->gcontext);
+        if (result != 0) {
+            error_setg_errno(errp, -result,
+                             "Could not bind Crucible hot-fork child console "
+                             "basis");
+            goto out;
+        }
+        candidate = monitor_dup_fd(monitor_cur(), fdname, errp);
+        if (candidate < 0) {
+            goto out;
+        }
+        if (!crucible_hot_fork_nonblocking_socket_cookie(
+                candidate, &observed_socket_cookie, errp)) {
+            goto out;
+        }
+        if (observed_socket_cookie != expected_socket_cookie ||
+            expected_socket_cookie ==
+                crucible_hot_fork_diagnostic_stage.socket_cookie ||
+            expected_socket_cookie ==
+                crucible_hot_fork_qmp_stage.socket_cookie ||
+            candidate == crucible_hot_fork_private_ring_stage.fd ||
+            candidate == crucible_hot_fork_diagnostic_stage.fd ||
+            candidate == crucible_hot_fork_qmp_stage.fd) {
+            error_setg(errp, "Crucible hot-fork child console aliases another "
+                       "retained resource");
+            goto out;
+        }
+        if (crucible_hot_fork_console_stage.staged) {
+            if (!crucible_hot_fork_console_stage_matches(
+                    fdname, expected_socket_cookie) ||
+                crucible_hot_fork_console_stage.template_generation !=
+                    crucible_hot_fork_template_generation ||
+                !qemu_chr_socket_hot_fork_child_basis_matches(
+                    &crucible_hot_fork_console_child_basis, console,
+                    console->fe, console->gcontext)) {
+                error_setg(errp, "Different Crucible hot-fork child console "
+                           "endpoint is already staged");
+                goto out;
+            }
+            report = crucible_hot_fork_console_report();
+            goto out;
+        }
+        if (crucible_hot_fork_plugin_endpoint_stage.staged) {
+            error_setg(errp, "Crucible hot-fork child console must be staged "
+                       "before plugin endpoints seal the child plan");
+            goto out;
+        }
+        if (crucible_hot_fork_console_stage.generation == UINT64_MAX) {
+            error_setg(errp, "Crucible hot-fork child console generation is "
+                       "exhausted");
+            goto out;
+        }
+        next_generation = crucible_hot_fork_console_stage.generation + 1;
+        result = qemu_crucible_hot_fork_prepare_console_child_resources(
+            &crucible_hot_fork_console_child_resources, candidate,
+            expected_socket_cookie, crucible_hot_fork_template_generation,
+            next_generation);
+        if (result == 0) {
+            result = qemu_crucible_hot_fork_prepare_console_child_reinitializer(
+                &crucible_hot_fork_console_child_reinitializer,
+                &crucible_hot_fork_console_child_resources,
+                crucible_hot_fork_reinitialize_child_console,
+                &crucible_hot_fork_console_child_basis);
+        }
+        if (result != 0 || !qemu_chr_socket_hot_fork_child_basis_matches(
+                &candidate_basis, console, console->fe, console->gcontext)) {
+            qemu_crucible_hot_fork_reset_console_child_reinitializer(
+                &crucible_hot_fork_console_child_reinitializer);
+            qemu_crucible_hot_fork_reset_console_child_resources(
+                &crucible_hot_fork_console_child_resources);
+            error_setg_errno(errp, result != 0 ? -result : ESTALE,
+                             "Could not prepare Crucible hot-fork child "
+                             "console runtime");
+            goto out;
+        }
+        crucible_hot_fork_console_stage.staged = true;
+        crucible_hot_fork_console_stage.fd = candidate;
+        candidate = -1;
+        crucible_hot_fork_console_stage.fdname = g_strdup(fdname);
+        crucible_hot_fork_console_stage.socket_cookie =
+            expected_socket_cookie;
+        crucible_hot_fork_console_stage.template_generation =
+            crucible_hot_fork_template_generation;
+        crucible_hot_fork_console_stage.generation = next_generation;
+        crucible_hot_fork_console_child_basis = candidate_basis;
+        crucible_hot_fork_console_child_reinitializer.runtime_opaque =
+            &crucible_hot_fork_console_child_basis;
+        report = crucible_hot_fork_console_report();
+        break;
+    case CRUCIBLE_HOT_FORK_CONSOLE_ACTION_QUERY:
+        if (fdname || has_expected_socket_cookie) {
+            error_setg(errp, "Crucible hot-fork child console query accepts "
+                       "no descriptor identity");
+            goto out;
+        }
+        report = crucible_hot_fork_console_report();
+        break;
+    case CRUCIBLE_HOT_FORK_CONSOLE_ACTION_RELEASE:
+        if (!fdname || !has_expected_socket_cookie ||
+            !crucible_hot_fork_console_stage_matches(
+                fdname, expected_socket_cookie)) {
+            error_setg(errp, "Crucible hot-fork child console release "
+                       "requires the exact retained basis");
+            goto out;
+        }
+        if (!crucible_hot_fork_stage_release_allowed("child console", errp)) {
+            goto out;
+        }
+        if (crucible_hot_fork_plugin_endpoint_stage.staged) {
+            error_setg(errp, "Cannot release Crucible hot-fork child console "
+                       "before its plugin endpoints");
+            goto out;
+        }
+        close(crucible_hot_fork_console_stage.fd);
+        crucible_hot_fork_console_stage.fd = -1;
+        g_clear_pointer(&crucible_hot_fork_console_stage.fdname, g_free);
+        crucible_hot_fork_console_stage.staged = false;
+        crucible_hot_fork_console_stage.socket_cookie = 0;
+        crucible_hot_fork_console_stage.template_generation = 0;
+        crucible_hot_fork_console_child_basis =
+            (QemuChrSocketHotForkChildBasis) { 0 };
+        qemu_crucible_hot_fork_reset_console_child_resources(
+            &crucible_hot_fork_console_child_resources);
+        qemu_crucible_hot_fork_reset_console_child_reinitializer(
+            &crucible_hot_fork_console_child_reinitializer);
+        crucible_hot_fork_console_stage.generation++;
+        assert(crucible_hot_fork_console_stage.generation != 0);
+        report = crucible_hot_fork_console_report();
+        break;
+    default:
+        g_assert_not_reached();
+    }
+out:
+    g_free(plugin_barrier);
+    if (candidate >= 0) {
+        close(candidate);
+    }
+    g_mutex_unlock(&crucible_hot_fork_template_lock);
+    return report;
+}
+
+CrucibleHotForkPluginEndpointState *
+qmp_crucible_hot_fork_plugin_endpoints(
+    CrucibleHotForkPluginEndpointAction action,
+    const char *control_fdname, const char *wake_fdname,
+    bool has_expected_control_socket_cookie,
+    uint64_t expected_control_socket_cookie,
+    bool has_expected_wake_eventfd_id, uint64_t expected_wake_eventfd_id,
+    Error **errp)
+{
+    CrucibleHotForkPluginEndpointState *report = NULL;
+    CrucibleHotForkPluginBarrierState *plugin_barrier = NULL;
+    QemuPluginCrucibleHotForkInventory resources = { 0 };
+    struct qemu_plugin_crucible_hot_fork_child_plan child_plan = { 0 };
+    uint64_t observed_control_socket_cookie = 0;
+    uint64_t observed_wake_eventfd_id = 0;
+    uint64_t next_endpoint_generation;
+    int control_candidate = -1;
+    int wake_candidate = -1;
+    int result;
+
+    g_autoptr(BQLLockAuto) admission_bql =
+        action != CRUCIBLE_HOT_FORK_PLUGIN_ENDPOINT_ACTION_QUERY ?
+        bql_auto_lock(__FILE__, __LINE__) : NULL;
+
+    g_mutex_lock(&crucible_hot_fork_template_lock);
+    switch (action) {
+    case CRUCIBLE_HOT_FORK_PLUGIN_ENDPOINT_ACTION_STAGE:
+        if (!control_fdname || !wake_fdname ||
+            !has_expected_control_socket_cookie ||
+            !has_expected_wake_eventfd_id ||
+            expected_control_socket_cookie == 0 ||
+            expected_wake_eventfd_id == 0 ||
+            strcmp(control_fdname, wake_fdname) == 0) {
+            error_setg(errp, "Crucible hot-fork plugin endpoint staging "
+                       "requires two distinct exact identities");
+            goto out;
+        }
+        if (!crucible_hot_fork_private_ring_fd_name_valid(control_fdname) ||
+            !crucible_hot_fork_private_ring_fd_name_valid(wake_fdname)) {
+            error_setg(errp, "Invalid Crucible hot-fork plugin endpoint name");
+            goto out;
+        }
+        if (!crucible_hot_fork_private_ring_stage.staged ||
+            crucible_hot_fork_private_ring_stage.generation == 0) {
+            error_setg(errp, "Crucible hot-fork plugin endpoint staging "
+                       "requires retained private rings");
+            goto out;
+        }
+        control_candidate = monitor_dup_fd(monitor_cur(), control_fdname, errp);
+        if (control_candidate < 0) {
+            goto out;
+        }
+        wake_candidate = monitor_dup_fd(monitor_cur(), wake_fdname, errp);
+        if (wake_candidate < 0) {
+            goto out;
+        }
+        if (!crucible_hot_fork_control_socket_cookie(
+                control_candidate, &observed_control_socket_cookie, errp) ||
+            !crucible_hot_fork_wake_eventfd_id(
+                wake_candidate, &observed_wake_eventfd_id, errp)) {
+            goto out;
+        }
+        if (observed_control_socket_cookie !=
+                expected_control_socket_cookie ||
+            observed_wake_eventfd_id != expected_wake_eventfd_id) {
+            error_setg(errp, "Crucible hot-fork plugin endpoint identity "
+                       "mismatch");
+            goto out;
+        }
+        if (crucible_hot_fork_plugin_endpoint_stage.staged) {
+            if (!crucible_hot_fork_plugin_endpoint_stage_matches(
+                    control_fdname, wake_fdname,
+                    expected_control_socket_cookie,
+                    expected_wake_eventfd_id)) {
+                error_setg(errp, "Different Crucible hot-fork plugin "
+                           "endpoints are already staged");
+                goto out;
+            }
+            if (!crucible_hot_fork_resource_stage_allowed(
+                    &plugin_barrier, errp)) {
+                goto out;
+            }
+            if (crucible_hot_fork_template_active &&
+                !crucible_hot_fork_plugin_worker_disposition_matches(
+                    plugin_barrier)) {
+                error_setg(errp, "Crucible hot-fork plugin worker "
+                           "disposition no longer matches the retained "
+                           "plugin barrier");
+                goto out;
+            }
+            if (crucible_hot_fork_template_active &&
+                !crucible_hot_fork_plugin_child_plan_bound(
+                    plugin_barrier, NULL, NULL)) {
+                error_setg(errp, "Crucible hot-fork plugin child plan no "
+                           "longer matches the retained template");
+                goto out;
+            }
+            if (crucible_hot_fork_template_active &&
+                !crucible_hot_fork_plugin_child_resource_plan_bound(
+                    plugin_barrier)) {
+                error_setg(errp, "Crucible hot-fork plugin child resource "
+                           "plan no longer matches the retained template");
+                goto out;
+            }
+            report = crucible_hot_fork_plugin_endpoint_report();
+            goto out;
+        }
+        if (!crucible_hot_fork_resource_stage_allowed(
+                &plugin_barrier, errp)) {
+            goto out;
+        }
+        if (crucible_hot_fork_private_ring_stage.template_generation !=
+            crucible_hot_fork_resource_template_generation()) {
+            error_setg(errp, "Crucible hot-fork plugin endpoints require "
+                       "private rings from the same template transaction");
+            goto out;
+        }
+        if (plugin_barrier &&
+            (!crucible_hot_fork_diagnostic_stage.staged ||
+             crucible_hot_fork_diagnostic_stage.template_generation !=
+                 crucible_hot_fork_resource_template_generation() ||
+             !qemu_crucible_hot_fork_diagnostics_child_resources_prepared_for(
+                 &crucible_hot_fork_diagnostics_child_resources,
+                 crucible_hot_fork_diagnostic_stage.fd,
+                 crucible_hot_fork_diagnostic_stage.socket_cookie))) {
+            error_setg(errp, "Crucible hot-fork plugin endpoints require "
+                       "branch-private diagnostics from the same template");
+            goto out;
+        }
+        if (plugin_barrier &&
+            (!crucible_hot_fork_qmp_stage.staged ||
+             crucible_hot_fork_qmp_stage.template_generation !=
+                 crucible_hot_fork_resource_template_generation() ||
+             !qemu_crucible_hot_fork_qmp_child_resources_prepared_for(
+                 &crucible_hot_fork_qmp_child_resources,
+                 crucible_hot_fork_qmp_stage.fd,
+                 crucible_hot_fork_qmp_stage.socket_cookie,
+                 crucible_hot_fork_qmp_stage.template_generation,
+                 crucible_hot_fork_qmp_stage.generation,
+                 crucible_hot_fork_qmp_stage.monitor_generation))) {
+            error_setg(errp, "Crucible hot-fork plugin endpoints require "
+                       "branch-private QMP from the same template");
+            goto out;
+        }
+        if (plugin_barrier &&
+            (!crucible_hot_fork_console_stage.staged ||
+             crucible_hot_fork_console_stage.template_generation !=
+                 crucible_hot_fork_resource_template_generation() ||
+             !qemu_crucible_hot_fork_console_child_resources_prepared_for(
+                 &crucible_hot_fork_console_child_resources,
+                 crucible_hot_fork_console_stage.fd,
+                 crucible_hot_fork_console_stage.socket_cookie,
+                 crucible_hot_fork_console_stage.template_generation,
+                 crucible_hot_fork_console_stage.generation))) {
+            error_setg(errp, "Crucible hot-fork plugin endpoints require "
+                       "branch-private console from the same template");
+            goto out;
+        }
+        if (plugin_barrier) {
+            qemu_plugin_crucible_hot_fork_inventory(&resources);
+            if (!resources.complete ||
+                resources.manifest.process_generation == 0 ||
+                resources.manifest.process_generation == UINT64_MAX ||
+                resources.manifest.control_fd < 0 ||
+                resources.manifest.wake_fd < 0 ||
+                resources.manifest.control_fd == resources.manifest.wake_fd ||
+                control_candidate == resources.manifest.control_fd ||
+                control_candidate == resources.manifest.wake_fd ||
+                wake_candidate == resources.manifest.control_fd ||
+                wake_candidate == resources.manifest.wake_fd ||
+                expected_control_socket_cookie ==
+                    crucible_hot_fork_diagnostic_stage.socket_cookie ||
+                expected_control_socket_cookie ==
+                    crucible_hot_fork_qmp_stage.socket_cookie ||
+                expected_control_socket_cookie ==
+                    crucible_hot_fork_console_stage.socket_cookie ||
+                crucible_hot_fork_diagnostic_stage.fd ==
+                    resources.manifest.control_fd ||
+                crucible_hot_fork_diagnostic_stage.fd ==
+                    resources.manifest.wake_fd ||
+                crucible_hot_fork_qmp_stage.fd ==
+                    resources.manifest.control_fd ||
+                crucible_hot_fork_qmp_stage.fd ==
+                    resources.manifest.wake_fd ||
+                crucible_hot_fork_console_stage.fd ==
+                    resources.manifest.control_fd ||
+                crucible_hot_fork_console_stage.fd ==
+                    resources.manifest.wake_fd ||
+                crucible_hot_fork_private_ring_stage.fd ==
+                    resources.manifest.control_fd ||
+                crucible_hot_fork_private_ring_stage.fd ==
+                    resources.manifest.wake_fd) {
+                error_setg(errp, "Crucible hot-fork plugin endpoint "
+                           "replacement slots are not exact and distinct");
+                goto out;
+            }
+            if (!crucible_hot_fork_endpoint_objects_private(
+                    resources.manifest.control_fd,
+                    resources.manifest.wake_fd,
+                    observed_control_socket_cookie,
+                    observed_wake_eventfd_id, errp)) {
+                goto out;
+            }
+        }
+        if (crucible_hot_fork_plugin_endpoint_stage.generation == UINT64_MAX) {
+            error_setg(errp, "Crucible hot-fork plugin endpoint generation "
+                       "is exhausted");
+            goto out;
+        }
+        next_endpoint_generation =
+            crucible_hot_fork_plugin_endpoint_stage.generation + 1;
+        if (plugin_barrier) {
+            if (!crucible_hot_fork_build_plugin_child_plan(
+                    &resources, plugin_barrier, next_endpoint_generation,
+                    expected_control_socket_cookie, expected_wake_eventfd_id,
+                    &child_plan)) {
+                const char *blocker =
+                    crucible_hot_fork_plugin_child_plan_blocker(
+                        &resources, plugin_barrier,
+                        next_endpoint_generation,
+                        expected_control_socket_cookie,
+                        expected_wake_eventfd_id);
+
+                error_setg(errp, "Could not bind the Crucible hot-fork plugin "
+                           "child plan to the retained template: %s",
+                           blocker ? blocker : "plan storage is absent");
+                goto out;
+            }
+            result =
+                qemu_crucible_hot_fork_prepare_plugin_child_reinitializer(
+                    &crucible_hot_fork_plugin_child_reinitializer,
+                    &child_plan);
+            if (result != 0) {
+                error_setg_errno(errp, -result,
+                                 "Could not prepare the Crucible hot-fork "
+                                 "plugin child runtime");
+                goto out;
+            }
+            result = qemu_crucible_hot_fork_prepare_plugin_child_resources(
+                &crucible_hot_fork_plugin_child_resources, &child_plan,
+                control_candidate, wake_candidate);
+            if (result != 0) {
+                qemu_crucible_hot_fork_reset_plugin_child_reinitializer(
+                    &crucible_hot_fork_plugin_child_reinitializer);
+                error_setg_errno(errp, -result,
+                                 "Could not prepare the Crucible hot-fork "
+                                 "plugin child resource tables");
+                goto out;
+            }
+            result = qemu_crucible_hot_fork_begin_child_resource_plan(
+                &crucible_hot_fork_child_resource_plan,
+                &crucible_hot_fork_plugin_child_resources);
+            if (result == 0) {
+                result =
+                    qemu_crucible_hot_fork_merge_diagnostics_child_resources(
+                        &crucible_hot_fork_child_resource_plan,
+                        &crucible_hot_fork_diagnostics_child_resources);
+            }
+            if (result == 0) {
+                result = qemu_crucible_hot_fork_merge_qmp_child_resources(
+                    &crucible_hot_fork_child_resource_plan,
+                    &crucible_hot_fork_qmp_child_resources);
+            }
+            if (result == 0) {
+                result =
+                    qemu_crucible_hot_fork_merge_console_child_resources(
+                        &crucible_hot_fork_child_resource_plan,
+                        &crucible_hot_fork_console_child_resources);
+            }
+            if (result == 0) {
+                result = qemu_crucible_hot_fork_seal_child_resource_plan(
+                    &crucible_hot_fork_child_resource_plan);
+            }
+            if (result != 0) {
+                qemu_crucible_hot_fork_reset_plugin_child_reinitializer(
+                    &crucible_hot_fork_plugin_child_reinitializer);
+                qemu_crucible_hot_fork_reset_plugin_child_resources(
+                    &crucible_hot_fork_plugin_child_resources);
+                qemu_crucible_hot_fork_reset_child_resource_plan(
+                    &crucible_hot_fork_child_resource_plan);
+                error_setg_errno(errp, -result,
+                                 "Could not compose the Crucible hot-fork "
+                                 "child resource plan");
+                goto out;
+            }
+        } else {
+            qemu_crucible_hot_fork_reset_plugin_child_reinitializer(
+                &crucible_hot_fork_plugin_child_reinitializer);
+            qemu_crucible_hot_fork_reset_plugin_child_resources(
+                &crucible_hot_fork_plugin_child_resources);
+            qemu_crucible_hot_fork_reset_child_resource_plan(
+                &crucible_hot_fork_child_resource_plan);
+        }
+        crucible_hot_fork_plugin_endpoint_stage.staged = true;
+        crucible_hot_fork_plugin_endpoint_stage.control_fd = control_candidate;
+        control_candidate = -1;
+        crucible_hot_fork_plugin_endpoint_stage.wake_fd = wake_candidate;
+        wake_candidate = -1;
+        crucible_hot_fork_plugin_endpoint_stage.control_fdname =
+            g_strdup(control_fdname);
+        crucible_hot_fork_plugin_endpoint_stage.wake_fdname =
+            g_strdup(wake_fdname);
+        crucible_hot_fork_plugin_endpoint_stage.control_socket_cookie =
+            expected_control_socket_cookie;
+        crucible_hot_fork_plugin_endpoint_stage.wake_eventfd_id =
+            expected_wake_eventfd_id;
+        if (plugin_barrier) {
+            crucible_hot_fork_plugin_endpoint_stage.control_target_fd =
+                resources.manifest.control_fd;
+            crucible_hot_fork_plugin_endpoint_stage.wake_target_fd =
+                resources.manifest.wake_fd;
+            crucible_hot_fork_plugin_endpoint_stage.replacement_plan_bound =
+                true;
+        }
+        crucible_hot_fork_plugin_endpoint_stage.private_ring_generation =
+            crucible_hot_fork_private_ring_stage.generation;
+        crucible_hot_fork_plugin_endpoint_stage.template_generation =
+            crucible_hot_fork_private_ring_stage.template_generation;
+        if (plugin_barrier) {
+            crucible_hot_fork_plugin_endpoint_stage.plugin_barrier_generation =
+                plugin_barrier->generation;
+            crucible_hot_fork_plugin_endpoint_stage.worker_mask =
+                plugin_barrier->worker_mask;
+            crucible_hot_fork_plugin_endpoint_stage.parent_resume_worker_mask =
+                plugin_barrier->worker_mask;
+            crucible_hot_fork_plugin_endpoint_stage.
+                child_reinitialize_worker_mask = plugin_barrier->worker_mask;
+        }
+        crucible_hot_fork_plugin_endpoint_stage.generation =
+            next_endpoint_generation;
+        report = crucible_hot_fork_plugin_endpoint_report();
+        break;
+    case CRUCIBLE_HOT_FORK_PLUGIN_ENDPOINT_ACTION_QUERY:
+        if (control_fdname || wake_fdname ||
+            has_expected_control_socket_cookie ||
+            has_expected_wake_eventfd_id) {
+            error_setg(errp, "Crucible hot-fork plugin endpoint query accepts "
+                       "no descriptor identity");
+            goto out;
+        }
+        report = crucible_hot_fork_plugin_endpoint_report();
+        break;
+    case CRUCIBLE_HOT_FORK_PLUGIN_ENDPOINT_ACTION_RELEASE:
+        if (!control_fdname || !wake_fdname ||
+            !has_expected_control_socket_cookie ||
+            !has_expected_wake_eventfd_id ||
+            !crucible_hot_fork_private_ring_fd_name_valid(control_fdname) ||
+            !crucible_hot_fork_private_ring_fd_name_valid(wake_fdname)) {
+            error_setg(errp, "Crucible hot-fork plugin endpoint release "
+                       "requires the exact retained basis");
+            goto out;
+        }
+        if (!crucible_hot_fork_plugin_endpoint_stage.staged) {
+            error_setg(errp,
+                       "No Crucible hot-fork plugin endpoints are staged");
+            goto out;
+        }
+        if (!crucible_hot_fork_plugin_endpoint_stage_matches(
+                control_fdname, wake_fdname,
+                expected_control_socket_cookie,
+                expected_wake_eventfd_id)) {
+            error_setg(errp, "Crucible hot-fork plugin endpoint release basis "
+                       "does not match the retained endpoints");
+            goto out;
+        }
+        if (!crucible_hot_fork_stage_release_allowed("plugin endpoints",
+                                                     errp)) {
+            goto out;
+        }
+        close(crucible_hot_fork_plugin_endpoint_stage.control_fd);
+        close(crucible_hot_fork_plugin_endpoint_stage.wake_fd);
+        crucible_hot_fork_plugin_endpoint_stage.control_fd = -1;
+        crucible_hot_fork_plugin_endpoint_stage.wake_fd = -1;
+        g_clear_pointer(
+            &crucible_hot_fork_plugin_endpoint_stage.control_fdname, g_free);
+        g_clear_pointer(
+            &crucible_hot_fork_plugin_endpoint_stage.wake_fdname, g_free);
+        crucible_hot_fork_plugin_endpoint_stage.staged = false;
+        crucible_hot_fork_plugin_endpoint_stage.control_socket_cookie = 0;
+        crucible_hot_fork_plugin_endpoint_stage.wake_eventfd_id = 0;
+        crucible_hot_fork_plugin_endpoint_stage.control_target_fd = 0;
+        crucible_hot_fork_plugin_endpoint_stage.wake_target_fd = 0;
+        crucible_hot_fork_plugin_endpoint_stage.replacement_plan_bound = false;
+        crucible_hot_fork_plugin_endpoint_stage.private_ring_generation = 0;
+        crucible_hot_fork_plugin_endpoint_stage.template_generation = 0;
+        crucible_hot_fork_plugin_endpoint_stage.plugin_barrier_generation = 0;
+        crucible_hot_fork_plugin_endpoint_stage.worker_mask = 0;
+        crucible_hot_fork_plugin_endpoint_stage.parent_resume_worker_mask = 0;
+        crucible_hot_fork_plugin_endpoint_stage.
+            child_reinitialize_worker_mask = 0;
+        qemu_crucible_hot_fork_reset_plugin_child_reinitializer(
+            &crucible_hot_fork_plugin_child_reinitializer);
+        qemu_crucible_hot_fork_reset_plugin_child_resources(
+            &crucible_hot_fork_plugin_child_resources);
+        qemu_crucible_hot_fork_reset_child_resource_plan(
+            &crucible_hot_fork_child_resource_plan);
+        crucible_hot_fork_plugin_endpoint_stage.generation++;
+        assert(crucible_hot_fork_plugin_endpoint_stage.generation != 0);
+        report = crucible_hot_fork_plugin_endpoint_report();
+        break;
+    default:
+        g_assert_not_reached();
+    }
+out:
+    g_free(plugin_barrier);
+    if (control_candidate >= 0) {
+        close(control_candidate);
+    }
+    if (wake_candidate >= 0) {
+        close(wake_candidate);
+    }
+    g_mutex_unlock(&crucible_hot_fork_template_lock);
+    return report;
+}
+
+static void crucible_hot_fork_template_complete(
+    CrucibleHotForkTemplateOutcome outcome)
+{
+    /* A partial source transition must retain the transaction for recovery. */
+    assert(!crucible_hot_fork_template_sources);
+    crucible_hot_fork_template_control_release();
+    /*
+     * The template's RAM forkability ends with it; a failure to restore
+     * MADV_DONTFORK only widens what a later helper fork would copy, so it
+     * is reported rather than fatal.
+     */
+    if (qemu_crucible_hot_fork_ram_set_forkable(false) != 0) {
+        error_report("Crucible hot-fork template could not restore guest "
+                     "RAM fork protection");
+    }
+    g_clear_pointer(&crucible_hot_fork_template_snapshot_bindings, g_free);
+    crucible_hot_fork_template_snapshot_binding_count = 0;
+    crucible_hot_fork_template_active = false;
+    crucible_hot_fork_template_abort_requested = false;
+    crucible_hot_fork_template_phase =
+        CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_COMPLETED;
+    crucible_hot_fork_template_completion = outcome;
+}
+
+static void crucible_hot_fork_template_record_failure(
+    CrucibleHotForkTemplateFailureStage stage, const Error *error)
+{
+    const char *detail = error ? error_get_pretty(error) : "no QEMU error detail";
+
+    crucible_hot_fork_template_failure_stage = stage;
+    g_free(crucible_hot_fork_template_failure_detail);
+    crucible_hot_fork_template_failure_detail = g_strndup(detail, 255);
+    if (!g_utf8_validate(crucible_hot_fork_template_failure_detail, -1, NULL)) {
+        g_free(crucible_hot_fork_template_failure_detail);
+        crucible_hot_fork_template_failure_detail =
+            g_strdup("failure detail was not valid UTF-8");
+    }
+}
+
+static bool crucible_hot_fork_template_copy_snapshot_bindings(
+    CrucibleHotForkBlockSnapshotBindingList *bindings,
+    Error **errp)
+{
+    CrucibleHotForkBlockSnapshotBindingList *node;
+    QemuBlockBackendHotForkSnapshotBinding *copy;
+    size_t count = 0;
+    size_t index = 0;
+
+    for (node = bindings; node; node = node->next) {
+        if (count == QEMU_BLOCK_BACKEND_HOT_FORK_INVENTORY_MAX) {
+            error_setg(errp, "too many Crucible hot-fork block snapshot "
+                       "bindings");
+            return false;
+        }
+        count++;
+    }
+    copy = g_new0(QemuBlockBackendHotForkSnapshotBinding, count);
+    for (node = bindings; node; node = node->next, index++) {
+        CrucibleHotForkBlockSnapshotBinding *source = node->value;
+
+        copy[index].backend_id = source->backend_id;
+        if (strlen(source->backend_name) >
+                QEMU_BLOCK_BACKEND_HOT_FORK_NAME_MAX ||
+            strlen(source->overlay_node_name) >
+                QEMU_BLOCK_BACKEND_HOT_FORK_NODE_NAME_MAX ||
+            strlen(source->snapshot_node_name) >
+                QEMU_BLOCK_BACKEND_HOT_FORK_NODE_NAME_MAX ||
+            strlen(source->snapshot_content_id) >
+                QEMU_BLOCK_BACKEND_HOT_FORK_CONTENT_ID_HEX_LENGTH) {
+            error_setg(errp, "oversized Crucible hot-fork block snapshot "
+                       "binding");
+            g_free(copy);
+            return false;
+        }
+        g_strlcpy(copy[index].backend_name, source->backend_name,
+                  sizeof(copy[index].backend_name));
+        g_strlcpy(copy[index].overlay_node_name, source->overlay_node_name,
+                  sizeof(copy[index].overlay_node_name));
+        g_strlcpy(copy[index].snapshot_node_name,
+                  source->snapshot_node_name,
+                  sizeof(copy[index].snapshot_node_name));
+        g_strlcpy(copy[index].snapshot_content_id,
+                  source->snapshot_content_id,
+                  sizeof(copy[index].snapshot_content_id));
+    }
+
+    crucible_hot_fork_template_snapshot_binding_count = count;
+    crucible_hot_fork_template_snapshot_bindings = copy;
+    return true;
+}
+
+static bool crucible_hot_fork_template_snapshot_bindings_match(
+    CrucibleHotForkBlockSnapshotBindingList *bindings)
+{
+    CrucibleHotForkBlockSnapshotBindingList *node;
+    size_t index = 0;
+
+    for (node = bindings; node; node = node->next, index++) {
+        QemuBlockBackendHotForkSnapshotBinding *expected;
+        CrucibleHotForkBlockSnapshotBinding *actual = node->value;
+
+        if (index == crucible_hot_fork_template_snapshot_binding_count) {
+            return false;
+        }
+        expected = &crucible_hot_fork_template_snapshot_bindings[index];
+        if (expected->backend_id != actual->backend_id ||
+            strcmp(expected->backend_name, actual->backend_name) != 0 ||
+            strcmp(expected->overlay_node_name,
+                   actual->overlay_node_name) != 0 ||
+            strcmp(expected->snapshot_node_name,
+                   actual->snapshot_node_name) != 0 ||
+            strcmp(expected->snapshot_content_id,
+                   actual->snapshot_content_id) != 0) {
+            return false;
+        }
+    }
+    return index == crucible_hot_fork_template_snapshot_binding_count;
+}
+
+static QemuBlockHotForkSourceSet *crucible_hot_fork_template_capture_sources(
+    Error **errp)
+{
+    g_autoptr(GArray) roots =
+        g_array_new(false, false, sizeof(QemuBlockHotForkSourceRoot));
+    BlockBackend *backend = NULL;
+    BlockDriverState *node = NULL;
+
+    GLOBAL_STATE_CODE();
+    {
+        GRAPH_RDLOCK_GUARD_MAINLOOP();
+        while ((backend = blk_all_next(backend))) {
+            QemuBlockHotForkSourceRoot root = {
+                .backend = backend,
+                .root = blk_bs(backend),
+            };
+
+            if (roots->len == QEMU_BLOCK_BACKEND_HOT_FORK_INVENTORY_MAX) {
+                goto too_many;
+            }
+            g_array_append_val(roots, root);
+        }
+        while ((node = bdrv_next_all_states(node))) {
+            QemuBlockHotForkSourceRoot root = { .root = node };
+
+            if (!QLIST_EMPTY(&node->parents)) {
+                continue;
+            }
+            if (roots->len == QEMU_BLOCK_BACKEND_HOT_FORK_INVENTORY_MAX) {
+                goto too_many;
+            }
+            g_array_append_val(roots, root);
+        }
+    }
+    return qemu_block_hot_fork_source_set_new(
+        (const QemuBlockHotForkSourceRoot *)roots->data, roots->len, errp);
+too_many:
+    error_setg(errp, "Crucible template exceeds native source root bounds");
+    return NULL;
+}
+
+static bool crucible_hot_fork_template_freeze_sources(Error **errp)
+{
+    QemuBlockBackendHotForkBarrierInventory block;
+    bool success;
+
+    /* First authenticate the original writable snapshot boundary. Capturing
+     * references can change backend generation, so this proof is discarded
+     * before native reopen and explicitly rebound after the second hold. */
+    success = qemu_block_backend_hot_fork_snapshot_bind(
+        crucible_hot_fork_template_snapshot_bindings,
+        crucible_hot_fork_template_snapshot_binding_count, &block, errp);
+    if (success) {
+        success = block.snapshot_complete;
+        qemu_block_backend_hot_fork_barrier_inventory_destroy(&block);
+    }
+    if (!success) {
+        crucible_hot_fork_template_record_failure(
+            CRUCIBLE_HOT_FORK_TEMPLATE_FAILURE_STAGE_SOURCE_SNAPSHOT,
+            errp ? *errp : NULL);
+        return false;
+    }
+    crucible_hot_fork_template_sources =
+        crucible_hot_fork_template_capture_sources(errp);
+    if (!crucible_hot_fork_template_sources) {
+        crucible_hot_fork_template_record_failure(
+            CRUCIBLE_HOT_FORK_TEMPLATE_FAILURE_STAGE_SOURCE_CAPTURE,
+            errp ? *errp : NULL);
+        return false;
+    }
+    if (!qemu_crucible_block_seal_source_acquire(
+            crucible_hot_fork_template_sources, errp)) {
+        crucible_hot_fork_template_record_failure(
+            CRUCIBLE_HOT_FORK_TEMPLATE_FAILURE_STAGE_SOURCE_CAPTURE,
+            errp ? *errp : NULL);
+        return false;
+    }
+    success = qemu_block_backend_hot_fork_barrier(
+        QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_RELEASE, &block);
+    if (success) {
+        success = !block.held && !block.graph_held;
+        qemu_block_backend_hot_fork_barrier_inventory_destroy(&block);
+    }
+    if (!success || !qemu_block_hot_fork_source_set_freeze(
+            crucible_hot_fork_template_sources, errp)) {
+        crucible_hot_fork_template_record_failure(
+            success ? CRUCIBLE_HOT_FORK_TEMPLATE_FAILURE_STAGE_SOURCE_FREEZE :
+                      CRUCIBLE_HOT_FORK_TEMPLATE_FAILURE_STAGE_SOURCE_RELEASE,
+            errp ? *errp : NULL);
+        return false;
+    }
+    success = qemu_block_backend_hot_fork_barrier(
+        QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_HOLD, &block);
+    if (success) {
+        success = block.held;
+        qemu_block_backend_hot_fork_barrier_inventory_destroy(&block);
+    }
+    if (!success) {
+        crucible_hot_fork_template_record_failure(
+            CRUCIBLE_HOT_FORK_TEMPLATE_FAILURE_STAGE_BLOCK_REHOLD,
+            errp ? *errp : NULL);
+    }
+    return success;
+}
+
+static void crucible_hot_fork_template_block_transition(void *opaque)
+{
+    QemuBlockBackendHotForkBarrierInventory inventory;
+    Error *local_err = NULL;
+    bool success;
+
+    (void)opaque;
+    g_mutex_lock(&crucible_hot_fork_template_lock);
+    crucible_hot_fork_template_block_transition_scheduled = false;
+    switch (crucible_hot_fork_template_phase) {
+    case CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BLOCK_HOLD_PENDING:
+        if (crucible_hot_fork_template_abort_requested) {
+            crucible_hot_fork_template_complete(
+                CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_ABORTED);
+            break;
+        }
+        success = qemu_block_backend_hot_fork_barrier(
+            QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_HOLD, &inventory);
+        if (!success || !inventory.held) {
+            crucible_hot_fork_template_record_failure(
+                CRUCIBLE_HOT_FORK_TEMPLATE_FAILURE_STAGE_BLOCK_HOLD, NULL);
+            if (success) {
+                qemu_block_backend_hot_fork_barrier_inventory_destroy(
+                    &inventory);
+            }
+            crucible_hot_fork_template_complete(
+                CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_BLOCKED);
+            break;
+        }
+        if (inventory.owner_thread_id <= 0) {
+            crucible_hot_fork_template_record_failure(
+                CRUCIBLE_HOT_FORK_TEMPLATE_FAILURE_STAGE_BLOCK_OWNER, NULL);
+            qemu_block_backend_hot_fork_barrier_inventory_destroy(&inventory);
+            success = qemu_block_backend_hot_fork_barrier(
+                QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_RELEASE, &inventory);
+            if (success && !inventory.held) {
+                qemu_block_backend_hot_fork_barrier_inventory_destroy(
+                    &inventory);
+                crucible_hot_fork_template_complete(
+                    CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_BLOCKED);
+            } else {
+                if (success) {
+                    qemu_block_backend_hot_fork_barrier_inventory_destroy(
+                        &inventory);
+                }
+                crucible_hot_fork_template_completion =
+                    CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_BLOCKED;
+                crucible_hot_fork_template_phase =
+                    CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BLOCK_RELEASE_PENDING;
+                crucible_hot_fork_template_schedule_block_transition();
+            }
+            break;
+        }
+        qemu_block_backend_hot_fork_barrier_inventory_destroy(&inventory);
+        crucible_hot_fork_template_phase =
+            CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BLOCK_HELD;
+        break;
+    case CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_SNAPSHOT_BIND_PENDING:
+        if (crucible_hot_fork_template_abort_requested) {
+            crucible_hot_fork_template_completion =
+                CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_ABORTED;
+            crucible_hot_fork_template_phase =
+                CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BLOCK_RELEASE_PENDING;
+            crucible_hot_fork_template_schedule_block_transition();
+            break;
+        }
+        if (!crucible_hot_fork_template_sources &&
+            !crucible_hot_fork_template_freeze_sources(&local_err)) {
+            success = false;
+        } else if (qemu_block_backend_hot_fork_barrier(
+                       QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_QUERY, &inventory)) {
+            success = inventory.quiescent;
+            qemu_block_backend_hot_fork_barrier_inventory_destroy(&inventory);
+            if (!success) {
+                /* PREPARE retries advance acquisition after native I/O drains. */
+                break;
+            }
+            success = qemu_block_backend_hot_fork_snapshot_bind_frozen(
+                crucible_hot_fork_template_sources,
+                crucible_hot_fork_template_snapshot_bindings,
+                crucible_hot_fork_template_snapshot_binding_count,
+                &inventory, &local_err);
+            if (success) {
+                success = inventory.snapshot_complete &&
+                          inventory.snapshot_sources.frozen;
+                qemu_block_backend_hot_fork_barrier_inventory_destroy(&inventory);
+            }
+            if (!success) {
+                crucible_hot_fork_template_record_failure(
+                    CRUCIBLE_HOT_FORK_TEMPLATE_FAILURE_STAGE_FROZEN_SNAPSHOT,
+                    local_err);
+            }
+        } else {
+            success = false;
+            crucible_hot_fork_template_record_failure(
+                CRUCIBLE_HOT_FORK_TEMPLATE_FAILURE_STAGE_FROZEN_SNAPSHOT,
+                NULL);
+        }
+        if (success) {
+            /* Allocation queries above can create native block-I/O workers. */
+            success = qemu_aio_hot_fork_prepare_thread_pools(&local_err);
+            if (!success) {
+                crucible_hot_fork_template_record_failure(
+                    CRUCIBLE_HOT_FORK_TEMPLATE_FAILURE_STAGE_NATIVE_POOLS,
+                    local_err);
+            }
+        }
+        if (!success) {
+            error_free(local_err);
+            crucible_hot_fork_template_completion =
+                CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_BLOCKED;
+            crucible_hot_fork_template_phase =
+                CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BLOCK_RELEASE_PENDING;
+            crucible_hot_fork_template_schedule_block_transition();
+            break;
+        }
+        crucible_hot_fork_template_phase =
+            CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BLOCK_HELD;
+        break;
+    case CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BLOCK_RELEASE_PENDING:
+        success = qemu_block_backend_hot_fork_barrier(
+            QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_RELEASE, &inventory);
+        if (success && !inventory.held) {
+            qemu_block_backend_hot_fork_barrier_inventory_destroy(&inventory);
+            if (crucible_hot_fork_template_sources) {
+                if (!qemu_block_hot_fork_source_set_restore(
+                        crucible_hot_fork_template_sources, &local_err)) {
+                    crucible_hot_fork_template_record_failure(
+                        CRUCIBLE_HOT_FORK_TEMPLATE_FAILURE_STAGE_SOURCE_RESTORE,
+                        local_err);
+                    error_free(local_err);
+                    break;
+                }
+                if (!qemu_crucible_block_seal_source_release(
+                        crucible_hot_fork_template_sources, &local_err)) {
+                    crucible_hot_fork_template_record_failure(
+                        CRUCIBLE_HOT_FORK_TEMPLATE_FAILURE_STAGE_SOURCE_RESTORE,
+                        local_err);
+                    error_free(local_err);
+                    break;
+                }
+                if (!qemu_block_hot_fork_source_set_free(
+                        crucible_hot_fork_template_sources, &local_err)) {
+                    crucible_hot_fork_template_record_failure(
+                        CRUCIBLE_HOT_FORK_TEMPLATE_FAILURE_STAGE_SOURCE_FREE,
+                        local_err);
+                    error_free(local_err);
+                    break;
+                }
+                crucible_hot_fork_template_sources = NULL;
+                crucible_hot_fork_graph_receipt =
+                    (CrucibleHotForkGraphReceiptStamp) {0};
+            }
+            crucible_hot_fork_template_complete(
+                crucible_hot_fork_template_completion);
+        } else if (success) {
+            qemu_block_backend_hot_fork_barrier_inventory_destroy(&inventory);
+        }
+        break;
+    default:
+        break;
+    }
+    g_mutex_unlock(&crucible_hot_fork_template_lock);
+}
+
+static void crucible_hot_fork_template_schedule_block_transition(void)
+{
+    if (crucible_hot_fork_template_block_transition_scheduled) {
+        return;
+    }
+
+    crucible_hot_fork_template_block_transition_scheduled = true;
+    aio_bh_schedule_oneshot(qemu_get_aio_context(),
+                            crucible_hot_fork_template_block_transition,
+                            NULL);
+}
+
+static void crucible_hot_fork_template_control_release(void)
+{
+    if (crucible_hot_fork_template_control_generation != 0) {
+        qemu_plugin_crucible_control_drain_unwatch(
+            &crucible_hot_fork_template_control_notifier);
+        crucible_hot_fork_template_control_generation = 0;
+    }
+    if (crucible_hot_fork_template_control_monitor) {
+        monitor_qmp_connection_unwatch(
+            crucible_hot_fork_template_control_monitor,
+            &crucible_hot_fork_template_connection_notifier);
+        crucible_hot_fork_template_control_monitor = NULL;
+    }
+    if (crucible_hot_fork_template_control_bh) {
+        qemu_bh_cancel(crucible_hot_fork_template_control_bh);
+        qemu_bh_delete(crucible_hot_fork_template_control_bh);
+        crucible_hot_fork_template_control_bh = NULL;
+    }
+}
+
+static void crucible_hot_fork_template_control_notify(Notifier *notifier,
+                                                       void *data)
+{
+    /* May run under mon_lock in the I/O thread: enqueue, never take BQL. */
+    qemu_bh_schedule(crucible_hot_fork_template_control_bh);
+}
+
+static bool crucible_hot_fork_template_control_scope_valid(void)
+{
+    return crucible_hot_fork_template_control_monitor &&
+        monitor_qmp_connection_watch_valid(
+            crucible_hot_fork_template_control_monitor,
+            crucible_hot_fork_template_connection_epoch) &&
+        crucible_hot_fork_template_control_process == getpid() &&
+        crucible_hot_fork_template_control_runstate_generation ==
+            qemu_runstate_transition_generation() &&
+        crucible_hot_fork_template_control_vmstop_generation ==
+            qemu_plugin_crucible_vmstop_generation() &&
+        crucible_hot_fork_template_control_icount == icount_get_raw() &&
+        crucible_hot_fork_template_control_clock_ps ==
+            qemu_clock_get_ps(QEMU_CLOCK_VIRTUAL);
+}
+
+static void crucible_hot_fork_template_control_failure(const char *cause,
+                                                       int status)
+{
+    Error *error = NULL;
+
+    error_setg(&error, "Control drain %s: status=%d paused=%d stop=%d "
+               "admission=%d flush=%d outstanding=%d settled=%d "
+               "cold=%d receipt=%d", cause, status,
+               runstate_check(RUN_STATE_PAUSED),
+               qemu_plugin_crucible_vmstop_pending(),
+               qemu_plugin_crucible_vmstop_admission_pending(),
+               qemu_plugin_crucible_vmstop_flush_status(),
+               qemu_plugin_crucible_control_boundary_outstanding(),
+               qemu_plugin_crucible_control_drain_settled(),
+               qemu_plugin_crucible_vmstop_cold_origin(),
+               qemu_crucible_cold_stop_receipt_valid());
+    crucible_hot_fork_template_record_failure(
+        CRUCIBLE_HOT_FORK_TEMPLATE_FAILURE_STAGE_NONE, error);
+    error_free(error);
+}
+
+static void crucible_hot_fork_template_control_transition(void *opaque)
+{
+    int status;
+
+    g_assert(bql_locked());
+    g_mutex_lock(&crucible_hot_fork_template_lock);
+    if (crucible_hot_fork_template_phase !=
+        CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_CONTROL_DRAIN_PENDING) {
+        goto out;
+    }
+    if (crucible_hot_fork_template_abort_requested ||
+        !crucible_hot_fork_template_control_scope_valid()) {
+        crucible_hot_fork_template_control_failure("scope cancelled", -ESTALE);
+        crucible_hot_fork_template_complete(
+            CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_ABORTED);
+        goto out;
+    }
+
+    /* Native notifiers enqueue work; no subsystem barrier is held yet. */
+    g_mutex_unlock(&crucible_hot_fork_template_lock);
+    status = qemu_plugin_crucible_control_drain_service(
+        crucible_hot_fork_template_control_generation);
+    g_mutex_lock(&crucible_hot_fork_template_lock);
+    if (status < 0 || !crucible_hot_fork_template_control_scope_valid()) {
+        crucible_hot_fork_template_control_failure("owner invalidated", status);
+        crucible_hot_fork_template_complete(
+            CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_BLOCKED);
+        goto out;
+    }
+    if (status == 0) {
+        /* Only an original native transition or connection event rearms us. */
+        goto out;
+    }
+    if (!crucible_hot_fork_exact_paused_boundary()) {
+        crucible_hot_fork_template_control_failure("boundary refused", status);
+        crucible_hot_fork_template_complete(
+            CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_BLOCKED);
+        goto out;
+    }
+    if (!monitor_qmp_connection_watch_complete(
+            crucible_hot_fork_template_control_monitor,
+            crucible_hot_fork_template_connection_epoch,
+            &crucible_hot_fork_template_connection_notifier)) {
+        crucible_hot_fork_template_control_failure("connection closed", -ESTALE);
+        crucible_hot_fork_template_complete(
+            CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_ABORTED);
+        goto out;
+    }
+    crucible_hot_fork_template_control_monitor = NULL;
+    crucible_hot_fork_template_control_release();
+    crucible_hot_fork_template_phase =
+        CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BLOCK_HOLD_PENDING;
+    crucible_hot_fork_template_schedule_block_transition();
+out:
+    g_mutex_unlock(&crucible_hot_fork_template_lock);
+}
+
+static bool crucible_hot_fork_template_control_begin(Error **errp)
+{
+    int status;
+
+    if (!crucible_hot_fork_template_control_bh) {
+        crucible_hot_fork_template_control_bh = qemu_bh_new(
+            crucible_hot_fork_template_control_transition, NULL);
+    }
+    crucible_hot_fork_template_connection_notifier.notify =
+        crucible_hot_fork_template_control_notify;
+    crucible_hot_fork_template_control_notifier.notify =
+        crucible_hot_fork_template_control_notify;
+    crucible_hot_fork_template_control_monitor =
+        monitor_qmp_connection_watch_current(
+            &crucible_hot_fork_template_connection_notifier,
+            &crucible_hot_fork_template_connection_epoch, errp);
+    if (!crucible_hot_fork_template_control_monitor) {
+        crucible_hot_fork_template_control_release();
+        return false;
+    }
+    status = qemu_plugin_crucible_control_drain_watch(
+        &crucible_hot_fork_template_control_notifier,
+        &crucible_hot_fork_template_control_generation);
+    if (status < 0) {
+        crucible_hot_fork_template_control_release();
+        error_setg_errno(errp, -status, "Cannot retain native control drain");
+        return false;
+    }
+    crucible_hot_fork_template_control_process = getpid();
+    crucible_hot_fork_template_control_runstate_generation =
+        qemu_runstate_transition_generation();
+    crucible_hot_fork_template_control_vmstop_generation =
+        qemu_plugin_crucible_vmstop_generation();
+    crucible_hot_fork_template_control_icount = icount_get_raw();
+    crucible_hot_fork_template_control_clock_ps =
+        qemu_clock_get_ps(QEMU_CLOCK_VIRTUAL);
+    if (crucible_hot_fork_template_control_runstate_generation == UINT64_MAX ||
+        crucible_hot_fork_template_control_vmstop_generation == 0 ||
+        crucible_hot_fork_template_control_vmstop_generation == UINT64_MAX ||
+        crucible_hot_fork_template_control_icount < 0 ||
+        crucible_hot_fork_template_control_clock_ps < 0) {
+        crucible_hot_fork_template_control_release();
+        error_setg(errp, "Cannot retain an exhausted or invalid stop coordinate");
+        return false;
+    }
+
+    /* Register before this initial pass, including an already-settled stop. */
+    qemu_bh_schedule(crucible_hot_fork_template_control_bh);
+    return true;
+}
+
+static bool crucible_hot_fork_template_reserves_barriers(void)
+{
+    return crucible_hot_fork_template_phase !=
+        CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_IDLE;
+}
+
+CrucibleHotForkPluginBarrierState *
+qmp_crucible_hot_fork_plugin_barrier(
+    CrucibleHotForkPluginBarrierAction action, Error **errp)
+{
+    CrucibleHotForkPluginBarrierState *report = NULL;
+    uint32_t operation;
+
+    g_autoptr(BQLLockAuto) admission_bql =
+        action != CRUCIBLE_HOT_FORK_PLUGIN_BARRIER_ACTION_QUERY ?
+        bql_auto_lock(__FILE__, __LINE__) : NULL;
+
+    g_mutex_lock(&crucible_hot_fork_template_lock);
+    switch (action) {
+    case CRUCIBLE_HOT_FORK_PLUGIN_BARRIER_ACTION_HOLD:
+        if (crucible_hot_fork_template_reserves_barriers()) {
+            error_setg(errp, "Crucible hot-fork template transaction owns "
+                       "the plugin barrier");
+            goto out;
+        }
+        if (!crucible_hot_fork_exact_paused_boundary()) {
+            error_setg(errp, "Crucible hot-fork plugin barrier requires "
+                       "an exact paused/device-flush boundary");
+            goto out;
+        }
+        operation = QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_HOLD;
+        break;
+    case CRUCIBLE_HOT_FORK_PLUGIN_BARRIER_ACTION_QUERY:
+        operation = QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_QUERY;
+        break;
+    case CRUCIBLE_HOT_FORK_PLUGIN_BARRIER_ACTION_RELEASE:
+        if (crucible_hot_fork_template_reserves_barriers()) {
+            error_setg(errp, "Crucible hot-fork template transaction owns "
+                       "the plugin barrier");
+            goto out;
+        }
+        operation = QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_RELEASE;
+        break;
+    default:
+        error_setg(errp, "Unknown Crucible hot-fork plugin barrier action");
+        goto out;
+    }
+
+    report = crucible_hot_fork_plugin_barrier(operation, errp);
+out:
+    g_mutex_unlock(&crucible_hot_fork_template_lock);
+    return report;
+}
