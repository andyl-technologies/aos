+/*
+ * Device subsections carry the phase discarded by this opt-in base codec.
+ * The eight-byte legacy field reserves -1 for an inactive timer. Owners that
+ * can arm a deadline in [-1ns, 0ns) must use a codec with an explicit active
+ * marker; this codec fails closed rather than confusing that deadline with
+ * the inactive sentinel.
+ */
+static bool load_timer_ns_floor(QEMUFile *f, void *pv, size_t size,
+                                const VMStateField *field, Error **errp)
+{
+    QEMUTimer *timer = pv;
+    int64_t expiry_ns = qemu_get_sbe64(f);
+
+    if (expiry_ns == -1) {
+        timer_del(timer);
+    } else if (!timer_mod_ns_phase(timer, expiry_ns, 0)) {
+        error_setg(errp, "timer deadline cannot be restored");
+        return false;
+    }
+    return true;
+}
+
+static bool save_timer_ns_floor(QEMUFile *f, void *pv, size_t size,
+                                const VMStateField *field,
+                                JSONWriter *vmdesc, Error **errp)
+{
+    QEMUTimer *timer = pv;
+    uint16_t phase_ps;
+    int64_t expiry_ns;
+    int status;
+
+    status = timer_expire_time_ns_phase(timer, &expiry_ns, &phase_ps);
+    if (status < 0) {
+        error_setg(errp, "timer deadline exceeds the nanosecond horizon");
+        return false;
+    }
+    if (status && expiry_ns == -1) {
+        error_setg(errp, "timer deadline collides with inactive sentinel");
+        return false;
+    }
+    qemu_put_sbe64(f, status ? expiry_ns : -1);
+    return true;
+}
+
