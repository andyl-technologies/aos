+int qemu_plugin_crucible_ram_control_actor_join_v1(
+    qemu_plugin_id_t id, qemu_plugin_crucible_ram_control_actor_v1 *actor)
+{
+#ifdef CONFIG_LINUX
+    void *returned;
+    int status = ram_control_creator(actor, id);
+
+    if (status) {
+        return status;
+    }
+    if (!qatomic_load_acquire(&actor->born) || actor->joined) {
+        return actor->joined ? -EALREADY : -EPERM;
+    }
+    actor->join_attempted = true;
+    status = qemu_thread_bounded_tryjoin(&actor->thread, actor,
+                                             &actor->creation_receipt, &returned);
+    actor->join_result = status;
+    actor->join_errno = status < 0 ? -status : 0;
+    if (status) {
+        return status;
+    }
+    actor->joined = true;
+    status = startup_task_physical_return(&actor->task_reserved);
+    if (status) {
+        return ram_control_failure(actor, status, true);
+    }
+    if (!qatomic_load_acquire(&actor->returned)) {
+        return ram_control_failure(actor, -EPROTO, true);
+    }
+    /* Successful join establishes physical stack retirement eligibility,
+     * independently from entry status or retained pending event custody. */
+    status = qemu_thread_bounded_identity_return(&actor->thread, actor,
+                                                 &actor->creation_receipt);
+    if (status) {
+        return ram_control_failure(actor, status, true);
+    }
+    if (munmap(actor->stack, actor->stack_bytes) < 0) {
+        actor->stack_uncertain = true;
+        return ram_control_failure(actor, -errno, true);
+    }
+    actor->stack = NULL;
+    return 0;
+#else
+    return -ENOTSUP;
+#endif
+}
