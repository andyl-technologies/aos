+bool msix_fingerprint_validate(const PCIDevice *dev, Error **errp)
+{
+    if (!dev) {
+        error_setg(errp, "MSI-X projection requires a device");
+        return false;
+    }
+    if (!msix_present((PCIDevice *)dev)) {
+        return true;
