+QEMU_BUILD_BUG_ON(offsetof(QemuCrucibleUserfaultfdEndpoint, receipt) %
+                  _Alignof(QemuCrucibleUserfaultfdEventReceipt));
+QEMU_BUILD_BUG_ON(offsetof(QemuCrucibleUserfaultfdEndpoint, receipt) +
+                  sizeof(QemuCrucibleUserfaultfdEventReceipt) >
