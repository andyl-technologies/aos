+static void fixture_prepare(void)
+{
+    uint8_t original[80] = { 0 };
+    uint64_t now;
+
+    fixture_ctx.handle = g_module_open(NULL, G_MODULE_BIND_LAZY);
+    g_assert_nonnull(fixture_ctx.handle);
+    fixture_ctx.id = 37;
+    fixture_main_thread_id = qemu_get_thread_id();
+    qemu_mutex_init(&admission_lock);
+    event_fd = eventfd(0, EFD_NONBLOCK | EFD_CLOEXEC);
+    g_assert_cmpint(event_fd, >=, 0);
+
+    /* Only transport data is supplied to the actor dependency. In particular
+     * its Source purpose, paid charge, qualification and born fields stay zero.
+     */
+    fixture_actor.receipt.active = true;
+    fixture_actor.receipt.first_alias = true;
+    fixture_actor.receipt.alias_count = 1;
+    fixture_actor.receipt.frame_bytes = CRUCIBLE_CHECKPOINT_ARM_FRAME_BYTES;
+    fixture_actor.receipt.aliases[0] = event_fd;
+    fixture_actor.receipt.aliases[1] = -1;
+    g_assert_cmpint(checkpoint_now(&now), ==, 0);
+    memcpy(original, "CRUCPAU1", 8);
+    stl_be_p(original + 8, 1);
+    stl_be_p(original + 12, 80);
+    original[16] = 0x7a;
+    stq_be_p(original + 48, UINT64_MAX);
+    stq_be_p(original + 56, now - 1);
+    stq_be_p(original + 64, now + UINT64_C(10000000000));
+    stq_be_p(original + 72, UINT64_MAX);
+    memcpy(fixture_actor.receipt.frame + CRUCIBLE_CHECKPOINT_ARM_ORIGINAL_OFFSET,
+           original, sizeof(original));
+
+    crucible_hot_fork_coordinator.process_id = getpid();
+    crucible_hot_fork_coordinator.main_thread_id = qemu_get_thread_id();
+    crucible_hot_fork_coordinator.child_runtime_pending = false;
+    qatomic_store_release(&crucible_hot_fork_coordinator.initialized, true);
+    g_assert_cmpint(event_notifier_init(&crucible_hot_fork_coordinator.wake, 0), ==, 0);
+    ram_scheduled.state = UINT64_C(82);
+    ram_scheduled.callback = queued_callback;
+    ram_scheduled.opaque = &model_request;
+
+    g_assert_cmpint(qemu_crucible_checkpoint_pending_adopt_native_v1(
+        &fixture_actor, &fixture_actor.receipt, original, arm_digest,
+        &request_generation), ==, 0);
+    g_assert_true(fixture_actor.receipt.moved);
+    g_assert_cmpint(fixture_actor.receipt.aliases[0], ==, -1);
+    g_assert_cmpint(checkpoint_pending.cancellation_fd, ==, event_fd);
+    g_assert_false(checkpoint_request.published);
+}
