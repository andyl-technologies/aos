+    /* This exact inline holder was paid in Source's authentic preexec floor
+     * before birth. The already issued Receiving child lends Original80; no
+     * Setup/Root clock or new metadata subdivision is constructed here. */
+    *borrow = (QemuCrucibleCheckpointInventoryMetadataBorrow) {
