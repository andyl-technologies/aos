+int qemu_plugin_crucible_required_worker_ready_v1(QemuCrucibleRequiredWorker *worker)
+{
+    QemuCruciblePluginWorker *native;
+    int status;
+
+    if (worker != &startup_source.teardown_worker) {
+        return -EPERM;
+    }
+    native = &worker->native;
+    status = plugin_worker_identity(native);
+    if (status || !qemu_thread_is_self(&native->thread)) {
+        return status ? status : -EPERM;
+    }
+    qemu_mutex_lock(&startup_source.commands.mutex);
+    if (!native->entry_entered || native->entry_returned || native->ready) {
+        status = -EBUSY;
+    } else if (native->closing) {
+        /* Close can win after the valid entry's own preliminary check. Keep
+         * that disposition distinct from invalid entry or repeated readiness. */
+        status = -ECANCELED;
+    } else {
+        /* The matched teardown entry acknowledges only after its actual sole
+         * consumer is established. This fact issues no provider authority. */
+        native->ready = true;
+        qemu_cond_broadcast(&native->wake);
+    }
+    qemu_mutex_unlock(&startup_source.commands.mutex);
+    return status;
+}
+
+int qemu_plugin_crucible_required_workers_current_v1(
+    qemu_plugin_id_t id, QemuCrucibleStartupRuntimePurpose *runtime)
+{
+    QemuCrucibleRequiredWorker *workers[] = {
+        &startup_source.run_worker, &startup_source.teardown_worker,
+    };
+    int status = qemu_plugin_crucible_startup_runtime_check_v3(id, runtime);
+
+    if (status) {
+        return status;
+    }
+    qemu_mutex_lock(&startup_source.commands.mutex);
+    for (size_t index = 0; !status && index < G_N_ELEMENTS(workers); index++) {
+        QemuCruciblePluginWorker *native = &workers[index]->native;
+
+        status = plugin_worker_holder_identity_locked(native);
+        if (!status && (native->first_status || native->post_status)) {
+            status = native->first_status ? native->first_status : native->post_status;
+        }
+        if (!status && (!native->birth.born || !native->initialized ||
+            !native->construction_returned || native->closing || native->entry_returned ||
+            native->holder == &native->creation_owner || native->transition_active)) {
+            status = -ENOKEY;
+        }
+        if (!status && !native->ready) {
+            status = -EAGAIN;
+        }
+    }
+    qemu_mutex_unlock(&startup_source.commands.mutex);
+    return status > 0 ? -EPROTO : status;
+}
+
+static int required_worker_handoff_admit_locked(QemuCruciblePluginWorker *native)
+{
+    QemuCrucibleRequiredWorker *worker = &startup_source.run_worker;
+
+    if (native != &worker->native || !native->ready || native->closing ||
+        native->handoff_attempted || native->handoff_committed || !worker->handoff ||
+        native->first_status || native->post_status || !native->birth.born ||
+        !native->entry_entered || native->entry_returned ||
+        native->holder == &native->creation_owner) {
+        return -EBUSY;
+    }
+    /* The common owner installs its user pin under this same lock before
+     * invoking the actual module. A concurrent close cannot revoke that use. */
+    native->handoff_attempted = true;
+    native->handoff_active = true;
+    qemu_thread_get_self(&native->handoff_thread);
+    return 0;
+}
+
+static int required_worker_invoke_handoff(QemuCruciblePluginWorker *native,
+                                          void *owner, void *input)
+{
+    QemuCrucibleRequiredWorker *worker = &startup_source.run_worker;
+    int status;
+
+    SOURCE_CALLBACK_MASKED_INVOKE(status, &worker->frame, worker->handoff, input,
+        native->installer.plugin_id, &worker->frame, owner, input);
+    qemu_mutex_lock(&startup_source.commands.mutex);
+    if (status > 0) {
+        status = -EPROTO;
+    }
+    native->handoff_active = false;
+    native->handoff_returned = true;
+    if (!native->handoff_committed && !status) {
+        status = -EPROTO;
+    }
+    native->handoff_status = status;
+    if (native->closing && !native->handoff_committed) {
+        native->cancelled_before_handoff = true;
+    }
+    qemu_mutex_unlock(&startup_source.commands.mutex);
+    return status;
+}
+
+int qemu_plugin_crucible_run_worker_handoff_committed_v1(
+    QemuCrucibleRequiredWorkerFrame *frame)
+{
+    QemuCrucibleRequiredWorker *worker = &startup_source.run_worker;
+    QemuCruciblePluginWorker *native = &worker->native;
+    int status;
+
+    if (frame != &worker->frame || frame->worker != worker) {
+        return -EPERM;
+    }
+    status = plugin_worker_identity(native);
+    if (status) {
+        return status;
+    }
+    qemu_mutex_lock(&startup_source.commands.mutex);
+    if (!native->handoff_active || !native->control_users ||
+        !qemu_thread_is_self(&native->handoff_thread) || native->handoff_committed) {
+        status = -EPERM;
+    } else {
+        /* Acknowledge immediately after the module moves its sole stream
+         * owner. Later callback/post failure cannot undo or repeat that move. */
+        native->handoff_committed = true;
+    }
+    qemu_mutex_unlock(&startup_source.commands.mutex);
+    return status;
+}
+
+int qemu_plugin_crucible_run_worker_handoff_v1(
+    qemu_plugin_id_t id, QemuCrucibleRequiredWorker *worker, void *input)
+{
+    QemuCruciblePluginWorker *native;
+    int status;
+    int post;
+
+    if (worker != &startup_source.run_worker || !startup_invocation(id)) {
+        return -EPERM;
+    }
+    native = &worker->native;
+    status = plugin_worker_identity(native);
+    if (status) {
+        return status;
+    }
+    qemu_mutex_lock(&startup_source.commands.mutex);
+    if (native->handoff_attempted) {
+        qemu_mutex_unlock(&startup_source.commands.mutex);
+        return -EALREADY;
+    }
+    qemu_mutex_unlock(&startup_source.commands.mutex);
+    status = plugin_worker_control_scope(id, native, input, false,
+        required_worker_invoke_handoff, required_worker_handoff_admit_locked);
+    if (!native->handoff_returned) {
+        return status;
+    }
+    post = plugin_worker_post(native);
+    qemu_mutex_lock(&startup_source.commands.mutex);
+    if (post && !native->handoff_post_status) {
+        native->handoff_post_status = post;
+    }
+    if (!status && !post && native->handoff_committed && native->handoff_returned &&
+        !native->closing && !native->control_lifetime_uncertain) {
+        native->handoff_released = true;
+    }
+    qemu_cond_broadcast(&native->wake);
+    qemu_mutex_unlock(&startup_source.commands.mutex);
+    return status ? status : post;
+}
+
+int qemu_plugin_crucible_required_worker_control_use_v1(
+    qemu_plugin_id_t id, QemuCrucibleRequiredWorker *worker, void *input)
+{
+    return required_worker_slot(worker) ?
