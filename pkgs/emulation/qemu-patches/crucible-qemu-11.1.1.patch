+    return prefix + '\n' + bodies + '\n' + consumer + '\n' + tail, names
+
+
+mutations = {
+    'readonly admission': (
+        '!record->ram_writer_closed &&',
+        'true &&',
+    ),
+    'close marker': (
+        '((QemuHotForkThreadRecord *)owner->record)->ram_writer_closed = true;',
+        '((QemuHotForkThreadRecord *)owner->record)->ram_writer_closed = false;',
+    ),
+    'upgrade marker': (
+        '((QemuHotForkThreadRecord *)writers->record)->ram_writer_closed = true;',
+        '((QemuHotForkThreadRecord *)writers->record)->ram_writer_closed = false;',
+    ),
+    'CPU promotion': (
+        '        ram_writer_promote_nested_locked(record);\n        record->ram_writer_cpu = NULL;',
+        '        record->ram_writer_cpu = NULL;',
+    ),
+    'scope promotion': (
