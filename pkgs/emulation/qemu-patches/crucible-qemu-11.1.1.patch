+}
+
+static void *monitor_registry_worker_with_runtime_barriers(void *opaque)
+{
+    RegistryWorker *worker = opaque;
+    QemuAsyncWorkerHotForkBarrierInventory async_inventory;
+    QemuRcuHotForkBarrierInventory rcu_inventory;
+    int result = 0;
+
+    qemu_thread_hot_fork_set_current_disposition(
+        QEMU_THREAD_HOT_FORK_MONITOR_RESTART);
+    rcu_register_thread();
+    qemu_rcu_hot_fork_barrier(QEMU_RCU_HOT_FORK_BARRIER_HOLD,
+                              &rcu_inventory);
+    qemu_async_worker_hot_fork_barrier(
+        QEMU_ASYNC_WORKER_HOT_FORK_BARRIER_HOLD, &async_inventory);
+    if (!rcu_inventory.held || !rcu_inventory.quiescent ||
+        rcu_inventory.owner_thread_id != qemu_get_thread_id() ||
+        !async_inventory.held || !async_inventory.quiescent ||
+        async_inventory.owner_thread_id != qemu_get_thread_id()) {
+        result = -EPROTO;
+    }
+    write_child_result(worker->ready_fd, result);
+    if (result == 0) {
+        (void)read_child_result(worker->release_fd);
+    }
+    if (async_inventory.held &&
+        async_inventory.owner_thread_id == qemu_get_thread_id()) {
+        qemu_async_worker_hot_fork_barrier(
+            QEMU_ASYNC_WORKER_HOT_FORK_BARRIER_RELEASE, &async_inventory);
+    }
+    if (rcu_inventory.held &&
+        rcu_inventory.owner_thread_id == qemu_get_thread_id()) {
+        qemu_rcu_hot_fork_barrier(QEMU_RCU_HOT_FORK_BARRIER_RELEASE,
+                                  &rcu_inventory);
+    }
+    rcu_unregister_thread();
+    return NULL;
+}
+
+static void start_registry_worker_thread(
+    RegistryWorkerThread *worker, const char *name,
+    void *(*start_routine)(void *))
+{
+    g_assert_cmpint(pipe2(worker->ready, O_CLOEXEC), ==, 0);
+    g_assert_cmpint(pipe2(worker->release, O_CLOEXEC), ==, 0);
+    worker->worker = (RegistryWorker) {
+        .ready_fd = worker->ready[1],
+        .release_fd = worker->release[0],
+    };
+    qemu_thread_create(&worker->thread, name, start_routine, &worker->worker,
