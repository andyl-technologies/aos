+    }
+
+    observed_ps = 999;
+    initialize_clock(true);
+    initialize_chipset(&original, &timer_irq, &bus_irq);
+    initialize_chipset(&restored, &timer_irq, &bus_irq);
+    original.itr = malformed ? 0x200 : 2;
+    input = save_chipset(&original);
+    file = qemu_file_new_input(QIO_CHANNEL(input));
+    timer_mod_ps_wide(restored.periodic_timer, 12345);
+
+    g_assert_cmpint(vmstate_load_state(file, &vmstate_rc4030, &restored, 3,
+                                      &error), ==, malformed ? -EINVAL : 0);
+    if (malformed) {
+        g_assert_nonnull(error);
+        assert_deadline(&restored, 12345);
+        g_assert_cmpuint(timer_irq.lowered, ==, 0);
+        g_assert_cmpuint(bus_irq.lowered, ==, 0);
+        error_free(error);
+    } else {
+        g_assert_null(error);
+        assert_deadline(&restored, observed_ps + interval_ps(2));
+        g_assert_cmpuint(timer_irq.lowered, ==, 1);
+        g_assert_cmpuint(bus_irq.lowered, ==, 1);
+    }
+    qemu_fclose(file);
+    object_unref(OBJECT(input));
+    destroy_chipset(&restored);
+    destroy_chipset(&original);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/rc4030/period/reloads", test_all_reload_values);
+    g_test_add_func("/rc4030/period/callback", test_periodic_callback);
+    g_test_add_func("/rc4030/period/legacy", test_legacy_clock);
+    g_test_add_func("/rc4030/period/wide", test_wide_clock);
+    g_test_add_data_func("/rc4030/period/migration", GINT_TO_POINTER(false),
+                         test_migration);
+    g_test_add_data_func("/rc4030/period/malformed", GINT_TO_POINTER(true),
+                         test_migration);
+    return g_test_run();
+}
