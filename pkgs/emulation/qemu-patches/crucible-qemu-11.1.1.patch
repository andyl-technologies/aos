+
+    set_ordinary();
+    assert(qemu_plugin_crucible_native_shmem_dispatch_descriptor_observe_v1(1, &expected));
+    assert(!qemu_plugin_crucible_native_group_use_post_v1(&absent, &slot,
+        qemu_plugin_crucible_native_shmem_dispatch_descriptor_observe_v1, 1, &expected));
+#define REFUSED(change) do { \
+    changed = expected; \
+    change; \
+    assert(qemu_plugin_crucible_native_group_use_post_v1(&absent, &slot, \
+        qemu_plugin_crucible_native_shmem_dispatch_descriptor_observe_v1, 1, &changed) == -ESTALE); \
+} while (0)
+    REFUSED(changed.coordinate = NULL);
+    REFUSED(changed.function = NULL);
+    REFUSED(changed.userdata = NULL);
+    REFUSED(changed.userdata_coordinate = NULL);
+    REFUSED(changed.kind = QEMU_CRUCIBLE_NATIVE_UNQUALIFIED);
+    REFUSED(slot = &foreign);
+#undef REFUSED
+    slot = NULL;
+}
+
+/* Child-only fatal checks observe state at abort, after the actual void end.
+ * A diagnostic handler is not a successful provider or physical owner. */
+static unsigned expected_ends, expected_exits;
+static volatile sig_atomic_t fatal_verified;
+
+static void observe_fatal_refusal(void)
+{
+    fatal_verified = physical_ends == expected_ends &&
+        empty_exits == expected_exits && !boundary_depth &&
+        crucible_current_icount == 99;
+}
+
+static void fatal_refusal(int sig)
+{
+    _exit(sig == SIGABRT && fatal_verified ? 0 : 91);
+}
+
+static void check_public_refusal(unsigned member, bool changed, bool absent)
+{
+    pid_t child = fork();
+    int status;
+
+    assert(child >= 0);
+    if (!child) {
+        QemuCrucibleNativeInvocationRegistry registry = { .process = getpid() + 1 };
+        QemuCrucibleNativeRegistration refused = { .owner = &registry };
+
+        set_ordinary();
+        crucible_current_icount = 99;
+        expected_ends = physical_ends + 1;
+        expected_exits = empty_exits + 3;
+        if (changed) {
+            mutate_member = member;
+        } else {
+            native_shmem_dispatch_members[member] = &refused;
+        }
+        if (absent) {
+            if (!member) {
+                crucible_publish_icount_cb = NULL;
+            } else if (member == 1) {
+                crucible_max_advance_icount_cb = NULL;
+            } else {
+                crucible_logical_ceiling_cb = NULL;
+            }
+        }
+        signal(SIGABRT, fatal_refusal);
+        if (!member) {
+            crucible_sim_shmem_publish_current_icount(123);
+        } else if (member == 1) {
+            (void)crucible_sim_shmem_max_advance_icount();
+        } else {
+            (void)crucible_sim_shmem_logical_ceiling();
+        }
+        _exit(92);
+    }
+    assert(waitpid(child, &status, 0) == child);
+    assert(WIFEXITED(status) && WEXITSTATUS(status) == 0);
+}
+
+static void check_first_only_refusal(void)
+{
+    pid_t child = fork();
+    int status;
+
+    assert(child >= 0);
+    if (!child) {
+        crucible_current_icount = 99;
+        expected_ends = physical_ends;
+        expected_exits = empty_exits;
+        signal(SIGABRT, fatal_refusal);
+        crucible_shmem_callback_require_return((CrucibleShmemCallbackResult) {
+            .first_status = -ENOKEY,
+        });
+        _exit(92);
+    }
+    assert(waitpid(child, &status, 0) == child);
+    assert(WIFEXITED(status) && WEXITSTATUS(status) == 0);
+}
+
+int main(void)
+{
+    qemu_rec_mutex_init(&plugin.lock);
+    set_ordinary();
+    crucible_publish_icount_cb = NULL;
+    crucible_max_advance_icount_cb = NULL;
+    crucible_logical_ceiling_cb = NULL;
+    assert(crucible_sim_shmem_max_advance_icount() == UINT64_MAX);
+    assert(crucible_sim_shmem_logical_ceiling() == 0);
+    crucible_sim_shmem_publish_current_icount(17);
+    assert(crucible_current_icount == 17 && !physical_ends && !posts);
+
+    check_descriptor_post();
+    check_first_only_refusal();
+    check_absent_adapter(1);
+    check_absent_adapter(2);
+    for (unsigned member = 0; member < 3; member++) {
+        callback_value = 0;
+        check_adapter(member, false, false, false);
+        callback_value = UINT64_MAX;
+        check_adapter(member, false, false, false);
+        check_adapter(member, true, false, false);
+        check_adapter(member, false, true, false);
+        check_adapter(member, false, false, true);
+        check_public_refusal(member, false, false);
+        check_public_refusal(member, true, false);
+        check_public_refusal(member, false, true);
+    }
+    set_ordinary();
+    assert(crucible_sim_shmem_max_advance_icount() == UINT64_MAX);
+    callback_value = 0;
+    assert(crucible_sim_shmem_logical_ceiling() == 0);
+    crucible_sim_shmem_publish_current_icount(321);
+    assert(crucible_current_icount == 321 && observed_icount == 321);
+    qemu_rec_mutex_destroy(&plugin.lock);
+    printf("PASS literal ordinary dispatch and refusal/post/end controls; "
+           "result=%zu use=%zu descriptor=%zu; no Source group or scheduler authority\n",
+           sizeof(CrucibleShmemCallbackResult), sizeof(QemuCrucibleNativeGroupUse),
+           sizeof(QemuCrucibleNativeGroupDescriptorView));
+    return 0;
+}
+"""
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--source-root", type=Path,
+                        default=Path(__file__).resolve().parents[2])
+    parser.add_argument("--output-dir", type=Path, required=True)
+    args = parser.parse_args()
+    source = args.source_root.resolve()
+    output = args.output_dir.resolve()
+    output.mkdir(parents=True, exist_ok=True)
+    extract = runpy.run_path(str(source / "tests/unit/extract-crucible-startup-source-controls.py"))
+    function = extract["function"]
+    native = (source / "plugins/crucible-native-invocation.c").read_text()
+    shmem = (source / "accel/tcg/tcg-accel-ops-sim-shmem.c").read_text()
+    native_bodies = "\n\n".join(function(native, name) for name in (
+        "static bool registry_process_current(",
+        "QemuCrucibleNativeInvocationTicket qemu_plugin_crucible_native_mask_v1(",
+        "QemuCrucibleNativeGroupUse qemu_plugin_crucible_native_group_use_begin_v1(",
+        "int qemu_plugin_crucible_native_group_use_post_v1(",
+        "void qemu_plugin_crucible_native_group_use_end_v1(",
+    ))
+    # Probes observe actual production bodies, without replacing their return.
+    post_start = native_bodies.index("int qemu_plugin_crucible_native_group_use_post_v1(")
+    post_end = native_bodies.index("void qemu_plugin_crucible_native_group_use_end_v1(")
+    native_bodies = (native_bodies[:post_start] +
+                     native_bodies[post_start:post_end].replace(
+                         "    qemu_rec_mutex_lock(&plugin.lock);",
+                         "    qemu_rec_mutex_lock(&plugin.lock);\n    observe_post_lock();") +
+                     native_bodies[post_end:])
+    native_bodies = native_bodies.replace(
+        "    QemuCrucibleNativeGroupDescriptorView actual = { 0 };",
+        "    posts++;\n    QemuCrucibleNativeGroupDescriptorView actual = { 0 };")
+    native_bodies = native_bodies.replace(
+        "    qemu_plugin_crucible_native_exit_v1(use.invocation);",
+        "    physical_ends++;\n    qemu_plugin_crucible_native_exit_v1(use.invocation);")
+    declarations = shmem[shmem.index("static uint64_t crucible_current_icount;"):
+                         shmem.index("size_t qemu_plugin_crucible_native_shmem_dispatch_descriptor_storage_bytes_v1(")]
+    result_type = shmem[shmem.index("typedef struct CrucibleShmemCallbackResult {"):
+                        shmem.index("static CrucibleShmemCallbackResult crucible_group_call_publish_icount_cb(")]
+    shmem_bodies = "\n\n".join(function(shmem, name) for name in (
+        "bool qemu_plugin_crucible_native_shmem_dispatch_descriptor_observe_v1(",
+        "static CrucibleShmemCallbackResult crucible_group_call_publish_icount_cb(",
+        "static CrucibleShmemCallbackResult crucible_group_call_max_advance_icount_cb(",
+        "static CrucibleShmemCallbackResult crucible_group_call_logical_ceiling_cb(",
+        "static void crucible_shmem_callback_require_return(",
+        "void crucible_sim_shmem_publish_current_icount(",
+        "uint64_t crucible_sim_shmem_max_advance_icount(",
+        "uint64_t crucible_sim_shmem_logical_ceiling(",
+    ))
+    # Observe state in normal execution before the actual fatal edge; the
+    # signal handler reads only sig_atomic_t and performs _exit.
+    shmem_bodies = shmem_bodies.replace(
+        "        abort();", "        observe_fatal_refusal();\n        abort();")
+    production = native_bodies + declarations + result_type + shmem_bodies
+    variants = {"positive": production}
+    replacements = {
+        "omit-first-refusal": ("result.first_status = -ENOKEY;", "result.first_status = 0;"),
+        "omit-independent-post": ("result.post_status = qemu_plugin_crucible_native_group_use_post_v1(",
+                                  "result.post_status = 0;\n    (void)qemu_plugin_crucible_native_group_use_post_v1("),
+        "omit-physical-end": ("    qemu_plugin_crucible_native_group_use_end_v1(use);", ""),
+        "publish-on-post-refusal": ("if (!result.first_status && !result.post_status)", "if (!result.first_status)"),
+        "publish-on-first-refusal": ("if (!result.first_status && !result.post_status)", "if (!result.post_status)"),
+        "omit-slot-post": ("qatomic_load_acquire(slot) != record ||", "false ||"),
+        "omit-coordinate-post": ("actual.coordinate != expected->coordinate ||", "false ||"),
+        "omit-function-post": ("actual.function != expected->function ||", "false ||"),
+        "omit-userdata-post": ("actual.userdata != expected->userdata ||", "false ||"),
+        "omit-userdata-coordinate-post": ("actual.userdata_coordinate != expected->userdata_coordinate ||", "false ||"),
+        "omit-kind-post": ("actual.kind != expected->kind", "false"),
+        "omit-selected-owner-post": ("!status && qatomic_load_acquire(&qemu_crucible_selected_process_id)", "false"),
+        "omit-fatal-first": ("if (result.first_status || result.post_status)", "if (result.post_status)"),
+        "omit-fatal-post": ("if (result.first_status || result.post_status)", "if (result.first_status)"),
+        "omit-publish-owner-expectation": (
+            "crucible_publish_icount_cb ||\n        qatomic_load_acquire(&native_shmem_dispatch_members[0])",
+            "crucible_publish_icount_cb"),
+        "omit-max-owner-expectation": (
+            "crucible_max_advance_icount_cb ||\n        qatomic_load_acquire(&native_shmem_dispatch_members[1])",
+            "crucible_max_advance_icount_cb"),
+        "omit-logical-owner-expectation": (
+            "!crucible_logical_ceiling_cb &&\n        !qatomic_load_acquire(&native_shmem_dispatch_members[2])",
+            "!crucible_logical_ceiling_cb"),
+        "omit-post-mutex": (
+            "    qemu_rec_mutex_lock(&plugin.lock);\n    observe_post_lock();",
+            "    observe_post_lock();"),
+        "early-icount-publication": ("    if (crucible_publish_icount_cb ||",
+                                    "    crucible_current_icount = current_icount;\n    if (crucible_publish_icount_cb ||"),
+    }
+    for name, (before, after) in replacements.items():
+        if before not in production:
+            raise ValueError(f"production omission anchor missing: {name}")
+        variants[name] = production.replace(before, after)
+    proof = {}
+    for name, bodies in variants.items():
+        path = output / (name + ".c")
+        path.write_text(PREFIX + bodies + CHECKS)
+        binary = output / name
+        command = [os.environ.get("CC", "cc"),
+                   *shlex.split(os.environ.get("CFLAGS", "")), str(path),
+                   "-o", str(binary), *shlex.split(os.environ.get("LDFLAGS", ""))]
+        (output / (name + ".command.json")).write_text(json.dumps(command, indent=2) + "\n")
+        result = subprocess.run(command, capture_output=True, text=True, cwd=source)
+        (output / (name + ".compile.log")).write_text(result.stdout + result.stderr)
+        if result.returncode:
+            raise RuntimeError(f"compile {name}: {result.stderr}")
+        result = subprocess.run([str(binary)], capture_output=True, text=True, cwd=output, timeout=30)
+        (output / (name + ".run.log")).write_text(result.stdout + result.stderr)
+        expected = 0 if name == "positive" else -signal.SIGABRT
+        if result.returncode != expected:
+            raise RuntimeError(f"unexpected {name}: {result.returncode}: {result.stdout + result.stderr}")
+        if name != "positive":
+            if name == "omit-post-mutex":
+                detector = "attempt == -EBUSY"
+            elif name in ("omit-fatal-first", "omit-fatal-post", "early-icount-publication") or "owner-expectation" in name:
+                detector = "WIFEXITED(status) && WEXITSTATUS(status) == 0"
+            elif name == "omit-first-refusal":
+                detector = "result.first_status == -ENOKEY"
+            elif name == "omit-independent-post" or name == "omit-selected-owner-post":
+                detector = "result.post_status =="
+            elif name == "omit-physical-end":
+                detector = "physical_ends == ends_before + 1"
+            elif name.startswith("publish-on-"):
+                detector = "out =="
+            else:
+                detector = "qemu_plugin_crucible_native_group_use_post_v1(&absent"
+            if detector not in result.stderr:
+                raise RuntimeError(f"omission missed its causal detector: {name}: {result.stderr}")
+        proof[name] = dict(returncode=result.returncode, output=result.stdout + result.stderr)
+        print(name, result.returncode, flush=True)
+    (output / "proof.json").write_text(json.dumps(proof, indent=2) + "\n")
+    print("PASS literal callback return component controls; retained Source/selected callbacks remain unexecuted")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/unit/test-crucible-slirp-time.c b/tests/unit/test-crucible-slirp-time.c
new file mode 100644
index 0000000000000000000000000000000000000000..22e321204c3443ea7d63c9329ea1208d84ff6ea5
--- /dev/null
+++ b/tests/unit/test-crucible-slirp-time.c
@@ -0,0 +1,30 @@
+/* libslirp protocol time projection tests. */
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+
+#include "qemu/osdep.h"
+
+#include "net/slirp-time.h"
+
+static void test_ns_projection(void)
+{
+    const __int128 max_ps = (__int128)INT64_MAX *
+                            PICOSECONDS_PER_NANOSECOND + 999;
+    const __int128 min_ps = (__int128)INT64_MIN *
+                            PICOSECONDS_PER_NANOSECOND;
+
+    g_assert_cmpint(net_slirp_project_clock_ns(999), ==, 0);
+    g_assert_cmpint(net_slirp_project_clock_ns(1000), ==, 1);
+    g_assert_cmpint(net_slirp_project_clock_ns(-1), ==, -1);
+    g_assert_cmpint(net_slirp_project_clock_ns(-1001), ==, -2);
+    g_assert_cmpint(net_slirp_project_clock_ns(max_ps), ==, INT64_MAX);
+    g_assert_cmpint(net_slirp_project_clock_ns(max_ps + 1), ==, INT64_MAX);
+    g_assert_cmpint(net_slirp_project_clock_ns(min_ps), ==, INT64_MIN);
+    g_assert_cmpint(net_slirp_project_clock_ns(min_ps - 1), ==, INT64_MIN);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/crucible/slirp/ns-projection", test_ns_projection);
+    return g_test_run();
+}
diff --git a/tests/unit/test-crucible-snapshot-fast-path.py b/tests/unit/test-crucible-snapshot-fast-path.py
