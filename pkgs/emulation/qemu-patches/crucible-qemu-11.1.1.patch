+        ldq_be_p(wire + QEMU_CRUCIBLE_PROCESS_PURPOSE_RAM_OWNER_GENERATION_OFFSET);
+    decoded.ram_arena_generation =
+        ldq_be_p(wire + QEMU_CRUCIBLE_PROCESS_PURPOSE_RAM_ARENA_GENERATION_OFFSET);
+    decoded.ram_template =
+        wire[QEMU_CRUCIBLE_PROCESS_PURPOSE_RAM_TEMPLATE_OFFSET] != 0;
+    decoded.ram_endpoint_present = purpose_nonzero(
+        wire + QEMU_CRUCIBLE_PROCESS_PURPOSE_RAM_TAIL_OFFSET,
+        QEMU_CRUCIBLE_PROCESS_PURPOSE_RAM_TAIL_BYTES);
+
+    if (decoded.ram_endpoint_present &&
+        (!decoded.ram_socket_inode || !decoded.ram_socket_cookie ||
+         !purpose_nonzero(decoded.ram_session, sizeof(decoded.ram_session)) ||
+         !purpose_nonzero(decoded.ram_target_daemon, sizeof(decoded.ram_target_daemon)) ||
+         !purpose_nonzero(decoded.ram_target_owner, sizeof(decoded.ram_target_owner)) ||
+         !purpose_nonzero(decoded.ram_target_node, sizeof(decoded.ram_target_node)) ||
+         decoded.ram_owner_generation != decoded.process_generation ||
+         !decoded.ram_arena_generation ||
+         wire[QEMU_CRUCIBLE_PROCESS_PURPOSE_RAM_TEMPLATE_OFFSET] > 1 ||
+         purpose_nonzero(wire + QEMU_CRUCIBLE_PROCESS_PURPOSE_RAM_RESERVED_OFFSET,
+                         QEMU_CRUCIBLE_PROCESS_PURPOSE_RAM_RESERVED_BYTES))) {
+        return -EINVAL;
+    }
+    memcpy(decoded.artifact_digest,
+           wire + QEMU_CRUCIBLE_PROCESS_PURPOSE_ARTIFACT_DIGEST_OFFSET,
+           sizeof(decoded.artifact_digest));
+    decoded.artifact_machine =
+        ldl_be_p(wire + QEMU_CRUCIBLE_PROCESS_PURPOSE_ARTIFACT_MACHINE_OFFSET);
+    memcpy(decoded.containing_capability,
+           wire + QEMU_CRUCIBLE_PROCESS_PURPOSE_CONTAINING_CAPABILITY_OFFSET,
+           sizeof(decoded.containing_capability));
+
+    /* Syntax validates two distinct issued rows. Neither the family maximum
+     * nor the local Source extent supplies an unreceived Target assignment. */
+    {
+        const uint8_t *family = wire + QEMU_CRUCIBLE_PROCESS_FAMILY_OFFSET;
+        QemuCrucibleProcessAssignmentRecord *assignments[2] = {
+            &decoded.family.source, &decoded.family.target,
+        };
+
+        if (memcmp(family, QEMU_CRUCIBLE_PROCESS_FAMILY_MAGIC, 8) ||
+            ldl_be_p(family + 8) != QEMU_CRUCIBLE_PROCESS_FAMILY_SCHEMA) {
+            return -EPROTONOSUPPORT;
+        }
+        if (ldl_be_p(family + 12) != QEMU_CRUCIBLE_PROCESS_FAMILY_BYTES) {
+            return -EINVAL;
+        }
+        memcpy(decoded.family.containing_capability, family + 16, 32);
+        decoded.family.account_generation = ldq_be_p(family + 48);
+        decoded.family.assignment_generation = ldq_be_p(family + 56);
+        if (memcmp(decoded.family.containing_capability,
+                   decoded.containing_capability, 32) ||
+            decoded.family.account_generation != decoded.account_generation ||
+            !decoded.family.assignment_generation) {
+            return -ESTALE;
+        }
+        for (size_t index = 0; index < 2; index++) {
+            const uint8_t *row = family + QEMU_CRUCIBLE_PROCESS_FAMILY_ROWS_OFFSET +
+                index * QEMU_CRUCIBLE_PROCESS_FAMILY_ROW_BYTES;
+            QemuCrucibleProcessAssignmentRecord *assignment = assignments[index];
+
+            if (ldl_be_p(row) != index || ldl_be_p(row + 4)) {
+                return -EINVAL;
+            }
+            memcpy(assignment->assignment_id, row + 8, 32);
+            assignment->extent = ldq_be_p(row + 40);
+            assignment->reserved = ldq_be_p(row + 48);
+            assignment->memory_limit = ldq_be_p(row + 56);
+            assignment->writable_file_limit = ldq_be_p(row + 64);
+            assignment->task_limit = ldq_be_p(row + 72);
+            assignment->fd_limit = ldq_be_p(row + 80);
+            assignment->vcpu_limit = ldq_be_p(row + 88);
+            if (!purpose_nonzero(assignment->assignment_id, 32) ||
+                !assignment->extent ||
+                assignment->reserved ||
+                !assignment->memory_limit ||
+                assignment->memory_limit > assignment->extent ||
+                assignment->memory_limit == UINT64_MAX ||
+                assignment->writable_file_limit == UINT64_MAX ||
+                !assignment->task_limit || assignment->task_limit == UINT64_MAX ||
+                !assignment->fd_limit || assignment->fd_limit == UINT64_MAX ||
+                !assignment->vcpu_limit || assignment->vcpu_limit == UINT64_MAX) {
+                return -EINVAL;
+            }
+        }
+        /* Each reserved ceiling is constrained by the same actual parent's
+         * aggregate contract. Rows cannot be summed into new CPU/task grants. */
+        for (size_t index = 0; index < 2; index++) {
+            const QemuCrucibleProcessAssignmentRecord *assignment = assignments[index];
+
+            if (assignment->vcpu_limit >
+                UINT64_MAX / QEMU_CRUCIBLE_PROCESS_PURPOSE_CPU_PERIOD) {
+                return -EOVERFLOW;
+            }
+            if (assignment->task_limit > decoded.parent_task_limit ||
+                assignment->vcpu_limit * QEMU_CRUCIBLE_PROCESS_PURPOSE_CPU_PERIOD >
+                    decoded.parent_cpu_quota) {
+                return -ENOSPC;
+            }
+        }
+        if (!memcmp(decoded.family.source.assignment_id,
+                    decoded.family.target.assignment_id, 32) ||
+            decoded.subdivision_index != QEMU_CRUCIBLE_PROCESS_FAMILY_SOURCE_ROLE ||
+            decoded.family.source.extent != decoded.local_extent ||
+            decoded.family.source.memory_limit != decoded.memory_limit ||
+            decoded.family.source.writable_file_limit != decoded.writable_file_limit ||
+            decoded.family.source.task_limit != decoded.task_limit ||
+            decoded.family.source.fd_limit != decoded.fd_limit ||
+            decoded.family.source.vcpu_limit != decoded.vcpu_limit) {
+            return -ESTALE;
+        }
+    }
+
+    if (!decoded.original_total || !decoded.gross_process ||
+        !decoded.account_generation || !decoded.process_generation ||
+        decoded.live_incarnations != 1 ||
+        !decoded.containing_operation || !decoded.containing_start ||
+        !decoded.containing_poll ||
+        decoded.containing_end <= decoded.containing_start ||
+        !purpose_nonzero(decoded.containing_capability, 32) ||
+        !purpose_nonzero(decoded.artifact_digest, 32) ||
+        !decoded.artifact_machine || decoded.artifact_machine > UINT16_MAX ||
+        !decoded.local_extent ||
+        decoded.maximum_incarnations !=
+            QEMU_CRUCIBLE_PROCESS_PURPOSE_MAX_INCARNATIONS ||
+        decoded.subdivision_index >= decoded.maximum_incarnations) {
+        return -EINVAL;
+    }
+    /* These are finite issued ceilings, not FD numbers or request extents.
+     * Platform representation and effective equality remain constructor cuts.
+     * A finite zero per-file ceiling is syntax, never capacity credit.
+     * Selected child memory is a positive ceiling within its issued local share.
+     */
+    if (!decoded.memory_limit || decoded.memory_limit == UINT64_MAX ||
+        decoded.memory_limit > decoded.local_extent ||
+        decoded.writable_file_limit == UINT64_MAX ||
+        !decoded.task_limit || decoded.task_limit == UINT64_MAX ||
+        !decoded.fd_limit || decoded.fd_limit == UINT64_MAX ||
+        !decoded.vcpu_limit || decoded.vcpu_limit == UINT64_MAX ||
+        !decoded.parent_cpu_quota || decoded.parent_cpu_quota == UINT64_MAX ||
+        decoded.parent_cpu_period != QEMU_CRUCIBLE_PROCESS_PURPOSE_CPU_PERIOD ||
+        decoded.parent_cpu_quota % QEMU_CRUCIBLE_PROCESS_PURPOSE_CPU_PERIOD ||
+        !decoded.parent_task_limit || decoded.parent_task_limit == UINT64_MAX ||
+        !decoded.child_uid || decoded.child_uid > UINT32_MAX ||
+        !decoded.child_gid || decoded.child_gid > UINT32_MAX) {
+        return -EINVAL;
+    }
+    if (!purpose_add(&outside, decoded.assigned_outside) ||
+        !purpose_add(&outside, decoded.pending_cleanup) ||
+        !purpose_add(&outside, decoded.pending_workspace) ||
+        !purpose_add(&outside, decoded.pending_startup) ||
+        !purpose_add(&outside, decoded.assigned_startup)) {
+        return -EOVERFLOW;
+    }
+    if (!purpose_add(&issued_shares, decoded.family.source.extent) ||
+        !purpose_add(&issued_shares, decoded.family.target.extent)) {
+        return -EOVERFLOW;
+    }
+    if (issued_shares > decoded.gross_process) {
+        return -ENOSPC;
+    }
+    if (outside > decoded.original_total ||
+        decoded.gross_process > decoded.original_total - outside ||
+        decoded.local_extent > decoded.gross_process) {
+        return -ENOSPC;
+    }
+
+    for (size_t index = 0; index < QEMU_CRUCIBLE_PROCESS_PURPOSE_ROLE_COUNT;
+         index++) {
+        const uint8_t *row = wire + QEMU_CRUCIBLE_PROCESS_PURPOSE_ROLES_OFFSET +
+            index * QEMU_CRUCIBLE_PROCESS_PURPOSE_ROLE_BYTES;
+        QemuCrucibleProcessPurposeRequest *request = &decoded.requests[index];
+
+        if (ldl_be_p(row + QEMU_CRUCIBLE_PROCESS_PURPOSE_ROLE_ID_OFFSET) !=
+                index + 1 ||
+            ldl_be_p(row + QEMU_CRUCIBLE_PROCESS_PURPOSE_ROLE_RESERVED_OFFSET)) {
+            return -EINVAL;
+        }
+        request->extent =
+            ldq_be_p(row + QEMU_CRUCIBLE_PROCESS_PURPOSE_ROLE_EXTENT_OFFSET);
+        request->alignment =
+            ldq_be_p(row + QEMU_CRUCIBLE_PROCESS_PURPOSE_ROLE_ALIGNMENT_OFFSET);
+        request->count =
+            ldq_be_p(row + QEMU_CRUCIBLE_PROCESS_PURPOSE_ROLE_BIRTH_COUNT_OFFSET);
+        if (!request->extent || !request->alignment ||
+            (request->alignment & (request->alignment - 1)) ||
+            request->extent % request->alignment || request->count != 1) {
+            return -EINVAL;
+        }
+        if (!purpose_add(&control, request->extent)) {
+            return -EOVERFLOW;
+        }
+    }
+    if (!purpose_add(&control, decoded.incarnation_guest)) {
+        return -EOVERFLOW;
+    }
+    if (control > decoded.local_extent) {
+        return -ENOSPC;
+    }
+    /* The issuer binds this guest debit to the occupied local share. The
+     * constructor must additionally protect its actual optional workspace and
+     * native prefix; neither a live census nor a CLI value creates a debit.
+     */
+    decoded.standing_file_device = ldq_be_p(wire + 1000);
+    decoded.standing_file_inode = ldq_be_p(wire + 1008);
+    decoded.standing_file_extent = ldq_be_p(wire + 1016);
+    if (decoded.standing_file_extent != QEMU_CRUCIBLE_STANDING_MAPPING_BYTES) {
+        return -EINVAL;
+    }
+    memcpy(decoded.standing_initial, wire + 1024, sizeof(decoded.standing_initial));
+    standing_status = qemu_crucible_standing_record_decode_v4(
+        decoded.standing_initial, sizeof(decoded.standing_initial), &decoded.standing);
+
+    if (standing_status) {
+        return standing_status;
+    }
+    if (decoded.standing.state != 0 ||
+        decoded.standing.account_generation != decoded.account_generation ||
+        decoded.standing.process_generation != decoded.process_generation ||
+        memcmp(decoded.standing.family_capability, decoded.containing_capability, 32) ||
+        memcmp(decoded.standing.source_reservation, decoded.family.source.assignment_id, 32) ||
+        memcmp(decoded.standing.artifact_digest, decoded.artifact_digest, 32)) {
+        return -ESTALE;
+    }
+    *out = decoded;
+    return 0;
+}
