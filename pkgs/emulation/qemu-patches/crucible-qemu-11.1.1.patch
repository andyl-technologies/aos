+int qemu_crucible_source_initial_register_workspace_current_v1(
+    CPUState *cpu, QemuCrucibleInitialRegisterWorkspaceOwner *owner,
+    QemuCrucibleInitialRegisterWorkspaceOwner **holder)
+{
+#ifdef CONFIG_LINUX
+    struct QemuCrucibleInitialCpuParticipant *participant = NULL;
+    bool authenticated = false;
+    int first = initial_register_workspace_identity(owner, holder, false, false);
+    int post;
+
+    if (!first && (!cpu || cpu != owner->constructor_cpu || owner->closing ||
+        !owner->mapped || owner->physical_returned ||
+        owner->pinned_cpus != owner->layout.cpu_count)) {
+        first = -EPERM;
+    }
+    if (!first) {
+        first = qemu_plugin_crucible_initial_cpu_dispatch_current_v1(
+            cpu, &cpu->crucible_initial_participant, true, false);
+    }
+    if (!first) {
+        first = initial_cpu_identity(cpu, &cpu->crucible_initial_participant,
+                                     &participant);
+    }
+    if (!first && (participant->operation_serial != owner->operation_serial ||
+        participant->group_serial != owner->group_serial ||
+        participant->binding != owner->account->binding)) {
+        first = -ESTALE;
+    }
+    if (!first) {
+        first = qemu_crucible_source_initial_cpu_current_v1(
+            cpu, &cpu->crucible_initial_participant);
+    }
+    if (!first) {
+        first = initial_cpu_original_current(participant);
+    }
+    if (!first) {
+        first = initial_register_workspace_dependencies_current(owner);
+    }
+    /* Every outcome attempts the independent same-callback post. A foreign
+     * caller cannot alter this owner's journal, even after a negative first. */
+    post = initial_register_workspace_current_post(
+        cpu, owner, holder, &authenticated);
+    if (authenticated) {
+        initial_register_workspace_current_record(owner, first, post);
+    }
+    if (first || !authenticated) {
+        return first ? first : post;
+    }
+    return owner->first_status ? owner->first_status :
+        owner->post_status ? owner->post_status : post;
+#else
+    return -ENOTSUP;
+#endif
+}
