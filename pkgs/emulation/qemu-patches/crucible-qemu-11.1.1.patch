+int qemu_crucible_parent_park_invoke_v1(
+    QemuCrucibleParentParkLoan *loan, QemuCrucibleNativeParkRequest *request,
+    struct qemu_plugin_crucible_parent_park_drain_status *out)
+{
+#ifdef CONFIG_LINUX
+    struct qemu_plugin_crucible_parent_park_drain_invocation invocation;
+    QemuCrucibleParentParkReceive *owner = &startup_source.parent_park_receive;
+    uint64_t unused;
+    qemu_plugin_crucible_parent_park_drain_cb_t callback;
+    void *userdata;
+    int callback_status;
+    int status = parent_park_main_identity(true);
+
+    if (!status) {
+        status = qemu_crucible_parent_park_prepared_identity_v1(loan);
+    }
+    if (!status) {
+        status = qemu_crucible_native_park_request_identity(request, loan);
+    }
+    if (!status) {
+        status = qemu_crucible_native_park_request_invocation(request, &invocation);
+    }
+    if (status || parent_park_source_overlap(out, sizeof(*out))) {
+        return status ? status : -EINVAL;
+    }
+    if (invocation.action != QEMU_PLUGIN_CRUCIBLE_PARENT_PARK_DRAIN_DISPOSITION) {
+        status = qemu_crucible_parent_park_prepared_current_v1(loan, &unused);
+        if (status) {
+            return status;
+        }
+    }
+    if (!loan->ctx_retained) {
+        return -ENOKEY;
+    }
+    if (loan->callback_request || loan->callback_invocation ||
+        loan->callback || loan->callback_userdata) {
+        return -EBUSY;
+    }
+
+    callback = startup_source.parent_park_callback;
+    userdata = startup_source.parent_park_userdata;
+    loan->callback_request = request;
+    loan->callback_invocation = &invocation;
+    loan->callback = callback;
+    loan->callback_userdata = userdata;
+    loan->transition_busy = true;
+    SOURCE_CALLBACK_MASKED_INVOKE(
+        callback_status, &startup_source.parent_park_callback,
+        callback, userdata, owner->installer.plugin_id, &invocation, out, userdata);
+    /* Retire the stack borrow before the dispatcher can advance the request,
+     * including an unchanged-output negative or terminal containment result. */
+    loan->callback_userdata = NULL;
+    loan->callback = NULL;
+    loan->callback_invocation = NULL;
+    loan->callback_request = NULL;
+    loan->transition_busy = false;
+
+    /* Preserve independent observations even on an unchanged-output negative
+     * callback. Cleanup uses identity and never borrows a fresh time budget. */
+    parent_park_fail(owner, callback_status, false);
+    parent_park_pair_raw_post(owner);
+    return callback_status > 0 ? -EPROTO : callback_status;
+#else
+    return -ENOTSUP;
+#endif
+}
