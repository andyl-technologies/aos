+int qemu_plugin_crucible_native_use_borrow_v1(
+    QemuCrucibleCommandConsumerStorage *storage,
+    QemuCrucibleNativeInvocation **projection, uint64_t *serial)
+{
+    QemuCrucibleNativeInvocationRegistry *registry;
+    QemuCrucibleNativeInvocation *frame;
+    pid_t process;
+    int status = -EPERM;
+
+    if (!projection || !serial || *projection || *serial) {
+        return -EINVAL;
+    }
+    registry = native_registry(false);
+    if (!registry) {
+        return status;
+    }
+    process = getpid();
+    if (!registry_process_current(registry, process)) {
+        return -EPERM;
+    }
+    qemu_mutex_lock(&registry->mutex);
+    frame = top_locked(registry);
+    if (frame && registry_current_locked(registry, process) &&
+        frame->kind != QEMU_CRUCIBLE_NATIVE_VCPU_INIT &&
+        frame->kind != QEMU_CRUCIBLE_NATIVE_MAIN_CONTROL &&
+        !frame->suppressed_children && frame->storage == storage &&
+        (!frame->registration || frame->registration->active)) {
+        if (frame->use_references == UINT_MAX) {
+            status = -EOVERFLOW;
+        } else {
+            frame->use_references++;
+            *projection = frame;
+            *serial = frame->serial;
+            status = 0;
+        }
+    }
+    qemu_mutex_unlock(&registry->mutex);
+    return status;
+}
+
+int qemu_plugin_crucible_native_use_current_v1(
+    QemuCrucibleNativeInvocation *frame, uint64_t serial,
+    QemuCrucibleCommandConsumerStorage *storage)
+{
+    QemuCrucibleNativeInvocationRegistry *registry = native_registry(false);
+    pid_t process = getpid();
+    int status;
+
+    if (!registry) {
+        return -EPERM;
+    }
+    if (!registry_process_current(registry, process)) {
+        return -EPERM;
+    }
+    qemu_mutex_lock(&registry->mutex);
+    status = frame_identity_locked(registry, frame, serial, process);
+    if (!status && (!registry_current_locked(registry, process) ||
+                    !frame->live || !frame->use_references ||
+                    frame->kind == QEMU_CRUCIBLE_NATIVE_VCPU_INIT ||
+                    frame->kind == QEMU_CRUCIBLE_NATIVE_MAIN_CONTROL ||
+                    frame->suppressed_children || frame != top_locked(registry) ||
+                    frame->storage != storage ||
+                    (frame->registration && !frame->registration->active))) {
+        status = -ESTALE;
+    }
+    qemu_mutex_unlock(&registry->mutex);
+    return status;
+}
+
+int qemu_plugin_crucible_native_use_return_v1(
+    QemuCrucibleNativeInvocation **projection, uint64_t serial)
+{
+    QemuCrucibleNativeInvocationRegistry *registry = native_registry(false);
+    CPUState *release_cpu = NULL;
+    QemuCrucibleNativeInvocationTicket returned = { 0 };
+    pid_t process = getpid();
+    int status;
+
+    if (!registry || !projection) {
+        return -EPERM;
+    }
+    if (!registry_process_current(registry, process)) {
+        return -EPERM;
+    }
+    qemu_mutex_lock(&registry->mutex);
+    status = frame_identity_locked(registry, *projection, serial, process);
+    if (!status && (!(*projection)->use_references || !(*projection)->live ||
+                    *projection != top_locked(registry) ||
+                    (*projection)->suppressed_children)) {
+        /* pthread_t can be reused after a thread exits. A retained pointer
+         * and serial alone cannot prove expired-return thread incarnation. */
+        status = -ESTALE;
+    }
+    if (!status) {
+        QemuCrucibleNativeInvocation *frame = *projection;
+
+        returned = (QemuCrucibleNativeInvocationTicket) {
+            .registry = registry, .frame = frame, .serial = serial,
+        };
+        frame->use_references--;
+        *projection = NULL;
+        release_cpu = frame_reclaim_locked(frame);
+    }
+    qemu_mutex_unlock(&registry->mutex);
+    if (release_cpu) {
+        frame_cpu_pin_return(returned, release_cpu);
+    }
+    return status;
+}
+
+QemuCrucibleNativeRegistration *qemu_plugin_crucible_native_register_v1(
+    const void *coordinate, void *function, void *userdata,
+    enum QemuCrucibleNativeInvocationKind kind, bool installing, int *status)
+{
+    /* Translated scratch arrays have no authentic prebirth descriptor payer
+     * or nominal child registrar. Keep the original callback behavior, and
+     * never adopt arbitrary coordinates into an owning Native association. */
+    (void)coordinate;
+    (void)function;
+    (void)userdata;
+    (void)kind;
+    (void)installing;
+    if (status) {
+        *status = native_selection() ? -ENOKEY : -ENOENT;
+    }
+    return NULL;
+}
+
+void qemu_plugin_crucible_native_registration_release_v1(
+    QemuCrucibleNativeRegistration *record)
+{
+    QemuCrucibleNativeInvocationRegistry *registry;
+    pid_t process;
+    size_t i;
+
+    if (!record) {
+        return;
+    }
+    /* The actual descriptor retains this record in Source's permanent pool.
+     * Do not query Source while a genuine registrar holds plugin.lock. */
+    registry = record->owner;
+    process = getpid();
+    if (!registry_process_current(registry, process)) {
+        return;
+    }
+    qemu_mutex_lock(&registry->mutex);
+    if (registry_identity_locked(registry, process)) {
+        if (record->group && group_identity_locked(registry, record->group)) {
+            QemuCrucibleNativeRegistrationGroup *group = record->group;
+
+            for (i = 0; i < group->member_count; i++) {
+                if (record == &group->members[i]) {
+                    record->active = false;
+                    record->descriptor_retained = false;
+                    group->complete = false;
+                    break;
+                }
+            }
+        }
+        for (i = 0; i < ARRAY_SIZE(registry->registrations); i++) {
+            if (record == &registry->registrations[i] && record->owner == registry) {
+                record->active = false;
+                record->descriptor_retained = false;
+                break;
+            }
+        }
+    }
+    qemu_mutex_unlock(&registry->mutex);
+}
+
+void qemu_plugin_crucible_native_registration_retire_v1(const void *coordinate)
+{
+    QemuCrucibleNativeInvocationRegistry *registry;
+#ifndef CONFIG_USER_ONLY
+    /* Singleton registrars call this outside plugin/native locks. The pure
+     * permanent-holder getter remains available before selection/while closing. */
+    registry = qemu_crucible_startup_source_native_registry_v1(NULL, false);
+#else
+    registry = NULL;
+#endif
+    pid_t process = getpid();
+    size_t i;
+
+    if (!registry) {
+        return;
+    }
+    if (!registry_process_current(registry, process)) {
+        return;
+    }
+    qemu_mutex_lock(&registry->mutex);
+    if (registry_identity_locked(registry, process)) {
+        for (i = 0; i < ARRAY_SIZE(registry->registrations); i++) {
+            QemuCrucibleNativeRegistration *record = &registry->registrations[i];
+
+            if (record->coordinate == coordinate) {
+                record->active = false;
+                record->descriptor_retained = false;
+            }
+        }
+    }
+    qemu_mutex_unlock(&registry->mutex);
+}
+
+void qemu_plugin_crucible_native_translations_retire_v1(void)
+{
+    QemuCrucibleNativeInvocationRegistry *registry = native_registry(false);
+    pid_t process = getpid();
+    size_t i;
+
+    if (!registry) {
+        return;
+    }
+    if (!registry_process_current(registry, process)) {
+        return;
+    }
+    qemu_mutex_lock(&registry->mutex);
+    if (registry_current_locked(registry, process)) {
+        for (i = 0; i < ARRAY_SIZE(registry->registrations); i++) {
+            QemuCrucibleNativeRegistration *record = &registry->registrations[i];
+
+            if (record->kind == QEMU_CRUCIBLE_NATIVE_TRANSLATED ||
+                record->kind == QEMU_CRUCIBLE_NATIVE_MEMORY) {
+                record->active = false;
+            }
+        }
+    }
+    qemu_mutex_unlock(&registry->mutex);
+}
+
+/* Generated code supplies its captured function and userdata independently
+ * of the retained record. Failed physical admission leaves callback behavior
+ * intact, while no stale record can grant access to the command body. */
+QEMU_DISABLE_CFI
+void qemu_plugin_crucible_native_udata_v1(unsigned int cpu_index, void *userdata,
+                                         void *function,
+                                         QemuCrucibleNativeRegistration *record)
+{
+    QemuCrucibleNativeInvocationTicket ticket = record ?
+        qemu_plugin_crucible_native_enter_v1(NULL, record, function, userdata,
+                                            QEMU_CRUCIBLE_NATIVE_TRANSLATED) :
+        qemu_plugin_crucible_native_mask_v1(function, function, userdata);
+    qemu_plugin_vcpu_udata_cb_t callback = function;
+
+    callback(cpu_index, userdata);
+    qemu_plugin_crucible_native_exit_v1(ticket);
+}
+
+QEMU_DISABLE_CFI
+void qemu_plugin_crucible_native_memory_v1(unsigned int cpu_index,
+                                          qemu_plugin_meminfo_t info,
+                                          uint64_t address, void *userdata,
+                                          void *function,
+                                          QemuCrucibleNativeRegistration *record)
+{
+    QemuCrucibleNativeInvocationTicket ticket = record ?
+        qemu_plugin_crucible_native_enter_v1(NULL, record, function, userdata,
+                                            QEMU_CRUCIBLE_NATIVE_MEMORY) :
+        qemu_plugin_crucible_native_mask_v1(function, function, userdata);
+    qemu_plugin_vcpu_mem_cb_t callback = function;
+
+    callback(cpu_index, info, address, userdata);
+    qemu_plugin_crucible_native_exit_v1(ticket);
+}
