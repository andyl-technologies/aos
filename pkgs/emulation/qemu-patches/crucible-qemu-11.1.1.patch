+
+#include "qemu/osdep.h"
+
+#include "io/channel-file.h"
+#include "qemu/module.h"
+#include "target/arm/crucible-fingerprint.h"
+
+static GBytes *project_arm_continuation(const ARMCPU *cpu,
+                                        bool expected_success)
+{
+    char *path = NULL;
+    int read_fd;
+    int write_fd = g_file_open_tmp("qemu-arm-fingerprint-XXXXXX", &path,
+                                   NULL);
+    QIOChannelFile *channel;
+    QEMUFile *file;
+    Error *error = NULL;
+    struct stat stat_buffer;
+    bool success;
+
+    g_assert_cmpint(write_fd, >=, 0);
+    read_fd = dup(write_fd);
+    g_assert_cmpint(read_fd, >=, 0);
+    unlink(path);
+    g_free(path);
+
+    channel = qio_channel_file_new_fd(write_fd);
+    file = qemu_file_new_output(QIO_CHANNEL(channel));
+    success = arm_cpu_continuation_fingerprint_validate(cpu, &error);
+    if (success) {
+        arm_cpu_continuation_fingerprint_put(file, cpu);
+    }
+    g_assert_cmpint(success, ==, expected_success);
+    if (!success) {
+        g_assert_nonnull(error);
+        error_free(error);
+        qemu_fclose(file);
+        object_unref(OBJECT(channel));
+        g_assert_cmpint(fstat(read_fd, &stat_buffer), ==, 0);
+        g_assert_cmpint(stat_buffer.st_size, ==, 0);
+        close(read_fd);
+        return NULL;
+    }
+
+    g_assert_null(error);
+    g_assert_cmpint(qemu_fflush(file), ==, 0);
+    g_assert_cmpint(qemu_fclose(file), ==, 0);
+
+    g_assert_cmpint(fstat(read_fd, &stat_buffer), ==, 0);
+    g_autofree uint8_t *data = g_malloc(stat_buffer.st_size);
+    g_assert_cmpint(pread(read_fd, data, stat_buffer.st_size, 0), ==,
+                    stat_buffer.st_size);
+    GBytes *bytes = g_bytes_new(data, stat_buffer.st_size);
+    object_unref(OBJECT(channel));
+    close(read_fd);
+    return bytes;
+}
+
+static void assert_projection_equal(const ARMCPU *first,
+                                    const ARMCPU *second)
+{
+    g_autoptr(GBytes) first_bytes = project_arm_continuation(first, true);
+    g_autoptr(GBytes) second_bytes = project_arm_continuation(second, true);
+
+    g_assert_true(g_bytes_equal(first_bytes, second_bytes));
+}
+
+static void assert_projection_changed(const ARMCPU *first,
+                                      const ARMCPU *second)
+{
+    g_autoptr(GBytes) first_bytes = project_arm_continuation(first, true);
+    g_autoptr(GBytes) second_bytes = project_arm_continuation(second, true);
+
+    g_assert_false(g_bytes_equal(first_bytes, second_bytes));
+}
+
+static void initialize_inactive_cpu(ARMCPU *cpu)
+{
+    cpu->parent_obj.exception_index = -1;
+    cpu->env.exclusive_addr = UINT64_MAX;
+}
+
+static void test_exclusive_projection(void)
+{
+    ARMCPU first = { 0 };
+    ARMCPU second = { 0 };
+
+    initialize_inactive_cpu(&first);
+    initialize_inactive_cpu(&second);
+    first.env.exclusive_val = 1;
+    first.env.exclusive_high = 2;
+    second.env.exclusive_val = 3;
+    second.env.exclusive_high = 4;
+    assert_projection_equal(&first, &second);
+
+    first.env.exclusive_addr = second.env.exclusive_addr = 0x1000;
+    assert_projection_changed(&first, &second);
+}
+
+static void test_exception_projection(void)
+{
+    ARMCPU first = { 0 };
+    ARMCPU second = { 0 };
+
+    initialize_inactive_cpu(&first);
+    initialize_inactive_cpu(&second);
+    first.env.exception.syndrome = 1;
+    first.env.exception.vaddress = 2;
+    first.env.exception.fsr = 3;
+    first.env.exception.target_el = 1;
+    second.env.exception.syndrome = 4;
+    second.env.exception.vaddress = 5;
+    second.env.exception.fsr = 6;
+    second.env.exception.target_el = 2;
+    assert_projection_equal(&first, &second);
+
+    second.parent_obj.exception_index = 7;
+    assert_projection_changed(&first, &second);
+
+    first.parent_obj.exception_index = 7;
+    assert_projection_changed(&first, &second);
+}
+
+static void test_serror_projection(void)
+{
+    ARMCPU first = { 0 };
+    ARMCPU second = { 0 };
+
+    initialize_inactive_cpu(&first);
+    initialize_inactive_cpu(&second);
+    first.env.serror.has_esr = true;
+    first.env.serror.esr = 1;
+    second.env.serror.esr = 2;
+    assert_projection_equal(&first, &second);
+
+    second.env.serror.pending = true;
+    assert_projection_changed(&first, &second);
+
+    first.env.serror.pending = true;
+    first.env.serror.has_esr = false;
+    assert_projection_equal(&first, &second);
+
+    first.env.serror.has_esr = true;
+    assert_projection_changed(&first, &second);
+}
+
+static void test_hardware_error_projection(void)
+{
+    ARMCPU first = { 0 };
+    ARMCPU second = { 0 };
+
+    initialize_inactive_cpu(&first);
+    initialize_inactive_cpu(&second);
+    first.env.crucible_hardware_error.syndrome = 1;
+    first.env.crucible_hardware_error.address = 2;
+    first.env.crucible_hardware_error.disr = 3;
+    second.env.crucible_hardware_error.syndrome = 4;
+    second.env.crucible_hardware_error.address = 5;
+    second.env.crucible_hardware_error.disr = 6;
+    assert_projection_equal(&first, &second);
+
+    first.env.crucible_hardware_error.synchronous_pending = true;
+    second.env.crucible_hardware_error.synchronous_pending = true;
+    assert_projection_changed(&first, &second);
+
+    first.env.crucible_hardware_error.asynchronous_pending = true;
+    g_assert_null(project_arm_continuation(&first, false));
+
+    first.env.crucible_hardware_error.synchronous_pending = false;
+    first.env.crucible_hardware_error.asynchronous_pending = false;
+    first.env.crucible_hardware_error.fatal = true;
+    g_assert_null(project_arm_continuation(&first, false));
+}
+
+static void test_timer_projection(void)
+{
+    ARMCPU first = { 0 };
+    ARMCPU second = { 0 };
+    QEMUTimer first_timer = { .expire_time = -1 };
+    QEMUTimer second_timer = { .expire_time = -1 };
+
+    initialize_inactive_cpu(&first);
+    initialize_inactive_cpu(&second);
+    first.gt_timer[GTIMER_PHYS] = &first_timer;
+    second.gt_timer[GTIMER_PHYS] = &second_timer;
+    first.crucible_gt_guest_deadline_ns[GTIMER_PHYS] = 1;
+    first.crucible_gt_transform_generation[GTIMER_PHYS] = 2;
+    second.crucible_gt_guest_deadline_ns[GTIMER_PHYS] = 3;
+    second.crucible_gt_transform_generation[GTIMER_PHYS] = 4;
+    assert_projection_equal(&first, &second);
+
+    first_timer.expire_time = 10;
+    second_timer.expire_time = 20;
+    assert_projection_changed(&first, &second);
+
+    first_timer.expire_time = second_timer.expire_time = -1;
+    first.crucible_gt_timer_arm_sequence[GTIMER_PHYS] = 1;
+    second.crucible_gt_timer_arm_sequence[GTIMER_PHYS] = 1;
+    assert_projection_changed(&first, &second);
+}
+
+static void test_projection_does_not_mutate(void)
+{
+    ARMCPU cpu = { 0 };
+    ARMCPU before;
+    g_autoptr(GBytes) projection = NULL;
+
+    initialize_inactive_cpu(&cpu);
+    cpu.env.serror.pending = true;
+    cpu.env.serror.has_esr = true;
+    cpu.env.serror.esr = 0x1234;
+    before = cpu;
+
+    projection = project_arm_continuation(&cpu, true);
+    g_assert_nonnull(projection);
+    g_assert_cmpmem(&cpu, sizeof(cpu), &before, sizeof(before));
+}
+
+int main(int argc, char **argv)
+{
+    module_call_init(MODULE_INIT_QOM);
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/crucible/arm/exclusive", test_exclusive_projection);
+    g_test_add_func("/crucible/arm/exception", test_exception_projection);
+    g_test_add_func("/crucible/arm/serror", test_serror_projection);
+    g_test_add_func("/crucible/arm/hardware-error",
+                    test_hardware_error_projection);
+    g_test_add_func("/crucible/arm/timer", test_timer_projection);
+    g_test_add_func("/crucible/arm/nonmutation",
+                    test_projection_does_not_mutate);
+    return g_test_run();
+}
diff --git a/tests/unit/test-crucible-e1000-fingerprint.c b/tests/unit/test-crucible-e1000-fingerprint.c
new file mode 100644
index 0000000000000000000000000000000000000000..a56f97cc637d959e34eacb00cb73c9e4be22e0fc
--- /dev/null
+++ b/tests/unit/test-crucible-e1000-fingerprint.c
@@ -0,0 +1,179 @@
+/*
+ * Intel e1000 fingerprint projection tests
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+#include "qemu/osdep.h"
+
+#include "hw/net/mii.h"
+#include "hw/pci/pci_device.h"
+#include "net/checksum.h"
+#include "net/eth.h"
+#include "net/net.h"
+
+#include "hw/net/e1000_common.h"
+#include "hw/net/e1000-fingerprint.h"
+#include "io/channel-file.h"
+#include "qemu/module.h"
+
+typedef struct E1000TestState {
+    E1000FingerprintState projection;
+    e1000x_txd_props main_tx_props;
+    e1000x_txd_props tso_tx_props;
+    uint8_t tx_header[E1000_FINGERPRINT_HEADER_SIZE];
+    uint8_t tx_data[E1000_FINGERPRINT_DATA_SIZE];
+    uint16_t eeprom_data[E1000_FINGERPRINT_EEPROM_WORDS];
+    uint16_t phy_reg[E1000_FINGERPRINT_PHY_WORDS];
+    uint32_t mac_reg[E1000_FINGERPRINT_MAC_REGS];
+} E1000TestState;
+
+static void initialize_e1000(E1000TestState *state)
+{
+    memset(state, 0, sizeof(*state));
+    state->projection.main_tx_props = &state->main_tx_props;
+    state->projection.tso_tx_props = &state->tso_tx_props;
+    state->projection.tx_header = state->tx_header;
+    state->projection.tx_data = state->tx_data;
+    state->projection.eeprom_data = state->eeprom_data;
+    state->projection.phy_reg = state->phy_reg;
+    state->projection.mac_reg = state->mac_reg;
+}
+
+static GBytes *project_e1000(E1000FingerprintState *state,
+                             bool expected_success)
+{
+    char *path = NULL;
+    int read_fd;
+    int write_fd = g_file_open_tmp("qemu-e1000-fingerprint-XXXXXX", &path,
+                                   NULL);
+    QIOChannelFile *channel;
+    QEMUFile *file;
+    Error *error = NULL;
+    struct stat stat_buffer;
+    bool success;
+
+    g_assert_cmpint(write_fd, >=, 0);
+    read_fd = dup(write_fd);
+    g_assert_cmpint(read_fd, >=, 0);
+    unlink(path);
+    g_free(path);
+    channel = qio_channel_file_new_fd(write_fd);
+    file = qemu_file_new_output(QIO_CHANNEL(channel));
+
+    success = e1000_state_fingerprint_projection(file, state, &error);
+    g_assert_cmpint(success, ==, expected_success);
+    if (!success) {
+        g_assert_nonnull(error);
+        error_free(error);
+        qemu_fclose(file);
+        object_unref(OBJECT(channel));
+
+        g_assert_cmpint(fstat(read_fd, &stat_buffer), ==, 0);
+        g_assert_cmpint(stat_buffer.st_size, ==, 0);
+        close(read_fd);
+        return NULL;
+    }
+    g_assert_null(error);
+    g_assert_cmpint(qemu_fflush(file), ==, 0);
+    g_assert_cmpint(qemu_fclose(file), ==, 0);
+
+    g_assert_cmpint(fstat(read_fd, &stat_buffer), ==, 0);
+    g_autofree uint8_t *data = g_malloc(stat_buffer.st_size);
+    g_assert_cmpint(pread(read_fd, data, stat_buffer.st_size, 0), ==,
+                    stat_buffer.st_size);
+    GBytes *bytes = g_bytes_new(data, stat_buffer.st_size);
+    object_unref(OBJECT(channel));
+    close(read_fd);
+    return bytes;
+}
+
+static void assert_e1000_distinct(E1000TestState *candidate,
+                                  const GBytes *baseline)
+{
+    g_autoptr(GBytes) candidate_bytes =
+        project_e1000(&candidate->projection, true);
+
+    g_assert_false(g_bytes_equal(baseline, candidate_bytes));
+}
+
+static void test_e1000_migrated_state(void)
+{
+    g_autofree E1000TestState *baseline_state = g_new0(E1000TestState, 1);
+    g_autofree E1000TestState *candidate = g_new0(E1000TestState, 1);
+    g_autoptr(GBytes) baseline = NULL;
+
+    initialize_e1000(baseline_state);
+    initialize_e1000(candidate);
+    baseline = project_e1000(&baseline_state->projection, true);
+
+    candidate->projection.rxbuf_size = 1;
+    assert_e1000_distinct(candidate, baseline);
+
+    initialize_e1000(candidate);
+    candidate->projection.eecd_val_in = 1;
+    assert_e1000_distinct(candidate, baseline);
+
+    initialize_e1000(candidate);
+    candidate->main_tx_props.paylen = 1;
+    assert_e1000_distinct(candidate, baseline);
+
+    initialize_e1000(candidate);
+    candidate->projection.tx_size = 1;
+    assert_e1000_distinct(candidate, baseline);
+
+    initialize_e1000(candidate);
+    candidate->tx_header[17] = 1;
+    assert_e1000_distinct(candidate, baseline);
+
+    initialize_e1000(candidate);
+    candidate->tx_data[4097] = 1;
+    assert_e1000_distinct(candidate, baseline);
+
+    initialize_e1000(candidate);
+    candidate->eeprom_data[7] = 1;
+    assert_e1000_distinct(candidate, baseline);
+
+    initialize_e1000(candidate);
+    candidate->phy_reg[3] = 1;
+    assert_e1000_distinct(candidate, baseline);
+
+    initialize_e1000(candidate);
+    candidate->mac_reg[0x1234] = 1;
+    assert_e1000_distinct(candidate, baseline);
+
+    initialize_e1000(candidate);
+    candidate->projection.mit_irq_level = true;
+    assert_e1000_distinct(candidate, baseline);
+
+    initialize_e1000(candidate);
+    candidate->projection.compat_flags = 1 << 3;
+    candidate->projection.tso_state_present = true;
+    candidate->tso_tx_props.mss = 1;
+    assert_e1000_distinct(candidate, baseline);
+}
+
+static void test_e1000_rejects_incomplete_state(void)
+{
+    g_autofree E1000TestState *state = g_new0(E1000TestState, 1);
+
+    initialize_e1000(state);
+    state->projection.mac_reg = NULL;
+    g_assert_null(project_e1000(&state->projection, false));
+
+    initialize_e1000(state);
+    state->projection.tso_state_present = true;
+    state->projection.tso_tx_props = NULL;
+    g_assert_null(project_e1000(&state->projection, false));
+}
+
+int main(int argc, char **argv)
+{
+    module_call_init(MODULE_INIT_QOM);
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/crucible/e1000/migrated-state",
+                    test_e1000_migrated_state);
+    g_test_add_func("/crucible/e1000/incomplete-state",
+                    test_e1000_rejects_incomplete_state);
+    return g_test_run();
+}
diff --git a/tests/unit/test-crucible-fdc-fingerprint.c b/tests/unit/test-crucible-fdc-fingerprint.c
new file mode 100644
index 0000000000000000000000000000000000000000..118d1778a4dc88077a56e15648cf174aeb5f5d41
--- /dev/null
+++ b/tests/unit/test-crucible-fdc-fingerprint.c
@@ -0,0 +1,212 @@
+/*
+ * Floppy disk controller fingerprint projection tests
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "qemu/osdep.h"
+
+#include "block/block_int-global-state.h"
+#include "hw/block/fdc-fingerprint.h"
+#include "io/channel-file.h"
+#include "qemu/main-loop.h"
+#include "qemu/module.h"
+#include "system/block-backend.h"
+
+static BlockDriver test_media_driver = {
+    .format_name = "crucible-fdc-test-media",
+    .instance_size = 1,
+};
+
+static void initialize_fdc(FDCtrl *fdctrl, uint8_t fifo[512],
+                           QEMUTimer *result_timer)
+{
+    memset(fdctrl, 0, sizeof(*fdctrl));
+    memset(fifo, 0, 512);
+    memset(result_timer, 0, sizeof(*result_timer));
+    result_timer->expire_time = -1;
+
+    fdctrl->fifo = fifo;
+    fdctrl->fifo_size = 512;
+    fdctrl->result_timer = result_timer;
+    fdctrl->phase = 1;
+    fdctrl->num_floppies = MAX_FD;
+    for (size_t index = 0; index < MAX_FD; index++) {
+        fdctrl->drives[index].drive = FLOPPY_DRIVE_TYPE_NONE;
+        fdctrl->drives[index].disk = FLOPPY_DRIVE_TYPE_NONE;
+        fdctrl->drives[index].ro = true;
+        fdctrl->drives[index].media_changed = 1;
+    }
+}
+
+static GBytes *project_fdc(FDCtrl *fdctrl, bool expected_success)
+{
+    char *path = NULL;
+    int read_fd;
+    int write_fd = g_file_open_tmp("qemu-fdc-fingerprint-XXXXXX", &path,
+                                   NULL);
+    QIOChannelFile *channel;
+    QEMUFile *file;
+    Error *error = NULL;
+    struct stat stat_buffer;
+    bool success;
+
+    g_assert_cmpint(write_fd, >=, 0);
+    read_fd = dup(write_fd);
+    g_assert_cmpint(read_fd, >=, 0);
+    unlink(path);
+    g_free(path);
+    channel = qio_channel_file_new_fd(write_fd);
+    file = qemu_file_new_output(QIO_CHANNEL(channel));
+
+    success = fdctrl_state_fingerprint_projection(file, fdctrl, &error);
+    g_assert_cmpint(success, ==, expected_success);
+    if (!success) {
+        g_assert_nonnull(error);
+        error_free(error);
+        qemu_fclose(file);
+        object_unref(OBJECT(channel));
+
+        g_assert_cmpint(fstat(read_fd, &stat_buffer), ==, 0);
+        g_assert_cmpint(stat_buffer.st_size, ==, 0);
+        close(read_fd);
+        return NULL;
+    }
+    g_assert_null(error);
+    g_assert_cmpint(qemu_fflush(file), ==, 0);
+    g_assert_cmpint(qemu_fclose(file), ==, 0);
+
+    g_assert_cmpint(fstat(read_fd, &stat_buffer), ==, 0);
+    g_autofree uint8_t *data = g_malloc(stat_buffer.st_size);
+    g_assert_cmpint(pread(read_fd, data, stat_buffer.st_size, 0), ==,
+                    stat_buffer.st_size);
+    GBytes *bytes = g_bytes_new(data, stat_buffer.st_size);
+    object_unref(OBJECT(channel));
+    close(read_fd);
+    return bytes;
+}
+
+static void assert_fdc_distinct(FDCtrl *candidate, const GBytes *baseline)
+{
+    g_autoptr(GBytes) candidate_bytes = project_fdc(candidate, true);
+
+    g_assert_false(g_bytes_equal(baseline, candidate_bytes));
+}
+
+static void test_fdc_mutable_state(void)
+{
+    uint8_t baseline_fifo[512];
+    uint8_t candidate_fifo[512];
+    QEMUTimer baseline_timer;
+    QEMUTimer candidate_timer;
+    FDCtrl baseline_state;
+    FDCtrl candidate;
+    g_autoptr(GBytes) baseline = NULL;
+
+    initialize_fdc(&baseline_state, baseline_fifo, &baseline_timer);
+    initialize_fdc(&candidate, candidate_fifo, &candidate_timer);
+    baseline = project_fdc(&baseline_state, true);
+
+    candidate.sra = 1;
+    assert_fdc_distinct(&candidate, baseline);
+
+    initialize_fdc(&candidate, candidate_fifo, &candidate_timer);
+    candidate.fifo[17] = 1;
+    assert_fdc_distinct(&candidate, baseline);
+
+    initialize_fdc(&candidate, candidate_fifo, &candidate_timer);
+    candidate.data_pos = 1;
+    assert_fdc_distinct(&candidate, baseline);
+
+    initialize_fdc(&candidate, candidate_fifo, &candidate_timer);
+    candidate.timer0 = 1;
+    assert_fdc_distinct(&candidate, baseline);
+
+    initialize_fdc(&candidate, candidate_fifo, &candidate_timer);
+    candidate.drives[0].head = 1;
+    assert_fdc_distinct(&candidate, baseline);
+
+    initialize_fdc(&candidate, candidate_fifo, &candidate_timer);
+    candidate.drives[0].media_rate = 1;
+    assert_fdc_distinct(&candidate, baseline);
+
+    initialize_fdc(&candidate, candidate_fifo, &candidate_timer);
+    candidate.reset_sensei = 1;
+    assert_fdc_distinct(&candidate, baseline);
+
+    initialize_fdc(&candidate, candidate_fifo, &candidate_timer);
+    candidate.result_timer->expire_time = 500;
+    assert_fdc_distinct(&candidate, baseline);
+
+    initialize_fdc(&candidate, candidate_fifo, &candidate_timer);
+    candidate.phase = 2;
+    assert_fdc_distinct(&candidate, baseline);
+
+    initialize_fdc(&candidate, candidate_fifo, &candidate_timer);
+    candidate.drives[0].blk = blk_new(qemu_get_aio_context(), 0, BLK_PERM_ALL);
+    candidate.drives[0].drive = FLOPPY_DRIVE_TYPE_288;
+    candidate.drives[0].last_sect = UINT8_MAX;
+    candidate.drives[0].max_track = UINT8_MAX;
+    assert_fdc_distinct(&candidate, baseline);
+    blk_unref(candidate.drives[0].blk);
+}
+
+static void test_fdc_rejects_unrestorable_state(void)
+{
+    uint8_t fifo[512];
+    QEMUTimer timer;
+    FDCtrl fdctrl;
+    BlockDriverState *media;
+
+    initialize_fdc(&fdctrl, fifo, &timer);
+    fdctrl.fifo_size = 511;
+    g_assert_null(project_fdc(&fdctrl, false));
+
+    initialize_fdc(&fdctrl, fifo, &timer);
+    fdctrl.phase = 0;
+    g_assert_null(project_fdc(&fdctrl, false));
+
+    initialize_fdc(&fdctrl, fifo, &timer);
+    fdctrl.drives[0].blk = blk_new(qemu_get_aio_context(), 0, BLK_PERM_ALL);
+    fdctrl.drives[0].drive = FLOPPY_DRIVE_TYPE_288;
+    fdctrl.drives[0].last_sect = UINT8_MAX;
+    fdctrl.drives[0].max_track = UINT8_MAX;
+    fdctrl.drives[1].blk = blk_new(qemu_get_aio_context(), 0, BLK_PERM_ALL);
+    media = bdrv_new_open_driver(&test_media_driver, "fdc-test-media", 0,
+                                 &error_abort);
+    blk_insert_bs(fdctrl.drives[1].blk, media, &error_abort);
+    g_assert_null(project_fdc(&fdctrl, false));
+    blk_remove_bs(fdctrl.drives[1].blk);
+    bdrv_unref(media);
+    blk_unref(fdctrl.drives[0].blk);
+    blk_unref(fdctrl.drives[1].blk);
+
+    initialize_fdc(&fdctrl, fifo, &timer);
+    fdctrl.drives[0].drive = FLOPPY_DRIVE_TYPE_AUTO;
+    g_assert_null(project_fdc(&fdctrl, false));
+
+    initialize_fdc(&fdctrl, fifo, &timer);
+    fdctrl.drives[0].drive = FLOPPY_DRIVE_TYPE__MAX;
+    g_assert_null(project_fdc(&fdctrl, false));
+
+    initialize_fdc(&fdctrl, fifo, &timer);
+    fdctrl.drives[0].last_sect = 1;
+    g_assert_null(project_fdc(&fdctrl, false));
+
+    initialize_fdc(&fdctrl, fifo, &timer);
+    fdctrl.drives[0].media_changed = 0;
+    g_assert_null(project_fdc(&fdctrl, false));
+}
+
+int main(int argc, char **argv)
+{
+    module_call_init(MODULE_INIT_QOM);
+    bdrv_init();
+    qemu_init_main_loop(&error_abort);
+
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/crucible/fdc/mutable-state", test_fdc_mutable_state);
+    g_test_add_func("/crucible/fdc/unrestorable-state",
+                    test_fdc_rejects_unrestorable_state);
+    return g_test_run();
+}
diff --git a/tests/unit/test-crucible-hot-fork-child.c b/tests/unit/test-crucible-hot-fork-child.c
new file mode 100644
index 0000000000000000000000000000000000000000..fc75645df2e1ca7c76d293c845fa61f6d209df49
--- /dev/null
+++ b/tests/unit/test-crucible-hot-fork-child.c
@@ -0,0 +1,3197 @@
+/*
+ * Crucible hot-fork child resource disposition tests
+ *
+ * Copyright (c) Andyl, Inc.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+
+#include <sys/eventfd.h>
+#include <sys/mman.h>
+#include <sys/socket.h>
+
+#include "qemu/crucible-hot-fork-child.h"
+#include "qemu/rcu.h"
+#include "qemu/thread.h"
+#include "system/crucible-hot-fork-plugin-child.h"
+
+typedef struct EndpointVerification {
+    int control_fd;
+    int wake_fd;
+    int expected_control_peer;
+    int result;
+} EndpointVerification;
+
+typedef struct ForkChildVerification {
+    int control_fd;
+    int wake_fd;
+} ForkChildVerification;
+
+typedef struct ClosedDescriptorTableVerification {
+    int control_fd;
+    int wake_fd;
+    int closed_fd;
+    QemuCrucibleHotForkDescriptorTableProof *proof;
+} ClosedDescriptorTableVerification;
+
+typedef struct ChildResourceReinitializer {
+    void *address;
+    uint64_t length;
+    int backing_fd;
+    void *installed_mapping;
+    bool called;
+} ChildResourceReinitializer;
+
+static int reinitialize_child_resources(void *opaque);
+
+typedef struct FakePluginChildRuntime {
+    ChildResourceReinitializer *mapping;
+    struct qemu_plugin_crucible_hot_fork_child_plan plan;
+    uint32_t phase;
+    unsigned int calls;
+    /* Status reports, initialization included, before the workers park. */
+    unsigned int settle_queries;
+    /* Report every released worker idle at its receive safe point. */
+    bool idle_after_release;
+    bool initialized;
+} FakePluginChildRuntime;
+
+static FakePluginChildRuntime fake_plugin_child_runtime;
+
+typedef struct FakeQmpChildRuntime {
+    unsigned int calls;
+    int result;
+    uint32_t flags;
+} FakeQmpChildRuntime;
