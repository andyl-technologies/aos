+int main(void)
+{
+    balanced_cache_membership();
+    mid_update_is_not_certifiable();
+    real_concurrent_cache_memberships();
+    partial_failure_invalidates_an_earlier_observer();
+    counter_failures_are_sticky();
+    original_dma_and_single_counter_paths();
