+    maps_fd = open("/proc/self/maps", O_RDONLY | O_CLOEXEC);
+    if (maps_fd < 0) {
+        return -errno;
+    }
+    for (;;) {
+        ssize_t input_length = read(maps_fd, input, sizeof(input));
+
+        if (input_length < 0) {
+            if (errno == EINTR) {
+                continue;
+            }
+            result = -errno;
+            break;
+        }
+        if (input_length == 0) {
+            if (record_length != 0) {
+                record_count++;
+                if (record_count >
+                    QEMU_CRUCIBLE_HOT_FORK_MAX_MAPPING_RECORDS) {
+                    result = -E2BIG;
+                } else {
+                    result = crucible_hot_fork_match_source_mapping(
+                        record, record_length, &search);
+                }
+            }
+            break;
+        }
+        if ((size_t)input_length >
+            QEMU_CRUCIBLE_HOT_FORK_MAX_MAPPING_BYTES - total_bytes) {
+            result = -E2BIG;
+            break;
+        }
+        total_bytes += input_length;
+
+        for (ssize_t index = 0; index < input_length; index++) {
+            if (input[index] == '\n') {
+                record_count++;
+                if (record_count >
+                    QEMU_CRUCIBLE_HOT_FORK_MAX_MAPPING_RECORDS) {
+                    result = -E2BIG;
+                    break;
+                }
+                result = crucible_hot_fork_match_source_mapping(
+                    record, record_length, &search);
+                record_length = 0;
+                if (result != 0) {
+                    break;
+                }
+            } else {
+                if (record_length == sizeof(record)) {
+                    result = -E2BIG;
+                    break;
+                }
+                record[record_length++] = input[index];
+            }
+        }
+        if (result != 0) {
+            break;
+        }
+    }
+    if (close(maps_fd) < 0 && result == 0) {
+        result = -errno;
+    }
+    if (result == 0 && !search.found) {
+        result = -EPERM;
+    }
+    if (result == 0) {
+        *mapping = search.mapping;
+    }
+    return result;
+}
+
+int qemu_crucible_hot_fork_verify_mapping_table(
+    QemuCrucibleHotForkDescriptorTableTransaction *transaction,
+    const QemuCrucibleHotForkSharedMapping *shared_mappings,
+    size_t shared_mapping_count)
+{
+    int result;
+
+    if (!transaction) {
+        return -EINVAL;
+    }
+    if (transaction->active || !transaction->descriptors_applied ||
+        transaction->mappings_verified || transaction->parent_pid <= 1 ||
+        transaction->child_pid != getpid()) {
+        return -EPERM;
+    }
+    if (!crucible_hot_fork_shared_mapping_table_is_valid(
+            shared_mappings, shared_mapping_count)) {
+        return -EINVAL;
+    }
+
+    transaction->descriptors_applied = false;
+    result = crucible_hot_fork_scan_mapping_table(shared_mappings,
+                                                  shared_mapping_count);
+    if (result == 0) {
+        transaction->descriptors_applied = true;
+        transaction->mappings_verified = true;
+    }
+    return result;
+}
+
+int qemu_crucible_hot_fork_apply_child_resources(
+    QemuCrucibleHotForkDescriptorTableTransaction *transaction,
+    const QemuCrucibleHotForkDescriptorReplacement *replacements,
+    size_t replacement_count,
+    const int *retained_fds,
+    size_t retained_fd_count,
+    QemuCrucibleHotForkDescriptorVerifier verify_descriptors,
+    void *descriptor_opaque,
+    QemuCrucibleHotForkChildReinitializer reinitialize,
+    void *reinitialize_opaque,
+    const QemuCrucibleHotForkSharedMapping *shared_mappings,
+    size_t shared_mapping_count)
+{
+    int result;
+
+    if (!transaction) {
+        return -EINVAL;
+    }
+    if (!transaction->active || transaction->parent_pid <= 1 ||
+        transaction->child_pid != getpid()) {
+        return -EPERM;
+    }
+    if (!verify_descriptors || !reinitialize ||
+        !crucible_hot_fork_retained_table_is_valid(
+            replacements, replacement_count, retained_fds,
+            retained_fd_count) ||
+        !crucible_hot_fork_shared_mapping_table_is_valid(
+            shared_mappings, shared_mapping_count) ||
+        !crucible_hot_fork_mapping_backings_are_retained(
+            shared_mappings, shared_mapping_count,
+            retained_fds, retained_fd_count)) {
+        return -EINVAL;
+    }
+
+    qemu_crucible_hot_fork_note_child_detail(2);
+    result = qemu_crucible_hot_fork_apply_descriptor_table(
+        transaction, replacements, replacement_count,
+        retained_fds, retained_fd_count,
+        verify_descriptors, descriptor_opaque);
+    if (result != 0) {
+        return result;
+    }
+
+    result = reinitialize(reinitialize_opaque);
+    if (result > 0 || result == -EUCLEAN) {
+        result = -EPROTO;
+    }
+    if (result != 0) {
+        transaction->descriptors_applied = false;
+        return result;
+    }
+    transaction->child_reinitialized = true;
+
+    qemu_crucible_hot_fork_note_child_detail(8);
+    return qemu_crucible_hot_fork_verify_mapping_table(
+        transaction, shared_mappings, shared_mapping_count);
+}
