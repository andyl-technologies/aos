+typedef struct UninstallOrdering {
+    bool reset;
+    bool omit_recheck;
+} UninstallOrdering;
+
+static void *foreign_ordered_uninstall(void *opaque)
+{
+    const UninstallOrdering *ordering = opaque;
+
+    if (ordering->omit_recheck) {
+        probe_uninstall_omitted(fixture.ctx.id, ordering->reset, true);
+    } else {
+        probe_uninstall_ordered(fixture.ctx.id, ordering->reset, true);
+    }
+    return NULL;
+}
+
+static void run_uninstall_ordering(bool reset, bool omit_recheck)
+{
+    const UninstallOrdering ordering = { reset, omit_recheck };
+    QemuThread thread;
+    int post_status;
+
+    fixture_prepare(0, false);
+    qemu_sem_init(&uninstall_entry_passed, 0);
+    qemu_sem_init(&uninstall_install_returned, 0);
+    effect_reached = false;
+    qemu_thread_create(&thread, "source-reset-race", foreign_ordered_uninstall,
+                       (void *)&ordering, QEMU_THREAD_JOINABLE);
+
+    /* The actual entry check passed before custody, while installer owns lock. */
+    qemu_sem_wait(&uninstall_entry_passed);
+    g_assert_false(qemu_plugin_crucible_startup_source_retained());
+    g_assert_cmpint(fixture_acquire(), ==, 0);
+    fixture_signal();
+    g_assert_cmpint(qemu_plugin_crucible_startup_source_check_v1(
+                       fixture.ctx.id), ==, -ECANCELED);
+    post_status = qatomic_read(&startup_source.metadata_partition.post_status);
+
+    /* The explicit probe rendezvous holds the worker outside plugin.lock
+     * while the actual Source leave follows the loader's unlocked order. */
+    g_assert_true(fixture.ctx.installing);
+    qemu_rec_mutex_unlock(&plugin.lock);
+    g_assert_cmpint(plugin_startup_source_install_leave(
+        &fixture.ctx, -ECANCELED), ==, -ECANCELED);
+    qemu_rec_mutex_lock(&plugin.lock);
+
+    g_assert_true(startup_source.install_returned);
+    g_assert_false(startup_source.scope_active);
+    g_assert_null(startup_source.current.ctx);
+    g_assert_true(plugin_startup_source_retains_ctx(&fixture.ctx));
+    g_assert_true(plugin_startup_source_retains_id(fixture.ctx.id));
+    g_assert_cmpint(startup_source.first_negative_status, ==, -ECANCELED);
+    g_assert_cmpint(qatomic_read(&startup_source.metadata_partition.post_status),
+                    ==, post_status);
+    fixture.ctx.installing = false;
+
+    qemu_sem_post(&uninstall_install_returned);
+    qemu_rec_mutex_unlock(&plugin.lock);
+    qemu_thread_join(&thread);
+    qemu_sem_destroy(&uninstall_entry_passed);
+    qemu_sem_destroy(&uninstall_install_returned);
+
+    g_assert_cmpint(effect_reached, ==, omit_recheck);
+    g_assert_cmpint(fixture.ctx.resetting, ==, omit_recheck && reset);
+    g_assert_cmpint(fixture.ctx.uninstalling, ==, omit_recheck && !reset);
+    g_assert_cmpint(startup_source.first_negative_status, ==, -ECANCELED);
+    assert_retained();
+}
