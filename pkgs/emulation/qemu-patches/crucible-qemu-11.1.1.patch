+    initialize_clock(true);
+    initialize_hpet(&source);
+    timer_mod_ps_wide(source.timer[0].qemu_timer, 10501);
+    input = save_hpet(&source, &vmstate_hpet);
+    destroy_hpet(&source);
+    section = wide_subsection_start(input);
+    payload = section + 2 + strlen("hpet/clock-wide") + 4;
+
+    switch (mutation) {
+    case 0:
+        input->data[payload] = 0;
+        break;
+    case 1:
+        input->data[payload + 17] = 2;
+        break;
+    case 2:
+        input->data[payload + 17] = 0;
+        break;
+    case 3:
+        stl_be_p(input->data + payload - 4, 1);
+        break;
+    case 4: {
+        size_t section_length = input->usage - section - 1;
+        QIOChannelBuffer *duplicate = qio_channel_buffer_new(
+            input->usage + section_length);
+
+        duplicate->usage = input->usage + section_length;
+        memcpy(duplicate->data, input->data, input->usage - 1);
+        memcpy(duplicate->data + input->usage - 1,
+               input->data + section, section_length);
+        duplicate->data[duplicate->usage - 1] = 0;
+        object_unref(OBJECT(input));
+        input = duplicate;
+        break;
+    }
+    default:
+        input->usage -= 2;
+        break;
+    }
+
+    initialize_hpet(&destination);
+    timer_mod_ps_wide(destination.timer[0].qemu_timer, 77);
+    g_assert_cmpint(load_hpet(&destination, input, &vmstate_hpet), <, 0);
+    g_assert_true(timer_pending(destination.timer[0].qemu_timer));
+    g_assert_true(expiry_ps(destination.timer[0].qemu_timer) == 77);
+    destroy_hpet(&destination);
+}
+
+static void export_crossmode_stream(void)
+{
+    const char *path = g_getenv("HPET_CROSSMODE_STREAM");
+    HPETState source = { 0 };
+    QIOChannelBuffer *input;
+    GError *error = NULL;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+    initialize_clock(true);
+    initialize_hpet(&source);
+    source.hpet_offset_ps = g_getenv("HPET_CROSSMODE_WIDE") ?
+        ((__int128)1 << 120) : -501;
+    timer_mod_ps_wide(source.timer[0].qemu_timer, 10501);
+    input = save_hpet(&source, &vmstate_hpet);
+    g_assert_cmpuint(input->usage, >, 0);
+    if (path) {
+        g_assert_true(g_file_set_contents(path, (const char *)input->data,
+                                          input->usage, &error));
+        g_assert_no_error(error);
+    }
+    object_unref(OBJECT(input));
+    destroy_hpet(&source);
+}
+
+static void test_crossmode_stream(gconstpointer opaque)
+{
+    bool wide = GPOINTER_TO_INT(opaque);
+    HPETState destination = { 0 };
+    QIOChannelBuffer *input;
+    GError *error = NULL;
+    char *path;
+    char *bytes;
+    size_t length;
+    int descriptor;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    descriptor = g_file_open_tmp("hpet-crossmode-XXXXXX", &path, &error);
+    g_assert_no_error(error);
+    g_assert_cmpint(descriptor, >=, 0);
+    close(descriptor);
+    g_setenv("HPET_CROSSMODE_STREAM", path, true);
+    if (wide) {
+        g_setenv("HPET_CROSSMODE_WIDE", "1", true);
+    }
+    g_test_trap_subprocess("/hpet/export-crossmode", 0, 0);
+    g_test_trap_assert_passed();
+    g_unsetenv("HPET_CROSSMODE_STREAM");
+    g_unsetenv("HPET_CROSSMODE_WIDE");
+    g_assert_true(g_file_get_contents(path, &bytes, &length, &error));
+    g_assert_no_error(error);
+    unlink(path);
+    g_free(path);
+    initialize_clock(false);
+    input = qio_channel_buffer_new(length);
+    input->usage = length;
+    memcpy(input->data, bytes, length);
+    g_free(bytes);
+
+    initialize_hpet(&destination);
+    timer_mod_ns(destination.timer[0].qemu_timer, 77);
+    int result = load_hpet(&destination, input, &vmstate_hpet);
+
+    if (wide) {
+        g_assert_cmpint(result, <, 0);
+        g_assert_cmpint(timer_expire_time_ns(destination.timer[0].qemu_timer),
+                        ==, 77);
+    } else {
+        g_assert_cmpint(result, ==, 0);
+        g_assert_cmpint(timer_expire_time_ns(destination.timer[0].qemu_timer),
+                        ==, 11);
+        g_assert_cmpuint(destination.hpet_offset, ==, UINT64_MAX);
+    }
+    destroy_hpet(&destination);
+}
+
+static void test_deadline_overflow(void)
+{
+    HPETState state = { 0 };
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_failed();
+        g_test_trap_assert_stderr("*HPET comparator deadline exceeds*");
+        return;
+    }
+
+    initialize_clock(true);
+    initialize_hpet(&state);
+    observed_ps = (((__int128)1 << 126) - 1) * 2 + 1;
+    state.timer[0].cmp = hpet_get_ticks_raw(&state) + 1;
+    hpet_set_timer(&state.timer[0]);
+    g_assert_not_reached();
+}
+
+static void test_counter_limit_and_32bit_edge(void)
+{
+    HPETState state = { 0 };
+    __int128 epoch = ((__int128)1 << 64) * 10000;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    observed_ps = 357;
+    initialize_clock(true);
+    initialize_hpet(&state);
+    hpet_ram_write(&state, HPET_COUNTER, UINT64_MAX, 8);
+    state.timer[0].cmp = 1;
+    hpet_ram_write(&state, HPET_CFG, HPET_CFG_ENABLE, 8);
+    g_assert_cmpuint(hpet_get_ticks_raw(&state), ==, UINT64_MAX);
+    g_assert_true(expiry_ps(state.timer[0].qemu_timer) == 20357);
+
+    state.hpet_offset_ps = 0;
+    observed_ps = epoch + ((__int128)UINT32_MAX * 10000) + 357;
+    state.timer[0].config |= HPET_TN_32BIT;
+    state.timer[0].cmp = 1;
+    hpet_set_timer(&state.timer[0]);
+    /* One-shot 32-bit mode signals the counter wrap before the match. */
+    g_assert_cmpuint(state.timer[0].wrap_flag, ==, 1);
+    g_assert_true(expiry_ps(state.timer[0].qemu_timer) ==
+                  epoch + ((__int128)UINT32_MAX + 1) * 10000);
+    observed_ps = epoch + ((__int128)UINT32_MAX + 1) * 10000;
+    g_assert_true(qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL));
+    g_assert_cmpuint(irq_count, ==, 1);
+    g_assert_true(expiry_ps(state.timer[0].qemu_timer) ==
+                  epoch + ((__int128)UINT32_MAX + 2) * 10000);
+    observed_ps += 10000;
+    g_assert_true(qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL));
+    g_assert_cmpuint(irq_count, ==, 2);
+    destroy_hpet(&state);
+}
+
+static void test_non_tcg_periodic_floor(void)
+{
+    HPETState state = { 0 };
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    initialize_clock(false);
+    initialize_hpet(&state);
+    state.timer[0].config |= HPET_TN_PERIODIC;
+    state.timer[0].period = 1;
+    hpet_arm(&state.timer[0], 1);
+    g_assert_cmpint(timer_expire_time_ns(state.timer[0].qemu_timer), ==, 1000);
+    destroy_hpet(&state);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/hpet/counter-limit-32bit-edge",
+                    test_counter_limit_and_32bit_edge);
+    g_test_add_func("/hpet/non-tcg-periodic-floor",
+                    test_non_tcg_periodic_floor);
+    g_test_add_func("/hpet/export-crossmode", export_crossmode_stream);
+    g_test_add_data_func("/hpet/crossmode-representable",
+                         GINT_TO_POINTER(false),
+                         test_crossmode_stream);
+    g_test_add_data_func("/hpet/crossmode-out-of-range", GINT_TO_POINTER(true),
+                         test_crossmode_stream);
+    g_test_add_func("/hpet/deadline-overflow", test_deadline_overflow);
+    g_test_add_func("/hpet/fullword-counter-epoch",
+                    test_fullword_counter_and_epoch);
+    g_test_add_data_func("/hpet/fullword-migration", GINT_TO_POINTER(false),
+                         test_fullword_migration);
+    g_test_add_data_func("/hpet/negative-expiry-migration",
+                         GINT_TO_POINTER(true),
+                         test_fullword_migration);
+    for (unsigned i = 0; i < 6; i++) {
+        char *name = g_strdup_printf("/hpet/malformed-wide/%u", i);
+
+        g_test_add_data_func(name, GUINT_TO_POINTER(i),
+                             test_malformed_wide_stream);
+        g_free(name);
+    }
+    g_test_add_func("/hpet/periodic-hardware-tick",
+                    test_periodic_hardware_tick);
+    g_test_add_func("/hpet/wide-hardware-origin", test_wide_hardware_origin);
+    g_test_add_data_func("/hpet/fractional-irq", GINT_TO_POINTER(true),
+                         test_irq_boundary);
+    g_test_add_data_func("/hpet/non-tcg-irq", GINT_TO_POINTER(false),
+                         test_irq_boundary);
+    g_test_add_data_func("/hpet/aligned-periodic-migration", GINT_TO_POINTER(0),
+                         test_periodic_migration);
+    g_test_add_data_func("/hpet/fractional-periodic-migration",
+                         GINT_TO_POINTER(501), test_periodic_migration);
+    g_test_add_func("/hpet/wide-counter-migration",
+                    test_wide_counter_and_migration);
+    g_test_add_data_func("/hpet/missing-tcg-exact", GINT_TO_POINTER(true),
+                         test_missing_exact_state);
+    g_test_add_data_func("/hpet/non-tcg-legacy", GINT_TO_POINTER(false),
+                         test_missing_exact_state);
+    g_test_add_func("/hpet/malformed-phase", test_malformed_phase);
+    return g_test_run();
+}
