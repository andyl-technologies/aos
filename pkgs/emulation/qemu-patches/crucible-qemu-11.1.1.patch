+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Exercise actual monitor preparation and QMP refusal with modeled native plans.
+
+The plan, graph receipt, monitor basis, and coordinator are lower-layer fixtures.
+This diagnostic regression does not prove a complete live fork. Error allocation,
+formatting, and release use QEMU's real util/error.c implementation.
+"""
+
+import argparse
+import json
