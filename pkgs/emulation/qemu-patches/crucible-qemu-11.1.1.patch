+int qemu_plugin_crucible_ram_restore_prepare_v1(
+    const uint8_t *root_record, size_t root_length,
+    const uint8_t root_digest[32], const uint8_t topology_digest[32],
+    const uint8_t session[16], const uint8_t owner[16], uint64_t generation,
+    int source_fd, int cancellation_fd)
+{
+    int status;
+    bool research_selected = qatomic_read(&research_resident.state) !=
+        RESEARCH_RESIDENT_ABSENT;
+
+    /* Preserve original validation/first-error priority while closing this
+     * unsupported class before any transition callback or authority effect. */
+    if (research_selected) {
+        qemu_plugin_crucible_ram_research_resident_refuse_transition_v1();
+    }
+
+    if (!bql_locked() || !runstate_check(RUN_STATE_PAUSED) ||
+        !qemu_plugin_crucible_vmstop_quiesced() || restore_staged ||
+        restore_destructive || capture_active || !root_record ||
+        !root_length || root_length > 3 * 1024 * 1024 || !root_digest ||
+        !topology_digest || !session || !owner || !generation ||
+        source_fd < 0 || cancellation_fd < 0) {
+        return -EINVAL;
+    }
+    if (!restore_prepare) {
+        return -ENOSYS;
+    }
+    status = qemu_crucible_ram_diagnostic_failure();
+    if (status) {
+        return status;
+    }
+    if (research_selected) {
+        return -ENOTSUP;
+    }
+    status = qemu_crucible_selectable_restore_begin();
+    if (status) {
+        return status;
+    }
+    restore_operation_claimed = true;
+    status = restore_prepare(root_record, root_length, root_digest,
+                             topology_digest, session, owner, generation,
+                             source_fd, cancellation_fd);
+    if (!status) {
+        restore_staged = true;
+    } else {
+        restore_operation_claimed = false;
+        qemu_crucible_selectable_restore_end();
+    }
+    return status;
+}
+
+int qemu_plugin_crucible_ram_restore_commit_v1(void)
+{
+    int failure;
+    bool research_selected = qatomic_read(&research_resident.state) !=
+        RESEARCH_RESIDENT_ABSENT;
+
+    /* Preserve original validation/first-error priority while closing this
+     * unsupported class before any transition callback or authority effect. */
+    if (research_selected) {
+        qemu_plugin_crucible_ram_research_resident_refuse_transition_v1();
+    }
+
+    if (!bql_locked() || !runstate_check(RUN_STATE_PAUSED) ||
+        !restore_staged || restore_destructive || !restore_commit) {
+        return -EINVAL;
+    }
+    failure = qemu_crucible_ram_diagnostic_failure();
+    if (failure) {
+        return failure;
+    }
+    if (research_selected) {
+        return -ENOTSUP;
+    }
+    /* A failed destructive transition retains service/registration ownership;
+     * neither retry nor abort may turn missing guest bytes into anonymous zeros.
+     */
+    restore_destructive = true;
+    restore_staged = false;
+    failure = restore_commit();
+    if (!failure && restore_operation_claimed) {
+        restore_operation_claimed = false;
+        qemu_crucible_selectable_restore_end();
+    }
+    return failure;
+}
