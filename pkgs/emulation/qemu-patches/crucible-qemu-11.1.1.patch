+/* These controls bind real admitted allocations to explicitly modeled retained
+ * Native rows. They exercise the actual canonical-owner, cursor, free and QOM
+ * bodies; they do not activate Source, complete RCU grace, manufacture an end
+ * loan or qualify a launched VM/destructor schedule. */
+static CrucibleRamInventory *fixture_metadata_container(unsigned capacity)
+{
+    QemuCrucibleMetadataBirthLoan birth = { 0 };
+    CrucibleRamInventoryOwner *row = &inventory_owners[0];
+    CrucibleRamInventory *array;
+    uint64_t bytes = qemu_crucible_ram_inventory_body_bytes(capacity);
+
+    g_assert_cmpuint(row->state, ==, RAM_INVENTORY_FREE);
+    g_assert_cmpuint(bytes, >, 0);
+    g_assert_cmpint(qemu_crucible_startup_source_ram_inventory_birth_begin(
+                       0, capacity, &birth), ==, 0);
+    array = g_malloc0(bytes);
+    array->capacity = capacity;
+    array->references = 1;
+    array->topology = topology_generation;
+    array->owner = row;
+    row->array = array;
+    row->references = 1;
+    row->incarnation = birth.serial;
+    row->state = RAM_INVENTORY_LIVE;
+    crucible_ram_metadata_birth_transfer(&birth, &row->container_owner,
+                                         array, bytes);
+    g_assert_cmpint(qemu_crucible_startup_source_ram_metadata_birth_finish(
+                       &birth), ==, 0);
+    return array;
+}
