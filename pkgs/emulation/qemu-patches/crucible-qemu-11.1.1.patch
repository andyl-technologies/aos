+static void scenario_registration_cleanup_concurrent(void)
+{
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    QemuThread thread;
+    bool closing;
+
+    fixture_cleanup_prepare(true);
+    qemu_sem_init(&cleanup_return_started, 0);
+    qemu_mutex_lock(&startup_source.callbacks.native.mutex);
+    qemu_thread_create(&thread, "cleanup-return", fixture_cleanup_return_thread,
+                      NULL, QEMU_THREAD_JOINABLE);
+    qemu_sem_wait(&cleanup_return_started);
+    do {
+        /* Holding Native while taking Source here is intentional adversarial
+         * scheduling: the returning thread must have dropped Source first. */
+        qemu_mutex_lock(&commands->mutex);
+        closing = commands->child.closing;
+        qemu_mutex_unlock(&commands->mutex);
+        if (!closing) {
+            g_usleep(1000);
+        }
+    } while (!closing);
+    g_assert_cmpint(fixture_cleanup_owner_return(), ==, -EBUSY);
+    assert_cleanup_owner_retained(1);
+    qemu_mutex_unlock(&startup_source.callbacks.native.mutex);
+    qemu_thread_join(&thread);
+    qemu_sem_destroy(&cleanup_return_started);
+    g_assert_cmpint(cleanup_return_status, ==, 0);
+    g_assert_null(cleanup_runtime.owner);
+}
