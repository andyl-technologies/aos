+"""Compile literal clock registry bodies; no selected provider or callback loan.
+
+SPDX-License-Identifier: GPL-2.0-or-later
+"""
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import shlex
+import subprocess
+
+
+def function(source, signature):
+    start = source.index(signature)
+    opening = source.index("{", start)
+    depth = 1
+    end = opening + 1
+    while depth:
+        depth += (source[end] == "{") - (source[end] == "}")
+        end += 1
+    return source[start:end] + "\n"
+
+
+CHECKS = r"""
+static bool enabled = true;
+
+static bool fixture_mode(void)
+{
+    return enabled;
+}
+
+static QemuCrucibleClockSourceDescriptor descriptor(uint32_t instance,
+                                                   const char *name)
+{
+    return (QemuCrucibleClockSourceDescriptor) {
+        .source_kind = QEMU_CRUCIBLE_CLOCK_X86_TSC,
+        .instance = instance,
+        .architecture = QEMU_PLUGIN_CRUCIBLE_FAULT_SCOPE_X86_64,
+        .base_domain = 1, .timer_relationship = 0,
+        .monotonicity = QEMU_CRUCIBLE_CLOCK_ALLOW_BACKWARD,
+        .width_bits = 64, .flags = QEMU_CRUCIBLE_CLOCK_SOURCE_WRAPS,
+        .frequency_numerator = 1000000000,
+        .frequency_denominator = 3,
+        .model_phase_mask = UINT64_C(1) <<
+            (QEMU_CRUCIBLE_MODEL_PHASE_CLOCK_READ - 1),
+        .id = name, .implementation = "canonical-clock-component",
+    };
+}
+
+static void clear_fixture(void)
+{
+    CrucibleClockSource *source = crucible_clock_registry.first;
+
+    /* Component teardown only: no callback, QOM or Source owner was issued. */
+    while (source) {
+        CrucibleClockSource *next = source->next;
+
+        assert(!source->wander_timer && !source->source_rule);
+        g_array_unref(source->rules);
+        g_free((void *)source->capability.id);
+        g_free((void *)source->capability.implementation);
+        g_free(source);
+        source = next;
+    }
+    g_mutex_clear(&crucible_clock_registry.lookup_lock);
+    memset(&crucible_clock_registry, 0, sizeof(crucible_clock_registry));
+    crucible_clock_sources = NULL;
+    crucible_clock_manifest_finalized = false;
+    crucible_clock_bindings_sealed = false;
+}
+
+static void check_refusals(void)
+{
+    char name[98];
+    QemuCrucibleClockSourceDescriptor input = descriptor(0, "a");
+
+    enabled = false;
+    assert(!crucible_clock_lookup_step_bounded(0, 0));
+    assert(crucible_clock_lookup_step_bounded(4095, 4096));
+    assert(!crucible_clock_lookup_step_bounded(4096, 4096));
+    assert(!crucible_clock_lookup_step_bounded(0, 4097));
+    assert(qemu_crucible_fault_clock_source_register(NULL) == 0);
+    assert(!crucible_clock_sources);
+    enabled = true;
+    assert(qemu_crucible_fault_clock_source_register(NULL) == -EINVAL);
+    input.id = "";
+    assert(qemu_crucible_fault_clock_source_register(&input) == -EINVAL);
+    memset(name, 'a', 97);
+    name[97] = 0;
+    input.id = name;
+    assert(qemu_crucible_fault_clock_source_register(&input) == -EINVAL);
+    name[96] = 0;
+    assert(qemu_crucible_fault_clock_source_register(&input) == 0);
+    assert(strlen(crucible_clock_registry.first->capability.id) == 96);
+    assert(qemu_crucible_fault_clock_source_register(&input) == -EEXIST);
+    clear_fixture();
+
+    crucible_clock_registry.last_serial = UINT64_MAX;
+    input = descriptor(0, "overflow");
+    assert(qemu_crucible_fault_clock_source_register(&input) == -EOVERFLOW);
+    assert(!crucible_clock_registry.first && !crucible_clock_registry.len);
+    assert(crucible_clock_registry.last_serial == UINT64_MAX);
+    clear_fixture();
+}
+
+static void check_order_and_identity(void)
+{
+    QemuCrucibleClockSourceDescriptor a = descriptor(0, "z"),
+        b = descriptor(1, "a"), c = descriptor(2, "m");
+    CrucibleClockSource *retained;
+    struct qemu_plugin_crucible_fault_clock_capability rows[3];
+    uint16_t scope = 0;
+    uint8_t id[32] = { 1 };
+
+    assert(qemu_crucible_fault_clock_source_register(&a) == 0);
+    retained = crucible_clock_source_by_kind(a.source_kind, a.instance);
+    assert(retained && retained->registration_serial == 1);
+    assert(crucible_clock_registry.lookup[crucible_clock_lookup_bucket(
+        a.source_kind, a.instance)].tsc_hint == retained);
+    assert(qemu_crucible_fault_clock_source_register(&b) == 0);
+    for (unsigned index = 0; index < CRUCIBLE_CLOCK_LOOKUP_BUCKETS; index++) {
+        assert(!crucible_clock_registry.lookup[index].tsc_hint);
+    }
+    assert(crucible_clock_registry.first->next == retained);
+    assert(retained->previous == crucible_clock_registry.first);
+    assert(qemu_crucible_fault_clock_source_register(&c) == 0);
+    assert(crucible_clock_source_by_kind(a.source_kind, a.instance) == retained);
+    assert(crucible_clock_source_by_kind(b.source_kind, b.instance) != retained);
+    assert(crucible_clock_source_by_kind(b.source_kind, b.instance)->instance == 1);
+    assert(!crucible_clock_source_by_kind(a.source_kind, UINT32_MAX));
+    assert(crucible_clock_source_at(1)->next == retained);
+    assert(crucible_clock_source_at(3) == NULL);
+    assert(crucible_fault_clock_manifest_body(rows, 3, &scope) == 3);
+    assert(scope == QEMU_PLUGIN_CRUCIBLE_FAULT_SCOPE_X86_64);
+    assert(!strcmp(rows[0].id, "a") && !strcmp(rows[1].id, "m") &&
+           !strcmp(rows[2].id, "z"));
+    assert(crucible_fault_clock_bind_body(2, id) == 0);
+    assert(retained->binding.bound && !memcmp(retained->binding.id, id, 32));
+    assert(crucible_fault_clock_bind_body(0, id) == -EEXIST);
+    assert(qemu_crucible_fault_clock_source_register(&c) == -EINVAL);
+    clear_fixture();
+
+    a = descriptor(0, "same");
+    b = descriptor(1, "same");
+    assert(qemu_crucible_fault_clock_source_register(&a) == 0);
+    assert(qemu_crucible_fault_clock_source_register(&b) == 0);
+    assert(!crucible_clock_manifest_finalize());
+    clear_fixture();
+
+    a = descriptor(0, "a");
+    b = descriptor(1, "b");
+    b.architecture = QEMU_PLUGIN_CRUCIBLE_FAULT_SCOPE_AARCH64;
+    b.source_kind = QEMU_CRUCIBLE_CLOCK_ARM_COUNTER;
+    assert(qemu_crucible_fault_clock_source_register(&a) == 0);
+    assert(qemu_crucible_fault_clock_source_register(&b) == 0);
+    assert(!crucible_clock_manifest_finalize());
+    clear_fixture();
+}
+
+static void check_complete_limit(void)
+{
+    struct qemu_plugin_crucible_fault_clock_capability *rows =
+        g_new0(struct qemu_plugin_crucible_fault_clock_capability,
+               CRUCIBLE_CLOCK_MAX_SOURCES);
+    uint16_t scope = 0;
+
+    for (uint32_t index = 0; index < CRUCIBLE_CLOCK_MAX_SOURCES; index++) {
+        char name[97];
+        uint32_t instance = CRUCIBLE_CLOCK_MAX_SOURCES - index - 1;
+        QemuCrucibleClockSourceDescriptor input;
+
+        snprintf(name, sizeof(name), "clock-%08u", instance);
+        input = descriptor(instance, name);
+        assert(qemu_crucible_fault_clock_source_register(&input) == 0);
+    }
+    QemuCrucibleClockSourceDescriptor extra = descriptor(UINT32_MAX, "extra");
+    assert(qemu_crucible_fault_clock_source_register(&extra) == -EEXIST);
+    assert(crucible_fault_clock_manifest_body(
+        rows, CRUCIBLE_CLOCK_MAX_SOURCES, &scope) == CRUCIBLE_CLOCK_MAX_SOURCES);
+    for (uint32_t index = 0; index < CRUCIBLE_CLOCK_MAX_SOURCES; index++) {
+        char name[97];
+        CrucibleClockSource *source = crucible_clock_source_at(index);
+        QemuCrucibleClockSourceDescriptor expected;
+
+        snprintf(name, sizeof(name), "clock-%08u", index);
+        expected = descriptor(index, name);
+        assert(source && source->instance == index);
+        assert(!strcmp(rows[index].id, name));
+        assert(rows[index].source_kind == expected.source_kind);
+        assert(rows[index].architecture == expected.architecture);
+        assert(rows[index].base_domain == expected.base_domain);
+        assert(rows[index].timer_relationship == expected.timer_relationship);
+        assert(rows[index].width_bits == expected.width_bits);
+        assert(rows[index].flags == expected.flags);
+        assert(rows[index].frequency_numerator == expected.frequency_numerator);
+        assert(rows[index].frequency_denominator == expected.frequency_denominator);
+        assert(rows[index].model_phase_mask == expected.model_phase_mask);
+        assert(rows[index].epoch_ns == expected.epoch_ns);
+        assert(rows[index].monotonicity == expected.monotonicity);
+        assert(rows[index].vmstate == 1);
+        assert(!strcmp(rows[index].implementation, expected.implementation));
+        assert(source->registration_serial == CRUCIBLE_CLOCK_MAX_SOURCES - index);
+    }
+    g_free(rows);
+    clear_fixture();
+}
+
+static void check_collisions(void)
+{
+    uint32_t instances[CRUCIBLE_CLOCK_MAX_SOURCES];
+    size_t count = 0;
+
+    for (uint32_t instance = 0; count < G_N_ELEMENTS(instances); instance++) {
+        uint32_t hash = instance * UINT32_C(0x9e3779b1) ^
+            QEMU_CRUCIBLE_CLOCK_X86_TSC;
+
+        if (((hash ^ (hash >> 16)) & 255) == 0) {
+            instances[count++] = instance;
+        }
+    }
+    for (size_t index = 0; index < count; index++) {
+        char name[97];
+        QemuCrucibleClockSourceDescriptor input;
+
+        snprintf(name, sizeof(name), "collision-%08u", instances[index]);
+        input = descriptor(instances[index], name);
+        assert(qemu_crucible_fault_clock_source_register(&input) == 0);
+    }
+    assert(crucible_clock_registry.len == CRUCIBLE_CLOCK_MAX_SOURCES);
+    for (size_t index = 0; index < count; index++) {
+        CrucibleClockSource *actual = crucible_clock_source_by_kind(
+            QEMU_CRUCIBLE_CLOCK_X86_TSC, instances[index]);
+
+        assert(actual && actual->instance == instances[index]);
+    }
+    /* A miss traverses the complete deliberately colliding chain. */
+    uint32_t missing = instances[count - 1];
+    uint32_t hash;
+
+    do {
+        missing++;
+        hash = missing * UINT32_C(0x9e3779b1) ^ QEMU_CRUCIBLE_CLOCK_X86_TSC;
+    } while (((hash ^ (hash >> 16)) & 255) != 0);
+    assert(!crucible_clock_source_by_kind(QEMU_CRUCIBLE_CLOCK_X86_TSC, missing));
+    clear_fixture();
+}
+
+typedef struct ClockMutationFixture {
+    pthread_barrier_t start;
+    uint32_t target;
+    uint32_t collisions[7];
+} ClockMutationFixture;
+
+static void *cold_lookup_thread(void *opaque)
+{
+    ClockMutationFixture *fixture = opaque;
+    unsigned bucket = crucible_clock_lookup_bucket(QEMU_CRUCIBLE_CLOCK_X86_TSC,
+                                                   fixture->target);
+
+    pthread_barrier_wait(&fixture->start);
+    for (unsigned iteration = 0; iteration < 20000; iteration++) {
+        qatomic_set(&crucible_clock_registry.lookup[bucket].tsc_hint, NULL);
+        CrucibleClockSource *row = crucible_clock_source_by_kind(
+            QEMU_CRUCIBLE_CLOCK_X86_TSC, fixture->target);
+
+        assert(row && row->instance == fixture->target && !row->custody_owner);
+    }
+    return NULL;
+}
+
+static void check_concurrent_mutation(void)
+{
+    ClockMutationFixture fixture = { .target = 4095 };
+    QemuCrucibleClockSourceDescriptor stable = descriptor(fixture.target, "stable");
+    QemuCrucibleClockStorage storage[7] = { 0 };
+    pthread_t reader;
+    unsigned bucket = crucible_clock_lookup_bucket(stable.source_kind, fixture.target);
+    unsigned found = 0;
+
+    assert(!qemu_crucible_fault_clock_source_register(&stable));
+    for (uint32_t instance = 0; found < G_N_ELEMENTS(storage); instance++) {
+        if (crucible_clock_lookup_bucket(QEMU_CRUCIBLE_CLOCK_X86_APIC_TIMER,
+                                         instance) == bucket) {
+            fixture.collisions[found++] = instance;
+        }
+    }
+    assert(!pthread_barrier_init(&fixture.start, NULL, 2));
+    assert(!pthread_create(&reader, NULL, cold_lookup_thread, &fixture));
+    pthread_barrier_wait(&fixture.start);
+    for (unsigned iteration = 0; iteration < 2000; iteration++) {
+        for (unsigned index = 0; index < G_N_ELEMENTS(storage); index++) {
+            char name[32];
+            QemuCrucibleClockSourceDescriptor input;
+
+            snprintf(name, sizeof(name), "inline-%u", index);
+            input = descriptor(fixture.collisions[index], name);
+            input.source_kind = QEMU_CRUCIBLE_CLOCK_X86_APIC_TIMER;
+            assert(!crucible_clock_source_register_into(&input, &storage[index]));
+        }
+        for (unsigned index = 0; index < G_N_ELEMENTS(storage); index++) {
+            assert(!crucible_clock_storage_unlink(&storage[index]));
+        }
+    }
+    assert(!pthread_join(reader, NULL));
+    assert(!pthread_barrier_destroy(&fixture.start));
+    clear_fixture();
+}
+
+/* Factual inline-storage mutation only: this bypasses no Source admission;
+ * the private helper itself issues no receipt, holder or callback permission. */
+static void check_in_place_rows(void)
+{
+    QemuCrucibleClockStorage storage[3] = { 0 };
+    static const char *names[] = { "z", "a", "m" };
+
+    for (unsigned index = 0; index < 3; index++) {
+        QemuCrucibleClockSourceDescriptor input = descriptor(index, names[index]);
+
+        assert(!crucible_clock_source_register_into(&input, &storage[index]));
+        CrucibleClockSource *row = (void *)storage[index].row;
+
+        assert(row->capability.id == storage[index].id);
+        assert(row->capability.implementation == storage[index].implementation);
+        assert(!strcmp(row->capability.id, names[index]));
+        assert(!strcmp(row->capability.implementation, input.implementation));
+        assert(!row->rules && !row->custody_owner);
+        assert(crucible_clock_source_by_kind(input.source_kind, index) == row);
+    }
+    assert(crucible_clock_registry.len == 3);
+    assert(crucible_clock_source_at(0) == (void *)storage[1].row);
+    assert(crucible_clock_source_at(1) == (void *)storage[2].row);
+    assert(!crucible_clock_storage_unlink(&storage[2]));
+    assert(crucible_clock_registry.len == 2);
+    assert(!crucible_clock_source_by_kind(QEMU_CRUCIBLE_CLOCK_X86_TSC, 2));
+    assert(crucible_clock_source_at(0)->next == (void *)storage[0].row);
+    assert(crucible_clock_source_at(1)->previous == (void *)storage[1].row);
+    for (unsigned index = 0; index < CRUCIBLE_CLOCK_LOOKUP_BUCKETS; index++) {
+        assert(!crucible_clock_registry.lookup[index].tsc_hint);
+    }
+    assert(!crucible_clock_storage_unlink(&storage[1]));
+    assert(crucible_clock_registry.first == (void *)storage[0].row);
+    assert(!crucible_clock_registry.first->previous);
+    assert(!crucible_clock_storage_unlink(&storage[0]));
+    assert(!crucible_clock_registry.first && !crucible_clock_registry.last);
+    assert(!crucible_clock_registry.len);
+    for (unsigned index = 0; index < 3; index++) {
+        CrucibleClockSource *row = (void *)storage[index].row;
+
+        assert(!row->next && !row->previous && !row->lookup_next);
+    }
+    g_mutex_clear(&crucible_clock_registry.lookup_lock);
+    memset(&crucible_clock_registry, 0, sizeof(crucible_clock_registry));
+    crucible_clock_sources = NULL;
+}
+
+int main(void)
+{
+    assert(qemu_crucible_startup_source_fixed_control_extent() ==
+           sizeof(startup_source) + OTHER_FIXED_COUNT +
+               sizeof(crucible_clock_registry) +
+               sizeof(crucible_timer_callback_dispatch));
+    check_refusals();
+    check_order_and_identity();
+    check_complete_limit();
+    check_collisions();
+    check_in_place_rows();
+    check_concurrent_mutation();
+    printf("PASS canonical registry facts; row=%zu fixed=%" PRIu64
+           "; factual unlink only; no Source issuer or callback loan\n",
+           sizeof(CrucibleClockSource),
+           qemu_crucible_fault_clock_registry_fixed_storage_bytes_v1());
+    return 0;
+}
