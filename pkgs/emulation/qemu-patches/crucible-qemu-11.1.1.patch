+int qemu_crucible_fingerprint_material_capture_begin_v2(
+    QemuCrucibleFingerprintMaterialRef *out)
+{
+    QemuCrucibleFingerprintMaterial *material = NULL;
+    QemuCrucibleFingerprintWorker *worker = &startup_source.fingerprint_worker;
+    QemuCrucibleActionOriginal *action = startup_source.command_member.action_enter ?
