+int qemu_plugin_crucible_ram_root_record_v1(
+    uint32_t scope, uint8_t *buffer, size_t capacity, size_t *written,
+    uint8_t root[32])
+{
+    qemu_plugin_crucible_ram_root_record_observer_v1 observer =
+        qatomic_load_acquire(&root_record_observer);
+    uint64_t logical_bytes = 0;
+    int status;
