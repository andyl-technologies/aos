+    root_reader_registration.reader = root_scratch;
+    qatomic_store_release(&operational_reader, ordinary);
+    /* Root readers acquire Ready before borrowing the immutable callback. */
+    qatomic_store_release(&root_reader_registration.state, ROOT_READERS_READY);
+    return 0;
+}
