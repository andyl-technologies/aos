+    };
+    const char payload[] = "sync-output";
+    QDict *response;
+    uint64_t control_addr;
+    uint64_t output_addr;
+    uint64_t features;
+    uint32_t free_head;
+
+    features = qvirtio_get_features(dev);
+    features &= ~(QVIRTIO_F_BAD_FEATURE |
+                  (1ULL << VIRTIO_RING_F_INDIRECT_DESC) |
+                  (1ULL << VIRTIO_RING_F_EVENT_IDX));
