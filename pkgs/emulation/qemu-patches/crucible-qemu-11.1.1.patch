+    return true;
+}
+
+int main(void)
+{
+    g_assert_true(run_case(O_NONBLOCK | O_DSYNC, false, true));
+    g_assert_true(run_case(O_NONBLOCK | O_DSYNC, false, false));
+    g_assert_true(run_case(O_NONBLOCK | O_DSYNC, true, false));
+    if (run_case(O_DIRECT | O_NONBLOCK, true, false)) {
+        puts("PROCFD_DIRECT_PASS: retained O_DIRECT; real copy/adoption, aligned read");
+    }
+    puts("PROCFD_FLAGS_PASS: retained O_NOFOLLOW via real duplication; "
+         "native prepare/adoption, flags, identity, custody, generic symlink refusal");
+    return 0;
+}
+"""
+
+
+SUPERVISOR_CONTROLS = r"""
+/* Only the fixture supervisor uses this signal/refusal path. */
+static pid_t fixture_waitpid(pid_t pid, int *status, int options)
+{
+    pid_t result;
+
+    do {
+        result = waitpid(pid, status, options);
+    } while (result < 0 && errno == EINTR);
+    return result;
+}
+
+#define waitpid fixture_waitpid
+
+static int supervisor_control(const char *control)
+{
+    pid_t child;
+    int status;
+
+    g_assert_true(strcmp(control, "stopped-child") == 0 ||
+                  strcmp(control, "parent-refusal") == 0);
+    child = fork();
+    g_assert_cmpint(child, >=, 0);
+    if (child == 0) {
+        g_assert_cmpint(raise(SIGSTOP), ==, 0);
+        _exit(99);
+    }
+    g_assert_cmpint(waitpid(child, &status, WUNTRACED), ==, child);
+    g_assert_true(WIFSTOPPED(status));
+    g_assert_cmpint(WSTOPSIG(status), ==, SIGSTOP);
+    printf("SUPERVISOR_STOPPED_CHILD pid=%ld status=%d\n", (long)child, status);
+    g_assert_cmpint(fflush(stdout), ==, 0);
+
+    if (strcmp(control, "parent-refusal") == 0) {
+        /* A real assertion refusal must not abandon the stopped child. */
+        g_assert_not_reached();
+    }
+    g_assert_cmpint(waitpid(child, &status, 0), ==, child);
+    g_assert_not_reached();
+}
+"""
+
+
+def prctl_child_subreaper(value=None):
+    """Observe or set only this Linux process's subreaper state."""
+    libc = ctypes.CDLL(None, use_errno=True)
+    prctl = libc.prctl
+    prctl.argtypes = [ctypes.c_int, ctypes.c_ulong, ctypes.c_ulong,
+                     ctypes.c_ulong, ctypes.c_ulong]
+    prctl.restype = ctypes.c_int
+    previous = ctypes.c_int()
+    result = prctl(PR_GET_CHILD_SUBREAPER, ctypes.addressof(previous), 0, 0, 0)
+    if result != 0:
+        code = ctypes.get_errno()
+        raise OSError(code, os.strerror(code))
+    if value is not None:
+        result = prctl(PR_SET_CHILD_SUBREAPER, value, 0, 0, 0)
+        if result != 0:
+            code = ctypes.get_errno()
+            raise OSError(code, os.strerror(code))
+    return previous.value
+
+
+def require_exclusive_supervisor():
+    """Refuse other child custody or a preexisting supervisor disposition."""
+    if signal.getsignal(signal.SIGCHLD) != signal.SIG_DFL:
+        raise RuntimeError("procfd supervisor requires default SIGCHLD disposition")
+    try:
+        os.waitid(os.P_ALL, 0, os.WEXITED | os.WNOHANG | os.WNOWAIT)
+    except ChildProcessError:
+        pass
+    else:
+        raise RuntimeError("procfd supervisor already owns unrelated children")
+    if prctl_child_subreaper() != 0:
+        raise RuntimeError("procfd supervisor requires its own subreaper transition")
+
+
+def wait_status(pid, status):
+    """Retain the actual identity, raw status and terminal classification."""
+    return {"pid": pid, "raw_status": status,
+            "exited": os.WIFEXITED(status),
+            "exit_status": os.WEXITSTATUS(status) if os.WIFEXITED(status) else None,
+            "signaled": os.WIFSIGNALED(status),
+            "signal": os.WTERMSIG(status) if os.WIFSIGNALED(status) else None}
+
+
+def retire_owned_group(process, group_verified):
+    """Signal the retained group, then prove actual direct/descendant reaps."""
+    result = {"leader": process.pid, "group": process.pid, "signal": None,
+              "signal_error": None, "reaps": [], "retired": False,
+              "cleanup_error": None, "cleanup_budget_seconds": CLEANUP_SECONDS}
+    cleanup_end = time.monotonic() + CLEANUP_SECONDS
+
+    # The unreaped direct child pins its PID through this only group signal.
+    # WNOWAIT observation above must never become a pre-signal reap.
+    try:
+        if group_verified:
+            os.killpg(process.pid, signal.SIGKILL)
+        else:
+            # Only the still-unreaped direct PID is known owned on this refusal.
+            os.kill(process.pid, signal.SIGKILL)
+        result["signal"] = signal.SIGKILL
+    except ProcessLookupError:
+        result["signal_error"] = errno.ESRCH
+    except OSError as error:
+        result["signal_error"] = error.errno
+        return result
+
+    while time.monotonic() < cleanup_end:
+        try:
+            target = -process.pid if group_verified else process.pid
+            pid, status = os.waitpid(target, os.WNOHANG)
+        except InterruptedError:
+            continue
+        except ChildProcessError:
+            result["retired"] = group_verified and process.returncode is not None
+            if not result["retired"]:
+                result["cleanup_error"] = "leader custody was not reaped here"
+            return result
+        except OSError as error:
+            result["cleanup_error"] = error.errno
+            return result
+        if pid != 0:
+            result["reaps"].append(wait_status(pid, status))
+            if pid == process.pid:
+                process.returncode = os.waitstatus_to_exitcode(status)
+            continue
+        time.sleep(min(POLL_SECONDS, max(0, cleanup_end - time.monotonic())))
+
+    result["cleanup_error"] = "cleanup budget exhausted; physical retirement unknown"
+    return result
+
+
+def forward_output(path, stream):
+    """Preserve original output while retaining the real fixture transcript."""
+    with path.open("rb") as source:
+        for block in iter(lambda: source.read(64 * 1024), b""):
+            stream.buffer.write(block)
+    stream.flush()
+
+
+def supervise_fixture(binary, output_dir, control):
+    """Keep the one execution budget separate from bounded terminal cleanup."""
+    require_exclusive_supervisor()
+    label = control or "ordinary"
+    stdout_path = output_dir / (label + ".stdout")
+    stderr_path = output_dir / (label + ".stderr")
+    result = {"control": control, "execution_budget_seconds": EXECUTION_SECONDS,
+              "primary": None, "leader_observation": None, "cleanup": None,
+              "subreaper_restored": False, "group_verified": False}
+    process = None
+    child_env = dict(os.environ)
+    child_env.pop("PROCFD_SUPERVISOR_CONTROL", None)
+    if control is not None:
+        child_env["PROCFD_SUPERVISOR_CONTROL"] = control
+
+    prctl_child_subreaper(1)
+    try:
+        with stdout_path.open("wb") as stdout, stderr_path.open("wb") as stderr:
+            process = subprocess.Popen([str(binary)], cwd=output_dir, env=child_env,
+                                       stdout=stdout, stderr=stderr,
+                                       start_new_session=True)
+            execution_end = time.monotonic() + EXECUTION_SECONDS
+            result["leader"] = process.pid
+            result["group"] = process.pid
+            result["group_verified"] = (
+                os.getpgid(process.pid) == process.pid and
+                os.getsid(process.pid) == process.pid)
+            if not result["group_verified"]:
+                raise RuntimeError("procfd child is not in its own execution session")
+            while True:
+                if time.monotonic() >= execution_end:
+                    result["primary"] = "timeout"
+                    break
+                try:
+                    observed = os.waitid(os.P_PID, process.pid,
+                                         os.WEXITED | os.WNOHANG | os.WNOWAIT)
+                except InterruptedError:
+                    continue
+                if time.monotonic() >= execution_end:
+                    result["primary"] = "timeout"
+                    break
+                if observed is not None:
+                    result["leader_observation"] = {
+                        "pid": observed.si_pid, "code": observed.si_code,
+                        "status": observed.si_status}
+                    result["primary"] = "completed"
+                    break
+                time.sleep(min(POLL_SECONDS,
+                               max(0, execution_end - time.monotonic())))
+    except BaseException as error:
+        result["primary"] = result["primary"] or "supervisor-refusal"
+        result["supervisor_error"] = repr(error)
+    finally:
+        if process is not None:
+            try:
+                result["cleanup"] = retire_owned_group(process, result["group_verified"])
+            except BaseException as error:
+                result["cleanup"] = {"retired": False, "cleanup_error": repr(error)}
+            if not result["cleanup"]["retired"]:
+                # Retain the actual handle and record through supervisor exit;
+                # this failure never asserts that kernel custody disappeared.
+                _retained_supervisions.append(process)
+        if process is None or result["cleanup"]["retired"]:
+            try:
+                prctl_child_subreaper(0)
+                result["subreaper_restored"] = True
+            except OSError as error:
+                result["subreaper_restore_error"] = error.errno
+        result["returncode"] = process.returncode if process is not None else None
+        (output_dir / (label + ".supervision.json")).write_text(
+            json.dumps(result, indent=2) + "\n")
+
+    forward_output(stdout_path, sys.stdout)
+    forward_output(stderr_path, sys.stderr)
+    return result
+
+
+def require_fixture_result(result, binary, control, output_dir):
+    """Fail closed on uncertainty, retaining the original execution result."""
+    cleanup = result["cleanup"]
+    if cleanup is None or not cleanup["retired"] or not result["subreaper_restored"]:
+        raise RuntimeError("procfd physical retirement remains unverified: " +
+                           json.dumps(result, sort_keys=True))
+    if control is None:
+        if result["primary"] == "timeout":
+            raise subprocess.TimeoutExpired([str(binary)], EXECUTION_SECONDS)
+        if result["primary"] != "completed":
+            raise RuntimeError("procfd supervisor refused execution: " + str(result))
+        if result["returncode"] != 0:
+            raise subprocess.CalledProcessError(result["returncode"], [str(binary)])
+        if len(cleanup["reaps"]) != 1:
+            raise RuntimeError("ordinary fixture abandoned a descendant")
+        return
+
+    # The emitted PID/status comes from actual fork and WUNTRACED wait, not
+    # a successful-control label or a made-up child identity.
+    prefix = "SUPERVISOR_STOPPED_CHILD pid="
+    lines = (output_dir / (control + ".stdout")).read_text().splitlines()
+    witnesses = [line for line in lines if line.startswith(prefix)]
+    assert len(witnesses) == 1
+    child_text, status_text = witnesses[0][len(prefix):].split(" status=")
+    child, stopped_status = int(child_text), int(status_text)
+    assert child > 1 and child != result["leader"]
+    assert os.WIFSTOPPED(stopped_status)
+    assert os.WSTOPSIG(stopped_status) == signal.SIGSTOP
+    child_reaps = [row for row in cleanup["reaps"] if row["pid"] == child]
+    leader_reaps = [row for row in cleanup["reaps"]
+                    if row["pid"] == result["leader"]]
+    assert len(child_reaps) == len(leader_reaps) == 1
+    assert len(cleanup["reaps"]) == 2
+    assert child_reaps[0]["signaled"] and child_reaps[0]["signal"] == signal.SIGKILL
+    if control == "stopped-child":
+        assert result["primary"] == "timeout"
+        assert leader_reaps[0]["signaled"]
+        assert leader_reaps[0]["signal"] == signal.SIGKILL
+        assert result["returncode"] == -signal.SIGKILL
+    else:
+        assert result["primary"] == "completed"
+        assert leader_reaps[0]["signaled"]
+        assert leader_reaps[0]["signal"] == signal.SIGABRT
+        assert result["returncode"] == -signal.SIGABRT
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--native-source", type=Path,
+                        default=ROOT / "block/crucible-hot-fork-source.c")
+    parser.add_argument("--raw-source", type=Path, default=ROOT / "block/file-posix.c")
+    parser.add_argument("--output-dir", type=Path, required=True)
+    parser.add_argument("--supervisor-control",
+                        choices=["stopped-child", "parent-refusal"])
+    args = parser.parse_args()
+    native = args.native_source.read_text()
+    raw = args.raw_source.read_text()
+    osdep = (ROOT / "util/osdep.c").read_text()
+    block_types = (ROOT / "include/block/block_int-common.h").read_text()
+    functions = [
+        production_definition((ROOT / "util/cutils.c").read_text(), "int strstart("),
+        *[production_definition(osdep, signature) for signature in (
+            "int qemu_dup(int fd)", "static int qemu_open_cloexec(",
+            "static int\nqemu_open_internal(", "int qemu_open(const char *name",
+            "int qemu_close(int fd)",
+        )],
+        production_definition(raw, "static bool GRAPH_RDLOCK raw_crucible_hot_fork_file("),
+        *[production_definition(native, signature) for signature in (
+            "static int source_file_open(", "static bool child_file_copy(",
+            "static bool child_file_digest(", "static bool child_file_original_matches(",
+            "static bool child_file_digest_matches(",
+            "static bool child_file_prepared_matches(", "static bool child_file_prepare(",
+        )],
+        production_definition(raw, "static bool GRAPH_RDLOCK raw_crucible_hot_fork_file_child("),
+    ]
+    args.output_dir.mkdir(parents=True, exist_ok=True)
