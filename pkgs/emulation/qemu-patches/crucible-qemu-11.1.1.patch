+"""
+
+QUEUE_PROVIDERS = r"""
+static unsigned int lock_reads, tick_reads, raw_reads, observed_reads;
+static uint64_t raw_now = 7;
+static int64_t tick_now = 7000;
+static bool downtime;
+static uint64_t downtime_deadline = 9000;
+static unsigned int deadline_reads, boundary_entries, boundary_leaves;
+static unsigned int observer_calls, prepare_calls, commit_calls, completions;
+static bool defer_commit;
+
+static void counted_mutex_lock(GMutex *mutex)
+{
+    if (mutex == &crucible_fault_lock) {
+        qatomic_inc(&lock_reads);
+    }
+    g_mutex_lock(mutex);
+}
+#define g_mutex_lock counted_mutex_lock
+
+uint64_t qemu_plugin_icount_raw(void)
+{
+    qatomic_inc(&raw_reads);
+    return raw_now;
+}
+
+int64_t qemu_plugin_sim_tick_observed(void)
+{
+    qatomic_inc(&tick_reads);
+    return tick_now;
+}
+
+uint64_t qemu_crucible_fault_observed_icount(void)
+{
+    observed_reads++;
+    return raw_now;
+}
+
+int qemu_plugin_crucible_single_threaded_rr(void)
+{
+    return 1;
+}
+
+void qemu_crucible_fault_registry_seal(void)
+{
+    crucible_registry_sealed = true;
+}
+
+static bool qemu_crucible_fault_lifecycle_downtime_pending(void)
+{
+    return downtime;
+}
+
+static uint64_t qemu_crucible_fault_lifecycle_downtime_deadline(void)
+{
+    return downtime_deadline;
+}
+
+static void qemu_crucible_fault_lifecycle_downtime_boundary(
+    uint16_t phase, uint64_t icount)
+{
+    g_assert_cmpuint(phase, ==, CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY);
+    g_assert_cmpuint(icount, ==, raw_now);
+}
+
+void qemu_plugin_crucible_exact_boundary_enter(void)
+{
+    boundary_entries++;
+}
+
+void qemu_plugin_crucible_exact_boundary_leave(void)
+{
+    boundary_leaves++;
+}
+"""
+
+INSTRUCTION_PROVIDERS = r"""
+struct QemuCrucibleFaultRule { int unused; };
+
+struct CPUState { uint64_t pc; bool exit_request; };
+
+/* Only completion-owned fields matter; this is not a native layout claim. */
+typedef struct CrucibleInstructionContext {
+    QemuCrucibleFaultRule *rule;
+    GPtrArray *contributors;
+    CrucibleInstructionMetadata metadata;
+    CrucibleInstructionState before_state, command_before_state;
+    uint32_t mutation_kind, replay_remaining, replay_ordinal, replay_total;
+    bool executing, replaying;
+} CrucibleInstructionContext;
+
+static CrucibleInstructionContext instruction_context;
+static QemuCrucibleFaultRule rule;
+static bool has_context, crucible_instruction_event_terminal_latched;
+static unsigned int clears, snapshots, events, impulses, failures, transforms;
+static uint16_t last_outcome;
+static uint64_t last_coordinate;
+
+static CrucibleInstructionContext *crucible_instruction_context(
+    CPUState *cpu, bool create)
+{
+    (void)cpu;
+    g_assert_false(create);
+    return has_context ? &instruction_context : NULL;
+}
+
+static void crucible_instruction_context_clear(CrucibleInstructionContext *ctx)
+{
+    clears++;
+    ctx->rule = NULL;
+    ctx->executing = false;
+}
+
+static int crucible_instruction_system_snapshot(
+    uint64_t icount, CrucibleInstructionState *state, void *error)
+{
+    (void)error;
+    g_assert_cmpuint(icount, ==, raw_now);
+    snapshots++;
+    state->state_sha256[0] = snapshots;
+    return 0;
+}
+
+static const QObject *qemu_crucible_fault_rule_json(
+    const QemuCrucibleFaultRule *selected, int field)
+{
+    static const QObject mutation;
+    g_assert_true(selected == &rule);
+    g_assert_cmpint(field, ==, CRUCIBLE_NODE_FAULT_FIELD_P4);
+    return &mutation;
+}
+
+static bool qemu_crucible_fault_rule_occurs_nested(
+    const QemuCrucibleFaultRule *selected, int field, const char *name)
+{
+    g_assert_true(selected == &rule);
+    g_assert_cmpint(field, ==, CRUCIBLE_NODE_FAULT_FIELD_P1);
+    g_assert_cmpstr(name, ==, "occurrence");
+    return true;
+}
+
+static bool crucible_instruction_rule_hash(
+    const QemuCrucibleFaultRule *selected, int field, const uint8_t **hash)
+{
+    static const uint8_t destination[32];
+    g_assert_true(selected == &rule);
+    g_assert_cmpint(field, ==, CRUCIBLE_NODE_FAULT_FIELD_P3);
+    *hash = destination;
+    return true;
+}
+
+static int qemu_crucible_fault_register_result_transform(
+    CPUState *cpu, const uint8_t *destination, const QObject *mutation,
+    uint64_t icount, uint16_t phase, uint8_t before[32], uint8_t after[32],
+    GByteArray *detail)
+{
+    (void)cpu;
+    g_assert_nonnull(destination);
+    g_assert_nonnull(mutation);
+    g_assert_cmpuint(icount, ==, raw_now);
+    g_assert_cmpuint(phase, ==, QEMU_CRUCIBLE_MODEL_PHASE_AFTER_INSTRUCTION);
+    memset(before, 1, 32);
