+static void test_round_trip(gconstpointer opaque)
+{
+    unsigned index = GPOINTER_TO_UINT(opaque);
+    bool pending = index < ARRAY_SIZE(deadlines);
+    __int128 deadline = pending ? coordinate(deadlines[index]) : 0;
+    PITCommonState source, destination;
+    GByteArray *bytes;
+
+    initialize_timers(&source);
+    initialize_timers(&destination);
+    set_deadline(&source, deadline, pending);
+    bytes = save_state(&source);
+    timer_mod_ps_wide(destination.channels[0].irq_timer, 1);
+
+    g_assert_cmpint(load_state(&destination, bytes), ==, 0);
+    for (unsigned channel = 0; channel < 3; channel++) {
+        assert_coordinate(destination.channels[channel].count_load_time_ps,
+                           deadline);
+    }
+    g_assert_cmpint(destination.channels[0].next_transition_valid, ==, pending);
+    g_assert_cmpint(timer_pending(destination.channels[0].irq_timer), ==, pending);
+    if (pending) {
+        assert_coordinate(destination.channels[0].next_transition_time_ps, deadline);
+        assert_coordinate(timer_expire_time_ps_wide(
+                              destination.channels[0].irq_timer), deadline);
+    }
+
+    g_byte_array_unref(bytes);
+    destroy_timers(&source);
+    destroy_timers(&destination);
+}
