+/* Shared mappings span whole pages; protocol region lengths are exact. */
+static uint64_t crucible_hot_fork_mapping_extent(uint64_t length)
+{
+    uint64_t page_size = qemu_real_host_page_size();
+
+    if (length > UINT64_MAX - (page_size - 1)) {
+        return UINT64_MAX;
+    }
+    return QEMU_ALIGN_UP(length, page_size);
+}
+
+static bool crucible_hot_fork_private_ring_stage_matches(
+    const char *fdname, uint64_t device, uint64_t inode, uint64_t length)
+{
+    return crucible_hot_fork_private_ring_stage.staged &&
+        strcmp(crucible_hot_fork_private_ring_stage.fdname, fdname) == 0 &&
+        crucible_hot_fork_private_ring_stage.device == device &&
+        crucible_hot_fork_private_ring_stage.inode == inode &&
+        crucible_hot_fork_private_ring_stage.length == length &&
+        crucible_hot_fork_private_ring_stage.shrink_sealed;
+}
+
+CrucibleHotForkPrivateRingState *
+qmp_crucible_hot_fork_private_rings(
+    CrucibleHotForkPrivateRingAction action,
+    const char *fdname,
+    bool has_expected_device, uint64_t expected_device,
+    bool has_expected_inode, uint64_t expected_inode,
+    bool has_expected_length, uint64_t expected_length,
+    Error **errp)
+{
+    CrucibleHotForkPrivateRingState *report = NULL;
+    QemuCrucibleHotForkSourceMapping source_mapping = { 0 };
+    QemuPluginCrucibleHotForkInventory resources = { 0 };
+    struct stat metadata;
+    int candidate = -1;
+    int result;
+    int seals;
+
+    g_autoptr(BQLLockAuto) admission_bql =
+        action != CRUCIBLE_HOT_FORK_PRIVATE_RING_ACTION_QUERY ?
+        bql_auto_lock(__FILE__, __LINE__) : NULL;
+
+    g_mutex_lock(&crucible_hot_fork_template_lock);
+    switch (action) {
+    case CRUCIBLE_HOT_FORK_PRIVATE_RING_ACTION_STAGE:
+        if (!fdname || !has_expected_device || !has_expected_inode ||
+            !has_expected_length) {
+            error_setg(errp, "Crucible hot-fork private-ring staging requires "
+                       "an exact fd name, device, inode, and length");
+            goto out;
+        }
+        if (!crucible_hot_fork_private_ring_fd_name_valid(fdname)) {
+            error_setg(errp, "Invalid Crucible hot-fork private-ring fd name");
+            goto out;
+        }
+        if (expected_inode == 0 || expected_length == 0 ||
+            expected_length > INT64_MAX) {
+            error_setg(errp, "Invalid Crucible hot-fork private-ring identity");
+            goto out;
+        }
+        candidate = monitor_dup_fd(monitor_cur(), fdname, errp);
+        if (candidate < 0) {
+            goto out;
+        }
+        if (fstat(candidate, &metadata) != 0) {
+            error_setg_errno(errp, errno,
+                             "Could not inspect Crucible hot-fork private rings");
+            goto out;
+        }
+        if (!S_ISREG(metadata.st_mode) || metadata.st_size < 0 ||
+            (uint64_t)metadata.st_dev != expected_device ||
+            (uint64_t)metadata.st_ino != expected_inode ||
+            (uint64_t)metadata.st_size != expected_length) {
+            error_setg(errp, "Crucible hot-fork private-ring descriptor "
+                       "identity mismatch");
+            goto out;
+        }
+#ifdef F_GET_SEALS
+        seals = fcntl(candidate, F_GET_SEALS);
+#else
+        seals = -1;
+        errno = ENOTSUP;
+#endif
+        if (seals < 0) {
+            error_setg_errno(errp, errno,
+                             "Could not inspect Crucible hot-fork private-ring seals");
+            goto out;
+        }
+#ifdef F_SEAL_SHRINK
+        if ((seals & F_SEAL_SHRINK) == 0) {
+            error_setg(errp, "Crucible hot-fork private-ring descriptor is "
+                       "not shrink sealed");
+            goto out;
+        }
+#else
+        error_setg(errp, "Crucible hot-fork private-ring shrink sealing is "
+                   "not supported on this host");
+        goto out;
+#endif
+
+        if (crucible_hot_fork_private_ring_stage.staged) {
+            if (!crucible_hot_fork_private_ring_stage_matches(
+                    fdname, expected_device, expected_inode,
+                    expected_length)) {
+                error_setg(errp, "A different Crucible hot-fork private-ring "
+                           "descriptor is already staged");
+                goto out;
+            }
+            report = crucible_hot_fork_private_ring_report();
+            goto out;
+        }
+        if (!crucible_hot_fork_resource_stage_allowed(NULL, errp)) {
+            goto out;
+        }
+        if (crucible_hot_fork_template_active) {
+            qemu_plugin_crucible_hot_fork_inventory(&resources);
+            if (!resources.complete ||
+                resources.manifest.shmem_inode == 0 ||
+                resources.manifest.shmem_length != expected_length) {
+                error_setg(errp, "Crucible hot-fork private rings do not "
+                           "match one complete plugin setup region");
+                goto out;
+            }
+            result = qemu_crucible_hot_fork_find_source_mapping(
+                resources.manifest.shmem_device,
+                resources.manifest.shmem_inode,
+                resources.manifest.shmem_length,
+                &source_mapping);
+
+            if (result != 0) {
+                error_setg_errno(errp, -result,
+                                 "Could not bind the Crucible plugin source "
+                                 "mapping");
+                goto out;
+            }
+        }
+
+        crucible_hot_fork_private_ring_stage.staged = true;
+        crucible_hot_fork_private_ring_stage.fd = candidate;
+        candidate = -1;
+        crucible_hot_fork_private_ring_stage.fdname = g_strdup(fdname);
+        crucible_hot_fork_private_ring_stage.device = expected_device;
+        crucible_hot_fork_private_ring_stage.inode = expected_inode;
+        crucible_hot_fork_private_ring_stage.length = expected_length;
+        crucible_hot_fork_private_ring_stage.shrink_sealed = true;
+        crucible_hot_fork_private_ring_stage.source_mapping_bound =
+            crucible_hot_fork_template_active;
+        crucible_hot_fork_private_ring_stage.source_start =
+            source_mapping.start;
+        crucible_hot_fork_private_ring_stage.source_length =
+            source_mapping.length;
+        crucible_hot_fork_private_ring_stage.source_offset =
+            source_mapping.offset;
+        crucible_hot_fork_private_ring_stage.template_generation =
+            crucible_hot_fork_resource_template_generation();
+        crucible_hot_fork_private_ring_stage.generation++;
+        assert(crucible_hot_fork_private_ring_stage.generation != 0);
+        report = crucible_hot_fork_private_ring_report();
+        break;
+    case CRUCIBLE_HOT_FORK_PRIVATE_RING_ACTION_QUERY:
+        if (fdname || has_expected_device || has_expected_inode ||
+            has_expected_length) {
+            error_setg(errp, "Crucible hot-fork private-ring query accepts no "
+                       "descriptor identity");
+            goto out;
+        }
+        report = crucible_hot_fork_private_ring_report();
+        break;
+    case CRUCIBLE_HOT_FORK_PRIVATE_RING_ACTION_RELEASE:
+        if (!fdname || !has_expected_device || !has_expected_inode ||
+            !has_expected_length ||
+            !crucible_hot_fork_private_ring_fd_name_valid(fdname)) {
+            error_setg(errp, "Crucible hot-fork private-ring release requires "
+                       "an exact descriptor identity");
+            goto out;
+        }
+        if (!crucible_hot_fork_private_ring_stage.staged) {
+            error_setg(errp, "No Crucible hot-fork private-ring descriptor "
+                       "is staged");
+            goto out;
+        }
+        if (!crucible_hot_fork_private_ring_stage_matches(
+                fdname, expected_device, expected_inode, expected_length)) {
+            error_setg(errp, "Crucible hot-fork private-ring release identity "
+                       "does not match the retained descriptor");
+            goto out;
+        }
+        if (!crucible_hot_fork_stage_release_allowed("private rings", errp)) {
+            goto out;
+        }
+        if (crucible_hot_fork_plugin_endpoint_stage.staged) {
+            error_setg(errp, "Cannot release Crucible hot-fork private rings "
+                       "while plugin endpoints retain their generation");
+            goto out;
+        }
+        if (crucible_hot_fork_diagnostic_stage.staged ||
+            crucible_hot_fork_qmp_stage.staged) {
+            error_setg(errp, "Cannot release Crucible hot-fork private rings "
+                       "while child control resources remain retained");
+            goto out;
+        }
+        close(crucible_hot_fork_private_ring_stage.fd);
+        crucible_hot_fork_private_ring_stage.fd = -1;
+        g_clear_pointer(&crucible_hot_fork_private_ring_stage.fdname, g_free);
+        crucible_hot_fork_private_ring_stage.staged = false;
+        crucible_hot_fork_private_ring_stage.device = 0;
+        crucible_hot_fork_private_ring_stage.inode = 0;
+        crucible_hot_fork_private_ring_stage.length = 0;
+        crucible_hot_fork_private_ring_stage.shrink_sealed = false;
+        crucible_hot_fork_private_ring_stage.source_mapping_bound = false;
+        crucible_hot_fork_private_ring_stage.source_start = 0;
+        crucible_hot_fork_private_ring_stage.source_length = 0;
+        crucible_hot_fork_private_ring_stage.source_offset = 0;
+        crucible_hot_fork_private_ring_stage.template_generation = 0;
+        crucible_hot_fork_private_ring_stage.generation++;
+        assert(crucible_hot_fork_private_ring_stage.generation != 0);
+        report = crucible_hot_fork_private_ring_report();
+        break;
+    default:
+        g_assert_not_reached();
+    }
+out:
+    if (candidate >= 0) {
+        close(candidate);
+    }
+    g_mutex_unlock(&crucible_hot_fork_template_lock);
+    return report;
+}
+
+static bool crucible_hot_fork_control_socket_cookie(
+    int fd, uint64_t *cookie, Error **errp)
+{
+#if defined(SO_DOMAIN) && defined(SO_COOKIE)
+    int domain;
+    int type;
+    uint64_t socket_cookie;
+    socklen_t length;
+    char byte;
+    ssize_t peeked;
+
+    length = sizeof(domain);
+    if (getsockopt(fd, SOL_SOCKET, SO_DOMAIN, &domain, &length) != 0) {
+        error_setg_errno(errp, errno,
+                         "Could not inspect Crucible control socket domain");
+        return false;
+    }
+    if (length != sizeof(domain) || domain != AF_UNIX) {
+        error_setg(errp, "Crucible hot-fork control endpoint is not AF_UNIX");
+        return false;
+    }
+    length = sizeof(type);
+    if (getsockopt(fd, SOL_SOCKET, SO_TYPE, &type, &length) != 0) {
+        error_setg_errno(errp, errno,
+                         "Could not inspect Crucible control socket type");
+        return false;
+    }
+    if (length != sizeof(type) || type != SOCK_STREAM) {
+        error_setg(errp, "Crucible hot-fork control endpoint is not a stream");
+        return false;
+    }
+    length = sizeof(socket_cookie);
+    if (getsockopt(fd, SOL_SOCKET, SO_COOKIE, &socket_cookie, &length) != 0) {
+        error_setg_errno(errp, errno,
+                         "Could not authenticate Crucible control socket");
+        return false;
+    }
+    if (length != sizeof(socket_cookie) || socket_cookie == 0) {
+        error_setg(errp, "Invalid Crucible control socket identity");
+        return false;
+    }
+    do {
+        peeked = recv(fd, &byte, sizeof(byte), MSG_PEEK | MSG_DONTWAIT);
+    } while (peeked < 0 && errno == EINTR);
+    if (peeked >= 0 || (errno != EAGAIN && errno != EWOULDBLOCK)) {
+        error_setg(errp, "Crucible hot-fork control socket is not connected "
+                   "and empty");
+        return false;
+    }
+    *cookie = socket_cookie;
+    return true;
+#else
+    error_setg(errp, "Crucible hot-fork control socket authentication is "
+               "unsupported on this host");
+    return false;
+#endif
+}
+
+static bool crucible_hot_fork_nonblocking_socket_cookie(
+    int fd, uint64_t *cookie, Error **errp)
+{
+    int flags;
+
+    if (!crucible_hot_fork_control_socket_cookie(fd, cookie, errp)) {
+        return false;
+    }
+    flags = fcntl(fd, F_GETFL);
+    if (flags < 0) {
+        error_setg_errno(errp, errno,
+                         "Could not inspect Crucible child stream flags");
+        return false;
+    }
+    if ((flags & O_NONBLOCK) == 0) {
+        error_setg(errp, "Crucible child stream is not nonblocking");
+        return false;
+    }
+    return true;
+}
+
+static bool crucible_hot_fork_wake_eventfd_id(
+    int fd, uint64_t *eventfd_id, Error **errp)
+{
+    struct pollfd wake = { .fd = fd, .events = POLLIN };
+    int flags;
+    int ready;
+
+    flags = fcntl(fd, F_GETFL);
+    if (flags < 0) {
+        error_setg_errno(errp, errno,
+                         "Could not inspect Crucible wake descriptor flags");
+        return false;
+    }
+    if ((flags & O_NONBLOCK) == 0) {
+        error_setg(errp, "Crucible hot-fork wake eventfd is not nonblocking");
+        return false;
+    }
+    do {
+        ready = poll(&wake, 1, 0);
+    } while (ready < 0 && errno == EINTR);
+    if (ready < 0) {
+        error_setg_errno(errp, errno,
+                         "Could not inspect Crucible wake eventfd state");
+        return false;
+    }
+    if (ready != 0 || wake.revents != 0) {
+        error_setg(errp, "Crucible hot-fork wake eventfd is not empty");
+        return false;
+    }
+    return crucible_hot_fork_eventfd_id(fd, eventfd_id, errp);
+}
+
+static bool crucible_hot_fork_endpoint_objects_private(
+    int source_control_fd, int source_wake_fd,
+    uint64_t candidate_control_cookie, uint64_t candidate_wake_id,
+    Error **errp)
+{
+    uint64_t source_control_cookie = 0;
+    uint64_t source_wake_id = 0;
+
+    /* SCM_RIGHTS changes FD numbers while retaining the underlying object.
+     * Inspect the held source objects without changing flags or consuming
+     * socket/eventfd data before admitting any replacement resources. */
+    if (source_control_fd < 0 || source_wake_fd < 0 ||
+        candidate_control_cookie == 0 || candidate_wake_id == 0) {
+        error_setg(errp, "Crucible hot-fork endpoint object identity is absent");
+        return false;
+    }
+    if (!crucible_hot_fork_control_socket_cookie(
+            source_control_fd, &source_control_cookie, errp) ||
+        !crucible_hot_fork_eventfd_id(source_wake_fd, &source_wake_id, errp)) {
+        return false;
+    }
+    if (candidate_control_cookie == source_control_cookie) {
+        error_setg(errp, "Crucible hot-fork control socket aliases the "
+                   "retained source socket");
+        return false;
+    }
+    if (candidate_wake_id == source_wake_id) {
+        error_setg(errp, "Crucible hot-fork wake eventfd aliases the "
+                   "retained source eventfd");
+        return false;
+    }
+    return true;
+}
+
+static CrucibleHotForkPluginEndpointState *
+crucible_hot_fork_plugin_endpoint_report(void)
+{
+    CrucibleHotForkPluginEndpointState *report =
+        g_new0(CrucibleHotForkPluginEndpointState, 1);
+
+    report->schema_version = 5;
+    report->generation = crucible_hot_fork_plugin_endpoint_stage.generation;
+    report->template_generation =
+        crucible_hot_fork_plugin_endpoint_stage.template_generation;
+    report->staged = crucible_hot_fork_plugin_endpoint_stage.staged;
+    if (crucible_hot_fork_plugin_endpoint_stage.staged) {
+        report->control_fdname = g_strdup(
+            crucible_hot_fork_plugin_endpoint_stage.control_fdname);
+        report->wake_fdname = g_strdup(
+            crucible_hot_fork_plugin_endpoint_stage.wake_fdname);
+    }
+    report->control_socket_cookie =
+        crucible_hot_fork_plugin_endpoint_stage.control_socket_cookie;
+    report->wake_eventfd_id =
+        crucible_hot_fork_plugin_endpoint_stage.wake_eventfd_id;
+    report->control_source_fd =
+        crucible_hot_fork_plugin_endpoint_stage.staged ?
+            crucible_hot_fork_plugin_endpoint_stage.control_fd : -1;
+    report->wake_source_fd =
+        crucible_hot_fork_plugin_endpoint_stage.staged ?
+            crucible_hot_fork_plugin_endpoint_stage.wake_fd : -1;
+    report->control_target_fd =
+        crucible_hot_fork_plugin_endpoint_stage.replacement_plan_bound ?
+            crucible_hot_fork_plugin_endpoint_stage.control_target_fd : -1;
+    report->wake_target_fd =
+        crucible_hot_fork_plugin_endpoint_stage.replacement_plan_bound ?
+            crucible_hot_fork_plugin_endpoint_stage.wake_target_fd : -1;
+    report->private_ring_generation =
+        crucible_hot_fork_plugin_endpoint_stage.private_ring_generation;
+    report->plugin_barrier_generation =
+        crucible_hot_fork_plugin_endpoint_stage.plugin_barrier_generation;
+    report->worker_mask =
+        crucible_hot_fork_plugin_endpoint_stage.worker_mask;
+    report->parent_resume_worker_mask =
+        crucible_hot_fork_plugin_endpoint_stage.parent_resume_worker_mask;
+    report->child_reinitialize_worker_mask =
+        crucible_hot_fork_plugin_endpoint_stage.child_reinitialize_worker_mask;
+    report->pending_worker_mask = 0;
+    report->worker_disposition_planned =
+        crucible_hot_fork_plugin_endpoint_stage.staged &&
+        crucible_hot_fork_plugin_endpoint_stage.template_generation != 0 &&
+        crucible_hot_fork_plugin_endpoint_stage.plugin_barrier_generation !=
+            0 &&
+        crucible_hot_fork_plugin_endpoint_stage.replacement_plan_bound &&
+        crucible_hot_fork_plugin_endpoint_stage.worker_mask != 0 &&
+        crucible_hot_fork_plugin_endpoint_stage.parent_resume_worker_mask ==
+            crucible_hot_fork_plugin_endpoint_stage.worker_mask &&
+        crucible_hot_fork_plugin_endpoint_stage.
+            child_reinitialize_worker_mask ==
+                crucible_hot_fork_plugin_endpoint_stage.worker_mask;
+    report->replacement_plan_bound = report->worker_disposition_planned &&
+        report->control_source_fd >= 0 && report->wake_source_fd >= 0 &&
+        report->control_target_fd >= 0 && report->wake_target_fd >= 0 &&
+        report->control_source_fd != report->wake_source_fd &&
+        report->control_target_fd != report->wake_target_fd &&
+        report->control_source_fd != report->control_target_fd &&
+        report->control_source_fd != report->wake_target_fd &&
+        report->wake_source_fd != report->control_target_fd &&
+        report->wake_source_fd != report->wake_target_fd &&
+        report->control_source_fd != crucible_hot_fork_private_ring_stage.fd &&
+        report->wake_source_fd != crucible_hot_fork_private_ring_stage.fd &&
+        report->control_target_fd != crucible_hot_fork_private_ring_stage.fd &&
+        report->wake_target_fd != crucible_hot_fork_private_ring_stage.fd;
+    report->control_unix_stream =
+        crucible_hot_fork_plugin_endpoint_stage.staged;
+    report->wake_eventfd = crucible_hot_fork_plugin_endpoint_stage.staged;
+    report->disposition_complete = false;
+    report->readiness_proof_acknowledged = false;
+    return report;
+}
