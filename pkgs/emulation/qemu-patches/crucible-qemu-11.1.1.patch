+int qemu_crucible_source_initial_register_borrow_end_v1(
+    CPUState *cpu, QemuCrucibleInitialRegisterWorkspaceOwner *owner,
+    QemuCrucibleInitialRegisterWorkspaceOwner **holder,
+    QemuCrucibleInitialRegisterWorkspaceOwner **borrow_holder, int work_status)
+{
+#ifdef CONFIG_LINUX
+    struct QemuCrucibleInitialCpuParticipant *participant = NULL;
+    bool authenticated = false, entered = false, returned = false;
+    int first = qemu_crucible_fault_register_borrow_observe_v1(
+        cpu, owner, borrow_holder, false, true, &entered);
+    int post;
+
+    if (!first) {
+        first = initial_register_workspace_identity(owner, holder, false, false);
+    }
+    if (!first) {
+        first = initial_cpu_identity(cpu, &cpu->crucible_initial_participant,
+                                     &participant);
+    }
+    if (!first) {
+        first = initial_cpu_child_source_current(participant, false);
+    }
+    if (!first) {
+        first = initial_register_borrow_facts(owner, cpu, participant, borrow_holder);
+    }
+    if (!first && owner->read.held) {
+        first = -EBUSY;
+    }
+    if (!first && owner->borrow_return_observed && owner->borrow_entered != entered) {
+        first = -ESTALE;
+    }
+    if (!first) {
+        owner->borrow_return_observed = true;
+        owner->borrow_entered = entered;
+        returned = true;
+        first = initial_cpu_child_original_observe(participant, false);
+        if (!first) {
+            first = initial_register_workspace_dependencies_current(owner);
+        }
+    }
+    post = initial_register_borrow_post(cpu, owner, holder, &authenticated);
+    if (returned) {
+        if (!owner->borrow_return_post_recorded) {
+            owner->borrow_return_first_status = work_status ? work_status : first;
+            owner->borrow_return_post_status = post;
+            owner->borrow_return_post_recorded = true;
+        }
+        /* Physical call/no-call completion plus fresh independent authority
+         * and unchanged full cohort close the loan, regardless of work error.
+         * A status alone never returns credit or clears a canonical holder. */
+        if (initial_register_borrow_closed_facts(owner, authenticated, first, post)) {
+            *borrow_holder = NULL;
+            owner->borrow_holder = NULL;
+            owner->borrow_held = false;
+        }
+    }
+    return work_status ? work_status : first ? first : post;
+#else
+    return -ENOTSUP;
+#endif
+}
