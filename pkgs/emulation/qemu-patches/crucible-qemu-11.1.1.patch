@@ -33,6 +33,60 @@
 #define QCRYPTO_HASH_DIGEST_LEN_RIPEMD160 20
 #define QCRYPTO_HASH_DIGEST_LEN_SM3       32
 
+/**
+ * QCryptoSHA256:
+ *
+ * Caller-owned, process-private SHA-256 storage, including compression scratch.
+ * Treat fields as implementation state, not identity or operation authority.
+ * The caller retains exclusive access and valid backing through finalization.
+ */
+typedef struct QCryptoSHA256 {
+    uint32_t state[8];
+    uint32_t schedule[64];
+    uint32_t working[8];
+    uint64_t bytes;
+    uint8_t block[64];
+    bool active;
+} QCryptoSHA256;
+
+/**
+ * qcrypto_sha256_init:
+ * @hash: aligned, writable caller-owned storage
+ *
+ * Starts an empty message, replacing any previous state, including a finalized
+ * message. No allocation or configured crypto backend is involved.
+ * Returns: 0, or -EINVAL without writes for invalid storage geometry.
+ */
+int qcrypto_sha256_init(QCryptoSHA256 *hash);
+
+/**
+ * qcrypto_sha256_update:
+ * @hash: exclusively retained initialized state
+ * @data: readable bytes, disjoint from the entire state; NULL only if @len is 0
+ * @len: exact number of available input bytes
+ *
+ * Streams bytes into one active message. Empty updates are permitted. Checked
+ * refusal leaves all state unchanged. Pointers must have actual valid backing;
+ * address/overlap checks establish storage facts, not allocation ownership.
+ * Returns: 0, -EINVAL for invalid state/spans, or -EOVERFLOW if the cumulative
+ * message would exceed UINT64_MAX / 8 bytes (SHA-256's bit-length limit).
+ */
+int qcrypto_sha256_update(QCryptoSHA256 *hash, const void *data, size_t len);
+
+/**
+ * qcrypto_sha256_finalize:
+ * @hash: exclusively retained active state
+ * @digest: writable storage disjoint from the entire state
+ * @digest_len: exactly QCRYPTO_HASH_DIGEST_LEN_SHA256 bytes
+ *
+ * Writes the digest and consumes the message. A second finalization or update
+ * refuses until init starts another message. Refusal preserves state and output;
+ * successful finalization is not an erasure guarantee.
+ * Returns: 0, or -EINVAL for invalid state, length, address or overlap.
+ */
+int qcrypto_sha256_finalize(QCryptoSHA256 *hash, uint8_t *digest,
+                             size_t digest_len);
+
 /* See also "QCryptoHashAlgo" defined in qapi/crypto.json */
 
 typedef struct QCryptoHash QCryptoHash;
