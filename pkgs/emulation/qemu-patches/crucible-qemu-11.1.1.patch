+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    for (unsigned index = 0; index < G_N_ELEMENTS(vectors); index++) {
+        g_autofree char *name = g_strdup_printf("/ppc/ticks/%u", index);
+
+        g_test_add_data_func(name, &vectors[index], test_tick_conversion);
