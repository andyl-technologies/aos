+int qemu_plugin_crucible_ram_actor_pause_current(QemuCrucibleRamActorPause *pause)
+{
+    QemuCrucibleRamControlActor *actor = &startup_source.ram_control_actor;
+
+    if (!pause) {
+        return actor->attempted ? -ESTALE : 0;
+    }
+    if ((pause != &actor->pause && pause != &actor->request_pause) ||
+        !qatomic_load_acquire(&pause->held) ||
+        !qatomic_load_acquire(&pause->requested) ||
+        pause->actor != actor || pause->process != getpid() ||
+        pause->owner_thread != qemu_get_thread_id() || pause->end.entered ||
+        pause->binding != actor->thread_binding ||
+        pause->thread_id != actor->thread_id ||
+        pause->service_generation != actor->service_generation ||
+        !actor->service_registered || actor->record_in_flight ||
+        actor->receipt.record.callback_active ||
+        (actor->receipt.record.held &&
+         (!actor->receipt.moved || !actor->receipt.record.end_returned ||
+          actor->receipt.record.end_result ||
+          actor->receipt.record.terminal_journal !=
+              QEMU_PLUGIN_CRUCIBLE_RAM_RECORD_TERMINAL_COMPLETED ||
+          actor->receipt.record.completion_result)) ||
+        qatomic_load_acquire(&actor->terminal_pending) ||
+        actor->returned || actor->receipt.uncertain ||
+        actor->first_status || actor->post_status) {
+        return -ESTALE;
+    }
+    return 0;
+}
