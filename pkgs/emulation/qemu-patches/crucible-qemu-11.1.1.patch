diff --git a/tests/tcg/plugins/crucible-resident-ram.h b/tests/tcg/plugins/crucible-resident-ram.h
new file mode 100644
index 0000000000000000000000000000000000000000..5257dbd8ed9a4b60125b4338ec030b77e8de22e2
--- /dev/null
+++ b/tests/tcg/plugins/crucible-resident-ram.h
@@ -0,0 +1,123 @@
+/*
+ * Bounded resident logical-RAM ownership for native component fixtures.
+ * Copyright (c) Andyl, Inc.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef CRUCIBLE_TEST_RESIDENT_RAM_H
+#define CRUCIBLE_TEST_RESIDENT_RAM_H
+
+#include <errno.h>
+#include <stdint.h>
+#include <string.h>
+#include <qemu-plugin.h>
+
+/* Primitive fixtures own a bounded resident inventory and use the independent
+ * full-RAM oracle. This does not qualify paging, cache tracking or deployment.
+ */
+#define CRUCIBLE_FIXTURE_METADATA_BUDGET (64 * 1024 * 1024ULL)
+
+static int crucible_fixture_admit_ram_inventory(
+    const struct qemu_plugin_crucible_ram_admission_v1 *admission,
+    uint64_t remaining_metadata)
+{
+    uint64_t logical_bytes = 0;
+    struct qemu_plugin_crucible_ram_region_v1 previous = { 0 };
+
+    if (!admission || admission->schema != 1 || !admission->region_count ||
+        admission->region_count > 4096 ||
+        admission->native_metadata_bytes > CRUCIBLE_FIXTURE_METADATA_BUDGET ||
+        remaining_metadata !=
+            CRUCIBLE_FIXTURE_METADATA_BUDGET - admission->native_metadata_bytes ||
+        admission->native_scratch_bytes > remaining_metadata) {
+        return -EINVAL;
+    }
+    for (uint32_t index = 0; index < admission->region_count; index++) {
+        struct qemu_plugin_crucible_ram_region_v1 region;
+        int status = qemu_plugin_crucible_ram_admission_region_v1(
+            admission->topology_generation, index, &region);
+
+        if (status != 0) {
+            return status;
+        }
+        if (!region.id_length || region.id_length >= sizeof(region.id) ||
+            !region.logical_length || region.reserved ||
+            (region.region_class != 1 && region.region_class != 2) ||
+            region.scope_mask != 7 ||
+            region.logical_length > UINT64_MAX - logical_bytes ||
+            (index && strcmp((const char *)previous.id,
+                             (const char *)region.id) >= 0)) {
+            return -EINVAL;
+        }
+        logical_bytes += region.logical_length;
+        previous = region;
+    }
+    return logical_bytes == admission->logical_bytes ? 0 : -EINVAL;
+}
+
+/* Native region references retain these mapped bytes for each synchronous read.
+ * These fixtures install no paging source or memory-fault transformation. */
+static int crucible_fixture_read_resident_ram(
+    uint64_t host_address, uint8_t *bytes, uint32_t valid_length)
+{
+    if (!host_address || !bytes || !valid_length) {
+        return -EINVAL;
+    }
+    if (host_address > UINTPTR_MAX ||
+        valid_length - 1 > UINTPTR_MAX - (uintptr_t)host_address) {
+        return -EOVERFLOW;
+    }
+
+    memcpy(bytes, (const void *)(uintptr_t)host_address, valid_length);
+    return 0;
+}
+
+/* The full-root reader lends its private page exclusively for this call.
+ * Copy only the valid bytes and retain no scratch or RAM address afterward. */
+static int crucible_fixture_read_root_scratch(
+    uint64_t host_address,
+    struct qemu_plugin_crucible_ram_root_scratch_v2 *scratch,
+    uint32_t valid_length,
+    const struct qemu_plugin_crucible_ram_page_hasher_v3 *hasher)
+{
+    /* Resident bytes need no external paging authentication. The native
+     * caller hashes the copied scratch independently after this return. */
+    (void)hasher;
+
+    if (!scratch || valid_length > sizeof(scratch->bytes)) {
+        return -EINVAL;
+    }
+    return crucible_fixture_read_resident_ram(
+        host_address, scratch->bytes, valid_length);
+}
+
+/* Resident fixtures provide the full reader, not an incremental candidate.
+ * Refuse diagnostic ownership rather than inventing no-ack close evidence. */
+static int crucible_fixture_observe_root(
+    uint32_t scope, uint64_t owner_token, uint8_t root[32],
+    uint64_t *logical_bytes,
+    struct qemu_plugin_crucible_ram_capture_close_v2 *cleanup)
+{
+    if (owner_token || cleanup) {
+        return -ENOTSUP;
+    }
+    return qemu_plugin_crucible_ram_full_root_v2(scope, 0, root, logical_bytes);
+}
+
+static inline int crucible_fixture_install_resident_ram(void)
+{
+    if (qemu_plugin_crucible_ram_set_metadata_budget_v1(
+            CRUCIBLE_FIXTURE_METADATA_BUDGET) != 0 ||
+        qemu_plugin_crucible_register_ram_admission_v1(
+            crucible_fixture_admit_ram_inventory) != 0 ||
+        qemu_plugin_crucible_register_ram_readers_v3(
+            crucible_fixture_read_resident_ram,
+            crucible_fixture_read_root_scratch) != 0 ||
+        qemu_plugin_crucible_register_ram_root_observer_v2(
+            crucible_fixture_observe_root) != 0) {
+        return -EINVAL;
+    }
+    return 0;
+}
+
+#endif /* CRUCIBLE_TEST_RESIDENT_RAM_H */
