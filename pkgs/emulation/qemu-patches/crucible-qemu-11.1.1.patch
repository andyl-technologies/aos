+/* The actual received alias stays owned by this preexec incarnation. A
+ * steady watcher borrows that role after Setup completion; no old Setup
+ * deadline, descriptor limit or eventfd number grants a new descriptor. */
+int qemu_crucible_preexec_wake_identity_v1(
+    QemuCruciblePreexecPurposeOwner *held, const int *slot, uint64_t event_id,
+    QemuCrucibleProcessContractObservation *observation)
+{
+    QemuCruciblePreexecSetupOwner *owner = &preexec_setup_owner;
+    uint64_t observed;
+    int status;
+
+    if (held != owner ||
+        preexec_setup_syscall5(SYS_getpid, 0, 0, 0, 0, 0) != owner->process_id ||
+        slot != &owner->descriptors[QEMU_CRUCIBLE_PREEXEC_SETUP_WAKE_INDEX] ||
+        !observation) {
+        return -EPERM;
+    }
+    if (!owner->source_published || !owner->descriptor_roster_known ||
+        !owner->frame_validated || !owner->peer_validated ||
+        !owner->plan_validated || !owner->family_corroborated ||
+        !owner->identity_corroborated || !owner->artifact_verified ||
+        !owner->fixed_family.retained || !owner->fixed_family.source.retained ||
+        owner->fixed_family.issuer != owner ||
+        owner->incarnation.assignment != &owner->fixed_family.source ||
+        owner->close_status || !event_id || event_id != owner->wake_event_id) {
+        return -ENOKEY;
+    }
+    /* Canonical slot identity precedes dereferencing its retained alias. */
+    status = preexec_standing_event_observe(*slot, observation, &observed);
+    return status ? status : observed == event_id ? 0 : -ESTALE;
+}
