index 0000000000000000000000000000000000000000..a5b1203638d1e2e556089a5956d346096bc95618
--- /dev/null
+++ b/tests/unit/test-crucible-aio-retirement.c
@@ -0,0 +1,337 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Exercises the actual pool implementation and actual QEMU pthread exit path.
+ * This component test is not a guest or whole-node resource qualification. */
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/main-loop.h"
+#include "qemu/notify.h"
+#include "qemu/thread.h"
+#include "qemu/atomic.h"
+#include "qemu/aiocb.h"
+#include "block/thread-pool.h"
+
+/* Exposes only file-private pool state to assertions; no alternate worker. */
+#include "../../util/thread-pool.c"
+
+static AioContext *home;
+static QemuMutex exit_lock;
+static QemuCond exit_changed;
+static bool exit_entered;
+static bool exit_allowed;
+static bool retirement_returned;
+static int64_t delayed_tid;
+static __thread Notifier exit_notifier;
+static int callbacks;
+
+static bool kernel_has_tid(int64_t tid)
+{
+    char path[64];
+    int length = snprintf(path, sizeof(path), "/proc/self/task/%" PRId64, tid);
+
+    g_assert_cmpint(length, >, 0);
+    g_assert_cmpint(length, <, sizeof(path));
+    return access(path, F_OK) == 0;
+}
+
+static bool registry_has_tid(int64_t tid)
+{
+    QemuThreadHotForkInventory inventory;
+    bool found = false;
+
+    qemu_thread_hot_fork_inventory(&inventory);
+    for (size_t i = 0; i < inventory.entry_count; i++) {
+        found |= inventory.entries[i].thread_id == tid;
+    }
+    qemu_thread_hot_fork_inventory_destroy(&inventory);
+    return found;
+}
+
+static void delay_exit(Notifier *notifier, void *data)
+{
+    (void)notifier;
+    (void)data;
+    qemu_mutex_lock(&exit_lock);
+    delayed_tid = qemu_get_thread_id();
+    exit_entered = true;
+    qemu_cond_broadcast(&exit_changed);
+    while (!exit_allowed) {
+        qemu_cond_wait(&exit_changed, &exit_lock);
+    }
+    qemu_mutex_unlock(&exit_lock);
+}
+
+static int register_delayed_exit(void *opaque)
+{
+    (void)opaque;
+    exit_notifier.notify = delay_exit;
+    qemu_thread_atexit_add(&exit_notifier);
+    return 17;
+}
+
+static int ordinary_work(void *opaque)
+{
+    return *(int *)opaque;
+}
+
+static void completed(void *opaque, int ret)
+{
+    *(int *)opaque = ret;
+    callbacks++;
+}
+
+static void nested_retirement(void *opaque, int ret)
+{
+    ThreadPoolAio *pool = aio_get_thread_pool(home);
+    Error *error = NULL;
+
+    g_assert_cmpint(ret, ==, 17);
+    /* The last completion has already left head, but dispatch still borrows. */
+    g_assert_true(QLIST_EMPTY(&pool->head));
+    g_assert_false(qemu_aio_hot_fork_prepare_thread_pools(&error));
+    g_assert_nonnull(error);
+    g_assert_true(aio_get_thread_pool(home) == pool);
+    error_free(error);
+    *(bool *)opaque = true;
+}
+
+static void *release_delayed_exit(void *opaque)
+{
+    ThreadPoolAio *pool = opaque;
+
+    qemu_mutex_lock(&exit_lock);
+    while (!exit_entered) {
+        qemu_cond_wait(&exit_changed, &exit_lock);
+    }
+    /* Logical zero occurs before this actual atexit callback and unregister. */
+    qemu_mutex_lock(&pool->lock);
+    g_assert_cmpint(pool->cur_threads, ==, 0);
+    qemu_mutex_unlock(&pool->lock);
+    g_assert_true(kernel_has_tid(delayed_tid));
+    g_assert_false(qatomic_read(&retirement_returned));
+    exit_allowed = true;
+    qemu_cond_broadcast(&exit_changed);
+    qemu_mutex_unlock(&exit_lock);
+    return NULL;
+}
+
+typedef struct BlockedWork {
+    QemuMutex lock;
+    QemuCond changed;
+    bool entered;
+    bool released;
+} BlockedWork;
+
+static int blocked_work(void *opaque)
+{
+    BlockedWork *work = opaque;
+
+    qemu_mutex_lock(&work->lock);
+    work->entered = true;
+    qemu_cond_signal(&work->changed);
+    while (!work->released) {
+        qemu_cond_wait(&work->changed, &work->lock);
+    }
+    qemu_mutex_unlock(&work->lock);
+    return 23;
+}
+
+typedef struct FinishWork {
+    ThreadPoolAio *pool;
+    int value;
+} FinishWork;
+
+static int finish_and_exit(void *opaque)
+{
+    FinishWork *work = opaque;
+
+    qemu_mutex_lock(&work->pool->lock);
+    work->pool->max_threads = 0;
+    qemu_mutex_unlock(&work->pool->lock);
+    return work->value;
+}
+
+static void assert_retirement_refused(ThreadPoolAio *pool)
+{
+    Error *error = NULL;
+
+    g_assert_false(qemu_aio_hot_fork_prepare_thread_pools(&error));
+    g_assert_nonnull(error);
+    g_assert_true(aio_get_thread_pool(home) == pool);
+    error_free(error);
+}
+
+static void refuse_actual_work(void)
+{
+    ThreadPoolAio *pool = aio_get_thread_pool(home);
+    BlockedWork work = { 0 };
+    int maximum = home->thread_pool_max;
+    int first_result = -1, second_result = -1;
+    FinishWork second_work = { .pool = pool, .value = 29 };
+    BlockAIOCB *first, *second;
+
+    qemu_mutex_init(&work.lock);
+    qemu_cond_init(&work.changed);
+    home->thread_pool_max = 1;
+    thread_pool_update_params(pool, home);
+    first = thread_pool_submit_aio(blocked_work, &work, completed, &first_result);
+    aio_poll(home, false);
+    qemu_mutex_lock(&work.lock);
+    while (!work.entered) {
+        qemu_cond_wait(&work.changed, &work.lock);
+    }
+    qemu_mutex_unlock(&work.lock);
+    g_assert_cmpint(qatomic_read(&((ThreadPoolElementAio *)first)->state),
+                    ==, THREAD_ACTIVE);
+    assert_retirement_refused(pool);
+
+    second = thread_pool_submit_aio(finish_and_exit, &second_work,
+                                    completed, &second_result);
+    g_assert_cmpint(qatomic_read(&((ThreadPoolElementAio *)second)->state),
+                    ==, THREAD_QUEUED);
+    assert_retirement_refused(pool);
+
+    qemu_mutex_lock(&work.lock);
+    work.released = true;
+    qemu_cond_signal(&work.changed);
+    qemu_mutex_unlock(&work.lock);
+
+    /* The worker exits only after both actual requests finish. Head still owns
+     * their undelivered completions, which must continue to refuse retirement. */
+    qemu_mutex_lock(&pool->lock);
+    while (pool->cur_threads != 0) {
+        qemu_cond_wait(&pool->worker_stopped, &pool->lock);
+    }
+    qemu_mutex_unlock(&pool->lock);
+    g_assert_cmpint(qatomic_read(&((ThreadPoolElementAio *)second)->state),
+                    ==, THREAD_DONE);
+    g_assert_cmpint(callbacks, ==, 0);
+    assert_retirement_refused(pool);
+    while (callbacks != 2) {
+        aio_poll(home, true);
+    }
+    g_assert_cmpint(first_result, ==, 23);
+    g_assert_cmpint(second_result, ==, second_work.value);
+    home->thread_pool_max = maximum;
+    thread_pool_update_params(pool, home);
+    qemu_cond_destroy(&work.changed);
+    qemu_mutex_destroy(&work.lock);
+    callbacks = 0;
+}
+
+static void run_retirement(void)
+{
+    ThreadPoolAio *pool = aio_get_thread_pool(home);
+    QemuThread releaser;
+    Error *error = NULL;
+    bool nested_seen = false;
+    int value = 19;
+    int result = -1;
+    int minimum = home->thread_pool_min;
+    int maximum = home->thread_pool_max;
+
+    refuse_actual_work();
+
+    /* The ordinary absence branch must not acquire the already-held mutex. */
+    qemu_mutex_lock(&pool->lock);
+    g_assert_false(qatomic_read(&pool->finished_workers_pending));
+    thread_pool_join_finished(pool);
+    qemu_mutex_unlock(&pool->lock);
+
+    thread_pool_submit_aio(ordinary_work, &value, completed, &result);
+    while (!callbacks) {
+        aio_poll(home, true);
+    }
+    g_assert_cmpint(result, ==, value);
+
+    value = 17;
+    thread_pool_submit_aio(ordinary_work, &value,
+                           nested_retirement, &nested_seen);
+    while (!nested_seen) {
+        aio_poll(home, true);
+    }
+    g_assert_true(QLIST_EMPTY(&pool->head));
+
+    callbacks = 0;
+    thread_pool_submit_aio(register_delayed_exit, NULL, completed, &result);
+    while (!callbacks) {
+        aio_poll(home, true);
+    }
+    g_assert_cmpint(result, ==, 17);
+
+    qemu_thread_create(&releaser, "exit-proof", release_delayed_exit, pool,
+                       QEMU_THREAD_JOINABLE);
+    g_assert_true(qemu_aio_hot_fork_prepare_thread_pools(&error));
+    qatomic_set(&retirement_returned, true);
+    g_assert_null(error);
+    qemu_thread_join(&releaser);
+    g_assert_false(registry_has_tid(delayed_tid));
+    /* Linux clears the join futex before detaching the exiting task's PID.
+     * Observe actual task removal within the original process alarm. */
+    while (kernel_has_tid(delayed_tid)) {
+        sched_yield();
+    }
+    g_assert_false(kernel_has_tid(delayed_tid));
+    g_assert_cmpint(home->thread_pool_min, ==, minimum);
+    g_assert_cmpint(home->thread_pool_max, ==, maximum);
+
+    /* Later ordinary I/O lazily recreates a real pool with unchanged policy. */
+    callbacks = 0;
+    result = -1;
+    thread_pool_submit_aio(ordinary_work, &value, completed, &result);
+    while (!callbacks) {
+        aio_poll(home, true);
+    }
+    g_assert_cmpint(result, ==, value);
+    g_assert_true(qemu_aio_hot_fork_prepare_thread_pools(&error));
+    g_assert_null(error);
+}
+
+static void reject_nonhome(void)
+{
+    AioContext *other = aio_context_new(&error_abort);
+    ThreadPoolAio *home_pool = aio_get_thread_pool(home);
+    ThreadPoolAio *other_pool = aio_get_thread_pool(other);
+    Error *error = NULL;
+
+    g_assert_false(qemu_aio_hot_fork_prepare_thread_pools(&error));
+    g_assert_nonnull(error);
+    g_assert_true(aio_get_thread_pool(home) == home_pool);
+    g_assert_true(aio_get_thread_pool(other) == other_pool);
+    error_free(error);
+    aio_context_unref(other);
+}
+
+static void *reject_foreign_caller(void *opaque)
+{
+    Error *error = NULL;
+
+    (void)opaque;
+    g_assert_false(qemu_aio_hot_fork_prepare_thread_pools(&error));
+    g_assert_nonnull(error);
+    error_free(error);
+    return NULL;
+}
+
+int main(int argc, char **argv)
+{
+    QemuThread foreign_caller;
+
+    (void)argc;
+    (void)argv;
+    /* One finite fixture process allowance; no per-stage renewal. */
+    alarm(30);
+    qemu_init_main_loop(&error_abort);
+    home = qemu_get_current_aio_context();
+    qemu_mutex_init(&exit_lock);
+    qemu_cond_init(&exit_changed);
+    qemu_thread_create(&foreign_caller, "foreign-proof", reject_foreign_caller,
+                       NULL, QEMU_THREAD_JOINABLE);
+    qemu_thread_join(&foreign_caller);
+    reject_nonhome();
+    run_retirement();
+    qemu_cond_destroy(&exit_changed);
+    qemu_mutex_destroy(&exit_lock);
+    printf("AIO retirement: actual join, late unregister/kernel TID, nested/queued/active/completion/nonmain refusal, lazy recreation PASS; worker-record=%zu pool=%zu\n",
+           sizeof(ThreadPoolWorker), sizeof(ThreadPoolAio));
+    return 0;
+}
