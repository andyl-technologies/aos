+int qemu_crucible_fingerprint_main_execution_returned_current_v1(
+    QemuCrucibleFingerprintMainExecution *execution,
+    QemuCrucibleFingerprintWakeKeeper *keeper,
+    QemuCrucibleFingerprintMainExecution **owner_field);
+int qemu_crucible_fingerprint_main_execution_identity_return_v1(
+    QemuCrucibleFingerprintMainExecution **owner_field);
+
+typedef int (*QemuCrucibleHotForkPrepare)(void *opaque);
+typedef int (*QemuCrucibleHotForkParent)(pid_t child_pid, void *opaque);
+typedef int (*QemuCrucibleHotForkChild)(void *opaque);
+
+/* Failed syscall-only contract application precedes every child RAM access. */
+#define QEMU_CRUCIBLE_HOT_FORK_CHILD_CONTRACT_EXIT 65
+
+/*
+ * Immutable callbacks for one main-loop-owned fork transaction.
+ *
+ * The opaque value and every object reachable through it must be valid in
+ * both process incarnations.  Preparation runs on the source main-loop thread
+ * and must either complete one fork-ready transaction or fail without leaving
+ * partial authority.  The parent callback receives -1 after fork failure and
+ * the positive child PID after success; it runs before the coordinator
+ * retains the child or takes any registered mutex, so it must release the
+ * retained registry transaction first. The child_contract callback applies
+ * and verifies independent kernel limits using host-private syscall state
+ * before pager rebind or any guest RAM access. The child callback runs immediately
+ * after the coordinator wake descriptor is closed and before main-loop work
+ * resumes.  It must arm parent-death containment and authenticate the direct
+ * child before performing any reconstructive or externally visible work.
+ */
+typedef struct QemuCrucibleHotForkMainLoopOperation {
+    uint64_t ram_source_generation;
+    QemuCrucibleHotForkPrepare prepare;
+    QemuCrucibleHotForkParent parent;
+    QemuCrucibleHotForkChild child_contract;
+    QemuCrucibleHotForkChild child;
+    void *opaque;
+    /*
+     * Optional Linux cgroup-v2 placement.  The directory authenticates the
+     * target; the child's first instruction writes itself into the
+     * supervisor-opened cgroup.procs descriptor, which the kernel authorizes
+     * with the opener's credentials, and the parent completes the fork only
+     * after the child has reported that placement.  Production hot-fork
+     * requests always provide both; -1 remains available only to focused
+     * coordinator tests that own no attempt cgroup.
+     */
+    int child_cgroup_fd;
+    int child_cgroup_procs_fd;
+    /* Sticky host cancellation; readable state is never consumed here. */
+    int child_cancellation_fd;
+} QemuCrucibleHotForkMainLoopOperation;
+
+typedef enum QemuCrucibleHotForkChildProcessPhase {
+    QEMU_CRUCIBLE_HOT_FORK_CHILD_RUNNING,
+    QEMU_CRUCIBLE_HOT_FORK_CHILD_EXITED,
+    QEMU_CRUCIBLE_HOT_FORK_CHILD_SIGNALED,
+} QemuCrucibleHotForkChildProcessPhase;
+
+typedef struct QemuCrucibleHotForkChildProcessState {
+    uint64_t generation;
+    pid_t process_id;
+    QemuCrucibleHotForkChildProcessPhase phase;
+    int status;
+    bool retained;
+} QemuCrucibleHotForkChildProcessState;
+
+typedef enum QemuCrucibleHotForkChildProcessAction {
+    QEMU_CRUCIBLE_HOT_FORK_CHILD_PROCESS_QUERY,
+    QEMU_CRUCIBLE_HOT_FORK_CHILD_PROCESS_RELEASE,
+} QemuCrucibleHotForkChildProcessAction;
+
+/* Install the single system-emulator coordinator on the main-loop thread. */
+void qemu_crucible_hot_fork_main_loop_coordinator_init(Error **errp);
+
+/* Rebind only after inherited registered locks have been reconstructed. */
+int qemu_crucible_hot_fork_main_loop_coordinator_rebind_child(void);
+
+/* Publish readiness only after the fresh notifier passed descriptor disposition. */
+int qemu_crucible_hot_fork_main_loop_coordinator_child_ready(void);
+
+/*
+ * Submit one exact operation from a non-main-loop thread and wait for its
+ * parent disposition.  A successful result returns the positive direct-child
+ * PID.  An error after fork also returns that positive PID so the operation
+ * owner can retain or quarantine its direct-child authority.  The child never
+ * returns through this caller's copied stack.
+ */
+int qemu_crucible_hot_fork_main_loop_fork(
+    const QemuCrucibleHotForkMainLoopOperation *operation,
+    uint64_t child_process_contract_generation,
+    pid_t *child_pid);
+
+/* Validate the QMP schema before querying or releasing any retained record. */
+int qemu_crucible_hot_fork_child_process_operate(
+    bool has_schema_version, uint32_t schema_version,
+    QemuCrucibleHotForkChildProcessAction action, uint64_t generation,
+    QemuCrucibleHotForkChildProcessState *state);
+
+/*
+ * Observes or releases one exact parent-owned fork-child reap record.  Each
+ * call performs at most one nonblocking waitpid operation while the child is
+ * running.  Query remains valid after final status is retained, and release
+ * succeeds only after the child has been reaped.
+ */
+int qemu_crucible_hot_fork_child_process_query(
+    uint64_t generation, QemuCrucibleHotForkChildProcessState *state);
+int qemu_crucible_hot_fork_child_process_release(
+    uint64_t generation, QemuCrucibleHotForkChildProcessState *state);
+
+#endif
