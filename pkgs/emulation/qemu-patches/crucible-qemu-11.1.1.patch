+#if defined(CONFIG_LINUX) && defined(__x86_64__) && !defined(__ILP32__)
+static void startup_preexec_copy(void *destination, const void *source,
+                                 size_t bytes)
+{
+    volatile uint8_t *out = destination;
+    const volatile uint8_t *in = source;
+
+    for (size_t index = 0; index < bytes; index++) {
+        out[index] = in[index];
