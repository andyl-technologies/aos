+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Exercise retained control intent when native pause reasserts CPU stop.
+
+Native pause, CPU stop/event processing, RR drain/park, wake reader and control
+ownership bodies execute here. CPU topology, empty work queues, host dispatch,
+replay, device authorities and explicit resume are bounded providers. Eventfd
+I/O is real; no linked guest, physical fork or full RR outer loop is executed.
+"""
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import runpy
+import shlex
+import subprocess
+
+
+ROOT = Path(__file__).resolve().parents[2]
+SUPPORT = runpy.run_path(str(Path(__file__).with_name(
+    "test-crucible-control-deferred.py")))
+definition = SUPPORT["definition"]
+NETWORK = SUPPORT["SUPPORT"]
+
+QOM_OBJECT_HEADER_SHA256 = (
+    "089f13e70e9840c38bb6e414de4c615738cf39f8b221d93de9670cee52ce2a58"
+)
+
+# These additional stopped-RR endpoints are bounded component providers;
+# genuine QOM/thread support retains its own independently linked symbols.
+COMPONENT_NAMESPACE = r"""
+#define qemu_cond_wait_impl stopped_control_component_qemu_cond_wait_impl
+#define qemu_cond_wait_func stopped_control_component_qemu_cond_wait_func
+#define qemu_clock_enable stopped_control_component_qemu_clock_enable
+#define process_queued_cpu_work stopped_control_component_process_queued_cpu_work
+#define cpu_work_list_empty stopped_control_component_cpu_work_list_empty
+"""
+
+EXTRA = r"""
+#include <sys/eventfd.h>
+QemuMutex bql;
+static QemuCond qemu_pause_cond;
+static unsigned int empty_pause_waits;
+static unsigned int expected_control_calls;
+void pause_all_vcpus(void);
+static void rr_crucible_sim_drain_vcpu_work(void);
+static bool rr_crucible_sim_stop_or_unplug_pending(void);
+static bool rr_crucible_sim_vcpu_work_pending(void);
+void qemu_cond_timedwait_bql(QemuCond *condition, int milliseconds);
+void qemu_clock_enable(QEMUClockType clock, bool enabled)
+{ g_assert_false(enabled); }
+void qemu_cond_wait_impl(QemuCond *condition, QemuMutex *mutex,
+                           const char *file, int line)
+{ empty_pause_waits++; g_assert_not_reached(); }
+void process_queued_cpu_work(CPUState *target) { }
+bool cpu_work_list_empty(CPUState *target) { return true; }
+"""
+
+CHECKS = r"""
+static void count_control(unsigned int index, uint64_t coordinate, void *userdata)
+{
+    g_assert_cmpuint(coordinate, ==, 2);
+    g_assert_true(locked);
+    g_assert_false(cpu.stop);
+    g_assert_true(cpu.stopped);
+    g_assert_true(qemu_plugin_crucible_vmstop_quiesced());
+    control_calls++;
+}
+
+void qemu_cond_timedwait_bql(QemuCond *condition, int milliseconds)
+{
+    CPUState *rr_owner = current_cpu;
+
+    waits++;
+    g_assert_cmpuint(waits, <=, 3);
+    g_assert_false(cpu.stop);
+    g_assert_true(cpu.stopped);
+    g_assert_cmpuint(raw_icount, ==, 2);
+    g_assert_cmpint(qemu_plugin_time_advance_pending, ==, 0);
+    g_assert_true(qemu_plugin_crucible_vmstop_quiesced());
+    current_cpu = NULL;
+    service_events();
+    g_assert_cmpuint(control_calls, ==, expected_control_calls);
+    g_assert_false(qemu_plugin_crucible_control_boundary_outstanding());
+    g_assert_cmpuint(qemu_plugin_control_boundary_schedule_sequence, ==,
+                     expected_control_calls);
+    if (waits == 3) {
+        /* A modeled explicit resume is issued only after stopped host passes. */
+        qemu_plugin_crucible_vmstop_request_complete();
+        cpu.stop = cpu.stopped = false;
+    }
+    current_cpu = rr_owner;
+}
+
+int main(int argc, char **argv)
+{
+    bool admitted_reader = argc == 2 && strcmp(argv[1], "admitted-reader") == 0;
+    bool no_request = argc == 2 && strcmp(argv[1], "no-request") == 0;
+    uint64_t stop_generation;
+    int wake;
+
+    reset();
+    expected_control_calls = no_request ? 0 : 1;
+    raw_icount = timers_state.qemu_icount = 2;
+    cpu.stop = cpu.stopped = false;
+    current_cpu = &cpu;
+    qemu_plugin_control_boundary_cb = count_control;
+    qemu_plugin_crucible_exact_boundary_enter();
+    g_assert_cmpint(qemu_plugin_request_vmstop(), ==, 0);
+    qemu_plugin_crucible_exact_boundary_leave();
+    g_assert_true(cpu.stop);
+    rr_crucible_sim_drain_vcpu_work();
+    g_assert_false(cpu.stop);
+    g_assert_true(cpu.stopped);
+
+    wake = eventfd(0, EFD_NONBLOCK | EFD_CLOEXEC);
+    g_assert_cmpint(wake, >=, 0);
+    if (admitted_reader) {
+        /* The reader sees admission before the main loop publishes pause. */
+        current_cpu = NULL;
+        g_assert_cmpint(eventfd_write(wake, 1), ==, 0);
+        qemu_plugin_wake_fd_read((void *)(intptr_t)wake);
+        g_assert_false(qemu_plugin_control_boundary_deferred);
+        g_assert_true(qemu_plugin_crucible_rr_control_boundary_pending());
+        g_assert_cmpuint(qemu_plugin_rr_control_request_generation, ==, 1);
+        g_assert_cmpuint(qemu_plugin_rr_control_ack_generation, ==, 0);
+        g_assert_cmpuint(qemu_plugin_rr_control_complete_generation, ==, 0);
+    }
+
+    /* Real main-loop pause reasserts stop despite the earlier acknowledgment. */
+    current_cpu = NULL;
+    g_assert_cmpint(do_vm_stop(RUN_STATE_PAUSED, true), ==, 0);
+    g_assert_true(cpu.stop);
+    g_assert_true(cpu.stopped);
+    g_assert_cmpuint(empty_pause_waits, ==, 0);
+    g_assert_true(qemu_plugin_crucible_vmstop_quiesced());
+    stop_generation = qemu_plugin_crucible_vmstop_generation_value;
+
+    if (!admitted_reader && !no_request) {
+        g_assert_cmpint(eventfd_write(wake, 1), ==, 0);
+        qemu_plugin_wake_fd_read((void *)(intptr_t)wake);
+        g_assert_true(qemu_plugin_control_boundary_deferred);
+    }
+    g_assert_cmpint(close(wake), ==, 0);
+    g_assert_cmpuint(qemu_plugin_control_boundary_scheduled, ==, 0);
+    g_assert_cmpint(qemu_plugin_crucible_control_boundary_outstanding(), ==,
+                    !no_request);
+    if (!no_request) {
+        g_assert_false(crucible_hot_fork_exact_paused_boundary());
+        g_assert_cmpint(qemu_plugin_crucible_vmstop_cold_begin(), ==, -EBUSY);
+        g_assert_cmpuint(qemu_plugin_crucible_vmstop_generation_value, ==,
+                         stop_generation);
+    }
+    service_events();
+    g_assert_cmpuint(control_calls, ==, 0);
+
+    /* The genuine RR park must rearm at the stop-request clearing edge. */
+    current_cpu = &cpu;
+    rr_crucible_sim_park_vmstop();
+    g_assert_cmpuint(waits, ==, 3);
+    g_assert_cmpuint(control_calls, ==, expected_control_calls);
+    g_assert_cmpuint(resumes, ==, 1);
+    g_assert_cmpuint(qemu_plugin_rr_control_request_generation, ==,
+                     admitted_reader ? 1 : 0);
+    g_assert_cmpuint(qemu_plugin_rr_control_ack_generation, ==,
+                     admitted_reader ? 1 : 0);
+    g_assert_cmpuint(qemu_plugin_rr_control_complete_generation, ==,
+                     admitted_reader ? 1 : 0);
+    g_assert_cmpuint(raw_icount, ==, 2);
+    g_assert_cmpuint(qemu_plugin_crucible_vmstop_generation_value, ==,
+                     stop_generation);
+    puts("PASS native stop reassertion, retained intent, RR drain edge, explicit resume");
+    return 0;
+}
+"""
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--output-dir", type=Path, required=True)
+    parser.add_argument("--negative-control", action="store_true")
+    parser.add_argument("--negative-transfer", action="store_true")
+    arguments = parser.parse_args()
+    production_sources = SUPPORT["validated_sources"]()
+    qom_header = (ROOT / "include/qom/object.h").read_bytes()
+    if hashlib.sha256(qom_header).hexdigest() != QOM_OBJECT_HEADER_SHA256:
+        raise SystemExit("include/qom/object.h source hash mismatch")
+    # Use the real declaration without importing component model types.
+    qom_declaration = NETWORK["SUPPORT"]["EXTRACT"]["unique_line"](
+        qom_header.decode("utf-8"), "void object_unref(void *obj);")
+    arguments.output_dir.mkdir(parents=True, exist_ok=True)
+    prelude = NETWORK["fixture_prelude"]()
+    for signature in [
+        "void pause_all_vcpus(void)",
+        "static bool rr_crucible_sim_stop_or_unplug_pending(void)",
+        "static bool rr_crucible_sim_vcpu_work_pending(void)",
+        "static void rr_crucible_sim_drain_vcpu_work(void)",
+        "void qemu_cond_timedwait_bql(",
+    ]:
+        prelude = prelude.replace(definition(prelude, signature), "")
+    prelude = prelude.replace(
+        "/* Model the CPU stop acknowledgment before pause_all_vcpus returns. */", "")
+    prelude = prelude.replace("return self;", "return current_cpu == target;")
+    bodies = SUPPORT["production_bodies"](production_sources)
+    bodies += "\n\n" + definition((ROOT / "plugins/api-system.c").read_text(),
+                                 "void qemu_plugin_crucible_rr_control_boundary_rearm(void)")
+    cpus = (ROOT / "system/cpus.c").read_text()
+    bodies += "\n\n" + "\n\n".join(definition(cpus, signature) for signature in [
+        "static void qemu_cpu_stop(CPUState *cpu, bool exit)",
+        "void qemu_process_cpu_events_common(CPUState *cpu)",
+        "void cpu_pause(CPUState *cpu)",
+        "static bool all_vcpus_paused(void)",
+        "void pause_all_vcpus(void)",
+    ])
+    rr = (ROOT / "accel/tcg/tcg-accel-ops-rr.c").read_text()
+    bodies += "\n\n" + "\n\n".join(definition(rr, signature) for signature in [
+        "static bool rr_crucible_sim_mode(void)\n{",
+        "static bool rr_crucible_sim_stop_or_unplug_pending(void)\n{",
+        "static void rr_crucible_sim_process_vcpu_events(CPUState *cpu)",
+        "static bool rr_crucible_sim_vcpu_work_pending(void)\n{",
+        "static void rr_crucible_sim_drain_vcpu_work(void)\n{",
+        "static void rr_crucible_sim_park_vmstop(void)",
+    ])
+    if arguments.negative_control:
+        statement = "            qemu_plugin_crucible_rr_control_boundary_rearm();\n"
+        assert bodies.count(statement) == 1
+        bodies = bodies.replace(statement, "")
+    if arguments.negative_transfer:
+        transfer = """        if (qemu_plugin_crucible_rr_control_boundary_pending()) {
+            /* A reader during admission still names the running RR owner. */
+            qemu_plugin_crucible_rr_control_boundary_defer();
+        } else {
+            qemu_plugin_rearm_deferred_control_boundary();
+        }
+"""
+        assert bodies.count(transfer) == 1
+        bodies = bodies.replace(
+            transfer, "        qemu_plugin_rearm_deferred_control_boundary();\n")
+    support = NETWORK["TESTS"].split("int main(void)")[0]
+    generated = arguments.output_dir / "stopped-control-rearm.c"
+    wait_dispatch = NETWORK["SUPPORT"]["EXTRACT"]["unique_line"](
+        (ROOT / "util/qsp.c").read_text(),
+        "QemuCondWaitFunc qemu_cond_wait_func = qemu_cond_wait_impl;")
+    generated.write_text(SUPPORT["COMPONENT_NAMESPACE"] + COMPONENT_NAMESPACE +
+                         prelude + SUPPORT["EXTRA"] + EXTRA + wait_dispatch +
+                         qom_declaration + "\n\n" + bodies + support + CHECKS)
+    # Retain the component object for the owning runner's symbol audit.
+    component = arguments.output_dir / "stopped-control-rearm.o"
+    binary = arguments.output_dir / "stopped-control-rearm"
+    compile_prefix = [os.environ.get("CC", "cc"),
+                      *shlex.split(os.environ.get("CFLAGS", "")),
+                      "-Wno-missing-prototypes", "-Wno-unused-function",
+                      "-Wno-unused-variable"]
+    component_command = [*compile_prefix, "-c", str(generated), "-o", str(component)]
+    command = [*compile_prefix,
+               str(component), *NETWORK["SUPPORT"]["native_link_arguments"](), "-o", str(binary),
+               *shlex.split(os.environ.get("LDFLAGS", ""))]
+    (arguments.output_dir / "component-compile-command.json").write_text(
+        json.dumps(component_command, indent=2) + "\n")
+    (arguments.output_dir / "compile-command.json").write_text(
+        json.dumps(command, indent=2) + "\n")
+    subprocess.run(component_command, check=True)
+    subprocess.run(command, check=True)
+    for case in ["stopped-reader", "admitted-reader", "no-request"]:
+        print(f"case={case}", flush=True)
+        subprocess.run([str(binary), case], cwd=arguments.output_dir, check=True)
+
+
+if __name__ == "__main__":
+    main()
