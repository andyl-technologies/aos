+#define HPPA_INTERVAL_PERIOD_PS (4 * PICOSECONDS_PER_NANOSECOND)
+#define HPPA_INTERVAL_MIN_DELAY_PS (1000 * PICOSECONDS_PER_NANOSECOND)
+
+static __int128 hppa_interval_ticks_ps(__int128 now_ps)
+{
+    __int128 ticks = now_ps / HPPA_INTERVAL_PERIOD_PS;
+
+    if (now_ps < 0 && now_ps % HPPA_INTERVAL_PERIOD_PS) {
+        ticks--;
+    }
+    return ticks;
+}
+
+uint64_t hppa_interval_timer_read(void)
+{
+    if (qemu_timer_tcg_ps_enabled()) {
+        return hppa_interval_ticks_ps(
+            qemu_clock_get_ps_wide(QEMU_CLOCK_VIRTUAL));
+    }
+    return qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) >> 2;
+}
+
+static bool hppa_interval_deadline_ps(__int128 now_ps, uint32_t value,
+                                      __int128 *deadline_ps)
+{
+    __int128 current_ticks = hppa_interval_ticks_ps(now_ps);
+    int64_t phase_ps = now_ps % HPPA_INTERVAL_PERIOD_PS;
+    uint32_t remaining_ticks = value - (uint32_t)current_ticks;
+    int64_t delay_ps;
+
+    if (phase_ps < 0) {
+        phase_ps += HPPA_INTERVAL_PERIOD_PS;
+    }
+
+    /*
+     * The comparator wraps at 32 bits. Compute its bounded distance before
+     * adding the absolute epoch: the preceding epoch can lie below INT128_MIN
+     * even when the next comparator deadline is representable.
+     */
+    delay_ps = (int64_t)remaining_ticks * HPPA_INTERVAL_PERIOD_PS - phase_ps;
+    if (delay_ps < HPPA_INTERVAL_MIN_DELAY_PS) {
+        delay_ps += (INT64_C(1) << 32) * HPPA_INTERVAL_PERIOD_PS;
+    }
+    return !__builtin_add_overflow(now_ps, (__int128)delay_ps, deadline_ps);
+}
