+static int ram_control_pause_end_v2(QemuCrucibleRamActorPause *pause,
+                                    QemuRamPauseEndDisposition *out)
+{
+    QemuCrucibleRamControlActor *actor = &startup_source.ram_control_actor;
+    QemuRamPauseEndDisposition *end;
+    int status;
+
+    if (!out || !pause ||
+        callback_child_output_overlap(out, sizeof(*out), &startup_source,
+                                      sizeof(startup_source)) ||
+        (pause != &actor->pause && pause != &actor->request_pause) ||
+        pause->actor != actor || pause->process != getpid() ||
+        pause->owner_thread != qemu_get_thread_id()) {
+        return -EPERM;
+    }
+    end = &pause->end;
+    if (end->released || end->uncertain) {
+        *out = *end;
+        return end->last_status;
+    }
+    if (end->attempts == UINT64_MAX) {
+        return -EOVERFLOW;
+    }
+    end->attempts++;
+    end->entered = true;
+    status = pthread_mutex_trylock(&actor->dispatch_mutex);
+    end->effect_status = status ? -status : 0;
+    if (!status) {
+        qatomic_store_release(&pause->requested, false);
+        qatomic_store_release(&pause->held, false);
+        end->released = true;
+        /* Real gate release precedes independent notification/unlock posts. */
+        end->notify_entered = true;
+        end->notify_status = -pthread_cond_broadcast(&actor->dispatch_condition);
+        end->notify_returned = true;
+        end->unlock_status = -pthread_mutex_unlock(&actor->dispatch_mutex);
+    }
+    end->uncertain = end->notify_status || end->unlock_status;
+    end->complete = end->released && !end->uncertain;
+    end->last_status = end->effect_status ? end->effect_status :
+        end->notify_status ? end->notify_status : end->unlock_status;
+    if (!end->first_status) {
+        end->first_status = end->last_status;
+    }
+    *out = *end;
+    return end->last_status;
+}
+
+int qemu_plugin_crucible_ram_actor_pause_end_v2(
+    QemuCrucibleRamActorPause *pause, QemuRamPauseEndDisposition *out)
+{
+    return pause != &startup_source.ram_control_actor.pause ? -EPERM :
+        ram_control_pause_end_v2(pause, out);
+}
+
+int qemu_plugin_crucible_ram_actor_request_receipt_return(
+    QemuCrucibleCheckpointRequestLoan *request, QemuCrucibleRamControlActor *actor,
+    QemuCrucibleRamActorPause *pause)
+{
+    QemuCrucibleRamControlReceive *receipt;
+    int status;
+
+    if (!request || actor != &startup_source.ram_control_actor ||
+        pause != &actor->request_pause || pause->request != request) {
+        return -EPERM;
+    }
+    receipt = &actor->receipt;
+    /* This callee proves the actual pending-to-request loan and completed
+     * provider/alias cleanup. It runs outside ActorMutex and all callbacks. */
+    status = qemu_crucible_checkpoint_request_receipt_return_current_v1(
+        request, actor, receipt);
+    if (status) {
+        return status;
+    }
+    status = pthread_mutex_trylock(&actor->dispatch_mutex);
+    if (status) {
+        return -status;
+    }
+    status = qemu_plugin_crucible_ram_actor_pause_current(pause);
+    if (status || pause->request != request || actor->record_in_flight ||
+        receipt->uncertain) {
+        status = status ? status : -EINPROGRESS;
+        goto out;
+    }
+    for (size_t index = 0; index < G_N_ELEMENTS(receipt->aliases); index++) {
+        if (receipt->aliases[index] != -1) {
+            status = -EINPROGRESS;
+            goto out;
+        }
+    }
+    if (pause->receipt_returned) {
+        status = !receipt->active && !receipt->moved &&
+            !receipt->frame_bytes && !receipt->frame_extent &&
+            !receipt->alias_count && !receipt->first_alias ? 0 : -ESTALE;
+        goto out;
+    }
+    if (!receipt->active || !receipt->moved || !receipt->first_alias ||
+        receipt->frame_extent != 242 || receipt->frame_bytes != 242 ||
+        receipt->alias_count != 1) {
+        status = -ESTALE;
+        goto out;
+    }
+    /* Actual dispatch borrowers and every alias owner have returned. This
+     * returns the fixed bank, not the request, pause or any capacity credit. */
+    receipt->active = false;
+    receipt->moved = false;
+    receipt->frame_bytes = 0;
+    receipt->frame_extent = 0;
+    receipt->alias_count = 0;
+    receipt->first_alias = false;
+    memset(receipt->close_attempted, 0, sizeof(receipt->close_attempted));
+    qatomic_store_release(&actor->idle, false);
+    pause->receipt_returned = true;
+    receipt->record.physical_bank_returned = true;
+    status = 0;
+out:
+    {
+        int post = pthread_mutex_unlock(&actor->dispatch_mutex);
+
+        if (post) {
+            ram_control_failure(actor, -post, true);
+            return status ? status : -post;
+        }
+    }
+    if (!status && receipt->record.held) {
+        status = ram_control_record_release(actor);
+    }
+    return status;
+}
+
+int qemu_plugin_crucible_ram_actor_request_pause_end_v2(
+    QemuCrucibleCheckpointRequestLoan *request, QemuCrucibleRamControlActor *actor,
+    QemuCrucibleRamActorPause *pause, QemuRamPauseEndDisposition *out)
+{
+    int status;
+
+    if (!request || actor != &startup_source.ram_control_actor ||
+        pause != &actor->request_pause || pause->request != request ||
+        !pause->receipt_returned) {
+        return -EPERM;
+    }
+    /* Receiving authenticates the same retained request outside every lock or
+     * callback, after its real provider/alias cleanup and terminal journal. */
+    status = qemu_crucible_checkpoint_request_actor_current_v1(request, actor);
+    return status ? status : ram_control_pause_end_v2(pause, out);
+}
+#else
+/* Non-Linux selected actor APIs remain unsupported; generic QEMU is unchanged. */
+int qemu_plugin_crucible_ram_actor_request_receipt_return(
+    QemuCrucibleCheckpointRequestLoan *request, QemuCrucibleRamControlActor *actor,
+    QemuCrucibleRamActorPause *pause)
+{
+    return -ENOTSUP;
+}
+
+int qemu_plugin_crucible_checkpoint_pending_adopt_v1(
+    qemu_plugin_id_t id, qemu_plugin_crucible_ram_control_actor_v1 *actor,
+    qemu_plugin_crucible_ram_control_receive_v1 *receipt,
+    const uint8_t original[80], const uint8_t digest[32],
+    uint64_t *request_generation)
+{
+    return -ENOTSUP;
+}
+
+int qemu_plugin_crucible_ram_control_receive_begin_v1(
+    qemu_plugin_id_t id, qemu_plugin_crucible_ram_control_actor_v1 *actor,
+    struct qemu_plugin_crucible_ram_control_receive_borrow_v1 *out)
+{
+    return -ENOTSUP;
+}
+
+int qemu_plugin_crucible_ram_control_receive_read_v1(
+    qemu_plugin_id_t id, qemu_plugin_crucible_ram_control_actor_v1 *actor,
+    qemu_plugin_crucible_ram_control_receive_v1 *receipt, size_t maximum_bytes,
+    size_t *received)
+{
+    return -ENOTSUP;
+}
+
+int qemu_plugin_crucible_ram_control_receive_dispose_v1(
+    qemu_plugin_id_t id, qemu_plugin_crucible_ram_control_actor_v1 *actor,
+    qemu_plugin_crucible_ram_control_receive_v1 *receipt, int status)
+{
+    return -ENOTSUP;
+}
+
+int qemu_plugin_crucible_ram_control_record_return_v1(
+    qemu_plugin_id_t id, qemu_plugin_crucible_ram_control_actor_v1 *actor,
+    qemu_plugin_crucible_ram_control_receive_v1 *receipt, int status)
+{
+    return -ENOTSUP;
+}
+
+int qemu_plugin_crucible_ram_actor_registration_current(
+    void *actor, uint64_t *generation, uint64_t *thread_id)
+{
+    return -ENOTSUP;
+}
+
+int qemu_plugin_crucible_ram_actor_pause_begin(QemuCrucibleRamActorPause **out)
+{
+    return -ENOTSUP;
+}
+
+int qemu_plugin_crucible_ram_actor_pause_begin_inventory(
+    QemuCrucibleRamActorPause **out)
+{
+    return -ENOTSUP;
+}
+
+int qemu_plugin_crucible_ram_actor_request_pause_begin(
+    QemuCrucibleCheckpointRequestLoan *request, QemuCrucibleRamControlActor *actor,
+    QemuCrucibleRamActorPause **out)
+{
+    return -ENOTSUP;
+}
+
+int qemu_plugin_crucible_ram_actor_pause_current(QemuCrucibleRamActorPause *pause)
+{
+    return -ENOTSUP;
+}
+
+QemuThreadRamActorBinding *qemu_plugin_crucible_ram_actor_pause_binding(
+    QemuCrucibleRamActorPause *pause)
