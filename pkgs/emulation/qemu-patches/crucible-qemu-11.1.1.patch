+int monitor_qmp_main_dispatch_enter(Monitor *mon)
+{
+    QMPRequest *request = qmp_dispatcher_current_request;
+
+    if (!mon || !qemu_in_main_thread() || !bql_locked() || qemu_in_coroutine()) {
+        return -EPERM;
+    }
+    if (!mon->crucible_purpose) {
+        return 0;
+    }
+    if (qmp_main_dispatch_request || !request ||
+        &request->mon->parent_obj != mon || !request->allocation_owner) {
+        return -EPERM;
+    }
+    if (!request->main_borrow) {
+        int status = qemu_crucible_qmp_owner_borrow(request->allocation_owner,
+                                                 &request->main_borrow);
+        if (status) {
+            return status;
+        }
+    }
+    qmp_main_dispatch_request = request;
+    request->dispatch_borrow = request->main_borrow;
+    qemu_thread_get_self(&request->dispatch_thread);
+    request->dispatch_status = qemu_crucible_qmp_dispatch_scope_enter(
+        request->dispatch_borrow, &request->dispatch_scope);
+    if (request->dispatch_status) {
+        /* Source can publish a real held context before its post fails. Return
+         * that context here, on the issuing Main thread, before dropping the
+         * native keeper. Admission first and mandatory return are independent. */
+        if (request->dispatch_scope) {
+            request->dispatch_post_status = qemu_crucible_qmp_scope_end(
+                &request->dispatch_scope);
+            if (request->dispatch_post_status) {
+                request->mon->crucible_parser_post_status =
+                    request->dispatch_post_status;
+                return request->dispatch_status;
+            }
+        }
+        qmp_main_dispatch_request = NULL;
+        request->dispatch_borrow = NULL;
+    }
+    return request->dispatch_status;
+}
