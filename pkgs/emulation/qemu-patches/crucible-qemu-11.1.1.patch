+/* Pin publication retains the immutable region descriptors and every planned
+ * pageable source until process reap, including the registration window before
+ * the first destructive eviction. Resident/pinned regions are not managed here.
+ */
+bool qemu_crucible_ram_discard_conflicts(RAMBlock *block, uint64_t offset,
+                                        size_t length)
+{
+    if (!length || !qatomic_load_acquire(&paging_topology_pinned)) {
+        return false;
+    }
+    if (!admission_regions) {
+        /* Incomplete retained ownership never authorizes a raw destructive effect. */
+        return true;
+    }
+    for (size_t index = 0; index < admission_regions->len; index++) {
+        const CrucibleRamRegion *region = region_inventory_index(admission_regions,
+                                                          index);
+
+        if (region->block == block) {
+            return (region->arena_flags & QEMU_PLUGIN_CRUCIBLE_RAM_ARENA_PAGEABLE) &&
+                offset < region->descriptor.logical_length;
+        }
+    }
+    return false;
+}
