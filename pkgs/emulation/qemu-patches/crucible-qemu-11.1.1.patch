+     * The inherited GMainContext records the vanished thread as its owner,
+     * and GLib lets no other thread acquire it: the replacement's push of
+     * the thread-default context fails and its main loop waits forever for
+     * a release that cannot come.  Build a fresh context and loop and move
+     * the AioContext's GSource across.  The source's context link is part
+     * of GLib's public, embedded GSource layout; clearing it lets the
+     * attach take the source, with its poll descriptors, into the fresh
+     * context.  The dead copy of the old context keeps a stale entry for
+     * the source and is abandoned rather than unreferenced, since releasing
+     * it would touch the owner that no longer exists.
+     */
+    replacement_context = g_main_context_new();
+    source = aio_get_g_source(iothread->ctx);
+    source->context = NULL;
+    g_source_attach(source, replacement_context);
+    g_source_unref(source);
+    iothread->worker_context = replacement_context;
+    iothread->main_loop = g_main_loop_new(replacement_context, TRUE);
+
+    /*
+     * No caller uses the initialization semaphore after IOThread creation
+     * returns.  Recreate it rather than inheriting any implementation-private
+     * generation; the admitted fork boundary proves that it has no waiter.
+     */
+    qemu_sem_destroy(&iothread->init_done_sem);
+    qemu_sem_init(&iothread->init_done_sem, 0);
+    iothread->thread_id = -1;
+    thread_name = g_strdup_printf("IO %s",
+                                  object_get_canonical_path_component(
+                                      OBJECT(iothread)));
+    qemu_thread_create(&iothread->thread, thread_name, iothread_run,
+                       iothread, QEMU_THREAD_JOINABLE);
+    /*
+     * The replacement announces itself within its first instructions; a
+     * bounded wait turns a thread that never does into a named child failure
+     * instead of a silent hang, and its recorded progress survives.
+     */
+    if (qemu_sem_timedwait(&iothread->init_done_sem,
+                           IOTHREAD_HOT_FORK_CHILD_START_TIMEOUT_MS) != 0) {
+        if (qemu_crucible_hot_fork_child_detail() <
+            IOTHREAD_HOT_FORK_CHILD_START_DETAIL) {
+            qemu_crucible_hot_fork_note_child_detail(
+                IOTHREAD_HOT_FORK_CHILD_START_DETAIL - 1);
+        }
