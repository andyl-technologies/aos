+}
+
+int object_native_cpu_tlb_request_end(QemuCrucibleCpuTlbStorageRequest *request)
+{
+    int status;
+
+    pthread_mutex_lock(&native_allocations.lock);
+    status = object_native_observer_identity_locked();
+    if (!status && (request != &native_allocations.tlb_request ||
+                    !native_allocations.tlb_request_held)) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        native_allocations.tlb_request_held = false;
+        native_allocations.tlb_parent = NULL;
+        native_allocations.tlb_serial = 0;
+    }
+    pthread_mutex_unlock(&native_allocations.lock);
+    return status;
+}
+
+static void object_native_allocation_abandon(
+    QemuCrucibleCpuAllocationRequest *request)
+{
+    pthread_mutex_lock(&native_allocations.lock);
+    if (!object_native_observer_identity_locked() &&
+        request == &native_allocations.request &&
+        request->phase == OBJECT_NATIVE_ALLOCATION_BEFORE &&
+        (!request->receipt || !request->receipt->allocation_started)) {
+        /* Only this real pre-effect branch certifies that no allocator ran.
+         * A null payload after an ambiguous allocator never grants return. */
+        if (request->receipt) {
+            request->receipt->allocation_abandoned = true;
+        }
+        /* A refused issuer may have returned no receipt at all. This native
+         * request still owns its exact pre-effect return; any Source header
+         * whose storage was not borrowed remains independently retained. */
+        request->phase = OBJECT_NATIVE_ALLOCATION_IDLE;
+    }
+    pthread_mutex_unlock(&native_allocations.lock);
+}
+
+static void object_native_paid_qemu_vfree(void *payload);
+
+static void *object_native_allocate_for_parent(
+    TypeImpl *type, Object *parent, ObjectNativeAllocationKind kind, bool clear,
+    void (**free_payload)(void *))
+{
+    QemuCrucibleCpuAllocationRequest *request = &native_allocations.request;
+    ObjectNativeAllocationObserver *observer = &native_allocations.observer;
+    const ObjectNativeAllocationOps *ops = NULL;
+    void *userdata = NULL;
+    void *payload;
+    size_t bytes;
+    size_t alignment;
+    int status = 0;
+
