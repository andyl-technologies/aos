diff --git a/tests/tcg/x86_64/system/self-modifying-code.c b/tests/tcg/x86_64/system/self-modifying-code.c
new file mode 100644
index 0000000000000000000000000000000000000000..7a1f9001f3dcbbbd1f1a4678973b1f791210ff13
--- /dev/null
+++ b/tests/tcg/x86_64/system/self-modifying-code.c
@@ -0,0 +1,229 @@
+/*
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Exercise system-mode code invalidation through guest writes. Boundary
+ * instructions cover both tagged page lists; a temporary mapping reverses
+ * their physical order. The boot support identity-maps the backing pages.
+ */
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <minilib.h>
+
+#define PAGE_SIZE 4096
+#define ADDRESS_MASK UINT64_C(0x000ffffffffff000)
+#define TEST_MAPPING UINT64_C(0x40000000)
+#define SECOND_PAGE_COUNT 5
+
+static uint8_t code_pages[2 * PAGE_SIZE]
+    __attribute__((aligned(PAGE_SIZE)));
+
+static uint64_t test_page_table[512]
+    __attribute__((aligned(PAGE_SIZE)));
+
+static uint8_t spill_pages[(SECOND_PAGE_COUNT + 1) * PAGE_SIZE]
+    __attribute__((aligned(PAGE_SIZE)));
+
+static __attribute__((noinline)) uint32_t execute_code(volatile uint8_t *code)
+{
+    uint32_t (*function)(void) = (uint32_t (*)(void))(uintptr_t)code;
+
+    /* Keep guest code writes on their intended side of each execution. */
+    asm volatile("" ::: "memory");
+    return function();
+}
+
+static void emit_return(volatile uint8_t *code, uint32_t value)
+{
+    code[0] = 0xb8; /* mov immediate, %eax */
+    for (unsigned int i = 0; i < 4; i++) {
+        code[i + 1] = value >> (i * 8);
+    }
+    code[5] = 0xc3; /* ret */
+}
+
+static bool check_value(const char *name, volatile uint8_t *code,
+                         uint32_t expected)
+{
+    uint32_t actual = execute_code(code);
+
+    if (actual != expected) {
+        ml_printf("%s: expected %x, got %x\n", name, expected, actual);
+        return false;
+    }
+    return true;
+}
+
+static bool check_boundary(const char *name, volatile uint8_t *pages)
+{
+    volatile uint8_t *code = pages + PAGE_SIZE - 2;
+
+    emit_return(code, UINT32_C(0x44332211));
+    if (!check_value(name, code, UINT32_C(0x44332211))) {
+        return false;
+    }
+
+    /* The immediate's first byte belongs to the TB's first physical page. */
+    code[1] = 0x12;
+    if (!check_value(name, code, UINT32_C(0x44332212))) {
+        return false;
+    }
+
+    /* Its second byte belongs to the TB's second physical page. */
+    code[2] = 0x23;
+    return check_value(name, code, UINT32_C(0x44332312));
+}
+
+static void invalidate_mapping(unsigned int pages)
+{
+    for (unsigned int i = 0; i < pages; i++) {
+        uintptr_t address = TEST_MAPPING + i * PAGE_SIZE;
+
+        asm volatile("invlpg (%0)" :: "r"(address) : "memory");
+    }
+}
+
+static bool check_reverse_mapping(void)
+{
+    uint64_t root_address;
+    uint64_t *root, *directory_pointer, *directory;
+    uint64_t original_entry;
+    bool passed;
+
+    asm volatile("mov %%cr3, %0" : "=r"(root_address));
+    root = (uint64_t *)(uintptr_t)(root_address & ADDRESS_MASK);
+    directory_pointer = (uint64_t *)(uintptr_t)(root[0] & ADDRESS_MASK);
+    directory = (uint64_t *)(uintptr_t)(directory_pointer[1] & ADDRESS_MASK);
+    original_entry = directory[0];
+
+    /* Replace only the unused 1 GiB mapping; retain the boot identity map. */
+    test_page_table[0] = (uintptr_t)(code_pages + PAGE_SIZE) | 7;
+    test_page_table[1] = (uintptr_t)code_pages | 7;
+    directory[0] = (uintptr_t)test_page_table | 7;
+    invalidate_mapping(2);
+    passed = check_boundary("reverse physical pages",
+                            (volatile uint8_t *)(uintptr_t)TEST_MAPPING);
+
+    directory[0] = original_entry;
+    invalidate_mapping(2);
+    return passed;
+}
+
+static bool check_current_block(volatile uint8_t *code)
+{
+    static const uint8_t instructions[] = {
+        /* movb $42, 1(%rip): patches the following instruction's immediate. */
+        0xc6, 0x05, 0x01, 0x00, 0x00, 0x00, 0x2a,
+        0xb8, 0x01, 0x00, 0x00, 0x00, /* mov $1, %eax */
+        0xc3,                         /* ret */
+    };
+
+    for (unsigned int i = 0; i < sizeof(instructions); i++) {
+        code[i] = instructions[i];
+    }
+    return check_value("current block", code, 42);
+}
+
+static bool check_shared_first_page(void)
+{
+    uint64_t root_address;
+    uint64_t *root, *directory_pointer, *directory;
+    uint64_t original_entry;
+    bool passed = false;
+
+    asm volatile("mov %%cr3, %0" : "=r"(root_address));
+    root = (uint64_t *)(uintptr_t)(root_address & ADDRESS_MASK);
+    directory_pointer = (uint64_t *)(uintptr_t)(root[0] & ADDRESS_MASK);
+    directory = (uint64_t *)(uintptr_t)(directory_pointer[1] & ADDRESS_MASK);
+    original_entry = directory[0];
+
+    /* Each boundary instruction shares page zero and has its own page one. */
+    for (unsigned int i = 0; i < SECOND_PAGE_COUNT; i++) {
+        test_page_table[2 * i] = (uintptr_t)spill_pages | 7;
+        test_page_table[2 * i + 1] =
+            (uintptr_t)(spill_pages + (i + 1) * PAGE_SIZE) | 7;
+    }
+    directory[0] = (uintptr_t)test_page_table | 7;
+    invalidate_mapping(SECOND_PAGE_COUNT * 2);
+
+    /* Populate every mapping before execution so all crossing TBs survive. */
+    for (unsigned int i = 0; i < SECOND_PAGE_COUNT; i++) {
+        volatile uint8_t *code = (volatile uint8_t *)(uintptr_t)
+            (TEST_MAPPING + (2 * i + 1) * PAGE_SIZE - 2);
+
+        emit_return(code, UINT32_C(0x44330011) + (i << 8));
+    }
+    for (unsigned int i = 0; i < SECOND_PAGE_COUNT; i++) {
+        volatile uint8_t *code = (volatile uint8_t *)(uintptr_t)
+            (TEST_MAPPING + (2 * i + 1) * PAGE_SIZE - 2);
+
+        if (!check_value("shared first page", code,
+                         UINT32_C(0x44330011) + (i << 8))) {
+            goto out;
+        }
+    }
+
+    /* Invalidation must retain every distinct second-page lock on spill. */
+    ((volatile uint8_t *)spill_pages)[PAGE_SIZE - 1] = 0x12;
+    for (unsigned int i = 0; i < SECOND_PAGE_COUNT; i++) {
+        volatile uint8_t *code = (volatile uint8_t *)(uintptr_t)
+            (TEST_MAPPING + (2 * i + 1) * PAGE_SIZE - 2);
+
+        if (!check_value("patch shared first page", code,
+                         UINT32_C(0x44330012) + (i << 8))) {
+            goto out;
+        }
+    }
+
+    ((volatile uint8_t *)spill_pages)[PAGE_SIZE] = 0x5a;
+    for (unsigned int i = 0; i < SECOND_PAGE_COUNT; i++) {
+        volatile uint8_t *code = (volatile uint8_t *)(uintptr_t)
+            (TEST_MAPPING + (2 * i + 1) * PAGE_SIZE - 2);
+        uint32_t expected = i ? UINT32_C(0x44330012) + (i << 8)
+                              : UINT32_C(0x44335a12);
+
+        if (!check_value("patch one second page", code, expected)) {
+            goto out;
+        }
+    }
+
+    /* The other crossing TBs force spill during a precise-SMC nonlocal exit. */
+    passed = check_current_block(spill_pages + 128);
+
+ out:
+    directory[0] = original_entry;
+    invalidate_mapping(SECOND_PAGE_COUNT * 2);
+    return passed;
+}
+
+int main(void)
+{
+    volatile uint8_t *single = code_pages + 63;
+
+    emit_return(single, 1);
+    if (!check_value("single page", single, 1)) {
+        return 1;
+    }
+
+    /* A data write on the same physical page must preserve code protection. */
+    ((volatile uint8_t *)code_pages)[0] = 0x5a;
+    single[1] = 2;
+    if (!check_value("patch after non-code write", single, 2)) {
+        return 1;
+    }
+
+    /* The immediate is naturally aligned for an atomic guest write. */
+    __atomic_store_n((uint32_t *)(uintptr_t)(single + 1), 3, __ATOMIC_SEQ_CST);
+    if (!check_value("atomic patch", single, 3)) {
+        return 1;
+    }
+
+    if (!check_boundary("consecutive physical pages", code_pages) ||
+        !check_reverse_mapping() || !check_shared_first_page() ||
+        !check_current_block(code_pages + 128)) {
+        return 1;
+    }
+
+    ml_printf("self-modifying code: passed\n");
+    return 0;
+}
