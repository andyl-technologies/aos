+        candidate->operation != operation || candidate->process != getpid() ||
+        !qemu_thread_is_self(&candidate->thread) || !qemu_in_main_thread() ||
+        current_cpu || !bql_locked() || qemu_in_coroutine() ||
+        fingerprint_root_frame.active || candidate->frame_serial != fingerprint_root_frame.serial ||
+        candidate->cpu_closure || fingerprint_root_execution ||
+        fingerprint_root_operation || fingerprint_root_writer ||
+        logical_capture->source_claim || logical_capture->progress.borrowed ||
+        logical_capture->progress.published || ordinary_fingerprint.operation_borrowed) {
