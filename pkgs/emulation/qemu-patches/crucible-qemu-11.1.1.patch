+
+        marker_read, marker_write = os.pipe()
+        self.state_fd = os.memfd_create("idle-wait-state", os.MFD_CLOEXEC)
+        os.ftruncate(self.state_fd, 24)
+        self.control_state = mmap.mmap(self.state_fd, 24)
+        if dispatch_ceiling is not None:
+            self.control_state[8:16] = dispatch_ceiling.to_bytes(
+                8, byteorder=sys.byteorder
+            )
+        self.wake_fd = os.eventfd(0, os.EFD_CLOEXEC | os.EFD_NONBLOCK)
+        icount_options = "shift=0,align=off,sleep=off"
