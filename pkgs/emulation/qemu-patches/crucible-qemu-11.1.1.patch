+            &native_accelerator_members[0],
+            qemu_plugin_crucible_native_accelerator_descriptor_observe_v1,
+            0, &actual);
+    int result = -1;
+
+    (void)userdata;
+    if (actual.function) {
+        result = ((qemu_plugin_accelerator_submit_cb_t)actual.function)(
+            sequence,
+            device_id,
+            class_id,
+            job_kind,
+            queue_id,
+            service_units,
+            data,
+            len,
+            output_capacity,
+            actual.userdata);
+    }
+    qemu_plugin_crucible_native_group_use_end_v1(use);
+    return result;
+#else
+    return accelerator_submit_cb(sequence, device_id, class_id, job_kind, queue_id, service_units, data, len, output_capacity, userdata);
+#endif
