+        status = qemu_thread_ram_writer_current(&fence->writers);
+    }
+    if (!status) {
+        status = qemu_crucible_ram_observation_background_current_v1(
+            fence->background_token);
+    }
+    return status;
+}
+
+int qemu_crucible_observation_writer_creator_current_v1(
+    QemuCrucibleObservationWriterFence *fence)
+{
+    int status;
+
+    if (qatomic_cmpxchg(&observation_writer_cut, 0, 1)) {
+        return -EBUSY;
+    }
+    status = fence == &observation_writer && fence->held &&
+        fence->process == getpid() && qemu_thread_is_self(&fence->thread) ?
+        0 : -ESTALE;
+    qatomic_store_release(&observation_writer_cut, 0);
+    return status;
+}
+
+int qemu_crucible_observation_writer_return_v1(
+    QemuCrucibleObservationWriterFence **owner)
+{
+    QemuCrucibleObservationWriterFence *fence;
+    int status;
+
+    if (!owner || !(fence = *owner) || fence != &observation_writer ||
+        !fence->held || fence->process != getpid() ||
+        !qemu_thread_is_self(&fence->thread)) {
+        return -ESTALE;
+    }
+    if (qatomic_cmpxchg(&observation_writer_cut, 0, 1)) {
+        return -EBUSY;
+    }
