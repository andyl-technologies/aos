+static void test_projection(gconstpointer opaque)
+{
+    unsigned index = GPOINTER_TO_UINT(opaque);
+    PITCommonState state;
+    GByteArray *before, *after;
+
+    initialize_timers(&state);
+    set_deadline(&state, -1, true);
+    before = project_state(&state);
+    switch (index) {
+    case 0:
+        state.channels[2].count_load_time_ps += (__int128)1 << 100;
+        break;
+    case 1:
+        state.channels[0].next_transition_time_ps += (__int128)1 << 100;
+        break;
+    case 2:
+        timer_mod_ps_wide(state.channels[0].irq_timer, ((__int128)1 << 100) - 1);
+        break;
+    default:
+        timer_del(state.channels[0].irq_timer);
+        break;
+    }
+    after = project_state(&state);
+
+    g_assert_cmpstr(pit_fingerprint.schema, ==, "crucible.qemu.i8254.v4");
+    g_assert_cmpuint(pit_fingerprint.version, ==, 4);
+    g_assert_true(before->len != after->len ||
+                  memcmp(before->data, after->data, before->len));
+
+    g_byte_array_unref(before);
+    g_byte_array_unref(after);
+    destroy_timers(&state);
+}
