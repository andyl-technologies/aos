+static bool e1000_fingerprint_projection(QEMUFile *f, const void *opaque,
+                                         Error **errp)
+{
+    const E1000State *s = opaque;
+    const e1000x_txd_props *main_tx_props;
+    uint16_t phy_reg[E1000_FINGERPRINT_PHY_WORDS];
+    NetClientState *nc;
+    E1000FingerprintState state;
+
+    if (!s->nic || !s->autoneg_timer || !s->mit_timer ||
+        !s->flush_queue_timer ||
+        (s->compat_flags & ~(E1000_FLAG_TSO | E1000_FLAG_VET)) != 0) {
+        error_setg(errp, "e1000 fingerprint has invalid runtime state");
+        return false;
+    }
+
+    nc = qemu_get_queue(s->nic);
+    memcpy(phy_reg, s->phy_reg, sizeof(phy_reg));
+    if (nc->link_down && have_autoneg(s)) {
+        phy_reg[MII_BMSR] |= MII_BMSR_AN_COMP;
+    }
+
+    main_tx_props = chkflag(TSO) || !s->use_tso_for_migration ?
+                    &s->tx.props : &s->tx.tso_props;
+    state = (E1000FingerprintState) {
+        .rxbuf_size = s->rxbuf_size,
+        .rxbuf_min_shift = s->rxbuf_min_shift,
+        .eecd_val_in = s->eecd_state.val_in,
+        .eecd_bitnum_in = s->eecd_state.bitnum_in,
+        .eecd_bitnum_out = s->eecd_state.bitnum_out,
+        .eecd_reading = s->eecd_state.reading,
+        .eecd_old_eecd = s->eecd_state.old_eecd,
+        .main_tx_props = main_tx_props,
+        .tso_tx_props = &s->tx.tso_props,
+        .tx_size = s->tx.size,
+        .tx_tso_frames = s->tx.tso_frames,
+        .tx_sum_needed = s->tx.sum_needed,
+        .tx_header = s->tx.header,
+        .tx_data = s->tx.data,
+        .eeprom_data = s->eeprom_data,
+        .phy_reg = phy_reg,
+        .mac_reg = s->mac_reg,
+        .compat_flags = s->compat_flags,
+        .tso_state_present = chkflag(TSO),
+        .mit_irq_level = s->mit_irq_level,
+    };
+    if (!e1000_fingerprint_state_valid(&state, errp)) {
+        return false;
+    }
+    if (!pci_device_fingerprint_projection(f, &s->parent_obj, errp)) {
+        return false;
+    }
+    return e1000_state_fingerprint_projection(f, &state, errp);
+}
+
+static const CrucibleFingerprintProjection e1000_fingerprint = {
+    .schema = "crucible.qemu.e1000.v1",
+    .version = 1,
+    .save = e1000_fingerprint_projection,
+};
