+}
+
+static QemuCruciblePluginWorker *required_worker_frame(
+    QemuCrucibleRequiredWorkerFrame *frame, bool destroying)
+{
+    QemuCrucibleRequiredWorker *worker;
+
+    /* Canonical frame membership precedes reading the caller's opaque tag. */
+    if (frame == &startup_source.run_worker.frame) {
+        worker = &startup_source.run_worker;
+    } else if (frame == &startup_source.teardown_worker.frame) {
+        worker = &startup_source.teardown_worker;
+    } else {
+        return NULL;
+    }
+    return frame->worker == worker && !plugin_worker_frame(&worker->native, destroying) ?
+        &worker->native : NULL;
+}
+
+int qemu_plugin_crucible_required_worker_allocation_begin_v1(
+    QemuCrucibleRequiredWorkerFrame *frame)
+{
+    QemuCruciblePluginWorker *native = required_worker_frame(frame, false);
+
+    return native ? plugin_worker_allocation_begin(native) : -EPERM;
+}
