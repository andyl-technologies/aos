+int qemu_plugin_crucible_ram_pin_topology_v1(uint64_t token, uint64_t generation)
+{
+    Error *error = NULL;
+    uint64_t rearm_metadata;
+    int status = qemu_plugin_crucible_ram_physical_validate_v1(token, generation);
+
+    if (status || qatomic_read(&paging_topology_pinned)) {
+        return status ? status : -EBUSY;
+    }
+    status = qemu_crucible_ram_dirty_rearm_metadata_bytes(&rearm_metadata);
+    if (status || rearm_metadata > admitted_rearm_metadata) {
+        return status ? status : -ENOSPC;
+    }
+    /* A pager may activate before the first root capture. Arm native writers
+     * under the retained physical fence before exposing registration authority.
+     * The memory transaction rearms TCG translations; queued flushes run before
+     * the single-RR owner resumes guest execution. Initial capture stays full. */
+    if (!memory_global_dirty_log_start(GLOBAL_DIRTY_CRUCIBLE_RAM, &error)) {
+        error_free(error);
+        return -EIO;
+    }
+    status = qemu_plugin_crucible_ram_physical_validate_v1(token, generation);
+    if (status) {
+        return status;
+    }
+    /* The retained RCU owner excludes reclamation while these current headers
+     * are selected. Topology preflight refuses replacement before mutation. */
+    for (unsigned client = 0; client < DIRTY_MEMORY_NUM; client++) {
+        paging_dirty_planes[client] = qatomic_rcu_read(&ram_list.dirty_memory[client]);
+        if (!paging_dirty_planes[client]) {
+            return -ENOTSUP;
+        }
+    }
+    status = qemu_crucible_ram_physical_graph_seal(physical_device_generation);
+    if (status) {
+        return status;
+    }
+    qatomic_store_release(&paging_topology_pinned, true);
+    return 0;
+}
