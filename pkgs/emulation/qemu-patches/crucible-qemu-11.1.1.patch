+    ICH9LPCPMRegs second = { 0 };
+    g_autoptr(GBytes) first_bytes = NULL;
+    g_autoptr(GBytes) second_bytes = NULL;
+
+    first.acpi_pci_hotplug.use_acpi_hotplug_bridge = true;
+    second.acpi_pci_hotplug.use_acpi_hotplug_bridge = true;
+    second.acpi_pci_hotplug.acpi_pcihp_pci_status[3].up = 1;
+    first_bytes = project_hotplug(&first, true);
+    second_bytes = project_hotplug(&second, true);
+    g_assert_false(g_bytes_equal(first_bytes, second_bytes));
+
+    first.acpi_pci_hotplug.acpi_pcihp_pci_status[3].hotplug_enable = 1;
+    second.acpi_pci_hotplug.acpi_pcihp_pci_status[3].hotplug_enable = 2;
+    first.acpi_pci_hotplug.acpi_pcihp_pci_status[3].up = 1;
+    first_bytes = project_hotplug(&first, true);
+    second_bytes = project_hotplug(&second, true);
+    g_assert_true(g_bytes_equal(first_bytes, second_bytes));
+}
+
+static void test_unrestorable_removal_state(void)
+{
