+
+static bool qcrypto_sha256_disjoint(const QCryptoSHA256 *hash,
+                                    const void *address, size_t bytes)
+{
+    uintptr_t first = (uintptr_t)hash;
+    uintptr_t second = (uintptr_t)address;
+
+    return qcrypto_sha256_span(address, bytes) &&
+        (!bytes || first + sizeof(*hash) <= second || second + bytes <= first);
