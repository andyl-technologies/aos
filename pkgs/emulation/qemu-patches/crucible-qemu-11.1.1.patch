+int qemu_crucible_ram_dirty_retirement_continue(void)
+{
+    DirtyMemoryRetirement *state = &ram_list.dirty_retirement;
+    int context = qemu_crucible_ram_metadata_return_context();
+    int status;
+
+    if (context <= 0) {
+        return context;
+    }
+    if (!bql_locked()) {
+        return -EPERM;
+    }
+    if (!state->cursor_active) {
+        qemu_mutex_lock_ramlist();
+        if (state->ready_tail) {
+            state->stop_address = (uintptr_t)state->ready_tail;
+            state->stop_serial = state->ready_tail->metadata_owner.serial;
+            state->stop_reached = false;
+            state->cursor_active = true;
+        }
+        qemu_mutex_unlock_ramlist();
+    }
+    do {
+        status = dirty_retirement_step();
+        if (status) {
+            return status;
+        }
+        if (!state->cursor_active || state->stop_reached) {
+            state->cursor_active = false;
+            state->stop_reached = false;
+            return state->callback_status;
+        }
+        if (!state->ready_head) {
+            return dirty_retirement_status(-ESTALE);
+        }
+        /* Each successful step physically returns a distinct actual ready
+         * body. A refusal exits; newly enqueued callbacks cannot extend this
+         * captured BQL horizon. No count grants another allocation. */
+    } while (true);
