+int qemu_plugin_crucible_startup_source_command_member_transfer_v1(
+    qemu_plugin_id_t id, QemuCrucibleCommandConsumerMember **projection,
+    QemuCrucibleCommandConsumerMember **runtime_field)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    QemuCrucibleCommandConsumerMember *member = &startup_source.command_member;
+    uintptr_t field = (uintptr_t)runtime_field;
+    int status = command_registry_identity(id);
+    int post;
+    int identity;
+
+    if (status || !projection || !runtime_field || !startup_invocation(id) ||
+        startup_source.install_returned) {
+        return status ? status : -EPERM;
+    }
+    qemu_mutex_lock(&commands->mutex);
+    if (callback_child_output_conflicts_locked(projection, sizeof(*projection)) ||
+        callback_child_output_conflicts_locked(runtime_field, sizeof(*runtime_field)) ||
+        callback_child_output_overlap(projection, sizeof(*projection),
+                                      runtime_field, sizeof(*runtime_field))) {
+        status = -EINVAL;
+    } else {
+        status = command_member_identity_locked(member);
+    }
+    if (!status && member->transition_active) {
+        status = -EBUSY;
+    }
+    if (!status && (*projection != member || member->transferred ||
+                    member->closing || member->first_status || member->post_status)) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        status = callback_registration_owner_live_locked(member->child_owner);
+    }
+    if (!status && (!member->child_owner->runtime_base ||
+                    member->child_owner->runtime_extent < sizeof(*runtime_field) ||
+                    member->child_owner->runtime_extent >
+                        UINTPTR_MAX - member->child_owner->runtime_base ||
+                    field < member->child_owner->runtime_base ||
+                    field % _Alignof(QemuCrucibleCommandConsumerMember *) ||
+                    field - member->child_owner->runtime_base >
+                        member->child_owner->runtime_extent - sizeof(*runtime_field) ||
+                    *runtime_field)) {
+        status = -EINVAL;
+    }
+    if (!status) {
+        member->transition_active = true;
+    }
+    qemu_mutex_unlock(&commands->mutex);
+    if (status) {
+        return status;
+    }
+
+    status = startup_runtime_admission(id, &startup_source.runtime_purpose);
+    qemu_mutex_lock(&commands->mutex);
+    identity = command_member_identity_locked(member);
+    if (!identity && !status && (*projection != member || *runtime_field)) {
+        status = -ESTALE;
+    }
+    if (status || identity) {
+        if (status && !member->first_status) {
+            member->first_status = status;
+        }
+        if (!identity) {
+            member->transition_active = false;
+        }
+        qemu_mutex_unlock(&commands->mutex);
+        return status ? status : identity;
+    }
+    if (!status) {
+        *runtime_field = member;
+        member->runtime_holder = runtime_field;
+        member->runtime_base = member->child_owner->runtime_base;
+        member->runtime_extent = member->child_owner->runtime_extent;
+        member->holder = runtime_field;
+        member->transferred = true;
+        member->creation_owner = NULL;
+        *projection = NULL;
+    }
+    qemu_mutex_unlock(&commands->mutex);
+    if (status) {
+        return status;
+    }
+    post = startup_runtime_admission(id, member->runtime);
+    qemu_mutex_lock(&commands->mutex);
+    if (post && !member->post_status) {
+        member->post_status = post;
+    }
+    identity = command_member_identity_locked(member);
+    if (!identity) {
+        member->transition_active = false;
+    }
+    qemu_mutex_unlock(&commands->mutex);
+    if (post) {
+        crucible_metadata_partition_record_post(&startup_source.metadata_partition, post);
+    }
+    return post ? post : identity;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_startup_source_command_member_current_v1(
+    qemu_plugin_id_t id, QemuCrucibleCommandConsumerMember *member)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    int status = command_registry_identity(id);
+
+    if (status) {
+        return status;
+    }
+    qemu_mutex_lock(&commands->mutex);
+    status = command_member_live_locked(member);
+    qemu_mutex_unlock(&commands->mutex);
+    if (!status && member->publisher_lender) {
+#if defined(__x86_64__) && !defined(__ILP32__)
+        status = qemu_crucible_preexec_publisher_member_current_v1(
+            member->publisher_lender, member);
+#else
+        status = -ENOTSUP;
+#endif
+    }
+    /* This physical member proves no request, action row, Original, frontier
+     * advancement, dispatch, Root, or material completion. */
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+#ifdef CONFIG_LINUX
+/* These factual cleanup helpers are reached only after the real member's
+ * retained transition and independent post. Status never proves child return. */
+static void command_member_publisher_return_finish(
+    QemuCrucibleCommandConsumerMember *member,
+    QemuCrucibleCommandConsumerMember **holder, int identity)
+{
+    if (!identity && member->publisher_returned && pending_constructor_closed()) {
+        member->component->command_member = NULL;
+        member->slot->command_member = NULL;
+        *holder = NULL;
+        member->creation_owner = NULL;
+        member->holder = NULL;
+        member->held = false;
+        member->returned = true;
+    }
+    if (!identity) {
+        member->transition_active = false;
+    }
+}
+
+static int command_member_publisher_return_result(
+    const QemuCrucibleCommandConsumerMember *member, int first, int post, int identity)
+{
+    if (member->return_first_status) {
+        return member->return_first_status;
+    }
+    if (member->return_post_status) {
+        return member->return_post_status;
+    }
+    if (first || post || identity) {
+        return first ? first : post ? post : identity;
+    }
+    return member->publisher_returned ? 0 : -EINPROGRESS;
+}
+
+#endif
+
+int qemu_plugin_crucible_startup_source_command_member_identity_return_v1(
+    qemu_plugin_id_t id, QemuCrucibleCommandConsumerMember **holder)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    QemuCrucibleCommandConsumerMember *member = &startup_source.command_member;
+    int status = command_registry_identity(id);
+
+    if (status || !holder) {
+        return status ? status : -EINVAL;
+    }
+    qemu_mutex_lock(&commands->mutex);
+    if ((!member->transferred &&
+         callback_child_output_conflicts_locked(holder, sizeof(*holder))) ||
+        (member->transferred && holder != member->runtime_holder)) {
+        status = -EINVAL;
+    } else {
+        status = command_member_identity_locked(member);
+    }
+    if (!status && *holder != member) {
+        status = -ESTALE;
+    }
+    if (!status && (!pending_constructor_closed() ||
+        startup_source.pending_offer_read.busy ||
+        member->transition_active || member->action_users ||
+        member->advance_users || member->receive_users ||
+        member->park_request_users || member->park_writer_users ||
+        member->park_writer.invoking || member->park_writer.uncertain)) {
+        status = -EBUSY;
+    }
+    if (!status && member->publisher_lender) {
+        int first;
+        int post;
+        int identity;
+
+        member->closing = true;
+        member->transition_active = true;
+        qemu_mutex_unlock(&commands->mutex);
+
+#if defined(__x86_64__) && !defined(__ILP32__)
+        first = qemu_crucible_preexec_publisher_member_return_v1(
+            member->publisher_lender, member, &member->publisher_returned);
+#else
+        first = -ENOTSUP;
+#endif
+        /* Always independent, including failed local admission/cleanup. The
+         * held member retains the module and slot throughout this unlocked cut. */
+        post = startup_runtime_admission(id, member->runtime);
+        qemu_mutex_lock(&commands->mutex);
+        if (!member->return_attempted) {
+            member->return_first_status = first;
+            member->return_post_status = post;
+            member->return_attempted = true;
+        }
+        /* Physical local child return and the independent observations are
+         * distinct. A negative post cannot resurrect or release it again. */
+        identity = command_member_identity_locked(member);
+        if (!identity && (!member->transition_active ||
+                          member->holder != holder || *holder != member)) {
+            identity = -ESTALE;
+        }
+        command_member_publisher_return_finish(member, holder, identity);
+        status = command_member_publisher_return_result(member, first, post, identity);
+        qemu_mutex_unlock(&commands->mutex);
+        return status;
+    }
+    if (!status) {
+        member->closing = true;
+        member->component->command_member = NULL;
+        member->slot->command_member = NULL;
+        *holder = NULL;
+        member->creation_owner = NULL;
+        member->holder = NULL;
+        member->held = false;
+        member->returned = true;
+    }
+    qemu_mutex_unlock(&commands->mutex);
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
