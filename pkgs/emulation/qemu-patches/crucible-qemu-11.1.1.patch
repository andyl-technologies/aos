+    const uint16_t arbitrary[] = {0, 1, 20, 99, 32768, UINT16_MAX};
+    set_rules(arbitrary, G_N_ELEMENTS(arbitrary));
+    for (uint32_t kind = 0; kind <= UINT16_MAX; kind++) {
+        compare_query(kind);
+    }
+    puts("PASS first/middle/last/multiple/no match, full ordered reads and all uint16 queries");
+}
+
+static void check_mutations(void)
+{
+    const uint16_t kinds[] = {1, 20, 3};
+
+    set_rules(kinds, G_N_ELEMENTS(kinds));
+    compare_query(20);
+    node_rule_unref(g_ptr_array_index(crucible_node_rules, 1));
+    g_ptr_array_index(crucible_node_rules, 1) = new_rule(7);
+    compare_query(20);
+    compare_query(7);
+    g_ptr_array_add(crucible_node_rules, new_rule(20));
+    compare_query(20);
