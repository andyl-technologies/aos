+static void test_periodic_program(gconstpointer opaque)
+{
+    unsigned index = GPOINTER_TO_UINT(opaque);
+    MC146818RtcState state;
+    __int128 now = coordinate(periodic_vectors[index].now_hi,
+                              periodic_vectors[index].now_lo);
+    __int128 expected = coordinate(periodic_vectors[index].deadline_hi,
+                                   periodic_vectors[index].deadline_lo);
+    __int128 next = rtc_oscillator_deadline(rtc_oscillator_ticks(now) + 6);
+
+    initialize_timers(&state);
+    timer_mod_ps_wide(state.periodic_timer, next);
+
+    g_assert_true(timer_pending(state.periodic_timer));
+    assert_coordinate(timer_expire_time_ps_wide(state.periodic_timer), expected);
+    destroy_timers(&state);
+}
+
+static void test_cross_mode(gconstpointer opaque)
+{
+    unsigned index = GPOINTER_TO_UINT(opaque);
+    const __int128 deadlines[] = {
+        357, -1, -1001, ((__int128)1 << 120) + 357,
+        coordinate(INT64_MIN, 0), coordinate(INT64_MAX, UINT64_MAX),
+    };
+
+    if (g_test_subprocess()) {
+        MC146818RtcState destination;
+        char *contents;
+        gsize length;
+        GByteArray *bytes;
+        int status;
+
+        initialize_timers(&destination);
+        g_assert_true(g_file_get_contents(g_getenv("RTC_TIMER_IMAGE"),
+                                         &contents, &length, NULL));
+        bytes = g_byte_array_new_take((uint8_t *)contents, length);
+        timer_mod(destination.periodic_timer, 1);
+        status = load_state(&destination, bytes);
+
+        if (index < 3) {
+            int64_t expected[] = { 1, 0, -1 };
+
+            g_assert_cmpint(status, ==, 0);
+            g_assert_cmpint(destination.last_update, ==, expected[index]);
+            /* The real periodic callback consumes this scheduler scalar. */
+            g_assert_cmpint(destination.next_periodic_time, ==,
+                            MAX(0, expected[index]));
+            destination.crucible_epoch_ns = destination.base_rtc *
+                                            NANOSECONDS_PER_SECOND;
+            uint64_t raw_ps = 7357;
+
+            if (index == 0) {
+                g_assert_false(rtc_crucible_scheduler_to_raw(&destination,
+                                                              0, &raw_ps));
+                g_assert_cmpuint(raw_ps, ==, 7357);
+            } else {
+                g_assert_true(rtc_crucible_scheduler_to_raw(&destination,
+                                                             0, &raw_ps));
+                g_assert_cmpuint(raw_ps, ==, (uint64_t)-expected[index] * 1000);
+            }
+
+            /* Ordinary QEMUTimer retains its existing overdue clamp to zero. */
+            for (unsigned timer = 0; timer < 3; timer++) {
+                g_assert_true(timer_pending(rtc_wide_timer(&destination, timer)));
+                g_assert_cmpint(timer_expire_time_ns(
+                                   rtc_wide_timer(&destination, timer)),
+                                ==, MAX(0, expected[index]));
+            }
+        } else {
+            /* VMState may normalize the exact hook's range refusal. */
+            g_assert_cmpint(status, <, 0);
+            for (unsigned timer = 0; timer < 3; timer++) {
+                g_assert_false(timer_pending(rtc_wide_timer(&destination, timer)));
+            }
+        }
+
+        g_byte_array_unref(bytes);
+        destroy_timers(&destination);
+        return;
+    }
+
+    MC146818RtcState source;
+    GByteArray *bytes;
+    char *path;
+    int descriptor = g_file_open_tmp("rtc-wide-XXXXXX", &path, NULL);
+
+    g_assert_cmpint(descriptor, >=, 0);
+    close(descriptor);
+    initialize_timers(&source);
+    source.calendar_origin_ps = deadlines[index];
+    source.next_periodic_ps = deadlines[index];
+    source.next_alarm_ps = deadlines[index];
+    for (unsigned timer = 0; timer < 3; timer++) {
+        timer_mod_ps_wide(rtc_wide_timer(&source, timer), deadlines[index]);
+    }
+    bytes = save_state(&source);
+    g_assert_true(g_file_set_contents(path, (char *)bytes->data,
+                                     bytes->len, NULL));
+    g_setenv("RTC_TIMER_IMAGE", path, true);
+    g_setenv("RTC_TIMER_ORDINARY", "1", true);
+
+    g_test_trap_subprocess(NULL, 0, 0);
+    g_test_trap_assert_passed();
+
+    g_unsetenv("RTC_TIMER_IMAGE");
+    g_unsetenv("RTC_TIMER_ORDINARY");
+    unlink(path);
+    g_free(path);
+    g_byte_array_unref(bytes);
+    destroy_timers(&source);
+}
