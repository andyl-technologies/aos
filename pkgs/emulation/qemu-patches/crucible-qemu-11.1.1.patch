+
+static void initialize_clock(bool exact)
+{
+    Error *error = NULL;
+
+    module_call_init(MODULE_INIT_QOM);
+    qemu_init_main_loop(&error);
+    g_assert_null(error);
+    if (exact) {
+        qemu_timer_enable_tcg_ps_clock(NULL, observed_clock_ps);
+    }
+    qemu_clock_enable(QEMU_CLOCK_VIRTUAL, true);
+    nanosecond_reads = 0;
+}
+
+static void never_dispatch(void *opaque)
+{
+    g_assert_not_reached();
+}
+
+static void test_wide_counter(void)
+{
+    initialize_clock(true);
+    observed_ps = ((__int128)1 << 120) + 357;
+    /* Independently divided in unbounded arithmetic before uint64 wrapping. */
+    g_assert_cmpuint(acpi_pm_tmr_raw_clock(), ==,
+                     UINT64_C(9126594313785416391));
+}
+
+static void test_wide_deadline(void)
+{
+    ACPIREGS registers = { 0 };
+
+    initialize_clock(true);
+    observed_ps = (__int128)INT64_MAX * PICOSECONDS_PER_NANOSECOND + 357;
+    registers.tmr.timer = timer_new_ns(QEMU_CLOCK_VIRTUAL,
+                                      never_dispatch, NULL);
+    acpi_pm_tmr_calc_overflow_time(&registers);
+
+    acpi_pm_tmr_update(&registers, true);
+
+    g_assert_true(timer_pending(registers.tmr.timer));
+    __int128 expected = ((__int128)UINT64_C(500) << 64) |
+                        UINT64_C(826214373714);
+    g_assert_true(expiry_ps(registers.tmr.timer) == expected);
+    timer_free(registers.tmr.timer);
+}
+
+
+/*
+ * The timer pair uses the legacy fields and production subsection from
+ * PIIX4/ICH9. PCI, GPE and machine state remain outside this fixture.
+ */
+static int timer_pair_pre_save(void *opaque)
+{
+    return acpi_pm_tmr_pre_save(opaque);
+}
+
+static int timer_pair_pre_load(void *opaque)
+{
+    acpi_pm_tmr_pre_load(opaque);
+    return 0;
+}
+
+static int timer_pair_post_load(void *opaque, int version_id)
+{
+    return acpi_pm_tmr_post_load(opaque);
+}
+
+static const VMStateDescription vmstate_timer_pair = {
+    .name = "acpi-pm-timer",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .pre_save = timer_pair_pre_save,
+    .pre_load = timer_pair_pre_load,
+    .post_load = timer_pair_post_load,
+    .fields = (const VMStateField[]) {
+        VMSTATE_INT64(legacy_timer_ns, ACPIPMTimer),
+        VMSTATE_INT64(legacy_overflow_time, ACPIPMTimer),
+        VMSTATE_END_OF_LIST()
+    },
+    .subsections = (const VMStateDescription *const[]) {
+        &vmstate_acpi_pm_timer_wide,
+        NULL,
+    },
+};
+
+static GByteArray *save_state(ACPIPMTimer *timer)
+{
+    QIOChannelBuffer *output = qio_channel_buffer_new(128);
+    QEMUFile *file = qemu_file_new_output(QIO_CHANNEL(output));
+    GByteArray *bytes = g_byte_array_new();
+    Error *error = NULL;
+
+    g_assert_cmpint(vmstate_save_state(file, &vmstate_timer_pair, timer, NULL,
+                                      &error), ==, 0);
+    g_assert_null(error);
+    qemu_put_byte(file, QEMU_VM_EOF);
+    g_assert_cmpint(qemu_fflush(file), ==, 0);
+    g_byte_array_append(bytes, output->data, output->usage);
+    g_assert_cmpint(qemu_fclose(file), ==, 0);
+    object_unref(OBJECT(output));
+    return bytes;
+}
+
+static int load_state(ACPIPMTimer *timer, GByteArray *bytes)
+{
+    QIOChannelBuffer *input = qio_channel_buffer_new(bytes->len);
+    QEMUFile *file;
+    Error *error = NULL;
+    int result;
+
+    input->usage = bytes->len;
+    memcpy(input->data, bytes->data, bytes->len);
+    file = qemu_file_new_input(QIO_CHANNEL(input));
+    result = vmstate_load_state(file, &vmstate_timer_pair, timer, 1, &error);
+    error_free(error);
+    qemu_fclose(file);
+    object_unref(OBJECT(input));
+    return result;
+}
+
+static ACPIPMTimer create_timer(void)
+{
+    ACPIPMTimer timer = {
+        .timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, never_dispatch, NULL),
+    };
+    return timer;
+}
+
+static void roundtrip(__int128 ticks, __int128 expiry, bool active)
+{
+    ACPIPMTimer original = create_timer();
+    ACPIPMTimer restored = create_timer();
+    GByteArray *bytes;
+
+    original.overflow_ticks = ticks;
+    if (active) {
+        timer_mod_ps_wide(original.timer, expiry);
+    }
+    bytes = save_state(&original);
+    restored.overflow_ticks = 123;
+    timer_mod_ps_wide(restored.timer, 77);
+
+    g_assert_cmpint(load_state(&restored, bytes), ==, 0);
+    g_assert_true(restored.overflow_ticks == ticks);
+    g_assert_cmpint(timer_pending(restored.timer), ==, active);
+    if (active) {
+        g_assert_true(expiry_ps(restored.timer) == expiry);
+    }
+    timer_free(original.timer);
+    timer_free(restored.timer);
+    g_byte_array_unref(bytes);
+}
+
+static void test_wide_migration(void)
+{
+    initialize_clock(true);
+    observed_ps = ((__int128)1 << 120) + 357;
+    ACPIREGS producer = { 0 };
+
+    acpi_pm_tmr_calc_overflow_time(&producer);
+    roundtrip(producer.tmr.overflow_ticks, observed_ps + 357, true);
+}
+
+static void test_negative_expiry(void)
+{
+    initialize_clock(true);
+    roundtrip(0, -1, true);
+}
+
+static void test_inactive_migration(void)
+{
+    initialize_clock(true);
+    roundtrip(0, 0, false);
+}
+
+static void test_negative_epoch(void)
+{
+    initialize_clock(true);
+    observed_ps = -1;
+    g_assert_true(acpi_pm_tmr_raw_ticks() == -1);
+    g_assert_cmpuint(acpi_pm_tmr_raw_clock(), ==, UINT64_MAX);
+    __int128 expiry;
+    g_assert_true(acpi_pm_tmr_tick_deadline(-1, &expiry));
+    g_assert_true(expiry == -279365);
+}
+
+static void test_ordinary_migration(void)
+{
+    ACPIPMTimer original;
+    ACPIPMTimer restored;
+    GByteArray *bytes;
+
+    initialize_clock(false);
+    original = create_timer();
+    restored = create_timer();
+    original.overflow_time = 0x800000;
+    timer_mod_ns(original.timer, 123);
+    bytes = save_state(&original);
+
+    /* Ordinary mode preserves the original two big-endian int64 fields. */
+    g_assert_cmpuint(bytes->len, ==, 17);
+    g_assert_cmpuint(ldq_be_p(bytes->data), ==, 123);
+    g_assert_cmpuint(ldq_be_p(bytes->data + 8), ==, 0x800000);
+    g_assert_cmpint(load_state(&restored, bytes), ==, 0);
+    g_assert_cmpint(restored.overflow_time, ==, 0x800000);
+    g_assert_cmpint(timer_expire_time_ns(restored.timer), ==, 123);
+    timer_free(original.timer);
+    timer_free(restored.timer);
+    g_byte_array_unref(bytes);
+}
+
+
+typedef enum ExactStreamScenario {
+    EXACT_STREAM_FRACTION,
+    EXACT_STREAM_NEGATIVE_EXPIRY,
+    EXACT_STREAM_INACTIVE,
+    EXACT_STREAM_WIDE_EXPIRY,
+    EXACT_STREAM_WIDE_TICKS,
+    EXACT_STREAM_ROUNDING_OVERFLOW,
+} ExactStreamScenario;
+
+static const struct {
+    __int128 ticks;
+    __int128 expiry;
+    bool active;
+} exact_stream_inputs[] = {
+    [EXACT_STREAM_FRACTION] = { 0x800000, 1001, true },
+    [EXACT_STREAM_NEGATIVE_EXPIRY] = { 0, -1, true },
+    [EXACT_STREAM_INACTIVE] = { 0x800000, 0, false },
+    [EXACT_STREAM_WIDE_EXPIRY] = { 0, (__int128)1 << 120, true },
+    [EXACT_STREAM_WIDE_TICKS] = { (__int128)INT64_MAX + 1, 1000, true },
+    [EXACT_STREAM_ROUNDING_OVERFLOW] = {
+        0, (__int128)INT64_MAX * 1000 + 1, true,
+    },
+};
+
+/* The actual pre-save/table runs in a fresh executable, before g_test_init. */
+static int produce_exact_stream(unsigned scenario)
+{
+    __int128 ticks = exact_stream_inputs[scenario].ticks;
+    __int128 expiry = exact_stream_inputs[scenario].expiry;
+    bool active = exact_stream_inputs[scenario].active;
+    ACPIPMTimer timer;
+    GByteArray *encoded;
+    size_t offset = 0;
+    ssize_t count;
+
+    initialize_clock(true);
+    timer = create_timer();
+    timer.overflow_ticks = ticks;
+    if (active) {
+        timer_mod_ps_wide(timer.timer, expiry);
+    }
+    encoded = save_state(&timer);
+    while (offset < encoded->len) {
+        count = write(STDOUT_FILENO, encoded->data + offset,
+                      encoded->len - offset);
+        g_assert_cmpint(count, >, 0);
+        offset += count;
+    }
+    close(STDOUT_FILENO);
+    return 0;
+}
+
+static GByteArray *capture_exact_stream(unsigned scenario)
+{
+    char helper_mode[] = "--acpi-pm-exact-producer";
+
+    g_assert_cmpuint(scenario, <, G_N_ELEMENTS(exact_stream_inputs));
+    return timer_stream_capture(fixture_executable, helper_mode, scenario,
+                                TIMER_STREAM_TO_EOF);
+}
+
+static void crossmode(ExactStreamScenario scenario,
+                      int expected_result, int64_t projected_ns)
+{
+    __int128 ticks = exact_stream_inputs[scenario].ticks;
+    bool active = exact_stream_inputs[scenario].active;
+    GByteArray *bytes = capture_exact_stream(scenario);
+    ACPIPMTimer restored;
+
+    initialize_clock(false);
+    restored = create_timer();
+    restored.overflow_time = 123;
+    timer_mod_ns(restored.timer, 77);
+
+    int result = load_state(&restored, bytes);
+
+    if (expected_result) {
+        /* The VMState dispatcher may normalize a post-load rejection. */
+        g_assert_cmpint(result, <, 0);
+        g_assert_cmpint(restored.overflow_time, ==, 123);
+        g_assert_true(timer_pending(restored.timer));
+        g_assert_cmpint(timer_expire_time_ns(restored.timer), ==, 77);
+    } else {
+        g_assert_cmpint(result, ==, 0);
+        g_assert_cmpint(restored.overflow_time, ==, (int64_t)ticks);
+        g_assert_cmpint(timer_pending(restored.timer), ==, active);
+        if (active) {
+            g_assert_cmpint(timer_expire_time_ns(restored.timer), ==,
+                            projected_ns);
+        }
+    }
+    timer_free(restored.timer);
+    g_byte_array_unref(bytes);
+}
+
+static void test_crossmode_fraction(void)
+{
+    crossmode(EXACT_STREAM_FRACTION, 0, 2);
+}
+
+static void test_crossmode_negative_expiry(void)
+{
+    crossmode(EXACT_STREAM_NEGATIVE_EXPIRY, 0, 0);
+}
+
+static void test_crossmode_inactive(void)
+{
+    crossmode(EXACT_STREAM_INACTIVE, 0, 0);
+}
+
+static void test_crossmode_wide_expiry(void)
+{
+    crossmode(EXACT_STREAM_WIDE_EXPIRY, -ERANGE, 0);
+}
+
+static void test_crossmode_wide_ticks(void)
