+    timer->disabled = 1;
+    callback(&cpu);
+    g_assert_cmpuint(kicks, ==, 1);
+    destroy_timer(timer);
+    object_unref(OBJECT(&cpu));
+}
+
+static int import_ordinary(const char *path, unsigned kind)
+{
+    CPUTimer *timer;
+    GByteArray *bytes;
+    gchar *contents;
+    gsize length;
+    int status;
+
+    initialize_clock(false);
+    timer = create_timer();
+    timer_mod_ns(timer->qtimer, 42);
+    g_assert_true(g_file_get_contents(path, &contents, &length, NULL));
+    bytes = g_byte_array_new_take((guint8 *)contents, length);
+    status = load_state(&vmstate_cpu_timer, timer, bytes);
+    if (kind == 0) {
+        g_assert_cmpint(status, ==, 0);
+        g_assert_cmpint(timer->clock_offset, ==, 100);
+        g_assert_cmpint(timer_expire_time_ns(timer->qtimer), ==, 141);
+    } else {
+        g_assert_cmpint(status, <, 0);
+        g_assert_false(timer_pending(timer->qtimer));
+    }
+    destroy_timer(timer);
+    g_byte_array_unref(bytes);
+    return 0;
+}
+
+static void test_cross_mode(gconstpointer data)
+{
+    unsigned kind = GPOINTER_TO_UINT(data);
+    CPUTimer *timer;
+    GByteArray *bytes;
+    int descriptor;
+    char *path = NULL;
+    char *output = NULL;
+    char *errors = NULL;
+    int status;
+    char *arguments[5];
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+    initialize_clock(true);
+    observed_ps = kind == 1 ? ((__int128)1 << 120) + 357 :
+                  kind == 2 ? 100357 : 100000;
+    timer = create_timer();
+    cpu_tick_set_count(timer, 0);
+    cpu_tick_set_limit(timer, 4);
+    if (kind == 0) {
+        timer_mod_ps_wide(timer->qtimer, observed_ps + 40001);
+    }
+    bytes = save_state(&vmstate_cpu_timer, timer);
+    descriptor = g_file_open_tmp("sparc-wide-XXXXXX", &path, NULL);
+    g_assert_cmpint(descriptor, >=, 0);
+    close(descriptor);
+    g_assert_true(g_file_set_contents(path, (char *)bytes->data, bytes->len, NULL));
+    arguments[0] = (char *)program_path;
+    arguments[1] = (char *)"--import-ordinary";
+    arguments[2] = path;
+    arguments[3] = kind == 0 ? (char *)"0" : kind == 1 ? (char *)"1" : (char *)"2";
+    arguments[4] = NULL;
+    g_assert_true(g_spawn_sync(NULL, arguments, NULL, 0, NULL, NULL,
+                              &output, &errors, &status, NULL));
+    if (status) {
+        g_test_message("ordinary import: %s", errors);
+    }
+    g_assert_true(WIFEXITED(status));
+    g_assert_cmpint(WEXITSTATUS(status), ==, 0);
+    unlink(path);
+    g_free(output);
+    g_free(errors);
+    g_free(path);
+    destroy_timer(timer);
+    g_byte_array_unref(bytes);
+}
+
+static void test_range(gconstpointer data)
+{
+    unsigned kind = GPOINTER_TO_UINT(data);
+    CPUTimer *timer;
+    __int128 maximum = (__int128)(((__uint128_t)-1) >> 1);
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_failed();
+        g_test_trap_assert_stderr("*exceeds signed128 picoseconds*");
+        return;
+    }
+    initialize_clock(true);
+    observed_ps = kind == 0 ? -maximum - 1 : maximum;
+    timer = create_timer();
+    if (kind == 0) {
+        cpu_tick_set_count(timer, 1);
+    } else if (kind == 1) {
+        cpu_tick_set_limit(timer, 1);
+    } else {
+        cpu_timer_set_clock_offset_ps(timer, 0);
+        cpu_tick_set_limit(timer, 1);
+    }
+    g_assert_not_reached();
+}
+
+int main(int argc, char **argv)
+{
+    program_path = argv[0];
+    if (argc == 4 && !strcmp(argv[1], "--import-ordinary")) {
+        return import_ordinary(argv[2], strtoul(argv[3], NULL, 10));
+    }
+    g_test_init(&argc, &argv, NULL);
+    for (unsigned kind = 0; kind < 5; kind++) {
+        char *name = g_strdup_printf("/sparc/origin/%u", kind);
+        g_test_add_data_func(name, GUINT_TO_POINTER(kind), test_origin);
+        g_free(name);
+    }
+    for (unsigned kind = 0; kind < 4; kind++) {
+        char *name = g_strdup_printf("/sparc/elapsed/%u", kind);
+        g_test_add_data_func(name, GUINT_TO_POINTER(kind), test_elapsed);
+        g_free(name);
+
+    }
+    for (unsigned kind = 0; kind < 5; kind++) {
+        char *name = g_strdup_printf("/sparc/migration/%u", kind);
+        g_test_add_data_func(name, GUINT_TO_POINTER(kind), test_migration);
+        g_free(name);
+    }
+    for (unsigned kind = 0; kind < 14; kind++) {
+        char *name = g_strdup_printf("/sparc/malformed/%u", kind);
+        g_test_add_data_func(name, GUINT_TO_POINTER(kind), test_malformed);
+        g_free(name);
+    }
+    for (unsigned kind = 0; kind < 3; kind++) {
+        char *name = g_strdup_printf("/sparc/irq/%u", kind);
+        g_test_add_data_func(name, GUINT_TO_POINTER(kind), test_irq);
+        g_free(name);
+        name = g_strdup_printf("/sparc/cross-mode/%u", kind);
+        g_test_add_data_func(name, GUINT_TO_POINTER(kind), test_cross_mode);
+        g_free(name);
+    }
+    for (unsigned kind = 0; kind < 3; kind++) {
+        char *name = g_strdup_printf("/sparc/range/%u", kind);
+        g_test_add_data_func(name, GUINT_TO_POINTER(kind), test_range);
+        g_free(name);
+    }
+    g_test_add_func("/sparc/ordinary", test_ordinary);
+    return g_test_run();
+}
