+static void qemu_plugin_unregister_wake_fd(int fd)
+{
+    aio_set_fd_handler(qemu_get_aio_context(), fd, NULL, NULL,
+                       NULL, NULL, NULL);
+    if (qatomic_cmpxchg(&qemu_plugin_wake_fd, fd, -1) == fd) {
+        qemu_plugin_control_drain_invalidate();
+    }
+    if (fingerprint_wake_watcher.held && fingerprint_wake_watcher.fd == fd) {
+        fingerprint_wake_watcher.handler_registered = false;
+        fingerprint_wake_watcher.handler_removed = true;
+        /* An entered read/snapshot keeps the role loan alive until its actual
+         * return. Failure cannot erase this physical disposition journal. */
+        fingerprint_wake_watcher_return();
+    }
+}
+
+bool qemu_plugin_crucible_wake_fd_readable(void)
+{
+    GPollFD wake_poll = {
+        .fd = qatomic_read(&qemu_plugin_wake_fd),
+        .events = G_IO_IN,
+    };
+    int poll_status;
+
+    if (wake_poll.fd < 0) {
+        return false;
+    }
+    do {
+        poll_status = qemu_poll_ns(&wake_poll, 1, 0);
+    } while (poll_status < 0 && errno == EINTR);
+    return poll_status > 0 && wake_poll.revents != 0;
+}
+
+static int qemu_plugin_control_drain_wake_state(void)
+{
+    GPollFD wake_poll = {
+        .fd = qatomic_read(&qemu_plugin_wake_fd),
+        .events = G_IO_IN,
+    };
+    int status;
+
+    if (wake_poll.fd < 0) {
+        return -ENODEV;
+    }
+    do {
+        status = qemu_poll_ns(&wake_poll, 1, 0);
+    } while (status < 0 && errno == EINTR);
+    if (status < 0) {
+        return -errno;
+    }
+    if (wake_poll.revents & G_IO_NVAL) {
+        return -EBADF;
+    }
+    if (wake_poll.revents & (G_IO_ERR | G_IO_HUP)) {
+        return -EIO;
+    }
+    if (status == 0 && wake_poll.revents == 0) {
+        return 0;
+    }
+    return wake_poll.revents == G_IO_IN ? 1 : -EIO;
+}
