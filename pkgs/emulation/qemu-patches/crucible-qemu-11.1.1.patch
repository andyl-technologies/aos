@@ -0,0 +1,902 @@
+/*
+ * Fixed process-purpose carrier syntax and selected Setup edition
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef QEMU_CRUCIBLE_PROCESS_PURPOSE_H
+#define QEMU_CRUCIBLE_PROCESS_PURPOSE_H
+
+#include "qemu/crucible-device-workspace.h"
+
+/* The selector requires the once-received pre-exec route, not a purpose grant.
+ * Edition5 remains exact. The additive plan9/Setup6 construction branch uses
+ * the same once receiver; no earlier edition or late-receive fallback exists.
+ * The inherited AF_UNIX/SOCK_STREAM control descriptor remains FD3; the 61-byte
+ * frame and existing five/six-descriptor roster includes standing publication and cancellation.
+ */
+#define QEMU_CRUCIBLE_PROCESS_PURPOSE_SETUP_SELECTOR "QEMU_CRUCIBLE_PREEXEC_SETUP"
+#define QEMU_CRUCIBLE_PROCESS_PURPOSE_SETUP_SELECTOR_VALUE "5"
+#define QEMU_CRUCIBLE_PROCESS_PURPOSE_SETUP_EDITION 5U
+#define QEMU_CRUCIBLE_PROCESS_PURPOSE_SETUP_TAG 0x15U
+
+#define QEMU_CRUCIBLE_PROCESS_PURPOSE_MAGIC "CRUCPUR8"
+#define QEMU_CRUCIBLE_PROCESS_PURPOSE_SCHEMA 8U
+#define QEMU_CRUCIBLE_PROCESS_PURPOSE_BYTES 2520U
+#define QEMU_CRUCIBLE_PROCESS_PURPOSE_SCHEMA_OFFSET 8U
+#define QEMU_CRUCIBLE_PROCESS_PURPOSE_LENGTH_OFFSET 12U
+
+/* BEu64 ledger snapshots. Gross process bytes contain guest, workspace,
+ * creator/history and metadata purposes. TOTAL remains original provenance;
+ * it is not the native spend bound. Each outside field is added once, with
+ * checked arithmetic. Pending workspace is a distinct retained reserve even
+ * when assigned workspace rows are visible in assigned outside metadata.
+ */
+#define QEMU_CRUCIBLE_PROCESS_PURPOSE_TOTAL_OFFSET 16U
+#define QEMU_CRUCIBLE_PROCESS_PURPOSE_GROSS_PROCESS_OFFSET 24U
+#define QEMU_CRUCIBLE_PROCESS_PURPOSE_ASSIGNED_OUTSIDE_OFFSET 32U
+#define QEMU_CRUCIBLE_PROCESS_PURPOSE_PENDING_CLEANUP_OFFSET 40U
+#define QEMU_CRUCIBLE_PROCESS_PURPOSE_PENDING_WORKSPACE_OFFSET 48U
+#define QEMU_CRUCIBLE_PROCESS_PURPOSE_PENDING_STARTUP_OFFSET 56U
+#define QEMU_CRUCIBLE_PROCESS_PURPOSE_ASSIGNED_STARTUP_OFFSET 64U
+#define QEMU_CRUCIBLE_PROCESS_PURPOSE_INCARNATION_GUEST_OFFSET 72U
+#define QEMU_CRUCIBLE_PROCESS_PURPOSE_LIVE_INCARNATIONS_OFFSET 80U
+#define QEMU_CRUCIBLE_PROCESS_PURPOSE_ACCOUNT_GENERATION_OFFSET 88U
+#define QEMU_CRUCIBLE_PROCESS_PURPOSE_PROCESS_GENERATION_OFFSET 96U
+
+/* BEu64 effective issued contract coordinates: selected child cgroup-v2
+ * memory.max (nonzero, at most the issued local extent),
+ * RLIMIT_FSIZE per-file writable ceiling, pids.max, RLIMIT_NOFILE soft=hard,
+ * and the source-bound cpu.max/VM configuration ceiling, respectively.
+ * RLIMIT_FSIZE is not aggregate filesystem backing; its separate quota owner
+ * and inherited family attachment remain constructor prerequisites.
+ * These are not numerical descriptor identities.
+ * These fields are authenticated material only under the genuine once-owner.
+ * Observed operating-system limit equality corroborates that owner's contract;
+ * it cannot issue an account, a request extent or an ancillary descriptor loan.
+ */
+#define QEMU_CRUCIBLE_PROCESS_PURPOSE_MEMORY_LIMIT_OFFSET 104U
+#define QEMU_CRUCIBLE_PROCESS_PURPOSE_WRITABLE_FILE_LIMIT_OFFSET 112U
+#define QEMU_CRUCIBLE_PROCESS_PURPOSE_TASK_LIMIT_OFFSET 120U
+#define QEMU_CRUCIBLE_PROCESS_PURPOSE_FD_LIMIT_OFFSET 128U
+#define QEMU_CRUCIBLE_PROCESS_PURPOSE_VCPU_LIMIT_OFFSET 136U
+
+/* SHA256 of the final installed artifact; machine is BEu32 ELF e_machine.
+ * A matching digest and numerical request vector do not authenticate a module
+ * without the actual retained installing artifact/invocation source.
+ */
+#define QEMU_CRUCIBLE_PROCESS_PURPOSE_ARTIFACT_DIGEST_OFFSET 144U
+#define QEMU_CRUCIBLE_PROCESS_PURPOSE_ARTIFACT_DIGEST_BYTES 32U
+#define QEMU_CRUCIBLE_PROCESS_PURPOSE_ARTIFACT_MACHINE_OFFSET 176U
+#define QEMU_CRUCIBLE_PROCESS_PURPOSE_ROLE_COUNT_OFFSET 180U
+
+/* Copy exactly CRUCPRP1/schema1/80 basis[16..80], after validating its header.
+ * The containing Preparation and installing Startup are distinct entered
+ * originals. Their same capability is checked within the authentic containing
+ * relationship; operation ids, starts, ends and polls need not be equal.
+ * No new timestamp is sampled or serialized for this tail.
+ */
+#define QEMU_CRUCIBLE_PROCESS_PURPOSE_PREPARATION_MAGIC "CRUCPRP1"
+#define QEMU_CRUCIBLE_PROCESS_PURPOSE_PREPARATION_SCHEMA 1U
+#define QEMU_CRUCIBLE_PROCESS_PURPOSE_PREPARATION_BYTES 80U
+#define QEMU_CRUCIBLE_PROCESS_PURPOSE_CONTAINING_CAPABILITY_OFFSET 184U
+#define QEMU_CRUCIBLE_PROCESS_PURPOSE_CONTAINING_OPERATION_OFFSET 216U
+#define QEMU_CRUCIBLE_PROCESS_PURPOSE_CONTAINING_START_OFFSET 224U
+#define QEMU_CRUCIBLE_PROCESS_PURPOSE_CONTAINING_END_OFFSET 232U
+#define QEMU_CRUCIBLE_PROCESS_PURPOSE_CONTAINING_POLL_OFFSET 240U
+
+/* Seven canonical rows, in role order. Each exact request extent includes its
+ * shared allocation header and inline holder once. Alignment is a nonzero
+ * power of two; extent is nonzero and padded to it; birth count is exactly1.
+ * Allocator backing/history is contained separately by the gross envelope,
+ * never inferred from the sum of these requested allocation extents.
+ */
+#define QEMU_CRUCIBLE_PROCESS_PURPOSE_ROLES_OFFSET 248U
+#define QEMU_CRUCIBLE_PROCESS_PURPOSE_ROLE_BYTES 32U
+#define QEMU_CRUCIBLE_PROCESS_PURPOSE_ROLE_COUNT 7U
