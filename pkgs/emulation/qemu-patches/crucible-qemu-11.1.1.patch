index 0000000000000000000000000000000000000000..bee434d8a224d4c69e5a6625c7098b151065f5e7
--- /dev/null
+++ b/replay/replay-mutex.c
@@ -0,0 +1,91 @@
+/*
+ * Fair replay token ownership and native thread authorization.
+ *
+ * Copyright (c) 2010-2015 Institute for System Programming
+ *                         of the Russian Academy of Sciences.
+ * Copyright (c) Andyl, Inc.
+ *
+ * This work is licensed under the terms of the GNU GPL, version 2 or later.
+ * See the COPYING file in the top-level directory.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/error-report.h"
+#include "qemu/main-loop.h"
+#include "system/replay.h"
+
+/* The fair token serializes replay log/events and the Crucible RR
+ * main-loop/vCPU handoff; the queue mutex protects only its bookkeeping. */
+static QemuMutex lock;
+static QemuCond mutex_cond;
+static unsigned long mutex_head, mutex_tail;
+static bool mutex_enabled;
+
+static __thread bool replay_locked;
+static __thread int64_t replay_owner_thread;
+
+static void replay_mutex_record_owner(void)
+{
+#ifdef CONFIG_POSIX
+    replay_owner_thread = qemu_thread_current_id();
+#else
+    replay_owner_thread = qemu_get_thread_id();
+#endif
+}
+
+void replay_mutex_enable(void)
+{
+    g_assert(!mutex_enabled);
+    qemu_mutex_init(&lock);
+    qemu_cond_init(&mutex_cond);
+    /* Hold the mutex while we start-up. */
+    replay_locked = true;
+    replay_mutex_record_owner();
+    ++mutex_tail;
+    mutex_enabled = true;
+}
+
+bool replay_mutex_locked(void)
+{
+    return replay_locked;
+}
+
+bool replay_mutex_owned(void)
+{
+    /* A copied token cannot authorize even an earlier child fork callback.
+     * A genuine child acquisition refreshes through the existing fork-safe
+     * native thread cache; every query still validates the actual thread ID. */
+    return replay_locked && replay_owner_thread == qemu_get_thread_id();
+}
+
+/* Ordering constraints: replay_lock must be taken before BQL. */
+void replay_mutex_lock(void)
+{
+    if (mutex_enabled) {
+        unsigned long id;
+
+        g_assert(!bql_locked());
+        g_assert(!replay_mutex_locked());
+        qemu_mutex_lock(&lock);
+        id = mutex_tail++;
+        while (id != mutex_head) {
+            qemu_cond_wait(&mutex_cond, &lock);
+        }
+        replay_locked = true;
+        replay_mutex_record_owner();
+        qemu_mutex_unlock(&lock);
+    }
+}
+
+void replay_mutex_unlock(void)
+{
+    if (mutex_enabled) {
+        g_assert(replay_mutex_locked());
+        qemu_mutex_lock(&lock);
+        replay_owner_thread = 0;
+        ++mutex_head;
+        replay_locked = false;
+        qemu_cond_broadcast(&mutex_cond);
+        qemu_mutex_unlock(&lock);
+    }
+}
