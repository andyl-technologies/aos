+    qatomic_store_release(&rr_main_loop_dispatch_completed, generation);
+    qatomic_store_release(&rr_main_loop_dispatch_acknowledged, generation);
+    qatomic_store_release(&rr_main_loop_poll_priming, false);
+    qemu_event_set(&rr_main_loop_resume_event);
