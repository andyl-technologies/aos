+ * The virtio-9p device takes the upstream internal server path unless all four
+ * callbacks are registered. When all callbacks are registered, raw 9p messages
+ * are forwarded as a dumb pipe and QEMU performs no 9p server parsing.
+ */
+QEMU_PLUGIN_API
+void qemu_plugin_register_9p_cb(qemu_plugin_9p_burst_cb_t burst_start_cb,
+                                qemu_plugin_9p_submit_cb_t submit_cb,
+                                qemu_plugin_9p_poll_cb_t poll_cb,
+                                qemu_plugin_9p_burst_cb_t burst_done_cb,
+                                void *userdata);
