+bool pm_smbus_fingerprint_validate(const PMSMBus *smb, Error **errp)
+{
+    uint8_t protocol = (smb->smb_ctl >> 2) & 0x07;
+
+    if (smb->smb_index > PM_SMBUS_MAX_MSG_SIZE) {
+        error_setg(errp, "PM SMBus has invalid projection index");
+        return false;
+    }
+    if (protocol == PROT_BLOCK_DATA) {
+        if (smb->smb_data0 > PM_SMBUS_MAX_MSG_SIZE) {
+            error_setg(errp, "PM SMBus has invalid block-data length");
+            return false;
+        }
+    }
