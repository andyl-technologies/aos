+        'fa5b6074c5b5639538ad529b7a7d5a30ed1ed0dadee8fc6fb547d47e8b79457e'
+}
+
+
+@lru_cache(maxsize=8)
+def functions(text):
+    # Preserve positions while ignoring braces in comments and strings.
+    clean = re.sub(r'/\*.*?\*/|//[^\n]*|"(?:\\.|[^"\\])*"|\'(?:\\.|[^\'\\])*\'',
+                   lambda match: " " * len(match.group()), text, flags=re.S)
+    depth = 0
+    start = 0
+    name = None
+    found = {}
+    for index, char in enumerate(clean):
+        if char == "{" and depth == 0:
+            prefix = clean[:index].rstrip()
+            if prefix.endswith(")"):
+                balance = 1
+                position = len(prefix) - 2
+                while balance:
+                    if prefix[position] == ")":
+                        balance += 1
+                    elif prefix[position] == "(":
+                        balance -= 1
+                    position -= 1
+                match = re.search(r"([A-Za-z_]\w*)\s*$", prefix[:position + 1])
+                name = match.group(1) if match else None
+            else:
+                name = None
+            start = index
+        if char == "{":
+            depth += 1
+        elif char == "}":
+            depth -= 1
+            if depth == 0 and name:
+                found[name] = text[start:index + 1]
+    return found
+
+
+def whole(text, name):
+    body = functions(text)[name]
+    start = text.index(body)
+    declaration = text[text.rfind('\n\n', 0, start) + 2:start]
+    # Standalone extracted providers retain genuine prior declarations under
+    # the project's missing-prototypes checks. Static linkage stays literal.
+    prototype = '' if 'static ' in declaration else declaration.rstrip() + ';\n\n'
+    return prototype + declaration + body
+
+
+def typedef(text, name):
+    return re.search(
+        r'typedef (?:struct|enum) ' + name + r' \{.*?\n\} ' + name + ';',
+        text, re.S,
+    ).group()
+
+
+def assemble(root):
+    def input_file(path):
+        return root / path
+
+    source = input_file('util/qemu-thread-posix.c').read_text()
+    header = input_file('include/qemu/thread.h').read_text()
+    prefix = '''#ifndef _GNU_SOURCE
+    #define _GNU_SOURCE
+    #endif
+    #include <assert.h>
+    #include <errno.h>
+    #include <glib.h>
+    #include <limits.h>
+    #include <pthread.h>
+    #include <signal.h>
+    #include <stdbool.h>
+    #include <stdint.h>
+    #include <stdatomic.h>
+    #include <stdio.h>
+    #include <stdlib.h>
+    #include <string.h>
+    #include <sys/syscall.h>
+    #include <sys/wait.h>
+    #include <unistd.h>
+    #define qatomic_load_acquire(p) __atomic_load_n((p), __ATOMIC_ACQUIRE)
+    #define qatomic_store_release(p, v) __atomic_store_n((p), (v), __ATOMIC_RELEASE)
+    #define QEMU_HOT_FORK_THREAD_NAME_MAX 256
+    #define QEMU_HOT_FORK_THREAD_INVENTORY_MAX 65536
+    #define QEMU_RAM_PAUSE_MAX_THREADS 4096
+    #define QEMU_THREAD_JOINABLE 0
+    #define QEMU_THREAD_DETACHED 1
+
+    typedef struct QemuThread QemuThread;
+    typedef struct QemuThreadRamActorBinding QemuThreadRamActorBinding;
+    '''
+    prefix += re.search(
+        r'struct QemuThread \{.*?\n\};',
+        input_file('include/qemu/thread-posix.h').read_text(), re.S,
+    ).group() + '\n'
+    # Emit by-value journal dependencies before their containing owner.
+    for name in [
+        'QemuThreadBoundedCreateReceipt',
+        'QemuThreadHotForkDisposition',
+        'QemuThreadRamPauseRefusal',
+        'QemuRamPauseEndDisposition',
+        'QemuThreadRamPauseTransaction',
+        'QemuThreadRamWriterScope',
+        'QemuThreadRamWriterTransaction',
+        'QemuThreadRamCpuExecutionWitness',
+        'QemuThreadRamCpuConstruction',
+    ]:
+        prefix += typedef(header, name) + '\n'
+    prefix += re.search(
+        r'struct QemuThreadRamActorBinding \{.*?\n\};', source, re.S,
+    ).group() + '\n'
+    prefix += typedef(source, 'QemuHotForkThreadRecord') + '\n'
+    globals_text = source[
+        source.index('static pthread_mutex_t qemu_hot_fork_thread_lock'):
+        source.index('/* Introspection may reenter the registry.')
+    ]
+    # Unrelated registry owners are not part of this finite writer fixture.
+    globals_text = globals_text.replace(
+        'static size_t qemu_hot_fork_thread_starts_in_flight;\n', '',
+    ).replace(
+        'static int64_t qemu_hot_fork_coordinator_thread_id;\n', '',
+    ).replace(
+        'static QemuHotForkThreadRecord *qemu_hot_fork_bounded_threads;\n', '',
+    )
+    prefix += globals_text
+    prefix += '''
+    static _Thread_local unsigned writer_locks;
+    static _Thread_local unsigned native_id_calls;
+
+    static int counted_lock(pthread_mutex_t *mutex)
+    {
+        if (mutex == &ram_writer_lock) {
+            writer_locks++;
+        }
+
+        return pthread_mutex_lock(mutex);
+    }
+
+    static int counted_trylock(pthread_mutex_t *mutex)
+    {
+        if (mutex == &ram_writer_lock) {
+            writer_locks++;
+        }
+
+        return pthread_mutex_trylock(mutex);
+    }
+
+    #define pthread_mutex_lock counted_lock
+    #define pthread_mutex_trylock counted_trylock
+
+    static _Atomic unsigned writer_waits;
+
+    static int counted_wait(pthread_cond_t *condition, pthread_mutex_t *mutex)
+    {
+        if (mutex == &ram_writer_lock) {
+            atomic_fetch_add(&writer_waits, 1);
+        }
+
+        return pthread_cond_wait(condition, mutex);
+    }
+
+    #define pthread_cond_wait counted_wait
+
+    static bool refuse_atfork;
+
+    static int observed_atfork(void (*prepare)(void), void (*parent)(void),
+                               void (*child)(void))
+    {
+        return refuse_atfork ? ENOMEM : pthread_atfork(prepare, parent, child);
+    }
+
+    #define pthread_atfork observed_atfork
+    '''
+    prefix += whole(
+        input_file('util/oslib-posix.c').read_text(), 'qemu_get_thread_id',
+    ).replace(
+        'return syscall(SYS_gettid);',
+        'native_id_calls++;\n    return syscall(SYS_gettid);',
+    ) + '\n'
+    # The sole instrumentation edit counts the actual Linux native ID syscall.
+    prefix += re.search(
+        r'^int64_t qemu_thread_current_id\(void\);$', header, re.M,
+    ).group() + '\n'
+    prefix += source[
+        source.index('/* Linux mutex-owner TIDs'):
+        source.index('/*\n * This is not defined on Linux')
+    ]
+    prefix += '\n' + whole(source, 'error_exit')
+    prefix += ('\n' + whole(source, 'qemu_thread_get_self') + '\n'
+               + whole(source, 'qemu_thread_is_self'))
+    names = [
+        'ram_membership_wait_locked',
+        'ram_writer_record_inherited',
+        'ram_writer_record_current',
+        'ram_writer_record_admit_locked',
+        'ram_writer_promote_nested_locked',
+        'qemu_thread_ram_writer_enter',
+        'qemu_thread_ram_writer_leave',
+        'ram_writer_scope_current_locked',
+        'qemu_thread_ram_writer_scope_enter',
+        'qemu_thread_ram_writer_scope_try_enter',
+        'qemu_thread_ram_writer_scope_leave',
+        'qemu_thread_ram_writer_alias_lend',
+        'qemu_thread_ram_writer_alias_return',
