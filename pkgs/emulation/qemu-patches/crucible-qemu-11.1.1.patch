+    } else if (!strcmp(kind, "process")) {
+        fixture_be64(fixture.frame + 21, 0);
+    } else if (!strcmp(kind, "binding")) {
+        fixture_be64(fixture.frame + 29, 9);
+    } else if (!strcmp(kind, "flags")) {
+        fixture_be32(fixture.frame + 17, 1);
+    } else if (!strcmp(kind, "unknown-flags")) {
+        fixture_be32(fixture.frame + 17, 4);
+    } else if (!strcmp(kind, "schema")) {
+        fixture_be32(fixture.frame + 13, 2);
+    } else if (!strcmp(kind, "present-account")) {
+        count = QEMU_CRUCIBLE_PREEXEC_SETUP_WORKSPACE_FDS;
