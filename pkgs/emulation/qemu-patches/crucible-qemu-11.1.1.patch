+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Exercise guarded production waiter counters with real pthread operations.
+
+The native mutex/condition operations and registry bodies execute unchanged.
+Hook barriers expose transaction boundaries without changing their ordering.
+An optional reference source runs the same checks and must produce the same
+normalized inventory trace. This fixture does not prove a running guest or
+the complete retained-runtime transaction; the owner-cache and hot-fork child
+tests supply the existing native fork and retained-transaction coverage.
+
+Dependencies are Python 3, a C compiler, pthreads, GLib development headers
+and libraries, and the repository headers. CC, CFLAGS, and LDFLAGS select the
+configured source-built toolchain and GLib flags.
+"""
+
+import argparse
+import json
+import os
+from pathlib import Path
+import runpy
+import shlex
+import subprocess
+
+
+ROOT = Path(__file__).resolve().parents[2]
+OWNER_FIXTURE = runpy.run_path(str(Path(__file__).with_name(
+    "test-crucible-mutex-owner-cache.py")))
+definition = OWNER_FIXTURE["definition"]
+
+
+HOOKS = r"""
+#include <time.h>
+
+enum Window { NONE, ADMITTED, NATIVE_ACQUIRED, UNLOCK_BEGIN, NATIVE_UNLOCKED,
+              CONDITION_ONE, CONDITION_TWO };
+
+static QemuMutex tested;
+static QemuCond condition;
+static pthread_mutex_t schedule_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t schedule_changed = PTHREAD_COND_INITIALIZER;
+static enum Window arrived, released;
+static __thread bool expose_lock_windows;
+static __thread enum Window expose_condition_window;
+static bool condition_released;
+
+static void rendezvous(enum Window window)
+{
+    assert(pthread_mutex_lock(&schedule_lock) == 0);
+    arrived = window;
+    assert(pthread_cond_broadcast(&schedule_changed) == 0);
+    while (released != window) {
+        assert(pthread_cond_wait(&schedule_changed, &schedule_lock) == 0);
+    }
+    assert(pthread_mutex_unlock(&schedule_lock) == 0);
+}
+
+static void await_window(enum Window window)
+{
+    assert(pthread_mutex_lock(&schedule_lock) == 0);
+    while (arrived != window) {
+        assert(pthread_cond_wait(&schedule_changed, &schedule_lock) == 0);
+    }
+    assert(pthread_mutex_unlock(&schedule_lock) == 0);
+}
+
+static void release_window(enum Window window)
+{
+    assert(pthread_mutex_lock(&schedule_lock) == 0);
+    released = window;
+    assert(pthread_cond_broadcast(&schedule_changed) == 0);
+    assert(pthread_mutex_unlock(&schedule_lock) == 0);
+}
+
+static void qemu_mutex_pre_lock(QemuMutex *mutex, const char *file, int line)
+{
+    if (mutex == &tested && expose_lock_windows) {
+        rendezvous(ADMITTED);
+    }
+}
+
+static void qemu_mutex_post_lock(QemuMutex *mutex, const char *file, int line)
+{
+    if (mutex == &tested && expose_lock_windows) {
+        rendezvous(NATIVE_ACQUIRED);
+    }
+}
+
+static void qemu_mutex_pre_unlock(QemuMutex *mutex, const char *file, int line)
+{
+    if (mutex == &tested && expose_lock_windows) {
+        rendezvous(UNLOCK_BEGIN);
+    } else if (mutex == &tested && expose_condition_window != NONE) {
+        enum Window window = expose_condition_window;
+
+        expose_condition_window = NONE;
+        rendezvous(window);
+    }
+}
+
+/* The native unlock completes before this barrier and registry completion. */
+static int observed_native_unlock(pthread_mutex_t *mutex)
+{
+    int result = pthread_mutex_unlock(mutex);
+
+    if (result == 0 && mutex == &tested.lock && expose_lock_windows) {
+        rendezvous(NATIVE_UNLOCKED);
+    }
+    return result;
+}
+
+#define pthread_mutex_unlock observed_native_unlock
+#define trace_qemu_mutex_unlock(...) ((void)0)
+#define trace_qemu_mutex_locked(...) ((void)0)
+"""
+
+
+CHECKS = r"""
+#undef pthread_mutex_unlock
+
+static CrucibleHotForkMutexEntry *tested_entry(void)
+{
+    return &crucible_hot_fork_mutexes[tested.crucible_hot_fork_slot];
+}
+
+static void lock_tested(void)
+{
+    qemu_mutex_lock_impl(&tested, __FILE__, __LINE__);
+}
+
+static void unlock_tested(void)
+{
+    qemu_mutex_unlock_impl(&tested, __FILE__, __LINE__);
+}
+
+static void snapshot(const char *label, unsigned depth, unsigned acquiring,
+                     unsigned waiting, bool unlocking, bool valid)
+{
+    QemuMutexHotForkInventory inventory;
+    QemuMutexHotForkInventoryEntry *found = NULL;
+
+    qemu_mutex_hot_fork_inventory(&inventory);
+    g_assert_false(inventory.overflowed);
+    for (size_t i = 0; i < inventory.entry_count; i++) {
+        if (inventory.entries[i].mutex_id ==
+            tested.crucible_hot_fork_registration_id) {
+            found = &inventory.entries[i];
+        }
+    }
+    g_assert_nonnull(found);
+    g_assert_cmpuint(found->recursion_depth, ==, depth);
+    g_assert_cmpuint(found->acquisition_waiters, ==, acquiring);
+    g_assert_cmpuint(found->condition_waiters, ==, waiting);
+    g_assert_cmpint(found->unlock_active, ==, unlocking);
+    g_assert_cmpint(found->ownership_valid, ==, valid);
+    g_assert_cmpint(found->owner_thread_id != 0, ==, depth != 0);
+    printf("%s generation=%" PRIu64 " depth=%u acquiring=%u condition=%u "
+           "unlock=%u valid=%u\n", label, inventory.generation, depth,
+           acquiring, waiting, unlocking, valid);
+    qemu_mutex_hot_fork_inventory_destroy(&inventory);
+}
+
+static void *one_lock_cycle(void *unused)
+{
+    expose_lock_windows = true;
+    lock_tested();
+    unlock_tested();
+    expose_lock_windows = false;
+    return NULL;
+}
+
+static void check_transaction_windows(void)
+{
+    pthread_t worker;
+
+    qemu_mutex_init(&tested);
+    assert(pthread_create(&worker, NULL, one_lock_cycle, NULL) == 0);
+    await_window(ADMITTED);
+    snapshot("admitted", 0, 1, 0, false, true);
+    release_window(ADMITTED);
+    await_window(NATIVE_ACQUIRED);
+    snapshot("native-acquired", 0, 1, 0, false, true);
+    release_window(NATIVE_ACQUIRED);
+    await_window(UNLOCK_BEGIN);
+    snapshot("unlock-begin", 0, 0, 0, true, true);
+    release_window(UNLOCK_BEGIN);
+    await_window(NATIVE_UNLOCKED);
+    snapshot("native-unlocked", 0, 0, 0, true, true);
+    release_window(NATIVE_UNLOCKED);
+    assert(pthread_join(worker, NULL) == 0);
+    snapshot("completed", 0, 0, 0, false, true);
+}
+
+static void *failed_trylock(void *unused)
+{
+    g_assert_cmpint(qemu_mutex_trylock_impl(&tested, __FILE__, __LINE__),
+                    ==, -EBUSY);
+    return NULL;
+}
+
+static void check_trylock(void)
+{
+    pthread_t worker;
+
+    lock_tested();
+    assert(pthread_create(&worker, NULL, failed_trylock, NULL) == 0);
+    assert(pthread_join(worker, NULL) == 0);
+    snapshot("failed-trylock", 1, 0, 0, false, true);
+    unlock_tested();
+    g_assert_cmpint(qemu_mutex_trylock_impl(&tested, __FILE__, __LINE__), ==, 0);
+    snapshot("successful-trylock", 1, 0, 0, false, true);
+    unlock_tested();
+}
+
+static void *condition_waiter(void *window)
+{
+    lock_tested();
+    expose_condition_window = (enum Window)(uintptr_t)window;
+    while (!condition_released) {
+        qemu_cond_wait_impl(&condition, &tested, __FILE__, __LINE__);
+    }
+    unlock_tested();
+    return NULL;
+}
+
+static void check_condition_waiters(void)
+{
+    pthread_t first, second;
+
+    qemu_cond_init(&condition);
+    assert(pthread_create(&first, NULL, condition_waiter,
+                          (void *)(uintptr_t)CONDITION_ONE) == 0);
+    await_window(CONDITION_ONE);
+    snapshot("condition-one", 0, 0, 1, false, true);
+    crucible_hot_fork_mutex_registry_lock();
+    g_assert_cmpint(tested_entry()->condition_waiter_thread_id, >, 0);
+    crucible_hot_fork_mutex_registry_unlock();
+    release_window(CONDITION_ONE);
+
+    assert(pthread_create(&second, NULL, condition_waiter,
+                          (void *)(uintptr_t)CONDITION_TWO) == 0);
+    await_window(CONDITION_TWO);
+    snapshot("condition-two", 0, 0, 2, false, true);
+    crucible_hot_fork_mutex_registry_lock();
+    g_assert_cmpint(tested_entry()->condition_waiter_thread_id, ==, -1);
+    crucible_hot_fork_mutex_registry_unlock();
+    release_window(CONDITION_TWO);
+
+    /* Native acquisition proves both workers reached their atomic waits. */
+    lock_tested();
+    condition_released = true;
+    assert(pthread_cond_broadcast(&condition.cond) == 0);
+    unlock_tested();
+    assert(pthread_join(first, NULL) == 0);
+    assert(pthread_join(second, NULL) == 0);
+    snapshot("condition-completed", 0, 0, 0, false, true);
+    crucible_hot_fork_mutex_registry_lock();
+    g_assert_cmpint(tested_entry()->condition_waiter_thread_id, ==, 0);
+    crucible_hot_fork_mutex_registry_unlock();
+    lock_tested();
+    g_assert_false(qemu_cond_timedwait_impl(&condition, &tested, 0,
+                                           __FILE__, __LINE__));
+    snapshot("condition-timeout", 1, 0, 0, false, true);
+    unlock_tested();
+    qemu_cond_destroy(&condition);
+}
+
+static void *contended_cycles(void *unused)
+{
+    for (unsigned i = 0; i < 2000; i++) {
+        lock_tested();
+        unlock_tested();
+    }
+    return NULL;
+}
+
+static void check_contended_cycles(void)
+{
+    pthread_t workers[8];
+
+    for (size_t i = 0; i < G_N_ELEMENTS(workers); i++) {
+        assert(pthread_create(&workers[i], NULL, contended_cycles, NULL) == 0);
+    }
+    for (size_t i = 0; i < G_N_ELEMENTS(workers); i++) {
+        assert(pthread_join(workers[i], NULL) == 0);
+    }
+    snapshot("contended-completed", 0, 0, 0, false, true);
+}
+
+static void check_error_and_wrap_semantics(void)
+{
+    CrucibleHotForkMutexEntry *entry;
+
+    crucible_hot_fork_mutex_wait_cancel(&tested);
+    snapshot("cancel-underflow", 0, 0, 0, false, false);
+    crucible_hot_fork_mutex_registry_lock();
+    entry = tested_entry();
+    entry->ownership_valid = true;
+    crucible_hot_fork_mutex_registry_unlock();
+    assert(pthread_mutex_lock(&tested.lock) == 0);
+    crucible_hot_fork_mutex_acquired(&tested);
+    snapshot("acquired-underflow", 1, 0, 0, false, false);
+    unlock_tested();
+    crucible_hot_fork_mutex_registry_lock();
+    entry->ownership_valid = true;
+    entry->acquisition_waiters = UINT32_MAX;
+    crucible_hot_fork_mutex_registry_unlock();
+    crucible_hot_fork_mutex_wait_begin(&tested);
+    snapshot("acquisition-wrap", 0, 0, 0, false, true);
+
+    /* Preserve existing unsigned wrap; this change adds no overflow policy. */
+    lock_tested();
+    crucible_hot_fork_mutex_registry_lock();
+    entry->condition_waiters = UINT32_MAX;
+    crucible_hot_fork_mutex_registry_unlock();
+    crucible_hot_fork_mutex_condition_wait_begin(&tested);
+    snapshot("condition-wrap", 0, 0, 0, false, true);
+    crucible_hot_fork_mutex_condition_wait_end(&tested);
+    snapshot("condition-underflow", 1, 0, 0, false, false);
+    crucible_hot_fork_mutex_registry_lock();
+    entry->ownership_valid = true;
+    entry->condition_waiter_thread_id = 0;
+    crucible_hot_fork_mutex_registry_unlock();
+    unlock_tested();
+}
+
+int main(void)
+{
+    check_transaction_windows();
+    check_trylock();
+    check_condition_waiters();
+    check_contended_cycles();
+    check_error_and_wrap_semantics();
+    qemu_mutex_destroy(&tested);
+    return 0;
+}
