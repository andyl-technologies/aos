+/* An actual suspended AHCI completion remains a backend borrower. This
+ * read-only inventory does not create a managed paging admission receipt. */
+static void assert_atapi_backend_borrower(AHCIQState *ahci, bool pending)
+{
+    QDict *reply = qtest_qmp(ahci->parent->qts,
+        "{ 'execute': 'crucible-hot-fork-block-barrier',"
+        "  'arguments': { 'action': 'query' } }");
+    QDict *state;
+
+    g_assert(qdict_haskey(reply, "return"));
+    state = qdict_get_qdict(reply, "return");
+    for (unsigned retry = 0; !pending &&
+         qdict_get_int(state, "in-flight") != 0 && retry < 1000; retry++) {
+        qobject_unref(reply);
+        g_usleep(1000);
+        reply = qtest_qmp(ahci->parent->qts,
+            "{ 'execute': 'crucible-hot-fork-block-barrier',"
+            "  'arguments': { 'action': 'query' } }");
+        g_assert(qdict_haskey(reply, "return"));
+        state = qdict_get_qdict(reply, "return");
+    }
+    g_assert_cmpint(qdict_get_int(state, "schema-version"), ==, 5);
+    g_assert(qdict_get_bool(state, "complete"));
+    g_assert(qdict_get_bool(state, "ram-borrowers-consistent"));
+    g_assert_cmpuint(qdict_get_int(state, "ram-borrow-generation"), >, 0);
+    g_assert(!qdict_get_bool(state, "held"));
+    /* This ATAPI backend pause precedes guest DMA mapping.  It proves only
+     * the block request lifetime; a managed virtqueue flight covers RAM maps. */
+    g_assert_cmpint(qdict_get_int(state, "ram-direct-maps"), ==, 0);
+    if (pending) {
+        g_assert_cmpint(qdict_get_int(state, "in-flight"), >, 0);
+        g_assert(!qdict_get_bool(state, "quiescent"));
+    } else {
+        g_assert_cmpint(qdict_get_int(state, "in-flight"), ==, 0);
+    }
+    qobject_unref(reply);
+}
+
