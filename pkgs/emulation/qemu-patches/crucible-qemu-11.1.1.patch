+    CrucibleCheckpointRestore *report = NULL;
+    uint8_t root_digest[32];
+    uint8_t restored_root[32];
+    uint8_t topology_digest[32];
+    uint8_t session[16];
+    uint8_t owner[16];
+    uint8_t identity[32];
+    uint64_t root_bytes = 0;
+    uint64_t device_bytes = 0;
+    uint64_t restored_ram_bytes = 0;
+    dev_t root_device = 0;
+    dev_t device_device = 0;
+    ino_t root_inode = 0;
+    ino_t device_inode = 0;
+    bool reserved = false;
+    bool prepared = false;
+    bool commit_started = false;
+    bool state_changed = false;
+    int status;
+    bool selectable_operation = false;
+
+    status = qemu_crucible_selectable_restore_begin();
+    if (status) {
+        error_setg_errno(errp, -status,
+                         "Lazy restore conflicts with a staged selectable reset");
+        goto out;
+    }
+    selectable_operation = true;
+    qemu_crucible_cold_stop_invalidate();
+    if (!crucible_restore_exact_paused_boundary() ||
+        qemu_crucible_checkpoint_candidate_active()) {
+        error_setg(errp, "Crucible lazy restore requires a paused deterministic "
+                   "boundary without a pending checkpoint candidate");
+        goto out;
+    }
+    if (source_generation == 0 ||
+        !crucible_restore_hex(root_blake3, root_digest, "RAM root", errp) ||
+        !crucible_restore_hex(topology_blake3, topology_digest, "topology", errp) ||
+        !crucible_restore_hex_bytes(source_session, session, sizeof(session),
+                                    "source session", errp) ||
+        !crucible_restore_hex_bytes(source_owner, owner, sizeof(owner),
+                                    "source owner", errp) ||
+        !crucible_restore_hex(checkpoint_sha256, identity, "checkpoint", errp) ||
+        !crucible_restore_hex(target_sha256, identity, "target", errp) ||
+        !crucible_restore_hex(frontier_sha256, identity, "frontier", errp)) {
+        if (!*errp) {
+            error_setg(errp, "Crucible lazy restore source generation is empty");
+        }
+        goto out;
+    }
+    if (!crucible_restore_regular_input(
+            root_fd, CRUCIBLE_RESTORE_ROOT_MAX_BYTES, &root_bytes,
+            &root_device, &root_inode, "RAM root metadata", errp) ||
+        !crucible_restore_regular_input(
+            device_fd, maximum_device_bytes, &device_bytes,
+            &device_device, &device_inode, "device VMState", errp) ||
+        !crucible_restore_authenticate(device_fd, device_bytes, device_sha256,
+                                       cancellation_fd, errp)) {
+        goto out;
+    }
+    if (root_device == device_device && root_inode == device_inode) {
+        error_setg(errp, "Crucible root metadata and device VMState must not alias");
+        goto out;
+    }
+    root_record = g_try_malloc(root_bytes);
+    if (!root_record) {
+        error_setg(errp, "Crucible lazy restore metadata allocation failed");
+        goto out;
+    }
+    if (!crucible_restore_read(root_fd, root_bytes, 0, root_record, root_bytes,
+                               cancellation_fd, errp)) {
+        goto out;
+    }
+    status = migration_crucible_checkpoint_restore_begin();
+    if (status != 0) {
+        error_setg_errno(errp, -status, "Crucible lazy restore is unavailable");
+        goto out;
+    }
+    reserved = true;
+
+    /* The concrete GPL binder decodes the canonical record, checks the entire
+     * realized inventory, and reserves mapping/source/root-cache state before
+     * any reset or discard. A missing binder is a hard refusal. */
+    qemu_plugin_crucible_exact_boundary_enter();
+    status = qemu_plugin_crucible_ram_restore_prepare_v1(
+        root_record, root_bytes, root_digest, topology_digest, session, owner,
+        source_generation, CRUCIBLE_RESTORE_SOURCE_FD, cancellation_fd);
+    qemu_plugin_crucible_exact_boundary_leave();
+    if (status != 0) {
+        error_setg_errno(errp, status < 0 ? -status : EIO,
+                         "Could not prepare authenticated lazy RAM restore");
+        goto out;
+    }
+    prepared = true;
+    if (crucible_restore_cancelled(cancellation_fd, errp)) {
+        goto out;
+    }
+
+    qemu_system_reset(SHUTDOWN_CAUSE_SNAPSHOT_LOAD);
+    state_changed = true;
+    if (!crucible_restore_exact_paused_boundary()) {
+        error_setg(errp, "Crucible reset lost the paused deterministic "
+                   "restore boundary");
+        goto out;
+    }
+    commit_started = true;
+    qemu_plugin_crucible_exact_boundary_enter();
+    status = qemu_plugin_crucible_ram_restore_commit_v1();
+    qemu_plugin_crucible_exact_boundary_leave();
+    if (status != 0) {
+        error_setg_errno(errp, status < 0 ? -status : EIO,
+                         "Could not install authenticated lazy RAM mapping");
+        goto out;
+    }
+    if (crucible_restore_cancelled(cancellation_fd, errp)) {
+        goto out;
+    }
+    status = crucible_restore_device_state(device_fd, errp);
+    device_fd = -1;
+    if (status != 0 || crucible_restore_cancelled(cancellation_fd, errp)) {
+        goto out;
+    }
+    tb_flush__exclusive_or_serial();
+    if (!crucible_restore_exact_paused_boundary()) {
+        error_setg(errp, "Crucible device reconstruction lost the paused "
+                   "deterministic restore boundary");
+        goto out;
+    }
+
+    /* Device reconstruction can write RAM. The independent root consumer
+     * incorporates those writes before authority is granted; unchanged opaque
+     * source regions retain their authenticated commitments without a walk. */
+    qemu_plugin_crucible_exact_boundary_enter();
+    status = qemu_crucible_ram_root(1, restored_root, &restored_ram_bytes);
+    qemu_plugin_crucible_exact_boundary_leave();
+    if (status != 0) {
+        error_setg_errno(errp, status < 0 ? -status : EIO,
+                         "Could not verify reconstructed lazy RAM identity");
+        goto out;
+    }
+    if (memcmp(restored_root, root_digest, sizeof(root_digest)) != 0) {
+        error_setg(errp, "Crucible device reconstruction changed the "
+                   "authenticated RAM root");
+        goto out;
+    }
+    if (crucible_restore_cancelled(cancellation_fd, errp)) {
+        goto out;
+    }
+    if (!qemu_crucible_checkpoint_restore_authority_succeeded(
+            checkpoint_sha256, target_sha256, frontier_sha256,
+            root_digest, errp)) {
+        goto out;
+    }
+
+    report = g_new0(CrucibleCheckpointRestore, 1);
+    report->schema_version = CRUCIBLE_CHECKPOINT_SCHEMA_VERSION;
+    report->checkpoint_sha256 = g_strdup(checkpoint_sha256);
+    report->target_sha256 = g_strdup(target_sha256);
+    report->frontier_sha256 = g_strdup(frontier_sha256);
+    report->ram_root_blake3 = g_strdup(root_blake3);
+    report->topology_blake3 = g_strdup(topology_blake3);
+    report->source_session = g_strdup(source_session);
+    report->source_owner = g_strdup(source_owner);
+    report->source_generation = source_generation;
+    report->ram_bytes = 0;
+    report->device_bytes = device_bytes;
+
+out:
+    /* After discard begins, registration and the source remain owned until
+     * the failed process is contained. An abort cannot reconstruct old RAM. */
+    if (prepared && !commit_started) {
+        status = qemu_plugin_crucible_ram_restore_abort_v1();
+        if (status != 0 && !*errp) {
+            error_setg_errno(errp, status < 0 ? -status : EIO,
+                             "Could not retire staged lazy restore");
+        }
+    }
+    if (state_changed && !report) {
+        qemu_crucible_checkpoint_restore_authority_failed();
+    }
+    if (reserved) {
+        migration_crucible_checkpoint_capture_end();
+    }
+    if (root_fd >= 0) {
+        close(root_fd);
+    }
+    if (device_fd >= 0) {
+        close(device_fd);
+    }
+    if (selectable_operation) {
+        if (state_changed && !report) {
+            qemu_crucible_selectable_restore_uncertain();
+        }
+        qemu_crucible_selectable_restore_end();
+    }
+    return report;
+}
