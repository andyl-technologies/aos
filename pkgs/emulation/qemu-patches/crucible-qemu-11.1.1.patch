+
+#include "qemu/osdep.h"
+
+#include <sys/syscall.h>
+
+#include "qemu/ctype.h"
+#include "system/crucible-hot-fork-plugin-child.h"
+
+typedef struct QemuCrucibleLinuxDirent64 {
+    uint64_t inode;
+    int64_t offset;
+    unsigned short record_length;
+    unsigned char type;
+    char name[];
+} QemuCrucibleLinuxDirent64;
+
+bool qemu_crucible_hot_fork_plugin_child_plan_valid(
+    const struct qemu_plugin_crucible_hot_fork_child_plan *plan)
+{
+    return plan &&
+        plan->schema_version ==
+            QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PLAN_VERSION &&
+        plan->struct_size == sizeof(*plan) && plan->flags == 0 &&
+        plan->reserved == 0 && plan->reserved_fd == -1 &&
+        plan->parent_process_generation != 0 &&
+        plan->parent_process_generation != UINT64_MAX &&
+        plan->child_process_generation ==
+            plan->parent_process_generation + 1 &&
+        plan->template_generation != 0 &&
+        plan->private_ring_generation != 0 &&
+        plan->plugin_endpoint_generation != 0 &&
+        plan->plugin_barrier_generation != 0 &&
+        plan->control_socket_cookie != 0 && plan->wake_eventfd_id != 0 &&
+        plan->private_ring_fd >= 0 && plan->control_fd >= 0 &&
+        plan->wake_fd >= 0 && plan->control_fd != plan->wake_fd &&
+        plan->private_ring_fd != plan->control_fd &&
+        plan->private_ring_fd != plan->wake_fd &&
+        plan->shmem_inode != 0 && plan->shmem_length != 0 &&
+        plan->source_mapping_start != 0 &&
+        /*
+         * The setup region length is exact; the VMA that carries it spans
+         * whole pages, so the mapping extent is its page-rounded length.
+         */
+        plan->source_mapping_length >= plan->shmem_length &&
+        plan->source_mapping_length - plan->shmem_length <
+            qemu_real_host_page_size() &&
+        plan->source_mapping_offset == 0 &&
+        QEMU_IS_ALIGNED(plan->source_mapping_start,
+                        qemu_real_host_page_size()) &&
+        QEMU_IS_ALIGNED(plan->source_mapping_length,
+                        qemu_real_host_page_size()) &&
+        plan->source_mapping_start <= UINTPTR_MAX &&
+        plan->source_mapping_length <= SIZE_MAX &&
+        plan->source_mapping_start <=
+            UINTPTR_MAX - plan->source_mapping_length;
+}
+
+int qemu_crucible_hot_fork_prepare_plugin_child_reinitializer(
+    QemuCrucibleHotForkPluginChildReinitializer *reinitializer,
+    const struct qemu_plugin_crucible_hot_fork_child_plan *plan)
+{
+    if (!reinitializer ||
+        !qemu_crucible_hot_fork_plugin_child_plan_valid(plan)) {
+        return -EINVAL;
+    }
+
+    *reinitializer = (QemuCrucibleHotForkPluginChildReinitializer) {
+        .plan = *plan,
+        .prepared = true,
+    };
+    return 0;
+}
+
+static bool crucible_hot_fork_plugin_child_plans_equal(
+    const struct qemu_plugin_crucible_hot_fork_child_plan *left,
+    const struct qemu_plugin_crucible_hot_fork_child_plan *right)
+{
+    return left->schema_version == right->schema_version &&
+        left->struct_size == right->struct_size &&
+        left->flags == right->flags && left->reserved == right->reserved &&
+        left->parent_process_generation ==
+            right->parent_process_generation &&
+        left->child_process_generation == right->child_process_generation &&
+        left->template_generation == right->template_generation &&
+        left->private_ring_generation == right->private_ring_generation &&
+        left->plugin_endpoint_generation ==
+            right->plugin_endpoint_generation &&
+        left->plugin_barrier_generation ==
+            right->plugin_barrier_generation &&
+        left->worker_mask == right->worker_mask &&
+        left->control_socket_cookie == right->control_socket_cookie &&
+        left->wake_eventfd_id == right->wake_eventfd_id &&
+        left->shmem_device == right->shmem_device &&
+        left->shmem_inode == right->shmem_inode &&
+        left->shmem_length == right->shmem_length &&
+        left->source_mapping_start == right->source_mapping_start &&
+        left->source_mapping_length == right->source_mapping_length &&
+        left->source_mapping_offset == right->source_mapping_offset &&
+        left->private_ring_fd == right->private_ring_fd &&
+        left->control_fd == right->control_fd &&
+        left->wake_fd == right->wake_fd &&
+        left->reserved_fd == right->reserved_fd;
+}
+
+static void crucible_hot_fork_sort_three_fds(int fds[3])
+{
+    int temporary;
+
+    if (fds[0] > fds[1]) {
+        temporary = fds[0];
+        fds[0] = fds[1];
+        fds[1] = temporary;
+    }
+    if (fds[1] > fds[2]) {
+        temporary = fds[1];
+        fds[1] = fds[2];
+        fds[2] = temporary;
+    }
+    if (fds[0] > fds[1]) {
+        temporary = fds[0];
+        fds[0] = fds[1];
+        fds[1] = temporary;
+    }
+}
+
+static void crucible_hot_fork_sort_two_replacements(
+    QemuCrucibleHotForkDescriptorReplacement replacements[2])
+{
+    if (replacements[0].target_fd > replacements[1].target_fd) {
+        QemuCrucibleHotForkDescriptorReplacement temporary = replacements[0];
+
+        replacements[0] = replacements[1];
+        replacements[1] = temporary;
+    }
+}
+
+int qemu_crucible_hot_fork_prepare_plugin_child_resources(
+    QemuCrucibleHotForkPluginChildResourcePlan *resources,
+    const struct qemu_plugin_crucible_hot_fork_child_plan *plan,
+    int control_source_fd, int wake_source_fd)
+{
+    QemuCrucibleHotForkPluginChildResourcePlan prepared = { 0 };
+
+    if (!resources ||
+        !qemu_crucible_hot_fork_plugin_child_plan_valid(plan) ||
+        control_source_fd < 0 || wake_source_fd < 0 ||
+        control_source_fd == wake_source_fd ||
+        control_source_fd == plan->private_ring_fd ||
+        control_source_fd == plan->control_fd ||
+        control_source_fd == plan->wake_fd ||
+        wake_source_fd == plan->private_ring_fd ||
+        wake_source_fd == plan->control_fd ||
+        wake_source_fd == plan->wake_fd) {
+        return -EINVAL;
+    }
+
+    prepared.plan = *plan;
+    prepared.replacements[0] = (QemuCrucibleHotForkDescriptorReplacement) {
+        .source_fd = control_source_fd,
+        .target_fd = plan->control_fd,
+    };
+    prepared.replacements[1] = (QemuCrucibleHotForkDescriptorReplacement) {
+        .source_fd = wake_source_fd,
+        .target_fd = plan->wake_fd,
+    };
+    crucible_hot_fork_sort_two_replacements(prepared.replacements);
+    prepared.retained_fds[0] = plan->private_ring_fd;
+    prepared.retained_fds[1] = plan->control_fd;
+    prepared.retained_fds[2] = plan->wake_fd;
+    crucible_hot_fork_sort_three_fds(prepared.retained_fds);
+    prepared.shared_mappings[0] = (QemuCrucibleHotForkSharedMapping) {
+        .start = plan->source_mapping_start,
+        .length = plan->source_mapping_length,
+        .offset = plan->source_mapping_offset,
+        .backing_fd = plan->private_ring_fd,
+    };
+    prepared.prepared = true;
+    *resources = prepared;
+    return 0;
+}
+
+bool qemu_crucible_hot_fork_plugin_child_resources_prepared_for(
+    const QemuCrucibleHotForkPluginChildResourcePlan *resources,
+    const struct qemu_plugin_crucible_hot_fork_child_plan *plan,
