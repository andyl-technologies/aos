+static void test_ram_scheduled_coalesced_rerun(void)
+{
+    RamScheduledTest state = {
+        .owner_thread = qemu_get_thread_id(), .request_rerun = true,
+    };
+    unsigned before_events = coordinator_test.event_count;
+    unsigned before_diagnostics = owner_diagnostic_calls;
+
+    ram_test_paused = true;
+    ram_test_quiesced = true;
+    g_assert_cmpint(qemu_crucible_ram_schedule_on_main_loop(
+                       ram_scheduled_callback, &state), ==, 0);
+    bql_lock();
+    main_loop_wait(false);
+    g_assert_cmpuint(state.calls, ==, 1);
+    /* A coalesced placement rerun keeps priority over the diagnostic. */
+    g_assert_cmpuint(owner_diagnostic_calls, ==, before_diagnostics);
+    main_loop_wait(false);
+    bql_unlock();
+    g_assert_cmpuint(state.calls, ==, 2);
+    g_assert_cmpuint(owner_diagnostic_calls, ==, before_diagnostics + 1);
