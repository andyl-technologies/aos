+    qtest_qmp_assert_success(qts,
+        "{'execute':'remove-fd','arguments':{'fdset-id':1}}");
+    qtest_qmp_assert_success(qts,
+        "{'execute':'blockdev-del','arguments':{'node-name':'vmstate-test'}}");
+    crucible_assert_fdsets_empty(qts);
+
+    close(original_fd);
+    close(replacement_fd);
+    qtest_quit(qts);
