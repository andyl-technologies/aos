+                .serial = ++startup_source.standing.operation_serial,
+                .class_index = UINT32_MAX,
+                .start_ns = now, .progress_ns = now, .last_now_ns = now,
+                .admitted = startup_source.standing.current, .held = true,
+            },
+            .main_observer = {
+                .current = startup_source.standing.current,
