+    literal += '\n' + extract(service_source,
+        'static int startup_setup_service_return_boundary_current(')
+    child_source = (args.source_root / 'plugins/crucible-callback-child.inc.h').read_text()
+    literal += '\n' + '\n'.join(extract(child_source, signature) for signature in (
+        'static bool callback_child_output_overlap(',
+        'static bool callback_child_output_conflicts_except_locked(',
+        'static bool callback_child_output_conflicts_locked(',
+    ))
+    debts = re.findall(r'!startup_source\.([a-z_.]+)',
+                      extract(source, 'static bool publisher_service_users_drained('))
+    debt_values = {
+        'advance_holder': '&startup_source.advance_receiver',
+        'control_callback.command_member': '(void *)&startup_source',
+        'standing.cleanup_execution': '(void *)&startup_source',
+    }
+    checks = '\n'.join(
+        f'    startup_source.{field} = ' + debt_values.get(field, '1') + ';\n'
+        f'    assert(!publisher_service_users_drained());\n'
+        f'    startup_source.{field} = 0;'
+        for field in debts)
+    # These local records exercise only physical closure facts, not an issuer.
+    group_fields = ('held', 'creation_owner', 'holder', 'runtime_holder',
+                    'span_held', 'native_debt', 'receipt_active', 'terminal_active')
+    group_slots = re.findall(r'&startup_source\.callback_groups\.([a-z_]+),',
+        extract(source, 'static bool publisher_service_groups_drained('))
+    assert len(group_slots) == 11 and len(set(group_slots)) == 11
+    group_checks = ['    assert(publisher_service_groups_drained());']
+    for slot in group_slots:
+        for field in group_fields:
+            value = '(void *)&startup_source' if field in (
+                'creation_owner', 'holder', 'runtime_holder') else 'true'
+            group_checks += [
+                f'    startup_source.callback_groups.{slot}.{field} = {value};',
+                '    assert(!publisher_service_groups_drained());',
+                f'    startup_source.callback_groups.{slot}.{field} = 0;',
+            ]
+    checks += '\n' + '\n'.join(group_checks)
+    controls = {'positive': literal}
+    group_assertions = {}
+    for field in group_fields:
+        name = 'omit-source-group-' + field.replace('_', '-')
+        before = '!group->' + field
+        assert literal.count(before) == 1
+        controls[name] = literal.replace(before, 'true', 1)
+        group_assertions[name] = '!publisher_service_groups_drained()'
+    for slot in group_slots:
+        name = 'omit-source-group-slot-' + slot.replace('_', '-')
+        before = '        &startup_source.callback_groups.' + slot + ',\n'
+        assert literal.count(before) == 1
+        controls[name] = literal.replace(before, '', 1)
+        group_assertions[name] = '!publisher_service_groups_drained()'
+
+    for field in debts:
+        controls['omit-debt-' + field.replace('.', '-')] = literal.replace(
+            '!startup_source.' + field, 'true', 1)
+    for name, before, after in (
+        ('exclusive-service-field', '        startup_source.publisher_module.runtime_holder,', ''),
+        ('lower-return-frame',
+         'return qemu_plugin_crucible_publisher_service_return_frame_current_v1(\n            service->cleanup_frame, &startup_source.control_callback,\n            startup_source.control_callback.holder);', 'return 0;'),
+        ('physical-return', 'service->returned && service->held', 'service->held'),
+        ('independent-identity', '!identity && service->returned', 'service->returned'),
+        ('once-only-debit', 'service->returned && service->held', 'service->returned'),
+        ('runtime-holder', '*service->runtime_holder = NULL;', '(void)service;'),
+        ('owner-reverse', 'owner->publisher_service = NULL;', '(void)owner;'),
+        ('owner-debit', 'owner->service_users--;', '(void)owner;'),
+        ('held-debt', 'service->held = false;', '(void)service;'),
+        ('nominal-holder', 'service->holder = NULL;', '(void)service;'),
+        ('span-overflow', 'extent <= UINTPTR_MAX - base', 'true'),
+        ('span-alignment', 'address % _Alignof(QemuCruciblePublisherModuleService *) == 0', 'true'),
+        ('span-last-byte', 'address - base <= extent - sizeof(QemuCruciblePublisherModuleService *)',
+         'address - base <= extent'),
+    ):
+        controls['omit-' + name] = literal.replace(before, after)
+    native = (args.source_root / 'plugins/api-system.c').read_text()
+    native_record = native[native.rindex('static struct {', 0,
+        native.index('} fingerprint_control_component;')):
+        native.index('} fingerprint_control_component;') + len('} fingerprint_control_component;')]
+    watcher = native[native.index('struct QemuCrucibleFingerprintWakeWatcher {'):
+        native.index('static uint64_t fingerprint_wake_registration_serial;')]
+    declarations = '\n'.join(re.search(r'^.*\b' + name + r';$', native, re.M)[0]
+        for name in ('qemu_plugin_control_boundary_cb',
+            'qemu_plugin_control_boundary_scheduled', 'qemu_plugin_control_boundary_deferred',
+            'qemu_plugin_rr_control_request_generation', 'qemu_plugin_rr_control_complete_generation',
+            'qemu_plugin_crucible_control_boundary_depth'))
+    threads = (args.source_root / 'util/qemu-thread-posix.c').read_text()
+    native_literal = native_record + '\n' + watcher + declarations + '\n' + '\n'.join(
+        extract(threads, signature) for signature in (
+            'void qemu_thread_get_self(', 'bool qemu_thread_is_self('))
+    native_literal += '\nstatic uint64_t fingerprint_wake_registration_serial;\n'
+    native_literal += extract(native, 'size_t qemu_plugin_crucible_wake_watcher_storage_bytes_v1(')
+    native_literal += '\n' + '\n'.join(extract(native, signature) for signature in (
+        'bool qemu_plugin_crucible_rr_control_boundary_pending(',
+        'int qemu_plugin_crucible_control_component_returned_current_v1(',
+        'int qemu_plugin_crucible_publisher_service_return_frame_current_v1(',
+        'int qemu_plugin_crucible_control_component_return_v1(',
+    ))
+    native_fields = {
+        'frame->canonical_owner': ('NULL', 'frame', '-ESTALE',
+                                  'frame->canonical_owner != frame'),
+        'frame->active': ('false', 'true', '-ESTALE', '!frame->active'),
+        'frame->process': ('getpid() + 1', 'getpid()', '-ESTALE',
+                          'frame->process != getpid()'),
+        'frame->component': ('NULL', '&component', '-ESTALE',
+                            'frame->component != component'),
+        'frame->holder': ('NULL', '&holder', '-ESTALE', 'frame->holder != holder'),
+        'fingerprint_control_component.registered': ('true', 'false', '-EBUSY',
+            'fingerprint_control_component.registered'),
+        'fingerprint_control_component.detached': ('false', 'true', '-EBUSY',
+            '!fingerprint_control_component.detached'),
+        'fingerprint_wake_watcher.reading': ('true', 'false', '-EBUSY',
+                                           'fingerprint_wake_watcher.reading'),
+        'fingerprint_wake_watcher.snapshotting': ('true', 'false', '-EBUSY',
+                                                'fingerprint_wake_watcher.snapshotting'),
+        'qemu_plugin_control_boundary_scheduled': ('1', '0', '-EBUSY',
+            'qatomic_load_acquire(&qemu_plugin_control_boundary_scheduled)'),
+        'qemu_plugin_control_boundary_deferred': ('true', 'false', '-EBUSY',
+            'qatomic_load_acquire(&qemu_plugin_control_boundary_deferred)'),
+        'qemu_plugin_crucible_control_boundary_depth': ('1', '0', '-EBUSY',
+            'qemu_plugin_crucible_control_boundary_depth'),
+    }
+    native_checks = NATIVE_CHECKS.replace('NATIVE_MUTATIONS', '\n'.join(
+        f'    {field} = {bad};\n    assert(CURRENT() == {status});\n    {field} = {good};'
+        for field, (bad, good, status, condition) in native_fields.items()))
+    for name in list(controls):
+        controls[name] += '\n' + native_literal
+    complete = controls['positive']
+    for field, (_, _, _, condition) in native_fields.items():
+        cut = native_literal.index('int qemu_plugin_crucible_control_component_returned_current_v1(')
+        changed = native_literal[:cut] + native_literal[cut:].replace(condition, 'false', 1)
+        controls['omit-native-' + field.replace('->', '-').replace('.', '-')] = literal + '\n' + changed
+    for name, condition in (
+        ('canonical-address', 'frame != &fingerprint_control_component.service_return'),
+        ('thread', '!qemu_thread_is_self(&frame->thread)'),
+        ('zero-serial', '!frame->serial'),
+        ('max-serial', 'frame->serial == UINT64_MAX'),
+    ):
+        controls['omit-native-' + name] = literal + '\n' + native_literal.replace(condition, 'false', 1)
+    controls['omit-native-static-floor'] = literal + '\n' + native_literal.replace(
+        'sizeof(fingerprint_control_component)',
+        'offsetof(typeof(fingerprint_control_component), service_return)', 1)
+    for name, before, after in (
+        ('known-unavailable-before-entry',
+         'if (first) {\n        return first;\n    }\n    /* This actual detached',
+         '/* This actual detached'),
+        ('retained-entry', 'frame->active || frame->retained ||', 'frame->active ||'),
+        ('active-entry', 'frame->active || frame->retained ||', 'frame->retained ||'),
+        ('nonwrapping-entry', 'frame->serial >= UINT64_MAX - 1', 'false'),
+    ):
+        controls['omit-native-' + name] = literal + '\n' + native_literal.replace(before, after, 1)
+    assertions = {
+        'omit-exclusive-service-field': 'callback_child_output_conflicts_locked(&fields[0], sizeof(fields[0]))',
+        'omit-physical-return': 'service.held && fields[0] == &service && owner.service_users == 1',
+        'omit-independent-identity': 'service.held && fields[0] == &service && owner.service_users == 1',
+        'omit-once-only-debit': '!owner.service_users && !owner.publisher_service && !fields[0]',
+        'omit-runtime-holder': '!service.held && !fields[0] && !owner.service_users',
+        'omit-owner-debit': '!service.held && !fields[0] && !owner.service_users',
+        'omit-held-debt': '!service.held && !fields[0] && !owner.service_users',
+        'omit-owner-reverse': '!owner.publisher_service && !service.holder && !service.transition_active',
+        'omit-nominal-holder': '!owner.publisher_service && !service.holder && !service.transition_active',
+        'omit-span-overflow': '!publisher_service_runtime_span(UINTPTR_MAX - 7, 8,',
+        'omit-span-alignment': '!publisher_service_runtime_span(base, sizeof(fields), (void *)(base + 1))',
+        'omit-span-last-byte': '!publisher_service_runtime_span(base, sizeof(fields) - 1, &fields[3])',
+        'omit-lower-return-frame': 'startup_setup_service_return_boundary_current( &startup_source.publisher_module) == -ESTALE',
+        'omit-native-canonical-address': '&copied, &component, &holder) == -ESTALE',
+        'omit-native-thread': 'frame, frame->component, frame->holder) == -ESTALE',
+        'omit-native-zero-serial': 'CURRENT() == -ESTALE',
+        'omit-native-max-serial': 'CURRENT() == -ESTALE',
+        'omit-native-static-floor': 'qemu_plugin_crucible_wake_watcher_storage_bytes_v1() ==',
+        'omit-native-known-unavailable-before-entry': 'drain_calls == 1 && !source_return_calls && !component_return_calls',
+    }
+    assertions.update(group_assertions)
+    for field in debts:
+        assertions['omit-debt-' + field.replace('.', '-')] = '!publisher_service_users_drained()'
+    for field, (_, _, status, _) in native_fields.items():
+        assertions['omit-native-' + field.replace('->', '-').replace('.', '-')] = 'CURRENT() == ' + status
+    for name in ('retained-entry', 'active-entry', 'nonwrapping-entry'):
+        assertions['omit-native-' + name] = 'qemu_plugin_crucible_control_component_return_v1(&holder) == -EBUSY'
+    manifest = {}
+    for name, body in controls.items():
+        if name != 'positive' and body == complete:
+            raise ValueError(f'unchanged omission: {name}')
+        generated = args.output_dir / f'{name}.c'
+        generated.write_text(PREFIX + body + native_checks +
+            CHECKS.replace('DRAIN_CHECKS', checks).replace(
+                '    QemuCruciblePublisherModuleService *fields',
+                '    native_physical_checks();\n    QemuCruciblePublisherModuleService *fields'))
+        binary = args.output_dir / name
+        command = [os.environ.get('CC', 'cc'),
+                   *shlex.split(os.environ.get('CFLAGS', '')), str(generated),
+                   '-o', str(binary), *shlex.split(os.environ.get('LDFLAGS', ''))]
+        (args.output_dir / f'{name}.command.json').write_text(json.dumps(command, indent=2) + '\n')
+        result = subprocess.run(command, capture_output=True, text=True)
+        (args.output_dir / f'{name}.compile.log').write_text(result.stdout + result.stderr)
+        result.check_returncode()
+        result = subprocess.run([str(binary)], capture_output=True, text=True, timeout=30)
+        output = result.stdout + result.stderr
+        (args.output_dir / f'{name}.run.log').write_text(output)
+        if name == 'positive':
+            if result.returncode:
+                raise RuntimeError(output)
+        elif (result.returncode != -signal.SIGABRT or
+              assertions[name] not in output or 'Assertion' not in output):
+            raise RuntimeError(f'{name}: unexpected exit {result.returncode}: {output}')
+        manifest[name] = {'exit': result.returncode,
+                          'assertion': assertions.get(name),
+                          'scope': 'literal physical leaf / negative-only unavailable bridge'}
+    (args.output_dir / 'controls.json').write_text(json.dumps(manifest, indent=2) + '\n')
+    print(f'{len(controls) - 1} independently rebuilt physical-leaf omissions; no canonical issuer')
+
+
+if __name__ == '__main__':
+    main()
