+    out->fault_commands_arena_headers_offset = (out->fault_commands_end + UINT64_C(127)) & ~UINT64_C(127);
+
+    out->fault_commands_arena_headers_extent = (uint64_t)vm_count * UINT64_C(128);
+
+    if (out->fault_commands_arena_headers_extent > UINT64_MAX - out->fault_commands_arena_headers_offset) {
+        return -EOVERFLOW;
+    }
+    out->fault_commands_arenas_offset = out->fault_commands_arena_headers_offset + out->fault_commands_arena_headers_extent;
+
+    out->fault_commands_arenas_extent = (uint64_t)vm_count * (uint64_t)fault_payload_arena_bytes;
+
+    if (out->fault_commands_arenas_extent > UINT64_MAX - out->fault_commands_arenas_offset) {
+        return -EOVERFLOW;
+    }
+    out->fault_commands_arenas_end = out->fault_commands_arenas_offset + out->fault_commands_arenas_extent;
+
+    if (out->fault_commands_arenas_end > UINT64_MAX - UINT64_C(127)) {
+        return -EOVERFLOW;
+    }
+    out->fault_results_headers_offset = (out->fault_commands_arenas_end + UINT64_C(127)) & ~UINT64_C(127);
+
+    out->fault_results_ring_count = (uint64_t)vm_count * UINT64_C(1);
+
+    if (UINT64_C(128) && out->fault_results_ring_count > UINT64_MAX / UINT64_C(128)) {
+        return -EOVERFLOW;
+    }
+    out->fault_results_headers_extent = out->fault_results_ring_count * UINT64_C(128);
