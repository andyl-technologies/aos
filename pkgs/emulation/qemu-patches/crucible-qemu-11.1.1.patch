+int qemu_crucible_checkpoint_inventory_end_v1(
+    QemuCrucibleCheckpointInventoryLoan **owner, int first_status)
+{
+    QemuCrucibleCheckpointInventoryLoan *loan;
+    int status;
+
+    if (!owner || !(loan = *owner)) {
+        return -EINVAL;
+    }
+    status = checkpoint_inventory_identity(loan);
+    if (status || loan->capture || loan->observer_invoking || !loan->post_recorded ||
+        loan->output.held || loan->output.close_uncertain ||
+        loan->cancellation.held || loan->cancellation.close_uncertain) {
+        return status ? status : -EBUSY;
+    }
+    if (first_status && !loan->first_status) {
+        loan->first_status = first_status;
+    }
+    if (loan->metadata_borrow) {
+#ifdef CONFIG_LINUX
+        status = qemu_crucible_startup_source_checkpoint_inventory_metadata_return_v1(
+            loan, &loan->metadata_borrow);
+#else
+        status = -ENOTSUP;
+#endif
+        loan->metadata_return_status = status;
+        if (loan->metadata_borrow) {
+            return status ? status : -EBUSY;
+        }
+    }
+    /* Identity-only child consumption neither renews nor ends its parent. */
+    loan->active = false;
+    *owner = NULL;
+    return loan->first_status ? loan->first_status :
+        loan->post_status ? loan->post_status : loan->metadata_return_status;
+}
