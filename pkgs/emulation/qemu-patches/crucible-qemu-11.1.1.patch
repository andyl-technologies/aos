+int qemu_thread_tryjoin(QemuThread *thread, void **result)
+{
+#ifdef CONFIG_LINUX
+    void *joined;
+    int status;
+
+    if (!thread || !result) {
+        return -EINVAL;
+    }
+    status = pthread_tryjoin_np(thread->thread, &joined);
+    if (status) {
+        return -status;
+    }
+    *result = joined;
+    return 0;
+#else
+    return -ENOTSUP;
+#endif
+}
