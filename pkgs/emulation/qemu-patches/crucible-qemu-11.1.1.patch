+void qemu_plugin_fire_control_boundary_cb(CPUState *cpu)
+{
+    if (cpu) {
+        QemuCrucibleNativeGroupDescriptorView actual;
+        QemuCrucibleNativeGroupUse use =
+            qemu_plugin_crucible_native_group_use_begin_v1(
+                &native_callback_registrations.control,
+                qemu_plugin_crucible_native_control_descriptor_observe_v1, 0,
+                &actual);
+        qemu_plugin_vcpu_idle_resume_cb_t cb = actual.function;
+        uint64_t observed_icount = qemu_plugin_icount_raw();
+
+        g_assert(qemu_plugin_crucible_control_boundary_depth < UINT_MAX);
+        qemu_plugin_crucible_control_boundary_depth++;
+        qemu_plugin_crucible_exact_boundary_enter();
+        qemu_crucible_fault_lifecycle_ready_marker_control_boundary(
+            observed_icount);
+        if (cb && qemu_plugin_crucible_startup_source_retained()) {
+            control_stop_dispatch(cpu, &use, cb, actual.userdata, observed_icount);
+        } else if (cb) {
+            qemu_plugin_trace_control_delivery("registered-enter");
+            cb(cpu->cpu_index, observed_icount, actual.userdata);
+            qemu_plugin_trace_control_delivery("registered-return");
+        }
+        qemu_plugin_crucible_exact_boundary_leave();
+        qemu_plugin_crucible_control_boundary_depth--;
+        qemu_plugin_crucible_native_group_use_end_v1(use);
+    }
+}
