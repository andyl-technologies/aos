@@ -0,0 +1,297 @@
+/*
+ * Process-private register workspace geometry, never allocation authority
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef QEMU_CRUCIBLE_REGISTER_WORKSPACE_H
+#define QEMU_CRUCIBLE_REGISTER_WORKSPACE_H
+
+#include "crypto/hash.h"
+#include "qemu/crucible-register-read.h"
+#include "hw/core/cpu.h"
+#include "hw/core/crucible-register-helpers.h"
+#include "plugins/qemu-plugin.h"
+
+struct QemuCrucibleCpuSourceAllocationOwner;
+struct QemuCrucibleCpuAllocationReceipt;
+typedef struct QemuCrucibleInitialRegisterWorkspaceOwner
+    QemuCrucibleInitialRegisterWorkspaceOwner;
+
+typedef struct CrucibleRegisterTarget {
+    uint32_t numeric_id;
+    uint32_t width_bits;
+} CrucibleRegisterTarget;
+
+typedef struct QemuCrucibleRegisterBinding {
+    uint8_t identity[32];
+    bool bound;
+} QemuCrucibleRegisterBinding;
+
+/* Corroboration in mapped payload, not the sole owner of these dependencies.
+ * Source's actual CPU allocation registry retains the refs across munmap. */
+typedef struct QemuCrucibleRegisterCpuDependency {
+    CPUState *cpu;
+    struct QemuCrucibleCpuSourceAllocationOwner *owner;
+    struct QemuCrucibleCpuAllocationReceipt *receipt;
+    uint64_t generation;
+    size_t instance_bytes;
+    /* Process-private corroboration; Source retains the actual QOM references
+     * and allocation receipts independently of this mapped view. */
+    Object *child;
+    struct QemuCrucibleCpuSourceAllocationOwner *child_owner;
+    struct QemuCrucibleCpuAllocationReceipt *child_receipt;
+    uint64_t child_generation;
+    size_t child_instance_bytes;
+} QemuCrucibleRegisterCpuDependency;
+
+/* Factual views only: callers retain stable complete schema/CPU backing under
+ * BQL and exclusive scratch/output backing. No view lends an allocation or
+ * authorizes a selected constructor/runtime read. */
+typedef struct QemuCrucibleRegisterFingerprintManifest {
+    const struct qemu_plugin_crucible_fault_register_capability *rows;
+    size_t count;
+    uint16_t scope;
+    const char *model;
+} QemuCrucibleRegisterFingerprintManifest;
+
+typedef struct QemuCrucibleRegisterFingerprintCpu {
+    CPUState *cpu;
+    /* Exact initialized QOM type extent, checked against the actual object. */
+    size_t instance_bytes;
+} QemuCrucibleRegisterFingerprintCpu;
+
+/* Measured in the native mapping layout before any future mapping birth. */
+typedef struct QemuCrucibleRegisterFingerprintScratch {
+    QCryptoSHA256 execution;
+    QCryptoSHA256 registers;
+    CrucibleCPURegisterGeometry geometry;
+    CrucibleCPURegisterKeyView keys;
+    CrucibleCPURegisterCapability candidate;
+    uint8_t coordinate[32];
+    uint8_t framing[16];
+    uint8_t digests[2][32];
+} QemuCrucibleRegisterFingerprintScratch;
+
+typedef struct QemuCrucibleRegisterFingerprintStorage {
+    QemuCrucibleRegisterFingerprintScratch *scratch;
+    uint32_t *keys;
+    size_t key_capacity;
+    CrucibleCPURegisterBuffers candidate;
+    uint8_t *value;
+    size_t value_capacity;
+} QemuCrucibleRegisterFingerprintStorage;
+
+/* Both outputs are optional, but at least one is required; execution requires
+ * an actual observed RR coordinate. Each complete row is read exactly once.
+ * Geometry/alias/overflow refusal precedes scratch or output mutation. Later
+ * descriptor/read failure may change scratch but publishes neither output.
+ * Success does not authenticate the supplied coordinate or record progress.
+ * A selected construction caller additionally needs the real workspace
+ * borrower and a Source-issued child for every architecture read. Runtime
+ * Root use needs its own entered operation; these factual inputs grant none. */
+int qemu_crucible_fault_register_fingerprints_into_v1(
+    const QemuCrucibleRegisterFingerprintManifest *manifest,
+    const QemuCrucibleRegisterFingerprintCpu *cohort, size_t cpu_count,
+    const QemuCrucibleRegisterFingerprintStorage *storage,
+    uint64_t observed_icount, const struct qemu_plugin_rr_cursor *rr,
+    uint8_t execution[32], uint8_t registers[32]);
+
+typedef enum QemuCrucibleRegisterWorkspacePart {
+    CRUCIBLE_REGISTER_WORKSPACE_ROWS,
+    CRUCIBLE_REGISTER_WORKSPACE_TARGETS,
+    CRUCIBLE_REGISTER_WORKSPACE_BINDINGS,
+    CRUCIBLE_REGISTER_WORKSPACE_NAME_INDEX,
+    CRUCIBLE_REGISTER_WORKSPACE_MODEL,
+    CRUCIBLE_REGISTER_WORKSPACE_NAMES,
+    CRUCIBLE_REGISTER_WORKSPACE_WRITABLE,
+    CRUCIBLE_REGISTER_WORKSPACE_RESERVED,
+    CRUCIBLE_REGISTER_WORKSPACE_IGNORED,
+    CRUCIBLE_REGISTER_WORKSPACE_READ_ONLY,
+    CRUCIBLE_REGISTER_WORKSPACE_KEYS,
+    CRUCIBLE_REGISTER_WORKSPACE_CANDIDATE,
+    CRUCIBLE_REGISTER_WORKSPACE_CANDIDATE_NAME,
+    CRUCIBLE_REGISTER_WORKSPACE_CANDIDATE_WRITABLE,
+    CRUCIBLE_REGISTER_WORKSPACE_CANDIDATE_RESERVED,
+    CRUCIBLE_REGISTER_WORKSPACE_CANDIDATE_IGNORED,
+    CRUCIBLE_REGISTER_WORKSPACE_CANDIDATE_READ_ONLY,
+    CRUCIBLE_REGISTER_WORKSPACE_LOOKUP_KEYS,
+    CRUCIBLE_REGISTER_WORKSPACE_CPUS,
+    CRUCIBLE_REGISTER_WORKSPACE_VALIDATION_DESIRED,
+    CRUCIBLE_REGISTER_WORKSPACE_MUTATION_BEFORE,
+    CRUCIBLE_REGISTER_WORKSPACE_MUTATION_AFTER,
+    CRUCIBLE_REGISTER_WORKSPACE_MUTATION_DESIRED,
+    CRUCIBLE_REGISTER_WORKSPACE_FINGERPRINT_VALUE,
+    CRUCIBLE_REGISTER_WORKSPACE_RESULT_MASK,
+    CRUCIBLE_REGISTER_WORKSPACE_RESULT_VALUE,
+    CRUCIBLE_REGISTER_WORKSPACE_FINGERPRINT_SCRATCH,
+    CRUCIBLE_REGISTER_WORKSPACE_FINGERPRINT_CPUS,
+    CRUCIBLE_REGISTER_WORKSPACE_PART_COUNT,
+} QemuCrucibleRegisterWorkspacePart;
+
+typedef struct QemuCrucibleRegisterWorkspaceSpan {
+    size_t offset;
+    size_t bytes;
+    size_t alignment;
+} QemuCrucibleRegisterWorkspaceSpan;
+
+typedef struct QemuCrucibleRegisterWorkspaceLayout {
+    CrucibleCPURegisterGeometry geometry;
+    size_t cpu_count;
+    size_t model_bytes;
+    size_t page_bytes;
+    size_t payload_bytes;
+    size_t backing_bytes;
+    QemuCrucibleRegisterWorkspaceSpan part[CRUCIBLE_REGISTER_WORKSPACE_PART_COUNT];
+} QemuCrucibleRegisterWorkspaceLayout;
+
+static inline bool crucible_register_workspace_part(
+    QemuCrucibleRegisterWorkspaceLayout *layout,
+    QemuCrucibleRegisterWorkspacePart part, size_t count, size_t size,
+    size_t alignment)
+{
+    size_t offset;
+
+    if ((unsigned int)part >= CRUCIBLE_REGISTER_WORKSPACE_PART_COUNT ||
+        !size || !alignment || (alignment & (alignment - 1)) ||
+        alignment > layout->page_bytes || count > SIZE_MAX / size ||
+        alignment - 1 > SIZE_MAX - layout->payload_bytes) {
+        return false;
+    }
+    offset = (layout->payload_bytes + alignment - 1) & ~(alignment - 1);
+    if (count * size > SIZE_MAX - offset) {
+        return false;
+    }
+    layout->part[part] = (QemuCrucibleRegisterWorkspaceSpan) {
+        .offset = offset, .bytes = count * size, .alignment = alignment,
+    };
+    layout->payload_bytes = offset + count * size;
+    return true;
+}
+
+/* This computes storage facts only. Source separately authenticates the real
+ * producer, entered class-0 child, CPU owners and pre-mmap accounting lane. */
+static inline bool crucible_register_workspace_layout(
+    const CrucibleCPURegisterGeometry *geometry, size_t cpu_count,
+    size_t model_bytes, size_t page_bytes,
+    QemuCrucibleRegisterWorkspaceLayout *out)
+{
+    QemuCrucibleRegisterWorkspaceLayout layout = { 0 };
+
+    if (!geometry || !geometry->cpu || !out || !cpu_count || !model_bytes ||
+        !page_bytes || (page_bytes & (page_bytes - 1)) ||
+        !geometry->register_count || geometry->register_count > 4096 ||
+        geometry->key_count > geometry->register_count ||
+        !geometry->max_name_bytes || geometry->max_name_bytes > 97 ||
+        !geometry->max_mask_bytes || geometry->max_mask_bytes > 8192 ||
+        geometry->name_bytes < geometry->max_name_bytes ||
+        geometry->mask_bytes < geometry->max_mask_bytes) {
+        return false;
+    }
+    layout.geometry = *geometry;
+    layout.cpu_count = cpu_count;
+    layout.model_bytes = model_bytes;
+    layout.page_bytes = page_bytes;
+#define REGISTER_PART(part, count, type) \
+    crucible_register_workspace_part(&layout, part, count, sizeof(type), \
+                                     _Alignof(type))
+    if (!REGISTER_PART(CRUCIBLE_REGISTER_WORKSPACE_ROWS,
+                       geometry->register_count,
+                       struct qemu_plugin_crucible_fault_register_capability) ||
+        !REGISTER_PART(CRUCIBLE_REGISTER_WORKSPACE_TARGETS,
+                       geometry->register_count, CrucibleRegisterTarget) ||
+        !REGISTER_PART(CRUCIBLE_REGISTER_WORKSPACE_BINDINGS,
+                       geometry->register_count, QemuCrucibleRegisterBinding) ||
+        !REGISTER_PART(CRUCIBLE_REGISTER_WORKSPACE_NAME_INDEX,
+                       geometry->register_count, const char *) ||
+        !REGISTER_PART(CRUCIBLE_REGISTER_WORKSPACE_MODEL, model_bytes, char) ||
+        !REGISTER_PART(CRUCIBLE_REGISTER_WORKSPACE_NAMES,
+                       geometry->name_bytes, char) ||
+        !REGISTER_PART(CRUCIBLE_REGISTER_WORKSPACE_KEYS,
+                       geometry->key_count, uint32_t) ||
+        !REGISTER_PART(CRUCIBLE_REGISTER_WORKSPACE_CANDIDATE,
+                       1, CrucibleCPURegisterCapability) ||
+        !REGISTER_PART(CRUCIBLE_REGISTER_WORKSPACE_CANDIDATE_NAME,
+                       geometry->max_name_bytes, char) ||
+        !REGISTER_PART(CRUCIBLE_REGISTER_WORKSPACE_LOOKUP_KEYS,
+                       geometry->key_count, uint32_t) ||
+        !REGISTER_PART(CRUCIBLE_REGISTER_WORKSPACE_CPUS,
+                       cpu_count, QemuCrucibleRegisterCpuDependency)) {
+        return false;
+    }
+    for (size_t part = CRUCIBLE_REGISTER_WORKSPACE_WRITABLE;
+         part <= CRUCIBLE_REGISTER_WORKSPACE_READ_ONLY; part++) {
+        if (!REGISTER_PART(part, geometry->mask_bytes, uint8_t)) {
+            return false;
+        }
+    }
+    for (size_t part = CRUCIBLE_REGISTER_WORKSPACE_CANDIDATE_WRITABLE;
+         part <= CRUCIBLE_REGISTER_WORKSPACE_CANDIDATE_READ_ONLY; part++) {
+        if (!REGISTER_PART(part, geometry->max_mask_bytes, uint8_t)) {
+            return false;
+        }
+    }
+    for (size_t part = CRUCIBLE_REGISTER_WORKSPACE_VALIDATION_DESIRED;
+         part < CRUCIBLE_REGISTER_WORKSPACE_FINGERPRINT_SCRATCH; part++) {
+        if (!REGISTER_PART(part, geometry->max_mask_bytes, uint8_t)) {
+            return false;
+        }
+    }
+    if (!REGISTER_PART(CRUCIBLE_REGISTER_WORKSPACE_FINGERPRINT_SCRATCH,
+                       1, QemuCrucibleRegisterFingerprintScratch) ||
+        !REGISTER_PART(CRUCIBLE_REGISTER_WORKSPACE_FINGERPRINT_CPUS,
+                       cpu_count, QemuCrucibleRegisterFingerprintCpu)) {
+        return false;
+    }
+#undef REGISTER_PART
+    if (page_bytes - 1 > SIZE_MAX - layout.payload_bytes) {
+        return false;
+    }
+    layout.backing_bytes = (layout.payload_bytes + page_bytes - 1) &
+        ~(page_bytes - 1);
+    if (!layout.backing_bytes || layout.backing_bytes > UINT64_MAX) {
+        return false;
+    }
+    *out = layout;
+    return true;
+}
