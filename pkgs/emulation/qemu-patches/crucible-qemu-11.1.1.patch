new file mode 100644
index 0000000000000000000000000000000000000000..363253b8b6a32dc21da851484969f1ff03df6685
--- /dev/null
+++ b/block/crucible-hot-fork-source.c
@@ -0,0 +1,1316 @@
+/*
+ * Crucible native read-only block source ownership
+ *
+ * Copyright (c) Andyl, Inc.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "block/block.h"
+#include "block/block_int.h"
+#include "block/graph-lock.h"
+#include "qapi/error.h"
+#include "qemu/cutils.h"
+#include "qemu/main-loop.h"
+#include "system/block-backend.h"
+#ifdef __linux__
+#include <linux/fs.h>
+#include <sys/ioctl.h>
+#endif
+
+#define HOT_FORK_WRITE_PERMISSIONS \
+    (BLK_PERM_WRITE | BLK_PERM_WRITE_UNCHANGED | BLK_PERM_RESIZE)
+
+/* Bound validation of the supported hot-fork profile, not ordinary QEMU I/O. */
+#define HOT_FORK_SOURCE_MAX_DEPTH 256
+#define HOT_FORK_SOURCE_MAX_VISITS 65536
+
+typedef enum ReadOnlySourcePhase {
+    SOURCE_ORIGINAL,
+    SOURCE_PERMISSIONS_REDUCED,
+    SOURCE_FROZEN,
+} ReadOnlySourcePhase;
+
+typedef struct ReadOnlySourceNode {
+    BlockDriverState *node;
+    BlockDriverState *parent;
+    BlockDriver *driver;
+    BdrvCrucibleHotForkSourceDisposition disposition;
+    BdrvCrucibleHotForkFileState file;
+    bool file_pinned;
+} ReadOnlySourceNode;
+
+struct QemuBlockBackendHotForkReadOnlySource {
+    BlockBackend *backend;
+    BlockDriverState *root;
+    uint64_t permissions;
+    uint64_t shared_permissions;
+    pid_t owner;
+    ReadOnlySourcePhase phase;
+    BdrvCrucibleHotForkSourceDisposition disposition;
+    bool original_read_only;
+    char *node_name;
+    GArray *graph;
+};
+
+static bool GRAPH_RDLOCK source_node_fork_safe(BlockDriverState *node,
+                                               Error **errp)
+{
+    BdrvChild *parent;
+    BdrvCrucibleHotForkFileState file;
+
+    if (node->drv && node->drv->bdrv_crucible_hot_fork_source_disposition ==
+            BDRV_CRUCIBLE_HOT_FORK_SOURCE_EXTERNAL_SHARED) {
+        parent = QLIST_FIRST(&node->parents);
+        if (!QLIST_EMPTY(&node->children) || !parent ||
+            parent->klass == &child_of_bds ||
+            QLIST_NEXT(parent, next_parent)) {
+            error_setg(errp, "Crucible external source is not one exact root");
+            return false;
+        }
+        return true;
+    }
+    if (!bdrv_is_read_only(node)) {
+        error_setg(errp, "Crucible source graph retains a writable node");
+        return false;
+    }
+    if (node->drv && node->drv->bdrv_crucible_hot_fork_file &&
+        (!node->drv->bdrv_crucible_hot_fork_file(
+            node, BDRV_CRUCIBLE_HOT_FORK_FILE_QUERY, &file, errp) ||
+         !file.read_only)) {
+        if (!errp || !*errp) {
+            error_setg(errp, "Crucible source retains a writable file descriptor");
+        }
+        return false;
+    }
+    return true;
+}
+
+bool qemu_block_hot_fork_all_sources_fork_safe(Error **errp)
+{
+    BlockDriverState *node = NULL;
+    size_t remaining = HOT_FORK_SOURCE_MAX_VISITS;
+
+    GLOBAL_STATE_CODE();
+    GRAPH_RDLOCK_GUARD_MAINLOOP();
+    while ((node = bdrv_next_all_states(node))) {
+        if (!remaining) {
+            error_setg(errp, "Crucible fork requires a complete "
+                       "typed block source graph");
+            return false;
+        }
+        if (!source_node_fork_safe(node, errp)) {
+            return false;
+        }
+        remaining--;
+    }
+    return true;
+}
+
+static bool GRAPH_RDLOCK source_graph_capture(
+    GArray *graph, BlockDriverState *node, BlockDriverState *parent,
+    unsigned depth, Error **errp)
+{
+    BdrvChild *child;
+    ReadOnlySourceNode entry = {
+        .node = node,
+        .parent = parent,
+        .driver = node->drv,
+        .disposition = node->drv ?
+            node->drv->bdrv_crucible_hot_fork_source_disposition :
+            BDRV_CRUCIBLE_HOT_FORK_SOURCE_UNSUPPORTED,
+    };
+
+    if (depth == HOT_FORK_SOURCE_MAX_DEPTH ||
+        graph->len == HOT_FORK_SOURCE_MAX_VISITS) {
+        error_setg(errp, "Crucible source graph exceeds hot-fork validation bounds");
+        return false;
+    }
+    if (bdrv_is_inactive(node)) {
+        error_setg(errp, "Crucible source graph contains an inactive node");
+        return false;
+    }
+    if (entry.disposition ==
+            BDRV_CRUCIBLE_HOT_FORK_SOURCE_EXTERNAL_SHARED) {
+        if (parent || !QLIST_EMPTY(&node->children)) {
+            error_setg(errp, "Crucible external source must be one exact root");
+            return false;
+        }
+    } else if (entry.disposition !=
+               BDRV_CRUCIBLE_HOT_FORK_SOURCE_NATIVE_FILE) {
+        error_setg(errp, "Crucible source driver has no native ownership disposition");
+        return false;
+    }
+    if (node->drv->bdrv_crucible_hot_fork_file) {
+        if (!QLIST_EMPTY(&node->children) ||
+            !node->drv->bdrv_crucible_hot_fork_file(
+                node, BDRV_CRUCIBLE_HOT_FORK_FILE_PIN, &entry.file, errp)) {
+            if (!errp || !*errp) {
+                error_setg(errp, "Crucible file source must be a graph leaf");
+            }
+            return false;
+        }
+        entry.file_pinned = true;
+    }
+    bdrv_ref(node);
+    g_array_append_val(graph, entry);
+    QLIST_FOREACH(child, &node->children, next) {
+        if (!source_graph_capture(graph, child->bs, node, depth + 1, errp)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool GRAPH_RDLOCK source_graph_matches(
+    const GArray *graph, BlockDriverState *node, BlockDriverState *parent,
+    size_t *index, bool frozen, Error **errp)
+{
+    const ReadOnlySourceNode *entry;
+    BdrvChild *child;
+    BdrvCrucibleHotForkFileState file;
+
+    if (*index == graph->len) {
+        error_setg(errp, "Crucible source graph acquired an unowned node");
+        return false;
+    }
+    entry = &g_array_index(graph, ReadOnlySourceNode, (*index)++);
+    if (entry->node != node || entry->parent != parent ||
+        entry->driver != node->drv || bdrv_is_inactive(node) ||
+        !node->drv || entry->disposition !=
+            node->drv->bdrv_crucible_hot_fork_source_disposition) {
+        error_setg(errp, "Crucible source graph identity changed externally");
+        return false;
+    }
+    if (entry->file_pinned &&
+        (!entry->driver->bdrv_crucible_hot_fork_file(
+            node, BDRV_CRUCIBLE_HOT_FORK_FILE_QUERY, &file, errp) ||
+         file.device != entry->file.device || file.inode != entry->file.inode)) {
+        if (!errp || !*errp) {
+            error_setg(errp, "Crucible source file identity changed externally");
+        }
+        return false;
+    }
+    if (frozen && !source_node_fork_safe(node, errp)) {
+        return false;
+    }
+    QLIST_FOREACH(child, &node->children, next) {
+        if (!source_graph_matches(graph, child->bs, node, index, frozen, errp)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool source_graph_validate(
+    const QemuBlockBackendHotForkReadOnlySource *source, bool frozen, Error **errp)
+{
+    size_t index = 0;
+    GRAPH_RDLOCK_GUARD_MAINLOOP();
+
+    if (!source_graph_matches(source->graph, source->root, NULL,
+                              &index, frozen, errp)) {
+        return false;
+    }
+    if (index != source->graph->len) {
+        error_setg(errp, "Crucible source graph lost a retained node");
+        return false;
+    }
+    return true;
+}
+
+static void source_graph_free(GArray *graph)
+{
+    size_t index;
+
+    {
+        GRAPH_RDLOCK_GUARD_MAINLOOP();
+        for (index = 0; index < graph->len; index++) {
+            ReadOnlySourceNode *entry =
+                &g_array_index(graph, ReadOnlySourceNode, index);
+            BdrvCrucibleHotForkFileState file;
+
+            if (entry->file_pinned) {
+                /* The validated, referenced graph cannot change under BQL. */
+                bool released = entry->driver->bdrv_crucible_hot_fork_file(
+                    entry->node, BDRV_CRUCIBLE_HOT_FORK_FILE_UNPIN,
+                    &file, &error_abort);
+                assert(released);
+            }
+        }
+    }
+    for (index = 0; index < graph->len; index++) {
+        bdrv_unref(g_array_index(graph, ReadOnlySourceNode, index).node);
+    }
+    g_array_free(graph, true);
+}
+
+static bool source_root_matches(const QemuBlockBackendHotForkReadOnlySource *source)
+{
+    const BdrvChild *parent = QLIST_FIRST(&source->root->parents);
+
+    if (strcmp(source->node_name, bdrv_get_node_name(source->root))) {
+        return false;
+    }
+    if (!source->backend) {
+        return parent == NULL;
+    }
+    return blk_bs(source->backend) == source->root &&
+           parent == blk_root(source->backend) && parent &&
+           QLIST_NEXT(parent, next_parent) == NULL;
+}
+
+static bool source_matches_owner(
+    const QemuBlockBackendHotForkReadOnlySource *source,
+    pid_t owner, Error **errp)
+{
+    uint64_t permissions = 0, shared_permissions = 0;
+    uint64_t expected_permissions, expected_shared;
+
+    if (!source || source->owner != owner || !source_root_matches(source)) {
+        error_setg(errp, "Crucible read-only source lost its process or root");
+        return false;
+    }
+    if (source->backend) {
+        blk_get_perm(source->backend, &permissions, &shared_permissions);
+    }
+    expected_permissions = source->permissions;
+    expected_shared = source->shared_permissions;
+    if (source->backend && source->phase != SOURCE_ORIGINAL) {
+        expected_permissions &= ~HOT_FORK_WRITE_PERMISSIONS;
+        expected_shared |= HOT_FORK_WRITE_PERMISSIONS;
+    }
+    if (permissions != expected_permissions ||
+        shared_permissions != expected_shared ||
+        (source->disposition !=
+             BDRV_CRUCIBLE_HOT_FORK_SOURCE_EXTERNAL_SHARED &&
+         bdrv_is_read_only(source->root) !=
+             (source->original_read_only ||
+              source->phase == SOURCE_FROZEN))) {
+        error_setg(errp, "Crucible read-only source access changed externally");
+        return false;
+    }
+    return source_graph_validate(source, false, errp);
+}
+
+static bool source_matches(const QemuBlockBackendHotForkReadOnlySource *source,
+                           Error **errp)
+{
+    return source_matches_owner(source, getpid(), errp);
+}
+
+static bool source_transition_allowed(
+    const QemuBlockBackendHotForkReadOnlySource *source, Error **errp)
+{
+    QemuBlockBackendHotForkBarrierInventory barrier;
+    bool held;
+
+    if (!source_matches(source, errp)) {
+        return false;
+    }
+    if (qemu_get_current_aio_context() != qemu_get_aio_context()) {
+        error_setg(errp, "Crucible source transition requires the main AioContext");
+        return false;
+    }
+    if (!qemu_block_backend_hot_fork_barrier(
+            QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_QUERY, &barrier)) {
+        error_setg(errp, "Cannot inspect Crucible source transition barriers");
+        return false;
+    }
+    held = barrier.held || barrier.graph_held;
+    qemu_block_backend_hot_fork_barrier_inventory_destroy(&barrier);
+    if (held) {
+        error_setg(errp, "Crucible source transition must precede fork barriers");
+        return false;
+    }
+    return true;
+}
+
+static QemuBlockBackendHotForkReadOnlySource *source_new(
+    BlockBackend *blk, BlockDriverState *root, Error **errp)
+{
+    QemuBlockBackendHotForkReadOnlySource *source;
+    BdrvChild *parent;
+    size_t parents = 0;
+    uint64_t permissions = 0, shared_permissions = 0;
+    GArray *graph;
+    bool captured;
+
+    GLOBAL_STATE_CODE();
+    if (!root || (!bdrv_is_writable(root) && !bdrv_is_read_only(root))) {
+        error_setg(errp, "Crucible read-only source requires an active root");
+        return NULL;
+    }
+    /* Other graph consumers must not have their access changed by this owner. */
+    QLIST_FOREACH(parent, &root->parents, next_parent) {
+        parents++;
+    }
+    if (blk) {
+        blk_get_perm(blk, &permissions, &shared_permissions);
+    }
+    if ((blk && (parents != 1 ||
+                 (!bdrv_is_read_only(root) &&
+                  !(permissions & HOT_FORK_WRITE_PERMISSIONS)))) ||
+        (!blk && (parents != 0 || !*bdrv_get_node_name(root)))) {
+        error_setg(errp, "Crucible read-only source requires one exact owner");
+        return NULL;
+    }
+    graph = g_array_new(false, false, sizeof(ReadOnlySourceNode));
+    {
+        GRAPH_RDLOCK_GUARD_MAINLOOP();
+        captured = source_graph_capture(graph, root, NULL, 0, errp);
+    }
+    if (!captured) {
+        source_graph_free(graph);
+        return NULL;
+    }
+    source = g_new0(QemuBlockBackendHotForkReadOnlySource, 1);
+    *source = (QemuBlockBackendHotForkReadOnlySource) {
+        .backend = blk,
+        .root = root,
+        .permissions = permissions,
+        .shared_permissions = shared_permissions,
+        .owner = getpid(),
+        .phase = SOURCE_ORIGINAL,
+        .disposition = root->drv->bdrv_crucible_hot_fork_source_disposition,
+        .original_read_only = bdrv_is_read_only(root),
+        .node_name = g_strdup(bdrv_get_node_name(root)),
+        .graph = graph,
+    };
+    if (blk) {
+        blk_ref(blk);
+    }
+    bdrv_ref(root);
+    return source;
+}
+
+QemuBlockBackendHotForkReadOnlySource *
+qemu_block_backend_hot_fork_read_only_source_new(BlockBackend *blk,
+                                               Error **errp)
+{
+    return source_new(blk, blk ? blk_bs(blk) : NULL, errp);
+}
+
+QemuBlockBackendHotForkReadOnlySource *
+qemu_block_hot_fork_read_only_node_new(BlockDriverState *root, Error **errp)
+{
+    return source_new(NULL, root, errp);
+}
+
+bool qemu_block_backend_hot_fork_read_only_source_freeze(
+    QemuBlockBackendHotForkReadOnlySource *source, Error **errp)
+{
+    bool frozen = false;
+
+    GLOBAL_STATE_CODE();
+    if (!source_transition_allowed(source, errp)) {
+        return false;
+    }
+    bdrv_drained_begin(source->root);
+    if (source->phase == SOURCE_ORIGINAL) {
+        if (source->backend &&
+            blk_set_perm(source->backend,
+                         source->permissions & ~HOT_FORK_WRITE_PERMISSIONS,
+                         source->shared_permissions | HOT_FORK_WRITE_PERMISSIONS,
+                         errp) < 0) {
+            goto out;
+        }
+        source->phase = SOURCE_PERMISSIONS_REDUCED;
+    }
+    if (source->phase == SOURCE_PERMISSIONS_REDUCED) {
+        /* Native reopen flushes caches before any child can inherit them. */
+        if (source->disposition !=
+                BDRV_CRUCIBLE_HOT_FORK_SOURCE_EXTERNAL_SHARED &&
+            !source->original_read_only &&
+            bdrv_reopen_set_read_only(source->root, true, errp) < 0) {
+            goto out;
+        }
+        source->phase = SOURCE_FROZEN;
+    }
+    frozen = source_matches(source, errp) &&
+             source_graph_validate(source, true, errp);
+out:
+    bdrv_drained_end(source->root);
+    return frozen;
+}
+
+bool qemu_block_backend_hot_fork_read_only_source_restore(
+    QemuBlockBackendHotForkReadOnlySource *source, Error **errp)
+{
+    bool restored = false;
+
+    GLOBAL_STATE_CODE();
+    if (!source_transition_allowed(source, errp)) {
+        return false;
+    }
+    bdrv_drained_begin(source->root);
+    if (source->phase == SOURCE_FROZEN) {
+        if (source->disposition !=
+                BDRV_CRUCIBLE_HOT_FORK_SOURCE_EXTERNAL_SHARED &&
+            !source->original_read_only &&
+            bdrv_reopen_set_read_only(source->root, false, errp) < 0) {
+            goto out;
+        }
+        source->phase = SOURCE_PERMISSIONS_REDUCED;
+    }
+    if (source->phase == SOURCE_PERMISSIONS_REDUCED) {
+        if (source->backend &&
+            blk_set_perm(source->backend, source->permissions,
+                         source->shared_permissions, errp) < 0) {
+            goto out;
+        }
+        source->phase = SOURCE_ORIGINAL;
+    }
+    restored = source_matches(source, errp);
+out:
+    bdrv_drained_end(source->root);
+    return restored;
+}
+
+bool qemu_block_backend_hot_fork_read_only_source_is_frozen(
+    const QemuBlockBackendHotForkReadOnlySource *source)
+{
+    GLOBAL_STATE_CODE();
+    return source && source->phase == SOURCE_FROZEN &&
+           source_matches(source, NULL) &&
+           source_graph_validate(source, true, NULL);
+}
+
+bool qemu_block_backend_hot_fork_read_only_source_free(
+    QemuBlockBackendHotForkReadOnlySource *source, Error **errp)
+{
+    GLOBAL_STATE_CODE();
+    if (!source_matches(source, errp)) {
+        return false;
+    }
+    if (source->phase != SOURCE_ORIGINAL) {
+        error_setg(errp, "Crucible read-only source must be restored before release");
+        return false;
+    }
+    source_graph_free(source->graph);
+    bdrv_unref(source->root);
+    if (source->backend) {
+        blk_unref(source->backend);
+    }
+    g_free(source->node_name);
+    g_free(source);
+    return true;
+}
+
+struct QemuBlockHotForkSourceSet {
+    pid_t owner;
+    GPtrArray *sources;
+    GHashTable *nodes;
+    GHashTable *backends;
+    size_t originally_writable_roots;
+    size_t originally_writable_backends;
+    size_t native_roots;
+    size_t native_nodes;
+    bool child_plan_active;
+};
+
+static bool source_set_owned_by(const QemuBlockHotForkSourceSet *set,
+                                pid_t owner, Error **errp)
+{
+    size_t index;
+
+    if (!set || set->owner != owner) {
+        error_setg(errp, "Crucible source set lost its owning process");
+        return false;
+    }
+    for (index = 0; index < set->sources->len; index++) {
+        if (!source_matches_owner(g_ptr_array_index(set->sources, index),
+                                   owner, errp)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool source_set_complete_owned(const QemuBlockHotForkSourceSet *set,
+                                      pid_t owner, Error **errp)
+{
+    g_autoptr(GHashTable) consumers =
+        g_hash_table_new(g_direct_hash, g_direct_equal);
+    BlockDriverState *node = NULL;
+    BlockBackend *backend = NULL;
+    GHashTableIter iter;
+    gpointer key;
+    size_t nodes = 0, backends = 0;
+
+    if (!source_set_owned_by(set, owner, errp)) {
+        return false;
+    }
+    GRAPH_RDLOCK_GUARD_MAINLOOP();
+    g_hash_table_iter_init(&iter, set->nodes);
+    while (g_hash_table_iter_next(&iter, &key, NULL)) {
+        BdrvChild *child;
+
+        QLIST_FOREACH(child, &((BlockDriverState *)key)->children, next) {
+            g_hash_table_add(consumers, child);
+        }
+    }
+    while ((backend = blk_all_next(backend))) {
+        if (++backends > HOT_FORK_SOURCE_MAX_VISITS ||
+            !g_hash_table_contains(set->backends, backend)) {
+            error_setg(errp, "Crucible source set has an unowned block backend");
+            return false;
+        }
+        g_hash_table_add(consumers, (gpointer)blk_root(backend));
+    }
+    while ((node = bdrv_next_all_states(node))) {
+        BdrvChild *parent;
+
+        if (++nodes > HOT_FORK_SOURCE_MAX_VISITS ||
+            !g_hash_table_contains(set->nodes, node)) {
+            error_setg(errp, "Crucible source set has an unowned native node");
+            return false;
+        }
+        /* Node coverage alone misses non-backend consumers of descendants. */
+        QLIST_FOREACH(parent, &node->parents, next_parent) {
+            if (!g_hash_table_contains(consumers, parent)) {
+                error_setg(errp, "Crucible source set has an unowned graph consumer");
+                return false;
+            }
+        }
+    }
+    if (nodes != g_hash_table_size(set->nodes) ||
+        backends != g_hash_table_size(set->backends)) {
+        error_setg(errp, "Crucible source set lost a retained native resource");
+        return false;
+    }
+    return true;
+}
+
+static bool source_set_owned(const QemuBlockHotForkSourceSet *set, Error **errp)
+{
+    return source_set_owned_by(set, getpid(), errp);
+}
+
+static bool source_set_complete(const QemuBlockHotForkSourceSet *set, Error **errp)
+{
+    return source_set_complete_owned(set, getpid(), errp);
+}
+
+/* Only called after all release preconditions have been checked under BQL. */
+static void source_set_destroy(QemuBlockHotForkSourceSet *set)
+{
+    size_t index;
+
+    for (index = 0; index < set->sources->len; index++) {
+        bool released = qemu_block_backend_hot_fork_read_only_source_free(
+            g_ptr_array_index(set->sources, index), &error_abort);
+
+        assert(released);
+    }
+    g_ptr_array_free(set->sources, true);
+    g_hash_table_destroy(set->nodes);
+    g_hash_table_destroy(set->backends);
+    g_free(set);
+}
+
+QemuBlockHotForkSourceSet *qemu_block_hot_fork_source_set_new(
+    const QemuBlockHotForkSourceRoot *roots, size_t count, Error **errp)
+{
+    QemuBlockHotForkSourceSet *set;
+    g_autoptr(GHashTable) seen = g_hash_table_new(g_direct_hash, g_direct_equal);
+    size_t index, visit, visits = 0;
+
+    GLOBAL_STATE_CODE();
+    if (count > HOT_FORK_SOURCE_MAX_VISITS || (count && !roots)) {
+        error_setg(errp, "Crucible source set exceeds root bounds");
+        return NULL;
+    }
+    /* Reject duplicate/mismatched owners before retaining any native graph. */
+    for (index = 0; index < count; index++) {
+        if (!roots[index].root ||
+            (roots[index].backend &&
+             blk_bs(roots[index].backend) != roots[index].root) ||
+            !g_hash_table_add(seen, roots[index].root)) {
+            error_setg(errp, "Crucible source set requires unique exact roots");
+            return NULL;
+        }
+    }
+    set = g_new0(QemuBlockHotForkSourceSet, 1);
+    set->owner = getpid();
+    set->sources = g_ptr_array_new();
+    set->nodes = g_hash_table_new(g_direct_hash, g_direct_equal);
+    set->backends = g_hash_table_new(g_direct_hash, g_direct_equal);
+    for (index = 0; index < count; index++) {
+        QemuBlockBackendHotForkReadOnlySource *source =
+            source_new(roots[index].backend, roots[index].root, errp);
+
+        if (!source) {
+            goto fail;
+        }
+        g_ptr_array_add(set->sources, source);
+        if (source->graph->len > HOT_FORK_SOURCE_MAX_VISITS - visits) {
+            error_setg(errp, "Crucible source set exceeds graph visit bounds");
+            goto fail;
+        }
+        visits += source->graph->len;
+        if (source->disposition ==
+            BDRV_CRUCIBLE_HOT_FORK_SOURCE_NATIVE_FILE) {
+            set->native_roots++;
+            set->native_nodes += source->graph->len;
+            set->originally_writable_roots += !source->original_read_only;
+        }
+        if (source->backend) {
+            if (source->disposition ==
+                BDRV_CRUCIBLE_HOT_FORK_SOURCE_NATIVE_FILE) {
+                set->originally_writable_backends +=
+                    (source->permissions & BLK_PERM_WRITE) != 0;
+            }
+            g_hash_table_insert(set->backends, source->backend, source);
+        }
+        for (visit = 0; visit < source->graph->len; visit++) {
+            g_hash_table_add(set->nodes,
+                g_array_index(source->graph, ReadOnlySourceNode, visit).node);
+        }
+    }
+    if (!source_set_complete(set, errp)) {
+        goto fail;
+    }
+    return set;
+fail:
+    /* Construction only retains references/file pins, never changes access. */
+    source_set_destroy(set);
+    return NULL;
+}
+
+bool qemu_block_hot_fork_source_set_query(
+    const QemuBlockHotForkSourceSet *set,
+    QemuBlockHotForkSourceSetInventory *inventory, Error **errp)
+{
+    size_t index;
+
+    GLOBAL_STATE_CODE();
+    if (!inventory) {
+        error_setg(errp, "Crucible source set query requires an inventory");
+        return false;
+    }
+    memset(inventory, 0, sizeof(*inventory));
+    if (!source_set_complete(set, errp)) {
+        return false;
+    }
+    *inventory = (QemuBlockHotForkSourceSetInventory) {
+        .roots = set->native_roots,
+        .nodes = set->native_nodes,
+        .originally_writable_roots = set->originally_writable_roots,
+        .originally_writable_backends = set->originally_writable_backends,
+        .frozen = true,
+    };
+    for (index = 0; index < set->sources->len; index++) {
+        inventory->frozen &=
+            qemu_block_backend_hot_fork_read_only_source_is_frozen(
+                g_ptr_array_index(set->sources, index));
+    }
+    return true;
+}
+
+bool qemu_block_hot_fork_source_set_backend_permissions(
+    const QemuBlockHotForkSourceSet *set, BlockBackend *backend,
+    uint64_t *permissions, Error **errp)
+{
+    QemuBlockBackendHotForkReadOnlySource *source;
+
+    GLOBAL_STATE_CODE();
+    if (!set || set->owner != getpid() || !permissions ||
+        !(source = g_hash_table_lookup(set->backends, backend))) {
+        error_setg(errp, "Crucible source set does not own the requested backend");
+        return false;
+    }
+    if (!source_matches(source, errp)) {
+        return false;
+    }
+    *permissions = source->permissions;
+    return true;
+}
+
+bool qemu_block_hot_fork_source_set_freeze(QemuBlockHotForkSourceSet *set,
+                                         Error **errp)
+{
+    QemuBlockHotForkSourceSetInventory inventory;
+    size_t index;
+
+    GLOBAL_STATE_CODE();
+    if (!source_set_complete(set, errp)) {
+        return false;
+    }
+    for (index = 0; index < set->sources->len; index++) {
+        if (!qemu_block_backend_hot_fork_read_only_source_freeze(
+                g_ptr_array_index(set->sources, index), errp)) {
+            return false;
+        }
+    }
+    return qemu_block_hot_fork_source_set_query(set, &inventory, errp) &&
+           inventory.frozen;
+}
+
+bool qemu_block_hot_fork_source_set_restore(QemuBlockHotForkSourceSet *set,
+                                          Error **errp)
+{
+    size_t index;
+
+    GLOBAL_STATE_CODE();
+    if (!source_set_owned(set, errp)) {
+        return false;
+    }
+    if (set->child_plan_active) {
+        error_setg(errp, "Crucible source set retains a child file plan");
+        return false;
+    }
+    /* Recover in reverse transition order; failure retains all capabilities. */
+    for (index = set->sources->len; index > 0; index--) {
+        if (!qemu_block_backend_hot_fork_read_only_source_restore(
+                g_ptr_array_index(set->sources, index - 1), errp)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+bool qemu_block_hot_fork_source_set_free(QemuBlockHotForkSourceSet *set,
+                                       Error **errp)
+{
+    size_t index;
+
+    GLOBAL_STATE_CODE();
+    if (!source_set_owned(set, errp)) {
+        return false;
+    }
+    if (set->child_plan_active) {
+        error_setg(errp, "Crucible source set retains a child file plan");
+        return false;
+    }
+    for (index = 0; index < set->sources->len; index++) {
+        QemuBlockBackendHotForkReadOnlySource *source =
+            g_ptr_array_index(set->sources, index);
+
+        if (source->phase != SOURCE_ORIGINAL) {
+            error_setg(errp, "Crucible source set must be restored before release");
+            return false;
+        }
+    }
+    source_set_destroy(set);
+    return true;
+}
+
+bool qemu_block_hot_fork_source_set_release_external_child(
+    QemuBlockHotForkSourceSet *set, Error **errp)
+{
+    pid_t parent = getppid();
+    size_t index;
+
+    GLOBAL_STATE_CODE();
+    if (!set || set->owner != parent || parent <= 1 ||
+        set->owner == getpid() || set->child_plan_active ||
+        set->native_roots || set->native_nodes ||
+        !source_set_complete_owned(set, parent, errp)) {
+        if (!errp || !*errp) {
+            error_setg(errp, "Crucible child source set is not external-only");
+        }
+        return false;
+    }
+    for (index = 0; index < set->sources->len; index++) {
+        QemuBlockBackendHotForkReadOnlySource *source =
+            g_ptr_array_index(set->sources, index);
+
+        if (source->disposition !=
+            BDRV_CRUCIBLE_HOT_FORK_SOURCE_EXTERNAL_SHARED) {
+            error_setg(errp, "Crucible child source set mixes dispositions");
+            return false;
+        }
+        source->owner = getpid();
+    }
+    set->owner = getpid();
+    return qemu_block_hot_fork_source_set_restore(set, errp) &&
+           qemu_block_hot_fork_source_set_free(set, errp);
+}
+
+/* Bound native files independently of the complete graph visit bound. */
+#define HOT_FORK_CHILD_MAX_FILES 4096
+#define HOT_FORK_CHILD_COPY_CHUNK (64 * 1024)
+
+typedef struct HotForkChildFileEntry {
+    BlockDriverState *node;
+    BdrvCrucibleHotForkFileState source;
+    struct stat destination;
+    off_t source_size;
+    bool private_file;
+    int destination_fd;
+    int prepared_fd;
+} HotForkChildFileEntry;
+
+struct QemuBlockHotForkChildFiles {
+    QemuBlockHotForkSourceSet *sources;
+    GArray *files;
+    pid_t owner;
+    bool consumed;
+};
+
+static void child_files_destroy(QemuBlockHotForkChildFiles *plan)
+{
+    size_t index;
+
+    for (index = 0; index < plan->files->len; index++) {
+        HotForkChildFileEntry *entry =
+            &g_array_index(plan->files, HotForkChildFileEntry, index);
+
+        if (entry->prepared_fd >= 0) {
+            close(entry->prepared_fd);
+        }
+    }
+    g_array_free(plan->files, true);
+    g_free(plan);
+}
+
+static bool child_files_capture(QemuBlockHotForkChildFiles *plan, Error **errp)
+{
+    g_autoptr(GHashTable) seen = g_hash_table_new(g_direct_hash, g_direct_equal);
+    size_t index, visit;
+    GRAPH_RDLOCK_GUARD_MAINLOOP();
+
+    for (index = 0; index < plan->sources->sources->len; index++) {
+        QemuBlockBackendHotForkReadOnlySource *source =
+            g_ptr_array_index(plan->sources->sources, index);
+
+        for (visit = 0; visit < source->graph->len; visit++) {
+            ReadOnlySourceNode *node =
+                &g_array_index(source->graph, ReadOnlySourceNode, visit);
+            HotForkChildFileEntry entry = {
+                .node = node->node,
+                .private_file = !node->file.read_only,
+                .destination_fd = -1,
+                .prepared_fd = -1,
+            };
+
+            if (!node->file_pinned || !g_hash_table_add(seen, node->node)) {
+                continue;
+            }
+            if (plan->files->len == HOT_FORK_CHILD_MAX_FILES ||
+                !node->driver->bdrv_crucible_hot_fork_file_child ||
+                !node->driver->bdrv_crucible_hot_fork_file(
+                    node->node, BDRV_CRUCIBLE_HOT_FORK_FILE_QUERY,
+                    &entry.source, errp) || !entry.source.read_only) {
+                if (!errp || !*errp) {
+                    error_setg(errp, "Crucible child lacks a bounded frozen "
+                               "file disposition");
+                }
+                return false;
+            }
+            g_array_append_val(plan->files, entry);
+        }
+    }
+    return true;
+}
+
+static bool child_files_bind(QemuBlockHotForkChildFiles *plan,
+                             const QemuBlockHotForkChildFile *files,
+                             size_t count, uint64_t maximum_bytes, Error **errp)
+{
+    size_t index, candidate, other, matched = 0;
+    uint64_t total = 0;
+
+    for (index = 0; index < plan->files->len; index++) {
+        HotForkChildFileEntry *entry =
+            &g_array_index(plan->files, HotForkChildFileEntry, index);
+        struct stat source;
+        int flags;
+
+        if (!entry->private_file) {
+            continue;
+        }
+        for (candidate = 0; candidate < count; candidate++) {
+            if (files[candidate].node == entry->node) {
+                if (entry->destination_fd >= 0) {
+                    error_setg(errp, "Crucible child file has duplicate replacements");
+                    return false;
+                }
+                entry->destination_fd = files[candidate].descriptor;
+                matched++;
+            }
+        }
+        flags = entry->destination_fd < 0 ? -1 :
+            fcntl(entry->destination_fd, F_GETFL);
+        if (flags < 0 ||
+            fstat(entry->destination_fd, &entry->destination) < 0 ||
+            !S_ISREG(entry->destination.st_mode) ||
+            entry->destination.st_nlink != 1 ||
+            entry->destination.st_size != 0 ||
+            (flags & O_ACCMODE) != O_RDWR || (flags & O_APPEND) ||
+            fstat(entry->source.descriptor, &source) < 0 ||
+            source.st_size < 0 ||
+            (uint64_t)source.st_size > maximum_bytes - total) {
+            error_setg(errp, "Crucible child requires empty private files "
+                       "within its byte budget");
+            return false;
+        }
+        total += source.st_size;
+        entry->source_size = source.st_size;
+        for (other = 0; other < plan->files->len; other++) {
+            HotForkChildFileEntry *prior =
+                &g_array_index(plan->files, HotForkChildFileEntry, other);
+
+            if ((entry->destination.st_dev == prior->source.device &&
+                 entry->destination.st_ino == prior->source.inode) ||
+                (other < index && prior->private_file &&
+                 entry->destination.st_dev == prior->destination.st_dev &&
+                 entry->destination.st_ino == prior->destination.st_ino)) {
+                error_setg(errp, "Crucible child file aliases a source or "
+                           "another replacement");
+                return false;
+            }
+        }
+    }
+    if (matched != count) {
+        error_setg(errp, "Crucible child file list contains an unowned replacement");
+        return false;
+    }
+    return true;
+}
+
+static int child_file_open(int descriptor, int flags, Error **errp)
+{
+    char path[64];
+    int opened;
+
+    g_snprintf(path, sizeof(path), "/proc/self/fd/%d", descriptor);
+    opened = open(path, flags | O_CLOEXEC);
+    if (opened < 0) {
+        error_setg_errno(errp, errno, "Cannot open Crucible child file capability");
+    }
+    return opened;
+}
+
+static bool child_file_copy(int source, int destination, off_t size, Error **errp)
+{
+    g_autofree uint8_t *buffer = NULL;
+    off_t offset = 0;
+
+#ifdef FICLONE
+    if (ioctl(destination, FICLONE, source) == 0) {
+        goto sync;
+    }
+    if (errno != EOPNOTSUPP && errno != ENOTTY && errno != EXDEV && errno != EINVAL) {
+        error_setg_errno(errp, errno, "Cannot clone Crucible child file");
+        return false;
+    }
+#endif
+    /* Sparse copying is the correctness fallback, not a reflink requirement. */
+    buffer = g_malloc(HOT_FORK_CHILD_COPY_CHUNK);
+    while (offset < size) {
+        size_t length = MIN(size - offset, HOT_FORK_CHILD_COPY_CHUNK);
+        size_t read_bytes = 0, written = 0, index;
+        uint8_t nonzero = 0;
+
+        while (read_bytes < length) {
+            ssize_t result = pread(source, buffer + read_bytes,
+                                    length - read_bytes, offset + read_bytes);
+            if (result < 0 && errno == EINTR) {
+                continue;
+            }
+            if (result <= 0) {
+                error_setg_errno(errp, result < 0 ? errno : EIO,
+                                 "Cannot read frozen Crucible source file");
+                return false;
+            }
+            read_bytes += result;
+        }
+        for (index = 0; index < length; index++) {
+            nonzero |= buffer[index];
+        }
+        while (nonzero && written < length) {
+            ssize_t result = pwrite(destination, buffer + written,
+                                     length - written, offset + written);
+            if (result < 0 && errno == EINTR) {
+                continue;
+            }
+            if (result <= 0) {
+                error_setg_errno(errp, result < 0 ? errno : EIO,
+                                 "Cannot write private Crucible child file");
+                return false;
+            }
+            written += result;
+        }
+        offset += length;
+    }
+    if (ftruncate(destination, size) < 0) {
+        error_setg_errno(errp, errno, "Cannot size private Crucible child file");
+        return false;
+    }
+#ifdef FICLONE
+sync:
+#endif
+    if (fdatasync(destination) < 0) {
+        error_setg_errno(errp, errno, "Cannot sync private Crucible child file");
+        return false;
+    }
+    return true;
+}
+
+static bool child_file_prepare(HotForkChildFileEntry *entry, Error **errp)
+{
+    struct stat source, destination, after;
+    int reader = -1, writer = -1;
+    bool prepared = false;
+
+    reader = child_file_open(entry->source.descriptor, O_RDONLY, errp);
+    if (reader < 0) {
+        goto out;
+    }
+    if (fstat(reader, &source) < 0 || source.st_dev != entry->source.device ||
+        source.st_ino != entry->source.inode ||
+        (entry->private_file && source.st_size != entry->source_size)) {
+        error_setg(errp, "Crucible source file changed before private copy");
+        goto out;
+    }
+    if (entry->private_file) {
+        writer = child_file_open(entry->destination_fd, O_RDWR, errp);
+        if (writer < 0) {
+            goto out;
+        }
+        if (fstat(writer, &destination) < 0 || destination.st_size != 0 ||
+            destination.st_dev != entry->destination.st_dev ||
+            destination.st_ino != entry->destination.st_ino) {
+            error_setg(errp, "Crucible private destination changed before copy");
+            goto out;
+        }
+        if (!child_file_copy(reader, writer, source.st_size, errp)) {
+            goto out;
+        }
+        if (fstat(writer, &entry->destination) < 0 ||
+            entry->destination.st_size != source.st_size) {
+            error_setg(errp, "Crucible private copy has an unexpected length");
+            goto out;
+        }
+    }
+    if (fstat(reader, &after) < 0 || source.st_size != after.st_size ||
+        source.st_mtim.tv_sec != after.st_mtim.tv_sec ||
+        source.st_mtim.tv_nsec != after.st_mtim.tv_nsec) {
+        error_setg(errp, "Frozen Crucible source changed during private copy");
+        goto out;
+    }
+    entry->prepared_fd = child_file_open(entry->private_file ? writer : reader,
+                                          entry->source.flags, errp);
+    prepared = entry->prepared_fd >= 0;
+out:
+    if (reader >= 0) {
+        close(reader);
+    }
+    if (writer >= 0) {
+        close(writer);
+    }
+    return prepared;
+}
+
+bool qemu_block_hot_fork_source_set_writable_leaf(
+    const QemuBlockHotForkSourceSet *set, BlockDriverState *root,
+    BlockDriverState **leaf, Error **errp)
+{
+    QemuBlockBackendHotForkReadOnlySource *source = NULL;
+    size_t index, visit, found = 0;
+
+    GLOBAL_STATE_CODE();
+    if (!leaf) {
+        error_setg(errp, "Crucible writable leaf lookup requires a result");
+        return false;
+    }
+    *leaf = NULL;
+    if (!set || set->owner != getpid() || !root) {
+        error_setg(errp, "Crucible source set does not own the requested root");
+        return false;
+    }
+    for (index = 0; index < set->sources->len; index++) {
+        QemuBlockBackendHotForkReadOnlySource *candidate =
+            g_ptr_array_index(set->sources, index);
+
+        if (candidate->root == root) {
+            source = candidate;
+            break;
+        }
+    }
+    if (!source) {
+        error_setg(errp, "Crucible source set does not own the requested root");
+        return false;
+    }
+    if (!source_matches(source, errp)) {
+        return false;
+    }
+    for (visit = 0; visit < source->graph->len; visit++) {
+        ReadOnlySourceNode *node =
+            &g_array_index(source->graph, ReadOnlySourceNode, visit);
+
+        if (node->file_pinned && !node->file.read_only) {
+            *leaf = node->node;
+            found++;
+        }
+    }
+    if (found != 1) {
+        *leaf = NULL;
+        error_setg(errp, "Crucible source root does not own exactly one "
+                   "originally writable native leaf");
+        return false;
+    }
+    return true;
+}
+
+ssize_t qemu_block_hot_fork_child_files_descriptors(
+    const QemuBlockHotForkChildFiles *plan, int *descriptors, size_t maximum)
+{
+    size_t index, count = 0;
+
+    GLOBAL_STATE_CODE();
+    if (!plan || plan->owner != getpid() || plan->consumed || !descriptors) {
+        return -1;
+    }
+    for (index = 0; index < plan->files->len; index++) {
+        const HotForkChildFileEntry *entry =
+            &g_array_index(plan->files, HotForkChildFileEntry, index);
+
+        if (maximum - count < 2) {
+            return -1;
+        }
+        descriptors[count++] = entry->source.descriptor;
+        descriptors[count++] = entry->prepared_fd;
+    }
+    return count;
+}
+
+QemuBlockHotForkChildFiles *qemu_block_hot_fork_child_files_prepare(
+    QemuBlockHotForkSourceSet *set, const QemuBlockHotForkChildFile *files,
+    size_t count, uint64_t maximum_bytes, Error **errp)
+{
+    QemuBlockHotForkSourceSetInventory inventory;
+    QemuBlockHotForkChildFiles *plan;
+    size_t index;
+
+    GLOBAL_STATE_CODE();
+    if (count > HOT_FORK_CHILD_MAX_FILES || (count && !files) ||
+        !qemu_block_hot_fork_source_set_query(set, &inventory, errp) ||
+        !inventory.frozen || set->child_plan_active) {
+        if (!errp || !*errp) {
+            error_setg(errp, "Crucible child files require one complete "
+                       "frozen source set");
+        }
+        return NULL;
+    }
+    plan = g_new0(QemuBlockHotForkChildFiles, 1);
+    plan->sources = set;
+    plan->owner = getpid();
+    plan->files = g_array_new(false, false, sizeof(HotForkChildFileEntry));
+    if (!child_files_capture(plan, errp) ||
+        !child_files_bind(plan, files, count, maximum_bytes, errp)) {
+        goto fail;
+    }
+    for (index = 0; index < plan->files->len; index++) {
+        if (!child_file_prepare(
+                &g_array_index(plan->files, HotForkChildFileEntry, index), errp)) {
+            goto fail;
+        }
+    }
+    set->child_plan_active = true;
+    return plan;
+fail:
+    child_files_destroy(plan);
+    return NULL;
+}
+
+bool qemu_block_hot_fork_child_files_free(QemuBlockHotForkChildFiles *plan,
+                                         Error **errp)
+{
+    GLOBAL_STATE_CODE();
+    if (!plan || plan->owner != getpid() || plan->consumed ||
+        !plan->sources->child_plan_active) {
+        error_setg(errp, "Crucible child file plan lost its parent owner");
+        return false;
+    }
+    plan->sources->child_plan_active = false;
+    child_files_destroy(plan);
+    return true;
+}
+
+bool qemu_block_hot_fork_child_files_install(QemuBlockHotForkChildFiles *plan,
+                                            Error **errp)
+{
+    QemuBlockHotForkSourceSet *set;
+    QemuBlockBackendHotForkBarrierInventory barrier;
+    size_t index, visit;
+    bool held;
+
+    GLOBAL_STATE_CODE();
+    if (!plan || plan->owner <= 1 || plan->owner != getppid() ||
+        plan->owner == getpid() || plan->consumed ||
+        !source_set_complete_owned(plan->sources, plan->owner, errp) ||
+        !qemu_aio_hot_fork_thread_pools_empty() ||
+        !qemu_block_hot_fork_all_sources_fork_safe(errp)) {
+        if (!errp || !*errp) {
+            error_setg(errp, "Crucible file installation requires a "
+                       "quiescent immediate child");
+        }
+        return false;
+    }
+    if (!qemu_block_backend_hot_fork_barrier(
+            QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_QUERY, &barrier)) {
+        error_setg(errp, "Cannot inspect child block barriers");
+        return false;
+    }
+    held = barrier.held || barrier.graph_held;
+    qemu_block_backend_hot_fork_barrier_inventory_destroy(&barrier);
+    if (held) {
+        error_setg(errp, "Crucible file installation requires released block barriers");
+        return false;
+    }
+    set = plan->sources;
+    plan->consumed = true;
+    {
+        GRAPH_RDLOCK_GUARD_MAINLOOP();
+        for (index = 0; index < plan->files->len; index++) {
+            HotForkChildFileEntry *entry =
+                &g_array_index(plan->files, HotForkChildFileEntry, index);
+            struct stat actual;
+            dev_t device = entry->private_file ?
+                entry->destination.st_dev : entry->source.device;
+            ino_t inode = entry->private_file ?
+                entry->destination.st_ino : entry->source.inode;
+
+            if (fstat(entry->prepared_fd, &actual) < 0 ||
+                actual.st_dev != device || actual.st_ino != inode ||
+                (entry->private_file &&
+                 (actual.st_size != entry->destination.st_size ||
+                  actual.st_mtim.tv_sec != entry->destination.st_mtim.tv_sec ||
+                  actual.st_mtim.tv_nsec != entry->destination.st_mtim.tv_nsec)) ||
+                !entry->node->drv->bdrv_crucible_hot_fork_file_child(
+                    entry->node, plan->owner, entry->prepared_fd, errp)) {
+                if (!errp || !*errp) {
+                    error_setg(errp, "Crucible prepared child file lost its identity");
+                }
+                return false;
+            }
+        }
+        for (index = 0; index < set->sources->len; index++) {
+            QemuBlockBackendHotForkReadOnlySource *source =
+                g_ptr_array_index(set->sources, index);
+
+            source->owner = getpid();
+            for (visit = 0; visit < source->graph->len; visit++) {
+                ReadOnlySourceNode *node =
+                    &g_array_index(source->graph, ReadOnlySourceNode, visit);
+                if (node->file_pinned &&
+                    !node->driver->bdrv_crucible_hot_fork_file(
+                        node->node, BDRV_CRUCIBLE_HOT_FORK_FILE_QUERY,
+                        &node->file, errp)) {
+                    return false;
+                }
+            }
+        }
+    }
+    set->owner = getpid();
+    set->child_plan_active = false;
+    if (!qemu_block_hot_fork_source_set_restore(set, errp) ||
+        !qemu_block_hot_fork_source_set_free(set, errp)) {
+        return false;
+    }
+    child_files_destroy(plan);
+    return true;
+}
