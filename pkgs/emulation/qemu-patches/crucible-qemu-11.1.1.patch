+    g_assert_true(WIFEXITED(status));
+    g_assert_cmpint(WEXITSTATUS(status), ==, 0);
+    g_assert_cmpint(fcntl(duplicate, F_GETFL), ==, entry.source.flags);
+    g_assert_true(raw_crucible_hot_fork_file(
+        &node, BDRV_CRUCIBLE_HOT_FORK_FILE_UNPIN, &entry.source, &err));
+    g_assert_null(err);
+    g_assert_cmpint(close(prepared), ==, 0);
+    g_assert_cmpint(close(pin), ==, 0);
+    g_assert_cmpint(close(duplicate), ==, 0);
+    g_assert_cmpint(close(destination), ==, 0);
+    if (adoption_fd >= 0) {
+        g_assert_cmpint(close(adoption_fd), ==, 0);
+    }
