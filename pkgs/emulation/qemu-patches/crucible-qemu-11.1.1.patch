+/*
+ * Fixed process-purpose evidence and bounded borrowed sealed-plan reader
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/bswap.h"
+#include "qemu/memfd.h"
+#include "qemu/crucible-process-purpose.h"
+#include "qemu/crucible-publisher-protocol.h"
+
+static bool purpose_nonzero(const uint8_t *bytes, size_t length)
+{
+    uint8_t nonzero = 0;
+
+    for (size_t index = 0; index < length; index++) {
+        nonzero |= bytes[index];
+    }
+    return nonzero != 0;
+}
+
+static bool purpose_add(uint64_t *sum, uint64_t value)
+{
+    if (value > UINT64_MAX - *sum) {
+        return false;
+    }
+    *sum += value;
+    return true;
+}
+
+static int standing_optional_ns(const uint8_t *wire, size_t length,
+                                size_t *cursor, bool *present, uint64_t *value)
+{
+    uint8_t tag;
+
+    if (*cursor >= length) {
+        return -EMSGSIZE;
+    }
+    tag = wire[(*cursor)++];
+    *present = tag == 1;
+    *value = 0;
+    if (tag == 0) {
+        return 0;
+    }
+    if (tag != 1 || length - *cursor < 8) {
+        return -EPROTO;
+    }
+    *value = ldq_be_p(wire + *cursor);
+    *cursor += 8;
+    return !*value || *value > INT64_MAX ? -ERANGE : 0;
+}
+
+static int boundary_publication_rows_decode(
+    const uint8_t *wire, QemuCrucibleProducingActionRow *rows,
+    uint32_t primary_count, uint32_t planned_count, uint32_t projected_mask)
+{
+    for (size_t index = 0; index < QEMU_CRUCIBLE_ACTION_PARENT_CAPACITY; index++) {
+        const uint8_t *bytes = wire + 128 + index * QEMU_CRUCIBLE_ACTION_ROW_BYTES;
+        QemuCrucibleProducingActionRow *row = &rows[index];
+
+        /* A born membership can lack a projection. Its physical custody bit
+         * remains present even though its row carries no semantic evidence. */
+        if (index >= planned_count || !(projected_mask & (1U << index))) {
+            if (purpose_nonzero(bytes, QEMU_CRUCIBLE_ACTION_ROW_BYTES)) {
+                return -EPROTO;
+            }
