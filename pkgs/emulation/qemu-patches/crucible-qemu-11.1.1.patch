+        watcher->process != getpid() ||
+        !qemu_thread_is_self(&watcher->snapshot_thread)) {
+        return -ESTALE;
+    }
+    /* A callback-return/error scalar cannot end this journal. The exact
+     * execution carrier proves its Source call returned and real field closed. */
+    status = qemu_crucible_fingerprint_main_ready_snapshot_returned_current_v1(
+        frame, watcher, registration_serial);
