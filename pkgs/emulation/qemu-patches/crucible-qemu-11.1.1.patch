+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Compile actual CR8 readers with a refusal-only getter fault injection.
+
+The architecture objects here are component inputs, without QOM enrollment,
+Source ownership or an initial callback. A negative test getter cannot issue
+any authority. Accelerator scalar conventions are checked directly against
+their literal producers; no accelerator or installed path is exercised.
+"""
+
+import argparse
+import json
+import os
+from pathlib import Path
+import runpy
+import shlex
+import subprocess
