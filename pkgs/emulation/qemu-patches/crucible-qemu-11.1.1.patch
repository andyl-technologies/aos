+QEMU_PLUGIN_EXPORT int qemu_plugin_install(qemu_plugin_id_t id,
+                                           const qemu_info_t *info,
+                                           int argc, char **argv)
+{
+    struct qemu_plugin_crucible_fault_register_capability *rows;
+    const struct qemu_plugin_crucible_fault_register_capability *selected;
+    struct qemu_plugin_crucible_fault_capability capability;
+    const char *cpu_model = NULL;
+    uint16_t observed_architecture = 0;
+    size_t count;
+   size_t capability_count;
+
+#ifdef CRUCIBLE_FIXTURE_RESIDENT_OWNER
+    /* Standalone component builds own resident RAM; managed builds omit this
+     * flag and retain the production observer's physical paging authority. */
+    if (crucible_fixture_install_resident_ram() != 0) {
+        test_fail("resident logical RAM owner registration failed");
+    }
+#endif
+
+    (void)info;
+    if ((argc != 4 && argc != 5) ||
+        !g_str_has_prefix(argv[0], "architecture=") ||
+        !g_str_has_prefix(argv[1], "mode=") ||
+        !g_str_has_prefix(argv[2], "register=") ||
+        !g_str_has_prefix(argv[3], "phase=") ||
+        (argc == 5 &&
+         !g_str_has_prefix(argv[4], "result-address=") &&
+         strcmp(argv[4], "terminal-cursor=true") != 0)) {
+        test_fail("architecture, mode, register, phase, and optional result-address or terminal-cursor argument are required");
+    }
+    test_architecture = g_ascii_strtoull(argv[0] + 13, NULL, 10);
+    if (strcmp(argv[1] + 5, "impulse") == 0) {
+        test_mode = TEST_MODE_IMPULSE;
+    } else if (strcmp(argv[1] + 5, "persistent") == 0) {
+        test_mode = TEST_MODE_PERSISTENT;
+    } else if (strcmp(argv[1] + 5, "reject-invalid") == 0) {
+        test_mode = TEST_MODE_REJECT_INVALID;
+    } else if (strcmp(argv[1] + 5, "reject-reserved") == 0) {
+        test_mode = TEST_MODE_REJECT_RESERVED;
+    } else if (strcmp(argv[1] + 5, "reject-read-only") == 0) {
+        test_mode = TEST_MODE_REJECT_READ_ONLY;
+    } else if (strcmp(argv[1] + 5, "reject-out-of-range") == 0) {
+        test_mode = TEST_MODE_REJECT_OUT_OF_RANGE;
+    } else if (strcmp(argv[1] + 5,
+                      "reject-mismatched-register-identity") == 0) {
+        test_mode = TEST_MODE_REJECT_MISMATCHED_REGISTER_IDENTITY;
+    } else if (strcmp(argv[1] + 5,
+                      "reject-unknown-register-identity") == 0) {
+        test_mode = TEST_MODE_REJECT_UNKNOWN_REGISTER_IDENTITY;
+    } else if (strcmp(argv[1] + 5,
+                      "reject-architecture-identity") == 0) {
+        test_mode = TEST_MODE_REJECT_ARCHITECTURE_IDENTITY;
+    } else if (strcmp(argv[1] + 5, "reject-vcpu") == 0) {
+        test_mode = TEST_MODE_REJECT_VCPU;
+    } else if (strcmp(argv[1] + 5, "reject-precondition") == 0) {
+        test_mode = TEST_MODE_REJECT_PRECONDITION;
+    } else {
+        test_fail("mode is not a supported register mutation scenario");
+    }
+    test_register_name = argv[2] + 9;
+    if (!*test_register_name) {
+        test_fail("register must name one manifest row");
+    }
+    if (strcmp(argv[3] + 6, "before") == 0) {
+        test_model_phase = TEST_MODEL_PHASE_BEFORE_INSTRUCTION;
+        test_command_phase = CRUCIBLE_FAULT_PHASE_BEFORE_INSTRUCTION;
+    } else if (strcmp(argv[3] + 6, "after") == 0) {
+        test_model_phase = TEST_MODEL_PHASE_AFTER_INSTRUCTION;
+        test_command_phase = CRUCIBLE_FAULT_PHASE_AFTER_INSTRUCTION;
+    } else {
+        test_fail("phase must be before or after");
+    }
+    if (argc == 5 && g_str_has_prefix(argv[4], "result-address=")) {
+        test_result_address = g_ascii_strtoull(argv[4] + 15, NULL, 0);
+        test_guest_observation_required = true;
+        if (test_mode != TEST_MODE_PERSISTENT || test_result_address == 0) {
+            test_fail("result-address is valid only for a persistent guest-observation test");
+        }
+    }
+    if (argc == 5 && strcmp(argv[4], "terminal-cursor=true") == 0) {
+        if (test_mode != TEST_MODE_IMPULSE ||
+            test_model_phase != TEST_MODEL_PHASE_AFTER_INSTRUCTION) {
+            test_fail("terminal-cursor mode requires an after-instruction impulse");
+        }
+        test_terminal_cursor_required = true;
+    }
+    {
+        struct qemu_plugin_rr_cursor rr = { 0 };
+
+        if (qemu_plugin_rr_cursor(&rr) == 0) {
+            test_fail("the RR cursor reported an owner outside a vCPU callback");
+        }
+    }
+    capability_count = qemu_plugin_crucible_fault_capabilities(
+        &capability, 1);
+    if (capability_count < 4) {
+        test_fail("the complete fault registry is unavailable");
+    }
+    count = qemu_plugin_crucible_fault_register_manifest(
+        NULL, 0, &observed_architecture, &cpu_model);
+    if (count == 0 || count > 4096 ||
+        observed_architecture != test_architecture ||
+        !cpu_model || !*cpu_model) {
+        test_fail("the realized CPU register manifest is unavailable");
+    }
+    rows = g_new0(struct qemu_plugin_crucible_fault_register_capability,
+                  count);
+    if (qemu_plugin_crucible_fault_register_manifest(
+            rows, count, &observed_architecture, &cpu_model) != count) {
+        test_fail("the register manifest changed during installation");
+    }
+    test_identity(test_architecture_identity, 0xb1, test_architecture);
+    if (qemu_plugin_crucible_fault_register_bind_architecture(
+            test_architecture_identity) != 0) {
+        test_fail("the architecture identity could not be bound");
+    }
+    for (size_t i = 0; i < count; i++) {
+        uint8_t identity[32];
+
+        if (strcmp(rows[i].name, "cr0") == 0) {
+            test_cr0_numeric_id = rows[i].numeric_id;
+        }
+        test_identity(identity, 0xb2, rows[i].numeric_id);
+        if (qemu_plugin_crucible_fault_register_bind(
+                identity, rows[i].numeric_id) != 0) {
+            test_fail("a register identity could not be bound");
+        }
+    }
+    if (qemu_plugin_crucible_fault_register_bindings_seal() != 0) {
+        test_fail("the complete register identity map could not be sealed");
+    }
+    selected = test_select_register(rows, count);
+    if (!selected) {
+        test_fail("the safe live-test register is not writable");
+    }
+    test_numeric_id = selected->numeric_id;
+    test_group = selected->group;
+    test_side_effects = selected->side_effects;
+    {
+        size_t required_len = 0;
+
+        if (qemu_plugin_crucible_fault_register_read(
+                0, test_numeric_id, NULL, 0, &required_len) != -ENOSPC ||
+            required_len != selected->mask_bytes) {
+            test_fail("fault register size query returned the wrong contract");
+        }
+    }
+    if (test_mode_rejects()) {
+        if (test_architecture != QEMU_PLUGIN_CRUCIBLE_FAULT_SCOPE_X86_64) {
+            test_fail("register rejection modes require x86_64");
+        }
+    }
+    test_identity(test_register_identity, 0xb2, test_numeric_id);
+    if (test_mode == TEST_MODE_REJECT_INVALID) {
+        /* Clearing EFER.LME while paging is active is architecturally invalid. */
+        test_first_bit = 8;
+        if (strcmp(test_register_name, "efer") != 0 ||
+            test_first_bit >= selected->width_bits ||
+            !test_mask_bit(selected->writable_mask, test_first_bit)) {
+            test_fail("the invalid-state target is not EFER.LME");
+        }
+    } else if (test_mode == TEST_MODE_REJECT_OUT_OF_RANGE) {
+        test_first_bit = selected->width_bits;
+    } else {
+        const uint8_t *wanted_mask =
+            test_mode == TEST_MODE_REJECT_RESERVED ?
+            selected->reserved_mask :
+            (test_mode == TEST_MODE_REJECT_READ_ONLY ?
+             selected->read_only_mask : selected->writable_mask);
+
+        for (test_first_bit = 0; test_first_bit < selected->width_bits;
+             test_first_bit++) {
+            if (test_mask_bit(wanted_mask, test_first_bit)) {
+                break;
+            }
+        }
+    }
+    if (test_first_bit == selected->width_bits) {
+        if (test_mode != TEST_MODE_REJECT_OUT_OF_RANGE) {
+            test_fail("the selected register lacks the requested bit class");
+        }
+    }
+    if (test_mode == TEST_MODE_PERSISTENT) {
+        uint32_t first_candidate =
+            test_architecture == QEMU_PLUGIN_CRUCIBLE_FAULT_SCOPE_AARCH64 &&
+            strcmp(test_register_name, "pstate") == 0 ? 28 : 0;
+
+        for (test_first_bit = first_candidate;
+             test_first_bit < selected->width_bits;
+             test_first_bit++) {
+            if (test_mask_bit(selected->writable_mask, test_first_bit)) {
+                break;
+            }
+        }
+        if (test_first_bit == selected->width_bits) {
+            test_fail("persistent target has no selected writable bit");
+        }
+    }
+    g_free(rows);
+
+    memset(&test_command, 0, sizeof(test_command));
+    test_command.abi_major = CRUCIBLE_FAULT_COMMAND_ABI_MAJOR;
+    test_command.abi_minor = CRUCIBLE_FAULT_COMMAND_ABI_MINOR;
+    test_command.command_kind =
+        CRUCIBLE_FAULT_COMMAND_CPU_REGISTER_TRANSFORM;
+    test_command.command_flags = CRUCIBLE_FAULT_COMMAND_FLAG_PREPARE_ONLY;
+    test_command.phase = test_mode != TEST_MODE_PERSISTENT ?
+        test_command_phase : CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY;
+    test_command.semantic_version = CRUCIBLE_FAULT_COMMAND_SEMANTIC_VERSION;
+    test_command.command_sequence = 1;
+    memset(test_command.target_node_hash, 0x11, 32);
+    test_command.target_icount = test_mode_rejects() ? 512 : 64;
+    test_command.authorization_ceiling_icount = test_command.target_icount;
+    test_command.target_tick = test_command.target_icount *
+        CRUCIBLE_SHMEM_TICKS_PER_INSTRUCTION;
+    test_command.authorization_ceiling_tick = test_command.target_tick;
+    memset(test_command.binding_hash, 0x21, 32);
+    test_payload = test_build_payload(&test_payload_len);
+    qemu_plugin_register_crucible_fault_completion_cb(test_completion, NULL);
+    qemu_plugin_register_vcpu_tb_trans_cb(id, test_tb_trans, NULL);
+    qemu_plugin_register_atexit_cb(id, test_exit, NULL);
+    if (!test_mode_rejects()) {
+        if (qemu_plugin_crucible_fault_submit(
+                &test_command, test_payload, test_payload_len) != 0) {
+            test_fail("QEMU rejected the register mutation preparation");
+        }
+        test_initial_command_submitted = true;
+    }
+    return 0;
+}
