+    if (!apic || !bql_locked() || apic->crucible_getter_frame != frame ||
+        !frame || &apic->crucible_getter_loan != holder) {
+        return -EPERM;
+    }
+    if (frame->cpu != CPU(apic->cpu) || frame->child != OBJECT(apic) ||
+        frame->holder != holder || frame->process != getpid() ||
+        !qemu_thread_is_self(&frame->thread)) {
+        return -ESTALE;
+    }
+
+    switch (phase) {
+    case QEMU_CRUCIBLE_APIC_GETTER_ISSUING:
+        return frame->issuing && !frame->calling && !frame->returning &&
+            !frame->software_calling && !frame->callback_returned ? 0 : -EPERM;
+    case QEMU_CRUCIBLE_APIC_GETTER_SOFTWARE:
+        if (!frame->software_calling) {
+            return -EPERM;
+        }
+        if (frame->vapic_address != apic->vapic_paddr ||
+            frame->vapic_length != sizeof(VAPICState)) {
+            return -ESTALE;
+        }
+        return frame->serial && !frame->issuing && frame->calling &&
+            frame->software_calling && !frame->software_returned &&
+            !frame->callback_returned && !frame->returning ? 0 : -EPERM;
+    case QEMU_CRUCIBLE_APIC_GETTER_RETURNING:
+        return !frame->issuing && !frame->calling && !frame->software_calling &&
+            frame->returning ? 0 : -EPERM;
