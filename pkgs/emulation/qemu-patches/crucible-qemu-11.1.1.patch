+/* Refusal-only link leaves. None can authenticate or issue any owner. */
+static int refuse_native(void)
+{
+    native_calls++;
+    return -EPERM;
+}
+
+static int refuse_recipient(void)
+{
+    recipient_calls++;
+    return -ENOKEY;
+}
+
+static int refuse_identity(void)
+{
