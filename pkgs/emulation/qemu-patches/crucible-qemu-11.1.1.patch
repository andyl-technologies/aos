+ */
+
+#include <glib.h>
+#include <qemu-plugin.h>
+
+#ifdef CRUCIBLE_FIXTURE_RESIDENT_OWNER
+#include "crucible-resident-ram.h"
+#endif
+
+#include "aos/crucible/crucible_shmem_abi.h"
+
+QEMU_PLUGIN_EXPORT int qemu_plugin_version = QEMU_PLUGIN_VERSION;
+
+#define TEST_REGISTER_EVIDENCE_HEADER_BYTES 168
+#define TEST_EVENT_ENVELOPE_HEADER_BYTES 192
+#define TEST_MODEL_PHASE_BEFORE_INSTRUCTION 11
+#define TEST_MODEL_PHASE_AFTER_INSTRUCTION 12
+
+typedef enum TestMode {
+    TEST_MODE_IMPULSE,
+    TEST_MODE_PERSISTENT,
+    TEST_MODE_REJECT_INVALID,
+    TEST_MODE_REJECT_RESERVED,
+    TEST_MODE_REJECT_READ_ONLY,
+    TEST_MODE_REJECT_OUT_OF_RANGE,
+    TEST_MODE_REJECT_MISMATCHED_REGISTER_IDENTITY,
+    TEST_MODE_REJECT_UNKNOWN_REGISTER_IDENTITY,
+    TEST_MODE_REJECT_ARCHITECTURE_IDENTITY,
+    TEST_MODE_REJECT_VCPU,
+    TEST_MODE_REJECT_PRECONDITION,
+} TestMode;
+
+static TestMode test_mode;
+static uint16_t test_architecture;
+static uint16_t test_model_phase;
+static uint16_t test_command_phase;
+static uint32_t test_numeric_id;
+static uint32_t test_cr0_numeric_id;
+static uint16_t test_group;
+static uint32_t test_first_bit;
+static uint32_t test_side_effects;
+static const char *test_register_name;
+static uint64_t test_result_address;
+static bool test_guest_observation_required;
+static bool test_guest_observed;
+static bool test_terminal_cursor_required;
+static uint8_t test_architecture_identity[32];
+static uint8_t test_register_identity[32];
+static uint8_t test_action_hash[32];
+static uint8_t test_target_hash[32];
+static uint8_t *test_payload;
+static size_t test_payload_len;
+static struct qemu_plugin_crucible_fault_command test_command;
+static bool test_commit_submitted;
+static bool test_initial_command_submitted;
+static bool test_rule_installed;
+static bool test_result_validated;
+static bool test_validated;
+static bool test_finished;
+static uint8_t test_initial_target[64];
+static size_t test_initial_target_len;
+static bool test_submit_atomic_verified;
+static char test_execution_fingerprint[65];
+
+static bool test_mode_rejects(void)
+{
+    return test_mode >= TEST_MODE_REJECT_INVALID;
+}
+
+static const char *test_mode_name(void)
+{
+    static const char * const names[] = {
+        "impulse",
+        "persistent",
+        "reject-invalid",
+        "reject-reserved",
+        "reject-read-only",
+        "reject-out-of-range",
+        "reject-mismatched-register-identity",
+        "reject-unknown-register-identity",
+        "reject-architecture-identity",
+        "reject-vcpu",
+        "reject-precondition",
+    };
+
+    return names[test_mode];
+}
+
+static uint16_t test_get_u16(const uint8_t *bytes)
+{
+    return bytes[0] | (uint16_t)bytes[1] << 8;
+}
+
+static uint32_t test_get_u32(const uint8_t *bytes)
+{
+    return bytes[0] | (uint32_t)bytes[1] << 8 |
+           (uint32_t)bytes[2] << 16 | (uint32_t)bytes[3] << 24;
+}
+
+static uint64_t test_get_u64(const uint8_t *bytes)
+{
+    return test_get_u32(bytes) | (uint64_t)test_get_u32(bytes + 4) << 32;
+}
+
+static void test_put_u16(uint8_t *bytes, uint16_t value)
+{
+    bytes[0] = value;
+    bytes[1] = value >> 8;
+}
+
+static void test_put_u32(uint8_t *bytes, uint32_t value)
+{
+    for (size_t i = 0; i < sizeof(value); i++) {
+        bytes[i] = value >> (8 * i);
+    }
+}
+
+static void test_put_u64(uint8_t *bytes, uint64_t value)
+{
+    for (size_t i = 0; i < sizeof(value); i++) {
+        bytes[i] = value >> (8 * i);
+    }
+}
+
+static void test_fail(const char *message)
+{
+    g_printerr("Crucible register mutation live test failed: %s\n", message);
+    abort();
+}
+
+static const uint8_t *test_event_evidence(
+    const struct qemu_plugin_crucible_fault_event *event,
+    const uint8_t *envelope, size_t envelope_len, size_t *evidence_len)
+{
+    uint32_t request_len;
+    uint32_t encoded_evidence_len;
+
+    if (envelope_len < TEST_EVENT_ENVELOPE_HEADER_BYTES ||
+        memcmp(envelope, "CRUCEVQ1", 8) != 0 ||
+        test_get_u16(envelope + 8) != 1) {
+        test_fail("fault event envelope header is invalid");
+    }
+    request_len = test_get_u32(envelope + 12);
+    encoded_evidence_len = test_get_u32(envelope + 16);
+    if (request_len > envelope_len - TEST_EVENT_ENVELOPE_HEADER_BYTES ||
+        encoded_evidence_len !=
+            envelope_len - TEST_EVENT_ENVELOPE_HEADER_BYTES - request_len ||
+        encoded_evidence_len != event->evidence_length) {
+        test_fail("fault event envelope lengths are invalid");
+    }
+    *evidence_len = encoded_evidence_len;
+    return envelope + TEST_EVENT_ENVELOPE_HEADER_BYTES + request_len;
+}
+
+static bool test_mask_bit(const uint8_t *mask, uint32_t bit)
+{
+    return (mask[bit / 8] & (1U << (bit % 8))) != 0;
+}
+
+/* Proves that a rejected request leaves the complete target register intact. */
+static bool test_rejection_target_unchanged(const uint8_t *current,
+                                            size_t current_len)
+{
+    return test_initial_target_len != 0 &&
+        current_len == test_initial_target_len &&
+        memcmp(current, test_initial_target, current_len) == 0;
+}
+
+static bool test_bytes_nonzero(const uint8_t *bytes, size_t length)
+{
+    for (size_t i = 0; i < length; i++) {
+        if (bytes[i] != 0) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static void test_sha256(const uint8_t *bytes, size_t length,
+                        uint8_t output[32])
+{
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    gsize output_len = 32;
+
+    g_checksum_update(checksum, bytes, length);
+    g_checksum_get_digest(checksum, output, &output_len);
+    if (output_len != 32) {
+        test_fail("SHA-256 evidence framing failed");
+    }
+}
+
+static size_t test_read_fault_register_id(uint32_t numeric_id,
+                                          uint8_t output[64])
+{
+    size_t output_len = 0;
+
+    if (qemu_plugin_crucible_fault_register_read(
+            0, numeric_id, output, 64, &output_len) != 0 ||
+        output_len == 0 || output_len > 64) {
+        test_fail("fault register observation failed");
+    }
+    return output_len;
+}
+
+static size_t test_read_fault_register(uint8_t output[64])
+{
+    return test_read_fault_register_id(test_numeric_id, output);
+}
+
+static void test_identity(uint8_t output[32], uint8_t domain, uint32_t value)
+{
+    memset(output, 0, 32);
+    output[0] = domain;
+    test_put_u32(output + 1, value);
+}
+
+static void test_append_field(GByteArray *payload, uint16_t tag,
+                              uint16_t type, const void *value,
+                              uint32_t length)
+{
+    uint8_t header[CRUCIBLE_NODE_FAULT_FIELD_HEADER_V1_BYTES] = { 0 };
+
+    test_put_u16(header + CRUCIBLE_NODE_FAULT_FIELD_TAG_OFFSET, tag);
+    test_put_u16(header + CRUCIBLE_NODE_FAULT_FIELD_TYPE_OFFSET, type);
+    test_put_u32(header + CRUCIBLE_NODE_FAULT_FIELD_LENGTH_OFFSET, length);
+    g_byte_array_append(payload, header, sizeof(header));
+    g_byte_array_append(payload, value, length);
+}
+
+static void test_append_u32(GByteArray *payload, uint16_t tag, uint32_t value)
+{
+    uint8_t bytes[4];
+
+    test_put_u32(bytes, value);
+    test_append_field(payload, tag, CRUCIBLE_NODE_FAULT_FIELD_TYPE_U32,
+                      bytes, sizeof(bytes));
+}
+
+static uint8_t *test_build_payload(size_t *payload_len)
+{
+    static const uint8_t policy[] =
+        "CRUCJSN1{\"kind\":\"every\"}";
+    g_autoptr(GByteArray) payload = g_byte_array_sized_new(512);
+    uint8_t header[CRUCIBLE_NODE_FAULT_PAYLOAD_HEADER_V1_BYTES] = { 0 };
+    uint8_t mask = 1;
+    uint8_t value = test_mode == TEST_MODE_PERSISTENT ? 1 : 0;
+    uint8_t has_value = test_mode == TEST_MODE_PERSISTENT;
+    uint8_t schema_hash[32];
+    uint8_t architecture_identity[32];
+    uint8_t action_register_identity[32];
+    uint8_t register_identity[32];
+    uint32_t vcpu = test_mode == TEST_MODE_REJECT_VCPU ? 1 : 0;
+    uint32_t mutation = test_mode != TEST_MODE_PERSISTENT ?
+        CRUCIBLE_FAULT_REGISTER_MUTATION_BIT_FLIP :
+        CRUCIBLE_FAULT_REGISTER_MUTATION_STUCK;
+
+    test_identity(test_action_hash, 0xa1, test_numeric_id);
+    test_identity(test_target_hash, 0xa2, test_numeric_id);
+    test_identity(schema_hash, 0xa3, 1);
+    memcpy(architecture_identity, test_architecture_identity, 32);
+    memcpy(action_register_identity, test_register_identity, 32);
+    memcpy(register_identity, test_register_identity, 32);
+    if (test_mode == TEST_MODE_REJECT_ARCHITECTURE_IDENTITY) {
+        architecture_identity[31] ^= 1;
+    }
+    if (test_mode == TEST_MODE_REJECT_MISMATCHED_REGISTER_IDENTITY) {
+        register_identity[31] ^= 1;
+    }
+    if (test_mode == TEST_MODE_REJECT_UNKNOWN_REGISTER_IDENTITY) {
+        action_register_identity[31] ^= 1;
+        register_identity[31] ^= 1;
+    }
+    memcpy(header + CRUCIBLE_NODE_FAULT_PAYLOAD_MAGIC_OFFSET,
+           "CRUCNOD1", 8);
+    test_put_u16(header + CRUCIBLE_NODE_FAULT_PAYLOAD_VERSION_OFFSET,
+                 CRUCIBLE_NODE_FAULT_PAYLOAD_VERSION_V1);
+    test_put_u16(header + CRUCIBLE_NODE_FAULT_PAYLOAD_COMMAND_KIND_OFFSET,
+                 CRUCIBLE_FAULT_COMMAND_CPU_REGISTER_TRANSFORM);
+    test_put_u16(header + CRUCIBLE_NODE_FAULT_PAYLOAD_OPERATION_OFFSET,
+                 test_mode != TEST_MODE_PERSISTENT ?
+                 CRUCIBLE_NODE_FAULT_OPERATION_APPLY :
+                 CRUCIBLE_NODE_FAULT_OPERATION_UPSERT);
+    test_put_u16(header + CRUCIBLE_NODE_FAULT_PAYLOAD_TARGET_KIND_OFFSET,
+                 CRUCIBLE_NODE_FAULT_TARGET_REGISTER);
+    test_put_u16(header + CRUCIBLE_NODE_FAULT_PAYLOAD_MODEL_PHASE_OFFSET,
+                 test_model_phase);
+    test_put_u64(header + CRUCIBLE_NODE_FAULT_PAYLOAD_GENERATION_OFFSET, 1);
+    memcpy(header + CRUCIBLE_NODE_FAULT_PAYLOAD_ACTION_HASH_OFFSET,
+           test_action_hash, sizeof(test_action_hash));
+    memcpy(header + CRUCIBLE_NODE_FAULT_PAYLOAD_TARGET_HASH_OFFSET,
+           test_target_hash, sizeof(test_target_hash));
+    memcpy(header + CRUCIBLE_NODE_FAULT_PAYLOAD_SCHEMA_HASH_OFFSET,
+           schema_hash, sizeof(schema_hash));
+    test_put_u16(header + CRUCIBLE_NODE_FAULT_PAYLOAD_FIELD_COUNT_OFFSET, 13);
+    g_byte_array_append(payload, header, sizeof(header));
+
+    test_append_field(payload, CRUCIBLE_NODE_FAULT_FIELD_P1,
+                      CRUCIBLE_NODE_FAULT_FIELD_TYPE_HASH,
+                      action_register_identity, 32);
+    test_append_u32(payload, CRUCIBLE_NODE_FAULT_FIELD_P2, test_first_bit);
+    test_append_u32(payload, CRUCIBLE_NODE_FAULT_FIELD_P3, 1);
+    test_append_u32(payload, CRUCIBLE_NODE_FAULT_FIELD_P4, mutation);
+    test_append_field(payload, CRUCIBLE_NODE_FAULT_FIELD_P5,
+                      CRUCIBLE_NODE_FAULT_FIELD_TYPE_BYTES, &mask, 1);
+    test_append_field(payload, CRUCIBLE_NODE_FAULT_FIELD_P6,
+                      CRUCIBLE_NODE_FAULT_FIELD_TYPE_BOOL, &has_value, 1);
+    test_append_field(payload, CRUCIBLE_NODE_FAULT_FIELD_P7,
+                      CRUCIBLE_NODE_FAULT_FIELD_TYPE_BYTES, &value, 1);
+    test_append_field(payload, CRUCIBLE_NODE_FAULT_FIELD_P8,
+                      CRUCIBLE_NODE_FAULT_FIELD_TYPE_BYTES,
+                      policy, sizeof(policy) - 1);
+    test_append_u32(payload, CRUCIBLE_NODE_FAULT_FIELD_T1, vcpu);
+    test_append_field(payload, CRUCIBLE_NODE_FAULT_FIELD_T2,
+                      CRUCIBLE_NODE_FAULT_FIELD_TYPE_HASH,
+                      architecture_identity, 32);
+    test_append_field(payload, CRUCIBLE_NODE_FAULT_FIELD_T3,
+                      CRUCIBLE_NODE_FAULT_FIELD_TYPE_HASH,
+                      register_identity, 32);
+    test_append_u32(payload, CRUCIBLE_NODE_FAULT_FIELD_T4, test_first_bit);
+    test_append_u32(payload, CRUCIBLE_NODE_FAULT_FIELD_T5, 1);
+    *payload_len = payload->len;
+    return g_byte_array_free(g_steal_pointer(&payload), false);
+}
+
+static bool test_validate_register_evidence(const uint8_t *evidence,
+                                            size_t evidence_len,
+                                            bool require_change,
+                                            uint64_t expected_icount,
+                                            uint64_t expected_tick,
+                                            const uint8_t expected_before[32],
+                                            const uint8_t expected_after[32],
+                                            const uint8_t expected_evidence[32])
+{
+    uint32_t before_len;
+    uint32_t after_len;
+    uint32_t mask_len;
+    uint32_t value_len;
+    const uint8_t *before;
+    const uint8_t *after;
+    const uint8_t *mask;
+    const uint8_t *value;
+    uint8_t before_bit;
+    uint8_t after_bit;
+    uint8_t digest[32];
+    bool fingerprint_changed;
+    bool register_changed;
+    uint64_t cursor_position;
+    uint64_t rr_switch_quantum;
+    uint32_t expected_mutation = test_mode == TEST_MODE_IMPULSE ?
+        CRUCIBLE_FAULT_REGISTER_MUTATION_BIT_FLIP :
+        CRUCIBLE_FAULT_REGISTER_MUTATION_STUCK;
+
+    if (evidence_len < TEST_REGISTER_EVIDENCE_HEADER_BYTES) {
+        test_fail("register evidence header is truncated");
+    }
+    cursor_position = test_get_u64(evidence + 72);
+    rr_switch_quantum = test_get_u64(evidence + 80);
+
+    if (memcmp(evidence, "CRUCQRW2", 8) != 0 ||
+        test_get_u16(evidence + 8) != 2 ||
+        test_get_u16(evidence + 10) != test_architecture ||
+        test_get_u16(evidence + 12) != test_model_phase ||
+        test_get_u16(evidence + 14) != 0 ||
+        test_get_u32(evidence + 16) != 0 ||
+        test_get_u32(evidence + 20) != test_numeric_id ||
+        test_get_u32(evidence + 24) != expected_mutation ||
+        test_get_u32(evidence + 28) != test_side_effects ||
+        test_get_u32(evidence + 32) != test_side_effects ||
+        test_get_u32(evidence + 36) != test_first_bit ||
+        test_get_u32(evidence + 40) != 1 ||
+        test_get_u64(evidence + 56) != expected_icount ||
+        test_get_u64(evidence + 64) != 0 ||
+        rr_switch_quantum == 0 ||
+        cursor_position >= rr_switch_quantum ||
+        cursor_position != expected_icount % rr_switch_quantum ||
+        (test_terminal_cursor_required &&
+         cursor_position != 0) ||
+        !test_bytes_nonzero(evidence + 88, 32) ||
+        !test_bytes_nonzero(evidence + 120, 32) ||
+        test_get_u32(evidence + 156) != 0 ||
+        test_get_u64(evidence + 160) != expected_tick) {
+        g_printerr("register evidence debug phase=%u vcpu=%u numeric=%u "
+                   "icount=%" G_GUINT64_FORMAT " current=%" G_GUINT64_FORMAT
+                   " cursor=%" G_GUINT64_FORMAT " quantum=%" G_GUINT64_FORMAT
+                   " terminal=%s\n",
+                   test_get_u16(evidence + 12),
+                   test_get_u32(evidence + 16),
+                   test_get_u32(evidence + 20),
+                   test_get_u64(evidence + 56),
+                   test_get_u64(evidence + 64), cursor_position,
+                   rr_switch_quantum,
+                   test_terminal_cursor_required ? "true" : "false");
+        test_fail("register evidence identity or scheduler framing is wrong");
+    }
+    before_len = test_get_u32(evidence + 44);
+    after_len = test_get_u32(evidence + 48);
+    mask_len = test_get_u32(evidence + 52);
+    value_len = test_get_u32(evidence + 152);
+    if (before_len == 0 || before_len != after_len || mask_len != 1 ||
+        value_len != 1 ||
+        (uint64_t)TEST_REGISTER_EVIDENCE_HEADER_BYTES + before_len +
+            after_len + mask_len + value_len != evidence_len) {
+        test_fail("register evidence lengths are not canonical");
+    }
+    before = evidence + TEST_REGISTER_EVIDENCE_HEADER_BYTES;
+    after = before + before_len;
+    mask = after + after_len;
+    value = mask + mask_len;
+    test_sha256(before, before_len, digest);
+    if (memcmp(digest, expected_before, 32) != 0) {
+        test_fail("register before hash does not match evidence");
+    }
+    test_sha256(after, after_len, digest);
+    if (memcmp(digest, expected_after, 32) != 0) {
+        test_fail("register after hash does not match evidence");
+    }
+    test_sha256(evidence, evidence_len, digest);
+    if (memcmp(digest, expected_evidence, 32) != 0) {
+        test_fail("register evidence hash does not match framing");
+    }
+    before_bit = test_mask_bit(before, test_first_bit);
+    after_bit = test_mask_bit(after, test_first_bit);
+    register_changed = memcmp(before, after, before_len) != 0;
+    fingerprint_changed = memcmp(evidence + 120, evidence + 88, 32) != 0;
+    if (mask[0] != 1 ||
+        (test_mode == TEST_MODE_IMPULSE &&
+         (value[0] != 0 || before_bit == after_bit)) ||
+        (test_mode == TEST_MODE_PERSISTENT &&
+         (value[0] != 1 || after_bit != 1)) ||
+        (require_change && before_bit == after_bit) ||
+        fingerprint_changed != register_changed) {
+        test_fail("register evidence does not prove the requested transform");
+    }
+    for (size_t index = 0; index < 32; index++) {
+        static const char hex[] = "0123456789abcdef";
+
+        test_execution_fingerprint[index * 2] =
+            hex[evidence[88 + index] >> 4];
+        test_execution_fingerprint[index * 2 + 1] =
+            hex[evidence[88 + index] & 0x0f];
+    }
+    test_execution_fingerprint[64] = '\0';
+    return before_bit != after_bit;
+}
+
+static void test_validate_node_result_evidence(
+    const uint8_t *evidence, size_t evidence_len,
+    const struct qemu_plugin_crucible_fault_result *result)
+{
+    uint16_t expected_operation = test_mode == TEST_MODE_PERSISTENT ?
+        CRUCIBLE_NODE_FAULT_OPERATION_UPSERT :
+        CRUCIBLE_NODE_FAULT_OPERATION_APPLY;
+    uint8_t digest[32];
+
+    if (evidence_len != CRUCIBLE_NODE_FAULT_EVIDENCE_V1_BYTES ||
+        memcmp(evidence + CRUCIBLE_NODE_FAULT_EVIDENCE_MAGIC_OFFSET,
+               "CRUCNEV1", 8) != 0 ||
+        test_get_u16(evidence +
+                     CRUCIBLE_NODE_FAULT_EVIDENCE_VERSION_OFFSET) != 1 ||
+        test_get_u16(evidence +
+                     CRUCIBLE_NODE_FAULT_EVIDENCE_COMMAND_KIND_OFFSET) !=
+            CRUCIBLE_FAULT_COMMAND_CPU_REGISTER_TRANSFORM ||
+        test_get_u16(evidence +
+                     CRUCIBLE_NODE_FAULT_EVIDENCE_OPERATION_OFFSET) !=
+            expected_operation ||
+        test_get_u16(evidence +
+                     CRUCIBLE_NODE_FAULT_EVIDENCE_TARGET_KIND_OFFSET) !=
+            CRUCIBLE_NODE_FAULT_TARGET_REGISTER ||
+        test_get_u16(evidence +
+                     CRUCIBLE_NODE_FAULT_EVIDENCE_MODEL_PHASE_OFFSET) !=
+            test_model_phase ||
+        test_get_u16(evidence +
+                     CRUCIBLE_NODE_FAULT_EVIDENCE_RESERVED_OFFSET) != 0 ||
+        test_get_u64(evidence +
+                     CRUCIBLE_NODE_FAULT_EVIDENCE_GENERATION_OFFSET) != 1 ||
+        test_get_u64(evidence +
+                     CRUCIBLE_NODE_FAULT_EVIDENCE_PRIOR_GENERATION_OFFSET) !=
+            0 ||
+        memcmp(evidence + CRUCIBLE_NODE_FAULT_EVIDENCE_ACTION_HASH_OFFSET,
+               test_action_hash, 32) != 0 ||
+        memcmp(evidence + CRUCIBLE_NODE_FAULT_EVIDENCE_TARGET_HASH_OFFSET,
+               test_target_hash, 32) != 0 ||
+        memcmp(evidence + CRUCIBLE_NODE_FAULT_EVIDENCE_SCHEMA_HASH_OFFSET,
+               test_payload + CRUCIBLE_NODE_FAULT_PAYLOAD_SCHEMA_HASH_OFFSET,
+               32) != 0 ||
+        memcmp(evidence + CRUCIBLE_NODE_FAULT_EVIDENCE_BEFORE_SHA256_OFFSET,
+               result->before_hash, 32) != 0 ||
+        memcmp(evidence + CRUCIBLE_NODE_FAULT_EVIDENCE_AFTER_SHA256_OFFSET,
+               result->after_hash, 32) != 0) {
+        test_fail("typed node result evidence is not canonical");
+    }
+    test_sha256(test_payload, test_payload_len, digest);
+    if (memcmp(evidence +
+               CRUCIBLE_NODE_FAULT_EVIDENCE_REQUEST_SHA256_OFFSET,
+               digest, 32) != 0) {
+        test_fail("typed node result does not bind the request payload");
+    }
+    test_sha256(evidence, evidence_len, digest);
+    if (memcmp(digest, result->evidence_hash, 32) != 0) {
+        test_fail("typed node result evidence hash does not match framing");
+    }
+}
+
+static void test_submit_commit(
+    const struct qemu_plugin_crucible_fault_result *prepared)
+{
+    uint64_t target_delta;
+    uint64_t base_tick;
+
+    if (prepared->status != CRUCIBLE_FAULT_STATUS_PREPARED ||
+        prepared->command_sequence != 1 || prepared->reserved != 0 ||
+        prepared->phase != test_command.phase ||
+        prepared->semantic_version !=
+            CRUCIBLE_FAULT_COMMAND_SEMANTIC_VERSION ||
+        prepared->capability_version != 1 ||
+        prepared->observed_icount != test_command.target_icount ||
+        prepared->applied_icount != 0 ||
+        memcmp(prepared->before_hash, prepared->after_hash, 32) != 0) {
+        test_fail("register prepare returned the wrong result");
+    }
+    test_command.command_flags = 0;
+    test_command.command_sequence = 2;
+    if (test_terminal_cursor_required) {
+        struct qemu_plugin_rr_cursor rr = { 0 };
+        uint64_t current_icount = qemu_plugin_icount_raw();
+        uint64_t current_position;
+        uint64_t remaining;
+
+        if (qemu_plugin_rr_cursor(&rr) != 0 ||
+            rr.rr_switch_quantum == 0 ||
+            rr.cursor_position >= rr.rr_switch_quantum ||
+            current_icount < prepared->observed_icount) {
+            test_fail("terminal-cursor test has no valid RR coordinate");
+        }
+        /*
+         * The prepare completion runs inside the exact after-instruction
+         * boundary. Its raw count includes that instruction while the exact
+         * cursor remains at the committed pre-instruction position. Advance
+         * that position once, then select the following terminal when the
+         * current boundary itself completed a quantum.
+         */
+        current_position = rr.cursor_position + 1;
+        if (current_position == rr.rr_switch_quantum) {
+            current_position = 0;
+        }
+        remaining = rr.rr_switch_quantum - current_position;
+        if (current_icount > UINT64_MAX - remaining) {
+            test_fail("terminal-cursor target overflows node icount");
+        }
+        test_command.target_icount = current_icount + remaining;
+        target_delta = remaining;
+        base_tick = qemu_plugin_sim_tick_observed();
+    } else {
+        test_command.target_icount = prepared->observed_icount + 16;
+        target_delta = 16;
+        base_tick = prepared->observed_tick;
+    }
+    if (base_tick > INT64_MAX || target_delta >
+        (INT64_MAX - base_tick) /
+            CRUCIBLE_SHMEM_TICKS_PER_INSTRUCTION) {
+        test_fail("register commit target tick is invalid");
+    }
+    test_command.authorization_ceiling_icount = test_command.target_icount;
+    test_command.target_tick = base_tick +
+        target_delta * CRUCIBLE_SHMEM_TICKS_PER_INSTRUCTION;
+    test_command.authorization_ceiling_tick = test_command.target_tick;
+    memcpy(test_command.expected_precondition_hash,
+           prepared->before_hash, 32);
+    if (test_mode == TEST_MODE_REJECT_PRECONDITION) {
+        test_initial_target_len = test_read_fault_register(
+            test_initial_target);
+        test_command.expected_precondition_hash[0] ^= 1;
+    }
+    if (qemu_plugin_crucible_fault_submit(
+            &test_command, test_payload, test_payload_len) != 0) {
+        test_fail("QEMU rejected the prepared register commit");
+    }
+    test_commit_submitted = true;
+    qemu_plugin_force_vcpu_exit();
+}
+
+static void test_poll_events(void)
+{
+    struct qemu_plugin_crucible_fault_event event;
+    uint8_t envelope[8192];
+    const uint8_t *evidence;
+    size_t envelope_len = 0;
+    size_t evidence_len = 0;
+    int status;
+
+    do {
+        memset(&event, 0, sizeof(event));
+        envelope_len = 0;
+        status = qemu_plugin_crucible_fault_event_poll(
+            &event, envelope, sizeof(envelope), &envelope_len);
+        if (status < 0) {
+            test_fail("register event polling failed");
+        }
+        if (status == 1 && test_mode_rejects()) {
+            test_fail("a rejected register command emitted an event");
+        }
+        if (status == 1 && event.command_kind ==
+                CRUCIBLE_FAULT_COMMAND_CPU_REGISTER_TRANSFORM) {
+            evidence = test_event_evidence(
+                &event, envelope, envelope_len, &evidence_len);
+            if (event.model_phase != test_model_phase ||
+                event.outcome != CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED ||
+                event.target_kind != CRUCIBLE_NODE_FAULT_TARGET_REGISTER ||
+                event.evidence_length != evidence_len ||
+                event.event_sequence == 0 ||
+                event.rule_command_sequence != 2 ||
+                event.observed_icount == 0 || event.generation != 1 ||
+                memcmp(event.binding_hash, test_command.binding_hash, 32) != 0 ||
+                memcmp(event.action_hash, test_action_hash, 32) != 0 ||
+                memcmp(event.target_hash, test_target_hash, 32) != 0) {
+                g_printerr("register event debug phase=%u expected_phase=%u "
+                           "outcome=%u target=%u evidence=%u sequence=%" G_GUINT64_FORMAT
+                           " rule_sequence=%" G_GUINT64_FORMAT
+                           " icount=%" G_GUINT64_FORMAT
+                           " generation=%" G_GUINT64_FORMAT
+                           " expected_generation=%" G_GUINT64_FORMAT "\n",
+                           event.model_phase, test_model_phase, event.outcome,
+                           event.target_kind, event.evidence_length,
+                           event.event_sequence, event.rule_command_sequence,
+                           event.observed_icount, event.generation,
+                           UINT64_C(1));
+                test_fail("register event identity is wrong");
+            }
+            bool changed = test_validate_register_evidence(
+                evidence, evidence_len, test_mode == TEST_MODE_IMPULSE,
+                event.observed_icount, event.observed_tick,
+                event.before_hash, event.after_hash,
+                event.opportunity_hash);
+            if (test_result_validated && changed &&
+                (test_mode == TEST_MODE_IMPULSE || test_rule_installed)) {
+                test_validated = true;
+            }
+        }
+    } while (status == 1);
+}
+
+static void test_finish_if_validated(void)
+{
+    const char *mode = test_mode_name();
+    uint8_t cr0[64];
+
+    if (!test_validated ||
+        (test_guest_observation_required && !test_guest_observed) ||
+        test_finished) {
+        return;
+    }
+    if (test_architecture == QEMU_PLUGIN_CRUCIBLE_FAULT_SCOPE_X86_64 &&
+        (test_cr0_numeric_id == 0 ||
+         test_read_fault_register_id(test_cr0_numeric_id, cr0) != 8 ||
+         !test_mask_bit(cr0, 31) || !test_mask_bit(cr0, 16))) {
+        test_fail("x86 register case did not reach the paging guest");
+    }
+    test_finished = true;
+    g_printerr("CRUCIBLE_REGISTER_MUTATION_LIVE_PASS architecture=%u mode=%s register=%s register_id=%u group=%u phase=%s fingerprint=%s guest_observed=%s terminal_cursor=%s\n",
+               test_architecture, mode, test_register_name, test_numeric_id,
+               test_group,
+               test_model_phase == TEST_MODEL_PHASE_BEFORE_INSTRUCTION ?
+               "before" : "after",
+               test_execution_fingerprint,
+               test_guest_observed ? "true" : "false",
+               test_terminal_cursor_required ? "true" : "false");
+    qemu_plugin_request_shutdown(0);
+}
+
+static void test_tb_exec(unsigned int cpu_index, void *opaque)
+{
+    (void)cpu_index;
+    (void)opaque;
+    if (test_mode_rejects() &&
+        !test_initial_command_submitted) {
+        uint8_t cr0[64];
+        uint64_t current_icount;
+        int64_t current_tick;
+
+        if (test_cr0_numeric_id == 0 ||
+            test_read_fault_register_id(test_cr0_numeric_id, cr0) != 8) {
+            test_fail("CR0 observation is unavailable");
+        }
+        if (!test_mask_bit(cr0, 31) || !test_mask_bit(cr0, 16)) {
+            return;
+        }
+        current_icount = qemu_plugin_icount_raw();
+        if (current_icount == 0 || current_icount > UINT64_MAX - 16) {
+            test_fail("stable rejection target cannot be scheduled");
+        }
+        test_command.target_icount = current_icount + 16;
+        test_command.authorization_ceiling_icount = test_command.target_icount;
+        current_tick = qemu_plugin_sim_tick_observed();
+        if (current_tick < 0 || current_tick > INT64_MAX -
+                16 * CRUCIBLE_SHMEM_TICKS_PER_INSTRUCTION) {
+            test_fail("stable rejection target tick is invalid");
+        }
+        test_command.target_tick = current_tick +
+            16 * CRUCIBLE_SHMEM_TICKS_PER_INSTRUCTION;
+        test_command.authorization_ceiling_tick = test_command.target_tick;
+        if (test_mode != TEST_MODE_REJECT_PRECONDITION) {
+            test_initial_target_len = test_read_fault_register(
+                test_initial_target);
+        }
+        if (test_mode ==
+                TEST_MODE_REJECT_MISMATCHED_REGISTER_IDENTITY) {
+            /* A synchronous rejection may invoke completion reentrantly. */
+            test_submit_atomic_verified = true;
+        }
+        if (qemu_plugin_crucible_fault_submit(
+                &test_command, test_payload, test_payload_len) != 0) {
+            test_fail("QEMU rejected the stable-state preparation");
+        }
+        test_initial_command_submitted = true;
+        qemu_plugin_force_vcpu_exit();
+        return;
+    }
+    if (test_mode == TEST_MODE_PERSISTENT && test_rule_installed) {
+        g_autoptr(GByteArray) observed = g_byte_array_new();
+
+        test_poll_events();
+        if (test_guest_observation_required &&
+            qemu_plugin_read_memory_vaddr(
+                test_result_address, observed, 1) &&
+            observed->len == 1 && observed->data[0] == 1) {
+            test_guest_observed = true;
+        }
+        test_finish_if_validated();
+    }
+}
+
+static void test_tb_trans(struct qemu_plugin_tb *tb, void *opaque)
+{
+    (void)opaque;
+    qemu_plugin_register_vcpu_tb_exec_cb(
+        tb, test_tb_exec, QEMU_PLUGIN_CB_NO_REGS, NULL);
+}
+
+static void test_completion(void *opaque)
+{
+    struct qemu_plugin_crucible_fault_result result;
+    uint8_t evidence[8192];
+    size_t evidence_len = 0;
+    int status;
+
+    (void)opaque;
+    do {
+        memset(&result, 0, sizeof(result));
+        evidence_len = 0;
+        status = qemu_plugin_crucible_fault_poll(
+            &result, evidence, sizeof(evidence), &evidence_len);
+        if (status < 0) {
+            test_fail("register result polling failed");
+        }
+        if (status != 1 || result.command_kind !=
+                CRUCIBLE_FAULT_COMMAND_CPU_REGISTER_TRANSFORM) {
+            continue;
+        }
+        if (test_mode_rejects() &&
+            result.command_sequence ==
+                (test_mode == TEST_MODE_REJECT_PRECONDITION ? 2 : 1)) {
+            uint8_t current[64];
+            size_t current_len = 0;
+            bool delayed = test_mode !=
+                TEST_MODE_REJECT_MISMATCHED_REGISTER_IDENTITY;
+            uint16_t expected_status =
+                test_mode == TEST_MODE_REJECT_PRECONDITION ?
+                 CRUCIBLE_FAULT_STATUS_PRECONDITION_MISMATCH :
+                (test_mode ==
+                     TEST_MODE_REJECT_MISMATCHED_REGISTER_IDENTITY ?
+                 CRUCIBLE_FAULT_STATUS_MALFORMED_COMMAND :
+                 CRUCIBLE_FAULT_STATUS_INVALID_TARGET);
+
+            current_len = test_read_fault_register(current);
+            if (result.status != expected_status ||
+                result.applied_icount != 0 || evidence_len != 0 ||
+                (delayed &&
+                 (result.reserved != 0 ||
+                  result.phase != test_command.phase ||
+                  result.semantic_version !=
+                      CRUCIBLE_FAULT_COMMAND_SEMANTIC_VERSION ||
+                  result.capability_version != 1 ||
+                  result.observed_icount != test_command.target_icount)) ||
+                !test_rejection_target_unchanged(current, current_len) ||
+                (delayed &&
+                 (!test_bytes_nonzero(result.before_hash, 32) ||
+                  memcmp(result.before_hash, result.after_hash, 32) != 0)) ||
+                (!delayed &&
+                 !test_submit_atomic_verified)) {
+                g_printerr("rejection debug mode=%s status=%u expected=%u "
+                           "applied=%" G_GUINT64_FORMAT
+                           " evidence=%zu before-bytes=%zu after-bytes=%zu "
+                           "submit-atomic=%s\n",
+                           test_mode_name(), result.status, expected_status,
+                           result.applied_icount, evidence_len,
+                           test_initial_target_len, current_len,
+                           test_submit_atomic_verified ? "true" : "false");
+                test_fail("register rejection was not exact and atomic");
+            }
+            test_poll_events();
+            test_validated = true;
+            test_finish_if_validated();
+            continue;
+        }
+        if (result.command_sequence == 1) {
+            if (test_commit_submitted) {
+                test_fail("register prepare completed more than once");
+            }
+            test_submit_commit(&result);
+        } else if (result.command_sequence == 2) {
+            if (result.status != CRUCIBLE_FAULT_STATUS_APPLIED ||
+                result.reserved != 0 || result.phase != test_command.phase ||
+                result.semantic_version !=
+                    CRUCIBLE_FAULT_COMMAND_SEMANTIC_VERSION ||
+                result.capability_version != 1 ||
+                result.observed_icount != test_command.target_icount ||
+                result.applied_icount != result.observed_icount) {
+                test_fail("register commit was not applied");
+            }
+            test_validate_node_result_evidence(
+                evidence, evidence_len, &result);
+            test_result_validated = true;
+            if (test_mode == TEST_MODE_PERSISTENT) {
+                test_rule_installed = true;
+            }
+        } else {
+            test_fail("register result sequence is unknown");
+        }
+    } while (status == 1);
+    test_poll_events();
+    test_finish_if_validated();
+}
+
+static void test_exit(void *opaque)
+{
+    (void)opaque;
+    if (!test_validated) {
+        test_fail("register mutation was not validated before process exit");
+    }
+    g_free(test_payload);
+}
