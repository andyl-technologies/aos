+static int purpose_plan_header(const uint8_t *header, uint64_t length,
+                               QemuCrucibleProcessPurposePlan *out)
+{
+    QemuCrucibleProcessPurposePlan decoded = { 0 };
+    uint64_t offset;
+    uint32_t header_bytes = QEMU_CRUCIBLE_PROCESS_PURPOSE_PLAN_HEADER_BYTES;
+    bool subscription = !memcmp(header, QEMU_CRUCIBLE_PROCESS_PURPOSE_PLAN9_MAGIC, 8);
+
+    if (subscription) {
+        header_bytes = QEMU_CRUCIBLE_PROCESS_PURPOSE_PLAN9_HEADER_BYTES;
+    }
+    if (length < header_bytes ||
+        length > QEMU_CRUCIBLE_PROCESS_PURPOSE_PLAN_TOTAL_MAX) {
+        return -EINVAL;
+    }
+    if ((!subscription &&
+         memcmp(header, QEMU_CRUCIBLE_PROCESS_PURPOSE_PLAN_MAGIC, 8)) ||
+        ldl_be_p(header + 8) != (subscription ? 9 : 8)) {
+        return -EPROTONOSUPPORT;
+    }
+    if (ldl_be_p(header + 12) != header_bytes ||
+        ldl_be_p(header + 16) != length) {
+        return -EINVAL;
+    }
+    decoded.schema = subscription ? 9 : 8;
+    if (subscription &&
+        (ldl_be_p(header + 40) != QEMU_CRUCIBLE_PUBLISHER_PURPOSE_BYTES ||
+         ldl_be_p(header + 44))) {
+        return -EINVAL;
+    }
+    decoded.subscription_bytes = subscription ?
+        QEMU_CRUCIBLE_PUBLISHER_PURPOSE_BYTES : 0;
+    decoded.total_bytes = ldl_be_p(header + 16);
+    decoded.app_bytes = ldl_be_p(header + 20);
+    decoded.selectable_bytes = ldl_be_p(header + 24);
+    decoded.workspace_bytes = ldl_be_p(header + 28);
+    if (decoded.app_bytes > QEMU_CRUCIBLE_PROCESS_PURPOSE_PLAN_APP_MAX ||
+        decoded.selectable_bytes >
+            QEMU_CRUCIBLE_PROCESS_PURPOSE_PLAN_SELECTABLE_MAX ||
+        (decoded.workspace_bytes != 0 && decoded.workspace_bytes != 128) ||
+        ldl_be_p(header + 32) != 128 ||
+        ldl_be_p(header + 36) != QEMU_CRUCIBLE_PROCESS_PURPOSE_BYTES) {
+        return -EINVAL;
+    }
+    /* Widen before all additions. The checked independent caps bound every
+     * offset below UINT32_MAX before assignment; the final exact equation
+     * still has to fit the unchanged aggregate cap.
+     */
+    offset = header_bytes;
+    decoded.app_offset = offset;
+    if (!purpose_add(&offset, decoded.app_bytes)) {
+        return -EOVERFLOW;
+    }
+    decoded.selectable_offset = offset;
+    if (!purpose_add(&offset, decoded.selectable_bytes)) {
+        return -EOVERFLOW;
+    }
+    decoded.workspace_offset = offset;
+    if (!purpose_add(&offset, decoded.workspace_bytes)) {
+        return -EOVERFLOW;
+    }
+    decoded.startup_offset = offset;
+    if (!purpose_add(&offset, 128)) {
+        return -EOVERFLOW;
+    }
+    decoded.purpose_offset = offset;
+    if (!purpose_add(&offset, QEMU_CRUCIBLE_PROCESS_PURPOSE_BYTES)) {
+        return -EOVERFLOW;
+    }
+    decoded.subscription_offset = offset;
+    if (!purpose_add(&offset, decoded.subscription_bytes)) {
+        return -EOVERFLOW;
+    }
+    if (offset != length) {
+        return -EINVAL;
+    }
+    *out = decoded;
+    return 0;
+}
+
+#ifdef CONFIG_LINUX
+static int purpose_pread(int fd, uint8_t *buffer, size_t length, uint32_t offset)
+{
+    size_t completed = 0;
+
+    while (completed < length) {
+        uint64_t position = (uint64_t)offset + completed;
+        off_t file_offset = position;
+        ssize_t received;
+
+        if (file_offset < 0 || (uint64_t)file_offset != position) {
+            return -EOVERFLOW;
+        }
+        received = pread(fd, buffer + completed, length - completed, file_offset);
+        if (received < 0) {
+            return -errno;
+        }
+        if (!received || (size_t)received > length - completed) {
+            return -EIO;
+        }
+        completed += received;
+    }
+    return 0;
+}
+#endif
+
+int qemu_crucible_process_purpose_plan_read_fd_v3(
+    int fd, QemuCrucibleProcessPurposePlan *out)
+{
+#ifdef CONFIG_LINUX
+    const int required = F_SEAL_WRITE | F_SEAL_SHRINK | F_SEAL_GROW | F_SEAL_SEAL;
+    QemuCrucibleProcessPurposePlan decoded;
+    uint8_t header[QEMU_CRUCIBLE_PROCESS_PURPOSE_PLAN9_HEADER_BYTES];
+    uint8_t scratch[QEMU_CRUCIBLE_PROCESS_PURPOSE_BYTES];
+    struct stat before;
+    struct stat after;
+    int seals;
+    int final_seals;
+    int status;
+
+    if (fd < 0 || !out) {
+        return -EINVAL;
+    }
+    if (fstat(fd, &before) < 0) {
+        return -errno;
+    }
+    if (!S_ISREG(before.st_mode) ||
+        before.st_size < QEMU_CRUCIBLE_PROCESS_PURPOSE_PLAN_HEADER_BYTES ||
+        (uint64_t)before.st_size > QEMU_CRUCIBLE_PROCESS_PURPOSE_PLAN_TOTAL_MAX) {
+        return -EINVAL;
+    }
+    seals = fcntl(fd, F_GET_SEALS);
+    if (seals < 0) {
+        return -errno;
+    }
+    if ((seals & required) != required) {
+        return -EPERM;
+    }
+    status = purpose_pread(fd, header,
+                           QEMU_CRUCIBLE_PROCESS_PURPOSE_PLAN_HEADER_BYTES, 0);
+    if (!status && !memcmp(header, QEMU_CRUCIBLE_PROCESS_PURPOSE_PLAN9_MAGIC, 8)) {
+        status = purpose_pread(fd, header + 40, 8, 40);
+    }
+    if (status) {
+        return status;
+    }
+    status = purpose_plan_header(header, before.st_size, &decoded);
+    if (status) {
+        return status;
+    }
+    if (decoded.workspace_bytes) {
+        status = purpose_pread(fd, scratch, 128, decoded.workspace_offset);
+        if (!status) {
+            status = qemu_crucible_process_workspace_purpose_decode_v2(
+                scratch, 128, &decoded.workspace);
+        }
+        if (status) {
+            return status;
+        }
+    }
+    status = purpose_pread(fd, scratch, 128, decoded.startup_offset);
+    if (!status) {
+        status = qemu_crucible_original_startup_decode(
+            scratch, 128, &decoded.startup);
+    }
+    if (status) {
+        return status;
+    }
+    status = purpose_pread(fd, scratch, sizeof(scratch), decoded.purpose_offset);
+    if (!status) {
+        status = qemu_crucible_process_purpose_decode_v8(
+            scratch, sizeof(scratch), &decoded.purpose);
+    }
+    if (status) {
+        return status;
+    }
+    if (decoded.startup.original_total_bytes != decoded.purpose.original_total ||
+        decoded.startup.process_generation != decoded.purpose.process_generation ||
+        memcmp(decoded.startup.cap_id, decoded.purpose.containing_capability, 32) ||
+        (decoded.workspace_bytes &&
+         (decoded.workspace.original_total != decoded.purpose.original_total ||
+          decoded.workspace.process_generation != decoded.purpose.process_generation ||
+          decoded.workspace.account_generation != decoded.purpose.account_generation ||
+          decoded.workspace.host_owner_extent > decoded.purpose.assigned_outside ||
+          memcmp(decoded.workspace.containing_capability,
+                 decoded.purpose.containing_capability, 32)))) {
+        return -ESTALE;
+    }
+    if (decoded.subscription_bytes) {
+        status = purpose_pread(fd, scratch, decoded.subscription_bytes,
+                               decoded.subscription_offset);
+        if (!status) {
+            status = qemu_crucible_publisher_purpose_decode_v1(
+                scratch, decoded.subscription_bytes, &decoded.subscription);
+        }
+        if (status) {
+            return status;
+        }
+        if (decoded.subscription.account_generation != decoded.purpose.account_generation ||
+            decoded.subscription.process_generation != decoded.purpose.process_generation ||
+            memcmp(decoded.subscription.capability,
+                   decoded.purpose.containing_capability, 32) ||
+            memcmp(decoded.subscription.reservation,
+                   decoded.purpose.family.source.assignment_id, 32)) {
+            return -ESTALE;
+        }
+    }
+    if (fstat(fd, &after) < 0) {
+        return -errno;
+    }
+    final_seals = fcntl(fd, F_GET_SEALS);
+    if (final_seals < 0) {
+        return -errno;
+    }
+    if (before.st_dev != after.st_dev || before.st_ino != after.st_ino ||
+        before.st_size != after.st_size || before.st_mode != after.st_mode ||
+        seals != final_seals) {
+        return -ESTALE;
+    }
+    *out = decoded;
+    return 0;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+/* These proposed protocol codecs never read live shared memory or authenticate
+ * a lender. The real paired producer and receiver capability remain absent. */
+static int publisher_decode_buffers(const uint8_t *wire, size_t bytes,
+    size_t required, const void *out, size_t output_bytes, size_t alignment)
+{
+    uintptr_t input = (uintptr_t)wire;
+    uintptr_t output = (uintptr_t)out;
+
+    if (!wire || !out || output % alignment) {
+        return -EINVAL;
+    }
+    if (bytes != required) {
+        return -EMSGSIZE;
+    }
+    if (bytes > UINTPTR_MAX - input || output_bytes > UINTPTR_MAX - output) {
+        return -EOVERFLOW;
+    }
+    if (input < output + output_bytes && output < input + bytes) {
+        return -EINVAL;
+    }
+    return 0;
+}
+
+static bool publisher_generation(uint64_t generation)
+{
+    return generation && generation != UINT64_MAX;
+}
+
+static bool publisher_sequence(uint64_t sequence)
+{
+    return publisher_generation(sequence) && !(sequence & 1);
+}
+
+int qemu_crucible_publisher_header_decode_v1(
+    const uint8_t *wire, size_t bytes, QemuCruciblePublisherHeaderView *out)
+{
+    QemuCruciblePublisherHeaderView view = { 0 };
+    int status = publisher_decode_buffers(wire, bytes,
+        QEMU_CRUCIBLE_PUBLISHER_HEADER_BYTES, out, sizeof(*out), _Alignof(*out));
+
+    if (status) {
+        return status;
+    }
+    if (memcmp(wire, "CRUCPLM1", 8) || ldl_be_p(wire + 8) != 1 ||
+        ldl_be_p(wire + 12) != QEMU_CRUCIBLE_PUBLISHER_REGION_BYTES) {
+        return -EPROTONOSUPPORT;
+    }
+    view.lender_generation = ldq_be_p(wire + 16);
+    view.account_generation = ldq_be_p(wire + 32);
+    view.process_generation = ldq_be_p(wire + 40);
+    memcpy(view.source_capability, wire + 48, 32);
+    memcpy(view.source_reservation, wire + 80, 32);
+    view.node_index = ldl_be_p(wire + 112);
+    view.node_count = ldl_be_p(wire + 116);
+
+    if (!publisher_generation(view.lender_generation) ||
+        !publisher_generation(view.account_generation) ||
+        !publisher_generation(view.process_generation) || ldq_be_p(wire + 24) ||
+        !purpose_nonzero(view.source_capability, 32) ||
+        !purpose_nonzero(view.source_reservation, 32) ||
+        !view.node_count || view.node_count > 32 ||
+        view.node_index >= view.node_count ||
+        ldl_be_p(wire + 120) != QEMU_CRUCIBLE_PUBLISHER_PUBLICATION_OFFSET ||
+        ldl_be_p(wire + 124) != QEMU_CRUCIBLE_PUBLISHER_PUBLICATION_BYTES ||
+        ldl_be_p(wire + 128) != QEMU_CRUCIBLE_PUBLISHER_RECEIVER_OFFSET ||
+        ldl_be_p(wire + 132) != QEMU_CRUCIBLE_PUBLISHER_RECEIVER_BYTES ||
+        ldl_be_p(wire + 136) != QEMU_CRUCIBLE_PUBLISHER_TERMINAL_OFFSET ||
+        ldl_be_p(wire + 140) != QEMU_CRUCIBLE_PUBLISHER_TERMINAL_BYTES ||
+        purpose_nonzero(wire + 144, bytes - 144)) {
+        return -EPROTO;
+    }
+    *out = view;
+    return 0;
+}
+
+static int publisher_command_decode(const uint8_t *wire,
+                                    QemuCruciblePublisherCommandView *out)
+{
+    QemuCruciblePublisherCommandView view = { 0 };
+
+    if (memcmp(wire, "CRUCQCM1", 8) || ldl_be_p(wire + 8) != 1 ||
+        ldl_be_p(wire + 12) != QEMU_CRUCIBLE_PUBLISHER_COMMAND_BYTES) {
+        return -EPROTONOSUPPORT;
+    }
+    view.scheduler_generation = ldq_be_p(wire + 16);
+    view.initial_raw_icount = ldq_be_p(wire + 24);
+    view.max_advance_raw_icount = ldq_be_p(wire + 32);
+    view.logical_tick_ceiling = ldq_be_p(wire + 40);
+    view.native_ceiling_ns = ldq_be_p(wire + 48);
+    view.stop_mode = ldl_be_p(wire + 56);
+    view.command_frontier = ldq_be_p(wire + 64);
+    view.next_idle_generation = ldq_be_p(wire + 72);
+
+    if (!publisher_sequence(view.scheduler_generation) ||
+        view.max_advance_raw_icount < view.initial_raw_icount ||
+        (view.stop_mode != 1 && view.stop_mode != 2) || ldl_be_p(wire + 60) ||
+        (view.stop_mode == 1 && view.next_idle_generation) ||
+        (view.stop_mode == 2 && !publisher_generation(view.next_idle_generation)) ||
+        purpose_nonzero(wire + 80, QEMU_CRUCIBLE_PUBLISHER_COMMAND_BYTES - 80)) {
+        return -EPROTO;
+    }
+    *out = view;
+    return 0;
+}
+
+int qemu_crucible_publisher_publication_decode_v1(
+    const uint8_t *wire, size_t bytes, QemuCruciblePublisherPublicationView *out)
+{
+    QemuCruciblePublisherPublicationView view = { 0 };
+    uint64_t phase;
+    uint64_t command;
+    int status = publisher_decode_buffers(wire, bytes,
+        QEMU_CRUCIBLE_PUBLISHER_PUBLICATION_BYTES, out, sizeof(*out), _Alignof(*out));
+
+    if (status) {
+        return status;
+    }
+    view.sequence = ldq_be_p(wire);
+    view.loan_generation = ldq_be_p(wire + 8);
+    view.ticket_serial = ldq_be_p(wire + 16);
+    phase = ldq_be_p(wire + 24);
+    view.standing_sequence = ldq_be_p(wire + 32);
+    command = ldq_be_p(wire + 40);
+    if (!publisher_sequence(view.sequence) ||
+        !publisher_generation(view.loan_generation) || !view.ticket_serial ||
+        view.ticket_serial > QEMU_CRUCIBLE_PUBLISHER_TICKET_SERIAL_MAX ||
+        phase < 1 || phase > 3 || !publisher_sequence(view.standing_sequence) ||
+        command > 1 ||
+        ldl_be_p(wire + 48) != QEMU_CRUCIBLE_PUBLISHER_COHORT_OFFSET ||
+        ldl_be_p(wire + 52) != QEMU_CRUCIBLE_ACTION_BYTES ||
+        ldl_be_p(wire + 56) != QEMU_CRUCIBLE_PUBLISHER_COMMAND_OFFSET ||
+        ldl_be_p(wire + 60) != (command ? QEMU_CRUCIBLE_PUBLISHER_COMMAND_BYTES : 0) ||
+        purpose_nonzero(wire + 64, 64) || purpose_nonzero(wire + 1152, bytes - 1152)) {
+        return -EPROTO;
+    }
+    status = qemu_crucible_boundary_action_decode_v2(
+        wire + QEMU_CRUCIBLE_PUBLISHER_COHORT_OFFSET,
+        QEMU_CRUCIBLE_ACTION_BYTES, &view.cohort);
+    if (status) {
+        return status;
+    }
+    if (!view.cohort.present ||
+        view.cohort.binding.publisher_birth_sequence > view.standing_sequence) {
+        return -EPROTO;
+    }
+    view.permission_phase = phase;
+    view.command_present = command;
+    if (view.command_present) {
+        status = publisher_command_decode(
+            wire + QEMU_CRUCIBLE_PUBLISHER_COMMAND_OFFSET, &view.command);
+        if (status) {
+            return status;
+        }
+        if (view.cohort.primary_count != 1 ||
+            view.cohort.rows[0].producing_class != 1 ||
+            view.command.command_frontier != view.cohort.binding.command_frontier) {
+            return -EPROTO;
+        }
+    } else if (view.cohort.rows[0].producing_class == 1 ||
+        purpose_nonzero(wire + QEMU_CRUCIBLE_PUBLISHER_COMMAND_OFFSET,
+                        QEMU_CRUCIBLE_PUBLISHER_COMMAND_BYTES)) {
+        return -EPROTO;
+    }
+    *out = view;
+    return 0;
+}
+
+int qemu_crucible_publisher_return_decode_v1(
+    const uint8_t *wire, size_t bytes, QemuCruciblePublisherReturnView *out)
+{
+    QemuCruciblePublisherReturnView view = { 0 };
+    int status = publisher_decode_buffers(wire, bytes,
+        QEMU_CRUCIBLE_PUBLISHER_RETURN_BYTES, out, sizeof(*out), _Alignof(*out));
+
+    if (status) {
+        return status;
+    }
+    view.sequence = ldq_be_p(wire);
+    view.ticket_serial = ldq_be_p(wire + 8);
+    view.loan_generation = ldq_be_p(wire + 16);
+    view.command_sequence = ldq_be_p(wire + 24);
+    view.local_serial = ldq_be_p(wire + 32);
+    view.first_status = (int32_t)ldl_be_p(wire + 40);
+    view.post_status = (int32_t)ldl_be_p(wire + 44);
+    view.returned_view_mask = ldl_be_p(wire + 48);
+    view.physical_child_mask = ldl_be_p(wire + 52);
+    view.outcome = ldl_be_p(wire + 56);
+    view.completed_units = ldl_be_p(wire + 60);
+    view.final_raw_icount = ldq_be_p(wire + 64);
+    view.next_idle_generation = ldq_be_p(wire + 72);
+    view.work_unit_serial = ldq_be_p(wire + 80);
+
+    if (!publisher_sequence(view.sequence) || !view.ticket_serial ||
+        view.ticket_serial > QEMU_CRUCIBLE_PUBLISHER_TICKET_SERIAL_MAX ||
+        !publisher_generation(view.loan_generation) ||
+        !publisher_sequence(view.command_sequence) ||
+        !publisher_generation(view.local_serial) ||
+        view.first_status > 0 || view.post_status > 0 ||
+        (view.returned_view_mask & ~UINT32_C(15)) ||
+        (view.physical_child_mask & ~QEMU_CRUCIBLE_PUBLISHER_PHYSICAL_BITS) ||
+        view.outcome > 2 || view.completed_units > 1 ||
+        (!!view.outcome != !!view.completed_units) ||
+        (!!view.completed_units != !!view.work_unit_serial) ||
+        (view.work_unit_serial && !publisher_generation(view.work_unit_serial)) ||
+        (view.outcome != 2 && view.next_idle_generation) ||
+        (view.outcome == 2 && !publisher_generation(view.next_idle_generation)) ||
+        purpose_nonzero(wire + 88, bytes - 88)) {
+        return -EPROTO;
+    }
+    *out = view;
+    return 0;
+}
+
+int qemu_crucible_publisher_terminal_decode_v1(
+    const uint8_t *wire, size_t bytes, QemuCruciblePublisherTerminalView *out)
+{
+    QemuCruciblePublisherTerminalView view = { 0 };
+    int status = publisher_decode_buffers(wire, bytes,
+        QEMU_CRUCIBLE_PUBLISHER_TERMINAL_BYTES, out, sizeof(*out), _Alignof(*out));
+
+    if (status) {
+        return status;
+    }
+    view.sequence = ldq_be_p(wire);
+    view.ticket_serial = ldq_be_p(wire + 8);
+    view.loan_generation = ldq_be_p(wire + 16);
+    view.command_sequence = ldq_be_p(wire + 24);
+    view.return_sequence = ldq_be_p(wire + 32);
+    view.first_status = (int32_t)ldl_be_p(wire + 40);
+    view.post_status = (int32_t)ldl_be_p(wire + 44);
+    view.consumed_mask = ldl_be_p(wire + 48);
+    view.born_mask = ldl_be_p(wire + 52);
+    view.command_consumption_generation = ldq_be_p(wire + 56);
+    if (!publisher_sequence(view.sequence) || !view.ticket_serial ||
+        view.ticket_serial > QEMU_CRUCIBLE_PUBLISHER_TICKET_SERIAL_MAX ||
+        !publisher_generation(view.loan_generation) ||
+        !publisher_sequence(view.command_sequence) ||
+        !publisher_sequence(view.return_sequence) ||
+        view.first_status > 0 || view.post_status > 0 ||
+        !view.born_mask || (view.born_mask & ~UINT32_C(15)) ||
+        (view.consumed_mask & ~view.born_mask) ||
+        view.command_consumption_generation == UINT64_MAX ||
+        purpose_nonzero(wire + 64, bytes - 64)) {
+        return -EPROTO;
+    }
+    *out = view;
+    return 0;
+}
diff --git a/plugins/crucible-publisher-service.inc.h b/plugins/crucible-publisher-service.inc.h
new file mode 100644
index 0000000000000000000000000000000000000000..12ca622782005458901a297cdd1d40e5d96a5a0a
--- /dev/null
+++ b/plugins/crucible-publisher-service.inc.h
@@ -0,0 +1,427 @@
+/*
+ * Retained transfer and physical return of the actual Setup6 service child.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifdef CONFIG_LINUX
+/* Geometry corroborates the nominal owner selected by the caller below; this
+ * leaf cannot authenticate or pay a Runtime from an address and extent. */
+static bool publisher_service_runtime_span(uintptr_t base, uint64_t extent,
+                                           const void *field)
+{
+    uintptr_t address = (uintptr_t)field;
+
+    return base && extent >= sizeof(QemuCruciblePublisherModuleService *) &&
+        extent <= UINTPTR_MAX - base && address >= base &&
+        address % _Alignof(QemuCruciblePublisherModuleService *) == 0 &&
+        address - base <= extent - sizeof(QemuCruciblePublisherModuleService *);
+}
+
+static int publisher_service_runtime_identity_locked(
+    QemuCruciblePublisherModuleService *service)
+{
+    QemuCrucibleCallbackChildOwner *owner = &startup_source.callbacks.owner;
+    int status;
+
+    if (service != &startup_source.publisher_module || !service->held ||
+        !service->transferred || service->creation_owner ||
+        service->runtime_owner != owner || owner->publisher_service != service ||
+        owner->service_users != 1 || service->holder != service->runtime_holder) {
+        return -ESTALE;
+    }
+    status = callback_child_owner_identity_locked(owner);
+    if (status) {
+        return status;
+    }
+    if (service->runtime_base != owner->runtime_base ||
+        service->runtime_extent != owner->runtime_extent ||
+        !publisher_service_runtime_span(owner->runtime_base, owner->runtime_extent,
+                                        service->runtime_holder)) {
+        return -ESTALE;
+    }
+    return *service->runtime_holder == service ? 0 : -ESTALE;
+}
+#endif
+
+static int publisher_service_runtime_identity(
+    QemuCruciblePublisherModuleService *service)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    int status = command_registry_identity(startup_source.saved.plugin_id);
+
+    if (status) {
+        return status;
+    }
+    qemu_mutex_lock(&commands->mutex);
+    status = publisher_service_runtime_identity_locked(service);
+    qemu_mutex_unlock(&commands->mutex);
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_startup_setup_transfer_v4(
+    qemu_plugin_id_t id, QemuCrucibleCallbackChildOwner *owner,
+    QemuCruciblePublisherModuleService **runtime_field)
+{
+#ifdef CONFIG_LINUX
+    QemuCruciblePublisherModuleService *service = &startup_source.publisher_module;
+    QemuCrucibleSourceControlBinding *component = &startup_source.control_callback;
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    int first = startup_setup_service_identity(id);
+    int post;
+    int identity;
+
+    if (first || !startup_invocation(id) || startup_source.install_returned ||
+        owner != &startup_source.callbacks.owner) {
+        return first ? first : -EPERM;
+    }
+    if (service->transferred || service->transition_active || service->closing ||
+        service->first_status || service->post_status) {
+        return -ESTALE;
+    }
+    first = startup_runtime_admission(id, &startup_source.runtime_purpose);
+    if (!first) {
+        /* Actual Native registration is observed outside the Source mutex. */
+        first = qemu_plugin_crucible_control_component_current_v1(
+            component->holder, component, component->callback, component->userdata);
+    }
+    if (first) {
+        return first;
+    }
+    qemu_mutex_lock(&commands->mutex);
+    first = callback_registration_owner_live_locked(owner);
+    if (!first && (owner->service_users || owner->publisher_service ||
+                   service->transferred || service->transition_active ||
+                   service->holder != &service->creation_owner ||
+                   service->creation_owner != service ||
+                   component->child_owner != owner || !component->holder ||
+                   *component->holder != component || component->first_status)) {
+        first = -EBUSY;
+    }
+    if (!first && (!publisher_service_runtime_span(owner->runtime_base,
+                                                   owner->runtime_extent, runtime_field) ||
+                   callback_child_output_conflicts_locked(runtime_field,
+                                                         sizeof(*runtime_field)) ||
+                   *runtime_field)) {
+        first = -EINVAL;
+    }
+    if (first) {
+        qemu_mutex_unlock(&commands->mutex);
+        return first;
+    }
+    /* Retain the exact reverse parent before publishing the durable move.
+     * A failed independent post leaves that same field and debt in place. */
+    owner->publisher_service = service;
+    owner->service_users++;
+    service->runtime_owner = owner;
+    service->runtime_holder = runtime_field;
+    service->runtime_base = owner->runtime_base;
+    service->runtime_extent = owner->runtime_extent;
+    service->transition_active = true;
+    *runtime_field = service;
+    service->holder = runtime_field;
+    service->creation_owner = NULL;
+    service->transferred = true;
+    qemu_mutex_unlock(&commands->mutex);
+
+    post = startup_runtime_admission(id, owner->runtime);
+    qemu_mutex_lock(&commands->mutex);
+    service->transfer_first_status = first;
+    service->transfer_post_status = post;
+    identity = publisher_service_runtime_identity_locked(service);
+    service->transfer_identity_status = identity;
+    if (!identity) {
+        service->transition_active = false;
+    }
+    qemu_mutex_unlock(&commands->mutex);
+    if (post) {
+        crucible_metadata_partition_record_post(&startup_source.metadata_partition, post);
+    }
+    return first ? first : post ? post : identity;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+#ifdef CONFIG_LINUX
+/* Native retirement cannot consume a Source group holder whose independent
+ * receipt or identity observation failed. Observe every canonical group after
+ * admission drain; none of these facts issues cleanup work or retries return. */
+static bool publisher_service_group_drained(
+    const QemuCrucibleCallbackRegistrationGroupOwner *group)
+{
+    return !group->held && !group->creation_owner && !group->holder &&
+        !group->runtime_holder && !group->span_held && !group->native_debt &&
+        !group->receipt_active && !group->terminal_active;
+}
+
+static bool publisher_service_groups_drained(void)
+{
+    const QemuCrucibleCallbackRegistrationGroupOwner *groups[] = {
+        &startup_source.callback_groups.idle_resume,
+        &startup_source.callback_groups.shmem_dispatch,
+        &startup_source.callback_groups.net_tx,
+        &startup_source.callback_groups.block_io,
+        &startup_source.callback_groups.block_event,
+        &startup_source.callback_groups.block_wait,
+        &startup_source.callback_groups.nine_p,
+        &startup_source.callback_groups.accelerator,
+        &startup_source.callback_groups.control,
+        &startup_source.callback_groups.time_advance,
+        &startup_source.callback_groups.vcpu_init,
+    };
+
+    for (size_t index = 0; index < ARRAY_SIZE(groups); index++) {
+        if (!publisher_service_group_drained(groups[index])) {
+            return false;
+        }
+    }
+    return !startup_source.callback_groups.entered &&
+        !startup_source.callback_groups.borrower.held;
+}
+
+/* The member's real terminal writer precedes member return. This predicate
+ * additionally retains every concrete Source child, not just its user count.
+ * It neither consumes them nor asks any callback to perform cleanup work. */
+static bool publisher_service_users_drained(void)
+{
+    return !startup_source.pending_offer_read.busy &&
+        !startup_source.advance_holder &&
+        !startup_source.advance_receiver.held &&
+        !startup_source.publisher_module.advance_users &&
+        !startup_source.command_member.advance_users &&
+        !startup_source.command_member.held &&
+        !startup_source.command_member.transition_active &&
+        !startup_source.command_member.action_users &&
+        !startup_source.command_member.receive_users &&
+        !startup_source.command_receive.held &&
+        !startup_source.command_receive.terminal_uncertain &&
+        !startup_source.command_receive.creation_active &&
+        !startup_source.command_receive.invocation_active &&
+        !startup_source.received_delivery.held &&
+        !startup_source.received_delivery.payload_held &&
+        !startup_source.received_delivery.payload_transition_active &&
+        !startup_source.received_delivery.payload_uncertain &&
+        !startup_source.received_delivery.use_users &&
+        !startup_source.received_delivery.ready_users &&
+        !startup_source.received_delivery_use.held &&
+        !startup_source.ready_delivery.held &&
+        !startup_source.ready_delivery.transition_active &&
+        !startup_source.ready_delivery.main_users &&
+        !startup_source.ready_delivery.uncertain &&
+        !startup_source.main_control_borrow.held &&
+        !startup_source.main_control_borrow.transition_active &&
+        !startup_source.main_control_borrow.uncertain &&
+        !startup_source.main_control_borrow.payload_borrow.held &&
+        !startup_source.main_control_borrow.payload_borrow.transition_active &&
+        !startup_source.main_control_borrow.payload_borrow.uncertain &&
+        !startup_source.action_original.held &&
+        !startup_source.publisher_action_loan.held &&
+        !startup_source.publisher_subscription.held &&
+        !startup_source.publisher_subscription.action_users &&
+        !startup_source.publisher_subscription.uncertain &&
+        !startup_source.publisher_terminal_writer.held &&
+        !startup_source.publisher_terminal_writer.uncertain &&
+        !startup_source.standing.operation.held &&
+        !startup_source.standing.cleanup_execution &&
+        !startup_source.intent_observation.held &&
+        !startup_source.control_callback.command_member &&
+        !startup_source.control_callback.invocation.held &&
+        !startup_source.control_callback.invocation.active &&
+        !startup_source.control_callback.invocation.retained;
+}
+
+static void publisher_service_runtime_return_finish(
+    QemuCruciblePublisherModuleService *service, int identity)
+{
+    QemuCrucibleCallbackChildOwner *owner = service->runtime_owner;
+
+    if (!identity && service->returned && service->held) {
+        *service->runtime_holder = NULL;
+        owner->publisher_service = NULL;
+        owner->service_users--;
+        service->holder = NULL;
+        service->held = false;
+    }
+    if (!identity) {
+        service->transition_active = false;
+    }
+}
+#endif
+
+/* Admission closure is separate from entering physical service return. There
+ * is no callback, wait or operation issuance here; a busy retired observation
+ * leaves the actual service, owner and component retained for their caller. */
+int qemu_crucible_startup_source_publisher_service_drain_v1(
+    QemuCrucibleSourceControlBinding *component,
+    QemuCrucibleSourceControlBinding **holder)
+{
+#ifdef CONFIG_LINUX
+    QemuCruciblePublisherModuleService *service = &startup_source.publisher_module;
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    bool revoke;
+    int first;
+    int retired;
+    int groups;
+    int identity;
+
+    if (!service->attempted || !service->held) {
+        return 0;
+    }
+    if (component != &startup_source.control_callback) {
+        return -ESTALE;
+    }
+    first = startup_setup_service_binding_identity(startup_source.saved.plugin_id);
+    if (!first) {
+        first = qemu_plugin_crucible_control_component_returned_current_v1(
+            component, component->callback, component->userdata, holder);
+    }
+    if (first) {
+        return first;
+    }
+    qemu_mutex_lock(&commands->mutex);
+    first = publisher_service_runtime_identity_locked(service);
+    if (!first && (component != &startup_source.control_callback ||
+                   component->holder != holder || !holder || *holder != component ||
+                   component->child_owner != service->runtime_owner ||
+                   service->transition_active || service->return_attempted ||
+                   !publisher_service_users_drained() ||
+                   startup_source.callbacks.publication.held ||
+                   startup_source.callbacks.registrar.held ||
+                   startup_source.callbacks.native_preparing ||
+                   startup_source.callback_groups.entered ||
+                   startup_source.callback_groups.borrower.held)) {
+        first = -EBUSY;
+    }
+    if (first) {
+        qemu_mutex_unlock(&commands->mutex);
+        return first;
+    }
+    revoke = !service->native_revocation_attempted;
+    service->native_revocation_attempted = true;
+    service->transition_active = true;
+    qemu_mutex_unlock(&commands->mutex);
+
+    first = revoke ? qemu_plugin_crucible_native_registry_revoke_v1(
+        &startup_source.callbacks.native) : service->native_revocation_status;
+    retired = qemu_plugin_crucible_native_registry_retired_current_v1(
+        &startup_source.callbacks.native);
+    qemu_mutex_lock(&commands->mutex);
+    if (revoke) {
+        service->native_revocation_status = first;
+    }
+    service->native_retired_status = retired;
+    if (!service->native_retired_first_status) {
+        service->native_retired_first_status = retired;
+    }
+    identity = publisher_service_runtime_identity_locked(service);
+    service->native_drain_identity_status = identity;
+    groups = publisher_service_groups_drained() ? 0 : -EBUSY;
+    service->source_group_drain_status = groups;
+    if (!identity) {
+        service->transition_active = false;
+    }
+    qemu_mutex_unlock(&commands->mutex);
+    return first ? first : retired ? retired : identity ? identity : groups;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+QemuCruciblePublisherServiceReturnResult
+qemu_crucible_startup_source_publisher_service_return_v1(
+    QemuCrucibleSourceControlBinding *component,
+    QemuCrucibleSourceControlBinding **holder,
+    QemuCruciblePublisherServiceReturnFrame *frame)
+{
+    QemuCruciblePublisherServiceReturnResult result = { 0 };
+#ifdef CONFIG_LINUX
+    QemuCruciblePublisherModuleService *service = &startup_source.publisher_module;
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    int first;
+    int post;
+    int identity;
+
+    /* No service child is born by this physical-return boundary. Ordinary
+     * component return keeps its prior absence behavior without a new clock. */
+    if (!service->attempted) {
+        result.closed = true;
+        return result;
+    }
+    first = startup_setup_service_binding_identity(startup_source.saved.plugin_id);
+    if (!first) {
+        first = qemu_plugin_crucible_publisher_service_return_frame_current_v1(
+            frame, component, holder);
+    }
+    if (first) {
+        result.status = first;
+        return result;
+    }
+    if (!service->held) {
+        result.child_returned = service->returned;
+        result.closed = service->returned;
+        result.status = service->return_first_status ? service->return_first_status :
+            service->return_post_status;
+        return result;
+    }
+    first = qemu_plugin_crucible_native_registry_retired_current_v1(
+        &startup_source.callbacks.native);
+    if (first) {
+        result.status = first;
+        return result;
+    }
+    qemu_mutex_lock(&commands->mutex);
+    first = publisher_service_runtime_identity_locked(service);
+    service->source_group_return_status =
+        publisher_service_groups_drained() ? 0 : -EBUSY;
+    if (!first && (component != &startup_source.control_callback ||
+                   component->holder != holder || !holder || *holder != component ||
+                   component->child_owner != service->runtime_owner ||
+                   service->transition_active || service->return_attempted ||
+                   !service->native_revocation_attempted ||
+                   service->native_revocation_status || service->native_retired_status ||
+                   service->native_drain_identity_status ||
+                   service->source_group_drain_status ||
+                   service->source_group_return_status ||
+                   !publisher_service_users_drained())) {
+        first = -EBUSY;
+    }
+    if (first) {
+        qemu_mutex_unlock(&commands->mutex);
+        result.status = first;
+        return result;
+    }
+    service->cleanup_frame = frame;
+    service->closing = true;
+    service->transition_active = true;
+    service->return_attempted = true;
+    qemu_mutex_unlock(&commands->mutex);
+    result.entered = true;
+
+    /* Only the already retained local child is returned here. These Original
+     * observations may refuse; neither issues runtime permission or a wait. */
+#if defined(__x86_64__) && !defined(__ILP32__)
+    first = qemu_crucible_preexec_publisher_module_return_v1(
+        service->lender, service, &service->returned);
+#else
+    first = -ENOTSUP;
+#endif
+    post = startup_runtime_original_post();
+    qemu_mutex_lock(&commands->mutex);
+    service->return_first_status = first;
+    service->return_post_status = post;
+    identity = publisher_service_runtime_identity_locked(service);
+    service->return_identity_status = identity;
+    publisher_service_runtime_return_finish(service, identity);
+    result.child_returned = service->returned;
+    result.closed = !service->held && service->returned;
+    qemu_mutex_unlock(&commands->mutex);
+    result.status = first ? first : post ? post : identity;
+#else
+    result.status = -ENOTSUP;
+#endif
+    return result;
+}
diff --git a/plugins/crucible-publisher-subscription.inc.h b/plugins/crucible-publisher-subscription.inc.h
new file mode 100644
index 0000000000000000000000000000000000000000..e892fd60cc9703be666f81d13a97485eb1963a49
--- /dev/null
+++ b/plugins/crucible-publisher-subscription.inc.h
@@ -0,0 +1,522 @@
+/*
+ * Nominal local subscription to the installed producing peer's retained cohort.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifdef CONFIG_LINUX
+static int main_payload_identity_locked(QemuCrucibleMainControlBorrow *borrow);
+
+/* The assigned slot, not a decoded slot index, supplies the writer role. The
+ * member/delivery and this writer keep its actual mapping alive throughout. */
+static int publisher_slot_locked(QemuCruciblePublisherSubscription *subscription,
+                                 struct crucible_shmem_node_slot **out)
+{
+    QemuCrucibleSetupSlotOwner *slot = subscription->slot;
+    QemuCrucibleSetupMappingOwner *mapping = subscription->mapping;
+    uint64_t offset;
+    int status;
+
+    if (slot != &startup_source.setup_slot || mapping != &startup_source.setup_mapping ||
+        slot->mapping != mapping || slot->command_member != subscription->member) {
+        return -ESTALE;
+    }
+    status = qemu_plugin_crucible_startup_setup_slot_current_v1(
+        startup_source.saved.plugin_id, slot);
+    if (status) {
+        return status;
+    }
+    offset = mapping->layout.node_slots_offset +
+        (uint64_t)slot->index * sizeof(struct crucible_shmem_node_slot);
+    if (slot->index >= slot->node_count ||
+        offset < mapping->layout.node_slots_offset ||
+        offset > mapping->request_bytes ||
+        sizeof(struct crucible_shmem_node_slot) > mapping->request_bytes - offset ||
+        offset % _Alignof(struct crucible_shmem_node_slot)) {
+        return -EOVERFLOW;
+    }
+    *out = (void *)((uint8_t *)mapping->address + offset);
+    if (qatomic_read(&(*out)->boundary_action_hold) !=
+        subscription->cohort.binding.publisher_birth_sequence) {
+        return -ESTALE;
+    }
+    return 0;
+}
+
+static int publisher_subscription_identity_locked(
+    QemuCruciblePublisherSubscription *subscription)
+{
+    QemuCrucibleReceivedDeliveryOwner *delivery = &startup_source.received_delivery;
+
+    if (subscription != &startup_source.publisher_subscription ||
+        subscription->canonical_owner != subscription || !subscription->attempted ||
+        subscription->delivery != delivery || subscription->delivery_serial != delivery->serial ||
+        subscription->receive != delivery->receive ||
+        subscription->receive_serial != delivery->receive_serial ||
+        subscription->member != delivery->member || subscription->lender != delivery->lender ||
+        subscription->lender != startup_source.standing.lender ||
+        subscription->ready != &startup_source.ready_delivery ||
+        subscription->process != getpid() || !qemu_thread_is_self(&subscription->thread)) {
+        return -ESTALE;
+    }
+    return received_delivery_identity_locked(delivery, subscription->delivery_serial);
+}
+
+/* Current is a drift refusal on a nominal loan already born in Ready. It
+ * performs no coherent read or clock renewal under Main's BQL interval. */
+static int publisher_subscription_current_locked(
+    QemuCruciblePublisherSubscription *subscription)
+{
+    struct crucible_shmem_node_slot *slot;
+    uint64_t sequence = 0;
+    int status = publisher_subscription_identity_locked(subscription);
+
+    if (!status && (!subscription->held || subscription->view_returned ||
+                    subscription->terminal || subscription->uncertain)) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        status = publisher_slot_locked(subscription, &slot);
+    }
+    if (!status) {
+        status = qemu_crucible_preexec_standing_sequence_v1(subscription->lender, &sequence);
+    }
+    return status ? status : sequence == subscription->sequence ? 0 : -ESTALE;
+}
+
+static int publisher_subscription_capture_locked(QemuCrucibleReadyDeliveryHandoff *ready)
+{
+    QemuCruciblePublisherSubscription *subscription = &startup_source.publisher_subscription;
+    QemuCruciblePublisherTerminalWriter *writer = &startup_source.publisher_terminal_writer;
+    QemuCrucibleReceivedDeliveryOwner *delivery = ready->delivery;
+    QemuCrucibleCommandReceiveOwner *receive = ready->receive;
+    const QemuCrucibleBoundaryActionRecord *cohort = &startup_source.standing.current.action;
+    struct crucible_shmem_node_slot *slot;
+    uint32_t complete;
+    int status;
+
+    /* Older component callers with no published action obtain no subscription.
+     * A partial/unsent tail cannot establish the completed-request promise. */
+    if (!receive->publisher.present && !cohort->present) {
+        return 0;
+    }
+    if (bql_locked() || !ready->held || ready->uncertain || !ready->execution_holder ||
+        *ready->execution_holder != ready || subscription->attempted || writer->attempted ||
+        receive->creation_active || receive->invocation_active ||
+        !receive->invocation_returned || !receive->progress_valid ||
+        receive->terminal_uncertain || receive->progress.request_received != 1 ||
+        !receive->progress.reader_released || receive->validation_status ||
+        !startup_source.standing.retained ||
+        startup_source.standing.initial.producer_retention_edition != 1 ||
+        startup_source.standing.current.producer_retention_edition != 1 ||
+        !cohort->present || cohort->dirty || !cohort->planned_count ||
+        cohort->planned_count > QEMU_CRUCIBLE_ACTION_PARENT_CAPACITY ||
+        delivery->member->action_users == UINT64_MAX) {
+        return -ESTALE;
+    }
+    complete = (UINT32_C(1) << cohort->planned_count) - 1;
+    if (cohort->born_mask != complete || cohort->projected_mask != complete ||
+        !cohort->binding.publisher_birth_sequence ||
+        (cohort->binding.publisher_birth_sequence & 1) ||
+        cohort->binding.publisher_birth_sequence == UINT64_MAX) {
+        return -ESTALE;
+    }
+    for (size_t index = 0; index < cohort->planned_count; index++) {
+        if (cohort->rows[index].state) {
+            return -ESTALE;
+        }
+    }
+    status = command_receive_publisher_corroboration(receive, cohort);
+    if (status) {
+        return status;
+    }
+    /* Resolve the genuine assigned slot before birth. All values below come
+     * from retained nominal parents, never a caller's subscription tuple. */
+    *subscription = (QemuCruciblePublisherSubscription) {
+        .canonical_owner = subscription,
+        .ready = ready,
+        .delivery = delivery,
+        .receive = receive,
+        .member = delivery->member,
+        .slot = delivery->member->slot,
+        .mapping = delivery->member->slot->mapping,
+        .lender = ready->lender,
+        .cohort = *cohort,
+        .thread = ready->thread,
+        .sequence = startup_source.standing.sequence,
+        .delivery_serial = delivery->serial,
+        .receive_serial = receive->serial,
+        .process = getpid(),
+    };
+    status = publisher_slot_locked(subscription, &slot);
+    if (status) {
+        return status;
+    }
+    subscription->attempted = true;
+    subscription->held = true;
+    delivery->member->action_users++;
+    *writer = (QemuCruciblePublisherTerminalWriter) {
+        .canonical_owner = writer,
+        .subscription = subscription,
+        .delivery = delivery,
+        .member = subscription->member,
+        .slot = subscription->slot,
+        .mapping = subscription->mapping,
+        .lender = subscription->lender,
+        .thread = ready->thread,
+        .delivery_serial = delivery->serial,
+        .process = getpid(),
+        .attempted = true,
+        .held = true,
+    };
+    /* Both lifetimes precede this independent physical post. Its refusal
+     * cannot discard a born view or its retained terminal writer. */
+    subscription->post_status = publisher_subscription_current_locked(subscription);
+    return subscription->post_status;
+}
+
+static int publisher_subscription_view_return_locked(
+    QemuCrucibleReceivedDeliveryOwner *delivery)
+{
+    QemuCruciblePublisherSubscription *subscription = &startup_source.publisher_subscription;
+    int status;
+
+    if (!subscription->attempted) {
+        return 0;
+    }
+    status = publisher_subscription_identity_locked(subscription);
+    if (status || subscription->delivery != delivery) {
+        return status ? status : -ESTALE;
+    }
+    if (subscription->action_users || subscription->uncertain ||
+        subscription->ready->main_users) {
+        return -EBUSY;
+    }
+    /* No fresh publication or healthy first status is needed to close this
+     * actual local view. Its separately retained writer still owns the mapping. */
+    subscription->held = false;
+    subscription->view_returned = true;
+    subscription->terminal = true;
+    return 0;
+}
+
+static int publisher_action_identity_locked(QemuCruciblePublisherActionLoan *loan,
+                                           QemuCrucibleMainControlBorrow *main,
+                                           QemuCrucibleActionOriginal *action)
+{
+    QemuCruciblePublisherSubscription *subscription = &startup_source.publisher_subscription;
+
+    if (loan != &startup_source.publisher_action_loan || loan->canonical_owner != loan ||
+        !loan->held || loan->returned || loan->subscription != subscription ||
+        !subscription->action_attempted || subscription->action_users != 1 ||
+        loan->main != main || loan->action != action || !loan->holder ||
+        *loan->holder != loan || loan->delivery_serial != subscription->delivery_serial ||
+        loan->process != getpid() || !qemu_thread_is_self(&loan->thread) ||
+        main != &startup_source.main_control_borrow ||
+        loan->main_serial != main->invocation_serial) {
+        return -ESTALE;
+    }
+    return main_payload_identity_locked(main);
+}
+#endif
+
+int qemu_crucible_source_publisher_action_acquire_v1(
+    QemuCrucibleMainControlBorrow *main, QemuCrucibleActionOriginal *action,
+    QemuCruciblePublisherActionLoan **holder)
+{
+#ifdef CONFIG_LINUX
+    QemuCruciblePublisherSubscription *subscription = &startup_source.publisher_subscription;
+    QemuCruciblePublisherActionLoan *loan = &startup_source.publisher_action_loan;
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    int status;
+
+    qemu_mutex_lock(&commands->mutex);
+    status = qemu_crucible_source_action_original_publisher_issuing_v1(action, main, holder);
+    if (!status && (!holder || (uintptr_t)holder % _Alignof(*holder) ||
+                    (uintptr_t)holder > UINTPTR_MAX - sizeof(*holder) || *holder)) {
+        status = -EINVAL;
+    }
+    if (!status) {
+        status = main_payload_identity_locked(main);
+    }
+    if (!status) {
+        status = publisher_subscription_current_locked(subscription);
+    }
+    if (!status && (subscription->ready != main->handoff ||
+                    subscription->action_attempted || subscription->action_users ||
+                    loan->attempted)) {
+        status = -EBUSY;
+    }
+    if (!status) {
+        *loan = (QemuCruciblePublisherActionLoan) {
+            .canonical_owner = loan,
+            .holder = holder,
+            .subscription = subscription,
+            .main = main,
+            .action = action,
+            .thread = subscription->thread,
+            .main_serial = main->invocation_serial,
+            .delivery_serial = subscription->delivery_serial,
+            .process = getpid(),
+            .attempted = true,
+            .held = true,
+        };
+        subscription->action_attempted = true;
+        subscription->action_users++;
+        *holder = loan;
+        loan->acquire_post = publisher_subscription_current_locked(subscription);
+        status = loan->acquire_post;
+    }
+    qemu_mutex_unlock(&commands->mutex);
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_crucible_source_publisher_action_current_v1(
+    QemuCruciblePublisherActionLoan *loan, QemuCrucibleMainControlBorrow *main,
+    QemuCrucibleActionOriginal *action)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    int status;
+
+    qemu_mutex_lock(&commands->mutex);
+    status = publisher_action_identity_locked(loan, main, action);
+    if (!status) {
+        status = qemu_crucible_source_action_original_publisher_current_v1(
+            action, main, loan->holder);
+    }
+    if (!status) {
+        status = publisher_subscription_current_locked(loan->subscription);
+    }
+    qemu_mutex_unlock(&commands->mutex);
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_crucible_source_publisher_action_snapshot_v1(
+    QemuCruciblePublisherActionLoan *loan, QemuCrucibleMainControlBorrow *main,
+    QemuCrucibleActionOriginal *action, QemuCrucibleBoundaryActionRecord *out)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    int status;
+
+    if (!out || (uintptr_t)out % _Alignof(*out) ||
+        (uintptr_t)out > UINTPTR_MAX - sizeof(*out)) {
+        return -EINVAL;
+    }
+    qemu_mutex_lock(&commands->mutex);
+    status = publisher_action_identity_locked(loan, main, action);
+    if (!status && callback_child_output_conflicts_locked(out, sizeof(*out))) {
+        status = -EINVAL;
+    }
+    if (!status) {
+        status = qemu_crucible_source_action_original_publisher_current_v1(
+            action, main, loan->holder);
+    }
+    if (!status) {
+        status = publisher_subscription_current_locked(loan->subscription);
+    }
+    if (!status) {
+        *out = loan->subscription->cohort;
+    }
+    qemu_mutex_unlock(&commands->mutex);
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_crucible_source_publisher_action_return_v1(
+    QemuCruciblePublisherActionLoan **holder,
+    QemuCrucibleMainControlBorrow *main, QemuCrucibleActionOriginal *action)
+{
+#ifdef CONFIG_LINUX
+    QemuCruciblePublisherActionLoan *loan = &startup_source.publisher_action_loan;
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    int status;
+
+    qemu_mutex_lock(&commands->mutex);
+    status = publisher_action_identity_locked(loan, main, action);
+    if (!status && holder != loan->holder) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        status = qemu_crucible_source_action_original_publisher_returning_v1(action, main, holder);
+    }
+    if (!status) {
+        status = qemu_crucible_source_action_original_publisher_result_v1(
+            action, main, holder, &loan->first_status, &loan->post_status);
+    }
+    if (!status && (loan->first_status > 0 || loan->post_status > 0)) {
+        status = -EPROTO;
+    }
+    if (!status) {
+        loan->subscription->action_users--;
+        loan->held = false;
+        loan->returned = true;
+        *holder = NULL;
+    }
+    qemu_mutex_unlock(&commands->mutex);
+    /* Pure physical return: every negative preserves this exact child. */
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+#ifdef CONFIG_LINUX
+static int publisher_terminal_status(QemuCruciblePublisherSubscription *subscription)
+{
+    QemuCrucibleReceivedDeliveryOwner *delivery = subscription->delivery;
+    int status = command_receive_result_locked(subscription->receive);
+
+    if (!status) {
+        status = subscription->first_status ? subscription->first_status : subscription->post_status;
+    }
+    if (!status) {
+        status = delivery->payload_claim_status < 0 ? delivery->payload_claim_status :
+            delivery->payload_claim_validation ? delivery->payload_claim_validation :
+            delivery->payload_claim_post;
+    }
+    if (!status) {
+        status = delivery->payload_return_first;
+    }
+    if (!status && subscription->action_attempted) {
+        QemuCruciblePublisherActionLoan *loan = &startup_source.publisher_action_loan;
+
+        status = loan->first_status ? loan->first_status :
+            loan->acquire_post ? loan->acquire_post : loan->post_status;
+    }
+    return status < 0 ? status : status ? -EPROTO : 0;
+}
+
+static void publisher_terminal_encode(QemuCruciblePublisherTerminalWriter *writer)
+{
+    QemuCruciblePublisherSubscription *subscription = writer->subscription;
+    const QemuCrucibleActionBinding *binding = &subscription->cohort.binding;
+    uint8_t *wire = writer->payload;
+
+    memset(wire, 0, sizeof(writer->payload));
+    memcpy(wire, "CRUCRET1", 8);
+    stl_be_p(wire + 8, 1);
+    stl_be_p(wire + 12, sizeof(writer->payload));
+    memcpy(wire + 16, binding->source_capability, 32);
+    memcpy(wire + 48, binding->source_reservation, 32);
+    stq_be_p(wire + 80, binding->account_incarnation);
+    stq_be_p(wire + 88, binding->process_incarnation);
+    stl_be_p(wire + 96, binding->request_token);
+    stl_be_p(wire + 100, binding->capture_generation);
+    stq_be_p(wire + 104, binding->command_frontier);
+    stq_be_p(wire + 112, binding->publisher_birth_sequence);
+    stl_be_p(wire + 120, writer->first_status);
+    stl_be_p(wire + 124, writer->post_status);
+    stl_be_p(wire + 128, 1);
+    stl_be_p(wire + 132, subscription->cohort.born_mask);
+    stl_be_p(wire + 136, subscription->cohort.planned_count);
+    stl_be_p(wire + 168, subscription->cohort.born_mask);
+    /* No operation/progress witness is produced by local lifetime closure. */
+}
+
+/* Called before pure delivery consumption. Once the last CAS consumed the
+ * writer, a negative independent post is saved without resurrecting custody. */
+static int publisher_terminal_return_locked(QemuCrucibleReceivedDeliveryOwner *delivery)
+{
+    QemuCruciblePublisherTerminalWriter *writer = &startup_source.publisher_terminal_writer;
+    QemuCruciblePublisherSubscription *subscription = &startup_source.publisher_subscription;
+    QemuCrucibleReadyDeliveryHandoff *ready = &startup_source.ready_delivery;
+    struct crucible_shmem_node_slot *slot;
+    uint64_t expected;
+    uint64_t sequence;
+    int status;
+
+    if (!writer->attempted) {
+        return subscription->attempted ? -EIO : 0;
+    }
+    status = publisher_subscription_identity_locked(subscription);
+    if (status || writer->canonical_owner != writer || writer->subscription != subscription ||
+        writer->delivery != delivery || writer->delivery_serial != delivery->serial ||
+        writer->member != subscription->member || writer->slot != subscription->slot ||
+        writer->mapping != subscription->mapping || writer->lender != subscription->lender ||
+        writer->process != getpid() || !qemu_thread_is_self(&writer->thread)) {
+        return status ? status : -ESTALE;
+    }
+    if (writer->publication_consumed) {
+        return writer->held ? -EIO : 0;
+    }
+    if (!writer->held || writer->uncertain || subscription->uncertain ||
+        !subscription->view_returned || !subscription->terminal || subscription->held ||
+        subscription->action_users || ready->held || ready->main_users ||
+        !delivery->ready_closed || delivery->ready_users || delivery->use_users ||
+        delivery->payload_transition_active || delivery->payload_uncertain ||
+        delivery->payload_held || delivery->payload ||
+        !delivery->payload_attempted || !delivery->payload_return_attempted ||
+        !delivery->payload_returned) {
+        return -EBUSY;
+    }
+    status = publisher_slot_locked(subscription, &slot);
+    if (status) {
+        return status;
+    }
+    status = qemu_crucible_source_action_original_delivery_result_v1(
+        delivery, delivery->serial, &writer->action_first, &writer->action_post);
+    if (status || writer->action_first > 0 || writer->action_post > 0) {
+        return status ? status : -EPROTO;
+    }
+    /* Physical closure is independent from semantic first/post failures. The
+     * peer alone consumes this local closure and retires its own rows/hold. */
+    writer->physical_closed = true;
+    if (writer->publication_started) {
+        writer->uncertain = true;
+        return -EIO;
+    }
+    sequence = be64_to_cpu(atomic_load_explicit(
+        &slot->boundary_action_return[0], memory_order_seq_cst));
+    if ((sequence & 1) || sequence > UINT64_MAX - 3) {
+        writer->uncertain = true;
+        writer->publication_status = -ESTALE;
+        return writer->publication_status;
+    }
+    writer->first_status = publisher_terminal_status(subscription);
+    if (!writer->first_status) {
+        writer->first_status = writer->action_first;
+    }
+    writer->post_status = writer->action_post ? writer->action_post : delivery->payload_return_post;
+    writer->expected_sequence = sequence;
+    writer->odd_sequence = sequence + 1;
+    writer->published_sequence = sequence + 2;
+    publisher_terminal_encode(writer);
+    expected = cpu_to_be64(sequence);
+    if (!atomic_compare_exchange_strong_explicit(
+        &slot->boundary_action_return[0], &expected,
+        cpu_to_be64(writer->odd_sequence), memory_order_seq_cst, memory_order_seq_cst)) {
+        writer->uncertain = true;
+        writer->publication_status = -ESTALE;
+        return writer->publication_status;
+    }
+    writer->publication_started = true;
+    for (size_t index = 0; index < sizeof(writer->payload) / sizeof(uint64_t); index++) {
+        uint64_t word;
+
+        memcpy(&word, writer->payload + index * sizeof(word), sizeof(word));
+        atomic_store_explicit(&slot->boundary_action_return[index + 1], word, memory_order_seq_cst);
+    }
+    expected = cpu_to_be64(writer->odd_sequence);
+    if (!atomic_compare_exchange_strong_explicit(
+        &slot->boundary_action_return[0], &expected,
+        cpu_to_be64(writer->published_sequence), memory_order_seq_cst, memory_order_seq_cst)) {
+        writer->uncertain = true;
+        writer->publication_status = -EIO;
+        return writer->publication_status;
+    }
+    writer->publication_consumed = true;
+    writer->held = false;
+    writer->member->action_users--;
+    writer->publication_post = publisher_slot_locked(subscription, &slot);
+    return writer->publication_post;
+}
+#endif
diff --git a/plugins/crucible-qmp-allocation.inc.h b/plugins/crucible-qmp-allocation.inc.h
new file mode 100644
index 0000000000000000000000000000000000000000..a58a8d7f472991deb02d17155e22cea32fbf9fb5
--- /dev/null
+++ b/plugins/crucible-qmp-allocation.inc.h
@@ -0,0 +1,812 @@
+/*
+ * Exact selected QMP allocation custody in the retained Source partition
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Included once in Source. Registry lookup precedes all owner/header access;
+ * TLS and decoded QObject values do not create this physical payer. No module
+ * callback or Monitor lock is acquired under the accounting cut. Request/Stop
+ * and checkpoint constructors are independent of this physical allocation API.
+ */
+
+static bool qmp_allocation_enter(QemuCrucibleQmpAllocationLedger *ledger)
+{
+    return !qatomic_cmpxchg(&ledger->busy, false, true);
+}
+
+static void qmp_allocation_leave(QemuCrucibleQmpAllocationLedger *ledger)
+{
+    qatomic_store_release(&ledger->busy, false);
+}
+
+static QemuCrucibleQmpAllocationOwner *qmp_allocation_find_owner(
+    QemuCrucibleQmpAllocationLedger *ledger,
+    QemuCrucibleQmpAllocationOwner *candidate)
+{
+    for (QemuCrucibleQmpAllocationOwner *owner = ledger->owners;
+         owner; owner = owner->next) {
+        if (owner == candidate) {
+            return owner;
+        }
+    }
+    return NULL;
+}
+
+static int qmp_allocation_identity(QemuCrucibleQmpAllocationOwner *owner)
+{
+    QemuCrucibleMonitorPurpose *monitor = &startup_source.monitor_purpose;
+
+    if (getpid() != startup_source.owner_process ||
+        !qatomic_load_acquire(&startup_source.process_purpose_complete) ||
+        !qatomic_load_acquire(&startup_source.custody_retained) ||
+        !monitor->bound || monitor->construction_uncertain ||
+        !monitor->allocation || !monitor->fixed_charge.held ||
+        monitor->process_id != getpid() ||
+        monitor->process_generation != startup_source.original.process_generation ||
+        monitor->allocation->crucible_purpose != monitor ||
+        !owner || !owner->born || owner->monitor != monitor->allocation ||
+        owner->monitor_purpose != monitor ||
+        owner->process_purpose != startup_source.preexec_purpose_owner ||
+        owner->process_generation != monitor->process_generation ||
+        (!owner->persistent && !owner->charge.held)) {
+        return -EPERM;
+    }
+    return 0;
+}
+
+static int qmp_allocation_live(QemuCrucibleQmpAllocationLedger *ledger,
+                                QemuCrucibleQmpAllocationOwner *owner)
+{
+    int status = qmp_allocation_identity(owner);
+
+    if (status) {
+        return status;
+    }
+    status = qatomic_read(&startup_source.monitor_purpose.output_status);
+    if (status) {
+        return status;
+    }
+#if defined(CONFIG_LINUX) && defined(__x86_64__) && !defined(__ILP32__)
+    return qemu_crucible_preexec_contract_check_v3(
+        startup_source.preexec_purpose_owner, &ledger->observation,
+        &ledger->descriptor_limit);
+#else
+    return -ENOTSUP;
+#endif
+}
+
+static int qmp_allocation_post(QemuCrucibleQmpAllocationLedger *ledger,
+                                QemuCrucibleQmpAllocationOwner *owner,
+                                int first)
+{
+    int post = qmp_allocation_live(ledger, owner);
+
+    if (first < 0 && !owner->first_status) {
+        owner->first_status = first;
+    }
+    if (post < 0) {
+        if (!owner->post_status) {
+            owner->post_status = post;
+        }
+        if (!owner->first_status) {
+            owner->first_status = post;
+        }
+    }
+    return first ? first : post;
+}
+
+static int qmp_allocation_owner_release(QemuCrucibleQmpAllocationLedger *ledger,
+                                        QemuCrucibleQmpAllocationOwner *owner);
+
+static int qmp_allocation_retirement_retry(QemuCrucibleQmpAllocationLedger *ledger)
+{
+    int status;
+
+    if (!ledger->retired_charge.held) {
+        return 0;
+    }
+    status = crucible_metadata_native_retire(&startup_source.metadata_partition,
+                                            &ledger->retired_charge);
+    if (status < 0 && !ledger->post_status) {
+        ledger->post_status = status;
+    }
+    if (!status) {
+        ledger->freed_alias = NULL;
+        if (ledger->reclaim_owner && !ledger->cleanup_borrow.held) {
+            QemuCrucibleQmpAllocationOwner *owner = ledger->reclaim_owner;
+
+            ledger->reclaim_owner = NULL;
+            /* Only an actual last-free failure records this exact owner here.
+             * The issuer already returned; no external allocation/borrow lives. */
+            return qmp_allocation_owner_release(ledger, owner);
+        }
+    }
+    return status;
+}
+
+static int qmp_allocation_owner_release(QemuCrucibleQmpAllocationLedger *ledger,
+                                        QemuCrucibleQmpAllocationOwner *owner)
+{
+    QemuCrucibleQmpAllocationOwner **link = &ledger->owners;
+
+    if (owner->persistent || owner->issuer_retained || owner->borrow.held ||
+        qatomic_load_acquire(&owner->parser_scope.held) || qatomic_load_acquire(&owner->dispatch_scope.held) ||
+        owner->allocation_count || owner->blocks) {
+        return 0;
+    }
+    if (ledger->retired_charge.held || ledger->cleanup_borrow.held) {
+        return -EINPROGRESS;
+    }
+    while (*link && *link != owner) {
+        link = &(*link)->next;
+    }
+    if (!*link || !owner->charge.held) {
+        return -ESTALE;
+    }
+    *link = owner->next;
+    if (ledger->reclaim_owner == owner) {
+        ledger->reclaim_owner = NULL;
+    }
+    ledger->retired_charge = owner->charge;
+    ledger->freed_alias = owner;
+    /* No external issuer, borrow or allocation reference remains. The exact
+     * requested owner body is freed before native ledger retirement. */
+    g_free(owner);
+    return qmp_allocation_retirement_retry(ledger);
+}
+
+static int qmp_allocation_monitor_identity(Monitor *monitor)
+{
+    QemuCrucibleMonitorPurpose *purpose = &startup_source.monitor_purpose;
+
+    return qatomic_load_acquire(&startup_source.process_purpose_complete) &&
+        getpid() == startup_source.owner_process && purpose->bound &&
+        !purpose->construction_uncertain && purpose->fixed_charge.held &&
+        purpose->allocation == monitor && monitor &&
+        monitor->crucible_purpose == purpose && purpose->process_id == getpid() &&
+        purpose->process_generation == startup_source.original.process_generation ?
+        0 : -EPERM;
+}
+
+int qemu_crucible_qmp_persistent_owner_begin(
+    Monitor *monitor, QemuCrucibleQmpAllocationOwner **out)
+{
+    QemuCrucibleQmpAllocationLedger *ledger = &startup_source.qmp_allocations;
+    QemuCrucibleQmpAllocationOwner *owner = &ledger->persistent;
+    int status;
+
+    if (!out) {
+        return -EINVAL;
+    }
+    *out = NULL;
+    if (!qatomic_load_acquire(&qemu_crucible_selected_process_id)) {
+        return 0;
+    }
+    status = qmp_allocation_monitor_identity(monitor);
+    if (status || !qemu_in_main_thread() || !bql_locked()) {
+        return status ? status : -EPERM;
+    }
+    if (!qmp_allocation_enter(ledger)) {
+        return -EAGAIN;
+    }
+    if (owner->born) {
+        status = -EALREADY;
+        goto done;
+    }
+    *owner = (QemuCrucibleQmpAllocationOwner) {
+        .next = ledger->owners,
+        .monitor = monitor,
+        .monitor_purpose = &startup_source.monitor_purpose,
+        .process_purpose = startup_source.preexec_purpose_owner,
+        .process_generation = startup_source.monitor_purpose.process_generation,
+        .persistent = true,
+        .issuer_retained = true,
+        .born = true,
+    };
+    /* This entire inline owner and journal already belong to sizeof Source,
+     * which the genuine prebirth metadata constructor must retain. */
+    ledger->owners = owner;
+    *out = owner;
+    status = qmp_allocation_post(ledger, owner, 0);
+
+done:
+    qmp_allocation_leave(ledger);
+    return status;
+}
+
+static int qmp_allocation_socket_peer_current(SocketChardev *socket)
+{
+#if defined(CONFIG_LINUX) && defined(__x86_64__) && !defined(__ILP32__)
+    QemuCruciblePreexecPeerObservation issuer;
+    struct {
+        int process;
+        uint32_t user;
+        uint32_t group;
+    } peer;
+    socklen_t length;
+    int value;
+    int status;
+
+    status = qemu_crucible_preexec_peer_observe_v3(
+        startup_source.preexec_purpose_owner, &issuer);
+    if (status) {
+        return status;
+    }
+    length = sizeof(value);
+    if (getsockopt(socket->sioc->fd, SOL_SOCKET, SO_DOMAIN, &value, &length) < 0) {
+        return -errno;
+    }
+    if (length != sizeof(value) || value != AF_UNIX) {
+        return -EPROTOTYPE;
+    }
+    length = sizeof(value);
+    if (getsockopt(socket->sioc->fd, SOL_SOCKET, SO_TYPE, &value, &length) < 0) {
+        return -errno;
+    }
+    if (length != sizeof(value) || value != SOCK_STREAM) {
+        return -EPROTOTYPE;
+    }
+    length = sizeof(peer);
+    if (getsockopt(socket->sioc->fd, SOL_SOCKET, SO_PEERCRED, &peer, &length) < 0) {
+        return -errno;
+    }
+    return length == sizeof(peer) && peer.process == issuer.process_id &&
+        peer.user == issuer.user_id && peer.group == issuer.group_id ? 0 : -EPERM;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_crucible_qmp_message_owner_begin(
+    Monitor *monitor, QemuCrucibleQmpAllocationOwner **out)
+{
+    QemuCrucibleQmpAllocationLedger *ledger = &startup_source.qmp_allocations;
+    QemuCrucibleQmpAllocationOwner *persistent = &ledger->persistent;
+    QemuCrucibleQmpAllocationOwner *owner;
+    QemuCrucibleMetadataCharge charge = { 0 };
+    Chardev *chardev;
+    SocketChardev *socket;
+    MonitorQMP *qmp;
+    uint64_t epoch;
+    int status;
+
+    if (!out) {
+        return -EINVAL;
+    }
+    *out = NULL;
+    if (!qatomic_load_acquire(&qemu_crucible_selected_process_id)) {
+        return 0;
+    }
+    status = qmp_allocation_monitor_identity(monitor);
+    if (status) {
+        return status;
+    }
+    chardev = monitor->chr.chr;
+    if (!chardev || chardev->fe != &monitor->chr ||
+        !object_dynamic_cast(OBJECT(chardev), TYPE_CHARDEV_SOCKET) ||
+        !g_main_context_is_owner(chardev->gcontext ? chardev->gcontext :
+                                                   g_main_context_default())) {
+        return -EPERM;
+    }
+    socket = SOCKET_CHARDEV(chardev);
+    if (socket->state != TCP_CHARDEV_STATE_CONNECTED || !socket->sioc ||
+        socket->ioc != QIO_CHANNEL(socket->sioc) || socket->sioc->fd < 0 ||
+        !qio_channel_has_feature(socket->ioc, QIO_CHANNEL_FEATURE_FD_PASS)) {
+        return -ESTALE;
+    }
+    status = qmp_allocation_socket_peer_current(socket);
+    if (status) {
+        return status;
+    }
+    qmp = MONITOR_QMP(monitor);
+    qemu_mutex_lock(&monitor->mon_lock);
+    epoch = qmp->connection_epoch;
+    status = qmp->connection_open && epoch && epoch != UINT64_MAX ? 0 : -ESTALE;
+    qemu_mutex_unlock(&monitor->mon_lock);
+    if (status) {
+        return status;
+    }
+    if (!qmp_allocation_enter(ledger)) {
+        return -EAGAIN;
+    }
+    if (qmp_allocation_find_owner(ledger, persistent) != persistent) {
+        status = -ENOKEY;
+        goto done;
+    }
+    status = qmp_allocation_live(ledger, persistent);
+    if (!status && ledger->cleanup_borrow.held) {
+        status = -EINPROGRESS;
+    }
+    if (!status) {
+        status = qmp_allocation_retirement_retry(ledger);
+    }
+    if (!status) {
+        status = crucible_metadata_native_admit(&startup_source.metadata_partition,
+                                                sizeof(*owner), &charge);
+    }
+    if (status) {
+        goto done;
+    }
+    owner = g_try_malloc0(sizeof(*owner));
+    if (!owner) {
+        ledger->retired_charge = charge;
+        status = qmp_allocation_retirement_retry(ledger);
+        status = status ? status : -ENOMEM;
+        goto done;
+    }
+    *owner = (QemuCrucibleQmpAllocationOwner) {
+        .next = ledger->owners,
+        .monitor = monitor,
+        .monitor_purpose = &startup_source.monitor_purpose,
+        .process_purpose = startup_source.preexec_purpose_owner,
+        .process_generation = startup_source.monitor_purpose.process_generation,
+        .connection_epoch = epoch,
+        .charge = charge,
+        .issuer_retained = true,
+        .born = true,
+    };
+    ledger->owners = owner;
+    *out = owner;
+    status = qmp_allocation_post(ledger, owner, 0);
+
+done:
+    qmp_allocation_leave(ledger);
+    return status;
+}
+
+int qemu_crucible_qmp_owner_current(QemuCrucibleQmpAllocationOwner *candidate)
+{
+    QemuCrucibleQmpAllocationLedger *ledger = &startup_source.qmp_allocations;
+    QemuCrucibleQmpAllocationOwner *owner;
+    int status;
+
+    if (!qmp_allocation_enter(ledger)) {
+        return -EAGAIN;
+    }
+    owner = qmp_allocation_find_owner(ledger, candidate);
+    status = owner ? qmp_allocation_live(ledger, owner) : -EPERM;
+    qmp_allocation_leave(ledger);
+    return status;
+}
+
+static int qmp_allocation_allocate_locked(QemuCrucibleQmpAllocationLedger *ledger,
+                                          QemuCrucibleQmpAllocationOwner *owner,
+                                          size_t bytes, bool zero, void **out)
+{
+    QemuCrucibleQmpAllocationBlock *block;
+    QemuCrucibleMetadataCharge charge = { 0 };
+    size_t extent;
+    int status;
+
+    if (!bytes || bytes > SIZE_MAX - sizeof(*block)) {
+        return bytes ? -EOVERFLOW : -EINVAL;
+    }
+    if ((!owner->issuer_retained && !owner->borrow.held) || owner->first_status) {
+        return owner->first_status ? owner->first_status : -EPERM;
+    }
+    if (owner->allocation_count == SIZE_MAX) {
+        return -EOVERFLOW;
+    }
+    if (ledger->cleanup_borrow.held) {
+        return -EINPROGRESS;
+    }
+    status = qmp_allocation_live(ledger, owner);
+    if (!status) {
+        status = qmp_allocation_retirement_retry(ledger);
+    }
+    if (status) {
+        return status;
+    }
+    extent = sizeof(*block) + bytes;
+    status = crucible_metadata_native_admit(&startup_source.metadata_partition,
+                                            extent, &charge);
+    if (status) {
+        return qmp_allocation_post(ledger, owner, status);
+    }
+    block = zero ? g_try_malloc0(extent) : g_try_malloc(extent);
+    if (!block) {
+        ledger->retired_charge = charge;
+        status = qmp_allocation_retirement_retry(ledger);
+        return qmp_allocation_post(ledger, owner, status ? status : -ENOMEM);
+    }
+    block->record = (typeof(block->record)) {
+        .next = owner->blocks,
+        .owner = owner,
+        .charge = charge,
+        .payload_bytes = bytes,
+    };
+    owner->blocks = block;
+    owner->allocation_count++;
+    *out = block + 1;
+    return qmp_allocation_post(ledger, owner, 0);
+}
+
+int qemu_crucible_qmp_allocate(QemuCrucibleQmpAllocationOwner *candidate,
+                              size_t bytes, bool zero, void **out)
+{
+    QemuCrucibleQmpAllocationLedger *ledger = &startup_source.qmp_allocations;
+    QemuCrucibleQmpAllocationOwner *owner;
+    int status;
+
+    if (!out) {
+        return -EINVAL;
+    }
+    *out = NULL;
+    if (!qmp_allocation_enter(ledger)) {
+        return -EAGAIN;
+    }
+    owner = qmp_allocation_find_owner(ledger, candidate);
+    status = owner ? qmp_allocation_allocate_locked(ledger, owner, bytes, zero, out) :
+                     -EPERM;
+    qmp_allocation_leave(ledger);
+    return status;
+}
+
+static QemuCrucibleQmpAllocationBlock **qmp_allocation_find_block(
+    QemuCrucibleQmpAllocationLedger *ledger, void *payload,
+    QemuCrucibleQmpAllocationOwner **found_owner)
+{
+    for (QemuCrucibleQmpAllocationOwner *owner = ledger->owners;
+         owner; owner = owner->next) {
+        for (QemuCrucibleQmpAllocationBlock **link = &owner->blocks;
+             *link; link = &(*link)->record.next) {
+            if ((void *)(*link + 1) == payload) {
+                *found_owner = owner;
+                return link;
+            }
+        }
+    }
+    return NULL;
+}
+
+int qemu_crucible_qmp_allocation_current(
+    QemuCrucibleQmpAllocationOwner *candidate, const void *payload)
+{
+    QemuCrucibleQmpAllocationLedger *ledger = &startup_source.qmp_allocations;
+    QemuCrucibleQmpAllocationOwner *owner;
+    QemuCrucibleQmpAllocationBlock **link;
+    int status;
+
+    if (!payload) {
+        return -EINVAL;
+    }
+    if (!qmp_allocation_enter(ledger)) {
+        return -EAGAIN;
+    }
+    link = qmp_allocation_find_block(ledger, (void *)payload, &owner);
+    if (!link || (candidate && owner != candidate) ||
+        !(*link)->record.charge.held || (*link)->record.owner != owner) {
+        status = -EPERM;
+    } else {
+        status = qmp_allocation_live(ledger, owner);
+    }
+    qmp_allocation_leave(ledger);
+    return status;
+}
+
+static int qmp_allocation_free_locked(QemuCrucibleQmpAllocationLedger *ledger,
+                                      QemuCrucibleQmpAllocationOwner *owner,
+                                      QemuCrucibleQmpAllocationBlock **link,
+                                      void **payload)
+{
+    QemuCrucibleQmpAllocationBlock *block = *link;
+    int status = qmp_allocation_identity(owner);
+
+    if (qatomic_load_acquire(&block->record.visitor_pin) ||
+        qatomic_load_acquire(&block->record.mutation) ||
+        qatomic_load_acquire(&block->record.cleanup_retained)) {
+        return -EBUSY;
+    }
+
+    if (!status && ledger->cleanup_borrow.held) {
+        status = -EINPROGRESS;
+    }
+    if (!status) {
+        status = qmp_allocation_retirement_retry(ledger);
+    }
+    if (status || !owner->allocation_count || !block->record.charge.held) {
+        return status ? status : -ESTALE;
+    }
+    *link = block->record.next;
+    owner->allocation_count--;
+    ledger->retired_charge = block->record.charge;
+    ledger->freed_alias = *payload;
+    g_free(block);
+    *payload = NULL;
+    status = qmp_allocation_retirement_retry(ledger);
+    if (status) {
+        if (!owner->post_status) {
+            owner->post_status = status;
+        }
+        if (!owner->persistent && !owner->issuer_retained && !owner->borrow.held &&
+            !owner->allocation_count && !owner->blocks) {
+            /* The free already happened. Retain the real owner body for its
+             * separate last-free retirement after the current journal clears. */
+            ledger->reclaim_owner = owner;
+        }
+        return status;
+    }
+    return qmp_allocation_owner_release(ledger, owner);
+}
+
+int qemu_crucible_qmp_free(void **payload)
+{
+    QemuCrucibleQmpAllocationLedger *ledger = &startup_source.qmp_allocations;
+    QemuCrucibleQmpAllocationOwner *owner;
+    QemuCrucibleQmpAllocationBlock **link;
+    int status;
+
+    if (!payload || !*payload) {
+        return -EINVAL;
+    }
+    if (!qmp_allocation_enter(ledger)) {
+        return -EAGAIN;
+    }
+    link = qmp_allocation_find_block(ledger, *payload, &owner);
+    status = link ? qmp_allocation_free_locked(ledger, owner, link, payload) : -ENOENT;
+    qmp_allocation_leave(ledger);
+    return status;
+}
+
+int qemu_crucible_qmp_reallocate(QemuCrucibleQmpAllocationOwner *candidate,
+                                void **payload, size_t bytes)
+{
+    QemuCrucibleQmpAllocationLedger *ledger = &startup_source.qmp_allocations;
+    QemuCrucibleQmpAllocationOwner *owner;
+    QemuCrucibleQmpAllocationOwner *found_owner;
+    QemuCrucibleQmpAllocationBlock **link;
+    QemuCrucibleQmpAllocationBlock *old;
+    void *replacement = NULL;
+    void *previous;
+    int status;
+
+    if (!payload || !bytes) {
+        return -EINVAL;
+    }
+    if (!*payload) {
+        return qemu_crucible_qmp_allocate(candidate, bytes, false, payload);
+    }
+    if (!qmp_allocation_enter(ledger)) {
+        return -EAGAIN;
+    }
+    owner = qmp_allocation_find_owner(ledger, candidate);
+    link = qmp_allocation_find_block(ledger, *payload, &found_owner);
+    if (!owner || !link || found_owner != owner) {
+        status = -EPERM;
+        goto done;
+    }
+    old = *link;
+    if (qatomic_load_acquire(&old->record.visitor_pin) ||
+        qatomic_load_acquire(&old->record.mutation) ||
+        qatomic_load_acquire(&old->record.cleanup_retained)) {
+        status = -EBUSY;
+        goto done;
+    }
+    status = qmp_allocation_allocate_locked(ledger, owner, bytes, false, &replacement);
+    if (status) {
+        /* Failed post leaves any replacement in the actual registered owner.
+         * The old caller alias remains current and is not physically freed. */
+        goto done;
+    }
+    memcpy(replacement, *payload, MIN(bytes, old->record.payload_bytes));
+    previous = *payload;
+    /* Allocation prepended to the same list; locate the still real old block. */
+    link = qmp_allocation_find_block(ledger, previous, &found_owner);
+    status = qmp_allocation_free_locked(ledger, owner, link, &previous);
+    if (!previous) {
+        *payload = replacement;
+    }
+
+done:
+    qmp_allocation_leave(ledger);
+    return status;
+}
+
+int qemu_crucible_qmp_owner_end(QemuCrucibleQmpAllocationOwner **candidate)
+{
+    QemuCrucibleQmpAllocationLedger *ledger = &startup_source.qmp_allocations;
+    QemuCrucibleQmpAllocationOwner *owner;
+    int status;
+
+    if (!candidate || !*candidate) {
+        return -EINVAL;
+    }
+    if (!qmp_allocation_enter(ledger)) {
+        return -EAGAIN;
+    }
+    owner = qmp_allocation_find_owner(ledger, *candidate);
+    status = owner ? qmp_allocation_identity(owner) : -EPERM;
+    if (!status && (qatomic_load_acquire(&owner->parser_scope.held) || qatomic_load_acquire(&owner->dispatch_scope.held))) {
+        /* Preserve the actual issuer while its existing context still borrows
+         * allocations. Consuming it here would split mutation/admission rules. */
+        status = -EBUSY;
+    }
+    if (!status) {
+        for (QemuCrucibleQmpAllocationBlock *block = owner->blocks;
+             block; block = block->record.next) {
+            if (qatomic_load_acquire(&block->record.visitor_pin) ||
+                qatomic_load_acquire(&block->record.mutation) ||
+                qatomic_load_acquire(&block->record.cleanup_retained)) {
+                status = -EBUSY;
+                break;
+            }
+        }
+    }
+    if (!status) {
+        status = qmp_allocation_retirement_retry(ledger);
+    }
+    if (!status && !owner->issuer_retained) {
+        status = -EALREADY;
+    }
+    if (!status) {
+        owner->issuer_retained = false;
+        *candidate = NULL;
+        status = qmp_allocation_owner_release(ledger, owner);
+    }
+    qmp_allocation_leave(ledger);
+    return status;
+}
+
+int qemu_crucible_qmp_owner_borrow(QemuCrucibleQmpAllocationOwner *candidate,
+                                  QemuCrucibleQmpAllocationBorrow **out)
+{
+    QemuCrucibleQmpAllocationLedger *ledger = &startup_source.qmp_allocations;
+    QemuCrucibleQmpAllocationOwner *owner;
+    int status;
+
+    if (!out) {
+        return -EINVAL;
+    }
+    *out = NULL;
+    if (!qmp_allocation_enter(ledger)) {
+        return -EAGAIN;
+    }
+    owner = qmp_allocation_find_owner(ledger, candidate);
+    status = owner ? qmp_allocation_live(ledger, owner) : -EPERM;
+    if (!status && (owner->persistent || !owner->issuer_retained || owner->borrow.held)) {
+        status = -EPERM;
+    }
+    if (!status) {
+        owner->borrow = (QemuCrucibleQmpAllocationBorrow) { owner, true };
+        *out = &owner->borrow;
+        status = qmp_allocation_post(ledger, owner, 0);
+    }
+    qmp_allocation_leave(ledger);
+    return status;
+}
+
+static QemuCrucibleQmpAllocationOwner *qmp_allocation_find_borrow(
+    QemuCrucibleQmpAllocationLedger *ledger,
+    QemuCrucibleQmpAllocationBorrow *candidate)
+{
+    for (QemuCrucibleQmpAllocationOwner *owner = ledger->owners;
+         owner; owner = owner->next) {
+        if (&owner->borrow == candidate && owner->borrow.owner == owner &&
+            owner->borrow.held && !owner->persistent) {
+            return owner;
+        }
+    }
+    return NULL;
+}
+
+int qemu_crucible_qmp_borrow_observe(QemuCrucibleQmpAllocationBorrow *candidate,
+                                    QemuCrucibleQmpAllocationObservation *out)
+{
+    QemuCrucibleQmpAllocationLedger *ledger = &startup_source.qmp_allocations;
+    QemuCrucibleQmpAllocationOwner *owner;
+    int status;
+
+    if (!out) {
+        return -EINVAL;
+    }
+    if (!qmp_allocation_enter(ledger)) {
+        return -EAGAIN;
+    }
+    owner = qmp_allocation_find_borrow(ledger, candidate);
+    status = owner ? qmp_allocation_live(ledger, owner) : -EPERM;
+    if (!status) {
+        *out = (QemuCrucibleQmpAllocationObservation) {
+            .monitor = owner->monitor,
+            .monitor_purpose = owner->monitor_purpose,
+            .process_purpose = owner->process_purpose,
+            .process_generation = owner->process_generation,
+            .connection_epoch = owner->connection_epoch,
+        };
+    }
+    qmp_allocation_leave(ledger);
+    return status;
+}
+
+int qemu_crucible_qmp_borrow_end(QemuCrucibleQmpAllocationBorrow **candidate)
+{
+    QemuCrucibleQmpAllocationLedger *ledger = &startup_source.qmp_allocations;
+    QemuCrucibleQmpAllocationOwner *owner;
+    QemuCrucibleQmpAllocationOwner **link = &ledger->owners;
+    int status;
+
+    if (!candidate || !*candidate) {
+        return -EINVAL;
+    }
+    if (!qmp_allocation_enter(ledger)) {
+        return -EAGAIN;
+    }
+    if (*candidate == &ledger->cleanup_borrow && ledger->cleanup_borrow.held) {
+        /* The loan moved here only after freeing its exact owner body. Never
+         * dereference the old owner alias or clear this loan on failed post. */
+        status = qmp_allocation_monitor_identity(startup_source.monitor_purpose.allocation);
+        if (!status) {
+            status = qmp_allocation_retirement_retry(ledger);
+        }
+        if (!status) {
+            ledger->cleanup_borrow = (QemuCrucibleQmpAllocationBorrow) { 0 };
+            *candidate = NULL;
+        }
+        goto done;
+    }
+    owner = qmp_allocation_find_borrow(ledger, *candidate);
+    status = owner ? qmp_allocation_identity(owner) : -EPERM;
+    if (!status) {
+        status = qmp_allocation_retirement_retry(ledger);
+    }
+    if (!status && (owner->issuer_retained || owner->blocks || owner->allocation_count ||
+                    qatomic_load_acquire(&owner->parser_scope.held) || qatomic_load_acquire(&owner->dispatch_scope.held))) {
+        status = -EINPROGRESS;
+    }
+    if (!status && ledger->cleanup_borrow.held) {
+        status = -EINPROGRESS;
+    }
+    if (!status) {
+        while (*link && *link != owner) {
+            link = &(*link)->next;
+        }
+        if (*link != owner || !owner->charge.held) {
+            status = -ESTALE;
+        }
+    }
+    if (!status) {
+        /* Transfer the genuine physical return to paid Source storage before
+         * the embedded borrow can disappear with its actual owner allocation. */
+        ledger->cleanup_borrow = (QemuCrucibleQmpAllocationBorrow) { owner, true };
+        *candidate = &ledger->cleanup_borrow;
+        owner->borrow.held = false;
+        /* owner_release excludes unrelated cleanup loans. This is the same
+         * loan's exact last-free cut, so perform the physical unlink here. */
+        *link = owner->next;
+        ledger->retired_charge = owner->charge;
+        ledger->freed_alias = owner;
+        g_free(owner);
+        status = qmp_allocation_retirement_retry(ledger);
+        if (!status) {
+            ledger->cleanup_borrow = (QemuCrucibleQmpAllocationBorrow) { 0 };
+            *candidate = NULL;
+        }
+    }
+
+done:
+    qmp_allocation_leave(ledger);
+    return status;
+}
+
+int qemu_crucible_qmp_output_status(Monitor *monitor)
+{
+    int status;
+
+    if (!qatomic_load_acquire(&qemu_crucible_selected_process_id)) {
+        return 0;
+    }
+    status = qmp_allocation_monitor_identity(monitor);
+    return status ? status : qatomic_read(&startup_source.monitor_purpose.output_status);
+}
+
+int qemu_crucible_qmp_output_refuse(Monitor *monitor, int cause)
+{
+    int status = qmp_allocation_monitor_identity(monitor);
+
+    if (status) {
+        return status;
+    }
+    if (cause >= 0) {
+        return -EINVAL;
+    }
+    qatomic_cmpxchg(&startup_source.monitor_purpose.output_status, 0, cause);
+    return qatomic_read(&startup_source.monitor_purpose.output_status);
+}
diff --git a/plugins/crucible-qmp-object.inc.h b/plugins/crucible-qmp-object.inc.h
new file mode 100644
index 0000000000000000000000000000000000000000..c1795d31f7eb9c2850e781c873e8227512c1b2e0
--- /dev/null
+++ b/plugins/crucible-qmp-object.inc.h
@@ -0,0 +1,190 @@
+/*
+ * Exact compiled QObject requests in the actual Source allocation scope
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qobject/qdict.h"
+#include "qobject/qlist.h"
+#include "qobject/qnum.h"
+#include "qobject/qbool.h"
+#include "qobject/qstring.h"
+
+static size_t qmp_object_extent(unsigned kind)
+{
+    switch (kind) {
+    case QTYPE_QDICT:
+        return sizeof(QDict);
+    case QTYPE_QLIST:
+        return sizeof(QList);
+    case QTYPE_QNUM:
+        return sizeof(QNum);
+    case QTYPE_QBOOL:
+        return sizeof(QBool);
+    case QTYPE_QSTRING:
+        return sizeof(QString);
+    default:
+        return 0;
+    }
+}
+
+int qemu_crucible_qmp_object_allocate(unsigned kind, void **out)
+{
+    QemuCrucibleQmpAllocationLedger *ledger = &startup_source.qmp_allocations;
+    QemuCrucibleQmpAllocationOwner *owner;
+    QemuCrucibleQmpAllocationOwner *found;
+    QemuCrucibleQmpAllocationBlock **block;
+    size_t extent = qmp_object_extent(kind);
+    int status;
+
+    if (!out || !extent) {
+        return -EINVAL;
+    }
+    *out = NULL;
+    status = qemu_crucible_qmp_scope_identity_current(&owner);
+    if (status) {
+        return status;
+    }
+    if (!qmp_allocation_enter(ledger)) {
+        return -EAGAIN;
+    }
+    /* Actual admission checks the full envelope and pays exact compiled body
+     * plus private header. Kind records physical cleanup provenance only. */
+    status = qmp_allocation_allocate_locked(ledger, owner, extent, true, out);
+    if (*out) {
+        block = qmp_allocation_find_block(ledger, *out, &found);
+        assert(block && found == owner);
+        (*block)->record.object_kind = kind;
+    }
+    qmp_allocation_leave(ledger);
+    return status;
+}
+
+int qemu_crucible_qmp_allocation_observe(const void *payload,
+                                        QemuCrucibleQmpAllocationOwner **out,
+                                        size_t *extent)
+{
+    QemuCrucibleQmpAllocationLedger *ledger = &startup_source.qmp_allocations;
+    QemuCrucibleQmpAllocationOwner *owner;
+    QemuCrucibleQmpAllocationBlock **block;
+    int status;
+
+    if (!payload || !out || !extent) {
+        return -EINVAL;
+    }
+    *out = NULL;
+    *extent = 0;
+    if (!qatomic_load_acquire(&qemu_crucible_selected_process_id)) {
+        return -ENOENT;
+    }
+    if (!qmp_allocation_enter(ledger)) {
+        return -EAGAIN;
+    }
+    block = qmp_allocation_find_block(ledger, (void *)payload, &owner);
+    status = block ? qmp_allocation_identity(owner) : -ENOENT;
+    if (!status && (!(*block)->record.charge.held || (*block)->record.owner != owner)) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        *out = owner;
+        *extent = (*block)->record.payload_bytes;
+    }
+    qmp_allocation_leave(ledger);
+    return status;
+}
+
+int qemu_crucible_qmp_object_observe(const void *payload, unsigned *kind,
+                                    QemuCrucibleQmpAllocationOwner **out)
+{
+    QemuCrucibleQmpAllocationLedger *ledger = &startup_source.qmp_allocations;
+    QemuCrucibleQmpAllocationOwner *owner;
+    QemuCrucibleQmpAllocationBlock **block;
+    int status;
+
+    if (!payload || !kind || !out) {
+        return -EINVAL;
+    }
+    *kind = 0;
+    *out = NULL;
+    if (!qmp_allocation_enter(ledger)) {
+        return -EAGAIN;
+    }
+    /* Lookup precedes any header or object access, including unknown generic
+     * pointers. Generic fallback is allowed only on definite ENOENT. */
+    block = qmp_allocation_find_block(ledger, (void *)payload, &owner);
+    status = block ? qmp_allocation_identity(owner) : -ENOENT;
+    if (!status && (!(*block)->record.charge.held ||
+                    !qmp_object_extent((*block)->record.object_kind) ||
+                    (*block)->record.payload_bytes !=
+                        qmp_object_extent((*block)->record.object_kind))) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        *out = owner;
+        *kind = (*block)->record.object_kind;
+    }
+    qmp_allocation_leave(ledger);
+    return status;
+}
+
+int qemu_crucible_qmp_json_writer_allocate(void **out)
+{
+    QemuCrucibleQmpAllocationLedger *ledger = &startup_source.qmp_allocations;
+    QemuCrucibleQmpAllocationOwner *owner;
+    QemuCrucibleQmpAllocationOwner *found;
+    QemuCrucibleQmpAllocationBlock **block;
+    size_t extent = qemu_crucible_json_writer_storage_bytes_v1();
+    int status;
+
+    if (!out || !extent) {
+        return -EINVAL;
+    }
+    *out = NULL;
+    status = qemu_crucible_qmp_scope_identity_current(&owner);
+    if (status) {
+        return status;
+    }
+    if (!qmp_allocation_enter(ledger)) {
+        return -EAGAIN;
+    }
+    status = qmp_allocation_allocate_locked(ledger, owner, extent, true, out);
+    if (*out) {
+        block = qmp_allocation_find_block(ledger, *out, &found);
+        assert(block && found == owner);
+        (*block)->record.json_writer = true;
+    }
+    qmp_allocation_leave(ledger);
+    return status;
+}
+
+int qemu_crucible_qmp_json_writer_observe(
+    const void *payload, QemuCrucibleQmpAllocationOwner **out)
+{
+    QemuCrucibleQmpAllocationLedger *ledger = &startup_source.qmp_allocations;
+    QemuCrucibleQmpAllocationOwner *owner;
+    QemuCrucibleQmpAllocationBlock **block;
+    int status;
+
+    if (!payload || !out) {
+        return -EINVAL;
+    }
+    *out = NULL;
+    if (!qatomic_load_acquire(&qemu_crucible_selected_process_id)) {
+        return -ENOENT;
+    }
+    if (!qmp_allocation_enter(ledger)) {
+        return -EAGAIN;
+    }
+    /* The compiled constructor's marker is checked before any writer field. */
+    block = qmp_allocation_find_block(ledger, (void *)payload, &owner);
+    status = block ? qmp_allocation_identity(owner) : -ENOENT;
+    if (!status && (!(*block)->record.json_writer ||
+                    !(*block)->record.charge.held ||
+                    (*block)->record.payload_bytes !=
+                        qemu_crucible_json_writer_storage_bytes_v1())) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        *out = owner;
+    }
+    qmp_allocation_leave(ledger);
+    return status;
+}
diff --git a/plugins/crucible-qmp-scope.inc.h b/plugins/crucible-qmp-scope.inc.h
new file mode 100644
index 0000000000000000000000000000000000000000..65c1f2cf3761c0609581b5e2ef53c32c15c49a5d
--- /dev/null
+++ b/plugins/crucible-qmp-scope.inc.h
@@ -0,0 +1,240 @@
+/*
+ * Source-issued parser/request allocation scopes across actual dispatch contexts
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+static __thread QemuCrucibleQmpAllocationScope *qmp_allocation_scope;
+
+static Coroutine *qmp_scope_coroutine(void)
+{
+    return qemu_in_coroutine() ? qemu_coroutine_self() : NULL;
+}
+
+static QemuCrucibleQmpAllocationOwner *qmp_scope_find(
+    QemuCrucibleQmpAllocationLedger *ledger,
+    QemuCrucibleQmpAllocationScope *candidate)
+{
+    for (QemuCrucibleQmpAllocationOwner *owner = ledger->owners;
+         owner; owner = owner->next) {
+        if ((candidate == &owner->parser_scope || candidate == &owner->dispatch_scope) &&
+            qatomic_load_acquire(&candidate->held) && candidate->owner == owner &&
+            candidate->process == getpid() && qemu_thread_is_self(&candidate->thread) &&
+            candidate->coroutine == qmp_scope_coroutine()) {
+            return owner;
+        }
+    }
+    return NULL;
+}
+
+static int qmp_scope_publish(QemuCrucibleQmpAllocationLedger *ledger,
+                             QemuCrucibleQmpAllocationOwner *owner,
+                             QemuCrucibleQmpAllocationBorrow *borrow,
+                             QemuCrucibleQmpAllocationScope *scope,
+                             QemuCrucibleQmpAllocationScope **out)
+{
+    int status = qmp_allocation_live(ledger, owner);
+
+    if (status) {
+        return status;
+    }
+    if (owner->first_status || qatomic_load_acquire(&scope->held) || ledger->cleanup_borrow.held ||
+        (borrow && (borrow != &owner->borrow || !borrow->held)) ||
+        (!borrow && (!owner->issuer_retained || owner->persistent))) {
+        return owner->first_status ? owner->first_status : -EPERM;
+    }
+    if (qmp_allocation_scope && !qmp_scope_find(ledger, qmp_allocation_scope)) {
+        return -ESTALE;
+    }
+    *scope = (QemuCrucibleQmpAllocationScope) {
+        .owner = owner,
+        .borrow = borrow,
+        .previous = qmp_allocation_scope,
+        .coroutine = qmp_scope_coroutine(),
+        .process = getpid(),
+    };
+    qemu_thread_get_self(&scope->thread);
+    qatomic_store_release(&scope->held, true);
+    qmp_allocation_scope = scope;
+    *out = scope;
+    /* Post failure retains this exact context loan; caller must end it before
+     * yield, while recording the actual failure and preserving physical owner. */
+    return qmp_allocation_post(ledger, owner, 0);
+}
+
+int qemu_crucible_qmp_parser_scope_enter(QemuCrucibleQmpAllocationOwner *candidate,
+                                        QemuCrucibleQmpAllocationScope **out)
+{
+    QemuCrucibleQmpAllocationLedger *ledger = &startup_source.qmp_allocations;
+    QemuCrucibleQmpAllocationOwner *owner;
+    Monitor *monitor;
+    int status;
+
+    if (!out) {
+        return -EINVAL;
+    }
+    *out = NULL;
+    if (!qmp_allocation_enter(ledger)) {
+        return -EAGAIN;
+    }
+    owner = qmp_allocation_find_owner(ledger, candidate);
+    status = owner ? qmp_allocation_identity(owner) : -EPERM;
+    if (!status && (!owner->issuer_retained || owner->persistent)) {
+        status = -EPERM;
+    }
+    monitor = !status ? owner->monitor : NULL;
+    qmp_allocation_leave(ledger);
+    if (status) {
+        return status;
+    }
+    /* This is an actual Monitor identity callee, not a Rust/module callback or
+     * a pointer setter. It runs outside the allocator cut and takes no debit. */
+    status = monitor_qmp_allocation_parser_current(monitor, candidate);
+    if (status) {
+        return status;
+    }
+    if (!qmp_allocation_enter(ledger)) {
+        return -EAGAIN;
+    }
+    owner = qmp_allocation_find_owner(ledger, candidate);
+    status = owner ? qmp_scope_publish(ledger, owner, NULL, &owner->parser_scope, out) :
+                     -ESTALE;
+    qmp_allocation_leave(ledger);
+    return status;
+}
+
+int qemu_crucible_qmp_dispatch_scope_enter(QemuCrucibleQmpAllocationBorrow *candidate,
+                                          QemuCrucibleQmpAllocationScope **out)
+{
+    QemuCrucibleQmpAllocationLedger *ledger = &startup_source.qmp_allocations;
+    QemuCrucibleQmpAllocationOwner *owner;
+    Monitor *monitor;
+    int status;
+
+    if (!out) {
+        return -EINVAL;
+    }
+    *out = NULL;
+    if (!qmp_allocation_enter(ledger)) {
+        return -EAGAIN;
+    }
+    owner = qmp_allocation_find_borrow(ledger, candidate);
+    status = owner ? qmp_allocation_identity(owner) : -EPERM;
+    monitor = !status ? owner->monitor : NULL;
+    qmp_allocation_leave(ledger);
+    if (status) {
+        return status;
+    }
+    status = monitor_qmp_allocation_dispatch_current(monitor, candidate);
+    if (status) {
+        return status;
+    }
+    if (!qmp_allocation_enter(ledger)) {
+        return -EAGAIN;
+    }
+    owner = qmp_allocation_find_borrow(ledger, candidate);
+    status = owner ? qmp_scope_publish(ledger, owner, candidate,
+                                      &owner->dispatch_scope, out) : -ESTALE;
+    qmp_allocation_leave(ledger);
+    return status;
+}
+
+int qemu_crucible_qmp_scope_current(QemuCrucibleQmpAllocationOwner **out)
+{
+    QemuCrucibleQmpAllocationLedger *ledger = &startup_source.qmp_allocations;
+    QemuCrucibleQmpAllocationOwner *owner;
+    int status;
+
+    if (!out) {
+        return -EINVAL;
+    }
+    *out = NULL;
+    if (!qmp_allocation_enter(ledger)) {
+        return -EAGAIN;
+    }
+    owner = qmp_scope_find(ledger, qmp_allocation_scope);
+    status = owner ? qmp_allocation_live(ledger, owner) : -ENOKEY;
+    if (!status && owner->first_status) {
+        status = owner->first_status;
+    }
+    if (!status) {
+        *out = owner;
+    }
+    qmp_allocation_leave(ledger);
+    return status;
+}
+
+int qemu_crucible_qmp_scope_end(QemuCrucibleQmpAllocationScope **candidate)
+{
+    QemuCrucibleQmpAllocationOwner *owner;
+    QemuCrucibleQmpAllocationScope *scope;
+    int status;
+
+    if (!candidate || !*candidate) {
+        return -EINVAL;
+    }
+    scope = *candidate;
+    /* Only a genuine Source publication installs this private TLS pointer.
+     * Matching it precedes any access through a caller-supplied pointer. */
+    if (scope != qmp_allocation_scope || !qatomic_load_acquire(&scope->held)) {
+        return -EPERM;
+    }
+    owner = scope->owner;
+    if (!owner || (scope != &owner->parser_scope && scope != &owner->dispatch_scope) ||
+        scope->process != getpid() || !qemu_thread_is_self(&scope->thread) ||
+        scope->coroutine != qmp_scope_coroutine() ||
+        (scope->borrow && (scope->borrow != &owner->borrow || !owner->borrow.held)) ||
+        (!scope->borrow && !owner->issuer_retained)) {
+        return -EPERM;
+    }
+    status = qmp_allocation_identity(owner);
+    if (status) {
+        return status;
+    }
+    if (scope->previous &&
+        (!qatomic_load_acquire(&scope->previous->held) ||
+         scope->previous->process != getpid() ||
+         !qemu_thread_is_self(&scope->previous->thread) ||
+         scope->previous->coroutine != qmp_scope_coroutine())) {
+        return -ESTALE;
+    }
+    /* Issuer/borrow return observes held atomically and cannot free this owner.
+     * Preserve immutable coordinates until a later genuine ledger publication;
+     * no owner-free, kernel observation, callback or cleanup wait belongs here. */
+    qmp_allocation_scope = scope->previous;
+    *candidate = NULL;
+    qatomic_store_release(&scope->held, false);
+    return 0;
+}
+
+int qemu_crucible_qmp_scope_identity_current(QemuCrucibleQmpAllocationOwner **out)
+{
+    QemuCrucibleQmpAllocationScope *scope = qmp_allocation_scope;
+    QemuCrucibleQmpAllocationOwner *owner;
+    int status;
+
+    if (!out) {
+        return -EINVAL;
+    }
+    *out = NULL;
+    /* Native TLS is populated only by the genuine Source constructor. Its
+     * protected issuer/borrow keeps these exact addresses alive until end. */
+    if (!scope || !qatomic_load_acquire(&scope->held) ||
+        scope->process != getpid() || !qemu_thread_is_self(&scope->thread) ||
+        scope->coroutine != qmp_scope_coroutine()) {
+        return -ENOKEY;
+    }
+    owner = scope->owner;
+    if (!owner || (scope != &owner->parser_scope && scope != &owner->dispatch_scope) ||
+        (scope->borrow && (scope->borrow != &owner->borrow || !owner->borrow.held)) ||
+        (!scope->borrow && !owner->issuer_retained)) {
+        return -EPERM;
+    }
+    status = qmp_allocation_identity(owner);
+    if (!status && owner->first_status) {
+        status = owner->first_status;
+    }
+    if (!status) {
+        *out = owner;
+    }
+    return status;
+}
diff --git a/plugins/crucible-qmp-string.inc.h b/plugins/crucible-qmp-string.inc.h
new file mode 100644
index 0000000000000000000000000000000000000000..737a8606130ae3b73295f151ca20827b98cbcb41
--- /dev/null
+++ b/plugins/crucible-qmp-string.inc.h
@@ -0,0 +1,736 @@
+/*
+ * Explicit selected QMP string capacity and actual last-free custody
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+struct QmpControlledString {
+    GString value;
+    QemuCrucibleQmpAllocationOwner *owner;
+    QemuCrucibleQmpStringMutation mutation;
+    /* Exact sizeof-paid observation stays with the body on once-close
+     * uncertainty, independently of returned synchronous mutation context. */
+    QemuCrucibleProcessContractObservation end_observation;
+    uint64_t end_descriptor_limit;
+    int end_post_status;
+    int first_status;
+    bool closing;
+};
+
+static __thread QemuCrucibleQmpStringMutation *qmp_string_mutation;
+
+static Coroutine *qmp_string_coroutine(void)
+{
+    return qemu_in_coroutine() ? qemu_coroutine_self() : NULL;
+}
+
+/* Source publication and real record pins keep these exact addresses live.
+ * This is not an exemption inferred from a parser/request TLS payer. */
+static int qmp_string_mutation_check(QemuCrucibleQmpStringMutation *loan,
+                                     bool cleanup)
+{
+    QmpControlledString *string;
+    QemuCrucibleQmpAllocationOwner *owner;
+    QemuCrucibleMonitorPurpose *monitor = &startup_source.monitor_purpose;
+    int status;
+
+    if (!loan || loan != qmp_string_mutation || !loan->held ||
+        loan->process != startup_source.owner_process ||
+        !qemu_thread_is_self(&loan->thread) ||
+        loan->coroutine != qmp_string_coroutine()) {
+        return -EPERM;
+    }
+    string = loan->string;
+    if (!string || loan != &string->mutation || !loan->body || !loan->buffer ||
+        qatomic_load_acquire(&loan->body->record.mutation) != loan ||
+        qatomic_load_acquire(&loan->buffer->record.mutation) != loan ||
+        !loan->body->record.controlled_string ||
+        loan->body->record.payload_bytes != sizeof(*string) ||
+        !loan->body->record.charge.held || !loan->buffer->record.charge.held ||
+        loan->body->record.owner != string->owner ||
+        loan->buffer->record.owner != string->owner ||
+        (void *)(loan->body + 1) != string ||
+        (void *)(loan->buffer + 1) != string->value.str ||
+        loan->buffer->record.payload_bytes != string->value.allocated_len ||
+        string->value.len >= string->value.allocated_len) {
+        return -ESTALE;
+    }
+    /* Scope entry/final post corroborate actual pid and kernel contract.
+     * Selected process birth is refused before effects; this synchronous loan
+     * cannot cross fork/exec/yield. Retained private identities need no syscall
+     * or full registry scan for each byte inside the same pinned extent. */
+    owner = string->owner;
+    status = qatomic_load_acquire(&startup_source.process_purpose_complete) &&
+        qatomic_load_acquire(&startup_source.custody_retained) &&
+        monitor->bound && !monitor->construction_uncertain &&
+        monitor->fixed_charge.held && owner->born &&
+        owner->monitor == monitor->allocation && owner->monitor_purpose == monitor &&
+        owner->process_purpose == startup_source.preexec_purpose_owner &&
+        owner->process_generation == startup_source.original.process_generation &&
+        (owner->persistent || owner->charge.held) ? 0 : -ESTALE;
+    if (!status && !cleanup) {
+        status = string->first_status ? string->first_status :
+            string->owner->first_status ? string->owner->first_status :
+            qatomic_read(&startup_source.monitor_purpose.output_status);
+        if (!status && string->closing) {
+            status = -EPERM;
+        }
+    }
+    return status;
+}
+
+static int qmp_string_current(GString *candidate, bool cleanup,
+                              QmpControlledString **out)
+{
+    QemuCrucibleQmpAllocationLedger *ledger = &startup_source.qmp_allocations;
+    QemuCrucibleQmpAllocationOwner *owner;
+    QemuCrucibleQmpAllocationBlock **link;
+    QmpControlledString *string;
+    int status;
+
+    if (!candidate || !out) {
+        return -EINVAL;
+    }
+    if (!qmp_allocation_enter(ledger)) {
+        return -EAGAIN;
+    }
+    if (qmp_string_mutation &&
+        (GString *)qmp_string_mutation->string == candidate) {
+        status = qmp_string_mutation_check(qmp_string_mutation, cleanup);
+        if (!status) {
+            *out = qmp_string_mutation->string;
+        }
+        goto done;
+    }
+    link = qmp_allocation_find_block(ledger, candidate, &owner);
+    if (!link || !(*link)->record.controlled_string ||
+        (*link)->record.payload_bytes != sizeof(*string)) {
+        status = -EPERM;
+        goto done;
+    }
+    /* Acquire the actual registry pin before any ordinary body/loan field
+     * read. End can clear context outside this cut, but publishes this pin's
+     * release only after every body write; a noncurrent helper must refuse
+     * throughout that interval, even if the ordinary held flag is now false. */
+    if (qatomic_load_acquire(&(*link)->record.mutation)) {
+        status = -EPERM;
+        goto done;
+    }
+    if (!cleanup) {
+        /* Only the exact held constructor-issued mutation loan admits effects.
+         * Unpinned registry membership is physical identity, not an effect gate. */
+        status = -EPERM;
+        goto done;
+    }
+    string = (QmpControlledString *)candidate;
+    status = qmp_allocation_identity(owner);
+    if (status || string->owner != owner || !(*link)->record.charge.held) {
+        status = status ? status : -ESTALE;
+        goto done;
+    }
+    if (!cleanup && (string->closing || string->first_status || owner->first_status)) {
+        status = string->first_status ? string->first_status :
+            owner->first_status ? owner->first_status : -EPERM;
+        goto done;
+    }
+    if (string->value.str) {
+        QemuCrucibleQmpAllocationOwner *buffer_owner;
+        QemuCrucibleQmpAllocationBlock **buffer = qmp_allocation_find_block(
+            ledger, string->value.str, &buffer_owner);
+
+        if (!buffer || buffer_owner != owner || !(*buffer)->record.charge.held ||
+            (*buffer)->record.payload_bytes != string->value.allocated_len ||
+            string->value.len >= string->value.allocated_len) {
+            status = -ESTALE;
+            goto done;
+        }
+    } else if (string->value.len || string->value.allocated_len) {
+        status = -ESTALE;
+        goto done;
+    }
+    *out = string;
+    status = 0;
+
+done:
+    qmp_allocation_leave(ledger);
+    return status;
+}
+
+static int qmp_string_failure(QmpControlledString *string, int cause)
+{
+    if (cause < 0 && !string->first_status) {
+        string->first_status = cause;
+    }
+    return cause;
+}
+
+int qemu_crucible_qmp_string_new(QemuCrucibleQmpAllocationOwner *candidate,
+                                const char *initial, size_t reserve, GString **out)
+{
+    QemuCrucibleQmpAllocationLedger *ledger = &startup_source.qmp_allocations;
+    QemuCrucibleQmpAllocationOwner *owner;
+    QemuCrucibleQmpAllocationBlock **link;
+    QmpControlledString *string = NULL;
+    void *body = NULL;
+    void *buffer = NULL;
+    size_t length = initial ? strlen(initial) : 0;
+    size_t capacity;
+    int status;
+
+    if (!out) {
+        return -EINVAL;
+    }
+    *out = NULL;
+    if (reserve == SIZE_MAX || length == SIZE_MAX) {
+        return -EOVERFLOW;
+    }
+    capacity = MAX(reserve, length) + 1;
+    if (!qmp_allocation_enter(ledger)) {
+        return -EAGAIN;
+    }
+    owner = qmp_allocation_find_owner(ledger, candidate);
+    if (!owner) {
+        status = -EPERM;
+        goto done;
+    }
+    status = qmp_allocation_allocate_locked(ledger, owner, sizeof(*string), true, &body);
+    if (!body) {
+        goto done;
+    }
+    string = body;
+    string->owner = owner;
+    string->end_observation.descriptor = -1;
+    link = qmp_allocation_find_block(ledger, body, &owner);
+    /* Only this constructor writes the registry kind. Caller bytes cannot
+     * qualify a generic allocation or nominate another string's payer. */
+    (*link)->record.controlled_string = true;
+    *out = &string->value;
+    if (status) {
+        goto done;
+    }
+    status = qmp_allocation_allocate_locked(ledger, owner, capacity, false, &buffer);
+    if (buffer) {
+        string->value.str = buffer;
+        string->value.allocated_len = capacity;
+        string->value.str[0] = 0;
+    }
+    if (!status) {
+        if (length) {
+            memcpy(string->value.str, initial, length);
+        }
+        string->value.len = length;
+        string->value.str[length] = 0;
+    }
+
+done:
+    if (string) {
+        qmp_string_failure(string, status);
+    }
+    qmp_allocation_leave(ledger);
+    return status;
+}
+
+static int qmp_string_mutation_grow(QmpControlledString *string, size_t capacity)
+{
+    QemuCrucibleQmpAllocationLedger *ledger = &startup_source.qmp_allocations;
+    QemuCrucibleQmpStringMutation *loan = &string->mutation;
+    QemuCrucibleQmpAllocationOwner *owner = string->owner;
+    QemuCrucibleQmpAllocationOwner *found_owner;
+    QemuCrucibleQmpAllocationBlock **new_link;
+    QemuCrucibleQmpAllocationBlock **old_link;
+    void *replacement = NULL;
+    void *previous = string->value.str;
+    int status;
+
+    if (!qmp_allocation_enter(ledger)) {
+        return -EAGAIN;
+    }
+    status = qmp_string_mutation_check(loan, false);
+    if (!status) {
+        /* New capacity always uses full actual admission/post and pays old+new.
+         * Intermediate in-capacity bytes borrow only the already pinned extent. */
+        status = qmp_allocation_allocate_locked(ledger, owner, capacity, false,
+                                                &replacement);
+    }
+    if (status) {
+        goto done;
+    }
+    new_link = qmp_allocation_find_block(ledger, replacement, &found_owner);
+    old_link = qmp_allocation_find_block(ledger, previous, &found_owner);
+    if (!new_link || !old_link || *old_link != loan->buffer || found_owner != owner) {
+        status = -ESTALE;
+        goto done;
+    }
+    memcpy(replacement, previous, string->value.len + 1);
+    /* Only this exact loan may return its own old pin, while the accounting
+     * cut excludes all generic frees and another mutation/context. */
+    qatomic_store_release(&loan->buffer->record.mutation, NULL);
+    status = qmp_allocation_free_locked(ledger, owner, old_link, &previous);
+    if (!previous) {
+        string->value.str = replacement;
+        string->value.allocated_len = capacity;
+        loan->buffer = *new_link;
+    }
+    qatomic_store_release(&loan->buffer->record.mutation, loan);
+
+done:
+    qmp_allocation_leave(ledger);
+    return status;
+}
+
+static int qmp_string_grow(QmpControlledString *string, size_t added)
+{
+    size_t needed;
+    size_t capacity;
+
+    if (string->value.len == SIZE_MAX || added > SIZE_MAX - string->value.len - 1) {
+        return qmp_string_failure(string, -EOVERFLOW);
+    }
+    needed = string->value.len + added + 1;
+    if (needed <= string->value.allocated_len) {
+        return 0;
+    }
+    capacity = string->value.allocated_len <= SIZE_MAX / 2 ?
+        string->value.allocated_len * 2 : needed;
+    capacity = MAX(needed, capacity);
+    return qmp_string_failure(string, qmp_string_mutation_grow(string, capacity));
+}
+
+static int qmp_string_insert(GString *candidate, const char *bytes,
+                             size_t count, bool prepend)
+{
+    QmpControlledString *string;
+    void *temporary = NULL;
+    const char *input = bytes;
+    uintptr_t begin;
+    uintptr_t address;
+    int status;
+    int cleanup = 0;
+
+    status = qmp_string_current(candidate, false, &string);
+    if (status) {
+        return status;
+    }
+    if (!bytes && count) {
+        return qmp_string_failure(string, -EINVAL);
+    }
+    /* Self-references need their own exact paid copy before realloc/memmove.
+     * This is a real temporary allocation, not an assumed stack allowance. */
+    begin = (uintptr_t)string->value.str;
+    address = (uintptr_t)bytes;
+    if (count && address >= begin && address - begin < string->value.allocated_len) {
+        size_t offset = address - begin;
+
+        if (count > string->value.allocated_len - offset) {
+            return qmp_string_failure(string, -EINVAL);
+        }
+        status = qemu_crucible_qmp_allocate(string->owner, count, false, &temporary);
+        if (!status) {
+            memcpy(temporary, bytes, count);
+            input = temporary;
+        }
+    } else {
+        status = 0;
+    }
+    if (!status) {
+        status = qmp_string_grow(string, count);
+    }
+    if (!status && count) {
+        if (prepend) {
+            memmove(string->value.str + count, string->value.str, string->value.len + 1);
+            memcpy(string->value.str, input, count);
+        } else {
+            memcpy(string->value.str + string->value.len, input, count);
+        }
+        string->value.len += count;
+        string->value.str[string->value.len] = 0;
+    }
+    if (temporary) {
+        cleanup = qemu_crucible_qmp_free(&temporary);
+    }
+    return qmp_string_failure(string, status ? status : cleanup);
+}
+
+int qemu_crucible_qmp_string_append(GString *string, const char *bytes, size_t count)
+{
+    return qmp_string_insert(string, bytes, count, false);
+}
+
+int qemu_crucible_qmp_string_prepend(GString *string, const char *bytes, size_t count)
+{
+    return qmp_string_insert(string, bytes, count, true);
+}
+
+int qemu_crucible_qmp_string_append_c(GString *string, char byte)
+{
+    return qemu_crucible_qmp_string_append(string, &byte, 1);
+}
+
+int qemu_crucible_qmp_string_truncate(GString *candidate, size_t length)
+{
+    QmpControlledString *string;
+    int status = qmp_string_current(candidate, false, &string);
+
+    if (status) {
+        return status;
+    }
+    if (length < string->value.len) {
+        string->value.len = length;
+        string->value.str[length] = 0;
+    }
+    return 0;
+}
+
+int qemu_crucible_qmp_string_erase(GString *candidate, size_t offset, gssize length)
+{
+    QmpControlledString *string;
+    size_t count;
+    int status = qmp_string_current(candidate, false, &string);
+
+    if (status) {
+        return status;
+    }
+    if (offset > string->value.len || length < -1) {
+        return qmp_string_failure(string, -EINVAL);
+    }
+    count = length < 0 ? string->value.len - offset : (size_t)length;
+    count = MIN(count, string->value.len - offset);
+    memmove(string->value.str + offset, string->value.str + offset + count,
+            string->value.len - offset - count + 1);
+    string->value.len -= count;
+    return 0;
+}
+
+int qemu_crucible_qmp_string_free(GString **candidate, char **segment)
+{
+    QmpControlledString *string;
+    void *body;
+    void *buffer;
+    int status;
+
+    if (!candidate || !*candidate) {
+        return -EINVAL;
+    }
+    status = qmp_string_current(*candidate, true, &string);
+    if (status) {
+        return status;
+    }
+    /* Returning storage cannot invalidate the body/buffer coordinates pinned
+     * by an outstanding mutation. Refuse before publishing an escaped segment
+     * or changing any string field; the same loan can still end normally. */
+    if (string->mutation.held || string->end_observation.descriptor >= 0 ||
+        string->end_observation.close_uncertain) {
+        return -EBUSY;
+    }
+    /* Claim closing under the same registry cut that admits begin. An owned
+     * serialized destructor may release that cut afterward: begin sees closing
+     * before buffer/loan access, and no unpinned effect path is admitted. */
+    {
+        QemuCrucibleQmpAllocationLedger *ledger = &startup_source.qmp_allocations;
+        QemuCrucibleQmpAllocationOwner *owner;
+        QemuCrucibleQmpAllocationBlock **block;
+
+        if (!qmp_allocation_enter(ledger)) {
+            return -EAGAIN;
+        }
+        block = qmp_allocation_find_block(ledger, string, &owner);
+        if (!block || qatomic_load_acquire(&(*block)->record.mutation) ||
+            qatomic_load_acquire(&(*block)->record.cleanup_retained)) {
+            qmp_allocation_leave(ledger);
+            return -EBUSY;
+        }
+        string->closing = true;
+        qmp_allocation_leave(ledger);
+    }
+    if (segment) {
+        *segment = string->value.str;
+        string->value.str = NULL;
+        string->value.len = string->value.allocated_len = 0;
+    } else if (string->value.str) {
+        buffer = string->value.str;
+        status = qemu_crucible_qmp_free(&buffer);
+        if (!buffer) {
+            string->value.str = NULL;
+            string->value.len = string->value.allocated_len = 0;
+        }
+        if (status) {
+            return qmp_string_failure(string, status);
+        }
+    }
+    body = string;
+    status = qemu_crucible_qmp_free(&body);
+    if (!body) {
+        *candidate = NULL;
+    }
+    return status;
+}
+
+int qemu_crucible_qmp_string_observe(GString *candidate, size_t *length,
+                                     size_t *capacity)
+{
+    QmpControlledString *string;
+    int status;
+
+    if (!length || !capacity) {
+        return -EINVAL;
+    }
+    *length = *capacity = 0;
+    status = qmp_string_current(candidate, true, &string);
+    if (!status) {
+        *length = string->value.len;
+        *capacity = string->value.allocated_len;
+    }
+    return status;
+}
+
+int qemu_crucible_qmp_format_bytes(QemuCrucibleQmpAllocationOwner *owner,
+                                  const char *format, va_list arguments,
+                                  char **out, size_t *written)
+{
+    va_list copy;
+    void *payload = NULL;
+    int saved_errno = errno;
+    int required;
+    int actual;
+    int status;
+
+    if (!format || !out || !written) {
+        return -EINVAL;
+    }
+    *out = NULL;
+    *written = 0;
+    status = qemu_crucible_qmp_owner_current(owner);
+    if (status) {
+        return status;
+    }
+    va_copy(copy, arguments);
+    required = vsnprintf(NULL, 0, format, copy);
+    va_end(copy);
+    if (required < 0) {
+        errno = saved_errno;
+        return -EILSEQ;
+    }
+    status = qemu_crucible_qmp_allocate(owner, (size_t)required + 1, false, &payload);
+    *out = payload;
+    if (!status) {
+        errno = saved_errno;
+        va_copy(copy, arguments);
+        actual = vsnprintf(payload, (size_t)required + 1, format, copy);
+        va_end(copy);
+        if (actual != required) {
+            status = -EPROTO;
+        } else {
+            *written = actual;
+        }
+    }
+    errno = saved_errno;
+    return status;
+}
+
+int qemu_crucible_qmp_format(QemuCrucibleQmpAllocationOwner *owner,
+                            const char *format, va_list arguments, char **out)
+{
+    size_t written;
+
+    return qemu_crucible_qmp_format_bytes(owner, format, arguments, out, &written);
+}
+
+int qemu_crucible_qmp_string_append_vprintf(GString *candidate, const char *format,
+                                           va_list arguments)
+{
+    QmpControlledString *string;
+    char *formatted = NULL;
+    size_t written;
+    void *payload;
+    int cleanup = 0;
+    int status = qmp_string_current(candidate, false, &string);
+
+    if (status) {
+        return status;
+    }
+    status = qemu_crucible_qmp_format_bytes(string->owner, format, arguments,
+                                          &formatted, &written);
+    if (!status) {
+        status = qemu_crucible_qmp_string_append(candidate, formatted, written);
+    }
+    if (formatted) {
+        payload = formatted;
+        cleanup = qemu_crucible_qmp_free(&payload);
+    }
+    return qmp_string_failure(string, status ? status : cleanup);
+}
+
+int qemu_crucible_qmp_string_mutation_begin(GString *candidate,
+                                           QemuCrucibleQmpStringMutation **out)
+{
+    QemuCrucibleQmpAllocationLedger *ledger = &startup_source.qmp_allocations;
+    QemuCrucibleQmpAllocationOwner *owner;
+    QemuCrucibleQmpAllocationOwner *buffer_owner;
+    QemuCrucibleQmpAllocationBlock **body;
+    QemuCrucibleQmpAllocationBlock **buffer;
+    QmpControlledString *string;
+    int status;
+
+    if (!out || !candidate) {
+        return -EINVAL;
+    }
+    *out = NULL;
+    if (!qmp_allocation_enter(ledger)) {
+        return -EAGAIN;
+    }
+    body = qmp_allocation_find_block(ledger, candidate, &owner);
+    if (!body || !(*body)->record.controlled_string ||
+        (*body)->record.payload_bytes != sizeof(*string)) {
+        status = -EPERM;
+        goto done;
+    }
+    /* Resolve and publish under one cut. Acquire the body pin BEFORE any
+     * ordinary string/loan read; a foreign end may be clearing those fields. */
+    if (qatomic_load_acquire(&(*body)->record.mutation) ||
+        qatomic_load_acquire(&(*body)->record.cleanup_retained)) {
+        status = -EBUSY;
+        goto done;
+    }
+    status = qmp_allocation_live(ledger, owner);
+    if (status) {
+        goto done;
+    }
+    string = (QmpControlledString *)candidate;
+    if (string->owner != owner || !(*body)->record.charge.held || string->closing ||
+        string->first_status || owner->first_status) {
+        status = string->first_status ? string->first_status :
+                 owner->first_status ? owner->first_status : -EPERM;
+        goto done;
+    }
+    buffer = qmp_allocation_find_block(ledger, string->value.str, &buffer_owner);
+    if (!buffer || buffer_owner != owner || !(*buffer)->record.charge.held ||
+        (*buffer)->record.payload_bytes != string->value.allocated_len ||
+        string->value.len >= string->value.allocated_len ||
+        qatomic_load_acquire(&(*buffer)->record.mutation) ||
+        (qmp_string_mutation && qmp_string_mutation_check(qmp_string_mutation, true))) {
+        status = -ESTALE;
+        goto done;
+    }
+    string->mutation = (QemuCrucibleQmpStringMutation) {
+        .string = string,
+        .body = *body,
+        .buffer = *buffer,
+        .previous = qmp_string_mutation,
+        .coroutine = qmp_string_coroutine(),
+        .process = getpid(),
+        .held = true,
+    };
+    qemu_thread_get_self(&string->mutation.thread);
+    qatomic_store_release(&(*body)->record.mutation, &string->mutation);
+    qatomic_store_release(&(*buffer)->record.mutation, &string->mutation);
+    qmp_string_mutation = &string->mutation;
+    *out = &string->mutation;
+    status = qmp_allocation_post(ledger, string->owner, 0);
+    if (status) {
+        qmp_string_failure(string, status);
+    }
+
+done:
+    qmp_allocation_leave(ledger);
+    return status;
+}
+
+int qemu_crucible_qmp_string_mutation_current(GString *candidate,
+                                             QemuCrucibleQmpStringMutation **out)
+{
+    QemuCrucibleQmpAllocationLedger *ledger = &startup_source.qmp_allocations;
+    int status;
+
+    if (!out) {
+        return -EINVAL;
+    }
+    *out = NULL;
+    if (!qmp_allocation_enter(ledger)) {
+        return -EAGAIN;
+    }
+    if (!qmp_string_mutation || (GString *)qmp_string_mutation->string != candidate) {
+        status = -ENOENT;
+    } else {
+        status = qmp_string_mutation_check(qmp_string_mutation, false);
+        if (!status) {
+            *out = qmp_string_mutation;
+        }
+    }
+    qmp_allocation_leave(ledger);
+    return status;
+}
+
+int qemu_crucible_qmp_string_mutation_observe(QemuCrucibleQmpStringMutation *loan)
+{
+    QemuCrucibleQmpAllocationLedger *ledger = &startup_source.qmp_allocations;
+    int status;
+
+    if (!qmp_allocation_enter(ledger)) {
+        return -EAGAIN;
+    }
+    status = qmp_string_mutation_check(loan, true);
+    if (!status) {
+        status = qmp_allocation_post(ledger, loan->string->owner, 0);
+        if (status) {
+            qmp_string_failure(loan->string, status);
+            if (!loan->post_status) {
+                loan->post_status = status;
+            }
+        }
+    }
+    qmp_allocation_leave(ledger);
+    return status;
+}
+
+int qemu_crucible_qmp_string_mutation_end(QemuCrucibleQmpStringMutation **candidate)
+{
+    QemuCrucibleQmpStringMutation *loan;
+    QemuCrucibleQmpAllocationBlock *body;
+    QemuCrucibleQmpAllocationBlock *buffer;
+    QmpControlledString *string;
+    int status;
+
+    if (!candidate || !*candidate) {
+        return -EINVAL;
+    }
+    loan = *candidate;
+    /* These exact constructor-issued pins exclude free, realloc and issuer
+     * consumption even while another thread owns the accounting cut. No list
+     * traversal, callback, cleanup wait or coroutine migration is needed. */
+    status = qmp_string_mutation_check(loan, true);
+    if (status) {
+        return status;
+    }
+    body = loan->body;
+    buffer = loan->buffer;
+    string = loan->string;
+#if defined(CONFIG_LINUX) && defined(__x86_64__) && !defined(__ILP32__)
+    status = qemu_crucible_preexec_contract_check_v3(
+        startup_source.preexec_purpose_owner, &string->end_observation,
+        &string->end_descriptor_limit);
+#else
+    status = -ENOTSUP;
+#endif
+    if (status) {
+        qmp_string_failure(string, status);
+        if (!string->end_post_status) {
+            string->end_post_status = status;
+        }
+    }
+    /* The body retains any actual observation alias and raw post cause. Its
+     * separate cleanup pin prohibits generic free/realloc/issuer return; no
+     * ambiguous descriptor is retried or erased to return synchronous context. */
+    if (string->end_observation.descriptor >= 0 ||
+        string->end_observation.close_uncertain) {
+        qatomic_store_release(&body->record.cleanup_retained, true);
+    }
+    qmp_string_mutation = loan->previous;
+    *loan = (QemuCrucibleQmpStringMutation) { 0 };
+    *candidate = NULL;
+
+    /* Finish every payload/TLS access before publishing the final body pin
+     * return. A concurrent exact free may consume that body immediately after
+     * the final release store; no access through loan/string/body follows it. */
+    qatomic_store_release(&buffer->record.mutation, NULL);
+    qatomic_store_release(&body->record.mutation, NULL);
+    return status;
+}
diff --git a/plugins/crucible-qmp-visitor.inc.h b/plugins/crucible-qmp-visitor.inc.h
new file mode 100644
index 0000000000000000000000000000000000000000..85e0007223fe4cedc5bd88b561174bdc419d5f92
--- /dev/null
+++ b/plugins/crucible-qmp-visitor.inc.h
@@ -0,0 +1,177 @@
+/*
+ * Exact compiled Source visitor allocation and physical classification
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+static size_t qmp_visitor_extent(unsigned kind)
+{
+    switch (kind) {
+    case QEMU_CRUCIBLE_QMP_VISITOR_INPUT:
+        return qemu_crucible_qapi_input_storage_bytes_v1();
+    case QEMU_CRUCIBLE_QMP_VISITOR_DEALLOC:
+        return qemu_crucible_qapi_dealloc_storage_bytes_v1();
+    case QEMU_CRUCIBLE_QMP_VISITOR_OUTPUT:
+        return qemu_crucible_qapi_output_storage_bytes_v1();
+    default:
+        return 0;
+    }
+}
+
+int qemu_crucible_qmp_visitor_allocate(unsigned kind, void **out)
+{
+    QemuCrucibleQmpAllocationLedger *ledger = &startup_source.qmp_allocations;
+    QemuCrucibleQmpAllocationOwner *owner;
+    QemuCrucibleQmpAllocationOwner *found;
+    QemuCrucibleQmpAllocationBlock **block;
+    size_t bytes = qmp_visitor_extent(kind);
+    int status;
+
+    if (!out || !bytes) {
+        return -EINVAL;
+    }
+    *out = NULL;
+    status = qemu_crucible_qmp_scope_identity_current(&owner);
+    if (status) {
+        return status;
+    }
+    if (!qmp_allocation_enter(ledger)) {
+        return -EAGAIN;
+    }
+    status = qmp_allocation_allocate_locked(ledger, owner, bytes, true, out);
+    if (*out) {
+        block = qmp_allocation_find_block(ledger, *out, &found);
+        assert(block && found == owner);
+        (*block)->record.visitor_kind = kind;
+    }
+    qmp_allocation_leave(ledger);
+    return status;
+}
+
+int qemu_crucible_qmp_visitor_observe(const void *payload, unsigned *kind,
+                                      QemuCrucibleQmpAllocationOwner **out)
+{
+    QemuCrucibleQmpAllocationLedger *ledger = &startup_source.qmp_allocations;
+    QemuCrucibleQmpAllocationOwner *owner;
+    QemuCrucibleQmpAllocationBlock **block;
+    int status;
+
+    if (!payload || !kind || !out) {
+        return -EINVAL;
+    }
+    *kind = 0;
+    *out = NULL;
+    if (!qatomic_load_acquire(&qemu_crucible_selected_process_id)) {
+        return -ENOENT;
+    }
+    if (!qmp_allocation_enter(ledger)) {
+        return -EAGAIN;
+    }
+    /* Definite unknown is distinct from a known invalid or contended block.
+     * No visitor fields or guessed pointer prefix are read before this lookup. */
+    block = qmp_allocation_find_block(ledger, (void *)payload, &owner);
+    status = block ? qmp_allocation_identity(owner) : -ENOENT;
+    if (!status && (!(*block)->record.charge.held ||
+                    !qmp_visitor_extent((*block)->record.visitor_kind) ||
+                    (*block)->record.payload_bytes !=
+                        qmp_visitor_extent((*block)->record.visitor_kind))) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        *kind = (*block)->record.visitor_kind;
+        *out = owner;
+    }
+    qmp_allocation_leave(ledger);
+    return status;
+}
+
+static __thread QemuCrucibleQmpVisitorLoan *qmp_visitor_loan;
+
+int qemu_crucible_qmp_visitor_loan_begin(
+    Visitor *visitor, QemuCrucibleQmpVisitorLoan **out)
+{
+    QemuCrucibleQmpAllocationLedger *ledger = &startup_source.qmp_allocations;
+    QemuCrucibleQmpAllocationOwner *owner;
+    QemuCrucibleQmpAllocationBlock **link;
+    QemuCrucibleQmpAllocationBlock *block;
+    QemuCrucibleQmpVisitorLoan *loan;
+    int status;
+
+    if (!visitor || !out || *out || qmp_visitor_loan) {
+        return -EBUSY;
+    }
+    if (!qmp_allocation_enter(ledger)) {
+        return -EAGAIN;
+    }
+    link = qmp_allocation_find_block(ledger, visitor, &owner);
+    status = link ? qmp_allocation_identity(owner) : -ENOENT;
+    if (status) {
+        goto done;
+    }
+    block = *link;
+    if (block->record.visitor_kind != QEMU_CRUCIBLE_QMP_VISITOR_DEALLOC ||
+        !qmp_visitor_extent(block->record.visitor_kind) ||
+        block->record.payload_bytes != qmp_visitor_extent(block->record.visitor_kind) ||
+        !block->record.charge.held ||
+        qatomic_load_acquire(&block->record.visitor_pin) ||
+        qatomic_load_acquire(&block->record.cleanup_retained)) {
+        status = -EBUSY;
+        goto done;
+    }
+    loan = &block->record.visitor_loan;
+    loan->block = block;
+    loan->payload = visitor;
+    loan->process = getpid();
+    qemu_thread_get_self(&loan->thread);
+    loan->coroutine = qmp_scope_coroutine();
+    loan->held = true;
+    qmp_visitor_loan = loan;
+    *out = loan;
+    qatomic_store_release(&block->record.visitor_pin, loan);
+done:
+    qmp_allocation_leave(ledger);
+    return status;
+}
+
+int qemu_crucible_qmp_visitor_loan_current(
+    Visitor *visitor, QemuCrucibleQmpVisitorLoan *loan)
+{
+    /* Native TLS identifies the already-held real loan before any candidate
+     * dereference. The body remains pinned through its actual caller return. */
+    if (loan && loan != qmp_visitor_loan) {
+        return -EPERM;
+    }
+    loan = qmp_visitor_loan;
+    if (!loan) {
+        return -EPERM;
+    }
+    if (!loan->held || loan->process != getpid() || loan->payload != visitor ||
+        !qemu_thread_is_self(&loan->thread) ||
+        loan->coroutine != qmp_scope_coroutine() ||
+        qatomic_load_acquire(&loan->block->record.visitor_pin) != loan) {
+        return -EPERM;
+    }
+    return 0;
+}
+
+int qemu_crucible_qmp_visitor_loan_end(QemuCrucibleQmpVisitorLoan **holder)
+{
+    QemuCrucibleQmpVisitorLoan *loan;
+    QemuCrucibleQmpAllocationBlock *block;
+    int status;
+
+    if (!holder || !*holder || *holder != qmp_visitor_loan) {
+        return -EPERM;
+    }
+    loan = *holder;
+    status = qemu_crucible_qmp_visitor_loan_current(loan->payload, loan);
+    if (status) {
+        return status;
+    }
+    block = loan->block;
+    /* No accounting lock, allocator, callback or wait is needed to return this
+     * same-context pin. Complete every loan/body access before final release. */
+    loan->held = false;
+    qmp_visitor_loan = NULL;
+    *holder = NULL;
+    qatomic_store_release(&block->record.visitor_pin, NULL);
+    return 0;
+}
diff --git a/plugins/crucible-ram-control.inc.h b/plugins/crucible-ram-control.inc.h
new file mode 100644
index 0000000000000000000000000000000000000000..c7c31159fb37a0afa186d852ea1c47cd98583d7e
--- /dev/null
+++ b/plugins/crucible-ram-control.inc.h
@@ -0,0 +1,2162 @@
+/*
+ * Partial sole-actor construction and bounded native receipt
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Included once in startup-source.c to share the retained issuer partition.
+ * The distinct RAM endpoint is borrowed from its actual retained preexec
+ * Purpose5 owner; it is never the startup FD3 or a caller-nominated descriptor.
+ * Pending/request publishers remain incomplete; no support activation.
+ */
+#ifdef CONFIG_LINUX
+#include <sys/mman.h>
+#include <sys/socket.h>
+#endif
+
+#include "system/crucible-ram-quiescence.h"
+
+#define CRUCIBLE_RAM_CONTROL_STACK_BYTES (256 * 1024)
+
+G_STATIC_ASSERT(QEMU_CRUCIBLE_RAM_OWNER_INVENTORY_PENDING_RECORD ==
+                QEMU_PLUGIN_CRUCIBLE_RAM_OWNER_INVENTORY_PENDING_RECORD);
+
+static int ram_control_failure(QemuCrucibleRamControlActor *actor, int status,
+                               bool post)
+{
+    if (status > 0) {
+        status = -EPROTO;
+    }
+    if (status < 0) {
+        if (post) {
+            qatomic_cmpxchg(&actor->post_status, 0, status);
+        }
+        qatomic_cmpxchg(&actor->first_status, 0, status);
+    }
+    return qatomic_read(&actor->first_status);
+}
+
+int qemu_crucible_ram_control_actor_current(
+    QemuCrucibleRamControlActor *actor, qemu_plugin_id_t id)
+{
+    if (!qatomic_load_acquire(&startup_source.module_custody_published) ||
+        !qatomic_load_acquire(&startup_source.process_purpose_complete) ||
+        getpid() != startup_source.owner_process ||
+        actor != &startup_source.ram_control_actor ||
+        !qatomic_load_acquire(&actor->born) || actor->process != getpid() ||
+        !qemu_thread_is_self(&actor->thread) ||
+        actor->purpose != &startup_source.runtime_purpose ||
+        !actor->purpose->charge.held || !startup_source.custody_retained ||
+        id != startup_source.saved.plugin_id ||
+        actor->userdata != startup_source.checkpoint_pager_userdata ||
+        actor->userdata != startup_source.provider_userdata ||
+        !qatomic_load_acquire(&startup_source.checkpoint_pager_registered) ||
+        !qatomic_load_acquire(&startup_source.provider_registered) ||
+        qatomic_load_acquire(&actor->returned)) {
+        return -EPERM;
+    }
+    return 0;
+}
+
+int qemu_crucible_ram_control_actor_contract_current(
+    QemuCrucibleRamControlActor *actor)
+{
+#ifdef CONFIG_LINUX
+    int descriptor;
+    int status;
+
+    if (actor != &startup_source.ram_control_actor || !actor->attempted ||
+        actor->process != getpid() ||
+        !qatomic_load_acquire(&startup_source.process_purpose_complete)) {
+        return -EPERM;
+    }
+    status = qemu_crucible_preexec_contract_check_v3(
+        startup_source.preexec_purpose_owner, &actor->observation,
+        &actor->descriptor_limit);
+    if (!status) {
+        status = qemu_crucible_preexec_ram_endpoint_check_v1(
+            startup_source.preexec_purpose_owner, actor->ram_endpoint, &descriptor);
+    }
+    if (!status && descriptor != actor->endpoint_descriptor) {
+        status = -ESTALE;
+    }
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_startup_ram_endpoint_borrow_v1(
+    qemu_plugin_id_t id, qemu_plugin_crucible_runtime_purpose_v2 *runtime,
+    struct qemu_plugin_crucible_ram_endpoint_borrow_v1 *out)
+{
+#ifdef CONFIG_LINUX
+    const QemuCrucibleProcessPurposeRecord *record;
+    struct qemu_plugin_crucible_ram_endpoint_borrow_v1 borrowed;
+    int descriptor;
+    int status;
+
+    if (qemu_crucible_resident_service_birth_blocked_v1()) {
+        return -EBUSY;
+    }
+    status = startup_runtime_admission(id, runtime);
+
+    if (status || !out) {
+        return status ? status : -EINVAL;
+    }
+    status = qemu_crucible_preexec_ram_endpoint_check_v1(
+        startup_source.preexec_purpose_owner,
+        startup_source.ram_endpoint_purpose_owner, &descriptor);
+    if (status) {
+        return status;
+    }
+    record = &startup_source.process_purpose_record;
+    borrowed = (struct qemu_plugin_crucible_ram_endpoint_borrow_v1) {
+        .schema_version = 1,
+        .struct_size = sizeof(borrowed),
+        .purpose = startup_source.ram_endpoint_purpose_owner,
+        .descriptor = descriptor,
+        .session = record->ram_session,
+        .target_daemon = record->ram_target_daemon,
+        .target_owner = record->ram_target_owner,
+        .target_node = record->ram_target_node,
+        .owner_generation = record->ram_owner_generation,
+        .arena_generation = record->ram_arena_generation,
+        .is_template = record->ram_template,
+    };
+    *out = borrowed;
+    return 0;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+#include "crucible-ram-record.inc.h"
+
+#ifdef CONFIG_LINUX
+/* The worker borrows the same retained creating original. This read-only cut
+ * uses no temporary descriptor or Source metadata mutation. The creator still
+ * performs the full public Source identity/clock checks before success. */
+static int ram_control_start_slice(QemuCrucibleRamControlActor *actor,
+                                   uint64_t *bounded_ns)
+{
+    const QemuCrucibleOriginalStartupWireRecord *original = &startup_source.original;
+    const QemuCrucibleProcessPurposeRecord *containing =
+        &startup_source.process_purpose_record;
+    struct stat event;
+    uint64_t now;
+    uint64_t remaining;
+    int flags;
+    int status;
+
+    if (actor != &startup_source.ram_control_actor || actor->process != getpid() ||
+        actor->purpose != &startup_source.runtime_purpose ||
+        !actor->charge.held || !actor->purpose->charge.held ||
+        !qatomic_load_acquire(&startup_source.original_record_complete) ||
+        !qatomic_load_acquire(&startup_source.custody_retained) ||
+        !qatomic_load_acquire(&startup_source.process_purpose_complete) ||
+        !startup_source.owns_event || !bounded_ns) {
+        return -EPERM;
+    }
+    if (fstat(startup_source.event_fd, &event) < 0) {
+        return -errno;
+    }
+    flags = fcntl(startup_source.event_fd, F_GETFL);
+    if (flags < 0) {
+        return -errno;
+    }
+    if (!(flags & O_NONBLOCK) ||
+        (uint64_t)event.st_dev != original->cancellation_device ||
+        (uint64_t)event.st_ino != original->cancellation_inode) {
+        return -ESTALE;
+    }
+    status = startup_cancelled();
+    if (!status) {
+        status = startup_monotonic_now(&now);
+    }
+    if (status) {
+        return status;
+    }
+    if (!original->poll_ns || !containing->containing_poll ||
+        now < original->original_start_ns || now < containing->containing_start) {
+        return -ESTALE;
+    }
+    if (now >= original->absolute_end_ns || now >= containing->containing_end) {
+        return -ETIMEDOUT;
+    }
+    remaining = MIN(original->absolute_end_ns - now, containing->containing_end - now);
+    *bounded_ns = MIN(remaining, MIN(original->poll_ns, containing->containing_poll));
+    return 0;
+}
+
+static int ram_control_start_wait(QemuCrucibleRamControlActor *actor,
+                                  uint64_t bounded_ns)
+{
+    struct pollfd cancellation = {
+        .fd = startup_source.event_fd, .events = POLLIN,
+    };
+    uint64_t duration = MIN(bounded_ns, UINT64_C(10000000));
+    struct timespec timeout = {
+        .tv_sec = duration / 1000000000,
+        .tv_nsec = duration % 1000000000,
+    };
+    uint64_t post_slice;
+    int result;
+    int status;
+    int post;
+
+    if (!duration) {
+        return ram_control_failure(actor, -ETIMEDOUT, false);
+    }
+    result = ppoll(&cancellation, 1, &timeout, NULL);
+    status = result < 0 ? -errno :
+        cancellation.revents & POLLNVAL ? -EBADF :
+        cancellation.revents & (POLLERR | POLLHUP) ? -EIO :
+        result || cancellation.revents ? -ECANCELED : 0;
+    if (status) {
+        ram_control_failure(actor, status, false);
+    }
+    /* Preserve raw post even after an initiating failure. EINTR is not retried. */
+    post = ram_control_start_slice(actor, &post_slice);
+    if (post) {
+        ram_control_failure(actor, post, true);
+    }
+    return qatomic_read(&actor->first_status);
+}
+
+static int ram_control_start_flag(QemuCrucibleRamControlActor *actor,
+                                  const bool *flag)
+{
+    uint64_t bounded_ns;
+    int status;
+
+    for (;;) {
+        /* A parent incarnation must borrow its actual held parent Original.
+         * Its worker-side event/query donor is absent; Setup cannot substitute
+         * for that authority after installation or silently renew its end. */
+        status = actor->incarnation > 1 ? -ENOKEY :
+            ram_control_start_slice(actor, &bounded_ns);
+        if (status) {
+            return ram_control_failure(actor, status, false);
+        }
+        if (qatomic_load_acquire(flag)) {
+            return qatomic_read(&actor->first_status);
+        }
+        status = ram_control_start_wait(actor, bounded_ns);
+        if (status) {
+            return status;
+        }
+    }
+}
+
+static int ram_control_parent_slice(QemuCrucibleRamControlActor *actor,
+                                     qemu_plugin_id_t id, uint64_t *bounded_ns);
+static int ram_control_parent_wait(QemuCrucibleRamControlActor *actor,
+                                    qemu_plugin_id_t id, uint64_t bounded_ns);
+
+static int ram_control_creator_enrollment(QemuCrucibleRamControlActor *actor,
+                                          qemu_plugin_id_t id, bool parent)
+{
+    uint64_t bounded_ns;
+    int status;
+    int post;
+
+    for (;;) {
+        status = parent ? ram_control_parent_slice(actor, id, &bounded_ns) :
+            startup_runtime_admission(id, actor->purpose);
+        if (!status && !parent) {
+            status = qemu_plugin_crucible_startup_source_query_slice_v1(id, &bounded_ns);
+        }
+        if (status) {
+            break;
+        }
+        if (qatomic_load_acquire(&actor->terminal_pending) ||
+            qatomic_load_acquire(&actor->returned)) {
+            status = -ESTALE;
+            break;
+        }
+        if (qatomic_load_acquire(&actor->qualification_published)) {
+            status = qatomic_read(&actor->qualification_status);
+            if (status || qatomic_read(&actor->first_status) ||
+                qatomic_read(&actor->post_status)) {
+                status = status ? status : qatomic_read(&actor->first_status);
+                status = status ? status : qatomic_read(&actor->post_status);
+                break;
+            }
+            status = pthread_mutex_trylock(&actor->dispatch_mutex);
+            if (!status) {
+                if (!qatomic_load_acquire(&actor->service_registered) ||
+                    !actor->thread_binding || !actor->thread_id ||
+                    actor->service_generation !=
+                        startup_source.process_purpose_record.process_generation) {
+                    status = -ESTALE;
+                } else {
+                    status = qemu_thread_ram_actor_enrollment_current(
+                        actor->thread_binding, actor->thread_id);
+                    if (!status) {
+                        status = qemu_crucible_ram_service_actor_enrollment_current(
+                            actor, actor->service_generation, actor->thread_id);
+                    }
+                }
+                {
+                    int unlock = pthread_mutex_unlock(&actor->dispatch_mutex);
+
+                    if (unlock) {
+                        ram_control_failure(actor, -unlock, true);
+                        status = status < 0 ? status : -unlock;
+                    }
+                }
+            } else {
+                status = status == EBUSY ? 1 : -status;
+            }
+            if (status > 1) {
+                status = -EPROTO;
+            }
+            if (status <= 0) {
+                break;
+            }
+        }
+        status = parent ? ram_control_parent_wait(actor, id, bounded_ns) :
+            ram_control_start_wait(actor, bounded_ns);
+        if (status) {
+            break;
+        }
+    }
+    if (status) {
+        ram_control_failure(actor, status < 0 ? status : -EPROTO, false);
+    }
+    /* Actual Source clocks and event identity are rechecked independently. */
+    post = parent ? ram_control_parent_slice(actor, id, &bounded_ns) :
+        startup_runtime_original_post();
+    if (!post) {
+        post = parent ? ram_control_parent_slice(actor, id, &bounded_ns) :
+            startup_runtime_admission(id, actor->purpose);
+    }
+    if (post) {
+        ram_control_failure(actor, post, true);
+    }
+    return qatomic_read(&actor->first_status);
+}
+
+static void *ram_control_entry(void *opaque)
+{
+    QemuCrucibleRamControlActor *actor = opaque;
+    int status;
+
+    /* Constructor publication, including its independent post, precedes any
+     * module receive. The real QEMU thread wrapper owns registry teardown. */
+    status = ram_control_start_flag(actor, &actor->creator_published);
+    {
+        int lock = pthread_mutex_lock(&actor->dispatch_mutex);
+
+        if (lock) {
+            status = ram_control_failure(actor, -lock, true);
+            qatomic_set(&actor->qualification_status, status);
+            qatomic_store_release(&actor->qualification_published, true);
+            qatomic_store_release(&actor->terminal_pending, true);
+            qatomic_set(&actor->entry_status, status);
+            qatomic_store_release(&actor->returned, true);
+            return NULL;
+        }
+    }
+    if (!status && qatomic_load_acquire(&actor->ready)) {
+        status = qemu_crucible_ram_control_actor_contract_current(actor);
+        if (!status) {
+            status = qemu_thread_ram_actor_bind_self(&actor->thread,
+                                                    &actor->thread_binding);
+        }
+        if (!status) {
+            actor->thread_id = qemu_get_thread_id();
+            actor->service_generation =
+                startup_source.process_purpose_record.process_generation;
+            status = qemu_crucible_ram_service_actor(actor, true);
+        }
+        if (!status) {
+            qatomic_store_release(&actor->service_registered, true);
+        }
+    }
+    {
+        int unlock = pthread_mutex_unlock(&actor->dispatch_mutex);
+
+        if (unlock) {
+            ram_control_failure(actor, -unlock, true);
+            status = status ? status : -unlock;
+        }
+    }
+    qatomic_set(&actor->qualification_status, status);
+    qatomic_store_release(&actor->qualification_published, true);
+    if (!status) {
+        status = ram_control_start_flag(actor, &actor->entry_released);
+    }
+    if (!status && qatomic_load_acquire(&actor->entry_allowed) &&
+        qatomic_load_acquire(&actor->service_registered)) {
+        SOURCE_CALLBACK_MASKED_INVOKE(
+            status, &actor->entry, actor->entry, actor->userdata,
+            startup_source.saved.plugin_id, actor,
+            actor->endpoint_descriptor,
+            actor->userdata);
+    }
+    if (status > 0) {
+        status = -EPROTO;
+    }
+    /* Entry return is immediately visible, even if an owned pause keeps the
+     * actual thread from deregistering or physically exiting. */
+    qatomic_store_release(&actor->terminal_pending, true);
+    pthread_mutex_lock(&actor->dispatch_mutex);
+    while (actor->pause.held || actor->request_pause.held ||
+           actor->receipt.record.held || actor->receipt.record.callback_active ||
+           (actor->receipt.active && actor->record_in_flight)) {
+        int wait_status = pthread_cond_wait(&actor->dispatch_condition,
+                                            &actor->dispatch_mutex);
+
+        if (wait_status) {
+            ram_control_failure(actor, -wait_status, true);
+            /* A failed wait cannot release physical lifetime custody. */
+            continue;
+        }
+    }
+    if (actor->quiesce_requested &&
+        (!actor->dispatch_ended || actor->receipt.active || actor->receipt.moved ||
+         actor->receipt.frame_bytes || actor->receipt.alias_count)) {
+        ram_control_failure(actor, -EINPROGRESS, true);
+    }
+    if (actor->record_in_flight || actor->receipt.uncertain) {
+        ram_control_failure(actor, -EINPROGRESS, true);
+    }
+    if (qatomic_load_acquire(&actor->service_registered)) {
+        int cleanup = qemu_crucible_ram_service_actor(actor, false);
+
+        if (cleanup) {
+            ram_control_failure(actor, cleanup, true);
+        } else {
+            qatomic_store_release(&actor->service_registered, false);
+        }
+    }
+    ram_control_failure(actor, status, false);
+    qatomic_store_release(&actor->graceful_return,
+        !status && !qatomic_read(&actor->first_status) &&
+        !qatomic_read(&actor->post_status) && actor->quiesce_requested &&
+        actor->dispatch_ended && !actor->service_registered &&
+        !actor->record_in_flight && !actor->receipt.active &&
+        !actor->receipt.uncertain && !actor->receipt.moved &&
+        !actor->receipt.frame_bytes && !actor->receipt.alias_count &&
+        !actor->receipt.record.held && !actor->receipt.record.callback_active);
+    qatomic_set(&actor->entry_status, status);
+    qatomic_store_release(&actor->returned, true);
+    pthread_mutex_unlock(&actor->dispatch_mutex);
+    return NULL;
+}
+
+#endif
