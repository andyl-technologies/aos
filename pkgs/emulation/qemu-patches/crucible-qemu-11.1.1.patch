+    size_t index;
+
+    g_assert_cmpint(qemu_crucible_hot_fork_prepare_plugin_child_resources(
+                        &plugin, &plan, 31, 32),
+                    ==, 0);
+    retained_fds[0] = plan.private_ring_fd;
+    replacements[0] = (QemuCrucibleHotForkDescriptorReplacement) {
+        .source_fd = 10000,
+        .target_fd = plan.private_ring_fd,
+    };
+    retained_fds[1] = 44;
+    replacements[1] = (QemuCrucibleHotForkDescriptorReplacement) {
+        .source_fd = 10001,
+        .target_fd = 44,
+    };
+    for (index = 2;
+         index < QEMU_CRUCIBLE_HOT_FORK_MAX_DESCRIPTOR_REPLACEMENTS - 4;
+         index++) {
+        replacements[index] = (QemuCrucibleHotForkDescriptorReplacement) {
+            .source_fd = 10000 + index,
+            .target_fd = 100 + index,
+        };
+        retained_fds[index] = replacements[index].target_fd;
+    }
+    g_assert_cmpint(qemu_crucible_hot_fork_begin_child_resource_plan(
+                        resources, &plugin),
+                    ==, 0);
+    merge_fake_diagnostics(resources, 40, 41);
+    merge_fake_qmp(resources, 42, 43);
+    merge_fake_console(resources, 44, 45);
+    g_assert_cmpint(qemu_crucible_hot_fork_merge_child_resource_contribution(
+                        resources, replacements,
+                        QEMU_CRUCIBLE_HOT_FORK_MAX_DESCRIPTOR_REPLACEMENTS - 4,
+                        retained_fds,
+                        QEMU_CRUCIBLE_HOT_FORK_MAX_DESCRIPTOR_REPLACEMENTS - 4,
+                        NULL, 0),
+                    ==, 0);
+    g_assert_cmpuint(resources->replacement_count, ==,
+                     QEMU_CRUCIBLE_HOT_FORK_MAX_DESCRIPTOR_REPLACEMENTS - 1);
+    g_assert_cmpuint(resources->retained_fd_count, ==,
+                     QEMU_CRUCIBLE_HOT_FORK_MAX_RETAINED_DESCRIPTORS);
+    replacements[0] = (QemuCrucibleHotForkDescriptorReplacement) {
+        .source_fd = 20000,
+        .target_fd = 20001,
+    };
+    retained_fds[0] = replacements[0].target_fd;
+    g_assert_cmpint(qemu_crucible_hot_fork_merge_child_resource_contribution(
+                        resources, replacements, 1,
+                        retained_fds, 1, NULL, 0),
+                    ==, -E2BIG);
+
+    qemu_crucible_hot_fork_reset_child_resource_plan(resources);
+    for (index = 0;
+         index < QEMU_CRUCIBLE_HOT_FORK_MAX_RETAINED_DESCRIPTORS;
+         index++) {
+        retained_fds[index] = 100 + index;
+    }
+    g_assert_cmpint(qemu_crucible_hot_fork_begin_child_resource_plan(
+                        resources, &plugin),
+                    ==, 0);
+    merge_fake_diagnostics(resources, 40, 41);
+    merge_fake_qmp(resources, 42, 43);
+    merge_fake_console(resources, 44, 45);
+    g_assert_cmpint(qemu_crucible_hot_fork_merge_child_resource_contribution(
+                        resources, NULL, 0, retained_fds,
+                        QEMU_CRUCIBLE_HOT_FORK_MAX_RETAINED_DESCRIPTORS - 6,
+                        NULL, 0),
+                    ==, 0);
+    g_assert_cmpuint(resources->retained_fd_count, ==,
+                     QEMU_CRUCIBLE_HOT_FORK_MAX_RETAINED_DESCRIPTORS);
+    g_assert_cmpint(qemu_crucible_hot_fork_merge_child_resource_contribution(
+                        resources, NULL, 0,
+                        &retained_fds[
+                            QEMU_CRUCIBLE_HOT_FORK_MAX_RETAINED_DESCRIPTORS -
+                            6],
+                        1, NULL, 0),
+                    ==, -E2BIG);
+
+    qemu_crucible_hot_fork_reset_child_resource_plan(resources);
+    g_assert_cmpint(qemu_crucible_hot_fork_begin_child_resource_plan(
+                        resources, &plugin),
+                    ==, 0);
+    merge_fake_diagnostics(resources, 40, 41);
+    merge_fake_qmp(resources, 42, 43);
+    merge_fake_console(resources, 44, 45);
+    for (index = 0;
+         index < QEMU_CRUCIBLE_HOT_FORK_MAX_SHARED_MAPPINGS;
+         index++) {
+        mappings[index] = (QemuCrucibleHotForkSharedMapping) {
+            .start = (3 + 2 * index) * page_size,
+            .length = page_size,
+            .offset = index * page_size,
+            .backing_fd = plan.private_ring_fd,
+        };
+    }
+    g_assert_cmpint(qemu_crucible_hot_fork_merge_child_resource_contribution(
+                        resources, NULL, 0, NULL, 0, mappings,
+                        QEMU_CRUCIBLE_HOT_FORK_MAX_SHARED_MAPPINGS - 1),
+                    ==, 0);
+    g_assert_cmpuint(resources->shared_mapping_count, ==,
+                     QEMU_CRUCIBLE_HOT_FORK_MAX_SHARED_MAPPINGS);
+    g_assert_cmpint(qemu_crucible_hot_fork_merge_child_resource_contribution(
+                        resources, NULL, 0, NULL, 0,
+                        &mappings[
+                            QEMU_CRUCIBLE_HOT_FORK_MAX_SHARED_MAPPINGS - 1],
+                        1),
+                    ==, -E2BIG);
+    g_assert_cmpint(qemu_crucible_hot_fork_seal_child_resource_plan(resources),
+                    ==, 0);
+}
