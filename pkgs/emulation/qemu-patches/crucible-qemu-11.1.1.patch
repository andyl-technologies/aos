+        assert(child->born && child->returning && child->physically_returned);
+        assert(!child->post_status && !child->envelope_custodian);
+        if (child->kind == CRUCIBLE_NODE_ENVELOPE_CHILD) {
+            assert(child->payload_owed && child->payload_returned);
+            assert(child->envelope_extent == sizeof(CrucibleNodeEnvelope) + child->envelope_capacity);
+            envelope_bodies++;
+            envelope_bytes += child->envelope_extent;
+        } else {
+            assert(child->envelope_extent == sizeof(CrucibleNodeEvent));
+            restore_rows++;
+        }
+    }
+    assert(envelope_bodies > 0 && envelope_bytes > 0 && restore_rows > 0);
+    fprintf(stderr, "ordinary envelope physical bodies=%" PRIu64 " requested-bytes=%" PRIu64
+            " restore-rows=%" PRIu64 "\n", envelope_bodies, envelope_bytes, restore_rows);
+#ifdef CRUCIBLE_NODE_LIVE_JSON_POST_FAILURE
+    /* Earlier fully drained graphs can return before the independently live
+     * nested child is encountered. Their failed post remains the first cause. */
+    CrucibleNodeJsonJournal *failed_json;
+
+    assert(qemu_crucible_fault_node_registration_return_v1(&hang->holder) == -EIO);
+    for (failed_json = hang->json; failed_json; failed_json = failed_json->next) {
+        if (failed_json->receipt.post_status == -EIO) {
+            break;
+        }
+    }
+    assert(failed_json);
+    assert(failed_json->receipt.physically_returned);
+    assert(failed_json->post_status == -EIO);
+#else
+    assert(qemu_crucible_fault_node_registration_return_v1(&hang->holder) == -EBUSY);
+#endif
+    assert(hang->holder == hang && !hang->closing);
+    qobject_unref(retained_json_child);
+
+    child_controls = hang->child_issuance;
+    assert(child_controls > 0);
+    copied_holder = hang;
+    assert(qemu_crucible_fault_node_registration_return_v1(&copied_holder) == -EPERM);
+    retired_holder = &hang->holder;
+#ifdef CRUCIBLE_NODE_LIVE_JSON_POST_FAILURE
+    assert(qemu_crucible_fault_node_registration_return_v1(retired_holder) == -EIO);
+    CrucibleNodeJsonJournal *json = failed_json;
+    QObjectConstructionJournal *new_journal = NULL;
+    QemuCrucibleFaultRegistrationObservation failed_observation;
+
+    assert(qemu_crucible_fault_registration_observe_v1(
+        hang, &hang->holder, &failed_observation) == 0);
+    assert(failed_observation.registry_memberships == 1);
+    assert(!failed_observation.queued_pending && failed_observation.registry_sealed);
+    assert(json->receipt.physically_returned);
+    assert(json->returned && !json->holder);
+    assert(json->post_status == -EIO);
+    assert(!json->receipt.first_status && json->receipt.post_status == -EIO);
+    assert(json->receipt.control_bytes > 0 && json->receipt.payload_bytes > 0);
+    assert(json->receipt.allocations_returned > 0);
+    QObjectConstructionReceipt saved_receipt = json->receipt;
+
+    assert(live_node_owner(CRUCIBLE_FAULT_COMMAND_NODE_HANG) == hang);
+    assert(hang->holder == hang && !hang->closing);
+    assert(!crucible_node_registrations.returning.active);
+    assert(!crucible_node_registrations.returning.physically_returned);
+    assert(qobject_construction_return(&json->holder, &json->receipt) == -EPERM);
+    assert(qobject_construction_begin(&new_journal) == -EBUSY);
+    assert(!new_journal);
+    assert(qemu_crucible_fault_node_registration_return_v1(retired_holder) == -EIO);
+    assert(json->post_status == -EIO && !json->holder && json->returned);
+    assert(!memcmp(&saved_receipt, &json->receipt, sizeof(saved_receipt)));
+    assert(live_node_owner(CRUCIBLE_FAULT_COMMAND_NODE_HANG) == hang);
+    assert(!qemu_crucible_fault_node_register(
+        CRUCIBLE_FAULT_COMMAND_NODE_HANG, QEMU_PLUGIN_CRUCIBLE_FAULT_SCOPE_ALL,
+        boundary, "ordinary.hang.failed.json.must.not.rebirth", NULL));
+    fprintf(stderr, "ordinary consumed-negative JSON controls=%" PRIu64
+            " payload=%" PRIu64 " allocations=%" PRIu64 " post=%d\n",
+            json->receipt.control_bytes, json->receipt.payload_bytes,
+            json->receipt.allocations_returned, json->receipt.post_status);
+    puts("PASS actual consumed-negative QObject journal return");
+    puts("PASS actual ordinary registration with retained failed-post owner");
+    return;
+#endif
+#ifdef CRUCIBLE_NODE_LIVE_RETIRE_POST_FAILURE
+    assert(qemu_crucible_fault_node_registration_return_v1(retired_holder) == -EIO);
+#else
+    assert(qemu_crucible_fault_node_registration_return_v1(retired_holder) == 0);
+#endif
+    /* From this point only the external cursor and real registry are read. */
+    assert(!live_node_owner(CRUCIBLE_FAULT_COMMAND_NODE_HANG));
+    assert(crucible_node_registrations.returning.physically_returned);
+    assert(crucible_node_registrations.returning.registry_removed);
+    assert(crucible_node_registrations.returning.impulse_removed);
+#ifdef CRUCIBLE_NODE_LIVE_RETIRE_POST_FAILURE
+    assert(crucible_node_registrations.returning.active);
+    assert(crucible_node_registrations.returning.post_status == -EIO);
+    assert(qemu_crucible_fault_node_registration_return_v1(retired_holder) == -EIO);
+#else
+    assert(!crucible_node_registrations.returning.active);
+    assert(!crucible_node_registrations.returning.post_status);
+#endif
+    assert(crucible_node_registrations.returning.child_controls_returned ==
+           child_controls);
+    assert(crucible_node_registrations.returning.child_control_bytes_returned ==
+           child_controls * sizeof(CrucibleNodeRegistrationChild));
+    assert(crucible_node_registrations.returning.producer_bytes_returned ==
+           sizeof(CrucibleNodeOwnedHandler));
+    assert(crucible_node_registrations.returning.json_controls_returned > 0);
+    assert(crucible_node_registrations.returning.json_control_bytes > 0);
+    assert(crucible_node_registrations.returning.json_payload_bytes > 0);
+    assert(crucible_node_registrations.returning.json_allocations_returned > 0);
+#ifndef CRUCIBLE_NODE_LIVE_RETIRE_POST_FAILURE
+    assert(qemu_crucible_fault_node_registration_return_v1(retired_holder) == -EPERM);
+#endif
+    assert(!qemu_crucible_fault_node_register(
+        CRUCIBLE_FAULT_COMMAND_NODE_HANG, QEMU_PLUGIN_CRUCIBLE_FAULT_SCOPE_ALL,
+        boundary, "ordinary.hang.must.not.rebirth", NULL));
+    assert(live_node_owner(CRUCIBLE_FAULT_COMMAND_NODE_LIFECYCLE) == lifecycle);
+    assert(lifecycle->impulse == original_impulse);
+    command.command_sequence++;
+    result = live_node_dispatch(&command, payload);
+    assert(result.status == CRUCIBLE_FAULT_STATUS_UNSUPPORTED_CAPABILITY);
+    fprintf(stderr, "ordinary retired child-controls=%" PRIu64
+            " child-control-bytes=%" PRIu64 " producer-bytes=%" PRIu64
+            " json-controls=%" PRIu64 " json-control-bytes=%" PRIu64
+            " json-payload-bytes=%" PRIu64 " json-allocations=%" PRIu64 "\n",
+            crucible_node_registrations.returning.child_controls_returned,
+            crucible_node_registrations.returning.child_control_bytes_returned,
+            crucible_node_registrations.returning.producer_bytes_returned,
+            crucible_node_registrations.returning.json_controls_returned,
+            crucible_node_registrations.returning.json_control_bytes,
+            crucible_node_registrations.returning.json_payload_bytes,
+            crucible_node_registrations.returning.json_allocations_returned);
+    puts("PASS actual ordinary NODE_HANG handler retirement "
+         "after nested JSON body return");
+#endif
+    puts("PASS actual ordinary registration, duplicate retention, Submit and node callback/storage returns");
+    puts("Source admission, other handler families and allocator backing return "
+         "remain unavailable");
+}
diff --git a/tests/unit/crucible-fault-node-live-main.c b/tests/unit/crucible-fault-node-live-main.c
new file mode 100644
index 0000000000000000000000000000000000000000..84b1ef0e9634a2be28b2935de6bb8a4bec93951d
--- /dev/null
+++ b/tests/unit/crucible-fault-node-live-main.c
@@ -0,0 +1,70 @@
+/*
+ * Sequence an ordinary component after actual system initialization.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#undef NDEBUG
+#include <assert.h>
+#ifdef CRUCIBLE_NODE_LIVE_PRIME_GENESIS
+#include "plugins/qemu-plugin.h"
+#include "qemu/main-loop.h"
+#include "qemu/plugin.h"
+#include "system/cpus.h"
+#include "system/runstate.h"
+
+static bool live_control_requested;
+static bool live_control_entered;
+#endif
+
+void __real_qemu_init(int argc, char **argv);
+void __wrap_qemu_init(int argc, char **argv);
+void crucible_fault_node_live_fixture(void);
+
+#ifdef CRUCIBLE_NODE_LIVE_PRIME_GENESIS
+static uint64_t live_genesis_ceiling(void *opaque)
+{
+    assert(!opaque);
+    return 0;
+}
+
+static void live_genesis_observe(uint64_t icount, void *opaque)
+{
+    assert(!opaque && icount == 0);
+    if (!live_control_requested) {
+        assert(qemu_plugin_request_control_boundary() == 0);
+        live_control_requested = true;
+    }
+}
+
+static void live_genesis_control(unsigned int vcpu, uint64_t icount, void *opaque)
+{
+    assert(!opaque && vcpu == 0 && icount == 0);
+    assert(live_control_requested && !live_control_entered);
+    live_control_entered = true;
+    assert(bql_locked());
+    assert(qemu_plugin_request_vmstop() == 0);
+    assert(runstate_check(RUN_STATE_PAUSED));
+    assert(qemu_plugin_crucible_vmstop_quiesced());
+    assert(qemu_plugin_icount_raw() == 0);
+    puts("PASS actual RR genesis and drained control stop at raw icount zero");
+
+    crucible_fault_node_live_fixture();
+    assert(qemu_plugin_icount_raw() == 0);
+    qemu_system_shutdown_request(SHUTDOWN_CAUSE_HOST_QMP_QUIT);
+}
+#endif
+
+void __wrap_qemu_init(int argc, char **argv)
+{
+    __real_qemu_init(argc, argv);
+#ifdef CRUCIBLE_NODE_LIVE_PRIME_GENESIS
+    assert(!qemu_plugin_crucible_startup_source_retained());
+    qemu_plugin_register_sim_shmem_observer_cb(
+        live_genesis_observe, live_genesis_ceiling, NULL);
+    qemu_plugin_register_control_boundary_cb(live_genesis_control, NULL);
+    vm_start();
+#else
+    crucible_fault_node_live_fixture();
+    exit(EXIT_SUCCESS);
+#endif
+}
diff --git a/tests/unit/crucible-fault-node-restore-fixture.inc.h b/tests/unit/crucible-fault-node-restore-fixture.inc.h
new file mode 100644
index 0000000000000000000000000000000000000000..44011883004a4d25d53edd84c8b975c8b86b6c9b
--- /dev/null
+++ b/tests/unit/crucible-fault-node-restore-fixture.inc.h
@@ -0,0 +1,144 @@
+/*
+ * Actual ordinary aggregate save/load with a retained rule and queued command.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "io/channel-buffer.h"
+#include "io/channel-file.h"
+#include "migration/global_state.h"
+#include "migration/qemu-file.h"
+#include "migration/savevm.h"
+#include "qapi/error.h"
+
+void crucible_fault_command_restore_observe(void);
+
+static void live_node_aggregate_restore(
+    const struct qemu_plugin_crucible_fault_command *command)
+{
+    QemuCrucibleFaultRegistration *owner = live_node_owner(command->command_kind);
+    QemuCrucibleFaultRule *original_rule = node_find_rule(
+        command->command_kind, command->binding_hash, NULL);
+    CrucibleNodeEvent *queued = QTAILQ_FIRST(&crucible_node_events);
+    struct qemu_plugin_crucible_fault_event original_event;
+    g_autoptr(GBytes) original_envelope = NULL;
+    QIOChannelBuffer *buffer = qio_channel_buffer_new(4096);
+    QIOChannelFile *input;
+    QEMUFile *file;
+    Error *error = NULL;
+    GError *write_error = NULL;
+    g_autofree char *stream_hash = NULL;
+    struct qemu_plugin_crucible_fault_event event;
+    uint8_t event_payload[4096];
+    size_t event_length;
+    uint64_t pending_issuance;
+    int status;
+
+    assert(queued && queued->event.command_kind == CRUCIBLE_FAULT_COMMAND_NODE_HANG);
+    assert(queued->event.model_phase == QEMU_CRUCIBLE_MODEL_PHASE_ARM);
+    original_event = queued->event;
+    original_envelope = g_bytes_new(
+        node_event_bytes(queued),
+        queued->payload_length);
+    assert(g_file_set_contents("aggregate-original-event.bin",
+                               g_bytes_get_data(original_envelope, NULL),
+                               g_bytes_get_size(original_envelope), &write_error));
+    assert(!write_error);
+    assert(owner && original_rule && owner->pending);
+    assert(owner->pending->location == CRUCIBLE_PENDING_QUEUED);
+    pending_issuance = owner->pending->issuance;
+#ifdef CRUCIBLE_NODE_LIVE_CONSUME_EVENTS
+    assert(qemu_plugin_crucible_fault_event_poll(
+        &event, event_payload, sizeof(event_payload), &event_length) == 1);
+    assert(event.command_kind == CRUCIBLE_FAULT_COMMAND_NODE_HANG);
+    assert(event.model_phase == QEMU_CRUCIBLE_MODEL_PHASE_ARM);
+    assert(g_file_set_contents("aggregate-consumed-event.bin",
+                               (char *)event_payload, event_length, &write_error));
+    assert(!write_error);
+    fprintf(stderr, "ordinary consumed event model-phase=%u bytes=%zu\n",
+            event.model_phase, event_length);
+    assert(qemu_plugin_crucible_fault_event_poll(
+        &event, event_payload, sizeof(event_payload), &event_length) == 0);
+#endif
+    assert(qemu_crucible_fault_vmstate_enable() == 0);
+    global_state_store();
+    file = qemu_file_new_output(QIO_CHANNEL(buffer));
+    status = qemu_save_device_state(file, &error);
+    if (error) {
+        error_report_err(error);
+        error = NULL;
+    }
+    assert(status == 0);
+    status = qemu_fflush(file);
+    fprintf(stderr, "ordinary aggregate flush status=%d\n", status);
+    assert(status == 0);
+    assert(buffer->usage);
+    assert(g_file_set_contents("aggregate-stream.bin", (char *)buffer->data,
+                               buffer->usage, &write_error));
+    assert(!write_error);
+    stream_hash = g_compute_checksum_for_data(G_CHECKSUM_SHA256,
+                                              buffer->data, buffer->usage);
+    fprintf(stderr, "ordinary aggregate stream bytes=%zu sha256=%s\n",
+            buffer->usage, stream_hash);
+    assert(qemu_fclose(file) == 0);
+
+    object_unref(OBJECT(buffer));
+    input = qio_channel_file_new_path("aggregate-stream.bin", O_RDONLY, 0, &error);
+    assert(input && !error);
+    file = qemu_file_new_input(QIO_CHANNEL(input));
+    status = qemu_load_device_state(file, &error);
+    if (error) {
+        error_report_err(error);
+        error = NULL;
+    }
+    assert(status == 0);
+    assert(qemu_fclose(file) == 0);
+    object_unref(OBJECT(input));
+
+    crucible_fault_command_restore_observe();
+    assert(!crucible_node_vmstate_prepared);
+    assert(owner->pending && owner->pending->issuance > pending_issuance);
+    assert(owner->pending->location == CRUCIBLE_PENDING_QUEUED);
+    assert(qemu_crucible_fault_node_pending_current_v1(owner->pending) == 0);
+    assert(owner->pending->callback_returned[CRUCIBLE_PENDING_ARM]);
+    assert(owner->pending_retirement.physically_returned);
+    assert(owner->pending_retirement.state_returned);
+    assert(owner->pending_retirement.payload_returned);
+    assert(owner->pending_retirement.row_returned);
+    assert(owner->validation.physically_returned);
+    assert(!owner->validation.first_status && !owner->validation.post_status);
+    assert(node_find_rule(command->command_kind, command->binding_hash, NULL));
+    assert(node_find_rule(command->command_kind, command->binding_hash, NULL) !=
+           original_rule);
+#ifndef CRUCIBLE_NODE_LIVE_CONSUME_EVENTS
+    assert(qemu_plugin_crucible_fault_event_poll(
+        &event, event_payload, sizeof(event_payload), &event_length) == 1);
+    assert(event.command_kind == CRUCIBLE_FAULT_COMMAND_NODE_HANG);
+    assert(event.model_phase == QEMU_CRUCIBLE_MODEL_PHASE_ARM);
+#define SAME_EVENT_FIELD(field) assert(event.field == original_event.field)
+    SAME_EVENT_FIELD(command_kind);
+    SAME_EVENT_FIELD(outcome);
+    SAME_EVENT_FIELD(model_phase);
+    SAME_EVENT_FIELD(target_kind);
+    SAME_EVENT_FIELD(evidence_length);
+    SAME_EVENT_FIELD(event_sequence);
+    SAME_EVENT_FIELD(rule_command_sequence);
+    SAME_EVENT_FIELD(observed_icount);
+    SAME_EVENT_FIELD(observed_tick);
+    SAME_EVENT_FIELD(generation);
+#undef SAME_EVENT_FIELD
+#define SAME_EVENT_HASH(field) assert(!memcmp(event.field, original_event.field, 32))
+    SAME_EVENT_HASH(binding_hash);
+    SAME_EVENT_HASH(opportunity_hash);
+    SAME_EVENT_HASH(action_hash);
+    SAME_EVENT_HASH(target_hash);
+    SAME_EVENT_HASH(before_hash);
+    SAME_EVENT_HASH(after_hash);
+#undef SAME_EVENT_HASH
+    assert(event_length == g_bytes_get_size(original_envelope));
+    assert(!memcmp(event_payload, g_bytes_get_data(original_envelope, NULL),
+                   event_length));
+    assert(g_file_set_contents("aggregate-restored-event.bin",
+                               (char *)event_payload, event_length, &write_error));
+    assert(!write_error);
+#endif
+    puts("PASS actual ordinary aggregate rule and queued-command restore");
+}
diff --git a/tests/unit/crucible-initial-cpu-fixture.inc.h b/tests/unit/crucible-initial-cpu-fixture.inc.h
new file mode 100644
index 0000000000000000000000000000000000000000..fb5e250cd9af288181bfddfb39b110a2dc148fe4
--- /dev/null
+++ b/tests/unit/crucible-initial-cpu-fixture.inc.h
@@ -0,0 +1,72 @@
+/*
+ * Checks inside an actual initial CPU callback; no issuer or provider model.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+static void initial_cpu_fixture_entered(CPUState *cpu)
+{
+    struct QemuCrucibleInitialCpuParticipant *participant = cpu->crucible_initial_participant;
+
+    g_assert_nonnull(participant);
+
+    struct QemuCrucibleInitialCpuParticipant *holder_copy = participant;
+    QemuCrucibleNativeInvocationTicket ticket_copy = initial_cpu_dispatch.callback_ticket;
+    struct QemuCrucibleFingerprintOperation *operation = &participant->binding->operation;
+    uint64_t original_serial = operation->serial;
+    uint64_t original_start = operation->start_ns;
+    uint64_t original_progress = operation->progress_ns;
+    CPUState cpu_copy = *cpu;
+
+    g_assert_true(participant->held);
+    g_assert_true(participant->entered);
+    g_assert_true(participant->module_callback_active);
+    g_assert_false(participant->module_callback_returned);
+    g_assert_false(operation->post_recorded);
+    g_assert_true(operation->held);
+    g_assert_cmpuint(operation->class_index, ==, 0);
+    g_assert_cmpuint(participant->operation_serial, ==, original_serial);
+    g_assert_cmpint(qemu_crucible_source_initial_cpu_current_v1(
+        cpu, &cpu->crucible_initial_participant), ==, 0);
+    g_assert_cmpint(qemu_crucible_source_initial_cpus_closed_v1(), ==, -EBUSY);
+    g_assert_cmpint(qemu_crucible_source_initial_cpu_return_v1(
+        cpu, &cpu->crucible_initial_participant), <, 0);
+
+    g_assert_cmpint(qemu_crucible_source_initial_cpu_current_v1(cpu, &holder_copy), <, 0);
+    g_assert_cmpint(qemu_crucible_source_initial_cpu_current_v1(
+        &cpu_copy, &cpu_copy.crucible_initial_participant), <, 0);
+    g_assert_cmpint(qemu_plugin_crucible_native_initial_cpu_current_v1(cpu, &ticket_copy), <, 0);
+
+    QemuCrucibleNativeInvocationTicket nested = qemu_plugin_crucible_native_mask_v1(
+        &initial_cpu_fixture_entered, initial_cpu_fixture_entered, NULL);
+
+    g_assert_cmpint(qemu_crucible_source_initial_cpu_current_v1(
+        cpu, &cpu->crucible_initial_participant), <, 0);
+    qemu_plugin_crucible_native_exit_v1(nested);
+    g_assert_cmpint(qemu_crucible_source_initial_cpu_current_v1(
+        cpu, &cpu->crucible_initial_participant), ==, 0);
+    g_assert_cmpuint(operation->serial, ==, original_serial);
+    g_assert_cmpuint(operation->start_ns, ==, original_start);
+    g_assert_cmpuint(operation->progress_ns, ==, original_progress);
+    g_assert_true(cpu->crucible_initial_participant == participant);
+}
+
+static void initial_cpu_fixture_missing_payer(CPUState *cpu)
+{
+    struct QemuCrucibleInitialCpuParticipant *participant = cpu->crucible_initial_participant;
+    uint16_t architecture = UINT16_MAX;
+
+    g_assert_cmpint(qemu_plugin_crucible_initial_cpu_sdk_begin_v1(), ==, -ENOKEY);
+    g_assert_cmpint(participant->sdk_first_status, ==, -ENOKEY);
+    g_assert_cmpint(participant->sdk_post_status, ==, 0);
+    g_assert_cmpint(participant->first_status, ==, -ENOKEY);
+    g_assert_null(qemu_plugin_get_registers());
+    g_assert_cmpuint(qemu_plugin_crucible_fault_hardware_error_manifest(
+        NULL, 0, &architecture), ==, 0);
+    g_assert_cmpuint(architecture, ==, UINT16_MAX);
+    g_assert_false(startup_source.initial_hardware_catalogue.attempted);
+    g_assert_false(startup_source.initial_hardware_catalogue.held);
+    g_assert_true(participant->held);
+    g_assert_true(participant->module_callback_active);
+    g_assert_false(participant->module_callback_returned);
+    g_assert_false(participant->physically_returned);
+}
