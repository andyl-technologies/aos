+int qemu_plugin_crucible_ram_capture_rebind_v1(void)
+{
+    bool research_selected = qatomic_read(&research_resident.state) !=
+        RESEARCH_RESIDENT_ABSENT;
+
+    /* Preserve original validation/first-error priority while closing this
+     * unsupported class before any transition callback or authority effect. */
+    if (research_selected) {
+        qemu_plugin_crucible_ram_research_resident_refuse_transition_v1();
+    }
+
+    if (!bql_locked() || capture_active || mutation_writer_scope ||
+        !admission_regions || !runstate_check(RUN_STATE_PAUSED) ||
+        capture_generation == UINT64_MAX) {
+        return -EBUSY;
+    }
+    if (qemu_crucible_ram_diagnostic_failure()) {
+        return qemu_crucible_ram_diagnostic_failure();
+    }
+    if (research_selected) {
+        return -ENOTSUP;
+    }
+    /* The child owns COW-private bitmap/capture authority. Topology identity
+     * remains stable so the inherited immutable root cache remains reusable.
+     */
+    capture_generation++;
+    qemu_crucible_ram_dirty_generation_advance();
+    return 0;
+}
