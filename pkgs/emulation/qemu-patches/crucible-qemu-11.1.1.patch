+    'include/system/memory_cached.h':
+        '33db362075a85b1326d38c9d772f131e4bdd7cada5e68a47b99515a1ac33e61b',
+    'include/system/memory_ldst_cached.h.inc':
+        '0330f0a65ef81d51ba040b8512cd00bb06cb117a81a954b202132a2a6da48d2d',
+    'tests/unit/test-crucible-cached-writer.c':
