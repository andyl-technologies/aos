+static void fork_and_verify(bool held, bool observe_before_enable)
+{
+    int status;
+    pid_t child;
+
+    if (observe_before_enable) {
+        g_assert_cmpint(pthread_atfork(NULL, fork_parent_observer,
+                                      fork_child_observer), ==, 0);
+    }
+    replay_mutex_enable();
+    if (!observe_before_enable) {
+        g_assert_cmpint(pthread_atfork(NULL, fork_parent_observer,
+                                      fork_child_observer), ==, 0);
+    }
+    if (!held) {
+        replay_mutex_unlock();
+    }
+
+    callback_expected_owned = held;
+    callback_expected_locked = held;
+    child = fork();
+    g_assert_cmpint(child, >=, 0);
+    if (child == 0) {
+        g_assert_true(child_observer_called);
+        g_assert_false(parent_observer_called);
+        g_assert_cmpint(replay_mutex_locked(), ==, held);
+        g_assert_false(replay_mutex_owned());
+        if (held) {
+            /* The copied fair token must still be released exactly once. */
+            replay_mutex_unlock();
+        }
+        assert_reacquired();
+        _exit(EXIT_SUCCESS);
+    }
+
+    g_assert_true(parent_observer_called);
+    g_assert_false(child_observer_called);
+    g_assert_cmpint(waitpid(child, &status, 0), ==, child);
+    g_assert_true(WIFEXITED(status));
+    g_assert_cmpint(WEXITSTATUS(status), ==, EXIT_SUCCESS);
+    g_assert_cmpint(replay_mutex_locked(), ==, held);
+    g_assert_cmpint(replay_mutex_owned(), ==, held);
+    if (held) {
+        replay_mutex_unlock();
+    }
+    assert_reacquired();
+}
+
+static void test_fork_held(void)
+{
+    if (enter_subprocess()) {
+        fork_and_verify(true, false);
+    }
+}
+
+static void test_fork_unlocked(void)
+{
+    if (enter_subprocess()) {
+        fork_and_verify(false, false);
+    }
+}
+
+static void test_earlier_fork_observer(void)
+{
+    if (enter_subprocess()) {
+        fork_and_verify(true, true);
+    }
+}
+
+static void test_earlier_unlocked_observer(void)
+{
+    if (enter_subprocess()) {
+        fork_and_verify(false, true);
+    }
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+
+    /* Forks require the persistent RCU worker to finish registration. */
+    drain_call_rcu();
+
+    g_test_add_func("/replay-owner/acquisition", test_acquisition);
+    g_test_add_func("/replay-owner/replacement-thread", test_replacement_thread);
+    g_test_add_func("/replay-owner/contending-waiter-ownership",
+                    test_contending_waiter_ownership);
+    g_test_add_func("/replay-owner/fork-held", test_fork_held);
+    g_test_add_func("/replay-owner/fork-unlocked", test_fork_unlocked);
+    g_test_add_func("/replay-owner/earlier-held-observer",
+                    test_earlier_fork_observer);
+    g_test_add_func("/replay-owner/earlier-unlocked-observer",
+                    test_earlier_unlocked_observer);
+    return g_test_run();
+}
diff --git a/tests/unit/test-crucible-riscv-cpc-clock.c b/tests/unit/test-crucible-riscv-cpc-clock.c
new file mode 100644
index 0000000000000000000000000000000000000000..6a18a6e4dcca7ec12163834700cc92a31e2360da
--- /dev/null
+++ b/tests/unit/test-crucible-riscv-cpc-clock.c
@@ -0,0 +1,217 @@
+/*
+ * Literal CPC MTIME reads with a controlled virtual-clock producer.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/main-loop.h"
+#include "system/cpu-timers.h"
+#include "exec/icount.h"
+#include "io/channel-buffer.h"
+#include "../../migration/qemu-file.h"
+
+/* Keep the actual reader and VMState without realizing CPUs or a board. */
+#undef type_init
+#define type_init(function) \
+    static void (*const fixture_##function)(void) G_GNUC_UNUSED = function;
+#include "../../hw/misc/riscv_cpc.c"
+
+static __int128 observed_ps;
+static unsigned nanosecond_reads;
+
+/* Diagnostic CPU-clock adapter, not an installed TCG/controller provider. */
+int64_t cpu_get_clock(void)
+{
+    __int128 nanoseconds = observed_ps / PICOSECONDS_PER_NANOSECOND;
+
+    nanosecond_reads++;
+    if (nanoseconds < 0 || nanoseconds > INT64_MAX) {
+        g_error("Diagnostic nanosecond projection exceeds the API range");
+    }
+    return nanoseconds;
+}
+
+bool icount_crucible_sim_mode(void)
+{
+    return false;
+}
+
+static __int128 observed_clock_ps(void)
+{
+    return observed_ps;
+}
+
+static void initialize_clock(bool exact)
+{
+    Error *error = NULL;
+
+    module_call_init(MODULE_INIT_QOM);
+    qemu_init_main_loop(&error);
+    g_assert_null(error);
+    if (exact) {
+        qemu_timer_enable_tcg_ps_clock(NULL, observed_clock_ps);
+    }
+    qemu_clock_enable(QEMU_CLOCK_VIRTUAL, true);
+    nanosecond_reads = 0;
+}
+
+static uint64_t read_mtime(RISCVCPCState *controller)
+{
+    return cpc_ops.read(controller, CPC_MTIME_REG_OFS, sizeof(uint64_t));
+}
+
+static void test_tick_boundaries(void)
+{
+    RISCVCPCState controller = { 0 };
+    const __int128 times[] = { 0, 1, 999, 1000, 99999, 100000,
+                              100001, 100999, 199999, 200000 };
+    const uint64_t ticks[] = { 0, 0, 0, 0, 0, 1, 1, 1, 1, 2 };
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    initialize_clock(true);
+    for (size_t i = 0; i < G_N_ELEMENTS(times); i++) {
+        observed_ps = times[i];
+        g_assert_cmpuint(read_mtime(&controller), ==, ticks[i]);
+    }
+}
+
+static void test_wide_clock(void)
+{
+    RISCVCPCState controller = { 0 };
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    initialize_clock(true);
+    observed_ps = ((__int128)INT64_MAX + 1) *
+                  PICOSECONDS_PER_NANOSECOND + 999;
+    g_assert_cmpuint(read_mtime(&controller), ==, 92233720368547758ULL);
+    g_assert_cmpuint(nanosecond_reads, ==, 0);
+}
+
+static void test_counter_wrap(void)
+{
+    RISCVCPCState controller = { 0 };
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    initialize_clock(true);
+    observed_ps = (__int128)UINT64_MAX * 100000 + 99999;
+    g_assert_cmpuint(read_mtime(&controller), ==, UINT64_MAX);
+    observed_ps++;
+    g_assert_cmpuint(read_mtime(&controller), ==, 0);
+    observed_ps += 100000;
+    g_assert_cmpuint(read_mtime(&controller), ==, 1);
+    g_assert_cmpuint(nanosecond_reads, ==, 0);
+}
+
+static void test_legacy_clock(void)
+{
+    RISCVCPCState controller = { 0 };
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    initialize_clock(false);
+    observed_ps = 99999;
+    g_assert_cmpuint(read_mtime(&controller), ==, 0);
+    observed_ps = 100001;
+    g_assert_cmpuint(read_mtime(&controller), ==, 1);
+    observed_ps = (__int128)INT64_MAX * PICOSECONDS_PER_NANOSECOND;
+    g_assert_cmpuint(read_mtime(&controller), ==, 92233720368547758ULL);
+    g_assert_cmpuint(nanosecond_reads, ==, 3);
+}
+
+static void test_other_registers(void)
+{
+    RISCVCPCState controller = { .num_core = 2 };
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    initialize_clock(true);
+    observed_ps = (__int128)UINT64_MAX * 100000;
+    g_assert_cmpuint(cpc_ops.read(&controller, CPC_CM_STAT_CONF_OFS, 8), ==,
+                     CPC_Cx_STAT_CONF_SEQ_STATE_U5);
+    for (unsigned core = 0; core < controller.num_core; core++) {
+        g_assert_cmpuint(cpc_ops.read(&controller,
+                                    CPC_CL_BASE_OFS + CPC_STAT_CONF_OFS +
+                                    core * CPC_CORE_REG_STRIDE, 8), ==,
+                         CPC_Cx_STAT_CONF_SEQ_STATE_U6);
+    }
+    g_assert_cmpuint(nanosecond_reads, ==, 0);
+}
+
+static void test_vmstate(void)
+{
+    RISCVCPCState original = { .vps_running_mask = 0x123456789abcdef0ULL };
+    RISCVCPCState restored = { 0 };
+    QIOChannelBuffer *output;
+    QIOChannelBuffer *input;
+    QEMUFile *file;
+    Error *error = NULL;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    initialize_clock(true);
+    observed_ps = ((__int128)INT64_MAX + 1) *
+                  PICOSECONDS_PER_NANOSECOND + 999;
+    output = qio_channel_buffer_new(32);
+    file = qemu_file_new_output(QIO_CHANNEL(output));
+    g_assert_cmpint(vmstate_save_state(file, &vmstate_riscv_cpc, &original,
+                                      NULL, &error), ==, 0);
+    g_assert_null(error);
+    qemu_fflush(file);
+    /* MTIME remains derived from the restored clock, with no new wire field. */
+    g_assert_cmpuint(output->usage, ==, sizeof(uint64_t));
+    input = qio_channel_buffer_new(output->usage);
+    input->usage = output->usage;
+    memcpy(input->data, output->data, output->usage);
+    qemu_fclose(file);
+    object_unref(OBJECT(output));
+
+    file = qemu_file_new_input(QIO_CHANNEL(input));
+    g_assert_cmpint(vmstate_load_state(file, &vmstate_riscv_cpc, &restored,
+                                      0, &error), ==, 0);
+    g_assert_null(error);
+    g_assert_cmpuint(restored.vps_running_mask, ==, original.vps_running_mask);
+    g_assert_cmpuint(read_mtime(&restored), ==, read_mtime(&original));
+    g_assert_cmpuint(nanosecond_reads, ==, 0);
+    qemu_fclose(file);
+    object_unref(OBJECT(input));
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/cpc/clock/tick-boundaries", test_tick_boundaries);
+    g_test_add_func("/cpc/clock/wide", test_wide_clock);
+    g_test_add_func("/cpc/clock/wrap", test_counter_wrap);
+    g_test_add_func("/cpc/clock/legacy", test_legacy_clock);
+    g_test_add_func("/cpc/clock/other-registers", test_other_registers);
+    g_test_add_func("/cpc/clock/vmstate", test_vmstate);
+    return g_test_run();
+}
