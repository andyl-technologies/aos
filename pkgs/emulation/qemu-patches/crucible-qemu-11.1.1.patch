+static bool crucible_fault_memory_pages_eligible(
+    const MMULookupLocals *lookup, bool crosspage)
+{
+    unsigned int page_count = crosspage ? 2 : 1;
+
+    for (unsigned int i = 0; i < page_count; i++) {
+        if (lookup->page[i].flags & TLB_MMIO) {
+            return false;
+        }
+    }
+    return true;
