diff --git a/target/s390x/tcg/s390-tod.h b/target/s390x/tcg/s390-tod.h
index 8b74d6a6d886080ece7aaacca60018c88f190aca..af7e7053e97b15cc7e40cefcc77df4ce4ef85a90 100644
--- a/target/s390x/tcg/s390-tod.h
+++ b/target/s390x/tcg/s390-tod.h
@@ -14,6 +14,79 @@
 /* The value of the TOD clock for 1.1.1970. */
 #define TOD_UNIX_EPOCH 0x7d91048bca000000ULL
 
+#define TOD_UNITS_PER_MICROSECOND 4096
+#define PICOSECONDS_PER_MICROSECOND 1000000
+#define TOD_CLOCK_BITS 72
+
+/* Converts signed ps to s390 clock units, rounding toward negative infinity. */
+static inline __int128 ps2tod(__int128 ps)
+{
+    /*
+     * Scaling the absolute clock first would overflow within its legal range.
+     */
+    __int128 whole = ps / PICOSECONDS_PER_MICROSECOND;
+    __int128 remainder = ps % PICOSECONDS_PER_MICROSECOND;
+    __int128 numerator = remainder * TOD_UNITS_PER_MICROSECOND;
+    __int128 result = whole * TOD_UNITS_PER_MICROSECOND +
+                      numerator / PICOSECONDS_PER_MICROSECOND;
+
+    if (numerator % PICOSECONDS_PER_MICROSECOND < 0) {
+        result--;
+    }
+    return result;
+}
+
+/* Converts signed s390 clock units to ps without scheduling early. */
+static inline __int128 tod2ps_ceil(__int128 tod)
+{
+    __int128 numerator = tod * PICOSECONDS_PER_MICROSECOND;
+    __int128 result = numerator / TOD_UNITS_PER_MICROSECOND;
+
+    if (numerator % TOD_UNITS_PER_MICROSECOND > 0) {
+        result++;
+    }
+    return result;
+}
+
+/* Adds signed clock units to the architected 72-bit TOD clock. */
+static inline void s390_tod_add_units(uint8_t *high, uint64_t *low,
+                                      __int128 units)
+{
+    unsigned __int128 value = ((unsigned __int128)*high << 64) | *low;
+
+    value += units;
+    *high = value >> 64;
+    *low = value;
+}
+
+/* Adds a signed ps interval to the architected 72-bit TOD clock. */
+static inline void s390_tod_add_ps(uint8_t *high, uint64_t *low,
+                                   __int128 time_ps)
+{
+    s390_tod_add_units(high, low, ps2tod(time_ps));
+}
+
+/* Returns the canonical signed distance between two 72-bit TOD values. */
+static inline __int128 s390_tod_delta(uint8_t target_high,
+                                      uint64_t target_low,
+                                      uint8_t base_high,
+                                      uint64_t base_low)
+{
+    const unsigned __int128 modulus = (unsigned __int128)1 << TOD_CLOCK_BITS;
+    const unsigned __int128 sign = modulus >> 1;
+    const unsigned __int128 mask = modulus - 1;
+    unsigned __int128 target =
+        ((unsigned __int128)target_high << 64) | target_low;
+    unsigned __int128 base =
+        ((unsigned __int128)base_high << 64) | base_low;
+    unsigned __int128 delta = (target - base) & mask;
+
+    if (delta & sign) {
+        return (__int128)(delta - modulus);
+    }
+    return delta;
+}
+
