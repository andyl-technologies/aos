+int qemu_crucible_hot_fork_merge_child_resource_contribution(
+    QemuCrucibleHotForkChildResourcePlan *resources,
+    const QemuCrucibleHotForkDescriptorReplacement *replacements,
+    size_t replacement_count,
+    const int *retained_fds, size_t retained_fd_count,
+    const QemuCrucibleHotForkSharedMapping *shared_mappings,
+    size_t shared_mapping_count)
+{
+    size_t replacement_union_count;
+    size_t fd_union_count;
+    size_t mapping_union_count;
+    size_t index;
+    int result;
+
+    if (!resources || !resources->building || resources->sealed ||
+        resources->attempted || resources->applied) {
+        return -EPERM;
+    }
+    if (resources->replacement_count >
+            QEMU_CRUCIBLE_HOT_FORK_MAX_DESCRIPTOR_REPLACEMENTS ||
+        resources->retained_fd_count >
+            QEMU_CRUCIBLE_HOT_FORK_MAX_RETAINED_DESCRIPTORS ||
+        resources->shared_mapping_count >
+            QEMU_CRUCIBLE_HOT_FORK_MAX_SHARED_MAPPINGS ||
+        !crucible_hot_fork_replacement_table_valid(
+            resources->replacements, resources->replacement_count) ||
+        !crucible_hot_fork_fd_table_valid(
+            resources->retained_fds, resources->retained_fd_count) ||
+        !crucible_hot_fork_mapping_table_valid(
+            resources->shared_mappings, resources->shared_mapping_count)) {
+        return -EINVAL;
+    }
+    if (replacement_count >
+            QEMU_CRUCIBLE_HOT_FORK_MAX_DESCRIPTOR_REPLACEMENTS ||
+        retained_fd_count > QEMU_CRUCIBLE_HOT_FORK_MAX_RETAINED_DESCRIPTORS ||
+        shared_mapping_count > QEMU_CRUCIBLE_HOT_FORK_MAX_SHARED_MAPPINGS) {
+        return -E2BIG;
+    }
+    if (!crucible_hot_fork_replacement_table_valid(
+            replacements, replacement_count) ||
+        !crucible_hot_fork_fd_table_valid(retained_fds, retained_fd_count) ||
+        !crucible_hot_fork_mapping_table_valid(
+            shared_mappings, shared_mapping_count)) {
+        return -EINVAL;
+    }
+    if (resources->qmp.prepared) {
+        for (index = 0; index < replacement_count; index++) {
+            if (replacements[index].source_fd == resources->qmp.retained_fd ||
+                replacements[index].target_fd == resources->qmp.retained_fd) {
+                return -EINVAL;
+            }
+        }
+        for (index = 0; index < shared_mapping_count; index++) {
+            if (shared_mappings[index].backing_fd ==
+                    resources->qmp.retained_fd) {
+                return -EINVAL;
+            }
+        }
+    }
+    if (crucible_hot_fork_replacement_tables_conflict(
+            resources->replacements, resources->replacement_count,
+            replacements, replacement_count)) {
+        return -EINVAL;
+    }
+    replacement_union_count = crucible_hot_fork_replacement_union_count(
+        resources->replacements, resources->replacement_count,
+        replacements, replacement_count);
+    if (replacement_union_count >
+            QEMU_CRUCIBLE_HOT_FORK_MAX_DESCRIPTOR_REPLACEMENTS) {
+        return -E2BIG;
+    }
+
+    for (index = 0; index < retained_fd_count; index++) {
+        for (size_t replacement = 0;
+             replacement < resources->replacement_count; replacement++) {
+            if (retained_fds[index] ==
+                    resources->replacements[replacement].source_fd) {
+                return -EINVAL;
+            }
+        }
+        for (size_t replacement = 0; replacement < replacement_count;
+             replacement++) {
+            if (retained_fds[index] == replacements[replacement].source_fd) {
+                return -EINVAL;
+            }
+        }
+    }
+    for (index = 0; index < resources->retained_fd_count; index++) {
+        for (size_t replacement = 0; replacement < replacement_count;
+             replacement++) {
+            if (resources->retained_fds[index] ==
+                    replacements[replacement].source_fd) {
+                return -EINVAL;
+            }
+        }
+    }
+    fd_union_count = crucible_hot_fork_fd_union_count(
+        resources->retained_fds, resources->retained_fd_count,
+        retained_fds, retained_fd_count);
+    if (fd_union_count > QEMU_CRUCIBLE_HOT_FORK_MAX_RETAINED_DESCRIPTORS) {
+        return -E2BIG;
+    }
+    for (index = 0; index < replacement_count; index++) {
+        int target = replacements[index].target_fd;
+
+        if (!crucible_hot_fork_fd_table_contains(
+                resources->retained_fds, resources->retained_fd_count,
+                target) &&
+            !crucible_hot_fork_fd_table_contains(
+                retained_fds, retained_fd_count, target)) {
+            return -EINVAL;
+        }
+    }
+
+    result = crucible_hot_fork_mapping_union_count(
+        resources->shared_mappings, resources->shared_mapping_count,
+        shared_mappings, shared_mapping_count, &mapping_union_count);
+    if (result != 0) {
+        return result;
+    }
+    if (mapping_union_count > QEMU_CRUCIBLE_HOT_FORK_MAX_SHARED_MAPPINGS) {
+        return -E2BIG;
+    }
+    for (index = 0; index < shared_mapping_count; index++) {
+        int backing_fd = shared_mappings[index].backing_fd;
+
+        if (!crucible_hot_fork_fd_table_contains(
+                resources->retained_fds, resources->retained_fd_count,
+                backing_fd) &&
+            !crucible_hot_fork_fd_table_contains(
+                retained_fds, retained_fd_count, backing_fd)) {
+            return -EINVAL;
+        }
+    }
+
+    crucible_hot_fork_merge_replacement_tables(
+        resources->replacements, resources->replacement_count,
+        replacements, replacement_count, replacement_union_count);
+    resources->replacement_count = replacement_union_count;
+    crucible_hot_fork_merge_fd_tables(
+        resources->retained_fds, resources->retained_fd_count,
+        retained_fds, retained_fd_count, fd_union_count);
+    resources->retained_fd_count = fd_union_count;
+    crucible_hot_fork_merge_mapping_tables(
+        resources->shared_mappings, resources->shared_mapping_count,
+        shared_mappings, shared_mapping_count, mapping_union_count);
+    resources->shared_mapping_count = mapping_union_count;
+    return 0;
+}
