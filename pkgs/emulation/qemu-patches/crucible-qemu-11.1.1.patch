+    if native_without_plugin_redeclaration(declaration, declaration) != "":
+        raise ValueError("shared plugin declaration was not composed once")
+    for invalid in (
+        declaration + declaration,
+        "extern const struct qemu_plugin_state plugin;\n",
+        "#ifdef FEATURE\n" + declaration + "#endif\n",
+        "/*\n" + declaration + "*/\n",
+        "void local(void) {\n" + declaration + "}\n",
