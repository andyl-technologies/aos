--- /dev/null
+++ b/include/qemu/crucible-socket-ingress.h
@@ -0,0 +1,43 @@
+/*
+ * Process-private selected socket receive custody
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef QEMU_CRUCIBLE_SOCKET_INGRESS_H
+#define QEMU_CRUCIBLE_SOCKET_INGRESS_H
+
+#include "qemu/typedefs.h"
+
+typedef struct QIOChannel QIOChannel;
+
+typedef struct QemuCrucibleSocketIngressLoan QemuCrucibleSocketIngressLoan;
+
+/* Only the authentic retained process/Monitor family can issue this loan.
+ * Geometry comes from the actual QIO socket body. Admission precedes receive
+ * and allocates a bounded int array; it grants no request/original authority.
+ * Unselected calls return zero with NULL loan and preserve generic behavior.
+ */
+int qemu_crucible_socket_ingress_begin(
+    Chardev *chardev, QIOChannel *channel, uint64_t control_bytes,
+    size_t descriptor_capacity, QemuCrucibleSocketIngressLoan **out,
+    int **descriptors);
+
+/* Journal authentic physical receipt separately from operation acceptance.
+ * Ambiguous receipt or independent post failure retains the array, references
+ * and debit in Source custody; it never permits another receive or numerical
+ * close/retry. Zero allows the existing frontend to consume this landing only.
+ */
+int qemu_crucible_socket_ingress_finish(
+    QemuCrucibleSocketIngressLoan *loan, int *descriptors,
+    size_t descriptor_count, ssize_t received, int receive_errno);
+
+/* The actual receive actor or current Monitor dispatcher performs handoff
+ * and once-close under this retained owner. The owner derives cleanup outcomes
+ * itself, frees its concrete array only after every actual alias disposition,
+ * and returns the number copied to the frontend. NULL output/count0 closes
+ * every remaining alias. Refusal changes no output and retains custody.
+ */
+int qemu_crucible_socket_ingress_release(
+    QemuCrucibleSocketIngressLoan *loan, Chardev *chardev,
+    int *descriptors, size_t descriptor_capacity);
+
+#endif
