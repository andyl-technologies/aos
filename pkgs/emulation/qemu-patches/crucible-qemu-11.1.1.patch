+/* The existing paused boundary retains one physical owner across two fresh
+ * observations. Neither diagnostic capture nor comparison acknowledges dirties. */
+void qemu_crucible_ram_diagnostic_paused_owner(void)
+{
+    int64_t raw = icount_get_raw_observed();
+    CrucibleRamOwnerDiagnostic *result = NULL;
+    qemu_plugin_crucible_ram_root_observer_v2 observer;
+    uint8_t incremental[32], complete[32];
+    uint64_t incremental_bytes = 0, complete_bytes = 0;
+
+    for (size_t index = 0; index < G_N_ELEMENTS(owner_diagnostics); index++) {
+        if (raw >= 0 && (uint64_t)raw == owner_diagnostic_stops[index] &&
+            !owner_diagnostics[index].attempted) {
+            result = &owner_diagnostics[index];
+            break;
+        }
+    }
+    if (!result || qemu_crucible_ram_diagnostic_failure() ||
+        !runstate_check(RUN_STATE_PAUSED) ||
+        !qemu_plugin_crucible_vmstop_quiesced()) {
+        return;
+    }
+    result->attempted = true;
+    result->raw_icount = raw;
+    result->vmstop_generation = qemu_plugin_crucible_vmstop_generation();
+    result->topology_generation = qatomic_read(&topology_generation);
+    if (!bql_locked() || current_cpu || !runstate_check(RUN_STATE_PAUSED) ||
+        !qemu_plugin_crucible_vmstop_quiesced() ||
+        qemu_plugin_crucible_control_boundary_active() ||
+        qemu_plugin_crucible_exact_boundary_active() || capture_active ||
+        restore_staged || restore_destructive || mutation_writer_scope ||
+        mutation_preflight_scope || physical_token || !admission_regions ||
+        admission_grant_open || !admission_grant_applied ||
+        admission.topology_generation != result->topology_generation) {
+        result->first_status = -EBUSY;
+    } else {
+        result->first_status = qemu_plugin_crucible_ram_physical_begin_v1(
+            result->topology_generation, &result->token);
+        if (!result->first_status) {
+            result->first_status = qemu_plugin_crucible_ram_physical_validate_v1(
+                result->token, result->topology_generation);
+        }
+        if (!result->first_status &&
+            (result->vmstop_generation != qemu_plugin_crucible_vmstop_generation() ||
+             result->raw_icount != (uint64_t)icount_get_raw_observed() ||
+             !runstate_check(RUN_STATE_PAUSED) ||
+             !qemu_plugin_crucible_vmstop_quiesced())) {
+            result->first_status = -ESTALE;
+        }
+        observer = qatomic_load_acquire(&root_observer);
+        if (!result->first_status && !observer) {
+            result->first_status = -ENOSYS;
+        }
+        if (!result->first_status) {
+            result->first_status = observer(
+                0, result->token, incremental, &incremental_bytes,
+                &result->capture_close);
+        }
+        if (!result->first_status) {
+            if (result->capture_close.attempted != 1 ||
+                !result->capture_close.generation || capture_active) {
+                result->first_status = result->capture_close.status < 0 ?
+                    result->capture_close.status : -EPROTO;
+            } else if (result->capture_close.status) {
+                result->first_status = result->capture_close.status;
+            }
+        }
+        if (!result->first_status) {
+            result->first_status = qemu_plugin_crucible_ram_physical_validate_v1(
+                result->token, result->topology_generation);
+        }
+        if (!result->first_status) {
+            result->first_status = qemu_plugin_crucible_ram_full_root_v2(
+                0, result->token, complete, &complete_bytes);
+        }
+        if (!result->first_status) {
+            result->first_status = qemu_plugin_crucible_ram_physical_validate_v1(
+                result->token, result->topology_generation);
+        }
+        if (!result->first_status &&
+            (incremental_bytes != complete_bytes ||
+             memcmp(incremental, complete, sizeof(incremental)))) {
+            result->first_status = -EBADMSG;
+        }
+        if (result->first_status) {
+            /* Contain every identity before releasing parked writer owners. */
+            qemu_crucible_ram_diagnostic_fail(result->first_status);
+        }
+        if (result->token) {
+            struct qemu_plugin_crucible_ram_physical_end_v2 end = {
+                .schema_version = 2, .struct_size = sizeof(end),
+            };
+
+            result->release_status = qemu_plugin_crucible_ram_physical_end_v2(
+                result->token, &end);
+            result->release = end;
+        }
+    }
+    if (result->first_status || result->release_status) {
+        qemu_crucible_ram_diagnostic_fail(result->first_status ?
+            result->first_status : result->release_status);
+    }
+    qemu_crucible_ram_owner_diagnostic_report(result);
+}
+
+static void hash_u32(blake3_hasher *hasher, uint32_t value)
+{
+    uint8_t bytes[4];
+
+    stl_be_p(bytes, value);
+    blake3_hasher_update(hasher, bytes, sizeof(bytes));
+}
+
+static void hash_u64(blake3_hasher *hasher, uint64_t value)
+{
+    uint8_t bytes[8];
+
+    stq_be_p(bytes, value);
+    blake3_hasher_update(hasher, bytes, sizeof(bytes));
+}
+
+static void hash_string(blake3_hasher *hasher, const uint8_t *bytes, uint32_t length)
+{
+    hash_u32(hasher, length);
+    blake3_hasher_update(hasher, bytes, length);
+}
+
+static void hash_tag(blake3_hasher *hasher, const char *name)
+{
+    static const char prefix[] = "crucible.ram.";
+    static const char suffix[] = ".v1";
+
+    blake3_hasher_init(hasher);
+    blake3_hasher_update(hasher, prefix, sizeof(prefix) - 1);
+    blake3_hasher_update(hasher, name, strlen(name));
+    /* The suffix's one terminating zero belongs to the canonical tag. */
+    blake3_hasher_update(hasher, suffix, sizeof(suffix));
+}
+
+static void hash_page(blake3_hasher *hasher, const uint8_t *bytes,
+                      uint32_t valid_length, uint8_t digest[32])
+{
+    hash_tag(hasher, "page");
+    hash_u32(hasher, valid_length);
+    blake3_hasher_update(hasher, bytes, valid_length);
+    blake3_hasher_finalize(hasher, digest, 32);
+}
+
+int qemu_plugin_crucible_ram_page_digest_v1(
+    const uint8_t *bytes, uint32_t valid_length, uint8_t digest[32])
+{
+    blake3_hasher hasher;
+
+    if (!bytes || !digest || valid_length == 0 || valid_length > RAM_PAGE_BYTES) {
+        return -EINVAL;
+    }
+    hash_page(&hasher, bytes, valid_length, digest);
+    return 0;
+}
+
+static void hash_descriptor(blake3_hasher *hasher, const CrucibleRamRegion *region)
+{
+    uint8_t classification[2] = {
+        region->descriptor.region_class, region->descriptor.scope_mask,
+    };
+
+    hash_string(hasher, region->descriptor.id, region->descriptor.id_length);
+    blake3_hasher_update(hasher, classification, sizeof(classification));
+    hash_u64(hasher, region->descriptor.logical_length);
+}
+
+int qemu_plugin_crucible_ram_capture_topology_v2(
+    uint64_t generation, uint64_t owner_token, uint8_t digest[32])
+{
+    blake3_hasher hasher;
+
+    if (!digest || !capture_valid(generation, owner_token)) {
+        return -ESTALE;
+    }
+    hash_tag(&hasher, "topology");
+    hash_u32(&hasher, RAM_PAGE_BYTES);
+    hash_u32(&hasher, capture_regions->len);
+    for (size_t index = 0; index < capture_regions->len; index++) {
+        hash_descriptor(&hasher, region_inventory_index(capture_regions, index));
+    }
+    blake3_hasher_finalize(&hasher, digest, 32);
+    return 0;
+}
+
+/* The reader may borrow only this finalized native hasher, synchronously.
+ * It hashes actual response bytes before source readiness or reuse. */
+static int borrowed_hash_page(void *context, const uint8_t *bytes,
+                              uint32_t valid_length, uint8_t digest[32])
+{
+    blake3_hasher *hasher = context;
+    uint32_t offset = 0;
+
+    if (!context || !bytes || !digest || !valid_length || valid_length > RAM_PAGE_BYTES) {
+        return -EINVAL;
+    }
+
+    hash_tag(hasher, "page");
+    hash_u32(hasher, valid_length);
+
+    /* Each update stays within one BLAKE3 chunk. The borrowed-reader frames
+     * must not overlap the library's recursive subtree workspace. */
+    while (offset < valid_length) {
+        uint32_t take = MIN(valid_length - offset, BLAKE3_CHUNK_LEN);
+
+        blake3_hasher_update(hasher, bytes + offset, take);
+        offset += take;
+    }
+    blake3_hasher_finalize(hasher, digest, 32);
+    return 0;
+}
+
+static void diagnostic_proc_close_result(uint64_t token, int status)
+{
+    if (!status) {
+        return;
+    }
+    for (size_t index = 0; index < G_N_ELEMENTS(owner_diagnostics); index++) {
+        CrucibleRamOwnerDiagnostic *result = &owner_diagnostics[index];
+
+        if (result->attempted && result->token == token) {
+            if (!result->proc_close_status) {
+                result->proc_close_status = status;
+            }
+            return;
+        }
+    }
+}
+
+static int full_region_root(
+    const CrucibleRamRegion *region,
+    qemu_plugin_crucible_ram_root_scratch_read_v3 reader,
+    QemuCrucibleCheckpointCandidateReadLoan *candidate,
+    struct qemu_plugin_crucible_ram_root_scratch_v2 *scratch, uint8_t digest[32])
+{
+    uint64_t length = region->descriptor.logical_length;
+    uint64_t count = 1 + (length - 1) / RAM_PAGE_BYTES;
+    uint64_t width = 1;
+    uint32_t height = 0;
+    uint8_t stack[53][32];
+    uint8_t node[32];
+    uint8_t empty[32];
+    blake3_hasher hasher;
+    const struct qemu_plugin_crucible_ram_page_hasher_v3 hasher_loan = {
+        .hash = borrowed_hash_page,
+        .context = &hasher,
+    };
+
+    memset(scratch, 0, sizeof(*scratch));
+    while (width < count) {
+        width <<= 1;
+        height++;
+    }
+    hash_tag(&hasher, "empty");
+    blake3_hasher_finalize(&hasher, empty, 32);
+    for (uint64_t index = 0; index < width; index++) {
+        uint32_t level = 0;
+        uint64_t position = index;
+
+        if (index < count) {
+            uint32_t valid = MIN((uint64_t)RAM_PAGE_BYTES, length - index * RAM_PAGE_BYTES);
+            /* The callback lends no public output. A failed partial scratch
+             * read returns immediately, before hashing or root publication. */
+            uint64_t address = (uintptr_t)region->block->host +
+                               index * RAM_PAGE_BYTES;
+            int status = candidate ?
+                qemu_crucible_checkpoint_candidate_read_page_v1(
+                    candidate, address, scratch->bytes, valid) :
+                reader(address, scratch, valid, &hasher_loan);
+
+            if (status != 0) {
+                return status;
+            }
+            /* No prior hash state remains live after its digest is finalized. */
+            hash_page(&hasher, scratch->bytes, valid, node);
+            hash_tag(&hasher, "leaf");
+            blake3_hasher_update(&hasher, node, sizeof(node));
+            blake3_hasher_finalize(&hasher, node, sizeof(node));
+        } else {
+            memcpy(node, empty, sizeof(node));
+        }
+        while (position & 1) {
+            hash_tag(&hasher, "node");
+            hash_u32(&hasher, level + 1);
+            blake3_hasher_update(&hasher, stack[level], sizeof(node));
+            blake3_hasher_update(&hasher, node, sizeof(node));
+            blake3_hasher_finalize(&hasher, node, sizeof(node));
+            position >>= 1;
+            level++;
+        }
+        memcpy(stack[level], node, sizeof(node));
+    }
+    hash_tag(&hasher, "region-tree");
+    hash_u64(&hasher, length);
+    hash_u64(&hasher, count);
+    hash_u32(&hasher, height);
+    blake3_hasher_update(&hasher, stack[height], sizeof(node));
+    blake3_hasher_finalize(&hasher, digest, 32);
+    return 0;
+}
+
+/* Completed observations belong only to this invocation. Partial roots are
+ * never consumed by the aggregate phase or by production capture/cache paths. */
+static int full_observe_regions(
+    CrucibleRamInventory *regions, uint32_t scope,
+    qemu_plugin_crucible_ram_root_scratch_read_v3 reader,
+    QemuCrucibleCheckpointCandidateReadLoan *candidate,
+    struct qemu_plugin_crucible_ram_root_scratch_v2 *scratch,
+    uint64_t *logical_bytes)
+{
+    for (size_t index = 0; index < regions->len; index++) {
+        CrucibleRamRegion *region = region_inventory_index(regions, index);
+        int status;
+
+        if (!(region->descriptor.scope_mask & (1 << scope))) {
+            continue;
+        }
+        status = full_region_root(region, reader, candidate, scratch,
+                                  region->observation_root);
+        if (status || region->descriptor.logical_length >
+                      UINT64_MAX - *logical_bytes) {
+            return status ? status : -EOVERFLOW;
+        }
+        *logical_bytes += region->descriptor.logical_length;
+    }
+    return 0;
+}
+
+/* Aggregate hashing starts only after all independent region readers return.
+ * Its hasher cannot overlap the region/page hash workspace in source lifetime. */
+static void full_aggregate_root(const CrucibleRamInventory *regions, uint32_t scope,
+                                uint8_t root[32])
+{
+    static const char *scope_names[] = { "execution", "exact", "lifecycle" };
+    uint8_t topology[32];
+    uint32_t selected = 0;
+    blake3_hasher hasher;
+
+    hash_tag(&hasher, "topology");
+    hash_u32(&hasher, RAM_PAGE_BYTES);
+    hash_u32(&hasher, regions->len);
+    for (size_t index = 0; index < regions->len; index++) {
+        const CrucibleRamRegion *region = region_inventory_index(regions, index);
+
+        hash_descriptor(&hasher, region);
+        if (region->descriptor.scope_mask & (1 << scope)) {
+            selected++;
+        }
+    }
+    blake3_hasher_finalize(&hasher, topology, sizeof(topology));
+    hash_tag(&hasher, "root");
+    hash_u32(&hasher, 1);
+    hash_u32(&hasher, RAM_PAGE_BYTES);
+    hash_string(&hasher, (const uint8_t *)scope_names[scope], strlen(scope_names[scope]));
+    blake3_hasher_update(&hasher, topology, sizeof(topology));
+    hash_u32(&hasher, selected);
+    for (size_t index = 0; index < regions->len; index++) {
+        const CrucibleRamRegion *region = region_inventory_index(regions, index);
+
+        if (!(region->descriptor.scope_mask & (1 << scope))) {
+            continue;
+        }
+        hash_descriptor(&hasher, region);
+        blake3_hasher_update(&hasher, region->observation_root,
+                             sizeof(region->observation_root));
+    }
+    blake3_hasher_finalize(&hasher, root, 32);
+}
+
+/* Only a completed, pinned admission can lend its sorted catalog. Live
+ * identifiers still require validation: clearing an ID does not change the
+ * topology generation. The ordinary constructor keeps its own allocation and
+ * failure ordering when this predicate does not hold. */
+static bool admitted_public_root_inventory_current(void)
+{
+    return admission_regions &&
+        qatomic_load_acquire(&paging_topology_pinned) &&
+        admission_grant_applied && !admission_grant_open &&
+        rust_metadata_budget && admission_regions->len &&
+        admission_regions->len <= 4096 &&
+        admission.region_count == admission_regions->len &&
+        admission.topology_generation &&
+        admission.topology_generation == qatomic_read(&topology_generation);
+}
+
+/* Match the collector's live validation and first refusal without creating a
+ * second region owner. The caller lends only a synchronous accepted counter. */
+static int validate_admitted_public_root_region(RAMBlock *block, void *opaque)
+{
+    uint32_t *accepted = opaque;
+    size_t id_length;
+
+    if (!region_has_logical_ram_backing(block)) {
+        return -ENOTSUP;
+    }
+    id_length = strlen(block->idstr);
+    if (id_length == 0 || id_length >= 256 ||
+        !g_utf8_validate(block->idstr, id_length, NULL) ||
+        block->used_length == 0) {
+        return -EINVAL;
+    }
+    for (size_t index = 0; index < id_length; index++) {
+        if ((uint8_t)block->idstr[index] < 0x20 || block->idstr[index] == 0x7f) {
+            return -EINVAL;
+        }
+    }
+    if (*accepted >= 4096 ||
+        (uint64_t)(*accepted + 1) * sizeof(CrucibleRamRegion) > metadata_budget) {
+        return -ENOSPC;
+    }
+    for (size_t index = 0; index < admission_regions->len; index++) {
+        const CrucibleRamRegion *admitted = region_inventory_index(admission_regions, index);
+
+        if (admitted->block == block) {
+            if (admitted->descriptor.logical_length != block->used_length ||
+                admitted->descriptor.id_length != id_length ||
+                memcmp(admitted->descriptor.id, block->idstr, id_length)) {
+                return -ESTALE;
+            }
+            (*accepted)++;
+            return 0;
+        }
+    }
+    return -ESTALE;
+}
+
+/* Preparation closes its private physical scratch before the hash workspace
+ * starts. Only the existing array reference crosses this synchronous boundary. */
+static int full_prepare_diagnostic_regions(uint64_t owner_token,
+                                           CrucibleRamInventory **regions)
+{
+    struct qemu_plugin_crucible_ram_root_scratch_v2 scratch = { 0 };
+    int proc_close_status = 0;
+    int status;
+
+    status = physical_validate_with_scratch(
+        owner_token, physical_topology, &scratch, &proc_close_status);
+    diagnostic_proc_close_result(owner_token, proc_close_status);
+    if (status) {
+        return status;
+    }
+    return region_inventory_ref(admission_regions, regions);
+}
+
+/* Keep allocation, sorting and their refusal paths outside the hash workspace.
+ * Eligible public observations retain the same validated admission array. */
+static int full_prepare_public_regions(CrucibleRamInventory **result)
+{
+    CrucibleRamInventory *regions;
+    int status;
+
+    if (admitted_public_root_inventory_current()) {
+        uint32_t accepted = 0;
+
+        status = qemu_ram_foreach_block(validate_admitted_public_root_region,
+                                       &accepted);
+        if (status || !accepted || accepted > 4096) {
+            return status ? status : -E2BIG;
+        }
+        /* Pinning prevents a missing block. Keep an explicit fail-closed
+         * defense before borrowing if the sealed/live counts disagree. */
+        if (accepted != admission_regions->len) {
+            return -ESTALE;
+        }
+        status = region_inventory_ref(admission_regions, &regions);
+        if (status) {
+            return status;
+        }
+    } else {
+        status = region_inventory_new(&regions);
+        if (status) {
+            return status;
+        }
+        status = qemu_ram_foreach_block(capture_region_add, regions);
+        if (status != 0 || regions->len == 0 || regions->len > 4096) {
+            return region_inventory_drop_preserving(&regions, status ? status : -E2BIG);
+        }
+        status = region_inventory_sort(regions);
+        if (status) {
+            return region_inventory_drop_preserving(&regions, status);
+        }
+    }
+    *result = regions;
+    return 0;
+}
+
+/* Array custody belongs to the wrapper. Finalizers run only after this
+ * independent hash workspace and its synchronous reader loans have closed. */
+static int full_hash_prepared_regions(
+    CrucibleRamInventory *regions, uint32_t scope, uint64_t owner_token,
+    uint8_t root[32], uint64_t *logical_bytes,
+    qemu_plugin_crucible_ram_root_scratch_read_v3 reader)
+{
+    struct qemu_plugin_crucible_ram_root_scratch_v2 scratch = { 0 };
+    int proc_close_status = 0;
+    int status;
+
+    status = full_observe_regions(regions, scope, reader, NULL, &scratch,
+                                  logical_bytes);
+    if (status) {
+        return status;
+    }
+    if (owner_token) {
+        status = physical_validate_with_scratch(
+            owner_token, physical_topology, &scratch, &proc_close_status);
+        diagnostic_proc_close_result(owner_token, proc_close_status);
+        if (status) {
+            return status;
+        }
+    }
+    full_aggregate_root(regions, scope, root);
+    return 0;
+}
+
+int qemu_plugin_crucible_checkpoint_candidate_full_root_v1(
+    qemu_plugin_crucible_checkpoint_candidate_read_v1 *loan,
+    uint32_t scope, uint8_t root[32], uint64_t *logical_bytes)
+{
+    CrucibleRamInventory *regions = NULL;
+    struct qemu_plugin_crucible_ram_root_scratch_v2 scratch = { 0 };
+    uint8_t observed_root[32];
+    uint64_t observed_bytes = 0;
+    int status = qemu_crucible_checkpoint_candidate_read_identity_v1(loan, true);
+
+    if (status || !root || !logical_bytes || scope > 2 || capture_active ||
+        !capture_authorized() || !admission_regions ||
+        root_reader_registration.observation_active) {
+        return status ? status : -EPERM;
+    }
+    status = qemu_crucible_ram_diagnostic_failure();
+    if (status) {
+        return status;
+    }
+    /* This Source-held admission inventory binds actual regions. Its caller
+     * supplied no epoch, page allocation or ordinary reader to replace it.
+     * The same registered held-reader callback supplies every complete page.
+     */
+    root_reader_registration.observation_active = true;
+    status = full_prepare_public_regions(&regions);
+    if (!status) {
+        status = full_observe_regions(regions, scope, NULL, loan, &scratch,
+                                      &observed_bytes);
+        if (!status) {
+            full_aggregate_root(regions, scope, observed_root);
+        }
+        status = region_inventory_drop_preserving(&regions, status);
+    }
+    root_reader_registration.observation_active = false;
+    if (!status) {
+        memcpy(root, observed_root, sizeof(observed_root));
+        *logical_bytes = observed_bytes;
+    }
+    return status;
+}
+
+int qemu_plugin_crucible_ram_full_root_v2(
+    uint32_t scope, uint64_t owner_token, uint8_t root[32], uint64_t *logical_bytes)
+{
+    CrucibleRamInventory *regions = NULL;
+    int status;
+
+    if (!root || !logical_bytes || scope > 2 || capture_active ||
+        !(owner_token ? diagnostic_capture_authorized(owner_token) :
+                       capture_authorized()) ||
+        (!admission_regions && qemu_crucible_ram_paging_requested())) {
+        return -EPERM;
+    }
+    /* Nested readers may alias these outputs. Refuse before any output or
+     * independent workspace write; authorization already requires the BQL. */
+    if (root_reader_registration.observation_active) {
+        return -EBUSY;
+    }
+    memset(root, 0, 32);
+    *logical_bytes = 0;
+    if (qemu_crucible_ram_diagnostic_failure()) {
+        return qemu_crucible_ram_diagnostic_failure();
+    }
+    if (qatomic_load_acquire(&root_reader_registration.state) != ROOT_READERS_READY) {
+        return -ENOSYS;
+    }
+    root_reader_registration.observation_active = true;
+    status = owner_token ? full_prepare_diagnostic_regions(owner_token, &regions) :
+                           full_prepare_public_regions(&regions);
+    if (!status) {
+        status = full_hash_prepared_regions(
+            regions, scope, owner_token, root, logical_bytes,
+            root_reader_registration.reader);
+        status = region_inventory_drop_preserving(&regions, status);
+        status = diagnostic_root_result(status, root, logical_bytes);
+    }
+    /* All array references and synchronous callback loans have closed. */
+    root_reader_registration.observation_active = false;
+    return status;
+}
+
+int qemu_crucible_ram_inventory_capture_cleanup_borrow_v1(
+    QemuCrucibleCheckpointInventoryLoan *parent,
+    QemuCrucibleRamInventoryCaptureLoan **out)
+{
+    int status;
+
+    if (!out || *out) {
+        return -EINVAL;
+    }
+    if (!inventory_capture.active) {
+        return 0;
+    }
+    status = inventory_capture_return_identity(parent, &inventory_capture);
+    if (!status) {
+        *out = &inventory_capture;
+    }
+    return status;
+}
+
+int qemu_crucible_ram_inventory_capture_pin_current_v1(
+    QemuCrucibleCheckpointInventoryLoan *parent)
+{
+    QemuCrucibleRamInventoryCaptureLoan *loan = &inventory_capture;
+    int status;
+
+    if (!loan->active || !loan->pinning) {
+        return -ENOENT;
+    }
+    status = qemu_crucible_ram_inventory_capture_identity_v1(parent, loan);
+    return status;
+}
+
+int qemu_crucible_ram_inventory_capture_returned_current_v1(
+    QemuCrucibleCheckpointInventoryLoan *parent, QemuCrucibleRamInventoryCaptureLoan *loan)
+{
+    if (loan != &inventory_capture || loan->parent != parent ||
+        loan->process != getpid() || !qemu_thread_is_self(&loan->thread) ||
+        !qemu_in_main_thread() || !bql_locked() || qemu_in_coroutine() ||
+        loan->active || loan->pinning || !loan->physically_returned ||
+        loan->cleanup_pending || inventory_return_pending(&loan->inventory_return) ||
+        loan->inventory_return.disposition.debt == RAM_DEBT_RETAINED ||
+        loan->regions || loan->source_capture || capture_active) {
+        return -EBUSY;
+    }
+    return 0;
+}
diff --git a/plugins/crucible-parent-park-metadata.inc.h b/plugins/crucible-parent-park-metadata.inc.h
new file mode 100644
index 0000000000000000000000000000000000000000..5b7b6ae3e73569c9a116a60dd16815239fbddd24
--- /dev/null
+++ b/plugins/crucible-parent-park-metadata.inc.h
@@ -0,0 +1,381 @@
+/*
+ * Same-prepared-Park mapped metadata debit and physical return.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Native owns the real closed request and empty future-storage slots. This
+ * child reserves every page of their anonymous mappings before birth. It grants
+ * no driver scratch or entered callback authority.
+ */
+
+#ifdef CONFIG_LINUX
+static int parent_park_metadata_fail(QemuCrucibleParentParkMetadataOwner *owner,
+                                     int status, bool post)
+{
+    if (status > 0) {
+        status = -EPROTO;
+    }
+    if (status < 0) {
+        if (post && !owner->post_status) {
+            owner->post_status = status;
+        }
+        if (!owner->first_status) {
+            owner->first_status = status;
+        }
+    }
+    return owner->first_status;
+}
+
+static int parent_park_metadata_identity(
+    QemuCrucibleParentParkMetadataOwner *owner)
+{
+    QemuCrucibleParentParkReceive *receive = &startup_source.parent_park_receive;
+    int status = parent_park_main_identity(false);
+
+    /* Authenticate this process/thread and canonical slot before any nominated
+     * owner or copied registry can be touched. Closing consults no clock. */
+    if (status || owner != &startup_source.parent_park_metadata) {
+        return status ? status : -EPERM;
+    }
+    if (!owner->attempted || owner->canonical_owner != owner ||
+        !owner->held || owner->returned || owner->process != getpid() ||
+        !qemu_thread_is_self(&owner->thread) ||
+        owner->parent != &startup_source.parent_park_loan ||
+        owner->parent->receive != receive ||
+        receive->metadata_owner != owner || receive->metadata_users != 1) {
+        return -ESTALE;
+    }
+    return qemu_crucible_parent_park_prepared_identity_v1(owner->parent);
+}
+
+static bool parent_park_metadata_arrays_equal(
+    const QemuCrucibleNativeParkRequestView *left,
+    const QemuCrucibleNativeParkRequestView *right)
+{
+    for (size_t index = 0; index < QEMU_CRUCIBLE_PARK_ARRAY_COUNT; index++) {
+        const QemuCrucibleParkArrayRequest *a = &left->arrays[index];
+        const QemuCrucibleParkArrayRequest *b = &right->arrays[index];
+
+        if (a->count != b->count || a->element_size != b->element_size ||
+            a->element_alignment != b->element_alignment || a->bytes != b->bytes ||
+            a->retained_alias != b->retained_alias) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static int parent_park_metadata_planned_mapping(
+    const QemuCrucibleNativeParkRequestView *view, uint64_t *out)
+{
+    uint64_t bytes = 0;
+    size_t mapping;
+
+    for (size_t index = 0; index < QEMU_CRUCIBLE_PARK_ARRAY_COUNT; index++) {
+        const QemuCrucibleParkArrayRequest *array = &view->arrays[index];
+        const QemuCrucibleNativeParkStorageSlot *slot = &view->slots[index];
+
+        if (!array->element_size || !array->element_alignment ||
+            (array->element_alignment & (array->element_alignment - 1)) ||
+            array->count > SIZE_MAX / array->element_size ||
+            array->bytes != array->count * array->element_size ||
+            slot->attempted || slot->raw || slot->users || slot->born ||
+            slot->freed || slot->uncertain) {
+            return -ESTALE;
+        }
+        if (index == QEMU_CRUCIBLE_PARK_PERSISTENT_ROOTS) {
+            /* This is Native's preexisting alias, never this child's new
+             * allocation. Its independent owner and debt remain retained. */
+            if (array->count && !array->retained_alias) {
+                return -ESTALE;
+            }
+            continue;
+        }
+        if (array->retained_alias ||
+            qemu_crucible_native_park_mapping_extent(array->bytes, &mapping) ||
+            array->element_alignment > qemu_real_host_page_size() ||
+            mapping > UINT64_MAX - bytes) {
+            return -EOVERFLOW;
+        }
+        bytes += mapping;
+    }
+    *out = bytes;
+    return 0;
+}
+
+static int parent_park_metadata_bank_identity(void)
+{
+    QemuCrucibleMetadataPartition *partition = &startup_source.metadata_partition;
+    uint64_t fixed = qemu_crucible_startup_source_fixed_control_extent();
+
+    if (getpid() != startup_source.owner_process ||
+        !qatomic_load_acquire(&partition->published) ||
+        !qatomic_load_acquire(&partition->controller_retained) ||
+        !startup_source.preexec_purpose_owner ||
+        !startup_source.process_contract_owner ||
+        !startup_source.incarnation_purpose_owner ||
+        !startup_source.runtime_purpose.charge.held || fixed == UINT64_MAX ||
+        partition->fixed_native_extent != fixed ||
+        partition->process_extent != startup_source.process_purpose_record.local_extent ||
+        !crucible_metadata_partition_residual_valid(partition)) {
+        return -ESTALE;
+    }
+    return 0;
+}
+
+static int parent_park_metadata_observe(
+    QemuCrucibleParentParkMetadataOwner *owner)
+{
+    QemuCrucibleNativeParkRequestView observed;
+    int status = qemu_crucible_native_park_request_observe(owner->request, &observed);
+
+    if (status) {
+        return status;
+    }
+    /* Actual Native output is retained before any later signed disposition. */
+    owner->observation = observed;
+    return observed.loan == owner->parent && observed.metadata_owner == owner &&
+        (!owner->declaration_received ||
+         parent_park_metadata_arrays_equal(&owner->declaration, &observed)) ? 0 : -ESTALE;
+}
+#endif
+
+int qemu_crucible_parent_park_metadata_create_v1(
+    QemuCrucibleParentParkLoan *parent, QemuCrucibleNativeParkRequest *request,
+    QemuCrucibleParentParkMetadataOwner **out)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleParentParkMetadataOwner *owner = &startup_source.parent_park_metadata;
+    QemuCrucibleParentParkReceive *receive = &startup_source.parent_park_receive;
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    QemuCrucibleNativeParkRequestView observed;
+    int identity;
+    int status = parent_park_main_identity(true);
+
+    if (status || parent_park_source_overlap(out, sizeof(*out)) || *out) {
+        return status ? status : -EINVAL;
+    }
+    status = qemu_crucible_parent_park_prepared_identity_v1(parent);
+    if (!status) {
+        status = qemu_crucible_native_park_request_identity(request, parent);
+    }
+    if (!status) {
+        status = parent_park_metadata_bank_identity();
+    }
+    if (status) {
+        return status;
+    }
+    qemu_mutex_lock(&commands->mutex);
+    if (owner->attempted || receive->metadata_owner || receive->metadata_users) {
+        qemu_mutex_unlock(&commands->mutex);
+        return -EALREADY;
+    }
+    *owner = (QemuCrucibleParentParkMetadataOwner) {
+        .canonical_owner = owner,
+        .parent = parent,
+        .request = request,
+        .process = getpid(),
+        .attempted = true,
+        .held = true,
+        .busy = true,
+    };
+    qemu_thread_get_self(&owner->thread);
+    receive->metadata_owner = owner;
+    receive->metadata_users++;
+    *out = owner;
+    qemu_mutex_unlock(&commands->mutex);
+
+    status = qemu_crucible_native_park_request_storage_claim(request, parent, owner);
+    owner->claimed = !status;
+    parent_park_metadata_fail(owner, status, false);
+    status = qemu_crucible_native_park_request_observe(request, &observed);
+    if (!status) {
+        owner->declaration = observed;
+        owner->observation = observed;
+        owner->declaration_received = true;
+        owner->claimed |= observed.metadata_owner == owner;
+        if (observed.loan != parent || observed.metadata_owner != owner ||
+            !observed.closed || observed.released || observed.storage_closed) {
+            status = -ESTALE;
+        }
+    }
+    parent_park_metadata_fail(owner, status, false);
+    if (!owner->first_status) {
+        status = qemu_crucible_native_park_request_current(request);
+        parent_park_metadata_fail(owner, status, false);
+    }
+    if (!owner->first_status) {
+        status = parent_park_metadata_planned_mapping(&owner->declaration,
+                                                       &owner->requested_mapping);
+        parent_park_metadata_fail(owner, status, false);
+    }
+    if (!owner->first_status && owner->requested_mapping) {
+        owner->debit_attempted = true;
+        status = crucible_metadata_native_admit(&startup_source.metadata_partition,
+            owner->requested_mapping, &owner->charge);
+        parent_park_metadata_fail(owner, status, false);
+    }
+    /* The real charge is already in the canonical child. A negative post
+     * never hides it in a tentative local or returns its credit early. */
+    status = parent_park_pair_raw_post(receive);
+    parent_park_metadata_fail(owner, status, true);
+    identity = parent_park_metadata_identity(owner);
+    if (!identity && owner->claimed) {
+        identity = parent_park_metadata_observe(owner);
+    }
+    parent_park_metadata_fail(owner, identity, true);
+    if (!identity) {
+        qatomic_store_release(&owner->busy, false);
+    }
+    return owner->first_status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_crucible_parent_park_metadata_identity_v1(
+    QemuCrucibleParentParkMetadataOwner *owner)
+{
+#ifdef CONFIG_LINUX
+    int status = parent_park_metadata_identity(owner);
+
+    return status ? status : qatomic_load_acquire(&owner->busy) ? -EBUSY : 0;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_crucible_parent_park_metadata_credit_v1(
+    QemuCrucibleParentParkMetadataOwner *owner,
+    QemuCrucibleNativeParkRequest *request)
+{
+#ifdef CONFIG_LINUX
+    int status = qemu_crucible_parent_park_metadata_identity_v1(owner);
+
+    if (status) {
+        return status;
+    }
+    if (owner->first_status) {
+        return owner->first_status;
+    }
+    if (request != owner->request || !owner->claimed || !owner->declaration_received ||
+        owner->charge.bytes != owner->requested_mapping ||
+        (!!owner->requested_mapping != owner->charge.held) || owner->close_attempted) {
+        return -ESTALE;
+    }
+    return qemu_crucible_native_park_request_identity(request, owner->parent);
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_crucible_parent_park_metadata_current_v1(
+    QemuCrucibleParentParkMetadataOwner *owner)
+{
+#ifdef CONFIG_LINUX
+    int status = parent_park_main_identity(true);
+
+    if (!status) {
+        status = qemu_crucible_parent_park_metadata_credit_v1(
+            owner, owner == &startup_source.parent_park_metadata ? owner->request : NULL);
+    }
+    if (status) {
+        return status;
+    }
+    if (qatomic_cmpxchg(&owner->busy, false, true)) {
+        return -EBUSY;
+    }
+    status = parent_park_metadata_bank_identity();
+    if (!status) {
+        status = crucible_metadata_partition_admission_status(
+            &startup_source.metadata_partition);
+    }
+    if (!status) {
+        status = qemu_crucible_native_park_request_current(owner->request);
+    }
+    if (!status) {
+        status = parent_park_metadata_observe(owner);
+    }
+    parent_park_metadata_fail(owner, status, false);
+    status = parent_park_pair_raw_post(&startup_source.parent_park_receive);
+    parent_park_metadata_fail(owner, status, true);
+    status = parent_park_metadata_identity(owner);
+    if (!status) {
+        status = parent_park_metadata_observe(owner);
+    }
+    parent_park_metadata_fail(owner, status, true);
+    if (!status) {
+        qatomic_store_release(&owner->busy, false);
+    }
+    return owner->first_status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_crucible_parent_park_metadata_identity_return_v1(
+    QemuCrucibleParentParkMetadataOwner *owner)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleParentParkReceive *receive = &startup_source.parent_park_receive;
+    int observation;
+    int status = parent_park_main_identity(true);
+
+    if (!status) {
+        status = qemu_crucible_parent_park_metadata_identity_v1(owner);
+    }
+
+    if (status) {
+        return status;
+    }
+    if (qatomic_cmpxchg(&owner->busy, false, true)) {
+        return -EBUSY;
+    }
+    if (owner->claimed) {
+        owner->close_attempted = true;
+        status = qemu_crucible_native_park_request_storage_close(
+            owner->request, owner->parent, owner);
+        observation = parent_park_metadata_observe(owner);
+        status = status ? status : observation;
+        if (!status && !owner->observation.storage_closed) {
+            status = -EBUSY;
+        }
+        for (size_t index = 0;
+             !status && index < QEMU_CRUCIBLE_PARK_ARRAY_COUNT; index++) {
+            const QemuCrucibleNativeParkStorageSlot *slot =
+                &owner->observation.slots[index];
+
+            if (slot->users || slot->uncertain ||
+                (slot->attempted && !slot->freed) ||
+                (!slot->attempted && (slot->raw || slot->born || slot->freed))) {
+                status = -EBUSY;
+            }
+        }
+    } else if (owner->charge.held) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        status = parent_park_metadata_identity(owner);
+    }
+    if (!status) {
+        status = parent_park_metadata_bank_identity();
+    }
+    if (!status && owner->charge.held) {
+        status = crucible_metadata_native_retire(&startup_source.metadata_partition,
+                                                  &owner->charge);
+    }
+    if (status && !owner->return_status) {
+        owner->return_status = status;
+    }
+    if (!status) {
+        /* Only this exact child and debit retire. Native's gates, aliases,
+         * pair/request and any material debt remain independently retained. */
+        receive->metadata_users--;
+        owner->held = false;
+        owner->returned = true;
+    }
+    qatomic_store_release(&owner->busy, false);
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
diff --git a/plugins/crucible-parent-park.inc.h b/plugins/crucible-parent-park.inc.h
new file mode 100644
index 0000000000000000000000000000000000000000..56e7923907c8519e4999fb98608e1136ac8b25c8
--- /dev/null
+++ b/plugins/crucible-parent-park.inc.h
@@ -0,0 +1,1296 @@
+/*
+ * Canonical paired Park reception, invocation and terminal return
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Included once after Source's real Monitor, standing and actor owners. The
+ * received aliases and authenticated publisher, rather than decoded timing
+ * values or QMP acknowledgments, establish this distinct request lifetime.
+ */
+
+#ifdef CONFIG_LINUX
+static int parent_park_record_local_closure(
+    QemuCrucibleNativeParkRequest *request);
+
+static bool parent_park_source_overlap(const void *pointer, size_t bytes)
+{
+    uintptr_t address = (uintptr_t)pointer;
+    uintptr_t source = (uintptr_t)&startup_source;
+
+    return !pointer || bytes > UINTPTR_MAX - address ||
+        (address < source + sizeof(startup_source) && address + bytes > source);
+}
+
+static int parent_park_main_identity(bool require_unlocked)
+{
+    QemuCrucibleParentParkReceive *owner = &startup_source.parent_park_receive;
+
+    if (getpid() != startup_source.owner_process ||
+        !qatomic_load_acquire(&startup_source.module_custody_published) ||
+        !qatomic_load_acquire(&startup_source.process_purpose_complete) ||
+        !qatomic_load_acquire(&startup_source.custody_retained) ||
+        !qemu_thread_is_self(&startup_source.owner_thread) ||
+        qemu_in_coroutine()) {
+        return -EPERM;
+    }
+    if (bql_locked()) {
+        return !require_unlocked && qemu_in_main_thread() ? 0 : -EPERM;
+    }
+
+    /* qemu_in_main_thread() denotes BQL ownership. Outside BQL, retain the
+     * exact issuing thread and the genuine Main request move instead. Those
+     * outputs were born at the protected Monitor dispatch, before its post. */
+    if (!qatomic_load_acquire(&owner->published) || !owner->retained ||
+        !owner->main_request_received ||
+        (!owner->request_borrow && !owner->request_returned) || !owner->monitor ||
+        owner->process != getpid() || !qemu_thread_is_self(&owner->thread)) {
+        return -EPERM;
+    }
+    return 0;
+}
+
+static int parent_park_receive_identity(QemuCrucibleParentParkReceive *owner)
+{
+    int status = parent_park_main_identity(false);
+
+    /* Reject process/thread and the nominated pointer before reading an owner
+     * or touching any inherited registry or Monitor lock. */
+    if (status || owner != &startup_source.parent_park_receive) {
+        return status ? status : -EPERM;
+    }
+    if (!qatomic_load_acquire(&owner->published) || !owner->retained ||
+        owner->process != getpid() || !qemu_thread_is_self(&owner->thread) ||
+        owner->runtime != &startup_source.runtime_purpose ||
+        !owner->runtime->charge.held ||
+        owner->actor != &startup_source.ram_control_actor ||
+        owner->actor->process != owner->process ||
+        owner->actor->purpose != owner->runtime ||
+        owner->actor_incarnation != owner->actor->incarnation ||
+        owner->member != &startup_source.command_member ||
+        !owner->member->transferred ||
+        owner->member->park_request_users != (owner->terminal_ready ? 0 : 1) ||
+        owner->member->park_writer.receive != owner ||
+        owner->member->park_writer.member != owner->member ||
+        !owner->member->park_writer.callback ||
+        owner->publisher != startup_source.standing.lender ||
+        !startup_source.standing.retained ||
+        owner->installer.ctx != startup_source.saved.ctx ||
+        owner->installer.module != startup_source.saved.module ||
+        owner->installer.install != startup_source.saved.install ||
+        owner->installer.plugin_id != startup_source.saved.plugin_id ||
+        !qatomic_load_acquire(&startup_source.parent_park_registered) ||
+        !startup_source.parent_park_callback ||
+        startup_source.parent_park_userdata != owner->actor->userdata) {
+        return -ESTALE;
+    }
+    return 0;
+}
+
+static bool parent_park_binding_equal(const QemuCrucibleParkBinding *left,
+                                      const QemuCrucibleParkBinding *right)
+{
+    return !memcmp(left->source_capability, right->source_capability, 32) &&
+        !memcmp(left->source_reservation, right->source_reservation, 32) &&
+        left->account_incarnation == right->account_incarnation &&
+        left->process_incarnation == right->process_incarnation &&
+        left->request_correlation == right->request_correlation &&
+        left->command_frontier == right->command_frontier &&
+        left->loan_sequence == right->loan_sequence;
+}
+
+static int parent_park_fail(QemuCrucibleParentParkReceive *owner,
+                            int status, bool post)
+{
+    if (status > 0) {
+        status = -EPROTO;
+    }
+    if (status < 0) {
+        if (post && !owner->post_status) {
+            owner->post_status = status;
+        }
+        if (!owner->first_status) {
+            owner->first_status = status;
+        }
+    }
+    return owner->first_status;
+}
+
+static int parent_park_row_slice(const QemuCrucibleProducingActionRow *row,
+                                 uint64_t now, uint64_t *slice)
+{
+    uint64_t end = UINT64_MAX;
+    const uint64_t limits[] = {
+        row->total_end_ns, row->progress_end_ns,
+        row->outer_end_ns, row->private_interval_end_ns,
+    };
+
+    if (row->state || now < row->original_start_ns || !row->poll_ns) {
+        return row->state == 2 ? -ETIMEDOUT :
+            row->state == 3 ? -ECANCELED : -ESTALE;
+    }
+    for (size_t index = 0; index < G_N_ELEMENTS(limits); index++) {
+        if (limits[index]) {
+            end = MIN(end, limits[index]);
+        }
+    }
+    if (now >= end) {
+        return -ETIMEDOUT;
+    }
+    *slice = MIN(*slice, MIN(row->poll_ns, end - now));
+    return *slice ? 0 : -ETIMEDOUT;
+}
+
+static int parent_park_original_raw_current(
+    QemuCrucibleParentParkReceive *owner, size_t index, uint64_t *remaining_ns)
+{
+    const QemuCrucibleStandingRecord *standing = &startup_source.standing.current;
+    const QemuCrucibleBoundaryParkRecord *publication = &standing->park;
+    QemuCrucibleQmpAllocationObservation request;
+    struct pollfd cancellation;
+    int cancellation_fd;
+    uint64_t slice = UINT64_MAX;
+    uint64_t now;
+    int status = parent_park_receive_identity(owner);
+
+    if (status || index >= 2 || bql_locked()) {
+        return status ? status : -EPERM;
+    }
+    status = qemu_crucible_qmp_borrow_observe(owner->request_borrow, &request);
+    if (status || request.monitor != owner->monitor ||
+        request.connection_epoch != owner->connection_epoch ||
+        request.process_purpose != startup_source.preexec_purpose_owner ||
+        request.process_generation != startup_source.original.process_generation ||
+        !monitor_qmp_connection_watch_valid(owner->monitor, owner->connection_epoch)) {
+        return status ? status : -ESTALE;
+    }
+    status = standing_boundary();
+    if (status) {
+        return status;
+    }
+    if (!publication->present || publication->dirty ||
+        publication->primary_count != 2 ||
+        publication->born_mask != (1U << publication->planned_count) - 1 ||
+        publication->projected_mask != publication->born_mask ||
+        !parent_park_binding_equal(&publication->binding, &owner->binding)) {
+        return -ESTALE;
+    }
+    if (owner->initial_publication.present) {
+        status = standing_park_snapshot_validate(
+            &owner->initial_publication, publication, startup_source.standing.sequence);
+        if (status) {
+            return status;
+        }
+    }
+    status = standing_clock(&now);
+    if (!status) {
+        status = standing_limits_current(standing, now);
+    }
+    if (!status) {
+        status = parent_park_row_slice(&publication->rows[index], now, &slice);
+    }
+    for (size_t preparation = 2;
+         !status && preparation < publication->planned_count; preparation++) {
+        status = parent_park_row_slice(&publication->rows[preparation], now, &slice);
+    }
+    if (status) {
+        return status;
+    }
+    if (owner->pair_decoded) {
+        const QemuCrucibleParkOriginalBase *base = &owner->pair.originals[index];
+        const QemuCrucibleProducingActionRow *row = &publication->rows[index];
+
+        if (memcmp(base->capability, row->lender_capability, 32) ||
+            base->operation != row->operation ||
+            base->original_start_ns != row->original_start_ns ||
+            now < base->original_start_ns) {
+            return -ESTALE;
+        }
+        if (now >= base->original_end_ns) {
+            return -ETIMEDOUT;
+        }
+        slice = MIN(slice, MIN(base->poll_ns, base->original_end_ns - now));
+    }
+    cancellation_fd = owner->cancellation_fd >= 0 ? owner->cancellation_fd :
+        startup_source.standing.cancellation_fd;
+    if (cancellation_fd >= 0) {
+        uint64_t device, inode, event;
+        int result;
+
+        status = qemu_crucible_received_cancellation_observe_v1(
+            cancellation_fd, &owner->metadata_fd,
+            &owner->metadata_close_uncertain, &owner->post_status,
+            &device, &inode, &event);
+        if (status) {
+            return status;
+        }
+        if (device != standing->cancellation_device ||
+            inode != standing->cancellation_inode ||
+            event != standing->cancellation_event_token) {
+            return -ESTALE;
+        }
+        cancellation = (struct pollfd) {
+            .fd = cancellation_fd, .events = POLLIN,
+        };
+        result = poll(&cancellation, 1, 0);
+        if (result < 0) {
+            return -errno;
+        }
+        if (cancellation.revents & POLLNVAL) {
+            return -EBADF;
+        }
+        if (cancellation.revents & (POLLERR | POLLHUP)) {
+            return -EIO;
+        }
+        if (result || cancellation.revents) {
+            return -ECANCELED;
+        }
+        owner->cancellation_device = device;
+        owner->cancellation_inode = inode;
+        owner->cancellation_event_id = event;
+    } else {
+        return -ENOKEY;
+    }
+    *remaining_ns = slice;
+    return 0;
+}
+
+static int parent_park_pair_raw_post(QemuCrucibleParentParkReceive *owner)
+{
+    int status = 0;
+
+    /* These are independent raw observations, including after an initiating
+     * failure. Never short-circuit the family Original after the actor post. */
+    for (size_t index = 0; index < 2; index++) {
+        uint64_t unused;
+        int post = parent_park_original_raw_current(owner, index, &unused);
+
+        owner->original_post[index] = post;
+        parent_park_fail(owner, post, true);
+        if (!status) {
+            status = post;
+        }
+    }
+    return status;
+}
+#endif
+
+int qemu_crucible_parent_park_receive_main_v1(
+    const QemuCrucibleParkBinding *binding, uint64_t stopped_generation,
+    const char *basis_fdname, const char *cancellation_fdname,
+    QemuCrucibleParentParkReceive **out)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleParentParkReceive *owner = &startup_source.parent_park_receive;
+    QemuCrucibleRamControlActor *actor = &startup_source.ram_control_actor;
+    QemuCrucibleCommandConsumerMember *member = &startup_source.command_member;
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    struct stat basis;
+    uint64_t unused;
+    int flags;
+    int status = parent_park_main_identity(false);
+
+    if (status || !bql_locked()) {
+        return status ? status : -EPERM;
+    }
+    if (parent_park_source_overlap(out, sizeof(*out)) ||
+        parent_park_source_overlap(binding, sizeof(*binding)) ||
+        callback_child_output_overlap(out, sizeof(*out), binding, sizeof(*binding)) ||
+        !basis_fdname || !cancellation_fdname || *out) {
+        return -EINVAL;
+    }
+    status = ram_control_creator(actor, startup_source.saved.plugin_id);
+    if (status || !qatomic_load_acquire(&startup_source.parent_park_registered) ||
+        !startup_source.parent_park_callback ||
+        startup_source.parent_park_userdata != actor->userdata ||
+        !startup_source.standing.retained || !startup_source.standing.lender) {
+        return status ? status : -ENOKEY;
+    }
+    status = command_registry_identity(startup_source.saved.plugin_id);
+    if (status) {
+        return status;
+    }
+    if (qatomic_cmpxchg(&owner->busy, false, true)) {
+        return -EBUSY;
+    }
+    if (owner->published || owner->retained) {
+        qatomic_store_release(&owner->busy, false);
+        return -EALREADY;
+    }
+    qemu_mutex_lock(&commands->mutex);
+    status = command_member_identity_locked(member);
+    if (!status && (!member->transferred || member->transition_active ||
+                    member->closing || member->park_request_users ||
+                    member->park_writer.receive ||
+                    member->park_writer.invoking || member->park_writer.uncertain)) {
+        status = -EBUSY;
+    }
+    if (status) {
+        qemu_mutex_unlock(&commands->mutex);
+        qatomic_store_release(&owner->busy, false);
+        return status;
+    }
+    owner->creating = true;
+    owner->retained = true;
+    owner->process = getpid();
+    qemu_thread_get_self(&owner->thread);
+    owner->installer = startup_source.saved;
+    owner->runtime = &startup_source.runtime_purpose;
+    owner->actor = actor;
+    owner->member = member;
+    owner->actor_incarnation = actor->incarnation;
+    owner->publisher = startup_source.standing.lender;
+    owner->binding = *binding;
+    owner->stopped_generation = stopped_generation;
+    member->park_request_users++;
+    member->park_writer.receive = owner;
+    member->park_writer.loan_sequence = binding->loan_sequence;
+    member->park_writer.request_correlation = binding->request_correlation;
+    qatomic_store_release(&owner->published, true);
+    *out = owner;
+    qemu_mutex_unlock(&commands->mutex);
+
+    status = monitor_qmp_parent_park_request_take(
+        &owner->monitor, &owner->request_borrow, &owner->connection_epoch);
+    owner->main_request_received = owner->monitor && owner->request_borrow;
+    parent_park_fail(owner, status, false);
+
+    /* The genuine request stays pinned while Source observes its actual live
+     * publisher outside BQL. The complete creation latch covers both gaps. */
+    bql_unlock();
+    if (!status) {
+        owner->original_current[0] = parent_park_original_raw_current(owner, 0, &unused);
+        owner->original_current[1] = parent_park_original_raw_current(owner, 1, &unused);
+        status = owner->original_current[0] ? owner->original_current[0] :
+            owner->original_current[1];
+    }
+    if (!status) {
+        owner->initial_publication = startup_source.standing.current.park;
+    }
+    parent_park_fail(owner, status, false);
+    bql_lock();
+
+    if (!owner->first_status) {
+        owner->basis_take_attempted = true;
+        owner->basis_fd = monitor_get_fd(owner->monitor, basis_fdname, NULL);
+        if (owner->basis_fd < 0) {
+            parent_park_fail(owner, -ENOENT, false);
+        }
+    }
+    if (!owner->first_status) {
+        owner->cancellation_take_attempted = true;
+        owner->cancellation_fd = monitor_get_fd(
+            owner->monitor, cancellation_fdname, NULL);
+        if (owner->cancellation_fd < 0) {
+            parent_park_fail(owner, -ENOENT, false);
+        }
+    }
+    status = qemu_crucible_qmp_output_status(owner->monitor);
+    parent_park_fail(owner, status, true);
+
+    bql_unlock();
+    if (!owner->first_status) {
+        if (fstat(owner->basis_fd, &basis) < 0) {
+            status = -errno;
+        } else {
+            owner->basis_device = basis.st_dev;
+            owner->basis_inode = basis.st_ino;
+            status = !S_ISREG(basis.st_mode) ||
+                basis.st_size != (off_t)sizeof(owner->pair_wire) ?
+                -EPROTO : 0;
+        }
+        parent_park_fail(owner, status, false);
+    }
+    if (!owner->first_status) {
+        flags = fcntl(owner->basis_fd, F_GETFD);
+        status = flags < 0 ? -errno : !(flags & FD_CLOEXEC) ? -EPERM : 0;
+        parent_park_fail(owner, status, false);
+    }
+    if (!owner->first_status) {
+        flags = fcntl(owner->cancellation_fd, F_GETFD);
+        status = flags < 0 ? -errno : !(flags & FD_CLOEXEC) ? -EPERM : 0;
+        parent_park_fail(owner, status, false);
+    }
+    if (!owner->first_status) {
+        flags = fcntl(owner->basis_fd, F_GET_SEALS);
+        status = flags < 0 ? -errno :
+            (flags & (F_SEAL_SHRINK | F_SEAL_GROW | F_SEAL_WRITE | F_SEAL_SEAL)) !=
+                (F_SEAL_SHRINK | F_SEAL_GROW | F_SEAL_WRITE | F_SEAL_SEAL) ? -EPERM : 0;
+        parent_park_fail(owner, status, false);
+    }
+    if (!owner->first_status) {
+        ssize_t received;
+
+        owner->read_attempted = true;
+        received = pread(owner->basis_fd, owner->pair_wire,
+                         sizeof(owner->pair_wire), 0);
+        if (received > 0) {
+            owner->received_bytes = received;
+        }
+        status = received < 0 ? -errno :
+            received != (ssize_t)sizeof(owner->pair_wire) ? -EIO : 0;
+        parent_park_fail(owner, status, false);
+    }
+    if (!owner->first_status) {
+        status = qemu_crucible_parent_park_pair_decode_v1(
+            owner->pair_wire, owner->received_bytes, &owner->pair);
+        owner->pair_decoded = !status;
+        parent_park_fail(owner, status, false);
+    }
+    /* Keep both raw post results even when a descriptor or decode already
+     * failed. No negative path closes or retries an ambiguous received alias. */
+    parent_park_pair_raw_post(owner);
+    owner->validated = !owner->first_status && owner->pair_decoded;
+    bql_lock();
+    status = parent_park_receive_identity(owner);
+    parent_park_fail(owner, status, true);
+    if (!status) {
+        owner->creating = false;
+        qatomic_store_release(&owner->busy, false);
+    }
+    return owner->first_status;
+#else
+    return -ENOTSUP;
+#endif
+}
