+
 void rr_kick_vcpu_thread(CPUState *unused)
 {
-    CPUState *cpu;
+    CPUState *cpu;
+
+    if (rr_crucible_sim_mode() &&
+        icount_crucible_rr_switch_quantum() != 0) {
+        /*
+         * Host work and main-loop notifications may request a generic vCPU
+         * kick at host-dependent times.  Defer those requests to the finite
+         * deterministic RR boundary.  Even a soft
+         * exit_request issued between slices can race the next slice and make
+         * its translation-block endpoint, interrupt delivery, and subsequent
+         * RR allocation depend on host arrival time.  This applies with one
+         * vCPU too: an interrupt that becomes visible at the next block
+         * boundary can change the guest path even when there is no alternate
+         * RR owner.
+         *
+         * Until the RR thread completes first-exit normalization,
+         * qemu_cpu_kick() has already broadcast the halt condition needed to
+         * start it.  A startup arming state serializes each soft exit_request
+         * writer with the transition to steady execution.  This suppresses
+         * the asynchronous decrementer side effect before a guest coordinate
+         * exists while preserving the wait predicate startup needs.
+         *
+         * An active RR thread always reaches the finite cursor boundary without
+         * an asynchronous exit.  Host wake timing must not shorten its current
+         * translation block, even when another CPU is halted or has a pending
+         * interrupt.  Stop, unplug, interrupt, and queued-work predicates
+         * remain durable until that boundary.  A parked RR thread observes the
+         * durable wake generation through the RR event without fabricating an
+         * exit request for every vCPU.
+         */
+        {
+            unsigned int claimed_state;
+            bool starting_wake;
+
+            /*
+             * Publish every request through the same producer-owned arming
+             * transition.  In particular, a halted CPU still needs a durable
+             * IDLE_WAKE_PENDING predicate: qemu_cpu_kick() broadcasts the halt
+             * condition before this hook runs, so exit_request alone cannot
+             * protect the RR consumer from a broadcast-before-wait race.
+             * Only the RR thread may consume a pending wake boundary.
+             */
+            while (!rr_crucible_sim_wake_try_claim(&rr_tcg_exec_state,
+                                                    &claimed_state)) {
+                cpu_relax();
+            }
+            starting_wake = claimed_state == RR_TCG_EXEC_STARTING;
+
+            if (starting_wake) {
+                /*
+                 * Publish the soft first-exit predicate before releasing the
+                 * startup barrier.  The RR thread cannot enter steady-state
+                 * execution while a stale pre-start writer still owns it.
+                 */
+                CPU_FOREACH(cpu) {
+                    qatomic_set_mb(&cpu->exit_request, 1);
+                }
+            }
+
+            rr_crucible_sim_wake_publish(
+                &rr_tcg_exec_state, claimed_state,
+                &rr_wake_publish_generation);
+        }
+        /* Wake only after this producer's RR state is durable. */
+        rr_crucible_sim_notify_dispatch_ceiling();
+        return;
+    }
+    CPU_FOREACH(cpu) {
+        tcg_kick_vcpu_thread(cpu);
+    };
+    if (rr_crucible_sim_mode()) {
+        /* The direct kick is the durable wake state when no quantum is set. */
+        rr_crucible_sim_notify_dispatch_ceiling();
+    }
+}
