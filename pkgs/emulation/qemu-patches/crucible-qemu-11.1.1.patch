+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Exercise cold memory and clock predicates with unchanged production bodies.
+
+Real GLib arrays and the production interval tree execute memory index build,
+install, rebuild and VMState commit. Clock lookup, restore guards, rebase and
+projection execute production bodies. Accelerator identity, decoded rule fields,
+TLB flush effects, time/value arithmetic and timer callbacks are bounded
+providers. This is not a translated-TB, running-guest or migration-stream test.
+"""
+
+import argparse
+import json
+import os
+from pathlib import Path
+import runpy
+import shlex
+import subprocess
+
+
+ROOT = Path(__file__).resolve().parents[2]
+definition = runpy.run_path(str(Path(__file__).with_name(
+    "test-crucible-net-output-stop.py")))["definition"]
+
+PRELUDE = r"""
+#include <errno.h>
+#include <limits.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <glib.h>
+#include "qemu/typedefs.h"
+#define qemu_build_assert(condition) _Static_assert(condition, #condition)
+#include "qemu/crucible-clock-custody.h"
+#include "qemu/atomic.h"
+#include "qemu/interval-tree.h"
+#include "plugins/qemu-plugin.h"
+#define error_report(...) g_error(__VA_ARGS__)
+/* ICOUNT_MODE_DEFINITION */
+#define QEMU_CLOCK_VIRTUAL 1
+#define CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT 4194304
+
+/* Decoded field providers use symbolic tags, not a serialized command ABI. */
+enum {
+    CRUCIBLE_FAULT_COMMAND_MEMORY_ACCESS_TRANSFORM = 1,
+    CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE,
+    CRUCIBLE_FAULT_COMMAND_MEMORY_SERVICE,
+    CRUCIBLE_NODE_FAULT_FIELD_T3,
+    CRUCIBLE_NODE_FAULT_FIELD_T4,
+    CRUCIBLE_NODE_FAULT_FIELD_P8,
+};
+
+typedef struct CrucibleMemoryServiceLedger {
+    unsigned int identity;
+} CrucibleMemoryServiceLedger;
+
+typedef struct QemuCrucibleFaultRule {
+    uint16_t command_kind;
+    uint32_t classes, vcpu;
+    uint64_t start, length;
+    bool has_vcpu, valid;
+    CrucibleMemoryServiceLedger *service_ledger;
+} QemuCrucibleFaultRule;
+
+bool qemu_crucible_fault_memory_rules_active(void);
+bool qemu_crucible_fault_memory_fetch_rules_active(void);
+bool qemu_crucible_fault_memory_cpu_rules_active(void);
+bool qemu_crucible_fault_memory_page_table_walk_rules_active(void);
+bool qemu_crucible_fault_clock_source_active(uint16_t, uint32_t);
+bool qemu_crucible_fault_clock_source_rebase(uint16_t, uint32_t, uint64_t);
+bool qemu_crucible_fault_clock_project_ps(uint16_t, uint32_t, uint64_t,
+                                          uint64_t *, bool *);
+void qemu_crucible_fault_clock_vmstate_load_begin(void);
+void qemu_crucible_fault_clock_vmstate_load_end(bool);
+
+static const char *accel_name = "sim";
+static int icount_mode = ICOUNT_PRECISE;
+static unsigned int accel_reads, flushes, deadline_updates, rule_unrefs;
+static unsigned int base_calls, value_calls, rearms, wander_rearms;
+static unsigned int failure_reports, lookup_calls;
+static bool base_ok = true, value_ok = true, provider_read_error;
+static CPUState *current_cpu = (CPUState *)&flushes;
+static CPUState *first_cpu = (CPUState *)&deadline_updates;
+
+static bool current_accel_is_sim(void)
+{
+    accel_reads++;
+    return strcmp(accel_name, "sim") == 0;
+}
+
+static int icount_enabled(void)
+{
+    return icount_mode;
+}
+
+static bool node_rule_memory_range(QemuCrucibleFaultRule *rule,
+                                   uint64_t *start, uint64_t *length)
+{
+    *start = rule->start;
+    *length = rule->length;
+    return rule->valid;
+}
+
+static bool node_field_bool(QemuCrucibleFaultRule *rule, uint16_t tag,
+                            bool *value)
+{
+    g_assert_cmpuint(tag, ==, CRUCIBLE_NODE_FAULT_FIELD_T3);
+    *value = rule->has_vcpu;
+    return rule->valid;
+}
+
+static bool node_field_u32(QemuCrucibleFaultRule *rule, uint16_t tag,
+                           uint32_t *value)
+{
+    g_assert_true(tag == CRUCIBLE_NODE_FAULT_FIELD_T4 ||
+                  tag == CRUCIBLE_NODE_FAULT_FIELD_P8);
+    *value = tag == CRUCIBLE_NODE_FAULT_FIELD_T4 ? rule->vcpu : rule->classes;
+    return rule->valid;
+}
+
+static uint32_t node_memory_service_actor_access_classes(
+    const QemuCrucibleFaultRule *rule)
+{
+    return rule->classes;
+}
+
+static void tlb_flush_all_cpus_synced(CPUState *cpu)
+{
+    g_assert_nonnull(cpu);
+    flushes++;
+}
+
+static void node_memory_retention_deadline_recompute(void)
+{
+    deadline_updates++;
+}
+
+static void qemu_crucible_fault_rule_unref(QemuCrucibleFaultRule *rule)
+{
+    if (rule) {
+        rule_unrefs++;
+    }
+}
+
+static int64_t qemu_clock_get_ps(int clock)
+{
+    g_assert_cmpint(clock, ==, QEMU_CLOCK_VIRTUAL);
+    return 1000;
+}
+"""
+
+GLOBALS = r"""
+static GPtrArray *crucible_node_rules;
+static GArray *crucible_memory_gpa_index, *crucible_memory_gva_index;
+static GPtrArray *crucible_memory_binding_order;
+static uint32_t crucible_memory_access_classes;
+static IntervalTreeRoot crucible_memory_gpa_root, crucible_memory_gva_root;
+static GChecksum *crucible_memory_checksum;
+static bool crucible_memory_recursive;
+static GHashTable *crucible_memory_retry_states, *crucible_memory_service_ledgers;
+static uint64_t crucible_memory_access_sequence, crucible_memory_retention_next_tick;
+
+static bool crucible_clock_bindings_sealed, crucible_clock_terminal;
+static bool crucible_clock_restoring, crucible_clock_rearming_timers;
+static bool crucible_clock_vmstate_load_failed;
+static unsigned int crucible_clock_vmstate_load_depth;
+
+static bool crucible_clock_source_base(CrucibleClockSource *source,
+                                       uint64_t raw, uint64_t now,
+                                       uint64_t *base, bool *read_error)
+{
+    g_assert_nonnull(source);
+    g_assert_cmpuint(now, ==, 1000);
+    base_calls++;
+    *base = raw + 3;
+    *read_error = provider_read_error;
+    return base_ok;
+}
+
+static bool crucible_clock_source_value(CrucibleClockSource *source,
+                                        uint64_t raw, uint64_t now,
+                                        uint64_t opportunity, bool observing,
+                                        uint64_t *value, bool *read_error)
+{
+    g_assert_nonnull(source);
+    g_assert_cmpuint(now, ==, 1000);
