+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Exercise literal bitmap/coordinate selection, then require live lifecycle coverage.
+
+The component fixture supplies only retained inventory and bitmap inputs. Public
+capture admission, Source/Root ownership, operational reads and ACK/retirement
+are not extracted into primitive stand-ins. The mandatory driver remains a
+failure until a genuine launched-QEMU lifecycle cohort is integrated; component
+success cannot satisfy that separate requirement. See crucible-dirty-iterator.rst.
+"""
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import shlex
+import subprocess
+
+
+BASE_COMMIT = "e8c0b3207f8b69eb685b3c6c5284b9bc6b5a55c5"
+
+
+OLD_DIRTY = r"""static bool capture_page_dirty(RAMBlock *block, uint64_t offset, size_t valid)
+{
+    ram_addr_t start = block->offset + offset;
+    ram_addr_t end = start + valid;
+
+    for (ram_addr_t address = start & TARGET_PAGE_MASK;
+         address < end; address += TARGET_PAGE_SIZE) {
+        if (physical_memory_get_dirty_flag(address, DIRTY_MEMORY_CRUCIBLE_RAM)) {
+            return true;
+        }
+    }
+    return false;
+}"""
+
+
+# The frozen page-by-page algorithm supplies the coordinate oracle only.
+# No capture-validity provider, operational reader or lifecycle result is modeled.
+# Only its container accessor spelling follows the private inventory replacement.
+OLD_COORDINATE = r"""static int old_next_page_coordinate(
+    struct qemu_plugin_crucible_ram_page_v1 *out,
+    CrucibleRamRegion **selected, uint64_t *selected_offset)
+{
+    while (capture_region_cursor < capture_regions->len) {
+        CrucibleRamRegion *region = region_inventory_index(capture_regions, capture_region_cursor);
+        uint64_t page_count = DIV_ROUND_UP(region->descriptor.logical_length, RAM_PAGE_BYTES);
+
+        while (capture_page_cursor < page_count) {
+            uint64_t page_index = capture_page_cursor++;
+            uint64_t offset = page_index * RAM_PAGE_BYTES;
+            size_t valid = MIN((uint64_t)RAM_PAGE_BYTES,
+                               region->descriptor.logical_length - offset);
+
+            if (!capture_full && !capture_page_dirty(region->block, offset, valid)) {
+                continue;
+            }
+            memset(out, 0, sizeof(*out));
+            out->region_index = capture_region_cursor;
+            out->valid_length = valid;
+            out->page_index = page_index;
+            out->page_version = capture_dirty_generation;
+            *selected = region;
+            *selected_offset = offset;
+            return 0;
+        }
+        capture_region_cursor++;
+        capture_page_cursor = 0;
+    }
+    return 1;
+}"""
+
+
+def definition(text, name):
+    """Extract the exact named production function without a parser framework."""
+    start = text.index(name)
+    start = text.rfind("\n", 0, start) + 1
+    opening = text.index("{", start)
+    depth = 0
+    for index in range(opening, len(text)):
+        depth += (text[index] == "{") - (text[index] == "}")
+        if depth == 0:
+            return text[start:index + 1]
+    raise ValueError(f"unterminated production function: {name}")
+
+
+def counted_bitmap(body):
+    """Count every executed word load without replacing bitmap search logic."""
+    replacements = {
+        "*(p++)": "fixture_word(p++)",
+        "*(p+1)": "fixture_word(p+1)",
+        "*(p+2)": "fixture_word(p+2)",
+        "*(p+3)": "fixture_word(p+3)",
+        "*p;": "fixture_word(p);",
+    }
+    proof = {}
+    for before, after in replacements.items():
+        count = body.count(before)
+        if count == 0:
+            raise ValueError(f"reviewed bitmap load is absent: {before}")
+        proof[before] = count
+        body = body.replace(before, after)
+    return body, proof
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--source-root", type=Path,
+                        default=Path(__file__).resolve().parents[2])
+    parser.add_argument("--output-dir", type=Path, required=True)
+    arguments = parser.parse_args()
+    source = arguments.source_root
+    output = arguments.output_dir
+    output.mkdir(parents=True, exist_ok=True)
+
+    physmem = (source / "system/physmem.c").read_text()
+    capture = (source / "plugins/crucible-paged-ram.c").read_text()
+    bitops = (source / "util/bitops.c").read_text()
+    bodies = {
+        "bitmap": definition(bitops, "find_next_bit("),
+        "old_range_query": definition(physmem, "physical_memory_get_dirty("),
+        "old_flag_query": definition(physmem, "physical_memory_get_dirty_flag("),
+        "iterator": definition(physmem, "qemu_crucible_ram_next_dirty_range("),
+        "coordinate": definition(capture, "capture_next_page_coordinate("),
+        "old_dirty": OLD_DIRTY,
+        "old_coordinate": OLD_COORDINATE,
+    }
+    header = "\n\n".join([
+        bodies["bitmap"], bodies["old_range_query"], bodies["old_flag_query"],
+        bodies["iterator"], OLD_DIRTY, OLD_COORDINATE, bodies["coordinate"],
+    ])
+    counted, load_proof = counted_bitmap(bodies["bitmap"])
+    fixture = source / "tests/unit/test-crucible-dirty-selector.c"
+    compiler = shlex.split(os.environ.get("CC", "cc"))
+    flags = shlex.split(os.environ.get("CFLAGS", "-O2 -std=gnu11 -Wall -Wextra"))
+    links = shlex.split(os.environ.get("LDFLAGS", ""))
+    variants = []
+    commands = []
+    # Fixed dimensions are independent of the generated component's report.
+    ordinary_matrix_cases = 7 * 3 * (256 + 1) + 7 * 2 + 7 * 2 + 2
+    ram32_matrix_cases = 7 * 3 * (256 + 1) + 1 * 2 + 7 * 2 + 2
+    for role, bitmap, extra in (
+        ("unchanged-primitive", bodies["bitmap"], []),
+        ("counted-primitive", counted, []),
+        ("modeled-32-bit-index", counted, ["-DFIXTURE_INDEX_32"]),
+        ("modeled-32-bit-ram-address", counted, ["-DFIXTURE_RAM_ADDR_32"]),
+    ):
+        (output / "extracted-production.h").write_text(
+            "/* SPDX-License-Identifier: GPL-2.0-or-later */\n" +
+            ("#define FIXTURE_COUNTED 1\n" if role != "unchanged-primitive" else "") +
+            header.replace(bodies["bitmap"], bitmap, 1) + "\n")
+        executable = output / role
+        command = compiler + flags + extra + ["-I" + str(output), str(fixture),
+                                              "-o", str(executable)] + links
+        commands.append(command)
+        subprocess.run(command, check=True)
+        result = subprocess.run([str(executable)], check=True,
+                                text=True, capture_output=True)
+        fields = dict(token.split("=", 1) for token in result.stdout.split()
+                      if "=" in token)
+        expected_matrix_cases = (ram32_matrix_cases
+                                 if role == "modeled-32-bit-ram-address"
+                                 else ordinary_matrix_cases)
+        if (int(fields["matrix_cases"]) != expected_matrix_cases or
+                int(fields["cases"]) != expected_matrix_cases + 1):
+            raise ValueError(f"{role}: incomplete fixed selector matrix")
+        print(role + ": " + result.stdout.strip())
+        variants.append({"role": role, "stdout": result.stdout.strip(),
+                         "executable_sha256": hashlib.sha256(
+                             executable.read_bytes()).hexdigest()})
+    if any(row["stdout"].split(" work=")[0] != variants[0]["stdout"].split(" work=")[0]
+           for row in variants[1:3]):
+        raise ValueError("instrumentation or index width changed ordered capture evidence")
+    # Invoke the component directly: the driver's unconditional lifecycle
+    # failure can never count as a component mutant kill. Require the precise
+    # matrix-coverage detector, not any compiler error or arbitrary nonzero exit.
+    fixture_text = fixture.read_text()
+    matrix_call = "    matrix();\n"
+    if fixture_text.count(matrix_call) != 1:
+        raise ValueError("reviewed matrix omission site changed")
+    omitted_fixture = output / "matrix-omitted.c"
+    omitted_fixture.write_text(fixture_text.replace(
+        matrix_call, "    (void)matrix; /* Omit the call, retain its declaration use. */\n", 1))
+    omitted_executable = output / "matrix-omitted"
+    omitted_command = compiler + flags + [
+        "-I" + str(output), str(omitted_fixture), "-o", str(omitted_executable),
+    ] + links
+    commands.append(omitted_command)
+    subprocess.run(omitted_command, check=True)
+    omitted = subprocess.run([str(omitted_executable)], text=True,
+                             capture_output=True)
+    omission_marker = "FAIL component matrix coverage: actual=0 expected=5427"
+    if omitted.returncode == 0 or omission_marker not in omitted.stderr:
+        raise ValueError("matrix omission did not reach its coverage detector")
+    matrix_omission = {
+        "invoked_component_directly": True,
+        "returncode": omitted.returncode,
+        "stderr": omitted.stderr.strip(),
+        "required_marker": omission_marker,
+        "lifecycle_failure_counted_as_kill": False,
+    }
+    proof = {
+        "baseline_commit": BASE_COMMIT,
+        "component_only": True,
+        "native_execution_qualified": False,
+        "mandatory_lifecycle_qualified": False,
+        "mandatory_lifecycle_status": "missing-genuine-launched-qemu-integration",
+        "dependency_sha256": {
+            name: hashlib.sha256((source / name).read_bytes()).hexdigest()
+            for name in (
+                "util/bitops.c", "system/physmem.c",
+                "plugins/crucible-paged-ram.c",
+                "tests/unit/test-crucible-dirty-selector.c",
+                "tests/unit/test-crucible-dirty-iterator.py",
+            )
+        },
+        "production_body_sha256": {name: hashlib.sha256(body.encode()).hexdigest()
+                                   for name, body in bodies.items()},
+        "bitmap_load_substitutions": load_proof,
+        "variants": variants,
+        "expected_matrix_cases": {
+            "ordinary_and_index32": ordinary_matrix_cases,
+            "ram_address32": ram32_matrix_cases,
+        },
+        "matrix_omission_control": matrix_omission,
+    }
+    (output / "proof.json").write_text(json.dumps(proof, indent=2, sort_keys=True) + "\n")
+    (output / "compile-command.json").write_text(json.dumps(commands, indent=2) + "\n")
+    print("PASS dirty selector component: ordered coordinates, runtime page sizes, "
+          "bitmap work counts, overflow, RCU and mutation visibility", flush=True)
+    # No flag, caller-supplied receipt or component success can promote this to
+    # an ACK/capture/Source qualification. Wire the real emulator cohort here.
+    raise SystemExit(
+        "FAIL mandatory capture lifecycle: genuine launched-QEMU Source/Root "
+        "ownership, read/post/rearm/ACK and physical-return coverage is not "
+        "integrated; component evidence is insufficient"
+    )
+
+
+if __name__ == "__main__":
+    main()
