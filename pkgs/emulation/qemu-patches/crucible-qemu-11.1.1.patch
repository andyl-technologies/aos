+CrucibleSelectableReplyCompletion *qmp_crucible_complete_selectable_reply(
+    uint64_t request_sequence, uint64_t logical_boundary_icount,
+    uint64_t expected_completed_requests, uint32_t vcpu_index, Error **errp)
+{
+    struct qemu_plugin_crucible_selectable_reply_status status = { 0 };
+    CrucibleSelectableReplyCompletion *completion;
+    int result;
+
+    if (!bql_locked() || !runstate_check(RUN_STATE_PAUSED) ||
+        !qemu_plugin_crucible_vmstop_pending() ||
+        qemu_plugin_crucible_vmstop_admission_pending()) {
+        error_setg(errp,
+                   "Crucible selectable reply requires an admitted paused VM-stop boundary");
+        return NULL;
+    }
+    result = qemu_plugin_crucible_vmstop_flush_status();
+    if (result != 0) {
+        error_setg_errno(errp, result > 0 ? result : -result,
+                         "Crucible selectable reply requires a successful VM-stop flush");
+        return NULL;
+    }
+
+    result = qemu_plugin_crucible_complete_selectable_reply(
+        request_sequence, logical_boundary_icount, expected_completed_requests,
+        vcpu_index, &status);
+    if (result != 0) {
+        error_setg_errno(errp, result > 0 ? result : -result,
+                         "Crucible selectable reply completion rejected");
+        return NULL;
+    }
+
+    completion = g_new0(CrucibleSelectableReplyCompletion, 1);
+    completion->request_sequence = status.request_sequence;
+    completion->raw_boundary_icount = status.raw_boundary_icount;
+    completion->logical_boundary_icount = status.logical_boundary_icount;
+    completion->completed_requests = status.completed_requests;
+    completion->vcpu_index = status.vcpu_index;
+    return completion;
+}
