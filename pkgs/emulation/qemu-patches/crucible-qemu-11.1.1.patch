+static QMPRequest *monitor_qmp_request_pop(MonitorQMP *mon)
+{
+    QMPRequest *request;
+
+    if (!mon->parent_obj.crucible_purpose) {
+        return g_queue_pop_head(mon->qmp_requests);
+    }
+    request = mon->crucible_request_head;
+    if (request) {
+        mon->crucible_request_head = request->queue_next;
+        request->queue_next = NULL;
+        mon->crucible_request_count--;
