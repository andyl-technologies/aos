+/* Operate only on the actual FP client bitmap. Generic log_clear listeners
+ * and checkpoint/migration masks do not participate in logical consumption. */
+static int logical_capture_dirty(bool restore)
+{
+    WITH_RCU_READ_LOCK_GUARD() {
+        DirtyMemoryBlocks *blocks =
+            qatomic_rcu_read(&ram_list.dirty_memory[DIRTY_MEMORY_CRUCIBLE_RAM]);
+        size_t block_count;
+
+        if (!blocks || blocks->allocation_bytes < offsetof(DirtyMemoryBlocks, blocks)) {
+            return -ESTALE;
+        }
+        block_count = (blocks->allocation_bytes - offsetof(DirtyMemoryBlocks, blocks)) /
+            sizeof(blocks->blocks[0]);
+        /* Validate the complete bitmap address set before its first mutation. */
+        for (size_t index = 0; index < capture_regions->len; index++) {
+            const CrucibleRamRegion *region = region_inventory_index(capture_regions, index);
+            ram_addr_t end = region->fingerprint_ram_offset + region->fingerprint_capture_end;
+
+            if (region->fingerprint_capture_end) {
+                ram_addr_t begin = region->fingerprint_ram_offset + region->fingerprint_capture_start;
+                size_t first = (begin >> TARGET_PAGE_BITS) / DIRTY_MEMORY_BLOCK_SIZE;
+                size_t last = ((end - 1) >> TARGET_PAGE_BITS) / DIRTY_MEMORY_BLOCK_SIZE;
+
+                if (last >= block_count) {
+                    return -ESTALE;
+                }
+                for (size_t block = first; block <= last; block++) {
+                    if (!blocks->blocks[block]) {
+                        return -ESTALE;
+                    }
+                }
+            }
+        }
+        for (size_t index = 0; index < capture_regions->len; index++) {
+            const CrucibleRamRegion *region = region_inventory_index(capture_regions, index);
+            ram_addr_t begin = region->fingerprint_ram_offset + region->fingerprint_capture_start;
+            ram_addr_t end = region->fingerprint_ram_offset + region->fingerprint_capture_end;
+            ram_addr_t page = begin >> TARGET_PAGE_BITS;
+            ram_addr_t last = end > begin ? ((end - 1) >> TARGET_PAGE_BITS) + 1 : page;
+
+            while (page < last) {
+                size_t block = page / DIRTY_MEMORY_BLOCK_SIZE;
+                unsigned long bit = page % DIRTY_MEMORY_BLOCK_SIZE;
+                unsigned long count = MIN(last - page, DIRTY_MEMORY_BLOCK_SIZE - bit);
+
+                if (!blocks->blocks[block]) {
+                    return -ESTALE;
+                }
+                if (restore) {
+                    bitmap_set_atomic(blocks->blocks[block], bit, count);
+                } else {
+                    bitmap_test_and_clear_atomic(blocks->blocks[block], bit, count);
+                }
+                page += count;
+            }
+        }
+    }
+    return 0;
+}
+
+static int logical_capture_transfer_physical_debt(void)
+{
+    if (!logical_physical_debt.pending) {
+        CrucibleRamInventory *retained = NULL;
+        int status = region_inventory_ref(logical_capture->regions, &retained);
+
+        if (status) {
+            return status;
+        }
+        logical_physical_debt.regions = retained;
+        logical_physical_debt.topology = logical_capture->topology;
+        qatomic_store_release(&logical_physical_debt.pending, true);
+    }
+    if (logical_physical_debt.regions != logical_capture->regions ||
+        logical_physical_debt.topology != logical_capture->topology) {
+        return -ESTALE;
+    }
+    for (size_t index = 0; index < capture_regions->len; index++) {
+        const CrucibleRamRegion *current = region_inventory_index(capture_regions, index);
+        CrucibleRamRegion *retained = region_inventory_index(logical_physical_debt.regions, index);
+
+        if (current->fingerprint_capture_end) {
+            retained->fingerprint_physical_start = retained->fingerprint_physical_end ?
+                MIN(retained->fingerprint_physical_start, current->fingerprint_capture_start) :
+                current->fingerprint_capture_start;
+            retained->fingerprint_physical_end = MAX(retained->fingerprint_physical_end,
+                                                    current->fingerprint_capture_end);
+        }
+    }
+    return 0;
+}
+
+static void logical_capture_rearm_tlbs(void)
+{
+    CPUState *cpu;
+
+    if (!tcg_enabled()) {
+        return;
+    }
+    /* Actual writer closure and BQL stabilize the CPU inventory. Single-thread
+     * RR alone would not imply one CPUState. This synchronous existing helper
+     * scans normal and victim entries of EVERY CPU, without queued CPU work. */
+    WITH_RCU_READ_LOCK_GUARD() {
+        for (size_t index = 0; index < capture_regions->len; index++) {
+            const CrucibleRamRegion *region = region_inventory_index(capture_regions, index);
+            uint64_t begin = region->fingerprint_capture_start & TARGET_PAGE_MASK;
+            uint64_t end = TARGET_PAGE_ALIGN(region->fingerprint_capture_end);
+
+            if (end > begin) {
+                CPU_FOREACH(cpu) {
+                    tlb_reset_dirty(cpu, (uintptr_t)region->block->host + begin, end - begin);
+                }
+            }
+        }
+    }
+}
+
+static void logical_capture_history(void)
+{
+    if (logical_capture->first_status && !logical_physical_debt.first_status) {
+        logical_physical_debt.first_status = logical_capture->first_status;
+    }
+    if (logical_capture->post_status && !logical_physical_debt.post_status) {
+        logical_physical_debt.post_status = logical_capture->post_status;
+    }
+    if (logical_capture->return_status && !logical_physical_debt.return_status) {
+        logical_physical_debt.return_status = logical_capture->return_status;
+    }
+    if (logical_capture->outer_end_status && !logical_physical_debt.outer_end_status) {
+        logical_physical_debt.outer_end_status = logical_capture->outer_end_status;
+    }
+    if (logical_capture->writer_return_status && !logical_physical_debt.writer_return_status) {
+        logical_physical_debt.writer_return_status = logical_capture->writer_return_status;
+    }
+    if (logical_capture->native_status && !logical_physical_debt.native_status) {
+        logical_physical_debt.native_status = logical_capture->native_status;
+    }
+}
+
+static int logical_capture_return_borrow(void)
+{
+    struct QemuCrucibleLogicalCapture *claim = logical_capture;
+    int status;
+
+    claim->attempted = true;
+    if (!claim->source_claim) {
+        return 0;
+    }
+    claim->returning = true;
+    status = qemu_crucible_startup_source_logical_capture_return_v1(
+        claim->operation, &claim->source_claim);
+    claim->returning = false;
+    /* Record actual physical consumption before interpreting the signed result.
+     * Native inventory is still live for post-return version checks/restore. */
+    if (status && !claim->return_status) {
+        claim->return_status = status;
+    }
+    return status;
+}
+
+static int logical_capture_close_native(void)
+{
+    struct QemuCrucibleLogicalCapture *claim = logical_capture;
+    int first = 0, status;
+
+    if (claim->source_claim || claim->progress.borrowed || claim->progress.published ||
+        claim->outer_owner_retained || claim->writer_owner_retained ||
+        fingerprint_root_background.source || fingerprint_root_background.token) {
+        return 0;
+    }
+    if ((capture_active && claim->generation == capture_generation) ||
+        inventory_return_pending(&claim->capture_return)) {
+        status = region_inventory_return(&capture_regions, &claim->capture_return);
+        if (!first) {
+            first = status;
+        }
+        if (!capture_regions && claim->capture_return.consumed) {
+            capture_active = false;
+            capture_owner_token = 0;
+            capture_observation_only = false;
+        }
+    }
+    status = region_inventory_return(&claim->baseline_pending_regions,
+                                     &claim->baseline_pending_return);
+    if (!first) {
+        first = status;
+    }
+    status = region_inventory_return(&claim->regions, &claim->regions_return);
+    if (!first) {
+        first = status;
+    }
+    claim->metadata_cleanup_pending =
+        inventory_return_pending(&claim->capture_return) ||
+        inventory_return_pending(&claim->regions_return) ||
+        inventory_return_pending(&claim->baseline_pending_return);
+    if (first && !claim->return_status) {
+        claim->return_status = first;
+    }
+    logical_capture_history();
+    if (!claim->metadata_cleanup_pending && !capture_regions && !claim->regions &&
+        !claim->baseline_pending_regions) {
+        claim->operation = NULL;
+        qatomic_store_release(&claim->active, false);
+    }
+    return first ? first : claim->metadata_cleanup_pending ? -EBUSY : 0;
+}
+
+static int logical_capture_result(void)
+{
+    const struct QemuCrucibleLogicalCapture *claim = logical_capture;
+
+    return claim->first_status ? claim->first_status :
+        claim->post_status ? claim->post_status :
+        claim->native_status ? claim->native_status :
+        claim->return_status ? claim->return_status :
+        claim->outer_end_status ? claim->outer_end_status :
+        claim->writer_return_status ? claim->writer_return_status :
+        (claim->attempted && claim->source_claim) || claim->outer_owner_retained ||
+        claim->writer_owner_retained ||
+        claim->progress.borrowed || claim->progress.published ||
+        claim->metadata_cleanup_pending ? -EBUSY : 0;
+}
+
+static int logical_capture_root_return(int callback_first, int original_post)
+{
+    struct QemuCrucibleLogicalCapture *claim = logical_capture;
+    int status, observed;
+
+    if (!claim->active) {
+        return callback_first ? callback_first : original_post;
+    }
+    /* Signed causal facts remain independent. Aggregate return values never
+     * become either semantic first or independent Original post. */
+    if (callback_first && !claim->first_status) {
+        claim->first_status = callback_first;
+    }
+    if (original_post && !claim->post_status) {
+        claim->post_status = original_post;
+    }
+    if ((!claim->publication || !claim->publication->borrowed ||
+         claim->publication->claim != claim) && !claim->native_status) {
+        claim->native_status = -ECANCELED;
+    }
+    if (!claim->staged && !claim->first_status) {
+        claim->native_status = -EBUSY;
+    }
+    if (claim->attached && !claim->attempted) {
+        /* Source consumes the SAME recorded independent outer post. */
+        observed = qemu_crucible_startup_source_logical_capture_post_v1(
+            claim->operation, claim);
+        if (observed != original_post && !claim->native_status) {
+            claim->native_status = -EPROTO;
+        }
+    }
+    status = logical_capture_result();
+    if (!status) {
+        status = logical_capture_geometry_current();
+        if (!status && !logical_capture_versions_current()) {
+            status = -ESTALE;
+        }
+        if (!status) {
+            status = logical_capture_transfer_physical_debt();
+        }
+        if (!status) {
+            /* The real debt reference/intervals exist before client bits leave. */
+            claim->logical_cleared = true;
+            status = logical_capture_dirty(false);
+            logical_capture_rearm_tlbs();
+        }
+        smp_mb();
+        if (!status) {
+            status = logical_capture_geometry_current();
+        }
+        if (!status && !logical_capture_versions_current()) {
+            status = -ESTALE;
+        }
+        if (status && !claim->native_status) {
+            claim->native_status = status;
+        }
+    }
+    /* Physical consumption is recorded through the real pointer regardless of
+     * earlier semantic/post/native failure. Preserve its OWN signed result. */
+    logical_capture_return_borrow();
+    logical_capture_history();
+    /* Inventory and bitmap addresses stay held through OUTER physical end. */
+    return logical_capture_result();
+}
+
+static int logical_capture_outer_return(int status, int outer_end, bool owner_retained)
+{
+    struct QemuCrucibleLogicalCapture *claim = logical_capture;
+    int native = 0;
+
+    if (!claim->active) {
+        return status;
+    }
+    if (outer_end && !claim->outer_end_status) {
+        claim->outer_end_status = outer_end;
+    }
+    claim->outer_owner_retained = owner_retained;
+    smp_mb();
+    if (!logical_capture_result()) {
+        native = logical_capture_geometry_current();
+        if (native && !claim->native_status) {
+            claim->native_status = native;
+        }
+    }
+    if (logical_capture_result() && claim->logical_cleared) {
+        int restored = logical_capture_dirty(true);
+
+        if (restored && !claim->native_status) {
+            claim->native_status = restored;
+        }
+    }
+    status = logical_capture_result();
+    logical_capture_history();
+    return status;
+}
+
+static int logical_capture_writer_return(int status, int writer_return, bool writer_retained)
+{
+    struct QemuCrucibleLogicalCapture *claim = logical_capture;
+
+    if (!claim->active) {
+        return status;
+    }
+    if (writer_return && !claim->writer_return_status) {
+        claim->writer_return_status = writer_return;
+    }
+    claim->writer_owner_retained = writer_retained;
+    if (!logical_capture_result()) {
+        int checked = logical_capture_geometry_check(false);
+
+        if (checked) {
+            claim->native_status = checked;
+        }
+    }
+    if (!logical_capture_result() && claim->initializing) {
+        if (!capture_full || !claim->staged ||
+            capture_region_cursor != capture_regions->len ||
+            !claim->baseline_pending_regions || fingerprint_root_operation ||
+            fingerprint_root_writer || claim->source_claim ||
+            claim->progress.borrowed || claim->progress.published) {
+            claim->native_status = -EPERM;
+        }
+    }
+    if (logical_capture_result() && claim->logical_cleared) {
+        int restored = logical_capture_dirty(true);
+
+        if (restored && !claim->native_status) {
+            claim->native_status = restored;
+        }
+    }
+    status = logical_capture_result();
+    logical_capture_history();
+    return status;
+}
+
+int qemu_plugin_crucible_ram_logical_capture_restart_v1(
+    qemu_plugin_id_t id, qemu_plugin_crucible_fingerprint_operation_v1 *operation,
+    uint32_t require_full, struct qemu_plugin_crucible_ram_capture_v1 *out)
+{
+    struct QemuCrucibleLogicalCapture *retired = logical_capture;
+    int status;
+
+    if (!out || require_full > 1 || !retired->active || retired->id != id ||
+        retired->operation != operation || operation != fingerprint_root_operation ||
+        !logical_root_invocation || fingerprint_root_outcome.callback_returned ||
+        !retired->attached || retired->source_claim != retired ||
+        retired->staged || retired->attempted || !capture_active ||
+        retired->progress.borrowed || retired->progress.published ||
+        !fingerprint_root_writer || ordinary_fingerprint.operation_borrowed) {
+        return -EPERM;
+    }
+    status = qemu_crucible_ram_fingerprint_root_module_current_v1(id);
+    if (!status) {
+        status = qemu_crucible_observation_writer_current_v1(fingerprint_root_writer);
+    }
+    if (!status) {
+        /* Retain actual already-read ranges on paid admission rows. No dirty
+         * bit has been acknowledged and no old generation can be replayed. */
+        status = logical_capture_transfer_physical_debt();
+    }
+    if (status) {
+        return status;
+    }
+    /* This nominal phase belongs only to the genuine still-invoking restart
+     * caller. Source authenticates it before identity-only borrower return. */
+    retired->restart_returning = true;
+    status = logical_capture_return_borrow();
+    retired->restart_returning = false;
+    if (status || retired->source_claim) {
+        logical_capture_history();
+        return status ? status : -EBUSY;
+    }
+    logical_capture_history();
+    status = logical_capture_close_native();
+    if (status || retired->active) {
+        return status ? status : -EBUSY;
+    }
+    /* Actual distinct native pointer; Source authenticates its own returned
+     * retired borrower before binding fresh generation/ranges on SAME Original. */
+    logical_capture = retired == &logical_capture_slots[0] ?
+        &logical_capture_slots[1] : &logical_capture_slots[0];
+    return logical_capture_begin(id, operation, NULL, fingerprint_root_writer,
+                                 require_full, out, retired, NULL);
+}
+
+/* Finite creating-Main retry before fresh operation admission. No read/post,
+ * rearm, Original, clock or dirty ACK is invoked. */
+int qemu_plugin_crucible_ram_logical_capture_return_v1(
+    qemu_plugin_id_t id, qemu_plugin_crucible_logical_capture_v1 **selector)
+{
+    struct QemuCrucibleLogicalCapture *claim = logical_capture;
+    int status;
+
+    if (!selector || (*selector && *selector != claim) || !claim->active ||
+        claim->id != id || (!claim->source_claim && !claim->metadata_cleanup_pending) ||
+        !claim->attempted ||
+        !bql_locked() || !qemu_in_main_thread() || current_cpu || qemu_in_coroutine() ||
+        fingerprint_root_frame.active ||
+        claim->process != getpid() || !qemu_thread_is_self(&claim->thread)) {
+        return -EPERM;
+    }
+    if (claim->source_claim) {
+        *selector = claim;
+    }
+    status = logical_capture_return_borrow();
+    if (!claim->source_claim) {
+        *selector = NULL;
+    }
+    logical_capture_history();
+    int metadata_return = logical_capture_close_native();
+
+    return status ? status : metadata_return;
+}
+
+static int capture_finish_return_current(uint64_t generation,
+                                         uint64_t owner_token, uint32_t commit)
+{
+    if (capture_finish_return.phase == RAM_CAPTURE_FINISH_IDLE ||
+        capture_finish_return.phase == RAM_CAPTURE_FINISH_COMPLETE) {
+        return -ESTALE;
+    }
+    if (!bql_locked() || generation != capture_finish_return.generation ||
+        owner_token != capture_finish_return.owner_token ||
+        commit != capture_finish_return.commit ||
+        getpid() != capture_finish_return.process ||
+        !qemu_thread_is_self(&capture_finish_return.thread)) {
+        return -EPERM;
+    }
+    if (capture_finish_return.phase == RAM_CAPTURE_FINISH_EFFECTS_STARTED) {
+        /* BQL does not exclude same-thread callbacks. An Original/end callout
+         * cannot enter inventory cleanup while its outer effect is active. */
+        return -EINPROGRESS;
+    }
+    return capture_finish_return.continuing ? -EBUSY : 0;
+}
+
+static int capture_finish_inventory_continue(void)
+{
+    int status;
+
+    if (capture_finish_return.phase != RAM_CAPTURE_FINISH_CLEANUP_READY ||
+        capture_finish_return.continuing) {
+        return -EBUSY;
+    }
+    capture_finish_return.continuing = true;
+    status = region_inventory_return(&capture_regions,
+                                     &capture_finish_return.inventory);
+    capture_finish_return.continuing = false;
+
+    if (status && !capture_finish_return.first_status) {
+        capture_finish_return.first_status = status;
+    }
+    if (!capture_regions &&
+        !inventory_return_pending(&capture_finish_return.inventory)) {
+        capture_finish_return.phase = RAM_CAPTURE_FINISH_COMPLETE;
+        capture_active = false;
+        capture_owner_token = 0;
+        capture_observation_only = false;
+    }
+    return capture_finish_return.first_status;
+}
+
+int qemu_plugin_crucible_ram_capture_finish_v2(
+    uint64_t generation, uint64_t owner_token, uint32_t commit)
+{
+    int status = 0;
+    bool valid;
+
+    status = qemu_crucible_ram_metadata_return_context();
+    if (status < 0) {
+        return status;
+    }
+    if (!bql_locked()) {
+        return -EPERM;
+    }
+    status = 0;
+    if (capture_finish_return.phase != RAM_CAPTURE_FINISH_IDLE) {
+        status = capture_finish_return_current(generation, owner_token, commit);
+        if (status) {
+            return status;
+        }
+        /* This retained terminal owns only cleanup. It cannot re-enter the
+         * ACK/Original path or restore the failed live capture identity. */
+        return capture_finish_inventory_continue();
+    }
+    if (inventory_capture.active || candidate_capture.active || !capture_active ||
+        (!capture_observation_only && ordinary_fingerprint.invoking) ||
+        generation != capture_generation || owner_token != capture_owner_token || commit > 1) {
+        return -ESTALE;
+    }
+    if (commit && owner_token) {
+        return -EPERM;
+    }
+    valid = capture_valid(generation, owner_token);
+    if (commit && !valid) {
+        status = -ESTALE;
+    }
+    if (commit && !status) {
+        status = qemu_crucible_ram_diagnostic_failure();
+    }
+    if (commit && !status && capture_region_cursor != capture_regions->len) {
+        status = -EBUSY;
+    }
+    if (logical_capture->active) {
+        /* The callback cannot declare itself accepted. Keep native inventory
+         * and the entered Source borrower through its actual return and post. */
+        logical_capture->staged = commit && !status;
+        if (!commit && !status) {
+            status = -ECANCELED;
+        }
+        if (status && !logical_capture->first_status) {
+            logical_capture->first_status = status;
+        }
+        return status;
+    }
+    if (!bql_locked() || getpid() != capture_finish_return.process ||
+        !qemu_thread_is_self(&capture_finish_return.thread)) {
+        return -EPERM;
+    }
+    capture_finish_return.phase = RAM_CAPTURE_FINISH_EFFECTS_STARTED;
+    capture_finish_return.commit = commit;
+    if (commit && !status && !capture_observation_only) {
+        /* No legacy/nondeferred rearm-then-clear branch bypasses Original post
+         * or actual native version checks. Every physical ACK uses this cut. */
+        status = fingerprint_retirement_settle();
+    }
+    if (!capture_observation_only && ordinary_fingerprint.operation_borrowed) {
+        int cleanup = fingerprint_retirement_cancel(status);
+
+        if (!status) {
+            status = cleanup;
+        }
+    }
+    /* CPU/RR observations can accept a fresh logical view after their actual
+     * module observation post while physical fingerprint dirt stays untouched.
+     * Main noACK abort also closes native inventory on signed semantic failure. */
+    capture_finish_return.first_status = status;
+    capture_finish_return.phase = RAM_CAPTURE_FINISH_CLEANUP_READY;
+    return capture_finish_inventory_continue();
+}
