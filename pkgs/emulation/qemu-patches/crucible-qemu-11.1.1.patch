+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Exercise local discard exclusion and actual anonymous-page discard bodies.
+
+Real ordinary QOM allocations and qemu_anon_ram_alloc back factual component
+region/section/RAMBlock inputs. The production translation issues the actual
+intrusive children; no initialized RAM registry, Source, Initial Original or
+accepting provider is supplied. The RAM-list lock and BQL observation are
+component inputs. Actual anonymous madvise is reached through the public
+production discard bodies. Actual translation fills and drains the finite
+registry budget without direct membership insertion. Dirty tracking stays
+inactive; its unjoined effect has a refusal-only boundary. Actual NULL and
+retained-child RAM-free entry plus concurrent retirement exclusion also run,
+with an explicit refusal-only topology boundary. Initialized RAM/RCU
+reclaim is not executed. Guest-memfd success, reset remap, postcopy, managed
+eviction, initialized-machine and selected admission remain unexecuted.
+"""
+
+import argparse
+import hashlib
+import json
+import os
+import re
+from pathlib import Path
+import runpy
+import shlex
+import subprocess
+
+
+EXTRA = r'''
+#include "qemu/madvise.h"
+#include <sys/prctl.h>
+#include "qemu/mmap-alloc.h"
+#include "qemu/error-report.h"
+#include "qemu/crucible-paged-ram.h"
+#include "plugins/qemu-plugin.h"
+#include "system/trace.h"
+#include "migration/cpr.h"
+#include "hw/core/qdev.h"
+#include "system/xen.h"
+#include "system/xen-mapcache.h"
+#ifdef CONFIG_LINUX
+#include <linux/falloc.h>
+#endif
+
+unsigned int global_dirty_tracking;
+
+static void forbidden_dirty_effect(ram_addr_t start, ram_addr_t length,
+                                   uint8_t clients)
+{
+    assert(!"active dirty tracking is not joined by this component");
+}
+
+#define physical_memory_set_dirty_range forbidden_dirty_effect
+
+/* The real retirement body is tested only through NULL and retained-child
+ * entry refusal. Reaching its unjoined topology effect fails this component;
+ * it never constructs an initialized RAM registry or accepts a free. */
+static G_NORETURN void unsupported_retirement_effect(void)
+{
+    _exit(97);
+}
+
+#define qemu_crucible_ram_topology_will_change unsupported_retirement_effect
+'''
+
+
+CHECKS = r'''
+static void *foreign_return(void *opaque)
+{
+    assert(memory_region_read_discard_return(opaque) == -EPERM);
+    return NULL;
+}
+
+static void *foreign_discard(void *opaque)
+{
+    assert(ram_read_discard_begin(opaque) == 0);
+    pthread_barrier_wait(&loaded);
+    pthread_barrier_wait(&changed);
+    ram_read_discard_end();
+    return NULL;
+}
+
+static void *foreign_disposal(void *opaque)
+{
+    assert(ram_read_disposal_begin(opaque) == 0);
+    pthread_barrier_wait(&loaded);
+    pthread_barrier_wait(&changed);
+    ram_read_disposal_end();
+    return NULL;
+}
+
+static void check_retirement_refusal(RAMBlock *block)
+{
+    pid_t child = fork();
+    int status;
+
+    assert(child >= 0);
+    if (!child) {
+        qemu_ram_free(block);
+        _exit(98);
+    }
+    assert(waitpid(child, &status, 0) == child);
+    assert(WIFSIGNALED(status) && WTERMSIG(status) == SIGABRT);
+    assert(!ram_read_disposal_in_flight);
+}
+
+static void check_retirement_exclusion(FlatView *view, RAMBlock *block)
+{
+    MemoryRegionReadCustody custody = { 0 };
+    pthread_t thread;
+
+    assert(qemu_crucible_ram_read_disposal_storage_bytes() ==
+           sizeof(ram_read_disposal_in_flight));
+    qemu_ram_free(NULL);
+    assert(!ram_read_disposal_in_flight);
+    assert(pthread_barrier_init(&loaded, NULL, 2) == 0);
+    assert(pthread_barrier_init(&changed, NULL, 2) == 0);
+    assert(pthread_create(&thread, NULL, foreign_disposal, block) == 0);
+    pthread_barrier_wait(&loaded);
+    assert(ram_read_disposal_in_flight == 1);
+    assert(flatview_read_first_chunk_custody(view, 0, 5,
+        MEMTXATTRS_UNSPECIFIED, &custody) == -EBUSY);
+    assert(custody.reference_acquired && custody.region_reference_acquired);
+    assert(!custody.resize_acquired && !custody.discard_acquired);
+    assert(memory_region_read_custody_return(&custody) == 0);
+    assert(memory_region_read_custody_returned(&custody));
+    pthread_barrier_wait(&changed);
+    assert(pthread_join(thread, NULL) == 0);
+    pthread_barrier_destroy(&loaded);
+    pthread_barrier_destroy(&changed);
+    assert(!ram_read_disposal_in_flight);
+
+    ram_read_disposal_in_flight = UINT64_MAX;
+    assert(ram_read_disposal_begin(block) == -EOVERFLOW);
+    assert(ram_read_disposal_in_flight == UINT64_MAX);
+    ram_read_disposal_in_flight = 0;
+}
+
+static void check_bytes(uint8_t *bytes, size_t length, uint8_t expected)
+{
+    for (size_t index = 0; index < length; index++) {
+        assert(bytes[index] == expected);
+    }
+}
+
+/* All cursors below are issued by the actual shared translation and QOM
+ * pin/enrollment bodies. The array is ordinary component storage, not a
+ * Source payer or permission to populate a registry directly. */
+static void check_bounded_membership(FlatView *view)
+{
+    MemoryRegionReadCustody live[MEMORY_REGION_READ_CUSTODY_MAX] = { 0 };
+    MemoryRegionReadCustody rejected = { 0 }, replacement = { 0 };
+
+    assert(!ram_read_resize_registry.member_count);
+    assert(!ram_read_discard_registry.member_count);
+    for (size_t index = 0; index < ARRAY_SIZE(live); index++) {
+        assert(flatview_read_first_chunk_custody(view, 0, 5,
+            MEMTXATTRS_UNSPECIFIED, &live[index]) == -ENOTSUP);
+        assert(ram_read_resize_registry.member_count == index + 1);
+        assert(ram_read_discard_registry.member_count == index + 1);
+    }
+    assert(flatview_read_first_chunk_custody(view, 0, 5,
+        MEMTXATTRS_UNSPECIFIED, &rejected) == -ENOSPC);
+    assert(rejected.reference_acquired && rejected.region_reference_acquired);
+    assert(!rejected.resize_acquired && !rejected.discard_acquired);
+    assert(memory_region_read_custody_return(&rejected) == 0);
+    assert(memory_region_read_custody_returned(&rejected));
+    assert(ram_read_resize_registry.member_count == ARRAY_SIZE(live));
+    assert(ram_read_discard_registry.member_count == ARRAY_SIZE(live));
+
+    assert(memory_region_read_custody_return(&live[0]) == 0);
+    assert(ram_read_resize_registry.member_count == ARRAY_SIZE(live) - 1);
+    assert(ram_read_discard_registry.member_count == ARRAY_SIZE(live) - 1);
+    assert(memory_region_read_custody_return(&live[0]) == 0);
+    assert(ram_read_resize_registry.member_count == ARRAY_SIZE(live) - 1);
+    assert(ram_read_discard_registry.member_count == ARRAY_SIZE(live) - 1);
+    assert(flatview_read_first_chunk_custody(view, 0, 5,
+        MEMTXATTRS_UNSPECIFIED, &replacement) == -ENOTSUP);
+    assert(ram_read_resize_registry.member_count == ARRAY_SIZE(live));
+    assert(ram_read_discard_registry.member_count == ARRAY_SIZE(live));
+    assert(memory_region_read_custody_return(&replacement) == 0);
+    for (size_t index = 1; index < ARRAY_SIZE(live); index++) {
+        assert(memory_region_read_custody_return(&live[index]) == 0);
+        assert(memory_region_read_custody_returned(&live[index]));
+    }
+    assert(QLIST_EMPTY(&ram_read_resize_registry.members));
+    assert(QLIST_EMPTY(&ram_read_discard_registry.members));
+    assert(!ram_read_resize_registry.member_count);
+    assert(!ram_read_discard_registry.member_count);
+}
+
+int main(void)
+{
+    const TypeInfo owner_type = {
+        .name = "discard-component-owner",
+        .parent = TYPE_OBJECT,
+        .instance_size = sizeof(Object),
+    };
+    const TypeInfo region_type = {
+        .name = "discard-component-region",
+        .parent = TYPE_OBJECT,
+        .instance_size = sizeof(MemoryRegion),
+    };
+    Object *owner;
+    MemoryRegion *region;
+    MemoryRegionReadCustody custody = { 0 }, copied;
+    uint64_t alignment = 0;
+    size_t page = qemu_real_host_page_size();
+    uint8_t *bytes;
+    pthread_t thread;
+    int status;
+    uint64_t serial;
+    pid_t child;
+
+    /* Intentional assertion mutants must not start an external core writer. */
+    assert(prctl(PR_SET_DUMPABLE, 0) == 0);
+    assert(prctl(PR_GET_DUMPABLE) == 0);
+
+    module_call_init(MODULE_INIT_QOM);
+    type_register_static(&owner_type);
+    type_register_static(&region_type);
+    qemu_mutex_init(&component_ram_mutex);
+    component_bql = true;
+    owner = object_new(owner_type.name);
+    region = (MemoryRegion *)object_new(region_type.name);
+    bytes = qemu_anon_ram_alloc(page, &alignment, false, false);
+    assert(bytes && alignment >= page);
+    RAMBlock block = {
+        .mr = region, .host = bytes, .used_length = page,
+        .max_length = page, .page_size = page, .fd = -1, .guest_memfd = -1,
+    };
+    MemoryRegionSection sections[2] = {
+        { .mr = &io_mem_unassigned },
+        { .mr = region, .size = int128_make64(page) },
+    };
+    AddressSpaceDispatch dispatch = {
+        .mru_section = &sections[1], .phys_map = { .ptr = 1 },
+        .map = { .sections_nb = 2, .sections = sections },
+    };
+    FlatView view = { .dispatch = &dispatch };
+
+    region->owner = owner;
+    region->ram = true;
+    region->ram_block = &block;
+    assert(qemu_crucible_ram_read_discard_storage_bytes() ==
+           sizeof(ram_read_discard_registry));
+    memset(bytes, 0xa7, page);
+    assert(ram_block_discard_shared_range(&block, 0, page) == 0);
+    check_bytes(bytes, page, 0);
+    assert(!ram_read_discard_registry.writers);
+    memset(bytes, 0xa7, page);
+    assert(ram_block_discard_range(&block, 0, page) == 0);
+    check_bytes(bytes, page, 0);
+    assert(!ram_read_discard_registry.writers);
+
+    /* Existing incomplete managed ownership refuses before actual madvise. */
+    memset(bytes, 0xa7, page);
+    paging_topology_pinned = true;
+    assert(ram_block_discard_range(&block, 0, page) == -EBUSY);
+    check_bytes(bytes, page, 0xa7);
+    assert(!ram_read_discard_registry.writers);
+    paging_topology_pinned = false;
+
+    assert(flatview_read_first_chunk_custody(&view, 0, 5,
+        MEMTXATTRS_UNSPECIFIED, &custody) == -ENOTSUP);
+    assert(custody.resize_acquired && custody.discard_acquired);
+    assert(ram_read_resize_registry.member_count == 1);
+    assert(ram_read_discard_registry.member_count == 1);
+    assert(custody.discard_attempted && custody.discard_serial);
+    assert(custody.discard_canonical == &custody);
+    assert(QLIST_FIRST(&ram_read_discard_registry.members) == &custody);
+    assert(owner->ref == 2 && OBJECT(region)->ref == 2);
+    assert(ram_block_discard_shared_range(&block, 0, page) == -EBUSY);
+    assert(ram_block_discard_range(&block, 0, page) == -EBUSY);
+    assert(ram_block_discard_guest_memfd_range(&block, 0, page) == -EBUSY);
+    check_bytes(bytes, page, 0xa7);
+    assert(!ram_read_discard_registry.writers);
+    assert(memory_region_read_resize_return(&custody) == -EBUSY);
+    check_retirement_refusal(&block);
+    serial = custody.discard_serial;
+    custody.discard_serial = 0;
+    assert(memory_region_read_discard_return(&custody) == -ESTALE);
+    custody.discard_serial = serial;
+
+    copied = custody;
+    assert(memory_region_read_discard_return(&copied) == -EPERM);
+    assert(pthread_create(&thread, NULL, foreign_return, &custody) == 0);
+    assert(pthread_join(thread, NULL) == 0);
+    child = fork();
+    assert(child >= 0);
+    if (!child) {
+        _exit(memory_region_read_discard_return(&custody) == -EPERM ? 0 : 1);
+    }
+    assert(waitpid(child, &status, 0) == child);
+    assert(WIFEXITED(status) && WEXITSTATUS(status) == 0);
+    component_bql = false;
+    assert(memory_region_read_discard_return(&custody) == -EPERM);
+    component_bql = true;
+
+    /* An attempted return without its receipt cannot unpublish or retry. */
+    custody.discard_return_attempted = true;
+    assert(memory_region_read_discard_return(&custody) == -EBUSY);
+    assert(QLIST_FIRST(&ram_read_discard_registry.members) == &custody);
+    custody.discard_return_attempted = false;
+    assert(memory_region_read_discard_return(&custody) == 0);
+    assert(custody.discard_return_attempted && custody.discard_returned);
+    assert(!ram_read_discard_registry.member_count);
+    assert(QLIST_EMPTY(&ram_read_discard_registry.members));
+    assert(memory_region_read_discard_return(&custody) == 0);
+    assert(!memory_region_read_custody_returned(&custody));
+    /* A remaining QOM/resize pin alone does not prevent local discard. */
+    assert(ram_block_discard_range(&block, 0, page) == 0);
+    check_bytes(bytes, page, 0);
+    assert(memory_region_read_custody_return(&custody) == 0);
+    assert(memory_region_read_custody_returned(&custody));
+    assert(owner->ref == 1 && OBJECT(region)->ref == 1);
+    assert(!ram_read_resize_registry.member_count);
+    copied = custody;
+    copied.discard_canonical = &copied;
+    copied.discard_return_attempted = false;
+    assert(memory_region_read_discard_return(&copied) == -ESTALE);
+
+    custody = (MemoryRegionReadCustody) { 0 };
+    assert(flatview_read_first_chunk_custody(&view, 0, 5,
+        MEMTXATTRS_UNSPECIFIED, &custody) == -ENOTSUP);
+    assert(memory_region_read_custody_return(&custody) == 0);
+    assert(memory_region_read_custody_returned(&custody));
+
+    custody = (MemoryRegionReadCustody) { 0 };
+    assert(pthread_barrier_init(&loaded, NULL, 2) == 0);
+    assert(pthread_barrier_init(&changed, NULL, 2) == 0);
+    assert(pthread_create(&thread, NULL, foreign_discard, &block) == 0);
+    pthread_barrier_wait(&loaded);
+    assert(flatview_read_first_chunk_custody(&view, 0, 5,
+        MEMTXATTRS_UNSPECIFIED, &custody) == -EBUSY);
+    assert(custody.resize_acquired && !custody.discard_acquired);
+    assert(custody.discard_attempted && !custody.discard_canonical);
+    assert(memory_region_read_custody_return(&custody) == 0);
+    assert(memory_region_read_custody_returned(&custody));
+    pthread_barrier_wait(&changed);
+    assert(pthread_join(thread, NULL) == 0);
+    assert(!ram_read_discard_registry.writers);
+    pthread_barrier_destroy(&loaded);
+    pthread_barrier_destroy(&changed);
+
+    check_retirement_exclusion(&view, &block);
+    check_bounded_membership(&view);
+
+    ram_read_discard_registry.serial = UINT64_MAX;
+    custody = (MemoryRegionReadCustody) { 0 };
+    assert(flatview_read_first_chunk_custody(&view, 0, 5,
+        MEMTXATTRS_UNSPECIFIED, &custody) == -EOVERFLOW);
+    assert(!custody.discard_acquired && !custody.discard_serial);
+    assert(memory_region_read_custody_return(&custody) == 0);
+    ram_read_discard_registry.writers = UINT64_MAX;
+    assert(ram_read_discard_begin(&block) == -EOVERFLOW);
+    assert(ram_read_discard_registry.writers == UINT64_MAX);
+    ram_read_discard_registry.writers = 0;
+    assert(ram_block_discard_range(&block, 0, page - 1) < 0);
+    assert(!ram_read_discard_registry.writers);
+    /* Invalid ordinary fd reaches the actual failed syscall, not a success. */
+    assert(ram_block_discard_guest_memfd_range(&block, 0, page) == -EBADF);
+    assert(!ram_read_discard_registry.writers);
+
+    object_unref(region);
+    object_unref(owner);
+    qemu_anon_ram_free(bytes, page);
+    printf("discard storage=%zu cursor=%zu\n",
+           sizeof(ram_read_discard_registry), sizeof(MemoryRegionReadCustody));
+    puts("PASS actual anonymous discard and intrusive child; no initialized RAM or Source");
+    return 0;
+}
+'''
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--source-root", type=Path, default=Path(__file__).resolve().parents[2])
+    parser.add_argument("--output-dir", type=Path, required=True)
+    parser.add_argument("--qemu-util", type=Path, required=True)
+    parser.add_argument("--qom-object", type=Path, action="append", default=[])
+    args = parser.parse_args()
+    root, output = args.source_root.resolve(), args.output_dir.resolve()
+    output.mkdir(parents=True, exist_ok=True)
+    function = runpy.run_path(str(root / "tests/unit/extract-crucible-startup-source-controls.py"))["function"]
+    base = runpy.run_path(str(root / "tests/unit/test-crucible-memory-region-custody.py"))
+    physical = (root / "system/physmem.c").read_text()
+    pager = (root / "plugins/crucible-paged-ram.c").read_text()
+    literal = base["PREFIX"] + EXTRA
+    literal += function((root / "qom/object.c").read_text(), "int object_ref_once(").replace(
+        "qatomic_read(&obj->ref)", "read_reference(&obj->ref)")
+    literal += "static MemoryRegion io_mem_unassigned;\n"
+    literal += physical[physical.index("typedef struct PhysPageEntry PhysPageEntry;"):
+                        physical.index("static void io_mem_init(void);")]
+    begin = physical.index("static struct {", physical.index("/* The existing RAM-list mutex serializes"))
+    literal += physical[begin:physical.index("/* The retained view already pins")]
+    literal += pager[pager.index("typedef struct CrucibleRamRegion {"):
+                     pager.index("/* The same two selected owners")]
+    literal += "#define region_inventory_index(array, index) ((array)->entries[(index)])\n"
+    literal += "static CrucibleRamInventory *admission_regions;\nstatic bool paging_topology_pinned;\n"
+    literal += function(pager, "bool qemu_crucible_ram_discard_conflicts(")
+    for name in ("bool qemu_ram_is_shared(",
+                 "static int ram_block_prepare_discard(",
+                 "static int ram_block_discard_shared_range_prepared(",
+                 "int ram_block_discard_shared_range(",
+                 "static int ram_block_discard_guest_memfd_range_body(",
+                 "static int ram_block_discard_range_prepared(",
+                 "int ram_block_discard_range(",
+                 "int ram_block_discard_guest_memfd_range(",
+                 "static inline bool section_covers_addr(",
+                 "static MemoryRegionSection *phys_page_find(",
+                 "static MemoryRegionSection *address_space_lookup_region(",
+                 "static MemoryRegionSection *\naddress_space_translate_internal(",
+                 "static MemoryRegionSection address_space_translate_iommu(",
+                 "static int flatview_read_region_custody(",
+                 "static MemoryRegionSection flatview_do_translate_custody(",
+                 "static MemoryRegionSection flatview_do_translate(",
+                 "int flatview_read_first_chunk_custody("):
+        source = physical[physical.index("/* A failed primary syscall"):] if (
+            "ram_block_" in name) else physical
+        literal += function(source, name)
+    literal += function((root / "system/memory.c").read_text(), "int memory_region_read_custody_return(")
+    literal += function(physical, "static char *cpr_name(")
+    literal += function(physical, "static void reclaim_ramblock(")
+    literal += function(physical, "void qemu_ram_free(")
+    literal += CHECKS
+    # Each change is scoped to one extracted production function. Every binary
+    # is compiled and linked afresh; a second guard is not silently removed.
+    defects = {
+        'retirement-exclusion': (
+            'ram_read_disposal_begin',
+            'if (member->ram_block == block)',
+            'if (false)',
+            'WIFSIGNALED(status) && WTERMSIG(status) == SIGABRT',
+        ),
+        'retirement-entry': (
+            'qemu_ram_free',
+            'if (ram_read_disposal_begin(block))',
+            'if (false)',
+            'WIFSIGNALED(status) && WTERMSIG(status) == SIGABRT',
+        ),
+        'retirement-birth': (
+            'ram_read_disposal_begin',
+            'ram_read_disposal_in_flight++;',
+            '',
+            'ram_read_disposal_in_flight == 1',
+        ),
+        'retirement-return': (
+            'ram_read_disposal_end',
+            'ram_read_disposal_in_flight--;',
+            '',
+            '!ram_read_disposal_in_flight',
+        ),
+        'retirement-capacity': (
+            'ram_read_disposal_begin',
+            'if (ram_read_disposal_in_flight == UINT64_MAX)',
+            'if (false)',
+            'ram_read_disposal_begin(block) == -EOVERFLOW',
+        ),
+        'retirement-enrollment': (
+            'ram_read_resize_acquire',
+            'if (ram_read_disposal_in_flight)',
+            'if (false)',
+            '!custody.resize_acquired && !custody.discard_acquired',
