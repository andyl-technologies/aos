+static Int128 crucible_fault_int128_from_memory(const uint8_t value[16])
+{
+    if (HOST_BIG_ENDIAN) {
+        return int128_make128(ldq_be_p(value + 8), ldq_be_p(value));
+    }
+    return int128_make128(ldq_le_p(value), ldq_le_p(value + 8));
+}
+
+static void crucible_fault_int128_to_memory(uint8_t value[16], Int128 number)
+{
+    if (HOST_BIG_ENDIAN) {
+        stq_be_p(value, int128_gethi(number));
+        stq_be_p(value + 8, int128_getlo(number));
+    } else {
+        stq_le_p(value, int128_getlo(number));
+        stq_le_p(value + 8, int128_gethi(number));
+    }
+}
+
+static uint64_t crucible_fault_load_beN(CPUState *cpu,
+                                        MMULookupPageData *p,
+                                        uint64_t ret_be, int mmu_idx,
+                                        MMUAccessType type, MemOp mop,
+                                        uintptr_t ra)
+{
+    uint8_t value[8];
+    uint64_t fragment = ret_be;
+    uint64_t prefix = 0;
+    unsigned bits = p->size * 8;
+
+    if (!crucible_fault_load_rules_active(type)) {
+        return ret_be;
+    }
+    if (p->size < sizeof(fragment)) {
+        uint64_t mask = (UINT64_C(1) << bits) - 1;
+
+        fragment &= mask;
+        prefix = ret_be >> bits;
+    }
+    for (int i = p->size - 1; i >= 0; i--) {
+        value[i] = fragment;
+        fragment >>= 8;
+    }
+    crucible_fault_memory_value(
+        cpu, p, crucible_fault_load_class(type), value, p->size,
+        (mop & MO_ATOM_MASK) != MO_ATOM_NONE, mmu_idx, ra);
+    fragment = 0;
+    for (int i = 0; i < p->size; i++) {
+        fragment = (fragment << 8) | value[i];
+    }
+    return p->size == sizeof(fragment) ? fragment :
+                                         (prefix << bits) | fragment;
+}
