+static int startup_setup_service_view(qemu_plugin_id_t id, uint32_t version,
+    size_t bytes, struct qemu_plugin_crucible_setup_borrow_v4 *out, bool begin)
+{
+#if defined(CONFIG_LINUX) && defined(__x86_64__) && !defined(__ILP32__)
+    QemuCruciblePublisherModuleService *service = &startup_source.publisher_module;
+    QemuCruciblePreexecSourceBorrow borrowed;
+    struct qemu_plugin_crucible_setup_borrow_v4 view;
+    int first;
+    int post;
+    int identity;
+
+    first = startup_setup_service_output_check(version, bytes, out);
+    if (first) {
+        return first;
+    }
+    if (!startup_invocation(id) || service->transferred) {
+        return -EPERM;
+    }
+    if (begin) {
+        first = qemu_crucible_preexec_purpose_borrow_v3(
+            startup_source.preexec_purpose_owner, &borrowed);
+        if (first) {
+            return first;
+        }
+        if (borrowed.plan->schema != 9 || !startup_source.publisher_lender) {
+            return -ENOTSUP;
+        }
+        first = !startup_source.acquisition_attempted ?
+            qemu_plugin_crucible_startup_source_acquire_v1(id, borrowed.descriptors[2]) :
+            startup_active(id);
+        if (first) {
+            return first;
+        }
+        if (startup_source.saved.ctx != startup_source.current.ctx ||
+            startup_source.saved.module != startup_source.current.module ||
+            startup_source.saved.install != startup_source.current.install ||
+            startup_source.purpose_plan_fd != borrowed.descriptors[2]) {
+            return -EPERM;
+        }
+        if (service->attempted) {
+            return -EALREADY;
+        }
+        *service = (QemuCruciblePublisherModuleService) {
+            .canonical_owner = service,
+            .creation_owner = service,
+            .holder = &service->creation_owner,
+            .lender = startup_source.publisher_lender,
+            .installer = startup_source.saved,
+            .process = getpid(),
+            .thread = native_metadata_thread_id(),
+            .process_generation = startup_source.original.process_generation,
+            .attempted = true,
+            .held = true,
+        };
+    }
+    first = startup_setup_service_identity(id);
+    if (first || service->transition_active || service->closing) {
+        return first ? first : -EBUSY;
+    }
+    service->transition_active = true;
+    first = begin ? qemu_crucible_preexec_publisher_module_borrow_v1(
+        service->lender, service, out, bytes, &service->view) :
+        qemu_crucible_preexec_publisher_module_current_v1(
+            service->lender, service, out, bytes, &service->view);
+    /* This independent cut does not consult Source's sticky first failure.
+     * No callback or Original observation executes under a registry mutex. */
+    post = qemu_crucible_preexec_purpose_check_v3(startup_source.preexec_purpose_owner);
+    identity = startup_setup_service_identity(id);
+    service->transition_active = false;
+    if (begin) {
+        service->first_status = first;
+        service->post_status = post;
+    } else {
+        service->current_first_status = first;
+        service->current_post_status = post;
+    }
+    first = service->first_status ? service->first_status :
+        service->post_status ? service->post_status :
+        first ? first : post ? post : identity;
+    if (first) {
+        return startup_failure(first);
+    }
+    view = (struct qemu_plugin_crucible_setup_borrow_v4) {
+        .schema_version = 4,
+        .struct_size = sizeof(view),
+        .control_fd = QEMU_CRUCIBLE_PREEXEC_SETUP_CONTROL_FD,
+        .frame = service->view.frame,
+        .frame_bytes = service->view.frame_bytes,
+        .base_descriptors = service->view.base_descriptors,
+        .base_descriptor_count = service->view.base_descriptor_count,
+        .publisher_descriptors = {
+            service->view.publisher_descriptors[0],
+            service->view.publisher_descriptors[1],
+            service->view.publisher_descriptors[2],
+        },
+    };
+    *out = view;
+    return 0;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_startup_setup_borrow_v4(qemu_plugin_id_t id,
+    uint32_t version, size_t bytes, struct qemu_plugin_crucible_setup_borrow_v4 *out)
+{
+    return startup_setup_service_view(id, version, bytes, out, true);
+}
+
+int qemu_plugin_crucible_startup_setup_current_v4(qemu_plugin_id_t id,
+    uint32_t version, size_t bytes, struct qemu_plugin_crucible_setup_borrow_v4 *out)
+{
+    return startup_setup_service_view(id, version, bytes, out, false);
+}
