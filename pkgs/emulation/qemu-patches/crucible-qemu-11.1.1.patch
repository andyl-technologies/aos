+static void native_physical_checks(void)
+{
+    QemuCrucibleSourceControlBinding component = { 0 };
+    QemuCrucibleSourceControlBinding *holder = &component;
+    QemuCruciblePublisherServiceReturnFrame *frame =
+        &fingerprint_control_component.service_return;
