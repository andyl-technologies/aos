+static void test_hot_fork_snapshot_binding_case(bool writable_file)
+{
+    char snapshot_path[] = "/tmp/qemu-hot-fork-snapshot-XXXXXX";
+    char overlay_path[] = "/tmp/qemu-hot-fork-overlay-XXXXXX";
+    QemuBlockBackendHotForkInventory backends;
+    QemuBlockBackendHotForkSnapshotBinding binding = { 0 };
+    QemuBlockBackendHotForkBarrierInventory barrier;
+    QDict *options;
+    BlockBackend *blk;
+    int snapshot_fd;
+    int overlay_fd;
+    size_t index;
+    QemuBlockBackendHotForkReadOnlySource *source;
+    Error *local_err = NULL;
+    uint64_t permissions, shared_permissions;
+    uint64_t original_permissions, original_shared;
+    uint8_t written[512], observed[512];
+
+    options = qdict_new();
+    snapshot_fd = mkstemp(snapshot_path);
+    overlay_fd = mkstemp(overlay_path);
+    g_assert_cmpint(snapshot_fd, >=, 0);
+    g_assert_cmpint(overlay_fd, >=, 0);
+    close(snapshot_fd);
+    close(overlay_fd);
+    bdrv_img_create(snapshot_path, "qcow2", NULL, NULL, NULL,
+                    HOT_FORK_SNAPSHOT_SIZE,
+                    BDRV_O_RDWR, true, &error_abort);
+    bdrv_img_create(overlay_path, "qcow2", NULL, NULL, NULL,
+                    HOT_FORK_SNAPSHOT_SIZE,
+                    BDRV_O_RDWR, true, &error_abort);
+
+    qdict_put_str(options, "driver", "qcow2");
+    qdict_put_str(options, "node-name", "crucible-overlay0");
+    qdict_put_str(options, "file.driver", "file");
+    qdict_put_str(options, "file.filename", overlay_path);
+    if (writable_file) {
+        qdict_put_bool(options, "file.read-only", false);
+    }
+    qdict_put_str(options, "backing.driver", "qcow2");
+    qdict_put_str(options, "backing.node-name", "crucible-snapshot0");
+    qdict_put_bool(options, "backing.read-only", true);
+    qdict_put_str(options, "backing.file.driver", "file");
+    qdict_put_str(options, "backing.file.filename", snapshot_path);
+    blk = blk_new_open(NULL, NULL, options, BDRV_O_RDWR, &error_abort);
+    g_assert_nonnull(blk);
+    g_assert_true(monitor_add_blk(blk, "crucible-root0", &error_abort));
+
+    qemu_block_backend_hot_fork_inventory(&backends);
+    for (index = 0; index < backends.entry_count; index++) {
+        if (strcmp(backends.entries[index].name, "crucible-root0") == 0) {
+            binding.backend_id = backends.entries[index].backend_id;
+            break;
+        }
+    }
+    g_assert_cmpuint(binding.backend_id, >, 0);
+    qemu_block_backend_hot_fork_inventory_destroy(&backends);
+    g_strlcpy(binding.backend_name, "crucible-root0",
+              sizeof(binding.backend_name));
+    g_strlcpy(binding.overlay_node_name, "crucible-overlay0",
+              sizeof(binding.overlay_node_name));
+    g_strlcpy(binding.snapshot_node_name, "crucible-snapshot0",
+              sizeof(binding.snapshot_node_name));
+    memset(binding.snapshot_content_id, 'a',
+           QEMU_BLOCK_BACKEND_HOT_FORK_CONTENT_ID_HEX_LENGTH);
+    binding.snapshot_content_id[
+        QEMU_BLOCK_BACKEND_HOT_FORK_CONTENT_ID_HEX_LENGTH] = '\0';
+
+    g_assert_true(qemu_block_backend_hot_fork_barrier(
+        QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_HOLD, &barrier));
+    qemu_block_backend_hot_fork_barrier_inventory_destroy(&barrier);
+    g_assert_true(qemu_block_backend_hot_fork_snapshot_bind(
+        &binding, 1, &barrier, &error_abort));
+    g_assert_true(barrier.snapshot_bound);
+    g_assert_true(barrier.snapshot_complete);
+    g_assert_cmpuint(barrier.snapshot_root_count, ==, 1);
+    g_assert_cmpuint(barrier.snapshot_roots[0].binding.backend_id,
+                     ==, binding.backend_id);
+    g_assert_cmpstr(barrier.snapshot_roots[0].binding.snapshot_content_id,
+                    ==, binding.snapshot_content_id);
+    g_assert_cmpuint(barrier.snapshot_roots[0].virtual_size, ==,
+                     HOT_FORK_SNAPSHOT_SIZE);
+    g_assert_true(barrier.snapshot_roots[0].overlay_empty);
+    g_assert_true(barrier.snapshot_roots[0].snapshot_read_only);
+    qemu_block_backend_hot_fork_barrier_inventory_destroy(&barrier);
+
+    source = qemu_block_backend_hot_fork_read_only_source_new(blk, &error_abort);
+    g_assert_nonnull(source);
+    g_assert_false(qemu_block_backend_hot_fork_read_only_source_freeze(
+        source, &local_err));
+    g_assert_nonnull(local_err);
+    error_free(local_err);
+    local_err = NULL;
+    g_assert_false(qemu_block_backend_hot_fork_read_only_source_is_frozen(source));
+
+    g_assert_true(qemu_block_backend_hot_fork_barrier(
+        QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_RELEASE, &barrier));
+    g_assert_false(barrier.snapshot_bound);
+    g_assert_false(barrier.snapshot_complete);
+    g_assert_cmpuint(barrier.snapshot_root_count, ==, 0);
+    qemu_block_backend_hot_fork_barrier_inventory_destroy(&barrier);
+
+    if (!writable_file) {
+        test_hot_fork_frozen_snapshot_binding(blk, &binding);
+    }
+    memset(written, 0x37, sizeof(written));
+    g_assert_cmpint(blk_pwrite(blk, 0, sizeof(written), written, 0), ==, 0);
+    blk_get_perm(blk, &original_permissions, &original_shared);
+    {
+        BlockBackend *other = blk_new(qemu_get_aio_context(),
+                                       BLK_PERM_CONSISTENT_READ, BLK_PERM_ALL);
+
+        g_assert_cmpint(blk_insert_bs(other, blk_bs(blk), &error_abort), ==, 0);
+        g_assert_false(qemu_block_backend_hot_fork_read_only_source_freeze(
+            source, NULL));
+        blk_unref(other);
+    }
+    if (writable_file) {
+        g_assert_false(qemu_block_backend_hot_fork_read_only_source_freeze(
+            source, &local_err));
+        g_assert_nonnull(local_err);
+        g_assert_nonnull(strstr(error_get_pretty(local_err), "writable node"));
+        error_free(local_err);
+        local_err = NULL;
+        g_assert_true(bdrv_is_read_only(blk_bs(blk)));
+        g_assert_false(bdrv_is_read_only(blk_bs(blk)->file->bs));
+        g_assert_false(qemu_block_backend_hot_fork_read_only_source_is_frozen(
+            source));
+        goto restore;
+    }
+    g_assert_true(qemu_block_backend_hot_fork_read_only_source_freeze(
+        source, &error_abort));
+    g_assert_true(qemu_block_backend_hot_fork_read_only_source_is_frozen(source));
+    g_assert_true(bdrv_is_read_only(blk_bs(blk)));
+    g_assert_true(qemu_block_backend_hot_fork_read_only_source_freeze(
+        source, &error_abort));
+    blk_get_perm(blk, &permissions, &shared_permissions);
+    g_assert_cmpuint(permissions &
+        (BLK_PERM_WRITE | BLK_PERM_WRITE_UNCHANGED | BLK_PERM_RESIZE), ==, 0);
+    g_assert_cmpint(blk_pread(blk, 0, sizeof(observed), observed, 0), ==, 0);
+    g_assert_cmpmem(written, sizeof(written), observed, sizeof(observed));
+
+    g_assert_false(qemu_block_backend_hot_fork_read_only_source_free(
+        source, &local_err));
+    g_assert_nonnull(local_err);
+    error_free(local_err);
+    local_err = NULL;
+#ifdef CONFIG_LINUX
+    {
+        pid_t child = fork();
+        int status;
+
+        g_assert_cmpint(child, >=, 0);
+        if (child == 0) {
+            /* An inherited token must not reopen its parent's disk writable. */
+            bool rejected =
+                !qemu_block_backend_hot_fork_read_only_source_restore(source, NULL) &&
+                !qemu_block_backend_hot_fork_read_only_source_free(source, NULL);
+
+            _exit(rejected ? 0 : 1);
+        }
+        g_assert_cmpint(waitpid(child, &status, 0), ==, child);
+        g_assert_true(WIFEXITED(status));
+        g_assert_cmpint(WEXITSTATUS(status), ==, 0);
+    }
+#endif
+restore:
+    g_assert_true(qemu_block_backend_hot_fork_read_only_source_restore(
+        source, &error_abort));
+    g_assert_true(qemu_block_backend_hot_fork_read_only_source_restore(
+        source, &error_abort));
+    g_assert_false(qemu_block_backend_hot_fork_read_only_source_is_frozen(source));
+    g_assert_false(bdrv_is_read_only(blk_bs(blk)));
+    g_assert_true(bdrv_is_read_only(bdrv_cow_bs(blk_bs(blk))));
+    blk_get_perm(blk, &permissions, &shared_permissions);
+    g_assert_cmpuint(permissions, ==, original_permissions);
+    g_assert_cmpuint(shared_permissions, ==, original_shared);
+    g_assert_cmpint(blk_pwrite(blk, sizeof(written), sizeof(written), written, 0),
+                    ==, 0);
+    g_assert_true(qemu_block_backend_hot_fork_read_only_source_free(
+        source, &error_abort));
+
+    monitor_remove_blk(blk);
+    blk_unref(blk);
+    unlink(overlay_path);
+    unlink(snapshot_path);
+}
