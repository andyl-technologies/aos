+#endif
+}
+
+int qemu_crucible_startup_source_callback_registration_return_v1(
+    QemuCrucibleCallbackRegistrationBorrow **projection, uint64_t serial)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    QemuCrucibleCallbackRegistrationBorrow *borrow = &startup_source.callbacks.registrar;
+    qemu_plugin_id_t id;
+    int status = callback_registry_identity(&id);
+
+    if (status || !projection || !serial) {
+        return status ? status : -EINVAL;
+    }
+    qemu_mutex_lock(&commands->mutex);
+    if (callback_child_output_conflicts_locked(projection, sizeof(*projection))) {
+        status = -EINVAL;
+    } else {
+        status = callback_registrar_identity_locked(borrow, serial);
+    }
+    if (!status && (*projection != borrow || !borrow->owner->child->publication_users)) {
+        status = -EPERM;
+    }
+    if (!status) {
+        borrow->owner->child->publication_users--;
+        borrow->held = false;
+        borrow->canonical_owner = NULL;
+        *projection = NULL;
+    }
+    qemu_mutex_unlock(&commands->mutex);
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_crucible_startup_source_callback_child_owner_current_v1(
+    QemuCrucibleCallbackChildOwner *owner)
+{
+#ifdef CONFIG_LINUX
