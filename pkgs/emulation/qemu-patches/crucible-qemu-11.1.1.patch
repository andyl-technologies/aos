+#ifdef CONFIG_LINUX
+static void parent_park_terminal_encode(QemuCrucibleParentParkReceive *owner,
+                                       uint8_t wire[QEMU_CRUCIBLE_PARK_RETURN_BYTES])
+{
+    const QemuCrucibleParkBinding *binding = &owner->binding;
+
+    memset(wire, 0, QEMU_CRUCIBLE_PARK_RETURN_BYTES);
+    memcpy(wire, QEMU_CRUCIBLE_PARK_RETURN_MAGIC, 8);
+    stl_be_p(wire + 8, QEMU_CRUCIBLE_PARK_RETURN_SCHEMA);
+    stl_be_p(wire + 12, QEMU_CRUCIBLE_PARK_RETURN_BYTES);
+    memcpy(wire + 16, binding->source_capability, 32);
+    memcpy(wire + 48, binding->source_reservation, 32);
+    stq_be_p(wire + 80, binding->account_incarnation);
+    stq_be_p(wire + 88, binding->process_incarnation);
+    stq_be_p(wire + 96, binding->request_correlation);
+    stq_be_p(wire + 104, binding->command_frontier);
+    stq_be_p(wire + 112, binding->loan_sequence);
+    stl_be_p(wire + 120, (uint32_t)owner->first_status);
+    stl_be_p(wire + 124, (uint32_t)owner->post_status);
+    stl_be_p(wire + 128, QEMU_CRUCIBLE_PARK_RETURN_RETURNED);
+    stl_be_p(wire + 132, QEMU_CRUCIBLE_PARK_RETURN_ALL);
+    stl_be_p(wire + 136, owner->initial_publication.planned_count);
+    stl_be_p(wire + 140, owner->validated ? owner->initial_publication.born_mask : 0);
+    stl_be_p(wire + 144, owner->final_original_post[0]);
+    stl_be_p(wire + 148, owner->final_original_post[1]);
+    stl_be_p(wire + 152, owner->terminal_operation_status);
+    stl_be_p(wire + 156, owner->terminal_physical_status);
+    stq_be_p(wire + 160, owner->stopped_generation);
+    stq_be_p(wire + 168, owner->terminal_native_generation);
+}
