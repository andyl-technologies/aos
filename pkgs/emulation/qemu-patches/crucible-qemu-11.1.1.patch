diff --git a/hw/isa/lpc-ich9-fingerprint.h b/hw/isa/lpc-ich9-fingerprint.h
new file mode 100644
index 0000000000000000000000000000000000000000..0c639db285ea1abe452231a60f07a22ca18874de
--- /dev/null
+++ b/hw/isa/lpc-ich9-fingerprint.h
@@ -0,0 +1,118 @@
+/*
+ * ICH9 LPC fingerprint projection internals
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef HW_ISA_LPC_ICH9_FINGERPRINT_H
+#define HW_ISA_LPC_ICH9_FINGERPRINT_H
+
+#include "hw/acpi/ich9.h"
+#include "migration/qemu-file.h"
+#include "qapi/error.h"
+
+static inline void ich9_crucible_clock_fingerprint_projection(
+    QEMUFile *f, const ACPIPMTimer *timer)
+{
+    bool present = timer->crucible_timer_arm_sequence != 0;
+
+    qemu_put_byte(f, present);
+    if (present) {
+        qemu_put_be64(f, timer->crucible_guest_deadline_ps);
+        qemu_put_be64(f, timer->crucible_transform_generation);
+        qemu_put_be64(f, timer->crucible_timer_arm_sequence);
+    }
+}
+
+static inline bool ich9_hotplug_fingerprint_validate(
+    const ICH9LPCPMRegs *pm, Error **errp)
+{
+    if (pm->cpuhp_state.dev_count > 4096 ||
+        (pm->cpuhp_state.dev_count != 0 && !pm->cpuhp_state.devs) ||
+        pm->acpi_memory_hotplug.dev_count > ACPI_MAX_RAM_SLOTS ||
+        (pm->acpi_memory_hotplug.dev_count != 0 &&
+         !pm->acpi_memory_hotplug.devs)) {
+        error_setg(errp, "ICH9 LPC fingerprint has invalid hotplug geometry");
+        return false;
+    }
+
+    for (uint32_t i = 0; i < pm->cpuhp_state.dev_count; i++) {
+        const AcpiCpuStatus *status = &pm->cpuhp_state.devs[i];
+
+        if (status->fw_remove) {
+            error_setg(errp,
+                       "ICH9 LPC cannot restore a pending firmware CPU "
+                       "removal");
+            return false;
+        }
+    }
+
+    for (uint32_t i = 0; i < pm->acpi_memory_hotplug.dev_count; i++) {
+        const MemStatus *status = &pm->acpi_memory_hotplug.devs[i];
+
+        if (status->is_removing) {
+            error_setg(errp,
+                       "ICH9 LPC cannot restore a pending memory removal");
+            return false;
