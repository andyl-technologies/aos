+CruciblePausedCpu *qmp_query_crucible_paused_cpu(
+    uint32_t vcpu_index, bool has_expected_generation,
+    uint64_t expected_generation, Error **errp)
+{
+    CruciblePausedCpu *observation;
+    CPUState *cpu;
+    CPUClass *klass;
+    uint64_t generation;
+    int64_t absolute_icount;
+
+    if (!bql_locked() || !current_accel_name() ||
+        strcmp(current_accel_name(), "sim") != 0 ||
+        !runstate_check(RUN_STATE_PAUSED) ||
+        !qemu_plugin_crucible_vmstop_quiesced()) {
+        error_setg(errp, "Paused CPU observation requires an admitted paused SIM boundary");
+        return NULL;
+    }
+    generation = qemu_plugin_crucible_vmstop_generation();
+    if (!generation || generation == UINT64_MAX ||
+        (has_expected_generation && expected_generation != generation)) {
+        error_setg(errp, "Paused CPU observation generation is stale or exhausted");
+        return NULL;
+    }
+    cpu = vcpu_index <= INT_MAX ? qemu_get_cpu(vcpu_index) : NULL;
+    if (!cpu || !cpu->stopped || !(klass = CPU_GET_CLASS(cpu))->get_pc) {
+        error_setg(errp, "Paused CPU observation requires a stopped realized CPU");
+        return NULL;
+    }
+    absolute_icount = icount_get_raw();
+    if (absolute_icount < 0) {
+        error_setg(errp, "Paused CPU observation instruction count is invalid");
+        return NULL;
+    }
+
+    /* BQL and settled VM-stop retain the CPU while scalar registers are read.
+     * No RAM, output flush, modeled clock, or guest execution is involved. */
+    observation = g_new0(CruciblePausedCpu, 1);
+    observation->schema_version = 1;
+    observation->scope = 1;
+    observation->generation = generation;
+    observation->vcpu_index = vcpu_index;
+    observation->pc = klass->get_pc(cpu);
+    observation->absolute_icount = absolute_icount;
+    return observation;
+}
