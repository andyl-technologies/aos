+static void initialize_rtc(MC146818RtcState *state, bool exact)
+{
+    const TypeInfo fixture_type = {
+        .name = "rtc-calendar-fixture",
+        .parent = TYPE_OBJECT,
+        .instance_size = sizeof(*state),
+    };
+    struct tm date = { .tm_year = 70, .tm_mon = 0, .tm_mday = 1 };
+    Error *error = NULL;
+
+    module_call_init(MODULE_INIT_QOM);
+    qemu_init_main_loop(&error);
+    g_assert_null(error);
+    if (exact) {
+        qemu_timer_enable_tcg_ps_clock(NULL, observed_clock_ps);
+    }
+    qemu_clock_enable(rtc_clock, true);
+    type_register_static(&fixture_type);
+    object_initialize(state, sizeof(*state), fixture_type.name);
+    state->cmos_data[RTC_REG_A] = 0x20;
+    state->cmos_data[RTC_REG_B] = REG_B_DM | REG_B_24H;
+    rtc_set_cmos(state, &date);
+    rtc_set_time(state);
+    state->update_timer = timer_new_ns(rtc_clock, rtc_update_timer, state);
+    check_update_timer(state);
+}
