+CPUState *icount_crucible_rr_select_cpu(CPUState *suggested)
+{
+    CPUState *selected;
+    CPUState *runnable;
+    uint64_t source_retired_delta;
+
+    if (!suggested || icount_crucible_rr_switch_quantum() == 0) {
+        return suggested;
+    }
+    if (timers_state.crucible_rr_cursor_valid) {
+        selected = qemu_get_cpu(timers_state.crucible_rr_current_vcpu);
+        g_assert(selected);
+        /*
+         * The serialized owner remains authoritative across partial RR turns.
+         * The loop-local iterator can restart after host control service; it
+         * must not reset a live cursor merely because it suggests another
+         * CPU. A guest halt is a canonical partial-turn handoff.
+         */
+        if ((timers_state.crucible_rr_selection_pending ||
+             selected != suggested) &&
+            (!cpu_can_run(selected) ||
+             (selected->halted && !cpu_has_work(selected))) &&
+            (runnable = icount_crucible_rr_next_runnable(selected))) {
+            source_retired_delta =
+                timers_state.crucible_rr_cursor_position;
+            timers_state.crucible_rr_current_vcpu = runnable->cpu_index;
+            timers_state.crucible_rr_cursor_position = 0;
+            timers_state.crucible_rr_selection_pending = false;
+            qemu_plugin_fire_rr_handoff_cb(selected->cpu_index,
+                                           runnable->cpu_index,
+                                           icount_crucible_rr_switch_quantum(),
+                                           source_retired_delta);
+            return runnable;
+        }
+        if (timers_state.crucible_rr_selection_pending ||
+            selected != suggested) {
+            return selected;
+        }
+        return suggested;
+    }
+
+    timers_state.crucible_rr_current_vcpu = suggested->cpu_index;
+    timers_state.crucible_rr_cursor_position = 0;
+    timers_state.crucible_rr_cursor_valid = true;
+    return suggested;
