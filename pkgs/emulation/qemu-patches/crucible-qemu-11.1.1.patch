+/* Registry lookup precedes fields of any caller-provided owner. Native free
+ * recording is callback-free; only this Source bridge retires its header. */
+static QemuCrucibleCpuSourceAllocationOwner *cpu_allocation_find_locked(
+    const QemuCrucibleCpuSourceAllocationOwner *candidate)
+{
+    QemuCrucibleCpuSourceAllocationOwner *owner;
+
+    for (owner = startup_source.cpu_allocations.owners; owner;
+         owner = owner->next) {
+        if (owner == candidate) {
+            return owner;
+        }
+    }
+    return NULL;
+}
+
+static int cpu_allocation_identity_locked(
+    QemuCrucibleCpuSourceAllocationOwner *candidate)
+{
+    QemuCrucibleCpuSourceAllocationOwner *owner =
+        cpu_allocation_find_locked(candidate);
+    size_t receipt_bytes = qemu_crucible_cpu_allocation_receipt_bytes_v1();
+    size_t receipt_alignment = qemu_crucible_cpu_allocation_receipt_alignment_v1();
+
+    if (!owner || owner->process != getpid() || !owner->charge.held ||
+        owner->partition != &startup_source.metadata_partition ||
+        owner->binding != &startup_source.standing.construction ||
+        !owner->request_serial || !owner->payload_bytes ||
+        !owner->payload_alignment ||
+        (owner->payload_alignment & (owner->payload_alignment - 1)) ||
+        !receipt_bytes || !receipt_alignment ||
+        (receipt_alignment & (receipt_alignment - 1)) ||
+        receipt_alignment - 1 > SIZE_MAX - sizeof(*owner) ||
+        receipt_bytes > SIZE_MAX - sizeof(*owner) - (receipt_alignment - 1) ||
+        owner->storage_bytes != sizeof(*owner) + receipt_alignment - 1 + receipt_bytes ||
+        owner->receipt_offset !=
+            ((((uintptr_t)(owner + 1) + receipt_alignment - 1) &
+              ~(uintptr_t)(receipt_alignment - 1)) - (uintptr_t)owner) ||
+        (owner->receipt && (uint8_t *)owner->receipt !=
+            (uint8_t *)owner + owner->receipt_offset) ||
+        owner->receipt_offset < sizeof(*owner) ||
+        owner->receipt_offset > owner->storage_bytes ||
+        receipt_bytes > owner->storage_bytes - owner->receipt_offset ||
+        owner->storage_bytes > UINT64_MAX - owner->payload_bytes ||
+        owner->charge.bytes != owner->storage_bytes + owner->payload_bytes) {
+        return -ESTALE;
+    }
+    return qemu_crucible_startup_source_observation_construction_identity_v1(
+        owner->binding);
+}
+
+/* This fixed journal is paid as part of Source before any header birth. It
+ * holds only a proven failed header allocation or a genuinely freed header;
+ * neither a null QOM payload nor semantic failure can populate it. */
+static int cpu_allocation_pending_retire_locked(void)
+{
+    if (!startup_source.cpu_allocations.pending_charge.held) {
+        return 0;
+    }
+    if (!startup_source.cpu_allocations.pending_physical_return) {
+        return -EBUSY;
+    }
+    int status = crucible_metadata_native_retire(
+        &startup_source.metadata_partition,
+        &startup_source.cpu_allocations.pending_charge);
+
+    if (!startup_source.cpu_allocations.pending_charge.held) {
+        startup_source.cpu_allocations.pending_physical_return = false;
+    }
+    return status;
+}
