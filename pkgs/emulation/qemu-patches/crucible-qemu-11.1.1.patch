+int qemu_plugin_crucible_startup_setup_borrow_v3(
+    qemu_plugin_id_t id, struct qemu_plugin_crucible_setup_borrow_v3 *out)
+{
+#if defined(CONFIG_LINUX) && defined(__x86_64__) && !defined(__ILP32__)
+    QemuCruciblePreexecSourceBorrow borrowed;
+    struct qemu_plugin_crucible_setup_borrow_v3 view;
+    int status;
+
+    if (!startup_invocation(id)) {
+        return -EPERM;
+    }
+    if (!out) {
+        return -EINVAL;
+    }
+    if (!qatomic_load_acquire(&startup_source.process_purpose_complete)) {
+        return startup_failure(-ENOKEY);
+    }
+    status = qemu_crucible_preexec_purpose_borrow_v3(
+        startup_source.preexec_purpose_owner, &borrowed);
+    if (status) {
+        return startup_failure(status);
+    }
+    /* The old module ABI exposes exactly Setup5/61 bytes. A physical Source
+     * session tail cannot relabel Setup6 or its consumed alias roster as that
+     * legacy parser input. A matched module borrower remains required. */
+    if (borrowed.plan->schema != 8) {
+        return startup_failure(-ENOTSUP);
+    }
+    if (!startup_source.acquisition_attempted) {
+        status = qemu_plugin_crucible_startup_source_acquire_v1(
+            id, borrowed.descriptors[2]);
+    } else {
+        status = startup_active(id);
+    }
+    if (status) {
+        return status;
+    }
+    if (startup_source.saved.ctx != startup_source.current.ctx ||
+        startup_source.saved.module != startup_source.current.module ||
+        startup_source.saved.install != startup_source.current.install ||
+        startup_source.purpose_plan_fd != borrowed.descriptors[2]) {
+        return startup_failure(-EPERM);
+    }
+    status = startup_process_purpose_live();
+    if (status) {
+        return status;
+    }
+    view = (struct qemu_plugin_crucible_setup_borrow_v3) {
+        .schema_version = 3,
+        .struct_size = sizeof(view),
+        .control_fd = QEMU_CRUCIBLE_PREEXEC_SETUP_CONTROL_FD,
+        .reserved = 0,
+        .frame = borrowed.frame,
+        .frame_bytes = QEMU_CRUCIBLE_PREEXEC_SETUP_FRAME_BYTES,
+        .descriptors = borrowed.descriptors,
+        .descriptor_count = borrowed.descriptor_count,
+    };
+    *out = view;
+    return 0;
+#else
+    return -ENOTSUP;
+#endif
+}
