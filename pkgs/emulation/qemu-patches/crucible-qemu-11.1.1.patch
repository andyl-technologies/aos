+    if (ram_read_resize_registry.writers) {
+        status = -EBUSY;
+        goto out;
+    }
+    if (!custody->reference_acquired || !custody->region_reference_acquired ||
+        !custody->region || OBJECT(custody->region) != custody->region_object ||
+        custody->region->owner != custody->owner ||
+        !block || block->mr != custody->region ||
+        custody->region->ram_block != block || !custody->length ||
+        custody->region_offset >= block->used_length ||
+        custody->length > block->used_length - custody->region_offset) {
+        status = -ESTALE;
+        goto out;
+    }
