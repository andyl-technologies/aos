+/* Fixed provisional storage is a request inside the same issued local share,
+ * before any metadata/artifact FD or copy birth. It is not an independent
+ * issuer or a replacement for the complete retained carrier validation.
+ * The seven roles are protected even before the installer consumes its holder.
+ */
+static int preexec_setup_provisional_native(uint64_t bytes)
+{
+    QemuCruciblePreexecSetupOwner *owner = &preexec_setup_owner;
+    uint64_t protected = owner->plan.purpose.incarnation_guest;
+    uint64_t available;
+
+    if (!owner->plan_validated || !owner->peer_validated) {
+        return -EPERM;
+    }
+    {
+        uint64_t source = qemu_crucible_startup_source_fixed_control_extent();
+
+        if (source > UINT64_MAX - protected) {
+            return -EOVERFLOW;
+        }
+        protected += source;
+    }
+    for (size_t index = 0; index < 7; index++) {
+        uint64_t extent = owner->plan.purpose.requests[index].extent;
+
+        if (extent > UINT64_MAX - protected) {
+            return -EOVERFLOW;
+        }
+        protected += extent;
+    }
+    if (owner->plan.workspace_bytes) {
+        uint64_t workspace = owner->plan.workspace.allocation_extent;
+
+        if (workspace > UINT64_MAX - protected) {
+            return -EOVERFLOW;
+        }
+        protected += workspace;
+    }
+    if (protected > owner->plan.purpose.local_extent) {
+        return -ENOSPC;
+    }
+    available = owner->plan.purpose.local_extent - protected;
+    if (owner->provisional_native_extent > available ||
+        bytes > available - owner->provisional_native_extent) {
+        return -ENOSPC;
+    }
+    owner->provisional_native_extent += bytes;
+    if (owner->plan.workspace_bytes) {
+        /* This actual debit protected the disjoint compulsory backing before
+         * any native request; only its constructor can consume that role. */
+        owner->workspace_backing_protected = true;
+    }
+    return 0;
+}
