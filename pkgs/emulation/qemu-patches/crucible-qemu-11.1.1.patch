+static void wait_for_registry_preflight_ready(void)
+{
+    QemuThreadHotForkRegistryTransaction transaction = { 0 };
+    int status = -EBUSY;
+
+    /*
+     * The process-lifetime RCU thread may finish registering after the
+     * monitor worker has sent its ready byte. Prove the unmodified registry
+     * is forkable before a test deliberately corrupts its mutex inventory.
+     */
+    for (unsigned int attempt = 0; attempt < 1000; attempt++) {
+        status = qemu_thread_hot_fork_begin_registry_transaction(&transaction);
+        if (status == 0) {
+            g_assert_cmpint(qemu_thread_hot_fork_release_parent_registry_transaction(
+                                &transaction), ==, 0);
+            return;
+        }
+        g_assert_cmpint(status, ==, -EBUSY);
+        g_usleep(1000);
+    }
+    g_error("registry did not become forkable: %s",
+            qemu_thread_hot_fork_registry_transaction_blocker());
+}
+
+static void assert_mutex_registry_preflight_stays_blocked(void)
+{
+    QemuThreadHotForkRegistryTransaction transaction = { 0 };
+    const char *blocker;
+
+    g_assert_cmpint(qemu_thread_hot_fork_begin_registry_transaction(
+                        &transaction),
+                    ==, -EBUSY);
+    g_assert_false(transaction.active);
+    blocker = qemu_thread_hot_fork_registry_transaction_blocker();
+    g_assert_nonnull(blocker);
+    g_assert_cmpstr(blocker, ==,
+                    "registered mutex inventory is incomplete or inconsistent");
+
+    g_assert_cmpint(qemu_thread_hot_fork_begin_registry_transaction(
+                        &transaction),
+                    ==, -EBUSY);
+    g_assert_false(transaction.active);
+}
