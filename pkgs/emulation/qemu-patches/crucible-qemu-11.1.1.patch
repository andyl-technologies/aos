+        bios,
+        time_advance_target=target,
+        rr_switch_quantum=RR_SWITCH_QUANTUM,
+        x86_smp=(f"{TIME_ADVANCE_VCPU_COUNT},"
+                  f"maxcpus={TIME_ADVANCE_VCPU_COUNT}"),
+    )
+    try:
+        expected_initialization = [
+            ("work", vcpu_index)
+            for vcpu_index in range(TIME_ADVANCE_VCPU_COUNT)
+        ]
+        events = [
+            live.marker()
+            for _ in range(TIME_ADVANCE_VCPU_COUNT + 2)
+        ]
+        if events[:-1] != [
+            *expected_initialization,
+            ("advance", (0, target)),
+        ]:
+            raise AssertionError(
+                f"unexpected time-advance completion order: {events!r}"
+            )
+        if events[-1][0] != "park":
+            raise AssertionError(
+                "time advance did not re-enter the idle callback directly: "
+                f"{events!r}"
+            )
+    finally:
+        live.close()
+    timer_owners = GLOBAL_VIRTUAL_TIMER_TRACE.findall(
+        live.shutdown_stderr_tail
+    )
+    if not timer_owners or set(timer_owners) != {b"rr"}:
+        raise AssertionError(
+            "time advance did not service every global virtual timer on RR: "
+            f"owners={timer_owners!r}"
+        )
+    request_records = tuple(
+        (
+            int(rr_owner),
+            int(rr_cursor),
+            int(cpu_count),
+            int(exit_mask, 16),
+        )
+        for rr_owner, rr_cursor, cpu_count, exit_mask
+        in TIME_ADVANCE_REQUEST_TRACE.findall(
+            live.shutdown_stderr_tail
+        )
+    )
+    if len(request_records) != 1 or any(
+        rr_owner >= cpu_count
+        or cpu_count != TIME_ADVANCE_VCPU_COUNT
+        or exit_mask >= 1 << cpu_count
+        for rr_owner, _rr_cursor, cpu_count, exit_mask in request_records
+    ):
+        raise AssertionError(
+            "time advance did not emit one valid observational request trace: "
+            f"records={request_records!r}"
+        )
+    completion_records = tuple(
+        (
+            int(rr_owner),
+            int(rr_cursor),
+            int(cpu_count),
+            int(exit_mask, 16),
+            int(state),
+        )
+        for (
+            rr_owner,
+            rr_cursor,
+            cpu_count,
+            exit_mask,
+            state,
+        ) in TIME_ADVANCE_COMPLETE_TRACE.findall(
+            live.shutdown_stderr_tail
+        )
+    )
+    request_owner, _request_cursor, _request_count, request_exit = (
+        request_records[0]
+    )
+    if len(completion_records) != 1 or any(
+        rr_owner >= cpu_count
+        or rr_cursor != 0
+        or cpu_count != TIME_ADVANCE_VCPU_COUNT
+        or request_owner != 1
+        or request_exit != 0xC
+        or rr_owner != 1
+        or exit_mask != 0
+        or exit_mask & ~request_exit != 0
+        or state != RR_TCG_EXEC_IDLE_WAKE_PENDING
+        for (
+            rr_owner,
+            rr_cursor,
+            cpu_count,
+            exit_mask,
+            state,
+        ) in completion_records
+    ):
+        raise AssertionError(
+            "time advance did not retire every completed-dispatch request "
+            "exit "
+            "before completion: "
+            f"request={request_records!r} complete={completion_records!r}"
+        )
+    return (
+        tuple(event for event, _value in events),
+        request_records,
+        completion_records,
+    )
+
