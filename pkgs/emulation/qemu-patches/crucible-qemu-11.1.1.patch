+int qemu_crucible_checkpoint_stop_intent_main_v1(
+    bool *selected, bool *already_stopped)
+{
+    struct QemuCrucibleCheckpointStopOwner *stop = &checkpoint_stop_owner;
+    QemuCrucibleCheckpointPagerBinding source;
+    MonitorQmpStopReservation *reservation = NULL;
+    Monitor *monitor;
+    void *purpose;
+    uint64_t process_generation;
+    int status;
+
+    if (!selected || !already_stopped) {
+        return -EINVAL;
+    }
+    *selected = false;
+    *already_stopped = false;
+    status = monitor_qmp_stop_reservation_take(&reservation);
+    if (status || !reservation) {
+        return status;
+    }
+    *selected = true;
+    status = qemu_crucible_checkpoint_storage_current_v1();
+    if (!status) {
+        status = monitor_qmp_stop_reservation_observe(
+            reservation, &monitor, &purpose, &process_generation);
+    }
+    if (!status) {
+        status = qemu_crucible_checkpoint_pager_binding_borrow(&source);
+    }
+    if (status) {
+        return status;
+    }
+    if (stop->intent_born) {
+        status = checkpoint_stop_receipt_current();
+        if (!status && (stop->reservation == reservation || stop->control_intent) &&
+            source.installer.ctx == stop->source.installer.ctx &&
+            source.installer.module == stop->source.installer.module &&
+            source.installer.plugin_id == stop->source.installer.plugin_id) {
+            *already_stopped = true;
+            return 0;
+        }
+        return status ? status : -ESTALE;
+    }
+    /* Genuine Source storage and the actual current Main dispatch borrower
+     * precede semantic intent publication and every VM stop admission effect.
+     * ARM/paused flags never issue this independent ordinary execution owner.
+     */
+    stop->process_id = getpid();
+    qemu_thread_get_self(&stop->admission_thread);
+    stop->source = source;
+    stop->reservation = reservation;
+    stop->ordinary_intent_owner = reservation;
+    stop->allocation_retained = true;
+    qatomic_store_release(&stop->intent_born, true);
+    return 0;
+}
