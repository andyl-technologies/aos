+int qemu_crucible_parent_park_prepared_identity_v1(QemuCrucibleParentParkLoan *loan)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleParentParkReceive *owner = &startup_source.parent_park_receive;
+    int status = parent_park_receive_identity(owner);
+
+    if (status || loan != &startup_source.parent_park_loan) {
+        return status ? status : -EPERM;
+    }
+    if (qatomic_load_acquire(&owner->busy) || owner->creating ||
+        loan->transition_busy || loan->callback_request ||
+        loan->callback_invocation || loan->callback || loan->callback_userdata) {
+        return -EBUSY;
+    }
+    return loan->issued && loan->held && loan->receive == owner &&
+        loan->process == getpid() && qemu_thread_is_self(&loan->thread) &&
+        owner->borrowers == 1 ? 0 : -ESTALE;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_crucible_parent_park_prepared_current_v1(
+    QemuCrucibleParentParkLoan *loan, uint64_t *remaining_ns)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleParentParkReceive *owner = &startup_source.parent_park_receive;
+    uint64_t slices[2];
+    int status = parent_park_main_identity(true);
+
+    if (status || parent_park_source_overlap(remaining_ns, sizeof(*remaining_ns))) {
+        return status ? status : -EINVAL;
+    }
+    status = qemu_crucible_parent_park_prepared_identity_v1(loan);
+    if (status) {
+        return status;
+    }
+    if (loan->first_status || owner->first_status || !owner->validated) {
+        return loan->first_status ? loan->first_status :
+            owner->first_status ? owner->first_status : -ENOKEY;
+    }
+    if (qatomic_cmpxchg(&owner->busy, false, true)) {
+        return -EBUSY;
+    }
+    owner->original_current[0] = parent_park_original_raw_current(owner, 0, &slices[0]);
+    owner->original_current[1] = parent_park_original_raw_current(owner, 1, &slices[1]);
+    status = owner->original_current[0] ? owner->original_current[0] :
+        owner->original_current[1];
+    if (status) {
+        parent_park_fail(owner, status, false);
+    } else {
+        *remaining_ns = MIN(slices[0], slices[1]);
+    }
+    qatomic_store_release(&owner->busy, false);
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_crucible_parent_park_prepared_borrow_v1(
+    QemuCrucibleParentParkReceive *receive, QemuCrucibleParentParkLoan **out)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleParentParkLoan *loan = &startup_source.parent_park_loan;
+    QemuCrucibleParentParkReceive *owner = &startup_source.parent_park_receive;
+    uint64_t unused;
+    int identity;
+    int status = parent_park_main_identity(true);
+
+    if (status || parent_park_source_overlap(out, sizeof(*out))) {
+        return status ? status : -EINVAL;
+    }
+    status = parent_park_receive_identity(receive);
+    if (status || *out) {
+        return status ? status : -EINVAL;
+    }
+    if (qatomic_cmpxchg(&owner->busy, false, true)) {
+        return -EBUSY;
+    }
+    if (owner->creating || loan->issued || owner->borrowers ||
+        !owner->validated || owner->first_status) {
+        status = owner->first_status ? owner->first_status : -EALREADY;
+        goto done;
+    }
+    owner->original_current[0] = parent_park_original_raw_current(owner, 0, &unused);
+    owner->original_current[1] = parent_park_original_raw_current(owner, 1, &unused);
+    status = owner->original_current[0] ? owner->original_current[0] :
+        owner->original_current[1];
+    if (status) {
+        parent_park_fail(owner, status, false);
+        goto done;
+    }
+    qemu_rec_mutex_lock(&plugin.lock);
+    if (plugin_id_to_ctx_locked(owner->installer.plugin_id) != owner->installer.ctx ||
+        owner->installer.ctx->uninstalling || owner->installer.ctx->resetting ||
+        owner->installer.ctx->handle != owner->installer.module) {
+        qemu_rec_mutex_unlock(&plugin.lock);
+        status = -ESTALE;
+        goto done;
+    }
+    plugin_ctx_callback_retain__locked(owner->installer.ctx);
+    loan->ctx_retained = true;
+    qemu_rec_mutex_unlock(&plugin.lock);
+
+    loan->transition_busy = true;
+    loan->receive = owner;
+    loan->process = getpid();
+    qemu_thread_get_self(&loan->thread);
+    loan->issued = true;
+    loan->held = true;
+    owner->borrowers++;
+    *out = loan;
+    status = parent_park_pair_raw_post(owner);
+    loan->first_status = status;
+    loan->post_status = status;
+    identity = parent_park_receive_identity(owner);
+
+    if (identity || loan->receive != owner || !loan->issued || !loan->held ||
+        owner->borrowers != 1) {
+        parent_park_fail(owner, identity ? identity : -ESTALE, true);
+        return owner->first_status;
+    }
+    loan->transition_busy = false;
+
+done:
+    qatomic_store_release(&owner->busy, false);
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
