index 0000000000000000000000000000000000000000..6f34ca580f6da97b12884c865560f8eeaf2d00c7
--- /dev/null
+++ b/tests/unit/test-crucible-pending-offer.py
@@ -0,0 +1,133 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Check literal local read facts and all-refusing independent post cuts.
+
+The local field checks supply no owner. Every post dependency refuses; no
+canonical Source, Runtime, Main, publisher session or Original is accepted.
+"""
+
+import argparse
+import json
+import os
+from pathlib import Path
+import resource
+import runpy
+import shlex
+import subprocess
+
+
+REFUSALS = r'''
+static unsigned native_calls, source_calls, session_calls, return_calls;
+static int pending_offer_native_current(QemuCrucibleSourcePendingOfferRead *read)
+{
+    native_calls++;
+    return -EPERM;
+}
+static int pending_offer_source_current(QemuCrucibleSourcePendingOfferRead *read)
+{
+    source_calls++;
+    return -ESTALE;
+}
+static int refuse_session(QemuCruciblePublisherSessionLender *lender,
+                          const void *out, size_t bytes)
+{
+    session_calls++;
+    return -ENOKEY;
+}
+static int refuse_return(QemuCrucibleSourcePendingOfferRead *read)
+{
+    return_calls++;
+    return -EBUSY;
+}
+'''
+
+CHECKS = r'''
+int main(void)
+{
+    QemuCrucibleSourcePendingOfferRead read = { .busy = true };
+
+    assert(pending_offer_read_returnable(&read));
+    read.observation.entered = true;
+    assert(!pending_offer_read_returnable(&read));
+    read.observation.read_returned = true;
+    assert(pending_offer_read_returnable(&read));
+    read.return_attempted = true;
+    assert(!pending_offer_read_returnable(&read));
+    read.return_attempted = false;
+    pending_offer_consume_read(&read);
+    assert(read.return_attempted && read.consumed && !read.busy);
+    assert(!pending_offer_read_returnable(&read));
+
+    read = (QemuCrucibleSourcePendingOfferRead) { .busy = true };
+    assert(pending_offer_post(&read, -EIO) == -EPERM);
+    assert(read.first_status == -EIO);
+    assert(read.native_post_status == -EPERM);
+    assert(read.source_post_status == -ESTALE);
+    assert(read.session_post_status == -ENOKEY);
+    assert(read.return_status == -EBUSY);
+    assert(native_calls == 1 && source_calls == 1 && session_calls == 1 && return_calls == 1);
+    assert(read.busy && !read.return_attempted && !read.consumed);
+    puts("PASS local read facts and all-refusing posts; no canonical owner accepted");
+    return 0;
+}
+'''
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("source", type=Path)
+    parser.add_argument("output", type=Path)
+    args = parser.parse_args()
+    source = args.source.resolve()
+    output = args.output.resolve()
+    output.mkdir(parents=True, exist_ok=True)
+    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
+    extract = runpy.run_path(str(source / "tests/unit/extract-crucible-startup-source-controls.py"))
+    production = (source / "plugins/crucible-pending-offer.inc.h").read_text()
+    body = "\n\n".join(extract["function"](production, prefix) for prefix in (
+        "static bool pending_offer_read_returnable(",
+        "static void pending_offer_consume_read(", "static int pending_offer_post("))
+    # No accepting replacement: all four dependencies return distinct failures.
+    body = body.replace("qemu_crucible_preexec_publisher_pending_output_v1(", "refuse_session(")
+    body = body.replace("pending_offer_return_read(read)", "refuse_return(read)")
+    controls = {"positive": body}
+    substitutions = {
+        "omit-once-return": ("!read->return_attempted", "true"),
+        "omit-physical-return": ("read->observation.read_returned", "true"),
+        "omit-attempted-fact": ("read->return_attempted = true;", ";"),
+        "omit-consumed-fact": ("read->consumed = true;", ";"),
+        "omit-busy-return": ("read->busy = false;", ";"),
+        "omit-first-status": ("read->first_status = first;", "read->first_status = 0;"),
+        "omit-native-post": ("read->native_post_status = pending_offer_native_current(read);", "read->native_post_status = 0;"),
+        "omit-source-post": ("read->source_post_status = pending_offer_source_current(read);", "read->source_post_status = 0;"),
+        "omit-session-post": ("read->session_post_status = refuse_session(\n        read->lender, &read->observation, sizeof(read->observation));", "read->session_post_status = 0;"),
+        "omit-local-return": ("read->return_status = refuse_return(read);", "read->return_status = 0;"),
+    }
+    for name, (before, after) in substitutions.items():
+        if body.count(before) != 1:
+            raise ValueError(f"nonunique literal: {name}")
+        controls[name] = body.replace(before, after)
+    results = {}
+    for name, current in controls.items():
+        path = output / (name + ".c")
+        binary = output / name
+        path.write_text('#include "qemu/osdep.h"\n'
+                        '#include "plugins/crucible-startup-source.h"\n' +
+                        REFUSALS + current + CHECKS)
+        command = [os.environ.get("CC", "cc"), *shlex.split(os.environ.get("CFLAGS", "")),
+                   str(path), "-o", str(binary), *shlex.split(os.environ.get("LDFLAGS", ""))]
+        (output / (name + ".command.json")).write_text(json.dumps(command, indent=2) + "\n")
+        compiled = subprocess.run(command, capture_output=True, text=True)
+        (output / (name + ".compile.log")).write_text(compiled.stdout + compiled.stderr)
+        compiled.check_returncode()
+        result = subprocess.run([str(binary)], capture_output=True, text=True, timeout=10)
+        (output / (name + ".log")).write_text(result.stdout + result.stderr)
+        expected = 0 if name == "positive" else -6
+        if result.returncode != expected:
+            raise RuntimeError(f"{name}: expected {expected}, got {result.returncode}")
+        results[name] = {"status": result.returncode, "stdout": result.stdout, "stderr": result.stderr}
+    (output / "proof.json").write_text(json.dumps(results, indent=2) + "\n")
+    print("PASS local facts/all-refusing posts and 10 independently rebuilt omissions")
+
+
+if __name__ == "__main__":
+    main()
