+int qemu_plugin_crucible_native_main_control_cpu_return_v1(
+    QemuCrucibleNativeInvocationTicket *holder)
+{
+#ifndef CONFIG_USER_ONLY
+    QemuCrucibleNativeInvocationRegistry *registry;
+    QemuCrucibleNativeInvocation *frame;
+    CPUState *cpu;
+    int status = qemu_plugin_crucible_native_main_control_current_v1(holder, false);
+
+    if (status) {
+        return status;
+    }
+    registry = holder->registry;
+    frame = holder->frame;
+    status = qemu_plugin_crucible_source_main_dispatch_current_v1(
+        frame->registration, frame->cpu, holder, true, NULL);
+    if (status) {
+        return status;
+    }
+    if (frame->main_borrow) {
+        status = qemu_crucible_source_action_original_closed_v1(frame->main_borrow);
+        if (!status) {
+            status = qemu_crucible_source_main_payload_closed_v1(frame->main_borrow);
+        }
+        if (status) {
+            return status;
+        }
+    }
+    qemu_mutex_lock(&registry->mutex);
+    frame->live = false;
+    qatomic_store_release(&registry->active_frame_hint,
+                         qatomic_read(&registry->active_frame_hint) - 1);
+    frame->cpu_return_in_flight = true;
+    cpu = frame->cpu;
+    qemu_mutex_unlock(&registry->mutex);
+
+    /* Keep the exact frame, descriptor and Source borrow through all actual
+     * unlocked QOM finalizers. No independent post precedes consumption. */
+    object_unref(OBJECT(cpu));
+    qemu_mutex_lock(&registry->mutex);
+    assert(!frame_identity_locked(registry, frame, holder->serial, getpid()));
+    assert(frame->main_holder == holder && frame->cpu_return_in_flight && frame->cpu == cpu);
+    frame->cpu = NULL;
+    frame->cpu_return_in_flight = false;
+    qemu_mutex_unlock(&registry->mutex);
+    return 0;
+#else
+    return -ENOTSUP;
+#endif
+}
