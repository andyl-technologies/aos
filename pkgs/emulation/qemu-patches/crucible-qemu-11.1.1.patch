+        g_assert_cmpuint(record->cap_id[index], ==, 0xb0 + index);
+    }
+
+    g_assert_true(record->operation_id == FIXTURE_TOTAL);
+    g_assert_true(record->original_start_ns == FIXTURE_METADATA);
+    g_assert_true(record->absolute_end_ns == FIXTURE_RESIDENT);
+    g_assert_true(record->poll_ns == 77);
+    g_assert_true(record->process_generation == FIXTURE_PROCESS);
+    g_assert_true(record->cancellation_device == device);
+    g_assert_true(record->cancellation_inode == FIXTURE_INODE);
+    g_assert_cmpint(record->cancellation_descriptor, ==, descriptor);
+    g_assert_cmpuint(record->flags, ==, 1);
+    g_assert_true(record->cancellation_event_id == FIXTURE_ACCOUNT);
+    g_assert_true(record->original_total_bytes == FIXTURE_TOTAL);
+}
+
+static void test_startup_fields(void)
+{
+    uint8_t wire[128];
+    uint8_t before[128];
+    QemuCrucibleOriginalStartupWireRecord record;
+
+    for (size_t device_index = 0; device_index < 2; device_index++) {
+        for (size_t fd_index = 0; fd_index < 2; fd_index++) {
+            uint64_t device = device_index ? FIXTURE_DEVICE : 0;
+            uint32_t descriptor = fd_index ? INT_MAX : 3;
