+/* Keeps host-timed virtqueue dispatch out of deterministic sim+icount. */
+static inline bool virtio_pci_ioeventfd_policy(bool configured,
+                                               bool sim_icount,
+                                               uint16_t device_id)
+{
+    if (!configured || !sim_icount) {
+        return configured;
+    }
+
+    switch (device_id) {
+    case VIRTIO_ID_RNG:
+    case VIRTIO_ID_BLOCK:
+    case VIRTIO_ID_NET:
+    case VIRTIO_ID_CONSOLE:
+        return false;
+    default:
+        return true;
+    }
