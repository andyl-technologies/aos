+    g_test_add_func("/crucible/idle-wait/rr-wake/prepark-postcheck",
+                    test_rr_prepark_event_catches_postcheck_publication);
+    g_test_add_func("/crucible/idle-wait/rr-wake/prepark-callback-work",
+                    test_rr_prepark_rescans_synchronous_callback_work);
+    g_test_add_func("/crucible/idle-wait/rr-wake/control-ack-prepark",
+                    test_rr_control_ack_prepark_uses_durable_predicates);
+    g_test_add_func("/crucible/idle-wait/rr-wake/prepark-no-wake",
+                    test_rr_prepark_waits_without_durable_predicate);
+    g_test_add_func("/crucible/idle-wait/rr-wake/control-boundary-rearm",
+                    test_rr_control_boundary_rearms_after_time_advance);
+    g_test_add_func("/crucible/idle-wait/rr-wake/concurrent-producers",
