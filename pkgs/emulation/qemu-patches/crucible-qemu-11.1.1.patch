+    current_cpu = NULL;
+    service_events();
+    g_assert_cmpuint(control_calls, ==, 0);
+    /* Relinquishing the RR owner is not fulfillment of the host request. */
+    g_assert_cmpuint(qemu_plugin_rr_control_complete_generation, ==, 0);
+    finish_stop();
+    finish_stop();
+    finish_stop();
+    service_events();
+    g_assert_cmpuint(control_calls, ==, 1);
+    g_assert_cmpuint(qemu_plugin_rr_control_complete_generation, ==, 1);
+    g_assert_cmpuint(qemu_plugin_rr_control_ack_generation, ==, 1);
+}
