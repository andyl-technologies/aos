+static int append_fingerprint_projection_manifest_row(
+    const char *idstr, uint32_t instance_id, const char *vmsd_name,
+    uint32_t vmsd_version, uint32_t domain, const char *projection_schema,
+    uint32_t projection_version, void *opaque)
+{
+    CrucibleFingerprintProjectionManifestRowList ***tail = opaque;
+    CrucibleFingerprintProjectionManifestRowList *link;
+    CrucibleFingerprintProjectionManifestRow *row;
+
+    row = g_new0(CrucibleFingerprintProjectionManifestRow, 1);
+    row->id = g_strdup(idstr);
+    row->instance = instance_id;
+    row->vmsd_name = g_strdup(vmsd_name);
+    row->vmsd_version = vmsd_version;
+    row->domain = domain;
+    row->projection_schema = g_strdup(projection_schema);
+    row->projection_version = projection_version;
+    link = g_new0(CrucibleFingerprintProjectionManifestRowList, 1);
+    link->value = row;
+    **tail = link;
+    *tail = &link->next;
+    return 0;
+}
