+                                    const uint8_t **data, uint32_t *length)
+{
+    for (size_t i = 0; i < rule->field_count; i++) {
+        if (rule->fields[i].tag == tag &&
+            rule->fields[i].type == expected_type) {
+            *data = rule->fields[i].data;
+            *length = rule->fields[i].length;
+            return true;
+        }
+    }
+    return false;
+}
