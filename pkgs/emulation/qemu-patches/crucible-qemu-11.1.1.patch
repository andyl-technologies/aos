+            &startup_source.callbacks.native);
+    }
+    if (status) {
+        return status;
+    }
+    if (owner->unmap_uncertain) {
+        return owner->unmap_status ? owner->unmap_status : -EIO;
+    }
+    if ((owner->mmap_attempted && !owner->mmap_returned) ||
+        (owner->unmap_attempted && !owner->unmap_returned)) {
+        return -EBUSY;
+    }
+    owner->closing = true;
+    if (!owner->physical_returned) {
+        if (owner->mapped) {
+            owner->unmap_attempted = true;
+            int result = munmap(owner->address, owner->layout.backing_bytes);
+            int saved_errno = result < 0 ? errno : 0;
+
+            owner->unmap_returned = true;
+            owner->unmap_status = result < 0 ? -saved_errno : 0;
+            owner->unmap_uncertain = result < 0;
+            if (result) {
+                status = owner->unmap_status;
+                goto retained;
+            }
+            owner->mapped = false;
+        }
+        /* Actual munmap0 or the exact completed no-map branch, never Post. */
+        owner->physical_returned = true;
+    }
+    if (owner->charge.held) {
+        status = crucible_metadata_native_retire(&startup_source.metadata_partition,
+                                                 &owner->charge);
+        if (status) {
+            goto retained;
+        }
+    }
+    while (owner->pinned_cpus || owner->pinned_children) {
+        Object *object = NULL;
+
+        status = pthread_mutex_trylock(&startup_source.cpu_allocations.lock);
+        if (status) {
+            status = -status;
+            goto retained;
+        }
+        if (owner->returning_qom_owner) {
+            cpu_owner = owner->returning_qom_owner;
+            status = cpu_allocation_identity_locked(cpu_owner);
+            if (!status &&
+                !initial_register_qom_return_consumable(owner, cpu_owner)) {
+                status = -ESTALE;
+            }
+            if (status) {
+                pthread_mutex_unlock(&startup_source.cpu_allocations.lock);
+                goto retained;
+            }
+            bool child = cpu_owner->register_workspace_parent != NULL;
+            cpu_owner->register_workspace_parent = NULL;
+            cpu_owner->register_workspace = NULL;
+            cpu_owner->constructor_children--;
+            if (child) {
+                owner->pinned_children--;
+            } else {
+                owner->pinned_cpus--;
+            }
+            owner->returning_qom_owner = NULL;
+            owner->qom_returned = false;
+        }
+        if (owner->pinned_cpus || owner->pinned_children) {
+            for (cpu_owner = startup_source.cpu_allocations.owners; cpu_owner;
+                 cpu_owner = cpu_owner->next) {
+                if (initial_register_qom_return_candidate(owner, cpu_owner)) {
+                    break;
+                }
+            }
+            if (!cpu_owner) {
+                pthread_mutex_unlock(&startup_source.cpu_allocations.lock);
+                status = -ESTALE;
+                goto retained;
+            }
+            object = cpu_owner->payload;
+            owner->returning_qom_owner = cpu_owner;
+            owner->transition_active = true;
+        }
+        pthread_mutex_unlock(&startup_source.cpu_allocations.lock);
+        if (object) {
+            /* Keep the registry child through actual unref, but never hold
+             * its mutex across a potentially reentrant QOM finalizer. The
+             * prepaid cursor prevents a second unref after lock refusal. */
+            object_unref(object);
+            owner->qom_returned = true;
+            owner->transition_active = false;
+        }
+    }
+    *holder = NULL;
+    owner->holder = NULL;
+    owner->held = false;
+    return 0;
+
+retained:
+    if (!owner->terminal_first_status) {
+        owner->terminal_first_status = status;
+    }
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
diff --git a/plugins/crucible-native-initial-read.inc.h b/plugins/crucible-native-initial-read.inc.h
new file mode 100644
index 0000000000000000000000000000000000000000..682704addbcc155c294bb42071859a110f314ea7
--- /dev/null
+++ b/plugins/crucible-native-initial-read.inc.h
@@ -0,0 +1,187 @@
+/*
+ * Native custody below the actual entered Initial callback child
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#if defined(CONFIG_LINUX) && !defined(CONFIG_USER_ONLY)
+static int initial_register_native_parent(
+    QemuCrucibleRegisterReadFrame *producer,
+    QemuCrucibleInitialRegisterRead **source_holder,
+    QemuCrucibleNativeInitialRegisterRead **holder,
+    QemuCrucibleRegisterReadPhase phase,
+    QemuCrucibleNativeInitialCpuChild **parent,
+    QemuCrucibleNativeInvocationRegistry **registry)
+{
+    int status = qemu_crucible_source_initial_register_read_native_current_v1(
+        producer, source_holder, holder, phase, parent);
+
+    if (status) {
+        return status;
+    }
+    status = qemu_plugin_crucible_initial_cpu_callback_entered_v1(producer->cpu);
+    if (!status) {
+        status = qemu_plugin_crucible_initial_cpu_child_current_v1(
+            producer->cpu, *parent, false);
+    }
+    if (status) {
+        return status;
+    }
+    *registry = native_dispatch_hint();
+    return *registry && registry_process_current(*registry, getpid()) ? 0 : -EPERM;
+}
+
+/* Called only under the authentic registry lock, after Source and Core have
+ * independently authenticated the actual canonical producer and parent. */
+static int initial_register_native_frame_locked(
+    QemuCrucibleNativeInvocationRegistry *registry,
+    QemuCrucibleNativeInitialCpuChild *parent, CPUState *cpu,
+    QemuCrucibleNativeInvocation **out)
+{
+    QemuCrucibleNativeInvocation *frame = top_locked(registry);
+    int status = frame ? frame_identity_locked(registry, frame, frame->serial,
+                                               getpid()) : -EPERM;
+
+    if (!status && (&frame->initial_cpu_child != parent ||
+        !frame->registration ||
+        !group_identity_locked(registry, frame->registration->group) ||
+        !frame->registration->group->complete ||
+        frame->registration->group->terminal ||
+        frame->registration->group->kind != QEMU_CRUCIBLE_NATIVE_GROUP_VCPU_INIT)) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        status = initial_cpu_child_facts_current(frame, cpu, parent->holder);
+    }
+    if (!status && (parent->callback_entered || parent->callback_returned ||
+                    parent->callback_not_entered)) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        *out = frame;
+    }
+    return status;
+}
+
+static bool initial_register_native_same_facts(
+    const QemuCrucibleNativeInitialRegisterRead *child,
+    QemuCrucibleNativeInitialCpuChild *parent,
+    QemuCrucibleRegisterReadFrame *producer,
+    QemuCrucibleInitialRegisterRead **source_holder,
+    QemuCrucibleNativeInitialRegisterRead **holder)
+{
+    return child == &parent->register_read && child->held && holder &&
+        *holder == child && child->holder == holder &&
+        child->producer == producer && child->source_holder == source_holder &&
+        child->parent_serial == parent->serial &&
+        child->producer_serial == producer->serial && child->serial > parent->serial;
+}
+
+static int initial_register_native_prebirth(
+    const QemuCrucibleNativeInitialRegisterRead *child,
+    QemuCrucibleNativeInitialRegisterRead **holder, uint64_t serial)
+{
+    if (!holder || *holder || child->held) {
+        return -EBUSY;
+    }
+    return serial == UINT64_MAX ? -EOVERFLOW : 0;
+}
+#endif
+
+int qemu_plugin_crucible_native_initial_register_read_begin_v1(
+    QemuCrucibleRegisterReadFrame *producer,
+    QemuCrucibleInitialRegisterRead **source_holder,
+    QemuCrucibleNativeInitialRegisterRead **holder)
+{
+#if defined(CONFIG_LINUX) && !defined(CONFIG_USER_ONLY)
+    QemuCrucibleNativeInitialCpuChild *parent = NULL;
+    QemuCrucibleNativeInvocationRegistry *registry = NULL;
+    QemuCrucibleNativeInvocation *frame = NULL;
+    int status = initial_register_native_parent(producer, source_holder, holder,
+        QEMU_CRUCIBLE_REGISTER_READ_BOUND_ISSUING, &parent, &registry);
+
+    if (status) {
+        return status;
+    }
+    qemu_mutex_lock(&registry->mutex);
+    status = initial_register_native_frame_locked(registry, parent, producer->cpu, &frame);
+    if (!status) {
+        status = initial_register_native_prebirth(&parent->register_read,
+                                                  holder, registry->serial);
+    }
+    if (!status) {
+        parent->register_read = (QemuCrucibleNativeInitialRegisterRead) {
+            .holder = holder, .producer = producer, .source_holder = source_holder,
+            .parent_serial = parent->serial, .producer_serial = producer->serial,
+            .serial = ++registry->serial, .held = true,
+        };
+        *holder = &parent->register_read;
+    }
+    qemu_mutex_unlock(&registry->mutex);
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_native_initial_register_read_current_v1(
+    QemuCrucibleRegisterReadFrame *producer,
+    QemuCrucibleInitialRegisterRead **source_holder,
+    QemuCrucibleNativeInitialRegisterRead **holder, bool entered)
+{
+#if defined(CONFIG_LINUX) && !defined(CONFIG_USER_ONLY)
+    QemuCrucibleNativeInitialCpuChild *parent = NULL;
+    QemuCrucibleNativeInvocationRegistry *registry = NULL;
+    QemuCrucibleNativeInvocation *frame = NULL;
+    int status = initial_register_native_parent(producer, source_holder, holder,
+        entered ? QEMU_CRUCIBLE_REGISTER_READ_ENTERED :
+                  QEMU_CRUCIBLE_REGISTER_READ_CALLING, &parent, &registry);
+
+    if (status) {
+        return status;
+    }
+    qemu_mutex_lock(&registry->mutex);
+    status = initial_register_native_frame_locked(registry, parent, producer->cpu, &frame);
+    if (!status && !initial_register_native_same_facts(&parent->register_read,
+        parent, producer, source_holder, holder)) {
+        status = -ESTALE;
+    }
+    qemu_mutex_unlock(&registry->mutex);
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_native_initial_register_read_return_v1(
+    QemuCrucibleRegisterReadFrame *producer,
+    QemuCrucibleInitialRegisterRead **source_holder,
+    QemuCrucibleNativeInitialRegisterRead **holder)
+{
+#if defined(CONFIG_LINUX) && !defined(CONFIG_USER_ONLY)
+    QemuCrucibleNativeInitialCpuChild *parent = NULL;
+    QemuCrucibleNativeInvocationRegistry *registry = NULL;
+    QemuCrucibleNativeInvocation *frame = NULL;
+    int status = initial_register_native_parent(producer, source_holder, holder,
+        QEMU_CRUCIBLE_REGISTER_READ_RETURNING, &parent, &registry);
+
+    if (status) {
+        return status;
+    }
+    qemu_mutex_lock(&registry->mutex);
+    status = initial_register_native_frame_locked(registry, parent, producer->cpu, &frame);
+    if (!status && !initial_register_native_same_facts(&parent->register_read,
+        parent, producer, source_holder, holder)) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        /* Only this exact inline membership is consumed. The independent
+         * Source post and its retained physical journal follow outside lock. */
+        parent->register_read.held = false;
+        *holder = NULL;
+    }
+    qemu_mutex_unlock(&registry->mutex);
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
diff --git a/plugins/crucible-native-invocation.c b/plugins/crucible-native-invocation.c
new file mode 100644
index 0000000000000000000000000000000000000000..93f2e2a65ffb82714addd5869f502651bb34ba52
--- /dev/null
+++ b/plugins/crucible-native-invocation.c
@@ -0,0 +1,3047 @@
+/*
+ * Native entered-callback lifetime and factual physical-use association.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "qemu/crucible-native-invocation.h"
+#include "qemu/crucible-register-read.h"
+#include "qemu/plugin.h"
+#include "qemu/crucible-preexec-setup.h"
+#include "plugin.h"
+#ifndef CONFIG_USER_ONLY
+#include "crucible-startup-source.h"
+#include "qemu/main-loop.h"
+#endif
+
+extern struct qemu_plugin_state plugin;
+
+#if defined(CONFIG_LINUX) && !defined(CONFIG_USER_ONLY)
+static QemuCrucibleNativeInvocationTicket native_vcpu_init_enter(
+    QemuCrucibleNativeRegistration *record, CPUState *cpu,
+    QemuCrucibleCpuSourceAllocationOwner *owner,
+    QemuCrucibleCpuAllocationReceipt *receipt, uint64_t generation, int *status);
+#endif
+
+size_t qemu_plugin_crucible_native_registry_bytes_v1(void)
+{
+    return sizeof(QemuCrucibleNativeInvocationRegistry);
+}
+
+size_t qemu_plugin_crucible_native_registry_alignment_v1(void)
+{
+    return _Alignof(QemuCrucibleNativeInvocationRegistry);
+}
+
+size_t qemu_plugin_crucible_native_ticket_bytes_v1(void)
+{
+    return sizeof(QemuCrucibleNativeInvocationTicket);
+}
+
+size_t qemu_plugin_crucible_native_ticket_alignment_v1(void)
+{
+    return _Alignof(QemuCrucibleNativeInvocationTicket);
+}
+
+size_t qemu_plugin_crucible_native_frame_bytes_v1(void)
+{
+    return sizeof(QemuCrucibleNativeInvocation);
+}
+
+size_t qemu_plugin_crucible_native_frame_alignment_v1(void)
+{
+    return _Alignof(QemuCrucibleNativeInvocation);
+}
+
+size_t qemu_plugin_crucible_native_registration_bytes_v1(void)
+{
+    return sizeof(QemuCrucibleNativeRegistration);
+}
+
+size_t qemu_plugin_crucible_native_registration_alignment_v1(void)
+{
+    return _Alignof(QemuCrucibleNativeRegistration);
+}
+
+size_t qemu_plugin_crucible_native_group_member_count_v1(
+    QemuCrucibleNativeRegistrationGroupKind kind)
+{
+    switch (kind) {
+    case QEMU_CRUCIBLE_NATIVE_GROUP_CONTROL:
+    case QEMU_CRUCIBLE_NATIVE_GROUP_TIME_ADVANCE:
+    case QEMU_CRUCIBLE_NATIVE_GROUP_VCPU_INIT:
+    case QEMU_CRUCIBLE_NATIVE_GROUP_NET_TX:
+    case QEMU_CRUCIBLE_NATIVE_GROUP_BLOCK_WAIT:
+        return 1;
+    case QEMU_CRUCIBLE_NATIVE_GROUP_IDLE_RESUME:
+    case QEMU_CRUCIBLE_NATIVE_GROUP_BLOCK_IO:
+        return 2;
+    case QEMU_CRUCIBLE_NATIVE_GROUP_SHMEM_DISPATCH:
+        return 3;
+    case QEMU_CRUCIBLE_NATIVE_GROUP_BLOCK_EVENT:
+    case QEMU_CRUCIBLE_NATIVE_GROUP_9P:
+        return 4;
+    case QEMU_CRUCIBLE_NATIVE_GROUP_ACCELERATOR:
+        return 8;
+    default:
+        return 0;
+    }
+}
+
+size_t qemu_plugin_crucible_native_group_header_bytes_v1(void)
+{
+    return sizeof(QemuCrucibleNativeRegistrationGroup);
+}
+
+size_t qemu_plugin_crucible_native_group_header_alignment_v1(void)
+{
+    return _Alignof(QemuCrucibleNativeRegistrationGroup);
+}
+
+size_t qemu_plugin_crucible_native_group_registrar_bytes_v1(void)
+{
+    return sizeof(QemuCrucibleNativeGroupRegistrar);
+}
+
+size_t qemu_plugin_crucible_native_group_registrar_alignment_v1(void)
+{
+    return _Alignof(QemuCrucibleNativeGroupRegistrar);
+}
+
+size_t qemu_plugin_crucible_native_group_use_bytes_v1(void)
+{
+    return sizeof(QemuCrucibleNativeGroupUse);
+}
+
+size_t qemu_plugin_crucible_native_group_use_alignment_v1(void)
+{
+    return _Alignof(QemuCrucibleNativeGroupUse);
+}
+
+size_t qemu_plugin_crucible_native_group_descriptor_bytes_v1(void)
+{
+    return sizeof(QemuCrucibleNativeGroupDescriptorView);
+}
+
+size_t qemu_plugin_crucible_native_group_descriptor_alignment_v1(void)
+{
+    return _Alignof(QemuCrucibleNativeGroupDescriptorView);
+}
+
+static QemuCrucibleNativeInvocationRegistry *native_registry(bool installing)
+{
+#ifndef CONFIG_USER_ONLY
+    if (!installing && !qemu_crucible_startup_source_native_selection_v1()) {
+        return NULL;
+    }
+    return qemu_crucible_startup_source_native_registry_v1(NULL, installing);
+#else
+    (void)installing;
+    return NULL;
+#endif
+}
+
+static QemuCrucibleNativeInvocationRegistry *native_selection(void)
+{
+#ifndef CONFIG_USER_ONLY
+    return qemu_crucible_startup_source_native_selection_v1();
+#else
+    return NULL;
+#endif
+}
+
+static QemuCrucibleNativeInvocationRegistry *native_dispatch_hint(void)
+{
+#ifndef CONFIG_USER_ONLY
+    return qemu_crucible_startup_source_native_dispatch_hint_v1();
+#else
+    return NULL;
+#endif
+}
+
+/* Source initializes this immutable process before publishing its permanent
+ * holder. Reject fork copies before touching any potentially inherited mutex. */
+static bool registry_process_current(QemuCrucibleNativeInvocationRegistry *registry,
+                                     pid_t process)
+{
+    return registry && registry->process == process;
+}
+
+/* The reciprocal Source method establishes payment and retained ownership;
+ * these checks reject stale copied geometry or process incarnation. */
+static bool registry_identity_locked(QemuCrucibleNativeInvocationRegistry *registry,
+                                     pid_t process)
+{
+    return registry->initialized &&
+        registry->canonical_owner == registry && registry->ctx &&
+        registry->module && registry->runtime && registry->storage &&
+        registry->storage_holder && registry->process == process &&
+        registry->process_generation && registry->account_generation;
+}
+
+static bool registry_current_locked(QemuCrucibleNativeInvocationRegistry *registry,
+                                    pid_t process)
+{
+    return registry_identity_locked(registry, process) &&
+        registry->bound && !registry->revoked;
+}
+
+/* The array is the catalog of real registrar shapes, not a capacity grant.
+ * Only Source's retained nominal borrower can insert its canonical header. */
+static size_t group_index(QemuCrucibleNativeRegistrationGroupKind kind)
+{
+    return (size_t)kind - 1;
+}
+
+static bool group_source_object_identity(QemuCrucibleNativeRegistrationGroup *group,
+                                         QemuCrucibleCallbackRegistrationGroupOwner *owner)
+{
+#ifndef CONFIG_USER_ONLY
+    return owner && group == &owner->native && group->members == owner->members &&
+        group->member_count == owner->member_count &&
+        (group->kind != QEMU_CRUCIBLE_NATIVE_GROUP_VCPU_INIT ||
+         group->callback == owner->callback);
+#else
+    (void)group;
+    (void)owner;
+    return false;
+#endif
+}
+
+static bool group_identity_locked(QemuCrucibleNativeInvocationRegistry *registry,
+                                  QemuCrucibleNativeRegistrationGroup *group)
+{
+    size_t index;
+
+    if (!group || !qemu_plugin_crucible_native_group_member_count_v1(group->kind)) {
+        return false;
+    }
+    index = group_index(group->kind);
+    return registry->groups[index] == group && group->canonical_owner == group &&
+        group->registry == registry && group->owner && group->child_owner &&
+        group_source_object_identity(group, group->owner) &&
+        group->ctx && group->module && group->members && group->member_count ==
+            qemu_plugin_crucible_native_group_member_count_v1(group->kind) &&
+        group->publication_serial && group->registrar_serial && group->reserved;
+}
+
+static void group_record_failure_locked(QemuCrucibleNativeRegistrationGroup *group,
+                                        int status)
+{
+    if (status && !group->first_status) {
+        group->first_status = status;
+    }
+}
+
+static int group_begin(
+    QemuCrucibleNativeRegistrationGroupKind kind,
+    const QemuCrucibleNativeGroupDescriptorView *descriptors, size_t count,
+    QemuCrucibleNativeGroupRegistrar *registrar, bool callback_descriptor,
+    qemu_plugin_id_t id, void *function, void *userdata)
+{
+    *registrar = (QemuCrucibleNativeGroupRegistrar) { .kind = kind };
+#ifndef CONFIG_USER_ONLY
+    QemuCrucibleCallbackRegistrationGroupView view = { 0 };
+    QemuCrucibleNativeGroupDescriptorView callback_view;
+    QemuCrucibleNativeInvocationRegistry *registry;
+    QemuCrucibleNativeRegistrationGroup *group;
+    struct qemu_plugin_ctx *ctx;
+    pid_t process;
+    size_t i;
+    int status;
+    int first;
+
+    first = qemu_crucible_startup_source_callback_group_borrow_current_v1(
+        kind, &registrar->borrow, &registrar->serial);
+    registrar->first_status = first;
+    if (!registrar->borrow) {
+        registrar->ordinary = !first;
+        return first;
+    }
+    /* Observe even a born-negative output. No effect is admitted from that
+     * output, but its exact owner and debt must survive the independent post. */
+    status = qemu_crucible_startup_source_callback_group_observe_v1(
+        registrar->borrow, registrar->serial, kind, &view);
+    if (status) {
+        registrar->first_status = first ? first : status;
+        return registrar->first_status;
+    }
+    if (!first) {
+        first = qemu_crucible_startup_source_callback_group_current_v1(
+            registrar->borrow, registrar->serial, kind);
+    }
+    registry = view.registry;
+    group = view.native;
+    process = getpid();
+    if (!registry_process_current(registry, process) || !group || !view.members ||
+        !view.owner || !view.child_owner || !view.ctx || !view.module ||
+        view.borrow != registrar->borrow || view.registrar_serial != registrar->serial ||
+        view.kind != kind || !view.publication_serial || view.member_count !=
+            qemu_plugin_crucible_native_group_member_count_v1(kind)) {
+        registrar->first_status = first ? first : -ESTALE;
+        return registrar->first_status;
+    }
+    if (kind == QEMU_CRUCIBLE_NATIVE_GROUP_VCPU_INIT) {
+        if (!callback_descriptor || !view.callback || view.ctx->id != id) {
+            first = first ? first : -ESTALE;
+        } else {
+            callback_view = (QemuCrucibleNativeGroupDescriptorView) {
+                .coordinate = &view.callback->f.generic,
+                .function = function,
+                .userdata = userdata,
+                .userdata_coordinate = &view.callback->udata,
+                .kind = QEMU_CRUCIBLE_NATIVE_REGISTERED,
+            };
+            descriptors = &callback_view;
+            count = 1;
+        }
+    }
+    if (!descriptors || count != view.member_count) {
+        first = first ? first : -EINVAL;
+    }
+    if (!first) {
+        for (i = 0; i < count; i++) {
+            if (!descriptors[i].coordinate || !descriptors[i].userdata_coordinate ||
+                !descriptors[i].function ||
+                (descriptors[i].kind != QEMU_CRUCIBLE_NATIVE_REGISTERED &&
+                 descriptors[i].kind != QEMU_CRUCIBLE_NATIVE_CONTROL &&
+                 descriptors[i].kind != QEMU_CRUCIBLE_NATIVE_MAX_ADVANCE)) {
+                first = -EINVAL;
+                break;
+            }
+        }
+    }
+
+    /* Source and clock calls precede the actual registrar lock. Source's
+     * existing child pin makes this saved ctx address-safe; id_to_ctx and its
+     * handle/lifecycle establish actual module custody before Native writes. */
+    qemu_rec_mutex_lock(&plugin.lock);
+    ctx = plugin_id_to_ctx_locked(view.ctx->id);
+    qemu_mutex_lock(&registry->mutex);
+    if (registry->groups[group_index(kind)] || group->canonical_owner) {
+        /* Never overwrite an earlier canonical attempt, including negative
+         * or partially installed ownership. Source also refuses that replay. */
+        status = -EALREADY;
+    } else {
+        *group = (QemuCrucibleNativeRegistrationGroup) {
+            .canonical_owner = group,
+            .registry = registry,
+            .owner = view.owner,
+            .borrow = registrar->borrow,
+            .child_owner = view.child_owner,
+            .ctx = view.ctx,
+            .callback = kind == QEMU_CRUCIBLE_NATIVE_GROUP_VCPU_INIT ?
+                view.callback : NULL,
+            .module = view.module,
+            .members = view.members,
+            .member_count = view.member_count,
+            .publication_serial = view.publication_serial,
+            .registrar_serial = view.registrar_serial,
+            .kind = kind,
+            .first_status = first,
+            .reserved = true,
+        };
+        registry->groups[group_index(kind)] = group;
+        registrar->group = group;
+        /* The authentic typed Source output becomes an identifiable negative
+         * disposition before these fallible module/registry corroborations.
+         * Source's already-born debt cannot be freed from a missing header. */
+        if (!registry_identity_locked(registry, process) || ctx != view.ctx ||
+            ctx->handle != view.module || view.ctx != registry->ctx ||
+            view.module != registry->module || view.runtime != registry->runtime ||
+            view.bridge != registry->storage ||
+            view.bridge_holder != registry->storage_holder ||
+            (registry->child_owner && registry->child_owner != view.child_owner)) {
+            group_record_failure_locked(group, -ESTALE);
+        } else if (ctx->resetting || ctx->uninstalling || !ctx->installing ||
+                   ctx->callback_users == UINT_MAX || registry->revoked ||
+                   registry->serial > UINT64_MAX - view.member_count ||
+                   (callback_descriptor &&
+                    (!view.callback || ctx->callbacks[QEMU_PLUGIN_EV_VCPU_INIT] ||
+                     view.callback->ctx || view.callback->native_registration ||
+                     view.callback->f.generic))) {
+            group_record_failure_locked(group, -EBUSY);
+        } else {
+            registry->child_owner = view.child_owner;
+            registry->child_registration_seen = true;
+            plugin_ctx_callback_retain__locked(ctx);
+            group->module_retained = true;
+        }
+        for (i = 0; i < view.member_count; i++) {
+            QemuCrucibleNativeRegistration *record = &view.members[i];
+
+            *record = (QemuCrucibleNativeRegistration) {
+                .owner = registry,
+                .group = group,
+                .child_owner = view.child_owner,
+                .ctx = view.ctx,
+                .module = view.module,
+                .publication_serial = view.publication_serial,
+                .registrar_serial = view.registrar_serial,
+            };
+            if (descriptors && count == view.member_count) {
+                record->coordinate = descriptors[i].coordinate;
+                record->function = descriptors[i].function;
+                record->userdata = descriptors[i].userdata;
+                record->userdata_coordinate = descriptors[i].userdata_coordinate;
+                record->kind = descriptors[i].kind;
+            }
+            if (registry->serial < UINT64_MAX) {
+                record->serial = ++registry->serial;
+            }
+        }
+        status = group->first_status;
+    }
+    qemu_mutex_unlock(&registry->mutex);
+    qemu_rec_mutex_unlock(&plugin.lock);
+    registrar->first_status = first ? first : status;
+    return registrar->first_status;
+#else
+    (void)descriptors;
+    (void)count;
+    (void)callback_descriptor;
+    (void)id;
+    (void)function;
+    (void)userdata;
+    registrar->ordinary = true;
+    return 0;
+#endif
+}
