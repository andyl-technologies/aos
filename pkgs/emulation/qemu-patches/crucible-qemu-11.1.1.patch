+            cs->gic->crucible_interrupt_source_sequence[event->vector] =
+                event->source_sequence;
+            cs->gic->crucible_interrupt_routing_generation[event->vector] =
+                event->routing_generation;
+            cs->gic->crucible_interrupt_priority[event->vector] =
+                event->priority;
+            cs->gic->crucible_interrupt_priority_valid[
+                BIT32_WORD(event->vector)] |= BIT32_MASK(event->vector);
+        }
