+static void scenario_metadata_return_foreign_process(void)
+{
+    pid_t child;
+    int status;
+
+    fixture_inventory_purpose();
+    child = fork();
+    g_assert_cmpint(child, >=, 0);
+    if (!child) {
+        /* Invalid addresses witness process rejection before mutable owner or
+         * canonical journal access. No parent receipt can be returned here. */
+        g_assert_cmpint(qemu_crucible_startup_source_ram_return_prepare(
+                           (void *)1, (void *)1), ==, -EPERM);
+        g_assert_cmpint(qemu_crucible_startup_source_native_metadata_retire(
+                           (void *)1), ==, -EPERM);
+        g_assert_cmpint(qemu_crucible_ram_metadata_owner_current(
+                           (void *)1, (void *)1), ==, -EPERM);
+        g_assert_cmpint(qemu_crucible_ram_dirty_metadata_owner_current(
+                           (void *)1, (void *)1), ==, -EPERM);
+        _exit(0);
+    }
+    g_assert_cmpint(waitpid(child, &status, 0), ==, child);
+    g_assert_true(WIFEXITED(status));
+    g_assert_cmpint(WEXITSTATUS(status), ==, 0);
+    g_assert_cmpuint(startup_source.metadata_partition.native_live, ==, 0);
+}
