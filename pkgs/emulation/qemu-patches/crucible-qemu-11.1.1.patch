+        protocol == PROT_BLOCK_DATA ? smb->smb_data0 : 0;
+
+    qemu_put_byte(f, smb->smb_stat);
+    qemu_put_byte(f, smb->smb_ctl);
+    qemu_put_byte(f, smb->smb_cmd);
+    qemu_put_byte(f, smb->smb_addr);
