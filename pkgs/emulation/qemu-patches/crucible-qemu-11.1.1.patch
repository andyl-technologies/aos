+static bool initial_register_geometry_shape_matches(
+    const CrucibleCPURegisterGeometry *expected,
+    const CrucibleCPURegisterGeometry *actual)
+{
+    /* CPU identity is checked separately on each genuine retained object. */
+    return expected->register_count == actual->register_count &&
+        expected->key_count == actual->key_count &&
+        expected->name_bytes == actual->name_bytes &&
+        expected->mask_bytes == actual->mask_bytes &&
+        expected->max_name_bytes == actual->max_name_bytes &&
+        expected->max_mask_bytes == actual->max_mask_bytes;
+}
