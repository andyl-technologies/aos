+    if (!arm_cpu_validate_fault_exception(cs, exception) ||
+        exception->aarch64_ras.corrected ||
+        env->crucible_hardware_error.synchronous_pending ||
+        env->crucible_hardware_error.asynchronous_pending) {
+        return false;
+    }
+    if (exception->aarch64_ras.asynchronous) {
+        env->cp15.disr_el1 = exception->aarch64_ras.disr;
+        env->crucible_hardware_error.disr =
+            exception->aarch64_ras.disr;
+        env->crucible_hardware_error.asynchronous_pending = 1;
+    } else {
+        env->crucible_hardware_error.syndrome = exception->syndrome;
+        env->crucible_hardware_error.address = exception->fault_address;
+        env->crucible_hardware_error.synchronous_pending = 1;
+    }
