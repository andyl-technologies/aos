+static CrucibleHotForkBlockBarrierState *
+crucible_hot_fork_block_barrier(
+    QemuBlockBackendHotForkBarrierOperation operation, Error **errp)
+{
+    QemuBlockBackendHotForkBarrierInventory inventory;
+    QemuCrucibleRamBorrowInventory borrowers;
+    CrucibleHotForkBlockBarrierState *report;
+    CrucibleHotForkBlockSnapshotRootList **root_tail;
+    size_t index;
+
+    if (!qemu_block_backend_hot_fork_barrier(operation, &inventory)) {
+        error_setg(errp, "Crucible hot-fork block drain is unavailable in "
+                   "the current replay or AioContext mode");
+        return NULL;
+    }
+
+    report = g_new0(CrucibleHotForkBlockBarrierState, 1);
+    report->schema_version = 5;
+    qemu_crucible_ram_borrow_inventory(&borrowers);
+    report->ram_borrow_generation = borrowers.generation;
+    report->ram_direct_maps = borrowers.direct_maps;
+    report->ram_bounce_maps = borrowers.bounce_maps;
+    report->ram_caches = borrowers.caches;
+    report->ram_direct_caches = borrowers.direct_caches;
+    report->ram_paging_requested = borrowers.paging_requested;
+    report->ram_borrowers_consistent = borrowers.consistent;
+    report->generation = inventory.generation;
+    report->owner_thread_id = inventory.owner_thread_id;
+    report->graph_barrier_generation =
+        inventory.graph_barrier_generation;
+    report->graph_mutation_generation =
+        inventory.graph_mutation_generation;
+    report->held_graph_mutation_generation =
+        inventory.held_graph_mutation_generation;
+    report->graph_owner_thread_id = inventory.graph_owner_thread_id;
+    report->held = inventory.held;
+    report->graph_held = inventory.graph_held;
+    report->graph_writer_active = inventory.graph_writer_active;
+    report->graph_waiting_writers = inventory.graph_waiting_writers;
+    report->graph_stable = inventory.graph_stable;
+    report->snapshot_generation = inventory.snapshot_generation;
+    report->snapshot_backend_generation =
+        inventory.snapshot_backend_generation;
+    report->snapshot_graph_mutation_generation =
+        inventory.snapshot_graph_mutation_generation;
+    report->snapshot_owner_thread_id =
+        inventory.snapshot_owner_thread_id;
+    report->snapshot_bound = inventory.snapshot_bound;
+    report->snapshot_complete = inventory.snapshot_complete;
+    report->snapshot_sources = g_new0(CrucibleHotForkBlockSourceProof, 1);
+    report->snapshot_sources->schema_version = 1;
+    report->snapshot_sources->frozen = inventory.snapshot_sources.frozen;
+    report->snapshot_sources->root_count = inventory.snapshot_sources.roots;
+    report->snapshot_sources->node_count = inventory.snapshot_sources.nodes;
+    report->snapshot_sources->originally_writable_root_count =
+        inventory.snapshot_sources.originally_writable_roots;
+    report->snapshot_sources->originally_writable_backend_count =
+        inventory.snapshot_sources.originally_writable_backends;
+    root_tail = &report->snapshot_roots;
+    for (index = 0; index < inventory.snapshot_root_count; index++) {
+        const QemuBlockBackendHotForkSnapshotRoot *source =
+            &inventory.snapshot_roots[index];
+        CrucibleHotForkBlockSnapshotRoot *root =
+            g_new0(CrucibleHotForkBlockSnapshotRoot, 1);
+        CrucibleHotForkBlockSnapshotRootList *node =
+            g_new0(CrucibleHotForkBlockSnapshotRootList, 1);
+
+        root->backend_id = source->binding.backend_id;
+        root->backend_name = g_strdup(source->binding.backend_name);
+        root->overlay_node_name =
+            g_strdup(source->binding.overlay_node_name);
+        root->snapshot_node_name =
+            g_strdup(source->binding.snapshot_node_name);
+        root->snapshot_content_id =
+            g_strdup(source->binding.snapshot_content_id);
+        root->virtual_size = source->virtual_size;
+        root->overlay_empty = source->overlay_empty;
+        root->snapshot_read_only = source->snapshot_read_only;
+        node->value = root;
+        *root_tail = node;
+        root_tail = &node->next;
+    }
+    report->complete = inventory.complete;
+    report->backend_count = inventory.backend_count;
+    report->rooted_backends = inventory.rooted_backends;
+    report->writable_backends = inventory.writable_backends;
+    report->writable_rooted_backends = inventory.writable_rooted_backends;
+    report->quiesced_rooted_backends =
+        inventory.quiesced_rooted_backends;
+    report->in_flight = inventory.in_flight;
+    report->quiescent = inventory.quiescent;
+    qemu_block_backend_hot_fork_barrier_inventory_destroy(&inventory);
+    return report;
+}
