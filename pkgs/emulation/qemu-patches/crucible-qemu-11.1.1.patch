+static bool edu_fingerprint_projection(QEMUFile *f, const void *opaque,
+                                       Error **errp)
+{
+    EduState *edu = (EduState *)opaque;
+    uint32_t fact;
+    uint32_t status;
+    uint32_t fact_remaining;
+    uint32_t fact_result;
+    bool fact_irq_pending;
+    bool dma_pending;
+
+    qemu_mutex_lock(&edu->thr_mutex);
+    fact = edu->fact;
+    status = qatomic_read(&edu->status);
+    fact_remaining = edu->fact_remaining;
+    fact_result = edu->fact_result;
+    fact_irq_pending = edu->fact_irq_pending;
+    qemu_mutex_unlock(&edu->thr_mutex);
+
+    dma_pending = timer_pending(&edu->dma_timer);
+    if (status & ~(EDU_STATUS_COMPUTING | EDU_STATUS_IRQFACT) ||
+        (!(status & EDU_STATUS_COMPUTING) &&
+         (fact_remaining || fact_result)) ||
+        ((status & EDU_STATUS_COMPUTING) && fact_remaining > fact) ||
+        (!!(edu->dma.cmd & EDU_DMA_RUN) != dma_pending)) {
+        error_setg(errp, "EDU fingerprint state is inconsistent");
+        return false;
+    }
+    if (!pci_device_fingerprint_projection(f, &edu->pdev, errp)) {
+        return false;
+    }
+
+    qemu_put_be32(f, edu->addr4);
+    qemu_put_be32(f, fact);
+    qemu_put_be32(f, status);
+    qemu_put_be32(f, fact_remaining);
+    qemu_put_be32(f, fact_result);
+    qemu_put_byte(f, fact_irq_pending);
+    qemu_put_be32(f, edu->irq_status);
+    qemu_put_be64(f, edu->dma.src);
+    qemu_put_be64(f, edu->dma.dst);
+    qemu_put_be64(f, edu->dma.cnt);
+    qemu_put_be64(f, edu->dma.cmd);
+    qemu_put_buffer(f, (const uint8_t *)edu->dma_buf, sizeof(edu->dma_buf));
+    qemu_put_be64(f, edu->dma_mask);
+    qemu_put_byte(f, dma_pending);
+    if (dma_pending) {
+        int64_t deadline_ns;
+        uint16_t deadline_phase_ps;
+
+        if (timer_expire_time_ns_phase(&edu->dma_timer, &deadline_ns,
+                                       &deadline_phase_ps) != 1) {
+            error_setg(errp, "EDU DMA deadline cannot be projected");
+            return false;
+        }
+        qemu_put_sbe64(f, deadline_ns);
+        qemu_put_be16(f, deadline_phase_ps);
+    }
+    return true;
+}
