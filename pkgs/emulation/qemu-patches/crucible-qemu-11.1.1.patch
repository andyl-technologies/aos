+{
+    if (!slots || slots > (SIZE_MAX - sizeof(QemuCrucibleDescriptorTable)) /
+                          sizeof(DescriptorRecord)) {
+        return 0;
+    }
+    return sizeof(QemuCrucibleDescriptorTable) + slots * sizeof(DescriptorRecord);
+}
+
+size_t qemu_descriptor_table_body_alignment(void)
+{
+    return _Alignof(QemuCrucibleDescriptorTable);
+}
+
+size_t qemu_descriptor_table_publication_bytes(void)
+{
+    return sizeof(selected_table);
+}
+
+bool qemu_descriptor_table_active(void)
+{
+    return qatomic_load_acquire(&selected_table) != NULL;
+}
+
+/* A retained disposition failure refuses new effects, never physical return.
+ * This observation supplies no slot, clock or new Source purpose. */
+int qemu_descriptor_table_status(void)
+{
+    QemuCrucibleDescriptorTable *table = qatomic_load_acquire(&selected_table);
+
+    if (!table) {
+        return 0;
+    }
+    if (!table->retained || !table->binding || table->process != getpid()) {
+        return -EPERM;
+    }
+    return qatomic_read(&table->first_status);
+}
+
+/* This private mutex protects only bounded record bookkeeping. No holder is
+ * waited on, and no allocation, callback, Source query or syscall executes
+ * inside its critical sections. An actual ordinary concurrent helper waits
+ * for that same short cut instead of turning registry contention into failure.
+ * Source process identity is checked before locking, including after fork. */
+
+/* One table owns both ordinary effects and any later subset loans. Slots are
+ * actual prepaid records, not a second allowance derived from a free count. */
+static int descriptor_prepare(QemuCrucibleDescriptorTable *table,
+                              DescriptorRecord **out, size_t count)
+{
+    DescriptorRecord *reserved[2];
+    size_t found = 0;
+    int status;
+
+    if (!count || count > ARRAY_SIZE(reserved)) {
+        return -EINVAL;
+    }
+    if (table != qatomic_load_acquire(&selected_table) ||
+        !table->retained || !table->binding || table->process != getpid()) {
+        return -EPERM;
+    }
+    status = qatomic_read(&table->first_status);
+    if (status) {
+        return status;
+    }
+    status = pthread_mutex_lock(&table->lock);
+    if (status) {
+        return -status;
+    }
+    if (count > UINT64_MAX - table->next_serial) {
+        pthread_mutex_unlock(&table->lock);
+        return -EOVERFLOW;
+    }
+    for (size_t index = 0; index < table->slots && found < count; index++) {
+        if (qatomic_load_acquire(&table->records[index].disposition) == DESCRIPTOR_IDLE) {
+            reserved[found++] = &table->records[index];
+        }
+    }
+    if (found != count) {
+        pthread_mutex_unlock(&table->lock);
+        return -EMFILE;
+    }
+    for (size_t index = 0; index < count; index++) {
+        *reserved[index] = (DescriptorRecord) {
+            .table = table,
+            .disposition = DESCRIPTOR_CREATING,
+            .creator = pthread_self(),
+            .serial = ++table->next_serial,
+            .descriptor = -1,
+        };
+        out[index] = reserved[index];
+    }
+    pthread_mutex_unlock(&table->lock);
+    return 0;
+}
+
+/* The exact creator retains this pending record across its syscall. Save the
+ * physical output before publishing LIVE or interpreting any later operation.
+ * Opaque library failure cannot prove no effect and remains uncertain. */
+static void descriptor_result(DescriptorRecord *record, int fd, int saved_errno,
+                              bool definite_failure)
+{
+    DescriptorRecord **owner;
+
+    if (!record) {
+        return;
+    }
+    assert(record->disposition == DESCRIPTOR_CREATING);
+    assert(pthread_equal(record->creator, pthread_self()));
+    record->descriptor = fd;
+    record->effect_result = fd;
+    record->effect_errno = saved_errno;
+    owner = qatomic_load_acquire(&record->owner_holder);
+
+    if (owner) {
+        *owner = fd >= 0 ? record : NULL;
+        if (fd < 0) {
+            qatomic_store_release(&record->owner_holder, NULL);
+        }
+    }
+    if (fd < 0 && !definite_failure) {
+        qatomic_cmpxchg(&record->table->first_status, 0,
+                       saved_errno ? -saved_errno : -EIO);
+    }
+    qatomic_store_release(&record->disposition,
+                          fd >= 0 ? DESCRIPTOR_LIVE :
+                          definite_failure ? DESCRIPTOR_IDLE : DESCRIPTOR_UNCERTAIN);
+}
+
+static bool descriptor_begin(DescriptorRecord **record)
+{
+    QemuCrucibleDescriptorTable *table = qatomic_load_acquire(&selected_table);
+    int status;
+
+    *record = NULL;
+    if (!table) {
+        return true;
+    }
+    status = descriptor_prepare(table, record, 1);
+    if (status) {
+        errno = -status;
+        return false;
+    }
+    return true;
+}
+
+static bool descriptor_begin_owned(DescriptorRecord **record,
+                                   DescriptorRecord **owner)
+{
+    if (!owner || *owner) {
+        errno = EINVAL;
+        return false;
+    }
+    if (!descriptor_begin(record)) {
+        return false;
+    }
+    if (*record) {
+        qatomic_store_release(&(*record)->owner_holder, owner);
+    }
+    return true;
+}
+
+int qemu_descriptor_open_owned(const char *path, int flags, mode_t mode,
+                               DescriptorRecord **owner)
+{
+    DescriptorRecord *record;
+    int fd;
+    int saved_errno;
+
+    if (!descriptor_begin_owned(&record, owner)) {
+        return -1;
+    }
+    fd = open(path, flags, mode);
+    saved_errno = errno;
+    descriptor_result(record, fd, saved_errno, true);
+    errno = saved_errno;
+    return fd;
+}
+
+int qemu_descriptor_open(const char *path, int flags, mode_t mode)
+{
+    DescriptorRecord *record;
+    int fd;
+    int saved_errno;
+
+    if (!descriptor_begin(&record)) {
+        return -1;
+    }
+    fd = open(path, flags, mode);
+    saved_errno = errno;
+    descriptor_result(record, fd, saved_errno, true);
+    errno = saved_errno;
+    return fd;
+}
+
+int qemu_descriptor_dup_cloexec(int input)
+{
+    DescriptorRecord *record;
+    int fd;
+    int saved_errno;
+
+    if (!descriptor_begin(&record)) {
+        return -1;
+    }
+#ifdef F_DUPFD_CLOEXEC
+    fd = fcntl(input, F_DUPFD_CLOEXEC, 0);
+#else
+    fd = dup(input);
+#endif
+    saved_errno = errno;
+    descriptor_result(record, fd, saved_errno, true);
+#ifndef F_DUPFD_CLOEXEC
+    if (fd >= 0) {
+        qemu_set_cloexec(fd);
+    }
+#endif
+    errno = saved_errno;
+    return fd;
+}
+
+int qemu_descriptor_close(int fd)
+{
+    QemuCrucibleDescriptorTable *table = qatomic_load_acquire(&selected_table);
+    DescriptorRecord *record = NULL;
+    int status;
+    int result;
+    int saved_errno;
+
+    if (!table) {
+        return close(fd);
+    }
+    if (table->process != getpid() || !table->retained || !table->binding) {
+        errno = EPERM;
+        return -1;
+    }
+    status = pthread_mutex_lock(&table->lock);
+    if (status) {
+        errno = status;
+        return -1;
+    }
+    for (size_t index = 0; index < table->slots; index++) {
+        DescriptorRecord *candidate = &table->records[index];
+
+        DescriptorDisposition disposition =
+            qatomic_load_acquire(&candidate->disposition);
+
+        /* Only an actual kernel-born LIVE generation can own today's number.
+         * Older closing/uncertain journals remain held independently. */
+        if (disposition != DESCRIPTOR_LIVE || candidate->descriptor != fd ||
+            candidate->close_attempted) {
+            continue;
+        }
+        if (record) {
+            pthread_mutex_unlock(&table->lock);
+            errno = ESTALE;
+            return -1;
+        }
+        record = candidate;
+    }
+    /* An issued durable field must be consumed through its exact owner API. */
+    if (!record || qatomic_load_acquire(&record->owner_holder)) {
+        pthread_mutex_unlock(&table->lock);
+        errno = ESTALE;
+        return -1;
+    }
+    record->close_attempted = true;
+    record->disposition = DESCRIPTOR_CLOSING;
+    pthread_mutex_unlock(&table->lock);
+
+    result = close(fd);
+    saved_errno = errno;
+    record->close_result = result;
+    record->close_errno = saved_errno;
+    if (result < 0) {
+        qatomic_cmpxchg(&table->first_status, 0,
+                       saved_errno ? -saved_errno : -EIO);
+    }
+    /* A negative close remains held, even if the kernel may have consumed it.
+     * Never retry that number or infer a refund from later numeric reuse. */
+    qatomic_store_release(&record->disposition,
+                          result == 0 ? DESCRIPTOR_IDLE : DESCRIPTOR_UNCERTAIN);
+    errno = saved_errno;
+    return result;
+}
+
+int qemu_descriptor_close_owned(int fd, DescriptorRecord **owner)
+{
+    QemuCrucibleDescriptorTable *table = qatomic_load_acquire(&selected_table);
+    DescriptorRecord *record = NULL;
+    int status;
+    int result;
+    int saved_errno;
+
+    if (!table) {
+        return close(fd);
+    }
+    if (!owner || table->process != getpid() || !table->retained || !table->binding) {
+        errno = EPERM;
+        return -1;
+    }
+    status = pthread_mutex_lock(&table->lock);
+    if (status) {
+        errno = status;
+        return -1;
+    }
+    /* The issued field address selects its canonical generation before any
+     * nominated field is dereferenced. A local alias cannot consume the view. */
+    for (size_t index = 0; index < table->slots; index++) {
+        if (qatomic_load_acquire(&table->records[index].owner_holder) == owner) {
+            record = &table->records[index];
+            break;
+        }
+    }
+    if (!record || qatomic_load_acquire(&record->disposition) != DESCRIPTOR_LIVE ||
+        *owner != record || record->descriptor != fd ||
+        record->close_attempted) {
+        pthread_mutex_unlock(&table->lock);
+        errno = ESTALE;
+        return -1;
+    }
+    record->close_attempted = true;
+    record->disposition = DESCRIPTOR_CLOSING;
+    /* Transfer physical custody to the independently prepaid table escrow.
+     * This consumes the caller's field even if the ensuing close is negative;
+     * table state and signed result still retain the actual uncertainty. */
+    qatomic_store_release(&record->owner_holder, NULL);
+    *owner = NULL;
+    pthread_mutex_unlock(&table->lock);
+
+    result = close(fd);
+    saved_errno = errno;
+    record->close_result = result;
+    record->close_errno = saved_errno;
+    if (result < 0) {
+        qatomic_cmpxchg(&table->first_status, 0,
+                       saved_errno ? -saved_errno : -EIO);
+    }
+    qatomic_store_release(&record->disposition,
+                          result == 0 ? DESCRIPTOR_IDLE : DESCRIPTOR_UNCERTAIN);
+    errno = saved_errno;
+    return result;
+}
+
+int qemu_descriptor_socket(int domain, int type, int protocol)
+{
+    DescriptorRecord *record;
+    int fd;
+    int saved_errno;
+
+    if (!descriptor_begin(&record)) {
+        return -1;
+    }
+    fd = socket(domain, type, protocol);
+    saved_errno = errno;
+    descriptor_result(record, fd, saved_errno, true);
+    errno = saved_errno;
+    return fd;
+}
+
+int qemu_descriptor_accept(int input, struct sockaddr *address, socklen_t *length)
+{
+    DescriptorRecord *record;
+    int fd;
+    int saved_errno;
+
+    if (!descriptor_begin(&record)) {
+        return -1;
+    }
+    fd = accept(input, address, length);
+    saved_errno = errno;
+    descriptor_result(record, fd, saved_errno, true);
+    errno = saved_errno;
+    return fd;
+}
+
+#ifdef CONFIG_ACCEPT4
+int qemu_descriptor_accept4(int input, struct sockaddr *address, socklen_t *length,
+                            int flags)
+{
+    DescriptorRecord *record;
+    int fd;
+    int saved_errno;
+
+    if (!descriptor_begin(&record)) {
+        return -1;
+    }
+    fd = accept4(input, address, length, flags);
+    saved_errno = errno;
+    descriptor_result(record, fd, saved_errno, true);
+    errno = saved_errno;
+    return fd;
+}
+#endif
+
+int qemu_descriptor_socketpair(int domain, int type, int protocol, int out[2])
+{
+    QemuCrucibleDescriptorTable *table = qatomic_load_acquire(&selected_table);
+    DescriptorRecord *records[2] = { NULL, NULL };
+    int status;
+    int saved_errno;
+
+    if (table) {
+        status = descriptor_prepare(table, records, ARRAY_SIZE(records));
+        if (status) {
+            errno = -status;
+            return -1;
+        }
+    }
+    status = socketpair(domain, type, protocol, out);
+    saved_errno = errno;
+    for (size_t index = 0; index < ARRAY_SIZE(records); index++) {
+        descriptor_result(records[index], status ? -1 : out[index], saved_errno, true);
+    }
+    errno = saved_errno;
+    return status;
+}
+
+static int descriptor_set_cloexec(int fd)
+{
+    int flags = fcntl(fd, F_GETFD);
+
+    if (flags < 0 || fcntl(fd, F_SETFD, flags | FD_CLOEXEC) < 0) {
+        return -errno;
+    }
+    return 0;
+}
+
+static bool descriptor_pipe(int out[2], int flags, DescriptorRecord **owners[2])
+{
+    QemuCrucibleDescriptorTable *table = qatomic_load_acquire(&selected_table);
+    DescriptorRecord *records[2];
+    bool atomic_flags = false;
+    int status;
+    int saved_errno;
+
+    if (!table) {
+        return g_unix_open_pipe(out, flags, NULL);
+    }
+    if (flags != FD_CLOEXEC || (owners &&
+        (!owners[0] || !owners[1] || owners[0] == owners[1] ||
+         *owners[0] || *owners[1]))) {
+        errno = EINVAL;
+        return false;
+    }
+    status = descriptor_prepare(table, records, ARRAY_SIZE(records));
+    if (status) {
+        errno = -status;
+        return false;
+    }
+    if (owners) {
+        qatomic_store_release(&records[0]->owner_holder, owners[0]);
+        qatomic_store_release(&records[1]->owner_holder, owners[1]);
+    }
+#if defined(CONFIG_PIPE2) || defined(__linux__)
+    status = pipe2(out, O_CLOEXEC);
+    atomic_flags = status == 0;
+    if (status && (errno == ENOSYS || errno == EINVAL)) {
+        status = pipe(out);
+    }
+#else
+    status = pipe(out);
+#endif
+    saved_errno = errno;
+    for (size_t index = 0; index < ARRAY_SIZE(records); index++) {
+        descriptor_result(records[index], status ? -1 : out[index], saved_errno, true);
+    }
+    if (status) {
+        errno = saved_errno;
+        return false;
+    }
+    if (!atomic_flags) {
+        /* Both kernel outputs are already held. An actual fallback flag error
+         * closes each once; a negative close remains in its retained record. */
+        status = descriptor_set_cloexec(out[0]);
+        if (!status) {
+            status = descriptor_set_cloexec(out[1]);
+        }
+        if (status) {
+            if (owners) {
+                qemu_descriptor_close_owned(out[0], owners[0]);
+                qemu_descriptor_close_owned(out[1], owners[1]);
+            } else {
+                qemu_descriptor_close(out[0]);
+                qemu_descriptor_close(out[1]);
+            }
+            out[0] = -1;
+            out[1] = -1;
+            errno = -status;
+            return false;
+        }
+    }
+    errno = saved_errno;
+    return true;
+}
+
+bool qemu_descriptor_pipe(int out[2], int flags)
+{
+    return descriptor_pipe(out, flags, NULL);
+}
+
+bool qemu_descriptor_pipe_owned(int out[2], int flags, DescriptorRecord **owners[2])
+{
+    return descriptor_pipe(out, flags, owners);
+}
+
+#ifdef CONFIG_EVENTFD
+int qemu_descriptor_eventfd_owned(unsigned initial, int flags,
+                                  DescriptorRecord **owner)
+{
+    DescriptorRecord *record;
+    int fd;
+    int saved_errno;
+
+    if (!descriptor_begin_owned(&record, owner)) {
+        return -1;
+    }
+    fd = eventfd(initial, flags);
+    saved_errno = errno;
+    descriptor_result(record, fd, saved_errno, true);
+    errno = saved_errno;
+    return fd;
+}
+#endif
+
+#ifdef CONFIG_EVENTFD
+int qemu_descriptor_eventfd(unsigned initial, int flags)
+{
+    DescriptorRecord *record;
+    int fd;
+    int saved_errno;
+
+    if (!descriptor_begin(&record)) {
+        return -1;
+    }
+    fd = eventfd(initial, flags);
+    saved_errno = errno;
+    descriptor_result(record, fd, saved_errno, true);
+    errno = saved_errno;
+    return fd;
+}
+#endif
+
+int qemu_descriptor_mkstemp(char *path)
+{
+    DescriptorRecord *record;
+    int fd;
+    int saved_errno;
+
+    if (!descriptor_begin(&record)) {
+        return -1;
+    }
+    fd = mkstemp(path);
+    saved_errno = errno;
+    descriptor_result(record, fd, saved_errno, false);
+    errno = saved_errno;
+    return fd;
+}
+
+int qemu_descriptor_shm_open(const char *name, int flags, mode_t mode)
+{
+    DescriptorRecord *record;
+    int fd;
+    int saved_errno;
+
+    if (!descriptor_begin(&record)) {
+        return -1;
+    }
+    fd = shm_open(name, flags, mode);
+    saved_errno = errno;
+    descriptor_result(record, fd, saved_errno, false);
+    errno = saved_errno;
+    return fd;
+}
diff --git a/util/crucible-hot-fork-child.c b/util/crucible-hot-fork-child.c
new file mode 100644
index 0000000000000000000000000000000000000000..e7eee6cdc9d8a4c33a3545864fd8b1931a7d29ae
--- /dev/null
+++ b/util/crucible-hot-fork-child.c
@@ -0,0 +1,1303 @@
+/*
+ * Crucible hot-fork child resource disposition helpers
+ *
+ * Copyright (c) Andyl, Inc.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+
+#include <sys/prctl.h>
+#include <sys/syscall.h>
+
+#include "qemu/crucible-hot-fork-child.h"
+#include "qemu/aio.h"
+
+/* Composed description of the step and basis that last blocked a runtime. */
+static char qemu_crucible_hot_fork_runtime_blocker[320];
+
+/* Sub-step of the child resource plan application; see the header. */
+static unsigned int qemu_crucible_hot_fork_child_detail_value;
+
+void qemu_crucible_hot_fork_note_child_detail(unsigned int detail)
+{
+    qemu_crucible_hot_fork_child_detail_value = detail;
+}
+
+unsigned int qemu_crucible_hot_fork_child_detail(void)
+{
+    return qemu_crucible_hot_fork_child_detail_value;
+}
+
+const char *qemu_crucible_hot_fork_runtime_transaction_blocker(void)
+{
+    return qemu_crucible_hot_fork_runtime_blocker[0] ?
+        qemu_crucible_hot_fork_runtime_blocker : NULL;
+}
+
+static void qemu_crucible_hot_fork_note_runtime_blocker(
+    const char *step, const char *basis)
+{
+    snprintf(qemu_crucible_hot_fork_runtime_blocker,
+             sizeof(qemu_crucible_hot_fork_runtime_blocker), "%s: %s",
+             step, basis ? basis : "no basis reported");
+}
+
+static int qemu_crucible_hot_fork_begin_runtime_transaction_common(
+    QemuCrucibleHotForkRuntimeTransaction *transaction,
+    bool retain_parent_barriers, uint64_t expected_rcu_barrier_generation,
+    uint64_t expected_async_barrier_generation)
+{
+    int result;
+
+    if (!transaction || transaction->active || transaction->child_prepared ||
+        transaction->child_workers_started ||
+        transaction->child_reconstructed || transaction->rcu.active ||
+        transaction->async.active || transaction->registry.active) {
+        return -EINVAL;
+    }
+
+    result = retain_parent_barriers ?
+        qemu_rcu_hot_fork_begin_retained_transaction(
+            &transaction->rcu, expected_rcu_barrier_generation) :
+        qemu_rcu_hot_fork_begin_transaction(&transaction->rcu);
+    if (result < 0) {
+        qemu_crucible_hot_fork_note_runtime_blocker(
+            "RCU transaction", qemu_rcu_hot_fork_transaction_blocker());
+        return result;
+    }
+    if (retain_parent_barriers) {
+        result = qemu_async_worker_hot_fork_begin_retained_transaction(
+            &transaction->async, expected_async_barrier_generation);
+        if (result < 0) {
+            int release_result;
+
+            qemu_crucible_hot_fork_note_runtime_blocker(
+                "asynchronous-worker transaction",
+                "barrier is not retained and quiescent for this generation");
+            release_result =
+                qemu_rcu_hot_fork_release_parent_transaction(
+                    &transaction->rcu);
+
+            if (release_result == 0) {
+                transaction->rcu = (QemuRcuHotForkTransaction) { 0 };
+            }
+            return release_result < 0 ? release_result : result;
+        }
+    }
+    result = qemu_thread_hot_fork_begin_registry_transaction(
+        &transaction->registry);
+    if (result < 0) {
+        int async_result = 0;
+        int rcu_result;
+
+        qemu_crucible_hot_fork_note_runtime_blocker(
+            "thread registry transaction",
+            qemu_thread_hot_fork_registry_transaction_blocker());
+
+        if (retain_parent_barriers) {
+            async_result =
+                qemu_async_worker_hot_fork_release_parent_retained_transaction(
+                    &transaction->async);
+        }
+        rcu_result = qemu_rcu_hot_fork_release_parent_transaction(
+            &transaction->rcu);
+
+        if (async_result == 0 && rcu_result == 0) {
+            transaction->async =
+                (QemuAsyncWorkerHotForkRetainedTransaction) { 0 };
+            transaction->rcu = (QemuRcuHotForkTransaction) { 0 };
+        }
+        if (async_result < 0) {
+            return async_result;
+        }
+        return rcu_result < 0 ? rcu_result : result;
+    }
+
+    transaction->active = true;
+    transaction->async_retained = retain_parent_barriers;
+    return 0;
+}
+
+int qemu_crucible_hot_fork_begin_runtime_transaction(
+    QemuCrucibleHotForkRuntimeTransaction *transaction)
+{
+    return qemu_crucible_hot_fork_begin_runtime_transaction_common(
+        transaction, false, 0, 0);
+}
+
+int qemu_crucible_hot_fork_begin_retained_runtime_transaction(
+    QemuCrucibleHotForkRuntimeTransaction *transaction,
+    uint64_t expected_rcu_barrier_generation,
+    uint64_t expected_async_barrier_generation)
+{
+    if (expected_rcu_barrier_generation == 0 ||
+        expected_async_barrier_generation == 0) {
+        return -EINVAL;
+    }
+    return qemu_crucible_hot_fork_begin_runtime_transaction_common(
+        transaction, true, expected_rcu_barrier_generation,
+        expected_async_barrier_generation);
+}
+
+int qemu_crucible_hot_fork_release_parent_runtime_transaction(
+    QemuCrucibleHotForkRuntimeTransaction *transaction)
+{
+    int result;
+
+    if (!transaction || !transaction->active || transaction->child_prepared ||
+        transaction->child_workers_started ||
+        transaction->child_reconstructed ||
+        transaction->async_retained != transaction->async.active) {
+        return -EINVAL;
+    }
+
+    result = qemu_thread_hot_fork_release_parent_registry_transaction(
+        &transaction->registry);
+    if (result < 0) {
+        return result;
+    }
+    result = qemu_rcu_hot_fork_release_parent_transaction(&transaction->rcu);
+    if (result < 0) {
+        return result;
+    }
+    if (transaction->async_retained) {
+        result =
+            qemu_async_worker_hot_fork_release_parent_retained_transaction(
+                &transaction->async);
+        if (result < 0) {
+            return result;
+        }
+    }
+
+    transaction->active = false;
+    return 0;
+}
+
+int qemu_crucible_hot_fork_reconstruct_child_runtime(
+    QemuCrucibleHotForkRuntimeTransaction *transaction,
+    const QemuCrucibleHotForkDescriptorTableTransaction *descriptors)
+{
+    int result;
+
+    if (!transaction || !transaction->active ||
+        transaction->child_prepared || transaction->child_workers_started ||
+        transaction->child_reconstructed ||
+        transaction->async_retained != transaction->async.active ||
+        !descriptors || !descriptors->active ||
+        descriptors->descriptors_applied || descriptors->child_reinitialized ||
+        descriptors->mappings_verified || descriptors->parent_pid <= 1 ||
+        descriptors->parent_pid != transaction->rcu.parent_process_id ||
+        descriptors->child_pid != getpid()) {
+        return -EINVAL;
+    }
+
+    result = qemu_thread_hot_fork_reconstruct_child_registry(
+        &transaction->registry);
+    if (result < 0) {
+        return result;
+    }
+    result = qemu_rcu_hot_fork_prepare_child(&transaction->rcu);
+    if (result < 0) {
+        return result;
+    }
+
+    transaction->child_prepared = true;
+    return 0;
+}
+
+int qemu_crucible_hot_fork_start_child_runtime(
+    QemuCrucibleHotForkRuntimeTransaction *transaction,
+    const QemuCrucibleHotForkDescriptorTableTransaction *descriptors,
+    const int *retained_fds, size_t retained_fd_count)
+{
+    int result;
+
+    if (!transaction || !transaction->active ||
+        !transaction->child_prepared || transaction->child_workers_started ||
+        transaction->child_reconstructed ||
+        transaction->async_retained != transaction->async.active ||
+        !descriptors || descriptors->active ||
+        !descriptors->descriptors_applied ||
+        descriptors->child_reinitialized || descriptors->mappings_verified ||
+        descriptors->parent_pid != transaction->rcu.parent_process_id ||
+        descriptors->child_pid != getpid()) {
+        return -EINVAL;
+    }
+
+    if (transaction->async_retained) {
+        result = qemu_aio_hot_fork_reconstruct_child_epoll(
+            &transaction->async, retained_fds, retained_fd_count);
+        if (result < 0) {
+            return result;
+        }
+    }
+    result = qemu_rcu_hot_fork_start_child_worker(&transaction->rcu);
+    if (result < 0) {
+        return result;
+    }
+
+    transaction->child_workers_started = true;
+    return 0;
+}
+
+int qemu_crucible_hot_fork_finish_child_runtime(
+    QemuCrucibleHotForkRuntimeTransaction *transaction,
+    const QemuCrucibleHotForkDescriptorTableTransaction *descriptors)
+{
+    int result;
+
+    if (!transaction || !transaction->active ||
+        !transaction->child_prepared || !transaction->child_workers_started ||
+        transaction->child_reconstructed || !descriptors ||
+        descriptors->active || !descriptors->descriptors_applied ||
+        descriptors->child_reinitialized || descriptors->mappings_verified ||
+        descriptors->parent_pid != transaction->rcu.parent_process_id ||
+        descriptors->child_pid != getpid()) {
+        return -EINVAL;
+    }
+    if (transaction->async_retained != transaction->async.active) {
+        return -EPERM;
+    }
+
+    if (transaction->async_retained) {
+        result = qemu_async_worker_hot_fork_release_child_retained_transaction(
+            &transaction->async);
+        if (result < 0) {
+            return result;
+        }
+    }
+
+    transaction->active = false;
+    transaction->child_reconstructed = true;
+    return 0;
+}
+
+typedef struct QemuCrucibleHotForkSavedDescriptor {
+    int fd;
+    int target_fd;
+    int target_flags;
+} QemuCrucibleHotForkSavedDescriptor;
+
+static int crucible_hot_fork_pidfd_open(pid_t pid)
+{
+    return syscall(__NR_pidfd_open, pid, 0);
+}
+
+static int crucible_hot_fork_pidfd_probe(int pidfd)
+{
+    return syscall(__NR_pidfd_send_signal, pidfd, 0, NULL, 0);
+}
+
+static int crucible_hot_fork_close_range(unsigned int first,
+                                         unsigned int last)
+{
+    if (syscall(__NR_close_range, first, last, 0) < 0) {
+        return -errno;
+    }
+    return 0;
+}
+
+static int crucible_hot_fork_probe_close_range(void)
+{
+    return crucible_hot_fork_close_range(UINT_MAX, UINT_MAX);
+}
+
+static int crucible_hot_fork_block_child_signals(void)
+{
+    sigset_t blocked;
+
+    if (sigfillset(&blocked) < 0 ||
+        sigprocmask(SIG_SETMASK, &blocked, NULL) < 0) {
+        return -errno;
+    }
+    return 0;
+}
+
+int qemu_crucible_hot_fork_capture_parent_identity(
+    QemuCrucibleHotForkParentIdentity *identity)
+{
+    int pidfd;
+
+    if (!identity) {
+        return -EINVAL;
+    }
+    identity->parent_pid = -1;
+    identity->parent_pidfd = -1;
+
+    pidfd = crucible_hot_fork_pidfd_open(getpid());
+    if (pidfd < 0) {
+        return -errno;
+    }
+    if (fcntl(pidfd, F_GETFD) < 0) {
+        int result = -errno;
+
+        close(pidfd);
+        return result;
+    }
+
+    identity->parent_pid = getpid();
+    identity->parent_pidfd = pidfd;
+    return 0;
+}
+
+int qemu_crucible_hot_fork_authenticate_immediate_child(
+    const QemuCrucibleHotForkParentIdentity *identity)
+{
+    pid_t child_pid;
+
+    if (!identity || identity->parent_pid <= 1 ||
+        identity->parent_pidfd < 0) {
+        return -EINVAL;
+    }
+
+    child_pid = getpid();
+    if (child_pid == identity->parent_pid ||
+        getppid() != identity->parent_pid) {
+        return -EPERM;
+    }
+
+    if (prctl(PR_SET_PDEATHSIG, SIGKILL, 0, 0, 0) < 0) {
+        return -errno;
+    }
+    if (getppid() != identity->parent_pid) {
+        return -ESRCH;
+    }
+    if (crucible_hot_fork_pidfd_probe(identity->parent_pidfd) < 0) {
+        return -errno;
+    }
+    if (getppid() != identity->parent_pid) {
+        return -ESRCH;
+    }
+    return 0;
+}
+
+void qemu_crucible_hot_fork_release_parent_identity(
+    QemuCrucibleHotForkParentIdentity *identity)
+{
+    if (!identity) {
+        return;
+    }
+    if (identity->parent_pidfd >= 0) {
+        close(identity->parent_pidfd);
+    }
+    identity->parent_pid = -1;
+    identity->parent_pidfd = -1;
+}
+
+int qemu_crucible_hot_fork_adopt_child_as_parent(void)
+{
+    int signal = 0;
+
+    if (prctl(PR_GET_PDEATHSIG, &signal, 0, 0, 0) < 0) {
+        return -errno;
+    }
+    if (signal != SIGKILL) {
+        return -EPERM;
+    }
+    if (prctl(PR_SET_PDEATHSIG, 0, 0, 0, 0) < 0) {
+        return -errno;
+    }
+    return 0;
+}
+
+static int crucible_hot_fork_dup3_flags(int descriptor_flags)
+{
+    return (descriptor_flags & FD_CLOEXEC) != 0 ? O_CLOEXEC : 0;
+}
+
+static bool crucible_hot_fork_descriptor_replacement_table_is_valid(
+    const QemuCrucibleHotForkDescriptorReplacement *replacements,
+    size_t replacement_count)
+{
+    if (!replacements || replacement_count == 0 ||
+        replacement_count >
+            QEMU_CRUCIBLE_HOT_FORK_MAX_DESCRIPTOR_REPLACEMENTS) {
+        return false;
+    }
+
+    for (size_t index = 0; index < replacement_count; index++) {
+        int source = replacements[index].source_fd;
+        int target = replacements[index].target_fd;
+
+        if (source < 0 || target < 0 || source == target ||
+            fcntl(source, F_GETFD) < 0 || fcntl(target, F_GETFD) < 0 ||
+            (index > 0 && replacements[index - 1].target_fd >= target)) {
+            return false;
+        }
+        for (size_t other = 0; other < index; other++) {
+            if (source == replacements[other].source_fd ||
+                source == replacements[other].target_fd ||
+                target == replacements[other].source_fd) {
+                return false;
+            }
+        }
+    }
+    return true;
+}
+
+static bool crucible_hot_fork_restore_descriptors(
+    QemuCrucibleHotForkSavedDescriptor *saved,
+    size_t saved_count)
+{
+    bool complete = true;
+
+    for (size_t index = 0; index < saved_count; index++) {
+        if (saved[index].fd < 0) {
+            continue;
+        }
+        if (dup3(saved[index].fd, saved[index].target_fd,
+                 crucible_hot_fork_dup3_flags(saved[index].target_flags)) <
+            0) {
+            complete = false;
+        }
+    }
+    return complete;
+}
+
+int qemu_crucible_hot_fork_replace_descriptor_set(
+    const QemuCrucibleHotForkDescriptorReplacement *replacements,
+    size_t replacement_count,
+    QemuCrucibleHotForkDescriptorVerifier verify,
+    void *opaque)
+{
+    QemuCrucibleHotForkSavedDescriptor
+        saved[QEMU_CRUCIBLE_HOT_FORK_MAX_DESCRIPTOR_REPLACEMENTS];
+    size_t saved_count = 0;
+    int result = 0;
+
+    if (!replacements || !verify ||
+        !crucible_hot_fork_descriptor_replacement_table_is_valid(
+            replacements, replacement_count)) {
+        return -EINVAL;
+    }
+
+    for (size_t index = 0; index < replacement_count; index++) {
+        saved[index] = (QemuCrucibleHotForkSavedDescriptor) { .fd = -1 };
+        saved[index].target_fd = replacements[index].target_fd;
+        saved[index].target_flags =
+            fcntl(replacements[index].target_fd, F_GETFD);
+        if (saved[index].target_flags < 0) {
+            result = -errno;
+            goto out;
+        }
+        saved[index].fd = fcntl(replacements[index].target_fd,
+                                F_DUPFD_CLOEXEC, 3);
+        if (saved[index].fd < 0) {
+            result = -errno;
+            goto out;
+        }
+        saved_count++;
+    }
+
+    for (size_t index = 0; index < replacement_count; index++) {
+        if (dup3(replacements[index].source_fd,
+                 replacements[index].target_fd,
+                 crucible_hot_fork_dup3_flags(saved[index].target_flags)) <
+            0) {
+            result = -errno;
+            goto rollback;
+        }
+    }
+
+    result = verify(opaque);
+    if (result != 0) {
+        if (result > 0 || result == -EUCLEAN) {
+            result = -EPROTO;
+        }
+        goto rollback;
+    }
+
+    for (size_t index = 0; index < replacement_count; index++) {
+        close(replacements[index].source_fd);
+    }
+    goto out;
+
+rollback:
+    if (!crucible_hot_fork_restore_descriptors(saved, saved_count)) {
+        result = -EUCLEAN;
+    }
+out:
+    for (size_t index = 0; index < saved_count; index++) {
+        if (saved[index].fd >= 0) {
+            close(saved[index].fd);
+        }
+    }
+    return result;
+}
+
+int qemu_crucible_hot_fork_replace_endpoint_descriptors(
+    const QemuCrucibleHotForkDescriptorReplacement replacements[2],
+    QemuCrucibleHotForkDescriptorVerifier verify,
+    void *opaque)
+{
+    QemuCrucibleHotForkDescriptorReplacement canonical[2];
+
+    if (!replacements) {
+        return -EINVAL;
+    }
+    canonical[0] = replacements[0];
+    canonical[1] = replacements[1];
+    if (canonical[0].target_fd > canonical[1].target_fd) {
+        QemuCrucibleHotForkDescriptorReplacement temporary = canonical[0];
+
+        canonical[0] = canonical[1];
+        canonical[1] = temporary;
+    }
+    return qemu_crucible_hot_fork_replace_descriptor_set(
+        canonical, QEMU_CRUCIBLE_HOT_FORK_ENDPOINT_REPLACEMENT_COUNT,
+        verify, opaque);
+}
+
+static int crucible_hot_fork_accept_descriptor_replacements(void *opaque)
+{
+    (void)opaque;
+    return 0;
+}
+
+static bool crucible_hot_fork_retained_table_is_valid(
+    const QemuCrucibleHotForkDescriptorReplacement *replacements,
+    size_t replacement_count,
+    const int *retained_fds,
+    size_t retained_fd_count)
+{
+    if (!replacements || !retained_fds || retained_fd_count == 0 ||
+        retained_fd_count >
+            QEMU_CRUCIBLE_HOT_FORK_MAX_RETAINED_DESCRIPTORS ||
+        !crucible_hot_fork_descriptor_replacement_table_is_valid(
+            replacements, replacement_count)) {
+        return false;
+    }
+
+    for (size_t index = 0; index < retained_fd_count; index++) {
+        int fd = retained_fds[index];
+
+        if (fd < 0 || fcntl(fd, F_GETFD) < 0 ||
+            (index > 0 && retained_fds[index - 1] >= fd)) {
+            return false;
+        }
+        for (size_t replacement = 0; replacement < replacement_count;
+             replacement++) {
+            if (fd == replacements[replacement].source_fd) {
+                return false;
+            }
+        }
+    }
+    for (size_t replacement = 0; replacement < replacement_count;
+         replacement++) {
+        bool target_present = false;
+
+        for (size_t index = 0; index < retained_fd_count; index++) {
+            if (retained_fds[index] == replacements[replacement].target_fd) {
+                target_present = true;
+                break;
+            }
+            if (retained_fds[index] > replacements[replacement].target_fd) {
+                break;
+            }
+        }
+        if (!target_present) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static int crucible_hot_fork_close_outside_table(const int *retained_fds,
+                                                  size_t retained_fd_count)
+{
+    unsigned int first = 0;
+
+    for (size_t index = 0; index < retained_fd_count; index++) {
+        unsigned int retained = retained_fds[index];
+        int result;
+
+        if (first < retained) {
+            result = crucible_hot_fork_close_range(first, retained - 1);
+            if (result != 0) {
+                return result;
+            }
+        }
+        first = retained + 1;
+    }
+    return crucible_hot_fork_close_range(first, UINT_MAX);
+}
+
+int qemu_crucible_hot_fork_begin_descriptor_table(
+    QemuCrucibleHotForkParentIdentity *identity,
+    QemuCrucibleHotForkDescriptorTableTransaction *transaction)
+{
+    pid_t parent_pid;
+    int result;
+
+    if (!identity || !transaction) {
+        return -EINVAL;
+    }
+    transaction->parent_pid = -1;
+    transaction->child_pid = -1;
+    transaction->active = false;
+    transaction->descriptors_applied = false;
+    transaction->child_reinitialized = false;
+    transaction->mappings_verified = false;
+
+    result = crucible_hot_fork_probe_close_range();
+    if (result != 0) {
+        return result;
+    }
+    result = qemu_crucible_hot_fork_authenticate_immediate_child(identity);
+    if (result != 0) {
+        return result;
+    }
+
+    parent_pid = identity->parent_pid;
+    result = crucible_hot_fork_block_child_signals();
+    qemu_crucible_hot_fork_release_parent_identity(identity);
+    if (result != 0) {
+        return result;
+    }
+
+    transaction->parent_pid = parent_pid;
+    transaction->child_pid = getpid();
+    transaction->active = true;
+    transaction->descriptors_applied = false;
+    transaction->child_reinitialized = false;
+    transaction->mappings_verified = false;
+    return 0;
+}
+
+int qemu_crucible_hot_fork_apply_descriptor_table(
+    QemuCrucibleHotForkDescriptorTableTransaction *transaction,
+    const QemuCrucibleHotForkDescriptorReplacement *replacements,
+    size_t replacement_count,
+    const int *retained_fds,
+    size_t retained_fd_count,
+    QemuCrucibleHotForkDescriptorVerifier verify,
+    void *opaque)
+{
+    int result;
+
+    if (!transaction) {
+        return -EINVAL;
+    }
+    if (!transaction->active || transaction->parent_pid <= 1 ||
+        transaction->child_pid != getpid()) {
+        return -EPERM;
+    }
+    if (!verify || !crucible_hot_fork_retained_table_is_valid(
+                       replacements, replacement_count,
+                       retained_fds, retained_fd_count)) {
+        return -EINVAL;
+    }
+
+    transaction->active = false;
+    transaction->descriptors_applied = false;
+    transaction->child_reinitialized = false;
+    transaction->mappings_verified = false;
+    result = qemu_crucible_hot_fork_replace_descriptor_set(
+        replacements, replacement_count,
+        crucible_hot_fork_accept_descriptor_replacements, NULL);
+    if (result != 0) {
+        return result;
+    }
+    result = crucible_hot_fork_close_outside_table(retained_fds,
+                                                   retained_fd_count);
+    if (result != 0) {
+        return result;
+    }
+    for (size_t index = 0; index < retained_fd_count; index++) {
+        if (fcntl(retained_fds[index], F_GETFD) < 0) {
+            return -errno;
+        }
+    }
+
+    result = verify(opaque);
+    if (result > 0 || result == -EUCLEAN) {
+        return -EPROTO;
+    }
+    if (result == 0) {
+        transaction->descriptors_applied = true;
+    }
+    return result;
+}
+
+static bool crucible_hot_fork_parse_hex(const char *bytes, size_t length,
+                                        uint64_t *value)
+{
+    uint64_t parsed = 0;
+
+    if (length == 0) {
+        return false;
+    }
+    for (size_t index = 0; index < length; index++) {
+        unsigned int digit;
+
+        if (bytes[index] >= '0' && bytes[index] <= '9') {
+            digit = bytes[index] - '0';
+        } else if (bytes[index] >= 'a' && bytes[index] <= 'f') {
+            digit = bytes[index] - 'a' + 10;
+        } else if (bytes[index] >= 'A' && bytes[index] <= 'F') {
+            digit = bytes[index] - 'A' + 10;
+        } else {
+            return false;
+        }
+        if (parsed > (UINT64_MAX - digit) / 16) {
+            return false;
+        }
+        parsed = parsed * 16 + digit;
+    }
+    *value = parsed;
+    return true;
+}
+
+static bool crucible_hot_fork_parse_decimal(const char *bytes, size_t length,
+                                            uint64_t *value)
+{
+    uint64_t parsed = 0;
+
+    if (length == 0) {
+        return false;
+    }
+    for (size_t index = 0; index < length; index++) {
+        unsigned int digit;
+
+        if (bytes[index] < '0' || bytes[index] > '9') {
+            return false;
+        }
+        digit = bytes[index] - '0';
+        if (parsed > (UINT64_MAX - digit) / 10) {
+            return false;
+        }
+        parsed = parsed * 10 + digit;
+    }
+    *value = parsed;
+    return true;
+}
+
+static const char *crucible_hot_fork_next_mapping_field(
+    const char *cursor, const char *record_end, const char **field_end)
+{
+    while (cursor < record_end && *cursor == ' ') {
+        cursor++;
+    }
+    if (cursor == record_end) {
+        return NULL;
+    }
+    *field_end = memchr(cursor, ' ', record_end - cursor);
+    if (!*field_end) {
+        *field_end = record_end;
+    }
+    return cursor;
+}
+
+static int crucible_hot_fork_parse_mapping_record(
+    const char *record,
+    size_t length,
+    uint64_t *start,
+    uint64_t *mapping_length,
+    uint64_t *offset,
+    uint64_t *device_major,
+    uint64_t *device_minor,
+    uint64_t *inode,
+    bool *writable_shared)
+{
+    const char *range_end = memchr(record, ' ', length);
+    const char *separator;
+    const char *permissions;
+    const char *permissions_end;
+    const char *offset_start;
+    const char *offset_end;
+    const char *device_start;
+    const char *device_end;
+    const char *device_separator;
+    const char *inode_start;
+    const char *inode_end;
+    const char *record_end = record + length;
+    uint64_t end;
+
+    if (!range_end || range_end == record) {
+        return -EPROTO;
+    }
+    separator = memchr(record, '-', range_end - record);
+    if (!separator || separator == record || separator + 1 == range_end ||
+        !crucible_hot_fork_parse_hex(record, separator - record, start) ||
+        !crucible_hot_fork_parse_hex(separator + 1,
+                                     range_end - separator - 1, &end) ||
+        *start >= end) {
+        return -EPROTO;
+    }
+
+    permissions = crucible_hot_fork_next_mapping_field(
+        range_end, record_end, &permissions_end);
+    if (!permissions || permissions_end - permissions != 4 ||
+        (permissions[0] != 'r' && permissions[0] != '-') ||
+        (permissions[1] != 'w' && permissions[1] != '-') ||
+        (permissions[2] != 'x' && permissions[2] != '-') ||
+        (permissions[3] != 'p' && permissions[3] != 's')) {
+        return -EPROTO;
+    }
+
+    offset_start = crucible_hot_fork_next_mapping_field(
+        permissions_end, record_end, &offset_end);
+    device_start = offset_start ? crucible_hot_fork_next_mapping_field(
+        offset_end, record_end, &device_end) : NULL;
+    device_separator = device_start ? memchr(
+        device_start, ':', device_end - device_start) : NULL;
+    inode_start = device_start ? crucible_hot_fork_next_mapping_field(
+        device_end, record_end, &inode_end) : NULL;
+    if (!offset_start || !device_start || !device_separator ||
+        device_separator == device_start ||
+        device_separator + 1 == device_end ||
+        !inode_start || !crucible_hot_fork_parse_hex(
+            offset_start, offset_end - offset_start, offset) ||
+        !crucible_hot_fork_parse_hex(
+            device_start, device_separator - device_start, device_major) ||
+        !crucible_hot_fork_parse_hex(
+            device_separator + 1, device_end - device_separator - 1,
+            device_minor) ||
+        !crucible_hot_fork_parse_decimal(
+            inode_start, inode_end - inode_start, inode)) {
+        return -EPROTO;
+    }
+
+    *mapping_length = end - *start;
+    *writable_shared = permissions[1] == 'w' && permissions[3] == 's';
+    return 0;
+}
+
+static bool crucible_hot_fork_shared_mapping_table_is_valid(
+    const QemuCrucibleHotForkSharedMapping *mappings,
+    size_t mapping_count)
+{
+    uint64_t prior_end = 0;
+    uint64_t page_size = qemu_real_host_page_size();
+
+    if ((mapping_count != 0 && !mappings) ||
+        mapping_count > QEMU_CRUCIBLE_HOT_FORK_MAX_SHARED_MAPPINGS ||
+        page_size == 0) {
+        return false;
+    }
+    for (size_t index = 0; index < mapping_count; index++) {
+        struct stat backing;
+        uint64_t backing_pages;
+        uint64_t end;
+        int seals;
+
+        if (mappings[index].backing_fd < 0 ||
+            mappings[index].length == 0 ||
+            mappings[index].start % page_size != 0 ||
+            mappings[index].length % page_size != 0 ||
+            mappings[index].offset % page_size != 0 ||
+            mappings[index].start > UINT64_MAX - mappings[index].length ||
+            mappings[index].offset > UINT64_MAX - mappings[index].length ||
+            fstat(mappings[index].backing_fd, &backing) < 0 ||
+            !S_ISREG(backing.st_mode) || backing.st_size < 0 ||
+            (uint64_t)backing.st_size > UINT64_MAX - (page_size - 1)) {
+            return false;
+        }
+        /*
+         * Protocol regions carry exact lengths while the VMA that maps them
+         * spans whole pages, so a mapping may end inside the backing's final
+         * partial page; the kernel zero-fills that tail.  It may not extend
+         * past that page.
+         */
+        backing_pages = QEMU_ALIGN_UP((uint64_t)backing.st_size, page_size);
+        if (mappings[index].offset + mappings[index].length > backing_pages) {
+            return false;
+        }
+        seals = fcntl(mappings[index].backing_fd, F_GET_SEALS);
+        if (seals < 0 || (seals & F_SEAL_SHRINK) == 0) {
+            return false;
+        }
+        end = mappings[index].start + mappings[index].length;
+        if (index > 0 && mappings[index].start < prior_end) {
+            return false;
+        }
+        prior_end = end;
+    }
+    return true;
+}
+
+static bool crucible_hot_fork_mapping_backings_are_retained(
+    const QemuCrucibleHotForkSharedMapping *mappings,
+    size_t mapping_count,
+    const int *retained_fds,
+    size_t retained_fd_count)
+{
+    for (size_t mapping = 0; mapping < mapping_count; mapping++) {
+        size_t lower = 0;
+        size_t upper = retained_fd_count;
+
+        while (lower < upper) {
+            size_t middle = lower + (upper - lower) / 2;
+
+            if (retained_fds[middle] < mappings[mapping].backing_fd) {
+                lower = middle + 1;
+            } else {
+                upper = middle;
+            }
+        }
+        if (lower == retained_fd_count ||
+            retained_fds[lower] != mappings[mapping].backing_fd) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static int crucible_hot_fork_match_mapping_record(
+    const char *record,
+    size_t length,
+    const QemuCrucibleHotForkSharedMapping *mappings,
+    size_t mapping_count,
+    size_t *mapping_index)
+{
+    struct stat backing;
+    uint64_t start;
+    uint64_t mapping_length;
+    uint64_t offset;
+    uint64_t device_major;
+    uint64_t device_minor;
+    uint64_t inode;
+    bool writable_shared;
+    int result = crucible_hot_fork_parse_mapping_record(
+        record, length, &start, &mapping_length, &offset, &device_major,
+        &device_minor, &inode, &writable_shared);
+
+    if (result != 0 || !writable_shared) {
+        return result;
+    }
+    if (*mapping_index >= mapping_count ||
+        mappings[*mapping_index].start != start ||
+        mappings[*mapping_index].length != mapping_length ||
+        mappings[*mapping_index].offset != offset) {
+        return -EPERM;
+    }
+    if (fstat(mappings[*mapping_index].backing_fd, &backing) < 0) {
+        return -errno;
+    }
+    if (device_major > UINT_MAX || device_minor > UINT_MAX ||
+        major(backing.st_dev) != device_major ||
+        minor(backing.st_dev) != device_minor ||
+        (uint64_t)backing.st_ino != inode) {
+        return -EPERM;
+    }
+    (*mapping_index)++;
+    return 0;
+}
+
+static int crucible_hot_fork_scan_mapping_table(
+    const QemuCrucibleHotForkSharedMapping *mappings,
+    size_t mapping_count)
+{
+    char input[4096];
+    char record[QEMU_CRUCIBLE_HOT_FORK_MAX_MAPPING_RECORD_BYTES];
+    size_t mapping_index = 0;
+    size_t record_count = 0;
+    size_t record_length = 0;
+    size_t total_bytes = 0;
+    int maps_fd;
+    int result = 0;
+
+    maps_fd = open("/proc/self/maps", O_RDONLY | O_CLOEXEC);
+    if (maps_fd < 0) {
+        return -errno;
+    }
+    for (;;) {
+        ssize_t length = read(maps_fd, input, sizeof(input));
+
+        if (length < 0) {
+            if (errno == EINTR) {
+                continue;
+            }
+            result = -errno;
+            break;
+        }
+        if (length == 0) {
+            if (record_length != 0) {
+                record_count++;
+                if (record_count >
+                    QEMU_CRUCIBLE_HOT_FORK_MAX_MAPPING_RECORDS) {
+                    result = -E2BIG;
+                } else {
+                    result = crucible_hot_fork_match_mapping_record(
+                        record, record_length, mappings, mapping_count,
+                        &mapping_index);
+                }
+            }
+            break;
+        }
+        if ((size_t)length >
+            QEMU_CRUCIBLE_HOT_FORK_MAX_MAPPING_BYTES - total_bytes) {
+            result = -E2BIG;
+            break;
+        }
+        total_bytes += length;
+
+        for (ssize_t index = 0; index < length; index++) {
+            if (input[index] == '\n') {
+                record_count++;
+                if (record_count >
+                    QEMU_CRUCIBLE_HOT_FORK_MAX_MAPPING_RECORDS) {
+                    result = -E2BIG;
+                    break;
+                }
+                result = crucible_hot_fork_match_mapping_record(
+                    record, record_length, mappings, mapping_count,
+                    &mapping_index);
+                record_length = 0;
+                if (result != 0) {
+                    break;
+                }
+            } else {
+                if (record_length == sizeof(record)) {
+                    result = -E2BIG;
+                    break;
+                }
+                record[record_length++] = input[index];
+            }
+        }
+        if (result != 0) {
+            break;
+        }
+    }
+    if (close(maps_fd) < 0 && result == 0) {
+        result = -errno;
+    }
+    if (result == 0 && (record_count == 0 || mapping_index != mapping_count)) {
+        result = -EPERM;
+    }
+    return result;
+}
+
+typedef struct QemuCrucibleHotForkSourceMappingSearch {
+    uint64_t device_major;
+    uint64_t device_minor;
+    uint64_t inode;
+    uint64_t length;
+    QemuCrucibleHotForkSourceMapping mapping;
+    bool found;
+} QemuCrucibleHotForkSourceMappingSearch;
+
+static int crucible_hot_fork_match_source_mapping(
+    const char *record,
+    size_t record_length,
+    QemuCrucibleHotForkSourceMappingSearch *search)
+{
+    uint64_t start;
+    uint64_t mapping_length;
+    uint64_t offset;
+    uint64_t device_major;
+    uint64_t device_minor;
+    uint64_t inode;
+    bool writable_shared;
+    int result = crucible_hot_fork_parse_mapping_record(
+        record, record_length, &start, &mapping_length, &offset,
+        &device_major, &device_minor, &inode, &writable_shared);
+
+    if (result != 0 || !writable_shared ||
+        device_major != search->device_major ||
+        device_minor != search->device_minor || inode != search->inode) {
+        return result;
+    }
+    if (search->found || offset != 0 || mapping_length != search->length) {
+        return -EPERM;
+    }
+    search->mapping.start = start;
+    search->mapping.length = mapping_length;
+    search->mapping.offset = offset;
+    search->found = true;
+    return 0;
+}
+
+int qemu_crucible_hot_fork_find_source_mapping(
+    uint64_t device,
+    uint64_t inode,
+    uint64_t length,
+    QemuCrucibleHotForkSourceMapping *mapping)
+{
+    char input[4096];
+    char record[QEMU_CRUCIBLE_HOT_FORK_MAX_MAPPING_RECORD_BYTES];
+    QemuCrucibleHotForkSourceMappingSearch search = {
+        .inode = inode,
+        .length = length,
+    };
+    size_t record_count = 0;
+    size_t record_length = 0;
+    size_t total_bytes = 0;
+    uint64_t page_size = qemu_real_host_page_size();
+    int maps_fd;
+    int result = 0;
+
+    if (!mapping || (uint64_t)(dev_t)device != device || inode == 0 ||
+        length == 0 || page_size == 0 ||
+        length > UINT64_MAX - (page_size - 1)) {
+        return -EINVAL;
+    }
+    /*
+     * The protocol region length is exact; the kernel maps whole pages, so
+     * the VMA that carries it spans the page-rounded extent.
+     */
+    search.length = QEMU_ALIGN_UP(length, page_size);
+    search.device_major = major((dev_t)device);
+    search.device_minor = minor((dev_t)device);
+    memset(mapping, 0, sizeof(*mapping));
+
+    maps_fd = open("/proc/self/maps", O_RDONLY | O_CLOEXEC);
+    if (maps_fd < 0) {
+        return -errno;
+    }
+    for (;;) {
+        ssize_t input_length = read(maps_fd, input, sizeof(input));
+
+        if (input_length < 0) {
+            if (errno == EINTR) {
+                continue;
+            }
+            result = -errno;
+            break;
+        }
+        if (input_length == 0) {
+            if (record_length != 0) {
+                record_count++;
+                if (record_count >
+                    QEMU_CRUCIBLE_HOT_FORK_MAX_MAPPING_RECORDS) {
+                    result = -E2BIG;
+                } else {
+                    result = crucible_hot_fork_match_source_mapping(
+                        record, record_length, &search);
+                }
+            }
+            break;
+        }
+        if ((size_t)input_length >
+            QEMU_CRUCIBLE_HOT_FORK_MAX_MAPPING_BYTES - total_bytes) {
+            result = -E2BIG;
+            break;
+        }
+        total_bytes += input_length;
+
+        for (ssize_t index = 0; index < input_length; index++) {
+            if (input[index] == '\n') {
+                record_count++;
+                if (record_count >
+                    QEMU_CRUCIBLE_HOT_FORK_MAX_MAPPING_RECORDS) {
+                    result = -E2BIG;
+                    break;
+                }
+                result = crucible_hot_fork_match_source_mapping(
+                    record, record_length, &search);
+                record_length = 0;
+                if (result != 0) {
+                    break;
+                }
+            } else {
+                if (record_length == sizeof(record)) {
+                    result = -E2BIG;
+                    break;
+                }
+                record[record_length++] = input[index];
+            }
+        }
+        if (result != 0) {
+            break;
+        }
+    }
+    if (close(maps_fd) < 0 && result == 0) {
+        result = -errno;
+    }
+    if (result == 0 && !search.found) {
+        result = -EPERM;
+    }
+    if (result == 0) {
+        *mapping = search.mapping;
+    }
+    return result;
+}
+
+int qemu_crucible_hot_fork_verify_mapping_table(
+    QemuCrucibleHotForkDescriptorTableTransaction *transaction,
+    const QemuCrucibleHotForkSharedMapping *shared_mappings,
+    size_t shared_mapping_count)
+{
+    int result;
+
+    if (!transaction) {
+        return -EINVAL;
+    }
+    if (transaction->active || !transaction->descriptors_applied ||
+        transaction->mappings_verified || transaction->parent_pid <= 1 ||
+        transaction->child_pid != getpid()) {
+        return -EPERM;
+    }
+    if (!crucible_hot_fork_shared_mapping_table_is_valid(
+            shared_mappings, shared_mapping_count)) {
+        return -EINVAL;
+    }
+
+    transaction->descriptors_applied = false;
+    result = crucible_hot_fork_scan_mapping_table(shared_mappings,
+                                                  shared_mapping_count);
+    if (result == 0) {
+        transaction->descriptors_applied = true;
+        transaction->mappings_verified = true;
+    }
+    return result;
+}
+
+int qemu_crucible_hot_fork_apply_child_resources(
+    QemuCrucibleHotForkDescriptorTableTransaction *transaction,
+    const QemuCrucibleHotForkDescriptorReplacement *replacements,
+    size_t replacement_count,
+    const int *retained_fds,
+    size_t retained_fd_count,
+    QemuCrucibleHotForkDescriptorVerifier verify_descriptors,
+    void *descriptor_opaque,
+    QemuCrucibleHotForkChildReinitializer reinitialize,
+    void *reinitialize_opaque,
+    const QemuCrucibleHotForkSharedMapping *shared_mappings,
+    size_t shared_mapping_count)
+{
+    int result;
+
+    if (!transaction) {
+        return -EINVAL;
+    }
+    if (!transaction->active || transaction->parent_pid <= 1 ||
+        transaction->child_pid != getpid()) {
+        return -EPERM;
+    }
+    if (!verify_descriptors || !reinitialize ||
+        !crucible_hot_fork_retained_table_is_valid(
+            replacements, replacement_count, retained_fds,
+            retained_fd_count) ||
+        !crucible_hot_fork_shared_mapping_table_is_valid(
+            shared_mappings, shared_mapping_count) ||
+        !crucible_hot_fork_mapping_backings_are_retained(
+            shared_mappings, shared_mapping_count,
+            retained_fds, retained_fd_count)) {
+        return -EINVAL;
+    }
+
+    qemu_crucible_hot_fork_note_child_detail(2);
+    result = qemu_crucible_hot_fork_apply_descriptor_table(
+        transaction, replacements, replacement_count,
+        retained_fds, retained_fd_count,
+        verify_descriptors, descriptor_opaque);
+    if (result != 0) {
+        return result;
+    }
+
+    result = reinitialize(reinitialize_opaque);
+    if (result > 0 || result == -EUCLEAN) {
+        result = -EPROTO;
+    }
+    if (result != 0) {
+        transaction->descriptors_applied = false;
+        return result;
+    }
+    transaction->child_reinitialized = true;
+
+    qemu_crucible_hot_fork_note_child_detail(8);
+    return qemu_crucible_hot_fork_verify_mapping_table(
+        transaction, shared_mappings, shared_mapping_count);
+}
