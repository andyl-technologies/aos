+        (void)c;                                                             \
+        (void)a;                                                             \
+        (void)v;                                                             \
+        (void)attrs;                                                         \
+        (void)r;                                                             \
+                                                                             \
+        abort();                                                             \
+    }                                                                        \
+                                                                             \
+    static void address_space_st##size##_be_cached_slow(                     \
+        const MemoryRegionCache *c, hwaddr a, type v,                        \
+        MemTxAttrs attrs, MemTxResult *r)                                    \
+    {                                                                        \
+        (void)c;                                                             \
+        (void)a;                                                             \
+        (void)v;                                                             \
+        (void)attrs;                                                         \
+        (void)r;                                                             \
+                                                                             \
+        abort();                                                             \
+    }
+
