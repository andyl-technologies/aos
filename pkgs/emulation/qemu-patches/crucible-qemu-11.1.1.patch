+
+static CrucibleMemoryReservedCounters *node_memory_reserved_counter(
+    QemuCrucibleFaultRule *rule, bool create)
+{
+    CrucibleMemoryReservedCounters *reserved;
+
+    if (!crucible_memory_reserved_counters) {
+        if (!create) {
+            return NULL;
+        }
+        crucible_memory_reserved_counters = g_hash_table_new_full(
+            g_direct_hash, g_direct_equal, NULL, g_free);
+    }
+    reserved = g_hash_table_lookup(crucible_memory_reserved_counters, rule);
+    if (!reserved && create) {
+        reserved = g_new0(CrucibleMemoryReservedCounters, 1);
+        g_hash_table_insert(crucible_memory_reserved_counters,
+                            rule, reserved);
+    }
+    return reserved;
+}
+
+static CrucibleMemoryReservedRows *node_memory_reserved_row_set(
+    QemuCrucibleFaultRule *rule, bool create)
+{
+    CrucibleMemoryReservedRows *rows;
+
+    if (!crucible_memory_reserved_rows) {
+        if (!create) {
+            return NULL;
+        }
+        crucible_memory_reserved_rows = g_hash_table_new_full(
+            g_direct_hash, g_direct_equal, NULL,
+            node_memory_reserved_rows_free);
+    }
+    rows = g_hash_table_lookup(crucible_memory_reserved_rows, rule);
+    if (!rows && create) {
+        rows = g_new0(CrucibleMemoryReservedRows, 1);
+        rows->coordinates = g_hash_table_new_full(
+            node_dram_coordinate_hash, node_dram_coordinate_equal,
+            g_free, g_free);
+        g_hash_table_insert(crucible_memory_reserved_rows, rule, rows);
+    }
+    return rows;
+}
+
+static uint64_t node_memory_reserved_row_count(
+    QemuCrucibleFaultRule *rule,
+    const CrucibleDramCoordinate *coordinate)
+{
+    CrucibleMemoryReservedRows *rows = node_memory_reserved_row_set(
+        rule, false);
+    uint64_t *count = rows ?
+        g_hash_table_lookup(rows->coordinates, coordinate) : NULL;
+
+    return count ? *count : 0;
+}
+
+static CrucibleMemoryReservedRetention *
+node_memory_reserved_retention_set(QemuCrucibleFaultRule *rule,
+                                   bool create)
+{
+    CrucibleMemoryReservedRetention *retention;
+
+    if (!crucible_memory_reserved_retention) {
+        if (!create) {
+            return NULL;
+        }
+        crucible_memory_reserved_retention = g_hash_table_new_full(
+            g_direct_hash, g_direct_equal, NULL,
+            node_memory_reserved_retention_free);
+    }
+    retention = g_hash_table_lookup(
+        crucible_memory_reserved_retention, rule);
+    if (!retention && create) {
+        retention = g_new0(CrucibleMemoryReservedRetention, 1);
+        retention->offsets = g_hash_table_new_full(
+            g_int64_hash, g_int64_equal, g_free, g_free);
+        g_hash_table_insert(crucible_memory_reserved_retention,
+                            rule, retention);
+    }
+    return retention;
+}
+
+static uint64_t node_memory_reserved_retention_count(
+    QemuCrucibleFaultRule *rule, uint64_t offset)
+{
+    CrucibleMemoryReservedRetention *retention =
+        node_memory_reserved_retention_set(rule, false);
+    uint64_t *count = retention ?
+        g_hash_table_lookup(retention->offsets, &offset) : NULL;
+
+    return count ? *count : 0;
+}
+
+static uint64_t node_memory_reserved_ledger(
+    CrucibleMemoryServiceLedger *ledger)
+{
+    uint64_t *reserved = crucible_memory_reserved_ledgers ?
+        g_hash_table_lookup(crucible_memory_reserved_ledgers, ledger) : NULL;
+
+    return reserved ? *reserved : 0;
+}
+
+static bool node_memory_rule_resources_ready(
+    QemuCrucibleFaultRule *rule)
+{
+    CrucibleMemoryReservedCounters *reserved =
+        node_memory_reserved_counter(rule, false);
+    uint64_t opportunities = reserved ? reserved->opportunities : 0;
+    uint64_t applied = reserved ? reserved->applied : 0;
+
+    return opportunities != UINT64_MAX && applied != UINT64_MAX &&
+           rule->opportunity_count <= UINT64_MAX - opportunities - 1 &&
+           rule->applied_count <= UINT64_MAX - applied - 1;
+}
+
+static void node_memory_rule_reservation_release(
+    CrucibleMemoryRuleReservation *reservation, bool opportunity)
+{
+    CrucibleMemoryReservedCounters *reserved;
+    bool *active = opportunity ? &reservation->opportunity :
+                                 &reservation->applied;
+    uint64_t *count;
+
+    if (!*active) {
+        return;
+    }
+    reserved = node_memory_reserved_counter(reservation->rule, false);
+    g_assert(reserved);
+    count = opportunity ? &reserved->opportunities : &reserved->applied;
+    g_assert(*count != 0);
+    (*count)--;
+    *active = false;
+    if (reserved->opportunities == 0 && reserved->applied == 0) {
+        g_hash_table_remove(crucible_memory_reserved_counters,
+                            reservation->rule);
+    }
+}
+
+static void node_memory_rule_reservation_consume(
+    QemuCrucibleFaultRule *rule, bool opportunity)
+{
+    CrucibleMemoryTransaction *transaction = &crucible_memory_transaction;
+    QemuCrucibleFaultRule *original = node_memory_shadow_original(rule);
+
+    for (guint i = 0;
+         transaction->rule_reservations &&
+         i < transaction->rule_reservations->len; i++) {
+        CrucibleMemoryRuleReservation *reservation = &g_array_index(
+            transaction->rule_reservations,
+            CrucibleMemoryRuleReservation, i);
+
+        if (reservation->rule == original) {
+            node_memory_rule_reservation_release(
+                reservation, opportunity);
+            return;
+        }
+    }
+    if (transaction->resources_preflighted) {
+        error_report("Crucible rule reservation is incomplete");
+        abort();
+    }
+}
+
+static void node_memory_reservations_release(
+    CrucibleMemoryTransaction *transaction)
+{
+    for (guint i = 0;
+         transaction->rule_reservations &&
+         i < transaction->rule_reservations->len; i++) {
+        CrucibleMemoryRuleReservation *reservation = &g_array_index(
+            transaction->rule_reservations,
+            CrucibleMemoryRuleReservation, i);
+
+        node_memory_rule_reservation_release(reservation, true);
+        node_memory_rule_reservation_release(reservation, false);
+    }
+    for (guint i = 0;
+         transaction->row_reservations &&
+         i < transaction->row_reservations->len; i++) {
+        CrucibleMemoryRowReservation *reservation = &g_array_index(
+            transaction->row_reservations,
+            CrucibleMemoryRowReservation, i);
+
+        if (reservation->active) {
+            CrucibleMemoryReservedRows *rows =
+                node_memory_reserved_row_set(reservation->rule, false);
+            uint64_t *count;
+
+            g_assert(rows);
+            count = g_hash_table_lookup(
+                rows->coordinates, &reservation->coordinate);
+            g_assert(count && *count != 0);
+            (*count)--;
+            if (*count == 0) {
+                g_hash_table_remove(rows->coordinates,
+                                    &reservation->coordinate);
+            }
+            if (g_hash_table_size(rows->coordinates) == 0) {
+                g_hash_table_remove(crucible_memory_reserved_rows,
+                                    reservation->rule);
+            }
+            reservation->active = false;
+        }
+    }
+    for (guint i = 0;
+         transaction->retention_reservations &&
+         i < transaction->retention_reservations->len; i++) {
+        CrucibleMemoryRetentionReservation *reservation = &g_array_index(
+            transaction->retention_reservations,
+            CrucibleMemoryRetentionReservation, i);
+
+        if (reservation->active) {
+            CrucibleMemoryReservedRetention *retention =
+                node_memory_reserved_retention_set(
+                    reservation->rule, false);
+            uint64_t *count;
+
+            g_assert(retention);
+            count = g_hash_table_lookup(retention->offsets,
+                                        &reservation->offset);
+            g_assert(count && *count != 0);
+            (*count)--;
+            if (*count == 0) {
+                g_hash_table_remove(retention->offsets,
+                                    &reservation->offset);
+            }
+            if (g_hash_table_size(retention->offsets) == 0) {
+                g_hash_table_remove(
+                    crucible_memory_reserved_retention,
+                    reservation->rule);
+            }
+            reservation->active = false;
+        }
+    }
+    for (guint i = 0;
+         transaction->ledger_reservations &&
+         i < transaction->ledger_reservations->len; i++) {
+        CrucibleMemoryLedgerReservation *reservation = &g_array_index(
+            transaction->ledger_reservations,
+            CrucibleMemoryLedgerReservation, i);
+        uint64_t *reserved = g_hash_table_lookup(
+            crucible_memory_reserved_ledgers, reservation->ledger);
+
+        g_assert(reserved && *reserved >= reservation->demand);
+        *reserved -= reservation->demand;
+        if (*reserved == 0) {
+            g_hash_table_remove(crucible_memory_reserved_ledgers,
+                                reservation->ledger);
+        }
+        reservation->demand = 0;
+    }
+    g_assert(crucible_memory_reserved_virtual_time >=
+             transaction->virtual_time_reservation);
+    crucible_memory_reserved_virtual_time -=
+        transaction->virtual_time_reservation;
+    transaction->virtual_time_reservation = 0;
+}
+
+static void node_memory_resources_reserve(
+    GHashTable *counter_rules, GHashTable *row_plans,
+    GHashTable *retention_plans)
+{
+    CrucibleMemoryTransaction *transaction = &crucible_memory_transaction;
+    GHashTableIter iter;
+    gpointer key;
+    gpointer value;
+    g_autoptr(GHashTable) demand_by_ledger = g_hash_table_new_full(
+        g_direct_hash, g_direct_equal, NULL, g_free);
+    uint64_t fixed_latency = 0;
+    uint64_t queue_delay = 0;
+    uint64_t now = node_virtual_now();
+
+    transaction->rule_reservations = g_array_new(
+        false, false, sizeof(CrucibleMemoryRuleReservation));
+    g_hash_table_iter_init(&iter, counter_rules);
+    while (g_hash_table_iter_next(&iter, &key, NULL)) {
+        QemuCrucibleFaultRule *rule = key;
+        CrucibleMemoryReservedCounters *reserved =
+            node_memory_reserved_counter(rule, true);
+        CrucibleMemoryRuleReservation reservation = {
+            .rule = rule,
+            .opportunity = true,
+            .applied = true,
+        };
+
+        g_assert(reserved->opportunities != UINT64_MAX &&
+                 reserved->applied != UINT64_MAX);
+        reserved->opportunities++;
+        reserved->applied++;
+        g_array_append_val(transaction->rule_reservations, reservation);
+    }
+
+    transaction->row_reservations = g_array_new(
+        false, false, sizeof(CrucibleMemoryRowReservation));
+    g_hash_table_iter_init(&iter, row_plans);
+    while (g_hash_table_iter_next(&iter, &key, &value)) {
+        QemuCrucibleFaultRule *rule = key;
+        CrucibleMemoryRowResourcePlan *plan = value;
+        GHashTableIter coordinate_iter;
+        gpointer coordinate_key;
+        CrucibleMemoryReservedRows *rows =
+            node_memory_reserved_row_set(rule, true);
+
+        g_hash_table_iter_init(&coordinate_iter, plan->coordinates);
+        while (g_hash_table_iter_next(
+                   &coordinate_iter, &coordinate_key, NULL)) {
+            uint64_t *count = g_hash_table_lookup(
+                rows->coordinates, coordinate_key);
+            CrucibleMemoryRowReservation reservation = {
+                .rule = rule,
+                .coordinate = *(CrucibleDramCoordinate *)coordinate_key,
+                .active = true,
+            };
+
+            if (!count) {
+                count = g_new0(uint64_t, 1);
+                g_hash_table_insert(
+                    rows->coordinates,
+                    g_memdup2(coordinate_key,
+                              sizeof(CrucibleDramCoordinate)), count);
+            }
+            g_assert(*count != UINT64_MAX);
+            (*count)++;
+            g_array_append_val(transaction->row_reservations, reservation);
+        }
+    }
+
+    transaction->retention_reservations = g_array_new(
+        false, false, sizeof(CrucibleMemoryRetentionReservation));
+    g_hash_table_iter_init(&iter, retention_plans);
+    while (g_hash_table_iter_next(&iter, &key, &value)) {
+        QemuCrucibleFaultRule *rule = key;
+        CrucibleMemoryRetentionResourcePlan *plan = value;
+        GHashTableIter offset_iter;
+        gpointer offset_key;
+        CrucibleMemoryReservedRetention *retention =
+            node_memory_reserved_retention_set(rule, true);
+
+        g_hash_table_iter_init(&offset_iter, plan->offsets);
+        while (g_hash_table_iter_next(&offset_iter, &offset_key, NULL)) {
+            uint64_t *count = g_hash_table_lookup(
+                retention->offsets, offset_key);
+            CrucibleMemoryRetentionReservation reservation = {
+                .rule = rule,
+                .offset = *(uint64_t *)offset_key,
+                .active = true,
+            };
+
+            if (!count) {
+                count = g_new0(uint64_t, 1);
+                g_hash_table_insert(
+                    retention->offsets,
+                    g_memdup2(offset_key, sizeof(uint64_t)), count);
+            }
+            g_assert(*count != UINT64_MAX);
+            (*count)++;
+            g_array_append_val(transaction->retention_reservations,
+                               reservation);
+        }
+    }
+
+    transaction->ledger_reservations = g_array_new(
+        false, false, sizeof(CrucibleMemoryLedgerReservation));
+    for (guint i = 0;
+         crucible_memory_service_plan &&
+         i < crucible_memory_service_plan->len; i++) {
+        CrucibleMemoryServicePlan *plan = &g_array_index(
+            crucible_memory_service_plan, CrucibleMemoryServicePlan, i);
+        uint64_t latency, demand;
+        uint64_t *stored;
+
+        g_assert(node_memory_service_demand_checked(
+            plan->rule, plan->bytes, &latency, &demand));
+        g_assert(fixed_latency <= UINT64_MAX - latency);
+        fixed_latency += latency;
+        stored = g_hash_table_lookup(
+            demand_by_ledger, plan->rule->service_ledger);
+        if (!stored) {
+            stored = g_new0(uint64_t, 1);
+            g_hash_table_insert(demand_by_ledger,
+                                plan->rule->service_ledger, stored);
+        }
+        *stored = MAX(*stored, demand);
+    }
+    g_hash_table_iter_init(&iter, demand_by_ledger);
+    while (g_hash_table_iter_next(&iter, &key, &value)) {
+        CrucibleMemoryServiceLedger *ledger = key;
+        uint64_t demand = *(uint64_t *)value;
+        uint64_t prior = node_memory_reserved_ledger(ledger);
+        uint64_t ready = MAX(now, ledger->ready_ns) + prior;
+        uint64_t *reserved;
+        CrucibleMemoryLedgerReservation reservation = {
+            .ledger = ledger,
+            .demand = demand,
+        };
+
+        g_assert(ready <= UINT64_MAX - demand);
+        queue_delay = MAX(queue_delay, ready + demand - now);
+        if (!crucible_memory_reserved_ledgers) {
+            crucible_memory_reserved_ledgers = g_hash_table_new_full(
+                g_direct_hash, g_direct_equal, NULL, g_free);
+        }
+        reserved = g_hash_table_lookup(
+            crucible_memory_reserved_ledgers, ledger);
+        if (!reserved) {
+            reserved = g_new0(uint64_t, 1);
+            g_hash_table_insert(crucible_memory_reserved_ledgers,
+                                ledger, reserved);
+        }
+        g_assert(*reserved <= UINT64_MAX - demand);
+        *reserved += demand;
+        g_array_append_val(transaction->ledger_reservations, reservation);
+    }
+    g_assert(fixed_latency <= UINT64_MAX - queue_delay);
+    transaction->virtual_time_reservation = fixed_latency + queue_delay;
+    g_assert(crucible_memory_reserved_virtual_time <=
+             UINT64_MAX - transaction->virtual_time_reservation);
+    crucible_memory_reserved_virtual_time +=
+        transaction->virtual_time_reservation;
+}
+
+static bool node_memory_rowhammer_resources_plan(
+    QemuCrucibleFaultRule *rule, QDict *parameters,
+    uint64_t rule_offset, size_t selected, GHashTable *plans)
+{
+    CrucibleMemoryRowResourcePlan *plan =
+        g_hash_table_lookup(plans, rule);
+    uint64_t row_bytes;
+    uint64_t current = rule_offset;
+    uint64_t remaining = selected;
+    uint64_t existing = rule->row_counters ?
+        g_hash_table_size(rule->row_counters) : 0;
+    CrucibleMemoryReservedRows *reserved_rows =
+        node_memory_reserved_row_set(rule, false);
+    uint64_t reserved_new = 0;
+
+    g_assert(existing <= CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT);
+    if (reserved_rows) {
+        GHashTableIter reserved_iter;
+        gpointer reserved_key;
+
+        g_hash_table_iter_init(&reserved_iter, reserved_rows->coordinates);
+        while (g_hash_table_iter_next(&reserved_iter, &reserved_key, NULL)) {
+            if (!rule->row_counters ||
+                !g_hash_table_contains(rule->row_counters, reserved_key)) {
+                reserved_new++;
+            }
+        }
+    }
+    g_assert(reserved_new <=
+             CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT - existing);
+    g_assert(node_json_u64(qdict_get(parameters, "row_bytes"),
+                           &row_bytes));
+    if (!plan) {
+        plan = g_new0(CrucibleMemoryRowResourcePlan, 1);
+        plan->coordinates = g_hash_table_new_full(
+            node_dram_coordinate_hash, node_dram_coordinate_equal,
+            g_free, NULL);
+        g_hash_table_insert(plans, rule, plan);
+    }
+    while (remaining != 0) {
+        uint64_t physical, available;
+        uint64_t part;
+
+        g_assert(node_rule_physical_span(rule, current, &physical,
+                                         &available));
+        part = MIN(remaining, available);
+        for (uint64_t byte = 0; byte < part; byte++) {
+            CrucibleDramCoordinate coordinate = node_dram_coordinate(
+                physical + byte, row_bytes);
+            uint64_t *counter;
+
+            if (g_hash_table_contains(plan->coordinates, &coordinate)) {
+                continue;
+            }
+            counter = rule->row_counters ?
+                g_hash_table_lookup(rule->row_counters, &coordinate) :
+                NULL;
+            uint64_t reserved = node_memory_reserved_row_count(
+                rule, &coordinate);
+
+            if (reserved == UINT64_MAX || (counter ? *counter : 0) >
+                UINT64_MAX - reserved - 1) {
+                node_memory_counter_terminal_metadata(
+                    (counter ? *counter : 0) + reserved);
+                return false;
+            }
+            if (!counter && reserved == 0) {
+                if (plan->new_counters ==
+                    CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT - existing -
+                    reserved_new) {
+                    node_memory_resource_terminal_metadata(
+                        CRUCIBLE_NODE_RESOURCE_PERSISTENT_CELLS,
+                        existing + reserved_new,
+                        plan->new_counters + 1,
+                        CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT,
+                        CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT);
+                    return false;
+                }
+                plan->new_counters++;
+            }
+            g_hash_table_add(
+                plan->coordinates,
+                g_memdup2(&coordinate, sizeof(coordinate)));
+        }
+        current += part;
+        remaining -= part;
+    }
+    return true;
+}
+
+static bool node_memory_retention_resources_plan(
+    QemuCrucibleFaultRule *rule, QDict *parameters,
+    uint32_t access_class, uint64_t rule_offset, size_t selected,
+    GHashTable *plans)
+{
+    CrucibleMemoryRetentionResourcePlan *plan =
+        g_hash_table_lookup(plans, rule);
+    CrucibleMemoryReservedRetention *reserved_retention =
+        node_memory_reserved_retention_set(rule, false);
+    uint64_t existing = rule->retention_cells ?
+        g_hash_table_size(rule->retention_cells) : 0;
+    uint64_t reserved_new = 0;
+    uint64_t interval;
+    const char *mask;
+    size_t mask_length;
+    bool write_access =
+        (access_class & (QEMU_CRUCIBLE_MEMORY_CPU_STORE |
+                         QEMU_CRUCIBLE_MEMORY_DMA_WRITE)) != 0;
+    uint64_t now = node_virtual_now();
+
+    if (reserved_retention) {
+        GHashTableIter iter;
+        gpointer offset_key;
+
+        g_hash_table_iter_init(&iter, reserved_retention->offsets);
+        while (g_hash_table_iter_next(&iter, &offset_key, NULL)) {
+            if (!rule->retention_cells ||
+                !g_hash_table_contains(rule->retention_cells, offset_key)) {
+                reserved_new++;
+            }
+        }
+    }
+    g_assert(existing <= CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT &&
+             reserved_new <=
+                CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT - existing);
+    g_assert(node_json_u64(qdict_get(parameters, "interval_nanos"),
+                           &interval));
+    mask = qdict_get_str(parameters, "decay_mask");
+    mask_length = strlen(mask) / 2;
+    if (!plan) {
+        plan = g_new0(CrucibleMemoryRetentionResourcePlan, 1);
+        plan->offsets = g_hash_table_new_full(
+            g_int64_hash, g_int64_equal, g_free, NULL);
+        g_hash_table_insert(plans, rule, plan);
+    }
+    for (size_t byte = 0; byte < selected; byte++) {
+        uint64_t offset = rule_offset + byte;
+        uint64_t reserved;
+        unsigned parsed;
+        bool creates = write_access;
+
+        if (g_hash_table_contains(plan->offsets, &offset)) {
+            continue;
+        }
+        if (!creates && rule->exposure_initialized &&
+            now >= rule->last_exposure_ns &&
+            now - rule->last_exposure_ns >= interval) {
+            g_assert(sscanf(mask + (offset % mask_length) * 2,
+                            "%2x", &parsed) == 1);
+            creates = parsed != 0;
+        }
+        if (!creates || (rule->retention_cells &&
+                         g_hash_table_contains(rule->retention_cells,
+                                               &offset))) {
+            continue;
+        }
+        reserved = node_memory_reserved_retention_count(rule, offset);
+        if (reserved == 0) {
+            if (plan->new_cells ==
+                CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT - existing -
+                reserved_new) {
+                node_memory_resource_terminal_metadata(
+                    CRUCIBLE_NODE_RESOURCE_PERSISTENT_CELLS,
+                    existing + reserved_new, plan->new_cells + 1,
+                    CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT,
+                    CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT);
+                return false;
+            }
+            plan->new_cells++;
+        }
+        g_hash_table_add(plan->offsets,
+                         g_memdup2(&offset, sizeof(offset)));
+    }
+    return true;
+}
+
+bool qemu_crucible_fault_memory_rules_active(void)
+{
+    if (crucible_memory_recursive || !crucible_node_rules ||
+        strcmp(current_accel_name(), "sim") != 0 ||
+        icount_enabled() != ICOUNT_PRECISE) {
+        return false;
+    }
+    return (crucible_memory_gpa_index && crucible_memory_gpa_index->len != 0) ||
+           (crucible_memory_gva_index && crucible_memory_gva_index->len != 0);
+}
+
+bool qemu_crucible_fault_memory_fetch_rules_active(void)
+{
+    return qemu_crucible_fault_memory_rules_active() &&
+           (crucible_memory_access_classes &
+            QEMU_CRUCIBLE_MEMORY_FETCH) != 0;
+}
+
+bool qemu_crucible_fault_memory_cpu_rules_active(void)
+{
+    return qemu_crucible_fault_memory_rules_active() &&
+           (crucible_memory_access_classes &
+            (QEMU_CRUCIBLE_MEMORY_CPU_LOAD |
+             QEMU_CRUCIBLE_MEMORY_CPU_STORE)) != 0;
+}
+
+bool qemu_crucible_fault_memory_page_table_walk_rules_active(void)
+{
+    return qemu_crucible_fault_memory_rules_active() &&
+           (crucible_memory_access_classes &
+            QEMU_CRUCIBLE_MEMORY_PAGE_TABLE_WALK) != 0;
+}
+
+bool qemu_crucible_fault_memory_page_table_walk_matches(
+    uint64_t entry_gpa, size_t length)
+{
+    uint64_t last;
+    IntervalTreeNode *node;
+
+    if (!qemu_crucible_fault_memory_page_table_walk_rules_active() ||
+        length == 0 || entry_gpa > UINT64_MAX - (length - 1)) {
+        return false;
+    }
+    last = entry_gpa + length - 1;
+    for (node = interval_tree_iter_first(
+             &crucible_memory_gpa_root, entry_gpa, last);
+         node;
+         node = interval_tree_iter_next(node, entry_gpa, last)) {
+        CrucibleMemoryIndexEntry *entry = container_of(
+            node, CrucibleMemoryIndexEntry, interval);
+        QemuCrucibleFaultRule *rule = entry->rule;
+        uint32_t classes;
+
+        if (rule->command_kind !=
+                CRUCIBLE_FAULT_COMMAND_MEMORY_ACCESS_TRANSFORM ||
+            (node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P8, &classes) &&
+             (classes & QEMU_CRUCIBLE_MEMORY_PAGE_TABLE_WALK) != 0)) {
+            return true;
+        }
+    }
+    return false;
+}
+
+bool qemu_crucible_fault_memory_dma_rules_active(bool is_write)
+{
+    uint32_t access_class = is_write ? QEMU_CRUCIBLE_MEMORY_DMA_WRITE :
+                                       QEMU_CRUCIBLE_MEMORY_DMA_READ;
+
+    return qemu_crucible_fault_memory_rules_active() &&
+           (crucible_memory_access_classes & access_class) != 0;
+}
+
+static void node_memory_transaction_preflight_segment(
+    uint32_t access_class, uint32_t vcpu, uint64_t vaddr, uint64_t gpa,
+    size_t length, bool include_gva, uint64_t identity)
+{
+    crucible_memory_preflight_collecting = true;
+    size_t match_count = node_memory_matching_rules_at(
+        vcpu, vaddr, gpa, length, include_gva, identity);
+    crucible_memory_preflight_collecting = false;
+
+    for (size_t i = 0; i < match_count; i++) {
+        QemuCrucibleFaultRule *rule = crucible_memory_matches[i];
+        size_t offset, selected;
+        uint64_t rule_offset;
+        uint32_t kind;
+
+        if (!node_rule_memory_overlap(rule, vcpu, vaddr, gpa, length,
+                                      &offset, &selected, &rule_offset)) {
+            continue;
+        }
+        if (rule->command_kind == CRUCIBLE_FAULT_COMMAND_MEMORY_SERVICE) {
+            continue;
+        }
+        if (rule->command_kind ==
+            CRUCIBLE_FAULT_COMMAND_MEMORY_ACCESS_TRANSFORM) {
+            uint32_t classes;
+            gpointer evaluated;
+            bool occurs;
+            bool first_evaluation;
+            QDict *poison;
+
+            g_assert(node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P3,
+                                    &kind));
+            g_assert(node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P8,
+                                    &classes));
+            if (kind != 5 || (classes & access_class) == 0) {
+                continue;
+            }
+            if (rule->opportunity_count == UINT64_MAX ||
+                rule->applied_count == UINT64_MAX) {
+                node_memory_counter_terminal_metadata(UINT64_MAX);
+                node_memory_resource_terminal(
+                    rule, access_class, vcpu, vaddr + offset,
+                    gpa + offset, selected,
+                    crucible_memory_transaction.observed_icount);
+                crucible_memory_transaction.poisoned = true;
+                break;
+            }
+            evaluated = g_hash_table_lookup(
+                crucible_memory_transaction_poison, rule);
+            first_evaluation = !evaluated;
+            if (!evaluated) {
+                occurs = node_memory_rule_occurs(
+                    rule, CRUCIBLE_NODE_FAULT_FIELD_P7);
+                g_hash_table_insert(crucible_memory_transaction_poison, rule,
+                    GUINT_TO_POINTER(occurs ? 2 : 1));
+            } else {
+                occurs = GPOINTER_TO_UINT(evaluated) == 2;
+            }
+            if (!occurs) {
+                continue;
+            }
+            poison = qobject_to(
+                QDict, node_field(rule,
+                    CRUCIBLE_NODE_FAULT_FIELD_P6)->json);
+            if (strcmp(qdict_get_str(poison, "kind"), "corrected") != 0) {
+                if (strcmp(qdict_get_str(poison, "kind"), "exception") == 0) {
+                    CPUFaultException exception;
+
+                    g_assert(qemu_crucible_fault_exception_decode(
+                        qdict_get(
+                            qdict_get_qdict(poison, "parameters"),
+                            "exception"),
+                        &exception));
+                    if (crucible_memory_transaction.has_exception &&
+                        memcmp(&crucible_memory_transaction.exception,
+                               &exception, sizeof(exception)) != 0) {
+                        error_report(
+                            "Conflicting Crucible memory exceptions escaped admission");
+                        abort();
+                    }
+                    crucible_memory_transaction.has_exception = true;
+                    crucible_memory_transaction.exception = exception;
+                }
+                crucible_memory_transaction.poisoned = true;
+                if (first_evaluation) {
+                    node_memory_event_span(0, selected);
+                    node_memory_event(
+                        rule, CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR,
+                        access_class, vcpu, vaddr + offset, gpa + offset,
+                        NULL, NULL, selected,
+                        crucible_memory_transaction.observed_icount);
+                }
+            }
+        } else if (rule->command_kind ==
+                   CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE) {
+            QDict *process;
+            QDict *policy;
+
+            g_assert(node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P3,
+                                    &kind));
+            if (kind != 1) {
+                continue;
+            }
+            if (rule->opportunity_count == UINT64_MAX ||
+                rule->applied_count == UINT64_MAX) {
+                node_memory_counter_terminal_metadata(UINT64_MAX);
+                node_memory_resource_terminal(
+                    rule, access_class, vcpu, vaddr + offset,
+                    gpa + offset, selected,
+                    crucible_memory_transaction.observed_icount);
+                crucible_memory_transaction.poisoned = true;
+                break;
+            }
+            if (g_hash_table_lookup(crucible_memory_transaction_poison,
+                                    rule)) {
+                continue;
+            }
+            g_hash_table_insert(crucible_memory_transaction_poison, rule,
+                                GUINT_TO_POINTER(2));
+            process = qobject_to(
+                QDict, node_field(rule,
+                    CRUCIBLE_NODE_FAULT_FIELD_P4)->json);
+            policy = qdict_get_qdict(
+                qdict_get_qdict(process, "parameters"), "policy");
+            if (strcmp(qdict_get_str(policy, "kind"), "corrected") != 0) {
+                if (strcmp(qdict_get_str(policy, "kind"), "exception") == 0) {
+                    CPUFaultException exception;
+
+                    g_assert(qemu_crucible_fault_exception_decode(
+                        qdict_get(
+                            qdict_get_qdict(policy, "parameters"),
+                            "exception"),
+                        &exception));
+                    if (crucible_memory_transaction.has_exception &&
+                        memcmp(&crucible_memory_transaction.exception,
+                               &exception, sizeof(exception)) != 0) {
+                        error_report(
+                            "Conflicting Crucible memory exceptions escaped admission");
+                        abort();
+                    }
+                    crucible_memory_transaction.has_exception = true;
+                    crucible_memory_transaction.exception = exception;
+                }
+                crucible_memory_transaction.poisoned = true;
+                node_memory_state_opportunity(rule);
+                node_memory_state_applied(rule);
+                node_memory_event_span(0, selected);
+                node_memory_event(
+                    rule, CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR,
+                    access_class, vcpu, vaddr + offset, gpa + offset,
+                    NULL, NULL, selected,
+                    crucible_memory_transaction.observed_icount);
+            }
+        }
+    }
+    node_memory_matching_rules_done();
+}
+
+static bool node_memory_transaction_count_segment(
+    uint32_t access_class, uint32_t vcpu, uint64_t vaddr, uint64_t gpa,
+    size_t length, bool include_gva, uint64_t identity)
+{
+    CrucibleMemoryTransaction *transaction = &crucible_memory_transaction;
+    crucible_memory_preflight_collecting = true;
+    size_t match_count = node_memory_matching_rules_at(
+        vcpu, vaddr, gpa, length, include_gva, identity);
+    crucible_memory_preflight_collecting = false;
+
+    node_memory_snapshot_add_current(match_count);
+
+    if (transaction->event_budget > SIZE_MAX - match_count) {
+        error_report("Crucible memory transaction event budget overflow");
+        abort();
+    }
+    transaction->event_budget += match_count;
+    if (!transaction->streaming && match_count != 0 &&
+        !node_memory_event_capacity(
+            crucible_memory_matches[0], transaction->event_budget,
+            access_class, vcpu, vaddr, gpa, length,
+            transaction->observed_icount)) {
+        transaction->poisoned = true;
+        node_memory_matching_rules_done();
+        return false;
+    }
+    node_memory_matching_rules_done();
+    return true;
+}
+
+static bool node_memory_transaction_resources_segment(
+    uint32_t access_class, uint32_t vcpu, uint64_t vaddr, uint64_t gpa,
+    size_t length, bool include_gva, uint64_t identity,
+    GHashTable *counter_rules, GHashTable *row_plans,
+    GHashTable *retention_plans)
+{
+    size_t match_count;
+
+    crucible_memory_preflight_collecting = true;
+    crucible_memory_resource_planning = true;
+    match_count = node_memory_matching_rules_at(
+        vcpu, vaddr, gpa, length, include_gva, identity);
+
+    for (size_t i = 0; i < match_count; i++) {
+        QemuCrucibleFaultRule *rule = crucible_memory_matches[i];
+        size_t offset, selected;
+        uint64_t rule_offset;
+
+        if (!node_rule_memory_overlap_internal(
+                rule, vcpu, vaddr, gpa, length, &offset, &selected,
+                &rule_offset, false)) {
+            continue;
+        }
+        if (rule->command_kind ==
+            CRUCIBLE_FAULT_COMMAND_MEMORY_ACCESS_TRANSFORM) {
+            uint32_t classes;
+
+            g_assert(node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P8,
+                                    &classes));
+            if ((classes & access_class) == 0) {
+                continue;
+            }
+        }
+        if (!g_hash_table_contains(counter_rules, rule)) {
+            if (!node_memory_rule_resources_ready(rule)) {
+                node_memory_counter_terminal_metadata(UINT64_MAX);
+                node_memory_resource_terminal(
+                    rule, access_class, vcpu, vaddr + offset,
+                    gpa + offset, selected,
+                    crucible_memory_transaction.observed_icount);
+                crucible_memory_preflight_collecting = false;
+                crucible_memory_resource_planning = false;
+                node_memory_matching_rules_done();
+                return false;
+            }
+            g_hash_table_add(counter_rules, rule);
+        }
+        if (rule->command_kind ==
+            CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE) {
+            uint32_t kind;
+
+            g_assert(node_field_u32(rule,
+                                    CRUCIBLE_NODE_FAULT_FIELD_P3,
+                                    &kind));
+            if (kind == 2) {
+                QDict *process = qobject_to(
+                    QDict, node_field(rule,
+                        CRUCIBLE_NODE_FAULT_FIELD_P4)->json);
+                QDict *parameters = qdict_get_qdict(
+                    process, "parameters");
+
+                if (!node_memory_retention_resources_plan(
+                        rule, parameters, access_class, rule_offset,
+                        selected, retention_plans)) {
+                    node_memory_resource_terminal(
+                        rule, access_class, vcpu, vaddr + offset,
+                        gpa + offset, selected,
+                        crucible_memory_transaction.observed_icount);
+                    crucible_memory_preflight_collecting = false;
+                    crucible_memory_resource_planning = false;
+                    node_memory_matching_rules_done();
+                    return false;
+                }
+            } else if (kind == 3) {
+                QDict *process = qobject_to(
+                    QDict, node_field(rule,
+                        CRUCIBLE_NODE_FAULT_FIELD_P4)->json);
+                QDict *parameters = qdict_get_qdict(
+                    process, "parameters");
+
+                if (!node_memory_rowhammer_resources_plan(
+                        rule, parameters, rule_offset, selected,
+                        row_plans)) {
+                    node_memory_resource_terminal(
+                        rule, access_class, vcpu, vaddr + offset,
+                        gpa + offset, selected,
+                        crucible_memory_transaction.observed_icount);
+                    crucible_memory_preflight_collecting = false;
+                    crucible_memory_resource_planning = false;
+                    node_memory_matching_rules_done();
+                    return false;
+                }
+            }
+        }
+        if (rule->command_kind == CRUCIBLE_FAULT_COMMAND_MEMORY_SERVICE &&
+            !node_memory_service_plan_add(rule, selected)) {
+            node_memory_resource_terminal(
+                rule, access_class, vcpu, vaddr + offset, gpa + offset,
+                selected, crucible_memory_transaction.observed_icount);
+            crucible_memory_preflight_collecting = false;
+            crucible_memory_resource_planning = false;
+            node_memory_matching_rules_done();
+            return false;
+        }
+    }
+    crucible_memory_preflight_collecting = false;
+    crucible_memory_resource_planning = false;
+    node_memory_matching_rules_done();
+    return true;
+}
+
+static bool node_memory_transaction_resources_finish(
+    GHashTable *counter_rules, GHashTable *row_plans,
+    GHashTable *retention_plans)
+{
+    CrucibleMemoryTransaction *transaction = &crucible_memory_transaction;
+
+    if (!node_memory_service_plan_valid()) {
+        CrucibleMemoryServicePlan *plan = &g_array_index(
+            crucible_memory_service_plan, CrucibleMemoryServicePlan, 0);
+
+        crucible_memory_preflight_collecting = true;
+        node_memory_boundary_match(plan->rule, transaction->identity);
+        node_memory_resource_terminal(
+            plan->rule, transaction->access_class, transaction->actor,
+            transaction->address, transaction->address,
+            transaction->length, transaction->observed_icount);
+        node_memory_boundary_match_done();
+        crucible_memory_preflight_collecting = false;
+        transaction->poisoned = true;
+        transaction->resource_failed = true;
+        transaction->has_exception = false;
+        return false;
+    }
+    node_memory_resources_reserve(
+        counter_rules, row_plans, retention_plans);
+    transaction->resources_preflighted = true;
+    return true;
+}
+
+static void node_memory_transaction_preflight(
+    enum QemuCrucibleMemoryAccessClass access_class, uint32_t actor,
+    uint64_t address, size_t length, uint64_t identity)
+{
+    g_autoptr(GHashTable) counter_rules = g_hash_table_new(
+        g_direct_hash, g_direct_equal);
+    g_autoptr(GHashTable) row_plans = g_hash_table_new_full(
+        g_direct_hash, g_direct_equal, NULL,
+        node_memory_row_resource_plan_free);
+    g_autoptr(GHashTable) retention_plans = g_hash_table_new_full(
+        g_direct_hash, g_direct_equal, NULL,
+        node_memory_retention_resource_plan_free);
+
+    if (!crucible_memory_transaction_poison) {
+        crucible_memory_transaction_poison = g_hash_table_new(
+            g_direct_hash, g_direct_equal);
+    } else {
+        g_hash_table_remove_all(crucible_memory_transaction_poison);
+    }
+    node_memory_service_plan_reset();
+
+    CPUState *cpu = qemu_get_cpu(actor);
+    uint64_t current = address;
+    size_t remaining = length;
+
+    if (!cpu) {
+        crucible_memory_transaction.poisoned = true;
+        return;
+    }
+    while (remaining != 0) {
+        CPUFaultTranslation translation;
+        uint64_t page_offset;
+        size_t part;
+
+        MMUAccessType mmu_access = access_class ==
+                QEMU_CRUCIBLE_MEMORY_FETCH ? MMU_INST_FETCH :
+            access_class == QEMU_CRUCIBLE_MEMORY_CPU_STORE ?
+                MMU_DATA_STORE : MMU_DATA_LOAD;
+
+        if (!cpu_get_fault_translation(cpu, current, mmu_access,
+                                       &translation) ||
+            translation.page_size == 0) {
+            crucible_memory_transaction.poisoned = true;
+            return;
+        }
+        page_offset = current % translation.page_size;
+        part = MIN(remaining, translation.page_size - page_offset);
+        if (!node_memory_transaction_count_segment(
+                access_class, actor, current,
+                translation.physical_address, part, true, identity)) {
+            return;
+        }
+        current += part;
+        remaining -= part;
+    }
+    current = address;
+    remaining = length;
+    while (remaining != 0) {
+        CPUFaultTranslation translation;
+        uint64_t page_offset;
+        size_t part;
+        MMUAccessType mmu_access = access_class ==
+                QEMU_CRUCIBLE_MEMORY_FETCH ? MMU_INST_FETCH :
+            access_class == QEMU_CRUCIBLE_MEMORY_CPU_STORE ?
+                MMU_DATA_STORE : MMU_DATA_LOAD;
+
+        if (!cpu_get_fault_translation(cpu, current, mmu_access,
+                                       &translation) ||
+            translation.page_size == 0) {
+            crucible_memory_transaction.poisoned = true;
+            return;
+        }
+        page_offset = current % translation.page_size;
+        part = MIN(remaining, translation.page_size - page_offset);
+        if (!node_memory_transaction_resources_segment(
+                access_class, actor, current,
+                translation.physical_address, part, true, identity,
+                counter_rules, row_plans, retention_plans)) {
+            crucible_memory_transaction.poisoned = true;
+            return;
+        }
+        current += part;
+        remaining -= part;
+    }
+    if (!node_memory_transaction_resources_finish(
+            counter_rules, row_plans, retention_plans)) {
+        return;
+    }
+    current = address;
+    remaining = length;
+    while (remaining != 0) {
+        CPUFaultTranslation translation;
+        uint64_t page_offset;
+        size_t part;
+        MMUAccessType mmu_access = access_class ==
+                QEMU_CRUCIBLE_MEMORY_FETCH ? MMU_INST_FETCH :
+            access_class == QEMU_CRUCIBLE_MEMORY_CPU_STORE ?
+                MMU_DATA_STORE : MMU_DATA_LOAD;
+
+        if (!cpu_get_fault_translation(cpu, current, mmu_access,
+                                       &translation) ||
+            translation.page_size == 0) {
+            crucible_memory_transaction.poisoned = true;
+            return;
+        }
+        page_offset = current % translation.page_size;
+        part = MIN(remaining, translation.page_size - page_offset);
+        node_memory_transaction_preflight_segment(
+            access_class, actor, current, translation.physical_address,
+            part, true, identity);
+        current += part;
+        remaining -= part;
+    }
+}
+
+static void node_memory_transaction_preflight_physical(
+    enum QemuCrucibleMemoryAccessClass access_class, uint32_t actor,
+    uint64_t target_vaddr, uint64_t gpa, size_t length, uint64_t identity)
+{
+    g_autoptr(GHashTable) counter_rules = g_hash_table_new(
+        g_direct_hash, g_direct_equal);
+    g_autoptr(GHashTable) row_plans = g_hash_table_new_full(
+        g_direct_hash, g_direct_equal, NULL,
+        node_memory_row_resource_plan_free);
+    g_autoptr(GHashTable) retention_plans = g_hash_table_new_full(
+        g_direct_hash, g_direct_equal, NULL,
+        node_memory_retention_resource_plan_free);
+
+    if (!node_memory_transaction_count_segment(
+            access_class, actor, target_vaddr, gpa, length, false,
+            identity)) {
+        return;
+    }
+    if (!node_memory_transaction_resources_segment(
+            access_class, actor, target_vaddr, gpa, length, false,
+            identity, counter_rules, row_plans, retention_plans)) {
+        crucible_memory_transaction.poisoned = true;
+        return;
+    }
+    if (!node_memory_transaction_resources_finish(
+            counter_rules, row_plans, retention_plans)) {
+        return;
+    }
+    node_memory_transaction_preflight_segment(
+        access_class, actor, target_vaddr, gpa, length, false, identity);
+}
+
+static void node_memory_dma_fragment_clear(gpointer opaque)
+{
+    CrucibleMemoryDmaFragment *fragment = opaque;
+
+    if (fragment->mr) {
+        memory_region_unref(fragment->mr);
+        fragment->mr = NULL;
+    }
+}
+
+static void node_memory_mutation_fragment_clear(gpointer opaque)
+{
+    CrucibleMemoryMutationFragment *fragment = opaque;
+
+    if (fragment->mr) {
+        memory_region_unref(fragment->mr);
+        fragment->mr = NULL;
+    }
+}
+
+static bool node_memory_mutation_plan_capture_rule(
+    QemuCrucibleFaultRule *rule)
+{
+    CrucibleMemoryTransaction *transaction = &crucible_memory_transaction;
+    uint64_t start, length;
+    uint64_t rule_offset = 0;
+
+    if (!node_rule_memory_range(rule, &start, &length)) {
+        return false;
+    }
+    while (rule_offset != length) {
+        CrucibleMemoryMutationFragment fragment = {
+            .rule = rule,
+            .rule_offset = rule_offset,
+        };
+        uint64_t translation_available;
+        hwaddr region_available;
+
+        if (!node_rule_physical_span(
+                rule, rule_offset, &fragment.gpa,
+                &translation_available)) {
+            return false;
+        }
+        region_available = MIN(length - rule_offset,
+                               translation_available);
+        if (!address_space_translate_crucible_dma(
+                &address_space_memory, fragment.gpa, &fragment.gpa,
+                &fragment.mr, &fragment.mr_addr, &region_available,
+                true, MEMTXATTRS_UNSPECIFIED) || region_available == 0) {
+            return false;
+        }
+        fragment.length = region_available;
+        if (transaction->dma_mutation_fragments->len ==
+            CRUCIBLE_NODE_MEMORY_MATCH_LIMIT) {
+            return false;
+        }
+        memory_region_ref(fragment.mr);
+        g_array_append_val(transaction->dma_mutation_fragments, fragment);
+        rule_offset += fragment.length;
+    }
+    return true;
+}
+
+static bool node_memory_mutation_plan_capture(void)
+{
+    CrucibleMemoryTransaction *transaction = &crucible_memory_transaction;
+
+    transaction->dma_mutation_fragments = g_array_new(
+        false, false, sizeof(CrucibleMemoryMutationFragment));
+    g_array_set_clear_func(transaction->dma_mutation_fragments,
+                           node_memory_mutation_fragment_clear);
+    for (guint i = 0;
+         transaction->rule_snapshot && i < transaction->rule_snapshot->len;
+         i++) {
+        QemuCrucibleFaultRule *rule =
+            g_ptr_array_index(transaction->rule_snapshot, i);
+        uint32_t kind;
+
+        if (rule->command_kind !=
+                CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE ||
+            !node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P3, &kind) ||
+            (kind != 2 && kind != 3)) {
+            continue;
+        }
+        if (!node_memory_mutation_plan_capture_rule(rule)) {
+            g_clear_pointer(&transaction->dma_mutation_fragments,
+                            g_array_unref);
+            return false;
+        }
+    }
+    return true;
+}
+
+static void node_memory_transaction_preflight_dma(
+    enum QemuCrucibleMemoryAccessClass access_class, uint32_t actor,
+    const AddressSpace *as, uint64_t iova, size_t length, MemTxAttrs attrs,
+    uint64_t identity)
+{
+    g_autoptr(GHashTable) counter_rules = g_hash_table_new(
+        g_direct_hash, g_direct_equal);
+    g_autoptr(GHashTable) row_plans = g_hash_table_new_full(
+        g_direct_hash, g_direct_equal, NULL,
+        node_memory_row_resource_plan_free);
+    g_autoptr(GHashTable) retention_plans = g_hash_table_new_full(
+        g_direct_hash, g_direct_equal, NULL,
+        node_memory_retention_resource_plan_free);
+    CrucibleMemoryTransaction *transaction = &crucible_memory_transaction;
+    uint64_t current = iova;
+    size_t remaining = length;
+    bool is_write = access_class == QEMU_CRUCIBLE_MEMORY_DMA_WRITE;
+
+    if (!crucible_memory_transaction_poison) {
+        crucible_memory_transaction_poison = g_hash_table_new(
+            g_direct_hash, g_direct_equal);
+    } else {
+        g_hash_table_remove_all(crucible_memory_transaction_poison);
+    }
+    node_memory_service_plan_reset();
+    g_clear_pointer(&transaction->dma_fragments, g_array_unref);
+    g_clear_pointer(&transaction->dma_mutation_fragments, g_array_unref);
+    transaction->dma_fragments = g_array_new(
+        false, false, sizeof(CrucibleMemoryDmaFragment));
+    g_array_set_clear_func(transaction->dma_fragments,
+                           node_memory_dma_fragment_clear);
+    {
+        RCU_READ_LOCK_GUARD();
+
+        while (remaining != 0) {
+            CrucibleMemoryDmaFragment fragment = { 0 };
+            hwaddr part = remaining;
+
+            if (!address_space_translate_crucible_dma(
+                    as, current, &fragment.gpa, &fragment.mr,
+                    &fragment.mr_addr, &part, is_write, attrs)) {
+                transaction->poisoned = true;
+                break;
+            }
+            if (part == 0 || part > remaining) {
+                error_report("Invalid Crucible DMA translation span");
+                abort();
+            }
+            fragment.length = part;
+            memory_region_ref(fragment.mr);
+            g_array_append_val(transaction->dma_fragments, fragment);
+            current += part;
+            remaining -= part;
+        }
+        if (transaction->poisoned) {
+            return;
+        }
+        for (guint i = 0; i < transaction->dma_fragments->len; i++) {
+            CrucibleMemoryDmaFragment *fragment = &g_array_index(
+                transaction->dma_fragments, CrucibleMemoryDmaFragment, i);
+
+            if (!node_memory_transaction_count_segment(
+                    access_class, actor, fragment->gpa, fragment->gpa,
+                    fragment->length, false, identity)) {
+                return;
+            }
+        }
+        for (guint i = 0; i < transaction->dma_fragments->len; i++) {
+            CrucibleMemoryDmaFragment *fragment = &g_array_index(
+                transaction->dma_fragments, CrucibleMemoryDmaFragment, i);
+
+            if (!node_memory_transaction_resources_segment(
+                    access_class, actor, fragment->gpa, fragment->gpa,
+                    fragment->length, false, identity,
+                    counter_rules, row_plans, retention_plans)) {
+                transaction->poisoned = true;
+                return;
+            }
+        }
+        if (!node_memory_transaction_resources_finish(
+                counter_rules, row_plans, retention_plans)) {
+            return;
+        }
+        if (!node_memory_mutation_plan_capture()) {
+            transaction->poisoned = true;
+            return;
+        }
+        for (guint i = 0; i < transaction->dma_fragments->len; i++) {
+            CrucibleMemoryDmaFragment *fragment = &g_array_index(
+                transaction->dma_fragments, CrucibleMemoryDmaFragment, i);
+
+            node_memory_transaction_preflight_segment(
+                access_class, actor, fragment->gpa, fragment->gpa,
+                fragment->length, false, identity);
+            if (transaction->poisoned) {
+                return;
+            }
+        }
+        transaction->poison_preflighted = true;
+    }
+}
+
+static void node_memory_transaction_preflight_dma_poison(void)
+{
+    CrucibleMemoryTransaction *transaction = &crucible_memory_transaction;
+    uint64_t remaining = transaction->length;
+
+    if (transaction->poison_preflighted || transaction->poisoned) {
+        return;
+    }
+    transaction->poison_preflighted = true;
+    for (guint i = 0;
+         transaction->dma_fragments &&
+         i < transaction->dma_fragments->len && remaining != 0; i++) {
+        CrucibleMemoryDmaFragment *fragment = &g_array_index(
+            transaction->dma_fragments, CrucibleMemoryDmaFragment, i);
+        uint64_t part = MIN(remaining, fragment->length);
+
+        node_memory_transaction_preflight_segment(
+            transaction->access_class, transaction->actor,
+            fragment->gpa, fragment->gpa, part, false,
+            transaction->identity);
+        if (transaction->poisoned) {
+            return;
+        }
+        remaining -= part;
+    }
+    g_assert(remaining == 0);
+}
+
+static guint node_memory_retry_key_hash(gconstpointer opaque)
+{
+    const CrucibleMemoryRetryKey *key = opaque;
+    uint64_t hash = key->address ^ (key->length << 7) ^
+                    (key->length >> 57) ^ key->observed_icount ^
+                    (key->instruction_pc << 13) ^
+                    (key->instruction_pc >> 51) ^
+                    key->page_table_target_vaddr;
+
+    hash ^= (uint64_t)key->access_class << 32;
+    hash ^= key->actor;
+    hash ^= (uint64_t)(uint32_t)key->page_table_level << 29;
+    hash ^= (uint64_t)key->page_table_stage << 43;
+    hash ^= (uint64_t)key->initiating_access_class << 47;
+    hash ^= (uint64_t)key->has_instruction << 61;
+    hash ^= (uint64_t)key->streaming << 62;
+    hash ^= hash >> 33;
+    hash *= UINT64_C(0xff51afd7ed558ccd);
+    hash ^= hash >> 33;
+    return hash ^ (hash >> 32);
+}
+
+static gboolean node_memory_retry_key_equal(gconstpointer left_opaque,
+                                             gconstpointer right_opaque)
+{
+    const CrucibleMemoryRetryKey *left = left_opaque;
+    const CrucibleMemoryRetryKey *right = right_opaque;
+
+    return left->address == right->address &&
+           left->length == right->length &&
+           left->observed_icount == right->observed_icount &&
+           left->instruction_pc == right->instruction_pc &&
+           left->page_table_target_vaddr == right->page_table_target_vaddr &&
+           left->access_class == right->access_class &&
+           left->actor == right->actor &&
+           left->page_table_level == right->page_table_level &&
+           left->page_table_stage == right->page_table_stage &&
+           left->initiating_access_class == right->initiating_access_class &&
+           left->has_instruction == right->has_instruction &&
+           left->streaming == right->streaming;
+}
+
+static CrucibleMemoryRetryKey node_memory_retry_key(
+    const CrucibleMemoryTransaction *transaction)
+{
+    /*
+     * An instruction-backed retry is independent of elapsed virtual time and
+     * translation-block shape.  Its TB-local instruction ordinal may change
+     * when fault delivery forces retranslation, so it is deliberately absent
+     * from the retry identity.  Accesses without a decoded instruction use
+     * the observed clock as their only available execution-episode identity.
+     */
+    return (CrucibleMemoryRetryKey) {
+        .address = transaction->address,
+        .length = transaction->streaming ? 0 : transaction->preflight_length,
+        .observed_icount = transaction->has_instruction ? 0 :
+                           transaction->observed_icount,
+        .instruction_pc = transaction->instruction_pc,
+        .page_table_target_vaddr =
+            transaction->page_table_target_vaddr,
+        .access_class = transaction->access_class,
+        .actor = transaction->actor,
+        .page_table_level = transaction->page_table_level,
+        .page_table_stage = transaction->page_table_stage,
+        .initiating_access_class = transaction->initiating_access_class,
+        .has_instruction = transaction->has_instruction,
+        .streaming = transaction->streaming,
+    };
+}
+
+static void node_memory_retry_evict_oldest(void)
+{
+    GHashTableIter iter;
+    gpointer key;
+    gpointer value;
+    gpointer oldest_key = NULL;
+    uint64_t oldest_sequence = UINT64_MAX;
+
+    g_hash_table_iter_init(&iter, crucible_memory_retry_states);
+    while (g_hash_table_iter_next(&iter, &key, &value)) {
+        CrucibleMemoryRetryState *state = value;
+
+        if (state->last_access_sequence < oldest_sequence) {
+            oldest_key = key;
+            oldest_sequence = state->last_access_sequence;
+        }
+    }
+    g_assert(oldest_key);
+    g_hash_table_remove(crucible_memory_retry_states, oldest_key);
+}
+
+static void node_memory_retry_finish(
+    const CrucibleMemoryTransaction *transaction)
+{
+    CrucibleMemoryRetryKey key = node_memory_retry_key(transaction);
+    CrucibleMemoryRetryState *state = g_hash_table_lookup(
+        crucible_memory_retry_states, &key);
+
+    if (!transaction->poisoned) {
+        if (state) {
+            g_hash_table_remove(crucible_memory_retry_states, &key);
+        }
+        return;
+    }
+    if (!state) {
+        CrucibleMemoryRetryKey *stored_key;
+
+        if (g_hash_table_size(crucible_memory_retry_states) ==
+            CRUCIBLE_NODE_MEMORY_RETRY_LIMIT) {
+            node_memory_retry_evict_oldest();
+        }
+        stored_key = g_new(CrucibleMemoryRetryKey, 1);
+        *stored_key = key;
+        state = g_new0(CrucibleMemoryRetryState, 1);
+        g_hash_table_insert(crucible_memory_retry_states, stored_key, state);
+    }
+    state->last_access_sequence = transaction->identity;
+    state->retry_ordinal = transaction->retry_ordinal;
+}
+
+static void node_memory_transaction_begin(
+    enum QemuCrucibleMemoryAccessClass access_class, uint32_t actor,
+    uint64_t address, size_t length, uint64_t observed_icount,
+    bool has_instruction, uint64_t instruction_pc,
+    uint32_t instruction_ordinal,
+    bool streaming, bool automatic_preflight,
+    const CrucibleMemoryPageTableIdentity *page_table)
+{
+    CrucibleMemoryTransaction *transaction = &crucible_memory_transaction;
+    CrucibleMemoryRetryKey retry_key;
+    CrucibleMemoryRetryState *retry_state;
+
+    if (!qemu_crucible_fault_memory_rules_active()) {
+        return;
+    }
+    qemu_mutex_lock(&crucible_memory_transaction_lock);
+    if (transaction->active) {
+        error_report("Nested Crucible memory transaction is ambiguous");
+        abort();
+    }
+    if ((!streaming && length == 0) ||
+        (length != 0 && address > UINT64_MAX - (length - 1))) {
+        error_report("Crucible memory transaction range is invalid");
+        abort();
+    }
+    if (crucible_memory_access_sequence == UINT64_MAX) {
+        error_report("Crucible memory transaction sequence overflow");
+        abort();
+    }
+    memset(transaction, 0, sizeof(*transaction));
+    if (crucible_memory_pending_services) {
+        g_array_set_size(crucible_memory_pending_services, 0);
+        g_hash_table_remove_all(crucible_memory_pending_service_index);
+    }
+    if (!crucible_memory_transaction_poison) {
+        crucible_memory_transaction_poison = g_hash_table_new(
+            g_direct_hash, g_direct_equal);
+    } else {
+        g_hash_table_remove_all(crucible_memory_transaction_poison);
+    }
+    node_memory_service_plan_reset();
+    if (crucible_memory_transaction_occurrences) {
+        g_hash_table_remove_all(crucible_memory_transaction_occurrences);
+    }
+    if (crucible_memory_transaction_rows) {
+        g_hash_table_remove_all(crucible_memory_transaction_rows);
+    }
+    if (crucible_memory_transaction_state_opportunities) {
+        g_hash_table_remove_all(
+            crucible_memory_transaction_state_opportunities);
+    }
+    if (crucible_memory_transaction_state_applied) {
+        g_hash_table_remove_all(crucible_memory_transaction_state_applied);
+    }
+    transaction->active = true;
+    transaction->lock_held = true;
+    transaction->access_class = access_class;
+    transaction->actor = actor;
+    transaction->address = address;
+    transaction->length = length;
+    transaction->preflight_length = length;
+    transaction->observed_icount = observed_icount;
+    transaction->has_instruction = has_instruction;
+    transaction->streaming = streaming;
+    transaction->instruction_pc = instruction_pc;
+    transaction->instruction_ordinal = instruction_ordinal;
+    if (page_table) {
+        transaction->page_table_target_vaddr = page_table->target_vaddr;
+        transaction->page_table_level = page_table->level;
+        transaction->page_table_stage = page_table->stage;
+        transaction->initiating_access_class =
+            page_table->initiating_access_class;
+    }
+    transaction->identity = ++crucible_memory_access_sequence;
+    transaction->event_count_start = crucible_node_event_count;
+    if (!crucible_memory_retry_states) {
+        crucible_memory_retry_states = g_hash_table_new_full(
+            node_memory_retry_key_hash, node_memory_retry_key_equal,
+            g_free, g_free);
+    }
+    retry_key = node_memory_retry_key(transaction);
+    retry_state = g_hash_table_lookup(crucible_memory_retry_states,
+                                      &retry_key);
+    if (retry_state) {
+        if (retry_state->retry_ordinal == UINT32_MAX) {
+            error_report("Crucible memory retry ordinal overflow");
+            abort();
+        }
+        transaction->retry_ordinal = retry_state->retry_ordinal + 1;
+    }
+    if (!streaming && automatic_preflight) {
+        node_memory_transaction_preflight(access_class, actor, address,
+                                          length, transaction->identity);
+    }
+}
+
+void qemu_crucible_fault_memory_transaction_begin(
+    enum QemuCrucibleMemoryAccessClass access_class, uint32_t actor,
+    uint64_t address, size_t length, uint64_t observed_icount,
+    bool has_instruction, uint64_t instruction_pc,
+    uint32_t instruction_ordinal)
+{
+    node_memory_transaction_begin(
+        access_class, actor, address, length, observed_icount,
+        has_instruction, instruction_pc, instruction_ordinal, false, true,
+        NULL);
+}
+
+void qemu_crucible_fault_memory_dma_transaction_begin(
+    enum QemuCrucibleMemoryAccessClass access_class, uint32_t actor,
+    const AddressSpace *as, uint64_t iova, size_t length, MemTxAttrs attrs,
+    uint64_t observed_icount)
+{
+    if ((access_class != QEMU_CRUCIBLE_MEMORY_DMA_READ &&
+         access_class != QEMU_CRUCIBLE_MEMORY_DMA_WRITE) || !as) {
+        error_report("Invalid Crucible DMA memory transaction");
+        abort();
+    }
+    node_memory_transaction_begin(
+        access_class, actor, iova, length, observed_icount,
+        false, 0, 0, false, false, NULL);
+    if (crucible_memory_transaction.active) {
+        node_memory_transaction_preflight_dma(
+            access_class, actor, as, iova, length, attrs,
+            crucible_memory_transaction.identity);
+    }
+}
+
+void qemu_crucible_fault_memory_fetch_transaction_begin(
+    uint32_t actor, uint64_t address, uint64_t observed_icount,
+    uint64_t instruction_pc, uint32_t instruction_ordinal)
+{
+    node_memory_transaction_begin(
+        QEMU_CRUCIBLE_MEMORY_FETCH, actor, address, 0, observed_icount,
+        true, instruction_pc, instruction_ordinal, true, true, NULL);
+}
+
+bool qemu_crucible_fault_memory_fetch_transaction_extend(
+    uint64_t vaddr, uint64_t gpa, size_t length)
+{
+    CrucibleMemoryTransaction *transaction = &crucible_memory_transaction;
+    uint64_t end;
+
+    if (!transaction->active ||
+        transaction->access_class != QEMU_CRUCIBLE_MEMORY_FETCH ||
+        length == 0 || vaddr < transaction->address ||
+        vaddr > UINT64_MAX - length) {
+        error_report("Invalid Crucible instruction fetch fragment");
+        abort();
+    }
+    end = vaddr + length;
+    transaction->length = MAX(transaction->length,
+                              end - transaction->address);
+    transaction->preflight_length = transaction->length;
+    if (!transaction->fetch_fragments) {
+        transaction->fetch_fragments = g_array_new(
+            false, false, sizeof(CrucibleMemoryFetchFragment));
+    }
+    CrucibleMemoryFetchFragment fragment = {
+        .vaddr = vaddr,
+        .gpa = gpa,
+        .length = length,
+    };
+
+    g_array_append_val(transaction->fetch_fragments, fragment);
+    if (!node_memory_transaction_count_segment(
+            QEMU_CRUCIBLE_MEMORY_FETCH, transaction->actor, vaddr, gpa,
+            length, true, transaction->identity)) {
+        return false;
+    }
+    return true;
+}
+
+bool qemu_crucible_fault_memory_transaction_failed(void)
+{
+    return crucible_memory_transaction.active &&
+           crucible_memory_transaction.poisoned;
+}
+
+bool qemu_crucible_fault_memory_transaction_active(
+    enum QemuCrucibleMemoryAccessClass access_class)
+{
+    return crucible_memory_transaction.active &&
+           crucible_memory_transaction.access_class == access_class &&
+           crucible_memory_transaction.rule_snapshot &&
+           crucible_memory_transaction.rule_snapshot->len != 0;
+}
+
+bool qemu_crucible_fault_memory_transaction_exception(
+    CPUFaultException *exception)
+{
+    if (!crucible_memory_transaction.active ||
+        !crucible_memory_transaction.has_exception) {
+        return false;
+    }
+    *exception = crucible_memory_transaction.exception;
+    return true;
+}
+
+QemuCrucibleMemoryTransactionToken *
+qemu_crucible_fault_memory_transaction_detach(void)
+{
+    QemuCrucibleMemoryTransactionToken *token;
+    size_t emitted;
+
+    if (!crucible_memory_transaction.active) {
+        return NULL;
+    }
+    if (!crucible_memory_transaction.streaming &&
+        crucible_memory_pending_services &&
+        crucible_memory_pending_services->len != 0) {
+        error_report("Cannot detach a partially applied Crucible transaction");
+        abort();
+    }
+    token = g_new0(QemuCrucibleMemoryTransactionToken, 1);
+    token->transaction = crucible_memory_transaction;
+    token->poison = crucible_memory_transaction_poison;
+    crucible_memory_transaction_poison = NULL;
+    token->occurrences = crucible_memory_transaction_occurrences;
+    crucible_memory_transaction_occurrences = NULL;
+    token->rows = crucible_memory_transaction_rows;
+    crucible_memory_transaction_rows = NULL;
+    token->state_opportunities =
+        crucible_memory_transaction_state_opportunities;
+    crucible_memory_transaction_state_opportunities = NULL;
+    token->state_applied = crucible_memory_transaction_state_applied;
+    crucible_memory_transaction_state_applied = NULL;
+    token->service_plan = crucible_memory_service_plan;
+    token->service_plan_index = crucible_memory_service_plan_index;
+    crucible_memory_service_plan = NULL;
+    crucible_memory_service_plan_index = NULL;
+    token->pending_services = crucible_memory_pending_services;
+    token->pending_service_index = crucible_memory_pending_service_index;
+    crucible_memory_pending_services = NULL;
+    crucible_memory_pending_service_index = NULL;
+    emitted = crucible_node_event_count -
+              token->transaction.event_count_start;
+    emitted = MIN(emitted, token->transaction.event_budget);
+    token->reserved_events = token->transaction.event_budget - emitted;
+    if (crucible_node_event_reserved > SIZE_MAX - token->reserved_events) {
+        error_report("Crucible detached event reservation overflow");
+        abort();
+    }
+    crucible_node_event_reserved += token->reserved_events;
+    memset(&crucible_memory_transaction, 0,
+           sizeof(crucible_memory_transaction));
+    if (!token->transaction.streaming) {
+        token->transaction.lock_held = false;
+        qemu_mutex_unlock(&crucible_memory_transaction_lock);
+    }
+    return token;
+}
+
+void qemu_crucible_fault_memory_transaction_resume(
+    QemuCrucibleMemoryTransactionToken *token)
+{
+    if (!token) {
+        error_report("Crucible detached transaction cannot be resumed");
+        abort();
+    }
+    if (!token->transaction.lock_held) {
+        qemu_mutex_lock(&crucible_memory_transaction_lock);
+        token->transaction.lock_held = true;
+    }
+    if (crucible_memory_transaction.active ||
+        crucible_node_event_reserved < token->reserved_events) {
+        error_report("Crucible detached transaction cannot be resumed");
+        abort();
+    }
+    crucible_node_event_reserved -= token->reserved_events;
+    if (crucible_memory_transaction_poison) {
+        g_hash_table_unref(crucible_memory_transaction_poison);
+    }
+    g_clear_pointer(&crucible_memory_transaction_occurrences,
+                    g_hash_table_unref);
+    g_clear_pointer(&crucible_memory_transaction_rows,
+                    g_hash_table_unref);
+    g_clear_pointer(&crucible_memory_transaction_state_opportunities,
+                    g_hash_table_unref);
+    g_clear_pointer(&crucible_memory_transaction_state_applied,
+                    g_hash_table_unref);
+    g_clear_pointer(&crucible_memory_service_plan, g_array_unref);
+    g_clear_pointer(&crucible_memory_service_plan_index,
+                    g_hash_table_unref);
+    g_clear_pointer(&crucible_memory_pending_services, g_array_unref);
+    g_clear_pointer(&crucible_memory_pending_service_index,
+                    g_hash_table_unref);
+    crucible_memory_transaction_poison = token->poison;
+    token->poison = NULL;
+    crucible_memory_transaction_occurrences = token->occurrences;
+    token->occurrences = NULL;
+    crucible_memory_transaction_rows = token->rows;
+    token->rows = NULL;
+    crucible_memory_transaction_state_opportunities =
+        token->state_opportunities;
+    token->state_opportunities = NULL;
+    crucible_memory_transaction_state_applied = token->state_applied;
+    token->state_applied = NULL;
+    crucible_memory_service_plan = token->service_plan;
+    token->service_plan = NULL;
+    crucible_memory_service_plan_index = token->service_plan_index;
+    token->service_plan_index = NULL;
+    crucible_memory_pending_services = token->pending_services;
+    token->pending_services = NULL;
+    crucible_memory_pending_service_index = token->pending_service_index;
+    token->pending_service_index = NULL;
+    crucible_memory_transaction = token->transaction;
+    g_free(token);
+}
+
+void qemu_crucible_fault_memory_transaction_discard(
+    QemuCrucibleMemoryTransactionToken *token)
+{
+    if (!token) {
+        error_report("Crucible detached transaction cannot be discarded");
+        abort();
+    }
+    if (!token->transaction.lock_held) {
+        qemu_mutex_lock(&crucible_memory_transaction_lock);
+        token->transaction.lock_held = true;
+    }
+    if (crucible_memory_transaction.active ||
+        crucible_node_event_reserved < token->reserved_events) {
+        error_report("Crucible detached transaction cannot be discarded");
+        abort();
+    }
+    crucible_node_event_reserved -= token->reserved_events;
+    if (token->poison) {
+        g_hash_table_unref(token->poison);
+    }
+    g_clear_pointer(&token->occurrences, g_hash_table_unref);
+    g_clear_pointer(&token->rows, g_hash_table_unref);
+    g_clear_pointer(&token->state_opportunities, g_hash_table_unref);
+    g_clear_pointer(&token->state_applied, g_hash_table_unref);
+    node_memory_reservations_release(&token->transaction);
+    g_clear_pointer(&token->transaction.rule_snapshot, g_ptr_array_unref);
+    g_clear_pointer(&token->transaction.dma_fragments, g_array_unref);
+    g_clear_pointer(&token->transaction.dma_mutation_fragments,
+                    g_array_unref);
+    g_clear_pointer(&token->transaction.fetch_fragments, g_array_unref);
+    g_clear_pointer(&token->transaction.rule_reservations, g_array_unref);
+    g_clear_pointer(&token->transaction.row_reservations, g_array_unref);
+    g_clear_pointer(&token->transaction.retention_reservations,
+                    g_array_unref);
+    g_clear_pointer(&token->transaction.ledger_reservations, g_array_unref);
+    g_clear_pointer(&token->transaction.shadow_originals,
+                    g_hash_table_unref);
+    g_clear_pointer(&token->transaction.shadow_rules, g_hash_table_unref);
+    g_clear_pointer(&token->transaction.shadow_writes, g_array_unref);
+    g_clear_pointer(&token->transaction.staged_events, g_ptr_array_unref);
+    g_clear_pointer(&token->service_plan, g_array_unref);
+    g_clear_pointer(&token->service_plan_index, g_hash_table_unref);
+    g_clear_pointer(&token->pending_services, g_array_unref);
+    g_clear_pointer(&token->pending_service_index, g_hash_table_unref);
+    if (token->transaction.lock_held) {
+        qemu_mutex_unlock(&crucible_memory_transaction_lock);
+    }
+    g_free(token);
+}
+
+void qemu_crucible_fault_memory_transaction_resize(size_t length)
+{
+    CrucibleMemoryTransaction *transaction = &crucible_memory_transaction;
+
+    if (!transaction->active) {
+        return;
+    }
+    if (transaction->access_class != QEMU_CRUCIBLE_MEMORY_DMA_WRITE ||
+        length > transaction->preflight_length) {
+        error_report("Invalid Crucible mapped-DMA transaction length");
+        abort();
+    }
+    transaction->length = length;
+    if (length == transaction->preflight_length) {
+        return;
+    }
+    node_memory_reservations_release(transaction);
+    g_clear_pointer(&transaction->rule_reservations, g_array_unref);
+    g_clear_pointer(&transaction->row_reservations, g_array_unref);
+    g_clear_pointer(&transaction->retention_reservations, g_array_unref);
+    g_clear_pointer(&transaction->ledger_reservations, g_array_unref);
+    transaction->resources_preflighted = false;
+    node_memory_service_plan_reset();
+    if (length == 0) {
+        return;
+    }
+
+    g_autoptr(GHashTable) counter_rules = g_hash_table_new(
+        g_direct_hash, g_direct_equal);
+    g_autoptr(GHashTable) row_plans = g_hash_table_new_full(
+        g_direct_hash, g_direct_equal, NULL,
+        node_memory_row_resource_plan_free);
+    g_autoptr(GHashTable) retention_plans = g_hash_table_new_full(
+        g_direct_hash, g_direct_equal, NULL,
+        node_memory_retention_resource_plan_free);
+    uint64_t plan_offset = 0;
+    uint64_t remaining = length;
+
+    for (guint i = 0;
+         transaction->dma_fragments &&
+         i < transaction->dma_fragments->len && remaining != 0; i++) {
+        CrucibleMemoryDmaFragment *fragment = &g_array_index(
+            transaction->dma_fragments, CrucibleMemoryDmaFragment, i);
+        uint64_t part = MIN(remaining, fragment->length);
+
+        if (!node_memory_transaction_resources_segment(
+                transaction->access_class, transaction->actor,
+                fragment->gpa, fragment->gpa, part, false,
+                transaction->identity, counter_rules, row_plans,
+                retention_plans)) {
+            error_report(
+                "Crucible reduced DMA reservation unexpectedly failed");
+            abort();
+        }
+        plan_offset += part;
+        remaining -= part;
+    }
+    g_assert(plan_offset == length && remaining == 0);
+    if (!node_memory_transaction_resources_finish(
+            counter_rules, row_plans, retention_plans)) {
+        error_report("Crucible reduced DMA resource commit failed");
+        abort();
+    }
+}
+
+static void node_memory_fetch_transaction_commit(void)
+{
+    CrucibleMemoryTransaction *transaction = &crucible_memory_transaction;
+
+    g_assert(transaction->active && transaction->streaming &&
+             !transaction->poisoned);
+    if (transaction->shadow_rules) {
+        GHashTableIter iter;
+        gpointer original;
+        gpointer shadow;
+
+        g_hash_table_iter_init(&iter, transaction->shadow_rules);
+        while (g_hash_table_iter_next(&iter, &original, &shadow)) {
+            node_memory_shadow_state_commit(original, shadow);
+        }
+    }
+    for (guint i = 0;
+         transaction->shadow_writes &&
+         i < transaction->shadow_writes->len; i++) {
+        CrucibleMemoryShadowWrite *write = &g_array_index(
+            transaction->shadow_writes, CrucibleMemoryShadowWrite, i);
+
+        memory_region_fault_commit_ram(
+            write->mr, write->mr_addr, write->value->data,
+            write->value->len);
+    }
+    for (guint i = 0;
+         transaction->staged_events &&
+         i < transaction->staged_events->len; i++) {
+        CrucibleMemoryStagedEvent *event = g_ptr_array_index(
+            transaction->staged_events, i);
+
+        qemu_crucible_fault_rule_event(
+            event->rule, event->outcome, event->observed_icount,
+            event->opportunity_hash, event->before_hash,
+            event->after_hash, event->evidence->data,
+            event->evidence->len);
+        qemu_crucible_fault_notify_events();
+    }
+}
+
+bool qemu_crucible_fault_memory_fetch_transaction_finish(void)
+{
+    CrucibleMemoryTransaction *transaction = &crucible_memory_transaction;
+    g_autoptr(GHashTable) counter_rules = g_hash_table_new(
+        g_direct_hash, g_direct_equal);
+    g_autoptr(GHashTable) row_plans = g_hash_table_new_full(
+        g_direct_hash, g_direct_equal, NULL,
+        node_memory_row_resource_plan_free);
+    g_autoptr(GHashTable) retention_plans = g_hash_table_new_full(
+        g_direct_hash, g_direct_equal, NULL,
+        node_memory_retention_resource_plan_free);
+    size_t staged_count = transaction->staged_events ?
+        transaction->staged_events->len : 0;
+    size_t service_count = crucible_memory_pending_services ?
+        crucible_memory_pending_services->len : 0;
+
+    if (!transaction->active) {
+        return true;
+    }
+    if (!transaction->streaming) {
+        error_report("Crucible fetch finish used outside a fetch transaction");
+        abort();
+    }
+    if (staged_count > SIZE_MAX - service_count) {
+        error_report("Crucible fetch event count overflow");
+        abort();
+    }
+    if (staged_count + service_count != 0) {
+        QemuCrucibleFaultRule *rule = transaction->rule_snapshot &&
+            transaction->rule_snapshot->len != 0 ?
+            g_ptr_array_index(transaction->rule_snapshot, 0) : NULL;
+
+        g_assert(rule);
+        node_memory_boundary_match(rule, transaction->identity);
+        crucible_memory_preflight_collecting = true;
+        bool available = node_memory_event_capacity(
+            rule, staged_count + service_count,
+            QEMU_CRUCIBLE_MEMORY_FETCH, transaction->actor,
+            transaction->address, transaction->address,
+            transaction->length, transaction->observed_icount);
+        crucible_memory_preflight_collecting = false;
+        node_memory_boundary_match_done();
+        if (!available) {
+            transaction->poisoned = true;
+            transaction->resource_failed = true;
+            transaction->has_exception = false;
+            return false;
+        }
+    }
+    node_memory_service_plan_reset();
+    for (guint i = 0;
+         transaction->fetch_fragments &&
+         i < transaction->fetch_fragments->len; i++) {
+        CrucibleMemoryFetchFragment *fragment = &g_array_index(
+            transaction->fetch_fragments, CrucibleMemoryFetchFragment, i);
+
+        if (!node_memory_transaction_resources_segment(
+                QEMU_CRUCIBLE_MEMORY_FETCH, transaction->actor,
+                fragment->vaddr, fragment->gpa, fragment->length, true,
+                transaction->identity, counter_rules, row_plans,
+                retention_plans)) {
+            transaction->poisoned = true;
+            transaction->resource_failed = true;
+            transaction->has_exception = false;
+            return false;
+        }
+    }
+    if (!node_memory_transaction_resources_finish(
+            counter_rules, row_plans, retention_plans)) {
+        return false;
+    }
+
+    transaction->resources_preflighted = true;
+    return true;
+}
+
+void qemu_crucible_fault_memory_fetch_transaction_stage(CPUState *cpu)
+{
+    if (!cpu || cpu->crucible_fetch_transaction ||
+        !crucible_memory_transaction.active ||
+        !crucible_memory_transaction.streaming ||
+        crucible_memory_transaction.poisoned) {
+        error_report("Invalid Crucible fetch transaction staging");
+        abort();
+    }
+    cpu->crucible_fetch_transaction =
+        qemu_crucible_fault_memory_transaction_detach();
+    g_assert(cpu->crucible_fetch_transaction);
+}
+
+void qemu_crucible_fault_memory_fetch_stage_commit(CPUState *cpu)
+{
+    QemuCrucibleMemoryTransactionToken *token;
+
+    if (!cpu || !cpu->crucible_fetch_transaction) {
+        return;
+    }
+    token = cpu->crucible_fetch_transaction;
+    cpu->crucible_fetch_transaction = NULL;
+    qemu_crucible_fault_memory_transaction_resume(token);
+    node_memory_fetch_transaction_commit();
+    qemu_crucible_fault_memory_transaction_end();
+}
+
+void qemu_crucible_fault_memory_fetch_stage_discard(CPUState *cpu)
+{
+    QemuCrucibleMemoryTransactionToken *token;
+
+    if (!cpu || !cpu->crucible_fetch_transaction) {
+        return;
+    }
+    token = cpu->crucible_fetch_transaction;
+    cpu->crucible_fetch_transaction = NULL;
+    if (!token->transaction.streaming ||
+        token->transaction.identity == 0 ||
+        crucible_memory_access_sequence != token->transaction.identity) {
+        error_report("Invalid Crucible fetch transaction rollback");
+        abort();
+    }
+    crucible_memory_access_sequence--;
+    qemu_crucible_fault_memory_transaction_discard(token);
+}
+
+void qemu_crucible_fault_memory_transaction_end(void)
+{
+    GPtrArray *snapshot;
+    GArray *dma_fragments;
+    GArray *dma_mutation_fragments;
+    GArray *rule_reservations;
+    GArray *row_reservations;
+    GArray *retention_reservations;
+    GArray *ledger_reservations;
+    GArray *fetch_fragments;
+    GHashTable *shadow_rules;
+    GHashTable *shadow_originals;
+    GArray *shadow_writes;
+    GPtrArray *staged_events;
+    uint64_t service_delay = 0;
+    bool lock_held;
+
+    if (!crucible_memory_transaction.active) {
+        return;
+    }
+    if (!crucible_memory_transaction.poisoned) {
+        service_delay = node_memory_service_finish_transaction();
+    }
+    snapshot = crucible_memory_transaction.rule_snapshot;
+    crucible_memory_transaction.rule_snapshot = NULL;
+    dma_fragments = crucible_memory_transaction.dma_fragments;
+    crucible_memory_transaction.dma_fragments = NULL;
+    dma_mutation_fragments =
+        crucible_memory_transaction.dma_mutation_fragments;
+    crucible_memory_transaction.dma_mutation_fragments = NULL;
+    node_memory_reservations_release(&crucible_memory_transaction);
+    rule_reservations = crucible_memory_transaction.rule_reservations;
+    crucible_memory_transaction.rule_reservations = NULL;
+    row_reservations = crucible_memory_transaction.row_reservations;
+    crucible_memory_transaction.row_reservations = NULL;
+    retention_reservations =
+        crucible_memory_transaction.retention_reservations;
+    crucible_memory_transaction.retention_reservations = NULL;
+    ledger_reservations =
+        crucible_memory_transaction.ledger_reservations;
+    crucible_memory_transaction.ledger_reservations = NULL;
+    fetch_fragments = crucible_memory_transaction.fetch_fragments;
+    crucible_memory_transaction.fetch_fragments = NULL;
+    shadow_rules = crucible_memory_transaction.shadow_rules;
+    crucible_memory_transaction.shadow_rules = NULL;
+    shadow_originals = crucible_memory_transaction.shadow_originals;
+    crucible_memory_transaction.shadow_originals = NULL;
+    shadow_writes = crucible_memory_transaction.shadow_writes;
+    crucible_memory_transaction.shadow_writes = NULL;
+    staged_events = crucible_memory_transaction.staged_events;
+    crucible_memory_transaction.staged_events = NULL;
+    lock_held = crucible_memory_transaction.lock_held;
+    node_memory_retry_finish(&crucible_memory_transaction);
+    node_memory_service_plan_reset();
+    g_clear_pointer(&snapshot, g_ptr_array_unref);
+    g_clear_pointer(&dma_fragments, g_array_unref);
+    g_clear_pointer(&dma_mutation_fragments, g_array_unref);
+    g_clear_pointer(&rule_reservations, g_array_unref);
+    g_clear_pointer(&row_reservations, g_array_unref);
+    g_clear_pointer(&retention_reservations, g_array_unref);
+    g_clear_pointer(&ledger_reservations, g_array_unref);
+    g_clear_pointer(&fetch_fragments, g_array_unref);
+    g_clear_pointer(&shadow_originals, g_hash_table_unref);
+    g_clear_pointer(&shadow_rules, g_hash_table_unref);
+    g_clear_pointer(&shadow_writes, g_array_unref);
+    g_clear_pointer(&staged_events, g_ptr_array_unref);
+    memset(&crucible_memory_transaction, 0,
+           sizeof(crucible_memory_transaction));
+    if (lock_held) {
+        qemu_mutex_unlock(&crucible_memory_transaction_lock);
+    }
+    if (service_delay != 0 && current_cpu && current_cpu->running &&
+        !current_cpu->neg.can_do_io) {
+        if (current_cpu->crucible_memory_service_nanos >
+            UINT64_MAX - service_delay) {
+            error_report("Crucible memory service staging overflow");
+            abort();
+        }
+        current_cpu->crucible_memory_service_nanos += service_delay;
+        qatomic_set_mb(&current_cpu->exit_request, 1);
+    } else {
+        node_memory_apply_service(service_delay);
+    }
+}
+
+static bool node_memory_runtime_resources_ready(
+    size_t match_count, uint32_t access_class, uint32_t vcpu,
+    uint64_t vaddr, uint64_t gpa, size_t length, uint64_t observed_icount)
+{
+    QemuCrucibleFaultRule *service_rule = NULL;
+
+    if (crucible_memory_transaction.active &&
+        crucible_memory_transaction.poisoned) {
+        return false;
+    }
+    if (crucible_memory_transaction.active &&
+        crucible_memory_transaction.streaming) {
+        return true;
+    }
+    if (crucible_memory_transaction.active &&
+        crucible_memory_transaction.resources_preflighted) {
+        return true;
+    }
+    if (!crucible_memory_transaction.active) {
+        node_memory_service_plan_reset();
+    }
+    for (size_t i = 0; i < match_count; i++) {
+        QemuCrucibleFaultRule *rule = crucible_memory_matches[i];
+        size_t offset, selected;
+        uint64_t rule_offset;
+
+        if (!node_rule_memory_overlap(rule, vcpu, vaddr, gpa, length,
+                                      &offset, &selected, &rule_offset)) {
+            continue;
+        }
+        if (rule->command_kind ==
+            CRUCIBLE_FAULT_COMMAND_MEMORY_ACCESS_TRANSFORM) {
+            uint32_t classes;
+
+            g_assert(node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P8,
+                                    &classes));
+            if ((classes & access_class) == 0) {
+                continue;
+            }
+        }
+        if (!node_memory_rule_resources_ready(rule)) {
+            node_memory_counter_terminal_metadata(UINT64_MAX);
+            node_memory_resource_terminal(
+                rule, access_class, vcpu, vaddr + offset, gpa + offset,
+                selected, observed_icount);
+            return false;
+        }
+        if (rule->command_kind ==
+            CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE) {
+            uint32_t kind;
+
+            g_assert(node_field_u32(rule,
+                                    CRUCIBLE_NODE_FAULT_FIELD_P3,
+                                    &kind));
+            if (kind == 3) {
+                QDict *process = qobject_to(
+                    QDict, node_field(rule,
+                        CRUCIBLE_NODE_FAULT_FIELD_P4)->json);
+                QDict *parameters = qdict_get_qdict(
+                    process, "parameters");
+
+                if (!node_memory_rowhammer_resources_ready(
+                        rule, parameters, rule_offset, selected)) {
+                    node_memory_resource_terminal(
+                        rule, access_class, vcpu, vaddr + offset,
+                        gpa + offset, selected, observed_icount);
+                    return false;
+                }
+            }
+        }
+        if (rule->command_kind == CRUCIBLE_FAULT_COMMAND_MEMORY_SERVICE) {
+            service_rule = rule;
+            if (!node_memory_service_plan_add(rule, selected)) {
+                node_memory_resource_terminal(
+                    rule, access_class, vcpu, vaddr + offset, gpa + offset,
+                    selected, observed_icount);
+                return false;
+            }
+        }
+    }
+    if (service_rule && !node_memory_service_plan_valid()) {
+        node_memory_resource_terminal(
+            service_rule, access_class, vcpu, vaddr, gpa, length,
+            observed_icount);
+        return false;
+    }
+    return true;
+}
+
+bool qemu_crucible_fault_memory_dma_fragment(
+    uint64_t offset, MemoryRegion **mr, uint64_t *mr_addr,
+    uint64_t *gpa, size_t *length)
+{
+    CrucibleMemoryTransaction *transaction = &crucible_memory_transaction;
+    uint64_t plan_offset = 0;
+
+    if (!mr || !mr_addr || !gpa || !length || *length == 0 ||
+        !transaction->active ||
+        (transaction->access_class != QEMU_CRUCIBLE_MEMORY_DMA_READ &&
+         transaction->access_class != QEMU_CRUCIBLE_MEMORY_DMA_WRITE) ||
+        !transaction->dma_fragments || offset >= transaction->length) {
+        return false;
+    }
+    node_memory_transaction_preflight_dma_poison();
+    if (transaction->poisoned) {
+        return false;
+    }
+    for (guint i = 0; i < transaction->dma_fragments->len; i++) {
+        CrucibleMemoryDmaFragment *fragment = &g_array_index(
+            transaction->dma_fragments, CrucibleMemoryDmaFragment, i);
+        uint64_t fragment_end;
+        uint64_t within;
+
+        if (plan_offset > UINT64_MAX - fragment->length) {
+            error_report("Crucible DMA fragment plan overflow");
+            abort();
+        }
+        fragment_end = plan_offset + fragment->length;
+        if (offset >= fragment_end) {
+            plan_offset = fragment_end;
+            continue;
+        }
+        within = offset - plan_offset;
+        if (fragment->gpa > UINT64_MAX - within ||
+            fragment->mr_addr > UINT64_MAX - within) {
+            error_report("Crucible DMA frozen fragment overflow");
+            abort();
+        }
+        *mr = fragment->mr;
+        *mr_addr = fragment->mr_addr + within;
+        *gpa = fragment->gpa + within;
+        *length = MIN((uint64_t)*length, fragment->length - within);
+        *length = MIN((uint64_t)*length, transaction->length - offset);
+        return true;
+    }
+    return false;
+}
+
+QemuCrucibleMemoryAccessResult qemu_crucible_fault_memory_access(
+    enum QemuCrucibleMemoryAccessClass access_class, uint32_t vcpu,
+    uint64_t vaddr, uint64_t gpa, const uint8_t *before, uint8_t *value,
+    size_t length, bool atomic, uint64_t observed_icount)
+{
+    QemuCrucibleMemoryAccessResult result = { 0 };
+    bool post_state = false;
+    uint64_t service_latency = 0;
+    uint64_t service_queue = 0;
+    size_t match_count;
+    uint8_t commit_mask[4096];
+    uint8_t shadow_before[4096];
+    bool write_access = access_class == QEMU_CRUCIBLE_MEMORY_CPU_STORE ||
+                        access_class == QEMU_CRUCIBLE_MEMORY_DMA_WRITE;
+
+    if ((!qemu_crucible_fault_memory_rules_active() &&
+         !crucible_memory_transaction.active) ||
+        !before || !value || length == 0) {
+        return result;
+    }
+    if (crucible_memory_post_state.active ||
+        length > sizeof(crucible_memory_post_state.before)) {
+        error_report("Crucible memory post-access state was not finalized");
+        abort();
+    }
+    if (write_access) {
+        memset(commit_mask, UINT8_MAX, length);
+    }
+    if (crucible_memory_transaction.active &&
+        crucible_memory_transaction.streaming) {
+        g_assert(access_class == QEMU_CRUCIBLE_MEMORY_FETCH);
+        memcpy(shadow_before, before, length);
+        node_memory_shadow_read(gpa, shadow_before, length);
+        memcpy(value, shadow_before, length);
+        before = shadow_before;
+    }
+    match_count = node_memory_matching_rules(
+        vcpu, vaddr, gpa, length,
+        access_class != QEMU_CRUCIBLE_MEMORY_DMA_READ &&
+        access_class != QEMU_CRUCIBLE_MEMORY_DMA_WRITE &&
+        access_class != QEMU_CRUCIBLE_MEMORY_PAGE_TABLE_WALK);
+    if (!crucible_memory_transaction.active && match_count != 0 &&
+        !node_memory_event_capacity(crucible_memory_matches[0], match_count,
+                                    access_class, vcpu, vaddr, gpa, length,
+                                    observed_icount)) {
+        result.access_error = true;
+        node_memory_matching_rules_done();
+        return result;
+    }
+    if (!node_memory_runtime_resources_ready(
+            match_count, access_class, vcpu, vaddr, gpa, length,
+            observed_icount)) {
+        result.access_error = true;
+        node_memory_matching_rules_done();
+        return result;
+    }
+    if (node_memory_poison_preflight(
+            access_class, vcpu, vaddr, gpa, before, value, length,
+            observed_icount, match_count)) {
+        result.access_error = true;
+        node_memory_matching_rules_done();
+        return result;
+    }
+    for (size_t i = 0; i < match_count; i++) {
+        QemuCrucibleFaultRule *rule = crucible_memory_matches[i];
+        size_t offset, selected;
+        uint64_t rule_offset;
+
+        if (rule->command_kind !=
+                CRUCIBLE_FAULT_COMMAND_MEMORY_ACCESS_TRANSFORM &&
+            rule->command_kind != CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE &&
+            rule->command_kind != CRUCIBLE_FAULT_COMMAND_MEMORY_SERVICE) {
+            continue;
+        }
+        if (!node_rule_memory_overlap(rule, vcpu, vaddr, gpa, length, &offset,
+                                      &selected, &rule_offset)) {
+            if (rule->translation_stale &&
+                !rule->translation_error_reported) {
+                node_memory_event_span(0, 0);
+                node_memory_event(rule, CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR,
+                                  access_class, vcpu, vaddr, gpa, before,
+                                  value, length, observed_icount);
+                rule->translation_error_reported = true;
+            }
+            continue;
+        }
+        node_memory_event_span(offset, selected);
+        if (rule->command_kind == CRUCIBLE_FAULT_COMMAND_MEMORY_SERVICE) {
+            node_memory_state_opportunity(rule);
+            node_memory_state_applied(rule);
+            if (crucible_memory_transaction.active) {
+                node_memory_service_defer(
+                    rule, access_class, vcpu, vaddr + offset, gpa + offset,
+                    before + offset, value + offset, selected,
+                    observed_icount);
+                continue;
+            }
+            uint64_t latency;
+            uint64_t delay = node_memory_service(rule, selected, &latency);
+
+            if (service_latency > UINT64_MAX - latency) {
+                error_report("Crucible memory latency sum overflow");
+                abort();
+            }
+            service_latency += latency;
+            service_queue = MAX(service_queue, delay);
+            node_memory_event(rule, CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED,
+                              access_class, vcpu, vaddr, gpa, before, value,
+                              length, observed_icount);
+            continue;
+        }
+        if (rule->command_kind ==
+            CRUCIBLE_FAULT_COMMAND_MEMORY_ACCESS_TRANSFORM) {
+            uint32_t classes, kind;
+            bool violate_atomicity;
+            uint16_t outcome = CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED;
+
+            g_assert(node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P8,
+                                    &classes));
+            g_assert(node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P3,
+                                    &kind));
+            if ((classes & access_class) == 0 ||
+                (kind == 5 ? !crucible_memory_poison_occurs[i] :
+                 !node_memory_rule_occurs(rule,
+                                          CRUCIBLE_NODE_FAULT_FIELD_P7))) {
+                continue;
+            }
+            g_assert(node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_P9,
+                                     &violate_atomicity));
+            if (atomic && kind == 4 && !violate_atomicity) {
+                g_assert(rule->applied_count != 0);
+                rule->applied_count--;
+                node_memory_event(rule,
+                                  CRUCIBLE_FAULT_EVENT_OUTCOME_PASSED,
+                                  access_class, vcpu, vaddr, gpa, before, value,
+                                  length, observed_icount);
+                continue;
+            }
+            if (kind == 1 || kind == 2) {
+                node_repeated_transform(
+                    value + offset, before + offset, selected, rule_offset,
+                    node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P4),
+                    node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P6), kind);
+            } else if (kind == 3) {
+                memcpy(value + offset, before + offset, selected);
+                memset(commit_mask + offset, 0, selected);
+                outcome = CRUCIBLE_FAULT_EVENT_OUTCOME_SUPPRESSED;
+            } else if (kind == 4) {
+                CrucibleNodeField *selector = node_field(
+                    rule, CRUCIBLE_NODE_FAULT_FIELD_P6);
+
+                node_repeated_transform(
+                    value + offset, before + offset, selected, rule_offset,
+                    selector, NULL, kind);
+                for (size_t byte = 0; byte < selected; byte++) {
+                    commit_mask[offset + byte] &=
+                        selector->data[(rule_offset + byte) %
+                                       selector->length];
+                }
+            } else {
+                CrucibleNodeField *poison_field =
+                    node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P6);
+                QDict *poison = qobject_to(QDict, poison_field->json);
+                const char *poison_kind = qdict_get_try_str(poison, "kind");
+
+                if (strcmp(poison_kind, "corrected") == 0) {
+                    QDict *parameters = qobject_to(
+                        QDict, qdict_get(poison, "parameters"));
+                    const char *mask = qdict_get_str(parameters, "xor_mask");
+                    size_t mask_len = strlen(mask) / 2;
+
+                    for (size_t byte = 0; byte < selected; byte++) {
+                        unsigned parsed;
+                        size_t index = (rule_offset + byte) % mask_len;
+
+                        g_assert(sscanf(mask + index * 2, "%2x", &parsed) == 1);
+                        value[offset + byte] ^= parsed;
+                    }
+                    outcome = CRUCIBLE_FAULT_EVENT_OUTCOME_CORRECTED;
+                } else {
+                    g_assert_not_reached();
+                }
+            }
+            node_memory_event(rule, outcome,
+                              access_class, vcpu, vaddr, gpa, before, value,
+                              length, observed_icount);
+            continue;
+        }
+        if (rule->command_kind == CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE) {
+            uint32_t region_kind;
+            QDict *process;
+            bool state_changed = true;
+
+            node_memory_state_opportunity(rule);
+            g_assert(node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P3,
+                                    &region_kind));
+            process = qobject_to(
+                QDict, node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P4)->json);
+            node_memory_mutation_evidence_reset(rule);
+            if (region_kind != 1 &&
+                (access_class == QEMU_CRUCIBLE_MEMORY_CPU_STORE ||
+                 access_class == QEMU_CRUCIBLE_MEMORY_DMA_WRITE)) {
+                post_state = true;
+                continue;
+            }
+            if (region_kind == 1) {
+                QDict *parameters = qdict_get_qdict(process, "parameters");
+                QDict *policy = qdict_get_qdict(parameters, "policy");
+                const char *policy_kind = qdict_get_str(policy, "kind");
+
+                if (strcmp(policy_kind, "corrected") == 0) {
+                    QDict *corrected = qdict_get_qdict(policy, "parameters");
+                    const char *mask = qdict_get_str(corrected, "xor_mask");
+                    size_t mask_len = strlen(mask) / 2;
+
+                    for (size_t byte = 0; byte < selected; byte++) {
+                        unsigned parsed;
+                        size_t index = (rule_offset + byte) % mask_len;
+
+                        g_assert(sscanf(mask + index * 2, "%2x", &parsed) == 1);
+                        value[offset + byte] ^= parsed;
+                    }
+                    node_memory_state_applied(rule);
+                    node_memory_event(
+                        rule, CRUCIBLE_FAULT_EVENT_OUTCOME_CORRECTED,
+                        access_class, vcpu, vaddr, gpa, before, value,
+                        length, observed_icount);
+                } else {
+                    g_assert_not_reached();
+                }
+            } else if (region_kind == 2) {
+                QDict *parameters = qdict_get_qdict(process, "parameters");
+                uint64_t now = node_virtual_now();
+
+                node_memory_mutation_evidence_reset(rule);
+                bool decayed = node_memory_apply_retention(
+                    rule, parameters, rule_offset, value + offset, selected,
+                    now);
+
+                state_changed = decayed;
+            } else {
+                QDict *parameters = qdict_get_qdict(process, "parameters");
+
+                node_memory_mutation_evidence_reset(rule);
+                state_changed = true;
+                (void)node_memory_apply_rowhammer(
+                    rule, parameters, rule_offset, selected);
+            }
+            if (region_kind != 1) {
+                uint16_t outcome = state_changed ?
+                    CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED :
+                    CRUCIBLE_FAULT_EVENT_OUTCOME_PASSED;
+
+                if (state_changed) {
+                    node_memory_state_applied(rule);
+                }
+                node_memory_event(rule, outcome,
+                                  access_class, vcpu, vaddr, gpa, before,
+                                  value, length, observed_icount);
+            }
+        }
+    }
+    if (write_access) {
+        bool partial = false;
+
+        for (size_t byte = 0; byte < length; byte++) {
+            partial |= commit_mask[byte] != UINT8_MAX;
+        }
+        if (partial) {
+            bool commits_any_bit = false;
+
+            for (size_t byte = 0; byte < length; byte++) {
+                commits_any_bit |= commit_mask[byte] != 0;
+                value[byte] = (before[byte] & ~commit_mask[byte]) |
+                              (value[byte] & commit_mask[byte]);
+            }
+            result.suppress_write = !commits_any_bit;
+        }
+    }
+    if (post_state) {
+        crucible_memory_post_state.active = true;
+        crucible_memory_post_state.access_class = access_class;
+        crucible_memory_post_state.vcpu = vcpu;
+        crucible_memory_post_state.vaddr = vaddr;
+        crucible_memory_post_state.gpa = gpa;
+        crucible_memory_post_state.length = length;
+        crucible_memory_post_state.observed_icount = observed_icount;
+        crucible_memory_post_state.access_sequence =
+            crucible_memory_current_access;
+        memcpy(crucible_memory_post_state.before, before, length);
+        memcpy(crucible_memory_post_state.commit_mask, commit_mask, length);
+    }
+    if (service_latency > UINT64_MAX - service_queue) {
+        error_report("Crucible memory completion delay overflow");
+        abort();
+    }
+    result.service_nanos = service_latency + service_queue;
+    node_memory_apply_service(result.service_nanos);
+    node_memory_matching_rules_done();
+    return result;
+}
+
+void qemu_crucible_fault_memory_access_finish(const uint8_t *after,
+                                              size_t length)
+{
+    CrucibleMemoryPostState *post = &crucible_memory_post_state;
+    size_t match_count;
+
+    if (!post->active) {
+        return;
+    }
+    if (!after || length != post->length) {
+        error_report("Crucible memory post-access identity changed");
+        abort();
+    }
+    match_count = node_memory_matching_rules_at(
+        post->vcpu, post->vaddr, post->gpa, post->length,
+        post->access_class != QEMU_CRUCIBLE_MEMORY_DMA_WRITE,
+        post->access_sequence);
+    for (size_t i = 0; i < match_count; i++) {
+        QemuCrucibleFaultRule *rule = crucible_memory_matches[i];
+        size_t offset, selected;
+        uint64_t rule_offset;
+        uint32_t region_kind;
+        QDict *process;
+
+        if (rule->command_kind !=
+                CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE ||
+            !node_rule_memory_overlap(
+                rule, post->vcpu, post->vaddr, post->gpa, post->length,
+                &offset, &selected, &rule_offset)) {
+            continue;
+        }
+        node_memory_event_span(offset, selected);
+        g_assert(node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P3,
+                                &region_kind));
+        node_memory_mutation_evidence_reset(rule);
+        if (region_kind == 1) {
+            continue;
+        }
+        process = qobject_to(
+            QDict, node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P4)->json);
+        if (region_kind == 2) {
+            bool refreshed;
+
+            node_memory_mutation_evidence_reset(rule);
+            refreshed = node_memory_refresh_retention(
+                rule, rule_offset, post->commit_mask + offset, selected,
+                node_virtual_now());
+            if (refreshed) {
+                node_memory_state_applied(rule);
+            }
+            node_memory_event(
+                rule, refreshed ? CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED :
+                                  CRUCIBLE_FAULT_EVENT_OUTCOME_PASSED,
+                post->access_class, post->vcpu, post->vaddr, post->gpa,
+                post->before, after, post->length, post->observed_icount);
+        } else {
+            node_memory_mutation_evidence_reset(rule);
+            (void)node_memory_apply_rowhammer(
+                rule, qdict_get_qdict(process, "parameters"), rule_offset,
+                selected);
+            node_memory_state_applied(rule);
+            node_memory_event(
+                rule, CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED,
+                post->access_class, post->vcpu, post->vaddr, post->gpa,
+                post->before, after, post->length, post->observed_icount);
+        }
+    }
+    node_memory_matching_rules_done();
+    memset(post, 0, sizeof(*post));
+}
+
+void qemu_crucible_fault_memory_page_table_walk_context_begin(
+    CPUState *cpu, uint64_t target_vaddr,
+    enum QemuCrucibleMemoryAccessClass initiating_access_class,
+    bool has_instruction, uint64_t instruction_pc,
+    uint32_t instruction_ordinal)
+{
+    if (!cpu ||
+        (initiating_access_class != QEMU_CRUCIBLE_MEMORY_FETCH &&
+         initiating_access_class != QEMU_CRUCIBLE_MEMORY_CPU_LOAD &&
+         initiating_access_class != QEMU_CRUCIBLE_MEMORY_CPU_STORE)) {
+        error_report("Invalid Crucible page-table walk context");
+        abort();
+    }
+    cpu->crucible_page_table_walk_active = true;
+    cpu->crucible_page_table_walk_has_instruction = has_instruction;
+    cpu->crucible_page_table_walk_access_class = initiating_access_class;
+    cpu->crucible_page_table_walk_instruction_ordinal =
+        instruction_ordinal;
+    cpu->crucible_page_table_walk_target_vaddr = target_vaddr;
+    cpu->crucible_page_table_walk_instruction_pc = instruction_pc;
+}
+
+void qemu_crucible_fault_memory_page_table_walk_context_end(CPUState *cpu)
+{
+    if (cpu) {
+        cpu->crucible_page_table_walk_active = false;
+    }
+}
+
+bool qemu_crucible_fault_memory_page_table_walk_context_active(
+    const CPUState *cpu)
+{
+    return cpu && cpu->crucible_page_table_walk_active;
+}
+
+bool qemu_crucible_fault_memory_page_table_walk(
+    CPUState *cpu, uint64_t entry_gpa, int32_t level, uint32_t stage,
+    const uint8_t *before, uint8_t *value, size_t length)
+{
+    CrucibleMemoryTransaction *transaction = &crucible_memory_transaction;
+    CrucibleMemoryPageTableIdentity page_table;
+    QemuCrucibleMemoryAccessResult result;
+    uint64_t observed_icount;
+    uint32_t initiating_access_class;
+
+    if (!qemu_crucible_fault_memory_page_table_walk_rules_active() ||
+        !qemu_crucible_fault_memory_page_table_walk_context_active(cpu)) {
+        return false;
+    }
+    initiating_access_class =
+        cpu->crucible_page_table_walk_access_class;
+    if (!cpu || !before || !value || (length != 4 && length != 8) ||
+        (stage != 1 && stage != 2) || level < -1 || level > 5 ||
+        (initiating_access_class != QEMU_CRUCIBLE_MEMORY_FETCH &&
+         initiating_access_class != QEMU_CRUCIBLE_MEMORY_CPU_LOAD &&
+         initiating_access_class != QEMU_CRUCIBLE_MEMORY_CPU_STORE)) {
+        error_report("Invalid Crucible page-table walk opportunity");
+        abort();
+    }
+    page_table = (CrucibleMemoryPageTableIdentity) {
+        .target_vaddr = cpu->crucible_page_table_walk_target_vaddr,
+        .level = level,
+        .stage = stage,
+        .initiating_access_class = initiating_access_class,
+    };
+    observed_icount = qemu_crucible_fault_observed_icount();
+    node_memory_transaction_begin(
+        QEMU_CRUCIBLE_MEMORY_PAGE_TABLE_WALK, cpu->cpu_index,
+        entry_gpa, length, observed_icount,
+        cpu->crucible_page_table_walk_has_instruction,
+        cpu->crucible_page_table_walk_instruction_pc,
+        cpu->crucible_page_table_walk_instruction_ordinal,
+        false, false, &page_table);
+    if (!transaction->active) {
+        return false;
+    }
+    node_memory_transaction_preflight_physical(
+        QEMU_CRUCIBLE_MEMORY_PAGE_TABLE_WALK, cpu->cpu_index,
+        page_table.target_vaddr, entry_gpa, length, transaction->identity);
+    result = qemu_crucible_fault_memory_access(
+        QEMU_CRUCIBLE_MEMORY_PAGE_TABLE_WALK, cpu->cpu_index,
+        page_table.target_vaddr, entry_gpa, before, value, length, false,
+        observed_icount);
+    qemu_crucible_fault_memory_transaction_end();
+    return result.access_error;
+}
+
+QemuCrucibleMemoryAccessResult qemu_crucible_fault_memory_atomic(
+    uint32_t vcpu, uint64_t vaddr, uint64_t gpa, const uint8_t *before,
+    uint8_t *visible, uint8_t *committed, size_t length,
+    bool write_happened, uint64_t observed_icount)
+{
+    QemuCrucibleMemoryAccessResult result = { 0 };
+    uint32_t access_classes = QEMU_CRUCIBLE_MEMORY_CPU_LOAD |
+        (write_happened ? QEMU_CRUCIBLE_MEMORY_CPU_STORE : 0);
+    size_t match_count;
+    uint64_t service_latency = 0;
+    uint64_t service_queue = 0;
+    uint8_t commit_mask[16];
+
+    if (!qemu_crucible_fault_memory_rules_active() || !before || !visible ||
+        !committed || length == 0) {
+        return result;
+    }
+    memset(commit_mask, UINT8_MAX, length);
+    match_count = node_memory_matching_rules(vcpu, vaddr, gpa, length, true);
+    if (!crucible_memory_transaction.active && match_count != 0 &&
+        !node_memory_event_capacity(crucible_memory_matches[0], match_count,
+                                    access_classes, vcpu, vaddr, gpa, length,
+                                    observed_icount)) {
+        result.access_error = true;
+        node_memory_matching_rules_done();
+        return result;
+    }
+    if (!node_memory_runtime_resources_ready(
+            match_count, access_classes, vcpu, vaddr, gpa, length,
+            observed_icount)) {
+        result.access_error = true;
+        node_memory_matching_rules_done();
+        return result;
+    }
+    if (node_memory_poison_preflight(
+            access_classes, vcpu, vaddr, gpa, before, visible, length,
+            observed_icount, match_count)) {
+        result.access_error = true;
+        node_memory_matching_rules_done();
+        return result;
+    }
+    for (size_t i = 0; i < match_count; i++) {
+        QemuCrucibleFaultRule *rule = crucible_memory_matches[i];
+        size_t offset, selected;
+        uint64_t rule_offset;
+
+        if (rule->command_kind !=
+                CRUCIBLE_FAULT_COMMAND_MEMORY_ACCESS_TRANSFORM &&
+            rule->command_kind != CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE &&
+            rule->command_kind != CRUCIBLE_FAULT_COMMAND_MEMORY_SERVICE) {
+            continue;
+        }
+        if (!node_rule_memory_overlap(rule, vcpu, vaddr, gpa, length, &offset,
+                                      &selected, &rule_offset)) {
+            if (rule->translation_stale &&
+                !rule->translation_error_reported) {
+                node_memory_event_span(0, 0);
+                node_memory_event(rule, CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR,
+                                  access_classes, vcpu, vaddr, gpa, before,
+                                  visible, length, observed_icount);
+                rule->translation_error_reported = true;
+            }
+            continue;
+        }
+        node_memory_event_span(offset, selected);
+        if (rule->command_kind == CRUCIBLE_FAULT_COMMAND_MEMORY_SERVICE) {
+            node_memory_state_opportunity(rule);
+            node_memory_state_applied(rule);
+            if (crucible_memory_transaction.active) {
+                node_memory_service_defer(
+                    rule, access_classes, vcpu, vaddr + offset, gpa + offset,
+                    before + offset, committed + offset, selected,
+                    observed_icount);
+                continue;
+            }
+            uint64_t latency;
+            uint64_t delay = node_memory_service(rule, selected, &latency);
+
+            if (service_latency > UINT64_MAX - latency) {
+                error_report("Crucible memory latency sum overflow");
+                abort();
+            }
+            service_latency += latency;
+            service_queue = MAX(service_queue, delay);
+            node_memory_event(rule, CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED,
+                              access_classes, vcpu, vaddr, gpa, before,
+                              committed, length, observed_icount);
+            continue;
+        }
+        if (rule->command_kind ==
+            CRUCIBLE_FAULT_COMMAND_MEMORY_ACCESS_TRANSFORM) {
+            uint32_t classes, kind;
+            bool violate_atomicity;
+            uint16_t outcome = CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED;
+
+            g_assert(node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P8,
+                                    &classes));
+            g_assert(node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P3,
+                                    &kind));
+            if ((classes & access_classes) == 0 ||
+                (kind == 5 ? !crucible_memory_poison_occurs[i] :
+                 !node_memory_rule_occurs(rule,
+                                   CRUCIBLE_NODE_FAULT_FIELD_P7))) {
+                continue;
+            }
+            g_assert(node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_P9,
+                                     &violate_atomicity));
+            if (kind == 4 && !violate_atomicity) {
+                g_assert(rule->applied_count != 0);
+                rule->applied_count--;
+                node_memory_event(rule, CRUCIBLE_FAULT_EVENT_OUTCOME_PASSED,
+                                  access_classes, vcpu, vaddr, gpa, before,
+                                  committed, length, observed_icount);
+                continue;
+            }
+            if (kind == 1) {
+                if (classes & QEMU_CRUCIBLE_MEMORY_CPU_LOAD) {
+                    node_repeated_transform(
+                        visible + offset, before + offset, selected,
+                        rule_offset,
+                        node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P4),
+                        node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P6), kind);
+                }
+                if (write_happened &&
+                    (classes & QEMU_CRUCIBLE_MEMORY_CPU_STORE)) {
+                    node_repeated_transform(
+                        committed + offset, before + offset, selected,
+                        rule_offset,
+                        node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P4),
+                        node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P6), kind);
+                }
+            } else if (kind == 2) {
+                node_repeated_transform(
+                    visible + offset, before + offset, selected, rule_offset,
+                    node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P4),
+                    node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P6), kind);
+            } else if (kind == 3 && write_happened) {
+                memcpy(committed + offset, before + offset, selected);
+                memset(commit_mask + offset, 0, selected);
+                outcome = CRUCIBLE_FAULT_EVENT_OUTCOME_SUPPRESSED;
+            } else if (kind == 4 && write_happened) {
+                CrucibleNodeField *selector = node_field(
+                    rule, CRUCIBLE_NODE_FAULT_FIELD_P6);
+
+                node_repeated_transform(
+                    committed + offset, before + offset, selected, rule_offset,
+                    selector, NULL, kind);
+                for (size_t byte = 0; byte < selected; byte++) {
+                    commit_mask[offset + byte] &=
+                        selector->data[(rule_offset + byte) %
+                                       selector->length];
+                }
+            } else if (kind == 5) {
+                QDict *poison = qobject_to(
+                    QDict, node_field(rule,
+                        CRUCIBLE_NODE_FAULT_FIELD_P6)->json);
+                const char *poison_kind = qdict_get_str(poison, "kind");
+
+                if (strcmp(poison_kind, "corrected") == 0) {
+                    QDict *parameters = qdict_get_qdict(poison, "parameters");
+                    const char *mask = qdict_get_str(parameters, "xor_mask");
+                    size_t mask_len = strlen(mask) / 2;
+
+                    for (size_t byte = 0; byte < selected; byte++) {
+                        unsigned parsed;
+                        size_t index = (rule_offset + byte) % mask_len;
+
+                        g_assert(sscanf(mask + index * 2, "%2x", &parsed) == 1);
+                        visible[offset + byte] ^= parsed;
+                    }
+                    outcome = CRUCIBLE_FAULT_EVENT_OUTCOME_CORRECTED;
+                } else {
+                    g_assert_not_reached();
+                }
+            }
+            node_memory_event(rule, outcome,
+                              access_classes, vcpu, vaddr, gpa, before,
+                              write_happened ? committed : visible, length,
+                              observed_icount);
+            continue;
+        }
+
+        uint32_t region_kind;
+        QDict *process = qobject_to(
+            QDict, node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P4)->json);
+        uint16_t outcome = CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED;
+
+        node_memory_state_opportunity(rule);
+        g_assert(node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P3,
+                                &region_kind));
+        node_memory_mutation_evidence_reset(rule);
+        if (region_kind == 1) {
+            QDict *parameters = qdict_get_qdict(process, "parameters");
+            QDict *policy = qdict_get_qdict(parameters, "policy");
+            const char *policy_kind = qdict_get_str(policy, "kind");
+
+            if (strcmp(policy_kind, "corrected") == 0) {
+                QDict *corrected = qdict_get_qdict(policy, "parameters");
+                const char *mask = qdict_get_str(corrected, "xor_mask");
+                size_t mask_len = strlen(mask) / 2;
+
+                for (size_t byte = 0; byte < selected; byte++) {
+                    unsigned parsed;
+                    size_t index = (rule_offset + byte) % mask_len;
+
+                    g_assert(sscanf(mask + index * 2, "%2x", &parsed) == 1);
+                    visible[offset + byte] ^= parsed;
+                }
+                outcome = CRUCIBLE_FAULT_EVENT_OUTCOME_CORRECTED;
+            } else {
+                g_assert_not_reached();
+            }
+        } else if (region_kind == 2) {
+            QDict *parameters = qdict_get_qdict(process, "parameters");
+            uint64_t now = node_virtual_now();
+            node_memory_mutation_evidence_reset(rule);
+            if (write_happened) {
+                if (!node_memory_refresh_retention(
+                        rule, rule_offset, commit_mask + offset, selected,
+                        now)) {
+                    outcome = CRUCIBLE_FAULT_EVENT_OUTCOME_PASSED;
+                }
+            } else {
+                bool decayed = node_memory_apply_retention(
+                    rule, parameters, rule_offset, visible + offset,
+                    selected, now);
+
+                if (!decayed) {
+                    outcome = CRUCIBLE_FAULT_EVENT_OUTCOME_PASSED;
+                }
+            }
+        } else {
+            node_memory_mutation_evidence_reset(rule);
+            (void)node_memory_apply_rowhammer(
+                rule, qdict_get_qdict(process, "parameters"), rule_offset,
+                selected);
+        }
+        if (outcome != CRUCIBLE_FAULT_EVENT_OUTCOME_PASSED) {
+            node_memory_state_applied(rule);
+        }
+        node_memory_event(rule, outcome,
+                          access_classes, vcpu, vaddr, gpa, before,
+                          write_happened ? committed : visible, length,
+                          observed_icount);
+    }
+    if (write_happened) {
+        bool partial = false;
+
+        for (size_t byte = 0; byte < length; byte++) {
+            partial |= commit_mask[byte] != UINT8_MAX;
+        }
+        if (partial) {
+            for (size_t byte = 0; byte < length; byte++) {
+                committed[byte] =
+                    (before[byte] & ~commit_mask[byte]) |
+                    (committed[byte] & commit_mask[byte]);
+            }
+        }
+    }
+    if (service_latency > UINT64_MAX - service_queue) {
+        error_report("Crucible memory completion delay overflow");
+        abort();
+    }
+    result.service_nanos = service_latency + service_queue;
+    node_memory_apply_service(result.service_nanos);
+    node_memory_matching_rules_done();
+    return result;
+}
+
+typedef struct CrucibleNodeVmstate {
+    GPtrArray *rules;
+    GPtrArray *events;
+    uint64_t event_sequence;
+    uint64_t event_sequence_reserved;
+    uint64_t terminal_current;
+    uint64_t terminal_requested;
+    uint64_t terminal_configured;
+    uint64_t terminal_hard;
+    uint32_t event_reserved;
+    uint16_t terminal_resource_kind;
+    bool event_terminal;
+    bool event_force_terminal;
+} CrucibleNodeVmstate;
+
+typedef struct CrucibleMemoryVmstateLedger {
+    QemuCrucibleFaultRule *rule;
+    CrucibleMemoryServiceLedger *prepared_ledger;
+    uint64_t ready_ns;
+} CrucibleMemoryVmstateLedger;
+
+typedef struct CrucibleMemoryVmstate {
+    GHashTable *retry_states;
+    GHashTable *service_ledgers;
+    GArray *gpa_index;
+    GArray *gva_index;
+    GPtrArray *binding_order;
+    GArray *ledgers;
+    uint64_t access_sequence;
+    uint64_t retention_next_ns;
+    uint32_t access_classes;
+} CrucibleMemoryVmstate;
+
+typedef struct CrucibleMemoryVmstateRetention {
+    uint64_t offset;
+    CrucibleRetentionCell cell;
+} CrucibleMemoryVmstateRetention;
+
+typedef struct CrucibleMemoryVmstateRow {
+    CrucibleDramCoordinate coordinate;
+    uint64_t count;
+} CrucibleMemoryVmstateRow;
+
+typedef struct CrucibleMemoryVmstateRetry {
+    CrucibleMemoryRetryKey key;
+    CrucibleMemoryRetryState state;
+} CrucibleMemoryVmstateRetry;
+
+static CrucibleNodeVmstate *crucible_node_vmstate_prepared;
+
+static int crucible_memory_vmstate_retention_compare(gconstpointer left,
+                                                      gconstpointer right)
+{
+    const CrucibleMemoryVmstateRetention *a = left;
+    const CrucibleMemoryVmstateRetention *b = right;
+
+    return a->offset == b->offset ? 0 : (a->offset < b->offset ? -1 : 1);
+}
+
+static int crucible_memory_vmstate_row_compare(gconstpointer left,
+                                                gconstpointer right)
+{
+    const CrucibleMemoryVmstateRow *a = left;
+    const CrucibleMemoryVmstateRow *b = right;
+
+#define CMP(field) do { \
+    if (a->coordinate.field != b->coordinate.field) { \
+        return a->coordinate.field < b->coordinate.field ? -1 : 1; \
+    } \
+} while (0)
+    CMP(row);
+    CMP(channel);
+    CMP(rank);
+    CMP(bank);
+#undef CMP
+    return 0;
+}
+
+static int crucible_memory_vmstate_retry_compare(gconstpointer left,
+                                                  gconstpointer right)
+{
+    const CrucibleMemoryVmstateRetry *a = left;
+    const CrucibleMemoryVmstateRetry *b = right;
+
+#define CMP(field) do { \
+    if (a->key.field != b->key.field) { \
+        return a->key.field < b->key.field ? -1 : 1; \
+    } \
+} while (0)
+    CMP(address);
+    CMP(length);
+    CMP(observed_icount);
+    CMP(instruction_pc);
+    CMP(page_table_target_vaddr);
+    CMP(access_class);
+    CMP(actor);
+    CMP(page_table_level);
+    CMP(page_table_stage);
+    CMP(initiating_access_class);
+    CMP(has_instruction);
+    CMP(streaming);
+#undef CMP
+    return 0;
+}
+
+static void crucible_node_vmstate_event_free(gpointer opaque)
+{
+    CrucibleNodeEvent *event = opaque;
+
+    g_clear_pointer(&event->payload, g_byte_array_unref);
+    g_free(event);
+}
+
+static void crucible_node_vmstate_free(void *opaque)
+{
+    CrucibleNodeVmstate *state = opaque;
+
+    if (!state) {
+        return;
+    }
+    if (crucible_node_vmstate_prepared == state) {
+        crucible_node_vmstate_prepared = NULL;
+    }
+    g_clear_pointer(&state->rules, g_ptr_array_unref);
+    g_clear_pointer(&state->events, g_ptr_array_unref);
+    g_free(state);
+}
+
+static void crucible_node_vmstate_put_event(
+    GByteArray *payload, const CrucibleNodeEvent *queued)
+{
+    const struct qemu_plugin_crucible_fault_event *event = &queued->event;
+
+    qemu_crucible_fault_vmstate_put_u16(payload, event->command_kind);
+    qemu_crucible_fault_vmstate_put_u16(payload, event->outcome);
+    qemu_crucible_fault_vmstate_put_u16(payload, event->model_phase);
+    qemu_crucible_fault_vmstate_put_u16(payload, event->target_kind);
+    qemu_crucible_fault_vmstate_put_u32(payload, event->evidence_length);
+    qemu_crucible_fault_vmstate_put_u64(payload, event->event_sequence);
+    qemu_crucible_fault_vmstate_put_u64(payload,
+                                        event->rule_command_sequence);
+    qemu_crucible_fault_vmstate_put_u64(payload, event->observed_icount);
+    qemu_crucible_fault_vmstate_put_u64(payload, event->generation);
+    qemu_crucible_fault_vmstate_put_bytes(payload, event->binding_hash, 32);
+    qemu_crucible_fault_vmstate_put_bytes(payload, event->opportunity_hash,
+                                          32);
+    qemu_crucible_fault_vmstate_put_bytes(payload, event->action_hash, 32);
+    qemu_crucible_fault_vmstate_put_bytes(payload, event->target_hash, 32);
+    qemu_crucible_fault_vmstate_put_bytes(payload, event->before_hash, 32);
+    qemu_crucible_fault_vmstate_put_bytes(payload, event->after_hash, 32);
+    qemu_crucible_fault_vmstate_put_u32(payload, queued->payload_length);
+    qemu_crucible_fault_vmstate_put_bytes(
+        payload, queued->payload ? queued->payload->data :
+                                   queued->inline_payload,
+        queued->payload_length);
+}
+
+static bool crucible_node_event_envelope_valid(
+    const struct qemu_plugin_crucible_fault_event *event,
+    const uint8_t *payload, size_t payload_len)
+{
+    uint32_t request_len;
+    uint32_t evidence_len;
+    uint8_t digest[32];
+    const uint8_t *request;
+    const uint8_t *evidence;
+
+    if (payload_len < CRUCIBLE_NODE_EVENT_ENVELOPE_HEADER_BYTES ||
+        payload_len > CRUCIBLE_NODE_EVENT_ENVELOPE_MAX_BYTES ||
+        memcmp(payload, CRUCIBLE_NODE_EVENT_ENVELOPE_MAGIC, 8) != 0 ||
+        node_get_u16(payload + 8) != 1 ||
+        node_get_u16(payload + 10) != 0 ||
+        node_get_u32(payload + 20) != 0) {
+        return false;
+    }
+    request_len = node_get_u32(payload + 12);
+    evidence_len = node_get_u32(payload + 16);
+    if (request_len < CRUCIBLE_NODE_FAULT_PAYLOAD_HEADER_V1_BYTES ||
+        request_len > CRUCIBLE_FAULT_HARD_PAYLOAD_BYTES ||
+        evidence_len == 0 ||
+        evidence_len > CRUCIBLE_FAULT_HARD_PAYLOAD_BYTES ||
+        request_len > payload_len - CRUCIBLE_NODE_EVENT_ENVELOPE_HEADER_BYTES ||
+        evidence_len != payload_len -
+            CRUCIBLE_NODE_EVENT_ENVELOPE_HEADER_BYTES - request_len) {
+        return false;
+    }
+    request = payload + CRUCIBLE_NODE_EVENT_ENVELOPE_HEADER_BYTES;
+    evidence = request + request_len;
+    node_sha256(request, request_len, digest);
+    if (memcmp(digest, payload + 24, 32) != 0) {
+        return false;
+    }
+    node_sha256(evidence, evidence_len, digest);
+    if (memcmp(digest, payload + 56, 32) != 0) {
+        return false;
+    }
+    return memcmp(request, CRUCIBLE_NODE_MAGIC, 8) == 0 &&
+           node_get_u16(
+               request + CRUCIBLE_NODE_FAULT_PAYLOAD_COMMAND_KIND_OFFSET) ==
+               event->command_kind &&
+           node_get_u16(
+               request + CRUCIBLE_NODE_FAULT_PAYLOAD_TARGET_KIND_OFFSET) ==
+               event->target_kind &&
+           node_get_u16(
+               request + CRUCIBLE_NODE_FAULT_PAYLOAD_MODEL_PHASE_OFFSET) ==
+               event->model_phase &&
+           node_get_u64(
+               request + CRUCIBLE_NODE_FAULT_PAYLOAD_GENERATION_OFFSET) ==
+               event->generation &&
+           memcmp(payload + 88, event->binding_hash, 32) == 0 &&
+           node_get_u64(payload + 120) == event->rule_command_sequence &&
+           (event->command_kind !=
+                CRUCIBLE_FAULT_COMMAND_ACCELERATOR_RESULT_TRANSFORM ||
+            memcmp(payload + 160, event->opportunity_hash, 32) == 0) &&
+           memcmp(request + CRUCIBLE_NODE_FAULT_PAYLOAD_ACTION_HASH_OFFSET,
+                  event->action_hash, 32) == 0 &&
+           memcmp(request + CRUCIBLE_NODE_FAULT_PAYLOAD_TARGET_HASH_OFFSET,
+                  event->target_hash, 32) == 0;
+}
+
+static bool crucible_node_vmstate_get_event(
+    QemuCrucibleFaultVmstateReader *reader, CrucibleNodeEvent *queued)
+{
+    struct qemu_plugin_crucible_fault_event *event = &queued->event;
+    QemuCrucibleFaultRule event_rule = { 0 };
+    const NodeSchemaField *schema;
+    size_t schema_count;
+    const uint8_t *evidence;
+    uint32_t evidence_len;
+
+    if (!qemu_crucible_fault_vmstate_get_u16(reader, &event->command_kind) ||
+        !qemu_crucible_fault_vmstate_get_u16(reader, &event->outcome) ||
+        !qemu_crucible_fault_vmstate_get_u16(reader, &event->model_phase) ||
+        !qemu_crucible_fault_vmstate_get_u16(reader, &event->target_kind) ||
+        !qemu_crucible_fault_vmstate_get_u32(reader,
+                                              &event->evidence_length) ||
+        !qemu_crucible_fault_vmstate_get_u64(reader,
+                                              &event->event_sequence) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            reader, &event->rule_command_sequence) ||
+        !qemu_crucible_fault_vmstate_get_u64(reader,
+                                              &event->observed_icount) ||
+        !qemu_crucible_fault_vmstate_get_u64(reader, &event->generation) ||
+        !qemu_crucible_fault_vmstate_get_bytes(reader,
+                                                event->binding_hash, 32) ||
+        !qemu_crucible_fault_vmstate_get_bytes(
+            reader, event->opportunity_hash, 32) ||
+        !qemu_crucible_fault_vmstate_get_bytes(reader,
+                                                event->action_hash, 32) ||
+        !qemu_crucible_fault_vmstate_get_bytes(reader,
+                                                event->target_hash, 32) ||
+        !qemu_crucible_fault_vmstate_get_bytes(reader,
+                                                event->before_hash, 32) ||
+        !qemu_crucible_fault_vmstate_get_bytes(reader,
+                                                event->after_hash, 32) ||
+        !qemu_crucible_fault_vmstate_get_u32(reader, &evidence_len) ||
+        evidence_len > CRUCIBLE_NODE_EVENT_ENVELOPE_MAX_BYTES ||
+        !qemu_crucible_fault_vmstate_get_view(reader, &evidence,
+                                               evidence_len) ||
+        !crucible_node_event_envelope_valid(event, evidence, evidence_len) ||
+        event->evidence_length == 0 ||
+        event->evidence_length > CRUCIBLE_FAULT_HARD_PAYLOAD_BYTES ||
+        event->evidence_length != node_get_u32(evidence + 16) ||
+        event->event_sequence == 0 ||
+        event->rule_command_sequence == 0 || event->generation == 0 ||
+        event->outcome < CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED ||
+        event->outcome > CRUCIBLE_FAULT_EVENT_OUTCOME_RECOVERED ||
+        event->model_phase < CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY ||
+        event->model_phase > CRUCIBLE_FAULT_PHASE_DEVICE ||
+        !node_schema_for(event->command_kind, &schema, &schema_count) ||
+        !node_target_schema_for(event->target_kind,
+                                &schema, &schema_count)) {
+        return false;
+    }
+    event_rule.command_kind = event->command_kind;
+    event_rule.target_kind = event->target_kind;
+    if (!node_target_pair_valid(&event_rule)) {
+        return false;
+    }
+    queued->payload_length = evidence_len;
+    if (evidence_len <= sizeof(queued->inline_payload)) {
+        memcpy(queued->inline_payload, evidence, evidence_len);
+    } else {
+        queued->payload = g_byte_array_sized_new(evidence_len);
+        g_byte_array_append(queued->payload, evidence, evidence_len);
+    }
+    return true;
+}
+
+void qemu_crucible_fault_rule_vmstate_save(
+    GByteArray *payload, const QemuCrucibleFaultRule *rule)
+{
+    qemu_crucible_fault_vmstate_put_u16(payload, rule->command_phase);
+    qemu_crucible_fault_vmstate_put_u16(payload, 0);
+    qemu_crucible_fault_vmstate_put_u32(payload, rule->semantic_version);
+    qemu_crucible_fault_vmstate_put_u64(payload, rule->command_sequence);
+    qemu_crucible_fault_vmstate_put_u64(payload, rule->opportunity_count);
+    qemu_crucible_fault_vmstate_put_u64(payload, rule->applied_count);
+    qemu_crucible_fault_vmstate_put_bytes(payload, rule->binding_hash, 32);
+    qemu_crucible_fault_vmstate_put_bytes(payload, rule->opportunity_hash,
+                                          32);
+    qemu_crucible_fault_vmstate_put_bytes(payload, rule->target_node_hash,
+                                          32);
+    qemu_crucible_fault_vmstate_put_u32(payload, rule->payload_len);
+    qemu_crucible_fault_vmstate_put_bytes(payload, rule->payload,
+                                          rule->payload_len);
+}
+
+QemuCrucibleFaultRule *qemu_crucible_fault_rule_vmstate_load(
+    QemuCrucibleFaultVmstateReader *reader)
+{
+    struct qemu_plugin_crucible_fault_command command = { 0 };
+    QemuCrucibleFaultRule *rule = g_new0(QemuCrucibleFaultRule, 1);
+    const uint8_t *rule_payload;
+    uint16_t reserved;
+    uint32_t rule_payload_len;
+
+    if (!qemu_crucible_fault_vmstate_get_u16(reader, &command.phase) ||
+        !qemu_crucible_fault_vmstate_get_u16(reader, &reserved) ||
+        !qemu_crucible_fault_vmstate_get_u32(
+            reader, &command.semantic_version) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            reader, &command.command_sequence) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            reader, &rule->opportunity_count) ||
+        !qemu_crucible_fault_vmstate_get_u64(reader,
+                                              &rule->applied_count) ||
+        !qemu_crucible_fault_vmstate_get_bytes(reader,
+                                                command.binding_hash, 32) ||
+        !qemu_crucible_fault_vmstate_get_bytes(
+            reader, command.opportunity_hash, 32) ||
+        !qemu_crucible_fault_vmstate_get_bytes(
+            reader, command.target_node_hash, 32) ||
+        !qemu_crucible_fault_vmstate_get_u32(reader, &rule_payload_len) ||
+        reserved != 0 ||
+        rule->opportunity_count == UINT64_MAX ||
+        rule->applied_count > rule->opportunity_count ||
+        rule_payload_len < CRUCIBLE_NODE_FAULT_PAYLOAD_HEADER_V1_BYTES ||
+        rule_payload_len > CRUCIBLE_FAULT_HARD_PAYLOAD_BYTES ||
+        !qemu_crucible_fault_vmstate_get_view(
+            reader, &rule_payload, rule_payload_len)) {
+        g_free(rule);
+        return NULL;
+    }
+    command.command_kind = node_get_u16(
+        rule_payload + CRUCIBLE_NODE_FAULT_PAYLOAD_COMMAND_KIND_OFFSET);
+    if (node_parse(&command, rule_payload, rule_payload_len, rule) != 0) {
+        node_rule_clear(rule);
+        g_free(rule);
+        return NULL;
+    }
+    rule->references = 1;
+    return rule;
+}
+
+static int crucible_node_vmstate_encode(GByteArray *payload)
+{
+    CrucibleNodeEvent *event;
+
+    if (crucible_node_rules->len > CRUCIBLE_NODE_VMSTATE_MAX_RULES ||
+        crucible_node_event_count > CRUCIBLE_NODE_EVENT_CAPACITY - 1 ||
+        crucible_node_event_reserved > UINT32_MAX ||
+        crucible_node_event_count + crucible_node_event_reserved >
+            CRUCIBLE_NODE_EVENT_CAPACITY - 1) {
+        return -E2BIG;
+    }
+    qemu_crucible_fault_vmstate_put_bytes(payload,
+                                          CRUCIBLE_NODE_VMSTATE_MAGIC, 8);
+    qemu_crucible_fault_vmstate_put_u32(payload, crucible_node_rules->len);
+    qemu_crucible_fault_vmstate_put_u32(payload,
+                                        crucible_node_event_count);
+    qemu_crucible_fault_vmstate_put_u32(payload,
+                                        crucible_node_event_reserved);
+    qemu_crucible_fault_vmstate_put_u16(
+        payload, crucible_node_terminal_resource_kind);
+    qemu_crucible_fault_vmstate_put_u8(payload,
+                                       crucible_node_event_terminal);
+    qemu_crucible_fault_vmstate_put_u8(payload,
+                                       crucible_node_event_force_terminal);
+    qemu_crucible_fault_vmstate_put_u64(payload,
+                                        crucible_node_event_sequence);
+    qemu_crucible_fault_vmstate_put_u64(
+        payload, crucible_node_event_sequence_reserved);
+    qemu_crucible_fault_vmstate_put_u64(
+        payload, crucible_node_terminal_current);
+    qemu_crucible_fault_vmstate_put_u64(
+        payload, crucible_node_terminal_requested);
+    qemu_crucible_fault_vmstate_put_u64(
+        payload, crucible_node_terminal_configured);
+    qemu_crucible_fault_vmstate_put_u64(payload,
+                                        crucible_node_terminal_hard);
+    for (guint i = 0; i < crucible_node_rules->len; i++) {
+        QemuCrucibleFaultRule *rule = g_ptr_array_index(
+            crucible_node_rules, i);
+
+        qemu_crucible_fault_rule_vmstate_save(payload, rule);
+    }
+    QTAILQ_FOREACH(event, &crucible_node_events, link) {
+        crucible_node_vmstate_put_event(payload, event);
+    }
+    return 0;
+}
+
+static int crucible_node_vmstate_save(GByteArray *payload)
+{
+    node_rules_ensure();
+    node_events_ensure();
+    return crucible_node_vmstate_encode(payload);
+}
+
+static int crucible_node_fingerprint_projection(GByteArray *payload)
+{
+    if (!crucible_node_rules || !crucible_node_events_initialized) {
+        return -ENODATA;
+    }
+    return crucible_node_vmstate_encode(payload);
+}
+
+static int crucible_node_vmstate_prepare(const uint8_t *payload,
+                                         size_t payload_len,
+                                         void **staged_out)
+{
+    QemuCrucibleFaultVmstateReader reader = {
+        .data = payload,
+        .length = payload_len,
+    };
+    CrucibleNodeVmstate *state = g_new0(CrucibleNodeVmstate, 1);
+    uint8_t magic[8], terminal, force_terminal;
+    uint32_t rule_count, event_count;
+    int status = -EINVAL;
+
+    state->rules = g_ptr_array_new_with_free_func(
+        (GDestroyNotify)node_rule_unref);
+    state->events = g_ptr_array_new_with_free_func(
+        crucible_node_vmstate_event_free);
+    node_events_ensure();
+    node_rules_ensure();
+    if (!qemu_crucible_fault_vmstate_get_bytes(&reader, magic,
+                                                sizeof(magic)) ||
+        memcmp(magic, CRUCIBLE_NODE_VMSTATE_MAGIC, sizeof(magic)) != 0 ||
+        !qemu_crucible_fault_vmstate_get_u32(&reader, &rule_count) ||
+        !qemu_crucible_fault_vmstate_get_u32(&reader, &event_count) ||
+        !qemu_crucible_fault_vmstate_get_u32(&reader,
+                                              &state->event_reserved) ||
+        !qemu_crucible_fault_vmstate_get_u16(
+            &reader, &state->terminal_resource_kind) ||
+        !qemu_crucible_fault_vmstate_get_u8(&reader, &terminal) ||
+        !qemu_crucible_fault_vmstate_get_u8(&reader, &force_terminal) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            &reader, &state->event_sequence) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            &reader, &state->event_sequence_reserved) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            &reader, &state->terminal_current) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            &reader, &state->terminal_requested) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            &reader, &state->terminal_configured) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            &reader, &state->terminal_hard) || terminal > 1 ||
+        force_terminal > 1 ||
+        rule_count > CRUCIBLE_NODE_VMSTATE_MAX_RULES ||
+        event_count > CRUCIBLE_NODE_EVENT_CAPACITY - 1 ||
+        state->event_reserved > CRUCIBLE_NODE_EVENT_CAPACITY - 1 ||
+        event_count + state->event_reserved >
+            CRUCIBLE_NODE_EVENT_CAPACITY - 1 ||
+        state->event_sequence_reserved != state->event_reserved ||
+        state->event_sequence > UINT64_MAX -
+            state->event_sequence_reserved) {
+        goto fail;
+    }
+    state->event_terminal = terminal;
+    state->event_force_terminal = force_terminal;
+    for (uint32_t i = 0; i < rule_count; i++) {
+        QemuCrucibleFaultRule *rule =
+            qemu_crucible_fault_rule_vmstate_load(&reader);
+
+        if (!rule) {
+            goto fail;
+        }
+        if (rule->operation != CRUCIBLE_NODE_FAULT_OPERATION_UPSERT) {
+            node_rule_clear(rule);
+            g_free(rule);
+            status = -EINVAL;
+            goto fail;
+        }
+        if (i != 0) {
+            QemuCrucibleFaultRule *previous = g_ptr_array_index(
+                state->rules, i - 1);
+
+            if (node_rule_compare(&previous, &rule) >= 0) {
+                node_rule_clear(rule);
+                g_free(rule);
+                status = -EINVAL;
+                goto fail;
+            }
+        }
+        g_ptr_array_add(state->rules, rule);
+    }
+    for (uint32_t i = 0; i < event_count; i++) {
+        CrucibleNodeEvent *event = g_new0(CrucibleNodeEvent, 1);
+
+        if (!crucible_node_vmstate_get_event(&reader, event) ||
+            event->event.event_sequence > state->event_sequence ||
+            (i != 0 && event->event.event_sequence <=
+                ((CrucibleNodeEvent *)g_ptr_array_index(
+                    state->events, i - 1))->event.event_sequence)) {
+            crucible_node_vmstate_event_free(event);
+            goto fail;
+        }
+        g_ptr_array_add(state->events, event);
+    }
+    if (!qemu_crucible_fault_vmstate_reader_finished(&reader)) {
+        goto fail;
+    }
+    qemu_crucible_fault_vmstate_expect_reservations(
+        state->event_reserved);
+    *staged_out = state;
+    g_assert(!crucible_node_vmstate_prepared);
+    crucible_node_vmstate_prepared = state;
+    return 0;
+
+fail:
+    crucible_node_vmstate_free(state);
+    return status;
+}
+
+static void crucible_node_vmstate_commit(void *opaque)
+{
+    CrucibleNodeVmstate *state = opaque;
+    CrucibleNodeEvent *queued;
+
+    g_assert(crucible_node_vmstate_prepared == state);
+    crucible_node_vmstate_prepared = NULL;
+    while ((queued = QTAILQ_FIRST(&crucible_node_events))) {
+        QTAILQ_REMOVE(&crucible_node_events, queued, link);
+        g_clear_pointer(&queued->payload, g_byte_array_unref);
+        queued->payload_length = 0;
+        QTAILQ_INSERT_TAIL(&crucible_node_free_events, queued, link);
+    }
+    g_ptr_array_unref(crucible_node_rules);
+    crucible_node_rules = g_steal_pointer(&state->rules);
+    crucible_node_event_count = 0;
+    for (guint i = 0; i < state->events->len; i++) {
+        CrucibleNodeEvent *source = g_ptr_array_index(state->events, i);
+        CrucibleNodeEvent *destination = QTAILQ_FIRST(
+            &crucible_node_free_events);
+
+        g_assert(destination);
+        QTAILQ_REMOVE(&crucible_node_free_events, destination, link);
+        destination->event = source->event;
+        destination->payload_length = source->payload_length;
+        memcpy(destination->inline_payload, source->inline_payload,
+               sizeof(destination->inline_payload));
+        destination->payload = g_steal_pointer(&source->payload);
+        QTAILQ_INSERT_TAIL(&crucible_node_events, destination, link);
+        crucible_node_event_count++;
+    }
+    crucible_node_event_sequence = state->event_sequence;
+    crucible_node_event_reserved = state->event_reserved;
+    crucible_node_event_sequence_reserved = state->event_sequence_reserved;
+    crucible_node_event_terminal = state->event_terminal;
+    crucible_node_event_force_terminal = state->event_force_terminal;
+    crucible_node_terminal_resource_kind = state->terminal_resource_kind;
+    crucible_node_terminal_current = state->terminal_current;
+    crucible_node_terminal_requested = state->terminal_requested;
+    crucible_node_terminal_configured = state->terminal_configured;
+    crucible_node_terminal_hard = state->terminal_hard;
+    g_ptr_array_set_size(state->events, 0);
+    crucible_node_vmstate_free(state);
+}
+
+QemuCrucibleFaultRule *qemu_crucible_fault_vmstate_rule_lookup_staged(
+    uint16_t command_kind, const uint8_t binding_hash[32],
+    uint64_t generation)
+{
+    if (!crucible_node_vmstate_prepared) {
+        return NULL;
+    }
+    for (guint i = 0; i < crucible_node_vmstate_prepared->rules->len; i++) {
+        QemuCrucibleFaultRule *rule = g_ptr_array_index(
+            crucible_node_vmstate_prepared->rules, i);
+
+        if (rule->command_kind == command_kind &&
+            rule->generation == generation &&
+            memcmp(rule->binding_hash, binding_hash, 32) == 0) {
+            return node_rule_ref(rule);
+        }
+    }
+    return NULL;
+}
+
+bool qemu_crucible_fault_rule_foreach_staged(
+    uint16_t command_kind, QemuCrucibleFaultRuleVisitFn visit,
+    void *opaque)
+{
+    if (!crucible_node_vmstate_prepared || !visit) {
+        return false;
+    }
+    for (guint i = 0; i < crucible_node_vmstate_prepared->rules->len; i++) {
+        QemuCrucibleFaultRule *rule = g_ptr_array_index(
+            crucible_node_vmstate_prepared->rules, i);
+
+        if (rule->command_kind == command_kind) {
+            visit(rule, opaque);
+        }
+    }
+    return true;
+}
+
+static const QemuCrucibleFaultVmstateSection
+crucible_node_vmstate_section = {
+    .name = "node-rules",
+    .version = 2,
+    .save = crucible_node_vmstate_save,
+    .fingerprint_projection = crucible_node_fingerprint_projection,
+    .prepare = crucible_node_vmstate_prepare,
+    .commit = crucible_node_vmstate_commit,
+    .free_staged = crucible_node_vmstate_free,
+};
+
+static bool crucible_memory_vmstate_rule(
+    const QemuCrucibleFaultRule *rule)
+{
+    return rule->target_kind == CRUCIBLE_NODE_FAULT_TARGET_MEMORY ||
+           rule->command_kind ==
+               CRUCIBLE_FAULT_COMMAND_MEMORY_ACCESS_TRANSFORM ||
+           rule->command_kind == CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE ||
+           rule->command_kind == CRUCIBLE_FAULT_COMMAND_MEMORY_SERVICE;
+}
+
+static void crucible_memory_vmstate_put_rule_id(
+    GByteArray *payload, const QemuCrucibleFaultRule *rule)
+{
+    qemu_crucible_fault_rule_reference_vmstate_save(payload, rule);
+}
+
+void qemu_crucible_fault_rule_reference_vmstate_save(
+    GByteArray *payload, const QemuCrucibleFaultRule *rule)
+{
+    qemu_crucible_fault_vmstate_put_u16(payload, rule->command_kind);
+    qemu_crucible_fault_vmstate_put_u16(payload, 0);
+    qemu_crucible_fault_vmstate_put_u64(payload, rule->generation);
+    qemu_crucible_fault_vmstate_put_bytes(payload, rule->binding_hash, 32);
+}
+
+static QemuCrucibleFaultRule *crucible_memory_vmstate_get_rule_id(
+    QemuCrucibleFaultVmstateReader *reader)
+{
+    return qemu_crucible_fault_rule_reference_vmstate_load(reader);
+}
+
+QemuCrucibleFaultRule *qemu_crucible_fault_rule_reference_vmstate_load(
+    QemuCrucibleFaultVmstateReader *reader)
+{
+    uint8_t binding_hash[32];
+    uint16_t command_kind, reserved;
+    uint64_t generation;
+
+    if (!qemu_crucible_fault_vmstate_get_u16(reader, &command_kind) ||
+        !qemu_crucible_fault_vmstate_get_u16(reader, &reserved) ||
+        !qemu_crucible_fault_vmstate_get_u64(reader, &generation) ||
+        !qemu_crucible_fault_vmstate_get_bytes(reader, binding_hash, 32) ||
+        reserved != 0 || generation == 0) {
+        return NULL;
+    }
+    return qemu_crucible_fault_vmstate_rule_lookup_staged(
+        command_kind, binding_hash, generation);
+}
+
+static int crucible_memory_vmstate_encode(GByteArray *payload)
+{
+    g_autoptr(GArray) retries = g_array_new(
+        false, false, sizeof(CrucibleMemoryVmstateRetry));
+    uint32_t rule_count = 0;
+    GHashTableIter iterator;
+    gpointer key, value;
+
+    if (crucible_memory_transaction.active ||
+        crucible_memory_transaction.lock_held ||
+        crucible_memory_post_state.active || crucible_memory_matches_in_use ||
+        crucible_memory_preflight_collecting ||
+        crucible_memory_resource_planning ||
+        (crucible_memory_pending_services &&
+         crucible_memory_pending_services->len != 0) ||
+        crucible_memory_reserved_virtual_time != 0 ||
+        (crucible_memory_reserved_counters &&
+         g_hash_table_size(crucible_memory_reserved_counters) != 0) ||
+        (crucible_memory_reserved_rows &&
+         g_hash_table_size(crucible_memory_reserved_rows) != 0) ||
+        (crucible_memory_reserved_retention &&
+         g_hash_table_size(crucible_memory_reserved_retention) != 0) ||
+        (crucible_memory_reserved_ledgers &&
+         g_hash_table_size(crucible_memory_reserved_ledgers) != 0)) {
+        return -EBUSY;
+    }
+    for (guint i = 0; i < crucible_node_rules->len; i++) {
+        QemuCrucibleFaultRule *rule = g_ptr_array_index(
+            crucible_node_rules, i);
+
+        if (crucible_memory_vmstate_rule(rule)) {
+            rule_count++;
+        }
+    }
+    if (crucible_memory_retry_states) {
+        g_hash_table_iter_init(&iterator, crucible_memory_retry_states);
+        while (g_hash_table_iter_next(&iterator, &key, &value)) {
+            CrucibleMemoryVmstateRetry retry = {
+                .key = *(CrucibleMemoryRetryKey *)key,
+                .state = *(CrucibleMemoryRetryState *)value,
+            };
+
+            g_array_append_val(retries, retry);
+        }
+        g_array_sort(retries, crucible_memory_vmstate_retry_compare);
+    }
+    qemu_crucible_fault_vmstate_put_bytes(payload, "CRUCMVS1", 8);
+    qemu_crucible_fault_vmstate_put_u32(payload, rule_count);
+    qemu_crucible_fault_vmstate_put_u32(payload, retries->len);
+    qemu_crucible_fault_vmstate_put_u64(payload,
+                                        crucible_memory_access_sequence);
+    qemu_crucible_fault_vmstate_put_u64(payload,
+                                        crucible_memory_retention_next_ns);
+    for (guint i = 0; i < crucible_node_rules->len; i++) {
+        QemuCrucibleFaultRule *rule = g_ptr_array_index(
+            crucible_node_rules, i);
+        g_autoptr(GArray) cells = g_array_new(
+            false, false, sizeof(CrucibleMemoryVmstateRetention));
+        g_autoptr(GArray) rows = g_array_new(
+            false, false, sizeof(CrucibleMemoryVmstateRow));
+        uint32_t translation_count = rule->translations ?
+            rule->translations->len : 0;
+
+        if (!crucible_memory_vmstate_rule(rule)) {
+            continue;
+        }
+        if (rule->retention_cells) {
+            g_hash_table_iter_init(&iterator, rule->retention_cells);
+            while (g_hash_table_iter_next(&iterator, &key, &value)) {
+                CrucibleMemoryVmstateRetention cell = {
+                    .offset = *(uint64_t *)key,
+                    .cell = *(CrucibleRetentionCell *)value,
+                };
+
+                g_array_append_val(cells, cell);
+            }
+            g_array_sort(cells,
+                         crucible_memory_vmstate_retention_compare);
+        }
+        if (rule->row_counters) {
+            g_hash_table_iter_init(&iterator, rule->row_counters);
+            while (g_hash_table_iter_next(&iterator, &key, &value)) {
+                CrucibleMemoryVmstateRow row = {
+                    .coordinate = *(CrucibleDramCoordinate *)key,
+                    .count = *(uint64_t *)value,
+                };
+
+                g_array_append_val(rows, row);
+            }
+            g_array_sort(rows, crucible_memory_vmstate_row_compare);
+        }
+        if (cells->len > CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT ||
+            rows->len > CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT ||
+            translation_count > CRUCIBLE_NODE_MEMORY_MATCH_LIMIT) {
+            return -E2BIG;
+        }
+        crucible_memory_vmstate_put_rule_id(payload, rule);
+        qemu_crucible_fault_vmstate_put_u64(payload,
+                                            rule->last_exposure_ns);
+        qemu_crucible_fault_vmstate_put_u64(payload,
+                                            rule->retention_next_ns);
+        qemu_crucible_fault_vmstate_put_u8(payload,
+                                           rule->exposure_initialized);
+        qemu_crucible_fault_vmstate_put_u8(payload,
+                                           rule->retention_scheduled);
+        qemu_crucible_fault_vmstate_put_u8(payload,
+                                           rule->translation_stale);
+        qemu_crucible_fault_vmstate_put_u8(
+            payload, rule->translation_error_reported);
+        qemu_crucible_fault_vmstate_put_u64(
+            payload, rule->service_ledger ? rule->service_ledger->ready_ns : 0);
+        qemu_crucible_fault_vmstate_put_u32(payload, cells->len);
+        qemu_crucible_fault_vmstate_put_u32(payload, rows->len);
+        qemu_crucible_fault_vmstate_put_u32(payload, translation_count);
+        qemu_crucible_fault_vmstate_put_u32(payload, 0);
+        qemu_crucible_fault_vmstate_put_bytes(payload,
+                                              rule->translation_hash, 32);
+        for (guint cell_index = 0; cell_index < cells->len; cell_index++) {
+            CrucibleMemoryVmstateRetention *cell = &g_array_index(
+                cells, CrucibleMemoryVmstateRetention, cell_index);
+
+            qemu_crucible_fault_vmstate_put_u64(payload, cell->offset);
+            for (size_t bit = 0; bit < G_N_ELEMENTS(cell->cell.refresh_ns);
+                 bit++) {
+                qemu_crucible_fault_vmstate_put_u64(
+                    payload, cell->cell.refresh_ns[bit]);
+            }
+            qemu_crucible_fault_vmstate_put_u8(payload,
+                                               cell->cell.decayed_mask);
+        }
+        for (guint row_index = 0; row_index < rows->len; row_index++) {
+            CrucibleMemoryVmstateRow *row = &g_array_index(
+                rows, CrucibleMemoryVmstateRow, row_index);
+
+            qemu_crucible_fault_vmstate_put_u64(payload,
+                                                row->coordinate.row);
+            qemu_crucible_fault_vmstate_put_u16(payload,
+                                                row->coordinate.channel);
+            qemu_crucible_fault_vmstate_put_u16(payload,
+                                                row->coordinate.rank);
+            qemu_crucible_fault_vmstate_put_u16(payload,
+                                                row->coordinate.bank);
+            qemu_crucible_fault_vmstate_put_u16(payload, 0);
+            qemu_crucible_fault_vmstate_put_u64(payload, row->count);
+        }
+        for (uint32_t translation_index = 0;
+             translation_index < translation_count; translation_index++) {
+            CrucibleNodeTranslation *translation = &g_array_index(
+                rule->translations, CrucibleNodeTranslation,
+                translation_index);
+
+            qemu_crucible_fault_vmstate_put_u64(
+                payload, translation->virtual_page);
+            qemu_crucible_fault_vmstate_put_u64(
+                payload, translation->physical_page);
+            qemu_crucible_fault_vmstate_put_u64(payload,
+                                                translation->page_size);
+            qemu_crucible_fault_vmstate_put_u32(
+                payload, translation->covered_bytes);
+            qemu_crucible_fault_vmstate_put_u16(
+                payload, translation->attrs.requester_id);
+            qemu_crucible_fault_vmstate_put_u8(payload,
+                                               translation->attrs.pid);
+            qemu_crucible_fault_vmstate_put_u8(payload,
+                                               translation->attrs.space);
+            qemu_crucible_fault_vmstate_put_u8(payload,
+                                               translation->attrs.secure);
+            qemu_crucible_fault_vmstate_put_u8(payload,
+                                               translation->attrs.user);
+            qemu_crucible_fault_vmstate_put_u8(payload,
+                                               translation->attrs.memory);
+            qemu_crucible_fault_vmstate_put_u8(payload,
+                                               translation->attrs.debug);
+            qemu_crucible_fault_vmstate_put_u8(
+                payload, translation->attrs.unspecified);
+            qemu_crucible_fault_vmstate_put_u8(payload,
+                                               translation->readable);
+            qemu_crucible_fault_vmstate_put_u8(payload,
+                                               translation->writable);
+            qemu_crucible_fault_vmstate_put_u8(payload,
+                                               translation->executable);
+            qemu_crucible_fault_vmstate_put_u8(payload,
+                                               translation->user);
+            qemu_crucible_fault_vmstate_put_u8(payload, 0);
+        }
+    }
+    for (guint i = 0; i < retries->len; i++) {
+        CrucibleMemoryVmstateRetry *retry = &g_array_index(
+            retries, CrucibleMemoryVmstateRetry, i);
+        const CrucibleMemoryRetryKey *retry_key = &retry->key;
+
+        qemu_crucible_fault_vmstate_put_u64(payload, retry_key->address);
+        qemu_crucible_fault_vmstate_put_u64(payload, retry_key->length);
+        qemu_crucible_fault_vmstate_put_u64(payload,
+                                            retry_key->observed_icount);
+        qemu_crucible_fault_vmstate_put_u64(payload,
+                                            retry_key->instruction_pc);
+        qemu_crucible_fault_vmstate_put_u64(
+            payload, retry_key->page_table_target_vaddr);
+        qemu_crucible_fault_vmstate_put_u32(payload,
+                                            retry_key->access_class);
+        qemu_crucible_fault_vmstate_put_u32(payload, retry_key->actor);
+        qemu_crucible_fault_vmstate_put_u32(payload,
+                                            retry_key->page_table_level);
+        qemu_crucible_fault_vmstate_put_u32(payload,
+                                            retry_key->page_table_stage);
+        qemu_crucible_fault_vmstate_put_u32(
+            payload, retry_key->initiating_access_class);
+        qemu_crucible_fault_vmstate_put_u8(
+            payload, retry_key->has_instruction);
+        qemu_crucible_fault_vmstate_put_u8(payload, retry_key->streaming);
+        qemu_crucible_fault_vmstate_put_u16(payload, 0);
+        qemu_crucible_fault_vmstate_put_u64(
+            payload, retry->state.last_access_sequence);
+        qemu_crucible_fault_vmstate_put_u32(payload,
+                                            retry->state.retry_ordinal);
+        qemu_crucible_fault_vmstate_put_u32(payload, 0);
+    }
+    return 0;
+}
