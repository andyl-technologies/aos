@@ -0,0 +1,772 @@
+/*
+ * Actual entered Main fingerprint action ownership
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifdef CONFIG_LINUX
+
+static int action_original_identity(QemuCrucibleActionOriginal *action,
+                                    QemuCrucibleMainControlBorrow *main)
+{
+    if (action != &startup_source.action_original || !action->held ||
+        action->main != main || main != &startup_source.main_control_borrow ||
+        action->process != getpid() || !qemu_thread_is_self(&action->thread) ||
+        !action->serial || action->serial != startup_source.action_original_serial ||
+        !main->handoff || action->member != main->handoff->member) {
+        return -ESTALE;
+    }
+    return main_payload_identity_locked(main);
+}
+
+int qemu_crucible_source_action_original_publisher_current_v1(
+    QemuCrucibleActionOriginal *action, QemuCrucibleMainControlBorrow *main,
+    QemuCruciblePublisherActionLoan **holder)
+{
+    int status = action_original_identity(action, main);
+
+    if (!status && (holder != &action->publisher || action->returning ||
+        qemu_plugin_crucible_source_action_dispatch_current_v1(main, false))) {
+        status = -EPERM;
+    }
+    return status;
+}
+
+int qemu_crucible_source_action_original_publisher_issuing_v1(
+    QemuCrucibleActionOriginal *action, QemuCrucibleMainControlBorrow *main,
+    QemuCruciblePublisherActionLoan **holder)
+{
+    int status = qemu_crucible_source_action_original_publisher_current_v1(
+        action, main, holder);
+
+    return status ? status : action->issuing ? 0 : -EPERM;
+}
+
+int qemu_crucible_source_action_original_native_observing_v1(
+    QemuCrucibleActionOriginal *action, qemu_plugin_id_t id)
+{
+    int status = qemu_crucible_source_action_original_publisher_current_v1(
+        action, action == &startup_source.action_original ? action->main : NULL,
+        action == &startup_source.action_original ? &action->publisher : NULL);
+
+    return status ? status : !action->observing_native ||
+        id != action->member->installer.plugin_id ? -EPERM : 0;
+}
+
+static bool action_original_children_held(void)
+{
+    QemuCrucibleFingerprintWorker *worker = &startup_source.fingerprint_worker;
+
+    if (fingerprint_materials_held() || startup_source.standing.operation.held ||
+        !qemu_crucible_startup_source_fingerprint_retirement_idle_v1()) {
+        return true;
+    }
+    for (size_t index = 0; index < G_N_ELEMENTS(worker->work); index++) {
+        if (worker->work[index].material_held || worker->work[index].bytes_held) {
+            return true;
+        }
+    }
+    /* A retained completed diagnostic transcript is not a physical leaf.
+     * The actual module guard separately authenticates its terminal receipt. */
+    return false;
+}
+
+int qemu_crucible_source_action_original_publisher_returning_v1(
+    QemuCrucibleActionOriginal *action, QemuCrucibleMainControlBorrow *main,
+    QemuCruciblePublisherActionLoan **holder)
+{
+    int status = action_original_identity(action, main);
+
+    if (!status && (holder != &action->publisher || !action->returning ||
+        action->issuing || action->callback_active || action->uncertain ||
+        !action->module_closed || action->module_action || action->module_serial ||
+        action_original_children_held() ||
+        qemu_plugin_crucible_source_action_dispatch_current_v1(main, true))) {
+        status = -EBUSY;
+    }
+    return status;
+}
+
+int qemu_crucible_source_action_original_publisher_result_v1(
+    QemuCrucibleActionOriginal *action, QemuCrucibleMainControlBorrow *main,
+    QemuCruciblePublisherActionLoan **holder, int *first, int *post)
+{
+    int status = qemu_crucible_source_action_original_publisher_returning_v1(
+        action, main, holder);
+
+    if (status || !first || !post) {
+        return status ? status : -EINVAL;
+    }
+    *first = action->first_status;
+    *post = action->post_status;
+    return 0;
+}
+
+int qemu_crucible_source_action_original_closed_v1(QemuCrucibleMainControlBorrow *main)
+{
+    QemuCrucibleActionOriginal *action = &startup_source.action_original;
+
+    if (main != &startup_source.main_control_borrow) {
+        return -EPERM;
+    }
+    return action->held ? -EBUSY : 0;
+}
+
+int qemu_crucible_source_action_original_delivery_result_v1(
+    QemuCrucibleReceivedDeliveryOwner *delivery, uint64_t serial, int *first, int *post)
+{
+    QemuCrucibleActionOriginal *action = &startup_source.action_original;
+    int status = received_delivery_identity_locked(delivery, serial);
+
+    if (status || !first || !post) {
+        return status ? status : -EINVAL;
+    }
+    if (!action->serial) {
+        *first = 0;
+        *post = 0;
+        return 0;
+    }
+    if (action->delivery != delivery || action->delivery_serial != serial ||
+        action->process != getpid() || !qemu_thread_is_self(&action->thread)) {
+        return -ESTALE;
+    }
+    if (action->held || action->uncertain || action->publisher ||
+        action->module_action || action->module_serial || !action->module_closed ||
+        action_original_children_held()) {
+        return -EBUSY;
+    }
+    *first = action->first_status;
+    *post = action->post_status;
+    return 0;
+}
+
+static int action_original_failure(QemuCrucibleActionOriginal *action, int status)
+{
+    if (status) {
+        qatomic_cmpxchg(&action->first_status, 0, status < 0 ? status : -EPROTO);
+    }
+    return qatomic_load_acquire(&action->first_status);
+}
+
+static int action_original_evidence(QemuCrucibleActionOriginal *action, bool entering)
+{
+    const struct qemu_plugin_crucible_fingerprint_action_evidence_v1 *e =
+        &action->evidence;
+    const struct qemu_plugin_crucible_fingerprint_action_evidence_v1 *born =
+        &action->entered;
+
+    if (e->schema_version != 1 || e->struct_size != sizeof(*e) ||
+        e->primary_class != action->native_class || e->required_units != 1 ||
+        e->completed_required_units > 1 || e->preparation_present ||
+        e->preparation_required_units || e->preparation_completed_required_units ||
+        (entering && e->completed_required_units) ||
+        (!entering && (e->schema_version != born->schema_version ||
+         e->struct_size != born->struct_size || e->primary_class != born->primary_class ||
+         e->required_units != born->required_units ||
+         e->completed_required_units < action->completed_required_units))) {
+        return -EPROTO;
+    }
+    action->completed_required_units = e->completed_required_units;
+    return 0;
+}
+
+static int action_original_return_evidence(QemuCrucibleActionOriginal *action,
+                                            int callback_status)
+{
+    int status = action_original_evidence(action, false);
+
+    if (!status && !callback_status && !action->first_status &&
+        action->evidence.completed_required_units != action->evidence.required_units) {
+        status = -EPROTO;
+    }
+    return status;
+}
+
+static int action_original_rows_current(QemuCrucibleActionOriginal *action)
+{
+    const QemuCrucibleBoundaryActionRecord *cohort = &action->cohort;
+    const QemuCrucibleProducingActionRow *primary = &cohort->rows[0];
+    uint64_t now;
+    int status;
+
+    /* The branch independently implements one complete capture unit. A linked
+     * Preparation is its original containing dependency; this branch issues
+     * no local preparation work or completion credit. */
+    if (!cohort->present || cohort->dirty || cohort->primary_count != 1 ||
+        (cohort->planned_count != 1 && cohort->planned_count != 2) ||
+        cohort->born_mask != (1U << cohort->planned_count) - 1 ||
+        cohort->projected_mask != cohort->born_mask || primary->role || primary->state ||
+        primary->producing_class != action->native_class ||
+        primary->preparation_row_plus_one != (cohort->planned_count == 2 ? 2 : 0) ||
+        primary->required_units != 1 || primary->completed_required_units) {
+        return -ENOTSUP;
+    }
+    if (cohort->planned_count == 2) {
+        const QemuCrucibleProducingActionRow *preparation = &cohort->rows[1];
+
+        if (preparation->role != 1 || preparation->state ||
+            preparation->producing_class != QEMU_CRUCIBLE_ACTION_PREPARATION_CLASS ||
+            preparation->preparation_row_plus_one) {
+            return -ENOTSUP;
+        }
+    }
+    status = qemu_crucible_source_publisher_action_current_v1(
+        action->publisher, action->main, action);
+    if (!status) {
+        status = standing_clock(&now);
+    }
+    if (status) {
+        return status;
+    }
+    for (size_t index = 0; index < cohort->planned_count; index++) {
+        const QemuCrucibleProducingActionRow *row = &cohort->rows[index];
+
+        if (now < row->original_origin_ns || now < row->original_start_ns ||
+            now < row->genuine_progress_ns ||
+            (row->total_end_ns && now >= row->total_end_ns) ||
+            (row->progress_end_ns && now >= row->progress_end_ns) ||
+            (row->outer_end_ns && now >= row->outer_end_ns) ||
+            (row->private_interval_end_ns && now >= row->private_interval_end_ns)) {
+            return -ETIMEDOUT;
+        }
+    }
+    return 0;
+}
+
+static int action_original_frozen_slice(QemuCrucibleActionOriginal *action,
+                                        uint64_t now, uint64_t *slice)
+{
+    *slice = UINT64_MAX;
+    for (size_t index = 0; index < action->cohort.planned_count; index++) {
+        const QemuCrucibleProducingActionRow *row = &action->cohort.rows[index];
+        const uint64_t ends[] = {
+            row->total_end_ns, row->progress_end_ns, row->outer_end_ns,
+            row->private_interval_end_ns,
+        };
+
+        if (now < row->original_origin_ns || now < row->original_start_ns ||
+            now < row->genuine_progress_ns) {
+            return -ESTALE;
+        }
+        *slice = MIN(*slice, row->poll_ns);
+        for (size_t end = 0; end < G_N_ELEMENTS(ends); end++) {
+            if (ends[end]) {
+                if (now >= ends[end]) {
+                    return -ETIMEDOUT;
+                }
+                *slice = MIN(*slice, ends[end] - now);
+            }
+        }
+    }
+    return *slice ? 0 : -ETIMEDOUT;
+}
+
+/* Called only after the actual Material and actor-specific observer identity
+ * checks. The worker inherits the retained operation, never Main entry. */
+static int action_original_material_current(QemuCrucibleFingerprintMaterial *material,
+    QemuCrucibleFingerprintMaterialObserver *observer, uint64_t *bounded_ns)
+{
+    QemuCrucibleActionOriginal *action = material->operation.action_original;
+    struct pollfd cancellation = { .events = POLLIN };
+    uint64_t sequence = 0;
+    uint64_t now;
+    uint64_t slice;
+    int status;
+
+    if (action != &startup_source.action_original || !action->held ||
+        !action->qualified || !action->publisher || action->process != getpid() ||
+        action->serial != material->operation.action_serial ||
+        material->operation.plugin_id != action->member->installer.plugin_id) {
+        return -ESTALE;
+    }
+    status = qemu_crucible_preexec_standing_identity_v1(
+        startup_source.standing.lender, &observer->observation, &cancellation.fd);
+    if (!status) {
+        status = qemu_crucible_preexec_standing_sequence_v1(
+            startup_source.standing.lender, &sequence);
+    }
+    if (!status && sequence != action->publisher_sequence) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        int polled = poll(&cancellation, 1, 0);
+
+        status = polled < 0 ? -errno : polled || cancellation.revents ? -ECANCELED : 0;
+    }
+    if (!status) {
+        status = standing_clock(&now);
+    }
+    if (!status && now < observer->last_now_ns) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        observer->last_now_ns = now;
+        status = action_original_frozen_slice(action, now, &slice);
+    }
+    if (!status) {
+        status = standing_limits_current(&material->operation.admitted, now);
+    }
+    if (status) {
+        qatomic_cmpxchg(&material->first_status, 0, status);
+        return status;
+    }
+    if (bounded_ns) {
+        *bounded_ns = slice;
+    }
+    return qatomic_load_acquire(&action->first_status);
+}
+
+/* These are standing-publisher observations, never scheduler publication
+ * authority. Equality cannot manufacture the missing subscription owner. */
+static int action_original_publication_matches(QemuCrucibleActionOriginal *action,
+    uint64_t serial, uint64_t expected, uint64_t cached, uint64_t observed)
+{
+    return serial && action->serial == serial && expected && !(expected & 1) &&
+        action->publisher_sequence == expected && cached == expected &&
+        observed == expected ? 0 : -ESTALE;
+}
+
+static int action_original_publication_current(QemuCrucibleActionOriginal *action,
+                                               uint64_t serial, uint64_t expected)
+{
+    uint64_t sequence = 0;
+    int status = qemu_crucible_preexec_standing_sequence_v1(
+        startup_source.standing.lender, &sequence);
+
+    return status ? status : action_original_publication_matches(
+        action, serial, expected, startup_source.standing.sequence, sequence);
+}
+
+/* Factual saved-field comparison only; identity and callback phase are
+ * authenticated separately. Equal values never issue a publisher loan. */
+static bool action_original_edge_matches(QemuCrucibleActionOriginal *action,
+    QemuCrucibleMainControlBorrow *main, QemuCrucibleCommandConsumerMember *member,
+    QemuCruciblePublisherActionLoan *publisher, uint64_t serial)
+{
+    return action->main == main && action->member == member &&
+        action->publisher == publisher && action->serial == serial;
+}
+
+/* Enter and terminal post cannot use call_identity: qualification is still
+ * being established or callback_active has already ended. Their independent
+ * post keeps the same Main CALLING requirement and nominal publisher holder. */
+static int action_original_edge_post(QemuCrucibleActionOriginal *action,
+    QemuCrucibleMainControlBorrow *main, QemuCrucibleCommandConsumerMember *member,
+    QemuCruciblePublisherActionLoan *publisher, uint64_t serial,
+    uint64_t publisher_sequence)
+{
+    int status = action_original_identity(action, main);
+    int sequence_status;
+
+    if (!status && !action_original_edge_matches(
+        action, main, member, publisher, serial)) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        status = qemu_plugin_crucible_source_action_dispatch_current_v1(main, false);
+    }
+    if (!status && publisher) {
+        status = action_original_rows_current(action);
+    }
+    /* This is only a standing observation. Always run it after failed first
+     * or post checks; no result returns a publisher or module debt. */
+    sequence_status = action_original_publication_current(
+        action, serial, publisher_sequence);
+    return status ? status : sequence_status;
+}
+
+static int action_original_call_identity(QemuCrucibleActionOriginal *action,
+                                         qemu_plugin_id_t id)
+{
+    int status;
+
+    if (action != &startup_source.action_original) {
+        return -EPERM;
+    }
+    status = action_original_identity(action, action->main);
+    if (!status && (!action->qualified || !action->callback_active ||
+        action->issuing || action->returning || action->uncertain ||
+        action->member->installer.plugin_id != id ||
+        action->module_action != action->issued_action ||
+        action->module_serial != action->issued_serial ||
+        !action->module_action || !action->module_serial)) {
+        status = -EPERM;
+    }
+    if (!status) {
+        status = qemu_plugin_crucible_source_action_call_current_v1(action->main);
+    }
+    return status;
+}
+
+static int action_original_current_results(QemuCrucibleActionOriginal *action,
+    int callback_status, int validation_status, int post_status)
+{
+    action_original_failure(action, callback_status);
+    action_original_failure(action, validation_status);
+    action_original_failure(action, post_status);
+    if (!action->post_status && post_status) {
+        action->post_status = post_status < 0 ? post_status : -EPROTO;
+    }
+    return qatomic_load_acquire(&action->first_status);
+}
+
+int qemu_crucible_source_action_original_current_v1(
+    QemuCrucibleActionOriginal *action, qemu_plugin_id_t id)
+{
+    QemuCrucibleMainPayloadBorrow *payload;
+    QemuCrucibleMainControlBorrow *main;
+    QemuCrucibleCommandConsumerMember *member;
+    uint64_t serial;
+    uint64_t publisher_sequence;
+    int callback_status;
+    int post_status;
+    int sequence_status;
+    int status;
+
+    status = action_original_call_identity(action, id);
+    if (status || action->first_status) {
+        return status ? status : action->first_status;
+    }
+    status = action_original_rows_current(action);
+    if (status) {
+        return action_original_failure(action, status);
+    }
+    main = action->main;
+    serial = action->serial;
+    publisher_sequence = action->publisher_sequence;
+    status = action_original_publication_current(action, serial, publisher_sequence);
+    if (status) {
+        return action_original_failure(action, status);
+    }
+    payload = &main->payload_borrow;
+    member = action->member;
+    SOURCE_CALLBACK_MASKED_INVOKE(
+        callback_status, &member->action_current, member->action_current,
+        member->child->address,
+        &action->delivery->payload, payload->payload_serial,
+        &payload->module_borrow, payload->serial,
+        &action->module_action, action->issued_serial, &action->evidence,
+        member->child->address);
+    status = action_original_evidence(action, false);
+    if (action->module_action != action->issued_action ||
+        action->module_serial != action->issued_serial) {
+        action->uncertain = true;
+        status = -EPROTO;
+    }
+    /* The module result cannot stand in for independent Source/Core post,
+     * including when that result or its canonical output already failed. */
+    post_status = action_original_call_identity(action, id);
+    if (!post_status && (action->main != main || action->member != member ||
+                        action->serial != serial)) {
+        post_status = -ESTALE;
+    }
+    if (!post_status) {
+        post_status = action_original_rows_current(action);
+    }
+    /* Always perform the final acquire observation, even after another post
+     * failure. No failure permits a callback retry or discharges its debt. */
+    sequence_status = action_original_publication_current(action, serial, publisher_sequence);
+    if (!post_status) {
+        post_status = sequence_status;
+    }
+    return action_original_current_results(action, callback_status, status, post_status);
+}
+
+int qemu_crucible_source_action_original_enter_v1(QemuCrucibleMainControlBorrow *main)
+{
+    QemuCrucibleActionOriginal *action = &startup_source.action_original;
+    QemuCrucibleMainPayloadBorrow *payload;
+    QemuCrucibleCommandConsumerMember *member;
+    QemuCruciblePublisherActionLoan *publisher;
+    uint64_t serial;
+    uint64_t publisher_sequence;
+    int status;
+    int validation = 0;
+
+    status = qemu_plugin_crucible_source_action_dispatch_current_v1(main, false);
+    if (!status) {
+        status = main_payload_identity_locked(main);
+    }
+    if (status) {
+        return status;
+    }
+    member = main->handoff->member;
+    if (!member->action_enter) {
+        return -ENOTSUP;
+    }
+    payload = &main->payload_borrow;
+    if (action->held || !payload->held || payload->uncertain ||
+        payload->transition_active || payload->first_status ||
+        !payload->module_borrow || !payload->serial ||
+        payload->module_borrow != payload->issued_borrow ||
+        payload->serial != payload->issued_serial || action_original_children_held()) {
+        return -EBUSY;
+    }
+    if (startup_source.action_original_serial == UINT64_MAX) {
+        return -EOVERFLOW;
+    }
+    *action = (QemuCrucibleActionOriginal) {
+        .main = main, .member = member, .process = getpid(),
+        .delivery = main->handoff->delivery,
+        .delivery_serial = main->delivery_serial,
+        .publisher_sequence = startup_source.standing.sequence,
+        .serial = ++startup_source.action_original_serial,
+        .held = true, .issuing = true, .known_absent = UINT32_MAX,
+    };
+    qemu_thread_get_self(&action->thread);
+    serial = action->serial;
+    publisher_sequence = action->publisher_sequence;
+
+    status = qemu_crucible_source_publisher_action_acquire_v1(
+        main, action, &action->publisher);
+    if (!status && action->publisher) {
+        status = qemu_crucible_source_publisher_action_snapshot_v1(
+            action->publisher, main, action, &action->cohort);
+    }
+    if (!status && !action->publisher) {
+        status = -EPROTO;
+        action->uncertain = true;
+    }
+    publisher = action->publisher;
+    if (!status) {
+        action->observing_native = true;
+        status = qemu_crucible_ram_fingerprint_action_baseline_v1(
+            action, member->installer.plugin_id, &action->native_class,
+            &action->baseline_generation);
+        action->observing_native = false;
+    }
+    if (!status) {
+        SOURCE_CALLBACK_MASKED_INVOKE(
+            action->enter_status, &member->action_enter, member->action_enter,
+            member->child->address,
+            &main->handoff->delivery->payload, payload->payload_serial,
+            &payload->module_borrow, payload->serial,
+            &action->module_action, &action->module_serial, &action->known_absent,
+            &action->evidence, member->child->address);
+
+        /* Save birth before validating either the signed result or evidence. */
+        action->issued_action = action->module_action;
+        action->issued_serial = action->module_serial;
+        if (action->known_absent == 1 && !action->module_action &&
+            !action->module_serial && action->enter_status < 0) {
+            action->module_closed = true;
+        } else if (action->known_absent != 0 || !action->module_action ||
+                   !action->module_serial) {
+            action->uncertain = true;
+            validation = -EPROTO;
+        }
+        if (!validation && !action->module_closed) {
+            validation = action_original_evidence(action, true);
+            action->entered = action->evidence;
+        }
+        status = action->enter_status ? action->enter_status : validation;
+    } else {
+        /* No semantic callback ran, so there is genuinely no module debt. */
+        action->module_closed = true;
+    }
+    if (!status) {
+        status = action_original_rows_current(action);
+    }
+    /* Preserve the original first cause independently of Source/Core post. */
+    action_original_failure(action, status);
+    action->enter_post = action_original_edge_post(
+        action, main, member, publisher, serial, publisher_sequence);
+    action->post_status = action->enter_post;
+    action->issuing = false;
+    action->qualified = !status && !action->enter_post;
+    action->callback_active = action->qualified;
+    action_original_failure(action, status ? status : action->enter_post);
+    /* ENOTSUP is reserved at this Core boundary for an actual legacy member.
+     * A failed v5 action must never enter the registered callback. */
+    return action->first_status == -ENOTSUP ? -ECANCELED : action->first_status;
+}
+
+int qemu_crucible_source_action_original_post_v1(QemuCrucibleMainControlBorrow *main)
+{
+    QemuCrucibleActionOriginal *action = &startup_source.action_original;
+    QemuCrucibleMainPayloadBorrow *payload;
+    QemuCrucibleCommandConsumerMember *member;
+    QemuCruciblePublisherActionLoan *publisher;
+    uint64_t serial;
+    uint64_t publisher_sequence;
+    int callback_status;
+    int status;
+
+    if (!action->held) {
+        return 0;
+    }
+    status = action_original_identity(action, main);
+    if (!status) {
+        status = qemu_plugin_crucible_source_action_dispatch_current_v1(main, false);
+    }
+    if (status || !action->callback_active || action->post_attempted) {
+        return status ? status : action->first_status;
+    }
+    action->post_attempted = true;
+    payload = &main->payload_borrow;
+    member = action->member;
+    publisher = action->publisher;
+    serial = action->serial;
+    publisher_sequence = action->publisher_sequence;
+    action->callback_first = INT32_MAX;
+    action->callback_post = INT32_MAX;
+    SOURCE_CALLBACK_MASKED_INVOKE(
+        callback_status, &member->action_post, member->action_post, member->child->address,
+        &main->handoff->delivery->payload, payload->payload_serial,
+        &payload->module_borrow, payload->serial,
+        &action->module_action, action->issued_serial,
+        &action->callback_first, &action->callback_post, &action->evidence,
+        member->child->address);
+    action->callback_active = false;
+    status = action_original_evidence(action, false);
+    if (callback_status > 0 || action->callback_first > 0 || action->callback_post > 0 ||
+        action->module_action != action->issued_action ||
+        action->module_serial != action->issued_serial) {
+        action->uncertain = true;
+        status = -EPROTO;
+    }
+    action_original_failure(action, callback_status);
+    action_original_failure(action, action->callback_first);
+    action_original_failure(action, action->callback_post);
+    if (!action->post_status) {
+        action->post_status = action->callback_post;
+    }
+    action_original_failure(action, status);
+    status = action_original_edge_post(
+        action, main, member, publisher, serial, publisher_sequence);
+    if (!action->post_status) {
+        action->post_status = status;
+    }
+    return action_original_failure(action, status);
+}
+
+int qemu_crucible_source_action_original_return_v1(QemuCrucibleMainControlBorrow *main)
+{
+    QemuCrucibleActionOriginal *action = &startup_source.action_original;
+    QemuCrucibleMainPayloadBorrow *payload;
+    QemuCrucibleCommandConsumerMember *member;
+    int callback_status;
+    int status;
+
+    if (!action->held) {
+        return 0;
+    }
+    status = action_original_identity(action, main);
+    if (!status) {
+        status = qemu_plugin_crucible_source_action_dispatch_current_v1(main, true);
+    }
+    if (status || action->callback_active || action->issuing || action->uncertain) {
+        return status ? status : -EBUSY;
+    }
+    action->returning = true;
+    member = action->member;
+    payload = &main->payload_borrow;
+    if (!action->module_closed) {
+        action->locally_returned = UINT32_MAX;
+        SOURCE_CALLBACK_MASKED_INVOKE(
+            callback_status, &member->action_return, member->action_return,
+            member->child->address,
+            &main->handoff->delivery->payload, payload->payload_serial,
+            &payload->module_borrow, payload->serial,
+            &action->module_action, &action->module_serial,
+            &action->evidence, &action->locally_returned, member->child->address);
+        action->return_status = callback_status;
+        if (action->locally_returned == 1 && !action->module_action &&
+            !action->module_serial) {
+            action->module_closed = true;
+        } else if (action->locally_returned != 0 || callback_status >= 0 ||
+                   action->module_action != action->issued_action ||
+                   action->module_serial != action->issued_serial) {
+            action->uncertain = true;
+            action_original_failure(action, -EPROTO);
+        }
+        action_original_failure(action, callback_status);
+        /* Physical consumption is saved first. Invalid or incomplete final
+         * evidence refuses healthy completion without resurrecting that debt. */
+        if (action->module_closed) {
+            status = action_original_return_evidence(action, callback_status);
+            action_original_failure(action, status);
+        }
+    }
+    if (action->module_closed && !action->uncertain && action->publisher &&
+        !action_original_children_held()) {
+        status = qemu_crucible_source_publisher_action_return_v1(
+            &action->publisher, main, action);
+        action_original_failure(action, status);
+    }
+    if (action->module_closed && !action->uncertain && !action->publisher &&
+        !action_original_children_held()) {
+        action->held = false;
+    }
+    action->returning = false;
+    return action->held ? -EBUSY : action->first_status;
+}
+
+#else
+
+int qemu_crucible_source_action_original_enter_v1(QemuCrucibleMainControlBorrow *main)
+{
+    return -ENOTSUP;
+}
+
+int qemu_crucible_source_action_original_post_v1(QemuCrucibleMainControlBorrow *main)
+{
+    return -ENOTSUP;
+}
+
+int qemu_crucible_source_action_original_return_v1(QemuCrucibleMainControlBorrow *main)
+{
+    return -ENOTSUP;
+}
+
+int qemu_crucible_source_action_original_closed_v1(QemuCrucibleMainControlBorrow *main)
+{
+    return -ENOTSUP;
+}
+
+int qemu_crucible_source_action_original_current_v1(
+    QemuCrucibleActionOriginal *action, qemu_plugin_id_t id)
+{
+    return -ENOTSUP;
+}
+
+int qemu_crucible_source_action_original_native_observing_v1(
+    QemuCrucibleActionOriginal *action, qemu_plugin_id_t id)
+{
+    return -ENOTSUP;
+}
+
+int qemu_crucible_source_action_original_delivery_result_v1(
+    QemuCrucibleReceivedDeliveryOwner *delivery, uint64_t serial, int *first, int *post)
+{
+    return -ENOTSUP;
+}
+
+int qemu_crucible_source_action_original_publisher_issuing_v1(
+    QemuCrucibleActionOriginal *action, QemuCrucibleMainControlBorrow *main,
+    QemuCruciblePublisherActionLoan **holder)
+{
+    return -ENOTSUP;
+}
+
+int qemu_crucible_source_action_original_publisher_current_v1(
+    QemuCrucibleActionOriginal *action, QemuCrucibleMainControlBorrow *main,
+    QemuCruciblePublisherActionLoan **holder)
+{
+    return -ENOTSUP;
+}
+
+int qemu_crucible_source_action_original_publisher_returning_v1(
+    QemuCrucibleActionOriginal *action, QemuCrucibleMainControlBorrow *main,
+    QemuCruciblePublisherActionLoan **holder)
+{
+    return -ENOTSUP;
+}
