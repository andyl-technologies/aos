+int qemu_crucible_source_main_payload_borrow_v1(QemuCrucibleMainControlBorrow *borrow)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    QemuCrucibleMainPayloadBorrow *payload;
+    QemuCrucibleReadyDeliveryHandoff *handoff;
+    int status;
+    int callback_status;
+    int validation = 0;
+
+    if (borrow != &startup_source.main_control_borrow || !borrow->invocation) {
+        return -EPERM;
+    }
+    status = qemu_plugin_crucible_native_main_control_current_v1(borrow->invocation, false);
+    if (!status) {
+        QemuCrucibleNativeInvocation *frame = borrow->invocation->frame;
+
+        status = qemu_plugin_crucible_source_main_dispatch_current_v1(
+            frame->registration, frame->cpu, borrow->invocation, false, borrow->holder);
+    }
+    if (status) {
+        return status;
+    }
+    qemu_mutex_lock(&commands->mutex);
+    status = main_payload_identity_locked(borrow);
+    payload = &borrow->payload_borrow;
+    handoff = borrow->handoff;
+    if (!status && payload->attempted) {
+        status = -EALREADY;
+    }
+    if (!status && (!handoff->member->payload_borrow_acquire ||
+                    !handoff->member->payload_borrow_release)) {
+        status = -ENOTSUP;
+    }
+    if (status) {
+        qemu_mutex_unlock(&commands->mutex);
+        return status;
+    }
+    /* The exact Main owner pins child/member/payload/lender before module
+     * entry. Its stable interior fields are paid by the actual Source sizeof. */
+    *payload = (QemuCrucibleMainPayloadBorrow) {
+        .payload = handoff->delivery->payload,
+        .payload_serial = handoff->delivery->payload_serial,
+        .acquire = handoff->member->payload_borrow_acquire,
+        .release = handoff->member->payload_borrow_release,
+        .userdata = handoff->child->address,
+        .known_absent = UINT32_MAX,
+        .attempted = true,
+        .transition_active = true,
+    };
+    qemu_mutex_unlock(&commands->mutex);
+
+    SOURCE_CALLBACK_MASKED_INVOKE(
+        callback_status, &payload->acquire, payload->acquire, payload->userdata,
+        &handoff->delivery->payload, payload->payload_serial,
+        &payload->module_borrow, &payload->serial, &payload->known_absent,
+        payload->userdata);
+
+    qemu_mutex_lock(&commands->mutex);
+    payload->acquire_status = callback_status;
+    payload->held = payload->module_borrow && payload->serial;
+    if (callback_status > 0 ||
+        !((payload->known_absent == 0 && payload->held) ||
+          (payload->known_absent == 1 && !payload->module_borrow &&
+           !payload->serial && callback_status < 0))) {
+        validation = -EPROTO;
+        payload->uncertain = true;
+    }
+    payload->issued_borrow = payload->module_borrow;
+    payload->issued_serial = payload->serial;
+    if (!validation && payload->known_absent == 1) {
+        payload->closed = true;
+    }
+    /* Save real birth/absence independently before the post. A negative post
+     * neither releases a born record nor invents one after known absence. */
+    payload->acquire_post = main_payload_identity_locked(borrow);
+    payload->transition_active = false;
+    status = main_payload_record_failure(payload, callback_status, validation,
+                                         payload->acquire_post);
+    qemu_mutex_unlock(&commands->mutex);
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
