+int qemu_plugin_crucible_ram_capture_begin_v2(
+    uint32_t require_full, uint64_t owner_token,
+    struct qemu_plugin_crucible_ram_capture_v1 *out)
+{
+    bool observation = !owner_token && current_cpu && fault_root_writer_scope &&
+        qemu_plugin_crucible_single_threaded_rr() && replay_mutex_owned();
+    int status;
+
+    if (!out || require_full > 1 || capture_active || logical_capture->active ||
+        !(owner_token ? diagnostic_capture_authorized(owner_token) : capture_authorized())) {
+        return -EPERM;
+    }
+    /* Preserve the authentic existing instruction-boundary root/fault route.
+     * Its module already owns an independent observation operation. No Source
+     * borrow/rearm callback runs under the existing replay mutex; commit cannot
+     * turn this observation into a fingerprint dirty ACK. */
+    capture_observation_only = observation || owner_token;
+    if (!capture_observation_only) {
+        /* EVERY ACK-capable ordinary capture borrows the actual entered outer
+         * module operation before native logging/inventory/generation effects. */
+        status = fingerprint_retirement_prepare();
+        if (status) {
+            return status;
+        }
+    }
+    status = ram_capture_begin(require_full, owner_token, out);
+    if (status) {
+        if (!capture_observation_only) {
+            fingerprint_retirement_cancel(status);
+        }
+        capture_observation_only = false;
+        return status;
+    }
+    if (!capture_observation_only) {
+        /* These are native current-capture facts, never old publication dirt. */
+        ordinary_fingerprint.operation_capture_generation = capture_generation;
+        ordinary_fingerprint.topology = capture_topology_generation;
+        ordinary_fingerprint.dirty = capture_dirty_generation;
+    }
+    return 0;
+}
