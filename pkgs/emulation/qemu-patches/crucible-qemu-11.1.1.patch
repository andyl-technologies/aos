diff --git a/include/hw/acpi/piix4-fingerprint.h b/include/hw/acpi/piix4-fingerprint.h
new file mode 100644
index 0000000000000000000000000000000000000000..35cb42e235dc4dbfbccdc2b6f9086953305262d0
--- /dev/null
+++ b/include/hw/acpi/piix4-fingerprint.h
@@ -0,0 +1,116 @@
+/*
+ * PIIX4 PM fingerprint projection internals
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef HW_ACPI_PIIX4_FINGERPRINT_H
+#define HW_ACPI_PIIX4_FINGERPRINT_H
+
+#include "hw/acpi/piix4.h"
+#include "migration/qemu-file.h"
+#include "qapi/error.h"
+
+static inline bool piix4_pm_hotplug_fingerprint_validate(
+    const PIIX4PMState *pm, bool cpu_hotplug_present, Error **errp)
+{
+    const AcpiPciHpState *pcihp = &pm->acpi_pci_hotplug;
+    const CPUHotplugState *cpuhp = &pm->cpuhp_state;
+    const MemHotplugState *memhp = &pm->acpi_memory_hotplug;
+
+    if ((cpu_hotplug_present &&
+         (cpuhp->dev_count > 4096 ||
+          (cpuhp->dev_count != 0 && !cpuhp->devs))) ||
+        (memhp->is_enabled &&
+         (memhp->dev_count > ACPI_MAX_RAM_SLOTS ||
+          (memhp->dev_count != 0 && !memhp->devs)))) {
+        error_setg(errp, "PIIX4 PM fingerprint has invalid hotplug geometry");
+        return false;
+    }
+
+    for (size_t i = 0;
+         i < ARRAY_SIZE(pcihp->acpi_pcihp_pci_status); i++) {
+        if (pcihp->acpi_pcihp_pci_status[i].down != 0) {
+            error_setg(errp,
+                       "PIIX4 PM cannot project a pending PCI removal");
+            return false;
+        }
+    }
+
+    if (cpu_hotplug_present) {
+        for (uint32_t i = 0; i < cpuhp->dev_count; i++) {
+            if (cpuhp->devs[i].fw_remove) {
+                error_setg(errp,
+                           "PIIX4 PM cannot project a pending firmware CPU "
+                           "removal");
+                return false;
+            }
+        }
+    }
+
+    if (memhp->is_enabled) {
+        for (uint32_t i = 0; i < memhp->dev_count; i++) {
+            if (memhp->devs[i].is_removing) {
+                error_setg(errp,
+                           "PIIX4 PM cannot project a pending memory removal");
+                return false;
+            }
+        }
+    }
+
+    return true;
+}
+
+static inline void piix4_pm_hotplug_fingerprint_put(
+    QEMUFile *f, const PIIX4PMState *pm, bool cpu_hotplug_present)
+{
+    const AcpiPciHpState *pcihp = &pm->acpi_pci_hotplug;
+    const CPUHotplugState *cpuhp = &pm->cpuhp_state;
+    const MemHotplugState *memhp = &pm->acpi_memory_hotplug;
+
+    qemu_put_byte(f, pcihp->use_acpi_hotplug_bridge);
+    qemu_put_byte(f, pcihp->use_acpi_root_pci_hotplug);
+    qemu_put_be32(f, pcihp->hotplug_select);
+    qemu_put_be32(f, pcihp->acpi_index);
+    for (size_t i = 0;
+         i < ARRAY_SIZE(pcihp->acpi_pcihp_pci_status); i++) {
+        const AcpiPciHpPciStatus *status =
+            &pcihp->acpi_pcihp_pci_status[i];
+
+        qemu_put_be32(f, status->up);
+        qemu_put_be32(f, status->hotplug_enable);
+    }
+
+    qemu_put_byte(f, cpu_hotplug_present);
+    if (cpu_hotplug_present) {
+        qemu_put_be32(f, cpuhp->selector);
+        qemu_put_byte(f, cpuhp->command);
+        qemu_put_be32(f, cpuhp->dev_count);
+        for (uint32_t i = 0; i < cpuhp->dev_count; i++) {
+            const AcpiCpuStatus *status = &cpuhp->devs[i];
+
+            qemu_put_be64(f, status->arch_id);
+            qemu_put_byte(f, status->cpu != NULL);
+            qemu_put_byte(f, status->is_inserting);
+            qemu_put_byte(f, status->is_removing);
+            qemu_put_be32(f, status->ost_event);
+            qemu_put_be32(f, status->ost_status);
+        }
+    }
+
+    qemu_put_byte(f, memhp->is_enabled);
+    if (memhp->is_enabled) {
+        qemu_put_be32(f, memhp->selector);
+        qemu_put_be32(f, memhp->dev_count);
+        for (uint32_t i = 0; i < memhp->dev_count; i++) {
+            const MemStatus *status = &memhp->devs[i];
+
+            qemu_put_byte(f, status->dimm != NULL);
+            qemu_put_byte(f, status->is_enabled);
+            qemu_put_byte(f, status->is_inserting);
+            qemu_put_be32(f, status->ost_event);
+            qemu_put_be32(f, status->ost_status);
+        }
+    }
+}
+
+#endif
