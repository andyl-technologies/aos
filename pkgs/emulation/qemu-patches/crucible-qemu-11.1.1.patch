+static void test_rr_wake_pending_epoch_cannot_collapse_under_producer(void)
+{
+    unsigned int state = RR_TCG_EXEC_IDLE_WAKE_PENDING;
+    unsigned int claimed_state = UINT_MAX;
+    unsigned int work_observations = 0;
+    uint64_t consumed_generation = 0;
+    uint64_t publish_generation = 1;
+    RRCrucibleSimWakeSnapshot snapshot = { 0 };
+
+    g_assert_true(rr_crucible_sim_wake_consume_snapshot(
+        &state, &publish_generation, consumed_generation, &snapshot));
+    g_assert_true(snapshot.publication_pending);
+    work_observations++;
+    g_assert_true(rr_crucible_sim_wake_try_claim(&state, &claimed_state));
+    g_assert_cmpuint(claimed_state, ==, RR_TCG_EXEC_IDLE_WAKE_PENDING);
+    rr_crucible_sim_wake_publish(
+        &state, claimed_state, &publish_generation);
+
+    /* The numeric state completed a full ABA, but the epoch exposes it. */
+    g_assert_cmpint(rr_crucible_sim_wake_try_collapse(
+                        &state, &publish_generation, &consumed_generation,
+                        &snapshot), ==,
+                    RR_TCG_WAKE_CONSUME_RETRY);
+    g_assert_cmpuint(consumed_generation, ==, 0);
+    g_assert_cmpuint(qatomic_read(&state), ==, RR_TCG_EXEC_IDLE);
+
+    /* The new publication remains pending even after the stale CAS. */
+    g_assert_true(rr_crucible_sim_wake_consume_snapshot(
+        &state, &publish_generation, consumed_generation, &snapshot));
+    g_assert_true(snapshot.publication_pending);
+    work_observations++;
+    g_assert_cmpint(rr_crucible_sim_wake_try_collapse(
+                        &state, &publish_generation, &consumed_generation,
+                        &snapshot), ==,
+                    RR_TCG_WAKE_CONSUME_PENDING);
+    g_assert_cmpuint(consumed_generation, ==, 2);
+    g_assert_cmpuint(work_observations, ==, 2);
+    g_assert_cmpuint(qatomic_read(&state), ==, RR_TCG_EXEC_IDLE);
+}
