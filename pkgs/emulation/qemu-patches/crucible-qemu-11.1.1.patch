+    size_t member, QemuCrucibleNativeGroupDescriptorView *out)
+{
+    if (member) {
+        return false;
+    }
+    *out = (QemuCrucibleNativeGroupDescriptorView) {
+        .coordinate = &qemu_plugin_control_boundary_cb,
+        .function = qemu_plugin_control_boundary_cb,
+        .userdata = qemu_plugin_control_boundary_userdata,
