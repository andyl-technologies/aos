+
+typedef enum InvalidStream {
+    MISSING_EXACT,
+    INVALID_MODE,
+    INVALID_ACTIVE,
+    INVALID_PROJECTION,
+    INVALID_DEADLINE,
+    REVERSED_EVENTS,
+    DUPLICATE_EXACT,
+    TRUNCATED_EXACT,
+    INACTIVE_PAYLOAD,
+    ZERO_PERIOD,
+} InvalidStream;
+
+static void test_invalid_stream(gconstpointer data)
+{
+    InvalidStream invalid = GPOINTER_TO_INT(data);
+    ptimer_state *original;
+    ptimer_state *restored;
+    GByteArray *bytes;
+    const size_t parent_size = 53;
+    size_t payload;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    initialize_clock(true);
+    observed_ps = ((__int128)1 << 120) + 357;
+    original = create_countdown(3);
+    if (invalid == INACTIVE_PAYLOAD) {
+        ptimer_transaction_begin(original);
+        ptimer_stop(original);
+        ptimer_transaction_commit(original);
+    }
+    bytes = save_state(original);
+    g_assert_cmpuint(bytes->data[parent_size], ==, QEMU_VM_SUBSECTION);
+    payload = parent_size + 2 + bytes->data[parent_size + 1] + 4;
+    g_assert_cmpuint(bytes->len, ==, payload + 58 + 1);
+
+    switch (invalid) {
+    case MISSING_EXACT:
+        g_byte_array_set_size(bytes, parent_size + 1);
+        bytes->data[parent_size] = QEMU_VM_EOF;
+        break;
+    case INVALID_MODE:
+        bytes->data[payload] = 2;
+        break;
+    case INVALID_ACTIVE:
+        bytes->data[payload + 41] = 2;
+        break;
+    case INVALID_PROJECTION:
+        bytes->data[52] ^= 1;
+        break;
+    case INVALID_DEADLINE:
+    case INACTIVE_PAYLOAD:
+        bytes->data[payload + 57] ^= 1;
+        break;
+    case REVERSED_EVENTS:
+        /* Replace next with zero while the genuine last event is positive. */
+        memset(bytes->data + payload + 21, 0, 20);
+        break;
+    case DUPLICATE_EXACT: {
+        GByteArray *duplicate = g_byte_array_sized_new(bytes->len);
+
+        g_byte_array_append(duplicate, bytes->data + parent_size,
+                            bytes->len - parent_size - 1);
+        g_byte_array_set_size(bytes, bytes->len - 1);
+        g_byte_array_append(bytes, duplicate->data, duplicate->len);
+        g_byte_array_append(bytes, (const uint8_t[]) { QEMU_VM_EOF }, 1);
+        g_byte_array_unref(duplicate);
+        break;
+    }
+    case TRUNCATED_EXACT:
+        g_byte_array_set_size(bytes, bytes->len - 8);
+        break;
+    case ZERO_PERIOD:
+        /* An enabled countdown cannot run without an integer or fraction. */
+        memset(bytes->data + 17, 0, 12);
+        break;
+    }
+
+    restored = ptimer_init(observe_expiry, NULL, PTIMER_POLICY_LEGACY);
+    timer_mod_ps_wide(restored->timer, observed_ps + 12345);
+    g_assert_cmpint(load_state(restored, bytes), <, 0);
+    g_assert_true(timer_pending(restored->timer));
+    g_assert_true(timer_expire_time_ps_wide(restored->timer) ==
+                  observed_ps + 12345);
+    g_assert_cmpuint(callbacks, ==, 0);
+    ptimer_free(original);
+    ptimer_free(restored);
+    g_byte_array_unref(bytes);
+}
+
+static void test_inactive_zero_period(gconstpointer data)
