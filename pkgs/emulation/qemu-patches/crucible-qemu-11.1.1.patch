@@ -0,0 +1,160 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Check literal action-edge post refusal and factual saved-field comparisons.
+
+The canonical action is deliberately invalid and retained. Its actual identity
+body refuses before Main payload authentication. The lender fixture only refuses;
+no publisher, module callback, Source issuer or successful operation is supplied.
+"""
+
+import argparse
+import json
+import os
+from pathlib import Path
+import runpy
+import shlex
+import subprocess
+
+
+PREFIX = r'''
+#include "qemu/osdep.h"
+#include "plugins/crucible-startup-source.h"
+
+static QemuCrucibleStartupSourceControl startup_source;
+static unsigned sequence_calls;
+
+/* These owner-dependent edges must remain unexecuted, never grant a parent. */
+static int main_payload_identity_locked(QemuCrucibleMainControlBorrow *main)
+{
+    abort();
+}
+
+int qemu_plugin_crucible_source_action_dispatch_current_v1(
+    QemuCrucibleMainControlBorrow *main, bool returning)
+{
+    abort();
+}
+
+static int action_original_rows_current(QemuCrucibleActionOriginal *action)
+{
+    abort();
+}
+
+/* Negative-only missing-lender edge; not an accepting standing provider. */
+int qemu_crucible_preexec_standing_sequence_v1(
+    QemuCrucibleStandingPurposeOwner *lender, uint64_t *sequence)
+{
+    assert(!lender);
+    sequence_calls++;
+    return -ENOKEY;
+}
+'''
+
+CHECKS = r'''
+int main(void)
+{
+    QemuCrucibleActionOriginal *action = &startup_source.action_original;
+    QemuCrucibleMainControlBorrow *main = &startup_source.main_control_borrow;
+    QemuCrucibleCommandConsumerMember member = { 0 }, other_member = { 0 };
+    QemuCrucibleMainControlBorrow other_main = { 0 };
+    unsigned char publisher_sentinel, other_publisher_sentinel;
+    QemuCruciblePublisherActionLoan *publisher = (void *)&publisher_sentinel;
+    QemuCruciblePublisherActionLoan *other_publisher = (void *)&other_publisher_sentinel;
+
+    /* Pointer sentinels are compared only; neither denotes an issued loan. */
+    *action = (QemuCrucibleActionOriginal) {
+        .main = main, .member = &member, .publisher = publisher, .serial = 11,
+        .publisher_sequence = 8, .held = true, .uncertain = true,
+    };
+    assert(action_original_edge_matches(action, main, &member, publisher, 11));
+    assert(!action_original_edge_matches(action, &other_main, &member, publisher, 11));
+    assert(!action_original_edge_matches(action, main, &other_member, publisher, 11));
+    assert(!action_original_edge_matches(action, main, &member, other_publisher, 11));
+    assert(!action_original_edge_matches(action, main, &member, publisher, 12));
+
+    /* Actual identity rejects process zero. Independent final observation
+     * must still execute after both a prior first refusal and failed post. */
+    assert(action_original_failure(action, -EIO) == -EIO);
+    int post = action_original_edge_post(action, main, &member, publisher, 11, 8);
+
+    assert(post == -ESTALE);
+    assert(sequence_calls == 1);
+    assert(action_original_current_results(action, 0, 0, post) == -EIO);
+    assert(action->first_status == -EIO && action->post_status == -ESTALE);
+    post = action_original_edge_post(action, main, &member, publisher, 11, 8);
+    assert(post == -ESTALE && sequence_calls == 2);
+    assert(action_original_current_results(action, -ECANCELED, 0, post) == -EIO);
+    assert(action->held && action->uncertain && !action->module_closed);
+    assert(action->publisher == publisher && action->serial == 11);
+    assert(!action->callback_active && !action->qualified);
+    puts("PASS literal failed identity still observes final sequence; factual fields only; no owner issued");
+    return 0;
+}
+'''
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--source-root", type=Path,
+                        default=Path(__file__).resolve().parents[2])
+    parser.add_argument("--output-dir", type=Path, required=True)
+    args = parser.parse_args()
+    args.output_dir.mkdir(parents=True, exist_ok=True)
+    extract = runpy.run_path(str(
+        args.source_root / "tests/unit/extract-crucible-startup-source-controls.py"))
+    source = (args.source_root / "plugins/crucible-action-original.inc.h").read_text()
+    literal = "\n\n".join(extract["function"](source, signature) for signature in (
+        "static int action_original_identity(",
+        "static int action_original_failure(",
+        "static int action_original_publication_matches(",
+        "static int action_original_publication_current(",
+        "static bool action_original_edge_matches(",
+        "static int action_original_edge_post(",
+        "static int action_original_current_results(",
+    ))
+    controls = {
+        "positive": literal,
+        "omit-main": literal.replace("action->main == main &&", "true &&"),
+        "omit-member": literal.replace("action->member == member &&", "true &&"),
+        "omit-holder": literal.replace("action->publisher == publisher &&", "true &&"),
+        "omit-serial": literal.replace("action->serial == serial;", "true;"),
+        "omit-final-observation": literal.replace(
+            "sequence_status = action_original_publication_current(\n"
+            "        action, serial, publisher_sequence);", "sequence_status = -ENOKEY;"),
+        "skip-final-on-post-failure": literal.replace(
+            "sequence_status = action_original_publication_current(",
+            "sequence_status = status ? status : action_original_publication_current("),
+        "override-post-cause": literal.replace(
+            "return status ? status : sequence_status;", "return sequence_status;"),
+    }
+    proof = {}
+    for name, body in controls.items():
+        if name != "positive" and body == literal:
+            raise ValueError(f"unchanged omission: {name}")
+        generated = args.output_dir / f"{name}.c"
+        generated.write_text(PREFIX + body + CHECKS)
+        binary = args.output_dir / name
+        command = [os.environ.get("CC", "cc"),
+                   *shlex.split(os.environ.get("CFLAGS", "")), str(generated),
+                   "-o", str(binary), *shlex.split(os.environ.get("LDFLAGS", ""))]
+        (args.output_dir / f"{name}.command.json").write_text(
+            json.dumps(command, indent=2) + "\n")
+        compiled = subprocess.run(command, cwd=args.source_root, text=True,
+                                  stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
+        (args.output_dir / f"{name}.compile.log").write_text(compiled.stdout)
+        compiled.check_returncode()
+        result = subprocess.run([str(binary)], cwd=args.output_dir, text=True,
+                                stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
+                                timeout=30)
+        (args.output_dir / f"{name}.run.log").write_text(result.stdout)
+        expected = 0 if name == "positive" else -6
+        if result.returncode != expected or (name != "positive" and
+                                            "Assertion" not in result.stdout):
+            raise RuntimeError(f"unexpected {name}: {result.returncode}\n{result.stdout}")
+        proof[name] = {"returncode": result.returncode, "output": result.stdout}
+    (args.output_dir / "proof.json").write_text(json.dumps(proof, indent=2) + "\n")
+    print(proof["positive"]["output"], end="")
+    print("PASS seven independent omission controls; real callback/owner paths unexecuted")
+
+
+if __name__ == "__main__":
+    main()
