+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Check literal manifest/hash and prebirth factory component boundaries.
+
+Factory controls observe CPU lookup and selected refusal. Streaming controls
+compare actual hash/manifest bodies with GLib using factual schema rows.
+Neither component issues a Source owner or models a launched physical receipt.
+"""
+
+import argparse
+import json
+import os
+from pathlib import Path
+import runpy
+import shlex
+import subprocess
+
+
+INPUTS = r"""
+static bool selected, cpu_present;
+static unsigned lookups;
+static CPUState input_cpu;
+static CPUClass input_class;
+CPUTailQ cpus_queue = QTAILQ_HEAD_INITIALIZER(cpus_queue);
+
+static CPUState *input_lookup(int index)
+{
+    assert(index == 0);
