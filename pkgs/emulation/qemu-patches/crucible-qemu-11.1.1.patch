+/* These arbitrary scalars test evidence decoding, not issuer or paid values. */
+#define FIXTURE_TOTAL UINT64_C(0x0102030405060708)
+#define FIXTURE_METADATA UINT64_C(0x1112131415161718)
+#define FIXTURE_RESIDENT UINT64_C(0x2122232425262728)
+#define FIXTURE_PROCESS UINT64_C(0x3132333435363738)
