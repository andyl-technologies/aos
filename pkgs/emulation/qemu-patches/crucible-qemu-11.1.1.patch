+static void test_ordinary_migration(void)
+{
+    ptimer_state *original;
+    ptimer_state *restored;
+    GByteArray *bytes;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    initialize_clock(false);
+    observed_ps = 357000;
+    original = ptimer_init(observe_expiry, NULL, PTIMER_POLICY_LEGACY);
+    ptimer_transaction_begin(original);
+    ptimer_set_period(original, 1000);
+    ptimer_set_count(original, 3);
+    ptimer_run(original, 1);
+    ptimer_transaction_commit(original);
+    bytes = save_state(original);
+    /* The original parent format and its following outer marker stay intact. */
+    g_assert_cmpuint(bytes->len, ==, 54);
+    restored = ptimer_init(observe_expiry, NULL, PTIMER_POLICY_LEGACY);
+    g_assert_cmpint(load_state(restored, bytes), ==, 0);
+    g_assert_cmpuint(timer_expire_time_ns(restored->timer), ==, 3357);
+    g_assert_cmpuint(ptimer_get_count(restored), ==, 3);
+    ptimer_free(original);
+    observed_ps = 3356000;
+    qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL);
+    g_assert_cmpuint(callbacks, ==, 0);
+    observed_ps = 3357000;
+    qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL);
+    g_assert_cmpuint(callbacks, ==, 1);
