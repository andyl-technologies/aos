+    }
+    if (queue->cwptr != -1) {
+        command_reply_count =
+            (queue->cwptr - queue->rptr) & (PS2_BUFFER_SIZE - 1);
+        if (command_reply_count > queue->count) {
+            error_setg(errp, "PS/2 command reply exceeds the live queue");
+            return false;
+        }
