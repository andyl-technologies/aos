+static void test_registry_busless_nested_device(void)
+{
+    Object *nodes[128];
+    Object *root = object_new(TYPE_CONTAINER);
+    Object *parent = root;
+    RegistryTestDevice *test = registry_test_new(7);
+    uint64_t count = 0;
+    Error *error = NULL;
+
+    rust_bql_mock_lock();
+    object_property_add_child(object_get_root(), "private-owner-tree", root);
+    for (size_t index = 0; index < G_N_ELEMENTS(nodes); index++) {
+        nodes[index] = object_property_add_new_container(parent, "nested-owner");
+        parent = nodes[index];
+    }
+    /* A realized busless owner need not belong to the global QOM root. */
+    object_property_add_child(parent, "busless-device", OBJECT(test));
+    qdev_realize(DEVICE(test), NULL, &error_fatal);
+    g_assert_null(test->parent_obj.parent_bus);
+    g_assert_nonnull(test->parent_obj.canonical_path);
+    object_unparent(root);
+
+    registry_visits = 0;
+    g_assert_cmpint(qemu_crucible_ram_physical_device_inventory(&count, &error),
+                    ==, 0);
+    g_assert_null(error);
+    g_assert_cmpuint(count, ==, 1);
+    g_assert_cmpuint(registry_visits, ==, 1);
+    g_assert_cmpuint(registry_order[0], ==, 7);
+
+    registry_test_drop(test);
+    for (size_t index = G_N_ELEMENTS(nodes); index > 0; index--) {
+        object_unparent(nodes[index - 1]);
