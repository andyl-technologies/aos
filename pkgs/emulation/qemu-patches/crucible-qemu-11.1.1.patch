+static bool advance_receiver_disposition_syntax(
+    const struct qemu_plugin_crucible_advance_receiver_disposition_v1 *disposition)
+{
+    return disposition->schema_version == 1 &&
+        disposition->struct_size == sizeof(*disposition) &&
+        disposition->known_absent <= 1 &&
+        !disposition->command_return_attempted &&
+        !disposition->membership_return_attempted &&
+        !disposition->cleanup_return_attempted && !disposition->guard_return_attempted &&
+        !disposition->command_returned && !disposition->membership_returned &&
+        !disposition->cleanup_returned && !disposition->guard_returned &&
+        !disposition->reserved && disposition->first_status <= 0 &&
+        disposition->post_status <= 0;
