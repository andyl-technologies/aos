+
+static __int128 observed_ps;
+static unsigned nanosecond_reads;
+static unsigned interrupts;
+static unsigned kicks;
+static const char *program_path;
+
+/* Diagnostic clock and interrupt consumers, without a realized guest CPU. */
+int64_t cpu_get_clock(void)
+{
+    __int128 ns = observed_ps / PICOSECONDS_PER_NANOSECOND;
+
+    nanosecond_reads++;
+    g_assert_true(ns >= 0 && ns <= INT64_MAX);
+    return ns;
+}
+
+bool icount_crucible_sim_mode(void)
+{
+    return false;
+}
+
+void cpu_set_interrupt(CPUState *cpu, int mask)
+{
+    interrupts++;
+    cpu->interrupt_request |= mask;
+}
+
+void qemu_cpu_kick(CPUState *cpu)
+{
+    kicks++;
+}
+
+static __int128 observed_clock_ps(void)
+{
+    return observed_ps;
+}
+
+static void initialize_clock(bool exact)
+{
+    Error *error = NULL;
+    /* Only the CPU identity cast is needed by the actual timer callback. */
+    const TypeInfo diagnostic_cpu = {
+        .name = TYPE_CPU,
+        .parent = TYPE_OBJECT,
+        .instance_size = sizeof(CPUState),
+        .class_size = sizeof(CPUClass),
+    };
+
+    module_call_init(MODULE_INIT_QOM);
+    g_assert_null(object_class_by_name(TYPE_CPU));
+    type_register_static(&diagnostic_cpu);
+    qemu_init_main_loop(&error);
+    g_assert_null(error);
+    if (exact) {
+        qemu_timer_enable_tcg_ps_clock(NULL, observed_clock_ps);
+    }
+    qemu_clock_enable(QEMU_CLOCK_VIRTUAL, true);
+    nanosecond_reads = 0;
+}
+
+static void initialize_cpu(OpenRISCCPU *cpu)
+{
+    object_initialize(cpu, sizeof(*cpu), TYPE_CPU);
+    cpu->env.timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, openrisc_timer_cb, cpu);
+    cpu->env.is_counting = true;
+}
+
+static GByteArray *save_state(const VMStateDescription *description,
+                             void *state)
+{
+    QIOChannelBuffer *output = qio_channel_buffer_new(4096);
+    QEMUFile *file = qemu_file_new_output(QIO_CHANNEL(output));
+    GByteArray *bytes = g_byte_array_new();
+    Error *error = NULL;
+
+    g_assert_cmpint(vmstate_save_state(file, description, state, NULL,
+                                      &error), ==, 0);
+    g_assert_null(error);
+    qemu_put_byte(file, QEMU_VM_EOF);
+    g_assert_cmpint(qemu_fflush(file), ==, 0);
+    g_byte_array_append(bytes, output->data, output->usage);
+    g_assert_cmpint(qemu_fclose(file), ==, 0);
+    object_unref(OBJECT(output));
+    return bytes;
+}
+
+static int load_state(const VMStateDescription *description, void *state,
+                      GByteArray *bytes)
+{
+    QIOChannelBuffer *input = qio_channel_buffer_new(bytes->len);
+    QEMUFile *file;
+    int status;
+
+    memcpy(input->data, bytes->data, bytes->len);
+    input->usage = bytes->len;
+    file = qemu_file_new_input(QIO_CHANNEL(input));
+    status = vmstate_load_state(file, description, state,
+                                description->version_id, NULL);
+    qemu_fclose(file);
+    object_unref(OBJECT(input));
+    return status;
+}
+
+static void test_origin(gconstpointer data)
+{
+    unsigned kind = GPOINTER_TO_UINT(data);
+    OpenRISCCPU cpu = { 0 };
+    OR1KTimerState state = { 0 };
+    __int128 origin;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    initialize_clock(true);
+    origin = kind == 0 ? ((__int128)INT64_MAX + 1) * 1000 + 357 :
+             kind == 1 ? ((__int128)1 << 120) + 357 :
+             (__int128)(((__uint128_t)-1) >> 1) - 100000;
+    observed_ps = origin;
+    or1k_timer = &state;
+    cpu.env.is_counting = true;
+    cpu_openrisc_count_set(&cpu, 123);
+    g_assert_true(or1k_timer_clk_offset_ps() == origin);
+    observed_ps += TIMER_PERIOD_PS - 1;
+    cpu_openrisc_count_update(&cpu);
+    g_assert_cmpuint(cpu_openrisc_count_get(&cpu), ==, 124);
+    observed_ps++;
+    cpu_openrisc_count_update(&cpu);
+    g_assert_cmpuint(cpu_openrisc_count_get(&cpu), ==, 124);
+    observed_ps++;
+    cpu_openrisc_count_update(&cpu);
+    g_assert_cmpuint(cpu_openrisc_count_get(&cpu), ==, 125);
+    g_assert_cmpuint(nanosecond_reads, ==, 0);
+}
+
+static void test_wide_migration(void)
+{
+    OpenRISCCPU cpu = { 0 };
+    OpenRISCCPU restored = { 0 };
+    OR1KTimerState state = { 0 };
+    OR1KTimerState restored_state = { 0 };
+    GByteArray *global;
+    GByteArray *environment;
+    __int128 origin = ((__int128)1 << 120) + 357;
+    __int128 deadline;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    initialize_clock(true);
+    initialize_cpu(&cpu);
+    initialize_cpu(&restored);
+    or1k_timer = &state;
+    observed_ps = origin;
+    cpu_openrisc_count_set(&cpu, 0);
+    cpu.env.ttmr = TIMER_SHOT | TTMR_IE | 3;
+    cpu_openrisc_timer_update(&cpu);
+    deadline = timer_expire_time_ps_wide(cpu.env.timer);
+    g_assert_true(deadline == origin + 3 * TIMER_PERIOD_PS);
+    global = save_state(&vmstate_or1k_timer, &state);
+    environment = save_state(&vmstate_env, &cpu.env);
+    g_assert_cmpint(load_state(&vmstate_or1k_timer, &restored_state, global),
+                    ==, 0);
+    g_assert_cmpint(load_state(&vmstate_env, &restored.env, environment),
+                    ==, 0);
+    g_assert_true(timer_expire_time_ps_wide(restored.env.timer) == deadline);
+    timer_del(cpu.env.timer);
+    or1k_timer = &restored_state;
+    observed_ps = deadline - 1;
+    qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL);
+    g_assert_cmpuint(interrupts, ==, 0);
+    observed_ps++;
+    qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL);
+    g_assert_cmpuint(interrupts, ==, 1);
+    g_assert_cmpuint(kicks, ==, 1);
+    g_assert_false(timer_pending(restored.env.timer));
+    g_assert_cmpuint(restored.parent_obj.interrupt_request &
+                     CPU_INTERRUPT_TIMER,
+                     ==, CPU_INTERRUPT_TIMER);
+    g_assert_cmpuint(nanosecond_reads, ==, 0);
+    g_byte_array_unref(global);
+    g_byte_array_unref(environment);
+    timer_free(cpu.env.timer);
+    timer_free(restored.env.timer);
+    object_unref(OBJECT(&cpu));
+    object_unref(OBJECT(&restored));
+}
+
+static void test_negative_expiry(void)
+{
+    OpenRISCCPU cpu = { 0 };
+    OpenRISCCPU restored = { 0 };
+    GByteArray *environment;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    initialize_clock(true);
+    initialize_cpu(&cpu);
+    initialize_cpu(&restored);
+    /* An active wide deadline of -1 is distinct from an inactive timer. */
+    timer_mod_ps_wide(cpu.env.timer, -1);
+    g_assert_true(timer_pending(cpu.env.timer));
+    g_assert_true(timer_expire_time_ps_wide(cpu.env.timer) == -1);
+    environment = save_state(&vmstate_env, &cpu.env);
+    timer_mod_ps_wide(restored.env.timer, 42);
+    g_assert_cmpint(load_state(&vmstate_env, &restored.env, environment),
+                    ==, 0);
+    g_assert_true(timer_pending(restored.env.timer));
+    g_assert_true(timer_expire_time_ps_wide(restored.env.timer) == -1);
+    g_byte_array_unref(environment);
+    timer_free(cpu.env.timer);
+    timer_free(restored.env.timer);
+    object_unref(OBJECT(&cpu));
+    object_unref(OBJECT(&restored));
+}
+
+static size_t subsection_payload(const GByteArray *bytes, const char *name)
+{
+    size_t length = strlen(name);
+
+    for (size_t position = 2; position + length + 4 < bytes->len; position++) {
+        if (bytes->data[position - 2] == QEMU_VM_SUBSECTION &&
+            bytes->data[position - 1] == length &&
+            !memcmp(bytes->data + position, name, length)) {
+            return position + length + 4;
+        }
+    }
+    g_assert_not_reached();
+}
+
+static void remove_subsection(GByteArray *bytes, const char *name)
+{
+    size_t start = subsection_payload(bytes, name) - strlen(name) - 6;
+
+    g_byte_array_set_size(bytes, start);
+    g_byte_array_append(bytes, (const uint8_t[]) { QEMU_VM_EOF }, 1);
+}
+
+static void duplicate_subsection(GByteArray *bytes, const char *name)
+{
+    size_t start = subsection_payload(bytes, name) - strlen(name) - 6;
+    size_t length = bytes->len - start - 1;
+    uint8_t *copy = g_memdup2(bytes->data + start, length);
+
+    g_byte_array_set_size(bytes, bytes->len - 1);
+    g_byte_array_append(bytes, copy, length);
+    g_byte_array_append(bytes, (const uint8_t[]) { QEMU_VM_EOF }, 1);
+    g_free(copy);
+}
+
+static void test_malformed(gconstpointer data)
+{
+    unsigned kind = GPOINTER_TO_UINT(data);
+    bool environment = kind >= 4;
+    OpenRISCCPU cpu = { 0 };
+    OR1KTimerState state = { 0 };
+    const char *name = environment ? "env/timer-wide" :
+                                    "or1k_timer/clock-wide";
+    const VMStateDescription *description = environment ? &vmstate_env :
+                                                         &vmstate_or1k_timer;
+    void *target = environment ? (void *)&cpu.env : (void *)&state;
+    GByteArray *bytes;
+    size_t payload;
+    __int128 original_deadline;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    initialize_clock(true);
+    initialize_cpu(&cpu);
+    or1k_timer = &state;
+    observed_ps = ((__int128)1 << 120) + 357;
+    cpu_openrisc_count_set(&cpu, 0);
+    cpu.env.ttmr = TIMER_SHOT | TTMR_IE | 3;
+    cpu_openrisc_timer_update(&cpu);
+    bytes = save_state(description, target);
+    payload = subsection_payload(bytes, name);
+
+    switch (kind) {
+    case 0:
+    case 4:
+        remove_subsection(bytes, name);
+        break;
+    case 1:
+        bytes->data[payload + 16] = 2;
+        break;
+    case 2:
+        bytes->data[15] ^= 1;
+        break;
+    case 3:
+    case 8:
+        duplicate_subsection(bytes, name);
+        break;
+    case 5:
+        bytes->data[payload] = 2;
+        break;
+    case 6:
+        bytes->data[payload + 1] = 2;
+        break;
+    case 7:
+        bytes->data[payload + 1] = 0;
+        break;
+    case 9:
+        /* The parent ends with deadline64, TTMR32, PICMR32, PICSR32. */
+        bytes->data[payload - strlen(name) - 6 - 13] ^= 1;
+        break;
+    case 10:
+        g_byte_array_set_size(bytes, bytes->len - 3);
+        break;
+    default:
+        g_assert_not_reached();
+    }
+
+    timer_mod_ps_wide(cpu.env.timer, observed_ps + 123456);
+    original_deadline = timer_expire_time_ps_wide(cpu.env.timer);
+    g_assert_cmpint(load_state(description, target, bytes), <, 0);
+    g_assert_true(timer_pending(cpu.env.timer));
+    g_assert_true(timer_expire_time_ps_wide(cpu.env.timer) ==
+                  original_deadline);
+    g_assert_cmpuint(interrupts, ==, 0);
+    g_assert_cmpuint(kicks, ==, 0);
+    g_byte_array_unref(bytes);
+    timer_free(cpu.env.timer);
+    object_unref(OBJECT(&cpu));
+}
+
+static void test_ordinary(void)
+{
+    OpenRISCCPU cpu = { 0 };
+    OpenRISCCPU restored = { 0 };
+    OR1KTimerState state = { 0 };
+    OR1KTimerState restored_state = { 0 };
+    GByteArray *global;
+    GByteArray *environment;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    initialize_clock(false);
+    initialize_cpu(&cpu);
+    initialize_cpu(&restored);
+    observed_ps = 1000000;
+    or1k_timer = &state;
+    cpu_openrisc_count_set(&cpu, 0);
+    cpu.env.ttmr = TIMER_SHOT | TTMR_IE | 3;
+    cpu_openrisc_timer_update(&cpu);
+    g_assert_cmpint(timer_expire_time_ns(cpu.env.timer), ==, 1150);
+    global = save_state(&vmstate_or1k_timer, &state);
+    environment = save_state(&vmstate_env, &cpu.env);
+    g_assert_cmpuint(global->len, ==, 17);
+    g_assert_cmpint(load_state(&vmstate_or1k_timer, &restored_state, global),
+                    ==, 0);
+    g_assert_cmpint(load_state(&vmstate_env, &restored.env, environment),
+                    ==, 0);
+    g_assert_cmpint(timer_expire_time_ns(restored.env.timer), ==, 1150);
+    timer_del(cpu.env.timer);
+    or1k_timer = &restored_state;
+    observed_ps = 1149999;
+    qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL);
+    g_assert_cmpuint(interrupts, ==, 0);
+    observed_ps = 1150000;
+    qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL);
+    g_assert_cmpuint(interrupts, ==, 1);
+    g_assert_cmpuint(kicks, ==, 1);
+    g_assert_false(timer_pending(restored.env.timer));
+    g_assert_cmpuint(nanosecond_reads, >, 0);
+    g_byte_array_unref(global);
+    g_byte_array_unref(environment);
+    timer_free(cpu.env.timer);
+    timer_free(restored.env.timer);
+    object_unref(OBJECT(&cpu));
+    object_unref(OBJECT(&restored));
+}
+
+static void test_signed_origin(void)
+{
+    OpenRISCCPU cpu = { 0 };
+    OR1KTimerState state = { 0 };
+    OR1KTimerState restored_state = { 0 };
+    GByteArray *bytes;
+    __int128 minimum = -(__int128)(((__uint128_t)-1) >> 1) - 1;
+    __uint128_t ticks;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    initialize_clock(true);
+    or1k_timer = &state;
+    observed_ps = minimum + 357;
+    cpu.env.is_counting = true;
+    cpu_openrisc_count_set(&cpu, 0);
+    g_assert_true(or1k_timer_clk_offset_ps() == observed_ps);
+    bytes = save_state(&vmstate_or1k_timer, &state);
+    g_assert_cmpint(load_state(&vmstate_or1k_timer, &restored_state, bytes),
+                    ==, 0);
+    or1k_timer = &restored_state;
+    g_assert_true(or1k_timer_clk_offset_ps() == observed_ps);
+    observed_ps = (__int128)(((__uint128_t)-1) >> 1);
+    cpu_openrisc_count_update(&cpu);
+    ticks = ((__uint128_t)-1 - 357) / TIMER_PERIOD_PS +
+            (((__uint128_t)-1 - 357) % TIMER_PERIOD_PS != 0);
+    g_assert_cmpuint(cpu_openrisc_count_get(&cpu), ==, (uint32_t)ticks);
+    g_byte_array_unref(bytes);
+}
+
+static int import_ordinary(const char *global_path,
+                           const char *environment_path,
+                           bool wide, bool inactive)
+{
+    OpenRISCCPU cpu = { 0 };
+    OR1KTimerState state = { 0 };
+    GByteArray *global = g_byte_array_new();
+    GByteArray *environment = g_byte_array_new();
+    char *contents;
+    size_t length;
+
+    initialize_clock(false);
+    initialize_cpu(&cpu);
+    or1k_timer = &state;
+    g_assert_true(g_file_get_contents(global_path, &contents, &length, NULL));
+    g_byte_array_append(global, (uint8_t *)contents, length);
+    g_free(contents);
+    g_assert_true(g_file_get_contents(environment_path, &contents, &length,
+                                     NULL));
+    g_byte_array_append(environment, (uint8_t *)contents, length);
+    g_free(contents);
+    timer_mod_ns(cpu.env.timer, 42);
+
+    if (wide) {
+        g_assert_cmpint(load_state(&vmstate_or1k_timer, &state, global), <, 0);
+        g_assert_cmpint(load_state(&vmstate_env, &cpu.env, environment), <, 0);
+        g_assert_cmpint(timer_expire_time_ns(cpu.env.timer), ==, 42);
+    } else {
+        g_assert_cmpint(load_state(&vmstate_or1k_timer, &state, global), ==, 0);
+        g_assert_cmpint(state.clk_offset, ==, 1000001);
+        g_assert_cmpint(load_state(&vmstate_env, &cpu.env, environment), ==, 0);
+        if (inactive) {
+            g_assert_false(timer_pending(cpu.env.timer));
+        } else {
+            g_assert_cmpint(timer_expire_time_ns(cpu.env.timer), ==, 1000151);
+        }
+    }
+    g_byte_array_unref(global);
+    g_byte_array_unref(environment);
+    timer_free(cpu.env.timer);
+    object_unref(OBJECT(&cpu));
+    return 0;
+}
+
+static void test_cross_mode(gconstpointer data)
+{
+    unsigned kind = GPOINTER_TO_UINT(data);
+    OpenRISCCPU cpu = { 0 };
+    OR1KTimerState state = { 0 };
+    GByteArray *global;
+    GByteArray *environment;
+    g_autofree char *directory = NULL;
+    g_autofree char *global_path = NULL;
+    g_autofree char *environment_path = NULL;
+    g_autofree char *output = NULL;
+    g_autofree char *errors = NULL;
+    int status;
+    gboolean spawned;
+    char *arguments[7];
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    initialize_clock(true);
+    initialize_cpu(&cpu);
+    or1k_timer = &state;
+    observed_ps = kind == 1 ? ((__int128)1 << 120) + 357 : 1000000357;
+    cpu_openrisc_count_set(&cpu, 0);
+    cpu.env.ttmr = TIMER_SHOT | TTMR_IE | 3;
+    cpu_openrisc_timer_update(&cpu);
+    if (kind == 2) {
+        timer_del(cpu.env.timer);
+    }
+    global = save_state(&vmstate_or1k_timer, &state);
+    environment = save_state(&vmstate_env, &cpu.env);
+    directory = g_dir_make_tmp("openrisc-clock-XXXXXX", NULL);
+    g_assert_nonnull(directory);
+    global_path = g_build_filename(directory, "global", NULL);
+    environment_path = g_build_filename(directory, "environment", NULL);
+    g_assert_true(g_file_set_contents(global_path, (char *)global->data,
+                                     global->len, NULL));
+    g_assert_true(g_file_set_contents(environment_path,
+                                     (char *)environment->data,
+                                     environment->len, NULL));
+    arguments[0] = (char *)program_path;
+    arguments[1] = (char *)"--import-ordinary";
+    arguments[2] = global_path;
+    arguments[3] = environment_path;
+    arguments[4] = (char *)(kind == 1 ? "wide" : "representable");
+    arguments[5] = (char *)(kind == 2 ? "inactive" : "active");
+    arguments[6] = NULL;
+    /* This child only execs the importer. Reconstructing an inherited RCU
+     * worker in its atfork handler can wait on copied process-private locks
+     * before exec, leaving spawn waiting for the exec-error pipe to close.
+     * The new executable initializes its own RCU state. */
+    rcu_disable_atfork();
+    spawned = g_spawn_sync(NULL, arguments, NULL, 0, NULL, NULL,
+                           &output, &errors, &status, NULL);
+    rcu_enable_atfork();
+    g_assert_true(spawned);
+    if (status) {
+        g_test_message("ordinary import: %s", errors);
+    }
+    g_assert_true(WIFEXITED(status));
+    g_assert_cmpint(WEXITSTATUS(status), ==, 0);
+    g_assert_cmpint(unlink(global_path), ==, 0);
+    g_assert_cmpint(unlink(environment_path), ==, 0);
+    g_assert_cmpint(rmdir(directory), ==, 0);
+    g_byte_array_unref(global);
+    g_byte_array_unref(environment);
+    timer_free(cpu.env.timer);
+    object_unref(OBJECT(&cpu));
+}
+
+static void test_deadline_overflow(void)
+{
+    OpenRISCCPU cpu = { 0 };
+    OR1KTimerState state = { 0 };
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_failed();
+        g_test_trap_assert_stderr("*deadline exceeds virtual clock range*");
+        return;
+    }
+
+    initialize_clock(true);
+    initialize_cpu(&cpu);
+    observed_ps = (__int128)(((__uint128_t)-1) >> 1) - 10;
+    or1k_timer = &state;
+    cpu_openrisc_count_set(&cpu, 0);
+    cpu.env.ttmr = TIMER_SHOT | 1;
+    cpu_openrisc_timer_update(&cpu);
+}
+
+int main(int argc, char **argv)
+{
+    const char *malformed_names[] = {
+        "global-missing", "global-mode", "global-projection",
+        "global-duplicate",
+        "environment-missing", "environment-mode", "environment-active",
+        "environment-inactive-payload", "environment-duplicate",
+        "environment-projection", "environment-truncated",
+    };
+
+    program_path = argv[0];
+    if (argc == 6 && !strcmp(argv[1], "--import-ordinary")) {
+        return import_ordinary(argv[2], argv[3], !strcmp(argv[4], "wide"),
+                               !strcmp(argv[5], "inactive"));
+    }
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_data_func("/openrisc/origin/ns-horizon", GUINT_TO_POINTER(0),
+                         test_origin);
+    g_test_add_data_func("/openrisc/origin/wide", GUINT_TO_POINTER(1),
+                         test_origin);
+    g_test_add_data_func("/openrisc/origin/full-horizon", GUINT_TO_POINTER(2),
+                         test_origin);
+    g_test_add_func("/openrisc/wide-migration", test_wide_migration);
+    g_test_add_func("/openrisc/ordinary", test_ordinary);
+    g_test_add_func("/openrisc/negative-expiry", test_negative_expiry);
+    g_test_add_func("/openrisc/signed-origin", test_signed_origin);
+
+    g_test_add_func("/openrisc/deadline-overflow", test_deadline_overflow);
+    g_test_add_data_func("/openrisc/cross-mode/representable",
+                         GUINT_TO_POINTER(0),
+                         test_cross_mode);
+    g_test_add_data_func("/openrisc/cross-mode/wide-refused",
+                         GUINT_TO_POINTER(1),
+                         test_cross_mode);
+    g_test_add_data_func("/openrisc/cross-mode/inactive", GUINT_TO_POINTER(2),
+                         test_cross_mode);
+    for (unsigned kind = 0; kind < G_N_ELEMENTS(malformed_names); kind++) {
+        g_autofree char *name = g_strdup_printf("/openrisc/malformed/%s",
+                                               malformed_names[kind]);
+
+        g_test_add_data_func(name, GUINT_TO_POINTER(kind), test_malformed);
+    }
+    return g_test_run();
+}
diff --git a/tests/unit/test-crucible-parallel-fingerprint.c b/tests/unit/test-crucible-parallel-fingerprint.c
new file mode 100644
index 0000000000000000000000000000000000000000..1ba2a64a8846c9d33c82b340038f0e8fad8970d5
--- /dev/null
+++ b/tests/unit/test-crucible-parallel-fingerprint.c
@@ -0,0 +1,90 @@
+/*
+ * ISA parallel port fingerprint projection tests
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "qemu/osdep.h"
+
+#include "hw/char/parallel-isa-fingerprint.h"
+#include "io/channel-file.h"
+#include "qemu/module.h"
+
+static GBytes *project_parallel(const ISAParallelState *parallel)
+{
+    char *path = NULL;
+    int read_fd;
+    int write_fd = g_file_open_tmp("qemu-parallel-fingerprint-XXXXXX", &path,
+                                   NULL);
+    QIOChannelFile *channel;
+    QEMUFile *file;
+    struct stat stat_buffer;
+
+    g_assert_cmpint(write_fd, >=, 0);
+    read_fd = dup(write_fd);
+    g_assert_cmpint(read_fd, >=, 0);
+    unlink(path);
+    g_free(path);
+    channel = qio_channel_file_new_fd(write_fd);
+    file = qemu_file_new_output(QIO_CHANNEL(channel));
+
+    g_assert_true(parallel_isa_state_fingerprint_projection(file, parallel));
+    g_assert_cmpint(qemu_fflush(file), ==, 0);
+    g_assert_cmpint(qemu_fclose(file), ==, 0);
+
+    g_assert_cmpint(fstat(read_fd, &stat_buffer), ==, 0);
+    g_autofree uint8_t *data = g_malloc(stat_buffer.st_size);
+    g_assert_cmpint(pread(read_fd, data, stat_buffer.st_size, 0), ==,
+                    stat_buffer.st_size);
+    GBytes *bytes = g_bytes_new(data, stat_buffer.st_size);
+    object_unref(OBJECT(channel));
+    close(read_fd);
+    return bytes;
+}
+
+static void assert_parallel_state_distinct(ISAParallelState *candidate,
+                                           const GBytes *baseline)
+{
+    g_autoptr(GBytes) candidate_bytes = project_parallel(candidate);
+
+    g_assert_false(g_bytes_equal(baseline, candidate_bytes));
+}
+
+static void test_parallel_mutable_state(void)
+{
+    ISAParallelState baseline_state = { 0 };
+    ISAParallelState candidate = { 0 };
+    g_autoptr(GBytes) baseline = project_parallel(&baseline_state);
+
+    candidate.state.dataw = 1;
+    assert_parallel_state_distinct(&candidate, baseline);
+
+    candidate = baseline_state;
+    candidate.state.datar = 1;
+    assert_parallel_state_distinct(&candidate, baseline);
+
+    candidate = baseline_state;
+    candidate.state.status = 1;
+    assert_parallel_state_distinct(&candidate, baseline);
+
+    candidate = baseline_state;
+    candidate.state.control = 1;
+    assert_parallel_state_distinct(&candidate, baseline);
+
+    candidate = baseline_state;
+    candidate.state.irq_pending = 1;
+    assert_parallel_state_distinct(&candidate, baseline);
+
+    candidate = baseline_state;
+    candidate.state.epp_timeout = 1;
+    assert_parallel_state_distinct(&candidate, baseline);
+}
+
+int main(int argc, char **argv)
+{
+    module_call_init(MODULE_INIT_QOM);
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/crucible/parallel/mutable-state",
+                    test_parallel_mutable_state);
+    return g_test_run();
+}
