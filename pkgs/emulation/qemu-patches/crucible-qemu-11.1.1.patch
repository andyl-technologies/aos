+int qemu_crucible_observation_root_execution_borrow_v1(
+    uint64_t id, QemuCrucibleObservationRootExecutionWitness **out)
+{
+    QemuCrucibleFingerprintRootFrame *frame = NULL;
+    int status;
+
+    if (!out || *out || !bql_locked() || !current_cpu) {
+        return -EINVAL;
+    }
+    /* No native gate mutex or cut is held through the factual Root callee.
+     * The actual Root caller holds BQL and the exact entered frame here. */
+    status = qemu_crucible_ram_fingerprint_root_execution_identity_v1(id, &frame);
+    if (status || !frame) {
+        return status ? status : -ESTALE;
+    }
+    if (qatomic_cmpxchg(&observation_writer_cut, 0, 1)) {
+        return -EBUSY;
+    }
+    if (root_execution_witness.held) {
+        status = -EBUSY;
+    } else {
+        root_execution_witness = (QemuCrucibleObservationRootExecutionWitness) {
+            .frame = frame,
