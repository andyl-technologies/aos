+def run_vmstop_at_ceiling_test(qemu, plugin, bios, dispatch_ceiling):
+    live = LiveQemu(
+        qemu,
+        plugin,
+        bios,
+        dispatch_ceiling=dispatch_ceiling,
+        vmstop_at_observer=dispatch_ceiling,
+    )
+    try:
+        events = [live.marker(), live.marker(), live.marker()]
+        expected = [
+            ("work", 0),
+            ("vmstop", 0),
+            ("dispatch", dispatch_ceiling),
+        ]
+        if events != expected:
+            raise AssertionError(
+                f"unexpected VM-stop-at-ceiling events: {events!r}"
+            )
+
+        status = live.qmp("query-status")
+        if status != {"status": "paused", "running": False}:
+            raise AssertionError(
+                f"boundary observer did not pause QEMU: {status!r}"
+            )
+
+        live.control_state[0:4] = (1).to_bytes(
+            4, byteorder=sys.byteorder
+        )
+        live.control_state.flush()
+        os.eventfd_write(live.wake_fd, 1)
+        event = live.marker()
+        expected_control = ("control", (dispatch_ceiling, 1))
+        if event != expected_control:
+            raise AssertionError(
+                "paused VM did not acknowledge its control boundary: "
+                f"{event!r}"
+            )
+        live.assert_no_marker_pending()
+    finally:
+        live.close()
+    return tuple(events)
