+/*
+ * Literal MIPS GIC timer migration with a controlled virtual-clock producer.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/main-loop.h"
+#include "system/cpu-timers.h"
+#include "exec/icount.h"
+#include "io/channel-buffer.h"
+#include "../../migration/qemu-file.h"
+#include "../../migration/savevm.h"
+
+/* Retain the complete device and VMState without realizing a board. */
+#undef type_init
+#define type_init(function) \
+    static void (*const fixture_##function)(void) G_GNUC_UNUSED = function;
+#include "../../hw/timer/mips_gictimer.c"
+
+static __int128 observed_ps;
+static unsigned nanosecond_reads;
+
+/* Diagnostic CPU-clock adapter, not an installed TCG/controller provider. */
+int64_t cpu_get_clock(void)
+{
+    __int128 nanoseconds = observed_ps / PICOSECONDS_PER_NANOSECOND;
+
+    nanosecond_reads++;
+    if (nanoseconds < 0 || nanoseconds > INT64_MAX) {
+        g_error("Diagnostic nanosecond projection exceeds the API range");
+    }
+    return nanoseconds;
+}
+
+bool icount_crucible_sim_mode(void)
+{
+    return false;
+}
+
+static __int128 observed_clock_ps(void)
+{
+    return observed_ps;
+}
+
+static void initialize_clock(bool exact)
+{
+    Error *error = NULL;
+
+    module_call_init(MODULE_INIT_QOM);
+    qemu_init_main_loop(&error);
+    g_assert_null(error);
+    if (exact) {
+        qemu_timer_enable_tcg_ps_clock(NULL, observed_clock_ps);
+    }
+    qemu_clock_enable(QEMU_CLOCK_VIRTUAL, true);
+    nanosecond_reads = 0;
+}
+
+static void observe_expiry(void *opaque, uint32_t vp_index)
+{
+    unsigned *count = opaque;
+
+    (*count)++;
+}
+
+static MIPSGICTimerState *create_timer(unsigned *callbacks, int vps)
+{
+    MIPSGICTimerState *timer = mips_gictimer_init(callbacks, vps,
+                                                observe_expiry);
+
+    timer->sh_counterlo = 0;
+    for (int i = 0; i < vps; i++) {
+        timer->vptimers[i].comparelo = 0;
+    }
+    return timer;
+}
+
+static void destroy_timer(MIPSGICTimerState *timer)
+{
+    for (int i = 0; i < timer->num_vps; i++) {
+        timer_free(timer->vptimers[i].qtimer);
+    }
+    g_free(timer->vptimers);
+    g_free(timer);
+}
+
+static GByteArray *save_state(MIPSGICTimerState *timer,
+                             const VMStateDescription *description)
+{
+    QIOChannelBuffer *output = qio_channel_buffer_new(128);
+    QEMUFile *file = qemu_file_new_output(QIO_CHANNEL(output));
+    GByteArray *bytes = g_byte_array_new();
+    Error *error = NULL;
+
+    g_assert_cmpint(vmstate_save_state(file, description, timer, NULL,
+                                      &error), ==, 0);
+    g_assert_null(error);
+    /* A following outer marker bounds subsection peeks without channel EOF. */
+    qemu_put_byte(file, QEMU_VM_EOF);
+    g_assert_cmpint(qemu_fflush(file), ==, 0);
+    g_byte_array_append(bytes, output->data, output->usage);
+    g_assert_cmpint(qemu_fclose(file), ==, 0);
+    object_unref(OBJECT(output));
+    return bytes;
+}
+
+static int load_state(MIPSGICTimerState *timer, GByteArray *bytes)
+{
+    QIOChannelBuffer *input = qio_channel_buffer_new(bytes->len);
+    QEMUFile *file;
+    Error *error = NULL;
+    int result;
+
+    input->usage = bytes->len;
+    memcpy(input->data, bytes->data, bytes->len);
+    file = qemu_file_new_input(QIO_CHANNEL(input));
+    result = vmstate_load_state(file, &vmstate_mips_gictimer, timer, 1,
+                                &error);
+    if (result < 0) {
+        g_assert_nonnull(error);
+        g_test_message("Load refusal: %s", error_get_pretty(error));
+        error_free(error);
+    } else {
+        g_assert_null(error);
+    }
+    qemu_fclose(file);
+    object_unref(OBJECT(input));
+    return result;
+}
+
+static void assert_deadline(MIPSGICTimerState *timer, int vp,
+                            __int128 deadline)
+{
+    g_assert_true(timer_pending(timer->vptimers[vp].qtimer));
+    g_assert_true(timer_expire_time_ps_wide(timer->vptimers[vp].qtimer) ==
+                  deadline);
+}
+
+static void test_wide_save(void)
+{
+    MIPSGICTimerState *timer;
+    MIPSGICTimerState *restored;
+    GByteArray *bytes;
+    unsigned callbacks = 0;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    initialize_clock(true);
+    observed_ps = ((__int128)INT64_MAX + 1) *
+                  PICOSECONDS_PER_NANOSECOND + 999;
+    timer = create_timer(&callbacks, 3);
+    restored = create_timer(&callbacks, 3);
+    mips_gictimer_store_sh_count(timer, 100);
+    mips_gictimer_start_count(timer);
+    mips_gictimer_store_vp_compare(timer, 0, 103);
+    mips_gictimer_store_vp_compare(timer, 1, 100 + UINT32_MAX);
+    timer_del(timer->vptimers[2].qtimer);
+    assert_deadline(timer, 0, observed_ps + 3 * TIMER_PERIOD_PS);
+    assert_deadline(timer, 1, observed_ps +
+                              (__int128)UINT32_MAX * TIMER_PERIOD_PS);
+
+    bytes = save_state(timer, &vmstate_mips_gictimer);
+    g_assert_cmpint(load_state(restored, bytes), ==, 0);
+    assert_deadline(restored, 0, observed_ps + 3 * TIMER_PERIOD_PS);
+    assert_deadline(restored, 1, observed_ps +
+                                 (__int128)UINT32_MAX * TIMER_PERIOD_PS);
+    g_assert_false(timer_pending(restored->vptimers[2].qtimer));
+    g_assert_cmpuint(mips_gictimer_get_sh_count(restored), ==, 100);
+    g_assert_cmpuint(mips_gictimer_get_freq(restored), ==, 100000000);
+    g_assert_cmpuint(nanosecond_reads, ==, 0);
+    g_assert_cmpuint(callbacks, ==, 0);
+    g_byte_array_unref(bytes);
+    destroy_timer(timer);
+    destroy_timer(restored);
+}
+
+static void test_signed_deadlines(void)
+{
+    const __int128 maximum = (((__int128)1 << 126) - 1) * 2 + 1;
+    const __int128 deadlines[] = {
+        -maximum - 1, -((__int128)INT64_MAX + 2) * 1000,
+        -1000, -357, -1, 0, 357, (__int128)INT64_MAX * 1000 + 999,
+        ((__int128)INT64_MAX + 1) * 1000 + 999, maximum,
+    };
+    MIPSGICTimerState *timer;
+    MIPSGICTimerState *restored;
+    unsigned callbacks = 0;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    initialize_clock(true);
+    timer = create_timer(&callbacks, 1);
+    restored = create_timer(&callbacks, 1);
+    for (size_t i = 0; i < G_N_ELEMENTS(deadlines); i++) {
+        GByteArray *bytes;
+
+        timer_mod_ps_wide(timer->vptimers[0].qtimer, deadlines[i]);
+        bytes = save_state(timer, &vmstate_mips_gictimer);
+        g_assert_cmpint(load_state(restored, bytes), ==, 0);
+        assert_deadline(restored, 0, deadlines[i]);
+        g_byte_array_unref(bytes);
+    }
+    g_assert_cmpuint(callbacks, ==, 0);
+    destroy_timer(timer);
+    destroy_timer(restored);
+}
+
+/* QEMUFile's base fields precede the named subsection header/version. */
+static size_t wide_payload_offset(GByteArray *bytes, int vps)
+{
+    const char name[] = "mips-gic-timer/ps-wide";
+    size_t base = 1 + 4 + 4 + vps * (4 + 8);
+
+    g_assert_cmpuint(bytes->data[base], ==, QEMU_VM_SUBSECTION);
+    g_assert_cmpuint(bytes->data[base + 1], ==, strlen(name));
+    g_assert_cmpmem(bytes->data + base + 2, strlen(name), name, strlen(name));
+    g_assert_cmpuint(ldl_be_p(bytes->data + base + 2 + strlen(name)), ==, 1);
+    return base + 2 + strlen(name) + 4;
+}
+
+static void assert_rejected_without_timer_effects(GByteArray *bytes, int vps)
+{
+    unsigned callbacks = 0;
+    MIPSGICTimerState *restored = create_timer(&callbacks, vps);
+
+    for (int i = 0; i < vps; i++) {
+        timer_mod_ps_wide(restored->vptimers[i].qtimer, 500001 + i);
+    }
+    g_assert_cmpint(load_state(restored, bytes), <, 0);
+    for (int i = 0; i < vps; i++) {
+        assert_deadline(restored, i, 500001 + i);
+    }
+    g_assert_cmpuint(callbacks, ==, 0);
+    destroy_timer(restored);
+}
+
+typedef enum Corruption {
+    INVALID_ACTIVE,
+    INACTIVE_PAYLOAD,
+    MISMATCHED_PROJECTION,
+    TRUNCATED_WIDE,
+    VP_COUNT,
+    COUNTSTOP,
+} Corruption;
+
+static void test_malformed(gconstpointer opaque)
+{
+    Corruption corruption = GPOINTER_TO_INT(opaque);
+    MIPSGICTimerState *timer;
+    GByteArray *bytes;
+    unsigned callbacks = 0;
+    size_t payload;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    initialize_clock(true);
+    timer = create_timer(&callbacks, 2);
+    timer_mod_ps_wide(timer->vptimers[0].qtimer, 12345);
+    timer_mod_ps_wide(timer->vptimers[1].qtimer, 54321);
+    bytes = save_state(timer, &vmstate_mips_gictimer);
+    payload = wide_payload_offset(bytes, 2);
+    /* Corrupt VP1 so validating/effecting each VP in one loop would fail. */
+    switch (corruption) {
+    case INVALID_ACTIVE:
+        bytes->data[payload + 17] = 2;
+        break;
+    case INACTIVE_PAYLOAD:
+        bytes->data[payload + 17] = 0;
+        break;
+    case MISMATCHED_PROJECTION:
+        stq_be_p(bytes->data + 9 + 12 + 4, 56);
+        break;
+    case TRUNCATED_WIDE:
+        g_byte_array_set_size(bytes, bytes->len - 2);
+        break;
+    case VP_COUNT:
+        stl_be_p(bytes->data + 5, 1);
+        break;
+    case COUNTSTOP:
+        bytes->data[0] = 2;
+        break;
+    }
+    assert_rejected_without_timer_effects(bytes, 2);
+    g_byte_array_unref(bytes);
+    destroy_timer(timer);
+}
+
+static void test_missing_wide(void)
+{
+    MIPSGICTimerState *timer;
+    GByteArray *bytes;
+    unsigned callbacks = 0;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    initialize_clock(true);
+    timer = create_timer(&callbacks, 2);
+    timer_mod_ps_wide(timer->vptimers[0].qtimer, 12345);
+    bytes = save_state(timer, &vmstate_mips_gictimer);
+    g_byte_array_set_size(bytes, 34);
+    bytes->data[33] = QEMU_VM_EOF;
+    g_assert_cmpuint(bytes->len, ==, 34);
+    assert_rejected_without_timer_effects(bytes, 2);
+    g_byte_array_unref(bytes);
+    destroy_timer(timer);
+}
+
+static void test_obsolete_phase(void)
+{
+    MIPSGICTimerState *timer;
+    GByteArray *bytes;
+    GByteArray *obsolete;
+    unsigned callbacks = 0;
+    const char name[] = "mips-gic-timer/ps-phase";
+    uint8_t header[] = { QEMU_VM_SUBSECTION, sizeof(name) - 1 };
+    const uint8_t version[] = { 0, 0, 0, 1 };
+    const uint8_t phases[] = { 0, 0, 0, 0 };
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    initialize_clock(true);
+    timer = create_timer(&callbacks, 2);
+    bytes = save_state(timer, &vmstate_mips_gictimer);
+    obsolete = g_byte_array_new();
+    g_byte_array_append(obsolete, bytes->data, 33);
+    g_byte_array_append(obsolete, header, sizeof(header));
+    g_byte_array_append(obsolete, (const uint8_t *)name, strlen(name));
+    g_byte_array_append(obsolete, version, sizeof(version));
+    g_byte_array_append(obsolete, phases, sizeof(phases));
+    g_byte_array_append(obsolete, bytes->data + bytes->len - 1, 1);
+    assert_rejected_without_timer_effects(obsolete, 2);
+    g_byte_array_unref(obsolete);
+    g_byte_array_unref(bytes);
+    destroy_timer(timer);
+}
+
+static void test_ordinary(void)
+{
+    MIPSGICTimerState *timer;
+    MIPSGICTimerState *restored;
+    GByteArray *bytes;
+    unsigned callbacks = 0;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    initialize_clock(false);
+    observed_ps = 123000;
+    timer = create_timer(&callbacks, 2);
+    restored = create_timer(&callbacks, 2);
+    mips_gictimer_store_sh_count(timer, 100);
+    mips_gictimer_start_count(timer);
+    mips_gictimer_store_vp_compare(timer, 0, 103);
+    timer_del(timer->vptimers[1].qtimer);
+    bytes = save_state(timer, &vmstate_mips_gictimer);
+    g_assert_cmpuint(bytes->len, ==, 34);
+    g_assert_cmpuint(ldq_be_p(bytes->data + 13), ==, 153);
+    g_assert_cmpint((int64_t)ldq_be_p(bytes->data + 25), ==, -1);
+    g_assert_cmpint(load_state(restored, bytes), ==, 0);
+    g_assert_cmpuint(timer_expire_time_ns(restored->vptimers[0].qtimer),
+                     ==, 153);
+    g_assert_false(timer_pending(restored->vptimers[1].qtimer));
+    g_assert_cmpuint(mips_gictimer_get_sh_count(restored), ==, 100);
+    g_assert_cmpuint(mips_gictimer_get_freq(restored), ==, 100000000);
+    g_assert_cmpuint(callbacks, ==, 0);
+    g_byte_array_unref(bytes);
+    destroy_timer(timer);
+    destroy_timer(restored);
+}
+
+static void test_duplicate_wide(void)
+{
+    MIPSGICTimerState *timer;
+    GByteArray *bytes;
+    GByteArray *duplicate;
+    unsigned callbacks = 0;
+    const uint8_t end = QEMU_VM_EOF;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    initialize_clock(true);
+    timer = create_timer(&callbacks, 2);
+    bytes = save_state(timer, &vmstate_mips_gictimer);
+    duplicate = g_byte_array_new();
+    g_byte_array_append(duplicate, bytes->data, bytes->len - 1);
+    g_byte_array_append(duplicate, bytes->data + 33, bytes->len - 34);
+    g_byte_array_append(duplicate, &end, 1);
+    assert_rejected_without_timer_effects(duplicate, 2);
+    g_byte_array_unref(duplicate);
+    g_byte_array_unref(bytes);
+    destroy_timer(timer);
+}
+
+static void test_clock_mode_mismatch(void)
+{
+    const char name[] = "mips-gic-timer/ps-wide";
+    uint8_t header[] = { QEMU_VM_SUBSECTION, sizeof(name) - 1 };
+    const uint8_t version[] = { 0, 0, 0, 1 };
+    uint8_t exact_state[17] = { 1 };
+    MIPSGICTimerState *timer;
+    GByteArray *bytes;
+    unsigned callbacks = 0;
+    const uint8_t end = QEMU_VM_EOF;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    initialize_clock(false);
+    timer = create_timer(&callbacks, 1);
+    timer_mod_ns(timer->vptimers[0].qtimer, 500);
+    bytes = save_state(timer, &vmstate_mips_gictimer);
+    g_byte_array_set_size(bytes, bytes->len - 1);
+    g_byte_array_append(bytes, header, sizeof(header));
+    g_byte_array_append(bytes, (const uint8_t *)name, strlen(name));
+    g_byte_array_append(bytes, version, sizeof(version));
+    stq_be_p(exact_state + 9, 500000);
+    g_byte_array_append(bytes, exact_state, sizeof(exact_state));
+    g_byte_array_append(bytes, &end, 1);
+
+    g_assert_cmpint(load_state(timer, bytes), <, 0);
+    g_assert_cmpuint(timer_expire_time_ns(timer->vptimers[0].qtimer), ==, 500);
+    g_assert_cmpuint(callbacks, ==, 0);
+    g_byte_array_unref(bytes);
+    destroy_timer(timer);
+}
+
+static void test_counter_and_callback(void)
+{
+    MIPSGICTimerState *timer;
+    unsigned callbacks = 0;
+    const __int128 start = ((__int128)INT64_MAX + 1) * 1000 + 999;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    initialize_clock(true);
+    observed_ps = start;
+    timer = create_timer(&callbacks, 1);
+    mips_gictimer_store_sh_count(timer, UINT32_MAX);
+    mips_gictimer_start_count(timer);
+    mips_gictimer_store_vp_compare(timer, 0, 1);
+    assert_deadline(timer, 0, start + 2 * TIMER_PERIOD_PS);
+    observed_ps = start + 2 * TIMER_PERIOD_PS - 1;
+    g_assert_cmpuint(mips_gictimer_get_sh_count(timer), ==, 1);
+    g_assert_cmpuint(callbacks, ==, 0);
+    observed_ps++;
+    g_assert_cmpuint(mips_gictimer_get_sh_count(timer), ==, 1);
+    g_assert_cmpuint(callbacks, ==, 1);
+    assert_deadline(timer, 0, observed_ps);
+    mips_gictimer_stop_count(timer);
+    g_assert_false(timer_pending(timer->vptimers[0].qtimer));
+    g_assert_cmpuint(mips_gictimer_get_sh_count(timer), ==, 1);
+    g_assert_cmpuint(nanosecond_reads, ==, 0);
+    destroy_timer(timer);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/mips-gic/migration/wide-save", test_wide_save);
+    g_test_add_func("/mips-gic/migration/signed-deadlines",
+                     test_signed_deadlines);
+    g_test_add_data_func("/mips-gic/migration/invalid-active",
+                          GINT_TO_POINTER(INVALID_ACTIVE), test_malformed);
+    g_test_add_data_func("/mips-gic/migration/inactive-payload",
+                          GINT_TO_POINTER(INACTIVE_PAYLOAD), test_malformed);
+    g_test_add_data_func("/mips-gic/migration/projection-mismatch",
+                          GINT_TO_POINTER(MISMATCHED_PROJECTION),
+                          test_malformed);
+    g_test_add_data_func("/mips-gic/migration/truncated",
+                          GINT_TO_POINTER(TRUNCATED_WIDE), test_malformed);
+    g_test_add_data_func("/mips-gic/migration/vp-count",
+                          GINT_TO_POINTER(VP_COUNT), test_malformed);
+    g_test_add_data_func("/mips-gic/migration/countstop",
+                          GINT_TO_POINTER(COUNTSTOP), test_malformed);
+    g_test_add_func("/mips-gic/migration/duplicate-wide", test_duplicate_wide);
+    g_test_add_func("/mips-gic/migration/missing-wide", test_missing_wide);
+    g_test_add_func("/mips-gic/migration/obsolete-phase", test_obsolete_phase);
+    g_test_add_func("/mips-gic/migration/ordinary", test_ordinary);
+    g_test_add_func("/mips-gic/migration/clock-mode-mismatch",
+                     test_clock_mode_mismatch);
+    g_test_add_func("/mips-gic/clock/counter-and-callback",
+                     test_counter_and_callback);
+    return g_test_run();
+}
diff --git a/tests/unit/test-crucible-monitor-fd-loans.c b/tests/unit/test-crucible-monitor-fd-loans.c
new file mode 100644
index 0000000000000000000000000000000000000000..73dac71f8a8bb835fc30e3f066d45aa7f7dcb629
--- /dev/null
+++ b/tests/unit/test-crucible-monitor-fd-loans.c
@@ -0,0 +1,516 @@
+/*
+ * Literal ordinary Monitor FD bodies with real QOM and descriptor utilities
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/cutils.h"
+#include "qemu/lockable.h"
+#include "qemu/module.h"
+#include "qom/object.h"
+#include "monitor/monitor-internal.h"
+#include "qapi/error.h"
+#include "qapi/qapi-commands-misc.h"
+#include "qapi/qmp/qerror.h"
+#include "qemu/ctype.h"
+#include <sys/eventfd.h>
+
+/* The provider is ancillary storage, not a real connected CharFrontend. */
+static Monitor *fixture_mon;
+static int supplied_fd = -1;
+static unsigned consume_calls;
+static unsigned close_calls;
+static unsigned finalizations;
+static bool drop_owner_on_consume;
+static bool inject_post_close_eintr;
+static bool owner_dropped;
+
+static Monitor *fixture_current_monitor(void)
+{
+    return fixture_mon;
+}
+
+int qemu_chr_fe_get_msgfd(CharFrontend *frontend)
+{
+    int fd = supplied_fd;
+
+    g_assert_true(frontend == &fixture_mon->chr);
+    g_assert_cmpuint(fixture_mon->fd_admission.ordinary_operations, ==, 1);
+    consume_calls++;
+    supplied_fd = -1;
+    if (drop_owner_on_consume) {
+        owner_dropped = true;
+        object_unref(OBJECT(fixture_mon));
+    }
+    return fd;
+}
+
+static int fixture_close(int fd)
+{
+    int result;
+    int saved_errno;
+
+    if (fixture_mon->fd_admission.ordinary_operations != 0) {
+        g_assert_cmpint(qemu_mutex_trylock(&fixture_mon->mon_lock), ==, 0);
+        qemu_mutex_unlock(&fixture_mon->mon_lock);
+    }
+    result = close(fd);
+    saved_errno = errno;
+
+    close_calls++;
+    if (result == 0 && inject_post_close_eintr) {
+        /* Deterministic result injection after a real close, not kernel EINTR. */
+        result = -1;
+        saved_errno = EINTR;
+    }
+    errno = saved_errno;
+    return result;
+}
+
+static int fixture_duplicate(int fd)
+{
+    int result = qemu_dup(fd);
+    int saved_errno = errno;
+
+    g_assert_cmpuint(fixture_mon->fd_admission.ordinary_operations, ==, 1);
+    errno = saved_errno;
+    return result;
+}
+
+static void fixture_unref(void *object)
+{
+    Monitor *mon = object;
+
+    /* Assert before the real QOM unref, including when it is not the last. */
+    g_assert_cmpint(qemu_mutex_trylock(&mon->mon_lock), ==, 0);
+    qemu_mutex_unlock(&mon->mon_lock);
+    object_unref(object);
+}
+
+#define close fixture_close
+#define qemu_dup fixture_duplicate
+#define object_unref fixture_unref
+#define monitor_cur fixture_current_monitor
+#include "crucible-monitor-fd-loans.inc.h"
+#undef monitor_cur
+#undef object_unref
+#undef qemu_dup
+#undef close
+
+/* Real QOM allocation/refcounts; only Monitor instance initialization is modeled. */
+static void fixture_instance_init(Object *object)
+{
+    Monitor *mon = (Monitor *)object;
+
+    qemu_mutex_init(&mon->mon_lock);
+}
+
+static void fixture_instance_finalize(Object *object)
+{
+    Monitor *mon = (Monitor *)object;
+
+    g_assert_cmpint(qemu_mutex_trylock(&mon->mon_lock), ==, 0);
+    qemu_mutex_unlock(&mon->mon_lock);
+    g_assert_cmpuint(mon->fd_admission.ordinary_operations, ==, 0);
+    g_assert_true(QLIST_EMPTY(&mon->fds));
+    qemu_mutex_destroy(&mon->mon_lock);
+    finalizations++;
+}
+
+static const TypeInfo fixture_type = {
+    .name = "test-crucible-monitor-fd-loan",
+    .parent = TYPE_OBJECT,
+    .instance_size = sizeof(Monitor),
+    .instance_init = fixture_instance_init,
+    .instance_finalize = fixture_instance_finalize,
+};
+
+static void fixture_prepare(void)
+{
+    fixture_mon = (Monitor *)object_new(fixture_type.name);
+    g_assert_cmpuint(fixture_mon->fd_admission.ordinary_operations, ==, 0);
+    g_assert_false(fixture_mon->fd_admission.terminal_allocation_ref);
+    qemu_mutex_init(&mon_fdsets_lock);
+}
+
+static int fixture_event(void)
+{
+    int fd = eventfd(0, EFD_CLOEXEC | EFD_NONBLOCK);
+
+    g_assert_cmpint(fd, >=, 0);
+    return fd;
+}
+
+static void fixture_supply(const char *name, int fd)
+{
+    Error *error = NULL;
+
+    supplied_fd = fd;
+    qmp_getfd(name, &error);
+    g_assert_null(error);
+    g_assert_cmpuint(fixture_mon->fd_admission.ordinary_operations, ==, 0);
+}
+
+static void fixture_finish(void)
+{
+    g_assert_true(QLIST_EMPTY(&mon_fdsets));
+    qemu_mutex_destroy(&mon_fdsets_lock);
+    if (!owner_dropped) {
+        object_unref(OBJECT(fixture_mon));
+    }
+    g_assert_cmpuint(finalizations, ==, 1);
+}
+
+static void scenario_named(void)
+{
+    Error *error = NULL;
+    int first;
+    int second;
+    int duplicate;
+
+    fixture_prepare();
+    first = fixture_event();
+    fixture_supply("original", first);
+    second = fixture_event();
+    fixture_supply("original", second);
+    g_assert_cmpuint(close_calls, ==, 1);
+    g_assert_cmpint(fcntl(first, F_GETFD), ==, -1);
+    g_assert_cmpint(errno, ==, EBADF);
+
+    duplicate = monitor_dup_fd(fixture_mon, "original", &error);
+    g_assert_null(error);
+    g_assert_cmpint(duplicate, >=, 0);
+    g_assert_cmpint(duplicate, !=, second);
+    g_assert_true(fcntl(duplicate, F_GETFD) & FD_CLOEXEC);
+    g_assert_cmpint(fcntl(duplicate, F_GETFL), ==, fcntl(second, F_GETFL));
+    g_assert_true(fixture_mon->fd_admission.external_alias_custody);
+    g_assert_cmpint(monitor_get_fd(fixture_mon, "original", &error), ==, second);
+    g_assert_null(error);
+    g_assert_true(QLIST_EMPTY(&fixture_mon->fds));
+    g_assert_cmpuint(fixture_mon->fd_admission.ordinary_operations, ==, 0);
+    g_assert_cmpint(close(duplicate), ==, 0);
+    g_assert_cmpint(close(second), ==, 0);
+    fixture_finish();
+}
+
+static void scenario_close(void)
+{
+    Error *error = NULL;
+    int fd;
+
+    fixture_prepare();
+    fd = fixture_event();
+    fixture_supply("close", fd);
+    qmp_closefd("close", &error);
+    g_assert_null(error);
+    g_assert_cmpuint(close_calls, ==, 1);
+    g_assert_cmpint(fcntl(fd, F_GETFD), ==, -1);
+    g_assert_false(fixture_mon->fd_admission.close_uncertain);
+    qmp_closefd("missing", &error);
+    g_assert_nonnull(error);
+    g_assert_nonnull(strstr(error_get_pretty(error), "not found"));
+    error_free(error);
+    g_assert_cmpuint(close_calls, ==, 1);
+    fixture_finish();
+}
+
+static void scenario_refusals(void)
+{
+    Error *error = NULL;
+    int fd;
+
+    fixture_prepare();
+    qmp_getfd("1invalid", &error);
+    g_assert_nonnull(error);
+    g_assert_nonnull(strstr(error_get_pretty(error), "No file descriptor"));
+    error_free(error);
+    error = NULL;
+    fd = fixture_event();
+    supplied_fd = fd;
+    qmp_getfd("1invalid", &error);
+    g_assert_nonnull(error);
+    g_assert_nonnull(strstr(error_get_pretty(error), "not starting with a digit"));
+    error_free(error);
+    error = NULL;
+    g_assert_cmpuint(close_calls, ==, 1);
+    g_assert_cmpint(fcntl(fd, F_GETFD), ==, -1);
+    g_assert_cmpint(monitor_get_fd(fixture_mon, "missing", &error), ==, -1);
+    g_assert_nonnull(error);
+    error_free(error);
+    error = NULL;
+    g_assert_cmpint(monitor_dup_fd(fixture_mon, "missing", &error), ==, -1);
+    g_assert_nonnull(error);
+    error_free(error);
+    g_assert_cmpuint(fixture_mon->fd_admission.ordinary_operations, ==, 0);
+    fixture_finish();
+}
+
+static void scenario_fdset(void)
+{
+    Error *error = NULL;
+    AddfdInfo *info;
+    int fd;
+
+    fixture_prepare();
+    supplied_fd = fixture_event();
+    fd = supplied_fd;
+    info = qmp_add_fd(true, -1, "invalid-set", &error);
+    g_assert_null(info);
+    g_assert_nonnull(error);
+    error_free(error);
+    error = NULL;
+    g_assert_cmpint(fcntl(fd, F_GETFD), ==, -1);
+    g_assert_cmpuint(close_calls, ==, 1);
+
+    supplied_fd = fixture_event();
+    fd = supplied_fd;
+    info = qmp_add_fd(true, 7, "ordinary-set", &error);
+    g_assert_null(error);
+    g_assert_nonnull(info);
+    g_assert_cmpint(info->fdset_id, ==, 7);
+    g_assert_cmpint(info->fd, ==, fd);
+    g_assert_cmpuint(fixture_mon->fd_admission.ordinary_operations, ==, 0);
+    g_assert_true(fixture_mon->fd_admission.external_alias_custody);
+    qmp_remove_fd(7, true, fd, &error);
+    g_assert_null(error);
+    g_free(info);
+    fixture_finish();
+}
+
+static void scenario_overflow(void)
+{
+    Error *error = NULL;
+    int fd;
+
+    fixture_prepare();
+    supplied_fd = fixture_event();
+    fd = supplied_fd;
+    fixture_mon->fd_admission.ordinary_operations = UINT64_MAX;
+    qmp_getfd("blocked", &error);
+    g_assert_nonnull(error);
+    error_free(error);
+    error = NULL;
+    g_assert_null(qmp_add_fd(false, 0, NULL, &error));
+    g_assert_nonnull(error);
+    error_free(error);
+    g_assert_cmpuint(consume_calls, ==, 0);
+    g_assert_cmpint(supplied_fd, ==, fd);
+    g_assert_cmpint(fcntl(fd, F_GETFD), >=, 0);
+    g_assert_true(fixture_mon->fd_admission.counter_uncertain);
+    g_assert_true(fixture_mon->fd_admission.terminal_allocation_ref);
+    g_assert_cmpuint(close_calls, ==, 0);
+    /* Uncertain count and its allocation remain held to subprocess exit. */
+}
+
+static void scenario_loans(void)
+{
+    MonitorFdOperationLoan first = { 0 };
+    MonitorFdOperationLoan second = { 0 };
+
+    fixture_prepare();
+    g_assert_true(monitor_fd_operation_begin(fixture_mon, &first, NULL));
+    g_assert_true(monitor_fd_operation_begin(fixture_mon, &second, NULL));
+    g_assert_cmpuint(fixture_mon->fd_admission.ordinary_operations, ==, 2);
+    monitor_fd_operation_finish(&first);
+    g_assert_false(first.active);
+    g_assert_null(first.mon);
+    g_assert_cmpuint(fixture_mon->fd_admission.ordinary_operations, ==, 1);
+    object_unref(OBJECT(fixture_mon));
+    owner_dropped = true;
+    errno = EDOM;
+    monitor_fd_operation_finish(&second);
+    g_assert_cmpint(errno, ==, EDOM);
+    g_assert_cmpuint(finalizations, ==, 1);
+    fixture_finish();
+}
+
+static void scenario_consume_last_ref(void)
+{
+    Error *error = NULL;
+
+    fixture_prepare();
+    drop_owner_on_consume = true;
+    qmp_getfd("missing", &error);
+    g_assert_nonnull(error);
+    error_free(error);
+    g_assert_cmpuint(consume_calls, ==, 1);
+    g_assert_cmpuint(finalizations, ==, 1);
+    fixture_finish();
+}
+
+static void scenario_close_uncertainty(void)
+{
+    MonitorFdOperationLoan loan = { 0 };
+    int fd;
+
+    fixture_prepare();
+    fd = fixture_event();
+    g_assert_true(monitor_fd_operation_begin(fixture_mon, &loan, NULL));
+    g_assert_cmpint(close(fd), ==, 0);
+    errno = 0;
+    g_assert_cmpint(monitor_fd_operation_close(&loan, fd), ==, -1);
+    g_assert_cmpint(errno, ==, EBADF);
+    g_assert_cmpint(fixture_mon->fd_admission.first_close_result, ==, -1);
+    g_assert_cmpint(fixture_mon->fd_admission.first_close_errno, ==, EBADF);
+    g_assert_cmpint(fixture_mon->fd_admission.first_uncertain_fd, ==, fd);
+    inject_post_close_eintr = true;
+    fd = fixture_event();
+    g_assert_cmpint(monitor_fd_operation_close(&loan, fd), ==, -1);
+    g_assert_cmpint(errno, ==, EINTR);
+    g_assert_cmpint(fixture_mon->fd_admission.first_close_errno, ==, EBADF);
+    g_assert_cmpuint(close_calls, ==, 2);
+    monitor_fd_operation_finish(&loan);
+    g_assert_cmpint(errno, ==, EINTR);
+    g_assert_cmpuint(fixture_mon->fd_admission.ordinary_operations, ==, 0);
+    object_unref(OBJECT(fixture_mon));
+    owner_dropped = true;
+    g_assert_cmpuint(finalizations, ==, 0);
+    /* No retry and no release of terminal allocation custody. */
+}
+
+static void scenario_replacement_uncertainty(void)
+{
+    Error *error = NULL;
+    int original;
+    int replacement;
+
+    fixture_prepare();
+    original = fixture_event();
+    fixture_supply("replace", original);
+    replacement = fixture_event();
+    g_assert_cmpint(replacement, !=, original);
+    g_assert_cmpint(close(original), ==, 0);
+    supplied_fd = replacement;
+    qmp_getfd("replace", &error);
+    g_assert_null(error);
+    g_assert_cmpuint(close_calls, ==, 1);
+    g_assert_true(fixture_mon->fd_admission.close_uncertain);
+    g_assert_cmpint(fixture_mon->fd_admission.first_close_errno, ==, EBADF);
+    g_assert_cmpint(fixture_mon->fd_admission.first_uncertain_fd, ==, original);
+    g_assert_cmpint(monitor_get_fd(fixture_mon, "replace", &error), ==,
+                    replacement);
+    g_assert_null(error);
+    g_assert_cmpint(close(replacement), ==, 0);
+    g_assert_cmpuint(fixture_mon->fd_admission.ordinary_operations, ==, 0);
+    object_unref(OBJECT(fixture_mon));
+    g_assert_cmpuint(finalizations, ==, 0);
+}
+
+static void scenario_error_close_priority(void)
+{
+    Error *error = NULL;
+    int fd;
+
+    fixture_prepare();
+    supplied_fd = fixture_event();
+    fd = supplied_fd;
+    inject_post_close_eintr = true;
+    qmp_getfd("1invalid", &error);
+    g_assert_nonnull(error);
+    g_assert_nonnull(strstr(error_get_pretty(error), "not starting with a digit"));
+    error_free(error);
+    g_assert_cmpuint(close_calls, ==, 1);
+    g_assert_cmpint(fixture_mon->fd_admission.first_close_result, ==, -1);
+    g_assert_cmpint(fixture_mon->fd_admission.first_close_errno, ==, EINTR);
+    g_assert_cmpint(fixture_mon->fd_admission.first_uncertain_fd, ==, fd);
+    g_assert_cmpuint(fixture_mon->fd_admission.ordinary_operations, ==, 0);
+    g_assert_true(fixture_mon->fd_admission.terminal_allocation_ref);
+    /* A fresh FD may reuse fd; no production close retry can touch it. */
+    supplied_fd = fixture_event();
+    g_assert_cmpint(fcntl(supplied_fd, F_GETFD), >=, 0);
+    g_assert_cmpuint(close_calls, ==, 1);
+    object_unref(OBJECT(fixture_mon));
+    g_assert_cmpuint(finalizations, ==, 0);
+}
+
+static void scenario_counter_underflow(void)
+{
+    MonitorFdOperationLoan loan = { 0 };
+
+    fixture_prepare();
+    g_assert_true(monitor_fd_operation_begin(fixture_mon, &loan, NULL));
+    /* Test-only corrupt count witnesses retention, not a legal native writer. */
+    fixture_mon->fd_admission.ordinary_operations = 0;
+    monitor_fd_operation_finish(&loan);
+    g_assert_false(loan.active);
+    g_assert_null(loan.mon);
+    g_assert_true(fixture_mon->fd_admission.counter_uncertain);
+    g_assert_true(fixture_mon->fd_admission.terminal_allocation_ref);
+    object_unref(OBJECT(fixture_mon));
+    g_assert_cmpuint(finalizations, ==, 0);
+}
+
+static void test_duplicate_finish(void)
+{
+    MonitorFdOperationLoan loan = { 0 };
+
+    if (g_test_subprocess()) {
+        fixture_prepare();
+        g_assert_true(monitor_fd_operation_begin(fixture_mon, &loan, NULL));
+        monitor_fd_operation_finish(&loan);
+        monitor_fd_operation_finish(&loan);
+        g_assert_not_reached();
+    }
+    g_test_trap_subprocess(NULL, 10000000, 0);
+    g_test_trap_assert_failed();
+    g_test_trap_assert_stderr("*loan->active && mon*");
+}
+
+#define FD_SCENARIO(name) \
+    static void test_##name(void) \
+    { \
+        if (g_test_subprocess()) { \
+            scenario_##name(); \
+            return; \
+        } \
+        g_test_trap_subprocess(NULL, 10000000, 0); \
+        g_test_trap_assert_passed(); \
+    }
+
+FD_SCENARIO(named)
+FD_SCENARIO(close)
+FD_SCENARIO(refusals)
+FD_SCENARIO(fdset)
+FD_SCENARIO(overflow)
+FD_SCENARIO(loans)
+FD_SCENARIO(consume_last_ref)
+FD_SCENARIO(close_uncertainty)
+
+FD_SCENARIO(replacement_uncertainty)
+FD_SCENARIO(error_close_priority)
+FD_SCENARIO(counter_underflow)
+
+int main(int argc, char **argv)
+{
+    if (argc == 2 && !strcmp(argv[1], "--layout")) {
+        printf("{\"monitor_bytes\":%zu,\"admission_bytes\":%zu,"
+               "\"admission_alignment\":%zu,\"admission_offset\":%zu,"
+               "\"loan_bytes\":%zu,\"loan_alignment\":%zu}\n",
+               sizeof(Monitor), sizeof(MonitorFdAdmission),
+               _Alignof(MonitorFdAdmission), offsetof(Monitor, fd_admission),
+               sizeof(MonitorFdOperationLoan), _Alignof(MonitorFdOperationLoan));
+        return ferror(stdout) ? 1 : 0;
+    }
+    g_test_init(&argc, &argv, NULL);
+    module_call_init(MODULE_INIT_QOM);
+    type_register_static(&fixture_type);
+
+#define REGISTER_FD_SCENARIO(name) \
+    g_test_add_func("/monitor-fd-loans/" #name, test_##name)
+    REGISTER_FD_SCENARIO(named);
+    REGISTER_FD_SCENARIO(close);
+    REGISTER_FD_SCENARIO(refusals);
+    REGISTER_FD_SCENARIO(fdset);
+    REGISTER_FD_SCENARIO(overflow);
+    REGISTER_FD_SCENARIO(loans);
+    REGISTER_FD_SCENARIO(consume_last_ref);
+    REGISTER_FD_SCENARIO(close_uncertainty);
+    REGISTER_FD_SCENARIO(replacement_uncertainty);
+    REGISTER_FD_SCENARIO(error_close_priority);
+    REGISTER_FD_SCENARIO(counter_underflow);
+    REGISTER_FD_SCENARIO(duplicate_finish);
+#undef REGISTER_FD_SCENARIO
+
+    return g_test_run();
+}
diff --git a/tests/unit/test-crucible-mos6522-clock.c b/tests/unit/test-crucible-mos6522-clock.c
