+        qatomic_set(&publisher_slot->boundary_action_return[0], cpu_to_be64(UINT64_MAX - 1));
+        g_assert_cmpint(DELIVERY(identity_return)(1, &creation, delivery_serial), ==, -ESTALE);
+        g_assert_nonnull(creation);
+        g_assert_true(writer->held);
+        g_assert_true(writer->uncertain);
+        g_assert_false(writer->publication_started);
+        g_assert_cmpuint(be64_to_cpu(qatomic_read(&publisher_slot->boundary_action_return[0])),
+                         ==, UINT64_MAX - 1);
+        return;
+    }
+    status = DELIVERY(identity_return)(1, &creation, delivery_serial);
+    if (!strcmp(publisher_scenario, "publisher-partial-publication")) {
+        g_assert_cmpint(status, ==, -EIO);
+        g_assert_nonnull(creation);
+        g_assert_true(writer->held);
+        g_assert_true(writer->physical_closed);
+        g_assert_true(writer->publication_started);
+        g_assert_true(writer->uncertain);
+        g_assert_false(writer->publication_consumed);
+        g_assert_cmpint(writer->publication_status, ==, -EIO);
+        g_assert_cmpuint(be64_to_cpu(qatomic_read(&publisher_slot->boundary_action_return[0])),
+                         ==, UINT64_MAX);
+        g_assert_cmpint(DELIVERY(identity_return)(1, &creation, delivery_serial), ==, -EBUSY);
+        g_assert_nonnull(creation);
+        g_assert_cmpuint(qatomic_read(&publisher_slot->boundary_action_hold), ==, 6);
+        return;
+    }
+    if (!strcmp(publisher_scenario, "publisher-publication-post")) {
+        g_assert_cmpint(status, ==, -EIO);
+        g_assert_nonnull(creation);
+        g_assert_true(writer->publication_consumed);
+        g_assert_false(writer->held);
+        g_assert_cmpint(writer->publication_post, ==, -EIO);
+        status = DELIVERY(identity_return)(1, &creation, delivery_serial);
+        g_assert_cmpint(writer->publication_post, ==, -EIO);
+    }
+    g_assert_cmpint(status, ==, 0);
+    g_assert_null(creation);
+    g_assert_true(writer->physical_closed);
+    g_assert_true(writer->publication_consumed);
+    g_assert_false(writer->held);
+    g_assert_cmpuint(qatomic_read(&publisher_slot->boundary_action_hold), ==, 6);
+    g_assert_cmpuint(be64_to_cpu(qatomic_read(&publisher_slot->boundary_action_return[0])), ==, 2);
+    for (size_t index = 0; index < sizeof(wire) / sizeof(uint64_t); index++) {
+        uint64_t word = qatomic_read(&publisher_slot->boundary_action_return[index + 1]);
+
+        memcpy(wire + index * sizeof(word), &word, sizeof(word));
+    }
+    g_assert_cmpmem(wire, 8, "CRUCRET1", 8);
+    g_assert_cmpuint(ldl_be_p(wire + 8), ==, 1);
+    g_assert_cmpuint(ldl_be_p(wire + 12), ==, sizeof(wire));
+    g_assert_cmpuint(ldq_be_p(wire + 112), ==, 6);
+    g_assert_cmpint((int32_t)ldl_be_p(wire + 120), ==, publisher_action_first);
+    g_assert_cmpint((int32_t)ldl_be_p(wire + 124), ==, publisher_action_post);
+    g_assert_cmpuint(ldl_be_p(wire + 128), ==, 1);
+    g_assert_cmpuint(ldl_be_p(wire + 132), ==, 1);
+    g_assert_cmpuint(ldl_be_p(wire + 136), ==, 1);
+    g_assert_cmpuint(ldl_be_p(wire + 140), ==, 0);
+    g_assert_cmpuint(ldl_be_p(wire + 144), ==, 0);
+    g_assert_cmpuint(ldq_be_p(wire + 152), ==, 0);
+    g_assert_cmpuint(ldq_be_p(wire + 160), ==, 0);
+    g_assert_cmpuint(ldl_be_p(wire + 168), ==, 1);
+    g_assert_cmpuint(paid_runtime.member->action_users, ==, 0);
+    g_assert_cmpint(RECEIVE(identity_return)(1, &receive, receive_serial), ==, -ENOKEY);
+    g_assert_nonnull(receive);
+    /* Parent receive/assigned mapping remain retained; no peer retirement or
+     * physical mapping return is asserted by local publication completion. */
+    puts("PASS publisher local closure: actual Ready/Main/module return and atomic writer; modeled installed/semantic boundaries, no peer retirement");
+}
