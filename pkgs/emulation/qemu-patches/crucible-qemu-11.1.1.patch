+        uint32_t length;
+        uint64_t region_offset;
+        CrucibleRestoreRegion *region;
+
+        if (!crucible_restore_u32(layer->fd, layer->bytes, &offset,
+                                  &region_index, cancellation_fd, errp) ||
+            !crucible_restore_u32(layer->fd, layer->bytes, &offset,
+                                  &length, cancellation_fd, errp) ||
