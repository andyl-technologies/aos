+        "int qemu_crucible_ram_diagnostic_fail(",
+        "int qemu_crucible_ram_placement_before_resume(",
+    ]]
+    bodies[0:0] = [
+        definition(source, "static int research_resident_cancellation_status("),
+        definition(source, "static int research_resident_before_resume(void)\n{"),
+    ]
