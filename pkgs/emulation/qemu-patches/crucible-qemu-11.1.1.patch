+int qemu_crucible_fault_validation_current_v1(
+    const QemuCrucibleFaultHandler *handler,
+    const struct qemu_plugin_crucible_fault_command *command,
+    const uint8_t *payload, size_t payload_len)
+{
+    int status;
+
+    if (qatomic_load_acquire(&crucible_fault_validation.process) != getpid()) {
+        return -EPERM;
+    }
+    g_mutex_lock(&crucible_fault_validation.lock);
+    status = crucible_fault_validation.calling &&
+        crucible_fault_validation.handler == handler &&
+        crucible_fault_validation.command == command &&
+        crucible_fault_validation.payload == payload &&
+        crucible_fault_validation.payload_len == payload_len &&
+        qemu_thread_is_self(&crucible_fault_validation.thread) ? 0 : -EPERM;
+    g_mutex_unlock(&crucible_fault_validation.lock);
+    return status;
+}
+
+static int crucible_fault_validate_command(
+    const QemuCrucibleFaultHandler *handler,
+    const struct qemu_plugin_crucible_fault_command *command,
+    const uint8_t *payload, size_t payload_len)
+{
+    int status;
+    pid_t process;
+
+    if (!handler->validate) {
+        return 0;
+    }
+    status = qemu_crucible_fault_node_validation_owned_v1(handler);
+    if (status == -ENOENT) {
+        return handler->validate(command, payload, payload_len);
+    }
+    if (status) {
+        return status;
+    }
+    process = qatomic_load_acquire(&crucible_fault_validation.process);
+    if (process && process != getpid()) {
+        return -EPERM;
+    }
+    g_mutex_lock(&crucible_fault_validation.lock);
+    if (crucible_fault_validation.calling ||
+        crucible_fault_validation.issuance == UINT64_MAX) {
+        g_mutex_unlock(&crucible_fault_validation.lock);
+        return -EBUSY;
+    }
+    crucible_fault_validation.issuance++;
+    crucible_fault_validation.handler = handler;
+    crucible_fault_validation.command = command;
+    crucible_fault_validation.payload = payload;
+    crucible_fault_validation.payload_len = payload_len;
+    qemu_thread_get_self(&crucible_fault_validation.thread);
+    qatomic_store_release(&crucible_fault_validation.process, getpid());
+    crucible_fault_validation.calling = true;
+    g_mutex_unlock(&crucible_fault_validation.lock);
+
+    status = qemu_crucible_fault_node_validate_v1(
+        handler, command, payload, payload_len);
+
+    /* This actual helper return closes only its dispatch interval. The child
+     * keeps failed post debt, and nonlocal exits leave this interval occupied. */
+    if (qatomic_load_acquire(&crucible_fault_validation.process) != getpid()) {
+        return status ? status : -EPERM;
+    }
+    g_mutex_lock(&crucible_fault_validation.lock);
+    crucible_fault_validation.calling = false;
+    g_mutex_unlock(&crucible_fault_validation.lock);
+    return status;
+}
