+/* Retain the actual timer callbacks and VMState without realizing a board. */
+#undef type_init
+#define type_init(function) \
+    static void (*const fixture_##function)(void) G_GNUC_UNUSED = function;
+#include "../../hw/dma/rc4030.c"
+
+static __int128 observed_ps;
+
+typedef struct IRQObservation {
+    unsigned raised;
+    unsigned lowered;
+    int level;
+} IRQObservation;
+
+int64_t cpu_get_clock(void)
+{
+    return observed_ps / PICOSECONDS_PER_NANOSECOND;
+}
+
+bool icount_crucible_sim_mode(void)
+{
+    return false;
+}
+
+static __int128 observed_clock_ps(void)
+{
+    return observed_ps;
+}
+
+static void initialize_clock(bool exact)
+{
+    Error *error = NULL;
+
+    module_call_init(MODULE_INIT_QOM);
+    qemu_init_main_loop(&error);
+    g_assert_null(error);
+    if (exact) {
+        qemu_timer_enable_tcg_ps_clock(NULL, observed_clock_ps);
+    }
+    qemu_clock_enable(QEMU_CLOCK_VIRTUAL, true);
+}
+
+/* IRQ endpoints observe the literal callback, without a physical chipset. */
+static void observe_irq(void *opaque, int number, int level)
+{
+    IRQObservation *observation = opaque;
+
+    observation->level = level;
+    if (level) {
+        observation->raised++;
+    } else {
+        observation->lowered++;
+    }
+}
+
+static void initialize_chipset(rc4030State *chipset, IRQObservation *timer_irq,
+                                IRQObservation *bus_irq)
+{
+    memset(chipset, 0, sizeof(*chipset));
+    chipset->timer_irq = qemu_allocate_irq(observe_irq, timer_irq, 0);
+    chipset->jazz_bus_irq = qemu_allocate_irq(observe_irq, bus_irq, 1);
+    chipset->periodic_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL,
+                                          rc4030_periodic_timer, chipset);
+}
+
+static void destroy_chipset(rc4030State *chipset)
+{
+    timer_free(chipset->periodic_timer);
+    qemu_free_irq(chipset->timer_irq);
+    qemu_free_irq(chipset->jazz_bus_irq);
+}
+
+static __int128 interval_ps(uint32_t reload)
+{
+    uint32_t frequency = 1000 / (reload + 1);
+
+    return (PICOSECONDS_PER_SECOND + frequency - 1) / frequency;
+}
+
+static void assert_deadline(rc4030State *chipset, __int128 expected)
+{
+    g_assert_true(timer_pending(chipset->periodic_timer));
+    g_assert_true(timer_expire_time_ps_wide(chipset->periodic_timer) ==
+                  expected);
+}
+
+static void test_all_reload_values(void)
+{
+    rc4030State chipset;
+    IRQObservation timer_irq = { 0 };
+    IRQObservation bus_irq = { 0 };
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    observed_ps = 999;
+    initialize_clock(true);
+    initialize_chipset(&chipset, &timer_irq, &bus_irq);
+    for (uint32_t reload = 0; reload <= 0x1ff; reload++) {
+        chipset.itr = reload;
+        set_next_tick(&chipset);
+        assert_deadline(&chipset, observed_ps + interval_ps(reload));
+    }
+    g_assert_cmpuint(timer_irq.lowered, ==, 512);
+    g_assert_cmpuint(timer_irq.raised, ==, 0);
+    destroy_chipset(&chipset);
+}
+
+static void test_periodic_callback(void)
+{
+    rc4030State chipset;
+    IRQObservation timer_irq = { 0 };
+    IRQObservation bus_irq = { 0 };
+    const __int128 start_ps = 999;
+    const __int128 delay_ps = INT64_C(3003003004);
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    observed_ps = start_ps;
+    initialize_clock(true);
+    initialize_chipset(&chipset, &timer_irq, &bus_irq);
+    chipset.itr = 2;
+    set_next_tick(&chipset);
+
+    observed_ps = start_ps + delay_ps - 1;
+    qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL);
+    g_assert_cmpuint(timer_irq.raised, ==, 0);
+    assert_deadline(&chipset, start_ps + delay_ps);
+    observed_ps++;
+    qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL);
+    g_assert_cmpuint(timer_irq.raised, ==, 1);
+    g_assert_cmpint(timer_irq.level, ==, 1);
+    assert_deadline(&chipset, start_ps + 2 * delay_ps);
+    destroy_chipset(&chipset);
