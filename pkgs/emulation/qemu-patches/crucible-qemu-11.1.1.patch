+typedef struct SourceJSONWriter {
+    JSONWriter writer;
+    QemuCrucibleQmpAllocationOwner *owner;
+    QemuCrucibleQmpStringMutation *mutation;
+    char *formatted;
+    int first_status;
+    int post_status;
+    int cleanup_status;
+    bool wrote;
