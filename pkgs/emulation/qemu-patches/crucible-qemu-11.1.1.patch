+        QLIST_FOREACH_SAFE(duplicate, &sets[i]->dup_fds, next,
+                           next_duplicate) {
+            /* The block node still owns the live descriptor. */
+            QLIST_REMOVE(duplicate, next);
+            g_free(duplicate);
+        }
+        monitor_fdset_free(sets[i]);
