+static bool crucible_hot_fork_plan_contains_diagnostics(
+    const QemuCrucibleHotForkChildResourcePlan *resources,
+    const QemuCrucibleHotForkDiagnosticsChildResourcePlan *diagnostics)
+{
+    size_t index;
+
+    if (!diagnostics || !diagnostics->prepared ||
+        !qemu_crucible_hot_fork_diagnostics_child_resources_prepared_for(
+            &resources->diagnostics, diagnostics->replacement.source_fd,
+            diagnostics->socket_cookie)) {
+        return false;
+    }
+    for (index = 0; index < resources->replacement_count; index++) {
+        if (resources->replacements[index].target_fd ==
+                diagnostics->replacement.target_fd) {
+            if (!crucible_hot_fork_replacement_equal(
+                    &resources->replacements[index],
+                    &diagnostics->replacement)) {
+                return false;
+            }
+            return crucible_hot_fork_fd_table_contains(
+                resources->retained_fds, resources->retained_fd_count,
+                diagnostics->retained_fd);
+        }
+        if (resources->replacements[index].target_fd >
+                diagnostics->replacement.target_fd) {
+            break;
+        }
+    }
+    return false;
+}
