+    if (!out || !*out) {
+        return -EINVAL;
+    }
+    borrow = *out;
+    status = checkpoint_inventory_metadata_identity(borrow);
+    if (status || loan != borrow->loan || out != borrow->owner_holder) {
+        return status ? status : -EPERM;
