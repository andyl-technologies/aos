diff --git a/include/hw/southbridge/piix-fingerprint.h b/include/hw/southbridge/piix-fingerprint.h
new file mode 100644
index 0000000000000000000000000000000000000000..66e9766dd58da83fe1db24ff5fd2eb858d1dfe7b
--- /dev/null
+++ b/include/hw/southbridge/piix-fingerprint.h
@@ -0,0 +1,29 @@
+/*
+ * PIIX southbridge fingerprint projection internals
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef HW_SOUTHBRIDGE_PIIX_FINGERPRINT_H
+#define HW_SOUTHBRIDGE_PIIX_FINGERPRINT_H
+
+#include "hw/southbridge/piix.h"
+#include "migration/qemu-file.h"
+
+static inline void piix_state_fingerprint_projection(
+    QEMUFile *f, const PIIXState *piix,
+    const int32_t pci_irq_levels[PIIX_NUM_PIRQS])
+{
+    qemu_put_be64(f, piix->pic_levels);
+    for (size_t i = 0; i < PIIX_NUM_PIRQS; i++) {
+        qemu_put_be32(f, pci_irq_levels[i]);
+    }
+    qemu_put_be32(f, piix->smb_io_base);
+    qemu_put_byte(f, piix->rcr);
+    qemu_put_byte(f, piix->has_acpi);
+    qemu_put_byte(f, piix->has_pic);
+    qemu_put_byte(f, piix->has_pit);
+    qemu_put_byte(f, piix->has_usb);
+    qemu_put_byte(f, piix->smm_enabled);
+}
+
+#endif
