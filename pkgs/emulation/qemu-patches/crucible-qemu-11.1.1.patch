+static void control_stop_dispatch(CPUState *cpu,
+                                  QemuCrucibleNativeGroupUse *group_use,
+                                  qemu_plugin_vcpu_idle_resume_cb_t callback,
+                                  void *userdata, uint64_t observed_icount)
+{
+    int status;
+
+    /* This fixed frame is installed only from the actual Main call site.
+     * Nested callbacks cannot replace it or borrow its Stop authority.
+     */
+    if (control_stop_storage.dispatch.installed ||
+        !qemu_in_main_thread() ||
+        !bql_locked() || qemu_in_coroutine() || current_cpu || cpu != first_cpu) {
+        return;
+    }
+    if (control_stop_storage.main.held) {
+        /* A new actual Main boundary may close old physical debt. It cannot
+         * reenter the callback or revive the old action's operation interval. */
+        if (control_stop_storage.dispatch.cleanup_serial == UINT64_MAX ||
+            control_stop_storage.main.cpu != cpu ||
+            control_stop_storage.dispatch.callback != callback ||
+            control_stop_storage.dispatch.userdata != userdata) {
+            return;
+        }
+        control_stop_storage.dispatch.cleanup_serial++;
+        control_stop_storage.dispatch.cleanup = true;
+        control_stop_storage.dispatch.phase = CONTROL_DISPATCH_RETURNING;
+        control_stop_storage.dispatch.installed = true;
+        if (group_use) {
+            /* This new boundary owns its fetched-descriptor mask. Consume
+             * only that mask before returning the older physical Main frame;
+             * any unrelated suppression remains and still refuses closure. */
+            qemu_plugin_crucible_native_exit_v1(group_use->mask);
+            group_use->mask = (QemuCrucibleNativeInvocationTicket) { 0 };
+        }
+        control_stop_main_return();
+        control_stop_storage.dispatch.installed = false;
+        control_stop_storage.dispatch.phase = CONTROL_DISPATCH_NONE;
+        control_stop_storage.dispatch.cleanup = false;
+        return;
+    }
+    control_stop_storage.dispatch.callback = callback;
+    control_stop_storage.dispatch.userdata = userdata;
+    control_stop_storage.dispatch.cpu = cpu;
+    control_stop_storage.dispatch.process = getpid();
+    control_stop_storage.dispatch.phase = CONTROL_DISPATCH_PREPARING;
+    control_stop_storage.dispatch.invocation = NULL;
+    qemu_thread_get_self(&control_stop_storage.dispatch.thread);
+    control_stop_storage.dispatch.installed = true;
+
+    /* This distinct factual frame retains actual registration/QOM/Source
+     * custody even when independent posts or Stop admission refuse. */
+    memset(&control_stop_storage.main, 0, sizeof(control_stop_storage.main));
+    control_stop_storage.main.record = group_use ? group_use->record : NULL;
+    control_stop_storage.main.cpu = cpu;
+    control_stop_storage.main.begin_status =
+        qemu_plugin_crucible_native_main_control_begin_v1(
+            group_use, cpu, &control_stop_storage.main.ticket);
+    if (control_stop_storage.main.ticket.frame) {
+        control_stop_storage.main.held = true;
+        control_stop_storage.main.borrow_status =
+            qemu_crucible_source_main_control_borrow_v1(
+                &control_stop_storage.main.ticket, &control_stop_storage.main.borrow);
+    }
+
+    if (control_stop_storage.main.borrow) {
+        control_stop_storage.main.payload_status =
+            qemu_crucible_source_main_payload_borrow_v1(control_stop_storage.main.borrow);
+    }
+
+    status = qemu_crucible_source_control_callback_begin_v1(
+        callback, control_stop_storage.dispatch.userdata,
+        &control_stop_storage.dispatch.invocation);
+    control_stop_storage.dispatch.begin_status = status;
+    control_stop_storage.dispatch.end_status = 0;
+    control_stop_storage.dispatch.advance_status = 0;
+    control_stop_storage.dispatch.advance_handoff_status = 0;
+    if (!status) {
+        control_stop_storage.dispatch.phase = CONTROL_DISPATCH_CALLING;
+        int action_status = control_stop_storage.main.borrow ?
+            qemu_crucible_source_action_original_enter_v1(
+                control_stop_storage.main.borrow) : -ENOTSUP;
+
+        qemu_plugin_trace_control_delivery("registered-enter");
+        QemuCrucibleNativeInvocationTicket native =
+            qemu_plugin_crucible_native_enter_v1(
+                NULL, &qemu_plugin_control_boundary_cb, callback,
+                control_stop_storage.dispatch.userdata,
+                QEMU_CRUCIBLE_NATIVE_CONTROL);
+
+        control_stop_storage.dispatch.callback_ticket = native;
+        control_stop_storage.dispatch.callback_entered = true;
+        if (!action_status || action_status == -ENOTSUP) {
+            callback(cpu->cpu_index, observed_icount,
+                     control_stop_storage.dispatch.userdata);
+            /* The module's real callback first receives/retains its pending
+             * command. The distinct async receiver then authenticates that
+             * actual owner while the same Main remains CALLING. */
+            control_stop_storage.dispatch.advance_status =
+                qemu_crucible_source_advance_pending_callback_return_v1(
+                    &control_stop_storage.main.ticket,
+                    &control_stop_storage.dispatch.callback_ticket);
+            int receive_status = qemu_crucible_source_advance_receive_v1(
+                    &control_stop_storage.main.ticket,
+                    &control_stop_storage.dispatch.callback_ticket);
+
+            if (!control_stop_storage.dispatch.advance_status) {
+                control_stop_storage.dispatch.advance_status = receive_status;
+            }
+            control_stop_storage.dispatch.advance_handoff_status =
+                qemu_crucible_source_advance_handoff_v1(
+                    &control_stop_storage.main.ticket,
+                    &control_stop_storage.dispatch.callback_ticket);
+        }
+        control_stop_storage.dispatch.callback_entered = false;
+        qemu_plugin_crucible_native_exit_v1(native);
+        control_stop_storage.dispatch.callback_ticket =
+            (QemuCrucibleNativeInvocationTicket) { 0 };
+        if (control_stop_storage.main.borrow) {
+            qemu_crucible_source_action_original_post_v1(
+                control_stop_storage.main.borrow);
+        }
+        qemu_plugin_trace_control_delivery("registered-return");
+    }
+
+    /* Begin may publish custody before a failed independent post. End every
+     * actual output while the authentic native frame still exists.
+     */
+    control_stop_storage.dispatch.phase = CONTROL_DISPATCH_RETURNING;
+    if (control_stop_storage.dispatch.invocation) {
+        control_stop_storage.dispatch.end_status =
+            qemu_crucible_source_control_callback_end_v1(
+                control_stop_storage.dispatch.invocation);
+    }
+    control_stop_main_return();
+    if (!control_stop_storage.main_first_status) {
+        control_stop_storage.main_first_status = control_stop_storage.main.begin_status ?
+            control_stop_storage.main.begin_status : control_stop_storage.main.borrow_status ?
+            control_stop_storage.main.borrow_status : control_stop_storage.main.payload_status ?
+            control_stop_storage.main.payload_status : control_stop_storage.main.payload_return_status ?
+            control_stop_storage.main.payload_return_status : control_stop_storage.main.return_status ?
+            control_stop_storage.main.return_status : control_stop_storage.dispatch.advance_status ?
+            control_stop_storage.dispatch.advance_status :
+            control_stop_storage.dispatch.advance_handoff_status;
+    }
+    /* The actual entered interval ends even when physical borrowers remain.
+     * Only a later actual Main boundary can enter the cleanup path above. */
+    control_stop_storage.dispatch.installed = false;
+    control_stop_storage.dispatch.phase = CONTROL_DISPATCH_NONE;
+    control_stop_storage.dispatch.invocation = NULL;
+}
diff --git a/plugins/crucible-device-workspace.c b/plugins/crucible-device-workspace.c
new file mode 100644
index 0000000000000000000000000000000000000000..c5d72e44f3e70eb0308a023cac30c14adf7b530c
--- /dev/null
+++ b/plugins/crucible-device-workspace.c
@@ -0,0 +1,384 @@
+/*
+ * Crucible fixed workspace wire evidence and early child status syntax
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/bswap.h"
+#include "qemu/memfd.h"
+#include "qemu/crucible-device-workspace.h"
+
+int qemu_crucible_device_workspace_decode(
+    const uint8_t *wire, size_t length,
+    QemuCrucibleDeviceWorkspaceWireRecord *record)
+{
+    QemuCrucibleDeviceWorkspaceWireRecord decoded = { 0 };
+
+    if (!wire || !record ||
+        length != QEMU_CRUCIBLE_DEVICE_WORKSPACE_WIRE_BYTES) {
+        return -EINVAL;
+    }
+    if (memcmp(wire, "CRUCWSP1", 8) != 0 ||
+        ldl_be_p(wire + 8) != QEMU_CRUCIBLE_DEVICE_WORKSPACE_SCHEMA) {
+        return -EPROTONOSUPPORT;
+    }
+    if ((ldl_be_p(wire + 12) != QEMU_CRUCIBLE_DEVICE_WORKSPACE_INITIAL &&
+         ldl_be_p(wire + 12) != QEMU_CRUCIBLE_DEVICE_WORKSPACE_CHILD) ||
+        ldq_be_p(wire + 120) != QEMU_CRUCIBLE_DEVICE_WORKSPACE_BYTES) {
+        return -EINVAL;
+    }
+
+    decoded.schema_version = ldl_be_p(wire + 8);
+    decoded.scope = ldl_be_p(wire + 12);
+    memcpy(decoded.source_proof_digest, wire + 16,
+           sizeof(decoded.source_proof_digest));
+
+    decoded.original_total_bytes = ldq_be_p(wire + 48);
+    decoded.metadata_charge_bytes = ldq_be_p(wire + 56);
+    decoded.resident_charge_bytes = ldq_be_p(wire + 64);
+    decoded.process_generation = ldq_be_p(wire + 72);
+    decoded.account_generation = ldq_be_p(wire + 80);
+    decoded.workspace_generation = ldq_be_p(wire + 88);
+    decoded.workspace_device = ldq_be_p(wire + 96);
+    decoded.workspace_inode = ldq_be_p(wire + 104);
+    decoded.native_fd_peak = ldl_be_p(wire + 112);
+    decoded.native_vma_peak = ldl_be_p(wire + 116);
+    decoded.workspace_length = ldq_be_p(wire + 120);
+
+    *record = decoded;
+    return 0;
+}
+
+int qemu_crucible_original_startup_decode(
+    const uint8_t *wire, size_t length,
+    QemuCrucibleOriginalStartupWireRecord *record)
+{
+    QemuCrucibleOriginalStartupWireRecord decoded = { 0 };
+    uint32_t descriptor;
+    uint8_t cap_nonzero = 0;
+
+    if (!wire || !record ||
+        length != QEMU_CRUCIBLE_ORIGINAL_STARTUP_WIRE_BYTES) {
+        return -EINVAL;
+    }
+    if (memcmp(wire, "CRUCSTP1", 8) != 0 ||
+        ldl_be_p(wire + 8) != QEMU_CRUCIBLE_ORIGINAL_STARTUP_SCHEMA) {
+        return -EPROTONOSUPPORT;
+    }
+    if (ldl_be_p(wire + 12) != QEMU_CRUCIBLE_ORIGINAL_STARTUP_WIRE_BYTES) {
+        return -EINVAL;
+    }
+
+    decoded.schema_version = ldl_be_p(wire + 8);
+    decoded.record_bytes = ldl_be_p(wire + 12);
+    memcpy(decoded.cap_id, wire + 16, sizeof(decoded.cap_id));
+    for (size_t index = 0; index < sizeof(decoded.cap_id); index++) {
+        cap_nonzero |= decoded.cap_id[index];
+    }
+    decoded.operation_id = ldq_be_p(wire + 48);
+    decoded.original_start_ns = ldq_be_p(wire + 56);
+    decoded.absolute_end_ns = ldq_be_p(wire + 64);
+    decoded.poll_ns = ldq_be_p(wire + 72);
+    decoded.process_generation = ldq_be_p(wire + 80);
+    decoded.cancellation_device = ldq_be_p(wire + 88);
+    decoded.cancellation_inode = ldq_be_p(wire + 96);
+    descriptor = ldl_be_p(wire + 104);
+    decoded.flags = ldl_be_p(wire + 108);
+    decoded.cancellation_event_id = ldq_be_p(wire + 112);
+    decoded.original_total_bytes = ldq_be_p(wire + 120);
+
+    if (!cap_nonzero || decoded.operation_id == 0 ||
+        decoded.original_start_ns == 0 || decoded.poll_ns == 0 ||
+        decoded.process_generation == 0 || decoded.cancellation_inode == 0 ||
+        decoded.cancellation_event_id == 0 ||
+        decoded.absolute_end_ns <= decoded.original_start_ns ||
+        descriptor < 3 || descriptor > INT_MAX ||
+        decoded.flags != QEMU_CRUCIBLE_ORIGINAL_STARTUP_FLAGS ||
+        decoded.original_total_bytes == 0) {
+        return -EINVAL;
+    }
+
+    /* Narrow only the checked scalar; this does not borrow or operate an FD. */
+    decoded.cancellation_descriptor = (int32_t)descriptor;
+    *record = decoded;
+    return 0;
+}
+
+/* Both callers provide the fixed header; this helper reads only that header. */
+static int crucible_workspace_setup_header_decode(
+    const uint8_t *header, uint64_t length,
+    QemuCrucibleDeviceWorkspaceSetupView *view)
+{
+    QemuCrucibleDeviceWorkspaceSetupView decoded = { 0 };
+    uint64_t selectable_offset;
+    uint64_t workspace_offset;
+    uint64_t startup_offset;
+    uint64_t expected_length;
+
+    if (length < QEMU_CRUCIBLE_WORKSPACE_SETUP_HEADER_BYTES ||
+        length > QEMU_CRUCIBLE_WORKSPACE_SETUP_TOTAL_MAX) {
+        return -EINVAL;
+    }
+    if (memcmp(header, "CRUCSUP3", 8) != 0 ||
+        ldl_be_p(header + 8) != QEMU_CRUCIBLE_WORKSPACE_SETUP_SCHEMA) {
+        return -EPROTONOSUPPORT;
+    }
+    if (ldl_be_p(header + 12) != QEMU_CRUCIBLE_WORKSPACE_SETUP_HEADER_BYTES ||
+        ldl_be_p(header + 16) != length) {
+        return -EINVAL;
+    }
+
+    decoded.total_bytes = ldl_be_p(header + 16);
+    decoded.app_random_bytes = ldl_be_p(header + 20);
+    decoded.selectable_bytes = ldl_be_p(header + 24);
+    decoded.workspace_bytes = ldl_be_p(header + 28);
+    decoded.startup_bytes = ldl_be_p(header + 32);
+    if (decoded.app_random_bytes >
+            QEMU_CRUCIBLE_WORKSPACE_SETUP_APP_RANDOM_MAX ||
+        decoded.selectable_bytes >
+            QEMU_CRUCIBLE_WORKSPACE_SETUP_SELECTABLE_MAX ||
+        (decoded.workspace_bytes != 0 &&
+         decoded.workspace_bytes !=
+             QEMU_CRUCIBLE_DEVICE_WORKSPACE_WIRE_BYTES) ||
+        (decoded.startup_bytes != 0 &&
+         decoded.startup_bytes != QEMU_CRUCIBLE_ORIGINAL_STARTUP_WIRE_BYTES)) {
+        return -EINVAL;
+    }
+
+    /* Widen before adding; narrow after the unchanged total cap matches. */
+    selectable_offset = QEMU_CRUCIBLE_WORKSPACE_SETUP_HEADER_BYTES +
+        (uint64_t)decoded.app_random_bytes;
+    workspace_offset = selectable_offset + decoded.selectable_bytes;
+    startup_offset = workspace_offset + decoded.workspace_bytes;
+    expected_length = startup_offset + decoded.startup_bytes;
+    if (expected_length != length) {
+        return -EINVAL;
+    }
+    decoded.app_random_offset = QEMU_CRUCIBLE_WORKSPACE_SETUP_HEADER_BYTES;
+    decoded.selectable_offset = (uint32_t)selectable_offset;
+    decoded.workspace_offset = (uint32_t)workspace_offset;
+    decoded.startup_offset = (uint32_t)startup_offset;
+
+    *view = decoded;
+    return 0;
+}
+
+static bool crucible_workspace_setup_records_match(
+    const QemuCrucibleDeviceWorkspaceSetupView *view)
+{
+    return view->workspace_bytes == 0 || view->startup_bytes == 0 ||
+        (view->workspace.process_generation ==
+             view->startup.process_generation &&
+         view->workspace.original_total_bytes ==
+             view->startup.original_total_bytes);
+}
+
+int qemu_crucible_device_workspace_setup_decode(
+    const uint8_t *wire, size_t length,
+    QemuCrucibleDeviceWorkspaceSetupView *view)
+{
+    QemuCrucibleDeviceWorkspaceSetupView decoded;
+    int result;
+
+    if (!wire || !view ||
+        length < QEMU_CRUCIBLE_WORKSPACE_SETUP_HEADER_BYTES) {
+        return -EINVAL;
+    }
+    result = crucible_workspace_setup_header_decode(wire, length, &decoded);
+    if (result != 0) {
+        return result;
+    }
+
+    if (decoded.workspace_bytes != 0) {
+        result = qemu_crucible_device_workspace_decode(
+            wire + decoded.workspace_offset, decoded.workspace_bytes,
+            &decoded.workspace);
+        if (result != 0) {
+            return result;
+        }
+    }
+    if (decoded.startup_bytes != 0) {
+        result = qemu_crucible_original_startup_decode(
+            wire + decoded.startup_offset, decoded.startup_bytes,
+            &decoded.startup);
+        if (result != 0) {
+            return result;
+        }
+    }
+    if (!crucible_workspace_setup_records_match(&decoded)) {
+        return -EINVAL;
+    }
+
+    *view = decoded;
+    return 0;
+}
+
+#ifdef CONFIG_LINUX
+static int crucible_workspace_pread_exact(int fd, uint8_t *buffer,
+                                         size_t length, uint32_t offset)
+{
+    size_t completed = 0;
+
+    while (completed < length) {
+        uint64_t position = (uint64_t)offset + completed;
+        off_t file_offset = (off_t)position;
+        ssize_t received;
+
+        if (file_offset < 0 || (uint64_t)file_offset != position) {
+            return -EOVERFLOW;
+        }
+        received = pread(fd, buffer + completed, length - completed,
+                         file_offset);
+        if (received < 0) {
+            /* Refuse EINTR too: the reader never renews or spins a budget. */
+            return -errno;
+        }
+        if (received == 0) {
+            return -EIO;
+        }
+        completed += received;
+    }
+    return 0;
+}
+#endif
+
+int qemu_crucible_device_workspace_setup_read_fd(
+    int fd, QemuCrucibleDeviceWorkspaceSetupView *view)
+{
+#ifdef CONFIG_LINUX
+    const int required_seals = F_SEAL_WRITE | F_SEAL_SHRINK |
+        F_SEAL_GROW | F_SEAL_SEAL;
+    QemuCrucibleDeviceWorkspaceSetupView decoded;
+    uint8_t header[QEMU_CRUCIBLE_WORKSPACE_SETUP_HEADER_BYTES];
+    uint8_t record[QEMU_CRUCIBLE_DEVICE_WORKSPACE_WIRE_BYTES];
+    struct stat before;
+    struct stat after;
+    int seals;
+    int final_seals;
+    int result;
+
+    if (fd < 0 || !view) {
+        return -EINVAL;
+    }
+    if (fstat(fd, &before) < 0) {
+        return -errno;
+    }
+    if (!S_ISREG(before.st_mode) ||
+        before.st_size < QEMU_CRUCIBLE_WORKSPACE_SETUP_HEADER_BYTES ||
+        (uint64_t)before.st_size > QEMU_CRUCIBLE_WORKSPACE_SETUP_TOTAL_MAX) {
+        return -EINVAL;
+    }
+    seals = fcntl(fd, F_GET_SEALS);
+    if (seals < 0) {
+        return -errno;
+    }
+    if ((seals & required_seals) != required_seals) {
+        return -EPERM;
+    }
+
+    result = crucible_workspace_pread_exact(fd, header, sizeof(header), 0);
+    if (result != 0) {
+        return result;
+    }
+    result = crucible_workspace_setup_header_decode(
+        header, (uint64_t)before.st_size, &decoded);
+    if (result != 0) {
+        return result;
+    }
+
+    /* The checked equation bounds both record extents inside this file. */
+    if (decoded.workspace_bytes != 0) {
+        result = crucible_workspace_pread_exact(
+            fd, record, decoded.workspace_bytes, decoded.workspace_offset);
+        if (result != 0) {
+            return result;
+        }
+        result = qemu_crucible_device_workspace_decode(
+            record, decoded.workspace_bytes, &decoded.workspace);
+        if (result != 0) {
+            return result;
+        }
+    }
+    if (decoded.startup_bytes != 0) {
+        result = crucible_workspace_pread_exact(
+            fd, record, decoded.startup_bytes, decoded.startup_offset);
+        if (result != 0) {
+            return result;
+        }
+        result = qemu_crucible_original_startup_decode(
+            record, decoded.startup_bytes, &decoded.startup);
+        if (result != 0) {
+            return result;
+        }
+    }
+    if (!crucible_workspace_setup_records_match(&decoded)) {
+        return -EINVAL;
+    }
+
+    if (fstat(fd, &after) < 0) {
+        return -errno;
+    }
+    final_seals = fcntl(fd, F_GET_SEALS);
+    if (final_seals < 0) {
+        return -errno;
+    }
+    if (before.st_dev != after.st_dev || before.st_ino != after.st_ino ||
+        before.st_mode != after.st_mode || before.st_size != after.st_size ||
+        seals != final_seals) {
+        return -ESTALE;
+    }
+
+    *view = decoded;
+    return 0;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+bool qemu_crucible_device_workspace_disarm_status_matches(
+    const struct qemu_plugin_crucible_hot_fork_child_plan *plan,
+    const struct qemu_plugin_crucible_hot_fork_child_status *status)
+{
+    if (!plan || !status ||
+        plan->schema_version !=
+            QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PLAN_VERSION ||
+        plan->struct_size != sizeof(*plan) ||
+        plan->flags != 0 || plan->reserved != 0 || plan->reserved_fd != -1 ||
+        plan->workspace_reserved != 0 ||
+        plan->parent_process_generation == 0 ||
+        plan->parent_process_generation == UINT64_MAX ||
+        plan->child_process_generation !=
+            plan->parent_process_generation + 1 ||
+        plan->template_generation == 0 ||
+        plan->plugin_barrier_generation == 0) {
+        return false;
+    }
+
+    if (status->schema_version !=
+            QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_STATUS_VERSION ||
+        status->struct_size != sizeof(*status) ||
+        status->flags !=
+            QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_WORKSPACE_DISARMED ||
+        status->phase != QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PHASE_TEMPLATE ||
+        status->parent_process_generation != plan->parent_process_generation ||
+        status->child_process_generation != plan->child_process_generation ||
+        status->template_generation != plan->template_generation ||
+        status->plugin_barrier_generation != plan->plugin_barrier_generation) {
+        return false;
+    }
+
+    return status->private_ring_generation == 0 &&
+        status->plugin_endpoint_generation == 0 &&
+        status->control_socket_cookie == 0 && status->wake_eventfd_id == 0 &&
+        status->source_mapping_start == 0 &&
+        status->source_mapping_length == 0 &&
+        status->source_mapping_offset == 0 &&
+        status->worker_mask == 0 && status->parked_worker_mask == 0 &&
+        status->pending_worker_mask == 0 &&
+        status->worker_operations_in_flight == 0 &&
+        status->account_generation == 0 && status->workspace_generation == 0 &&
+        status->workspace_device == 0 && status->workspace_inode == 0 &&
+        status->workspace_length == 0 && status->workspace_fd == -1 &&
+        status->workspace_reserved == 0;
+}
diff --git a/plugins/crucible-device-workspace.inc.h b/plugins/crucible-device-workspace.inc.h
new file mode 100644
index 0000000000000000000000000000000000000000..c3c98bd96b159f52934106191d7bd4bec090256d
--- /dev/null
+++ b/plugins/crucible-device-workspace.inc.h
@@ -0,0 +1,410 @@
+/*
+ * Source-owned mapping of the distinct prepaid workspace role
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * These methods govern physical constructor custody only. They lend no digest
+ * buffer, worker membership, Park epoch or operating Original.
+ */
+
+#ifdef CONFIG_LINUX
+static int workspace_mapping_identity(QemuCrucibleDeviceWorkspaceMapping *mapping)
+{
+    if (!qatomic_load_acquire(&startup_source.module_custody_published) ||
+        mapping != &startup_source.workspace_mapping || !startup_owner()) {
+        return -EPERM;
+    }
+    if (!mapping->attempted || !mapping->held ||
+        mapping->role != startup_source.workspace_role ||
+        mapping->process != startup_source.owner_process ||
+        mapping->installer.ctx != startup_source.saved.ctx ||
+        mapping->installer.module != startup_source.saved.module ||
+        mapping->installer.install != startup_source.saved.install ||
+        mapping->fixed_native_extent != startup_source.metadata_partition.fixed_native_extent ||
+        mapping->fixed_storage_bytes != sizeof(startup_source.workspace_mapping) ||
+        !startup_source.checkpoint_storage.fixed_charge.held) {
+        return -ESTALE;
+    }
+    return 0;
+}
+#endif
+
+int qemu_plugin_crucible_startup_workspace_mapping_create_v1(
+    qemu_plugin_id_t id, QemuCrucibleDeviceWorkspaceMapping **out,
+    void **address, size_t *bytes)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleDeviceWorkspaceMapping *mapping = &startup_source.workspace_mapping;
+    QemuCrucibleWorkspacePurposeObservation role;
+    void *mapped;
+    int status;
+
+    if (!startup_invocation(id)) {
+        return -EPERM;
+    }
+    if (!out || !address || !bytes ||
+        callback_child_output_overlap(out, sizeof(*out), address, sizeof(*address)) ||
+        callback_child_output_overlap(out, sizeof(*out), bytes, sizeof(*bytes)) ||
+        callback_child_output_overlap(address, sizeof(*address), bytes, sizeof(*bytes)) ||
+        callback_child_output_overlap(out, sizeof(*out), &startup_source, sizeof(startup_source)) ||
+        callback_child_output_overlap(address, sizeof(*address), &startup_source, sizeof(startup_source)) ||
+        callback_child_output_overlap(bytes, sizeof(*bytes), &startup_source, sizeof(startup_source)) ||
+        *out || *address || *bytes) {
+        return -EINVAL;
+    }
+    if (mapping->attempted) {
+        return -EALREADY;
+    }
+    if (!startup_source.workspace_role) {
+        return -ENOENT;
+    }
+    status = startup_active(id);
+    if (!status && (!startup_source.checkpoint_storage.fixed_charge.held ||
+                   startup_source.metadata_partition.fixed_native_extent !=
+                       qemu_crucible_startup_source_fixed_control_extent())) {
+        status = -ENOKEY;
+    }
+    if (!status) {
+        status = qemu_crucible_preexec_workspace_current_v1(
+            startup_source.workspace_role, &role);
+    }
+    if (status) {
+        return status;
+    }
+    if (role.contract != startup_source.process_contract_owner ||
+        role.incarnation != startup_source.incarnation_purpose_owner ||
+        role.process_generation != startup_source.original.process_generation ||
+        role.account_generation != startup_source.standing.initial.account_generation ||
+        role.allocation_extent != QEMU_CRUCIBLE_PROCESS_WORKSPACE_ALLOCATION_BYTES ||
+        role.allocation_extent > SIZE_MAX) {
+        return -ESTALE;
+    }
+    /* Both the complete inline metadata and this distinct backing share were
+     * protected before their births. No second native debit copies the share. */
+    *mapping = (QemuCrucibleDeviceWorkspaceMapping) {
+        .role = startup_source.workspace_role,
+        .installer = startup_source.saved,
+        .holder = &mapping->creation_owner,
+        .descriptor = role.descriptor,
+        .request_bytes = role.allocation_extent,
+        .fixed_storage_bytes = sizeof(startup_source.workspace_mapping),
+        .fixed_native_extent = startup_source.metadata_partition.fixed_native_extent,
+        .process = startup_source.owner_process,
+        .attempted = true,
+        .held = true,
+        .transition_active = true,
+    };
+    qemu_mutex_init(&mapping->mutex);
+    mapping->creation_owner = mapping;
+    *out = mapping;
+
+    status = startup_process_purpose_live();
+    if (!status) {
+        mapping->mmap_attempted = true;
+        mapped = mmap(NULL, mapping->request_bytes, PROT_READ | PROT_WRITE,
+                      MAP_SHARED, mapping->descriptor, 0);
+        mapping->mmap_returned = true;
+        if (mapped == MAP_FAILED) {
+            status = -errno;
+        } else {
+            /* Retain the actual VMA and output before DONTFORK or post. */
+            mapping->address = mapped;
+            mapping->mapped = true;
+            *address = mapped;
+            *bytes = mapping->request_bytes;
+            if (!mapped) {
+                status = -EFAULT;
+            } else if (madvise(mapped, mapping->request_bytes, MADV_DONTFORK) < 0) {
+                status = -errno;
+            } else {
+                mapping->dontfork = true;
+            }
+        }
+    }
+    qemu_mutex_lock(&mapping->mutex);
+    mapping->first_status = status;
+    qemu_mutex_unlock(&mapping->mutex);
+    /* No ledger/mapping mutex covers the independent Original query. */
+    status = startup_process_purpose_live();
+    qemu_mutex_lock(&mapping->mutex);
+    mapping->post_status = status;
+    if (mapping->held && mapping->creation_owner == mapping &&
+        mapping->holder == &mapping->creation_owner) {
+        mapping->transition_active = false;
+    }
+    status = mapping->first_status ? mapping->first_status : mapping->post_status;
+    qemu_mutex_unlock(&mapping->mutex);
+    if (status) {
+        startup_failure(status);
+    }
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_startup_workspace_mapping_current_v1(
+    qemu_plugin_id_t id, QemuCrucibleDeviceWorkspaceMapping *mapping)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleWorkspacePurposeObservation role;
+    bool commands_locked;
+    int status = workspace_mapping_identity(mapping);
+
+    if (status || id != startup_source.saved.plugin_id) {
+        return status ? status : -EPERM;
+    }
+    commands_locked = qatomic_load_acquire(&startup_source.commands.initialized);
+    if (commands_locked) {
+        qemu_mutex_lock(&startup_source.commands.mutex);
+    }
+    qemu_mutex_lock(&mapping->mutex);
+    if (mapping->transferred) {
+        QemuCrucibleCallbackChildOwner *parent = &startup_source.callbacks.owner;
+        uintptr_t field = (uintptr_t)mapping->holder;
+
+        status = callback_child_owner_identity_locked(parent);
+        if (!status && (mapping->child_owner != parent || !parent->workspace_users ||
+                        mapping->runtime != parent->runtime ||
+                        mapping->runtime_base != parent->runtime_base ||
+                        mapping->runtime_extent != parent->runtime_extent ||
+                        !mapping->runtime_base || mapping->runtime_extent < sizeof(*mapping->holder) ||
+                        mapping->runtime_extent > UINTPTR_MAX - mapping->runtime_base ||
+                        field < mapping->runtime_base ||
+                        field % _Alignof(QemuCrucibleDeviceWorkspaceMapping *) ||
+                        field - mapping->runtime_base > mapping->runtime_extent - sizeof(*mapping->holder) ||
+                        *mapping->holder != mapping)) {
+            status = -ESTALE;
+        }
+    } else if (mapping->holder != &mapping->creation_owner ||
+               mapping->creation_owner != mapping) {
+        status = -ESTALE;
+    }
+    if (!status && (mapping->transition_active || mapping->closing || !mapping->mapped ||
+        !mapping->dontfork || mapping->unmap_attempted ||
+        mapping->first_status || mapping->post_status)) {
+        status = -ESTALE;
+    }
+    qemu_mutex_unlock(&mapping->mutex);
+    if (commands_locked) {
+        qemu_mutex_unlock(&startup_source.commands.mutex);
+    }
+    if (!status) {
+        status = qemu_crucible_preexec_workspace_current_v1(mapping->role, &role);
+    }
+    if (!status && (role.descriptor != mapping->descriptor ||
+                    role.allocation_extent != mapping->request_bytes)) {
+        status = -ESTALE;
+    }
+    /* Physical metadata current only; no mutable workspace borrower is issued. */
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_startup_workspace_mapping_identity_return_v1(
+    qemu_plugin_id_t id, QemuCrucibleDeviceWorkspaceMapping **holder)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleDeviceWorkspaceMapping *mapping = &startup_source.workspace_mapping;
+    bool unmap = false;
+    bool commands_locked = qatomic_load_acquire(&startup_source.commands.initialized);
+    int status = workspace_mapping_identity(mapping);
+
+    if (status || id != startup_source.saved.plugin_id || !holder) {
+        return status ? status : -EPERM;
+    }
+    if (commands_locked) {
+        qemu_mutex_lock(&startup_source.commands.mutex);
+    }
+    qemu_mutex_lock(&mapping->mutex);
+    if (mapping->transition_active) {
+        status = -EBUSY;
+    } else if (mapping->transferred) {
+        QemuCrucibleFingerprintWorker *worker = &startup_source.fingerprint_worker;
+
+        /* A worker's real control owner, physical pthread and byte/material
+         * loans all pin this original mapping. Geometry never selects a
+         * worker, and the absence of a producer remains refusal. */
+        if (!worker->native.attempted || !worker->native.physical_returned ||
+            worker->native.pins_held ||
+            mapping->worker || fingerprint_materials_held() ||
+            mapping->holder != holder || *holder != mapping ||
+            !mapping->child_owner || !mapping->child_owner->workspace_users) {
+            status = -EBUSY;
+        } else {
+            mapping->transition_active = true;
+            mapping->closing = true;
+            if (mapping->mapped && !mapping->unmap_attempted) {
+                mapping->unmap_attempted = true;
+                unmap = true;
+            }
+        }
+    } else if (mapping->holder != &mapping->creation_owner ||
+               mapping->creation_owner != mapping || *holder != mapping) {
+        status = -ESTALE;
+    } else if (mapping->unmap_uncertain) {
+        status = mapping->unmap_status ? mapping->unmap_status : -EIO;
+    } else if (mapping->mmap_attempted && !mapping->mmap_returned) {
+        status = -EBUSY;
+    } else {
+        mapping->transition_active = true;
+        mapping->closing = true;
+        if (mapping->mapped && !mapping->unmap_attempted) {
+            mapping->unmap_attempted = true;
+            unmap = true;
+        }
+    }
+    qemu_mutex_unlock(&mapping->mutex);
+    if (commands_locked) {
+        qemu_mutex_unlock(&startup_source.commands.mutex);
+    }
+    if (status) {
+        return status;
+    }
+    if (unmap) {
+        int result = munmap(mapping->address, mapping->request_bytes);
+        int saved_errno = result < 0 ? errno : 0;
+
+        qemu_mutex_lock(&mapping->mutex);
+        mapping->unmap_status = result < 0 ? -saved_errno : 0;
+        mapping->unmap_uncertain = result < 0;
+        mapping->physical_returned = result == 0;
+        qemu_mutex_unlock(&mapping->mutex);
+    } else {
+        mapping->physical_returned = !mapping->mapped || mapping->physical_returned;
+    }
+    status = mapping->unmap_status;
+    if (!status && mapping->physical_returned) {
+        status = qemu_crucible_preexec_workspace_identity_return_v1(
+            &startup_source.workspace_role);
+    }
+    if (commands_locked) {
+        qemu_mutex_lock(&startup_source.commands.mutex);
+    }
+    qemu_mutex_lock(&mapping->mutex);
+    mapping->return_status = status;
+    if (!status && mapping->physical_returned && !startup_source.workspace_role &&
+        *holder == mapping &&
+        ((mapping->holder == &mapping->creation_owner &&
+          mapping->creation_owner == mapping) || mapping->holder == holder)) {
+        if (mapping->transferred) {
+            /* Return runs on the original Source owner after every worker
+             * borrower joins. No child return can race this final field. */
+            mapping->child_owner->workspace_users--;
+            mapping->child_owner = NULL;
+        }
+        *holder = NULL;
+        mapping->creation_owner = NULL;
+        mapping->holder = NULL;
+        mapping->held = false;
+    }
+    mapping->transition_active = false;
+    qemu_mutex_unlock(&mapping->mutex);
+    if (commands_locked) {
+        qemu_mutex_unlock(&startup_source.commands.mutex);
+    }
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_startup_workspace_mapping_transfer_v1(
+    qemu_plugin_id_t id, QemuCrucibleStartupRuntimePurpose *runtime,
+    QemuCrucibleDeviceWorkspaceMapping **projection,
+    QemuCrucibleDeviceWorkspaceMapping **runtime_field)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleDeviceWorkspaceMapping *mapping = &startup_source.workspace_mapping;
+    QemuCrucibleCallbackChildOwner *parent = &startup_source.callbacks.owner;
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    uintptr_t field = (uintptr_t)runtime_field;
+    int status = command_registry_identity(id);
+    int post = 0;
+
+    if (!status) {
+        status = workspace_mapping_identity(mapping);
+    }
+
+    if (status || !startup_invocation(id) || !projection || !runtime_field ||
+        projection == runtime_field) {
+        return status ? status : -EPERM;
+    }
+    qemu_mutex_lock(&mapping->mutex);
+    if (mapping->transition_active || mapping->transferred || mapping->closing ||
+        mapping->first_status || mapping->post_status ||
+        mapping->holder != &mapping->creation_owner || mapping->creation_owner != mapping) {
+        status = -EBUSY;
+    } else {
+        mapping->transition_active = true;
+    }
+    qemu_mutex_unlock(&mapping->mutex);
+    if (status) {
+        return status;
+    }
+    status = startup_runtime_admission(id, runtime);
+    if (!status) {
+        qemu_mutex_lock(&commands->mutex);
+        status = callback_registration_owner_live_locked(parent);
+        if (!status && (parent->runtime != runtime ||
+                        parent->workspace_users == UINT64_MAX ||
+                        !parent->runtime_base || parent->runtime_extent < sizeof(*runtime_field) ||
+                        parent->runtime_extent > UINTPTR_MAX - parent->runtime_base ||
+                        field < parent->runtime_base ||
+                        field % _Alignof(QemuCrucibleDeviceWorkspaceMapping *) ||
+                        field - parent->runtime_base > parent->runtime_extent - sizeof(*runtime_field) ||
+                        callback_child_output_conflicts_locked(projection, sizeof(*projection)) ||
+                        callback_child_output_conflicts_locked(runtime_field, sizeof(*runtime_field)) ||
+                        callback_child_output_overlap(projection, sizeof(*projection),
+                                                      runtime_field, sizeof(*runtime_field)))) {
+            status = -EINVAL;
+        }
+        qemu_mutex_lock(&mapping->mutex);
+        if (!status && (!mapping->held || !mapping->transition_active ||
+                        mapping->holder != &mapping->creation_owner ||
+                        mapping->creation_owner != mapping || *projection != mapping ||
+                        *runtime_field)) {
+            status = -ESTALE;
+        }
+        if (!status) {
+            /* The genuine child authenticates the prepaid Runtime. Move its
+             * stable field and retain the actual parent before the post. */
+            parent->workspace_users++;
+            *runtime_field = mapping;
+            *projection = NULL;
+            mapping->creation_owner = NULL;
+            mapping->holder = runtime_field;
+            mapping->runtime = runtime;
+            mapping->child_owner = parent;
+            mapping->runtime_base = parent->runtime_base;
+            mapping->runtime_extent = parent->runtime_extent;
+            mapping->transferred = true;
+        }
+        qemu_mutex_unlock(&mapping->mutex);
+        qemu_mutex_unlock(&commands->mutex);
+    }
+    if (!status) {
+        post = startup_runtime_admission(id, runtime);
+    }
+    qemu_mutex_lock(&mapping->mutex);
+    if (status && !mapping->first_status) {
+        mapping->first_status = status;
+    }
+    if (post && !mapping->post_status) {
+        mapping->post_status = post;
+    }
+    /* A mismatch retains the transition hold and both parents. */
+    if (mapping->held &&
+        ((mapping->transferred && mapping->holder == runtime_field &&
+          mapping->runtime == runtime && *runtime_field == mapping) ||
+         (!mapping->transferred && mapping->holder == &mapping->creation_owner &&
+          mapping->creation_owner == mapping))) {
+        mapping->transition_active = false;
+    }
+    qemu_mutex_unlock(&mapping->mutex);
+    return status ? status : post;
+#else
+    return -ENOTSUP;
+#endif
+}
