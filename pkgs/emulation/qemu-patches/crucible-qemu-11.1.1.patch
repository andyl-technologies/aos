+static int load_hpet(HPETState *state, QIOChannelBuffer *input,
+                     const VMStateDescription *description)
+{
+    QEMUFile *file = qemu_file_new_input(QIO_CHANNEL(input));
+    Error *error = NULL;
+    int result = vmstate_load_state(file, description, state,
+                                    description->version_id, &error);
+
+    if (result < 0) {
+        g_assert_nonnull(error);
+        error_free(error);
+    } else {
+        g_assert_null(error);
+    }
+    qemu_fclose(file);
+    object_unref(OBJECT(input));
+    return result;
