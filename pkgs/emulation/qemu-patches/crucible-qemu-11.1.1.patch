+static void test_mutex_registry_capacity_failure_is_sticky(void)
+{
+    if (g_test_subprocess()) {
+        QemuMutexHotForkInventory before;
+        QemuMutexHotForkInventory full;
+        QemuMutexHotForkInventory underfull;
+        QemuMutexHotForkInventory replenished;
+        RegistryWorkerThread monitor_worker;
+        QemuMutex *mutexes;
+        size_t allocation_count;
+        size_t index;
+
+        start_registry_worker_thread(&monitor_worker, "IO mon_iothread",
+                                     monitor_registry_worker);
+        qemu_mutex_hot_fork_inventory(&before);
+        g_assert_false(before.overflowed);
+        g_assert_cmpuint(before.entry_count, <,
+                         QEMU_HOT_FORK_MUTEX_INVENTORY_MAX);
+        allocation_count =
+            QEMU_HOT_FORK_MUTEX_INVENTORY_MAX - before.entry_count + 1;
+        mutexes = g_new0(QemuMutex, allocation_count);
+
+        for (index = 0; index < allocation_count; index++) {
+            qemu_mutex_init(&mutexes[index]);
+        }
+        g_assert_cmpuint(
+            mutexes[allocation_count - 1].crucible_hot_fork_registration_id,
+            ==, 0);
+        g_assert_cmpuint(
+            mutexes[allocation_count - 1].crucible_hot_fork_slot,
+            ==, UINT32_MAX);
+        qemu_mutex_lock(&mutexes[allocation_count - 1]);
+        qemu_mutex_unlock(&mutexes[allocation_count - 1]);
+
+        qemu_mutex_hot_fork_inventory(&full);
+        g_assert_true(full.overflowed);
+        g_assert_cmpuint(full.entry_count, ==,
+                         QEMU_HOT_FORK_MUTEX_INVENTORY_MAX);
+        qemu_mutex_hot_fork_inventory_destroy(&full);
+        qemu_mutex_hot_fork_inventory_destroy(&before);
+
+        qemu_mutex_destroy(&mutexes[0]);
+        qemu_mutex_hot_fork_inventory(&underfull);
+        g_assert_true(underfull.overflowed);
+        g_assert_cmpuint(underfull.entry_count, ==,
+                         QEMU_HOT_FORK_MUTEX_INVENTORY_MAX - 1);
+        qemu_mutex_hot_fork_inventory_destroy(&underfull);
+        assert_mutex_registry_preflight_stays_blocked();
+
+        qemu_mutex_init(&mutexes[0]);
+        qemu_mutex_lock(&mutexes[0]);
+        qemu_mutex_unlock(&mutexes[0]);
+        qemu_mutex_hot_fork_inventory(&replenished);
+        g_assert_true(replenished.overflowed);
+        g_assert_cmpuint(replenished.entry_count, ==,
+                         QEMU_HOT_FORK_MUTEX_INVENTORY_MAX);
+        qemu_mutex_hot_fork_inventory_destroy(&replenished);
+        assert_mutex_registry_preflight_stays_blocked();
+        return;
+    }
+
+    g_test_trap_subprocess(NULL, 0, 0);
+    g_test_trap_assert_passed();
+}
