+    report->fingerprint_worker = (manifest->worker_mask &
+        QEMU_PLUGIN_CRUCIBLE_WORKER_FINGERPRINT) != 0;
+    report->app_random = (manifest->resource_mask &
+        QEMU_PLUGIN_CRUCIBLE_RESOURCE_APP_RANDOM) != 0;
+    return report;
 }
 
