+        'f658061c35d98fc7acebc07a34f9369fbee97758df929a6745293c7f5aabe91f',
+}
+
+FUNCTIONS = (
+    "static int checkpoint_placement_fail(",
+    "static int checkpoint_placement_current(",
+    "int qemu_crucible_checkpoint_main_loop_current(",
+    "int qemu_crucible_checkpoint_placement_bind_v1(",
+    "static int checkpoint_placement_notify(",
+    "int qemu_crucible_checkpoint_placement_detach_v1(",
+    "int qemu_crucible_checkpoint_placement_observe_v1(",
+    "int qemu_crucible_checkpoint_placement_restore_v1(",
+    "static void crucible_ram_execute_scheduled(",
+    "int qemu_plugin_crucible_ram_child_runtime_ready_v1(",
+    "uint64_t qemu_crucible_ram_main_loop_metadata_bytes(",
+    "int qemu_crucible_ram_schedule_on_main_loop(",
+    "int qemu_crucible_ram_cancel_scheduled_main_loop(",
+)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("root", type=Path)
+    parser.add_argument("output", type=Path)
+    parser.add_argument("--negative-control", choices=[
+        "omit-held-schedule", "omit-stop-generation", "renew-restored-generation",
+        "omit-dispatch-gate",
+    ])
+    args = parser.parse_args()
