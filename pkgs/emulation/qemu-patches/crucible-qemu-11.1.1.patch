+static void scenario_setup_layout_is_not_a_mapping_owner(void)
+{
+    struct crucible_shmem_region_header header = { 0 };
+    QemuCrucibleSetupMappingOwner scratch = { 0 };
+    QemuCrucibleSharedRegionLayout layout;
+
+    g_assert_cmpint(qemu_crucible_shared_region_layout_compute(1, 64,
+        CRUCIBLE_FAULT_DEFAULT_PAYLOAD_ARENA_BYTES, &layout), ==, 0);
+    qatomic_set(&header.magic, cpu_to_le64(CRUCIBLE_SHMEM_REGION_MAGIC));
+    qatomic_set(&header.abi_version, cpu_to_le32(CRUCIBLE_SHMEM_ABI_VERSION));
+    qatomic_set(&header.node_count, cpu_to_le32(CRUCIBLE_SHMEM_MAX_NODES));
+    qatomic_set(&header.queue_capacity, cpu_to_le32(64));
+    qatomic_set(&header.ring_count, cpu_to_le32(6));
+    qatomic_set(&header.ring_hdr_off, cpu_to_le64(layout.frame_ring_headers_offset));
+    qatomic_set(&header.ring_data_off, cpu_to_le64(layout.frame_ring_data_offset));
+    qatomic_set(&header.entry_stride, cpu_to_le64(CRUCIBLE_SHMEM_FRAME_ENTRY_SIZE));
+    qatomic_set(&header.region_size, cpu_to_le64(layout.region_extent));
+    qatomic_set(&header.ticks_per_ns, cpu_to_le32(CRUCIBLE_SHMEM_TICKS_PER_NS));
+    qatomic_set(&header.fault_payload_arena_bytes,
+        cpu_to_le32(CRUCIBLE_FAULT_DEFAULT_PAYLOAD_ARENA_BYTES));
+
+    /* This scratch tests metadata only: it is not a VMA, a Source-issued
+     * holder, a DONTFORK proof or admission to any of the physical slots. */
+    scratch.address = &header;
+    scratch.request_bytes = layout.region_extent;
+    scratch.mapped = true;
+    scratch.dontfork = true;
+    g_assert_cmpint(setup_mapping_header_current(&scratch), ==, 0);
+    g_assert_cmpint(qemu_plugin_crucible_startup_setup_mapping_current_v1(
+        0, &scratch), ==, -EPERM);
+
+    header.reserved[0] = 1;
+    g_assert_cmpint(setup_mapping_header_current(&scratch), ==, -EPROTONOSUPPORT);
+    header.reserved[0] = 0;
+    qatomic_set(&header.region_size, cpu_to_le64(layout.region_extent - 1));
+    g_assert_cmpint(setup_mapping_header_current(&scratch), ==, -ESTALE);
+    g_assert_cmpint(qemu_crucible_shared_region_layout_compute(1, 3,
+        CRUCIBLE_FAULT_DEFAULT_PAYLOAD_ARENA_BYTES, &layout), ==, -EINVAL);
+}
