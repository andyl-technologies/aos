+            }
+            *post_status = mon->crucible_stop_return_post_status;
+            return status;
+        }
+    }
+    *first_status = mon->crucible_stop_return_first_status;
+    *post_status = mon->crucible_stop_return_post_status;
+    mon->crucible_stop_returning = false;
+    *journal_monitor = NULL;
+    object_unref(OBJECT(mon));
+    return 0;
+}
