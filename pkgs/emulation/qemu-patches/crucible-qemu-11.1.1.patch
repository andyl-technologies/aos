+#include "crucible-preexec-artifact.inc.h"
+
+/* The launcher environment is a genuine exec-owned, terminated string vector.
+ * It selects receive/refusal only. Environment/loader extent is not paid by
+ * this scan or by any decoded TOTAL; closed launch geometry remains absent.
+ */
+static int preexec_setup_selection(char *const *environment)
+{
+    static const char name[] = QEMU_CRUCIBLE_PREEXEC_SETUP_SELECTOR;
+    bool found = false;
+
+    _Static_assert(sizeof(QEMU_CRUCIBLE_PREEXEC_SETUP_SELECTOR_V5) == 2,
+                   "the preexec edition selector must be one byte");
+
+    for (size_t row = 0; environment && environment[row]; row++) {
+        const volatile char *entry = environment[row];
+        size_t column = 0;
+
+        while (column < sizeof(name) - 1 && entry[column] == name[column]) {
+            column++;
+        }
+        if (column != sizeof(name) - 1 || entry[column] != '=') {
+            continue;
+        }
+        if (found ||
+            (entry[column + 1] != QEMU_CRUCIBLE_PREEXEC_SETUP_SELECTOR_V5[0] &&
+             entry[column + 1] != QEMU_CRUCIBLE_PREEXEC_SETUP_SELECTOR_V6[0]) ||
+            entry[column + 2] != '\0') {
+            return -EINVAL;
+        }
+        found = true;
+        preexec_setup_owner.selected_edition = entry[column + 1] - '0';
+    }
+    return found ? 1 : 0;
+}
+
+static bool preexec_setup_text_equal(const char *text, size_t bytes,
+                                     const char *expected, size_t expected_bytes)
+{
+    if (bytes != expected_bytes) {
+        return false;
+    }
+    for (size_t index = 0; index < bytes; index++) {
+        if (text[index] != expected[index]) {
+            return false;
+        }
+    }
+    return true;
+}
+
+/* QemuOpts treats the first value as implied "file" only when it has no '='.
+ * Its value parser unescapes doubled commas; selected pathnames contain no
+ * comma. Subsequent bare "nofile" is also a file selector, not a plugin option.
+ * Values may contain escaped commas or the text "file=" without selecting a
+ * different module. No pathname is published until the complete scan passes.
+ */
+static int preexec_setup_plugin_path(int argc, char *const *argv,
+                                     char path[QEMU_CRUCIBLE_PREEXEC_PLUGIN_PATH_BYTES])
+{
+    const char *argument = NULL;
+    size_t argument_bytes = 0;
+    size_t path_bytes = 0;
+
+    if (argc < 1 || !argv || !path) {
+        return -EINVAL;
+    }
+    for (int index = 1; index < argc; index++) {
+        const char *token = argv[index];
+        size_t bytes = 0;
+
+        if (!token) {
+            return -EINVAL;
+        }
+        while (bytes < QEMU_CRUCIBLE_PREEXEC_PLUGIN_ARGUMENT_BYTES &&
+               token[bytes]) {
+            bytes++;
+        }
+        if (bytes == QEMU_CRUCIBLE_PREEXEC_PLUGIN_ARGUMENT_BYTES) {
+            return -E2BIG;
+        }
+        if (preexec_setup_text_equal(token, bytes, "-plugin", 7)) {
+            if (argument || ++index == argc || !argv[index]) {
+                return -EINVAL;
+            }
+            argument = argv[index];
+        } else if ((bytes >= 8 &&
+                    preexec_setup_text_equal(token, 8, "-plugin=", 8)) ||
+                   (bytes >= 8 &&
+                    preexec_setup_text_equal(token, 8, "--plugin", 8))) {
+            return -EINVAL;
+        }
+    }
+    if (!argument || argument[0] != '/') {
+        return -EINVAL;
+    }
+    while (argument_bytes < QEMU_CRUCIBLE_PREEXEC_PLUGIN_ARGUMENT_BYTES &&
+           argument[argument_bytes]) {
+        argument_bytes++;
+    }
+    if (argument_bytes == QEMU_CRUCIBLE_PREEXEC_PLUGIN_ARGUMENT_BYTES) {
+        return -E2BIG;
+    }
+    while (path_bytes < argument_bytes && argument[path_bytes] != ',') {
+        if (argument[path_bytes] == '=') {
+            return -EINVAL;
+        }
+        path_bytes++;
+    }
+    if (path_bytes < 2 ||
+        path_bytes >= QEMU_CRUCIBLE_PREEXEC_PLUGIN_PATH_BYTES ||
+        (path_bytes < argument_bytes && argument[path_bytes + 1] == ',')) {
+        return -EINVAL;
+    }
+
+    for (size_t cursor = path_bytes; cursor < argument_bytes;) {
+        size_t name;
+        size_t name_bytes;
+        bool has_value;
+
+        /* The preceding value parser stopped at this single separator. */
+        cursor++;
+        name = cursor;
+        while (cursor < argument_bytes && argument[cursor] != ',' &&
+               argument[cursor] != '=') {
+            cursor++;
+        }
+        name_bytes = cursor - name;
+        has_value = cursor < argument_bytes && argument[cursor] == '=';
+        if (!name_bytes ||
+            preexec_setup_text_equal(argument + name, name_bytes, "file", 4) ||
+            (!has_value && preexec_setup_text_equal(argument + name, name_bytes,
+                                                    "nofile", 6))) {
+            return -EINVAL;
+        }
+        if (has_value) {
+            cursor++;
+            while (cursor < argument_bytes) {
+                if (argument[cursor] == ',') {
+                    if (cursor + 1 == argument_bytes ||
+                        argument[cursor + 1] != ',') {
+                        break;
+                    }
+                    cursor++;
+                }
+                cursor++;
+            }
+        }
+    }
+    for (size_t index = 0; index < path_bytes; index++) {
+        path[index] = argument[index];
+    }
+    path[path_bytes] = '\0';
+    return 0;
+}
+
+static int preexec_setup_socket_option(int option, int expected)
+{
+    int value = 0;
+    socklen_t length = sizeof(value);
+    long result;
+
+    result = preexec_setup_syscall5(
+        SYS_getsockopt, QEMU_CRUCIBLE_PREEXEC_SETUP_CONTROL_FD,
+        SOL_SOCKET, option, (long)(uintptr_t)&value, (long)(uintptr_t)&length);
+    if (result < 0) {
+        return (int)result;
+    }
+    return length == sizeof(value) && value == expected ? 0 : -EPROTOTYPE;
+}
+
+/* Parse only the kernel-returned fixed ancillary buffer. Unknown or truncated
+ * roster is retained as uncertain custody, not closed or repaired numerically.
+ * No received descriptor is duplicated, transferred or disposed here.
+ */
+static int preexec_setup_retain_ancillary(void)
+{
+    QemuCruciblePreexecSetupOwner *owner = &preexec_setup_owner;
+    size_t offset = 0;
+    int status = 0;
+
+    while (offset < owner->control_bytes) {
+        struct cmsghdr *header;
+        size_t bytes;
+        size_t payload;
+        size_t next;
+        const int *descriptors;
+
+        if (owner->control_bytes - offset < sizeof(struct cmsghdr)) {
+            return -EPROTO;
+        }
+        header = (struct cmsghdr *)(owner->ancillary.bytes + offset);
+        bytes = header->cmsg_len;
+        if (bytes < CMSG_LEN(0) || bytes > owner->control_bytes - offset) {
+            return -EPROTO;
+        }
+        if (header->cmsg_level == SOL_SOCKET && header->cmsg_type == SCM_RIGHTS) {
+            payload = bytes - CMSG_LEN(0);
+            if (payload == 0 || payload % sizeof(int)) {
+                return -EPROTO;
+            }
+            descriptors = (const int *)CMSG_DATA(header);
+            for (size_t index = 0; index < payload / sizeof(int); index++) {
+                if (owner->descriptor_count ==
+                    (owner->selected_edition == 6 ?
+                        QEMU_CRUCIBLE_PREEXEC_SETUP_V6_WORKSPACE_FDS :
+                        QEMU_CRUCIBLE_PREEXEC_SETUP_WORKSPACE_FDS)) {
+                    return -EOVERFLOW;
+                }
+                owner->descriptors[owner->descriptor_count++] = descriptors[index];
+            }
+        } else {
+            /* Keep walking a structurally valid kernel buffer so a later
+             * visible SCM roster is captured before this type refusal. */
+            status = -EPROTO;
+        }
+        next = CMSG_ALIGN(bytes);
+        if (next > owner->control_bytes - offset) {
+            if (bytes != owner->control_bytes - offset) {
+                return -EPROTO;
+            }
+            offset = owner->control_bytes;
+        } else {
+            offset += next;
+        }
+    }
+    owner->descriptor_roster_known = !status &&
+        !(owner->message_flags & MSG_CTRUNC);
+    if (status) {
+        return status;
+    }
+    return owner->descriptor_roster_known ? 0 : -EMSGSIZE;
+}
+
+static int preexec_setup_validate_frame(void)
+{
+    QemuCruciblePreexecSetupOwner *owner = &preexec_setup_owner;
+    const uint8_t *payload = owner->frame +
+        QEMU_CRUCIBLE_PREEXEC_SETUP_PAYLOAD_OFFSET;
+    uint32_t schema;
+    uint32_t flags;
+    uint64_t account;
+    uint64_t workspace;
+    uint64_t device;
+    uint64_t inode;
+    bool publisher = owner->frame[4] == QEMU_CRUCIBLE_PREEXEC_SETUP_TAG_V6;
+    size_t frame_bytes = publisher ? QEMU_CRUCIBLE_PREEXEC_SETUP_V6_FRAME_BYTES :
+                                    QEMU_CRUCIBLE_PREEXEC_SETUP_FRAME_BYTES;
+    size_t base_fds = publisher ? QEMU_CRUCIBLE_PREEXEC_SETUP_V6_BASE_FDS :
+                                 QEMU_CRUCIBLE_PREEXEC_SETUP_BASE_FDS;
+
+    if (owner->received_bytes != frame_bytes ||
+        (owner->message_flags & (MSG_TRUNC | MSG_CTRUNC))) {
+        return -EMSGSIZE;
+    }
+    if (preexec_setup_be32(owner->frame) != frame_bytes - 4 ||
+        (!publisher && owner->frame[4] != QEMU_CRUCIBLE_PREEXEC_SETUP_TAG_V5) ||
+        (owner->selected_edition && owner->selected_edition != (publisher ? 6 : 5))) {
+        return -EPROTONOSUPPORT;
+    }
+    if (publisher) {
+        for (size_t index = 56; index <= 96; index += 8) {
+            uint64_t value = preexec_setup_be64(payload + index);
+
+            if ((index == 56 || index >= 88) && (!value || value == UINT64_MAX)) {
+                return -EINVAL;
+            }
+        }
+        if (preexec_setup_be64(payload + 64) != 4096 ||
+            preexec_setup_be64(payload + 88) == preexec_setup_be64(payload + 96) ||
+            preexec_setup_be32(payload + 104) != 1 ||
+            preexec_setup_be32(payload + 108) != 1 ||
+            preexec_setup_be64(payload + 112)) {
+            return -EINVAL;
+        }
+    }
+    if (!preexec_setup_be64(payload +
+                           QEMU_CRUCIBLE_PREEXEC_SETUP_PROCESS_GENERATION_OFFSET)) {
+        return -EINVAL;
+    }
+    schema = preexec_setup_be32(payload +
+        QEMU_CRUCIBLE_PREEXEC_SETUP_WORKSPACE_SCHEMA_OFFSET);
+    flags = preexec_setup_be32(payload +
+        QEMU_CRUCIBLE_PREEXEC_SETUP_WORKSPACE_FLAGS_OFFSET);
+    account = preexec_setup_be64(payload +
+        QEMU_CRUCIBLE_PREEXEC_SETUP_ACCOUNT_GENERATION_OFFSET);
+    workspace = preexec_setup_be64(payload +
+        QEMU_CRUCIBLE_PREEXEC_SETUP_WORKSPACE_GENERATION_OFFSET);
+    device = preexec_setup_be64(payload +
+        QEMU_CRUCIBLE_PREEXEC_SETUP_WORKSPACE_DEVICE_OFFSET);
+    inode = preexec_setup_be64(payload +
+        QEMU_CRUCIBLE_PREEXEC_SETUP_WORKSPACE_INODE_OFFSET);
+
+    if (schema == QEMU_CRUCIBLE_PREEXEC_SETUP_WORKSPACE_ABSENT && flags == 0) {
+        return !account && !workspace && !device && !inode &&
+               owner->descriptor_count == base_fds ?
+               0 : -EINVAL;
+    }
+    if (schema == QEMU_CRUCIBLE_PREEXEC_SETUP_WORKSPACE_PRESENT &&
+        flags == QEMU_CRUCIBLE_PREEXEC_SETUP_WORKSPACE_FLAG) {
+        return account && workspace && owner->descriptor_count ==
+               base_fds + 1 ? 0 : -EINVAL;
+    }
+    return -EINVAL;
+}
+
+static int preexec_setup_receive_once(void)
+{
+    QemuCruciblePreexecSetupOwner *owner = &preexec_setup_owner;
+    long process = preexec_setup_syscall5(SYS_getpid, 0, 0, 0, 0, 0);
+    long thread = preexec_setup_syscall5(SYS_gettid, 0, 0, 0, 0, 0);
+    long received;
+    int status;
+
+    if (owner->attempted) {
+        if (owner->process_id != process || owner->thread_id != thread) {
+            return -EPERM;
+        }
+        return owner->first_status ? owner->first_status : -EALREADY;
+    }
+    owner->process_id = process;
+    owner->thread_id = thread;
+    owner->attempted = true;
+    {
+        struct {
+            uint64_t current;
+            uint64_t maximum;
+        } inherited;
+        long result = preexec_setup_syscall5(SYS_prlimit64, 0, RLIMIT_NOFILE, 0,
+            (long)(uintptr_t)&inherited, 0);
+
+        if (result < 0) {
+            return preexec_setup_fail((int)result);
+        }
+        /* This is the actual prebirth-enforced landing ceiling, before any
+         * received scalar is decoded. The fixed roster never expands it.
+         * Kernel enforcement contains concurrent descriptor allocation.
+         */
+        if (!inherited.current || inherited.current == UINT64_MAX ||
+            inherited.maximum != inherited.current ||
+            inherited.current < 3 + (owner->selected_edition == 6 ?
+                QEMU_CRUCIBLE_PREEXEC_SETUP_V6_WORKSPACE_FDS :
+                QEMU_CRUCIBLE_PREEXEC_SETUP_WORKSPACE_FDS)) {
+            return preexec_setup_fail(-EMFILE);
+        }
+        owner->inherited_descriptor_limit = inherited.current;
+    }
+
+    /* These existing inherited names are separate from the incoming SCM
+     * roster. Require them live before the kernel can allocate received aliases
+     * at those numbers. No flag mutation, dup, close or ownership donation.
+     * Exact original identity and paid overlap remain genuine issuer inputs.
+     */
+    for (size_t index = 0; index < 3; index++) {
+        long flags = preexec_setup_syscall5(
+            SYS_fcntl, QEMU_CRUCIBLE_PREEXEC_SETUP_CONTROL_FD + index,
+            F_GETFD, 0, 0, 0);
+
+        if (flags < 0) {
+            return preexec_setup_fail((int)flags);
+        }
+        owner->inherited_fd_flags[index] = (int)flags;
+    }
+    status = preexec_setup_socket_option(SO_DOMAIN, AF_UNIX);
+    if (!status) {
+        status = preexec_setup_socket_option(SO_TYPE, SOCK_STREAM);
+    }
+    if (status) {
+        return preexec_setup_fail(status);
+    }
+    owner->iov.iov_base = owner->frame;
+    owner->iov.iov_len = owner->selected_edition == 6 ?
+        QEMU_CRUCIBLE_PREEXEC_SETUP_V6_FRAME_BYTES :
+        QEMU_CRUCIBLE_PREEXEC_SETUP_FRAME_BYTES;
+    owner->message.msg_iov = &owner->iov;
+    owner->message.msg_iovlen = 1;
+    owner->message.msg_control = owner->ancillary.bytes;
+    owner->message.msg_controllen = owner->selected_edition == 6 ?
+        sizeof(owner->ancillary.bytes) :
+        CMSG_SPACE(QEMU_CRUCIBLE_PREEXEC_SETUP_WORKSPACE_FDS * sizeof(int));
+
+    received = preexec_setup_syscall5(
+        SYS_recvmsg, QEMU_CRUCIBLE_PREEXEC_SETUP_CONTROL_FD,
+        (long)(uintptr_t)&owner->message, MSG_DONTWAIT | MSG_CMSG_CLOEXEC, 0, 0);
+    owner->received_bytes = received;
+    owner->message_flags = owner->message.msg_flags;
+    owner->control_bytes = owner->message.msg_controllen;
+    if (received < 0) {
+        /* No retry, including EINTR. Raw input/control metadata stays retained. */
+        return preexec_setup_fail((int)received);
+    }
+    if (owner->control_bytes > sizeof(owner->ancillary.bytes)) {
+        return preexec_setup_fail(-EOVERFLOW);
+    }
+    status = preexec_setup_retain_ancillary();
+    if (!status) {
+        status = preexec_setup_validate_frame();
+    }
+    if (status) {
+        return preexec_setup_fail(status);
+    }
+    owner->frame_validated = true;
+    return 0;
+}
+
+/* Physical same-owner observation only. The eventual loader-qualified
+ * installer must additionally bind its exact ctx/module/install invocation and
+ * genuine purpose, then borrow these same arrays without receive or dup.
+ * Nothing here authenticates that still-unavailable installing boundary.
+ */
+static int preexec_setup_physical_borrow(QemuCruciblePreexecSetupBorrow *view)
+{
+    QemuCruciblePreexecSetupOwner *owner = &preexec_setup_owner;
+    long process = preexec_setup_syscall5(SYS_getpid, 0, 0, 0, 0, 0);
+    long thread = preexec_setup_syscall5(SYS_gettid, 0, 0, 0, 0, 0);
+
+    if (!owner->attempted || process != owner->process_id ||
+        thread != owner->thread_id) {
+        return -EPERM;
+    }
+    if (owner->first_status) {
+        return owner->first_status;
+    }
+    if (!owner->frame_validated) {
+        return -EINPROGRESS;
+    }
+    if (!view) {
+        return -EINVAL;
+    }
+    *view = (QemuCruciblePreexecSetupBorrow) {
+        .frame = owner->frame,
+        .frame_bytes = owner->received_bytes,
+        .descriptors = owner->descriptors,
+        .descriptor_count = owner->descriptor_count,
+    };
+    return 0;
+}
+
+static int preexec_standing_snapshot(QemuCrucibleStandingPurposeOwner *standing,
+                                    uint8_t *snapshot, uint64_t *sequence)
+{
+    uint64_t before = __atomic_load_n(standing->mapping, __ATOMIC_SEQ_CST);
+    uint8_t sequence_bytes[8];
+    uint64_t after;
+
+    preexec_setup_copy(sequence_bytes, &before, sizeof(before));
+    before = preexec_setup_be64(sequence_bytes);
+    if (!before || before == UINT64_MAX || (before & 1)) {
+        return -EAGAIN;
+    }
+    for (size_t index = 0; index < QEMU_CRUCIBLE_STANDING_PAYLOAD_BYTES / 8; index++) {
+        uint64_t word = __atomic_load_n(standing->mapping + index + 1, __ATOMIC_SEQ_CST);
+
+        preexec_setup_copy(snapshot + index * 8, &word, sizeof(word));
+    }
+    after = __atomic_load_n(standing->mapping, __ATOMIC_SEQ_CST);
+    preexec_setup_copy(sequence_bytes, &after, sizeof(after));
+    after = preexec_setup_be64(sequence_bytes);
+    if (before != after || after < standing->sequence) {
+        return -EAGAIN;
+    }
+    *sequence = after;
+    return 0;
+}
+
+static int preexec_contract_observation_read(
+    QemuCrucibleProcessContractObservation *observation,
+    int directory, const char *path, size_t *bytes);
+
+static int preexec_standing_event_observe(
+    int fd, QemuCrucibleProcessContractObservation *observation, uint64_t *token)
+{
+    char path[64] = "/proc/self/fdinfo/";
+    char digits[16];
+    size_t digit_count = 0;
+    size_t prefix = sizeof("/proc/self/fdinfo/") - 1;
+    size_t bytes;
+    unsigned number;
+    bool id_found = false;
+    bool mode_found = false;
+    uint64_t id = 0;
+    int status;
+
+    if (fd < 0) {
+        return -EBADF;
+    }
+    number = fd;
+    do {
+        digits[digit_count++] = '0' + number % 10;
+        number /= 10;
+    } while (number);
+    for (size_t index = 0; index < digit_count; index++) {
+        path[prefix + index] = digits[digit_count - index - 1];
+    }
+    path[prefix + digit_count] = 0;
+    status = preexec_contract_observation_read(observation, AT_FDCWD, path, &bytes);
+    if (status) {
+        return status;
+    }
+    for (size_t cursor = 0; cursor < bytes;) {
+        const char *names[2] = { "eventfd-id:", "eventfd-semaphore:" };
+        const size_t lengths[2] = { sizeof("eventfd-id:") - 1,
+                                   sizeof("eventfd-semaphore:") - 1 };
+        size_t end = cursor;
+
+        while (end < bytes && observation->bytes[end] != '\n') {
+            end++;
+        }
+        for (size_t field = 0; field < 2; field++) {
+            uint64_t value;
+            size_t position = cursor + lengths[field];
+
+            if (end - cursor < lengths[field] ||
+                preexec_setup_compare(observation->bytes + cursor, names[field],
+                                       lengths[field])) {
+                continue;
+            }
+            if (field == 0 ? id_found : mode_found) {
+                return -ESTALE;
+            }
+            while (position < end && (observation->bytes[position] == ' ' ||
+                                     observation->bytes[position] == '\t')) {
+                position++;
+            }
+            status = preexec_setup_decimal(observation->bytes, end, &position, &value);
+            if (status || position != end || (field == 0 ? value > INT_MAX : value != 0)) {
+                return status ? status : -EPERM;
+            }
+            if (field == 0) {
+                id = value;
+                id_found = true;
+            } else {
+                mode_found = true;
+            }
+        }
+        cursor = end + 1;
+    }
+    if (!id_found || !mode_found) {
+        return -EPROTOTYPE;
+    }
+    *token = id + 1;
+    return 0;
+}
+
+typedef struct PreexecStandingIdentitySnapshot {
+    struct stat artifact;
+    struct stat publication;
+    struct stat cancellation;
+    uint64_t event_token;
+} PreexecStandingIdentitySnapshot;
+
+static int preexec_standing_roles_observe(
+    QemuCrucibleStandingPurposeOwner *standing,
+    QemuCrucibleProcessContractObservation *observation,
+    PreexecStandingIdentitySnapshot *identity)
+{
+    QemuCruciblePreexecSetupOwner *owner = &preexec_setup_owner;
+    const QemuCrucibleStandingRecord *initial = &owner->plan.purpose.standing;
+    struct stat publication;
+    struct stat cancellation;
+    struct stat artifact;
+    uint64_t event_token;
+    long status;
+
+    if (standing != &owner->standing || standing->issuer != owner ||
+        !standing->attempted || !owner->fixed_family.source.retained ||
+        preexec_setup_syscall5(SYS_getpid, 0, 0, 0, 0, 0) != owner->process_id) {
+        return -EPERM;
+    }
+    status = preexec_setup_syscall5(SYS_fstat, standing->publication_fd,
+        (long)(uintptr_t)&publication, 0, 0, 0);
+    if (status < 0) {
+        return status;
+    }
+    if (!S_ISREG(publication.st_mode) ||
+        publication.st_size != QEMU_CRUCIBLE_STANDING_MAPPING_BYTES ||
+        publication.st_dev != owner->plan.purpose.standing_file_device ||
+        publication.st_ino != owner->plan.purpose.standing_file_inode) {
+        return -ESTALE;
+    }
+    status = preexec_setup_syscall5(SYS_fcntl, standing->publication_fd, F_GETFL, 0, 0, 0);
+    if (status < 0 || (status & O_ACCMODE) != O_RDONLY) {
+        return status < 0 ? status : -EPERM;
+    }
+    status = preexec_setup_syscall5(SYS_fcntl, standing->publication_fd, F_GETFD, 0, 0, 0);
+    if (status < 0 || !(status & FD_CLOEXEC)) {
+        return status < 0 ? status : -EPERM;
+    }
+    status = preexec_setup_syscall5(SYS_fcntl, standing->publication_fd, 1034, 0, 0, 0);
+    if (status < 0 || (status & (1 | 2 | 4 | 16)) != (1 | 2 | 4 | 16)) {
+        return status < 0 ? status : -EPERM;
+    }
+    status = preexec_setup_syscall5(SYS_fstat, standing->cancellation_fd,
+        (long)(uintptr_t)&cancellation, 0, 0, 0);
+    if (status < 0) {
+        return status;
+    }
+    if (cancellation.st_dev != initial->cancellation_device ||
+        cancellation.st_ino != initial->cancellation_inode) {
+        return -ESTALE;
+    }
+    status = preexec_setup_syscall5(SYS_fcntl, standing->cancellation_fd, F_GETFL, 0, 0, 0);
+    if (status < 0 || !(status & O_NONBLOCK) || (status & O_ACCMODE) != O_RDWR) {
+        return status < 0 ? status : -EPERM;
+    }
+    status = preexec_setup_syscall5(SYS_fcntl, standing->cancellation_fd, F_GETFD, 0, 0, 0);
+    if (status < 0 || !(status & FD_CLOEXEC)) {
+        return status < 0 ? status : -EPERM;
+    }
+    status = preexec_standing_event_observe(standing->cancellation_fd, observation, &event_token);
+    if (status || event_token != initial->cancellation_event_token) {
+        return status ? status : -ESTALE;
+    }
+    /* The fdinfo parser proves an actual kernel eventfd. Its retained role is
+     * distinct from Setup's amendment event, even if device/inode coincide. */
+    if (event_token == owner->plan.startup.cancellation_event_id) {
+        return -EPERM;
+    }
+    status = preexec_setup_syscall5(SYS_fstat, owner->artifact_fd,
+        (long)(uintptr_t)&artifact, 0, 0, 0);
+    if (status < 0) {
+        return status;
+    }
+    if (!S_ISREG(artifact.st_mode) ||
+        artifact.st_size != owner->artifact_before.st_size ||
+        (standing->artifact_identity_known &&
+         (artifact.st_dev != standing->artifact_identity.st_dev ||
+          artifact.st_ino != standing->artifact_identity.st_ino))) {
+        return -ESTALE;
+    }
+    status = preexec_setup_syscall5(SYS_fcntl, owner->artifact_fd, 1034, 0, 0, 0);
+    if (status < 0 || (status & 15) != 15) {
+        return status < 0 ? status : -EPERM;
+    }
+    *identity = (PreexecStandingIdentitySnapshot) {
+        .artifact = artifact, .publication = publication,
+        .cancellation = cancellation, .event_token = event_token,
+    };
+    return 0;
+}
+
+/* Every runtime actor owns its scratch and observed value. The retained
+ * lender identities were fixed by the real preinit constructor, never here. */
+static int preexec_standing_roles_current(
+    QemuCrucibleStandingPurposeOwner *standing,
+    QemuCrucibleProcessContractObservation *observation)
+{
+    QemuCruciblePreexecSetupOwner *owner = &preexec_setup_owner;
+    PreexecStandingIdentitySnapshot identity;
+    int status;
+
+    if (standing != &owner->standing || !standing->retained ||
+        !owner->source_published || !standing->artifact_identity_known) {
+        return -EPERM;
+    }
+    status = preexec_standing_roles_observe(standing, observation, &identity);
+    if (!status &&
+        (identity.artifact.st_dev != standing->artifact_identity.st_dev ||
+         identity.artifact.st_ino != standing->artifact_identity.st_ino ||
+         identity.artifact.st_size != standing->artifact_identity.st_size ||
+         identity.publication.st_dev != standing->publication_identity.st_dev ||
+         identity.publication.st_ino != standing->publication_identity.st_ino ||
+         identity.publication.st_size != standing->publication_identity.st_size ||
+         identity.cancellation.st_dev != standing->cancellation_identity.st_dev ||
+         identity.cancellation.st_ino != standing->cancellation_identity.st_ino ||
+         identity.event_token != standing->cancellation_event_token)) {
+        status = -ESTALE;
+    }
+    return status;
+}
