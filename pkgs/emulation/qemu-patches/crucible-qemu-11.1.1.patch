+# Copyright (c) Andyl, Inc.
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Exercise production PAUSE and quantum handoffs past a halted RR neighbor."""
+
+import argparse
+import os
+from pathlib import Path
+import shlex
+import subprocess
+import tempfile
+
+
+SOURCE = Path(__file__).resolve().parents[2] / "accel/tcg/icount-common.c"
+
+
+def function_source(source: str, signature: str) -> str:
+    """Extract one production function for a small linked state-machine test."""
+    start = source.index(signature)
+    opening = source.index("{", start)
+    depth = 0
+
+    for index in range(opening, len(source)):
+        if source[index] == "{":
+            depth += 1
+        elif source[index] == "}":
+            depth -= 1
+            if depth == 0:
+                return source[start : index + 1]
+
+    raise AssertionError(f"unterminated production function: {signature}")
+
+
+TEST_PRELUDE = r"""
+#include <assert.h>
+#include <stdbool.h>
+#include <inttypes.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+typedef struct CPUState CPUState;
+struct CPUState {
+    CPUState *next;
+    int cpu_index;
+    bool runnable;
+    bool halted;
+    bool work;
+    bool crucible_rr_pause_exit;
+};
+
+#define CPU_NEXT(cpu) ((cpu)->next)
+#define error_report(...) abort()
+#define g_assert(condition) assert(condition)
+
+static CPUState *first_cpu;
+static struct {
+    bool crucible_rr_cursor_valid;
+    int crucible_rr_current_vcpu;
+    uint64_t crucible_rr_cursor_position;
+    bool crucible_rr_selection_pending;
+} timers_state;
+
+static unsigned int handoff_count;
+static int handoff_from;
+static int handoff_to;
+static uint64_t handoff_position;
+
+static bool cpu_can_run(CPUState *cpu)
+{
+    return cpu->runnable;
+}
+
+static bool cpu_has_work(CPUState *cpu)
+{
+    return cpu->work;
+}
+
+static uint64_t icount_crucible_rr_switch_quantum(void)
+{
+    return 4096;
+}
+
+static void qemu_plugin_fire_rr_handoff_cb(int from, int to,
+                                            uint64_t quantum, uint64_t position)
+{
+    assert(quantum == 4096);
+    handoff_count++;
+    handoff_from = from;
+    handoff_to = to;
+    handoff_position = position;
+}
+"""
+
+
+TEST_MAIN = r"""
+int main(void)
+{
+    CPUState cpu2 = { .cpu_index = 2, .runnable = true };
+    CPUState cpu1 = {
+        .next = &cpu2, .cpu_index = 1, .runnable = true, .halted = true
+    };
+    CPUState cpu0 = {
+        .next = &cpu1, .cpu_index = 0, .runnable = true,
+        .crucible_rr_pause_exit = true
+    };
+
+    first_cpu = &cpu0;
+    timers_state.crucible_rr_cursor_valid = true;
+    timers_state.crucible_rr_current_vcpu = 0;
+    timers_state.crucible_rr_cursor_position = 25;
+
+    assert(icount_crucible_rr_next_runnable(&cpu0) == &cpu2);
+    icount_crucible_rr_pause_handoff(&cpu0);
+    assert(handoff_count == 1);
+    assert(handoff_from == 0 && handoff_to == 2);
+    assert(handoff_position == 25);
+    assert(timers_state.crucible_rr_current_vcpu == 2);
+    assert(timers_state.crucible_rr_cursor_position == 0);
+    assert(timers_state.crucible_rr_selection_pending);
+    assert(!cpu0.crucible_rr_pause_exit);
+
+    handoff_count = 0;
+    cpu2.halted = true;
+    cpu0.crucible_rr_pause_exit = true;
+    timers_state.crucible_rr_current_vcpu = 0;
+    timers_state.crucible_rr_cursor_position = 25;
+    timers_state.crucible_rr_selection_pending = false;
+    icount_crucible_rr_pause_handoff(&cpu0);
+    assert(handoff_count == 0);
+    assert(timers_state.crucible_rr_current_vcpu == 0);
+    assert(timers_state.crucible_rr_cursor_position == 25);
+
+    cpu1.halted = false;
+    cpu0.crucible_rr_pause_exit = true;
+    icount_crucible_rr_pause_handoff(&cpu0);
+    assert(handoff_count == 1);
+    assert(handoff_from == 0 && handoff_to == 1);
+
+    handoff_count = 0;
+    cpu1.halted = true;
+    cpu2.halted = false;
+    timers_state.crucible_rr_current_vcpu = 0;
+    timers_state.crucible_rr_cursor_position = 4095;
+    icount_crucible_rr_account(&cpu0, 1);
+    assert(handoff_count == 1);
+    assert(handoff_from == 0 && handoff_to == 2);
+    assert(handoff_position == 4096);
+    assert(timers_state.crucible_rr_current_vcpu == 2);
+    assert(timers_state.crucible_rr_cursor_position == 0);
+
+    handoff_count = 0;
+    cpu2.halted = true;
+    timers_state.crucible_rr_current_vcpu = 0;
+    timers_state.crucible_rr_cursor_position = 4095;
+    icount_crucible_rr_account(&cpu0, 1);
+    assert(handoff_count == 1);
+    assert(handoff_from == 0 && handoff_to == 0);
+    assert(handoff_position == 4096);
+    assert(timers_state.crucible_rr_current_vcpu == 0);
+    assert(timers_state.crucible_rr_cursor_position == 0);
+
+    puts("RR_HALTED_NEIGHBOR_PASS");
+    return 0;
+}
+"""
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--source", type=Path, default=SOURCE)
+    arguments = parser.parse_args()
+    source = arguments.source.read_text()
+    next_runnable = function_source(
+        source, "static CPUState *icount_crucible_rr_next_runnable("
+    )
+    quantum_handoff = function_source(
+        source, "static void icount_crucible_rr_account("
+    )
+    pause_handoff = function_source(
+        source, "static void icount_crucible_rr_pause_handoff("
+    )
+
+    with tempfile.TemporaryDirectory(prefix="crucible-rr-handoff-") as directory:
+        fixture = Path(directory) / "halted-neighbor.c"
+        binary = Path(directory) / "halted-neighbor"
+        fixture.write_text(
+            "\n\n".join(
+                (TEST_PRELUDE, next_runnable, quantum_handoff, pause_handoff, TEST_MAIN)
+            )
+        )
+        command = [
+            *shlex.split(os.environ.get("CC", "cc")),
+            "-std=c11",
+            "-Wall",
+            "-Wextra",
+            "-Werror",
+            str(fixture),
+            "-o",
+            str(binary),
+        ]
+        subprocess.run(command, check=True)
+        subprocess.run([str(binary)], check=True, timeout=10)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/unit/test-crucible-rr-sim-barriers.py b/tests/unit/test-crucible-rr-sim-barriers.py
