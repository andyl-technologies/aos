+static void test_hot_fork_external_source_disposition(void)
+{
+    BlockDriver *external_driver = bdrv_find_format("null-co");
+    BdrvCrucibleHotForkSourceDisposition original_disposition =
+        external_driver->bdrv_crucible_hot_fork_source_disposition;
+    QemuBlockHotForkSourceSetInventory inventory;
+    QemuBlockBackendHotForkBarrierInventory barrier;
+    QemuBlockHotForkSourceRoot root;
+    QemuBlockHotForkSourceSet *set;
+    BlockBackend *backend;
+    uint64_t original_permissions;
+    uint64_t original_shared_permissions;
+
+    g_assert_cmpint(original_disposition, ==,
+                    BDRV_CRUCIBLE_HOT_FORK_SOURCE_UNSUPPORTED);
+    backend = test_hot_fork_null_backend("unsupported-source", "null-co");
+    root = (QemuBlockHotForkSourceRoot) {
+        .backend = backend,
+        .root = blk_bs(backend),
+    };
+    g_assert_false(qemu_block_hot_fork_all_sources_fork_safe(NULL));
+    g_assert_null(qemu_block_hot_fork_source_set_new(&root, 1, NULL));
+    blk_unref(backend);
+
+    external_driver->bdrv_crucible_hot_fork_source_disposition =
+        BDRV_CRUCIBLE_HOT_FORK_SOURCE_EXTERNAL_SHARED;
+    {
+        QDict *options = qdict_new();
+        QemuBlockHotForkSourceRoot mixed_root;
+        BlockBackend *mixed;
+
+        qdict_put_str(options, "driver", "raw");
+        qdict_put_str(options, "node-name", "mixed-source");
+        qdict_put_str(options, "file.driver", "null-co");
+        qdict_put_int(options, "file.size", 4096);
+        mixed = blk_new_open(NULL, NULL, options, BDRV_O_RDWR, &error_abort);
+        mixed_root = (QemuBlockHotForkSourceRoot) {
+            .backend = mixed,
+            .root = blk_bs(mixed),
+        };
+        g_assert_false(qemu_block_hot_fork_all_sources_fork_safe(NULL));
+        g_assert_null(qemu_block_hot_fork_source_set_new(
+            &mixed_root, 1, NULL));
+        blk_unref(mixed);
+    }
+
+    backend = test_hot_fork_null_backend("external-source", "null-co");
+    root = (QemuBlockHotForkSourceRoot) {
+        .backend = backend,
+        .root = blk_bs(backend),
+    };
+    set = qemu_block_hot_fork_source_set_new(&root, 1, &error_abort);
+    g_assert_nonnull(set);
+    blk_get_perm(backend, &original_permissions, &original_shared_permissions);
+    g_assert_true(qemu_block_hot_fork_source_set_query(
+        set, &inventory, &error_abort));
+    g_assert_cmpuint(inventory.roots, ==, 0);
+    g_assert_cmpuint(inventory.nodes, ==, 0);
+    g_assert_cmpuint(inventory.originally_writable_roots, ==, 0);
+    g_assert_cmpuint(inventory.originally_writable_backends, ==, 0);
+    g_assert_false(inventory.frozen);
+    g_assert_true(qemu_block_hot_fork_all_sources_fork_safe(&error_abort));
+
+    external_driver->bdrv_crucible_hot_fork_source_disposition =
+        BDRV_CRUCIBLE_HOT_FORK_SOURCE_UNSUPPORTED;
+    g_assert_false(qemu_block_hot_fork_source_set_query(set, &inventory, NULL));
+    external_driver->bdrv_crucible_hot_fork_source_disposition =
+        BDRV_CRUCIBLE_HOT_FORK_SOURCE_EXTERNAL_SHARED;
+
+    g_assert_true(qemu_block_backend_hot_fork_barrier(
+        QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_HOLD, &barrier));
+    qemu_block_backend_hot_fork_barrier_inventory_destroy(&barrier);
+    g_assert_true(qemu_block_backend_hot_fork_snapshot_bind(
+        NULL, 0, &barrier, &error_abort));
+    g_assert_true(barrier.snapshot_complete);
+    g_assert_cmpuint(barrier.snapshot_root_count, ==, 0);
+    qemu_block_backend_hot_fork_barrier_inventory_destroy(&barrier);
+    g_assert_true(qemu_block_backend_hot_fork_barrier(
+        QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_RELEASE, &barrier));
+    qemu_block_backend_hot_fork_barrier_inventory_destroy(&barrier);
+
+    g_assert_true(qemu_block_hot_fork_source_set_freeze(set, &error_abort));
+    g_assert_true(qemu_block_hot_fork_source_set_query(
+        set, &inventory, &error_abort));
