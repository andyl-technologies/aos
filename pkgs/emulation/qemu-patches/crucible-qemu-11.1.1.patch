+}
+
+bool qemu_crucible_fault_clock_project_ticks(
+    uint16_t kind, uint32_t instance, uint64_t raw,
+    uint64_t *value, bool *read_error)
+{
+    g_assert_not_reached();
+}
+
+bool qemu_crucible_fault_clock_deadline_ps(
+    uint16_t kind, uint32_t instance, uint64_t guest, uint16_t role,
+    uint32_t index, uint64_t period, uint64_t *sequence, int64_t *scheduler,
+    uint32_t *action, uint64_t *generation, uint64_t *effective)
+{
+    g_assert_not_reached();
+}
+
+bool qemu_crucible_fault_clock_timer_arm(uint64_t *sequence)
