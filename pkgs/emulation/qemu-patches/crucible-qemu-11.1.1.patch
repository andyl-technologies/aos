+static void initialize_timer(LoongArchCPU *cpu)
+{
+    set_sys_state(&cpu->env, &cpu->env.sys_states[0]);
+    timer_init_ns(&cpu->timer, QEMU_CLOCK_VIRTUAL,
+                  loongarch_constant_timer_cb, cpu);
