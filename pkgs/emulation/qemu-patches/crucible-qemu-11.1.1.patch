+        loan->native_status = -EPROTO;
+    }
+    status = loan->first_status ? loan->first_status : loan->post_status ? loan->post_status :
+        loan->rearm_status ? loan->rearm_status : loan->native_status;
+    if (!status && (!loan->attempted || !logical_capture->staged ||
+                    !fingerprint_retirement_versions_current(loan))) {
