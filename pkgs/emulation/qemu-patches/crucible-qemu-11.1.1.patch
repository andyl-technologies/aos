+/*
+ * Source-owned callback-child allocation and physical custody
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifdef CONFIG_LINUX
+static bool callback_child_output_overlap(const void *output, size_t bytes,
+                                          const void *field, size_t field_bytes)
+{
+    uintptr_t start = (uintptr_t)output;
+    uintptr_t target = (uintptr_t)field;
+
+    if (!output || bytes > UINTPTR_MAX - start ||
+        (field && field_bytes > UINTPTR_MAX - target)) {
+        return true;
+    }
+    return field && start < target + field_bytes && target < start + bytes;
+}
+
+static bool callback_child_output_conflicts_except_locked(
+    const void *output, size_t bytes, const void *observation)
+{
+    QemuCrucibleCommandConsumerRegistry *registry = &startup_source.commands;
+    const void *fields[] = {
+        registry->child.holder,
+        registry->child.runtime_holder,
+        registry->storage.holder,
+        registry->storage.runtime_holder,
+        startup_source.control_callback.holder,
+        startup_source.callbacks.owner.holder,
+        startup_source.callbacks.owner.runtime_holder,
+        startup_source.publisher_module.runtime_holder,
+        startup_source.pending_command_lender.holder,
+        startup_source.pending_command_lender.serial_holder,
+        startup_source.command_member.pending_constructor.holder,
+        startup_source.command_member.pending_constructor.epoch,
+        startup_source.callback_groups.idle_resume.holder,
+        startup_source.callback_groups.idle_resume.runtime_holder,
+        startup_source.callback_groups.shmem_dispatch.holder,
+        startup_source.callback_groups.shmem_dispatch.runtime_holder,
+        startup_source.callback_groups.net_tx.holder,
+        startup_source.callback_groups.net_tx.runtime_holder,
+        startup_source.callback_groups.block_io.holder,
+        startup_source.callback_groups.block_io.runtime_holder,
+        startup_source.callback_groups.block_event.holder,
+        startup_source.callback_groups.block_event.runtime_holder,
+        startup_source.callback_groups.block_wait.holder,
+        startup_source.callback_groups.block_wait.runtime_holder,
+        startup_source.callback_groups.nine_p.holder,
+        startup_source.callback_groups.nine_p.runtime_holder,
+        startup_source.callback_groups.accelerator.holder,
+        startup_source.callback_groups.accelerator.runtime_holder,
+        startup_source.callback_groups.control.holder,
+        startup_source.callback_groups.control.runtime_holder,
+        startup_source.callback_groups.time_advance.holder,
+        startup_source.callback_groups.time_advance.runtime_holder,
+        startup_source.callback_groups.vcpu_init.holder,
+        startup_source.callback_groups.vcpu_init.runtime_holder,
+        startup_source.setup_mapping.holder,
+        startup_source.setup_handshake.holder,
+        startup_source.setup_slot.holder,
+        startup_source.command_member.holder,
+        startup_source.command_member.runtime_holder,
+        startup_source.command_receive.holder,
+        startup_source.command_receive.runtime_holder,
+        startup_source.received_delivery.creation_output,
+        startup_source.received_delivery.runtime_holder,
+        startup_source.received_delivery_use.holder,
+        startup_source.workspace_mapping.holder,
+        startup_source.fingerprint_worker.native.holder,
+        startup_source.run_worker.native.holder,
+        startup_source.teardown_worker.native.holder,
+        startup_source.fingerprint_completion.module_view_holder,
+        startup_source.fingerprint_completion.publication_holder,
+        startup_source.main_control_borrow.holder,
+    };
+
+    if (callback_child_output_overlap(output, bytes,
+            startup_source.main_control_borrow.invocation,
+            sizeof(QemuCrucibleNativeInvocationTicket))) {
+        return true;
+    }
+    if (callback_child_output_overlap(output, bytes, &startup_source, sizeof(startup_source))) {
+        return true;
+    }
+    if (callback_child_output_overlap(output, bytes,
+            startup_source.command_member.pending_constructor.module_journal,
+            startup_source.command_member.pending_constructor.module_journal_bytes)) {
+        return true;
+    }
+    if (callback_child_output_overlap(output, bytes,
+            startup_source.command_member.pending_constructor.observation,
+            sizeof(*startup_source.command_member.pending_constructor.observation)) &&
+        (output != observation ||
+         observation != startup_source.command_member.pending_constructor.observation ||
+         bytes != sizeof(*startup_source.command_member.pending_constructor.observation))) {
+        return true;
+    }
+    for (size_t index = 0; index < G_N_ELEMENTS(fields); index++) {
+        if (callback_child_output_overlap(output, bytes, fields[index], sizeof(void *))) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static bool callback_child_output_conflicts_locked(const void *output, size_t bytes)
+{
+    return callback_child_output_conflicts_except_locked(output, bytes, NULL);
+}
+
+static int callback_child_identity_locked(QemuCrucibleCallbackChildStorage *child)
+{
+    QemuCrucibleCommandConsumerRegistry *registry = &startup_source.commands;
+    QemuCrucibleStartupRuntimePurpose *runtime = &startup_source.runtime_purpose;
+    QemuCrucibleCallbackChildRequest *claim = &registry->child_claim;
+    int status;
+
+    if (child != &registry->child) {
+        return -EPERM;
+    }
+    if (!child->attempted || !child->held || child->runtime != runtime ||
+        child->claim != claim || child->bridge != &registry->storage ||
+        !child->bridge_borrow_held || !registry->storage.callback_child_held ||
+        !claim->attempted || !claim->held || !claim->payload_claimed ||
+        claim->canonical_owner != claim || claim->runtime != runtime ||
+        claim->request_index >= runtime->configured_count ||
+        !runtime->configured_requests ||
+        claim->request != &runtime->configured_requests[claim->request_index] ||
+        child->extent != claim->request->extent ||
+        child->alignment < claim->request->alignment ||
+        child->process != registry->process || claim->process != registry->process ||
+        child->process_generation != startup_source.original.process_generation ||
+        child->account_generation != startup_source.standing.initial.account_generation ||
+        child->fixed_native_extent != startup_source.metadata_partition.fixed_native_extent ||
+        child->installer.ctx != startup_source.saved.ctx ||
+        child->installer.module != startup_source.saved.module ||
+        child->installer.install != startup_source.saved.install ||
+        !runtime->charge.held || !startup_source.checkpoint_storage.fixed_charge.held) {
