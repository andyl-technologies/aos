+#endif
+
+int qemu_plugin_crucible_startup_setup_slot_create_v1(
+    qemu_plugin_id_t id, QemuCrucibleSetupHandshakeOwner *handshake,
+    QemuCrucibleSetupMappingOwner *mapping, QemuCrucibleSetupSlotOwner **out)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleSetupSlotOwner *slot = &startup_source.setup_slot;
+    uint32_t index;
+    uint32_t count;
+    int status = setup_handshake_identity(id, handshake);
+
+    if (!status) {
+        status = setup_mapping_identity(id, mapping);
+    }
+    if (status) {
+        return status;
+    }
+    if (!startup_invocation(id)) {
+        return -EPERM;
+    }
+    if (!out || *out || slot->attempted || handshake->slot_child || mapping->slot_child) {
+        return -EINVAL;
+    }
+    if (handshake->read_active || handshake->write_active ||
+        !handshake->write_completed || !handshake->read_completed ||
+        !handshake->reply_validated || !handshake->write_post_recorded ||
+        !handshake->read_post_recorded || handshake->first_status ||
+        handshake->write_post || handshake->read_post) {
+        return -ESTALE;
+    }
+    status = setup_handshake_exchange_current(id, handshake);
+    if (!status) {
+        status = qemu_plugin_crucible_startup_setup_mapping_current_v1(id, mapping);
+    }
+    if (status) {
+        return status;
+    }
+    index = ldl_be_p(handshake->reply + 13);
+    count = ldl_be_p(handshake->reply + 17);
+    /* The configured count may be smaller than the protocol capacity. It
+     * must match this acquired VMA and the complete authenticated reply;
+     * these bounds do not select or issue VM membership. */
+    if (!count || count > CRUCIBLE_SHMEM_MAX_NODES || index >= count ||
+        le32_to_cpu(qatomic_load_acquire(
+            &((struct crucible_shmem_region_header *)mapping->address)->node_count)) != count) {
+        return -EPROTO;
+    }
+    if (!startup_source.checkpoint_storage.fixed_charge.held ||
+        startup_source.metadata_partition.fixed_native_extent !=
+            qemu_crucible_startup_source_fixed_control_extent()) {
+        return -ENOKEY;
+    }
+    *slot = (QemuCrucibleSetupSlotOwner) {
+        .handshake = handshake,
+        .mapping = mapping,
+        .holder = &slot->creation_owner,
+        .process_generation = startup_source.original.process_generation,
+        .account_generation = startup_source.standing.initial.account_generation,
+        .fixed_native_extent = startup_source.metadata_partition.fixed_native_extent,
+        .process = getpid(),
+        .index = index,
+        .node_count = count,
+        .attempted = true,
+        .held = true,
+    };
+    slot->creation_owner = slot;
+    mapping->slot_child = slot;
+    handshake->slot_child = slot;
+    *out = slot;
+    slot->post_status = setup_handshake_original_current(handshake, NULL);
+    if (slot->post_status) {
+        crucible_metadata_partition_record_post(&startup_source.metadata_partition,
+                                                slot->post_status);
+    }
+    return slot->post_status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_startup_setup_slot_current_v1(
+    qemu_plugin_id_t id, QemuCrucibleSetupSlotOwner *slot)
+{
+#ifdef CONFIG_LINUX
+    int status = setup_slot_identity(id, slot);
+
+    if (!status && !startup_owner()) {
+        status = -EPERM;
+    }
+    if (!status) {
+        status = setup_handshake_identity(id, slot->handshake);
+    }
+    if (!status) {
+        status = qemu_plugin_crucible_startup_setup_mapping_current_v1(id, slot->mapping);
+    }
+    if (!status &&
+        (!slot->handshake->reply_validated || !slot->handshake->read_completed ||
+         slot->index != ldl_be_p(slot->handshake->reply + 13) ||
+         slot->node_count != ldl_be_p(slot->handshake->reply + 17) ||
+         !slot->node_count || slot->node_count > CRUCIBLE_SHMEM_MAX_NODES ||
+         slot->index >= slot->node_count ||
+         le32_to_cpu(qatomic_load_acquire(
+             &((struct crucible_shmem_region_header *)slot->mapping->address)->node_count)) !=
+             slot->node_count)) {
+        status = -ESTALE;
+    }
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_startup_setup_slot_transfer_v1(
+    qemu_plugin_id_t id, QemuCrucibleStartupRuntimePurpose *runtime,
+    QemuCrucibleSetupSlotOwner **from, QemuCrucibleSetupSlotOwner **to)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleSetupSlotOwner *slot = &startup_source.setup_slot;
+    int status = setup_slot_identity(id, slot);
+
+    if (!status) {
+        status = setup_owned_runtime_field_current(id, runtime, to);
+    }
+    if (status) {
+        return status;
+    }
+    if (!from || from == to || slot->transferred ||
+        slot->holder != &slot->creation_owner || slot->creation_owner != slot ||
+        *from != slot || *to) {
+        return -ESTALE;
+    }
+    *to = slot;
+    slot->creation_owner = NULL;
+    *from = NULL;
+    slot->holder = to;
+    slot->runtime = runtime;
+    slot->transferred = true;
+    slot->post_status = setup_handshake_original_current(slot->handshake, NULL);
+    if (slot->post_status) {
+        crucible_metadata_partition_record_post(&startup_source.metadata_partition,
+                                                slot->post_status);
+    }
+    return slot->post_status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_startup_setup_slot_return_v1(
+    qemu_plugin_id_t id, QemuCrucibleSetupSlotOwner **holder)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleSetupSlotOwner *slot = &startup_source.setup_slot;
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    bool locked;
+    int status = setup_slot_identity(id, slot);
+
+    if (status) {
+        return status;
+    }
+    if (!startup_owner() || !holder) {
+        return -EPERM;
+    }
+    /* A slot can precede Runtime enrollment. Once the command ledger exists,
+     * its member constructor and this parent return share that same mutex. */
+    locked = qatomic_load_acquire(&commands->initialized);
+    if (locked) {
+        qemu_mutex_lock(&commands->mutex);
+    }
+    status = setup_slot_identity(id, slot);
+    if (slot->transferred) {
+        if (holder != slot->holder) {
+            status = -EPERM;
+        }
+    } else if (slot->holder != &slot->creation_owner || slot->creation_owner != slot) {
+        status = -ESTALE;
+    }
+    if (!status && *holder != slot) {
+        status = -ESTALE;
+    }
+    if (!status && slot->command_member) {
+        status = -EBUSY;
+    }
+    if (!status) {
+        slot->mapping->slot_child = NULL;
+        slot->handshake->slot_child = NULL;
+        *holder = NULL;
+        slot->creation_owner = NULL;
+        slot->holder = NULL;
+        slot->held = false;
+    }
+    if (locked) {
+        qemu_mutex_unlock(&commands->mutex);
+    }
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
diff --git a/plugins/crucible-setup-mapping.inc.h b/plugins/crucible-setup-mapping.inc.h
new file mode 100644
index 0000000000000000000000000000000000000000..301e0a0eff640017cb78ff9cd3a7ad3ad84180ac
--- /dev/null
+++ b/plugins/crucible-setup-mapping.inc.h
@@ -0,0 +1,474 @@
+/*
+ * Authenticated mutable setup-role mapping and sole physical return.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Included once by Source. The mapping is process private; only integer
+ * protocol fields cross the shared-memory boundary.
+ */
+
+#ifdef CONFIG_LINUX
+static int setup_mapping_identity(qemu_plugin_id_t id,
+                                  QemuCrucibleSetupMappingOwner *owner)
+{
+    if (!qatomic_load_acquire(&startup_source.module_custody_published) ||
+        owner != &startup_source.setup_mapping ||
+        id != startup_source.saved.plugin_id ||
+        startup_source.owner_process != getpid()) {
+        return -EPERM;
+    }
+    if (!qatomic_load_acquire(&owner->attempted) ||
+        !qatomic_load_acquire(&owner->held) ||
+        owner->issuer != startup_source.preexec_purpose_owner ||
+        owner->process != startup_source.owner_process ||
+        owner->process_generation != startup_source.original.process_generation ||
+        owner->account_generation != startup_source.standing.initial.account_generation ||
+        owner->installer.plugin_id != id ||
+        owner->installer.ctx != startup_source.saved.ctx ||
+        owner->installer.module != startup_source.saved.module ||
+        owner->installer.install != startup_source.saved.install ||
+        owner->fixed_storage_bytes != sizeof(startup_source.setup_mapping) ||
+        owner->fixed_native_extent != startup_source.metadata_partition.fixed_native_extent ||
+        !qatomic_load_acquire(&startup_source.custody_retained) ||
+        !qatomic_load_acquire(&startup_source.metadata_partition.published) ||
+        !qatomic_load_acquire(&startup_source.metadata_partition.controller_retained)) {
+        return -ESTALE;
+    }
+    /* Descriptor last-use and the installer's deadline do not revoke the
+     * VMA. No fstat, clock, callback or new constructor is invoked here. */
+    return 0;
+}
+
+static bool setup_mapping_bytes_zero(const uint8_t *bytes, size_t count)
+{
+    for (size_t index = 0; index < count; index++) {
+        if (bytes[index]) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static int setup_mapping_header_current(QemuCrucibleSetupMappingOwner *owner)
+{
+    struct crucible_shmem_region_header *header = owner->address;
+    uint32_t nodes;
+    uint32_t rings;
+    uint32_t capacity;
+    uint32_t arena;
+    int status;
+
+    if (!owner->mapped || !owner->address || !owner->dontfork ||
+        owner->request_bytes < sizeof(*header) ||
+        (uintptr_t)owner->address % _Alignof(struct crucible_shmem_region_header) ||
+        owner->request_bytes > UINTPTR_MAX - (uintptr_t)owner->address) {
+        return -ESTALE;
+    }
+    nodes = le32_to_cpu(qatomic_load_acquire(&header->node_count));
+    if (le64_to_cpu(qatomic_load_acquire(&header->magic)) != CRUCIBLE_SHMEM_REGION_MAGIC ||
+        le32_to_cpu(qatomic_load_acquire(&header->abi_version)) != CRUCIBLE_SHMEM_ABI_VERSION ||
+        !nodes || nodes > CRUCIBLE_SHMEM_MAX_NODES ||
+        le32_to_cpu(qatomic_load_acquire(&header->ticks_per_ns)) != CRUCIBLE_SHMEM_TICKS_PER_NS ||
+        !setup_mapping_bytes_zero(header->control_padding, sizeof(header->control_padding)) ||
+        !setup_mapping_bytes_zero(header->reserved, sizeof(header->reserved))) {
+        return -EPROTONOSUPPORT;
+    }
+    rings = le32_to_cpu(qatomic_load_acquire(&header->ring_count));
+    capacity = le32_to_cpu(qatomic_load_acquire(&header->queue_capacity));
+    arena = le32_to_cpu(qatomic_load_acquire(&header->fault_payload_arena_bytes));
+    if (rings % 6 || rings / 6 > CRUCIBLE_SHMEM_MAX_VM_NODES) {
+        return -EPROTO;
+    }
+    status = qemu_crucible_shared_region_layout_compute(rings / 6, capacity,
+                                                       arena, &owner->layout);
+    if (status) {
+        return status;
+    }
+    if (owner->layout.region_extent != owner->request_bytes ||
+        le64_to_cpu(qatomic_load_acquire(&header->region_size)) != owner->request_bytes ||
+        le64_to_cpu(qatomic_load_acquire(&header->ring_hdr_off)) != owner->layout.frame_ring_headers_offset ||
+        le64_to_cpu(qatomic_load_acquire(&header->ring_data_off)) != owner->layout.frame_ring_data_offset ||
+        le64_to_cpu(qatomic_load_acquire(&header->entry_stride)) != CRUCIBLE_SHMEM_FRAME_ENTRY_SIZE) {
+        return -ESTALE;
+    }
+    return 0;
+}
+
+static int setup_mapping_retirement_current(QemuCrucibleSetupMappingOwner *owner)
+{
+    QemuCrucibleFingerprintCompletionBinding *completion =
+        &startup_source.fingerprint_completion;
+    int status;
+
+    if (owner->slot_child || startup_source.control_callback.holder ||
+        startup_source.control_callback.invocation.held ||
+        startup_source.control_callback.invocation.active ||
+        startup_source.control_callback.invocation.retained ||
+        startup_source.intent_observation.held ||
+        startup_source.standing.enrolled ||
+        startup_source.standing.operation.held ||
+        startup_source.standing.cleanup_execution ||
+        startup_source.standing.cleanup_holder ||
+        startup_source.checkpoint_inventory_metadata.held) {
+        return -EBUSY;
+    }
+    if (!owner->transferred) {
+        return 0;
+    }
+    status = fingerprint_completion_identity(completion);
+    if (status) {
+        return status;
+    }
+    /* The paid canonical fields retain operation/publication custody. A
+     * callback status or control/sample ACK cannot consume either field. */
+    if (*completion->module_view_holder || *completion->publication_holder) {
+        return -EBUSY;
+    }
+    return 0;
+}
+#endif
+
+int qemu_plugin_crucible_startup_setup_mapping_create_v1(
+    qemu_plugin_id_t id, QemuCrucibleSetupMappingOwner **out,
+    void **address, size_t *bytes)
+{
+#if defined(CONFIG_LINUX) && defined(__x86_64__) && !defined(__ILP32__)
+    QemuCrucibleSetupMappingOwner *owner = &startup_source.setup_mapping;
+    QemuCruciblePreexecSourceBorrow borrowed;
+    struct stat identity;
+    uint64_t extent;
+    uint64_t backing;
+    long page_size;
+    void *mapping;
+    int descriptor;
+    int flags;
+    int status;
+
+    if (!startup_invocation(id)) {
+        return -EPERM;
+    }
+    if (!out || *out || !address || *address || !bytes || *bytes) {
+        return -EINVAL;
+    }
+    if (owner->attempted) {
+        return -EALREADY;
+    }
+    /* This real setup-role creator precedes Runtime/Control callback storage.
+     * It uses the already-issued installing Source, not a not-yet-born module
+     * control-purpose holder or any decoded request as allocation credit. */
+    status = startup_active(id);
+    if (!status &&
+        (!startup_source.checkpoint_storage.fixed_charge.held ||
+         startup_source.checkpoint_storage.issuer != startup_source.preexec_purpose_owner ||
+         startup_source.metadata_partition.fixed_native_extent !=
+             qemu_crucible_startup_source_fixed_control_extent())) {
+        status = -ENOKEY;
+    }
+    if (!status) {
+        status = qemu_crucible_preexec_purpose_borrow_v3(
+            startup_source.preexec_purpose_owner, &borrowed);
+    }
+    if (status) {
+        return status;
+    }
+    extent = ldq_be_p(borrowed.frame + QEMU_CRUCIBLE_PREEXEC_SETUP_PAYLOAD_OFFSET +
+                     QEMU_CRUCIBLE_PREEXEC_SETUP_REGION_LENGTH_OFFSET);
+    if (!extent || extent > SIZE_MAX || extent > INT64_MAX ||
+        extent < sizeof(struct crucible_shmem_region_header)) {
+        return -EPROTO;
+    }
+    descriptor = borrowed.descriptors[QEMU_CRUCIBLE_PREEXEC_SETUP_SHARED_MEMORY_INDEX];
+    if (fstat(descriptor, &identity) < 0) {
+        return -errno;
+    }
+    flags = fcntl(descriptor, F_GETFL);
+    if (flags < 0) {
+        return -errno;
+    }
+    if (!S_ISREG(identity.st_mode) || identity.st_size < 0 ||
+        (uint64_t)identity.st_size != extent || (flags & O_ACCMODE) != O_RDWR) {
+        return -ESTALE;
+    }
+    page_size = sysconf(_SC_PAGESIZE);
+    if (page_size <= 0 || ((uint64_t)page_size & ((uint64_t)page_size - 1)) ||
+        (uint64_t)page_size - 1 > UINT64_MAX - extent) {
+        return -EOVERFLOW;
+    }
+    backing = (extent + (uint64_t)page_size - 1) & ~((uint64_t)page_size - 1);
+    status = startup_process_purpose_live();
+    if (status) {
+        return status;
+    }
+
+    /* The fixed floor has already paid this exact inline body. Publish its
+     * custody before the independent VMA debit or any kernel effect. */
+    *owner = (QemuCrucibleSetupMappingOwner) {
+        .issuer = startup_source.preexec_purpose_owner,
+        .installer = startup_source.saved,
+        .holder = &owner->creation_owner,
+        .request_bytes = extent,
+        .backing_bytes = backing,
+        .fixed_storage_bytes = sizeof(startup_source.setup_mapping),
+        .fixed_native_extent = startup_source.metadata_partition.fixed_native_extent,
+        .process_generation = startup_source.original.process_generation,
+        .account_generation = startup_source.standing.initial.account_generation,
+        .process = getpid(),
+    };
+    qemu_mutex_init(&owner->mutex);
+    qatomic_store_release(&owner->held, true);
+    qatomic_store_release(&owner->attempted, true);
+    owner->creation_owner = owner;
+    *out = owner;
+    status = crucible_metadata_native_admit(&startup_source.metadata_partition,
+                                            backing, &owner->mapping_charge);
+    if (!status) {
+        /* SAME installing Original immediately precedes mmap. Its negative
+         * result leaves the exact born owner/charge for pre-effect return. */
+        status = startup_process_purpose_live();
+    }
+    if (status) {
+        owner->first_status = status;
+        return startup_failure(status);
+    }
+    owner->mmap_attempted = true;
+    mapping = mmap(NULL, owner->request_bytes, PROT_READ | PROT_WRITE,
+                   MAP_SHARED, descriptor, 0);
+    owner->mmap_returned = true;
+    if (mapping == MAP_FAILED) {
+        status = -errno;
+    } else {
+        owner->address = mapping;
+        owner->mapped = true;
+        *address = mapping;
+        *bytes = owner->request_bytes;
+        if (!mapping) {
+            status = -EFAULT;
+        } else if (madvise(mapping, owner->request_bytes, MADV_DONTFORK) < 0) {
+            status = -errno;
+        } else {
+            owner->dontfork = true;
+            status = setup_mapping_header_current(owner);
+        }
+    }
+    if (status) {
+        owner->first_status = status;
+    } else {
+        owner->layout_verified = true;
+    }
+    /* Every attempted mmap, including MAP_FAILED, has the same independent
+     * installing-Original post. The initiating cause remains primary. */
+    owner->post_status = startup_process_purpose_live();
+    if (owner->post_status) {
+        crucible_metadata_partition_record_post(&startup_source.metadata_partition,
+                                                owner->post_status);
+    }
+    status = owner->first_status ? owner->first_status : owner->post_status;
+    if (status) {
+        /* Source may already have recorded a separate negative post. Close
+         * its birth without replacing this creator's initiating cause. */
+        startup_failure(status);
+    }
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_startup_setup_mapping_current_v1(
+    qemu_plugin_id_t id, QemuCrucibleSetupMappingOwner *owner)
+{
+#ifdef CONFIG_LINUX
+    int status = setup_mapping_identity(id, owner);
+
+    if (status) {
+        return status;
+    }
+    qemu_mutex_lock(&owner->mutex);
+    if (!owner->mapped || !owner->layout_verified || !owner->dontfork ||
+        owner->closing || owner->physical_returned || owner->unmap_attempted ||
+        !owner->mapping_charge.held || owner->mapping_charge.bytes != owner->backing_bytes) {
+        status = -ESTALE;
+    } else {
+        /* The short local scope excludes a concurrent unmap. No Original,
+         * module callback, ledger gate or kernel call runs while it is held. */
+        status = setup_mapping_header_current(owner);
+    }
+    qemu_mutex_unlock(&owner->mutex);
+    return status ? status : crucible_metadata_partition_admission_status(
+        &startup_source.metadata_partition);
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_startup_setup_mapping_transfer_v1(
+    qemu_plugin_id_t id, QemuCrucibleStartupRuntimePurpose *runtime,
+    QemuCrucibleSetupMappingOwner **from, QemuCrucibleSetupMappingOwner **to)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleSetupMappingOwner *owner = &startup_source.setup_mapping;
+    QemuCrucibleFingerprintCompletionBinding *completion =
+        &startup_source.fingerprint_completion;
+    uint64_t extent;
+    uintptr_t base;
+    uintptr_t field;
+    int status = setup_mapping_identity(id, owner);
+
+    if (status) {
+        return status;
+    }
+    if (!startup_invocation(id)) {
+        return -EPERM;
+    }
+    status = startup_runtime_admission(id, runtime);
+    if (!status) {
+        status = fingerprint_completion_identity(completion);
+    }
+    if (status) {
+        return status;
+    }
+    extent = startup_runtime_parent_extent(runtime);
+    base = (uintptr_t)completion->userdata;
+    field = (uintptr_t)to;
+    if (completion->runtime != runtime || !extent || !base ||
+        extent > UINTPTR_MAX - base || !from ||
+        owner->holder != &owner->creation_owner ||
+        owner->creation_owner != owner || owner->transferred ||
+        !to || from == to ||
+        field % _Alignof(QemuCrucibleSetupMappingOwner *) || field < base ||
+        extent < sizeof(*to) || field - base > extent - sizeof(*to) ||
+        field > UINTPTR_MAX - sizeof(*to)) {
+        return -EPERM;
+    }
+    /* Source creation custody is independent of the movable caller
+     * projection. Only the destination is a lasting paid owning field. */
+    if (*from != owner || *to) {
+        return -ESTALE;
+    }
+    *to = owner;
+    owner->creation_owner = NULL;
+    *from = NULL;
+    owner->holder = to;
+    owner->runtime = runtime;
+    owner->transferred = true;
+    /* Consume the real move before its independent post. A negative result
+     * still leaves the nominal mapping in the durable Runtime field. */
+    owner->post_status = startup_process_purpose_live();
+    if (owner->post_status) {
+        crucible_metadata_partition_record_post(&startup_source.metadata_partition,
+                                                owner->post_status);
+    }
+    return owner->post_status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_startup_setup_mapping_return_v1(
+    qemu_plugin_id_t id, QemuCrucibleSetupMappingOwner **holder)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleSetupMappingOwner *owner = &startup_source.setup_mapping;
+    bool unmap = false;
+    int status = setup_mapping_identity(id, owner);
+
+    if (status) {
+        return status;
+    }
+    /* The original Source owner performs disposal after actual reader/callback
+     * loans return. A worker's copied opaque pointer is not that dispatcher. */
+    if (!startup_owner()) {
+        return -EPERM;
+    }
+    if (!holder) {
+        return -EINVAL;
+    }
+    if (owner->transferred) {
+        if (holder != owner->holder) {
+            return -EPERM;
+        }
+    } else if (owner->holder != &owner->creation_owner ||
+               owner->creation_owner != owner) {
+        return -ESTALE;
+    }
+    /* Before transfer this consumes a caller projection and the real Source
+     * creation field together. Afterwards only the saved Runtime field owns
+     * disposition; an escaped projection cannot substitute for that field. */
+    if (*holder != owner) {
+        return -ESTALE;
+    }
+    status = setup_mapping_retirement_current(owner);
+    if (status) {
+        return status;
+    }
+    qemu_mutex_lock(&owner->mutex);
+    if (owner->return_active) {
+        status = -EBUSY;
+    } else if (owner->unmap_uncertain) {
+        status = owner->unmap_status ? owner->unmap_status : -EIO;
+    } else if (owner->unmap_attempted && !owner->physical_returned) {
+        status = -EBUSY;
+    } else if (!owner->physical_returned && owner->mapped) {
+        /* Close new local metadata reads after earlier readers finish, then
+         * drop the mutex before the sole kernel effect. */
+        owner->closing = true;
+        owner->unmap_attempted = true;
+        unmap = true;
+    } else if (!owner->physical_returned && owner->mmap_attempted &&
+               !owner->mmap_returned) {
+        status = -EBUSY;
+    } else if (!owner->physical_returned) {
+        owner->closing = true;
+        owner->physical_returned = true;
+    }
+    if (!status) {
+        owner->return_active = true;
+    }
+    qemu_mutex_unlock(&owner->mutex);
+    if (status) {
+        return status;
+    }
+    if (unmap) {
+        int result = munmap(owner->address, owner->request_bytes);
+        int saved_errno = result < 0 ? errno : 0;
+
+        qemu_mutex_lock(&owner->mutex);
+        owner->unmap_errno = saved_errno;
+        owner->unmap_status = result < 0 ? -saved_errno : 0;
+        owner->unmap_uncertain = result < 0;
+        owner->physical_returned = result == 0;
+        status = owner->unmap_status;
+        qemu_mutex_unlock(&owner->mutex);
+        if (status) {
+            qemu_mutex_lock(&owner->mutex);
+            owner->return_active = false;
+            qemu_mutex_unlock(&owner->mutex);
+            return status;
+        }
+    }
+    /* A real munmap0 or this exact no-successful-mmap branch establishes
+     * disposition. No pointer-null, ABI status or ACK substitutes for it.
+     * A retry after ledger contention never repeats the kernel effect. */
+    if (owner->mapping_charge.held) {
+        status = crucible_metadata_native_retire(&startup_source.metadata_partition,
+                                               &owner->mapping_charge);
+        if (status) {
+            qemu_mutex_lock(&owner->mutex);
+            owner->return_active = false;
+            qemu_mutex_unlock(&owner->mutex);
+            return status;
+        }
+    }
+    qemu_mutex_lock(&owner->mutex);
+    *holder = NULL;
+    owner->creation_owner = NULL;
+    owner->holder = NULL;
+    owner->return_active = false;
+    qatomic_store_release(&owner->held, false);
+    qemu_mutex_unlock(&owner->mutex);
+    /* Retire only this dynamic VMA charge. The Source body, descriptor role,
+     * runtime prefix and any producing operation remain independent custody. */
+    return 0;
+#else
+    return -ENOTSUP;
+#endif
+}
diff --git a/plugins/crucible-socket-ingress.inc.h b/plugins/crucible-socket-ingress.inc.h
new file mode 100644
index 0000000000000000000000000000000000000000..f33911c6d93010f8c345aa392c9b797473cf4ea6
--- /dev/null
+++ b/plugins/crucible-socket-ingress.inc.h
@@ -0,0 +1,395 @@
+/*
+ * Finite socket ingress under the retained native startup/process family
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Included once by crucible-startup-source.c: implementations share its private
+ * singleton without exporting a ledger getter or an independent issuer.
+ */
+
+#if defined(CONFIG_LINUX) && defined(__x86_64__) && !defined(__ILP32__)
+static int startup_socket_ingress_family_current(
+    QemuCrucibleSocketIngressLoan *loan, Chardev *chardev, QIOChannel *channel)
+{
+    QemuCrucibleMonitorPurpose *monitor = &startup_source.monitor_purpose;
+    SocketChardev *socket;
+    struct stat endpoint;
+
+    if (!qatomic_load_acquire(&startup_source.process_purpose_complete) ||
+        getpid() != startup_source.owner_process ||
+        !startup_source.preexec_purpose_owner ||
+        !startup_source.process_contract_owner ||
+        !startup_source.incarnation_purpose_owner ||
+        loan != &startup_source.socket_ingress ||
+        !monitor->bound || monitor->construction_uncertain ||
+        !monitor->allocation || !monitor->fixed_charge.held ||
+        monitor->process_id != getpid() ||
+        monitor->process_generation != startup_source.original.process_generation ||
+        monitor->allocation->crucible_purpose != monitor ||
+        !chardev || chardev->fe != &monitor->allocation->chr ||
+        !g_main_context_is_owner(chardev->gcontext ? chardev->gcontext :
+                                                    g_main_context_default()) ||
+        !qemu_chr_socket_fd_preserve_blocking_configured(chardev->fe)) {
+        return -EPERM;
+    }
+    socket = SOCKET_CHARDEV(chardev);
+    if (socket->state != TCP_CHARDEV_STATE_CONNECTED || !socket->sioc ||
+        socket->ioc != channel || channel != QIO_CHANNEL(socket->sioc) ||
+        socket->sioc->fd < 0 ||
+        !qio_channel_has_feature(channel, QIO_CHANNEL_FEATURE_FD_PASS)) {
+        return -ESTALE;
+    }
+    if (loan->active) {
+        if (loan->chardev != chardev || loan->channel != channel ||
+            loan->socket_descriptor != socket->sioc->fd) {
+            return -ESTALE;
+        }
+        if (fstat(socket->sioc->fd, &endpoint) < 0) {
+            return -errno;
+        }
+        if (!S_ISSOCK(endpoint.st_mode) ||
+            (uint64_t)endpoint.st_dev != loan->socket_device ||
+            (uint64_t)endpoint.st_ino != loan->socket_inode) {
+            return -ESTALE;
+        }
+    }
+    return 0;
+}
+
+/* A current census is preflight, never a reservation against other actors.
+ * The same inherited hard RLIMIT remains the kernel-enforced upper bound
+ * during receipt, including concurrent births and MSG_CTRUNC disposal. The
+ * census reader itself occupies one counted descriptor until once-close.
+ */
+static int startup_descriptor_preflight(
+    QemuCrucibleProcessContractObservation *observation,
+    uint64_t descriptor_limit, size_t descriptor_capacity)
+{
+    struct KernelDirectoryEntry {
+        uint64_t inode;
+        int64_t offset;
+        unsigned short length;
+        unsigned char type;
+        char name[];
+    };
+    uint64_t count = 0;
+    ssize_t bytes;
+    int status = 0;
+    int fd;
+
+    if (observation->descriptor >= 0 || observation->close_uncertain ||
+        descriptor_capacity > descriptor_limit) {
+        return -EMFILE;
+    }
+    fd = open("/proc/self/fd", O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW);
+    if (fd < 0) {
+        return -errno;
+    }
+    observation->descriptor = fd;
+    while ((bytes = syscall(SYS_getdents64, fd, observation->bytes,
+                             sizeof(observation->bytes))) > 0) {
+        size_t cursor = 0;
+
+        while (cursor < bytes) {
+            unsigned short entry_length;
+            const char *name;
+            size_t remaining = bytes - cursor;
+            size_t header = offsetof(struct KernelDirectoryEntry, name);
+            size_t name_bytes;
+            bool dot;
+
+            if (remaining <= header) {
+                status = -EPROTO;
+                break;
+            }
+            memcpy(&entry_length, observation->bytes + cursor +
+                   offsetof(struct KernelDirectoryEntry, length),
+                   sizeof(entry_length));
+            if (entry_length <= header || entry_length > remaining) {
+                status = -EPROTO;
+                break;
+            }
+            name = observation->bytes + cursor + header;
+            name_bytes = strnlen(name, entry_length - header);
+            if (name_bytes == entry_length - header) {
+                status = -EPROTO;
+                break;
+            }
+            dot = (name_bytes == 1 && name[0] == '.') ||
+                (name_bytes == 2 && name[0] == '.' && name[1] == '.');
+            if (!dot && ++count > descriptor_limit -
+                                      descriptor_capacity) {
+                status = -EMFILE;
+                break;
+            }
+            cursor += entry_length;
+        }
+        if (status) {
+            break;
+        }
+    }
+    if (bytes < 0 && !status) {
+        status = -errno;
+    }
+    if (close(fd) < 0) {
+        observation->close_uncertain = true;
+        return status ? status : -errno;
+    }
+    observation->descriptor = -1;
+    return status;
+}
+#endif
+
+int qemu_crucible_socket_ingress_begin(
+    Chardev *chardev, QIOChannel *channel, uint64_t control_bytes,
+    size_t descriptor_capacity, QemuCrucibleSocketIngressLoan **out,
+    int **descriptors)
+{
+#if defined(CONFIG_LINUX) && defined(__x86_64__) && !defined(__ILP32__)
+    QemuCrucibleSocketIngressLoan *loan = &startup_source.socket_ingress;
+    struct stat endpoint;
+    int status;
+
+    if (!qatomic_load_acquire(&qemu_crucible_selected_process_id)) {
+        return 0;
+    }
+    status = startup_socket_ingress_family_current(loan, chardev, channel);
+    if (status) {
+        return status;
+    }
+    if (!out || !descriptors || descriptor_capacity != QIO_CHANNEL_SOCKET_MAX_FDS ||
+        descriptor_capacity != G_N_ELEMENTS(loan->aliases) ||
+        control_bytes != qio_channel_socket_receive_control_bytes() +
+                         sizeof(struct iovec) + CHR_READ_BUF_LEN) {
+        return -EINVAL;
+    }
+    if (qatomic_cmpxchg(&loan->cut, 0, 1)) {
+        return -EAGAIN;
+    }
+    if (loan->active || loan->uncertain) {
+        status = -EBUSY;
+        goto done;
+    }
+    /* These debits use the already authenticated local residual after guest,
+     * workspace, D7, retained native bodies and observer allowance. There is
+     * no second allocator bank or renewed installing operation here. The fixed
+     * reader/QIO frame envelope stays paid across reads; only the concrete int
+     * landing allocation returns after its actual free and alias disposition.
+     */
+    if (!loan->fixed_charge.held) {
+        status = crucible_metadata_native_admit(&startup_source.metadata_partition,
+            control_bytes - descriptor_capacity * sizeof(int),
+            &loan->fixed_charge);
+        if (status) {
+            goto done;
+        }
+    }
+    status = crucible_metadata_native_admit(&startup_source.metadata_partition,
+        descriptor_capacity * sizeof(int), &loan->charge);
+    if (status) {
+        goto done;
+    }
+    loan->chardev = chardev;
+    loan->channel = channel;
+    object_ref(OBJECT(chardev));
+    object_ref(OBJECT(channel));
+    qemu_thread_get_self(&loan->thread);
+    loan->active = true;
+    loan->socket_descriptor = SOCKET_CHARDEV(chardev)->sioc->fd;
+    loan->descriptor_capacity = descriptor_capacity;
+    for (size_t index = 0; index < G_N_ELEMENTS(loan->aliases); index++) {
+        loan->aliases[index] = -1;
+    }
+    if (fstat(loan->socket_descriptor, &endpoint) < 0) {
+        status = -errno;
+    } else if (!S_ISSOCK(endpoint.st_mode)) {
+        status = -ENOTSOCK;
+    } else {
+        loan->socket_device = endpoint.st_dev;
+        loan->socket_inode = endpoint.st_ino;
+        status = qemu_crucible_preexec_contract_check_v3(
+            startup_source.preexec_purpose_owner, &loan->observation,
+            &loan->descriptor_limit);
+    }
+    if (!status) {
+        status = startup_descriptor_preflight(&loan->observation,
+                                          loan->descriptor_limit,
+                                          loan->descriptor_capacity);
+    }
+    if (!status) {
+        status = startup_socket_ingress_family_current(loan, chardev, channel);
+    }
+    if (status) {
+        loan->uncertain = true;
+        loan->first_status = status;
+        crucible_metadata_partition_status(&startup_source.metadata_partition,
+                                            status);
+        goto done;
+    }
+    /* The actual bounded allocation follows its retained debit and references.
+     * No received bytes, copied TOTAL or scalar count creates this owner.
+     */
+    loan->descriptors = g_new(int, descriptor_capacity);
+    for (size_t index = 0; index < descriptor_capacity; index++) {
+        loan->descriptors[index] = -1;
+    }
+    *descriptors = loan->descriptors;
+    *out = loan;
+
+done:
+    qatomic_store_release(&loan->cut, 0);
+    return status;
+#else
+    return qatomic_load_acquire(&qemu_crucible_selected_process_id) ?
+        -ENOTSUP : 0;
+#endif
+}
+
+int qemu_crucible_socket_ingress_finish(
+    QemuCrucibleSocketIngressLoan *loan, int *descriptors,
+    size_t descriptor_count, ssize_t received, int receive_errno)
+{
+#if defined(CONFIG_LINUX) && defined(__x86_64__) && !defined(__ILP32__)
+    uint64_t descriptor_limit;
+    int status;
+    int post;
+
+    if (getpid() != startup_source.owner_process ||
+        loan != &startup_source.socket_ingress) {
+        return -EPERM;
+    }
+    if (qatomic_cmpxchg(&loan->cut, 0, 1)) {
+        return -EAGAIN;
+    }
+    if (!loan->active || loan->received || loan->uncertain ||
+        !qemu_thread_is_self(&loan->thread) || descriptors != loan->descriptors ||
+        descriptor_count > loan->descriptor_capacity) {
+        status = -EPERM;
+        goto done;
+    }
+    loan->received = true;
+    loan->descriptor_count = descriptor_count;
+    memcpy(loan->aliases, descriptors, descriptor_count * sizeof(int));
+    status = received < 0 && received != QIO_CHANNEL_ERR_BLOCK ?
+        -(receive_errno > 0 ? receive_errno : EIO) : 0;
+    if (status) {
+        loan->first_status = status;
+        loan->uncertain = true;
+        crucible_metadata_partition_status(&startup_source.metadata_partition,
+                                            status);
+    }
+    /* The independent physical post is never skipped by the receive result.
+     * It corroborates retained process capacity/attachment, not acceptance of
+     * a later request or its enclosing original/cancellation purpose.
+     */
+    post = qemu_crucible_preexec_contract_check_v3(
+        startup_source.preexec_purpose_owner, &loan->observation,
+        &descriptor_limit);
+    if (!post && descriptor_limit != loan->descriptor_limit) {
+        post = -ESTALE;
+    }
+    if (!post) {
+        post = startup_socket_ingress_family_current(loan,
+                                                     loan->chardev, loan->channel);
+    }
+    if (post) {
+        loan->post_status = post;
+        loan->uncertain = true;
+        crucible_metadata_partition_record_post(&startup_source.metadata_partition,
+                                                post);
+    }
+    if (!status) {
+        status = post;
+    }
+done:
+    qatomic_store_release(&loan->cut, 0);
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_crucible_socket_ingress_release(
+    QemuCrucibleSocketIngressLoan *loan, Chardev *chardev,
+    int *descriptors, size_t descriptor_capacity)
+{
+    Monitor *monitor = startup_source.monitor_purpose.allocation;
+    Chardev *retained_chardev;
+    QIOChannel *channel;
+    GMainContext *context;
+    size_t transferred;
+    int status;
+
+    if (getpid() != startup_source.owner_process ||
+        loan != &startup_source.socket_ingress || !monitor || !chardev ||
+        chardev->fe != &monitor->chr ||
+        monitor->crucible_purpose != &startup_source.monitor_purpose ||
+        (descriptor_capacity && !descriptors)) {
+        return -EPERM;
+    }
+    context = chardev->gcontext ? chardev->gcontext : g_main_context_default();
+    if (!(qemu_thread_is_self(&loan->thread) && g_main_context_is_owner(context)) &&
+        !(qemu_in_main_thread() && bql_locked() && monitor_cur() == monitor)) {
+        return -EPERM;
+    }
+    if (qatomic_cmpxchg(&loan->cut, 0, 1)) {
+        return -EAGAIN;
+    }
+    if (!loan->active || !loan->received || loan->uncertain ||
+        loan->chardev != chardev || !loan->descriptors ||
+        loan->descriptor_count > loan->descriptor_capacity) {
+        qatomic_store_release(&loan->cut, 0);
+        return -EPERM;
+    }
+    transferred = MIN(descriptor_capacity, loan->descriptor_count);
+    if (transferred) {
+        memcpy(descriptors, loan->descriptors, transferred * sizeof(int));
+        for (size_t index = 0; index < transferred; index++) {
+            loan->descriptors[index] = -1;
+            loan->aliases[index] = -1;
+        }
+    }
+    for (size_t index = transferred; index < loan->descriptor_count; index++) {
+        if (close(loan->descriptors[index]) < 0) {
+            status = -errno;
+            loan->uncertain = true;
+            if (!loan->first_status) {
+                loan->first_status = status;
+                crucible_metadata_partition_status(
+                    &startup_source.metadata_partition, status);
+            }
+        } else {
+            loan->descriptors[index] = -1;
+            loan->aliases[index] = -1;
+        }
+    }
+    if (loan->uncertain) {
+        qatomic_store_release(&loan->cut, 0);
+        return transferred;
+    }
+    g_free(loan->descriptors);
+    loan->descriptors = NULL;
+    status = crucible_metadata_native_retire(&startup_source.metadata_partition,
+                                             &loan->charge);
+    if (status) {
+        loan->uncertain = true;
+        loan->post_status = status;
+        crucible_metadata_partition_record_post(&startup_source.metadata_partition,
+                                                status);
+        qatomic_store_release(&loan->cut, 0);
+        return transferred;
+    }
+    retained_chardev = loan->chardev;
+    channel = loan->channel;
+    loan->chardev = NULL;
+    loan->channel = NULL;
+    loan->descriptor_capacity = 0;
+    loan->descriptor_count = 0;
+    loan->received = false;
+    loan->active = false;
+    qatomic_store_release(&loan->cut, 0);
+
+    /* Actual object finalization runs outside the accounting and ingress cuts. */
+    object_unref(OBJECT(channel));
+    object_unref(OBJECT(retained_chardev));
+    return transferred;
+}
diff --git a/plugins/crucible-startup-source.c b/plugins/crucible-startup-source.c
