+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Check literal Native custody predicates without a Source Quantum issuer.
+
+The sample journals below are component inputs. They do not acquire QOM custody,
+enter RR, issue a semantic child, execute guest code or qualify a lifecycle.
+Main return controls supply only an action refusal and abort-only cleanup edges.
+Use configured QEMU include/compiler flags through CC, CFLAGS and LDFLAGS.
+"""
+
+import argparse
+import json
+import os
+from pathlib import Path
+import runpy
+import shlex
+import subprocess
+
+
+CHECKS = r"""
+#include <assert.h>
+#include <sys/wait.h>
+
+static CPUState cpu;
+
+static void *foreign_thread(void *unused)
+{
+    assert(qemu_crucible_quantum_cpu_rr_current_v1(&cpu) == -ESTALE);
+    return NULL;
+}
+
+int main(void)
+{
+    QemuCrucibleQuantumCpuExecution *holder = &cpu.crucible_quantum_execution;
+    QemuCrucibleQuantumCpuExecution *execution = holder;
+    pthread_t thread;
+    int status;
+
+    /* Exercise the absent factual journal without any semantic child. */
+    qemu_crucible_quantum_cpu_execution_start_v1(&cpu);
+    qemu_crucible_quantum_cpu_execution_revoke_v1(&cpu);
+    qemu_crucible_quantum_cpu_cleanup_v1(&cpu);
+    qemu_crucible_quantum_cpu_execution_end_v1(&cpu);
+    assert(!execution->execution_started && !execution->execution_ended);
+
+    *execution = (QemuCrucibleQuantumCpuExecution) {
+        .cpu = &cpu, .holder = &holder, .process = getpid(),
+        .serial = 1, .retained = true,
+    };
+    qemu_thread_get_self(&execution->thread);
+    assert(!qemu_crucible_quantum_cpu_rr_current_v1(&cpu));
+
+    holder = NULL;
+    assert(qemu_crucible_quantum_cpu_rr_current_v1(&cpu) == -ESTALE);
+    holder = execution;
+    execution->serial = 0;
+    assert(qemu_crucible_quantum_cpu_rr_current_v1(&cpu) == -ESTALE);
+    execution->serial = 1;
+    execution->rr_returned = true;
+    assert(qemu_crucible_quantum_cpu_rr_current_v1(&cpu) == -ESTALE);
+    execution->rr_returned = false;
+
+    assert(!pthread_create(&thread, NULL, foreign_thread, NULL));
+    assert(!pthread_join(thread, NULL));
+    pid_t child = fork();
+    assert(child >= 0);
+    if (!child) {
+        assert(qemu_crucible_quantum_cpu_rr_current_v1(&cpu) == -ESTALE);
+        _exit(0);
+    }
+    assert(waitpid(child, &status, 0) == child);
+    assert(WIFEXITED(status) && WEXITSTATUS(status) == 0);
+
+    qemu_crucible_quantum_cpu_execution_start_v1(&cpu);
+    assert(execution->execution_started && !execution->execution_ended);
+    qemu_crucible_quantum_cpu_execution_revoke_v1(&cpu);
+    qemu_crucible_quantum_cpu_cleanup_v1(&cpu);
+    assert(execution->cleanup_completed && execution->permission_revoked);
+    assert(execution->retained && holder == execution);
+    assert(!execution->execution_ended && !execution->rr_returned);
+    assert(!execution->child && !execution->allocation && !execution->receipt);
+    qemu_crucible_quantum_cpu_execution_end_v1(&cpu);
+    assert(execution->execution_ended && execution->permission_revoked);
+    assert(execution->retained && holder == execution && !execution->rr_returned);
+    puts("PASS literal Native state predicates; no RR/QOM/Source admission or guest execution");
+    return 0;
+}
+"""
+
+
+MAIN_RETURN_EDGES = r"""
+static QemuCrucibleStartupSourceControl startup_source;
+static unsigned action_return_calls;
+
+/* Refusal only: these controls supply no module action or successful return.
+ * Every downstream lifetime edge aborts if the literal guard lets it run. */
+int qemu_crucible_source_action_original_return_v1(QemuCrucibleMainControlBorrow *borrow)
+{
+    assert(borrow == &startup_source.main_control_borrow);
+    action_return_calls++;
+    return -EIO;
+}
+
+int qemu_plugin_crucible_native_main_control_current_v1(
+    QemuCrucibleNativeInvocationTicket *holder, bool returned)
+{
+    abort();
+}
+
+int qemu_crucible_source_main_payload_return_v1(QemuCrucibleMainControlBorrow *borrow)
+{
+    abort();
+}
+
+int qemu_plugin_crucible_native_main_control_cpu_return_v1(
+    QemuCrucibleNativeInvocationTicket *holder)
+{
+    abort();
+}
+
+int qemu_crucible_source_main_control_return_v1(QemuCrucibleMainControlBorrow **holder)
+{
+    abort();
+}
+
+int qemu_plugin_crucible_native_main_control_finish_v1(
+    QemuCrucibleNativeInvocationTicket *holder, QemuCrucibleMainControlBorrow *borrow)
+{
+    abort();
+}
+"""
+
+
+MAIN_RETURN_CHECKS = r"""
+int main(void)
+{
+    QemuCrucibleMainControlBorrow *borrow = &startup_source.main_control_borrow;
+    QemuCrucibleNativeInvocation frame = { 0 };
+    int status;
+
+    assert(qemu_crucible_source_action_original_closed_v1(NULL) == -EPERM);
+    assert(!qemu_crucible_source_action_original_closed_v1(borrow));
+    control_stop_main_return();
+    assert(!control_stop_storage.main.held && control_stop_storage.main.returned);
+    assert(!action_return_calls);
+
+    startup_source.action_original.held = true;
+    control_stop_storage.main.borrow = borrow;
+    control_stop_storage.main.ticket.frame = &frame;
+    control_stop_storage.main.payload_return_status = -ETIMEDOUT;
+    control_stop_main_return();
+    assert(action_return_calls == 1);
+    assert(control_stop_storage.main.return_status == -EIO);
+    assert(control_stop_storage.main.payload_return_status == -ETIMEDOUT);
+    assert(control_stop_storage.main.borrow == borrow);
+    assert(control_stop_storage.main.ticket.frame == &frame);
+    assert(control_stop_storage.main.held && !control_stop_storage.main.returned);
+
+    control_stop_storage.main.return_status = -ECANCELED;
+    control_stop_main_return();
+    assert(action_return_calls == 2);
+    assert(control_stop_storage.main.return_status == -ECANCELED);
+    assert(control_stop_storage.main.payload_return_status == -ETIMEDOUT);
+    assert(control_stop_storage.main.held && !control_stop_storage.main.returned);
+
+    /* A negative signed result with a closed predicate must reach cleanup.
+     * The child aborts at its first forbidden edge; it returns no real debt. */
+    pid_t child = fork();
+    assert(child >= 0);
+    if (!child) {
+        startup_source.action_original.held = false;
+        control_stop_main_return();
+        _exit(0);
+    }
+    assert(waitpid(child, &status, 0) == child);
+    assert(WIFSIGNALED(status) && WTERMSIG(status) == SIGABRT);
+
+    /* These component inputs have no physical fields. A saved error cannot
+     * fabricate retained debt or override their actual absent-field facts. */
+    startup_source.action_original.held = false;
+    control_stop_storage.main.borrow = NULL;
+    control_stop_storage.main.ticket.frame = NULL;
+    control_stop_main_return();
+    assert(!control_stop_storage.main.held && control_stop_storage.main.returned);
+    assert(control_stop_storage.main.return_status == -ECANCELED);
+    puts("PASS literal Main return refusals; no successful provider or physical return");
+    return 0;
+}
+"""
+
+
+def check_main_return(source, output, extract):
+    output.mkdir(parents=True, exist_ok=True)
+    core = (source / "plugins/crucible-control-stop.inc.h").read_text()
+    storage = core[:core.index("uint64_t qemu_plugin_crucible_control_stop_storage_bytes_v1(")]
+    action = (source / "plugins/crucible-action-original.inc.h").read_text()
