+static void write_child_result(int fd, int result)
+{
+    ssize_t written;
+
+    do {
+        written = write(fd, &result, sizeof(result));
+    } while (written < 0 && errno == EINTR);
+}
+
+static int read_child_result(int fd)
+{
+    int result = -EIO;
+    ssize_t received;
+
+    do {
+        received = read(fd, &result, sizeof(result));
+    } while (received < 0 && errno == EINTR);
+    g_assert_cmpint(received, ==, sizeof(result));
+    return result;
+}
+
+static void wait_for_child(pid_t child)
+{
+    int status;
+    pid_t waited;
+
+    do {
+        waited = waitpid(child, &status, 0);
+    } while (waited < 0 && errno == EINTR);
+    g_assert_cmpint(waited, ==, child);
+    g_assert_true(WIFEXITED(status));
+    g_assert_cmpint(WEXITSTATUS(status), ==, 0);
+}
+
+typedef struct RegistryWorker {
+    int ready_fd;
+    int release_fd;
+} RegistryWorker;
+
+typedef struct RegistryWorkerThread {
+    RegistryWorker worker;
+    QemuThread thread;
+    int ready[2];
+    int release[2];
+} RegistryWorkerThread;
+
+static void *registry_worker(void *opaque)
+{
+    RegistryWorker *worker = opaque;
+
+    write_child_result(worker->ready_fd, 0);
+    (void)read_child_result(worker->release_fd);
+    return NULL;
+}
+
+static void *aio_registry_worker(void *opaque)
+{
+    qemu_thread_hot_fork_set_current_disposition(
+        QEMU_THREAD_HOT_FORK_UNCLASSIFIED_AIO);
+    return registry_worker(opaque);
+}
+
+static void *monitor_registry_worker(void *opaque)
+{
+    void *result;
+
+    qemu_thread_hot_fork_set_current_disposition(
+        QEMU_THREAD_HOT_FORK_MONITOR_RESTART);
+    rcu_register_thread();
+    result = registry_worker(opaque);
+    rcu_unregister_thread();
+    return result;
+}
+
+static void *vcpu_registry_worker(void *opaque)
+{
+    void *result;
+
+    qemu_thread_hot_fork_set_current_disposition(
+        QEMU_THREAD_HOT_FORK_VCPU_RESTART);
+    rcu_register_thread();
+    result = registry_worker(opaque);
+    rcu_unregister_thread();
+    return result;
+}
+
+static void *monitor_registry_worker_with_runtime_barriers(void *opaque)
+{
+    RegistryWorker *worker = opaque;
+    QemuAsyncWorkerHotForkBarrierInventory async_inventory;
+    QemuRcuHotForkBarrierInventory rcu_inventory;
+    int result = 0;
+
+    qemu_thread_hot_fork_set_current_disposition(
+        QEMU_THREAD_HOT_FORK_MONITOR_RESTART);
+    rcu_register_thread();
+    qemu_rcu_hot_fork_barrier(QEMU_RCU_HOT_FORK_BARRIER_HOLD,
+                              &rcu_inventory);
+    qemu_async_worker_hot_fork_barrier(
+        QEMU_ASYNC_WORKER_HOT_FORK_BARRIER_HOLD, &async_inventory);
+    if (!rcu_inventory.held || !rcu_inventory.quiescent ||
+        rcu_inventory.owner_thread_id != qemu_get_thread_id() ||
+        !async_inventory.held || !async_inventory.quiescent ||
+        async_inventory.owner_thread_id != qemu_get_thread_id()) {
+        result = -EPROTO;
+    }
+    write_child_result(worker->ready_fd, result);
+    if (result == 0) {
+        (void)read_child_result(worker->release_fd);
+    }
+    if (async_inventory.held &&
+        async_inventory.owner_thread_id == qemu_get_thread_id()) {
+        qemu_async_worker_hot_fork_barrier(
+            QEMU_ASYNC_WORKER_HOT_FORK_BARRIER_RELEASE, &async_inventory);
+    }
+    if (rcu_inventory.held &&
+        rcu_inventory.owner_thread_id == qemu_get_thread_id()) {
+        qemu_rcu_hot_fork_barrier(QEMU_RCU_HOT_FORK_BARRIER_RELEASE,
+                                  &rcu_inventory);
+    }
+    rcu_unregister_thread();
+    return NULL;
+}
+
+static void start_registry_worker_thread(
+    RegistryWorkerThread *worker, const char *name,
+    void *(*start_routine)(void *))
+{
+    g_assert_cmpint(pipe2(worker->ready, O_CLOEXEC), ==, 0);
+    g_assert_cmpint(pipe2(worker->release, O_CLOEXEC), ==, 0);
+    worker->worker = (RegistryWorker) {
+        .ready_fd = worker->ready[1],
+        .release_fd = worker->release[0],
+    };
+    qemu_thread_create(&worker->thread, name, start_routine, &worker->worker,
+                       QEMU_THREAD_JOINABLE);
+    g_assert_cmpint(read_child_result(worker->ready[0]), ==, 0);
+}
+
+static void stop_registry_worker_thread(RegistryWorkerThread *worker)
+{
+    write_child_result(worker->release[1], 0);
+    qemu_thread_join(&worker->thread);
+    close(worker->release[0]);
+    close(worker->release[1]);
+    close(worker->ready[0]);
+    close(worker->ready[1]);
+}
