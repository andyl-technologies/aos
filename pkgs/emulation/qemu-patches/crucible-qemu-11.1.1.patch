+
+static __thread unsigned int qemu_plugin_crucible_exact_boundary_depth;
+static __thread unsigned int qemu_plugin_crucible_control_boundary_depth;
+static __thread CPUState *qemu_plugin_crucible_idle_callback_cpu;
+static __thread unsigned int qemu_plugin_crucible_idle_callback_depth;
+static __thread CPUState *qemu_plugin_crucible_resume_callback_cpu;
+static __thread unsigned int qemu_plugin_crucible_resume_callback_depth;
+static __thread bool qemu_plugin_crucible_idle_wait_issued;
+static __thread QemuPluginCrucibleIdleCallbackDisposition
+    qemu_plugin_crucible_idle_callback_disposition;
+static int qemu_plugin_crucible_vmstop_state;
+static int qemu_plugin_crucible_vmstop_flush_result;
+/* Every successful native admission owns a distinct process-local stop. */
+static uint64_t qemu_plugin_crucible_vmstop_generation_value;
+static bool qemu_plugin_crucible_vmstop_cold_admitted;
+static uint64_t qemu_plugin_crucible_vmstop_cold_generation;
+
+enum {
+    QEMU_PLUGIN_CRUCIBLE_VMSTOP_IDLE,
+    QEMU_PLUGIN_CRUCIBLE_VMSTOP_ADMITTED,
+    QEMU_PLUGIN_CRUCIBLE_VMSTOP_STOPPED,
+    QEMU_PLUGIN_CRUCIBLE_VMSTOP_RESUME_PENDING,
+};
+
+#include "crucible-control-stop.inc.h"
+
+/* Never samples a clock or another executing CPU's architecture state. */
+static void qemu_plugin_trace_stop_context(CrucibleStopContextPhase phase)
+{
+    CrucibleStopContext context;
+    CPUState *cpu = NULL;
+    const char *scope = NULL;
+    int saved_errno;
+
+    if (!rr_crucible_sim_control_delivery_trace_enabled()) {
+        return;
+    }
+    /* Ordinary idle-time/control epochs are outside this stop diagnostic. */
+    if (phase >= CRUCIBLE_STOP_REARM_NO_CPU &&
+        phase <= CRUCIBLE_STOP_REARM_NO_OWNER &&
+        !qemu_plugin_crucible_vmstop_pending()) {
+        return;
+    }
+    saved_errno = errno;
+    context = (CrucibleStopContext) {
+        .generation = qatomic_read(&qemu_plugin_crucible_vmstop_generation_value),
+        .request = qatomic_load_acquire(&qemu_plugin_rr_control_request_generation),
+        .ack = qatomic_load_acquire(&qemu_plugin_rr_control_ack_generation),
+        .complete = qatomic_load_acquire(&qemu_plugin_rr_control_complete_generation),
+        .state = qatomic_read(&qemu_plugin_crucible_vmstop_state),
+        .runstate = "unavailable",
+        .flush = qatomic_read(&qemu_plugin_crucible_vmstop_flush_result),
+        .fd = qatomic_read(&qemu_plugin_wake_fd),
+        .shutdown = "unavailable",
+        .advance = qatomic_load_acquire(&qemu_plugin_time_advance_pending),
+        .cpu = "scope=unavailable pc=unavailable",
+    };
+    if (bql_locked()) {
+        g_snprintf(context.runstate, sizeof(context.runstate), "%u", runstate_get());
+        g_snprintf(context.shutdown, sizeof(context.shutdown), "%u",
+                   qemu_force_shutdown_requested());
+    }
+    if (bql_locked() && current_cpu &&
+        qemu_plugin_crucible_exact_boundary_depth > 0) {
+        cpu = current_cpu;
+        scope = "callback";
+    } else if (bql_locked() && first_cpu &&
+               qemu_plugin_crucible_vmstop_quiesced() &&
+               runstate_check(RUN_STATE_PAUSED) && first_cpu->stopped &&
+               !qatomic_read(&first_cpu->running)) {
+        cpu = first_cpu;
+        scope = "stopped";
+    }
+    if (cpu) {
+        g_snprintf(context.cpu, sizeof(context.cpu),
+            "scope=%s cpu=%d running=%d stop=%d stopped=%d halted=%u"
+            " high=%d low=%u next=0x%x budget=%" PRId64 " pc=0x%" PRIx64,
+            scope, cpu->cpu_index, cpu->running, cpu->stop, cpu->stopped,
+            cpu->halted, (int16_t)cpu->neg.icount_decr.u16.high,
+            cpu->neg.icount_decr.u16.low, cpu->cflags_next_tb,
+            cpu->icount_budget, (uint64_t)cpu->cc->get_pc(cpu));
+    }
+    crucible_stop_context_emit(phase, &context);
+    errno = saved_errno;
+}
+
+static int qemu_plugin_crucible_vmstop_begin(bool ordinary)
+{
+    if (ordinary && qemu_plugin_crucible_startup_source_retained()) {
+        int status = qemu_crucible_checkpoint_stop_admission_current_v1();
+
+        if (status) {
+            return status;
+        }
+    }
+
+    if (icount_enabled() != ICOUNT_PRECISE ||
+        !qemu_plugin_crucible_single_threaded_rr()) {
+        return -EPERM;
+    }
+
+    if (qatomic_read(&qemu_plugin_crucible_vmstop_generation_value) ==
+        UINT64_MAX) {
+        return -EOVERFLOW;
+    }
+    if (qatomic_cmpxchg(&qemu_plugin_crucible_vmstop_state,
+                       QEMU_PLUGIN_CRUCIBLE_VMSTOP_IDLE,
+                       QEMU_PLUGIN_CRUCIBLE_VMSTOP_ADMITTED) !=
+        QEMU_PLUGIN_CRUCIBLE_VMSTOP_IDLE) {
+        return -EALREADY;
+    }
+
+    qatomic_set(&qemu_plugin_crucible_vmstop_flush_result, 0);
+    qatomic_set(&qemu_plugin_crucible_vmstop_generation_value,
+                qatomic_read(&qemu_plugin_crucible_vmstop_generation_value) + 1);
+    if (ordinary) {
+        control_stop_storage.admission_commit = true;
+        qemu_plugin_crucible_source_control_stop_intent_admitted_v1(
+            &control_stop_storage.stop);
+        control_stop_storage.admission_commit = false;
+        qemu_crucible_checkpoint_stop_admitted_v1();
+    }
+
+    return 0;
+}
+
+int qemu_plugin_crucible_vmstop_qmp_admit_v1(void)
+{
+    if (!qemu_in_main_thread() || !bql_locked() || qemu_in_coroutine() ||
+        current_cpu || !monitor_cur()) {
+        return -EPERM;
+    }
+    return qemu_plugin_crucible_vmstop_begin(true);
+}
+
+int qemu_plugin_crucible_vmstop_admit_internal(void)
+{
+    int status = qemu_plugin_crucible_vmstop_begin(true);
+
+    if (status != 0) {
+        return status;
+    }
+
+    /*
+     * Always queue the runstate transition for the main loop.  Exact device
+     * completion callbacks may run without current_cpu even though they are
+     * inside the deterministic sim dispatch boundary; vm_stop() would perform
+     * a synchronous drain there and deadlock against the callback being
+     * completed.  The request pair is the asynchronous half of vm_stop(), and
+     * cpu_stop_current() preserves its vCPU-exit behavior when current_cpu is
+     * available.  QMP query-status remains the completion channel.
+     */
+    qemu_system_vmstop_request_prepare();
+    qemu_system_vmstop_request(RUN_STATE_PAUSED);
+    cpu_stop_current();
+    if (current_cpu && current_cpu->running) {
+        /*
+         * This admitted guest-coordinate stop must end the TCG chain. The
+         * generic RR kick defers host wakes until the quantum boundary and
+         * therefore does not set the decrementer exit flag. A last-I/O TB
+         * can still jump directly to another TB without testing exit_request.
+         * Request the stock TCG exit without unwinding the callback stack.
+         */
+        tcg_kick_vcpu_thread(current_cpu);
+    }
+    qemu_plugin_trace_stop_context(CRUCIBLE_STOP_ASYNC_ADMITTED);
+    return 0;
+}
+
+static int qemu_plugin_crucible_vmstop_at_control_boundary(void)
+{
+    int status = qemu_plugin_crucible_vmstop_begin(true);
+
+    if (status != 0) {
+        return status;
+    }
+
+    /*
+     * A drained control wake runs directly from the main-loop event handler,
+     * outside every device coroutine.  Stop synchronously here so QEMU cannot
+     * dispatch another TCG slice between the plugin's exact publication and
+     * RUN_STATE_PAUSED.  Device-completion callbacks use the asynchronous path
+     * above because a synchronous block drain would recurse into their own
+     * in-flight coroutine.
+     */
+    qemu_plugin_trace_stop_context(CRUCIBLE_STOP_CONTROL_ADMITTED);
+    status = vm_stop(RUN_STATE_PAUSED);
+    if (status != 0 && !qemu_plugin_crucible_startup_source_retained()) {
+        qatomic_set(&qemu_plugin_crucible_vmstop_state,
+                    QEMU_PLUGIN_CRUCIBLE_VMSTOP_IDLE);
+    }
+    /* Selected Source retains any actual admission and failed drain outcome. */
+    return status;
+}
+
+int qemu_plugin_request_vmstop(void)
+{
+    QemuCrucibleSourceControlStopIntent *intent = NULL;
+    int status;
+
+    if (qemu_plugin_crucible_startup_source_retained()) {
+        status = qemu_plugin_crucible_source_control_stop_intent_borrow_v1(&intent);
+        if (status) {
+            return status;
+        }
+        status = qemu_crucible_checkpoint_stop_intent_control_v1(intent);
+        if (status) {
+            intent->first_status = status;
+            return status;
+        }
+        /* Only the genuine Main control callback reaches this selected path.
+         * RR/device callers require their own captured invocation issuer.
+         */
+        intent->admission_call = true;
+        status = qemu_plugin_crucible_vmstop_at_control_boundary();
+        intent->admission_call = false;
+        if (status && !intent->first_status) {
+            intent->first_status = status;
+        }
+        return status;
+    }
+    if (qemu_plugin_crucible_exact_boundary_depth == 0) {
+        return -EPERM;
+    }
+    if (qemu_plugin_crucible_control_boundary_depth > 0) {
+        return qemu_plugin_crucible_vmstop_at_control_boundary();
+    }
+    return qemu_plugin_crucible_vmstop_admit_internal();
+}
+
+void qemu_plugin_crucible_exact_boundary_enter(void)
+{
+    g_assert(qemu_plugin_crucible_exact_boundary_depth < UINT_MAX);
+    qemu_plugin_crucible_exact_boundary_depth++;
+}
+
+void qemu_plugin_crucible_exact_boundary_leave(void)
+{
+    g_assert(qemu_plugin_crucible_exact_boundary_depth > 0);
+    qemu_plugin_crucible_exact_boundary_depth--;
+}
+
+bool qemu_plugin_crucible_exact_boundary_active(void)
+{
+    return qemu_plugin_crucible_exact_boundary_depth > 0;
+}
+
+bool qemu_plugin_crucible_resume_callback_active(CPUState *cpu)
+{
+    return cpu && cpu == qemu_plugin_crucible_resume_callback_cpu &&
+        qemu_plugin_crucible_resume_callback_depth == 1 &&
+        qemu_plugin_crucible_exact_boundary_depth == 1 && bql_locked() &&
+        icount_enabled() == ICOUNT_PRECISE &&
+        qemu_plugin_crucible_single_threaded_rr() && cpu->created &&
+        !cpu->unplug && QTAILQ_IN_USE(cpu, node);
+}
+
+bool qemu_plugin_crucible_control_boundary_active(void)
+{
+    return qemu_plugin_crucible_control_boundary_depth > 0;
+}
+
+bool qemu_plugin_crucible_vmstop_pending(void)
+{
+    return qatomic_read(&qemu_plugin_crucible_vmstop_state) !=
+           QEMU_PLUGIN_CRUCIBLE_VMSTOP_IDLE;
+}
+
+bool qemu_plugin_crucible_vmstop_admission_pending(void)
+{
+    return qatomic_read(&qemu_plugin_crucible_vmstop_state) ==
+           QEMU_PLUGIN_CRUCIBLE_VMSTOP_ADMITTED;
+}
+
+bool qemu_plugin_crucible_vmstop_quiesced(void)
+{
+    return qatomic_read(&qemu_plugin_crucible_vmstop_state) ==
+               QEMU_PLUGIN_CRUCIBLE_VMSTOP_STOPPED &&
+           qatomic_read(&qemu_plugin_crucible_vmstop_flush_result) == 0;
+}
+
+uint64_t qemu_plugin_crucible_vmstop_generation(void)
+{
+    return qatomic_read(&qemu_plugin_crucible_vmstop_generation_value);
+}
+
+int qemu_plugin_crucible_vmstop_cold_begin(void)
+{
+    int status;
+
+    g_assert(bql_locked());
+    if (qemu_plugin_crucible_control_boundary_outstanding()) {
+        return -EBUSY;
+    }
+
+    status = qemu_plugin_crucible_vmstop_begin(false);
+
+    if (status == 0) {
+        qemu_plugin_crucible_vmstop_cold_admitted = true;
+    }
+    return status;
+}
+
+bool qemu_plugin_crucible_vmstop_cold_publish(uint64_t generation)
+{
+    if (!generation || !qemu_plugin_crucible_vmstop_cold_admitted ||
+        qatomic_read(&qemu_plugin_crucible_vmstop_state) !=
+            QEMU_PLUGIN_CRUCIBLE_VMSTOP_ADMITTED) {
+        return false;
+    }
+
+    qemu_plugin_crucible_vmstop_cold_generation = generation;
+    qatomic_set(&qemu_plugin_crucible_vmstop_flush_result, 0);
+    qatomic_set(&qemu_plugin_crucible_vmstop_state,
+                QEMU_PLUGIN_CRUCIBLE_VMSTOP_STOPPED);
+    return true;
+}
+
+void qemu_plugin_crucible_vmstop_cold_abort(void)
+{
+    if (qemu_plugin_crucible_vmstop_cold_admitted) {
+        qatomic_set(&qemu_plugin_crucible_vmstop_state,
+                    QEMU_PLUGIN_CRUCIBLE_VMSTOP_IDLE);
+    }
+    qemu_plugin_crucible_vmstop_cold_admitted = false;
+    qemu_plugin_crucible_vmstop_cold_generation = 0;
+}
+
+bool qemu_plugin_crucible_vmstop_cold_origin(void)
+{
+    return qemu_plugin_crucible_vmstop_cold_admitted;
+}
+
+bool qemu_plugin_crucible_vmstop_cold_receipt(uint64_t generation)
+{
+    return generation != 0 &&
+        qemu_plugin_crucible_vmstop_cold_admitted &&
+        qemu_plugin_crucible_vmstop_cold_generation == generation &&
+        qemu_plugin_crucible_vmstop_quiesced();
+}
+
+void qemu_plugin_crucible_vmstop_request_stopped(int flush_status)
+{
+    if (!qemu_plugin_crucible_vmstop_cold_admitted &&
+        qatomic_read(&qemu_plugin_crucible_vmstop_state) ==
+        QEMU_PLUGIN_CRUCIBLE_VMSTOP_ADMITTED) {
+        qatomic_set(&qemu_plugin_crucible_vmstop_flush_result, flush_status);
+        qatomic_cmpxchg(&qemu_plugin_crucible_vmstop_state,
+                        QEMU_PLUGIN_CRUCIBLE_VMSTOP_ADMITTED,
+                        QEMU_PLUGIN_CRUCIBLE_VMSTOP_STOPPED);
+        /* Actual ADMITTED->STOPPED receipt after cpus.c drain/flush. Never
+         * substitute vmstop_request_complete (which starts resume).
+         */
+        control_stop_storage.stopped_commit = true;
+        qemu_plugin_crucible_source_control_stop_intent_stopped_v1(
+            &control_stop_storage.stop, flush_status);
+        control_stop_storage.stopped_commit = false;
+        qemu_crucible_checkpoint_stop_completed_v1(flush_status);
+        qemu_crucible_checkpoint_paused_reap_v1();
+        qemu_plugin_trace_stop_context(CRUCIBLE_STOP_PUBLISHED);
+        if (qemu_plugin_crucible_rr_control_boundary_pending()) {
+            /* A reader during admission still names the running RR owner. */
+            qemu_plugin_crucible_rr_control_boundary_defer();
+        } else {
+            qemu_plugin_rearm_deferred_control_boundary();
+        }
+        qemu_plugin_control_drain_notify();
+    }
+}
+
+int qemu_plugin_crucible_vmstop_flush_status(void)
+{
+    if (qatomic_read(&qemu_plugin_crucible_vmstop_state) !=
+        QEMU_PLUGIN_CRUCIBLE_VMSTOP_STOPPED) {
+        return 0;
+    }
+    return qatomic_read(&qemu_plugin_crucible_vmstop_flush_result);
+}
+
+void qemu_plugin_crucible_vmstop_request_complete(void)
+{
+    if (qatomic_cmpxchg(&qemu_plugin_crucible_vmstop_state,
+                       QEMU_PLUGIN_CRUCIBLE_VMSTOP_STOPPED,
+                       QEMU_PLUGIN_CRUCIBLE_VMSTOP_RESUME_PENDING) ==
+        QEMU_PLUGIN_CRUCIBLE_VMSTOP_STOPPED) {
+        qatomic_set(&qemu_plugin_crucible_vmstop_flush_result, 0);
+    }
+}
+
+bool qemu_plugin_crucible_vmstop_resume_consume(void)
+{
+    bool consumed = qatomic_cmpxchg(&qemu_plugin_crucible_vmstop_state,
+                                    QEMU_PLUGIN_CRUCIBLE_VMSTOP_RESUME_PENDING,
+                                    QEMU_PLUGIN_CRUCIBLE_VMSTOP_IDLE) ==
+        QEMU_PLUGIN_CRUCIBLE_VMSTOP_RESUME_PENDING;
+
+    if (consumed) {
+        qemu_plugin_crucible_vmstop_cold_admitted = false;
+        qemu_plugin_crucible_vmstop_cold_generation = 0;
+        qemu_plugin_rearm_deferred_control_boundary();
+    }
+    return consumed;
+}
+
+int qemu_plugin_crucible_single_threaded_rr(void)
+{
+    return strcmp(current_accel_name(), "sim") == 0 &&
+           !qemu_tcg_mttcg_enabled();
+}
