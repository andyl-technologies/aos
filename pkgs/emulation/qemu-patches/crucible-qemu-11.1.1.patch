+static int module_borrow_acquire(
+    QemuCrucibleModuleRequestPayload **payload_holder, uint64_t payload_serial,
+    QemuCrucibleModuleRequestPayloadBorrow **holder, uint64_t *serial,
+    uint32_t *known_absent, void *userdata)
