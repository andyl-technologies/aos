+typedef struct QemuCrucibleHotForkChildSubsystemReinitializers {
+    QemuCrucibleHotForkRuntimeTransaction *runtime;
+    QemuCrucibleHotForkDescriptorTableTransaction *descriptors;
+    QemuCrucibleHotForkChildResourcePlan *resources;
+    QemuCrucibleHotForkPluginChildReinitializer *plugin;
+    QemuCrucibleHotForkQmpChildReinitializer *qmp;
+    QemuCrucibleHotForkConsoleChildReinitializer *console;
+} QemuCrucibleHotForkChildSubsystemReinitializers;
