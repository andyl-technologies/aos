+        sizeof(cpu_boundary) +
+        sizeof(QemuCrucibleObservationCpuBoundaryScope) +
+        qemu_thread_ram_writer_fixed_storage_bytes();
+}
+
+static int cpu_boundary_current_locked(void *cpu, uint64_t generation)
+{
+    return cpu_boundary.scope && cpu_boundary.cpu == cpu &&
+        cpu_boundary.generation == generation &&
+        cpu_boundary.process == getpid() &&
+        qemu_thread_is_self(&cpu_boundary.thread) ? 0 : -ESTALE;
+}
+
+int qemu_crucible_observation_writer_acquire_v1(
+    uint64_t id, QemuCrucibleObservationWriterFence **out)
+{
+    int status;
+
+    if (!out || *out || !bql_locked()) {
+        return -EINVAL;
+    }
+    status = qemu_crucible_ram_fingerprint_root_invocation_current_v1(id);
+    if (status) {
+        return status;
+    }
+    if (qatomic_cmpxchg(&observation_writer_cut, 0, 1)) {
+        return -EBUSY;
+    }
+    if (observation_writer.held) {
+        status = -EBUSY;
+    } else {
