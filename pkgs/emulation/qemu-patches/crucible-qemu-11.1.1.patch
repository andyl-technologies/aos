+static void test_configuration(gconstpointer data)
+{
+    unsigned kind = GPOINTER_TO_UINT(data);
+    LoongArchCPU cpu = { 0 };
+    CPUSysState *sys;
+    __int128 deadline;
+    uint64_t configuration = kind == 4 ? 7 : 5;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+    initialize_clock(true);
+    initialize_timer(&cpu);
+    sys = env_sys(&cpu.env);
+    switch (kind) {
+    case 0:
+    case 4:
+        observed_ps = ((__int128)1 << 120) + 357;
+        break;
+    case 1:
+        observed_ps = -((__int128)1 << 120) + 357;
+        break;
+    case 2:
+        observed_ps = wide_time(INT64_MIN, 0);
+        break;
+    case 3:
+        observed_ps = (__int128)(UINT64_MAX - 2) * 10000 + 357;
+        break;
+    case 5:
+        observed_ps = -1;
+        configuration = 1;
+        break;
+    case 6:
+        observed_ps = ((__int128)1 << 120) + 357;
+        configuration = CONSTANT_TIMER_TICK_MASK | 1;
+        break;
+    default:
+        g_assert_not_reached();
+    }
+    deadline = observed_ps + (__int128)(configuration & CONSTANT_TIMER_TICK_MASK) *
+                             TIMER_PERIOD_PS;
+
+    cpu_loongarch_store_constant_timer_config(&cpu, configuration);
+
+    g_assert_cmpuint(sys->CSR_TCFG, ==, configuration);
+    g_assert_true(timer_pending(&cpu.timer));
+    g_assert_true(timer_expire_time_ps_wide(&cpu.timer) == deadline);
+    g_assert_cmpuint(cpu_loongarch_get_constant_timer_ticks(&cpu), ==,
+                     configuration & CONSTANT_TIMER_TICK_MASK);
+    observed_ps = deadline - 1;
+    qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL);
+    g_assert_cmpuint(callbacks, ==, 0);
+    observed_ps = deadline;
+    qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL);
+    g_assert_cmpuint(callbacks, ==, 1);
+    g_assert_cmpint(timer_pending(&cpu.timer), ==, kind == 4);
+    if (kind == 4) {
+        g_assert_true(timer_expire_time_ps_wide(&cpu.timer) == deadline + 40000);
+        observed_ps += 40000;
+        qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL);
+        g_assert_cmpuint(callbacks, ==, 2);
+        cpu_loongarch_store_constant_timer_config(&cpu, 0);
+        g_assert_false(timer_pending(&cpu.timer));
+    } else {
+        g_assert_cmpuint(sys->CSR_TCFG & 1, ==, 0);
+    }
+
+    destroy_timer(&cpu);
+}
