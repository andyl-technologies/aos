+static int checkpoint_stop_receipt_current(void)
+{
+    struct QemuCrucibleCheckpointStopOwner *stop = &checkpoint_stop_owner;
+    Monitor *monitor;
+    void *purpose;
+    uint64_t process_generation;
+    int status = qemu_crucible_checkpoint_storage_current_v1();
+
+    if (status) {
+        return status;
+    }
+    if (!stop->intent_born || !stop->allocation_retained ||
+        !stop->ordinary_intent_owner ||
+        (!stop->reservation && !stop->control_intent) ||
+        stop->process_id != getpid() || !qatomic_load_acquire(&stop->admitted) ||
+        !qatomic_load_acquire(&stop->published) ||
+        !qemu_thread_is_self(&stop->thread) || !qemu_in_main_thread() ||
+        !bql_locked() || qemu_in_coroutine() || stop->first_status ||
+        stop->post_status || !stop->completed_generation ||
+        stop->completed_generation != stop->admitted_generation ||
+        stop->completed_generation != qemu_plugin_crucible_vmstop_generation() ||
+        qemu_plugin_crucible_vmstop_cold_origin() ||
+        !qemu_plugin_crucible_vmstop_quiesced() ||
+        !qemu_crucible_checkpoint_pager_binding_current(&stop->source)) {
+        return -EPERM;
+    }
+    if (stop->control_intent) {
+        if (!stop->control_custody_retained || !stop->control_runtime ||
+            stop->ordinary_intent_owner != stop->control_intent || stop->reservation) {
+            return -EPERM;
+        }
+        return qemu_plugin_crucible_source_control_stop_intent_current_v1(
+            stop->control_intent, false);
+    }
+    status = monitor_qmp_stop_reservation_observe(
+        stop->reservation, &monitor, &purpose, &process_generation);
+    if (status || stop->ordinary_intent_owner != stop->reservation ||
+        !monitor || !purpose || !process_generation) {
+        return status ? status : -ESTALE;
+    }
+    return qemu_crucible_checkpoint_main_loop_current();
+}
+
+int qemu_crucible_checkpoint_stop_intent_control_v1(
+    QemuCrucibleSourceControlStopIntent *intent)
+{
+    struct QemuCrucibleCheckpointStopOwner *stop = &checkpoint_stop_owner;
+    QemuCrucibleStartupInstallerBinding installer;
+    QemuCrucibleStartupRuntimePurpose *runtime = NULL;
+    QemuCrucibleCheckpointPagerBinding source;
+    int status;
+
+    /* Authenticate the typed native loan before any nominal Receiving read
+     * can use it. The actual native dispatch remains its physical lender.
+     */
+    status = qemu_plugin_crucible_source_control_stop_intent_current_v1(intent, true);
+    if (!status) {
+        status = qemu_crucible_checkpoint_storage_current_v1();
+    }
+    if (status) {
+        return status;
+    }
+    if (qatomic_load_acquire(&stop->intent_born)) {
+        if (stop->control_intent != intent || !stop->control_custody_retained ||
+            stop->ordinary_intent_owner != intent || stop->reservation ||
+            stop->admitted || stop->published) {
+            return -EBUSY;
+        }
+        return stop->first_status ? stop->first_status : stop->post_status;
+    }
+    /* Preserve the same real loan before fallible Source projection/relation
+     * checks. A negative never releases it or replaces its native generation.
+     */
+    stop->process_id = getpid();
+    qemu_thread_get_self(&stop->admission_thread);
+    stop->control_intent = intent;
+    stop->ordinary_intent_owner = intent;
+    stop->control_custody_retained = true;
+    stop->allocation_retained = true;
+    qatomic_store_release(&stop->intent_born, true);
+
+    status = qemu_plugin_crucible_source_control_stop_intent_source_v1(
+        intent, &installer, &runtime);
+    if (!status) {
+        stop->control_runtime = runtime;
+        status = qemu_crucible_checkpoint_pager_binding_borrow(&source);
+    }
+    if (!status && (!runtime || installer.ctx != source.installer.ctx ||
+        installer.module != source.installer.module ||
+        installer.plugin_id != source.installer.plugin_id)) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        stop->source = source;
+    } else if (!stop->first_status) {
+        stop->first_status = status;
+    }
+    return status;
+}
+
+int qemu_crucible_checkpoint_stop_control_return_current_v1(
+    QemuCrucibleSourceControlStopIntent *intent)
+{
+    struct QemuCrucibleCheckpointStopOwner *stop = &checkpoint_stop_owner;
+    int status = qemu_plugin_crucible_source_control_stop_intent_current_v1(
+        intent, false);
+
+    if (status) {
+        return status;
+    }
+    if (!qatomic_load_acquire(&stop->intent_born) ||
+        stop->control_intent != intent || stop->ordinary_intent_owner != intent ||
+        stop->reservation || stop->process_id != getpid()) {
+        return -ENOKEY;
+    }
+    if (!stop->retirement_requested || !stop->retirement_owner_detached ||
+        stop->control_custody_retained || stop->transaction ||
+        !qemu_in_main_thread() || !bql_locked() || qemu_in_coroutine() ||
+        !qemu_thread_is_self(&stop->retirement_thread)) {
+        return -EBUSY;
+    }
+    return 0;
+}
+
+static bool checkpoint_stop_borrows_returned(void)
+{
+    QemuCrucibleCheckpointHeldTransaction *owner = &checkpoint_transaction;
+    QemuCrucibleCheckpointRequestLoan *request = &checkpoint_request;
+    uint32_t terminal;
+
+    if (checkpoint_stop_owner.transaction || owner->candidate_read.active ||
+        owner->inventory.active || owner->inventory.metadata_borrow ||
+        owner->inventory.output.held || owner->inventory.output.close_uncertain ||
+        owner->inventory.cancellation.held || owner->inventory.cancellation.close_uncertain || owner->invocation.active || owner->invoking || owner->cleanup_invoking ||
+        owner->proof_borrow.active || owner->producer_loan.active ||
+        owner->proof.borrowers || owner->proof.producer_borrowers ||
+        request->provider_invoking || request->snapshot_birth_pending ||
+        (request->snapshot_issued && !request->snapshot_dismissed)) {
+        return false;
+    }
+    if (!qatomic_load_acquire(&request->published)) {
+        return true;
+    }
+    terminal = qatomic_load_acquire(&request->terminal_state);
+    return !request->main_scope_active && request->provider_ended &&
+        request->receipt_returned && request->actor_pause_ended &&
+        (terminal == QEMU_CRUCIBLE_CHECKPOINT_TERMINAL_RETIRED ||
+         terminal == QEMU_CRUCIBLE_CHECKPOINT_TERMINAL_NO_ROOT) &&
+        (!owner->proof.retained || checkpoint_root_end_complete(owner));
+}
+
+int qemu_crucible_checkpoint_stop_retire_before_resume_v1(void)
+{
+    struct QemuCrucibleCheckpointStopOwner *stop = &checkpoint_stop_owner;
+    int status;
+
+    if (!qemu_plugin_crucible_startup_source_retained() || !stop->intent_born) {
+        return 0;
+    }
+    if (!qemu_in_main_thread() || !bql_locked() || qemu_in_coroutine() ||
+        !checkpoint_stop_borrows_returned()) {
+        return -EBUSY;
+    }
+    if (stop->retirement_physical_returned) {
+        return qemu_thread_is_self(&stop->retirement_thread) ? 0 : -EPERM;
+    }
+    if (!stop->retirement_requested) {
+        status = checkpoint_stop_receipt_current();
+        if (status) {
+            return status;
+        }
+    } else if (!qemu_thread_is_self(&stop->retirement_thread)) {
+        return -EPERM;
+    }
+    stop->retirement_requested = true;
+    qemu_thread_get_self(&stop->retirement_thread);
+    if (stop->control_intent) {
+        /* Reciprocal return temporarily detaches the actual semantic holder.
+         * A failed native/Source return restores the SAME real loan, never
+         * resets its effects or replaces the native admission generation.
+         */
+        stop->retirement_owner_detached = true;
+        stop->control_custody_retained = false;
+        status = qemu_plugin_crucible_source_control_stop_intent_return_v1(
+            stop->control_intent);
+        if (status) {
+            stop->control_custody_retained = true;
+            stop->retirement_owner_detached = false;
+        } else {
+            stop->control_intent = NULL;
+            stop->control_runtime = NULL;
+        }
+    } else {
+        status = monitor_qmp_stop_reservation_return(
+            &stop->reservation, &stop->retirement_monitor,
+            &stop->retirement_first_status, &stop->retirement_post_status);
+    }
+    if (status) {
+        if (!stop->retirement_first_status && !stop->retirement_post_status) {
+            stop->retirement_first_status = status;
+        }
+        return status;
+    }
+    stop->retirement_physical_returned = true;
+    return 0;
+}
+
+void qemu_crucible_checkpoint_stop_resume_committed_v1(void)
+{
+    struct QemuCrucibleCheckpointStopOwner *stop = &checkpoint_stop_owner;
+
+    /* The sole caller is the actual native successful resume-publication
+     * branch, before RR consumption. Terminal request/reply journals are
+     * separate and survive this ordinary execution-owner reset.
+     */
+    if (stop->intent_born && stop->retirement_requested &&
+        stop->retirement_physical_returned && !stop->control_intent &&
+        !stop->reservation && !stop->retirement_monitor && !stop->transaction &&
+        stop->process_id == getpid() && qemu_in_main_thread() && bql_locked() &&
+        !qemu_in_coroutine() && qemu_thread_is_self(&stop->retirement_thread) &&
+        stop->completed_generation == qemu_plugin_crucible_vmstop_generation()) {
+        checkpoint_last_stop_retirement.process = stop->process_id;
+        checkpoint_last_stop_retirement.completed_generation = stop->completed_generation;
+        checkpoint_last_stop_retirement.first_status = stop->retirement_first_status;
+        checkpoint_last_stop_retirement.post_status = stop->retirement_post_status;
+        checkpoint_last_stop_retirement.physical_returned = true;
+        checkpoint_last_stop_retirement.resume_published = true;
+        *stop = (struct QemuCrucibleCheckpointStopOwner) { 0 };
+    }
+}
