+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Exercises native static RAM placement authority with real Linux mappings.
+
+Production admission functions execute against private/shared mmap, memfd
+seals, descriptor identity and COW pages. The fixture models RAMBlock metadata;
+it does not replace syscalls or claim to execute a complete translated guest.
+Borrow inventory tests retain production paired counter and startup refusal bodies.
+Flash producer tests retain production dirty-mask and TCG invalidation routing;
+translated-code invalidation and optional block I/O are fixture endpoints.
+"""
+
+import argparse
+import json
+import os
+from pathlib import Path
+import re
+import shlex
+import subprocess
+
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+def definition(source: str, signature: str) -> str:
+    """Extracts the production function body, rather than duplicating policy."""
+    start = source.index(signature)
+    opening = source.index("{", start)
+    depth = 0
+    for index in range(opening, len(source)):
+        if source[index] == "{":
+            depth += 1
+        elif source[index] == "}":
+            depth -= 1
+            if depth == 0:
+                return source[start:index + 1]
+    raise AssertionError(f"unterminated native function: {signature}")
+
+
+def declaration(header: str, signature: str) -> str:
+    """Retains the actual public declaration before an extracted definition."""
+    start = header.index(signature)
+    return header[start:header.index(";", start) + 1]
+
+
+PRELUDE = r"""
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE
+#endif
+#ifndef CONFIG_LINUX
+#define CONFIG_LINUX 1
+#endif
+#include <assert.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <inttypes.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <sys/sysmacros.h>
+#include <unistd.h>
+#define RAM_PAGE_BYTES 4096
+#define MIN(a, b) ((a) < (b) ? (a) : (b))
+typedef struct MemoryRegion MemoryRegion;
+typedef struct RAMBlock {
+    MemoryRegion *mr;
+    uint8_t *host;
+    uint64_t used_length, max_length, fd_offset;
+    uint32_t flags;
+    int fd;
+    size_t page_size;
+} RAMBlock;
+static size_t qemu_real_host_page_size(void) { return sysconf(_SC_PAGESIZE); }
+static size_t qemu_ram_pagesize(RAMBlock *block) { return block->page_size; }
+"""
+
+
+TESTS = r"""
+static RAMBlock region(void *host, uint64_t length, int fd, uint32_t flags)
+{
+    return (RAMBlock) { .host = host, .used_length = length, .fd = fd,
+                       .flags = flags, .page_size = RAM_PAGE_BYTES };
+}
+
+static void anonymous_ranges(void)
+{
+    uint64_t flags;
+    uint8_t *private = mmap(NULL, 3 * RAM_PAGE_BYTES, PROT_READ | PROT_WRITE,
+                           MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    assert(private != MAP_FAILED);
+    memset(private, 0xa5, 3 * RAM_PAGE_BYTES);
+    RAMBlock block = region(private, RAM_PAGE_BYTES, -1, 0);
+    assert(arena_placement_authority(&block, &flags) == 0);
+    assert(flags == QEMU_PLUGIN_CRUCIBLE_RAM_ARENA_PAGEABLE);
+
+    block = region(private + 19, RAM_PAGE_BYTES + 3, -1, RAM_PREALLOC);
+    assert(arena_placement_authority(&block, &flags) == 0);
+    assert(flags == QEMU_PLUGIN_CRUCIBLE_RAM_ARENA_PINNED);
+    /* Admission neither widens the extent nor modifies adjacent bytes. */
+    assert(block.host == private + 19 && block.used_length == RAM_PAGE_BYTES + 3);
+    for (size_t index = 0; index < 3 * RAM_PAGE_BYTES; index++) {
+        assert(private[index] == 0xa5);
+    }
+    block = region(private, RAM_PAGE_BYTES + 1, -1, 0);
+    assert(arena_placement_authority(&block, &flags) == 0);
+    assert(flags == QEMU_PLUGIN_CRUCIBLE_RAM_ARENA_PINNED);
+    block.flags = RAM_PROTECTED;
+    assert(arena_placement_authority(&block, &flags) == -ENOTSUP);
+    assert(munmap(private, 3 * RAM_PAGE_BYTES) == 0);
+
+    void *shared = mmap(NULL, RAM_PAGE_BYTES, PROT_READ | PROT_WRITE,
+                        MAP_SHARED | MAP_ANONYMOUS, -1, 0);
+    assert(shared != MAP_FAILED);
+    block = region(shared, RAM_PAGE_BYTES, -1, RAM_PREALLOC);
+    assert(arena_placement_authority(&block, &flags) == -ENOTSUP);
+    assert(munmap(shared, RAM_PAGE_BYTES) == 0);
+}
+
+static void file_authority(void)
+{
+    uint64_t flags;
+    char path[] = "mutable-ram-XXXXXX";
+    int writable = mkstemp(path);
+    assert(writable >= 0 && ftruncate(writable, RAM_PAGE_BYTES) == 0);
+    int readonly = open(path, O_RDONLY | O_CLOEXEC);
+    assert(readonly >= 0);
+    uint8_t *private = mmap(NULL, RAM_PAGE_BYTES, PROT_READ | PROT_WRITE,
+                           MAP_PRIVATE, readonly, 0);
+    assert(private != MAP_FAILED);
+    RAMBlock block = region(private, RAM_PAGE_BYTES, readonly,
+                            RAM_NAMED_FILE | RAM_READONLY_FD);
+    assert(arena_placement_authority(&block, &flags) == -ENOTSUP);
+    assert(pwrite(writable, "x", 1, 0) == 1 && private[0] == 'x');
+    assert(munmap(private, RAM_PAGE_BYTES) == 0);
+    assert(close(readonly) == 0 && close(writable) == 0 && unlink(path) == 0);
+
+    int future = memfd_create("future-write-is-not-immutable", MFD_CLOEXEC | MFD_ALLOW_SEALING);
+    assert(future >= 0 && ftruncate(future, RAM_PAGE_BYTES) == 0);
+    void *old_writer = mmap(NULL, RAM_PAGE_BYTES, PROT_READ | PROT_WRITE,
+                            MAP_SHARED, future, 0);
+    assert(old_writer != MAP_FAILED);
+    assert(fcntl(future, F_ADD_SEALS,
+                 F_SEAL_FUTURE_WRITE | F_SEAL_GROW | F_SEAL_SHRINK | F_SEAL_SEAL) == 0);
+    block = region(old_writer, RAM_PAGE_BYTES, future, RAM_SHARED);
+    assert(arena_placement_authority(&block, &flags) == -ENOTSUP);
+    ((uint8_t *)old_writer)[0] = 'w';
+    assert(munmap(old_writer, RAM_PAGE_BYTES) == 0 && close(future) == 0);
+
+    int sealed = memfd_create("immutable-ram", MFD_CLOEXEC | MFD_ALLOW_SEALING);
+    assert(sealed >= 0 && ftruncate(sealed, 2 * RAM_PAGE_BYTES) == 0);
+    assert(pwrite(sealed, "basis", 5, RAM_PAGE_BYTES) == 5);
+    assert(fcntl(sealed, F_ADD_SEALS,
+                 F_SEAL_WRITE | F_SEAL_GROW | F_SEAL_SHRINK | F_SEAL_SEAL) == 0);
+    private = mmap(NULL, RAM_PAGE_BYTES, PROT_READ | PROT_WRITE,
+                   MAP_PRIVATE, sealed, RAM_PAGE_BYTES);
+    assert(private != MAP_FAILED);
+    block = region(private, RAM_PAGE_BYTES, sealed, RAM_NAMED_FILE);
+    block.fd_offset = RAM_PAGE_BYTES;
+    assert(arena_placement_authority(&block, &flags) == 0);
+    assert(flags == (QEMU_PLUGIN_CRUCIBLE_RAM_ARENA_PINNED |
+                     QEMU_PLUGIN_CRUCIBLE_RAM_ARENA_IMMUTABLE_FILE));
+    private[0] = 'c';
+    assert(arena_placement_authority(&block, &flags) == 0);
+    char original;
+    assert(pread(sealed, &original, 1, RAM_PAGE_BYTES) == 1 && original == 'b');
+    assert(pwrite(sealed, "wrong", 5, 0) == -1 && errno == EPERM);
+    assert(ftruncate(sealed, 0) == -1 && errno == EPERM);
+    int other = memfd_create("different-immutable-inode", MFD_CLOEXEC | MFD_ALLOW_SEALING);
+    assert(other >= 0 && ftruncate(other, 2 * RAM_PAGE_BYTES) == 0);
+    assert(fcntl(other, F_ADD_SEALS,
+                 F_SEAL_WRITE | F_SEAL_GROW | F_SEAL_SHRINK | F_SEAL_SEAL) == 0);
+    block.fd = other;
+    assert(arena_placement_authority(&block, &flags) == -ENOTSUP);
+    assert(close(other) == 0);
+    block.fd = sealed;
+    block.fd_offset = 0;
+    assert(arena_placement_authority(&block, &flags) == -ENOTSUP);
+    block.fd_offset = 2 * RAM_PAGE_BYTES;
+    assert(arena_placement_authority(&block, &flags) == -ENOTSUP);
+    assert(munmap(private, RAM_PAGE_BYTES) == 0);
