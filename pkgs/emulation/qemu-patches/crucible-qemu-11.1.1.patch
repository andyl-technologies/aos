+static void fixture_cleanup(void)
+{
+    /* This child fixture ends after its assertions and synchronous borrowers.
+     * Reclaiming test descriptors is not a production provider/Root return. */
+    qemu_mutex_destroy(&admission_lock);
+    event_notifier_cleanup(&crucible_hot_fork_coordinator.wake);
+    for (unsigned role = 0; role < G_N_ELEMENTS(candidate_aliases); role++) {
+        if (candidate_aliases[role] >= 0) {
+            g_assert_cmpint(close(candidate_aliases[role]), ==, 0);
