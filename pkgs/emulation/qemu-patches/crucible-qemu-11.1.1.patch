+int qemu_crucible_preexec_purpose_check_v3(QemuCruciblePreexecPurposeOwner *held)
+{
+    QemuCruciblePreexecSetupOwner *owner = &preexec_setup_owner;
+    long process = preexec_setup_syscall5(SYS_getpid, 0, 0, 0, 0, 0);
+    long thread = preexec_setup_syscall5(SYS_gettid, 0, 0, 0, 0, 0);
+
+    if (held != owner || owner->process_id != process || owner->thread_id != thread) {
+        return -EPERM;
+    }
+    if (owner->first_status) {
+        return owner->first_status;
+    }
+    if (!owner->peer_validated || !owner->plan_validated ||
+        !owner->limits_corroborated || !owner->cgroup_corroborated ||
+        !owner->family_corroborated || !owner->identity_corroborated ||
+        !owner->artifact_verified || owner->close_status ||
+        !owner->fixed_family.retained || owner->fixed_family.issuer != owner ||
+        !owner->fixed_family.source.retained || !owner->fixed_family.target.reserved ||
+        owner->incarnation.assignment != &owner->fixed_family.source) {
+        return -ENOKEY;
+    }
+    {
+        int status = preexec_publisher_storage_current(owner);
+
+        if (!status) {
+            status = preexec_publisher_session_current(owner);
+        }
+        if (status) {
+            return status;
+        }
+    }
+    return preexec_setup_original_live();
+}
