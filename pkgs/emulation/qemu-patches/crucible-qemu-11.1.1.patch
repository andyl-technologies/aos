diff --git a/accel/tcg/tcg-accel-ops-rr.h b/accel/tcg/tcg-accel-ops-rr.h
index 2a76a296127e81edc61f45a59785a89705daae90..aa8160b876cf4cb9b142c1373367660ae3aa9747 100644
--- a/accel/tcg/tcg-accel-ops-rr.h
+++ b/accel/tcg/tcg-accel-ops-rr.h
@@ -10,12 +10,225 @@
 #ifndef TCG_ACCEL_OPS_RR_H
 #define TCG_ACCEL_OPS_RR_H
 
+#include "qemu/atomic.h"
+#include "qemu/processor.h"
+
 #define TCG_KICK_PERIOD (NANOSECONDS_PER_SECOND / 10)
 
+typedef enum RRCrucibleSimExecState {
+    RR_TCG_EXEC_STARTING,
+    RR_TCG_EXEC_STARTING_WAKE_ARMING,
+    RR_TCG_EXEC_IDLE,
+    RR_TCG_EXEC_ACTIVE,
+    RR_TCG_EXEC_IDLE_WAKE_ARMING,
+    RR_TCG_EXEC_IDLE_WAKE_PENDING,
+    RR_TCG_EXEC_ACTIVE_WAKE_PENDING,
+    RR_TCG_EXEC_ACTIVE_WAKE_ARMING,
+} RRCrucibleSimExecState;
+
+typedef enum RRCrucibleSimWakeConsumeResult {
+    RR_TCG_WAKE_CONSUME_RETRY,
+    RR_TCG_WAKE_CONSUME_EMPTY,
+    RR_TCG_WAKE_CONSUME_PENDING,
+} RRCrucibleSimWakeConsumeResult;
+
+typedef struct RRCrucibleSimWakeSnapshot {
+    unsigned int state;
+    uint64_t publish_generation;
+    bool publication_pending;
+} RRCrucibleSimWakeSnapshot;
+
+static inline bool rr_crucible_sim_dispatch_wait_requires_rescan(
+    RRCrucibleSimWakeConsumeResult result)
+{
+    return result == RR_TCG_WAKE_CONSUME_PENDING;
+}
+
+static inline bool rr_crucible_sim_prepark_requires_rescan(
+    bool wake_pending, bool control_pending, bool lifecycle_pending,
+    bool work_pending, bool time_advance_pending,
+    bool awaiting_time_advance_completion,
+    bool awaiting_control_boundary_completion)
+{
+    return wake_pending || lifecycle_pending || work_pending ||
+           (control_pending && (!awaiting_control_boundary_completion ||
+                                !time_advance_pending)) ||
+           (time_advance_pending && !awaiting_time_advance_completion);
+}
+
+static inline bool rr_crucible_sim_control_boundary_needs_rearm(
+    uint64_t request_generation, uint64_t ack_generation,
+    uint64_t complete_generation, bool schedule_active)
+{
+    return !schedule_active && request_generation != complete_generation &&
+           ack_generation != complete_generation;
+}
+
+static inline bool rr_crucible_sim_wake_state_is_arming(unsigned int state)
+{
+    return state == RR_TCG_EXEC_STARTING_WAKE_ARMING ||
+           state == RR_TCG_EXEC_IDLE_WAKE_ARMING ||
+           state == RR_TCG_EXEC_ACTIVE_WAKE_ARMING;
+}
+
+/* Only active multi-vCPU RR can defer timer notification to its cursor. */
+static inline bool rr_crucible_sim_timer_notify_needs_cpu_work(
+    unsigned int state, bool time_advance_pending, bool single_vcpu)
+{
+    return single_vcpu ||
+           time_advance_pending ||
+           state == RR_TCG_EXEC_STARTING ||
+           state == RR_TCG_EXEC_IDLE ||
+           state == RR_TCG_EXEC_IDLE_WAKE_PENDING;
+}
+
+/* Wait for the producer that owns an arming state to finish publication. */
+static inline unsigned int rr_crucible_sim_wake_read_stable(
+    unsigned int *exec_state)
+{
+    unsigned int state;
+
+    while (true) {
+        state = qatomic_read(exec_state);
+        if (!rr_crucible_sim_wake_state_is_arming(state)) {
+            return state;
+        }
+        cpu_relax();
+    }
+}
+
+/* Time-advance completion is published only from a settled RR idle state. */
+static inline bool rr_crucible_sim_time_advance_wake_can_publish(
+    unsigned int claimed_state)
+{
+    return claimed_state == RR_TCG_EXEC_IDLE ||
+           claimed_state == RR_TCG_EXEC_IDLE_WAKE_PENDING;
+}
+
+/*
+ * Claims the current wake epoch for one producer. A producer must also claim
+ * an already-pending epoch: the RR consumer may otherwise collapse that epoch
+ * between the producer's observation and its work publication.
+ */
+static inline bool rr_crucible_sim_wake_try_claim(unsigned int *exec_state,
+                                                  unsigned int *claimed_state)
+{
+    unsigned int arming_state;
+    unsigned int state = qatomic_read(exec_state);
+
+    if (rr_crucible_sim_wake_state_is_arming(state)) {
+        return false;
+    }
+    if (state == RR_TCG_EXEC_STARTING) {
+        arming_state = RR_TCG_EXEC_STARTING_WAKE_ARMING;
+    } else if (state == RR_TCG_EXEC_IDLE ||
+               state == RR_TCG_EXEC_IDLE_WAKE_PENDING) {
+        arming_state = RR_TCG_EXEC_IDLE_WAKE_ARMING;
+    } else {
+        arming_state = RR_TCG_EXEC_ACTIVE_WAKE_ARMING;
+    }
+    if (qatomic_cmpxchg(exec_state, state, arming_state) != state) {
+        return false;
+    }
+    *claimed_state = state;
+    return true;
+}
+
+static inline void rr_crucible_sim_wake_publish(unsigned int *exec_state,
+                                                unsigned int claimed_state,
+                                                uint64_t *publish_generation)
+{
+    unsigned int arming_state;
+    unsigned int pending_state;
+    uint64_t previous_generation;
+
+    if (claimed_state == RR_TCG_EXEC_STARTING) {
+        arming_state = RR_TCG_EXEC_STARTING_WAKE_ARMING;
+        pending_state = RR_TCG_EXEC_STARTING;
+    } else if (claimed_state == RR_TCG_EXEC_IDLE ||
+               claimed_state == RR_TCG_EXEC_IDLE_WAKE_PENDING) {
+        arming_state = RR_TCG_EXEC_IDLE_WAKE_ARMING;
+        pending_state = RR_TCG_EXEC_IDLE_WAKE_PENDING;
+    } else {
+        arming_state = RR_TCG_EXEC_ACTIVE_WAKE_ARMING;
+        pending_state = RR_TCG_EXEC_ACTIVE_WAKE_PENDING;
+    }
+    previous_generation = qatomic_fetch_inc(publish_generation);
+    g_assert(previous_generation != UINT64_MAX);
+    g_assert(qatomic_cmpxchg(exec_state, arming_state, pending_state) ==
+             arming_state);
+}
+
+static inline bool rr_crucible_sim_wake_consume_snapshot(
+    unsigned int *exec_state, uint64_t *publish_generation,
+    uint64_t consumed_generation, RRCrucibleSimWakeSnapshot *snapshot)
+{
+    unsigned int state = qatomic_read(exec_state);
+
+    if (rr_crucible_sim_wake_state_is_arming(state)) {
+        return false;
+    }
+    snapshot->state = state;
+    snapshot->publish_generation =
+        qatomic_load_acquire(publish_generation);
+    snapshot->publication_pending =
+        snapshot->publish_generation != consumed_generation;
+    return true;
+}
+
+static inline RRCrucibleSimWakeConsumeResult
+rr_crucible_sim_wake_try_collapse(
+    unsigned int *exec_state, uint64_t *publish_generation,
+    uint64_t *consumed_generation,
+    const RRCrucibleSimWakeSnapshot *snapshot)
+{
+    unsigned int completed_state =
+        snapshot->state == RR_TCG_EXEC_STARTING ?
+        RR_TCG_EXEC_STARTING : RR_TCG_EXEC_IDLE;
+
+    if (qatomic_cmpxchg(exec_state, snapshot->state,
+                        completed_state) != snapshot->state) {
+        return RR_TCG_WAKE_CONSUME_RETRY;
+    }
+    /*
+     * The producer may complete a full PENDING -> ARMING -> PENDING cycle
+     * between the snapshot and this CAS. The state value alone cannot expose
+     * that ABA, so keep the newer generation unconsumed and retry.
+     */
+    if (qatomic_load_acquire(publish_generation) !=
+        snapshot->publish_generation) {
+        return RR_TCG_WAKE_CONSUME_RETRY;
+    }
+    *consumed_generation = snapshot->publish_generation;
+    if (snapshot->publication_pending) {
+        return RR_TCG_WAKE_CONSUME_PENDING;
+    }
+    return RR_TCG_WAKE_CONSUME_EMPTY;
+}
+
 /* Kick all RR vCPUs. */
 void rr_kick_vcpu_thread(CPUState *unused);
+/* Wake a Crucible sim RR thread parked outside the BQL at a dispatch ceiling. */
+void rr_crucible_sim_notify_dispatch_ceiling(void);
+/* Publish the durable RR wake for a completed time advance. */
+void rr_crucible_sim_publish_time_advance_wake(void);
+/* Signal every RR wait object after the completed advance is released. */
+void rr_crucible_sim_signal_time_advance_wake(void);
+/* Report whether virtual timer notification must queue a vCPU work item. */
+bool rr_crucible_sim_timer_notify_needs_vcpu_work(void);
+/* Trace one internal RR control-boundary generation transition. */
+void rr_crucible_sim_trace_control_boundary(const char *phase,
+                                             uint64_t request_generation,
+                                             uint64_t ack_generation,
+                                             uint64_t complete_generation,
+                                             uintptr_t schedule_token);
+/* Trace one explicitly enabled idle-advance lifecycle transition. */
+void rr_crucible_sim_trace_idle_advance(const char *phase,
+                                        int64_t target_ns);
 
 /* start the round robin vcpu thread */
 void rr_start_vcpu_thread(CPUState *cpu);
+/* Crucible hot fork: restart the shared vCPU thread in the immediate child. */
+int rr_hot_fork_restart_vcpu_thread(void);
 
 #endif /* TCG_ACCEL_OPS_RR_H */
diff --git a/accel/tcg/tcg-accel-ops-sim-shmem.c b/accel/tcg/tcg-accel-ops-sim-shmem.c
new file mode 100644
index 0000000000000000000000000000000000000000..642fbec725f4ba7079dae3bc0213ea98be04ca3b
--- /dev/null
+++ b/accel/tcg/tcg-accel-ops-sim-shmem.c
@@ -0,0 +1,148 @@
+/*
+ * QEMU TCG Crucible deterministic simulation shmem dispatch glue
+ */
+
+#include "qemu/osdep.h"
+#include "plugins/qemu-plugin.h"
+#include "qemu/crucible-hot-fork-plugin.h"
+#include "qemu/plugin.h"
+#include "tcg-accel-ops-sim-shmem.h"
+
+static uint64_t crucible_current_icount;
+static qemu_plugin_sim_shmem_publish_icount_cb_t crucible_publish_icount_cb;
+static qemu_plugin_sim_shmem_max_advance_icount_cb_t crucible_max_advance_icount_cb;
+static void *crucible_sim_shmem_userdata;
+static qemu_plugin_sim_shmem_publish_icount_cb_t crucible_observe_icount_cb;
+static qemu_plugin_sim_shmem_max_advance_icount_cb_t
+    crucible_observer_max_advance_icount_cb;
+static void *crucible_sim_observer_userdata;
+
+void qemu_plugin_register_sim_shmem_dispatch_cb(
+    qemu_plugin_sim_shmem_publish_icount_cb_t publish_icount_cb,
+    qemu_plugin_sim_shmem_max_advance_icount_cb_t max_advance_icount_cb,
+    void *userdata)
+{
+    crucible_sim_shmem_userdata = userdata;
+    crucible_max_advance_icount_cb = max_advance_icount_cb;
+    crucible_publish_icount_cb = publish_icount_cb;
+    if (publish_icount_cb && max_advance_icount_cb) {
+        qemu_plugin_crucible_callback_registered(
+            0, QEMU_PLUGIN_CRUCIBLE_CALLBACK_SIM_SHMEM);
+    }
+}
+
+void qemu_plugin_register_sim_shmem_observer_cb(
+    qemu_plugin_sim_shmem_publish_icount_cb_t observe_icount_cb,
+    qemu_plugin_sim_shmem_max_advance_icount_cb_t max_advance_icount_cb,
+    void *userdata)
+{
+    crucible_sim_observer_userdata = userdata;
+    crucible_observer_max_advance_icount_cb = max_advance_icount_cb;
+    crucible_observe_icount_cb = observe_icount_cb;
+}
+
+bool crucible_sim_shmem_dispatch_registered(void)
+{
+    return crucible_max_advance_icount_cb != NULL;
+}
+
+bool crucible_sim_observer_registered(void)
+{
+    return crucible_observe_icount_cb != NULL &&
+           crucible_observer_max_advance_icount_cb != NULL;
+}
+
+void crucible_sim_shmem_publish_current_icount(uint64_t current_icount)
+{
+    crucible_current_icount = current_icount;
+    if (crucible_publish_icount_cb) {
+        qemu_plugin_crucible_exact_boundary_enter();
+        crucible_publish_icount_cb(current_icount, crucible_sim_shmem_userdata);
+        qemu_plugin_crucible_exact_boundary_leave();
+    }
+}
+
+void crucible_sim_observer_notify_current_icount(uint64_t current_icount)
+{
+    crucible_current_icount = current_icount;
+    if (crucible_observe_icount_cb) {
+        qemu_plugin_crucible_exact_boundary_enter();
+        crucible_observe_icount_cb(current_icount, crucible_sim_observer_userdata);
+        qemu_plugin_crucible_exact_boundary_leave();
+    }
+}
+
+uint64_t crucible_sim_shmem_current_icount(void)
+{
+    return crucible_current_icount;
+}
+
+uint64_t crucible_sim_shmem_max_advance_icount(void)
+{
+    if (crucible_max_advance_icount_cb) {
+        uint64_t result;
+
+        qemu_plugin_crucible_exact_boundary_enter();
+        result = crucible_max_advance_icount_cb(crucible_sim_shmem_userdata);
+        qemu_plugin_crucible_exact_boundary_leave();
+        return result;
+    }
+
+    return UINT64_MAX;
+}
+
+uint64_t crucible_sim_observer_max_advance_icount(void)
+{
+    if (crucible_observer_max_advance_icount_cb) {
+        uint64_t result;
+
+        qemu_plugin_crucible_exact_boundary_enter();
+        result = crucible_observer_max_advance_icount_cb(
+            crucible_sim_observer_userdata);
+        qemu_plugin_crucible_exact_boundary_leave();
+        return result;
+    }
+
+    return UINT64_MAX;
+}
+
+static int64_t crucible_sim_clamp_cpu_budget(uint64_t current_icount,
+                                             int64_t cpu_budget,
+                                             uint64_t max_advance_icount)
+{
+    uint64_t remaining;
+
+    if (cpu_budget <= 0) {
+        return cpu_budget;
+    }
+    if (current_icount >= max_advance_icount) {
+        return 0;
+    }
+
+    remaining = max_advance_icount - current_icount;
+    if (remaining > (uint64_t)INT64_MAX || (uint64_t)cpu_budget <= remaining) {
+        return cpu_budget;
+    }
+    return (int64_t)remaining;
+}
+
+int64_t crucible_sim_shmem_clamp_cpu_budget(uint64_t current_icount,
+                                            int64_t cpu_budget,
+                                            uint64_t max_advance_icount)
+{
+    return crucible_sim_clamp_cpu_budget(current_icount, cpu_budget,
+                                         max_advance_icount);
+}
+
+int64_t crucible_sim_observer_clamp_cpu_budget(uint64_t current_icount,
+                                               int64_t cpu_budget)
+{
+    return crucible_sim_clamp_cpu_budget(
+        current_icount, cpu_budget,
+        crucible_sim_observer_max_advance_icount());
+}
+
+bool crucible_sim_shmem_may_advance_to(uint64_t candidate_icount)
+{
+    return candidate_icount <= crucible_sim_shmem_max_advance_icount();
+}
