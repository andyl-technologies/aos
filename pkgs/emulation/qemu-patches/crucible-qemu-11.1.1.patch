+static inline uint64_t mos6522_elapsed_ticks_ps(__int128 now_ps,
+                                                __int128 load_ps,
+                                                uint64_t frequency)
+{
+    __uint128_t elapsed_ps;
+    __uint128_t elapsed_ticks;
+
+    if (now_ps <= load_ps) {
+        return 0;
+    }
+
+    elapsed_ps = (__int128)now_ps - load_ps;
+    elapsed_ticks = elapsed_ps / PICOSECONDS_PER_SECOND * frequency;
+    elapsed_ticks += elapsed_ps % PICOSECONDS_PER_SECOND * frequency /
+                     PICOSECONDS_PER_SECOND;
+    return MIN(elapsed_ticks, INT64_MAX);
+}
+
+static inline __int128 mos6522_deadline_ps(__int128 load_ps,
+                                          uint64_t counter_ticks,
+                                          uint64_t frequency)
+{
+    const __int128 horizon_ps = (__int128)INT64_MAX *
+                                PICOSECONDS_PER_NANOSECOND + 999;
+    __uint128_t elapsed_ps;
+
+    if (!frequency) {
+        return horizon_ps;
+    }
+    elapsed_ps = ((__uint128_t)counter_ticks * PICOSECONDS_PER_SECOND +
+                  frequency - 1) / frequency;
+    if (elapsed_ps > (__uint128_t)(horizon_ps - load_ps)) {
+        return horizon_ps;
+    }
+    return load_ps + (__int128)elapsed_ps;
+}
