+QemuCrucibleNativeInvocationTicket qemu_plugin_crucible_native_mask_v1(
+    const void *coordinate, void *function, void *userdata)
+{
+    QemuCrucibleNativeInvocationRegistry *registry = native_dispatch_hint();
+
+    /* Unknown ownership cannot inherit a selected parent. The hint only
+     * avoids native work when no selected parent can exist; it grants nothing. */
+    if (!registry || !qatomic_load_acquire(&registry->active_frame_hint)) {
+        return (QemuCrucibleNativeInvocationTicket) { 0 };
+    }
+    return qemu_plugin_crucible_native_enter_v1(
+        NULL, coordinate, function, userdata, QEMU_CRUCIBLE_NATIVE_UNQUALIFIED);
+}
+
+void qemu_plugin_crucible_native_exit_v1(QemuCrucibleNativeInvocationTicket ticket)
+{
+    QemuCrucibleNativeInvocationRegistry *registry;
+    CPUState *release_cpu = NULL;
+    pid_t process;
+
+    if (!ticket.frame) {
+        return;
+    }
+    process = getpid();
+    registry = ticket.registry;
+    if (!registry_process_current(registry, process)) {
+        return;
+    }
+    qemu_mutex_lock(&registry->mutex);
+    /* Revoke the genuine entered ticket even if Source admission has since
+     * become negative. Source retains the paid pool through process death. */
+    if (registry->initialized && registry->canonical_owner == registry &&
+        registry->process == process && frame_member_locked(registry, ticket.frame) &&
+        ticket.frame->canonical_owner == ticket.frame &&
+        ticket.frame->owner == registry && ticket.frame->serial == ticket.serial &&
+        qemu_thread_is_self(&ticket.frame->thread)) {
+        if (ticket.suppressed) {
+            assert(ticket.frame->suppressed_children);
+            ticket.frame->suppressed_children--;
+        } else if (ticket.frame->live) {
+            ticket.frame->live = false;
+            qatomic_store_release(&registry->active_frame_hint,
+                                 qatomic_read(&registry->active_frame_hint) - 1);
+        }
+        release_cpu = frame_reclaim_locked(ticket.frame);
+    }
+    qemu_mutex_unlock(&registry->mutex);
+    if (release_cpu) {
+        frame_cpu_pin_return(ticket, release_cpu);
+    }
+}
