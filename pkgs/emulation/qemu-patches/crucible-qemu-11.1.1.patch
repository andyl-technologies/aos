+static void set_deadline(PITCommonState *state, __int128 deadline, bool pending)
+{
+    for (unsigned index = 0; index < 3; index++) {
+        state->channels[index].count_load_time_ps = deadline;
+    }
+    state->channels[0].next_transition_valid = pending;
+    state->channels[0].next_transition_time_ps = pending ? deadline : 0;
+    if (pending) {
+        timer_mod_ps_wide(state->channels[0].irq_timer, deadline);
+    }
+}
