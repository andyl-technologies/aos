+/* Current syntax and physical borrowed aliases do not authenticate a family;
+ * these controls exercise them only under the disclosed prepared provider.
+ */
+static void assert_fixture_plan_rejection(const uint8_t *wire, size_t bytes,
+                                          int expected)
+{
+    QemuCrucibleProcessPurposePlan decoded;
+    QemuCrucibleProcessPurposePlan sentinel;
+    int descriptor = memfd_create("startup-rejected-plan",
+        MFD_CLOEXEC | MFD_ALLOW_SEALING);
+
+    g_assert_cmpint(descriptor, >=, 0);
+    g_assert_cmpint(write(descriptor, wire, bytes), ==, bytes);
+    g_assert_cmpint(fcntl(descriptor, F_ADD_SEALS,
+        F_SEAL_SEAL | F_SEAL_SHRINK | F_SEAL_GROW | F_SEAL_WRITE), ==, 0);
+    memset(&decoded, 0xa5, sizeof(decoded));
+    sentinel = decoded;
+
+    g_assert_cmpint(qemu_crucible_process_purpose_plan_read_fd_v3(
+        descriptor, &decoded), ==, expected);
+    g_assert_cmpmem(&decoded, sizeof(decoded), &sentinel, sizeof(sentinel));
+    g_assert_cmpint(close(descriptor), ==, 0);
+}
