+int qemu_crucible_checkpoint_inventory_current_v1(
+    QemuCrucibleCheckpointInventoryLoan *loan, uint64_t *bounded_ns)
+{
+    uint64_t slice;
+    int status = checkpoint_inventory_identity(loan);
+
+    if (status || !bounded_ns || loan->post_recorded) {
+        return status ? status : loan->post_recorded ? -EPERM : -EINVAL;
+    }
+    status = qatomic_read(&loan->transaction->first_status);
+    if (!status) {
+        status = qatomic_read(&loan->transaction->post_status);
+    }
+    if (!status) {
+        status = checkpoint_stop_receipt_current();
+    }
+    if (!status && loan->capture) {
+        status = qemu_crucible_ram_inventory_capture_identity_v1(loan, loan->capture);
+    }
+    /* No registry/native mutex or module guard spans this genuine same-owner
+     * provider callback. The Original is the retained Receiving Original80. */
+    if (!status && !loan->observer_invoking) {
+        status = checkpoint_provider_check_main(loan->request);
+    }
+    if (!status) {
+#ifdef CONFIG_LINUX
+        status = loan->metadata_borrow ?
+            qemu_crucible_startup_source_checkpoint_inventory_metadata_current_v1(
+                loan->metadata_borrow) : -ENOKEY;
+#else
+        status = -ENOTSUP;
+#endif
+    }
+    if (!status) {
+        status = checkpoint_live(loan->transaction, &slice, false);
+    }
+    if (status && !loan->first_status) {
+        loan->first_status = status;
+        checkpoint_fail(loan->transaction, status, false);
+    }
+    if (!status) {
+        *bounded_ns = slice;
+    }
+    return status;
+}
