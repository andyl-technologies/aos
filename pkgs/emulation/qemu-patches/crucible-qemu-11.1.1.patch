+static struct qemu_plugin_crucible_fault_result live_node_dispatch(
+    struct qemu_plugin_crucible_fault_command *command, GByteArray *payload)
+{
+    struct qemu_plugin_crucible_fault_result result;
+    uint8_t evidence[4096];
+    size_t length = 0;
+
+#ifdef CRUCIBLE_NODE_LIVE_WATCHDOG
+    if (command->command_sequence == 3) {
+        /* Use the real ordinary sim-clock operation, retaining the old clock
+         * and its phase. No guest instructions or Source command are issued. */
+        assert(icount_crucible_advance_virtual_time_by_ticks(CRUCIBLE_SIM_TICKS_PER_NS));
+    }
+#endif
+    command->target_icount = qemu_plugin_icount_raw();
+    command->authorization_ceiling_icount = command->target_icount;
+    command->target_tick = qemu_plugin_sim_tick_observed();
+    command->authorization_ceiling_tick = command->target_tick;
+    assert(qemu_plugin_crucible_fault_submit(
+        command, payload->data, payload->len) == 0);
+#ifdef CRUCIBLE_NODE_LIVE_AGGREGATE
+    if (command->command_sequence == 3) {
+        live_node_aggregate_restore(command);
+#ifdef CRUCIBLE_NODE_LIVE_EMERGENCY
+        live_node_emergency(command);
+#endif
+    }
+#endif
+    qemu_crucible_fault_dispatch_boundary(command->phase, command->target_icount);
+    assert(qemu_plugin_crucible_fault_poll(
+        &result, evidence, sizeof(evidence), &length) == 1);
+    assert(result.command_sequence == command->command_sequence);
+    fprintf(stderr, "ordinary sequence=%" PRIu64 " status=%u evidence=%zu\n",
+            result.command_sequence, result.status, length);
+    return result;
+}
