+
+__int128 riscv_time_ticks_to_ps(__int128 ticks, uint32_t frequency)
+{
+    __int128 numerator = ticks * PICOSECONDS_PER_SECOND;
+    __int128 time_ps = numerator / frequency;
+
+    if (numerator % frequency > 0) {
+        time_ps++;
+    }
+    return time_ps;
+}
