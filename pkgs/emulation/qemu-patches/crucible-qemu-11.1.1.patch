+        "qom_objects": {str(p.resolve()): hashlib.sha256(p.read_bytes()).hexdigest()
+                        for p in args.qom_object},
+    }, indent=2) + "\n")
+    print("PASS real anonymous discard component and independently rebuilt omissions; no Source")
