+static QemuCrucibleFaultRule *
+node_rule_copy(const QemuCrucibleFaultRule *source)
+{
+    g_auto(CrucibleNodeStorageOperation) operation =
+        node_storage_operation_begin();
+    QemuCrucibleFaultRegistration *origin;
+    CrucibleNodeOwnedRule *allocation;
+    CrucibleNodeRegistrationChild *child = NULL;
+    QemuCrucibleFaultRule *copy;
+    uint64_t issuance;
+
+    if (!operation.entered || !node_storage_rule_origin(source, &origin) ||
+        !(issuance = node_storage_admit(CRUCIBLE_NODE_STORAGE_RULE))) {
+        error_report("Crucible rule copy lacks an owned allocation route");
+        abort();
+    }
+    if (node_registration_child_acquire(origin, CRUCIBLE_NODE_STORAGE_RULE, &child)) {
+        error_report("Crucible rule copy lost its registration parent");
+        abort();
+    }
+    allocation = g_new0(CrucibleNodeOwnedRule, 1);
+    copy = &allocation->rule;
+    node_storage_publish(&allocation->storage, allocation, copy, copy,
+                         CRUCIBLE_NODE_STORAGE_RULE, issuance, origin, child);
+
+    *copy = *source;
+    copy->references = 1;
+    copy->payload = g_memdup2(source->payload, source->payload_len);
+    for (size_t i = 0; i < copy->field_count; i++) {
+        ptrdiff_t offset = source->fields[i].data - source->payload;
+        copy->fields[i].data = copy->payload + offset;
+        copy->fields[i].json = qobject_ref(source->fields[i].json);
+    }
+    copy->row_counts = source->row_counts ?
+        g_array_ref(source->row_counts) : NULL;
+    copy->translations = source->translations ?
+        g_array_ref(source->translations) : NULL;
+    copy->retention_cells = source->retention_cells ?
+        g_hash_table_ref(source->retention_cells) : NULL;
+    copy->row_counters = source->row_counters ?
+        g_hash_table_ref(source->row_counters) : NULL;
+    copy->service_ledger = NULL;
+    copy->evidence_mutation_records = NULL;
+    copy->evidence_counter_records = NULL;
+    return copy;
+}
+
+static GHashTable *node_memory_retention_cells_copy(GHashTable *source)
+{
+    GHashTable *copy;
+    GHashTableIter iter;
+    gpointer key;
+    gpointer value;
+
+    if (!source) {
+        return NULL;
+    }
+    copy = g_hash_table_new_full(
+        g_int64_hash, g_int64_equal, g_free, g_free);
+    g_hash_table_iter_init(&iter, source);
+    while (g_hash_table_iter_next(&iter, &key, &value)) {
+        g_hash_table_insert(copy, g_memdup2(key, sizeof(uint64_t)),
+                            g_memdup2(value, sizeof(CrucibleRetentionCell)));
+    }
+    return copy;
+}
+
+static GHashTable *node_memory_row_counters_copy(GHashTable *source)
+{
+    GHashTable *copy;
+    GHashTableIter iter;
+    gpointer key;
+    gpointer value;
+
+    if (!source) {
+        return NULL;
+    }
+    copy = g_hash_table_new_full(
+        node_dram_coordinate_hash, node_dram_coordinate_equal,
+        g_free, g_free);
+    g_hash_table_iter_init(&iter, source);
+    while (g_hash_table_iter_next(&iter, &key, &value)) {
+        g_hash_table_insert(
+            copy, g_memdup2(key, sizeof(CrucibleDramCoordinate)),
+            g_memdup2(value, sizeof(uint64_t)));
+    }
+    return copy;
+}
+
+static QemuCrucibleFaultRule *
+node_memory_shadow_rule_copy(const QemuCrucibleFaultRule *source)
+{
+    QemuCrucibleFaultRule *copy = node_rule_copy(source);
+
+    g_clear_pointer(&copy->retention_cells, g_hash_table_unref);
+    g_clear_pointer(&copy->row_counters, g_hash_table_unref);
+    copy->retention_cells = node_memory_retention_cells_copy(
+        source->retention_cells);
+    copy->row_counters = node_memory_row_counters_copy(
+        source->row_counters);
+    if (source->evidence_mutation_records) {
+        copy->evidence_mutation_records = g_byte_array_sized_new(
+            source->evidence_mutation_records->len);
+        g_byte_array_append(copy->evidence_mutation_records,
+                            source->evidence_mutation_records->data,
+                            source->evidence_mutation_records->len);
+    }
+    if (source->evidence_counter_records) {
+        copy->evidence_counter_records = g_byte_array_sized_new(
+            source->evidence_counter_records->len);
+        g_byte_array_append(copy->evidence_counter_records,
+                            source->evidence_counter_records->data,
+                            source->evidence_counter_records->len);
+    }
+    if (source->service_ledger) {
+        g_assert(source->service_ledger->references != UINT32_MAX);
+        source->service_ledger->references++;
+        copy->service_ledger = source->service_ledger;
+    }
+    return copy;
+}
+
+static QemuCrucibleFaultRule *node_memory_shadow_original(
+    QemuCrucibleFaultRule *rule)
+{
+    CrucibleMemoryTransaction *transaction = &crucible_memory_transaction;
+    QemuCrucibleFaultRule *original;
+
+    if (!transaction->streaming || !transaction->shadow_originals) {
+        return rule;
+    }
+    original = g_hash_table_lookup(transaction->shadow_originals, rule);
+    return original ? original : rule;
+}
+
+static QemuCrucibleFaultRule *node_memory_shadow_rule(
+    QemuCrucibleFaultRule *original)
+{
+    CrucibleMemoryTransaction *transaction = &crucible_memory_transaction;
+    QemuCrucibleFaultRule *shadow;
+
+    g_assert(transaction->streaming);
+    if (!transaction->shadow_rules) {
+        transaction->shadow_rules = g_hash_table_new_full(
+            g_direct_hash, g_direct_equal, NULL,
+            (GDestroyNotify)node_rule_unref);
+        transaction->shadow_originals = g_hash_table_new(
+            g_direct_hash, g_direct_equal);
+    }
+    shadow = g_hash_table_lookup(transaction->shadow_rules, original);
+    if (!shadow) {
+        shadow = node_memory_shadow_rule_copy(original);
+        g_hash_table_insert(transaction->shadow_rules, original, shadow);
+        g_hash_table_insert(transaction->shadow_originals, shadow, original);
+    }
+    return shadow;
+}
