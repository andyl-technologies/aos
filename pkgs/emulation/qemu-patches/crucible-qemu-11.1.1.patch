+int qemu_plugin_crucible_ram_physical_begin_v1(uint64_t generation,
+                                              uint64_t *token)
+{
+    uint64_t borrow_generation;
+    int status;
+
+    if (!token) {
+        return -EINVAL;
+    }
+    *token = 0;
+    if (!bql_locked() || physical_token || !admission_regions ||
+        generation != admission.topology_generation ||
+        generation != qatomic_read(&topology_generation)) {
+        return -ESTALE;
+    }
+    status = physical_owner_inventory(&borrow_generation);
+    if (status) {
+        return status;
+    }
+    status = qemu_crucible_ram_owner_closure_begin(token);
+    if (*token) {
+        /* Nonzero tokens remain owned even when collector cleanup failed. */
+        physical_token = *token;
+        physical_topology = generation;
+        physical_borrow_generation = borrow_generation;
+        physical_device_generation = qemu_crucible_ram_physical_device_generation();
+        physical_listener_generation = qemu_crucible_ram_physical_listener_generation();
+    }
+    if (!status) {
+        uint64_t current_generation;
+
+        status = physical_owner_inventory(&current_generation);
+        if (!status && current_generation != borrow_generation) {
+            status = -ESTALE;
+        }
+        if (status) {
+            struct qemu_plugin_crucible_ram_physical_end_v2 end = {
+                .schema_version = 2, .struct_size = sizeof(end),
+            };
+
+            qemu_crucible_ram_owner_closure_end_v2(*token, &end);
+            if (end.return_complete) {
+                physical_token = 0;
+                physical_topology = 0;
+                physical_borrow_generation = 0;
+                physical_device_generation = 0;
+                physical_listener_generation = 0;
+                *token = 0;
+            }
+        }
+    }
+    return status;
+}
