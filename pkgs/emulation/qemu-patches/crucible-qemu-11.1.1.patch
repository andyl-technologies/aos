+bool qapi_source_visit_begin_guard(Visitor *visitor, const void *old)
+{
+    bool selected;
+    int status = qapi_source_visitor_selected(visitor, &selected);
+
+    if (status || qapi_source_visitor_status(visitor)) {
+        return false;
+    }
+    if (selected && visit_is_input(visitor) && old) {
+        input_source_result(to_qiv(visitor), -EALREADY);
+        return false;
+    }
+    return true;
+}
