@@ -0,0 +1,43 @@
+/* Copyright (c) 2026 ANDYL Technologies
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "exec/icount.h"
+
+static void test_ordinary_public_shift(void)
+{
+    g_assert_cmpint(icount_instruction_ps(false, 0), ==, 1000);
+    g_assert_cmpint(icount_instruction_ps(false, 1), ==, 2000);
+    g_assert_cmpint(icount_instruction_ps(false, 3), ==, 8000);
+    g_assert_cmpint(icount_instruction_ps(false, ICOUNT_MAX_SHIFT_NS),
+                    ==, 1024000);
+
+    g_assert_cmpint(icount_round_duration_ps(999,
+                    icount_instruction_ps(false, 0)), ==, 1);
+    g_assert_cmpint(icount_round_duration_ps(1000,
+                    icount_instruction_ps(false, 0)), ==, 1);
+    g_assert_cmpint(icount_round_duration_ps(1001,
+                    icount_instruction_ps(false, 0)), ==, 2);
+}
+
+static void test_sim_fractional_instruction(void)
+{
+    int64_t instruction_ps = icount_instruction_ps(true, 0);
+
+    g_assert_cmpint(instruction_ps, ==, 50);
+    g_assert_cmpint(icount_round_duration_ps(49, instruction_ps), ==, 1);
+    g_assert_cmpint(icount_round_duration_ps(50, instruction_ps), ==, 1);
+    g_assert_cmpint(icount_round_duration_ps(51, instruction_ps), ==, 2);
+    g_assert_cmpint(icount_round_duration_ps(999, instruction_ps), ==, 20);
+    g_assert_cmpint(icount_round_duration_ps(1001, instruction_ps), ==, 21);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/icount/ordinary-public-shift", test_ordinary_public_shift);
+    g_test_add_func("/icount/sim-fractional-instruction",
+                    test_sim_fractional_instruction);
+    return g_test_run();
+}
