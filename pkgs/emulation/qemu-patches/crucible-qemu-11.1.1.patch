+static void test_generations(void)
+{
+    uint8_t wire[1536];
+    static const size_t offsets[3][4] = {
+        { 0, 8, 16, 32 }, { 0, 8, 16, 24 }, { 0, 8, 16, 24 },
+    };
+
+    for (size_t test = 1; test < G_N_ELEMENTS(cases); test++) {
+        for (size_t field = 0; field < 4; field++) {
+            for (unsigned endpoint = 0; endpoint < 2; endpoint++) {
+                if (test == 1) {
+                    publication_vector(wire);
+                } else if (test == 2) {
+                    return_vector(wire);
+                } else {
+                    terminal_vector(wire);
+                }
+                stq_be_p(wire + offsets[test - 1][field],
+                         endpoint ? UINT64_MAX : 0);
+                assert_refusal(&cases[test], wire, cases[test].bytes, -EPROTO);
+            }
+        }
+    }
+    return_vector(wire);
+    stq_be_p(wire + 32, 0);
+    assert_refusal(&cases[2], wire, 504, -EPROTO);
+    terminal_vector(wire);
+    stq_be_p(wire + 32, 3);
+    assert_refusal(&cases[3], wire, 512, -EPROTO);
+    return_vector(wire);
+    stq_be_p(wire + 24, 3);
+    assert_refusal(&cases[2], wire, 504, -EPROTO);
+}
