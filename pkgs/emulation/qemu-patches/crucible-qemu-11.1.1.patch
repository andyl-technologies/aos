+static int ram_capture_begin(
+    uint32_t require_full, uint64_t owner_token,
+    struct qemu_plugin_crucible_ram_capture_v1 *out)
+{
+    Error *error = NULL;
+    int status;
+
+    if (!out || require_full > 1 || capture_active ||
+        !(owner_token ? diagnostic_capture_authorized(owner_token) :
+                       capture_authorized()) ||
+        !admission_regions || !rust_metadata_budget ||
+        admission.topology_generation != qatomic_read(&topology_generation)) {
+        return -EPERM;
+    }
+    memset(out, 0, sizeof(*out));
+    status = qemu_crucible_ram_diagnostic_failure();
+    if (status) {
+        return status;
+    }
+    if (metadata_budget == 0) {
+        return -ENOSPC;
+    }
+    if (owner_token && (require_full ||
+        !(global_dirty_tracking & GLOBAL_DIRTY_CRUCIBLE_RAM))) {
+        /* Observation cannot arm logging or manufacture an incremental baseline. */
+        return -EPERM;
+    }
+    if (!(global_dirty_tracking & GLOBAL_DIRTY_CRUCIBLE_RAM)) {
+        if ((!capture_observation_only ||
+             (logical_capture->active && logical_capture->initializing && !current_cpu)) &&
+            !memory_global_dirty_log_start(GLOBAL_DIRTY_CRUCIBLE_RAM, &error)) {
+            error_free(error);
+            return -EIO;
+        }
+        require_full = 1;
+    }
+    if (capture_generation == UINT64_MAX) {
+        return -EOVERFLOW;
+    }
+    if (owner_token) {
+        status = qemu_plugin_crucible_ram_physical_validate_v1(
+            owner_token, physical_topology);
+        if (status) {
+            return status;
+        }
+        /* Admission owns the immutable sorted descriptors and region refs.
+         * Capture keeps only another reference to that same container. */
+        status = region_inventory_ref(admission_regions, &capture_regions);
+        if (status) {
+            return status;
+        }
+    } else {
+        status = region_inventory_new(&capture_regions);
+        if (status) {
+            return status;
+        }
+        status = qemu_ram_foreach_block(capture_region_add, capture_regions);
+        if (status != 0) {
+            return region_inventory_drop_preserving(&capture_regions, status);
+        }
+        status = region_inventory_sort(capture_regions);
+        if (status) {
+            return region_inventory_drop_preserving(&capture_regions, status);
+        }
+        for (size_t index = 1; index < capture_regions->len; index++) {
+            CrucibleRamRegion *left = region_inventory_index(capture_regions, index - 1);
+            CrucibleRamRegion *right = region_inventory_index(capture_regions, index);
+
+            if (region_compare(&left, &right) == 0) {
+                return region_inventory_drop_preserving(&capture_regions, -EEXIST);
+            }
+        }
+    }
+    capture_owner_token = owner_token;
+    capture_active = true;
+    capture_full = require_full;
+    capture_region_cursor = 0;
+    capture_page_cursor = 0;
+    capture_dirty_end = 0;
+    capture_generation++;
+    capture_dirty_generation = qatomic_read(&dirty_generation);
+    capture_topology_generation = qatomic_read(&topology_generation);
+    capture_finish_return = (typeof(capture_finish_return)) {
+        .process = getpid(),
+        .generation = capture_generation,
+        .owner_token = owner_token,
+    };
+    qemu_thread_get_self(&capture_finish_return.thread);
+    out->schema = 1;
+    out->region_count = capture_regions->len;
+    out->topology_generation = capture_topology_generation;
+    out->capture_generation = capture_generation;
+    out->metadata_budget_bytes = rust_metadata_budget;
+    return 0;
+}
+
+int qemu_plugin_crucible_ram_capture_context_observe_v1(
+    qemu_plugin_id_t id, struct qemu_plugin_crucible_ram_capture_context_v1 *out)
+{
+    uint32_t observation;
+    int status = qemu_crucible_startup_source_fingerprint_context_identity_v1(id);
+
+    if (status || !out || !bql_locked() || qemu_in_coroutine() || capture_active ||
+        candidate_capture.active || ordinary_fingerprint.invoking) {
+        return status ? status : -EPERM;
+    }
+    if (current_cpu) {
+        if (!fault_root_writer_scope || !qemu_plugin_crucible_single_threaded_rr() ||
+            !replay_mutex_owned()) {
+            return -EPERM;
+        }
+        /* This is the authentic existing native root/fault invocation context,
+         * already carrying RR/BQL. It selects independent noACK observation. */
+        observation = 1;
+    } else {
+        if (!qemu_in_main_thread()) {
+            return -EPERM;
+        }
+        observation = 0;
+    }
+    *out = (struct qemu_plugin_crucible_ram_capture_context_v1) {
+        .schema_version = 1,
+        .struct_size = sizeof(*out),
+        .observation_only = observation,
+    };
+    return 0;
+}
