+static void test_hot_fork_async_worker_barrier(void)
+{
+    BHTestData bh_data = { .n = 0, .max = 1 };
+    EventNotifierTestData event_data = { .n = 0, .active = 1 };
+    TimerTestData timer_data = {
+        .clock_type = QEMU_CLOCK_REALTIME,
+        .max = 1,
+        .ns = 1,
+        .ctx = ctx,
+    };
+    Coroutine *co;
+    QemuAsyncWorkerHotForkBarrierInventory barrier;
+    int coroutine_count = 0;
+
+    bh_data.bh = aio_bh_new(ctx, bh_test_cb, &bh_data);
+    aio_timer_init(ctx, &timer_data.timer, timer_data.clock_type,
+                   SCALE_NS, timer_test_cb, &timer_data);
+    event_notifier_init(&event_data.e, false);
+    set_event_notifier(ctx, &event_data.e, event_ready_cb);
+    co = qemu_coroutine_create(hot_fork_coroutine_cb, &coroutine_count);
+
+    /* An admitted callback may finish and park its final source mutations. */
+    qemu_async_worker_hot_fork_admission_begin();
+    qemu_async_worker_hot_fork_barrier(QEMU_ASYNC_WORKER_HOT_FORK_BARRIER_HOLD,
+                                   &barrier);
+    g_assert_true(barrier.held);
+    g_assert_cmpuint(barrier.admissions_in_flight, ==, 1);
+    g_assert_false(barrier.quiescent);
+
+    qemu_bh_schedule(bh_data.bh);
+    timer_mod_ns(&timer_data.timer,
+                 qemu_clock_get_ns(timer_data.clock_type));
+    event_notifier_set(&event_data.e);
+    aio_co_schedule(ctx, co);
+    qemu_async_worker_hot_fork_admission_end();
+
+    qemu_async_worker_hot_fork_barrier(QEMU_ASYNC_WORKER_HOT_FORK_BARRIER_QUERY,
+                                   &barrier);
+    g_assert_true(barrier.complete);
+    g_assert_true(barrier.quiescent);
+    g_assert_cmpuint(barrier.admissions_in_flight, ==, 0);
+    g_assert_cmpuint(barrier.pending_bottom_halves, >=, 1);
+    g_assert_cmpuint(barrier.pending_timers, >=, 1);
+    g_assert_cmpuint(barrier.aio_context_count, >=, 1);
+    g_assert_cmpuint(barrier.aio_handler_count, >=, 1);
+    g_assert_cmpuint(barrier.queued_coroutines, >=, 1);
+    g_assert_cmpuint(barrier.active_aio_polls, ==, 0);
+    g_assert_cmpuint(barrier.active_aio_dispatches, ==, 0);
+    g_assert_cmpuint(barrier.active_aio_handler_callbacks, ==, 0);
+
+    /* GLib dispatch declines admission while queued sources stay parked. */
+    g_assert_false(qemu_async_worker_hot_fork_admission_try_begin());
+    g_assert_false(g_main_context_iteration(NULL, false));
+    g_assert_cmpint(bh_data.n, ==, 0);
+    g_assert_cmpint(timer_data.n, ==, 0);
+    g_assert_cmpint(event_data.n, ==, 0);
+    g_assert_cmpint(coroutine_count, ==, 0);
+
+    qemu_async_worker_hot_fork_barrier(QEMU_ASYNC_WORKER_HOT_FORK_BARRIER_RELEASE,
+                                   &barrier);
+    g_assert_false(barrier.held);
+    g_assert_false(barrier.quiescent);
+    g_assert_cmpint(barrier.owner_thread_id, ==, 0);
+
+    while (g_main_context_iteration(NULL, false)) {
+        /* Drain every source released by the barrier. */
+    }
+    g_assert_cmpint(bh_data.n, ==, 1);
+    g_assert_cmpint(timer_data.n, ==, 1);
+    g_assert_cmpint(event_data.n, ==, 1);
+    g_assert_cmpint(coroutine_count, ==, 1);
+
+    qemu_bh_delete(bh_data.bh);
+    aio_poll(ctx, false);
+    timer_del(&timer_data.timer);
+    timer_deinit(&timer_data.timer);
+    set_event_notifier(ctx, &event_data.e, NULL);
+    event_notifier_cleanup(&event_data.e);
+}
