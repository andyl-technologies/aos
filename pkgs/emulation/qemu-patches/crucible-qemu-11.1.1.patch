--- /dev/null
+++ b/include/system/crucible-hot-fork-coordinator.h
@@ -0,0 +1,192 @@
+/*
+ * Crucible main-loop hot-fork coordinator.
+ *
+ * Copyright (c) Andyl, Inc.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef QEMU_CRUCIBLE_HOT_FORK_COORDINATOR_H
+#define QEMU_CRUCIBLE_HOT_FORK_COORDINATOR_H
+
+#include "qapi/error.h"
+#include "qemu/thread.h"
+
+/* The ready frame is an interior of the separately paid execution carrier.
+ * The main loop alone marks its real poll-return dispatch interval. Escaping
+ * this address never extends that interval or creates a guest observation. */
+typedef struct QemuCrucibleFingerprintMainReadyFrame {
+    QemuThread thread;
+    pid_t process;
+    void (*dispatch)(struct QemuCrucibleFingerprintMainReadyFrame *,
+                     int poll_result, int64_t timeout_ns);
+    bool entered;
+} QemuCrucibleFingerprintMainReadyFrame;
+
+typedef struct QemuCrucibleFingerprintMainExecution
+    QemuCrucibleFingerprintMainExecution;
+typedef struct QemuCrucibleFingerprintWakeWatcher
+    QemuCrucibleFingerprintWakeWatcher;
+typedef struct QemuCrucibleFingerprintWakeKeeper
+    QemuCrucibleFingerprintWakeKeeper;
+typedef struct QemuCrucibleFingerprintIntentObservation
+    QemuCrucibleFingerprintIntentObservation;
+
+typedef struct QemuCrucibleReadyDeliveryHandoff QemuCrucibleReadyDeliveryHandoff;
+
+int qemu_crucible_fingerprint_ready_delivery_retain_v1(
+    QemuCrucibleFingerprintMainReadyFrame *frame, void *execution,
+    QemuCrucibleFingerprintIntentObservation *observation,
+    QemuCrucibleReadyDeliveryHandoff *handoff,
+    QemuCrucibleReadyDeliveryHandoff ***holder);
+int qemu_crucible_fingerprint_ready_delivery_identity_return_v1(
+    void *execution, QemuCrucibleReadyDeliveryHandoff **holder,
+    QemuCrucibleReadyDeliveryHandoff *handoff);
+
+int qemu_crucible_fingerprint_ready_snapshot_holder_borrow_v1(
+    QemuCrucibleFingerprintMainReadyFrame *frame, void *execution,
+    QemuCrucibleFingerprintIntentObservation ***holder);
+int qemu_crucible_fingerprint_ready_snapshot_holder_current_v1(
+    QemuCrucibleFingerprintMainReadyFrame *frame,
+    QemuCrucibleFingerprintIntentObservation **holder);
+int qemu_crucible_fingerprint_main_execution_snapshot_holder_identity_v1(
+    void *execution, QemuCrucibleFingerprintIntentObservation **holder);
+int qemu_crucible_fingerprint_main_ready_snapshot_returned_current_v1(
+    QemuCrucibleFingerprintMainReadyFrame *frame,
+    QemuCrucibleFingerprintWakeWatcher *watcher, uint64_t registration_serial);
+
+
+/* Registration storage is distinct from the carrier interior. Its actual
+ * pointer extent is included in the Source's aggregate prebirth charge. */
+size_t main_loop_crucible_fingerprint_ready_storage_bytes_v1(void);
+int main_loop_crucible_fingerprint_ready_register_v1(
+    QemuCrucibleFingerprintMainReadyFrame *frame);
