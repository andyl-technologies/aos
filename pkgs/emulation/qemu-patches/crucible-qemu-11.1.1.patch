+int qemu_crucible_source_initial_register_borrow_begin_v1(
+    CPUState *cpu, QemuCrucibleInitialRegisterWorkspaceOwner *owner,
+    QemuCrucibleInitialRegisterWorkspaceOwner **holder,
+    QemuCrucibleInitialRegisterWorkspaceOwner **borrow_holder)
+{
+#ifdef CONFIG_LINUX
+    struct QemuCrucibleInitialCpuParticipant *participant = NULL;
+    bool authenticated = false, entered = false, retained = false;
+    int first = qemu_crucible_fault_register_borrow_observe_v1(
+        cpu, owner, borrow_holder, true, false, &entered);
+    int post;
+
+    if (!first) {
+        first = qemu_crucible_source_initial_register_workspace_current_v1(
+            cpu, owner, holder);
+    }
+    if (!first) {
+        first = qemu_plugin_crucible_initial_cpu_callback_entered_v1(cpu);
+    }
+    if (!first) {
+        first = initial_cpu_identity(cpu, &cpu->crucible_initial_participant,
+                                     &participant);
+    }
+    if (!first && (owner->borrow_held || owner->borrow_holder || owner->read.held ||
+        owner->borrow_serial == UINT64_MAX)) {
+        first = owner->borrow_serial == UINT64_MAX ? -EOVERFLOW : -EBUSY;
+    }
+    if (!first) {
+        owner->borrow_holder = borrow_holder;
+        owner->borrow_participant = participant;
+        owner->borrow_child = participant->native_child;
+        owner->borrow_child_serial = participant->native_child_serial;
+        owner->borrow_serial++;
+        qemu_thread_get_self(&owner->borrow_thread);
+        owner->borrow_held = true;
+        owner->borrow_return_observed = false;
+        owner->borrow_entered = false;
+        owner->borrow_return_post_recorded = false;
+        owner->borrow_first_status = 0;
+        owner->borrow_post_status = 0;
+        owner->borrow_return_first_status = 0;
+        owner->borrow_return_post_status = 0;
+        *borrow_holder = owner;
+        retained = true;
+    }
+    /* Always perform the same-callback Original post, even on failed entry.
+     * A negative post after retention leaves the canonical debt for cleanup. */
+    post = initial_register_borrow_post(cpu, owner, holder, &authenticated);
+    if (retained) {
+        owner->borrow_first_status = first;
+        owner->borrow_post_status = post;
+    }
+    return first ? first : post;
+#else
+    return -ENOTSUP;
+#endif
+}
