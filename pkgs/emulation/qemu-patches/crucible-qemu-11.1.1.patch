+static void crucible_node_vmstate_put_event(
+    GByteArray *payload, const CrucibleNodeEvent *queued)
+{
+    g_auto(CrucibleNodeStorageOperation) operation = node_storage_operation_begin();
+    const struct qemu_plugin_crucible_fault_event *event = &queued->event;
+
+    if (!operation.entered) {
+        error_report("Crucible event operation retains physical ownership");
+        return;
+    }
+
+    qemu_crucible_fault_vmstate_put_u16(payload, event->command_kind);
+    qemu_crucible_fault_vmstate_put_u16(payload, event->outcome);
+    qemu_crucible_fault_vmstate_put_u16(payload, event->model_phase);
+    qemu_crucible_fault_vmstate_put_u16(payload, event->target_kind);
+    qemu_crucible_fault_vmstate_put_u32(payload, event->evidence_length);
+    qemu_crucible_fault_vmstate_put_u64(payload, event->event_sequence);
+    qemu_crucible_fault_vmstate_put_u64(payload,
+                                        event->rule_command_sequence);
+    qemu_crucible_fault_vmstate_put_u64(payload, event->observed_icount);
+    qemu_crucible_fault_vmstate_put_u64(payload, event->observed_tick);
+    qemu_crucible_fault_vmstate_put_u64(payload, event->generation);
+    qemu_crucible_fault_vmstate_put_bytes(payload, event->binding_hash, 32);
+    qemu_crucible_fault_vmstate_put_bytes(payload, event->opportunity_hash,
+                                          32);
+    qemu_crucible_fault_vmstate_put_bytes(payload, event->action_hash, 32);
+    qemu_crucible_fault_vmstate_put_bytes(payload, event->target_hash, 32);
+    qemu_crucible_fault_vmstate_put_bytes(payload, event->before_hash, 32);
+    qemu_crucible_fault_vmstate_put_bytes(payload, event->after_hash, 32);
+    qemu_crucible_fault_vmstate_put_u32(payload, queued->payload_length);
+    qemu_crucible_fault_vmstate_put_bytes(
+        payload, node_event_bytes(queued), queued->payload_length);
+}
+
+static bool crucible_node_event_envelope_valid(
+    const struct qemu_plugin_crucible_fault_event *event,
+    const uint8_t *payload, size_t payload_len)
+{
+    uint32_t request_len;
+    uint32_t evidence_len;
+    uint8_t digest[32];
+    const uint8_t *request;
+    const uint8_t *evidence;
+
+    if (payload_len < CRUCIBLE_NODE_EVENT_ENVELOPE_HEADER_BYTES ||
+        payload_len > CRUCIBLE_NODE_EVENT_ENVELOPE_MAX_BYTES ||
+        memcmp(payload, CRUCIBLE_NODE_EVENT_ENVELOPE_MAGIC, 8) != 0 ||
+        node_get_u16(payload + 8) != 1 ||
+        node_get_u16(payload + 10) != 0 ||
+        node_get_u32(payload + 20) != 0) {
+        return false;
+    }
+    request_len = node_get_u32(payload + 12);
+    evidence_len = node_get_u32(payload + 16);
+    if (request_len < CRUCIBLE_NODE_FAULT_PAYLOAD_HEADER_V1_BYTES ||
+        request_len > CRUCIBLE_FAULT_HARD_PAYLOAD_BYTES ||
+        evidence_len == 0 ||
+        evidence_len > CRUCIBLE_FAULT_HARD_PAYLOAD_BYTES ||
+        request_len > payload_len - CRUCIBLE_NODE_EVENT_ENVELOPE_HEADER_BYTES ||
+        evidence_len != payload_len -
+            CRUCIBLE_NODE_EVENT_ENVELOPE_HEADER_BYTES - request_len) {
+        return false;
+    }
+    request = payload + CRUCIBLE_NODE_EVENT_ENVELOPE_HEADER_BYTES;
+    evidence = request + request_len;
+    node_sha256(request, request_len, digest);
+    if (memcmp(digest, payload + 24, 32) != 0) {
+        return false;
+    }
+    node_sha256(evidence, evidence_len, digest);
+    if (memcmp(digest, payload + 56, 32) != 0) {
+        return false;
+    }
+    return memcmp(request, CRUCIBLE_NODE_MAGIC, 8) == 0 &&
+           node_get_u16(
+               request + CRUCIBLE_NODE_FAULT_PAYLOAD_COMMAND_KIND_OFFSET) ==
+               event->command_kind &&
+           node_get_u16(
+               request + CRUCIBLE_NODE_FAULT_PAYLOAD_TARGET_KIND_OFFSET) ==
+               event->target_kind &&
+           node_get_u16(
+               request + CRUCIBLE_NODE_FAULT_PAYLOAD_MODEL_PHASE_OFFSET) ==
+               event->model_phase &&
+           node_get_u64(
+               request + CRUCIBLE_NODE_FAULT_PAYLOAD_GENERATION_OFFSET) ==
+               event->generation &&
+           memcmp(payload + 88, event->binding_hash, 32) == 0 &&
+           node_get_u64(payload + 120) == event->rule_command_sequence &&
+           (event->command_kind !=
+                CRUCIBLE_FAULT_COMMAND_ACCELERATOR_RESULT_TRANSFORM ||
+            memcmp(payload + 160, event->opportunity_hash, 32) == 0) &&
+           memcmp(request + CRUCIBLE_NODE_FAULT_PAYLOAD_ACTION_HASH_OFFSET,
+                  event->action_hash, 32) == 0 &&
+           memcmp(request + CRUCIBLE_NODE_FAULT_PAYLOAD_TARGET_HASH_OFFSET,
+                  event->target_hash, 32) == 0;
+}
+
+/* NODE_HANG stores the model's ARM phase, independently of the command
+ * boundary at which the rule was installed. Other producers retain their
+ * existing validation until their own model-phase contracts are joined. */
+static bool crucible_node_vmstate_event_phase_valid(uint16_t command_kind,
+                                                   uint16_t model_phase)
+{
+    if (command_kind == CRUCIBLE_FAULT_COMMAND_NODE_HANG) {
+        return model_phase == QEMU_CRUCIBLE_MODEL_PHASE_ARM;
+    }
+    return model_phase >= CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY &&
+           model_phase <= CRUCIBLE_FAULT_PHASE_DEVICE;
+}
+
+static bool crucible_node_vmstate_get_event(
+    QemuCrucibleFaultVmstateReader *reader, CrucibleNodeEvent *queued)
+{
+    struct qemu_plugin_crucible_fault_event *event = &queued->event;
+    QemuCrucibleFaultRule event_rule = { 0 };
+    const NodeSchemaField *schema;
+    size_t schema_count;
+    const uint8_t *evidence;
+    uint32_t evidence_len;
+
+    if (!qemu_crucible_fault_vmstate_get_u16(reader, &event->command_kind) ||
+        !qemu_crucible_fault_vmstate_get_u16(reader, &event->outcome) ||
+        !qemu_crucible_fault_vmstate_get_u16(reader, &event->model_phase) ||
+        !qemu_crucible_fault_vmstate_get_u16(reader, &event->target_kind) ||
+        !qemu_crucible_fault_vmstate_get_u32(reader,
+                                              &event->evidence_length) ||
+        !qemu_crucible_fault_vmstate_get_u64(reader,
+                                              &event->event_sequence) ||
+        !qemu_crucible_fault_vmstate_get_u64(
+            reader, &event->rule_command_sequence) ||
+        !qemu_crucible_fault_vmstate_get_u64(reader,
+                                              &event->observed_icount) ||
+        !qemu_crucible_fault_vmstate_get_u64(reader,
+                                              &event->observed_tick) ||
+        !qemu_crucible_fault_vmstate_get_u64(reader, &event->generation) ||
+        !qemu_crucible_fault_vmstate_get_bytes(reader,
+                                                event->binding_hash, 32) ||
+        !qemu_crucible_fault_vmstate_get_bytes(
+            reader, event->opportunity_hash, 32) ||
+        !qemu_crucible_fault_vmstate_get_bytes(reader,
+                                                event->action_hash, 32) ||
+        !qemu_crucible_fault_vmstate_get_bytes(reader,
+                                                event->target_hash, 32) ||
+        !qemu_crucible_fault_vmstate_get_bytes(reader,
+                                                event->before_hash, 32) ||
+        !qemu_crucible_fault_vmstate_get_bytes(reader,
+                                                event->after_hash, 32) ||
+        !qemu_crucible_fault_vmstate_get_u32(reader, &evidence_len) ||
+        evidence_len > CRUCIBLE_NODE_EVENT_ENVELOPE_MAX_BYTES ||
+        !qemu_crucible_fault_vmstate_get_view(reader, &evidence,
+                                               evidence_len) ||
+        !crucible_node_event_envelope_valid(event, evidence, evidence_len) ||
+        event->evidence_length == 0 ||
+        event->evidence_length > CRUCIBLE_FAULT_HARD_PAYLOAD_BYTES ||
+        event->evidence_length != node_get_u32(evidence + 16) ||
+        event->event_sequence == 0 ||
+        event->observed_tick > INT64_MAX ||
+        event->rule_command_sequence == 0 || event->generation == 0 ||
+        event->outcome < CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED ||
+        event->outcome > CRUCIBLE_FAULT_EVENT_OUTCOME_RECOVERED ||
+        !crucible_node_vmstate_event_phase_valid(
+            event->command_kind, event->model_phase) ||
+        !node_schema_for(event->command_kind, &schema, &schema_count) ||
+        !node_target_schema_for(event->target_kind,
+                                &schema, &schema_count)) {
+        return false;
+    }
+    event_rule.command_kind = event->command_kind;
+    event_rule.target_kind = event->target_kind;
+    if (!node_target_pair_valid(&event_rule)) {
+        return false;
+    }
+    queued->payload_length = evidence_len;
+    if (event->command_kind == CRUCIBLE_FAULT_COMMAND_NODE_HANG &&
+        !qemu_crucible_fault_vmstate_restore_current_v1()) {
+        if (!node_event_restore_body(queued, evidence, evidence_len)) {
+            return false;
+        }
+    } else if (evidence_len <= sizeof(queued->inline_payload)) {
+        memcpy(queued->inline_payload, evidence, evidence_len);
+    } else {
+        queued->payload = g_byte_array_sized_new(evidence_len);
+        g_byte_array_append(queued->payload, evidence, evidence_len);
+    }
+    return true;
+}
