+    if (out->fingerprint_samples_end > UINT64_MAX - UINT64_C(127)) {
+        return -EOVERFLOW;
+    }
+    out->markers_headers_offset = (out->fingerprint_samples_end + UINT64_C(127)) & ~UINT64_C(127);
+
+    out->markers_ring_count = (uint64_t)vm_count * UINT64_C(1);
