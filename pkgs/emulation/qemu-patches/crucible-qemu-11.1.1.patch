+
+#ifdef CONFIG_LINUX
+static int setup_handshake_identity(qemu_plugin_id_t id,
+                                    QemuCrucibleSetupHandshakeOwner *owner)
+{
+    if (!qatomic_load_acquire(&startup_source.module_custody_published) ||
+        owner != &startup_source.setup_handshake ||
+        startup_source.owner_process != getpid() ||
+        id != startup_source.saved.plugin_id) {
+        return -EPERM;
+    }
+    if (!owner->attempted || !owner->held ||
+        owner->issuer != startup_source.preexec_purpose_owner ||
+        owner->process != startup_source.owner_process ||
+        owner->process_generation != startup_source.original.process_generation ||
+        owner->account_generation != startup_source.standing.initial.account_generation ||
+        owner->installer.ctx != startup_source.saved.ctx ||
+        owner->installer.module != startup_source.saved.module ||
+        owner->installer.install != startup_source.saved.install ||
+        owner->fixed_native_extent != startup_source.metadata_partition.fixed_native_extent ||
+        !startup_source.checkpoint_storage.fixed_charge.held ||
+        !qatomic_load_acquire(&startup_source.custody_retained)) {
+        return -ESTALE;
+    }
+    return 0;
+}
+
+/* Lifetime identity is separate from the installing Original. This does not
+ * import an endpoint: the actual retained preexec owner observes its own FD. */
+static int setup_handshake_endpoint_current(QemuCrucibleSetupHandshakeOwner *owner)
+{
+    QemuCruciblePreexecPeerObservation observed;
+    int status = qemu_crucible_preexec_peer_observe_v3(owner->issuer, &observed);
+
+    if (status) {
+        return status;
+    }
+    if (observed.process_id != owner->peer.process_id ||
+        observed.user_id != owner->peer.user_id ||
+        observed.group_id != owner->peer.group_id ||
+        owner->control_device != startup_source.control_device ||
+        owner->control_inode != startup_source.control_inode ||
+        owner->descriptor != QEMU_CRUCIBLE_PREEXEC_SETUP_CONTROL_FD) {
+        return -ESTALE;
+    }
+    return 0;
+}
+
+/* Compute the remaining slice of the same actual preissued Original. This
+ * does not select a class from the Hello tag or create a replacement clock. */
+static int setup_handshake_original_current(QemuCrucibleSetupHandshakeOwner *owner,
+                                           uint64_t *bounded_ns)
+{
+    uint64_t slice;
+    int status;
+
+    if (owner->construction_operation) {
+        struct QemuCrucibleFingerprintOperation *operation =
+            &startup_source.standing.construction.operation;
+        const QemuCrucibleStandingRecord *admitted = &operation->admitted;
+        const QemuCrucibleStandingRecord *current = &startup_source.standing.current;
+        const QemuCrucibleStandingBudget *budget;
+        uint64_t now;
+
+        if (owner->construction_operation != operation ||
+            owner->operation_serial != operation->serial || operation->class_index != 0) {
+            return -ESTALE;
+        }
+        status = qemu_crucible_startup_source_observation_construction_current_v1(
+            &startup_source.standing.construction);
+        if (status) {
+            return status;
+        }
+        now = operation->last_now_ns;
+        budget = &admitted->budgets[operation->class_index];
+        slice = MIN(budget->poll_ns, current->budgets[operation->class_index].poll_ns);
+        standing_slice_budget(now - operation->start_ns, budget->total_present,
+                              budget->total_ns, &slice);
+        standing_slice_budget(now - operation->progress_ns, budget->progress_present,
+                              budget->progress_ns, &slice);
+        budget = &current->budgets[operation->class_index];
+        standing_slice_budget(now - operation->start_ns, budget->total_present,
+                              budget->total_ns, &slice);
+        standing_slice_budget(now - operation->progress_ns, budget->progress_present,
+                              budget->progress_ns, &slice);
+        standing_slice_budget(now - admitted->origin_ns, admitted->outer_allowance_present,
+                              admitted->outer_allowance_ns, &slice);
+        standing_slice_budget(now - current->origin_ns, current->outer_allowance_present,
+                              current->outer_allowance_ns, &slice);
+    } else {
+        uint64_t now;
+        const QemuCrucibleOriginalStartupWireRecord *original = &startup_source.original;
+        const QemuCrucibleProcessPurposeRecord *purpose = &startup_source.process_purpose_record;
+
+        /* A later entered constructor or Root cannot replace this saved Setup
+         * relation while the original initial exchange remains unfinished. */
+        if (startup_source.standing.construction.operation.held ||
+            startup_source.standing.operation.held) {
+            return -ESTALE;
+        }
+        status = startup_process_purpose_live();
+        if (!status) {
+            status = startup_monotonic_now(&now);
+        }
+        if (status) {
+            return status;
+        }
+        if (now < original->original_start_ns || now < purpose->containing_start) {
+            return -ESTALE;
+        }
+        if (now >= original->absolute_end_ns || now >= purpose->containing_end) {
+            return -ETIMEDOUT;
+        }
+        slice = MIN(original->poll_ns, original->absolute_end_ns - now);
+        slice = MIN(slice, purpose->containing_poll);
+        slice = MIN(slice, purpose->containing_end - now);
+    }
+    if (!slice) {
+        return -ETIMEDOUT;
+    }
+    if (bounded_ns) {
+        *bounded_ns = slice;
+    }
+    return 0;
+}
+
+static void setup_handshake_record_post(QemuCrucibleSetupHandshakeOwner *owner,
+                                        int post, bool wait)
+{
+    int *journal = wait ? &owner->wait_post_status : &owner->io_post_status;
+
+    if (post && !*journal) {
+        *journal = post;
+    }
+    if (post) {
+        crucible_metadata_partition_record_post(&startup_source.metadata_partition, post);
+    }
+}
+
+static int setup_handshake_wait(QemuCrucibleSetupHandshakeOwner *owner,
+                                short events)
+{
+    for (;;) {
+        uint64_t bounded;
+        int status = setup_handshake_original_current(owner, &bounded);
+        int result;
+        int saved_errno;
+
+        if (status) {
+            return status;
+        }
+        if (owner->io_post_status || owner->wait_post_status) {
+            return owner->io_post_status ? owner->io_post_status : owner->wait_post_status;
+        }
+        owner->event = (struct pollfd) { .fd = owner->descriptor, .events = events };
+        owner->timeout = (struct timespec) {
+            .tv_sec = bounded / UINT64_C(1000000000),
+            .tv_nsec = bounded % UINT64_C(1000000000),
+        };
+        owner->wait_active = true;
+        result = ppoll(&owner->event, 1, &owner->timeout, NULL);
+        saved_errno = result < 0 ? errno : 0;
+        owner->last_wait_status = result < 0 ? -saved_errno : 0;
+        if (result < 0 && saved_errno != EINTR && !owner->first_status) {
+            owner->first_status = -saved_errno;
+        }
+        status = setup_handshake_original_current(owner, NULL);
+        setup_handshake_record_post(owner, status, true);
+        owner->wait_active = false;
+        if (result < 0 && saved_errno != EINTR) {
+            return -saved_errno;
+        }
+        if (status) {
+            return status;
+        }
+        /* Interrupted or elapsed poll waits consume no protocol bytes. The
+         * next wait recomputes remaining time in this SAME entered Original. */
+        if (result == 0 || (result < 0 && saved_errno == EINTR)) {
+            continue;
+        }
+        if (owner->event.revents & POLLNVAL) {
+            return -EBADF;
+        }
+        if (owner->event.revents & events) {
+            return 0;
+        }
+        if (owner->event.revents & (POLLERR | POLLHUP)) {
+            return -EPIPE;
+        }
+    }
+}
+
+static int setup_handshake_exchange_current(qemu_plugin_id_t id,
+                                            QemuCrucibleSetupHandshakeOwner *owner)
+{
+    int status = setup_handshake_identity(id, owner);
+
+    if (!status && (owner->io_post_status || owner->wait_post_status)) {
+        status = owner->io_post_status ? owner->io_post_status : owner->wait_post_status;
+    }
+    if (!status && !startup_invocation(id)) {
+        status = -EPERM;
+    }
+    if (!status) {
+        status = setup_handshake_endpoint_current(owner);
+    }
+    if (!status) {
+        status = setup_handshake_original_current(owner, NULL);
+    }
+    return status;
+}
+
+static int setup_handshake_phase_post(QemuCrucibleSetupHandshakeOwner *owner,
+                                      int first, bool read)
+{
+    int post;
+    int status;
+
+    if (first && !owner->first_status) {
+        owner->first_status = first;
+    }
+    post = setup_handshake_original_current(owner, NULL);
+    if (read) {
+        owner->read_post = post;
+        owner->read_post_recorded = true;
+    } else {
+        owner->write_post = post;
+        owner->write_post_recorded = true;
+    }
+    if (post) {
+        crucible_metadata_partition_record_post(&startup_source.metadata_partition, post);
+    }
+    status = owner->first_status ? owner->first_status : post;
+
+    if (status) {
+        startup_failure(status);
+    }
+    return status;
+}
+#endif
