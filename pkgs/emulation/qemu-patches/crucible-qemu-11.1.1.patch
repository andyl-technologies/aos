@@ -0,0 +1,162 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Compile literal physical-return predicates, never a Source issuer.
+
+Real configured QEMU headers, BQL and thread helpers are required. Positive
+journals are factual component inputs: they are not admitted callbacks, CPU
+receipts or retained Source owners. The actual owned dispatcher remains
+unexecuted until its genuine Source/payer chain exists.
+"""
+
+import argparse
+import json
+import os
+from pathlib import Path
+import runpy
+import shlex
+import subprocess
+
+
+CHECKS = r'''
+int main(void)
+{
+    QemuCrucibleClockCallbackLease lease = {
+        .held = true, .post_recorded = true, .callback_returned = true,
+        .child_pinned = true, .cpu_pinned = true,
+        .child_unref_attempted = true, .child_unref_returned = true,
+        .cpu_unref_attempted = true, .cpu_unref_returned = true,
+        .first_status = -EIO, .serial = 1, .provider_serial = 2,
+    };
+    QemuCrucibleClockSourceJournal journal = {
+        .held = true, .unregister_attempted = true, .row_removed = true,
+        .unregister_post_recorded = true,
+    };
+
+    /* First cause is preserved separately; proven failed-not-entered cleanup
+     * can close physical custody without turning that failure into success. */
+    assert(clock_callback_closed(&lease));
+#define REFUSE_LEASE(field, value) do { \
+    QemuCrucibleClockCallbackLease changed = lease; \
+    changed.field = value; \
+    assert(!clock_callback_closed(&changed)); \
+} while (0)
+    REFUSE_LEASE(held, false);
+    REFUSE_LEASE(serial, 0);
+    REFUSE_LEASE(provider_serial, 0);
+    REFUSE_LEASE(post_recorded, false);
+    REFUSE_LEASE(post_status, -ESTALE);
+    REFUSE_LEASE(callback_returned, false);
+    REFUSE_LEASE(not_entered, true);
+    REFUSE_LEASE(child_unref_attempted, false);
+    REFUSE_LEASE(child_unref_returned, false);
+    REFUSE_LEASE(cpu_unref_attempted, false);
+    REFUSE_LEASE(cpu_unref_returned, false);
+    lease.callback_returned = false;
+    lease.not_entered = true;
+    assert(clock_callback_closed(&lease));
+    lease.child_pinned = lease.cpu_pinned = false;
+    lease.child_unref_attempted = lease.child_unref_returned = false;
+    lease.cpu_unref_attempted = lease.cpu_unref_returned = false;
+    assert(clock_callback_closed(&lease));
+
+    assert(clock_journal_closed(&journal));
+#define REFUSE_JOURNAL(field, value) do { \
+    QemuCrucibleClockSourceJournal changed = journal; \
+    changed.field = value; \
+    assert(!clock_journal_closed(&changed)); \
+} while (0)
+    REFUSE_JOURNAL(held, false);
+    REFUSE_JOURNAL(active, true);
+    REFUSE_JOURNAL(unregister_attempted, false);
+    REFUSE_JOURNAL(row_removed, false);
+    REFUSE_JOURNAL(unregister_post_recorded, false);
+    REFUSE_JOURNAL(unregister_first_status, -EIO);
+    REFUSE_JOURNAL(unregister_post_status, -ESTALE);
+    journal.callback.held = true;
+    assert(!clock_journal_closed(&journal));
+
+    printf("PASS literal saved-return and registration-debt predicates; "
+           "lease=%zu journal=%zu storage=%zu frame=%zu; "
+           "no Source admission or owned dispatch\n",
+           sizeof(lease), sizeof(journal), sizeof(QemuCrucibleClockStorage),
+           sizeof(QemuCrucibleTimerCallbackFrame));
+    return 0;
+}
+'''
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parents[2]
+    output = args.output_dir.resolve()
+    output.mkdir(parents=True, exist_ok=True)
+    function = runpy.run_path(str(root / "tests/unit/test-crucible-clock-canonical-rows.py"))["function"]
+    owner = (root / "plugins/crucible-startup-source.c").read_text()
+    start = owner.index("struct QemuCrucibleClockCallbackLease {")
+    end = owner.index("\nstruct QemuCrucibleCpuSourceAllocationOwner {", start)
+    declarations = owner[start:end]
+    custody = (root / "plugins/crucible-clock-custody.inc.h").read_text()
+    bodies = "\n".join(function(custody, name) for name in (
+        "static bool clock_registration_returned(",
+        "static bool clock_journal_closed(",
+        "static bool clock_callback_closed("))
+    prefix = ('#include "qemu/osdep.h"\n#include "system/memory.h"\n'
+              '#include "qemu/crucible-clock-custody.h"\n'
+              '#include "qemu/crucible-apic-getter.h"\n')
+    omissions = {}
+    for name, token in {
+        "callback-held": "lease->held && ",
+        "callback-serial": "lease->serial && ",
+        "provider-serial": "lease->provider_serial &&",
+        "callback-post": "lease->post_recorded && ",
+        "callback-post-status": "!lease->post_status &&",
+        "child-unref-attempt": "lease->child_unref_attempted && ",
+        "child-unref-return": "lease->child_unref_returned",
+        "cpu-unref-attempt": "lease->cpu_unref_attempted && ",
+        "cpu-unref-return": "lease->cpu_unref_returned",
+        "registration-held": "clock->held && ",
+        "registration-inactive": "!clock->active && ",
+        "unregister-attempt": "clock->unregister_attempted &&",
+        "row-return": "clock->row_removed && ",
+        "unregister-post": "clock->unregister_post_recorded &&",
+        "unregister-first": "!clock->unregister_first_status && ",
+        "unregister-post-status": "!clock->unregister_post_status &&",
+        "callback-debt": "!clock->callback.held",
+    }.items():
+        omissions[name] = (token, "true" if token in (
+            "lease->child_unref_returned", "lease->cpu_unref_returned",
+            "!clock->callback.held") else "")
+    omissions["physical-callback-return"] = (
+        "(lease->callback_returned != lease->not_entered)", "true")
+    results = {}
+    for name in ["positive", *omissions]:
+        literal = bodies
+        if name != "positive":
+            before, after = omissions[name]
+            assert literal.count(before) == 1, name
+            literal = literal.replace(before, after, 1)
+        source = output / (name + ".c")
+        binary = source.with_suffix("")
+        source.write_text(prefix + declarations + literal + CHECKS)
+        command = [*shlex.split(os.environ["CC"]),
+                   *shlex.split(os.environ["CFLAGS"]), str(source),
+                   "-o", str(binary), *shlex.split(os.environ["LDFLAGS"])]
+        (output / (name + ".command.json")).write_text(json.dumps(command, indent=2))
+        compiled = subprocess.run(command, capture_output=True, text=True)
+        (output / (name + ".compile.log")).write_text(compiled.stdout + compiled.stderr)
+        if compiled.returncode:
+            raise RuntimeError(f"{name} compile failed: {compiled.stderr}")
+        result = subprocess.run([str(binary)], capture_output=True, text=True)
+        (output / (name + ".run.log")).write_text(result.stdout + result.stderr)
+        results[name] = result.returncode
+        if (name == "positive") != (result.returncode == 0):
+            raise RuntimeError(f"{name} unexpected result: {result.stdout}{result.stderr}")
+        if name != "positive" and (result.returncode != -6 or "Assertion" not in result.stderr):
+            raise RuntimeError(f"{name} missed assertion detector")
+        print(name, result.returncode, result.stdout.strip(), flush=True)
+    (output / "results.json").write_text(json.dumps(results, indent=2) + "\n")
+
+
+if __name__ == "__main__":
+    main()
