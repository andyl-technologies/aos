+    fixture_startup(wire, 0, 3);
+    fixture_be64(wire, 64, FIXTURE_METADATA);
+    assert_startup_refusal(wire, 128);
+    fixture_be64(wire, 64, FIXTURE_METADATA - 1);
+    assert_startup_refusal(wire, 128);
+    fixture_be64(wire, 64, 0);
+    assert_startup_refusal(wire, 128);
+    fixture_startup(wire, 0, 3);
+    fixture_be64(wire, 56, UINT64_MAX);
+    assert_startup_refusal(wire, 128);
