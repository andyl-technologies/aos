+static void test_ordinary(void)
+{
+    if (g_test_subprocess()) {
+        MC146818RtcState source, destination;
+        GByteArray *bytes;
+
+        initialize_timers(&source);
+        initialize_timers(&destination);
+        observed_ps = 357000;
+        rtc_capture_calendar_origin(&source);
+        g_assert_cmpuint(source.last_update, ==, 357);
+        timer_mod(source.periodic_timer, 1234);
+        bytes = save_state(&source);
+
+        g_assert_cmpint(load_state(&destination, bytes), ==, 0);
+        g_assert_cmpint(timer_expire_time_ns(destination.periodic_timer), ==, 1234);
+        g_assert_cmpuint(get_guest_rtc_ns_raw(&source, 1000), ==,
+                         UINT64_C(951782400000000643));
+
+        g_byte_array_unref(bytes);
+        destroy_timers(&source);
+        destroy_timers(&destination);
+        return;
+    }
+    g_setenv("RTC_TIMER_ORDINARY", "1", true);
+    g_test_trap_subprocess(NULL, 0, 0);
+    g_unsetenv("RTC_TIMER_ORDINARY");
+    g_test_trap_assert_passed();
+}
+
+static const struct {
+    int64_t now_hi;
+    uint64_t now_lo;
+    int64_t deadline_hi;
+    uint64_t deadline_lo;
+} periodic_vectors[] = {
+    { 0, UINT64_C(0),
+      0, UINT64_C(183105469) },
+    { -1, UINT64_C(18446744073709551615),
+      0, UINT64_C(152587891) },
+    { 0, UINT64_C(357),
+      0, UINT64_C(183105469) },
+    { -1, UINT64_C(18446744073709551259),
+      0, UINT64_C(152587891) },
+    { 72057594037927936, UINT64_C(357),
+      72057594037927936, UINT64_C(174977690) },
+    { -72057594037927936, UINT64_C(357),
+      -72057594037927936, UINT64_C(160715670) },
+    { INT64_MAX, UINT64_C(18446743073709551615),
+      INT64_MAX, UINT64_C(18446743073889899013) },
+    { INT64_MIN, UINT64_C(0),
+      INT64_MIN, UINT64_C(155345963) },
+    { 68719476736, UINT64_C(999),
+      68719476736, UINT64_C(153484078) },
+    { -68719476736, UINT64_C(999),
+      -68719476736, UINT64_C(182209283) },
+    { 500, UINT64_C(357),
+      500, UINT64_C(174143172) },
+    { -501, UINT64_C(18446744073709551259),
+      -500, UINT64_C(161550188) },
+};
