+int qemu_async_worker_hot_fork_census(
+    QemuAsyncWorkerHotForkBarrierOperation operation,
+    QemuCrucibleParkCensus *out)
+{
+    AioContext *ctx;
+    QEMUBH *bh;
+    size_t aio_count = 0;
+    size_t bh_count = 0;
+    bool complete = true;
+
+    *out = (QemuCrucibleParkCensus) { 0 };
+    QEMU_LOCK_GUARD(&crucible_hot_fork_async_worker_barrier_lock);
+    if (operation == QEMU_ASYNC_WORKER_HOT_FORK_BARRIER_HOLD &&
+        !qatomic_read(&crucible_hot_fork_async_worker_barrier_held)) {
+        qemu_event_reset(&crucible_hot_fork_async_worker_barrier_release);
+        qatomic_set(&crucible_hot_fork_async_worker_barrier_owner,
+                    qemu_get_thread_id());
+        smp_mb_global();
+        qatomic_set(&crucible_hot_fork_async_worker_barrier_held, 1);
+        crucible_hot_fork_async_worker_barrier_generation++;
+        assert(crucible_hot_fork_async_worker_barrier_generation != 0);
+        out->acquired = true;
+    } else if (operation == QEMU_ASYNC_WORKER_HOT_FORK_BARRIER_RELEASE) {
+        if (qatomic_read(&crucible_hot_fork_async_worker_barrier_owner) !=
+            qemu_get_thread_id()) {
+            return -ESTALE;
+        }
+        qatomic_set(&crucible_hot_fork_async_worker_barrier_held, 0);
+        qatomic_set(&crucible_hot_fork_async_worker_barrier_owner, 0);
+        crucible_hot_fork_async_worker_barrier_generation++;
+        assert(crucible_hot_fork_async_worker_barrier_generation != 0);
+        qemu_event_set(&crucible_hot_fork_async_worker_barrier_release);
+    } else if (operation != QEMU_ASYNC_WORKER_HOT_FORK_BARRIER_HOLD &&
+               operation != QEMU_ASYNC_WORKER_HOT_FORK_BARRIER_QUERY) {
+        return -EINVAL;
+    }
+
+    out->held = qatomic_read(&crucible_hot_fork_async_worker_barrier_held);
+    out->owner_thread_id =
+        qatomic_read(&crucible_hot_fork_async_worker_barrier_owner);
+    out->barrier_generation = crucible_hot_fork_async_worker_barrier_generation;
+    qemu_mutex_lock(&crucible_hot_fork_aio_lock);
+    out->generation[0] = crucible_hot_fork_aio_generation;
+    out->generation[1] = qatomic_read(&crucible_hot_fork_bh_generation);
+    QTAILQ_FOREACH(ctx, &crucible_hot_fork_aio_contexts, crucible_hot_fork_node) {
+        if (aio_count == QEMU_AIO_HOT_FORK_INVENTORY_MAX) {
+            complete = false;
+            break;
+        }
+        aio_count++;
+        complete &= !qatomic_read(&ctx->crucible_hot_fork_active_polls) &&
+            !qatomic_read(&ctx->crucible_hot_fork_active_dispatches);
+    }
+    QTAILQ_FOREACH(bh, &crucible_hot_fork_bhs, crucible_hot_fork_node) {
+        if (bh_count == QEMU_BH_HOT_FORK_INVENTORY_MAX) {
+            complete = false;
+            break;
+        }
+        bh_count++;
+        complete &= !qatomic_read(&bh->crucible_hot_fork_active_callbacks);
+    }
+    complete &= !qatomic_read(&crucible_hot_fork_bh_active_transitions);
+    qemu_mutex_unlock(&crucible_hot_fork_aio_lock);
+    complete &= qemu_crucible_park_array_request(
+        &out->arrays[0], aio_count, sizeof(QemuAioHotForkInventoryEntry),
+        _Alignof(QemuAioHotForkInventoryEntry), NULL);
+    complete &= qemu_crucible_park_array_request(
+        &out->arrays[1], bh_count, sizeof(QemuBhHotForkInventoryEntry),
+        _Alignof(QemuBhHotForkInventoryEntry), NULL);
+#ifdef CONFIG_POSIX
+    complete &= qemu_aio_handler_hot_fork_census(
+        &out->arrays[2], &out->generation[2]);
+    complete &= qemu_timer_hot_fork_census(
+        &out->arrays[3], &out->generation[3]);
+#else
+    complete = false;
+#endif
+    out->complete = complete &&
+        !qatomic_read(&crucible_hot_fork_async_worker_admissions);
+    return 0;
+}
+
+static void crucible_hot_fork_async_worker_release_locked(void)
+{
+    if (qatomic_read(&crucible_hot_fork_async_worker_barrier_held)) {
+        qatomic_set(&crucible_hot_fork_async_worker_barrier_held, 0);
+        qatomic_set(&crucible_hot_fork_async_worker_barrier_owner, 0);
+        crucible_hot_fork_async_worker_barrier_generation++;
+        assert(crucible_hot_fork_async_worker_barrier_generation != 0);
+        qemu_event_set(&crucible_hot_fork_async_worker_barrier_release);
+    }
+}
+
+static void qemu_async_worker_hot_fork_barrier_common(
+    QemuCrucibleNativeParkCapture *capture,
+    QemuAsyncWorkerHotForkBarrierOperation operation,
+    QemuAsyncWorkerHotForkBarrierInventory *inventory)
+{
+    QemuAioHotForkInventory aio_contexts;
+    QemuBhHotForkInventory bottom_halves;
+#ifdef CONFIG_POSIX
+    QemuAioHandlerHotForkInventory aio_handlers;
+    QemuTimerHotForkInventory timers;
+#endif
+    size_t index;
+    bool release_after_report =
+        capture && operation == QEMU_ASYNC_WORKER_HOT_FORK_BARRIER_RELEASE;
+
+    *inventory = (QemuAsyncWorkerHotForkBarrierInventory){0};
+    qemu_mutex_lock(&crucible_hot_fork_async_worker_barrier_lock);
+    switch (release_after_report ? QEMU_ASYNC_WORKER_HOT_FORK_BARRIER_QUERY
+                                 : operation) {
+    case QEMU_ASYNC_WORKER_HOT_FORK_BARRIER_HOLD:
+        if (!qatomic_read(&crucible_hot_fork_async_worker_barrier_held)) {
+            qemu_event_reset(&crucible_hot_fork_async_worker_barrier_release);
+            qatomic_set(&crucible_hot_fork_async_worker_barrier_owner,
+                        qemu_get_thread_id());
+            smp_mb_global();
+            qatomic_set(&crucible_hot_fork_async_worker_barrier_held, 1);
+            crucible_hot_fork_async_worker_barrier_generation++;
+            assert(crucible_hot_fork_async_worker_barrier_generation != 0);
+            crucible_hot_fork_aio_notify_all();
+        }
+        break;
+    case QEMU_ASYNC_WORKER_HOT_FORK_BARRIER_QUERY:
+        break;
+    case QEMU_ASYNC_WORKER_HOT_FORK_BARRIER_RELEASE:
+        crucible_hot_fork_async_worker_release_locked();
+        break;
+    default:
+        g_assert_not_reached();
+    }
+
+    qemu_aio_hot_fork_inventory_capture(capture, &aio_contexts);
+    qemu_bh_hot_fork_inventory_capture(capture, &bottom_halves);
+#ifdef CONFIG_POSIX
+    qemu_aio_handler_hot_fork_inventory_capture(capture, &aio_handlers);
+    qemu_timer_hot_fork_inventory_capture(capture, &timers);
+#endif
+    inventory->generation = crucible_hot_fork_async_worker_barrier_generation;
+    inventory->owner_thread_id =
+        qatomic_read(&crucible_hot_fork_async_worker_barrier_owner);
+    inventory->admissions_in_flight =
+        qatomic_read(&crucible_hot_fork_async_worker_admissions);
+    inventory->bottom_half_count = bottom_halves.entry_count;
+    inventory->aio_context_count = aio_contexts.entry_count;
+    for (index = 0; index < aio_contexts.entry_count; index++) {
+        QemuAioHotForkInventoryEntry *entry = &aio_contexts.entries[index];
+
+        inventory->active_aio_polls += entry->active_polls;
+        inventory->active_aio_dispatches += entry->active_dispatches;
+        inventory->queued_coroutines += entry->queued_coroutines;
+    }
+    for (index = 0; index < bottom_halves.entry_count; index++) {
+        QemuBhHotForkInventoryEntry *entry = &bottom_halves.entries[index];
+
+        inventory->pending_bottom_halves += entry->pending;
+        inventory->scheduled_bottom_halves += entry->scheduled;
+        inventory->active_bottom_half_callbacks += entry->active_callbacks;
+    }
+#ifdef CONFIG_POSIX
+    inventory->aio_handler_count = aio_handlers.entry_count;
+    for (index = 0; index < aio_handlers.entry_count; index++) {
+        QemuAioHandlerHotForkInventoryEntry *entry =
+            &aio_handlers.entries[index];
+
+        inventory->active_aio_handler_callbacks += entry->active_callbacks;
+    }
+    for (index = 0; index < timers.entry_count; index++) {
+        QemuTimerHotForkInventoryEntry *entry = &timers.entries[index];
+
+        inventory->pending_timers += entry->pending;
+        inventory->active_timer_callbacks += entry->callback_active;
+    }
+#endif
+    inventory->held =
+        qatomic_read(&crucible_hot_fork_async_worker_barrier_held) != 0;
+    inventory->bottom_halves_complete =
+        !bottom_halves.overflowed && bottom_halves.stable;
+    inventory->aio_contexts_complete = !aio_contexts.overflowed;
+#ifdef CONFIG_POSIX
+    inventory->aio_handlers_complete = !aio_handlers.overflowed;
+    inventory->timers_complete = !timers.overflowed;
+#endif
+    inventory->complete =
+        inventory->aio_contexts_complete && inventory->bottom_halves_complete &&
+        inventory->aio_handlers_complete && inventory->timers_complete;
+    inventory->quiescent = inventory->held && inventory->complete &&
+                           inventory->admissions_in_flight == 0 &&
+                           inventory->active_aio_polls == 0 &&
+                           inventory->active_aio_dispatches == 0 &&
+                           inventory->active_bottom_half_callbacks == 0 &&
+                           inventory->active_aio_handler_callbacks == 0 &&
+                           inventory->active_timer_callbacks == 0;
+#ifdef CONFIG_POSIX
+    qemu_aio_handler_hot_fork_inventory_destroy(&aio_handlers);
+    qemu_timer_hot_fork_inventory_destroy(&timers);
+#endif
+    qemu_bh_hot_fork_inventory_destroy(&bottom_halves);
+    qemu_aio_hot_fork_inventory_destroy(&aio_contexts);
+    if (release_after_report &&
+        !qemu_crucible_native_park_capture_release_ready(
+            capture, QEMU_CRUCIBLE_PARK_AIO_CONTEXTS,
+            crucible_hot_fork_async_worker_barrier_generation)) {
+        crucible_hot_fork_async_worker_release_locked();
+        qemu_crucible_native_park_capture_released(
+            capture, QEMU_CRUCIBLE_PARK_AIO_CONTEXTS,
+            crucible_hot_fork_async_worker_barrier_generation);
+        inventory->generation =
+            crucible_hot_fork_async_worker_barrier_generation;
+        inventory->owner_thread_id = 0;
+        inventory->held = false;
+        inventory->quiescent = false;
+    }
+    qemu_mutex_unlock(&crucible_hot_fork_async_worker_barrier_lock);
+}
