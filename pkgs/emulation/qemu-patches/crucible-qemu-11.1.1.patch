+        __int128 deadline_ps;
+
+        if (!hppa_interval_deadline_ps(now_ps, val, &deadline_ps)) {
+            error_report("HPPA interval deadline exceeds the signed128 clock");
+            abort();
+        }
+
+        g_assert(deadline_ps % PICOSECONDS_PER_NANOSECOND == 0);
