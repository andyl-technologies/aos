+        operation->progress_first_status = first;
+    }
+    if (first && !operation->first_status) {
+        operation->first_status = first;
+    }
+    /* The actual pointer records physical consumption independently of first.
+     * Uncertainty retains the witness and prevents claim/operation return. */
+    returned = standing_progress_return(operation);
+    return first ? first : returned;
