+
+bool qemu_crucible_fault_vmstate_reader_finished(
+    const QemuCrucibleFaultVmstateReader *reader)
+{
+    return reader->offset == reader->length;
+}
+
+static void crucible_fault_vmstate_sha256(const uint8_t *bytes, size_t len,
+                                          uint8_t digest[32])
+{
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    gsize digest_len = 32;
+
+    g_checksum_update(checksum, bytes, len);
+    g_checksum_get_digest(checksum, digest, &digest_len);
+    g_assert(digest_len == 32);
+}
+
+static int crucible_fault_vmstate_save_prepare(void *opaque, Error **errp)
+{
+    int status = crucible_fault_vmstate_registry_validate();
+
+    if (status != 0) {
+        error_setg(errp, "Crucible fault VMState registry is incomplete");
+    }
+    return status;
+}
+
+static void crucible_fault_vmstate_save(QEMUFile *file, void *opaque)
+{
+    g_autoptr(GByteArray) encoded = g_byte_array_new();
+    uint8_t digest[32];
+    int status;
+
+    g_byte_array_append(encoded,
+                        (const uint8_t *)CRUCIBLE_FAULT_VMSTATE_MAGIC, 8);
+    qemu_crucible_fault_vmstate_put_u32(encoded,
+                                        CRUCIBLE_FAULT_VMSTATE_VERSION);
+    qemu_crucible_fault_vmstate_put_u32(
+        encoded, crucible_fault_vmstate_sections->len);
+    for (size_t i = 0; i < crucible_fault_vmstate_sections->len; i++) {
+        const QemuCrucibleFaultVmstateSection *section =
+            g_ptr_array_index(crucible_fault_vmstate_sections, i);
+        g_autoptr(GByteArray) payload = g_byte_array_new();
+        size_t name_len = strlen(section->name);
+
+        status = section->save(payload);
+        if (status != 0 ||
+            payload->len > CRUCIBLE_FAULT_VMSTATE_MAX_SECTION_BYTES ||
+            name_len > CRUCIBLE_FAULT_VMSTATE_MAX_NAME_BYTES ||
+            encoded->len > CRUCIBLE_FAULT_VMSTATE_MAX_TOTAL_BYTES - 16 ||
+            encoded->len + 16 >
+                CRUCIBLE_FAULT_VMSTATE_MAX_TOTAL_BYTES - name_len ||
+            encoded->len + 16 + name_len >
+                CRUCIBLE_FAULT_VMSTATE_MAX_TOTAL_BYTES - payload->len) {
+            qemu_file_set_error(file, status != 0 ? status : -E2BIG);
+            return;
+        }
+        qemu_crucible_fault_vmstate_put_u16(encoded, name_len);
+        qemu_crucible_fault_vmstate_put_u16(encoded, 0);
+        qemu_crucible_fault_vmstate_put_u32(encoded, section->version);
+        qemu_crucible_fault_vmstate_put_u64(encoded, payload->len);
+        g_byte_array_append(encoded, (const uint8_t *)section->name, name_len);
+        g_byte_array_append(encoded, payload->data, payload->len);
+    }
+    if (encoded->len > CRUCIBLE_FAULT_VMSTATE_MAX_TOTAL_BYTES) {
+        qemu_file_set_error(file, -E2BIG);
+        return;
+    }
+    crucible_fault_vmstate_sha256(encoded->data, encoded->len, digest);
+    qemu_put_be64(file, encoded->len);
+    qemu_put_buffer(file, encoded->data, encoded->len);
+    qemu_put_buffer(file, digest, sizeof(digest));
+}
+
+static bool crucible_fault_fingerprint_projection(QEMUFile *file,
+                                                  const void *opaque,
+                                                  Error **errp)
+{
+    static const uint8_t magic[] = "CRUCFPFAULT1";
+    g_autoptr(GPtrArray) payloads =
+        g_ptr_array_new_with_free_func((GDestroyNotify)g_byte_array_unref);
+    uint64_t total = sizeof(magic) - 1 + sizeof(uint32_t);
+
+    (void)opaque;
+    if (crucible_fault_vmstate_registry_validate() != 0) {
+        error_setg(errp, "Crucible fault projection registry is incomplete");
+        return false;
+    }
+
+    for (size_t i = 0; i < crucible_fault_vmstate_sections->len; i++) {
+        const QemuCrucibleFaultVmstateSection *section =
+            g_ptr_array_index(crucible_fault_vmstate_sections, i);
+        GByteArray *payload = g_byte_array_new();
+        size_t name_len = strlen(section->name);
+        uint64_t row_size;
+        int status;
+
+        g_ptr_array_add(payloads, payload);
+        status = section->fingerprint_projection(payload);
+        row_size = 16 + name_len + payload->len;
+        if (status != 0 ||
+            payload->len > CRUCIBLE_FAULT_VMSTATE_MAX_SECTION_BYTES ||
+            name_len == 0 ||
+            name_len > CRUCIBLE_FAULT_VMSTATE_MAX_NAME_BYTES ||
+            total > CRUCIBLE_FAULT_VMSTATE_MAX_TOTAL_BYTES - row_size) {
+            error_setg(errp,
+                       "Crucible fault projection section %s is invalid",
+                       section->name);
+            return false;
+        }
+        total += row_size;
+    }
+
+    qemu_put_buffer(file, magic, sizeof(magic) - 1);
+    qemu_put_be32(file, crucible_fault_vmstate_sections->len);
+    for (size_t i = 0; i < crucible_fault_vmstate_sections->len; i++) {
+        const QemuCrucibleFaultVmstateSection *section =
+            g_ptr_array_index(crucible_fault_vmstate_sections, i);
+        const GByteArray *payload = g_ptr_array_index(payloads, i);
+        size_t name_len = strlen(section->name);
+
+        qemu_put_be16(file, name_len);
+        qemu_put_be16(file, 0);
+        qemu_put_be32(file, section->version);
+        qemu_put_be64(file, payload->len);
+        qemu_put_buffer(file, (const uint8_t *)section->name, name_len);
+        qemu_put_buffer(file, payload->data, payload->len);
+    }
+    return qemu_file_get_error(file) == 0;
+}
+
+static const CrucibleFingerprintProjection crucible_fault_fingerprint = {
+    .schema = "crucible.qemu.fault-continuation.v1",
+    .version = 1,
+    .save = crucible_fault_fingerprint_projection,
+};
+
+static const QemuCrucibleFaultVmstateSection *
+crucible_fault_vmstate_find(const uint8_t *name, size_t name_len)
+{
+    for (size_t i = 0; i < crucible_fault_vmstate_sections->len; i++) {
+        const QemuCrucibleFaultVmstateSection *section =
+            g_ptr_array_index(crucible_fault_vmstate_sections, i);
+
+        if (strlen(section->name) == name_len &&
+            memcmp(section->name, name, name_len) == 0) {
+            return section;
+        }
+    }
+    return NULL;
+}
+
+static int crucible_fault_vmstate_load(QEMUFile *file, void *opaque,
+                                       int version_id)
+{
+    g_autofree uint8_t *encoded = NULL;
+    g_autoptr(GArray) staged = g_array_new(false, true,
+                                           sizeof(CrucibleFaultVmstateStaged));
+    bool seen[CRUCIBLE_FAULT_VMSTATE_MAX_SECTIONS] = { false };
+    uint8_t expected_digest[32];
+    uint8_t actual_digest[32];
+    uint64_t encoded_len;
+    size_t offset = 0;
+    uint32_t count;
+    int status = -EINVAL;
+
+    crucible_fault_vmstate_expected_reservations = 0;
+    crucible_fault_vmstate_counted_reservations = 0;
+    crucible_fault_vmstate_expected_deferred = 0;
+    crucible_fault_vmstate_counted_deferred = 0;
+    crucible_fault_vmstate_has_expected_reservations = false;
+    crucible_fault_vmstate_has_expected_deferred = false;
+
+    if (version_id != 1 || crucible_fault_vmstate_registry_validate() != 0) {
+        return -EINVAL;
+    }
+    encoded_len = qemu_get_be64(file);
+    if (encoded_len < 16 ||
+        encoded_len > CRUCIBLE_FAULT_VMSTATE_MAX_TOTAL_BYTES) {
+        return -E2BIG;
+    }
+    encoded = g_malloc(encoded_len);
+    if (qemu_get_buffer(file, encoded, encoded_len) != encoded_len ||
+        qemu_get_buffer(file, expected_digest, sizeof(expected_digest)) !=
+            sizeof(expected_digest)) {
+        return -EIO;
+    }
+    crucible_fault_vmstate_sha256(encoded, encoded_len, actual_digest);
+    if (memcmp(expected_digest, actual_digest, sizeof(actual_digest)) != 0 ||
+        memcmp(encoded, CRUCIBLE_FAULT_VMSTATE_MAGIC, 8) != 0 ||
+        ldl_be_p(encoded + 8) != CRUCIBLE_FAULT_VMSTATE_VERSION) {
+        return -EINVAL;
+    }
+    count = ldl_be_p(encoded + 12);
+    offset = 16;
+    if (count != crucible_fault_vmstate_sections->len) {
+        return -EINVAL;
+    }
+    for (uint32_t i = 0; i < count; i++) {
+        const QemuCrucibleFaultVmstateSection *section;
+        CrucibleFaultVmstateStaged item = { 0 };
+        uint16_t name_len;
+        uint32_t section_version;
+        uint64_t payload_len;
+        size_t section_index;
+
+        if (offset > encoded_len || encoded_len - offset < 16) {
+            goto cleanup;
+        }
+        name_len = lduw_be_p(encoded + offset);
+        if (lduw_be_p(encoded + offset + 2) != 0) {
+            goto cleanup;
+        }
+        section_version = ldl_be_p(encoded + offset + 4);
+        payload_len = ldq_be_p(encoded + offset + 8);
+        offset += 16;
+        if (name_len == 0 || name_len > CRUCIBLE_FAULT_VMSTATE_MAX_NAME_BYTES ||
+            payload_len > CRUCIBLE_FAULT_VMSTATE_MAX_SECTION_BYTES ||
+            offset > encoded_len || encoded_len - offset < name_len ||
+            encoded_len - offset - name_len < payload_len) {
+            goto cleanup;
+        }
+        section = crucible_fault_vmstate_find(encoded + offset, name_len);
+        if (!section || section->version != section_version) {
+            goto cleanup;
+        }
+        section_index = 0;
+        while (g_ptr_array_index(crucible_fault_vmstate_sections,
+                                 section_index) != section) {
+            section_index++;
+        }
+        if (seen[section_index] || section_index != i) {
+            goto cleanup;
+        }
+        seen[section_index] = true;
+        offset += name_len;
+        item.section = section;
+        item.payload = encoded + offset;
+        item.payload_len = payload_len;
+        g_array_append_val(staged, item);
+        offset += payload_len;
+    }
+    if (offset != encoded_len) {
+        status = -EINVAL;
+        goto cleanup;
+    }
+    for (size_t pass = 0; pass < 2; pass++) {
+        for (size_t i = 0; i < staged->len; i++) {
+            CrucibleFaultVmstateStaged *item = &g_array_index(
+                staged, CrucibleFaultVmstateStaged, i);
+            bool node_rules = strcmp(item->section->name, "node-rules") == 0;
+
+            if (node_rules != (pass == 0)) {
+                continue;
+            }
+            status = item->section->prepare(item->payload, item->payload_len,
+                                            &item->state);
+            if (status != 0) {
+                error_report("Crucible fault VMState section '%s' rejected "
+                             "restore: %d",
+                             item->section->name, status);
+                goto cleanup;
+            }
+        }
+    }
+    if (!crucible_fault_vmstate_has_expected_reservations ||
+        !crucible_fault_vmstate_has_expected_deferred ||
+        crucible_fault_vmstate_expected_reservations !=
+            crucible_fault_vmstate_counted_reservations ||
+        crucible_fault_vmstate_expected_deferred !=
+            crucible_fault_vmstate_counted_deferred) {
+        error_report("Crucible fault VMState reservation accounting "
+                     "mismatch: expected=%zu counted=%zu "
+                     "deferred-expected=%zu deferred-counted=%zu",
+                     crucible_fault_vmstate_expected_reservations,
+                     crucible_fault_vmstate_counted_reservations,
+                     crucible_fault_vmstate_expected_deferred,
+                     crucible_fault_vmstate_counted_deferred);
+        status = -EINVAL;
+        goto cleanup;
+    }
+    qemu_crucible_fault_vmstate_restoring(true);
+    for (size_t pass = 0; pass < 3; pass++) {
+        for (size_t i = 0; i < staged->len; i++) {
+            CrucibleFaultVmstateStaged *item = &g_array_index(
+                staged, CrucibleFaultVmstateStaged, i);
+            bool node_rules = strcmp(item->section->name, "node-rules") == 0;
+            bool command = strcmp(item->section->name, "command") == 0;
+
+            if ((pass == 0 && !node_rules) ||
+                (pass == 1 && (node_rules || command)) ||
+                (pass == 2 && !command)) {
+                continue;
+            }
+            item->section->commit(item->state);
+            item->state = NULL;
+        }
+    }
+    qemu_crucible_fault_vmstate_restoring(false);
+    status = 0;
+
+cleanup:
+    for (size_t i = 0; i < staged->len; i++) {
+        CrucibleFaultVmstateStaged *item = &g_array_index(
+            staged, CrucibleFaultVmstateStaged, i);
+        if (item->state) {
+            item->section->free_staged(item->state);
+        }
+    }
+    return status;
+}
+
+static bool crucible_fault_vmstate_active(void *opaque)
+{
+    return qemu_plugin_crucible_single_threaded_rr() &&
+        qemu_crucible_fault_lifecycle_process_bound();
+}
+
+static const SaveVMHandlers crucible_fault_vmstate_handlers = {
+    .save_prepare = crucible_fault_vmstate_save_prepare,
+    .save_state = crucible_fault_vmstate_save,
+    .load_state = crucible_fault_vmstate_load,
+    .is_active = crucible_fault_vmstate_active,
+    .crucible_fingerprint_projection = &crucible_fault_fingerprint,
+};
+
+static void crucible_fault_vmstate_machine_done_notify(
+    Notifier *notifier, void *opaque)
+{
+    int status;
+
+    (void)notifier;
+    (void)opaque;
+    status = register_savevm_live("crucible-fault", 0, 1,
+                                  &crucible_fault_vmstate_handlers, NULL);
+    if (status != 0) {
+        error_report("Crucible fault VMState registration failed: %d",
+                     status);
+        abort();
+    }
+}
+
+int qemu_crucible_fault_vmstate_enable(void)
+{
+    if (crucible_fault_vmstate_enabled) {
+        return -EALREADY;
+    }
+    crucible_fault_vmstate_machine_done.notify =
+        crucible_fault_vmstate_machine_done_notify;
+    qemu_add_machine_init_done_notifier(
+        &crucible_fault_vmstate_machine_done);
+    crucible_fault_vmstate_enabled = true;
+    return 0;
+}
diff --git a/plugins/crucible-fault.c b/plugins/crucible-fault.c
new file mode 100644
index 0000000000000000000000000000000000000000..c205caeed5675e9076afb18ac47002d6df9d0aaa
--- /dev/null
+++ b/plugins/crucible-fault.c
@@ -0,0 +1,1426 @@
+/*
+ * Crucible deterministic fault command registry and dispatcher
+ *
+ * Copyright (c) 2026 ANDYL Technologies
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/crucible-fault.h"
+#include "qemu/error-report.h"
+#include "qemu/module.h"
+#include "qemu/plugin.h"
+#include "qemu/queue.h"
+#include "qemu/bswap.h"
+#include "system/cpu-timers.h"
+
+#define CRUCIBLE_FAULT_RESULT_QUEUE_CAPACITY 4096
+#define CRUCIBLE_FAULT_SEQUENCE_WINDOW 4096
+
+typedef struct CruciblePendingFault {
+    QTAILQ_ENTRY(CruciblePendingFault) link;
+    struct qemu_plugin_crucible_fault_command command;
+    const QemuCrucibleFaultHandler *handler;
+    uint8_t *payload;
+    size_t payload_len;
+    void *handler_state;
+} CruciblePendingFault;
+
+typedef struct CrucibleCompletedFault {
+    QTAILQ_ENTRY(CrucibleCompletedFault) link;
+    struct qemu_plugin_crucible_fault_result result;
+    GByteArray *payload;
+} CrucibleCompletedFault;
+
+typedef struct CrucibleFaultCommandVmstate {
+    QTAILQ_HEAD(, CruciblePendingFault) pending;
+    QTAILQ_HEAD(, CrucibleCompletedFault) completed;
+    GHashTable *seen_sequences;
+    size_t pending_count;
+    size_t completed_count;
+    size_t deferred_count;
+    uint64_t max_command_sequence;
+} CrucibleFaultCommandVmstate;
+
+static GMutex crucible_fault_lock;
+static qemu_plugin_crucible_fault_completion_cb_t
+    crucible_fault_completion_cb;
+static void *crucible_fault_completion_userdata;
+static GPtrArray *crucible_fault_handlers;
+static GHashTable *crucible_seen_sequences;
+static QTAILQ_HEAD(, CruciblePendingFault) crucible_pending_faults =
+    QTAILQ_HEAD_INITIALIZER(crucible_pending_faults);
+static QTAILQ_HEAD(, CrucibleCompletedFault) crucible_completed_faults =
+    QTAILQ_HEAD_INITIALIZER(crucible_completed_faults);
+static size_t crucible_pending_count;
+static size_t crucible_completed_count;
+static size_t crucible_deferred_count;
+static bool crucible_registry_sealed;
+static GPtrArray *crucible_boundary_observers;
+static GPtrArray *crucible_boundary_deadlines;
+static uint64_t crucible_max_command_sequence;
+
+#define CRUCIBLE_COMMAND_VMSTATE_MAGIC "CRUFCMD1"
+#define CRUCIBLE_COMMAND_VMSTATE_VERSION 1
+#define CRUCIBLE_COMMAND_VMSTATE_HEADER_BYTES 96
+#define CRUCIBLE_COMMAND_VMSTATE_COMMAND_BYTES 168
+#define CRUCIBLE_COMMAND_VMSTATE_RESULT_BYTES 136
+
+static void crucible_fault_vmstate_append_u16(GByteArray *bytes,
+                                               uint16_t value)
+{
+    uint8_t encoded[2];
+
+    stw_be_p(encoded, value);
+    g_byte_array_append(bytes, encoded, sizeof(encoded));
+}
+
+static void crucible_fault_vmstate_append_u32(GByteArray *bytes,
+                                               uint32_t value)
+{
+    uint8_t encoded[4];
+
+    stl_be_p(encoded, value);
+    g_byte_array_append(bytes, encoded, sizeof(encoded));
+}
+
+static void crucible_fault_vmstate_append_u64(GByteArray *bytes,
+                                               uint64_t value)
+{
+    uint8_t encoded[8];
+
+    stq_be_p(encoded, value);
+    g_byte_array_append(bytes, encoded, sizeof(encoded));
+}
+
+static bool crucible_fault_vmstate_take(const uint8_t *payload,
+                                        size_t payload_len, size_t *offset,
+                                        size_t length, const uint8_t **value)
+{
+    if (*offset > payload_len || payload_len - *offset < length) {
+        return false;
+    }
+    *value = payload + *offset;
+    *offset += length;
+    return true;
+}
+
+static void crucible_fault_vmstate_encode_command(
+    GByteArray *bytes,
+    const struct qemu_plugin_crucible_fault_command *command)
+{
+    crucible_fault_vmstate_append_u16(bytes, command->abi_major);
+    crucible_fault_vmstate_append_u16(bytes, command->abi_minor);
+    crucible_fault_vmstate_append_u16(bytes, command->command_kind);
+    crucible_fault_vmstate_append_u16(bytes, command->command_flags);
+    crucible_fault_vmstate_append_u16(bytes, command->phase);
+    crucible_fault_vmstate_append_u16(bytes, command->reserved);
+    crucible_fault_vmstate_append_u32(bytes, command->semantic_version);
+    crucible_fault_vmstate_append_u64(bytes, command->command_sequence);
+    g_byte_array_append(bytes, command->target_node_hash, 32);
+    crucible_fault_vmstate_append_u64(bytes, command->target_icount);
+    crucible_fault_vmstate_append_u64(
+        bytes, command->authorization_ceiling_icount);
+    g_byte_array_append(bytes, command->binding_hash, 32);
+    g_byte_array_append(bytes, command->opportunity_hash, 32);
+    g_byte_array_append(bytes, command->expected_precondition_hash, 32);
+}
+
+static bool crucible_fault_vmstate_decode_command(
+    const uint8_t *payload, size_t payload_len, size_t *offset,
+    struct qemu_plugin_crucible_fault_command *command)
+{
+    const uint8_t *encoded;
+
+    if (!crucible_fault_vmstate_take(payload, payload_len, offset,
+                                     CRUCIBLE_COMMAND_VMSTATE_COMMAND_BYTES,
+                                     &encoded)) {
+        return false;
+    }
+    memset(command, 0, sizeof(*command));
+    command->abi_major = lduw_be_p(encoded);
+    command->abi_minor = lduw_be_p(encoded + 2);
+    command->command_kind = lduw_be_p(encoded + 4);
+    command->command_flags = lduw_be_p(encoded + 6);
+    command->phase = lduw_be_p(encoded + 8);
+    command->reserved = lduw_be_p(encoded + 10);
+    command->semantic_version = ldl_be_p(encoded + 12);
+    command->command_sequence = ldq_be_p(encoded + 16);
+    memcpy(command->target_node_hash, encoded + 24, 32);
+    command->target_icount = ldq_be_p(encoded + 56);
+    command->authorization_ceiling_icount = ldq_be_p(encoded + 64);
+    memcpy(command->binding_hash, encoded + 72, 32);
+    memcpy(command->opportunity_hash, encoded + 104, 32);
+    memcpy(command->expected_precondition_hash, encoded + 136, 32);
+    return true;
+}
+
+static void crucible_fault_vmstate_encode_result(
+    GByteArray *bytes,
+    const struct qemu_plugin_crucible_fault_result *result)
+{
+    crucible_fault_vmstate_append_u16(bytes, result->command_kind);
+    crucible_fault_vmstate_append_u16(bytes, result->status);
+    crucible_fault_vmstate_append_u16(bytes, result->phase);
+    crucible_fault_vmstate_append_u16(bytes, result->reserved);
+    crucible_fault_vmstate_append_u32(bytes, result->semantic_version);
+    crucible_fault_vmstate_append_u32(bytes, result->capability_version);
+    crucible_fault_vmstate_append_u64(bytes, result->command_sequence);
+    crucible_fault_vmstate_append_u64(bytes, result->observed_icount);
+    crucible_fault_vmstate_append_u64(bytes, result->applied_icount);
+    g_byte_array_append(bytes, result->before_hash, 32);
+    g_byte_array_append(bytes, result->after_hash, 32);
+    g_byte_array_append(bytes, result->evidence_hash, 32);
+}
+
+static bool crucible_fault_vmstate_decode_result(
+    const uint8_t *payload, size_t payload_len, size_t *offset,
+    struct qemu_plugin_crucible_fault_result *result)
+{
+    const uint8_t *encoded;
+
+    if (!crucible_fault_vmstate_take(payload, payload_len, offset,
+                                     CRUCIBLE_COMMAND_VMSTATE_RESULT_BYTES,
+                                     &encoded)) {
+        return false;
+    }
+    memset(result, 0, sizeof(*result));
+    result->command_kind = lduw_be_p(encoded);
+    result->status = lduw_be_p(encoded + 2);
+    result->phase = lduw_be_p(encoded + 4);
+    result->reserved = lduw_be_p(encoded + 6);
+    result->semantic_version = ldl_be_p(encoded + 8);
+    result->capability_version = ldl_be_p(encoded + 12);
+    result->command_sequence = ldq_be_p(encoded + 16);
+    result->observed_icount = ldq_be_p(encoded + 24);
+    result->applied_icount = ldq_be_p(encoded + 32);
+    memcpy(result->before_hash, encoded + 40, 32);
+    memcpy(result->after_hash, encoded + 72, 32);
+    memcpy(result->evidence_hash, encoded + 104, 32);
+    return true;
+}
+
+static void crucible_fault_ensure_registry(void)
+{
+    if (!crucible_fault_handlers) {
+        crucible_fault_handlers = g_ptr_array_new();
+        crucible_seen_sequences = g_hash_table_new_full(
+            g_int64_hash, g_int64_equal, g_free, NULL);
+    }
+}
+
+static int crucible_fault_capability_compare(gconstpointer left,
+                                             gconstpointer right)
+{
+    const QemuCrucibleFaultHandler *a = *(const void * const *)left;
+    const QemuCrucibleFaultHandler *b = *(const void * const *)right;
+
+    if (a->capability.command_kind != b->capability.command_kind) {
+        return a->capability.command_kind < b->capability.command_kind ? -1 : 1;
+    }
+    if (a->capability.semantic_version != b->capability.semantic_version) {
+        return a->capability.semantic_version < b->capability.semantic_version
+                   ? -1
+                   : 1;
+    }
+    if (a->capability.scope != b->capability.scope) {
+        return a->capability.scope < b->capability.scope ? -1 : 1;
+    }
+    return 0;
+}
+
+void qemu_crucible_fault_register(const QemuCrucibleFaultHandler *handler)
+{
+    size_t i;
+
+    g_assert(handler);
+    g_assert(handler->capability.command_kind != 0);
+    g_assert(handler->capability.semantic_version != 0);
+    g_assert(handler->capability.scope >=
+             CRUCIBLE_FAULT_CAPABILITY_SCOPE_ALL);
+    g_assert(handler->capability.scope <=
+             CRUCIBLE_FAULT_CAPABILITY_SCOPE_ACCELERATOR);
+    g_assert(handler->capability.phase_mask != 0);
+    g_assert(handler->capability.maximum_pending_commands != 0);
+    g_assert(handler->capability.name);
+    g_assert(handler->capability.payload_schema);
+    g_assert(!(handler->capability.required_feature_bits &
+               ~CRUCIBLE_FAULT_CAPABILITY_FEATURES_V1_MASK));
+    g_assert(handler->prepare);
+    g_assert(handler->commit);
+
+    g_mutex_lock(&crucible_fault_lock);
+    crucible_fault_ensure_registry();
+    g_assert(!crucible_registry_sealed);
+    for (i = 0; i < crucible_fault_handlers->len; i++) {
+        const QemuCrucibleFaultHandler *existing =
+            g_ptr_array_index(crucible_fault_handlers, i);
+        /*
+         * Dispatch keys omit scope, so one kind/version has one handler.
+         */
+        g_assert(existing->capability.command_kind !=
+                 handler->capability.command_kind ||
+                 existing->capability.semantic_version !=
+                 handler->capability.semantic_version);
+    }
+    g_ptr_array_add(crucible_fault_handlers, (void *)handler);
+    g_mutex_unlock(&crucible_fault_lock);
+}
+
+void qemu_crucible_fault_boundary_observer_register(
+    QemuCrucibleFaultBoundaryObserverFn observer)
+{
+    g_assert(observer && !crucible_registry_sealed);
+    if (!crucible_boundary_observers) {
+        crucible_boundary_observers = g_ptr_array_new();
+    }
+    g_ptr_array_add(crucible_boundary_observers, observer);
+}
+
+void qemu_crucible_fault_boundary_deadline_register(
+    QemuCrucibleFaultBoundaryDeadlineFn deadline)
+{
+    g_assert(deadline && !crucible_registry_sealed);
+    if (!crucible_boundary_deadlines) {
+        crucible_boundary_deadlines = g_ptr_array_new();
+    }
+    g_ptr_array_add(crucible_boundary_deadlines, deadline);
+}
+
+void qemu_crucible_fault_registry_seal(void)
+{
+    g_mutex_lock(&crucible_fault_lock);
+    crucible_fault_ensure_registry();
+    if (!crucible_registry_sealed) {
+        g_ptr_array_sort(crucible_fault_handlers,
+                         crucible_fault_capability_compare);
+        crucible_registry_sealed = true;
+    }
+    g_mutex_unlock(&crucible_fault_lock);
+}
+
+static const QemuCrucibleFaultHandler *
+crucible_fault_find_handler(uint16_t kind, uint32_t version)
+{
+    size_t i;
+
+    for (i = 0; i < crucible_fault_handlers->len; i++) {
+        const QemuCrucibleFaultHandler *handler =
+            g_ptr_array_index(crucible_fault_handlers, i);
+        if (handler->capability.command_kind == kind &&
+            handler->capability.semantic_version == version) {
+            return handler;
+        }
+    }
+    return NULL;
+}
+
+static size_t crucible_fault_handler_pending_count(
+    const QemuCrucibleFaultHandler *handler)
+{
+    CruciblePendingFault *pending;
+    size_t count = 0;
+
+    QTAILQ_FOREACH(pending, &crucible_pending_faults, link) {
+        if (pending->handler == handler) {
+            count++;
+        }
+    }
+    return count;
+}
+
+static int crucible_fault_pending_compare(const CruciblePendingFault *a,
+                                          const CruciblePendingFault *b)
+{
+    int order;
+
+    if (a->command.target_icount != b->command.target_icount) {
+        return a->command.target_icount < b->command.target_icount ? -1 : 1;
+    }
+    if (a->command.phase != b->command.phase) {
+        return a->command.phase < b->command.phase ? -1 : 1;
+    }
+    if (a->handler->capability.command_kind !=
+        b->handler->capability.command_kind) {
+        return a->handler->capability.command_kind <
+               b->handler->capability.command_kind ? -1 : 1;
+    }
+    order = memcmp(a->command.binding_hash, b->command.binding_hash, 32);
+    if (order) {
+        return order;
+    }
+    order = memcmp(a->command.opportunity_hash,
+                   b->command.opportunity_hash, 32);
+    if (order) {
+        return order;
+    }
+    if (a->command.command_sequence != b->command.command_sequence) {
+        return a->command.command_sequence < b->command.command_sequence ?
+               -1 : 1;
+    }
+    return 0;
+}
+
+static void crucible_fault_insert_pending(CruciblePendingFault *pending)
+{
+    CruciblePendingFault *cursor;
+
+    QTAILQ_FOREACH(cursor, &crucible_pending_faults, link) {
+        if (crucible_fault_pending_compare(pending, cursor) < 0) {
+            QTAILQ_INSERT_BEFORE(cursor, pending, link);
+            return;
+        }
+    }
+    QTAILQ_INSERT_TAIL(&crucible_pending_faults, pending, link);
+}
+
+static bool crucible_fault_accept_sequence(uint64_t sequence)
+{
+    uint64_t floor = 0;
+    guint64 lookup = sequence;
+    guint64 *stored;
+
+    if (crucible_max_command_sequence >= CRUCIBLE_FAULT_SEQUENCE_WINDOW) {
+        floor = crucible_max_command_sequence -
+                CRUCIBLE_FAULT_SEQUENCE_WINDOW + 1;
+    }
+    if (sequence < floor ||
+        g_hash_table_contains(crucible_seen_sequences, &lookup)) {
+        return false;
+    }
+    if (sequence > crucible_max_command_sequence) {
+        GHashTableIter iterator;
+        gpointer key;
+
+        crucible_max_command_sequence = sequence;
+        if (sequence >= CRUCIBLE_FAULT_SEQUENCE_WINDOW) {
+            floor = sequence - CRUCIBLE_FAULT_SEQUENCE_WINDOW + 1;
+            g_hash_table_iter_init(&iterator, crucible_seen_sequences);
+            while (g_hash_table_iter_next(&iterator, &key, NULL)) {
+                if (*(guint64 *)key < floor) {
+                    g_hash_table_iter_remove(&iterator);
+                }
+            }
+        }
+    }
+    stored = g_new(guint64, 1);
+    *stored = sequence;
+    g_hash_table_add(crucible_seen_sequences, stored);
+    return true;
+}
+
+static void crucible_fault_result_rejected(
+    struct qemu_plugin_crucible_fault_result *result,
+    const struct qemu_plugin_crucible_fault_command *command,
+    uint16_t status, uint64_t observed_icount)
+{
+    memset(result, 0, sizeof(*result));
+    result->command_kind = command->command_kind;
+    result->status = status;
+    result->phase = command->phase;
+    result->semantic_version = command->semantic_version;
+    result->command_sequence = command->command_sequence;
+    result->observed_icount = observed_icount;
+    result->capability_version = 1;
+}
+
+static void crucible_fault_payload_sha256(const GByteArray *payload,
+                                          uint8_t digest[32])
+{
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    gsize digest_len = 32;
+
+    g_checksum_update(checksum, payload->data, payload->len);
+    g_checksum_get_digest(checksum, digest, &digest_len);
+    g_assert(digest_len == 32);
+}
+
+static void crucible_fault_queue_result(
+    const struct qemu_plugin_crucible_fault_result *result,
+    GByteArray *payload)
+{
+    CrucibleCompletedFault *completed;
+
+    g_assert(crucible_completed_count < CRUCIBLE_FAULT_RESULT_QUEUE_CAPACITY);
+    completed = g_new0(CrucibleCompletedFault, 1);
+    completed->result = *result;
+    completed->payload = payload ? payload : g_byte_array_new();
+    crucible_fault_payload_sha256(
+        completed->payload, completed->result.evidence_hash);
+    QTAILQ_INSERT_TAIL(&crucible_completed_faults, completed, link);
+    crucible_completed_count++;
+}
+
+void qemu_crucible_fault_complete_deferred(
+    const QemuCrucibleFaultRule *rule, uint64_t observed_icount,
+    uint64_t applied_icount, const uint8_t before_hash[32],
+    const uint8_t after_hash[32])
+{
+    struct qemu_plugin_crucible_fault_result result = { 0 };
+    g_autoptr(GByteArray) payload = NULL;
+    qemu_plugin_crucible_fault_completion_cb_t completion;
+    void *completion_userdata;
+
+    g_assert(rule);
+    g_assert(applied_icount >= observed_icount);
+    result.command_kind = qemu_crucible_fault_rule_command_kind(rule);
+    result.status = CRUCIBLE_FAULT_STATUS_APPLIED;
+    result.phase = qemu_crucible_fault_rule_command_phase(rule);
+    result.semantic_version =
+        qemu_crucible_fault_rule_semantic_version(rule);
+    result.capability_version = 1;
+    result.command_sequence =
+        qemu_crucible_fault_rule_command_sequence(rule);
+    result.observed_icount = observed_icount;
+    result.applied_icount = applied_icount;
+    memcpy(result.before_hash, before_hash, 32);
+    memcpy(result.after_hash, after_hash, 32);
+    payload = qemu_crucible_fault_node_result_payload(
+        rule, before_hash, after_hash);
+    crucible_fault_payload_sha256(payload, result.evidence_hash);
+
+    g_mutex_lock(&crucible_fault_lock);
+    g_assert(crucible_deferred_count != 0);
+    crucible_deferred_count--;
+    crucible_fault_queue_result(&result, g_steal_pointer(&payload));
+    completion = crucible_fault_completion_cb;
+    completion_userdata = crucible_fault_completion_userdata;
+    g_mutex_unlock(&crucible_fault_lock);
+    if (completion) {
+        completion(completion_userdata);
+    }
+}
