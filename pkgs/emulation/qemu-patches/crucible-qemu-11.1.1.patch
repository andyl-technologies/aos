+            "-display", "none",
+            "-serial", "none",
+            "-bios", bios,
+            "-icount", icount_options,
+            "-accel", accelerator,
+            "-qmp", "stdio",
+            "-qtest", f"unix:{self.qtest_path}",
+        ]
+        if start_paused:
+            command.append("-S")
+        if plugin is not None:
+            plugin_options = (
+                f"{plugin},marker-fd={marker_write},state-fd={self.state_fd},"
+                f"wake-fd={self.wake_fd}"
+                + (
+                    ",dispatch-ceiling=true"
+                    if dispatch_ceiling is not None
+                    else ""
+                )
+                + (
+                    f",vmstop-at-observer={vmstop_at_observer}"
+                    if vmstop_at_observer is not None
+                    else ""
+                )
+                + (
+                    f",time-advance-target={time_advance_target}"
+                    if time_advance_target is not None
+                    else ""
+                )
+                + (
+                    f",control-time-advance-target={control_time_advance_target}"
+                    if control_time_advance_target is not None
+                    else ""
+                )
+                + (
+                    ",control-nonfirst-wait=true"
+                    if control_nonfirst_wait
+                    else ""
+                )
+                + (
+                    ",control-at-first-dispatch=true"
+                    if control_at_first_dispatch
+                    else ""
+                )
+                + (
+                    ",active-host-ready=true"
+                    if active_host_ready
+                    else ""
+                )
+            )
+            command.extend(["-plugin", plugin_options])
+        if dispatch_ceiling is not None:
+            command.extend(["-trace", "crucible_sim_rr_dispatch_ceiling_wait"])
+        if (
+            time_advance_target is not None or
+            control_time_advance_target is not None
+        ):
