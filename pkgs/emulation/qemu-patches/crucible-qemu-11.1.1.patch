+static int advance_observation_output(QemuCrucibleSourceAdvanceReceiver *receiver,
+                                      uint32_t version, size_t bytes,
+                                      const void *out, size_t expected, size_t alignment)
+{
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    uintptr_t address = (uintptr_t)out;
+    int status = advance_receiver_identity(receiver);
+
+    if (status) {
+        return status;
+    }
+    if (version != 1 || bytes != expected || !out || address % alignment ||
+        bytes > UINTPTR_MAX - address) {
+        return -EINVAL;
+    }
+    qemu_mutex_lock(&commands->mutex);
+    status = callback_child_output_conflicts_locked(out, bytes) ? -EINVAL : 0;
+    qemu_mutex_unlock(&commands->mutex);
+    if (!status) {
+        status = qemu_crucible_preexec_publisher_recipient_output_v1(
+            receiver->lender, receiver->recipient, receiver, out, bytes);
+    }
+    return status;
+}
