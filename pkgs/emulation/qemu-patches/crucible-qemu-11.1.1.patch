+static int crucible_hot_fork_reinitialize_child_subsystems(void *opaque)
+{
+    QemuCrucibleHotForkChildSubsystemReinitializers *reinitializers = opaque;
+    int result;
+
+    qemu_crucible_hot_fork_note_child_detail(3);
+    if (reinitializers->runtime) {
+        result = qemu_crucible_hot_fork_start_child_runtime(
+            reinitializers->runtime, reinitializers->descriptors);
+        if (result != 0) {
+            return result;
+        }
+    }
+    qemu_crucible_hot_fork_note_child_detail(4);
+    result = qemu_crucible_hot_fork_reinitialize_plugin_child(
+        reinitializers->plugin);
+    if (result != 0) {
+        return result;
+    }
+    qemu_crucible_hot_fork_note_child_detail(5);
+    if (reinitializers->runtime) {
+        result = qemu_crucible_hot_fork_finish_child_runtime(
+            reinitializers->runtime, reinitializers->descriptors);
+        if (result != 0) {
+            return result;
+        }
+    }
+    qemu_crucible_hot_fork_note_child_detail(6);
+    result = qemu_crucible_hot_fork_reinitialize_qmp_child(
+        reinitializers->qmp);
+    if (result != 0) {
+        return result;
+    }
+    qemu_crucible_hot_fork_note_child_detail(7);
+    return qemu_crucible_hot_fork_reinitialize_console_child(
+        reinitializers->console);
+}
