+bool qemu_plugin_crucible_native_time_advance_descriptor_observe_v1(
+    size_t member, QemuCrucibleNativeGroupDescriptorView *out)
+{
+    if (member) {
+        return false;
+    }
+    *out = (QemuCrucibleNativeGroupDescriptorView) {
+        .coordinate = &qemu_plugin_time_advance_cb,
+        .function = qemu_plugin_time_advance_cb,
+        .userdata = qemu_plugin_time_advance_userdata,
+        .userdata_coordinate = &qemu_plugin_time_advance_userdata,
+        .kind = QEMU_CRUCIBLE_NATIVE_REGISTERED,
+    };
