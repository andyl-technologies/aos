+        state.crucible_source_pins = 0;
+        expect_adoption_refusal(&node, parent, prepared, "immediate child");
+        state.crucible_source_pins = 1;
+        expect_adoption_refusal(&node, parent, duplicate, "frozen access flags");
+        expect_adoption_refusal(&node, parent, destination, "frozen access flags");
+
+        changed = source_file_open(prepared,
+                                   O_RDONLY | (status_flags ^ O_NONBLOCK), &err);
+        g_assert_cmpint(changed, >=, 0);
+        g_assert_null(err);
+        expect_adoption_refusal(&node, parent, changed, "frozen access flags");
+        g_assert_cmpint(close(changed), ==, 0);
+
+        bool adopted_ok = raw_crucible_hot_fork_file_child(
+            &node, parent, retained_adoption ? adoption_fd : prepared, &err);
+        if (!adopted_ok) {
+            fprintf(stderr, "native adoption refused: %s\n", error_get_pretty(err));
+        }
+        g_assert_true(adopted_ok);
+        g_assert_null(err);
+        g_assert_true(state.crucible_child_descriptor);
+        g_assert_cmpint(state.crucible_source_owner, ==, getpid());
+        g_assert_cmpint(fcntl(duplicate, F_GETFD), ==, -1);
+        g_assert_cmpint(errno, ==, EBADF);
