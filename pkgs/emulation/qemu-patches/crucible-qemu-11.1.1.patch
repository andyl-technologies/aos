+/* Negative-only unavailable Source bridges. These controls cannot create an
+ * owner or admit physical cleanup; they check refusal before Native entry. */
+static unsigned drain_calls;
+static unsigned source_return_calls;
+static unsigned component_return_calls;
+int qemu_crucible_startup_source_publisher_service_drain_v1(
+    QemuCrucibleSourceControlBinding *component,
+    QemuCrucibleSourceControlBinding **holder)
+{
+    drain_calls++;
