+QemuCrucibleFaultEventReservation *
+qemu_crucible_fault_event_reservation_restore_for_rule_v1(
+    size_t remaining, const QemuCrucibleFaultRule *rule,
+    QemuCrucibleHangEventRole role)
+{
+    g_auto(CrucibleNodeStorageOperation) operation = node_storage_operation_begin();
+    QemuCrucibleFaultRegistration *origin;
+
+    if (!operation.entered || qemu_crucible_fault_vmstate_restore_current_v1() ||
+        !node_storage_rule_origin(rule, &origin)) {
+        return NULL;
+    }
+    QemuCrucibleFaultEventReservation *reservation =
+        node_reservation_restore_owned(remaining, origin);
+
+    if (reservation && !node_envelope_prepare(reservation, rule, role)) {
+        qemu_crucible_fault_event_reservation_discard(reservation);
+        return NULL;
+    }
+    return reservation;
+}
