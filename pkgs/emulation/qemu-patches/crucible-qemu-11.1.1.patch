+#ifdef CRUCIBLE_NODE_LIVE_EMERGENCY
+static void live_node_emergency(const struct qemu_plugin_crucible_fault_command *command)
+{
+    QemuCrucibleFaultRule *rule = node_find_rule(
+        command->command_kind, command->binding_hash, NULL);
+    QemuCrucibleFaultRegistration *owner = live_node_owner(command->command_kind);
+    struct qemu_plugin_crucible_fault_event event;
+    uint8_t payload[4096];
+    size_t length;
+    CrucibleNodeEvent *queued;
+    CrucibleNodeRegistrationChild *child;
+    int status;
+
+    assert(rule && owner && owner->pending);
+    assert(QTAILQ_EMPTY(&crucible_node_events));
+    qemu_crucible_fault_internal_terminal(rule, 1);
+    queued = QTAILQ_FIRST(&crucible_node_events);
+    assert(queued && queued->event.outcome == CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR);
+    child = node_envelope_child_locked(NULL, queued, CRUCIBLE_NODE_ENVELOPE_CHILD);
+    assert(child && node_envelope_child_current(child));
+    assert(child->envelope_role == CRUCIBLE_NODE_ENVELOPE_EMERGENCY_ROLE);
+    assert(child->envelope_capacity == 192 + rule->payload_len + 128);
+    assert(child->envelope_extent == sizeof(CrucibleNodeEnvelope) + child->envelope_capacity);
+    assert(qemu_plugin_crucible_fault_event_peek(&event, &length) == 1);
+    assert(length == child->envelope_capacity && length <= sizeof(payload));
+    status = qemu_plugin_crucible_fault_event_poll(&event, payload, sizeof(payload), &length);
+    assert(child->returning && child->payload_returned && child->physically_returned);
+#ifdef CRUCIBLE_NODE_LIVE_ENVELOPE_POST_FAILURE
+    assert(status == -EIO && child->post_status == -EIO);
+    assert(child->envelope_custodian == queued);
+    assert(QTAILQ_FIRST(&crucible_node_events) == queued);
+    assert(!node_event_bytes(queued));
+    assert(qemu_plugin_crucible_fault_event_poll(&event, payload, sizeof(payload), &length) == -EIO);
+    assert(child->post_status == -EIO && child->physically_returned);
+    puts("PASS actual emergency envelope consumed-negative return retained without retry");
+#else
+    assert(status == 1 && !child->post_status && !child->envelope_custodian);
+    assert(QTAILQ_EMPTY(&crucible_node_events));
+    assert(event.evidence_length == 128 && ldl_le_p(payload + 16) == 128);
+    assert(!memcmp(payload + 192 + rule->payload_len, "CRUCLIM1", 8));
+    GError *error = NULL;
+
+    assert(g_file_set_contents("ordinary-emergency-event.bin", (char *)payload, length, &error));
+    assert(!error);
+    puts("PASS actual emergency envelope birth and public physical return");
+#endif
+    assert(owner->holder == owner && owner->registry_published && owner->pending);
+    assert(qemu_crucible_fault_node_registration_return_v1(&owner->holder) == -EBUSY);
+    fflush(stdout);
+    /* This component ends with genuine pending/rule/CPU/process debts. The
+     * process exit is not a receipt for those independent owners. */
+    exit(EXIT_SUCCESS);
+}
+#endif
