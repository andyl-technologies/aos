+                                          int (*)(APICCommonState *)),
+               "TPR dispatch must preserve negative failure");
+_Static_assert(__builtin_types_compatible_p(
+                   __typeof__(((APICCommonClass *)0)->get_tpr),
+                   int (*)(APICCommonState *)),
+               "TPR virtual slot must preserve negative failure");
+"""
+    prefix = registers[registers.index("#define CRUCIBLE_REG_GROUP_GPR"):
+                       registers.index("int x86_crucible_register_validate_write(")]
+    gdb_prefix = gdb[gdb.index("#ifdef TARGET_X86_64"):
+                     gdb.index("static int x86_cpu_gdb_load_seg(")]
+    producers = "\n".join(
+        function((source / path).read_text(), f"static int {name}(")
+        for path, name in (
+            ("hw/i386/kvm/apic.c", "kvm_apic_get_tpr"),
+            ("hw/i386/xen/xen_apic.c", "xen_apic_get_tpr"),
+            ("target/i386/whpx/whpx-apic.c", "whpx_apic_get_tpr"),
+        )
+    )
+    target_info = (source / "target-info.c").read_text()
+    endian = function(target_info, "EndianMode target_endian_mode(")
+    endian += function(target_info, "bool target_big_endian(")
+    common = function((source / "hw/intc/apic_common.c").read_text(),
+                      "int cpu_get_apic_tpr(")
+    common = common.replace("int cpu_get_apic_tpr(",
+                            "static int common_cpu_get_apic_tpr(", 1)
+    return headers + INPUTS + endian + prefix + gdb_prefix + producers + common + CHECKS
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--source-root", type=Path, default=Path(__file__).resolve().parents[2])
+    parser.add_argument("--output-dir", type=Path, required=True)
+    arguments = parser.parse_args()
+    source = arguments.source_root.resolve()
+    output = arguments.output_dir.resolve()
+    output.mkdir(parents=True, exist_ok=True)
+    literal = translation_unit(source)
+    variants = {
+        "positive": literal,
+        "omit-architecture-refusal": literal.replace("if (tpr < 0) {\n            return tpr;", "if (false) {\n            return tpr;"),
+        "omit-gdb-refusal": literal.replace("if (tpr < 0) {\n                return 0;", "if (false) {\n                return 0;"),
+        "omit-null-zero": literal.replace("if (!s) {\n        return 0;", "if (!s) {\n        return -EPERM;"),
+    }
+    expected_assertions = {
+        "omit-architecture-refusal":
+            "x86_crucible_register_read(cpu, X86_CRUCIBLE_CR8, value, sizeof(value)) == refused_status",
+        "omit-gdb-refusal":
+            "x86_cpu_gdb_read_register(cpu, output, IDX_CTL_CR8_REG) == 0",
+        "omit-null-zero": "common_cpu_get_apic_tpr(NULL) == 0",
+    }
+    proof = {}
+    for name, body in variants.items():
+        if name != "positive" and body == literal:
+            raise ValueError(f"ineffective mutation: {name}")
+        generated = output / f"{name}.c"
+        binary = output / name
+        generated.write_text(body)
+        command = [*shlex.split(os.environ.get("CC", "cc")),
+                   *shlex.split(os.environ.get("CFLAGS", "")),
+                   "-I" + str(source / "target/i386"),
+                   "-ffunction-sections", "-fdata-sections", str(generated),
+                   "-o", str(binary), "-Wl,--gc-sections",
+                   *shlex.split(os.environ.get("LDFLAGS", ""))]
+        (output / f"{name}.compile-command.json").write_text(json.dumps(command, indent=2) + "\n")
+        subprocess.run(command, check=True)
+        result = subprocess.run([str(binary)], cwd=output, text=True,
+                                stdout=subprocess.PIPE, stderr=subprocess.STDOUT, timeout=30)
+        (output / f"{name}.log").write_text(result.stdout)
+        expected = 0 if name == "positive" else -6
+        if result.returncode != expected:
+            raise RuntimeError(f"unexpected {name}: {result.returncode}\n{result.stdout}")
+        if name != "positive" and expected_assertions[name] not in result.stdout:
+            raise RuntimeError(f"wrong assertion for {name}:\n{result.stdout}")
+        proof[name] = {"returncode": result.returncode, "output": result.stdout}
+    (output / "proof.json").write_text(json.dumps(proof, indent=2) + "\n")
