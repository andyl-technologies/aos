+    status = qemu_crucible_ram_inventory_capture_identity_v1(loan, capture);
+    if (status) {
+        return status;
+    }
+    loan->capture = capture;
+    loan->pin = capture;
+    loan->capture_holder = out;
+    *out = capture;
