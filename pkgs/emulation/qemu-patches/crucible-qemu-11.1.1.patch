+                 'static bool crucible_clock_terminal;\n'
+                 'static uint8_t crucible_clock_manifest_digest[32];\n'
+                 'static const uint8_t zero32[32];\n'
+                 'void qemu_crucible_fault_rule_reference_vmstate_save(\n'
+                 '    GByteArray *bytes, const QemuCrucibleFaultRule *rule)\n'
+                 '{ abort(); }\n')
+        checks = CHECKS.replace("int main(void)", "static void check_legacy_identity(void);\n\nint main(void)")
+        checks = checks.replace("    check_complete_limit();",
+                                "    check_complete_limit();\n    check_legacy_identity();")
+        serialized = function(source, "static void crucible_clock_vmstate_put_source(")
+        fields = list(dict.fromkeys(re.findall(r"source->(\w+(?:\.\w+)?)", serialized)))
+        seed = ('static void seed_serialization(CrucibleClockSource *a, '
+                'LegacyClockSource *b, uint64_t base)\n{\n'
+                '    /* Factual serialization vectors, not admitted VMState. */\n')
+        for index, field in enumerate(fields, 1):
+            if field in ("fallback_id", "previous_fallback_id"):
+                seed += (f'    memset(a->{field}, base + {index}, 32);\n'
+                         f'    memset(b->{field}, base + {index}, 32);\n')
+            else:
+                seed += f'    a->{field} = b->{field} = base + {index};\n'
+        seed += '}\n'
+        variants = {"identity": current_save}
+        for field in ("capability.epoch_ns", "read_sequence", "transform_generation",
+                      "source_transition_generation", "timer_new_guest_deadline_ps",
+                      "previous_fallback_id", "fallback_id", "timer_action", "has_last_value"):
