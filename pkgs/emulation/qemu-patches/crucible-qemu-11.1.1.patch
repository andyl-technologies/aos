+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Non-system users cannot issue or return selected Park storage custody. */
+#include "qemu/osdep.h"
+#include "system/crucible-native-park-request.h"
+
+/* Declaration-only users can supply the real singleton extent while the
+ * operations below remain unavailable. Only this passive fallback is weak;
+ * request identity, storage and gate providers stay together and strong.
+ */
+size_t __attribute__((weak))
+qemu_crucible_native_park_request_static_extent(void)
+{
+    /* No request singleton exists here. Source rejects this absent extent. */
+    return 0;
+}
+
+int qemu_crucible_native_park_storage_prepare(
+    QemuCrucibleNativeParkCapture *capture, QemuCrucibleNativeParkArray array,
+    size_t count, size_t size, size_t alignment, uint64_t generation,
+    QemuCrucibleNativeParkStorageLoan *out)
+{
+    (void)capture;
+    (void)array;
+    (void)count;
+    (void)size;
+    (void)alignment;
+    (void)generation;
+    (void)out;
+
+    /* Preserve any caller-held output; no attempt or credit was issued. */
+    return -ENOTSUP;
+}
+
+void qemu_crucible_native_park_storage_record(
+    QemuCrucibleNativeParkCapture *capture,
+    const QemuCrucibleNativeParkStorageLoan *loan, void *raw)
+{
+    (void)loan;
+    (void)raw;
+
+    /* Ordinary NULL inventory routes do not call this hook. A non-NULL
+     * capture cannot have passed this provider's negative preparation. */
+    if (capture) {
+        abort();
+    }
+}
+
+int qemu_crucible_native_park_storage_free(
+    QemuCrucibleNativeParkStorageLoan *loan, void *raw)
+{
+    (void)loan;
+    (void)raw;
+
+    /* Keep the loan and raw storage intact; this provider owns neither. */
+    return -ENOTSUP;
+}
+
+int qemu_crucible_native_park_capture_release_ready(
+    QemuCrucibleNativeParkCapture *capture, QemuCrucibleNativeParkArray array,
+    uint64_t barrier_generation)
+{
