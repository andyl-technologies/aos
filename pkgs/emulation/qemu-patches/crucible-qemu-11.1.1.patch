+int qemu_plugin_crucible_native_registry_retired_current_v1(
+    QemuCrucibleNativeInvocationRegistry *registry)
+{
+    pid_t process = getpid();
+    int status = 0;
+    size_t i;
+
+    if (!registry) {
+        return -EINVAL;
+    }
+    if (!registry_process_current(registry, process)) {
+        return -EPERM;
+    }
+    qemu_mutex_lock(&registry->mutex);
+    if (!registry_identity_locked(registry, process)) {
+        status = -EPERM;
+    } else if (!registry->revoked || registry->bound ||
+               registry->registrar_users || registry->source_registrar ||
+               group_debt_locked(registry, NULL)) {
+        status = -EBUSY;
+    } else {
+        for (i = 0; i < ARRAY_SIZE(registry->frames); i++) {
+            if (registry->frames[i].canonical_owner) {
+                status = -EBUSY;
+                break;
+            }
+        }
+        for (i = 0; !status && i < ARRAY_SIZE(registry->registrations); i++) {
+            if (registry->registrations[i].descriptor_retained ||
+                registry->registrations[i].active ||
+                registry->registrations[i].references) {
