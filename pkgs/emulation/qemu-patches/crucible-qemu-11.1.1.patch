+
+#include "plugins/qemu-plugin.h"
+
+/* Stack custody belongs to the actual existing native CPU thread. Only the
+ * USED before/after-TB and exceptional-unwind call sites publish this address. */
+typedef struct QemuCrucibleObservationCpuBoundaryScope {
+    uint64_t generation;
+    bool active;
+} QemuCrucibleObservationCpuBoundaryScope;
+
+typedef enum QemuCrucibleObservationCpuBoundaryPhase {
+    QEMU_CRUCIBLE_CPU_BOUNDARY_BEFORE_INSTRUCTION,
+    QEMU_CRUCIBLE_CPU_BOUNDARY_AFTER_INSTRUCTION,
+    QEMU_CRUCIBLE_CPU_BOUNDARY_EXCEPTION_RETURN,
+} QemuCrucibleObservationCpuBoundaryPhase;
+
+int qemu_crucible_observation_cpu_boundary_begin_v1(
+    QemuCrucibleObservationCpuBoundaryScope *scope, void *cpu,
+    QemuCrucibleObservationCpuBoundaryPhase phase);
+int qemu_crucible_observation_cpu_boundary_end_v1(
+    QemuCrucibleObservationCpuBoundaryScope *scope);
+/* Actual cpu_exec_longjmp_cleanup invalidates an abandoned marker; it cannot
+ * discard a genuinely retained writer borrower or supply new permission. */
+int qemu_crucible_observation_cpu_boundary_unwind_v1(void *cpu);
+
+typedef struct QemuCrucibleObservationWriterFence
+    QemuCrucibleObservationWriterFence;
+
+/* Native Source invocation identity is an input fact. This issuer independently
+ * closes actual CPU/RAM admission and borrows the existing background closure.
+ * A nonnull out always owns physical return, including on a negative result. */
+int qemu_crucible_observation_writer_acquire_v1(
+    uint64_t id, QemuCrucibleObservationWriterFence **out);
+int qemu_crucible_observation_writer_current_v1(
+    QemuCrucibleObservationWriterFence *fence);
+/* Identity-only physical return; consume a cleared owner even on a negative
+ * semantic status. No Source post, clock, dirty clear or TLB work is performed. */
+/* Nonallocating creator fact for containment of an old retained CPU owner.
+ * A negative forbids creator-only return on Main; zero grants no RAM/Source
+ * permission and does not certify closure or completed CPU execution. */
+int qemu_crucible_observation_writer_creator_current_v1(
+    QemuCrucibleObservationWriterFence *fence);
+int qemu_crucible_observation_writer_return_v1(
+    QemuCrucibleObservationWriterFence **owner);
+/* Geometry of the actual existing fence carrier. These facts issue no Source
+ * fee. A different embedding must price its own complete body before birth. */
+size_t qemu_crucible_observation_writer_fence_body_bytes_v1(void);
+size_t qemu_crucible_observation_writer_fence_body_alignment_v1(void);
+size_t qemu_crucible_observation_writer_metadata_bytes_v1(void);
+
+typedef struct QemuCrucibleObservationRootExecutionWitness
+    QemuCrucibleObservationRootExecutionWitness;
+
+/* Borrows the actual early native RootFrame after issued Source entry and the
+ * matching real cpu_exec_start epoch. This is passive and grants no RAM/time. */
+int qemu_crucible_observation_root_execution_borrow_v1(
+    uint64_t id, QemuCrucibleObservationRootExecutionWitness **out);
+/* Current authenticates retained journal identity only. Ended additionally
+ * requires matching cpu_exec_end publication. Neither closes foreign CPUs. */
+int qemu_crucible_observation_root_execution_current_v1(
+    QemuCrucibleObservationRootExecutionWitness *witness);
+int qemu_crucible_observation_root_execution_ended_v1(
+    QemuCrucibleObservationRootExecutionWitness *witness);
+/* Identity-only passive return, including before end. A consumed pointer or
+ * successful return must never be substituted for an ended witness. */
+int qemu_crucible_observation_root_execution_identity_return_v1(
+    QemuCrucibleObservationRootExecutionWitness **owner);
+size_t qemu_crucible_observation_root_execution_body_bytes_v1(void);
+size_t qemu_crucible_observation_root_execution_body_alignment_v1(void);
+
+/* Cleanup CPU entry points and nominal types belong to the plugin SDK above.
+ * Their retained candidate and execution-end witness grant no RAM exclusion,
+ * Original time, dirty clear or rearm. These getters describe the actual body;
