@@ -0,0 +1,93 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/* Internal, process-local Park request census. No allocation authority. */
+#ifndef QEMU_CRUCIBLE_PARK_CENSUS_H
+#define QEMU_CRUCIBLE_PARK_CENSUS_H
+
+typedef enum QemuCrucibleNativeParkArray {
+    QEMU_CRUCIBLE_PARK_BLOCK_ENTRIES,
+    QEMU_CRUCIBLE_PARK_PERSISTENT_ROOTS,
+    QEMU_CRUCIBLE_PARK_ROOT_COPY,
+    QEMU_CRUCIBLE_PARK_RCU_READERS,
+    QEMU_CRUCIBLE_PARK_AIO_CONTEXTS,
+    QEMU_CRUCIBLE_PARK_BOTTOM_HALVES,
+    QEMU_CRUCIBLE_PARK_AIO_HANDLERS,
+    QEMU_CRUCIBLE_PARK_TIMERS,
+    QEMU_CRUCIBLE_PARK_ARRAY_COUNT,
+} QemuCrucibleNativeParkArray;
+
+typedef struct QemuCrucibleNativeParkCapture QemuCrucibleNativeParkCapture;
+struct QemuCrucibleNativeParkRequest;
+
+/* Linear physical owner of one actual array incarnation. Copying this value
+ * does not create another user or permission to free the same raw result. */
+typedef struct QemuCrucibleNativeParkStorageLoan {
+    struct QemuCrucibleNativeParkRequest *request;
+    uint64_t sequence;
+    QemuCrucibleNativeParkArray array;
+} QemuCrucibleNativeParkStorageLoan;
+
+/* These pure internal custody checks run only at the actual producer lock
+ * cut. Their implementation consumes the real Source child credit; no clock,
+ * policy callback or arbitrary allocator callback is invoked here. */
+/* A gate is returned only after the exact capture's live storage has gone. */
+int qemu_crucible_native_park_capture_release_ready(
+    QemuCrucibleNativeParkCapture *capture, QemuCrucibleNativeParkArray array,
+    uint64_t barrier_generation);
+void qemu_crucible_native_park_capture_released(
+    QemuCrucibleNativeParkCapture *capture, QemuCrucibleNativeParkArray array,
+    uint64_t barrier_generation);
+
+int qemu_crucible_native_park_storage_prepare(
+    QemuCrucibleNativeParkCapture *capture, QemuCrucibleNativeParkArray array,
+    size_t count, size_t size, size_t alignment, uint64_t generation,
+    QemuCrucibleNativeParkStorageLoan *out);
+/* Captured arrays use an exact page-rounded mapping, independently of GLib's
+ * process allocator. The corresponding Source debit precedes this syscall. */
+int qemu_crucible_native_park_mapping_extent(size_t bytes, size_t *out);
+void *qemu_crucible_native_park_storage_allocate(
+    QemuCrucibleNativeParkCapture *capture,
+    QemuCrucibleNativeParkStorageLoan *loan);
+void qemu_crucible_native_park_storage_record(
+    QemuCrucibleNativeParkCapture *capture,
+    const QemuCrucibleNativeParkStorageLoan *loan, void *raw);
+int qemu_crucible_native_park_storage_free(
+    QemuCrucibleNativeParkStorageLoan *loan, void *raw);
+
+typedef struct QemuCrucibleParkArrayRequest {
+    size_t count;
+    size_t element_size;
+    size_t element_alignment;
+    size_t bytes;
+    const void *retained_alias;
+} QemuCrucibleParkArrayRequest;
+
+typedef struct QemuCrucibleParkCensus {
+    uint64_t generation[4];
+    uint64_t barrier_generation;
+    int64_t owner_thread_id;
+    QemuCrucibleParkArrayRequest arrays[4];
+    bool held;
+    bool complete;
+    bool acquired;
+} QemuCrucibleParkCensus;
+
+/* Describes the actual typed payload request, never an allocator fee. */
+static inline bool
+qemu_crucible_park_array_request(QemuCrucibleParkArrayRequest *out,
+                                 size_t count, size_t element_size,
+                                 size_t element_alignment, const void *alias)
+{
+    if (!element_size || count > SIZE_MAX / element_size) {
+        return false;
+    }
+    *out = (QemuCrucibleParkArrayRequest){
+        .count = count,
+        .element_size = element_size,
+        .element_alignment = element_alignment,
+        .bytes = count * element_size,
+        .retained_alias = alias,
+    };
+    return true;
+}
+
+#endif
