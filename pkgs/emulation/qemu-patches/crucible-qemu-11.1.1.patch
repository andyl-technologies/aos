+int qemu_plugin_crucible_startup_setup_return_v4(qemu_plugin_id_t id)
+{
+#if defined(CONFIG_LINUX) && defined(__x86_64__) && !defined(__ILP32__)
+    QemuCruciblePublisherModuleService *service = &startup_source.publisher_module;
+    int first;
+    int post;
+    int identity;
+
+    /* Consumed retries report retained facts without releasing again. A live
+     * child still requires the real entered installer, even after failure. */
+    if (service->attempted && !service->held && service->returned &&
+        !startup_setup_service_binding_identity(id)) {
+        return service->return_first_status ? service->return_first_status :
+            service->return_post_status;
+    }
+    first = startup_setup_service_identity(id);
+    if (first || service->transition_active) {
+        return first ? first : -EBUSY;
+    }
+    if (service->transferred) {
+        return -EPERM;
+    }
+    first = startup_setup_service_installer_current(id);
+    if (first) {
+        return first;
+    }
+    service->closing = true;
+    service->transition_active = true;
+    first = qemu_crucible_preexec_publisher_module_return_v1(
+        service->lender, service, &service->returned);
+    post = qemu_crucible_preexec_purpose_check_v3(startup_source.preexec_purpose_owner);
+    identity = startup_setup_service_identity(id);
+    if (!service->return_attempted) {
+        service->return_attempted = true;
+        service->return_first_status = first;
+        service->return_post_status = post;
+    }
+    startup_setup_service_return_finish(service, identity);
+    return service->return_first_status ? service->return_first_status :
+        service->return_post_status ? service->return_post_status :
+        first ? first : post ? post : identity;
+#else
+    return -ENOTSUP;
+#endif
+}
