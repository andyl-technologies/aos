+void object_unref(void *object)
+{
+    (void)object;
+    g_assert_not_reached();
+}
+
+static void record(char event)
+{
+    assert(event_count + 1 < sizeof(events));
+    events[event_count++] = event;
+    events[event_count] = '\0';
+}
+
+static void qemu_mutex_lock(FixtureMutex *mutex)
+{
+    for (unsigned index = 0; index < 2; index++) {
+        if (mutex == &cpus[index].work_mutex) {
+            cycles[index]++;
+        }
+    }
+    g_mutex_lock(mutex);
+}
+
+static void qemu_mutex_unlock(FixtureMutex *mutex)
+{
+    g_mutex_unlock(mutex);
+}
+
+static void bql_unlock(void)
+{
+    assert(locked);
+    locked = false;
+    record('u');
+}
+
+static void bql_lock(void)
+{
+    assert(!locked);
+    locked = true;
+    record('l');
+}
+
+static void start_exclusive(void)
+{
+    assert(!locked && !exclusive);
+    assert(current_cpu == &cpus[0] || current_cpu == &cpus[1]);
+    exclusive = true;
+    record('x');
+}
+
+static void end_exclusive(void)
+{
+    assert(!locked && exclusive);
+    exclusive = false;
+    record('y');
+}
+
+static bool qemu_cpu_is_self(CPUState *cpu)
+{
+    return current_cpu == cpu;
+}
+
+static void cpu_exit(CPUState *cpu)
+{
+    cpu->exit_request = true;
+}
+
+static void qemu_cond_broadcast(QemuCond *condition)
+{
+    if (condition == &qemu_pause_cond) {
+        assert(locked && current_cpu && current_cpu->stopped);
+        record('S' + current_cpu->cpu_index);
+    }
+}
+
+static void kick_provider(CPUState *cpu)
+{
+    kicks++;
+    cpu->thread_kicked = true;
+    cpu_exit(cpu);
+}
+
+static AccelOpsClass ops = { kick_provider }, *cpus_accel = &ops;
+
+static void cpus_kick_thread(CPUState *cpu)
+{
+    kick_provider(cpu);
+}
+
+static void qemu_plugin_crucible_kick_idle_wait(CPUState *cpu)
+{
+    assert(cpu->thread_kicked && cpu->exit_request);
+    idle_bridges++;
+}
+
+static int icount_enabled(void) { return count_mode; }
+static bool all_cpu_threads_idle(void) { return host_idle; }
+static bool qemu_force_shutdown_requested(void) { return false; }
+static bool rr_crucible_sim_all_vcpus_halted(void) { return host_idle; }
+static bool rr_crucible_sim_complete_wake_boundary(void) { return false; }
+static void rr_hot_fork_note_parked(void) { }
+static void rr_crucible_sim_prepark(bool advance, bool control)
+{
+    (void)advance;
+    (void)control;
+    assert(!"Sim prepark outside bounded scenarios");
+}
+
+static QemuPluginCrucibleIdleCallbackDisposition
+rr_crucible_sim_sync_vcpu_halt_callbacks(void)
+{
+    return QEMU_PLUGIN_CRUCIBLE_IDLE_CALLBACK_COMPLETE;
+}
+
+static void rr_start_kick_timer(void) { timer_starts++; }
+static void rr_stop_kick_timer(void) { timer_stops++; }
+static void icount_start_warp_timer(void) { warps++; }
+static void icount_handle_deadline(void) { deadlines++; }
+static void qemu_clock_run_timers(int clock)
+{
+    assert(clock == QEMU_CLOCK_VIRTUAL);
+    timers++;
+}
+
+static void qemu_cond_wait_bql(QemuCond *condition)
+{
+    assert(locked && condition == &halt_cond);
+    assert(++waits <= 2);
+    bql_unlock();
+    /* A bounded host pass publishes work or pause/control, then wakes RR. */
+    if (wait_action == 1) {
+        current_cpu = NULL;
+        cpu_pause(&cpus[0]);
+        async_run_on_cpu(&cpus[1], work_callback,
+                         (run_on_cpu_data){ .host_ulong = 'K' });
+        qemu_cpu_kick(&cpus[0]);
+    } else if (wait_action == 2) {
+        current_cpu = NULL;
+        async_run_on_cpu(&cpus[0], work_callback,
+                         (run_on_cpu_data){ .host_ulong = 'C' });
+        qemu_plugin_rr_control_request_generation++;
+        qemu_cpu_kick(&cpus[0]);
+    } else {
+        assert(!"unexpected bounded wait action");
+    }
+    current_cpu = &sentinel;
+    host_idle = false;
+    bql_lock();
+}
+"""
+
+CHECKS = r"""
+static void reset(bool sim, int mode)
+{
+    for (unsigned index = 0; index < 2; index++) {
+        assert(QSIMPLEQ_EMPTY(&cpus[index].work_list));
+        cpus[index].stop = cpus[index].stopped = cpus[index].unplug = false;
+        cpus[index].thread_kicked = cpus[index].exit_request = false;
+        cycles[index] = 0;
+    }
+    machine.accelerator = &accelerator;
+    accelerator.is_sim = sim;
+    current_cpu = &sentinel;
+    count_mode = mode;
+    locked = true;
+    exclusive = host_idle = false;
+    waits = kicks = idle_bridges = callbacks = 0;
+    timer_starts = timer_stops = warps = deadlines = timers = 0;
+    qemu_plugin_time_advance_pending = 0;
+    qemu_plugin_crucible_vmstop_state = 0;
+    qemu_plugin_control_boundary_deferred = false;
+    qemu_plugin_rr_control_request_generation = 0;
+    qemu_plugin_rr_control_complete_generation = 0;
+    wait_action = 0;
+    event_count = 0;
+    events[0] = '\0';
+}
+
+static void work_callback(CPUState *cpu, run_on_cpu_data data)
+{
+    char event = data.host_ulong;
+
+    assert(current_cpu == cpu);
+    assert(locked != exclusive);
+    callbacks++;
+    record(event);
+    if (event == 'B') {
+        /* The later sibling adds work to the CPU already visited by the walk. */
+        async_run_on_cpu(&cpus[0], work_callback,
+                         (run_on_cpu_data){ .host_ulong = 'A' });
+    } else if (event == 'A') {
+        /* A second hop must also finish before the first stop acknowledgment. */
+        async_run_on_cpu(&cpus[1], work_callback,
+                         (run_on_cpu_data){ .host_ulong = 'C' });
+    }
+}
+
+static void enqueue(CPUState *cpu, char event, bool safe)
+{
+    run_on_cpu_data data = { .host_ulong = event };
+
+    if (safe) {
+        async_safe_run_on_cpu(cpu, work_callback, data);
+    } else {
+        async_run_on_cpu(cpu, work_callback, data);
+    }
+}
+
+static void check_healthy(void)
+{
+    for (unsigned sim = 0; sim < 2; sim++) {
+        for (int mode = 0; mode < 3; mode++) {
+            reset(sim, mode);
+            cpus[0].thread_kicked = cpus[1].thread_kicked = true;
+            rr_wait_io_event();
+            unsigned expected = !sim ? 3 : mode == ICOUNT_PRECISE ? 6 : 8;
+            assert(cycles[0] == expected && cycles[1] == expected);
+            assert(current_cpu == &sentinel && locked);
+            assert(!cpus[0].thread_kicked && !cpus[1].thread_kicked);
+            assert(!waits && !callbacks && !warps && !timers);
+            assert(timer_starts == 1 && timer_stops == 0);
+
+            char trace[sizeof(events)];
+            memcpy(trace, events, sizeof(trace));
+            reset(sim, mode);
+            old_wait_io_event();
+            unsigned old_expected = sim && mode == ICOUNT_PRECISE ? 6 : 8;
+            assert(cycles[0] == old_expected && cycles[1] == old_expected);
+            assert(!strcmp(trace, events));
+            assert(current_cpu == &sentinel && locked);
+        }
+    }
+    reset(false, 0);
+    machine.accelerator = NULL;
+    rr_wait_io_event();
+    assert(cycles[0] == 3 && cycles[1] == 3);
+    current_machine = NULL;
+    rr_wait_io_event();
+    assert(cycles[0] == 6 && cycles[1] == 6);
+    current_machine = &machine;
+    puts("PASS healthy ordinary 8->3 cycles per CPU; precise/adaptive/off Sim, absent accelerator and early startup");
+}
+
+static void check_wrapper(void)
+{
+    for (unsigned sim = 0; sim < 2; sim++) {
+        for (int mode = 0; mode < 3; mode++) {
+            reset(sim, mode);
+            cpus[0].stop = cpus[0].thread_kicked = true;
+            enqueue(&cpus[0], 'E', true);
+            enqueue(&cpus[0], 'F', false);
+            rr_crucible_sim_process_vcpu_events(&cpus[0]);
+            assert(!strcmp(events, sim ? "uxEylFS" : "SuxEylF"));
+            assert(current_cpu == &sentinel && locked && !exclusive);
+            assert(cpus[0].stopped && !cpus[0].stop && !cpus[0].thread_kicked);
+            assert(callbacks == 2 && cpu_work_list_empty(&cpus[0]));
+            if (sim) {
+                char trace[sizeof(events)];
+                memcpy(trace, events, sizeof(trace));
+                reset(sim, mode);
+                cpus[0].stop = true;
+                enqueue(&cpus[0], 'E', true);
+                enqueue(&cpus[0], 'F', false);
+                old_process_vcpu_events(&cpus[0]);
+                assert(!strcmp(trace, events));
+                assert(current_cpu == &sentinel);
+            }
+        }
+    }
+    puts("PASS FIFO owner restoration, exclusive BQL release/reacquisition and ordinary stop-before-work");
+}
+
+static void check_fixed_point(void)
+{
+    for (int mode = 0; mode < 3; mode++) {
+        reset(true, mode);
+        cpus[0].stop = cpus[1].stop = true;
+        enqueue(&cpus[1], 'B', false);
+        rr_crucible_sim_drain_vcpu_work();
+        assert(!strcmp(events, "BACST"));
+        assert(cpu_work_list_empty(&cpus[0]) && cpu_work_list_empty(&cpus[1]));
+        assert(callbacks == 3 && current_cpu == &sentinel && locked);
+        char trace[sizeof(events)];
+        memcpy(trace, events, sizeof(trace));
+
+        reset(true, mode);
+        cpus[0].stop = cpus[1].stop = true;
+        enqueue(&cpus[1], 'B', false);
+        old_drain_vcpu_work();
+        assert(!strcmp(trace, events));
+        assert(current_cpu == &sentinel);
+    }
+    puts("PASS later sibling enqueue reaches earlier CPU before first stop, identical Sim callback/stop trace");
+}
+
+static void check_generic_progress(void)
+{
+    reset(false, 0);
+    host_idle = true;
+    wait_action = 1;
+    rr_wait_io_event();
+    assert(waits == 1 && callbacks == 1 && kicks == 1 && idle_bridges == 1);
+    assert(cpus[0].stopped && !cpus[0].stop && !cpus[0].thread_kicked);
+    assert(!strcmp(events, "ulSK"));
+    assert(current_cpu == &sentinel && locked);
+    cpu_resume(&cpus[0]);
+    assert(!cpus[0].stopped && !cpus[0].stop && cpus[0].thread_kicked);
+    rr_crucible_sim_process_vcpu_events(&cpus[0]);
+    assert(!cpus[0].thread_kicked && kicks == 2 && idle_bridges == 2);
+
+    reset(false, ICOUNT_PRECISE);
+    host_idle = true;
+    wait_action = 2;
+    rr_wait_io_event();
+    assert(waits == 1 && callbacks == 1 && !strcmp(events, "ulC"));
+    assert(qemu_plugin_crucible_rr_control_boundary_pending());
+    assert(warps == 1 && deadlines == 1 && timers == 1);
+    /* Retained common passes must work with generic pending plugin state. */
+    cpus[0].stop = true;
+    enqueue(&cpus[0], 'D', false);
+    qemu_plugin_crucible_vmstop_state = 1;
+    rr_wait_io_event();
+    assert(cpus[0].stopped && !cpus[0].stop && callbacks == 2);
+    assert(strstr(events, "SD") && current_cpu == &sentinel);
+
+    reset(false, 0);
+    host_idle = true;
+    qemu_plugin_time_advance_pending = QEMU_PLUGIN_TIME_ADVANCE_ARMED;
+    wait_action = 2;
+    rr_wait_io_event();
+    assert(callbacks == 1 && waits == 1 && !warps && !timers);
+    assert(qemu_plugin_crucible_rr_control_boundary_pending());
+    puts("PASS bounded ordinary idle kick/pause/resume, control/stop and time-advance branch progression; retained timer effects");
+}
+
+int main(void)
+{
+    for (unsigned index = 0; index < 2; index++) {
+        cpus[index].cpu_index = index;
+        cpus[index].next = index == 0 ? &cpus[1] : NULL;
+        cpus[index].halt_cond = &halt_cond;
+        g_mutex_init(&cpus[index].work_mutex);
+        QSIMPLEQ_INIT(&cpus[index].work_list);
+    }
+
+    check_wrapper();
+    check_fixed_point();
+    check_healthy();
+    check_generic_progress();
+
+    for (unsigned index = 0; index < 2; index++) {
+        g_mutex_clear(&cpus[index].work_mutex);
+    }
+    return 0;
+}
+"""
+
+
+def extracted_parts():
+    """Return complete production definitions in dependency order."""
+    inventory = [
+        ("accel/accel-system.c", ["bool current_accel_is_sim(void)\n{"]),
+        ("system/cpus.c", ["bool cpu_work_list_empty(CPUState *cpu)\n{"]),
+        ("cpu-common.c", ["static void queue_work_on_cpu(",
+                          "void async_run_on_cpu(", "void async_safe_run_on_cpu(",
+                          "void process_queued_cpu_work("]),
+        ("system/cpus.c", ["static void qemu_cpu_stop(",
+                          "void qemu_process_cpu_events_common(",
+                          "void qemu_cpu_kick(CPUState *cpu)\n{",
+                          "void cpu_pause(", "void cpu_resume("]),
+        ("plugins/api-system.c", ["bool qemu_plugin_time_advance_is_pending(",
+                                  "bool qemu_plugin_crucible_vmstop_pending(",
+                                  "bool qemu_plugin_crucible_rr_control_boundary_pending("]),
+        (RR, ["static bool rr_crucible_sim_mode(void)\n{",
+              "static bool rr_crucible_sim_skip_second_events_pass(",
+              "static bool rr_crucible_sim_stop_or_unplug_pending(void)\n{",
+              "static bool rr_crucible_sim_vcpu_work_pending(void)\n{",
+              "static void rr_crucible_sim_process_vcpu_events(CPUState *cpu)\n{",
+              "static void rr_crucible_sim_drain_vcpu_work(void)\n{",
+              "static void rr_wait_io_event(void)\n{"]),
+    ]
+    return {(path, signature): definition((ROOT / path).read_text(), signature)
+            for path, signatures in inventory for signature in signatures}
+
+
+def mutated(body, negative):
+    """Apply a single causal mutation to production barrier bodies."""
+    if negative == "wrong-mode":
+        return body.replace("if (current_accel_is_sim()) {",
+                            "if (rr_crucible_sim_mode()) {")
+    if negative == "skipped-common":
+        return body.replace("    qemu_process_cpu_events_common(cpu);", "")
+    if negative == "missing-pre-drain" and "process_vcpu_events(" in body:
+        return body.replace("        process_queued_cpu_work(cpu);", "")
+    if negative == "missing-fixed-point" and "drain_vcpu_work(void)" in body:
+        return body.replace("} while (rr_crucible_sim_vcpu_work_pending());",
+                            "} while (false);")
+    if negative == "missing-owner-restoration" and "process_vcpu_events(" in body:
+        return body.replace("    current_cpu = saved_cpu;", "    (void)saved_cpu;")
+    return body
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    parser.add_argument("--negative-control", choices=NEGATIVES)
+    arguments = parser.parse_args()
+    output = arguments.output_dir.resolve()
+    output.mkdir(parents=True, exist_ok=True)
+    parts = extracted_parts()
+    captured = BASELINE.replace("old_process_vcpu_events",
+                                "rr_crucible_sim_process_vcpu_events").replace(
+        "old_drain_vcpu_work", "rr_crucible_sim_drain_vcpu_work")
+    for name, expected in BASELINE_HASHES.items():
+        signature = "static void " + name + (
+            "(CPUState *cpu)\n{" if name.endswith("process_vcpu_events")
+            else "(void)\n{")
+        assert hashlib.sha256(definition(captured, signature).encode()).hexdigest() == expected
+    (output / "production-extractions.json").write_text(json.dumps({
+        "sha256": {f"{path}:{signature}": hashlib.sha256(body.encode()).hexdigest()
+                   for (path, signature), body in parts.items()},
+        "baselineWrapperSha256": hashlib.sha256(BASELINE.encode()).hexdigest(),
+        "baselineCommit": BASELINE_COMMIT,
+        "baselineProductionBodyHashes": BASELINE_HASHES,
+        "providers": "CPU topology, BQL/exclusive arbitration, host wakes, halt callbacks, timers",
+        "runtime": "real GLib mutexes, QEMU queue and atomic macros; no guest/full QEMU/concurrency/latency",
+        "negativeControl": arguments.negative_control,
+    }, indent=2) + "\n")
+    wait_signature = "static void rr_wait_io_event(void)\n{"
+    old_wait = parts[(RR, wait_signature)].replace(
+        "rr_wait_io_event", "old_wait_io_event").replace(
+        "rr_crucible_sim_drain_vcpu_work", "old_drain_vcpu_work").replace(
+        "rr_crucible_sim_process_vcpu_events", "old_process_vcpu_events")
+    bodies = []
+    changes = 0
+    for (path, signature), body in parts.items():
+        if path == RR and ("process_vcpu_events" in signature or
+                           "drain_vcpu_work(void)" in signature):
+            changed = mutated(body, arguments.negative_control)
+            changes += changed != body
+            body = changed
+        bodies.append(body)
+    if arguments.negative_control:
+        assert changes > 0, "negative must mutate an extracted production body"
+    generated = output / "rr-sim-barriers.c"
+    work_item = definition((ROOT / "cpu-common.c").read_text(),
+                           "struct qemu_work_item {") + ";"
+    generated.write_text("\n\n".join([
+        "/* SPDX-License-Identifier: GPL-2.0-or-later */",
+        PRELUDE.replace("@WORK_ITEM@", work_item),
+        *bodies, BASELINE, old_wait, CHECKS,
+    ]))
+    binary = output / "rr-sim-barriers"
+    flags = shlex.split(os.environ.get("CFLAGS", ""))
+    links = shlex.split(os.environ.get("LDFLAGS", ""))
+    if not flags and not links:
+        pkg_config = shlex.split(os.environ.get("PKG_CONFIG", "pkg-config"))
+        flags = shlex.split(subprocess.check_output(
+            [*pkg_config, "--cflags", "glib-2.0"], text=True))
+        links = shlex.split(subprocess.check_output(
+            [*pkg_config, "--libs", "glib-2.0"], text=True))
+    command = [*shlex.split(os.environ.get("CC", "cc")), "-std=gnu11",
+               *flags, f"-I{ROOT / 'include'}", str(generated),
+               "-o", str(binary), *links]
+    (output / "compile-command.json").write_text(json.dumps({
+        "cwd": str(ROOT), "argv": command}, indent=2) + "\n")
+    subprocess.run(command, check=True)
+    print("Compiled production-body RR Sim barrier fixture", flush=True)
+    subprocess.run([str(binary)], cwd=output, check=True)
+
+
+if __name__ == "__main__":
+    main()
