+static bool qemu_plugin_crucible_vcpu_register_read_allowed(void)
+{
+    uint64_t owner = qemu_crucible_internal_rr_current_vcpu();
+    uint64_t serialized_owner = icount_crucible_rr_current_vcpu();
+    uint64_t cursor_position = icount_crucible_rr_cursor_position();
+    bool allowed;
+
+    /*
+     * A live exact RR callback must prove that current_cpu is the serialized
+     * owner. Any exact callback that holds the BQL has quiesced every vCPU
+     * register file, including the one-shot post-snapshot reselection boundary
+     * where the serialized owner is intentionally invalid and `current_cpu`
+     * retains the preceding vCPU. An exact completed-turn handoff is similarly
+     * quiescent: the committed cursor is zero at the next serialized owner while
+     * `current_cpu` still names the vCPU whose turn just finished. Single-threaded
+     * RR excludes concurrent execution during that synchronous callback.
+     * Terminal state capture separately stops the VM and holds the BQL. Refuse
+     * every concurrent, stale, or unowned context.
+     */
+    allowed = (qemu_plugin_crucible_single_threaded_rr() &&
+               qemu_plugin_crucible_exact_boundary_active() &&
+               ((current_cpu && owner != UINT64_MAX &&
+                 current_cpu->cpu_index == owner) ||
+                (current_cpu && owner == UINT64_MAX &&
+                 serialized_owner != UINT64_MAX &&
+                 current_cpu->cpu_index != serialized_owner &&
+                 cursor_position == 0) || bql_locked())) ||
+        (bql_locked() && !runstate_is_running());
+    if (!allowed) {
+        error_report("Crucible register capture rejected: "
+                     "single_rr=%d exact=%d bql=%d "
+                     "running=%d current_cpu=%d rr_owner=%" PRIu64
+                     " serialized_owner=%" PRIu64 " cursor=%" PRIu64,
+                     qemu_plugin_crucible_single_threaded_rr(),
+                     qemu_plugin_crucible_exact_boundary_active(),
+                     bql_locked(), runstate_is_running(),
+                     current_cpu ? current_cpu->cpu_index : -1, owner,
+                     serialized_owner, cursor_position);
+    }
+    return allowed;
+}
