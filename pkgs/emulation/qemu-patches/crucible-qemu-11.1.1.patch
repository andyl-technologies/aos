+#ifdef CONFIG_LINUX
+static bool initial_register_dependency_matches(
+    const QemuCrucibleRegisterCpuDependency *row, CPUState *cpu,
+    const QemuCrucibleCpuSourceAllocationOwner *actual, size_t instance_bytes)
+{
+    /* The caller already authenticated the real registry owner and receipt.
+     * A mapped row corroborates that loan; equal fields cannot issue one. */
+    return row->cpu == cpu && row->owner == actual &&
+        row->receipt == actual->receipt &&
+        row->generation == actual->request_serial &&
+        row->instance_bytes == instance_bytes &&
+        actual->payload_bytes == instance_bytes;
+}
