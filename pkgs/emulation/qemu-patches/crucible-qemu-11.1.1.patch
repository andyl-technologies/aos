+/*
+ * Written to the child's stderr, already routed to its branch-private
+ * diagnostics stream, so the host learns which QMP reconstruction stage
+ * failed and how far the basis got; the exit status names only the step.
+ */
+static void crucible_hot_fork_qmp_child_report(
+    const MonitorHotForkChildBasis *basis, const char *stage, int result)
+{
+    fprintf(stderr,
+            "crucible hot-fork qmp child %s failed: result %d attempted %d "
+            "disposed %d dispatcher %d iothread %d parser %d capabilities "
+            "%d input-held %d greeted %d socket(attempted %d disposed %d "
+            "attached %d input-held %d)\n",
+            stage, result, basis->attempted,
+            basis->inherited_protocol_disposed, basis->dispatcher_rebuilt,
+            basis->iothread_rebuilt, basis->parser_reset,
+            basis->capabilities_reset, basis->input_held,
+            basis->greeting_emitted, basis->socket.attempted,
+            basis->socket.inherited_disposed,
+            basis->socket.replacement_attached, basis->socket.input_held);
+}
+
+static int crucible_hot_fork_reinitialize_child_qmp(
+    int retained_fd, uint64_t socket_cookie, uint64_t template_generation,
+    uint64_t qmp_generation, uint64_t monitor_generation,
+    QemuCrucibleHotForkQmpChildStatus *status, void *opaque)
+{
+    MonitorHotForkChildBasis *basis = opaque;
+    int result;
+
+    if (!status || !basis) {
+        return -EINVAL;
+    }
+    if (!crucible_hot_fork_qmp_stage.staged ||
+        retained_fd != crucible_hot_fork_qmp_stage.fd ||
+        socket_cookie != crucible_hot_fork_qmp_stage.socket_cookie ||
+        template_generation !=
+            crucible_hot_fork_qmp_stage.template_generation ||
+        qmp_generation != crucible_hot_fork_qmp_stage.generation ||
+        monitor_generation !=
+            crucible_hot_fork_qmp_stage.monitor_generation ||
+        !monitor_hot_fork_child_basis_prepared_for(
+            basis, monitor_generation)) {
+        return -ESTALE;
+    }
+
+    result = monitor_hot_fork_reconstruct_child_protocol_held(
+        basis, retained_fd, socket_cookie);
+    if (result != 0) {
+        crucible_hot_fork_qmp_child_report(basis, "reconstruct", result);
+        return result;
+    }
+    result = monitor_hot_fork_greet_child_protocol_held(basis);
+    if (result != 0) {
+        crucible_hot_fork_qmp_child_report(basis, "greet", result);
+        return result;
+    }
+    if (!basis->attempted || !basis->inherited_protocol_disposed ||
+        !basis->dispatcher_rebuilt || !basis->iothread_rebuilt ||
+        !basis->parser_reset || !basis->capabilities_reset ||
+        !basis->input_held || !basis->greeting_emitted ||
+        basis->input_released || !basis->socket.inherited_disposed ||
+        !basis->socket.replacement_attached || !basis->socket.input_held) {
+        return -EPROTO;
+    }
+
+    *status = (QemuCrucibleHotForkQmpChildStatus) {
+        .schema_version =
+            QEMU_CRUCIBLE_HOT_FORK_QMP_CHILD_REINITIALIZER_VERSION,
+        .struct_size = sizeof(*status),
+        .template_generation = template_generation,
+        .qmp_generation = qmp_generation,
+        .monitor_generation = monitor_generation,
+        .socket_cookie = socket_cookie,
+        .retained_fd = retained_fd,
+        .flags = QEMU_CRUCIBLE_HOT_FORK_QMP_CHILD_FLAGS_COMPLETE,
+        .monitor_count = 1,
+    };
+    return 0;
+}
+
+static int crucible_hot_fork_reinitialize_child_console(
+    int retained_fd, uint64_t socket_cookie, uint64_t template_generation,
+    uint64_t console_generation,
+    QemuCrucibleHotForkConsoleChildStatus *status, void *opaque)
+{
+    QemuChrSocketHotForkChildBasis *basis = opaque;
+    int result;
+
+    /*
+     * The console chardev runs on GLib's default main context, which the
+     * basis records as NULL; the child's main thread, the continuation of
+     * the forking thread, still owns that context.  Only the staged
+     * identity and the bound objects are required here.
+     */
+    if (!status || !basis || !crucible_hot_fork_console_stage.staged ||
+        retained_fd != crucible_hot_fork_console_stage.fd ||
+        socket_cookie != crucible_hot_fork_console_stage.socket_cookie ||
+        template_generation !=
+            crucible_hot_fork_console_stage.template_generation ||
+        console_generation != crucible_hot_fork_console_stage.generation ||
+        !basis->prepared || !basis->chardev || !basis->frontend) {
+        /* Written to the child's diagnostics stream, like the QMP stages. */
+        fprintf(stderr,
+                "crucible hot-fork console child basis is stale: staged %d "
+                "fd %d/%d cookie-match %d template-generation-match %d "
+                "generation-match %d prepared %d chardev %d frontend %d\n",
+                crucible_hot_fork_console_stage.staged, retained_fd,
+                crucible_hot_fork_console_stage.fd,
+                socket_cookie == crucible_hot_fork_console_stage.socket_cookie,
+                template_generation ==
+                    crucible_hot_fork_console_stage.template_generation,
+                console_generation ==
+                    crucible_hot_fork_console_stage.generation,
+                basis ? basis->prepared : 0,
+                basis ? basis->chardev != NULL : 0,
+                basis ? basis->frontend != NULL : 0);
+        return -ESTALE;
+    }
+
+    result = qemu_chr_socket_hot_fork_reconstruct_child_held(
+        basis, retained_fd, socket_cookie);
+    if (result != 0) {
+        fprintf(stderr, "crucible hot-fork console child reconstruct "
+                "failed: result %d\n", result);
+        return result;
+    }
+    result = qemu_chr_socket_hot_fork_release_child_input(
+        basis, basis->context);
+    if (result != 0 || !basis->attempted || !basis->inherited_disposed ||
+        !basis->replacement_attached || basis->input_held) {
+        fprintf(stderr, "crucible hot-fork console child release failed: "
+                "result %d attempted %d disposed %d attached %d "
+                "input-held %d\n", result, basis->attempted,
+                basis->inherited_disposed, basis->replacement_attached,
+                basis->input_held);
+        return result != 0 ? result : -EPROTO;
+    }
+
+    *status = (QemuCrucibleHotForkConsoleChildStatus) {
+        .schema_version =
+            QEMU_CRUCIBLE_HOT_FORK_CONSOLE_CHILD_REINITIALIZER_VERSION,
+        .struct_size = sizeof(*status),
+        .template_generation = template_generation,
+        .console_generation = console_generation,
+        .socket_cookie = socket_cookie,
+        .retained_fd = retained_fd,
+        .flags = QEMU_CRUCIBLE_HOT_FORK_CONSOLE_CHILD_FLAGS_COMPLETE,
+    };
+    return 0;
+}
+
+static void crucible_hot_fork_template_schedule_block_transition(void);
+
+/*
+ * A staged child resource may be released while no fork operation is active
+ * and the template is either absent or retained at its barrier phase: a
+ * stage the last fork consumed must give way to the next child's, and an
+ * unconsumed one may be withdrawn.  The transitional phases still refuse,
+ * since the template's proofs are being computed from the stages then.
+ */
+static bool crucible_hot_fork_stage_release_allowed(const char *what,
+                                                    Error **errp)
+{
+    if (crucible_hot_fork_operation_active) {
+        error_setg(errp, "Cannot release Crucible hot-fork %s during a fork "
+                   "operation", what);
+        return false;
+    }
+    if (crucible_hot_fork_template_active &&
+        crucible_hot_fork_template_phase !=
+            CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BARRIERS_HELD) {
+        error_setg(errp, "Cannot release Crucible hot-fork %s during template "
+                   "preparation", what);
+        return false;
+    }
+    return true;
+}
+
+static bool crucible_hot_fork_resource_stage_allowed(
+    CrucibleHotForkPluginBarrierState **retained_plugin_barrier,
+    Error **errp)
+{
+    CrucibleHotForkPluginBarrierState *plugin_barrier;
+    bool allowed;
+
+    if (retained_plugin_barrier) {
+        *retained_plugin_barrier = NULL;
+    }
+    if (crucible_hot_fork_operation_active) {
+        error_setg(errp, "Crucible hot-fork resource staging is closed "
+                   "during a fork operation");
+        return false;
+    }
+    if (!crucible_hot_fork_template_active) {
+        return true;
+    }
+    if (crucible_hot_fork_template_phase !=
+        CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BARRIERS_HELD) {
+        error_setg(errp, "Crucible hot-fork resources require the retained "
+                   "template barrier phase");
+        return false;
+    }
+    if (!crucible_hot_fork_exact_paused_boundary()) {
+        error_setg(errp, "Crucible hot-fork resources require the exact "
+                   "paused/device-flush boundary");
+        return false;
+    }
+
+    plugin_barrier = crucible_hot_fork_plugin_barrier(
+        QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_QUERY, errp);
+    if (!plugin_barrier) {
+        return false;
+    }
+    allowed = plugin_barrier->quiescent;
+    if (!allowed) {
+        error_setg(errp, "Crucible hot-fork resources require a quiescent "
+                   "retained plugin barrier");
+        g_free(plugin_barrier);
+        return false;
+    }
+    if (retained_plugin_barrier) {
+        *retained_plugin_barrier = plugin_barrier;
+    } else {
+        g_free(plugin_barrier);
+    }
+    return true;
+}
+
+static uint64_t crucible_hot_fork_resource_template_generation(void)
+{
+    return crucible_hot_fork_template_active ?
+        crucible_hot_fork_template_generation : 0;
+}
+
+static bool crucible_hot_fork_private_ring_fd_name_valid(const char *name)
+{
+    size_t length;
+
+    if (!name) {
+        return false;
+    }
+    length = strlen(name);
+    if (length == 0 || length > CRUCIBLE_HOT_FORK_PRIVATE_RING_FD_NAME_MAX) {
+        return false;
+    }
+    for (size_t index = 0; index < length; index++) {
+        unsigned char byte = name[index];
+
+        if (!qemu_islower(byte) && !qemu_isdigit(byte) && byte != '-') {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool crucible_hot_fork_read_fdinfo(int fd, char *buffer,
+                                          size_t buffer_size, Error **errp)
+{
+    char path[64];
+    size_t used = 0;
+    int info_fd;
+
+    if (buffer_size < 2) {
+        error_setg(errp, "Crucible hot-fork fdinfo buffer is too small");
+        return false;
+    }
+    snprintf(path, sizeof(path), "/proc/self/fdinfo/%d", fd);
+    info_fd = open(path, O_RDONLY | O_CLOEXEC);
+    if (info_fd < 0) {
+        error_setg_errno(errp, errno,
+                         "Could not open Crucible hot-fork fdinfo");
+        return false;
+    }
+    while (used < buffer_size - 1) {
+        ssize_t length = read(info_fd, buffer + used,
+                              buffer_size - 1 - used);
+
+        if (length > 0) {
+            used += length;
+            continue;
+        }
+        if (length == 0) {
+            break;
+        }
+        if (errno == EINTR) {
+            continue;
+        }
+        error_setg_errno(errp, errno,
+                         "Could not read Crucible hot-fork fdinfo");
+        close(info_fd);
+        return false;
+    }
+    if (used == buffer_size - 1) {
+        char extra;
+        ssize_t length;
+
+        do {
+            length = read(info_fd, &extra, 1);
+        } while (length < 0 && errno == EINTR);
+        if (length != 0) {
+            if (length < 0) {
+                error_setg_errno(errp, errno,
+                                 "Could not finish Crucible hot-fork fdinfo");
+            } else {
+                error_setg(errp, "Crucible hot-fork fdinfo exceeds its bound");
+            }
+            close(info_fd);
+            return false;
+        }
+    }
+    close(info_fd);
+    buffer[used] = '\0';
+    return true;
+}
+
+static bool crucible_hot_fork_eventfd_id(int fd, uint64_t *eventfd_id,
+                                         Error **errp)
+{
+    char buffer[4096];
+    char *cursor;
+    bool found = false;
+
+    if (!crucible_hot_fork_read_fdinfo(fd, buffer, sizeof(buffer), errp)) {
+        return false;
+    }
+    cursor = buffer;
+    while (*cursor != '\0') {
+        char *line_end = strchr(cursor, '\n');
+        size_t line_length = line_end ? (size_t)(line_end - cursor) :
+                                        strlen(cursor);
+        static const char prefix[] = "eventfd-id:";
+
+        if (line_length >= sizeof(prefix) - 1 &&
+            memcmp(cursor, prefix, sizeof(prefix) - 1) == 0) {
+            char value[64];
+            const char *value_start = cursor + sizeof(prefix) - 1;
+            size_t value_length = line_length - (sizeof(prefix) - 1);
+            const char *end = NULL;
+            uint64_t parsed;
+
+            while (value_length > 0 && qemu_isspace(*value_start)) {
+                value_start++;
+                value_length--;
+            }
+            if (found || value_length == 0 || value_length >= sizeof(value)) {
+                error_setg(errp, "Invalid Crucible hot-fork eventfd identity");
+                return false;
+            }
+            memcpy(value, value_start, value_length);
+            value[value_length] = '\0';
+            if (qemu_strtou64(value, &end, 10, &parsed) < 0 ||
+                !end || *end != '\0' || parsed == 0) {
+                error_setg(errp, "Invalid Crucible hot-fork eventfd identity");
+                return false;
+            }
+            *eventfd_id = parsed;
+            found = true;
+        }
+        if (!line_end) {
+            break;
+        }
+        cursor = line_end + 1;
+    }
+    if (!found) {
+        error_setg(errp, "Crucible hot-fork wake descriptor is not an eventfd");
+    }
+    return found;
+}
+
+static bool crucible_hot_fork_cgroup_directory_identity(
+    int fd, uint64_t *device, uint64_t *inode, Error **errp)
+{
+#ifdef CONFIG_LINUX
+    struct stat status;
+    struct statfs filesystem;
+
+    if (fstat(fd, &status) < 0 || fstatfs(fd, &filesystem) < 0) {
+        error_setg_errno(errp, errno,
+                         "Could not inspect Crucible hot-fork cgroup");
+        return false;
+    }
+    if (!S_ISDIR(status.st_mode) ||
+        filesystem.f_type != CGROUP2_SUPER_MAGIC ||
+        status.st_dev == 0 || status.st_ino == 0) {
+        error_setg(errp, "Crucible hot-fork process contract requires one "
+                   "cgroup-v2 directory");
+        return false;
+    }
+    *device = status.st_dev;
+    *inode = status.st_ino;
+    return true;
+#else
+    (void)fd;
+    (void)device;
+    (void)inode;
+    error_setg(errp, "Crucible hot-fork cgroup placement requires Linux");
+    return false;
+#endif
+}
+
+/*
+ * Authenticate one writable descriptor as the cgroup.procs control file of
+ * the exact authenticated cgroup directory.
+ *
+ * The source QEMU runs under attempt credentials that need not be able to
+ * traverse the supervisor-owned cgroup directory, so the file is not looked
+ * up beneath the directory.  Both descriptors are resolved through this
+ * process's own /proc/self/fd links instead, which needs no permission on
+ * the cgroup hierarchy, and the file must sit directly beneath the directory
+ * on the same cgroup-v2 filesystem.
+ */
+static bool crucible_hot_fork_cgroup_procs_identity(
+    int procs_fd, int cgroup_fd, uint64_t *inode, Error **errp)
+{
+#ifdef CONFIG_LINUX
+    g_autofree char *procs_link = g_strdup_printf("/proc/self/fd/%d", procs_fd);
+    g_autofree char *cgroup_link =
+        g_strdup_printf("/proc/self/fd/%d", cgroup_fd);
+    g_autofree char *expected_path = NULL;
+    char procs_path[PATH_MAX];
+    char cgroup_path[PATH_MAX];
+    struct stat status;
+    struct stat directory;
+    struct statfs filesystem;
+    ssize_t procs_length;
+    ssize_t cgroup_length;
+    int flags = fcntl(procs_fd, F_GETFL);
+
+    if (flags < 0 || fstat(procs_fd, &status) < 0 ||
+        fstat(cgroup_fd, &directory) < 0 ||
+        fstatfs(procs_fd, &filesystem) < 0) {
+        error_setg_errno(errp, errno,
+                         "Could not inspect Crucible hot-fork cgroup.procs");
+        return false;
+    }
+    procs_length = readlink(procs_link, procs_path, sizeof(procs_path) - 1);
+    cgroup_length = readlink(cgroup_link, cgroup_path, sizeof(cgroup_path) - 1);
+    if (procs_length < 0 || cgroup_length < 0) {
+        error_setg_errno(errp, errno,
+                         "Could not resolve Crucible hot-fork cgroup.procs");
+        return false;
+    }
+    procs_path[procs_length] = '\0';
+    cgroup_path[cgroup_length] = '\0';
+    expected_path = g_strdup_printf("%s/cgroup.procs", cgroup_path);
+    if (!S_ISREG(status.st_mode) ||
+        filesystem.f_type != CGROUP2_SUPER_MAGIC ||
+        ((flags & O_ACCMODE) != O_WRONLY && (flags & O_ACCMODE) != O_RDWR) ||
+        status.st_dev != directory.st_dev || status.st_ino == 0 ||
+        strcmp(procs_path, expected_path) != 0) {
+        error_setg(errp, "Crucible hot-fork process contract requires the "
+                   "writable cgroup.procs of its cgroup-v2 directory");
+        return false;
+    }
+    *inode = status.st_ino;
+    return true;
+#else
+    (void)procs_fd;
+    (void)cgroup_fd;
+    (void)inode;
+    error_setg(errp, "Crucible hot-fork cgroup placement requires Linux");
+    return false;
+#endif
+}
+
+static bool crucible_hot_fork_nonblocking_eventfd_identity(
+    int fd, uint64_t *eventfd_id, Error **errp)
+{
+    int flags = fcntl(fd, F_GETFL);
+
+    if (flags < 0) {
+        error_setg_errno(errp, errno,
+                         "Could not inspect Crucible cancellation eventfd");
+        return false;
+    }
+    if (!(flags & O_NONBLOCK)) {
+        error_setg(errp, "Crucible cancellation eventfd must be nonblocking");
+        return false;
+    }
+    return crucible_hot_fork_eventfd_id(fd, eventfd_id, errp);
+}
+
+static bool crucible_hot_fork_child_process_contract_bound(void)
+{
+    CrucibleHotForkChildProcessContractStage *stage =
+        &crucible_hot_fork_child_process_contract_stage;
+    uint64_t device = 0;
+    uint64_t inode = 0;
+    uint64_t procs_inode = 0;
+    uint64_t eventfd_id = 0;
+
+    return stage->staged && !stage->consumed &&
+        stage->template_generation == crucible_hot_fork_template_generation &&
+        crucible_hot_fork_cgroup_directory_identity(
+            stage->cgroup_fd, &device, &inode, NULL) &&
+        crucible_hot_fork_cgroup_procs_identity(
+            stage->cgroup_procs_fd, stage->cgroup_fd, &procs_inode, NULL) &&
+        crucible_hot_fork_nonblocking_eventfd_identity(
+            stage->cancellation_fd, &eventfd_id, NULL) &&
+        device == stage->cgroup_device && inode == stage->cgroup_inode &&
+        procs_inode == stage->cgroup_procs_inode &&
+        eventfd_id == stage->cancellation_eventfd_id &&
+        stage->maximum_file_bytes != 0;
+}
