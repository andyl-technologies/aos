+        !qemu_in_main_thread() || !bql_locked() || qemu_in_coroutine() ||
+        monitor_cur() != &request->mon->parent_obj) {
+        return -EPERM;
+    }
+    status = qemu_crucible_qmp_borrow_observe(request->main_borrow, &observed);
+    if (status || observed.monitor != &request->mon->parent_obj) {
+        return status ? status : -ESTALE;
+    }
+    reservation = request->mon->crucible_checkpoint_reservation;
+    if (reservation) {
