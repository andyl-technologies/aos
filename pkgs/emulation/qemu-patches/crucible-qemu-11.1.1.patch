+
+static bool crucible_hot_fork_block_backend_sync_locked(BlockBackend *blk)
+{
+    const char *name = blk->name ?: "";
+    size_t name_length = strlen(name);
+    bool name_valid = name_length <= QEMU_BLOCK_BACKEND_HOT_FORK_NAME_MAX &&
+                      g_utf8_validate(name, name_length, NULL);
+    uint64_t context_id = blk->ctx->crucible_hot_fork_id;
+    bool changed =
+        blk->crucible_hot_fork_context_id != context_id ||
+        blk->crucible_hot_fork_reference_count != blk->refcnt ||
+        blk->crucible_hot_fork_permissions != blk->perm ||
+        blk->crucible_hot_fork_shared_permissions != blk->shared_perm ||
+        blk->crucible_hot_fork_named != (blk->name != NULL) ||
+        blk->crucible_hot_fork_name_valid != name_valid ||
+        blk->crucible_hot_fork_root_present != (blk->root != NULL) ||
+        blk->crucible_hot_fork_device_attached != (blk->dev != NULL) ||
+        blk->crucible_hot_fork_permissions_disabled != blk->disable_perm ||
+        blk->crucible_hot_fork_external_shared !=
+            (blk->root && blk->root->bs->drv &&
+             blk->root->bs->drv->bdrv_crucible_hot_fork_source_disposition ==
+                 BDRV_CRUCIBLE_HOT_FORK_SOURCE_EXTERNAL_SHARED) ||
+        strcmp(blk->crucible_hot_fork_name,
+               name_valid ? name : "<invalid>") != 0;
+
+    blk->crucible_hot_fork_context_id = context_id;
+    blk->crucible_hot_fork_reference_count = blk->refcnt;
+    blk->crucible_hot_fork_permissions = blk->perm;
+    blk->crucible_hot_fork_shared_permissions = blk->shared_perm;
+    blk->crucible_hot_fork_named = blk->name != NULL;
+    blk->crucible_hot_fork_name_valid = name_valid;
+    blk->crucible_hot_fork_root_present = blk->root != NULL;
+    blk->crucible_hot_fork_device_attached = blk->dev != NULL;
+    blk->crucible_hot_fork_permissions_disabled = blk->disable_perm;
+    blk->crucible_hot_fork_external_shared =
+        blk->root && blk->root->bs->drv &&
+        blk->root->bs->drv->bdrv_crucible_hot_fork_source_disposition ==
+            BDRV_CRUCIBLE_HOT_FORK_SOURCE_EXTERNAL_SHARED;
+    g_strlcpy(blk->crucible_hot_fork_name,
+              name_valid ? name : "<invalid>",
+              sizeof(blk->crucible_hot_fork_name));
+    return changed;
+}
+
+static void crucible_hot_fork_block_backend_changed(BlockBackend *blk)
+{
+    QEMU_LOCK_GUARD(&crucible_hot_fork_block_backend_lock);
+
+    if (crucible_hot_fork_block_backend_sync_locked(blk)) {
+        crucible_hot_fork_block_backend_generation++;
+    }
+}
+
+static void crucible_hot_fork_block_backend_register(BlockBackend *blk)
+{
+    QEMU_LOCK_GUARD(&crucible_hot_fork_block_backend_lock);
+
+    blk->crucible_hot_fork_id =
+        crucible_hot_fork_block_backend_next_id++;
+    assert(blk->crucible_hot_fork_id != 0);
+    crucible_hot_fork_block_backend_sync_locked(blk);
+    QTAILQ_INSERT_TAIL(&crucible_hot_fork_block_backends, blk,
+                       crucible_hot_fork_node);
+    crucible_hot_fork_block_backend_generation++;
+}
+
+static void crucible_hot_fork_block_backend_unregister(BlockBackend *blk)
+{
+    QEMU_LOCK_GUARD(&crucible_hot_fork_block_backend_lock);
+
+    QTAILQ_REMOVE(&crucible_hot_fork_block_backends, blk,
+                  crucible_hot_fork_node);
+    crucible_hot_fork_block_backend_generation++;
+}
+
+static void qemu_block_backend_hot_fork_inventory_locked(
+    QemuCrucibleNativeParkCapture *capture,
+    QemuBlockBackendHotForkInventory *inventory)
+{
+    BlockBackend *blk;
+    size_t count = 0;
+
+    *inventory = (QemuBlockBackendHotForkInventory){0};
+    inventory->generation = crucible_hot_fork_block_backend_generation;
+    QTAILQ_FOREACH(blk, &crucible_hot_fork_block_backends,
+                   crucible_hot_fork_node)
+    {
+        if (count == QEMU_BLOCK_BACKEND_HOT_FORK_INVENTORY_MAX) {
+            inventory->overflowed = true;
+            break;
+        }
+        count++;
+    }
+
+    if (capture &&
+        qemu_crucible_native_park_storage_prepare(
+            capture, QEMU_CRUCIBLE_PARK_BLOCK_ENTRIES, count,
+            sizeof(QemuBlockBackendHotForkInventoryEntry),
+            _Alignof(QemuBlockBackendHotForkInventoryEntry),
+            crucible_hot_fork_block_backend_generation, &inventory->storage)) {
+        inventory->overflowed = true;
+        return;
+    }
+    inventory->entries =
+        capture ? qemu_crucible_native_park_storage_allocate(capture, &inventory->storage)
+                : g_new0(QemuBlockBackendHotForkInventoryEntry, count);
+    if (capture && count) {
+        if (!inventory->entries) {
+            inventory->overflowed = true;
+            return;
+        }
+    }
+    inventory->entry_count = count;
+    count = 0;
+    QTAILQ_FOREACH(blk, &crucible_hot_fork_block_backends,
+                   crucible_hot_fork_node)
+    {
+        QemuBlockBackendHotForkInventoryEntry *entry;
+
+        if (count == inventory->entry_count) {
+            break;
+        }
+        entry = &inventory->entries[count++];
+        entry->backend_id = blk->crucible_hot_fork_id;
+        entry->context_id = blk->crucible_hot_fork_context_id;
+        entry->reference_count = blk->crucible_hot_fork_reference_count;
+        entry->permissions = blk->crucible_hot_fork_permissions;
+        entry->shared_permissions = blk->crucible_hot_fork_shared_permissions;
+        entry->quiesce_depth = qatomic_read(&blk->quiesce_counter);
+        entry->in_flight = qatomic_read(&blk->in_flight);
+        entry->named = blk->crucible_hot_fork_named;
+        entry->name_valid = blk->crucible_hot_fork_name_valid;
+        entry->root_present = blk->crucible_hot_fork_root_present;
+        entry->device_attached = blk->crucible_hot_fork_device_attached;
+        entry->permissions_disabled =
+            blk->crucible_hot_fork_permissions_disabled;
+        entry->external_shared = blk->crucible_hot_fork_external_shared;
+        entry->request_queuing_disabled =
+            qatomic_read(&blk->disable_request_queuing);
+        g_strlcpy(entry->name, blk->crucible_hot_fork_name,
+                  sizeof(entry->name));
+    }
+}
+
+static void crucible_hot_fork_block_snapshot_clear_locked(void)
+{
+    memset(&crucible_hot_fork_snapshot_sources, 0,
+           sizeof(crucible_hot_fork_snapshot_sources));
+    g_clear_pointer(&crucible_hot_fork_block_snapshot_roots, g_free);
+    crucible_hot_fork_block_snapshot_root_count = 0;
+    crucible_hot_fork_block_snapshot_backend_generation = 0;
+    crucible_hot_fork_block_snapshot_graph_generation = 0;
+    crucible_hot_fork_block_snapshot_owner = 0;
+    crucible_hot_fork_block_snapshot_bound = false;
+    crucible_hot_fork_block_snapshot_generation++;
+    assert(crucible_hot_fork_block_snapshot_generation != 0);
+}
+
+static bool crucible_hot_fork_content_id_valid(const char *content_id)
+{
+    size_t index;
+
+    if (strlen(content_id) !=
+        QEMU_BLOCK_BACKEND_HOT_FORK_CONTENT_ID_HEX_LENGTH) {
+        return false;
+    }
+    for (index = 0;
+         index < QEMU_BLOCK_BACKEND_HOT_FORK_CONTENT_ID_HEX_LENGTH;
+         index++) {
+        if (!g_ascii_isdigit(content_id[index]) &&
+            !(content_id[index] >= 'a' && content_id[index] <= 'f')) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool crucible_hot_fork_overlay_is_empty(
+    BlockDriverState *overlay, BlockDriverState *snapshot,
+    uint64_t *virtual_size, Error **errp)
+{
+    int64_t length = bdrv_getlength(overlay);
+    int64_t snapshot_length;
+    int64_t offset = 0;
+
+    if (length < 0) {
+        error_setg_errno(errp, -length,
+                         "cannot read Crucible hot-fork overlay length");
+        return false;
+    }
+    snapshot_length = bdrv_getlength(snapshot);
+    if (snapshot_length < 0) {
+        error_setg_errno(errp, -snapshot_length,
+                         "cannot read Crucible hot-fork snapshot length");
+        return false;
+    }
+    if (snapshot_length != length) {
+        error_setg(errp, "Crucible hot-fork overlay and snapshot lengths "
+                   "differ");
+        return false;
+    }
+    while (offset < length) {
+        int64_t bytes = length - offset;
+        int64_t pnum = 0;
+        int allocated = bdrv_is_allocated_above(
+            overlay, snapshot, false, offset, bytes, &pnum);
+
+        if (allocated < 0) {
+            error_setg_errno(errp, -allocated,
+                             "cannot inspect Crucible hot-fork overlay");
+            return false;
+        }
+        if (allocated != 0) {
+            error_setg(errp, "Crucible hot-fork overlay contains allocated "
+                       "guest data at offset %" PRId64, offset);
+            return false;
+        }
+        if (pnum <= 0 || pnum > bytes) {
+            error_setg(errp, "Crucible hot-fork overlay allocation scan "
+                       "made no bounded progress");
+            return false;
+        }
+        offset += pnum;
+    }
+    *virtual_size = length;
+    return true;
+}
+
+void qemu_block_backend_hot_fork_inventory(
+    QemuBlockBackendHotForkInventory *inventory)
+{
+    QEMU_LOCK_GUARD(&crucible_hot_fork_block_backend_lock);
+
+    qemu_block_backend_hot_fork_inventory_locked(NULL, inventory);
+}
+
+uint64_t qemu_block_backend_hot_fork_id(const BlockBackend *backend)
+{
+    GLOBAL_STATE_CODE();
+    return backend ? backend->crucible_hot_fork_id : 0;
+}
+
+void qemu_block_backend_hot_fork_inventory_destroy(
+    QemuBlockBackendHotForkInventory *inventory)
+{
+    if (inventory->storage.request) {
+        if (qemu_crucible_native_park_storage_free(&inventory->storage,
+                                                   inventory->entries)) {
+            return;
+        }
+    } else {
+        g_free(inventory->entries);
+    }
+    *inventory = (QemuBlockBackendHotForkInventory){0};
+}
+
+static bool qemu_block_backend_hot_fork_barrier_common(
+    QemuCrucibleNativeParkCapture *capture,
+    QemuBlockBackendHotForkBarrierOperation operation,
+    QemuBlockBackendHotForkBarrierInventory *inventory)
+{
+    QemuBlockBackendHotForkInventory backends;
+    BdrvGraphHotForkBarrierState graph;
+    uint64_t previous_backend_id = 0;
+    uint64_t writable_rooted_backends = 0;
+    uint64_t external_writable_rooted_backends = 0;
+    bool valid_entries = true;
+    size_t index;
+
+    *inventory = (QemuBlockBackendHotForkBarrierInventory){0};
+
+    /* Metadata credit owns report arrays only. Driver drain effects retain
+     * their existing independent parents and are not issued by this capture. */
+    if (capture && ((operation == QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_HOLD &&
+                     !crucible_hot_fork_block_barrier_held) ||
+                    (operation == QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_RELEASE &&
+                     crucible_hot_fork_block_barrier_held))) {
+        return false;
+    }
+    switch (operation) {
+    case QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_HOLD:
+        GLOBAL_STATE_CODE();
+        if (!crucible_hot_fork_block_barrier_held) {
+            if (crucible_hot_fork_block_snapshot_bound) {
+                return false;
+            }
+            if (replay_events_enabled() ||
+                qemu_get_current_aio_context() != qemu_get_aio_context()) {
+                return false;
+            }
+            if (!bdrv_graph_hot_fork_barrier(BDRV_GRAPH_HOT_FORK_BARRIER_HOLD,
+                                             &graph)) {
+                return false;
+            }
+            bdrv_drain_all_begin_nopoll();
+            QEMU_LOCK_GUARD(&crucible_hot_fork_block_backend_lock);
+
+            crucible_hot_fork_block_barrier_owner = qemu_get_thread_id();
+            crucible_hot_fork_block_barrier_held = true;
+            crucible_hot_fork_block_barrier_generation++;
+            assert(crucible_hot_fork_block_barrier_generation != 0);
+        }
+        break;
+    case QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_QUERY:
+        break;
+    case QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_RELEASE:
+        GLOBAL_STATE_CODE();
+        if (crucible_hot_fork_block_barrier_held) {
+            {
+                QEMU_LOCK_GUARD(&crucible_hot_fork_block_backend_lock);
+
+                if (crucible_hot_fork_block_snapshot_bound) {
+                    crucible_hot_fork_block_snapshot_clear_locked();
+                }
+            }
+            if (!bdrv_graph_hot_fork_barrier(
+                    BDRV_GRAPH_HOT_FORK_BARRIER_RELEASE, &graph)) {
+                return false;
+            }
+            bdrv_drain_all_end();
+            QEMU_LOCK_GUARD(&crucible_hot_fork_block_backend_lock);
+
+            crucible_hot_fork_block_barrier_held = false;
+            crucible_hot_fork_block_barrier_owner = 0;
+            crucible_hot_fork_block_barrier_generation++;
+            assert(crucible_hot_fork_block_barrier_generation != 0);
+        }
+        break;
+    default:
+        g_assert_not_reached();
+    }
+
+    QEMU_LOCK_GUARD(&crucible_hot_fork_block_backend_lock);
+    if (!bdrv_graph_hot_fork_barrier(BDRV_GRAPH_HOT_FORK_BARRIER_QUERY,
+                                     &graph)) {
+        return false;
+    }
+    qemu_block_backend_hot_fork_inventory_locked(capture, &backends);
+    inventory->generation = crucible_hot_fork_block_barrier_generation;
+    inventory->owner_thread_id = crucible_hot_fork_block_barrier_owner;
+    inventory->graph_barrier_generation = graph.generation;
+    inventory->graph_mutation_generation = graph.mutation_generation;
+    inventory->held_graph_mutation_generation = graph.held_mutation_generation;
+    inventory->graph_owner_thread_id = graph.owner_thread_id;
+    inventory->snapshot_generation =
+        crucible_hot_fork_block_snapshot_generation;
+    inventory->snapshot_backend_generation =
+        crucible_hot_fork_block_snapshot_backend_generation;
+    inventory->snapshot_graph_mutation_generation =
+        crucible_hot_fork_block_snapshot_graph_generation;
+    inventory->snapshot_owner_thread_id =
+        crucible_hot_fork_block_snapshot_owner;
+    inventory->graph_waiting_writers = graph.waiting_writers;
+    inventory->graph_held = graph.held;
+    inventory->graph_writer_active = graph.writer_active;
+    inventory->graph_stable = graph.stable;
+    inventory->snapshot_bound = crucible_hot_fork_block_snapshot_bound;
+    inventory->snapshot_sources = crucible_hot_fork_snapshot_sources;
+    inventory->snapshot_root_count =
+        crucible_hot_fork_block_snapshot_root_count;
+    if (inventory->snapshot_root_count != 0) {
+        if (capture && qemu_crucible_native_park_storage_prepare(
+                           capture, QEMU_CRUCIBLE_PARK_ROOT_COPY,
+                           inventory->snapshot_root_count,
+                           sizeof(*inventory->snapshot_roots),
+                           _Alignof(QemuBlockBackendHotForkSnapshotRoot),
+                           crucible_hot_fork_block_snapshot_generation,
+                           &inventory->snapshot_storage)) {
+            qemu_block_backend_hot_fork_inventory_destroy(&backends);
+            return false;
+        }
+        if (capture) {
+            inventory->snapshot_roots = qemu_crucible_native_park_storage_allocate(
+                capture, &inventory->snapshot_storage);
+            if (!inventory->snapshot_roots) {
+                qemu_block_backend_hot_fork_inventory_destroy(&backends);
+                return false;
+            }
+        } else {
+            inventory->snapshot_roots = g_memdup2(
+                crucible_hot_fork_block_snapshot_roots,
+                inventory->snapshot_root_count * sizeof(*inventory->snapshot_roots));
+        }
+        if (capture && inventory->snapshot_root_count) {
+            memcpy(inventory->snapshot_roots, crucible_hot_fork_block_snapshot_roots,
+                   inventory->snapshot_root_count * sizeof(*inventory->snapshot_roots));
+        }
+    }
+    inventory->held = crucible_hot_fork_block_barrier_held;
+    inventory->backend_count = backends.entry_count;
+    for (index = 0; index < backends.entry_count; index++) {
+        QemuBlockBackendHotForkInventoryEntry *entry = &backends.entries[index];
+
+        if (entry->backend_id == 0 || entry->context_id == 0 ||
+            entry->reference_count == 0 || !entry->name_valid ||
+            (index != 0 && entry->backend_id <= previous_backend_id)) {
+            valid_entries = false;
+        }
+        previous_backend_id = entry->backend_id;
+        inventory->rooted_backends += entry->root_present;
+        inventory->writable_backends +=
+            (entry->permissions & BLK_PERM_WRITE) != 0;
+        writable_rooted_backends +=
+            entry->root_present && (entry->permissions & BLK_PERM_WRITE) != 0;
+        external_writable_rooted_backends +=
+            entry->root_present && entry->external_shared &&
+            (entry->permissions & BLK_PERM_WRITE) != 0;
+        inventory->quiesced_rooted_backends +=
+            entry->root_present && entry->quiesce_depth != 0;
+        inventory->in_flight += entry->in_flight;
+    }
+    inventory->complete =
+        !backends.overflowed && valid_entries &&
+        inventory->held == inventory->graph_held &&
+        (!inventory->held ||
+         (inventory->owner_thread_id == inventory->graph_owner_thread_id &&
+          inventory->graph_stable));
+    inventory->snapshot_complete =
+        inventory->snapshot_bound && inventory->held && inventory->complete &&
+        inventory->snapshot_owner_thread_id == inventory->owner_thread_id &&
+        inventory->snapshot_backend_generation == backends.generation &&
+        inventory->snapshot_graph_mutation_generation ==
+            inventory->held_graph_mutation_generation &&
+        (inventory->snapshot_sources.frozen
+             ? (inventory->writable_backends == 0 &&
+                inventory->snapshot_root_count ==
+                    inventory->snapshot_sources.originally_writable_backends)
+             : inventory->snapshot_root_count ==
+                   writable_rooted_backends -
+                       external_writable_rooted_backends);
+    inventory->writable_rooted_backends = writable_rooted_backends;
+    inventory->quiescent =
+        inventory->held && inventory->complete && inventory->in_flight == 0 &&
+        inventory->quiesced_rooted_backends == inventory->rooted_backends;
+    qemu_block_backend_hot_fork_inventory_destroy(&backends);
+    return true;
+}
+
+
+bool qemu_block_backend_hot_fork_barrier(
+    QemuBlockBackendHotForkBarrierOperation operation,
+    QemuBlockBackendHotForkBarrierInventory *inventory)
+{
+    return qemu_block_backend_hot_fork_barrier_common(NULL, operation,
+                                                      inventory);
+}
+
+bool qemu_block_backend_hot_fork_barrier_capture(
+    QemuCrucibleNativeParkCapture *capture,
+    QemuBlockBackendHotForkBarrierOperation operation,
+    QemuBlockBackendHotForkBarrierInventory *inventory)
+{
+    return qemu_block_backend_hot_fork_barrier_common(capture, operation,
+                                                      inventory);
+}
+
+void qemu_block_backend_hot_fork_barrier_inventory_destroy(
+    QemuBlockBackendHotForkBarrierInventory *inventory)
+{
+    if (inventory->snapshot_storage.request) {
+        if (qemu_crucible_native_park_storage_free(&inventory->snapshot_storage,
+                                                   inventory->snapshot_roots)) {
+            return;
+        }
+    } else {
+        g_free(inventory->snapshot_roots);
+    }
+    *inventory = (QemuBlockBackendHotForkBarrierInventory){0};
+}
+
+int qemu_block_backend_hot_fork_census(
+    QemuBlockBackendHotForkBarrierOperation operation,
+    QemuCrucibleParkCensus *out)
+{
+    BdrvGraphHotForkBarrierState before;
+    BdrvGraphHotForkBarrierState graph;
+    BlockBackend *blk;
+    size_t count = 0;
+    size_t roots;
+    bool complete = true;
+    BdrvGraphHotForkBarrierOperation graph_operation;
+
+    GLOBAL_STATE_CODE();
+    *out = (QemuCrucibleParkCensus) { 0 };
+    if (!bdrv_graph_hot_fork_barrier(BDRV_GRAPH_HOT_FORK_BARRIER_QUERY,
+                                   &before)) {
+        return -EBUSY;
+    }
+    switch (operation) {
+    case QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_HOLD:
+        graph_operation = BDRV_GRAPH_HOT_FORK_BARRIER_HOLD;
+        break;
+    case QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_QUERY:
+        graph_operation = BDRV_GRAPH_HOT_FORK_BARRIER_QUERY;
+        break;
+    case QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_RELEASE:
+        if (before.owner_thread_id != qemu_get_thread_id() ||
+            crucible_hot_fork_block_barrier_held) {
+            return -ESTALE;
+        }
+        graph_operation = BDRV_GRAPH_HOT_FORK_BARRIER_RELEASE;
+        break;
+    default:
+        return -EINVAL;
+    }
+    if (!bdrv_graph_hot_fork_barrier(graph_operation, &graph)) {
+        return -EBUSY;
+    }
+
+    /* This closes graph-writer admission. Driver drain and overlay scanning
+     * are deliberately absent: their effects need their real parents. */
+    out->acquired = !before.held && graph.held;
+    out->held = graph.held;
+    out->owner_thread_id = graph.owner_thread_id;
+    out->barrier_generation = graph.generation;
+    out->generation[0] = graph.mutation_generation;
+    QEMU_LOCK_GUARD(&crucible_hot_fork_block_backend_lock);
+    out->generation[1] = crucible_hot_fork_block_backend_generation;
+    out->generation[2] = crucible_hot_fork_block_snapshot_generation;
+    QTAILQ_FOREACH(blk, &crucible_hot_fork_block_backends,
+                   crucible_hot_fork_node) {
+        if (count == QEMU_BLOCK_BACKEND_HOT_FORK_INVENTORY_MAX) {
+            complete = false;
+            break;
+        }
+        count++;
+    }
+    roots = crucible_hot_fork_block_snapshot_root_count;
+    complete &= qemu_crucible_park_array_request(
+        &out->arrays[0], count, sizeof(QemuBlockBackendHotForkInventoryEntry),
+        _Alignof(QemuBlockBackendHotForkInventoryEntry), NULL);
+    complete &= qemu_crucible_park_array_request(
+        &out->arrays[1], roots, sizeof(QemuBlockBackendHotForkSnapshotRoot),
+        _Alignof(QemuBlockBackendHotForkSnapshotRoot),
+        crucible_hot_fork_block_snapshot_roots);
+    complete &= qemu_crucible_park_array_request(
+        &out->arrays[2], roots, sizeof(QemuBlockBackendHotForkSnapshotRoot),
+        _Alignof(QemuBlockBackendHotForkSnapshotRoot), NULL);
+    out->complete = complete && graph.stable;
+    return 0;
+}
+
+static bool crucible_hot_fork_snapshot_bind(
+    const QemuBlockHotForkSourceSet *sources,
+    const QemuBlockBackendHotForkSnapshotBinding *bindings,
+    size_t binding_count,
+    QemuBlockBackendHotForkBarrierInventory *inventory,
+    Error **errp)
+{
+    QemuBlockBackendHotForkBarrierInventory barrier;
+    QemuBlockBackendHotForkSnapshotRoot *roots;
+    BlockBackend *blk;
+    size_t binding_index = 0;
+    uint64_t previous_backend_id = 0;
+    uint64_t backend_generation;
+    uint64_t graph_generation;
+    QemuBlockHotForkSourceSetInventory source_inventory = { 0 };
+
+    GLOBAL_STATE_CODE();
+    if (binding_count > QEMU_BLOCK_BACKEND_HOT_FORK_INVENTORY_MAX ||
+        (binding_count && !bindings)) {
+        error_setg(errp, "too many Crucible hot-fork snapshot roots");
+        return false;
+    }
+    if (!qemu_block_backend_hot_fork_barrier(
+            QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_QUERY, &barrier)) {
+        error_setg(errp, "cannot inspect Crucible hot-fork block barrier");
+        return false;
+    }
+    if (!barrier.quiescent || barrier.snapshot_bound) {
+        error_setg(errp, "Crucible hot-fork snapshot binding requires one "
+                   "unbound quiescent block barrier");
+        qemu_block_backend_hot_fork_barrier_inventory_destroy(&barrier);
+        return false;
+    }
+    graph_generation = barrier.held_graph_mutation_generation;
+    qemu_block_backend_hot_fork_barrier_inventory_destroy(&barrier);
+
+    if (sources) {
+        if (!qemu_block_hot_fork_source_set_query(
+                sources, &source_inventory, errp)) {
+            return false;
+        }
+        if (!source_inventory.frozen) {
+            error_setg(errp, "Crucible snapshot requires a complete frozen source set");
+            return false;
+        }
+    }
+
+    {
+        QEMU_LOCK_GUARD(&crucible_hot_fork_block_backend_lock);
+
+        backend_generation = crucible_hot_fork_block_backend_generation;
+    }
+
+    roots = g_new0(QemuBlockBackendHotForkSnapshotRoot, binding_count);
+    QTAILQ_FOREACH(blk, &block_backends, link) {
+        const QemuBlockBackendHotForkSnapshotBinding *binding;
+        QemuBlockBackendHotForkSnapshotRoot *root;
+        BlockDriverState *overlay;
+        BlockDriverState *snapshot;
+        uint64_t original_permissions = blk->perm;
+        bool external_shared;
+
+        if (sources && !qemu_block_hot_fork_source_set_backend_permissions(
+                sources, blk, &original_permissions, errp)) {
+            goto fail;
+        }
+        {
+            GRAPH_RDLOCK_GUARD_MAINLOOP();
+            overlay = blk_bs(blk);
+            external_shared = overlay && overlay->drv &&
+                overlay->drv->bdrv_crucible_hot_fork_source_disposition ==
+                    BDRV_CRUCIBLE_HOT_FORK_SOURCE_EXTERNAL_SHARED;
+        }
+        if (!blk->root || !(original_permissions & BLK_PERM_WRITE) ||
+            external_shared) {
+            continue;
+        }
+        if (binding_index == binding_count) {
+            error_setg(errp, "missing Crucible hot-fork snapshot root for "
+                       "writable backend");
+            goto fail;
+        }
+        binding = &bindings[binding_index];
+        root = &roots[binding_index];
+        if (binding->backend_id == 0 ||
+            binding->backend_id <= previous_backend_id ||
+            binding->backend_id != blk->crucible_hot_fork_id ||
+            strcmp(binding->backend_name, blk->name ?: "") != 0 ||
+            !id_wellformed(binding->backend_name) ||
+            !id_wellformed(binding->overlay_node_name) ||
+            !id_wellformed(binding->snapshot_node_name) ||
+            !crucible_hot_fork_content_id_valid(
+                binding->snapshot_content_id)) {
+            error_setg(errp, "invalid or out-of-order Crucible hot-fork "
+                       "snapshot binding");
+            goto fail;
+        }
+
+        GRAPH_RDLOCK_GUARD_MAINLOOP();
+        overlay = blk_bs(blk);
+        snapshot = overlay ? bdrv_cow_bs(overlay) : NULL;
+        if (!overlay || !snapshot ||
+            strcmp(bdrv_get_node_name(overlay),
+                   binding->overlay_node_name) != 0 ||
+            strcmp(bdrv_get_node_name(snapshot),
+                   binding->snapshot_node_name) != 0 ||
+            (sources ? !bdrv_is_read_only(overlay) : !bdrv_is_writable(overlay)) ||
+            !bdrv_is_read_only(snapshot)) {
+            error_setg(errp, "Crucible hot-fork snapshot graph did not match "
+                       "the requested writable-overlay/read-only-root basis");
+            goto fail;
+        }
+        if (!crucible_hot_fork_overlay_is_empty(
+                overlay, snapshot, &root->virtual_size, errp)) {
+            goto fail;
+        }
+
+        root->binding = *binding;
+        root->overlay_empty = true;
+        root->snapshot_read_only = true;
+        previous_backend_id = binding->backend_id;
+        binding_index++;
+    }
+    if (binding_index != binding_count ||
+        (sources && binding_count != source_inventory.originally_writable_backends)) {
+        error_setg(errp, "extra Crucible hot-fork snapshot root binding");
+        goto fail;
+    }
+
+    {
+        QEMU_LOCK_GUARD(&crucible_hot_fork_block_backend_lock);
+
+        if (!crucible_hot_fork_block_barrier_held ||
+            crucible_hot_fork_block_snapshot_bound ||
+            backend_generation !=
+                crucible_hot_fork_block_backend_generation) {
+            error_setg(errp, "Crucible hot-fork block barrier changed during "
+                       "snapshot binding");
+            goto fail;
+        }
+        crucible_hot_fork_block_snapshot_generation++;
+        assert(crucible_hot_fork_block_snapshot_generation != 0);
+        crucible_hot_fork_block_snapshot_backend_generation =
+            backend_generation;
+        crucible_hot_fork_block_snapshot_graph_generation = graph_generation;
+        crucible_hot_fork_block_snapshot_owner =
+            crucible_hot_fork_block_barrier_owner;
+        crucible_hot_fork_block_snapshot_bound = true;
+        crucible_hot_fork_block_snapshot_root_count = binding_count;
+        crucible_hot_fork_block_snapshot_roots = roots;
+        crucible_hot_fork_snapshot_sources = source_inventory;
+    }
+
+    return qemu_block_backend_hot_fork_barrier(
+        QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_QUERY, inventory);
+
+fail:
+    g_free(roots);
+    return false;
+}
+
+bool qemu_block_backend_hot_fork_snapshot_bind(
+    const QemuBlockBackendHotForkSnapshotBinding *bindings, size_t count,
+    QemuBlockBackendHotForkBarrierInventory *inventory, Error **errp)
+{
+    return crucible_hot_fork_snapshot_bind(NULL, bindings, count, inventory, errp);
+}
+
+bool qemu_block_backend_hot_fork_snapshot_bind_frozen(
+    const QemuBlockHotForkSourceSet *sources,
+    const QemuBlockBackendHotForkSnapshotBinding *bindings, size_t count,
+    QemuBlockBackendHotForkBarrierInventory *inventory, Error **errp)
+{
+    if (!sources) {
+        error_setg(errp, "Crucible frozen snapshot requires a source-set capability");
+        return false;
+    }
+    return crucible_hot_fork_snapshot_bind(sources, bindings, count, inventory, errp);
+}
