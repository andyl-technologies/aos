+static bool test_bytes_nonzero(const uint8_t *bytes, size_t length)
+{
+    for (size_t i = 0; i < length; i++) {
+        if (bytes[i] != 0) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static void test_sha256(const uint8_t *bytes, size_t length,
+                        uint8_t output[32])
+{
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    gsize output_len = 32;
+
+    g_checksum_update(checksum, bytes, length);
+    g_checksum_get_digest(checksum, output, &output_len);
+    if (output_len != 32) {
+        test_fail("SHA-256 evidence framing failed");
+    }
+}
