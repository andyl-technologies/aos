+static int module_claim(QemuCrucibleModuleRequestPayload **holder, uint64_t *serial,
+                        void *userdata)
+{
+    g_assert_true(userdata == &actual_child);
+    claim_calls++;
+    if (callback_reentry) {
+        callback_transition_checks();
+    }
+    qemu_mutex_lock(&actual_child.journal);
+    g_assert_true(actual_child.owned);
+    g_assert_null(actual_child.holder);
+    g_assert_null(*holder);
+    g_assert_cmpuint(*serial, ==, 0);
+    if (!empty_claim) {
+        actual_child.holder = holder;
+        actual_child.serial++;
