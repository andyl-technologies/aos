+        return false;
+    }
+
+    return true;
+}
+
+void msix_fingerprint_put(QEMUFile *f, const PCIDevice *dev)
+{
+    unsigned int entries;
+    size_t pba_bytes;
+
+    if (!msix_present((PCIDevice *)dev)) {
+        qemu_put_byte(f, 0);
+        return;
+    }
+
+    entries = dev->msix_entries_nr;
+    qemu_put_byte(f, 1);
+    qemu_put_be32(f, entries);
+    qemu_put_buffer(f, dev->msix_table, entries * PCI_MSIX_ENTRY_SIZE);
+
+    pba_bytes = DIV_ROUND_UP(entries, 8);
+    for (size_t index = 0; index < pba_bytes; index++) {
+        uint8_t value = dev->msix_pba[index];
+
+        if (index + 1 == pba_bytes && entries % 8 != 0) {
+            value &= (1U << (entries % 8)) - 1;
+        }
+        qemu_put_byte(f, value);
+    }
+}
