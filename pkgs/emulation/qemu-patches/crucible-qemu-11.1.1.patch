+int qemu_plugin_crucible_ram_control_dispatch_end_v1(
+    qemu_plugin_id_t id, qemu_plugin_crucible_ram_control_actor_v1 *actor)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleRamControlReceive *receipt;
+    int status = qemu_crucible_ram_control_actor_current(actor, id);
+    int post;
+
+    if (status) {
+        return status;
+    }
+    status = pthread_mutex_trylock(&actor->dispatch_mutex);
+    if (status) {
+        return status == EBUSY ? -EAGAIN : -status;
+    }
+    receipt = &actor->receipt;
+    if (!actor->quiesce_requested) {
+        status = -EAGAIN;
+    } else if (actor->first_status || actor->post_status || receipt->uncertain) {
+        status = -ESTALE;
+    } else if (actor->record_in_flight || receipt->frame_bytes ||
+               receipt->frame_extent || receipt->alias_count || receipt->moved ||
+               receipt->record.held || receipt->record.callback_active ||
+               actor->pause.requested || actor->pause.held ||
+               actor->request_pause.requested || actor->request_pause.held) {
+        status = -EAGAIN;
+    } else {
+        /* This is actual terminal disposal of the prepaid empty receive bank.
+         * The closed admission gate and same mutex exclude a first-byte race.
+         * No negative record disposal, fd mutation, alias close or cursor reset
+         * can turn a partial or moved record into this healthy terminal cut. */
+        receipt->active = false;
+        qatomic_store_release(&actor->dispatch_ended, true);
+        status = 0;
+    }
+    post = qemu_crucible_ram_control_actor_contract_current(actor);
+    if (post) {
+        receipt->uncertain = true;
+        ram_control_failure(actor, post, true);
+        status = status ? status : post;
+    }
+    {
+        int unlock = pthread_mutex_unlock(&actor->dispatch_mutex);
+
+        if (unlock) {
+            ram_control_failure(actor, -unlock, true);
+            status = status ? status : -unlock;
+        }
+    }
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
