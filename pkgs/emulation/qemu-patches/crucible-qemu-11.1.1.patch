+bool qemu_plugin_crucible_native_block_io_descriptor_observe_v1(
+    size_t member, QemuCrucibleNativeGroupDescriptorView *out)
+{
+    if (!out) {
+        return false;
+    }
+
+    switch (member) {
+    case 0:
+        *out = (QemuCrucibleNativeGroupDescriptorView) {
+            .coordinate = &crucible_blk_submit_cb,
