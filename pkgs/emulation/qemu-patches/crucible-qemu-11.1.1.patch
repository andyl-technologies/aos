+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Exercise queue and instruction-completion production bodies.
+
+Real GLib mutexes, queues and QEMU atomics execute submit, cancel, dispatch,
+VMState save/replacement and coordinate queries. Architecture snapshots and
+instruction evidence are bounded providers; no translated guest executes here.
+"""
+
+import argparse
+import json
+import os
+from pathlib import Path
+import runpy
+import shlex
+import subprocess
+
+
+ROOT = Path(__file__).resolve().parents[2]
+definition = runpy.run_path(str(Path(__file__).with_name(
+    "test-crucible-net-output-stop.py")))["definition"]
+
+PRELUDE = r"""
+#include "qemu/osdep.h"
