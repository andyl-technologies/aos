+int qemu_plugin_crucible_native_group_effect_begin_v1(
+    QemuCrucibleNativeGroupRegistrar *registrar)
+{
+    QemuCrucibleNativeRegistrationGroup *group = registrar->group;
+    QemuCrucibleNativeInvocationRegistry *registry;
+    int status;
+
+    if (registrar->ordinary) {
+        return 0;
+    }
+    if (!group || registrar->first_status) {
+        return registrar->first_status ? registrar->first_status : -ENOKEY;
+    }
+    if (!registry_process_current(group->registry, getpid())) {
+        registrar->first_status = -ESTALE;
+        return registrar->first_status;
+    }
+#ifndef CONFIG_USER_ONLY
+    status = qemu_crucible_startup_source_callback_group_current_v1(
+        registrar->borrow, registrar->serial, registrar->kind);
+    if (status) {
+        registrar->first_status = status;
+        return status;
+    }
+#endif
+    registry = group->registry;
+    qemu_rec_mutex_lock(&plugin.lock);
+    qemu_mutex_lock(&registry->mutex);
+    status = 0;
+    if (!group_identity_locked(registry, group) || group->first_status ||
+        group->effect_started || group->terminal || !group->module_retained ||
+        registry->revoked || group->borrow != registrar->borrow ||
+        group->registrar_serial != registrar->serial ||
+        plugin_id_to_ctx_locked(group->ctx->id) != group->ctx ||
+        group->ctx->handle != group->module || group->ctx->resetting ||
+        group->ctx->uninstalling || !group->ctx->installing) {
+        status = -ESTALE;
+    } else {
+        group->effect_started = true;
+        registrar->effect_locked = true;
+    }
+    group_record_failure_locked(group, status);
+    qemu_mutex_unlock(&registry->mutex);
+    if (status) {
+        qemu_rec_mutex_unlock(&plugin.lock);
+    }
+    registrar->first_status = status;
+    return status;
+}
+
+void qemu_plugin_crucible_native_group_member_attempt_v1(
+    QemuCrucibleNativeGroupRegistrar *registrar, size_t member)
+{
+    QemuCrucibleNativeRegistrationGroup *group = registrar->group;
+
+    if (registrar->ordinary || !group) {
+        return;
+    }
+    assert(registrar->effect_locked);
+    qemu_mutex_lock(&group->registry->mutex);
+    if (member >= group->member_count || (group->attempted_mask & (1U << member))) {
+        group_record_failure_locked(group, -ESTALE);
+    } else {
+        /* Journal before any userdata/function/publication write. If its
+         * following observation never runs, this exact potential descriptor
+         * remains owed until a genuine owning withdrawal observes it gone. */
+        group->attempted_mask |= 1U << member;
+        group->members[member].descriptor_retained = true;
+    }
+    qemu_mutex_unlock(&group->registry->mutex);
+}
+
+void qemu_plugin_crucible_native_group_member_installed_v1(
+    QemuCrucibleNativeGroupRegistrar *registrar, size_t member,
+    const QemuCrucibleNativeGroupDescriptorView *actual)
+{
+    QemuCrucibleNativeRegistrationGroup *group = registrar->group;
+    QemuCrucibleNativeRegistration *record;
+
+    if (registrar->ordinary || !group) {
+        return;
+    }
+    assert(registrar->effect_locked);
+    qemu_mutex_lock(&group->registry->mutex);
+    if (!actual || member >= group->member_count) {
+        group_record_failure_locked(group, -EINVAL);
+    } else {
+        record = &group->members[member];
+        /* Retain actual effects before testing the expected role. Partial or
+         * mismatched installation cannot erase a real descriptor obligation. */
+        if (!(group->attempted_mask & (1U << member))) {
+            group_record_failure_locked(group, -ESTALE);
+        }
+        if (!(group->installed_mask & (1U << member))) {
+            group->installed_members++;
+            group->installed_mask |= 1U << member;
+        }
+        record->descriptor_retained = true;
+        if (record->coordinate != actual->coordinate ||
+            record->function != actual->function ||
+            record->userdata != actual->userdata ||
+            record->userdata_coordinate != actual->userdata_coordinate ||
+            record->kind != actual->kind) {
+            record->coordinate = actual->coordinate;
+            record->function = actual->function;
+            record->userdata = actual->userdata;
+            record->userdata_coordinate = actual->userdata_coordinate;
+            record->kind = actual->kind;
+            group_record_failure_locked(group, -ESTALE);
+        }
+    }
+    qemu_mutex_unlock(&group->registry->mutex);
+}
+
+void qemu_plugin_crucible_native_group_effect_end_v1(
+    QemuCrucibleNativeGroupRegistrar *registrar)
+{
+    if (!registrar->effect_locked) {
+        return;
+    }
+    qemu_mutex_lock(&registrar->group->registry->mutex);
+    registrar->group->effect_finished = true;
+    qemu_mutex_unlock(&registrar->group->registry->mutex);
+    registrar->effect_locked = false;
+    qemu_rec_mutex_unlock(&plugin.lock);
+}
+
+int qemu_plugin_crucible_native_group_finish_v1(
+    QemuCrucibleNativeGroupRegistrar *registrar)
+{
+#ifndef CONFIG_USER_ONLY
+    QemuCrucibleNativeRegistrationGroup *group = registrar->group;
+    QemuCrucibleCallbackRegistrationGroupBorrow *borrow = registrar->borrow;
+    int post = 0;
+    int returned;
+    size_t i;
+
+    assert(!registrar->effect_locked);
+    if (!borrow) {
+        return registrar->first_status;
+    }
+    if (group && group->effect_started) {
+        post = qemu_crucible_startup_source_callback_group_current_v1(
+            borrow, registrar->serial, registrar->kind);
+    }
+    returned = qemu_crucible_startup_source_callback_group_return_v1(
+        &registrar->borrow, registrar->serial, registrar->kind);
+    if (!group) {
+        return registrar->first_status ? registrar->first_status : returned;
+    }
+    qemu_mutex_lock(&group->registry->mutex);
+    group_record_failure_locked(group, registrar->first_status);
+    group->post_status = post;
+    group->return_status = returned;
+    if (!returned) {
+        group->borrow = NULL;
+    }
+    if (!group->effect_started) {
+        group_record_failure_locked(group, -ECANCELED);
+    } else if (!group->effect_finished ||
+               group->installed_members != group->member_count ||
+               group->attempted_mask != (1U << group->member_count) - 1 ||
+               group->installed_mask != group->attempted_mask) {
+        group_record_failure_locked(group, -EIO);
+    }
+    group->complete = group->effect_finished && !group->first_status && !post &&
+        !returned && group->installed_members == group->member_count &&
+        group->attempted_mask == (1U << group->member_count) - 1 &&
+        group->installed_mask == group->attempted_mask;
+    for (i = 0; i < group->member_count; i++) {
+        group->members[i].source_authenticated = group->complete;
+        /* Complete installation is factual physical custody. Source still
+         * owns future activation and CPU borrower qualification. */
+        group->members[i].active = false;
+    }
+    int status = group->first_status ? group->first_status : post ? post : returned;
+    qemu_mutex_unlock(&group->registry->mutex);
+    return status;
+#else
+    return registrar->first_status;
+#endif
+}
+
+QemuCrucibleNativeRegistration *qemu_plugin_crucible_native_group_member_v1(
+    QemuCrucibleNativeGroupRegistrar *registrar, size_t member)
+{
+    if (!registrar->effect_locked || !registrar->group ||
+        member >= registrar->group->member_count) {
+        return NULL;
+    }
+    return &registrar->group->members[member];
+}
+
+static int group_receipt_identity(
+    QemuCrucibleNativeInvocationRegistry *registry,
+    QemuCrucibleCallbackRegistrationGroupOwner *owner,
+    QemuCrucibleNativeRegistrationGroupKind kind, uint64_t publication_serial)
+{
+#ifndef CONFIG_USER_ONLY
+    if (!registry_process_current(registry, getpid()) ||
+        !qemu_plugin_crucible_native_group_member_count_v1(kind)) {
+        return -EPERM;
+    }
+    return qemu_crucible_startup_source_callback_group_owner_identity_v1(
+        owner, kind, publication_serial);
+#else
+    (void)registry;
+    (void)owner;
+    (void)kind;
+    (void)publication_serial;
+    return -ENOTSUP;
+#endif
+}
+
+static bool group_output_overlaps(const void *output, size_t bytes,
+                                  const void *object, size_t extent)
+{
+    uintptr_t start = (uintptr_t)output;
+    uintptr_t base = (uintptr_t)object;
+
+    if (bytes > UINTPTR_MAX - start || extent > UINTPTR_MAX - base) {
+        return true;
+    }
+    return start < base + extent && base < start + bytes;
+}
+
+static bool group_receipt_output_conflicts_locked(
+    QemuCrucibleNativeInvocationRegistry *registry,
+    QemuCrucibleNativeGroupReceipt *out)
+{
+    size_t i;
+
+    if (group_output_overlaps(out, sizeof(*out), registry, sizeof(*registry))) {
+        return true;
+    }
+    for (i = 0; i < ARRAY_SIZE(registry->groups); i++) {
+        QemuCrucibleNativeRegistrationGroup *group = registry->groups[i];
+
+        if (!group) {
+            continue;
+        }
+        if (group_output_overlaps(out, sizeof(*out), group, sizeof(*group)) ||
+            group_output_overlaps(out, sizeof(*out), group->members,
+                                  group->member_count * sizeof(*group->members)) ||
+            (group->callback && group_output_overlaps(
+                out, sizeof(*out), group->callback, sizeof(*group->callback)))) {
+            return true;
+        }
+#ifndef CONFIG_USER_ONLY
+        if (group_output_overlaps(out, sizeof(*out), group->owner,
+                                  sizeof(*group->owner)) ||
+            (group->borrow && group_output_overlaps(
+                out, sizeof(*out), group->borrow, sizeof(*group->borrow)))) {
+            return true;
+        }
+#endif
+    }
+    return false;
+}
+
+int qemu_plugin_crucible_native_group_receipt_observe_v1(
+    QemuCrucibleNativeInvocationRegistry *registry,
+    QemuCrucibleCallbackRegistrationGroupOwner *owner,
+    QemuCrucibleNativeRegistrationGroupKind kind, uint64_t publication_serial,
+    QemuCrucibleNativeGroupReceipt *out)
+{
+    QemuCrucibleNativeRegistrationGroup *group;
+    int status = group_receipt_identity(registry, owner, kind, publication_serial);
+
+    if (status || !out) {
+        return status ? status : -EINVAL;
+    }
+    qemu_mutex_lock(&registry->mutex);
+    group = registry->groups[group_index(kind)];
+    if (group_receipt_output_conflicts_locked(registry, out)) {
+        status = -EINVAL;
+    } else if (!group_identity_locked(registry, group) || group->owner != owner ||
+        group->publication_serial != publication_serial) {
+        status = -ESTALE;
+    } else {
+        *out = (QemuCrucibleNativeGroupReceipt) {
+            .publication_serial = group->publication_serial,
+            .registrar_serial = group->registrar_serial,
+            .member_count = group->member_count,
+            .installed_members = group->installed_members,
+            .attempted_mask = group->attempted_mask,
+            .installed_mask = group->installed_mask,
+            .first_status = group->first_status,
+            .post_status = group->post_status,
+            .return_status = group->return_status,
+            .first_invocation_status = group->first_invocation_status,
+            .reserved = group->reserved,
+            .effect_started = group->effect_started,
+            .effect_finished = group->effect_finished,
+            .complete = group->complete,
+            .module_retained = group->module_retained,
+            .borrow_retained = group->borrow != NULL,
+            .terminal = group->terminal,
+        };
+    }
+    qemu_mutex_unlock(&registry->mutex);
+    return status;
+}
+
+static bool group_descriptor_current_locked(QemuCrucibleNativeRegistration *record)
+{
+    void *function;
+    void *userdata;
+
+    if (!record->coordinate || !record->userdata_coordinate) {
+        return false;
+    }
+    /* Coordinates are the actual QEMU-owned typed slots saved by the real
+     * registrar, not a projection supplied to this current/terminal call.
+     * QEMU's callback ABI already converts these function values to void *;
+     * memcpy reads their representation without an incompatible lvalue. */
+    memcpy(&function, record->coordinate, sizeof(function));
+    memcpy(&userdata, record->userdata_coordinate, sizeof(userdata));
+    return function == record->function && userdata == record->userdata;
+}
+
+static bool group_descriptor_absent_locked(QemuCrucibleNativeRegistration *record)
+{
+    void *function;
+
+    if (!record->coordinate) {
+        return false;
+    }
+    memcpy(&function, record->coordinate, sizeof(function));
+    return !function;
+}
+
+int qemu_plugin_crucible_native_group_installed_current_v1(
+    QemuCrucibleNativeInvocationRegistry *registry,
+    QemuCrucibleCallbackRegistrationGroupOwner *owner,
+    QemuCrucibleNativeRegistrationGroupKind kind, uint64_t publication_serial)
+{
+    QemuCrucibleNativeRegistrationGroup *group;
+    int status = group_receipt_identity(registry, owner, kind, publication_serial);
+    size_t i;
+
+    if (status) {
+        return status;
+    }
+    qemu_rec_mutex_lock(&plugin.lock);
+    qemu_mutex_lock(&registry->mutex);
+    group = registry->groups[group_index(kind)];
+    if (!group_identity_locked(registry, group) || group->owner != owner ||
+        group->publication_serial != publication_serial || group->borrow ||
+        group->terminal || !group->module_retained || !group->complete ||
+        group->first_status || group->post_status || group->return_status ||
+        (group->callback && !plugin_vcpu_init_descriptor_current__locked(
+            group->callback, group->ctx))) {
+        status = -ENOKEY;
+    } else {
+        for (i = 0; i < group->member_count; i++) {
+            QemuCrucibleNativeRegistration *record = &group->members[i];
+
+            if (record->group != group || record->owner != registry ||
+                record->child_owner != group->child_owner ||
+                record->publication_serial != publication_serial ||
+                record->registrar_serial != group->registrar_serial ||
+                !record->coordinate || !record->function || !record->serial ||
+                !record->descriptor_retained || !record->source_authenticated ||
+                !group_descriptor_current_locked(record)) {
+                status = -ESTALE;
+                break;
+            }
+        }
+    }
+    qemu_mutex_unlock(&registry->mutex);
+    qemu_rec_mutex_unlock(&plugin.lock);
+    return status;
+}
+
+int qemu_plugin_crucible_native_group_terminal_v1(
+    QemuCrucibleNativeInvocationRegistry *registry,
+    QemuCrucibleCallbackRegistrationGroupOwner *owner,
+    QemuCrucibleNativeRegistrationGroupKind kind, uint64_t publication_serial)
+{
+    QemuCrucibleNativeRegistrationGroup *group;
+    struct qemu_plugin_ctx *release = NULL;
+    int status = group_receipt_identity(registry, owner, kind, publication_serial);
+    size_t i;
+
+    if (status) {
+        return status;
+    }
+    qemu_rec_mutex_lock(&plugin.lock);
+    qemu_mutex_lock(&registry->mutex);
+    group = registry->groups[group_index(kind)];
+    if (!group_identity_locked(registry, group) || group->owner != owner ||
+        group->publication_serial != publication_serial) {
+        status = -ESTALE;
+    } else if (group->borrow || (group->effect_started && !group->effect_finished) ||
+               (group->callback && !plugin_vcpu_init_descriptor_terminal__locked(
+                   group->callback, group->ctx))) {
+        status = -EBUSY;
+    } else {
+        for (i = 0; i < group->member_count; i++) {
+            QemuCrucibleNativeRegistration *record = &group->members[i];
+
+            if (record->group != group || record->owner != registry ||
+                record->descriptor_retained || record->active || record->references ||
+                ((group->attempted_mask & (1U << i)) &&
+                 !group_descriptor_absent_locked(record))) {
+                status = -EBUSY;
+                break;
+            }
+        }
+        if (!status) {
+            group->terminal = true;
+            group->complete = false;
+            if (group->module_retained) {
+                release = group->ctx;
+                group->module_retained = false;
+            }
+        }
+    }
+    qemu_mutex_unlock(&registry->mutex);
+    qemu_rec_mutex_unlock(&plugin.lock);
+    /* A real last-user return may schedule retirement. No Source/native or
+     * plugin lock remains held and no historical flush stands in for it. */
+    if (release) {
+        plugin_ctx_callback_release(release);
+    }
+    return status;
+}
+
+QemuCrucibleNativeGroupUse qemu_plugin_crucible_native_group_use_begin_v1(
+    QemuCrucibleNativeRegistration *const *slot,
+    QemuCrucibleNativeGroupDescriptorObserver observe, size_t member,
+    QemuCrucibleNativeGroupDescriptorView *actual)
+{
+    QemuCrucibleNativeGroupUse use = { 0 };
+    QemuCrucibleNativeRegistration *record;
+    QemuCrucibleNativeRegistrationGroup *group;
+    QemuCrucibleNativeInvocationRegistry *registry;
+    pid_t process;
+
+    *actual = (QemuCrucibleNativeGroupDescriptorView) { 0 };
+    record = qatomic_load_acquire(slot);
+    if (!record) {
+        observe(member, actual);
+        /* Installation publishes its retained association before function
+         * fields. A publication racing this ordinary read must use the real
+         * protected snapshot rather than execute from an unpinned tuple. */
+        record = qatomic_load_acquire(slot);
+    }
+    if (record) {
+        process = getpid();
+        /* The permanent association may be inherited with locked mutexes.
+         * Authenticate its immutable process before either lock or effect. */
+        if (!registry_process_current(record->owner, process)) {
+            actual->function = NULL;
+            goto mask;
+        }
+        qemu_rec_mutex_lock(&plugin.lock);
+        record = qatomic_load_acquire(slot);
+        observe(member, actual);
+        if (record && !registry_process_current(record->owner, process)) {
+            /* Revalidate the actual association reread under plugin.lock. */
+            actual->function = NULL;
+        } else if (record) {
+            registry = record->owner;
+            group = record->group;
+            qemu_mutex_lock(&registry->mutex);
+            if (group_identity_locked(registry, group) && !group->terminal &&
+                member < group->member_count && &group->members[member] == record &&
+                group->module_retained && record->descriptor_retained &&
+                record->coordinate == actual->coordinate &&
+                record->function == actual->function &&
+                record->userdata == actual->userdata &&
+                record->userdata_coordinate == actual->userdata_coordinate &&
+                record->kind == actual->kind && record->references != UINT_MAX) {
+                record->references++;
+                use.record = record;
+            } else {
+                /* A fetched callback without its retained user cannot run
+                 * after selected withdrawal or partial descriptor mismatch. */
+                actual->function = NULL;
+            }
+            qemu_mutex_unlock(&registry->mutex);
+        }
+        qemu_rec_mutex_unlock(&plugin.lock);
+    }
+mask:
+    /* Source has not issued group activation. Unknown or selected material
+     * callbacks suppress inherited authority; this mask is outside locks. */
+    use.mask = qemu_plugin_crucible_native_mask_v1(
+        actual->coordinate, actual->function, actual->userdata);
+    return use;
+}
+
+QemuCrucibleNativeGroupUse qemu_plugin_crucible_native_group_use_begin_context_v1(
+    QemuCrucibleNativeRegistration *const *slot,
+    QemuCrucibleNativeGroupContextDescriptorObserver observe, void *context,
+    size_t member,
+    QemuCrucibleNativeGroupDescriptorView *actual)
+{
+    QemuCrucibleNativeGroupUse use = { 0 };
+    QemuCrucibleNativeRegistration *record;
+    QemuCrucibleNativeRegistrationGroup *group;
+    QemuCrucibleNativeInvocationRegistry *registry;
+    pid_t process;
+
+    *actual = (QemuCrucibleNativeGroupDescriptorView) { 0 };
+    record = qatomic_load_acquire(slot);
+    if (!record) {
+        observe(context, member, actual);
+        /* Installation publishes its retained association before function
+         * fields. A publication racing this ordinary read must use the real
+         * protected snapshot rather than execute from an unpinned tuple. */
+        record = qatomic_load_acquire(slot);
+    }
+    if (record) {
+        process = getpid();
+        /* The permanent association may be inherited with locked mutexes.
+         * Authenticate its immutable process before either lock or effect. */
+        if (!registry_process_current(record->owner, process)) {
+            actual->function = NULL;
+            goto mask;
+        }
+        qemu_rec_mutex_lock(&plugin.lock);
+        record = qatomic_load_acquire(slot);
+        observe(context, member, actual);
+        if (record && !registry_process_current(record->owner, process)) {
+            /* Revalidate the actual association reread under plugin.lock. */
+            actual->function = NULL;
+        } else if (record) {
+            registry = record->owner;
+            group = record->group;
+            qemu_mutex_lock(&registry->mutex);
+            if (group_identity_locked(registry, group) && !group->terminal &&
+                member < group->member_count && &group->members[member] == record &&
+                group->module_retained && record->descriptor_retained &&
+                record->coordinate == actual->coordinate &&
+                record->function == actual->function &&
+                record->userdata == actual->userdata &&
+                record->userdata_coordinate == actual->userdata_coordinate &&
+                record->kind == actual->kind && record->references != UINT_MAX) {
+                record->references++;
+                use.record = record;
+            } else {
+                /* A fetched callback without its retained user cannot run
+                 * after selected withdrawal or partial descriptor mismatch. */
+                actual->function = NULL;
+            }
+            qemu_mutex_unlock(&registry->mutex);
+        }
+        qemu_rec_mutex_unlock(&plugin.lock);
+    }
+mask:
+    /* Source has not issued group activation. Unknown or selected material
+     * callbacks suppress inherited authority; this mask is outside locks. */
+    use.mask = qemu_plugin_crucible_native_mask_v1(
+        actual->coordinate, actual->function, actual->userdata);
+    return use;
+}
+
+#if defined(CONFIG_LINUX) && !defined(CONFIG_USER_ONLY)
+/* plugin.lock owns membership. The actual CPU producer also corroborates its
+ * execution context; an arbitrary index or another thread cannot supply it. */
+static bool vcpu_init_cpu_current_locked(CPUState *cpu)
+{
+    gpointer key, value;
+
+    return cpu && current_cpu == cpu &&
+        cpu->cpu_index != UNASSIGNED_CPU_INDEX && plugin.cpu_ht &&
+        g_hash_table_lookup_extended(plugin.cpu_ht, &cpu->cpu_index, &key, &value) &&
+        key == &cpu->cpu_index && value == &cpu->cpu_index;
+}
+#endif
