+typedef struct RegistryOrdering {
+    QemuSemaphore entry_passed;
+    QemuSemaphore resume;
+    bool reply;
+    bool omit_guard;
+    int status;
+} RegistryOrdering;
+
+static void *foreign_registry_reset(void *opaque)
+{
+    RegistryOrdering *ordering = opaque;
+    QemuMutex *target = ordering->reply ?
+        &qemu_plugin_crucible_resource_lock :
+        &qemu_plugin_crucible_barrier_operation_lock;
+
+    /* Run the actual entry cut before Source exists, then witness contention. */
+    probe_uninstall_entry(fixture.ctx.id);
+    g_assert_true(effect_reached);
+    g_assert_cmpint(qemu_mutex_trylock(target), !=, 0);
+    qemu_sem_post(&ordering->entry_passed);
+    qemu_sem_wait(&ordering->resume);
+
+    if (ordering->reply) {
+        if (ordering->omit_guard) {
+            probe_reply_refusal_omitted(fixture.ctx.id);
+        } else {
+            probe_reply_after_stale_entry(fixture.ctx.id);
+        }
+    } else if (ordering->omit_guard) {
+        ordering->status = probe_registry_unregister_omitted(fixture.ctx.id);
+    } else {
+        ordering->status =
+            qemu_plugin_crucible_selectable_reset_unregister(fixture.ctx.id);
+    }
+    return NULL;
+}
+
+static void run_registry_ordering(bool reply, bool omit_guard)
+{
+    RegistryOrdering ordering = {
+        .reply = reply,
+        .omit_guard = omit_guard,
+        .status = INT_MAX,
+    };
+    QemuMutex *target = reply ? &qemu_plugin_crucible_resource_lock :
+        &qemu_plugin_crucible_barrier_operation_lock;
+    QemuThread thread;
+
+    fixture_prepare(0, false);
+    qemu_sem_init(&ordering.entry_passed, 0);
+    qemu_sem_init(&ordering.resume, 0);
+    effect_reached = false;
+    modeled_abort_reached = false;
+    qemu_mutex_lock(target);
+    qemu_thread_create(&thread, "source-registry", foreign_registry_reset,
+                       &ordering, QEMU_THREAD_JOINABLE);
+    qemu_sem_wait(&ordering.entry_passed);
+    g_assert_false(qemu_plugin_crucible_startup_source_retained());
+
+    /* Semaphore delay is modeled scheduling; no kernel-wait claim is made. */
+    qemu_mutex_unlock(target);
+    g_assert_cmpint(fixture_acquire(), ==, 0);
+    if (reply) {
+        g_assert_cmpint(qemu_plugin_crucible_register_selectable_reply(
+                           fixture.ctx.id, fixture_reply_callback,
+                           &fixture_reply_userdata), ==, 0);
+        g_assert_true(qemu_plugin_crucible_selectable_reply_owner_registered(
+                          fixture.ctx.id));
+    } else {
+        register_fixture_reset();
+    }
+    fixture_signal();
+    g_assert_cmpint(qemu_plugin_crucible_startup_source_check_v1(
+                       fixture.ctx.id), ==, -ECANCELED);
+    qemu_sem_post(&ordering.resume);
+    qemu_thread_join(&thread);
+    qemu_sem_destroy(&ordering.resume);
+    qemu_sem_destroy(&ordering.entry_passed);
+
+    if (reply) {
+        g_assert_cmpint(modeled_abort_reached, ==, omit_guard);
+        g_assert_true(qemu_plugin_crucible_selectable_reply_owner_registered(
+                          fixture.ctx.id));
+        g_assert_true(qemu_plugin_crucible_selectable_reply_cb ==
+                      fixture_reply_callback);
+        g_assert_true(qemu_plugin_crucible_selectable_reply_userdata ==
+                      &fixture_reply_userdata);
+    } else if (omit_guard) {
+        g_assert_cmpint(ordering.status, ==, 0);
+        g_assert_cmpuint(qemu_plugin_crucible_selectable_reset_owner, ==, 0);
+        g_assert_null(qemu_plugin_crucible_selectable_reset_cb);
+        g_assert_null(qemu_plugin_crucible_selectable_reset_userdata);
+    } else {
+        g_assert_cmpint(ordering.status, ==, -EPERM);
+        assert_registry_reset(false);
+    }
+    g_assert_cmpuint(fixture_callback_calls, ==, 0);
+    g_assert_false(fixture.ctx.resetting);
+    g_assert_false(fixture.ctx.uninstalling);
+    g_assert_cmpint(startup_source.first_negative_status, ==, -ECANCELED);
+    assert_retained();
+}
