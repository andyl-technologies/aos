+#ifdef CONFIG_LINUX
+/* Kernel identity corroboration, not an issuer or a new event alias. */
+static int startup_event_id_line(const char *line, uint64_t *token)
+{
+    static const char prefix[] = "eventfd-id:";
+    uint64_t value = 0;
+    const char *cursor;
+
+    if (strncmp(line, prefix, sizeof(prefix) - 1) != 0) {
+        return 0;
+    }
+    cursor = line + sizeof(prefix) - 1;
+    while (*cursor == ' ' || *cursor == '\t') {
+        cursor++;
+    }
+    if (*cursor < '0' || *cursor > '9') {
+        return -EINVAL;
+    }
+    while (*cursor >= '0' && *cursor <= '9') {
+        unsigned digit = *cursor++ - '0';
+
+        if (value > (UINT64_MAX - digit) / 10) {
+            return -EOVERFLOW;
+        }
+        value = value * 10 + digit;
+    }
+    if (*cursor != '\0' || value == UINT64_MAX) {
+        return -EINVAL;
+    }
+    *token = value + 1;
+    return 1;
+}
+
+static int startup_event_id(uint64_t *token)
+{
+    char chunk[128];
+    char line[128];
+    size_t line_bytes = 0;
+    size_t total_bytes = 0;
+    bool found = false;
+    int info_fd;
+    int result = 0;
+
+    info_fd = qemu_descriptor_open_owned("/proc/self/fdinfo/12", O_RDONLY | O_CLOEXEC, 0,
+                                    &startup_source.metadata_fd_owner);
+    if (info_fd < 0) {
+        return -errno;
+    }
+    startup_source.metadata_fd = info_fd;
+    for (;;) {
+        ssize_t bytes = read(info_fd, chunk, sizeof(chunk));
+
+        if (bytes < 0) {
+            result = -errno;
+            break;
+        }
+        if (bytes == 0) {
+            if (line_bytes != 0 || !found) {
+                result = -EINVAL;
+            }
+            break;
+        }
+        if ((size_t)bytes > STARTUP_FDINFO_LIMIT - total_bytes) {
+            result = -EOVERFLOW;
+            break;
+        }
+        total_bytes += bytes;
+        for (size_t index = 0; index < (size_t)bytes; index++) {
+            if (chunk[index] == '\n') {
+                int matched;
+
+                line[line_bytes] = '\0';
+                matched = startup_event_id_line(line, token);
+                if (matched < 0 || (matched == 1 && found)) {
+                    result = matched < 0 ? matched : -EINVAL;
+                    goto out;
+                }
+                found |= matched == 1;
+                line_bytes = 0;
+            } else if (chunk[index] == '\0' ||
+                       line_bytes == sizeof(line) - 1) {
+                result = -EINVAL;
+                goto out;
+            } else {
+                line[line_bytes++] = chunk[index];
+            }
+        }
+    }
+out:
+    /* Linux close is attempted once; interruption does not renew the check. */
+    if (qemu_descriptor_close_owned(info_fd, &startup_source.metadata_fd_owner) < 0) {
+        startup_source.metadata_close_uncertain = true;
+        if (result == 0) {
+            result = -errno;
+        }
+    } else {
+        startup_source.metadata_fd = -1;
+    }
+    return result;
+}
+
+static int startup_event_identity(void)
+{
+    const QemuCrucibleOriginalStartupWireRecord *original =
+        &startup_source.original;
+    struct stat status;
+    uint64_t token = 0;
+    int flags;
+    int descriptor_flags;
+    int result;
+
+    if (fstat(startup_source.event_fd, &status) < 0) {
+        return -errno;
+    }
+    flags = fcntl(startup_source.event_fd, F_GETFL);
+    if (flags < 0) {
+        return -errno;
+    }
+    if (!(flags & O_NONBLOCK) ||
+        (uint64_t)status.st_dev != original->cancellation_device ||
+        (uint64_t)status.st_ino != original->cancellation_inode) {
+        return -ESTALE;
+    }
+    descriptor_flags = fcntl(startup_source.event_fd, F_GETFD);
+    if (descriptor_flags < 0) {
+        return -errno;
+    }
+    if (descriptor_flags & FD_CLOEXEC) {
+        return -ESTALE;
+    }
+    result = startup_event_id(&token);
+    if (result != 0) {
+        return result;
+    }
+    return token == original->cancellation_event_id ? 0 : -ESTALE;
+}
+
+static int startup_cancelled(void)
+{
+    struct pollfd event = {
+        .fd = startup_source.event_fd,
+        .events = POLLIN,
+    };
+    int result = poll(&event, 1, 0);
+
+    if (result < 0) {
+        return -errno;
+    }
+    if (event.revents & POLLNVAL) {
+        return -EBADF;
+    }
+    if (event.revents & (POLLERR | POLLHUP)) {
+        return -EIO;
+    }
+    if (result != 0 || event.revents != 0) {
+        return -ECANCELED;
+    }
+    return 0;
+}
+
+static int startup_monotonic_now(uint64_t *now)
+{
+    struct timespec timestamp;
+
+    if (clock_gettime(CLOCK_MONOTONIC, &timestamp) < 0) {
+        return -errno;
+    }
+    if (timestamp.tv_sec < 0 || timestamp.tv_nsec < 0 ||
+        timestamp.tv_nsec >= 1000000000 ||
+        (uint64_t)timestamp.tv_sec >
+            (UINT64_MAX - timestamp.tv_nsec) / 1000000000) {
+        return -EOVERFLOW;
+    }
+    *now = (uint64_t)timestamp.tv_sec * 1000000000 + timestamp.tv_nsec;
+    return 0;
+}
+
+static int startup_live_slice(uint64_t *bounded_ns)
+{
+    uint64_t now;
+    uint64_t remaining;
+    int result;
+
+    result = startup_cancelled();
+    if (result == 0) {
+        result = startup_event_identity();
+    }
+    if (result == 0) {
+        result = startup_monotonic_now(&now);
+    }
+    if (result != 0) {
+        return startup_failure(result);
+    }
+    if (now < startup_source.original.original_start_ns) {
+        return startup_failure(-ESTALE);
+    }
+    if (now >= startup_source.original.absolute_end_ns) {
+        return startup_failure(-ETIMEDOUT);
+    }
+    result = startup_cancelled();
+    if (result == 0) {
+        result = startup_monotonic_now(&now);
+    }
+    if (result != 0) {
+        return startup_failure(result);
+    }
+    if (now < startup_source.original.original_start_ns) {
+        return startup_failure(-ESTALE);
+    }
+    if (now >= startup_source.original.absolute_end_ns) {
+        return startup_failure(-ETIMEDOUT);
+    }
+    remaining = startup_source.original.absolute_end_ns - now;
+    *bounded_ns = MIN(remaining, startup_source.original.poll_ns);
+    return 0;
+}
+#endif
+
+static int startup_active(qemu_plugin_id_t id)
+{
+    if (!qatomic_load_acquire(&startup_source.module_custody_published) ||
+        !startup_invocation(id) || !startup_source.acquisition_attempted ||
+        startup_source.saved.plugin_id != id) {
+        return -EPERM;
+    }
+    if (startup_source.first_negative_status != 0) {
+        return startup_source.first_negative_status;
+    }
+    if (!startup_source.owns_event || !startup_source.total_pinned) {
+        return startup_failure(-EPROTO);
+    }
+    if (startup_source.birth_closed) {
+        return startup_failure(-EALREADY);
+    }
+    return 0;
+}
