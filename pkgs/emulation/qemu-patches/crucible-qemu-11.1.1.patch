+ */
+
+#include "qemu/osdep.h"
+#include "hw/core/crucible-register-helpers.h"
+#include "cpu.h"
+#include "exec/cputlb.h"
+#include "exec/tb-flush.h"
+#include "hw/i386/apic.h"
+#include "qemu/main-loop.h"
+#include "qemu/crucible-fault.h"
+#include "tcg/helper-tcg.h"
+#include "crucible-fingerprint.h"
+
+#ifdef TARGET_X86_64
+
+#define CRUCIBLE_REG_GROUP_GPR 1
+#define CRUCIBLE_REG_GROUP_CONTROL_FLOW 2
+#define CRUCIBLE_REG_GROUP_FLAGS 3
+#define CRUCIBLE_REG_GROUP_SEGMENT 4
+#define CRUCIBLE_REG_GROUP_CONTROL 5
+#define CRUCIBLE_REG_GROUP_SYSTEM 6
+#define CRUCIBLE_REG_GROUP_DEBUG 7
+#define CRUCIBLE_REG_GROUP_FLOAT 8
+#define CRUCIBLE_REG_GROUP_VECTOR 9
+
+#define CRUCIBLE_REG_CAP_IMPULSE (1U << 0)
+#define CRUCIBLE_REG_CAP_PERSISTENT (1U << 1)
+#define CRUCIBLE_REG_CAP_VMSTATE (1U << 2)
+#define CRUCIBLE_REG_SIDE_TLB (1U << 0)
+#define CRUCIBLE_REG_SIDE_TB (1U << 1)
+#define CRUCIBLE_REG_SIDE_FLAGS (1U << 2)
+#define CRUCIBLE_REG_SIDE_INTERRUPT (1U << 3)
+#define CRUCIBLE_REG_SIDE_CONTROL_FLOW (1U << 5)
+#define CRUCIBLE_REG_PHASES ((UINT64_C(1) << 10) | (UINT64_C(1) << 11))
+
+enum {
+    X86_CRUCIBLE_GPR_FIRST = 1,
+    X86_CRUCIBLE_GPR_LAST = 16,
+    X86_CRUCIBLE_RIP = 17,
+    X86_CRUCIBLE_RFLAGS = 18,
+    X86_CRUCIBLE_SEG_FIRST = 19,
+    X86_CRUCIBLE_SEG_LAST = 42,
+    X86_CRUCIBLE_KERNEL_GS_BASE = 43,
+    X86_CRUCIBLE_CR0 = 44,
+    X86_CRUCIBLE_CR2 = 45,
+    X86_CRUCIBLE_CR3 = 46,
+    X86_CRUCIBLE_CR4 = 47,
+    X86_CRUCIBLE_CR8 = 48,
+    X86_CRUCIBLE_EFER = 49,
+    X86_CRUCIBLE_DR_FIRST = 50,
+    X86_CRUCIBLE_DR_LAST = 57,
+    X86_CRUCIBLE_ST_FIRST = 58,
+    X86_CRUCIBLE_ST_LAST = 65,
+    X86_CRUCIBLE_MM_FIRST = 66,
+    X86_CRUCIBLE_MM_LAST = 73,
+    X86_CRUCIBLE_FPU_CONTROL = 74,
+    X86_CRUCIBLE_FPU_STATUS = 75,
+    X86_CRUCIBLE_FPU_TAG = 76,
+    X86_CRUCIBLE_FPU_OPCODE = 77,
+    X86_CRUCIBLE_FPU_IP = 78,
+    X86_CRUCIBLE_FPU_DP = 79,
+    X86_CRUCIBLE_XMM_FIRST = 80,
+    X86_CRUCIBLE_XMM_LAST = 95,
+    X86_CRUCIBLE_MXCSR = 96,
+    X86_CRUCIBLE_BASE_COUNT = X86_CRUCIBLE_MXCSR,
+};
+
+typedef enum X86CrucibleOptionalRegisterKind {
+    X86_CRUCIBLE_OPTIONAL_NONE,
+    X86_CRUCIBLE_OPTIONAL_SYSENTER_CS,
+    X86_CRUCIBLE_OPTIONAL_SYSENTER_ESP,
+    X86_CRUCIBLE_OPTIONAL_SYSENTER_EIP,
+    X86_CRUCIBLE_OPTIONAL_STAR,
+    X86_CRUCIBLE_OPTIONAL_LSTAR,
+    X86_CRUCIBLE_OPTIONAL_CSTAR,
+    X86_CRUCIBLE_OPTIONAL_FMASK,
+    X86_CRUCIBLE_OPTIONAL_PAT,
+    X86_CRUCIBLE_OPTIONAL_TSC_AUX,
+    X86_CRUCIBLE_OPTIONAL_YMM_UPPER,
+    X86_CRUCIBLE_OPTIONAL_ZMM_UPPER,
+    X86_CRUCIBLE_OPTIONAL_ZMM_HIGH,
+    X86_CRUCIBLE_OPTIONAL_OPMASK,
+    X86_CRUCIBLE_OPTIONAL_PKRU,
+} X86CrucibleOptionalRegisterKind;
+
+typedef struct X86CrucibleOptionalRegister {
+    X86CrucibleOptionalRegisterKind kind;
+    uint32_t index;
+} X86CrucibleOptionalRegister;
+
+static const int x86_crucible_gpr_map[16] = {
+    R_EAX, R_EBX, R_ECX, R_EDX, R_ESI, R_EDI, R_EBP, R_ESP,
+    8, 9, 10, 11, 12, 13, 14, 15,
+};
+
+static const char * const x86_crucible_gpr_names[16] = {
+    "rax", "rbx", "rcx", "rdx", "rsi", "rdi", "rbp", "rsp",
+    "r8", "r9", "r10", "r11", "r12", "r13", "r14", "r15",
+};
+
+static const char * const x86_crucible_segment_names[6] = {
+    "cs", "ss", "ds", "es", "fs", "gs",
+};
+
+static const X86Seg x86_crucible_segment_map[6] = {
+    R_CS, R_SS, R_DS, R_ES, R_FS, R_GS,
+};
+
+static bool x86_crucible_has_avx(CPUX86State *env)
+{
+    return env->features[FEAT_1_ECX] & CPUID_EXT_AVX;
+}
+
+static bool x86_crucible_has_avx512(CPUX86State *env)
+{
+    return env->features[FEAT_7_0_EBX] & CPUID_7_0_EBX_AVX512F;
+}
+
+static bool x86_crucible_has_pku(CPUX86State *env)
+{
+    return env->features[FEAT_7_0_ECX] & CPUID_7_0_ECX_PKU;
+}
+
+static bool x86_crucible_has_syscall(CPUX86State *env)
+{
+    return env->features[FEAT_8000_0001_EDX] & CPUID_EXT2_SYSCALL;
+}
+
+static size_t x86_crucible_register_count_for_env(CPUX86State *env)
+{
+    size_t count = X86_CRUCIBLE_BASE_COUNT;
+
+    if (env->features[FEAT_1_EDX] & CPUID_SEP) {
+        count += 3;
+    }
+    if (x86_crucible_has_syscall(env)) {
+        count += 4;
+    }
+    if (env->features[FEAT_1_EDX] & CPUID_PAT) {
+        count++;
+    }
+    if (env->features[FEAT_8000_0001_EDX] & CPUID_EXT2_RDTSCP) {
+        count++;
+    }
+    if (x86_crucible_has_avx(env)) {
+        count += 16;
+    }
+    if (x86_crucible_has_avx512(env)) {
+        count += 16 + 16 + NB_OPMASK_REGS;
+    }
+    if (x86_crucible_has_pku(env)) {
+        count++;
+    }
+    return count;
+}
+
+static X86CrucibleOptionalRegister x86_crucible_optional_register(
+    CPUX86State *env, uint32_t id)
+{
+    uint32_t first = X86_CRUCIBLE_BASE_COUNT + 1;
+    X86CrucibleOptionalRegister result = { 0 };
+
+    if (env->features[FEAT_1_EDX] & CPUID_SEP) {
+        if (id >= first && id < first + 3) {
+            result.kind = X86_CRUCIBLE_OPTIONAL_SYSENTER_CS + id - first;
+            return result;
+        }
+        first += 3;
+    }
+    if (x86_crucible_has_syscall(env)) {
+        if (id >= first && id < first + 4) {
+            result.kind = X86_CRUCIBLE_OPTIONAL_STAR + id - first;
+            return result;
+        }
+        first += 4;
+    }
+    if (env->features[FEAT_1_EDX] & CPUID_PAT) {
+        if (id == first) {
+            result.kind = X86_CRUCIBLE_OPTIONAL_PAT;
+            return result;
+        }
+        first++;
+    }
+    if (env->features[FEAT_8000_0001_EDX] & CPUID_EXT2_RDTSCP) {
+        if (id == first) {
+            result.kind = X86_CRUCIBLE_OPTIONAL_TSC_AUX;
+            return result;
+        }
+        first++;
+    }
+    if (x86_crucible_has_avx(env)) {
+        if (id >= first && id < first + 16) {
+            result.kind = X86_CRUCIBLE_OPTIONAL_YMM_UPPER;
+            result.index = id - first;
+            return result;
+        }
+        first += 16;
+    }
+    if (x86_crucible_has_avx512(env)) {
+        if (id >= first && id < first + 16) {
+            result.kind = X86_CRUCIBLE_OPTIONAL_ZMM_UPPER;
+            result.index = id - first;
+            return result;
+        }
+        first += 16;
+        if (id >= first && id < first + 16) {
+            result.kind = X86_CRUCIBLE_OPTIONAL_ZMM_HIGH;
+            result.index = id - first + 16;
+            return result;
+        }
+        first += 16;
+        if (id >= first && id < first + NB_OPMASK_REGS) {
+            result.kind = X86_CRUCIBLE_OPTIONAL_OPMASK;
+            result.index = id - first;
+            return result;
+        }
+        first += NB_OPMASK_REGS;
+    }
+    if (x86_crucible_has_pku(env) && id == first) {
+        result.kind = X86_CRUCIBLE_OPTIONAL_PKRU;
+    }
+    return result;
+}
+
+static void x86_crucible_masks(CrucibleCPURegisterCapability *capability,
+                               uint64_t writable)
+{
+    size_t bytes = DIV_ROUND_UP(capability->width_bits, 8);
+
+    capability->mask_bytes = bytes;
+    memset(capability->writable_mask, 0, bytes);
+    memset(capability->ignored_mask, 0, bytes);
+    memset(capability->read_only_mask, 0, bytes);
+    memset(capability->reserved_mask, 0xff, bytes);
+    if (capability->width_bits % 8) {
+        capability->reserved_mask[bytes - 1] =
+            (1U << (capability->width_bits % 8)) - 1;
+    }
+    for (uint32_t bit = 0; bit < MIN(capability->width_bits, 64); bit++) {
+        if (writable & (UINT64_C(1) << bit)) {
+            capability->writable_mask[bit / 8] |= 1U << (bit % 8);
+            capability->reserved_mask[bit / 8] &= ~(1U << (bit % 8));
+        }
+    }
+}
+
+static void x86_crucible_all_writable(
+    CrucibleCPURegisterCapability *capability)
+{
+    size_t bytes = DIV_ROUND_UP(capability->width_bits, 8);
+
+    x86_crucible_masks(capability, UINT64_MAX);
+    if (capability->width_bits > 64) {
+        memset(capability->writable_mask + 8, 0xff, bytes - 8);
+        memset(capability->reserved_mask + 8, 0, bytes - 8);
+        if (capability->width_bits % 8) {
+            capability->writable_mask[bytes - 1] =
+                (1U << (capability->width_bits % 8)) - 1;
+        }
+    }
+    capability->model_phase_mask = CRUCIBLE_REG_PHASES;
+    capability->capabilities = CRUCIBLE_REG_CAP_IMPULSE |
+        CRUCIBLE_REG_CAP_PERSISTENT | CRUCIBLE_REG_CAP_VMSTATE;
+}
+
+static void x86_crucible_writable(
+    CrucibleCPURegisterCapability *capability, uint64_t writable)
+{
+    x86_crucible_masks(capability, writable);
+    capability->model_phase_mask = CRUCIBLE_REG_PHASES;
+    capability->capabilities = CRUCIBLE_REG_CAP_IMPULSE |
+        CRUCIBLE_REG_CAP_PERSISTENT | CRUCIBLE_REG_CAP_VMSTATE;
+}
+
+static void x86_crucible_read_only(
+    CrucibleCPURegisterCapability *capability)
+{
+    size_t bytes = DIV_ROUND_UP(capability->width_bits, 8);
+
+    x86_crucible_masks(capability, 0);
+    memcpy(capability->read_only_mask, capability->reserved_mask, bytes);
+    memset(capability->reserved_mask, 0, bytes);
+    capability->model_phase_mask = 0;
+    capability->side_effects = 0;
+    capability->capabilities = CRUCIBLE_REG_CAP_VMSTATE;
+}
+
+size_t x86_crucible_register_count(CPUState *cs)
+{
+    return X86_CPU(cs) ?
+        x86_crucible_register_count_for_env(&X86_CPU(cs)->env) : 0;
+}
+
+static bool x86_crucible_register_shape(
+    CPUState *cs, size_t index, const CrucibleCPURegisterKeyView *keys,
+    char *name, size_t capacity,
+    size_t *name_bytes, uint32_t *width_bits)
+{
+    CPUX86State *env = &X86_CPU(cs)->env;
+    CrucibleRegisterNameBuilder builder = {
+        .destination = name, .capacity = capacity,
+    };
+    X86CrucibleOptionalRegister optional;
+    uint32_t width, id;
+
+    if (index >= UINT32_MAX ||
+        index >= x86_crucible_register_count_for_env(env)) {
+        return false;
+    }
+    id = index + 1;
+    optional = x86_crucible_optional_register(env, id);
+    if (id <= X86_CRUCIBLE_GPR_LAST) {
+        crucible_register_name_text(&builder, x86_crucible_gpr_names[id - 1]);
+        width = 64;
+    } else if (id == X86_CRUCIBLE_RIP || id == X86_CRUCIBLE_RFLAGS) {
+        crucible_register_name_text(
+            &builder, id == X86_CRUCIBLE_RIP ? "rip" : "rflags");
+        width = id == X86_CRUCIBLE_RIP ? 64 : 32;
+    } else if (id <= X86_CRUCIBLE_SEG_LAST) {
+        static const char *const suffixes[] = {
+            "selector", "base", "limit", "attributes",
+        };
+        uint32_t relative = id - X86_CRUCIBLE_SEG_FIRST;
+        uint32_t field = relative % 4;
+
+        crucible_register_name_text(
+            &builder, x86_crucible_segment_names[relative / 4]);
+        crucible_register_name_text(&builder, "-");
+        crucible_register_name_text(&builder, suffixes[field]);
+        width = field == 0 ? 16 : ((field == 2 || field == 3) ? 32 : 64);
+    } else if (id == X86_CRUCIBLE_KERNEL_GS_BASE) {
+        crucible_register_name_text(&builder, "kernel-gs-base");
+        width = 64;
+    } else if (id <= X86_CRUCIBLE_EFER) {
+        static const char *const names[] = {
+            "cr0", "cr2", "cr3", "cr4", "cr8", "efer",
+        };
+
+        crucible_register_name_text(&builder, names[id - X86_CRUCIBLE_CR0]);
+        width = 64;
+    } else if (id <= X86_CRUCIBLE_DR_LAST) {
+        crucible_register_name_text(&builder, "dr");
+        crucible_register_name_decimal(&builder, id - X86_CRUCIBLE_DR_FIRST);
+        width = 64;
+    } else if (id <= X86_CRUCIBLE_ST_LAST) {
+        crucible_register_name_text(&builder, "st");
+        crucible_register_name_decimal(&builder, id - X86_CRUCIBLE_ST_FIRST);
+        width = 80;
+    } else if (id <= X86_CRUCIBLE_MM_LAST) {
+        crucible_register_name_text(&builder, "mm");
+        crucible_register_name_decimal(&builder, id - X86_CRUCIBLE_MM_FIRST);
+        width = 64;
+    } else if (id <= X86_CRUCIBLE_FPU_DP) {
+        static const char *const names[] = {
+            "fpu-control", "fpu-status", "fpu-abridged-tag", "fpu-opcode",
+            "fpu-instruction-pointer", "fpu-data-pointer",
+        };
+        static const uint32_t widths[] = { 16, 16, 8, 16, 64, 64 };
+        uint32_t relative = id - X86_CRUCIBLE_FPU_CONTROL;
+
+        crucible_register_name_text(&builder, names[relative]);
+        width = widths[relative];
+    } else if (id <= X86_CRUCIBLE_XMM_LAST) {
+        crucible_register_name_text(&builder, "xmm");
+        crucible_register_name_decimal(&builder, id - X86_CRUCIBLE_XMM_FIRST);
+        width = 128;
+    } else if (id == X86_CRUCIBLE_MXCSR) {
+        crucible_register_name_text(&builder, "mxcsr");
+        width = 32;
+    } else if (optional.kind >= X86_CRUCIBLE_OPTIONAL_SYSENTER_CS &&
+               optional.kind <= X86_CRUCIBLE_OPTIONAL_TSC_AUX) {
+        static const char *const names[] = {
+            "sysenter-cs", "sysenter-esp", "sysenter-eip", "star", "lstar",
+            "cstar", "fmask", "pat", "tsc-aux",
+        };
+
+        crucible_register_name_text(
+            &builder, names[optional.kind - X86_CRUCIBLE_OPTIONAL_SYSENTER_CS]);
+        width = optional.kind == X86_CRUCIBLE_OPTIONAL_SYSENTER_CS ||
+            optional.kind == X86_CRUCIBLE_OPTIONAL_TSC_AUX ? 32 : 64;
+    } else if (optional.kind == X86_CRUCIBLE_OPTIONAL_YMM_UPPER ||
+               optional.kind == X86_CRUCIBLE_OPTIONAL_ZMM_UPPER ||
+               optional.kind == X86_CRUCIBLE_OPTIONAL_ZMM_HIGH ||
+               optional.kind == X86_CRUCIBLE_OPTIONAL_OPMASK) {
+        crucible_register_name_text(&builder,
+            optional.kind == X86_CRUCIBLE_OPTIONAL_YMM_UPPER ? "ymm" :
+            optional.kind == X86_CRUCIBLE_OPTIONAL_OPMASK ? "k" : "zmm");
+        crucible_register_name_decimal(&builder, optional.index);
+        if (optional.kind == X86_CRUCIBLE_OPTIONAL_YMM_UPPER) {
+            crucible_register_name_text(&builder, "-upper-128");
+            width = 128;
+        } else if (optional.kind == X86_CRUCIBLE_OPTIONAL_ZMM_UPPER) {
+            crucible_register_name_text(&builder, "-upper-256");
+            width = 256;
+        } else {
+            width = optional.kind == X86_CRUCIBLE_OPTIONAL_ZMM_HIGH ? 512 : 64;
+        }
+    } else if (optional.kind == X86_CRUCIBLE_OPTIONAL_PKRU) {
+        crucible_register_name_text(&builder, "pkru");
+        width = 32;
+    } else {
+        return false;
+    }
+    if (builder.failed) {
+        return false;
+    }
+    *name_bytes = builder.length + 1;
+    *width_bits = width;
+    return true;
+}
+
+bool x86_crucible_register_geometry(
+    CPUState *cs, CrucibleCPURegisterGeometry *out)
+{
+    CrucibleCPURegisterGeometry geometry = { .cpu = cs };
+    size_t count;
+
+    if (!cs || !out) {
+        return false;
+    }
+    count = x86_crucible_register_count(cs);
+    for (size_t index = 0; index < count; index++) {
+        size_t name_bytes;
+        uint32_t width_bits;
+
+        if (!x86_crucible_register_shape(cs, index, NULL, NULL, 0,
+                                             &name_bytes, &width_bits) ||
+            !crucible_register_geometry_add(&geometry, name_bytes,
+                                             width_bits)) {
+            return false;
+        }
+    }
+    *out = geometry;
+    return true;
+}
+
+bool x86_crucible_register_keys_into(
+    CPUState *cs, uint32_t *keys, size_t capacity,
+    CrucibleCPURegisterKeyView *out)
+{
+    CrucibleCPURegisterGeometry geometry;
+
+    if (!out || !x86_crucible_register_geometry(cs, &geometry)) {
+        return false;
+    }
+    *out = (CrucibleCPURegisterKeyView) { .cpu = cs };
+    return true;
+}
+
+static bool x86_crucible_register_keys_current(
+    CPUState *cs, const CrucibleCPURegisterKeyView *keys,
+    const CrucibleCPURegisterGeometry *geometry)
+{
+    return keys && keys->cpu == cs && !keys->keys && !keys->count &&
+        !geometry->key_count;
+}
+
+static bool x86_crucible_register_describe_prepaid(
+    CPUState *cs, size_t index,
+    const CrucibleCPURegisterKeyView *keys,
+    const CrucibleCPURegisterBuffers *buffers,
+    CrucibleCPURegisterCapability *capability)
+{
+    CPUX86State *env = &X86_CPU(cs)->env;
+    uint32_t id = index + 1;
+    X86CrucibleOptionalRegister optional =
+        x86_crucible_optional_register(env, id);
+
+    if (!X86_CPU(cs) || !capability ||
+        id > x86_crucible_register_count_for_env(env)) {
+        return false;
+    }
+    *capability = (CrucibleCPURegisterCapability) {
+        .numeric_id = id, .name = buffers->name,
+        .writable_mask = buffers->writable_mask,
+        .reserved_mask = buffers->reserved_mask,
+        .ignored_mask = buffers->ignored_mask,
+        .read_only_mask = buffers->read_only_mask,
+    };
+    if (id >= X86_CRUCIBLE_GPR_FIRST && id <= X86_CRUCIBLE_GPR_LAST) {
+        capability->width_bits = 64;
+        capability->group = CRUCIBLE_REG_GROUP_GPR;
+        x86_crucible_all_writable(capability);
+    } else if (id == X86_CRUCIBLE_RIP) {
+        capability->width_bits = 64;
+        capability->group = CRUCIBLE_REG_GROUP_CONTROL_FLOW;
+        capability->side_effects = CRUCIBLE_REG_SIDE_TB |
+            CRUCIBLE_REG_SIDE_CONTROL_FLOW;
+        x86_crucible_all_writable(capability);
+    } else if (id == X86_CRUCIBLE_RFLAGS) {
+        capability->width_bits = 32;
+        capability->group = CRUCIBLE_REG_GROUP_FLAGS;
+        capability->side_effects = CRUCIBLE_REG_SIDE_TB |
+            CRUCIBLE_REG_SIDE_FLAGS | CRUCIBLE_REG_SIDE_INTERRUPT;
+        x86_crucible_writable(capability, UINT64_C(0x003f7fd5));
+        capability->read_only_mask[0] |= 1U << 1;
+        capability->reserved_mask[0] &= ~(1U << 1);
+    } else if (id >= X86_CRUCIBLE_SEG_FIRST && id <= X86_CRUCIBLE_SEG_LAST) {
+        uint32_t relative = id - X86_CRUCIBLE_SEG_FIRST;
+        uint32_t field = relative % 4;
+
+        capability->width_bits = field == 0 ? 16 :
+            ((field == 2 || field == 3) ? 32 : 64);
+        capability->group = CRUCIBLE_REG_GROUP_SEGMENT;
+        capability->side_effects = CRUCIBLE_REG_SIDE_TLB |
+            CRUCIBLE_REG_SIDE_TB | CRUCIBLE_REG_SIDE_FLAGS |
+            CRUCIBLE_REG_SIDE_INTERRUPT;
+        if (field == 3) {
+            x86_crucible_writable(
+                capability, DESC_TYPE_MASK | DESC_S_MASK | DESC_DPL_MASK |
+                DESC_P_MASK | DESC_AVL_MASK | DESC_L_MASK | DESC_B_MASK |
+                DESC_G_MASK);
+            capability->capabilities &= ~CRUCIBLE_REG_CAP_PERSISTENT;
+        } else {
+            x86_crucible_all_writable(capability);
+        }
+    } else if (id == X86_CRUCIBLE_KERNEL_GS_BASE) {
+        capability->width_bits = 64;
+        capability->group = CRUCIBLE_REG_GROUP_SYSTEM;
+        capability->side_effects = CRUCIBLE_REG_SIDE_TLB |
+            CRUCIBLE_REG_SIDE_TB;
+        x86_crucible_all_writable(capability);
+    } else if (id >= X86_CRUCIBLE_CR0 && id <= X86_CRUCIBLE_EFER) {
+        uint64_t writable = UINT64_MAX;
+
+        capability->width_bits = 64;
+        capability->group = id == X86_CRUCIBLE_EFER ?
+            CRUCIBLE_REG_GROUP_SYSTEM : CRUCIBLE_REG_GROUP_CONTROL;
+        switch (id) {
+        case X86_CRUCIBLE_CR0:
+        case X86_CRUCIBLE_CR4:
+        case X86_CRUCIBLE_EFER:
+            capability->side_effects = CRUCIBLE_REG_SIDE_TLB |
+                CRUCIBLE_REG_SIDE_TB | CRUCIBLE_REG_SIDE_FLAGS;
+            break;
+        case X86_CRUCIBLE_CR3:
+            capability->side_effects = CRUCIBLE_REG_SIDE_TLB;
+            break;
+        case X86_CRUCIBLE_CR8:
+            capability->side_effects = CRUCIBLE_REG_SIDE_INTERRUPT;
+            break;
+        default:
+            break;
+        }
+        if (id == X86_CRUCIBLE_CR0) {
+            writable = CR0_PE_MASK | CR0_MP_MASK | CR0_EM_MASK | CR0_TS_MASK |
+                CR0_NE_MASK | CR0_WP_MASK | CR0_AM_MASK |
+                CR0_NW_MASK | CR0_CD_MASK | CR0_PG_MASK;
+        } else if (id == X86_CRUCIBLE_CR4) {
+            writable = ~cr4_reserved_bits(env);
+        } else if (id == X86_CRUCIBLE_CR3) {
+            writable = X86_CPU(cs)->phys_bits >= 64 ? UINT64_MAX :
+                (UINT64_C(1) << X86_CPU(cs)->phys_bits) - 1;
+        } else if (id == X86_CRUCIBLE_CR8) {
+            writable = 0x0f;
+        } else if (id == X86_CRUCIBLE_EFER) {
+            writable = MSR_EFER_SCE | MSR_EFER_LME | MSR_EFER_NXE |
+                MSR_EFER_SVME | MSR_EFER_FFXSR;
+        }
+        x86_crucible_writable(capability, writable);
+        if (id == X86_CRUCIBLE_CR0 || id == X86_CRUCIBLE_CR3 ||
+            id == X86_CRUCIBLE_CR4 || id == X86_CRUCIBLE_EFER) {
+            capability->capabilities &= ~CRUCIBLE_REG_CAP_PERSISTENT;
+        }
+        if (id == X86_CRUCIBLE_CR0) {
+            capability->read_only_mask[0] |= CR0_ET_MASK;
+            capability->reserved_mask[0] &= ~CR0_ET_MASK;
+        }
+    } else if (id >= X86_CRUCIBLE_DR_FIRST && id <= X86_CRUCIBLE_DR_LAST) {
+        capability->width_bits = 64;
+        capability->group = CRUCIBLE_REG_GROUP_DEBUG;
+        capability->side_effects = CRUCIBLE_REG_SIDE_TB |
+            CRUCIBLE_REG_SIDE_CONTROL_FLOW;
+        if (id <= X86_CRUCIBLE_DR_FIRST + 3) {
+            x86_crucible_all_writable(capability);
+        } else if (id == X86_CRUCIBLE_DR_FIRST + 6) {
+            x86_crucible_writable(capability, UINT32_C(0x0000e00f));
+            capability->read_only_mask[1] |= (DR6_FIXED_1 >> 8) & 0xff;
+            capability->read_only_mask[2] |= (DR6_FIXED_1 >> 16) & 0xff;
+            capability->read_only_mask[3] |= (DR6_FIXED_1 >> 24) & 0xff;
+            capability->reserved_mask[1] &= ~((DR6_FIXED_1 >> 8) & 0xff);
+            capability->reserved_mask[2] &= ~((DR6_FIXED_1 >> 16) & 0xff);
+            capability->reserved_mask[3] &= ~((DR6_FIXED_1 >> 24) & 0xff);
+        } else if (id == X86_CRUCIBLE_DR_FIRST + 7) {
+            x86_crucible_writable(capability, UINT32_C(0xffff23ff));
+            capability->read_only_mask[1] |= (DR7_FIXED_1 >> 8) & 0xff;
+            capability->reserved_mask[1] &= ~((DR7_FIXED_1 >> 8) & 0xff);
+        } else {
+            x86_crucible_read_only(capability);
+        }
+    } else if (id >= X86_CRUCIBLE_ST_FIRST && id <= X86_CRUCIBLE_ST_LAST) {
+        capability->width_bits = 80;
+        capability->group = CRUCIBLE_REG_GROUP_FLOAT;
+        x86_crucible_all_writable(capability);
+    } else if (id >= X86_CRUCIBLE_MM_FIRST && id <= X86_CRUCIBLE_MM_LAST) {
+        capability->width_bits = 64;
+        capability->group = CRUCIBLE_REG_GROUP_FLOAT;
+        x86_crucible_all_writable(capability);
+    } else if (id >= X86_CRUCIBLE_FPU_CONTROL && id <= X86_CRUCIBLE_FPU_DP) {
+        static const uint32_t widths[6] = { 16, 16, 8, 16, 64, 64 };
+        uint32_t relative = id - X86_CRUCIBLE_FPU_CONTROL;
+
+        capability->width_bits = widths[relative];
+        capability->group = CRUCIBLE_REG_GROUP_FLOAT;
+        capability->side_effects = relative < 3 ?
+            CRUCIBLE_REG_SIDE_FLAGS : 0;
+        if (id == X86_CRUCIBLE_FPU_CONTROL) {
+            x86_crucible_writable(capability, 0x1f3f);
+        } else if (id == X86_CRUCIBLE_FPU_OPCODE) {
+            x86_crucible_writable(capability, 0x07ff);
+        } else {
+            x86_crucible_all_writable(capability);
+        }
+    } else if (id >= X86_CRUCIBLE_XMM_FIRST && id <= X86_CRUCIBLE_XMM_LAST) {
+        capability->width_bits = 128;
+        capability->group = CRUCIBLE_REG_GROUP_VECTOR;
+        x86_crucible_all_writable(capability);
+    } else if (id == X86_CRUCIBLE_MXCSR) {
+        capability->width_bits = 32;
+        capability->group = CRUCIBLE_REG_GROUP_FLOAT;
+        capability->side_effects = CRUCIBLE_REG_SIDE_FLAGS;
+        x86_crucible_writable(capability, 0x0000ffff);
+    } else if (optional.kind >= X86_CRUCIBLE_OPTIONAL_SYSENTER_CS &&
+               optional.kind <= X86_CRUCIBLE_OPTIONAL_TSC_AUX) {
+        capability->width_bits =
+            optional.kind == X86_CRUCIBLE_OPTIONAL_SYSENTER_CS ||
+            optional.kind == X86_CRUCIBLE_OPTIONAL_TSC_AUX ? 32 : 64;
+        capability->group = CRUCIBLE_REG_GROUP_SYSTEM;
+        capability->side_effects =
+            optional.kind == X86_CRUCIBLE_OPTIONAL_PAT ?
+            CRUCIBLE_REG_SIDE_TLB :
+            (optional.kind == X86_CRUCIBLE_OPTIONAL_TSC_AUX ? 0 :
+             CRUCIBLE_REG_SIDE_TB | CRUCIBLE_REG_SIDE_CONTROL_FLOW);
+        if (optional.kind == X86_CRUCIBLE_OPTIONAL_SYSENTER_CS) {
+            x86_crucible_writable(capability, UINT16_MAX);
+        } else if (optional.kind == X86_CRUCIBLE_OPTIONAL_PAT) {
+            x86_crucible_writable(capability, UINT64_C(0x0707070707070707));
+            capability->capabilities &= ~CRUCIBLE_REG_CAP_PERSISTENT;
+        } else {
+            x86_crucible_all_writable(capability);
+        }
+    } else if (optional.kind == X86_CRUCIBLE_OPTIONAL_YMM_UPPER) {
+        capability->width_bits = 128;
+        capability->group = CRUCIBLE_REG_GROUP_VECTOR;
+        x86_crucible_all_writable(capability);
+    } else if (optional.kind == X86_CRUCIBLE_OPTIONAL_ZMM_UPPER) {
+        capability->width_bits = 256;
+        capability->group = CRUCIBLE_REG_GROUP_VECTOR;
+        x86_crucible_all_writable(capability);
+    } else if (optional.kind == X86_CRUCIBLE_OPTIONAL_ZMM_HIGH) {
+        capability->width_bits = 512;
+        capability->group = CRUCIBLE_REG_GROUP_VECTOR;
+        x86_crucible_all_writable(capability);
+    } else if (optional.kind == X86_CRUCIBLE_OPTIONAL_OPMASK) {
+        capability->width_bits = 64;
+        capability->group = CRUCIBLE_REG_GROUP_VECTOR;
+        x86_crucible_all_writable(capability);
+    } else if (optional.kind == X86_CRUCIBLE_OPTIONAL_PKRU) {
+        capability->width_bits = 32;
+        capability->group = CRUCIBLE_REG_GROUP_SYSTEM;
+        capability->side_effects = CRUCIBLE_REG_SIDE_TLB;
+        x86_crucible_all_writable(capability);
+    }
+    return capability->name != NULL;
+}
+
+bool x86_crucible_register_describe_into(
+    CPUState *cs, size_t index, const CrucibleCPURegisterGeometry *expected,
+    const CrucibleCPURegisterKeyView *keys,
+    const CrucibleCPURegisterBuffers *buffers,
+    CrucibleCPURegisterCapability *out)
+{
+    CrucibleCPURegisterGeometry current;
+    CrucibleCPURegisterCapability capability;
+    size_t name_bytes;
+    uint32_t width_bits;
+
+    if (!out || !x86_crucible_register_geometry(cs, &current) ||
+        !crucible_register_geometry_equal(expected, &current) ||
+        !x86_crucible_register_keys_current(cs, keys, &current) ||
+        !x86_crucible_register_shape(cs, index, keys, NULL, 0,
+                                          &name_bytes, &width_bits) ||
+        !crucible_register_buffers_fit(buffers, name_bytes,
+                                      ((uint64_t)width_bits + 7) / 8) ||
+        !crucible_register_output_spans(buffers, name_bytes,
+                                       ((uint64_t)width_bits + 7) / 8,
+                                       expected, keys, out)) {
+        return false;
+    }
+    if (!x86_crucible_register_shape(cs, index, keys,
+                                          buffers->name, buffers->name_capacity,
+                                          &name_bytes, &width_bits) ||
+        !x86_crucible_register_describe_prepaid(cs, index, keys,
+                                              buffers, &capability)) {
+        return false;
+    }
+    *out = capability;
+    return true;
+}
+
+bool x86_crucible_register_describe(
+    CPUState *cs, size_t index, CrucibleCPURegisterCapability *out)
+{
+    CrucibleCPURegisterGeometry geometry;
+    CrucibleCPURegisterKeyView view;
+    CrucibleCPURegisterCapability capability;
+    CrucibleCPURegisterBuffers buffers;
+    g_autofree uint32_t *keys = NULL;
+    size_t name_bytes, mask_bytes;
+    uint32_t width_bits;
+
+    if (!out || !x86_crucible_register_geometry(cs, &geometry) ||
+        index >= geometry.register_count) {
+        return false;
+    }
+    if (geometry.key_count > SIZE_MAX / sizeof(*keys)) {
+        return false;
+    }
+    if (geometry.key_count) {
+        keys = g_new(uint32_t, geometry.key_count);
+    }
+    if (!x86_crucible_register_keys_into(cs, keys, geometry.key_count, &view) ||
+        !x86_crucible_register_shape(cs, index, &view, NULL, 0,
+                                          &name_bytes, &width_bits)) {
+        return false;
+    }
+    mask_bytes = ((uint64_t)width_bits + 7) / 8;
+    buffers = (CrucibleCPURegisterBuffers) {
+        .name = g_malloc(name_bytes), .name_capacity = name_bytes,
+        .writable_mask = g_malloc0(mask_bytes),
+        .reserved_mask = g_malloc0(mask_bytes),
+        .ignored_mask = g_malloc0(mask_bytes),
+        .read_only_mask = g_malloc0(mask_bytes),
+        .mask_capacity = mask_bytes,
+    };
+    if (!x86_crucible_register_describe_into(cs, index, &geometry, &view,
+                                              &buffers, &capability)) {
+        g_free(buffers.name);
+        g_free(buffers.writable_mask);
+        g_free(buffers.reserved_mask);
+        g_free(buffers.ignored_mask);
+        g_free(buffers.read_only_mask);
+        return false;
+    }
+    *out = capability;
+    return true;
+}
+
+static int x86_crucible_exact_length(CPUX86State *env, uint32_t id)
+{
+    X86CrucibleOptionalRegister optional =
+        x86_crucible_optional_register(env, id);
+
+    if (id >= X86_CRUCIBLE_ST_FIRST && id <= X86_CRUCIBLE_ST_LAST) {
+        return 10;
+    }
+    if (id >= X86_CRUCIBLE_XMM_FIRST && id <= X86_CRUCIBLE_XMM_LAST) {
+        return 16;
+    }
+    if ((id >= X86_CRUCIBLE_SEG_FIRST && id <= X86_CRUCIBLE_SEG_LAST &&
+         (id - X86_CRUCIBLE_SEG_FIRST) % 4 == 0) ||
+        (id >= X86_CRUCIBLE_FPU_CONTROL && id <= X86_CRUCIBLE_FPU_OPCODE &&
+         id != X86_CRUCIBLE_FPU_TAG)) {
+        return 2;
+    }
+    if (id == X86_CRUCIBLE_FPU_TAG) {
+        return 1;
+    }
+    if (id >= X86_CRUCIBLE_SEG_FIRST && id <= X86_CRUCIBLE_SEG_LAST &&
+        (id - X86_CRUCIBLE_SEG_FIRST) % 4 >= 2) {
+        return 4;
+    }
+    if (id == X86_CRUCIBLE_MXCSR) {
+        return 4;
+    }
+    if (id == X86_CRUCIBLE_RFLAGS) {
+        return 4;
+    }
+    switch (optional.kind) {
+    case X86_CRUCIBLE_OPTIONAL_SYSENTER_CS:
+    case X86_CRUCIBLE_OPTIONAL_TSC_AUX:
+        return 4;
+    case X86_CRUCIBLE_OPTIONAL_YMM_UPPER:
+        return 16;
+    case X86_CRUCIBLE_OPTIONAL_ZMM_UPPER:
+        return 32;
+    case X86_CRUCIBLE_OPTIONAL_ZMM_HIGH:
+        return 64;
+    case X86_CRUCIBLE_OPTIONAL_PKRU:
+        return 4;
+    default:
+        break;
+    }
+    return 8;
+}
+
+int x86_crucible_register_read(
+    CPUState *cs, uint32_t id, uint8_t *value, size_t value_len)
+{
+    X86CPU *cpu = X86_CPU(cs);
+    CPUX86State *env = &cpu->env;
+    int expected = x86_crucible_exact_length(env, id);
+    uint64_t result = 0;
+    X86CrucibleOptionalRegister optional =
+        x86_crucible_optional_register(env, id);
+
+    if (!value || id == 0 ||
+        id > x86_crucible_register_count_for_env(env) ||
+        value_len != expected) {
+        return -EINVAL;
+    }
+    if (id >= X86_CRUCIBLE_GPR_FIRST && id <= X86_CRUCIBLE_GPR_LAST) {
+        result = env->regs[x86_crucible_gpr_map[id - 1]];
+    } else if (id == X86_CRUCIBLE_RIP) {
+        result = env->eip;
+    } else if (id == X86_CRUCIBLE_RFLAGS) {
+        result = cpu_compute_eflags(env);
+    } else if (id >= X86_CRUCIBLE_SEG_FIRST && id <= X86_CRUCIBLE_SEG_LAST) {
+        uint32_t relative = id - X86_CRUCIBLE_SEG_FIRST;
+        SegmentCache *segment = &env->segs[x86_crucible_segment_map[relative / 4]];
+
+        switch (relative % 4) {
+        case 0: result = segment->selector; break;
+        case 1: result = segment->base; break;
+        case 2: result = segment->limit; break;
+        case 3: result = segment->flags; break;
+        }
+    } else if (id == X86_CRUCIBLE_KERNEL_GS_BASE) {
+        result = env->kernelgsbase;
+    } else if (id >= X86_CRUCIBLE_CR0 && id <= X86_CRUCIBLE_CR4) {
+        static const int cr_map[4] = { 0, 2, 3, 4 };
+        result = env->cr[cr_map[id - X86_CRUCIBLE_CR0]];
+    } else if (id == X86_CRUCIBLE_CR8) {
+        int tpr = cpu_get_apic_tpr(cpu->apic_state);
+
+        if (tpr < 0) {
+            return tpr;
+        }
+        result = tpr;
+    } else if (id == X86_CRUCIBLE_EFER) {
+        result = env->efer;
+    } else if (id >= X86_CRUCIBLE_DR_FIRST && id <= X86_CRUCIBLE_DR_LAST) {
+        result = env->dr[id - X86_CRUCIBLE_DR_FIRST];
+    } else if (id >= X86_CRUCIBLE_ST_FIRST && id <= X86_CRUCIBLE_ST_LAST) {
+        size_t fp_index =
+            (id - X86_CRUCIBLE_ST_FIRST + env->fpstt) % 8;
+        floatx80 *fp = &env->fpregs[fp_index].d;
+
+        if (env->fptags[fp_index] != 0) {
+            memset(value, 0, expected);
+            return expected;
+        }
+        stq_le_p(value, fp->low);
+        stw_le_p(value + 8, fp->high);
+        return expected;
+    } else if (id >= X86_CRUCIBLE_MM_FIRST && id <= X86_CRUCIBLE_MM_LAST) {
+        size_t fp_index = id - X86_CRUCIBLE_MM_FIRST;
+
+        /*
+         * MMX instructions enter MMX mode before reading the aliased physical
+         * register file, so an x87 empty tag does not erase these bytes.  The
+         * tag word is exposed separately and must not hide future MMX input.
+         */
+        result = x86_crucible_mmx_register_value(env, fp_index);
+    } else if (id == X86_CRUCIBLE_FPU_CONTROL) {
+        result = env->fpuc;
+    } else if (id == X86_CRUCIBLE_FPU_STATUS) {
+        result = (env->fpus & ~0x3800) | ((env->fpstt & 7) << 11);
+    } else if (id == X86_CRUCIBLE_FPU_TAG) {
+        result = x86_crucible_fpu_abridged_tag(env);
+    } else if (id == X86_CRUCIBLE_FPU_OPCODE) {
+        result = env->fpop;
+    } else if (id == X86_CRUCIBLE_FPU_IP) {
+        result = env->fpip;
+    } else if (id == X86_CRUCIBLE_FPU_DP) {
+        result = env->fpdp;
+    } else if (id >= X86_CRUCIBLE_XMM_FIRST && id <= X86_CRUCIBLE_XMM_LAST) {
+        ZMMReg *reg = &env->xmm_regs[id - X86_CRUCIBLE_XMM_FIRST];
+        stq_le_p(value, reg->ZMM_Q(0));
+        stq_le_p(value + 8, reg->ZMM_Q(1));
+        return expected;
+    } else if (id == X86_CRUCIBLE_MXCSR) {
+        result = cpu_get_mxcsr(env);
+    } else if (optional.kind == X86_CRUCIBLE_OPTIONAL_SYSENTER_CS) {
+        result = env->sysenter_cs;
+    } else if (optional.kind == X86_CRUCIBLE_OPTIONAL_SYSENTER_ESP) {
+        result = env->sysenter_esp;
+    } else if (optional.kind == X86_CRUCIBLE_OPTIONAL_SYSENTER_EIP) {
+        result = env->sysenter_eip;
+    } else if (optional.kind == X86_CRUCIBLE_OPTIONAL_STAR) {
+        result = env->star;
+    } else if (optional.kind == X86_CRUCIBLE_OPTIONAL_LSTAR) {
+        result = env->lstar;
+    } else if (optional.kind == X86_CRUCIBLE_OPTIONAL_CSTAR) {
+        result = env->cstar;
+    } else if (optional.kind == X86_CRUCIBLE_OPTIONAL_FMASK) {
+        result = env->fmask;
+    } else if (optional.kind == X86_CRUCIBLE_OPTIONAL_PAT) {
+        result = env->pat;
+    } else if (optional.kind == X86_CRUCIBLE_OPTIONAL_TSC_AUX) {
+        result = env->tsc_aux;
+    } else if (optional.kind == X86_CRUCIBLE_OPTIONAL_YMM_UPPER) {
+        ZMMReg *reg = &env->xmm_regs[optional.index];
+        stq_le_p(value, reg->ZMM_Q(2));
+        stq_le_p(value + 8, reg->ZMM_Q(3));
+        return expected;
+    } else if (optional.kind == X86_CRUCIBLE_OPTIONAL_ZMM_UPPER) {
+        ZMMReg *reg = &env->xmm_regs[optional.index];
+        for (size_t q = 0; q < 4; q++) {
+            stq_le_p(value + q * 8, reg->ZMM_Q(q + 4));
+        }
+        return expected;
+    } else if (optional.kind == X86_CRUCIBLE_OPTIONAL_ZMM_HIGH) {
+        ZMMReg *reg = &env->xmm_regs[optional.index];
+        for (size_t q = 0; q < 8; q++) {
+            stq_le_p(value + q * 8, reg->ZMM_Q(q));
+        }
+        return expected;
+    } else if (optional.kind == X86_CRUCIBLE_OPTIONAL_OPMASK) {
+        result = env->opmask_regs[optional.index];
+    } else if (optional.kind == X86_CRUCIBLE_OPTIONAL_PKRU) {
+        result = env->pkru;
+    }
+    if (expected == 1) {
+        value[0] = result;
+    } else if (expected == 2) {
+        stw_le_p(value, result);
+    } else if (expected == 4) {
+        stl_le_p(value, result);
+    } else {
+        stq_le_p(value, result);
+    }
+    return expected;
+}
+
+int x86_crucible_register_validate_write(
+    CPUState *cs, uint32_t id, const uint8_t *value, size_t value_len)
+{
+    X86CPU *cpu = X86_CPU(cs);
+    CPUX86State *env = &cpu->env;
+    int expected = x86_crucible_exact_length(env, id);
+    uint64_t input;
+    X86CrucibleOptionalRegister optional =
+        x86_crucible_optional_register(env, id);
+
+    if (!value || id == 0 ||
+        id > x86_crucible_register_count_for_env(env) ||
+        value_len != expected ||
+        (id >= X86_CRUCIBLE_DR_FIRST + 4 &&
+         id <= X86_CRUCIBLE_DR_FIRST + 5)) {
+        return -EINVAL;
+    }
+    input = expected == 1 ? value[0] :
+        (expected == 2 ? lduw_le_p(value) :
+         (expected == 4 ? ldl_le_p(value) : ldq_le_p(value)));
+    if (id == X86_CRUCIBLE_CR0 &&
+        (((input & CR0_PG_MASK) && !(input & CR0_PE_MASK)) ||
+         ((input & CR0_NW_MASK) && !(input & CR0_CD_MASK)) ||
+         (!(env->cr[0] & CR0_PG_MASK) && (input & CR0_PG_MASK) &&
+          (env->efer & MSR_EFER_LME) &&
+          !(env->cr[4] & CR4_PAE_MASK)))) {
+        return -EINVAL;
+    }
+    if (id == X86_CRUCIBLE_CR3 &&
+        (((env->efer & MSR_EFER_LMA) && X86_CPU(cs)->phys_bits < 64 &&
+          (input >> X86_CPU(cs)->phys_bits) != 0) ||
+         (!(env->efer & MSR_EFER_LMA) && input > UINT32_MAX) ||
+         (!(env->cr[4] & CR4_PCIDE_MASK) &&
+          (input & UINT64_C(0xfe7)) != 0))) {
+        return -EINVAL;
+    }
+    if (id == X86_CRUCIBLE_CR4 &&
+        ((input ^ env->cr[4]) & CR4_LA57_MASK) &&
+        (env->hflags & HF_CS64_MASK)) {
+        return -EINVAL;
+    }
+    if (id == X86_CRUCIBLE_EFER &&
+        ((input ^ env->efer) & MSR_EFER_LME) &&
+        (env->cr[0] & CR0_PG_MASK)) {
+        return -EINVAL;
+    }
+    if (id >= X86_CRUCIBLE_SEG_FIRST && id <= X86_CRUCIBLE_SEG_LAST &&
+        (id - X86_CRUCIBLE_SEG_FIRST) % 4 == 3 &&
+        (input & DESC_L_MASK) &&
+        (!(input & DESC_S_MASK) || !(input & DESC_CS_MASK) ||
+         (input & DESC_B_MASK))) {
+        return -EINVAL;
+    }
+    if (optional.kind == X86_CRUCIBLE_OPTIONAL_PAT) {
+        for (size_t entry = 0; entry < 8; entry++) {
+            uint8_t memory_type = input >> (entry * 8);
+
+            if (memory_type > 7 || memory_type == 2 || memory_type == 3) {
+                return -EINVAL;
+            }
+        }
+    }
+    return expected;
+}
+
+int x86_crucible_register_write(
+    CPUState *cs, uint32_t id, const uint8_t *value,
+    size_t value_len, uint32_t *performed_side_effects)
+{
+    X86CPU *cpu = X86_CPU(cs);
+    CPUX86State *env = &cpu->env;
+    int expected = x86_crucible_exact_length(env, id);
+    uint64_t input;
+    uint32_t effects = 0;
+    X86CrucibleOptionalRegister optional =
+        x86_crucible_optional_register(env, id);
+
+    if (!performed_side_effects ||
+        x86_crucible_register_validate_write(
+            cs, id, value, value_len) != expected) {
+        return -EINVAL;
+    }
+    input = expected == 1 ? value[0] :
+        (expected == 2 ? lduw_le_p(value) :
+         (expected == 4 ? ldl_le_p(value) : ldq_le_p(value)));
+    if (id >= X86_CRUCIBLE_GPR_FIRST && id <= X86_CRUCIBLE_GPR_LAST) {
+        env->regs[x86_crucible_gpr_map[id - 1]] = input;
+    } else if (id == X86_CRUCIBLE_RIP) {
+        env->eip = input;
+        effects = CRUCIBLE_REG_SIDE_TB | CRUCIBLE_REG_SIDE_CONTROL_FLOW;
+    } else if (id == X86_CRUCIBLE_RFLAGS) {
+        cpu_load_eflags(env, input, 0x003f7fd5U);
+        effects = CRUCIBLE_REG_SIDE_TB | CRUCIBLE_REG_SIDE_FLAGS |
+            CRUCIBLE_REG_SIDE_INTERRUPT;
+    } else if (id >= X86_CRUCIBLE_SEG_FIRST && id <= X86_CRUCIBLE_SEG_LAST) {
+        uint32_t relative = id - X86_CRUCIBLE_SEG_FIRST;
+        X86Seg sreg = x86_crucible_segment_map[relative / 4];
+        SegmentCache segment = env->segs[sreg];
+
+        switch (relative % 4) {
+        case 0: segment.selector = input; break;
+        case 1: segment.base = input; break;
+        case 2: segment.limit = input; break;
+        case 3: segment.flags = input; break;
+        }
+        cpu_x86_load_seg_cache(env, sreg, segment.selector, segment.base,
+                               segment.limit, segment.flags);
+        effects = CRUCIBLE_REG_SIDE_TLB | CRUCIBLE_REG_SIDE_TB |
+            CRUCIBLE_REG_SIDE_FLAGS | CRUCIBLE_REG_SIDE_INTERRUPT;
+    } else if (id == X86_CRUCIBLE_KERNEL_GS_BASE) {
+        env->kernelgsbase = input;
+        effects = CRUCIBLE_REG_SIDE_TLB | CRUCIBLE_REG_SIDE_TB;
+    } else if (id == X86_CRUCIBLE_CR0) {
+        if (((input & CR0_PG_MASK) && !(input & CR0_PE_MASK)) ||
+            ((input & CR0_NW_MASK) && !(input & CR0_CD_MASK)) ||
+            (!(env->cr[0] & CR0_PG_MASK) && (input & CR0_PG_MASK) &&
+             (env->efer & MSR_EFER_LME) &&
+             !(env->cr[4] & CR4_PAE_MASK))) {
+            goto invalid;
+        }
+        cpu_x86_update_cr0(env, input);
+        effects = CRUCIBLE_REG_SIDE_TLB | CRUCIBLE_REG_SIDE_TB |
+            CRUCIBLE_REG_SIDE_FLAGS;
+    } else if (id == X86_CRUCIBLE_CR2) {
+        env->cr[2] = input;
+    } else if (id == X86_CRUCIBLE_CR3) {
+        if (((env->efer & MSR_EFER_LMA) && X86_CPU(cs)->phys_bits < 64 &&
+             (input >> X86_CPU(cs)->phys_bits) != 0) ||
+            (!(env->efer & MSR_EFER_LMA) && input > UINT32_MAX) ||
+            (!(env->cr[4] & CR4_PCIDE_MASK) &&
+             (input & UINT64_C(0xfe7)) != 0)) {
+            goto invalid;
+        }
+        cpu_x86_update_cr3(env, input);
+        effects = CRUCIBLE_REG_SIDE_TLB;
+    } else if (id == X86_CRUCIBLE_CR4) {
+        if (((input ^ env->cr[4]) & CR4_LA57_MASK) &&
+            (env->hflags & HF_CS64_MASK)) {
+            goto invalid;
+        }
+        cpu_x86_update_cr4(env, input);
+        effects = CRUCIBLE_REG_SIDE_TLB | CRUCIBLE_REG_SIDE_TB |
+            CRUCIBLE_REG_SIDE_FLAGS;
+    } else if (id == X86_CRUCIBLE_CR8) {
+        if (!(env->hflags2 & HF2_VINTR_MASK)) {
+            bql_lock();
+            cpu_set_apic_tpr(cpu->apic_state, input);
+            bql_unlock();
+        }
+        env->int_ctl = (env->int_ctl & ~V_TPR_MASK) | (input & V_TPR_MASK);
+        if (ctl_has_irq(env)) {
+            cpu_interrupt(cs, CPU_INTERRUPT_VIRQ);
+        } else {
+            cpu_reset_interrupt(cs, CPU_INTERRUPT_VIRQ);
+        }
+        effects = CRUCIBLE_REG_SIDE_INTERRUPT;
+    } else if (id == X86_CRUCIBLE_EFER) {
+        if (((input ^ env->efer) & MSR_EFER_LME) &&
+            (env->cr[0] & CR0_PG_MASK)) {
+            goto invalid;
+        }
+        cpu_load_efer(env, input);
+        effects = CRUCIBLE_REG_SIDE_TLB | CRUCIBLE_REG_SIDE_TB |
+            CRUCIBLE_REG_SIDE_FLAGS;
+    } else if (id >= X86_CRUCIBLE_DR_FIRST &&
+               id <= X86_CRUCIBLE_DR_FIRST + 3) {
+        uint32_t reg = id - X86_CRUCIBLE_DR_FIRST;
+        uint32_t enable_mask = 3U << (reg * 2);
+        uint32_t old_dr7 = env->dr[7];
+
+        cpu_x86_update_dr7(env, old_dr7 & ~enable_mask);
+        env->dr[reg] = input;
+        cpu_x86_update_dr7(env, old_dr7);
+        effects = CRUCIBLE_REG_SIDE_TB |
+            CRUCIBLE_REG_SIDE_CONTROL_FLOW;
+    } else if (id == X86_CRUCIBLE_DR_FIRST + 6) {
+        env->dr[6] = input | DR6_FIXED_1;
+        effects = CRUCIBLE_REG_SIDE_TB |
+            CRUCIBLE_REG_SIDE_CONTROL_FLOW;
+    } else if (id == X86_CRUCIBLE_DR_FIRST + 7) {
+        cpu_x86_update_dr7(env, input);
+        effects = CRUCIBLE_REG_SIDE_TB |
+            CRUCIBLE_REG_SIDE_CONTROL_FLOW;
+    } else if (id >= X86_CRUCIBLE_ST_FIRST && id <= X86_CRUCIBLE_ST_LAST) {
+        floatx80 *fp = &env->fpregs[(id - X86_CRUCIBLE_ST_FIRST +
+                                     env->fpstt) % 8].d;
+        fp->low = ldq_le_p(value);
+        fp->high = lduw_le_p(value + 8);
+    } else if (id >= X86_CRUCIBLE_MM_FIRST && id <= X86_CRUCIBLE_MM_LAST) {
+        env->fpregs[id - X86_CRUCIBLE_MM_FIRST].mmx._q_MMXReg[0] = input;
+    } else if (id == X86_CRUCIBLE_FPU_CONTROL) {
+        cpu_set_fpuc(env, input);
+        effects = CRUCIBLE_REG_SIDE_FLAGS;
+    } else if (id == X86_CRUCIBLE_FPU_STATUS) {
+        env->fpstt = (input >> 11) & 7;
+        env->fpus = input & ~0x3800;
+        effects = CRUCIBLE_REG_SIDE_FLAGS;
+    } else if (id == X86_CRUCIBLE_FPU_TAG) {
+        for (size_t i = 0; i < 8; i++) {
+            env->fptags[i] = (input >> i) & 1;
+        }
+        effects = CRUCIBLE_REG_SIDE_FLAGS;
+    } else if (id == X86_CRUCIBLE_FPU_OPCODE) {
+        env->fpop = input;
+    } else if (id == X86_CRUCIBLE_FPU_IP) {
+        env->fpip = input;
+    } else if (id == X86_CRUCIBLE_FPU_DP) {
+        env->fpdp = input;
+    } else if (id >= X86_CRUCIBLE_XMM_FIRST && id <= X86_CRUCIBLE_XMM_LAST) {
+        ZMMReg *reg = &env->xmm_regs[id - X86_CRUCIBLE_XMM_FIRST];
+        reg->ZMM_Q(0) = ldq_le_p(value);
+        reg->ZMM_Q(1) = ldq_le_p(value + 8);
+    } else if (id == X86_CRUCIBLE_MXCSR) {
+        cpu_set_mxcsr(env, input);
+        effects = CRUCIBLE_REG_SIDE_FLAGS;
+    } else if (optional.kind == X86_CRUCIBLE_OPTIONAL_SYSENTER_CS) {
+        env->sysenter_cs = input & UINT16_MAX;
+        effects = CRUCIBLE_REG_SIDE_TB |
+            CRUCIBLE_REG_SIDE_CONTROL_FLOW;
+    } else if (optional.kind == X86_CRUCIBLE_OPTIONAL_SYSENTER_ESP) {
+        env->sysenter_esp = input;
+        effects = CRUCIBLE_REG_SIDE_TB |
+            CRUCIBLE_REG_SIDE_CONTROL_FLOW;
+    } else if (optional.kind == X86_CRUCIBLE_OPTIONAL_SYSENTER_EIP) {
+        env->sysenter_eip = input;
+        effects = CRUCIBLE_REG_SIDE_TB |
+            CRUCIBLE_REG_SIDE_CONTROL_FLOW;
+    } else if (optional.kind == X86_CRUCIBLE_OPTIONAL_STAR) {
+        env->star = input;
+        effects = CRUCIBLE_REG_SIDE_TB |
+            CRUCIBLE_REG_SIDE_CONTROL_FLOW;
+    } else if (optional.kind == X86_CRUCIBLE_OPTIONAL_LSTAR) {
+        env->lstar = input;
+        effects = CRUCIBLE_REG_SIDE_TB |
+            CRUCIBLE_REG_SIDE_CONTROL_FLOW;
+    } else if (optional.kind == X86_CRUCIBLE_OPTIONAL_CSTAR) {
+        env->cstar = input;
+        effects = CRUCIBLE_REG_SIDE_TB |
+            CRUCIBLE_REG_SIDE_CONTROL_FLOW;
+    } else if (optional.kind == X86_CRUCIBLE_OPTIONAL_FMASK) {
+        env->fmask = input;
+        effects = CRUCIBLE_REG_SIDE_TB |
+            CRUCIBLE_REG_SIDE_CONTROL_FLOW;
+    } else if (optional.kind == X86_CRUCIBLE_OPTIONAL_PAT) {
+        for (size_t entry = 0; entry < 8; entry++) {
+            uint8_t memory_type = input >> (entry * 8);
+
+            if (memory_type > 7 || memory_type == 2 || memory_type == 3) {
+                goto invalid;
+            }
+        }
+        env->pat = input;
+        effects = CRUCIBLE_REG_SIDE_TLB;
+    } else if (optional.kind == X86_CRUCIBLE_OPTIONAL_TSC_AUX) {
+        env->tsc_aux = input;
+    } else if (optional.kind == X86_CRUCIBLE_OPTIONAL_YMM_UPPER) {
+        ZMMReg *reg = &env->xmm_regs[optional.index];
+        reg->ZMM_Q(2) = ldq_le_p(value);
+        reg->ZMM_Q(3) = ldq_le_p(value + 8);
+    } else if (optional.kind == X86_CRUCIBLE_OPTIONAL_ZMM_UPPER) {
+        ZMMReg *reg = &env->xmm_regs[optional.index];
+        for (size_t q = 0; q < 4; q++) {
+            reg->ZMM_Q(q + 4) = ldq_le_p(value + q * 8);
+        }
+    } else if (optional.kind == X86_CRUCIBLE_OPTIONAL_ZMM_HIGH) {
+        ZMMReg *reg = &env->xmm_regs[optional.index];
+        for (size_t q = 0; q < 8; q++) {
+            reg->ZMM_Q(q) = ldq_le_p(value + q * 8);
+        }
+    } else if (optional.kind == X86_CRUCIBLE_OPTIONAL_OPMASK) {
+        env->opmask_regs[optional.index] = input;
+    } else if (optional.kind == X86_CRUCIBLE_OPTIONAL_PKRU) {
+        env->pkru = input;
+        effects = CRUCIBLE_REG_SIDE_TLB;
+    } else {
+        goto invalid;
+    }
+    if (effects & CRUCIBLE_REG_SIDE_TLB) {
+        tlb_flush(cs);
+    }
+    if (effects & CRUCIBLE_REG_SIDE_TB) {
+        tb_flush__exclusive_or_serial();
+    }
+    if (effects & CRUCIBLE_REG_SIDE_CONTROL_FLOW) {
+        cpu_exit(cs);
+    }
+    *performed_side_effects = effects;
+    return expected;
+
+invalid:
+    return -EINVAL;
+}
+
+static bool x86_crucible_register_access_current(
+    CPUState *cs, uint32_t id,
+    const CrucibleCPURegisterGeometry *expected,
+    const CrucibleCPURegisterKeyView *keys,
+    const uint8_t *value, size_t value_len, uint32_t *effects)
+{
+    CrucibleCPURegisterGeometry current;
+    size_t name_bytes;
+    uint32_t width_bits;
+
+    return cs && crucible_register_value_spans(
+        value, value_len, expected, keys, effects, X86_CPU(cs), sizeof(X86CPU)) &&
+        x86_crucible_register_geometry(cs, &current) &&
+        crucible_register_geometry_equal(expected, &current) &&
+        x86_crucible_register_keys_current(cs, keys, &current) &&
+        id && id <= current.register_count &&
+        x86_crucible_register_shape(cs, id - 1, keys, NULL, 0,
+            &name_bytes, &width_bits) &&
+        value_len == ((uint64_t)width_bits + 7) / 8;
+}
+
+int x86_crucible_register_read_into(
+    CPUState *cs, uint32_t id,
+    const CrucibleCPURegisterGeometry *geometry,
+    const CrucibleCPURegisterKeyView *keys, uint8_t *value, size_t value_len)
+{
+    if (!x86_crucible_register_access_current(
+            cs, id, geometry, keys, value, value_len, NULL)) {
+        return -EINVAL;
+    }
+    return x86_crucible_register_read(cs, id, value, value_len);
+}
+
+int x86_crucible_register_validate_write_into(
+    CPUState *cs, uint32_t id,
+    const CrucibleCPURegisterGeometry *geometry,
+    const CrucibleCPURegisterKeyView *keys,
+    const uint8_t *value, size_t value_len)
+{
+    if (!x86_crucible_register_access_current(
+            cs, id, geometry, keys, value, value_len, NULL)) {
+        return -EINVAL;
+    }
+    return x86_crucible_register_validate_write(cs, id, value, value_len);
+}
+
+int x86_crucible_register_write_into(
+    CPUState *cs, uint32_t id,
+    const CrucibleCPURegisterGeometry *geometry,
+    const CrucibleCPURegisterKeyView *keys,
+    const uint8_t *value, size_t value_len, uint32_t *performed_side_effects)
+{
+    if (!performed_side_effects || !x86_crucible_register_access_current(
+            cs, id, geometry, keys, value, value_len, performed_side_effects)) {
+        return -EINVAL;
+    }
+    return x86_crucible_register_write(
+        cs, id, value, value_len, performed_side_effects);
+}
+
+#endif /* TARGET_X86_64 */
