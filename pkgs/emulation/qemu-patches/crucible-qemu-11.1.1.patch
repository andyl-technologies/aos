+static int checkpoint_inventory_alias_close(
+    struct QemuCrucibleCheckpointInventoryOutput *alias)
+{
+    int fd;
+
+    if (alias->close_attempted) {
+        return alias->close_status;
+    }
+    if (!alias->held) {
+        return 0;
+    }
+    fd = alias->fd;
+    alias->fd = -1;
+    alias->close_attempted = true;
+    if (close(fd) < 0) {
+        alias->close_status = -errno;
+        alias->close_uncertain = true;
+        return alias->close_status;
+    }
+    alias->held = false;
+    return 0;
+}
