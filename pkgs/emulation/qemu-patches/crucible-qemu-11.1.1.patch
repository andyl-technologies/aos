+_native_link_snapshot = None
+_native_link_provider = None
+_native_link_provider_inputs = None
+
+
+def native_link_file_identity(path):
+    """Authenticate a live input's canonical path and physical identity."""
+    resolved = path.resolve(strict=True)
+    status = resolved.stat()
+    if not resolved.is_file():
+        raise ValueError(f"configured native input is not a file: {path}")
+    return (resolved, status.st_dev, status.st_ino, status.st_mode,
+            status.st_size, status.st_mtime_ns, status.st_ctime_ns)
+
+
+def native_link_arguments():
+    """Reauthenticate the complete provider using process-local metadata decoding."""
+    global _native_link_provider, _native_link_provider_inputs, _native_link_snapshot
+
+    build_dir = (ROOT / "build").resolve(strict=True)
+    compiler = tuple(shlex.split(os.environ["CC"]))
+    status = build_dir.stat()
+    identity = (build_dir, status.st_dev, status.st_ino, compiler)
+    module_paths = (Path(__file__).with_name("test-crucible-ram-worker-inventory.py"),
+                    Path(__file__).with_name("extract-crucible-startup-source-controls.py"))
+    module_inputs = tuple((native_link_file_identity(path),
+                           hashlib.sha256(path.read_bytes()).digest())
+                          for path in module_paths)
+    if _native_link_provider is None:
+        _native_link_provider = runpy.run_path(str(module_paths[0]))
+        _native_link_provider_inputs = module_inputs
+    if module_inputs != _native_link_provider_inputs:
+        raise ValueError("configured native provider module changed")
+    # Every invocation checks all configured output resolutions, actual source
+    # membership, compiler identity, provider existence and support closure.
+    # Only JSON decoding and unchanged command tokenization are retained.
+    build = _native_link_provider["provider_build"](build_dir, list(compiler))
+    arguments = [*(str(path) for path in build["support_objects"]),
+                 *build["parameters"]]
+    if _native_link_snapshot is None:
+        compiler_path = shutil.which(compiler[0])
+        if compiler_path is None:
+            raise ValueError("configured native compiler is unavailable")
+        paths = {Path(compiler_path), ROOT / "util/qemu-thread-posix.c",
+                 build["provider_object"], *build["support_objects"]}
+        entries, _ = _native_link_provider["provider_metadata"](build_dir)
+        objects = {build["provider_object"], *build["support_objects"]}
+        for entry in entries:
+            output = _native_link_provider["configured_output"](entry, build_dir)
+            if output in objects:
+                paths.add(build_dir / entry["file"])
+        for argument in build["parameters"]:
+            path = build_dir / argument
+            if not argument.startswith("-") and path.is_file():
+                paths.add(path)
+        files = tuple((path, native_link_file_identity(path))
+                      for path in sorted(paths))
+        _native_link_snapshot = (identity, tuple(arguments), files)
+    saved_identity, saved_arguments, files = _native_link_snapshot
+    if identity != saved_identity or tuple(arguments) != saved_arguments:
+        raise ValueError("configured native provider or compiler identity changed")
+    for path, expected in files:
+        if native_link_file_identity(path) != expected:
+            raise ValueError(f"configured native provider input changed: {path}")
+    return list(arguments)
+
+
+def utility_sources():
+    """Use matched generic Error cleanup and the real ordinary notifier list."""
+    return [str(ROOT / path) for path in (
+        "util/error.c", "stubs/crucible-qmp-allocation.c", "util/notify.c",
+    )]
