+static void test_timer_witness_completes_only_after_callback(void)
+{
+    QemuPluginCrucibleVirtualTimerWitnessState state = { 0 };
+    struct qemu_plugin_crucible_virtual_timer_witness witness;
+    uint64_t firing_generation = 0;
+    uint64_t generation = 0;
+
+    g_assert_cmpint(qemu_plugin_crucible_virtual_timer_witness_arm(
+                        &state, 500, 900, 100, &generation),
+                    ==, 0);
+    g_assert_cmpuint(generation, ==, 1);
+    g_assert_cmpint(qemu_plugin_crucible_virtual_timer_witness_query(
+                        &state, generation, &witness),
+                    ==, -EAGAIN);
+    g_assert_false(qemu_plugin_crucible_virtual_timer_witness_state_begin(
+        &state, 499, 500, 100, &firing_generation));
+    g_assert_true(qemu_plugin_crucible_virtual_timer_witness_state_begin(
+        &state, 500, 504, 100, &firing_generation));
+    g_assert_cmpuint(firing_generation, ==, generation);
+    g_assert_cmpint(qemu_plugin_crucible_virtual_timer_witness_query(
+                        &state, generation, &witness),
+                    ==, -EAGAIN);
+
+    qemu_plugin_crucible_virtual_timer_witness_state_complete(
+        &state, firing_generation);
+
+    g_assert_cmpint(qemu_plugin_crucible_virtual_timer_witness_query(
+                        &state, generation, &witness),
+                    ==, 0);
+    g_assert_cmpuint(witness.generation, ==, generation);
+    g_assert_cmpint(witness.deadline_ps, ==, 500);
+    g_assert_cmpuint(witness.deadline_tick, ==, 900);
+    g_assert_cmpuint(witness.armed_raw_icount, ==, 100);
+    g_assert_cmpint(witness.fired_expire_ps, ==, 500);
+    g_assert_cmpint(witness.fired_virtual_ps, ==, 504);
+    g_assert_cmpuint(witness.fired_raw_icount, ==, 100);
+    g_assert_cmpuint(witness.completed, ==, 1);
+    g_assert_cmpuint(witness.reserved, ==, 0);
+
+    g_test_message("timer_witness generation=1 deadline_ps=500 "
+                   "deadline_tick=900 armed_raw_icount=100 "
+                   "fired_expire_ps=500 fired_virtual_ps=504 "
+                   "fired_raw_icount=100 completed=1 reserved=0");
+}
