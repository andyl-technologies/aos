+/*
+ * Retained physical receive through the first-bound module reader.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifdef CONFIG_LINUX
+static int command_receive_identity_locked(QemuCrucibleCommandReceiveOwner *owner,
+                                           uint64_t serial)
+{
+    QemuCrucibleCommandConsumerMember *member = &startup_source.command_member;
+    uintptr_t field;
+    int status;
+
+    if (owner != &startup_source.command_receive || !serial) {
+        return -EPERM;
+    }
+    if (owner->canonical_owner != owner || !owner->held || owner->returned ||
+        owner->serial != serial || owner->member != member ||
+        owner->reader != member->reader ||
+        owner->lender != startup_source.standing.lender ||
+        owner->process != startup_source.commands.process || !member->receive_users) {
+        return -ESTALE;
+    }
+    status = command_member_identity_locked(member);
+    if (status) {
+        return status;
+    }
+    if (!owner->transferred) {
+        return owner->creation_owner == owner &&
+            owner->holder == &owner->creation_owner ? 0 : -ESTALE;
+    }
+    field = (uintptr_t)owner->runtime_holder;
+    if (owner->creation_owner || owner->holder != owner->runtime_holder ||
+        owner->runtime_base != member->runtime_base ||
+        owner->runtime_extent != member->runtime_extent ||
+        !owner->runtime_base || owner->runtime_extent < sizeof(*owner->runtime_holder) ||
+        owner->runtime_extent > UINTPTR_MAX - owner->runtime_base ||
+        field < owner->runtime_base ||
+        field % _Alignof(QemuCrucibleCommandReceiveOwner *) ||
+        field - owner->runtime_base > owner->runtime_extent - sizeof(*owner->runtime_holder)) {
+        return -ESTALE;
+    }
+    return *owner->runtime_holder == owner ? 0 : -ESTALE;
+}
+
+/* The genuine dispatch owns this observation before any module callback.
+ * Nominate the actual receive at its birth, never by later fact equality. */
+static int ready_delivery_receive_bind_locked(QemuCrucibleCommandReceiveOwner *receive)
+{
+    QemuCrucibleFingerprintIntentObservation *observation = &startup_source.intent_observation;
