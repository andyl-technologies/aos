+static int candidate_capture_current(
+    struct QemuCrucibleCheckpointCandidateCaptureLoan *claim)
+{
+    int status = candidate_capture_identity(claim);
+
+    if (status) {
+        return status;
+    }
+    if (!claim->issued || claim->publication_pending ||
+        claim->topology != qatomic_read(&topology_generation) ||
+        claim->dirty != qatomic_read(&dirty_generation)) {
