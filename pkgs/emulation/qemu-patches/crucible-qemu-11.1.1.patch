+int qemu_plugin_crucible_startup_hello_return_v1(
+    qemu_plugin_id_t id, QemuCrucibleSetupHandshakeOwner **holder)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleSetupHandshakeOwner *owner = &startup_source.setup_handshake;
+    int status = setup_handshake_identity(id, owner);
+
+    if (status) {
+        return status;
+    }
+    if (!startup_owner() || !holder) {
+        return -EPERM;
+    }
+    if (owner->write_active || owner->read_active || owner->io_active ||
+        owner->wait_active || owner->slot_child) {
+        return -EBUSY;
+    }
+    if (owner->transferred) {
+        if (holder != owner->holder) {
+            return -EPERM;
+        }
+    } else if (owner->holder != &owner->creation_owner ||
+               owner->creation_owner != owner) {
+        return -ESTALE;
+    }
+    if (*holder != owner) {
+        return -ESTALE;
+    }
+    /* This returns only the real borrowed initial-exchange lifetime. Source
+     * still retains its endpoint and fixed storage. No close/shutdown, stream
+     * rewind, byte replay, metadata refund or another exchange is performed. */
+    *holder = NULL;
+    owner->creation_owner = NULL;
+    owner->holder = NULL;
+    owner->held = false;
+    return 0;
+#else
+    return -ENOTSUP;
+#endif
+}
