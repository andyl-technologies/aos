+int monitor_qmp_stop_reservation_return(
+    MonitorQmpStopReservation **candidate, Monitor **journal_monitor,
+    int *first_status, int *post_status)
+{
+    MonitorQmpStopReservation *reservation;
+    MonitorQMP *mon;
+    int status;
