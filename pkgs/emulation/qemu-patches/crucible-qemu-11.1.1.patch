+static void test_hot_fork_retained_async_worker_transaction(void)
+{
+    QemuAsyncWorkerHotForkRetainedTransaction transaction = { 0 };
+    QemuAsyncWorkerHotForkBarrierInventory barrier;
+    int child_status;
+    pid_t child;
+
+    qemu_async_worker_hot_fork_barrier(QEMU_ASYNC_WORKER_HOT_FORK_BARRIER_HOLD,
+                                   &barrier);
+    g_assert_true(barrier.held);
+    g_assert_true(barrier.quiescent);
+    g_assert_cmpint(
+        qemu_async_worker_hot_fork_begin_retained_transaction(
+            &transaction, barrier.generation + 1),
+        ==, -EBUSY);
+    g_assert_cmpint(
+        qemu_async_worker_hot_fork_begin_retained_transaction(
+            &transaction, barrier.generation),
+        ==, 0);
+
+    child = fork();
+    g_assert_cmpint(child, >=, 0);
+    if (child == 0) {
+        int result = qemu_async_worker_hot_fork_release_child_retained_transaction(
+            &transaction);
+
+        _exit(result == 0 ? EXIT_SUCCESS : EXIT_FAILURE);
+    }
+
+    g_assert_cmpint(
+        qemu_async_worker_hot_fork_release_parent_retained_transaction(
+            &transaction),
+        ==, 0);
+    qemu_async_worker_hot_fork_barrier(QEMU_ASYNC_WORKER_HOT_FORK_BARRIER_QUERY,
+                                   &barrier);
+    g_assert_true(barrier.held);
+    g_assert_true(barrier.quiescent);
+    g_assert_cmpint(waitpid(child, &child_status, 0), ==, child);
+    g_assert_true(WIFEXITED(child_status));
+    g_assert_cmpint(WEXITSTATUS(child_status), ==, EXIT_SUCCESS);
+
+    qemu_async_worker_hot_fork_barrier(QEMU_ASYNC_WORKER_HOT_FORK_BARRIER_RELEASE,
+                                   &barrier);
+    g_assert_false(barrier.held);
+}
