+/*
+ * A reconstructed child owns live replacements at the target descriptor
+ * slots.  Its inherited stage records describe the already-consumed source
+ * descriptors and must be forgotten without closing those numeric slots.
+ */
+static void crucible_hot_fork_forget_consumed_child_stages(void)
+{
+    uint64_t private_ring_generation =
+        crucible_hot_fork_private_ring_stage.generation;
+    uint64_t diagnostic_generation =
+        crucible_hot_fork_diagnostic_stage.generation;
+    uint64_t qmp_generation = crucible_hot_fork_qmp_stage.generation;
+    uint64_t console_generation = crucible_hot_fork_console_stage.generation;
+    uint64_t endpoint_generation =
+        crucible_hot_fork_plugin_endpoint_stage.generation;
+    uint64_t process_contract_generation =
+        crucible_hot_fork_child_process_contract_stage.generation;
+
+    g_clear_pointer(&crucible_hot_fork_private_ring_stage.fdname, g_free);
+    crucible_hot_fork_private_ring_stage =
+        (CrucibleHotForkPrivateRingStage) {
+            .fd = -1,
+            .generation = private_ring_generation,
+        };
+
+    g_clear_pointer(&crucible_hot_fork_diagnostic_stage.fdname, g_free);
+    crucible_hot_fork_diagnostic_stage = (CrucibleHotForkDiagnosticStage) {
+        .fd = -1,
+        .generation = diagnostic_generation,
+    };
+
+    g_clear_pointer(&crucible_hot_fork_qmp_stage.fdname, g_free);
+    crucible_hot_fork_qmp_stage = (CrucibleHotForkQmpStage) {
+        .fd = -1,
+        .generation = qmp_generation,
+    };
+
+    g_clear_pointer(&crucible_hot_fork_console_stage.fdname, g_free);
+    crucible_hot_fork_console_stage = (CrucibleHotForkConsoleStage) {
+        .fd = -1,
+        .generation = console_generation,
+    };
+
+    g_clear_pointer(
+        &crucible_hot_fork_plugin_endpoint_stage.control_fdname, g_free);
+    g_clear_pointer(
+        &crucible_hot_fork_plugin_endpoint_stage.wake_fdname, g_free);
+    crucible_hot_fork_plugin_endpoint_stage =
+        (CrucibleHotForkPluginEndpointStage) {
+            .control_fd = -1,
+            .wake_fd = -1,
+            .control_target_fd = -1,
+            .wake_target_fd = -1,
+            .generation = endpoint_generation,
+        };
+
+    g_clear_pointer(
+        &crucible_hot_fork_child_process_contract_stage.cgroup_fdname, g_free);
+    g_clear_pointer(
+        &crucible_hot_fork_child_process_contract_stage.cgroup_procs_fdname,
+        g_free);
+    g_clear_pointer(
+        &crucible_hot_fork_child_process_contract_stage.cancellation_fdname,
+        g_free);
+    crucible_hot_fork_child_process_contract_stage =
+        (CrucibleHotForkChildProcessContractStage) {
+            .cgroup_fd = -1,
+            .cgroup_procs_fd = -1,
+            .cancellation_fd = -1,
+            .generation = process_contract_generation,
+        };
+
+    monitor_hot_fork_reset_child_basis(&crucible_hot_fork_qmp_child_basis);
+    crucible_hot_fork_console_child_basis =
+        (QemuChrSocketHotForkChildBasis) { 0 };
+    qemu_crucible_hot_fork_reset_plugin_child_reinitializer(
+        &crucible_hot_fork_plugin_child_reinitializer);
+    qemu_crucible_hot_fork_reset_plugin_child_resources(
+        &crucible_hot_fork_plugin_child_resources);
+    qemu_crucible_hot_fork_reset_diagnostics_child_resources(
+        &crucible_hot_fork_diagnostics_child_resources);
+    qemu_crucible_hot_fork_reset_qmp_child_resources(
+        &crucible_hot_fork_qmp_child_resources);
+    qemu_crucible_hot_fork_reset_qmp_child_reinitializer(
+        &crucible_hot_fork_qmp_child_reinitializer);
+    qemu_crucible_hot_fork_reset_console_child_resources(
+        &crucible_hot_fork_console_child_resources);
+    qemu_crucible_hot_fork_reset_console_child_reinitializer(
+        &crucible_hot_fork_console_child_reinitializer);
+    qemu_crucible_hot_fork_reset_child_resource_plan(
+        &crucible_hot_fork_child_resource_plan);
+}
+
+static bool crucible_hot_fork_adopt_reconstructed_child(Error **errp)
+{
+    QemuPluginCrucibleHotForkChildRuntimeInventory runtime = { 0 };
+    QemuPluginCrucibleHotForkInventory resources = { 0 };
+    CrucibleHotForkQmpState *qmp = NULL;
+    CrucibleHotForkConsoleState *console = NULL;
+    const struct qemu_plugin_crucible_hot_fork_child_status *status;
+    int result;
+
+    if (!crucible_hot_fork_child_active || crucible_hot_fork_template_active ||
+        crucible_hot_fork_operation_active ||
+        crucible_hot_fork_template_phase !=
+            CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_IDLE ||
+        !crucible_hot_fork_exact_paused_boundary()) {
+        error_setg(errp, "Crucible child adoption requires one idle, exactly "
+                   "paused reconstructed child");
+        return false;
+    }
+
+    result = qemu_plugin_crucible_hot_fork_child_runtime(
+        QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_QUERY, NULL, &runtime);
+    qemu_plugin_crucible_hot_fork_inventory(&resources);
+    status = &runtime.status;
+    qmp = crucible_hot_fork_qmp_report();
+    console = crucible_hot_fork_console_report();
+    if (result != 0 || !runtime.registered || !runtime.manifest_consistent ||
+        !resources.complete ||
+        status->phase != QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PHASE_ACTIVE ||
+        status->flags !=
+            (QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_MAPPING_INSTALLED |
+             QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_ACTIVE) ||
+        status->parent_process_generation == 0 ||
+        status->parent_process_generation == UINT64_MAX ||
+        status->child_process_generation !=
+            status->parent_process_generation + 1 ||
+        resources.manifest.process_generation !=
+            status->child_process_generation ||
+        !qemu_crucible_hot_fork_child_resource_plan_contains_plugin(
+            &crucible_hot_fork_child_resource_plan,
+            &crucible_hot_fork_plugin_child_resources) ||
+        !qemu_crucible_hot_fork_child_resource_plan_contains_diagnostics(
+            &crucible_hot_fork_child_resource_plan,
+            &crucible_hot_fork_diagnostics_child_resources) ||
+        !qmp->readiness_proof_acknowledged ||
+        !console->readiness_proof_acknowledged) {
+        error_setg(errp, "Crucible child adoption rejected an incomplete "
+                   "reconstruction profile");
+        goto fail;
+    }
+
+    result = qemu_crucible_hot_fork_adopt_child_as_parent();
+    if (result != 0) {
+        error_setg_errno(errp, -result,
+                         "Could not adopt the Crucible child as a source");
+        goto fail;
+    }
+
+    crucible_hot_fork_forget_consumed_child_stages();
+    crucible_hot_fork_child_active = false;
+    qapi_free_CrucibleHotForkQmpState(qmp);
+    qapi_free_CrucibleHotForkConsoleState(console);
+    return true;
+
+fail:
+    qapi_free_CrucibleHotForkQmpState(qmp);
+    qapi_free_CrucibleHotForkConsoleState(console);
+    return false;
+}
+
+CrucibleHotForkTemplateState *
+qmp_crucible_hot_fork_template(
+    CrucibleHotForkTemplateAction action,
+    bool has_block_snapshot_bindings,
+    CrucibleHotForkBlockSnapshotBindingList *block_snapshot_bindings,
+    Error **errp)
+{
+    CrucibleHotForkPluginBarrierState *plugin_barrier = NULL;
+    CrucibleHotForkRcuBarrierState *rcu_barrier = NULL;
+    CrucibleHotForkAsyncWorkerBarrierState *async_worker_barrier = NULL;
+    CrucibleHotForkBlockBarrierState *block_barrier = NULL;
+    CrucibleHotForkTemplateState *report = NULL;
+    CrucibleHotForkTemplateOutcome outcome;
+    uint64_t acknowledged;
+
+    g_mutex_lock(&crucible_hot_fork_template_lock);
+    if (crucible_hot_fork_operation_active) {
+        error_setg(errp, "Crucible hot-fork template mutation is closed "
+                   "during a fork operation");
+        goto out;
+    }
+    if (action != CRUCIBLE_HOT_FORK_TEMPLATE_ACTION_PREPARE &&
+        has_block_snapshot_bindings) {
+        error_setg(errp, "Crucible hot-fork block snapshot bindings are "
+                   "valid only for template preparation");
+        goto out;
+    }
+    plugin_barrier = crucible_hot_fork_plugin_barrier(
+        QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_QUERY, errp);
+    if (!plugin_barrier) {
+        goto out;
+    }
+    rcu_barrier = crucible_hot_fork_rcu_barrier(
+        QEMU_RCU_HOT_FORK_BARRIER_QUERY);
+    async_worker_barrier = crucible_hot_fork_async_worker_barrier(
+        QEMU_ASYNC_WORKER_HOT_FORK_BARRIER_QUERY);
+    block_barrier = crucible_hot_fork_block_barrier(
+        QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_QUERY, errp);
+    if (!block_barrier) {
+        goto out;
+    }
+
+    switch (crucible_hot_fork_template_phase) {
+    case CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_IDLE:
+    case CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_COMPLETED:
+        if (crucible_hot_fork_template_active || plugin_barrier->held ||
+            rcu_barrier->held || async_worker_barrier->held ||
+            block_barrier->held) {
+            error_setg(errp, "Crucible hot-fork barrier was held outside "
+                       "the template coordinator");
+            goto out;
+        }
+        break;
+    case CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BLOCK_HOLD_PENDING:
+        if (!crucible_hot_fork_template_active || plugin_barrier->held ||
+            rcu_barrier->held || async_worker_barrier->held ||
+            block_barrier->held) {
+            error_setg(errp, "Crucible hot-fork template block-hold "
+                       "transition was inconsistent");
+            goto out;
+        }
+        break;
+    case CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BLOCK_HELD:
+    case CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_SNAPSHOT_BIND_PENDING:
+        if (!crucible_hot_fork_template_active || plugin_barrier->held ||
+            rcu_barrier->held || async_worker_barrier->held ||
+            !block_barrier->held || block_barrier->owner_thread_id <= 0) {
+            error_setg(errp, "Crucible hot-fork template lost its retained "
+                       "block barrier");
+            goto out;
+        }
+        break;
+    case CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BLOCK_RELEASE_PENDING:
+        if (!crucible_hot_fork_template_active || plugin_barrier->held ||
+            rcu_barrier->held || async_worker_barrier->held ||
+            (block_barrier->held && block_barrier->owner_thread_id <= 0) ||
+            (!block_barrier->held && !crucible_hot_fork_template_sources)) {
+            error_setg(errp, "Crucible hot-fork template lost its source recovery owner");
+            goto out;
+        }
+        break;
+    case CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BARRIERS_HELD:
+        if (!crucible_hot_fork_template_active || !plugin_barrier->held ||
+            plugin_barrier->teardown_closed || !rcu_barrier->held ||
+            rcu_barrier->owner_thread_id <= 0 || !async_worker_barrier->held ||
+            async_worker_barrier->owner_thread_id <= 0 ||
+            !block_barrier->held || block_barrier->owner_thread_id <= 0) {
+            error_setg(errp, "Crucible hot-fork template lost a retained "
+                       "subsystem barrier");
+            goto out;
+        }
+        if (!block_barrier->snapshot_complete) {
+            error_setg(errp, "Crucible hot-fork template lost its immutable "
+                       "block snapshot binding");
+            goto out;
+        }
+        break;
+    default:
+        g_assert_not_reached();
+    }
+
+    if (crucible_hot_fork_template_phase ==
+        CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_COMPLETED) {
+        outcome = crucible_hot_fork_template_completion;
+        crucible_hot_fork_template_phase =
+            CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_IDLE;
+        goto make_report;
+    }
+
+    switch (action) {
+    case CRUCIBLE_HOT_FORK_TEMPLATE_ACTION_PREPARE:
+        if (crucible_hot_fork_template_phase ==
+            CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_IDLE) {
+            if (crucible_hot_fork_child_active) {
+                error_setg(errp, "Crucible hot-fork child must be re-adopted "
+                           "before template preparation");
+                goto out;
+            }
+            if (crucible_hot_fork_private_ring_stage.staged ||
+                crucible_hot_fork_plugin_endpoint_stage.staged) {
+                error_setg(errp, "Crucible hot-fork template preparation "
+                           "requires an empty resource stage");
+                goto out;
+            }
+            if (!has_block_snapshot_bindings ||
+                !crucible_hot_fork_template_copy_snapshot_bindings(
+                    block_snapshot_bindings, errp)) {
+                if (!has_block_snapshot_bindings) {
+                    error_setg(errp, "Crucible hot-fork template preparation "
+                               "requires the complete block snapshot binding");
+                }
+                goto out;
+            }
+            if (!crucible_hot_fork_exact_paused_boundary()) {
+                g_clear_pointer(
+                    &crucible_hot_fork_template_snapshot_bindings, g_free);
+                crucible_hot_fork_template_snapshot_binding_count = 0;
+                error_setg(errp, "Crucible hot-fork template preparation "
+                           "requires an exact paused/device-flush boundary");
+                goto out;
+            }
+            crucible_hot_fork_template_active = true;
+            crucible_hot_fork_template_abort_requested = false;
+            crucible_hot_fork_template_phase =
+                CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BLOCK_HOLD_PENDING;
+            crucible_hot_fork_template_generation++;
+            assert(crucible_hot_fork_template_generation != 0);
+            crucible_hot_fork_template_schedule_block_transition();
+            outcome = CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_DRAINING;
+            break;
+        }
+
+        if (!has_block_snapshot_bindings ||
+            !crucible_hot_fork_template_snapshot_bindings_match(
+                block_snapshot_bindings)) {
+            error_setg(errp, "Crucible hot-fork template preparation changed "
+                       "its block snapshot binding");
+            goto out;
+        }
+
+        if (crucible_hot_fork_template_phase ==
+            CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BLOCK_HOLD_PENDING) {
+            crucible_hot_fork_template_schedule_block_transition();
+            outcome = CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_DRAINING;
+            break;
+        }
+
+        if (crucible_hot_fork_template_phase ==
+            CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_SNAPSHOT_BIND_PENDING) {
+            crucible_hot_fork_template_schedule_block_transition();
+            outcome = CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_DRAINING;
+            break;
+        }
+
+        if (crucible_hot_fork_template_phase ==
+            CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BLOCK_RELEASE_PENDING) {
+            crucible_hot_fork_template_schedule_block_transition();
+            outcome = CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_DRAINING;
+            break;
+        }
+
+        if (crucible_hot_fork_template_phase ==
+            CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BLOCK_HELD) {
+            if (!crucible_hot_fork_exact_paused_boundary()) {
+                error_setg(errp, "Crucible hot-fork template lost its exact "
+                           "paused/device-flush boundary");
+                goto out;
+            }
+            if (!block_barrier->snapshot_complete) {
+                if (!block_barrier->quiescent) {
+                    outcome = CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_DRAINING;
+                    break;
+                }
+                crucible_hot_fork_template_phase =
+                    CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_SNAPSHOT_BIND_PENDING;
+                crucible_hot_fork_template_schedule_block_transition();
+                outcome = CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_DRAINING;
+                break;
+            }
+            /*
+             * ram_block_add() marks guest RAM MADV_DONTFORK so helper forks
+             * never duplicate it; a fork child needs that RAM as private
+             * copy-on-write pages.  Make it forkable for the template's
+             * lifetime, before any barrier is held, and refuse the template
+             * outright where that cannot be done.
+             */
+            {
+                int forkable =
+                    qemu_crucible_hot_fork_ram_set_forkable(true);
+
+                if (forkable != 0) {
+                    error_setg_errno(errp, -forkable, "Crucible hot-fork "
+                                     "template cannot make guest RAM forkable");
+                    goto out;
+                }
+            }
+            g_clear_pointer(&rcu_barrier, g_free);
+            rcu_barrier = crucible_hot_fork_rcu_barrier(
+                QEMU_RCU_HOT_FORK_BARRIER_HOLD);
+            g_clear_pointer(&async_worker_barrier, g_free);
+            async_worker_barrier = crucible_hot_fork_async_worker_barrier(
+                QEMU_ASYNC_WORKER_HOT_FORK_BARRIER_HOLD);
+            g_clear_pointer(&plugin_barrier, g_free);
+            plugin_barrier = crucible_hot_fork_plugin_barrier(
+                QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_HOLD, errp);
+            if (!plugin_barrier) {
+                g_clear_pointer(&async_worker_barrier, g_free);
+                async_worker_barrier = crucible_hot_fork_async_worker_barrier(
+                    QEMU_ASYNC_WORKER_HOT_FORK_BARRIER_RELEASE);
+                g_clear_pointer(&rcu_barrier, g_free);
+                rcu_barrier = crucible_hot_fork_rcu_barrier(
+                    QEMU_RCU_HOT_FORK_BARRIER_RELEASE);
+                crucible_hot_fork_template_completion =
+                    CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_BLOCKED;
+                crucible_hot_fork_template_phase =
+                    CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BLOCK_RELEASE_PENDING;
+                crucible_hot_fork_template_schedule_block_transition();
+                goto out;
+            }
+            crucible_hot_fork_template_phase =
+                CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BARRIERS_HELD;
+        }
+
+        if (!plugin_barrier->quiescent || !rcu_barrier->quiescent ||
+            !async_worker_barrier->quiescent || !block_barrier->quiescent) {
+            outcome = CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_DRAINING;
+            break;
+        }
+        acknowledged = crucible_hot_fork_template_acknowledged_proofs(
+            plugin_barrier, rcu_barrier, async_worker_barrier, block_barrier);
+        if (acknowledged == CRUCIBLE_HOT_FORK_TEMPLATE_REQUIRED_PROOFS) {
+            outcome = CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_PREPARED;
+            break;
+        }
+
+        outcome = CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_DRAINING;
+        break;
+    case CRUCIBLE_HOT_FORK_TEMPLATE_ACTION_QUERY:
+        if (!crucible_hot_fork_template_active) {
+            outcome = CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_IDLE;
+        } else if (plugin_barrier->quiescent && rcu_barrier->quiescent &&
+                   async_worker_barrier->quiescent && block_barrier->quiescent &&
+                   block_barrier->snapshot_complete &&
+                   crucible_hot_fork_template_acknowledged_proofs(
+                       plugin_barrier, rcu_barrier, async_worker_barrier,
+                       block_barrier) ==
+                   CRUCIBLE_HOT_FORK_TEMPLATE_REQUIRED_PROOFS) {
+            outcome = CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_PREPARED;
+        } else {
+            outcome = CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_DRAINING;
+        }
+        break;
+    case CRUCIBLE_HOT_FORK_TEMPLATE_ACTION_ADOPT_CHILD:
+        if (!crucible_hot_fork_adopt_reconstructed_child(errp)) {
+            goto out;
+        }
+        outcome = CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_CHILD_ADOPTED;
+        break;
+    case CRUCIBLE_HOT_FORK_TEMPLATE_ACTION_ABORT:
+        if (!crucible_hot_fork_template_active) {
+            outcome = CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_IDLE;
+            break;
+        }
+
+        if (crucible_hot_fork_template_phase ==
+            CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BLOCK_HOLD_PENDING) {
+            crucible_hot_fork_template_abort_requested = true;
+            crucible_hot_fork_template_schedule_block_transition();
+            outcome = CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_DRAINING;
+            break;
+        }
+
+        if (crucible_hot_fork_template_phase ==
+            CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_SNAPSHOT_BIND_PENDING) {
+            crucible_hot_fork_template_abort_requested = true;
+            crucible_hot_fork_template_schedule_block_transition();
+            outcome = CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_DRAINING;
+            break;
+        }
+
+        if (crucible_hot_fork_template_phase ==
+            CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BLOCK_HELD) {
+            crucible_hot_fork_template_completion =
+                CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_ABORTED;
+            crucible_hot_fork_template_phase =
+                CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BLOCK_RELEASE_PENDING;
+            crucible_hot_fork_template_schedule_block_transition();
+            outcome = CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_DRAINING;
+            break;
+        }
+
+        if (crucible_hot_fork_template_phase ==
+            CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BLOCK_RELEASE_PENDING) {
+            crucible_hot_fork_template_completion =
+                CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_ABORTED;
+            crucible_hot_fork_template_schedule_block_transition();
+            outcome = CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_DRAINING;
+            break;
+        }
+
+        plugin_barrier = crucible_hot_fork_plugin_barrier(
+            QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_RELEASE, errp);
+        if (!plugin_barrier) {
+            goto out;
+        }
+        async_worker_barrier = crucible_hot_fork_async_worker_barrier(
+            QEMU_ASYNC_WORKER_HOT_FORK_BARRIER_RELEASE);
+        rcu_barrier = crucible_hot_fork_rcu_barrier(
+            QEMU_RCU_HOT_FORK_BARRIER_RELEASE);
+        crucible_hot_fork_template_completion =
+            CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_ABORTED;
+        crucible_hot_fork_template_phase =
+            CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BLOCK_RELEASE_PENDING;
+        crucible_hot_fork_template_schedule_block_transition();
+        outcome = CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_DRAINING;
+        break;
+    default:
+        error_setg(errp, "Unknown Crucible hot-fork template action");
+        goto out;
+    }
+
+make_report:
+    report = crucible_hot_fork_template_report(outcome, plugin_barrier,
+                                                rcu_barrier,
+                                                async_worker_barrier,
+                                                block_barrier);
+    plugin_barrier = NULL;
+    rcu_barrier = NULL;
+    async_worker_barrier = NULL;
+    block_barrier = NULL;
+out:
+    g_free(plugin_barrier);
+    g_free(rcu_barrier);
+    g_free(async_worker_barrier);
+    qapi_free_CrucibleHotForkBlockBarrierState(block_barrier);
+    g_mutex_unlock(&crucible_hot_fork_template_lock);
+    return report;
+}
+
+static int crucible_hot_fork_operation_add_excluded_fd(
+    CrucibleHotForkOperation *operation, int descriptor)
+{
+    size_t index = 0;
+
+    if (!operation || descriptor < 0) {
+        return -EINVAL;
+    }
+    while (index < operation->excluded_fd_count &&
+           operation->excluded_fds[index] < descriptor) {
+        index++;
+    }
+    if (index < operation->excluded_fd_count &&
+        operation->excluded_fds[index] == descriptor) {
+        return -EINVAL;
+    }
+    if (operation->excluded_fd_count ==
+        QEMU_CRUCIBLE_HOT_FORK_MAX_RETAINED_DESCRIPTORS) {
+        return -E2BIG;
+    }
+    memmove(&operation->excluded_fds[index + 1],
+            &operation->excluded_fds[index],
