+static CrucibleHotForkTemplateState *
+crucible_hot_fork_template_report(
+    CrucibleHotForkTemplateOutcome outcome,
+    CrucibleHotForkPluginBarrierState *plugin_barrier,
+    CrucibleHotForkRcuBarrierState *rcu_barrier,
+    CrucibleHotForkAsyncWorkerBarrierState *async_worker_barrier,
+    CrucibleHotForkBlockBarrierState *block_barrier)
+{
+    CrucibleHotForkTemplateState *report =
+        g_new0(CrucibleHotForkTemplateState, 1);
+    uint64_t acknowledged = crucible_hot_fork_template_acknowledged_proofs(
+        plugin_barrier, rcu_barrier, async_worker_barrier, block_barrier);
+
+    report->schema_version = 29;
+    report->generation = crucible_hot_fork_template_generation;
+    report->outcome = outcome;
+    report->failure_stage = crucible_hot_fork_template_failure_stage;
+    report->failure_detail = g_strdup(
+        crucible_hot_fork_template_failure_detail ?: "");
+    report->transaction_active = crucible_hot_fork_template_active;
+    report->required_proofs = CRUCIBLE_HOT_FORK_TEMPLATE_REQUIRED_PROOFS;
+    report->acknowledged_proofs = acknowledged;
+    report->missing_proofs =
+        CRUCIBLE_HOT_FORK_TEMPLATE_REQUIRED_PROOFS & ~acknowledged;
+    report->plugin_barrier = plugin_barrier;
+    report->rcu_barrier = rcu_barrier;
+    report->async_worker_barrier = async_worker_barrier;
+    report->block_barrier = block_barrier;
+    report->resource_stage =
+        crucible_hot_fork_template_resource_stage_report(plugin_barrier);
+    report->rollback_complete = !report->transaction_active &&
+        !plugin_barrier->held && !rcu_barrier->held &&
+        !async_worker_barrier->held && !block_barrier->held &&
+        !block_barrier->snapshot_bound;
+    report->ready = outcome == CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_PREPARED &&
+        report->transaction_active && plugin_barrier->quiescent &&
+        rcu_barrier->quiescent && async_worker_barrier->quiescent &&
+        block_barrier->quiescent && block_barrier->snapshot_complete &&
+        report->missing_proofs == 0;
+    return report;
+}
