+    assert(!publisher_service_runtime_span(base, sizeof(fields), (void *)(base + 1)));
+    assert(!publisher_service_runtime_span(base, 0, fields));
+    assert(!publisher_service_runtime_span(base, sizeof(fields[0]) - 1, fields));
+    assert(!publisher_service_runtime_span(0, sizeof(fields), fields));
+    assert(!publisher_service_runtime_span(UINTPTR_MAX - 7, 8,
