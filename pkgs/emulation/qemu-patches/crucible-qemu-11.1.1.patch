+int qemu_plugin_crucible_fingerprint_operation_observe_v1(
+    qemu_plugin_crucible_fingerprint_operation_v1 *operation,
+    struct qemu_plugin_crucible_fingerprint_original_v1 *out)
+{
+    if (!standing_operation_identity(operation) ||
+        qemu_crucible_ram_fingerprint_root_module_current_v1(operation->plugin_id)) {
+        return -EPERM;
