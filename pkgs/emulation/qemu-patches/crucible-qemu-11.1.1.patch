+static int cpu_metadata_account_issue(
+    QemuCrucibleObservationConstructionBinding *binding)
+{
+    QemuCrucibleCpuMetadataAccount *account =
+        &startup_source.cpu_metadata_account;
+    int status;
+
+    if (qatomic_load_acquire(&account->retained)) {
+        return -EALREADY;
