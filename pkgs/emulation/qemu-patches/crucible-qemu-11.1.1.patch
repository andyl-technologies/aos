+        QemuCrucibleCpuAllocationReceipt *receipt = NULL;
+        status = ops->before(request, userdata, &receipt);
+        if (status || !receipt || request->receipt != receipt) {
+            object_native_allocation_abandon(request);
+            error_report("native object prebirth debit failed: %s",
