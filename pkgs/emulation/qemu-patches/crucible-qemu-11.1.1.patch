+        }
+        first = logical_capture_close_native();
+        if (first) {
+            return first;
+        }
+    }
+    first = qemu_crucible_ram_metadata_cleanup_before_entry();
+    if (first) {
+        return first;
+    }
+    memset(&fingerprint_root_outcome, 0, sizeof(fingerprint_root_outcome));
+    memset(&fingerprint_root_background, 0, sizeof(fingerprint_root_background));
+    fingerprint_root_frame.serial++;
+    fingerprint_root_frame.process = getpid();
+    qemu_thread_get_self(&fingerprint_root_frame.thread);
+    fingerprint_root_frame.active = true;
+    fingerprint_root_frame.cpu_context = current_cpu != NULL;
+    /* Genuine Source entry precedes callback, capture, logging and reads.
+     * The Source owns the actual pre-paid standing issuer and Original. */
+    first = qemu_crucible_startup_source_fingerprint_operation_enter_v1(
+        &fingerprint_root_operation);
+    fingerprint_root_outcome.entry_status = first;
+    fingerprint_root_outcome.entry_returned = true;
+    fingerprint_root_outcome.owner_retained = fingerprint_root_operation != NULL;
+    if (!first && !fingerprint_root_operation) {
+        first = fingerprint_root_outcome.entry_status = -EPERM;
+    }
+    if (!first) {
+        qemu_plugin_id_t id;
+
+        first = qemu_crucible_startup_source_fingerprint_root_creator_v1(&id);
+        if (!first && current_cpu) {
+            /* Passive exact cpu_exec epoch receipt. Save born custody before
+             * inspecting status; it supplies no writer closure or Original. */
+            first = qemu_crucible_observation_root_execution_borrow_v1(
+                id, &fingerprint_root_execution);
+            fingerprint_root_outcome.execution_borrow_status = first;
+        }
+        if (!first && !current_cpu && qemu_crucible_startup_source_resident_root_v1()) {
+            first = qemu_crucible_startup_source_resident_absence_begin_v1(
+                id, fingerprint_root_operation, &fingerprint_root_background.source);
+            if (!first) {
+                first = qemu_crucible_ram_owner_resident_begin_v1(
+                    fingerprint_root_background.source, &fingerprint_root_background.token,
+                    &fingerprint_root_background.first_status,
+                    &fingerprint_root_background.cleanup_status);
+            }
+            fingerprint_root_background.first_status = first;
+            if (fingerprint_root_background.source) {
+                fingerprint_root_background.post_status =
+                    qemu_crucible_startup_source_resident_absence_post_v1(
+                        fingerprint_root_background.source, fingerprint_root_operation, first);
+                if (!first) {
+                    first = fingerprint_root_background.post_status;
+                }
+            }
+        }
+        if (!first) {
+            first = qemu_crucible_observation_writer_acquire_v1(id, &fingerprint_root_writer);
+            fingerprint_root_outcome.writer_acquire_status = first;
+        }
+        if (!first && !current_cpu) {
+            /* Genuine Main Source Original and writer loan already exist.
+             * FPbegin installs its actual durable field before observer work. */
+            first = fingerprint_retirement_prepare();
+        }
+        fingerprint_root_outcome.preobserver_status = first;
+        fingerprint_root_outcome.preobserver_returned = true;
+    }
+    if (!first) {
+        fingerprint_root_outcome.module_invoking = true;
+        first = observer(scope, 0, root, logical_bytes, NULL);
+        fingerprint_root_outcome.module_invoking = false;
+        fingerprint_root_outcome.callback_status = first;
+        fingerprint_root_outcome.callback_returned = true;
+    }
+    if (ordinary_fingerprint.operation_borrowed && !first) {
+        int rearmed = fingerprint_retirement_rearm();
+
+        if (rearmed && logical_capture->active && !logical_capture->native_status) {
+            logical_capture->native_status = rearmed;
+        }
+    }
+    if (fingerprint_root_operation) {
+        /* One independent post of that SAME Source-issued Original, after
+         * actual callback return. Logical post binds this recorded result. */
+        post = qemu_crucible_startup_source_fingerprint_operation_post_v1(
+            fingerprint_root_operation, first);
+    }
+    fingerprint_root_outcome.post_status = post;
+    fingerprint_root_outcome.post_recorded = fingerprint_root_operation != NULL;
+    status = logical_capture_root_return(first, post);
+    if (ordinary_fingerprint.operation_borrowed) {
+        int acknowledged = fingerprint_retirement_acknowledge(post);
+        int returned = fingerprint_retirement_root_end();
+
+        if (acknowledged && logical_capture->active && !logical_capture->native_status) {
+            logical_capture->native_status = acknowledged;
+        }
+        if (returned && logical_capture->active && !logical_capture->native_status) {
+            logical_capture->native_status = returned;
+        }
+        if (!status) {
+            status = acknowledged ? acknowledged : returned;
+        }
+    }
+    if (logical_capture->active) {
+        fingerprint_root_outcome.logical_return_status = logical_capture->return_status;
+        fingerprint_root_outcome.logical_return_attempted = logical_capture->attempted;
+    }
+    if (fingerprint_root_operation) {
+        fingerprint_root_outcome.original_facts_status =
+            qemu_crucible_startup_source_fingerprint_original_post_observe_v1(
+                fingerprint_root_operation, &fingerprint_root_outcome.original);
+        fingerprint_root_outcome.original_recorded =
+            !fingerprint_root_outcome.original_facts_status;
+        if (fingerprint_publication.borrowed && fingerprint_publication.claim == logical_capture) {
+            fingerprint_publication.post_original = fingerprint_root_outcome.original;
+            if (!fingerprint_root_outcome.original_facts_status &&
+                (fingerprint_publication.post_original.operation_serial !=
+                     fingerprint_publication.original.operation_serial ||
+                 fingerprint_publication.post_original.supervisor_origin_ns !=
+                     fingerprint_publication.original.supervisor_origin_ns ||
+                 fingerprint_publication.post_original.operation_start_ns !=
+                     fingerprint_publication.original.operation_start_ns ||
+                 fingerprint_publication.post_original.class_index !=
+                     fingerprint_publication.original.class_index ||
+                 memcmp(fingerprint_publication.post_original.supervisor_capability,
+                        fingerprint_publication.original.supervisor_capability, 32))) {
+                fingerprint_root_outcome.original_facts_status = -ESTALE;
+            }
+            if (fingerprint_root_outcome.original_facts_status && !logical_capture->native_status) {
+                logical_capture->native_status = fingerprint_root_outcome.original_facts_status;
+            }
+        }
+    }
+    if (fingerprint_root_operation) {
+        ended = qemu_crucible_startup_source_fingerprint_operation_end_v1(
+            &fingerprint_root_operation);
+        fingerprint_root_outcome.outer_end_status = ended;
+        fingerprint_root_outcome.owner_retained = fingerprint_root_operation != NULL;
+        /* Record physical pointer consumption even with signed uncertainty.
+         * A retained issued owner blocks reuse; no scalar infers bank reuse. */
+        if (!status) {
+            status = ended ? ended : fingerprint_root_operation ? -EBUSY : 0;
+        }
+    }
+    status = logical_capture_outer_return(status, ended, fingerprint_root_operation != NULL);
+    if (fingerprint_root_writer) {
+        writer_return = qemu_crucible_observation_writer_return_v1(&fingerprint_root_writer);
+        fingerprint_root_outcome.writer_return_status = writer_return;
+        if (!status) {
+            status = writer_return ? writer_return : fingerprint_root_writer ? -EBUSY : 0;
+        }
+    }
+    if (fingerprint_root_background.source) {
+        int returned = fingerprint_root_background_return();
+
+        if (!status) {
+            status = returned;
+        }
+    }
+    status = fingerprint_retirement_root_complete(status);
+    if (status && logical_capture->active && !logical_capture_result()) {
+        logical_capture->native_status = status;
+    }
+    status = logical_capture_writer_return(status, writer_return, fingerprint_root_writer != NULL);
+    if (fingerprint_root_execution && !fingerprint_root_operation &&
+        !fingerprint_root_writer && !logical_capture->source_claim &&
+        !logical_capture->progress.borrowed && !logical_capture->progress.published) {
+        /* No recovery depends on execution end when every physical child and
+         * Source owner already returned. Passive return is distinct from end. */
+        int returned = qemu_crucible_observation_root_execution_identity_return_v1(
+            &fingerprint_root_execution);
+
+        fingerprint_root_outcome.execution_return_status = returned;
+        if (returned && !logical_capture->native_status && logical_capture->active) {
+            logical_capture->native_status = returned;
+        }
+        if (!status) {
+            status = returned ? returned : fingerprint_root_execution ? -EBUSY : 0;
+        }
+    }
+    status = fingerprint_publication_settle(status, scope, root, *logical_bytes);
+    int metadata_return = logical_capture_close_native();
+
+    if (!status) {
+        status = metadata_return;
+    }
+    fingerprint_root_frame.active = false;
+    return status;
+}
