+static uint64_t node_virtual_now_tick(void)
+{
+    int64_t now = icount_crucible_sim_tick_observed();
+
+    if (now < 0) {
+        error_report("Crucible fault model observed negative virtual time");
+        abort();
+    }
+    return now;
+}
