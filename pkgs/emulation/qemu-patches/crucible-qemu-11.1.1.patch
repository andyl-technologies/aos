+/* Proves that a rejected request leaves the complete target register intact. */
+static bool test_rejection_target_unchanged(const uint8_t *current,
+                                            size_t current_len)
+{
+    return test_initial_target_len != 0 &&
+        current_len == test_initial_target_len &&
+        memcmp(current, test_initial_target, current_len) == 0;
+}
