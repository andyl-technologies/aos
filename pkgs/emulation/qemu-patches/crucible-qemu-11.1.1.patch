+    QEMUClockType type;
+    int64_t duration_ns;
+    bool completed;
+} TimerSleepData;
+
+static __int128 sleep_virtual_ps;
+static bool sleep_virtual_clock_installed;
+
+/* Supply coherent ns/ps samples without requiring an executing vCPU. */
+int64_t cpu_get_clock(void)
+{
+    return sleep_virtual_clock_installed ? sleep_virtual_ps / 1000 :
+                                          get_clock_realtime();
+}
+
+static __int128 sleep_virtual_clock_ps(void)
+{
+    return sleep_virtual_ps;
+}
+
+static void coroutine_fn timer_sleep_entry(void *opaque)
+{
+    TimerSleepData *data = opaque;
+
+    qemu_co_sleep_ns_wakeable(&data->wake, data->type, data->duration_ns);
+    data->completed = true;
+}
+
+static void sleep_test_init(bool tcg_ps)
+{
+    sleep_virtual_clock_installed = tcg_ps;
+    qemu_init_main_loop(&error_fatal);
+    if (tcg_ps) {
+        qemu_timer_enable_tcg_ps_clock(NULL, sleep_virtual_clock_ps);
+    }
+    qemu_clock_enable(QEMU_CLOCK_VIRTUAL, true);
+}
+
+static void test_co_sleep_fractional(gconstpointer opaque)
+{
+    int64_t duration_ns = GPOINTER_TO_INT(opaque);
+    TimerSleepData data = {
+        .type = QEMU_CLOCK_VIRTUAL,
+        .duration_ns = duration_ns,
+    };
+    AioContext *ctx;
+    Coroutine *coroutine;
+    __int128 deadline_ps;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    sleep_virtual_ps = 10501;
+    sleep_test_init(true);
+    ctx = qemu_get_aio_context();
+    deadline_ps = sleep_virtual_ps + (__int128)MAX(duration_ns, 0) * 1000;
+    coroutine = qemu_coroutine_create(timer_sleep_entry, &data);
+    qemu_coroutine_enter(coroutine);
+
+    g_assert_false(data.completed);
+    g_assert_true(timerlist_has_timers(ctx->tlg.tl[QEMU_CLOCK_VIRTUAL]));
+    g_assert_cmpint(qemu_clock_deadline_ps_all(QEMU_CLOCK_VIRTUAL,
+                                              QEMU_TIMER_ATTR_ALL), ==,
+                    MAX(duration_ns, 0) * 1000);
+
+    /* The real timer must neither publish a wake early nor lose the phase. */
+    if (duration_ns > 0) {
+        sleep_virtual_ps = deadline_ps - 1;
+        g_assert_false(timerlist_run_timers(ctx->tlg.tl[QEMU_CLOCK_VIRTUAL]));
+        aio_poll(ctx, false);
+        g_assert_false(data.completed);
+    }
