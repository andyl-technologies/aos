+    input = save_timestamp(device);
+    stw_be_p(input->data + 17, PICOSECONDS_PER_NANOSECOND);
+    file = qemu_file_new_input(QIO_CHANNEL(input));
+    g_assert_cmpint(vmstate_load_state(file, &vmstate_ct3_timestamp, device,
+                                      1, &error), <, 0);
+    g_assert_nonnull(error);
+    error_free(error);
+    qemu_fclose(file);
+    object_unref(OBJECT(input));
+    object_unref(OBJECT(device));
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_data_func("/cxl/timestamp/fractional", GINT_TO_POINTER(true),
+                         test_boundary);
+    g_test_add_data_func("/cxl/timestamp/non-tcg", GINT_TO_POINTER(false),
+                         test_boundary);
+    g_test_add_func("/cxl/timestamp/rebase-wrap", test_rebase_and_wrap);
+    g_test_add_func("/cxl/timestamp/wide-origin", test_wide_origin);
+    g_test_add_func("/cxl/timestamp/origin-refusal", test_origin_refusal);
+    g_test_add_func("/cxl/timestamp/migration", test_migration);
+    g_test_add_func("/cxl/timestamp/legacy", test_legacy_default);
+    g_test_add_func("/cxl/timestamp/malformed", test_malformed_migration);
+    return g_test_run();
+}
