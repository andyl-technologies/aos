+    material = reference->owner->material;
+    first = qatomic_load_acquire(&material->first_status);
+    if (first || material->post_status || material->read.read_status ||
+        material->read.post_status) {
+        return first ? first : material->post_status ?
+            material->post_status : material->read.read_status ?
+            material->read.read_status : material->read.post_status;
+    }
+    receipt = (struct qemu_plugin_crucible_fingerprint_material_read_v1) {
+        .offset = material->read_offset,
+    };
+    /* Capture validated the sealed FD/identity/extent after its writer closed.
+     * The matched module only borrows the diagnostic FD: no close, dup, rebind
+     * or flag changes. Source's sole close refuses this exact Work/byte debt,
+     * so acquisition identity survives unlocked pread under that contract. */
+    if (material->read_offset > INT64_MAX ||
+        material->read_offset > material->device_length) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        receipt.attempted = true;
+        physical_result = pread(material->descriptor, worker->workspace->address,
+                                requested, material->read_offset);
+        if (physical_result < 0) {
+            status = -errno;
+        } else if (!physical_result) {
+            receipt.eof = true;
+            if (material->read_offset != material->device_length) {
+                status = -EIO;
+            }
+        } else {
+            receipt.bytes_read = physical_result;
+            qemu_mutex_lock(&startup_source.commands.mutex);
+            material->read_offset += physical_result;
+            /* Main may inspect this real prefix while a later independent
+             * clock/Original post refuses. No Source lock survives I/O. */
+            material->read = receipt;
+            qemu_mutex_unlock(&startup_source.commands.mutex);
+            status = material->operation.action_original ? 0 : standing_clock(&progress);
+            if (!status && !material->operation.action_original &&
+                progress < qatomic_load_acquire(&material->operation.progress_ns)) {
+                status = -ESTALE;
+            }
+            if (!status && !material->operation.action_original) {
+                qatomic_store_release(&material->operation.progress_ns, progress);
+            }
+        }
+    }
+    receipt.read_status = status;
+    if (status) {
+        qatomic_cmpxchg(&material->first_status, 0, status);
+    }
+    qemu_mutex_lock(&startup_source.commands.mutex);
+    material->read = receipt;
+    qemu_mutex_unlock(&startup_source.commands.mutex);
+    receipt.post_status = fingerprint_material_observe(
+        material, &material->worker_observer, NULL);
+    qemu_mutex_lock(&startup_source.commands.mutex);
+    material->read = receipt;
+    *out = receipt;
+    qemu_mutex_unlock(&startup_source.commands.mutex);
+    first = qatomic_load_acquire(&material->first_status);
+    return first ? first : status ? status : receipt.post_status;
