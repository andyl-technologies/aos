+static int verify_endpoint_pair(void *opaque)
+{
+    EndpointVerification *verification = opaque;
+    char byte = 'c';
+    uint64_t wake = 1;
+
+    g_assert_cmpint(send(verification->control_fd, &byte, 1, 0), ==, 1);
+    g_assert_cmpint(recv(verification->expected_control_peer, &byte, 1, 0),
+                    ==, 1);
+    g_assert_cmpint(write(verification->wake_fd, &wake, sizeof(wake)), ==,
+                    sizeof(wake));
+    return verification->result;
+}
+
+static int verify_fork_child_endpoints(void *opaque)
+{
+    ForkChildVerification *verification = opaque;
+    char byte = 'f';
+    uint64_t wake = 1;
+
+    if (send(verification->control_fd, &byte, 1, 0) != 1) {
+        return errno != 0 ? -errno : -EIO;
+    }
+    if (write(verification->wake_fd, &wake, sizeof(wake)) != sizeof(wake)) {
+        return errno != 0 ? -errno : -EIO;
+    }
+    return 0;
+}
+
+static int verify_closed_descriptor_table(void *opaque)
+{
+    ClosedDescriptorTableVerification *verification = opaque;
+    char byte = 't';
+    uint64_t wake = 1;
+    int result;
+
+    if (verification->proof) {
+        result = qemu_crucible_hot_fork_verify_child_descriptor_table(
+            verification->proof);
+        if (result != 0) {
+            return result;
+        }
+    }
+
+    if (fcntl(verification->closed_fd, F_GETFD) >= 0 || errno != EBADF) {
+        return -EBUSY;
+    }
+    if (send(verification->control_fd, &byte, 1, 0) != 1) {
+        return errno != 0 ? -errno : -EIO;
+    }
+    if (write(verification->wake_fd, &wake, sizeof(wake)) != sizeof(wake)) {
+        return errno != 0 ? -errno : -EIO;
+    }
+    return 0;
+}
+
+static int reinitialize_child_resources(void *opaque)
+{
+    ChildResourceReinitializer *reinitializer = opaque;
+
+    reinitializer->called = true;
+    reinitializer->installed_mapping = mmap(
+        reinitializer->address, reinitializer->length,
+        PROT_READ | PROT_WRITE, MAP_SHARED | MAP_FIXED_NOREPLACE,
+        reinitializer->backing_fd, 0);
+    if (reinitializer->installed_mapping == MAP_FAILED) {
+        return -errno;
+    }
+    return 0;
+}
+
+static int compare_descriptors(const void *left, const void *right)
+{
+    int left_fd = *(const int *)left;
+    int right_fd = *(const int *)right;
+
+    return (left_fd > right_fd) - (left_fd < right_fd);
+}
