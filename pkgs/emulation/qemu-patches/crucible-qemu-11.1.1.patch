+CrucibleHotForkSourceGraphReceipt *qmp_crucible_hot_fork_source_graph(
+    int64_t expected_qemu_pid, uint64_t expected_template_generation,
+    uint32_t maximum_nodes, uint64_t maximum_bytes, Error **errp)
+{
+    QemuBlockBackendHotForkBarrierInventory block;
+    QemuBlockHotForkGraphReceipt native = { 0 };
+    CrucibleHotForkSourceGraphReceipt *report = NULL;
+    CrucibleHotForkSourceGraphMemberList **tail;
+    CrucibleHotForkGraphReceiptStamp stamp;
+    size_t index;
+
+    /* OOB graph inspection takes BQL before the template mutex. */
+    BQL_LOCK_GUARD();
+    g_mutex_lock(&crucible_hot_fork_template_lock);
+    if (expected_qemu_pid != getpid() ||
+        expected_template_generation == 0 ||
+        expected_template_generation !=
+            crucible_hot_fork_template_generation ||
+        !crucible_hot_fork_template_active ||
+        crucible_hot_fork_template_phase !=
+            CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BARRIERS_HELD ||
+        !crucible_hot_fork_template_sources ||
+        crucible_hot_fork_operation_active ||
+        !crucible_hot_fork_exact_paused_boundary()) {
+        error_setg(errp, "Crucible source graph requires the original "
+                   "prepared source and exact stopped boundary");
+        goto out;
+    }
+    if (!qemu_block_backend_hot_fork_barrier(
+            QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_QUERY, &block)) {
+        error_setg(errp, "Cannot inspect Crucible source graph barrier");
+        goto out;
+    }
+    if (!block.held || !block.graph_held || !block.complete ||
+        !block.quiescent || !block.snapshot_bound ||
+        !block.snapshot_complete || !block.snapshot_sources.frozen ||
+        !block.snapshot_generation ||
+        !block.snapshot_backend_generation) {
+        error_setg(errp, "Crucible source graph lost its frozen barrier");
+        goto release_block;
+    }
+    stamp = (CrucibleHotForkGraphReceiptStamp) {
+        .sources = crucible_hot_fork_template_sources,
+        .process = getpid(),
+        .template_generation = crucible_hot_fork_template_generation,
+        .runstate_generation = qemu_runstate_transition_generation(),
+        .vmstop_generation = qemu_plugin_crucible_vmstop_generation(),
+        .vmstop_request_generation = qemu_vmstop_request_generation(),
+        .barrier_generation = block.generation,
+        .graph_barrier_generation = block.graph_barrier_generation,
+        .graph_mutation_generation = block.graph_mutation_generation,
+        .snapshot_generation = block.snapshot_generation,
+        .backend_generation = block.snapshot_backend_generation,
+    };
+    if (stamp.runstate_generation == UINT64_MAX ||
+        !stamp.vmstop_generation || stamp.vmstop_generation == UINT64_MAX ||
+        stamp.vmstop_request_generation == UINT64_MAX) {
+        error_setg(errp, "Crucible source graph stop provenance is exhausted");
+        goto release_block;
+    }
+    if (!qemu_block_hot_fork_source_set_graph_receipt(
+            crucible_hot_fork_template_sources, maximum_nodes,
+            maximum_bytes, &native, errp)) {
+        goto release_block;
+    }
+    if (!crucible_hot_fork_exact_paused_boundary() ||
+        stamp.runstate_generation != qemu_runstate_transition_generation() ||
+        stamp.vmstop_generation != qemu_plugin_crucible_vmstop_generation() ||
+        stamp.vmstop_request_generation != qemu_vmstop_request_generation()) {
+        qemu_block_hot_fork_graph_receipt_destroy(&native);
+        error_setg(errp, "Crucible source graph stop changed during capture");
+        goto release_block;
+    }
+    report = g_new0(CrucibleHotForkSourceGraphReceipt, 1);
+    report->schema_version = 1;
+    report->qemu_pid = getpid();
+    report->template_generation = crucible_hot_fork_template_generation;
+    report->runstate_generation = stamp.runstate_generation;
+    report->vmstop_generation = stamp.vmstop_generation;
+    report->vmstop_request_generation = stamp.vmstop_request_generation;
+    report->barrier_generation = block.generation;
+    report->graph_barrier_generation = block.graph_barrier_generation;
+    report->graph_mutation_generation = block.graph_mutation_generation;
+    report->snapshot_generation = block.snapshot_generation;
+    report->backend_generation = block.snapshot_backend_generation;
+    report->root_count = block.snapshot_sources.roots;
+    report->node_count = native.count;
+    tail = &report->members;
+    for (index = 0; index < native.count; index++) {
+        const QemuBlockHotForkGraphMember *source = &native.members[index];
+        CrucibleHotForkSourceGraphMember *member =
+            g_new0(CrucibleHotForkSourceGraphMember, 1);
+        CrucibleHotForkSourceGraphMemberList *link =
+            g_new0(CrucibleHotForkSourceGraphMemberList, 1);
+
+        member->root_index = source->root_index;
+        member->node_index = source->node_index;
+        member->parent_index = source->parent_index;
+        member->backend_id = source->backend_id;
+        member->backend_name = g_strdup(source->backend_name);
+        member->root_node_name = g_strdup(source->root_node_name);
+        member->node_name = g_strdup(source->node_name);
+        member->edge_name = g_strdup(source->edge_name);
+        member->driver_name = g_strdup(source->driver_name);
+        member->file_backed = source->file_backed;
+        member->originally_writable_file =
+            source->originally_writable_file;
+        member->file_path = g_strdup(source->file_path ?: "");
+        member->file_device = source->file_device;
+        member->file_inode = source->file_inode;
+        member->file_size = source->file_size;
+        member->file_sha256 = g_strdup(source->file_sha256);
+        link->value = member;
+        *tail = link;
+        tail = &link->next;
+    }
+    qemu_block_hot_fork_graph_receipt_destroy(&native);
+    /*
+     * Only this successful authenticated query binds the full native graph
+     * to its exact stopped template and retained barrier epochs.
+     */
+    crucible_hot_fork_graph_receipt = stamp;
+release_block:
+    qemu_block_backend_hot_fork_barrier_inventory_destroy(&block);
+out:
+    g_mutex_unlock(&crucible_hot_fork_template_lock);
+    return report;
+}
+
+/* Called with the template guard held, before the physical child-file plan.
+ * Reusing an unchanged paused template is allowed; resume, graph mutation,
+ * barrier reacquisition, or another template requires its own graph query. */
+static bool crucible_hot_fork_graph_receipt_current(void)
+{
+    const CrucibleHotForkGraphReceiptStamp *receipt =
+        &crucible_hot_fork_graph_receipt;
+    QemuBlockBackendHotForkBarrierInventory block;
+    bool current;
+
+    if (!receipt->sources || receipt->process != getpid() ||
+        receipt->sources != crucible_hot_fork_template_sources ||
+        receipt->template_generation != crucible_hot_fork_template_generation ||
+        receipt->runstate_generation != qemu_runstate_transition_generation() ||
+        receipt->vmstop_generation != qemu_plugin_crucible_vmstop_generation() ||
+        receipt->vmstop_request_generation != qemu_vmstop_request_generation() ||
+        !crucible_hot_fork_template_active ||
+        crucible_hot_fork_template_phase !=
+            CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BARRIERS_HELD ||
+        !crucible_hot_fork_exact_paused_boundary() ||
+        !qemu_block_hot_fork_source_set_has_graph_receipt(receipt->sources) ||
+        !qemu_block_backend_hot_fork_barrier(
+            QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_QUERY, &block)) {
+        return false;
+    }
+    current = block.held && block.graph_held && block.complete &&
+        block.quiescent && block.snapshot_bound && block.snapshot_complete &&
+        block.snapshot_sources.frozen &&
+        block.generation == receipt->barrier_generation &&
+        block.graph_barrier_generation == receipt->graph_barrier_generation &&
+        block.graph_mutation_generation == receipt->graph_mutation_generation &&
+        block.snapshot_generation == receipt->snapshot_generation &&
+        block.snapshot_backend_generation == receipt->backend_generation;
+    qemu_block_backend_hot_fork_barrier_inventory_destroy(&block);
+    return current;
+}
+
+/*
+ * A reconstructed child owns live replacements at the target descriptor
+ * slots.  Its inherited stage records describe the already-consumed source
+ * descriptors and must be forgotten without closing those numeric slots.
+ */
+static void crucible_hot_fork_forget_consumed_child_stages(void)
+{
+    uint64_t private_ring_generation =
+        crucible_hot_fork_private_ring_stage.generation;
+    uint64_t diagnostic_generation =
+        crucible_hot_fork_diagnostic_stage.generation;
+    uint64_t qmp_generation = crucible_hot_fork_qmp_stage.generation;
+    uint64_t console_generation = crucible_hot_fork_console_stage.generation;
+    uint64_t endpoint_generation =
+        crucible_hot_fork_plugin_endpoint_stage.generation;
+    uint64_t process_contract_generation =
+        crucible_hot_fork_child_process_contract_stage.generation;
+
+    g_clear_pointer(&crucible_hot_fork_private_ring_stage.fdname, g_free);
+    crucible_hot_fork_private_ring_stage =
+        (CrucibleHotForkPrivateRingStage) {
+            .fd = -1,
+            .generation = private_ring_generation,
+        };
+
+    g_clear_pointer(&crucible_hot_fork_diagnostic_stage.fdname, g_free);
+    crucible_hot_fork_diagnostic_stage = (CrucibleHotForkDiagnosticStage) {
+        .fd = -1,
+        .generation = diagnostic_generation,
+    };
+
+    g_clear_pointer(&crucible_hot_fork_qmp_stage.fdname, g_free);
+    crucible_hot_fork_qmp_stage = (CrucibleHotForkQmpStage) {
+        .fd = -1,
+        .generation = qmp_generation,
+    };
+
+    g_clear_pointer(&crucible_hot_fork_console_stage.fdname, g_free);
+    crucible_hot_fork_console_stage = (CrucibleHotForkConsoleStage) {
+        .fd = -1,
+        .generation = console_generation,
+    };
+
+    g_clear_pointer(
+        &crucible_hot_fork_plugin_endpoint_stage.control_fdname, g_free);
+    g_clear_pointer(
+        &crucible_hot_fork_plugin_endpoint_stage.wake_fdname, g_free);
+    crucible_hot_fork_plugin_endpoint_stage =
+        (CrucibleHotForkPluginEndpointStage) {
+            .control_fd = -1,
+            .wake_fd = -1,
+            .control_target_fd = -1,
+            .wake_target_fd = -1,
+            .generation = endpoint_generation,
+        };
+
+    g_clear_pointer(
+        &crucible_hot_fork_child_process_contract_stage.cgroup_fdname, g_free);
+    g_clear_pointer(
+        &crucible_hot_fork_child_process_contract_stage.cgroup_procs_fdname,
+        g_free);
+    g_clear_pointer(
+        &crucible_hot_fork_child_process_contract_stage.cancellation_fdname,
+        g_free);
+    crucible_hot_fork_child_process_contract_stage =
+        (CrucibleHotForkChildProcessContractStage) {
+            .cgroup_fd = -1,
+            .cgroup_procs_fd = -1,
+            .cancellation_fd = -1,
+            .generation = process_contract_generation,
+        };
+
+    monitor_hot_fork_reset_child_basis(&crucible_hot_fork_qmp_child_basis);
+    crucible_hot_fork_console_child_basis =
+        (QemuChrSocketHotForkChildBasis) { 0 };
+    qemu_crucible_hot_fork_reset_plugin_child_reinitializer(
+        &crucible_hot_fork_plugin_child_reinitializer);
+    qemu_crucible_hot_fork_reset_plugin_child_resources(
+        &crucible_hot_fork_plugin_child_resources);
+    qemu_crucible_hot_fork_reset_diagnostics_child_resources(
+        &crucible_hot_fork_diagnostics_child_resources);
+    qemu_crucible_hot_fork_reset_qmp_child_resources(
+        &crucible_hot_fork_qmp_child_resources);
+    qemu_crucible_hot_fork_reset_qmp_child_reinitializer(
+        &crucible_hot_fork_qmp_child_reinitializer);
+    qemu_crucible_hot_fork_reset_console_child_resources(
+        &crucible_hot_fork_console_child_resources);
+    qemu_crucible_hot_fork_reset_console_child_reinitializer(
+        &crucible_hot_fork_console_child_reinitializer);
+    qemu_crucible_hot_fork_reset_child_resource_plan(
+        &crucible_hot_fork_child_resource_plan);
+}
+
+static bool crucible_hot_fork_adopt_reconstructed_child(Error **errp)
+{
+    QemuPluginCrucibleHotForkChildRuntimeInventory runtime = { 0 };
+    QemuPluginCrucibleHotForkInventory resources = { 0 };
+    CrucibleHotForkQmpState *qmp = NULL;
+    CrucibleHotForkConsoleState *console = NULL;
+    const struct qemu_plugin_crucible_hot_fork_child_status *status;
+    int result;
+
+    if (!crucible_hot_fork_child_active || crucible_hot_fork_template_active ||
+        crucible_hot_fork_operation_active ||
+        crucible_hot_fork_template_phase !=
+            CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_IDLE ||
+        !crucible_hot_fork_exact_paused_boundary()) {
+        error_setg(errp, "Crucible child adoption requires one idle, exactly "
+                   "paused reconstructed child");
+        return false;
+    }
+
+    result = qemu_plugin_crucible_hot_fork_child_runtime(
+        QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_QUERY, NULL, &runtime);
+    qemu_plugin_crucible_hot_fork_inventory(&resources);
+    status = &runtime.status;
+    qmp = crucible_hot_fork_qmp_report();
+    console = crucible_hot_fork_console_report();
+    if (result != 0 || !runtime.registered || !runtime.manifest_consistent ||
+        !resources.complete ||
+        status->phase != QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PHASE_ACTIVE ||
+        status->flags !=
+            (QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_MAPPING_INSTALLED |
+             QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_ACTIVE) ||
+        status->parent_process_generation == 0 ||
+        status->parent_process_generation == UINT64_MAX ||
+        status->child_process_generation !=
+            status->parent_process_generation + 1 ||
+        resources.manifest.process_generation !=
+            status->child_process_generation ||
+        !qemu_crucible_hot_fork_child_resource_plan_contains_plugin(
+            &crucible_hot_fork_child_resource_plan,
+            &crucible_hot_fork_plugin_child_resources) ||
+        !qemu_crucible_hot_fork_child_resource_plan_contains_diagnostics(
+            &crucible_hot_fork_child_resource_plan,
+            &crucible_hot_fork_diagnostics_child_resources) ||
+        !qmp->readiness_proof_acknowledged ||
+        !console->readiness_proof_acknowledged) {
+        error_setg(errp, "Crucible child adoption rejected an incomplete "
+                   "reconstruction profile");
+        goto fail;
+    }
+
+    result = qemu_crucible_hot_fork_adopt_child_as_parent();
+    if (result != 0) {
+        error_setg_errno(errp, -result,
+                         "Could not adopt the Crucible child as a source");
+        goto fail;
+    }
+
+    crucible_hot_fork_forget_consumed_child_stages();
+    crucible_hot_fork_child_active = false;
+    qapi_free_CrucibleHotForkQmpState(qmp);
+    qapi_free_CrucibleHotForkConsoleState(console);
+    return true;
+
+fail:
+    qapi_free_CrucibleHotForkQmpState(qmp);
+    qapi_free_CrucibleHotForkConsoleState(console);
+    return false;
+}
+
+CrucibleHotForkTemplateState *
+qmp_crucible_hot_fork_template(
+    CrucibleHotForkTemplateAction action,
+    bool has_block_snapshot_bindings,
+    CrucibleHotForkBlockSnapshotBindingList *block_snapshot_bindings,
+    Error **errp)
+{
+    CrucibleHotForkPluginBarrierState *plugin_barrier = NULL;
+    CrucibleHotForkRcuBarrierState *rcu_barrier = NULL;
+    CrucibleHotForkAsyncWorkerBarrierState *async_worker_barrier = NULL;
+    CrucibleHotForkBlockBarrierState *block_barrier = NULL;
+    CrucibleHotForkTemplateState *report = NULL;
+    CrucibleHotForkTemplateOutcome outcome;
+    uint64_t acknowledged;
+    bool seal_barrier_handoff;
+    /* Admission and cancellation own native control listeners under BQL. */
+    g_autoptr(BQLLockAuto) prepare_bql =
+        (action == CRUCIBLE_HOT_FORK_TEMPLATE_ACTION_PREPARE ||
+         action == CRUCIBLE_HOT_FORK_TEMPLATE_ACTION_ABORT ||
+         action == CRUCIBLE_HOT_FORK_TEMPLATE_ACTION_ADOPT_CHILD) ?
+        bql_auto_lock(__FILE__, __LINE__) : NULL;
+
+    g_mutex_lock(&crucible_hot_fork_template_lock);
+    if (crucible_hot_fork_operation_active) {
+        error_setg(errp, "Crucible hot-fork template mutation is closed "
+                   "during a fork operation");
+        goto out;
+    }
+    if (action != CRUCIBLE_HOT_FORK_TEMPLATE_ACTION_PREPARE &&
+        has_block_snapshot_bindings) {
+        error_setg(errp, "Crucible hot-fork block snapshot bindings are "
+                   "valid only for template preparation");
+        goto out;
+    }
+    plugin_barrier = crucible_hot_fork_plugin_barrier(
+        QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_QUERY, errp);
+    if (!plugin_barrier) {
+        goto out;
+    }
+    rcu_barrier = crucible_hot_fork_rcu_barrier(
+        QEMU_RCU_HOT_FORK_BARRIER_QUERY);
+    async_worker_barrier = crucible_hot_fork_async_worker_barrier(
+        QEMU_ASYNC_WORKER_HOT_FORK_BARRIER_QUERY);
+    block_barrier = crucible_hot_fork_block_barrier(
+        QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_QUERY, errp);
+    if (!block_barrier) {
+        goto out;
+    }
+    seal_barrier_handoff = block_barrier->held &&
+        qemu_crucible_block_seal_ready();
+
+    switch (crucible_hot_fork_template_phase) {
+    case CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_IDLE:
+    case CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_COMPLETED:
+        if (crucible_hot_fork_template_active || plugin_barrier->held ||
+            rcu_barrier->held || async_worker_barrier->held ||
+            (block_barrier->held && !seal_barrier_handoff)) {
+            error_setg(errp, "Crucible hot-fork barrier was held outside "
+                       "the template coordinator");
+            goto out;
+        }
+        break;
+    case CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BLOCK_HOLD_PENDING:
+    case CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_CONTROL_DRAIN_PENDING:
+        if (!crucible_hot_fork_template_active || plugin_barrier->held ||
+            rcu_barrier->held || async_worker_barrier->held ||
+            block_barrier->held) {
+            error_setg(errp, "Crucible hot-fork template block-hold "
+                       "transition was inconsistent");
+            goto out;
+        }
+        break;
+    case CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BLOCK_HELD:
+    case CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_SNAPSHOT_BIND_PENDING:
+        if (!crucible_hot_fork_template_active || plugin_barrier->held ||
+            rcu_barrier->held || async_worker_barrier->held ||
+            !block_barrier->held || block_barrier->owner_thread_id <= 0) {
+            error_setg(errp, "Crucible hot-fork template lost its retained "
+                       "block barrier");
+            goto out;
+        }
+        break;
+    case CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BLOCK_RELEASE_PENDING:
+        if (!crucible_hot_fork_template_active || plugin_barrier->held ||
+            rcu_barrier->held || async_worker_barrier->held ||
+            (block_barrier->held && block_barrier->owner_thread_id <= 0) ||
+            (!block_barrier->held && !crucible_hot_fork_template_sources)) {
+            error_setg(errp, "Crucible hot-fork template lost its source recovery owner");
+            goto out;
+        }
+        break;
+    case CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BARRIERS_HELD:
+        if (!crucible_hot_fork_template_active || !plugin_barrier->held ||
+            plugin_barrier->teardown_closed || !rcu_barrier->held ||
+            rcu_barrier->owner_thread_id <= 0 || !async_worker_barrier->held ||
+            async_worker_barrier->owner_thread_id <= 0 ||
+            !block_barrier->held || block_barrier->owner_thread_id <= 0) {
+            error_setg(errp, "Crucible hot-fork template lost a retained "
+                       "subsystem barrier");
+            goto out;
+        }
+        if (!block_barrier->snapshot_complete) {
+            error_setg(errp, "Crucible hot-fork template lost its immutable "
+                       "block snapshot binding");
+            goto out;
+        }
+        break;
+    default:
+        g_assert_not_reached();
+    }
+
+    if (crucible_hot_fork_template_phase ==
+        CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_COMPLETED) {
+        outcome = crucible_hot_fork_template_completion;
+        crucible_hot_fork_template_phase =
+            CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_IDLE;
+        goto make_report;
+    }
+
+    switch (action) {
+    case CRUCIBLE_HOT_FORK_TEMPLATE_ACTION_PREPARE:
+        if (crucible_hot_fork_template_phase ==
+            CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_IDLE) {
+            if (crucible_hot_fork_child_active) {
+                error_setg(errp, "Crucible hot-fork child must be re-adopted "
+                           "before template preparation");
+                goto out;
+            }
+            if (crucible_hot_fork_private_ring_stage.staged ||
+                crucible_hot_fork_plugin_endpoint_stage.staged) {
+                error_setg(errp, "Crucible hot-fork template preparation "
+                           "requires an empty resource stage");
+                goto out;
+            }
+            if (!has_block_snapshot_bindings ||
+                !crucible_hot_fork_template_copy_snapshot_bindings(
+                    block_snapshot_bindings, errp)) {
+                if (!has_block_snapshot_bindings) {
+                    error_setg(errp, "Crucible hot-fork template preparation "
+                               "requires the complete block snapshot binding");
+                }
+                goto out;
+            }
+            if (!runstate_check(RUN_STATE_PAUSED) ||
+                !qemu_plugin_crucible_vmstop_pending() ||
+                qemu_plugin_crucible_vmstop_flush_status() != 0 ||
+                (qemu_plugin_crucible_vmstop_cold_origin() &&
+                 !qemu_crucible_cold_stop_receipt_valid()) ||
+                (seal_barrier_handoff &&
+                 !crucible_hot_fork_exact_paused_boundary())) {
+                g_clear_pointer(
+                    &crucible_hot_fork_template_snapshot_bindings, g_free);
+                crucible_hot_fork_template_snapshot_binding_count = 0;
+                error_setg(errp, "Crucible hot-fork template preparation "
+                           "requires an exact paused/device-flush boundary "
+                           "(runstate=%s, vmstop_pending=%d, "
+                           "vmstop_admission_pending=%d, flush_status=%d, "
+                           "control_outstanding=%d, control_settled=%d, "
+                           "cold_origin=%d, cold_receipt=%d)",
+                           RunState_str(runstate_get()),
+                           qemu_plugin_crucible_vmstop_pending(),
+                           qemu_plugin_crucible_vmstop_admission_pending(),
+                           qemu_plugin_crucible_vmstop_flush_status(),
+                           qemu_plugin_crucible_control_boundary_outstanding(),
+                           qemu_plugin_crucible_control_drain_settled(),
+                           qemu_plugin_crucible_vmstop_cold_origin(),
+                           qemu_crucible_cold_stop_receipt_valid());
+                goto out;
+            }
+            if (!seal_barrier_handoff &&
+                !crucible_hot_fork_template_control_begin(errp)) {
+                g_clear_pointer(
+                    &crucible_hot_fork_template_snapshot_bindings, g_free);
+                crucible_hot_fork_template_snapshot_binding_count = 0;
+                goto out;
+            }
+            crucible_hot_fork_template_failure_stage =
+                CRUCIBLE_HOT_FORK_TEMPLATE_FAILURE_STAGE_NONE;
+            g_clear_pointer(&crucible_hot_fork_template_failure_detail, g_free);
+            crucible_hot_fork_template_active = true;
+            crucible_hot_fork_template_abort_requested = false;
+            /* The seal owns the same quiescent barrier until PREPARE
+             * adopts it; an immediate abort must then release it. */
+            crucible_hot_fork_template_phase = seal_barrier_handoff ?
+                CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BLOCK_HELD :
+                CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_CONTROL_DRAIN_PENDING;
+            crucible_hot_fork_template_generation++;
+            assert(crucible_hot_fork_template_generation != 0);
+            outcome = CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_DRAINING;
+            break;
+        }
+
+        if (!has_block_snapshot_bindings ||
+            !crucible_hot_fork_template_snapshot_bindings_match(
+                block_snapshot_bindings)) {
+            error_setg(errp, "Crucible hot-fork template preparation changed "
+                       "its block snapshot binding");
+            goto out;
+        }
+
+        if (crucible_hot_fork_template_phase ==
+            CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_CONTROL_DRAIN_PENDING) {
+            if (monitor_cur() != crucible_hot_fork_template_control_monitor ||
+                !crucible_hot_fork_template_control_scope_valid()) {
+                error_setg(errp, "Template control drain belongs to its "
+                           "original QMP connection and paused coordinate");
+                goto out;
+            }
+            outcome = CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_DRAINING;
+            break;
+        }
+
+        if (crucible_hot_fork_template_phase ==
+            CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BLOCK_HOLD_PENDING) {
+            crucible_hot_fork_template_schedule_block_transition();
+            outcome = CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_DRAINING;
+            break;
+        }
+
+        if (crucible_hot_fork_template_phase ==
+            CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_SNAPSHOT_BIND_PENDING) {
+            crucible_hot_fork_template_schedule_block_transition();
+            outcome = CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_DRAINING;
+            break;
+        }
+
+        if (crucible_hot_fork_template_phase ==
+            CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BLOCK_RELEASE_PENDING) {
+            crucible_hot_fork_template_schedule_block_transition();
+            outcome = CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_DRAINING;
+            break;
+        }
+
+        if (crucible_hot_fork_template_phase ==
+            CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BLOCK_HELD) {
+            if (!crucible_hot_fork_exact_paused_boundary()) {
+                error_setg(errp, "Crucible hot-fork template lost its exact "
+                           "paused/device-flush boundary");
+                goto out;
+            }
+            if (!block_barrier->snapshot_complete) {
+                if (!block_barrier->quiescent) {
+                    outcome = CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_DRAINING;
+                    break;
+                }
+                crucible_hot_fork_template_phase =
+                    CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_SNAPSHOT_BIND_PENDING;
+                crucible_hot_fork_template_schedule_block_transition();
+                outcome = CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_DRAINING;
+                break;
+            }
+            /*
+             * ram_block_add() marks guest RAM MADV_DONTFORK so helper forks
+             * never duplicate it; a fork child needs that RAM as private
+             * copy-on-write pages.  Make it forkable for the template's
+             * lifetime, before any barrier is held, and refuse the template
+             * outright where that cannot be done.
+             */
+            {
+                int forkable =
+                    qemu_crucible_hot_fork_ram_set_forkable(true);
+
+                if (forkable != 0) {
+                    error_setg_errno(errp, -forkable, "Crucible hot-fork "
+                                     "template cannot make guest RAM forkable");
+                    goto out;
+                }
+            }
+            g_clear_pointer(&rcu_barrier, g_free);
+            rcu_barrier = crucible_hot_fork_rcu_barrier(
+                QEMU_RCU_HOT_FORK_BARRIER_HOLD);
+            g_clear_pointer(&async_worker_barrier, g_free);
+            async_worker_barrier = crucible_hot_fork_async_worker_barrier(
+                QEMU_ASYNC_WORKER_HOT_FORK_BARRIER_HOLD);
+            g_clear_pointer(&plugin_barrier, g_free);
+            plugin_barrier = crucible_hot_fork_plugin_barrier(
+                QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_HOLD, errp);
+            if (!plugin_barrier) {
+                crucible_hot_fork_template_record_failure(
+                    CRUCIBLE_HOT_FORK_TEMPLATE_FAILURE_STAGE_PLUGIN_HOLD,
+                    errp ? *errp : NULL);
+                g_clear_pointer(&async_worker_barrier, g_free);
+                async_worker_barrier = crucible_hot_fork_async_worker_barrier(
+                    QEMU_ASYNC_WORKER_HOT_FORK_BARRIER_RELEASE);
+                g_clear_pointer(&rcu_barrier, g_free);
+                rcu_barrier = crucible_hot_fork_rcu_barrier(
+                    QEMU_RCU_HOT_FORK_BARRIER_RELEASE);
+                crucible_hot_fork_template_completion =
+                    CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_BLOCKED;
+                crucible_hot_fork_template_phase =
+                    CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BLOCK_RELEASE_PENDING;
+                crucible_hot_fork_template_schedule_block_transition();
+                goto out;
+            }
+            crucible_hot_fork_template_phase =
+                CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BARRIERS_HELD;
+        }
+
+        if (!plugin_barrier->quiescent || !rcu_barrier->quiescent ||
+            !async_worker_barrier->quiescent || !block_barrier->quiescent) {
+            outcome = CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_DRAINING;
+            break;
+        }
+        acknowledged = crucible_hot_fork_template_acknowledged_proofs(
+            plugin_barrier, rcu_barrier, async_worker_barrier, block_barrier);
+        if (acknowledged == CRUCIBLE_HOT_FORK_TEMPLATE_REQUIRED_PROOFS) {
+            outcome = CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_PREPARED;
+            break;
+        }
+
+        outcome = CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_DRAINING;
+        break;
+    case CRUCIBLE_HOT_FORK_TEMPLATE_ACTION_QUERY:
+        if (!crucible_hot_fork_template_active) {
+            outcome = CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_IDLE;
+        } else if (plugin_barrier->quiescent && rcu_barrier->quiescent &&
+                   async_worker_barrier->quiescent && block_barrier->quiescent &&
+                   block_barrier->snapshot_complete &&
+                   crucible_hot_fork_template_acknowledged_proofs(
+                       plugin_barrier, rcu_barrier, async_worker_barrier,
+                       block_barrier) ==
+                   CRUCIBLE_HOT_FORK_TEMPLATE_REQUIRED_PROOFS) {
+            outcome = CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_PREPARED;
+        } else {
+            outcome = CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_DRAINING;
+        }
+        break;
+    case CRUCIBLE_HOT_FORK_TEMPLATE_ACTION_ADOPT_CHILD:
+        if (!crucible_hot_fork_adopt_reconstructed_child(errp)) {
+            goto out;
+        }
+        outcome = CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_CHILD_ADOPTED;
+        break;
+    case CRUCIBLE_HOT_FORK_TEMPLATE_ACTION_ABORT:
+        if (!crucible_hot_fork_template_active) {
+            outcome = CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_IDLE;
+            break;
+        }
+
+        if (crucible_hot_fork_template_phase ==
+            CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_CONTROL_DRAIN_PENDING) {
+            crucible_hot_fork_template_complete(
+                CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_ABORTED);
+            outcome = CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_ABORTED;
+            break;
+        }
+
+        if (crucible_hot_fork_template_phase ==
+            CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BLOCK_HOLD_PENDING) {
+            crucible_hot_fork_template_abort_requested = true;
+            crucible_hot_fork_template_schedule_block_transition();
+            outcome = CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_DRAINING;
+            break;
+        }
+
+        if (crucible_hot_fork_template_phase ==
+            CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_SNAPSHOT_BIND_PENDING) {
+            crucible_hot_fork_template_abort_requested = true;
+            crucible_hot_fork_template_schedule_block_transition();
+            outcome = CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_DRAINING;
+            break;
+        }
+
+        if (crucible_hot_fork_template_phase ==
+            CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BLOCK_HELD) {
+            crucible_hot_fork_template_completion =
+                CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_ABORTED;
+            crucible_hot_fork_template_phase =
+                CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BLOCK_RELEASE_PENDING;
+            crucible_hot_fork_template_schedule_block_transition();
+            outcome = CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_DRAINING;
+            break;
+        }
+
+        if (crucible_hot_fork_template_phase ==
+            CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BLOCK_RELEASE_PENDING) {
+            crucible_hot_fork_template_completion =
+                CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_ABORTED;
+            crucible_hot_fork_template_schedule_block_transition();
+            outcome = CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_DRAINING;
+            break;
+        }
+
+        plugin_barrier = crucible_hot_fork_plugin_barrier(
+            QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_RELEASE, errp);
+        if (!plugin_barrier) {
+            goto out;
+        }
+        async_worker_barrier = crucible_hot_fork_async_worker_barrier(
+            QEMU_ASYNC_WORKER_HOT_FORK_BARRIER_RELEASE);
+        rcu_barrier = crucible_hot_fork_rcu_barrier(
+            QEMU_RCU_HOT_FORK_BARRIER_RELEASE);
+        crucible_hot_fork_template_completion =
+            CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_ABORTED;
+        crucible_hot_fork_template_phase =
+            CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BLOCK_RELEASE_PENDING;
+        crucible_hot_fork_template_schedule_block_transition();
+        outcome = CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_DRAINING;
+        break;
+    default:
+        error_setg(errp, "Unknown Crucible hot-fork template action");
+        goto out;
+    }
+
+make_report:
+    report = crucible_hot_fork_template_report(outcome, plugin_barrier,
+                                                rcu_barrier,
+                                                async_worker_barrier,
+                                                block_barrier);
+    plugin_barrier = NULL;
+    rcu_barrier = NULL;
+    async_worker_barrier = NULL;
+    block_barrier = NULL;
+out:
+    g_free(plugin_barrier);
+    g_free(rcu_barrier);
+    g_free(async_worker_barrier);
+    qapi_free_CrucibleHotForkBlockBarrierState(block_barrier);
+    g_mutex_unlock(&crucible_hot_fork_template_lock);
+    return report;
+}
+
+static int crucible_hot_fork_operation_add_excluded_fd(
+    CrucibleHotForkOperation *operation, int descriptor)
+{
+    size_t index = 0;
+
+    if (!operation || descriptor < 0) {
+        return -EINVAL;
+    }
+    while (index < operation->excluded_fd_count &&
+           operation->excluded_fds[index] < descriptor) {
+        index++;
+    }
+    if (index < operation->excluded_fd_count &&
+        operation->excluded_fds[index] == descriptor) {
+        return -EINVAL;
+    }
+    if (operation->excluded_fd_count ==
+        QEMU_CRUCIBLE_HOT_FORK_MAX_RETAINED_DESCRIPTORS) {
+        return -E2BIG;
+    }
+    memmove(&operation->excluded_fds[index + 1],
+            &operation->excluded_fds[index],
+            (operation->excluded_fd_count - index) *
+                sizeof(operation->excluded_fds[0]));
+    operation->excluded_fds[index] = descriptor;
+    operation->excluded_fd_count++;
+    return 0;
+}
+
+/* Whether the child has already been told to close @descriptor. */
+static bool crucible_hot_fork_operation_excludes_fd(
+    const CrucibleHotForkOperation *operation, int descriptor)
+{
+    for (size_t index = 0; index < operation->excluded_fd_count; index++) {
+        if (operation->excluded_fds[index] == descriptor) {
+            return true;
+        }
+        if (operation->excluded_fds[index] > descriptor) {
+            break;
+        }
+    }
+    return false;
+}
+
+static bool crucible_hot_fork_child_files_bound(void)
+{
+    CrucibleHotForkChildFilesStage *stage =
+        &crucible_hot_fork_child_files_stage;
+
+    return stage->staged && !stage->consumed &&
+        stage->template_generation == crucible_hot_fork_template_generation &&
+        stage->files && stage->files->len != 0 &&
+        stage->maximum_bytes != 0;
+}
+
+/* Drops the retained stage; close_descriptors is false only in a fork child. */
+static void crucible_hot_fork_child_files_stage_clear(bool close_descriptors)
+{
+    CrucibleHotForkChildFilesStage *stage =
+        &crucible_hot_fork_child_files_stage;
+    size_t index;
+
+    if (stage->files) {
+        for (index = 0; index < stage->files->len; index++) {
+            CrucibleHotForkChildFileStage *file = &g_array_index(
+                stage->files, CrucibleHotForkChildFileStage, index);
+
+            if (close_descriptors && file->fd >= 0) {
+                close(file->fd);
+            }
+            g_free(file->device);
+            g_free(file->node_name);
+            g_free(file->fdname);
+        }
+        g_array_free(stage->files, true);
+        stage->files = NULL;
+    }
+    stage->staged = false;
+    stage->consumed = false;
+    stage->maximum_bytes = 0;
+    stage->template_generation = 0;
+}
+
+/* Releases a plan the parent prepared but will not hand to a child. */
+static void crucible_hot_fork_discard_child_files(
+    CrucibleHotForkOperation *operation)
+{
+    Error *local_err = NULL;
+
+    if (operation->child_files &&
+        !qemu_block_hot_fork_child_files_free(operation->child_files,
+                                              &local_err)) {
+        /* A retained plan keeps source restoration fail-closed. */
+        error_free(local_err);
+    }
+    operation->child_files = NULL;
+    crucible_hot_fork_child_files_plan = NULL;
+}
+
+/*
+ * Runs on the source main loop inside the fork transaction, after every
+ * generation precondition held. Every frozen native root must resolve to one
+ * staged destination; the prepared plan's descriptors are excluded from the
+ * child's descriptor disposition so adoption can rebind them.
+ */
+static int crucible_hot_fork_prepare_child_files(
+    CrucibleHotForkOperation *operation)
+{
+    CrucibleHotForkChildFilesStage *stage =
+        &crucible_hot_fork_child_files_stage;
+    g_autofree QemuBlockHotForkChildFile *files = NULL;
+    g_autofree int *descriptors = NULL;
+    QemuBlockHotForkChildFiles *plan;
+    Error *local_err = NULL;
+    ssize_t count;
+    size_t index;
+    bool receipt_current;
+
+    g_mutex_lock(&crucible_hot_fork_template_lock);
+    receipt_current = crucible_hot_fork_graph_receipt_current();
+    g_mutex_unlock(&crucible_hot_fork_template_lock);
+    if (!receipt_current) {
+        operation->blocker =
+            "child file plan lacks its current authenticated graph receipt";
+        return -ENOTSUP;
+    }
+    if (!crucible_hot_fork_child_files_bound() ||
+        operation->child_files_generation != stage->generation) {
+        operation->blocker = "native roots require a bound child file plan";
+        return -ENOTSUP;
+    }
+    files = g_new0(QemuBlockHotForkChildFile, stage->files->len);
+    for (index = 0; index < stage->files->len; index++) {
+        CrucibleHotForkChildFileStage *file = &g_array_index(
+            stage->files, CrucibleHotForkChildFileStage, index);
+        BlockDriverState *root =
+            bdrv_lookup_bs(file->device, file->node_name, NULL);
+        struct stat status;
+
+        if (!root ||
+            !qemu_block_hot_fork_source_set_writable_leaf(
+                crucible_hot_fork_template_sources, root,
+                &files[index].node, NULL) ||
+            fstat(file->fd, &status) < 0 ||
+            (uint64_t)status.st_dev != file->expected_device ||
+            (uint64_t)status.st_ino != file->expected_inode) {
+            operation->blocker =
+                "a child file root or destination could not be resolved";
+            return -ENOENT;
+        }
+        files[index].descriptor = file->fd;
+    }
+    plan = qemu_block_hot_fork_child_files_prepare(
+        crucible_hot_fork_template_sources, files, stage->files->len,
+        stage->maximum_bytes, &operation->child_files_error);
+    if (!plan) {
+        operation->blocker = "child-private file copies could not be prepared";
+        return -EIO;
+    }
+    /*
+     * The plan lists every descriptor the child must inherit: the pinned
+     * source descriptors its graph still references, which adoption
+     * queries before it closes them, and the prepared replacements it
+     * reopens.  The child retains every live descriptor it is not told to
+     * close, so nothing is added here; a plan descriptor that an earlier
+     * exclusion would close is a contradiction the fork must not start.
+     */
+    descriptors = g_new0(int, QEMU_CRUCIBLE_HOT_FORK_MAX_RETAINED_DESCRIPTORS);
+    count = qemu_block_hot_fork_child_files_descriptors(
+        plan, descriptors, QEMU_CRUCIBLE_HOT_FORK_MAX_RETAINED_DESCRIPTORS);
+    for (index = 0; count >= 0 && index < (size_t)count; index++) {
+        if (crucible_hot_fork_operation_excludes_fd(
+                operation, descriptors[index])) {
+            count = -1;
+        }
+    }
+    if (count < 0) {
+        if (!qemu_block_hot_fork_child_files_free(plan, &local_err)) {
+            error_free(local_err);
+        }
+        operation->blocker = "child file descriptors exceed the retained "
+                             "bound or collide with a closed descriptor";
+        return -E2BIG;
+    }
+    operation->child_files = plan;
+    crucible_hot_fork_child_files_plan = plan;
+    return 0;
+}
+
+/*
+ * Names the first precondition that blocks a fork preparation.  The checks
+ * mirror the admission condition exactly so a live rejection identifies the
+ * stage whose generation, quiescence, or binding drifted.
+ */
+static const char *crucible_hot_fork_operation_blocker(
+    const CrucibleHotForkOperation *operation,
+    const CrucibleHotForkPluginBarrierState *plugin_barrier,
+    const CrucibleHotForkRcuBarrierState *rcu_barrier,
+    const CrucibleHotForkAsyncWorkerBarrierState *async_worker_barrier,
+    const CrucibleHotForkBlockBarrierState *block_barrier)
+{
+    struct qemu_plugin_crucible_hot_fork_child_plan child_plan = { 0 };
+
+    if (!crucible_hot_fork_operation_active) {
+        return "no fork operation is active";
+    }
+    if (!plugin_barrier || !block_barrier || !rcu_barrier ||
+        !async_worker_barrier) {
+        return "a barrier report is absent";
+    }
+    if (!crucible_hot_fork_template_active ||
+        crucible_hot_fork_template_phase !=
+            CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BARRIERS_HELD) {
+        return "retained template is not in the held-barrier phase";
+    }
+    if (!crucible_hot_fork_exact_paused_boundary()) {
+        return "source is not at the exact paused boundary";
+    }
+    if (operation->template_generation !=
+        crucible_hot_fork_template_generation) {
+        return "template generation differs";
+    }
+    if (operation->private_ring_generation !=
+        crucible_hot_fork_private_ring_stage.generation) {
+        return "private ring generation differs";
+    }
+    if (operation->diagnostic_generation !=
+        crucible_hot_fork_diagnostic_stage.generation) {
+        return "diagnostic generation differs";
+    }
+    if (operation->qmp_generation != crucible_hot_fork_qmp_stage.generation) {
+        return "child QMP generation differs";
+    }
+    if (operation->console_generation !=
+        crucible_hot_fork_console_stage.generation) {
+        return "child console generation differs";
+    }
+    if (operation->monitor_generation !=
+        crucible_hot_fork_qmp_stage.monitor_generation) {
+        return "monitor generation differs";
+    }
+    if (operation->plugin_endpoint_generation !=
+        crucible_hot_fork_plugin_endpoint_stage.generation) {
+        return "plugin endpoint generation differs";
+    }
+    if (operation->plugin_barrier_generation != plugin_barrier->generation ||
+        operation->rcu_barrier_generation != rcu_barrier->generation ||
+        operation->async_worker_barrier_generation !=
+            async_worker_barrier->generation ||
+        operation->block_barrier_generation != block_barrier->generation) {
+        return "a barrier generation differs";
+    }
+    if (!plugin_barrier->quiescent || !rcu_barrier->quiescent ||
+        !async_worker_barrier->quiescent || !block_barrier->quiescent) {
+        return "a barrier is not quiescent";
+    }
+    if (!block_barrier->snapshot_complete) {
+        return "block snapshot binding is incomplete";
+    }
+    if (!crucible_hot_fork_plugin_child_plan_bound(
+            plugin_barrier, NULL, NULL) ||
+        !crucible_hot_fork_current_plugin_child_plan(
+            plugin_barrier, &child_plan)) {
+        return "plugin child plan is not bound";
+    }
+    if (operation->parent_process_generation !=
+            child_plan.parent_process_generation ||
+        operation->child_process_generation !=
+            child_plan.child_process_generation) {
+        return "plugin process generations differ";
+    }
+    if (operation->child_process_contract_generation !=
+        crucible_hot_fork_child_process_contract_stage.generation) {
+        return "child process contract generation differs";
+    }
+    if (operation->child_files_generation !=
+        crucible_hot_fork_child_files_stage.generation) {
+        return "child file plan generation differs";
+    }
+    if (!crucible_hot_fork_child_process_contract_bound()) {
+        return "child process contract is not bound";
+    }
+    if (!crucible_hot_fork_plugin_child_resource_plan_bound(plugin_barrier)) {
+        return "plugin child resource plan is not bound";
+    }
+    if (!crucible_hot_fork_diagnostic_resource_plan_bound()) {
+        return "diagnostic resource plan is not bound";
+    }
+    if (!crucible_hot_fork_qmp_resource_plan_bound()) {
+        return "child QMP resource plan is not bound";
+    }
+    if (!crucible_hot_fork_console_resource_plan_bound()) {
+        return "child console resource plan is not bound";
+    }
+    if (!operation->monitor_basis_verified) {
+        return "child monitor basis was not verified before submission";
+    }
+    return NULL;
+}
+
+static int crucible_hot_fork_prepare_operation(void *opaque)
+{
+    CrucibleHotForkOperation *operation = opaque;
+    CrucibleHotForkPluginBarrierState *plugin_barrier = NULL;
+    CrucibleHotForkRcuBarrierState *rcu_barrier = NULL;
+    CrucibleHotForkAsyncWorkerBarrierState *async_worker_barrier = NULL;
+    CrucibleHotForkBlockBarrierState *block_barrier = NULL;
+    struct qemu_plugin_crucible_hot_fork_child_plan child_plan = { 0 };
+    QIONetListener *listener;
+    int result = -ESTALE;
+
+    if (!operation || operation->prepared) {
+        return -EINVAL;
+    }
+
+    g_mutex_lock(&crucible_hot_fork_template_lock);
+    plugin_barrier = crucible_hot_fork_plugin_barrier(
+        QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_QUERY, NULL);
+    rcu_barrier = crucible_hot_fork_rcu_barrier(
+        QEMU_RCU_HOT_FORK_BARRIER_QUERY);
+    async_worker_barrier = crucible_hot_fork_async_worker_barrier(
+        QEMU_ASYNC_WORKER_HOT_FORK_BARRIER_QUERY);
+    block_barrier = crucible_hot_fork_block_barrier(
+        QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_QUERY, NULL);
+    if (!crucible_hot_fork_operation_active || !plugin_barrier ||
+        !block_barrier || !crucible_hot_fork_template_active ||
+        crucible_hot_fork_template_phase !=
+            CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_BARRIERS_HELD ||
+        !crucible_hot_fork_exact_paused_boundary() ||
+        operation->template_generation !=
+            crucible_hot_fork_template_generation ||
+        operation->private_ring_generation !=
+            crucible_hot_fork_private_ring_stage.generation ||
+        operation->diagnostic_generation !=
+            crucible_hot_fork_diagnostic_stage.generation ||
+        operation->qmp_generation != crucible_hot_fork_qmp_stage.generation ||
+        operation->console_generation !=
+            crucible_hot_fork_console_stage.generation ||
+        operation->monitor_generation !=
+            crucible_hot_fork_qmp_stage.monitor_generation ||
+        operation->plugin_endpoint_generation !=
+            crucible_hot_fork_plugin_endpoint_stage.generation ||
+        operation->plugin_barrier_generation != plugin_barrier->generation ||
+        operation->rcu_barrier_generation != rcu_barrier->generation ||
+        operation->async_worker_barrier_generation !=
+            async_worker_barrier->generation ||
+        operation->block_barrier_generation != block_barrier->generation ||
+        !plugin_barrier->quiescent || !rcu_barrier->quiescent ||
+        !async_worker_barrier->quiescent || !block_barrier->quiescent ||
+        !block_barrier->snapshot_complete ||
+        !crucible_hot_fork_plugin_child_plan_bound(
+            plugin_barrier, NULL, NULL) ||
+        !crucible_hot_fork_current_plugin_child_plan(
+            plugin_barrier, &child_plan) ||
+        operation->parent_process_generation !=
+            child_plan.parent_process_generation ||
+        operation->child_process_generation !=
+            child_plan.child_process_generation ||
+        operation->child_process_contract_generation !=
+            crucible_hot_fork_child_process_contract_stage.generation ||
+        operation->child_files_generation !=
+            crucible_hot_fork_child_files_stage.generation ||
