+/*
+ * Crucible live device fingerprint projection observer
+ *
+ * Copyright (c) 2026 ANDYL Technologies
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include <errno.h>
+#include <fcntl.h>
+#include <glib.h>
+#include <inttypes.h>
+#include <limits.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+#include <qemu-plugin.h>
+#include "crucible-resident-ram.h"
+
+QEMU_PLUGIN_EXPORT int qemu_plugin_version = QEMU_PLUGIN_VERSION;
+
+static int result_fd = -1;
+static int material_fd = -1;
+static int wake_fd = -1;
+static uint64_t sample_count;
+static qemu_plugin_id_t observer_id;
+static gint unmatched_ready_outside_status = -EINPROGRESS;
+
+static void unmatched_ready_outside_exec(unsigned int vcpu_index,
+                                         void *userdata)
+{
+    static const char marker[] = "fingerprint-unrelated-outside";
+    int status;
+
+    (void)vcpu_index;
+    (void)userdata;
+    if (g_atomic_int_get(&unmatched_ready_outside_status) != -EINPROGRESS) {
+        return;
+    }
+    status = qemu_plugin_crucible_fault_ready_marker(
+        marker, sizeof(marker) - 1, UINT64_MAX);
+    g_atomic_int_set(&unmatched_ready_outside_status, status);
+}
+
+static void translate_block(struct qemu_plugin_tb *tb, void *userdata)
+{
+    (void)userdata;
+    qemu_plugin_register_vcpu_tb_exec_cb(
+        tb, unmatched_ready_outside_exec, QEMU_PLUGIN_CB_NO_REGS, NULL);
+}
+
+static void publish_icount(uint64_t icount, void *userdata)
+{
+    (void)icount;
+    (void)userdata;
+}
+
+static uint64_t max_advance_icount(void *userdata)
+{
+    (void)userdata;
+    return UINT64_MAX;
+}
+
+static int send_material(int fd)
+{
+    struct cmsghdr *control;
+    char control_buffer[CMSG_SPACE(sizeof(fd))] = { 0 };
+    char payload = 'M';
+    struct iovec iov = {
+        .iov_base = &payload,
+        .iov_len = sizeof(payload),
+    };
+    struct msghdr message = {
+        .msg_iov = &iov,
+        .msg_iovlen = 1,
+        .msg_control = control_buffer,
+        .msg_controllen = sizeof(control_buffer),
+    };
+
+    control = CMSG_FIRSTHDR(&message);
+    control->cmsg_level = SOL_SOCKET;
+    control->cmsg_type = SCM_RIGHTS;
+    control->cmsg_len = CMSG_LEN(sizeof(fd));
+    memcpy(CMSG_DATA(control), &fd, sizeof(fd));
+    return sendmsg(material_fd, &message, MSG_NOSIGNAL) == 1 ? 0 : -errno;
+}
+
+static void vcpu_idle(unsigned int vcpu_index, uint64_t icount,
+                      void *userdata)
+{
+    (void)userdata;
+    dprintf(result_fd, "idle vcpu=%u icount=%" PRIu64 "\n",
+            vcpu_index, icount);
+}
+
+static void vcpu_resumed(unsigned int vcpu_index, uint64_t icount,
+                         void *userdata)
+{
+    (void)icount;
+    (void)userdata;
+    dprintf(result_fd, "resume vcpu=%u\n", vcpu_index);
+}
+
+static int hash_fd(int fd, uint8_t digest[32])
+{
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    uint8_t buffer[64 * 1024];
+    gsize digest_length = 32;
+
+    if (!checksum || lseek(fd, 0, SEEK_SET) != 0) {
+        return -EIO;
+    }
+    for (;;) {
+        ssize_t count = read(fd, buffer, sizeof(buffer));
+
+        if (count > 0) {
+            g_checksum_update(checksum, buffer, count);
+        } else if (count == 0) {
+            break;
+        } else if (errno != EINTR) {
+            return -errno;
+        }
+    }
+    g_checksum_get_digest(checksum, digest, &digest_length);
+    return digest_length == 32 ? 0 : -EIO;
+}
+
+static int capture_material(
+    struct qemu_plugin_crucible_fingerprint_v2 *material,
+    QemuCrucibleFingerprintMaterialRef *native, bool close_uncertain)
+{
+    if (native->owner || native->serial || material->device_fd >= 0 || close_uncertain) {
+        return -EBUSY;
+    }
+    return qemu_plugin_crucible_capture_fingerprint_v4(material, native);
+}
+
+static int hash_material(
+    const struct qemu_plugin_crucible_fingerprint_v2 *material,
+    const QemuCrucibleFingerprintMaterialRef *native, uint8_t digest[32])
+{
+    /* This diagnostic observer has no matched worker pipeline. A native
+     * material owner cannot lend its borrowed FD to the old direct reader. */
+    return native->owner ? -ENOTSUP : hash_fd(material->device_fd, digest);
+}
+
+static int close_material(
+    struct qemu_plugin_crucible_fingerprint_v2 *material,
+    QemuCrucibleFingerprintMaterialRef *native, bool *close_uncertain)
+{
+    if (native->owner) {
+        /* The real control-boundary BH invokes this on Main. Negative return
+         * retains both the actual Source owner and its borrowed FD output. */
+        int status = qemu_plugin_crucible_fingerprint_material_return_v2(
+            observer_id, native);
+
+        if (status) {
+            return status;
+        }
+        material->device_fd = -1;
+        return 0;
+    }
+    if (*close_uncertain) {
+        return -EIO;
+    }
+    if (material->device_fd >= 0) {
+        if (close(material->device_fd) < 0) {
+            *close_uncertain = true;
+            return -errno;
+        }
+        material->device_fd = -1;
+    }
+    return 0;
+}
+
+static void digest_hex(const uint8_t digest[32], char hex[65])
+{
+    static const char digits[] = "0123456789abcdef";
+
+    for (size_t i = 0; i < 32; i++) {
+        hex[i * 2] = digits[digest[i] >> 4];
+        hex[i * 2 + 1] = digits[digest[i] & 0xf];
+    }
+    hex[64] = '\0';
+}
+
+static bool ram_material_equal(
+    const struct qemu_plugin_crucible_fingerprint_v2 *first,
+    const struct qemu_plugin_crucible_fingerprint_v2 *second)
+{
+    return first->schema == 2 && second->schema == 2 &&
+           first->logical_edition == 1 && second->logical_edition == 1 &&
+           first->ram_scope == 0 && second->ram_scope == 0 &&
+           !first->reserved && !second->reserved && first->ram_bytes &&
+           first->ram_bytes == second->ram_bytes &&
+           memcmp(first->ram_digest, second->ram_digest,
+                  sizeof(first->ram_digest)) == 0;
+}
+
+static void control_boundary(unsigned int vcpu_index, uint64_t icount,
+                             void *userdata)
+{
+    static const char unrelated_marker[] = "fingerprint-unrelated";
+    /* Outputs remain in these actual module fields across negative cleanup.
+     * A later callback cannot overwrite an owner or an uncertain FD close. */
+    static struct qemu_plugin_crucible_fingerprint_v2 first = {
+        .device_fd = -1,
+    };
+    static struct qemu_plugin_crucible_fingerprint_v2 second = {
+        .device_fd = -1,
+    };
+    static struct qemu_plugin_crucible_fingerprint_v2 paused_first = {
+        .device_fd = -1,
+    };
+    static struct qemu_plugin_crucible_fingerprint_v2 paused_second = {
+        .device_fd = -1,
+    };
+    static QemuCrucibleFingerprintMaterialRef first_native;
+    static QemuCrucibleFingerprintMaterialRef second_native;
+    static QemuCrucibleFingerprintMaterialRef paused_first_native;
+    static QemuCrucibleFingerprintMaterialRef paused_second_native;
+    static bool first_close_uncertain;
+    static bool second_close_uncertain;
+    static bool paused_first_close_uncertain;
+    static bool paused_second_close_uncertain;
+    uint8_t first_digest[32] = { 0 };
+    uint8_t second_digest[32] = { 0 };
+    char first_hex[65];
+    char second_hex[65];
+    char ram_hex[65];
+    bool stable;
+    int first_status;
+    int second_status;
+    int first_hash_status = -EIO;
+    int second_hash_status = -EIO;
+    int paused_first_status = -EAGAIN;
+    int paused_second_status = -EAGAIN;
+    int paused_first_hash_status = -EAGAIN;
+    int paused_second_hash_status = -EAGAIN;
+    int material_status = -EIO;
+    int stop_status;
+    int unmatched_ready_status;
+    int unmatched_ready_outside;
+    int first_cleanup_status;
+    int second_cleanup_status;
+    int paused_first_cleanup_status;
+    int paused_second_cleanup_status;
+    bool paused_stable = false;
+
+    (void)userdata;
+    unmatched_ready_outside =
+        g_atomic_int_get(&unmatched_ready_outside_status);
+    unmatched_ready_status = qemu_plugin_crucible_fault_ready_marker(
+        unrelated_marker, sizeof(unrelated_marker) - 1,
+        icount == 0 ? UINT64_MAX : icount - 1);
+    first_status = capture_material(&first, &first_native, first_close_uncertain);
+    if (first_status == 0) {
+        first_hash_status = hash_material(&first, &first_native, first_digest);
+    }
+    second_status = capture_material(&second, &second_native,
+                                    second_close_uncertain);
+    if (second_status == 0) {
+        second_hash_status = hash_material(&second, &second_native, second_digest);
+    }
+
+    stable = first_status == 0 && second_status == 0 &&
+             first_hash_status == 0 && second_hash_status == 0 &&
+             ram_material_equal(&first, &second) &&
+             first.device_material_length == second.device_material_length &&
+             first.device_bytes == second.device_bytes &&
+             first.device_schema_sections == second.device_schema_sections &&
+             memcmp(first.device_schema_digest, second.device_schema_digest,
+                    sizeof(first.device_schema_digest)) == 0 &&
+             memcmp(first_digest, second_digest, sizeof(first_digest)) == 0;
+    if (stable) {
+        material_status = send_material(first.device_fd);
+    }
+    digest_hex(first_digest, first_hex);
+    digest_hex(second_digest, second_hex);
+    digest_hex(first.ram_digest, ram_hex);
+    stop_status = qemu_plugin_request_vmstop();
+    if (sample_count == 0 && stop_status == 0) {
+        uint8_t paused_first_digest[32] = { 0 };
+        uint8_t paused_second_digest[32] = { 0 };
+
+        paused_first_status =
+            capture_material(&paused_first, &paused_first_native,
+                             paused_first_close_uncertain);
+        if (paused_first_status == 0) {
+            paused_first_hash_status =
+                hash_material(&paused_first, &paused_first_native,
+                              paused_first_digest);
+        }
+        paused_second_status =
+            capture_material(&paused_second, &paused_second_native,
+                             paused_second_close_uncertain);
+        if (paused_second_status == 0) {
+            paused_second_hash_status =
+                hash_material(&paused_second, &paused_second_native,
+                              paused_second_digest);
+        }
+        paused_stable = paused_first_status == 0 &&
+            paused_second_status == 0 && paused_first_hash_status == 0 &&
+            paused_second_hash_status == 0 &&
+            ram_material_equal(&paused_first, &paused_second) &&
+            paused_first.device_material_length ==
+                paused_second.device_material_length &&
+            paused_first.device_bytes == paused_second.device_bytes &&
+            paused_first.device_schema_sections ==
+                paused_second.device_schema_sections &&
+            memcmp(paused_first.device_schema_digest,
+                   paused_second.device_schema_digest,
+                   sizeof(paused_first.device_schema_digest)) == 0 &&
+            memcmp(paused_first_digest, paused_second_digest,
+                   sizeof(paused_first_digest)) == 0;
+    }
+
+    first_cleanup_status = close_material(
+        &first, &first_native, &first_close_uncertain);
+    second_cleanup_status = close_material(
+        &second, &second_native, &second_close_uncertain);
+    paused_first_cleanup_status = close_material(
+        &paused_first, &paused_first_native, &paused_first_close_uncertain);
+    paused_second_cleanup_status = close_material(
+        &paused_second, &paused_second_native, &paused_second_close_uncertain);
+
+    dprintf(result_fd,
+            "sample=%" PRIu64 " vcpu=%u icount=%" PRIu64
+            " capture=%d/%d hash=%d/%d stable=%s digest=%s repeat=%s"
+            " bytes=%" PRIu64 " sections=%" PRIu64
+            " material=%d stop=%d paused=%d/%d paused_hash=%d/%d"
+            " paused_stable=%s unmatched_ready=%d"
+            " unmatched_ready_outside=%d ram_schema=%u ram_edition=%u"
+            " ram_scope=%u ram_bytes=%" PRIu64 " ram_digest=%s"
+            " cleanup=%d/%d/%d/%d\n",
+            sample_count++, vcpu_index, icount, first_status, second_status,
+            first_hash_status, second_hash_status, stable ? "true" : "false",
+            first_hex, second_hex,
+            first_status == 0 ? first.device_material_length : 0,
+            first_status == 0 ? first.device_schema_sections : 0,
+            material_status, stop_status, paused_first_status,
+            paused_second_status, paused_first_hash_status,
+            paused_second_hash_status, paused_stable ? "true" : "false",
+            unmatched_ready_status, unmatched_ready_outside, first.schema,
+            first.logical_edition, first.ram_scope, first.ram_bytes, ram_hex,
+            first_cleanup_status, second_cleanup_status,
+            paused_first_cleanup_status, paused_second_cleanup_status);
+}
+
+static bool parse_fd(const char *argument, const char *prefix, int *fd)
+{
+    char *end = NULL;
+    gint64 value;
+
+    if (!g_str_has_prefix(argument, prefix)) {
+        return false;
+    }
+    errno = 0;
+    value = g_ascii_strtoll(argument + strlen(prefix), &end, 10);
+    if (errno != 0 || !end || *end != '\0' || value < 0 || value > INT_MAX) {
+        return false;
+    }
+    *fd = value;
+    return true;
+}
+
+QEMU_PLUGIN_EXPORT int qemu_plugin_install(qemu_plugin_id_t id,
+                                           const qemu_info_t *info,
+                                           int argc, char **argv)
+{
+    (void)info;
+    observer_id = id;
+
+    for (int i = 0; i < argc; i++) {
+        if (!parse_fd(argv[i], "result-fd=", &result_fd)) {
+            if (!parse_fd(argv[i], "wake-fd=", &wake_fd)) {
+                parse_fd(argv[i], "material-fd=", &material_fd);
+            }
+        }
+    }
+    if (result_fd < 0 || material_fd < 0 || wake_fd < 0 ||
+        !qemu_plugin_request_time_control() ||
+        qemu_plugin_register_wake_fd(wake_fd) != 0 ||
+        crucible_fixture_install_resident_ram() != 0) {
+        return -1;
+    }
+
+    qemu_plugin_register_sim_shmem_dispatch_cb(
+        publish_icount, max_advance_icount, max_advance_icount, NULL);
+    qemu_plugin_register_vcpu_idle_resume_cb(vcpu_idle, vcpu_resumed, NULL);
+    qemu_plugin_register_control_boundary_cb(control_boundary, NULL);
+    qemu_plugin_register_vcpu_tb_trans_cb(id, translate_block, NULL);
+    return 0;
+}
diff --git a/tests/tcg/plugins/crucible-idle-wait-liveness.c b/tests/tcg/plugins/crucible-idle-wait-liveness.c
new file mode 100644
index 0000000000000000000000000000000000000000..296fe7b3ef2309a58d615c03d6cfed9c2945659b
--- /dev/null
+++ b/tests/tcg/plugins/crucible-idle-wait-liveness.c
@@ -0,0 +1,355 @@
+/*
+ * Crucible idle-wait liveness test plugin
+ *
+ * Copyright (c) Andyl, Inc.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include <stdatomic.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+#include <qemu-plugin.h>
+#include "crucible-resident-ram.h"
+
+QEMU_PLUGIN_EXPORT int qemu_plugin_version = QEMU_PLUGIN_VERSION;
+
+static _Atomic uint32_t wake_signal;
+static _Atomic uint64_t idle_icount;
+static _Atomic bool control_observed;
+static _Atomic uint64_t control_generation;
+static _Atomic bool observer_vmstop_requested;
+static _Atomic bool time_advance_requested;
+static _Atomic bool time_advance_completed;
+static _Atomic bool control_nonfirst_owner_published;
+static _Atomic bool control_nonfirst_arm_observed;
+static _Atomic bool control_at_first_dispatch_requested;
+static _Atomic bool control_time_advance_requested;
+static _Atomic uint32_t active_host_ready_dispatches;
+
+struct SharedState {
+    _Atomic uint32_t control_armed;
+    _Atomic uint32_t active_host_ready_release;
+    _Atomic uint64_t dispatch_ceiling;
+    _Atomic uint32_t active_host_ready_arm;
+    _Atomic uint32_t active_host_ready_disable_after;
+};
+
+static struct SharedState *shared_state;
+static bool control_nonfirst_wait;
+static bool dispatch_ceiling_mode;
+static uint64_t observer_vmstop_icount = UINT64_MAX;
+static uint64_t time_advance_target = UINT64_MAX;
+static uint64_t control_time_advance_target = UINT64_MAX;
+static bool control_at_first_dispatch;
+static bool active_host_ready;
+static int marker_fd = -1;
+static int state_fd = -1;
+static int wake_fd = -1;
+
+static void write_marker(const char *marker, size_t length)
+{
+    if (write(marker_fd, marker, length) != (ssize_t)length) {
+        _exit(91);
+    }
+}
+
+static void vcpu_init_callback(unsigned int vcpu_index, void *userdata)
+{
+    char marker[2] = {'W', (char)vcpu_index};
+
+    (void)userdata;
+    write_marker(marker, sizeof(marker));
+}
+
+static void idle_callback(unsigned int vcpu_index, uint64_t icount,
+                          void *userdata)
+{
+    uint32_t expected;
+    uint64_t park_thread = (uint64_t)gettid();
+    uint64_t park_address = (uint64_t)(uintptr_t)&wake_signal;
+    char park[17] = {'P'};
+    enum qemu_plugin_crucible_idle_wait_status wait_status;
+    char result[2];
+
+    (void)userdata;
+    atomic_store_explicit(&idle_icount, icount, memory_order_release);
+    if (control_nonfirst_wait) {
+        uint32_t control_state;
+        char owner[2] = {'N', (char)vcpu_index};
+
+        if (vcpu_index != 1) {
+            return;
+        }
+        if (!atomic_exchange_explicit(&control_nonfirst_owner_published,
+                                      true, memory_order_relaxed)) {
+            write_marker(owner, sizeof(owner));
+        }
+        if (!atomic_load_explicit(&control_nonfirst_arm_observed,
+                                  memory_order_acquire)) {
+            control_state = atomic_load_explicit(
+                &shared_state->control_armed, memory_order_acquire);
+            if (control_state == 0) {
+                return;
+            }
+            if (control_state != 1) {
+                _exit(93);
+            }
+            if (!atomic_exchange_explicit(&control_nonfirst_arm_observed,
+                                          true, memory_order_acq_rel)) {
+                write_marker("K", 1);
+            }
+        }
+    }
+    if (time_advance_target != UINT64_MAX) {
+        if (!atomic_exchange_explicit(&time_advance_requested, true,
+                                      memory_order_acq_rel)) {
+            if (qemu_plugin_advance_time_ticks((int64_t)time_advance_target) != 0) {
+                _exit(92);
+            }
+            return;
+        }
+        if (!atomic_load_explicit(&time_advance_completed,
+                                  memory_order_acquire)) {
+            return;
+        }
+    }
+    memcpy(&park[1], &park_thread, sizeof(park_thread));
+    memcpy(&park[9], &park_address, sizeof(park_address));
+    if (control_nonfirst_wait) {
+        write_marker(park, sizeof(park));
+        expected = atomic_load_explicit(&wake_signal, memory_order_acquire);
+    } else {
+        expected = atomic_load_explicit(&wake_signal, memory_order_acquire);
+        write_marker(park, sizeof(park));
+    }
+    wait_status = qemu_plugin_crucible_wait_idle_wake(
+        vcpu_index, (uint32_t *)&wake_signal, expected);
+    if (atomic_load_explicit(&shared_state->control_armed,
+                             memory_order_acquire) == 2 &&
+        !atomic_load_explicit(&control_observed, memory_order_acquire)) {
+        write_marker("E", 1);
+    }
+    result[0] = 'R';
+    result[1] = (char)wait_status;
+    write_marker(result, sizeof(result));
+}
+
+static void time_advance_callback(int status, int64_t target, void *userdata)
+{
+    char marker[17] = {'A'};
+
+    (void)userdata;
+    atomic_store_explicit(&time_advance_completed, true, memory_order_release);
+    memcpy(&marker[1], &status, sizeof(status));
+    memcpy(&marker[9], &target, sizeof(target));
+    write_marker(marker, sizeof(marker));
+}
+
+static void resume_callback(unsigned int vcpu_index, uint64_t icount,
+                            void *userdata)
+{
+    (void)vcpu_index;
+    (void)icount;
+    (void)userdata;
+}
+
+static void control_callback(unsigned int vcpu_index, uint64_t icount,
+                             void *userdata)
+{
+    uint64_t generation = atomic_fetch_add_explicit(
+                              &control_generation, 1,
+                              memory_order_relaxed) + 1;
+    char marker[17] = {'C'};
+
+    (void)vcpu_index;
+    (void)userdata;
+    memcpy(&marker[1], &icount, sizeof(icount));
+    memcpy(&marker[9], &generation, sizeof(generation));
+    write_marker(marker, sizeof(marker));
+    atomic_store_explicit(&control_observed, true, memory_order_release);
+    if (control_time_advance_target != UINT64_MAX &&
+        !atomic_exchange_explicit(&control_time_advance_requested, true,
+                                  memory_order_acq_rel)) {
+        int32_t status = qemu_plugin_advance_time_ticks(
+            (int64_t)control_time_advance_target);
+        uint64_t completion_icount = qemu_plugin_icount_raw();
+        char completion[13] = {'Q'};
+
+        memcpy(&completion[1], &status, sizeof(status));
+        memcpy(&completion[5], &completion_icount,
+               sizeof(completion_icount));
+        write_marker(completion, sizeof(completion));
+        if (status != 0) {
+            _exit(95);
+        }
+    }
+}
+
+static void publish_icount_callback(uint64_t icount, void *userdata)
+{
+    char marker[9] = {'D'};
+    uint32_t active_dispatch;
+
+    (void)userdata;
+    if (dispatch_ceiling_mode) {
+        memcpy(&marker[1], &icount, sizeof(icount));
+        write_marker(marker, sizeof(marker));
+    }
+    /* The first boundary completes startup; hold each armed later boundary. */
+    if (active_host_ready) {
+        active_dispatch = atomic_fetch_add_explicit(
+            &active_host_ready_dispatches, 1, memory_order_relaxed);
+        if (active_dispatch != 0) {
+            uint32_t armed_dispatch;
+            uint32_t disable_after = atomic_load_explicit(
+                &shared_state->active_host_ready_disable_after,
+                memory_order_acquire);
+
+            if (disable_after == 0 || active_dispatch <= disable_after) {
+                do {
+                    armed_dispatch = atomic_load_explicit(
+                        &shared_state->active_host_ready_arm,
+                        memory_order_acquire);
+                } while (armed_dispatch < active_dispatch);
+                while (atomic_load_explicit(
+                           &shared_state->active_host_ready_release,
+                           memory_order_acquire) < active_dispatch) {
+                }
+            }
+        }
+    }
+    if (control_at_first_dispatch &&
+        !atomic_exchange_explicit(&control_at_first_dispatch_requested, true,
+                                  memory_order_acq_rel) &&
+        qemu_plugin_request_control_boundary() != 0) {
+        _exit(94);
+    }
+}
+
+static void observer_callback(uint64_t icount, void *userdata)
+{
+    int32_t status;
+    char marker[5] = {'V'};
+
+    (void)userdata;
+    if (icount != observer_vmstop_icount ||
+        atomic_exchange_explicit(&observer_vmstop_requested, true,
+                                 memory_order_acq_rel)) {
+        return;
+    }
+
+    status = qemu_plugin_request_vmstop();
+    memcpy(&marker[1], &status, sizeof(status));
+    write_marker(marker, sizeof(marker));
+}
+
+static uint64_t observer_max_icount_callback(void *userdata)
+{
+    (void)userdata;
+    if (atomic_load_explicit(&observer_vmstop_requested,
+                             memory_order_acquire)) {
+        return UINT64_MAX;
+    }
+    return observer_vmstop_icount;
+}
+
+static uint64_t max_advance_icount_callback(void *userdata)
+{
+    (void)userdata;
+    if (dispatch_ceiling_mode) {
+        return atomic_load_explicit(&shared_state->dispatch_ceiling,
+                                    memory_order_acquire);
+    }
+    if (!control_nonfirst_wait &&
+        atomic_load_explicit(&shared_state->control_armed,
+                             memory_order_acquire) != 0) {
+        return atomic_load_explicit(&idle_icount, memory_order_acquire);
+    }
+    return UINT64_MAX;
+}
+
+static uint64_t logical_ceiling_callback(void *userdata)
+{
+    uint64_t raw = qemu_plugin_icount_raw();
+    uint64_t raw_ceiling = max_advance_icount_callback(userdata);
+    int64_t tick = qemu_plugin_sim_tick_observed();
+
+    if (tick < 0) {
+        return 0;
+    }
+    if (raw_ceiling <= raw) {
+        return tick;
+    }
+    if (raw_ceiling - raw > UINT64_MAX - (uint64_t)tick) {
+        return UINT64_MAX;
+    }
+    return (uint64_t)tick + raw_ceiling - raw;
+}
+
+QEMU_PLUGIN_EXPORT int qemu_plugin_install(qemu_plugin_id_t id,
+                                           const qemu_info_t *info,
+                                           int argc, char **argv)
+{
+    int index;
+
+    (void)id;
+    (void)info;
+    for (index = 0; index < argc; index++) {
+        if (strncmp(argv[index], "marker-fd=", 10) == 0) {
+            marker_fd = atoi(argv[index] + 10);
+        } else if (strncmp(argv[index], "state-fd=", 9) == 0) {
+            state_fd = atoi(argv[index] + 9);
+        } else if (strncmp(argv[index], "wake-fd=", 8) == 0) {
+            wake_fd = atoi(argv[index] + 8);
+        } else if (strcmp(argv[index], "dispatch-ceiling=true") == 0) {
+            dispatch_ceiling_mode = true;
+        } else if (strcmp(argv[index], "control-nonfirst-wait=true") == 0) {
+            control_nonfirst_wait = true;
+        } else if (strncmp(argv[index], "vmstop-at-observer=", 19) == 0) {
+            observer_vmstop_icount = strtoull(argv[index] + 19, NULL, 0);
+        } else if (strncmp(argv[index], "time-advance-target=", 20) == 0) {
+            time_advance_target = strtoull(argv[index] + 20, NULL, 0);
+        } else if (strncmp(argv[index], "control-time-advance-target=",
+                           28) == 0) {
+            control_time_advance_target = strtoull(argv[index] + 28, NULL, 0);
+        } else if (strcmp(argv[index], "active-host-ready=true") == 0) {
+            active_host_ready = true;
+        } else if (strcmp(argv[index],
+                          "control-at-first-dispatch=true") == 0) {
+            control_at_first_dispatch = true;
+        }
+    }
+    if (marker_fd < 0 || state_fd < 0 || wake_fd < 0 ||
+        !qemu_plugin_request_time_control() ||
+        qemu_plugin_register_wake_fd(wake_fd) != 0 ||
+        crucible_fixture_install_resident_ram() != 0) {
+        return -1;
+    }
+    shared_state = mmap(NULL, sizeof(*shared_state), PROT_READ,
+                        MAP_SHARED, state_fd, 0);
+    if (shared_state == MAP_FAILED) {
+        shared_state = NULL;
+        return -1;
+    }
+
+    qemu_plugin_register_vcpu_init_cb(id, vcpu_init_callback, NULL);
+    qemu_plugin_register_sim_shmem_dispatch_cb(publish_icount_callback,
+                                                max_advance_icount_callback,
+                                                logical_ceiling_callback,
+                                                NULL);
+    qemu_plugin_register_sim_shmem_observer_cb(
+        observer_callback, observer_max_icount_callback, NULL);
+    qemu_plugin_register_vcpu_idle_resume_cb(idle_callback, resume_callback,
+                                             NULL);
+    qemu_plugin_register_control_boundary_cb(control_callback, NULL);
+    if ((time_advance_target != UINT64_MAX ||
+         control_time_advance_target != UINT64_MAX) &&
+        qemu_plugin_register_time_advance_cb(time_advance_callback, NULL) != 0) {
+        return -1;
+    }
+    return 0;
+}
diff --git a/tests/tcg/plugins/crucible-instruction.c b/tests/tcg/plugins/crucible-instruction.c
