+static const struct qemu_plugin_crucible_fault_register_capability *
+test_select_register(
+    const struct qemu_plugin_crucible_fault_register_capability *rows,
+    size_t count)
+{
+    for (size_t i = 0; i < count; i++) {
+        if (strcmp(rows[i].name, test_register_name) == 0 &&
+            (rows[i].capabilities & 1) != 0 &&
+            (test_mode != TEST_MODE_PERSISTENT ||
+             (rows[i].capabilities & 2) != 0)) {
+            return &rows[i];
+        }
+    }
+    return NULL;
+}
