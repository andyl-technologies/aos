+/*
+ * Literal HPPA interval timer and migration with a controlled clock.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/main-loop.h"
+#include "system/cpu-timers.h"
+#include "io/channel-buffer.h"
+#include "../../migration/qemu-file.h"
+#include "migration/savevm.h"
+#include "../../target/hppa/sys_helper.c"
+#include "../../target/hppa/machine.c"
+
+static __int128 observed_ps;
+static unsigned callbacks;
+static const char *program_path;
+
+int64_t cpu_get_clock(void)
+{
+    g_assert_true(observed_ps / 1000 <= INT64_MAX);
+    g_assert_true(observed_ps / 1000 >= INT64_MIN);
+    return observed_ps / 1000;
+}
+
+bool icount_crucible_sim_mode(void)
+{
+    return false;
+}
+
+static __int128 observed_clock_ps(void)
+{
+    return observed_ps;
+}
+
+static void timer_consumer(void *opaque)
+{
+    callbacks++;
+}
+
+static void initialize_clock(bool precise)
+{
+    Error *error = NULL;
+
+    module_call_init(MODULE_INIT_QOM);
+    qemu_init_main_loop(&error);
+    g_assert_null(error);
+    if (precise) {
+        qemu_timer_enable_tcg_ps_clock(NULL, observed_clock_ps);
+    }
+    qemu_clock_enable(QEMU_CLOCK_VIRTUAL, true);
+}
+
+static GByteArray *save_state(const VMStateDescription *description,
+                             void *state)
+{
+    QIOChannelBuffer *output = qio_channel_buffer_new(4096);
+    QEMUFile *file = qemu_file_new_output(QIO_CHANNEL(output));
+    GByteArray *bytes = g_byte_array_new();
+    Error *error = NULL;
+
+    g_assert_cmpint(vmstate_save_state(file, description, state, NULL,
+                                      &error), ==, 0);
+    g_assert_null(error);
+    qemu_put_byte(file, QEMU_VM_EOF);
+    g_assert_cmpint(qemu_fflush(file), ==, 0);
+    g_byte_array_append(bytes, output->data, output->usage);
+    g_assert_cmpint(qemu_fclose(file), ==, 0);
+    object_unref(OBJECT(output));
+    return bytes;
+}
+
+static int load_state(const VMStateDescription *description, void *state,
+                      GByteArray *bytes)
+{
+    QIOChannelBuffer *input = qio_channel_buffer_new(bytes->len);
+    QEMUFile *file;
+    int status;
+
+    memcpy(input->data, bytes->data, bytes->len);
+    input->usage = bytes->len;
+    file = qemu_file_new_input(QIO_CHANNEL(input));
+    status = vmstate_load_state(file, description, state,
+                                description->version_id, NULL);
+    qemu_fclose(file);
+    object_unref(OBJECT(input));
+    return status;
+}
+
+/* Production timer hooks/subsection; CPU registers, TLBs and IRQ effects are
+ * excluded. The callback is an explicit diagnostic consumer of real timers.
+ */
+static const VMStateDescription timer_fixture = {
+    .name = "cpu",
+    .version_id = 2,
+    .minimum_version_id = 1,
+    .pre_save = hppa_cpu_pre_save,
+    .pre_load = hppa_cpu_pre_load,
+    .post_load = hppa_cpu_post_load,
+    .fields = (const VMStateField[]) {
+        VMSTATE_END_OF_LIST(),
+    },
+    .subsections = (const VMStateDescription * const[]) {
+        &vmstate_hppa_alarm_timer_wide,
+        NULL,
+    },
+};
+
+static void initialize_timer(HPPACPU *cpu)
+{
+    cpu->alarm_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, timer_consumer, NULL);
+}
+
+static __int128 wide_time(int64_t hi, uint64_t lo)
+{
+    return (__int128)hi * ((__int128)1 << 64) + lo;
+}
+
+typedef struct IntervalCase {
+    int64_t origin_hi;
+    uint64_t origin_lo;
+    uint32_t compare;
+    uint64_t ticks;
+    int64_t deadline_hi;
+    uint64_t deadline_lo;
+} IntervalCase;
+
+/* Constants come from unbounded floor(time_ps/4000) and modulo32 distance. */
+static const IntervalCase interval_cases[] = {
+    { INT64_MIN, UINT64_C(357), UINT32_C(893353697),
+      UINT64_C(885443715538058477), INT64_MIN, UINT64_C(1997728) },
+    { INT64_MIN, UINT64_C(357), UINT32_C(893352697),
+      UINT64_C(885443715538058477), INT64_MIN, UINT64_C(17179867181728) },
+    { INT64_C(72057594037927936), UINT64_C(357), UINT32_C(1133871866),
+      UINT64_C(18151596168530198790), INT64_C(72057594037927936), UINT64_C(1999424) },
+    { INT64_C(72057594037927936), UINT64_C(357), UINT32_C(1133870866),
+      UINT64_C(18151596168530198790), INT64_C(72057594037927936), UINT64_C(17179867183424) },
+    { INT64_C(-72057594037927936), UINT64_C(357), UINT32_C(3161096429),
+      UINT64_C(295147905179352825), INT64_C(-72057594037927936), UINT64_C(1996576) },
+    { INT64_C(-72057594037927936), UINT64_C(357), UINT32_C(3161095429),
+      UINT64_C(295147905179352825), INT64_C(-72057594037927936), UINT64_C(17179867180576) },
+    { INT64_C(-1), UINT64_C(18446744073709551615), UINT32_C(499),
+      UINT64_C(18446744073709551615), INT64_C(0), UINT64_C(1996000) },
+    { INT64_C(-1), UINT64_C(18446744073709551615), UINT32_C(4294966795),
+      UINT64_C(18446744073709551615), INT64_C(0), UINT64_C(17179867180000) },
+    { INT64_C(-1), UINT64_C(18446744073709547616), UINT32_C(499),
+      UINT64_C(18446744073709551615), INT64_C(0), UINT64_C(1996000) },
+    { INT64_C(-1), UINT64_C(18446744073709547616), UINT32_C(4294966795),
+      UINT64_C(18446744073709551615), INT64_C(0), UINT64_C(17179867180000) },
+    { INT64_C(0), UINT64_C(0), UINT32_C(500),
+      UINT64_C(0), INT64_C(0), UINT64_C(2000000) },
+    { INT64_C(0), UINT64_C(0), UINT32_C(4294966796),
+      UINT64_C(0), INT64_C(0), UINT64_C(17179867184000) },
+    { INT64_C(0), UINT64_C(17179868784357), UINT32_C(400),
+      UINT64_C(4294967196), INT64_C(0), UINT64_C(17179870784000) },
+    { INT64_C(0), UINT64_C(17179868784357), UINT32_C(4294966696),
+      UINT64_C(4294967196), INT64_C(0), UINT64_C(34359735968000) },
+    { INT64_C(3999), UINT64_C(18446744073709151973), UINT32_C(400),
+      UINT64_C(18446744073709551516), INT64_C(4000), UINT64_C(1600000) },
+    { INT64_C(3999), UINT64_C(18446744073709151973), UINT32_C(4294966696),
+      UINT64_C(18446744073709551516), INT64_C(4000), UINT64_C(17179866784000) },
+    { INT64_C(0), UINT64_C(0), UINT32_C(249),
+      UINT64_C(0), INT64_C(0), UINT64_C(17179870180000) },
+    { INT64_C(0), UINT64_C(0), UINT32_C(250),
+      UINT64_C(0), INT64_C(0), UINT64_C(1000000) },
+};
+
+static void test_interval(gconstpointer data)
+{
+    const IntervalCase *example = data;
+    HPPACPU cpu = { 0 };
+    __int128 expected = wide_time(example->deadline_hi, example->deadline_lo);
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+    initialize_clock(true);
+    initialize_timer(&cpu);
+    observed_ps = wide_time(example->origin_hi, example->origin_lo);
+
+    g_assert_cmpuint(hppa_interval_timer_read(), ==, example->ticks);
+    helper_write_interval_timer(&cpu.env, example->compare);
+
+    g_assert_true(timer_pending(cpu.alarm_timer));
+    g_assert_true(timer_expire_time_ps_wide(cpu.alarm_timer) == expected);
+    g_assert_cmpuint(cpu.env.cr[CR_IT], ==, (uint64_t)(expected / 1000));
+    observed_ps = expected - 1;
+    qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL);
+    g_assert_cmpuint(callbacks, ==, 0);
+    observed_ps = expected;
+    qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL);
+    g_assert_cmpuint(callbacks, ==, 1);
+    g_assert_false(timer_pending(cpu.alarm_timer));
+
+    timer_free(cpu.alarm_timer);
+}
+
+static __int128 migration_deadline(unsigned kind)
+{
+    switch (kind) {
+    case 0:
+        return ((__int128)1 << 120) + 357;
+    case 1:
+        return -((__int128)1 << 120) + 357;
+    case 2:
+        return -1;
+    case 3:
+        return wide_time(INT64_MIN, 0);
+    case 4:
+        return wide_time(INT64_MAX, UINT64_MAX);
+    case 5:
+        return 0;
+    case 6:
+        return 140001;
+    case 7:
+        return (__int128)INT64_MAX * 1000 + 999;
+    case 8:
+        return -1001;
+    default:
+        g_assert_not_reached();
+    }
+}
+
+static void test_migration(gconstpointer data)
+{
+    unsigned kind = GPOINTER_TO_UINT(data);
+    HPPACPU original = { 0 };
+    HPPACPU restored = { 0 };
+    __int128 deadline = migration_deadline(kind);
+    GByteArray *bytes;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+    initialize_clock(true);
+    initialize_timer(&original);
+    initialize_timer(&restored);
+    if (kind != 5) {
+        timer_mod_ps_wide(original.alarm_timer, deadline);
+    }
+    timer_mod_ps_wide(restored.alarm_timer, 42);
+    bytes = save_state(&timer_fixture, &original);
+
+    g_assert_cmpint(load_state(&timer_fixture, &restored, bytes), ==, 0);
+    g_assert_cmpint(timer_pending(restored.alarm_timer), ==, kind != 5);
+    if (kind != 5) {
+        g_assert_true(timer_expire_time_ps_wide(restored.alarm_timer) == deadline);
+    }
+    if (kind == 0 || kind == 1 || kind == 2) {
+        observed_ps = deadline - 1;
+        qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL);
+        g_assert_cmpuint(callbacks, ==, 0);
+        observed_ps = deadline;
+        qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL);
+        g_assert_cmpuint(callbacks, ==, 2);
+    }
+
+    g_byte_array_unref(bytes);
+    timer_free(original.alarm_timer);
+    timer_free(restored.alarm_timer);
+}
+
+static size_t exact_payload(GByteArray *bytes)
+{
+    const char *name = "cpu/alarm-timer-wide";
+    size_t length = strlen(name);
+
+    for (size_t i = 0; i + length + 6 < bytes->len; i++) {
+        if (bytes->data[i] == QEMU_VM_SUBSECTION &&
+            bytes->data[i + 1] == length &&
+            !memcmp(bytes->data + i + 2, name, length)) {
+            return i + length + 6;
+        }
+    }
+    g_assert_not_reached();
+}
+
+static void test_malformed(gconstpointer data)
+{
+    unsigned kind = GPOINTER_TO_UINT(data);
+    HPPACPU original = { 0 };
+    HPPACPU restored = { 0 };
+    GByteArray *bytes;
+    size_t payload;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+    initialize_clock(true);
+    initialize_timer(&original);
+    initialize_timer(&restored);
+    timer_mod_ps_wide(original.alarm_timer, ((__int128)1 << 120) + 357);
+    timer_mod_ps_wide(restored.alarm_timer, 42);
+    bytes = save_state(&timer_fixture, &original);
+    payload = exact_payload(bytes);
+
+    switch (kind) {
+    case 0:
+        g_byte_array_set_size(bytes, 0);
+        g_byte_array_append(bytes, (const uint8_t[]){ QEMU_VM_EOF }, 1);
+        break;
+    case 1: {
+        size_t length = bytes->len - 1;
+        uint8_t *copy = g_memdup2(bytes->data, length);
+
+        g_byte_array_set_size(bytes, length);
+        g_byte_array_append(bytes, copy, length);
+        g_byte_array_append(bytes, (const uint8_t[]){ QEMU_VM_EOF }, 1);
+        g_free(copy);
+        break;
+    }
+    case 2:
+        bytes->data[payload] = 2;
+        break;
+    case 3:
+        bytes->data[payload + 1] = 2;
+        break;
+    case 4:
+        bytes->data[payload + 1] = 0;
+        break;
+    case 5:
+        bytes->data[payload - 1] = 0;
+        break;
+    case 6:
+        g_byte_array_set_size(bytes, bytes->len - 4);
+        break;
+    case 7:
+        bytes->data[payload] = 0;
+        break;
+    case 8:
+        bytes->data[2 + strlen("cpu/")] = 'x';
+        break;
+    case 9: {
+        const char *legacy = "cpu/alarm-timer-ps-clock";
+        uint8_t header[] = { QEMU_VM_SUBSECTION, strlen(legacy) };
+        uint8_t version_and_timer[14] = { 0, 0, 0, 1 };
+
+        /* Deliberately construct the removed format without linking its reader. */
+        g_byte_array_set_size(bytes, 0);
+        g_byte_array_append(bytes, header, sizeof(header));
+        g_byte_array_append(bytes, (const uint8_t *)legacy, strlen(legacy));
+        g_byte_array_append(bytes, version_and_timer, sizeof(version_and_timer));
+        g_byte_array_append(bytes, (const uint8_t[]){ QEMU_VM_EOF }, 1);
+        break;
+    }
+    default:
+        g_assert_not_reached();
+    }
+
+    g_assert_cmpint(load_state(&timer_fixture, &restored, bytes), <, 0);
+    g_assert_false(timer_pending(restored.alarm_timer));
+    g_assert_cmpuint(callbacks, ==, 0);
+
+    g_byte_array_unref(bytes);
+    timer_free(original.alarm_timer);
+    timer_free(restored.alarm_timer);
+}
+
+static void test_ordinary(void)
+{
+    HPPACPU cpu = { 0 };
+    HPPACPU restored = { 0 };
+    GByteArray *bytes;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+    initialize_clock(false);
+    initialize_timer(&cpu);
+    initialize_timer(&restored);
+    observed_ps = 5000;
+
+    g_assert_cmpuint(hppa_interval_timer_read(), ==, 1);
+    helper_write_interval_timer(&cpu.env, 11);
+    g_assert_cmpint(timer_expire_time_ns(cpu.alarm_timer), ==,
+                    (INT64_C(1) << 34) + 44);
+    helper_write_interval_timer(&cpu.env, 252);
+    g_assert_cmpint(timer_expire_time_ns(cpu.alarm_timer), ==, 1008);
+    g_assert_cmpuint(cpu.env.cr[CR_IT], ==, 1008);
+    bytes = save_state(&timer_fixture, &cpu);
+    timer_mod_ns(restored.alarm_timer, 42);
+
+    g_assert_cmpint(load_state(&timer_fixture, &restored, bytes), ==, 0);
+    g_assert_false(timer_pending(restored.alarm_timer));
+    observed_ps = 1008000;
+    qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL);
+    g_assert_cmpuint(callbacks, ==, 1);
+
+    g_byte_array_unref(bytes);
+    timer_free(cpu.alarm_timer);
+    timer_free(restored.alarm_timer);
+}
+
+static void test_counter_extrema(void)
+{
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+    initialize_clock(true);
+    observed_ps = wide_time(INT64_MAX, UINT64_MAX);
+
+    g_assert_cmpuint(hppa_interval_timer_read(), ==,
+                     UINT64_C(17561300358171493138));
+    observed_ps = wide_time(INT64_MIN, 0);
+    g_assert_cmpuint(hppa_interval_timer_read(), ==,
+                     UINT64_C(885443715538058477));
+}
+
+static void test_version_one(void)
+{
+    HPPACPU original = { 0 };
+    HPPACPU restored = { 0 };
+    VMStateDescription old_version = timer_fixture;
+    GByteArray *bytes;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+    initialize_clock(true);
+    initialize_timer(&original);
+    initialize_timer(&restored);
+    timer_mod_ps_wide(original.alarm_timer, 4000);
+    timer_mod_ps_wide(restored.alarm_timer, 42);
+    bytes = save_state(&timer_fixture, &original);
+    old_version.version_id = 1;
+
+    g_assert_cmpint(load_state(&old_version, &restored, bytes), <, 0);
+    g_assert_false(timer_pending(restored.alarm_timer));
+
+    g_byte_array_unref(bytes);
+    timer_free(original.alarm_timer);
+    timer_free(restored.alarm_timer);
+}
+
+static void test_range(void)
+{
+    HPPACPU cpu = { 0 };
+    __int128 deadline;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_failed();
+        g_test_trap_assert_stderr("*deadline exceeds the signed128 clock*");
+        return;
+    }
+    initialize_clock(true);
+    initialize_timer(&cpu);
+    observed_ps = wide_time(INT64_MAX, UINT64_MAX);
+    cpu.env.cr[CR_IT] = 123;
+    timer_mod_ps_wide(cpu.alarm_timer, 42);
+
+    g_assert_false(hppa_interval_deadline_ps(observed_ps, 7, &deadline));
+    g_assert_cmpuint(cpu.env.cr[CR_IT], ==, 123);
+    g_assert_true(timer_expire_time_ps_wide(cpu.alarm_timer) == 42);
+    helper_write_interval_timer(&cpu.env, 7);
+    g_assert_not_reached();
+}
+
+static int import_ordinary(const char *path, unsigned kind)
+{
+    HPPACPU cpu = { 0 };
+    GByteArray *bytes;
+    gchar *contents;
+    gsize length;
+    int status;
+
+    initialize_clock(false);
+    initialize_timer(&cpu);
+    g_assert_true(g_file_get_contents(path, &contents, &length, NULL));
+    bytes = g_byte_array_new_take((guint8 *)contents, length);
+    status = load_state(&timer_fixture, &cpu, bytes);
+    if (kind == 0 || kind == 4) {
+        g_assert_cmpint(status, ==, 0);
+        g_assert_cmpint(timer_expire_time_ns(cpu.alarm_timer), ==,
+                         kind == 0 ? 141 : 0);
+    } else {
+        g_assert_cmpint(status, <, 0);
+        g_assert_false(timer_pending(cpu.alarm_timer));
+    }
+
+    timer_free(cpu.alarm_timer);
+    g_byte_array_unref(bytes);
+    return 0;
+}
+
+static void test_cross_mode(gconstpointer data)
+{
+    unsigned kind = GPOINTER_TO_UINT(data);
+    HPPACPU cpu = { 0 };
+    GByteArray *bytes;
+    __int128 deadline;
+    int descriptor;
+    char *path = NULL;
+    char *output = NULL;
+    char *errors = NULL;
+    char *kind_argument;
+    int status;
+    char *arguments[5];
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+    initialize_clock(true);
+    initialize_timer(&cpu);
+    switch (kind) {
+    case 0:
+        deadline = 140001;
+        break;
+    case 1:
+        deadline = ((__int128)1 << 120) + 357;
+        break;
+    case 2:
+        deadline = -((__int128)1 << 120) + 357;
+        break;
+    case 3:
+        deadline = (__int128)INT64_MAX * 1000 + 999;
+        break;
+    case 4:
+        deadline = -1001;
+        break;
+    default:
+        g_assert_not_reached();
+    }
+    timer_mod_ps_wide(cpu.alarm_timer, deadline);
+    bytes = save_state(&timer_fixture, &cpu);
+    descriptor = g_file_open_tmp("hppa-timer-wide-XXXXXX", &path, NULL);
+    g_assert_cmpint(descriptor, >=, 0);
+    close(descriptor);
+    g_assert_true(g_file_set_contents(path, (char *)bytes->data, bytes->len, NULL));
+    kind_argument = g_strdup_printf("%u", kind);
+    arguments[0] = (char *)program_path;
+    arguments[1] = (char *)"--import-ordinary";
+    arguments[2] = path;
+    arguments[3] = kind_argument;
+    arguments[4] = NULL;
+
+    g_assert_true(g_spawn_sync(NULL, arguments, NULL, 0, NULL, NULL,
+                              &output, &errors, &status, NULL));
+    if (status) {
+        g_test_message("ordinary import: %s", errors);
+    }
+    g_assert_true(WIFEXITED(status));
+    g_assert_cmpint(WEXITSTATUS(status), ==, 0);
+
+    g_assert_cmpint(unlink(path), ==, 0);
+    g_free(kind_argument);
+    g_free(output);
+    g_free(errors);
+    g_free(path);
+    timer_free(cpu.alarm_timer);
+    g_byte_array_unref(bytes);
+}
+
+int main(int argc, char **argv)
+{
+    program_path = argv[0];
+    if (argc == 4 && !strcmp(argv[1], "--import-ordinary")) {
+        return import_ordinary(argv[2], strtoul(argv[3], NULL, 10));
+    }
+    g_test_init(&argc, &argv, NULL);
+    for (unsigned i = 0; i < ARRAY_SIZE(interval_cases); i++) {
+        char *name = g_strdup_printf("/hppa/interval/%u", i);
+
+        g_test_add_data_func(name, &interval_cases[i], test_interval);
+        g_free(name);
+    }
+    for (unsigned i = 0; i < 9; i++) {
+        char *name = g_strdup_printf("/hppa/migration/%u", i);
+
+        g_test_add_data_func(name, GUINT_TO_POINTER(i), test_migration);
+        g_free(name);
+    }
+    for (unsigned i = 0; i < 10; i++) {
+        char *name = g_strdup_printf("/hppa/malformed/%u", i);
+
+        g_test_add_data_func(name, GUINT_TO_POINTER(i), test_malformed);
+        g_free(name);
+    }
+    for (unsigned i = 0; i < 5; i++) {
+        char *name = g_strdup_printf("/hppa/cross-mode/%u", i);
+
+        g_test_add_data_func(name, GUINT_TO_POINTER(i), test_cross_mode);
+        g_free(name);
+    }
+    g_test_add_func("/hppa/ordinary", test_ordinary);
+    g_test_add_func("/hppa/counter-extrema", test_counter_extrema);
+    g_test_add_func("/hppa/version-one", test_version_one);
+    g_test_add_func("/hppa/range", test_range);
+    return g_test_run();
+}
diff --git a/tests/unit/test-crucible-i3c-timer.c b/tests/unit/test-crucible-i3c-timer.c
new file mode 100644
index 0000000000000000000000000000000000000000..ca1c90abe3b22fa2412002e449f07c6768590bb8
--- /dev/null
+++ b/tests/unit/test-crucible-i3c-timer.c
@@ -0,0 +1,238 @@
+/* Mock I3C target exact timer migration tests. */
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+
+#include "qemu/osdep.h"
+
+#include "exec/icount.h"
+#include "hw/i3c/mock-i3c-target.h"
+#include "io/channel-file.h"
+#include "migration/qemu-file.h"
+#include "migration/savevm.h"
+#include "qapi/error.h"
+#include "qemu/main-loop.h"
+#include "qemu/module.h"
+
+static int64_t observed_ps;
+static unsigned int callback_count;
+static bool sim_mode = true;
+
+static const VMStateDescription vmstate_mock_i3c_target_legacy = {
+    .name = TYPE_MOCK_I3C_TARGET,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_TIMER_NS_PROJECTION(qtimer, MockI3cTargetState),
+        VMSTATE_BOOL(can_ibi, MockI3cTargetState),
+        VMSTATE_UINT8(parent_obj.address, MockI3cTargetState),
+        VMSTATE_UINT8_EQUAL(parent_obj.static_address, MockI3cTargetState),
+        VMSTATE_UINT8_EQUAL(parent_obj.dcr, MockI3cTargetState),
+        VMSTATE_UINT8_EQUAL(parent_obj.bcr, MockI3cTargetState),
+        VMSTATE_UINT64_EQUAL(parent_obj.pid, MockI3cTargetState),
+        VMSTATE_SINGLE(parent_obj.curr_ccc, MockI3cTargetState, 0,
+                       vmstate_info_int32, I3CCCC),
+        VMSTATE_UINT8(parent_obj.ccc_byte_offset, MockI3cTargetState),
+        VMSTATE_BOOL(parent_obj.in_ccc, MockI3cTargetState),
+        VMSTATE_BOOL(parent_obj.in_test_mode, MockI3cTargetState),
+        VMSTATE_UINT32(p_buf, MockI3cTargetState),
+        VMSTATE_BOOL(in_ccc, MockI3cTargetState),
+        VMSTATE_SINGLE(curr_ccc, MockI3cTargetState, 0,
+                       vmstate_info_int32, I3CCCC),
+        VMSTATE_UINT8(ccc_byte_offset, MockI3cTargetState),
+        VMSTATE_UINT32_EQUAL(cfg.buf_size, MockI3cTargetState),
+        VMSTATE_UINT8_EQUAL(cfg.ibi_magic, MockI3cTargetState),
+        VMSTATE_VBUFFER_UINT32(buf, MockI3cTargetState, 1, NULL,
+                               cfg.buf_size),
+        VMSTATE_END_OF_LIST(),
+    },
+};
+
+bool icount_crucible_sim_mode(void)
+{
+    return sim_mode;
+}
+
+int i3c_target_send_ibi(I3CTarget *target, uint8_t address, bool is_recv)
+{
+    g_assert_not_reached();
+}
+
+int i3c_target_ibi_finish(I3CTarget *target, uint8_t data)
+{
+    g_assert_not_reached();
+}
+
+static int64_t test_virtual_clock_ps(void)
+{
+    return observed_ps;
+}
+
+static void timer_elapsed(void *opaque)
+{
+    callback_count++;
+}
+
+static QEMUFile *open_test_file(int fd, bool writing)
+{
+    QIOChannel *channel;
+    QEMUFile *file;
+    int copy = dup(fd);
+
+    g_assert_cmpint(copy, >=, 0);
+    g_assert_cmpint(lseek(copy, 0, SEEK_SET), >=, 0);
+    if (writing) {
+        g_assert_cmpint(ftruncate(copy, 0), ==, 0);
+    }
+    channel = QIO_CHANNEL(qio_channel_file_new_fd(copy));
+    file = writing ? qemu_file_new_output(channel) :
+                     qemu_file_new_input(channel);
+    object_unref(OBJECT(channel));
+    return file;
+}
+
+static void init_target(MockI3cTargetState *target)
+{
+    target->cfg.buf_size = 16;
+    target->cfg.ibi_magic = 0x5a;
+    target->buf = g_malloc0(target->cfg.buf_size);
+    timer_init_ns(&target->qtimer, QEMU_CLOCK_VIRTUAL,
+                  timer_elapsed, target);
+}
+
+static void test_active_timer_roundtrip(void)
+{
+    const __int128 deadline_ps = 357;
+    MockI3cTargetState source = {};
+    MockI3cTargetState restored = {};
+    g_autofree char *path = NULL;
+    g_autofree uint8_t *first = NULL;
+    g_autofree uint8_t *second = NULL;
+    QEMUFile *file;
+    Error *error = NULL;
+    off_t first_size;
+    off_t second_size;
+    int fd;
+
+    init_target(&source);
+    init_target(&restored);
+    source.can_ibi = false;
+    source.parent_obj.address = 0x30;
+    source.p_buf = 4;
+    memcpy(source.buf, "timer-state", 11);
+    timer_mod_ps_wide(&source.qtimer, deadline_ps);
+
+    fd = g_file_open_tmp("mock-i3c-timer-XXXXXX", &path, NULL);
+    g_assert_cmpint(fd, >=, 0);
+    unlink(path);
+
+    file = open_test_file(fd, true);
+    g_assert_cmpint(vmstate_save_state(file, &vmstate_mock_i3c_target,
+                                       &source, NULL, &error), ==, 0);
+    g_assert_null(error);
+    g_assert_cmpint(qemu_fclose(file), ==, 0);
+    first_size = lseek(fd, 0, SEEK_END);
+    g_assert_cmpint(first_size, >, 0);
+    first = g_malloc(first_size);
+    g_assert_cmpint(pread(fd, first, first_size, 0), ==, first_size);
+
+    file = open_test_file(fd, false);
+    g_assert_cmpint(vmstate_load_state(file, &vmstate_mock_i3c_target,
+                                       &restored, 1, &error), ==, 0);
+    g_assert_null(error);
+    qemu_fclose(file);
+    g_assert_true(restored.qtimer_exact_loaded);
+    g_assert_true(timer_pending(&restored.qtimer));
+    g_assert_true(timer_expire_time_ps_wide(&restored.qtimer) == deadline_ps);
+    g_assert_cmpuint(restored.p_buf, ==, source.p_buf);
+    g_assert_cmpmem(restored.buf, restored.cfg.buf_size,
+                    source.buf, source.cfg.buf_size);
+
+    file = open_test_file(fd, true);
+    g_assert_cmpint(vmstate_save_state(file, &vmstate_mock_i3c_target,
+                                       &restored, NULL, &error), ==, 0);
+    g_assert_null(error);
+    g_assert_cmpint(qemu_fclose(file), ==, 0);
+    second_size = lseek(fd, 0, SEEK_END);
+    g_assert_cmpint(second_size, ==, first_size);
+    second = g_malloc(second_size);
+    g_assert_cmpint(pread(fd, second, second_size, 0), ==, second_size);
+    g_assert_cmpmem(second, second_size, first, first_size);
+
+    timer_del(&source.qtimer);
+    observed_ps = deadline_ps - 1;
+    qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL);
+    g_assert_cmpuint(callback_count, ==, 0);
+    observed_ps = deadline_ps;
+    qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL);
+    g_assert_cmpuint(callback_count, ==, 1);
+
+    timer_del(&restored.qtimer);
+    g_free(source.buf);
+    g_free(restored.buf);
+    close(fd);
+}
+
+static void test_missing_exact_state(void)
+{
+    MockI3cTargetState source = {};
+    MockI3cTargetState ordinary = {};
+    MockI3cTargetState sim = {};
+    g_autofree char *path = NULL;
+    QEMUFile *file;
+    Error *error = NULL;
+    int fd;
+
+    init_target(&source);
+    init_target(&ordinary);
+    init_target(&sim);
+    timer_mod_ps_wide(&source.qtimer, 357);
+
+    fd = g_file_open_tmp("mock-i3c-legacy-XXXXXX", &path, NULL);
+    g_assert_cmpint(fd, >=, 0);
+    unlink(path);
+    file = open_test_file(fd, true);
+    g_assert_cmpint(vmstate_save_state(file,
+                                       &vmstate_mock_i3c_target_legacy,
+                                       &source, NULL, &error), ==, 0);
+    g_assert_null(error);
+    g_assert_cmpint(qemu_fclose(file), ==, 0);
+
+    sim_mode = false;
+    file = open_test_file(fd, false);
+    g_assert_cmpint(vmstate_load_state(file, &vmstate_mock_i3c_target,
+                                       &ordinary, 1, &error), ==, 0);
+    g_assert_null(error);
+    qemu_fclose(file);
+    g_assert_false(ordinary.qtimer_exact_loaded);
+    g_assert_true(timer_expire_time_ps_wide(&ordinary.qtimer) == 1000);
+
+    sim_mode = true;
+    file = open_test_file(fd, false);
+    g_assert_cmpint(vmstate_load_state(file, &vmstate_mock_i3c_target,
+                                       &sim, 1, &error), ==, -EINVAL);
+    g_assert_nonnull(error);
+    error_free(error);
+    qemu_fclose(file);
+
+    timer_del(&source.qtimer);
+    timer_del(&ordinary.qtimer);
+    timer_del(&sim.qtimer);
+    g_free(source.buf);
+    g_free(ordinary.buf);
+    g_free(sim.buf);
+    close(fd);
+}
+
+int main(int argc, char **argv)
+{
+    module_call_init(MODULE_INIT_QOM);
+    qemu_init_main_loop(&error_abort);
+    qemu_timer_enable_tcg_ps_clock(test_virtual_clock_ps, NULL);
+    qemu_clock_enable(QEMU_CLOCK_VIRTUAL, true);
+
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/crucible/i3c/active-timer-roundtrip",
+                    test_active_timer_roundtrip);
+    g_test_add_func("/crucible/i3c/missing-exact-state",
+                    test_missing_exact_state);
+    return g_test_run();
+}
diff --git a/tests/unit/test-crucible-ich9-aux-wide-clock.c b/tests/unit/test-crucible-ich9-aux-wide-clock.c
new file mode 100644
index 0000000000000000000000000000000000000000..3640177c25d6f5dd67a1fdc2b7ba770ece03071e
--- /dev/null
+++ b/tests/unit/test-crucible-ich9-aux-wide-clock.c
@@ -0,0 +1,729 @@
+/*
+ * Literal ICH9 auxiliary timer runtime and deferred migration regressions.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "crucible-timer-stream.h"
+#include "qapi/error.h"
+#include "qemu/main-loop.h"
+#include "qemu/module.h"
+#include "system/cpu-timers.h"
+#include "io/channel-buffer.h"
+#include "migration/savevm.h"
+#include "../../migration/qemu-file.h"
+
+/* Machine registration is excluded; every timer engine body remains real. */
+#undef opts_init
+#define opts_init(function) \
+    static void (*const fixture_##function)(void) G_GNUC_UNUSED = function;
+#include "../../hw/acpi/core.c"
+#include "../../hw/acpi/ich9.c"
+#include "../../hw/acpi/ich9_tco.c"
+#include "../../hw/acpi/ich9_timer.c"
+
+static char *fixture_executable;
+
+static __int128 observed_ps;
+static unsigned smi_events;
+static unsigned nanosecond_reads;
+
+int64_t cpu_get_clock(void)
+{
+    __int128 ns = observed_ps / 1000;
+
+    nanosecond_reads++;
+    if (ns < INT64_MIN || ns > INT64_MAX) {
+        g_error("Diagnostic nanosecond projection exceeds the API range");
+    }
+    return ns;
+}
+
+bool icount_crucible_sim_mode(void)
+{
+    return false;
+}
+
+static __int128 observed_clock(void)
+{
+    return observed_ps;
+}
+
+void ich9_generate_smi(void)
+{
+    /* Final CPU SMI delivery is an explicit diagnostic consumer. */
+    smi_events++;
+}
+
+void watchdog_perform_action(void)
+{
+    g_assert_not_reached();
+}
+
+/* No transform is installed: fault paths must not become timer permission. */
+bool qemu_crucible_fault_clock_source_active(uint16_t kind, uint32_t instance)
