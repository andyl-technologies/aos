+
+CHECKS = r'''
+static void row_inventory(QemuCruciblePublisherRecipient *recipient, uint32_t count)
+{
+    memset(recipient, 0, sizeof(*recipient));
+    recipient->serial = 7;
+    recipient->publication.cohort.planned_count = count;
+    recipient->view_born_mask = (UINT32_C(1) << count) - 1;
+    for (size_t index = 0; index < count; index++) {
+        recipient->views[index] = (PreexecPublisherRowView) {
+            .recipient = recipient,
+            .row = &recipient->publication.cohort.rows[index],
+            .recipient_serial = 7,
+            .index = index,
+            .born = true,
+            .held = true,
+        };
+    }
+}
+
+#define REFUSE_MUTATION(change) do { \
+    row_inventory(&recipient, 2); \
+    change; \
+    before = recipient; \
+    assert(preexec_publisher_recipient_views_return(&recipient) == -ESTALE); \
+    assert(!memcmp(&before, &recipient, sizeof(recipient))); \
+} while (0)
+
+int main(void)
+{
+    QemuCruciblePublisherRecipient recipient = { 0 };
+    QemuCruciblePublisherRecipient before;
+    uint64_t mapping[QEMU_CRUCIBLE_PUBLISHER_REGION_BYTES / 8] = { 0 };
+    PreexecPublisherSessionJournal session = { 0 };
+    uint64_t *publication = mapping + QEMU_CRUCIBLE_PUBLISHER_PUBLICATION_OFFSET / 8;
+    uint64_t *ticket = mapping + QEMU_CRUCIBLE_PUBLISHER_RECEIVER_OFFSET / 8;
+
+    assert(preexec_publisher_recipient_views_return(&recipient) == -ESTALE);
+    recipient.publication.cohort.planned_count = 5;
+    assert(preexec_publisher_recipient_views_return(&recipient) == -ESTALE);
+    for (uint32_t count = 1; count <= 4; count++) {
+        row_inventory(&recipient, count);
+        assert(!preexec_publisher_recipient_views_return(&recipient));
+        assert(recipient.view_returned_mask == recipient.view_born_mask);
+        for (size_t index = 0; index < count; index++) {
+            const PreexecPublisherRowView *view = &recipient.views[index];
+            assert(view->born && !view->held && view->return_attempted && view->returned);
+            assert(!view->row);
+        }
+        before = recipient;
+        assert(preexec_publisher_recipient_views_return(&recipient) == -ESTALE);
+        assert(!memcmp(&before, &recipient, sizeof(recipient)));
+    }
+    REFUSE_MUTATION(recipient.view_born_mask = 1);
+    REFUSE_MUTATION(recipient.view_returned_mask = 1);
+    REFUSE_MUTATION(recipient.views[1].recipient = NULL);
+    REFUSE_MUTATION(recipient.views[1].recipient_serial++);
+    REFUSE_MUTATION(recipient.views[1].index = 0);
+    REFUSE_MUTATION(recipient.views[1].row = &recipient.publication.cohort.rows[0]);
+    REFUSE_MUTATION(recipient.views[1].born = false);
+    REFUSE_MUTATION(recipient.views[1].held = false);
+    REFUSE_MUTATION(recipient.views[1].return_attempted = true);
+    REFUSE_MUTATION(recipient.views[1].returned = true);
+    REFUSE_MUTATION(recipient.views[2].held = true);
+
+    memset(&recipient, 0, sizeof(recipient));
+    session.mapping.address = mapping;
+    recipient.ticket_serial = 9;
+    for (size_t index = 0; index < QEMU_CRUCIBLE_PUBLISHER_PUBLICATION_BYTES / 8; index++) {
+        publication[index] = preexec_publisher_atomic_word(index * 8 + 2);
+        recipient.publication_words[index] = publication[index];
+    }
+    publication[3] = preexec_publisher_atomic_word(1);
+    *ticket = preexec_publisher_atomic_word(9 << 3 | 2);
+    assert(!preexec_publisher_recipient_final(&session, &recipient, false, 2));
+    for (size_t index = 0; index < QEMU_CRUCIBLE_PUBLISHER_PUBLICATION_BYTES / 8; index++) {
+        if (index != 3) {
+            publication[index] ^= 1;
+            assert(preexec_publisher_recipient_final(&session, &recipient, false, 2) == -ESTALE);
+            publication[index] ^= 1;
+        }
+    }
+    for (uint64_t phase = 0; phase <= 4; phase++) {
+        publication[3] = preexec_publisher_atomic_word(phase);
+        assert(preexec_publisher_recipient_final(&session, &recipient, false, 2) ==
+               (phase == 1 ? 0 : -ESTALE));
+        assert(preexec_publisher_recipient_final(&session, &recipient, true, 2) ==
+               (phase >= 1 && phase <= 3 ? 0 : -ESTALE));
+    }
+    publication[3] = preexec_publisher_atomic_word(1);
+    *ticket = preexec_publisher_atomic_word(10 << 3 | 2);
+    assert(preexec_publisher_recipient_final(&session, &recipient, false, 2) == -ESTALE);
+    *ticket = preexec_publisher_atomic_word(9 << 3 | 3);
+    assert(preexec_publisher_recipient_final(&session, &recipient, false, 2) == -ESTALE);
+    puts("PASS local row-return and immutable-word leaves; no canonical recipient or Original");
+    return 0;
+}
+'''
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("source", type=Path)
+    parser.add_argument("output", type=Path)
+    args = parser.parse_args()
+    source = args.source.resolve()
+    output = args.output.resolve()
+    output.mkdir(parents=True, exist_ok=True)
+    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
+
+    extract = runpy.run_path(str(source / "tests/unit/extract-crucible-startup-source-controls.py"))
+    recipient = (source / "system/crucible-preexec-publisher-recipient.inc.h").read_text()
+    setup = (source / "system/crucible-preexec-setup.c").read_text()
+    names = ("preexec_publisher_atomic_word", "preexec_publisher_recipient_final",
+             "preexec_publisher_recipient_views_return")
+    bodies = "\n\n".join(extract["function"](recipient,
+        ("static uint64_t " if name.endswith("atomic_word") else "static int ") + name + "(")
+        for name in names)
+    before = ('#include "qemu/osdep.h"\n'
+              '#include "plugins/crucible-startup-source.h"\n'
+              '#include "qemu/crucible-publisher-protocol.h"\n'
+              '#include "system/crucible-preexec-publisher-storage.inc.h"\n' +
+              extract["function"](setup, "static uint32_t preexec_setup_be32(") + "\n" +
+              extract["function"](setup, "static uint64_t preexec_setup_be64("))
+    controls = {"positive": bodies}
+    predicates = (
+        "!count || count > QEMU_CRUCIBLE_ACTION_PARENT_CAPACITY",
+        "recipient->view_born_mask != expected", "recipient->view_returned_mask",
+        "view->recipient != recipient", "view->recipient_serial != recipient->serial",
+        "view->index != index", "view->row != &recipient->publication.cohort.rows[index]",
+        "!view->born", "!view->held", "view->return_attempted", "view->returned",
+        "sequence != recipient->publication_words[0]",
+        "phase != 1", "phase < 1 || phase > 3",
+    )
+    for index, predicate in enumerate(predicates):
+        if predicate not in bodies:
+            raise ValueError("missing predicate " + predicate)
+        controls[f"omit-predicate-{index}"] = bodies.replace(predicate, "false", 1)
+    controls["omit-unused-rows"] = bodies.replace("} else if (view->recipient ||", "} else if (false && (view->recipient ||").replace(
+        "view->return_attempted || view->returned) {\n            return -ESTALE;\n        }\n    }",
+        "view->return_attempted || view->returned)) {\n            return -ESTALE;\n        }\n    }")
+    controls["omit-complete-immutable"] = bodies.replace("if (index != 3 &&", "if (false &&")
+    controls["omit-ticket"] = bodies.replace(
+        "preexec_setup_be64((const uint8_t *)&ticket) !=\n        (recipient->ticket_serial << 3 | ticket_phase)", "false")
+    controls["omit-physical-row-return"] = bodies.replace("view->held = false;", "view->held = true;")
+    controls["omit-returned-mask"] = bodies.replace(
+        "recipient->view_returned_mask |= UINT32_C(1) << index;", "(void)index;")
+
+    proof = {}
+    for name, body in controls.items():
+        if name != "positive" and body == bodies:
+            raise ValueError("unchanged omission: " + name)
+        c_file = output / (name + ".c")
+        binary = output / name
+        c_file.write_text(before + "\n" + body + "\n" + CHECKS)
+        command = [os.environ.get("CC", "cc"), *shlex.split(os.environ.get("CFLAGS", "")),
+                   str(c_file), "-o", str(binary),
+                   *shlex.split(os.environ.get("LDFLAGS", ""))]
+        (output / (name + ".command.json")).write_text(json.dumps(command, indent=2) + "\n")
+        compiled = subprocess.run(command, text=True, stdout=subprocess.PIPE,
+                                  stderr=subprocess.STDOUT)
+        (output / (name + ".compile.log")).write_text(compiled.stdout)
+        compiled.check_returncode()
+        result = subprocess.run([str(binary)], text=True, stdout=subprocess.PIPE,
+                                stderr=subprocess.STDOUT, timeout=30)
+        (output / (name + ".log")).write_text(result.stdout)
+        expected = 0 if name == "positive" else -6
+        if result.returncode != expected:
+            raise RuntimeError(f"{name}: expected {expected}, got {result.returncode}")
+        proof[name] = {"returncode": result.returncode, "output": result.stdout}
+    (output / "proof.json").write_text(json.dumps(proof, indent=2) + "\n")
+    print(proof["positive"]["output"], end="")
+    print(f"PASS {len(controls) - 1} independently rebuilt omissions")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/unit/test-crucible-advance-registration.py b/tests/unit/test-crucible-advance-registration.py
new file mode 100644
index 0000000000000000000000000000000000000000..474759763b4ac968d20298631bc922a961e5dd33
--- /dev/null
+++ b/tests/unit/test-crucible-advance-registration.py
@@ -0,0 +1,178 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Exercise literal callback-table syntax, without an accepting provider.
+
+Callback addresses refer to abort-only functions that are never invoked. Valid
+and absent tables prove registration syntax only, not paid membership, command
+receipt, Source admission, an Original, cleanup authority or physical return.
+"""
+
+import argparse
+import json
+import os
+from pathlib import Path
+import re
+import resource
+import runpy
+import shlex
+import subprocess
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("source", type=Path)
+    parser.add_argument("output", type=Path)
+    args = parser.parse_args()
+    source = args.source.resolve()
+    output = args.output.resolve()
+    output.mkdir(parents=True, exist_ok=True)
+    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
+    extract = runpy.run_path(str(source / "tests/unit/extract-crucible-startup-source-controls.py"))
+    header = (source / "include/plugins/qemu-plugin.h").read_text()
+    membership = (source / "plugins/crucible-command-membership.inc.h").read_text()
+    tables = ("advance_callbacks", "advance_receiver_callbacks")
+    functions = "\n\n".join(
+        extract["function"](membership, "static bool command_member_" + table + suffix + "(")
+        for table in tables for suffix in ("_valid", "_absent"))
+
+    before = '#include "qemu/osdep.h"\n#include "plugins/crucible-startup-source.h"\n'
+    overlap = (source / "plugins/crucible-callback-child.inc.h").read_text()
+    functions += "\n" + extract["function"](
+        overlap, "static bool callback_child_output_overlap(")
+    functions += "\n" + extract["function"](
+        membership, "static bool command_member_advance_table_geometry(")
+    typedefs = re.findall(r"typedef int \(\*(QemuCrucibleModuleAdvance\w+V1)\)\((.*?)\);",
+                          header, re.S)
+    for name, parameters in typedefs:
+        before += "static int never_" + name + "(" + parameters + ")\n{\n    abort();\n}\n\n"
+
+    checks = "int main(void)\n{\n"
+    omissions = {}
+    for index, table in enumerate(tables):
+        struct_name = "qemu_plugin_crucible_" + table + "_v1"
+        declaration = re.search(r"struct " + struct_name + r" \{(.*?)\};", header, re.S)
+        fields = re.findall(r"(QemuCrucibleModuleAdvance\w+V1) (\w+);", declaration[1])
+        valid = "command_member_" + table + "_valid"
+        absent = "command_member_" + table + "_absent"
+        var = "table" + str(index)
+        checks += "    struct " + struct_name + " " + var + " = {\n"
+        checks += "        .schema_version = 1, .struct_size = sizeof(" + var + "),\n"
+        for typedef, field in fields:
+            checks += "        ." + field + " = never_" + typedef + ",\n"
+        checks += "    };\n"
+        checks += "    assert(" + valid + "(&" + var + "));\n"
+        checks += "    assert(!" + absent + "(&" + var + "));\n"
+        for field, invalid in (("schema_version", "0"), ("struct_size", "sizeof(" + var + ") - 1")):
+            original = "1" if field == "schema_version" else "sizeof(" + var + ")"
+            checks += "    " + var + "." + field + " = " + invalid + ";\n"
+            checks += "    assert(!" + valid + "(&" + var + "));\n"
+            checks += "    " + var + "." + field + " = " + original + ";\n"
+        for typedef, field in fields:
+            checks += "    " + var + "." + field + " = NULL;\n"
+            checks += "    assert(!" + valid + "(&" + var + "));\n"
+            checks += "    " + var + "." + field + " = never_" + typedef + ";\n"
+        checks += "    memset(&" + var + ", 0, sizeof(" + var + "));\n"
+        checks += "    assert(" + absent + "(&" + var + "));\n"
+        for field, nonzero in (("schema_version", "1"), ("struct_size", "sizeof(" + var + ")"),
+                               *((field, "never_" + typedef) for typedef, field in fields)):
+            checks += "    " + var + "." + field + " = " + nonzero + ";\n"
+            checks += "    assert(!" + absent + "(&" + var + "));\n"
+            checks += "    " + var + "." + field + " = 0;\n"
+        pointer = "advance" if index == 0 else "receiver"
+        for field in ("schema_version", "struct_size", *(field for _, field in fields)):
+            term = pointer + "->" + field
+            if field == "schema_version":
+                term += " == 1"
+            elif field == "struct_size":
+                term += " == sizeof(*" + pointer + ")"
+            omissions["omit-valid-" + str(index) + "-" + field] = functions.replace(term, "true", 1)
+            term = "!" + pointer + "->" + field
+            omissions["omit-absent-" + str(index) + "-" + field] = functions.replace(term, "true", 1)
+    checks += r"""
+    QemuCrucibleCommandConsumerMember *member = NULL;
+    struct {
+        struct qemu_plugin_crucible_advance_callbacks_v1 value;
+        uint64_t padding[4];
+    } padded_advance = { 0 };
+    struct {
+        struct qemu_plugin_crucible_advance_receiver_callbacks_v1 value;
+        uint64_t padding[4];
+    } padded_receiver = { 0 };
+    struct {
+        QemuCrucibleCommandConsumerMember *value;
+        uint64_t padding[4];
+    } padded_output = { 0 };
+    assert(command_member_advance_table_geometry(&table0, &table1, &member));
+    assert(!command_member_advance_table_geometry(NULL, &table1, &member));
+    assert(!command_member_advance_table_geometry(&table0, NULL, &member));
+    assert(!command_member_advance_table_geometry(&table0, &table1, NULL));
+    assert(!command_member_advance_table_geometry(
+        (void *)((uintptr_t)&padded_advance.value + 1),
+        &padded_receiver.value, &padded_output.value));
+    assert(!command_member_advance_table_geometry(
+        &padded_advance.value,
+        (void *)((uintptr_t)&padded_receiver.value + 1), &padded_output.value));
+    assert(!command_member_advance_table_geometry(
+        &padded_advance.value, &padded_receiver.value,
+        (void *)((uintptr_t)&padded_output.value + 1)));
+    assert(!command_member_advance_table_geometry(
+        (void *)(UINTPTR_MAX - 7), &table1, &member));
+    assert(!command_member_advance_table_geometry(
+        &table0, (void *)(UINTPTR_MAX - 7), &member));
+    assert(!command_member_advance_table_geometry(
+        &table0, &table1, (void *)(UINTPTR_MAX - 7)));
+    assert(!command_member_advance_table_geometry(&table0, (void *)&table0, &member));
+    assert(!command_member_advance_table_geometry(
+        &table0, (void *)((uintptr_t)&table0 + sizeof(table0) - 8), &member));
+    assert(!command_member_advance_table_geometry(&table0, &table1, (void *)&table0));
+    assert(!command_member_advance_table_geometry(
+        &table0, &table1, (void *)((uintptr_t)&table0 + sizeof(table0) - 8)));
+    assert(!command_member_advance_table_geometry(&table0, &table1, (void *)&table1));
+    assert(!command_member_advance_table_geometry(
+        &table0, &table1, (void *)((uintptr_t)&table1 + sizeof(table1) - 8)));
+    puts("PASS callback-table syntax/geometry; no callback invoked or owner admitted");
+    return 0;
+}
+"""
+    # Null/overflow checks also occur in the real overlap leaf. Their cases
+    # stay in the positive assertions without mislabeling redundant omissions.
+    for term in ("receiver &&",
+                 "address % _Alignof(*advance) == 0",
+                 "receiver_address % _Alignof(*receiver) == 0",
+                 "output_address % _Alignof(*out) == 0",
+                 ):
+        replacement = "true &&" if term.endswith(" &&") else "true"
+        omissions["omit-geometry-" + str(len(omissions))] = functions.replace(term, replacement, 1)
+    for first, last in (("advance", "receiver"), ("out", "receiver"), ("out", "advance")):
+        pattern = (r"!callback_child_output_overlap\(" + first + r", sizeof\(\*" + first +
+                   r"\),\s*" + last + r",\s*sizeof\(\*" + last + r"\)\)")
+        omissions["omit-overlap-" + first + "-" + last] = re.sub(pattern, "true", functions, count=1)
+
+    proof = {}
+    for name, body in {"positive": functions, **omissions}.items():
+        if name != "positive" and body == functions:
+            raise ValueError("unchanged omission: " + name)
+        generated = output / (name + ".c")
+        binary = output / name
+        generated.write_text(before + body + "\n" + checks)
+        command = [os.environ.get("CC", "cc"), *shlex.split(os.environ.get("CFLAGS", "")),
+                   str(generated), "-o", str(binary),
+                   *shlex.split(os.environ.get("LDFLAGS", ""))]
+        (output / (name + ".command.json")).write_text(json.dumps(command, indent=2) + "\n")
+        compiled = subprocess.run(command, text=True, stdout=subprocess.PIPE,
+                                  stderr=subprocess.STDOUT)
+        (output / (name + ".compile.log")).write_text(compiled.stdout)
+        compiled.check_returncode()
+        result = subprocess.run([str(binary)], text=True, stdout=subprocess.PIPE,
+                                stderr=subprocess.STDOUT, timeout=30)
+        (output / (name + ".log")).write_text(result.stdout)
+        expected = 0 if name == "positive" else -6
+        if result.returncode != expected:
+            raise RuntimeError(f"{name}: expected {expected}, got {result.returncode}")
+        proof[name] = {"returncode": result.returncode, "output": result.stdout}
+    (output / "proof.json").write_text(json.dumps(proof, indent=2) + "\n")
+    print(proof["positive"]["output"], end="")
+    print(f"PASS {len(omissions)} independently rebuilt omissions")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/unit/test-crucible-ahci-fingerprint.c b/tests/unit/test-crucible-ahci-fingerprint.c
new file mode 100644
index 0000000000000000000000000000000000000000..b0522d7ecc1acfddf400f671a89967e58a28b1da
--- /dev/null
+++ b/tests/unit/test-crucible-ahci-fingerprint.c
@@ -0,0 +1,145 @@
+/*
+ * ICH9 AHCI fingerprint projection tests
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+#include "qemu/osdep.h"
+
+#include "hw/ide/ich-fingerprint.h"
+#include "io/channel-file.h"
+#include "qemu/module.h"
+
+static GBytes *project_ahci(AHCIState *ahci, bool expected_success)
+{
+    char *path = NULL;
+    int read_fd;
+    int write_fd = g_file_open_tmp("qemu-ahci-fingerprint-XXXXXX", &path,
+                                   NULL);
+    QIOChannelFile *channel;
+    QEMUFile *file;
+    Error *error = NULL;
+    struct stat stat_buffer;
+    bool success;
+
+    g_assert_cmpint(write_fd, >=, 0);
+    read_fd = dup(write_fd);
+    g_assert_cmpint(read_fd, >=, 0);
+    unlink(path);
+    g_free(path);
+    channel = qio_channel_file_new_fd(write_fd);
+    file = qemu_file_new_output(QIO_CHANNEL(channel));
+
+    success = ich9_ahci_state_fingerprint_validate(ahci, &error);
+    g_assert_cmpint(success, ==, expected_success);
+    if (success) {
+        ich9_ahci_state_fingerprint_put(file, ahci);
+    }
+    if (!success) {
+        g_assert_nonnull(error);
+        error_free(error);
+        qemu_fclose(file);
+        g_assert_cmpint(fstat(read_fd, &stat_buffer), ==, 0);
+        g_assert_cmpuint(stat_buffer.st_size, ==, 0);
+        object_unref(OBJECT(channel));
+        close(read_fd);
+        return NULL;
+    }
+    g_assert_null(error);
+    g_assert_cmpint(qemu_fflush(file), ==, 0);
+    g_assert_cmpint(qemu_fclose(file), ==, 0);
+
+    g_assert_cmpint(fstat(read_fd, &stat_buffer), ==, 0);
+    g_autofree uint8_t *data = g_malloc(stat_buffer.st_size);
+    g_assert_cmpint(pread(read_fd, data, stat_buffer.st_size, 0), ==,
+                    stat_buffer.st_size);
+    GBytes *bytes = g_bytes_new(data, stat_buffer.st_size);
+    object_unref(OBJECT(channel));
+    close(read_fd);
+    return bytes;
+}
+
+static void initialize_ahci(AHCIState *ahci, AHCIDevice *port)
+{
+    memset(ahci, 0, sizeof(*ahci));
+    memset(port, 0, sizeof(*port));
+    ahci->ports = 1;
+    ahci->dev = port;
+    port->port_no = 0;
+    port->port.max_units = 1;
+    port->port.ifs[0].unit = 0;
+}
+
+static void test_ahci_retry_state(void)
+{
+    AHCIState ahci;
+    AHCIDevice port;
+    g_autoptr(GBytes) baseline = NULL;
+    g_autoptr(GBytes) retry = NULL;
+    g_autoptr(GBytes) inactive_history = NULL;
+
+    initialize_ahci(&ahci, &port);
+    baseline = project_ahci(&ahci, true);
+
+    port.port.retry_sector_num = 17;
+    port.port.retry_nsector = 2;
+    inactive_history = project_ahci(&ahci, true);
+    g_assert_true(g_bytes_equal(baseline, inactive_history));
+
+    port.port.error_status = 1;
+    retry = project_ahci(&ahci, true);
+    g_assert_false(g_bytes_equal(inactive_history, retry));
+}
+
+static void test_ahci_inactive_ncq_history(void)
+{
+    AHCIState ahci;
+    AHCIDevice port;
+    g_autoptr(GBytes) first = NULL;
+    g_autoptr(GBytes) second = NULL;
+
+    initialize_ahci(&ahci, &port);
+    port.ncq_tfs[3].sector_count = 8;
+    port.ncq_tfs[3].lba = 0x1234;
+    port.ncq_tfs[3].tag = 9;
+    port.ncq_tfs[3].slot = 11;
+    first = project_ahci(&ahci, true);
+
+    port.ncq_tfs[3].sector_count = 16;
+    port.ncq_tfs[3].lba = 0x5678;
+    port.ncq_tfs[3].tag = 13;
+    port.ncq_tfs[3].slot = 15;
+    second = project_ahci(&ahci, true);
+    g_assert_true(g_bytes_equal(first, second));
+}
+
+static void test_ahci_rejects_ide_and_invalid_ncq(void)
+{
+    AHCIState ahci;
+    AHCIDevice port;
+
+    initialize_ahci(&ahci, &port);
+    port.port.ifs[0].blk = (BlockBackend *)(uintptr_t)1;
+    g_assert_null(project_ahci(&ahci, false));
+
+    port.port.ifs[0].blk = NULL;
+    port.ncq_tfs[1].used = true;
+    g_assert_null(project_ahci(&ahci, false));
+
+    port.ncq_tfs[1].halt = true;
+    port.ncq_tfs[1].slot = 1;
+    port.ncq_tfs[1].tag = 1;
+    g_assert_null(project_ahci(&ahci, false));
+}
+
+int main(int argc, char **argv)
+{
+    module_call_init(MODULE_INIT_QOM);
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/crucible/ahci/retry-state", test_ahci_retry_state);
+    g_test_add_func("/crucible/ahci/inactive-ncq-history",
+                    test_ahci_inactive_ncq_history);
+    g_test_add_func("/crucible/ahci/reject-ide-invalid-ncq",
+                    test_ahci_rejects_ide_and_invalid_ncq);
+    return g_test_run();
+}
