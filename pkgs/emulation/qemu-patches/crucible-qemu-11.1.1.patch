+int qemu_crucible_ram_mutation_end(uint64_t transaction)
+{
+    int status;
+
+    if (!mutation_writer_scope || !capture_active ||
+        transaction != capture_generation) {
+        return -ESTALE;
+    }
+    /* Mutation publication does not acknowledge native dirty consumers. A
+     * subsequent exact observer conservatively harvests the authored stores.
+     */
+    status = qemu_plugin_crucible_ram_capture_finish_v2(transaction, 0, 0);
+    if (!mutation_preflight_scope) {
+        fault_root_writer_scope = false;
+    }
+    mutation_writer_scope = false;
+    if (mutation_bql_owned && !mutation_preflight_scope) {
+        mutation_bql_owned = false;
+        bql_unlock();
+    }
+    return status;
+}
