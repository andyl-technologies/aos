+static __int128 update_expiry_ps(MC146818RtcState *state)
+{
+    return qemu_timer_tcg_ps_enabled() ?
+        timer_expire_time_ps_wide(state->update_timer) :
+        (__int128)timer_expire_time_ns(state->update_timer) *
+            PICOSECONDS_PER_NANOSECOND;
+}
+
+static void destroy_rtc(MC146818RtcState *state)
+{
+    timer_free(state->update_timer);
+    object_unref(OBJECT(state));
+}
