+    stl_be_p(roster, 11);
+    for (size_t index = 0; index < QEMU_CRUCIBLE_STANDING_CLASS_COUNT; index++) {
+        stq_be_p(roster + cursor, index + 1);
+        cursor += 10; /* Two absent optional budgets follow each poll. */
+    }
+    stl_be_p(standing + 192, cursor);
