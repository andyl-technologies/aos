+static void test_stream_refusal(gconstpointer opaque)
+{
+    unsigned mutation = GPOINTER_TO_UINT(opaque);
+    ICH9LPCState lpc = { 0 };
+    GByteArray *bytes;
+    size_t payload;
+    __int128 original[3];
+
+    if (!run_in_child()) {
+        return;
+    }
+    initialize_fixture(&lpc, true);
+    observed_ps = ((__int128)1 << 120) + 357;
+    tco_timer_reload(&lpc.pm.tco_regs);
+    ich9_pm_update_swsmi_timer(&lpc.pm, true);
+    ich9_pm_update_periodic_timer(&lpc.pm, true);
+    bytes = save_auxiliary(&lpc.pm);
+    payload = subsection_payload(bytes, "ich9_pm/tco-timer-wide");
+    switch (mutation) {
+    case 0:
+        bytes->data[payload] = 0;
+        break;
+    case 1:
+        bytes->data[payload + 1] = 2;
+        break;
+    case 2:
+        /* A writer-derived active deadline cannot become canonical inactive. */
+        bytes->data[payload + 1] = 0;
+        break;
+    case 3:
+        bytes->data[payload - 1] = 2;
+        break;
+    case 4: {
+        size_t start = payload - strlen("ich9_pm/tco-timer-wide") - 6;
+
+        g_byte_array_remove_range(bytes, start, payload + 18 - start);
+        break;
+    }
+    case 5: {
+        size_t start = payload - strlen("ich9_pm/tco-timer-wide") - 6;
+        GByteArray *duplicate = g_byte_array_new();
+
+        g_byte_array_append(duplicate, bytes->data, bytes->len - 1);
+        g_byte_array_append(duplicate, bytes->data + start,
+                            payload + 18 - start);
+        g_byte_array_append(duplicate, bytes->data + bytes->len - 1, 1);
+        g_byte_array_unref(bytes);
+        bytes = duplicate;
+        break;
+    }
+    case 6:
+        payload = subsection_payload(bytes, "ich9_pm/swsmi-timer-wide");
+        bytes->data[payload] = 0;
+        break;
+    case 7:
+        payload = subsection_payload(bytes, "ich9_pm/periodic-timer-wide");
+        bytes->data[payload] = 0;
+        break;
+    default:
+        g_assert_not_reached();
+    }
+    for (unsigned index = 0; index < 3; index++) {
+        QEMUTimer *timer = ich9_aux_timer(&lpc.pm, index);
+
+        original[index] = observed_ps + 999 + index;
+        timer_mod_ps_wide(timer, original[index]);
+    }
+
+    g_assert_cmpint(load_auxiliary(&lpc.pm, bytes), <, 0);
+    for (unsigned index = 0; index < 3; index++) {
+        g_assert_true(timer_pending(ich9_aux_timer(&lpc.pm, index)));
+        g_assert_true(timer_expire_time_ps_wide(ich9_aux_timer(&lpc.pm, index))
+                       == original[index]);
+    }
+    g_byte_array_unref(bytes);
+    destroy_fixture(&lpc);
+}
