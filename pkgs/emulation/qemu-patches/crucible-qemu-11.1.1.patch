+int qemu_thread_create_bounded(QemuThread *thread, const char *name,
+                              void *(*entry)(void *), void *opaque,
+                              void *stack, size_t stack_bytes,
+                              QemuThreadBoundedCreateReceipt *receipt)
+{
+    pthread_attr_t attributes;
+    QemuThreadArgs *arguments = NULL;
+    sigset_t blocked, previous;
+    size_t name_bytes;
+    uint64_t prior_generation = 0;
+    int status;
+
+    if (!thread || !name || !entry || !opaque || !stack || !stack_bytes || !receipt) {
+        return -EINVAL;
+    }
+    if (receipt->canonical_owner) {
+        if (!bounded_creator(thread, opaque, receipt)) {
+            return -EPERM;
+        }
+        pthread_mutex_lock(&qemu_hot_fork_thread_lock);
+        status = bounded_record_locked(receipt) || !receipt->identity_returned ?
+            -EALREADY : 0;
+        pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+        if (status) {
+            return status;
+        }
+        prior_generation = receipt->birth_generation;
+    }
+    *receipt = (QemuThreadBoundedCreateReceipt) {
+        .canonical_owner = receipt,
+        .thread_owner = thread,
+        .native_owner = opaque,
+        .process_id = getpid(),
+        .birth_generation = prior_generation,
+        .enrollment_status = -EINPROGRESS,
+    };
+    qemu_thread_get_self(&receipt->creator);
+    if (prior_generation == UINT64_MAX) {
+        receipt->first_status = -EOVERFLOW;
+        return -EOVERFLOW;
+    }
+    /* Generation is local to this retained owner/cell identity, not a TID or
+     * the independently mutable registry census generation. Failed attempts
+     * consume history too; no process-global counter or new credit is needed. */
+    receipt->birth_generation++;
+    name_bytes = strnlen(name, QEMU_HOT_FORK_THREAD_NAME_MAX + 1) + 1;
+    if (!qemu_thread_bounded_control_bytes(name_bytes)) {
+        receipt->first_status = -EINVAL;
+        return -EINVAL;
+    }
+    status = pthread_attr_init(&attributes);
+    if (status) {
+        receipt->first_status = -status;
+        return -status;
+    }
+    /* The retained mapping contains the whole stack; no hidden guard mapping
+     * or implementation-selected stack is authorized by this constructor. */
+    status = pthread_attr_setguardsize(&attributes, 0);
+    if (!status) {
+        status = pthread_attr_setstack(&attributes, stack, stack_bytes);
+    }
+    if (status) {
+        status = -status;
+        goto finished;
+    }
+    arguments = g_try_new0(QemuThreadArgs, 1);
+    if (!arguments) {
+        status = -ENOMEM;
+        goto finished;
+    }
+    arguments->name = g_try_malloc(name_bytes);
+    if (!arguments->name) {
+        status = -ENOMEM;
+        goto finished;
+    }
+    memcpy(arguments->name, name, name_bytes);
+    arguments->start_routine = entry;
+    arguments->arg = opaque;
+    arguments->mode = QEMU_THREAD_JOINABLE;
+    arguments->bounded = receipt;
+
+    sigfillset(&blocked);
+    sigdelset(&blocked, SIGSEGV);
+    sigdelset(&blocked, SIGFPE);
+    sigdelset(&blocked, SIGILL);
+    status = pthread_sigmask(SIG_SETMASK, &blocked, &previous);
+    if (status) {
+        status = -status;
+        goto finished;
+    }
+    qemu_hot_fork_thread_start_begin();
+    receipt->birth_attempted = true;
+    status = pthread_create(&thread->thread, &attributes,
+                            qemu_thread_start, arguments);
+    /* Physical birth precedes every fallible restoration/disposition post. */
+    receipt->create_status = status ? -status : 0;
+    receipt->born = status == 0;
+    if (status) {
+        qemu_hot_fork_thread_start_end();
+    }
+    receipt->mask_restore_status =
+        -pthread_sigmask(SIG_SETMASK, &previous, NULL);
+    status = receipt->create_status;
+
+finished:
+    receipt->first_status = status;
+    receipt->attr_destroy_status = -pthread_attr_destroy(&attributes);
+    if (!receipt->born && arguments) {
+        g_free(arguments->name);
+        g_free(arguments);
+    }
+    return status ? status : receipt->mask_restore_status ?
+        receipt->mask_restore_status : receipt->attr_destroy_status;
+}
