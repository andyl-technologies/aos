+         chain_index++) {
+        VirtioNetRscChain *chain;
+        uint16_t proto = qemu_get_be16(f);
+        uint32_t segment_count;
+        uint8_t protocol_bit;
+
+        if (proto == ETH_P_IP) {
+            protocol_bit = 1;
+        } else if (proto == ETH_P_IPV6) {
+            protocol_bit = 2;
+        } else {
+            error_setg(errp, "virtio-net RSC stream has invalid protocol");
+            return false;
+        }
+        if (protocols & protocol_bit) {
+            error_setg(errp, "virtio-net RSC stream has duplicate protocol");
+            return false;
+        }
+        protocols |= protocol_bit;
+
+        chain = virtio_net_rsc_new_chain(n, proto);
+        if (!vmstate_info_timer_ns_phase.load(f, chain->drain_timer, 0,
+                                              NULL, errp)) {
+            return false;
+        }
+        segment_count = qemu_get_be32(f);
+        if (segment_count > VIRTIO_NET_RSC_MAX_MIGRATION_SEGS) {
+            error_setg(errp, "virtio-net RSC stream has too many segments");
+            return false;
+        }
+
+        for (uint32_t segment_index = 0; segment_index < segment_count;
+             segment_index++) {
+            VirtioNetRscSeg *seg = g_new0(VirtioNetRscSeg, 1);
+            uint16_t queue_index = qemu_get_be16(f);
+            uint32_t size = qemu_get_be32(f);
+            uint8_t is_coalesced;
+            size_t allocation_size = guest_hdr_len +
+                                     sizeof(struct eth_header) +
+                                     sizeof(struct ip6_header) +
+                                     VIRTIO_NET_MAX_TCP_PAYLOAD;
+
+            seg->size = size;
+            seg->packets = qemu_get_be16(f);
+            seg->dup_ack = qemu_get_be16(f);
+            is_coalesced = qemu_get_byte(f);
+            if (queue_index >= n->max_ncs || size > allocation_size ||
+                size > VIRTIO_NET_RSC_MAX_MIGRATION_BYTES - aggregate_size ||
+                is_coalesced > 1) {
+                g_free(seg);
+                error_setg(errp, "virtio-net RSC segment bounds are invalid");
+                return false;
+            }
+            seg->is_coalesced = is_coalesced;
+
+            seg->buf = g_malloc(allocation_size);
+            if (qemu_get_buffer(f, seg->buf, size) != size) {
+                g_free(seg->buf);
+                g_free(seg);
+                error_setg(errp, "virtio-net RSC segment payload is truncated");
+                return false;
+            }
+            seg->nc = qemu_get_subqueue(n->nic, queue_index);
+            if (!virtio_net_rsc_validate_seg(chain, seg, guest_hdr_len,
+                                             true, errp)) {
+                g_free(seg->buf);
+                g_free(seg);
+                return false;
+            }
+            aggregate_size += size;
+            QTAILQ_INSERT_TAIL(&chain->buffers, seg, next);
+        }
+        if (segment_count && !timer_pending(chain->drain_timer)) {
+            error_setg(errp,
+                       "virtio-net RSC buffered stream has no drain timer");
+            return false;
+        }
+    }
+    return qemu_file_get_error(f) == 0;
+}
+
+static bool virtio_net_rsc_state_load(QEMUFile *f, void *pv, size_t size,
