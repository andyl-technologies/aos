+static void test_poll_events(void)
+{
+    struct qemu_plugin_crucible_fault_event event;
+    uint8_t envelope[8192];
+    const uint8_t *evidence;
+    size_t envelope_len = 0;
+    size_t evidence_len = 0;
+    int status;
+
+    do {
+        memset(&event, 0, sizeof(event));
+        envelope_len = 0;
+        status = qemu_plugin_crucible_fault_event_poll(
+            &event, envelope, sizeof(envelope), &envelope_len);
+        if (status < 0) {
+            test_fail("register event polling failed");
+        }
+        if (status == 1 && test_mode_rejects()) {
+            test_fail("a rejected register command emitted an event");
+        }
+        if (status == 1 && event.command_kind ==
+                CRUCIBLE_FAULT_COMMAND_CPU_REGISTER_TRANSFORM) {
+            evidence = test_event_evidence(
+                &event, envelope, envelope_len, &evidence_len);
+            if (event.model_phase != test_model_phase ||
+                event.outcome != CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED ||
+                event.target_kind != CRUCIBLE_NODE_FAULT_TARGET_REGISTER ||
+                event.evidence_length != evidence_len ||
+                event.event_sequence == 0 ||
+                event.rule_command_sequence != 2 ||
+                event.observed_icount == 0 || event.generation != 1 ||
+                memcmp(event.binding_hash, test_command.binding_hash, 32) != 0 ||
+                memcmp(event.action_hash, test_action_hash, 32) != 0 ||
+                memcmp(event.target_hash, test_target_hash, 32) != 0) {
+                g_printerr("register event debug phase=%u expected_phase=%u "
+                           "outcome=%u target=%u evidence=%u sequence=%" G_GUINT64_FORMAT
+                           " rule_sequence=%" G_GUINT64_FORMAT
+                           " icount=%" G_GUINT64_FORMAT
+                           " generation=%" G_GUINT64_FORMAT
+                           " expected_generation=%" G_GUINT64_FORMAT "\n",
+                           event.model_phase, test_model_phase, event.outcome,
+                           event.target_kind, event.evidence_length,
+                           event.event_sequence, event.rule_command_sequence,
+                           event.observed_icount, event.generation,
+                           UINT64_C(1));
+                test_fail("register event identity is wrong");
+            }
+            bool changed = test_validate_register_evidence(
+                evidence, evidence_len, test_mode == TEST_MODE_IMPULSE,
+                event.observed_icount, event.before_hash, event.after_hash,
+                event.opportunity_hash);
+            if (test_result_validated && changed &&
+                (test_mode == TEST_MODE_IMPULSE || test_rule_installed)) {
+                test_validated = true;
+            }
+        }
+    } while (status == 1);
+}
