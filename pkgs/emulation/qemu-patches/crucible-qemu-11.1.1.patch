+static uint64_t node_retention_interval_ticks(QDict *parameters)
+{
+    uint64_t interval_ns;
+
+    g_assert(node_json_u64(qdict_get(parameters, "interval_nanos"),
+                           &interval_ns));
+    g_assert(interval_ns <= INT64_MAX / CRUCIBLE_SIM_TICKS_PER_NS);
+    return interval_ns * CRUCIBLE_SIM_TICKS_PER_NS;
+}
+
+static uint64_t node_memory_service(QemuCrucibleFaultRule *rule,
+                                    size_t length, uint64_t *latency_out)
+{
+    uint64_t latency, byte_rate, operation_rate, delay, now, ready;
+    bool has_byte_rate, has_operation_rate;
+
+    g_assert(node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_P1, &latency));
+    g_assert(node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_P2,
+                             &has_byte_rate));
+    g_assert(node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_P3, &byte_rate));
+    g_assert(node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_P4,
+                             &has_operation_rate));
+    g_assert(node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_P5,
+                            &operation_rate));
+    g_assert(latency <= INT64_MAX);
+    *latency_out = latency;
+    delay = 0;
+    if (has_byte_rate) {
+        uint64_t contribution = node_rate_delay(length, byte_rate);
+
+        if (delay > UINT64_MAX - contribution) {
+            error_report("Crucible memory service delay overflow");
+            abort();
+        }
+        delay += contribution;
+    }
+    if (has_operation_rate) {
+        uint64_t contribution = node_rate_delay(1, operation_rate);
+
+        if (delay > UINT64_MAX - contribution) {
+            error_report("Crucible memory service delay overflow");
+            abort();
+        }
+        delay += contribution;
+    }
+    g_assert(rule->service_ledger);
+    now = node_virtual_now_tick();
+    ready = MAX(now, rule->service_ledger->ready_tick);
+    if (ready > UINT64_MAX - delay) {
+        error_report("Crucible memory service coordinate overflow");
+        abort();
+    }
+    rule->service_ledger->ready_tick = ready + delay;
+    return rule->service_ledger->ready_tick - now;
+}
+
+static uint64_t node_memory_service_demand(QemuCrucibleFaultRule *rule,
+                                           uint64_t length,
+                                           uint64_t *latency_out)
+{
+    uint64_t latency, byte_rate, operation_rate, delay = 0;
+    bool has_byte_rate, has_operation_rate;
+
+    g_assert(node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_P1, &latency));
+    g_assert(node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_P2,
+                             &has_byte_rate));
+    g_assert(node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_P3, &byte_rate));
+    g_assert(node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_P4,
+                             &has_operation_rate));
+    g_assert(node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_P5,
+                            &operation_rate));
+    g_assert(latency <= INT64_MAX);
+    *latency_out = latency;
+    if (has_byte_rate) {
+        delay = node_rate_delay(length, byte_rate);
+    }
+    if (has_operation_rate) {
+        uint64_t contribution = node_rate_delay(1, operation_rate);
+
+        if (delay > UINT64_MAX - contribution) {
+            error_report("Crucible memory service delay overflow");
+            abort();
+        }
+        delay += contribution;
+    }
+    return delay;
+}
+
+static bool node_memory_service_demand_checked(
+    QemuCrucibleFaultRule *rule, uint64_t length,
+    uint64_t *latency_out, uint64_t *demand_out)
+{
+    uint64_t latency, byte_rate, operation_rate;
+    uint64_t demand = 0;
+    bool has_byte_rate, has_operation_rate;
+
+    g_assert(node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_P1, &latency));
+    g_assert(node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_P2,
+                             &has_byte_rate));
+    g_assert(node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_P3, &byte_rate));
+    g_assert(node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_P4,
+                             &has_operation_rate));
+    g_assert(node_field_u64(rule, CRUCIBLE_NODE_FAULT_FIELD_P5,
+                            &operation_rate));
+    g_assert(latency <= INT64_MAX);
+    if (has_byte_rate &&
+        !node_rate_delay_checked(length, byte_rate, &demand)) {
+        return false;
+    }
+    if (has_operation_rate) {
+        uint64_t contribution;
+
+        if (!node_rate_delay_checked(1, operation_rate, &contribution) ||
+            demand > UINT64_MAX - contribution) {
+            return false;
+        }
+        demand += contribution;
+    }
+    *latency_out = latency;
+    *demand_out = demand;
+    return true;
+}
+
+static bool node_memory_service_plan_add(QemuCrucibleFaultRule *rule,
+                                         uint64_t bytes)
+{
+    gpointer encoded;
+    CrucibleMemoryServicePlan *plan;
+
+    if (!crucible_memory_service_plan) {
+        crucible_memory_service_plan = g_array_new(
+            false, false, sizeof(CrucibleMemoryServicePlan));
+        crucible_memory_service_plan_index = g_hash_table_new(
+            g_direct_hash, g_direct_equal);
+    }
+    encoded = g_hash_table_lookup(crucible_memory_service_plan_index, rule);
+    if (encoded) {
+        plan = &g_array_index(
+            crucible_memory_service_plan, CrucibleMemoryServicePlan,
+            GPOINTER_TO_UINT(encoded) - 1);
+        if (plan->bytes > UINT64_MAX - bytes) {
+            node_memory_resource_terminal_metadata(
+                CRUCIBLE_NODE_RESOURCE_SERVICE_BYTES, plan->bytes,
+                bytes, UINT64_MAX, UINT64_MAX);
+            return false;
+        }
+        plan->bytes += bytes;
+        return true;
+    }
+    if (crucible_memory_service_plan->len ==
+        CRUCIBLE_NODE_MEMORY_MATCH_LIMIT) {
+        node_memory_resource_terminal_metadata(
+            CRUCIBLE_NODE_RESOURCE_SERVICE_RULES,
+            crucible_memory_service_plan->len,
+            (uint64_t)crucible_memory_service_plan->len + 1,
+            CRUCIBLE_NODE_MEMORY_MATCH_LIMIT,
+            CRUCIBLE_NODE_MEMORY_MATCH_LIMIT);
+        return false;
+    }
+    CrucibleMemoryServicePlan entry = { .rule = rule, .bytes = bytes };
+
+    g_array_append_val(crucible_memory_service_plan, entry);
+    g_hash_table_insert(crucible_memory_service_plan_index, rule,
+                        GUINT_TO_POINTER(crucible_memory_service_plan->len));
+    return true;
+}
+
+static void node_memory_service_plan_reset(void)
+{
+    if (crucible_memory_service_plan) {
+        g_array_set_size(crucible_memory_service_plan, 0);
+        g_hash_table_remove_all(crucible_memory_service_plan_index);
+    }
+}
+
+static bool node_memory_service_plan_valid(void)
+{
+    g_autoptr(GHashTable) demand_by_ledger = NULL;
+    uint64_t fixed_latency = 0;
+    uint64_t queue_delay = 0;
+    int64_t signed_now;
+    uint64_t now;
+
+    if (!crucible_memory_service_plan ||
+        crucible_memory_service_plan->len == 0) {
+        return true;
+    }
+    signed_now = icount_crucible_sim_tick_observed();
+    if (signed_now < 0) {
+        node_memory_resource_terminal_metadata(
+            CRUCIBLE_NODE_RESOURCE_VIRTUAL_TIME, 0, 0,
+            INT64_MAX, INT64_MAX);
+        return false;
+    }
+    now = signed_now;
+    demand_by_ledger = g_hash_table_new_full(
+        g_direct_hash, g_direct_equal, NULL, g_free);
+    for (guint i = 0; i < crucible_memory_service_plan->len; i++) {
+        CrucibleMemoryServicePlan *plan = &g_array_index(
+            crucible_memory_service_plan, CrucibleMemoryServicePlan, i);
+        uint64_t latency, demand, *stored;
+
+        if (!node_memory_service_demand_checked(
+                plan->rule, plan->bytes, &latency, &demand)) {
+            node_memory_resource_terminal_metadata(
+                CRUCIBLE_NODE_RESOURCE_ARITHMETIC, plan->bytes,
+                plan->bytes, UINT64_MAX, UINT64_MAX);
+            return false;
+        }
+        if (fixed_latency > UINT64_MAX - latency) {
+            node_memory_resource_terminal_metadata(
+                CRUCIBLE_NODE_RESOURCE_VIRTUAL_TIME, fixed_latency,
+                latency, UINT64_MAX, UINT64_MAX);
+            return false;
+        }
+        fixed_latency += latency;
+        stored = g_hash_table_lookup(
+            demand_by_ledger, plan->rule->service_ledger);
+        if (!stored) {
+            stored = g_new(uint64_t, 1);
+            *stored = 0;
+            g_hash_table_insert(demand_by_ledger,
+                                plan->rule->service_ledger, stored);
+        }
+        *stored = MAX(*stored, demand);
+    }
+    GHashTableIter iter;
+    gpointer ledger_key, demand_value;
+
+    g_hash_table_iter_init(&iter, demand_by_ledger);
+    while (g_hash_table_iter_next(&iter, &ledger_key, &demand_value)) {
+        CrucibleMemoryServiceLedger *ledger = ledger_key;
+        uint64_t demand = *(uint64_t *)demand_value;
+        uint64_t ready = MAX(now, ledger->ready_tick);
+        uint64_t reserved = node_memory_reserved_ledger(ledger);
+
+        if (ready > UINT64_MAX - reserved ||
+            ready + reserved > UINT64_MAX - demand) {
+            node_memory_resource_terminal_metadata(
+                CRUCIBLE_NODE_RESOURCE_VIRTUAL_TIME, ready,
+                reserved + demand,
+                UINT64_MAX, UINT64_MAX);
+            return false;
+        }
+        ready += reserved + demand;
+        queue_delay = MAX(queue_delay, ready - now);
+    }
+    if (fixed_latency > UINT64_MAX - queue_delay) {
+        node_memory_resource_terminal_metadata(
+            CRUCIBLE_NODE_RESOURCE_VIRTUAL_TIME, fixed_latency,
+            queue_delay, UINT64_MAX, UINT64_MAX);
+        return false;
+    }
+    if (crucible_memory_reserved_virtual_time > INT64_MAX - now ||
+        fixed_latency + queue_delay >
+            INT64_MAX - now - crucible_memory_reserved_virtual_time) {
+        node_memory_resource_terminal_metadata(
+            CRUCIBLE_NODE_RESOURCE_VIRTUAL_TIME,
+            now + MIN(crucible_memory_reserved_virtual_time,
+                      INT64_MAX - now),
+            fixed_latency + queue_delay, INT64_MAX, INT64_MAX);
+        return false;
+    }
+    return true;
+}
+
+static void node_memory_service_chain(uint8_t chain[32], uint64_t vaddr,
+                                      uint64_t gpa, const uint8_t *value,
+                                      size_t length)
+{
+    uint8_t material[112] = { 0 };
+
+    memcpy(material, chain, 32);
+    stq_le_p(material + 32, vaddr);
+    stq_le_p(material + 40, gpa);
+    stq_le_p(material + 48, length);
+    node_memory_sha256(value, length, material + 64);
+    node_memory_sha256(material, sizeof(material), chain);
+}
+
+static void node_memory_service_match_chain(uint8_t chain[32])
+{
+    uint8_t material[64];
+
+    memcpy(material, chain, 32);
+    memcpy(material + 32, crucible_memory_current_match_hash, 32);
+    node_memory_sha256(material, sizeof(material), chain);
+}
+
+static void node_memory_service_defer(QemuCrucibleFaultRule *rule,
+                                      uint32_t access_class, uint32_t vcpu,
+                                      uint64_t vaddr, uint64_t gpa,
+                                      const uint8_t *before,
+                                      const uint8_t *after, size_t length,
+                                      uint64_t observed_icount)
+{
+    gpointer encoded;
+    guint index;
+    CruciblePendingMemoryService *pending;
+
+    if (!crucible_memory_transaction.active) {
+        return;
+    }
+    if (!crucible_memory_pending_services) {
+        crucible_memory_pending_services = g_array_new(
+            false, false, sizeof(CruciblePendingMemoryService));
+        crucible_memory_pending_service_index = g_hash_table_new(
+            g_direct_hash, g_direct_equal);
+    }
+    encoded = g_hash_table_lookup(crucible_memory_pending_service_index,
+                                  rule);
+    if (encoded) {
+        index = GPOINTER_TO_UINT(encoded) - 1;
+        pending = &g_array_index(crucible_memory_pending_services,
+                                 CruciblePendingMemoryService, index);
+        if (pending->bytes > UINT64_MAX - length) {
+            error_report("Crucible transaction service bytes overflow");
+            abort();
+        }
+        pending->bytes += length;
+        node_memory_service_chain(pending->before_chain, vaddr, gpa, before,
+                                  length);
+        node_memory_service_chain(pending->after_chain, vaddr, gpa, after,
+                                  length);
+        node_memory_service_match_chain(pending->match_chain);
+        return;
+    }
+    if (crucible_memory_pending_services->len ==
+        CRUCIBLE_NODE_MEMORY_MATCH_LIMIT) {
+        error_report("Crucible transaction service rule bound exceeded");
+        abort();
+    }
+    CruciblePendingMemoryService entry = {
+        .rule = rule,
+        .bytes = length,
+        .access_class = access_class,
+        .vcpu = vcpu,
+        .vaddr = vaddr,
+        .gpa = gpa,
+        .observed_icount = observed_icount,
+        .transaction_identity = crucible_memory_transaction.identity,
+        .transaction_address = crucible_memory_transaction.address,
+        .transaction_length = crucible_memory_transaction.length,
+        .instruction_pc = crucible_memory_transaction.instruction_pc,
+        .instruction_ordinal =
+            crucible_memory_transaction.instruction_ordinal,
+        .retry_ordinal = crucible_memory_transaction.retry_ordinal,
+        .fragment_ordinal = crucible_memory_transaction.fragment_ordinal,
+        .has_instruction = crucible_memory_transaction.has_instruction,
+    };
+
+    node_memory_service_chain(entry.before_chain, vaddr, gpa, before,
+                              length);
+    node_memory_service_chain(entry.after_chain, vaddr, gpa, after, length);
+    node_memory_service_match_chain(entry.match_chain);
+
+    g_array_append_val(crucible_memory_pending_services, entry);
+    index = crucible_memory_pending_services->len - 1;
+    g_hash_table_insert(crucible_memory_pending_service_index, rule,
+                        GUINT_TO_POINTER(index + 1));
+}
+
+static void node_memory_service_event_prepare(
+    CruciblePendingMemoryService *pending, uint8_t opportunity_hash[32],
+    uint8_t evidence[QEMU_CRUCIBLE_DEFERRED_SERVICE_EVIDENCE_SIZE])
+{
+    uint8_t identity[304] = { 0 };
+    uint8_t ledger_hash[32];
+    uint8_t scope_hash[32];
+    uint64_t latency, byte_rate, operation_rate;
+    bool has_byte_rate, has_operation_rate;
+
+    memcpy(identity, "CRUCMEM2", 8);
+    stl_le_p(identity + 8, pending->access_class);
+    stl_le_p(identity + 12, pending->vcpu);
+    stq_le_p(identity + 16, pending->vaddr);
+    stq_le_p(identity + 24, pending->gpa);
+    stq_le_p(identity + 32, pending->bytes);
+    stq_le_p(identity + 48, pending->transaction_identity);
+    stl_le_p(identity + 56, 1);
+    stq_le_p(identity + 64, pending->observed_icount);
+    stq_le_p(identity + 72, pending->rule->generation);
+    stq_le_p(identity + 88, pending->rule->service_ledger->ready_tick);
+    if (pending->access_class == QEMU_CRUCIBLE_MEMORY_PAGE_TABLE_WALK) {
+        stq_le_p(identity + 224,
+                 crucible_memory_transaction.page_table_target_vaddr);
+        stl_le_p(identity + 232,
+                 crucible_memory_transaction.page_table_level);
+        stl_le_p(identity + 236,
+                 crucible_memory_transaction.page_table_stage);
+        stl_le_p(identity + 240,
+                 crucible_memory_transaction.initiating_access_class);
+    }
+    stq_le_p(identity + 264, pending->transaction_address);
+    stq_le_p(identity + 272, pending->transaction_length);
+    stq_le_p(identity + 280, pending->observed_icount);
+    stq_le_p(identity + 288, pending->instruction_pc);
+    stl_le_p(identity + 296, pending->instruction_ordinal);
+    stl_le_p(identity + 300, pending->has_instruction);
+    memcpy(evidence, identity, sizeof(identity));
+    memcpy(evidence + 304, pending->before_chain, 32);
+    memcpy(evidence + 336, pending->after_chain, 32);
+    memcpy(evidence + 368, "CRUCSVC3", 8);
+    stl_le_p(evidence + 376, 3);
+    stl_le_p(evidence + 380, pending->retry_ordinal);
+    stl_le_p(evidence + 384, pending->fragment_ordinal);
+    stq_le_p(evidence + 392, pending->ledger_ready_before);
+    stq_le_p(evidence + 400, pending->ledger_ready_after);
+    stq_le_p(evidence + 408, pending->fixed_latency);
+    stq_le_p(evidence + 416, pending->demand);
+    stq_le_p(evidence + 424, pending->queue_delay);
+    stq_le_p(evidence + 432, pending->completion_delay);
+    g_assert(node_field_u64(pending->rule,
+                            CRUCIBLE_NODE_FAULT_FIELD_P1, &latency));
+    g_assert(node_field_bool(pending->rule,
+                             CRUCIBLE_NODE_FAULT_FIELD_P2,
+                             &has_byte_rate));
+    g_assert(node_field_u64(pending->rule,
+                            CRUCIBLE_NODE_FAULT_FIELD_P3, &byte_rate));
+    g_assert(node_field_bool(pending->rule,
+                             CRUCIBLE_NODE_FAULT_FIELD_P4,
+                             &has_operation_rate));
+    g_assert(node_field_u64(pending->rule,
+                            CRUCIBLE_NODE_FAULT_FIELD_P5,
+                            &operation_rate));
+    stq_le_p(evidence + 440, latency);
+    stq_le_p(evidence + 448, byte_rate);
+    stq_le_p(evidence + 456, operation_rate);
+    stl_le_p(evidence + 464,
+             (has_byte_rate ? 1 : 0) | (has_operation_rate ? 2 : 0));
+    stl_le_p(evidence + 468, CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED);
+    node_memory_sha256(
+        (const uint8_t *)pending->rule->service_ledger->key,
+        strlen(pending->rule->service_ledger->key), ledger_hash);
+    node_memory_sha256(
+        node_field(pending->rule, CRUCIBLE_NODE_FAULT_FIELD_P6)->data,
+        node_field(pending->rule, CRUCIBLE_NODE_FAULT_FIELD_P6)->length,
+        scope_hash);
+    memcpy(evidence + 472, ledger_hash, sizeof(ledger_hash));
+    memcpy(evidence + 504, scope_hash, sizeof(scope_hash));
+    memcpy(evidence + 536, pending->match_chain,
+           sizeof(pending->match_chain));
+    node_memory_sha256(identity, sizeof(identity), opportunity_hash);
+}
+
+static void node_memory_service_transaction_event(
+    CruciblePendingMemoryService *pending,
+    QemuCrucibleDeferredMemoryService *service)
+{
+    uint8_t opportunity_hash[32];
+    uint8_t evidence[QEMU_CRUCIBLE_DEFERRED_SERVICE_EVIDENCE_SIZE] = { 0 };
+
+    node_memory_service_event_prepare(pending, opportunity_hash, evidence);
+    if (service) {
+        qemu_crucible_fault_deferred_service_arm(
+            service, service->grant_tick, service->ready_tick,
+            node_memory_shadow_original(pending->rule),
+            pending->observed_icount,
+            opportunity_hash, pending->before_chain, pending->after_chain,
+            evidence);
+    } else {
+        qemu_crucible_fault_rule_event(
+            node_memory_shadow_original(pending->rule),
+            CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED,
+            pending->observed_icount, opportunity_hash,
+            pending->before_chain, pending->after_chain,
+            evidence, sizeof(evidence));
+        qemu_crucible_fault_notify_events();
+    }
+}
+
+static uint64_t node_memory_service_finish_transaction(void)
+{
+    g_autoptr(GArray) ledgers = NULL;
+    g_autoptr(GHashTable) ledger_index = NULL;
+    CrucibleCpuMemoryTicket *ticket = NULL;
+    CPUState *cpu = NULL;
+    uint64_t fixed_latency = 0;
+    uint64_t queue_delay = 0;
+    uint64_t completion_delay;
+    uint64_t now;
+    bool cpu_access;
+    bool cpu_ticket;
+
+    if (!crucible_memory_pending_services ||
+        crucible_memory_pending_services->len == 0) {
+        return 0;
+    }
+    cpu_access =
+        crucible_memory_transaction.access_class ==
+            QEMU_CRUCIBLE_MEMORY_CPU_LOAD ||
+        crucible_memory_transaction.access_class ==
+            QEMU_CRUCIBLE_MEMORY_CPU_STORE;
+    cpu_ticket = crucible_sim_shmem_dispatch_registered() && cpu_access;
+    if (crucible_sim_shmem_dispatch_registered() && !cpu_access) {
+        error_report("Unsupported cross-grant Crucible memory service form");
+        abort();
+    }
+    if (cpu_ticket) {
+        cpu = qemu_get_cpu(crucible_memory_transaction.actor);
+        if (crucible_memory_transaction.length != 1 ||
+            !crucible_memory_transaction.has_instruction ||
+            crucible_memory_pending_services->len != 1 ||
+            !qemu_crucible_fault_cpu_memory_ticket_supported(cpu)) {
+            error_report("Unsupported Crucible CPU memory service form");
+            abort();
+        }
+    }
+    ledgers = g_array_new(false, false,
+                          sizeof(CruciblePendingServiceLedger));
+    ledger_index = g_hash_table_new(g_direct_hash, g_direct_equal);
+    for (guint i = 0; i < crucible_memory_pending_services->len; i++) {
+        CruciblePendingMemoryService *pending = &g_array_index(
+            crucible_memory_pending_services, CruciblePendingMemoryService,
+            i);
+        uint64_t latency;
+        uint64_t demand = node_memory_service_demand(
+            pending->rule, pending->bytes, &latency);
+        gpointer encoded = g_hash_table_lookup(
+            ledger_index, pending->rule->service_ledger);
+        CruciblePendingServiceLedger *group;
+
+        if (fixed_latency > UINT64_MAX - latency) {
+            error_report("Crucible transaction fixed latency overflow");
+            abort();
+        }
+        fixed_latency += latency;
+        pending->fixed_latency = latency;
+        pending->demand = demand;
+        if (encoded) {
+            group = &g_array_index(ledgers, CruciblePendingServiceLedger,
+                                   GPOINTER_TO_UINT(encoded) - 1);
+            group->delay = MAX(group->delay, demand);
+        } else {
+            CruciblePendingServiceLedger new_group = {
+                .ledger = pending->rule->service_ledger,
+                .delay = demand,
+                .ready_before = pending->rule->service_ledger->ready_tick,
+            };
+
+            g_array_append_val(ledgers, new_group);
+            g_hash_table_insert(ledger_index, new_group.ledger,
+                GUINT_TO_POINTER(ledgers->len));
+        }
+    }
+    now = node_virtual_now_tick();
+    for (guint i = 0; i < ledgers->len; i++) {
+        CruciblePendingServiceLedger *group = &g_array_index(
+            ledgers, CruciblePendingServiceLedger, i);
+        uint64_t ready = MAX(now, group->ledger->ready_tick);
+
+        if (ready > UINT64_MAX - group->delay) {
+            error_report("Crucible transaction service coordinate overflow");
+            abort();
+        }
+        group->ledger->ready_tick = ready + group->delay;
+        group->ready_after = group->ledger->ready_tick;
+        group->queue_delay = group->ready_after - now;
+        queue_delay = MAX(queue_delay, group->queue_delay);
+    }
+    if (fixed_latency > UINT64_MAX - queue_delay) {
+        error_report("Crucible transaction service composition overflow");
+        abort();
+    }
+    completion_delay = fixed_latency + queue_delay;
+    if (cpu_ticket && completion_delay != 0) {
+        if (completion_delay > UINT64_MAX - now) {
+            error_report("Crucible CPU memory ticket coordinate overflow");
+            abort();
+        }
+        ticket = node_cpu_memory_ticket(cpu, true);
+        if (ticket->active || ticket->service.rule) {
+            error_report("Crucible CPU memory service ticket collision");
+            abort();
+        }
+        ticket->service.grant_tick = now;
+        ticket->service.ready_tick = now + completion_delay;
+    }
+    if (crucible_memory_transaction.streaming) {
+        CPUState *streaming_cpu =
+            qemu_get_cpu(crucible_memory_transaction.actor);
+        uint64_t delay = completion_delay;
+
+        if (!streaming_cpu ||
+            streaming_cpu->crucible_fetch_service_ticks >
+                UINT64_MAX - delay) {
+            error_report("Crucible fetch service staging overflow");
+            abort();
+        }
+        streaming_cpu->crucible_fetch_service_ticks += delay;
+    }
+    for (guint i = 0; i < crucible_memory_pending_services->len; i++) {
+        CruciblePendingMemoryService *pending = &g_array_index(
+            crucible_memory_pending_services, CruciblePendingMemoryService,
+            i);
+        gpointer encoded = g_hash_table_lookup(
+            ledger_index, pending->rule->service_ledger);
+        CruciblePendingServiceLedger *group = &g_array_index(
+            ledgers, CruciblePendingServiceLedger,
+            GPOINTER_TO_UINT(encoded) - 1);
+
+        pending->ledger_ready_before = group->ready_before;
+        pending->ledger_ready_after = group->ready_after;
+        pending->queue_delay = group->queue_delay;
+        pending->completion_delay = fixed_latency + queue_delay;
+
+        node_memory_service_transaction_event(
+            pending, ticket ? &ticket->service : NULL);
+    }
+    g_array_set_size(crucible_memory_pending_services, 0);
+    g_hash_table_remove_all(crucible_memory_pending_service_index);
+    return crucible_memory_transaction.streaming ? 0 :
+           completion_delay;
+}
+
+static void node_memory_apply_service(uint64_t delay)
+{
+    if (delay == 0) {
+        return;
+    }
+    if (!icount_crucible_advance_virtual_time_by_ticks(delay)) {
+        error_report("Crucible memory service coordinate overflow");
+        abort();
+    }
+}
+
+bool qemu_crucible_fault_memory_fetch_service_apply(CPUState *cpu)
+{
+    uint64_t delay;
+
+    if (!cpu) {
+        return false;
+    }
+    delay = cpu->crucible_fetch_service_ticks;
+    cpu->crucible_fetch_service_ticks = 0;
+    node_memory_apply_service(delay);
+    return delay != 0;
+}
+
+bool qemu_crucible_fault_memory_service_apply(CPUState *cpu)
+{
+    uint64_t delay;
+
+    if (!cpu) {
+        return false;
+    }
+    delay = cpu->crucible_memory_service_ticks;
+    cpu->crucible_memory_service_ticks = 0;
+    if (delay != 0) {
+        error_report("Unclaimed Crucible CPU memory service delay");
+        abort();
+    }
+    return false;
+}
+
+bool qemu_crucible_fault_cpu_memory_ticket_supported(const CPUState *cpu)
+{
+    return cpu &&
+        (object_dynamic_cast(OBJECT(cpu), "x86_64-cpu") ||
+         object_dynamic_cast(OBJECT(cpu), "i386-cpu"));
+}
+
+static void node_cpu_memory_ticket_clear(CrucibleCpuMemoryTicket *ticket)
+{
+    if (!ticket) {
+        return;
+    }
+    qemu_crucible_fault_deferred_service_clear(&ticket->service);
+    memset(ticket, 0, sizeof(*ticket));
+}
+
+static void node_cpu_memory_ticket_free(gpointer opaque)
+{
+    CrucibleCpuMemoryTicket *ticket = opaque;
+
+    node_cpu_memory_ticket_clear(ticket);
+    g_free(ticket);
+}
+
+static CrucibleCpuMemoryTicket *node_cpu_memory_ticket(CPUState *cpu,
+                                                       bool create)
+{
+    CrucibleCpuMemoryTicket *ticket;
+
+    if (!crucible_cpu_memory_tickets) {
+        if (!create) {
+            return NULL;
+        }
+        crucible_cpu_memory_tickets = g_hash_table_new_full(
+            g_direct_hash, g_direct_equal, NULL,
+            node_cpu_memory_ticket_free);
+    }
+    ticket = g_hash_table_lookup(crucible_cpu_memory_tickets, cpu);
+    if (!ticket && create) {
+        ticket = g_new0(CrucibleCpuMemoryTicket, 1);
+        g_hash_table_insert(crucible_cpu_memory_tickets, cpu, ticket);
+        qemu_crucible_fault_cpu_memory_tickets_exist = true;
+    }
+    return ticket;
+}
+
+bool qemu_crucible_fault_cpu_memory_ticket_pending(const CPUState *cpu)
+{
+    CrucibleCpuMemoryTicket *ticket =
+        node_cpu_memory_ticket((CPUState *)cpu, false);
+
+    return ticket && ticket->active && !ticket->ready;
+}
+
+bool qemu_crucible_fault_cpu_memory_ticket_active(const CPUState *cpu)
+{
+    CrucibleCpuMemoryTicket *ticket =
+        node_cpu_memory_ticket((CPUState *)cpu, false);
+
+    return ticket && ticket->active;
+}
+
+static bool node_cpu_memory_ticket_identity(
+    const CrucibleCpuMemoryTicket *ticket, const CPUState *cpu,
+    uint64_t instruction_pc, uint32_t instruction_ordinal)
+{
+    return ticket->actor == cpu->cpu_index &&
+           ticket->instruction_pc == instruction_pc &&
+           ticket->instruction_ordinal == instruction_ordinal;
+}
+
+bool qemu_crucible_fault_cpu_memory_ticket_replay_load(
+    CPUState *cpu, uint64_t vaddr, uint64_t instruction_pc,
+    uint32_t instruction_ordinal, uint8_t *value)
+{
+    CrucibleCpuMemoryTicket *ticket;
+
+    if (!qemu_crucible_fault_cpu_memory_ticket_supported(cpu) || !value) {
+        return false;
+    }
+    ticket = node_cpu_memory_ticket(cpu, false);
+    if (!ticket) {
+        return false;
+    }
+    if (!ticket->active || !ticket->ready ||
+        !node_cpu_memory_ticket_identity(
+            ticket, cpu, instruction_pc, instruction_ordinal) ||
+        ticket->load_vaddr != vaddr ||
+        (ticket->replay_phase != CRUCIBLE_CPU_MEMORY_REPLAY_ACCESS &&
+         ticket->replay_phase != CRUCIBLE_CPU_MEMORY_REPLAY_LOAD)) {
+        return false;
+    }
+    *value = ticket->load_value;
+    if (ticket->replay_phase == CRUCIBLE_CPU_MEMORY_REPLAY_LOAD) {
+        ticket->replay_phase = CRUCIBLE_CPU_MEMORY_REPLAY_STORE;
+    } else {
+        node_cpu_memory_ticket_clear(ticket);
+    }
+    return true;
+}
+
+bool qemu_crucible_fault_cpu_memory_ticket_replay_store(
+    CPUState *cpu, uint64_t vaddr, uint64_t instruction_pc,
+    uint32_t instruction_ordinal)
+{
+    CrucibleCpuMemoryTicket *ticket;
+
+    if (!qemu_crucible_fault_cpu_memory_ticket_supported(cpu)) {
+        return false;
+    }
+    ticket = node_cpu_memory_ticket(cpu, false);
+    if (!ticket) {
+        return false;
+    }
+    if (!ticket->active || !ticket->ready ||
+        ticket->access_class != QEMU_CRUCIBLE_MEMORY_CPU_STORE ||
+        (ticket->replay_phase != CRUCIBLE_CPU_MEMORY_REPLAY_ACCESS &&
+         ticket->replay_phase != CRUCIBLE_CPU_MEMORY_REPLAY_STORE) ||
+        ticket->store_vaddr != vaddr ||
+        !node_cpu_memory_ticket_identity(
+            ticket, cpu, instruction_pc, instruction_ordinal)) {
+        return false;
+    }
+    node_cpu_memory_ticket_clear(ticket);
+    return true;
+}
+
+void qemu_crucible_fault_cpu_memory_candidate_record(
+    CPUState *cpu, uint64_t vaddr, uint8_t value,
+    uint64_t instruction_pc, uint32_t instruction_ordinal)
+{
+    CrucibleCpuMemoryTicket *ticket;
+
+    if (!qemu_crucible_fault_cpu_memory_ticket_supported(cpu)) {
+        return;
+    }
+    ticket = node_cpu_memory_ticket(cpu, true);
+    if (ticket->active) {
+        return;
+    }
+    ticket->actor = cpu->cpu_index;
+    ticket->instruction_pc = instruction_pc;
+    ticket->instruction_ordinal = instruction_ordinal;
+    ticket->load_vaddr = vaddr;
+    ticket->load_value = value;
+    ticket->has_frozen_load = true;
+}
+
+void qemu_crucible_fault_cpu_memory_candidate_discard(CPUState *cpu)
+{
+    CrucibleCpuMemoryTicket *ticket = node_cpu_memory_ticket(cpu, false);
+
+    if (ticket && !ticket->active) {
+        ticket->has_frozen_load = false;
+    }
+}
+
+bool qemu_crucible_fault_cpu_memory_ticket_stage(
+    CPUState *cpu, enum QemuCrucibleMemoryAccessClass access_class,
+    uint64_t vaddr, uint64_t gpa, uint8_t value, bool suppress_store,
+    uint64_t instruction_pc, uint32_t instruction_ordinal)
+{
+    CrucibleCpuMemoryTicket *ticket;
+    uint64_t delay;
+    bool continue_load;
+
+    if (!qemu_crucible_fault_cpu_memory_ticket_supported(cpu) ||
+        (access_class != QEMU_CRUCIBLE_MEMORY_CPU_LOAD &&
+                 access_class != QEMU_CRUCIBLE_MEMORY_CPU_STORE)) {
+        return false;
+    }
+    delay = cpu->crucible_memory_service_ticks;
+    cpu->crucible_memory_service_ticks = 0;
+    if (delay == 0) {
+        return false;
+    }
+    ticket = node_cpu_memory_ticket(cpu, true);
+    if (ticket->active ||
+        !qemu_crucible_fault_deferred_service_valid(&ticket->service) ||
+        ticket->service.ready_tick - ticket->service.grant_tick != delay) {
+        error_report("Invalid Crucible CPU memory service ticket stage");
+        abort();
+    }
+    continue_load = access_class == QEMU_CRUCIBLE_MEMORY_CPU_STORE &&
+        ticket->has_frozen_load && ticket->actor == cpu->cpu_index &&
+        ticket->instruction_pc == instruction_pc &&
+        ticket->instruction_ordinal == instruction_ordinal;
+    if (!continue_load) {
+        ticket->has_frozen_load = false;
+        ticket->load_vaddr = vaddr;
+        ticket->load_value = value;
+    }
+    ticket->instruction_pc = instruction_pc;
+    ticket->store_vaddr = vaddr;
+    ticket->store_gpa = gpa;
+    ticket->actor = cpu->cpu_index;
+    ticket->instruction_ordinal = instruction_ordinal;
+    ticket->access_class = access_class;
+    ticket->replay_phase = continue_load ?
+        CRUCIBLE_CPU_MEMORY_REPLAY_LOAD : CRUCIBLE_CPU_MEMORY_REPLAY_ACCESS;
+    ticket->store_value = value;
+    ticket->suppress_store = suppress_store;
+    ticket->active = true;
+    ticket->ready = false;
+    return true;
+}
+
+static void node_cpu_memory_service_boundary(uint16_t phase,
+                                             uint64_t observed_icount)
+{
+    CPUState *cpu;
+    int64_t signed_now = icount_crucible_sim_tick_observed();
+
+    (void)observed_icount;
+    if (phase != CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY || signed_now < 0) {
+        return;
+    }
+    CPU_FOREACH(cpu) {
+        CrucibleCpuMemoryTicket *ticket =
+            node_cpu_memory_ticket(cpu, false);
+
+        if (!ticket || !ticket->active || ticket->ready ||
+            ticket->service.ready_tick > (uint64_t)signed_now) {
+            continue;
+        }
+        if (ticket->access_class == QEMU_CRUCIBLE_MEMORY_CPU_STORE &&
+            !ticket->suppress_store) {
+            physical_memory_write(ticket->store_gpa,
+                                  &ticket->store_value, 1);
+        }
+        qemu_crucible_fault_deferred_service_publish(&ticket->service);
+        ticket->ready = true;
+    }
+}
+
+static uint64_t node_cpu_memory_service_deadline(uint16_t phase)
+{
+    CPUState *cpu;
+    uint64_t deadline = UINT64_MAX;
+
+    if (phase != CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY) {
+        return deadline;
+    }
+    CPU_FOREACH(cpu) {
+        CrucibleCpuMemoryTicket *ticket =
+            node_cpu_memory_ticket(cpu, false);
+
+        if (ticket && ticket->active && !ticket->ready) {
+            deadline = MIN(deadline, ticket->service.ready_tick);
+        }
+    }
+    return deadline;
+}
+
+static CPUState *node_cpu_memory_ticket_actor(uint32_t actor)
+{
+    CPUState *cpu;
+
+    CPU_FOREACH(cpu) {
+        if (cpu->cpu_index == actor) {
+            return cpu;
+        }
+    }
+    return NULL;
+}
+
+static int node_cpu_memory_ticket_vmstate_save(GByteArray *payload)
+{
+    CPUState *cpu;
+    uint32_t count = 0;
+
+    CPU_FOREACH(cpu) {
+        CrucibleCpuMemoryTicket *ticket =
+            node_cpu_memory_ticket(cpu, false);
+
+        if (ticket && ticket->active) {
+            count++;
+        }
+    }
+    qemu_crucible_fault_vmstate_put_bytes(payload, "CRUCPUT2", 8);
+    qemu_crucible_fault_vmstate_put_u32(payload, count);
+    CPU_FOREACH(cpu) {
+        CrucibleCpuMemoryTicket *ticket =
+            node_cpu_memory_ticket(cpu, false);
+        uint8_t flags;
+
+        if (!ticket || !ticket->active) {
+            continue;
+        }
+        if ((!ticket->ready &&
+             !qemu_crucible_fault_deferred_service_valid(
+                 &ticket->service)) ||
+            (ticket->ready &&
+             (ticket->service.ready_tick < ticket->service.grant_tick ||
+              ticket->service.rule ||
+              ticket->service.event_reservation))) {
+            return -EINVAL;
+        }
+        flags = (ticket->ready ? 1 : 0) |
+                (ticket->suppress_store ? 2 : 0) |
+                (ticket->has_frozen_load ? 4 : 0);
+        qemu_crucible_fault_vmstate_put_u64(payload, ticket->instruction_pc);
+        qemu_crucible_fault_vmstate_put_u64(payload, ticket->load_vaddr);
+        qemu_crucible_fault_vmstate_put_u64(payload, ticket->store_vaddr);
+        qemu_crucible_fault_vmstate_put_u64(payload, ticket->store_gpa);
+        qemu_crucible_fault_vmstate_put_u32(payload, ticket->actor);
+        qemu_crucible_fault_vmstate_put_u32(
+            payload, ticket->instruction_ordinal);
+        qemu_crucible_fault_vmstate_put_u8(payload, ticket->access_class);
+        qemu_crucible_fault_vmstate_put_u8(payload, ticket->replay_phase);
+        qemu_crucible_fault_vmstate_put_u8(payload, ticket->load_value);
+        qemu_crucible_fault_vmstate_put_u8(payload, ticket->store_value);
+        qemu_crucible_fault_vmstate_put_u8(payload, flags);
+        qemu_crucible_fault_vmstate_put_u8(payload, 0);
+        qemu_crucible_fault_vmstate_put_u16(payload, 0);
+        if (ticket->ready) {
+            qemu_crucible_fault_vmstate_put_u64(
+                payload, ticket->service.grant_tick);
+            qemu_crucible_fault_vmstate_put_u64(
+                payload, ticket->service.ready_tick);
+        } else {
+            qemu_crucible_fault_deferred_service_vmstate_save(
+                payload, &ticket->service);
+        }
+    }
+    return 0;
+}
+
+static bool node_cpu_memory_ticket_vmstate_valid(
+    const CrucibleCpuMemoryTicket *ticket)
+{
+    return ticket->actor != UINT32_MAX &&
+        ticket->service.ready_tick >= ticket->service.grant_tick &&
+        (ticket->access_class == QEMU_CRUCIBLE_MEMORY_CPU_LOAD ||
+         ticket->access_class == QEMU_CRUCIBLE_MEMORY_CPU_STORE) &&
+        ticket->replay_phase >= CRUCIBLE_CPU_MEMORY_REPLAY_ACCESS &&
+        ticket->replay_phase <= CRUCIBLE_CPU_MEMORY_REPLAY_STORE &&
+        (ticket->access_class != QEMU_CRUCIBLE_MEMORY_CPU_LOAD ||
+         ticket->replay_phase == CRUCIBLE_CPU_MEMORY_REPLAY_ACCESS) &&
+        (ticket->replay_phase != CRUCIBLE_CPU_MEMORY_REPLAY_LOAD ||
+         (ticket->access_class == QEMU_CRUCIBLE_MEMORY_CPU_STORE &&
+          ticket->has_frozen_load)) &&
+        (ticket->ready ?
+         (!ticket->service.rule && !ticket->service.event_reservation) :
+         qemu_crucible_fault_deferred_service_valid(&ticket->service));
+}
+
+static int node_cpu_memory_ticket_vmstate_prepare(
+    const uint8_t *payload, size_t payload_len, void **staged_out)
+{
+    QemuCrucibleFaultVmstateReader reader = {
+        .data = payload,
+        .length = payload_len,
+    };
+    GArray *staged = g_array_new(
+        false, false, sizeof(CrucibleCpuMemoryTicket));
+    g_autoptr(GHashTable) actors = g_hash_table_new(
+        g_direct_hash, g_direct_equal);
+    uint8_t magic[8];
+    uint32_t count;
+
+    if (!qemu_crucible_fault_vmstate_get_bytes(&reader, magic, 8) ||
+        memcmp(magic, "CRUCPUT2", 8) != 0 ||
+        !qemu_crucible_fault_vmstate_get_u32(&reader, &count) ||
+        count > CRUCIBLE_NODE_VMSTATE_MAX_RULES) {
+        goto fail;
+    }
+    for (uint32_t i = 0; i < count; i++) {
+        CrucibleCpuMemoryTicket ticket = { .active = true };
+        uint8_t flags, reserved8;
+        uint16_t reserved16;
+        CPUState *cpu;
+
+        if (!qemu_crucible_fault_vmstate_get_u64(
+                &reader, &ticket.instruction_pc) ||
+            !qemu_crucible_fault_vmstate_get_u64(
+                &reader, &ticket.load_vaddr) ||
+            !qemu_crucible_fault_vmstate_get_u64(
+                &reader, &ticket.store_vaddr) ||
+            !qemu_crucible_fault_vmstate_get_u64(
+                &reader, &ticket.store_gpa) ||
+            !qemu_crucible_fault_vmstate_get_u32(&reader, &ticket.actor) ||
+            !qemu_crucible_fault_vmstate_get_u32(
+                &reader, &ticket.instruction_ordinal) ||
+            !qemu_crucible_fault_vmstate_get_u8(
+                &reader, &ticket.access_class) ||
+            !qemu_crucible_fault_vmstate_get_u8(
+                &reader, &ticket.replay_phase) ||
+            !qemu_crucible_fault_vmstate_get_u8(
+                &reader, &ticket.load_value) ||
+            !qemu_crucible_fault_vmstate_get_u8(
+                &reader, &ticket.store_value) ||
+            !qemu_crucible_fault_vmstate_get_u8(&reader, &flags) ||
+            !qemu_crucible_fault_vmstate_get_u8(&reader, &reserved8) ||
+            !qemu_crucible_fault_vmstate_get_u16(&reader, &reserved16) ||
+            flags > 7 || reserved8 != 0 || reserved16 != 0 ||
+            ticket.actor == UINT32_MAX ||
+            g_hash_table_contains(
+                actors, GUINT_TO_POINTER(ticket.actor + 1))) {
+            goto fail;
+        }
+        ticket.ready = flags & 1;
+        ticket.suppress_store = flags & 2;
+        ticket.has_frozen_load = flags & 4;
+        if (ticket.ready) {
+            if (!qemu_crucible_fault_vmstate_get_u64(
+                    &reader, &ticket.service.grant_tick) ||
+                !qemu_crucible_fault_vmstate_get_u64(
+                    &reader, &ticket.service.ready_tick)) {
+                goto fail;
+            }
+        } else if (!qemu_crucible_fault_deferred_service_vmstate_load(
+                       &reader, &ticket.service)) {
+            goto fail;
+        }
+        cpu = node_cpu_memory_ticket_actor(ticket.actor);
+        if (!qemu_crucible_fault_cpu_memory_ticket_supported(cpu) ||
+            !node_cpu_memory_ticket_vmstate_valid(&ticket)) {
+            qemu_crucible_fault_deferred_service_vmstate_discard(
+                &ticket.service);
+            goto fail;
+        }
+        g_hash_table_add(actors, GUINT_TO_POINTER(ticket.actor + 1));
+        g_array_append_val(staged, ticket);
+    }
+    if (!qemu_crucible_fault_vmstate_reader_finished(&reader)) {
+        goto fail;
+    }
+    *staged_out = staged;
+    return 0;
+
+fail:
+    for (guint i = 0; i < staged->len; i++) {
+        CrucibleCpuMemoryTicket *ticket = &g_array_index(
+            staged, CrucibleCpuMemoryTicket, i);
+
+        qemu_crucible_fault_deferred_service_vmstate_discard(
+            &ticket->service);
+    }
+    g_array_unref(staged);
+    return -EINVAL;
+}
+
+static void node_cpu_memory_ticket_vmstate_commit(void *opaque)
+{
+    GArray *staged = opaque;
+
+    g_clear_pointer(&crucible_cpu_memory_tickets, g_hash_table_unref);
+    qemu_crucible_fault_cpu_memory_tickets_exist = false;
+    for (guint i = 0; i < staged->len; i++) {
+        CrucibleCpuMemoryTicket *source = &g_array_index(
+            staged, CrucibleCpuMemoryTicket, i);
+        CPUState *cpu = node_cpu_memory_ticket_actor(source->actor);
+        CrucibleCpuMemoryTicket *ticket = node_cpu_memory_ticket(cpu, true);
+
+        *ticket = *source;
+        source->service.rule = NULL;
+        source->service.event_reservation = NULL;
+    }
+    g_array_unref(staged);
+}
+
+static void node_cpu_memory_ticket_vmstate_free(void *opaque)
+{
+    GArray *staged = opaque;
+
+    for (guint i = 0; i < staged->len; i++) {
+        CrucibleCpuMemoryTicket *ticket = &g_array_index(
+            staged, CrucibleCpuMemoryTicket, i);
+
+        qemu_crucible_fault_deferred_service_vmstate_discard(
+            &ticket->service);
+    }
+    g_array_unref(staged);
+}
+
+static const QemuCrucibleFaultVmstateSection
+crucible_cpu_memory_ticket_vmstate_section = {
+    .name = "cpu-memory-service-ticket",
+    .version = 1,
+    .save = node_cpu_memory_ticket_vmstate_save,
+    .fingerprint_projection = node_cpu_memory_ticket_vmstate_save,
+    .prepare = node_cpu_memory_ticket_vmstate_prepare,
+    .commit = node_cpu_memory_ticket_vmstate_commit,
+    .free_staged = node_cpu_memory_ticket_vmstate_free,
+};
+
+static bool node_rule_physical_span(QemuCrucibleFaultRule *rule,
+                                    uint64_t rule_offset, uint64_t *gpa,
+                                    uint64_t *available)
+{
+    uint64_t start, length;
+    bool has_vcpu;
+
+    if (!node_rule_memory_range(rule, &start, &length) ||
+        rule_offset >= length ||
+        !node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_T3, &has_vcpu)) {
+        return false;
+    }
+    if (!has_vcpu) {
+        *gpa = start + rule_offset;
+        *available = length - rule_offset;
+        return true;
+    }
+
+    uint64_t logical = start + rule_offset;
+
+    for (guint i = 0; i < rule->translations->len; i++) {
+        CrucibleNodeTranslation *translation = &g_array_index(
+            rule->translations, CrucibleNodeTranslation, i);
+        uint64_t covered_start = MAX(start, translation->virtual_page);
+        uint64_t covered_end = covered_start + translation->covered_bytes;
+
+        if (logical >= covered_start && logical < covered_end) {
+            *gpa = translation->physical_page +
+                   (logical - translation->virtual_page);
+            *available = covered_end - logical;
+            return true;
+        }
+    }
+    return false;
+}
+
+static void node_memory_mutation_evidence_reset(QemuCrucibleFaultRule *rule)
+{
+    rule->evidence_mutation_count = 0;
+    rule->evidence_mutation_bytes = 0;
+    memset(rule->evidence_mutation_hash, 0,
+           sizeof(rule->evidence_mutation_hash));
+    memset(&rule->evidence_aggressor, 0,
+           sizeof(rule->evidence_aggressor));
+    rule->evidence_counter_before = 0;
+    rule->evidence_counter_after = 0;
+    rule->evidence_victim_rows = 0;
+    if (rule->evidence_mutation_records) {
+        g_byte_array_set_size(rule->evidence_mutation_records, 0);
+    }
+    if (rule->evidence_counter_records) {
+        g_byte_array_set_size(rule->evidence_counter_records, 0);
+    }
+}
+
+static void node_memory_counter_evidence_add(
+    QemuCrucibleFaultRule *rule,
+    const CrucibleDramCoordinate *coordinate,
+    uint64_t before, uint64_t after)
+{
+    uint8_t record[64] = { 0 };
+
+    if (!rule->evidence_counter_records) {
+        rule->evidence_counter_records = g_byte_array_new();
+    }
+    g_assert(rule->evidence_counter_records->len <=
+             CRUCIBLE_FAULT_HARD_PAYLOAD_BYTES - sizeof(record));
+    memcpy(record, "CRUCROW1", 8);
+    stq_le_p(record + 8, coordinate->row);
+    stw_le_p(record + 16, coordinate->channel);
+    stw_le_p(record + 18, coordinate->rank);
+    stw_le_p(record + 20, coordinate->bank);
+    stq_le_p(record + 24, before);
+    stq_le_p(record + 32, after);
+    g_byte_array_append(rule->evidence_counter_records,
+                        record, sizeof(record));
+}
+
+static void node_memory_mutation_evidence_add(QemuCrucibleFaultRule *rule,
+                                              uint64_t physical,
+                                              uint64_t rule_offset,
+                                              const uint8_t *before,
+                                              const uint8_t *after,
+                                              size_t length, bool clear)
+{
+    uint8_t record[128] = { 0 };
+    uint8_t exact[96] = { 0 };
+
+    g_assert(rule->evidence_mutation_count != UINT64_MAX);
+    g_assert(rule->evidence_mutation_bytes <= UINT64_MAX - length);
+    memcpy(record, rule->evidence_mutation_hash, 32);
+    stq_le_p(record + 32, physical);
+    stq_le_p(record + 40, rule_offset);
+    stq_le_p(record + 48, length);
+    stl_le_p(record + 56, clear);
+    node_memory_sha256(before, length, record + 64);
+    node_memory_sha256(after, length, record + 96);
+    node_memory_sha256(record, sizeof(record),
+                       rule->evidence_mutation_hash);
+    rule->evidence_mutation_count++;
+    rule->evidence_mutation_bytes += length;
+    if (!rule->evidence_mutation_records) {
+        rule->evidence_mutation_records = g_byte_array_new();
+    }
+    g_assert(rule->evidence_mutation_records->len <=
+             CRUCIBLE_FAULT_HARD_PAYLOAD_BYTES - sizeof(exact));
+    stq_le_p(exact, physical);
+    stq_le_p(exact + 8, rule_offset);
+    stq_le_p(exact + 16, length);
+    stl_le_p(exact + 24, clear);
+    node_memory_sha256(before, length, exact + 32);
+    node_memory_sha256(after, length, exact + 64);
+    g_byte_array_append(rule->evidence_mutation_records, exact,
+                        sizeof(exact));
+}
+
+static bool node_memory_dma_transaction_active(void)
+{
+    return crucible_memory_transaction.active &&
+        (crucible_memory_transaction.access_class ==
+             QEMU_CRUCIBLE_MEMORY_DMA_READ ||
+         crucible_memory_transaction.access_class ==
+             QEMU_CRUCIBLE_MEMORY_DMA_WRITE);
+}
+
+static CrucibleMemoryMutationFragment *
+node_memory_mutation_fragment(QemuCrucibleFaultRule *rule,
+                              uint64_t rule_offset)
+{
+    GArray *fragments =
+        crucible_memory_transaction.dma_mutation_fragments;
+
+    if (!fragments) {
+        return NULL;
+    }
+    for (guint i = 0; i < fragments->len; i++) {
+        CrucibleMemoryMutationFragment *fragment = &g_array_index(
+            fragments, CrucibleMemoryMutationFragment, i);
+
+        if (fragment->rule == rule &&
+            rule_offset >= fragment->rule_offset &&
+            rule_offset - fragment->rule_offset < fragment->length) {
+            return fragment;
+        }
+    }
+    return NULL;
+}
+
+static void node_memory_shadow_read(uint64_t gpa, uint8_t *value,
+                                    size_t length)
+{
+    GArray *writes = crucible_memory_transaction.shadow_writes;
+
+    for (guint i = 0; writes && i < writes->len; i++) {
+        CrucibleMemoryShadowWrite *write = &g_array_index(
+            writes, CrucibleMemoryShadowWrite, i);
+        uint64_t start = MAX(gpa, write->gpa);
+        uint64_t end = MIN(gpa + length,
+                           write->gpa + write->value->len);
+
+        if (start < end) {
+            memcpy(value + (start - gpa),
+                   write->value->data + (start - write->gpa),
+                   end - start);
+        }
+    }
+}
+
+static void node_memory_shadow_write(MemoryRegion *mr, uint64_t mr_addr,
+                                     uint64_t gpa, const uint8_t *value,
+                                     size_t length)
+{
+    CrucibleMemoryTransaction *transaction = &crucible_memory_transaction;
+    CrucibleMemoryShadowWrite write = {
+        .gpa = gpa,
+        .mr_addr = mr_addr,
+        .mr = mr,
+        .value = g_byte_array_sized_new(length),
+    };
+
+    if (!transaction->shadow_writes) {
+        transaction->shadow_writes = g_array_new(
+            false, false, sizeof(CrucibleMemoryShadowWrite));
+        g_array_set_clear_func(transaction->shadow_writes,
+                               node_memory_shadow_write_clear);
+    }
+    memory_region_ref(mr);
+    g_byte_array_append(write.value, value, length);
+    g_array_append_val(transaction->shadow_writes, write);
+}
+
+static void node_memory_mutate_range(QemuCrucibleFaultRule *rule,
+                                     uint64_t rule_offset, uint64_t length,
+                                     const char *mask, bool clear)
+{
+    size_t mask_length = strlen(mask) / 2;
+    uint8_t buffer[4096];
+
+    while (length != 0) {
+        hwaddr mr_offset;
+        hwaddr region_available;
+        uint64_t physical, translation_available;
+        uint64_t part;
+        MemoryRegion *region;
+
+        if (node_memory_dma_transaction_active()) {
+            CrucibleMemoryMutationFragment *fragment =
+                node_memory_mutation_fragment(rule, rule_offset);
+            uint64_t within;
+
+            if (!fragment) {
+                error_report("Crucible frozen mutation plan is incomplete");
+                abort();
+            }
+            within = rule_offset - fragment->rule_offset;
+            region = fragment->mr;
+            mr_offset = fragment->mr_addr + within;
+            physical = fragment->gpa + within;
+            region_available = MIN(length, fragment->length - within);
+        } else {
+            if (!node_rule_physical_span(rule, rule_offset, &physical,
+                                         &translation_available)) {
+                error_report("Crucible memory translation became incomplete");
+                abort();
+            }
+            region_available = MIN(length, translation_available);
+            region = address_space_translate(
+                &address_space_memory, physical, &mr_offset,
+                &region_available, true, MEMTXATTRS_UNSPECIFIED);
+        }
+        if (!region || region_available == 0 ||
+            !memory_region_is_ram(region) || memory_region_is_rom(region) ||
+            memory_region_is_ram_device(region)) {
+            error_report("Crucible persistent memory target is no longer RAM");
+            abort();
+        }
+        part = MIN((uint64_t)sizeof(buffer), (uint64_t)region_available);
+        memcpy(buffer, memory_region_get_ram_ptr(region) + mr_offset, part);
+        if (crucible_memory_transaction.active &&
+            crucible_memory_transaction.streaming) {
+            node_memory_shadow_read(physical, buffer, part);
+        }
+        uint8_t before[sizeof(buffer)];
+
+        memcpy(before, buffer, part);
+        for (size_t byte = 0; byte < part; byte++) {
+            unsigned parsed;
+            size_t index = (rule_offset + byte) % mask_length;
+
+            g_assert(sscanf(mask + index * 2, "%2x", &parsed) == 1);
+            if (clear) {
+                buffer[byte] &= ~parsed;
+            } else {
+                buffer[byte] ^= parsed;
+            }
+        }
+        node_memory_mutation_evidence_add(
+            rule, physical, rule_offset, before, buffer, part, clear);
+        if (crucible_memory_transaction.active &&
+            crucible_memory_transaction.streaming) {
+            node_memory_shadow_write(region, mr_offset, physical,
+                                     buffer, part);
+        } else {
+            memory_region_fault_commit_ram(region, mr_offset, buffer, part);
+        }
+        rule_offset += part;
+        length -= part;
+    }
+}
+
+static CrucibleRetentionCell *
+node_memory_retention_cell(QemuCrucibleFaultRule *rule, uint64_t offset,
+                           bool create)
+{
+    CrucibleRetentionCell *cell;
+
+    if (!rule->retention_cells) {
+        if (!create) {
+            return NULL;
+        }
+        rule->retention_cells = g_hash_table_new_full(
+            g_int64_hash, g_int64_equal, g_free, g_free);
+    }
+    cell = g_hash_table_lookup(rule->retention_cells, &offset);
+    if (!cell && create) {
+        uint64_t *key;
+
+        g_assert(g_hash_table_size(rule->retention_cells) <
+                 CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT);
+        key = g_new(uint64_t, 1);
+        *key = offset;
+        cell = g_new0(CrucibleRetentionCell, 1);
+        for (size_t bit = 0; bit < 8; bit++) {
+            cell->refresh_tick[bit] = rule->last_exposure_tick;
+        }
+        g_hash_table_insert(rule->retention_cells, key, cell);
+    }
+    return cell;
+}
+
+static bool node_memory_apply_retention(QemuCrucibleFaultRule *rule,
+                                        QDict *parameters,
+                                        uint64_t rule_offset,
+                                        uint8_t *value, size_t length,
+                                        uint64_t now)
+{
+    uint64_t interval;
+    const char *mask;
+    size_t mask_length;
+    bool changed = false;
+
+    interval = node_retention_interval_ticks(parameters);
+    if (!rule->exposure_initialized) {
+        rule->last_exposure_tick = now;
+        rule->exposure_initialized = true;
+        return false;
+    }
+    mask = qdict_get_str(parameters, "decay_mask");
+    mask_length = strlen(mask) / 2;
+    for (size_t byte = 0; byte < length; byte++) {
+        uint64_t offset = rule_offset + byte;
+        CrucibleRetentionCell *cell = node_memory_retention_cell(
+            rule, offset, false);
+        unsigned parsed;
+        uint8_t due = 0;
+        size_t index = offset % mask_length;
+
+        g_assert(sscanf(mask + index * 2, "%2x", &parsed) == 1);
+        for (size_t bit = 0; bit < 8; bit++) {
+            uint8_t selected = 1U << bit;
+            uint64_t refreshed = cell ? cell->refresh_tick[bit] :
+                                        rule->last_exposure_tick;
+
+            if ((parsed & selected) != 0 &&
+                (cell == NULL || (cell->decayed_mask & selected) == 0) &&
+                now >= refreshed && now - refreshed >= interval) {
+                due |= selected;
+            }
+        }
+        if (due != 0) {
+            char due_mask[3];
+
+            if (!cell) {
+                cell = node_memory_retention_cell(rule, offset, true);
+            }
+            snprintf(due_mask, sizeof(due_mask), "%02x", due);
+            node_memory_mutate_range(rule, offset, 1, due_mask, true);
+            cell->decayed_mask |= due;
+            if (value) {
+                value[byte] &= ~due;
+            }
+            changed = true;
+        }
+    }
+    return changed;
+}
+
+static bool node_memory_retention_chunk_due(
+    QemuCrucibleFaultRule *rule, QDict *parameters,
+    uint64_t rule_offset, size_t length, uint64_t now)
+{
+    uint64_t interval;
+    const char *mask;
+    size_t mask_length;
+
+    if (!rule->retention_scheduled || now < rule->retention_next_tick) {
+        return false;
+    }
+    interval = node_retention_interval_ticks(parameters);
+    mask = qdict_get_str(parameters, "decay_mask");
+    mask_length = strlen(mask) / 2;
+    for (size_t byte = 0; byte < length; byte++) {
+        uint64_t offset = rule_offset + byte;
+        CrucibleRetentionCell *cell = node_memory_retention_cell(
+            rule, offset, false);
+        unsigned parsed;
+
+        g_assert(sscanf(mask + (offset % mask_length) * 2,
+                        "%2x", &parsed) == 1);
+        for (size_t bit = 0; bit < 8; bit++) {
+            uint8_t selected = 1U << bit;
+            uint64_t refreshed = cell ? cell->refresh_tick[bit] :
+                                        rule->last_exposure_tick;
+
+            if ((parsed & selected) != 0 &&
+                (!cell || (cell->decayed_mask & selected) == 0) &&
+                now >= refreshed && now - refreshed >= interval) {
+                return true;
+            }
+        }
+    }
+    return false;
+}
+
+static void node_memory_retention_recompute(
+    QemuCrucibleFaultRule *rule, QDict *parameters)
+{
+    GHashTableIter iter;
+    gpointer key, value;
+    uint64_t interval;
+    uint64_t next = UINT64_MAX;
+    const char *mask;
+    size_t mask_length;
+
+    interval = node_retention_interval_ticks(parameters);
+    mask = qdict_get_str(parameters, "decay_mask");
+    mask_length = strlen(mask) / 2;
+    if (rule->retention_cells) {
+        g_hash_table_iter_init(&iter, rule->retention_cells);
+        while (g_hash_table_iter_next(&iter, &key, &value)) {
+            uint64_t offset = *(uint64_t *)key;
+            CrucibleRetentionCell *cell = value;
+            unsigned parsed;
+
+            g_assert(sscanf(mask + (offset % mask_length) * 2,
+                            "%2x", &parsed) == 1);
+            for (size_t bit = 0; bit < 8; bit++) {
+                uint8_t selected = 1U << bit;
+                uint64_t due;
+
+                if ((parsed & selected) == 0 ||
+                    (cell->decayed_mask & selected) != 0) {
+                    continue;
+                }
+                due = cell->refresh_tick[bit] > UINT64_MAX - interval ?
+                    UINT64_MAX : cell->refresh_tick[bit] + interval;
+                next = MIN(next, due);
+            }
+        }
+    }
+    rule->retention_next_tick = next;
+    rule->retention_scheduled = next != UINT64_MAX;
+}
+
+typedef struct CrucibleRetentionBoundaryCount {
+    QemuCrucibleFaultRule *first;
+    QemuCrucibleFaultRule *counter_exhausted;
+    QemuCrucibleFaultRule *cells_exhausted;
+    uint64_t cells_current;
+    uint64_t cells_requested;
+    size_t events;
+    uint64_t now;
+} CrucibleRetentionBoundaryCount;
+
+static bool node_memory_retention_rule(QemuCrucibleFaultRule *rule,
+                                       uint64_t *start, uint64_t *length,
+                                       QDict **parameters)
+{
+    uint32_t kind;
+    QDict *process;
+
+    if (!node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_P3, &kind) ||
+        kind != 2 || !node_rule_memory_range(rule, start, length)) {
+        return false;
+    }
+    process = qobject_to(
+        QDict, node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P4)->json);
+    *parameters = qdict_get_qdict(process, "parameters");
+    return true;
+}
+
+static void node_memory_retention_boundary_count(
+    const QemuCrucibleFaultRule *const_rule, void *opaque)
+{
+    CrucibleRetentionBoundaryCount *count = opaque;
+    QemuCrucibleFaultRule *rule = (QemuCrucibleFaultRule *)const_rule;
+    QDict *parameters;
+    uint64_t start, length, offset = 0, chunks = 0;
+    uint64_t existing;
+    uint64_t reserved_new = 0;
+    uint64_t new_cells = 0;
+
+    if (!node_memory_retention_rule(rule, &start, &length, &parameters)) {
+        return;
+    }
+    existing = rule->retention_cells ?
+        g_hash_table_size(rule->retention_cells) : 0;
+    CrucibleMemoryReservedRetention *reserved_retention =
+        node_memory_reserved_retention_set(rule, false);
+
+    if (reserved_retention) {
+        GHashTableIter iter;
+        gpointer offset_key;
+
+        g_hash_table_iter_init(&iter, reserved_retention->offsets);
+        while (g_hash_table_iter_next(&iter, &offset_key, NULL)) {
+            if (!rule->retention_cells ||
+                !g_hash_table_contains(rule->retention_cells, offset_key)) {
+                reserved_new++;
+            }
+        }
+    }
+    while (offset != length) {
+        uint64_t physical, available;
+        uint64_t part;
+
+        if (!node_rule_physical_span(rule, offset, &physical, &available) ||
+            available == 0) {
+            chunks = CRUCIBLE_NODE_EVENT_CAPACITY;
+            break;
+        }
+        part = MIN((uint64_t)4096, MIN(available, length - offset));
+        if (node_memory_retention_chunk_due(
+                rule, parameters, offset, part, count->now)) {
+            chunks++;
+            for (uint64_t byte = 0; byte < part; byte++) {
+                uint64_t cell_offset = offset + byte;
+
+                if ((!rule->retention_cells ||
+                     !g_hash_table_contains(rule->retention_cells,
+                                            &cell_offset)) &&
+                    node_memory_reserved_retention_count(
+                        rule, cell_offset) == 0 &&
+                    node_memory_retention_chunk_due(
+                        rule, parameters, cell_offset, 1, count->now)) {
+                    new_cells++;
+                }
+            }
+        }
+        offset += part;
+    }
+    if (chunks == 0 && rule->retention_scheduled &&
+        count->now >= rule->retention_next_tick) {
+        node_memory_retention_recompute(rule, parameters);
+    }
+    if (chunks == 0) {
+        return;
+    }
+    if (!count->counter_exhausted &&
+        !node_memory_rule_resources_ready(rule)) {
+        count->counter_exhausted = rule;
+    }
+    if (!count->cells_exhausted &&
+        (reserved_new > CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT - existing ||
+         new_cells > CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT - existing -
+             MIN(reserved_new,
+                 CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT - existing))) {
+        count->cells_exhausted = rule;
+        count->cells_current = existing + MIN(
+            reserved_new, CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT - existing);
+        count->cells_requested = new_cells;
+    }
+    if (!count->first) {
+        count->first = rule;
+    }
+    if (chunks > CRUCIBLE_NODE_EVENT_CAPACITY ||
+        count->events > CRUCIBLE_NODE_EVENT_CAPACITY - chunks) {
+        count->events = CRUCIBLE_NODE_EVENT_CAPACITY;
+    } else {
+        count->events += chunks;
+    }
+}
+
+static void node_memory_boundary_match(QemuCrucibleFaultRule *rule,
+                                       uint64_t access_sequence)
+{
+    uint8_t material[40];
+
+    crucible_memory_current_access = access_sequence;
+    crucible_memory_current_match_count = 1;
+    memcpy(material, rule->binding_hash, sizeof(rule->binding_hash));
+    stq_le_p(material + 32, rule->generation);
+    node_memory_sha256(material, sizeof(material),
+                       crucible_memory_current_match_hash);
+}
+
+static void node_memory_boundary_match_done(void)
+{
+    crucible_memory_current_access = 0;
+    crucible_memory_current_match_count = 0;
+    memset(crucible_memory_current_match_hash, 0,
+           sizeof(crucible_memory_current_match_hash));
+    node_memory_event_span(0, 0);
+}
+
+typedef struct CrucibleRetentionBoundaryApply {
+    uint64_t observed_icount;
+} CrucibleRetentionBoundaryApply;
+
+static void node_memory_retention_boundary_apply(
+    const QemuCrucibleFaultRule *const_rule, void *opaque)
+{
+    CrucibleRetentionBoundaryApply *apply = opaque;
+    QemuCrucibleFaultRule *rule = (QemuCrucibleFaultRule *)const_rule;
+    QDict *parameters;
+    uint64_t start, length, offset = 0;
+    uint64_t now = node_virtual_now_tick();
+    uint32_t vcpu;
+    bool has_vcpu;
+    bool applied_counted = false;
+    bool opportunity_counted = false;
+
+    if (!node_memory_retention_rule(rule, &start, &length, &parameters)) {
+        return;
+    }
+    g_assert(node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_T3, &has_vcpu));
+    g_assert(node_field_u32(rule, CRUCIBLE_NODE_FAULT_FIELD_T4, &vcpu));
+    while (offset != length) {
+        uint64_t physical, available;
+        size_t part = MIN((uint64_t)4096, length - offset);
+        bool changed;
+
+        g_assert(node_rule_physical_span(rule, offset, &physical,
+                                         &available));
+        part = MIN((uint64_t)part, available);
+        if (!node_memory_retention_chunk_due(
+                rule, parameters, offset, part, now)) {
+            offset += part;
+            continue;
+        }
+        if (!opportunity_counted) {
+            node_memory_state_opportunity(rule);
+            opportunity_counted = true;
+        }
+        g_assert(crucible_memory_access_sequence != UINT64_MAX);
+        node_memory_boundary_match(rule, ++crucible_memory_access_sequence);
+        node_memory_event_span(0, part);
+        node_memory_mutation_evidence_reset(rule);
+        changed = node_memory_apply_retention(
+            rule, parameters, offset, NULL, part, now);
+        if (changed && !applied_counted) {
+            node_memory_state_applied(rule);
+            applied_counted = true;
+        }
+        g_assert(changed);
+        node_memory_event(
+            rule, CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED,
+            QEMU_CRUCIBLE_MEMORY_BOUNDARY,
+            has_vcpu ? vcpu : UINT32_MAX,
+            has_vcpu ? start + offset : physical, physical,
+            NULL, NULL, part, apply->observed_icount);
+        node_memory_boundary_match_done();
+        offset += part;
+    }
+    node_memory_retention_recompute(rule, parameters);
+}
+
+static void node_memory_retention_boundary(uint16_t phase,
+                                           uint64_t observed_icount)
+{
+    CrucibleRetentionBoundaryCount count = { 0 };
+    CrucibleRetentionBoundaryApply apply = { observed_icount };
+    uint64_t start, length;
+    QDict *parameters;
+
+    if (phase != CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY ||
+        crucible_memory_matches_in_use ||
+        !qemu_crucible_fault_memory_rules_active()) {
+        return;
+    }
+    count.now = node_virtual_now_tick();
+    qemu_crucible_fault_rule_foreach(
+        CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE,
+        node_memory_retention_boundary_count, &count);
+    if (!count.first || count.events == 0) {
+        node_memory_retention_deadline_recompute();
+        return;
+    }
+    if (count.counter_exhausted) {
+        node_memory_counter_terminal_metadata(UINT64_MAX);
+        g_assert(node_memory_retention_rule(
+            count.counter_exhausted, &start, &length, &parameters));
+        node_memory_boundary_match(count.counter_exhausted,
+                                   crucible_memory_access_sequence);
+        node_memory_resource_terminal(
+            count.counter_exhausted, QEMU_CRUCIBLE_MEMORY_BOUNDARY,
+            UINT32_MAX, start, start, length, observed_icount);
+        node_memory_boundary_match_done();
+        return;
+    }
+    if (count.cells_exhausted) {
+        node_memory_resource_terminal_metadata(
+            CRUCIBLE_NODE_RESOURCE_PERSISTENT_CELLS,
+            count.cells_current, count.cells_requested,
+            CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT,
+            CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT);
+        g_assert(node_memory_retention_rule(
+            count.cells_exhausted, &start, &length, &parameters));
+        node_memory_boundary_match(count.cells_exhausted,
+                                   crucible_memory_access_sequence);
+        node_memory_resource_terminal(
+            count.cells_exhausted, QEMU_CRUCIBLE_MEMORY_BOUNDARY,
+            UINT32_MAX, start, start, length, observed_icount);
+        node_memory_boundary_match_done();
+        return;
+    }
+    g_assert(node_memory_retention_rule(
+        count.first, &start, &length, &parameters));
+    node_memory_boundary_match(count.first, crucible_memory_access_sequence);
+    if (count.events > UINT64_MAX - crucible_memory_access_sequence) {
+        node_memory_resource_terminal_metadata(
+            CRUCIBLE_NODE_RESOURCE_COUNTER,
+            crucible_memory_access_sequence, count.events,
+            UINT64_MAX, UINT64_MAX);
+        node_memory_resource_terminal(
+            count.first, QEMU_CRUCIBLE_MEMORY_BOUNDARY, UINT32_MAX,
+            start, start, length, observed_icount);
+        node_memory_boundary_match_done();
+        return;
+    }
+    if (!node_memory_event_capacity(
+            count.first, count.events, QEMU_CRUCIBLE_MEMORY_BOUNDARY,
+            UINT32_MAX, start, start, length, observed_icount)) {
+        node_memory_boundary_match_done();
+        return;
+    }
+    node_memory_boundary_match_done();
+    qemu_crucible_fault_rule_foreach(
+        CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE,
+        node_memory_retention_boundary_apply, &apply);
+    node_memory_retention_deadline_recompute();
+}
+
+static void node_memory_retention_deadline_visit(
+    const QemuCrucibleFaultRule *const_rule, void *opaque)
+{
+    QemuCrucibleFaultRule *rule = (QemuCrucibleFaultRule *)const_rule;
+    uint64_t *next = opaque;
+    uint64_t start, length;
+    QDict *parameters;
+
+    if (node_memory_retention_rule(rule, &start, &length, &parameters) &&
+        rule->retention_scheduled) {
+        *next = MIN(*next, rule->retention_next_tick);
+    }
+}
+
+static void node_memory_retention_deadline_recompute(void)
+{
+    uint64_t next = UINT64_MAX;
+
+    qemu_crucible_fault_rule_foreach(
+        CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE,
+        node_memory_retention_deadline_visit, &next);
+    crucible_memory_retention_next_tick = next;
+}
+
+static uint64_t node_memory_retention_deadline(uint16_t phase)
+{
+    if (phase != CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY ||
+        crucible_memory_matches_in_use ||
+        !qemu_crucible_fault_memory_rules_active()) {
+        return UINT64_MAX;
+    }
+    return crucible_memory_retention_next_tick;
+}
+
+static bool node_memory_refresh_retention(QemuCrucibleFaultRule *rule,
+                                          uint64_t rule_offset,
+                                          const uint8_t *commit_mask,
+                                          size_t length, uint64_t now)
+{
+    bool refreshed_any = false;
+    QDict *process = qobject_to(
+        QDict, node_field(rule,
+            CRUCIBLE_NODE_FAULT_FIELD_P4)->json);
+    QDict *parameters = qdict_get_qdict(process, "parameters");
+    uint64_t interval;
+
+    interval = node_retention_interval_ticks(parameters);
+
+    if (!rule->exposure_initialized) {
+        rule->last_exposure_tick = now;
+        rule->exposure_initialized = true;
+    }
+    for (size_t byte = 0; byte < length; byte++) {
+        uint8_t refreshed = commit_mask ? commit_mask[byte] : UINT8_MAX;
+        CrucibleRetentionCell *cell;
+
+        if (refreshed == 0) {
+            continue;
+        }
+        cell = node_memory_retention_cell(rule, rule_offset + byte, true);
+        refreshed_any = true;
+
+        for (size_t bit = 0; bit < 8; bit++) {
+            uint8_t selected = 1U << bit;
+
+            if (refreshed & selected) {
+                cell->refresh_tick[bit] = now;
+                cell->decayed_mask &= ~selected;
+            }
+        }
+    }
+    if (refreshed_any && now <= UINT64_MAX - interval) {
+        uint64_t due = now + interval;
+
+        if (!rule->retention_scheduled || due < rule->retention_next_tick) {
+            rule->retention_next_tick = due;
+            rule->retention_scheduled = true;
+        }
+        crucible_memory_retention_next_tick = MIN(
+            crucible_memory_retention_next_tick, due);
+    }
+    return refreshed_any;
+}
+
+static guint node_dram_coordinate_hash(gconstpointer opaque)
+{
+    const CrucibleDramCoordinate *coordinate = opaque;
+    uint64_t mixed = coordinate->row ^
+        ((uint64_t)coordinate->channel << 48) ^
+        ((uint64_t)coordinate->rank << 32) ^
+        ((uint64_t)coordinate->bank << 16);
+
+    return mixed ^ (mixed >> 32);
+}
+
+static gboolean node_dram_coordinate_equal(gconstpointer left,
+                                           gconstpointer right)
+{
+    return memcmp(left, right, sizeof(CrucibleDramCoordinate)) == 0;
+}
+
+static CrucibleDramCoordinate node_dram_coordinate(uint64_t gpa,
+                                                    uint64_t row_bytes)
+{
+    uint64_t line = gpa / CRUCIBLE_DRAM_INTERLEAVE_BYTES;
+    uint64_t byte = gpa % CRUCIBLE_DRAM_INTERLEAVE_BYTES;
+    CrucibleDramCoordinate coordinate = { 0 };
+
+    coordinate.channel = line % CRUCIBLE_DRAM_CHANNELS;
+    line /= CRUCIBLE_DRAM_CHANNELS;
+    coordinate.bank = line % CRUCIBLE_DRAM_BANKS;
+    line /= CRUCIBLE_DRAM_BANKS;
+    coordinate.rank = line % CRUCIBLE_DRAM_RANKS;
+    line /= CRUCIBLE_DRAM_RANKS;
+    coordinate.row = (line * CRUCIBLE_DRAM_INTERLEAVE_BYTES + byte) /
+                     row_bytes;
+    return coordinate;
+}
+
+static bool node_dram_physical(const CrucibleDramCoordinate *coordinate,
+                               uint64_t row_bytes, uint64_t column,
+                               uint64_t *physical)
+{
+    uint64_t bank_byte;
+    uint64_t line;
+    uint64_t byte;
+
+    if (coordinate->row > UINT64_MAX / row_bytes) {
+        return false;
+    }
+    bank_byte = coordinate->row * row_bytes;
+    if (column > UINT64_MAX - bank_byte) {
+        return false;
+    }
+    bank_byte += column;
+    line = bank_byte / CRUCIBLE_DRAM_INTERLEAVE_BYTES;
+    byte = bank_byte % CRUCIBLE_DRAM_INTERLEAVE_BYTES;
+
+    if (line > (UINT64_MAX - coordinate->rank) /
+               CRUCIBLE_DRAM_RANKS) {
+        return false;
+    }
+    line = line * CRUCIBLE_DRAM_RANKS + coordinate->rank;
+    if (line > (UINT64_MAX - coordinate->bank) /
+               CRUCIBLE_DRAM_BANKS) {
+        return false;
+    }
+    line = line * CRUCIBLE_DRAM_BANKS + coordinate->bank;
+    if (line > (UINT64_MAX - coordinate->channel) /
+               CRUCIBLE_DRAM_CHANNELS) {
+        return false;
+    }
+    line = line * CRUCIBLE_DRAM_CHANNELS + coordinate->channel;
+    if (line > (UINT64_MAX - byte) /
+               CRUCIBLE_DRAM_INTERLEAVE_BYTES) {
+        return false;
+    }
+    *physical = line * CRUCIBLE_DRAM_INTERLEAVE_BYTES + byte;
+    return true;
+}
+
+static bool node_rule_offset_for_gpa(QemuCrucibleFaultRule *rule,
+                                     uint64_t gpa, uint64_t *rule_offset)
+{
+    uint64_t start, length;
+    bool has_vcpu;
+
+    if (!node_rule_memory_range(rule, &start, &length) ||
+        !node_field_bool(rule, CRUCIBLE_NODE_FAULT_FIELD_T3, &has_vcpu)) {
+        return false;
+    }
+    if (!has_vcpu) {
+        if (gpa < start || gpa - start >= length) {
+            return false;
+        }
+        *rule_offset = gpa - start;
+        return true;
+    }
+    for (guint i = 0; i < rule->translations->len; i++) {
+        CrucibleNodeTranslation *translation = &g_array_index(
+            rule->translations, CrucibleNodeTranslation, i);
+        uint64_t covered_start = MAX(start, translation->virtual_page);
+        uint64_t physical_start = translation->physical_page +
+                                  (covered_start - translation->virtual_page);
+
+        if (gpa >= physical_start &&
+            gpa - physical_start < translation->covered_bytes) {
+            uint64_t logical = covered_start +
+                               (gpa - physical_start);
+
+            if (logical >= start && logical - start < length) {
+                *rule_offset = logical - start;
+                return true;
+            }
+        }
+    }
+    return false;
+}
+
+static bool node_memory_disturb_dram_row(
+    QemuCrucibleFaultRule *rule, const CrucibleDramCoordinate *victim,
+    uint64_t row_bytes, const char *mask)
+{
+    bool changed = false;
+
+    for (uint64_t column = 0; column < row_bytes;) {
+        uint64_t bank_byte_mod =
+            ((victim->row % CRUCIBLE_DRAM_INTERLEAVE_BYTES) *
+             (row_bytes % CRUCIBLE_DRAM_INTERLEAVE_BYTES) +
+             column % CRUCIBLE_DRAM_INTERLEAVE_BYTES) %
+            CRUCIBLE_DRAM_INTERLEAVE_BYTES;
+        uint64_t physical;
+        uint64_t rule_offset;
+        uint64_t line_available = CRUCIBLE_DRAM_INTERLEAVE_BYTES -
+            bank_byte_mod;
+        uint64_t length = MIN(line_available, row_bytes - column);
+
+        if (!node_dram_physical(victim, row_bytes, column, &physical)) {
+            return changed;
+        }
+        if (node_rule_offset_for_gpa(rule, physical, &rule_offset)) {
+            uint64_t mapped_physical, available;
+
+            g_assert(node_rule_physical_span(
+                rule, rule_offset, &mapped_physical, &available));
+            if (mapped_physical != physical) {
+                column += length;
+                continue;
+            }
+            length = MIN(length, available);
+            node_memory_mutate_range(rule, rule_offset, length, mask, false);
+            changed = true;
+        }
+        column += length;
+    }
+    return changed;
+}
+
+static void node_memory_apply_rowhammer_row(
+    QemuCrucibleFaultRule *rule, QDict *parameters,
+    const CrucibleDramCoordinate *aggressor, uint64_t row_bytes,
+    uint64_t threshold, uint64_t victim_distance)
+{
+    uint64_t *count;
+
+    if (!rule->row_counters) {
+        rule->row_counters = g_hash_table_new_full(
+            node_dram_coordinate_hash, node_dram_coordinate_equal,
+            g_free, g_free);
+    }
+    count = g_hash_table_lookup(rule->row_counters, aggressor);
+    if (!count) {
+        CrucibleDramCoordinate *key;
+
+        g_assert(g_hash_table_size(rule->row_counters) <
+                 CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT);
+        key = g_memdup2(aggressor, sizeof(*aggressor));
+        count = g_new0(uint64_t, 1);
+        g_hash_table_insert(rule->row_counters, key, count);
+    }
+    g_assert(*count != UINT64_MAX);
+    rule->evidence_aggressor = *aggressor;
+    rule->evidence_counter_before = *count;
+    (*count)++;
+    rule->evidence_counter_after = *count;
+    node_memory_counter_evidence_add(
+        rule, aggressor, rule->evidence_counter_before,
+        rule->evidence_counter_after);
+    if (*count % threshold != 0) {
+        return;
+    }
+    for (unsigned direction = 0; direction < 2; direction++) {
+        CrucibleDramCoordinate victim = *aggressor;
+
+        if (direction == 0) {
+            if (victim.row < victim_distance) {
+                continue;
+            }
+            victim.row -= victim_distance;
+        } else {
+            if (victim.row > UINT64_MAX - victim_distance) {
+                continue;
+            }
+            victim.row += victim_distance;
+        }
+        if (node_memory_disturb_dram_row(
+                rule, &victim, row_bytes,
+                qdict_get_str(parameters, "flip_mask"))) {
+            rule->evidence_victim_rows++;
+        }
+    }
+}
+
+static bool node_memory_apply_rowhammer(QemuCrucibleFaultRule *rule,
+                                        QDict *parameters,
+                                        uint64_t rule_offset,
+                                        size_t selected)
+{
+    g_autoptr(GHashTable) local_seen = NULL;
+    GHashTable *seen;
+    uint64_t row_bytes, threshold, victim_distance;
+    uint64_t current = rule_offset;
+    uint64_t remaining = selected;
+
+    g_assert(selected != 0 && rule_offset <= UINT64_MAX - selected);
+    g_assert(node_json_u64(qdict_get(parameters, "row_bytes"), &row_bytes));
+    g_assert(node_json_u64(qdict_get(parameters, "threshold"), &threshold));
+    g_assert(node_json_u64(qdict_get(parameters, "victim_distance"),
+                           &victim_distance));
+    if (crucible_memory_transaction.active) {
+        if (!crucible_memory_transaction_rows) {
+            crucible_memory_transaction_rows = g_hash_table_new_full(
+                g_direct_hash, g_direct_equal, NULL,
+                (GDestroyNotify)g_hash_table_unref);
+        }
+        seen = g_hash_table_lookup(crucible_memory_transaction_rows, rule);
+        if (!seen) {
+            seen = g_hash_table_new_full(
+                node_dram_coordinate_hash, node_dram_coordinate_equal,
+                g_free, NULL);
+            g_hash_table_insert(crucible_memory_transaction_rows, rule,
+                                seen);
+        }
+    } else {
+        local_seen = g_hash_table_new_full(
+            node_dram_coordinate_hash, node_dram_coordinate_equal,
+            g_free, NULL);
+        seen = local_seen;
+    }
+    rule->evidence_victim_rows = 0;
+    while (remaining != 0) {
+        uint64_t physical, available;
+        uint64_t part;
+
+        g_assert(node_rule_physical_span(rule, current, &physical,
+                                         &available));
+        part = MIN(remaining, available);
+        for (uint64_t byte = 0; byte < part; byte++) {
+            CrucibleDramCoordinate coordinate = node_dram_coordinate(
+                physical + byte, row_bytes);
+
+            if (!g_hash_table_contains(seen, &coordinate)) {
+                CrucibleDramCoordinate *key = g_memdup2(
+                    &coordinate, sizeof(coordinate));
+
+                g_hash_table_add(seen, key);
+                node_memory_apply_rowhammer_row(
+                    rule, parameters, &coordinate, row_bytes, threshold,
+                    victim_distance);
+            }
+        }
+        current += part;
+        remaining -= part;
+    }
+    return rule->evidence_mutation_count != 0;
+}
+
+static bool node_memory_rowhammer_resources_ready(
+    QemuCrucibleFaultRule *rule, QDict *parameters,
+    uint64_t rule_offset, size_t selected)
+{
+    g_autoptr(GHashTable) local_seen = g_hash_table_new_full(
+        node_dram_coordinate_hash, node_dram_coordinate_equal,
+        g_free, NULL);
+    GHashTable *transaction_seen = NULL;
+    uint64_t row_bytes;
+    uint64_t current = rule_offset;
+    uint64_t remaining = selected;
+    uint64_t new_counters = 0;
+    uint64_t existing = rule->row_counters ?
+        g_hash_table_size(rule->row_counters) : 0;
+    CrucibleMemoryReservedRows *reserved_rows =
+        node_memory_reserved_row_set(rule, false);
+    uint64_t reserved_new = 0;
+
+    g_assert(existing <= CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT);
+    if (reserved_rows) {
+        GHashTableIter reserved_iter;
+        gpointer reserved_key;
+
+        g_hash_table_iter_init(&reserved_iter, reserved_rows->coordinates);
+        while (g_hash_table_iter_next(&reserved_iter, &reserved_key, NULL)) {
+            if (!rule->row_counters ||
+                !g_hash_table_contains(rule->row_counters, reserved_key)) {
+                reserved_new++;
+            }
+        }
+    }
+    g_assert(node_json_u64(qdict_get(parameters, "row_bytes"),
+                           &row_bytes));
+    if (crucible_memory_transaction.active &&
+        crucible_memory_transaction_rows) {
+        transaction_seen = g_hash_table_lookup(
+            crucible_memory_transaction_rows, rule);
+    }
+    while (remaining != 0) {
+        uint64_t physical, available;
+        uint64_t part;
+
+        g_assert(node_rule_physical_span(rule, current, &physical,
+                                         &available));
+        part = MIN(remaining, available);
+        for (uint64_t byte = 0; byte < part; byte++) {
+            CrucibleDramCoordinate coordinate = node_dram_coordinate(
+                physical + byte, row_bytes);
+            uint64_t *counter;
+
+            if (g_hash_table_contains(local_seen, &coordinate)) {
+                continue;
+            }
+            g_hash_table_add(local_seen,
+                             g_memdup2(&coordinate, sizeof(coordinate)));
+            if (transaction_seen &&
+                g_hash_table_contains(transaction_seen, &coordinate)) {
+                continue;
+            }
+            counter = rule->row_counters ?
+                g_hash_table_lookup(rule->row_counters, &coordinate) :
+                NULL;
+            uint64_t reserved = node_memory_reserved_row_count(
+                rule, &coordinate);
+            uint64_t counter_value = counter ? *counter : 0;
+
+            if (reserved == UINT64_MAX ||
+                counter_value > UINT64_MAX - reserved - 1) {
+                node_memory_counter_terminal_metadata(
+                    counter_value + reserved);
+                return false;
+            }
+            if (!counter && reserved == 0) {
+                new_counters++;
+            }
+        }
+        current += part;
+        remaining -= part;
+    }
+    if (reserved_new > CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT - existing ||
+        new_counters > CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT - existing -
+            reserved_new) {
+        node_memory_resource_terminal_metadata(
+            CRUCIBLE_NODE_RESOURCE_PERSISTENT_CELLS,
+            existing + MIN(reserved_new,
+                           CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT - existing),
+            new_counters, CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT,
+            CRUCIBLE_NODE_MEMORY_COUNTER_LIMIT);
+        return false;
+    }
+    return true;
+}
+
