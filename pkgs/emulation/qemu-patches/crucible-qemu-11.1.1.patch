+    reset_control();
+    stop_batch();
+    publish_wake();
+    QTAILQ_INIT(&cpus_queue);
+    service_events();
+    g_assert_cmpuint(control_calls, ==, 0);
+    g_assert_cmpuint(qemu_plugin_rr_control_complete_generation, ==, 0);
+    g_assert_true(qemu_plugin_crucible_control_boundary_outstanding());
+    fixture_cpu_link();
+    publish_wake();
+    service_events();
+    g_assert_cmpuint(control_calls, ==, 1);
