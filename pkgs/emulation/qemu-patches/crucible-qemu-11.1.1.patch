+/*
+ * Source-owned fingerprint worker construction and physical byte custody
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifdef CONFIG_LINUX
+
+static bool fingerprint_material_slot(QemuCrucibleFingerprintMaterial *material)
+{
+    for (size_t index = 0; index < G_N_ELEMENTS(startup_source.fingerprint_material); index++) {
+        if (material == &startup_source.fingerprint_material[index]) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static bool fingerprint_materials_held(void)
+{
+    for (size_t index = 0; index < G_N_ELEMENTS(startup_source.fingerprint_material); index++) {
+        if (startup_source.fingerprint_material[index].held) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static bool fingerprint_work_held(QemuCrucibleFingerprintWorker *worker)
+{
+    if (worker->pending || worker->active || worker->completed_count) {
+        return true;
+    }
+    for (size_t index = 0; index < G_N_ELEMENTS(worker->work); index++) {
+        if (worker->work[index].material_held || worker->work[index].bytes_held) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static QemuCrucibleFingerprintMaterial *fingerprint_material_ref(
+    const QemuCrucibleFingerprintMaterialRef *reference)
+{
+    if (!reference || !reference->serial || !fingerprint_material_slot(reference->owner)) {
+        return NULL;
+    }
+    return reference->owner->held &&
+        reference->owner->operation.serial == reference->serial ? reference->owner : NULL;
+}
+
+static QemuCrucibleFingerprintMaterial *fingerprint_current_capture(void)
+{
+    QemuCrucibleFingerprintMaterial *material =
+        fingerprint_material_ref(&startup_source.fingerprint_capture);
+
+    return material && material->capture_entered ? material : NULL;
+}
+
+static bool fingerprint_work_slot(QemuCrucibleFingerprintWorker *worker,
+    const QemuCrucibleFingerprintWork *work)
+{
+    for (size_t index = 0; index < G_N_ELEMENTS(worker->work); index++) {
+        if (work == &worker->work[index]) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static QemuCrucibleFingerprintWork *fingerprint_work_ref(
+    QemuCrucibleFingerprintWorker *worker, const QemuCrucibleFingerprintWorkRef *reference)
+{
+    if (!reference || !reference->serial) {
+        return NULL;
+    }
+    for (size_t index = 0; index < G_N_ELEMENTS(worker->work); index++) {
+        QemuCrucibleFingerprintWork *work = &worker->work[index];
+
+        if (reference->owner == work && reference->serial == work->serial &&
+            work->worker == worker && work->material_held && fingerprint_material_slot(work->material) &&
+            work->material->held && work->material->work == work &&
+            work->material->work_serial == work->serial &&
+            work->material->operation.serial == work->operation_serial) {
+            return work;
+        }
+    }
+    return NULL;
+}
+
+/* Main fixes the mapping before worker birth and cannot retire it until
+ * every worker user returns. Callers are actual Main or a retained worker;
+ * address/extent remain immutable throughout their existing custody. Guard
+ * caller spans before even reading their Ref, occupied or schema fields. */
+static bool fingerprint_output_workspace_overlap(const void *output, size_t bytes)
+{
+    QemuCrucibleDeviceWorkspaceMapping *mapping = &startup_source.workspace_mapping;
+    uintptr_t start = (uintptr_t)output;
+    uintptr_t workspace = (uintptr_t)mapping->address;
+
+    if (!output || bytes > UINTPTR_MAX - start) {
+        return true;
+    }
+    if (!mapping->mapped) {
+        return false;
+    }
+    if (mapping->request_bytes > UINTPTR_MAX - workspace) {
+        return true;
+    }
+    return start < workspace + mapping->request_bytes && workspace < start + bytes;
+}
+
+int qemu_crucible_startup_source_output_span_check(const void *out, size_t bytes)
+{
+    bool initialized;
+    bool conflicts;
+
+    if (!qemu_in_main_thread() ||
+        (qatomic_load_acquire(&startup_source.owner_initialized) && !startup_owner())) {
+        return -EPERM;
+    }
+    initialized = qatomic_load_acquire(&startup_source.commands.initialized);
+    if (initialized) {
+        qemu_mutex_lock(&startup_source.commands.mutex);
+    }
+    /* No caller storage is read here and no Source authority is issued. */
+    conflicts = callback_child_output_overlap(out, bytes, &startup_source,
+                                               sizeof(startup_source)) ||
+        fingerprint_output_workspace_overlap(out, bytes) ||
+        callback_child_output_conflicts_locked(out, bytes);
+    if (initialized) {
+        qemu_mutex_unlock(&startup_source.commands.mutex);
+    }
+    return conflicts ? -EINVAL : 0;
+}
+
+int qemu_crucible_fingerprint_capture_outputs_check_v1(
+    const void *out, size_t out_bytes, const void *material, size_t material_bytes)
+{
+    bool commands_initialized;
+    bool conflicts;
+
+    if (!qemu_in_main_thread() ||
+        (qatomic_load_acquire(&startup_source.owner_initialized) && !startup_owner())) {
+        return -EPERM;
+    }
+    commands_initialized = qatomic_load_acquire(&startup_source.commands.initialized);
+    if (commands_initialized) {
+        qemu_mutex_lock(&startup_source.commands.mutex);
+    }
+    /* Range observation only: no Original, capture, mutation or authority is
+     * issued. Both outputs must be safe before the exporter initializes one. */
+    conflicts = callback_child_output_overlap(out, out_bytes, &startup_source, sizeof(startup_source)) ||
+        callback_child_output_overlap(material, material_bytes, &startup_source, sizeof(startup_source)) ||
+        callback_child_output_overlap(out, out_bytes, material, material_bytes) ||
+        fingerprint_output_workspace_overlap(out, out_bytes) ||
+        fingerprint_output_workspace_overlap(material, material_bytes);
+    if (commands_initialized) {
+        qemu_mutex_unlock(&startup_source.commands.mutex);
+    }
+    return conflicts ? -EINVAL : 0;
+}
+
+static int fingerprint_worker_role_identity(QemuCruciblePluginWorker *native)
+{
+    QemuCrucibleFingerprintWorker *worker = &startup_source.fingerprint_worker;
+
+    return native == &worker->native && worker->workspace == &startup_source.workspace_mapping &&
+        worker->workspace->worker == worker && worker->claim == &startup_source.worker_claim &&
+        worker->claim->consumed ? 0 : -EPERM;
+}
+
+static bool fingerprint_worker_borrowers_held(QemuCruciblePluginWorker *native)
+{
+    return fingerprint_materials_held() ||
+        fingerprint_work_held(&startup_source.fingerprint_worker);
+}
+
+static int fingerprint_worker_cancel_pending(QemuCruciblePluginWorker *native)
+{
+    QemuCrucibleFingerprintWorker *worker = &startup_source.fingerprint_worker;
+    QemuCrucibleFingerprintWork *pending = worker->pending;
+
+    if (!pending) {
+        return 0;
+    }
+    if (!fingerprint_work_slot(worker, pending) || !pending->material_held ||
+        pending->bytes_held || pending->completed || pending == worker->active) {
+        return -ESTALE;
+    }
+    if (worker->completed_count >= G_N_ELEMENTS(worker->completed)) {
+        return -EOVERFLOW;
+    }
+    pending->result = -ECANCELED;
+    pending->cancelled = true;
+    pending->completed = true;
+    worker->pending = NULL;
+    worker->completed[worker->completed_count++] = pending;
+    return 0;
+}
+
+static void fingerprint_worker_release_role(QemuCruciblePluginWorker *native)
+{
+    QemuCrucibleDeviceWorkspaceMapping *workspace = startup_source.fingerprint_worker.workspace;
+
+    qemu_mutex_lock(&workspace->mutex);
+    workspace->worker = NULL;
+    qemu_mutex_unlock(&workspace->mutex);
+}
+
