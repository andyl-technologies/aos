+    g_assert_true(userdata == &actual_child);
+    borrow_acquires++;
+    g_assert_nonnull(holder);
+    g_assert_nonnull(serial);
+    g_assert_nonnull(known_absent);
+    g_assert_null(*holder);
+    g_assert_cmpuint(*serial, ==, 0);
+    if (borrow_mode == 3) {
+        return -EIO; /* Unknown: no absence or birth evidence. */
+    }
+    if (qemu_mutex_trylock(&actual_child.journal)) {
+        *known_absent = 1;
+        return -EBUSY;
+    }
+    *known_absent = 1;
+    if (!actual_child.owned || actual_child.process != getpid() ||
+        actual_child.holder != payload_holder || *payload_holder != &actual_child.pending ||
+        payload_serial != actual_child.serial || actual_child.borrow_held) {
+        qemu_mutex_unlock(&actual_child.journal);
+        return -ESTALE;
+    }
