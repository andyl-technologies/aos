+static int dirty_retirement_status(int status)
+{
+    if (status && !ram_list.dirty_retirement.callback_status) {
+        ram_list.dirty_retirement.callback_status = status;
+    }
+    qemu_crucible_ram_return_record(status);
+    return status;
