+static int source_writer_observe(JSONWriter *candidate, SourceJSONWriter **out)
+{
+    QemuCrucibleQmpAllocationOwner *owner;
+    SourceJSONWriter *writer;
+    int status;
+
+    *out = NULL;
+    status = qemu_crucible_qmp_json_writer_observe(candidate, &owner);
+    if (status) {
+        return status;
+    }
+    writer = (SourceJSONWriter *)candidate;
+    if (writer->owner != owner) {
+        return -ESTALE;
+    }
+    *out = writer;
+    return 0;
+}
+
+static int source_writer_fail(SourceJSONWriter *writer, int status)
+{
+    if (status && !writer->first_status) {
+        writer->first_status = status;
+    }
+    return status;
+}
+
+int json_writer_source_status(JSONWriter *candidate, int *first, int *post)
+{
+    SourceJSONWriter *writer;
+    int status;
+
+    if (!first || !post) {
+        return -EINVAL;
+    }
+    *first = *post = 0;
+    status = source_writer_observe(candidate, &writer);
+    if (!status) {
+        *first = writer->first_status;
+        *post = writer->post_status ? writer->post_status : writer->cleanup_status;
+    }
+    return status;
+}
+
