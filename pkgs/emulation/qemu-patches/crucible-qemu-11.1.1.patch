+static void test_registry_transaction_carries_coordinator_owned_mutex(void)
+{
+    QemuCrucibleHotForkRuntimeTransaction transaction = { 0 };
+    RegistryWorkerThread monitor_worker;
+    QemuRecMutex mutex;
+    int child_result[2];
+    pid_t child;
+
+    g_assert_cmpint(pipe2(child_result, O_CLOEXEC), ==, 0);
+    start_registry_worker_thread(&monitor_worker, "IO mon_iothread",
+                                 monitor_registry_worker);
+    qemu_rec_mutex_init(&mutex);
+    qemu_rec_mutex_lock(&mutex);
+    qemu_rec_mutex_lock(&mutex);
+    g_assert_cmpint(begin_runtime_transaction_when_quiescent(&transaction),
+                    ==, 0);
+    g_assert_true(transaction.registry.active);
+    g_assert_cmpuint(transaction.registry.carried_count, ==, 1);
+    g_assert_cmpuint(
+        transaction.registry.carried_mutexes[0].registration_id,
+        ==, mutex.m.crucible_hot_fork_registration_id);
+    g_assert_cmpuint(transaction.registry.carried_mutexes[0].slot,
+                     ==, mutex.m.crucible_hot_fork_slot);
+
+    child = fork();
+    g_assert_cmpint(child, >=, 0);
+    if (child == 0) {
+        int child_status = qemu_thread_hot_fork_reconstruct_child_registry(
+            &transaction.registry);
+
+        if (child_status == 0) {
+            /* The child coordinator still owns the mutex and can cycle it. */
+            qemu_rec_mutex_unlock(&mutex);
+            qemu_rec_mutex_unlock(&mutex);
+            qemu_rec_mutex_lock(&mutex);
+            qemu_rec_mutex_lock(&mutex);
+            qemu_rec_mutex_unlock(&mutex);
+            qemu_rec_mutex_unlock(&mutex);
+        }
+        write_child_result(child_result[1], child_status);
+        _exit(0);
