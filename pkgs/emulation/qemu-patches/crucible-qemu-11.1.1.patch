+static uint32_t node_memory_service_actor_access_classes(
+    const QemuCrucibleFaultRule *rule)
+{
+    const QObject *object = node_field(
+        (QemuCrucibleFaultRule *)rule, CRUCIBLE_NODE_FAULT_FIELD_P7)->json;
+    QDict *actor = qobject_to(QDict, object);
+    QDict *parameters;
+    const char *kind;
+    const char *access;
+
+    g_assert(actor);
+    kind = qdict_get_str(actor, "kind");
+    if (strcmp(kind, "cpu_all") == 0) {
+        return QEMU_CRUCIBLE_MEMORY_FETCH |
+               QEMU_CRUCIBLE_MEMORY_CPU_LOAD |
+               QEMU_CRUCIBLE_MEMORY_CPU_STORE |
+               QEMU_CRUCIBLE_MEMORY_PAGE_TABLE_WALK;
+    }
+    parameters = node_json_tag_dict(object, kind);
+    g_assert(parameters);
+    access = qdict_get_str(parameters,
+                           strcmp(kind, "fw_cfg_payload") == 0 ?
+                               "direction" : "access");
+    if (strcmp(kind, "cpu_single_access") == 0) {
+        return strcmp(access, "load") == 0 ?
+            QEMU_CRUCIBLE_MEMORY_CPU_LOAD :
+            QEMU_CRUCIBLE_MEMORY_CPU_STORE;
+    }
+    g_assert(strcmp(kind, "fw_cfg_payload") == 0);
+    return strcmp(access, "read") == 0 ?
+        QEMU_CRUCIBLE_MEMORY_DMA_READ :
+        QEMU_CRUCIBLE_MEMORY_DMA_WRITE;
+}
