+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Check repeated real provider loading in an isolated configured-input copy.
+
+The normal provider authenticates the actual configured build first. Controls
+copy its metadata and physical inputs into temporary storage, then change only
+that copy. No compiler output or provider argument is supplied from a cache.
+This standalone diagnostic is not part of the delivery runner's 60-second body.
+"""
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import runpy
+import shutil
+import tempfile
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--source-root", type=Path,
+                        default=Path(__file__).resolve().parents[2])
+    parser.add_argument("--output-dir", type=Path, required=True)
+    args = parser.parse_args()
+    root = args.source_root.resolve()
+    output = args.output_dir.resolve()
+    output.mkdir(parents=True, exist_ok=True)
+    helper = Path("tests/unit/crucible-net-stop-support.py")
+    original = runpy.run_path(str(root / helper))["native_link_arguments"]
+    original_arguments = original()
+    state = original.__globals__["_native_link_snapshot"]
+    records = []
+
+    with tempfile.TemporaryDirectory(prefix="provider-inputs-", dir=output) as temporary:
+        fixture = Path(temporary)
+        paths = {path for path, _ in state[2] if path.is_relative_to(root)}
+        paths.update(root / path for path in (
+            str(helper), "tests/unit/test-crucible-ram-worker-inventory.py",
+            "tests/unit/extract-crucible-startup-source-controls.py"))
+        inputs = {}
+        for path in sorted(paths):
+            destination = fixture / path.relative_to(root)
+            destination.parent.mkdir(parents=True, exist_ok=True)
+            shutil.copyfile(path, destination)
+            inputs[str(path.relative_to(root))] = hashlib.sha256(path.read_bytes()).hexdigest()
+        for name in ("compile_commands.json", "meson-info/intro-targets.json"):
+            destination = fixture / "build" / name
+            destination.parent.mkdir(parents=True, exist_ok=True)
+            destination.write_text((root / "build" / name).read_text().replace(
+                str(root), str(fixture)))
+
+        def loader():
+            return runpy.run_path(str(fixture / helper))["native_link_arguments"]
+
+        function = loader()
+        first = function()
+        second = function()
+        assert first == second
+        assert first == [item.replace(str(root), str(fixture))
+                         for item in original_arguments]
+        second.append("-DCALLER_MUTATION")
+        assert function() == first
+        records.append({"case": "unchanged-repeated-load-and-list-isolation",
+                        "arguments": len(first), "result": "equivalent"})
+
+        def refuses(case, path, change):
+            nonlocal function
+            function = loader()
+            function()
+            prior = path.read_bytes() if path.is_file() else None
+            try:
+                change(path)
+                try:
+                    function()
+                except (ValueError, FileNotFoundError) as error:
+                    records.append({"case": case, "error": type(error).__name__,
+                                    "message": str(error).replace(str(fixture), "<fixture>")})
+                else:
+                    raise AssertionError("changed input accepted: " + case)
+            finally:
+                if path.is_symlink():
+                    path.unlink()
+                if prior is not None:
+                    path.write_bytes(prior)
+
+        metadata = fixture / "build/compile_commands.json"
+        refuses("exact-metadata-bytes", metadata,
+                lambda path: path.write_bytes(path.read_bytes() + b"\n"))
+        entries = json.loads(metadata.read_bytes())
+        selected = {path.resolve() for path, _ in
+                    function.__globals__["_native_link_snapshot"][2]}
+        outside = next(fixture / "build" / entry["output"] for entry in entries
+                       if (fixture / "build" / entry["output"]).resolve() not in selected)
+        outside.parent.mkdir(parents=True, exist_ok=True)
+        refuses("non-selected-output-topology", outside,
+                lambda path: path.symlink_to(root / "COPYING"))
+        refuses("provider-source-content", fixture / "util/qemu-thread-posix.c",
+                lambda path: path.write_bytes(path.read_bytes() + b"\n"))
+        refuses("provider-module-content", fixture / "tests/unit/test-crucible-ram-worker-inventory.py",
+                lambda path: path.write_bytes(path.read_bytes() + b"\n"))
+        function = loader()
+        function()
+        support = next(path for path, _ in
+                       function.__globals__["_native_link_snapshot"][2]
+                       if path.suffix == ".o")
+        refuses("support-output-absence", support, lambda path: path.unlink())
+        function = loader()
+        function()
+        compiler = os.environ["CC"]
+        try:
+            os.environ["CC"] = compiler + " -DCHANGED_PROVIDER"
+            try:
+                function()
+            except ValueError as error:
+                records.append({"case": "compiler-identity", "error": type(error).__name__,
+                                "message": str(error)})
+            else:
+                raise AssertionError("changed compiler accepted")
+        finally:
+            os.environ["CC"] = compiler
+
+    (output / "proof.json").write_text(json.dumps(
+        {"cases": records, "authenticated_input_sha256": inputs}, indent=2) + "\n")
+    print(json.dumps(records, indent=2))
+
