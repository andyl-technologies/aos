+static void initialize_hpet(HPETState *state)
+{
+    qemu_mutex_init(&state->lock);
+    seqlock_init(&state->state_version);
+    state->num_timers = 1;
+    state->timer[0].state = state;
+    state->timer[0].qemu_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL,
+                                             hpet_timer, &state->timer[0]);
+    state->irqs[0] = qemu_allocate_irq(record_irq, NULL, 0);
+    state->timer[0].config = HPET_TN_ENABLE | HPET_TN_PERIODIC_CAP |
+                             HPET_TN_SIZE_CAP;
