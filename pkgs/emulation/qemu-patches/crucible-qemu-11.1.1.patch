+typedef struct TestCrossGrantState {
+    _Atomic uint64_t grant;
+    _Atomic uint64_t published;
+    _Atomic uint64_t target;
+    _Atomic uint32_t stage;
+} TestCrossGrantState;
+
+static TestCrossGrantState *test_cross_grant;
+
+static void test_cross_grant_publish(uint64_t icount, void *opaque)
+{
+    uint8_t control[4];
+    uint64_t target;
+    int64_t observed_tick = qemu_plugin_sim_tick_observed();
+
+    (void)icount;
+    (void)opaque;
+    atomic_store_explicit(
+        &test_cross_grant->published, qemu_plugin_sim_tick_observed(),
+        memory_order_release);
+    target = atomic_load_explicit(
+        &test_cross_grant->target, memory_order_acquire);
+    if (target == 0 || observed_tick < 0 ||
+        (uint64_t)observed_tick < target ||
+        atomic_load_explicit(
+            &test_cross_grant->stage, memory_order_acquire) != 1) {
+        return;
+    }
+    g_autoptr(GByteArray) descriptor = g_byte_array_new();
+
+    if (!qemu_plugin_crucible_read_memory_paddr(
+            test_result_address + 0x20, descriptor, sizeof(control)) ||
+        descriptor->len != sizeof(control)) {
+        test_fail("pending fw_cfg descriptor could not be inspected");
+    }
+    memcpy(control, descriptor->data, sizeof(control));
+    if (memcmp(control, (uint8_t[]) { 0x00, 0x00, 0x00, 0x0a },
+               sizeof(control)) != 0) {
+        g_printerr("cross grant tick=%" G_GINT64_FORMAT
+                   " control=%02x%02x%02x%02x\n",
+                   qemu_plugin_sim_tick_observed(), control[0], control[1],
+                   control[2], control[3]);
+        test_fail("pending fw_cfg descriptor changed at grant");
+    }
+    test_poll_events();
+    if (test_event_seen) {
+        test_fail("pending fw_cfg service published before ready");
+    }
+    atomic_store_explicit(
+        &test_cross_grant->stage, 2, memory_order_release);
+}
+
+static uint64_t test_cross_grant_raw_ceiling(void *opaque)
+{
+    uint64_t grant = atomic_load_explicit(
+        &test_cross_grant->grant, memory_order_acquire);
+    uint64_t raw = qemu_plugin_icount_raw();
+    int64_t now = qemu_plugin_sim_tick_observed();
+
+    (void)opaque;
+    if (grant == UINT64_MAX || now < 0) {
+        return UINT64_MAX;
+    }
+    if (grant <= (uint64_t)now) {
+        return raw;
+    }
+    return raw + (grant - (uint64_t)now + 49) / 50;
+}
+
+static uint64_t test_cross_grant_logical_ceiling(void *opaque)
+{
