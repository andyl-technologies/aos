+CrucibleHotForkRcuBarrierState *
+qmp_crucible_hot_fork_rcu_barrier(
+    CrucibleHotForkRcuBarrierAction action, Error **errp)
+{
+    CrucibleHotForkRcuBarrierState *report = NULL;
+    QemuRcuHotForkBarrierOperation operation;
+
+    g_autoptr(BQLLockAuto) admission_bql =
+        action != CRUCIBLE_HOT_FORK_RCU_BARRIER_ACTION_QUERY ?
+        bql_auto_lock(__FILE__, __LINE__) : NULL;
+
+    g_mutex_lock(&crucible_hot_fork_template_lock);
+    switch (action) {
+    case CRUCIBLE_HOT_FORK_RCU_BARRIER_ACTION_HOLD:
