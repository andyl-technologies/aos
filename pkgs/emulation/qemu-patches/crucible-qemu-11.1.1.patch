+
+int qemu_crucible_fault_registration_retiring_current_v1(
+    QemuCrucibleFaultRegistration *registration,
+    QemuCrucibleFaultRegistration **holder, bool removed)
+{
+    int status;
+
+    if (qatomic_load_acquire(&crucible_fault_registration_retiring.process) != getpid()) {
+        return -EPERM;
+    }
+    g_mutex_lock(&crucible_fault_registration_retiring.lock);
+    status = crucible_fault_registration_retiring.calling &&
+        crucible_fault_registration_retiring.registration == registration &&
+        crucible_fault_registration_retiring.holder == holder &&
+        crucible_fault_registration_retiring.removed == removed &&
+        qemu_thread_is_self(&crucible_fault_registration_retiring.thread) ? 0 : -EPERM;
+    if (!status && removed) {
+        for (size_t index = 0; crucible_fault_handlers &&
+             index < crucible_fault_handlers->len; index++) {
+            if (g_ptr_array_index(crucible_fault_handlers, index) ==
+                crucible_fault_registration_retiring.handler) {
+                status = -EPERM;
+                break;
+            }
+        }
+    }
+    g_mutex_unlock(&crucible_fault_registration_retiring.lock);
+    return status;
+}
