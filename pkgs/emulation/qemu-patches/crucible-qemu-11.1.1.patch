@@ -0,0 +1,392 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Compile actual getter frames with refusal-only Source boundaries.
+
+The private dispatch creates its own real stack interval. CPU/APIC objects and
+BQL status are factual component inputs, without QOM enrollment or the actual
+BQL. No selector is overridden and every Source begin refuses. Saved-return
+predicates use factual records, never admitted loans or populated Source owners.
+An installed initial callback and its physical pin returns remain unexecuted.
+"""
+
+import argparse
+import json
+import os
+from pathlib import Path
+import runpy
+import shlex
+import subprocess
+
+
+PREFIX = r'''
+#define COMPILING_PER_TARGET
+#define CONFIG_TARGET "x86_64-softmmu-config-target.h"
+#include "qemu/osdep.h"
+#define CPU_DEFS_H
+#include "target/i386/cpu.h"
+#include "hw/i386/apic_internal.h"
+#include "qemu/main-loop.h"
+#include "system/memory.h"
+#include "qemu/crucible-clock-custody.h"
+#include "plugins/crucible-startup-source.h"
+
+#undef CPU
+#undef OBJECT
+#define CPU(object) ((CPUState *)(object))
+#define OBJECT(object) ((Object *)(object))
+
+static bool diagnostic_bql;
+static APICCommonState input_apic;
+static X86CPU input_cpu;
+static APICCommonClass input_class;
+static unsigned begins, posts, callbacks;
+static int first_refusal, post_refusal;
+static bool begin_active;
+
+bool bql_locked(void)
+{
+    return diagnostic_bql;
+}
+'''
+
+
+REFUSALS = r'''
+static void *foreign_thread(void *opaque)
+{
+    QemuCrucibleApicGetterFrame *frame = opaque;
+
+    assert(qemu_crucible_apic_getter_frame_current_v1(
+        &input_apic, frame, frame->holder,
+        QEMU_CRUCIBLE_APIC_GETTER_ISSUING) == -ESTALE);
+    return NULL;
+}
+
+int qemu_crucible_source_apic_getter_begin_v1(CPUState *cpu,
+    QemuCrucibleApicGetterFrame *frame, QemuCrucibleApicGetterLoan **holder)
+{
+    QemuCrucibleApicGetterFrame copy = *frame;
+    QemuCrucibleApicGetterLoan *foreign = NULL;
+    pthread_t thread;
+    pid_t process = frame->process;
+
+    assert(!begin_active);
+    begin_active = true;
+    begins++;
+    assert(cpu == CPU(&input_cpu));
+    assert(!*holder);
+    assert(qemu_crucible_apic_getter_frame_current_v1(
+        &input_apic, frame, holder, QEMU_CRUCIBLE_APIC_GETTER_ISSUING) == 0);
+    assert(qemu_crucible_apic_getter_frame_current_v1(
+        &input_apic, &copy, holder, QEMU_CRUCIBLE_APIC_GETTER_ISSUING) == -EPERM);
+    assert(qemu_crucible_apic_getter_frame_current_v1(
+        &input_apic, frame, &foreign, QEMU_CRUCIBLE_APIC_GETTER_ISSUING) == -EPERM);
+    assert(qemu_crucible_apic_getter_frame_current_v1(
+        &input_apic, frame, holder, QEMU_CRUCIBLE_APIC_GETTER_RETURNING) == -EPERM);
+    assert(qemu_crucible_apic_getter_frame_current_v1(
+        &input_apic, frame, holder, QEMU_CRUCIBLE_APIC_GETTER_SOFTWARE) == -EPERM);
+    assert(qemu_crucible_apic_getter_frame_current_v1(
+        &input_apic, frame, holder, (QemuCrucibleApicGetterPhase)999) == -EINVAL);
+
+    frame->process++;
+    assert(qemu_crucible_apic_getter_frame_current_v1(
