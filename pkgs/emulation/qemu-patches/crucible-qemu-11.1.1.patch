+static void crucible_fault_flush_complete_on_cpu(
+    CPUState *cpu, run_on_cpu_data unused)
+{
+    (void)unused;
+    g_assert(current_cpu == cpu);
+    /* The exclusive flush precedes this completion marker in the CPU FIFO. */
+}
+
+bool qemu_crucible_fault_flush_translation(void)
+{
+    CPUState *cpu = current_cpu ? current_cpu : qemu_get_cpu(0);
+
+    if (!cpu) {
+        return false;
+    }
+
+    /* Do not free translated code until the vCPU leaves its execution loop. */
+    queue_tb_flush(cpu);
+    cpu_exit(cpu);
+
+    /*
+     * Main-loop callers retain the synchronous completion contract. The
+     * standard run_on_cpu wait releases the BQL while the RR owner drains the
+     * exclusive flush and then this FIFO marker; no caller state is queued.
+     */
+    if (!current_cpu) {
+        run_on_cpu(cpu, crucible_fault_flush_complete_on_cpu, RUN_ON_CPU_NULL);
+    }
+    return true;
+}
