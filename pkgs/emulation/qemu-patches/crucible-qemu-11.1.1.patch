+
+static void ct3_timing_migration_cleanup(CXLType3Dev *ct3d)
+{
+    CXLType3TimingMigration *migration = &ct3d->timing_migration;
+
+    g_clear_pointer(&migration->sanitize_ranges, g_free);
+    g_clear_pointer(&migration->poison, g_free);
+    g_clear_pointer(&migration->poison_backup, g_free);
+    g_clear_pointer(&migration->scan_results, g_free);
+    memset(migration, 0, sizeof(*migration));
+}
+
+static bool ct3_count_within_capacity(const CXLType3Dev *ct3d, int32_t count)
+{
+    uint64_t capacity = ct3d->cxl_dstate.static_mem_size;
+    uint64_t max_entries;
+
+    if (uadd64_overflow(capacity, ct3d->dc.total_capacity, &capacity)) {
+        return false;
+    }
+    max_entries = MIN(capacity / CXL_CACHE_LINE_SIZE, INT32_MAX);
+    return count >= 0 && (uint64_t)count <= max_entries &&
+           (size_t)count <= SIZE_MAX / sizeof(CXLPoisonMigrationEntry);
+}
+
+static bool ct3_sanitize_count_valid(void *opaque, int version_id)
+{
+    CXLType3Dev *ct3d = opaque;
+    int32_t count = ct3d->timing_migration.sanitize_range_count;
+    size_t header_size = sizeof(uint8_t) * 4 + sizeof(uint32_t);
+    uint64_t max_count;
+
+    if (ct3d->cci.payload_max < header_size) {
+        return false;
+    }
+    max_count = (ct3d->cci.payload_max - header_size) /
+                sizeof(CXLDpaRange);
+
+    return count >= 0 && (uint64_t)count <= max_count &&
+           (size_t)count <= SIZE_MAX / sizeof(CXLDpaRange);
+}
+
+static bool ct3_poison_count_valid(void *opaque, int version_id)
+{
+    CXLType3Dev *ct3d = opaque;
+    int32_t count = ct3d->timing_migration.poison_count;
+
+    return count <= CXL_POISON_LIST_LIMIT &&
+           ct3_count_within_capacity(ct3d, count);
+}
+
+static bool ct3_poison_backup_count_valid(void *opaque, int version_id)
+{
+    CXLType3Dev *ct3d = opaque;
+
+    return ct3_count_within_capacity(
+        ct3d, ct3d->timing_migration.poison_backup_count);
+}
+
+static bool ct3_scan_result_count_valid(void *opaque, int version_id)
+{
+    CXLType3Dev *ct3d = opaque;
+
+    return ct3_count_within_capacity(
+        ct3d, ct3d->timing_migration.scan_result_count);
+}
+
+static int32_t ct3_poison_list_count(const CXLPoisonList *list)
+{
+    CXLPoison *entry;
+    int32_t count = 0;
+
+    QLIST_FOREACH(entry, list, node) {
+        if (count == INT32_MAX) {
+            return -1;
+        }
+        count++;
+    }
+    return count;
+}
+
+static void ct3_snapshot_poison_list(const CXLPoisonList *list,
+                                     CXLPoisonMigrationEntry *snapshot)
+{
+    CXLPoison *entry;
+    int32_t index = 0;
+
+    QLIST_FOREACH(entry, list, node) {
+        snapshot[index].start = entry->start;
+        snapshot[index].length = entry->length;
+        snapshot[index].type = entry->type;
+        index++;
+    }
+}
+
+static bool ct3_snapshot_list(const CXLType3Dev *ct3d,
+                              const CXLPoisonList *list, int32_t *count,
+                              CXLPoisonMigrationEntry **snapshot,
+                              Error **errp)
+{
+    *count = ct3_poison_list_count(list);
+    if (!ct3_count_within_capacity(ct3d, *count)) {
+        error_setg(errp, "CXL poison list exceeds device capacity");
+        return false;
+    }
+
+    *snapshot = g_new0(CXLPoisonMigrationEntry, *count);
+    ct3_snapshot_poison_list(list, *snapshot);
+    return true;
+}
+
+static bool ct3_timing_pre_save(void *opaque, Error **errp)
+{
+    CXLType3Dev *ct3d = opaque;
+    CXLType3TimingMigration *migration = &ct3d->timing_migration;
+    CXLSanitizeInfo *sanitize = ct3d->media_op_sanitize;
+
+    ct3_timing_migration_cleanup(ct3d);
+    if (sanitize) {
+        migration->sanitize_range_count = sanitize->dpa_range_count;
+        if (!ct3_sanitize_count_valid(ct3d, 2)) {
+            error_setg(errp,
+                       "CXL sanitize range count exceeds mailbox capacity");
+            return false;
+        }
+        migration->sanitize_fill_value = sanitize->fill_value;
+        migration->sanitize_ranges = g_memdup2(
+            sanitize->dpa_range_list,
+            sanitize->dpa_range_count * sizeof(CXLDpaRange));
+    }
+
+    if (!ct3_snapshot_list(ct3d, &ct3d->poison_list,
+                           &migration->poison_count,
+                           &migration->poison, errp) ||
+        !ct3_snapshot_list(ct3d, &ct3d->poison_list_bkp,
+                           &migration->poison_backup_count,
+                           &migration->poison_backup, errp) ||
+        !ct3_snapshot_list(ct3d, &ct3d->scan_media_results,
+                           &migration->scan_result_count,
+                           &migration->scan_results, errp)) {
+        ct3_timing_migration_cleanup(ct3d);
+        return false;
+    }
+    if ((unsigned int)migration->poison_count != ct3d->poison_list_cnt) {
+        error_setg(errp, "CXL poison list count is inconsistent");
+        ct3_timing_migration_cleanup(ct3d);
+        return false;
+    }
+
+    migration->poison_overflowed = ct3d->poison_list_overflowed;
+    migration->poison_overflow_timestamp = ct3d->poison_list_overflow_ts;
+    migration->scan_media_hasrun = ct3d->scan_media_hasrun;
+    return true;
+}
+
+static void ct3_timing_post_save(void *opaque)
+{
+    ct3_timing_migration_cleanup(opaque);
+}
+
+static bool ct3_poison_entry_valid(const CXLType3Dev *ct3d,
+                                   const CXLPoisonMigrationEntry *entry)
+{
+    uint64_t capacity = ct3d->cxl_dstate.static_mem_size;
+
+    if (uadd64_overflow(capacity, ct3d->dc.total_capacity, &capacity)) {
+        return false;
+    }
+    return entry->length &&
+           entry->type >= CXL_POISON_TYPE_EXTERNAL &&
+           entry->type <= CXL_POISON_TYPE_INJECTED &&
+           QEMU_IS_ALIGNED(entry->start, CXL_CACHE_LINE_SIZE) &&
+           QEMU_IS_ALIGNED(entry->length, CXL_CACHE_LINE_SIZE) &&
+           entry->start <= capacity &&
+           entry->length <= capacity - entry->start;
+}
+
+static bool ct3_poison_snapshot_valid(const CXLType3Dev *ct3d,
+                                      const CXLPoisonMigrationEntry *entries,
+                                      int32_t count)
+{
+    int32_t index;
+
+    for (index = 0; index < count; index++) {
+        if (!ct3_poison_entry_valid(ct3d, &entries[index])) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool ct3_sanitize_range_valid(CXLType3Dev *ct3d,
+                                     const CXLDpaRange *range,
+                                     uint64_t capacity)
+{
+    uint64_t vmem_size = ct3d->cxl_dstate.vmem_size;
+    uint64_t static_size = ct3d->cxl_dstate.static_mem_size;
+    uint64_t end;
+
+    if (!range->length ||
+        !QEMU_IS_ALIGNED(range->starting_dpa, CXL_CACHE_LINE_SIZE) ||
+        !QEMU_IS_ALIGNED(range->length, CXL_CACHE_LINE_SIZE) ||
+        uadd64_overflow(range->starting_dpa, range->length, &end) ||
+        end > capacity ||
+        (range->starting_dpa < vmem_size && end > vmem_size) ||
+        (range->starting_dpa >= vmem_size &&
+         range->starting_dpa < static_size && end > static_size)) {
+        return false;
+    }
+    return range->starting_dpa < static_size ||
+           ct3_test_region_block_backed(ct3d, range->starting_dpa,
+                                        range->length);
+}
+
+static bool ct3_sanitize_snapshot_valid(CXLType3Dev *ct3d)
+{
+    const CXLType3TimingMigration *migration = &ct3d->timing_migration;
+    uint64_t capacity = ct3d->cxl_dstate.static_mem_size;
+    uint64_t aggregate = 0;
+    int32_t index;
+
+    if (uadd64_overflow(capacity, ct3d->dc.total_capacity, &capacity)) {
+        return false;
+    }
+    if (migration->sanitize_range_count &&
+        migration->sanitize_fill_value != 0 &&
+        migration->sanitize_fill_value != 0xf) {
+        return false;
+    }
+    for (index = 0; index < migration->sanitize_range_count; index++) {
+        const CXLDpaRange *range = &migration->sanitize_ranges[index];
+
+        if (!ct3_sanitize_range_valid(ct3d, range, capacity) ||
+            uadd64_overflow(aggregate, range->length, &aggregate)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static void ct3_restore_poison_list(CXLPoisonList *list,
+                                    const CXLPoisonMigrationEntry *entries,
+                                    int32_t count)
+{
+    int32_t index;
+
+    /* Head insertion in reverse preserves source order and duplicates. */
+    for (index = count - 1; index >= 0; index--) {
+        CXLPoison *entry = g_new0(CXLPoison, 1);
+
+        entry->start = entries[index].start;
+        entry->length = entries[index].length;
+        entry->type = entries[index].type;
+        QLIST_INSERT_HEAD(list, entry, node);
+    }
+}
+
+static bool ct3_timing_post_load(void *opaque, int version_id, Error **errp)
+{
+    CXLType3Dev *ct3d = opaque;
+    CXLType3TimingMigration *migration = &ct3d->timing_migration;
+    bool media_sanitize_active = ct3d->cci.bg.runtime &&
+                                 ct3d->cci.bg.opcode == 0x4402;
+
+    if ((media_sanitize_active !=
+         (migration->sanitize_range_count != 0)) ||
+        !ct3_sanitize_snapshot_valid(ct3d) ||
+        !ct3_poison_snapshot_valid(ct3d, migration->poison,
+                                   migration->poison_count) ||
+        !ct3_poison_snapshot_valid(ct3d, migration->poison_backup,
+                                   migration->poison_backup_count) ||
+        !ct3_poison_snapshot_valid(ct3d, migration->scan_results,
+                                   migration->scan_result_count)) {
+        error_setg(errp, "invalid CXL Type3 continuation state");
+        return false;
+    }
+
+    if (media_sanitize_active) {
+        size_t ranges_size = migration->sanitize_range_count *
+                             sizeof(CXLDpaRange);
