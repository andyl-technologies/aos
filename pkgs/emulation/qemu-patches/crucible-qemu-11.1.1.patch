+static void fixture_family(uint8_t *wire)
+{
+    static const size_t source_offsets[] = {
+        QEMU_CRUCIBLE_PROCESS_PURPOSE_LOCAL_EXTENT_OFFSET,
+        QEMU_CRUCIBLE_PROCESS_PURPOSE_MEMORY_LIMIT_OFFSET,
+        QEMU_CRUCIBLE_PROCESS_PURPOSE_WRITABLE_FILE_LIMIT_OFFSET,
+        QEMU_CRUCIBLE_PROCESS_PURPOSE_TASK_LIMIT_OFFSET,
+        QEMU_CRUCIBLE_PROCESS_PURPOSE_FD_LIMIT_OFFSET,
+        QEMU_CRUCIBLE_PROCESS_PURPOSE_VCPU_LIMIT_OFFSET,
+    };
+    static const size_t row_offsets[] = {
+        FAMILY_ROW_EXTENT, FAMILY_ROW_MEMORY, FAMILY_ROW_FILE,
+        FAMILY_ROW_TASK, FAMILY_ROW_FD, FAMILY_ROW_VCPU,
+    };
+    uint8_t *family = wire + QEMU_CRUCIBLE_PROCESS_FAMILY_OFFSET;
+
+    memcpy(family, QEMU_CRUCIBLE_PROCESS_FAMILY_MAGIC, 8);
+    stl_be_p(family + 8, QEMU_CRUCIBLE_PROCESS_FAMILY_SCHEMA);
+    stl_be_p(family + 12, QEMU_CRUCIBLE_PROCESS_FAMILY_BYTES);
+    memcpy(family + QEMU_CRUCIBLE_PROCESS_FAMILY_CAPABILITY_OFFSET,
+           wire + QEMU_CRUCIBLE_PROCESS_PURPOSE_CONTAINING_CAPABILITY_OFFSET, 32);
+    stq_be_p(family + QEMU_CRUCIBLE_PROCESS_FAMILY_ACCOUNT_OFFSET,
+             ldq_be_p(wire +
+                      QEMU_CRUCIBLE_PROCESS_PURPOSE_ACCOUNT_GENERATION_OFFSET));
+    stq_be_p(family + QEMU_CRUCIBLE_PROCESS_FAMILY_GENERATION_OFFSET, 3);
+    for (size_t index = 0; index < 2; index++) {
+        uint8_t *row = family_row(wire, index);
+
+        stl_be_p(row, index);
+        row[FAMILY_ROW_ID] = index + 1;
+        for (size_t field = 0; field < G_N_ELEMENTS(source_offsets); field++) {
+            stq_be_p(row + row_offsets[field],
+                     ldq_be_p(wire + source_offsets[field]));
+        }
+    }
+}
