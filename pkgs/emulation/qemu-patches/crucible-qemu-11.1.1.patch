+static QemuCrucibleNativeInvocation *top_locked(
+    QemuCrucibleNativeInvocationRegistry *registry)
+{
+    QemuCrucibleNativeInvocation *top = NULL;
+    size_t i;
+
+    for (i = 0; i < ARRAY_SIZE(registry->frames); i++) {
+        QemuCrucibleNativeInvocation *frame = &registry->frames[i];
+
+        if (frame->live && qemu_thread_is_self(&frame->thread) &&
+            (!top || frame->serial > top->serial)) {
+            top = frame;
+        }
+    }
+    return top;
