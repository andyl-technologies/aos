+static CrucibleHotForkTemplateResourceStageState *
+crucible_hot_fork_template_resource_stage_report(
+    const CrucibleHotForkPluginBarrierState *plugin_barrier)
+{
+    CrucibleHotForkTemplateResourceStageState *report =
+        g_new0(CrucibleHotForkTemplateResourceStageState, 1);
+    bool resources_staged = crucible_hot_fork_private_ring_stage.staged ||
+        crucible_hot_fork_diagnostic_stage.staged ||
+        crucible_hot_fork_qmp_stage.staged ||
+        crucible_hot_fork_console_stage.staged ||
+        crucible_hot_fork_plugin_endpoint_stage.staged;
+    uint64_t parent_process_generation = 0;
+    uint64_t child_process_generation = 0;
+
+    assert(!crucible_hot_fork_plugin_endpoint_stage.staged ||
+           crucible_hot_fork_private_ring_stage.staged);
+    assert(!crucible_hot_fork_diagnostic_stage.staged ||
+           crucible_hot_fork_private_ring_stage.staged);
+    assert(!crucible_hot_fork_qmp_stage.staged ||
+           (crucible_hot_fork_private_ring_stage.staged &&
+            crucible_hot_fork_diagnostic_stage.staged));
+    assert(!crucible_hot_fork_plugin_endpoint_stage.staged ||
+           (crucible_hot_fork_diagnostic_stage.staged &&
+            crucible_hot_fork_qmp_stage.staged &&
+            crucible_hot_fork_console_stage.staged));
+    assert(!crucible_hot_fork_plugin_endpoint_stage.staged ||
+           crucible_hot_fork_plugin_endpoint_stage.private_ring_generation ==
+               crucible_hot_fork_private_ring_stage.generation);
+    assert(!crucible_hot_fork_plugin_endpoint_stage.staged ||
+           crucible_hot_fork_plugin_endpoint_stage.template_generation ==
+               crucible_hot_fork_private_ring_stage.template_generation);
+    assert(!crucible_hot_fork_diagnostic_stage.staged ||
+           crucible_hot_fork_diagnostic_stage.template_generation ==
+               crucible_hot_fork_private_ring_stage.template_generation);
+    assert(!crucible_hot_fork_qmp_stage.staged ||
+           crucible_hot_fork_qmp_stage.template_generation ==
+               crucible_hot_fork_private_ring_stage.template_generation);
+    assert(!crucible_hot_fork_console_stage.staged ||
+           crucible_hot_fork_console_stage.template_generation ==
+               crucible_hot_fork_private_ring_stage.template_generation);
+    if (resources_staged &&
+        crucible_hot_fork_private_ring_stage.template_generation != 0) {
+        assert(crucible_hot_fork_private_ring_stage.template_generation ==
+               crucible_hot_fork_template_generation);
+    }
+
+    report->schema_version = 13;
+    report->template_generation = resources_staged ?
+        crucible_hot_fork_private_ring_stage.template_generation : 0;
+    report->private_ring_staged =
+        crucible_hot_fork_private_ring_stage.staged;
+    report->private_ring_generation =
+        crucible_hot_fork_private_ring_stage.generation;
+    report->diagnostics_staged =
+        crucible_hot_fork_diagnostic_stage.staged;
+    report->diagnostic_generation =
+        crucible_hot_fork_diagnostic_stage.generation;
+    report->diagnostics_resource_plan_bound =
+        crucible_hot_fork_template_active &&
+        crucible_hot_fork_diagnostic_resource_plan_bound();
+    report->qmp_staged = crucible_hot_fork_qmp_stage.staged;
+    report->qmp_generation = crucible_hot_fork_qmp_stage.generation;
+    report->qmp_resource_plan_bound = crucible_hot_fork_template_active &&
+        crucible_hot_fork_qmp_resource_plan_bound();
+    report->console_staged = crucible_hot_fork_console_stage.staged;
+    report->console_generation = crucible_hot_fork_console_stage.generation;
+    report->console_resource_plan_bound =
+        crucible_hot_fork_template_active &&
+        crucible_hot_fork_console_resource_plan_bound();
+    report->plugin_endpoints_staged =
+        crucible_hot_fork_plugin_endpoint_stage.staged;
+    report->plugin_endpoint_generation =
+        crucible_hot_fork_plugin_endpoint_stage.generation;
+    report->plugin_private_ring_generation =
+        crucible_hot_fork_plugin_endpoint_stage.private_ring_generation;
+    report->plugin_barrier_generation =
+        crucible_hot_fork_plugin_endpoint_stage.plugin_barrier_generation;
+    report->worker_mask =
+        crucible_hot_fork_plugin_endpoint_stage.worker_mask;
+    report->parent_resume_worker_mask =
+        crucible_hot_fork_plugin_endpoint_stage.parent_resume_worker_mask;
+    report->child_reinitialize_worker_mask =
+        crucible_hot_fork_plugin_endpoint_stage.child_reinitialize_worker_mask;
+    report->pending_worker_mask = 0;
+    report->worker_disposition_bound =
+        crucible_hot_fork_plugin_endpoint_stage.staged &&
+        crucible_hot_fork_plugin_endpoint_stage.template_generation != 0 &&
+        crucible_hot_fork_plugin_worker_disposition_matches(plugin_barrier);
+    report->transaction_bound = crucible_hot_fork_template_active &&
+        resources_staged && report->template_generation ==
+            crucible_hot_fork_template_generation &&
+        (!crucible_hot_fork_diagnostic_stage.staged ||
+         crucible_hot_fork_diagnostic_stage.template_generation ==
+             crucible_hot_fork_template_generation) &&
+        (!crucible_hot_fork_qmp_stage.staged ||
+         crucible_hot_fork_qmp_stage.template_generation ==
+             crucible_hot_fork_template_generation) &&
+        (!crucible_hot_fork_console_stage.staged ||
+         crucible_hot_fork_console_stage.template_generation ==
+             crucible_hot_fork_template_generation) &&
+        (!crucible_hot_fork_plugin_endpoint_stage.staged ||
+         report->worker_disposition_bound);
+    report->plugin_child_plan_bound =
+        crucible_hot_fork_template_active &&
+        report->worker_disposition_bound && report->transaction_bound &&
+        crucible_hot_fork_plugin_child_plan_bound(
+            plugin_barrier, &parent_process_generation,
+            &child_process_generation);
+    report->plugin_child_resource_plan_bound =
+        report->plugin_child_plan_bound &&
+        crucible_hot_fork_plugin_child_resource_plan_bound(plugin_barrier) &&
+        report->diagnostics_resource_plan_bound &&
+        report->qmp_resource_plan_bound &&
+        report->console_resource_plan_bound;
+    report->parent_process_generation = parent_process_generation;
+    report->child_process_generation = child_process_generation;
+    report->readiness_proof_acknowledged =
+        crucible_hot_fork_template_active && plugin_barrier->quiescent &&
+        report->private_ring_staged && report->diagnostics_staged &&
+        report->qmp_staged && report->console_staged &&
+        report->plugin_endpoints_staged &&
+        report->worker_disposition_bound && report->transaction_bound;
+    return report;
+}
