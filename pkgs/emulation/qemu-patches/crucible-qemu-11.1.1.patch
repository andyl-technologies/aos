+static void test_update_origin(gconstpointer opaque)
+{
+    bool exact = GPOINTER_TO_INT(opaque);
+    MC146818RtcState state = { 0 };
+    __int128 deadline;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    observed_ps = 10501;
+    initialize_rtc(&state, exact);
+    deadline = (exact ? observed_ps : 10000) + PICOSECONDS_PER_SECOND;
+    g_assert_true(update_expiry_ps(&state) == deadline);
+    observed_ps = deadline - (exact ? 1 : 1000);
+    g_assert_false(qemu_clock_run_timers(rtc_clock));
+    rtc_update_time(&state, true);
+    g_assert_cmpuint(state.cmos_data[RTC_SECONDS], ==, 0);
+
+    observed_ps = deadline;
+    g_assert_true(qemu_clock_run_timers(rtc_clock));
+    g_assert_cmpuint(state.cmos_data[RTC_SECONDS], ==, 1);
+    g_assert_true(state.cmos_data[RTC_REG_C] & REG_C_UF);
+    state.cmos_index = RTC_REG_C;
+    g_assert_true(cmos_ioport_read(&state, 1, 1) & REG_C_UF);
+    g_assert_true(update_expiry_ps(&state) ==
+                  deadline + PICOSECONDS_PER_SECOND);
+    destroy_rtc(&state);
+}
+
+static void test_alarm_phase(void)
+{
+    MC146818RtcState state = { 0 };
+    __int128 deadline;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    observed_ps = 10501;
+    initialize_rtc(&state, true);
+    state.cmos_data[RTC_SECONDS_ALARM] = 2;
+    check_update_timer(&state);
+    deadline = observed_ps + 2 * (__int128)PICOSECONDS_PER_SECOND;
+    g_assert_true(state.next_alarm_ps == deadline);
+    observed_ps += PICOSECONDS_PER_SECOND;
+    g_assert_true(qemu_clock_run_timers(rtc_clock));
+    g_assert_false(state.cmos_data[RTC_REG_C] & REG_C_AF);
+    g_assert_true(update_expiry_ps(&state) == deadline);
+
+    observed_ps = deadline - 1;
+    g_assert_false(qemu_clock_run_timers(rtc_clock));
+    observed_ps = deadline;
+    g_assert_true(qemu_clock_run_timers(rtc_clock));
+    g_assert_true(state.cmos_data[RTC_REG_C] & REG_C_AF);
+    destroy_rtc(&state);
+}
+
+static void test_rebase_phase(void)
+{
+    MC146818RtcState state = { 0 };
+    __int128 deadline;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    observed_ps = 10501;
+    initialize_rtc(&state, true);
+    observed_ps += 123456789;
+    rtc_set_time(&state);
+    check_update_timer(&state);
+    deadline = observed_ps + PICOSECONDS_PER_SECOND;
+    g_assert_true(update_expiry_ps(&state) == deadline);
+    g_assert_true(state.calendar_origin_ps == observed_ps);
+    observed_ps = deadline - 1;
+    g_assert_cmpuint(get_guest_rtc_ns(&state, true), ==,
+                     NANOSECONDS_PER_SECOND - 1);
+    observed_ps = deadline;
+    g_assert_cmpuint(get_guest_rtc_ns(&state, true), ==,
+                     NANOSECONDS_PER_SECOND);
+    destroy_rtc(&state);
+}
+
+static void test_negative_calendar(void)
+{
+    MC146818RtcState state = { 0 };
+    struct tm date = {
+        .tm_year = 69, .tm_mon = 11, .tm_mday = 31,
+        .tm_hour = 23, .tm_min = 59, .tm_sec = 59,
+    };
+    __int128 deadline;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    observed_ps = 10501;
+    initialize_rtc(&state, true);
+    expected_year = 69;
+    rtc_set_cmos(&state, &date);
+    rtc_set_time(&state);
+    check_update_timer(&state);
+    deadline = observed_ps + PICOSECONDS_PER_SECOND;
+    g_assert_true(update_expiry_ps(&state) == deadline);
+    observed_ps = deadline - 1;
+    g_assert_cmpint((int64_t)get_guest_rtc_ns(&state, true), ==, -1);
+    rtc_update_time(&state, true);
+    g_assert_cmpuint(state.cmos_data[RTC_SECONDS], ==, 59);
+    observed_ps = deadline;
+    g_assert_true(qemu_clock_run_timers(rtc_clock));
+    g_assert_cmpuint(state.cmos_data[RTC_SECONDS], ==, 0);
+    destroy_rtc(&state);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_data_func("/rtc/update/fractional-origin", GINT_TO_POINTER(true),
+                         test_update_origin);
+    g_test_add_data_func("/rtc/update/non-tcg-origin", GINT_TO_POINTER(false),
+                         test_update_origin);
+    g_test_add_func("/rtc/update/alarm-phase", test_alarm_phase);
+    g_test_add_func("/rtc/update/rebase-phase", test_rebase_phase);
+    g_test_add_func("/rtc/update/negative-calendar", test_negative_calendar);
+    return g_test_run();
+}
