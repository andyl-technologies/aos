+    args = parser.parse_args()
+    source = (args.source_root / "plugins/crucible-paged-ram.c").read_text()
+    native = (args.source_root / "include/qemu/crucible-paged-ram.h").read_text()
+    startup = (args.source_root / "plugins/crucible-startup-source.c").read_text()
+    startup_header = (args.source_root / "plugins/crucible-startup-source.h").read_text()
+    native_plugin_header = (args.source_root / "include/qemu/plugin.h").read_text()
+    prototypes = [
+        declaration(startup_header,
+                    "bool qemu_crucible_startup_source_total_matches("),
+        declaration(startup_header,
+                    "uint64_t qemu_crucible_startup_source_control_metadata_bytes("),
+        declaration(startup_header,
