+int qemu_plugin_crucible_control_component_returned_current_v1(
+    QemuCrucibleSourceControlBinding *component,
+    qemu_plugin_vcpu_idle_resume_cb_t callback, void *child_userdata,
+    QemuCrucibleSourceControlBinding **holder)
+{
+    if (!fingerprint_control_component.attempted ||
+        component != fingerprint_control_component.component ||
+        holder != fingerprint_control_component.holder ||
+        callback != fingerprint_control_component.callback ||
+        child_userdata != fingerprint_control_component.child_userdata ||
+        fingerprint_control_component.process != getpid()) {
