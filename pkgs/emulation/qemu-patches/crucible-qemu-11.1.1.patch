+def expand_fragments(sources, name, parents=()):
+    if name in parents:
+        raise ValueError(f"recursive Source fragment: {name}")
+    # Source fragments can include other local fragments. Every transitive
+    # input must belong to the same frozen hash cohort before closure selection.
+    source = sources[name]
+    include = re.compile(r'^#include "(crucible-[^\"]+\.inc\.h)"$', re.M)
