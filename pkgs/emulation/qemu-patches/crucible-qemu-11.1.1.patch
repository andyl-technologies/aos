+static char *test_executable;
+
+static GByteArray *save_in_exact_process(bool wide)
+{
+    GError *error = NULL;
+    char *directory = g_dir_make_tmp("ptimer-stream-XXXXXX", &error);
+    char *path;
+    char *contents;
+    char option[] = "--encode-stream";
+    char *kind = g_strdup(wide ? "wide" : "narrow");
+    gsize length;
+    int status;
+    GByteArray *bytes;
+
+    g_assert_no_error(error);
+    path = g_build_filename(directory, "state", NULL);
+    char *arguments[] = { test_executable, option, path, kind, NULL };
+
+    g_assert_true(g_spawn_sync(NULL, arguments, NULL, 0, NULL, NULL,
+                               NULL, NULL, &status, &error));
+    g_assert_no_error(error);
+    g_assert_true(g_spawn_check_exit_status(status, &error));
+    g_assert_no_error(error);
+    g_assert_true(g_file_get_contents(path, &contents, &length, &error));
+    g_assert_no_error(error);
+    bytes = g_byte_array_new_take((uint8_t *)contents, length);
+    g_assert_cmpint(g_remove(path), ==, 0);
+    g_assert_cmpint(g_rmdir(directory), ==, 0);
+    g_free(path);
+    g_free(directory);
+    g_free(kind);
+    return bytes;
+}
+
+static void test_cross_mode(gconstpointer data)
+{
+    bool wide = GPOINTER_TO_INT(data);
+    ptimer_state *restored;
+    GByteArray *bytes;
+
+    if (!g_test_subprocess()) {
