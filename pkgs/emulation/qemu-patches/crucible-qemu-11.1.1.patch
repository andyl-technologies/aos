+        work = None
+        completion = None
+        while completion is None:
+            event = live.marker(deadline)
+            if event[0] == "control":
+                if control is not None:
+                    raise AssertionError(
+                        f"control time advance repeated its boundary: {event!r}"
+                    )
+                control = event[1]
+            elif event[0] == "control-work":
+                if control is None or work is not None:
+                    raise AssertionError(
+                        "synchronous control work crossed its control boundary: "
+                        f"control={control!r} work={event!r}"
+                    )
+                work = event[1]
+            elif event[0] == "advance":
+                if work is None:
+                    raise AssertionError(
+                        "time advance completed before synchronous control work"
+                    )
+                completion = event[1]
+            elif event[0] == "park" or (
+                event[0] == "result" and event[1] == 9
+            ):
+                continue
+            else:
+                raise AssertionError(
+                    f"unexpected control time-advance marker: {event!r}"
+                )
+
+        control_icount, generation = control
+        work_status, work_icount = work
+        if generation != 1 or work_status != 0 or work_icount != control_icount:
+            raise AssertionError(
+                "synchronous control work changed its exact RR coordinate: "
+                f"control={control!r} work={work!r}"
+            )
+        if completion != (0, target):
+            raise AssertionError(
+                f"unexpected control time-advance completion: {completion!r}"
+            )
+        status = live.qmp("query-status", deadline=deadline)
+        if status != {"status": "running", "running": True}:
+            raise AssertionError(
+                f"main loop did not survive synchronous RR work: {status!r}"
+            )
+    finally:
+        live.close()
+
+    return control_icount, work_icount, completion[1]
+
+
+def run_hlt_at_ceiling_test(qemu, plugin, bios):
+    live = LiveQemu(
+        qemu,
+        plugin,
+        bios,
+        dispatch_ceiling=HLT_DISPATCH_CEILING,
+    )
+    try:
+        events = [live.marker(), live.marker()]
+        expected = [
+            ("work", 0),
+            ("dispatch", HLT_DISPATCH_CEILING),
+        ]
+        if events != expected:
+            raise AssertionError(
+                f"unexpected HLT-at-ceiling events: {events!r}"
+            )
+
+        park_deadline = time.monotonic() + TIMEOUT_SECONDS
+        live.wait_for_rr_dispatch_event(park_deadline)
+    finally:
+        live.close()
+    if live.shutdown_marker_counts["dispatch"] != 0:
+        raise AssertionError(
+            "HLT-at-ceiling published an additional dispatch boundary: "
+            f"counts={dict(live.shutdown_marker_counts)!r} "
+            f"tail={list(live.shutdown_marker_tail)!r}"
+        )
+    return tuple(events)
