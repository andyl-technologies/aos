+static void test_geometry(void)
+{
+    _Alignas(max_align_t) uint8_t storage[4096];
+    uint8_t saved[4096];
+
+    for (size_t i = 0; i < G_N_ELEMENTS(cases); i++) {
+        const DecodeCase *test = &cases[i];
+        uintptr_t near_end = UINTPTR_MAX - test->alignment + 1;
+
+        memset(storage, 0xa5, sizeof(storage));
+        memcpy(saved, storage, sizeof(saved));
+        assert_refusal(test, storage, test->bytes - 1, -EMSGSIZE);
+        assert_refusal(test, storage, test->bytes + 1, -EMSGSIZE);
+        assert_refusal(test, NULL, test->bytes, -EINVAL);
+        assert_refusal(test, (const uint8_t *)(UINTPTR_MAX - 7),
+                       test->bytes, -EOVERFLOW);
+        g_assert_cmpint(test->decode(storage, test->bytes, NULL), ==, -EINVAL);
+        g_assert_cmpint(test->decode(storage, test->bytes, storage), ==, -EINVAL);
+        g_assert_cmpint(test->decode(storage, test->bytes, storage + 1), ==, -EINVAL);
+        g_assert_cmpint(test->decode(storage + test->alignment, test->bytes,
+                                    storage), ==, -EINVAL);
+        g_assert_cmpint(test->decode(storage, test->bytes, (void *)near_end), ==,
+                        -EOVERFLOW);
+        g_assert_cmpmem(storage, sizeof(storage), saved, sizeof(saved));
+    }
+}
