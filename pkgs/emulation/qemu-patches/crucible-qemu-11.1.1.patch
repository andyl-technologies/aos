+    while (left_index < left_count || right_index < right_count) {
+        if (right_index == right_count ||
+            (left_index < left_count &&
+             left[left_index].target_fd < right[right_index].target_fd)) {
+            left_index++;
+        } else if (left_index == left_count ||
+                   right[right_index].target_fd < left[left_index].target_fd) {
+            right_index++;
+        } else {
+            left_index++;
+            right_index++;
+        }
+        count++;
