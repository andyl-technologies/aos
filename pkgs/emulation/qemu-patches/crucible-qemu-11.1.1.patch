+void qemu_plugin_register_control_boundary_cb(
+    qemu_plugin_vcpu_idle_resume_cb_t cb, void *userdata)
+{
+    QemuCrucibleNativeGroupRegistrar registrar;
+    QemuCrucibleNativeGroupDescriptorView actual;
+    const QemuCrucibleNativeGroupDescriptorView expected = {
+        .coordinate = &qemu_plugin_control_boundary_cb,
+        .function = cb,
+        .userdata = userdata,
+        .userdata_coordinate = &qemu_plugin_control_boundary_userdata,
+        .kind = QEMU_CRUCIBLE_NATIVE_CONTROL,
+    };
+    int status = qemu_plugin_crucible_native_group_begin_v1(
+        QEMU_CRUCIBLE_NATIVE_GROUP_CONTROL, &expected, 1, &registrar);
+    bool selected =
+        qemu_crucible_startup_source_fingerprint_enrollment_required_v1();
+
+    if (!status && selected && cb &&
+        (!fingerprint_control_component.attempted ||
+         fingerprint_control_component.process != getpid() ||
+         cb != fingerprint_control_component.callback ||
+         userdata != fingerprint_control_component.child_userdata ||
+         qemu_crucible_source_capture_control_callback_v1(cb, userdata))) {
+        status = -ESTALE;
+    }
+    qemu_plugin_crucible_native_group_refuse_v1(&registrar, status);
+    if (status || qemu_plugin_crucible_native_group_effect_begin_v1(&registrar)) {
+        qemu_plugin_crucible_native_group_finish_v1(&registrar);
+        return;
+    }
+
+    qemu_plugin_crucible_native_group_member_attempt_v1(&registrar, 0);
+    qemu_plugin_crucible_native_registration_release_v1(
+        native_callback_registrations.control);
+    qatomic_store_release(&native_callback_registrations.control,
+        qemu_plugin_crucible_native_group_member_v1(&registrar, 0));
+    qemu_plugin_control_boundary_userdata = userdata;
+    qemu_plugin_control_boundary_cb = cb;
+    qemu_plugin_crucible_native_control_descriptor_observe_v1(0, &actual);
+    qemu_plugin_crucible_native_group_member_installed_v1(&registrar, 0, &actual);
+    qemu_plugin_crucible_native_group_effect_end_v1(&registrar);
+    qemu_plugin_crucible_native_group_finish_v1(&registrar);
+    if (selected && fingerprint_control_component.attempted) {
+        fingerprint_control_component.registered = cb != NULL;
+        fingerprint_control_component.detached = cb == NULL;
+    }
+    if (cb) {
+        qemu_plugin_crucible_callback_registered(
+            0, QEMU_PLUGIN_CRUCIBLE_CALLBACK_CONTROL_BOUNDARY);
+    }
+}
