+int qemu_crucible_checkpoint_candidate_end_v1(
+    QemuCrucibleCheckpointHeldTransaction *owner, uint32_t disposition,
+    int semantic_status)
+{
+    int status;
+
+    if (!owner) {
+        return 0;
+    }
+    status = checkpoint_identity(owner);
+    if (status || !owner->candidate_started || !owner->candidate_io_ended ||
+        !disposition || disposition > QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PAGER_INVALIDATE) {
+        return status ? status : -EPERM;
+    }
+    if (semantic_status < 0) {
+        checkpoint_fail(owner, semantic_status, false);
+    }
+    if (owner->candidate_ended && owner->candidate_disposition != disposition) {
+        return -ESTALE;
+    }
+    if (owner->candidate_read.active) {
+        status = qemu_crucible_checkpoint_candidate_cleanup_main_v1(
+            &owner->candidate_read);
+        if (status) {
+            /* The caller retains this same transaction on refusal. An Error
+             * reply cannot substitute for its signed native cleanup journal.
+             */
+            checkpoint_fail(owner, status, false);
+            return status;
+        }
+    }
+    owner->candidate_ended = true;
+    owner->candidate_disposition = disposition;
+    qatomic_store_release(&owner->request->final_disposition_published, true);
+    return checkpoint_finalize_main(owner);
+}
