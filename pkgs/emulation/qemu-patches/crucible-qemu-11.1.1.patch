+static void test_poll_events(void)
+{
+    struct qemu_plugin_crucible_fault_event event;
+    const uint8_t *evidence;
+    size_t envelope_length;
+    size_t length;
+    int status;
+
+    while ((status = qemu_plugin_crucible_fault_event_poll(
+                &event, test_evidence, sizeof(test_evidence),
+                &envelope_length)) == 1) {
+        evidence = test_event_evidence(
+            &event, test_evidence, envelope_length, &length);
+        uint64_t access_address = test_get_u64(evidence + 24);
+        uint64_t access_length = test_get_u64(evidence + 32);
+        uint64_t rule_length = strcmp(test_scenario, "rowhammer") == 0 ?
+                               0x3000 : test_length;
+
+        if (event.command_kind != test_command_kind ||
+            event.generation != 1 || access_length == 0 ||
+            access_length > 4096 ||
+            memcmp(evidence, "CRUCMEM2", 8) != 0 ||
+            ((test_get_u32(evidence + 8) & test_classes) == 0 &&
+             !(strcmp(test_scenario, "retention") == 0 &&
+               test_get_u32(evidence + 8) ==
+                   TEST_MEMORY_BOUNDARY_CLASS)) ||
+            test_get_u64(evidence + 48) == 0) {
+            g_printerr("event kind=%u generation=%" PRIu64
+                       " class=%u access=%" PRIx64 "+%" PRIu64
+                       " payload=%zu\n",
+                       event.command_kind, event.generation,
+                       test_get_u32(evidence + 8), access_address,
+                       access_length, length);
+            test_fail("occurrence evidence is incomplete");
+        }
+        if (test_command_kind == CRUCIBLE_FAULT_COMMAND_MEMORY_SERVICE) {
+            if ((strcmp(test_scenario, "fetch-service") == 0 ||
+                 strcmp(test_scenario, "fwcfg-service-write") == 0) &&
+                test_event_seen) {
+                test_fail("deferred service was committed more than once");
+            }
+            if (length != 576 || memcmp(evidence + 368, "CRUCSVC3", 8) ||
+                test_get_u32(evidence + 376) != 3 ||
+                test_get_u64(evidence + 400) <
+                    test_get_u64(evidence + 392) ||
+                test_get_u64(evidence + 408) != test_service_latency ||
+                (test_service_has_rates &&
+                 test_get_u64(evidence + 416) == 0) ||
+                test_get_u64(evidence + 432) == 0 ||
+                test_get_u64(evidence + 440) != test_service_latency ||
+                test_get_u64(evidence + 448) != test_service_byte_rate ||
+                test_get_u64(evidence + 456) != test_service_operation_rate ||
+                test_get_u32(evidence + 464) !=
+                    (test_service_has_rates ? 3 : 0) ||
+                test_get_u32(evidence + 468) !=
+                    CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED) {
+                g_printerr(
+                    "service length=%zu version=%u ready=%" PRIu64
+                    "/%" PRIu64 " fixed=%" PRIu64 " demand=%" PRIu64
+                    " queue=%" PRIu64 " completion=%" PRIu64
+                    " configured=%" PRIu64 "/%" PRIu64 "/%" PRIu64
+                    " flags=%u outcome=%u\n",
+                    length, test_get_u32(evidence + 376),
+                    test_get_u64(evidence + 392),
+                    test_get_u64(evidence + 400),
+                    test_get_u64(evidence + 408),
+                    test_get_u64(evidence + 416),
+                    test_get_u64(evidence + 424),
+                    test_get_u64(evidence + 432),
+                    test_get_u64(evidence + 440),
+                    test_get_u64(evidence + 448),
+                    test_get_u64(evidence + 456),
+                    test_get_u32(evidence + 464),
+                    test_get_u32(evidence + 468));
+                test_fail("service evidence is incomplete");
+            }
+            if (strcmp(test_scenario, "service-ps8") == 0 &&
+                (test_get_u64(evidence + 416) != 2 ||
+                 test_get_u64(evidence + 424) != 2 ||
+                 test_get_u64(evidence + 432) != 10)) {
+                test_fail("picosecond service demand rounded incorrectly");
+            }
+            if (test_is_page_table_walk_scenario() &&
+                (test_get_u64(evidence + 16) !=
+                     test_get_u64(evidence + 224) ||
+                 test_get_u32(evidence + 232) !=
+                     (test_address == 0x10d000 ? 1 : 3) ||
+                 test_get_u32(evidence + 236) != 1 ||
+                 test_get_u32(evidence + 240) != 2)) {
+                test_fail("service evidence lacks page-table identity");
+            }
+        } else {
+            uint64_t transaction_address = test_get_u64(evidence + 264);
+            uint64_t transaction_length = test_get_u64(evidence + 272);
+            uint32_t event_offset = test_get_u32(evidence + 60);
+            uint32_t event_length = test_get_u32(evidence + 108);
+            uint32_t state_flags = test_get_u32(evidence + 104);
+            uint16_t outcome = test_get_u16(evidence + 306);
+            uint64_t selected_address;
+            bool retention_boundary =
+                strcmp(test_scenario, "retention") == 0 &&
+                test_get_u32(evidence + 8) ==
+                    TEST_MEMORY_BOUNDARY_CLASS;
+            bool page_table_walk = test_is_page_table_walk_scenario();
+
+            if (test_retry_scenario) {
+                uint32_t retry_ordinal =
+                    test_get_u32(evidence + 260);
+                uint32_t has_instruction =
+                    test_get_u32(evidence + 300);
+
+                test_retry_event_count++;
+                if (has_instruction != 1 ||
+                    test_get_u64(evidence + 288) == 0) {
+                    test_fail("retry evidence lacks instruction identity");
+                }
+                if (page_table_walk &&
+                    (test_get_u32(evidence + 8) !=
+                         TEST_MEMORY_PAGE_TABLE_WALK_CLASS ||
+                     test_get_u64(evidence + 16) !=
+                         test_get_u64(evidence + 224) ||
+                     test_get_u32(evidence + 236) != 1 ||
+                     test_get_u32(evidence + 240) != 2)) {
+                    test_fail("page-table retry evidence lacks walk identity");
+                }
+                if (outcome == CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR &&
+                    test_get_u32(evidence + 308) == 5 &&
+                    retry_ordinal == 0 && !test_retry_poison_seen) {
+                    test_retry_poison_seen = true;
+                    test_retry_poison_icount =
+                        test_get_u64(evidence + 280);
+                } else if (outcome ==
+                               CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED &&
+                           test_get_u32(evidence + 308) == 1 &&
+                           retry_ordinal == 1 &&
+                           test_get_u64(evidence + 280) >
+                               test_retry_poison_icount &&
+                           test_retry_poison_seen &&
+                           !test_retry_applied_seen) {
+                    test_retry_applied_seen = true;
+                } else {
+                    test_fail("retry evidence has an unexpected ordinal");
+                }
+                test_event_seen = true;
+                continue;
+            }
+
+            if ((state_flags & 2U) != 0) {
+                if (event_offset != 0 || event_length != 0 ||
+                    outcome != CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR) {
+                    test_fail("stale-translation evidence is incomplete");
+                }
+                continue;
+            }
+
+            if (retention_boundary) {
+                if (test_retention_boundary_seen ||
+                    event.observed_tick !=
+                        test_get_u64(evidence + 96) + 8 ||
+                    event.observed_icount != test_install_icount + 8 ||
+                    outcome != CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED) {
+                    g_printerr(
+                        "retention boundary duplicate=%u install=%" PRIu64
+                        " raw=%" PRIu64 " tick=%" PRIu64 " outcome=%u\n",
+                        test_retention_boundary_seen, test_install_icount,
+                        event.observed_icount, event.observed_tick, outcome);
+                    test_fail(
+                        "retention did not decay at its exact virtual deadline");
+                }
+                test_retention_boundary_seen = true;
+            }
+
+            if (page_table_walk &&
+                (test_get_u32(evidence + 8) !=
+                     TEST_MEMORY_PAGE_TABLE_WALK_CLASS ||
+                 test_get_u64(evidence + 16) !=
+                     test_get_u64(evidence + 224) ||
+                 test_get_u32(evidence + 236) !=
+                     (strcmp(test_scenario,
+                             "page-table-walk-nested-stage2") == 0 ? 2 : 1) ||
+                 test_get_u32(evidence + 240) != 2 ||
+                 (test_is_nested_page_table_walk_scenario() &&
+                  (test_get_u64(evidence + 224) != 0x400000 ||
+                   test_get_u32(evidence + 232) != 1)) ||
+                 ((!test_is_nested_page_table_walk_scenario() &&
+                   test_address == 0x10d000) &&
+                   (test_get_u64(evidence + 224) != 0x400000 ||
+                    test_get_u32(evidence + 232) != 1)) ||
+                 ((!test_is_nested_page_table_walk_scenario() &&
+                   test_address != 0x10d000) &&
+                   (test_get_u64(evidence + 224) != 0x40600000 ||
+                    test_get_u32(evidence + 232) != 3)))) {
+                test_fail("page-table walk evidence is incomplete");
+            }
+
+            if (strcmp(test_scenario, "rowhammer") == 0 &&
+                (test_get_u64(evidence + 176) == 0 ||
+                 test_get_u64(evidence + 184) == 0 ||
+                 test_get_u64(evidence + 344) == 0)) {
+                g_printerr(
+                    "rowhammer evidence mutations=%" PRIu64
+                    " bytes=%" PRIu64 " victims=%" PRIu64
+                    " access=%" PRIx64 "+%" PRIu64 "\n",
+                    test_get_u64(evidence + 176),
+                    test_get_u64(evidence + 184),
+                    test_get_u64(evidence + 344),
+                    access_address, access_length);
+                test_fail("rowhammer did not mutate a victim row");
+            }
+
+            if (length < 480 || test_get_u32(evidence + 56) == 0 ||
+                (!retention_boundary && transaction_length == 0) ||
+                test_get_u16(evidence + 304) != test_command_kind ||
+                test_get_u32(evidence + 308) != test_kind ||
+                event_length == 0 || event_length > access_length ||
+                event_offset > access_length - event_length ||
+                access_address > UINT64_MAX - event_offset ||
+                ((strcmp(test_scenario, "poison-corrected") == 0 ||
+                  g_str_has_prefix(test_scenario,
+                                    "fetch-poison-corrected-")) &&
+                 outcome != CRUCIBLE_FAULT_EVENT_OUTCOME_CORRECTED) ||
+                ((strcmp(test_scenario, "poison-access-error") == 0 ||
+                  g_str_has_prefix(test_scenario, "poison-exception-") ||
+                 strcmp(test_scenario, "failed-region") == 0) &&
+                 outcome != CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR)) {
+                g_printerr(
+                    "memory evidence scenario=%s payload=%zu matches=%u "
+                    "transaction=%" PRIx64 "+%" PRIu64
+                    " command=%u/%u kind=%u/%u event=%u+%u "
+                    "access=%" PRIx64 "+%" PRIu64 " outcome=%u\n",
+                    test_scenario, length,
+                    test_get_u32(evidence + 56), transaction_address,
+                    transaction_length, test_get_u16(evidence + 304),
+                    test_command_kind, test_get_u32(evidence + 308),
+                    test_kind, event_offset, event_length, access_address,
+                    access_length, outcome);
+                test_fail("memory evidence is incomplete");
+            }
+            selected_address = access_address + event_offset;
+            if (selected_address < test_address ||
+                selected_address - test_address > rule_length - event_length ||
+                (!retention_boundary &&
+                 (transaction_address > selected_address ||
+                  selected_address - transaction_address >=
+                      transaction_length))) {
+                test_fail("occurrence evidence selected the wrong byte range");
+            }
+            if (test_require_full_coverage) {
+                for (size_t byte = 0; byte < event_length; byte++) {
+                    test_coverage |=
+                        1U << (selected_address - test_address + byte);
+                }
+            }
+        }
+        test_event_seen = true;
+    }
+    if (status < 0) {
+        test_fail("occurrence evidence could not be polled losslessly");
+    }
+}
+
+static void test_fault_completion(void *opaque)
+{
+    struct qemu_plugin_crucible_fault_result result;
+    uint8_t evidence[CRUCIBLE_NODE_FAULT_EVIDENCE_V1_BYTES];
+    size_t length;
+    int status;
+
+    (void)opaque;
+    test_poll_events();
+    while ((status = qemu_plugin_crucible_fault_poll(
+                &result, evidence, sizeof(evidence), &length)) == 1) {
+        if (test_expected_rejection != 0) {
+            if (result.status != test_expected_rejection || length != 0 ||
+                memcmp(result.before_hash, result.after_hash, 32) != 0) {
+                g_printerr(
+                    "rejection scenario=%s status=%u expected=%u "
+                    "evidence=%zu state_changed=%u\n",
+                    test_scenario, result.status, test_expected_rejection,
+                    length,
+                    memcmp(result.before_hash, result.after_hash, 32) != 0);
+                test_fail("invalid memory rule was not rejected atomically");
+            }
+            test_poll_events();
+            if (test_event_seen) {
+                test_fail("rejected memory rule emitted an occurrence");
+            }
+            test_complete = true;
+            g_printerr("CRUCIBLE_MEMORY_REJECTION_LIVE_PASS\n");
+            qemu_plugin_request_shutdown(0);
+            continue;
+        }
+        if ((test_rule_stage & 1U) == 0) {
+            if (result.status != CRUCIBLE_FAULT_STATUS_PREPARED ||
+                length != sizeof(evidence)) {
+                g_printerr("preparation status=%u evidence=%zu target=%" PRIu64
+                           " observed=%" PRIu64 " raw=%" PRIu64 "\n",
+                           result.status, length, test_command.target_icount,
+                           result.observed_icount, qemu_plugin_icount_raw());
+                test_fail("rule preparation did not return canonical evidence");
+            }
+            memcpy(test_command.expected_precondition_hash,
+                   result.before_hash, 32);
+            test_command.command_flags = 0;
+            test_command.command_sequence = test_rule_stage + 2;
+            test_command.target_icount =
+                result.observed_icount + test_command_lead_icount;
+            test_command.authorization_ceiling_icount =
+                test_command.target_icount;
+            test_command.target_tick =
+                result.observed_tick + test_command_lead_ticks;
+            test_command.authorization_ceiling_tick = test_command.target_tick;
+            test_prepared = true;
+            test_rule_stage++;
+            if (qemu_plugin_crucible_fault_submit(
+                    &test_command, test_payload->data,
+                    test_payload->len) != 0) {
+                test_fail("rule commit could not be submitted");
+            }
+            qemu_plugin_force_vcpu_exit();
+        } else {
+            const uint8_t ready = 0x7f;
+
+            if (result.status != CRUCIBLE_FAULT_STATUS_APPLIED ||
+                length != sizeof(evidence)) {
+                test_fail("rule commit was not applied");
+            }
+            if (test_retry_scenario && test_rule_stage == 1) {
+                const uint8_t cpu_mask = 0xff;
+                const uint8_t cpu_replacement = 0xa5;
+                const uint8_t walk_mask[8] = { 0, 2 };
+                const uint8_t walk_replacement[8] = { 0, 2 };
+
+                test_rule_stage = 2;
+                g_byte_array_unref(test_payload);
+                test_kind = 1;
+                if (test_is_page_table_walk_scenario()) {
+                    test_build_rule(
+                        1, TEST_MEMORY_PAGE_TABLE_WALK_CLASS,
+                        walk_mask, sizeof(walk_mask), true,
+                        walk_replacement, sizeof(walk_replacement), false);
+                } else {
+                    test_build_rule(1, 2, &cpu_mask, 1, true,
+                                    &cpu_replacement, 1, false);
+                }
+                test_command.command_flags =
+                    CRUCIBLE_FAULT_COMMAND_FLAG_PREPARE_ONLY;
+                test_command.command_sequence = 3;
+                test_command.target_icount =
+                    result.observed_icount + test_command_lead_icount;
+                test_command.authorization_ceiling_icount =
+                    test_command.target_icount;
+                test_command.target_tick =
+                    result.observed_tick + test_command_lead_ticks;
+                test_command.authorization_ceiling_tick = test_command.target_tick;
+                memset(test_command.expected_precondition_hash, 0, 32);
+                memset(test_command.binding_hash, 0x41, 32);
+                if (qemu_plugin_crucible_fault_submit(
+                        &test_command, test_payload->data,
+                        test_payload->len) != 0) {
+                    test_fail(
+                        "retry observer preparation could not be submitted");
+                }
+                qemu_plugin_force_vcpu_exit();
+                continue;
+            }
+            test_rule_stage++;
+            test_installed = true;
+            test_install_icount = result.observed_icount;
+            if (test_is_page_table_walk_scenario() &&
+                !test_is_nested_page_table_walk_scenario()) {
+                g_autoptr(GByteArray) inspected = g_byte_array_new();
+                uint64_t alias = test_address == 0x10d000 ?
+                    UINT64_C(0x400000) : UINT64_C(0x40600000);
+
+                if (!qemu_plugin_read_memory_vaddr(alias, inspected, 1) ||
+                    inspected->len != 1 || inspected->data[0] != 0x5a) {
+                    test_fail("inspection translation could not read alias");
+                }
+                test_poll_events();
+                if (test_event_seen) {
+                    test_fail("inspection translation consumed a walk rule");
+                }
+            }
+            if (!qemu_plugin_crucible_write_memory_vaddr(
+                    test_result_address, &ready, sizeof(ready))) {
+                test_fail(
+                    "guest installation acknowledgement could not be written");
+            }
+        }
+    }
+    if (status < 0) {
+        test_fail("rule result could not be polled losslessly");
+    }
+}
+
+static void test_tb_exec(unsigned int cpu_index, void *opaque)
+{
+    g_autoptr(GByteArray) value = g_byte_array_new();
+
+    (void)cpu_index;
+    (void)opaque;
+    test_tb_count++;
+    test_last_icount = qemu_plugin_icount_raw();
+    if (!test_submitted) {
+        if (qemu_plugin_read_memory_vaddr(test_result_address, value, 1) &&
+            value->len == 1 && value->data[0] == 0x7e) {
+            test_command.target_icount =
+                test_last_icount + test_command_lead_icount;
+            test_command.authorization_ceiling_icount =
+                test_command.target_icount;
+            test_command.target_tick =
+                qemu_plugin_sim_tick_observed() + test_command_lead_ticks;
+            test_command.authorization_ceiling_tick = test_command.target_tick;
+            if (qemu_plugin_crucible_fault_submit(
+                    &test_command, test_payload->data,
+                    test_payload->len) != 0) {
+                test_fail("deferred rule preparation could not be submitted");
+            }
+            test_submitted = true;
+            qemu_plugin_force_vcpu_exit();
+        }
+        return;
+    }
+    g_byte_array_set_size(value, 0);
+    if (test_installed && qemu_plugin_read_memory_vaddr(
+            test_observation_address, value, test_expected_length)) {
+        test_last_result_readable = true;
+        test_last_result_length = value->len;
+        memcpy(test_last_result, value->data, value->len);
+    }
+    if (!test_installed || !test_event_seen || test_complete ||
+        (strcmp(test_scenario, "retention") == 0 &&
+         !test_retention_boundary_seen) ||
+        (test_retry_scenario &&
+         (!test_retry_poison_seen || !test_retry_applied_seen ||
+          test_retry_event_count != 2)) ||
+        (test_require_full_coverage &&
+         test_coverage != (1U << test_length) - 1) ||
+        !test_last_result_readable ||
+        value->len != test_expected_length ||
+        memcmp(value->data, test_expected, test_expected_length) != 0) {
+        return;
+    }
+    test_complete = true;
+    g_printerr("CRUCIBLE_MEMORY_ACCESS_LIVE_PASS\n");
+    qemu_plugin_request_shutdown(0);
+}
+
+static void test_tb_trans(struct qemu_plugin_tb *tb, void *opaque)
+{
+    (void)opaque;
+    qemu_plugin_register_vcpu_tb_exec_cb(
+        tb, test_tb_exec, QEMU_PLUGIN_CB_NO_REGS, NULL);
+}
+
+static void test_exit(void *opaque)
+{
+    (void)opaque;
+    if (!test_complete) {
+        g_printerr("state tb=%" PRIu64 " icount=%" PRIu64
+                   "submitted=%u prepared=%u installed=%u event=%u "
+                   "coverage=%08x "
+                   "retry=%u/%u/%u readable=%u result=", test_tb_count,
+                   test_last_icount,
+                   test_submitted,
+                   test_prepared,
+                   test_installed, test_event_seen, test_coverage,
+                   test_retry_poison_seen, test_retry_applied_seen,
+                   test_retry_event_count,
+                   test_last_result_readable);
+        for (size_t byte = 0; byte < test_last_result_length; byte++) {
+            g_printerr("%02x", test_last_result[byte]);
+        }
+        g_printerr(" expected=");
+        for (size_t byte = 0; byte < test_expected_length; byte++) {
+            g_printerr("%02x", test_expected[byte]);
+        }
+        g_printerr("\n");
+        test_fail("guest-visible result was not observed");
+    }
+    g_byte_array_unref(test_payload);
+}
+
+QEMU_PLUGIN_EXPORT int qemu_plugin_install(qemu_plugin_id_t id,
+                                           const qemu_info_t *info,
+                                           int argc, char **argv)
+{
+    const char *cross_grant_state_fd = getenv("CROSS_GRANT_STATE_FD");
+    const char *cross_grant_wake_fd = getenv("CROSS_GRANT_WAKE_FD");
+    uint32_t kind = 1;
+    uint32_t classes = 2;
+    uint8_t mask[16] = { 0 };
+    uint8_t replacement[16] = { 0 };
+    size_t length = 1;
+    bool replacement_present = true;
+   bool violate_atomicity = false;
+
+#ifdef CRUCIBLE_FIXTURE_RESIDENT_OWNER
+    /* Standalone component builds own resident RAM; managed builds omit this
+     * flag and retain the production observer's physical paging authority. */
+    if (crucible_fixture_install_resident_ram() != 0) {
+        test_fail("resident logical RAM owner registration failed");
+    }
+#endif
+
+    (void)info;
+    if (cross_grant_state_fd && cross_grant_wake_fd) {
+        int state_fd = atoi(cross_grant_state_fd);
+        int wake_fd = atoi(cross_grant_wake_fd);
+
+        test_cross_grant = mmap(
+            NULL, sizeof(*test_cross_grant), PROT_READ | PROT_WRITE,
+            MAP_SHARED, state_fd, 0);
+        if (test_cross_grant == MAP_FAILED ||
+            !qemu_plugin_request_time_control() ||
+            qemu_plugin_register_wake_fd(wake_fd) != 0) {
+            test_fail("cross-grant scheduler setup failed");
+        }
+    }
+    if ((argc != 9 && argc != 10) ||
+        !g_str_has_prefix(argv[0], "address=") ||
+        !g_str_has_prefix(argv[1], "result=") ||
+        !g_str_has_prefix(argv[2], "expected=") ||
+        !g_str_has_prefix(argv[3], "kind=") ||
+        !g_str_has_prefix(argv[4], "classes=") ||
+        !g_str_has_prefix(argv[5], "length=") ||
+        !g_str_has_prefix(argv[6], "mask=") ||
+        !g_str_has_prefix(argv[7], "replacement=") ||
+        !g_str_has_prefix(argv[8], "atomic=") ||
+        (argc == 10 && !g_str_has_prefix(argv[9], "scenario="))) {
+        test_fail(
+            "nine canonical arguments and an optional scenario are required");
+    }
+    test_address = g_ascii_strtoull(argv[0] + 8, NULL, 0);
+    test_result_address = g_ascii_strtoull(argv[1] + 7, NULL, 0);
+    test_observation_address = test_result_address;
+    test_expected_length = test_parse_hex(
+        argv[2] + 9, test_expected, sizeof(test_expected));
+    kind = g_ascii_strtoull(argv[3] + 5, NULL, 0);
+    classes = g_ascii_strtoull(argv[4] + 8, NULL, 0);
+    length = g_ascii_strtoull(argv[5] + 7, NULL, 0);
+    if (length == 0 || length > sizeof(mask)) {
+        test_fail("test length is out of range");
+    }
+    test_length = length;
+    test_kind = kind;
+    test_classes = classes;
+    if (strcmp(argv[6] + 5, "none") != 0 &&
+        test_parse_hex(argv[6] + 5, mask, sizeof(mask)) != length) {
+        test_fail("mask length must equal the rule length");
+    }
+    if (strcmp(argv[7] + 12, "none") == 0) {
+        replacement_present = false;
+    } else if (test_parse_hex(
+                   argv[7] + 12, replacement,
+                   sizeof(replacement)) != length) {
+        test_fail("replacement length must equal the rule length");
+    }
+    violate_atomicity = g_ascii_strtoull(argv[8] + 7, NULL, 0) != 0;
+    if (argc == 10) {
+        test_scenario = argv[9] + 9;
+        test_build_scenario(test_scenario);
+    } else {
+        test_build_rule(kind, classes, mask, length, replacement_present,
+                        replacement, length, violate_atomicity);
+    }
+    if (strcmp(test_scenario, "fwcfg-service-write") == 0) {
+        if (test_cross_grant) {
+            qemu_plugin_register_sim_shmem_dispatch_cb(
+                test_cross_grant_publish, test_cross_grant_raw_ceiling,
+                test_cross_grant_logical_ceiling, NULL);
+        } else {
+            qemu_plugin_register_sim_shmem_dispatch_cb(
+                test_host_dispatch_publish, test_host_dispatch_unbounded,
+                test_host_dispatch_unbounded, NULL);
+        }
+    }
+    memset(&test_command, 0, sizeof(test_command));
+    test_command.abi_major = CRUCIBLE_FAULT_COMMAND_ABI_MAJOR;
+    test_command.abi_minor = CRUCIBLE_FAULT_COMMAND_ABI_MINOR;
+    test_command.command_kind = test_command_kind;
+    test_command.command_flags = CRUCIBLE_FAULT_COMMAND_FLAG_PREPARE_ONLY;
+    test_command.phase = CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY;
+    test_command.semantic_version = CRUCIBLE_FAULT_COMMAND_SEMANTIC_VERSION;
+    test_command.command_sequence = 1;
+    test_command.target_icount = 32;
+    test_command.authorization_ceiling_icount = 32;
+    test_command.target_tick = 1600;
+    test_command.authorization_ceiling_tick = 1600;
+    memset(test_command.target_node_hash, 0x11, 32);
+    memset(test_command.binding_hash, 0x31, 32);
+    if (getenv("CROSS_GRANT_RESTORE")) {
+        test_submitted = true;
+        test_prepared = true;
+        test_installed = true;
+    } else if (argc != 10 || !test_deferred_submission) {
+        if (qemu_plugin_crucible_fault_submit(
+                &test_command, test_payload->data, test_payload->len) != 0) {
+            test_fail("rule preparation could not be submitted");
+        }
+        test_submitted = true;
+    }
+    qemu_plugin_register_crucible_fault_completion_cb(
+        test_fault_completion, NULL);
+    if (test_submitted) {
+        test_fault_completion(NULL);
+    }
+    qemu_plugin_register_vcpu_tb_trans_cb(id, test_tb_trans, NULL);
+    qemu_plugin_register_atexit_cb(id, test_exit, NULL);
+    return 0;
+}
