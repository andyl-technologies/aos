+    decoded.region_bytes = ldq_be_p(wire + 120);
+    decoded.producer_event = ldq_be_p(wire + 128);
+    decoded.receiver_event = ldq_be_p(wire + 136);
+    decoded.backing_bytes = ldq_be_p(wire + 144);
+    decoded.cleanup_generation = ldq_be_p(wire + 152);
+    decoded.native_debit = ldq_be_p(wire + 160);
+    if (!decoded.lender_generation || decoded.lender_generation == UINT64_MAX ||
+        !decoded.account_generation || decoded.account_generation == UINT64_MAX ||
+        !decoded.process_generation || decoded.process_generation == UINT64_MAX ||
+        !purpose_nonzero(decoded.capability, 32) ||
+        !purpose_nonzero(decoded.reservation, 32) ||
+        decoded.region_bytes != 4096 || !decoded.producer_event ||
+        decoded.producer_event == UINT64_MAX || !decoded.receiver_event ||
