+static void scenario_checkpoint_foreign(void)
+{
+    QemuCrucibleStartupSourceControl before;
+    GHashTable *table;
+    QemuThread thread;
+
+    fixture_prepare(0, false);
+    g_assert_cmpint(fixture_acquire(), ==, 0);
+    table = plugin.id_ht;
+    plugin.id_ht = NULL;
+    memcpy(&before, &startup_source, sizeof(before));
+    /* Owner retains the real recursive lock; foreign callers must not wait. */
+    qemu_thread_create(&thread, "checkpoint-foreign", foreign_checkpoint_register,
+                       NULL, QEMU_THREAD_JOINABLE);
+    qemu_thread_join(&thread);
+    g_assert_cmpmem(&startup_source, sizeof(startup_source),
+                    &before, sizeof(before));
+    plugin.id_ht = table;
+    g_assert_cmpint(fixture_register_checkpoint(), ==, 0);
+    assert_checkpoint_published();
+}
