+/* Read the durable native physical-return journal only. Provider/Root pointers
+ * may already be retired: this cut never calls them or reopens Stop custody. */
+static int checkpoint_terminal_return_current(
+    QemuCrucibleCheckpointHeldTransaction *owner,
+    QemuCrucibleCheckpointRequestLoan *request, uint32_t terminal)
+{
+    int status = checkpoint_identity(owner);
+
+    if (status) {
+        return status;
+    }
+    if (owner->request != request ||
+        (terminal != QEMU_CRUCIBLE_CHECKPOINT_TERMINAL_RETIRED &&
+         terminal != QEMU_CRUCIBLE_CHECKPOINT_TERMINAL_NO_ROOT) ||
+        !qatomic_load_acquire(&request->final_disposition_published) ||
+        (!(owner->candidate_ended && owner->candidate_io_ended) &&
+         !request->noncandidate_end_published) ||
+        !owner->module_finalize_complete || !request->provider_ended ||
+        !owner->terminal_post_observed || qatomic_read(&owner->post_status) ||
+        qatomic_read(&request->post_status) ||
+        !owner->event_close_attempted || owner->event_close_uncertain ||
+        owner->cancellation_fd != -1 || owner->metadata_fd != -1 ||
+        owner->metadata_close_uncertain ||
+        !request->receipt_returned || !request->actor_pause_ended ||
+        checkpoint_stop_owner.transaction == owner ||
+        owner->candidate_alias_uncertain || owner->capture_alias_active ||
+        owner->candidate_read.active || owner->inventory.active || owner->inventory.metadata_borrow ||
+        owner->inventory.output.held || owner->inventory.output.close_uncertain ||
+        owner->inventory.cancellation.held || owner->inventory.cancellation.close_uncertain || owner->invocation.active ||
+        owner->invoking || owner->cleanup_invoking || owner->finalize_invoking ||
+        request->provider_invoking || request->snapshot_birth_pending ||
+        (request->snapshot_issued && (!request->snapshot_io_returned ||
+         !request->snapshot_body_cleaned || !request->snapshot_dismissed))) {
+        return -EINPROGRESS;
+    }
+    if (terminal == QEMU_CRUCIBLE_CHECKPOINT_TERMINAL_RETIRED) {
+        return checkpoint_root_end_complete(owner) ? 0 : -EINPROGRESS;
+    }
+    /* A no-root journal cannot hide an unadopted physical collector. */
+    return !owner->prepare_called && !owner->proof.retained &&
+           !owner->mailbox_detached && !owner->pager_held &&
+           !owner->candidate_collector_token ? 0 : -EINPROGRESS;
+}
+
+int qemu_crucible_checkpoint_end_main_v1(
+    const uint8_t arm_digest[32], uint64_t request_generation,
+    uint64_t *connection_epoch)
+{
+    QemuCrucibleCheckpointRequestLoan *request;
+    QemuCrucibleCheckpointHeldTransaction *owner = &checkpoint_transaction;
+    uint32_t terminal;
+    int status;
+
+    if (!arm_digest || !request_generation || !connection_epoch) {
+        return -EINVAL;
+    }
+    status = checkpoint_selected_main_request(&request);
+    if (status) {
+        return status;
+    }
+    if (request->generation != request_generation ||
+        memcmp(request->arm_digest, arm_digest, sizeof(request->arm_digest))) {
+        return -ESTALE;
+    }
+    terminal = qatomic_load_acquire(&request->terminal_state);
+    if (terminal == QEMU_CRUCIBLE_CHECKPOINT_TERMINAL_RETIRED ||
+        terminal == QEMU_CRUCIBLE_CHECKPOINT_TERMINAL_NO_ROOT) {
+        status = checkpoint_terminal_return_current(owner, request, terminal);
+        if (status) {
+            return status;
+        }
+        /* Candidate end or paused reap may already have returned every native
+         * checkpoint holder. Explicit End closes only the same Main scope and
+         * retains the old digest/generation/epoch and signed terminal journal. */
+        request->end_requested = true;
+        request->main_scope_active = false;
+        *connection_epoch = request->connection_epoch;
+        return 0;
+    }
+    status = checkpoint_bind_stop_cleanup(owner);
+    if (status || owner->candidate_read.active || owner->inventory.active || owner->inventory.metadata_borrow ||
+        owner->inventory.output.held || owner->inventory.output.close_uncertain ||
+        owner->inventory.cancellation.held || owner->inventory.cancellation.close_uncertain || owner->invocation.active ||
+        owner->invoking || owner->cleanup_invoking || request->provider_invoking ||
+        request->snapshot_birth_pending) {
+        return status ? status : -EBUSY;
+    }
+    request->end_requested = true;
+    if (request->snapshot_issued && !request->snapshot_dismissed &&
+        request->snapshot_job) {
+        status = qemu_crucible_checkpoint_snapshot_dismiss_v1(request->snapshot_job);
+        if (status) {
+            return status;
+        }
+    }
+    if (request->snapshot_issued && (!request->snapshot_io_returned ||
+        !request->snapshot_body_cleaned || !request->snapshot_dismissed)) {
+        return -EINPROGRESS;
+    }
+    /* The actual page authority owns commit/abort/invalidate and reservation
+     * release. Its absence cannot clear a retained Receiving collector or alias.
+     */
+    status = qemu_crucible_checkpoint_end_candidate_v1(owner);
+    if (status) {
+        return status;
+    }
+    if (!owner->candidate_started) {
+        if (owner->capture_alias_active && !owner->capture_alias_moved) {
+            checkpoint_capture_alias_abort(owner, -ECANCELED);
+        }
+        if (owner->capture_alias_moved || owner->candidate_collector_token ||
+            owner->prepare_called || owner->proof.retained || owner->pager_held ||
+            owner->mailbox_detached || owner->candidate_alias_uncertain) {
+            return -EINPROGRESS;
+        }
+        /* A real pause-only end has its own journal. It does not manufacture
+         * candidate IO/disposition receipts or release ordinary Stop authority.
+         */
+        request->noncandidate_end_published = true;
+        qatomic_store_release(&request->final_disposition_published, true);
+    }
+    status = checkpoint_finalize_main(owner);
+    if (status) {
+        return status;
+    }
+    request->main_scope_active = false;
+    *connection_epoch = request->connection_epoch;
+    return 0;
+}
+
+int qemu_crucible_checkpoint_terminal_observe_v1(
+    QemuCrucibleRamControlActor *actor, QemuCrucibleCheckpointRequestLoan *request,
+    const uint8_t arm_digest[32], uint64_t generation, uint64_t connection_epoch,
+    QemuCrucibleCheckpointTerminalObservation *out)
+{
+    QemuCrucibleCheckpointTerminalObservation observed;
+    int status = qemu_crucible_ram_control_actor_current(
+        actor, checkpoint_request.pager.installer.plugin_id);
+
+    /* The retained request owns the actual actor/connection binding.
+     * A query's copied digest/gen/epoch cannot
+     * enroll it. This RAM path reads only; it cannot finalize Main or Root.
+     */
+    if (status || request != &checkpoint_request || !out ||
+        !qatomic_load_acquire(&checkpoint_request.published) ||
+        request->actor != actor || !request->connection_owner ||
+        !request->generation || !request->connection_epoch || !arm_digest) {
+        return status ? status : -EPERM;
+    }
+    if (generation != request->generation ||
+        connection_epoch != request->connection_epoch ||
+        memcmp(arm_digest, request->arm_digest, sizeof(request->arm_digest))) {
+        return -ESTALE;
+    }
+    observed = (QemuCrucibleCheckpointTerminalObservation) {
+        .generation = request->generation,
+        .connection_epoch = request->connection_epoch,
+        .physical_state = qatomic_load_acquire(&request->terminal_state),
+        .first_status = qatomic_read(&request->first_status),
+        .post_status = qatomic_read(&request->post_status),
+    };
+    memcpy(observed.arm_digest, request->arm_digest, sizeof(observed.arm_digest));
+    *out = observed;
+    return 0;
+}
