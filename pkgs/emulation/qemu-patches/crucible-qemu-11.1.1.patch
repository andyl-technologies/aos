+    g_assert_cmpuint(second_generation, ==, first_generation + 1);
+    g_assert_cmpint(qemu_plugin_crucible_virtual_timer_witness_query(
+                        &state, first_generation, &witness),
+                    ==, -ESTALE);
+    g_assert_cmpuint(witness.completed, ==, 0);
+}
