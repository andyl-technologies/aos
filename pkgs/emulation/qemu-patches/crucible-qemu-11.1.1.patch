+/* Pure host service actors cannot take registered QEMU locks while a physical
+ * collector retains them. This one-slot mailbox publishes only static native
+ * callbacks and privately retained contexts through acquire/release atomics.
+ */
+static struct {
+    uint64_t state; /* Generation-tagged phases: idle, publish, ready, run, rerun. */
+    int (*callback)(void *);
+    void *opaque;
+} ram_scheduled;
+
+/* These phases preserve the original queue generation and body. */
+#define RAM_SCHEDULED_CHECKPOINT_QUEUED 5
+#define RAM_SCHEDULED_CHECKPOINT_EMPTY 6
+
+typedef struct QemuCrucibleCheckpointHeldTransaction
+    QemuCrucibleCheckpointHeldTransaction;
+
+struct QemuCrucibleCheckpointPlacementOwner {
+    /* Immutable after retained-transaction binding; no receive issuer exists. */
+    pid_t process_id;
+    int64_t owner_thread_id;
+    bool published;
+    QemuCrucibleCheckpointHeldTransaction *transaction;
+    uint64_t stopped_generation;
+    int cancellation_fd;
+    int saved_cancellation_fd;
+    uint64_t saved_state;
+    int (*saved_callback)(void *);
+    void *saved_opaque;
+    int first_status;
+    int post_status;
+    bool detached;
+};
+
+/* Binding requires the actual conditional Receiving transaction. Its genuine
+ * request-purpose publisher is unavailable. The receiver installs its process
+ * owner before any fallible
+ * original begin, subscriber or decode step, retaining failure custody there.
+ * It lends this binding only after authentic live checks; a pointer or copied
+ * stop generation cannot create authority. Transaction, module and event
+ * custody survive all candidate/commit/abort/invalidation uncertainty.
+ */
+static QemuCrucibleCheckpointPlacementOwner checkpoint_placement_owner = {
+    .cancellation_fd = -1,
+    .saved_cancellation_fd = -1,
+};
+
+static int checkpoint_placement_fail(
+    QemuCrucibleCheckpointPlacementOwner *owner, int status)
+{
+    if (!owner->first_status) {
+        owner->first_status = status;
+    }
+    return owner->first_status;
+}
+
+static int checkpoint_placement_current(
+    QemuCrucibleCheckpointPlacementOwner *owner)
+{
+    QemuCrucibleHotForkCoordinator *coordinator =
+        &crucible_hot_fork_coordinator;
+    int transaction_status;
+
+    /* Only immutable release-published binding precedes foreign refusal. */
+    if (owner != &checkpoint_placement_owner ||
+        !qatomic_load_acquire(&checkpoint_placement_owner.published) ||
+        checkpoint_placement_owner.process_id != getpid() ||
+        checkpoint_placement_owner.owner_thread_id != qemu_get_thread_id()) {
+        return -EPERM;
+    }
+    if (!qatomic_load_acquire(&coordinator->initialized) ||
+        coordinator->process_id != getpid() ||
+        coordinator->main_thread_id != qemu_get_thread_id() || !bql_locked() ||
+        coordinator->child_runtime_pending) {
+        return -EPERM;
+    }
+    if (!owner->transaction || owner->cancellation_fd < 0) {
+        return -EPERM;
+    }
+    if (owner->first_status < 0) {
+        return owner->first_status;
+    }
+    transaction_status = qemu_crucible_checkpoint_transaction_placement_current(
+        owner->transaction, owner->stopped_generation, owner->cancellation_fd);
+
+    if (transaction_status) {
+        return transaction_status;
+    }
+#ifndef CONFIG_POSIX
+    return checkpoint_placement_fail(owner, -ENOTSUP);
+#endif
+    if (!owner->stopped_generation ||
+        !runstate_check(RUN_STATE_PAUSED) ||
+        !qemu_plugin_crucible_vmstop_quiesced() ||
+        qemu_plugin_crucible_vmstop_cold_origin() ||
+        qemu_plugin_crucible_vmstop_generation() !=
+            owner->stopped_generation) {
+        return checkpoint_placement_fail(owner, -ESTALE);
+    }
+    return 0;
+}
+
+int qemu_crucible_checkpoint_main_loop_current(void)
+{
+    QemuCrucibleHotForkCoordinator *coordinator =
+        &crucible_hot_fork_coordinator;
+
+    if (!qatomic_load_acquire(&coordinator->initialized) ||
+        coordinator->process_id != getpid() ||
+        coordinator->main_thread_id != qemu_get_thread_id() ||
+        !bql_locked() || qemu_in_coroutine() ||
+        coordinator->child_runtime_pending) {
+        return -EPERM;
+    }
+    return runstate_check(RUN_STATE_PAUSED) &&
+        qemu_plugin_crucible_vmstop_quiesced() &&
+        !qemu_plugin_crucible_vmstop_cold_origin() ? 0 : -ESTALE;
+}
+
+int qemu_crucible_checkpoint_placement_bind_v1(
+    QemuCrucibleCheckpointHeldTransaction *transaction,
+    uint64_t stopped_generation, int cancellation_fd,
+    QemuCrucibleCheckpointPlacementOwner **out)
+{
+    QemuCrucibleCheckpointPlacementOwner *owner = &checkpoint_placement_owner;
+    int status = qemu_crucible_checkpoint_main_loop_current();
+
+    if (status) {
+        return status;
+    }
+    status = qemu_crucible_checkpoint_transaction_placement_current(
+        transaction, stopped_generation, cancellation_fd);
+    if (status) {
+        return status;
+    }
+    if (!out) {
+        return -EINVAL;
+    }
+    if (qatomic_load_acquire(&owner->published)) {
+        if (owner->transaction != transaction ||
+            owner->stopped_generation != stopped_generation ||
+            owner->cancellation_fd != cancellation_fd) {
+            return -ESTALE;
+        }
+        status = checkpoint_placement_current(owner);
+        if (status) {
+            return status;
+        }
+    } else {
+        owner->process_id = getpid();
+        owner->owner_thread_id = qemu_get_thread_id();
+        owner->transaction = transaction;
+        owner->stopped_generation = stopped_generation;
+        owner->cancellation_fd = cancellation_fd;
+        qatomic_store_release(&owner->published, true);
+    }
+    *out = owner;
+    return 0;
+}
+
+/* Unlike ordinary event_notifier_set, this path never retries EINTR. The
+ * existing notifier is nonblocking; no descriptor or new wake object is made.
+ * The actual main-loop owner cannot consume its wake between this write and
+ * the restoring CAS because the entire scope retains BQL and does not yield.
+ */
+static int checkpoint_placement_notify(void)
+{
+#ifdef CONFIG_POSIX
+    const uint64_t value = 1;
+    EventNotifier *wake = &crucible_hot_fork_coordinator.wake;
+    ssize_t written;
+    int saved_errno;
+
+    if (!wake->initialized) {
+        return -ESTALE;
+    }
+    written = write(event_notifier_get_wfd(wake), &value, sizeof(value));
+    saved_errno = errno;
+    if (written == sizeof(value) ||
+        (written < 0 && saved_errno == EAGAIN)) {
+        return 0;
+    }
+    return written < 0 ? -saved_errno : -EIO;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_crucible_checkpoint_placement_detach_v1(
+    QemuCrucibleCheckpointPlacementOwner *owner)
+{
+    uint64_t state;
+    uint64_t held;
+    int status = checkpoint_placement_current(owner);
+
+    if (status) {
+        return status;
+    }
+    if (owner->detached) {
+        return -EALREADY;
+    }
+
+    state = qatomic_load_acquire(&ram_scheduled.state);
+    if ((state & 7) == 2) {
+        held = (state & ~UINT64_C(7)) | RAM_SCHEDULED_CHECKPOINT_QUEUED;
+    } else if ((state & 7) == 0) {
+        held = state | RAM_SCHEDULED_CHECKPOINT_EMPTY;
+    } else {
+        return -EINPROGRESS;
+    }
+    if (qatomic_cmpxchg(&ram_scheduled.state, state, held) != state) {
+        return -EINPROGRESS;
+    }
+
+    owner->saved_state = state;
+    owner->saved_callback = qatomic_read(&ram_scheduled.callback);
+    owner->saved_opaque = qatomic_read(&ram_scheduled.opaque);
+    owner->saved_cancellation_fd = owner->cancellation_fd;
+    owner->detached = true;
+    return 0;
+}
+
+int qemu_crucible_checkpoint_placement_detach_expected_v2(
+    QemuCrucibleCheckpointPlacementOwner *owner,
+    int (*expected_callback)(void *), void *expected_opaque)
+{
+    uint64_t state;
+    uint64_t held;
+    int (*callback)(void *);
+    void *opaque;
+    int status = checkpoint_placement_current(owner);
+
+    if (status) {
+        return status;
+    }
+    if (owner->detached) {
+        return ((owner->saved_state & 7) == 0 ?
+                (!expected_callback && !expected_opaque) :
+                (owner->saved_callback == expected_callback &&
+                 owner->saved_opaque == expected_opaque)) ? -EALREADY : -ESTALE;
+    }
+    state = qatomic_load_acquire(&ram_scheduled.state);
+    callback = qatomic_read(&ram_scheduled.callback);
+    opaque = qatomic_read(&ram_scheduled.opaque);
+    if ((state & 7) == 2) {
+        if (!expected_callback || callback != expected_callback ||
+            opaque != expected_opaque) {
+            return -ESTALE;
+        }
+        held = (state & ~UINT64_C(7)) | RAM_SCHEDULED_CHECKPOINT_QUEUED;
+    } else if ((state & 7) == 0) {
+        if (expected_callback || expected_opaque) {
+            return -ESTALE;
+        }
+        held = state | RAM_SCHEDULED_CHECKPOINT_EMPTY;
+    } else {
+        return -EINPROGRESS;
+    }
+    if (qatomic_cmpxchg(&ram_scheduled.state, state, held) != state) {
+        return -EINPROGRESS;
+    }
+    owner->saved_state = state;
+    owner->saved_callback = callback;
+    owner->saved_opaque = opaque;
+    owner->saved_cancellation_fd = owner->cancellation_fd;
+    owner->detached = true;
+    if (qatomic_read(&ram_scheduled.callback) != callback ||
+        qatomic_read(&ram_scheduled.opaque) != opaque) {
+        return checkpoint_placement_fail(owner, -ESTALE);
+    }
+    return 0;
+}
+
+int qemu_crucible_checkpoint_placement_observe_v1(
+    QemuCrucibleCheckpointPlacementOwner *owner,
+    uint64_t *accepted_generation, uint32_t *held_kind)
+{
+    uint64_t held;
+    int status = checkpoint_placement_current(owner);
+
+    if (status) {
+        return status;
+    }
+    if (!accepted_generation || !held_kind || !owner->detached) {
+        return -EPERM;
+    }
+    held = (owner->saved_state & ~UINT64_C(7)) |
+        ((owner->saved_state & 7) == 2 ? RAM_SCHEDULED_CHECKPOINT_QUEUED :
+                                       RAM_SCHEDULED_CHECKPOINT_EMPTY);
+    if (((owner->saved_state & 7) != 0 && (owner->saved_state & 7) != 2) ||
+        qatomic_load_acquire(&ram_scheduled.state) != held ||
+        qatomic_read(&ram_scheduled.callback) != owner->saved_callback ||
+        qatomic_read(&ram_scheduled.opaque) != owner->saved_opaque ||
+        owner->cancellation_fd != owner->saved_cancellation_fd) {
+        return checkpoint_placement_fail(owner, -ESTALE);
+    }
+    *accepted_generation = owner->saved_state & ~UINT64_C(7);
+    *held_kind = (owner->saved_state & 7) == 2 ?
+        QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PLACEMENT_QUEUED :
+        QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PLACEMENT_EMPTY;
+    return 0;
+}
+
+int qemu_crucible_checkpoint_placement_restore_v1(
+    QemuCrucibleCheckpointPlacementOwner *owner)
+{
+    uint64_t held;
+    int status = checkpoint_placement_current(owner);
+
+    if (status) {
+        return status;
+    }
+    if (!owner->detached) {
+        return -EALREADY;
+    }
+    if ((owner->saved_state & 7) != 0 && (owner->saved_state & 7) != 2) {
+        return checkpoint_placement_fail(owner, -ESTALE);
+    }
+
+    held = (owner->saved_state & ~UINT64_C(7)) |
+        ((owner->saved_state & 7) == 2 ? RAM_SCHEDULED_CHECKPOINT_QUEUED :
+                                       RAM_SCHEDULED_CHECKPOINT_EMPTY);
+    if (qatomic_load_acquire(&ram_scheduled.state) != held ||
+        qatomic_read(&ram_scheduled.callback) != owner->saved_callback ||
+        qatomic_read(&ram_scheduled.opaque) != owner->saved_opaque ||
+        owner->cancellation_fd != owner->saved_cancellation_fd) {
+        return checkpoint_placement_fail(owner, -ESTALE);
+    }
+
+    /* The genuine transaction must establish original final acceptance and
+     * pager/I-O/alias disposition before entering this local reopening cut.
+     * This primitive neither dispatches those callbacks nor claims readiness.
+     */
+    if ((owner->saved_state & 7) == 2) {
+        status = checkpoint_placement_notify();
+        if (status) {
+            owner->post_status = status;
+            return checkpoint_placement_fail(owner, status);
+        }
+    }
+    if (qatomic_cmpxchg(&ram_scheduled.state, held, owner->saved_state) != held) {
+        return checkpoint_placement_fail(owner, -ESTALE);
+    }
+
+    owner->detached = false;
+    return 0;
+}
+
+int qemu_crucible_checkpoint_placement_restored_current_v1(
+    QemuCrucibleCheckpointPlacementOwner *owner,
+    QemuCrucibleCheckpointHeldTransaction *transaction,
+    uint64_t accepted_generation, uint32_t held_kind,
+    int (*expected_callback)(void *), void *expected_opaque)
+{
+    uint32_t saved_kind;
+    int status;
+
+    if (owner != &checkpoint_placement_owner ||
+        !qatomic_load_acquire(&owner->published) ||
+        owner->process_id != getpid() ||
+        owner->owner_thread_id != qemu_get_thread_id() ||
+        owner->transaction != transaction) {
+        return -EPERM;
+    }
+    status = qemu_crucible_checkpoint_transaction_retirement_current(transaction);
+    if (status) {
+        return status;
+    }
+    if (owner->detached || owner->cancellation_fd < 0 ||
+        owner->cancellation_fd != owner->saved_cancellation_fd ||
+        !owner->stopped_generation || !runstate_check(RUN_STATE_PAUSED) ||
+        !qemu_plugin_crucible_vmstop_quiesced() ||
+        qemu_plugin_crucible_vmstop_cold_origin() ||
+        qemu_plugin_crucible_vmstop_generation() != owner->stopped_generation) {
+        return -ESTALE;
+    }
+    if ((owner->saved_state & 7) == 2) {
+        saved_kind = QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PLACEMENT_QUEUED;
+        if (!expected_callback || owner->saved_callback != expected_callback ||
+            owner->saved_opaque != expected_opaque) {
+            return -ESTALE;
+        }
+    } else if ((owner->saved_state & 7) == 0) {
+        saved_kind = QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PLACEMENT_EMPTY;
+        if (expected_callback || expected_opaque) {
+            return -ESTALE;
+        }
+    } else {
+        return -ESTALE;
+    }
+    if (held_kind != saved_kind ||
+        accepted_generation != (owner->saved_state & ~UINT64_C(7)) ||
+        qatomic_load_acquire(&ram_scheduled.state) != owner->saved_state ||
+        qatomic_read(&ram_scheduled.callback) != owner->saved_callback ||
+        qatomic_read(&ram_scheduled.opaque) != owner->saved_opaque) {
+        return -ESTALE;
+    }
+    return 0;
+}
+
+static void crucible_ram_execute_scheduled(void)
+{
+    uint64_t state = qatomic_read(&ram_scheduled.state);
+    uint64_t generation = state & ~UINT64_C(7);
+
+    if (!runstate_check(RUN_STATE_PAUSED) ||
+        !qemu_plugin_crucible_vmstop_quiesced() || (state & 7) != 2 ||
+        qemu_crucible_checkpoint_scheduled_dispatch_check() ||
+        qatomic_cmpxchg(&ram_scheduled.state, state, generation | 3) != state) {
+        return;
+    }
+    g_assert(bql_locked());
+    qatomic_read(&ram_scheduled.callback)(qatomic_read(&ram_scheduled.opaque));
+    if (qatomic_cmpxchg(&ram_scheduled.state, generation | 3, generation) ==
+        (generation | 4)) {
+        /* An accepted amendment arrived after the actor's receipt was taken.
+         * Keep custody and dispatch it again at this same paused boundary. */
+        qatomic_store_release(&ram_scheduled.state, generation | 2);
+        event_notifier_set(&crucible_hot_fork_coordinator.wake);
+    }
+}
+
+/* Host policy owns total latency; native polling only observes cancellation. */
+#define CRUCIBLE_HOT_FORK_PLACEMENT_POLL_MS 10
+
+static void crucible_hot_fork_close_pipe(int descriptors[2])
+{
+    if (descriptors[0] >= 0) {
+        close(descriptors[0]);
+        descriptors[0] = -1;
+    }
+    if (descriptors[1] >= 0) {
+        close(descriptors[1]);
+        descriptors[1] = -1;
+    }
+}
+
+/*
+ * Create the child and place it in the target cgroup.
+ *
+ * clone3(CLONE_INTO_CGROUP) checks the caller's own credentials against the
+ * destination and the common ancestor of source and destination, so an
+ * unprivileged source QEMU cannot use it across a supervisor-owned root.  A
+ * cgroup.procs write is instead authorized with the credentials of the
+ * process that opened the descriptor, so the child migrates itself through
+ * the supervisor-opened descriptor as its first instruction; nothing else
+ * runs in the child before that write completes.
+ *
+ * The parent does not return until the child reports that placement, so a
+ * supervisor that observes the fork's completion observes the child inside
+ * its target cgroup.  Both pipe ends are closed in each process before any
+ * descriptor inventory runs.  In the parent, @placement receives 0 once the
+ * child reported, -ECHILD when the child ended first, or -ECANCELED when its
+ * host owner closes admission; the child is still retained
+ * so its terminal status is reaped through the coordinator.
+ */
+static pid_t crucible_hot_fork_create_child(int cgroup_procs_fd,
+                                           int cancellation_fd, int *placement)
+{
+    int pipe_fds[2] = { -1, -1 };
+    struct pollfd descriptors[2];
+    char byte = 0;
+    ssize_t transferred;
+    int ready;
+    pid_t child;
+    pid_t source_parent = getpid();
+
+    int birth_status = qemu_crucible_process_birth_check();
+
+    if (birth_status) {
+        *placement = birth_status;
+        errno = -birth_status;
+        return -1;
+    }
+    *placement = 0;
+    if (pipe2(pipe_fds, O_CLOEXEC) < 0) {
+        return -1;
+    }
+    child = fork();
+    if (child == 0) {
+        close(pipe_fds[0]);
+        if (cgroup_procs_fd >= 0) {
+            do {
+                transferred = write(cgroup_procs_fd, "0", 1);
+            } while (transferred < 0 && errno == EINTR);
+            if (transferred != 1) {
+                _exit(EXIT_FAILURE);
+            }
+        }
+        /* Containment precedes fault service and any child reconstruction. */
+        if (prctl(PR_SET_PDEATHSIG, SIGKILL, 0, 0, 0) < 0 ||
+            getppid() != source_parent) {
+            _exit(EXIT_FAILURE);
+        }
+        if (cancellation_fd >= 0) {
+            struct pollfd cancellation = {
+                .fd = cancellation_fd,
+                .events = POLLIN,
+            };
+
+            do {
+                ready = poll(&cancellation, 1, 0);
+            } while (ready < 0 && errno == EINTR);
+            if (ready < 0 || cancellation.revents) {
+                _exit(EXIT_FAILURE);
+            }
+        }
+        do {
+            transferred = write(pipe_fds[1], "1", 1);
+        } while (transferred < 0 && errno == EINTR);
+        close(pipe_fds[1]);
+        if (transferred != 1) {
+            _exit(EXIT_FAILURE);
+        }
+        return 0;
+    }
+    if (child < 0) {
+        int saved_errno = errno;
+
+        crucible_hot_fork_close_pipe(pipe_fds);
+        errno = saved_errno;
+        return -1;
+    }
+
+    close(pipe_fds[1]);
+    pipe_fds[1] = -1;
+    descriptors[0] = (struct pollfd) {
+        .fd = pipe_fds[0],
+        .events = POLLIN,
+    };
+    descriptors[1] = (struct pollfd) {
+        .fd = cancellation_fd,
+        .events = POLLIN,
+    };
+    for (;;) {
+        ready = poll(descriptors, G_N_ELEMENTS(descriptors),
+                     CRUCIBLE_HOT_FORK_PLACEMENT_POLL_MS);
+        if (ready < 0 && errno == EINTR) {
+            continue;
+        }
+        if (ready < 0) {
+            *placement = -errno;
+            break;
+        }
+        if (descriptors[1].revents) {
+            *placement = -ECANCELED;
+            break;
+        }
+        if (!descriptors[0].revents) {
+            continue;
+        }
+        do {
+            transferred = read(pipe_fds[0], &byte, 1);
+        } while (transferred < 0 && errno == EINTR);
+        if (transferred != 1 || byte != '1') {
+            *placement = -ECHILD;
+        }
+        break;
+    }
+    crucible_hot_fork_close_pipe(pipe_fds);
+    return child;
+}
+
+static int crucible_hot_fork_reserve_child_locked(
+    QemuCrucibleHotForkCoordinator *coordinator, uint64_t generation,
+    size_t *slot)
+{
+    size_t available = CRUCIBLE_HOT_FORK_MAX_RETAINED_CHILDREN;
+
+    if (generation == 0 || !slot) {
+        return -EINVAL;
+    }
+    for (size_t index = 0;
+         index < CRUCIBLE_HOT_FORK_MAX_RETAINED_CHILDREN; index++) {
+        QemuCrucibleHotForkRetainedChild *child =
+            &coordinator->children[index];
+
+        if (child->phase != CRUCIBLE_HOT_FORK_CHILD_UNUSED &&
+            child->generation == generation) {
+            return -EEXIST;
+        }
+        if (available == CRUCIBLE_HOT_FORK_MAX_RETAINED_CHILDREN &&
+            child->phase == CRUCIBLE_HOT_FORK_CHILD_UNUSED) {
+            available = index;
+        }
+    }
+    if (available == CRUCIBLE_HOT_FORK_MAX_RETAINED_CHILDREN) {
+        return -ENOSPC;
+    }
+
+    coordinator->children[available] =
+        (QemuCrucibleHotForkRetainedChild) {
+            .generation = generation,
+            .process_id = -1,
+            .phase = CRUCIBLE_HOT_FORK_CHILD_RESERVED,
+        };
+    *slot = available;
+    return 0;
+}
+
+static void crucible_hot_fork_release_reserved_child_locked(
+    QemuCrucibleHotForkCoordinator *coordinator)
+{
+    QemuCrucibleHotForkRetainedChild *child =
+        &coordinator->children[coordinator->child_slot];
+
+    g_assert(child->phase == CRUCIBLE_HOT_FORK_CHILD_RESERVED);
+    *child = (QemuCrucibleHotForkRetainedChild) { 0 };
+}
+
+static void crucible_hot_fork_retain_child(
+    QemuCrucibleHotForkCoordinator *coordinator, pid_t process_id)
+{
+    QemuCrucibleHotForkRetainedChild *child =
+        &coordinator->children[coordinator->child_slot];
+
+    qemu_mutex_lock(&coordinator->lock);
+    g_assert(child->phase == CRUCIBLE_HOT_FORK_CHILD_RESERVED);
+    g_assert(process_id > 0);
+    child->process_id = process_id;
+    child->phase = CRUCIBLE_HOT_FORK_CHILD_RUNNING;
+    qemu_mutex_unlock(&coordinator->lock);
+
+}
+
+static void crucible_hot_fork_complete_parent(
+    int result, pid_t child_pid)
+{
+    QemuCrucibleHotForkCoordinator *coordinator =
+        &crucible_hot_fork_coordinator;
+
+    qemu_mutex_lock(&coordinator->lock);
+    coordinator->result = result;
+    coordinator->child_pid = child_pid;
+    coordinator->executing = false;
+    coordinator->completed = true;
+    qemu_cond_signal(&coordinator->completed_cond);
+    qemu_mutex_unlock(&coordinator->lock);
+}
+
+static void crucible_hot_fork_execute_main_loop_request(void)
+{
+    QemuCrucibleHotForkCoordinator *coordinator =
+        &crucible_hot_fork_coordinator;
+    QemuCrucibleHotForkMainLoopOperation operation;
+    pid_t child_pid;
+    int placement = 0;
+    int parent_result;
+    int ram_result;
+    int result;
+
+    qemu_mutex_lock(&coordinator->lock);
+    if (!coordinator->busy || coordinator->executing ||
+        coordinator->completed) {
+        qemu_mutex_unlock(&coordinator->lock);
+        return;
+    }
+    if (coordinator->ram_operation) {
+        int (*callback)(void *) = coordinator->ram_operation;
+        void *opaque = coordinator->ram_opaque;
+
+        coordinator->executing = true;
+        qemu_mutex_unlock(&coordinator->lock);
+        result = callback(opaque);
+        crucible_hot_fork_complete_parent(result, -1);
+        return;
+    }
+    operation = coordinator->operation;
+    coordinator->executing = true;
+    qemu_mutex_unlock(&coordinator->lock);
+
+    result = qemu_plugin_crucible_ram_lifecycle(
+        QEMU_PLUGIN_CRUCIBLE_RAM_PREPARE_FORK,
+        operation.ram_source_generation);
+    if (result == 0) {
+        result = operation.prepare(operation.opaque);
+    }
+    if (result == 0 && (qatomic_read(&ram_scheduled.state) & 7) != 0) {
+        result = -EBUSY;
+    }
+    if (result != 0) {
+        ram_result = qemu_plugin_crucible_ram_lifecycle(
+            QEMU_PLUGIN_CRUCIBLE_RAM_ABORT_FORK,
+            operation.ram_source_generation);
+        if (ram_result != 0) {
+            result = ram_result;
+        }
+        crucible_hot_fork_complete_parent(result, -1);
+        return;
+    }
+    result = qemu_plugin_crucible_ram_lifecycle(
+        QEMU_PLUGIN_CRUCIBLE_RAM_FINAL_SEAL,
+        operation.ram_source_generation);
+    if (result != 0) {
+        parent_result = operation.parent(-1, operation.opaque);
+        ram_result = parent_result == 0 ?
+            qemu_plugin_crucible_ram_lifecycle(
+                QEMU_PLUGIN_CRUCIBLE_RAM_ABORT_FORK,
+                operation.ram_source_generation) : 0;
+        crucible_hot_fork_complete_parent(
+            parent_result != 0 ? parent_result :
+            ram_result != 0 ? ram_result : result, -1);
+        return;
+    }
+
+    child_pid = crucible_hot_fork_create_child(
+        operation.child_cgroup_procs_fd, operation.child_cancellation_fd,
+        &placement);
+    if (child_pid == 0) {
+        result = operation.child_contract(operation.opaque);
+        if (result != 0) {
+            _exit(QEMU_CRUCIBLE_HOT_FORK_CHILD_CONTRACT_EXIT);
+        }
+        /* No child actor may borrow the parent's main-loop identity. Closing
+         * this descriptor before actor creation also prevents stale FD reuse. */
+        qatomic_store_release(&coordinator->initialized, false);
+        coordinator->child_runtime_pending = true;
+        event_notifier_cleanup(&coordinator->wake);
+        /*
+         * Independent kernel limits are already effective and verified.
+         * No guest RAM may be touched before this operation.  Inherited cold
+         * mappings have no usable child service merely because the parent
+         * retained a userfaultfd.  Bootstrap uses private host memory only.
+         */
+        result = qemu_plugin_crucible_ram_lifecycle(
+            QEMU_PLUGIN_CRUCIBLE_RAM_REBIND_CHILD,
+            operation.ram_source_generation);
+        if (result != 0) {
+            _exit(EXIT_FAILURE);
+        }
+        qemu_crucible_block_seal_child_reset();
+        coordinator->busy = false;
+        coordinator->executing = false;
+        coordinator->completed = false;
+        result = operation.child(operation.opaque);
+        if (result != 0) {
+            _exit(EXIT_FAILURE);
+        }
+        return;
+    }
+
+    if (child_pid < 0) {
+        result = -errno;
+    } else if (placement != 0) {
+        result = placement;
+    }
+    /*
+     * The parent callback releases the runtime transaction that still holds
+     * the registered-mutex guard across fork().  Retaining the child takes
+     * the coordinator's own registered lock, so it must wait for that
+     * release; the child is retained whatever the callback reports.
+     */
+    parent_result = operation.parent(child_pid, operation.opaque);
+    /* Failed disposition retains stopped pager authority for containment. */
+    ram_result = parent_result == 0 ?
+        qemu_plugin_crucible_ram_lifecycle(
+            child_pid > 0 ? QEMU_PLUGIN_CRUCIBLE_RAM_RESUME_PARENT :
+                            QEMU_PLUGIN_CRUCIBLE_RAM_ABORT_FORK,
+            operation.ram_source_generation) : 0;
+    if (parent_result == 0) {
+        parent_result = ram_result;
+    }
+    if (parent_result != 0) {
+        result = parent_result;
+    }
+    if (child_pid > 0) {
+        crucible_hot_fork_retain_child(coordinator, child_pid);
+    }
+    crucible_hot_fork_complete_parent(result, child_pid);
+}
+
+static void crucible_hot_fork_main_loop_poll(Notifier *notifier, void *opaque)
+{
+    QemuCrucibleHotForkCoordinator *coordinator =
+        container_of(notifier, QemuCrucibleHotForkCoordinator, poll_notifier);
+    MainLoopPoll *poll = opaque;
+    GPollFD descriptor;
+    bool pending;
+
+    if (!coordinator->initialized) {
+        return;
+    }
+    descriptor = (GPollFD) {
+        .fd = event_notifier_get_fd(&coordinator->wake),
+        .events = G_IO_IN | G_IO_ERR | G_IO_HUP,
+    };
+    switch (poll->state) {
+    case MAIN_LOOP_POLL_FILL:
+        coordinator->poll_index = poll->pollfds->len;
+        g_array_append_val(poll->pollfds, descriptor);
+        qemu_mutex_lock(&coordinator->lock);
+        if (coordinator->busy && !coordinator->completed) {
+            poll->timeout = 0;
+        }
+        qemu_mutex_unlock(&coordinator->lock);
+        break;
+    case MAIN_LOOP_POLL_OK:
+    case MAIN_LOOP_POLL_ERR:
+        descriptor = g_array_index(
+            poll->pollfds, GPollFD, coordinator->poll_index);
+        if (descriptor.revents & (G_IO_IN | G_IO_ERR | G_IO_HUP)) {
+            event_notifier_test_and_clear(&coordinator->wake);
+            crucible_hot_fork_execute_main_loop_request();
+        }
+        crucible_ram_execute_scheduled();
+        /* Original requests and scheduled placement have priority. The
+         * diagnostic never consumes their mailbox or runs inside AIO dispatch. */
+        qemu_mutex_lock(&coordinator->lock);
+        pending = coordinator->busy || coordinator->executing ||
+            coordinator->child_runtime_pending || coordinator->ram_operation;
+        qemu_mutex_unlock(&coordinator->lock);
+        if (!pending && !(qatomic_read(&ram_scheduled.state) & 7)) {
+            qemu_crucible_ram_diagnostic_paused_owner();
+        }
+        break;
+    case MAIN_LOOP_POLL_DONE:
+        break;
+    default:
+        g_assert_not_reached();
+    }
+}
+
+void qemu_crucible_hot_fork_main_loop_coordinator_init(Error **errp)
+{
+    QemuCrucibleHotForkCoordinator *coordinator =
+        &crucible_hot_fork_coordinator;
+    int result;
+
+    if (coordinator->initialized) {
+        error_setg(errp, "Crucible hot-fork coordinator already initialized");
+        return;
+    }
+
+    qemu_mutex_init(&coordinator->lock);
+    qemu_cond_init(&coordinator->completed_cond);
+    result = event_notifier_init(&coordinator->wake, 0);
+    if (result != 0) {
+        qemu_cond_destroy(&coordinator->completed_cond);
+        qemu_mutex_destroy(&coordinator->lock);
+        error_setg_errno(errp, -result,
+                         "Could not create Crucible hot-fork coordinator");
+        return;
+    }
+
+    coordinator->main_thread_id = qemu_get_thread_id();
+    coordinator->process_id = getpid();
+    coordinator->poll_notifier.notify = crucible_hot_fork_main_loop_poll;
+    coordinator->initialized = true;
+    main_loop_poll_add_notifier(&coordinator->poll_notifier);
+}
+
+int qemu_crucible_hot_fork_main_loop_coordinator_rebind_child(void)
+{
+    QemuCrucibleHotForkCoordinator *coordinator = &crucible_hot_fork_coordinator;
+    int result;
+
+    if (coordinator->initialized || !coordinator->child_runtime_pending ||
+        coordinator->process_id == getpid() ||
+        (qatomic_read(&ram_scheduled.state) & 7) != 0) {
+        return -EBUSY;
+    }
+    result = event_notifier_init(&coordinator->wake, 0);
+    if (result != 0) {
+        return result;
+    }
+    /* Runtime reconstruction already reset the registered mutex. A copied
+     * condition has vanished parent waiters, so initialize only that object.
+     * The inherited poll notifier stays linked exactly once. */
+    qemu_cond_init(&coordinator->completed_cond);
+    coordinator->main_thread_id = qemu_get_thread_id();
+    coordinator->process_id = getpid();
+    coordinator->operation = (QemuCrucibleHotForkMainLoopOperation) { 0 };
+    coordinator->ram_operation = NULL;
+    coordinator->ram_opaque = NULL;
+    coordinator->busy = false;
+    coordinator->executing = false;
+    coordinator->completed = false;
+    coordinator->child_pid = -1;
+    memset(coordinator->children, 0, sizeof(coordinator->children));
+    qatomic_set(&ram_scheduled.callback, NULL);
+    qatomic_set(&ram_scheduled.opaque, NULL);
+    qatomic_store_release(&coordinator->initialized, true);
+    return 0;
+}
+
+int qemu_crucible_hot_fork_main_loop_coordinator_child_ready(void)
+{
+    QemuCrucibleHotForkCoordinator *coordinator = &crucible_hot_fork_coordinator;
+
+    if (!coordinator->initialized || !coordinator->child_runtime_pending ||
+        coordinator->process_id != getpid() ||
+        coordinator->main_thread_id != qemu_get_thread_id() ||
+        fcntl(event_notifier_get_fd(&coordinator->wake), F_GETFD) < 0) {
+        return -ESTALE;
+    }
+    qatomic_store_release(&coordinator->child_runtime_pending, false);
+    return 0;
+}
+
+int qemu_plugin_crucible_ram_child_runtime_ready_v1(void)
+{
+    QemuCrucibleHotForkCoordinator *coordinator = &crucible_hot_fork_coordinator;
+
+    return qatomic_load_acquire(&coordinator->initialized) &&
+        coordinator->process_id == getpid() &&
+        !qatomic_load_acquire(&coordinator->child_runtime_pending);
+}
+
+uint64_t qemu_crucible_ram_main_loop_metadata_bytes(void)
+{
+    return sizeof(crucible_hot_fork_coordinator) + sizeof(ram_scheduled) +
+        sizeof(checkpoint_placement_owner);
+}
+
+int qemu_crucible_ram_schedule_on_main_loop(int (*callback)(void *),
+                                            void *opaque)
+{
+    QemuCrucibleHotForkCoordinator *coordinator = &crucible_hot_fork_coordinator;
+    uint64_t state;
+    uint64_t next;
+    int result;
+
+    if (!callback || !qemu_plugin_crucible_ram_child_runtime_ready_v1()) {
+        return -EINVAL;
+    }
+    for (;;) {
+        state = qatomic_read(&ram_scheduled.state);
+        if ((state & 7) == RAM_SCHEDULED_CHECKPOINT_QUEUED ||
+            (state & 7) == RAM_SCHEDULED_CHECKPOINT_EMPTY) {
+            return -EBUSY;
+        }
+        if ((state & 7) == 0) {
+            if (state > UINT64_MAX - 8) {
+                return -EOVERFLOW;
+            }
+            next = state + 8;
+            if (qatomic_cmpxchg(&ram_scheduled.state, state, next | 1) != state) {
+                continue;
+            }
+            qatomic_set(&ram_scheduled.callback, callback);
+            qatomic_set(&ram_scheduled.opaque, opaque);
+            qatomic_store_release(&ram_scheduled.state, next | 2);
+            result = event_notifier_set(&coordinator->wake);
+            if (result && qatomic_cmpxchg(&ram_scheduled.state, next | 2, next) ==
+                (next | 2)) {
+                return result;
+            }
+            return 0;
+        }
+        if ((state & 7) == 1 ||
+            qatomic_read(&ram_scheduled.callback) != callback ||
+            qatomic_read(&ram_scheduled.opaque) != opaque) {
+            return -EBUSY;
+        }
+        next = (state & 7) == 3 ? (state & ~UINT64_C(7)) | 4 : state;
+        if (qatomic_cmpxchg(&ram_scheduled.state, state, next) == state) {
+            return 0;
+        }
+    }
+}
+
+int qemu_crucible_ram_cancel_scheduled_main_loop(void)
+{
+    uint64_t state;
+
+    for (;;) {
+        state = qatomic_read(&ram_scheduled.state);
+        if ((state & 7) == 0) {
+            return 0;
+        }
+        if ((state & 7) != 2) {
+            return -EBUSY;
+        }
+        if (qatomic_cmpxchg(&ram_scheduled.state, state,
+                          state & ~UINT64_C(7)) == state) {
+            return 0;
+        }
+    }
+}
+
+int qemu_crucible_ram_run_on_main_loop(int (*callback)(void *), void *opaque)
+{
+    QemuCrucibleHotForkCoordinator *coordinator = &crucible_hot_fork_coordinator;
+    bool restore_bql = bql_locked();
+    int result;
+
+    if (!callback || !qemu_plugin_crucible_ram_child_runtime_ready_v1()) {
+        return -EINVAL;
+    }
+    if (coordinator->main_thread_id == qemu_get_thread_id()) {
+        if (!restore_bql) {
+            bql_lock();
+        }
+        result = callback(opaque);
+        if (!restore_bql) {
+            bql_unlock();
+        }
+        return result;
+    }
+    /* The main loop needs BQL to drain actual native borrowers. */
+    if (restore_bql) {
+        bql_unlock();
+    }
+    qemu_mutex_lock(&coordinator->lock);
+    if (coordinator->busy) {
+        result = -EBUSY;
+        goto out;
+    }
+    coordinator->ram_operation = callback;
+    coordinator->ram_opaque = opaque;
+    coordinator->result = -EINPROGRESS;
+    coordinator->child_pid = -1;
+    coordinator->busy = true;
+    coordinator->executing = false;
+    coordinator->completed = false;
+    result = event_notifier_set(&coordinator->wake);
+    if (result == 0) {
+        /* The opaque state remains lent until actual main-loop completion. */
+        while (!coordinator->completed) {
+            qemu_cond_wait(&coordinator->completed_cond, &coordinator->lock);
+        }
+        result = coordinator->result;
+    }
+    coordinator->ram_operation = NULL;
+    coordinator->ram_opaque = NULL;
+    coordinator->busy = false;
+    coordinator->completed = false;
+out:
+    qemu_mutex_unlock(&coordinator->lock);
+    if (restore_bql) {
+        bql_lock();
+    }
+    return result;
+}
+
+int qemu_crucible_hot_fork_main_loop_fork(
+    const QemuCrucibleHotForkMainLoopOperation *operation,
+    uint64_t child_process_contract_generation,
+    pid_t *child_pid)
+{
+    QemuCrucibleHotForkCoordinator *coordinator =
+        &crucible_hot_fork_coordinator;
+    int result;
+
+    result = qemu_crucible_process_birth_check();
+    if (result) {
+        return result;
+    }
+
+    if (qemu_plugin_crucible_startup_source_retained()) {
+        return -EPERM;
+    }
+
+    if (!operation || !operation->prepare || !operation->parent ||
+        !operation->child_contract || !operation->child || !child_pid ||
+        !qemu_plugin_crucible_ram_child_runtime_ready_v1() ||
+        coordinator->main_thread_id == qemu_get_thread_id()) {
+        return -EINVAL;
+    }
+    *child_pid = -1;
+    if ((qatomic_read(&ram_scheduled.state) & 7) != 0) {
+        return -EBUSY;
+    }
+
+    qemu_mutex_lock(&coordinator->lock);
+    if (coordinator->busy) {
+        qemu_mutex_unlock(&coordinator->lock);
+        return -EBUSY;
+    }
+    result = crucible_hot_fork_reserve_child_locked(
+        coordinator, child_process_contract_generation,
+        &coordinator->child_slot);
+    if (result != 0) {
+        qemu_mutex_unlock(&coordinator->lock);
+        return result;
+    }
+    coordinator->operation = *operation;
+    coordinator->result = -EINPROGRESS;
+    coordinator->child_pid = -1;
+    coordinator->busy = true;
+    coordinator->executing = false;
+    coordinator->completed = false;
+    result = event_notifier_set(&coordinator->wake);
+    if (result != 0) {
+        coordinator->operation =
+            (QemuCrucibleHotForkMainLoopOperation) { 0 };
+        coordinator->busy = false;
+        crucible_hot_fork_release_reserved_child_locked(coordinator);
+        qemu_mutex_unlock(&coordinator->lock);
+        return result;
+    }
+    while (!coordinator->completed) {
+        qemu_cond_wait(&coordinator->completed_cond, &coordinator->lock);
+    }
+
+    result = coordinator->result;
+    *child_pid = coordinator->child_pid;
+    if (*child_pid <= 0) {
+        crucible_hot_fork_release_reserved_child_locked(coordinator);
+    }
+    coordinator->operation =
+        (QemuCrucibleHotForkMainLoopOperation) { 0 };
+    coordinator->busy = false;
+    coordinator->completed = false;
+    qemu_mutex_unlock(&coordinator->lock);
+    return result;
+}
+
+int qemu_crucible_hot_fork_child_process_operate(
+    bool has_schema_version, uint32_t schema_version,
+    QemuCrucibleHotForkChildProcessAction action, uint64_t generation,
+    QemuCrucibleHotForkChildProcessState *state)
+{
+    if (!has_schema_version || schema_version != 2) {
+        return -EPROTONOSUPPORT;
+    }
+    switch (action) {
+    case QEMU_CRUCIBLE_HOT_FORK_CHILD_PROCESS_QUERY:
+        return qemu_crucible_hot_fork_child_process_query(generation, state);
+    case QEMU_CRUCIBLE_HOT_FORK_CHILD_PROCESS_RELEASE:
+        return qemu_crucible_hot_fork_child_process_release(generation,
+                                                            state);
+    default:
+        return -EINVAL;
+    }
+}
+
+static int crucible_hot_fork_child_process_state_locked(
+    QemuCrucibleHotForkCoordinator *coordinator, uint64_t generation,
+    QemuCrucibleHotForkChildProcessState *state, size_t *slot)
+{
+    if (generation == 0 || !state) {
+        return -EINVAL;
+    }
+    for (size_t index = 0;
+         index < CRUCIBLE_HOT_FORK_MAX_RETAINED_CHILDREN; index++) {
+        QemuCrucibleHotForkRetainedChild *child =
+            &coordinator->children[index];
+
+        if (child->phase == CRUCIBLE_HOT_FORK_CHILD_UNUSED ||
+            child->phase == CRUCIBLE_HOT_FORK_CHILD_RESERVED ||
+            child->generation != generation) {
+            continue;
+        }
+        if (child->phase == CRUCIBLE_HOT_FORK_CHILD_RUNNING) {
+            pid_t waited;
+
+            do {
+                waited = waitpid(child->process_id, &child->wait_status,
+                                 WNOHANG);
+            } while (waited < 0 && errno == EINTR);
+            if (waited < 0) {
+                return -errno;
+            }
+            if (waited == child->process_id) {
+                child->phase = CRUCIBLE_HOT_FORK_CHILD_REAPED;
+            } else if (waited != 0) {
+                return -EPROTO;
+            }
+        }
+        *state = (QemuCrucibleHotForkChildProcessState) {
+            .generation = child->generation,
+            .process_id = child->process_id,
+            .phase = QEMU_CRUCIBLE_HOT_FORK_CHILD_RUNNING,
+            .retained = true,
+        };
+        if (child->phase == CRUCIBLE_HOT_FORK_CHILD_REAPED) {
+            if (WIFEXITED(child->wait_status)) {
+                state->phase = QEMU_CRUCIBLE_HOT_FORK_CHILD_EXITED;
+                state->status = WEXITSTATUS(child->wait_status);
+            } else if (WIFSIGNALED(child->wait_status)) {
+                state->phase = QEMU_CRUCIBLE_HOT_FORK_CHILD_SIGNALED;
+                state->status = WTERMSIG(child->wait_status);
+            } else {
+                return -EPROTO;
+            }
+        }
+        if (slot) {
+            *slot = index;
+        }
+        return 0;
+    }
+    return -ENOENT;
+}
+
+int qemu_crucible_hot_fork_child_process_query(
+    uint64_t generation, QemuCrucibleHotForkChildProcessState *state)
+{
+    QemuCrucibleHotForkCoordinator *coordinator =
+        &crucible_hot_fork_coordinator;
+    int result;
+
+    if (!coordinator->initialized) {
+        return -EINVAL;
+    }
+    qemu_mutex_lock(&coordinator->lock);
+    result = crucible_hot_fork_child_process_state_locked(
+        coordinator, generation, state, NULL);
+    qemu_mutex_unlock(&coordinator->lock);
+    return result;
+}
+
+int qemu_crucible_hot_fork_child_process_release(
+    uint64_t generation, QemuCrucibleHotForkChildProcessState *state)
+{
+    QemuCrucibleHotForkCoordinator *coordinator =
+        &crucible_hot_fork_coordinator;
+    size_t slot = 0;
+    int result;
+
+    if (!coordinator->initialized) {
+        return -EINVAL;
+    }
+    qemu_mutex_lock(&coordinator->lock);
+    result = crucible_hot_fork_child_process_state_locked(
+        coordinator, generation, state, &slot);
+    if (result == 0 &&
+        coordinator->children[slot].phase !=
+            CRUCIBLE_HOT_FORK_CHILD_REAPED) {
+        result = -EBUSY;
+    }
+    if (result == 0) {
+        coordinator->children[slot] =
+            (QemuCrucibleHotForkRetainedChild) { 0 };
+        state->retained = false;
+    }
+    qemu_mutex_unlock(&coordinator->lock);
+    return result;
+}
diff --git a/system/crucible-hot-fork-plugin-child.c b/system/crucible-hot-fork-plugin-child.c
