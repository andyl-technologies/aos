+    if [name for name, _, _, _ in bodies] != ["real", "variant", "variant", "qualified"]:
+        raise ValueError("function extraction lost lexical/conditional identity")
+    if identifiers(bodies[0][3]) & {"ghost", "phantom"}:
+        raise ValueError("literal/comment text became a function dependency")
+    if not {"dependency", "return"} <= identifiers(bodies[0][3]):
+        raise ValueError("function extraction lost an actual dependency")
+    if "first" not in bodies[1][3] or "second" not in bodies[2][3]:
