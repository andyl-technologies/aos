+/*
+ * Retained immutable selected installing artifact, executable preinit only
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+static uint32_t preexec_artifact_rotate(uint32_t value, unsigned count)
+{
+    return (value >> count) | (value << (32 - count));
+}
+
+/* SHA-256 uses fixed owner storage. No crypto provider, lazy binding, heap or
+ * constructor state is required before the selected executable's init cut.
+ */
+static void preexec_artifact_hash_block(const uint8_t bytes[64])
+{
+    static const uint32_t round[64] = {
+        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5,
+        0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
+        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3,
+        0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
+        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc,
+        0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
+        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7,
+        0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
+        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13,
+        0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
+        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3,
+        0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
+        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5,
+        0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
+        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208,
+        0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2,
+    };
+    uint32_t schedule[64];
+    uint32_t work[8];
+
+    for (size_t index = 0; index < 16; index++) {
+        schedule[index] = preexec_setup_be32(bytes + index * 4);
+    }
+    for (size_t index = 16; index < 64; index++) {
+        uint32_t first = schedule[index - 15];
+        uint32_t second = schedule[index - 2];
+        uint32_t sigma0 = preexec_artifact_rotate(first, 7) ^
+            preexec_artifact_rotate(first, 18) ^ (first >> 3);
+        uint32_t sigma1 = preexec_artifact_rotate(second, 17) ^
+            preexec_artifact_rotate(second, 19) ^ (second >> 10);
+
+        schedule[index] = schedule[index - 16] + sigma0 +
+            schedule[index - 7] + sigma1;
+    }
+    for (size_t index = 0; index < 8; index++) {
+        work[index] = preexec_setup_owner.artifact_hash_state[index];
+    }
+    for (size_t index = 0; index < 64; index++) {
+        uint32_t sigma1 = preexec_artifact_rotate(work[4], 6) ^
+            preexec_artifact_rotate(work[4], 11) ^
+            preexec_artifact_rotate(work[4], 25);
+        uint32_t choose = (work[4] & work[5]) ^ (~work[4] & work[6]);
+        uint32_t first = work[7] + sigma1 + choose + round[index] + schedule[index];
+        uint32_t sigma0 = preexec_artifact_rotate(work[0], 2) ^
+            preexec_artifact_rotate(work[0], 13) ^
+            preexec_artifact_rotate(work[0], 22);
+        uint32_t majority = (work[0] & work[1]) ^ (work[0] & work[2]) ^
+            (work[1] & work[2]);
+        uint32_t second = sigma0 + majority;
+
+        for (size_t column = 7; column > 0; column--) {
+            work[column] = work[column - 1];
+        }
+        work[4] += first;
+        work[0] = first + second;
+    }
+    for (size_t index = 0; index < 8; index++) {
+        preexec_setup_owner.artifact_hash_state[index] += work[index];
+    }
+}
+
+static void preexec_artifact_hash_begin(void)
+{
+    static const uint32_t initial[8] = {
+        0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
+        0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19,
+    };
+
+    preexec_setup_copy(preexec_setup_owner.artifact_hash_state, initial,
+                       sizeof(initial));
+    preexec_setup_owner.artifact_hash_bytes = 0;
+    preexec_setup_owner.artifact_hash_used = 0;
+}
+
+static int preexec_artifact_hash_update(const uint8_t *bytes, size_t count)
+{
+    QemuCruciblePreexecSetupOwner *owner = &preexec_setup_owner;
+
+    if (count > UINT64_MAX / 8 - owner->artifact_hash_bytes) {
+        return -EOVERFLOW;
+    }
+    owner->artifact_hash_bytes += count;
+    while (count) {
+        size_t available = 64 - owner->artifact_hash_used;
+        size_t take = count < available ? count : available;
+
+        preexec_setup_copy(owner->artifact_hash_block + owner->artifact_hash_used,
+                           bytes, take);
+        owner->artifact_hash_used += take;
+        bytes += take;
+        count -= take;
+        if (owner->artifact_hash_used == 64) {
+            preexec_artifact_hash_block(owner->artifact_hash_block);
+            owner->artifact_hash_used = 0;
+        }
+    }
+    return 0;
+}
+
+static void preexec_artifact_hash_end(uint8_t digest[32])
+{
+    QemuCruciblePreexecSetupOwner *owner = &preexec_setup_owner;
+    uint64_t bits = owner->artifact_hash_bytes * 8;
+
+    owner->artifact_hash_block[owner->artifact_hash_used++] = 0x80;
+    if (owner->artifact_hash_used > 56) {
+        while (owner->artifact_hash_used < 64) {
+            owner->artifact_hash_block[owner->artifact_hash_used++] = 0;
+        }
+        preexec_artifact_hash_block(owner->artifact_hash_block);
+        owner->artifact_hash_used = 0;
+    }
+    while (owner->artifact_hash_used < 56) {
+        owner->artifact_hash_block[owner->artifact_hash_used++] = 0;
+    }
+    for (size_t index = 0; index < 8; index++) {
+        owner->artifact_hash_block[56 + index] = bits >> (56 - index * 8);
+    }
+    preexec_artifact_hash_block(owner->artifact_hash_block);
+    for (size_t index = 0; index < 8; index++) {
+        uint32_t value = owner->artifact_hash_state[index];
+
+        for (size_t byte = 0; byte < 4; byte++) {
+            digest[index * 4 + byte] = value >> (24 - byte * 8);
+        }
+    }
+}
+
+static uint16_t preexec_artifact_le16(const uint8_t *bytes)
+{
+    return bytes[0] | ((uint16_t)bytes[1] << 8);
+}
+
+static uint32_t preexec_artifact_le32(const uint8_t *bytes)
+{
+    return bytes[0] | ((uint32_t)bytes[1] << 8) |
+        ((uint32_t)bytes[2] << 16) | ((uint32_t)bytes[3] << 24);
+}
+
+static uint64_t preexec_artifact_le64(const uint8_t *bytes)
+{
+    return preexec_artifact_le32(bytes) |
+        ((uint64_t)preexec_artifact_le32(bytes + 4) << 32);
+}
+
+static bool preexec_artifact_range(uint64_t offset, uint64_t bytes)
+{
+    return offset <= preexec_setup_owner.artifact_before.st_size &&
+        bytes <= (uint64_t)preexec_setup_owner.artifact_before.st_size - offset;
+}
+
+static int preexec_artifact_string(uint64_t table, uint64_t table_bytes,
+                                    uint64_t offset, char *out, size_t capacity)
+{
+    if (offset >= table_bytes) {
+        return -EINVAL;
+    }
+    for (size_t index = 0; index < capacity; index++) {
+        int status;
+
+        if (index >= table_bytes - offset) {
+            return -EINVAL;
+        }
+        status = preexec_setup_pread(preexec_setup_owner.artifact_fd,
+            (uint8_t *)out + index, 1, table + offset + index);
+        if (status) {
+            return status;
+        }
+        if (!out[index]) {
+            return 0;
+        }
+    }
+    return -E2BIG;
+}
+
+static int preexec_artifact_dynamic(uint64_t offset, uint64_t bytes,
+                                     uint64_t strings, uint64_t string_bytes)
+{
+    bool terminated = false;
+
+    if (bytes % 16 || !preexec_artifact_range(offset, bytes) ||
+        !preexec_artifact_range(strings, string_bytes)) {
+        return -EINVAL;
+    }
+    for (uint64_t cursor = 0; cursor < bytes; cursor += 16) {
+        uint8_t row[16];
+        char text[4096];
+        uint64_t tag;
+        int status = preexec_setup_pread(preexec_setup_owner.artifact_fd,
+                                         row, sizeof(row), offset + cursor);
+
+        if (status) {
+            return status;
+        }
+        tag = preexec_artifact_le64(row);
+        if (tag == DT_NULL) {
+            terminated = true;
+            break;
+        }
+        if (tag != DT_RPATH && tag != DT_RUNPATH && tag != DT_NEEDED) {
+            continue;
+        }
+        status = preexec_artifact_string(strings, string_bytes,
+            preexec_artifact_le64(row + 8), text, sizeof(text));
+        if (status) {
+            return status;
+        }
+        for (size_t index = 0; text[index]; index++) {
+            /* The retained FD alias changes this object's origin directory.
+             * Refuse only selected origin-relative dependencies; absolute and
+             * ordinary loader search paths retain their existing resolution.
+             */
+            if (text[index] == '$' &&
+                ((preexec_setup_string_length(text + index, sizeof(text) - index) >= 7 &&
+                  !preexec_setup_compare(text + index, "$ORIGIN", 7)) ||
+                 (preexec_setup_string_length(text + index, sizeof(text) - index) >= 9 &&
+                  !preexec_setup_compare(text + index, "${ORIGIN}", 9)))) {
+                return -ENOTSUP;
+            }
+        }
+    }
+    return terminated ? 0 : -EINVAL;
+}
+
+static int preexec_artifact_readonly_load(const uint8_t header[64],
+                                          const uint8_t section[64])
+{
+    uint64_t table = preexec_artifact_le64(header + 32);
+    uint64_t offset = preexec_artifact_le64(section + 24);
+    uint64_t address = preexec_artifact_le64(section + 16);
+    uint64_t bytes = preexec_artifact_le64(section + 32);
+    uint16_t count = preexec_artifact_le16(header + 56);
+    unsigned matches = 0;
+
+    if (!count || count == PN_XNUM ||
+        preexec_artifact_le16(header + 54) != 56 ||
+        !preexec_artifact_range(table, (uint64_t)count * 56)) {
+        return -EINVAL;
+    }
+    for (uint16_t index = 0; index < count; index++) {
+        uint8_t program[56];
+        uint64_t file_offset;
+        uint64_t virtual_address;
+        uint64_t file_bytes;
+        uint64_t memory_bytes;
+        uint64_t displacement;
+        uint32_t flags;
+        int status = preexec_setup_pread(preexec_setup_owner.artifact_fd,
+            program, sizeof(program), table + (uint64_t)index * 56);
+
+        if (status) {
+            return status;
+        }
+        if (preexec_artifact_le32(program) != PT_LOAD) {
+            continue;
+        }
+        flags = preexec_artifact_le32(program + 4);
+        file_offset = preexec_artifact_le64(program + 8);
+        virtual_address = preexec_artifact_le64(program + 16);
+        file_bytes = preexec_artifact_le64(program + 32);
+        memory_bytes = preexec_artifact_le64(program + 40);
+        if (file_bytes > memory_bytes ||
+            !preexec_artifact_range(file_offset, file_bytes) ||
+            offset < file_offset) {
+            continue;
+        }
+        displacement = offset - file_offset;
+        if (displacement > file_bytes || bytes > file_bytes - displacement) {
+            continue;
+        }
+        if (!(flags & PF_R) || (flags & PF_W) ||
+            displacement > UINT64_MAX - virtual_address ||
+            virtual_address + displacement != address) {
+            return -EINVAL;
+        }
+        matches++;
+    }
+    return matches == 1 ? 0 : -EINVAL;
+}
+
+static int preexec_artifact_elf(void)
+{
+    QemuCruciblePreexecSetupOwner *owner = &preexec_setup_owner;
+    uint8_t header[64];
+    uint8_t string_section[64];
+    uint64_t sections;
+    uint64_t strings;
+    uint64_t string_bytes;
+    uint16_t count;
+    uint16_t string_index;
+    uint16_t machine;
+    unsigned matched = 0;
+    int status = preexec_setup_pread(owner->artifact_fd, header, sizeof(header), 0);
+
+    if (status) {
+        return status;
+    }
+    if (preexec_setup_compare(header, ELFMAG, SELFMAG) ||
+        header[EI_CLASS] != ELFCLASS64 || header[EI_DATA] != ELFDATA2LSB ||
+        header[EI_VERSION] != EV_CURRENT ||
+        preexec_artifact_le16(header + 16) != ET_DYN ||
+        preexec_artifact_le32(header + 20) != EV_CURRENT ||
+        preexec_artifact_le16(header + 52) != 64 ||
+        preexec_artifact_le16(header + 58) != 64) {
+        return -EPROTONOSUPPORT;
+    }
+    machine = preexec_artifact_le16(header + 18);
+    if (machine != EM_X86_64 || machine != owner->plan.purpose.artifact_machine) {
+        return -ESTALE;
+    }
+    sections = preexec_artifact_le64(header + 40);
+    count = preexec_artifact_le16(header + 60);
+    string_index = preexec_artifact_le16(header + 62);
+    /* Both values are decoded u16 fields. A zero extended section count and
+     * the extended string-index sentinel 0xffff are already excluded by the
+     * direct-table bounds below; no unsupported ELF extension is accepted. */
+    if (!count || string_index >= count ||
+        !preexec_artifact_range(sections, (uint64_t)count * 64)) {
+        return -EINVAL;
+    }
+    status = preexec_setup_pread(owner->artifact_fd, string_section,
+                                sizeof(string_section), sections + string_index * 64);
+    if (status) {
+        return status;
+    }
+    strings = preexec_artifact_le64(string_section + 24);
+    string_bytes = preexec_artifact_le64(string_section + 32);
+    if (preexec_artifact_le32(string_section + 4) != SHT_STRTAB ||
+        !preexec_artifact_range(strings, string_bytes)) {
+        return -EINVAL;
+    }
+    for (uint16_t index = 0; index < count; index++) {
+        uint8_t row[64];
+        char name[256];
+        uint64_t offset;
+        uint64_t bytes;
+
+        status = preexec_setup_pread(owner->artifact_fd, row, sizeof(row),
+                                     sections + (uint64_t)index * 64);
+        if (status) {
+            return status;
+        }
+        offset = preexec_artifact_le64(row + 24);
+        bytes = preexec_artifact_le64(row + 32);
+        status = preexec_artifact_string(strings, string_bytes,
+            preexec_artifact_le32(row), name, sizeof(name));
+        if (status) {
+            return status;
+        }
+        if (preexec_setup_string_length(name, sizeof(name)) ==
+                sizeof(QEMU_PLUGIN_CRUCIBLE_CONTROL_LAYOUT_SECTION) - 1 &&
+            !preexec_setup_compare(name, QEMU_PLUGIN_CRUCIBLE_CONTROL_LAYOUT_SECTION,
+                sizeof(QEMU_PLUGIN_CRUCIBLE_CONTROL_LAYOUT_SECTION))) {
+            uint64_t flags = preexec_artifact_le64(row + 8);
+
+            if (++matched != 1 || preexec_artifact_le32(row + 4) != SHT_PROGBITS ||
+                !(flags & SHF_ALLOC) || (flags & SHF_WRITE) ||
+                bytes != sizeof(owner->artifact_layout_wire) ||
+                !preexec_artifact_range(offset, bytes)) {
+                return -EINVAL;
+            }
+            status = preexec_artifact_readonly_load(header, row);
+            if (!status) {
+                status = preexec_setup_pread(owner->artifact_fd,
+                    owner->artifact_layout_wire,
+                    sizeof(owner->artifact_layout_wire), offset);
+            }
+            if (!status) {
+                status = preexec_literal_qemu_crucible_process_control_layout_decode_v1(
+                    owner->artifact_layout_wire, sizeof(owner->artifact_layout_wire),
+                    &owner->artifact_layout);
+            }
+            if (status || owner->artifact_layout.artifact_machine != machine) {
+                return status ? status : -ESTALE;
+            }
+        }
+        if (preexec_artifact_le32(row + 4) == SHT_DYNAMIC) {
+            uint32_t linked = preexec_artifact_le32(row + 40);
+            uint8_t table[64];
+
+            if (linked >= count) {
+                return -EINVAL;
+            }
+            status = preexec_setup_pread(owner->artifact_fd, table, sizeof(table),
+                                         sections + (uint64_t)linked * 64);
+            if (!status && preexec_artifact_le32(table + 4) != SHT_STRTAB) {
+                status = -EINVAL;
+            }
+            if (!status) {
+                status = preexec_artifact_dynamic(offset, bytes,
+                    preexec_artifact_le64(table + 24), preexec_artifact_le64(table + 32));
+            }
+            if (status) {
+                return status;
+            }
+        }
+    }
+    if (matched != 1) {
+        return -ENOKEY;
+    }
+    for (size_t index = 0; index < 7; index++) {
+        const QemuCrucibleProcessPurposeRequest *actual =
+            &owner->artifact_layout.requests[index];
+        const QemuCrucibleProcessPurposeRequest *issued = &owner->plan.purpose.requests[index];
+
+        if (actual->extent != issued->extent || actual->alignment != issued->alignment ||
+            actual->count != issued->count) {
+            return -ESTALE;
+        }
+    }
+    return 0;
+}
+
+static int preexec_setup_artifact(void)
+{
+    QemuCruciblePreexecSetupOwner *owner = &preexec_setup_owner;
+    uint8_t digest[32];
+    uint64_t cursor = 0;
+    long result;
+    int status;
+
+    if (!owner->cgroup_corroborated || owner->artifact_source_fd >= 0 ||
+        owner->artifact_fd >= 0 || owner->close_status) {
+        return -EPERM;
+    }
+    /* Fixed buffers/descriptor custody were charged with the whole owner
+     * before cgroup reads. Opening the original alias grants no ELF authority. */
+    result = preexec_setup_syscall5(SYS_openat, AT_FDCWD,
+        (long)(uintptr_t)owner->plugin_path,
+        O_RDONLY | O_CLOEXEC | O_NONBLOCK | O_NOFOLLOW, 0, 0);
+    if (result < 0) {
+        return result;
+    }
+    owner->artifact_source_fd = result;
+    result = preexec_setup_syscall5(SYS_fstat, owner->artifact_source_fd,
+        (long)(uintptr_t)&owner->artifact_before, 0, 0, 0);
+    if (result < 0) {
+        return result;
+    }
+    if (!S_ISREG(owner->artifact_before.st_mode) || owner->artifact_before.st_size < 64 ||
+        (uint64_t)owner->artifact_before.st_size > UINT64_MAX / 8 ||
+        (uint64_t)owner->artifact_before.st_size > owner->plan.purpose.writable_file_limit) {
+        return -EINVAL;
+    }
+    /* Actual sealed image backing is an in-share request before memfd/write.
+     * Old opened and new copied aliases remain simultaneously owned until the
+     * original's single physical close. No refund follows an uncertain close.
+     */
+    status = preexec_setup_provisional_native(owner->artifact_before.st_size);
+    if (status) {
+        return status;
+    }
+    result = preexec_setup_syscall5(SYS_memfd_create,
+        (long)(uintptr_t)"crucible-installing-artifact", 1 | 2, 0, 0, 0);
+    if (result < 0) {
+        return result;
+    }
+    owner->artifact_fd = result;
+    preexec_artifact_hash_begin();
+    while (cursor < (uint64_t)owner->artifact_before.st_size) {
+        size_t count = owner->artifact_before.st_size - cursor;
+        size_t written = 0;
+
+        if (count > sizeof(owner->artifact_buffer)) {
+            count = sizeof(owner->artifact_buffer);
+        }
+        status = preexec_setup_pread(owner->artifact_source_fd,
+                                     owner->artifact_buffer, count, cursor);
+        if (!status) {
+            status = preexec_artifact_hash_update(owner->artifact_buffer, count);
+        }
+        if (status) {
+            return status;
+        }
+        while (written < count) {
+            result = preexec_setup_syscall5(SYS_write, owner->artifact_fd,
+                (long)(uintptr_t)(owner->artifact_buffer + written), count - written, 0, 0);
+            if (result <= 0 || (uint64_t)result > count - written) {
+                return result < 0 ? result : -EIO;
+            }
+            written += result;
+        }
+        cursor += count;
+    }
+    preexec_artifact_hash_end(digest);
+    if (preexec_setup_compare(digest, owner->plan.purpose.artifact_digest, sizeof(digest))) {
+        return -ESTALE;
+    }
+    result = preexec_setup_syscall5(SYS_fcntl, owner->artifact_fd, 1024 + 9, 1 | 2 | 4 | 8,
+                                  0, 0);
+    if (result < 0) {
+        return result;
+    }
+    status = preexec_artifact_elf();
+    if (status) {
+        return status;
+    }
+    result = preexec_setup_syscall5(SYS_fstat, owner->artifact_source_fd,
+        (long)(uintptr_t)&owner->artifact_after, 0, 0, 0);
+    if (result < 0) {
+        return result;
+    }
+    if (owner->artifact_before.st_dev != owner->artifact_after.st_dev ||
+        owner->artifact_before.st_ino != owner->artifact_after.st_ino ||
+        owner->artifact_before.st_mode != owner->artifact_after.st_mode ||
+        owner->artifact_before.st_size != owner->artifact_after.st_size) {
+        return -ESTALE;
+    }
+    status = preexec_setup_close_owned(&owner->artifact_source_fd);
+    if (!status) {
+        owner->artifact_verified = true;
+    }
+    return status;
+}
diff --git a/system/crucible-preexec-contract.inc.h b/system/crucible-preexec-contract.inc.h
new file mode 100644
index 0000000000000000000000000000000000000000..d8d445c634942a7c72f97d14b15b3f6f11f9a9f1
--- /dev/null
+++ b/system/crucible-preexec-contract.inc.h
@@ -0,0 +1,322 @@
+/*
+ * Retained native process/family capacity observations after Setup
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Included once by crucible-preexec-setup.c. Observation checks retain the same
+ * nominal singleton; they start no work, renew no original and grant no request
+ * or cancellation authority. Failed once-close retains actor scratch custody.
+ */
+
+/* Observation uses the admitted actor's fixed scratch and keeps ambiguous
+ * close custody there. It never mutates or reopens the preinit singleton.
+ */
+static int preexec_contract_observation_read(
+    QemuCrucibleProcessContractObservation *observation,
+    int directory, const char *path, size_t *bytes)
+{
+    size_t used = 0;
+    long status;
+    int failure = 0;
+
+    if (observation->descriptor >= 0 || observation->close_uncertain) {
+        return -EBUSY;
+    }
+    status = preexec_setup_syscall5(SYS_openat, directory,
+        (long)(uintptr_t)path, O_RDONLY | O_CLOEXEC | O_NOFOLLOW, 0, 0);
+    if (status < 0) {
+        return (int)status;
+    }
+    observation->descriptor = status;
+    while (used < sizeof(observation->bytes)) {
+        status = preexec_setup_syscall5(SYS_read, observation->descriptor,
+            (long)(uintptr_t)(observation->bytes + used),
+            sizeof(observation->bytes) - used, 0, 0);
+        if (status <= 0) {
+            failure = status < 0 ? (int)status : 0;
+            break;
+        }
+        used += status;
+    }
+    if (used == sizeof(observation->bytes)) {
+        failure = -E2BIG;
+    }
+    status = preexec_setup_syscall5(SYS_close, observation->descriptor,
+        0, 0, 0, 0);
+    if (status < 0) {
+        observation->close_uncertain = true;
+        return failure ? failure : (int)status;
+    }
+    observation->descriptor = -1;
+    if (failure) {
+        return failure;
+    }
+    *bytes = used;
+    return 0;
+}
+
+static int preexec_contract_relation_check(
+    QemuCrucibleProcessContractObservation *observation, int directory,
+    const char *name, uint64_t expected_device, uint64_t expected_inode)
+{
+    struct stat identity;
+    struct statfs filesystem;
+    long status;
+    int failure = 0;
+
+    if (observation->descriptor >= 0 || observation->close_uncertain) {
+        return -EBUSY;
+    }
+    status = preexec_setup_syscall5(SYS_openat, directory,
+        (long)(uintptr_t)name, O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW,
+        0, 0);
+    if (status < 0) {
+        return (int)status;
+    }
+    observation->descriptor = status;
+    status = preexec_setup_syscall5(SYS_fstat, observation->descriptor,
+        (long)(uintptr_t)&identity, 0, 0, 0);
+    if (status < 0) {
+        failure = status;
+    } else if (!S_ISDIR(identity.st_mode) ||
+               identity.st_dev != expected_device || identity.st_ino != expected_inode) {
+        failure = -ESTALE;
+    }
+    if (!failure) {
+        status = preexec_setup_syscall5(SYS_fstatfs, observation->descriptor,
+            (long)(uintptr_t)&filesystem, 0, 0, 0);
+        if (status < 0) {
+            failure = status;
+        } else if (filesystem.f_type != CGROUP2_SUPER_MAGIC) {
+            failure = -EXDEV;
+        }
+    }
+    status = preexec_setup_syscall5(SYS_close, observation->descriptor, 0, 0, 0, 0);
+    if (status < 0) {
+        observation->close_uncertain = true;
+        return failure ? failure : (int)status;
+    }
+    observation->descriptor = -1;
+    return failure;
+}
+
+static int preexec_contract_family_current(
+    QemuCruciblePreexecSetupOwner *owner,
+    QemuCrucibleProcessContractObservation *observation)
+{
+    const struct QemuCrucibleProcessContractOwner *contract = &owner->contract;
+    char sender_file[64];
+    size_t bytes;
+    size_t sender_bytes;
+    size_t cursor = 0;
+    uint64_t quota;
+    uint64_t period;
+    uint64_t tasks;
+    int status;
+
+    if (!owner->family_corroborated ||
+        contract->parent_directory_fd != owner->parent_cgroup_directory ||
+        contract->service_directory_fd != owner->service_cgroup_directory ||
+        contract->sender_directory_fd != owner->sender_cgroup_directory ||
+        preexec_setup_syscall5(SYS_getppid, 0, 0, 0, 0, 0) != owner->peer_process) {
+        return -ESTALE;
+    }
+    status = preexec_contract_relation_check(observation, owner->cgroup_directory,
+        "..", contract->parent_device, contract->parent_inode);
+    if (!status) {
+        status = preexec_contract_relation_check(observation,
+            contract->parent_directory_fd, "..",
+            contract->service_device, contract->service_inode);
+    }
+    if (!status) {
+        status = preexec_contract_relation_check(observation,
+            contract->service_directory_fd, owner->sender_cgroup_leaf,
+            contract->sender_device, contract->sender_inode);
+    }
+    if (status) {
+        return status;
+    }
+    preexec_setup_sender_cgroup_name(sender_file, owner->peer_process);
+    status = preexec_contract_observation_read(observation, AT_FDCWD,
+                                               sender_file, &bytes);
+    if (status) {
+        return status;
+    }
+    sender_bytes = preexec_setup_string_length(owner->sender_cgroup_path,
+                                                sizeof(owner->sender_cgroup_path));
+    if (bytes != 3 + sender_bytes + 1 ||
+        preexec_setup_compare(observation->bytes, "0::", 3) ||
+        preexec_setup_compare(observation->bytes + 3,
+                               owner->sender_cgroup_path, sender_bytes) ||
+        observation->bytes[bytes - 1] != '\n') {
+        return -ESTALE;
+    }
+    status = preexec_contract_observation_read(observation,
+        contract->parent_directory_fd, "cpu.max", &bytes);
+    if (!status) {
+        status = preexec_setup_decimal(observation->bytes, bytes, &cursor, &quota);
+    }
+    if (!status && cursor < bytes && observation->bytes[cursor++] == ' ') {
+        status = preexec_setup_decimal(observation->bytes, bytes, &cursor, &period);
+    } else if (!status) {
+        status = -EINVAL;
+    }
+    if (status || cursor + 1 != bytes || observation->bytes[cursor] != '\n' ||
+        quota != contract->parent_cpu_quota || period != contract->parent_cpu_period ||
+        period != QEMU_CRUCIBLE_PROCESS_PURPOSE_CPU_PERIOD) {
+        return status ? status : -ESTALE;
+    }
+    status = preexec_contract_observation_read(observation,
+        contract->parent_directory_fd, "pids.max", &bytes);
+    cursor = 0;
+    if (!status) {
+        status = preexec_setup_decimal(observation->bytes, bytes, &cursor, &tasks);
+    }
+    if (status || cursor + 1 != bytes || observation->bytes[cursor] != '\n' ||
+        tasks != contract->parent_task_limit) {
+        return status ? status : -ESTALE;
+    }
+    status = preexec_setup_kernel_capabilities();
+    if (!status) {
+        status = preexec_contract_observation_read(observation, AT_FDCWD,
+                                                   "/proc/self/status", &bytes);
+    }
+    return status ? status : preexec_setup_status_capabilities(observation->bytes, bytes);
+}
+
+static int preexec_contract_current(
+    QemuCruciblePreexecPurposeOwner *held,
+    QemuCrucibleProcessContractObservation *observation,
+    uint64_t *descriptor_limit)
+{
+    QemuCruciblePreexecSetupOwner *owner = &preexec_setup_owner;
+    struct stat directory;
+    struct {
+        uint64_t current;
+        uint64_t maximum;
+    } actual;
+    const int resources[2] = { RLIMIT_NOFILE, RLIMIT_FSIZE };
+    const uint64_t expected_limits[2] = {
+        owner->plan.purpose.fd_limit, owner->plan.purpose.writable_file_limit,
+    };
+    const char *names[3] = { "memory.max", "pids.max", "memory.swap.max" };
+    const uint64_t expected[3] = {
+        owner->plan.purpose.memory_limit, owner->plan.purpose.task_limit, 0,
+    };
+    long process = preexec_setup_syscall5(SYS_getpid, 0, 0, 0, 0, 0);
+    long result;
+    size_t bytes;
+    size_t group_bytes;
+    size_t cursor;
+    uint64_t quota;
+    uint64_t period;
+    int status;
+
+    if (held != owner || owner->process_id != process) {
+        return -EPERM;
+    }
+    if (!descriptor_limit || !observation ||
+        !owner->peer_validated || !owner->plan_validated ||
+        !owner->limits_corroborated || !owner->cgroup_corroborated ||
+        !owner->family_corroborated || !owner->identity_corroborated ||
+        !owner->artifact_verified || owner->close_status ||
+        owner->contract.process != process ||
+        owner->incarnation.process != process ||
+        owner->incarnation.generation != owner->plan.purpose.process_generation ||
+        owner->contract.directory_fd != owner->cgroup_directory) {
+        return -ENOKEY;
+    }
+    result = preexec_setup_syscall5(SYS_fstat, owner->cgroup_directory,
+        (long)(uintptr_t)&directory, 0, 0, 0);
+    if (result < 0) {
+        return (int)result;
+    }
+    if (!S_ISDIR(directory.st_mode) ||
+        directory.st_dev != owner->contract.device ||
+        directory.st_ino != owner->contract.inode) {
+        return -ESTALE;
+    }
+    for (size_t index = 0; index < 2; index++) {
+        result = preexec_setup_syscall5(SYS_prlimit64, 0, resources[index], 0,
+            (long)(uintptr_t)&actual, 0);
+        if (result < 0) {
+            return (int)result;
+        }
+        if (actual.current == UINT64_MAX || actual.maximum == UINT64_MAX ||
+            actual.current != expected_limits[index] ||
+            actual.maximum != expected_limits[index]) {
+            return -ESTALE;
+        }
+    }
+    status = preexec_contract_observation_read(observation, AT_FDCWD,
+                                               "/proc/self/cgroup", &bytes);
+    if (status) {
+        return status;
+    }
+    group_bytes = preexec_setup_string_length(owner->cgroup_path,
+                                               sizeof(owner->cgroup_path));
+    if (bytes != 3 + group_bytes + 1 ||
+        preexec_setup_compare(observation->bytes, "0::", 3) ||
+        preexec_setup_compare(observation->bytes + 3,
+                               owner->cgroup_path, group_bytes) ||
+        observation->bytes[bytes - 1] != '\n') {
+        return -ESTALE;
+    }
+    for (size_t index = 0; index < 3; index++) {
+        uint64_t value;
+
+        status = preexec_contract_observation_read(observation,
+            owner->cgroup_directory, names[index], &bytes);
+        cursor = 0;
+        if (!status) {
+            status = preexec_setup_decimal(observation->bytes, bytes,
+                                           &cursor, &value);
+        }
+        if (status || cursor + 1 != bytes ||
+            observation->bytes[cursor] != '\n' || value != expected[index]) {
+            return status ? status : -ESTALE;
+        }
+    }
+    status = preexec_contract_observation_read(observation,
+        owner->cgroup_directory, "cpu.max", &bytes);
+    if (status) {
+        return status;
+    }
+    cursor = 0;
+    status = preexec_setup_decimal(observation->bytes, bytes, &cursor, &quota);
+    if (!status && cursor < bytes && observation->bytes[cursor++] == ' ') {
+        status = preexec_setup_decimal(observation->bytes, bytes, &cursor, &period);
+    } else if (!status) {
+        status = -EINVAL;
+    }
+    if (status || cursor + 1 != bytes || observation->bytes[cursor] != '\n' ||
+        period != 100000 || owner->plan.purpose.vcpu_limit > UINT64_MAX / 100000 ||
+        quota != owner->plan.purpose.vcpu_limit * 100000) {
+        return status ? status : -ESTALE;
+    }
+    status = preexec_contract_family_current(owner, observation);
+    if (status) {
+        return status;
+    }
+    *descriptor_limit = owner->plan.purpose.fd_limit;
+    return 0;
+}
+
+/* Runtime callers cannot supply the constructor's private prepublication
+ * cut. The immutable accepted Source must already retain the same singleton.
+ */
+int qemu_crucible_preexec_contract_check_v3(
+    QemuCruciblePreexecPurposeOwner *held,
+    QemuCrucibleProcessContractObservation *observation,
+    uint64_t *descriptor_limit)
+{
+    QemuCruciblePreexecSetupOwner *owner = &preexec_setup_owner;
+    long process = preexec_setup_syscall5(SYS_getpid, 0, 0, 0, 0, 0);
+
+    if (held != owner || owner->process_id != process) {
+        return -EPERM;
+    }
+    if (!owner->source_published) {
+        return -ENOKEY;
+    }
+    return preexec_contract_current(held, observation, descriptor_limit);
+}
diff --git a/system/crucible-preexec-family.inc.h b/system/crucible-preexec-family.inc.h
new file mode 100644
index 0000000000000000000000000000000000000000..1e7bd5fda36f2865818311e7173f18275ca87720
--- /dev/null
+++ b/system/crucible-preexec-family.inc.h
@@ -0,0 +1,215 @@
+/*
+ * Actual selected child/sender/service-root cgroup topology corroboration
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Included once by the raw preinit owner. Kernel paths and retained directories
+ * corroborate the authenticated once-carrier's family; numbers alone cannot
+ * construct a parent issuer, spend credit or mint another child share.
+ */
+
+static void preexec_setup_sender_cgroup_name(char path[64], unsigned process)
+{
+    const char prefix[] = "/proc/";
+    const char suffix[] = "/cgroup";
+    char digits[16];
+    size_t count = 0;
+    size_t cursor = sizeof(prefix) - 1;
+
+    preexec_setup_copy(path, prefix, sizeof(prefix) - 1);
+    do {
+        digits[count++] = '0' + process % 10;
+        process /= 10;
+    } while (process);
+    for (size_t index = 0; index < count; index++) {
+        path[cursor++] = digits[count - index - 1];
+    }
+    preexec_setup_copy(path + cursor, suffix, sizeof(suffix));
+}
+
+static int preexec_setup_family_directory(
+    int directory, const char *name, int *retained, struct stat *identity)
+{
+    struct statfs filesystem;
+    long status;
+
+    if (*retained >= 0) {
+        return -EALREADY;
+    }
+    status = preexec_setup_syscall5(SYS_openat, directory,
+        (long)(uintptr_t)name, O_RDONLY | O_DIRECTORY | O_CLOEXEC | O_NOFOLLOW,
+        0, 0);
+    if (status < 0) {
+        return (int)status;
+    }
+    *retained = status;
+    status = preexec_setup_syscall5(SYS_fstat, *retained,
+        (long)(uintptr_t)identity, 0, 0, 0);
+    if (status < 0) {
+        return (int)status;
+    }
+    if (!S_ISDIR(identity->st_mode)) {
+        return -ENOTDIR;
+    }
+    status = preexec_setup_syscall5(SYS_fstatfs, *retained,
+        (long)(uintptr_t)&filesystem, 0, 0, 0);
+    if (status < 0) {
+        return (int)status;
+    }
+    return filesystem.f_type == CGROUP2_SUPER_MAGIC ? 0 : -EXDEV;
+}
+
+/* Sender lives in a direct child of the actual service root; the resource
+ * parent is its distinct sibling and this selected attempt is a direct child
+ * of that resource parent. No attempt basename or arbitrary parent pathname
+ * is accepted from the carrier. The carrier's appended inode must match the
+ * actual '..' object reached from the already pinned current child.
+ */
+static int preexec_setup_family_paths(void)
+{
+    QemuCruciblePreexecSetupOwner *owner = &preexec_setup_owner;
+    char sender_file[64];
+    size_t bytes;
+    size_t child_bytes;
+    size_t child_separator = 0;
+    size_t parent_separator = 0;
+    size_t sender_separator = 0;
+    size_t sender_bytes;
+    size_t service_bytes;
+    size_t leaf_bytes;
+    int status;
+
+    if (preexec_setup_syscall5(SYS_getppid, 0, 0, 0, 0, 0) != owner->peer_process) {
+        return -ESTALE;
+    }
+    preexec_setup_sender_cgroup_name(sender_file, owner->peer_process);
+    status = preexec_setup_metadata_read(AT_FDCWD, sender_file, &bytes);
+    if (status) {
+        return status;
+    }
+    if (bytes <= 4 || preexec_setup_compare(owner->metadata_bytes, "0::", 3) ||
+        owner->metadata_bytes[bytes - 1] != '\n') {
+        return -EPROTO;
+    }
+    status = preexec_setup_path_unescape(owner->metadata_bytes + 3, bytes - 4,
+        owner->sender_cgroup_path, sizeof(owner->sender_cgroup_path));
+    if (status) {
+        return status;
+    }
+    child_bytes = preexec_setup_string_length(owner->cgroup_path,
+                                               sizeof(owner->cgroup_path));
+    sender_bytes = preexec_setup_string_length(owner->sender_cgroup_path,
+                                                sizeof(owner->sender_cgroup_path));
+    for (size_t index = 0; index < child_bytes; index++) {
+        if (owner->cgroup_path[index] == '/') {
+            parent_separator = child_separator;
+            child_separator = index;
+        }
+    }
+    for (size_t index = 0; index < sender_bytes; index++) {
+        if (owner->sender_cgroup_path[index] == '/') {
+            sender_separator = index;
+        }
+    }
+    if (!child_separator || child_separator + 1 == child_bytes ||
+        child_separator <= parent_separator + 1 ||
+        sender_separator + 1 == sender_bytes ||
+        sender_separator != parent_separator) {
+        return -EXDEV;
+    }
+    service_bytes = parent_separator ? parent_separator : 1;
+    if (preexec_setup_compare(owner->cgroup_path, owner->sender_cgroup_path,
+                               service_bytes)) {
+        return -EXDEV;
+    }
+    preexec_setup_copy(owner->service_cgroup_path, owner->cgroup_path,
+                       service_bytes);
+    owner->service_cgroup_path[service_bytes] = 0;
+    leaf_bytes = sender_bytes - sender_separator - 1;
+    if (!leaf_bytes || leaf_bytes > NAME_MAX ||
+        (leaf_bytes == 1 && owner->sender_cgroup_path[sender_separator + 1] == '.') ||
+        (leaf_bytes == 2 && !preexec_setup_compare(
+            owner->sender_cgroup_path + sender_separator + 1, "..", 2))) {
+        return -EINVAL;
+    }
+    preexec_setup_copy(owner->sender_cgroup_leaf,
+        owner->sender_cgroup_path + sender_separator + 1, leaf_bytes);
+    owner->sender_cgroup_leaf[leaf_bytes] = 0;
+    return 0;
+}
+
+static int preexec_setup_family(void)
+{
+    QemuCruciblePreexecSetupOwner *owner = &preexec_setup_owner;
+    const QemuCrucibleProcessPurposeRecord *purpose = &owner->plan.purpose;
+    size_t bytes;
+    size_t cursor;
+    uint64_t quota;
+    uint64_t period;
+    uint64_t tasks;
+    int status;
+
+    if (!owner->peer_validated || !owner->cgroup_corroborated ||
+        !owner->limits_corroborated || owner->family_corroborated) {
+        return -EPERM;
+    }
+    status = preexec_setup_family_paths();
+    if (!status) {
+        status = preexec_setup_family_directory(owner->cgroup_directory, "..",
+            &owner->parent_cgroup_directory, &owner->parent_cgroup_identity);
+    }
+    if (!status &&
+        (owner->parent_cgroup_identity.st_dev != purpose->parent_cgroup_device ||
+         owner->parent_cgroup_identity.st_ino != purpose->parent_cgroup_inode ||
+         (owner->parent_cgroup_identity.st_dev == owner->cgroup_identity.st_dev &&
+          owner->parent_cgroup_identity.st_ino == owner->cgroup_identity.st_ino))) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        status = preexec_setup_family_directory(owner->parent_cgroup_directory, "..",
+            &owner->service_cgroup_directory, &owner->service_cgroup_identity);
+    }
+    if (!status) {
+        status = preexec_setup_family_directory(owner->service_cgroup_directory,
+            owner->sender_cgroup_leaf, &owner->sender_cgroup_directory,
+            &owner->sender_cgroup_identity);
+    }
+    if (!status &&
+        ((owner->sender_cgroup_identity.st_dev == owner->parent_cgroup_identity.st_dev &&
+          owner->sender_cgroup_identity.st_ino == owner->parent_cgroup_identity.st_ino) ||
+         (owner->service_cgroup_identity.st_dev == owner->parent_cgroup_identity.st_dev &&
+          owner->service_cgroup_identity.st_ino == owner->parent_cgroup_identity.st_ino))) {
+        status = -EXDEV;
+    }
+    if (status) {
+        return status;
+    }
+    status = preexec_setup_metadata_read(owner->parent_cgroup_directory,
+                                         "cpu.max", &bytes);
+    cursor = 0;
+    if (!status) {
+        status = preexec_setup_decimal(owner->metadata_bytes, bytes, &cursor, &quota);
+    }
+    if (!status && cursor < bytes && owner->metadata_bytes[cursor++] == ' ') {
+        status = preexec_setup_decimal(owner->metadata_bytes, bytes, &cursor, &period);
+    } else if (!status) {
+        status = -EINVAL;
+    }
+    if (status || cursor + 1 != bytes || owner->metadata_bytes[cursor] != '\n' ||
+        quota != purpose->parent_cpu_quota ||
+        period != purpose->parent_cpu_period ||
+        period != QEMU_CRUCIBLE_PROCESS_PURPOSE_CPU_PERIOD) {
+        return status ? status : -ESTALE;
+    }
+    status = preexec_setup_metadata_read(owner->parent_cgroup_directory,
+                                         "pids.max", &bytes);
+    cursor = 0;
+    if (!status) {
+        status = preexec_setup_decimal(owner->metadata_bytes, bytes, &cursor, &tasks);
+    }
+    if (status || cursor + 1 != bytes || owner->metadata_bytes[cursor] != '\n' ||
+        tasks != purpose->parent_task_limit) {
+        return status ? status : -ESTALE;
+    }
+    owner->family_corroborated = true;
+    return 0;
+}
diff --git a/system/crucible-preexec-publisher-offer.inc.h b/system/crucible-preexec-publisher-offer.inc.h
new file mode 100644
index 0000000000000000000000000000000000000000..22bd3d8b1e3dedf138e041287f05bef5f4f440e3
--- /dev/null
+++ b/system/crucible-preexec-publisher-offer.inc.h
@@ -0,0 +1,249 @@
+/*
+ * One nonissuing atomic offer observation on the actual installed session.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+static int preexec_publisher_offer_copy(
+    const uint64_t *mapping, QemuCruciblePublisherOfferObservation *observation)
+{
+    size_t publication = QEMU_CRUCIBLE_PUBLISHER_PUBLICATION_OFFSET / 8;
+    size_t receiver = QEMU_CRUCIBLE_PUBLISHER_RECEIVER_OFFSET / 8;
+
+    observation->sequence = __atomic_load_n(mapping + publication, __ATOMIC_SEQ_CST);
+    observation->ticket = __atomic_load_n(mapping + receiver, __ATOMIC_SEQ_CST);
+    if (preexec_setup_be64((const uint8_t *)&observation->sequence) & 1) {
+        return -EBUSY;
+    }
+    for (size_t index = 0; index < G_N_ELEMENTS(observation->words); index++) {
+        observation->words[index] = __atomic_load_n(mapping + index, __ATOMIC_SEQ_CST);
+    }
+    observation->copied = true;
+    return observation->words[publication] == observation->sequence &&
+        observation->words[receiver] == observation->ticket ? 0 : -ESTALE;
+}
+
+static int preexec_publisher_offer_final(
+    const uint64_t *mapping, const QemuCruciblePublisherOfferObservation *observation)
+{
+    int status = 0;
+
+    if (observation->copied) {
+        for (size_t index = 0; index < G_N_ELEMENTS(observation->words); index++) {
+            if (__atomic_load_n(mapping + index, __ATOMIC_SEQ_CST) !=
+                observation->words[index]) {
+                status = -ESTALE;
+            }
+        }
+    }
+    if (__atomic_load_n(mapping + QEMU_CRUCIBLE_PUBLISHER_RECEIVER_OFFSET / 8,
+                        __ATOMIC_SEQ_CST) != observation->ticket ||
+        __atomic_load_n(mapping + QEMU_CRUCIBLE_PUBLISHER_PUBLICATION_OFFSET / 8,
+                        __ATOMIC_SEQ_CST) != observation->sequence) {
+        status = -ESTALE;
+    }
+    return status;
+}
+
+/* Closed wire bytes corroborate a previously consumed real recipient. They
+ * cannot substitute for that actual process-private physical-return journal. */
+static bool preexec_publisher_offer_recipient_closed(
+    const QemuCruciblePublisherSessionLender *session,
+    const QemuCruciblePublisherOfferObservation *observation)
+{
+    const QemuCruciblePublisherRecipient *recipient = &session->recipient;
+    const QemuCruciblePublisherTerminalView *terminal = &observation->terminal;
+    const QemuCruciblePublisherTerminalView *saved = &session->terminal;
+
+    if (recipient->canonical_owner != recipient ||
+        recipient->holder != &session->recipient_holder || !recipient->source_holder ||
+        *recipient->source_holder || session->recipient_holder || session->live_operations ||
+        !recipient->acquire_attempted || !recipient->acquired || !recipient->return_attempted ||
+        !recipient->return_requested || !recipient->close_attempted ||
+        !recipient->consumed || !recipient->closed || recipient->held || recipient->uncertain ||
+        !recipient->view_born_mask || recipient->view_born_mask != recipient->view_returned_mask ||
+        observation->publication.sequence != recipient->publication_sequence ||
+        observation->publication.loan_generation != recipient->loan_generation ||
+        observation->publication.ticket_serial != recipient->ticket_serial ||
+        observation->returned.sequence != recipient->return_sequence ||
+        observation->returned.local_serial != recipient->serial ||
+        terminal->ticket_serial != recipient->ticket_serial ||
+        terminal->loan_generation != recipient->loan_generation ||
+        terminal->command_sequence != recipient->publication_sequence ||
+        terminal->return_sequence != recipient->return_sequence ||
+        terminal->born_mask != recipient->view_born_mask ||
+        terminal->consumed_mask != terminal->born_mask ||
+        !terminal->command_consumption_generation) {
+        return false;
+    }
+    if (terminal->sequence != saved->sequence ||
+        terminal->ticket_serial != saved->ticket_serial ||
+        terminal->loan_generation != saved->loan_generation ||
+        terminal->command_sequence != saved->command_sequence ||
+        terminal->return_sequence != saved->return_sequence ||
+        terminal->command_consumption_generation != saved->command_consumption_generation ||
+        terminal->first_status != saved->first_status ||
+        terminal->post_status != saved->post_status ||
+        terminal->consumed_mask != saved->consumed_mask ||
+        terminal->born_mask != saved->born_mask) {
+        return false;
+    }
+    for (size_t index = 0; index < G_N_ELEMENTS(recipient->publication_words); index++) {
+        if (index != 3 && observation->words[
+                QEMU_CRUCIBLE_PUBLISHER_PUBLICATION_OFFSET / 8 + index] !=
+            recipient->publication_words[index]) {
+            return false;
+        }
+    }
+    for (size_t index = 0; index < G_N_ELEMENTS(recipient->return_words); index++) {
+        if (observation->words[(QEMU_CRUCIBLE_PUBLISHER_RECEIVER_OFFSET + 8) / 8 + index] !=
+            recipient->return_words[index]) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static int preexec_publisher_offer_classify(
+    const QemuCruciblePublisherSessionLender *session,
+    QemuCruciblePublisherOfferObservation *observation)
+{
+    const uint8_t *wire = (const uint8_t *)observation->words;
+    const QemuCruciblePublisherPurpose *purpose = &preexec_setup_owner.plan.subscription;
+    const QemuCrucibleBoundaryActionRecord *cohort = &observation->publication.cohort;
+    uint64_t ticket = preexec_setup_be64(wire + QEMU_CRUCIBLE_PUBLISHER_RECEIVER_OFFSET);
+    uint64_t serial = ticket >> 3;
+    uint64_t phase = ticket & 7;
+    bool empty = true;
+    int status = preexec_literal_qemu_crucible_publisher_header_decode_v1(
+        wire, QEMU_CRUCIBLE_PUBLISHER_HEADER_BYTES, &observation->header);
+
+    if (status) {
+        return status;
+    }
+    if (observation->header.lender_generation != purpose->lender_generation ||
+        observation->header.account_generation != purpose->account_generation ||
+        observation->header.process_generation != purpose->process_generation ||
+        observation->header.node_index != session->header.node_index ||
+        observation->header.node_count != session->header.node_count ||
+        preexec_setup_compare(observation->header.source_capability, purpose->capability, 32) ||
+        preexec_setup_compare(observation->header.source_reservation, purpose->reservation, 32)) {
+        return -ESTALE;
+    }
+    for (size_t index = 2816 / 8; index < G_N_ELEMENTS(observation->words); index++) {
+        if (observation->words[index]) {
+            return -EPROTO;
+        }
+    }
+    for (size_t index = QEMU_CRUCIBLE_PUBLISHER_PUBLICATION_OFFSET / 8;
+         index < QEMU_CRUCIBLE_PUBLISHER_TERMINAL_OFFSET / 8 +
+                 QEMU_CRUCIBLE_PUBLISHER_TERMINAL_BYTES / 8; index++) {
+        empty &= observation->words[index] == 0;
+    }
+    if (empty) {
+        if (session->recipient.canonical_owner || session->recipient.acquire_attempted ||
+            session->recipient_holder || session->live_operations) {
+            return -ESTALE;
+        }
+        observation->state = 0;
+        return 0;
+    }
+    if (!serial || serial > QEMU_CRUCIBLE_PUBLISHER_TICKET_SERIAL_MAX ||
+        (phase != 1 && phase != 5)) {
+        return -EBUSY;
+    }
+    status = preexec_literal_qemu_crucible_publisher_publication_decode_v1(
+        wire + QEMU_CRUCIBLE_PUBLISHER_PUBLICATION_OFFSET,
+        QEMU_CRUCIBLE_PUBLISHER_PUBLICATION_BYTES, &observation->publication);
+    if (status) {
+        return status;
+    }
+    if (observation->publication.ticket_serial != serial) {
+        return -ESTALE;
+    }
+    if (phase == 5) {
+        status = preexec_literal_qemu_crucible_publisher_return_decode_v1(
+            wire + QEMU_CRUCIBLE_PUBLISHER_RECEIVER_OFFSET + 8,
+            QEMU_CRUCIBLE_PUBLISHER_RETURN_BYTES, &observation->returned);
+        if (!status) {
+            status = preexec_literal_qemu_crucible_publisher_terminal_decode_v1(
+                wire + QEMU_CRUCIBLE_PUBLISHER_TERMINAL_OFFSET,
+                QEMU_CRUCIBLE_PUBLISHER_TERMINAL_BYTES, &observation->terminal);
+        }
+        if (!status && !preexec_publisher_offer_recipient_closed(session, observation)) {
+            status = -ESTALE;
+        }
+        if (!status) {
+            observation->state = 0;
+        }
+        return status;
+    }
+    if (session->recipient_holder || session->live_operations || session->recipient.held ||
+        !observation->publication.command_present ||
+        observation->publication.permission_phase != 1 ||
+        !cohort->present || cohort->dirty || cohort->primary_count != 1 ||
+        !cohort->planned_count || cohort->planned_count > QEMU_CRUCIBLE_ACTION_PARENT_CAPACITY ||
+        cohort->born_mask != (UINT32_C(1) << cohort->planned_count) - 1 ||
+        cohort->projected_mask != cohort->born_mask || cohort->rows[0].role ||
+        cohort->rows[0].producing_class != 1 || cohort->rows[0].required_units != 1 ||
+        cohort->rows[0].completed_required_units ||
+        cohort->binding.account_incarnation != purpose->account_generation ||
+        cohort->binding.process_incarnation != purpose->process_generation ||
+        preexec_setup_compare(cohort->binding.source_capability, purpose->capability, 32) ||
+        preexec_setup_compare(cohort->binding.source_reservation, purpose->reservation, 32)) {
+        return -ENOKEY;
+    }
+    observation->state = 1;
+    return 0;
+}
+
+int qemu_crucible_preexec_publisher_offer_observe_v1(
+    QemuCruciblePublisherSessionLender *session,
+    QemuCrucibleCommandConsumerMember *member,
+    QemuCruciblePublisherOfferObservation *observation)
+{
+    int first = qemu_crucible_source_pending_offer_current_v1(session, member, observation);
+    int post;
+    int identity;
+    int final = 0;
+
+    if (first) {
+        return first;
+    }
+    observation->attempted = true;
+    first = preexec_publisher_lender_identity(session);
+    if (!first) {
+        first = preexec_publisher_observation_parent(session);
+    }
+    if (!first && (session->member != member || !session->module_service ||
+        session->closing || preexec_publisher_observation_busy(session) ||
+        !preexec_publisher_module_output_disjoint(observation, sizeof(*observation)))) {
+        first = -EBUSY;
+    }
+    if (!first && (!session->mapping.address ||
+        QEMU_CRUCIBLE_PUBLISHER_REGION_BYTES >
+            UINTPTR_MAX - (uintptr_t)session->mapping.address ||
+        (uintptr_t)session->mapping.address % sizeof(uint64_t) ||
+        !__atomic_is_lock_free(8, session->mapping.address))) {
+        first = -ENOTSUP;
+    }
+    if (!first) {
+        observation->entered = true;
+        first = preexec_publisher_offer_copy(session->mapping.address, observation);
+        observation->read_returned = true;
+    }
+    if (!first) {
+        first = preexec_publisher_offer_classify(session, observation);
+    }
+    /* A refused first/read/decode never skips independent parent/frame/final.
+     * Failed parent identity prevents any further mapping access. */
+    post = qemu_crucible_source_pending_offer_current_v1(session, member, observation);
+    identity = preexec_publisher_observation_parent(session);
+    if (observation->entered && !identity) {
+        final = preexec_publisher_offer_final(session->mapping.address, observation);
+    }
+    observation->first_status = first;
+    observation->post_status = post;
+    observation->identity_status = identity;
+    observation->final_status = final;
+    return first ? first : post ? post : identity ? identity : final;
+}
diff --git a/system/crucible-preexec-publisher-recipient.inc.h b/system/crucible-preexec-publisher-recipient.inc.h
new file mode 100644
index 0000000000000000000000000000000000000000..985fadbb6beddd01811e2ff28562793d220c89fe
--- /dev/null
+++ b/system/crucible-preexec-publisher-recipient.inc.h
@@ -0,0 +1,587 @@
+/*
+ * Bounded recipient acquisition on the actual installed publisher session.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+/* Runtime reads borrow the paid session, not Setup's expired operation clock.
+ * The actual Source Main/recipient cut independently brackets the whole read.
+ * Every span still uses its own before/copy/after and physical local return. */
+static int preexec_publisher_recipient_read(
+    PreexecPublisherSessionJournal *session, PreexecPublisherObservationKind kind)
+{
+    PreexecPublisherObservationJournal *observation = &session->observation;
+    size_t offset = 0;
+    size_t bytes = 0;
+    uint64_t serial = observation->serial;
+    int first = preexec_publisher_observation_parent(session);
+    int identity;
+    int final = 0;
+    int returned;
+
+    if (first || session->closing || preexec_publisher_observation_busy(session)) {
+        return first ? first : -EBUSY;
+    }
+    if (serial >= UINT64_MAX - 1) {
+        return -EOVERFLOW;
+    }
+    *observation = (PreexecPublisherObservationJournal) {
+        .canonical_owner = observation,
+        .holder = &session->observation_holder,
+        .module_service = session->module_service,
+        .process = preexec_setup_owner.process_id,
+        .thread = preexec_setup_owner.thread_id,
+        .serial = serial + 1,
+        .kind = kind,
+        .held = true,
+    };
+    session->observation_holder = observation;
+    session->snapshot_busy = true;
+    first = preexec_publisher_observation_geometry(session, &offset, &bytes);
+    if (!first) {
+        observation->entered = true;
+        first = preexec_publisher_observation_copy(session, offset, bytes);
+        observation->read_returned = true;
+    }
+    if (!first) {
+        first = preexec_publisher_observation_decode(session, bytes);
+    }
+    /* Identity and final sequence remain independent of a negative decode. */
+    identity = preexec_publisher_observation_identity(session);
+    if (observation->entered && !identity) {
+        final = preexec_publisher_observation_final(session, offset);
+    }
+    observation->first_status = first;
+    observation->post_status = preexec_publisher_observation_parent(session);
+    observation->identity_status = identity;
+    observation->final_status = final;
+    returned = preexec_publisher_observation_return(session, identity);
+    observation->return_status = returned;
+    if (first || observation->post_status || final || returned) {
+        return first ? first : observation->post_status ? observation->post_status :
+            final ? final : returned;
+    }
+    if (kind == PREEXEC_PUBLISHER_OBSERVE_HEADER) {
+        session->header = observation->pending.header;
+    } else if (kind == PREEXEC_PUBLISHER_OBSERVE_PUBLICATION) {
+        session->publication = observation->pending.publication;
+    } else if (kind == PREEXEC_PUBLISHER_OBSERVE_RETURN) {
+        session->returned = observation->pending.returned;
+    } else if (kind == PREEXEC_PUBLISHER_OBSERVE_TERMINAL) {
+        session->terminal = observation->pending.terminal;
+    } else {
+        return -EINVAL;
+    }
+    return 0;
+}
+
+/* Host value to the protocol's BE atomic word representation. */
+static uint64_t preexec_publisher_atomic_word(uint64_t value)
+{
+    uint64_t word;
+    uint8_t *bytes = (uint8_t *)&word;
+
+    for (size_t index = 0; index < sizeof(word); index++) {
+        bytes[index] = value >> (56 - index * 8);
+    }
+    return word;
+}
+
+static int preexec_publisher_recipient_final(
+    PreexecPublisherSessionJournal *session, QemuCruciblePublisherRecipient *recipient, bool returning, uint32_t ticket_phase)
+{
+    const uint64_t *publication = session->mapping.address +
+        QEMU_CRUCIBLE_PUBLISHER_PUBLICATION_OFFSET / 8;
+    uint64_t sequence = __atomic_load_n(publication, __ATOMIC_SEQ_CST);
+    uint64_t ticket;
+    uint64_t permission;
+    uint64_t phase;
+
+    if (sequence != recipient->publication_words[0]) {
+        return -ESTALE;
+    }
+    /* The permission word alone may revoke an acquired immutable command.
+     * Every other word, including all cohort rows and command padding, remains
+     * bound to the exact copy retained before the successful acquire CAS. */
+    for (size_t index = 1; index < QEMU_CRUCIBLE_PUBLISHER_PUBLICATION_BYTES / 8;
+         index++) {
+        if (index != 3 && __atomic_load_n(publication + index, __ATOMIC_SEQ_CST) !=
+            recipient->publication_words[index]) {
+            return -ESTALE;
+        }
+    }
+    ticket = __atomic_load_n(session->mapping.address +
+        QEMU_CRUCIBLE_PUBLISHER_RECEIVER_OFFSET / 8, __ATOMIC_SEQ_CST);
+    permission = __atomic_load_n(publication + 3, __ATOMIC_SEQ_CST);
+    phase = preexec_setup_be64((const uint8_t *)&permission);
+    if (preexec_setup_be64((const uint8_t *)&ticket) !=
+        (recipient->ticket_serial << 3 | ticket_phase) ||
+        (returning ? phase < 1 || phase > 3 : phase != 1) ||
+        __atomic_load_n(publication, __ATOMIC_SEQ_CST) != sequence) {
+        return -ESTALE;
+    }
+    return 0;
+}
+
+int qemu_crucible_preexec_publisher_recipient_output_v1(
+    QemuCruciblePublisherSessionLender *session,
+    QemuCruciblePublisherRecipient *recipient,
+    QemuCrucibleSourceAdvanceReceiver *receiver, const void *output, size_t bytes)
+{
+    int status = qemu_crucible_preexec_publisher_recipient_identity_v1(
+        session, recipient, receiver);
+
+    return status ? status : preexec_publisher_module_output_disjoint(output, bytes) ?
+        0 : -EINVAL;
+}
+
+int qemu_crucible_preexec_publisher_recipient_current_v1(
+    QemuCruciblePublisherSessionLender *session,
+    QemuCruciblePublisherRecipient *recipient,
+    QemuCrucibleSourceAdvanceReceiver *receiver)
+{
+    int status = qemu_crucible_preexec_publisher_recipient_identity_v1(
+        session, recipient, receiver);
+
+    if (status) {
+        return status;
+    }
+    if (!recipient->acquired || recipient->return_attempted ||
+        recipient->return_requested || recipient->consumed || recipient->uncertain) {
+        return -EPERM;
+    }
+    if (!recipient->publication.cohort.planned_count ||
+        recipient->publication.cohort.planned_count > QEMU_CRUCIBLE_ACTION_PARENT_CAPACITY) {
+        return -ESTALE;
+    }
+    for (size_t index = 0; index < recipient->publication.cohort.planned_count; index++) {
+        const PreexecPublisherRowView *view = &recipient->views[index];
+
+        if (!view->born || !view->held || view->returned || view->return_attempted ||
+            view->recipient != recipient || view->recipient_serial != recipient->serial ||
+            view->index != index ||
+            view->row != &recipient->publication.cohort.rows[index]) {
+            return -ESTALE;
+        }
+    }
+    return preexec_publisher_recipient_final(session, recipient, false, 2);
+}
+
+static void preexec_publisher_pending_copy_words(
+    const QemuCruciblePublisherRecipient *recipient,
+    uint8_t *cohort, uint8_t *command, uint64_t *serial)
+{
+    memcpy(cohort, (const uint8_t *)recipient->publication_words +
+           QEMU_CRUCIBLE_PUBLISHER_COHORT_OFFSET, QEMU_CRUCIBLE_ACTION_BYTES);
+    memcpy(command, (const uint8_t *)recipient->publication_words +
+           QEMU_CRUCIBLE_PUBLISHER_COMMAND_OFFSET,
+           QEMU_CRUCIBLE_PUBLISHER_COMMAND_BYTES);
+    *serial = recipient->serial;
+}
+
+int qemu_crucible_preexec_publisher_recipient_pending_copy_v1(
+    QemuCruciblePublisherSessionLender *session,
+    QemuCruciblePublisherRecipient *recipient,
+    QemuCrucibleSourceAdvanceReceiver *receiver,
+    uint8_t *cohort, uint8_t *command, uint64_t *recipient_serial,
+    int *first, int *post)
+{
+    int status = qemu_crucible_source_advance_pending_copy_current_v1(
+        receiver, cohort, command, recipient_serial, first, post);
+
+    if (status) {
+        return status;
+    }
+    *first = qemu_crucible_preexec_publisher_recipient_current_v1(
+        session, recipient, receiver);
+    if (!*first) {
+        /* These are the immutable bytes retained before the one acquire CAS,
+         * not another snapshot or a caller-supplied cohort reconstruction. */
+        preexec_publisher_pending_copy_words(recipient, cohort, command, recipient_serial);
+    }
+    *post = qemu_crucible_preexec_publisher_recipient_current_v1(
+        session, recipient, receiver);
+    return *first ? *first : *post;
+}
+
+int qemu_crucible_preexec_publisher_recipient_acquire_v1(
+    QemuCruciblePublisherSessionLender *session,
+    QemuCrucibleSourceAdvanceReceiver *receiver,
+    QemuCruciblePublisherRecipient **holder,
+    QemuCruciblePublisherPublicationView *publication)
+{
+    QemuCruciblePublisherRecipient *recipient;
+    uint64_t serial;
+    uint64_t expected;
+    uint64_t desired;
+    uint64_t previous_ticket;
+    int first = preexec_publisher_lender_identity(session);
+    int post;
+    int final = 0;
+    int identity;
+    bool copied = false;
+
+    if (first) {
+        return first;
+    }
+    /* Exact Source output fields are authenticated before reading or writing
+     * them. No arbitrary map, holder or decoded identity can select a session. */
+    first = qemu_crucible_source_advance_recipient_cut_v1(
+        receiver, session, holder, publication, 0);
+    if (first) {
+        return first;
+    }
+    if (!publication || *holder || session->recipient_holder ||
+        session->recipient.held || session->live_operations || session->closing ||
+        !session->member || !session->module_service ||
+        session->next_local_serial >= UINT64_MAX - 1) {
+        return -EBUSY;
+    }
+    first = preexec_publisher_recipient_read(session, PREEXEC_PUBLISHER_OBSERVE_HEADER);
+    if (!first) {
+        first = preexec_publisher_recipient_read(
+            session, PREEXEC_PUBLISHER_OBSERVE_PUBLICATION);
+    }
+    if (!first) {
+        /* Source selected this exact output field in the reciprocal above. */
+        *publication = session->publication;
+        copied = true;
+        first = qemu_crucible_source_advance_recipient_cut_v1(
+            receiver, session, holder, publication, 1);
+    }
+    recipient = &session->recipient;
+    previous_ticket = recipient->ticket_serial;
+    if (!first && (!session->publication.command_present ||
+        session->publication.permission_phase != 1)) {
+        first = -ENOKEY;
+    }
+    if (!first && recipient->acquire_attempted &&
+        session->publication.ticket_serial <= previous_ticket) {
+        first = -EALREADY;
+    }
+    if (!first) {
+        serial = ++session->next_local_serial;
+        *recipient = (QemuCruciblePublisherRecipient) {
+            .canonical_owner = recipient,
+            .holder = &session->recipient_holder,
+            .source_holder = holder,
+            .receiver = receiver,
+            .member = session->member,
+            .module_service = session->module_service,
+            .process = preexec_setup_owner.process_id,
+            .thread = preexec_setup_owner.thread_id,
+            .serial = serial,
+            .publication_sequence = publication->sequence,
+            .loan_generation = publication->loan_generation,
+            .ticket_serial = publication->ticket_serial,
+            .publication = *publication,
+            .held = true,
+        };
+        /* Both independent physical parents and the canonical recipient are
+         * retained before CAS. Failure after acquisition cannot drop them. */
+        for (size_t index = 0; index < QEMU_CRUCIBLE_PUBLISHER_PUBLICATION_BYTES / 8;
+             index++) {
+            recipient->publication_words[index] = session->snapshot[index];
+        }
+        session->recipient_holder = recipient;
+        session->live_operations++;
+        *holder = recipient;
+        expected = preexec_publisher_atomic_word(recipient->ticket_serial << 3 | 1);
+        desired = preexec_publisher_atomic_word(recipient->ticket_serial << 3 | 2);
+        recipient->acquire_attempted = true;
+        recipient->acquired = __atomic_compare_exchange_n(
+            session->mapping.address + QEMU_CRUCIBLE_PUBLISHER_RECEIVER_OFFSET / 8,
+            &expected, desired, false, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST);
+        if (!recipient->acquired) {
+            first = -ESTALE;
+        }
+        if (recipient->acquired) {
+            /* Actual issued-cohort acquisition births each local view under
+             * this retained recipient, rather than from a later copied mask. */
+            for (size_t index = 0; index < publication->cohort.planned_count; index++) {
+                PreexecPublisherRowView *view = &recipient->views[index];
+
+                *view = (PreexecPublisherRowView) {
+                    .recipient = recipient,
+                    .row = &recipient->publication.cohort.rows[index],
+                    .recipient_serial = recipient->serial,
+                    .index = index,
+                    .born = true,
+                    .held = true,
+                };
+                recipient->view_born_mask |= UINT32_C(1) << index;
+            }
+        }
+    }
+    /* Independent Source/Main/cohort post on every physically entered read,
+     * including negative first and an unsuccessful CAS. */
+    post = qemu_crucible_source_advance_recipient_cut_v1(
+        receiver, session, holder, publication, copied);
+    if (recipient->held) {
+        if (recipient->acquired) {
+            final = preexec_publisher_recipient_final(session, recipient, false, 2);
+        }
+        recipient->first_status = first;
+        recipient->independent_post_status = post;
+        recipient->final_status = final;
+        identity = qemu_crucible_preexec_publisher_recipient_identity_v1(
+            session, recipient, receiver);
+        if (!identity) {
+            identity = qemu_crucible_source_advance_recipient_cut_v1(
+                receiver, session, holder, publication, 0);
+        }
+        if (!recipient->acquired && !identity) {
+            /* Failed CAS consumed no producer borrower. This exact read tail
+             * alone returns; its attempted ticket remains recorded forever. */
+            recipient->closed = true;
+            recipient->held = false;
+            session->recipient_holder = NULL;
+            session->live_operations--;
+            *holder = NULL;
+        } else if (identity) {
+            recipient->uncertain = true;
+            recipient->return_status = identity;
+        }
+    }
+    return first ? first : post ? post : final;
+}
+
+/* Validate the complete local row inventory before the first return mutation.
+ * Readers have their own physical journals and never count as these views. */
+static int preexec_publisher_recipient_views_return(
+    QemuCruciblePublisherRecipient *recipient)
+{
+    uint32_t count = recipient->publication.cohort.planned_count;
+    uint32_t expected;
+
+    if (!count || count > QEMU_CRUCIBLE_ACTION_PARENT_CAPACITY) {
+        return -ESTALE;
+    }
+    expected = (UINT32_C(1) << count) - 1;
+    if (recipient->view_born_mask != expected || recipient->view_returned_mask) {
+        return -ESTALE;
+    }
+    for (size_t index = 0; index < QEMU_CRUCIBLE_ACTION_PARENT_CAPACITY; index++) {
+        const PreexecPublisherRowView *view = &recipient->views[index];
+
+        if (index < count) {
+            if (view->recipient != recipient || view->recipient_serial != recipient->serial ||
+                view->index != index ||
+                view->row != &recipient->publication.cohort.rows[index] ||
+                !view->born || !view->held || view->return_attempted || view->returned) {
+                return -ESTALE;
+            }
+        } else if (view->recipient || view->row || view->recipient_serial ||
+                   view->index || view->born || view->held ||
+                   view->return_attempted || view->returned) {
+            return -ESTALE;
+        }
+    }
+    for (size_t index = 0; index < count; index++) {
+        PreexecPublisherRowView *view = &recipient->views[index];
+
+        view->return_attempted = true;
+        view->row = NULL;
+        view->held = false;
+        view->returned = true;
+        recipient->view_returned_mask |= UINT32_C(1) << index;
+    }
+    return 0;
+}
+
+int qemu_crucible_preexec_publisher_recipient_no_birth_return_v1(
+    QemuCruciblePublisherSessionLender *session,
+    QemuCruciblePublisherRecipient *recipient,
+    QemuCrucibleSourceAdvanceReceiver *receiver, int first, int post)
+{
+    uint64_t *words;
+    uint64_t *shared;
+    uint64_t expected;
+    uint64_t desired;
+    uint64_t sequence;
+    int status = qemu_crucible_preexec_publisher_recipient_identity_v1(
+        session, recipient, receiver);
+    int independent;
+
+    if (status) {
+        return status;
+    }
+    status = qemu_crucible_source_advance_no_birth_current_v1(
+        receiver, session, recipient, first, post);
+    if (status) {
+        return status;
+    }
+    if (!recipient->acquired || recipient->return_attempted ||
+        recipient->return_requested || recipient->consumed || recipient->uncertain ||
+        first > 0 || post > 0 || preexec_publisher_observation_busy(session) ||
+        (session->observation.entered && !session->observation.physically_returned)) {
+        return -EBUSY;
+    }
+    if (session->next_return_sequence >= UINT64_MAX - 2) {
+        return -EOVERFLOW;
+    }
+    status = preexec_publisher_recipient_final(session, recipient, true, 2);
+    if (status) {
+        return status;
+    }
+    status = preexec_publisher_recipient_views_return(recipient);
+    if (status) {
+        return status;
+    }
+    /* Save the one physical attempt before any shared publication. No later
+     * post may resurrect these views or cause a second transition attempt. */
+    recipient->return_attempted = true;
+    sequence = session->next_return_sequence + 2;
+    session->next_return_sequence = sequence;
+    recipient->return_sequence = sequence;
+    words = recipient->return_words;
+    memset(words, 0, sizeof(recipient->return_words));
+    words[0] = preexec_publisher_atomic_word(sequence);
+    words[1] = preexec_publisher_atomic_word(recipient->ticket_serial);
+    words[2] = preexec_publisher_atomic_word(recipient->loan_generation);
+    words[3] = preexec_publisher_atomic_word(recipient->publication_sequence);
+    words[4] = preexec_publisher_atomic_word(recipient->serial);
+    words[5] = preexec_publisher_atomic_word(
+        (uint64_t)(uint32_t)first << 32 | (uint32_t)post);
+    words[6] = preexec_publisher_atomic_word(
+        (uint64_t)recipient->view_returned_mask << 32);
+    /* No semantic child was born: physical mask, outcome, units and all work
+     * coordinates remain zero. Row return is an independent real inventory. */
+    shared = session->mapping.address +
+        (QEMU_CRUCIBLE_PUBLISHER_RECEIVER_OFFSET + 8) / 8;
+    __atomic_store_n(shared, preexec_publisher_atomic_word(sequence - 1), __ATOMIC_SEQ_CST);
+    for (size_t index = 1; index < QEMU_CRUCIBLE_PUBLISHER_RETURN_BYTES / 8; index++) {
+        __atomic_store_n(shared + index, words[index], __ATOMIC_SEQ_CST);
+    }
+    __atomic_store_n(shared, words[0], __ATOMIC_SEQ_CST);
+    expected = preexec_publisher_atomic_word(recipient->ticket_serial << 3 | 2);
+    desired = preexec_publisher_atomic_word(recipient->ticket_serial << 3 | 3);
+    status = preexec_publisher_recipient_final(session, recipient, true, 2);
+    recipient->return_final_status = status;
+    if (!status) {
+        recipient->return_requested = __atomic_compare_exchange_n(
+            session->mapping.address + QEMU_CRUCIBLE_PUBLISHER_RECEIVER_OFFSET / 8,
+            &expected, desired, false, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST);
+        status = recipient->return_requested ? 0 : -ESTALE;
+    }
+    /* The physical transition is retained even when this independent local
+     * post refuses. Session and Runtime tails remain until peer consumption. */
+    independent = qemu_crucible_source_advance_no_birth_current_v1(
+        receiver, session, recipient, first, post);
+    recipient->return_status = status;
+    recipient->return_post_status = independent;
+    if (status) {
+        recipient->uncertain = true;
+    }
+    return status ? status : independent;
+}
+
+/* This is bounded observation of a producer's actual terminal transition,
+ * followed by one local consumption. EAGAIN performs no destructor or CAS. */
+int qemu_crucible_preexec_publisher_recipient_no_birth_close_v1(
+    QemuCruciblePublisherSessionLender *session,
+    QemuCruciblePublisherRecipient *recipient,
+    QemuCrucibleSourceAdvanceReceiver *receiver, int first, int post)
+{
+    const QemuCruciblePublisherTerminalView *terminal = &session->terminal;
+    uint64_t *ticket;
+    uint64_t observed;
+    uint64_t expected;
+    uint64_t desired;
+    int status = qemu_crucible_preexec_publisher_recipient_identity_v1(
+        session, recipient, receiver);
+    int independent;
+    int final = 0;
+
+    if (status) {
+        return status;
+    }
+    status = qemu_crucible_source_advance_no_birth_current_v1(
+        receiver, session, recipient, first, post);
+    if (status) {
+        return status;
+    }
+    if (!recipient->acquired || !recipient->return_attempted ||
+        !recipient->return_requested || recipient->uncertain ||
+        recipient->close_attempted ||
+        recipient->view_born_mask != recipient->view_returned_mask) {
+        return -EBUSY;
+    }
+    ticket = session->mapping.address + QEMU_CRUCIBLE_PUBLISHER_RECEIVER_OFFSET / 8;
+    observed = __atomic_load_n(ticket, __ATOMIC_SEQ_CST);
+    if (observed == preexec_publisher_atomic_word(recipient->ticket_serial << 3 | 3)) {
+        if (!recipient->close_first_status) {
+            recipient->close_first_status = -EAGAIN;
+        }
+        return -EAGAIN;
+    }
+    if (observed != preexec_publisher_atomic_word(recipient->ticket_serial << 3 | 4)) {
+        return -ESTALE;
+    }
+    status = preexec_publisher_recipient_read(session, PREEXEC_PUBLISHER_OBSERVE_TERMINAL);
+    if (!status && (terminal->ticket_serial != recipient->ticket_serial ||
+        terminal->loan_generation != recipient->loan_generation ||
+        terminal->command_sequence != recipient->publication_sequence ||
+        terminal->return_sequence != recipient->return_sequence ||
+        terminal->born_mask != recipient->view_born_mask ||
+        terminal->consumed_mask != terminal->born_mask ||
+        !terminal->command_consumption_generation)) {
+        status = -ESTALE;
+    }
+    independent = qemu_crucible_source_advance_no_birth_current_v1(
+        receiver, session, recipient, first, post);
+    /* All actual reader returns join before Closed. The retained return bytes
+     * and complete immutable command are independently checked after post. */
+    if (!status && !preexec_publisher_observation_busy(session)) {
+        const uint64_t *shared = session->mapping.address +
+            (QEMU_CRUCIBLE_PUBLISHER_RECEIVER_OFFSET + 8) / 8;
+
+        final = preexec_publisher_recipient_final(session, recipient, true, 4);
+        for (size_t index = 0; index < QEMU_CRUCIBLE_PUBLISHER_RETURN_BYTES / 8; index++) {
+            if (__atomic_load_n(shared + index, __ATOMIC_SEQ_CST) !=
+                recipient->return_words[index]) {
+                final = -ESTALE;
+            }
+        }
+        if (!final) {
+            final = preexec_publisher_observation_final(
+                session, QEMU_CRUCIBLE_PUBLISHER_TERMINAL_OFFSET);
+        }
+    } else if (!status) {
+        final = -EBUSY;
+    }
+    if (!recipient->close_first_status && status) {
+        recipient->close_first_status = status;
+    }
+    if (!recipient->close_post_status && independent) {
+        recipient->close_post_status = independent;
+    }
+    if (!recipient->close_final_status && final) {
+        recipient->close_final_status = final;
+    }
+    if (!status && !final) {
+        recipient->terminal_first_status = terminal->first_status;
+        recipient->terminal_post_status = terminal->post_status;
+        recipient->consumed = true;
+    }
+    if (status || independent || final) {
+        return status ? status : independent ? independent : final;
+    }
+    recipient->close_attempted = true;
+    expected = preexec_publisher_atomic_word(recipient->ticket_serial << 3 | 4);
+    desired = preexec_publisher_atomic_word(recipient->ticket_serial << 3 | 5);
+    if (!__atomic_compare_exchange_n(ticket, &expected, desired, false,
+                                     __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST)) {
+        recipient->uncertain = true;
+        recipient->close_status = -ESTALE;
+        return -ESTALE;
+    }
+    /* Producer consumption and this physical local return are distinct facts.
+     * Only journals are read after the canonical recipient fields are cleared. */
+    recipient->consumed = true;
+    recipient->closed = true;
+    recipient->held = false;
+    *recipient->source_holder = NULL;
+    session->recipient_holder = NULL;
+    session->live_operations--;
+    return 0;
+}
diff --git a/system/crucible-preexec-publisher-session.inc.h b/system/crucible-preexec-publisher-session.inc.h
new file mode 100644
index 0000000000000000000000000000000000000000..6e73bd7573c0a679e52a4891fd4d5f28a07fc21f
--- /dev/null
+++ b/system/crucible-preexec-publisher-session.inc.h
@@ -0,0 +1,1216 @@
+/*
+ * Actual once-owner publisher mapping and independent physical cleanup.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+static int preexec_publisher_session_identity(QemuCruciblePreexecSetupOwner *owner,
+                                             uint64_t page_size)
+{
+    const QemuCruciblePublisherPurpose *purpose = &owner->plan.subscription;
+    const uint8_t *payload = owner->frame + QEMU_CRUCIBLE_PREEXEC_SETUP_PAYLOAD_OFFSET;
+    uint64_t backing;
+    int status = preexec_publisher_storage_current(owner);
+
+    if (status) {
+        return status;
+    }
+    if (!owner->frame_validated || !owner->plan_validated ||
+        owner->selected_edition != 6 || owner->plan.schema != 9 ||
+        owner->frame[4] != QEMU_CRUCIBLE_PREEXEC_SETUP_TAG_V6 ||
+        owner->source_published || !owner->limits_corroborated ||
+        !owner->cgroup_corroborated || !owner->family_corroborated ||
+        !owner->artifact_verified || !owner->identity_corroborated ||
+        !owner->fixed_family.retained || owner->fixed_family.issuer != owner ||
+        !owner->fixed_family.source.retained ||
+        owner->fixed_family.source.process != owner->process_id ||
+        owner->fixed_family.source.process_generation != owner->incarnation.generation ||
+        owner->incarnation.assignment != &owner->fixed_family.source ||
+        preexec_setup_syscall5(SYS_getpid, 0, 0, 0, 0, 0) != owner->process_id ||
+        preexec_setup_syscall5(SYS_gettid, 0, 0, 0, 0, 0) != owner->thread_id) {
+        return -EPERM;
+    }
+    if (!page_size || (page_size & (page_size - 1)) ||
+        page_size - 1 > UINT64_MAX - QEMU_CRUCIBLE_PUBLISHER_REGION_BYTES) {
+        return -EOVERFLOW;
+    }
+    backing = (QEMU_CRUCIBLE_PUBLISHER_REGION_BYTES + page_size - 1) & ~(page_size - 1);
+    if (purpose->cleanup_generation != owner->publisher_storage.cleanup_generation ||
+        purpose->backing_bytes != backing || purpose->native_debit != backing ||
+        purpose->lender_generation != preexec_setup_be64(payload + 56) ||
+        purpose->region_bytes != preexec_setup_be64(payload + 64) ||
+        purpose->device != preexec_setup_be64(payload + 72) ||
+        purpose->inode != preexec_setup_be64(payload + 80) ||
+        purpose->producer_event != preexec_setup_be64(payload + 88) ||
+        purpose->receiver_event != preexec_setup_be64(payload + 96) ||
+        purpose->account_generation != owner->fixed_family.account_generation ||
+        purpose->process_generation != owner->incarnation.generation ||
+        preexec_setup_compare(purpose->capability,
+            owner->fixed_family.containing_capability, 32) ||
+        preexec_setup_compare(purpose->reservation,
+            owner->fixed_family.source.material.assignment_id, 32) ||
+        purpose->region_bytes > owner->plan.purpose.writable_file_limit) {
+        return -ESTALE;
+    }
+    return 0;
+}
+
+static int preexec_publisher_alias_observe(PreexecPublisherAliasJournal *alias,
+                                           size_t role,
+                                           const QemuCruciblePublisherPurpose *purpose)
+{
+    long status = preexec_setup_syscall5(SYS_fstat, alias->descriptor,
+        (long)(uintptr_t)&alias->identity, 0, 0, 0);
+
+    if (status < 0) {
+        return status;
+    }
+    status = preexec_setup_syscall5(SYS_fcntl, alias->descriptor, F_GETFD, 0, 0, 0);
+    if (status < 0) {
+        return status;
+    }
+    if (!(status & FD_CLOEXEC)) {
+        return -EPERM;
+    }
+    status = preexec_setup_syscall5(SYS_fcntl, alias->descriptor, F_GETFL, 0, 0, 0);
+    if (status < 0) {
+        return status;
+    }
+    if (role == 0) {
+        if ((status & O_ACCMODE) != O_RDWR || !S_ISREG(alias->identity.st_mode) ||
+            alias->identity.st_size != purpose->region_bytes ||
+            alias->identity.st_dev != purpose->device ||
+            alias->identity.st_ino != purpose->inode) {
+            return -ESTALE;
+        }
+        /* Exactly immutable geometry, while both processes retain writable
+         * atomic words. WRITE/FUTURE_WRITE and unknown seals cannot qualify. */
+        status = preexec_setup_syscall5(SYS_fcntl, alias->descriptor, 1034, 0, 0, 0);
+        return status < 0 ? status : status == (1 | 2 | 4) ? 0 : -EPERM;
+    }
+    if (!(status & O_NONBLOCK)) {
+        return -EPERM;
+    }
+    status = preexec_setup_fd_event_id(alias->descriptor, &alias->event_token);
+    if (status) {
+        return status;
+    }
+    return alias->event_token == (role == 1 ? purpose->producer_event :
+                                             purpose->receiver_event) ? 0 : -ESTALE;
+}
+
+static bool preexec_publisher_observation_busy(
+    const PreexecPublisherSessionJournal *session)
+{
+    return session->snapshot_busy || session->observation_holder ||
+        session->observation.held;
+}
+
+static int preexec_publisher_observation_parent(
+    PreexecPublisherSessionJournal *session)
+{
+    QemuCruciblePreexecSetupOwner *owner = &preexec_setup_owner;
+    PreexecPublisherStoragePurpose *storage = &owner->publisher_storage;
+    int status = preexec_publisher_storage_identity(owner);
+
+    if (status || session != &storage->session) {
+        return status ? status : -EPERM;
+    }
+    if (preexec_setup_syscall5(SYS_getpid, 0, 0, 0, 0, 0) != storage->process ||
+        preexec_setup_syscall5(SYS_gettid, 0, 0, 0, 0, 0) != storage->thread ||
+        !session->held || session->holder != &storage->cleanup_session ||
+        storage->cleanup_session != session || session->physically_returned ||
+        !session->native_retained ||
+        session->native_debit != owner->plan.subscription.backing_bytes ||
+        session->cleanup_generation != storage->cleanup_generation ||
+        session->lender_generation != owner->plan.subscription.lender_generation ||
+        !session->mapping.retained || !session->mapping.dontfork ||
+        session->mapping.unmap_attempted ||
+        session->mapping.backing_bytes != owner->plan.subscription.backing_bytes ||
+        session->mapping.requested_bytes != QEMU_CRUCIBLE_PUBLISHER_REGION_BYTES) {
+        return -ESTALE;
+    }
+    for (size_t index = 0; index < 3; index++) {
+        if (!session->aliases[index].received || session->aliases[index].close_attempted) {
+            return -ESTALE;
+        }
+    }
+    return 0;
+}
+
+static int preexec_publisher_observation_identity(
+    PreexecPublisherSessionJournal *session)
+{
+    int status = preexec_publisher_observation_parent(session);
+    PreexecPublisherObservationJournal *observation;
+
+    if (status) {
+        return status;
+    }
+    observation = &session->observation;
+    return observation->canonical_owner == observation && observation->held &&
+        observation->holder == &session->observation_holder &&
+        session->observation_holder == observation && session->snapshot_busy &&
+        observation->process == preexec_setup_owner.process_id &&
+        observation->thread == preexec_setup_owner.thread_id &&
+        observation->module_service == session->module_service &&
+        observation->serial && observation->serial != UINT64_MAX &&
+        !observation->physically_returned ? 0 : -ESTALE;
+}
+
+/* Exact canonical spans only. This leaf neither probes backing nor issues a
+ * read loan; its caller must first retain the real session and scratch. */
+static int preexec_publisher_observation_geometry(
+    const PreexecPublisherSessionJournal *session, size_t *offset, size_t *bytes)
+{
+    uintptr_t mapping = (uintptr_t)session->mapping.address;
+    uintptr_t owner = (uintptr_t)&preexec_setup_owner;
+
+    switch (session->observation.kind) {
+    case PREEXEC_PUBLISHER_OBSERVE_HEADER:
+        *offset = 0;
+        *bytes = QEMU_CRUCIBLE_PUBLISHER_HEADER_BYTES;
+        break;
+    case PREEXEC_PUBLISHER_OBSERVE_PUBLICATION:
+        *offset = QEMU_CRUCIBLE_PUBLISHER_PUBLICATION_OFFSET;
+        *bytes = QEMU_CRUCIBLE_PUBLISHER_PUBLICATION_BYTES;
+        break;
+    case PREEXEC_PUBLISHER_OBSERVE_RETURN:
+        *offset = QEMU_CRUCIBLE_PUBLISHER_RECEIVER_OFFSET + sizeof(uint64_t);
+        *bytes = QEMU_CRUCIBLE_PUBLISHER_RETURN_BYTES;
+        break;
+    case PREEXEC_PUBLISHER_OBSERVE_TERMINAL:
+        *offset = QEMU_CRUCIBLE_PUBLISHER_TERMINAL_OFFSET;
+        *bytes = QEMU_CRUCIBLE_PUBLISHER_TERMINAL_BYTES;
+        break;
+    default:
+        return -EINVAL;
+    }
+    if (session->mapping.requested_bytes != QEMU_CRUCIBLE_PUBLISHER_REGION_BYTES ||
+        session->mapping.requested_bytes >
+            UINTPTR_MAX - (uintptr_t)session->mapping.address ||
+        *offset > session->mapping.requested_bytes ||
+        *bytes > session->mapping.requested_bytes - *offset ||
+        *bytes > sizeof(session->snapshot)) {
+        return -EOVERFLOW;
+    }
+    if (!mapping || (mapping < owner + sizeof(preexec_setup_owner) &&
+                     owner < mapping + session->mapping.requested_bytes)) {
+        return -EINVAL;
+    }
+    if (mapping % sizeof(uint64_t) ||
+        !__atomic_is_lock_free(8, session->mapping.address)) {
+        return -ENOTSUP;
+    }
+    return 0;
+}
+
+static int preexec_publisher_observation_sequence(
+    PreexecPublisherSessionJournal *session, size_t offset)
+{
+    uint64_t word = __atomic_load_n(session->mapping.address + offset / 8,
+                                    __ATOMIC_SEQ_CST);
+    uint64_t sequence = preexec_setup_be64((const uint8_t *)&word);
+
+    return sequence == session->observation.sequence ? 0 : -ESTALE;
+}
+
+static int preexec_publisher_observation_copy(
+    PreexecPublisherSessionJournal *session, size_t offset, size_t bytes)
+{
+    PreexecPublisherObservationJournal *observation = &session->observation;
+    const uint64_t *source = session->mapping.address + offset / 8;
+
+    session->snapshot[0] = __atomic_load_n(source, __ATOMIC_SEQ_CST);
+    observation->sequence = preexec_setup_be64((const uint8_t *)session->snapshot);
+    if (observation->kind != PREEXEC_PUBLISHER_OBSERVE_HEADER) {
+        if (!observation->sequence) {
+            return -ENODATA;
+        }
+        if (observation->sequence & 1) {
+            return -EBUSY;
+        }
+    }
+    for (size_t index = 1; index < bytes / 8; index++) {
+        session->snapshot[index] = __atomic_load_n(source + index, __ATOMIC_SEQ_CST);
+    }
+    if (observation->kind != PREEXEC_PUBLISHER_OBSERVE_HEADER) {
+        return preexec_publisher_observation_sequence(session, offset);
+    }
+    /* The immutable header has no seqlock. Its producer contract also fixes
+     * this trailing region padding; keep these reads inside the same loan. */
+    for (size_t index = 2816 / 8; index < QEMU_CRUCIBLE_PUBLISHER_REGION_BYTES / 8;
+         index++) {
+        if (__atomic_load_n(session->mapping.address + index, __ATOMIC_SEQ_CST)) {
+            return -EPROTO;
+        }
+    }
+    return 0;
+}
+
+static int preexec_publisher_observation_decode(
+    PreexecPublisherSessionJournal *session, size_t bytes)
+{
+    const uint8_t *wire = (const uint8_t *)session->snapshot;
+    PreexecPublisherObservationValue *pending = &session->observation.pending;
+    const QemuCruciblePublisherPurpose *purpose = &preexec_setup_owner.plan.subscription;
+    QemuCruciblePublisherHeaderView *header = &pending->header;
+    int status;
+
+    switch (session->observation.kind) {
+    case PREEXEC_PUBLISHER_OBSERVE_HEADER:
+        status = preexec_literal_qemu_crucible_publisher_header_decode_v1(
+            wire, bytes, header);
+        if (status) {
+            return status;
+        }
+        return header->lender_generation == purpose->lender_generation &&
+            header->account_generation == purpose->account_generation &&
+            header->process_generation == purpose->process_generation &&
+            !preexec_setup_compare(header->source_capability, purpose->capability, 32) &&
+            !preexec_setup_compare(header->source_reservation, purpose->reservation, 32) ?
+            0 : -ESTALE;
+    case PREEXEC_PUBLISHER_OBSERVE_PUBLICATION:
+        return preexec_literal_qemu_crucible_publisher_publication_decode_v1(
+            wire, bytes, &pending->publication);
+    case PREEXEC_PUBLISHER_OBSERVE_RETURN:
+        return preexec_literal_qemu_crucible_publisher_return_decode_v1(
+            wire, bytes, &pending->returned);
+    case PREEXEC_PUBLISHER_OBSERVE_TERMINAL:
+        return preexec_literal_qemu_crucible_publisher_terminal_decode_v1(
+            wire, bytes, &pending->terminal);
+    default:
+        return -EINVAL;
+    }
+}
+
+static int preexec_publisher_observation_final(
+    PreexecPublisherSessionJournal *session, size_t offset)
+{
+    if (session->observation.kind != PREEXEC_PUBLISHER_OBSERVE_HEADER) {
+        return preexec_publisher_observation_sequence(session, offset);
+    }
+    for (size_t index = 0; index < QEMU_CRUCIBLE_PUBLISHER_HEADER_BYTES / 8; index++) {
+        if (__atomic_load_n(session->mapping.address + index, __ATOMIC_SEQ_CST) !=
+            session->snapshot[index]) {
+            return -ESTALE;
+        }
+    }
+    for (size_t index = 2816 / 8; index < QEMU_CRUCIBLE_PUBLISHER_REGION_BYTES / 8;
+         index++) {
+        if (__atomic_load_n(session->mapping.address + index, __ATOMIC_SEQ_CST)) {
+            return -EPROTO;
+        }
+    }
+    return 0;
+}
+
+/* One callback-free local return. A failed first/post is not a physical debt,
+ * but a missing canonical holder or interrupted reader remains retained. */
+static int preexec_publisher_observation_return(
+    PreexecPublisherSessionJournal *session, int identity)
+{
+    PreexecPublisherObservationJournal *observation = &session->observation;
+
+    if (observation->physically_returned) {
+        return observation->held || session->observation_holder ? -ESTALE : 0;
+    }
+    if (identity || (observation->entered && !observation->read_returned)) {
+        return identity ? identity : -EBUSY;
+    }
+    observation->physically_returned = true;
+    observation->held = false;
+    session->observation_holder = NULL;
+    session->snapshot_busy = false;
+    return 0;
+}
+
+static int preexec_publisher_observation_take(
+    PreexecPublisherSessionJournal *session, PreexecPublisherObservationKind kind)
+{
+    PreexecPublisherObservationJournal *observation;
+    size_t offset = 0;
+    size_t bytes = 0;
+    uint64_t serial;
+    int first = preexec_publisher_observation_parent(session);
+    int post;
+    int identity;
+    int final = 0;
+    int returned;
+
+    if (first) {
+        return first;
+    }
+    if (session->closing || preexec_publisher_observation_busy(session)) {
+        return -EBUSY;
+    }
+    observation = &session->observation;
+    serial = observation->serial;
+    if (serial >= UINT64_MAX - 1) {
+        return -EOVERFLOW;
+    }
+    *observation = (PreexecPublisherObservationJournal) {
+        .canonical_owner = observation,
+        .holder = &session->observation_holder,
+        .module_service = session->module_service,
+        .process = preexec_setup_owner.process_id,
+        .thread = preexec_setup_owner.thread_id,
+        .serial = serial + 1,
+        .kind = kind,
+        .held = true,
+    };
+    session->observation_holder = observation;
+    session->snapshot_busy = true;
+    first = preexec_setup_original_live();
+    if (!first) {
+        first = preexec_publisher_observation_geometry(session, &offset, &bytes);
+    }
+    if (!first) {
+        observation->entered = true;
+        first = preexec_publisher_observation_copy(session, offset, bytes);
+        observation->read_returned = true;
+    }
+    if (!first) {
+        first = preexec_publisher_observation_decode(session, bytes);
+    }
+    /* Independent post runs on every retained outcome. A failed first never
+     * skips the final sequence observation or restores any operation grant. */
+    post = preexec_setup_original_live();
+    identity = preexec_publisher_observation_identity(session);
+    if (observation->entered && !identity) {
+        final = preexec_publisher_observation_final(session, offset);
+    }
+    observation->first_status = first;
+    observation->post_status = post;
+    observation->final_status = final;
+    observation->identity_status = identity;
+    returned = preexec_publisher_observation_return(session, identity);
+    observation->return_status = returned;
+    if (first || post || final || returned) {
+        return first ? first : post ? post : final ? final : returned;
+    }
+    /* These are factual service caches only; no producing caller receives
+     * a cohort, Original, scheduler tuple or ticket permission from them. */
+    switch (kind) {
+    case PREEXEC_PUBLISHER_OBSERVE_HEADER:
+        session->header = observation->pending.header;
+        break;
+    case PREEXEC_PUBLISHER_OBSERVE_PUBLICATION:
+        session->publication = observation->pending.publication;
+        break;
+    case PREEXEC_PUBLISHER_OBSERVE_RETURN:
+        session->returned = observation->pending.returned;
+        break;
+    case PREEXEC_PUBLISHER_OBSERVE_TERMINAL:
+        session->terminal = observation->pending.terminal;
+        break;
+    }
+    return 0;
+}
+
+static int preexec_publisher_mapping_observe(PreexecPublisherSessionJournal *session,
+                                            const QemuCruciblePublisherPurpose *purpose)
+{
+    if (purpose != &preexec_setup_owner.plan.subscription) {
+        return -ESTALE;
+    }
+    return preexec_publisher_observation_take(session, PREEXEC_PUBLISHER_OBSERVE_HEADER);
+}
+
+/* Setup owns an unpublished region. Later service observations deliberately
+ * leave these mutable spans to the recipient protocol rather than interpreting
+ * nonzero bytes as either padding or an activation receipt. */
+static int preexec_publisher_mapping_initial_zero(
+    PreexecPublisherSessionJournal *session)
+{
+    PreexecPublisherMappingJournal *mapping = &session->mapping;
+    uintptr_t address = (uintptr_t)mapping->address;
+
+    if (!mapping->retained || !mapping->dontfork || mapping->unmap_attempted ||
+        !address || address % sizeof(uint64_t) ||
+        address > UINTPTR_MAX - QEMU_CRUCIBLE_PUBLISHER_REGION_BYTES ||
+        mapping->backing_bytes < QEMU_CRUCIBLE_PUBLISHER_REGION_BYTES ||
+        mapping->requested_bytes != QEMU_CRUCIBLE_PUBLISHER_REGION_BYTES) {
+        return -ESTALE;
+    }
+    for (size_t index = QEMU_CRUCIBLE_PUBLISHER_HEADER_BYTES / 8;
+         index < 2816 / 8; index++) {
+        if (__atomic_load_n(mapping->address + index, __ATOMIC_SEQ_CST)) {
+            return -EPROTO;
+        }
+    }
+    return 0;
+}
+
+/* Physical producers/destructors used only after the canonical constructor's
+ * paid admission. These bodies grant no purpose, operation or callback loan. */
+static int preexec_publisher_mapping_acquire(PreexecPublisherMappingJournal *journal,
+                                            int descriptor, uint64_t requested,
+                                            uint64_t backing)
+{
+    long mapping;
+
+    if (journal->attempted) {
+        return -EALREADY;
+    }
+    journal->attempted = true;
+    journal->requested_bytes = requested;
+    journal->backing_bytes = backing;
+    mapping = preexec_setup_syscall6(SYS_mmap, 0, requested,
+        PROT_READ | PROT_WRITE, MAP_SHARED, descriptor, 0);
+    if (mapping < 0 && mapping >= -4095) {
+        journal->first_status = mapping;
+    } else {
+        journal->address = (uint64_t *)(uintptr_t)mapping;
+        journal->retained = true;
+        journal->first_status = preexec_setup_syscall5(SYS_madvise, mapping,
+            requested, MADV_DONTFORK, 0, 0);
+        journal->dontfork = !journal->first_status;
+    }
+    return journal->first_status;
+}
+
+static int preexec_publisher_mapping_return(PreexecPublisherMappingJournal *journal)
+{
+    if (!journal->retained) {
+        return 0;
+    }
+    if (!journal->unmap_attempted) {
+        journal->unmap_attempted = true;
+        journal->return_status = preexec_setup_syscall5(SYS_munmap,
+            (long)(uintptr_t)journal->address, journal->requested_bytes, 0, 0, 0);
+        journal->physically_returned = !journal->return_status;
+        journal->uncertain = !journal->physically_returned;
+    }
+    return journal->return_status;
+}
+
+static int preexec_publisher_alias_return(PreexecPublisherAliasJournal *alias)
+{
+    if (!alias->received) {
+        return 0;
+    }
+    if (!alias->close_attempted) {
+        alias->close_attempted = true;
+        alias->return_status = preexec_setup_syscall5(SYS_close,
+            alias->descriptor, 0, 0, 0, 0);
+        alias->physically_returned = !alias->return_status;
+        alias->uncertain = !alias->physically_returned;
+    }
+    return alias->return_status;
+}
+
+static int preexec_publisher_session_construct(QemuCruciblePreexecSetupOwner *owner,
+                                              uint64_t page_size)
+{
+    PreexecPublisherStoragePurpose *storage = &preexec_setup_owner.publisher_storage;
+    PreexecPublisherSessionJournal *session = &storage->session;
+    const QemuCruciblePublisherPurpose *purpose = &preexec_setup_owner.plan.subscription;
+    size_t base;
+    int status;
+
+    /* Plan8 is the unchanged absence case. No decoded record, supplied mapping
+     * or external caller can install this canonical session cleanup holder. */
+    if (owner == &preexec_setup_owner && owner->plan.schema == 8) {
+        return 0;
+    }
+    if (owner != &preexec_setup_owner || session->attempted || storage->cleanup_session) {
+        return -EPERM;
+    }
+    status = preexec_publisher_session_identity(owner, page_size);
+    if (status) {
+        return status;
+    }
+    session->attempted = true;
+    session->held = true;
+    session->holder = &storage->cleanup_session;
+    storage->cleanup_session = session;
+    session->lender_generation = purpose->lender_generation;
+    session->cleanup_generation = storage->cleanup_generation;
+    session->first_status = preexec_setup_original_live();
+    if (!session->first_status) {
+        status = preexec_setup_provisional_native(purpose->backing_bytes);
+        if (!status) {
+            session->native_debit = purpose->backing_bytes;
+            session->native_retained = true;
+            base = owner->plan.workspace_bytes ? 6 : 5;
+            /* Transfer the actual once-received aliases, without dup. The raw
+             * roster slot is consumed; future member editions must borrow the
+             * retained session rather than treating that slot as a new owner. */
+            for (size_t index = 0; index < 3; index++) {
+                session->aliases[index].descriptor = owner->descriptors[base + index];
+                session->aliases[index].received = true;
+                owner->descriptors[base + index] = -1;
+            }
+            for (size_t index = 0; !status && index < 3; index++) {
+                status = preexec_publisher_alias_observe(&session->aliases[index],
+                                                         index, purpose);
+                session->aliases[index].first_status = status;
+            }
+        }
+        session->first_status = status;
+    }
+    if (!session->first_status) {
+        PreexecPublisherMappingJournal *journal = &session->mapping;
+
+        status = preexec_publisher_mapping_acquire(journal,
+            session->aliases[0].descriptor, purpose->region_bytes, purpose->backing_bytes);
+        if (!status) {
+            journal->first_status = preexec_publisher_mapping_observe(session, purpose);
+            if (!journal->first_status) {
+                journal->first_status = preexec_publisher_mapping_initial_zero(session);
+            }
+        }
+        session->first_status = journal->first_status;
+    }
+    /* Independent on every retained outcome, including initial refusal or a
+     * failed alias/mmap/DONTFORK/header check. First is never overwritten. */
+    session->post_status = preexec_setup_original_live();
+    return session->first_status ? session->first_status : session->post_status;
+}
+
+static int preexec_publisher_session_current(QemuCruciblePreexecSetupOwner *owner)
+{
+    PreexecPublisherStoragePurpose *storage = &owner->publisher_storage;
+    PreexecPublisherSessionJournal *session = &storage->session;
+
+    if (owner->plan.schema == 8) {
+        return 0;
+    }
+    if (owner->plan.schema != 9 || !session->attempted || !session->held ||
+        session->holder != &storage->cleanup_session || *session->holder != session ||
+        session->closing || session->physically_returned || !session->native_retained ||
+        session->native_debit != owner->plan.subscription.backing_bytes ||
+        session->cleanup_generation != storage->cleanup_generation ||
+        session->lender_generation != owner->plan.subscription.lender_generation ||
+        !session->mapping.retained || !session->mapping.dontfork ||
+        session->mapping.unmap_attempted) {
+        return -ESTALE;
+    }
+    for (size_t index = 0; index < 3; index++) {
+        if (!session->aliases[index].received || session->aliases[index].close_attempted) {
+            return -ESTALE;
+        }
+    }
+    return session->first_status ? session->first_status : session->post_status;
+}
+
+static bool preexec_publisher_module_observation_busy(
+    const PreexecPublisherSessionJournal *session)
+{
+    return session->module_borrowed &&
+        (session->module_observation.descriptor >= 0 ||
+         session->module_observation.close_uncertain);
+}
+
+/* Factual debt predicates only. Calling these cannot authenticate a lender,
+ * enter an operation or prove any producer membership physically returned. */
+static bool preexec_publisher_session_busy(const PreexecPublisherSessionJournal *session)
+{
+    return session->source_holder || session->member || session->module_service ||
+        preexec_publisher_module_observation_busy(session) ||
+        session->live_operations || session->recipient_holder ||
+        session->recipient.held || preexec_publisher_observation_busy(session);
+}
+
+static int preexec_publisher_member_drop(PreexecPublisherSessionJournal *session,
+                                         const void *member)
+{
+    if (!member || session->live_operations || session->recipient_holder ||
+        session->recipient.held || preexec_publisher_observation_busy(session) ||
+        (session->member_borrowed && !session->member_returned && session->member != member)) {
+        return -EBUSY;
+    }
+    session->member = NULL;
+    session->member_returned = true;
+    return 0;
+}
+
+static int preexec_publisher_session_return(QemuCruciblePreexecSetupOwner *owner)
+{
+    PreexecPublisherStoragePurpose *storage = &preexec_setup_owner.publisher_storage;
+    PreexecPublisherSessionJournal *session = &storage->session;
+    PreexecPublisherMappingJournal *mapping = &session->mapping;
+    bool closed = true;
+    int result = 0;
+
+    if (owner != &preexec_setup_owner || storage->canonical_owner != storage ||
+        !storage->retained || storage->issuer != owner ||
+        storage->assignment != &owner->fixed_family.source ||
+        storage->cleanup_generation != session->cleanup_generation ||
+        !session->attempted ||
+        preexec_setup_syscall5(SYS_getpid, 0, 0, 0, 0, 0) != storage->process ||
+        preexec_setup_syscall5(SYS_gettid, 0, 0, 0, 0, 0) != storage->thread) {
+        return -EPERM;
+    }
+    if (!session->held) {
+        return session->physically_returned ? session->return_status : -ENOENT;
+    }
+    if (session->holder != &storage->cleanup_session || *session->holder != session ||
+        preexec_publisher_session_busy(session)) {
+        return -EBUSY;
+    }
+    if (!session->closing) {
+        session->cleanup_first_status = preexec_setup_original_live();
+    }
+    session->closing = true;
+    if (mapping->retained && !mapping->unmap_attempted) {
+        preexec_publisher_mapping_return(mapping);
+        mapping->post_status = preexec_setup_original_live();
+    }
+    if (mapping->retained) {
+        closed = mapping->physically_returned;
+        result = mapping->return_status ? mapping->return_status : mapping->post_status;
+    }
+    /* Reverse dependency order: eventfd aliases, then the region descriptor.
+     * After close, only the external inline journal is read. A negative post
+     * cannot resurrect an actually consumed alias or invoke close again. */
+    for (size_t remaining = 3; remaining; remaining--) {
+        PreexecPublisherAliasJournal *alias = &session->aliases[remaining - 1];
+
+        if (!alias->received) {
+            continue;
+        }
+        if (!alias->close_attempted) {
+            preexec_publisher_alias_return(alias);
+            alias->post_status = preexec_setup_original_live();
+        }
+        closed = closed && alias->physically_returned;
+        if (!result) {
+            result = alias->return_status ? alias->return_status : alias->post_status;
+        }
+    }
+    if (!session->cleanup_post_observed) {
+        session->cleanup_post_status = preexec_setup_original_live();
+        session->cleanup_post_observed = true;
+    }
+    if (closed) {
+        session->physically_returned = true;
+        session->held = false;
+        *session->holder = NULL;
+    }
+    session->return_status = session->cleanup_first_status ?
+        session->cleanup_first_status : result ? result :
+        session->cleanup_post_status ? session->cleanup_post_status :
+        closed ? 0 : -EINPROGRESS;
+    return session->return_status;
+}
+
+/* The Source reciprocal names its real root and retained command child. It
+ * cannot select a different mapping or turn an observation into membership. */
+static int preexec_publisher_lender_identity(QemuCruciblePublisherSessionLender *lender)
+{
+    QemuCruciblePreexecSetupOwner *owner = &preexec_setup_owner;
+    PreexecPublisherStoragePurpose *storage = &owner->publisher_storage;
+
+    if (lender != &storage->session || !lender->source_borrowed ||
+        lender->source_returned || !lender->source_holder ||
+        preexec_setup_syscall5(SYS_getpid, 0, 0, 0, 0, 0) != storage->process ||
+        preexec_setup_syscall5(SYS_gettid, 0, 0, 0, 0, 0) != storage->thread ||
+        storage->canonical_owner != storage || !storage->retained ||
+        storage->issuer != owner || storage->assignment != &owner->fixed_family.source ||
+        storage->cleanup_generation != lender->cleanup_generation ||
+        !lender->held || lender->holder != &storage->cleanup_session ||
+        storage->cleanup_session != lender || lender->physically_returned) {
+        return -ESTALE;
+    }
+    int status = qemu_crucible_startup_source_publisher_receiver_identity_v1(
+        owner, lender->source_holder, NULL, 0, NULL);
+
+    return status ? status : *lender->source_holder == lender ? 0 : -ESTALE;
+}
+
+int qemu_crucible_preexec_publisher_recipient_identity_v1(
+    QemuCruciblePublisherSessionLender *lender,
+    QemuCruciblePublisherRecipient *recipient,
+    QemuCrucibleSourceAdvanceReceiver *receiver)
+{
+    int status = preexec_publisher_lender_identity(lender);
+
+    if (status) {
+        return status;
+    }
+    if (recipient != &lender->recipient || !recipient->held ||
+        recipient->canonical_owner != recipient ||
+        recipient->holder != &lender->recipient_holder ||
+        lender->recipient_holder != recipient || lender->live_operations != 1 ||
+        !recipient->source_holder || *recipient->source_holder != recipient ||
+        !receiver || recipient->receiver != receiver ||
+        recipient->member != lender->member ||
+        recipient->module_service != lender->module_service ||
+        !lender->member_borrowed || lender->member_returned ||
+        !lender->module_borrowed || lender->module_returned ||
+        !recipient->serial || recipient->serial == UINT64_MAX ||
+        recipient->process != preexec_setup_owner.process_id ||
+        recipient->thread != preexec_setup_owner.thread_id || recipient->closed) {
+        return -ESTALE;
+    }
+    return preexec_publisher_observation_parent(lender);
+}
+
+int qemu_crucible_preexec_publisher_lender_borrow_v1(
+    QemuCruciblePreexecPurposeOwner *issuer,
+    QemuCruciblePublisherSessionLender **holder)
+{
+    QemuCruciblePreexecSetupOwner *owner = &preexec_setup_owner;
+    PreexecPublisherSessionJournal *session = &owner->publisher_storage.session;
+    int status;
+
+    if (issuer != owner || !holder) {
+        return -EPERM;
+    }
+    status = qemu_crucible_startup_source_publisher_receiver_identity_v1(
+        issuer, holder, NULL, 0, NULL);
+    if (status) {
+        return status;
+    }
+    if (owner->plan.schema == 8) {
+        return *holder ? -ESTALE : 0;
+    }
+    status = qemu_crucible_preexec_purpose_check_v3(issuer);
+    if (status) {
+        return status;
+    }
+    if (*holder || session->source_borrowed || session->source_returned) {
+        return -EALREADY;
+    }
+    /* Actual debt/holder is installed before either fallible Original check.
+     * A negative first/post preserves this child for independent cleanup. */
+    session->source_borrowed = true;
+    session->source_holder = holder;
+    *holder = session;
+    session->source_first_status = preexec_setup_original_live();
+    session->source_post_status = preexec_setup_original_live();
+    return session->source_first_status ? session->source_first_status :
+        session->source_post_status;
+}
+
+int qemu_crucible_preexec_publisher_lender_current_v1(
+    QemuCruciblePublisherSessionLender *lender)
+{
+    int status = preexec_publisher_lender_identity(lender);
+
+    if (!status) {
+        status = preexec_publisher_session_current(&preexec_setup_owner);
+    }
+    return status ? status : lender->source_first_status ?
+        lender->source_first_status : lender->source_post_status;
+}
+
+int qemu_crucible_preexec_publisher_member_borrow_v1(
+    QemuCruciblePublisherSessionLender *lender, const void *member)
+{
+    int status = qemu_crucible_preexec_publisher_lender_current_v1(lender);
+
+    if (!status) {
+        status = qemu_crucible_startup_source_publisher_receiver_identity_v1(
+            &preexec_setup_owner, lender->source_holder, member, 0, NULL);
+    }
+    if (status) {
+        return status;
+    }
+    if (!member || lender->member_borrowed || lender->member_returned) {
+        return -EALREADY;
+    }
+    lender->member_borrowed = true;
+    lender->member = member;
+    lender->member_first_status = preexec_setup_original_live();
+    lender->member_post_status = preexec_setup_original_live();
+    return lender->member_first_status ? lender->member_first_status :
+        lender->member_post_status;
+}
+
+int qemu_crucible_preexec_publisher_member_current_v1(
+    QemuCruciblePublisherSessionLender *lender, const void *member)
+{
+    int status = qemu_crucible_preexec_publisher_lender_current_v1(lender);
+
+    if (status) {
+        return status;
+    }
+    if (!member || !lender->member_borrowed || lender->member_returned ||
+        lender->member != member) {
+        return -ESTALE;
+    }
+    return lender->member_first_status ? lender->member_first_status :
+        lender->member_post_status;
+}
+
+int qemu_crucible_preexec_publisher_member_return_v1(
+    QemuCruciblePublisherSessionLender *lender, const void *member, int *returned)
+{
+    int status = preexec_publisher_lender_identity(lender);
+
+    if (!status) {
+        status = qemu_crucible_startup_source_publisher_receiver_identity_v1(
+            &preexec_setup_owner, lender->source_holder, member, 1, returned);
+    }
+    if (status) {
+        return status;
+    }
+    if (!returned || !member || lender->live_operations || lender->recipient_holder ||
+        lender->recipient.held || preexec_publisher_observation_busy(lender) ||
+        (lender->member_borrowed && !lender->member_returned && lender->member != member)) {
+        return -EBUSY;
+    }
+    if (lender->member_returned) {
+        *returned = 1;
+        return lender->member_return_first ? lender->member_return_first :
+            lender->member_return_post;
+    }
+    /* Authenticated not-entered cleanup closes only this local receiver child;
+     * it records no module callback-return or producer consumption fact. */
+    lender->member_return_first = preexec_setup_original_live();
+    /* This local child has no destructor callback or kernel release. Removing
+     * its exact retained pointer is its physical return, even on negative post.
+     * The distinct Source/session cleanup holder remains retained throughout. */
+    status = preexec_publisher_member_drop(lender, member);
+    lender->member_return_post = preexec_setup_original_live();
+    *returned = lender->member_returned;
+    return lender->member_return_first ? lender->member_return_first :
+        status ? status : lender->member_return_post;
+}
+
+int qemu_crucible_preexec_publisher_lender_return_v1(
+    QemuCruciblePreexecPurposeOwner *issuer,
+    QemuCruciblePublisherSessionLender **holder)
+{
+    QemuCruciblePreexecSetupOwner *owner = &preexec_setup_owner;
+    PreexecPublisherSessionJournal *session = &owner->publisher_storage.session;
+    int status;
+
+    if (issuer != owner || !holder) {
+        return -EPERM;
+    }
+    /* Authenticate the exact Source field before even the absent-plan read;
+     * an arbitrary nominated holder is not a readable borrower coordinate. */
+    status = qemu_crucible_startup_source_publisher_receiver_identity_v1(
+        issuer, holder, NULL, 1, NULL);
+    if (status) {
+        return status;
+    }
+    if (owner->plan.schema == 8) {
+        return *holder ? -ESTALE : 0;
+    }
+    status = preexec_publisher_lender_identity(session);
+    if (status) {
+        return status;
+    }
+    if (holder != session->source_holder || *holder != session ||
+        session->member || session->module_service ||
+        preexec_publisher_module_observation_busy(session) ||
+        session->live_operations || session->recipient_holder ||
+        session->recipient.held || preexec_publisher_observation_busy(session)) {
+        return -EBUSY;
+    }
+    session->source_return_first = preexec_setup_original_live();
+    /* No source/member tail can access the mapping after this field clears;
+     * preexec's separate cleanup holder still owns all physical resources. */
+    *holder = NULL;
+    session->source_holder = NULL;
+    session->source_returned = true;
+    session->source_return_post = preexec_setup_original_live();
+    return session->source_return_first ? session->source_return_first :
+        session->source_return_post;
+}
+
+/* An installing module receives a separate service view of the actual retained
+ * aliases. No decoded coordinates or reconstructed SCM roster issue a child. */
+static bool preexec_publisher_span_overlaps(const void *output, size_t bytes,
+                                           const void *base, size_t extent)
+{
+    uintptr_t address = (uintptr_t)output;
+    uintptr_t start = (uintptr_t)base;
+
+    return !output || !bytes || bytes > UINTPTR_MAX - address ||
+        extent > UINTPTR_MAX - start ||
+        (address < start + extent && start < address + bytes);
+}
+
+static bool preexec_publisher_module_output_disjoint(
+    const void *output, size_t bytes)
+{
+    PreexecPublisherMappingJournal *mapping =
+        &preexec_setup_owner.publisher_storage.session.mapping;
+
+    return !preexec_publisher_span_overlaps(output, bytes,
+        &preexec_setup_owner, sizeof(preexec_setup_owner)) &&
+        (!mapping->retained || !preexec_publisher_span_overlaps(
+            output, bytes, mapping->address, mapping->requested_bytes));
+}
+
+int qemu_crucible_preexec_publisher_pending_output_v1(
+    QemuCruciblePublisherSessionLender *lender, const void *output, size_t bytes)
+{
+    int status = preexec_publisher_lender_identity(lender);
+
+    return status ? status : preexec_publisher_module_output_disjoint(output, bytes) ?
+        0 : -EINVAL;
+}
+
+static int preexec_publisher_module_memory_current(void)
+{
+    QemuCruciblePreexecSetupOwner *owner = &preexec_setup_owner;
+    const struct stat *retained = &owner->memory_alias_identity;
+    struct stat observed;
+    long status;
+
+    if (!owner->memory_alias_identity_known) {
+        return -ENOKEY;
+    }
+    status = preexec_setup_syscall5(SYS_fstat, owner->descriptors[0],
+        (long)(uintptr_t)&observed, 0, 0, 0);
+    if (status < 0) {
+        return status;
+    }
+    return observed.st_dev == retained->st_dev &&
+        observed.st_ino == retained->st_ino && observed.st_mode == retained->st_mode &&
+        observed.st_size == retained->st_size ? 0 : -ESTALE;
+}
+
+static int preexec_publisher_module_plan_current(void)
+{
+    QemuCruciblePreexecSetupOwner *owner = &preexec_setup_owner;
+    const struct stat *retained = &owner->plan_before;
+    struct stat observed;
+    long status = preexec_setup_syscall5(SYS_fstat, owner->descriptors[2],
+        (long)(uintptr_t)&observed, 0, 0, 0);
+
+    if (status < 0) {
+        return status;
+    }
+    if (observed.st_dev != retained->st_dev ||
+        observed.st_ino != retained->st_ino || observed.st_mode != retained->st_mode ||
+        observed.st_size != retained->st_size) {
+        return -ESTALE;
+    }
+    status = preexec_setup_syscall5(SYS_fcntl, owner->descriptors[2],
+        F_GET_SEALS, 0, 0, 0);
+    return status < 0 ? status : status == owner->plan_seals ? 0 : -ESTALE;
+}
+
+static int preexec_publisher_module_base_current(
+    QemuCruciblePublisherSessionLender *lender)
+{
+    QemuCruciblePreexecSetupOwner *owner = &preexec_setup_owner;
+    QemuCruciblePreexecPeerObservation peer;
+    QemuCrucibleWorkspacePurposeObservation workspace;
+    QemuCrucibleProcessContractObservation *observation = &lender->module_observation;
+    uint64_t descriptor_limit;
+    int cancellation;
+    int status;
+
+    if (preexec_publisher_module_observation_busy(lender)) {
+        return -EBUSY;
+    }
+    status = qemu_crucible_preexec_peer_observe_v3(owner, &peer);
+    if (!status) {
+        status = preexec_publisher_module_memory_current();
+    }
+    if (!status) {
+        status = preexec_publisher_module_plan_current();
+    }
+    if (!status) {
+        status = qemu_crucible_preexec_contract_check_v3(
+            owner, observation, &descriptor_limit);
+    }
+    if (!status) {
+        status = qemu_crucible_preexec_wake_identity_v1(owner,
+            &owner->descriptors[QEMU_CRUCIBLE_PREEXEC_SETUP_WAKE_INDEX],
+            owner->wake_event_id, observation);
+    }
+    if (!status) {
+        status = qemu_crucible_preexec_standing_identity_v1(
+            &owner->standing, observation, &cancellation);
+    }
+    if (!status && owner->plan.workspace_bytes) {
+        status = qemu_crucible_preexec_workspace_current_v1(&owner->workspace, &workspace);
+    }
+    return status;
+}
+
+static int preexec_publisher_module_view(
+    QemuCruciblePublisherSessionLender *lender,
+    QemuCruciblePublisherModuleView *view)
+{
+    QemuCruciblePreexecSetupOwner *owner = &preexec_setup_owner;
+    size_t base = owner->plan.workspace_bytes ? 6 : 5;
+    QemuCruciblePublisherModuleView observed = {
+        .frame = owner->frame,
+        .frame_bytes = QEMU_CRUCIBLE_PREEXEC_SETUP_V6_FRAME_BYTES,
+        .base_descriptors = owner->descriptors,
+        .base_descriptor_count = base,
+    };
+    int first = qemu_crucible_preexec_purpose_check_v3(owner);
+    int post;
+
+    if (!first && (owner->selected_edition != 6 || owner->plan.schema != 9 ||
+                   owner->descriptor_count != base + 3 || !owner->frame_validated ||
+                   owner->frame[4] != QEMU_CRUCIBLE_PREEXEC_SETUP_TAG_V6)) {
+        first = -ESTALE;
+    }
+    if (!first) {
+        first = preexec_publisher_module_base_current(lender);
+    }
+    if (!first) {
+        first = preexec_publisher_mapping_observe(lender, &owner->plan.subscription);
+    }
+    for (size_t index = 0; !first && index < base; index++) {
+        if (owner->descriptors[index] < 0) {
+            first = -ESTALE;
+        }
+    }
+    for (size_t index = 0; !first && index < 3; index++) {
+        if (owner->descriptors[base + index] != -1) {
+            first = -ESTALE;
+        } else {
+            first = preexec_publisher_alias_observe(&lender->aliases[index],
+                index, &owner->plan.subscription);
+            observed.publisher_descriptors[index] = lender->aliases[index].descriptor;
+        }
+    }
+    post = preexec_setup_original_live();
+    if (!first && !post) {
+        *view = observed;
+    }
+    return first ? first : post;
+}
+
+int qemu_crucible_preexec_publisher_module_borrow_v1(
+    QemuCruciblePublisherSessionLender *lender, const void *service,
+    const void *publication, size_t publication_bytes,
+    QemuCruciblePublisherModuleView *view)
+{
+    int status;
+    int post;
+
+    if (lender != &preexec_setup_owner.publisher_storage.session) {
+        return -EPERM;
+    }
+    status = qemu_crucible_startup_source_publisher_module_identity_v1(
+        lender, service, view, 0, NULL);
+    if (status) {
+        return status;
+    }
+    if (!preexec_publisher_module_output_disjoint(publication, publication_bytes)) {
+        return -EINVAL;
+    }
+    status = qemu_crucible_preexec_publisher_lender_current_v1(lender);
+    if (status) {
+        post = preexec_setup_original_live();
+        lender->module_first_status = status;
+        lender->module_post_status = post;
+        return lender->module_first_status ? lender->module_first_status :
+            lender->module_post_status;
+    }
+    if (lender->module_borrowed || lender->module_returned || lender->module_service) {
+        return -EALREADY;
+    }
+    if (lender->next_local_serial >= UINT64_MAX - 1) {
+        return -EOVERFLOW;
+    }
+    lender->module_observation.descriptor = -1;
+    lender->module_serial = ++lender->next_local_serial;
+    lender->module_borrowed = true;
+    lender->module_service = service;
+    /* Debt exists before either fallible Original cut. A failed begin leaves
+     * the Source creation holder and this exact child available for cleanup. */
+    lender->module_first_status = preexec_publisher_module_view(lender, view);
+    lender->module_post_status = preexec_setup_original_live();
+    return lender->module_first_status ? lender->module_first_status :
+        lender->module_post_status;
+}
+
+int qemu_crucible_preexec_publisher_module_current_v1(
+    QemuCruciblePublisherSessionLender *lender, const void *service,
+    const void *publication, size_t publication_bytes,
+    QemuCruciblePublisherModuleView *view)
+{
+    int first;
+    int post;
+
+    if (lender != &preexec_setup_owner.publisher_storage.session) {
+        return -EPERM;
+    }
+    first = qemu_crucible_startup_source_publisher_module_identity_v1(
+        lender, service, view, 0, NULL);
+    if (first) {
+        return first;
+    }
+    first = preexec_publisher_lender_identity(lender);
+    if (!first && (!lender->module_borrowed || lender->module_returned ||
+                   lender->module_service != service || !lender->module_serial ||
+                   lender->module_serial == UINT64_MAX)) {
+        first = -ESTALE;
+    }
+    if (!first &&
+        !preexec_publisher_module_output_disjoint(publication, publication_bytes)) {
+        first = -EINVAL;
+    }
+    if (!first) {
+        first = preexec_publisher_module_view(lender, view);
+    }
+    post = preexec_setup_original_live();
+    lender->module_current_first = first;
+    lender->module_current_post = post;
+    return lender->module_first_status ? lender->module_first_status :
+        lender->module_post_status ? lender->module_post_status : first ? first : post;
+}
+
+static int preexec_publisher_module_drop(
+    PreexecPublisherSessionJournal *session, const void *service)
+{
+    if (!service || session->module_service != service || session->member ||
+        preexec_publisher_module_observation_busy(session) ||
+        session->live_operations || session->recipient_holder ||
+        session->recipient.held || preexec_publisher_observation_busy(session)) {
+        return -EBUSY;
+    }
+    session->module_service = NULL;
+    session->module_returned = true;
+    return 0;
+}
+
+int qemu_crucible_preexec_publisher_module_return_v1(
+    QemuCruciblePublisherSessionLender *lender, const void *service, int *returned)
+{
+    int status = preexec_publisher_lender_identity(lender);
+    int first;
+    int post;
+
+    if (!status) {
+        status = qemu_crucible_startup_source_publisher_module_identity_v1(
+            lender, service, NULL, 1, returned);
+    }
+    if (status) {
+        return status;
+    }
+    if (lender->module_returned) {
+        *returned = 1;
+        return lender->module_return_first ? lender->module_return_first :
+            lender->module_return_post;
+    }
+    if ((lender->module_service && lender->module_service != service) ||
+        (lender->module_borrowed && (!lender->module_serial ||
+                                   lender->module_serial == UINT64_MAX))) {
+        return -ESTALE;
+    }
+    first = preexec_setup_original_live();
+    /* An authenticated failed begin may never have entered this local child.
+     * That is a not-entered return, not a fabricated callback or alias return. */
+    status = lender->module_borrowed ? preexec_publisher_module_drop(lender, service) : 0;
+    if (!first) {
+        first = status;
+    }
+    if (!status) {
+        lender->module_returned = true;
+        *returned = 1;
+    }
+    post = preexec_setup_original_live();
+    if (!lender->module_return_attempted) {
+        lender->module_return_attempted = true;
+        lender->module_return_first = first;
+        lender->module_return_post = post;
+    }
+    return lender->module_return_first ? lender->module_return_first :
+        lender->module_return_post ? lender->module_return_post : first ? first : post;
+}
diff --git a/system/crucible-preexec-publisher-storage.inc.h b/system/crucible-preexec-publisher-storage.inc.h
