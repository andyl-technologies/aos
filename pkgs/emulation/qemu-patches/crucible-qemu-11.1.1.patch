diff --git a/plugins/crucible-advance-receiver.inc.h b/plugins/crucible-advance-receiver.inc.h
new file mode 100644
index 0000000000000000000000000000000000000000..ad1d47e4d2e8890b71f199f4dc9a436129266f14
--- /dev/null
+++ b/plugins/crucible-advance-receiver.inc.h
@@ -0,0 +1,1108 @@
+/*
+ * Separate retained receiver for an asynchronous scheduler command.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#if defined(CONFIG_LINUX) && defined(__x86_64__) && !defined(__ILP32__)
+/* Identity survives a negative semantic post. It permits factual observation of
+ * this retained journal only; current entered producers have separate cuts. */
+static int advance_receiver_identity(QemuCrucibleSourceAdvanceReceiver *receiver)
+{
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    QemuCrucibleCommandConsumerMember *member = &startup_source.command_member;
+    QemuCruciblePublisherModuleService *service = &startup_source.publisher_module;
+    int status;
+
+    if (receiver != &startup_source.advance_receiver ||
+        receiver->canonical_owner != receiver || !receiver->held ||
+        receiver->holder != &startup_source.advance_holder ||
+        startup_source.advance_holder != receiver || receiver->member != member ||
+        receiver->service != service || receiver->lender != startup_source.publisher_lender ||
+        !receiver->lender || receiver->process != getpid() ||
+        !qemu_thread_is_self(&receiver->thread) || !receiver->serial ||
+        receiver->serial == UINT64_MAX) {
+        return -ESTALE;
+    }
+    qemu_mutex_lock(&commands->mutex);
+    status = command_member_identity_locked(member);
+    if (!status) {
+        status = publisher_service_runtime_identity_locked(service);
+    }
+    if (!status && (member->advance_users != 1 || service->advance_users != 1 ||
+        member->child_owner != service->runtime_owner ||
+        member->runtime_holder == NULL || *member->runtime_holder != member ||
+        member->runtime_base != service->runtime_base ||
+        member->runtime_extent != service->runtime_extent)) {
+        status = -ESTALE;
+    }
+    qemu_mutex_unlock(&commands->mutex);
+    return status;
+}
+
+/* Compare decoded protocol content, never C padding or only the primary row.
+ * Equality corroborates the real installed session; it issues no Original. */
+static bool advance_cohort_equal(const QemuCrucibleBoundaryActionRecord *left,
+                                 const QemuCrucibleBoundaryActionRecord *right)
+{
+    const QemuCrucibleActionBinding *a = &left->binding;
+    const QemuCrucibleActionBinding *b = &right->binding;
+
+    if (left->present != right->present || left->dirty != right->dirty ||
+        left->primary_count != right->primary_count ||
+        left->planned_count != right->planned_count ||
+        left->planned_count > QEMU_CRUCIBLE_ACTION_PARENT_CAPACITY ||
+        left->born_mask != right->born_mask ||
+        left->projected_mask != right->projected_mask ||
+        memcmp(a->source_capability, b->source_capability, 32) ||
+        memcmp(a->source_reservation, b->source_reservation, 32) ||
+        a->account_incarnation != b->account_incarnation ||
+        a->process_incarnation != b->process_incarnation ||
+        a->request_token != b->request_token ||
+        a->capture_generation != b->capture_generation ||
+        a->command_frontier != b->command_frontier ||
+        a->publisher_birth_sequence != b->publisher_birth_sequence) {
+        return false;
+    }
+    for (size_t index = 0; index < left->planned_count; index++) {
+        const QemuCrucibleProducingActionRow *a = &left->rows[index];
+        const QemuCrucibleProducingActionRow *b = &right->rows[index];
+
+        if (memcmp(a->lender_capability, b->lender_capability, 32) ||
+            a->budget_owner != b->budget_owner || a->operation != b->operation ||
+            a->producing_class != b->producing_class || a->state != b->state ||
+            a->policy_revision != b->policy_revision ||
+            a->outer_revision != b->outer_revision ||
+            a->original_origin_ns != b->original_origin_ns ||
+            a->original_start_ns != b->original_start_ns ||
+            a->genuine_progress_ns != b->genuine_progress_ns ||
+            a->total_end_ns != b->total_end_ns ||
+            a->progress_end_ns != b->progress_end_ns ||
+            a->outer_end_ns != b->outer_end_ns ||
+            a->private_interval_end_ns != b->private_interval_end_ns ||
+            a->poll_ns != b->poll_ns ||
+            a->completed_required_units != b->completed_required_units ||
+            a->required_units != b->required_units ||
+            a->preparation_row_plus_one != b->preparation_row_plus_one ||
+            a->role != b->role ||
+            a->immutable_entry_revision != b->immutable_entry_revision) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static int advance_publication_current(QemuCrucibleSourceAdvanceReceiver *receiver)
+{
+    const QemuCruciblePublisherPublicationView *publication = &receiver->publication;
+    const QemuCrucibleBoundaryActionRecord *cohort = &publication->cohort;
+    uint64_t now;
+    int status;
+
+    if (!publication->command_present || publication->permission_phase != 1 ||
+        !cohort->present || cohort->dirty || cohort->primary_count != 1 ||
+        !cohort->planned_count ||
+        cohort->planned_count > QEMU_CRUCIBLE_ACTION_PARENT_CAPACITY ||
+        cohort->born_mask != (UINT32_C(1) << cohort->planned_count) - 1 ||
+        cohort->projected_mask != cohort->born_mask ||
+        cohort->rows[0].role || cohort->rows[0].producing_class != 1 ||
+        cohort->rows[0].required_units != 1 ||
+        cohort->rows[0].completed_required_units ||
+        cohort->binding.account_incarnation != receiver->member->account_generation ||
+        cohort->binding.process_incarnation != receiver->member->process_generation ||
+        memcmp(cohort->binding.source_capability,
+               startup_source.standing.initial.supervisor_capability, 32) ||
+        memcmp(cohort->binding.source_reservation,
+               startup_source.standing.initial.source_reservation, 32)) {
+        return -ESTALE;
+    }
+    status = standing_refresh(true);
+    if (!status && (publication->standing_sequence != startup_source.standing.sequence ||
+        !advance_cohort_equal(cohort, &startup_source.standing.current.action))) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        status = standing_clock(&now);
+    }
+    if (!status) {
+        status = standing_limits_current(&startup_source.standing.current, now);
+    }
+    if (status) {
+        return status;
+    }
+    for (size_t index = 0; index < cohort->planned_count; index++) {
+        const QemuCrucibleProducingActionRow *row = &cohort->rows[index];
+
+        if (row->state || now < row->original_origin_ns ||
+            now < row->original_start_ns || now < row->genuine_progress_ns ||
+            (row->total_end_ns && now >= row->total_end_ns) ||
+            (row->progress_end_ns && now >= row->progress_end_ns) ||
+            (row->outer_end_ns && now >= row->outer_end_ns) ||
+            (row->private_interval_end_ns && now >= row->private_interval_end_ns)) {
+            return -ETIMEDOUT;
+        }
+    }
+    return 0;
+}
