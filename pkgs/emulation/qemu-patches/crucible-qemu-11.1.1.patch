+                             16 * 1024 * 1024, NULL) &&
+               node_json_positive(qdict_get(dict, "interval_nanos"), &first) &&
+               first <= INT64_MAX / CRUCIBLE_SIM_TICKS_PER_NS;
+    }
+    dict = node_json_tag_dict(object, "rowhammer");
+    if (kind == 3 && dict &&
+        NODE_EXACT(dict, "flip_mask", "row_bytes", "threshold",
+                   "victim_distance")) {
