+static int standing_boundary(void)
+{
+    QemuCrucibleStandingSourcePurpose *purpose = &startup_source.standing;
+    int fd = -1;
+    int status = qemu_crucible_preexec_standing_identity_v1(purpose->lender, &purpose->observation, &fd);
+
+    if (!status) {
