+int monitor_qmp_source_marshal_begin(
+    size_t bytes, MonitorQmpSourceMarshalCleanup *cleanup, void **out)
+{
+    QMPRequest *request = qmp_main_dispatch_request;
+    QemuCrucibleQmpAllocationOwner *owner;
+    int status;
+
+    if (!request || !out || *out || !bytes || !cleanup ||
+        monitor_cur() != &request->mon->parent_obj ||
+        !request->dispatch_scope || !request->dispatch_borrow ||
+        request->marshal_allocation || request->marshal_cleanup) {
+        return -EPERM;
+    }
+    status = monitor_qmp_allocation_dispatch_current(
+        &request->mon->parent_obj, request->dispatch_borrow);
+    if (!status) {
+        status = qemu_crucible_qmp_scope_identity_current(&owner);
+    }
+    if (!status && owner != request->allocation_owner) {
+        status = -ESTALE;
+    }
+    if (status) {
+        return status;
+    }
+
+    /* This callback is the generated marshaller's actual static cleanup body,
+     * never a wire-supplied pointer. The exact compiled frame is paid before
+     * input conversion, output visiting, trace or command-handler effects. */
+    request->marshal_cleanup = cleanup;
+    status = qemu_crucible_qmp_allocate(owner, bytes, true,
+                                       &request->marshal_allocation);
+    request->marshal_first_status = status;
+    *out = request->marshal_allocation;
+    return status;
+}
+
+static int monitor_qmp_source_marshal_return(QMPRequest *request)
+{
+    QemuCrucibleQmpAllocationOwner *owner;
+    size_t bytes;
+    int first = request->marshal_first_status;
+    int status;
+
+    if (!request->marshal_allocation) {
+        return 0;
+    }
+    if (!request->marshal_cleanup || request->dispatch_scope) {
+        return -EBUSY;
+    }
+    status = qemu_crucible_qmp_allocation_observe(
+        request->marshal_allocation, &owner, &bytes);
+    if (status) {
+        return status;
+    }
+    if (owner != request->allocation_owner || !bytes) {
+        return -ESTALE;
+    }
+
+    /* Physical cleanup runs after actual dispatch scope return, outside Source
+     * ledger guards. The callee updates this exact holder at real last free.
+     * Its semantic first and physical return remain separate coordinates. */
+    status = request->marshal_cleanup(&request->marshal_allocation, &first);
+    request->marshal_first_status = first;
+    request->marshal_post_status = status;
+    if (!request->marshal_allocation) {
+        request->marshal_cleanup = NULL;
+    }
+    return status;
+}
