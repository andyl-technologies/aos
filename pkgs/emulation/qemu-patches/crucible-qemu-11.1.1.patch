+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Check literal CPU-loop debt cuts and production staging/service bodies.
+
+CPU lookup, virtual time, rule unlinking and physical writes are bounded unit
+providers. This does not run a translated guest or authenticate worker custody.
+The existing ticket fixture supplies its disclosed reservation and tick providers.
+"""
+
+import argparse
+import importlib.util
