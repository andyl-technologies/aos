+static void test_migration(gconstpointer data)
+{
+    unsigned kind = GPOINTER_TO_UINT(data);
+    LoongArchCPU original = { 0 };
+    LoongArchCPU restored = { 0 };
+    __int128 deadline = migration_deadline(kind);
+    GByteArray *bytes;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+    initialize_clock(true);
+    initialize_timer(&original);
+    initialize_timer(&restored);
+    if (kind != 5) {
+        timer_mod_ps_wide(&original.timer, deadline);
+    }
+    timer_mod_ps_wide(&restored.timer, 42);
+    bytes = save_state(&timer_fixture, &original);
+
+    g_assert_cmpint(load_state(&timer_fixture, &restored, bytes), ==, 0);
+    g_assert_cmpint(timer_pending(&restored.timer), ==, kind != 5);
+    if (kind != 5) {
+        g_assert_true(timer_expire_time_ps_wide(&restored.timer) == deadline);
+    }
+    if (kind == 0 || kind == 1 || kind == 2) {
+        observed_ps = deadline - 1;
+        qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL);
+        g_assert_cmpuint(callbacks, ==, 0);
+        observed_ps = deadline;
+        qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL);
+        g_assert_cmpuint(callbacks, ==, 2);
+    }
+
+    g_byte_array_unref(bytes);
+    destroy_timer(&original);
+    destroy_timer(&restored);
+}
+
+static size_t exact_payload(GByteArray *bytes)
+{
+    const char *name = "cpu/constant-timer-wide";
+    size_t length = strlen(name);
+
+    for (size_t i = 0; i + length + 6 < bytes->len; i++) {
+        if (bytes->data[i] == QEMU_VM_SUBSECTION &&
+            bytes->data[i + 1] == length &&
+            !memcmp(bytes->data + i + 2, name, length)) {
+            return i + length + 6;
+        }
+    }
+    g_assert_not_reached();
+}
