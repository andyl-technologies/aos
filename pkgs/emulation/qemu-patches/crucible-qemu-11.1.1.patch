+/* These existing arithmetic controls carry modeled local ledger receipts.
+ * They exercise the unchanged conserving ledger cut, not canonical Native
+ * membership or a physical-return proof. Actual allocation controls below
+ * separately call g_free; the physical journal controls use real owner rows. */
+static void fixture_ledger_component_retire(QemuCrucibleMetadataCharge *charge)
+{
+    int status = crucible_metadata_native_retire(
+        &startup_source.metadata_partition, charge);
