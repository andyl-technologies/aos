+static int fingerprint_worker_invoke_close(QemuCruciblePluginWorker *native, void *owner)
+{
+    QemuCrucibleFingerprintWorker *worker = &startup_source.fingerprint_worker;
+    qemu_plugin_id_t id = native->installer.plugin_id;
+    int status;
+
+    SOURCE_CALLBACK_MASKED_INVOKE(status, worker, worker->close, owner, id, worker, owner);
+    return status;
+}
