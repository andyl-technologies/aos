+def function(source, opening, offset=0):
+    start = source.index(opening, offset)
+    cursor = source.index("{", start)
+    depth = 1
+    quoted = None
+    escaped = False
+    comment = None
+    cursor += 1
+    while depth:
+        char = source[cursor]
+        next_char = source[cursor + 1] if cursor + 1 < len(source) else ""
+        if comment == "line":
+            if char == "\n":
+                comment = None
+        elif comment == "block":
+            if char == "*" and next_char == "/":
+                comment = None
+                cursor += 1
+        elif quoted:
+            if escaped:
+                escaped = False
+            elif char == "\\":
+                escaped = True
+            elif char == quoted:
+                quoted = None
+        elif char == "/" and next_char in ("/", "*"):
+            comment = "line" if next_char == "/" else "block"
+            cursor += 1
+        elif char in ("'", '"'):
+            quoted = char
+        elif char == "{":
+            depth += 1
+        elif char == "}":
+            depth -= 1
+        cursor += 1
+    return source[start:cursor] + "\n"
+
+
+def unique_line(source, text):
+    lines = [line for line in source.splitlines() if line == text]
+    if len(lines) != 1:
+        raise ValueError(f"declaration is not unique: {text}")
+    return lines[0] + "\n"
+
+
+def body_cut(source, first, after):
+    start = source.index(first)
+    end = source.index(after, start)
+    return source[start:end]
