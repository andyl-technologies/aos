+/* The retained view already pins the region graph under BQL/RCU. Acquire
+ * additional references to its actual owner and region; do not map RAM or
+ * enter a device/IOMMU callback. The owner pin retains embedded storage; the
+ * region pin prevents finalization if explicitly unparented. RAMBlock has no
+ * independent refcount: its actual free is the RAM region destructor. */
+static int flatview_read_region_custody(MemoryRegionSection *section,
+                                       MemoryRegionReadCustody *custody)
+{
+    MemoryRegion *region = section->mr;
+    int status;
+
+    if (!region->owner) {
+        return -ENOTSUP;
+    }
+    custody->reference_attempted = true;
+    status = object_ref_once(region->owner, &custody->owner);
+    custody->reference_acquired = status == 0;
+    if (status) {
+        return status;
+    }
+    custody->region_reference_attempted = true;
+    status = object_ref_once(OBJECT(region), &custody->region_object);
+    custody->region_reference_acquired = status == 0;
+    if (status) {
+        return status;
+    }
+    if (memory_region_is_ram(region)) {
+        if (!region->ram_block || region->ram_block->mr != region) {
+            return -ESTALE;
+        }
+        custody->ram_block = region->ram_block;
+        status = ram_read_resize_acquire(custody);
+        if (status) {
+            return status;
+        }
+        status = ram_read_discard_acquire(custody);
+        if (status) {
+            return status;
+        }
+        status = ram_read_mapping_acquire(custody);
+        if (status) {
+            return status;
+        }
+    }
+    return -ENOTSUP;
+}
