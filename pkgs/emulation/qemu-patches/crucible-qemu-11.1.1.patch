+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * The existing workspace pins the complete real CPU/QOM cohort. A held read
+ * blocks that borrower and its terminal return; this child adds no references,
+ * mapping credit, runtime Root authority or cross-CPU Initial inheritance.
+ */
+static int initial_register_read_parent(
+    QemuCrucibleRegisterReadFrame *frame)
+{
+    QemuCrucibleInitialRegisterWorkspaceOwner *owner =
+        &startup_source.initial_register_workspace;
+    struct QemuCrucibleInitialCpuParticipant *participant = NULL;
+    int status;
+
+    if (frame->parent != owner || !owner->constructor_cpu ||
+        current_cpu != owner->constructor_cpu) {
+        return -EPERM;
+    }
+    status = initial_register_workspace_identity(owner, owner->holder, false, false);
+    if (!status) {
+        status = qemu_plugin_crucible_initial_cpu_callback_entered_v1(current_cpu);
+    }
+    if (!status) {
+        status = initial_cpu_identity(current_cpu,
+            &current_cpu->crucible_initial_participant, &participant);
+    }
+    if (!status) {
+        status = initial_register_borrow_facts(
+            owner, current_cpu, participant, owner->borrow_holder);
+    }
+    if (!status) {
+        status = initial_cpu_child_source_current(participant, false);
+    }
+    if (!status) {
+        status = initial_cpu_child_original_observe(participant, false);
+    }
+    if (!status) {
+        status = initial_register_workspace_dependencies_current(owner);
+    }
+    return status;
+}
+
+/* Registry identity and the workspace's existing physical refs precede every
+ * access to the target payload. The caller holds BQL and its parent borrower. */
+static int initial_register_read_target(
+    QemuCrucibleRegisterReadFrame *frame, bool issuing, bool quiet)
+{
+    QemuCrucibleInitialRegisterWorkspaceOwner *owner =
+        &startup_source.initial_register_workspace;
+    QemuCrucibleInitialRegisterRead *read = &owner->read;
+    QemuCrucibleCpuSourceAllocationOwner *actual = NULL;
+    const QemuCrucibleRegisterWorkspaceSpan *span =
+        &owner->layout.part[CRUCIBLE_REGISTER_WORKSPACE_FINGERPRINT_VALUE];
+    int status;
+
+    if (frame->value != (uint8_t *)owner->address + span->offset ||
+        !frame->bytes || frame->bytes > span->bytes) {
+        return -ESTALE;
+    }
+    status = pthread_mutex_trylock(&startup_source.cpu_allocations.lock);
+    if (status) {
+        return -status;
+    }
+    status = initial_register_cpu_owner_locked(frame->cpu, &actual);
+    if (!status && (actual->register_workspace != owner ||
+        actual->register_workspace_parent || !actual->constructor_children ||
+        actual->binding != owner->account->binding ||
+        (quiet && actual->getter_children))) {
+        status = -ESTALE;
+    }
+    if (!status && !issuing && (actual != read->cpu_owner ||
+        actual->receipt != read->receipt ||
+        actual->request_serial != read->cpu_generation)) {
+        status = -ESTALE;
+    }
+    if (!status && issuing) {
+        read->cpu_owner = actual;
+        read->receipt = actual->receipt;
+        read->cpu_generation = actual->request_serial;
+    }
+    pthread_mutex_unlock(&startup_source.cpu_allocations.lock);
+    return status;
+}
+
+/* Factual closure predicate; its caller separately authenticates the real
+ * entered producer, Initial Original and retained CPU/QOM allocation. */
+static bool initial_register_read_closed_facts(
+    const QemuCrucibleInitialRegisterRead *read, bool authenticated,
+    int first, int post)
+{
+    return read->held && read->callback_returned && read->return_post_attempted &&
+        read->return_post_recorded &&
+        !read->native_child &&
+        !read->native_return_status &&
+        (!read->native_born ||
+         (read->native_return_attempted && read->native_consumed)) &&
+        authenticated && !first && !post;
+}
+
+static bool initial_register_read_same_facts(
+    const QemuCrucibleInitialRegisterWorkspaceOwner *owner,
+    const QemuCrucibleRegisterReadFrame *frame,
+    QemuCrucibleInitialRegisterRead **holder)
+{
+    const QemuCrucibleInitialRegisterRead *read = &owner->read;
+
+    return read->held && read->frame == frame && read->holder == holder &&
+        holder && *holder == read && read->producer_serial == frame->serial &&
+        read->borrow_serial == owner->borrow_serial && owner->borrow_held &&
+        read->cpu == frame->cpu && read->value == frame->value &&
+        read->bytes == frame->bytes && read->numeric_id == frame->numeric_id;
+}
+
+int qemu_crucible_source_initial_register_read_begin_v1(
+    QemuCrucibleRegisterReadFrame *frame,
+    QemuCrucibleInitialRegisterRead **holder)
+{
+    QemuCrucibleInitialRegisterWorkspaceOwner *owner =
+        &startup_source.initial_register_workspace;
+    QemuCrucibleInitialRegisterRead *read = &owner->read;
+    bool authenticated = false, recorded = false;
+    int first = qemu_crucible_fault_register_read_frame_current_v1(
+        frame, holder, QEMU_CRUCIBLE_REGISTER_READ_ISSUING);
+    int post;
+
+    if (first) {
+        return first;
+    }
+    first = initial_register_read_parent(frame);
+    if (!first && (read->held || read->holder || owner->read_serial == UINT64_MAX)) {
+        first = owner->read_serial == UINT64_MAX ? -EOVERFLOW : -EBUSY;
+    }
+    if (!first) {
+        /* Reset only an unoccupied journal. Exact target enrollment is an
+         * observation of existing refs, before the child is issued. */
+        memset(read, 0, sizeof(*read));
+        recorded = true;
+        first = initial_register_read_target(frame, true, true);
+    }
+    if (!first) {
+        owner->read_serial++;
+        read->frame = frame;
+        read->holder = holder;
+        read->cpu = frame->cpu;
+        read->value = frame->value;
+        read->bytes = frame->bytes;
+        read->numeric_id = frame->numeric_id;
+        read->producer_serial = frame->serial;
+        read->borrow_serial = owner->borrow_serial;
+        read->held = true;
+        *holder = read;
+        first = qemu_plugin_crucible_native_initial_register_read_begin_v1(
+            frame, holder, &read->native_child);
+        read->native_born = read->native_child != NULL;
+    }
+    if (recorded) {
+        read->first_status = first;
+    }
+    post = initial_register_borrow_post(owner->constructor_cpu, owner,
+                                        owner->holder, &authenticated);
+    if (recorded) {
+        read->post_status = post;
+    }
+    return first ? first : post;
+}
+
+int qemu_crucible_source_initial_register_read_current_v1(
+    QemuCrucibleRegisterReadFrame *frame,
+    QemuCrucibleInitialRegisterRead **holder)
+{
+    QemuCrucibleInitialRegisterWorkspaceOwner *owner =
+        &startup_source.initial_register_workspace;
+    QemuCrucibleInitialRegisterRead *read = &owner->read;
+    bool authenticated = false;
+    int first = qemu_crucible_fault_register_read_frame_current_v1(
+        frame, holder, QEMU_CRUCIBLE_REGISTER_READ_CALLING);
+    int post;
+
+    if (first) {
+        return first;
+    }
+    if (!initial_register_read_same_facts(owner, frame, holder) ||
+        read->current_attempted || read->return_post_recorded) {
+        first = -ESTALE;
+    }
+    if (first) {
+        return first;
+    }
+    read->current_attempted = true;
+    first = read->first_status ? read->first_status : read->post_status;
+    if (!first) {
+        first = initial_register_read_parent(frame);
+    }
+    if (!first) {
+        first = initial_register_read_target(frame, false, true);
+    }
+    if (!first) {
+        first = qemu_plugin_crucible_native_initial_register_read_current_v1(
+            frame, holder, &read->native_child, false);
+    }
+    read->current_first_status = first;
+    post = initial_register_borrow_post(owner->constructor_cpu, owner,
+                                        owner->holder, &authenticated);
+    read->current_post_status = post;
+    if (!first && !post && authenticated) {
+        read->admitted = true;
+    }
+    return first ? first : post;
+}
+
+int qemu_crucible_source_initial_register_read_end_v1(
+    QemuCrucibleRegisterReadFrame *frame,
+    QemuCrucibleInitialRegisterRead **holder)
+{
+    QemuCrucibleInitialRegisterWorkspaceOwner *owner =
+        &startup_source.initial_register_workspace;
+    QemuCrucibleInitialRegisterRead *read = &owner->read;
+    bool authenticated = false, returned = false;
+    int first = qemu_crucible_fault_register_read_frame_current_v1(
+        frame, holder, QEMU_CRUCIBLE_REGISTER_READ_RETURNING);
+    int post;
+
+    if (first) {
+        return first;
+    }
+    if (!initial_register_read_same_facts(owner, frame, holder)) {
+        return -ESTALE;
+    }
+    if (read->return_post_attempted) {
+        return read->return_first_status ? read->return_first_status :
+            read->return_post_recorded && read->return_post_status ?
+                read->return_post_status : -EBUSY;
+    }
+    if (frame->entered != read->admitted || frame->returned != frame->entered) {
+        first = -EPROTO;
+    } else {
+        /* This physical fact precedes fallible current and independent post.
+         * It records the exact no-call or returned callback, never QOM free. */
+        read->callback_returned = true;
+        returned = true;
+    }
+    if (!first) {
+        first = initial_register_read_parent(frame);
+    }
+    if (!first) {
+        first = initial_register_read_target(frame, false, true);
+    }
+    /* Record a single physical membership-return attempt before the fallible
+     * Original post. A consumed Native holder is never returned a second time,
+     * including when that post subsequently refuses. */
+    if (returned && !first && read->native_child) {
+        read->native_return_attempted = true;
+        read->native_return_status =
+            qemu_plugin_crucible_native_initial_register_read_return_v1(
+                frame, holder, &read->native_child);
+        read->native_consumed = !read->native_child;
+        if (!first) {
+            first = read->native_return_status;
+        }
+    } else if (read->native_child) {
+        read->native_return_status = first ? first : -EBUSY;
+    }
+    read->return_first_status = frame->work_status ? frame->work_status : first;
+    read->return_current_status = first;
+    read->return_post_attempted = true;
+    post = initial_register_borrow_post(owner->constructor_cpu, owner,
+                                        owner->holder, &authenticated);
+    read->return_post_status = post;
+    read->return_post_recorded = true;
+    if (returned && initial_register_read_closed_facts(read, authenticated,
+                                                      first, post)) {
+        *holder = NULL;
+        read->holder = NULL;
+        read->held = false;
+    }
+    return frame->work_status ? frame->work_status : first ? first : post;
+}
+
+/* Only the actual architecture callback may nest a selected software getter.
+ * The target must also be the same real entered Initial-dispatch CPU; this
+ * does not propagate Initial authority to another retained cohort member. */
+static int initial_register_read_entered(CPUState *cpu)
+{
+    QemuCrucibleInitialRegisterWorkspaceOwner *owner =
+        &startup_source.initial_register_workspace;
+    QemuCrucibleInitialRegisterRead *read = &owner->read;
+    int status;
+
+    if (!read->held || !read->admitted || read->return_post_recorded ||
+        read->cpu != cpu || cpu != owner->constructor_cpu) {
+        return -EPERM;
+    }
+    status = qemu_crucible_fault_register_read_frame_current_v1(
+        read->frame, read->holder, QEMU_CRUCIBLE_REGISTER_READ_ENTERED);
+    if (!status && !initial_register_read_same_facts(owner, read->frame,
+                                                   read->holder)) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        status = initial_register_read_parent(read->frame);
+    }
+    if (!status) {
+        status = initial_register_read_target(read->frame, false, false);
+    }
+    if (!status) {
+        status = qemu_plugin_crucible_native_initial_register_read_current_v1(
+            read->frame, read->holder, &read->native_child, true);
+    }
+    return status;
+}
+
+int qemu_crucible_source_initial_register_read_native_current_v1(
+    QemuCrucibleRegisterReadFrame *frame,
+    QemuCrucibleInitialRegisterRead **source_holder,
+    QemuCrucibleNativeInitialRegisterRead **holder,
+    QemuCrucibleRegisterReadPhase phase,
+    QemuCrucibleNativeInitialCpuChild **parent)
+{
+    QemuCrucibleInitialRegisterWorkspaceOwner *owner =
+        &startup_source.initial_register_workspace;
+    QemuCrucibleInitialRegisterRead *read = &owner->read;
+    int status;
+
+    /* Authenticate canonical storage before following any caller pointer.
+     * Native may not enroll a copied read or adopt an arbitrary output field. */
+    if (holder != &read->native_child || !parent) {
+        return -EPERM;
+    }
+    status = qemu_crucible_fault_register_read_frame_current_v1(
+        frame, source_holder, phase);
+    if (!status && (!initial_register_read_same_facts(owner, frame, source_holder) ||
+        read->return_post_attempted || read->native_consumed)) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        switch (phase) {
+        case QEMU_CRUCIBLE_REGISTER_READ_BOUND_ISSUING:
+            status = read->native_child || read->current_attempted ? -EBUSY : 0;
+            break;
+        case QEMU_CRUCIBLE_REGISTER_READ_CALLING:
+            status = !read->current_attempted || read->admitted ||
+                read->first_status || read->post_status ? -EPERM : 0;
+            break;
+        case QEMU_CRUCIBLE_REGISTER_READ_ENTERED:
+            status = !read->admitted || read->current_first_status ||
+                read->current_post_status ? -EPERM : 0;
+            break;
+        case QEMU_CRUCIBLE_REGISTER_READ_RETURNING:
+            status = !read->callback_returned || !read->native_return_attempted ||
+                frame->entered != read->admitted || frame->returned != frame->entered ?
+                -EPROTO : 0;
+            break;
+        default:
+            status = -EINVAL;
+        }
+    }
+    if (!status) {
+        status = initial_register_read_parent(frame);
+    }
+    if (!status) {
+        status = initial_register_read_target(frame, false,
+            phase != QEMU_CRUCIBLE_REGISTER_READ_ENTERED);
+    }
+    if (!status) {
+        *parent = owner->borrow_child;
+    }
+    return status;
+}
diff --git a/plugins/crucible-initial-register.inc.h b/plugins/crucible-initial-register.inc.h
new file mode 100644
index 0000000000000000000000000000000000000000..f5f2c96a57e467d2612235ae4b965f5a30886596
--- /dev/null
+++ b/plugins/crucible-initial-register.inc.h
@@ -0,0 +1,982 @@
+/*
+ * Initial register workspace mapping under the actual installation account
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifdef CONFIG_LINUX
+static int initial_register_cpu_owner_locked(
+    CPUState *cpu, QemuCrucibleCpuSourceAllocationOwner **out)
+{
+    QemuCrucibleCpuSourceAllocationOwner *owner;
+    int status;
+
+    for (owner = startup_source.cpu_allocations.owners; owner;
+         owner = owner->next) {
+        if (owner->payload == OBJECT(cpu)) {
+            break;
+        }
+    }
+    status = owner ? cpu_allocation_identity_locked(owner) : -ENOENT;
+    if (!status) {
+        status = object_native_allocation_live_instance_current(
+            OBJECT(cpu), owner, owner->receipt, owner->request_serial);
+    }
+    if (!status) {
+        *out = owner;
+    }
+    return status;
+}
+
+static int initial_register_child_owner_locked(
+    CPUState *cpu, Object **child_out,
+    QemuCrucibleCpuSourceAllocationOwner **owner_out)
+{
+    CPUClass *cc = CPU_GET_CLASS(cpu);
+    QemuCrucibleCpuSourceAllocationOwner *owner;
+    Object *child = NULL;
+    int status;
+
+    if (!bql_locked() || !cc->crucible_register_qom_child) {
+        return -EPERM;
+    }
+    status = cc->crucible_register_qom_child(cpu, &child);
+    if (status) {
+        return status;
+    }
+    if (!child) {
+        *child_out = NULL;
+        *owner_out = NULL;
+        return 0;
+    }
+    if (child->parent != OBJECT(cpu)) {
+        return -ESTALE;
+    }
+    for (owner = startup_source.cpu_allocations.owners; owner;
+         owner = owner->next) {
+        if (owner->payload == child) {
+            break;
+        }
+    }
+    status = owner ? cpu_allocation_identity_locked(owner) : -ENOENT;
+    if (!status) {
+        status = object_native_allocation_live_instance_current(
+            child, owner, owner->receipt, owner->request_serial);
+    }
+    if (!status && owner->payload_bytes != object_get_instance_size(child)) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        *child_out = child;
+        *owner_out = owner;
+    }
+    return status;
+}
+
+static int initial_register_workspace_identity(
+    QemuCrucibleInitialRegisterWorkspaceOwner *owner,
+    QemuCrucibleInitialRegisterWorkspaceOwner **holder, bool returning, bool terminal)
+{
+    QemuCrucibleCpuSourceAllocationOwner *cpu_owner;
+    size_t count = 0, children = 0;
+    int status;
+
+    if (owner != &startup_source.initial_register_workspace || !owner->held ||
+        !owner->attempted || owner->process != getpid() ||
+        owner->holder != holder || !holder || *holder != owner ||
+        owner->account != &startup_source.cpu_metadata_account ||
+        owner->transition_active ||
+        (terminal && (owner->borrow_held || owner->read.held))) {
+        return -EPERM;
+    }
+    status = qemu_crucible_fault_register_workspace_holder_v1(
+        owner, holder, returning);
+    if (!status) {
+        status = cpu_metadata_account_identity(owner->account);
+    }
+    if (!status && owner->fixed_extent != owner->account->fixed_native_extent) {
+        status = -ESTALE;
+    }
+    if (status) {
+        return status;
+    }
+    status = pthread_mutex_trylock(&startup_source.cpu_allocations.lock);
+    if (status) {
+        return -status;
+    }
+    for (cpu_owner = startup_source.cpu_allocations.owners; cpu_owner;
+         cpu_owner = cpu_owner->next) {
+        if (cpu_owner->register_workspace != owner) {
+            continue;
+        }
+        /* A returned ref may have destroyed its QOM object. Its registry owner
+         * remains pinned until the exact completed unref is journaled below. */
+        if (cpu_owner == owner->returning_qom_owner && owner->qom_returned) {
+            status = cpu_allocation_identity_locked(cpu_owner);
+            if (!status && !cpu_owner->constructor_children) {
+                status = -ESTALE;
+            }
+            if (status) {
+                break;
+            }
+            if (cpu_owner->register_workspace_parent) {
+                children++;
+            } else {
+                count++;
+            }
+            continue;
+        }
+        if (cpu_owner->register_workspace_parent) {
+            CPUState *parent = cpu_owner->register_workspace_parent;
+            QemuCrucibleCpuSourceAllocationOwner *parent_owner = NULL;
+            QemuCrucibleCpuSourceAllocationOwner *actual = NULL;
+            Object *child = NULL;
+
+            status = initial_register_cpu_owner_locked(parent, &parent_owner);
+            if (!status && (parent_owner->register_workspace != owner ||
+                !parent_owner->constructor_children || !parent->stopped ||
+                qatomic_read(&parent->running))) {
+                status = -ESTALE;
+            }
+            if (!status) {
+                status = initial_register_child_owner_locked(
+                    parent, &child, &actual);
+            }
+            if (!status && (actual != cpu_owner || !child ||
+                !cpu_owner->constructor_children ||
+                cpu_owner->binding != owner->account->binding)) {
+                status = -ESTALE;
+            }
+            if (status) {
+                break;
+            }
+            children++;
+            continue;
+        }
+        CPUState *cpu = CPU(cpu_owner->payload);
+        QemuCrucibleCpuSourceAllocationOwner *actual = NULL;
+
+        status = initial_register_cpu_owner_locked(cpu, &actual);
+        if (!status && (actual != cpu_owner || !cpu_owner->constructor_children ||
+            !cpu->stopped || qatomic_read(&cpu->running) ||
+            (terminal && !cpu_work_list_empty(cpu)))) {
+            status = -EBUSY;
+        }
+        if (status) {
+            break;
+        }
+        count++;
+    }
+    if (!status && (count != owner->pinned_cpus ||
+        children != owner->pinned_children || children > count ||
+        count > owner->layout.cpu_count)) {
+        status = -ESTALE;
+    }
+    pthread_mutex_unlock(&startup_source.cpu_allocations.lock);
+    return status;
+}
+#endif
+
+int qemu_crucible_source_initial_register_workspace_acquire_v1(
+    CPUState *cpu, QemuCrucibleInitialRegisterWorkspaceOwner **holder)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleInitialRegisterWorkspaceOwner *owner =
+        &startup_source.initial_register_workspace;
+    const QemuCrucibleRegisterWorkspaceLayout *layout = NULL;
+    struct QemuCrucibleInitialCpuParticipant *participant = NULL;
+    QemuCrucibleRegisterWorkspaceLayout checked;
+    CPUState *actual;
+    void *mapping;
+    int status = qemu_crucible_fault_register_workspace_issuing_v1(
+        cpu, holder, &layout);
+
+    if (!status && (!holder || *holder || owner->attempted || !layout)) {
+        status = -EINVAL;
+    }
+    if (!status) {
+        status = qemu_crucible_source_initial_cpu_current_v1(
+            cpu, &cpu->crucible_initial_participant);
+    }
+    if (!status) {
+        status = initial_cpu_identity(
+            cpu, &cpu->crucible_initial_participant, &participant);
+    }
+    if (!status) {
+        status = cpu_metadata_account_identity(&startup_source.cpu_metadata_account);
+    }
+    if (!status && (!crucible_register_workspace_layout(
+            &layout->geometry, layout->cpu_count, layout->model_bytes,
+            layout->page_bytes, &checked) ||
+        !crucible_register_workspace_equal(layout, &checked))) {
+        status = -EOVERFLOW;
+    }
+    if (status) {
+        return status;
+    }
+
+    /* The actual fixed Source/Native declarations were admitted before install.
+     * Born output precedes CPU loans and the independent mapping debit/effect. */
+    *owner = (QemuCrucibleInitialRegisterWorkspaceOwner) {
+        .holder = holder, .account = &startup_source.cpu_metadata_account,
+        .layout = *layout, .constructor_cpu = cpu,
+        .operation_serial = participant->operation_serial,
+        .group_serial = participant->group_serial,
+        .fixed_extent = startup_source.cpu_metadata_account.fixed_native_extent,
+        .process = getpid(), .attempted = true, .held = true,
+        .transition_active = true,
+    };
+    *holder = owner;
+    status = pthread_mutex_trylock(&startup_source.cpu_allocations.lock);
+    if (status) {
+        status = -status;
+    } else {
+        CPU_FOREACH(actual) {
+            QemuCrucibleCpuSourceAllocationOwner *cpu_owner = NULL;
+            QemuCrucibleCpuSourceAllocationOwner *child_owner = NULL;
+            Object *child = NULL;
+
+            status = initial_register_cpu_owner_locked(actual, &cpu_owner);
+            if (!status && (cpu_owner->binding != participant->binding ||
+                cpu_owner->register_workspace ||
+                cpu_owner->constructor_children == UINT_MAX ||
+                owner->pinned_cpus >= owner->layout.cpu_count ||
+                !actual->created || !actual->stopped ||
+                qatomic_read(&actual->running))) {
+                status = -EBUSY;
+            }
+            if (status) {
+                break;
+            }
+            /* Registry custody, not bytes in the soon-to-be-created mapping,
+             * owns these real refs through failed or uncertain unmap. */
+            object_ref(OBJECT(actual));
+            cpu_owner->constructor_children++;
+            cpu_owner->register_workspace = owner;
+            owner->pinned_cpus++;
+            status = initial_register_child_owner_locked(
+                actual, &child, &child_owner);
+            if (!status && child &&
+                (child_owner->binding != participant->binding ||
+                 child_owner->register_workspace ||
+                 child_owner->register_workspace_parent ||
+                 child_owner->constructor_children == UINT_MAX ||
+                 owner->pinned_children >= owner->layout.cpu_count)) {
+                status = -EBUSY;
+            }
+            if (status) {
+                break;
+            }
+            if (child) {
+                object_ref(child);
+                child_owner->constructor_children++;
+                child_owner->register_workspace_parent = actual;
+                child_owner->register_workspace = owner;
+                owner->pinned_children++;
+            }
+        }
+        if (!status && owner->pinned_cpus != owner->layout.cpu_count) {
+            status = -ESTALE;
+        }
+        pthread_mutex_unlock(&startup_source.cpu_allocations.lock);
+    }
+    if (!status) {
+        status = crucible_metadata_native_admit(&startup_source.metadata_partition,
+            owner->layout.backing_bytes, &owner->charge);
+    }
+    if (!status) {
+        status = initial_cpu_original_current(participant);
+    }
+    if (!status) {
+        owner->mmap_attempted = true;
+        mapping = mmap(NULL, owner->layout.backing_bytes, PROT_READ | PROT_WRITE,
+                       MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+        owner->mmap_returned = true;
+        if (mapping == MAP_FAILED) {
+            status = -errno;
+        } else {
+            owner->address = mapping;
+            owner->mapped = true;
+            if (!mapping) {
+                status = -EFAULT;
+            } else if (madvise(mapping, owner->layout.backing_bytes,
+                               MADV_DONTFORK) < 0) {
+                status = -errno;
+            }
+        }
+    }
+    if (!status) {
+        QemuCrucibleRegisterWorkspaceSpan *span =
+            &owner->layout.part[CRUCIBLE_REGISTER_WORKSPACE_CPUS];
+        QemuCrucibleRegisterCpuDependency *dependencies =
+            (void *)((uint8_t *)owner->address + span->offset);
+        size_t count = 0;
+
+        status = pthread_mutex_trylock(&startup_source.cpu_allocations.lock);
+        if (status) {
+            status = -status;
+        } else {
+            CPU_FOREACH(actual) {
+                QemuCrucibleCpuSourceAllocationOwner *cpu_owner = NULL;
+                QemuCrucibleCpuSourceAllocationOwner *child_owner = NULL;
+                Object *child = NULL;
+
+                status = initial_register_cpu_owner_locked(actual, &cpu_owner);
+                if (!status && (cpu_owner->register_workspace != owner ||
+                    count >= owner->pinned_cpus)) {
+                    status = -ESTALE;
+                }
+                if (status) {
+                    break;
+                }
+                status = initial_register_child_owner_locked(
+                    actual, &child, &child_owner);
+                if (!status && child &&
+                    (child_owner->register_workspace != owner ||
+                     child_owner->register_workspace_parent != actual ||
+                     !child_owner->constructor_children)) {
+                    status = -ESTALE;
+                }
+                if (status) {
+                    break;
+                }
+                dependencies[count++] = (QemuCrucibleRegisterCpuDependency) {
+                    .cpu = actual, .owner = cpu_owner,
+                    .receipt = cpu_owner->receipt,
+                    .generation = cpu_owner->request_serial,
+                    .instance_bytes = object_get_instance_size(OBJECT(actual)),
+                    .child = child, .child_owner = child_owner,
+                    .child_receipt = child ? child_owner->receipt : NULL,
+                    .child_generation = child ? child_owner->request_serial : 0,
+                    .child_instance_bytes = child ?
+                        object_get_instance_size(child) : 0,
+                };
+            }
+            if (!status && count != owner->pinned_cpus) {
+                status = -ESTALE;
+            }
+            pthread_mutex_unlock(&startup_source.cpu_allocations.lock);
+        }
+    }
+    owner->first_status = status;
+    owner->post_status = initial_cpu_child_original_observe(participant, true);
+    owner->transition_active = false;
+    return owner->first_status ? owner->first_status : owner->post_status;
+#else
+    return -ENOTSUP;
+#endif
+}
