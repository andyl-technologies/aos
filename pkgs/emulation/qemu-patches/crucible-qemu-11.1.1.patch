+        ==, -EBUSY);
+    for (unsigned int attempt = 0; attempt < 1000; attempt++) {
+        result = qemu_crucible_hot_fork_begin_retained_runtime_transaction(
+            &runtime_transaction, retained_rcu_barrier.generation,
+            retained_async_barrier.generation);
+        if (result != -EBUSY) {
+            break;
+        }
+        g_usleep(1000);
+    }
+    g_assert_cmpint(result, ==, 0);
+
+    child = fork();
+    g_assert_cmpint(child, >=, 0);
+    if (child == 0) {
+        ChildResourceReinitializer reinitializer = {
+            .address = source_mapping,
+            .length = page_size,
+            .backing_fd = private_mapping_fd,
+            .installed_mapping = MAP_FAILED,
+            .called = false,
+        };
+        sigset_t blocked;
+        QemuThreadHotForkInventory prepared_inventory;
+        QemuThreadHotForkInventory reconstructed_inventory = { 0 };
+        QemuCrucibleHotForkDescriptorTableProof descriptor_proof = { 0 };
+        int excluded_fds[] = { inherited_extra };
+        bool reconstructed = false;
+        int child_status;
+
+        close(child_result[0]);
+        close(old_result[0]);
+        fake_plugin_child_runtime = (FakePluginChildRuntime) {
+            .mapping = &reinitializer,
+            .phase = QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PHASE_WORKERS_HELD,
+        };
+        child_status = qemu_crucible_hot_fork_begin_descriptor_table(
+            &identity, &descriptor_transaction);
+        if (child_status == 0) {
+            child_status = qemu_crucible_hot_fork_reconstruct_child_runtime(
+                &runtime_transaction, &descriptor_transaction);
+        }
+        if (child_status == 0) {
+            qemu_thread_hot_fork_inventory(&prepared_inventory);
+            if (prepared_inventory.entry_count != 1 ||
+                prepared_inventory.entries[0].disposition !=
+                    QEMU_THREAD_HOT_FORK_COORDINATOR) {
+                child_status = -EPROTO;
+            }
+            qemu_thread_hot_fork_inventory_destroy(&prepared_inventory);
+        }
+        if (child_status == 0) {
+            if (sigprocmask(SIG_SETMASK, NULL, &blocked) < 0 ||
+                sigismember(&blocked, SIGUSR1) != 1) {
+                child_status = errno != 0 ? -errno : -EIO;
+            }
+        }
+        if (child_status == 0) {
+            child_status = qemu_crucible_hot_fork_complete_child_resource_plan(
+                resource_plan, &descriptor_transaction,
+                excluded_fds, G_N_ELEMENTS(excluded_fds),
+                &descriptor_proof);
+            verification.proof = &descriptor_proof;
+        }
+        if (child_status == 0) {
+            child_status =
+                qemu_crucible_hot_fork_apply_child_runtime_resource_plan(
+                    resource_plan, &descriptor_transaction,
+                    &runtime_transaction, verify_closed_descriptor_table,
+                    &verification, &plugin_reinitializer, &qmp_reinitializer,
+                    &console_reinitializer);
+        }
+        if (child_status == 0) {
+            child_status = qemu_crucible_hot_fork_activate_plugin_child(
+                &plugin_reinitializer);
+        }
+        if (child_status == 0) {
+            for (unsigned int attempt = 0; attempt < 1000; attempt++) {
+                qemu_thread_hot_fork_inventory(&reconstructed_inventory);
+                if (reconstructed_inventory.entry_count == 2) {
+                    reconstructed = true;
+                    break;
+                }
+                qemu_thread_hot_fork_inventory_destroy(
+                    &reconstructed_inventory);
+                g_usleep(1000);
+            }
+            if (!reconstructed) {
+                child_status = -EPROTO;
+            }
+            if (reconstructed) {
+                bool found_coordinator = false;
+                bool found_rcu = false;
+
+                for (size_t index = 0;
+                     index < reconstructed_inventory.entry_count; index++) {
+                    QemuThreadHotForkInventoryEntry *entry =
+                        &reconstructed_inventory.entries[index];
+
+                    found_coordinator |=
+                        entry->disposition ==
+                            QEMU_THREAD_HOT_FORK_COORDINATOR &&
+                        entry->thread_id == qemu_get_thread_id();
+                    found_rcu |= entry->disposition ==
+                        QEMU_THREAD_HOT_FORK_RCU_RESTART;
+                }
+                if (!found_coordinator || !found_rcu) {
+                    child_status = -EPROTO;
+                }
+                qemu_thread_hot_fork_inventory_destroy(
+                    &reconstructed_inventory);
+            }
+        }
+        if (child_status == 0 &&
+            (!descriptor_transaction.descriptors_applied ||
+             !descriptor_transaction.child_reinitialized ||
+             !descriptor_transaction.mappings_verified ||
+             !runtime_transaction.child_reconstructed ||
+             runtime_transaction.active || !reinitializer.called ||
+             !resource_plan->attempted || !resource_plan->applied ||
+             !plugin_reinitializer.attempted ||
+             !plugin_reinitializer.initialized ||
+             !plugin_reinitializer.activated ||
+             fake_plugin_child_runtime.calls != 2 ||
+             !qmp_reinitializer.attempted ||
+             !qmp_reinitializer.initialized ||
+             !qemu_crucible_hot_fork_qmp_child_reinitializer_complete(
+                 &qmp_reinitializer) ||
+             !qemu_crucible_hot_fork_qmp_child_reinitializer_bound_for(
+                 &qmp_reinitializer, &resource_plan->qmp,
+                 reinitialize_qmp_child, &qmp_runtime) ||
+             !qemu_crucible_hot_fork_child_resource_plan_contains_qmp(
+                 resource_plan, &resource_plan->qmp) ||
+             qmp_runtime.calls != 1 ||
+             !qemu_crucible_hot_fork_console_child_reinitializer_complete(
+                 &console_reinitializer) ||
+             !qemu_crucible_hot_fork_child_resource_plan_contains_console(
+                 resource_plan, &resource_plan->console) ||
+             console_runtime.calls != 1)) {
+            child_status = -EIO;
+        }
+        if (child_status == 0 &&
+            (qemu_crucible_hot_fork_apply_child_runtime_resource_plan(
+                 resource_plan, &descriptor_transaction,
+                 &runtime_transaction, verify_closed_descriptor_table,
+                 &verification, &plugin_reinitializer,
+                 &qmp_reinitializer, &console_reinitializer) != -EPERM ||
+             qemu_crucible_hot_fork_child_resource_plan_contains_plugin(
+                 resource_plan, &plugin_resources))) {
+            child_status = -EIO;
+        }
+        if (reinitializer.installed_mapping != MAP_FAILED) {
+            munmap(reinitializer.installed_mapping, page_size);
+        }
+        write_child_result(old_result[1], child_status);
+        _exit(0);
+    }
+
+    close(child_result[1]);
+    close(old_result[1]);
+    close(new_control[0]);
+    close(diagnostic_stream[1]);
+    close(qmp_stream[1]);
+    close(console_stream[1]);
+    g_assert_cmpint(qemu_crucible_hot_fork_release_parent_runtime_transaction(
+                        &runtime_transaction),
+                    ==, 0);
+    qemu_rcu_hot_fork_barrier(QEMU_RCU_HOT_FORK_BARRIER_QUERY,
+                              &retained_rcu_barrier);
+    qemu_async_worker_hot_fork_barrier(
+        QEMU_ASYNC_WORKER_HOT_FORK_BARRIER_QUERY, &retained_async_barrier);
+    g_assert_true(retained_rcu_barrier.held);
+    g_assert_true(retained_rcu_barrier.quiescent);
+    g_assert_true(retained_async_barrier.held);
+    g_assert_true(retained_async_barrier.quiescent);
+    g_assert_cmpint(read_child_result(child_result[0]), ==, 0);
+    g_assert_false(resource_plan->attempted);
+    g_assert_false(resource_plan->applied);
+    g_assert_cmpint(recv(new_control[1], &byte, 1, 0), ==, 1);
+    g_assert_cmpint(byte, ==, 't');
+    g_assert_cmpint(read(new_wake, &wake, sizeof(wake)), ==, sizeof(wake));
+    g_assert_cmpuint(wake, ==, 1);
+    g_assert_cmpint(fcntl(inherited_extra, F_GETFD), >=, 0);
+    wait_for_child(child);
+
+    qemu_crucible_hot_fork_release_parent_identity(&identity);
+    close(child_result[0]);
+    close(old_result[0]);
+    close(diagnostic_stream[0]);
+    close(qmp_stream[0]);
+    close(console_stream[0]);
+    close(old_control[0]);
+    close(old_control[1]);
+    close(new_control[1]);
+    close(old_wake);
+    close(new_wake);
+    close(inherited_extra);
+    close(private_mapping_fd);
+    g_assert_cmpint(munmap(source_mapping, page_size), ==, 0);
+    stop_registry_worker_thread(&monitor_worker);
+    qemu_rcu_hot_fork_barrier(QEMU_RCU_HOT_FORK_BARRIER_QUERY,
+                              &retained_rcu_barrier);
+    qemu_async_worker_hot_fork_barrier(
+        QEMU_ASYNC_WORKER_HOT_FORK_BARRIER_QUERY, &retained_async_barrier);
+    g_assert_false(retained_rcu_barrier.held);
+    g_assert_false(retained_async_barrier.held);
+}
