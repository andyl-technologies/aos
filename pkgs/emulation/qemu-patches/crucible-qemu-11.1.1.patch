+        g_free(blocks);
+        if (reported) {
+            qemu_crucible_ram_native_metadata_released(report_bytes);
+        }
+        return;
+    }
+    if (!context || !bql_locked()) {
+        dirty_retirement_status(-EPERM);
+        return;
+    }
+    qemu_mutex_lock_ramlist();
+    if (blocks->phase != DIRTY_HEADER_QUEUED) {
+        qemu_mutex_unlock_ramlist();
+        dirty_retirement_status(-ESTALE);
+        return;
+    }
+    blocks->phase = DIRTY_HEADER_GRACE_COMPLETE;
+    blocks->ready_next = NULL;
+    if (ram_list.dirty_retirement.ready_tail) {
+        ram_list.dirty_retirement.ready_tail->ready_next = blocks;
+    } else {
+        ram_list.dirty_retirement.ready_head = blocks;
