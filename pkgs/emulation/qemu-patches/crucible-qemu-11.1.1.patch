+}
+
+typedef struct AllocationFixture {
+    struct rcu_head rcu;
+    QemuCrucibleMetadataPartition *partition;
+    QemuCrucibleMetadataCharge charge;
+} AllocationFixture;
+
+/* Only requested allocation custody ends here; libc caches remain unqualified. */
+static void allocation_free(AllocationFixture *allocation)
+{
+    QemuCrucibleMetadataPartition *partition = allocation->partition;
+    QemuCrucibleMetadataCharge charge = allocation->charge;
+
+    g_free(allocation);
+    g_assert_cmpint(crucible_metadata_native_retire(
+        partition, &charge), ==, 0);
+    g_assert_false(charge.held);
+    g_assert_cmpint(crucible_metadata_native_retire(
+        partition, &charge), ==, -EALREADY);
+}
+
+static AllocationFixture *allocation_new(
+    QemuCrucibleMetadataPartition *partition)
+{
+    QemuCrucibleMetadataCharge charge = { 0 };
+    AllocationFixture *allocation;
+
+    g_assert_cmpint(crucible_metadata_native_admit(
+        partition, sizeof(*allocation), &charge), ==, 0);
+    allocation = g_new0(AllocationFixture, 1);
+    allocation->partition = partition;
+    allocation->charge = charge;
+    return allocation;
+}
+
+static void test_rcu_overlap(void)
+{
+    QemuCrucibleMetadataPartition partition;
+    AllocationFixture *old;
+    AllocationFixture *replacement;
+    uint64_t output;
+
+    fixture_issue(&partition);
+    g_assert_cmpint(crucible_metadata_controller_reserve(
+        &partition, fixture_requests, &output), ==, 0);
+    old = allocation_new(&partition);
+    replacement = allocation_new(&partition);
+    g_assert_cmpuint(partition.native_live, ==, 2 * sizeof(*old));
+
+    rcu_read_lock();
+    call_rcu(old, allocation_free, rcu);
+    g_assert_cmpuint(partition.native_live, ==, 2 * sizeof(*old));
+    rcu_read_unlock();
+    drain_call_rcu();
+    g_assert_cmpuint(partition.native_live, ==, sizeof(*replacement));
+    allocation_free(replacement);
+    g_assert_cmpuint(partition.native_live, ==, 0);
+    g_assert_cmpuint(partition.controller_extent, ==, 152);
+    g_assert_true(partition.controller_retained);
+}
