+int qemu_crucible_startup_source_main_ready_dispatch_v1(
+    QemuCrucibleFingerprintMainReadyFrame *frame, void *execution)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleFingerprintWakeKeeper *keeper = &startup_source.wake_keeper;
+    QemuCrucibleSourceControlBinding *component = &startup_source.control_callback;
+    QemuCrucibleFingerprintIntentObservation *observation =
+        &startup_source.intent_observation;
+    QemuCrucibleFingerprintIntentObservation **holder = NULL;
+    int status;
+
+    status = qemu_crucible_startup_source_wake_execution_instance_current_v1(
+        keeper, execution, keeper->execution_holder);
+    if (status) {
+        return status;
+    }
+    status = qemu_crucible_startup_source_control_component_current_v1(
+        component, component->callback, component->userdata);
+    if (status) {
+        return status;
+    }
+    if (!component->snapshot_callback || observation->held) {
+        return -EBUSY;
+    }
+    status = qemu_crucible_fingerprint_ready_snapshot_holder_borrow_v1(
+        frame, execution, &holder);
+    if (!status) {
+        status = qemu_crucible_fingerprint_ready_snapshot_holder_current_v1(frame, holder);
+    }
+    if (status) {
+        return status;
+    }
+    if (!holder || *holder) {
+        return -EBUSY;
+    }
+    /* This entire inline loan was included in sizeof(Source) before birth.
+     * Publish actual custody before the factual callback can refuse or leave
+     * partial output. Native ready proof supplies the outside-replay phase. */
+    *observation = (QemuCrucibleFingerprintIntentObservation) {
+        .component = component,
+        .execution = execution,
+        .frame = frame,
+        .holder = holder,
+        .process = getpid(),
+        .held = true,
+        .callback_invoking = true,
+    };
+    *holder = observation;
+    SOURCE_CALLBACK_MASKED_INVOKE(
+        status, &component->snapshot_callback, component->snapshot_callback, component->userdata,
+        &observation->facts, component->userdata);
+    observation->callback_status = status;
+    observation->callback_invoking = false;
+    /* These are copied intent facts only. The control sequence, ordinal and
+     * sample generation select no operation class, budget, Root or frontier. */
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
