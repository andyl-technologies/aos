+        error_setg_errno(errp, result > 0 ? result : -result,
+                         "Crucible selectable reply requires a successful VM-stop flush");
+        return NULL;
+    }
+
+    boundary = g_new0(CrucibleSelectableReplyBoundary, 1);
+    boundary->raw_boundary_icount = qemu_plugin_icount_raw();
+    return boundary;
