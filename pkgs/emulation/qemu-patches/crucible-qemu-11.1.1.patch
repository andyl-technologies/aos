+        if (request->receive_entropy == chr_read &&
+            request->opaque == vrng) {
+            error_setg(errp, "virtio-rng projection requires drained entropy "
+                       "requests");
+            return false;
+        }
+    }
+
+    if (!virtio_save_fingerprint_projection(f, VIRTIO_DEVICE(vrng), errp)) {
+        return false;
+    }
+    qemu_put_be64(f, vrng->conf.max_bytes);
+    qemu_put_be32(f, vrng->conf.period_ms);
+    qemu_put_be64(f, vrng->quota_remaining);
+    qemu_put_byte(f, vrng->activate_timer);
+    qemu_put_byte(f, timer_pending(vrng->rate_limit_timer));
+    if (timer_pending(vrng->rate_limit_timer)) {
+        timer_status = timer_expire_time_ns_phase(vrng->rate_limit_timer,
+                                                  &expiry_ns, &phase_ps);
+        if (timer_status != 1) {
+            error_setg(errp, "virtio-rng timer deadline cannot be projected");
+            return false;
+        }
+        qemu_put_sbe64(f, expiry_ns);
+        qemu_put_be16(f, phase_ps);
+    }
+    return qemu_file_get_error(f) == 0;
