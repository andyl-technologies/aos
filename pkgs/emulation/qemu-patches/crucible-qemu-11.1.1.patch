+#ifdef CONFIG_LINUX
+/* Only the dispatcher can lend this synchronous scope. Neither invocation
+ * coordinates nor a successful prior check can create the held borrow. */
+static int parent_park_callback_identity(qemu_plugin_id_t id)
+{
+    QemuCrucibleParentParkReceive *owner = &startup_source.parent_park_receive;
+    QemuCrucibleParentParkLoan *loan = &startup_source.parent_park_loan;
+    int status = parent_park_main_identity(true);
+
+    if (status) {
+        return status;
+    }
+    status = parent_park_receive_identity(owner);
+    if (status) {
+        return status;
+    }
+    if (id != startup_source.saved.plugin_id ||
+        id != owner->installer.plugin_id ||
+        !loan->issued || !loan->held || loan->receive != owner ||
+        loan->process != getpid() || !qemu_thread_is_self(&loan->thread) ||
+        !loan->ctx_retained || owner->borrowers != 1 ||
+        !loan->transition_busy || !loan->callback_request ||
+        !loan->callback_invocation ||
+        loan->callback != startup_source.parent_park_callback ||
+        loan->callback_userdata != startup_source.parent_park_userdata) {
+        return -EPERM;
+    }
+    if (qatomic_load_acquire(&owner->busy) || owner->creating) {
+        return -EBUSY;
+    }
+    return 0;
+}
+
+static int parent_park_callback_slice(qemu_plugin_id_t id,
+                                     uint64_t *remaining_ns)
+{
+    QemuCrucibleParentParkReceive *owner = &startup_source.parent_park_receive;
+    QemuCrucibleParentParkLoan *loan = &startup_source.parent_park_loan;
+    uint64_t slices[2] = { 0 };
+    int status = parent_park_callback_identity(id);
+
+    if (status || parent_park_source_overlap(remaining_ns, sizeof(*remaining_ns))) {
+        return status ? status : -EINVAL;
+    }
+    if (qatomic_cmpxchg(&owner->busy, false, true)) {
+        return -EBUSY;
+    }
+
+    /* Reobserve both live Originals even when the first one or an earlier
+     * callback failed. A successful observation cannot erase retained debt. */
+    for (size_t index = 0; index < G_N_ELEMENTS(slices); index++) {
+        int current = parent_park_original_raw_current(owner, index, &slices[index]);
+
+        owner->original_current[index] = current;
+        parent_park_fail(owner, current, false);
+    }
+    status = loan->first_status ? loan->first_status : owner->first_status;
+    if (!status && !owner->validated) {
+        status = -ENOKEY;
+    }
+    if (!status) {
+        uint64_t remaining = MIN(slices[0], slices[1]);
+
+        if (!remaining) {
+            status = parent_park_fail(owner, -EPROTO, false);
+        } else {
+            *remaining_ns = remaining;
+        }
+    }
+    qatomic_store_release(&owner->busy, false);
+    return status;
+}
+#endif
