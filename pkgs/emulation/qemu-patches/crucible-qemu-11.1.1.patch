+int qemu_plugin_crucible_ram_mark_write_v1(uint64_t generation, uint32_t index,
+                                          uint64_t page_index)
+{
+    CrucibleRamRegion *region;
+    ram_addr_t address;
+    unsigned long first, end;
+
+    /* Fault service requires no RCU/BQL/replay lock or observer callback. All
+     * pointers are immutable after process-lifetime topology pinning. */
+    if (!qatomic_load_acquire(&paging_topology_pinned) || !admission_regions ||
+        generation != admission.topology_generation ||
+        generation != qatomic_read(&topology_generation) ||
+        index >= admission_regions->len) {
+        return -ESTALE;
+    }
+    region = region_inventory_index(admission_regions, index);
+    if (page_index > UINT64_MAX / RAM_PAGE_BYTES ||
+        page_index * RAM_PAGE_BYTES >= region->descriptor.logical_length) {
+        return -ERANGE;
+    }
+    address = region->block->offset + page_index * RAM_PAGE_BYTES;
+    first = address >> TARGET_PAGE_BITS;
+    end = TARGET_PAGE_ALIGN(address + RAM_PAGE_BYTES) >> TARGET_PAGE_BITS;
+    for (unsigned long page = first; page < end; page++) {
+        unsigned long block = page / DIRTY_MEMORY_BLOCK_SIZE;
+        unsigned long bit = page % DIRTY_MEMORY_BLOCK_SIZE;
+
+        for (unsigned client = 0; client < DIRTY_MEMORY_NUM; client++) {
+            /* CODE is an invalidation sentinel owned by the actual writer.
+             * Setting it before a DMA memcpy returns would make its subsequent
+             * invalidate_and_set_dirty() skip live translated code. */
+            if (client == DIRTY_MEMORY_CODE) {
+                continue;
+            }
+            bitmap_set_atomic(paging_dirty_planes[client]->blocks[block], bit, 1);
+        }
+    }
+    qemu_crucible_ram_dirty_generation_advance();
+    qemu_crucible_checkpoint_dirty_generation_advance();
+    return 0;
+}
