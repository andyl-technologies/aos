+int qemu_plugin_crucible_startup_control_reserve_v2(
+    qemu_plugin_id_t id,
+    const struct qemu_plugin_crucible_control_request_v2 requests[7],
+    qemu_plugin_crucible_control_purpose_v2 **purpose)
+{
+    QemuCrucibleProcessPurposeRequest native_requests[7];
+    QemuCrucibleStartupControlPurpose *tentative = NULL;
+    int status;
+
+    /* Refuse foreign/noncurrent calls before reading any caller request or
+     * mutable selected purpose storage. Preserve the saved initiating cause.
+     */
+    if (!startup_invocation(id)) {
+        return -EPERM;
+    }
+    status = startup_active(id);
+    if (status) {
+        return status;
+    }
+    if (!requests || !purpose) {
+        return startup_failure(-EINVAL);
+    }
+    for (size_t index = 0; index < 7; index++) {
+        native_requests[index] = (QemuCrucibleProcessPurposeRequest) {
+            .extent = requests[index].extent_bytes,
+            .alignment = requests[index].alignment_bytes,
+            .count = requests[index].birth_count,
+        };
+    }
+    status = qemu_crucible_startup_source_control_purpose_reserve_v2(
+        id, native_requests, &tentative);
+    if (!status) {
+        *purpose = tentative;
+    }
+    return status;
+}
