+static void test_sha256_caller_vector(const uint8_t *input, size_t length,
+                                      const char *expected)
+{
+    QCryptoSHA256 hash;
+    uint8_t digest[32];
+
+    g_assert_cmpint(qcrypto_sha256_init(&hash), ==, 0);
+    g_assert_cmpint(qcrypto_sha256_update(&hash, input, length), ==, 0);
+    g_assert_cmpint(qcrypto_sha256_finalize(&hash, digest, sizeof(digest)), ==, 0);
+    for (size_t index = 0; index < sizeof(digest); index++) {
+        g_assert_cmpint(hex[digest[index] >> 4], ==, expected[index * 2]);
+        g_assert_cmpint(hex[digest[index] & 15], ==, expected[index * 2 + 1]);
+    }
+}
+
+static void test_sha256_caller_owned(void)
+{
+    const char *long_message =
+        "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq";
+    const char *longer_message =
+        "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmn"
+        "hijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu";
+    const char *million_a_digest =
+        "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0";
+    uint8_t input[1000];
+    uint8_t digest[32], expected[32];
+    QCryptoSHA256 hash;
+    g_autoptr(GChecksum) full_reference = NULL;
+    gsize full_expected_len = sizeof(expected);
+
+    test_sha256_caller_vector(NULL, 0,
+        "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855");
+    test_sha256_caller_vector((const uint8_t *)"abc", 3,
+        "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
+    test_sha256_caller_vector((const uint8_t *)long_message, strlen(long_message),
+        "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1");
+    test_sha256_caller_vector((const uint8_t *)longer_message,
+        strlen(longer_message),
+        "cf5b16a778af8380036ce59e7b0492370b249b11e8f07a51afac45037afee9d1");
+
+    memset(input, 'a', sizeof(input));
+    g_assert_cmpint(qcrypto_sha256_init(&hash), ==, 0);
+    for (size_t index = 0; index < 1000; index++) {
+        g_assert_cmpint(qcrypto_sha256_update(&hash, input, sizeof(input)), ==, 0);
+    }
+    g_assert_cmpint(qcrypto_sha256_finalize(&hash, digest, sizeof(digest)), ==, 0);
+    for (size_t index = 0; index < sizeof(digest); index++) {
+        g_assert_cmpint(hex[digest[index] >> 4], ==, million_a_digest[index * 2]);
+        g_assert_cmpint(hex[digest[index] & 15], ==,
+                        million_a_digest[index * 2 + 1]);
+    }
+
+    /* Every split crosses the 55/56-byte padding and 63/64-byte block edges. */
+    for (size_t index = 0; index < sizeof(input); index++) {
+        input[index] = index * 29 + 17;
+    }
+    for (size_t length = 0; length <= 257; length++) {
+        g_autoptr(GChecksum) reference = g_checksum_new(G_CHECKSUM_SHA256);
+        gsize expected_len = sizeof(expected);
+
+        g_checksum_update(reference, input, length);
+        g_checksum_get_digest(reference, expected, &expected_len);
+        for (size_t split = 0; split <= length; split++) {
+            g_assert_cmpint(qcrypto_sha256_init(&hash), ==, 0);
+            g_assert_cmpint(qcrypto_sha256_update(&hash, input, split), ==, 0);
+            g_assert_cmpint(qcrypto_sha256_update(&hash, NULL, 0), ==, 0);
+            g_assert_cmpint(qcrypto_sha256_update(
+                &hash, input + split, length - split), ==, 0);
+            g_assert_cmpint(qcrypto_sha256_finalize(
+                &hash, digest, sizeof(digest)), ==, 0);
+            g_assert_cmpmem(digest, sizeof(digest), expected, sizeof(expected));
+        }
+        for (size_t chunk = 1; chunk <= 70; chunk++) {
+            g_assert_cmpint(qcrypto_sha256_init(&hash), ==, 0);
+            for (size_t offset = 0; offset < length; offset += chunk) {
+                g_assert_cmpint(qcrypto_sha256_update(
+                    &hash, input + offset, MIN(chunk, length - offset)), ==, 0);
+            }
+            g_assert_cmpint(qcrypto_sha256_finalize(
+                &hash, digest, sizeof(digest)), ==, 0);
+            g_assert_cmpmem(digest, sizeof(digest), expected, sizeof(expected));
+        }
+    }
+
+    /* Different chunk sizes within each message exercise arbitrary grouping. */
+    full_reference = g_checksum_new(G_CHECKSUM_SHA256);
+    g_checksum_update(full_reference, input, sizeof(input));
+    g_checksum_get_digest(full_reference, expected, &full_expected_len);
+    for (uint32_t seed = 1; seed <= 32; seed++) {
+        uint32_t random = seed;
+        size_t offset = 0;
+
+        g_assert_cmpint(qcrypto_sha256_init(&hash), ==, 0);
+        while (offset < sizeof(input)) {
+            size_t chunk;
+
+            random = random * 1664525u + 1013904223u;
+            chunk = MIN(1 + random % 103, sizeof(input) - offset);
+            g_assert_cmpint(qcrypto_sha256_update(
+                &hash, input + offset, chunk), ==, 0);
+            offset += chunk;
+        }
+        g_assert_cmpint(qcrypto_sha256_finalize(
+            &hash, digest, sizeof(digest)), ==, 0);
+        g_assert_cmpmem(digest, sizeof(digest), expected, sizeof(expected));
+    }
+}
+
+static void test_sha256_caller_refusal(void)
+{
+    QCryptoSHA256 hash, saved;
+    uint8_t output[34], saved_output[sizeof(output)];
+    const uint8_t input = 0x5a;
+
+    memset(output, 0xa5, sizeof(output));
+    memcpy(saved_output, output, sizeof(output));
+    g_assert_cmpint(qcrypto_sha256_init(NULL), ==, -EINVAL);
+    g_assert_cmpint(qcrypto_sha256_init(
+        (QCryptoSHA256 *)(UINTPTR_MAX & ~(_Alignof(QCryptoSHA256) - 1))),
+        ==, -EINVAL);
+    g_assert_cmpint(qcrypto_sha256_init(&hash), ==, 0);
+    memcpy(&saved, &hash, sizeof(hash));
+    g_assert_cmpint(qcrypto_sha256_init(
+        (QCryptoSHA256 *)((uint8_t *)&hash + 1)), ==, -EINVAL);
+    g_assert_cmpint(qcrypto_sha256_update(&hash, &hash, 1), ==, -EINVAL);
+    g_assert_cmpint(qcrypto_sha256_update(&hash, NULL, 1), ==, -EINVAL);
+    g_assert_cmpint(qcrypto_sha256_update(
+        &hash, (void *)(UINTPTR_MAX - 1), 4), ==, -EINVAL);
+
+    g_assert_cmpint(qcrypto_sha256_finalize(
+        &hash, (uint8_t *)&hash, 32), ==, -EINVAL);
+    g_assert_cmpint(qcrypto_sha256_finalize(&hash, NULL, 32), ==, -EINVAL);
+    g_assert_cmpint(qcrypto_sha256_finalize(
+        &hash, (void *)(UINTPTR_MAX - 15), 32), ==, -EINVAL);
+    g_assert_cmpint(qcrypto_sha256_finalize(&hash, output, 31), ==, -EINVAL);
+    g_assert_cmpint(qcrypto_sha256_finalize(&hash, output, 33), ==, -EINVAL);
+    g_assert_cmpmem(&hash, sizeof(hash), &saved, sizeof(saved));
+    g_assert_cmpmem(output, sizeof(output), saved_output, sizeof(saved_output));
+
+    hash.bytes = UINT64_MAX / 8;
+    memcpy(&saved, &hash, sizeof(hash));
+    g_assert_cmpint(qcrypto_sha256_update(&hash, &input, 1), ==, -EOVERFLOW);
+    g_assert_cmpmem(&hash, sizeof(hash), &saved, sizeof(saved));
+    hash.bytes++;
+    memcpy(&saved, &hash, sizeof(hash));
+    g_assert_cmpint(qcrypto_sha256_update(&hash, NULL, 0), ==, -EOVERFLOW);
+    g_assert_cmpint(qcrypto_sha256_finalize(&hash, output, 32), ==, -EINVAL);
+    g_assert_cmpmem(&hash, sizeof(hash), &saved, sizeof(saved));
+    g_assert_cmpmem(output, sizeof(output), saved_output, sizeof(saved_output));
+
+    g_assert_cmpint(qcrypto_sha256_init(&hash), ==, 0);
+    g_assert_cmpint(qcrypto_sha256_update(&hash, &input, 1), ==, 0);
+    g_assert_cmpint(qcrypto_sha256_finalize(&hash, output + 1, 32), ==, 0);
+    g_assert_cmpint(output[0], ==, 0xa5);
+    g_assert_cmpint(output[33], ==, 0xa5);
+    memcpy(&saved, &hash, sizeof(hash));
+    memcpy(saved_output, output, sizeof(output));
+    g_assert_cmpint(qcrypto_sha256_update(&hash, &input, 1), ==, -EINVAL);
+    g_assert_cmpint(qcrypto_sha256_finalize(&hash, output + 1, 32), ==, -EINVAL);
+    g_assert_cmpmem(&hash, sizeof(hash), &saved, sizeof(saved));
+    g_assert_cmpmem(output, sizeof(output), saved_output, sizeof(saved_output));
+    test_sha256_caller_vector((const uint8_t *)"abc", 3,
+        "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
+}
+
 int main(int argc, char **argv)
 {
     int ret = qcrypto_init(&error_fatal);
     g_assert(ret == 0);
 
     g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/crypto/hash/sha256-caller", test_sha256_caller_owned);
+    g_test_add_func("/crypto/hash/sha256-caller-refusal", test_sha256_caller_refusal);
     g_test_add_func("/crypto/hash/iov", test_hash_iov);
     g_test_add_func("/crypto/hash/alloc", test_hash_alloc);
     g_test_add_func("/crypto/hash/prealloc", test_hash_prealloc);
