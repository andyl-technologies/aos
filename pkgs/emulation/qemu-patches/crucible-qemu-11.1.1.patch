+static QemuRecMutex parked_worker_recursive_mutex;
+static QemuMutex parked_worker_wait_mutex;
+static QemuCond parked_worker_cond;
+static bool parked_worker_released;
+static unsigned int parked_worker_depth;
+
+/*
+ * A monitor-restart worker parked the way the dispatching QMP IOThread is
+ * parked inside crucible-hot-fork: holding its recursive lock and waiting on
+ * a condition variable whose mutex it has released.
+ */
+static void *parked_monitor_registry_worker(void *opaque)
+{
+    RegistryWorker *worker = opaque;
+    unsigned int depth;
+
+    qemu_thread_hot_fork_set_current_disposition(
+        QEMU_THREAD_HOT_FORK_MONITOR_RESTART);
+    rcu_register_thread();
+    for (depth = 0; depth < parked_worker_depth; depth++) {
+        qemu_rec_mutex_lock(&parked_worker_recursive_mutex);
+    }
+    qemu_mutex_lock(&parked_worker_wait_mutex);
+    write_child_result(worker->ready_fd, 0);
+    while (!parked_worker_released) {
+        qemu_cond_wait(&parked_worker_cond, &parked_worker_wait_mutex);
+    }
+    qemu_mutex_unlock(&parked_worker_wait_mutex);
+    for (depth = 0; depth < parked_worker_depth; depth++) {
+        qemu_rec_mutex_unlock(&parked_worker_recursive_mutex);
+    }
+    (void)read_child_result(worker->release_fd);
+    rcu_unregister_thread();
+    return NULL;
+}
+
+static void parked_worker_init(unsigned int depth)
+{
+    qemu_rec_mutex_init(&parked_worker_recursive_mutex);
+    qemu_mutex_init(&parked_worker_wait_mutex);
+    qemu_cond_init(&parked_worker_cond);
+    parked_worker_released = false;
+    parked_worker_depth = depth;
+}
+
+static void parked_worker_release(void)
+{
+    qemu_mutex_lock(&parked_worker_wait_mutex);
+    parked_worker_released = true;
+    qemu_cond_signal(&parked_worker_cond);
+    qemu_mutex_unlock(&parked_worker_wait_mutex);
+}
+
+static void parked_worker_destroy(void)
+{
+    qemu_cond_destroy(&parked_worker_cond);
+    qemu_mutex_destroy(&parked_worker_wait_mutex);
+    qemu_rec_mutex_destroy(&parked_worker_recursive_mutex);
+}
