+int qemu_crucible_ram_inventory_capture_topology_v1(
+    QemuCrucibleRamInventoryCaptureLoan *loan, uint8_t digest[32])
+{
+    blake3_hasher hasher;
+    int status;
+
+    if (loan != &inventory_capture || !digest) {
+        return -EINVAL;
+    }
+    status = inventory_capture_current(loan);
+    if (status) {
+        return status;
+    }
+    hash_tag(&hasher, "topology");
+    hash_u32(&hasher, RAM_PAGE_BYTES);
+    hash_u32(&hasher, loan->regions->len);
+    for (size_t index = 0; index < loan->regions->len; index++) {
+        hash_descriptor(&hasher, region_inventory_index(loan->regions, index));
+    }
+    status = inventory_capture_current(loan);
+    if (!status) {
+        blake3_hasher_finalize(&hasher, digest, 32);
+    }
+    return status;
+}
