+    int status = command_registry_identity(id);
+
+    if (status || !holder) {
+        return status ? status : -EINVAL;
+    }
+    qemu_mutex_lock(&commands->mutex);
+    status = received_delivery_identity_locked(owner, serial);
+    if (!status && holder != (owner->transferred ? owner->runtime_holder : owner->creation_output)) {
+        status = -ESTALE;
+    }
+    if (!status && (owner->use_users || owner->ready_users || owner->payload_transition_active ||
+                    owner->payload_held || owner->payload_uncertain || owner->payload ||
+                    (owner->payload_serial && !owner->payload_returned))) {
+        status = -EBUSY;
+    }
+    if (!status) {
+        status = publisher_terminal_return_locked(owner);
+    }
+    if (!status) {
+        owner->receive->delivery_users--;
+        owner->member->action_users--;
