+int qemu_rcu_hot_fork_census(QemuRcuHotForkBarrierOperation operation,
+                             QemuCrucibleParkCensus *out)
+{
+    struct rcu_reader_data *reader;
+    size_t count = 0;
+    bool complete = true;
+
+    *out = (QemuCrucibleParkCensus) { 0 };
+    QEMU_LOCK_GUARD(&rcu_hot_fork_barrier_lock);
+    if (operation == QEMU_RCU_HOT_FORK_BARRIER_HOLD &&
+        !qatomic_read(&rcu_hot_fork_barrier_held)) {
+        qemu_event_reset(&rcu_hot_fork_barrier_release);
+        qatomic_set(&rcu_hot_fork_barrier_owner, qemu_get_thread_id());
+        smp_mb_global();
+        qatomic_set(&rcu_hot_fork_barrier_held, 1);
+        rcu_hot_fork_barrier_generation++;
+        assert(rcu_hot_fork_barrier_generation != 0);
+        out->acquired = true;
+    } else if (operation == QEMU_RCU_HOT_FORK_BARRIER_RELEASE) {
+        if (qatomic_read(&rcu_hot_fork_barrier_owner) != qemu_get_thread_id()) {
+            return -ESTALE;
+        }
+        qatomic_set(&rcu_hot_fork_barrier_held, 0);
+        qatomic_set(&rcu_hot_fork_barrier_owner, 0);
+        rcu_hot_fork_barrier_generation++;
+        assert(rcu_hot_fork_barrier_generation != 0);
+        qemu_event_set(&rcu_hot_fork_barrier_release);
+    } else if (operation != QEMU_RCU_HOT_FORK_BARRIER_HOLD &&
+               operation != QEMU_RCU_HOT_FORK_BARRIER_QUERY) {
+        return -EINVAL;
+    }
+
+    out->held = qatomic_read(&rcu_hot_fork_barrier_held);
+    out->owner_thread_id = qatomic_read(&rcu_hot_fork_barrier_owner);
+    out->barrier_generation = rcu_hot_fork_barrier_generation;
+    qemu_mutex_lock(&rcu_registry_lock);
+    out->generation[0] = rcu_hot_fork_generation;
+    QLIST_FOREACH(reader, &registry, node) {
+        if (count == QEMU_RCU_HOT_FORK_INVENTORY_MAX) {
+            complete = false;
+            break;
+        }
+        count++;
+        complete &= !qatomic_read(&reader->ctr);
+    }
+    qemu_mutex_unlock(&rcu_registry_lock);
+    out->complete = complete && !qatomic_read(&rcu_hot_fork_admissions) &&
+        !qatomic_read(&rcu_hot_fork_pending_callbacks) &&
+        !qatomic_read(&in_drain_call_rcu) &&
+        qemu_crucible_park_array_request(
+            &out->arrays[0], count, sizeof(QemuRcuHotForkInventoryEntry),
+            _Alignof(QemuRcuHotForkInventoryEntry), NULL);
