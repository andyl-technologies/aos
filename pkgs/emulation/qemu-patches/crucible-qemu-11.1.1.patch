+static void test_generic_tcg_timer_preserves_long_horizon(void)
+{
+    const int64_t beyond_signed_ps_horizon =
+        INT64_MAX / PICOSECONDS_PER_NANOSECOND +
+        INT64_C(1000000000);
+    int64_t now_ns;
+    int64_t deadline_ns;
+    __int128 deadline_ps;
+    QEMUTimer *timer;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    qemu_init_clocks(NULL);
+    qemu_timer_enable_tcg_ps_clock(NULL, NULL);
+    qemu_clock_enable(QEMU_CLOCK_VIRTUAL, true);
+    timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, test_timer_callback, NULL);
+    now_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    g_assert_cmpint(now_ns, <=, INT64_MAX - beyond_signed_ps_horizon);
+    deadline_ns = now_ns + beyond_signed_ps_horizon;
+    deadline_ps = (__int128)deadline_ns * PICOSECONDS_PER_NANOSECOND + 50;
+
+    g_assert_true(timer_mod_ns_phase(timer, deadline_ns, 50));
+    g_assert_true(timer_pending(timer));
+    g_assert_true(timer_expire_time_ps_wide(timer) == deadline_ps);
+    g_assert_cmpuint(timer_expire_time_ns(timer), ==,
+                     deadline_ns + 1);
+    g_assert_false(qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL));
+
+    g_assert_true(timer_mod_after_ns(timer, beyond_signed_ps_horizon));
+    g_assert_true(timer_expire_time_ps_wide(timer) > INT64_MAX);
+    timer_mod_ps_wide(timer, deadline_ps + PICOSECONDS_PER_NANOSECOND);
+    g_assert_true(timer_mod_anticipate_after_ns(
+        timer, beyond_signed_ps_horizon));
+    g_assert_true(timer_expire_time_ps_wide(timer) > INT64_MAX);
+    timer_free(timer);
+}
