+static size_t subsection_payload(const GByteArray *bytes, const char *name)
+{
+    size_t length = strlen(name);
+
+    for (size_t index = 2; index + length + 4 < bytes->len; index++) {
+        if (bytes->data[index - 2] == QEMU_VM_SUBSECTION &&
+            bytes->data[index - 1] == length &&
+            memcmp(bytes->data + index, name, length) == 0) {
+            return index + length + 4;
+        }
+    }
+    g_assert_not_reached();
+}
