+enum {
+    FIXTURE_DESCRIPTOR_COUNT = QEMU_CRUCIBLE_PREEXEC_SETUP_V6_WORKSPACE_FDS + 1,
+    FIXTURE_DESCRIPTOR_LIMIT = 128,
+};
+
+/* This test constructor is an ordering witness, not a production callback. */
+static void __attribute__((constructor)) fixture_constructor(void)
+{
+    if (getenv("QEMU_CRUCIBLE_PREEXEC_TEST_PROBE")) {
+        const char marker[] = "CONSTRUCTOR\n";
+        ssize_t written = write(STDOUT_FILENO, marker, sizeof(marker) - 1);
