+static void qemu_plugin_advance_time_bh(void *opaque)
+{
+    QEMUBH *barrier = (QEMUBH *)qatomic_load_acquire(
+        &qemu_plugin_time_advance_barrier);
+    int64_t new_time = qatomic_read(&qemu_plugin_time_advance_target);
+    int status = 0;
+
+    (void)opaque;
+    if (!barrier) {
+        barrier = qemu_bh_new(qemu_plugin_time_advance_barrier_bh, NULL);
+
+        qatomic_store_release(&qemu_plugin_time_advance_barrier,
+                              (uintptr_t)barrier);
+    }
+    qatomic_store_release(&qemu_plugin_time_advance_timer_state,
+                          QEMU_PLUGIN_TIME_ADVANCE_TIMERS_NOT_READY);
+    if (!has_control) {
+        status = -ENODEV;
+    } else {
+        icount_advance_virtual_time_to_ns(new_time);
+    }
+
+    qatomic_set(&qemu_plugin_time_advance_status, status);
+    g_assert(strcmp(current_accel_name(), "sim") == 0);
