new file mode 100644
index 0000000000000000000000000000000000000000..74f76ce9c42cee9ebd27167bc4ee13b493f3b2a9
--- /dev/null
+++ b/tests/qtest/crucible-exact-tb-exit.py
@@ -0,0 +1,85 @@
+# Copyright (c) Andyl, Inc.
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Checks that an x86 OUT callback exits before a chained TB executes."""
+
+import argparse
+import os
+import subprocess
+import tempfile
+
+
+TIMEOUT_SECONDS = 10
+
+
+def build_bios(path):
+    """Builds a minimal BIOS whose first I/O instruction terminates its TB."""
+    bios = bytearray(65536)
+    bios[:17] = bytes(
+        (
+            0xFA,              # cli
+            0xB0, 0x5A,        # mov $0x5a, %al
+            0xE6, 0xE7,        # out %al, $0xe7
+            0x90, 0x90, 0x90,  # instructions that a stale soft kick executes
+            0x90, 0x90, 0x90,
+            0x90, 0x90, 0x90,
+            0x90,
+            0xEB, 0xFE,        # terminal loop
+        )
+    )
+    bios[-16:-11] = bytes((0xEA, 0x00, 0x00, 0x00, 0xF0))
+    with open(path, "wb") as output:
+        output.write(bios)
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--qemu", required=True)
+    parser.add_argument("--plugin", required=True)
+    arguments = parser.parse_args()
+
+    with tempfile.TemporaryDirectory(prefix="exact-tb-exit-") as temp_dir:
+        bios = os.path.join(temp_dir, "bios.bin")
+        build_bios(bios)
+        result_read, result_write = os.pipe()
+        command = [
+            arguments.qemu,
+            "-machine", "pc-q35-9.2",
+            "-cpu", "qemu64",
+            "-smp", "1",
+            "-nodefaults",
+            "-display", "none",
+            "-serial", "none",
+            "-bios", bios,
+            "-icount", "shift=0,align=off,sleep=off,rr_switch_quantum=4096",
+            "-accel", "sim,thread=single",
+            "-plugin", f"{arguments.plugin},result-fd={result_write}",
+        ]
+        process = subprocess.Popen(
+            command,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            pass_fds=(result_write,),
+        )
+        os.close(result_write)
+        try:
+            stdout, stderr = process.communicate(timeout=TIMEOUT_SECONDS)
+        except subprocess.TimeoutExpired:
+            process.kill()
+            stdout, stderr = process.communicate()
+            raise AssertionError(
+                f"QEMU exact-exit test timed out: {stderr.decode(errors='replace')}"
+            )
+        result = os.read(result_read, 4096).decode(errors="replace").strip()
+        os.close(result_read)
+
+    if process.returncode != 0 or not result.startswith("PASS "):
+        raise AssertionError(
+            f"exact TB exit failed: status={process.returncode} result={result!r} "
+            f"stdout={stdout.decode(errors='replace')!r} "
+            f"stderr={stderr.decode(errors='replace')!r}"
+        )
+    print(result)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/qtest/crucible-fingerprint-projection.py b/tests/qtest/crucible-fingerprint-projection.py
new file mode 100644
index 0000000000000000000000000000000000000000..e706fae531724410879b192c7a0b529d0d697f7b
--- /dev/null
+++ b/tests/qtest/crucible-fingerprint-projection.py
@@ -0,0 +1,733 @@
+# Copyright (c) 2026 ANDYL Technologies
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Checks live machine fingerprint projections through the control boundary."""
+
+import argparse
+import json
+import os
+import select
+import socket
+import struct
+import subprocess
+import tempfile
+import time
+
+
+TIMEOUT_SECONDS = 20
+VIRTIO_CORE_SCHEMA = b"crucible.qemu.virtio-core.v3"
+
+SECTION_SUCCESSORS = {
+    "cpu": "kvm-tpr-opt",
+    "0000:00:1f.0/ICH9LPC": "i8259",
+    "ps2kbd": "ps2mouse",
+    "pckbd": "vmmouse",
+    "0000:00:1f.2/ich9_ahci": "i2c_bus",
+    "0000:00:1f.3/ich9_smb": "smbus-eeprom",
+    "arm_gic": "pl011",
+    "acpi-ged": "fw_cfg",
+}
+
+
+def section_marker(name, instance=None, version=1):
+    encoded = name.encode()
+    marker = struct.pack(">H", len(encoded)) + encoded
+    if instance is not None:
+        marker += struct.pack(">II", instance, version)
+    return marker
+
+
+def projection_section(material, name, instance=None):
+    """Selects one production-framed provider section from sealed material."""
+    if instance is None:
+        start_marker = section_marker(name)
+        end_marker = section_marker(SECTION_SUCCESSORS[name])
+    elif name == "pflash_cfi01" and instance == 0:
+        start_marker = section_marker(name, instance)
+        end_marker = section_marker(name, 1)
+    else:
+        raise AssertionError(f"unknown production section successor: {name}")
+    start = material.find(start_marker)
+    end = material.find(end_marker, start + len(start_marker))
+    if start < 0 or end < 0 or material.find(start_marker, start + 1) >= 0:
+        raise AssertionError(f"ambiguous production section framing: {name}")
+    return material[start:end]
+
+
+def projection_suffix(material, name, instance, version=1):
+    """Selects material starting at one exact production section marker."""
+    marker = section_marker(name, instance, version)
+    start = material.find(marker)
+    if start < 0 or material.find(marker, start + 1) >= 0:
+        raise AssertionError(f"ambiguous production section framing: {name}")
+    return material[start:]
+
+
+def assert_current_virtio_projection_schema(material):
+    """Requires the sole current virtio core and provider layout."""
+    provider_markers = (
+        section_marker("0000:00:01.0/virtio-rng", 0, 5),
+        section_marker("0000:00:02.0/virtio-net", 0, 5),
+    )
+    if any(material.count(marker) != 1 for marker in provider_markers):
+        raise AssertionError("aggregate omitted a current virtio provider")
+    if material.count(VIRTIO_CORE_SCHEMA) != len(provider_markers):
+        raise AssertionError("aggregate did not use only virtio-core v3")
+
+
+class LiveFingerprintQemu:
+    """Owns one paused production-profile VM and its observer streams."""
+
+    def __init__(self, qemu, plugin, architecture, net_tx="bh",
+                 accel="sim,thread=single", x86_smp="1,maxcpus=2",
+                 extra_fds=(), environment=None):
+        self.wait_for_idle = architecture == "x86_64"
+        self.temp_dir = tempfile.TemporaryDirectory(prefix="fingerprint-live-")
+        self.qtest_path = os.path.join(self.temp_dir.name, "qtest.sock")
+        self.qtest_listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+        self.qtest_listener.bind(self.qtest_path)
+        self.qtest_listener.listen(1)
+        self.qtest_listener.settimeout(TIMEOUT_SECONDS)
+
+        self.bios_path = os.path.join(self.temp_dir.name, "halt-bios.bin")
+        bios = bytearray([0xFF]) * (128 * 1024)
+        if architecture == "x86_64":
+            bios[-16:-13] = b"\xf4\xeb\xfd"
+            self.vcpu_count = int(x86_smp.split(",", 1)[0])
+            machine_args = [
+                "-machine", "pc-q35-9.2",
+                "-cpu", "qemu64,-rdrand,-rdseed",
+                "-smp", x86_smp,
+            ]
+        elif architecture == "aarch64":
+            self.vcpu_count = 1
+            bios[:8] = b"\x5f\x20\x03\xd5\xff\xff\xff\x17"
+            machine_args = [
+                "-machine", "virt-9.2",
+                "-cpu", "cortex-a57,pmu=off",
+                "-smp", "1",
+            ]
+        else:
+            raise AssertionError(f"unsupported architecture: {architecture}")
+        with open(self.bios_path, "wb") as bios_file:
+            bios_file.write(bios)
+
+        wake_read, self.wake_write = os.pipe()
+        self.result_read, result_write = os.pipe()
+        self.material_socket, material_child = socket.socketpair(
+            socket.AF_UNIX, socket.SOCK_DGRAM
+        )
+        self.material_socket.settimeout(TIMEOUT_SECONDS)
+        os.set_blocking(wake_read, False)
+        command = [
+            qemu,
+            *machine_args,
+            "-m", "64M",
+            "-nodefaults",
+            "-no-user-config",
+            "-display", "none",
+            "-serial", "none",
+            "-parallel", "none",
+            "-monitor", "none",
+            "-S",
+            "-accel", accel,
+            "-icount",
+            "shift=0,sleep=off,align=off,rr_switch_quantum=4096",
+            "-rtc", "base=2026-01-01T00:00:00,clock=vm",
+            "-seed", "1097729",
+            "-bios", self.bios_path,
+            "-device", "virtio-rng-pci,bus=pcie.0,addr=0x1",
+            "-device",
+            f"virtio-net-pci,bus=pcie.0,addr=0x2,tx={net_tx}",
+            "-qmp", "stdio",
+            "-qtest", f"unix:{self.qtest_path}",
+            "-plugin",
+            (f"{plugin},wake-fd={wake_read},result-fd={result_write},"
+             f"material-fd={material_child.fileno()}"),
+        ]
+        self.process = subprocess.Popen(
+            command,
+            stdin=subprocess.PIPE,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            pass_fds=(wake_read, result_write, material_child.fileno(),
+                      *extra_fds),
+            env=environment,
+        )
+        material_child.close()
+        os.close(wake_read)
+        os.close(result_write)
+        self.qmp_buffer = bytearray()
+        self.qtest_buffer = bytearray()
+        self.result_buffer = bytearray()
+        self.command_id = 0
+        self.events = []
+        self.capture_count = 0
+
+        greeting = self._read_qmp_message()
+        if "QMP" not in greeting:
+            raise AssertionError(f"missing QMP greeting: {greeting!r}")
+        self.qtest, _ = self.qtest_listener.accept()
+        self.qtest.settimeout(TIMEOUT_SECONDS)
+        self.qmp("qmp_capabilities")
+
+    def _read_fd(self, fd, deadline):
+        remaining = deadline - time.monotonic()
+        if remaining <= 0 or not select.select([fd], [], [], remaining)[0]:
+            raise TimeoutError("QEMU fingerprint operation timed out")
+        chunk = os.read(fd, 4096)
+        if not chunk:
+            stderr = self.process.stderr.read().decode(errors="replace")
+            raise RuntimeError(f"QEMU stream closed: {stderr}")
+        return chunk
+
+    def _read_qmp_message(self, timeout=TIMEOUT_SECONDS):
+        deadline = time.monotonic() + timeout
+        stdout_fd = self.process.stdout.fileno()
+        while b"\n" not in self.qmp_buffer:
+            self.qmp_buffer.extend(self._read_fd(stdout_fd, deadline))
+        line, _, remainder = self.qmp_buffer.partition(b"\n")
+        self.qmp_buffer = bytearray(remainder)
+        return json.loads(line)
+
+    def qmp_send(self, execute, arguments=None):
+        """Sends one QMP command and returns its request identifier."""
+        self.command_id += 1
+        request = {"execute": execute, "id": self.command_id}
+        if arguments is not None:
+            request["arguments"] = arguments
+        self.process.stdin.write(json.dumps(request).encode() + b"\n")
+        self.process.stdin.flush()
+        return self.command_id
+
+    def qmp_response_within(self, command_id, execute, timeout):
+        """Returns whether one QMP response arrived within the timeout."""
+        deadline = time.monotonic() + timeout
+        while True:
+            remaining = deadline - time.monotonic()
+            if remaining <= 0:
+                return False, None
+            try:
+                message = self._read_qmp_message(remaining)
+            except TimeoutError:
+                return False, None
+            if "event" in message:
+                self.events.append(message)
+                continue
+            if message.get("id") != command_id:
+                raise AssertionError(f"unexpected QMP response: {message!r}")
+            if "error" in message:
+                raise AssertionError(f"QMP {execute} failed: {message['error']!r}")
+            return True, message.get("return")
+
+    def qmp(self, execute, arguments=None):
+        command_id = self.qmp_send(execute, arguments)
+        completed, result = self.qmp_response_within(
+            command_id, execute, TIMEOUT_SECONDS
+        )
+        if not completed:
+            raise TimeoutError(f"QMP {execute} timed out")
+        return result
+
+    def qtest_send(self, command):
+        """Sends one command on the independent qtest channel."""
+        self.qtest.sendall(command.encode() + b"\n")
+
+    def qtest_response_within(self, timeout):
+        """Returns one complete qtest response if it arrives within the bound."""
+        deadline = time.monotonic() + timeout
+        while b"\n" not in self.qtest_buffer:
+            try:
+                self.qtest_buffer.extend(
+                    self._read_fd(self.qtest.fileno(), deadline)
+                )
+            except TimeoutError:
+                return False, None
+        line, _, remainder = self.qtest_buffer.partition(b"\n")
+        self.qtest_buffer = bytearray(remainder)
+        return True, bytes(line + b"\n")
+
+    def qtest_command(self, command):
+        self.qtest_send(command)
+        completed, response = self.qtest_response_within(TIMEOUT_SECONDS)
+        if not completed:
+            raise TimeoutError(f"qtest command timed out: {command}")
+        if response != b"OK\n":
+            raise AssertionError(f"qtest command failed: {command}: {response!r}")
+
+    def qtest_read(self, command):
+        self.qtest_send(command)
+        completed, response = self.qtest_response_within(TIMEOUT_SECONDS)
+        if not completed:
+            raise TimeoutError(f"qtest read timed out: {command}")
+        fields = response.decode().strip().split()
+        if len(fields) != 2 or fields[0] != "OK":
+            raise AssertionError(f"qtest read failed: {command}: {response!r}")
+        return int(fields[1], 0)
+
+    def stderr_snapshot(self):
+        os.set_blocking(self.process.stderr.fileno(), False)
+        try:
+            return self.process.stderr.read().decode(errors="replace")
+        finally:
+            os.set_blocking(self.process.stderr.fileno(), True)
+
+    def pci_config_write(self, devfn, offset, width, value):
+        address = 0x80000000 | (devfn << 8) | (offset & ~3)
+        self.qtest_command(f"outl 0xcf8 0x{address:x}")
+        port = 0xCFC + (offset & 3)
+        self.qtest_command(f"out{width} 0x{port:x} 0x{value:x}")
+
+    def _read_result_line(self):
+        deadline = time.monotonic() + TIMEOUT_SECONDS
+        while b"\n" not in self.result_buffer:
+            self.result_buffer.extend(self._read_fd(self.result_read, deadline))
+        line, _, remainder = self.result_buffer.partition(b"\n")
+        self.result_buffer = bytearray(remainder)
+        return line.decode()
+
+    def capture(self, *, already_running=False):
+        """Captures the next aggregate from a paused or authenticated running VM."""
+        if not already_running:
+            self.qmp("cont")
+        if self.wait_for_idle:
+            idle_vcpus = set()
+            while len(idle_vcpus) != self.vcpu_count:
+                boundary = self._read_result_line()
+                if boundary.startswith("idle vcpu="):
+                    idle_vcpus.add(int(boundary.split()[1].split("=", 1)[1]))
+                elif boundary.startswith("resume vcpu="):
+                    idle_vcpus.discard(
+                        int(boundary.split()[1].split("=", 1)[1])
+                    )
+                else:
+                    raise AssertionError(
+                        f"missing all-vCPU idle fence: {boundary}"
+                    )
+        elif self.capture_count == 0:
+            deadline = time.monotonic() + TIMEOUT_SECONDS
+            while True:
+                running = self.qmp("query-status") == {
+                    "status": "running", "running": True
+                }
+                replay = self.qmp("query-replay")
+                if running and replay["icount"] > 0:
+                    break
+                if time.monotonic() >= deadline:
+                    raise TimeoutError(
+                        "QEMU did not execute a TB before capture"
+                    )
+        else:
+            while True:
+                boundary = self._read_result_line()
+                if boundary.startswith("resume vcpu="):
+                    break
+                if not boundary.startswith("idle vcpu="):
+                    raise AssertionError(
+                        f"missing completed VM-stop resume fence: {boundary}"
+                    )
+
+        os.write(self.wake_write, b"C")
+        while True:
+            line = self._read_result_line()
+            if not (line.startswith("resume vcpu=") or
+                    line.startswith("idle vcpu=")):
+                break
+        fields = dict(field.split("=", 1) for field in line.split())
+        if fields.get("stable") != "true" or fields.get("capture") != "0/0":
+            raise AssertionError(
+                f"unstable aggregate capture: {line}: "
+                f"{self.stderr_snapshot()}"
+            )
+        if fields.get("hash") != "0/0" or fields.get("stop") != "0":
+            raise AssertionError(f"failed aggregate capture: {line}")
+        ram_digest = fields.get("ram_digest", "")
+        if (
+            fields.get("ram_schema") != "2" or
+            fields.get("ram_edition") != "1" or
+            fields.get("ram_scope") != "0" or
+            not fields.get("ram_bytes", "").isdigit() or
+            int(fields["ram_bytes"]) <= 0 or
+            len(ram_digest) != 64 or
+            any(character not in "0123456789abcdef" for character in ram_digest)
+        ):
+            raise AssertionError(f"invalid bounded RAM root capture: {line}")
+        if fields.get("material") != "0":
+            raise AssertionError(f"failed material transfer: {line}")
+        if fields.get("cleanup") != "0/0/0/0":
+            raise AssertionError(f"retained material cleanup: {line}")
+        if fields.get("unmatched_ready") != "0":
+            raise AssertionError(f"unrelated ready marker was rejected: {line}")
+        if fields.get("unmatched_ready_outside") != "0":
+            raise AssertionError(
+                f"unrelated ready marker outside the boundary was rejected: {line}"
+            )
+        if fields.get("sample") == "0" and (
+            fields.get("paused") != "0/0" or
+            fields.get("paused_hash") != "0/0" or
+            fields.get("paused_stable") != "true"
+        ):
+            raise AssertionError(f"failed plugin-quiesced capture: {line}")
+        if fields.get("digest") != fields.get("repeat"):
+            raise AssertionError(f"repeat aggregate changed: {line}")
+        self.last_capture = fields
+        self.capture_count += 1
+        _, ancillary, _, _ = self.material_socket.recvmsg(
+            1, socket.CMSG_SPACE(struct.calcsize("i"))
+        )
+        received_fds = [
+            struct.unpack("i", data[:struct.calcsize("i")])[0]
+            for level, kind, data in ancillary
+            if level == socket.SOL_SOCKET and kind == socket.SCM_RIGHTS
+        ]
+        if len(received_fds) != 1:
+            raise AssertionError("observer did not transfer one material fd")
+        material_fd = received_fds[0]
+        try:
+            self.last_material = os.pread(
+                material_fd, int(fields["bytes"]), 0
+            )
+        finally:
+            os.close(material_fd)
+        assert_current_virtio_projection_schema(self.last_material)
+
+        status = self.qmp("query-status")
+        if status != {"status": "paused", "running": False}:
+            raise AssertionError(f"aggregate boundary did not pause: {status!r}")
+        return fields["digest"]
+
+    def close(self):
+        try:
+            if self.process.poll() is None:
+                self.process.terminate()
+                self.process.wait(timeout=TIMEOUT_SECONDS)
+        finally:
+            if self.process.poll() is None:
+                self.process.kill()
+                self.process.wait()
+            self.qtest.close()
+            self.qtest_listener.close()
+            self.material_socket.close()
+            os.close(self.wake_write)
+            os.close(self.result_read)
+            self.temp_dir.cleanup()
+        if self.process.returncode != 0:
+            stderr = self.process.stderr.read().decode(errors="replace")
+            raise AssertionError(
+                f"QEMU exited with status {self.process.returncode}: {stderr}"
+            )
+
+
+def with_machine(qemu, plugin, architecture, check, net_tx="bh"):
+    live = LiveFingerprintQemu(qemu, plugin, architecture, net_tx)
+    try:
+        check(live)
+    finally:
+        live.close()
+
+
+def configure_lpc(live):
+    live.pci_config_write(0xF8, 0x40, "l", 0xB001)
+    live.pci_config_write(0xF8, 0x44, "b", 0x80)
+
+
+def configure_smbus(live):
+    live.pci_config_write(0xFB, 0x20, "l", 0xB101)
+    live.pci_config_write(0xFB, 0x04, "w", 0x0001)
+    live.pci_config_write(0xFB, 0x40, "b", 0x09)
+
+
+def add_second_cpu(live):
+    available = next(
+        cpu for cpu in live.qmp("query-hotpluggable-cpus")
+        if "qom-path" not in cpu
+    )
+    live.qmp("device_add", {
+        "driver": available["type"],
+        "id": "fingerprint-cpu",
+        **available["props"],
+    })
+
+
+def system_reset(live):
+    live.qmp("system_reset")
+
+
+def set_controller_obdata(live, value):
+    live.qtest_command("outb 0x64 0xd2")
+    live.qtest_command(f"outb 0x60 0x{value:x}")
+    live.qtest_read("inb 0x60")
+
+
+def assert_changed(label, first, second):
+    if first == second:
+        raise AssertionError(
+            f"{label} mutation did not change projection: {first}"
+        )
+
+
+def assert_converged(label, first, second):
+    if first != second:
+        raise AssertionError(
+            f"{label} histories did not converge: {first} != {second}"
+        )
+
+
+def capture_section(live, name, instance=None):
+    live.capture()
+    return projection_section(live.last_material, name, instance)
+
+
+def run_q35_cases(qemu, plugin):
+    def check_ps2(live):
+        baseline_keyboard = capture_section(live, "ps2kbd")
+        baseline_controller = capture_section(live, "pckbd")
+        timer_marker = section_marker("timer", 0, 6)
+        if live.last_material.count(timer_marker) != 1:
+            raise AssertionError(
+                "production material omitted the current timer projection"
+            )
+
+        live.qtest_command("outb 0x60 0xf2")
+        assert_changed(
+            "PS/2 command-reply ring", baseline_keyboard,
+            capture_section(live, "ps2kbd"),
+        )
+        before_throttle = capture_section(live, "pckbd")
+        live.qtest_read("inb 0x60")
+        assert_changed(
+            "PS/2 controller throttle continuation", before_throttle,
+            capture_section(live, "pckbd"),
+        )
+
+        system_reset(live)
+        live.capture()
+        live.qtest_command("outb 0x64 0xd2")
+        live.qtest_command("outb 0x60 0x5a")
+        assert_changed(
+            "PS/2 controller output source and control byte",
+            baseline_controller, capture_section(live, "pckbd"),
+        )
+
+        system_reset(live)
+        set_controller_obdata(live, 0xa5)
