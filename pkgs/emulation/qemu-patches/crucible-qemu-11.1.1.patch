+/*
+ * A reset-spanning dispatch generation owns the RR loop until reset completes
+ * or terminal shutdown cancels it.  Only CPU stop and synchronous reset work
+ * may run while the main loop is paused inside reset handling.
+ */
+static bool rr_crucible_sim_service_deferred_reset_handoff(void)
+{
+    uint64_t generation = qatomic_load_acquire(
+        &rr_deferred_reset_dispatch_generation);
+
+    if (generation == 0) {
+        return false;
+    }
+
+    while (true) {
+        uint64_t current_generation = qatomic_load_acquire(
+            &rr_deferred_reset_dispatch_generation);
+
+        if (current_generation == 0) {
+            return true;
+        }
+        g_assert(current_generation == generation);
+
+        if (qemu_shutdown_requested_get() != SHUTDOWN_CAUSE_NONE ||
+            qemu_force_shutdown_requested()) {
+            rr_crucible_sim_reset_handoff_cancel();
+            return true;
+        }
+
+        qemu_event_reset(&rr_dispatch_ceiling_event);
+        rr_crucible_sim_drain_vcpu_work();
+
+        if (qemu_shutdown_requested_get() != SHUTDOWN_CAUSE_NONE ||
+            qemu_force_shutdown_requested()) {
+            rr_crucible_sim_reset_handoff_cancel();
+            return true;
+        }
+        if (qatomic_load_acquire(&rr_deferred_reset_handoff_ready)) {
+            rr_crucible_sim_finish_main_loop_handoff(generation);
+            qatomic_store_release(
+                &rr_deferred_reset_dispatch_generation, 0);
+            qatomic_store_release(&rr_deferred_reset_handoff_ready, false);
+            if (rr_crucible_sim_main_loop_dispatch_pending()) {
+                generation = rr_crucible_sim_begin_main_loop_handoff();
+                /* Rearm work whose wake was consumed by reset handling. */
+                qemu_notify_event();
+                rr_crucible_sim_finish_main_loop_handoff(generation);
+            }
+            return true;
+        }
+
+        rr_replay_mutex_unlock();
+        bql_unlock();
+        qemu_event_wait(&rr_dispatch_ceiling_event);
+        rr_replay_mutex_lock();
+        bql_lock();
+    }
+}
