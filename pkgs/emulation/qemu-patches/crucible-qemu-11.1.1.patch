+int qemu_crucible_checkpoint_candidate_read_page_v1(
+    QemuCrucibleCheckpointCandidateReadLoan *loan,
+    uint64_t address, uint8_t *output, uint32_t valid)
+{
+    QemuCrucibleCheckpointHeldTransaction *owner = &checkpoint_transaction;
+    uint64_t slice;
+    int post;
+    int status = qemu_crucible_checkpoint_candidate_read_identity_v1(loan, false);
+
+    if (status || !output || !valid || valid > sizeof(loan->page_scratch) ||
+        loan->reader_invoking || loan->cleanup_invoking) {
+        return status ? status : -EINVAL;
+    }
+    status = qemu_crucible_checkpoint_candidate_read_region_current_v1(
+        loan, address, valid);
+    if (!status) {
+        status = checkpoint_current(owner);
+    }
+    if (!status) {
+        status = checkpoint_live(owner, &slice, false);
+    }
+    if (status) {
+        return status;
+    }
+    loan->reader_invoking = true;
+    status = owner->pager.candidate_read(owner->pager.installer.plugin_id, loan,
+                                         address, loan->page_scratch, valid,
+                                         owner->pager.userdata);
+    loan->reader_invoking = false;
+    if (status) {
+        status = checkpoint_fail(owner, status < 0 ? status : -EPROTO, false);
+    }
+    /* Observe the same native Original after every actual callback, including
+     * failure. Neither partial bytes nor an expired post reach caller output.
+     */
+    post = checkpoint_live(owner, &slice, true);
+    if (!monitor_qmp_connection_watch_valid(owner->request->monitor,
+                                             owner->request->connection_epoch)) {
+        checkpoint_fail(owner, -ESTALE, true);
+    }
+    if (!status) {
+        status = post ? post : checkpoint_current(owner);
+    }
+    if (!status) {
+        memcpy(output, loan->page_scratch, valid);
+    }
+    return status;
+}
+
+int qemu_crucible_checkpoint_candidate_root_v1(
+    QemuCrucibleCheckpointCandidateReadLoan *loan,
+    uint32_t scope, uint32_t refresh, uint8_t *record, size_t capacity,
+    size_t *written, uint8_t root[32], uint64_t *logical_bytes)
+{
+    QemuCrucibleCheckpointHeldTransaction *owner = &checkpoint_transaction;
+    uint8_t observed_root[32];
+    uint64_t observed_bytes, slice;
+    size_t observed_written;
+    int post;
+    int status = qemu_crucible_checkpoint_candidate_read_identity_v1(loan, false);
+
+    if (status || scope > 2 || refresh > 1 || !written || !root ||
+        !logical_bytes || (!record && capacity) ||
+        loan->observer_invoking || loan->reader_invoking ||
+        loan->cleanup_invoking) {
+        return status ? status : -EINVAL;
+    }
+    status = checkpoint_current(owner);
+    if (!status) {
+        status = checkpoint_live(owner, &slice, false);
+    }
+    if (status) {
+        return status;
+    }
+    loan->observer_invoking = true;
+    status = owner->pager.candidate_observe(
+        owner->pager.installer.plugin_id, loan, scope, refresh, record, capacity,
+        &observed_written, observed_root, &observed_bytes, owner->pager.userdata);
+    loan->observer_invoking = false;
+    if (status) {
+        status = checkpoint_fail(owner, status < 0 ? status : -EPROTO, false);
+    }
+    post = checkpoint_live(owner, &slice, true);
+    if (!monitor_qmp_connection_watch_valid(owner->request->monitor,
+                                             owner->request->connection_epoch)) {
+        checkpoint_fail(owner, -ESTALE, true);
+    }
+    if (!status) {
+        status = post ? post : checkpoint_current(owner);
+    }
+    {
+        int publication;
+
+        /* Only this actual callback-return/post boundary issues publication.
+         * Callees reobserve this exact native cut, never trust caller scalars. */
+        loan->publication_refresh = refresh;
+        loan->publication_first_status = status;
+        loan->publication_post_status = post;
+        loan->publication_cut_active = true;
+        publication = qemu_crucible_checkpoint_candidate_capture_publication_v1(
+            loan, refresh, status, post);
+        loan->publication_cut_active = false;
+        if (publication) {
+            checkpoint_fail(owner, publication, true);
+        }
+        if (!status) {
+            status = publication;
+        }
+    }
+    if (!status) {
+        memcpy(root, observed_root, sizeof(observed_root));
+        *written = observed_written;
+        *logical_bytes = observed_bytes;
+    }
+    return status;
+}
+
+int qemu_crucible_checkpoint_candidate_read_end_v1(
+    QemuCrucibleCheckpointCandidateReadLoan **candidate, int status)
+{
+    QemuCrucibleCheckpointHeldTransaction *owner = &checkpoint_transaction;
+    QemuCrucibleCheckpointCandidateReadLoan *loan;
+    uint64_t slice;
+    int identity;
+
+    if (!candidate || status > 0) {
+        return -EINVAL;
+    }
+    loan = *candidate;
+    identity = qemu_crucible_checkpoint_candidate_read_identity_v1(loan, false);
+    if (!identity && !loan->reader_invoking && !loan->observer_invoking &&
+        !loan->publication_cut_active && !loan->cleanup_invoking) {
+        identity = qemu_crucible_checkpoint_candidate_writer_capture_close_v1(loan);
+        if (!identity) {
+            identity = qemu_crucible_checkpoint_candidate_capture_reader_cleanup_v1(loan);
+        }
+    }
+    if (identity || loan->reader_invoking || loan->observer_invoking ||
+        loan->publication_cut_active || loan->cleanup_invoking ||
+        qemu_crucible_checkpoint_candidate_capture_busy_v1(loan)) {
+        return identity ? identity : -EBUSY;
+    }
+    if (status) {
+        checkpoint_fail(owner, status, false);
+    }
+    /* Return this real reader even when its independent Original post fails.
+     * Root/provider/Stopped remain retained for later candidate disposition.
+     */
+    checkpoint_live(owner, &slice, true);
+    if (!monitor_qmp_connection_watch_valid(owner->request->monitor,
+                                             owner->request->connection_epoch)) {
+        checkpoint_fail(owner, -ESTALE, true);
+    }
+    qemu_crucible_checkpoint_candidate_capture_reader_return_v1(loan);
+    loan->active = false;
+    *candidate = NULL;
+    return checkpoint_current(owner);
+}
+
+int qemu_crucible_checkpoint_candidate_writer_capture_begin_v1(
+    QemuCrucibleCheckpointCandidateReadLoan *loan,
+    qemu_plugin_crucible_checkpoint_candidate_capture_v1 **borrowed,
+    struct qemu_plugin_crucible_ram_capture_v1 *inventory)
+{
+    int status = qemu_crucible_checkpoint_candidate_read_identity_v1(loan, false);
+
+    if (status) {
+        return status;
+    }
+    if (!borrowed || *borrowed || !inventory || loan->writer_capture ||
+        loan->reader_invoking || loan->observer_invoking ||
+        loan->cleanup_invoking || loan->publication_cut_active) {
+        return -EPERM;
+    }
+    /* The real constructor writes directly into the embedded native holder.
+     * No successful return or later stack-local check publishes this custody.
+     * This private caller always requests a non-fingerprint complete inventory.
+     */
+    status = qemu_plugin_crucible_checkpoint_candidate_capture_begin_v1(
+        loan, 1, &loan->writer_capture, inventory);
+    *borrowed = loan->writer_capture;
+    if (status) {
+        status = status < 0 ? status : -EPROTO;
+        if (!loan->writer_capture_first_status) {
+            loan->writer_capture_first_status = status;
+        }
+        checkpoint_fail(loan->transaction, status, false);
+    }
+    return status;
+}
+
+int qemu_crucible_checkpoint_candidate_writer_capture_close_v1(
+    QemuCrucibleCheckpointCandidateReadLoan *loan)
+{
+    int status = qemu_crucible_checkpoint_candidate_read_identity_v1(loan, false);
+
+    if (status) {
+        return status;
+    }
+    if (loan->reader_invoking || loan->observer_invoking ||
+        loan->cleanup_invoking || loan->publication_cut_active) {
+        return -EBUSY;
+    }
+    if (!loan->writer_capture) {
+        return 0;
+    }
+    /* Only this actual constructor-issued native holder is consumed. finish0
+     * performs identity-only physical noACK close on the creating Main/BQL,
+     * including expired Original. A negative keeps every nonnull holder.
+     */
+    status = qemu_plugin_crucible_checkpoint_candidate_capture_finish_v1(
+        &loan->writer_capture, 0);
+    if (status) {
+        status = status < 0 ? status : -EPROTO;
+        if (!loan->writer_capture_post_status) {
+            loan->writer_capture_post_status = status;
+        }
+        checkpoint_fail(loan->transaction, status, true);
+    }
+    return status;
+}
+
+int qemu_crucible_checkpoint_candidate_cleanup_main_v1(
+    QemuCrucibleCheckpointCandidateReadLoan *loan)
+{
+    QemuCrucibleCheckpointHeldTransaction *owner = &checkpoint_transaction;
+    QemuCrucibleCheckpointRequestLoan *request = &checkpoint_request;
+    int post;
+    int status = qemu_crucible_checkpoint_candidate_read_identity_v1(loan, false);
+
+    if (status) {
+        return status;
+    }
+    if (loan->reader_invoking || loan->observer_invoking ||
+        loan->publication_cut_active || loan->cleanup_invoking ||
+        owner->invoking || owner->cleanup_invoking || owner->finalize_invoking ||
+        owner->inventory.active || owner->inventory.metadata_borrow ||
+        owner->inventory.output.held || owner->inventory.output.close_uncertain ||
+        owner->inventory.cancellation.held || owner->inventory.cancellation.close_uncertain || owner->invocation.active || request->provider_invoking) {
+        return -EBUSY;
+    }
+    /* Only a genuinely moved handle belongs to native cleanup. A still-issued
+     * claim must remain in its module's actual holder until that owner closes it.
+     */
+    status = qemu_crucible_checkpoint_candidate_writer_capture_close_v1(loan);
+    if (!status) {
+        status = qemu_crucible_checkpoint_candidate_capture_before_module_cleanup_v1(loan);
+    }
+    if (status) {
+        return status;
+    }
+
+    loan->cleanup_attempted = true;
+    loan->cleanup_invoking = true;
+    status = owner->pager.candidate_cleanup(owner->pager.installer.plugin_id,
+                                            loan, loan->provider_owner,
+                                            owner->pager.userdata);
+    /* The module entry and return occur outside native actor locks and every
+     * reader/observer invocation. Its registered body must enter outside its
+     * own State/Slot guards and use only identity observation and finish(0).
+     */
+    loan->cleanup_returned = true;
+    post = qemu_crucible_checkpoint_candidate_read_identity_v1(loan, false);
+    /* These two fields describe the latest actual return. The separate first
+     * journals and transaction causes survive later successful physical return.
+     */
+    loan->cleanup_callback_status = status;
+    loan->cleanup_identity_post_status = post;
+    loan->cleanup_invoking = false;
+    if (status) {
+        int refusal = status < 0 ? status : -EPROTO;
+
+        if (!loan->cleanup_first_status) {
+            loan->cleanup_first_status = refusal;
+        }
+        checkpoint_fail(owner, refusal, false);
+    }
+    if (post) {
+        if (!loan->cleanup_first_post_status) {
+            loan->cleanup_first_post_status = post;
+        }
+        checkpoint_fail(owner, post, true);
+    }
+    if (status || post) {
+        return status ? (status < 0 ? status : -EPROTO) : post;
+    }
+    if (loan->writer_capture ||
+        qemu_crucible_checkpoint_candidate_capture_busy_v1(loan)) {
+        if (!loan->cleanup_first_status) {
+            loan->cleanup_first_status = -EBUSY;
+        }
+        checkpoint_fail(owner, -EBUSY, false);
+        return -EBUSY;
+    }
+
+    /* Actual callback0 plus identity post0 and physical claim closure returns
+     * this embedded loan. This is no Original observation or publication; the
+     * signed semantic journal and deferred dirty obligations remain unchanged.
+     */
+    qemu_crucible_checkpoint_candidate_capture_reader_return_v1(loan);
+    loan->cleanup_complete = true;
+    loan->active = false;
+    return 0;
+}
+
+static bool checkpoint_root_end_complete(QemuCrucibleCheckpointHeldTransaction *owner)
+{
+    struct QemuCrucibleCheckpointProofHold *hold = &owner->proof;
+
+    return hold->retained && hold->returned && hold->root_retired &&
+        hold->native_retired && hold->root_acknowledged &&
+        hold->producer_admission_open && !hold->producer_borrowers &&
+        !owner->producer_loan.active && !hold->borrowers &&
+        !owner->proof_borrow.active && !owner->inventory.active && !owner->inventory.metadata_borrow &&
+        !owner->inventory.output.held && !owner->inventory.output.close_uncertain &&
+        !owner->inventory.cancellation.held && !owner->inventory.cancellation.close_uncertain && !owner->invocation.active &&
+        !owner->invocation.readers && !checkpoint_read.active &&
+        !owner->candidate_read.active &&
+        !owner->invoking && !owner->cleanup_invoking;
+}
+
+static int checkpoint_close_event(QemuCrucibleCheckpointHeldTransaction *owner)
+{
+    int descriptor;
+
+    if (owner->metadata_close_uncertain || owner->metadata_fd >= 0 ||
+        owner->event_close_uncertain) {
+        return -EINPROGRESS;
+    }
+    if (owner->event_close_attempted) {
+        return owner->cancellation_fd == -1 ? 0 : -EINPROGRESS;
+    }
+    if (owner->cancellation_fd < 0) {
+        return -EPERM;
+    }
+    descriptor = owner->cancellation_fd;
+    owner->event_close_attempted = true;
+    owner->cancellation_fd = -1;
+    if (close(descriptor) < 0) {
+        /* The numeric descriptor was consumed once; never retry its number.
+         * Physical custody is quarantined until genuine process containment.
+         */
+        owner->event_close_uncertain = true;
+        return -errno;
+    }
+    return 0;
+}
+
+static int checkpoint_finalize_main(QemuCrucibleCheckpointHeldTransaction *owner)
+{
+    QemuCrucibleCheckpointRequestLoan *request = owner->request;
+    struct qemu_plugin_crucible_checkpoint_pager_status ignored;
+    bool no_root;
+    uint64_t slice;
+    int status = checkpoint_identity(owner);
+
+    if (status) {
+        return status;
+    }
+    if ((!(owner->candidate_ended && owner->candidate_io_ended) &&
+         !request->noncandidate_end_published) ||
+        request->snapshot_birth_pending ||
+        (request->snapshot_issued && (!request->snapshot_io_returned ||
+         !request->snapshot_body_cleaned || !request->snapshot_dismissed)) ||
+        owner->candidate_alias_uncertain || owner->capture_alias_active ||
+        owner->inventory.active || owner->inventory.metadata_borrow ||
+        owner->inventory.output.held || owner->inventory.output.close_uncertain ||
+        owner->inventory.cancellation.held || owner->inventory.cancellation.close_uncertain || owner->candidate_read.active) {
+        return -EINPROGRESS;
+    }
+    status = qemu_crucible_checkpoint_main_loop_current();
+    if (status) {
+        /* Running invalidation records real candidate end but has no cleanup
+         * cut. A later genuine stop receipt retries under paused Main/BQL.
+         */
+        qatomic_store_release(&request->terminal_state,
+                             QEMU_CRUCIBLE_CHECKPOINT_TERMINAL_UNCERTAIN);
+        return status;
+    }
+    if (owner->invoking || owner->cleanup_invoking || owner->inventory.active || owner->inventory.metadata_borrow ||
+        owner->inventory.output.held || owner->inventory.output.close_uncertain ||
+        owner->inventory.cancellation.held || owner->inventory.cancellation.close_uncertain ||
+        owner->invocation.active ||
+        request->provider_invoking || owner->finalize_invoking) {
+        return -EBUSY;
+    }
+    no_root = !owner->prepare_called && !owner->proof.retained &&
+        !owner->mailbox_detached && !owner->pager_held &&
+        !owner->candidate_collector_token;
+    if (owner->candidate_collector_token && !owner->prepare_called &&
+        !owner->proof.retained) {
+        /* physical_begin can fail after issuing this live collector. No Root
+         * adopted it; only its genuine native return can establish no effects.
+         * That producer is absent here. Retain every holder without callbacks.
+         */
+        qatomic_store_release(&request->terminal_state,
+                             QEMU_CRUCIBLE_CHECKPOINT_TERMINAL_UNCERTAIN);
+        return -EINPROGRESS;
+    }
+    if (!no_root && !owner->release_callback_returned) {
+        if (owner->release_started) {
+            return -EINPROGRESS;
+        }
+        qemu_crucible_checkpoint_invoke_v1(
+            owner, QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PAGER_RELEASE,
+            owner->candidate_disposition, &ignored);
+    }
+    if (!no_root && (!owner->release_callback_returned || owner->invoking ||
+                     owner->cleanup_invoking || owner->inventory.active || owner->inventory.metadata_borrow ||
+        owner->inventory.output.held || owner->inventory.output.close_uncertain ||
+        owner->inventory.cancellation.held || owner->inventory.cancellation.close_uncertain ||
+                     owner->invocation.active)) {
+        return -EINPROGRESS;
+    }
+    if (!request->provider_acquired || !request->provider_owner ||
+        !request->pager.provider_end || !request->pager.finalize) {
+        return -ENOKEY;
+    }
+    if (!owner->module_finalize_complete) {
+        owner->finalize_invoking = true;
+        request->provider_invoking = true;
+        status = request->pager.finalize(request->pager.installer.plugin_id,
+                                        request, request->provider_owner,
+                                        request->pager.userdata);
+        request->provider_invoking = false;
+        owner->finalize_invoking = false;
+        /* This return is the separate callback boundary: its State/Slot
+         * guards and local tails are gone before native checks or provider_end.
+         * A semantic first failure cannot suppress factual ACK/end observation.
+         */
+        if (status == -EINPROGRESS) {
+            return status;
+        }
+        if (status) {
+            checkpoint_fail(owner, status < 0 ? status : -EPROTO, false);
+            return status < 0 ? status : -EPROTO;
+        }
+        owner->module_finalize_complete = true;
+    }
+    if (!no_root && !checkpoint_root_end_complete(owner)) {
+        return -EINPROGRESS;
+    }
+    if (!request->provider_acquired || !request->provider_owner ||
+        !request->pager.provider_end || !request->pager.finalize) {
+        return -ENOKEY;
+    }
+    if (!request->provider_ended) {
+        if (request->provider_end_attempted) {
+            return -EINPROGRESS;
+        }
+        request->provider_end_attempted = true;
+        request->provider_invoking = true;
+        status = request->pager.provider_end(request->pager.installer.plugin_id,
+                                            request, request->provider_owner,
+                                            request->pager.userdata);
+        request->provider_invoking = false;
+        if (status) {
+            checkpoint_fail(owner, status < 0 ? status : -EPROTO, true);
+            qatomic_store_release(&request->terminal_state,
+                                 QEMU_CRUCIBLE_CHECKPOINT_TERMINAL_UNCERTAIN);
+            return status < 0 ? status : -EPROTO;
+        }
+        request->provider_ended = true;
+    }
+    if (!owner->terminal_post_observed) {
+        /* This semantic post includes module local-tail and provider return,
+         * and still observes the real event alias before its sole close.
+         * Subsequent physical custody returns preserve that signed result.
+         */
+        checkpoint_live(owner, &slice, true);
+        owner->terminal_post_observed = true;
+    }
+    status = checkpoint_close_event(owner);
+    if (status) {
+        checkpoint_fail(owner, status, true);
+        qatomic_store_release(&request->terminal_state,
+                             QEMU_CRUCIBLE_CHECKPOINT_TERMINAL_UNCERTAIN);
+        return status;
+    }
+    /* Signed post remains independent. Retired permits semantic first<0 but
+     * never a failed post, unfinished root/provider, or uncertain alias close.
+     */
+    if (!request->receipt_returned) {
+        status = qemu_plugin_crucible_ram_actor_request_receipt_return(
+            request, request->actor, request->actor_pause);
+        if (status) {
+            checkpoint_fail(owner, status, true);
+            qatomic_store_release(&request->terminal_state,
+                                 QEMU_CRUCIBLE_CHECKPOINT_TERMINAL_UNCERTAIN);
+            return status;
+        }
+        request->receipt_returned = true;
+    }
+    if (!request->actor_pause_ended) {
+        QemuRamPauseEndDisposition end = { 0 };
+
+        status = qemu_plugin_crucible_ram_actor_request_pause_end_v2(
+            request, request->actor, request->actor_pause, &end);
+        if (end.entered) {
+            request->actor_pause_end = end;
+        }
+        if (!status && !end.complete) {
+            status = -EPROTO;
+        }
+        if (end.complete) {
+            request->actor_pause_ended = true;
+        }
+        if (status) {
+            checkpoint_fail(owner, status, true);
+            qatomic_store_release(&request->terminal_state,
+                                 QEMU_CRUCIBLE_CHECKPOINT_TERMINAL_UNCERTAIN);
+            return status;
+        }
+    }
+    /* Return only the checkpoint borrow. The ordinary paused transition,
+     * template/block continuations and independent resume authority survive.
+     */
+    if (checkpoint_stop_owner.transaction == owner) {
+        checkpoint_stop_owner.transaction = NULL;
+    }
+    if (qatomic_read(&owner->post_status)) {
+        qatomic_store_release(&request->terminal_state,
+                             QEMU_CRUCIBLE_CHECKPOINT_TERMINAL_UNCERTAIN);
+        return qatomic_read(&owner->post_status);
+    }
+    qatomic_store_release(&request->terminal_state,
+                         no_root ? QEMU_CRUCIBLE_CHECKPOINT_TERMINAL_NO_ROOT :
+                                   QEMU_CRUCIBLE_CHECKPOINT_TERMINAL_RETIRED);
+    return 0;
+}
