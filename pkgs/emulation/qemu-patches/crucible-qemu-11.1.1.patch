+static ICH9PMTimerClock *ich9_aux_clock(ICH9LPCPMRegs *pm, unsigned index)
+{
+    switch (index) {
+    case 0:
+        return &pm->tco_regs.wide_timer;
+    case 1:
+        return &pm->swsmi_wide_timer;
+    default:
+        assert(index == 2);
