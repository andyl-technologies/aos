+int qemu_plugin_crucible_installed_wake_watcher_borrow_v1(
+    QemuCrucibleFingerprintWakeWatcher **out, int *fd,
+    uint64_t *registration_serial, QemuCrucibleFingerprintWakeKeeper **keeper)
+{
+    QemuCrucibleFingerprintWakeWatcher *watcher = &fingerprint_wake_watcher;
+    int status;
+
+    if (!out || !fd || !registration_serial || !keeper) {
+        return -EINVAL;
+    }
+    *out = NULL;
+    *keeper = NULL;
+    if (!watcher->held) {
+        return -ENOENT;
+    }
+    status = qemu_plugin_crucible_wake_watcher_current_v1(watcher, watcher->fd);
+    if (!status) {
+        status = qemu_crucible_startup_source_watcher_current_v1(
+            watcher->keeper, watcher);
+    }
+    if (status) {
+        return status;
+    }
+    /* This is a retained registration projection, not an entered handler,
+     * poll result, new descriptor loan or permission to construct an Original. */
+    *out = watcher;
+    *fd = watcher->fd;
+    *registration_serial = watcher->registration_serial;
+    *keeper = watcher->keeper;
+    return 0;
+}
