+    if (loan == &ordinary_fingerprint && loan->phase == 4 &&
+        !fingerprint_root_frame.active && loan->invoking && loan->attempted &&
+        loan->operation_borrowed && loan->regions == admission_regions &&
+        loan->process == getpid() && qemu_thread_is_self(&loan->thread) &&
+        qemu_in_main_thread() && !current_cpu && bql_locked() && !qemu_in_coroutine() &&
+        fingerprint_root_operation && fingerprint_root_outcome.original_recorded &&
+        !logical_capture->source_claim && !logical_capture->progress.borrowed &&
+        !logical_capture->progress.published && operation && !*operation && phase) {
+        status = qemu_crucible_startup_source_fingerprint_context_identity_v1(id);
+        if (!status) {
+            *operation = fingerprint_root_operation;
+            *phase = 4;
+        }
+        return status;
+    }
+    status = qemu_crucible_ram_fingerprint_root_invocation_current_v1(id);
+    if (status || !operation || *operation || !phase || loan != &ordinary_fingerprint ||
+        !loan->invoking || loan->process != getpid() ||
+        !qemu_thread_is_self(&loan->thread) || loan->regions != admission_regions ||
+        !fingerprint_root_operation || !fingerprint_root_outcome.entry_returned ||
+        fingerprint_root_outcome.entry_status || current_cpu || !qemu_in_main_thread() ||
+        fingerprint_root_outcome.module_invoking || loan->phase < 1 || loan->phase > 4) {
+        return status ? status : -EPERM;
+    }
+    if (loan->phase == 1 && (fingerprint_root_outcome.callback_returned ||
+                            fingerprint_root_outcome.post_recorded)) {
+        return -EPERM;
+    }
+    if ((loan->phase == 2 || loan->phase == 3) &&
+        !(fingerprint_root_outcome.callback_returned ||
+          (fingerprint_root_outcome.preobserver_returned &&
+           fingerprint_root_outcome.preobserver_status))) {
+        return -EPERM;
+    }
+    if ((loan->phase == 2 && fingerprint_root_outcome.post_recorded) ||
+        (loan->phase == 3 && !fingerprint_root_outcome.post_recorded)) {
+        return -EPERM;
