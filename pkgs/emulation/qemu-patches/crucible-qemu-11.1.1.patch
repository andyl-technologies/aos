+int qemu_crucible_preexec_peer_observe_v3(
+    QemuCruciblePreexecPurposeOwner *held,
+    QemuCruciblePreexecPeerObservation *out)
+{
+    QemuCruciblePreexecSetupOwner *owner = &preexec_setup_owner;
+    struct stat control;
+    struct {
+        int process;
+        uint32_t user;
+        uint32_t group;
+    } peer;
+    socklen_t length = sizeof(peer);
+    long process = preexec_setup_syscall5(SYS_getpid, 0, 0, 0, 0, 0);
+    long status;
+
+    if (held != owner || process != owner->process_id || !out) {
+        return -EPERM;
+    }
+    if (!owner->source_published || !owner->peer_validated ||
+        !owner->plan_validated || !owner->limits_corroborated ||
+        !owner->cgroup_corroborated || !owner->family_corroborated ||
+        !owner->identity_corroborated || !owner->artifact_verified ||
+        owner->close_status) {
+        return -ENOKEY;
+    }
+    status = preexec_setup_syscall5(SYS_fstat, QEMU_CRUCIBLE_PREEXEC_SETUP_CONTROL_FD,
+        (long)(uintptr_t)&control, 0, 0, 0);
+    if (status < 0) {
+        return (int)status;
+    }
+    if (!S_ISSOCK(control.st_mode) ||
+        control.st_dev != owner->control_identity.st_dev ||
+        control.st_ino != owner->control_identity.st_ino) {
+        return -ESTALE;
+    }
+    status = preexec_setup_syscall5(SYS_getsockopt,
+        QEMU_CRUCIBLE_PREEXEC_SETUP_CONTROL_FD, SOL_SOCKET, SO_PEERCRED,
+        (long)(uintptr_t)&peer, (long)(uintptr_t)&length);
+    if (status < 0) {
+        return (int)status;
+    }
+    if (length != sizeof(peer) || peer.process != owner->peer_process ||
+        peer.user != owner->peer_user || peer.group != owner->peer_group ||
+        preexec_setup_syscall5(SYS_getppid, 0, 0, 0, 0, 0) != peer.process) {
+        return -ESTALE;
+    }
+    *out = (QemuCruciblePreexecPeerObservation) {
+        .process_id = peer.process,
+        .user_id = peer.user,
+        .group_id = peer.group,
+    };
+    return 0;
+}
