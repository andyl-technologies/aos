+/* Only interrupt consumers are diagnostic; timer and softint paths are real. */
+void cpu_check_irqs(CPUSPARCState *env)
+{
+    irq_checks++;
+}
+
+void qemu_cpu_kick(CPUState *cpu)
+{
+    kicks++;
+}
+
+static __int128 observed_clock_ps(void)
+{
+    return observed_ps;
+}
+
+static void timer_callback(void *opaque)
+{
+    callbacks++;
+}
+
+static void initialize_clock(bool exact)
+{
+    Error *error = NULL;
+
+    const TypeInfo diagnostic_cpu = {
+        .name = TYPE_CPU,
+        .parent = TYPE_OBJECT,
+        .instance_size = sizeof(CPUState),
+        .class_size = sizeof(CPUClass),
+    };
+
+    module_call_init(MODULE_INIT_QOM);
+    type_register_static(&diagnostic_cpu);
+    qemu_init_main_loop(&error);
+    g_assert_null(error);
+    if (exact) {
+        qemu_timer_enable_tcg_ps_clock(NULL, observed_clock_ps);
+    }
+    qemu_clock_enable(QEMU_CLOCK_VIRTUAL, true);
+}
+
+static CPUTimer *create_timer(void)
+{
+    return cpu_timer_create("diagnostic", NULL, timer_callback,
+                             100000000, 1ULL << 63, 1ULL << 63);
+}
+
+static void destroy_timer(CPUTimer *timer)
+{
+    timer_free(timer->qtimer);
+    g_free(timer);
+}
+
+static GByteArray *save_state(const VMStateDescription *description,
+                             void *state)
+{
+    QIOChannelBuffer *output = qio_channel_buffer_new(4096);
+    QEMUFile *file = qemu_file_new_output(QIO_CHANNEL(output));
+    GByteArray *bytes = g_byte_array_new();
+    Error *error = NULL;
+
+    g_assert_cmpint(vmstate_save_state(file, description, state, NULL,
+                                      &error), ==, 0);
+    g_assert_null(error);
+    qemu_put_byte(file, QEMU_VM_EOF);
+    g_assert_cmpint(qemu_fflush(file), ==, 0);
+    g_byte_array_append(bytes, output->data, output->usage);
+    g_assert_cmpint(qemu_fclose(file), ==, 0);
+    object_unref(OBJECT(output));
+    return bytes;
+}
+
+static int load_state(const VMStateDescription *description, void *state,
+                      GByteArray *bytes)
+{
+    QIOChannelBuffer *input = qio_channel_buffer_new(bytes->len);
+    QEMUFile *file;
+    int status;
+
+    memcpy(input->data, bytes->data, bytes->len);
+    input->usage = bytes->len;
+    file = qemu_file_new_input(QIO_CHANNEL(input));
+    status = vmstate_load_state(file, description, state,
+                                description->version_id, NULL);
+    qemu_fclose(file);
+    object_unref(OBJECT(input));
+    return status;
+}
+
+static size_t subsection_payload(const GByteArray *bytes, const char *name)
+{
+    size_t length = strlen(name);
+
+    for (size_t position = 2; position + length + 4 < bytes->len; position++) {
+        if (bytes->data[position - 2] == QEMU_VM_SUBSECTION &&
+            bytes->data[position - 1] == length &&
+            !memcmp(bytes->data + position, name, length)) {
+            return position + length + 4;
+        }
+    }
+    g_assert_not_reached();
+}
+
+static void remove_subsection(GByteArray *bytes, const char *name)
+{
+    size_t start = subsection_payload(bytes, name) - strlen(name) - 6;
+
+    g_byte_array_set_size(bytes, start);
+    g_byte_array_append(bytes, (const uint8_t[]) { QEMU_VM_EOF }, 1);
+}
+
+static void duplicate_subsection(GByteArray *bytes, const char *name)
+{
+    size_t start = subsection_payload(bytes, name) - strlen(name) - 6;
+    size_t length = bytes->len - start - 1;
+    uint8_t *copy = g_memdup2(bytes->data + start, length);
+
+    g_byte_array_set_size(bytes, bytes->len - 1);
+    g_byte_array_append(bytes, copy, length);
+    g_byte_array_append(bytes, (const uint8_t[]) { QEMU_VM_EOF }, 1);
+    g_free(copy);
+}
+
+static void test_origin(gconstpointer data)
+{
+    unsigned kind = GPOINTER_TO_UINT(data);
+    CPUTimer *timer;
+    __int128 origin;
+    __int128 deadline;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+    initialize_clock(true);
+    origin = kind == 0 ? ((__int128)INT64_MAX + 1) * 1000 + 357 :
+             kind == 1 ? ((__int128)1 << 120) + 357 :
+             kind == 2 ? -((__int128)1 << 120) + 357 :
+             kind == 3 ? (__int128)(((__uint128_t)-1) >> 1) - 100000 :
+                         -(__int128)(((__uint128_t)-1) >> 1) + 100000;
+    observed_ps = origin;
+    timer = create_timer();
+    g_assert_true(cpu_timer_clock_offset_ps(timer) == origin);
+    cpu_timer_reset(timer);
+    g_assert_true(cpu_timer_clock_offset_ps(timer) == origin);
+    cpu_tick_set_count(timer, 3);
+    g_assert_cmpuint(cpu_tick_get_count(timer), ==, 3);
+    cpu_tick_set_limit(timer, 7);
+    deadline = origin + 40000;
+    g_assert_true(timer_expire_time_ps_wide(timer->qtimer) == deadline);
+    observed_ps = deadline - 1;
+    qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL);
+    g_assert_cmpuint(callbacks, ==, 0);
+    observed_ps++;
+    qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL);
+    g_assert_cmpuint(callbacks, ==, 1);
+    g_assert_false(timer_pending(timer->qtimer));
+    destroy_timer(timer);
+}
+
+static void test_elapsed(gconstpointer data)
+{
+    unsigned kind = GPOINTER_TO_UINT(data);
+    CPUTimer *timer;
+    __int128 half_span = (__int128)1 << 126;
+    uint64_t expected;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+    initialize_clock(true);
+    observed_ps = 0;
+    timer = create_timer();
+    cpu_tick_set_count(timer, 0);
+    if (kind < 2) {
+        observed_ps = kind ? -half_span : half_span;
+        expected = (uint64_t)((__uint128_t)half_span / 10000);
+        if (kind) {
+            expected = 0 - expected;
+        }
+    } else if (kind == 2) {
+        cpu_timer_set_clock_offset_ps(timer, -half_span - 1);
+        observed_ps = half_span;
+        expected = (uint64_t)((((__uint128_t)1 << 127) + 1) / 10000);
+    } else {
+        observed_ps = ((__int128)UINT64_MAX + 2) * 10000;
+        expected = 1;
+    }
+    g_assert_cmpuint(cpu_tick_get_count(timer), ==, expected);
+    timer->frequency = UINT32_MAX;
+    observed_ps = 999999999999;
+    cpu_timer_set_clock_offset_ps(timer, 0);
+    g_assert_cmpuint(cpu_tick_get_count(timer), ==,
+                    ((__uint128_t)999999999999 * UINT32_MAX) / 1000000000000ULL);
+    destroy_timer(timer);
+}
+
+static void test_migration(gconstpointer data)
+{
+    unsigned kind = GPOINTER_TO_UINT(data);
+    CPUTimer *timer;
+    CPUTimer *restored;
+    GByteArray *bytes;
+    __int128 origin;
+    __int128 deadline;
+    bool exact = kind != 3;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+    initialize_clock(exact);
+    origin = kind == 0 ? ((__int128)1 << 120) + 357 :
+             kind == 1 ? -((__int128)1 << 120) + 357 :
+             kind == 4 ? -10001 : 100000;
+    observed_ps = origin;
+    timer = create_timer();
+    restored = create_timer();
+    cpu_tick_set_count(timer, kind == 4 ? 0 : 3);
+    if (kind != 2) {
+        cpu_tick_set_limit(timer, kind == 4 ? 1 : 7);
+    }
+    deadline = kind == 4 ? -1 : origin + 40000;
+    bytes = save_state(&vmstate_cpu_timer, timer);
+    g_assert_cmpint(load_state(&vmstate_cpu_timer, restored, bytes), ==, 0);
+    g_assert_cmpuint(timer_pending(restored->qtimer), ==, kind != 2);
+    if (exact) {
+        g_assert_true(cpu_timer_clock_offset_ps(restored) == origin - (kind == 4 ? 0 : 30000));
+        if (kind != 2) {
+            g_assert_true(timer_expire_time_ps_wide(restored->qtimer) == deadline);
+        }
+    } else {
+        g_assert_cmpint(restored->clock_offset, ==, 70);
+        g_assert_cmpint(timer_expire_time_ns(restored->qtimer), ==, 140);
+    }
+    timer_del(timer->qtimer);
+    if (kind != 2) {
+        observed_ps = deadline;
+        qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL);
+        g_assert_cmpuint(callbacks, ==, 1);
+    }
+    g_byte_array_unref(bytes);
+    destroy_timer(timer);
+    destroy_timer(restored);
+}
