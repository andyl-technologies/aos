+int qemu_plugin_crucible_checkpoint_pending_adopt_v1(
+    qemu_plugin_id_t id, qemu_plugin_crucible_ram_control_actor_v1 *actor,
+    qemu_plugin_crucible_ram_control_receive_v1 *receipt,
+    const uint8_t original[80], const uint8_t digest[32],
+    uint64_t *request_generation)
+{
+    int status = qemu_crucible_ram_control_actor_current(actor, id);
+
+    if (status) {
+        return status;
+    }
+    pthread_mutex_lock(&actor->dispatch_mutex);
+    /* Only the existing bounded native receipt transfer runs here. Provider
+     * callbacks and request acquisition remain outside this mutex. */
+    status = ram_control_pending_adopt_locked(id, actor, receipt, original,
+                                              digest, request_generation);
+    pthread_mutex_unlock(&actor->dispatch_mutex);
+    return status;
+}
+
+int qemu_plugin_crucible_ram_control_receive_dispose_v1(
+    qemu_plugin_id_t id, qemu_plugin_crucible_ram_control_actor_v1 *actor,
+    qemu_plugin_crucible_ram_control_receive_v1 *receipt, int status)
+{
+    int result = qemu_crucible_ram_control_actor_current(actor, id);
+
+    if (result) {
+        return result;
+    }
+    if (status > 0) {
+        return -EINVAL;
+    }
+    result = ram_control_record_end(actor, id, receipt, false);
+    if (result) {
+        return result;
+    }
+    result = pthread_mutex_lock(&actor->dispatch_mutex);
+    if (result) {
+        return ram_control_failure(actor, -result, true);
+    }
+    result = ram_control_receive_dispose_locked(id, actor, receipt, status);
+    if (!result) {
+        receipt->record.physical_bank_returned = true;
+    }
+    result = ram_control_record_unlock(actor, result);
+    if (!result) {
+        result = ram_control_record_release(actor);
+    }
+    return result ? result : qatomic_read(&actor->first_status);
+}
