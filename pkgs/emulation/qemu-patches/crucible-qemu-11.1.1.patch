+static QemuCrucibleObservationWriterFence observation_writer;
+static unsigned observation_writer_cut;
+
+struct QemuCrucibleObservationRootExecutionWitness {
+    QemuThreadRamCpuExecutionWitness execution;
+    QemuCrucibleFingerprintRootFrame *frame;
+    uint64_t source_id;
