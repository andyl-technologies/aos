+static void test_qmp_child_reinitializer_is_exact_and_one_shot(void)
+{
+    QemuCrucibleHotForkQmpChildResourcePlan resources = { 0 };
+    QemuCrucibleHotForkQmpChildReinitializer reinitializer = { 0 };
+    QemuCrucibleHotForkQmpChildReinitializer contradictory = { 0 };
+    QemuCrucibleHotForkQmpChildReinitializer failed = { 0 };
+    FakeQmpChildRuntime runtime = {
+        .flags = QEMU_CRUCIBLE_HOT_FORK_QMP_CHILD_FLAGS_COMPLETE,
+    };
+    FakeQmpChildRuntime contradictory_runtime = {
+        .flags = QEMU_CRUCIBLE_HOT_FORK_QMP_CHILD_FLAGS_COMPLETE &
+            ~QEMU_CRUCIBLE_HOT_FORK_QMP_CHILD_FLAG_INPUT_HELD,
+    };
+    FakeQmpChildRuntime failed_runtime = {
+        .result = -EIO,
+        .flags = QEMU_CRUCIBLE_HOT_FORK_QMP_CHILD_FLAGS_COMPLETE,
+    };
+
+    g_assert_cmpint(qemu_crucible_hot_fork_prepare_qmp_child_resources(
+                        &resources, 41, 73, 11, 13, 17),
+                    ==, 0);
+    g_assert_cmpint(qemu_crucible_hot_fork_prepare_qmp_child_reinitializer(
+                        &reinitializer, &resources, NULL, NULL),
+                    ==, -EINVAL);
+    g_assert_cmpint(qemu_crucible_hot_fork_prepare_qmp_child_reinitializer(
+                        &reinitializer, &resources, reinitialize_qmp_child,
+                        &runtime),
+                    ==, 0);
+    g_assert_true(
+        qemu_crucible_hot_fork_qmp_child_reinitializer_prepared_for(
+            &reinitializer, &resources, reinitialize_qmp_child, &runtime));
+    g_assert_false(
+        qemu_crucible_hot_fork_qmp_child_reinitializer_prepared_for(
+            &reinitializer, &resources, reinitialize_qmp_child,
+            &contradictory_runtime));
+    g_assert_false(
+        qemu_crucible_hot_fork_qmp_child_reinitializer_prepared_for(
+            &reinitializer, &resources, reinitialize_alternate_qmp_child,
+            &runtime));
+    g_assert_false(
+        qemu_crucible_hot_fork_qmp_child_reinitializer_complete(
+            &reinitializer));
+    resources.qmp_generation++;
+    g_assert_false(qemu_crucible_hot_fork_qmp_child_reinitializer_prepared_for(
+        &reinitializer, &resources, reinitialize_qmp_child, &runtime));
+    resources.qmp_generation--;
+    resources.monitor_generation++;
+    g_assert_false(qemu_crucible_hot_fork_qmp_child_reinitializer_prepared_for(
+        &reinitializer, &resources, reinitialize_qmp_child, &runtime));
+    resources.monitor_generation--;
+    g_assert_cmpint(qemu_crucible_hot_fork_reinitialize_qmp_child(
+                        &reinitializer),
+                    ==, 0);
+    g_assert_cmpuint(runtime.calls, ==, 1);
+    g_assert_true(reinitializer.attempted);
+    g_assert_true(reinitializer.initialized);
+    g_assert_true(
+        qemu_crucible_hot_fork_qmp_child_reinitializer_complete(
+            &reinitializer));
+    g_assert_true(
+        qemu_crucible_hot_fork_qmp_child_reinitializer_bound_for(
+            &reinitializer, &resources, reinitialize_qmp_child, &runtime));
+    g_assert_false(
+        qemu_crucible_hot_fork_qmp_child_reinitializer_prepared_for(
+            &reinitializer, &resources, reinitialize_qmp_child, &runtime));
+    g_assert_cmpint(qemu_crucible_hot_fork_reinitialize_qmp_child(
+                        &reinitializer),
+                    ==, -EPERM);
+    g_assert_cmpuint(runtime.calls, ==, 1);
+
+    g_assert_cmpint(qemu_crucible_hot_fork_prepare_qmp_child_reinitializer(
+                        &contradictory, &resources, reinitialize_qmp_child,
+                        &contradictory_runtime),
+                    ==, 0);
+    g_assert_cmpint(qemu_crucible_hot_fork_reinitialize_qmp_child(
+                        &contradictory),
+                    ==, -EPROTO);
+    g_assert_true(contradictory.attempted);
+    g_assert_false(contradictory.initialized);
+    g_assert_false(
+        qemu_crucible_hot_fork_qmp_child_reinitializer_complete(
+            &contradictory));
+
+    g_assert_cmpint(qemu_crucible_hot_fork_prepare_qmp_child_reinitializer(
+                        &failed, &resources, reinitialize_qmp_child,
+                        &failed_runtime),
+                    ==, 0);
+    g_assert_cmpint(qemu_crucible_hot_fork_reinitialize_qmp_child(
+                        &failed),
+                    ==, -EIO);
+    g_assert_true(failed.attempted);
+    g_assert_false(failed.initialized);
+    g_assert_false(
+        qemu_crucible_hot_fork_qmp_child_reinitializer_complete(&failed));
+    qemu_crucible_hot_fork_reset_qmp_child_reinitializer(&failed);
+    g_assert_false(failed.prepared);
+    g_assert_false(failed.attempted);
+    g_assert_false(
+        qemu_crucible_hot_fork_qmp_child_reinitializer_complete(&failed));
+}
