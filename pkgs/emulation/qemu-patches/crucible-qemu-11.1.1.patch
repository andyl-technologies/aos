+            status = !receipt->free_in_flight &&
+                (receipt->allocation_abandoned || receipt->physical_returned) ?
+                0 : -EBUSY;
+            break;
+        }
+    }
+    pthread_mutex_unlock(&native_allocations.lock);
+    return status;
+}
+
+int object_native_allocation_receipt_identity_return(
+    QemuCrucibleCpuAllocationReceipt **owner)
+{
+    QemuCrucibleCpuAllocationReceipt **link;
+    QemuCrucibleCpuAllocationReceipt *receipt;
+    int status = -ESTALE;
+
+    if (!owner || !(receipt = *owner)) {
+        return -EINVAL;
+    }
+    pthread_mutex_lock(&native_allocations.lock);
+    for (link = &native_allocations.receipts; *link; link = &(*link)->next) {
+        if (*link == receipt && receipt->active && receipt->process == getpid()) {
+            status = !receipt->free_in_flight &&
+                (receipt->allocation_abandoned || receipt->physical_returned) ?
+                0 : -EBUSY;
+            if (!status) {
+                *link = receipt->next;
+                receipt->active = false;
+                *owner = NULL;
+            }
+            break;
+        }
+    }
+    pthread_mutex_unlock(&native_allocations.lock);
+    return status;
+}
+
+static void object_native_paid_g_free(void *payload);
+
+/* A target TLB constructor borrows its actual CPU-thread receipt before RR
+ * can share or return that temporary storage. The opaque pending identity is
+ * registered under the already-paid construction registry; no byte count or
+ * CPU address can create this relation. */
+int object_native_cpu_tlb_request_begin(
+    Object *parent, void *thread_payload, void (*thread_free)(void *),
+    QemuCrucibleCpuTlbStorageRequest **out)
+{
+    QemuCrucibleCpuAllocationReceipt *receipt;
+    int status;
+
+    if (!out || *out || !parent || !thread_payload) {
+        return -EINVAL;
+    }
+    if (!object_native_allocation_selected()) {
+        return -ENOENT;
+    }
+    pthread_mutex_lock(&native_allocations.lock);
+    status = object_native_observer_identity_locked();
+    if (!status && (native_allocation_scope != &native_allocations.observer ||
+                   native_allocations.tlb_request_held ||
+                   native_allocations.request.phase != OBJECT_NATIVE_ALLOCATION_IDLE)) {
+        status = -EBUSY;
+    }
+    if (!status && native_allocations.generation == UINT64_MAX) {
+        status = -EOVERFLOW;
+    }
+    if (!status) {
+        status = -ESTALE;
+        for (receipt = native_allocations.receipts; receipt;
+             receipt = receipt->next) {
+            if (receipt->parent == parent && receipt->type == parent->class->type &&
+                receipt->kind == OBJECT_NATIVE_ALLOCATION_CPU_THREAD &&
+                receipt->payload == thread_payload && receipt->free == g_free &&
+                thread_free == object_native_paid_g_free && receipt->active &&
+                receipt->process == getpid() && receipt->allocation_started &&
+                !receipt->allocation_abandoned && !receipt->physical_returned &&
+                !receipt->free_in_flight) {
+                native_allocations.tlb_request = (QemuCrucibleCpuTlbStorageRequest) {
+                    .parent = parent,
+                };
+                native_allocations.tlb_request_held = true;
+                native_allocations.tlb_parent = receipt;
+                native_allocations.tlb_serial = ++native_allocations.generation;
+                *out = &native_allocations.tlb_request;
+                status = 0;
+                break;
+            }
+        }
+    }
+    pthread_mutex_unlock(&native_allocations.lock);
+    return status;
+}
+
+int object_native_cpu_tlb_request_current(
+    QemuCrucibleCpuTlbStorageRequest *request,
+    const ObjectNativeAllocationOps *ops, void **userdata,
+    QemuCrucibleCpuSourceAllocationOwner **parent_owner, uint64_t *serial)
+{
+    QemuCrucibleCpuAllocationReceipt *parent;
+    int status;
+
+    if (!userdata || *userdata || !parent_owner || *parent_owner || !serial) {
+        return -EINVAL;
+    }
+    pthread_mutex_lock(&native_allocations.lock);
+    status = object_native_observer_identity_locked();
+    parent = native_allocations.tlb_parent;
+    if (!status && (request != &native_allocations.tlb_request ||
+                   !native_allocations.tlb_request_held ||
+                   native_allocations.observer.ops != ops || !parent ||
+                   !parent->active || parent->process != getpid() ||
+                   parent->kind != OBJECT_NATIVE_ALLOCATION_CPU_THREAD ||
+                   !parent->allocation_started || parent->allocation_abandoned ||
+                   parent->physical_returned || parent->free_in_flight ||
+                   !native_allocations.tlb_serial)) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        *userdata = native_allocations.observer.userdata;
+        *parent_owner = parent->source_owner;
+        *serial = native_allocations.tlb_serial;
