+    if (!mon->parent_obj.crucible_purpose) {
+        g_queue_push_tail(mon->qmp_requests, request);
+        return;
+    }
+    tail = mon->crucible_request_tail;
+    request->queue_next = NULL;
+    if (tail) {
+        tail->queue_next = request;
+    } else {
+        mon->crucible_request_head = request;
+    }
+    mon->crucible_request_tail = request;
+    mon->crucible_request_count++;
