+        ct3d->media_op_sanitize = g_malloc0(sizeof(CXLSanitizeInfo) +
+                                            ranges_size);
+        ct3d->media_op_sanitize->dpa_range_count =
+            migration->sanitize_range_count;
+        ct3d->media_op_sanitize->fill_value =
+            migration->sanitize_fill_value;
+        memcpy(ct3d->media_op_sanitize->dpa_range_list,
+               migration->sanitize_ranges, ranges_size);
+    }
+    ct3_restore_poison_list(&ct3d->poison_list, migration->poison,
+                            migration->poison_count);
+    ct3_restore_poison_list(&ct3d->poison_list_bkp,
+                            migration->poison_backup,
+                            migration->poison_backup_count);
+    ct3_restore_poison_list(&ct3d->scan_media_results,
+                            migration->scan_results,
+                            migration->scan_result_count);
+    ct3d->poison_list_cnt = migration->poison_count;
+    ct3d->poison_list_overflowed = migration->poison_overflowed;
+    ct3d->poison_list_overflow_ts = migration->poison_overflow_timestamp;
+    ct3d->scan_media_hasrun = migration->scan_media_hasrun;
+    ct3_timing_migration_cleanup(ct3d);
+    return true;
+}
+
+static const VMStateDescription vmstate_ct3_dpa_range = {
+    .name = "cxl-type3/dpa-range",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT64(starting_dpa, CXLDpaRange),
