+        event.family = irq < GIC_NR_SGIS ?
+            QEMU_CRUCIBLE_INTERRUPT_ARM_GIC_SGI :
+            (cs->crucible_interrupt_family[irq] != 0 ?
+                cs->crucible_interrupt_family[irq] :
+                QEMU_CRUCIBLE_INTERRUPT_ARM_GIC_PPI);
+    } else if (irq < GICV3_LPI_INTID_START) {
+        edge = gicv3_gicd_edge_trigger_test(cs->gic, irq);
+        event.family = cs->gic->crucible_interrupt_family[irq] != 0 ?
+            cs->gic->crucible_interrupt_family[irq] :
+            QEMU_CRUCIBLE_INTERRUPT_ARM_GIC_SPI;
+    } else {
+        edge = true;
+        event.family = QEMU_CRUCIBLE_INTERRUPT_ARM_GIC_LPI;
+    }
+    event.trigger = edge ? QEMU_CRUCIBLE_INTERRUPT_TRIGGER_EDGE :
+        QEMU_CRUCIBLE_INTERRUPT_TRIGGER_LEVEL;
+    event.polarity = QEMU_CRUCIBLE_INTERRUPT_POLARITY_HIGH;
+    event.model_phase = QEMU_CRUCIBLE_INTERRUPT_PHASE_DELIVER;
+    event.target_vcpu = cs->cpu->cpu_index;
+    event.vector = irq;
+    event.priority = cs->hppi.prio;
+    if (qemu_crucible_fault_interrupt_provenance_get(
+            event.family, cs->cpu->cpu_index, irq, &event)) {
+        qemu_crucible_fault_interrupt_provenance_clear(
+            event.family, cs->cpu->cpu_index, irq);
+        event.model_phase = QEMU_CRUCIBLE_INTERRUPT_PHASE_DELIVER;
+        event.priority = cs->hppi.prio;
+    } else {
+        event.source_sequence = irq < GIC_INTERNAL ?
+            cs->crucible_interrupt_source_sequence[irq] :
+            (irq < cs->gic->num_irq ?
+                cs->gic->crucible_interrupt_source_sequence[irq] :
+                qemu_crucible_fault_interrupt_source_current_sequence());
+        event.routing_generation = irq < GIC_INTERNAL ?
+            cs->crucible_interrupt_routing_generation[irq] :
+            (irq < cs->gic->num_irq ?
+                cs->gic->crucible_interrupt_routing_generation[irq] : 0);
+    }
+    if (event.source_sequence == 0) {
+        event.source_sequence =
+            qemu_crucible_fault_interrupt_source_next_sequence();
+    }
+    if (event.routing_generation == 0) {
+        event.routing_generation =
+            qemu_crucible_fault_interrupt_current_routing_generation();
+    }
+    event.duplicate_ordinal = 0;
+    event.disposition = 0;
+
