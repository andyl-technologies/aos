+#define QEMU_CRUCIBLE_HOT_FORK_ENDPOINT_REPLACEMENT_COUNT 2
+#define QEMU_CRUCIBLE_HOT_FORK_MAX_DESCRIPTOR_REPLACEMENTS 4096
+#define QEMU_CRUCIBLE_HOT_FORK_MAX_RETAINED_DESCRIPTORS 4096
+#define QEMU_CRUCIBLE_HOT_FORK_MAX_SHARED_MAPPINGS 4096
+#define QEMU_CRUCIBLE_HOT_FORK_MAX_MAPPING_RECORDS 65536
+#define QEMU_CRUCIBLE_HOT_FORK_MAX_MAPPING_RECORD_BYTES 8192
+#define QEMU_CRUCIBLE_HOT_FORK_MAX_MAPPING_BYTES (16 * 1024 * 1024)
+
+/* Zero denotes an absent identity throughout the hot-fork contracts. */
+static inline bool qemu_crucible_hot_fork_eventfd_identity_token(
+    uint64_t kernel_id, uint64_t *token)
+{
+    if (kernel_id == UINT64_MAX) {
+        return false;
+    }
+
+    *token = kernel_id + 1;
+    return true;
+}
+
+typedef struct QemuCrucibleHotForkParentIdentity {
+    pid_t parent_pid;
+    int parent_pidfd;
+} QemuCrucibleHotForkParentIdentity;
+
+typedef struct QemuCrucibleHotForkDescriptorTableTransaction
+    QemuCrucibleHotForkDescriptorTableTransaction;
+
+/*
+ * Linear owner of the RCU, async, and QEMU thread/mutex registry barriers.
+ *
+ * Success from begin retains both barriers across exactly one fork.  The
+ * parent must release its copy.  The immediate child first opens its exact
+ * descriptor transaction, then reconstructs copied registry state without
+ * starting another thread.  The deferred RCU worker starts only after
+ * descriptor disposition succeeds inside the child resource transaction.
+ * The copied async barrier is released after plugin reconstruction and before
+ * the replacement monitor worker starts, while the parent keeps both reusable
+ * template barriers held.
+ */
+typedef struct QemuCrucibleHotForkRuntimeTransaction {
+    QemuRcuHotForkTransaction rcu;
+    QemuAsyncWorkerHotForkRetainedTransaction async;
+    QemuThreadHotForkRegistryTransaction registry;
+    bool active;
+    bool async_retained;
+    bool child_prepared;
+    bool child_workers_started;
+    bool child_reconstructed;
+} QemuCrucibleHotForkRuntimeTransaction;
+
+int qemu_crucible_hot_fork_begin_runtime_transaction(
+    QemuCrucibleHotForkRuntimeTransaction *transaction);
+/* Borrow one exact retained template barrier without releasing its parent. */
+int qemu_crucible_hot_fork_begin_retained_runtime_transaction(
+    QemuCrucibleHotForkRuntimeTransaction *transaction,
+    uint64_t expected_rcu_barrier_generation,
+    uint64_t expected_async_barrier_generation);
+/* Composed description of the step and basis that last blocked a runtime. */
+const char *qemu_crucible_hot_fork_runtime_transaction_blocker(void);
+int qemu_crucible_hot_fork_release_parent_runtime_transaction(
+    QemuCrucibleHotForkRuntimeTransaction *transaction);
+/* Prepare copied child state while the descriptor transaction stays active. */
+int qemu_crucible_hot_fork_reconstruct_child_runtime(
+    QemuCrucibleHotForkRuntimeTransaction *transaction,
+    const QemuCrucibleHotForkDescriptorTableTransaction *descriptors);
+/*
+ * Reconstruct child-private AIO backend custody, then start the deferred
+ * worker after descriptor disposition and before other hooks. The caller
+ * borrows the verified, strictly sorted final retained descriptor list for
+ * this synchronous call; no list pointer is retained.
+ */
+int qemu_crucible_hot_fork_start_child_runtime(
+    QemuCrucibleHotForkRuntimeTransaction *transaction,
+    const QemuCrucibleHotForkDescriptorTableTransaction *descriptors,
+    const int *retained_fds, size_t retained_fd_count);
+/* Release copied async work after plugin reconstruction, before child QMP. */
+int qemu_crucible_hot_fork_finish_child_runtime(
+    QemuCrucibleHotForkRuntimeTransaction *transaction,
+    const QemuCrucibleHotForkDescriptorTableTransaction *descriptors);
+
+typedef struct QemuCrucibleHotForkDescriptorReplacement {
+    int source_fd;
+    int target_fd;
+} QemuCrucibleHotForkDescriptorReplacement;
+
+typedef struct QemuCrucibleHotForkDescriptorTableTransaction {
+    pid_t parent_pid;
+    pid_t child_pid;
+    bool active;
+    bool descriptors_applied;
+    bool child_reinitialized;
+    bool mappings_verified;
+} QemuCrucibleHotForkDescriptorTableTransaction;
+
+typedef struct QemuCrucibleHotForkSharedMapping {
+    uint64_t start;
+    uint64_t length;
+    uint64_t offset;
+    int backing_fd;
+} QemuCrucibleHotForkSharedMapping;
+
+typedef struct QemuCrucibleHotForkSourceMapping {
+    uint64_t start;
+    uint64_t length;
+    uint64_t offset;
+} QemuCrucibleHotForkSourceMapping;
+
+typedef int (*QemuCrucibleHotForkDescriptorVerifier)(void *opaque);
+typedef int (*QemuCrucibleHotForkChildReinitializer)(void *opaque);
+
+/**
+ * qemu_crucible_hot_fork_capture_parent_identity() - pin the fork parent
+ * @identity: caller-owned identity storage
+ *
+ * Opens an exact Linux pidfd for the calling process before a later fork.
+ * The resulting value is inherited by the child and must not be copied into
+ * an unrelated process or altered by the caller.
+ *
+ * Returns zero on success or a negative errno-style status on failure.
+ */
+int qemu_crucible_hot_fork_capture_parent_identity(
+    QemuCrucibleHotForkParentIdentity *identity);
+
+/**
+ * qemu_crucible_hot_fork_authenticate_immediate_child() - verify fork lineage
+ * @identity: parent identity captured before fork
+ *
+ * Requires the caller to be the immediate child of the exact live process
+ * generation pinned by @identity.  On success the child is armed with
+ * SIGKILL parent-death handling before returning, so the authenticated parent
+ * cannot disappear while the child continues the disposition transaction.
+ *
+ * This function is single-purpose post-fork code.  The caller must terminate
+ * the child after any error and must retain @identity until every operation
+ * requiring the parent anchor is complete.
+ *
+ * Returns zero on success or a negative errno-style status on failure.
+ */
+int qemu_crucible_hot_fork_authenticate_immediate_child(
+    const QemuCrucibleHotForkParentIdentity *identity);
+
+/**
+ * qemu_crucible_hot_fork_release_parent_identity() - release a parent anchor
+ * @identity: identity previously captured by the caller
+ *
+ * Closes the pidfd and invalidates @identity.  Parent and child descriptor
+ * tables are independent after fork, so each surviving process releases its
+ * own inherited copy at the appropriate disposition boundary.
+ */
+void qemu_crucible_hot_fork_release_parent_identity(
+    QemuCrucibleHotForkParentIdentity *identity);
+
+/**
+ * qemu_crucible_hot_fork_adopt_child_as_parent() - release child ancestry
+ *
+ * Converts the authenticated immediate child into an independently supervised
+ * source process.  The child must still carry the SIGKILL parent-death contract
+ * installed by qemu_crucible_hot_fork_authenticate_immediate_child().  Success
+ * removes that one-generation contract; a later fork captures a fresh parent
+ * identity for the promoted process.
+ *
+ * Returns zero on success or a negative errno-style status on failure.
+ */
+int qemu_crucible_hot_fork_adopt_child_as_parent(void);
+
+/**
+ * qemu_crucible_hot_fork_replace_endpoint_descriptors() - replace endpoints
+ * @replacements: exact control and wake source-to-target descriptor pairs
+ * @verify: callback that authenticates both installed target descriptions
+ * @opaque: caller-owned value passed to @verify
+ *
+ * Replaces exactly two pairwise-distinct destination descriptor slots while
+ * retaining rollback copies of both prior descriptions.  Destination
+ * close-on-exec flags are preserved.  The replacement commits only after
+ * @verify accepts both installed descriptions; successful commit closes the
+ * source descriptors, while a rejected verification restores both targets and
+ * leaves both sources open.
+ *
+ * This primitive is intended only for the quiescent immediate child of an
+ * authenticated Crucible fork transaction.  The caller must terminate that
+ * child after any error.  In particular, -EUCLEAN means that rollback could
+ * not be proved and no descriptor may be used.
+ *
+ * Returns zero after exact replacement and verification, a negative errno-style
+ * status when validation, replacement, or verification fails with complete
+ * rollback, or -EUCLEAN when rollback itself is incomplete.
+ */
+int qemu_crucible_hot_fork_replace_endpoint_descriptors(
+    const QemuCrucibleHotForkDescriptorReplacement
+        replacements[QEMU_CRUCIBLE_HOT_FORK_ENDPOINT_REPLACEMENT_COUNT],
+    QemuCrucibleHotForkDescriptorVerifier verify,
+    void *opaque);
+
+/**
+ * qemu_crucible_hot_fork_replace_descriptor_set() - replace exact endpoints
+ * @replacements: canonical source-to-target descriptor table
+ * @replacement_count: number of entries in @replacements
+ * @verify: callback that authenticates every installed target description
+ * @opaque: caller-owned value passed to @verify
+ *
+ * Replaces a bounded table whose target slots are strictly increasing and
+ * whose source and target descriptors are pairwise distinct.  Rollback copies
+ * preserve every prior target description and close-on-exec flag.  Successful
+ * verification commits the complete table and closes every source; rejected
+ * verification restores every target and leaves every source open.
+ *
+ * This primitive is intended only for the quiescent immediate child of an
+ * authenticated Crucible fork transaction.  The caller must terminate that
+ * child after any error.  In particular, -EUCLEAN means that complete rollback
+ * could not be proved and no descriptor may be used.
+ *
+ * Returns zero after exact replacement and verification, a negative
+ * errno-style status when validation, replacement, or verification fails with
+ * complete rollback, or -EUCLEAN when rollback itself is incomplete.
+ */
+int qemu_crucible_hot_fork_replace_descriptor_set(
+    const QemuCrucibleHotForkDescriptorReplacement *replacements,
+    size_t replacement_count,
+    QemuCrucibleHotForkDescriptorVerifier verify,
+    void *opaque);
+
+/**
+ * qemu_crucible_hot_fork_begin_descriptor_table() - close FD admission
+ * @identity: mutable parent identity captured before fork
+ * @transaction: caller-owned descriptor-table transaction storage
+ *
+ * Proves close_range(2) support, authenticates the immediate child, blocks
+ * every blockable signal, consumes the child's parent identity, and opens a
+ * one-shot descriptor-table transaction.  Since fork leaves only the calling
+ * thread alive, the installed signal mask closes every remaining source of
+ * descriptor admission before the caller constructs the final retain table.
+ * The mask remains installed for the future child reinitializer.
+ *
+ * Any error after child authentication is destructive: the caller must
+ * terminate or quarantine the child and must not resume QEMU.
+ *
+ * Returns zero after opening the child transaction, or a negative errno-style
+ * status on failure.
+ */
+int qemu_crucible_hot_fork_begin_descriptor_table(
+    QemuCrucibleHotForkParentIdentity *identity,
+    QemuCrucibleHotForkDescriptorTableTransaction *transaction);
+
+/**
+ * qemu_crucible_hot_fork_apply_descriptor_table() - close inherited FDs
+ * @transaction: active child transaction opened before table construction
+ * @replacements: canonical source-to-target descriptor table
+ * @replacement_count: number of entries in @replacements
+ * @retained_fds: sorted final descriptor table retained by the child
+ * @retained_fd_count: number of entries in @retained_fds
+ * @verify: callback that authenticates the complete installed table
+ * @opaque: caller-owned value passed to @verify
+ *
+ * Consumes the active transaction, replaces every endpoint slot, and uses
+ * Linux close_range(2) to close every descriptor not named by the final table.
+ * The table must be strictly increasing, contain every replacement target,
+ * omit every replacement source, and contain at most
+ * QEMU_CRUCIBLE_HOT_FORK_MAX_RETAINED_DESCRIPTORS entries.  The verifier runs
+ * only after every close range succeeds and every retained slot is still live.
+ *
+ * Invalid arguments leave the active transaction available for an exact retry.
+ * Once endpoint replacement starts, the transaction is consumed and any
+ * nonzero result is destructive: the caller must terminate or quarantine the
+ * child and must not resume QEMU.  The parent process owns an independent copy
+ * of every descriptor and remains unchanged.
+ *
+ * This primitive is intentionally unwired.  A future coordinator must compose
+ * the separate mapping and child-reinitialization proofs before authorizing
+ * resume.
+ *
+ * Returns zero after exact disposition and verification, or a negative
+ * errno-style status on failure.
+ */
+int qemu_crucible_hot_fork_apply_descriptor_table(
+    QemuCrucibleHotForkDescriptorTableTransaction *transaction,
+    const QemuCrucibleHotForkDescriptorReplacement *replacements,
+    size_t replacement_count,
+    const int *retained_fds,
+    size_t retained_fd_count,
+    QemuCrucibleHotForkDescriptorVerifier verify,
+    void *opaque);
+
+/**
+ * qemu_crucible_hot_fork_find_source_mapping() - bind a retained source VMA
+ * @device: exact backing st_dev value registered by the plugin
+ * @inode: exact nonzero backing st_ino value registered by the plugin
+ * @length: exact page-aligned setup-region length
+ * @mapping: caller-owned result storage
+ *
+ * Streams Linux /proc/self/maps under the same fixed record, line, and byte
+ * limits as child mapping verification.  Exactly one writable shared VMA must
+ * span the page-rounded extent of @length bytes at file offset zero and carry
+ * the registered device and inode identity.  @length is the exact protocol
+ * region length; the returned mapping reports the page-rounded VMA extent.  A
+ * second writable mapping of the same backing, or a partial mapping of that
+ * backing, is ambiguous and rejected.
+ *
+ * This parent-side observation supplies the address basis needed to rebuild
+ * the MADV_DONTFORK plugin setup region in an authenticated child.  It does not
+ * retain a procfs descriptor or acknowledge any readiness proof.
+ *
+ * Returns zero with the exact source range, or a negative errno-style status
+ * on malformed, oversized, missing, or ambiguous process mappings.
+ */
+int qemu_crucible_hot_fork_find_source_mapping(
+    uint64_t device,
+    uint64_t inode,
+    uint64_t length,
+    QemuCrucibleHotForkSourceMapping *mapping);
+
+/**
+ * qemu_crucible_hot_fork_verify_mapping_table() - classify child mappings
+ * @transaction: exact child transaction after descriptor-table application
+ * @shared_mappings: sorted writable shared VMAs allowed in the child
+ * @shared_mapping_count: number of entries in @shared_mappings
+ *
+ * Streams the child's Linux /proc/self/maps file without heap allocation and
+ * rejects every writable shared VMA that is not an exact allowlist entry.  It
+ * also rejects every allowlist entry not present as one exact writable shared
+ * VMA backed at the declared offset by the exact retained shrink-sealed memfd.
+ * Private mappings are admitted as copy-on-write and read-only shared mappings
+ * cannot mutate a sibling.  The allowlist must be strictly ordered,
+ * nonoverlapping, page-aligned, nonempty per entry, and contain at most
+ * QEMU_CRUCIBLE_HOT_FORK_MAX_SHARED_MAPPINGS entries.
+ *
+ * The scan accepts at most QEMU_CRUCIBLE_HOT_FORK_MAX_MAPPING_RECORDS records,
+ * QEMU_CRUCIBLE_HOT_FORK_MAX_MAPPING_RECORD_BYTES bytes per record, and
+ * QEMU_CRUCIBLE_HOT_FORK_MAX_MAPPING_BYTES bytes in aggregate.  It opens and
+ * closes its procfs descriptor synchronously while signals remain blocked and
+ * retains no path or kernel record bytes.
+ *
+ * Argument validation leaves the descriptor-applied transaction available for
+ * an exact retry.  Once scanning begins, the transaction is consumed.  Any
+ * failure then rejects the child; success records the complete mapping proof
+ * for future composition with child reinitialization.
+ *
+ * This primitive is intentionally unwired and does not acknowledge readiness
+ * bit 7 by itself.
+ *
+ * Returns zero after exact mapping classification, or a negative errno-style
+ * status on failure.
+ */
+int qemu_crucible_hot_fork_verify_mapping_table(
+    QemuCrucibleHotForkDescriptorTableTransaction *transaction,
+    const QemuCrucibleHotForkSharedMapping *shared_mappings,
+    size_t shared_mapping_count);
+
+/**
+ * qemu_crucible_hot_fork_apply_child_resources() - rebuild child resources
+ * @transaction: active authenticated immediate-child transaction
+ * @replacements: canonical source-to-target descriptor table
+ * @replacement_count: number of entries in @replacements
+ * @retained_fds: sorted final descriptor table retained by the child
+ * @retained_fd_count: number of entries in @retained_fds
+ * @verify_descriptors: complete installed descriptor-table verifier
+ * @descriptor_opaque: caller-owned value passed to @verify_descriptors
+ * @reinitialize: child-only mapping and held-worker reconstruction operation
+ * @reinitialize_opaque: caller-owned value passed to @reinitialize
+ * @shared_mappings: exact writable shared VMAs expected after reconstruction
+ * @shared_mapping_count: number of entries in @shared_mappings
+ *
+ * Validates every immutable table before mutation, closes descriptor admission,
+ * applies the exact retained descriptor table, invokes one child reinitializer,
+ * and then authenticates the resulting writable-shared mapping table.  The
+ * reinitializer must leave every recreated worker and callback path held; this
+ * operation does not release guest or canonical-event admission. Every mapping
+ * backing descriptor must appear in the exact retained descriptor table.
+ *
+ * Once descriptor replacement begins, every nonzero result is destructive:
+ * the caller must terminate or quarantine the child.  A zero result records
+ * all three completed phases in @transaction.  This composition covers only
+ * the explicitly supplied resources and does not itself acknowledge QEMU
+ * readiness bit 7 or 8.
+ *
+ * Returns zero after exact descriptor, reinitializer, and mapping disposition,
+ * or a negative errno-style status on failure.
+ */
+int qemu_crucible_hot_fork_apply_child_resources(
+    QemuCrucibleHotForkDescriptorTableTransaction *transaction,
+    const QemuCrucibleHotForkDescriptorReplacement *replacements,
+    size_t replacement_count,
+    const int *retained_fds,
+    size_t retained_fd_count,
+    QemuCrucibleHotForkDescriptorVerifier verify_descriptors,
+    void *descriptor_opaque,
+    QemuCrucibleHotForkChildReinitializer reinitialize,
+    void *reinitialize_opaque,
+    const QemuCrucibleHotForkSharedMapping *shared_mappings,
+    size_t shared_mapping_count);
+
+/*
+ * Sub-step of the child resource plan application that is running or that
+ * failed, for the child's exit status: 1 plan preconditions, 2 descriptor
+ * table, 3 child runtime start, 4 plugin reinitialization, 5 child runtime
+ * finish, 6 QMP reinitialization, 7 console reinitialization, 8 mapping
+ * table verification, 9 runtime disposition, 10 diagnostics target.  The
+ * preconditions of the application record 11 arguments, 12 plan and
+ * descriptor transaction state, 13 runtime transaction state, 14 plan
+ * validity, 15 plugin reinitializer, 16 QMP reinitializer, 17 console
+ * reinitializer.  A rebuilt monitor iothread records 70 when it never
+ * entered its start routine within the bound, then 71 entered, 72
+ * disposition set, 73 RCU registered, 74 context pushed, 75 started.  Zero
+ * means the application has not started.
+ */
+void qemu_crucible_hot_fork_note_child_detail(unsigned int detail);
+unsigned int qemu_crucible_hot_fork_child_detail(void);
+
+#endif
