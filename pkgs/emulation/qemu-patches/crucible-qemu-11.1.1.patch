+int qemu_crucible_ram_inventory_capture_begin_v1(
+    QemuCrucibleCheckpointInventoryLoan *parent,
+    QemuCrucibleRamInventoryCaptureLoan **out,
+    struct qemu_plugin_crucible_ram_capture_v1 *header)
+{
+    QemuCrucibleRamInventoryCaptureLoan *loan = &inventory_capture;
+    CrucibleRamInventory *regions = NULL;
+    uint64_t slice;
+    int status;
+
+    if (!out || *out || !header || !parent || loan->active || capture_active ||
+        logical_capture->active || candidate_capture.active || !admission_regions ||
+        !bql_locked() || !qemu_in_main_thread() || current_cpu || qemu_in_coroutine() ||
+        capture_generation == UINT64_MAX) {
+        return -EPERM;
+    }
+    memset(header, 0, sizeof(*header));
+    status = qemu_crucible_checkpoint_inventory_current_v1(parent, &slice);
+    if (status) {
+        return status;
+    }
+    *loan = (QemuCrucibleRamInventoryCaptureLoan) {
+        .parent = parent,
+        .regions = NULL,
+        .process = getpid(),
+        .generation = ++capture_generation,
+        .topology = qatomic_read(&topology_generation),
+        .active = true,
+    };
+    qemu_thread_get_self(&loan->thread);
+    capture_regions = NULL;
+    capture_active = true;
+    capture_owner_token = 0;
+    capture_observation_only = true;
+    capture_full = false;
+    capture_region_cursor = 0;
+    capture_page_cursor = 0;
+    *out = loan;
+    /* Actual native custody is born before Source attach or header projection.
+     * No dirty logging, RAM scan, page read, FP callback or ACK is performed. */
+    status = qemu_crucible_checkpoint_inventory_pin_request_v1(parent, loan);
+    if (!status) {
+        status = qemu_crucible_checkpoint_inventory_capture_attach_v1(
+            parent, loan, &loan->source_capture);
+    }
+    if (!status) {
+        /* Only this genuine native call phase selects the typed Source bank
+         * borrower. It is not a process-wide metadata permission flag. */
+        loan->pinning = true;
+        status = region_inventory_ref(admission_regions, &regions);
+        loan->pinning = false;
+        if (!status) {
+            loan->regions = regions;
+            capture_regions = regions;
+        }
+    }
+    if (!status) {
+        status = inventory_capture_current(loan);
+    }
+    if (status) {
+        loan->first_status = status;
+        return status;
+    }
+    *header = (struct qemu_plugin_crucible_ram_capture_v1) {
+        .schema = 1,
+        .region_count = regions->len,
+        .topology_generation = loan->topology,
+        .capture_generation = loan->generation,
+        .metadata_budget_bytes = rust_metadata_budget,
+    };
+    return 0;
+}
