+int qemu_crucible_preexec_standing_sequence_v1(
+    QemuCrucibleStandingPurposeOwner *held, uint64_t *sequence)
+{
+    QemuCruciblePreexecSetupOwner *owner = &preexec_setup_owner;
+    uint64_t word;
+    uint8_t bytes[8];
+    uint64_t observed;
+
+    if (held != &owner->standing || !held->retained || !held->mapping ||
+        !owner->source_published || !sequence ||
+        preexec_setup_syscall5(SYS_getpid, 0, 0, 0, 0, 0) != owner->process_id) {
+        return -EPERM;
+    }
+    word = __atomic_load_n(held->mapping, __ATOMIC_SEQ_CST);
+    preexec_setup_copy(bytes, &word, sizeof(word));
+    observed = preexec_setup_be64(bytes);
+    if (observed == UINT64_MAX) {
+        return -ECANCELED;
+    }
+    if (!observed || (observed & 1) || observed < held->sequence) {
+        return -EAGAIN;
+    }
+    *sequence = observed;
+    return 0;
+}
