+int qemu_plugin_crucible_callback_child_storage_create_v1(
+    qemu_plugin_id_t id, QemuCrucibleStartupRuntimePurpose *runtime,
+    QemuCrucibleCallbackChildRequest *claim,
+    QemuCrucibleCommandConsumerStorage *bridge,
+    QemuCrucibleCallbackChildStorage **out)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *registry = &startup_source.commands;
+    QemuCrucibleCallbackChildStorage *child = &registry->child;
+    size_t extent;
+    size_t alignment;
+    void *address = NULL;
+    int first;
+    int post;
+
+    if (!startup_invocation(id)) {
+        return -EPERM;
+    }
+    if (!out || *out) {
+        return -EINVAL;
+    }
+    first = startup_runtime_admission(id, runtime);
+    if (first) {
+        return first;
+    }
+    first = command_registry_identity(id);
+    if (first) {
+        return first;
+    }
+    qemu_mutex_lock(&registry->mutex);
+    if (callback_child_output_conflicts_locked(out, sizeof(*out))) {
+        first = -EINVAL;
+    } else if (claim != &registry->child_claim || bridge != &registry->storage) {
+        first = -EPERM;
+    } else if (!claim->attempted || !claim->held || claim->canonical_owner != claim ||
+               claim->runtime != runtime || claim->process != registry->process ||
+               claim->payload_claimed || !claim->request ||
+               claim->request_index >= runtime->configured_count ||
+               claim->request != &runtime->configured_requests[claim->request_index] ||
+               claim->extent != claim->request->extent ||
+               claim->alignment != claim->request->alignment ||
+               claim->process_generation != startup_source.original.process_generation ||
+               claim->account_generation != startup_source.standing.initial.account_generation ||
+               claim->fixed_native_extent != runtime->fixed_native_extent) {
+        first = -ESTALE;
+    } else {
+        first = command_storage_identity_locked(bridge);
+    }
+    if (!first && (!bridge->initialized || bridge->initialization_uncertain ||
+                   bridge->initialization_active || bridge->destroyed || bridge->closing ||
+                   bridge->physical_returned || bridge->callback_child_held ||
+                   child->attempted)) {
+        first = -EBUSY;
+    }
+    if (first) {
+        qemu_mutex_unlock(&registry->mutex);
+        return first;
+    }
+    extent = (size_t)claim->extent;
+    alignment = (size_t)claim->alignment;
+    if ((uint64_t)extent != claim->extent || (uint64_t)alignment != claim->alignment) {
+        qemu_mutex_unlock(&registry->mutex);
+        return -EOVERFLOW;
+    }
+    alignment = MAX(alignment, sizeof(void *));
+
+    /* These two claims were admitted together before either payload birth.
+     * The child retains the actual nominal Bridge, without moving its owner
+     * or borrowing a physical-use serial during construction. */
+    claim->payload_claimed = true;
+    bridge->callback_child_held = true;
+    *child = (QemuCrucibleCallbackChildStorage) {
+        .runtime = runtime,
+        .installer = startup_source.saved,
+        .claim = claim,
+        .bridge = bridge,
+        .creation_owner = child,
+        .holder = &child->creation_owner,
+        .extent = extent,
+        .alignment = alignment,
+        .fixed_native_extent = runtime->fixed_native_extent,
+        .process_generation = startup_source.original.process_generation,
+        .account_generation = startup_source.standing.initial.account_generation,
+        .process = registry->process,
+        .attempted = true,
+        .held = true,
+        .allocation_active = true,
+        .bridge_borrow_held = true,
+    };
+    *out = child;
+    qemu_mutex_unlock(&registry->mutex);
+
+    first = startup_process_purpose_live();
+    if (!first) {
+        first = posix_memalign(&address, alignment, extent);
+        first = first ? -first : 0;
+    }
+    qemu_mutex_lock(&registry->mutex);
+    child->address = address;
+    child->allocated = address != NULL;
+    child->allocation_first_status = first;
+    qemu_mutex_unlock(&registry->mutex);
+
+    post = startup_process_purpose_live();
+    qemu_mutex_lock(&registry->mutex);
+    child->allocation_post_status = post;
+    child->allocation_active = false;
+    qemu_mutex_unlock(&registry->mutex);
+    if (post) {
+        crucible_metadata_partition_record_post(&startup_source.metadata_partition, post);
+    }
+    if (first || post) {
+        startup_failure(first ? first : post);
+    }
+    return first ? first : post;
+#else
+    return -ENOTSUP;
+#endif
+}
