+static void char_socket_fd_config_invalid_inputs(
+    SocketChardev *socket, CharFrontend *frontend)
+{
+    CharFrontend foreign = { .chr = frontend->chr };
+    SocketAddress *address = socket->addr;
+    SocketAddressType address_type = address->type;
+    char *tls_authz = socket->tls_authz;
+    QCryptoTLSCreds *tls_creds = socket->tls_creds;
+
+    g_assert_false(qemu_chr_socket_fd_preserve_blocking_configured(&foreign));
+    qemu_mutex_lock(&socket->parent.chr_write_lock);
+    g_assert_true(qemu_chr_socket_fd_preserve_blocking_configured(frontend));
+    g_assert_cmpint(qemu_mutex_trylock(&socket->parent.chr_write_lock), !=, 0);
+    qemu_mutex_unlock(&socket->parent.chr_write_lock);
+    char_socket_fd_config_foreign_lock(frontend, false);
+    char_socket_fd_config_foreign_lock(frontend, true);
+
+    /* Test only immutable predicate inputs; restore before socket dispatch. */
+    frontend->chr_be_change = char_socket_fd_config_change;
+    g_assert_false(qemu_chr_socket_fd_preserve_blocking_configured(frontend));
+    frontend->chr_be_change = NULL;
+    socket->addr = NULL;
+    g_assert_false(qemu_chr_socket_fd_preserve_blocking_configured(frontend));
+    socket->addr = address;
+    address->type = SOCKET_ADDRESS_TYPE_INET;
+    g_assert_false(qemu_chr_socket_fd_preserve_blocking_configured(frontend));
+    address->type = address_type;
+
+    socket->is_telnet = true;
+    g_assert_false(qemu_chr_socket_fd_preserve_blocking_configured(frontend));
+    socket->is_telnet = false;
+    socket->is_tn3270 = true;
+    g_assert_false(qemu_chr_socket_fd_preserve_blocking_configured(frontend));
+    socket->is_tn3270 = false;
+    socket->is_websock = true;
+    g_assert_false(qemu_chr_socket_fd_preserve_blocking_configured(frontend));
+    socket->is_websock = false;
+    socket->tls_authz = (char *)"config-refusal";
+    g_assert_false(qemu_chr_socket_fd_preserve_blocking_configured(frontend));
+    socket->tls_authz = tls_authz;
+    socket->tls_creds = (QCryptoTLSCreds *)frontend;
+    g_assert_false(qemu_chr_socket_fd_preserve_blocking_configured(frontend));
+    socket->tls_creds = tls_creds;
+    g_assert_true(qemu_chr_socket_fd_preserve_blocking_configured(frontend));
