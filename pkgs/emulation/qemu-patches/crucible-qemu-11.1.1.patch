+int qemu_crucible_checkpoint_capture_alias_move_v1(int out[3])
+{
+    QemuCrucibleCheckpointHeldTransaction *owner = &checkpoint_transaction;
+    int status = checkpoint_identity(owner);
+
+    if (status || !out || !owner->capture_alias_active ||
+        owner->capture_alias_moved || owner->capture_alias_attempted != 7 ||
+        owner->request->monitor != monitor_cur()) {
+        return status ? status : -EPERM;
+    }
+    for (unsigned role = 0; role < 3; role++) {
+        if (owner->capture_alias_fd[role] < 0) {
+            return -EPERM;
+        }
+    }
+    for (unsigned role = 0; role < 3; role++) {
+        out[role] = owner->capture_alias_fd[role];
+        owner->capture_alias_fd[role] = -1;
+    }
+    owner->capture_alias_active = false;
+    owner->capture_alias_moved = true;
+    return 0;
+}
