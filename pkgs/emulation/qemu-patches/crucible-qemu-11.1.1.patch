+static bool fingerprint_wake_read_enter(int fd)
+{
+    QemuCrucibleFingerprintWakeWatcher *watcher = &fingerprint_wake_watcher;
+
+    if (qemu_plugin_crucible_wake_watcher_current_v1(watcher, fd) ||
+        watcher->reading || watcher->read_serial == UINT64_MAX) {
+        return false;
+    }
+    qemu_thread_get_self(&watcher->read_thread);
+    ++watcher->read_serial;
+    watcher->reading = true;
+    return true;
+}
+
+static int fingerprint_wake_watcher_return(void)
+{
+    QemuCrucibleFingerprintWakeWatcher *watcher = &fingerprint_wake_watcher;
+    int status;
+
+    if (!watcher->held) {
+        return 0;
+    }
+    status = fingerprint_wake_watcher_detached_current(watcher, watcher->fd);
+    if (status) {
+        return status;
+    }
+    if (watcher->execution) {
+        status = qemu_crucible_fingerprint_main_execution_identity_return_v1(
+            &watcher->execution);
+        watcher->execution_return_status = status;
+        if (watcher->execution) {
+            return status ? status : -EBUSY;
+        }
+        if (status) {
+            /* Consumption has been saved; the signed cause remains distinct
+             * from the still-held Source role and its later physical return. */
+            return status;
+        }
+    }
+    status = qemu_plugin_crucible_wake_watcher_returned_current_v1(
+        watcher, watcher->fd);
+    if (status) {
+        return status;
+    }
+    if (watcher->keeper) {
+        status = qemu_crucible_startup_source_watcher_identity_return_v1(
+            &watcher->keeper, watcher);
+        watcher->keeper_return_status = status;
+        if (watcher->keeper) {
+            return status ? status : -EBUSY;
+        }
+    } else {
+        status = watcher->keeper_return_status;
+    }
+    /* Genuine borrowed alias consumption is separate from its signed cause.
+     * The handler was removed already; no numeric close or new role is issued. */
+    watcher->held = false;
+    return status;
+}
+
+static void fingerprint_wake_read_return(bool entered)
+{
+    QemuCrucibleFingerprintWakeWatcher *watcher = &fingerprint_wake_watcher;
+
+    if (!entered) {
+        return;
+    }
+    /* This exact handler frame has returned its callbacks and drain work.
+     * Removing the handler during an error never retires its loan early. */
+    watcher->reading = false;
+    if (watcher->handler_removed) {
+        fingerprint_wake_watcher_return();
+    }
+}
