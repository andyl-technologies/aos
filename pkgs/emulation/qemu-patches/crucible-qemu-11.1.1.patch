+    if (owner_slot != &startup_source.fingerprint_worker.native.task_reserved &&
+        owner_slot != &startup_source.ram_control_actor.task_reserved &&
+        owner_slot != &startup_source.run_worker.native.task_reserved &&
+        owner_slot != &startup_source.teardown_worker.native.task_reserved) {
+        return -EPERM;
+    }
+    qemu_mutex_lock(&startup_source.commands.mutex);
+    if (!*owner_slot || !ledger->live_reserved) {
+        status = -EPROTO;
+    } else {
+        ledger->live_reserved--;
+        *owner_slot = false;
