+static CrucibleHotForkPluginBarrierState *
+crucible_hot_fork_plugin_barrier(uint32_t operation, Error **errp)
+{
+    CrucibleHotForkPluginBarrierState *report =
+        g_new0(CrucibleHotForkPluginBarrierState, 1);
+    QemuPluginCrucibleHotForkBarrierInventory inventory;
+    int status;
+
+    status = qemu_plugin_crucible_hot_fork_barrier(operation, &inventory);
+    if (status != 0) {
+        error_setg_errno(errp, -status,
+                         "Crucible hot-fork plugin barrier operation failed");
+        g_free(report);
+        return NULL;
+    }
+
+    report->schema_version =
+        QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_STATUS_VERSION;
+    report->generation = inventory.generation;
+    report->registered = inventory.registered;
+    report->manifest_consistent = inventory.manifest_consistent;
+    report->held = (inventory.status.flags &
+        QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_FLAG_HELD) != 0;
+    report->teardown_closed = (inventory.status.flags &
+        QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_FLAG_TEARDOWN) != 0;
+    report->mapping_dontfork = (inventory.status.flags &
+        QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_FLAG_MAPPING_DONTFORK) != 0;
+    report->in_flight = inventory.status.in_flight;
+    report->ring_count = inventory.status.ring_count;
+    report->rings_held = inventory.status.rings_held;
+    report->ring_producers_in_flight =
+        inventory.status.ring_producers_in_flight;
+    report->ring_consumers_in_flight =
+        inventory.status.ring_consumers_in_flight;
+    report->worker_mask = inventory.status.worker_mask;
+    report->parked_worker_mask = inventory.status.parked_worker_mask;
+    report->pending_worker_mask = inventory.status.pending_worker_mask;
+    report->worker_operations_in_flight =
+        inventory.status.worker_operations_in_flight;
+    report->quiescent = report->registered && report->manifest_consistent &&
+        report->held && !report->teardown_closed && report->in_flight == 0 &&
+        report->mapping_dontfork &&
+        report->ring_count != 0 &&
+        report->rings_held == report->ring_count &&
+        report->ring_producers_in_flight == 0 &&
+        report->ring_consumers_in_flight == 0 &&
+        report->parked_worker_mask == report->worker_mask &&
+        report->pending_worker_mask == 0 &&
+        report->worker_operations_in_flight == 0;
+    return report;
+}
