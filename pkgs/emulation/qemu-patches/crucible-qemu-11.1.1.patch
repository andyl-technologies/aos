+static bool test_validate_register_evidence(const uint8_t *evidence,
+                                            size_t evidence_len,
+                                            bool require_change,
+                                            uint64_t expected_icount,
+                                            const uint8_t expected_before[32],
+                                            const uint8_t expected_after[32],
+                                            const uint8_t expected_evidence[32])
+{
+    uint32_t before_len;
+    uint32_t after_len;
+    uint32_t mask_len;
+    uint32_t value_len;
+    const uint8_t *before;
+    const uint8_t *after;
+    const uint8_t *mask;
+    const uint8_t *value;
+    uint8_t before_bit;
+    uint8_t after_bit;
+    uint8_t digest[32];
+    bool fingerprint_changed;
+    bool register_changed;
+    uint64_t cursor_position = test_get_u64(evidence + 72);
+    uint64_t rr_switch_quantum = test_get_u64(evidence + 80);
+    uint32_t expected_mutation = test_mode == TEST_MODE_IMPULSE ?
+        CRUCIBLE_FAULT_REGISTER_MUTATION_BIT_FLIP :
+        CRUCIBLE_FAULT_REGISTER_MUTATION_STUCK;
+
+    if (evidence_len < TEST_REGISTER_EVIDENCE_HEADER_BYTES ||
+        memcmp(evidence, "CRUCQRW1", 8) != 0 ||
+        test_get_u16(evidence + 8) != 1 ||
+        test_get_u16(evidence + 10) != test_architecture ||
+        test_get_u16(evidence + 12) != test_model_phase ||
+        test_get_u16(evidence + 14) != 0 ||
+        test_get_u32(evidence + 16) != 0 ||
+        test_get_u32(evidence + 20) != test_numeric_id ||
+        test_get_u32(evidence + 24) != expected_mutation ||
+        test_get_u32(evidence + 28) != test_side_effects ||
+        test_get_u32(evidence + 32) != test_side_effects ||
+        test_get_u32(evidence + 36) != test_first_bit ||
+        test_get_u32(evidence + 40) != 1 ||
+        test_get_u64(evidence + 56) != expected_icount ||
+        test_get_u64(evidence + 64) != 0 ||
+        rr_switch_quantum == 0 ||
+        cursor_position >= rr_switch_quantum ||
+        cursor_position != expected_icount % rr_switch_quantum ||
+        (test_terminal_cursor_required &&
+         cursor_position != 0) ||
+        !test_bytes_nonzero(evidence + 88, 32) ||
+        !test_bytes_nonzero(evidence + 120, 32) ||
+        test_get_u32(evidence + 156) != 0) {
+        g_printerr("register evidence debug phase=%u vcpu=%u numeric=%u "
+                   "icount=%" G_GUINT64_FORMAT " current=%" G_GUINT64_FORMAT
+                   " cursor=%" G_GUINT64_FORMAT " quantum=%" G_GUINT64_FORMAT
+                   " terminal=%s\n",
+                   test_get_u16(evidence + 12),
+                   test_get_u32(evidence + 16),
+                   test_get_u32(evidence + 20),
+                   test_get_u64(evidence + 56),
+                   test_get_u64(evidence + 64), cursor_position,
+                   rr_switch_quantum,
+                   test_terminal_cursor_required ? "true" : "false");
+        test_fail("register evidence identity or scheduler framing is wrong");
+    }
+    before_len = test_get_u32(evidence + 44);
+    after_len = test_get_u32(evidence + 48);
+    mask_len = test_get_u32(evidence + 52);
+    value_len = test_get_u32(evidence + 152);
+    if (before_len == 0 || before_len != after_len || mask_len != 1 ||
+        value_len != 1 ||
+        TEST_REGISTER_EVIDENCE_HEADER_BYTES + before_len + after_len +
+            mask_len + value_len != evidence_len) {
+        test_fail("register evidence lengths are not canonical");
+    }
+    before = evidence + TEST_REGISTER_EVIDENCE_HEADER_BYTES;
+    after = before + before_len;
+    mask = after + after_len;
+    value = mask + mask_len;
+    test_sha256(before, before_len, digest);
+    if (memcmp(digest, expected_before, 32) != 0) {
+        test_fail("register before hash does not match evidence");
+    }
+    test_sha256(after, after_len, digest);
+    if (memcmp(digest, expected_after, 32) != 0) {
+        test_fail("register after hash does not match evidence");
+    }
+    test_sha256(evidence, evidence_len, digest);
+    if (memcmp(digest, expected_evidence, 32) != 0) {
+        test_fail("register evidence hash does not match framing");
+    }
+    before_bit = test_mask_bit(before, test_first_bit);
+    after_bit = test_mask_bit(after, test_first_bit);
+    register_changed = memcmp(before, after, before_len) != 0;
+    fingerprint_changed = memcmp(evidence + 120, evidence + 88, 32) != 0;
+    if (mask[0] != 1 ||
+        (test_mode == TEST_MODE_IMPULSE &&
+         (value[0] != 0 || before_bit == after_bit)) ||
+        (test_mode == TEST_MODE_PERSISTENT &&
+         (value[0] != 1 || after_bit != 1)) ||
+        (require_change && before_bit == after_bit) ||
+        fingerprint_changed != register_changed) {
+        test_fail("register evidence does not prove the requested transform");
+    }
+    for (size_t index = 0; index < 32; index++) {
+        static const char hex[] = "0123456789abcdef";
+
+        test_execution_fingerprint[index * 2] =
+            hex[evidence[88 + index] >> 4];
+        test_execution_fingerprint[index * 2 + 1] =
+            hex[evidence[88 + index] & 0x0f];
+    }
+    test_execution_fingerprint[64] = '\0';
+    return before_bit != after_bit;
+}
