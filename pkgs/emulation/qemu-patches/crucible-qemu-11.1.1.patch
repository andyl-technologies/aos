+
+int usb_timer_restore_phase(QEMUTimer *timer, uint16_t phase_ps)
+{
+    int64_t expire_ns;
+    uint16_t loaded_phase;
+    int status = timer_expire_time_ns_phase(timer, &expire_ns,
+                                            &loaded_phase);
+
+    if (status < 0 || loaded_phase || phase_ps >= PICOSECONDS_PER_NANOSECOND) {
+        return -EINVAL;
+    }
+    if (!status) {
+        return phase_ps ? -EINVAL : 0;
+    }
+    return timer_mod_ns_phase(timer, expire_ns, phase_ps) ? 0 : -EINVAL;
+}
