+void qemu_crucible_checkpoint_stop_completed_v1(int flush_status)
+{
+    struct QemuCrucibleCheckpointStopOwner *stop = &checkpoint_stop_owner;
+    uint64_t generation = qemu_plugin_crucible_vmstop_generation();
+    int status;
+
+    if (!qatomic_load_acquire(&stop->admitted) ||
+        stop->process_id != getpid() || !qemu_in_main_thread() ||
+        !bql_locked() || qemu_in_coroutine() ||
+        qemu_plugin_crucible_vmstop_cold_origin() || !generation ||
+        generation != stop->admitted_generation || stop->completion_attempted) {
+        return;
+    }
+    /* This records the actual completion attempt even when flush or the
+     * subsequent physical Source observation fails. It is never reissued.
+     */
+    qemu_thread_get_self(&stop->thread);
+    stop->completion_attempted = true;
+    stop->completion_flush_status = flush_status;
+    if (flush_status && !stop->first_status) {
+        stop->first_status = flush_status;
+    }
+    status = qemu_crucible_checkpoint_storage_current_v1();
+    if (!status && stop->control_intent) {
+        status = qemu_plugin_crucible_source_control_stop_intent_current_v1(
+            stop->control_intent, false);
+    }
+    if (!status && (!qemu_plugin_crucible_vmstop_quiesced() ||
+                    !qemu_crucible_checkpoint_pager_binding_current(&stop->source))) {
+        status = -ESTALE;
+    }
+    if (status && !stop->post_status) {
+        stop->post_status = status;
+    }
+    if (stop->first_status || stop->post_status) {
+        return;
+    }
+    stop->completed_generation = generation;
+    qatomic_store_release(&stop->published, true);
+}
+
+int qemu_plugin_crucible_checkpoint_terminal_observe_v1(
+    qemu_plugin_id_t id, qemu_plugin_crucible_ram_control_actor_v1 *actor,
+    const uint8_t arm_request_digest[32], uint64_t request_generation,
+    uint64_t connection_epoch,
+    struct qemu_plugin_crucible_checkpoint_terminal_status_v1 *out)
+{
+    struct qemu_plugin_crucible_checkpoint_terminal_status_v1 observed = {
+        .schema_version = 1,
+        .struct_size = sizeof(observed),
+    };
+    QemuCrucibleCheckpointTerminalObservation journal;
+    int status = qemu_crucible_ram_control_actor_current(actor, id);
+
+    if (status || !out || !arm_request_digest) {
+        return status ? status : -EINVAL;
+    }
+    if (qatomic_load_acquire(&checkpoint_request.published)) {
+        status = qemu_crucible_checkpoint_terminal_observe_v1(
+            actor, &checkpoint_request, arm_request_digest,
+            request_generation, connection_epoch, &journal);
+        if (status) {
+            return status;
+        }
+        memcpy(observed.arm_request_digest, journal.arm_digest, 32);
+        observed.request_generation = journal.generation;
+        observed.connection_epoch = journal.connection_epoch;
+        observed.physical_state = journal.physical_state;
+        observed.first_status = journal.first_status;
+        observed.post_status = journal.post_status;
+    } else {
+        /* This is the actual native pending owner, not a numerical request
+         * reconstructed because the host did not receive its begin reply.
+         */
+        if (!qatomic_load_acquire(&checkpoint_pending.published) ||
+            checkpoint_pending.actor != actor || checkpoint_pending.moved ||
+            request_generation != checkpoint_pending.generation ||
+            memcmp(arm_request_digest, checkpoint_pending.digest, 32) ||
+            connection_epoch != 0) {
+            return -ESTALE;
+        }
+        memcpy(observed.arm_request_digest, checkpoint_pending.digest, 32);
+        observed.request_generation = checkpoint_pending.generation;
+        observed.physical_state = checkpoint_pending.metadata_close_uncertain ?
+            QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_TERMINAL_UNCERTAIN :
+            QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_TERMINAL_PENDING;
+        observed.first_status = qatomic_read(&checkpoint_pending.first_status);
+        observed.post_status = qatomic_read(&checkpoint_pending.post_status);
+    }
+    *out = observed;
+    return 0;
+}
