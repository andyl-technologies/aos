+    g_assert_cmpint(fcntl(3, F_GETFD), ==, -1);
+    g_assert_cmpint(errno, ==, EBADF);
+    g_assert_cmpint(socketpair(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, pair), ==, 0);
+    if (pair[0] != 3) {
+        g_assert_cmpint(dup3(pair[0], 3, O_CLOEXEC), ==, 3);
+        g_assert_cmpint(close(pair[0]), ==, 0);
+    }
+    g_assert_cmpint(fstat(3, &identity), ==, 0);
+    /* This endpoint custody seam is disclosed; Source still performs its own
+     * exact physical identity check and real once-only shutdown syscall.
+     */
+    startup_source.control_device = identity.st_dev;
+    startup_source.control_inode = identity.st_ino;
+    return fixture_high_fd(pair[1]);
+}
