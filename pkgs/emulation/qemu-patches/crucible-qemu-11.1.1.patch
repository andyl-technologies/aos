+int qemu_plugin_crucible_control_component_enroll_v1(
+    qemu_plugin_id_t id, qemu_plugin_vcpu_idle_resume_cb_t callback,
+    void *child_userdata,
+    qemu_plugin_crucible_fingerprint_intent_cb_v1 snapshot_callback,
+    void *runtime_userdata, QemuCrucibleSourceControlBinding **holder)
+{
+    QemuCrucibleSourceControlBinding *component = NULL;
+    int status;
+    int observed;
+
+    if (!holder || fingerprint_control_component.attempted ||
+        qemu_plugin_control_boundary_cb) {
+        return -EINVAL;
+    }
+    /* This authentic Source floor includes the compiled Native registration
+     * holder before any of its fields are written. It supplies no callback,
+     * installer identity, component relation or Original to the constructor. */
+    status = qemu_crucible_checkpoint_storage_current_v1();
+    if (status) {
+        return status;
+    }
+    status = qemu_crucible_startup_source_control_component_enroll_v1(
+        id, callback, child_userdata, snapshot_callback, runtime_userdata, holder);
+    observed = qemu_crucible_startup_source_control_component_holder_observe_v1(
+        holder, &component);
+    if (component) {
+        /* A born-negative Source component remains physically attributable to
+         * the same durable field even when no callback became visible. */
+        fingerprint_control_component.component = component;
+        fingerprint_control_component.holder = holder;
+        fingerprint_control_component.callback = callback;
+        fingerprint_control_component.snapshot_callback = snapshot_callback;
+        fingerprint_control_component.child_userdata = child_userdata;
+        fingerprint_control_component.process = getpid();
+        fingerprint_control_component.attempted = true;
+        fingerprint_control_component.detached = true;
+    }
+    return status ? status : observed;
+}
+
+int qemu_plugin_crucible_control_component_observe_v1(
+    QemuCrucibleSourceControlBinding **holder,
+    qemu_plugin_vcpu_idle_resume_cb_t callback, void *child_userdata,
+    QemuCrucibleSourceControlBinding **out)
+{
+    int status;
+
+    if (!out || out == holder) {
+        return -EINVAL;
+    }
+    *out = NULL;
+    /* Authenticate the actual enrolled address before Source can inspect it.
+     * This output is a factual projection; it never replaces the owner field. */
+    if (!holder || !fingerprint_control_component.attempted ||
+        holder != fingerprint_control_component.holder ||
+        callback != fingerprint_control_component.callback ||
+        child_userdata != fingerprint_control_component.child_userdata ||
+        fingerprint_control_component.process != getpid()) {
+        return -ESTALE;
+    }
+    status = qemu_crucible_startup_source_control_component_holder_observe_v1(
+        holder, out);
+    /* Preserve the actual projection even on signed failure. A mismatched
+     * registry cannot turn that projection into successful registration. */
+    if (*out && *out != fingerprint_control_component.component) {
+        return -ESTALE;
+    }
+    return status;
+}
+
+int qemu_plugin_crucible_control_component_current_v1(
+    QemuCrucibleSourceControlBinding **holder,
+    QemuCrucibleSourceControlBinding *component,
+    qemu_plugin_vcpu_idle_resume_cb_t callback, void *child_userdata)
+{
+    int status = qemu_plugin_crucible_control_component_registered_current_v1(
+        component, callback, child_userdata, holder);
+
+    if (status) {
+        return status;
+    }
+    /* Source corroborates the same paid Runtime/component and actual callback.
+     * This pure registration query issues no operation or read permission. */
+    return qemu_crucible_startup_source_control_component_current_v1(
+        component, callback, child_userdata);
+}
+
+int qemu_plugin_crucible_publisher_service_return_frame_current_v1(
+    QemuCruciblePublisherServiceReturnFrame *frame,
+    QemuCrucibleSourceControlBinding *component,
+    QemuCrucibleSourceControlBinding **holder)
+{
+    if (frame != &fingerprint_control_component.service_return ||
+        frame->canonical_owner != frame || !frame->active ||
+        frame->process != getpid() || !qemu_thread_is_self(&frame->thread) ||
+        !frame->serial || frame->serial == UINT64_MAX ||
+        frame->component != component || frame->holder != holder) {
+        return -ESTALE;
+    }
+    return qemu_plugin_crucible_control_component_returned_current_v1(
+        component, fingerprint_control_component.callback,
+        fingerprint_control_component.child_userdata, holder);
+}
+
+int qemu_plugin_crucible_control_component_return_v1(
+    QemuCrucibleSourceControlBinding **holder)
+{
+    QemuCruciblePublisherServiceReturnFrame *frame =
+        &fingerprint_control_component.service_return;
+    QemuCruciblePublisherServiceReturnResult result;
+    int first;
+    int post;
+    int status;
+
+    if (!holder || !fingerprint_control_component.attempted ||
+        holder != fingerprint_control_component.holder ||
+        fingerprint_control_component.process != getpid()) {
+        return -ESTALE;
+    }
+    if (frame->active || frame->retained || frame->serial >= UINT64_MAX - 1) {
+        return -EBUSY;
+    }
+    first = qemu_plugin_crucible_control_component_returned_current_v1(
+        fingerprint_control_component.component,
+        fingerprint_control_component.callback,
+        fingerprint_control_component.child_userdata, holder);
+    if (first) {
+        return first;
+    }
+    first = qemu_crucible_startup_source_publisher_service_drain_v1(
+        fingerprint_control_component.component, holder);
+    if (first) {
+        return first;
+    }
+    /* This actual detached component edge lends only local consumption. Its
+     * serial never grants a callback, read, wait or new Original interval. */
+    frame->serial++;
+    frame->canonical_owner = frame;
+    frame->component = fingerprint_control_component.component;
+    frame->holder = holder;
+    qemu_thread_get_self(&frame->thread);
+    frame->process = getpid();
+    frame->source_returned = false;
+    frame->child_returned = false;
+    frame->active = true;
+    result = qemu_crucible_startup_source_publisher_service_return_v1(
+        frame->component, holder, frame);
+    frame->source_returned = true;
+    frame->child_returned = result.child_returned;
+    if (!frame->first_status) {
+        frame->first_status = result.status;
+    }
+    post = qemu_plugin_crucible_publisher_service_return_frame_current_v1(
+        frame, frame->component, holder);
+    if (!frame->post_status) {
+        frame->post_status = post;
+    }
+    frame->retained = result.entered && !result.closed;
+    frame->active = false;
+
+    /* A negative Original observation can accompany physical consumption.
+     * Keep that cause while separately closing the parent's remaining debt. */
+    status = !result.closed || post ? -EBUSY :
+        qemu_crucible_startup_source_control_component_identity_return_v1(holder);
+    if (!*holder) {
+        fingerprint_control_component.component = NULL;
+        fingerprint_control_component.holder = NULL;
+    }
+    return frame->first_status ? frame->first_status :
+        frame->post_status ? frame->post_status : status;
+}
