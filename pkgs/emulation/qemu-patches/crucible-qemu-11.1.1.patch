+/* This is the genuine executable once-carrier constructor, not a decoded
+ * record setter. It retains both separately issued roles before its post;
+ * Source0 keeps its real Main connection and fork-parent relationship. */
+static int preexec_setup_family_assignment_construct(void)
+{
+    QemuCruciblePreexecSetupOwner *owner = &preexec_setup_owner;
+    QemuCrucibleFixedFamilyPurposeOwner *family = &owner->fixed_family;
+    const QemuCrucibleProcessFamilyRecord *material = &owner->plan.purpose.family;
+    long process = preexec_setup_syscall5(SYS_getpid, 0, 0, 0, 0, 0);
+    long thread = preexec_setup_syscall5(SYS_gettid, 0, 0, 0, 0, 0);
+    int status;
+
+    if (!owner->attempted || !owner->frame_validated || !owner->peer_validated ||
+        !owner->plan_validated || owner->process_id != process ||
+        owner->thread_id != thread || owner->parent_process != owner->peer_process ||
+        preexec_setup_syscall5(SYS_getppid, 0, 0, 0, 0, 0) != owner->peer_process ||
+        owner->plan.purpose.subdivision_index !=
+            QEMU_CRUCIBLE_PROCESS_FAMILY_SOURCE_ROLE) {
+        return -EPERM;
+    }
+    if (family->retained) {
+        return family->first_status ? family->first_status : -EALREADY;
+    }
+    status = preexec_setup_original_live();
+    if (status) {
+        return status;
+    }
+    family->issuer = owner;
+    family->source_process = process;
+    family->source_thread = thread;
+    family->main_process = owner->peer_process;
+    family->main_connection = owner->control_identity;
+    family->assignment_generation = material->assignment_generation;
+    family->account_generation = material->account_generation;
+    preexec_setup_copy(family->containing_capability,
+                       material->containing_capability, 32);
+    family->source.family = family;
+    family->source.process = process;
+    family->source.process_generation = owner->plan.purpose.process_generation;
+    preexec_setup_copy(&family->source.material, &material->source,
+                       sizeof(family->source.material));
+    family->source.retained = true;
+    family->target.family = family;
+    preexec_setup_copy(&family->target.material, &material->target,
+                       sizeof(family->target.material));
+    family->target.reserved = true;
+    family->retained = true;
+
+    status = preexec_setup_original_live();
+    if (status) {
+        family->first_status = status;
+        family->post_status = status;
+        return status;
+    }
+    /* Kernel ancestry/limit/artifact corroboration and Source publication still
+     * follow; this reservation cannot execute a Target or mint fork capacity. */
+    return 0;
+}
+
+static void preexec_setup_exit(void) __attribute__((noreturn));
+
+static void preexec_setup_exit(void)
+{
+    preexec_setup_syscall5(SYS_exit_group, 125, 0, 0, 0, 0);
+    /* A denied exit cannot fall through to constructors. Actual retirement
+     * still requires the external owner to observe/reap the real process.
+     */
+    __builtin_trap();
+}
+
+/* The executable preinit call supplies the original argc/argv/envp. There is
+ * deliberately no profile validator or accepting installer getter: exact closed
+ * issuer/module/geometry and earlier loader namespace proofs are not supplied.
+ * A later qualified installer view must borrow SAME owner until actual process
+ * retirement; ending its view must never close these FD/mapping owners.
+ */
+static void preexec_setup_entry(int argc, char **argv, char **environment)
+{
+    QemuCruciblePreexecSetupBorrow view;
+    uint64_t page_size = 0;
+    int selected = preexec_setup_selection(environment);
+    int status;
+
+    if (selected == 0) {
+        return;
+    }
+    /* Required selected semantics are release-published before any ordinary
+     * constructor. This marker cannot grant a child share or a process credit.
+     * A same-carrier child issuer must later provide its own genuine owner.
+     */
+    __atomic_store_n(&qemu_crucible_selected_process_id,
+        (int)preexec_setup_syscall5(SYS_getpid, 0, 0, 0, 0, 0), __ATOMIC_RELEASE);
+    if (selected < 0) {
+        preexec_setup_fail(selected);
+        preexec_setup_exit();
+    }
+    {
+        const volatile uint8_t *support = preexec_setup_support;
+
+        if (support[QEMU_CRUCIBLE_PREEXEC_SUPPORT_SETUP_OFFSET + 3] !=
+                QEMU_CRUCIBLE_PREEXEC_SETUP_EDITION) {
+            preexec_setup_fail(-EPROTONOSUPPORT);
+            preexec_setup_exit();
+        }
+    }
+    status = preexec_setup_receive_once();
+    if (!status) {
+        status = preexec_setup_physical_borrow(&view);
+    }
+    if (!status) {
+        status = preexec_setup_plugin_path(argc, argv,
+                                           preexec_setup_owner.plugin_path);
+        if (!status) {
+            preexec_setup_owner.plugin_path_selected = true;
+        } else {
+            preexec_setup_fail(status);
+        }
+    }
+    if (!status) {
+        status = preexec_setup_peer();
+    }
+    if (!status) {
+        status = preexec_setup_plan();
+    }
+    if (!status) {
+        status = preexec_setup_fixed_owner_retain();
+    }
+    if (!status) {
+        status = preexec_setup_mapping_page_size(&page_size);
+    }
+    if (!status) {
+        status = preexec_setup_original_live();
+    }
+    if (!status) {
+        status = preexec_setup_family_assignment_construct();
+    }
+    if (!status) {
+        status = preexec_setup_aliases();
+    }
+    if (!status) {
+        status = preexec_setup_limits();
+    }
+    if (!status) {
+        status = preexec_setup_cgroup();
+    }
+    if (!status) {
+        status = preexec_setup_family();
+    }
+    if (!status) {
+        status = preexec_setup_capabilities();
+    }
+    if (!status) {
+        status = preexec_setup_artifact();
+    }
+    if (!status) {
+        status = preexec_setup_original_live();
+    }
+    if (!status) {
+        QemuCruciblePreexecSetupOwner *owner = &preexec_setup_owner;
+        const char prefix[] = "/proc/self/fd/";
+        char digits[16];
+        size_t count = 0;
+        unsigned number = owner->artifact_fd;
+        uint64_t descriptor_limit;
+
+        do {
+            digits[count++] = '0' + number % 10;
+            number /= 10;
+        } while (number);
+        preexec_setup_copy(owner->artifact_load_alias, prefix, sizeof(prefix) - 1);
+        for (size_t index = 0; index < count; index++) {
+            owner->artifact_load_alias[sizeof(prefix) - 1 + index] =
+                digits[count - index - 1];
+        }
+        owner->artifact_load_alias[sizeof(prefix) - 1 + count] = 0;
+
+        owner->contract = (struct QemuCrucibleProcessContractOwner) {
+            .process = owner->process_id,
+            .directory_fd = owner->cgroup_directory,
+            .device = owner->cgroup_identity.st_dev,
+            .inode = owner->cgroup_identity.st_ino,
+            .parent_directory_fd = owner->parent_cgroup_directory,
+            .service_directory_fd = owner->service_cgroup_directory,
+            .sender_directory_fd = owner->sender_cgroup_directory,
+            .parent_device = owner->parent_cgroup_identity.st_dev,
+            .parent_inode = owner->parent_cgroup_identity.st_ino,
+            .service_device = owner->service_cgroup_identity.st_dev,
+            .service_inode = owner->service_cgroup_identity.st_ino,
+            .sender_device = owner->sender_cgroup_identity.st_dev,
+            .sender_inode = owner->sender_cgroup_identity.st_ino,
+            .parent_cpu_quota = owner->plan.purpose.parent_cpu_quota,
+            .parent_cpu_period = owner->plan.purpose.parent_cpu_period,
+            .parent_task_limit = owner->plan.purpose.parent_task_limit,
+        };
+        owner->incarnation = (struct QemuCrucibleIncarnationPurposeOwner) {
+            .process = owner->process_id,
+            .generation = owner->fixed_family.source.process_generation,
+            .local_extent = owner->fixed_family.source.material.extent,
+            .index = QEMU_CRUCIBLE_PROCESS_FAMILY_SOURCE_ROLE,
+            .assignment = &owner->fixed_family.source,
+        };
+
+        /* Artifact inspection cannot stand in for a fresh physical family/
+         * child/capability post. The same admitted singleton/scratch retains
+         * every ambiguous alias before Source publication, without a new clock.
+         */
+        status = preexec_contract_current(owner, &owner->preinit_observation,
+                                          &descriptor_limit);
+        if (!status) {
+            status = preexec_publisher_storage_construct(owner);
+        }
+        if (!status) {
+            status = preexec_publisher_session_construct(owner, page_size);
+        }
+        if (!status) {
+            status = preexec_ram_endpoint_construct(owner);
+        }
+        if (!status) {
+            status = preexec_standing_construct(owner, page_size);
+        }
+        if (!status) {
+            status = preexec_workspace_construct(owner);
+        }
+        if (!status) {
+            status = qemu_crucible_startup_source_preexec_publish_v3(owner);
+        }
+        if (!status) {
+            owner->source_published = true;
+            owner->fixed_family.published = true;
+        }
+    }
+    if (status) {
+        preexec_setup_fail(status);
+    } else {
+        /* Receipt/family/artifact custody is not full selected activation.
+         * Genuine request/parser, stop and final-disposition publishers must
+         * still join their actual lifetimes before this route may continue.
+         */
+        preexec_setup_fail(-ENOKEY);
+    }
+    if (preexec_setup_owner.publisher_storage.session.source_holder) {
+        qemu_crucible_startup_source_preexec_publisher_return_v1(&preexec_setup_owner);
+    }
+    if (preexec_setup_owner.publisher_storage.session.held) {
+        preexec_publisher_session_return(&preexec_setup_owner);
+    }
+    preexec_setup_exit();
+}
+
+/* Main-executable only: this object is never in a common library/plugin. */
+static void (*const preexec_setup_hook)(int, char **, char **)
+    __attribute__((section(".preinit_array"), used)) = preexec_setup_entry;
diff --git a/system/crucible-preexec-workspace.inc.h b/system/crucible-preexec-workspace.inc.h
new file mode 100644
index 0000000000000000000000000000000000000000..31bd552b48dac3b39db44df581172b2894d3d295
--- /dev/null
+++ b/system/crucible-preexec-workspace.inc.h
@@ -0,0 +1,268 @@
+/*
+ * Once-carrier workspace role and retained received-alias custody
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Included by the raw preexec constructor. No QEMU state hook, allocation,
+ * callback, descriptor duplication or operation constructor runs here.
+ */
+
+static bool preexec_workspace_output_overlaps(const void *output, size_t bytes)
+{
+    uintptr_t address = (uintptr_t)output;
+    uintptr_t owner = (uintptr_t)&preexec_setup_owner;
+
+    return bytes > UINTPTR_MAX - address ||
+        (address < owner + sizeof(preexec_setup_owner) &&
+         owner < address + bytes);
+}
+
+/* This is exact edition geometry, not Source or backing authority. The
+ * appended publisher roles leave the workspace at its original slot. */
+static bool preexec_workspace_roster_matches(
+    const QemuCruciblePreexecSetupOwner *owner)
+{
+    return (owner->selected_edition == 5 && owner->plan.schema == 8 &&
+            owner->descriptor_count == QEMU_CRUCIBLE_PREEXEC_SETUP_WORKSPACE_FDS) ||
+           (owner->selected_edition == 6 && owner->plan.schema == 9 &&
+            owner->descriptor_count == QEMU_CRUCIBLE_PREEXEC_SETUP_V6_WORKSPACE_FDS);
+}
+
+static int preexec_workspace_identity(QemuCrucibleWorkspacePurposeOwner *role)
+{
+    QemuCruciblePreexecSetupOwner *owner = &preexec_setup_owner;
+    long process = preexec_setup_syscall5(SYS_getpid, 0, 0, 0, 0, 0);
+
+    if (role != &owner->workspace || process != owner->process_id ||
+        preexec_setup_syscall5(SYS_gettid, 0, 0, 0, 0, 0) != owner->thread_id) {
+        return -EPERM;
+    }
+    if (!role->attempted || !role->held || role->issuer != owner ||
+        role->contract != &owner->contract ||
+        role->incarnation != &owner->incarnation ||
+        role->assignment != &owner->fixed_family.source ||
+        owner->incarnation.assignment != role->assignment ||
+        !owner->fixed_family.retained || !role->assignment->retained ||
+        !owner->plan_validated || !owner->peer_validated ||
+        !preexec_workspace_roster_matches(owner) ||
+        role->descriptor_slot !=
+            &owner->descriptors[QEMU_CRUCIBLE_PREEXEC_SETUP_WORKSPACE_INDEX] ||
+        role->process != process ||
+        role->process_generation != owner->incarnation.generation ||
+        role->account_generation != owner->plan.purpose.account_generation ||
+        role->workspace_generation != owner->plan.workspace.workspace_generation ||
+        role->allocation_extent != owner->plan.workspace.allocation_extent ||
+        !role->backing_retained || !owner->workspace_backing_protected ||
+        role->fixed_storage_bytes != sizeof(owner->workspace)) {
+        return -ESTALE;
+    }
+    return 0;
+}
+
+static int preexec_workspace_alias_current(QemuCrucibleWorkspacePurposeOwner *role)
+{
+    struct stat identity;
+    long flags;
+    long status;
+
+    if (role->close_attempted || role->alias_returned || role->close_uncertain ||
+        *role->descriptor_slot != role->descriptor) {
+        return -ESTALE;
+    }
+    status = preexec_setup_syscall5(SYS_fstat, role->descriptor,
+        (long)(uintptr_t)&identity, 0, 0, 0);
+    if (status < 0) {
+        return (int)status;
+    }
+    if (!S_ISREG(identity.st_mode) || identity.st_size < 0 ||
+        (uint64_t)identity.st_size != role->allocation_extent ||
+        (uint64_t)identity.st_dev != role->device ||
+        (uint64_t)identity.st_ino != role->inode) {
+        return -ESTALE;
+    }
+    flags = preexec_setup_syscall5(SYS_fcntl, role->descriptor, F_GETFL, 0, 0, 0);
+    if (flags < 0) {
+        return (int)flags;
+    }
+    if ((flags & O_ACCMODE) != O_RDWR) {
+        return -EPERM;
+    }
+    flags = preexec_setup_syscall5(SYS_fcntl, role->descriptor, F_GETFD, 0, 0, 0);
+    if (flags < 0) {
+        return (int)flags;
+    }
+    if (!(flags & FD_CLOEXEC)) {
+        return -EPERM;
+    }
+    flags = preexec_setup_syscall5(SYS_fcntl, role->descriptor, F_GET_SEALS, 0, 0, 0);
+    if (flags < 0) {
+        return (int)flags;
+    }
+    if (flags != (F_SEAL_SHRINK | F_SEAL_GROW | F_SEAL_SEAL)) {
+        return -EPERM;
+    }
+    return 0;
+}
+
+static int preexec_workspace_construct(QemuCruciblePreexecSetupOwner *owner)
+{
+    QemuCrucibleWorkspacePurposeOwner *role = &owner->workspace;
+    const QemuCrucibleProcessWorkspacePurpose *purpose = &owner->plan.workspace;
+    int status;
+
+    if (!owner->plan.workspace_bytes) {
+        return 0;
+    }
+    status = qemu_crucible_preexec_purpose_check_v3(owner);
+    if (status) {
+        return status;
+    }
+    if (role->attempted) {
+        return -EALREADY;
+    }
+    if (!preexec_workspace_roster_matches(owner) ||
+        purpose->allocation_extent != QEMU_CRUCIBLE_PROCESS_WORKSPACE_ALLOCATION_BYTES ||
+        owner->provisional_native_extent < sizeof(*owner) ||
+        !owner->workspace_backing_protected ||
+        purpose->process_generation != owner->incarnation.generation) {
+        return -ENOKEY;
+    }
+    /* This complete inline role belongs to the actual once-carrier debit.
+     * Its backing is the disjoint compulsory share already protected before
+     * that debit, not a second native allocation or a decoded scalar grant. */
+    *role = (QemuCrucibleWorkspacePurposeOwner) {
+        .issuer = owner,
+        .contract = &owner->contract,
+        .incarnation = &owner->incarnation,
+        .assignment = &owner->fixed_family.source,
+        .descriptor_slot =
+            &owner->descriptors[QEMU_CRUCIBLE_PREEXEC_SETUP_WORKSPACE_INDEX],
+        .descriptor = owner->descriptors[QEMU_CRUCIBLE_PREEXEC_SETUP_WORKSPACE_INDEX],
+        .process = owner->process_id,
+        .process_generation = owner->incarnation.generation,
+        .account_generation = owner->plan.purpose.account_generation,
+        .workspace_generation = purpose->workspace_generation,
+        .allocation_extent = purpose->allocation_extent,
+        .fixed_storage_bytes = sizeof(owner->workspace),
+        .device = purpose->device,
+        .inode = purpose->inode,
+        .attempted = true,
+        .held = true,
+        .backing_retained = true,
+    };
+    status = preexec_workspace_identity(role);
+    if (!status) {
+        status = preexec_workspace_alias_current(role);
+    }
+    role->first_status = status;
+    role->post_status = preexec_setup_original_live();
+    role->published = !role->first_status && !role->post_status;
+    return role->first_status ? role->first_status : role->post_status;
+}
+
+int qemu_crucible_preexec_workspace_borrow_v1(
+    QemuCruciblePreexecPurposeOwner *issuer,
+    QemuCrucibleWorkspacePurposeOwner **out)
+{
+    QemuCruciblePreexecSetupOwner *owner = &preexec_setup_owner;
+    QemuCrucibleWorkspacePurposeOwner *role = &owner->workspace;
+    int status;
+
+    if (issuer != owner || !out ||
+        preexec_workspace_output_overlaps(out, sizeof(*out)) || *out ||
+        preexec_setup_syscall5(SYS_gettid, 0, 0, 0, 0, 0) != owner->thread_id) {
+        return -EPERM;
+    }
+    if (!owner->plan.workspace_bytes) {
+        return 0;
+    }
+    status = preexec_workspace_identity(role);
+    if (status) {
+        return status;
+    }
+    if (role->borrowed || role->borrower_returned) {
+        return -EALREADY;
+    }
+    role->borrowed = true;
+    role->borrower_holder = out;
+    *out = role;
+    /* Retain the authentic born loan even when its independent post refuses.
+     * The Source borrower must inspect its output before signed status. */
+    status = preexec_setup_original_live();
+    return role->first_status ? role->first_status :
+        role->post_status ? role->post_status : status;
+}
+
+int qemu_crucible_preexec_workspace_current_v1(
+    QemuCrucibleWorkspacePurposeOwner *role,
+    QemuCrucibleWorkspacePurposeObservation *out)
+{
+    QemuCrucibleWorkspacePurposeObservation view;
+    int status = preexec_workspace_identity(role);
+
+    if (status || !out || preexec_workspace_output_overlaps(out, sizeof(*out))) {
+        return status ? status : -EINVAL;
+    }
+    if (!role->published || !role->borrowed || role->borrower_returned ||
+        !role->borrower_holder || *role->borrower_holder != role) {
+        return -ESTALE;
+    }
+    status = preexec_workspace_alias_current(role);
+    if (status) {
+        return status;
+    }
+    view = (QemuCrucibleWorkspacePurposeObservation) {
+        .contract = role->contract,
+        .incarnation = role->incarnation,
+        .assignment = role->assignment,
+        .descriptor = role->descriptor,
+        .allocation_extent = role->allocation_extent,
+        .device = role->device,
+        .inode = role->inode,
+        .workspace_generation = role->workspace_generation,
+        .process_generation = role->process_generation,
+        .account_generation = role->account_generation,
+    };
+    *out = view;
+    return 0;
+}
+
+int qemu_crucible_preexec_workspace_identity_return_v1(
+    QemuCrucibleWorkspacePurposeOwner **holder)
+{
+    QemuCrucibleWorkspacePurposeOwner *role = &preexec_setup_owner.workspace;
+    long result;
+    int status = preexec_workspace_identity(role);
+
+    if (status) {
+        return status;
+    }
+    if (!holder || holder != role->borrower_holder || *holder != role ||
+        !role->borrowed || role->borrower_returned) {
+        return -ESTALE;
+    }
+    if (role->close_uncertain) {
+        return role->return_status ? role->return_status : -EIO;
+    }
+    if (role->close_attempted) {
+        return -EBUSY;
+    }
+    /* The Source borrower calls this only after its actual mapping/users
+     * have returned. Consume the received alias once; never refund the
+     * containing backing share still retained by its producing parent. */
+    if (*role->descriptor_slot != role->descriptor) {
+        return -ESTALE;
+    }
+    role->close_attempted = true;
+    result = preexec_setup_syscall5(SYS_close, role->descriptor, 0, 0, 0, 0);
+    role->return_status = result < 0 ? (int)result : 0;
+    role->close_uncertain = result < 0;
+    if (result < 0) {
+        return role->return_status;
+    }
+    role->alias_returned = true;
+    *role->descriptor_slot = -1;
+    role->borrower_returned = true;
+    *holder = NULL;
+    role->borrower_holder = NULL;
+    return 0;
+}
diff --git a/system/crucible-ram-fork.c b/system/crucible-ram-fork.c
new file mode 100644
index 0000000000000000000000000000000000000000..b4fb265161580080ff341f5d4a1290565c5ca88d
--- /dev/null
+++ b/system/crucible-ram-fork.c
@@ -0,0 +1,389 @@
+/*
+ * Independently staged RAM authority for immediate fork children
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+
+#include "qemu/bswap.h"
+#include "qemu/main-loop.h"
+#include "qemu/crucible-paged-ram.h"
+#include "plugins/qemu-plugin.h"
+#include "system/crucible-ram-fork.h"
+#include <sys/vfs.h>
+#include <linux/magic.h>
+
+static QemuCrucibleRamForkStage fork_stage = {
+    .control_fd = -1,
+    .source_fd = -1,
+    .spill_fd = -1,
+    .cancellation_fd = -1,
+};
+static uint64_t stage_generation;
+static uint64_t callback_plugin;
+static QemuCrucibleRamForkPrepare prepare_callback;
+static QemuCrucibleRamForkResources resource_callback;
+static QemuCrucibleRamForkRelease release_callback;
+static void *callback_opaque;
+static bool child_resources_validated;
+
+int qemu_plugin_crucible_register_ram_fork_v1(
+    uint64_t plugin_id, QemuCrucibleRamForkPrepare prepare,
+    QemuCrucibleRamForkResources resources, QemuCrucibleRamForkRelease release,
+    void *opaque)
+{
+    if (!plugin_id || !prepare || !resources || !release || prepare_callback ||
+        resource_callback || callback_plugin) {
+        return -EINVAL;
+    }
+    callback_plugin = plugin_id;
+    callback_opaque = opaque;
+    prepare_callback = prepare;
+    resource_callback = resources;
+    release_callback = release;
+    return 0;
+}
+
+static int connected_stream(int descriptor)
+{
+    struct sockaddr_storage address;
+    socklen_t length = sizeof(address);
+    int type;
+    socklen_t type_length = sizeof(type);
+
+    if (descriptor < 0 ||
+        getsockopt(descriptor, SOL_SOCKET, SO_TYPE, &type, &type_length) < 0 ||
+        type != SOCK_STREAM ||
+        getpeername(descriptor, (struct sockaddr *)&address, &length) < 0 ||
+        address.ss_family != AF_UNIX) {
+        return -EINVAL;
+    }
+    return 0;
+}
+
+static void close_stage(QemuCrucibleRamForkStage *stage)
+{
+    if (stage->control_fd >= 0) {
+        close(stage->control_fd);
+    }
+    if (stage->source_fd >= 0) {
+        close(stage->source_fd);
+    }
+    if (stage->spill_fd >= 0) {
+        close(stage->spill_fd);
+    }
+    if (stage->cancellation_fd >= 0) {
+        close(stage->cancellation_fd);
+    }
+    g_free((void *)stage->plan);
+    *stage = (QemuCrucibleRamForkStage) {
+        .control_fd = -1, .source_fd = -1, .spill_fd = -1,
+        .cancellation_fd = -1,
+    };
+}
+
+int qemu_crucible_ram_fork_stage(int plan_fd, int control_fd, int source_fd,
+                                int spill_fd,
+                                int cancellation_fd,
+                                uint64_t template_generation,
+                                uint64_t process_contract_generation,
+                                uint64_t *generation)
+{
+    QemuCrucibleRamForkStage candidate = {
+        .control_fd = -1, .source_fd = -1, .spill_fd = -1,
+        .cancellation_fd = -1,
+    };
+    const int required_seals = F_SEAL_SEAL | F_SEAL_SHRINK |
+        F_SEAL_GROW | F_SEAL_WRITE;
+    uint8_t *bytes;
+    struct stat metadata;
+    struct stat spill_metadata;
+    struct statfs spill_filesystem;
+    uint8_t header[192];
+    size_t copied = 0;
+    int seals;
+    int result;
+
+    if (!bql_locked() || !generation || !prepare_callback || fork_stage.plan ||
+        !template_generation || !process_contract_generation ||
+        stage_generation == UINT64_MAX || plan_fd < 0 || control_fd < 0 ||
+        spill_fd < 0 || spill_fd == plan_fd || spill_fd == control_fd ||
+        spill_fd == source_fd || spill_fd == cancellation_fd ||
+        cancellation_fd < 0 || plan_fd == control_fd || plan_fd == source_fd ||
+        control_fd == source_fd || cancellation_fd == control_fd ||
+        cancellation_fd == source_fd || cancellation_fd == plan_fd) {
+        return -EINVAL;
+    }
+    result = qemu_crucible_ram_diagnostic_failure();
+    if (result) {
+        return result;
+    }
+    if (fstat(spill_fd, &spill_metadata) < 0 ||
+        !S_ISREG(spill_metadata.st_mode) || spill_metadata.st_size != 0 ||
+        fstatfs(spill_fd, &spill_filesystem) < 0 ||
+        spill_filesystem.f_type == TMPFS_MAGIC ||
+        spill_filesystem.f_type == RAMFS_MAGIC) {
+        return -EINVAL;
+    }
+    seals = fcntl(plan_fd, F_GET_SEALS);
+    if (seals < 0 || (seals & required_seals) != required_seals ||
+        fstat(plan_fd, &metadata) < 0 || !S_ISREG(metadata.st_mode) ||
+        metadata.st_size < sizeof(header) || metadata.st_size > CRUCIBLE_RAM_FORK_MAX_BYTES) {
+        return -EINVAL;
+    }
+    result = connected_stream(control_fd);
+    if (!result && source_fd >= 0) {
+        result = connected_stream(source_fd);
+    }
+    if (result) {
+        return result;
+    }
+    while (copied < sizeof(header)) {
+        ssize_t count = pread(plan_fd, header + copied,
+                              sizeof(header) - copied, copied);
+
+        if (count < 0 && errno == EINTR) {
+            continue;
+        }
+        if (count <= 0) {
+            return count < 0 ? -errno : -EIO;
+        }
+        copied += count;
+    }
+    /* Both C custody and the independently decoded plugin plan are charged
+     * before allocation. Additional engine metadata is admitted separately. */
+    if (memcmp(header, "CRURFK01", 8) || ldl_be_p(header + 8) != 1 ||
+        ldl_be_p(header + 12) != metadata.st_size ||
+        ldq_be_p(header + 72) < 2 * (uint64_t)metadata.st_size ||
+        ldq_be_p(header + 112) == 0 ||
+        ldq_be_p(header + 112) > ldq_be_p(header + 56)) {
+        return -ENOSPC;
+    }
+    copied = 0;
+    bytes = g_try_malloc(metadata.st_size);
+    if (!bytes) {
+        return -ENOMEM;
+    }
+    candidate.plan = bytes;
+    candidate.plan_length = metadata.st_size;
+    while (copied < candidate.plan_length) {
+        ssize_t count = pread(plan_fd, bytes + copied,
+                               candidate.plan_length - copied, copied);
+
+        if (count < 0 && errno == EINTR) {
+            continue;
+        }
+        if (count <= 0) {
+            result = count < 0 ? -errno : -EIO;
+            goto fail;
+        }
+        copied += count;
+    }
+    if (memcmp(bytes, "CRURFK01", 8) || ldl_be_p(bytes + 8) != 1 ||
+        ldl_be_p(bytes + 12) != candidate.plan_length ||
+        ldq_be_p(bytes + 16) != template_generation ||
+        ldq_be_p(bytes + 24) != process_contract_generation ||
+        bytes[40] > 1 || (bytes[40] != (source_fd >= 0))) {
+        result = -EINVAL;
+        goto fail;
+    }
+    candidate.control_fd = fcntl(control_fd, F_DUPFD_CLOEXEC, 12);
+    if (candidate.control_fd < 0) {
+        result = -errno;
+        goto fail;
+    }
+    if (source_fd >= 0) {
+        candidate.source_fd = fcntl(source_fd, F_DUPFD_CLOEXEC, 12);
+        if (candidate.source_fd < 0) {
+            result = -errno;
+            goto fail;
+        }
+    }
+    candidate.spill_fd = fcntl(spill_fd, F_DUPFD_CLOEXEC, 12);
+    if (candidate.spill_fd < 0) {
+        result = -errno;
+        goto fail;
+    }
+    candidate.cancellation_fd = fcntl(cancellation_fd, F_DUPFD_CLOEXEC, 12);
+    if (candidate.cancellation_fd < 0) {
+        result = -errno;
+        goto fail;
+    }
+    candidate.generation = stage_generation + 1;
+    candidate.template_generation = template_generation;
+    candidate.process_contract_generation = process_contract_generation;
+    candidate.source_process = getpid();
+    result = prepare_callback(bytes, candidate.plan_length, candidate.control_fd,
+                              candidate.source_fd, candidate.spill_fd,
+                              candidate.cancellation_fd,
+                              candidate.generation, callback_opaque);
+    if (result) {
+        goto fail;
+    }
+    stage_generation = candidate.generation;
+    fork_stage = candidate;
+    *generation = stage_generation;
+    return 0;
+fail:
+    close_stage(&candidate);
+    return result;
+}
+
+bool qemu_crucible_ram_fork_stage_bound(uint64_t template_generation,
+                                       uint64_t process_contract_generation)
+{
+    return !qemu_crucible_ram_diagnostic_failure() &&
+        fork_stage.plan && !fork_stage.consumed &&
+        fork_stage.source_process == getpid() &&
+        fork_stage.template_generation == template_generation &&
+        fork_stage.process_contract_generation == process_contract_generation;
+}
+
+const QemuCrucibleRamForkStage *qemu_crucible_ram_fork_stage_query(void)
+{
+    return &fork_stage;
+}
+
+int qemu_crucible_ram_fork_stage_release(uint64_t generation)
+{
+    int result;
+
+    if (!bql_locked() || !generation || generation != fork_stage.generation ||
+        fork_stage.source_process != getpid()) {
+        return -ESTALE;
+    }
+    result = release_callback(generation, callback_opaque);
+    if (result) {
+        return result;
+    }
+    close_stage(&fork_stage);
+    return 0;
+}
+
+void qemu_crucible_ram_fork_stage_consumed(void)
+{
+    if (fork_stage.plan) {
+        fork_stage.consumed = true;
+    }
+}
+
+int qemu_plugin_crucible_ram_fork_child_stage_v1(
+    uint64_t template_generation, const uint8_t **plan, size_t *plan_length,
+    int *control_fd, int *source_fd, int *spill_fd, int *cancellation_fd,
+    uint64_t *generation)
+{
+    if (!plan || !plan_length || !control_fd || !source_fd || !spill_fd ||
+        !cancellation_fd || !generation || !fork_stage.plan ||
+        fork_stage.consumed || getpid() == fork_stage.source_process ||
+        getppid() != fork_stage.source_process ||
+        fork_stage.template_generation != template_generation) {
+        return -ESTALE;
+    }
+    if (qemu_crucible_ram_diagnostic_failure()) {
+        return qemu_crucible_ram_diagnostic_failure();
+    }
+    *plan = fork_stage.plan;
+    *plan_length = fork_stage.plan_length;
+    *control_fd = fork_stage.control_fd;
+    *source_fd = fork_stage.source_fd;
+    *spill_fd = fork_stage.spill_fd;
+    *cancellation_fd = fork_stage.cancellation_fd;
+    *generation = fork_stage.generation;
+    return 0;
+}
+
+int qemu_crucible_ram_fork_child_resources(int *retained, uint32_t capacity,
+                                         uint32_t *retained_count,
+                                         int *closed, uint32_t close_capacity,
+                                         uint32_t *closed_count)
+{
+    if (!retained || !closed || !retained_count || !closed_count ||
+        capacity > CRUCIBLE_RAM_FORK_MAX_DESCRIPTORS ||
+        close_capacity > CRUCIBLE_RAM_FORK_MAX_DESCRIPTORS) {
+        return -EINVAL;
+    }
+    *retained_count = 0;
+    *closed_count = 0;
+    if (!fork_stage.plan) {
+        return 0;
+    }
+    if (!resource_callback || child_resources_validated ||
+        getpid() == fork_stage.source_process ||
+        getppid() != fork_stage.source_process) {
+        return -ESTALE;
+    }
+    {
+        int result;
+        result = resource_callback(fork_stage.generation, retained,
+                                   capacity, retained_count,
+                                   closed, close_capacity, closed_count,
+                                   callback_opaque);
+        if (result || *retained_count > capacity ||
+            *closed_count > close_capacity) {
+            return result ? result : -E2BIG;
+        }
+        for (uint32_t index = 0; index < *retained_count; index++) {
+            int descriptor = retained[index];
+
+            if (descriptor < 0 || fcntl(descriptor, F_GETFD) < 0 ||
+                descriptor == fork_stage.control_fd ||
+                descriptor == fork_stage.source_fd ||
+                descriptor == fork_stage.spill_fd ||
+                descriptor == fork_stage.cancellation_fd) {
+                return -EINVAL;
+            }
+            for (uint32_t other = 0; other < index; other++) {
+                if (retained[other] == descriptor) {
+                    return -EINVAL;
+                }
+            }
+        }
+        if (*retained_count == 0) {
+            return -EINVAL;
+        }
+        for (uint32_t index = 0; index < *closed_count; index++) {
+            int descriptor = closed[index];
+
+            if (descriptor < 0 || fcntl(descriptor, F_GETFD) < 0 ||
+                descriptor == fork_stage.control_fd ||
+                descriptor == fork_stage.source_fd ||
+                descriptor == fork_stage.spill_fd ||
+                descriptor == fork_stage.cancellation_fd) {
+                return -EINVAL;
+            }
+            for (uint32_t other = 0; other < *retained_count; other++) {
+                if (retained[other] == descriptor) {
+                    return -EINVAL;
+                }
+            }
+            for (uint32_t other = 0; other < index; other++) {
+                if (closed[other] == descriptor) {
+                    return -EINVAL;
+                }
+            }
+        }
+        child_resources_validated = true;
+        return 0;
+    }
+}
+
+int qemu_crucible_ram_fork_child_adopted(void)
+{
+    int result;
+
+    if (!fork_stage.plan) {
+        return 0;
+    }
+    if (!child_resources_validated || getpid() == fork_stage.source_process ||
+        getppid() != fork_stage.source_process) {
+        return -ESTALE;
+    }
+    /* The plugin has reported independently duplicated, ready child owners.
+     * Dormant C staging aliases must not escape into a promoted template. */
+    result = release_callback(fork_stage.generation, callback_opaque);
+    if (result) {
+        return result;
+    }
+    close_stage(&fork_stage);
+    child_resources_validated = false;
+    return 0;
+}
diff --git a/system/crucible-ram-quiescence.c b/system/crucible-ram-quiescence.c
new file mode 100644
index 0000000000000000000000000000000000000000..755f9a1b8b722f836fc3d57d76f3535766939448
--- /dev/null
+++ b/system/crucible-ram-quiescence.c
@@ -0,0 +1,1570 @@
+/*
+ * Physical RAM borrower owner closure
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+
+#include <dirent.h>
+#include <sys/syscall.h>
+
+#include "exec/cpu-common.h"
+#include "hw/core/cpu.h"
+#include "qemu/aio.h"
+#include "qemu/crucible-hot-fork-async.h"
+#include "qemu/crucible-hot-fork-plugin.h"
+#include "qemu/main-loop.h"
+#include "qemu/plugin.h"
+#include "qemu/rcu.h"
+#include "qemu/thread.h"
+#include "system/block-backend-global-state.h"
+#include "system/crucible-ram-quiescence.h"
+#include "system/crucible-observation-writer.h"
+#include "system/crucible-observation-realization.h"
+#include "system/runstate.h"
+
+#define RAM_SERVICE_WORKERS_MAX 32
+#define RAM_OWNER_DESCRIPTORS_MAX 4096
+
+typedef struct RamServiceWorker {
+    uint32_t role;
+    uint64_t generation;
+    uint64_t thread_id;
+    void *actor;
+} RamServiceWorker;
+
+typedef struct RamOwnerDescriptor {
+    int descriptor;
+    dev_t device;
+    ino_t inode;
+    mode_t mode;
+    int flags;
+} RamOwnerDescriptor;
+
+typedef struct RamOwnerClosure {
+    uint64_t token;
+    pid_t process_id;
+    int64_t owner_thread_id;
+    uint64_t service_generation;
+    uint64_t plugin_generation;
+    uint64_t plugin_resource_generation;
+    uint64_t plugin_process_generation;
+    uint64_t plugin_id;
+    uint64_t plugin_worker_process_id;
+    uint64_t plugin_worker_membership_generation;
+    uint64_t plugin_worker_mask;
+    uint64_t plugin_worker_thread_ids[3];
+    uint64_t rcu_generation;
+    uint64_t async_generation;
+    uint64_t block_generation;
+    bool plugin_owned;
+    bool rcu_owned;
+    bool async_owned;
+    bool block_owned;
+    QemuThreadRamPauseTransaction threads;
+    QemuCrucibleRamActorPause *actor_pause;
+    QemuCrucibleResidentServiceAbsence *resident_absence;
+    uint64_t absence_generation;
+    bool service_owned;
+    bool returning;
+    bool end_active;
+    QemuBlockBackendHotForkBarrierInventory block_end_inventory;
+    struct qemu_plugin_crucible_ram_physical_end_v2 end;
+    RamOwnerDescriptor descriptors[RAM_OWNER_DESCRIPTORS_MAX];
+    size_t descriptor_count;
+    unsigned observation_borrowers;
+} RamOwnerClosure;
+
+/* Only membership uses this lock. Service work never acquires it. */
+static pthread_mutex_t service_lock = PTHREAD_MUTEX_INITIALIZER;
+static RamServiceWorker service_workers[RAM_SERVICE_WORKERS_MAX];
+static uint64_t service_generation = 1;
+static bool service_frozen;
+static bool service_failed;
+static RamOwnerClosure owner_closure;
+static uint64_t owner_token_counter;
+/* One bounded terminal incarnation, not a second live pause or retry grant. */
+static struct {
+    pid_t process_id;
+    int64_t owner_thread_id;
+    struct qemu_plugin_crucible_ram_physical_end_v2 end;
+} owner_last_end;
+
+uint64_t qemu_crucible_ram_owner_metadata_bytes(void)
+{
+    return sizeof(owner_closure) + sizeof(service_workers) + sizeof(service_lock) +
+        sizeof(service_generation) + sizeof(service_frozen) +
+        sizeof(service_failed) + sizeof(owner_token_counter) + sizeof(owner_last_end) +
+        qemu_crucible_ram_main_loop_metadata_bytes() +
+        qemu_crucible_observation_writer_metadata_bytes_v1() +
+        qemu_crucible_observation_realization_metadata_bytes_v1();
+}
+
+static int ram_service_membership(uint32_t role, uint64_t generation,
+                                  uint64_t thread_id, uint32_t enter, void *actor)
+{
+    RamServiceWorker *available = NULL;
+    RamServiceWorker *match = NULL;
+    int result = 0;
+
+    if ((role != 1 && role != 2) || generation == 0 || enter > 1 ||
+        thread_id == 0 || thread_id != qemu_get_thread_id()) {
+        return -EINVAL;
+    }
+    pthread_mutex_lock(&service_lock);
+    for (size_t index = 0; index < RAM_SERVICE_WORKERS_MAX; index++) {
+        RamServiceWorker *worker = &service_workers[index];
+
+        if (worker->thread_id == thread_id) {
+            match = worker;
+        } else if (worker->thread_id == 0 && !available) {
+            available = worker;
+        }
+    }
+    if (enter && qemu_crucible_resident_service_birth_blocked_v1()) {
+        result = -EBUSY;
+    } else if (match && match->actor != actor) {
+        result = -EPERM;
+    } else if (service_frozen) {
+        /* Unexpected worker failure poisons the retained proof immediately. */
+        if (!enter && match && match->role == role &&
+            match->generation == generation) {
+            service_failed = true;
+        }
+        result = -EBUSY;
+    } else if (service_generation == UINT64_MAX) {
+        result = -EOVERFLOW;
+    } else if (enter) {
+        if (match || !available) {
+            result = match ? -EEXIST : -ENOSPC;
+        } else {
+            *available = (RamServiceWorker) {
+                .role = role, .generation = generation, .thread_id = thread_id,
+                .actor = actor,
+            };
+            service_generation++;
+        }
+    } else if (!match || match->role != role ||
+               match->generation != generation) {
+        result = -ESTALE;
+    } else {
+        bool any_worker = false;
+
+        *match = (RamServiceWorker) { 0 };
+        service_generation++;
+        for (size_t index = 0; index < RAM_SERVICE_WORKERS_MAX; index++) {
+            any_worker |= service_workers[index].thread_id != 0;
+        }
+        if (!any_worker) {
+            service_failed = false;
+        }
+    }
+    pthread_mutex_unlock(&service_lock);
+    return result;
+}
+
+int qemu_crucible_ram_service_worker(uint32_t role, uint64_t generation,
+                                     uint64_t thread_id, uint32_t enter)
+{
+    return ram_service_membership(role, generation, thread_id, enter, NULL);
+}
+
+int qemu_crucible_ram_service_actor(void *actor, bool enter)
+{
+    uint64_t generation;
+    uint64_t thread_id;
+    int status = qemu_plugin_crucible_ram_actor_registration_current(
+        actor, &generation, &thread_id);
+
+    return status ? status :
+        ram_service_membership(2, generation, thread_id, enter, actor);
+}
+
+int qemu_crucible_ram_service_actor_enrollment_current(
+    void *actor, uint64_t generation, uint64_t thread_id)
+{
+    size_t matches = 0;
+    int status;
+
+    if (!actor || !generation || !thread_id) {
+        return -EPERM;
+    }
+    status = pthread_mutex_trylock(&service_lock);
+    if (status) {
+        return status == EBUSY ? 1 : -status;
+    }
+    for (size_t index = 0; index < RAM_SERVICE_WORKERS_MAX; index++) {
+        const RamServiceWorker *worker = &service_workers[index];
+
+        matches += worker->actor == actor && worker->role == 2 &&
+            worker->generation == generation && worker->thread_id == thread_id;
+    }
+    status = pthread_mutex_unlock(&service_lock);
+    return status ? -status : matches == 1 ? 0 : -ESTALE;
+}
+
+static bool ram_owner_paused(void)
+{
+    CPUState *cpu;
+
+    if (!bql_locked() || !runstate_check(RUN_STATE_PAUSED) ||
+        !qemu_plugin_crucible_vmstop_quiesced()) {
+        return false;
+    }
+    CPU_FOREACH(cpu) {
+        if (!cpu->stopped || cpu->running) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool ram_plugin_quiescent(
+    const QemuPluginCrucibleHotForkBarrierInventory *inventory)
+{
+    const struct qemu_plugin_crucible_hot_fork_barrier_status *status =
+        &inventory->status;
+
+    return inventory->registered && inventory->manifest_consistent &&
+        (status->flags & QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_FLAG_HELD) &&
+        !(status->flags & QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_FLAG_TEARDOWN) &&
+        status->in_flight == 0 && status->ring_count != 0 &&
+        status->rings_held == status->ring_count &&
+        status->ring_producers_in_flight == 0 &&
+        status->ring_consumers_in_flight == 0 &&
+        status->parked_worker_mask == status->worker_mask &&
+        status->pending_worker_mask == 0 &&
+        status->worker_operations_in_flight == 0;
+}
+
+static int ram_owner_plugin_membership(
+    const QemuPluginCrucibleHotForkBarrierInventory *plugin, bool capture)
+{
+    QemuPluginCrucibleHotForkInventory resources;
+    const struct qemu_plugin_crucible_hot_fork_barrier_status *status =
+        &plugin->status;
+
+    qemu_plugin_crucible_hot_fork_inventory(&resources);
+    if (!ram_plugin_quiescent(plugin) || !resources.registered ||
+        !resources.complete || resources.generation == 0 ||
+        resources.manifest.process_generation == 0 ||
+        resources.manifest.plugin_id != plugin->plugin_id ||
+        resources.manifest.worker_mask != status->worker_mask ||
+        status->worker_process_id != (uint64_t)getpid() ||
+        status->worker_membership_generation == 0) {
+        return -ESTALE;
+    }
+    if (capture) {
+        owner_closure.plugin_generation = plugin->generation;
+        owner_closure.plugin_resource_generation = resources.generation;
+        owner_closure.plugin_process_generation =
+            resources.manifest.process_generation;
+        owner_closure.plugin_id = plugin->plugin_id;
+        owner_closure.plugin_worker_process_id = status->worker_process_id;
+        owner_closure.plugin_worker_membership_generation =
+            status->worker_membership_generation;
+        owner_closure.plugin_worker_mask = status->worker_mask;
+        memcpy(owner_closure.plugin_worker_thread_ids, status->worker_thread_ids,
+               sizeof(owner_closure.plugin_worker_thread_ids));
+        return 0;
+    }
+    if (owner_closure.plugin_generation != plugin->generation ||
+        owner_closure.plugin_resource_generation != resources.generation ||
+        owner_closure.plugin_process_generation !=
+            resources.manifest.process_generation ||
+        owner_closure.plugin_id != plugin->plugin_id ||
+        owner_closure.plugin_worker_process_id != status->worker_process_id ||
+        owner_closure.plugin_worker_membership_generation !=
+            status->worker_membership_generation ||
+        owner_closure.plugin_worker_mask != status->worker_mask ||
+        memcmp(owner_closure.plugin_worker_thread_ids, status->worker_thread_ids,
+               sizeof(owner_closure.plugin_worker_thread_ids))) {
+        return -ESTALE;
+    }
+    return 0;
+}
+
+/* Called under service_lock with registry and actor pause already owned.
+ * Preserve all three views; only the same nominal actor may join native+role2. */
+static bool ram_owner_thread_known(uint64_t thread_id)
+{
+    size_t native = 0;
+    size_t services = 0;
+    size_t plugins = 0;
+    const RamServiceWorker *service = NULL;
+
+    for (size_t index = 0; index < owner_closure.threads.thread_count; index++) {
+        native += owner_closure.threads.thread_ids[index] > 0 &&
+            (uint64_t)owner_closure.threads.thread_ids[index] == thread_id;
+    }
+    for (size_t index = 0; index < RAM_SERVICE_WORKERS_MAX; index++) {
+        if (service_workers[index].thread_id == thread_id) {
+            services++;
+            service = &service_workers[index];
+        }
+    }
+    for (size_t index = 0;
+         index < ARRAY_SIZE(owner_closure.plugin_worker_thread_ids); index++) {
+        plugins += owner_closure.plugin_worker_thread_ids[index] == thread_id;
+    }
+    if (native + services + plugins == 1) {
+        /* A registered actor must retain both views, not silently lose one. */
+        return !service || !service->actor;
+    }
+    return native == 1 && services == 1 && plugins == 0 &&
+        service->role == 2 && service->actor &&
+        qemu_plugin_crucible_ram_actor_pause_identity(owner_closure.actor_pause,
+            service->actor, service->generation, thread_id) &&
+        qemu_thread_ram_actor_matches(&owner_closure.threads,
+            qemu_plugin_crucible_ram_actor_pause_binding(owner_closure.actor_pause),
+            thread_id);
+}
+
+static int ram_owner_physical_tasks(size_t *out)
+{
+    size_t total = owner_closure.threads.thread_count +
+        ctpop64(owner_closure.plugin_worker_mask);
+    size_t joined = 0;
+
+    for (size_t index = 0; index < RAM_SERVICE_WORKERS_MAX; index++) {
+        const RamServiceWorker *worker = &service_workers[index];
+
+        if (!worker->thread_id) {
+            continue;
+        }
+        total++;
+        if (worker->actor) {
+            if (!ram_owner_thread_known(worker->thread_id)) {
+                return -ESTALE;
+            }
+            joined++;
+        }
+    }
+    if (joined > 1 || (!!owner_closure.actor_pause != (joined == 1))) {
+        return -ESTALE;
+    }
+    *out = total - joined;
+    return 0;
+}
+
+static int ram_owner_check_kernel_threads(uint64_t *refused_thread_id)
+{
+    DIR *directory = opendir("/proc/self/task");
+    struct dirent *entry;
+    size_t observed = 0;
+    size_t expected = owner_closure.threads.thread_count;
+    int result = 0;
+
+    if (!directory) {
+        return -errno;
+    }
+    pthread_mutex_lock(&service_lock);
+    if (!service_frozen || service_failed ||
+        owner_closure.service_generation != service_generation) {
+        result = -ESTALE;
+        goto out;
+    }
+    result = ram_owner_physical_tasks(&expected);
+    if (result) {
+        goto out;
+    }
+    errno = 0;
+    while ((entry = readdir(directory))) {
+        char *end;
+        unsigned long long thread_id;
+
+        if (entry->d_name[0] == '.') {
+            continue;
+        }
+        thread_id = strtoull(entry->d_name, &end, 10);
+        if (!thread_id || *end || !ram_owner_thread_known(thread_id)) {
+            if (refused_thread_id) {
+                *refused_thread_id = thread_id;
+            }
+            result = -ENOTSUP;
+            goto out;
+        }
+        observed++;
+    }
+    result = errno ? -errno : observed == expected ? 0 : -ESTALE;
+out:
+    pthread_mutex_unlock(&service_lock);
+    closedir(directory);
+    return result;
+}
+
+static int ram_owner_descriptors(bool capture)
+{
+    DIR *directory = opendir("/proc/self/fd");
+    struct dirent *entry;
+    size_t observed = 0;
+    int result = 0;
+
+    if (!directory) {
+        return -errno;
+    }
+    errno = 0;
+    while ((entry = readdir(directory))) {
+        char *end;
+        long descriptor;
+        struct stat status;
+        int flags;
+        bool matched = false;
+
+        if (entry->d_name[0] == '.') {
+            continue;
+        }
+        descriptor = strtol(entry->d_name, &end, 10);
+        if (*end || descriptor < 0 || descriptor > INT_MAX) {
+            result = -EINVAL;
+            goto out;
+        }
+        if (descriptor == dirfd(directory)) {
+            continue;
+        }
+        flags = fcntl(descriptor, F_GETFL);
+        if (flags < 0 || fstat(descriptor, &status)) {
+            result = -errno;
+            goto out;
+        }
+        if (observed == RAM_OWNER_DESCRIPTORS_MAX) {
+            result = -E2BIG;
+            goto out;
+        }
+        if (capture) {
+            owner_closure.descriptors[observed] = (RamOwnerDescriptor) {
+                descriptor, status.st_dev, status.st_ino, status.st_mode, flags,
+            };
+        } else {
+            for (size_t index = 0; index < owner_closure.descriptor_count; index++) {
+                const RamOwnerDescriptor *saved = &owner_closure.descriptors[index];
+
+                matched |= saved->descriptor == descriptor &&
+                    saved->device == status.st_dev && saved->inode == status.st_ino &&
+                    saved->mode == status.st_mode && saved->flags == flags;
+            }
+            if (!matched) {
+                result = -ESTALE;
+                goto out;
+            }
+        }
+        observed++;
+        errno = 0;
+    }
+    result = errno ? -errno :
+        !capture && observed != owner_closure.descriptor_count ? -ESTALE : 0;
+    if (capture && result == 0) {
+        owner_closure.descriptor_count = observed;
+    }
+out:
+    closedir(directory);
+    return result;
+}
+
+typedef struct RamOwnerProcDirectory {
+    int descriptor;
+    uint8_t *scratch;
+    size_t capacity;
+    size_t cursor;
+    size_t available;
+} RamOwnerProcDirectory;
+
+/* Linux getdents64's record prefix is checked before borrowing its name. */
+_Static_assert(offsetof(struct dirent, d_reclen) == 16,
+               "getdents64 record length offset");
+_Static_assert(offsetof(struct dirent, d_name) == 19,
+               "getdents64 record name offset");
+
+static int ram_owner_proc_open(RamOwnerProcDirectory *directory,
+                               const char *path, uint8_t *scratch,
+                               size_t capacity)
+{
+    long descriptor;
+
+    if (!scratch || capacity < offsetof(struct dirent, d_name) + 1) {
+        return -EINVAL;
+    }
+    descriptor = syscall(SYS_openat, AT_FDCWD, path,
+                         O_RDONLY | O_NONBLOCK | O_DIRECTORY | O_CLOEXEC);
+    if (descriptor < 0) {
+        return -errno;
+    }
+    *directory = (RamOwnerProcDirectory) {
+        .descriptor = descriptor,
+        .scratch = scratch,
+        .capacity = capacity,
+    };
+    return 0;
+}
+
+/* The borrowed name remains valid only until the next refill or close. */
+static int ram_owner_proc_next(RamOwnerProcDirectory *directory,
+                               const char **name)
+{
+    const size_t name_offset = offsetof(struct dirent, d_name);
+    size_t remaining;
+    uint16_t record_bytes;
+    uint8_t *record;
+    size_t end;
+
+    *name = NULL;
+    if (directory->cursor == directory->available) {
+        int saved_errno = errno;
+        long bytes = syscall(SYS_getdents64, directory->descriptor,
+                             directory->scratch, directory->capacity);
+
+        if (bytes <= 0) {
+            /* Match readdir's deleted-directory EOF and saved errno rules. */
+            if (!bytes || errno == ENOENT) {
+                errno = saved_errno;
+                return 0;
+            }
+            return -errno;
+        }
+        if ((size_t)bytes > directory->capacity) {
+            return -EIO;
+        }
+        directory->available = bytes;
+        directory->cursor = 0;
+    }
+    remaining = directory->available - directory->cursor;
+    if (remaining < name_offset + 1) {
+        return -EIO;
+    }
+    record = directory->scratch + directory->cursor;
+    memcpy(&record_bytes, record + offsetof(struct dirent, d_reclen),
+           sizeof(record_bytes));
+    if (record_bytes < name_offset + 1 || record_bytes > remaining ||
+        record_bytes % sizeof(uint64_t)) {
+        return -EIO;
+    }
+    for (end = name_offset; end < record_bytes && record[end]; end++) {
+    }
+    if (end == record_bytes) {
+        return -EIO;
+    }
+    directory->cursor += record_bytes;
+    *name = (const char *)record + name_offset;
+    return 0;
+}
+
+/* A Linux close error must never cause a retry of a possibly reused number.
+ * Keep its evidence even when a preceding membership refusal remains first. */
+static int ram_owner_proc_close(RamOwnerProcDirectory *directory,
+                                int first_status, int *proc_close_status)
+{
+    int descriptor = directory->descriptor;
+    int close_status = 0;
+
+    directory->descriptor = -1;
+    if (syscall(SYS_close, descriptor) < 0) {
+        close_status = -errno;
+        if (!*proc_close_status) {
+            *proc_close_status = close_status;
+        }
+    }
+    return first_status ? first_status : close_status;
+}
+
+static int ram_owner_check_kernel_threads_with_scratch(
+    uint8_t *scratch, size_t capacity, int *proc_close_status)
+{
+    RamOwnerProcDirectory directory;
+    const char *name;
+    size_t observed = 0;
+    size_t expected = owner_closure.threads.thread_count;
+    int result = ram_owner_proc_open(&directory, "/proc/self/task",
+                                    scratch, capacity);
+
+    if (result) {
+        return result;
+    }
+    pthread_mutex_lock(&service_lock);
+    if (!service_frozen || service_failed ||
+        owner_closure.service_generation != service_generation) {
+        result = -ESTALE;
+        goto out;
+    }
+    result = ram_owner_physical_tasks(&expected);
+    if (result) {
+        goto out;
+    }
+    errno = 0;
+    while (!(result = ram_owner_proc_next(&directory, &name)) && name) {
+        char *end;
+        unsigned long long thread_id;
+
+        if (name[0] == '.') {
+            continue;
+        }
+        thread_id = strtoull(name, &end, 10);
+        if (!thread_id || *end) {
+            result = -ENOTSUP;
+            goto out;
+        }
+        if (!ram_owner_thread_known(thread_id)) {
+            result = -ENOTSUP;
+            goto out;
+        }
+        observed++;
+    }
+    if (!result) {
+        result = errno ? -errno : observed == expected ? 0 : -ESTALE;
+    }
+out:
+    pthread_mutex_unlock(&service_lock);
+    return ram_owner_proc_close(&directory, result, proc_close_status);
+}
+
+static int ram_owner_descriptors_with_scratch(
+    uint8_t *scratch, size_t capacity, int *proc_close_status)
+{
+    RamOwnerProcDirectory directory;
+    const char *name;
+    size_t observed = 0;
+    int result = ram_owner_proc_open(&directory, "/proc/self/fd",
+                                    scratch, capacity);
+
+    if (result) {
+        return result;
+    }
+    errno = 0;
+    while (!(result = ram_owner_proc_next(&directory, &name)) && name) {
+        char *end;
+        long descriptor;
+        struct stat status;
+        int flags;
+        bool matched = false;
+
+        if (name[0] == '.') {
+            continue;
+        }
+        descriptor = strtol(name, &end, 10);
+        if (*end || descriptor < 0 || descriptor > INT_MAX) {
+            result = -EINVAL;
+            goto out;
+        }
+        if (descriptor == directory.descriptor) {
+            continue;
+        }
+        flags = fcntl(descriptor, F_GETFL);
+        if (flags < 0 || fstat(descriptor, &status)) {
+            result = -errno;
+            goto out;
+        }
+        if (observed == RAM_OWNER_DESCRIPTORS_MAX) {
+            result = -E2BIG;
+            goto out;
+        }
+        for (size_t index = 0; index < owner_closure.descriptor_count; index++) {
+            const RamOwnerDescriptor *saved = &owner_closure.descriptors[index];
+
+            matched |= saved->descriptor == descriptor &&
+                saved->device == status.st_dev && saved->inode == status.st_ino &&
+                saved->mode == status.st_mode && saved->flags == flags;
+        }
+        if (!matched) {
+            result = -ESTALE;
+            goto out;
+        }
+        observed++;
+        errno = 0;
+    }
+    if (!result) {
+        result = errno ? -errno :
+            observed != owner_closure.descriptor_count ? -ESTALE : 0;
+    }
+out:
+    return ram_owner_proc_close(&directory, result, proc_close_status);
+}
+
+/* Called only after inventory-owned locks and borrower holds are released. */
+static void ram_owner_report_inventory_refusal(
+    const QemuThreadRamPauseRefusal *refusal, uint64_t kernel_thread_id)
+{
+    char diagnostic[192];
+    int printed;
+
+    if (refusal->present) {
+        printed = snprintf(diagnostic, sizeof(diagnostic),
+                           "crucible RAM inventory refusal: "
+                           "stage=native-disposition tid=%" PRId64
+                           " disposition=%u name-prefix-hex=%s\n",
+                           refusal->thread_id, refusal->disposition,
+                           refusal->name_prefix_hex);
+    } else if (kernel_thread_id) {
+        printed = snprintf(diagnostic, sizeof(diagnostic),
+                           "crucible RAM inventory refusal: "
+                           "stage=kernel-membership tid=%" PRIu64 "\n",
+                           kernel_thread_id);
+    } else {
+        return;
+    }
+
+    /* A bounded write can still block. Own no inventory lock or hold here;
+     * the original host Setup supervisor can contain/reap the whole process.
+     * Never change shared stderr flags or retry/renew the diagnostic attempt. */
+    if (printed > 0 && (size_t)printed < sizeof(diagnostic)) {
+        ssize_t written = write(STDERR_FILENO, diagnostic, printed);
+
+        (void)written;
+    }
+}
+
+int qemu_crucible_ram_owner_inventory(uint64_t *tasks, uint64_t *descriptors,
+                                     uint64_t *service_tasks)
+{
+    QemuPluginCrucibleHotForkBarrierInventory plugin;
+    QemuThreadRamPauseRefusal refusal = { 0 };
+    uint64_t refused_kernel_thread_id = 0;
+    uint64_t services = 0;
+    uint64_t observed_tasks = 0;
+    uint64_t observed_descriptors = 0;
+    Error *error = NULL;
+    int release;
+    int result;
+
+    if (!tasks || !descriptors || !service_tasks || !bql_locked() ||
+        owner_closure.token || owner_closure.returning ||
+        owner_closure.threads.end.uncertain ||
+        owner_closure.threads.active ||
+        owner_closure.plugin_owned || owner_closure.plugin_generation) {
+        return -EBUSY;
+    }
+    *tasks = 0;
+    *descriptors = 0;
+    *service_tasks = 0;
+
+    /* Positive pending is possible only at this pre-census gate. Outputs
+     * are still zero, and no AIO or subsystem/registry hold has started. */
+    result = qemu_plugin_crucible_ram_actor_pause_begin_inventory(
+        &owner_closure.actor_pause);
+    if (result) {
+        return result;
+    }
+
+    /* Early block graph opening precedes icount and can create native workers.
+     * Retire only drained home-context pools before taking borrower holds. */
+    if (!qemu_aio_hot_fork_prepare_thread_pools(&error)) {
+        error_free(error);
+        result = -EBUSY;
+        goto release_actor;
+    }
+
+    /* Initial admission runs before any vCPU under the boot fence. This is a
+     * plugin borrower hold, not a manufactured ordinary VMStop certificate. */
+    result = qemu_plugin_crucible_hot_fork_barrier(
+        QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_QUERY, &plugin);
+    if (result) {
+        goto release_actor;
+    }
+    owner_closure.plugin_owned =
+        !(plugin.status.flags & QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_FLAG_HELD);
+    result = qemu_plugin_crucible_hot_fork_barrier(
+        QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_HOLD, &plugin);
+    if (!result) {
+        result = ram_owner_plugin_membership(&plugin, true);
+    }
+    if (result) {
+        goto release_plugin;
+    }
+
+    pthread_mutex_lock(&service_lock);
+    if (service_frozen || service_failed) {
+        pthread_mutex_unlock(&service_lock);
+        result = -EBUSY;
+        goto release_plugin;
+    }
+    service_frozen = true;
+    owner_closure.service_generation = service_generation;
+    for (size_t index = 0; index < RAM_SERVICE_WORKERS_MAX; index++) {
+        services += service_workers[index].thread_id != 0;
+    }
+    pthread_mutex_unlock(&service_lock);
+
+    result = qemu_thread_ram_pause_begin_actor(&owner_closure.threads,
+        qemu_plugin_crucible_ram_actor_pause_binding(owner_closure.actor_pause));
+    if (result) {
+        refusal = owner_closure.threads.refusal;
+    } else {
+        result = ram_owner_check_kernel_threads(&refused_kernel_thread_id);
+    }
+    if (!result) {
+        result = ram_owner_descriptors(true);
+    }
+    if (!result) {
+        result = qemu_plugin_crucible_hot_fork_barrier(
+            QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_QUERY, &plugin);
+    }
+    if (!result) {
+        result = ram_owner_plugin_membership(&plugin, false);
+    }
+    if (!result) {
+        /* The report describes actual membership, not prospective capacity. */
+        size_t physical;
+
+        pthread_mutex_lock(&service_lock);
+        result = ram_owner_physical_tasks(&physical);
+        pthread_mutex_unlock(&service_lock);
+        if (!result) {
+            observed_tasks = physical;
+        }
+        observed_descriptors = owner_closure.descriptor_count;
+    }
+    owner_closure.returning = true;
+    if (owner_closure.threads.active) {
+        QemuRamPauseEndDisposition end = { 0 };
+
+        release = qemu_thread_ram_pause_end_v2(&owner_closure.threads, &end);
+        if (release) {
+            /* Admission refuses; the process retains this failed hold. */
+            return release;
+        }
+    }
+    pthread_mutex_lock(&service_lock);
+    service_frozen = false;
+    pthread_mutex_unlock(&service_lock);
+release_plugin:
+    owner_closure.returning = true;
+    if (owner_closure.plugin_owned) {
+        release = qemu_plugin_crucible_hot_fork_barrier(
+            QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_RELEASE, &plugin);
+        if (release ||
+            (plugin.status.flags & QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_FLAG_HELD)) {
+            /* Retain uncertain hold ownership; the process must be contained. */
+            return release ? release : -EBUSY;
+        }
+    }
+release_actor:
+    owner_closure.returning = true;
+    if (owner_closure.actor_pause) {
+        QemuRamPauseEndDisposition end = { 0 };
+
+        release = qemu_plugin_crucible_ram_actor_pause_end_v2(owner_closure.actor_pause, &end);
+        if (release || !end.complete) {
+            return release ? release : -EINPROGRESS;
+        }
+    }
+    owner_closure.actor_pause = NULL;
+    if (!result) {
+        *tasks = observed_tasks;
+        *descriptors = observed_descriptors;
+        *service_tasks = services;
+    }
+    memset(&owner_closure, 0, sizeof(owner_closure));
+    if (result == -ENOTSUP) {
+        ram_owner_report_inventory_refusal(&refusal, refused_kernel_thread_id);
+    }
+    return result;
+}
+
+int qemu_crucible_ram_observation_background_current_v1(uint64_t token)
+{
+    /* CPU admission is owned by the observation writer, but this collector's
+     * background producer still requires its genuine stopped owner. Running
+     * observation needs an independent pre-issued participant publisher; an
+     * inventory, BQL or parked CPU scope cannot substitute for that producer. */
+    return qemu_crucible_ram_owner_closure_current(token) &&
+        owner_closure.observation_borrowers == 1 ? 0 : -EBUSY;
+}
+
+int qemu_crucible_ram_observation_background_borrow_v1(uint64_t *token)
+{
+    if (!token || *token || !bql_locked()) {
+        return -EINVAL;
+    }
+    if (owner_closure.observation_borrowers ||
+        !qemu_crucible_ram_owner_closure_current(owner_closure.token)) {
+        return -EBUSY;
+    }
+    /* The existing participant owner cannot physically release its admission
+     * while this exact observation borrower is retained. No new issuer lives
+     * under replay and no census is promoted to authority. */
+    owner_closure.observation_borrowers = 1;
+    *token = owner_closure.token;
+    return 0;
+}
+
+int qemu_crucible_ram_observation_background_return_v1(uint64_t *token)
+{
+    if (!token || !*token || *token != owner_closure.token ||
+        owner_closure.process_id != getpid() ||
+        owner_closure.owner_thread_id != qemu_get_thread_id() ||
+        owner_closure.observation_borrowers != 1) {
+        return -ESTALE;
+    }
+    owner_closure.observation_borrowers = 0;
+    *token = 0;
+    return 0;
+}
+
+static int ram_owner_participant_current(void)
+{
+    uint64_t generation;
+    int status;
+
+    if (owner_closure.returning) {
+        return -ESTALE;
+    }
+    if (!owner_closure.resident_absence) {
+        return qemu_plugin_crucible_ram_actor_pause_current(owner_closure.actor_pause);
+    }
+    status = qemu_crucible_resident_service_absence_current_v1(
+        owner_closure.resident_absence, &generation);
+    if (status || generation != owner_closure.absence_generation) {
+        return status ? status : -ESTALE;
+    }
+    pthread_mutex_lock(&service_lock);
+    if (!owner_closure.service_owned || !service_frozen || service_failed ||
+        owner_closure.service_generation != service_generation) {
+        status = -ESTALE;
+    }
+    for (size_t index = 0; !status && index < RAM_SERVICE_WORKERS_MAX; index++) {
+        if (service_workers[index].thread_id) {
+            status = -ESTALE;
+        }
+    }
+    pthread_mutex_unlock(&service_lock);
+    return status;
+}
+
+bool qemu_crucible_ram_owner_closure_current(uint64_t token)
+{
+    return token && owner_closure.token == token &&
+        owner_closure.process_id == getpid() &&
+        owner_closure.owner_thread_id == qemu_get_thread_id() &&
+        owner_closure.threads.active && ram_owner_paused() &&
+        !ram_owner_participant_current();
+}
+
+int qemu_crucible_ram_owner_closure_validate(uint64_t token)
+{
+    QemuPluginCrucibleHotForkBarrierInventory plugin;
+    QemuRcuHotForkBarrierInventory rcu;
+    QemuAsyncWorkerHotForkBarrierInventory async;
+    QemuBlockBackendHotForkBarrierInventory block;
+    int result;
+
+    if (!token || owner_closure.token != token ||
+        owner_closure.process_id != getpid() ||
+        owner_closure.owner_thread_id != qemu_get_thread_id() ||
+        !ram_owner_paused()) {
+        return -EPERM;
+    }
+    result = ram_owner_participant_current();
+    if (result) {
+        return result;
+    }
+    result = qemu_thread_ram_pause_validate(&owner_closure.threads);
+    if (result) {
+        return result;
+    }
+    result = qemu_plugin_crucible_hot_fork_barrier(
+        QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_QUERY, &plugin);
+    if (result || ram_owner_plugin_membership(&plugin, false)) {
+        return result ? result : -ESTALE;
+    }
+    qemu_rcu_hot_fork_barrier(QEMU_RCU_HOT_FORK_BARRIER_QUERY, &rcu);
+    qemu_async_worker_hot_fork_barrier(QEMU_ASYNC_WORKER_HOT_FORK_BARRIER_QUERY, &async);
+    if (!rcu.quiescent || !async.quiescent ||
+        rcu.generation != owner_closure.rcu_generation ||
+        async.generation != owner_closure.async_generation) {
+        return -ESTALE;
+    }
+    if (!qemu_block_backend_hot_fork_barrier(
+            QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_QUERY, &block)) {
+        return -ENOTSUP;
+    }
+    result = block.quiescent && block.generation == owner_closure.block_generation ? 0 : -ESTALE;
+    qemu_block_backend_hot_fork_barrier_inventory_destroy(&block);
+    if (!result) {
+        result = ram_owner_check_kernel_threads(NULL);
+    }
+    if (!result) {
+        result = ram_owner_descriptors(false);
+    }
+    if (!result) {
+        result = qemu_plugin_crucible_hot_fork_barrier(
+            QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_QUERY, &plugin);
+    }
+    if (!result) {
+        result = ram_owner_plugin_membership(&plugin, false);
+    }
+    return result;
+}
+
+int qemu_crucible_ram_owner_closure_validate_with_scratch(
+    uint64_t token, uint8_t *scratch, size_t capacity, int *proc_close_status)
+{
+    QemuPluginCrucibleHotForkBarrierInventory plugin;
+    QemuRcuHotForkBarrierInventory rcu;
+    QemuAsyncWorkerHotForkBarrierInventory async;
+    QemuBlockBackendHotForkBarrierInventory block;
+    int result;
+
+    if (!scratch || capacity < offsetof(struct dirent, d_name) + 1 ||
+        !proc_close_status) {
+        return -EINVAL;
+    }
+    if (!token || owner_closure.token != token ||
+        owner_closure.process_id != getpid() ||
+        owner_closure.owner_thread_id != qemu_get_thread_id() ||
+        !ram_owner_paused()) {
+        return -EPERM;
+    }
+    result = ram_owner_participant_current();
+    if (result) {
+        return result;
+    }
+    result = qemu_thread_ram_pause_validate(&owner_closure.threads);
+    if (result) {
+        return result;
+    }
+    result = qemu_plugin_crucible_hot_fork_barrier(
+        QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_QUERY, &plugin);
+    if (result || ram_owner_plugin_membership(&plugin, false)) {
+        return result ? result : -ESTALE;
+    }
+    qemu_rcu_hot_fork_barrier(QEMU_RCU_HOT_FORK_BARRIER_QUERY, &rcu);
+    qemu_async_worker_hot_fork_barrier(QEMU_ASYNC_WORKER_HOT_FORK_BARRIER_QUERY, &async);
+    if (!rcu.quiescent || !async.quiescent ||
+        rcu.generation != owner_closure.rcu_generation ||
+        async.generation != owner_closure.async_generation) {
+        return -ESTALE;
+    }
+    if (!qemu_block_backend_hot_fork_barrier(
+            QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_QUERY, &block)) {
+        return -ENOTSUP;
+    }
+    result = block.quiescent && block.generation == owner_closure.block_generation ? 0 : -ESTALE;
+    qemu_block_backend_hot_fork_barrier_inventory_destroy(&block);
+    if (!result) {
+        result = ram_owner_check_kernel_threads_with_scratch(
+            scratch, capacity, proc_close_status);
+    }
+    if (!result) {
+        result = ram_owner_descriptors_with_scratch(
+            scratch, capacity, proc_close_status);
+    }
+    if (!result) {
+        result = qemu_plugin_crucible_hot_fork_barrier(
+            QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_QUERY, &plugin);
+    }
+    if (!result) {
+        result = ram_owner_plugin_membership(&plugin, false);
+    }
+    return result;
+}
+
+static bool ram_owner_end_overlap(const void *out, size_t bytes,
+                                  const void *field, size_t extent)
+{
+    uintptr_t start = (uintptr_t)out;
+    uintptr_t target = (uintptr_t)field;
+
+    return !out || bytes > UINTPTR_MAX - start ||
+        extent > UINTPTR_MAX - target ||
+        (start < target + extent && target < start + bytes);
+}
+
+int qemu_crucible_ram_owner_end_output_check_v1(
+    const struct qemu_plugin_crucible_ram_physical_end_v2 *out)
+{
+    int status = qemu_crucible_startup_source_output_span_check(out, sizeof(*out));
+
+    if (status) {
+        return status;
+    }
+    if ((uintptr_t)out % _Alignof(struct qemu_plugin_crucible_ram_physical_end_v2) ||
+        ram_owner_end_overlap(out, sizeof(*out), &owner_closure, sizeof(owner_closure)) ||
+        ram_owner_end_overlap(out, sizeof(*out), &owner_last_end, sizeof(owner_last_end)) ||
+        ram_owner_end_overlap(out, sizeof(*out), &service_lock, sizeof(service_lock)) ||
+        ram_owner_end_overlap(out, sizeof(*out), service_workers, sizeof(service_workers)) ||
+        ram_owner_end_overlap(out, sizeof(*out), &service_generation, sizeof(service_generation)) ||
+        ram_owner_end_overlap(out, sizeof(*out), &service_frozen, sizeof(service_frozen)) ||
+        ram_owner_end_overlap(out, sizeof(*out), &service_failed, sizeof(service_failed)) ||
+        ram_owner_end_overlap(out, sizeof(*out), &owner_token_counter, sizeof(owner_token_counter))) {
+        return -EINVAL;
+    }
+    /* The span is independent of all retained owners before this first read. */
+    return out->schema_version == 2 && out->struct_size == sizeof(*out) ? 0 : -EINVAL;
+}
+
+static void ram_owner_end_status(
+    struct qemu_plugin_crucible_ram_physical_end_v2 *end, unsigned index,
+    int status)
+{
+    struct qemu_plugin_crucible_ram_release_step_v1 *step = &end->stage[index];
+    uint64_t bit = UINT64_C(1) << index;
+
+    step->last_status = status;
+    if (!step->first_status) {
+        step->first_status = status;
+    }
+    if (!end->first_status) {
+        end->first_status = status;
+    }
+    end->last_status = status;
+    end->attempted_mask |= step->entered ? bit : 0;
+    end->released_mask |= step->released ? bit : 0;
+    end->complete_mask |= step->complete ? bit : 0;
+    /* Only actual returned facts reach this update. A settled
+     * uncertain stage is refused before another attempt, so this can resolve
+     * only the write-ahead uncertainty of this same active callout. */
+    end->uncertain_mask = (end->uncertain_mask & ~bit) |
+        (step->uncertain ? bit : 0);
+    end->effects_complete = (end->released_mask & end->required_mask) == end->required_mask;
+    end->return_complete = !end->uncertain_mask &&
+        (end->complete_mask & end->required_mask) == end->required_mask;
+}
+
+static void ram_owner_end_native(
+    struct qemu_plugin_crucible_ram_release_step_v1 *step,
+    const QemuRamPauseEndDisposition *native)
+{
+    /* These are producer facts, never inferred from the callback's status. */
+    step->released = native->released;
+    step->complete = native->complete;
+    step->uncertain = native->uncertain;
+    step->effect_status = native->effect_status;
+    step->post_status = native->notify_status;
+    step->post_entered = native->notify_entered;
+    step->post_returned = native->notify_returned;
+    step->post_complete = native->notify_returned && !native->notify_status;
+    step->unlock_status = native->unlock_status;
+}
+
+int qemu_crucible_ram_owner_closure_end_observe_v1(
+    uint64_t token, struct qemu_plugin_crucible_ram_physical_end_v2 *out)
+{
+    int status;
+
+    if (!token || !bql_locked() || qemu_in_coroutine()) {
+        return -EPERM;
+    }
+    status = qemu_crucible_ram_owner_end_output_check_v1(out);
+    if (status) {
+        return status;
+    }
+    if (owner_closure.token == token && owner_closure.process_id == getpid() &&
+        owner_closure.owner_thread_id == qemu_get_thread_id()) {
+        *out = owner_closure.end;
+        return 0;
+    }
+    if (owner_last_end.end.token != token ||
+        owner_last_end.process_id != getpid() ||
+        owner_last_end.owner_thread_id != qemu_get_thread_id()) {
+        return -ESTALE;
+    }
+    *out = owner_last_end.end;
+    return 0;
+}
+
+int qemu_crucible_ram_owner_closure_end_v2(
+    uint64_t token, struct qemu_plugin_crucible_ram_physical_end_v2 *out)
+{
+    struct qemu_plugin_crucible_ram_physical_end_v2 *end = &owner_closure.end;
+    QemuPluginCrucibleHotForkBarrierInventory plugin;
+    QemuRcuHotForkBarrierInventory rcu;
+    QemuAsyncWorkerHotForkBarrierInventory async;
+    int result;
+
+    if (!qemu_in_main_thread() || !token || owner_closure.token != token ||
+        owner_closure.process_id != getpid() ||
+        owner_closure.owner_thread_id != qemu_get_thread_id() ||
+        !bql_locked() || qemu_in_coroutine()) {
+        return -EPERM;
+    }
+    result = qemu_crucible_ram_owner_end_output_check_v1(out);
+    if (result) {
+        return result;
+    }
+    if (owner_closure.end_active) {
+        /* The retained provider may synchronously reenter on this same Main.
+         * Observe its write-ahead journal without replaying or clearing it. */
+        *out = *end;
+        return -EINPROGRESS;
+    }
+    if (owner_closure.observation_borrowers) {
+        return -EBUSY;
+    }
+    owner_closure.end_active = true;
+    if (!end->entered) {
+        const bool required[QEMU_PLUGIN_CRUCIBLE_RAM_END_STAGE_COUNT] = {
+            [QEMU_PLUGIN_CRUCIBLE_RAM_END_THREADS] = owner_closure.threads.active,
+            [QEMU_PLUGIN_CRUCIBLE_RAM_END_PLUGIN] = owner_closure.plugin_owned,
+            [QEMU_PLUGIN_CRUCIBLE_RAM_END_AIO] = owner_closure.async_owned,
+            [QEMU_PLUGIN_CRUCIBLE_RAM_END_RCU] = owner_closure.rcu_owned,
+            [QEMU_PLUGIN_CRUCIBLE_RAM_END_BLOCK] = owner_closure.block_owned,
+            [QEMU_PLUGIN_CRUCIBLE_RAM_END_SERVICE] = owner_closure.service_owned,
+            [QEMU_PLUGIN_CRUCIBLE_RAM_END_ACTOR] =
+                !owner_closure.resident_absence && owner_closure.actor_pause,
+        };
+
+        for (unsigned index = 0; index < G_N_ELEMENTS(required); index++) {
+            if (required[index]) {
+                end->required_mask |= UINT64_C(1) << index;
+            }
+        }
+        end->entered = true;
+        /* End admission revokes exclusion before the first release. A retained
+         * token is now only this incarnation's cleanup/observation identity. */
+        owner_closure.returning = true;
+        end->exclusion_revoked = true;
+    }
+    for (unsigned index = 0; index < QEMU_PLUGIN_CRUCIBLE_RAM_END_STAGE_COUNT; index++) {
+        struct qemu_plugin_crucible_ram_release_step_v1 *step = &end->stage[index];
+        QemuRamPauseEndDisposition native = { 0 };
+
+        if (!(end->required_mask & (UINT64_C(1) << index)) || step->complete) {
+            continue;
+        }
+        if (step->uncertain || step->released) {
+            /* Never replay a committed or unobservable release. Containment
+             * is external; observation cannot turn this into a healthy hold. */
+            result = step->last_status ? step->last_status : -EINPROGRESS;
+            goto out;
+        }
+        if (step->attempts == UINT64_MAX) {
+            ram_owner_end_status(end, index, -EOVERFLOW);
+            result = -EOVERFLOW;
+            goto out;
+        }
+        step->attempts++;
+        step->entered = true;
+        end->attempted_mask |= UINT64_C(1) << index;
+        /* Publish unresolved effects/posts before any producer callout. Only
+         * that actual return may resolve this stage; reentry cannot retry it. */
+        step->uncertain = true;
+        end->uncertain_mask |= UINT64_C(1) << index;
+        end->return_complete = false;
+        result = 0;
+        switch (index) {
+        case QEMU_PLUGIN_CRUCIBLE_RAM_END_THREADS:
+            result = qemu_thread_ram_pause_end_v2(&owner_closure.threads, &native);
+            ram_owner_end_native(step, &native);
+            if (!native.entered) {
+                step->effect_status = result;
+            }
+            break;
+        case QEMU_PLUGIN_CRUCIBLE_RAM_END_PLUGIN:
+            result = qemu_plugin_crucible_hot_fork_barrier(
+                QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_RELEASE, &plugin);
+            if (!result && (plugin.status.flags & QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_FLAG_HELD)) {
+                result = -EBUSY;
+            }
+            step->effect_status = result;
+            step->released = step->complete = !result;
+            /* This provider has no negative-effect receipt. Do not retry it. */
+            step->uncertain = result != 0;
+            if (step->complete) {
+                owner_closure.plugin_owned = false;
+            }
+            break;
+        case QEMU_PLUGIN_CRUCIBLE_RAM_END_AIO:
+            qemu_async_worker_hot_fork_barrier(QEMU_ASYNC_WORKER_HOT_FORK_BARRIER_RELEASE, &async);
+            result = async.held ? -EBUSY : 0;
+            step->effect_status = result;
+            step->released = step->complete = !result;
+            step->uncertain = result != 0;
+            if (step->complete) {
+                owner_closure.async_owned = false;
+            }
+            break;
+        case QEMU_PLUGIN_CRUCIBLE_RAM_END_RCU:
+            qemu_rcu_hot_fork_barrier(QEMU_RCU_HOT_FORK_BARRIER_RELEASE, &rcu);
+            result = rcu.held ? -EBUSY : 0;
+            step->effect_status = result;
+            step->released = step->complete = !result;
+            step->uncertain = result != 0;
+            if (step->complete) {
+                owner_closure.rcu_owned = false;
+            }
+            break;
+        case QEMU_PLUGIN_CRUCIBLE_RAM_END_BLOCK:
+            if (!qemu_block_backend_hot_fork_barrier(
+                    QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_RELEASE,
+                    &owner_closure.block_end_inventory)) {
+                result = -EBUSY;
+            } else {
+                result = owner_closure.block_end_inventory.held ? -EBUSY : 0;
+            }
+            /* Retain the provider's returned effect BEFORE its report cleanup
+             * can call out. The actual report remains in paid owner storage. */
+            step->effect_status = result;
+            step->released = !result;
+            if (step->released) {
+                owner_closure.block_owned = false;
+            }
+            ram_owner_end_status(end, index, result);
+            step->post_entered = true;
+            qemu_block_backend_hot_fork_barrier_inventory_destroy(
+                &owner_closure.block_end_inventory);
+            step->post_returned = true;
+            /* The real destructor clears these owning fields only after free.
+             * Its void refusal exposes no errno; retained ownership is an
+             * observed incomplete post, never evidence permitting replay. */
+            step->post_status =
+                owner_closure.block_end_inventory.snapshot_roots ||
+                owner_closure.block_end_inventory.snapshot_storage.request ?
+                -EINPROGRESS : 0;
+            step->post_complete = !step->post_status;
+            step->complete = step->released && step->post_complete;
+            step->uncertain = result || !step->post_complete;
+            result = result ? result : step->post_status;
+            break;
+        case QEMU_PLUGIN_CRUCIBLE_RAM_END_SERVICE:
+            result = pthread_mutex_lock(&service_lock);
+            step->effect_status = result ? -result : 0;
+            if (!result) {
+                service_frozen = false;
+                owner_closure.service_owned = false;
+                step->released = true;
+                ram_owner_end_status(end, index, 0);
+                step->post_entered = true;
+                step->unlock_status = -pthread_mutex_unlock(&service_lock);
+                step->post_returned = true;
+                step->post_status = step->unlock_status;
+                step->post_complete = !step->post_status;
+                step->uncertain = !step->post_complete;
+                step->complete = step->post_complete;
+            } else {
+                /* This static non-robust mutex refused before gate effects. */
+                step->uncertain = false;
+            }
+            result = step->effect_status ? step->effect_status : step->unlock_status;
+            break;
+        case QEMU_PLUGIN_CRUCIBLE_RAM_END_ACTOR:
+            result = qemu_plugin_crucible_ram_actor_pause_end_v2(
+                owner_closure.actor_pause, &native);
+            ram_owner_end_native(step, &native);
+            if (!native.entered) {
+                step->effect_status = result;
+            }
+            break;
+        default:
+            result = -EPROTO;
+            step->effect_status = result;
+            step->uncertain = true;
+            break;
+        }
+        if (!result && !step->complete) {
+            result = -EPROTO;
+            step->uncertain = true;
+        }
+        ram_owner_end_status(end, index, result);
+        if (result || !step->complete) {
+            result = result ? result : -EINPROGRESS;
+            goto out;
+        }
+    }
+    end->effects_complete = end->return_complete = true;
+    end->last_status = 0;
+    result = 0;
+out:
+    *out = *end;
+    if (end->return_complete) {
+        /* Physical completion consumes canonical custody independently of
+         * negative status/history. Keep its exact terminal observation. */
+        owner_last_end.process_id = owner_closure.process_id;
+        owner_last_end.owner_thread_id = owner_closure.owner_thread_id;
+        owner_last_end.end = *end;
+        memset(&owner_closure, 0, sizeof(owner_closure));
+    } else {
+        owner_closure.end_active = false;
+    }
+    return result;
+}
+
+static int ram_owner_closure_begin(
+    QemuCrucibleResidentServiceAbsence *absence, uint64_t *token,
+    int *first_status, int *cleanup_status)
+{
+    QemuPluginCrucibleHotForkBarrierInventory plugin;
+    QemuRcuHotForkBarrierInventory rcu;
+    QemuAsyncWorkerHotForkBarrierInventory async;
+    QemuBlockBackendHotForkBarrierInventory block;
+    uint64_t absence_generation = 0;
+    int result;
+
+    if (!token || owner_closure.token || owner_closure.returning ||
+        owner_closure.threads.end.uncertain ||
+        owner_closure.threads.active ||
+        owner_closure.plugin_owned || owner_closure.plugin_generation ||
+        !ram_owner_paused()) {
+        return -EBUSY;
+    }
+    *token = 0;
+    if (owner_token_counter == UINT64_MAX) {
+        return -EOVERFLOW;
+    }
+    result = absence ? qemu_crucible_resident_service_absence_current_v1(
+        absence, &absence_generation) :
+        qemu_plugin_crucible_ram_actor_pause_begin(&owner_closure.actor_pause);
+    if (result) {
+        return result;
+    }
+    owner_closure.token = ++owner_token_counter;
+    owner_closure.end = (struct qemu_plugin_crucible_ram_physical_end_v2) {
+        .schema_version = 2,
+        .struct_size = sizeof(owner_closure.end),
+        .token = owner_closure.token,
+    };
+    memset(&owner_last_end, 0, sizeof(owner_last_end));
+    owner_closure.process_id = getpid();
+    owner_closure.owner_thread_id = qemu_get_thread_id();
+    owner_closure.resident_absence = absence;
+    owner_closure.absence_generation = absence_generation;
+    *token = owner_closure.token;
+    pthread_mutex_lock(&service_lock);
+    if (service_frozen || service_failed) {
+        pthread_mutex_unlock(&service_lock);
+        result = -EBUSY;
+        goto fail;
+    }
+    service_frozen = true;
+    owner_closure.service_owned = true;
+    owner_closure.service_generation = service_generation;
+    if (absence) {
+        for (size_t index = 0; index < RAM_SERVICE_WORKERS_MAX; index++) {
+            if (service_workers[index].thread_id) {
+                pthread_mutex_unlock(&service_lock);
+                result = -EBUSY;
+                goto fail;
+            }
+        }
+    }
+    pthread_mutex_unlock(&service_lock);
+
+    /* Drain block users before closing completion admission. Never wait here. */
+    if (!qemu_block_backend_hot_fork_barrier(
+            QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_QUERY, &block)) {
+        result = -ENOTSUP;
+        goto fail;
+    }
+    if (block.held && block.owner_thread_id != qemu_get_thread_id()) {
+        qemu_block_backend_hot_fork_barrier_inventory_destroy(&block);
+        result = -EPERM;
+        goto fail;
+    }
+    owner_closure.block_owned = !block.held;
+    qemu_block_backend_hot_fork_barrier_inventory_destroy(&block);
+    if (!qemu_block_backend_hot_fork_barrier(
+            QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_HOLD, &block)) {
+        result = -ENOTSUP;
+        goto fail;
+    }
+    owner_closure.block_generation = block.generation;
+    result = block.quiescent ? 0 : -EAGAIN;
+    qemu_block_backend_hot_fork_barrier_inventory_destroy(&block);
+    if (result) {
+        goto fail;
+    }
+    /* Idle generic AIO workers lack borrower ownership; retire them before holds. */
+    if (!qemu_aio_hot_fork_thread_pools_empty() &&
+        !qemu_aio_hot_fork_prepare_thread_pools(NULL)) {
+        result = -ENOTSUP;
+        goto fail;
+    }
+    qemu_rcu_hot_fork_barrier(QEMU_RCU_HOT_FORK_BARRIER_QUERY, &rcu);
+    if (rcu.held && rcu.owner_thread_id != qemu_get_thread_id()) {
+        result = -EPERM;
+        goto fail;
+    }
+    owner_closure.rcu_owned = !rcu.held;
+    qemu_rcu_hot_fork_barrier(QEMU_RCU_HOT_FORK_BARRIER_HOLD, &rcu);
+    owner_closure.rcu_generation = rcu.generation;
+    qemu_async_worker_hot_fork_barrier(QEMU_ASYNC_WORKER_HOT_FORK_BARRIER_QUERY, &async);
+    if (async.held && async.owner_thread_id != qemu_get_thread_id()) {
+        result = -EPERM;
+        goto fail;
+    }
+    owner_closure.async_owned = !async.held;
+    qemu_async_worker_hot_fork_barrier(QEMU_ASYNC_WORKER_HOT_FORK_BARRIER_HOLD, &async);
+    owner_closure.async_generation = async.generation;
+    result = qemu_plugin_crucible_hot_fork_barrier(
+        QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_QUERY, &plugin);
+    if (result) {
+        goto fail;
+    }
+    owner_closure.plugin_owned = !(plugin.status.flags & QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_FLAG_HELD);
+    result = qemu_plugin_crucible_hot_fork_barrier(
+        QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_HOLD, &plugin);
+    if (result) {
+        goto fail;
+    }
+    owner_closure.plugin_generation = plugin.generation;
+    if (!rcu.quiescent || !async.quiescent || !ram_plugin_quiescent(&plugin)) {
+        result = -EAGAIN;
+        goto fail;
+    }
+    result = ram_owner_plugin_membership(&plugin, true);
+    if (result) {
+        goto fail;
+    }
+    result = qemu_thread_ram_pause_begin_actor(&owner_closure.threads,
+        qemu_plugin_crucible_ram_actor_pause_binding(owner_closure.actor_pause));
+    if (!result) {
+        result = ram_owner_check_kernel_threads(NULL);
+    }
+    if (!result) {
+        result = ram_owner_descriptors(true);
+    }
+    if (!result) {
+        result = qemu_crucible_ram_owner_closure_validate(*token);
+    }
+    if (!result) {
+        return 0;
+    }
+fail:
+    {
+        struct qemu_plugin_crucible_ram_physical_end_v2 end = {
+            .schema_version = 2, .struct_size = sizeof(end),
+        };
+        int release = qemu_crucible_ram_owner_closure_end_v2(*token, &end);
+
+        if (first_status) {
+            *first_status = result;
+        }
+        if (cleanup_status) {
