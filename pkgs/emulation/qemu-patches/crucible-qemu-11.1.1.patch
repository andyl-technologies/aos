+        s->queue_count < 0 || s->queue_count > PACKET_QUEUE_SIZE ||
+        s->queue_head !=
+            (s->queue_tail + s->queue_count) % PACKET_QUEUE_SIZE ||
+        s->flushing_queue) {
+        return -EINVAL;
+    }
+    for (size_t index = 0; index < PACKET_QUEUE_SIZE; index++) {
+        size_t length = s->packet_queue_len[index];
