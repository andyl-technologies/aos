+        &receiver->module_original, &receiver->module_original_serial,
+        &receiver->module_advance, &receiver->module_advance_serial,
+        disposition, member->component->userdata);
+    receiver->enter_returned = true;
+    /* A physical Original move can precede failed Advance birth. Save it and
+     * its canonical-field receipt before any independent post or validation. */
+    receiver->original_moved = disposition->original_moved == 1;
+    receiver->original_at_move = receiver->module_original;
+    receiver->original_moved_serial = receiver->module_original_serial;
+    receiver->advance_at_birth = receiver->module_advance;
+    receiver->advance_birth_serial = receiver->module_advance_serial;
+    advance_callback_end(receiver);
+    if (!advance_enter_disposition_syntax(disposition)) {
+        receiver->uncertain = true;
+        return first ? (first > 0 ? -EPROTO : first) : -EPROTO;
+    }
+    if (!first) {
+        first = disposition->first_status ? disposition->first_status :
+            disposition->post_status;
+    }
+    if (!first && (!receiver->original_moved || disposition->known_absent ||
+        !receiver->module_original || !receiver->module_original_serial ||
+        receiver->module_original_serial == UINT64_MAX || !receiver->module_advance ||
+        !receiver->module_advance_serial || receiver->module_advance_serial == UINT64_MAX)) {
+        receiver->uncertain = true;
+        first = -EPROTO;
+    }
+    return first > 0 ? -EPROTO : first;
+}
+
+static int advance_receiver_drop_read(QemuCrucibleSourceAdvanceReceiver *receiver)
+{
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    int status = advance_receiver_identity(receiver);
+
+    if (status) {
+        return status;
+    }
+    if (!pending_constructor_closed() || startup_source.pending_command_lender.held ||
+        receiver->recipient ||
+        (receiver->acquire_entered && !receiver->recipient_closed) ||
+        receiver->enter_attempted || !advance_module_outputs_absent(receiver) ||
+        (receiver->callback.entered && !receiver->callback.returned)) {
+        return -EBUSY;
+    }
+    qemu_mutex_lock(&commands->mutex);
+    /* This read never consumed a producer borrower. Physical local return
+     * drops only the exact Source/service references, irrespective of first. */
+    receiver->service->advance_users--;
+    receiver->member->advance_users--;
+    *receiver->holder = NULL;
+    receiver->held = false;
+    qemu_mutex_unlock(&commands->mutex);
+    return 0;
+}
+/* Native independently reobserves the full retained protocol and lender
+ * cohort after module return. Optional module observations cannot replace
+ * either cut, and a negative native first never skips the independent post. */
+static int advance_receiver_protocol_post(
+    QemuCrucibleSourceAdvanceReceiver *receiver,
+    int *native_post, int *recipient_post, int *cohort_post, int *publication_final)
+{
+    *native_post = qemu_plugin_crucible_native_advance_entry_current_v1(
+        receiver->main, receiver->control);
+    *recipient_post = qemu_crucible_preexec_publisher_recipient_current_v1(
+        receiver->lender, receiver->recipient, receiver);
+    *cohort_post = advance_receiver_identity(receiver);
+    if (!*cohort_post) {
+        *cohort_post = advance_publication_current(receiver);
+    }
+    *publication_final = qemu_crucible_preexec_publisher_recipient_current_v1(
+        receiver->lender, receiver->recipient, receiver);
+    return *native_post ? *native_post : *recipient_post ? *recipient_post :
+        *cohort_post ? *cohort_post : *publication_final;
+}
+
+/* A later real control return can observe terminal consumption, but cannot
+ * reopen semantic work or reuse the original Main's operation permission. */
+static int advance_receiver_observe_no_birth_terminal(
+    QemuCrucibleSourceAdvanceReceiver *receiver,
+    QemuCrucibleNativeInvocationTicket *main,
+    QemuCrucibleNativeInvocationTicket *control)
+{
+    QemuCrucibleAdvanceNoBirthTail *tail = &receiver->no_birth_tail;
+    int status = advance_receiver_identity(receiver);
+
+    if (status) {
+        return status;
+    }
+    if (!pending_constructor_no_birth() || !receiver->main_returned ||
+        !receiver->recipient || receiver->enter_attempted ||
+        (!receiver->module_not_entered && !receiver->acquire_absent) ||
+        !tail->returned ||
+        receiver->next_tail_serial >= UINT64_MAX - 1) {
+        return -EBUSY;
+    }
+    *tail = (QemuCrucibleAdvanceNoBirthTail) {
+        .receiver = receiver,
+        .main = main,
+        .control = control,
+        .serial = ++receiver->next_tail_serial,
+        .phase = QEMU_CRUCIBLE_ADVANCE_NO_BIRTH_TERMINAL_CLOSE,
+        .entered = true,
+    };
+    status = qemu_crucible_preexec_publisher_recipient_no_birth_close_v1(
+        receiver->lender, receiver->recipient, receiver,
+        receiver->first_status, receiver->post_status);
+    tail->returned = true;
+    receiver->physical_status = status;
+    if (!receiver->physical_first_status && status) {
+        receiver->physical_first_status = status;
+    }
+    if (!status && !receiver->recipient) {
+        receiver->recipient_closed = true;
+        receiver->physical_status = advance_receiver_drop_read(receiver);
+    }
+    return receiver->physical_status;
+}
+#endif
+
+int qemu_crucible_source_advance_pending_prepare_v1(
+    QemuCrucibleCommandConsumerMember *requested_member,
+    QemuCrucibleNativeInvocationTicket *main,
+    QemuCrucibleNativeInvocationTicket *control)
+{
+#if defined(CONFIG_LINUX) && defined(__x86_64__) && !defined(__ILP32__)
+    QemuCrucibleSourceAdvanceReceiver *receiver = &startup_source.advance_receiver;
+    QemuCrucibleSourcePendingCommandLender *pending =
+        &startup_source.pending_command_lender;
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    QemuCrucibleCommandConsumerMember *member = &startup_source.command_member;
+    QemuCruciblePublisherModuleService *service = &startup_source.publisher_module;
+    QemuThread thread;
+    uint64_t serial;
+    int first;
+    int post;
+
+    if (requested_member != member) {
+        return -EPERM;
+    }
+    /* A registered callback must request its genuine pending constructor. */
+    if (command_member_advance_callbacks_absent(&member->advance)) {
+        return -ENOTSUP;
+    }
+    first = qemu_plugin_crucible_native_advance_entry_current_v1(main, control);
+    if (first) {
+        return first;
+    }
+    if (pending->canonical_owner != pending ||
+        !pending->attempted ||
+        pending->held ||
+        pending->consumed ||
+        pending->receiver != receiver ||
+        pending->main_serial != main->serial ||
+        pending->control_serial != control->serial) {
+        return -EPERM;
+    }
+    if (receiver->held || startup_source.pending_offer_read.busy) {
+        return -EBUSY;
+    }
+    qemu_thread_get_self(&thread);
+    qemu_mutex_lock(&commands->mutex);
+    first = command_member_live_locked(member);
+    if (!first) {
+        first = publisher_service_runtime_identity_locked(service);
+    }
+    if (!first && (receiver->held || startup_source.advance_holder ||
+        member->advance_users || service->advance_users || service->closing ||
+        service->transition_active || service->transfer_first_status ||
+        service->transfer_post_status || service->transfer_identity_status ||
+        member->child_owner != service->runtime_owner ||
+        !command_member_advance_callbacks_valid(&member->advance) ||
+        !command_member_advance_receiver_callbacks_valid(&member->advance_receiver))) {
+        first = -EBUSY;
+    }
+    serial = receiver->serial;
+    if (!first && serial >= UINT64_MAX - 1) {
+        first = -EOVERFLOW;
+    }
+    if (!first) {
+        *receiver = (QemuCrucibleSourceAdvanceReceiver) {
+            .canonical_owner = receiver,
+            .holder = &startup_source.advance_holder,
+            .member = member,
+            .service = service,
+            .lender = member->publisher_lender,
+            .main = main,
+            .control = control,
+            .thread = thread,
+            .process = getpid(),
+            .serial = serial + 1,
+            .attempted = true,
+            .held = true,
+        };
+        /* Real physical cleanup parents precede the bounded read and CAS.
+         * Their debts persist through partial birth and every negative post. */
+        member->advance_users++;
+        service->advance_users++;
+        startup_source.advance_holder = receiver;
+    }
+    qemu_mutex_unlock(&commands->mutex);
+    if (first) {
+        return first;
+    }
+    first = qemu_crucible_preexec_publisher_recipient_acquire_v1(
+        receiver->lender, receiver, &receiver->recipient, &receiver->publication);
+    if (!first) {
+        first = advance_binding_install(receiver);
+    }
+    /* This physical Main post neither substitutes for module Original post nor
+     * erases the acquired protocol borrower if any semantic check refused. */
+    if (receiver->recipient) {
+        post = advance_receiver_protocol_post(receiver,
+            &pending->prepare_native_post_status,
+            &pending->prepare_recipient_post_status,
+            &pending->prepare_cohort_post_status,
+            &pending->prepare_publication_final_status);
+    } else {
+        post = qemu_plugin_crucible_native_advance_entry_current_v1(main, control);
+        pending->prepare_native_post_status = post;
+    }
+    pending->prepare_first_status = first;
+    pending->prepare_post_status = post;
+    receiver->first_status = first;
+    receiver->post_status = post;
+    if (!receiver->recipient && !receiver->acquire_entered && !receiver->enter_attempted) {
+        receiver->physical_status = advance_receiver_drop_read(receiver);
+    }
+    return first ? first : post ? post : receiver->physical_status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_crucible_source_advance_receive_v1(
+    QemuCrucibleNativeInvocationTicket *main,
+    QemuCrucibleNativeInvocationTicket *control)
+{
+#if defined(CONFIG_LINUX) && defined(__x86_64__) && !defined(__ILP32__)
+    QemuCrucibleSourceAdvanceReceiver *receiver = &startup_source.advance_receiver;
+    QemuCrucibleSourcePendingCommandLender *pending =
+        &startup_source.pending_command_lender;
+    int first;
+    int post;
+
+    if (command_member_advance_callbacks_absent(&startup_source.command_member.advance)) {
+        return 0;
+    }
+    first = qemu_plugin_crucible_native_advance_entry_current_v1(main, control);
+    if (first) {
+        return first;
+    }
+    if (receiver->held && receiver->main_returned) {
+        return advance_receiver_observe_no_birth_terminal(receiver, main, control);
+    }
+    /* A missing pending constructor is known before any new physical child.
+     * The earlier ordinary callback alone can acquire this recipient; receive
+     * never substitutes a later CAS or creates a semantic operation. */
+    if (!receiver->held) {
+        return -ENOKEY;
+    }
+    if (receiver->main != main || receiver->control != control ||
+        pending->receiver != receiver || !pending->attempted ||
+        !pending->producer_returned || receiver->acquire_entered) {
+        return -EPERM;
+    }
+    first = receiver->first_status ? receiver->first_status : receiver->post_status;
+    if (!first) {
+        first = pending->first_status ? pending->first_status : pending->post_status;
+    }
+    if (!first) {
+        first = pending_constructor_receive_current(receiver);
+    }
+    if (!first && pending->held && !pending->return_attempted && !pending->consumed) {
+        first = advance_module_acquire(receiver);
+        if (!first) {
+            first = advance_module_enter(receiver);
+        }
+    } else {
+        /* No registered acquire body ran. A held pending lender still blocks
+         * factual protocol return; this fact cannot erase its module debt. */
+        receiver->module_not_entered = true;
+        if (!first) {
+            first = -ENOKEY;
+        }
+    }
+    post = advance_receiver_protocol_post(receiver,
+        &receiver->receive_native_post_status,
+        &receiver->receive_recipient_post_status,
+        &receiver->receive_cohort_post_status,
+        &receiver->receive_publication_final_status);
+    if (!receiver->first_status) {
+        receiver->first_status = first;
+    }
+    if (!receiver->post_status) {
+        receiver->post_status = post;
+    }
+    return first ? first : post;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+/* Factual no-birth tail of this same physically entered Main. It cannot
+ * enter module work, wait, create an Original or reuse Setup permission. */
+int qemu_crucible_source_advance_no_birth_current_v1(
+    QemuCrucibleSourceAdvanceReceiver *receiver,
+    QemuCruciblePublisherSessionLender *lender,
+    QemuCruciblePublisherRecipient *recipient, int first, int post)
+{
+#if defined(CONFIG_LINUX) && defined(__x86_64__) && !defined(__ILP32__)
+    QemuCrucibleAdvanceNoBirthTail *tail;
+    int status = advance_receiver_identity(receiver);
+
+    if (status) {
+        return status;
+    }
+    tail = &receiver->no_birth_tail;
+    if (!pending_constructor_no_birth() || startup_source.pending_command_lender.held ||
+        lender != receiver->lender || recipient != receiver->recipient || !recipient ||
+        first != receiver->first_status || post != receiver->post_status ||
+        tail->receiver != receiver || !tail->main || !tail->control ||
+        !tail->entered || tail->returned ||
+        !tail->serial || tail->serial != receiver->next_tail_serial ||
+        tail->serial == UINT64_MAX || receiver->uncertain ||
+        (tail->phase != QEMU_CRUCIBLE_ADVANCE_NO_BIRTH_RETURN_REQUEST &&
+         tail->phase != QEMU_CRUCIBLE_ADVANCE_NO_BIRTH_TERMINAL_CLOSE) ||
+        (tail->phase == QEMU_CRUCIBLE_ADVANCE_NO_BIRTH_RETURN_REQUEST && (receiver->main_returned ||
+            tail->main != receiver->main || tail->control != receiver->control)) ||
+        (tail->phase == QEMU_CRUCIBLE_ADVANCE_NO_BIRTH_TERMINAL_CLOSE &&
+         !receiver->main_returned) ||
+        receiver->enter_attempted || receiver->original_moved || receiver->entry.held ||
+        receiver->command_borrow.held || !advance_module_outputs_absent(receiver) ||
+        (receiver->callback.entered && !receiver->callback.returned)) {
+        return -EPERM;
+    }
+    if (receiver->module_not_entered) {
+        if (receiver->acquire_entered || receiver->acquire_returned ||
+            receiver->acquire_frame_serial) {
+            return -ESTALE;
+        }
+    } else if (!receiver->acquire_entered || !receiver->acquire_returned ||
+               !receiver->acquire_absent || !receiver->acquire_first_absent ||
+               !receiver->acquire_post_absent || !receiver->acquire_frame_serial ||
+               receiver->acquire_status >= 0 || receiver->acquire_post_status >= 0 ||
+               receiver->callback.kind != QEMU_CRUCIBLE_ADVANCE_CALLBACK_COMMAND_CURRENT ||
+               !receiver->callback.returned) {
+        return -EPERM;
+    }
+    status = qemu_plugin_crucible_native_advance_entry_current_v1(
+        tail->main, tail->control);
+    return status ? status : qemu_crucible_preexec_publisher_recipient_identity_v1(
+        lender, recipient, receiver);
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_crucible_source_advance_handoff_v1(
+    QemuCrucibleNativeInvocationTicket *main,
+    QemuCrucibleNativeInvocationTicket *control)
+{
+#if defined(CONFIG_LINUX) && defined(__x86_64__) && !defined(__ILP32__)
+    QemuCrucibleSourceAdvanceReceiver *receiver = &startup_source.advance_receiver;
+    QemuCrucibleCommandConsumerMember *member;
+    struct qemu_plugin_crucible_advance_disposition_v1 *disposition;
+    int post = 0;
+
+    if (!receiver->held || receiver->main_returned) {
+        return 0;
+    }
+    if (main != receiver->main || control != receiver->control) {
+        return -EPERM;
+    }
+    member = receiver->member;
+    disposition = &receiver->handoff_disposition;
+    if (receiver->enter_attempted && !receiver->handoff_attempted) {
+        receiver->handoff_attempted = true;
+        post = advance_callback_begin(receiver,
+            QEMU_CRUCIBLE_ADVANCE_CALLBACK_HANDOFF_POST, member->advance.handoff_post);
+        if (!post) {
+            *disposition = (struct qemu_plugin_crucible_advance_disposition_v1) {
+                .schema_version = 1,
+                .struct_size = sizeof(*disposition),
+            };
+            post = member->advance.handoff_post(
+                &receiver->module_original, receiver->module_original_serial,
+                &receiver->module_advance, receiver->module_advance_serial,
+                &receiver->entry, disposition, member->component->userdata);
+            advance_callback_end(receiver);
+            if (!advance_enter_disposition_syntax(disposition) ||
+                disposition->original_moved != receiver->original_moved ||
+                receiver->module_original != receiver->original_at_move ||
+                receiver->module_original_serial != receiver->original_moved_serial ||
+                receiver->module_advance != receiver->advance_at_birth ||
+                receiver->module_advance_serial != receiver->advance_birth_serial) {
+                receiver->uncertain = true;
+                if (!post) {
+                    post = -ESTALE;
+                }
+            }
+            if (!post) {
+                post = disposition->first_status ? disposition->first_status :
+                    disposition->post_status;
+            }
+        }
+        receiver->handoff_status = post > 0 ? -EPROTO : post;
+        post = advance_receiver_protocol_post(receiver,
+            &receiver->handoff_native_post_status,
+            &receiver->handoff_recipient_post_status,
+            &receiver->handoff_cohort_post_status,
+            &receiver->handoff_publication_final_status);
+        if (!receiver->handoff_status) {
+            receiver->handoff_status = post;
+        }
+        receiver->entry.held = false;
+    }
+    if (receiver->recipient && pending_constructor_no_birth() &&
+        !startup_source.pending_command_lender.held &&
+        !receiver->enter_attempted &&
+        (receiver->module_not_entered || receiver->acquire_absent)) {
+        QemuCrucibleAdvanceNoBirthTail *tail = &receiver->no_birth_tail;
+
+        if (tail->entered || tail->returned || receiver->next_tail_serial >= UINT64_MAX - 1) {
+            receiver->physical_status = -EALREADY;
+        } else {
+            *tail = (QemuCrucibleAdvanceNoBirthTail) {
+                .receiver = receiver,
+                .main = main,
+                .control = control,
+                .serial = ++receiver->next_tail_serial,
+                .phase = QEMU_CRUCIBLE_ADVANCE_NO_BIRTH_RETURN_REQUEST,
+                .entered = true,
+            };
+            receiver->physical_status =
+                qemu_crucible_preexec_publisher_recipient_no_birth_return_v1(
+                    receiver->lender, receiver->recipient, receiver,
+                    receiver->first_status, receiver->post_status);
+            tail->returned = true;
+            if (!receiver->physical_first_status && receiver->physical_status) {
+                receiver->physical_first_status = receiver->physical_status;
+            }
+        }
+    }
+    receiver->main_returned = true;
+    /* The retained Runtime/service/session child now outlives Main. This is
+     * no runtime permission and consumes no module Original or physical child. */
+    return receiver->handoff_status ? receiver->handoff_status : receiver->physical_status;
+#else
+    return -ENOTSUP;
+#endif
+}
diff --git a/plugins/crucible-apic-getter.inc.h b/plugins/crucible-apic-getter.inc.h
new file mode 100644
index 0000000000000000000000000000000000000000..519afa3957f4cc3aa673d1e343b75ce3fd65b125
--- /dev/null
+++ b/plugins/crucible-apic-getter.inc.h
@@ -0,0 +1,573 @@
+/*
+ * Actual initial Original joined to the existing software APIC getter
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifdef CONFIG_LINUX
+static int apic_getter_next_serial(uint64_t current, uint64_t *next)
+{
+    if (current == UINT64_MAX) {
+        return -EOVERFLOW;
+    }
+    *next = current + 1;
+    return 0;
+}
+
+static int apic_getter_provider_current(CPUState *cpu,
+    QemuCrucibleApicGetterFrame *frame, QemuCrucibleApicGetterLoan **holder,
+    QemuCrucibleApicGetterPhase phase)
+{
+    CPUClass *klass;
+
+    if (!cpu || !bql_locked()) {
+        return -EPERM;
+    }
+    klass = CPU_GET_CLASS(cpu);
+    return klass->crucible_apic_getter_current ?
+        klass->crucible_apic_getter_current(cpu, frame, holder, phase) : -ENOTSUP;
+}
+
+static QemuCrucibleApicGetterLoan *apic_getter_find_locked(
+    QemuCrucibleApicGetterFrame *frame, QemuCrucibleApicGetterLoan **holder)
+{
+    QemuCrucibleCpuSourceAllocationOwner *owner;
+
+    /* Compare nominal addresses before inspecting caller frame/holder fields. */
+    for (owner = startup_source.cpu_allocations.owners; owner; owner = owner->next) {
+        if (owner->getter.held && owner->getter.frame == frame &&
+            owner->getter.holder == holder) {
+            return &owner->getter;
+        }
+    }
+    return NULL;
+}
+
+static int apic_getter_identity_locked(QemuCrucibleApicGetterLoan *loan)
+{
+    int status = loan ? clock_owner_identity(loan->owner) : -ENOENT;
+
+    if (!status) {
+        status = clock_owner_identity(loan->parent);
+    }
+    if (!status && (&loan->owner->getter != loan || !loan->held ||
+        loan->process != getpid() || !qemu_thread_is_self(&loan->thread) ||
+        !loan->serial || loan->owner->getter_serial != loan->serial ||
+        loan->owner->request_serial != loan->generation ||
+        loan->parent->request_serial != loan->parent_generation ||
+        loan->participant != &loan->parent->initial ||
+        !loan->parent->getter_children || !loan->holder ||
+        *loan->holder != loan)) {
+        status = -ESTALE;
+    }
+    return status;
+}
+
+static int apic_getter_initial_identity(QemuCrucibleApicGetterLoan *loan)
+{
+    struct QemuCrucibleInitialCpuParticipant *participant = NULL;
+    int status = initial_cpu_identity(
+        loan->cpu, &loan->cpu->crucible_initial_participant, &participant);
+
+    if (!status && (participant != loan->participant ||
+        participant->operation_serial != loan->operation_serial ||
+        participant->group_serial != loan->group_serial ||
+        participant->owner != loan->parent)) {
+        status = -ESTALE;
+    }
+    return status;
+}
+
+static int apic_getter_clock_current(QemuCrucibleApicGetterLoan *loan)
+{
+    QemuCrucibleClockChildView view = { 0 };
+    QemuCrucibleClockSourceJournal *clock = &loan->owner->clock;
+    QemuCrucibleCpuSourceAllocationOwner *observed = NULL;
+    uint64_t generation = 0;
+    int status = clock_child_observe(loan->cpu, &view);
+
+    if (!status && (view.child != loan->child || view.storage != clock->storage ||
+        view.timer != clock->timer || clock->cpu != loan->cpu ||
+        clock->child != loan->child || clock->parent != loan->parent ||
+        clock->generation != loan->generation ||
+        clock->parent_generation != loan->parent_generation ||
+        !clock->held || !clock->active || !clock->register_post_recorded ||
+        clock->first_status || clock->post_status || clock->unregister_attempted)) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        status = clock_allocation_observe(loan->child, &observed, &generation);
+    }
+    if (!status && (observed != loan->owner || generation != loan->generation)) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        observed = NULL;
+        generation = 0;
+        status = clock_allocation_observe(OBJECT(loan->cpu), &observed, &generation);
+    }
+    if (!status && (observed != loan->parent ||
+        generation != loan->parent_generation)) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        status = qemu_crucible_fault_clock_storage_current_v1(clock->storage, true);
+    }
+    return status;
+}
+#endif
+
+int qemu_crucible_source_apic_getter_begin_v1(CPUState *cpu,
+    QemuCrucibleApicGetterFrame *frame, QemuCrucibleApicGetterLoan **holder)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleClockChildView view = { 0 };
+    QemuCrucibleCpuSourceAllocationOwner *owner = NULL, *parent = NULL;
+    struct QemuCrucibleInitialCpuParticipant *participant = NULL;
+    QemuCrucibleApicGetterLoan *loan;
+    uint64_t generation = 0, parent_generation = 0, serial = 0;
+    int status;
+
+    if (!cpu || getpid() != startup_source.owner_process) {
+        return -EPERM;
+    }
+    /* Core authenticates the real live CPU before its class or payload is
+     * inspected. This factual frame is not the subsequent Original grant. */
+    status = qemu_plugin_crucible_initial_cpu_dispatch_current_v1(
+        cpu, &cpu->crucible_initial_participant, true, false);
+    if (!status) {
+        status = apic_getter_provider_current(
+            cpu, frame, holder, QEMU_CRUCIBLE_APIC_GETTER_ISSUING);
+    }
+    if (!status) {
+        status = qemu_crucible_source_initial_cpu_current_v1(
+            cpu, &cpu->crucible_initial_participant);
+    }
+    if (!status) {
+        status = initial_register_read_entered(cpu);
+    }
+    if (!status) {
+        status = initial_cpu_identity(
+            cpu, &cpu->crucible_initial_participant, &participant);
+    }
+    if (!status) {
+        status = clock_child_observe(cpu, &view);
+    }
+    if (!status && (!view.child || frame->child != view.child || *holder ||
+                    frame->serial)) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        status = clock_allocation_observe(OBJECT(cpu), &parent, &parent_generation);
+    }
+    if (!status) {
+        status = clock_allocation_observe(view.child, &owner, &generation);
+    }
+    if (status) {
+        return status;
+    }
+
+    pthread_mutex_lock(&startup_source.cpu_allocations.lock);
+    status = clock_owner_identity(owner);
+    if (!status) {
+        status = clock_owner_identity(parent);
+    }
+    if (!status && (owner == parent || owner->getter.held ||
+        participant != &parent->initial || parent != participant->owner ||
+        owner->request_serial != generation ||
+        parent->request_serial != parent_generation ||
+        owner->clock.parent != parent || owner->clock.cpu != cpu ||
+        owner->clock.child != view.child || owner->clock.storage != view.storage ||
+        owner->clock.timer != view.timer || !owner->clock.held ||
+        !owner->clock.active || !owner->clock.register_post_recorded ||
+        owner->clock.first_status || owner->clock.post_status ||
+        owner->clock.unregister_attempted || owner->clock.callback.held)) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        status = apic_getter_next_serial(owner->getter_serial, &serial);
+    }
+    if (!status && parent->getter_children == UINT_MAX) {
+        status = -EOVERFLOW;
+    }
+    if (!status) {
+        loan = &owner->getter;
+        *loan = (QemuCrucibleApicGetterLoan) {
+            .owner = owner, .parent = parent, .participant = participant,
+            .cpu = cpu, .child = view.child, .frame = frame, .holder = holder,
+            .process = getpid(), .serial = serial,
+            .generation = generation, .parent_generation = parent_generation,
+            .operation_serial = participant->operation_serial,
+            .group_serial = participant->group_serial, .held = true,
+        };
+        qemu_thread_get_self(&loan->thread);
+        owner->getter_serial = serial;
+        parent->getter_children++;
+        frame->serial = loan->serial;
+        *holder = loan;
+    }
+    pthread_mutex_unlock(&startup_source.cpu_allocations.lock);
+    if (status) {
+        return status;
+    }
+
+    /* Birth and both attempted-ref cursors precede their actual QOM effects.
+     * Neither Source mutex nor an Original observation spans a QOM callback. */
+    loan->cpu_pin_attempted = true;
+    object_ref(OBJECT(cpu));
+    loan->cpu_pinned = true;
+    loan->child_pin_attempted = true;
+    object_ref(view.child);
+    loan->child_pinned = true;
+    status = apic_getter_clock_current(loan);
+    if (!status) {
+        status = qemu_crucible_source_initial_cpu_current_v1(
+            cpu, &cpu->crucible_initial_participant);
+    }
+    if (status && !loan->first_status) {
+        loan->first_status = status;
+    }
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_crucible_source_apic_getter_enter_v1(
+    QemuCrucibleApicGetterFrame *frame, QemuCrucibleApicGetterLoan **holder)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleApicGetterLoan *loan;
+    int status;
+
+    if (getpid() != startup_source.owner_process || !bql_locked()) {
+        return -EPERM;
+    }
+    pthread_mutex_lock(&startup_source.cpu_allocations.lock);
+    loan = apic_getter_find_locked(frame, holder);
+    status = apic_getter_identity_locked(loan);
+    pthread_mutex_unlock(&startup_source.cpu_allocations.lock);
+    if (status) {
+        return status;
+    }
+    status = apic_getter_provider_current(
+        loan->cpu, frame, holder, QEMU_CRUCIBLE_APIC_GETTER_SOFTWARE);
+    if (!status && (frame->serial != loan->serial || loan->entered ||
+        loan->post_recorded || loan->first_status)) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        status = apic_getter_initial_identity(loan);
+    }
+    if (!status) {
+        status = initial_register_read_entered(loan->cpu);
+    }
+    if (!status) {
+        status = apic_getter_clock_current(loan);
+    }
+    if (!status) {
+        status = qemu_crucible_source_initial_cpu_current_v1(
+            loan->cpu, &loan->cpu->crucible_initial_participant);
+    }
+    if (!status) {
+        loan->entered = true;
+        frame->software_entered = true;
+    } else if (!loan->first_status) {
+        loan->first_status = status;
+    }
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+#ifdef CONFIG_LINUX
+static bool apic_getter_view_returned(const QemuCrucibleApicGetterLoan *loan)
+{
+    if (!loan->view_acquire_attempted) {
+        return !loan->view && !loan->view_acquired &&
+            !loan->view_unref_attempted && !loan->view_unref_returned;
+    }
+    if (loan->view_acquire_status < 0) {
+        return !loan->view && !loan->view_acquired &&
+            !loan->view_unref_attempted && !loan->view_unref_returned;
+    }
+    return loan->view && loan->view_acquired &&
+        loan->view_unref_attempted && loan->view_unref_returned;
+}
+
+static void apic_getter_view_return(QemuCrucibleApicGetterLoan *loan)
+{
+    if (loan->view_acquired && !loan->view_unref_attempted) {
+        loan->view_unref_attempted = true;
+        flatview_unref(loan->view);
+        loan->view_unref_returned = true;
+    }
+}
+
+static bool apic_getter_body_closed(const QemuCrucibleApicGetterLoan *loan)
+{
+    return loan->held && loan->serial && loan->post_recorded && !loan->post_status &&
+        ((loan->callback_returned && loan->body_returned &&
+          (loan->entered || loan->first_status < 0)) ||
+         (loan->not_entered && !loan->callback_returned && !loan->body_returned &&
+          !loan->entered && loan->first_status < 0));
+}
+
+static bool apic_getter_pins_returned(const QemuCrucibleApicGetterLoan *loan)
+{
+    return loan->cpu_pin_attempted && loan->cpu_pinned &&
+        loan->child_pin_attempted && loan->child_pinned &&
+        loan->child_unref_attempted && loan->child_unref_returned &&
+        loan->cpu_unref_attempted && loan->cpu_unref_returned;
+}
+
+static bool apic_getter_return_closed(const QemuCrucibleApicGetterLoan *loan)
+{
+    return loan->return_started && !loan->return_first_status &&
+        loan->return_post_attempted && loan->return_post_recorded &&
+        !loan->return_post_status &&
+        memory_region_read_custody_returned(&loan->chunk) &&
+        apic_getter_view_returned(loan) &&
+        apic_getter_pins_returned(loan);
+}
+
+/* The caller authenticates the exact live Initial Original before entering
+ * this private return cut. These facts survive a late failed post, so another
+ * call cannot repeat an unref or manufacture a replacement post. */
+static int apic_getter_return_finish(QemuCrucibleApicGetterLoan *loan)
+{
+    if (!loan->return_started) {
+        return -EPERM;
+    }
+    if (loan->return_post_attempted) {
+        return loan->return_post_recorded ?
+            (loan->return_first_status ? loan->return_first_status :
+                                        loan->return_post_status) : -EBUSY;
+    }
+    if (!loan->return_first_status) {
+        loan->return_first_status = memory_region_read_custody_return(&loan->chunk);
+    }
+    if (!loan->return_first_status) {
+        apic_getter_view_return(loan);
+        if (!apic_getter_view_returned(loan)) {
+            loan->return_first_status = -EBUSY;
+        }
+    }
+    if (!loan->return_first_status) {
+        if (!loan->child_unref_attempted) {
+            loan->child_unref_attempted = true;
+            object_unref(loan->child);
+            loan->child_unref_returned = true;
+        }
+        if (!loan->child_unref_returned) {
+            loan->return_first_status = -EBUSY;
+        }
+    }
+    if (!loan->return_first_status) {
+        if (!loan->cpu_unref_attempted) {
+            loan->cpu_unref_attempted = true;
+            object_unref(OBJECT(loan->cpu));
+            loan->cpu_unref_returned = true;
+        }
+        if (!apic_getter_pins_returned(loan)) {
+            loan->return_first_status = -EBUSY;
+        }
+    }
+
+    initial_cpu_sdk_record(loan->participant,
+        loan->first_status ? loan->first_status : loan->return_first_status, 0);
+    loan->return_post_attempted = true;
+    loan->return_post_status = qemu_crucible_source_initial_cpu_sdk_post_v1(
+        loan->cpu, &loan->cpu->crucible_initial_participant, 0);
+    loan->return_post_recorded = true;
+    return loan->return_first_status ? loan->return_first_status :
+                                      loan->return_post_status;
+}
+#endif
+
+int qemu_crucible_source_apic_getter_vapic_v1(
+    QemuCrucibleApicGetterFrame *frame, QemuCrucibleApicGetterLoan **holder)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleApicGetterLoan *loan;
+    int status;
+
+    if (getpid() != startup_source.owner_process || !bql_locked()) {
+        return -EPERM;
+    }
+    pthread_mutex_lock(&startup_source.cpu_allocations.lock);
+    loan = apic_getter_find_locked(frame, holder);
+    status = apic_getter_identity_locked(loan);
+    pthread_mutex_unlock(&startup_source.cpu_allocations.lock);
+    if (status) {
+        return status;
+    }
+
+    status = apic_getter_provider_current(
+        loan->cpu, frame, holder, QEMU_CRUCIBLE_APIC_GETTER_SOFTWARE);
+    if (!status && (frame->serial != loan->serial ||
+        !frame->software_entered || !loan->entered || loan->post_recorded ||
+        loan->view_acquire_attempted || loan->first_status)) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        status = apic_getter_initial_identity(loan);
+    }
+    if (!status) {
+        status = initial_register_read_entered(loan->cpu);
+    }
+    if (!status) {
+        status = apic_getter_clock_current(loan);
+    }
+    if (!status) {
+        status = qemu_crucible_source_initial_cpu_current_v1(
+            loan->cpu, &loan->cpu->crucible_initial_participant);
+    }
+    if (!status) {
+        /* The external allocation header already paid for this cursor. One
+         * actual reference pins this view's region graph. The shared first
+         * translation retains the region and its owner, refusing before any
+         * IOMMU callback, RAM mapping or MMIO dispatch. */
+        loan->view_acquire_attempted = true;
+        loan->view_acquire_status = address_space_get_flatview_once(
+            &address_space_memory, &loan->view);
+        loan->view_acquired = loan->view_acquire_status == 0;
+        status = loan->view_acquire_status;
+        if (!status) {
+            status = flatview_read_first_chunk_custody(
+                loan->view, frame->vapic_address, frame->vapic_length,
+                MEMTXATTRS_UNSPECIFIED, &loan->chunk);
+            if (!status) {
+                status = -ENOTSUP;
+            }
+        }
+    }
+    if (status && !loan->first_status) {
+        loan->first_status = status;
+    }
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_crucible_source_apic_getter_end_v1(CPUState *cpu,
+    QemuCrucibleApicGetterFrame *frame, QemuCrucibleApicGetterLoan **holder,
+    int first_status)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleApicGetterLoan *loan;
+    struct QemuCrucibleInitialCpuParticipant *participant = NULL;
+    int status, post, provider;
+
+    if (!cpu || getpid() != startup_source.owner_process) {
+        return first_status ? first_status : -EPERM;
+    }
+    status = qemu_plugin_crucible_initial_cpu_dispatch_current_v1(
+        cpu, &cpu->crucible_initial_participant, true, false);
+    provider = status ? status : apic_getter_provider_current(
+        cpu, frame, holder, QEMU_CRUCIBLE_APIC_GETTER_RETURNING);
+    if (!status) {
+        status = initial_cpu_identity(
+            cpu, &cpu->crucible_initial_participant, &participant);
+    }
+    if (!status) {
+        /* Save the earlier cause before the independent SDK post can fail. */
+        initial_cpu_sdk_record(participant, first_status, 0);
+    }
+    /* Observe the actual same initial Original independently even if first
+     * failed before child birth. Its saved first and post remain independent. */
+    post = qemu_crucible_source_initial_cpu_sdk_post_v1(
+        cpu, &cpu->crucible_initial_participant, 0);
+    if (status && !post) {
+        post = status;
+    }
+    if (!post) {
+        post = provider;
+    }
+    if (!status) {
+        initial_cpu_sdk_record(participant, first_status, post);
+    }
+
+    pthread_mutex_lock(&startup_source.cpu_allocations.lock);
+    loan = apic_getter_find_locked(frame, holder);
+    status = loan ? apic_getter_identity_locked(loan) : 0;
+    pthread_mutex_unlock(&startup_source.cpu_allocations.lock);
+    if (!loan) {
+        return first_status ? first_status : (post ? post : -EPERM);
+    }
+    if (status) {
+        return first_status ? first_status : status;
+    }
+    if (loan->return_started) {
+        return loan->first_status ? loan->first_status :
+            (loan->return_first_status ? loan->return_first_status :
+             loan->return_post_status ? loan->return_post_status : -EALREADY);
+    }
+    if (!loan->first_status) {
+        loan->first_status = first_status;
+    }
+    if (!loan->post_recorded && provider) {
+        loan->post_status = post ? post : provider;
+        loan->post_recorded = true;
+    }
+    if (!loan->post_recorded) {
+        status = apic_getter_initial_identity(loan);
+        if (!status) {
+            status = apic_getter_clock_current(loan);
+        }
+        if (!status && (loan->cpu != cpu || frame->serial != loan->serial ||
+            frame->first_status != first_status ||
+            frame->software_entered != loan->entered ||
+            (!first_status && !loan->entered))) {
+            status = -ESTALE;
+        }
+        loan->post_status = post ? post : status;
+        loan->callback_returned = frame->callback_returned;
+        loan->body_returned = frame->software_returned;
+        loan->not_entered = !frame->callback_returned && first_status < 0;
+        loan->post_recorded = true;
+    }
+    if (participant == loan->participant) {
+        initial_cpu_sdk_record(participant, loan->first_status, loan->post_status);
+    }
+    if (!apic_getter_body_closed(loan)) {
+        return loan->first_status ? loan->first_status :
+            (loan->post_status ? loan->post_status : -EBUSY);
+    }
+
+    /* The region child returns before our additional view reference.
+     * Last-reference release
+     * can schedule RCU disposal; its return never certifies that disposal, RAM
+     * backing destruction or any transaction child. An uncertain attempt is
+     * retained in this external cursor and is never repeated. */
+    loan->return_started = true;
+    /* SDK body post did not consume the construction Original. The real
+     * callback and Initial/Native pins remain live. Recheck permission
+     * before these further effects; a completed Original cannot cover them.
+     * Observe the Original directly, independently of the saved SDK error. */
+    loan->return_first_status = initial_cpu_child_original_observe(
+        loan->participant, false);
+    status = apic_getter_return_finish(loan);
+    if (!apic_getter_return_closed(loan)) {
+        return loan->first_status ? loan->first_status : (status ? status : -EBUSY);
+    }
+
+    pthread_mutex_lock(&startup_source.cpu_allocations.lock);
+    status = apic_getter_identity_locked(loan);
+    if (!status && !apic_getter_pins_returned(loan)) {
+        status = -EBUSY;
+    }
+    if (status && !loan->return_first_status) {
+        loan->return_first_status = status;
+    }
+    if (!status) {
+        loan->parent->getter_children--;
+        *holder = NULL;
+        loan->held = false;
+    }
+    pthread_mutex_unlock(&startup_source.cpu_allocations.lock);
+    return loan->first_status ? loan->first_status : status;
+#else
+    return first_status ? first_status : -ENOTSUP;
+#endif
+}
