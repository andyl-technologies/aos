+        operation->start_ns = action->cohort.rows[0].original_start_ns;
+        operation->progress_ns = action->cohort.rows[0].genuine_progress_ns;
+    }
+    qemu_thread_get_self(&operation->thread);
+    if (capture) {
+        /* Only this genuine Root entry selects the pending child's class.
+         * Its aggregate birth, serial, admitted budgets and clocks stay intact. */
+        capture->operation.class_index = operation->class_index;
+        capture->root_attached = true;
+        capture->root_serial = operation->serial;
