+size_t qemu_thread_bounded_control_bytes(size_t name_bytes)
+{
+    if (!name_bytes || name_bytes > QEMU_HOT_FORK_THREAD_NAME_MAX + 1) {
+        return 0;
+    }
+    return sizeof(QemuThreadArgs) + name_bytes +
