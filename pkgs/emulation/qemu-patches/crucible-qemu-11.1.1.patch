+#ifdef CONFIG_LINUX
+static void fixture_write_at(int fd, const uint8_t *wire, size_t length,
+                             uint32_t offset)
+{
+    size_t completed = 0;
+
+    while (completed < length) {
+        ssize_t written = pwrite(fd, wire + completed, length - completed,
+                                 (off_t)offset + completed);
+
+        g_assert_cmpint(written, >, 0);
+        completed += written;
+    }
+}
+
+static int fixture_setup_fd(const uint8_t *wire, uint32_t length, int seals)
+{
+    int fd = memfd_create("crucible-setup-syntax",
+                          MFD_CLOEXEC | MFD_ALLOW_SEALING);
+
+    g_assert_cmpint(fd, >=, 0);
+    g_assert_cmpint(ftruncate(fd, length), ==, 0);
+    fixture_write_at(fd, wire, length, 0);
+    g_assert_cmpint(fcntl(fd, F_ADD_SEALS, seals), ==, 0);
+    return fd;
+}
+
+static void assert_fd_refusal(int fd)
+{
+    QemuCrucibleDeviceWorkspaceSetupView view;
+    uint8_t sentinel[sizeof(view)];
+
+    memset(&view, 0x5a, sizeof(view));
+    memcpy(sentinel, &view, sizeof(sentinel));
+    g_assert_cmpint(qemu_crucible_device_workspace_setup_read_fd(fd, &view),
+                    <, 0);
+    g_assert_cmpmem(&view, sizeof(view), sentinel, sizeof(sentinel));
+}
+
+static void assert_fd_identity(int fd, const struct stat *expected,
+                               int descriptor_flags, int status_flags,
+                               off_t position)
+{
+    struct stat observed;
+
+    g_assert_cmpint(fstat(fd, &observed), ==, 0);
+    g_assert_true(observed.st_dev == expected->st_dev);
+    g_assert_true(observed.st_ino == expected->st_ino);
+    g_assert_true(observed.st_mode == expected->st_mode);
+    g_assert_true(observed.st_size == expected->st_size);
+    g_assert_cmpint(fcntl(fd, F_GETFD), ==, descriptor_flags);
+    g_assert_cmpint(fcntl(fd, F_GETFL), ==, status_flags);
+    g_assert_true(lseek(fd, 0, SEEK_CUR) == position);
+}
+#endif
+
+static void test_setup_fd_fields(void)
+{
+#ifdef CONFIG_LINUX
+    const int seals = F_SEAL_WRITE | F_SEAL_SHRINK | F_SEAL_GROW | F_SEAL_SEAL;
+    uint8_t wire[300] = { 0 };
+    QemuCrucibleDeviceWorkspaceSetupView view;
+    QemuCrucibleDeviceWorkspaceSetupView decoded;
+
+    for (uint32_t workspace = 0; workspace <= 128; workspace += 128) {
+        for (uint32_t startup = 0; startup <= 128; startup += 128) {
+            uint32_t total = fixture_setup(wire, 3, 5, workspace, startup);
+            struct stat identity;
+            int fd;
+            int descriptor_flags;
+            int status_flags;
+
+            if (workspace) {
+                fixture_record(wire + 44, 1, 0);
+            }
+            if (startup) {
+                fixture_startup(wire + 44 + workspace, 0, INT_MAX);
+            }
+            fd = fixture_setup_fd(wire, total, seals);
+            g_assert_cmpint(fstat(fd, &identity), ==, 0);
+            descriptor_flags = fcntl(fd, F_GETFD);
+            status_flags = fcntl(fd, F_GETFL);
+            g_assert_true(lseek(fd, 7, SEEK_SET) == 7);
+
+            g_assert_cmpint(qemu_crucible_device_workspace_setup_read_fd(
+                                fd, &view), ==, 0);
+
+            g_assert_cmpuint(view.total_bytes, ==, total);
+            g_assert_cmpuint(view.app_random_offset, ==, 36);
+            g_assert_cmpuint(view.selectable_offset, ==, 39);
+            g_assert_cmpuint(view.workspace_offset, ==, 44);
+            g_assert_cmpuint(view.startup_offset, ==, 44 + workspace);
+            if (workspace) {
+                assert_record(&view.workspace, 1, 0);
+            }
+            if (startup) {
+                assert_startup(&view.startup, 0, INT_MAX);
+            }
+            g_assert_cmpint(qemu_crucible_device_workspace_setup_decode(
+                                wire, total, &decoded), ==, 0);
+            g_assert_cmpmem(&view, sizeof(view), &decoded, sizeof(decoded));
+            assert_fd_identity(fd, &identity, descriptor_flags,
+                               status_flags, 7);
+            g_assert_cmpint(fcntl(fd, F_GET_SEALS), ==, seals);
+            g_assert_cmpint(close(fd), ==, 0);
+        }
+    }
+
+    /* Sparse fixture bodies reach far offsets without a large wire buffer. */
+    for (uint32_t workspace = 0; workspace <= 128; workspace += 128) {
+        for (uint32_t startup = 0; startup <= 128; startup += 128) {
+            uint32_t selectable = 33554424 - workspace - startup;
+            uint32_t workspace_offset = 36 + 4194304 + selectable;
+            uint32_t total = fixture_setup(
+                wire, 4194304, selectable,
+                workspace, startup);
+            int fd = memfd_create(
+                "crucible-setup-sparse",
+                MFD_CLOEXEC | MFD_ALLOW_SEALING);
+
+            g_assert_cmpint(fd, >=, 0);
+            g_assert_cmpuint(total, ==, 37748764);
+            g_assert_cmpint(ftruncate(fd, total), ==, 0);
+            fixture_write_at(fd, wire, 36, 0);
+            if (workspace) {
+                fixture_record(wire, 2, 0);
+                fixture_write_at(fd, wire, 128, workspace_offset);
+            }
+            if (startup) {
+                fixture_startup(wire, 0, 3);
+                fixture_write_at(fd, wire, 128, workspace_offset + workspace);
+            }
+            g_assert_cmpint(fcntl(fd, F_ADD_SEALS, seals), ==, 0);
+
+            g_assert_cmpint(qemu_crucible_device_workspace_setup_read_fd(
+                                fd, &view), ==, 0);
+
+            g_assert_cmpuint(view.total_bytes, ==, 37748764);
+            g_assert_cmpuint(view.workspace_offset, ==, workspace_offset);
+            g_assert_cmpuint(view.startup_offset, ==,
+                             workspace_offset + workspace);
+            if (workspace) {
+                assert_record(&view.workspace, 2, 0);
+            }
+            if (startup) {
+                assert_startup(&view.startup, 0, 3);
+            }
+            g_assert_cmpint(close(fd), ==, 0);
+        }
+    }
+#else
+    g_test_skip("Linux immutable memfd reader controls");
+#endif
+}
