+/* Called only by the same entry after synchronous reply/cursor/operation return.
+ * Accepted queued work has separate keeper custody and is not settled here. */
+int qemu_plugin_crucible_ram_control_record_return_v1(
+    qemu_plugin_id_t id, qemu_plugin_crucible_ram_control_actor_v1 *actor,
+    qemu_plugin_crucible_ram_control_receive_v1 *receipt, int status)
+{
+    int result = qemu_crucible_ram_control_actor_current(actor, id);
+
+    if (result || status > 0) {
+        return result ? result : -EINVAL;
+    }
+    if (!status) {
+        result = ram_control_record_end(actor, id, receipt, true);
+        if (result) {
+            return result;
+        }
+    }
+    pthread_mutex_lock(&actor->dispatch_mutex);
+    if (receipt != &actor->receipt || !receipt->active || !receipt->moved ||
+        !actor->record_in_flight || !receipt->frame_extent ||
+        receipt->frame_bytes != receipt->frame_extent) {
+        result = -EPERM;
+    } else if (status || receipt->uncertain) {
+        receipt->uncertain = true;
+        result = ram_control_failure(actor, status ? status : -EINPROGRESS, false);
+    } else {
+        /* Moved pending custody and its immutable frame remain retained. */
+        actor->record_in_flight = false;
+    }
+    pthread_mutex_unlock(&actor->dispatch_mutex);
+    return result;
+}
