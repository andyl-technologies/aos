+static void crucible_fault_ensure_registry(void)
+{
+    if (!crucible_fault_handlers) {
+        crucible_fault_handlers = g_ptr_array_new();
+        crucible_seen_sequences = g_hash_table_new_full(
+            g_int64_hash, g_int64_equal, g_free, NULL);
+        crucible_deferred_source_ticks = g_hash_table_new_full(
+            g_int64_hash, g_int64_equal, g_free, g_free);
+    }
+}
+
+static int crucible_fault_capability_compare(gconstpointer left,
+                                             gconstpointer right)
+{
+    const QemuCrucibleFaultHandler *a = *(const void * const *)left;
+    const QemuCrucibleFaultHandler *b = *(const void * const *)right;
+
+    if (a->capability.command_kind != b->capability.command_kind) {
+        return a->capability.command_kind < b->capability.command_kind ? -1 : 1;
+    }
+    if (a->capability.semantic_version != b->capability.semantic_version) {
+        return a->capability.semantic_version < b->capability.semantic_version
+                   ? -1
+                   : 1;
+    }
+    if (a->capability.scope != b->capability.scope) {
+        return a->capability.scope < b->capability.scope ? -1 : 1;
+    }
+    return 0;
+}
+
+static void crucible_fault_handler_validate(const QemuCrucibleFaultHandler *handler)
+{
+    g_assert(handler);
+    g_assert(handler->capability.command_kind != 0);
+    g_assert(handler->capability.semantic_version != 0);
+    g_assert(handler->capability.scope >=
+             CRUCIBLE_FAULT_CAPABILITY_SCOPE_ALL);
+    g_assert(handler->capability.scope <=
+             CRUCIBLE_FAULT_CAPABILITY_SCOPE_ACCELERATOR);
+    g_assert(handler->capability.phase_mask != 0);
+    g_assert(handler->capability.maximum_pending_commands != 0);
+    g_assert(handler->capability.name);
+    g_assert(handler->capability.payload_schema);
+    g_assert(!(handler->capability.required_feature_bits &
+               ~CRUCIBLE_FAULT_CAPABILITY_FEATURES_V1_MASK));
+    g_assert(handler->prepare);
+    g_assert(handler->commit);
+}
+
+void qemu_crucible_fault_register(const QemuCrucibleFaultHandler *handler)
+{
+    size_t i;
+
+    crucible_fault_handler_validate(handler);
+    g_mutex_lock(&crucible_fault_lock);
+    crucible_fault_ensure_registry();
+    g_assert(!crucible_registry_sealed);
+    for (i = 0; i < crucible_fault_handlers->len; i++) {
+        const QemuCrucibleFaultHandler *existing =
+            g_ptr_array_index(crucible_fault_handlers, i);
+        /*
+         * Dispatch keys omit scope, so one kind/version has one handler.
+         */
+        g_assert(existing->capability.command_kind !=
+                 handler->capability.command_kind ||
+                 existing->capability.semantic_version !=
+                 handler->capability.semantic_version);
+    }
+    g_ptr_array_add(crucible_fault_handlers, (void *)handler);
+    g_mutex_unlock(&crucible_fault_lock);
+}
+
+int qemu_crucible_fault_register_node_owned_v1(
+    QemuCrucibleFaultRegistration *registration,
+    QemuCrucibleFaultRegistration **holder)
+{
+    const QemuCrucibleFaultHandler *handler = NULL;
+    int status;
+
+    if (qemu_plugin_crucible_startup_source_retained()) {
+#ifdef ENOKEY
+        return -ENOKEY;
+#else
+        return -ENOTSUP;
+#endif
+    }
+    status = qemu_crucible_fault_node_registration_identity_v1(
+        registration, holder, true, &handler);
+    if (status) {
+        return status;
+    }
+    crucible_fault_handler_validate(handler);
+    g_mutex_lock(&crucible_fault_lock);
+    crucible_fault_ensure_registry();
+    g_mutex_lock(&crucible_fault_registration_append.lock);
+    if (crucible_registry_sealed || crucible_fault_registration_append.calling) {
+        status = -EPERM;
+    }
+    g_mutex_unlock(&crucible_fault_registration_append.lock);
+    for (size_t index = 0; !status && index < crucible_fault_handlers->len; index++) {
+        const QemuCrucibleFaultHandler *existing =
+            g_ptr_array_index(crucible_fault_handlers, index);
+
+        if (existing->capability.command_kind == handler->capability.command_kind &&
+            existing->capability.semantic_version == handler->capability.semantic_version) {
+            status = -EEXIST;
+        }
+    }
+    if (!status) {
+        g_mutex_lock(&crucible_fault_registration_append.lock);
+        crucible_fault_registration_append.registration = registration;
+        crucible_fault_registration_append.holder = holder;
+        crucible_fault_registration_append.handler = handler;
+        qatomic_store_release(&crucible_fault_registration_append.process, getpid());
+        qemu_thread_get_self(&crucible_fault_registration_append.thread);
+        crucible_fault_registration_append.calling = true;
+        g_mutex_unlock(&crucible_fault_registration_append.lock);
+        status = qemu_crucible_fault_node_registration_publish_v1(
+            registration, holder, handler);
+        if (!status) {
+            /* Actual publication and append share the real fault lock.
+             * A refused append never replaces the original live edges. */
+            g_ptr_array_add(crucible_fault_handlers, (void *)handler);
+        }
+        g_mutex_lock(&crucible_fault_registration_append.lock);
+        crucible_fault_registration_append.calling = false;
+        g_mutex_unlock(&crucible_fault_registration_append.lock);
+    }
+    g_mutex_unlock(&crucible_fault_lock);
+    return status;
+}
+
+int qemu_crucible_fault_registration_retire_v1(
+    QemuCrucibleFaultRegistration *registration,
+    QemuCrucibleFaultRegistration **holder)
+{
+    const QemuCrucibleFaultHandler *handler = NULL;
+    size_t position = SIZE_MAX;
+    int status;
+
+    if (qemu_plugin_crucible_startup_source_retained()) {
+        return -ENOKEY;
+    }
+    status = qemu_crucible_fault_node_registration_identity_v1(
+        registration, holder, false, &handler);
+    if (status) {
+        return status;
+    }
+    g_mutex_lock(&crucible_fault_lock);
+    handler = NULL;
+    status = qemu_crucible_fault_node_registration_identity_v1(
+        registration, holder, false, &handler);
+    if (status) {
+        goto out;
+    }
+    for (size_t index = 0; crucible_fault_handlers &&
+         index < crucible_fault_handlers->len; index++) {
+        if (g_ptr_array_index(crucible_fault_handlers, index) == handler) {
+            if (position != SIZE_MAX) {
+                status = -EPERM;
+                goto out;
+            }
+            position = index;
+        }
+    }
+    if (position == SIZE_MAX) {
+        status = -EPERM;
+        goto out;
+    }
+    g_mutex_lock(&crucible_fault_registration_retiring.lock);
+    if (crucible_fault_registration_retiring.calling ||
+        crucible_fault_registration_retiring.issuance == UINT64_MAX) {
+        g_mutex_unlock(&crucible_fault_registration_retiring.lock);
+        status = -EBUSY;
+        goto out;
+    }
+    crucible_fault_registration_retiring.registration = registration;
+    crucible_fault_registration_retiring.holder = holder;
+    crucible_fault_registration_retiring.handler = handler;
+    crucible_fault_registration_retiring.issuance++;
+    crucible_fault_registration_retiring.removed = false;
+    qatomic_store_release(&crucible_fault_registration_retiring.process, getpid());
+    qemu_thread_get_self(&crucible_fault_registration_retiring.thread);
+    crucible_fault_registration_retiring.calling = true;
+    g_mutex_unlock(&crucible_fault_registration_retiring.lock);
+
+    status = qemu_crucible_fault_node_registration_retire_begin_v1(registration, holder);
+    if (!status) {
+        /* Exact removal under the same lock used by Submit/capability/save
+         * readers. The sealed registry remains sealed and is never rebuilt. */
+        g_ptr_array_remove_index(crucible_fault_handlers, position);
+        g_mutex_lock(&crucible_fault_registration_retiring.lock);
+        crucible_fault_registration_retiring.removed = true;
+        g_mutex_unlock(&crucible_fault_registration_retiring.lock);
+        status = qemu_crucible_fault_node_registration_retire_finish_v1(
+            registration, holder);
+    }
+    g_mutex_lock(&crucible_fault_registration_retiring.lock);
+    crucible_fault_registration_retiring.calling = false;
+    g_mutex_unlock(&crucible_fault_registration_retiring.lock);
+out:
+    g_mutex_unlock(&crucible_fault_lock);
+    return status;
+}
+
+int qemu_crucible_fault_registration_observe_v1(
+    QemuCrucibleFaultRegistration *registration,
+    QemuCrucibleFaultRegistration **holder,
+    QemuCrucibleFaultRegistrationObservation *out)
+{
+    const QemuCrucibleFaultHandler *handler = NULL;
+    QemuCrucibleFaultRegistrationObservation observation = { 0 };
+    CruciblePendingFault *pending;
+    int status;
+
+    if (!out) {
+        return -EINVAL;
+    }
+    /* A foreign process must refuse before touching an inherited fault mutex.
+     * Repeat nominal authentication under the registry lock for observation. */
+    status = qemu_crucible_fault_node_registration_identity_v1(
+        registration, holder, false, &handler);
+    if (status) {
+        return status;
+    }
+    handler = NULL;
+    g_mutex_lock(&crucible_fault_lock);
+    status = qemu_crucible_fault_node_registration_identity_v1(
+        registration, holder, false, &handler);
+    if (status) {
+        g_mutex_unlock(&crucible_fault_lock);
+        return status;
+    }
+    if (crucible_fault_handlers) {
+        for (size_t index = 0; index < crucible_fault_handlers->len; index++) {
+            if (g_ptr_array_index(crucible_fault_handlers, index) == handler) {
+                observation.registry_memberships++;
+            }
+        }
+    }
+    QTAILQ_FOREACH(pending, &crucible_pending_faults, link) {
+        if (pending->handler == handler) {
+            observation.queued_pending++;
+        }
+    }
+    observation.registry_sealed = crucible_registry_sealed;
+    g_mutex_unlock(&crucible_fault_lock);
+    *out = observation;
+    return 0;
+}
+
+void qemu_crucible_fault_boundary_observer_register(
+    QemuCrucibleFaultBoundaryObserverFn observer)
+{
+    g_assert(observer && !crucible_registry_sealed);
+    if (!crucible_boundary_observers) {
+        crucible_boundary_observers = g_ptr_array_new();
+    }
+    g_ptr_array_add(crucible_boundary_observers, observer);
+}
+
+void qemu_crucible_fault_boundary_deadline_register(
+    QemuCrucibleFaultBoundaryDeadlineFn deadline)
+{
+    g_assert(deadline && !crucible_registry_sealed);
+    if (!crucible_boundary_deadlines) {
+        crucible_boundary_deadlines = g_ptr_array_new();
+    }
+    g_ptr_array_add(crucible_boundary_deadlines, deadline);
+}
+
+void qemu_crucible_fault_registry_seal(void)
+{
+    g_mutex_lock(&crucible_fault_lock);
+    crucible_fault_ensure_registry();
+    if (!crucible_registry_sealed) {
+        g_ptr_array_sort(crucible_fault_handlers,
+                         crucible_fault_capability_compare);
+        crucible_registry_sealed = true;
+    }
+    g_mutex_unlock(&crucible_fault_lock);
+}
+
+static const QemuCrucibleFaultHandler *
+crucible_fault_find_handler(uint16_t kind, uint32_t version)
+{
+    size_t i;
+
+    for (i = 0; i < crucible_fault_handlers->len; i++) {
+        const QemuCrucibleFaultHandler *handler =
+            g_ptr_array_index(crucible_fault_handlers, i);
+        if (handler->capability.command_kind == kind &&
+            handler->capability.semantic_version == version) {
+            return handler;
+        }
+    }
+    return NULL;
+}
+
+static size_t crucible_fault_handler_pending_count(
+    const QemuCrucibleFaultHandler *handler)
+{
+    CruciblePendingFault *pending;
+    size_t count = 0;
+
+    QTAILQ_FOREACH(pending, &crucible_pending_faults, link) {
+        if (pending->handler == handler) {
+            count++;
+        }
+    }
+    return count;
+}
+
+static int crucible_fault_pending_compare(const CruciblePendingFault *a,
+                                          const CruciblePendingFault *b)
+{
+    int order;
+
+    if (a->command.target_tick != b->command.target_tick) {
+        return a->command.target_tick < b->command.target_tick ? -1 : 1;
+    }
+    if (a->command.phase != b->command.phase) {
+        return a->command.phase < b->command.phase ? -1 : 1;
+    }
+    if (a->handler->capability.command_kind !=
+        b->handler->capability.command_kind) {
+        return a->handler->capability.command_kind <
+               b->handler->capability.command_kind ? -1 : 1;
+    }
+    order = memcmp(a->command.binding_hash, b->command.binding_hash, 32);
+    if (order) {
+        return order;
+    }
+    order = memcmp(a->command.opportunity_hash,
+                   b->command.opportunity_hash, 32);
+    if (order) {
+        return order;
+    }
+    if (a->command.command_sequence != b->command.command_sequence) {
+        return a->command.command_sequence < b->command.command_sequence ?
+               -1 : 1;
+    }
+    return 0;
+}
+
+static void crucible_fault_insert_pending(CruciblePendingFault *pending)
+{
+    CruciblePendingFault *cursor;
+
+    QTAILQ_FOREACH(cursor, &crucible_pending_faults, link) {
+        if (crucible_fault_pending_compare(pending, cursor) < 0) {
+            QTAILQ_INSERT_BEFORE(cursor, pending, link);
+            return;
+        }
+    }
+    QTAILQ_INSERT_TAIL(&crucible_pending_faults, pending, link);
+}
+
+static bool crucible_fault_accept_sequence(uint64_t sequence)
+{
+    uint64_t floor = 0;
+    guint64 lookup = sequence;
+    guint64 *stored;
+
+    if (crucible_max_command_sequence >= CRUCIBLE_FAULT_SEQUENCE_WINDOW) {
+        floor = crucible_max_command_sequence -
+                CRUCIBLE_FAULT_SEQUENCE_WINDOW + 1;
+    }
+    if (sequence < floor ||
+        g_hash_table_contains(crucible_seen_sequences, &lookup)) {
+        return false;
+    }
+    if (sequence > crucible_max_command_sequence) {
+        GHashTableIter iterator;
+        gpointer key;
+
+        crucible_max_command_sequence = sequence;
+        if (sequence >= CRUCIBLE_FAULT_SEQUENCE_WINDOW) {
+            floor = sequence - CRUCIBLE_FAULT_SEQUENCE_WINDOW + 1;
+            g_hash_table_iter_init(&iterator, crucible_seen_sequences);
+            while (g_hash_table_iter_next(&iterator, &key, NULL)) {
+                if (*(guint64 *)key < floor) {
+                    g_hash_table_iter_remove(&iterator);
+                }
+            }
+        }
+    }
+    stored = g_new(guint64, 1);
+    *stored = sequence;
+    g_hash_table_add(crucible_seen_sequences, stored);
+    return true;
+}
+
+static void crucible_fault_result_rejected(
+    struct qemu_plugin_crucible_fault_result *result,
+    const struct qemu_plugin_crucible_fault_command *command,
+    uint16_t status, uint64_t observed_icount)
+{
+    memset(result, 0, sizeof(*result));
+    result->command_kind = command->command_kind;
+    result->status = status;
+    result->phase = command->phase;
+    result->semantic_version = command->semantic_version;
+    result->command_sequence = command->command_sequence;
+    result->observed_icount = observed_icount;
+    result->observed_tick = qemu_plugin_sim_tick_observed();
+    result->capability_version = 1;
+}
+
+static void crucible_fault_payload_sha256(const GByteArray *payload,
+                                          uint8_t digest[32])
+{
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    gsize digest_len = 32;
+
+    g_checksum_update(checksum, payload->data, payload->len);
+    g_checksum_get_digest(checksum, digest, &digest_len);
+    g_assert(digest_len == 32);
+}
+
+static void crucible_fault_queue_result(
+    const struct qemu_plugin_crucible_fault_result *result,
+    GByteArray *payload)
+{
+    CrucibleCompletedFault *completed;
+    int64_t emitted_tick = qemu_plugin_sim_tick_observed();
+
+    g_assert(crucible_completed_count < CRUCIBLE_FAULT_RESULT_QUEUE_CAPACITY);
+    g_assert(emitted_tick >= 0);
+    completed = g_new0(CrucibleCompletedFault, 1);
+    completed->result = *result;
+    completed->result.emitted_tick = emitted_tick;
+    completed->payload = payload ? payload : g_byte_array_new();
+    crucible_fault_payload_sha256(
+        completed->payload, completed->result.evidence_hash);
+    QTAILQ_INSERT_TAIL(&crucible_completed_faults, completed, link);
+    crucible_completed_count++;
+}
+
+static uint64_t crucible_fault_take_deferred_source_tick(uint64_t sequence)
+{
+    guint64 lookup = sequence;
+    uint64_t *stored = g_hash_table_lookup(
+        crucible_deferred_source_ticks, &lookup);
+    uint64_t source_tick;
+
+    g_assert(stored);
+    source_tick = *stored;
+    g_hash_table_remove(crucible_deferred_source_ticks, &lookup);
+    return source_tick;
+}
+
+void qemu_crucible_fault_complete_deferred(
+    const QemuCrucibleFaultRule *rule, uint64_t observed_icount,
+    uint64_t applied_icount, const uint8_t before_hash[32],
+    const uint8_t after_hash[32])
+{
+    struct qemu_plugin_crucible_fault_result result = { 0 };
+    g_autoptr(GByteArray) payload = NULL;
+    qemu_plugin_crucible_fault_completion_cb_t completion;
+    void *completion_userdata;
+
+    g_assert(rule);
+    g_assert(applied_icount >= observed_icount);
+    result.command_kind = qemu_crucible_fault_rule_command_kind(rule);
+    result.status = CRUCIBLE_FAULT_STATUS_APPLIED;
+    result.phase = qemu_crucible_fault_rule_command_phase(rule);
+    result.semantic_version =
+        qemu_crucible_fault_rule_semantic_version(rule);
+    result.capability_version = 1;
+    result.command_sequence =
+        qemu_crucible_fault_rule_command_sequence(rule);
+    result.observed_icount = observed_icount;
+    result.applied_icount = applied_icount;
+    memcpy(result.before_hash, before_hash, 32);
+    memcpy(result.after_hash, after_hash, 32);
+    payload = qemu_crucible_fault_node_result_payload(
+        rule, before_hash, after_hash);
+    crucible_fault_payload_sha256(payload, result.evidence_hash);
+
+    g_mutex_lock(&crucible_fault_lock);
+    g_assert(crucible_deferred_count != 0);
+    result.observed_tick = crucible_fault_take_deferred_source_tick(
+        result.command_sequence);
+    crucible_deferred_count--;
+    crucible_fault_queue_result(&result, g_steal_pointer(&payload));
+    completion = crucible_fault_completion_cb;
+    completion_userdata = crucible_fault_completion_userdata;
+    g_mutex_unlock(&crucible_fault_lock);
+    if (completion) {
+        completion(completion_userdata);
+    }
+}
+
+void qemu_crucible_fault_fail_deferred(
+    const QemuCrucibleFaultRule *rule, uint64_t observed_icount,
+    const uint8_t before_hash[32])
+{
+    struct qemu_plugin_crucible_fault_result result = { 0 };
+    g_autoptr(GByteArray) payload = NULL;
+    qemu_plugin_crucible_fault_completion_cb_t completion;
+    void *completion_userdata;
+
+    g_assert(rule);
+    result.command_kind = qemu_crucible_fault_rule_command_kind(rule);
+    result.status = CRUCIBLE_FAULT_STATUS_INTERNAL_ERROR;
+    result.phase = qemu_crucible_fault_rule_command_phase(rule);
+    result.semantic_version =
+        qemu_crucible_fault_rule_semantic_version(rule);
+    result.capability_version = 1;
+    result.command_sequence =
+        qemu_crucible_fault_rule_command_sequence(rule);
+    result.observed_icount = observed_icount;
+    memcpy(result.before_hash, before_hash, 32);
+    memcpy(result.after_hash, before_hash, 32);
+    payload = qemu_crucible_fault_node_result_payload(
+        rule, before_hash, before_hash);
+    crucible_fault_payload_sha256(payload, result.evidence_hash);
+
+    g_mutex_lock(&crucible_fault_lock);
+    g_assert(crucible_deferred_count != 0);
+    result.observed_tick = crucible_fault_take_deferred_source_tick(
+        result.command_sequence);
+    crucible_deferred_count--;
+    crucible_fault_queue_result(&result, g_steal_pointer(&payload));
+    completion = crucible_fault_completion_cb;
+    completion_userdata = crucible_fault_completion_userdata;
+    g_mutex_unlock(&crucible_fault_lock);
+    if (completion) {
+        completion(completion_userdata);
+    }
+}
+
+static int crucible_fault_reject_submit(
+    const struct qemu_plugin_crucible_fault_command *command,
+    uint16_t status)
+{
+    struct qemu_plugin_crucible_fault_result result;
+
+    crucible_fault_result_rejected(&result, command, status,
+                                   qemu_plugin_icount_raw());
+    if (crucible_completed_count >= CRUCIBLE_FAULT_RESULT_QUEUE_CAPACITY) {
+        return -ENOSPC;
+    }
+    crucible_fault_queue_result(&result, NULL);
+    return 0;
+}
+
+static int crucible_fault_complete_rejected_submit(
+    const struct qemu_plugin_crucible_fault_command *command,
+    uint16_t status)
+{
+    qemu_plugin_crucible_fault_completion_cb_t completion =
+        crucible_fault_completion_cb;
+    void *completion_userdata = crucible_fault_completion_userdata;
+    int result = crucible_fault_reject_submit(command, status);
+
+    g_mutex_unlock(&crucible_fault_lock);
+    if (result == 0 && completion) {
+        completion(completion_userdata);
+    }
+    return result;
+}
+
+static size_t crucible_fault_capabilities_body(
+    struct qemu_plugin_crucible_fault_capability *out, size_t capacity)
+{
+    size_t required;
+    size_t i;
+
+    if (!qemu_crucible_fault_register_ensure_registered() ||
+        !qemu_crucible_fault_instruction_ensure_registered() ||
+        !qemu_crucible_fault_interrupt_ensure_registered() ||
+        !qemu_crucible_fault_hardware_error_ensure_registered() ||
+        !qemu_crucible_fault_clock_ensure_registered()) {
+        return 0;
+    }
+    qemu_crucible_fault_registry_seal();
+    g_mutex_lock(&crucible_fault_lock);
+    required = crucible_fault_handlers->len;
+    if (out && capacity >= required) {
+        for (i = 0; i < required; i++) {
+            const QemuCrucibleFaultHandler *handler =
+                g_ptr_array_index(crucible_fault_handlers, i);
+            out[i] = handler->capability;
+        }
+    }
+    g_mutex_unlock(&crucible_fault_lock);
+    return required;
+}
+
+size_t qemu_plugin_crucible_fault_capabilities(
+    struct qemu_plugin_crucible_fault_capability *out, size_t capacity)
+{
+    int status = qemu_plugin_crucible_initial_cpu_sdk_begin_v1();
+
+    if (status) {
+        return 0;
+    }
+    size_t result = crucible_fault_capabilities_body(out, capacity);
+
+    status = qemu_plugin_crucible_initial_cpu_sdk_post_v1(0);
+    return status ? 0 : result;
+}
+int qemu_plugin_crucible_fault_submit(
+    const struct qemu_plugin_crucible_fault_command *command,
+    const uint8_t *payload, size_t payload_len)
+{
+    const QemuCrucibleFaultHandler *handler;
+    CruciblePendingFault *pending;
+    int status;
+
+    if (!command || (payload_len != 0 && !payload)) {
+        return -EINVAL;
+    }
+    if (!qemu_plugin_crucible_single_threaded_rr()) {
+        return -EPERM;
+    }
+    qemu_crucible_fault_registry_seal();
+    g_mutex_lock(&crucible_fault_lock);
+    if (crucible_completed_count >= CRUCIBLE_FAULT_RESULT_QUEUE_CAPACITY) {
+        g_mutex_unlock(&crucible_fault_lock);
+        return -ENOSPC;
+    }
+    if (command->abi_major != CRUCIBLE_FAULT_COMMAND_ABI_MAJOR ||
+        command->abi_minor != CRUCIBLE_FAULT_COMMAND_ABI_MINOR ||
+        command->command_flags &
+            ~CRUCIBLE_FAULT_COMMAND_FLAG_PREPARE_ONLY ||
+        command->command_sequence == 0 ||
+        command->target_icount > command->authorization_ceiling_icount ||
+        command->target_tick > command->authorization_ceiling_tick ||
+        command->authorization_ceiling_tick > INT64_MAX ||
+        command->phase < CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY ||
+        command->phase > CRUCIBLE_FAULT_PHASE_DEVICE ||
+        payload_len > CRUCIBLE_FAULT_HARD_PAYLOAD_BYTES) {
+        return crucible_fault_complete_rejected_submit(
+            command, CRUCIBLE_FAULT_STATUS_MALFORMED_COMMAND);
+    }
+    if (!crucible_fault_accept_sequence(command->command_sequence)) {
+        return crucible_fault_complete_rejected_submit(
+            command, CRUCIBLE_FAULT_STATUS_DUPLICATE_SEQUENCE);
+    }
+    handler = crucible_fault_find_handler(command->command_kind,
+                                          command->semantic_version);
+    if (!handler) {
+        return crucible_fault_complete_rejected_submit(
+            command, CRUCIBLE_FAULT_STATUS_UNSUPPORTED_CAPABILITY);
+    }
+    if (!(handler->capability.phase_mask &
+          (1U << (command->phase - 1)))) {
+        return crucible_fault_complete_rejected_submit(
+            command, CRUCIBLE_FAULT_STATUS_INVALID_PHASE);
+    }
+    if (payload_len > handler->capability.maximum_payload_bytes ||
+        crucible_fault_handler_pending_count(handler) >=
+            handler->capability.maximum_pending_commands ||
+        qatomic_read(&crucible_pending_count) + crucible_deferred_count +
+                crucible_completed_count >=
+            CRUCIBLE_FAULT_RESULT_QUEUE_CAPACITY) {
+        return crucible_fault_complete_rejected_submit(
+            command, CRUCIBLE_FAULT_STATUS_RESOURCE_LIMIT);
+    }
+    if (handler->validate) {
+        status = crucible_fault_validate_command(
+            handler, command, payload, payload_len);
+        if (status != 0) {
+            return crucible_fault_complete_rejected_submit(
+                command, CRUCIBLE_FAULT_STATUS_MALFORMED_COMMAND);
+        }
+    }
+    if (command->command_kind == CRUCIBLE_FAULT_COMMAND_QUERY_CAPABILITIES) {
+        struct qemu_plugin_crucible_fault_result result;
+
+        memset(&result, 0, sizeof(result));
+        result.command_kind = command->command_kind;
+        result.status = CRUCIBLE_FAULT_STATUS_APPLIED;
+        result.phase = command->phase;
+        result.semantic_version = command->semantic_version;
+        result.command_sequence = command->command_sequence;
+        result.observed_icount = qemu_plugin_icount_raw();
+        result.observed_tick = qemu_plugin_sim_tick_observed();
+        result.applied_icount = result.observed_icount;
+        result.capability_version = 1;
+        crucible_fault_queue_result(&result, NULL);
+        g_mutex_unlock(&crucible_fault_lock);
+        return 0;
+    }
+
+    status = crucible_pending_new(handler, command, payload, payload_len,
+                                  NULL, &pending);
+    if (status) {
+        return crucible_fault_complete_rejected_submit(
+            command, CRUCIBLE_FAULT_STATUS_RESOURCE_LIMIT);
+    }
+    status = crucible_pending_arm(pending);
+    if (status) {
+        if (pending->control) {
+            crucible_pending_destroy(pending);
+        } else {
+            /* Preserve the existing non-node arm-refusal cleanup contract. */
+            g_free(pending->payload);
+            g_free(pending);
+        }
+        return crucible_fault_complete_rejected_submit(
+            command, CRUCIBLE_FAULT_STATUS_GUEST_REJECTED);
+    }
+    crucible_fault_insert_pending(pending);
+    qatomic_inc(&crucible_pending_count);
+    status = crucible_pending_locate(pending, CRUCIBLE_PENDING_QUEUED);
+    if (status) {
+        /* A negative post does not erase the actual published row. */
+        return crucible_fault_complete_rejected_submit(
+            command, CRUCIBLE_FAULT_STATUS_RESOURCE_LIMIT);
+    }
+    g_mutex_unlock(&crucible_fault_lock);
+    return 0;
+}
+
+int qemu_plugin_crucible_fault_cancel(uint64_t command_sequence)
+{
+    CruciblePendingFault *pending;
+
+    g_mutex_lock(&crucible_fault_lock);
+    QTAILQ_FOREACH(pending, &crucible_pending_faults, link) {
+        if (pending->command.command_sequence == command_sequence) {
+            QTAILQ_REMOVE(&crucible_pending_faults, pending, link);
+            qatomic_dec(&crucible_pending_count);
+            int status = crucible_pending_locate(pending, CRUCIBLE_PENDING_DETACHED);
+
+            if (!status) {
+                status = crucible_pending_destroy(pending);
+            }
+            g_mutex_unlock(&crucible_fault_lock);
+            return status;
+        }
+    }
+    g_mutex_unlock(&crucible_fault_lock);
+    return -ENOENT;
+}
+
+void qemu_crucible_fault_dispatch_boundary(uint16_t phase,
+                                           uint64_t observed_icount)
+{
+    int64_t observed_tick = qemu_plugin_sim_tick_observed();
+    bool lifecycle_downtime = phase == CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY &&
+        qemu_crucible_fault_lifecycle_downtime_pending();
+
+    if (observed_tick < 0) {
+        error_report("Crucible fault dispatch observed negative logical time");
+        abort();
+    }
+    qemu_plugin_crucible_exact_boundary_enter();
+    if (lifecycle_downtime) {
+        /* Downtime is a node-wide pause; only its completion may run. */
+        qemu_crucible_fault_lifecycle_downtime_boundary(
+            phase, observed_icount);
+    } else {
+        for (guint i = 0;
+             crucible_boundary_observers &&
+             i < crucible_boundary_observers->len;
+             i++) {
+            QemuCrucibleFaultBoundaryObserverFn observer =
+                g_ptr_array_index(crucible_boundary_observers, i);
+
+            observer(phase, observed_icount);
+        }
+    }
+    for (;;) {
+        CruciblePendingFault *pending = NULL;
+        struct qemu_plugin_crucible_fault_result result;
+        GByteArray *result_payload;
+        int status;
+        bool deferred = false;
+
+        observed_tick = qemu_plugin_sim_tick_observed();
+        if (observed_tick < 0) {
+            error_report("Crucible fault dispatch time regressed");
+            abort();
+        }
+
+        g_mutex_lock(&crucible_fault_lock);
+        QTAILQ_FOREACH(pending, &crucible_pending_faults, link) {
+            if (pending->command.phase == phase &&
+                pending->command.target_tick <= (uint64_t)observed_tick) {
+                break;
+            }
+        }
+        if (!pending) {
+            g_mutex_unlock(&crucible_fault_lock);
+            break;
+        }
+        QTAILQ_REMOVE(&crucible_pending_faults, pending, link);
+        qatomic_dec(&crucible_pending_count);
+        status = crucible_pending_locate(pending, CRUCIBLE_PENDING_DETACHED);
+        g_mutex_unlock(&crucible_fault_lock);
+        if (status) {
+            /* Actual producer membership retains this detached row. */
+            break;
+        }
+        result_payload = g_byte_array_new();
+        memset(&result, 0, sizeof(result));
+        result.command_kind = pending->command.command_kind;
+        result.phase = phase;
+        result.semantic_version = pending->command.semantic_version;
+        result.command_sequence = pending->command.command_sequence;
+        result.observed_icount = observed_icount;
+        result.observed_tick = observed_tick;
+        result.capability_version = 1;
+        if ((lifecycle_downtime ||
+             qemu_crucible_fault_lifecycle_downtime_pending()) &&
+            pending->command.command_kind !=
+                CRUCIBLE_FAULT_COMMAND_BOUNDARY_PROBE) {
+            result.status = CRUCIBLE_FAULT_STATUS_NOT_APPLICABLE;
+        } else if ((uint64_t)observed_tick > pending->command.target_tick ||
+            (uint64_t)observed_tick >
+                pending->command.authorization_ceiling_tick) {
+            result.status = CRUCIBLE_FAULT_STATUS_PAST_BOUNDARY;
+        } else {
+            status = crucible_pending_callback_begin(pending, CRUCIBLE_PENDING_PREPARE);
+            if (!status) {
+                int first = pending->handler->prepare(
+                    &pending->command, pending->payload, pending->payload_len,
+                    pending->handler_state, &result, result_payload);
+                int post = crucible_pending_callback_post(
+                    pending, CRUCIBLE_PENDING_PREPARE, first);
+
+                status = first ? first : post;
+            }
+            if (status != 0) {
+                if (result.status == 0 ||
+                    result.status == CRUCIBLE_FAULT_STATUS_APPLIED) {
+                    result.status = CRUCIBLE_FAULT_STATUS_INTERNAL_ERROR;
+                }
+            } else if (pending->command.command_flags &
+                       CRUCIBLE_FAULT_COMMAND_FLAG_PREPARE_ONLY) {
+                result.status = CRUCIBLE_FAULT_STATUS_PREPARED;
+                memcpy(result.after_hash, result.before_hash,
+                       sizeof(result.after_hash));
+            } else {
+                status = crucible_pending_callback_begin(pending, CRUCIBLE_PENDING_COMMIT);
+                if (status) {
+                    error_report("Crucible fault commit lost pending custody");
+                    abort();
+                }
+                pending->handler->commit(
+                    &pending->command, pending->payload,
+                    pending->payload_len, pending->handler_state,
+                    &result, result_payload);
+                status = crucible_pending_callback_post(pending, CRUCIBLE_PENDING_COMMIT, 0);
+                if (status) {
+                    error_report("Crucible fault commit returned with uncertain custody");
+                    abort();
+                }
+                deferred = result.status ==
+                    QEMU_CRUCIBLE_FAULT_STATUS_DEFERRED_INTERNAL;
+                if (!deferred &&
+                    (result.status != CRUCIBLE_FAULT_STATUS_APPLIED ||
+                     result.applied_icount != observed_icount)) {
+                    error_report(
+                        "Crucible fault commit violated its infallible contract");
+                    abort();
+                }
+            }
+        }
+        if (!deferred && result.status != CRUCIBLE_FAULT_STATUS_APPLIED) {
+            result.applied_icount = 0;
+            memcpy(result.after_hash, result.before_hash,
+                   sizeof(result.after_hash));
+        }
+        g_mutex_lock(&crucible_fault_lock);
+        if (deferred) {
+            guint64 *sequence = g_new(guint64, 1);
+            uint64_t *source_tick = g_new(uint64_t, 1);
+
+            *sequence = result.command_sequence;
+            *source_tick = result.observed_tick;
+            g_assert(!g_hash_table_contains(
+                crucible_deferred_source_ticks, sequence));
+            g_hash_table_insert(crucible_deferred_source_ticks,
+                                sequence, source_tick);
+            crucible_deferred_count++;
+        }
+        if (!deferred) {
+            crucible_fault_queue_result(&result, result_payload);
+            result_payload = NULL;
+        }
+        g_clear_pointer(&result_payload, g_byte_array_unref);
+        crucible_pending_destroy(pending);
+        qemu_plugin_crucible_fault_completion_cb_t completion =
+            crucible_fault_completion_cb;
+        void *completion_userdata = crucible_fault_completion_userdata;
+
+        g_mutex_unlock(&crucible_fault_lock);
+        if (!deferred && completion) {
+            completion(completion_userdata);
+        }
+    }
+    qemu_plugin_crucible_exact_boundary_leave();
+}
+
+void qemu_plugin_register_crucible_fault_completion_cb(
+    qemu_plugin_crucible_fault_completion_cb_t cb, void *userdata)
+{
+    g_mutex_lock(&crucible_fault_lock);
+    crucible_fault_completion_userdata = userdata;
+    crucible_fault_completion_cb = cb;
+    g_mutex_unlock(&crucible_fault_lock);
+}
