+int qemu_crucible_checkpoint_inventory_prepare_current_v1(void *monitor)
+{
+    QemuCrucibleCheckpointInventoryLoan *parent = NULL;
+    QemuCrucibleRamInventoryCaptureLoan *capture = NULL;
+    int status, post, returned;
+
+    if (monitor != monitor_cur() || !qemu_in_main_thread() || !bql_locked() ||
+        qemu_in_coroutine()) {
+        return -EPERM;
+    }
+    status = qemu_crucible_checkpoint_inventory_cleanup_borrow_v1(monitor, &parent);
+    if (status) {
+        return status;
+    }
+    if (parent) {
+        status = qemu_crucible_ram_inventory_capture_cleanup_borrow_v1(parent, &capture);
+        returned = qemu_crucible_checkpoint_inventory_output_close_v1(parent);
+        if (!status) {
+            status = returned;
+        }
+        post = qemu_crucible_checkpoint_inventory_post_v1(parent, status);
+        if (capture) {
+            returned = qemu_crucible_ram_inventory_capture_end_v1(&capture);
+            if (!status) {
+                status = returned;
+            }
+        }
+        if (!capture) {
+            returned = qemu_crucible_checkpoint_inventory_end_v1(&parent, status);
+            if (!status) {
+                status = returned;
+            }
+        }
+        if (!status) {
+            status = post;
+        }
+        if (status || capture || parent) {
+            return status ? status : -EBUSY;
+        }
+    }
+    returned = qemu_crucible_ram_metadata_cleanup_before_entry();
+    if (returned) {
+        return returned;
+    }
+    /* The earlier genuine ARM/Begin and completed ordinary Stop are retained;
+     * this command selects them, never creates authority from its fd names. */
+    return qemu_crucible_checkpoint_capture_request_current_v1(monitor);
+}
