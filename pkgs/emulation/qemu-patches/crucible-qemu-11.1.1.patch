+    g_assert_cmpint(timers_state.crucible_sim_tick_bias, ==, 0);
+    /* The RR settlement has just rearmed the original paused request. */
+    service_events();
+    g_assert_cmpuint(control_calls, ==, 1);
+    g_assert_true(qemu_plugin_crucible_vmstop_quiesced());
+    service_events();
+    g_assert_cmpuint(control_calls, ==, 1);
