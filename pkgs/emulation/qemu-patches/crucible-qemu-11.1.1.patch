+int qemu_crucible_checkpoint_capture_request_current_v1(void *monitor)
+{
+    QemuCrucibleCheckpointHeldTransaction *owner = &checkpoint_transaction;
+    QemuCrucibleCheckpointRequestLoan *request = &checkpoint_request;
+    int status = checkpoint_identity(owner);
+
+    if (!status && !owner->stopped) {
+        status = qemu_crucible_checkpoint_bind_stop_v1(owner);
+    }
+    if (status || owner->request != request || request->monitor != monitor ||
+        !request->main_scope_active || request->end_requested ||
+        request->snapshot_birth_pending || request->snapshot_issued ||
+        !request->provider_acquired || request->provider_ended ||
+        request->request_owner != &checkpoint_main_owner ||
+        !qatomic_load_acquire(&checkpoint_main_owner.published) ||
+        !checkpoint_main_owner.allocation_retained ||
+        !owner->stopped || owner->prepare_called || owner->pager_held ||
+        owner->proof.retained || owner->release_started || owner->candidate_started) {
+        return status ? status : -EPERM;
+    }
+    /* The resolver remains admitted for device pre-save. Only the later
+     * physical collector and registered PREPARE can issue the RAM cut.
+     */
+    return checkpoint_provider_check_main(request);
+}
