+        test_build_poison(
+            "{\"kind\":\"corrected\",\"parameters\":{\"xor_mask\":\"ff\"}}");
+    } else if (strcmp(scenario, "fetch-poison-corrected-x86") == 0) {
+        test_deferred_submission = false;
+        test_kind = 5;
+        test_build_poison(
+            "{\"kind\":\"corrected\",\"parameters\":{\"xor_mask\":\"ff\"}}");
+    } else if (strcmp(scenario, "fetch-poison-corrected-aarch64") == 0) {
+        test_deferred_submission = false;
+        test_kind = 5;
+        test_build_poison(
+            "{\"kind\":\"corrected\",\"parameters\":{\"xor_mask\":\"e01f\"}}");
+    } else if (strcmp(scenario, "poison-access-error") == 0) {
+        test_kind = 5;
+        test_build_poison("{\"kind\":\"access_error\"}");
