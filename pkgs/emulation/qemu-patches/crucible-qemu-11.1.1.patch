@@ -0,0 +1,833 @@
+/*
+ * Literal PIT fullword arithmetic, physical timers and exact migration.
+ * Clock/final callback consumers are diagnostic; QOM, architectural IRQ,
+ * KVM ioctl and native fault-service authority are excluded.
+ * Copyright (c) 2026 Andyl, Inc.
+ * SPDX-License-Identifier: MIT
+ */
+#include "qemu/osdep.h"
+#include "qemu/module.h"
+#include "qemu/main-loop.h"
+#include "system/cpu-timers.h"
+#include "io/channel-buffer.h"
+#include "../../migration/qemu-file.h"
+#include "migration/savevm.h"
+
+#undef type_init
+#define type_init(function) \
+    static void *const excluded_##function __attribute__((unused)) = function;
+#include "../../hw/timer/i8254_common.c"
+#include "../../hw/timer/i8254.c"
+
+/* The startup route uses real QEMU IRQ objects, without realizing ISA/QOM
+ * device classes. Only the inactive fault-service boundary is modeled. */
+#undef type_init
+#define type_init(function) module_init(function, MODULE_INIT_QOM)
+#include "../../hw/core/irq.c"
+
+bool qemu_crucible_fault_clock_source_active(
+    uint16_t source_kind, uint32_t source_index)
+{
+    return false;
+}
+
+/* No registered fault-service timer may fire in this startup fixture. */
+bool qemu_crucible_fault_clock_timer_fire(
+    uint16_t source_kind, uint32_t instance, uint16_t timer_role,
+    uint32_t timer_index, uint64_t timer_arm_sequence,
+    uint64_t guest_deadline_ps, uint64_t scheduler_deadline_ps,
+    uint64_t transform_generation)
+{
+    g_assert_not_reached();
+}
+
+void qemu_crucible_fault_clock_event_terminal_at(
+    const char *source_file, unsigned int source_line)
+{
+    g_assert_not_reached();
+}
+
+static __int128 observed_ps;
+static unsigned fired;
+
+int64_t cpu_get_clock(void)
+{
+    g_assert_true(observed_ps / 1000 <= INT64_MAX);
+    g_assert_true(observed_ps / 1000 >= INT64_MIN);
+    return observed_ps / 1000;
+}
+
+static __int128 diagnostic_clock(void)
+{
+    return observed_ps;
+}
+
+typedef struct WideCoordinate {
+    int64_t hi;
+    uint64_t lo;
+} WideCoordinate;
+
+static __int128 coordinate(WideCoordinate value)
+{
+    return pit_wide_join(value.hi, value.lo);
+}
+
+static void assert_coordinate(__int128 actual, __int128 expected)
+{
+    g_assert_cmpint((int64_t)(actual >> 64), ==, (int64_t)(expected >> 64));
+    g_assert_cmpuint((uint64_t)actual, ==, (uint64_t)expected);
+}
+
+static void timer_consumer(void *opaque)
+{
+    fired++;
+}
+
+static void initialize_timers(PITCommonState *state)
+{
+    memset(state, 0, sizeof(*state));
+    for (unsigned index = 0; index < 3; index++) {
+        state->channels[index].count = 65536;
+        state->channels[index].mode = 3;
+        state->channels[index].next_transition_time = -1;
+    }
+    /* The real emulated device has one physical IRQ timer, on channel zero. */
+    state->channels[0].irq_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL,
+                                               timer_consumer, state);
+}
+
+static void destroy_timers(PITCommonState *state)
+{
+    timer_free(state->channels[0].irq_timer);
+}
+
+static int timer_fixture_post_load(void *opaque, int version)
+{
+    PITCommonState *state = opaque;
+    int status = pit_timer_validate_load(state);
+
+    if (!status) {
+        if (state->wide_clock_loaded) {
+            pit_timer_restore(state);
+        } else {
+            /* The ordinary class fallback uses the parent transition shadow.
+             * This explicit diagnostic effect excludes QOM class dispatch.
+             */
+            PITChannelState *channel = &state->channels[0];
+
+            if (channel->next_transition_time != -1 && !channel->irq_disabled) {
+                timer_mod(channel->irq_timer, channel->next_transition_time);
+            }
+        }
+    }
+    return status;
+}
+
+/* This copies the exact production channel table and exact subsection. Only
+ * QOM class pre_save/post_load dispatch is replaced by its literal timer core.
+ */
+static const VMStateDescription timer_fixture = {
+    .name = "i8254",
+    .version_id = 3,
+    .minimum_version_id = 2,
+    .pre_save = pit_timer_wide_pre_save,
+    .pre_load = pit_common_pre_load,
+    .post_load = timer_fixture_post_load,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT32_V(channels[0].irq_disabled, PITCommonState, 3),
+        VMSTATE_STRUCT_ARRAY(channels, PITCommonState, 3, 2,
+                             vmstate_pit_channel, PITChannelState),
+        VMSTATE_INT64(channels[0].next_transition_time, PITCommonState),
+        VMSTATE_END_OF_LIST(),
+    },
+    .subsections = (const VMStateDescription *const[]) {
+        &vmstate_pit_timer_wide,
+        NULL,
+    },
+};
+
+static GByteArray *save_state(PITCommonState *state)
+{
+    QIOChannelBuffer *output = qio_channel_buffer_new(4096);
+    QEMUFile *file = qemu_file_new_output(QIO_CHANNEL(output));
+    GByteArray *bytes = g_byte_array_new();
+    Error *error = NULL;
