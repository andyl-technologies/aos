+                                  &region_offset, cancellation_fd, errp) ||
+            region_index >= regions->len || length == 0 ||
+            length > CRUCIBLE_RESTORE_RECORD_MAX_BYTES ||
+            !QEMU_IS_ALIGNED(length, TARGET_PAGE_SIZE) ||
+            !QEMU_IS_ALIGNED(region_offset, TARGET_PAGE_SIZE)) {
+            if (!*errp) {
+                error_setg(errp, "Invalid Crucible checkpoint RAM record header");
+            }
+            return false;
+        }
+        region = &g_array_index(regions, CrucibleRestoreRegion, region_index);
+        if (region_offset > region->length ||
+            length > region->length - region_offset ||
+            length > layer->bytes - offset) {
+            error_setg(errp, "Crucible checkpoint RAM record exceeds its "
+                       "region or input");
+            return false;
+        }
+        if (layer->kind == 1) {
+            uint64_t expected_length;
+
+            if (region_index != direct_region || region_offset != direct_offset) {
+                error_setg(errp, "Direct Crucible checkpoint RAM records are "
+                           "not canonical and complete");
+                return false;
+            }
+            expected_length = MIN(region->length - direct_offset,
+                                  CRUCIBLE_RESTORE_RECORD_MAX_BYTES);
+            if (length != expected_length) {
+                error_setg(errp, "Direct Crucible checkpoint RAM record has "
+                           "a noncanonical length");
+                return false;
+            }
+            direct_offset += length;
+            if (direct_offset == region->length) {
+                direct_region++;
+                direct_offset = 0;
+            }
+        } else {
+            if (last_delta_region != UINT32_MAX &&
+                (region_index < last_delta_region ||
+                 (region_index == last_delta_region &&
+                  region_offset < last_delta_end))) {
+                error_setg(errp, "Delta Crucible checkpoint RAM records "
+                           "overlap or are out of order");
+                return false;
+            }
+            last_delta_region = region_index;
+            last_delta_end = region_offset + length;
+        }
+        if (apply && !crucible_restore_read(
+                layer->fd, layer->bytes, offset,
+                (uint8_t *)qemu_ram_get_host_addr(region->ram_block) +
+                    region_offset,
+                length, cancellation_fd, errp)) {
+            return false;
+        }
+        offset += length;
+    }
+    if ((layer->kind == 1 &&
+         (direct_region != region_count || direct_offset != 0)) ||
+        offset != total_bytes) {
+        error_setg(errp, "Crucible checkpoint RAM payload is incomplete or "
+                   "has trailing bytes");
+        return false;
+    }
+    return true;
+}
+
+static bool crucible_restore_zero_digest(const uint8_t digest[32])
+{
+    static const uint8_t zero[32];
+
+    return memcmp(digest, zero, sizeof(zero)) == 0;
+}
+
+static char *crucible_restore_digest_hex(const uint8_t digest[32])
+{
+    char *encoded = g_malloc(65);
+
+    for (size_t index = 0; index < 32; index++) {
+        snprintf(encoded + index * 2, 3, "%02x", digest[index]);
+    }
+    return encoded;
+}
+
+static int crucible_restore_device_state(int fd, Error **errp)
+{
+    QIOChannelFile *channel;
+    QEMUFile *file;
+    int status;
+    int close_status;
+
+    if (lseek(fd, 0, SEEK_SET) < 0) {
+        status = -errno;
+        error_setg_errno(errp, errno,
+                         "Could not rewind Crucible checkpoint device VMState");
+        close(fd);
+        return status;
+    }
+    channel = qio_channel_file_new_fd(fd);
+    file = qemu_file_new_input(QIO_CHANNEL(channel));
+    object_unref(OBJECT(channel));
+    if (qemu_get_be32(file) != QEMU_VM_FILE_MAGIC ||
+        qemu_get_be32(file) != QEMU_VM_FILE_VERSION) {
+        status = -EINVAL;
+        error_setg(errp, "Invalid Crucible checkpoint device VMState header");
+    } else {
+        status = qemu_load_device_state(file, errp);
+    }
+    if (status == 0) {
+        status = qemu_file_get_error_obj(file, errp);
+    }
+    close_status = qemu_fclose(file);
+    if (status == 0 && close_status < 0) {
+        status = close_status;
+    }
+    if (status != 0 && !*errp) {
+        error_setg_errno(errp, status < 0 ? -status : EIO,
+                         "Could not restore Crucible checkpoint device VMState");
+    }
+    return status;
+}
+
+CrucibleCheckpointRestore *qemu_crucible_checkpoint_restore(
+    CrucibleCheckpointRestoreInput *inputs, size_t input_count,
+    int device_fd, int cancellation_fd, const char *device_sha256,
+    const char *checkpoint_sha256, const char *target_sha256,
+    const char *frontier_sha256, uint64_t maximum_device_bytes,
+    Error **errp)
+{
+    g_autofree CrucibleRestoreLayer *layers = NULL;
+    CrucibleCheckpointRestore *report = NULL;
+    uint8_t expected_checkpoint[32];
+    uint8_t expected_target[32];
+    uint8_t expected_frontier[32];
+    uint64_t device_bytes = 0;
+    dev_t device_device = 0;
+    ino_t device_inode = 0;
+    uint64_t total_ram_bytes = 0;
+    bool reserved = false;
+    bool state_changed = false;
+    int status;
+
+    if (!crucible_restore_exact_paused_boundary()) {
+        error_setg(errp, "Crucible checkpoint restore requires the exact "
+                   "paused deterministic simulator boundary");
+        goto out;
+    }
+    if (qemu_crucible_checkpoint_candidate_active()) {
+        error_setg(errp, "Cannot restore while a Crucible checkpoint "
+                   "candidate is active");
+        goto out;
+    }
+    if (input_count == 0 || input_count > CRUCIBLE_RESTORE_LAYER_MAX ||
+        !crucible_restore_hex(checkpoint_sha256, expected_checkpoint,
+                              "checkpoint identity", errp) ||
+        !crucible_restore_hex(target_sha256, expected_target,
+                              "target identity", errp) ||
+        !crucible_restore_hex(frontier_sha256, expected_frontier,
+                              "frontier identity", errp)) {
+        if (!*errp) {
+            error_setg(errp, "Crucible checkpoint restore layer count is "
+                       "outside its bound");
+        }
+        goto out;
+    }
+    status = migration_crucible_checkpoint_restore_begin();
+    if (status != 0) {
+        error_setg_errno(errp, -status,
+                         "Crucible checkpoint restore is unavailable");
+        goto out;
+    }
+    reserved = true;
+    layers = g_new0(CrucibleRestoreLayer, input_count);
+    for (size_t index = 0; index < input_count; index++) {
+        layers[index].fd = -1;
+    }
+    for (size_t index = 0; index < input_count; index++) {
+        layers[index].fd = inputs[index].fd;
+        inputs[index].fd = -1;
+        if (!crucible_restore_regular_input(
+                layers[index].fd, inputs[index].maximum_bytes,
+                &layers[index].bytes, &layers[index].device,
+                &layers[index].inode, "RAM layer", errp) ||
+            !crucible_restore_authenticate(
+                layers[index].fd, layers[index].bytes, inputs[index].sha256,
+                cancellation_fd, errp) ||
+            !crucible_restore_parse_layer(&layers[index], cancellation_fd,
+                                          false, errp)) {
+            goto out;
+        }
+        for (size_t prior = 0; prior < index; prior++) {
+            if (layers[index].device == layers[prior].device &&
+                layers[index].inode == layers[prior].inode) {
+                error_setg(errp, "Crucible checkpoint restore RAM layers must not alias");
+                goto out;
+            }
+        }
+        if (index == 0) {
+            if (layers[index].kind != 1 ||
+                !crucible_restore_zero_digest(layers[index].parent_checkpoint) ||
+                !crucible_restore_zero_digest(layers[index].parent_target) ||
+                !crucible_restore_zero_digest(layers[index].parent_frontier)) {
+                error_setg(errp, "Crucible checkpoint restore chain must "
+                           "begin with one parentless direct layer");
+                goto out;
+            }
+        } else if (layers[index].kind != 2 ||
+                   memcmp(layers[index].parent_checkpoint,
+                          layers[index - 1].checkpoint, 32) != 0 ||
+                   memcmp(layers[index].parent_target,
+                          layers[index - 1].target, 32) != 0 ||
+                   memcmp(layers[index].parent_frontier,
+                          layers[index - 1].frontier, 32) != 0 ||
+                   memcmp(layers[index].topology,
+                          layers[0].topology, 32) != 0) {
+            error_setg(errp, "Crucible checkpoint restore delta chain or "
+                       "topology is discontinuous");
+            goto out;
+        }
+        if (layers[index].bytes > UINT64_MAX - total_ram_bytes) {
+            error_setg(errp, "Crucible checkpoint restore RAM byte count overflowed");
+            goto out;
+        }
+        total_ram_bytes += layers[index].bytes;
+    }
+    if (memcmp(layers[input_count - 1].checkpoint,
+               expected_checkpoint, 32) != 0 ||
+        memcmp(layers[input_count - 1].target, expected_target, 32) != 0 ||
+        memcmp(layers[input_count - 1].frontier, expected_frontier, 32) != 0 ||
+        !crucible_restore_regular_input(
+            device_fd, maximum_device_bytes, &device_bytes, &device_device,
+            &device_inode, "device VMState", errp) ||
+        !crucible_restore_authenticate(device_fd, device_bytes,
+                                       device_sha256, cancellation_fd, errp)) {
+        if (!*errp) {
+            error_setg(errp, "Final Crucible checkpoint restore identity "
+                       "does not match its request");
+        }
+        goto out;
+    }
+    for (size_t index = 0; index < input_count; index++) {
+        if (device_device == layers[index].device &&
+            device_inode == layers[index].inode) {
+            error_setg(errp, "Crucible checkpoint RAM and device inputs must not alias");
+            goto out;
+        }
+    }
+
+    qemu_system_reset(SHUTDOWN_CAUSE_SNAPSHOT_LOAD);
+    state_changed = true;
+    for (size_t index = 0; index < input_count; index++) {
+        if (!crucible_restore_parse_layer(&layers[index], cancellation_fd,
+                                          true, errp) ||
+            !crucible_restore_authenticate(
+                layers[index].fd, layers[index].bytes, inputs[index].sha256,
+                cancellation_fd, errp)) {
+            goto out;
+        }
+    }
+    status = crucible_restore_device_state(device_fd, errp);
+    device_fd = -1;
+    if (status != 0) {
+        goto out;
+    }
+    tb_flush__exclusive_or_serial();
+    if (!qemu_crucible_checkpoint_restore_authority_succeeded(
+            checkpoint_sha256, target_sha256, frontier_sha256,
+            layers[input_count - 1].topology, errp)) {
+        goto out;
+    }
+
+    report = g_new0(CrucibleCheckpointRestore, 1);
+    report->schema_version = CRUCIBLE_RESTORE_SCHEMA_VERSION;
+    report->checkpoint_sha256 = g_strdup(checkpoint_sha256);
+    report->target_sha256 = g_strdup(target_sha256);
+    report->frontier_sha256 = g_strdup(frontier_sha256);
+    report->topology_sha256 = crucible_restore_digest_hex(
+        layers[input_count - 1].topology);
+    report->ram_layers = input_count;
+    report->ram_bytes = total_ram_bytes;
+    report->device_bytes = device_bytes;
+
+out:
+    if (state_changed && !report) {
+        qemu_crucible_checkpoint_restore_authority_failed();
+    }
+    if (reserved) {
+        migration_crucible_checkpoint_capture_end();
+    }
+    if (layers) {
+        for (size_t index = 0; index < input_count; index++) {
+            if (layers[index].fd >= 0) {
+                close(layers[index].fd);
+            }
+        }
+    }
+    for (size_t index = 0; index < input_count; index++) {
+        if (inputs[index].fd >= 0) {
+            close(inputs[index].fd);
+            inputs[index].fd = -1;
+        }
+    }
+    if (device_fd >= 0) {
+        close(device_fd);
+    }
+    return report;
+}
diff --git a/system/crucible-checkpoint.c b/system/crucible-checkpoint.c
