diff --git a/tests/unit/test-crucible-startup-source.c b/tests/unit/test-crucible-startup-source.c
new file mode 100644
index 0000000000000000000000000000000000000000..5ed28a50861faad97bf23051ba3cba2c852c5480
--- /dev/null
+++ b/tests/unit/test-crucible-startup-source.c
@@ -0,0 +1,6383 @@
+/*
+ * Actual Source lifecycle, accounting and registration controls.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * The fixture include discloses the prepared-family and linkage providers;
+ * the scenarios below execute the literal Source and extracted integration
+ * bodies. No fixture issues a production launch, artifact or process contract.
+ */
+#include "crucible-startup-source-fixture.inc.h"
+#include "qobject/json-writer.h"
+#include "qemu/module.h"
+
+static void scenario_healthy(void)
+{
+    uint64_t bounded = UINT64_MAX;
+
+    fixture_prepare(0, false);
+    g_assert_cmpint(fixture_acquire(), ==, 0);
+    g_assert_cmpint(qemu_plugin_crucible_startup_source_query_slice_v1(
+                       fixture.ctx.id, &bounded), ==, 0);
+    g_assert_cmpuint(bounded, >, 0);
+    g_assert_cmpuint(bounded, <=, 1000000);
+    g_assert_cmpint(qemu_plugin_crucible_startup_source_check_v1(
+                       fixture.ctx.id), ==, 0);
+    g_assert_cmpint(
+        qemu_plugin_crucible_startup_source_registration_complete_v1(
+            fixture.ctx.id, 0), ==, 0);
+    g_assert_cmpint(plugin_startup_source_install_leave(&fixture.ctx, 0), ==, 0);
+    fixture.ctx.installing = false;
+    bounded = UINT64_MAX;
+    g_assert_cmpint(qemu_plugin_crucible_startup_source_query_slice_v1(
+                       fixture.ctx.id, &bounded), ==, -EPERM);
+    g_assert_cmpuint(bounded, ==, UINT64_MAX);
+    assert_retained();
+}
+
+static void scenario_cancel(void)
+{
+    uint64_t bounded = UINT64_MAX;
+    uint64_t unread = 0;
+
+    fixture_prepare(0, false);
+    g_assert_cmpint(fixture_acquire(), ==, 0);
+    fixture_signal();
+    g_assert_cmpint(qemu_plugin_crucible_startup_source_check_v1(
+                       fixture.ctx.id), ==, -ECANCELED);
+    g_assert_cmpint(qemu_plugin_crucible_startup_source_query_slice_v1(
+                       fixture.ctx.id, &bounded), ==, -ECANCELED);
+    g_assert_cmpuint(bounded, ==, UINT64_MAX);
+    g_assert_cmpint(
+        qemu_plugin_crucible_startup_source_registration_complete_v1(
+            fixture.ctx.id, -EIO), ==, -ECANCELED);
+    /* Fixture-only read after all Source assertions witnesses nonconsumption. */
+    g_assert_cmpint(read(12, &unread, sizeof(unread)), ==, sizeof(unread));
+    g_assert_cmpuint(unread, ==, 1);
+    assert_retained();
+}
+
+static void scenario_initial_event_cloexec(void)
+{
+    uint64_t bounded = UINT64_MAX;
+
+    fixture_prepare(0, false);
+    g_assert_cmpint(fcntl(12, F_SETFD, FD_CLOEXEC), ==, 0);
+    g_assert_cmpuint(metadata_close_calls, ==, 0);
+
+    g_assert_cmpint(fixture_acquire(), ==, -ESTALE);
+    g_assert_cmpuint(metadata_close_calls, ==, 0);
+    g_assert_cmpint(startup_source.metadata_fd, ==, -1);
+    g_assert_false(startup_source.metadata_close_uncertain);
+    g_assert_true(startup_source.owns_event);
+    g_assert_true(startup_source.birth_closed);
+    g_assert_false(startup_source.registration_completed);
+    g_assert_cmpint(fcntl(12, F_GETFD), ==, FD_CLOEXEC);
+    g_assert_cmpint(qemu_plugin_crucible_startup_source_query_slice_v1(
+                       fixture.ctx.id, &bounded), ==, -ESTALE);
+    g_assert_cmpuint(bounded, ==, UINT64_MAX);
+    g_assert_cmpuint(metadata_close_calls, ==, 0);
+    assert_retained();
+}
+
+static void scenario_event_cloexec(void)
+{
+    uint64_t bounded = UINT64_MAX;
+    unsigned prior_closes;
+
+    fixture_prepare(0, false);
+    g_assert_cmpint(fixture_acquire(), ==, 0);
+    prior_closes = metadata_close_calls;
+    g_assert_cmpint(fcntl(12, F_SETFD, FD_CLOEXEC), ==, 0);
+    g_assert_cmpint(qemu_plugin_crucible_startup_source_query_slice_v1(
+                       fixture.ctx.id, &bounded), ==, -ESTALE);
+    g_assert_cmpuint(bounded, ==, UINT64_MAX);
+    g_assert_cmpint(fcntl(12, F_GETFD), ==, FD_CLOEXEC);
+    g_assert_cmpuint(metadata_close_calls, ==, prior_closes);
+    g_assert_cmpint(qemu_plugin_crucible_startup_source_check_v1(
+                       fixture.ctx.id), ==, -ESTALE);
+    assert_retained();
+}
+
+static void scenario_deadline(void)
+{
+    uint64_t bounded = UINT64_MAX;
+
+    fixture_prepare(-1, false);
+    g_assert_cmpint(fixture_acquire(), ==, -ETIMEDOUT);
+    g_assert_cmpint(qemu_plugin_crucible_startup_source_query_slice_v1(
+                       fixture.ctx.id, &bounded), ==, -ETIMEDOUT);
+    g_assert_cmpuint(bounded, ==, UINT64_MAX);
+    assert_retained();
+}
+
+static void scenario_deadline_after(void)
+{
+    uint64_t bounded = UINT64_MAX;
+    uint64_t now;
+
+    fixture_prepare(2, false);
+    g_assert_cmpint(fixture_acquire(), ==, 0);
+    while ((now = fixture_now()) < fixture.original_end_ns) {
+        uint64_t remaining = fixture.original_end_ns - now;
+
+        g_usleep(MIN(UINT64_C(10000), (remaining + 999) / 1000));
+    }
+    g_assert_cmpint(qemu_plugin_crucible_startup_source_query_slice_v1(
+                       fixture.ctx.id, &bounded), ==, -ETIMEDOUT);
+    g_assert_cmpuint(bounded, ==, UINT64_MAX);
+    assert_retained();
+}
+
+static void scenario_metadata_close(void)
+{
+    uint64_t bounded = UINT64_MAX;
+
+    fixture_prepare(0, false);
+    inject_close_interruption = true;
+    g_assert_cmpint(fixture_acquire(), ==, -EINTR);
+    g_assert_true(startup_source.metadata_close_uncertain);
+    g_assert_cmpint(startup_source.metadata_fd, >=, 0);
+    g_assert_cmpuint(metadata_close_calls, ==, 1);
+    g_assert_cmpint(qemu_plugin_crucible_startup_source_query_slice_v1(
+                       fixture.ctx.id, &bounded), ==, -EINTR);
+    g_assert_cmpuint(bounded, ==, UINT64_MAX);
+    g_assert_cmpint(fixture_acquire(), ==, -EINTR);
+    g_assert_cmpuint(metadata_close_calls, ==, 1);
+    assert_retained();
+}
+
+static void scenario_future_start(void)
+{
+    fixture_prepare(1, false);
+    g_assert_cmpint(fixture_acquire(), ==, -ESTALE);
+    assert_retained();
+}
+
+static void *foreign_checks(void *opaque)
