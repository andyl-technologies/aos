+def function_definitions(source):
+    code = code_mask(source)
+    cursor = 0
+    depth = 0
+    for match in FUNCTION_DEFINITION.finditer(code):
+        prefix = code[cursor:match.start()]
+        depth += prefix.count("{") - prefix.count("}")
+        cursor = match.start()
+        if depth:
+            continue
+        body = function(source, source[match.start():match.end()], match.start())
+        yield match.group(1), match.start(), match.start() + len(body.rstrip("\n")), body
