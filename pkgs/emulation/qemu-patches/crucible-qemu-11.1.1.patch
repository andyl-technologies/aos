+bool qemu_async_worker_hot_fork_admission_try_begin(void)
+{
+    int held;
+
+    if (crucible_hot_fork_async_worker_admission_depth != 0) {
+        assert(crucible_hot_fork_async_worker_admission_depth != UINT32_MAX);
+        crucible_hot_fork_async_worker_admission_depth++;
+        return true;
+    }
+
+    held = qatomic_read(&crucible_hot_fork_async_worker_barrier_held);
+    if (held) {
+        return false;
+    }
+
+    qatomic_inc(&crucible_hot_fork_async_worker_admissions);
+    smp_mb_global();
+    held = qatomic_read(&crucible_hot_fork_async_worker_barrier_held);
+    if (held) {
+        qatomic_dec(&crucible_hot_fork_async_worker_admissions);
+        return false;
+    }
+
+    crucible_hot_fork_async_worker_admission_depth = 1;
+    return true;
+}
