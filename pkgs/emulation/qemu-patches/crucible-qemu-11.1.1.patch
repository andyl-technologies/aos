+    }
+    actual_child.borrow_holder = holder;
+    actual_child.borrow_serial_holder = serial;
+    actual_child.borrow_held = true;
+    qemu_thread_get_self(&actual_child.borrow_thread);
+    *holder = &actual_child.borrow_record;
+    *serial = ++actual_child.borrow_counter;
+    *known_absent = 0;
+    if (borrow_mode == 4) {
+        *known_absent = 1; /* Deliberately contradictory producer result. */
+    }
+    qemu_mutex_unlock(&actual_child.journal);
+    return borrow_mode == 2 ? -EIO : 0;
