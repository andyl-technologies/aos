+static int apic_getter_initial_dispatch(APICCommonState *apic,
+                                       APICCommonClass *klass)
+{
+    QemuCrucibleApicGetterFrame frame = {
+        .cpu = CPU(apic->cpu),
+        .child = OBJECT(apic),
+        .holder = &apic->crucible_getter_loan,
+        .process = getpid(),
+        .issuing = true,
+    };
+    int first, result = 0, post;
+
+    if (!bql_locked()) {
+        return -EPERM;
+    }
+    if (apic->crucible_getter_frame || apic->crucible_getter_loan) {
+        return -EDEADLK;
+    }
+
+    qemu_thread_get_self(&frame.thread);
+    apic->crucible_getter_frame = &frame;
+    first = qemu_crucible_source_apic_getter_begin_v1(
+        frame.cpu, &frame, frame.holder);
+    frame.issuing = false;
+    if (!first) {
+        frame.calling = true;
+        result = klass->get_tpr(apic);
+        frame.calling = false;
+        frame.callback_returned = true;
+        if (result < 0) {
+            first = result;
+        }
+    }
+
+    /* A failed first still receives an independent Original post. The Source
+     * journal separately records actual callback return and each own-pin unref;
+     * this stack return does not retire the APIC or its clock registration. */
+    frame.first_status = first;
+    frame.returning = true;
+    post = qemu_crucible_source_apic_getter_end_v1(
+        frame.cpu, &frame, frame.holder, first);
+    frame.returning = false;
+    if (apic->crucible_getter_frame != &frame) {
+        return first ? first : -ESTALE;
+    }
+    apic->crucible_getter_frame = NULL;
+
+    /* An uncertain Source return leaves the canonical loan occupied, so this
+     * producer cannot reenter or adopt a fresh frame over retained debt. */
+    return first ? first : (post ? post : result);
+}
