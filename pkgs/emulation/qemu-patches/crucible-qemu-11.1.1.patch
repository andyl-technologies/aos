+def lifetime_component(output_dir, negative_control):
+    """Exercise literal receive/delivery bodies with disclosed boundary inputs."""
+    extract = SUPPORT["EXTRACT"]
+    consumer = (ROOT / "plugins/crucible-command-consumer.inc.h").read_text()
+    child = (ROOT / "plugins/crucible-callback-child.inc.h").read_text()
+    helpers = "\n\n".join(extract["function"](source, signature) for source, signature in (
+        (consumer, "static int command_registry_identity("),
+        (child, "static bool callback_child_output_overlap("),
+        (child, "static bool callback_child_output_conflicts_except_locked("),
+        (child, "static bool callback_child_output_conflicts_locked("),
+    ))
+    bodies = receive_source()
+    if negative_control == "delivery-use-dependency":
+        statement = "        owner->use_users++;"
+        assert bodies.count(statement) == 1
+        bodies = bodies.replace(statement, "        /* deliberately omitted dependency */")
+    elif negative_control == "delivery-exact-output":
+        statement = "holder != (owner->transferred ? owner->runtime_holder : owner->creation_output)"
+        assert bodies.count(statement) == 1
+        bodies = bodies.replace(statement, "false")
+    elif negative_control == "delivery-reissue":
+        statement = "owner->held || receive->delivery_attempted ||"
+        assert bodies.count(statement) == 1
+        bodies = bodies.replace(statement, "owner->held ||")
+    generated = output_dir / "received-delivery-lifetime.c"
+    generated.write_text(LIFETIME_PRELUDE + RECEIVER_UNAVAILABLE_PROVIDERS + PUBLISHER_UNAVAILABLE_PROVIDERS + PUBLISHER_UNAVAILABLE_SLOT + MAIN_DISABLED_PROVIDERS + READY_DISABLED_PROVIDERS + helpers + bodies + LIFETIME_CHECKS)
+    binary = output_dir / "received-delivery-lifetime"
+    command = [os.environ.get("CC", "cc"),
+               *shlex.split(os.environ.get("CFLAGS", "")),
+               "-Wno-missing-prototypes", "-Wno-unused-function", "-Wno-unused-variable",
+               str(generated), *SUPPORT["native_link_arguments"](), "-o", str(binary),
+               *shlex.split(os.environ.get("LDFLAGS", ""))]
+    (output_dir / "lifetime-compile-command.json").write_text(json.dumps(command, indent=2) + "\n")
+    subprocess.run(command, check=True)
+    for scenario in ("healthy", "reader-negative", "post-negative", "invalid-progress",
+                     "no-request", "foreign-receive", "serial-overflow", "foreign-owner",
+                     "wrong-serial", "copied-create", "runtime-outside", "overlap",
+                     "foreign-thread", "foreign-process", "creation-return", "active-reader"):
+        subprocess.run([str(binary), scenario], cwd=output_dir, check=True)
+
+    if negative_control == "delivery-payload-debt":
+        statement = """owner->use_users || owner->ready_users || owner->payload_transition_active ||
+                    owner->payload_held || owner->payload_uncertain || owner->payload ||
+                    (owner->payload_serial && !owner->payload_returned)"""
+        assert bodies.count(statement) == 1
+        bodies = bodies.replace(statement, "owner->use_users || owner->ready_users || owner->payload_transition_active")
+    elif negative_control == "delivery-payload-consumption":
+        statement = "owner->payload_return_post = received_delivery_identity_locked(owner, serial);"
+        assert bodies.count(statement) == 1
+        bodies = bodies.replace(statement, statement +
+            "\n    if (owner->payload_return_post) { owner->payload_held = true; }")
+    membership = (ROOT / "plugins/crucible-command-membership.inc.h").read_text()
+    if negative_control == "delivery-payload-first-bound":
+        statement = "        .payload_claim = payload_claim,"
+        assert membership.count(statement) == 1
+        membership = membership.replace(statement, "        .payload_claim = NULL,")
+    constructors = "\n\n".join(extract["function"](membership, signature) for signature in (
+        "static bool command_member_advance_callbacks_valid(",
+        "static bool command_member_advance_receiver_callbacks_valid(",
+        "static bool command_member_advance_table_geometry(",
+        "static int command_member_create(",
+        "int qemu_plugin_crucible_startup_source_command_member_create_v2(",
+        "int qemu_plugin_crucible_startup_source_command_member_create_v3(",
+        "int qemu_plugin_crucible_startup_source_command_member_create_v4(",
+        "int qemu_plugin_crucible_startup_source_command_member_transfer_v1(",
+    ))
+    generated = output_dir / "received-delivery-payload.c"
+    generated.write_text(LIFETIME_PRELUDE + RECEIVER_UNAVAILABLE_PROVIDERS + PUBLISHER_UNAVAILABLE_PROVIDERS + MAIN_DISABLED_PROVIDERS + READY_DISABLED_PROVIDERS + PAYLOAD_PROVIDERS + helpers + constructors +
+                         bodies + LIFETIME_CHECKS.replace("int main(", "static int lifetime_main(") +
