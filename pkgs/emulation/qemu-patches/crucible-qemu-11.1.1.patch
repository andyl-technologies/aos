+int qemu_plugin_crucible_ram_control_receive_read_v1(
+    qemu_plugin_id_t id, qemu_plugin_crucible_ram_control_actor_v1 *actor,
+    qemu_plugin_crucible_ram_control_receive_v1 *receipt, size_t maximum_bytes,
+    size_t *received)
+{
+    uint64_t slice;
+    bool body;
+    int post;
+    int status = qemu_crucible_ram_control_actor_current(actor, id);
+
+    if (status) {
+        return status;
+    }
+
+    status = pthread_mutex_lock(&actor->dispatch_mutex);
+    if (status) {
+        return ram_control_failure(actor, -status, true);
+    }
+    if (receipt != &actor->receipt) {
+        return ram_control_record_unlock(actor, -EPERM);
+    }
+    body = receipt->frame_bytes != 0;
+    status = ram_control_record_unlock(actor, 0);
+    if (status) {
+        return status;
+    }
+    if (body) {
+        status = ram_control_record_query(actor, id, &slice);
+        if (status) {
+            return status;
+        }
+    }
+    status = pthread_mutex_lock(&actor->dispatch_mutex);
+    if (status) {
+        return ram_control_failure(actor, -status, true);
+    }
+    status = ram_control_receive_read_locked(id, actor, receipt, maximum_bytes,
+                                             received);
+    status = ram_control_record_unlock(actor, status);
+    if (!body && receipt->frame_bytes == 1) {
+        int acquire = ram_control_record_acquire(actor, id);
+
+        status = status ? status : acquire;
+    }
+    if (body || (!status && receipt->record.acquired)) {
+        /* Raw same-operation post is independent of native receive failure. */
+        post = ram_control_record_query(actor, id, &slice);
+        if (post) {
+            ram_control_failure(actor, post, true);
+            status = status ? status : post;
+        }
+    }
+    return status;
+}
