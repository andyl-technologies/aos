diff --git a/tests/unit/run-crucible-cached-writer.py b/tests/unit/run-crucible-cached-writer.py
new file mode 100644
index 0000000000000000000000000000000000000000..77d40b9250125b01426cceb462f84eada9b56317
--- /dev/null
+++ b/tests/unit/run-crucible-cached-writer.py
@@ -0,0 +1,45 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Check exact bounded child outcomes, including deliberate abort controls."""
+
+import argparse
+import json
+import resource
+import signal
+import subprocess
+import sys
+
+
+def limits():
+    resource.setrlimit(resource.RLIMIT_AS, (6 * 1024**3, 6 * 1024**3))
+    resource.setrlimit(resource.RLIMIT_CPU, (60, 60))
+    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('binary')
+    parser.add_argument('case')
+    parser.add_argument('outcome', choices=('success', 'deadlock', 'omitted-deadlock', 'assertion'))
+    parser.add_argument('assertion', nargs='?')
+    args = parser.parse_args()
+    if args.outcome == 'assertion' and not args.assertion:
+        parser.error('assertion outcome needs the exact invariant')
+    result = subprocess.run([args.binary, args.case], capture_output=True,
+                            text=True, preexec_fn=limits, timeout=10)
+    print(json.dumps({'case': args.case, 'expected': args.outcome,
+                      'returncode': result.returncode,
+                      'stdout': result.stdout, 'stderr': result.stderr}, indent=2))
+    if args.outcome == 'success':
+        valid = result.returncode == 0
+    elif args.outcome == 'omitted-deadlock':
+        valid = result.returncode == 0 and not result.stdout and not result.stderr
+    else:
+        message = ('qemu: qemu_thread_ram_writer_enter: Resource deadlock avoided'
+                   if args.outcome == 'deadlock'
+                   else 'Assertion `' + args.assertion + "' failed.")
+        valid = result.returncode == -signal.SIGABRT and message in result.stderr
+    return 0 if valid else 1
+
+
+if __name__ == '__main__':
+    sys.exit(main())
