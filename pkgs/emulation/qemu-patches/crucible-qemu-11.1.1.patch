+int main(void)
+{
+    lifecycle_checks();
+    mode_matrix();
+    deadline_and_hot_queries();
+    return 0;
+}
+"""
+
+
+def source_range(source, start, end):
+    """Extract a declaration group without modifying its text."""
+    return source[source.index(start):source.index(end)]
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--output-dir", type=Path, required=True)
+    parser.add_argument("--negative-control", choices=[
+        "publication-order", "callback-order", "shared-classification",
+        "stale-retry", "superclass-match", "repeated-name-query",
+        "predicate-order", "tick-name-query", "tick-icount-order",
+        "tick-observation-order", "tick-error-result", "tick-signed-result"])
+    arguments = parser.parse_args()
+    arguments.output_dir.mkdir(parents=True, exist_ok=True)
+    accel_header = (ROOT / "include/qemu/accel.h").read_text()
+    ops = (ROOT / "include/accel/accel-ops.h").read_text()
+    icount_header = (ROOT / "include/exec/icount.h").read_text()
+    declarations = "\n\n".join([
+        source_range(icount_header, "typedef enum {", "/* Ordinary -icount"),
+        source_range(accel_header, "typedef struct AccelGdbConfig {",
+                     "bool accel_supports_guest_debug"),
+        source_range(ops, "struct AccelState {", "#endif"),
+    ])
+    system = (ROOT / "accel/accel-system.c").read_text()
+    common = (ROOT / "accel/accel-common.c").read_text()
+    bodies = "\n\n".join([
+        definition(system, "int accel_init_machine("),
+        definition(system, "AccelState *current_accel("),
+        definition(system, "bool current_accel_is_sim("),
+        definition(common, "const char *current_accel_name("),
+    ])
+    classification = '    accel->is_sim = acc->name && strcmp(acc->name, "sim") == 0;'
+    assert bodies.count(classification) == 1
+    negative = arguments.negative_control
+    if negative in {"publication-order", "callback-order"}:
+        bodies = bodies.replace(classification + "\n", "")
+        anchor = ('    ms->accelerator = accel;' if negative == "publication-order"
+                  else '    ret = acc->init_machine(accel, ms);')
+        bodies = bodies.replace(anchor, anchor + "\n" + classification)
+    elif negative == "shared-classification":
+        bodies = 'static bool shared_sim;\n' + bodies.replace(
+            classification, classification + '\n    shared_sim = accel->is_sim;')
+        bodies = bodies.replace('return accel && accel->is_sim;',
+                                'return accel && shared_sim;')
+    elif negative == "stale-retry":
+        bodies = bodies.replace(classification,
+            '    static bool classified;\n    if (!classified) {\n' + classification +
+            '\n        classified = true;\n    }')
+    elif negative == "superclass-match":
+        # Preserve classification-provider effects so the negative exposes
+        # incorrect ancestry semantics rather than a missing comparison trace.
+        bodies = bodies.replace(classification,
+            '    accel->is_sim = acc->name &&\n'
+            '        (strcmp(acc->name, "sim"),\n'
+            '         object_dynamic_cast(OBJECT(accel), "sim-accel")) != NULL;')
+    elif negative == "repeated-name-query":
+        bodies = bodies.replace('return accel && accel->is_sim;',
+            'return accel && strcmp(ACCEL_GET_CLASS(accel)->name, "sim") == 0;')
+    predicates = []
+    for file, signatures in [
+        ("accel/tcg/icount-common.c", ["bool icount_crucible_sim_mode(",
+                                     "uint64_t icount_crucible_rr_switch_quantum("]),
+        ("accel/tcg/tcg-accel-ops-rr.c", ["static bool rr_crucible_sim_mode(void)\n{",
+                                       "static void rr_start_kick_timer(void)\n{"]),
+        ("accel/tcg/tcg-accel-ops-preemption.c", ["static bool crucible_sim_preemption_mode("]),
+        ("plugins/crucible-fault-clock.c", ["static bool crucible_clock_mode("]),
+        ("plugins/crucible-fault-lifecycle.c", ["static bool crucible_lifecycle_mode("]),
+        ("plugins/crucible-fault-vcpu-service.c", ["static bool crucible_vcpu_service_mode("]),
+        ("plugins/crucible-fault-node.c", ["bool qemu_crucible_fault_memory_rules_active("]),
+        ("accel/tcg/tcg-accel-ops-icount.c", ["static int64_t icount_get_limit(",
+            "int64_t icount_percpu_budget(", "static void icount_prepare_for_run_locked("]),
+    ]:
+        source = (ROOT / file).read_text()
+        predicates.extend(definition(source, signature) for signature in signatures)
+    predicate_bodies = "\n\n".join(predicates)
+    if negative == "predicate-order":
+        predicate_bodies = predicate_bodies.replace(
+            'return current_accel_is_sim() &&\n           icount_enabled() == ICOUNT_PRECISE;',
+            'return icount_enabled() == ICOUNT_PRECISE &&\n           current_accel_is_sim();')
+    tick_body = definition((ROOT / "plugins/api-system.c").read_text(),
+                           "int64_t qemu_plugin_sim_tick_observed(")
+    tick_guard = ('!current_accel_is_sim() ||\n'
+                  '        icount_enabled() != ICOUNT_PRECISE')
+    assert tick_body.count(tick_guard) == 1
+    if negative == "tick-name-query":
+        # Keep absent-instance rejection safe so an assertion exposes the
+        # repeated named query rather than an undefined NULL comparison.
+        tick_body = tick_body.replace(tick_guard,
+            '!current_accel_is_sim() || strcmp(current_accel_name(), "sim") != 0 ||\n'
+            '        icount_enabled() != ICOUNT_PRECISE')
+    elif negative == "tick-icount-order":
+        tick_body = tick_body.replace(tick_guard,
+            'icount_enabled() != ICOUNT_PRECISE ||\n'
+            '        !current_accel_is_sim()')
+    elif negative == "tick-observation-order":
+        tick_body = tick_body.replace(
+            'int64_t qemu_plugin_sim_tick_observed(void)\n{',
+            'int64_t qemu_plugin_sim_tick_observed(void)\n{\n'
+            '    int64_t tick = icount_crucible_sim_tick_observed();')
+        tick_body = tick_body.replace(
+            'return icount_crucible_sim_tick_observed();', 'return tick;')
+    elif negative == "tick-error-result":
+        tick_body = tick_body.replace(
+            tick_guard + ') {\n        return -1;',
+            tick_guard + ') {\n        return 0;')
+    elif negative == "tick-signed-result":
+        tick_body = tick_body.replace(
+            'return icount_crucible_sim_tick_observed();',
+            'return (uint32_t)icount_crucible_sim_tick_observed();')
+    predicate_bodies += "\n\n" + tick_body
+    prelude = PRELUDE.replace("/* PRODUCTION_DECLARATIONS */", declarations)
+    class_macro = source_range(accel_header, "#define ACCEL_GET_CLASS(obj)",
+                               "AccelClass *accel_find")
+    prelude = prelude.replace("/* PRODUCTION_CLASS_MACRO */", class_macro)
+    prelude = prelude.replace("/* PRODUCTION_ACCEL_BODIES */",
+        'static void *object_dynamic_cast(Object *, const char *) __attribute__((unused));\n' + bodies)
+    prelude = prelude.replace("/* PRODUCTION_PREDICATES */", predicate_bodies)
+    generated = arguments.output_dir / "accel-classification.c"
+    generated.write_text(prelude + "\n" + CHECKS)
+    binary = arguments.output_dir / "accel-classification"
+    command = [os.environ.get("CC", "cc"),
+               *shlex.split(os.environ.get("CFLAGS", "")),
+               str(generated), "-o", str(binary),
+               *shlex.split(os.environ.get("LDFLAGS", ""))]
+    (arguments.output_dir / "compile-command.json").write_text(
+        json.dumps({"cwd": os.getcwd(), "argv": command}, indent=2) + "\n")
+    subprocess.run(command, check=True)
+    print("Compiled production accel classification fixture", flush=True)
+    subprocess.run([str(binary)], cwd=arguments.output_dir, check=True)
+
+
+if __name__ == "__main__":
+    main()
