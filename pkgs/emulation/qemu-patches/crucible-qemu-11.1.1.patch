+int qemu_crucible_checkpoint_scheduled_dispatch_check(void)
+{
+    QemuCrucibleCheckpointHeldTransaction *owner = &checkpoint_transaction;
+    struct QemuCrucibleCheckpointProofHold *hold = &owner->proof;
+    int status = 0;
+
+    if (!qatomic_load_acquire(&owner->published)) {
+        return 0;
+    }
+    if (owner->process_id != getpid() ||
+        !qemu_thread_is_self(&owner->thread) || !bql_locked() ||
+        qemu_in_coroutine()) {
+        return -EPERM;
+    }
+    if (qatomic_cmpxchg(&hold->producer_cut, 0, 1)) {
+        return -EAGAIN;
+    }
+    if (qatomic_load_acquire(&owner->request->terminal_state) ==
+            QEMU_CRUCIBLE_CHECKPOINT_TERMINAL_NO_ROOT &&
+        owner->request->provider_ended && owner->request->actor_pause_ended &&
+        owner->event_close_attempted && !owner->event_close_uncertain &&
+        !owner->proof.retained && !owner->prepare_called) {
+        qatomic_store_release(&hold->producer_cut, 0);
+        return 0;
+    }
+    /* Physical restoration alone does not reopen dispatch. In particular,
+     * FaultPause and the State root may still be held after RELEASE returns.
+     * Preserve the Ready body and wake until their actual final handshake.
+     */
+    if (!qatomic_load_acquire(&hold->producer_admission_open) ||
+        !qatomic_load_acquire(&hold->root_acknowledged) ||
+        qatomic_load_acquire(&owner->request->terminal_state) !=
+            QEMU_CRUCIBLE_CHECKPOINT_TERMINAL_RETIRED ||
+        hold->producer_borrowers || hold->borrowers || owner->invoking ||
+        owner->invocation.readers) {
+        status = -EINPROGRESS;
+    }
+    qatomic_store_release(&hold->producer_cut, 0);
+    return status;
+}
+
+int qemu_crucible_checkpoint_original_decode_v1(
+    const uint8_t *wire, size_t length, QemuCrucibleCheckpointOriginal *out)
+{
+    QemuCrucibleCheckpointOriginal decoded;
+    bool capability_present = false;
+
+    if (!wire || !out || length != QEMU_CRUCIBLE_CHECKPOINT_ORIGINAL_BYTES) {
+        return -EINVAL;
+    }
+    if (memcmp(wire, "CRUCPAU1", 8) || ldl_be_p(wire + 8) != 1) {
+        return -EPROTONOSUPPORT;
+    }
+    if (ldl_be_p(wire + 12) != QEMU_CRUCIBLE_CHECKPOINT_ORIGINAL_BYTES) {
+        return -EINVAL;
+    }
+    memcpy(decoded.capability, wire + 16, sizeof(decoded.capability));
+    for (size_t i = 0; i < sizeof(decoded.capability); i++) {
+        capability_present |= decoded.capability[i] != 0;
+    }
+    decoded.operation_id = ldq_be_p(wire + 48);
+    decoded.start_ns = ldq_be_p(wire + 56);
+    decoded.end_ns = ldq_be_p(wire + 64);
+    decoded.poll_ns = ldq_be_p(wire + 72);
+    if (!capability_present || !decoded.operation_id || !decoded.start_ns ||
+        !decoded.poll_ns || decoded.end_ns <= decoded.start_ns) {
+        return -EINVAL;
+    }
+    /* Poll is an original responsive ceiling; it may exceed the interval. */
+    *out = decoded;
+    return 0;
+}
+
+static int checkpoint_fail(QemuCrucibleCheckpointHeldTransaction *owner,
+                           int status, bool post)
+{
+    assert(status < 0);
+    if (post) {
+        qatomic_cmpxchg(&owner->post_status, 0, status);
+    }
+    qatomic_cmpxchg(&owner->first_status, 0, status);
+    if (owner->request == &checkpoint_request &&
+        qatomic_load_acquire(&checkpoint_request.published)) {
+        int raw_post = qatomic_read(&owner->post_status);
+
+        if (raw_post) {
+            qatomic_cmpxchg(&owner->request->post_status, 0, raw_post);
+        }
+        qatomic_cmpxchg(&owner->request->first_status, 0, status);
+    }
+    return qatomic_read(&owner->first_status);
+}
+
+static int checkpoint_unavailable(void)
+{
+#ifdef CONFIG_LINUX
+    return -ENOKEY;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+static int checkpoint_identity_base(QemuCrucibleCheckpointHeldTransaction *owner)
+{
+    if (owner != &checkpoint_transaction ||
+        !qatomic_load_acquire(&checkpoint_transaction.published) ||
+        owner->process_id != getpid() || !qemu_thread_is_self(&owner->thread)) {
+        return -EPERM;
+    }
+    if (!qemu_crucible_checkpoint_pager_binding_current(&owner->pager)) {
+        return checkpoint_fail(owner, -EPERM, false);
+    }
+    return 0;
+}
+
+static int checkpoint_identity(QemuCrucibleCheckpointHeldTransaction *owner)
+{
+    int status = checkpoint_identity_base(owner);
+
+    /* Candidate admission cannot overlap the retained inventory child.
+     * Finalizer physical retirement also checks this actual borrower. */
+    return status ? status :
+        (owner->inventory.active || owner->inventory.metadata_borrow ||
+         owner->inventory.output.held || owner->inventory.output.close_uncertain ||
+         owner->inventory.cancellation.held || owner->inventory.cancellation.close_uncertain) ? -EBUSY : 0;
+}
+
+static int checkpoint_current(QemuCrucibleCheckpointHeldTransaction *owner)
+{
+    int status = checkpoint_identity(owner);
+
+    if (status) {
+        return status;
+    }
+    status = qatomic_read(&owner->first_status);
+    return status ? status : qatomic_read(&owner->post_status);
+}
+
+#ifdef CONFIG_LINUX
+static int checkpoint_now(uint64_t *now)
+{
+    struct timespec time;
+
+    if (clock_gettime(CLOCK_MONOTONIC, &time) < 0) {
+        return -errno;
+    }
+    if (time.tv_sec < 0 || time.tv_nsec < 0 || time.tv_nsec >= 1000000000 ||
+        (uint64_t)time.tv_sec > (UINT64_MAX - time.tv_nsec) / 1000000000) {
+        return -EOVERFLOW;
+    }
+    *now = (uint64_t)time.tv_sec * 1000000000 + time.tv_nsec;
+    return 0;
+}
+
+/* A fixed reader makes positive progress or refuses: no EINTR retry, seek,
+ * duplication or whole-body allocation. Metadata alias custody survives an
+ * uncertain sole close; its numeric fd is never retried or treated as reusable.
+ */
+int qemu_crucible_received_cancellation_observe_v1(
+    int event_fd, int *metadata_fd, bool *close_uncertain, int *post_status,
+    uint64_t *device, uint64_t *inode, uint64_t *observed_id)
+{
+    char path[64];
+    char bytes[4096];
+    struct stat info;
+    size_t length = 0;
+    uint64_t event_id = 0;
+    bool found = false;
+    int flags;
+    int result = 0;
+    int saved_errno;
+
+    if (fstat(event_fd, &info) < 0) {
+        return -errno;
+    }
+    flags = fcntl(event_fd, F_GETFL);
+    if (flags < 0) {
+        return -errno;
+    }
+    if (!(flags & O_NONBLOCK) || *metadata_fd >= 0 || *close_uncertain) {
+        return -ESTALE;
+    }
+    snprintf(path, sizeof(path), "/proc/self/fdinfo/%d", event_fd);
+    (*metadata_fd) = open(path, O_RDONLY | O_CLOEXEC);
+    if ((*metadata_fd) < 0) {
+        return -errno;
+    }
+    while (length < sizeof(bytes)) {
+        ssize_t count = read((*metadata_fd), bytes + length,
+                             sizeof(bytes) - length);
+
+        if (count < 0) {
+            result = -errno;
+            goto close_reader;
+        }
+        if (!count) {
+            break;
+        }
+        length += count;
+    }
+    if (length == sizeof(bytes)) {
+        result = -EOVERFLOW;
+        goto close_reader;
+    }
+    for (size_t line = 0; line < length;) {
+        size_t end = line;
+        size_t cursor;
+        uint64_t number = 0;
+
+        while (end < length && bytes[end] != '\n') {
+            if (!bytes[end]) {
+                result = -EINVAL;
+                goto close_reader;
+            }
+            end++;
+        }
+        if (end == length) {
+            result = -EINVAL;
+            goto close_reader;
+        }
+        if (end - line >= 11 && !memcmp(bytes + line, "eventfd-id:", 11)) {
+            if (found) {
+                result = -EINVAL;
+                goto close_reader;
+            }
+            cursor = line + 11;
+            while (cursor < end && (bytes[cursor] == ' ' || bytes[cursor] == '\t')) {
+                cursor++;
+            }
+            if (cursor == end) {
+                result = -EINVAL;
+                goto close_reader;
+            }
+            for (; cursor < end; cursor++) {
+                unsigned digit = (unsigned char)bytes[cursor] - '0';
+
+                if (digit > 9 || number > (UINT64_MAX - digit) / 10) {
+                    result = -EINVAL;
+                    goto close_reader;
+                }
+                number = number * 10 + digit;
+            }
+            if (number == UINT64_MAX) {
+                result = -EOVERFLOW;
+                goto close_reader;
+            }
+            event_id = number + 1;
+            found = true;
+        }
+        line = end + 1;
+    }
+    if (!found) {
+        result = -ESTALE;
+    }
+close_reader:
+    if (close((*metadata_fd)) < 0) {
+        saved_errno = errno;
+        (*close_uncertain) = true;
+        if (!(*post_status)) {
+            (*post_status) = -saved_errno;
+        }
+        if (!result) {
+            result = -saved_errno;
+        }
+    } else {
+        (*metadata_fd) = -1;
+    }
+    if (!result) {
+        *device = info.st_dev;
+        *inode = info.st_ino;
+        *observed_id = event_id;
+    }
+    return result;
+}
+
+static int checkpoint_event_identity(QemuCrucibleCheckpointHeldTransaction *owner)
+{
+    uint64_t device, inode, event_id;
+    struct stat info;
+    int flags;
+    int status;
+
+    /* Preserve the established early identity refusal before metadata birth. */
+    if (fstat(owner->cancellation_fd, &info) < 0) {
+        return -errno;
+    }
+    flags = fcntl(owner->cancellation_fd, F_GETFL);
+    if (flags < 0) {
+        return -errno;
+    }
+    if (!(flags & O_NONBLOCK) ||
+        (uint64_t)info.st_dev != owner->request->cancellation_device ||
+        (uint64_t)info.st_ino != owner->request->cancellation_inode) {
+        return -ESTALE;
+    }
+    status = qemu_crucible_received_cancellation_observe_v1(
+        owner->cancellation_fd, &owner->metadata_fd,
+        &owner->metadata_close_uncertain, &owner->post_status,
+        &device, &inode, &event_id);
+
+    if (!status && (device != owner->request->cancellation_device ||
+                    inode != owner->request->cancellation_inode ||
+                    event_id != owner->request->cancellation_event_id)) {
+        status = -ESTALE;
+    }
+    return status;
+}
+
+static int checkpoint_cancelled(QemuCrucibleCheckpointHeldTransaction *owner)
+{
+    struct pollfd event = { .fd = owner->cancellation_fd, .events = POLLIN };
+    int result = poll(&event, 1, 0);
+
+    if (result < 0) {
+        return -errno;
+    }
+    if (event.revents & POLLNVAL) {
+        return -EBADF;
+    }
+    if (event.revents & (POLLERR | POLLHUP)) {
+        return -EIO;
+    }
+    return result || event.revents ? -ECANCELED : 0;
+}
+#endif
+
+static int checkpoint_live_raw(QemuCrucibleCheckpointHeldTransaction *owner,
+                           uint64_t *slice)
+{
+#ifdef CONFIG_LINUX
+    uint64_t now;
+    int status;
+
+    if (!owner->original_valid || owner->metadata_close_uncertain) {
+        return -ESTALE;
+    }
+    status = checkpoint_cancelled(owner);
+    if (!status) {
+        status = checkpoint_event_identity(owner);
+    }
+    if (!status) {
+        status = checkpoint_now(&now);
+    }
+    if (!status && now < owner->original.start_ns) {
+        status = -ESTALE;
+    }
+    if (!status && now >= owner->original.end_ns) {
+        status = -ETIMEDOUT;
+    }
+    if (!status) {
+        status = checkpoint_cancelled(owner);
+    }
+    if (status) {
+        return status;
+    }
+    status = checkpoint_now(&now);
+    if (status || now < owner->original.start_ns ||
+        now >= owner->original.end_ns) {
+        return status ? status :
+            now < owner->original.start_ns ? -ESTALE : -ETIMEDOUT;
+    }
+    *slice = MIN(owner->original.poll_ns, owner->original.end_ns - now);
+    return 0;
+#else
+    (void)slice;
+    return -ENOTSUP;
+#endif
+}
+
+static int checkpoint_live(QemuCrucibleCheckpointHeldTransaction *owner,
+                           uint64_t *slice, bool post)
+{
+    int status = checkpoint_live_raw(owner, slice);
+
+    return status ? checkpoint_fail(owner, status, post) : 0;
+}
+
+size_t qemu_crucible_checkpoint_owner_bytes(void)
+{
+    return sizeof(checkpoint_pending) + sizeof(checkpoint_request) +
+           sizeof(checkpoint_transaction) + sizeof(checkpoint_read) +
+           sizeof(checkpoint_stop_owner) + sizeof(checkpoint_main_owner) +
+           sizeof(checkpoint_last_stop_retirement) +
+           qemu_crucible_checkpoint_candidate_capture_storage_bytes_v1();
+}
+
+static int checkpoint_pending_failure(QemuCrucibleCheckpointPendingOwner *pending,
+                                      int status, bool post)
+{
+    if (status < 0) {
+        if (post) {
+            qatomic_cmpxchg(&pending->post_status, 0, status);
+        }
+        qatomic_cmpxchg(&pending->first_status, 0, status);
+    }
+    return qatomic_read(&pending->first_status);
+}
+
+static int checkpoint_pending_live(QemuCrucibleCheckpointPendingOwner *pending,
+                                   bool post)
+{
+#ifdef CONFIG_LINUX
+    struct pollfd event = { .fd = pending->cancellation_fd, .events = POLLIN };
+    uint64_t device, inode, event_id, now;
+    int status;
+
+    if (!pending->original_valid) {
+        return checkpoint_pending_failure(pending, -ESTALE, post);
+    }
+    status = qemu_crucible_received_cancellation_observe_v1(
+        pending->cancellation_fd, &pending->metadata_fd,
+        &pending->metadata_close_uncertain, &pending->post_status,
+        &device, &inode, &event_id);
+    if (!status && (device != pending->cancellation_device ||
+                    inode != pending->cancellation_inode ||
+                    event_id != pending->cancellation_event_id)) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        int result = poll(&event, 1, 0);
+
+        if (result < 0) {
+            status = -errno;
+        } else if (event.revents & POLLNVAL) {
+            status = -EBADF;
+        } else if (event.revents & (POLLERR | POLLHUP)) {
+            status = -EIO;
+        } else if (result || event.revents) {
+            status = -ECANCELED;
+        }
+    }
+    if (!status) {
+        status = checkpoint_now(&now);
+    }
+    if (!status && now < pending->original.start_ns) {
+        status = -ESTALE;
+    }
+    if (!status && now >= pending->original.end_ns) {
+        status = -ETIMEDOUT;
+    }
+    return status ? checkpoint_pending_failure(pending, status, post) : 0;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_crucible_checkpoint_pending_adopt_native_v1(
+    QemuCrucibleRamControlActor *actor, QemuCrucibleRamControlReceive *receipt,
+    const uint8_t original[80], const uint8_t digest[32], uint64_t *generation)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCheckpointPendingOwner *pending = &checkpoint_pending;
+    QemuCrucibleCheckpointPagerBinding pager;
+    bool digest_present = false;
+    int status;
+    int post;
+
+    status = qemu_crucible_checkpoint_storage_current_v1();
+    if (status) {
+        return status;
+    }
+    status = qemu_crucible_checkpoint_pager_binding_borrow(&pager);
+    if (status || qemu_crucible_ram_control_actor_current(
+                      actor, pager.installer.plugin_id) ||
+        !pager.provider_acquire || !pager.provider_check || !pager.provider_end ||
+        receipt != &actor->receipt || !receipt->active || receipt->uncertain ||
+        receipt->moved || receipt->frame_bytes != CRUCIBLE_CHECKPOINT_ARM_FRAME_BYTES ||
+        !receipt->first_alias || receipt->alias_count != 1 ||
+        !original || !digest || !generation) {
+        return status ? status : -EPERM;
+    }
+    if (qatomic_cmpxchg(&pending->cut, 0, 1)) {
+        return -EAGAIN;
+    }
+    if (qatomic_load_acquire(&pending->published) || pending->moved ||
+        pending->generation == UINT64_MAX) {
+        status = -EALREADY;
+        goto done;
+    }
+    /* Real native landing moves before decode/check. The output generation
+     * journals birth even on refusal; it is not successful acceptance. */
+    pending->actor = actor;
+    pending->receipt = receipt;
+    pending->pager = pager;
+    pending->cancellation_fd = receipt->aliases[0];
+    receipt->aliases[0] = -1;
+    receipt->moved = true;
+    pending->generation++;
+    memcpy(pending->original_wire,
+           receipt->frame + CRUCIBLE_CHECKPOINT_ARM_ORIGINAL_OFFSET, 80);
+    memcpy(pending->digest, digest, sizeof(pending->digest));
+    qatomic_store_release(&pending->published, true);
+    *generation = pending->generation;
+
+    for (size_t index = 0; index < sizeof(pending->digest); index++) {
+        digest_present |= pending->digest[index] != 0;
+    }
+    status = !digest_present || memcmp(original, pending->original_wire, 80) ?
+             -EPROTO : 0;
+    if (!status) {
+        status = qemu_crucible_received_cancellation_observe_v1(
+            pending->cancellation_fd, &pending->metadata_fd,
+            &pending->metadata_close_uncertain, &pending->post_status,
+            &pending->cancellation_device, &pending->cancellation_inode,
+            &pending->cancellation_event_id);
+    }
+    if (!status) {
+        status = qemu_crucible_checkpoint_original_decode_v1(
+            pending->original_wire, sizeof(pending->original_wire),
+            &pending->original);
+        pending->original_valid = !status;
+    }
+    if (!status) {
+        status = checkpoint_pending_live(pending, false);
+    }
+    if (status) {
+        checkpoint_pending_failure(pending, status, false);
+    }
+    /* Raw post remains independent even after a negative first observation. */
+    post = qemu_crucible_ram_control_actor_contract_current(actor);
+    if (!post && pending->original_valid) {
+        post = checkpoint_pending_live(pending, true);
+    }
+    if (post) {
+        checkpoint_pending_failure(pending, post, true);
+    }
+    status = pending->first_status;
+
+done:
+    qatomic_store_release(&pending->cut, 0);
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_crucible_checkpoint_begin_main_v1(
+    const uint8_t arm_digest[32], uint64_t request_generation,
+    uint64_t *connection_epoch)
+{
+    QemuCrucibleCheckpointPendingOwner *pending = &checkpoint_pending;
+    QemuCrucibleCheckpointRequestLoan *request = &checkpoint_request;
+    MonitorQmpCheckpointReservation *reservation = NULL;
+    Monitor *monitor = NULL;
+    void *purpose = NULL;
+    uint64_t process_generation, epoch;
+    QemuCrucibleCheckpointHeldTransaction *transaction = NULL;
+    int status;
+
+    status = qemu_crucible_checkpoint_storage_current_v1();
+    if (status) {
+        return status;
+    }
+
+    if (!arm_digest || !request_generation || !connection_epoch ||
+        !qemu_in_main_thread() || !bql_locked() || qemu_in_coroutine()) {
+        return -EPERM;
+    }
+    if (qatomic_load_acquire(&request->published)) {
+        /* A retry selects the same issued request. It does not reconstruct
+         * Original, reacquire a provider or move any native alias twice.
+         */
+        if (request->generation != request_generation ||
+            memcmp(request->arm_digest, arm_digest, sizeof(request->arm_digest))) {
+            return -ESTALE;
+        }
+        status = monitor_qmp_checkpoint_reservation_take(&reservation);
+        if (status) {
+            return status;
+        }
+        if (reservation != checkpoint_main_owner.reservation) {
+            return -ESTALE;
+        }
+        status = qemu_crucible_checkpoint_request_actor_current_v1(
+            request, request->actor);
+        if (status) {
+            return status;
+        }
+        epoch = request->connection_epoch;
+        goto continue_request;
+    }
+    if (!qatomic_load_acquire(&pending->published) || pending->moved ||
+        pending->generation != request_generation ||
+        memcmp(pending->digest, arm_digest, sizeof(pending->digest))) {
+        return -ESTALE;
+    }
+    status = monitor_qmp_checkpoint_reservation_take(&reservation);
+    if (status) {
+        return status;
+    }
+    status = monitor_qmp_checkpoint_reservation_observe(
+        reservation, &monitor, &purpose, &process_generation, &epoch);
+    if (status) {
+        return status;
+    }
+    if (qatomic_cmpxchg(&pending->cut, 0, 1)) {
+        return -EAGAIN;
+    }
+    if (!qatomic_load_acquire(&pending->published) || pending->moved ||
+        pending->generation != request_generation ||
+        memcmp(pending->digest, arm_digest, sizeof(pending->digest))) {
+        qatomic_store_release(&pending->cut, 0);
+        return -ESTALE;
+    }
+    /* Install every native holder before fallible Original/provider work.
+     * Failure preserves the same generation, reservation and consumed alias.
+     */
+    request->process_id = getpid();
+    qemu_thread_get_self(&request->thread);
+    request->monitor = monitor;
+    request->attachment_owner = reservation;
+    request->request_owner = &checkpoint_main_owner;
+    request->containing_purpose = purpose;
+    request->connection_owner = reservation;
+    request->actor = pending->actor;
+    request->receipt = pending->receipt;
+    request->pager = pending->pager;
+    request->generation = pending->generation;
+    request->connection_epoch = epoch;
+    request->coordinates.native_transaction_generation = pending->generation;
+    request->coordinates.process_generation = process_generation;
+    request->cancellation_fd = pending->cancellation_fd;
+    request->cancellation_device = pending->cancellation_device;
+    request->cancellation_inode = pending->cancellation_inode;
+    request->cancellation_event_id = pending->cancellation_event_id;
+    request->first_status = pending->first_status;
+    request->post_status = pending->post_status;
+    memcpy(request->original_wire, pending->original_wire,
+           sizeof(request->original_wire));
+    memcpy(request->arm_digest, pending->digest, sizeof(request->arm_digest));
+    checkpoint_main_owner.request = request;
+    checkpoint_main_owner.monitor = monitor;
+    checkpoint_main_owner.reservation = reservation;
+    checkpoint_main_owner.allocation_retained = true;
+    pending->cancellation_fd = -1;
+    pending->moved = true;
+    request->main_scope_active = true;
+    qatomic_store_release(&checkpoint_main_owner.published, true);
+    qatomic_store_release(&request->published, true);
+    qatomic_store_release(&pending->cut, 0);
+
+continue_request:
+    if (request->provider_acquired) {
+        status = checkpoint_provider_check_main(request);
+    } else {
+        status = qemu_crucible_checkpoint_provider_acquire_main_v1(request);
+    }
+    if (status) {
+        return status;
+    }
+    status = qemu_crucible_checkpoint_receive_v1(request, &transaction);
+    if (status) {
+        return status;
+    }
+    /* The Main handoff precedes the ordinary stop action. Requiring its
+     * completed receipt here would prevent ARM -> begin -> actual pause.
+     * Candidate admission separately requires genuine attached Stop custody.
+     */
+    *connection_epoch = epoch;
+    return 0;
+}
+
+int qemu_crucible_checkpoint_receive_v1(
+    QemuCrucibleCheckpointRequestLoan *request,
+    QemuCrucibleCheckpointHeldTransaction **out)
+{
+    QemuCrucibleCheckpointHeldTransaction *owner = &checkpoint_transaction;
+    uint64_t slice;
+    int status;
+
+    /* No mutable read, alias movement or callback follows absent authority. */
+    status = qemu_crucible_checkpoint_storage_current_v1();
+    if (status) {
+        return status;
+    }
+
+    if (request != &checkpoint_request ||
+        !qatomic_load_acquire(&checkpoint_request.published)) {
+        return checkpoint_unavailable();
+    }
+    if (request->process_id != getpid() ||
+        !qemu_thread_is_self(&request->thread)) {
+        return -EPERM;
+    }
+    if (request->moved && qatomic_load_acquire(&owner->published) &&
+        owner->request == request) {
+        if (!out) {
+            return -EINVAL;
+        }
+        status = checkpoint_current(owner);
+        if (!status) {
+            status = checkpoint_live(owner, &slice, false);
+        }
+        if (status) {
+            return status;
+        }
+        *out = owner;
+        return 0;
+    }
+    if (!out || request->moved || qatomic_load_acquire(&owner->published)) {
+        return request->moved ? -EALREADY : -EINVAL;
+    }
+    if (!request->containing_purpose || !request->monitor ||
+        !request->attachment_owner || !request->request_owner ||
+        !request->provider_acquired || !request->provider_owner ||
+        !request->main_scope_active || request->cancellation_fd < 0 ||
+        !qemu_crucible_checkpoint_pager_binding_current(&request->pager)) {
+        return -EPERM;
+    }
+
+    /* Install the native holder first. No fallible decode/check precedes the
+     * transfer of the actual raw bytes and consumed alias into that holder.
+     */
+    owner->process_id = request->process_id;
+    owner->thread = request->thread;
+    owner->request = request;
+    owner->pager = request->pager;
+    if (request->first_status) {
+        qatomic_cmpxchg(&owner->first_status, 0, request->first_status);
+    }
+    if (request->post_status) {
+        qatomic_cmpxchg(&owner->post_status, 0, request->post_status);
+    }
+    owner->cancellation_fd = request->cancellation_fd;
+    memcpy(owner->original_wire, request->original_wire,
+           sizeof(owner->original_wire));
+    request->cancellation_fd = -1;
+    request->moved = true;
+    qatomic_store_release(&owner->published, true);
+
+    status = qemu_crucible_checkpoint_original_decode_v1(
+        owner->original_wire, sizeof(owner->original_wire), &owner->original);
+    if (status) {
+        return checkpoint_fail(owner, status, false);
+    }
+    owner->original_valid = true;
+    status = checkpoint_live(owner, &slice, false);
+    if (!status) {
+        status = checkpoint_current(owner);
+    }
+    if (status) {
+        return status;
+    }
+    *out = owner;
+    return 0;
+}
+
+/* Cleanup borrows only the existing completed ordinary execution receipt.
+ * It may reconcile a failed Original, but cannot admit capture or renew its
+ * deadline. The ordinary owner and its template/block holds remain intact.
+ */
+static int checkpoint_bind_stop_cleanup(
+    QemuCrucibleCheckpointHeldTransaction *owner)
+{
+#ifdef CONFIG_LINUX
+    struct QemuCrucibleCheckpointStopOwner *stop = &checkpoint_stop_owner;
+    uint64_t generation;
+    int status = checkpoint_identity(owner);
+
+    if (!status) {
+        status = checkpoint_stop_receipt_current();
+    }
+    if (!status) {
+        status = qemu_crucible_checkpoint_main_loop_current();
+    }
+    if (status) {
+        return status;
+    }
+    if (stop->retirement_requested ||
+        (stop->transaction && stop->transaction != owner) ||
+        stop->source.installer.ctx != owner->pager.installer.ctx ||
+        stop->source.installer.module != owner->pager.installer.module ||
+        stop->source.installer.plugin_id != owner->pager.installer.plugin_id) {
+        return -ESTALE;
+    }
+    generation = stop->completed_generation;
+    if (!generation || generation != qemu_plugin_crucible_vmstop_generation()) {
+        return -ESTALE;
+    }
+    if (owner->stopped) {
+        return stop->transaction == owner &&
+               owner->stopped_generation == generation ? 0 : -ESTALE;
+    }
+    if (stop->transaction) {
+        return -ESTALE;
+    }
+
+    /* Publish the same nominal borrow before any End disposition effects.
+     * Finalizer returns this borrow only after its real bank/pause returns.
+     */
+    stop->transaction = owner;
+    owner->stopped_generation = generation;
+    owner->stopped = true;
+    return 0;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_crucible_checkpoint_bind_stop_v1(
+    QemuCrucibleCheckpointHeldTransaction *owner)
+{
+#ifdef CONFIG_LINUX
+    uint64_t slice;
+    uint64_t generation;
+    int status = checkpoint_current(owner);
+
+    if (status) {
+        return status;
+    }
+    status = checkpoint_stop_receipt_current();
+    if (status) {
+        return checkpoint_fail(owner, status, false);
+    }
+    if (owner->stopped) {
+        if (checkpoint_stop_owner.transaction != owner ||
+            !checkpoint_stop_owner.published ||
+            checkpoint_stop_owner.completed_generation != owner->stopped_generation ||
+            owner->stopped_generation != qemu_plugin_crucible_vmstop_generation()) {
+            return -ESTALE;
+        }
+        return checkpoint_live(owner, &slice, false);
+    }
+    /* A current paused VM is observational. Only the actual retained stop
+     * request/completion owner can bind this Receiving transaction to it.
+     */
+    if (!qatomic_load_acquire(&checkpoint_stop_owner.published) ||
+        checkpoint_stop_owner.process_id != getpid() ||
+        !qemu_thread_is_self(&checkpoint_stop_owner.thread) ||
+        !checkpoint_stop_owner.allocation_retained ||
+        !checkpoint_stop_owner.ordinary_intent_owner ||
+        (checkpoint_stop_owner.transaction &&
+         checkpoint_stop_owner.transaction != owner) ||
+        !qemu_crucible_checkpoint_pager_binding_current(&checkpoint_stop_owner.source) ||
+        checkpoint_stop_owner.source.installer.ctx != owner->pager.installer.ctx ||
+        checkpoint_stop_owner.source.installer.module != owner->pager.installer.module ||
+        checkpoint_stop_owner.source.installer.plugin_id != owner->pager.installer.plugin_id) {
+        return checkpoint_fail(owner, checkpoint_unavailable(), false);
+    }
+    status = qemu_crucible_checkpoint_main_loop_current();
+    if (!status && (!qemu_plugin_crucible_vmstop_quiesced() ||
+                    qemu_plugin_crucible_vmstop_cold_origin())) {
+        status = -ESTALE;
+    }
+    if (status) {
+        return checkpoint_fail(owner, status, false);
+    }
+    status = checkpoint_live(owner, &slice, false);
+    if (status) {
+        return status;
+    }
+    /* Revalidate the completion owned by this stop request against the
+     * actual current transition; receiving never guesses a future generation.
+     */
+    generation = checkpoint_stop_owner.completed_generation;
+
+    if (!generation || generation != qemu_plugin_crucible_vmstop_generation()) {
+        return checkpoint_fail(owner, -ESTALE, false);
+    }
+    /* Borrow this actual retained ordinary receipt; matching a current
+     * generation alone never publishes it or manufactures a stop request.
+     */
+    checkpoint_stop_owner.transaction = owner;
+    owner->stopped_generation = generation;
+    owner->stopped = true;
+    return 0;
+#else
+    int status = checkpoint_current(owner);
+
+    return status ? status : checkpoint_fail(owner, -ENOTSUP, false);
+#endif
+}
+
+int qemu_crucible_checkpoint_transaction_placement_current(
+    QemuCrucibleCheckpointHeldTransaction *owner,
+    uint64_t stopped_generation, int cancellation_fd)
+{
+    int status = owner == &checkpoint_transaction && owner->cleanup_invoking ?
+        checkpoint_identity(owner) : checkpoint_current(owner);
+
+    if (status) {
+        return status;
+    }
+    if (!owner->stopped || stopped_generation != owner->stopped_generation ||
+        cancellation_fd != owner->cancellation_fd) {
+        return checkpoint_fail(owner, -ESTALE, false);
+    }
+    return 0;
+}
+
+static int checkpoint_invocation_current(
+    QemuCrucibleCheckpointInvocationLoan *loan)
+{
+    if (loan != &checkpoint_transaction.invocation ||
+        !qatomic_load_acquire(&checkpoint_transaction.published) ||
+        checkpoint_transaction.process_id != getpid() ||
+        !qemu_thread_is_self(&checkpoint_transaction.thread)) {
+        return -EPERM;
+    }
+    if (!loan->active || loan->process_id != getpid() ||
+        !qemu_thread_is_self(&loan->thread)) {
+        return -EPERM;
+    }
+    if (loan->transaction->cleanup_invoking &&
+        loan->action == QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PAGER_RELEASE) {
+        return checkpoint_identity(loan->transaction);
+    }
+    return checkpoint_current(loan->transaction);
+}
+
+/* Called by the actual collector-loan implementation before it touches its
+ * mutable held closure. No process/thread/module identity comes from an SDK
+ * coordinate, and no BQL acquisition or registry lookup occurs here.
+ */
+int qemu_crucible_checkpoint_transaction_proof_current(
+    QemuCrucibleCheckpointHeldTransaction *transaction)
+{
+    int status;
+
+    if (transaction != &checkpoint_transaction) {
+        return -EPERM;
+    }
+    status = checkpoint_invocation_current(&checkpoint_transaction.invocation);
+    return status ? status : qemu_crucible_checkpoint_main_loop_current();
+}
+
+static int checkpoint_proof_invocation(qemu_plugin_id_t id)
+{
+    int status = checkpoint_invocation_current(&checkpoint_transaction.invocation);
+
+    if (status) {
+        return status;
+    }
+    if (id != checkpoint_transaction.pager.installer.plugin_id) {
+        return -EPERM;
+    }
+    return qemu_crucible_checkpoint_main_loop_current();
+}
+
+static int checkpoint_proof_current(
+    qemu_plugin_id_t id, struct QemuCrucibleCheckpointProofHold *hold)
+{
+    QemuCrucibleCheckpointHeldTransaction *owner = &checkpoint_transaction;
+    int status = checkpoint_proof_invocation(id);
+
+    if (status) {
+        return status;
+    }
+    if (hold != &owner->proof || !qatomic_load_acquire(&hold->retained) ||
+        hold->process != getpid() || !qemu_thread_is_self(&hold->thread) ||
+        hold->transaction != owner ||
+        hold->pager.installer.ctx != owner->pager.installer.ctx ||
+        hold->pager.installer.module != owner->pager.installer.module ||
+        hold->pager.installer.install != owner->pager.installer.install ||
+        hold->pager.userdata != owner->pager.userdata ||
+        hold->pager.prepare != owner->pager.prepare ||
+        hold->pager.check != owner->pager.check ||
+        hold->pager.release != owner->pager.release) {
+        return -EPERM;
+    }
+    if (hold->returned) {
+        return -EALREADY;
+    }
+    return qemu_crucible_checkpoint_native_fence_check_v1(owner, hold->fence);
+}
+
+/* Policy/registry admission observes this SAME proof outside the old pager
+ * callback. The Source permanently retains module/userdata allocation; this
+ * additional counted borrow prevents transaction-slot reuse during observation.
+ * It lends no read, callback, original or new Receiving authority.
+ */
+static int checkpoint_producer_owner(
+    qemu_plugin_id_t id, struct QemuCrucibleCheckpointProofHold *hold,
+    void *userdata)
+{
+    QemuCrucibleCheckpointHeldTransaction *owner = &checkpoint_transaction;
+
+    if (hold != &owner->proof || !qatomic_load_acquire(&hold->retained) ||
+        hold->process != getpid() || id != hold->pager.installer.plugin_id ||
+        userdata != hold->pager.userdata ||
+        !qemu_crucible_checkpoint_pager_binding_current(&hold->pager)) {
+        return -EPERM;
+    }
+    return 0;
+}
+
+int qemu_plugin_crucible_checkpoint_producer_borrow_v1(
+    qemu_plugin_id_t id, qemu_plugin_crucible_checkpoint_proof_handle_v1 *hold,
+    void *userdata, qemu_plugin_crucible_checkpoint_producer_loan_v1 **out)
+{
+    QemuCrucibleCheckpointHeldTransaction *owner = &checkpoint_transaction;
+    struct QemuCrucibleCheckpointProducerLoan *loan = &owner->producer_loan;
+    int status = checkpoint_producer_owner(id, hold, userdata);
+
+    if (status || !out) {
+        return status ? status : -EINVAL;
+    }
+    if (qatomic_cmpxchg(&hold->producer_cut, 0, 1)) {
+        return -EAGAIN;
+    }
+    if (hold->root_acknowledged || hold->producer_admission_open) {
+        status = -EALREADY;
+    } else if (hold->producer_borrowers == UINT_MAX || loan->active) {
+        status = hold->producer_borrowers == UINT_MAX ? -EOVERFLOW : -EBUSY;
+    } else {
+        loan->process = getpid();
+        qemu_thread_get_self(&loan->thread);
+        loan->hold = hold;
+        loan->retirement_observed = false;
+        loan->observed_generation = 0;
+        loan->active = true;
+        hold->producer_borrowers++;
+        *out = loan;
+    }
+    qatomic_store_release(&hold->producer_cut, 0);
+    return status;
+}
+
+static int checkpoint_producer_loan_current(
+    qemu_plugin_id_t id, struct QemuCrucibleCheckpointProducerLoan *loan)
+{
+    QemuCrucibleCheckpointHeldTransaction *owner = &checkpoint_transaction;
+
+    if (loan != &owner->producer_loan ||
+        !qatomic_load_acquire(&owner->proof.retained) ||
+        owner->proof.process != getpid() || !loan->active ||
+        loan->process != getpid() || !qemu_thread_is_self(&loan->thread) ||
+        loan->hold != &owner->proof) {
+        return -EPERM;
+    }
+    return checkpoint_producer_owner(id, loan->hold, loan->hold->pager.userdata);
+}
+
+int qemu_plugin_crucible_checkpoint_producer_check_v1(
+    qemu_plugin_id_t id, qemu_plugin_crucible_checkpoint_producer_loan_v1 *loan)
+{
+    QemuCrucibleCheckpointHeldTransaction *owner = &checkpoint_transaction;
+    int status = checkpoint_producer_loan_current(id, loan);
+
+    if (status) {
+        return status;
+    }
+    status = qatomic_read(&owner->first_status);
+    if (!status) {
+        status = qatomic_read(&owner->post_status);
+    }
+    if (status) {
+        return status;
+    }
+    return qatomic_load_acquire(&loan->hold->producer_admission_open) ?
+        0 : -EINPROGRESS;
+}
+
+/* This is a cleanup-only cut over retained identities. An expired original
+ * still records its failure, but cannot prevent release of these exact holds.
+ */
+int qemu_crucible_checkpoint_transaction_retirement_current(
+    QemuCrucibleCheckpointHeldTransaction *owner)
+{
+    struct QemuCrucibleCheckpointProofHold *hold = &checkpoint_transaction.proof;
+    int status = checkpoint_identity(owner);
+
+    if (status) {
+        return status;
+    }
+    status = qemu_crucible_checkpoint_main_loop_current();
+    if (status) {
+        return status;
+    }
+    if (!owner->request || !owner->request->moved ||
+        !owner->request->containing_purpose ||
+        owner->request->request_owner != &checkpoint_main_owner ||
+        !qatomic_load_acquire(&checkpoint_main_owner.published) ||
+        !checkpoint_main_owner.allocation_retained ||
+        checkpoint_main_owner.request != owner->request ||
+        checkpoint_stop_owner.transaction != owner ||
+        !qatomic_load_acquire(&checkpoint_stop_owner.published) ||
+        checkpoint_stop_owner.completed_generation != owner->stopped_generation ||
+        !owner->request->provider_acquired || !owner->request->provider_owner ||
+        owner->request->provider_ended ||
+        !qatomic_load_acquire(&owner->request->final_disposition_published) ||
+        !hold->retained || hold->transaction != owner ||
+        hold->provider_owner != owner->request->provider_owner ||
+        hold->process != getpid() || !qemu_thread_is_self(&hold->thread) ||
+        !qemu_crucible_checkpoint_pager_binding_current(&hold->pager) ||
+        hold->pager.installer.ctx != owner->pager.installer.ctx ||
+        hold->pager.installer.module != owner->pager.installer.module ||
+        hold->pager.installer.install != owner->pager.installer.install ||
+        hold->pager.userdata != owner->pager.userdata ||
+        hold->pager.prepare != owner->pager.prepare ||
+        hold->pager.check != owner->pager.check ||
+        hold->pager.release != owner->pager.release) {
+        return -EPERM;
+    }
+    if (owner->invoking || owner->cleanup_invoking || owner->invocation.active ||
+        owner->invocation.readers || checkpoint_read.active ||
+        owner->candidate_read.active || hold->borrowers ||
+        owner->proof_borrow.active || !owner->release_callback_returned ||
+        !owner->locally_disposed || !hold->local_disposition_allowed ||
+        !hold->returned || !hold->root_retired ||
+        hold->producer_borrowers != 1 || !owner->producer_loan.active ||
+        owner->producer_loan.hold != hold ||
+        owner->producer_loan.process != getpid() ||
+        !qemu_thread_is_self(&owner->producer_loan.thread)) {
+        return -EINPROGRESS;
+    }
+    if (!owner->mailbox_restored || !owner->placement_journal_valid ||
+        !hold->placement_tuple_bound ||
+        owner->placement_journal.disposition !=
+            QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PLACEMENT_RESTORED ||
+        !hold->transaction_generation ||
+        owner->request->coordinates.native_transaction_generation !=
+            hold->transaction_generation ||
+        owner->placement_journal.native_transaction_generation !=
+            hold->transaction_generation) {
+        return -ESTALE;
+    }
+    return 0;
+}
+
+/* Called with the last observer pin and producer cut held. Collector cleanup
+ * may partially return native subsystem holds; its retained token remains the
+ * only retry authority until every real hold has returned successfully.
+ */
+static int checkpoint_native_retire(
+    QemuCrucibleCheckpointHeldTransaction *owner)
+{
+    struct QemuCrucibleCheckpointProofHold *hold = &owner->proof;
+    int status;
+
+    if (hold->native_retired) {
+        return 0;
+    }
+    status = qemu_crucible_checkpoint_transaction_retirement_current(owner);
+    if (status) {
+        checkpoint_fail(owner, status, true);
+        return status;
+    }
+    status = qemu_crucible_checkpoint_placement_restored_current_v1(
+        owner->invocation.placement, owner,
+        owner->placement_journal.accepted_placement_generation,
+        owner->placement_journal.held_kind, hold->placement_callback,
+        hold->placement_opaque);
+    if (!status) {
+        status = qemu_crucible_checkpoint_native_fence_retire_v1(owner, hold->fence);
+    }
+    if (status) {
+        checkpoint_fail(owner, status, true);
+        return status;
+    }
+    /* Dispatch stays closed until exact observation, acknowledgment and end. */
+    qatomic_store_release(&hold->native_retired, true);
+    return 0;
+}
+
+int qemu_plugin_crucible_checkpoint_producer_observe_v1(
+    qemu_plugin_id_t id, qemu_plugin_crucible_checkpoint_producer_loan_v1 *loan,
+    struct qemu_plugin_crucible_checkpoint_producer_disposition *out)
+{
+    QemuCrucibleCheckpointHeldTransaction *owner = &checkpoint_transaction;
+    struct qemu_plugin_crucible_checkpoint_producer_disposition observed = {
+        .schema_version = 1,
+        .struct_size = sizeof(observed),
+        .state = QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PRODUCER_HELD,
+    };
+    int status = checkpoint_producer_loan_current(id, loan);
+
+    if (status || !out) {
+        return status ? status : -EINVAL;
+    }
+    if (qatomic_cmpxchg(&loan->hold->producer_cut, 0, 1)) {
+        return -EAGAIN;
+    }
+    if (loan->hold->root_retired && !loan->hold->native_retired &&
+        qemu_thread_is_self(&loan->hold->thread)) {
+        /* Observation drives a retained cleanup retry, never a new operation. */
+        checkpoint_native_retire(owner);
+    }
+    observed.first_status = qatomic_read(&owner->first_status);
+    observed.post_status = qatomic_read(&owner->post_status);
+    observed.native_transaction_generation = loan->hold->transaction_generation;
+    if (qatomic_load_acquire(&loan->hold->native_retired)) {
+        observed.state = QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PRODUCER_RETIRED;
+        loan->retirement_observed = true;
+        loan->observed_generation = observed.native_transaction_generation;
+    } else if (qatomic_load_acquire(&loan->hold->root_retired)) {
+        observed.state = QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PRODUCER_ROOT_RETURNED;
+    } else if (qatomic_load_acquire(&loan->hold->local_disposition_allowed)) {
+        observed.state = QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PRODUCER_LOCAL_DISPOSITION;
+    }
+    observed.root_acknowledged =
+        qatomic_load_acquire(&loan->hold->root_acknowledged);
+    qatomic_store_release(&loan->hold->producer_cut, 0);
+    /* An authenticated physical-journal observation may contain failures.
+     * Neither return0 nor its copied scalar fields issue an operation/owner.
+     */
+    *out = observed;
+    return 0;
+}
+
+int qemu_plugin_crucible_checkpoint_producer_end_v1(
+    qemu_plugin_id_t id, qemu_plugin_crucible_checkpoint_producer_loan_v1 *loan)
+{
+    struct QemuCrucibleCheckpointProofHold *hold;
+    int status = checkpoint_producer_loan_current(id, loan);
+
+    if (status) {
+        return status;
+    }
+    hold = loan->hold;
+    if (hold->root_acknowledged) {
+        /* Final admission stays inside the retained paused main-loop/BQL cut.
+         * Ordinary observer return grants no admission and needs no such cut.
+         */
+        status = checkpoint_identity(&checkpoint_transaction);
+        if (!status) {
+            status = qemu_crucible_checkpoint_main_loop_current();
+        }
+        if (status) {
+            return status;
+        }
+    }
+    if (qatomic_cmpxchg(&hold->producer_cut, 0, 1)) {
+        return -EAGAIN;
+    }
+    if (!hold->producer_borrowers) {
+        status = checkpoint_fail(&checkpoint_transaction, -ESTALE, true);
+    } else if (hold->root_acknowledged &&
+               (!hold->native_retired || !loan->retirement_observed ||
+                loan->observed_generation != hold->transaction_generation)) {
+        status = -EINPROGRESS;
+    } else {
+        /* An intermediate observation can end before ACK. The retained root
+         * keeps identity and dispatch closed while a later observer completes
+         * physical cleanup and the exact final acknowledgment.
+         */
+        hold->producer_borrowers--;
+        loan->active = false;
+        if (!hold->producer_borrowers && hold->root_acknowledged &&
+            hold->native_retired) {
+            qatomic_store_release(&hold->producer_admission_open, true);
+        }
+    }
+    qatomic_store_release(&hold->producer_cut, 0);
+    return status;
+}
+
+/* Callback return plus raw original post first permits real local disposition
+ * while the native collector and producer gate remain held. The real State
+ * owner then journals its queue/fault/page/source disposition and returns this
+ * root under the SAME live observation. Only later native physical cleanup may
+ * reopen admission. An initiating failure cannot suppress this safe return.
+ */
+int qemu_plugin_crucible_checkpoint_proof_retire_v1(
+    qemu_plugin_id_t id, qemu_plugin_crucible_checkpoint_proof_handle_v1 *hold,
+    qemu_plugin_crucible_checkpoint_producer_loan_v1 *observation)
+{
+    int status = checkpoint_producer_loan_current(id, observation);
+
+    if (status) {
+        return status;
+    }
+    if (hold != observation->hold || !qemu_thread_is_self(&hold->thread)) {
+        return -EPERM;
+    }
+    status = checkpoint_identity(&checkpoint_transaction);
+    if (!status) {
+        status = qemu_crucible_checkpoint_main_loop_current();
+    }
+    if (status) {
+        return status;
+    }
+    if (!qatomic_load_acquire(&hold->local_disposition_allowed)) {
+        return -EINPROGRESS;
+    }
+    if (qatomic_cmpxchg(&hold->producer_cut, 0, 1)) {
+        return -EAGAIN;
+    }
+    if (hold->root_retired) {
+        status = -EALREADY;
+    } else if (!hold->returned || hold->borrowers ||
+               checkpoint_transaction.invoking ||
+               checkpoint_transaction.invocation.active ||
+               checkpoint_transaction.invocation.readers ||
+               checkpoint_read.active || checkpoint_transaction.proof_borrow.active ||
+               !checkpoint_transaction.release_callback_returned ||
+               hold->producer_borrowers != 1) {
+        status = -EINPROGRESS;
+    } else {
+        qatomic_store_release(&hold->root_retired, true);
+        checkpoint_native_retire(&checkpoint_transaction);
+        status = qatomic_read(&checkpoint_transaction.first_status);
+        if (!status) {
+            status = qatomic_read(&checkpoint_transaction.post_status);
+        }
+    }
+    qatomic_store_release(&hold->producer_cut, 0);
+    return status;
+}
+
+/* State drops its retained root only after true native cleanup, while this
+ * last observation still pins the immutable identity. The transaction slot
+ * cannot be reused until the acknowledgment AND observation end are recorded.
+ */
+int qemu_plugin_crucible_checkpoint_proof_acknowledge_v1(
+    qemu_plugin_id_t id, qemu_plugin_crucible_checkpoint_producer_loan_v1 *loan)
+{
+    struct QemuCrucibleCheckpointProofHold *hold;
+    int status = checkpoint_producer_loan_current(id, loan);
+
+    if (status) {
+        return status;
+    }
+    hold = loan->hold;
+    if (!qatomic_load_acquire(&hold->native_retired)) {
+        return -EINPROGRESS;
+    }
+    status = checkpoint_identity(&checkpoint_transaction);
+    if (!status) {
+        status = qemu_crucible_checkpoint_main_loop_current();
+    }
+    if (status) {
+        return status;
+    }
+    if (qatomic_cmpxchg(&hold->producer_cut, 0, 1)) {
+        return -EAGAIN;
+    }
+    if (hold->root_acknowledged) {
+        status = -EALREADY;
+    } else if (!hold->root_retired || hold->producer_borrowers != 1 ||
+               hold->borrowers || !loan->retirement_observed ||
+               loan->observed_generation != hold->transaction_generation ||
+               !qemu_thread_is_self(&hold->thread)) {
+        status = -EINPROGRESS;
+    } else {
+        qatomic_store_release(&hold->root_acknowledged, true);
+    }
+    qatomic_store_release(&hold->producer_cut, 0);
+    return status;
+}
+
+int qemu_plugin_crucible_checkpoint_proof_hold_v1(
+    qemu_plugin_id_t id, qemu_plugin_crucible_checkpoint_proof_handle_v1 **out)
+{
+    QemuCrucibleCheckpointHeldTransaction *owner = &checkpoint_transaction;
+    struct QemuCrucibleCheckpointProofHold *hold = &owner->proof;
+    QemuCrucibleCheckpointNativeFence *fence;
+    uint64_t slice;
+    int status = checkpoint_proof_invocation(id);
+
+    if (status) {
+        return status;
+    }
+    if (!out || owner->invocation.action !=
+                    QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PAGER_PREPARE) {
+        return !out ? -EINVAL : -EPERM;
+    }
+    if (hold->retained) {
+        return -EALREADY;
+    }
+    status = checkpoint_live(owner, &slice, false);
+    if (!status) {
+        status = qemu_crucible_checkpoint_native_fence_acquire_v1(owner, &fence);
+    }
+    if (status) {
+        return status;
+    }
+    /* Record acquired custody before the fallible independent original post. */
+    hold->process = owner->process_id;
+    hold->thread = owner->thread;
+    hold->transaction = owner;
+    hold->pager = owner->pager;
+    hold->fence = fence;
+    hold->transaction_generation =
+        owner->request->coordinates.native_transaction_generation;
+    hold->provider_owner = owner->request->provider_owner;
+    qatomic_store_release(&hold->producer_admission_open, false);
+    qatomic_store_release(&hold->retained, true);
+    status = checkpoint_live(owner, &slice, true);
+    if (!status) {
+        *out = hold;
+    }
+    return status;
+}
+
+int qemu_plugin_crucible_checkpoint_proof_check_v1(
+    qemu_plugin_id_t id, qemu_plugin_crucible_checkpoint_proof_handle_v1 *hold)
+{
+    uint64_t slice;
+    int status = checkpoint_proof_current(id, hold);
+
+    return status ? status : checkpoint_live(&checkpoint_transaction, &slice, false);
+}
+
+int qemu_plugin_crucible_checkpoint_proof_borrow_begin_v1(
+    qemu_plugin_id_t id, qemu_plugin_crucible_checkpoint_proof_handle_v1 *hold,
+    qemu_plugin_crucible_checkpoint_proof_borrow_v1 **out)
+{
+    QemuCrucibleCheckpointHeldTransaction *owner = &checkpoint_transaction;
+    struct QemuCrucibleCheckpointProofBorrow *borrow = &owner->proof_borrow;
+    uint64_t slice;
+    int status = checkpoint_proof_current(id, hold);
+
+    if (status || !out) {
+        return status ? status : -EINVAL;
+    }
+    if (qatomic_cmpxchg(&hold->borrower_cut, 0, 1)) {
+        return -EAGAIN;
+    }
+    if (hold->borrowers == UINT_MAX || borrow->active) {
+        status = hold->borrowers == UINT_MAX ? -EOVERFLOW : -EBUSY;
+    } else {
+        status = checkpoint_live(owner, &slice, false);
+        if (!status) {
+            borrow->process = owner->process_id;
+            borrow->thread = owner->thread;
+            borrow->hold = hold;
+            borrow->invocation = &owner->invocation;
+            borrow->active = true;
+            hold->borrowers++;
+            *out = borrow;
+        }
+    }
+    qatomic_store_release(&hold->borrower_cut, 0);
+    return status;
+}
+
+int qemu_plugin_crucible_checkpoint_proof_borrow_end_v1(
+    qemu_plugin_id_t id, qemu_plugin_crucible_checkpoint_proof_borrow_v1 *borrow,
+    int initiating_status)
+{
+    QemuCrucibleCheckpointHeldTransaction *owner = &checkpoint_transaction;
+    struct QemuCrucibleCheckpointProofHold *hold;
+    uint64_t slice;
+    if (!qatomic_load_acquire(&owner->published) ||
+        owner->process_id != getpid() || !qemu_thread_is_self(&owner->thread) ||
+        !owner->invocation.active || owner->invocation.transaction != owner ||
+        id != owner->pager.installer.plugin_id ||
+        !qemu_crucible_checkpoint_pager_binding_current(&owner->pager)) {
+        return -EPERM;
+    }
+    /* An already recorded initiating failure cannot prevent actual borrower
+     * return. This identity-only cut grants no new work or original permission.
+     */
+    if (borrow != &owner->proof_borrow || !borrow->active ||
+        borrow->process != getpid() || !qemu_thread_is_self(&borrow->thread) ||
+        borrow->invocation != &owner->invocation ||
+        borrow->hold != &owner->proof || initiating_status > 0) {
+        return initiating_status > 0 ? -EINVAL : -EPERM;
+    }
+    hold = borrow->hold;
+    if (initiating_status) {
+        checkpoint_fail(owner, initiating_status, false);
+    }
+    if (qatomic_cmpxchg(&hold->borrower_cut, 0, 1)) {
+        return owner->first_status ? owner->first_status : -EAGAIN;
+    }
+    if (!hold->borrowers) {
+        qatomic_store_release(&hold->borrower_cut, 0);
+        return checkpoint_fail(owner, -ESTALE, true);
+    }
+    /* The same original is sampled on actual return even after read failure.
+     * Only this scoped borrower retires; the proof and whole original survive.
+     */
+    checkpoint_live(owner, &slice, true);
+    hold->borrowers--;
+    borrow->active = false;
+    qatomic_store_release(&hold->borrower_cut, 0);
+    return owner->first_status;
+}
+
+int qemu_plugin_crucible_checkpoint_proof_return_v1(
+    qemu_plugin_id_t id, qemu_plugin_crucible_checkpoint_proof_handle_v1 *hold)
+{
+    QemuCrucibleCheckpointHeldTransaction *owner = &checkpoint_transaction;
+    uint64_t slice;
+    int status = checkpoint_proof_current(id, hold);
+
+    if (status) {
+        return status;
+    }
+    if (owner->invocation.action != QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PAGER_RELEASE) {
+        return -EPERM;
+    }
+    if (!owner->mailbox_restored || hold->borrowers || owner->invocation.readers ||
+        owner->candidate_read.active ||
+        !qatomic_load_acquire(&owner->request->final_disposition_published)) {
+        return -EINPROGRESS;
+    }
+    if (qatomic_cmpxchg(&hold->borrower_cut, 0, 1)) {
+        return -EAGAIN;
+    }
+    /* Record current original failure, but do not prevent safe same-owned
+     * local return. This releases no native physical exclusion or new work. */
+    checkpoint_live(owner, &slice, false);
+    status = qemu_crucible_checkpoint_native_fence_return_v1(owner, hold->fence);
+    if (!status) {
+        /* Physical return is journaled before the independent original post.
+         * A later failure retains cleanup; it cannot pretend this hold remains.
+         */
+        hold->returned = true;
+        checkpoint_live(owner, &slice, true);
+        status = qatomic_read(&owner->first_status);
+        if (!status) {
+            status = qatomic_read(&owner->post_status);
+        }
+    }
+    qatomic_store_release(&hold->borrower_cut, 0);
+    return status;
+}
+
+int qemu_plugin_crucible_checkpoint_proof_return_observe_v1(
+    qemu_plugin_id_t id, qemu_plugin_crucible_checkpoint_proof_handle_v1 *hold,
+    struct qemu_plugin_crucible_checkpoint_return_status_v1 *out)
+{
+    QemuCrucibleCheckpointHeldTransaction *owner = &checkpoint_transaction;
+    struct qemu_plugin_crucible_checkpoint_return_status_v1 observed = { 0 };
+    int status = checkpoint_identity(owner);
+
+    if (status) {
+        return status;
+    }
+    if (!owner->invocation.active || owner->invocation.transaction != owner ||
+        owner->invocation.action != QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PAGER_RELEASE ||
+        !owner->cleanup_invoking || id != owner->pager.installer.plugin_id ||
+        hold != &owner->proof || !qatomic_load_acquire(&hold->retained) ||
+        hold->transaction != owner || hold->process != getpid() ||
+        !qemu_thread_is_self(&hold->thread) ||
+        hold->pager.installer.ctx != owner->pager.installer.ctx ||
+        hold->pager.installer.module != owner->pager.installer.module ||
+        hold->pager.installer.install != owner->pager.installer.install ||
+        hold->pager.userdata != owner->pager.userdata ||
+        hold->pager.prepare != owner->pager.prepare ||
+        hold->pager.check != owner->pager.check ||
+        hold->pager.release != owner->pager.release) {
+        return -EPERM;
+    }
+    status = qemu_crucible_checkpoint_main_loop_current();
+    if (status) {
+        return status;
+    }
+    if (!out) {
+        return -EINVAL;
+    }
+    if (qatomic_cmpxchg(&hold->borrower_cut, 0, 1)) {
+        return -EAGAIN;
+    }
+    observed.schema_version = 1;
+    observed.struct_size = sizeof(observed);
+    observed.returned = hold->returned;
+    observed.mailbox_restored = owner->mailbox_restored;
+    observed.first_status = qatomic_read(&owner->first_status);
+    observed.post_status = qatomic_read(&owner->post_status);
+    observed.native_transaction_generation =
+        owner->request->coordinates.native_transaction_generation;
+    qatomic_store_release(&hold->borrower_cut, 0);
+    *out = observed;
+    return 0;
+}
+
+int qemu_crucible_checkpoint_original_query_slice_v1(
+    QemuCrucibleCheckpointInvocationLoan *loan, uint64_t *bounded_ns)
+{
+    uint64_t slice;
+    int status = checkpoint_invocation_current(loan);
+
+    if (status) {
+        return status;
+    }
+    if (!bounded_ns) {
+        return -EINVAL;
+    }
+    status = checkpoint_live(loan->transaction, &slice, false);
+    if (!status) {
+        *bounded_ns = slice;
+    }
+    return status;
+}
+
+int qemu_crucible_checkpoint_original_check_v1(
+    QemuCrucibleCheckpointInvocationLoan *loan)
+{
+    uint64_t slice;
+
+    return qemu_crucible_checkpoint_original_query_slice_v1(loan, &slice);
+}
