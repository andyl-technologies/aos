+static void assert_setup_refusal(const uint8_t *wire, size_t length)
+{
+    QemuCrucibleDeviceWorkspaceSetupView view;
+    uint8_t sentinel[sizeof(view)];
+
+    memset(&view, 0x5a, sizeof(view));
+    memcpy(sentinel, &view, sizeof(sentinel));
+    g_assert_cmpint(qemu_crucible_device_workspace_setup_decode(
+                        wire, length, &view), <, 0);
