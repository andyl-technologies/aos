+static void test_stale_token_and_admission(void)
+{
+    uintptr_t old_token, replacement_token;
+    uint64_t stop_generation;
+
+    reset_control();
+    g_assert_cmpint(qemu_plugin_advance_time_ticks(19000), ==, 0);
+    stop_batch();
+    stop_generation = qemu_plugin_crucible_vmstop_generation_value;
+    publish_wake();
+    g_assert_cmpuint(qemu_plugin_rr_control_request_generation, ==, 0);
+    g_assert_cmpuint(qemu_plugin_rr_control_complete_generation, ==, 0);
+    g_assert_true(qemu_plugin_crucible_control_boundary_outstanding());
+    g_assert_false(crucible_hot_fork_exact_paused_boundary());
+    g_assert_cmpint(qemu_plugin_crucible_vmstop_cold_begin(), ==, -EBUSY);
+    g_assert_cmpuint(qemu_plugin_crucible_vmstop_generation_value, ==,
+                     stop_generation);
+    service_events();
+    old_token = qemu_plugin_control_boundary_scheduled;
+    g_assert_cmpuint(old_token, >, 0);
+    publish_wake();
+    replacement_token = qemu_plugin_control_boundary_scheduled;
+    g_assert_cmpuint(replacement_token, >, old_token);
+    qemu_plugin_control_boundary_complete_bh((void *)old_token);
+    g_assert_cmpuint(qemu_plugin_control_boundary_scheduled, ==,
+                     replacement_token);
+    g_assert_true(qemu_plugin_crucible_control_boundary_outstanding());
+    g_assert_cmpuint(control_calls, ==, 0);
+    service_events();
+    g_assert_cmpuint(control_calls, ==, 1);
+    g_assert_false(qemu_plugin_crucible_control_boundary_outstanding());
+    g_assert_true(crucible_hot_fork_exact_paused_boundary());
+    /* Reset/shutdown cancellation explicitly retires its own outstanding work. */
+    publish_wake();
+    qemu_plugin_crucible_rr_control_boundary_cancel();
+    service_events();
+    g_assert_false(qemu_plugin_crucible_control_boundary_outstanding());
+    g_assert_cmpuint(control_calls, ==, 1);
+}
+
+static void nested_control(unsigned index, uint64_t coordinate, void *userdata)
+{
+    count_control(index, coordinate, userdata);
+    publish_wake();
+    emit_batch();
+    /* Transfer may queue the next owner, but cannot reenter this callback. */
+    g_assert_cmpuint(control_calls, ==, 1);
+    g_assert_cmpuint(qemu_plugin_rr_control_complete_generation, ==, 1);
+    g_assert_cmpuint(qemu_plugin_rr_control_request_generation, ==, 2);
+    qemu_plugin_control_boundary_cb = count_control;
+}
+
+static void test_nested_control_tx(void)
+{
+    reset_control();
+    qemu_plugin_control_boundary_cb = nested_control;
+    publish_wake();
+    qemu_plugin_crucible_rr_control_boundary_acknowledge();
+    current_cpu = NULL;
+    service_events();
+    g_assert_cmpuint(control_calls, ==, 2);
+    g_assert_true(qemu_plugin_crucible_vmstop_quiesced());
+    g_assert_cmpuint(qemu_plugin_rr_control_complete_generation, ==, 2);
+    g_assert_cmpuint(qemu_plugin_rr_control_request_generation, ==, 2);
+    /* A later RR scan must not deliver the transferred request twice. */
+    rr_crucible_sim_acknowledge_control_boundary();
+    service_events();
+    g_assert_cmpuint(control_calls, ==, 2);
+    g_assert_cmpuint(qemu_plugin_rr_control_complete_generation, ==, 2);
+    g_assert_false(qemu_plugin_crucible_control_boundary_outstanding());
+}
+
+static void test_unplugged_boundary_refuses(void)
+{
+    reset_control();
+    stop_batch();
+    cpu.unplug = true;
+    publish_wake();
+    service_events();
+    g_assert_cmpuint(control_calls, ==, 0);
+    g_assert_true(qemu_plugin_crucible_control_boundary_outstanding());
+    cpu.unplug = false;
+    publish_wake();
+    service_events();
+    g_assert_cmpuint(control_calls, ==, 1);
+    g_assert_false(qemu_plugin_crucible_control_boundary_outstanding());
