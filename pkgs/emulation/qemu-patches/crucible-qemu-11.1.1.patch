+int qemu_plugin_crucible_fingerprint_worker_work_return_v2(
+    qemu_plugin_id_t id, QemuCrucibleFingerprintWorkRef *projection, int *result)
+{
+    QemuCrucibleFingerprintWorker *worker = &startup_source.fingerprint_worker;
+    QemuCrucibleFingerprintWork *work;
+    size_t completed_index;
+    int status = fingerprint_worker_identity(worker);
+
+    if (status || id != startup_source.saved.plugin_id || !projection || !result ||
+        !qemu_in_main_thread() ||
+        callback_child_output_overlap(projection, sizeof(*projection),
+                                      &startup_source, sizeof(startup_source)) ||
+        callback_child_output_overlap(result, sizeof(*result), &startup_source, sizeof(startup_source)) ||
+        callback_child_output_overlap(projection, sizeof(*projection), result, sizeof(*result))) {
+        return status ? status : -EPERM;
+    }
+    if (fingerprint_output_workspace_overlap(projection, sizeof(*projection)) ||
+        fingerprint_output_workspace_overlap(result, sizeof(*result))) {
+        return -EINVAL;
