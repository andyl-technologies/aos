+        return status ? status : -EPERM;
+    }
+    status = qemu_crucible_ram_inventory_capture_identity_v1(loan, *capture);
+    if (status) {
+        return status;
+    }
+    loan->capture = NULL;
+    loan->capture_holder = NULL;
