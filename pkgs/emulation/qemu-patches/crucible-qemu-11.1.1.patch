+        '((QemuHotForkThreadRecord *)owner->record)->ram_writer_closed = false;',
+        '((QemuHotForkThreadRecord *)owner->record)->ram_writer_closed = true;',
+    ),
+}
+affected = {
+    'readonly admission': 'self-cpu',
+    'close marker': 'self-cpu',
+    'upgrade marker': 'upgrade',
+    'CPU promotion': 'cpu-promotion',
+    'scope promotion': 'scope-promotion',
+    'fork identity': 'copied-rebind',
+    'nested leave debit': 'io-nested',
+    'return marker': 'return-marker',
+    'typed copied-debt prelock guards': 'copied-status',
+    'copied readonly custody': 'copied-readonly',
+}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('root', type=Path)
+    parser.add_argument('outputs', nargs=12, type=Path)
+    args = parser.parse_args()
+    for name, expected in SOURCE_HASHES.items():
+        if hashlib.sha256((args.root / name).read_bytes()).hexdigest() != expected:
+            raise ValueError(f'source changed: {name}')
+    text, names = assemble(args.root)
+    args.outputs[0].write_text(text)
+    omitted = []
+    for index, (name, (before, after)) in enumerate(mutations.items()):
+        expected = 11 if name == 'typed copied-debt prelock guards' else 1
+        if text.count(before) != expected:
+            raise ValueError(f'omission anchor changed: {name}')
+        args.outputs[index + 1].write_text(text.replace(before, after))
+        omitted.append({'name': name, 'case': affected[name]})
+    receipt = {'inputs': SOURCE_HASHES, 'functions': names, 'omissions': omitted,
+               'outputs': {str(p): hashlib.sha256(p.read_bytes()).hexdigest()
+                           for p in args.outputs[:-1]},
+               'scope': __doc__}
+    args.outputs[-1].write_text(json.dumps(receipt, indent=2) + '\n')
+
+
+if __name__ == '__main__':
+    main()
