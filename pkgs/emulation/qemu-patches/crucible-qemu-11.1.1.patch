@@ -0,0 +1,146 @@
+/*
+ * Fixed pre-exec Setup transport selection
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef QEMU_CRUCIBLE_PREEXEC_SETUP_H
+#define QEMU_CRUCIBLE_PREEXEC_SETUP_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+/* Selection requires the pre-exec receive/refusal route. It conveys no
+ * namespace profile, original purpose, metadata credit or spawn permission.
+ * Absent selector preserves ordinary unselected behavior. A present selector
+ * with a value other than 5 or 6 must refuse; no selected late-receive fallback exists.
+ */
+#define QEMU_CRUCIBLE_PREEXEC_SETUP_SELECTOR "QEMU_CRUCIBLE_PREEXEC_SETUP"
+#define QEMU_CRUCIBLE_PREEXEC_SETUP_SELECTOR_V5 "5"
+#define QEMU_CRUCIBLE_PREEXEC_SETUP_SELECTOR_V6 "6"
+#define QEMU_CRUCIBLE_PREEXEC_SETUP_EDITION 5U
+
+/* Process-private required-route marker, published only by executable preinit.
+ * It can require refusal; it never issues a child share or table entitlement.
+ * No genuine child once-carrier constructor is currently supplied, so selected
+ * fork/spawn/re-exec routes refuse before their pipe/stack/table effects. Native
+ * pthreads remain in the same process table; this marker supplies no task loan.
+ */
+extern int qemu_crucible_selected_process_id;
+int qemu_crucible_process_birth_check(void);
+
+/* Fixed BE numeric support evidence in the actual system executable ELF.
+ * The preinit function references this section; it is not a purpose or an
+ * accepting constructor. Bit0 advertises once-receive/refusal only. Source
+ * activation and checkpoint ingress versions remain0 while not joined.
+ */
+#define QEMU_CRUCIBLE_PREEXEC_SUPPORT_SECTION ".qemu.crucible.preexec"
+#define QEMU_CRUCIBLE_PREEXEC_SUPPORT_MAGIC "CRUCRCV1"
+#define QEMU_CRUCIBLE_PREEXEC_SUPPORT_SCHEMA 1U
+#define QEMU_CRUCIBLE_PREEXEC_SUPPORT_BYTES 40U
+#define QEMU_CRUCIBLE_PREEXEC_SUPPORT_SETUP_OFFSET 16U
+#define QEMU_CRUCIBLE_PREEXEC_SUPPORT_PURPOSE_OFFSET 20U
+#define QEMU_CRUCIBLE_PREEXEC_SUPPORT_OUTER_OFFSET 24U
+#define QEMU_CRUCIBLE_PREEXEC_SUPPORT_FLAGS_OFFSET 28U
+#define QEMU_CRUCIBLE_PREEXEC_SUPPORT_SOURCE_ACTIVATION_OFFSET 32U
+#define QEMU_CRUCIBLE_PREEXEC_SUPPORT_CHECKPOINT_INGRESS_OFFSET 36U
+#define QEMU_CRUCIBLE_PREEXEC_SUPPORT_ONCE_REFUSAL 1U
+
+/* The existing owned plain-UNIX control endpoint is borrowed once for selected
+ * receipt. Inherited memory/wake coordinates are separate aliases, not another
+ * SCM roster, receiver or purpose. Their physical inventory and retirement are
+ * required before reuse; old/queued/received overlap must already be paid.
+ */
+#define QEMU_CRUCIBLE_PREEXEC_SETUP_CONTROL_FD 3
+#define QEMU_CRUCIBLE_PREEXEC_SETUP_INHERITED_MEMORY_FD 4
+#define QEMU_CRUCIBLE_PREEXEC_SETUP_INHERITED_WAKE_FD 5
+/* Separate inherited RAM socketpair, never an initial Setup SCM role. The
+ * number alone grants nothing; Purpose5 after-birth witness and real issuer
+ * kernel observation must construct its retained owner before borrowing. */
+#define QEMU_CRUCIBLE_PREEXEC_RAM_CONTROL_FD 9
+
+/* Selected receipt must verify the real endpoint is AF_UNIX/SOCK_STREAM and
+ * use per-call nonblocking recvmsg without changing its shared OFD flags.
+ * Exactly one consumed raw frame and its actual received aliases remain in
+ * native custody on success, refusal and uncertainty. The later installer
+ * borrows that same retained owner; it never receives or duplicates it again.
+ * Transport receipt alone does not authenticate an original or issuer;
+ * the genuine same-carrier peer/family/contract/artifact cuts remain required.
+ */
+
+/* Immediate transport cutover: the tag identifies this edition. No extra
+ * version byte is added to the existing length/tag/payload geometry.
+ */
+#define QEMU_CRUCIBLE_PREEXEC_SETUP_TAG_V5 0x15U
+#define QEMU_CRUCIBLE_PREEXEC_SETUP_LEGACY_TAG 0x01U
+#define QEMU_CRUCIBLE_PREEXEC_SETUP_LENGTH_OFFSET 0U
+#define QEMU_CRUCIBLE_PREEXEC_SETUP_TAG_OFFSET 4U
+#define QEMU_CRUCIBLE_PREEXEC_SETUP_PAYLOAD_OFFSET 5U
+#define QEMU_CRUCIBLE_PREEXEC_SETUP_PAYLOAD_BYTES 56U
+#define QEMU_CRUCIBLE_PREEXEC_SETUP_MESSAGE_BYTES 57U
+#define QEMU_CRUCIBLE_PREEXEC_SETUP_FRAME_BYTES 61U
+#define QEMU_CRUCIBLE_PREEXEC_SETUP_MESSAGE_MAX_BYTES 64U
+
+/* Additive preparation-only transport. The selected activation/capability
+ * remains unavailable; neither receipt nor this edition issues a session. */
+#define QEMU_CRUCIBLE_PREEXEC_SETUP_TAG_V6 0x16U
+#define QEMU_CRUCIBLE_PREEXEC_SETUP_V6_PAYLOAD_BYTES 120U
+#define QEMU_CRUCIBLE_PREEXEC_SETUP_V6_MESSAGE_BYTES 121U
+#define QEMU_CRUCIBLE_PREEXEC_SETUP_V6_FRAME_BYTES 125U
+#define QEMU_CRUCIBLE_PREEXEC_SETUP_V6_BASE_FDS 8U
+#define QEMU_CRUCIBLE_PREEXEC_SETUP_V6_WORKSPACE_FDS 9U
+
+/* All integer fields are big endian; these are byte offsets, not a C layout. */
+#define QEMU_CRUCIBLE_PREEXEC_SETUP_REGION_LENGTH_OFFSET 0U
+#define QEMU_CRUCIBLE_PREEXEC_SETUP_WORKSPACE_SCHEMA_OFFSET 8U
+#define QEMU_CRUCIBLE_PREEXEC_SETUP_WORKSPACE_FLAGS_OFFSET 12U
+#define QEMU_CRUCIBLE_PREEXEC_SETUP_PROCESS_GENERATION_OFFSET 16U
+#define QEMU_CRUCIBLE_PREEXEC_SETUP_ACCOUNT_GENERATION_OFFSET 24U
+#define QEMU_CRUCIBLE_PREEXEC_SETUP_WORKSPACE_GENERATION_OFFSET 32U
+#define QEMU_CRUCIBLE_PREEXEC_SETUP_WORKSPACE_DEVICE_OFFSET 40U
+#define QEMU_CRUCIBLE_PREEXEC_SETUP_WORKSPACE_INODE_OFFSET 48U
+
+#define QEMU_CRUCIBLE_PREEXEC_SETUP_WORKSPACE_ABSENT 0U
+#define QEMU_CRUCIBLE_PREEXEC_SETUP_WORKSPACE_PRESENT 1U
+#define QEMU_CRUCIBLE_PREEXEC_SETUP_WORKSPACE_FLAG 2U
+
+/* Existing SCM roster order; these roles include the two separately prepaid standing lenders. */
+#define QEMU_CRUCIBLE_PREEXEC_SETUP_SHARED_MEMORY_INDEX 0U
+#define QEMU_CRUCIBLE_PREEXEC_SETUP_WAKE_INDEX 1U
+#define QEMU_CRUCIBLE_PREEXEC_SETUP_PURPOSE_PLAN_INDEX 2U
+#define QEMU_CRUCIBLE_PREEXEC_SETUP_STANDING_PUBLICATION_INDEX 3U
+#define QEMU_CRUCIBLE_PREEXEC_SETUP_STANDING_CANCELLATION_INDEX 4U
+#define QEMU_CRUCIBLE_PREEXEC_SETUP_WORKSPACE_INDEX 5U
+#define QEMU_CRUCIBLE_PREEXEC_SETUP_BASE_FDS 5U
+#define QEMU_CRUCIBLE_PREEXEC_SETUP_WORKSPACE_FDS 6U
+
+/* The selected executable accepts exactly one separate -plugin argument,
+ * whose first implied-file value is an absolute path. This fixed pathname
+ * buffer includes its terminator. The argument scan is bounded independently
+ * of pathname storage; neither bound issues allocation or artifact authority.
+ * Additional file selectors (including bare nofile) and alternative/joined
+ * -plugin forms are unsupported on this selected route only.
+ */
+#define QEMU_CRUCIBLE_PREEXEC_PLUGIN_PATH_BYTES 4096U
+#define QEMU_CRUCIBLE_PREEXEC_PLUGIN_ARGUMENT_BYTES 131072U
+
+/*
+ * Version5 requires BEu32 message length57, tag0x15 and exactly56 payload bytes.
+ * process_generation is nonzero on both routes. Workspace schema/flags0/0
+ * requires zero account/workspace generations and zero workspace device/inode,
+ * with exactly5 SCM descriptors. Schema/flags1/2 requires nonzero account and
+ * workspace generations and exactly6 descriptors. Device/inode must retain
+ * their actual issued binding; no nonzero-device or guessed inode rule exists.
+ * Every other schema/flags combination or descriptor count refuses.
+ *
+ * These are exact transport coordinates and fixed landing arithmetic. Source
+ * admission additionally requires the authentic same-carrier family, selected
+ * child contract, original and installing artifact. The bytes alone construct
+ * no issuer, namespace, descriptor owner or permission fallback. Full selected
+ * activation remains refused until the actual required lifetimes are joined.
+ */
+
+/* Artifact-only constructor declaration. It conveys no execution credit or
+ * activation; inspect its actual getter/constructor and co-retained source. */
+const uint8_t *qemu_crucible_preexec_standing_constructor_layout_v1(size_t *bytes);
+
+#endif /* QEMU_CRUCIBLE_PREEXEC_SETUP_H */
diff --git a/include/qemu/crucible-process-purpose.h b/include/qemu/crucible-process-purpose.h
