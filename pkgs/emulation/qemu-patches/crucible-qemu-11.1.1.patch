+static bool cpu_timers_fingerprint_projection(QEMUFile *f,
+                                              const void *opaque,
+                                              Error **errp)
+{
+    const TimersState *s = opaque;
+    int icount_mode = icount_enabled();
+    unsigned sequence;
+    int64_t cpu_ticks_offset;
+    int64_t cpu_clock_offset;
+    const char *accelerator_name = current_accel_name();
+    bool native_sim_pause = icount_mode && accelerator_name &&
+        strcmp(accelerator_name, "sim") == 0 &&
+        runstate_check(RUN_STATE_PAUSED);
+
+    (void)errp;
+    do {
+        sequence = seqlock_read_begin(&s->vm_clock_seqlock);
+        cpu_ticks_offset = icount_mode ? 0 : s->cpu_ticks_offset;
+        cpu_clock_offset = icount_mode ? 0 : s->cpu_clock_offset;
+    } while (seqlock_read_retry(&s->vm_clock_seqlock, sequence));
+
+    qemu_put_be32(f, icount_mode);
+    qemu_put_be64(f, cpu_ticks_offset);
+    qemu_put_be64(f, cpu_clock_offset);
+    /* Native QMP pause stops host ticks without changing sim continuation. */
+    qemu_put_be16(f, native_sim_pause ? 1 : s->cpu_ticks_enabled);
+    if (icount_mode) {
+        qemu_put_be16(f, s->icount_time_shift);
+        if (icount_mode == ICOUNT_ADAPTATIVE) {
+            qemu_put_be64(f, s->last_delta);
+        }
+        qemu_put_be64(f, s->qemu_icount_bias_ps_hi);
+        qemu_put_be64(f, s->qemu_icount_bias_ps_lo);
+        qemu_put_be64(f, s->qemu_icount);
+        qemu_put_be64(f, s->crucible_sim_tick_bias);
+        qemu_put_byte(f, s->crucible_rr_cursor_valid);
+        if (s->crucible_rr_cursor_valid) {
+            qemu_put_be64(f, s->crucible_rr_current_vcpu);
+            qemu_put_be64(f, s->crucible_rr_cursor_position);
+        }
+        /*
+         * selection_pending is reconstructed when snapshot continuation is
+         * armed; it is not durable scheduler state. The owner and cursor above
+         * completely describe the serialized continuation coordinate.
+         */
+        cpu_timer_fingerprint_projection(f, s->icount_rt_timer);
+        cpu_timer_fingerprint_projection(f, s->icount_vm_timer);
