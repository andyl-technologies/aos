+CrucibleCheckpointRestore *qemu_crucible_checkpoint_restore(
+    int root_fd, int device_fd, int cancellation_fd,
+    const char *root_blake3, const char *topology_blake3,
+    const char *source_session, const char *source_owner,
+    uint64_t source_generation, const char *device_sha256,
