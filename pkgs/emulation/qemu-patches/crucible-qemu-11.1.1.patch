+/* All fields, including ready dispatch and pending physical journals, belong
+ * to one prebirth Source storage debit. Registration facts grant no Original,
+ * execution exclusion, hardware drain or accepted fingerprint baseline. */
+struct QemuCrucibleFingerprintMainExecution {
