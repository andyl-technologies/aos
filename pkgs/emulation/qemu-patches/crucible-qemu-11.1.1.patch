+            cs->crucible_interrupt_source_sequence[event->vector] =
+                event->source_sequence;
+            cs->crucible_interrupt_routing_generation[event->vector] =
+                event->routing_generation;
+            cs->crucible_interrupt_priority[event->vector] =
+                event->priority;
+            cs->crucible_interrupt_priority_valid |= 1U << event->vector;
+        }
+        gicv3_redist_update(cs);
+    } else if (event->vector < cs->gic->num_irq) {
+        bool pending =
+            cs->gic->pending[BIT32_WORD(event->vector)] &
+            BIT32_MASK(event->vector);
+
+        if (!pending || !event->retain_pending) {
+            cs->gic->crucible_interrupt_target[event->vector] =
+                event->target_vcpu;
+        }
+        gicv3_gicd_pending_set(cs->gic, event->vector);
+        if (!pending || !event->retain_pending) {
+            cs->gic->crucible_interrupt_family[event->vector] =
+                event->family;
+            cs->gic->crucible_interrupt_source_sequence[event->vector] =
+                event->source_sequence;
+            cs->gic->crucible_interrupt_routing_generation[event->vector] =
+                event->routing_generation;
+            cs->gic->crucible_interrupt_priority[event->vector] =
+                event->priority;
+            cs->gic->crucible_interrupt_priority_valid[
+                BIT32_WORD(event->vector)] |= BIT32_MASK(event->vector);
+        }
+        gicv3_update(cs->gic, event->vector, 1);
+    } else {
+        gicv3_redist_process_lpi(cs, event->vector, 1);
+    }
+}
+
+static bool gicv3_cpuif_crucible_pending(GICv3CPUState *cs, uint32_t irq)
+{
+    uint8_t pending;
+
+    if (irq < GIC_INTERNAL) {
+        return cs->gicr_ipendr0 & (1U << irq);
+    }
+    if (irq < cs->gic->num_irq) {
+        return gicv3_gicd_pending_test(cs->gic, irq);
+    }
+    if (irq < GICV3_LPI_INTID_START) {
+        return true;
+    }
+    if (address_space_read(
+            &cs->gic->dma_as,
+            (cs->gicr_pendbaser & R_GICR_PENDBASER_PHYADDR_MASK) + irq / 8,
+            MEMTXATTRS_UNSPECIFIED, &pending, sizeof(pending)) != MEMTX_OK) {
+        return true;
+    }
+    return extract32(pending, irq % 8, 1);
+}
+
+static void gicv3_cpuif_crucible_clear_pending(
+    GICv3CPUState *cs, uint32_t intid)
+{
+    if (intid < GIC_INTERNAL) {
+        cs->gicr_ipendr0 &= ~(1U << intid);
+        cs->crucible_interrupt_family[intid] = 0;
+        cs->crucible_interrupt_source_sequence[intid] = 0;
+        cs->crucible_interrupt_routing_generation[intid] = 0;
+        cs->crucible_interrupt_priority_valid &= ~(1U << intid);
+        gicv3_redist_update(cs);
+    } else if (intid < cs->gic->num_irq) {
+        gicv3_gicd_pending_clear(cs->gic, intid);
+        cs->gic->crucible_interrupt_family[intid] = 0;
+        cs->gic->crucible_interrupt_source_sequence[intid] = 0;
+        cs->gic->crucible_interrupt_routing_generation[intid] = 0;
+        cs->gic->crucible_interrupt_target[intid] = -1;
+        cs->gic->crucible_interrupt_priority_valid[BIT32_WORD(intid)] &=
+            ~BIT32_MASK(intid);
+        gicv3_update(cs->gic, intid, 1);
+    } else {
+        gicv3_redist_lpi_pending(cs, intid, 0);
+        qemu_crucible_fault_interrupt_provenance_clear(
+            QEMU_CRUCIBLE_INTERRUPT_ARM_GIC_LPI,
+            cs->cpu->cpu_index, intid);
+    }
+}
+
+static bool gicv3_cpuif_crucible_intercept(
+    GICv3CPUState *cs, uint64_t *intid)
+{
+    QemuCrucibleInterruptEvent event = { 0 };
+    uint32_t irq = *intid;
+    bool edge;
+
+    if (gicv3_intid_is_special(irq)) {
+        return true;
+    }
+    if (irq < GIC_INTERNAL) {
+        edge = extract32(cs->edge_trigger, irq, 1);
+        event.family = irq < GIC_NR_SGIS ?
+            QEMU_CRUCIBLE_INTERRUPT_ARM_GIC_SGI :
+            (cs->crucible_interrupt_family[irq] != 0 ?
+                cs->crucible_interrupt_family[irq] :
+                QEMU_CRUCIBLE_INTERRUPT_ARM_GIC_PPI);
+    } else if (irq < GICV3_LPI_INTID_START) {
+        edge = gicv3_gicd_edge_trigger_test(cs->gic, irq);
+        event.family = cs->gic->crucible_interrupt_family[irq] != 0 ?
+            cs->gic->crucible_interrupt_family[irq] :
+            QEMU_CRUCIBLE_INTERRUPT_ARM_GIC_SPI;
+    } else {
+        edge = true;
+        event.family = QEMU_CRUCIBLE_INTERRUPT_ARM_GIC_LPI;
+    }
+    event.trigger = edge ? QEMU_CRUCIBLE_INTERRUPT_TRIGGER_EDGE :
+        QEMU_CRUCIBLE_INTERRUPT_TRIGGER_LEVEL;
+    event.polarity = QEMU_CRUCIBLE_INTERRUPT_POLARITY_HIGH;
+    event.model_phase = QEMU_CRUCIBLE_INTERRUPT_PHASE_DELIVER;
+    event.target_vcpu = cs->cpu->cpu_index;
+    event.vector = irq;
+    event.priority = cs->hppi.prio;
+    if (qemu_crucible_fault_interrupt_provenance_get(
+            event.family, cs->cpu->cpu_index, irq, &event)) {
+        qemu_crucible_fault_interrupt_provenance_clear(
+            event.family, cs->cpu->cpu_index, irq);
+        event.model_phase = QEMU_CRUCIBLE_INTERRUPT_PHASE_DELIVER;
+        event.priority = cs->hppi.prio;
+    } else {
+        event.source_sequence = irq < GIC_INTERNAL ?
+            cs->crucible_interrupt_source_sequence[irq] :
+            (irq < cs->gic->num_irq ?
+                cs->gic->crucible_interrupt_source_sequence[irq] :
+                qemu_crucible_fault_interrupt_source_current_sequence());
+        event.routing_generation = irq < GIC_INTERNAL ?
+            cs->crucible_interrupt_routing_generation[irq] :
+            (irq < cs->gic->num_irq ?
+                cs->gic->crucible_interrupt_routing_generation[irq] : 0);
+    }
+    if (event.source_sequence == 0) {
+        event.source_sequence =
+            qemu_crucible_fault_interrupt_source_next_sequence();
+    }
+    if (event.routing_generation == 0) {
+        event.routing_generation =
+            qemu_crucible_fault_interrupt_current_routing_generation();
+    }
+    event.duplicate_ordinal = 0;
+    event.disposition = 0;
+
+    if (!qemu_crucible_fault_interrupt_intercept(
+            &event, gicv3_cpuif_crucible_inject, cs)) {
+        gicv3_cpuif_crucible_clear_pending(cs, irq);
+        if (event.disposition == 1 && !edge) {
+            if (irq < GIC_INTERNAL && extract32(cs->level, irq, 1)) {
+                cs->gicr_ipendr0 |= 1U << irq;
+                gicv3_redist_update(cs);
+            } else if (irq < cs->gic->num_irq &&
+                       gicv3_gicd_level_test(cs->gic, irq)) {
+                cs->gic->crucible_interrupt_target[irq] =
+                    event.target_vcpu;
+                gicv3_gicd_pending_set(cs->gic, irq);
+                gicv3_update(cs->gic, irq, 1);
+            }
+        }
+        *intid = INTID_SPURIOUS;
+        qemu_crucible_fault_interrupt_committed(&event);
+        return false;
+    }
+    if (event.vector != irq) {
+        if (gicv3_cpuif_crucible_pending(cs, event.vector) ||
+            !qemu_crucible_fault_interrupt_route_valid(&event) ||
+            !qemu_crucible_fault_interrupt_provenance_can_set(&event)) {
+            qemu_crucible_fault_interrupt_commit_error();
+            *intid = INTID_SPURIOUS;
+            qemu_crucible_fault_interrupt_committed(&event);
+            return false;
+        }
+        gicv3_cpuif_crucible_clear_pending(cs, irq);
+        event.release_phase = QEMU_CRUCIBLE_INTERRUPT_PHASE_DELIVER;
+        if (!qemu_crucible_fault_interrupt_provenance_set(
+                &event, true)) {
+            g_assert_not_reached();
+        }
+        gicv3_cpuif_crucible_inject(&event, cs);
+        *intid = INTID_SPURIOUS;
+        qemu_crucible_fault_interrupt_committed(&event);
+        return false;
+    } else if (irq < GIC_INTERNAL) {
+        cs->crucible_interrupt_family[irq] = 0;
+        cs->crucible_interrupt_source_sequence[irq] = 0;
+        cs->crucible_interrupt_routing_generation[irq] = 0;
+        cs->crucible_interrupt_priority_valid &= ~(1U << irq);
+    } else if (irq < cs->gic->num_irq) {
+        cs->gic->crucible_interrupt_family[irq] = 0;
+        cs->gic->crucible_interrupt_source_sequence[irq] = 0;
+        cs->gic->crucible_interrupt_routing_generation[irq] = 0;
+        cs->gic->crucible_interrupt_target[irq] = -1;
+        cs->gic->crucible_interrupt_priority_valid[BIT32_WORD(irq)] &=
+            ~BIT32_MASK(irq);
+    } else {
+        qemu_crucible_fault_interrupt_provenance_clear(
+            QEMU_CRUCIBLE_INTERRUPT_ARM_GIC_LPI,
+            cs->cpu->cpu_index, irq);
+    }
+    return true;
+}
