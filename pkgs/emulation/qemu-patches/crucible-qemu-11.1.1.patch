+
+    reset_fixture();
+    add_tb(&blocks[0], 8, 7, 4090);
+    add_tb(&blocks[1], 8, 6, 4090);
+    add_tb(&blocks[2], 8, 4, 4090);
+    add_tb(&blocks[3], 8, 2, 4090);
+    check_collection("reverse-order-spill", 8, 8, 0x1d4,
+                     "L8 T2 T4 T6 T7 U2 U4 U6 U7 U8 ");
+
+    reset_fixture();
+    add_tb(&blocks[0], 8, 6, 4090);
+    add_tb(&blocks[1], 8, 4, 4090);
+    add_tb(&blocks[2], 8, 2, 4090);
+    transient_busy_index = 6;
+    check_collection("busy-before-spill", 8, 8, 0x154,
+                     "L8 T2 T4 B6 U2 U4 U8 L2 L4 L6 L8 U2 U4 U6 U8 ");
+
+    reset_fixture();
+    add_tb(&blocks[0], 8, 7, 4090);
+    add_tb(&blocks[1], 8, 6, 4090);
+    add_tb(&blocks[2], 8, 4, 4090);
+    add_tb(&blocks[3], 8, 2, 4090);
+    transient_busy_index = 7;
+    check_collection("busy-on-spill", 8, 8, 0x1d4,
+                     "L8 T2 T4 T6 B7 U2 U4 U6 U8 "
+                     "L2 L4 L6 L7 L8 U2 U4 U6 U7 U8 ");
+
+    reset_fixture();
+    for (int i = 5; i > 0; i--) {
+        add_tb(&blocks[5 - i], 9, i, 4090);
+    }
+    transient_busy_index = 5;
+    check_collection("busy-after-spill", 9, 9, 0x23e,
+                     "L9 T1 T2 T3 T4 B5 U1 U2 U3 U4 U9 "
+                     "L1 L2 L3 L4 L5 L9 U1 U2 U3 U4 U5 U9 ");
+
+    check_precise_exit(false);
+    check_precise_exit(true);
+
+    for (unsigned int i = 0; i < MAX_PAGES; i++) {
+        assert(pthread_mutex_destroy(&fixture_pages[i].lock) == 0);
+    }
+    puts("page-collection: passed");
+    return 0;
+}
+"""
+
+
+def fixture_source(source_root, revision=None, negative=None):
+    """Extract native definitions and add explicit providers and assertions."""
+    def read_source(path):
+        if revision:
+            return subprocess.check_output(
+                ["git", "-C", str(source_root), "show", "--no-ext-diff",
+                 "--end-of-options", revision + ":" + path], text=True)
+        return (source_root / path).read_text()
+
+    maintenance = read_source("accel/tcg/tb-maint.c")
+    system_maintenance = maintenance[maintenance.index("struct PageDesc {"):]
+    inline = "#define PAGE_COLLECTION_INLINE_CAPACITY " in system_maintenance
+    configuration = ""
+    if inline:
+        capacity = next(line for line in system_maintenance.splitlines()
+                        if line.startswith("#define PAGE_COLLECTION_INLINE_CAPACITY "))
+        configuration = capacity + "\n#define FIXTURE_INLINE_COLLECTION 1\n"
+    crossing_count = "uint32_t crossing_tb_count;" in system_maintenance
+    if crossing_count:
+        configuration += "#define FIXTURE_CROSSING_COUNT 1\n"
+    header = read_source("include/exec/translation-block.h")
+    flags = "\n".join(line for line in header.splitlines()
+                      if line.startswith(("#define CF_COUNT_MASK ",
+                                          "#define CF_NOIRQ ")))
+    internal_header = read_source("accel/tcg/tb-internal.h")
+    prototype_start = internal_header.index("void tb_invalidate_phys_range_fast(")
+    prototype_end = internal_header.index(";", prototype_start) + 1
+    configuration += flags + "\n" + internal_header[prototype_start:prototype_end]
+    iterator_start = maintenance.index("#define TB_FOR_EACH_TAGGED(")
+    iterator_end = maintenance.index("\n\n", iterator_start)
+    declarations = "\n".join(
+        definition(maintenance, name) + ";" for name in (
+            "struct PageDesc {", "struct page_entry {",
+            "struct page_collection {"))
+    accessors = "\n".join(definition(header, name) for name in (
+        "static inline tb_page_addr_t tb_page_addr0(",
+        "static inline tb_page_addr_t tb_page_addr1("))
+    signatures = [
+        "static void page_lock(PageDesc *pd)",
+        "static bool page_trylock(PageDesc *pd)",
+        "static void page_unlock(PageDesc *pd)",
+        "static inline struct page_entry *\npage_entry_new(",
+        "static void page_entry_destroy(",
+        "static bool page_entry_trylock(",
+        "static void do_page_entry_lock(",
+        "static gboolean page_entry_lock(",
+        "static gboolean page_entry_unlock(",
+        "static gint tb_page_addr_cmp(",
+    ]
+    if inline:
+        signatures += [
+            "static struct page_entry *page_collection_lookup(",
+            "static void page_collection_spill(",
+            "static struct page_entry *page_collection_insert(",
+            "static void page_collection_foreach(",
+        ]
+    signatures += [
+        "static bool page_trylock_add(",
+        "static void page_collection_lock(" if inline else
+        "static struct page_collection *page_collection_lock(",
+        "static void page_collection_unlock(",
+    ]
+    if crossing_count:
+        signatures += ["static bool tb_spans_distinct_pages("]
+    signatures += [
+        "static void tb_page_add(",
+        "static void tb_record(TranslationBlock *tb)",
+        "static void tb_page_remove(",
+        "static void tb_remove(TranslationBlock *tb)",
+        "static void\ntb_invalidate_phys_page_range__locked(",
+        "void tb_invalidate_phys_range_fast(",
+    ]
+    bodies = [definition(system_maintenance, signature)
+              for signature in signatures]
+    mutations = {
+        "omit-other-page": ("page_collection_lock",
+                            "page_trylock_add(set, other_addr)", "false"),
+        "drop-spill-state": ("page_collection_spill",
+                             "*pe = set->inline_entries[i];",
+                             "*pe = set->inline_entries[i]; pe->locked = false;"),
+        "skip-inline-unlock": ("page_collection_unlock",
+                               "page_unlock(pe->pd);", "(void)pe;"),
+        "reverse-inline-iteration": (
+            "page_collection_foreach",
+            "for (unsigned int i = 0; i < set->inline_count; i++)",
+            "for (unsigned int i = set->inline_count; i-- > 0;)"),
+        "omit-empty-admission": (
+            "page_trylock_add",
+            "(!set->tree && !set->inline_count) || index > set->max_index",
+            "index > set->max_index"),
+        "eager-tree": (
+            "page_collection_lock", "set->tree = NULL;",
+            "set->tree = q_tree_new_full(tb_page_addr_cmp, NULL, NULL, "
+            "page_entry_destroy);"),
+    }
+    if negative:
+        name, before, after = mutations[negative]
+        target = next((i for i, signature in enumerate(signatures)
+                       if name + "(" in signature), None)
+        if target is None or before not in bodies[target]:
+            raise ValueError("Negative control requires its native source operation")
+        bodies[target] = bodies[target].replace(before, after, 1)
+
+    return "\n".join((
+        PRELUDE, configuration, declarations, accessors,
+        maintenance[iterator_start:iterator_end],
+        "#define PAGE_FOR_EACH_TB(start, last, pd, tb, n) "
+        "TB_FOR_EACH_TAGGED((pd)->first_tb, tb, n, page_next) "
+        "if (counted_membership_visit(pd))",
+        PROVIDERS, "\n".join(bodies), EXERCISE))
+
+
+def prepare_fixture(output_dir, source_root, revision=None, negative=None):
+    """Write a source fixture and its configured compiler command."""
+    output_dir.mkdir(parents=True, exist_ok=True)
+    source = output_dir / "page-collection.c"
+    executable = output_dir / "page-collection"
+    source.write_text(fixture_source(source_root, revision, negative))
+
+    command = shlex.split(os.environ.get("CC", "cc"))
+    command += shlex.split(os.environ.get("CFLAGS", ""))
+    # Configured release flags may disable assertions; these are test actions.
+    command += ["-UNDEBUG", "-std=gnu11", "-Wall", "-Werror", "-pthread",
+                "-I" + str(source_root / "include"),
+                str(source), "-o", str(executable)]
+    command += shlex.split(os.environ.get("LDFLAGS", ""))
+    (output_dir / "compile-command.json").write_text(
+        json.dumps(command, indent=2) + "\n")
+    return command, executable
+
+
+def run_fixture(command, executable):
+    """Compile and run a fixture while preserving its complete diagnostics."""
+    subprocess.run(command, check=True)
+    result = subprocess.run([str(executable)], capture_output=True, text=True,
+                            timeout=15)
+    (executable.parent / "stdout.txt").write_text(result.stdout)
+    (executable.parent / "stderr.txt").write_text(result.stderr)
+    if result.returncode:
+        print(result.stderr, end="", file=sys.stderr)
+    result.check_returncode()
+    return result
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--source-root", type=Path, default=ROOT)
+    parser.add_argument("--revision",
+                        help="Read native definitions from a Git revision")
+    baseline = parser.add_mutually_exclusive_group()
+    baseline.add_argument("--baseline-revision")
+    baseline.add_argument("--baseline-source-root", type=Path)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    parser.add_argument("--emit-only", action="store_true")
+    negative = parser.add_mutually_exclusive_group()
+    negative.add_argument("--omit-other-page", action="store_true")
+    negative.add_argument("--negative", choices=(
+        "omit-other-page", "drop-spill-state", "skip-inline-unlock",
+        "reverse-inline-iteration", "omit-empty-admission", "eager-tree"))
+    args = parser.parse_args()
+
+    mutation = "omit-other-page" if args.omit_other_page else args.negative
+    candidate = prepare_fixture(args.output_dir, args.source_root,
+                                args.revision, mutation)
+    reference = None
+    if args.baseline_revision or args.baseline_source_root:
+        reference = prepare_fixture(
+            args.output_dir / "baseline",
+            args.baseline_source_root or args.source_root,
+            args.baseline_revision)
+    if args.emit_only:
+        return
+
+    candidate_result = run_fixture(*candidate)
+    if reference:
+        baseline_result = run_fixture(*reference)
+        if candidate_result.stdout != baseline_result.stdout:
+            difference = "".join(difflib.unified_diff(
+                baseline_result.stdout.splitlines(keepends=True),
+                candidate_result.stdout.splitlines(keepends=True),
+                fromfile="baseline", tofile="candidate"))
+            (args.output_dir / "semantic-trace.diff").write_text(difference)
+            raise RuntimeError("Native baseline and candidate lock traces differ")
+    print(candidate_result.stdout, end="")
+    print(candidate_result.stderr, end="", file=sys.stderr)
+
+
+if __name__ == "__main__":
+    main()
