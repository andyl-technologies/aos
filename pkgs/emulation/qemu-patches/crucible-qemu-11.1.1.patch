+
+static unsigned timer_callbacks;
+static unsigned wakeup_requests;
+
+/* The final machine wakeup consumer is explicit diagnostic hardware. */
+void qemu_system_wakeup_request(WakeupReason reason, Error **errp)
+{
+    g_assert_cmpint(reason, ==, QEMU_WAKEUP_REASON_PMTIMER);
+    wakeup_requests++;
+}
+
+static void observe_sci(ACPIREGS *registers)
+{
+    timer_callbacks++;
+}
+
+static void test_actual_dispatch_edge(void)
+{
+    ACPIREGS registers = { 0 };
+    __int128 edge = ((__int128)UINT64_C(500) << 64) |
+                    UINT64_C(826214373714);
+
+    initialize_clock(true);
+    observed_ps = (__int128)INT64_MAX * 1000 + 357;
+    registers.tmr.timer = timer_new_ns(QEMU_CLOCK_VIRTUAL,
+                                      acpi_pm_tmr_timer, &registers);
+    registers.tmr.update_sci = observe_sci;
+    acpi_pm_tmr_calc_overflow_time(&registers);
+    acpi_pm_tmr_update(&registers, true);
+
+    observed_ps = edge - 1;
+    qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL);
+    g_assert_cmpuint(timer_callbacks, ==, 0);
+    g_assert_cmpuint(acpi_pm1_evt_get_sts(&registers) &
+                     ACPI_BITMASK_TIMER_STATUS, ==, 0);
+    observed_ps = edge;
+    qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL);
+    g_assert_cmpuint(timer_callbacks, ==, 1);
+    g_assert_cmpuint(wakeup_requests, ==, 1);
+    g_assert_cmpuint(acpi_pm1_evt_get_sts(&registers) &
+                     ACPI_BITMASK_TIMER_STATUS, !=, 0);
+    g_assert_false(timer_pending(registers.tmr.timer));
+    timer_free(registers.tmr.timer);
+}
+
+static void test_counter_full_horizon(void)
+{
+    /* Constants use independent unbounded integer division. */
+    static const struct {
+        uint64_t origin_hi, origin_lo;
+        uint64_t ticks_hi, ticks_lo;
+    } vectors[] = {
+        {
+            UINT64_C(9223372036854775808), UINT64_C(0),
+            UINT64_C(18446711058234293952), UINT64_C(12387548552878005349)
+        },
+        {
+            UINT64_C(9223372036854775807), UINT64_C(18446744073709551615),
+            UINT64_C(33015475257663), UINT64_C(6059195520831546266)
+        },
+        {
+            UINT64_C(72057594037927936), UINT64_C(357),
+            UINT64_C(257933400450), UINT64_C(9126594313785416391)
+        },
+    };
+
+    initialize_clock(true);
+    for (size_t i = 0; i < G_N_ELEMENTS(vectors); i++) {
+        __int128 ticks = acpi_pm_tmr_join_wide(vectors[i].ticks_hi,
+                                              vectors[i].ticks_lo);
+        ACPIREGS registers = { 0 };
+
+        observed_ps = acpi_pm_tmr_join_wide(vectors[i].origin_hi,
+                                            vectors[i].origin_lo);
+        g_assert_true(acpi_pm_tmr_raw_ticks() == ticks);
+        g_assert_cmpuint(acpi_pm_tmr_raw_clock(), ==, vectors[i].ticks_lo);
+        g_assert_cmpuint(acpi_pm_tmr_get(&registers), ==,
+                         vectors[i].ticks_lo & 0xffffff);
+    }
+}
+
+static void test_fractional_counter_edge(void)
+{
+    initialize_clock(true);
+    observed_ps = 279365;
+    g_assert_cmpuint(acpi_pm_tmr_raw_clock(), ==, 0);
+    observed_ps++;
+    g_assert_cmpuint(acpi_pm_tmr_raw_clock(), ==, 1);
+}
+
+static void test_ordinary_counter_edge(void)
+{
+    initialize_clock(false);
+    observed_ps = 279366;
+    g_assert_cmpuint(acpi_pm_tmr_raw_clock(), ==, 0);
+    observed_ps = 280000;
+    g_assert_cmpuint(acpi_pm_tmr_raw_clock(), ==, 1);
+}
+
+static void test_unrepresentable_overflow_save(void)
+{
+    ACPIPMTimer timer;
+    initialize_clock(true);
+    timer = create_timer();
+    timer.overflow_ticks = (__int128)((((__uint128_t)1 << 127) - 1) &
+                                      ~(__uint128_t)0x7fffff);
+    timer_mod_ps_wide(timer.timer, 77);
+
+    g_assert_cmpint(acpi_pm_tmr_pre_save(&timer), ==, -ERANGE);
+    g_assert_true(timer_pending(timer.timer));
+    g_assert_true(expiry_ps(timer.timer) == 77);
+    timer_free(timer.timer);
+}
+
+typedef enum InvalidStream {
+    INVALID_MODE,
+    INVALID_ACTIVE,
+    INVALID_INACTIVE_PAYLOAD,
+    INVALID_OVERFLOW,
+    INVALID_OVERFLOW_ALIGNMENT,
+    INVALID_MISSING,
+    INVALID_VERSION,
+    INVALID_DUPLICATE,
+    INVALID_TRUNCATED,
+} InvalidStream;
+
+static void reject_stream(InvalidStream mutation)
+{
+    ACPIPMTimer original;
+    ACPIPMTimer restored;
+    GByteArray *bytes;
+    const size_t section = 16;
+    const size_t version = section + 2 + strlen("acpi-pm-timer/wide");
+    const size_t payload = version + 4;
+
+    initialize_clock(true);
+    original = create_timer();
+    ACPIREGS producer = { 0 };
+
+    acpi_pm_tmr_calc_overflow_time(&producer);
+    original.overflow_ticks = producer.tmr.overflow_ticks;
+    timer_mod_ps_wide(original.timer, 357);
+    bytes = save_state(&original);
+    g_assert_cmpuint(bytes->data[section], ==, QEMU_VM_SUBSECTION);
+    g_assert_cmpuint(bytes->data[section + 1], ==,
+                     strlen("acpi-pm-timer/wide"));
+    g_assert_cmpuint(bytes->len, ==, payload + 34 + 1);
+
+    switch (mutation) {
+    case INVALID_MODE:
+        bytes->data[payload] = 0;
+        break;
+    case INVALID_ACTIVE:
+        bytes->data[payload + 1] = 2;
+        break;
+    case INVALID_INACTIVE_PAYLOAD:
+        bytes->data[payload + 1] = 0;
+        break;
+    case INVALID_OVERFLOW:
+        memset(bytes->data + payload + 2, 0xff, 16);
+        bytes->data[payload + 2] = 0x7f;
+        break;
+    case INVALID_OVERFLOW_ALIGNMENT:
+        bytes->data[payload + 17] |= 1;
+        break;
+    case INVALID_MISSING:
+        g_byte_array_set_size(bytes, section + 1);
+        bytes->data[section] = QEMU_VM_EOF;
+        break;
+    case INVALID_VERSION:
+        stl_be_p(bytes->data + version, 1);
+        break;
+    case INVALID_DUPLICATE: {
+        GByteArray *copy = g_byte_array_new();
+        g_byte_array_append(copy, bytes->data + section,
+                            bytes->len - section - 1);
+        g_byte_array_set_size(bytes, bytes->len - 1);
+        g_byte_array_append(bytes, copy->data, copy->len);
+        g_byte_array_append(bytes, (const uint8_t[]) { QEMU_VM_EOF }, 1);
+        g_byte_array_unref(copy);
+        break;
+    }
+    case INVALID_TRUNCATED:
+        g_byte_array_set_size(bytes, payload + 9);
+        break;
+    }
+    restored = create_timer();
+    restored.overflow_ticks = 123;
+    timer_mod_ps_wide(restored.timer, 77);
+
+    g_assert_cmpint(load_state(&restored, bytes), <, 0);
+    g_assert_true(restored.overflow_ticks == 123);
+    g_assert_true(timer_pending(restored.timer));
+    g_assert_true(expiry_ps(restored.timer) == 77);
+    timer_free(original.timer);
+    timer_free(restored.timer);
+    g_byte_array_unref(bytes);
+}
+
+static void test_invalid_mode(void)
+{
+    reject_stream(INVALID_MODE);
+}
+
+static void test_invalid_active(void)
+{
+    reject_stream(INVALID_ACTIVE);
+}
+
+static void test_invalid_inactive_payload(void)
+{
+    reject_stream(INVALID_INACTIVE_PAYLOAD);
+}
+
+static void test_invalid_overflow(void)
+{
+    reject_stream(INVALID_OVERFLOW);
+}
+
+static void test_invalid_overflow_alignment(void)
+{
+    reject_stream(INVALID_OVERFLOW_ALIGNMENT);
+}
+
+static void test_unaligned_overflow_save(void)
+{
+    ACPIPMTimer timer;
+
+    initialize_clock(true);
+    timer = create_timer();
+    timer.overflow_ticks = 0x800001;
+    timer.legacy_timer_ns = 77;
+    timer.wide_clock_mode = 9;
+    timer_mod_ps_wide(timer.timer, 357);
+
+    g_assert_cmpint(acpi_pm_tmr_pre_save(&timer), ==, -EINVAL);
+    g_assert_cmpint(timer.legacy_timer_ns, ==, 77);
+    g_assert_cmpint(timer.wide_clock_mode, ==, 9);
+    g_assert_true(expiry_ps(timer.timer) == 357);
+    timer_free(timer.timer);
+}
+
+static void test_missing_section(void)
+{
+    reject_stream(INVALID_MISSING);
+}
+
+static void test_old_version(void)
+{
+    reject_stream(INVALID_VERSION);
+}
+
+static void test_duplicate_section(void)
+{
+    reject_stream(INVALID_DUPLICATE);
+}
+
+static void test_truncated_section(void)
+{
+    reject_stream(INVALID_TRUNCATED);
+}
+
+typedef struct TimerCase {
+    const char *path;
+    void (*run)(void);
+} TimerCase;
+
+static void run_isolated_case(gconstpointer opaque)
+{
+    const TimerCase *test = opaque;
+
+    if (g_test_subprocess()) {
+        test->run();
+        if (qemu_timer_tcg_ps_enabled()) {
+            g_assert_cmpuint(nanosecond_reads, ==, 0);
+        }
+        return;
+    }
+    g_test_trap_subprocess(NULL, TIMER_STREAM_SUBPROCESS_TIMEOUT_US, 0);
+    g_test_trap_assert_passed();
+}
+
+int main(int argc, char **argv)
+{
+    static const TimerCase cases[] = {
+        { "/acpi-pm/wide-counter", test_wide_counter },
+        { "/acpi-pm/wide-deadline", test_wide_deadline },
+        { "/acpi-pm/wide-migration", test_wide_migration },
+        { "/acpi-pm/negative-expiry", test_negative_expiry },
+        { "/acpi-pm/inactive-migration", test_inactive_migration },
+        { "/acpi-pm/negative-epoch", test_negative_epoch },
+        { "/acpi-pm/ordinary-migration", test_ordinary_migration },
+        { "/acpi-pm/crossmode-fraction", test_crossmode_fraction },
+        { "/acpi-pm/crossmode-negative-expiry",
+          test_crossmode_negative_expiry },
+        { "/acpi-pm/crossmode-inactive", test_crossmode_inactive },
+        { "/acpi-pm/crossmode-wide-expiry", test_crossmode_wide_expiry },
+        { "/acpi-pm/crossmode-wide-ticks", test_crossmode_wide_ticks },
+        { "/acpi-pm/crossmode-rounding-overflow",
+          test_crossmode_rounding_overflow },
+        { "/acpi-pm/actual-dispatch-edge", test_actual_dispatch_edge },
+        { "/acpi-pm/counter-full-horizon", test_counter_full_horizon },
+        { "/acpi-pm/fractional-counter-edge", test_fractional_counter_edge },
+        { "/acpi-pm/ordinary-counter-edge", test_ordinary_counter_edge },
+        { "/acpi-pm/unrepresentable-overflow-save",
+          test_unrepresentable_overflow_save },
+        { "/acpi-pm/invalid-mode", test_invalid_mode },
+        { "/acpi-pm/invalid-active", test_invalid_active },
+        { "/acpi-pm/invalid-inactive-payload", test_invalid_inactive_payload },
+        { "/acpi-pm/invalid-overflow", test_invalid_overflow },
+        { "/acpi-pm/invalid-overflow-alignment",
+          test_invalid_overflow_alignment },
+        { "/acpi-pm/unaligned-overflow-save", test_unaligned_overflow_save },
+        { "/acpi-pm/missing-section", test_missing_section },
+        { "/acpi-pm/old-version", test_old_version },
+        { "/acpi-pm/duplicate-section", test_duplicate_section },
+        { "/acpi-pm/truncated-section", test_truncated_section },
+    };
+
+    int result;
+
+    if (argc > 1 && strcmp(argv[1], "--acpi-pm-exact-producer") == 0) {
+        if (argc != 3 || argv[2][0] < '0' || argv[2][0] > '5' ||
+            argv[2][1] != '\0') {
+            return EXIT_FAILURE;
+        }
+        return produce_exact_stream(argv[2][0] - '0');
+    }
+    fixture_executable = realpath(argv[0], NULL);
+    g_assert_nonnull(fixture_executable);
+    g_test_init(&argc, &argv, NULL);
+    for (size_t i = 0; i < G_N_ELEMENTS(cases); i++) {
+        g_test_add_data_func(cases[i].path, &cases[i], run_isolated_case);
+    }
+    result = g_test_run();
+    free(fixture_executable);
+    return result;
+}
diff --git a/tests/unit/test-crucible-action-edge-post.py b/tests/unit/test-crucible-action-edge-post.py
