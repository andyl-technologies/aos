+    g_assert_cmpint(pipe(descriptors), ==, 0);
+    g_assert_cmpint(fcntl(descriptors[0], F_SETFL, O_NONBLOCK), ==, 0);
+    g_assert_cmpint(write(descriptors[1], &byte, sizeof(byte)), ==, 1);
+    qemu_plugin_wake_fd_read((void *)(intptr_t)descriptors[0]);
+    close(descriptors[0]);
+    close(descriptors[1]);
+}
