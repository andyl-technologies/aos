+int x86_crucible_register_qom_child(CPUState *cs, Object **out)
+{
+    X86CPU *cpu;
+    APICCommonState *apic;
+
+    if (!cs || !out || !bql_locked()) {
+        return -EINVAL;
+    }
+    cpu = X86_CPU(cs);
