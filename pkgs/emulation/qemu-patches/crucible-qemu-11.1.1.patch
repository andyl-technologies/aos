+int qemu_plugin_crucible_capture_fingerprint_v4(
+    struct qemu_plugin_crucible_fingerprint_v2 *out,
+    QemuCrucibleFingerprintMaterialRef *material)
+{
+    QIOChannelFile *device_channel = NULL;
+    QEMUFile *file = NULL;
+    Error *local_err = NULL;
+    const char device_domain[] = "crucible.qemu.device-projection.v2";
+    uint64_t device_material_length = 0;
+    uint64_t device_projection_offset = 0;
+    uint64_t projected_sections = 0;
+    uint64_t device_schema_sections = 0;
+    const char *failure_stage = "validate capture authority";
+    int device_fd_flags;
+    int device_fd_seals;
+    int device_writer_fd = -1;
+    int close_status;
+    int status = 0;
+    uintptr_t out_address = (uintptr_t)out;
+    uintptr_t material_address = (uintptr_t)material;
+
+    if (!out || !material) {
+        return -EINVAL;
+    }
+    if (sizeof(*out) > UINTPTR_MAX - out_address ||
+        sizeof(*material) > UINTPTR_MAX - material_address ||
+        (out_address < material_address + sizeof(*material) &&
+         material_address < out_address + sizeof(*out))) {
+        return -EINVAL;
+    }
+    status = qemu_crucible_fingerprint_capture_outputs_check_v1(
+        out, sizeof(*out), material, sizeof(*material));
+    if (status) {
