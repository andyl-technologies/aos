+static void park_vector(uint8_t wire[896])
+{
+    uint8_t publication[1536];
+
+    publication_vector(publication);
+    memcpy(wire, publication + 128, 896);
+    memcpy(wire, "CRUCPRK1", 8);
+    stl_be_p(wire + 8, 1);
+    stq_be_p(wire + 96, 7);
+    stl_be_p(wire + 120, 0x30302);
+    stl_be_p(wire + 124, 2);
+    for (unsigned i = 0; i < 2; i++) {
+        uint8_t *row = wire + 128 + i * 192;
+
+        row_vector(row, false);
+        stq_be_p(row + 32, 0);
+        stq_be_p(row + 40, 5 + i);
+        stl_be_p(row + 48, 6);
+    }
+}
+
+static void assert_park_refusal(const uint8_t wire[896])
+{
+    QemuCrucibleBoundaryParkRecord record;
+    QemuCrucibleBoundaryParkRecord saved;
+    int status;
+
+    memset(&record, 0xa5, sizeof(record));
+    memcpy(&saved, &record, sizeof(saved));
+    status = qemu_crucible_boundary_park_decode_v1(wire, 896, &record);
+    g_assert_cmpint(status, ==, -EPROTO);
+    g_assert_cmpmem(&record, sizeof(record), &saved, sizeof(saved));
+}
+
+static void test_park_pair(void)
+{
+    uint8_t wire[896];
+    QemuCrucibleBoundaryParkRecord record;
+    static const uint64_t correlations[] = { 1, UINT64_MAX - 1 };
+    static const uint64_t bad_correlations[] = { 0, UINT64_MAX };
+
+    for (size_t i = 0; i < G_N_ELEMENTS(correlations); i++) {
+        park_vector(wire);
+        stq_be_p(wire + 96, correlations[i]);
+        g_assert_cmpint(qemu_crucible_boundary_park_decode_v1(
+            wire, sizeof(wire), &record), ==, 0);
+        g_assert_cmpuint(record.binding.request_correlation, ==, correlations[i]);
+        g_assert_cmpuint(record.rows[0].budget_owner, ==, 0);
+        g_assert_cmpuint(record.rows[1].budget_owner, ==, 0);
+    }
+    for (size_t i = 0; i < G_N_ELEMENTS(bad_correlations); i++) {
+        park_vector(wire);
+        stq_be_p(wire + 96, bad_correlations[i]);
+        assert_park_refusal(wire);
+    }
+    for (unsigned primary = 0; primary < 2; primary++) {
+        for (unsigned producing_class = 0; producing_class < 14; producing_class++) {
+            if (producing_class == 6) {
+                continue;
+            }
+            park_vector(wire);
+            stl_be_p(wire + 128 + primary * 192 + 48, producing_class);
+            assert_park_refusal(wire);
+        }
+    }
+
+    /* Each component can distinguish real identity bytes; no equality or
+     * inequality can supply the corresponding physical Original custody. */
+    park_vector(wire);
+    stq_be_p(wire + 320 + 40, 5);
+    assert_park_refusal(wire);
+    stl_be_p(wire + 120, UINT32_C(0x80030302));
+    assert_park_refusal(wire);
+    wire[320] ^= 1;
+    g_assert_cmpint(qemu_crucible_boundary_park_decode_v1(
+        wire, sizeof(wire), &record), ==, 0);
+    wire[320] ^= 1;
+    stq_be_p(wire + 320 + 32, UINT64_MAX);
+    g_assert_cmpint(qemu_crucible_boundary_park_decode_v1(
+        wire, sizeof(wire), &record), ==, 0);
+    park_vector(wire);
+    g_assert_cmpint(qemu_crucible_boundary_park_decode_v1(
+        wire, sizeof(wire), &record), ==, 0);
+
+    for (unsigned projected = 0; projected < 3; projected++) {
+        park_vector(wire);
+        stl_be_p(wire + 120, UINT32_C(0x80000302) | (projected << 16));
+        for (unsigned i = 0; i < 2; i++) {
+            if (!(projected & (1U << i))) {
+                memset(wire + 128 + i * 192, 0, 192);
+            }
+        }
+        g_assert_cmpint(qemu_crucible_boundary_park_decode_v1(
+            wire, sizeof(wire), &record), ==, 0);
+        g_assert_true(record.dirty);
+        g_assert_cmpuint(record.born_mask, ==, 3);
+        g_assert_cmpuint(record.projected_mask, ==, projected);
+    }
+}
