+int main(int argc, char **argv)
+{
+    static const char *refusals[] = {
+        "legacy", "length", "short", "no-scm", "truncated-control",
+        "process", "binding", "flags", "unknown-flags", "schema",
+        "present-account", "present-generation", "type", "empty", "eof",
+    };
+
+    fixture_executable = argv[0];
+    if (argc == 2 && !strcmp(argv[1], "--layout")) {
+        fixture_layout();
+        return 0;
+    }
+    if (argc == 2 && !strcmp(argv[1], "--preexec-probe")) {
+        puts("MAIN");
+        return 0;
+    }
+    /* Direct probes run in a separate executable process, outside GLib's
+     * subprocess assertion-to-exit conversion, so causal failures are SIGABRT.
+     * They call the same test bodies as the ordinary registered suite. */
+    if (argc == 3 && !strcmp(argv[1], "--causal-probe")) {
+        fixture_direct_probe = true;
+        if (!strcmp(argv[2], "/preexec/five")) {
+            test_receipt(GINT_TO_POINTER(0));
+        } else if (!strcmp(argv[2], "/preexec/six")) {
+            test_receipt(GINT_TO_POINTER(1));
+        } else if (!strcmp(argv[2], "/preexec/publisher-offer")) {
+            test_publisher_offer();
+        } else if (!strcmp(argv[2], "/preexec/publisher-observation")) {
+            test_publisher_observation();
+        } else if (!strcmp(argv[2], "/preexec/publisher-module-facts")) {
+            test_publisher_module_facts();
+        } else if (!strcmp(argv[2], "/preexec/publisher-storage")) {
+            test_publisher_storage();
+        } else if (!strcmp(argv[2], "/preexec/publisher-physical")) {
+            test_publisher_physical();
+        } else if (!strcmp(argv[2], "/preexec/publisher-lender-refusal")) {
+            test_publisher_lender_refusal();
+        } else if (!strcmp(argv[2], "/preexec/publisher-receiver-debts")) {
+            test_publisher_receiver_debts();
+        } else if (!strcmp(argv[2], "/preexec/publisher-nine")) {
+            test_publisher_receipt(GINT_TO_POINTER(1));
+        } else if (!strcmp(argv[2], "/preexec/publisher-eight")) {
+            test_publisher_receipt(GINT_TO_POINTER(0));
+        } else if (!strcmp(argv[2], "/preexec/entry-selected")) {
+            test_entry(GINT_TO_POINTER(1));
+#ifdef PREEXEC_TEST_RECV_EINTR
+        } else if (!strcmp(argv[2], "/preexec/injected-eintr")) {
+            test_injected_eintr();
+#endif
+        } else {
+            fprintf(stderr, "unknown causal probe: %s\n", argv[2]);
+            return 2;
+        }
+        return 0;
+    }
+
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/preexec/empty-ancillary", test_empty_ancillary);
+    g_test_add_func("/preexec/selection", test_selection);
+    g_test_add_func("/preexec/nonissuing-dependencies", test_nonissuing_dependencies);
+    g_test_add_func("/preexec/publisher-offer", test_publisher_offer);
+    g_test_add_func("/preexec/publisher-observation", test_publisher_observation);
+    g_test_add_func("/preexec/publisher-module-facts", test_publisher_module_facts);
+    g_test_add_func("/preexec/publisher-storage", test_publisher_storage);
+    g_test_add_func("/preexec/publisher-physical", test_publisher_physical);
+    g_test_add_func("/preexec/publisher-lender-refusal", test_publisher_lender_refusal);
+    g_test_add_func("/preexec/publisher-receiver-debts", test_publisher_receiver_debts);
+    g_test_add_data_func("/preexec/publisher-eight", GINT_TO_POINTER(0), test_publisher_receipt);
+    g_test_add_data_func("/preexec/publisher-nine", GINT_TO_POINTER(1), test_publisher_receipt);
+    g_test_add_data_func("/preexec/refuse/nofile-unequal", GINT_TO_POINTER(1),
+                         test_descriptor_limit);
+    g_test_add_data_func("/preexec/refuse/nofile-low", GINT_TO_POINTER(0),
+                         test_descriptor_limit);
+    g_test_add_data_func("/preexec/five", GINT_TO_POINTER(0), test_receipt);
+    g_test_add_data_func("/preexec/six", GINT_TO_POINTER(1), test_receipt);
+    for (size_t index = 0; index < G_N_ELEMENTS(refusals); index++) {
+        char *path = g_strdup_printf("/preexec/refuse/%s", refusals[index]);
+
+        g_test_add_data_func(path, refusals[index], test_refusal);
+        g_free(path);
+    }
+    g_test_add_func("/preexec/foreign", test_foreign);
+    g_test_add_data_func("/preexec/entry-selected", GINT_TO_POINTER(1), test_entry);
+    g_test_add_data_func("/preexec/entry-ordinary", GINT_TO_POINTER(0), test_entry);
+#ifdef PREEXEC_TEST_RECV_EINTR
+    g_test_add_func("/preexec/injected-eintr", test_injected_eintr);
+#endif
+    return g_test_run();
+}
