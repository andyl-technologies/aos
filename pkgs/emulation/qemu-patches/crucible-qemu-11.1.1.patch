+typedef enum IdleWaitMutation {
+    IDLE_WAIT_MUTATION_NONE,
+    IDLE_WAIT_MUTATION_WORD_CHANGE_BEFORE_SYSCALL,
+    IDLE_WAIT_MUTATION_STOP_BEFORE_PARK,
+    IDLE_WAIT_MUTATION_UNPLUG_BEFORE_PARK,
+    IDLE_WAIT_MUTATION_CPU_LIST_INVALIDATION,
+    IDLE_WAIT_MUTATION_UNPLUG_INVALIDATION,
+} IdleWaitMutation;
+
+typedef struct IdleWaitFixture {
+    uint32_t *expected_address;
+    uint32_t expected_value;
+    int wait_result;
+    int wait_errno;
+    IdleWaitMutation mutation;
+    unsigned int sequence;
+    unsigned int pin_order;
+    unsigned int arm_order;
+    unsigned int unlock_order;
+    unsigned int wait_order;
+    unsigned int lock_order;
+    unsigned int disarm_order;
+    unsigned int validate_order;
+    unsigned int unpin_order;
+    unsigned int wait_calls;
+    bool cpu_list_changed;
+    bool unplugged;
+    bool stop_pending;
+} IdleWaitFixture;
+
+static void fixture_pin_cpu(void *opaque)
+{
+    IdleWaitFixture *fixture = opaque;
+
+    fixture->pin_order = ++fixture->sequence;
+}
+
+static bool fixture_arm_wait(void *opaque, uint32_t *wake_signal,
+                             uint32_t expected)
+{
+    IdleWaitFixture *fixture = opaque;
+
+    g_assert_true(wake_signal == fixture->expected_address);
+    g_assert_cmpuint(expected, ==, fixture->expected_value);
+    fixture->arm_order = ++fixture->sequence;
+    fixture->stop_pending =
+        fixture->mutation == IDLE_WAIT_MUTATION_STOP_BEFORE_PARK;
+    fixture->unplugged =
+        fixture->mutation == IDLE_WAIT_MUTATION_UNPLUG_BEFORE_PARK;
+    if (fixture->stop_pending || fixture->unplugged) {
+        fixture->disarm_order = ++fixture->sequence;
+        return false;
+    }
+    return true;
+}
+
+static void fixture_unpin_cpu(void *opaque)
+{
+    IdleWaitFixture *fixture = opaque;
+
+    fixture->unpin_order = ++fixture->sequence;
+}
+
+static void fixture_unlock_bql(void *opaque)
+{
+    IdleWaitFixture *fixture = opaque;
+
+    fixture->unlock_order = ++fixture->sequence;
+}
+
+static void fixture_lock_bql(void *opaque)
+{
+    IdleWaitFixture *fixture = opaque;
+
+    fixture->lock_order = ++fixture->sequence;
+}
+
+static int fixture_wait(void *opaque, uint32_t *wake_signal,
+                        uint32_t expected, int *wait_errno)
+{
+    IdleWaitFixture *fixture = opaque;
+
+    g_assert_true(wake_signal == fixture->expected_address);
+    g_assert_cmpuint(expected, ==, fixture->expected_value);
+    fixture->wait_order = ++fixture->sequence;
+    fixture->wait_calls++;
+    if (fixture->mutation == IDLE_WAIT_MUTATION_WORD_CHANGE_BEFORE_SYSCALL) {
+        (*wake_signal)++;
+        *wait_errno = EAGAIN;
+        return -1;
+    }
+    /* Inject postwait validation outcomes without QEMU-global CPU mutation. */
+    fixture->cpu_list_changed =
+        fixture->mutation == IDLE_WAIT_MUTATION_CPU_LIST_INVALIDATION;
+    fixture->unplugged =
+        fixture->mutation == IDLE_WAIT_MUTATION_UNPLUG_INVALIDATION;
+    *wait_errno = fixture->wait_errno;
+    return fixture->wait_result;
+}
+
+static void fixture_disarm_wait(void *opaque)
+{
+    IdleWaitFixture *fixture = opaque;
+
+    fixture->disarm_order = ++fixture->sequence;
+}
+
+static bool fixture_validate_cpu(void *opaque)
+{
+    IdleWaitFixture *fixture = opaque;
+
+    fixture->validate_order = ++fixture->sequence;
+    return !fixture->cpu_list_changed && !fixture->unplugged;
+}
+
+static const QemuPluginCrucibleIdleWaitOps fixture_ops = {
+    .pin_cpu = fixture_pin_cpu,
+    .unpin_cpu = fixture_unpin_cpu,
+    .arm_wait = fixture_arm_wait,
+    .unlock_bql = fixture_unlock_bql,
+    .lock_bql = fixture_lock_bql,
+    .wait = fixture_wait,
+    .disarm_wait = fixture_disarm_wait,
+    .cpu_valid_after_wait = fixture_validate_cpu,
+};
+
+static enum qemu_plugin_crucible_idle_wait_status
+run_wait(IdleWaitFixture *fixture, bool *wait_issued, bool *rescan_required,
+         int *result_errno)
+{
+    return qemu_plugin_crucible_idle_wait_once(
+        wait_issued, true, true, fixture->expected_address,
+        fixture->expected_value, &fixture_ops, fixture, rescan_required,
+        result_errno);
+}
+
+static void assert_single_ordered_wait(const IdleWaitFixture *fixture)
+{
+    g_assert_cmpuint(fixture->wait_calls, ==, 1);
+    g_assert_cmpuint(fixture->pin_order, <, fixture->arm_order);
+    g_assert_cmpuint(fixture->arm_order, <, fixture->unlock_order);
+    g_assert_cmpuint(fixture->unlock_order, <, fixture->wait_order);
+    g_assert_cmpuint(fixture->wait_order, <, fixture->lock_order);
+    g_assert_cmpuint(fixture->lock_order, <, fixture->disarm_order);
+    g_assert_cmpuint(fixture->disarm_order, <, fixture->validate_order);
+    g_assert_cmpuint(fixture->validate_order, <, fixture->unpin_order);
+}
+
+static void assert_prepark_mutation_rejects_wait(IdleWaitMutation mutation)
+{
+    uint32_t wake_signal = 47;
+    IdleWaitFixture fixture = {
+        .expected_address = &wake_signal,
+        .expected_value = wake_signal,
+        .mutation = mutation,
+    };
+    bool wait_issued = false;
+    bool rescan_required = false;
+    int result_errno = 0;
+
+    g_assert_cmpint(run_wait(&fixture, &wait_issued, &rescan_required,
+                             &result_errno),
+                    ==, QEMU_PLUGIN_CRUCIBLE_IDLE_WAIT_QEMU_WORK_PENDING);
+    g_assert_true(wait_issued);
+    g_assert_true(rescan_required);
+    g_assert_cmpint(result_errno, ==, EAGAIN);
+    g_assert_cmpuint(fixture.wait_calls, ==, 0);
+    g_assert_cmpuint(fixture.pin_order, <, fixture.arm_order);
+    g_assert_cmpuint(fixture.arm_order, <, fixture.disarm_order);
+    g_assert_cmpuint(fixture.disarm_order, <, fixture.unpin_order);
+    g_assert_cmpuint(fixture.unlock_order, ==, 0);
+    g_assert_cmpuint(fixture.lock_order, ==, 0);
+    g_assert_cmpuint(fixture.validate_order, ==, 0);
+}
+
+static void test_stop_before_park_requires_rescan(void)
+{
+    assert_prepark_mutation_rejects_wait(IDLE_WAIT_MUTATION_STOP_BEFORE_PARK);
+}
+
+static void test_unplug_before_park_requires_rescan(void)
+{
+    assert_prepark_mutation_rejects_wait(
+        IDLE_WAIT_MUTATION_UNPLUG_BEFORE_PARK);
+}
