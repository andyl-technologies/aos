+} QemuCrucibleFaultVmstateSection;
+
+typedef struct QemuCrucibleFaultVmstateReader {
+    const uint8_t *data;
+    size_t length;
+    size_t offset;
+} QemuCrucibleFaultVmstateReader;
+
+#define QEMU_CRUCIBLE_DEFERRED_SERVICE_EVIDENCE_SIZE 576
+
+typedef struct QemuCrucibleDeferredMemoryService {
+    uint64_t grant_tick;
+    uint64_t ready_tick;
+    uint64_t observed_icount;
+    uint8_t opportunity_hash[32];
+    uint8_t before_hash[32];
+    uint8_t after_hash[32];
+    uint8_t evidence[QEMU_CRUCIBLE_DEFERRED_SERVICE_EVIDENCE_SIZE];
