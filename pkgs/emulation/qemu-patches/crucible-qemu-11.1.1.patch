+++ b/scripts/extract-crucible-preexec-purpose.py
@@ -0,0 +1,111 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Bind literal pure record bodies for the executable's raw preinit owner."""
+
+import argparse
+import hashlib
+import importlib.util
+from pathlib import Path
+
+SOURCE_HASHES = {
+    'system/crucible-preexec-publisher-session.inc.h':
+        'f3c4ff001c47ddbc3fe5a783abb9983810b73f2977cb7480bbfbc75dfa11b5d0',
+    'include/qemu/crucible-publisher-protocol.h':
+        'dbed1450f136ef41da3fad48ead6e26a77e4a76c5f9e4a72a993a7ff7c239c06',
+    'system/crucible-preexec-publisher-storage.inc.h':
+        '415b121f09df8ca646cf60376af8870f3f302cfd5675bd22483ab00f3653658b',
+    'system/crucible-preexec-setup.c':
+        '956a4c60a76479878751932ad7b9f425f7ca5202a12cf3f54e1bd73426cfec57',
+    'system/crucible-preexec-workspace.inc.h':
+        '018c18016aaa62fcd25878ac8810726c02e8bb8e24e9e46d3eea42bf8b7cce75',
+    'plugins/crucible-process-purpose.c':
+        '71bfd2c2b7817d1bf6563e18eb679a07ac3a5d63149b81a9ccfdc8905ef6f8d1',
+    'include/qemu/crucible-process-purpose.h':
+        '35bf5eec7adff29428b200772aeb37e02f58c66d74810e5bbdc5f36a093c8674',
+    'plugins/crucible-device-workspace.c':
+        '3dd77a2ad8d4688fb57ccc94618763485d36b9460e3461ac5ff4bc6fa25c558d',
+    'include/qemu/crucible-device-workspace.h':
+        '5710b0cc44f68508cecd4186cca2e10c6aa32eceed1b81f2250ca9faf9028a4b',
+    'include/plugins/qemu-plugin.h':
+        'f2d6ec5ece0913176036fe101b0be4ac027f11234291aced314da0cf1caf46f8',
+    'tests/unit/extract-crucible-startup-source-controls.py':
+        'f658061c35d98fc7acebc07a34f9369fbee97758df929a6745293c7f5aabe91f',
+    'system/crucible-preexec-publisher-recipient.inc.h':
+        '950f7a14aca04211755bb8dca985efc147c90a3f78aab06d02ea3819551cb809',
+}
+
+PURPOSE_FUNCTIONS = (
+    "static bool purpose_nonzero(",
+    "static int boundary_publication_rows_decode(",
+    "int qemu_crucible_boundary_action_decode_v2(",
+    "int qemu_crucible_boundary_park_decode_v1(",
+    "static bool purpose_add(",
+    "static int standing_optional_ns(",
+    "int qemu_crucible_standing_record_decode_v4(",
+    "int qemu_crucible_process_control_layout_decode_v1(",
+    "int qemu_crucible_process_purpose_decode_v8(",
+    "int qemu_crucible_process_workspace_purpose_decode_v2(",
+    "int qemu_crucible_publisher_purpose_decode_v1(",
+    "static int purpose_plan_header(",
+    "static int publisher_decode_buffers(",
+    "static bool publisher_generation(",
+    "int qemu_crucible_publisher_header_decode_v1(",
+    "static bool publisher_sequence(",
+    "static int publisher_command_decode(",
+    "int qemu_crucible_publisher_publication_decode_v1(",
+    "int qemu_crucible_publisher_return_decode_v1(",
+    "int qemu_crucible_publisher_terminal_decode_v1(",
+)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("root", type=Path)
+    parser.add_argument("output", type=Path)
+    args = parser.parse_args()
+    for name, expected in SOURCE_HASHES.items():
+        if hashlib.sha256((args.root / name).read_bytes()).hexdigest() != expected:
+            raise ValueError(f"source changed: {name}")
+
+    helper = args.root / "tests/unit/extract-crucible-startup-source-controls.py"
+    spec = importlib.util.spec_from_file_location("literal_preexec_source", helper)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    source = (args.root / "plugins/crucible-process-purpose.c").read_text()
+    bodies = [module.function(source, opening) for opening in PURPOSE_FUNCTIONS]
+    source = (args.root / "plugins/crucible-device-workspace.c").read_text()
+    bodies.append(module.function(source, "int qemu_crucible_original_startup_decode("))
+    # Bodies are literal. Only linkage and names differ in this executable TU;
+    # explicit local byte providers replace libc/bswap calls before constructors.
+    names = (
+        "purpose_nonzero", "purpose_add", "purpose_plan_header",
+        "boundary_publication_rows_decode",
+        "qemu_crucible_boundary_action_decode_v2",
+        "qemu_crucible_boundary_park_decode_v1",
+        "standing_optional_ns", "qemu_crucible_standing_record_decode_v4",
+        "qemu_crucible_process_control_layout_decode_v1",
+        "qemu_crucible_process_purpose_decode_v8",
+        "qemu_crucible_process_workspace_purpose_decode_v2",
+        "qemu_crucible_original_startup_decode",
+        "qemu_crucible_publisher_purpose_decode_v1",
+        "publisher_decode_buffers", "publisher_generation",
+        "qemu_crucible_publisher_header_decode_v1",
+        "publisher_sequence", "publisher_command_decode",
+        "qemu_crucible_publisher_publication_decode_v1",
+        "qemu_crucible_publisher_return_decode_v1",
+        "qemu_crucible_publisher_terminal_decode_v1",
+    )
+    output = ["/* SPDX-License-Identifier: GPL-2.0-or-later */\n"]
+    output.extend(f"#define {name} preexec_literal_{name}\n" for name in names)
+    output.extend(("#define memcmp preexec_setup_compare\n",
+                   "#define memcpy preexec_setup_copy\n",
+                   "#define ldl_be_p preexec_setup_be32\n",
+                   "#define ldq_be_p preexec_setup_be64\n"))
+    output.extend(body if body.startswith("static ") else "static " + body
+                  for body in bodies)
+    output.extend(f"#undef {name}\n" for name in (*names, "memcmp", "memcpy",
+                                                "ldl_be_p", "ldq_be_p"))
+    args.output.write_text("\n".join(output))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/scripts/gen-crucible-shared-region-layout.py b/scripts/gen-crucible-shared-region-layout.py
new file mode 100644
index 0000000000000000000000000000000000000000..c0b8978edfd06ed1c25f5284b58935d0ad872e87
--- /dev/null
+++ b/scripts/gen-crucible-shared-region-layout.py
@@ -0,0 +1,211 @@
+# SPDX-License-Identifier: MIT
+"""Generate private Native layout equations against the public wire contract."""
+
+import argparse
+import hashlib
+import re
+from pathlib import Path
+
+# Public generated header at aos commit 1bcc1aa291e2040d4041ef488e398c0b20b52fe8.
+CONTRACT_SHA256 = '1abf79bdef8f1feef9ceac06cb7dc6b7899cba84b93bc68e3e36123f26850f88'
+
+
+def wire_contract(data):
+    """Bind owning layout equations to the exact public generated header."""
+    constants = {name: int(value) for name, value in re.findall(
+        r'^#define (CRUCIBLE_\w+) ([0-9]+)[uU]?$',
+        data.decode('ascii'), re.MULTILINE)}
+    operations = []
+
+    def emit(result, operation, *inputs):
+        operations.append(dict(result=result, operation=operation,
+                               inputs=list(inputs)))
+
+    def wire(name):
+        return constants['CRUCIBLE_SHMEM_' + name]
+
+    emit('node_slots_offset', 'literal', wire('REGION_HEADER_SIZE'))
+    emit('node_slots_extent', 'multiply', wire('MAX_NODES'), wire('NODE_SLOT_SIZE'))
+    emit('frame_ring_headers_offset', 'add', 'node_slots_offset', 'node_slots_extent')
+    emit('frame_ring_count', 'multiply', 'vm_count', 6)
+    emit('frame_ring_headers_extent', 'multiply', 'frame_ring_count', wire('RING_HEADER_SIZE'))
+    emit('frame_ring_data_offset', 'add', 'frame_ring_headers_offset', 'frame_ring_headers_extent')
+    emit('frame_entries_count', 'multiply', 'frame_ring_count', 'frame_queue_capacity')
+    emit('frame_entries_extent', 'multiply', 'frame_entries_count', wire('FRAME_ENTRY_SIZE'))
+    emit('frame_data_end', 'add', 'frame_ring_data_offset', 'frame_entries_extent')
+
+    def ring(prefix, previous, count, capacity, stride):
+        emit(prefix + '_headers_offset', 'align_up', previous, wire('RING_HEADER_ALIGN'))
+        emit(prefix + '_ring_count', 'multiply', 'vm_count', count)
+        emit(prefix + '_headers_extent', 'multiply', prefix + '_ring_count',
+             wire('RING_HEADER_SIZE'))
+        emit(prefix + '_data_offset', 'add', prefix + '_headers_offset',
+             prefix + '_headers_extent')
+        emit(prefix + '_entry_count', 'multiply', prefix + '_ring_count', capacity)
+        emit(prefix + '_data_extent', 'multiply', prefix + '_entry_count', stride)
+        emit(prefix + '_end', 'add', prefix + '_data_offset', prefix + '_data_extent')
+        return prefix + '_end'
+
+    end = ring('coverage', 'frame_data_end', 1,
+               wire('COVERAGE_QUEUE_CAPACITY'), wire('COVERAGE_ENTRY_SIZE'))
+    emit('fingerprint_samples_offset', 'align_up', end, wire('FINGERPRINT_SAMPLE_SLOT_ALIGN'))
+    emit('fingerprint_samples_extent', 'multiply', 'vm_count',
+         wire('FINGERPRINT_SAMPLE_SLOT_SIZE'))
+    emit('fingerprint_samples_end', 'add', 'fingerprint_samples_offset',
+         'fingerprint_samples_extent')
+    end = ring('markers', 'fingerprint_samples_end', 1,
+               wire('WHITEBOX_MARKER_QUEUE_CAPACITY'), wire('WHITEBOX_MARKER_ENTRY_SIZE'))
+    for kind, stride, capacity in [
+            ('commands', 'COMMAND_SLOT_V1_BYTES', 'DEFAULT_COMMAND_CAPACITY'),
+            ('results', 'RESULT_SLOT_V2_BYTES', 'DEFAULT_COMMAND_CAPACITY'),
+            ('events', 'EVENT_SLOT_V1_BYTES', 'EVENT_CAPACITY')]:
+        prefix = 'fault_' + kind
+        end = ring(prefix, end, 1,
+                   constants['CRUCIBLE_FAULT_' + capacity],
+                   constants['CRUCIBLE_FAULT_' + stride])
+        emit(prefix + '_arena_headers_offset', 'align_up', end, wire('RING_HEADER_ALIGN'))
+        emit(prefix + '_arena_headers_extent', 'multiply', 'vm_count',
+             constants['CRUCIBLE_FAULT_PAYLOAD_ARENA_HEADER_BYTES'])
+        emit(prefix + '_arenas_offset', 'add', prefix + '_arena_headers_offset',
+             prefix + '_arena_headers_extent')
+        emit(prefix + '_arenas_extent', 'multiply', 'vm_count', 'fault_payload_arena_bytes')
+        end = prefix + '_arenas_end'
+        emit(end, 'add', prefix + '_arenas_offset', prefix + '_arenas_extent')
+    end = ring('guest_introspection', end, wire('GUEST_INTROSPECTION_RINGS_PER_VM'),
+               wire('GUEST_INTROSPECTION_QUEUE_CAPACITY'), wire('GUEST_INTROSPECTION_ENTRY_SIZE'))
+    end = ring('accelerator', end, wire('ACCELERATOR_RINGS_PER_VM'),
+               wire('ACCELERATOR_QUEUE_CAPACITY'), wire('ACCELERATOR_ENTRY_SIZE'))
+    end = ring('selectable_replies', end, 1,
+               wire('SELECTABLE_REPLY_QUEUE_CAPACITY'), wire('GUEST_INTROSPECTION_ENTRY_SIZE'))
+    emit('region_extent', 'identity', end)
+    return dict(constants=constants, layout=dict(
+        operations=operations, parameters=['vm_count', 'frame_queue_capacity',
+                                           'fault_payload_arena_bytes']))
+
+
+def declarations(contract):
+    lines = [
+        '/* SPDX-License-Identifier: MIT */',
+        '/* Native checked layout facts; no ownership is issued by these offsets. */',
+        '#ifndef QEMU_CRUCIBLE_SHARED_REGION_LAYOUT_H',
+        '#define QEMU_CRUCIBLE_SHARED_REGION_LAYOUT_H',
+        '',
+        '#include <stdint.h>',
+        '#include <errno.h>',
+        '#include "aos/crucible/crucible_shmem_abi.h"',
+        '',
+    ]
+    # Consume the separately generated public protocol. These assertions bind
+    # our fixed equation factors to its genuine constants without reproducing
+    # public wire declarations or exporting Native types into that interface.
+    for name in [
+        'CRUCIBLE_SHMEM_ABI_VERSION', 'CRUCIBLE_SHMEM_MAX_NODES',
+        'CRUCIBLE_SHMEM_MAX_VM_NODES', 'CRUCIBLE_SHMEM_REGION_HEADER_SIZE',
+        'CRUCIBLE_SHMEM_NODE_SLOT_SIZE', 'CRUCIBLE_SHMEM_NODE_SLOT_ALIGN',
+        'CRUCIBLE_SHMEM_RING_HEADER_SIZE', 'CRUCIBLE_SHMEM_FRAME_ENTRY_SIZE',
+        'CRUCIBLE_SHMEM_COVERAGE_QUEUE_CAPACITY',
+        'CRUCIBLE_SHMEM_COVERAGE_ENTRY_SIZE',
+        'CRUCIBLE_SHMEM_FINGERPRINT_SAMPLE_SLOT_SIZE',
+        'CRUCIBLE_SHMEM_WHITEBOX_MARKER_QUEUE_CAPACITY',
+        'CRUCIBLE_SHMEM_SELECTABLE_REPLY_QUEUE_CAPACITY',
+        'CRUCIBLE_SHMEM_ACCELERATOR_QUEUE_CAPACITY',
+        'CRUCIBLE_SHMEM_ACCELERATOR_ENTRY_SIZE',
+        'CRUCIBLE_SHMEM_NODE_SLOT_ACTION_HOLD_OFFSET',
+        'CRUCIBLE_SHMEM_NODE_SLOT_ACTION_RETURN_OFFSET',
+        'CRUCIBLE_SHMEM_NODE_SLOT_PARK_RETURN_OFFSET',
+        'CRUCIBLE_SHMEM_RING_HEADER_ALIGN',
+        'CRUCIBLE_SHMEM_FINGERPRINT_SAMPLE_SLOT_ALIGN',
+        'CRUCIBLE_SHMEM_WHITEBOX_MARKER_ENTRY_SIZE',
+        'CRUCIBLE_SHMEM_GUEST_INTROSPECTION_RINGS_PER_VM',
+        'CRUCIBLE_SHMEM_GUEST_INTROSPECTION_QUEUE_CAPACITY',
+        'CRUCIBLE_SHMEM_GUEST_INTROSPECTION_ENTRY_SIZE',
+        'CRUCIBLE_SHMEM_ACCELERATOR_RINGS_PER_VM',
+        'CRUCIBLE_FAULT_DEFAULT_COMMAND_CAPACITY',
+        'CRUCIBLE_FAULT_COMMAND_SLOT_V1_BYTES',
+        'CRUCIBLE_FAULT_RESULT_SLOT_V2_BYTES',
+        'CRUCIBLE_FAULT_EVENT_SLOT_V1_BYTES',
+        'CRUCIBLE_FAULT_EVENT_CAPACITY',
+        'CRUCIBLE_FAULT_PAYLOAD_ARENA_HEADER_BYTES',
+    ]:
+        value = contract['constants'][name]
+        assert isinstance(value, int)
+        lines.append(f'_Static_assert({name} == {value}U, "{name} contract");')
+    lines.append('')
+    operations = contract['layout']['operations']
+    lines += ['/* Every computed field is corroboration under a separate real role owner. */',
+              'typedef struct QemuCrucibleSharedRegionLayout {']
+    for operation in operations:
+        lines.append(f'    uint64_t {operation["result"]};')
+    lines += ['} QemuCrucibleSharedRegionLayout;', '',
+              'static inline int qemu_crucible_shared_region_layout_compute(',
+              '    uint32_t vm_count, uint32_t frame_queue_capacity,',
+              '    uint32_t fault_payload_arena_bytes, QemuCrucibleSharedRegionLayout *out)',
+              '{',
+              '    if (!out || vm_count > CRUCIBLE_SHMEM_MAX_VM_NODES ||',
+              '        !frame_queue_capacity || (frame_queue_capacity & (frame_queue_capacity - 1)) ||',
+              '        fault_payload_arena_bytes < CRUCIBLE_FAULT_DEFAULT_PAYLOAD_ARENA_BYTES ||',
+              '        fault_payload_arena_bytes > CRUCIBLE_FAULT_HARD_PAYLOAD_ARENA_BYTES) {',
+              '        return -EINVAL;', '    }', '']
+    parameters = set(contract['layout']['parameters'])
+    seen = set()
+    def argument(item):
+        if isinstance(item, int):
+            return f'UINT64_C({item})'
+        if item in parameters:
+            return f'(uint64_t){item}'
+        assert item in seen, item
+        return 'out->' + item
+    def upper_bound(item):
+        if isinstance(item, int):
+            return item
+        if item in parameters:
+            return 0xffffffff
+        return 0xffffffffffffffff
+
+    for operation in operations:
+        name = operation['result']
+        inputs = [argument(item) for item in operation['inputs']]
+        kind = operation['operation']
+        if kind in ['literal', 'identity']:
+            expression = inputs[0]
+        elif kind == 'add':
+            lines += [f'    if ({inputs[1]} > UINT64_MAX - {inputs[0]}) {{',
+                      '        return -EOVERFLOW;', '    }']
+            expression = ' + '.join(inputs)
+        elif kind == 'multiply':
+            # uint32 parameters and literal factors sometimes prove the
+            # product fits u64. Emit a guard only when overflow is possible.
+            left, right = operation['inputs']
+            if upper_bound(left) * upper_bound(right) > 0xffffffffffffffff:
+                lines += [f'    if ({inputs[1]} && {inputs[0]} > UINT64_MAX / {inputs[1]}) {{',
+                          '        return -EOVERFLOW;', '    }']
+            expression = ' * '.join(inputs)
+        elif kind == 'align_up':
+            alignment = operation['inputs'][1]
+            assert isinstance(alignment, int) and alignment and not alignment & (alignment - 1)
+            lines += [f'    if ({inputs[0]} > UINT64_MAX - UINT64_C({alignment - 1})) {{',
+                      '        return -EOVERFLOW;', '    }']
+            expression = f'({inputs[0]} + UINT64_C({alignment - 1})) & ~UINT64_C({alignment - 1})'
+        else:
+            raise ValueError(kind)
+        lines += [f'    out->{name} = {expression};', '']
+        seen.add(name)
+    lines += ['    return 0;', '}', '', '#endif', '']
+    return '\n'.join(lines)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('contract', type=Path,
+                        help='exact public generated crucible_shmem_abi.h')
+    parser.add_argument('output', type=Path)
+    args = parser.parse_args()
+    data = args.contract.read_bytes()
+    if hashlib.sha256(data).hexdigest() != CONTRACT_SHA256:
+        raise ValueError('public ABI header differs from the pinned generated input')
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(declarations(wire_contract(data)))
+
+
+if __name__ == '__main__':
+    main()
