+static int crucible_hot_fork_pidfd_open(pid_t pid)
+{
+    return syscall(__NR_pidfd_open, pid, 0);
+}
+
+static int crucible_hot_fork_pidfd_probe(int pidfd)
+{
+    return syscall(__NR_pidfd_send_signal, pidfd, 0, NULL, 0);
+}
+
+static int crucible_hot_fork_close_range(unsigned int first,
+                                         unsigned int last)
+{
+    if (syscall(__NR_close_range, first, last, 0) < 0) {
+        return -errno;
+    }
+    return 0;
+}
+
+static int crucible_hot_fork_probe_close_range(void)
+{
+    return crucible_hot_fork_close_range(UINT_MAX, UINT_MAX);
+}
+
+static int crucible_hot_fork_block_child_signals(void)
+{
+    sigset_t blocked;
+
+    if (sigfillset(&blocked) < 0 ||
+        sigprocmask(SIG_SETMASK, &blocked, NULL) < 0) {
+        return -errno;
+    }
+    return 0;
+}
+
+int qemu_crucible_hot_fork_capture_parent_identity(
+    QemuCrucibleHotForkParentIdentity *identity)
+{
+    int pidfd;
+
+    if (!identity) {
+        return -EINVAL;
+    }
+    identity->parent_pid = -1;
+    identity->parent_pidfd = -1;
+
+    pidfd = crucible_hot_fork_pidfd_open(getpid());
+    if (pidfd < 0) {
+        return -errno;
+    }
+    if (fcntl(pidfd, F_GETFD) < 0) {
+        int result = -errno;
+
+        close(pidfd);
+        return result;
+    }
+
+    identity->parent_pid = getpid();
+    identity->parent_pidfd = pidfd;
+    return 0;
+}
+
+int qemu_crucible_hot_fork_authenticate_immediate_child(
+    const QemuCrucibleHotForkParentIdentity *identity)
+{
+    pid_t child_pid;
+
+    if (!identity || identity->parent_pid <= 1 ||
+        identity->parent_pidfd < 0) {
+        return -EINVAL;
+    }
+
+    child_pid = getpid();
+    if (child_pid == identity->parent_pid ||
+        getppid() != identity->parent_pid) {
+        return -EPERM;
+    }
+
+    if (prctl(PR_SET_PDEATHSIG, SIGKILL, 0, 0, 0) < 0) {
+        return -errno;
+    }
+    if (getppid() != identity->parent_pid) {
+        return -ESRCH;
+    }
+    if (crucible_hot_fork_pidfd_probe(identity->parent_pidfd) < 0) {
+        return -errno;
+    }
+    if (getppid() != identity->parent_pid) {
+        return -ESRCH;
+    }
+    return 0;
+}
+
+void qemu_crucible_hot_fork_release_parent_identity(
+    QemuCrucibleHotForkParentIdentity *identity)
+{
+    if (!identity) {
+        return;
+    }
+    if (identity->parent_pidfd >= 0) {
+        close(identity->parent_pidfd);
+    }
+    identity->parent_pid = -1;
+    identity->parent_pidfd = -1;
+}
+
+int qemu_crucible_hot_fork_adopt_child_as_parent(void)
+{
+    int signal = 0;
+
+    if (prctl(PR_GET_PDEATHSIG, &signal, 0, 0, 0) < 0) {
+        return -errno;
+    }
+    if (signal != SIGKILL) {
+        return -EPERM;
+    }
+    if (prctl(PR_SET_PDEATHSIG, 0, 0, 0, 0) < 0) {
+        return -errno;
+    }
+    return 0;
+}
+
+static int crucible_hot_fork_dup3_flags(int descriptor_flags)
+{
+    return (descriptor_flags & FD_CLOEXEC) != 0 ? O_CLOEXEC : 0;
+}
+
+static bool crucible_hot_fork_descriptor_replacement_table_is_valid(
+    const QemuCrucibleHotForkDescriptorReplacement *replacements,
+    size_t replacement_count)
+{
+    if (!replacements || replacement_count == 0 ||
+        replacement_count >
+            QEMU_CRUCIBLE_HOT_FORK_MAX_DESCRIPTOR_REPLACEMENTS) {
+        return false;
+    }
+
+    for (size_t index = 0; index < replacement_count; index++) {
+        int source = replacements[index].source_fd;
+        int target = replacements[index].target_fd;
+
+        if (source < 0 || target < 0 || source == target ||
+            fcntl(source, F_GETFD) < 0 || fcntl(target, F_GETFD) < 0 ||
+            (index > 0 && replacements[index - 1].target_fd >= target)) {
+            return false;
+        }
+        for (size_t other = 0; other < index; other++) {
+            if (source == replacements[other].source_fd ||
+                source == replacements[other].target_fd ||
+                target == replacements[other].source_fd) {
+                return false;
+            }
+        }
+    }
+    return true;
+}
+
+static bool crucible_hot_fork_restore_descriptors(
+    QemuCrucibleHotForkSavedDescriptor *saved,
+    size_t saved_count)
+{
+    bool complete = true;
+
+    for (size_t index = 0; index < saved_count; index++) {
+        if (saved[index].fd < 0) {
+            continue;
+        }
+        if (dup3(saved[index].fd, saved[index].target_fd,
+                 crucible_hot_fork_dup3_flags(saved[index].target_flags)) <
+            0) {
+            complete = false;
+        }
+    }
+    return complete;
+}
+
+int qemu_crucible_hot_fork_replace_descriptor_set(
+    const QemuCrucibleHotForkDescriptorReplacement *replacements,
+    size_t replacement_count,
+    QemuCrucibleHotForkDescriptorVerifier verify,
+    void *opaque)
+{
+    QemuCrucibleHotForkSavedDescriptor
+        saved[QEMU_CRUCIBLE_HOT_FORK_MAX_DESCRIPTOR_REPLACEMENTS];
+    size_t saved_count = 0;
+    int result = 0;
+
+    if (!replacements || !verify ||
+        !crucible_hot_fork_descriptor_replacement_table_is_valid(
+            replacements, replacement_count)) {
+        return -EINVAL;
+    }
+
+    for (size_t index = 0; index < replacement_count; index++) {
+        saved[index] = (QemuCrucibleHotForkSavedDescriptor) { .fd = -1 };
+        saved[index].target_fd = replacements[index].target_fd;
+        saved[index].target_flags =
+            fcntl(replacements[index].target_fd, F_GETFD);
+        if (saved[index].target_flags < 0) {
+            result = -errno;
+            goto out;
+        }
+        saved[index].fd = fcntl(replacements[index].target_fd,
+                                F_DUPFD_CLOEXEC, 3);
+        if (saved[index].fd < 0) {
+            result = -errno;
+            goto out;
+        }
+        saved_count++;
+    }
+
+    for (size_t index = 0; index < replacement_count; index++) {
+        if (dup3(replacements[index].source_fd,
+                 replacements[index].target_fd,
+                 crucible_hot_fork_dup3_flags(saved[index].target_flags)) <
+            0) {
+            result = -errno;
+            goto rollback;
+        }
+    }
+
+    result = verify(opaque);
+    if (result != 0) {
+        if (result > 0 || result == -EUCLEAN) {
+            result = -EPROTO;
+        }
+        goto rollback;
+    }
+
+    for (size_t index = 0; index < replacement_count; index++) {
+        close(replacements[index].source_fd);
+    }
+    goto out;
+
+rollback:
+    if (!crucible_hot_fork_restore_descriptors(saved, saved_count)) {
+        result = -EUCLEAN;
+    }
+out:
+    for (size_t index = 0; index < saved_count; index++) {
+        if (saved[index].fd >= 0) {
+            close(saved[index].fd);
+        }
+    }
+    return result;
+}
+
+int qemu_crucible_hot_fork_replace_endpoint_descriptors(
+    const QemuCrucibleHotForkDescriptorReplacement replacements[2],
+    QemuCrucibleHotForkDescriptorVerifier verify,
+    void *opaque)
+{
+    QemuCrucibleHotForkDescriptorReplacement canonical[2];
+
+    if (!replacements) {
+        return -EINVAL;
+    }
+    canonical[0] = replacements[0];
+    canonical[1] = replacements[1];
+    if (canonical[0].target_fd > canonical[1].target_fd) {
+        QemuCrucibleHotForkDescriptorReplacement temporary = canonical[0];
+
+        canonical[0] = canonical[1];
+        canonical[1] = temporary;
+    }
+    return qemu_crucible_hot_fork_replace_descriptor_set(
+        canonical, QEMU_CRUCIBLE_HOT_FORK_ENDPOINT_REPLACEMENT_COUNT,
+        verify, opaque);
+}
+
+static int crucible_hot_fork_accept_descriptor_replacements(void *opaque)
+{
+    (void)opaque;
+    return 0;
+}
+
+static bool crucible_hot_fork_retained_table_is_valid(
+    const QemuCrucibleHotForkDescriptorReplacement *replacements,
+    size_t replacement_count,
+    const int *retained_fds,
+    size_t retained_fd_count)
+{
+    if (!replacements || !retained_fds || retained_fd_count == 0 ||
+        retained_fd_count >
+            QEMU_CRUCIBLE_HOT_FORK_MAX_RETAINED_DESCRIPTORS ||
+        !crucible_hot_fork_descriptor_replacement_table_is_valid(
+            replacements, replacement_count)) {
+        return false;
+    }
+
+    for (size_t index = 0; index < retained_fd_count; index++) {
+        int fd = retained_fds[index];
+
+        if (fd < 0 || fcntl(fd, F_GETFD) < 0 ||
+            (index > 0 && retained_fds[index - 1] >= fd)) {
+            return false;
+        }
+        for (size_t replacement = 0; replacement < replacement_count;
+             replacement++) {
+            if (fd == replacements[replacement].source_fd) {
+                return false;
+            }
+        }
+    }
+    for (size_t replacement = 0; replacement < replacement_count;
+         replacement++) {
+        bool target_present = false;
+
+        for (size_t index = 0; index < retained_fd_count; index++) {
+            if (retained_fds[index] == replacements[replacement].target_fd) {
+                target_present = true;
+                break;
+            }
+            if (retained_fds[index] > replacements[replacement].target_fd) {
+                break;
+            }
+        }
+        if (!target_present) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static int crucible_hot_fork_close_outside_table(const int *retained_fds,
+                                                  size_t retained_fd_count)
+{
+    unsigned int first = 0;
+
+    for (size_t index = 0; index < retained_fd_count; index++) {
+        unsigned int retained = retained_fds[index];
+        int result;
+
+        if (first < retained) {
+            result = crucible_hot_fork_close_range(first, retained - 1);
+            if (result != 0) {
+                return result;
+            }
+        }
+        first = retained + 1;
+    }
+    return crucible_hot_fork_close_range(first, UINT_MAX);
+}
+
+int qemu_crucible_hot_fork_begin_descriptor_table(
+    QemuCrucibleHotForkParentIdentity *identity,
+    QemuCrucibleHotForkDescriptorTableTransaction *transaction)
+{
+    pid_t parent_pid;
+    int result;
+
+    if (!identity || !transaction) {
+        return -EINVAL;
+    }
+    transaction->parent_pid = -1;
+    transaction->child_pid = -1;
+    transaction->active = false;
+    transaction->descriptors_applied = false;
+    transaction->child_reinitialized = false;
+    transaction->mappings_verified = false;
+
+    result = crucible_hot_fork_probe_close_range();
+    if (result != 0) {
+        return result;
+    }
+    result = qemu_crucible_hot_fork_authenticate_immediate_child(identity);
+    if (result != 0) {
+        return result;
+    }
+
+    parent_pid = identity->parent_pid;
+    result = crucible_hot_fork_block_child_signals();
+    qemu_crucible_hot_fork_release_parent_identity(identity);
+    if (result != 0) {
+        return result;
+    }
+
+    transaction->parent_pid = parent_pid;
+    transaction->child_pid = getpid();
+    transaction->active = true;
+    transaction->descriptors_applied = false;
+    transaction->child_reinitialized = false;
+    transaction->mappings_verified = false;
+    return 0;
+}
+
+int qemu_crucible_hot_fork_apply_descriptor_table(
+    QemuCrucibleHotForkDescriptorTableTransaction *transaction,
+    const QemuCrucibleHotForkDescriptorReplacement *replacements,
+    size_t replacement_count,
+    const int *retained_fds,
+    size_t retained_fd_count,
+    QemuCrucibleHotForkDescriptorVerifier verify,
+    void *opaque)
+{
+    int result;
+
+    if (!transaction) {
+        return -EINVAL;
+    }
+    if (!transaction->active || transaction->parent_pid <= 1 ||
+        transaction->child_pid != getpid()) {
+        return -EPERM;
+    }
+    if (!verify || !crucible_hot_fork_retained_table_is_valid(
+                       replacements, replacement_count,
+                       retained_fds, retained_fd_count)) {
+        return -EINVAL;
+    }
+
+    transaction->active = false;
+    transaction->descriptors_applied = false;
+    transaction->child_reinitialized = false;
+    transaction->mappings_verified = false;
+    result = qemu_crucible_hot_fork_replace_descriptor_set(
+        replacements, replacement_count,
+        crucible_hot_fork_accept_descriptor_replacements, NULL);
+    if (result != 0) {
+        return result;
+    }
+    result = crucible_hot_fork_close_outside_table(retained_fds,
+                                                   retained_fd_count);
+    if (result != 0) {
+        return result;
+    }
+    for (size_t index = 0; index < retained_fd_count; index++) {
+        if (fcntl(retained_fds[index], F_GETFD) < 0) {
+            return -errno;
+        }
+    }
+
+    result = verify(opaque);
+    if (result > 0 || result == -EUCLEAN) {
+        return -EPROTO;
+    }
+    if (result == 0) {
+        transaction->descriptors_applied = true;
+    }
+    return result;
+}
+
+static bool crucible_hot_fork_parse_hex(const char *bytes, size_t length,
+                                        uint64_t *value)
+{
+    uint64_t parsed = 0;
+
+    if (length == 0) {
+        return false;
+    }
+    for (size_t index = 0; index < length; index++) {
+        unsigned int digit;
+
+        if (bytes[index] >= '0' && bytes[index] <= '9') {
+            digit = bytes[index] - '0';
+        } else if (bytes[index] >= 'a' && bytes[index] <= 'f') {
+            digit = bytes[index] - 'a' + 10;
+        } else if (bytes[index] >= 'A' && bytes[index] <= 'F') {
+            digit = bytes[index] - 'A' + 10;
+        } else {
+            return false;
+        }
+        if (parsed > (UINT64_MAX - digit) / 16) {
+            return false;
+        }
+        parsed = parsed * 16 + digit;
+    }
+    *value = parsed;
+    return true;
+}
+
+static bool crucible_hot_fork_parse_decimal(const char *bytes, size_t length,
+                                            uint64_t *value)
+{
+    uint64_t parsed = 0;
+
+    if (length == 0) {
+        return false;
+    }
+    for (size_t index = 0; index < length; index++) {
+        unsigned int digit;
+
+        if (bytes[index] < '0' || bytes[index] > '9') {
+            return false;
+        }
+        digit = bytes[index] - '0';
+        if (parsed > (UINT64_MAX - digit) / 10) {
+            return false;
+        }
+        parsed = parsed * 10 + digit;
+    }
+    *value = parsed;
+    return true;
+}
+
+static const char *crucible_hot_fork_next_mapping_field(
+    const char *cursor, const char *record_end, const char **field_end)
+{
+    while (cursor < record_end && *cursor == ' ') {
+        cursor++;
+    }
+    if (cursor == record_end) {
+        return NULL;
+    }
+    *field_end = memchr(cursor, ' ', record_end - cursor);
+    if (!*field_end) {
+        *field_end = record_end;
+    }
+    return cursor;
+}
+
+static int crucible_hot_fork_parse_mapping_record(
+    const char *record,
+    size_t length,
+    uint64_t *start,
+    uint64_t *mapping_length,
+    uint64_t *offset,
+    uint64_t *device_major,
+    uint64_t *device_minor,
+    uint64_t *inode,
+    bool *writable_shared)
+{
+    const char *range_end = memchr(record, ' ', length);
+    const char *separator;
+    const char *permissions;
+    const char *permissions_end;
+    const char *offset_start;
+    const char *offset_end;
+    const char *device_start;
+    const char *device_end;
+    const char *device_separator;
+    const char *inode_start;
+    const char *inode_end;
+    const char *record_end = record + length;
+    uint64_t end;
+
+    if (!range_end || range_end == record) {
+        return -EPROTO;
+    }
+    separator = memchr(record, '-', range_end - record);
+    if (!separator || separator == record || separator + 1 == range_end ||
+        !crucible_hot_fork_parse_hex(record, separator - record, start) ||
+        !crucible_hot_fork_parse_hex(separator + 1,
+                                     range_end - separator - 1, &end) ||
+        *start >= end) {
+        return -EPROTO;
+    }
+
+    permissions = crucible_hot_fork_next_mapping_field(
+        range_end, record_end, &permissions_end);
+    if (!permissions || permissions_end - permissions != 4 ||
+        (permissions[0] != 'r' && permissions[0] != '-') ||
+        (permissions[1] != 'w' && permissions[1] != '-') ||
+        (permissions[2] != 'x' && permissions[2] != '-') ||
+        (permissions[3] != 'p' && permissions[3] != 's')) {
+        return -EPROTO;
+    }
+
+    offset_start = crucible_hot_fork_next_mapping_field(
+        permissions_end, record_end, &offset_end);
+    device_start = offset_start ? crucible_hot_fork_next_mapping_field(
+        offset_end, record_end, &device_end) : NULL;
+    device_separator = device_start ? memchr(
+        device_start, ':', device_end - device_start) : NULL;
+    inode_start = device_start ? crucible_hot_fork_next_mapping_field(
+        device_end, record_end, &inode_end) : NULL;
+    if (!offset_start || !device_start || !device_separator ||
+        device_separator == device_start ||
+        device_separator + 1 == device_end ||
+        !inode_start || !crucible_hot_fork_parse_hex(
+            offset_start, offset_end - offset_start, offset) ||
+        !crucible_hot_fork_parse_hex(
+            device_start, device_separator - device_start, device_major) ||
+        !crucible_hot_fork_parse_hex(
+            device_separator + 1, device_end - device_separator - 1,
+            device_minor) ||
+        !crucible_hot_fork_parse_decimal(
+            inode_start, inode_end - inode_start, inode)) {
+        return -EPROTO;
+    }
+
+    *mapping_length = end - *start;
+    *writable_shared = permissions[1] == 'w' && permissions[3] == 's';
+    return 0;
+}
+
+static bool crucible_hot_fork_shared_mapping_table_is_valid(
+    const QemuCrucibleHotForkSharedMapping *mappings,
+    size_t mapping_count)
+{
+    uint64_t prior_end = 0;
+    uint64_t page_size = qemu_real_host_page_size();
+
+    if ((mapping_count != 0 && !mappings) ||
+        mapping_count > QEMU_CRUCIBLE_HOT_FORK_MAX_SHARED_MAPPINGS ||
+        page_size == 0) {
+        return false;
+    }
+    for (size_t index = 0; index < mapping_count; index++) {
+        struct stat backing;
+        uint64_t backing_pages;
+        uint64_t end;
+        int seals;
+
+        if (mappings[index].backing_fd < 0 ||
+            mappings[index].length == 0 ||
+            mappings[index].start % page_size != 0 ||
+            mappings[index].length % page_size != 0 ||
+            mappings[index].offset % page_size != 0 ||
+            mappings[index].start > UINT64_MAX - mappings[index].length ||
+            mappings[index].offset > UINT64_MAX - mappings[index].length ||
+            fstat(mappings[index].backing_fd, &backing) < 0 ||
+            !S_ISREG(backing.st_mode) || backing.st_size < 0 ||
+            (uint64_t)backing.st_size > UINT64_MAX - (page_size - 1)) {
+            return false;
+        }
+        /*
+         * Protocol regions carry exact lengths while the VMA that maps them
+         * spans whole pages, so a mapping may end inside the backing's final
+         * partial page; the kernel zero-fills that tail.  It may not extend
+         * past that page.
+         */
+        backing_pages = QEMU_ALIGN_UP((uint64_t)backing.st_size, page_size);
+        if (mappings[index].offset + mappings[index].length > backing_pages) {
+            return false;
+        }
+        seals = fcntl(mappings[index].backing_fd, F_GET_SEALS);
+        if (seals < 0 || (seals & F_SEAL_SHRINK) == 0) {
+            return false;
+        }
+        end = mappings[index].start + mappings[index].length;
+        if (index > 0 && mappings[index].start < prior_end) {
+            return false;
+        }
+        prior_end = end;
+    }
+    return true;
+}
+
+static bool crucible_hot_fork_mapping_backings_are_retained(
+    const QemuCrucibleHotForkSharedMapping *mappings,
+    size_t mapping_count,
+    const int *retained_fds,
+    size_t retained_fd_count)
+{
+    for (size_t mapping = 0; mapping < mapping_count; mapping++) {
+        size_t lower = 0;
+        size_t upper = retained_fd_count;
+
+        while (lower < upper) {
+            size_t middle = lower + (upper - lower) / 2;
+
+            if (retained_fds[middle] < mappings[mapping].backing_fd) {
+                lower = middle + 1;
+            } else {
+                upper = middle;
+            }
+        }
+        if (lower == retained_fd_count ||
+            retained_fds[lower] != mappings[mapping].backing_fd) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static int crucible_hot_fork_match_mapping_record(
+    const char *record,
+    size_t length,
+    const QemuCrucibleHotForkSharedMapping *mappings,
+    size_t mapping_count,
+    size_t *mapping_index)
+{
+    struct stat backing;
+    uint64_t start;
+    uint64_t mapping_length;
+    uint64_t offset;
+    uint64_t device_major;
+    uint64_t device_minor;
+    uint64_t inode;
+    bool writable_shared;
+    int result = crucible_hot_fork_parse_mapping_record(
+        record, length, &start, &mapping_length, &offset, &device_major,
+        &device_minor, &inode, &writable_shared);
+
+    if (result != 0 || !writable_shared) {
+        return result;
+    }
+    if (*mapping_index >= mapping_count ||
+        mappings[*mapping_index].start != start ||
+        mappings[*mapping_index].length != mapping_length ||
+        mappings[*mapping_index].offset != offset) {
+        return -EPERM;
+    }
+    if (fstat(mappings[*mapping_index].backing_fd, &backing) < 0) {
+        return -errno;
+    }
+    if (device_major > UINT_MAX || device_minor > UINT_MAX ||
+        major(backing.st_dev) != device_major ||
+        minor(backing.st_dev) != device_minor ||
+        (uint64_t)backing.st_ino != inode) {
+        return -EPERM;
+    }
+    (*mapping_index)++;
+    return 0;
+}
+
+static int crucible_hot_fork_scan_mapping_table(
+    const QemuCrucibleHotForkSharedMapping *mappings,
+    size_t mapping_count)
+{
+    char input[4096];
+    char record[QEMU_CRUCIBLE_HOT_FORK_MAX_MAPPING_RECORD_BYTES];
+    size_t mapping_index = 0;
+    size_t record_count = 0;
+    size_t record_length = 0;
+    size_t total_bytes = 0;
+    int maps_fd;
+    int result = 0;
+
+    maps_fd = open("/proc/self/maps", O_RDONLY | O_CLOEXEC);
+    if (maps_fd < 0) {
+        return -errno;
+    }
+    for (;;) {
+        ssize_t length = read(maps_fd, input, sizeof(input));
+
+        if (length < 0) {
+            if (errno == EINTR) {
+                continue;
+            }
+            result = -errno;
+            break;
+        }
+        if (length == 0) {
+            if (record_length != 0) {
+                record_count++;
+                if (record_count >
+                    QEMU_CRUCIBLE_HOT_FORK_MAX_MAPPING_RECORDS) {
+                    result = -E2BIG;
+                } else {
+                    result = crucible_hot_fork_match_mapping_record(
+                        record, record_length, mappings, mapping_count,
+                        &mapping_index);
+                }
+            }
+            break;
+        }
+        if ((size_t)length >
+            QEMU_CRUCIBLE_HOT_FORK_MAX_MAPPING_BYTES - total_bytes) {
+            result = -E2BIG;
+            break;
+        }
+        total_bytes += length;
+
+        for (ssize_t index = 0; index < length; index++) {
+            if (input[index] == '\n') {
+                record_count++;
+                if (record_count >
+                    QEMU_CRUCIBLE_HOT_FORK_MAX_MAPPING_RECORDS) {
+                    result = -E2BIG;
+                    break;
+                }
+                result = crucible_hot_fork_match_mapping_record(
+                    record, record_length, mappings, mapping_count,
+                    &mapping_index);
+                record_length = 0;
+                if (result != 0) {
+                    break;
+                }
+            } else {
+                if (record_length == sizeof(record)) {
+                    result = -E2BIG;
+                    break;
+                }
+                record[record_length++] = input[index];
+            }
+        }
+        if (result != 0) {
+            break;
+        }
+    }
+    if (close(maps_fd) < 0 && result == 0) {
+        result = -errno;
+    }
+    if (result == 0 && (record_count == 0 || mapping_index != mapping_count)) {
+        result = -EPERM;
+    }
+    return result;
+}
+
+typedef struct QemuCrucibleHotForkSourceMappingSearch {
+    uint64_t device_major;
+    uint64_t device_minor;
+    uint64_t inode;
+    uint64_t length;
+    QemuCrucibleHotForkSourceMapping mapping;
+    bool found;
+} QemuCrucibleHotForkSourceMappingSearch;
+
+static int crucible_hot_fork_match_source_mapping(
+    const char *record,
+    size_t record_length,
+    QemuCrucibleHotForkSourceMappingSearch *search)
+{
+    uint64_t start;
+    uint64_t mapping_length;
+    uint64_t offset;
+    uint64_t device_major;
+    uint64_t device_minor;
+    uint64_t inode;
+    bool writable_shared;
+    int result = crucible_hot_fork_parse_mapping_record(
+        record, record_length, &start, &mapping_length, &offset,
+        &device_major, &device_minor, &inode, &writable_shared);
+
+    if (result != 0 || !writable_shared ||
+        device_major != search->device_major ||
+        device_minor != search->device_minor || inode != search->inode) {
+        return result;
+    }
+    if (search->found || offset != 0 || mapping_length != search->length) {
+        return -EPERM;
+    }
+    search->mapping.start = start;
+    search->mapping.length = mapping_length;
+    search->mapping.offset = offset;
+    search->found = true;
+    return 0;
+}
+
+int qemu_crucible_hot_fork_find_source_mapping(
+    uint64_t device,
+    uint64_t inode,
+    uint64_t length,
+    QemuCrucibleHotForkSourceMapping *mapping)
+{
+    char input[4096];
+    char record[QEMU_CRUCIBLE_HOT_FORK_MAX_MAPPING_RECORD_BYTES];
+    QemuCrucibleHotForkSourceMappingSearch search = {
+        .inode = inode,
+        .length = length,
+    };
+    size_t record_count = 0;
+    size_t record_length = 0;
+    size_t total_bytes = 0;
+    uint64_t page_size = qemu_real_host_page_size();
+    int maps_fd;
+    int result = 0;
+
+    if (!mapping || (uint64_t)(dev_t)device != device || inode == 0 ||
+        length == 0 || page_size == 0 ||
+        length > UINT64_MAX - (page_size - 1)) {
+        return -EINVAL;
+    }
+    /*
+     * The protocol region length is exact; the kernel maps whole pages, so
+     * the VMA that carries it spans the page-rounded extent.
+     */
+    search.length = QEMU_ALIGN_UP(length, page_size);
+    search.device_major = major((dev_t)device);
+    search.device_minor = minor((dev_t)device);
+    memset(mapping, 0, sizeof(*mapping));
