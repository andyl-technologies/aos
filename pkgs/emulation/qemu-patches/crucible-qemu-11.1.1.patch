+static bool test_bytes_equal(const uint8_t *bytes, size_t length,
+                             uint8_t expected)
+{
+    for (size_t i = 0; i < length; i++) {
+        if (bytes[i] != expected) {
+            return false;
+        }
+    }
+    return true;
+}
