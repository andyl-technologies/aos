+static int fingerprint_retirement_prepare(void)
+{
+    struct QemuCrucibleFingerprintRetirementLoan *loan = &ordinary_fingerprint;
+    CrucibleRamInventory *retained = NULL;
+    int status;
+
+    if (!admission_regions || !bql_locked() || !qemu_in_main_thread() ||
+        current_cpu || qemu_in_coroutine() || !capture_authorized() || loan->invoking ||
+        !fingerprint_root_operation || !fingerprint_root_frame.active ||
+        fingerprint_root_outcome.module_invoking || fingerprint_root_outcome.callback_returned ||
+        fingerprint_root_outcome.post_recorded || !fingerprint_root_writer) {
+        return -EPERM;
+    }
+    if (!qemu_crucible_startup_source_fingerprint_retirement_idle_v1()) {
+        /* The module cannot admit a new outer operation while its old issued
+         * borrow remains. Physical return has a separate before-admission API. */
+        return -EBUSY;
+    }
+    if (candidate_fingerprint_deferred.rearm_deferred &&
+        candidate_fingerprint_deferred.regions != admission_regions) {
+        return -ESTALE;
+    }
+    if (logical_physical_debt.pending &&
+        (logical_physical_debt.regions != admission_regions ||
+         logical_physical_debt.topology != qatomic_read(&topology_generation))) {
+        return -ESTALE;
+    }
+    if (loan->regions) {
+        status = region_inventory_drop(&loan->regions);
+        if (status) {
+            return status;
+        }
+    }
+    status = region_inventory_ref(admission_regions, &retained);
+    if (status) {
+        return status;
+    }
+    /* This fresh genuine operation measures CURRENT dirt. No equality with the
+     * old publication dirty epoch can bar legitimate intervening RAM writes. */
+    *loan = (struct QemuCrucibleFingerprintRetirementLoan) {
+        .regions = retained,
+        .process = getpid(),
+        .frame_serial = fingerprint_root_frame.serial,
+        .publication_generation = candidate_fingerprint_deferred.rearm_deferred ?
+            candidate_fingerprint_deferred.publication_generation : 0,
+        .topology = qatomic_read(&topology_generation),
+        .dirty = qatomic_read(&dirty_generation),
+    };
+    qemu_thread_get_self(&loan->thread);
+    loan->invoking = true;
+    loan->phase = 1;
+    status = qemu_crucible_startup_source_fingerprint_borrow_v1(loan);
+    loan->invoking = false;
+    loan->operation_borrowed =
+        !qemu_crucible_startup_source_fingerprint_retirement_idle_v1();
+    if (status && !loan->first_status) {
+        loan->first_status = status;
+    }
+    return status;
+}
+
+static bool fingerprint_retirement_versions_current(
+    const struct QemuCrucibleFingerprintRetirementLoan *loan)
+{
+    if (!bql_locked() || !qemu_in_main_thread() || current_cpu ||
+        qemu_in_coroutine() || !capture_active || candidate_capture.active ||
+        (!capture_observation_only || !logical_capture->active) ||
+        capture_owner_token || !capture_authorized() ||
+        capture_generation != loan->operation_capture_generation ||
+        loan->regions != admission_regions || !capture_regions ||
+        loan->regions->len != capture_regions->len ||
+        loan->topology != capture_topology_generation ||
+        loan->topology != qatomic_read(&topology_generation) ||
+        loan->dirty != capture_dirty_generation ||
+        loan->dirty != qatomic_read(&dirty_generation)) {
+        return false;
+    }
+    for (size_t index = 0; index < loan->regions->len; index++) {
+        const CrucibleRamRegion *retained = region_inventory_index(loan->regions, index);
+        const CrucibleRamRegion *current = region_inventory_index(capture_regions, index);
+        uint64_t start, end, length = retained->descriptor.logical_length;
+
+        fingerprint_retirement_range(index, &start, &end);
+        if (retained->block != current->block ||
+            memcmp(&retained->descriptor, &current->descriptor, sizeof(retained->descriptor)) ||
+            retained->block->used_length != length ||
+            retained->block->offset != retained->fingerprint_ram_offset ||
+            current->fingerprint_ram_offset != retained->fingerprint_ram_offset ||
+            length > (ram_addr_t)-1 - retained->fingerprint_ram_offset ||
+            start > end || end > length) {
+            return false;
+        }
+    }
+    return true;
+}
+
+/* Clear/restore only folded current/retained intervals of the fingerprint plane.
+ * No checkpoint/migration dirty plane participates in this consumer's ACK. */
+static int fingerprint_retirement_dirty(
+    const struct QemuCrucibleFingerprintRetirementLoan *loan, bool restore)
+{
+    WITH_RCU_READ_LOCK_GUARD() {
+        DirtyMemoryBlocks *blocks =
+            qatomic_rcu_read(&ram_list.dirty_memory[DIRTY_MEMORY_CRUCIBLE_RAM]);
+
+        if (!blocks) {
+            return -ESTALE;
+        }
+        for (size_t index = 0; index < loan->regions->len; index++) {
+            const CrucibleRamRegion *region = region_inventory_index(loan->regions, index);
+            uint64_t range_start, range_end;
+            ram_addr_t start, end, page, last;
+
+            fingerprint_retirement_range(index, &range_start, &range_end);
+            start = region->fingerprint_ram_offset + range_start;
+            end = region->fingerprint_ram_offset + range_end;
+            page = start >> TARGET_PAGE_BITS;
+            last = end > start ? ((end - 1) >> TARGET_PAGE_BITS) + 1 : page;
+            while (page < last) {
+                size_t block = page / DIRTY_MEMORY_BLOCK_SIZE;
+                unsigned long bit = page % DIRTY_MEMORY_BLOCK_SIZE;
+                unsigned long count = MIN(last - page, DIRTY_MEMORY_BLOCK_SIZE - bit);
+
+                if (restore) {
+                    bitmap_set_atomic(blocks->blocks[block], bit, count);
+                } else {
+                    bitmap_test_and_clear_atomic(blocks->blocks[block], bit, count);
+                }
+                page += count;
+            }
+        }
+    }
+    return 0;
+}
+
+static int fingerprint_retirement_rearm(void)
+{
+    struct QemuCrucibleFingerprintRetirementLoan *loan = &ordinary_fingerprint;
+    int first = 0, premature_post = 0, status;
+
+    if (!loan->operation_borrowed || loan->attempted || loan->invoking ||
+        !logical_capture->active || !logical_capture->staged ||
+        !fingerprint_retirement_versions_current(loan)) {
+        return -ESTALE;
+    }
+    loan->attempted = true;
+    loan->phase = 2;
+    loan->invoking = true;
+    status = qemu_crucible_startup_source_fingerprint_retire_v1(
+        loan, &first, &premature_post);
+    loan->invoking = false;
+    loan->rearm_status = status;
+    if (first && !loan->first_status) {
+        loan->first_status = first;
+    }
+    /* Rearm/current is not the independent Original post. Source must leave
+     * the operation live here and expose no manufactured post result. */
+    if (premature_post && !loan->native_status) {
+        loan->native_status = -EPROTO;
+    }
+    if (!status && !fingerprint_retirement_versions_current(loan)) {
+        loan->native_status = -ESTALE;
+    }
+    return status ? status : loan->native_status;
+}
+
+static int fingerprint_retirement_acknowledge(int original_post)
+{
+    struct QemuCrucibleFingerprintRetirementLoan *loan = &ordinary_fingerprint;
