+static bool virtio_blk_validate_request_list(VirtIOBlock *s,
+                                             const VirtIOBlockReq *head,
+                                             Error **errp)
+{
+    const VirtIOBlockReq *request;
+    uint32_t count = 0;
+
+    for (request = head; request; request = request->next) {
+        if (count == VIRTIO_BLK_DROPPED_REQUESTS_MAX) {
+            error_setg(errp, "virtio-blk projection has too many requests");
+            return false;
+        }
+        count++;
+    }
+    for (request = head; request; request = request->next) {
+        uint16_t queue_index;
+
+        if (request->dev != s || !request->vq) {
+            error_setg(errp, "virtio-blk projection has invalid request owner");
+            return false;
+        }
+        queue_index = virtio_get_queue_index(request->vq);
+        if (queue_index >= s->conf.num_queues ||
+            request->vq != virtio_get_queue(VIRTIO_DEVICE(s), queue_index)) {
+            error_setg(errp, "virtio-blk projection has invalid request queue");
+            return false;
+        }
+    }
+
+    return true;
+}
+
+static void virtio_blk_put_request_list(QEMUFile *f, VirtIOBlock *s,
+                                        const VirtIOBlockReq *head)
+{
+    const VirtIOBlockReq *request;
+    uint32_t count = 0;
+
+    for (request = head; request; request = request->next) {
+        count++;
+    }
+    qemu_put_be32(f, count);
+    for (request = head; request; request = request->next) {
+        uint16_t queue_index = virtio_get_queue_index(request->vq);
+
+        qemu_put_be16(f, queue_index);
+        qemu_put_virtqueue_element(VIRTIO_DEVICE(s), f,
+                                   (VirtQueueElement *)&request->elem);
+    }
+}
