+static int setup_owned_runtime_field_current(qemu_plugin_id_t id,
+                                             QemuCrucibleStartupRuntimePurpose *runtime,
+                                             void *field)
+{
+    QemuCrucibleFingerprintCompletionBinding *completion =
+        &startup_source.fingerprint_completion;
+    uintptr_t address = (uintptr_t)field;
+    uintptr_t base;
+    uint64_t extent;
+    int status;
+
+    if (!startup_invocation(id)) {
+        return -EPERM;
+    }
+    status = startup_runtime_admission(id, runtime);
+    if (!status) {
+        status = fingerprint_completion_identity(completion);
+    }
+    if (status) {
+        return status;
+    }
+    base = (uintptr_t)completion->userdata;
+    extent = startup_runtime_parent_extent(runtime);
+    if (completion->runtime != runtime || !base || !field ||
+        extent < sizeof(void *) || extent > UINTPTR_MAX - base ||
+        address % _Alignof(void *) || address < base ||
+        address - base > extent - sizeof(void *)) {
+        return -EPERM;
+    }
+    return 0;
+}
