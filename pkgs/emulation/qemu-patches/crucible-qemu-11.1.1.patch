+static void flash_dirty_obligations(void)
+{
+    RAMBlock backing = { .max_length = 4096 };
+    PFlashCFI01 first = { .mem = { .ram_block = &backing, .ram_address = 4096, .size = 4096 } };
+    PFlashCFI02 second = { .orig_mem = { .ram_block = &backing, .ram_address = 8192, .size = 4096 } };
+    global_dirty_tracking = GLOBAL_DIRTY_CRUCIBLE_RAM;
+    writer_finished = true;
