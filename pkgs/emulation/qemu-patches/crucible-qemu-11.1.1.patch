+        declaration(startup_header,
+                    "int qemu_crucible_startup_source_inventory_allowance_reserve("),
+        declaration(native_plugin_header,
+                    "bool qemu_plugin_crucible_startup_source_retained("),
+        declaration(native, "int qemu_crucible_ram_placement_before_resume("),
+        declaration(native, "int qemu_crucible_ram_diagnostic_failure("),
