+def code_mask(source):
+    """Mask comments and literals while preserving offsets and newlines."""
+    masked = list(source)
+    state = None
+    escaped = False
+    cursor = 0
+    while cursor < len(source):
+        char = source[cursor]
+        following = source[cursor + 1] if cursor + 1 < len(source) else ""
+        if state == "line":
+            if char == "\n":
+                state = None
+            else:
+                masked[cursor] = " "
+        elif state == "block":
+            if char != "\n":
+                masked[cursor] = " "
+            if char == "*" and following == "/":
+                masked[cursor + 1] = " "
+                state = None
+                cursor += 1
+        elif state:
+            if char != "\n":
+                masked[cursor] = " "
+            if escaped:
+                escaped = False
+            elif char == "\\":
+                escaped = True
+            elif char == state:
+                state = None
+        elif char == "/" and following in ("/", "*"):
+            masked[cursor] = masked[cursor + 1] = " "
+            state = "line" if following == "/" else "block"
+            cursor += 1
+        elif char in ("'", '\"'):
+            masked[cursor] = " "
+            state = char
+        cursor += 1
+    if state and state != "line":
+        raise ValueError("unterminated source comment or literal")
+    return "".join(masked)
