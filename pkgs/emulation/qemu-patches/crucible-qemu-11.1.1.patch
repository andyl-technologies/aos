@@ -0,0 +1,73 @@
+/*
+ * Actual QOM untracked-instance refusal controls; no Source issuer fixture.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "qemu/module.h"
+#include "qom/object.h"
+
+#define TYPE_UNTRACKED_INSTANCE "crucible-untracked-instance"
+
+static unsigned int finalized;
+
+static void instance_finalize(Object *object)
+{
+    (void)object;
+    finalized++;
+}
+
+static const TypeInfo instance_type = {
+    .name = TYPE_UNTRACKED_INSTANCE,
+    .parent = TYPE_OBJECT,
+    .instance_size = sizeof(Object),
+    .instance_finalize = instance_finalize,
+};
+
+static void test_untracked_instance(void)
+{
+    Object *instance = object_new(TYPE_UNTRACKED_INSTANCE);
+    uintptr_t foreign_receipt = 0;
+    QemuCrucibleCpuSourceAllocationOwner *foreign_owner = (void *)instance;
+    QemuCrucibleCpuAllocationReceipt *receipt = (void *)&foreign_receipt;
+
+    finalized = 0;
+    object_ref(instance);
+    /* Real allocation and Object references do not enroll a Source header or
+     * receipt. The foreign opaque address must not be dereferenced/adopted. */
+    g_assert_cmpint(object_native_allocation_live_instance_current(
+        instance, foreign_owner, receipt, 1), ==, -ESTALE);
+    object_unref(instance);
+    g_assert_cmpuint(finalized, ==, 0);
+    g_assert_cmpint(object_native_allocation_live_instance_current(
+        instance, foreign_owner, receipt, 2), ==, -ESTALE);
+    object_unref(instance);
+    g_assert_cmpuint(finalized, ==, 1);
+}
+
+static void test_invalid_arguments(void)
+{
+    Object *instance = object_new(TYPE_UNTRACKED_INSTANCE);
+    uintptr_t foreign_receipt = 0;
+    QemuCrucibleCpuSourceAllocationOwner *foreign_owner = (void *)instance;
+    QemuCrucibleCpuAllocationReceipt *receipt = (void *)&foreign_receipt;
+
+    g_assert_cmpint(object_native_allocation_live_instance_current(
+        NULL, foreign_owner, receipt, 1), ==, -EINVAL);
+    g_assert_cmpint(object_native_allocation_live_instance_current(
+        instance, NULL, receipt, 1), ==, -EINVAL);
+    g_assert_cmpint(object_native_allocation_live_instance_current(
+        instance, foreign_owner, NULL, 1), ==, -EINVAL);
+    g_assert_cmpint(object_native_allocation_live_instance_current(
+        instance, foreign_owner, receipt, 0), ==, -EINVAL);
+    object_unref(instance);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    module_call_init(MODULE_INIT_QOM);
+    type_register_static(&instance_type);
+    g_test_add_func("/crucible/cpu-instance/untracked", test_untracked_instance);
+    g_test_add_func("/crucible/cpu-instance/invalid", test_invalid_arguments);
+    return g_test_run();
+}
