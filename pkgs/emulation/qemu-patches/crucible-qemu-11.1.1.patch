+
+#define PRIMITIVE(size, type, bytes)                                         \
+    static void st##size##_le_p(void *p, type value)                         \
+    {                                                                        \
+        for (unsigned i = 0; i < bytes; i++) {                               \
+            ((uint8_t *)p)[i] = value >> (i * 8);                            \
+        }                                                                    \
+    }                                                                        \
+                                                                             \
+    static void st##size##_be_p(void *p, type value)                         \
+    {                                                                        \
+        for (unsigned i = 0; i < bytes; i++) {                               \
+            ((uint8_t *)p)[bytes - i - 1] = value >> (i * 8);                \
+        }                                                                    \
+    }                                                                        \
+                                                                             \
