+int qemu_crucible_startup_source_monitor_prefix_admit(
+    uint64_t extent, QemuCrucibleMonitorPurpose **out)
+{
+#if defined(CONFIG_LINUX) && defined(__x86_64__) && !defined(__ILP32__)
+    QemuCrucibleMonitorPurpose *purpose;
+    int status;
+
+    if (!qatomic_load_acquire(&qemu_crucible_selected_process_id)) {
+        return 0;
+    }
+    if (!qatomic_load_acquire(&startup_source.process_purpose_complete) ||
+        getpid() != startup_source.owner_process || !qemu_in_main_thread() ||
+        !bql_locked()) {
+        return -EPERM;
+    }
+    status = qemu_crucible_preexec_purpose_check_v3(
+        startup_source.preexec_purpose_owner);
+    if (status) {
+        return startup_failure(status);
+    }
+    purpose = &startup_source.monitor_purpose;
+    if (purpose->attempted) {
+        return -EALREADY;
+    }
+    if (!extent || !out) {
+        return -EINVAL;
+    }
+    status = crucible_metadata_native_admit(&startup_source.metadata_partition,
+                                           extent, &purpose->fixed_charge);
+    if (status) {
+        return startup_failure(status);
+    }
+    purpose->process_id = startup_source.owner_process;
+    purpose->process_generation = startup_source.original.process_generation;
+    purpose->attempted = true;
+    /* Debit is retained before the independent original post. A failed post
+     * cannot publish a holder, refund it or permit a second constructor. */
+    status = qemu_crucible_preexec_purpose_check_v3(
+        startup_source.preexec_purpose_owner);
+    if (status) {
+        purpose->construction_uncertain = true;
+        crucible_metadata_partition_record_post(
+            &startup_source.metadata_partition, status);
+        return startup_failure(status);
+    }
+    purpose->construction_open = true;
+    *out = purpose;
+    return 0;
+#else
+    return qatomic_load_acquire(&qemu_crucible_selected_process_id) ?
+        -ENOTSUP : 0;
+#endif
+}
+
+int qemu_crucible_startup_source_monitor_prefix_birth(
+    Monitor *allocation, QemuCrucibleMonitorPurpose **out)
+{
+    QemuCrucibleMonitorPurpose *purpose;
+
+    if (!qatomic_load_acquire(&qemu_crucible_selected_process_id)) {
+        return 0;
+    }
+    if (!qatomic_load_acquire(&startup_source.process_purpose_complete) ||
+        getpid() != startup_source.owner_process || !qemu_in_main_thread() ||
+        !bql_locked()) {
+        return -EPERM;
+    }
+    purpose = &startup_source.monitor_purpose;
+    if (!purpose->attempted || !purpose->construction_open || purpose->bound ||
+        !purpose->fixed_charge.held || purpose->construction_uncertain ||
+        purpose->process_id != getpid() || !allocation || !out ||
+        strcmp(object_get_typename(OBJECT(allocation)), "monitor-qmp")) {
+        return -EPERM;
+    }
+    /* Called by the actual parent initializer before parser setup or handler
+     * publication. The completed-allocation reference is taken outside every
+     * Monitor lock. It does not exclude frontend or connection writers. */
+    object_ref(OBJECT(allocation));
+    purpose->allocation = allocation;
+    purpose->bound = true;
+    purpose->construction_open = false;
+    *out = purpose;
+    return 0;
+}
+
+void qemu_crucible_startup_source_monitor_prefix_failed(
+    QemuCrucibleMonitorPurpose *purpose)
+{
+    if (qatomic_load_acquire(&startup_source.process_purpose_complete) &&
+        getpid() == startup_source.owner_process && qemu_in_main_thread() &&
+        bql_locked() && purpose == &startup_source.monitor_purpose &&
+        purpose->attempted) {
+        /* No object reference or requested-body charge is retired from an
+         * ambiguous constructor/finalizer result. Parent containment remains
+         * responsible for actual process retirement. */
+        purpose->construction_uncertain = true;
+    }
+}
