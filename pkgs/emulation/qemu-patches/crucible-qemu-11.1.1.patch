+static void test_publisher_observation(void)
+{
+    PreexecPublisherSessionJournal session = { 0 };
+    PreexecPublisherObservationJournal other = { 0 };
+    QemuCruciblePublisherPurpose saved = preexec_setup_owner.plan.subscription;
+    static const size_t offsets[] = { 0, 256, 1800, 2304 };
+    static const size_t widths[] = { 256, 1536, 504, 512 };
+    uint8_t *wire;
+    size_t offset;
+    size_t bytes;
+    int descriptor;
+
+    descriptor = memfd_create("publisher-reader-leaves", MFD_CLOEXEC);
+    g_assert_cmpint(descriptor, >=, 0);
+    g_assert_cmpint(ftruncate(descriptor, 4096), ==, 0);
+    wire = mmap(NULL, 4096, PROT_READ | PROT_WRITE, MAP_SHARED, descriptor, 0);
+    g_assert_true(wire != MAP_FAILED);
+    fixture_observation_bytes(wire);
+    session.mapping.address = (uint64_t *)wire;
+    session.mapping.requested_bytes = 4096;
+    preexec_setup_owner.plan.subscription.lender_generation = 3;
+    preexec_setup_owner.plan.subscription.account_generation = 4;
+    preexec_setup_owner.plan.subscription.process_generation = 5;
+    memset(preexec_setup_owner.plan.subscription.capability, 0x11, 32);
+    memset(preexec_setup_owner.plan.subscription.reservation, 0x22, 32);
+
+    /* Positive leaves do not authenticate this local journal. The actual
+     * canonical paid-parent cut refuses before any observation child exists. */
+    g_assert_cmpint(preexec_publisher_observation_parent(&session), ==, -ESTALE);
+    g_assert_cmpint(preexec_publisher_observation_take(
+        &preexec_setup_owner.publisher_storage.session,
+        PREEXEC_PUBLISHER_OBSERVE_HEADER), ==, -ESTALE);
+    g_assert_false(preexec_setup_owner.publisher_storage.session.observation.held);
+
+    for (unsigned kind = 0; kind < 4; kind++) {
+        session.observation.kind = kind;
+        g_assert_cmpint(preexec_publisher_observation_geometry(&session, &offset, &bytes), ==, 0);
+        g_assert_cmpuint(offset, ==, offsets[kind]);
+        g_assert_cmpuint(bytes, ==, widths[kind]);
+        g_assert_cmpint(preexec_publisher_observation_copy(&session, offset, bytes), ==, 0);
+        g_assert_cmpmem(session.snapshot, bytes, wire + offset, bytes);
+        g_assert_cmpint(preexec_publisher_observation_decode(&session, bytes), ==, 0);
+        g_assert_cmpint(preexec_publisher_observation_final(&session, offset), ==, 0);
+        if (kind == PREEXEC_PUBLISHER_OBSERVE_HEADER) {
+            wire[112] ^= 1;
+            g_assert_cmpint(preexec_publisher_observation_final(&session, offset), ==, -ESTALE);
+            wire[112] ^= 1;
+            wire[4095] = 1;
+            g_assert_cmpint(preexec_publisher_observation_copy(&session, offset, bytes), ==, -EPROTO);
+            g_assert_cmpint(preexec_publisher_observation_final(&session, offset), ==, -EPROTO);
+            wire[4095] = 0;
+        } else {
+            fixture_be64(wire + offset, 4);
+            g_assert_cmpint(preexec_publisher_observation_final(&session, offset), ==, -ESTALE);
+            fixture_be64(wire + offset, 0);
+            session.snapshot[1] = UINT64_MAX;
+            g_assert_cmpint(preexec_publisher_observation_copy(&session, offset, bytes), ==, -ENODATA);
+            g_assert_cmpuint(session.snapshot[1], ==, UINT64_MAX);
+            fixture_be64(wire + offset, 3);
+            g_assert_cmpint(preexec_publisher_observation_copy(&session, offset, bytes), ==, -EBUSY);
+            g_assert_cmpuint(session.snapshot[1], ==, UINT64_MAX);
+            fixture_be64(wire + offset, 2);
+            wire[offset + bytes - 1] = 1;
+            g_assert_cmpint(preexec_publisher_observation_copy(&session, offset, bytes), ==, 0);
+            g_assert_cmpint(preexec_publisher_observation_decode(&session, bytes), ==, -EPROTO);
+            wire[offset + bytes - 1] = 0;
+        }
+    }
+    g_assert_cmpuint(preexec_setup_be64(wire + 1792), ==, UINT64_C(0x7777777777777777));
+
+    session.mapping.requested_bytes = 4095;
+    g_assert_cmpint(preexec_publisher_observation_geometry(&session, &offset, &bytes), ==, -EOVERFLOW);
+    session.mapping.requested_bytes = 4096;
+    session.mapping.address = (uint64_t *)(UINTPTR_MAX - 7);
+    g_assert_cmpint(preexec_publisher_observation_geometry(&session, &offset, &bytes), ==, -EOVERFLOW);
+    session.mapping.address = (uint64_t *)&preexec_setup_owner;
+    g_assert_cmpint(preexec_publisher_observation_geometry(&session, &offset, &bytes), ==, -EINVAL);
+    session.mapping.address = (uint64_t *)(wire + 1);
+    g_assert_cmpint(preexec_publisher_observation_geometry(&session, &offset, &bytes), ==, -ENOTSUP);
+    session.mapping.address = (uint64_t *)wire;
+    session.observation.kind = 4;
+    g_assert_cmpint(preexec_publisher_observation_geometry(&session, &offset, &bytes), ==, -EINVAL);
+
+    g_assert_false(preexec_publisher_observation_busy(&session));
+    session.observation_holder = &session.observation;
+    g_assert_cmpint(preexec_publisher_observation_busy(&session), ==, true);
+    session.observation_holder = NULL;
+    session.observation.held = true;
+    g_assert_cmpint(preexec_publisher_observation_busy(&session), ==, true);
+    session.observation.held = false;
+    session.snapshot_busy = true;
+    g_assert_cmpint(preexec_publisher_observation_busy(&session), ==, true);
+    session.observation_holder = &session.observation;
+    session.observation.held = true;
+    session.observation.entered = true;
+    session.observation.first_status = -EIO;
+    session.observation.post_status = -ECANCELED;
+    g_assert_cmpint(preexec_publisher_observation_return(&session, 0), ==, -EBUSY);
+    g_assert_true(session.observation.held && session.snapshot_busy);
+    session.observation.read_returned = true;
+    g_assert_cmpint(preexec_publisher_observation_return(&session, -ESTALE), ==, -ESTALE);
+    g_assert_true(session.observation.held && session.snapshot_busy);
+    g_assert_cmpint(preexec_publisher_observation_return(&session, 0), ==, 0);
+    g_assert_cmpint(session.observation.physically_returned, ==, true);
+    g_assert_cmpint(session.observation.held || session.snapshot_busy, ==, false);
+    g_assert_cmpint(session.observation_holder == NULL, ==, true);
+    g_assert_cmpint(session.observation.first_status, ==, -EIO);
+    g_assert_cmpint(session.observation.post_status, ==, -ECANCELED);
+    g_assert_cmpint(preexec_publisher_observation_return(&session, 0), ==, 0);
+    session.observation_holder = &other;
+    g_assert_cmpint(preexec_publisher_observation_return(&session, 0), ==, -ESTALE);
+    g_assert_true(session.observation_holder == &other);
+
+    preexec_setup_owner.plan.subscription = saved;
+    g_assert_cmpint(munmap(wire, 4096), ==, 0);
+    g_assert_cmpint(close(descriptor), ==, 0);
+}
