+        "omit-held-debt": ("!child->held &&", "true &&"),
+        "omit-uncertain-debt": ("!child->uncertain &&", "true &&"),
+        "omit-observation-debt": ("!child->observing &&", "true &&"),
+        "omit-holder-epoch-disjoint": ("!callback_child_output_overlap(holder, sizeof(*holder), epoch, sizeof(*epoch))", "true"),
+        "omit-observation-holder-disjoint": ("!callback_child_output_overlap(observation, sizeof(*observation), holder, sizeof(*holder))", "true"),
