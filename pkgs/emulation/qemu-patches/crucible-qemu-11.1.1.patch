index 0000000000000000000000000000000000000000..b9245fea176bf605f689e36fa7395133b47509b4
--- /dev/null
+++ b/hw/ide/ich-fingerprint.h
@@ -0,0 +1,139 @@
+/*
+ * ICH9 AHCI fingerprint projection internals
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+#ifndef HW_IDE_ICH_FINGERPRINT_H
+#define HW_IDE_ICH_FINGERPRINT_H
+
+#include "ahci-internal.h"
+#include "migration/qemu-file.h"
+#include "qapi/error.h"
+
+static inline bool ich9_ahci_state_fingerprint_validate(
+    const AHCIState *ahci, Error **errp)
+{
+    if (ahci->ports == 0 || ahci->ports > AHCI_MAX_PORTS || !ahci->dev) {
+        error_setg(errp, "ICH9 AHCI fingerprint has invalid port geometry");
+        return false;
+    }
+
+    for (uint32_t port_index = 0; port_index < ahci->ports; port_index++) {
+        const AHCIDevice *port = &ahci->dev[port_index];
+        const IDEBus *bus = &port->port;
+
+        if (port->port_no != port_index || bus->max_units <= 0 ||
+            bus->max_units > MAX_IDE_DEVS) {
+            error_setg(errp, "ICH9 AHCI fingerprint port identity mismatch");
+            return false;
+        }
+        for (size_t unit = 0; unit < bus->max_units; unit++) {
+            const IDEState *ide = &bus->ifs[unit];
+
+            if (ide->blk) {
+                error_setg(errp,
+                           "ICH9 AHCI fingerprint does not admit IDE media");
+                return false;
+            }
+        }
+        for (size_t slot = 0; slot < AHCI_MAX_CMDS; slot++) {
+            const NCQTransferState *ncq = &port->ncq_tfs[slot];
+            bool live = ncq->used || ncq->halt;
+
+            if (ncq->used != ncq->halt ||
+                (live && (ncq->slot != slot || ncq->tag != slot))) {
+                error_setg(errp,
+                           "ICH9 AHCI fingerprint has invalid NCQ state");
+                return false;
+            }
+            if (live) {
+                error_setg(errp,
+                           "ICH9 AHCI fingerprint does not admit live NCQ "
+                           "without an IDE backend continuation");
+                return false;
+            }
+        }
+    }
+    return true;
+}
+
+static inline void ich9_ahci_state_fingerprint_put(QEMUFile *f,
+                                                    const AHCIState *ahci)
