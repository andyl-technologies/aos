+
+void qemu_plugin_time_advance_settle_at_rr_idle(void)
+{
+    int64_t target = qatomic_read(&qemu_plugin_time_advance_target);
+
+    g_assert(bql_locked());
+    g_assert(first_cpu && qemu_cpu_is_self(first_cpu));
+    g_assert(qatomic_cmpxchg(&qemu_plugin_time_advance_timer_state,
+                            QEMU_PLUGIN_TIME_ADVANCE_TIMERS_SETTLE_READY,
+                            QEMU_PLUGIN_TIME_ADVANCE_TIMERS_COMPLETING) ==
+             QEMU_PLUGIN_TIME_ADVANCE_TIMERS_SETTLE_READY);
+    /*
+     * RR calls this hook only after consuming the kick published after the
+     * completion callback and its wake notifiers. That boundary drains their
+     * queued CPU work and establishes the idle state required by the durable
+     * completion wake below.
+     *
+     * Keep the RR-thread barrier armed until the plugin has committed its
+     * logical-time state and RR has drained every completion effect.  The
+     * callback can release-publish reached icount without BQL, so clearing
+     * earlier would let a raced host advance classify RR as settled while
+     * notifier work remained queued on a vCPU.
+     */
+    if (rr_crucible_sim_control_boundary_needs_rearm(
+            qatomic_load_acquire(
+                &qemu_plugin_rr_control_request_generation),
+            qatomic_load_acquire(&qemu_plugin_rr_control_ack_generation),
+            qatomic_load_acquire(&qemu_plugin_rr_control_complete_generation),
+            qatomic_load_acquire(
+                &qemu_plugin_control_boundary_scheduled) != 0)) {
+        /* Restore the token relinquished while this advance was pending. */
+        qemu_plugin_schedule_control_boundary();
+    }
+    /*
+     * The host requests the BQL-held control boundary after it observes the
+     * completed quantum. Publish this completion's durable RR wake before its
+     * trace while the BQL prevents RR from consuming it. The wake publisher
+     * also consumes the pending RR owner selection so the trace and fingerprint
+     * observe the runnable owner. Keep the time-advance fence armed through
+     * both publications so the RR thread cannot leave the all-halted path.
+     */
+    rr_crucible_sim_publish_time_advance_wake();
+    rr_crucible_sim_trace_idle_advance("complete", target);
+    qatomic_store_release(&qemu_plugin_time_advance_timer_state,
+                          QEMU_PLUGIN_TIME_ADVANCE_TIMERS_NOT_READY);
+    qatomic_store_release(&qemu_plugin_time_advance_pending, 0);
+    rr_crucible_sim_signal_time_advance_wake();
+}
