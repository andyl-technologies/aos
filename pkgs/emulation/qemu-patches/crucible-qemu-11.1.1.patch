+/* No PLT/libc/TLS/allocator entry is called by these source bodies. Configured
+ * compiler output and preinit/INITFIRST/earlier loader effects remain required
+ * artifact proofs, not consequences of this source-level syscall boundary.
+ */
+static long preexec_setup_syscall5(long number, long first, long second,
+                                  long third, long fourth, long fifth)
+{
+    register long argument4 __asm__("r10") = fourth;
+    register long argument5 __asm__("r8") = fifth;
+    long result;
+
+    __asm__ volatile("syscall"
+                     : "=a"(result)
+                     : "0"(number), "D"(first), "S"(second), "d"(third),
+                       "r"(argument4), "r"(argument5)
+                     : "rcx", "r11", "memory");
+    return result;
+}
+
+static long preexec_setup_syscall6(long number, long first, long second,
+                                  long third, long fourth, long fifth, long sixth)
+{
+    register long argument4 __asm__("r10") = fourth;
+    register long argument5 __asm__("r8") = fifth;
+    register long argument6 __asm__("r9") = sixth;
+    long result;
+
+    __asm__ volatile("syscall"
+                     : "=a"(result)
+                     : "0"(number), "D"(first), "S"(second), "d"(third),
+                       "r"(argument4), "r"(argument5), "r"(argument6)
+                     : "rcx", "r11", "memory");
+    return result;
+}
