+static bool crucible_restore_exact_paused_boundary(void)
+{
+    return bql_locked() && runstate_check(RUN_STATE_PAUSED) && tcg_enabled() &&
+        icount_enabled() == ICOUNT_PRECISE &&
+        qemu_plugin_crucible_single_threaded_rr() == 1 &&
+        qemu_plugin_crucible_vmstop_pending() &&
+        qemu_plugin_crucible_vmstop_quiesced() &&
+        !qemu_plugin_crucible_vmstop_admission_pending() &&
+        qemu_plugin_crucible_vmstop_flush_status() == 0;
+}
+
+static bool crucible_restore_cancelled(int fd, Error **errp)
+{
+    struct pollfd poll_fd = { .fd = fd, .events = POLLIN };
+    int status;
+
+    do {
+        status = poll(&poll_fd, 1, 0);
+    } while (status < 0 && errno == EINTR);
+    if (status < 0) {
+        error_setg_errno(errp, errno,
+                         "Could not poll Crucible checkpoint restore cancellation");
+        return true;
+    }
+    if (status == 0) {
+        return false;
+    }
+    if (poll_fd.revents & POLLIN) {
+        error_setg(errp, "Crucible checkpoint restore was cancelled");
+    } else {
+        error_setg(errp, "Crucible checkpoint restore cancellation descriptor failed");
+    }
+    return true;
+}
+
+static bool crucible_restore_read(int fd, uint64_t file_bytes,
+                                  uint64_t offset, void *buffer,
+                                  size_t length, int cancellation_fd,
+                                  Error **errp)
+{
+    uint8_t *cursor = buffer;
+
+    if (offset > file_bytes || length > file_bytes - offset) {
+        error_setg(errp, "Truncated Crucible checkpoint restore input");
+        return false;
+    }
+    while (length != 0) {
+        ssize_t bytes;
+
+        if (crucible_restore_cancelled(cancellation_fd, errp)) {
+            return false;
+        }
+        do {
+            bytes = pread(fd, cursor, length, offset);
+        } while (bytes < 0 && errno == EINTR);
+        if (bytes <= 0) {
+            error_setg_errno(errp, bytes == 0 ? EIO : errno,
+                             "Could not read Crucible checkpoint restore input");
+            return false;
+        }
+        cursor += bytes;
+        offset += bytes;
+        length -= bytes;
+    }
+    return true;
+}
+
+static bool crucible_restore_hex_bytes(const char *encoded, uint8_t *output,
+                                       size_t length, const char *description,
+                                       Error **errp)
+{
+    if (!encoded || strlen(encoded) != length * 2) {
+        error_setg(errp, "Crucible restore %s has an invalid hexadecimal length",
+                   description);
+        return false;
+    }
+    for (size_t index = 0; index < length; index++) {
+        int high = g_ascii_xdigit_value(encoded[index * 2]);
+        int low = g_ascii_xdigit_value(encoded[index * 2 + 1]);
+
+        if (high < 0 || low < 0 || g_ascii_isupper(encoded[index * 2]) ||
+            g_ascii_isupper(encoded[index * 2 + 1])) {
+            error_setg(errp, "Crucible restore %s requires lowercase hexadecimal",
+                       description);
+            return false;
+        }
+        output[index] = (high << 4) | low;
+    }
+    return true;
+}
+
+static bool crucible_restore_hex(const char *encoded, uint8_t digest[32],
+                                 const char *description, Error **errp)
+{
+    return crucible_restore_hex_bytes(encoded, digest, 32, description, errp);
+}
+
+static bool crucible_restore_regular_input(int fd, uint64_t maximum_bytes,
+                                           uint64_t *bytes_out,
+                                           dev_t *device_out,
+                                           ino_t *inode_out,
+                                           const char *description,
+                                           Error **errp)
+{
+    struct stat stat_buffer;
+    int flags;
+#ifdef F_GET_SEALS
+    int seals;
+#endif
+
+    if (fd < 0 || fstat(fd, &stat_buffer) < 0) {
+        error_setg_errno(errp, errno, "Could not inspect Crucible checkpoint %s",
+                         description);
+        return false;
+    }
+    flags = fcntl(fd, F_GETFL);
+    if (!S_ISREG(stat_buffer.st_mode) || flags < 0 ||
+        (flags & O_ACCMODE) == O_WRONLY || stat_buffer.st_size <= 0 ||
+        maximum_bytes == 0 || maximum_bytes > INT64_MAX ||
+        stat_buffer.st_size > maximum_bytes) {
+        error_setg(errp, "Crucible checkpoint %s must be a nonempty bounded "
+                   "readable regular file", description);
+        return false;
+    }
+#ifdef F_GET_SEALS
+    seals = fcntl(fd, F_GET_SEALS);
+    if (seals < 0 ||
+        (seals & (F_SEAL_SEAL | F_SEAL_SHRINK | F_SEAL_GROW |
+                  F_SEAL_WRITE)) !=
+            (F_SEAL_SEAL | F_SEAL_SHRINK | F_SEAL_GROW | F_SEAL_WRITE)) {
+        error_setg(errp, "Crucible checkpoint %s must be an immutable sealed file",
+                   description);
+        return false;
+    }
+#else
+    error_setg(errp, "Crucible checkpoint immutable restore inputs are "
+               "unsupported on this host");
+    return false;
+#endif
+    *bytes_out = stat_buffer.st_size;
+    *device_out = stat_buffer.st_dev;
+    *inode_out = stat_buffer.st_ino;
+    return true;
+}
+
+static bool crucible_restore_authenticate(int fd, uint64_t bytes,
+                                          const char *expected_sha256,
+                                          int cancellation_fd,
+                                          Error **errp)
+{
+    g_autofree uint8_t *buffer = g_malloc(CRUCIBLE_RESTORE_HASH_BUFFER_BYTES);
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    uint8_t expected[32];
+    uint8_t observed[32];
+    gsize observed_length = sizeof(observed);
+    uint64_t offset = 0;
+
+    if (!checksum ||
+        !crucible_restore_hex(expected_sha256, expected, "content digest", errp)) {
+        return false;
+    }
+    while (offset < bytes) {
+        size_t chunk = MIN(bytes - offset,
+                           CRUCIBLE_RESTORE_HASH_BUFFER_BYTES);
+
+        if (!crucible_restore_read(fd, bytes, offset, buffer, chunk,
+                                   cancellation_fd, errp)) {
+            return false;
+        }
+        g_checksum_update(checksum, buffer, chunk);
+        offset += chunk;
+    }
+    g_checksum_get_digest(checksum, observed, &observed_length);
+    if (observed_length != sizeof(observed) ||
+        memcmp(expected, observed, sizeof(observed)) != 0) {
+        error_setg(errp, "Crucible checkpoint restore content digest mismatch");
+        return false;
+    }
+    return true;
+}
+
+static int crucible_restore_device_state(int fd, Error **errp)
+{
+    QIOChannelFile *channel;
+    QEMUFile *file;
+    int status;
+    int close_status;
+
+    if (lseek(fd, 0, SEEK_SET) < 0) {
+        status = -errno;
+        error_setg_errno(errp, errno,
+                         "Could not rewind Crucible checkpoint device VMState");
+        close(fd);
+        return status;
+    }
+    channel = qio_channel_file_new_fd(fd);
+    file = qemu_file_new_input(QIO_CHANNEL(channel));
+    object_unref(OBJECT(channel));
+    if (qemu_get_be32(file) != QEMU_VM_FILE_MAGIC ||
+        qemu_get_be32(file) != QEMU_VM_FILE_VERSION) {
+        status = -EINVAL;
+        error_setg(errp, "Invalid Crucible checkpoint device VMState header");
+    } else {
+        status = qemu_load_device_state(file, errp);
+    }
+    if (status == 0) {
+        status = qemu_file_get_error_obj(file, errp);
+    }
+    close_status = qemu_fclose(file);
+    if (status == 0 && close_status < 0) {
+        status = close_status;
+    }
+    if (status != 0 && !*errp) {
+        error_setg_errno(errp, status < 0 ? -status : EIO,
+                         "Could not restore Crucible checkpoint device VMState");
+    }
+    return status;
+}
