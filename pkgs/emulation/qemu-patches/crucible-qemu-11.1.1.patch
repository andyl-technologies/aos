+#endif
+}
+
+int qemu_crucible_startup_source_callback_child_owner_identity_v1(
+    QemuCrucibleCallbackChildOwner *owner)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    qemu_plugin_id_t id;
+    int status = callback_registry_identity(&id);
+
+    if (status) {
+        return status;
+    }
+    qemu_mutex_lock(&commands->mutex);
+    /* Closing does not consume the canonical child or Bridge field. Native
+     * terminal calls this outside its mutex after revoke, while payload and
+     * nominal fields are still retained. It lends no fresh entry or time. */
+    status = callback_child_owner_identity_locked(owner);
+    qemu_mutex_unlock(&commands->mutex);
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_crucible_startup_source_callback_registration_current_v1(
+    QemuCrucibleCallbackRegistrationBorrow *borrow, uint64_t serial,
+    QemuCrucibleCallbackPublicationFamily family)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    qemu_plugin_id_t id;
+    int status = callback_registry_identity(&id);
+
+    if (status || !startup_invocation(id) || startup_source.install_returned) {
+        return status ? status : -EPERM;
+    }
+    status = startup_process_purpose_live();
+    if (status) {
+        qemu_mutex_lock(&commands->mutex);
+        if (!callback_registrar_identity_locked(borrow, serial)) {
+            callback_publication_record_refusal_locked(
+                borrow->publication, borrow->publication_serial, status, 0);
+        }
+        qemu_mutex_unlock(&commands->mutex);
+        return status;
+    }
+    qemu_mutex_lock(&commands->mutex);
+    status = callback_registrar_identity_locked(borrow, serial);
+    if (!status && (borrow->family != family || !borrow->publication->current ||
+                    borrow->publication->post_status || borrow->owner->closing ||
+                    borrow->owner->child->callback_closing || borrow->owner->child->closing)) {
+        status = -ESTALE;
+    }
+    qemu_mutex_unlock(&commands->mutex);
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_crucible_startup_source_callback_registration_observe_v1(
+    QemuCrucibleCallbackRegistrationBorrow *borrow, uint64_t serial,
+    QemuCrucibleCallbackPublicationView *out)
+{
+#ifdef CONFIG_LINUX
