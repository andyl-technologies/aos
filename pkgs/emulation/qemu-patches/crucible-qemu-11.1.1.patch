+static void pic_crucible_interrupt_inject(
+    const QemuCrucibleInterruptEvent *event, void *opaque)
+{
+    PICCommonState *pic = isa_pic;
+    int irq;
+
+    (void)opaque;
+
+    if (event->controller_source < 16) {
+        pic = event->controller_source < 8 ? isa_pic : slave_pic;
+        irq = event->controller_source & 7;
+    } else {
+        irq = event->vector & 15;
+        pic = irq < 8 ? isa_pic : slave_pic;
+        irq &= 7;
+    }
+    if (!(pic->irr & (1U << irq)) || !event->retain_pending) {
+        pic->crucible_interrupt_family[irq] = event->family;
+        pic->crucible_interrupt_source_sequence[irq] = event->source_sequence;
+        pic->crucible_interrupt_routing_generation[irq] =
+            event->routing_generation;
+        pic->crucible_interrupt_vector[irq] = event->vector;
+        pic->crucible_interrupt_vector_valid |= 1U << irq;
+    }
+    pic->irr |= 1U << irq;
+    pic_update_irq(pic);
+}
