+static inline bool crucible_register_workspace_equal(
+    const QemuCrucibleRegisterWorkspaceLayout *left,
+    const QemuCrucibleRegisterWorkspaceLayout *right)
+{
+    if (!left || !right ||
+        !crucible_register_geometry_equal(&left->geometry, &right->geometry) ||
+        left->cpu_count != right->cpu_count ||
+        left->model_bytes != right->model_bytes ||
+        left->page_bytes != right->page_bytes ||
+        left->payload_bytes != right->payload_bytes ||
+        left->backing_bytes != right->backing_bytes) {
+        return false;
+    }
+    for (size_t part = 0; part < CRUCIBLE_REGISTER_WORKSPACE_PART_COUNT; part++) {
+        if (left->part[part].offset != right->part[part].offset ||
+            left->part[part].bytes != right->part[part].bytes ||
+            left->part[part].alignment != right->part[part].alignment) {
+            return false;
+        }
+    }
+    return true;
+}
