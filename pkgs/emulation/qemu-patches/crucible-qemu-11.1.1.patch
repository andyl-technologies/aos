+static int standing_original_observe(
+    qemu_plugin_crucible_fingerprint_operation_v1 *operation,
+    struct qemu_plugin_crucible_fingerprint_original_v1 *out)
+{
+    struct qemu_plugin_crucible_fingerprint_original_v1 observed;
+    const QemuCrucibleStandingRecord *current = &startup_source.standing.current;
+    const QemuCrucibleStandingRecord *admitted;
+    const QemuCrucibleStandingBudget *budget;
+    uint64_t now;
+    uint64_t slice;
+    int status;
+
+    if (!out || !standing_operation_identity(operation) || !operation->module_borrowed ||
+        operation->post_recorded) {
+        return -EPERM;
+    }
+    status = standing_operation_current(operation);
+    if (status) {
+        return status;
+    }
+    now = operation->last_now_ns;
+    admitted = &operation->admitted;
+    budget = &admitted->budgets[operation->class_index];
+    slice = MIN(budget->poll_ns, current->budgets[operation->class_index].poll_ns);
+    standing_slice_budget(now - operation->start_ns, budget->total_present,
+                          budget->total_ns, &slice);
+    standing_slice_budget(now - operation->progress_ns, budget->progress_present,
+                          budget->progress_ns, &slice);
+    budget = &current->budgets[operation->class_index];
+    standing_slice_budget(now - operation->start_ns, budget->total_present,
+                          budget->total_ns, &slice);
+    standing_slice_budget(now - operation->progress_ns, budget->progress_present,
+                          budget->progress_ns, &slice);
+    standing_slice_budget(now - admitted->origin_ns, admitted->outer_allowance_present,
+                          admitted->outer_allowance_ns, &slice);
+    standing_slice_budget(now - current->origin_ns, current->outer_allowance_present,
+                          current->outer_allowance_ns, &slice);
+    if (operation->action_original) {
+        uint64_t action_slice;
+
+        status = action_original_frozen_slice(operation->action_original, now, &action_slice);
+        if (status) {
+            return status;
+        }
+        slice = MIN(slice, action_slice);
+    }
+    if (!slice) {
+        return -ETIMEDOUT;
+    }
+    observed = (struct qemu_plugin_crucible_fingerprint_original_v1) {
+        .supervisor_origin_ns = admitted->origin_ns,
+        .operation_serial = operation->serial,
+        .operation_start_ns = operation->start_ns,
+        .progress_start_ns = operation->progress_ns,
+        .bounded_ns = slice,
+        .class_index = operation->class_index,
+    };
+    memcpy(observed.supervisor_capability, admitted->supervisor_capability, 32);
+    if (operation->action_original) {
+        const QemuCrucibleProducingActionRow *row =
+            &operation->action_original->cohort.rows[0];
+
+        observed.supervisor_origin_ns = row->original_origin_ns;
+        observed.operation_serial = row->operation;
+        memcpy(observed.supervisor_capability, row->lender_capability, 32);
+    }
+    *out = observed;
+    return 0;
+}
