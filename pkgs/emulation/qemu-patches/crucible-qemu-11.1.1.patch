+static bool virtio_net_rsc_validate_seg(VirtioNetRscChain *chain,
+                                        VirtioNetRscSeg *seg,
+                                        size_t guest_hdr_len,
+                                        bool rebuild_unit,
+                                        Error **errp)
+{
+    VirtIONet *n = chain->n;
+    size_t network_offset = guest_hdr_len + sizeof(struct eth_header);
+    size_t max_size = guest_hdr_len + sizeof(struct eth_header) +
+                      sizeof(struct ip6_header) +
+                      VIRTIO_NET_MAX_TCP_PAYLOAD;
+    size_t ip_length;
+    size_t ip_header_length;
+    size_t tcp_header_length;
+    uint8_t *ip;
+
+    if (!seg->nc || seg->nc->queue_index >= n->max_ncs ||
+        qemu_get_subqueue(n->nic, seg->nc->queue_index) != seg->nc) {
+        error_setg(errp, "virtio-net RSC segment has invalid queue identity");
+        return false;
+    }
+    if (seg->packets == 0 || (seg->packets > 1 && !seg->is_coalesced) ||
+        seg->dup_ack != 0 || seg->size > max_size ||
+        seg->size < network_offset) {
+        error_setg(errp, "virtio-net RSC segment metadata is invalid");
+        return false;
+    }
+
+    ip = (uint8_t *)seg->buf + network_offset;
+    if (chain->proto == ETH_P_IP) {
+        struct ip_header *ip4;
+
+        if (seg->size - network_offset < sizeof(*ip4)) {
+            goto invalid_packet;
+        }
+        ip4 = (struct ip_header *)ip;
+        ip_header_length = (ip4->ip_ver_len & 0xf) * 4;
+        ip_length = ntohs(ip4->ip_len);
+        if ((ip4->ip_ver_len >> 4) != IP_HEADER_VERSION_4 ||
+            ip4->ip_p != IPPROTO_TCP ||
+            ip_header_length != sizeof(*ip4) ||
+            !(ntohs(ip4->ip_off) & IP_DF) || IPTOS_ECN(ip4->ip_tos) ||
+            ip_length < ip_header_length + sizeof(struct tcp_header) ||
+            ip_length > seg->size - network_offset) {
+            goto invalid_packet;
+        }
+    } else if (chain->proto == ETH_P_IPV6) {
+        struct ip6_header *ip6;
+
+        if (seg->size - network_offset < sizeof(*ip6)) {
+            goto invalid_packet;
+        }
+        ip6 = (struct ip6_header *)ip;
+        ip_header_length = sizeof(*ip6);
+        ip_length = ip_header_length +
+                    ntohs(ip6->ip6_ctlun.ip6_un1.ip6_un1_plen);
+        if ((ip[0] >> 4) != IP_HEADER_VERSION_6 ||
+            ip6->ip6_ctlun.ip6_un1.ip6_un1_nxt != IPPROTO_TCP ||
+            IP6_ECN(ip6->ip6_ctlun.ip6_un3.ip6_un3_ecn) ||
+            ip_length < ip_header_length + sizeof(struct tcp_header) ||
+            ip_length > seg->size - network_offset) {
+            goto invalid_packet;
+        }
+    } else {
+        goto invalid_packet;
+    }
+
+    tcp_header_length = (ntohs(((struct tcp_header *)(ip +
+                         ip_header_length))->th_offset_flags) & 0xf000) >> 10;
+    if (tcp_header_length != sizeof(struct tcp_header) ||
+        ip_header_length + tcp_header_length > ip_length) {
+        goto invalid_packet;
+    }
+
+    if (!rebuild_unit) {
+        return true;
+    }
+
+    if (chain->proto == ETH_P_IP) {
+        struct ip_header *ip4 = (void *)ip;
+
+        seg->unit.ip = ip4;
+        seg->unit.ip_plen = &ip4->ip_len;
+    } else {
+        struct ip6_header *ip6 = (void *)ip;
+
+        seg->unit.ip = ip6;
+        seg->unit.ip_plen = &ip6->ip6_ctlun.ip6_un1.ip6_un1_plen;
+    }
+    seg->unit.tcp = (void *)(ip + ip_header_length);
+    seg->unit.tcp_hdrlen = tcp_header_length;
+    seg->unit.payload = ip_length - ip_header_length - tcp_header_length;
+    return true;
+
+invalid_packet:
+    error_setg(errp, "virtio-net RSC segment payload is not canonical TCP");
+    return false;
+}
+
+static bool virtio_net_rsc_save_state(QEMUFile *f, const VirtIONet *n,
+                                      Error **errp)
+{
+    VirtioNetRscChain *chain;
+    unsigned int chain_count = 0;
+    uint8_t protocols = 0;
+    size_t aggregate_size = 0;
+
+    QTAILQ_FOREACH(chain, &n->rsc_chains, next) {
+        chain_count++;
+    }
+    if (chain_count > 2) {
+        error_setg(errp, "virtio-net RSC state has too many chains");
+        return false;
+    }
+    qemu_put_be16(f, n->guest_hdr_len);
+    qemu_put_byte(f, chain_count);
+
+    QTAILQ_FOREACH(chain, &n->rsc_chains, next) {
+        VirtioNetRscSeg *seg;
+        uint32_t segment_count = 0;
+        uint8_t protocol_bit;
+
+        if (chain->proto == ETH_P_IP) {
+            protocol_bit = 1;
+        } else if (chain->proto == ETH_P_IPV6) {
+            protocol_bit = 2;
+        } else {
+            error_setg(errp, "virtio-net RSC state has invalid protocol");
+            return false;
+        }
+        if (protocols & protocol_bit) {
+            error_setg(errp, "virtio-net RSC state has duplicate protocol");
+            return false;
+        }
+        protocols |= protocol_bit;
+
+        QTAILQ_FOREACH(seg, &chain->buffers, next) {
+            if (segment_count == VIRTIO_NET_RSC_MAX_MIGRATION_SEGS ||
+                seg->size > VIRTIO_NET_RSC_MAX_MIGRATION_BYTES -
+                            aggregate_size) {
+                error_setg(errp,
+                           "virtio-net RSC migration payload is too large");
+                return false;
+            }
+            if (!virtio_net_rsc_validate_seg(chain, seg, n->guest_hdr_len,
+                                             false, errp)) {
+                return false;
+            }
+            segment_count++;
+            aggregate_size += seg->size;
+        }
+        if (segment_count && !timer_pending(chain->drain_timer)) {
+            error_setg(errp,
+                       "virtio-net RSC buffered chain has no drain timer");
+            return false;
+        }
+
+        qemu_put_be16(f, chain->proto);
+        if (!vmstate_info_timer_ns_phase.save(f, chain->drain_timer, 0,
+                                              NULL, NULL, errp)) {
+            return false;
+        }
+        qemu_put_be32(f, segment_count);
+        QTAILQ_FOREACH(seg, &chain->buffers, next) {
+            qemu_put_be16(f, seg->nc->queue_index);
+            qemu_put_be32(f, seg->size);
+            qemu_put_be16(f, seg->packets);
+            qemu_put_be16(f, seg->dup_ack);
+            qemu_put_byte(f, seg->is_coalesced);
+            qemu_put_buffer(f, seg->buf, seg->size);
+        }
+    }
+    return qemu_file_get_error(f) == 0;
+}
+
+static bool virtio_net_rsc_load_state(QEMUFile *f, VirtIONet *n,
+                                      Error **errp)
+{
+    uint16_t guest_hdr_len = qemu_get_be16(f);
+    uint8_t chain_count = qemu_get_byte(f);
