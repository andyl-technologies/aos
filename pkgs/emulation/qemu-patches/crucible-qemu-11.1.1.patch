+void qemu_crucible_checkpoint_candidate_io_end_v1(
+    QemuCrucibleCheckpointHeldTransaction *owner, int semantic_status)
+{
+    if (!owner || checkpoint_identity(owner) || !owner->candidate_started) {
+        return;
+    }
+    if (semantic_status < 0) {
