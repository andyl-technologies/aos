+static void test_refusals(void)
+{
+    QemuCrucibleMetadataPartition partition;
+    QemuCrucibleMetadataPartition before;
+    uint64_t requests[4];
+    uint64_t output = UINT64_MAX;
+
+    fixture_issue(&partition);
+    partition.published = false;
+    before = partition;
+    g_assert_cmpint(crucible_metadata_controller_reserve(
+        &partition, fixture_requests, &output), <, 0);
+    g_assert_cmpmem(&partition, sizeof(partition), &before, sizeof(before));
+    g_assert_cmpuint(output, ==, UINT64_MAX);
+
+    fixture_issue(&partition);
+    memcpy(requests, fixture_requests, sizeof(requests));
+    requests[2]++;
+    before = partition;
+    g_assert_cmpint(crucible_metadata_controller_reserve(
+        &partition, requests, &output), ==, -EINVAL);
+    g_assert_cmpmem(&partition, sizeof(partition), &before, sizeof(before));
+    g_assert_cmpuint(output, ==, UINT64_MAX);
+
+    fixture_issue(&partition);
+    partition.total = 151;
+    before = partition;
+    g_assert_cmpint(crucible_metadata_controller_reserve(
+        &partition, fixture_requests, &output), ==, -ENOSPC);
+    g_assert_cmpmem(&partition, sizeof(partition), &before, sizeof(before));
+    g_assert_cmpuint(output, ==, UINT64_MAX);
+
+    fixture_issue(&partition);
+    partition.controller_requests[0] = requests[0] = UINT64_MAX;
+    requests[1] = fixture_requests[1];
+    requests[2] = fixture_requests[2];
+    before = partition;
+    g_assert_cmpint(crucible_metadata_controller_reserve(
