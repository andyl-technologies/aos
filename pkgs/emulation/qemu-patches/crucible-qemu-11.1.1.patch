+{
+    uint8_t encoded[8];
+
+    stq_be_p(encoded, value);
+    g_byte_array_append(bytes, encoded, sizeof(encoded));
+}
+
+void qemu_crucible_fault_vmstate_put_bytes(GByteArray *bytes,
+                                           const void *value, size_t length)
+{
+    g_byte_array_append(bytes, value, length);
+}
+
+bool qemu_crucible_fault_vmstate_get_view(
+    QemuCrucibleFaultVmstateReader *reader, const uint8_t **value,
+    size_t length)
+{
+    if (reader->offset > reader->length ||
+        length > reader->length - reader->offset) {
+        return false;
+    }
+    *value = reader->data + reader->offset;
+    reader->offset += length;
+    return true;
+}
+
+bool qemu_crucible_fault_vmstate_get_bytes(
+    QemuCrucibleFaultVmstateReader *reader, void *value, size_t length)
+{
+    const uint8_t *encoded;
+
+    if (!qemu_crucible_fault_vmstate_get_view(reader, &encoded, length)) {
+        return false;
+    }
+    memcpy(value, encoded, length);
+    return true;
+}
+
+bool qemu_crucible_fault_vmstate_get_u8(
+    QemuCrucibleFaultVmstateReader *reader, uint8_t *value)
+{
+    return qemu_crucible_fault_vmstate_get_bytes(reader, value,
+                                                  sizeof(*value));
+}
+
+bool qemu_crucible_fault_vmstate_get_u16(
+    QemuCrucibleFaultVmstateReader *reader, uint16_t *value)
+{
+    uint8_t encoded[2];
+
+    if (!qemu_crucible_fault_vmstate_get_bytes(reader, encoded,
+                                                sizeof(encoded))) {
+        return false;
+    }
+    *value = lduw_be_p(encoded);
+    return true;
+}
+
+bool qemu_crucible_fault_vmstate_get_u32(
+    QemuCrucibleFaultVmstateReader *reader, uint32_t *value)
+{
+    uint8_t encoded[4];
+
+    if (!qemu_crucible_fault_vmstate_get_bytes(reader, encoded,
