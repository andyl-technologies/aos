+const char *qemu_rcu_hot_fork_transaction_blocker(void)
+{
+    return qemu_rcu_hot_fork_blocker;
+}
+
+static int qemu_rcu_hot_fork_begin_transaction_common(
+    QemuRcuHotForkTransaction *transaction,
+    bool retain_parent_barrier, uint64_t expected_barrier_generation)
+{
+    QemuRcuHotForkBarrierInventory inventory;
+    struct rcu_reader_data *reader = get_ptr_rcu_reader();
+    int64_t thread_id = qemu_get_thread_id();
+    bool registered;
+
+    if (!transaction || transaction->active || transaction->child_prepared ||
+        transaction->child_reconstructed || transaction->coordinator_reader ||
+        getpid() <= 1 || thread_id <= 0 ||
+        qatomic_cmpxchg(&rcu_hot_fork_transaction_active, 0, 1) != 0) {
+        return -EINVAL;
+    }
+
+    /* Close owner reporting reads before testing the retained RCU proof. */
+    smp_mb_global();
+    qemu_rcu_hot_fork_barrier(
+        retain_parent_barrier ? QEMU_RCU_HOT_FORK_BARRIER_QUERY :
+                                QEMU_RCU_HOT_FORK_BARRIER_HOLD,
+        &inventory);
+    if (!inventory.held || !inventory.quiescent ||
+        inventory.owner_thread_id <= 0 ||
+        (retain_parent_barrier &&
+         inventory.generation != expected_barrier_generation) ||
+        (!retain_parent_barrier &&
+         inventory.owner_thread_id != thread_id)) {
+        if (!retain_parent_barrier && inventory.held &&
+            inventory.owner_thread_id == thread_id) {
+            qemu_rcu_hot_fork_barrier(QEMU_RCU_HOT_FORK_BARRIER_RELEASE,
+                                      &inventory);
+        }
+        qatomic_set(&rcu_hot_fork_transaction_active, 0);
+        qemu_rcu_hot_fork_blocker =
+            "RCU barrier is not retained and quiescent for this generation";
+        return -EBUSY;
+    }
+
+    qemu_mutex_lock(&rcu_registry_lock);
+    registered = qemu_rcu_hot_fork_reader_is_registered(reader);
+    if (!registered || reader->thread_id != thread_id || reader->depth != 0 ||
+        qatomic_read(&reader->ctr) != 0 ||
+        rcu_hot_fork_generation == UINT64_MAX) {
+        qemu_mutex_unlock(&rcu_registry_lock);
+        if (!retain_parent_barrier) {
+            qemu_rcu_hot_fork_barrier(QEMU_RCU_HOT_FORK_BARRIER_RELEASE,
+                                      &inventory);
+        }
+        qatomic_set(&rcu_hot_fork_transaction_active, 0);
+        qemu_rcu_hot_fork_blocker =
+            "coordinator RCU reader is not registered and idle";
+        return -EBUSY;
+    }
+
+    *transaction = (QemuRcuHotForkTransaction) {
+        .reader_generation = rcu_hot_fork_generation,
+        .barrier_generation = inventory.generation,
+        .barrier_owner_thread_id = inventory.owner_thread_id,
+        .parent_process_id = getpid(),
+        .parent_thread_id = thread_id,
+        .coordinator_reader = reader,
+        .active = true,
+        .parent_barrier_retained = retain_parent_barrier,
+    };
+    qemu_mutex_unlock(&rcu_registry_lock);
+    rcu_disable_atfork();
+    return 0;
+}
