+void qmp_stop(Error **errp)
+{
+    int status;
+
+    /* if there is a dump in background, we should wait until the dump
+     * finished */
+    if (qemu_system_dump_in_progress()) {
+        error_setg(errp, "There is a dump in process, please wait.");
+        return;
+    }
+
+    if (runstate_check(RUN_STATE_INMIGRATE)) {
+        autostart = 0;
+    } else {
+#ifdef CONFIG_PLUGIN
+        bool selected = false;
+        bool already_stopped = false;
+
+        status = qemu_crucible_checkpoint_stop_intent_main_v1(
+            &selected, &already_stopped);
+        if (!status && selected && !already_stopped) {
+            status = qemu_plugin_crucible_vmstop_qmp_admit_v1();
+        }
+        if (status) {
+            error_setg_errno(errp, -status,
+                             "Ordinary stop intent or admission is unavailable");
+            return;
+        }
+        if (selected && already_stopped) {
+            return;
+        }
+#endif
+        status = vm_stop(RUN_STATE_PAUSED);
+        if (status == 0) {
+            status = qemu_plugin_crucible_vmstop_flush_status();
+        }
+#ifdef CONFIG_PLUGIN
+        if (!status && selected) {
+            status = qemu_crucible_checkpoint_stop_result_v1();
+        }
+#endif
+        if (status < 0) {
+            error_setg_errno(errp, -status,
+                             "Could not flush devices while stopping the VM");
+        }
+    }
+}
