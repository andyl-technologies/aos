+} QemuCrucibleDeferredMemoryService;
+
+/*
+ * Queues exclusive TB invalidation before further guest execution. Main-loop
+ * callers wait for physical completion; vCPU callers leave their run loop first.
+ */
+bool qemu_crucible_fault_flush_translation(void);
+
