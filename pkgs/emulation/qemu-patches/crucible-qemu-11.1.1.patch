+        binding->invocation.held || binding->invocation.active ||
+        binding->invocation.retained) {
+        return -EBUSY;
+    }
+    /* Native checks execute outside Source custody. Their return consumes no
+     * child owner or registration pin without this final canonical recheck. */
+    status = qemu_plugin_crucible_control_component_returned_current_v1(
+        binding, binding->callback, binding->userdata, holder);
+    if (status) {
+        return status;
+    }
+    qemu_mutex_lock(&commands->mutex);
+    owner = binding->child_owner;
