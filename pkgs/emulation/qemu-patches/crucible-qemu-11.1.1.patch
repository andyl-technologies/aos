+static QemuCrucibleNativeRegistration *registration_locked(
+    QemuCrucibleNativeInvocationRegistry *registry, const void *coordinate,
+    void *function, void *userdata, enum QemuCrucibleNativeInvocationKind kind)
+{
+    size_t i;
+
+    for (i = 0; i < ARRAY_SIZE(registry->registrations); i++) {
+        QemuCrucibleNativeRegistration *record = &registry->registrations[i];
+
+        if (record->active && record->source_authenticated &&
+            record->descriptor_retained && record->owner == registry &&
+            record->ctx == registry->ctx && record->module == registry->module &&
+            record->child_owner == registry->child_owner &&
+            (record == coordinate || record->coordinate == coordinate) &&
+            record->function == function && record->userdata == userdata &&
+            record->kind == kind) {
+            return record;
+        }
+    }
+    return NULL;
+}
