+    bool workspace = GPOINTER_TO_INT(data);
+    const unsigned invalid_offsets[] = { 56, 64, 88, 96, 104, 108 };
+    Fixture fixture;
+    uint8_t frame[125] = { 0 };
+    union {
+        struct cmsghdr alignment;
+        uint8_t bytes[CMSG_SPACE(9 * sizeof(int))];
+    } ancillary = { 0 };
+    size_t count = workspace ? 9 : 8;
+    struct iovec iov = { .iov_base = frame, .iov_len = sizeof(frame) };
+    struct msghdr message = {
+        .msg_iov = &iov, .msg_iovlen = 1,
+        .msg_control = ancillary.bytes,
+        .msg_controllen = CMSG_SPACE(count * sizeof(int)),
+    };
+    struct cmsghdr *header = CMSG_FIRSTHDR(&message);
+    QemuCruciblePreexecSetupBorrow borrowed;
+
+    if (!fixture_isolated()) {
+        g_test_trap_subprocess(NULL, 1000000, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+    fixture_prepare(&fixture, workspace, SOCK_STREAM);
+    memcpy(frame, fixture.frame, 61);
+    fixture_be32(frame, 121);
+    frame[4] = 0x16;
+    fixture_be64(frame + 5 + 56, 3);
+    fixture_be64(frame + 5 + 64, 4096);
+    fixture_be64(frame + 5 + 88, 11);
+    fixture_be64(frame + 5 + 96, 13);
+    fixture_be32(frame + 5 + 104, 1);
+    fixture_be32(frame + 5 + 108, 1);
+    header->cmsg_level = SOL_SOCKET;
+    header->cmsg_type = SCM_RIGHTS;
+    header->cmsg_len = CMSG_LEN(count * sizeof(int));
+    memcpy(CMSG_DATA(header), fixture.sources, count * sizeof(int));
+    preexec_setup_owner.selected_edition = 6;
+    g_assert_cmpint(sendmsg(fixture.sender, &message, 0), ==, 125);
+    g_assert_cmpint(preexec_setup_receive_once(), ==, 0);
+    fixture_assert_aliases(&fixture, count);
+    fixture_base_alias_checks();
+    if (workspace) {
+        fixture_workspace_checks(6);
+    }
+    g_assert_cmpint(preexec_setup_physical_borrow(&borrowed), ==, 0);
+    g_assert_cmpuint(borrowed.frame_bytes, ==, 125);
+    g_assert_cmpuint(borrowed.descriptor_count, ==, count);
+    g_assert_cmpint(preexec_setup_receive_once(), ==, -EALREADY);
+    for (size_t index = 0; index < G_N_ELEMENTS(invalid_offsets); index++) {
+        size_t offset = 5 + invalid_offsets[index];
+        uint8_t saved[8];
+
+        memcpy(saved, preexec_setup_owner.frame + offset, 8);
+        memset(preexec_setup_owner.frame + offset, 0, 8);
+        g_assert_cmpint(preexec_setup_validate_frame(), ==, -EINVAL);
+        memcpy(preexec_setup_owner.frame + offset, saved, 8);
+    }
+    preexec_setup_owner.frame[124] = 1;
+    g_assert_cmpint(preexec_setup_validate_frame(), ==, -EINVAL);
+    preexec_setup_owner.frame[124] = 0;
+    g_assert_cmpint(preexec_setup_validate_frame(), ==, 0);
+
+    /* Transport receipt is not a session purpose. No real peer/family/Original
+     * is supplied; the actual constructor must leave its journal unborn. */
+    int refused = preexec_publisher_session_construct(&preexec_setup_owner, 4096);
+
+    g_assert_cmpint(preexec_setup_owner.publisher_storage.session.attempted, ==, false);
+    g_assert_cmpint(refused, ==, -ESTALE);
+    g_assert_false(preexec_setup_owner.publisher_storage.session.held);
+    g_assert_null(preexec_setup_owner.publisher_storage.cleanup_session);
+}
