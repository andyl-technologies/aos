+                                PICOSECONDS_PER_NANOSECOND + 999;
+    __int128 target_ticks = riscv_time_ps_to_ticks(now_ps, frequency) + ticks;
+
+    return MIN(riscv_time_ticks_to_ps(target_ticks, frequency), horizon_ps);
