+static void scenario_metadata_inventory_ordinary_geometry(void)
+{
+    RAMBlock small[3] = { 0 };
+    RAMBlock *large;
+    CrucibleRamInventory *array = NULL;
+    QemuCrucibleRamReturnDisposition returned;
+    uint64_t count, topology;
+
+    /* Ordinary constructor component: real RAMList membership under a modeled
+     * BQL, with no prepared or activated Source and no selected ledger. */
+    qemu_thread_get_self(&fixture.thread);
+    qemu_mutex_init(&ram_list.mutex);
+    g_assert_false(qemu_plugin_crucible_startup_source_retained());
+    qemu_mutex_lock_ramlist();
+    for (size_t index = 0; index < G_N_ELEMENTS(small); index++) {
+        QLIST_INSERT_HEAD(&ram_list.blocks, &small[index], next);
+    }
+    qemu_mutex_unlock_ramlist();
+    g_assert_cmpint(region_inventory_new(&array), ==, 0);
+    g_assert_cmpuint(array->capacity, ==, G_N_ELEMENTS(small));
+    g_assert_null(array->owner);
+    g_assert_cmpint(region_inventory_release(&array, &returned), ==, 0);
+    g_assert_null(array);
+    qemu_mutex_lock_ramlist();
+    for (size_t index = 0; index < G_N_ELEMENTS(small); index++) {
+        QLIST_REMOVE(&small[index], next);
+    }
+    qemu_mutex_unlock_ramlist();
+
+    large = g_new0(RAMBlock, 4097);
+    qemu_mutex_lock_ramlist();
+    for (size_t index = 0; index < 4097; index++) {
+        QLIST_INSERT_HEAD(&ram_list.blocks, &large[index], next);
+    }
+    qemu_mutex_unlock_ramlist();
+    g_assert_cmpint(region_inventory_members(&count, &topology), ==, 0);
+    g_assert_cmpuint(count, ==, 4097);
+    g_assert_cmpuint(topology, ==, topology_generation);
+    g_assert_cmpint(region_inventory_new(&array), ==, 0);
+    g_assert_cmpuint(array->capacity, ==, 4096);
+    g_assert_cmpint(region_inventory_release(&array, &returned), ==, 0);
+    qemu_mutex_lock_ramlist();
+    for (size_t index = 0; index < 4097; index++) {
+        QLIST_REMOVE(&large[index], next);
+    }
+    qemu_mutex_unlock_ramlist();
