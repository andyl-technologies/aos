+static void checkpoint_registry_refusal(unsigned refusal)
+{
+    GHashTable *table;
+
+    fixture_prepare(0, false);
+    g_assert_cmpint(fixture_acquire(), ==, 0);
+    table = plugin.id_ht;
+    if (refusal == 0) {
+        plugin.id_ht = NULL;
+    } else if (refusal == 1) {
+        g_assert_true(g_hash_table_remove(table, &fixture.ctx.id));
+    } else if (refusal == 2) {
+        fixture.ctx.resetting = true;
+    } else {
+        fixture.ctx.uninstalling = true;
+    }
+
+    g_assert_cmpint(fixture_register_checkpoint(), ==, -EPERM);
+    g_assert_true(startup_source.checkpoint_pager_attempted);
+    g_assert_cmpint(startup_source.first_negative_status, ==, -EPERM);
+    assert_checkpoint_unpublished();
+    plugin.id_ht = table;
+    if (refusal == 1) {
+        g_assert_true(g_hash_table_insert(table, &fixture.ctx.id, &fixture.ctx.id));
+    }
+    fixture.ctx.resetting = false;
+    fixture.ctx.uninstalling = false;
+    g_assert_cmpint(fixture_register_checkpoint(), ==, -EPERM);
+    assert_checkpoint_lifetime();
