+    literal += "\nCPUTailQ cpus_queue = QTAILQ_HEAD_INITIALIZER(cpus_queue);\n"
+    literal += "static QemuCrucibleStartupSourceControl startup_source = {\n"
+    literal += "    .cpu_allocations.lock = PTHREAD_MUTEX_INITIALIZER,\n};\n"
+    literal += extract["function"]((source / "system/cpus.c").read_text(),
+                                   "bool cpu_work_list_empty(")
+    literal += "\n\n" + extract["function"](initial, "int qemu_crucible_source_initial_cpus_closed_v1(")
+    literal += "\n\n" + extract["function"](initial, "static int initial_hardware_catalogue_terminal_dependencies(")
+
+    controls = {
+        "positive": literal,
+        "permit-selected-lazy-birth": literal.replace(
+            "if (qemu_plugin_crucible_startup_source_retained())", "if (false)"),
+        "permit-overflow-publication": literal.replace(
+            "return !crucible_hardware_catalogue.overflow", "return true"),
+        "omit-worker-physical-return": literal.replace(
+            "workers[index]->attempted && !workers[index]->physical_returned", "false"),
+        "omit-material-physical-return": literal.replace(
+            "material->capture_entered && !material->physical_returned", "false"),
+    }
+    proof = {}
+    for name, definitions in controls.items():
+        if name != "positive" and definitions == literal:
+            raise ValueError(f"negative control did not change literal provider: {name}")
+        generated = output / f"{name}.c"
+        generated.write_text('#include "qemu/osdep.h"\n#include <assert.h>\n'
+                             '#include "hw/core/cpu.h"\n#include "qemu/crucible-fault.h"\n'
+                             '#include "system/cpus.h"\n#include "plugins/crucible-startup-source.h"\n'
+                             '#include "qemu/crucible-clock-custody.h"\n'
+                             '#include "qemu/crucible-apic-getter.h"\n'
+                             '#include "system/memory.h"\n' +
+                             INPUTS + definitions + CHECKS)
+        binary = output / name
+        command = [os.environ.get("CC", "cc"),
+                   *shlex.split(os.environ.get("CFLAGS", "")),
+                   str(generated), "-o", str(binary),
+                   *shlex.split(os.environ.get("LDFLAGS", ""))]
+        (output / f"{name}.compile-command.json").write_text(json.dumps(command, indent=2) + "\n")
+        subprocess.run(command, check=True)
+        result = subprocess.run([str(binary)], text=True, stdout=subprocess.PIPE,
+                                stderr=subprocess.STDOUT, timeout=30, cwd=output)
+        (output / f"{name}.log").write_text(result.stdout)
+        expected = 0 if name == "positive" else -6
+        if result.returncode != expected:
+            raise RuntimeError(f"unexpected {name} outcome: {result.returncode}\n{result.stdout}")
+        proof[name] = {"returncode": result.returncode, "output": result.stdout}
+    (output / "proof.json").write_text(json.dumps(proof, indent=2) + "\n")
+    print(proof["positive"]["output"], end="")
+    print("PASS selected-birth, overflow and physical-debt omission controls reached their assertions")
+
+
+if __name__ == "__main__":
+    main()
