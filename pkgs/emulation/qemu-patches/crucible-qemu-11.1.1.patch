+static int startup_setup_service_binding_identity(qemu_plugin_id_t id)
+{
+    QemuCruciblePublisherModuleService *service = &startup_source.publisher_module;
+
+    if (!startup_owner() || service->process != getpid() ||
+        service->thread != native_metadata_thread_id() ||
+        !startup_source.module_custody_published ||
+        service->canonical_owner != service || !service->attempted ||
+        service->installer.plugin_id != id ||
+        service->installer.plugin_id != startup_source.saved.plugin_id ||
+        service->installer.ctx != startup_source.saved.ctx ||
+        service->installer.module != startup_source.saved.module ||
+        service->installer.install != startup_source.saved.install ||
+        service->process_generation != startup_source.original.process_generation ||
+        service->lender != startup_source.publisher_lender || !service->lender) {
+        return -EPERM;
+    }
+    return 0;
+}
+
+static int publisher_service_runtime_identity(
+    QemuCruciblePublisherModuleService *service);
+
+static int startup_setup_service_identity(qemu_plugin_id_t id)
+{
+    QemuCruciblePublisherModuleService *service = &startup_source.publisher_module;
+    int status = startup_setup_service_binding_identity(id);
+
+    if (status) {
+        return status;
+    }
+    if (service->transferred) {
+        return publisher_service_runtime_identity(service);
+    }
+    if (!service->held || service->holder != &service->creation_owner ||
+        service->creation_owner != service) {
+        return -ESTALE;
+    }
+    return 0;
+}
+
+/* Cleanup may ignore a failed/expired Original, but the live installer frame
+ * must still be the exact caller. A moved child instead requires its retained
+ * Runtime and the separate actual Native physical-return frame. */
+static int startup_setup_service_installer_current(qemu_plugin_id_t id)
+{
+    QemuCruciblePublisherModuleService *service = &startup_source.publisher_module;
+
+    return startup_invocation(id) &&
+        service->installer.ctx == startup_source.current.ctx &&
+        service->installer.module == startup_source.current.module &&
+        service->installer.install == startup_source.current.install ? 0 : -EPERM;
+}
+
+/* Physical-only reciprocal used after the independent nominal Source check.
+ * It cannot authenticate a module, service, Original or cleanup work interval. */
+static int startup_setup_service_return_boundary_current(
+    QemuCruciblePublisherModuleService *service)
+{
+    if (service != &startup_source.publisher_module) {
+        return -ESTALE;
+    }
+    if (service->transferred) {
+        return qemu_plugin_crucible_publisher_service_return_frame_current_v1(
+            service->cleanup_frame, &startup_source.control_callback,
+            startup_source.control_callback.holder);
+    }
+    return 0;
+}
