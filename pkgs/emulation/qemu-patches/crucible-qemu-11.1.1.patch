+        strcmp(crucible_hot_fork_plugin_endpoint_stage.control_fdname,
+               control_fdname) == 0 &&
+        strcmp(crucible_hot_fork_plugin_endpoint_stage.wake_fdname,
+               wake_fdname) == 0 &&
+        crucible_hot_fork_plugin_endpoint_stage.control_socket_cookie ==
+            control_socket_cookie &&
+        crucible_hot_fork_plugin_endpoint_stage.wake_eventfd_id ==
+            wake_eventfd_id &&
+        crucible_hot_fork_plugin_endpoint_stage.private_ring_generation ==
+            crucible_hot_fork_private_ring_stage.generation;
+}
+
+static bool crucible_hot_fork_plugin_worker_disposition_matches(
+    const CrucibleHotForkPluginBarrierState *plugin_barrier)
+{
+    QemuPluginCrucibleHotForkInventory resources;
+
+    qemu_plugin_crucible_hot_fork_inventory(&resources);
+    return plugin_barrier && plugin_barrier->quiescent &&
+        crucible_hot_fork_plugin_endpoint_stage.replacement_plan_bound &&
+        resources.complete && resources.manifest.process_generation != 0 &&
+        resources.manifest.process_generation != UINT64_MAX &&
+        resources.manifest.control_fd >= 0 &&
+        resources.manifest.wake_fd >= 0 &&
+        resources.manifest.control_fd != resources.manifest.wake_fd &&
+        crucible_hot_fork_plugin_endpoint_stage.control_target_fd ==
+            resources.manifest.control_fd &&
+        crucible_hot_fork_plugin_endpoint_stage.wake_target_fd ==
+            resources.manifest.wake_fd &&
+        crucible_hot_fork_plugin_endpoint_stage.control_fd !=
+            resources.manifest.control_fd &&
+        crucible_hot_fork_plugin_endpoint_stage.control_fd !=
+            resources.manifest.wake_fd &&
+        crucible_hot_fork_plugin_endpoint_stage.wake_fd !=
+            resources.manifest.control_fd &&
+        crucible_hot_fork_plugin_endpoint_stage.wake_fd !=
+            resources.manifest.wake_fd &&
+        crucible_hot_fork_plugin_endpoint_stage.control_fd !=
+            crucible_hot_fork_private_ring_stage.fd &&
+        crucible_hot_fork_plugin_endpoint_stage.wake_fd !=
+            crucible_hot_fork_private_ring_stage.fd &&
+        crucible_hot_fork_private_ring_stage.source_mapping_bound &&
+        crucible_hot_fork_private_ring_stage.source_start != 0 &&
+        crucible_hot_fork_private_ring_stage.source_length ==
+            crucible_hot_fork_mapping_extent(
+                resources.manifest.shmem_length) &&
+        crucible_hot_fork_private_ring_stage.source_offset == 0 &&
+        resources.manifest.control_fd !=
+            crucible_hot_fork_private_ring_stage.fd &&
+        resources.manifest.wake_fd !=
+            crucible_hot_fork_private_ring_stage.fd &&
+        plugin_barrier->generation ==
+            crucible_hot_fork_plugin_endpoint_stage.plugin_barrier_generation &&
+        plugin_barrier->worker_mask ==
+            crucible_hot_fork_plugin_endpoint_stage.worker_mask &&
+        plugin_barrier->parked_worker_mask == plugin_barrier->worker_mask &&
+        plugin_barrier->pending_worker_mask == 0 &&
+        plugin_barrier->worker_operations_in_flight == 0 &&
+        crucible_hot_fork_plugin_endpoint_stage.parent_resume_worker_mask ==
+            plugin_barrier->worker_mask &&
+        crucible_hot_fork_plugin_endpoint_stage.
+            child_reinitialize_worker_mask == plugin_barrier->worker_mask;
+}
