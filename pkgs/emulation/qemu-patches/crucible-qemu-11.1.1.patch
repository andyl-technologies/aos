+        status = qemu_crucible_source_action_original_current_v1(action, id);
+    }
+    if (!status) {
+        status = standing_boundary();
+    }
+    if (!status) {
+        status = standing_clock(&now);
+    }
+    if (!status) {
+        status = standing_limits_current(&startup_source.standing.current, now);
+    }
+    if (status) {
+        return status;
+    }
+    qemu_mutex_lock(&startup_source.commands.mutex);
+    status = fingerprint_worker_holder_identity_locked(worker);
+    if (!status && worker->native.closing) {
+        status = -ESHUTDOWN;
+    }
+    if (!status && (worker->native.first_status || worker->native.post_status)) {
+        status = worker->native.first_status ? worker->native.first_status : worker->native.post_status;
+    }
