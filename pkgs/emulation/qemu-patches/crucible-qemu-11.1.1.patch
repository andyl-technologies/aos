+int qobject_input_visitor_free_source(Visitor **holder)
+{
+    QObjectInputVisitor *qiv;
+    int status;
+    void *body;
+
+    if (!holder || !*holder) {
+        return -EINVAL;
+    }
+    status = input_source_identity(*holder);
+    if (status) {
+        return status;
+    }
+    qiv = to_qiv(*holder);
+    if (qiv->source_dealloc_borrowed) {
+        return -EBUSY;
+    }
+    while (!QSLIST_EMPTY(&qiv->stack)) {
+        StackObject *entry = QSLIST_FIRST(&qiv->stack);
+
+        QSLIST_REMOVE_HEAD(&qiv->stack, node);
+        entry->source_retired_next = qiv->source_retired;
+        qiv->source_retired = entry;
+    }
+    status = input_source_retired_return(qiv);
+    if (!status && qiv->source_pending) {
+        status = qemu_crucible_qmp_free(&qiv->source_pending);
+    }
+    if (!status && qiv->source_temporary_string) {
+        void *text = qiv->source_temporary_string;
+
+        status = qemu_crucible_qmp_free(&text);
+        qiv->source_temporary_string = text;
+    }
+    if (!status && qiv->errname) {
+        status = qemu_crucible_qmp_string_free(&qiv->errname, NULL);
+    }
+    if (!status && qiv->source_dealloc) {
+        status = qapi_dealloc_visitor_free_source(&qiv->source_dealloc);
+    }
+    if (!status && qiv->root) {
+        status = qobject_unref_source(&qiv->root);
+    }
+    if (status) {
+        input_source_result(qiv, status);
+        return status;
+    }
+    body = qiv;
+    status = qemu_crucible_qmp_free(&body);
+    *holder = body;
+    return status;
+}
+
+int qapi_source_input_dealloc_return(Visitor *input, Visitor **borrow)
+{
+    QObjectInputVisitor *qiv;
+    int status = input_source_identity(input);
+
+    if (status) {
+        return status;
+    }
+    qiv = to_qiv(input);
+    if (!borrow || !*borrow || !qiv->source_dealloc_borrowed ||
+        *borrow != qiv->source_dealloc) {
+        return -ESTALE;
+    }
+    /* The exact borrowed visitor must have returned its physical mutation loan.
+     * Schema cleanup failure may retain arguments; returning this borrower does
+     * not certify that those arguments or the enclosing operation completed. */
+    status = qapi_source_dealloc_idle(qiv->source_dealloc);
+    if (status) {
+        return status;
+    }
+    *borrow = NULL;
+    qiv->source_dealloc_borrowed = false;
+    return 0;
+}
