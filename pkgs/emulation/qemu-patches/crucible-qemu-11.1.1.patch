+                "-trace", "crucible_sim_determinism_timer",
+                "-trace", "crucible_sim_determinism_idle",
+            ])
+        if active_host_ready or control_at_first_dispatch:
+            command.extend([
+                "-trace", "crucible_sim_main_loop_poll_enter",
+                "-trace", "crucible_sim_main_loop_poll_ready",
+            ])
+        self.process = subprocess.Popen(
+            command,
+            stdin=subprocess.PIPE,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+            pass_fds=(marker_write, self.state_fd, self.wake_fd),
+        )
