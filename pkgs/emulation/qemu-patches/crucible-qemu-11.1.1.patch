+static int preexec_standing_construct(QemuCruciblePreexecSetupOwner *owner,
+                                      uint64_t page_size)
+{
+    QemuCrucibleStandingPurposeOwner *standing = &owner->standing;
+    PreexecStandingIdentitySnapshot identity;
+    const volatile uint8_t *declaration;
+    size_t declaration_bytes;
+    uint64_t backing_bytes;
+    long mapping;
+    int status;
+
+    if (owner != &preexec_setup_owner || owner->source_published || standing->retained ||
+        standing->artifact_identity_known ||
+        preexec_setup_syscall5(SYS_getpid, 0, 0, 0, 0, 0) != owner->process_id ||
+        preexec_setup_syscall5(SYS_gettid, 0, 0, 0, 0, 0) != owner->thread_id ||
+        !owner->fixed_family.source.retained || !owner->artifact_verified ||
+        !owner->identity_corroborated || standing->attempted) {
+        return -EPERM;
+    }
+    declaration = qemu_crucible_preexec_standing_constructor_layout_v1(
+        &declaration_bytes);
+
+    if (!declaration || declaration_bytes != sizeof(preexec_standing_constructor_layout) ||
+        preexec_setup_be64(declaration) != UINT64_C(0x4352554353544332) ||
+        preexec_setup_be32(declaration + 8) != 2 ||
+        preexec_setup_be32(declaration + 12) != sizeof(preexec_standing_constructor_layout) ||
+        preexec_setup_be32(declaration + 16) != QEMU_CRUCIBLE_PREEXEC_SETUP_EDITION ||
+        preexec_setup_be32(declaration + 20) != QEMU_CRUCIBLE_PROCESS_PURPOSE_SCHEMA ||
+        preexec_setup_be32(declaration + 24) != QEMU_CRUCIBLE_PROCESS_PURPOSE_PLAN_SCHEMA ||
+        preexec_setup_be32(declaration + 28) != 8 ||
+        preexec_setup_be32(declaration + 32) != QEMU_CRUCIBLE_PREEXEC_SETUP_TAG_V5 ||
+        preexec_setup_be32(declaration + 36) != QEMU_CRUCIBLE_PREEXEC_SETUP_FRAME_BYTES ||
+        preexec_setup_be32(declaration + 40) != QEMU_CRUCIBLE_PREEXEC_SETUP_BASE_FDS ||
+        preexec_setup_be32(declaration + 44) != QEMU_CRUCIBLE_PREEXEC_SETUP_WORKSPACE_FDS ||
+        preexec_setup_be32(declaration + 48) != QEMU_CRUCIBLE_PREEXEC_SETUP_STANDING_PUBLICATION_INDEX ||
+        preexec_setup_be32(declaration + 52) != QEMU_CRUCIBLE_PREEXEC_SETUP_STANDING_CANCELLATION_INDEX ||
+        preexec_setup_be32(declaration + 56) != QEMU_CRUCIBLE_PREEXEC_SETUP_WORKSPACE_INDEX ||
+        preexec_setup_be32(declaration + 60) != QEMU_CRUCIBLE_PROCESS_PURPOSE_BYTES ||
+        preexec_setup_be32(declaration + 64) != QEMU_CRUCIBLE_STANDING_MAPPING_BYTES ||
+        preexec_setup_be32(declaration + 68) != QEMU_CRUCIBLE_STANDING_PAYLOAD_BYTES ||
+        preexec_setup_be32(declaration + 72) != 11 ||
+        preexec_setup_be32(declaration + 76) ||
+        preexec_setup_be64(declaration + 80) != sizeof(preexec_setup_owner) ||
+        preexec_setup_be64(declaration + 88) != QEMU_CRUCIBLE_STANDING_MAPPING_BYTES) {
+        return -EPROTO;
+    }
+    status = preexec_setup_original_live();
+    if (status) {
+        return status;
+    }
+    standing->issuer = owner;
+    standing->publication_fd = owner->descriptors[
+        QEMU_CRUCIBLE_PREEXEC_SETUP_STANDING_PUBLICATION_INDEX];
+    standing->cancellation_fd = owner->descriptors[
+        QEMU_CRUCIBLE_PREEXEC_SETUP_STANDING_CANCELLATION_INDEX];
+    standing->attempted = true;
+    if (!page_size || (page_size & (page_size - 1)) ||
+        page_size - 1 > UINT64_MAX - QEMU_CRUCIBLE_STANDING_MAPPING_BYTES) {
+        standing->first_status = -EOVERFLOW;
+        return -EOVERFLOW;
+    }
+    backing_bytes = (QEMU_CRUCIBLE_STANDING_MAPPING_BYTES + page_size - 1) &
+                    ~(page_size - 1);
+    status = preexec_standing_roles_observe(standing, &owner->preinit_observation, &identity);
+    if (!status) {
+        /* This actual preinit thread fixes identities before retained mapping
+         * or Source publication. Runtime observation has no initializer path. */
+        standing->artifact_identity = identity.artifact;
+        standing->artifact_identity_known = true;
+        standing->publication_identity = identity.publication;
+        standing->cancellation_identity = identity.cancellation;
+        standing->cancellation_event_token = identity.event_token;
+        status = preexec_setup_provisional_native(backing_bytes);
+    }
+    if (status) {
+        standing->first_status = status;
+        return status;
+    }
+    /* Actual kernel page backing and the whole requested extent are retained
+     * from the same preexec payer before mmap. Wire length is not the fee. */
+    standing->mapping_request_bytes = QEMU_CRUCIBLE_STANDING_MAPPING_BYTES;
+    standing->mapping_backing_bytes = backing_bytes;
+    mapping = preexec_setup_syscall6(SYS_mmap, 0,
+        QEMU_CRUCIBLE_STANDING_MAPPING_BYTES, PROT_READ, MAP_SHARED,
+        standing->publication_fd, 0);
+    if (mapping < 0 && mapping >= -4095) {
+        standing->first_status = mapping;
+        return mapping;
+    }
+    standing->mapping = (const uint64_t *)(uintptr_t)mapping;
+    standing->retained = true;
+    if (!standing->mapping) {
+        standing->first_status = -EFAULT;
+        return -EFAULT;
+    }
+    status = preexec_standing_snapshot(standing, standing->snapshot, &standing->sequence);
+    if (!status) {
+        QemuCrucibleStandingRecord observed;
+        const QemuCrucibleStandingRecord *initial = &owner->plan.purpose.standing;
+
+        status = preexec_literal_qemu_crucible_standing_record_decode_v4(
+            standing->snapshot, sizeof(standing->snapshot), &observed);
+        if (!status &&
+            (preexec_setup_compare(standing->snapshot + 16,
+                                   owner->plan.purpose.standing_initial + 16, 40) ||
+             preexec_setup_compare(standing->snapshot + 72,
+                                   owner->plan.purpose.standing_initial + 72, 80) ||
+             preexec_setup_compare(standing->snapshot + 160,
+                                   owner->plan.purpose.standing_initial + 160, 24) ||
+             preexec_setup_compare(standing->snapshot + 200,
+                                   owner->plan.purpose.standing_initial + 200, 32) ||
+             observed.outer_revision < initial->outer_revision ||
+             observed.roster_revision < initial->roster_revision || observed.state)) {
+            status = -ESTALE;
+        }
+    }
+    /* The live publisher may have advanced before construction. Immutable
+     * subject/origin/event/artifact remain equal; genuine revisions may advance. */
+    standing->post_status = preexec_setup_original_live();
+    standing->first_status = status;
+    return status ? status : standing->post_status;
+}
+
+int qemu_crucible_preexec_standing_borrow_v1(
+    QemuCruciblePreexecPurposeOwner *held, QemuCrucibleStandingPurposeOwner **out)
+{
+    QemuCruciblePreexecSetupOwner *owner = &preexec_setup_owner;
+    int status;
+
+    if (held != owner || !out || *out || !owner->standing.retained) {
+        return -EPERM;
+    }
+    status = preexec_setup_original_live();
+    *out = &owner->standing;
+    return status ? status : owner->standing.first_status ?
+        owner->standing.first_status : owner->standing.post_status;
+}
