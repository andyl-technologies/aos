+        acpi->tmr.overflow_ticks : acpi->tmr.overflow_time;
+
+    if (acpi->gpe.len != 0 && (!acpi->gpe.sts || !acpi->gpe.en)) {
+        error_setg(errp, "ICH9 LPC fingerprint has invalid hotplug geometry");
+        return false;
