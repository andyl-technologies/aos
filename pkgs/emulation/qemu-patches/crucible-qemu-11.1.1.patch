+}
+
+QemuCrucibleNativeInvocationRegistry *
+qemu_crucible_startup_source_native_registry_v1(struct qemu_plugin_ctx *ctx,
+                                              bool installing)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    QemuCrucibleCallbackPublicationRegistry *callbacks = &startup_source.callbacks;
+    QemuCrucibleNativeInvocationRegistry *native = &callbacks->native;
+    qemu_plugin_id_t id;
+    int status = callback_registry_identity(&id);
+
+    if (status || (ctx && ctx != startup_source.saved.ctx) ||
+        (installing && !startup_invocation(id))) {
+        return NULL;
+    }
+    qemu_mutex_lock(&commands->mutex);
+    /* Native mutable bound/revoked/refs are never read under this mutex.
+     * Identity lookup stays available while closing for physical returns. */
+    status = !callbacks->native_prepared ? -ENOKEY :
+        callback_child_owner_identity_locked(&callbacks->owner);
+    if (!status && (native->canonical_owner != native ||
+                    native->ctx != callbacks->owner.installer.ctx ||
+                    native->module != callbacks->owner.installer.module ||
+                    native->runtime != callbacks->owner.runtime ||
+                    native->storage != callbacks->owner.bridge ||
+                    native->storage_holder != callbacks->owner.bridge_holder ||
+                    native->process != commands->process ||
+                    native->process_generation != callbacks->owner.process_generation ||
+                    native->account_generation != callbacks->owner.account_generation)) {
+        status = -ESTALE;
+    }
+    if (!status && installing) {
+        /* A boolean and ctx do not create publication. The exact retained
+         * Source registrar borrow must already bracket this real effect. */
+        QemuCrucibleCallbackRegistrationGroupBorrow *group =
+            &startup_source.callback_groups.borrower;
+
+        if (group->held) {
+            /* A complete group has its own genuine entered owner and serial;
+             * the legacy family span cannot be enlarged into this route. */
+            status = callback_group_registrar_current_locked(
+                group, group->serial, group->owner->kind);
+        } else {
+            status = callback_registrar_identity_locked(
+                &callbacks->registrar, callbacks->registrar.serial);
+            if (!status && (!callbacks->publication.current ||
+                            callbacks->publication.first_status ||
+                            callbacks->publication.post_status)) {
+                status = -ESTALE;
+            }
+        }
+    }
+    qemu_mutex_unlock(&commands->mutex);
+    return status ? NULL : native;
+#else
+    return NULL;
+#endif
+}
+
+static int callback_child_native_retire(QemuCrucibleCallbackChildStorage *child)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    QemuCrucibleCallbackPublicationRegistry *callbacks = &startup_source.callbacks;
+    QemuCrucibleCallbackChildOwner *owner = &callbacks->owner;
+    bool prepared;
+    bool owner_held;
+    int status;
+
+    qemu_mutex_lock(&commands->mutex);
+    status = callback_child_identity_locked(child);
+    prepared = callbacks->native_prepared;
+    owner_held = owner->initialized && owner->held && !owner->returned;
+    if (!status && (!child->closing || callbacks->native_preparing ||
+                    callbacks->publication.held || callbacks->registrar.held ||
+                    startup_source.callback_groups.entered ||
+                    startup_source.callback_groups.borrower.held ||
+                    child->publication_users != (owner_held ? 1 : 0))) {
+        status = -EBUSY;
+    }
+    if (!status && owner_held) {
+        status = callback_child_owner_identity_locked(owner);
+        if (!status && (owner->component_users || owner->workspace_users)) {
+            status = -EBUSY;
+        }
+    } else if (!status && owner->initialized &&
+               (!owner->returned || owner->held || owner->holder ||
+                owner->creation_owner || owner->child != child)) {
+        status = -ESTALE;
+    }
+    if (!status && ((!owner->initialized && prepared) ||
+                    (!owner_held && child->registration_retained) ||
+                    (!prepared && child->registration_retained))) {
+        status = -ENOKEY;
+    }
+    if (!status) {
+        child->callback_closing = true;
+        if (owner->initialized) {
+            owner->closing = true;
+        }
+    }
+    qemu_mutex_unlock(&commands->mutex);
+    if (status) {
+        return status;
+    }
+    if (prepared) {
+        /* These physical-only observations remain valid after the owner has
+         * returned. native_prepared is a permanent construction fact. */
+        status = qemu_plugin_crucible_native_registry_revoke_v1(&callbacks->native);
+        qemu_mutex_lock(&commands->mutex);
+        callbacks->native_revocation_attempted = true;
+        callbacks->native_revocation_status = status;
+        qemu_mutex_unlock(&commands->mutex);
+        if (status) {
+            return status;
+        }
+        status = qemu_plugin_crucible_native_registry_retired_current_v1(&callbacks->native);
+        if (!status && owner_held) {
+            /* This reciprocal Source identity requires the canonical owner
+             * still held. Never query that consumed owner on later child return. */
+            status = qemu_plugin_crucible_native_child_registration_terminal_v1(
+                &callbacks->native, owner);
+        }
+        qemu_mutex_lock(&commands->mutex);
+        callbacks->native_terminal_status = status;
+        qemu_mutex_unlock(&commands->mutex);
+        if (status) {
+            return status;
+        }
+    }
+    qemu_mutex_lock(&commands->mutex);
+    status = callback_child_identity_locked(child);
+    if (!status && owner_held) {
+        status = callback_child_owner_identity_locked(owner);
+    }
+    if (!status && (!child->closing || callbacks->native_preparing ||
+                    callbacks->publication.held || callbacks->registrar.held ||
+                    startup_source.callback_groups.entered ||
+                    startup_source.callback_groups.borrower.held ||
+                    child->publication_users != (owner_held ? 1 : 0) ||
+                    (!owner_held && child->registration_retained))) {
+        status = -EBUSY;
+    }
+    qemu_mutex_unlock(&commands->mutex);
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
diff --git a/plugins/crucible-checkpoint-finalizer.inc.h b/plugins/crucible-checkpoint-finalizer.inc.h
new file mode 100644
index 0000000000000000000000000000000000000000..62cab014a3c1e98dffc5c47d8a94426961874084
--- /dev/null
+++ b/plugins/crucible-checkpoint-finalizer.inc.h
@@ -0,0 +1,1972 @@
+/*
+ * Same Main/BQL checkpoint candidate return and terminal observation
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Included once by receiving.c. Main/BQL retains the nominal request through
+ * callback return, real Root retirement, provider end and physical alias return.
+ * RAM actors observe the retained journal without running Main cleanup.
+ */
+static bool checkpoint_root_end_complete(QemuCrucibleCheckpointHeldTransaction *owner);
+
+static int checkpoint_provider_identity(QemuCrucibleCheckpointRequestLoan *request)
+{
+    if (request != &checkpoint_request ||
+        !qatomic_load_acquire(&checkpoint_request.published) ||
+        request->process_id != getpid() ||
+        !qemu_thread_is_self(&request->thread) || !bql_locked() ||
+        qemu_in_coroutine() ||
+        !qemu_crucible_checkpoint_pager_binding_current(&request->pager)) {
+        return -EPERM;
+    }
+    return 0;
+}
+
+int qemu_crucible_checkpoint_request_actor_current_v1(
+    QemuCrucibleCheckpointRequestLoan *request, QemuCrucibleRamControlActor *actor)
+{
+    Monitor *monitor;
+    void *purpose;
+    uint64_t process_generation, epoch;
+    int status = checkpoint_provider_identity(request);
+
+    if (!status) {
+        status = monitor_qmp_checkpoint_reservation_observe(
+            checkpoint_main_owner.reservation, &monitor, &purpose,
+            &process_generation, &epoch);
+    }
+    if (status || monitor != request->monitor ||
+        purpose != request->containing_purpose ||
+        process_generation != request->coordinates.process_generation ||
+        epoch != request->connection_epoch || !actor || request->actor != actor ||
+        actor->process != getpid() || !qatomic_load_acquire(&actor->born) ||
+        actor->userdata != request->pager.userdata ||
+        request->request_owner != &checkpoint_main_owner ||
+        !qatomic_load_acquire(&checkpoint_main_owner.published) ||
+        checkpoint_main_owner.request != request ||
+        checkpoint_main_owner.monitor != request->monitor ||
+        !checkpoint_main_owner.allocation_retained ||
+        !request->containing_purpose || !request->connection_owner ||
+        !request->generation || !request->connection_epoch) {
+        return status ? status : -EPERM;
+    }
+    return 0;
+}
+
+int qemu_crucible_checkpoint_request_receipt_return_current_v1(
+    QemuCrucibleCheckpointRequestLoan *request, QemuCrucibleRamControlActor *actor,
+    QemuCrucibleRamControlReceive *receipt)
+{
+    QemuCrucibleCheckpointHeldTransaction *owner = &checkpoint_transaction;
+    bool no_root;
+    int status = qemu_crucible_checkpoint_request_actor_current_v1(request, actor);
+
+    if (status || owner->inventory.active || owner->inventory.metadata_borrow ||
+        owner->inventory.output.held || owner->inventory.output.close_uncertain ||
+        owner->inventory.cancellation.held || owner->inventory.cancellation.close_uncertain || owner->request != request ||
+        request->receipt != receipt ||
+        receipt != &actor->receipt || checkpoint_pending.actor != actor ||
+        checkpoint_pending.receipt != receipt || !checkpoint_pending.moved ||
+        request->receipt_returned || !request->provider_ended ||
+        !owner->module_finalize_complete ||
+        (!(owner->candidate_ended && owner->candidate_io_ended) &&
+         !request->noncandidate_end_published) ||
+        (request->snapshot_issued && (!request->snapshot_io_returned ||
+         !request->snapshot_body_cleaned || !request->snapshot_dismissed)) ||
+        request->snapshot_birth_pending ||
+        owner->candidate_alias_uncertain || owner->capture_alias_active ||
+        !owner->event_close_attempted ||
+        owner->event_close_uncertain || owner->cancellation_fd != -1 ||
+        owner->metadata_fd != -1 || owner->metadata_close_uncertain ||
+        owner->invoking || owner->finalize_invoking || request->provider_invoking ||
+        owner->inventory.active || owner->inventory.metadata_borrow ||
+        owner->inventory.output.held || owner->inventory.output.close_uncertain ||
+        owner->inventory.cancellation.held || owner->inventory.cancellation.close_uncertain || owner->candidate_read.active) {
+        return status ? status : -EPERM;
+    }
+    no_root = !owner->prepare_called && !owner->proof.retained &&
+        !owner->mailbox_detached && !owner->pager_held &&
+        !owner->candidate_collector_token;
+    return no_root || checkpoint_root_end_complete(owner) ? 0 : -EINPROGRESS;
+}
+
+int qemu_plugin_crucible_checkpoint_request_observe_v2(
+    qemu_plugin_id_t id, qemu_plugin_crucible_checkpoint_request_v1 *request,
+    struct qemu_plugin_crucible_checkpoint_request_status_v2 *out)
+{
+    struct qemu_plugin_crucible_checkpoint_request_status_v2 observed;
+    int status = checkpoint_provider_identity(request);
+
+    /* The enclosing registered callback issued this synchronous borrow.
+     * Never reenter provider_check while its Slot/State guards are held.
+     */
+    if (status || !out || !request->provider_invoking ||
+        id != request->pager.installer.plugin_id) {
+        return status ? status : -EPERM;
+    }
+    observed = (struct qemu_plugin_crucible_checkpoint_request_status_v2) {
+        .schema_version = 2,
+        .struct_size = sizeof(observed),
+        .request_generation = request->generation,
+        .native_transaction_generation =
+            request->coordinates.native_transaction_generation,
+        .connection_epoch = request->connection_epoch,
+        .process_generation = request->coordinates.process_generation,
+        .cancellation_device = request->cancellation_device,
+        .cancellation_inode = request->cancellation_inode,
+        .cancellation_event_id = request->cancellation_event_id,
+        .cancellation_fd = request->moved ?
+            checkpoint_transaction.cancellation_fd : request->cancellation_fd,
+        .original = request->original_wire,
+        .original_bytes = sizeof(request->original_wire),
+        .arm_request_digest = request->arm_digest,
+        .arm_request_digest_bytes = sizeof(request->arm_digest),
+        .first_status = qatomic_read(&request->first_status),
+        .post_status = qatomic_read(&request->post_status),
+    };
+    *out = observed;
+    return 0;
+}
+
+int qemu_crucible_checkpoint_provider_acquire_main_v1(
+    QemuCrucibleCheckpointRequestLoan *request)
+{
+    void *acquired = NULL;
+    int status = checkpoint_provider_identity(request);
+
+    if (status || !request->main_scope_active ||
+        !request->request_owner || !request->containing_purpose ||
+        !request->pager.provider_acquire || !request->pager.provider_check ||
+        !request->pager.provider_end || !request->pager.finalize) {
+        return status ? status : -ENOKEY;
+    }
+    if (request->provider_invoking) {
+        return -EBUSY;
+    }
+    if (request->provider_acquire_attempted) {
+        return request->first_status ? request->first_status : -EALREADY;
+    }
+    if (!request->actor_pause ||
+        qemu_plugin_crucible_ram_actor_pause_current(request->actor_pause)) {
+        status = qemu_plugin_crucible_ram_actor_request_pause_begin(
+            request, request->actor, &request->actor_pause);
+        if (status) {
+            return status;
+        }
+    }
+    status = qemu_plugin_crucible_ram_actor_pause_current(request->actor_pause);
+    if (status) {
+        return status;
+    }
+    request->provider_acquire_attempted = true;
+    request->provider_invoking = true;
+    status = request->pager.provider_acquire(request->pager.installer.plugin_id,
+                                            request, request->pager.userdata,
+                                            &acquired);
+    request->provider_invoking = false;
+    /* Retain an actual returned allocation even on an initiating refusal.
+     * A negative callback does not turn that pointer into an accepted lease.
+     */
+    request->provider_owner = acquired;
+    if (status || !acquired) {
+        int failure = status < 0 ? status : -EPROTO;
+
+        qatomic_cmpxchg(&request->first_status, 0, failure);
+        return checkpoint_fail(&checkpoint_transaction, failure, false);
+    }
+    request->provider_acquired = true;
+    return 0;
+}
+
+static int checkpoint_provider_check_main(QemuCrucibleCheckpointRequestLoan *request)
+{
+    int status = checkpoint_provider_identity(request);
+
+    if (status || !request->provider_acquired || !request->provider_owner ||
+        request->provider_ended || request->provider_invoking) {
+        return status ? status : -EPERM;
+    }
+    request->provider_invoking = true;
+    status = request->pager.provider_check(request->pager.installer.plugin_id,
+                                          request, request->provider_owner,
+                                          request->pager.userdata);
+    request->provider_invoking = false;
+    return status > 0 ? -EPROTO : status;
+}
+
+int qemu_crucible_checkpoint_candidate_read_identity_v1(
+    QemuCrucibleCheckpointCandidateReadLoan *loan, bool observer_callback)
+{
+    QemuCrucibleCheckpointHeldTransaction *owner = &checkpoint_transaction;
+    QemuCrucibleCheckpointRequestLoan *request = &checkpoint_request;
+
+    /* Nominal identity precedes any access through the incoming pointer.
+     * This check deliberately invokes no module/provider/Slot/State callback.
+     */
+    if (loan != &owner->candidate_read ||
+        !qatomic_load_acquire(&owner->published) ||
+        !qatomic_load_acquire(&request->published) || !loan->active ||
+        loan->process_id != getpid() || !qemu_thread_is_self(&loan->thread) ||
+        !qemu_in_main_thread() || !bql_locked() || qemu_in_coroutine() ||
+        loan->transaction != owner || loan->request != request ||
+        owner->request != request || !owner->candidate_started ||
+        owner->candidate_ended || !owner->stopped ||
+        !owner->proof.retained || owner->proof.returned ||
+        !owner->pager_held || !owner->mailbox_detached ||
+        owner->release_started || request->provider_ended ||
+        !request->provider_acquired || !loan->provider_owner ||
+        loan->provider_owner != request->provider_owner ||
+        !qemu_crucible_checkpoint_pager_binding_current(&owner->pager) ||
+        !owner->pager.candidate_read || !owner->pager.candidate_observe ||
+        !owner->pager.candidate_cleanup ||
+        (observer_callback && !loan->observer_invoking)) {
+        return -EPERM;
+    }
+    return 0;
+}
+
+int qemu_crucible_checkpoint_candidate_read_begin_v1(
+    QemuCrucibleCheckpointHeldTransaction *owner,
+    QemuCrucibleCheckpointCandidateReadLoan **out)
+{
+    QemuCrucibleCheckpointCandidateReadLoan *loan;
+    QemuCrucibleCheckpointRequestLoan *request;
+    uint64_t slice;
+    int status = checkpoint_current(owner);
+
+    if (status) {
+        return status;
+    }
+    request = owner->request;
+    if (!out || *out || !qemu_in_main_thread() || !bql_locked() ||
+        qemu_in_coroutine() || monitor_cur() != request->monitor ||
+        !owner->candidate_started || owner->candidate_ended ||
+        !owner->stopped || !owner->proof.retained || owner->proof.returned ||
+        !owner->pager_held || !owner->mailbox_detached ||
+        owner->release_started || owner->invoking || owner->finalize_invoking ||
+        owner->inventory.active || owner->inventory.metadata_borrow ||
+        owner->inventory.output.held || owner->inventory.output.close_uncertain ||
+        owner->inventory.cancellation.held || owner->inventory.cancellation.close_uncertain || owner->invocation.active || request->provider_invoking ||
+        !request->provider_acquired || request->provider_ended ||
+        !request->provider_owner || !owner->pager.candidate_read ||
+        !owner->pager.candidate_observe || !owner->pager.candidate_cleanup ||
+        !owner->candidate_collector_token ||
+        owner->inventory.active || owner->inventory.metadata_borrow ||
+        owner->inventory.output.held || owner->inventory.output.close_uncertain ||
+        owner->inventory.cancellation.held || owner->inventory.cancellation.close_uncertain || owner->candidate_read.active) {
+        return -EPERM;
+    }
+    status = qemu_crucible_checkpoint_request_actor_current_v1(
+        request, request->actor);
+    if (!status) {
+        status = qemu_crucible_checkpoint_main_loop_current();
+    }
+    if (!status) {
+        status = qemu_crucible_checkpoint_native_fence_check_v1(
+            owner, owner->proof.fence);
+    }
+    if (status) {
+        return status;
+    }
+    loan = &owner->candidate_read;
+    *loan = (QemuCrucibleCheckpointCandidateReadLoan) {
+        .process_id = getpid(),
+        .transaction = owner,
+        .request = request,
+        .provider_owner = request->provider_owner,
+        .active = true,
+    };
+    qemu_thread_get_self(&loan->thread);
+    *out = loan;
+
+    /* The same concrete loan is retained before either fallible check. The
+     * caller must return a published loan even when begin reports a negative.
+     * Provider check runs outside every held reader/observer module guard.
+     */
+    status = checkpoint_provider_check_main(request);
+    if (!status) {
+        status = checkpoint_live(owner, &slice, false);
+    }
+    if (status) {
+        checkpoint_fail(owner, status, false);
+    }
+    return status;
+}
