+int qemu_crucible_ram_root_transaction(
+    uint32_t phase, uint64_t transaction, uint64_t topology,
+    const struct qemu_plugin_crucible_ram_prepared_page_v1 *pages, size_t count,
+    uint8_t root[32], uint64_t *logical_bytes)
+{
+    qemu_plugin_crucible_ram_root_transaction_v1 observer;
+
+    if (!mutation_writer_scope || !bql_locked() || !capture_active ||
+        transaction != capture_generation || topology != capture_topology_generation ||
+        topology != qatomic_read(&topology_generation) || phase > 2 ||
+        !root || !logical_bytes || count > 65536 ||
+        (phase == 0 && (!pages || !count || !capture_valid(transaction, 0))) ||
+        (phase != 0 && (pages || count))) {
+        return -ESTALE;
+    }
+    observer = qatomic_load_acquire(&root_transaction_observer);
+    if (!observer) {
+        return -ENOSYS;
+    }
+    memset(root, 0, 32);
+    *logical_bytes = 0;
+    if (phase == 2) {
+        uint8_t discarded_root[32];
+        uint64_t discarded_bytes;
+
+        /* Abort still closes the original pending candidate. Its private
+         * cleanup result is not an identity or an initiating failure. */
+        return observer(phase, transaction, topology, pages, count,
+                        discarded_root, &discarded_bytes);
+    }
+    if (qemu_crucible_ram_diagnostic_failure()) {
+        return qemu_crucible_ram_diagnostic_failure();
+    }
+    return diagnostic_root_result(
+        observer(phase, transaction, topology, pages, count, root, logical_bytes),
+        root, logical_bytes);
+}
