+        &vmstate_test_fingerprint_projection, &state, &error_abort);
+    second = capture_test_fingerprint_projection(
+        &vmstate_test_fingerprint_projection, &state, &error_abort);
+    g_assert_true(g_bytes_equal(first, second));
+    g_assert_cmphex(state.migration_shadow, ==, 0xfeedfaceULL);
+    g_assert_cmpuint(state.pre_save_calls, ==, 0);
+    g_assert_cmpuint(state.needed_calls, ==, 0);
+    g_assert_cmpuint(state.field_exists_calls, ==, 0);
