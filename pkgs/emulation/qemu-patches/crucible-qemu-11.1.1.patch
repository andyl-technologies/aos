+    void *read_mapping = mmap(NULL, RAM_PAGE_BYTES, PROT_READ,
+                             MAP_SHARED, sealed, RAM_PAGE_BYTES);
+    assert(read_mapping != MAP_FAILED);
+    block = region(read_mapping, RAM_PAGE_BYTES, sealed, RAM_SHARED | RAM_READONLY);
+    block.fd_offset = RAM_PAGE_BYTES;
+    assert(arena_placement_authority(&block, &flags) == 0);
+    assert(flags == (QEMU_PLUGIN_CRUCIBLE_RAM_ARENA_PINNED |
+                     QEMU_PLUGIN_CRUCIBLE_RAM_ARENA_IMMUTABLE_FILE |
+                     QEMU_PLUGIN_CRUCIBLE_RAM_ARENA_HOST_READONLY));
