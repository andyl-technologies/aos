+static int ram_control_pause_begin(QemuCrucibleRamActorPause **out,
+                                    QemuCrucibleCheckpointRequestLoan *request,
+                                    bool inventory_pending)
+{
+    QemuCrucibleRamControlActor *actor = &startup_source.ram_control_actor;
+    QemuCrucibleRamActorPause *pause = request ? &actor->request_pause : &actor->pause;
+    int status;
+
+    if (!out || !bql_locked() || qemu_in_coroutine()) {
+        return -EPERM;
+    }
+    if (request) {
+        status = qemu_crucible_checkpoint_request_actor_current_v1(request, actor);
+        if (status) {
+            return status;
+        }
+    }
+    if (!actor->attempted) {
+        if (request ||
+            qatomic_load_acquire(&startup_source.process_purpose_complete)) {
+            /* Selected Source cannot use legacy service membership as a
+             * substitute for the qualified endpoint-owning actor. */
+            return -ENOKEY;
+        }
+        *out = NULL;
+        return 0;
+    }
+    if (!qemu_thread_is_self(&actor->creator) ||
+        !actor->dispatch_mutex_initialized ||
+        !qatomic_load_acquire(&actor->born) ||
+        !qatomic_load_acquire(&actor->ready) ||
+        !qatomic_load_acquire(&actor->service_registered) ||
+        actor->process != getpid()) {
+        return -EINPROGRESS;
+    }
+    status = pthread_mutex_trylock(&actor->dispatch_mutex);
+    if (status) {
+        /* This exact short-contention cut has made no pause/census effects. */
+        return inventory_pending && status == EBUSY ?
+            QEMU_CRUCIBLE_RAM_OWNER_INVENTORY_PENDING_RECORD : -status;
+    }
+    if (actor->quiesce_requested ||
+        (pause->end.entered && !pause->end.complete) ||
+        pause->held || (pause->requested &&
+                        pause->owner_thread != qemu_get_thread_id())) {
+        pthread_mutex_unlock(&actor->dispatch_mutex);
+        return -EBUSY;
+    }
+    pause->actor = actor;
+    /* A retried requested loan preserves its actual bank-return journal. */
+    if (!pause->requested) {
+        memset(&pause->end, 0, sizeof(pause->end));
+        pause->receipt_returned = false;
+    }
+    pause->request = request;
+    pause->binding = actor->thread_binding;
+    pause->process = getpid();
+    pause->owner_thread = qemu_get_thread_id();
+    pause->thread_id = actor->thread_id;
+    pause->service_generation = actor->service_generation;
+    qatomic_store_release(&pause->requested, true);
+    *out = pause;
+    status = qemu_crucible_ram_control_actor_contract_current(actor);
+    if (!status && (qatomic_load_acquire(&actor->terminal_pending) ||
+                   actor->returned || actor->first_status || actor->post_status ||
+                   actor->receipt.uncertain)) {
+        status = -ESTALE;
+    }
+    if (!status && (actor->record_in_flight ||
+                   actor->receipt.record.callback_active ||
+                   (actor->receipt.record.held &&
+                    (!actor->receipt.moved ||
+                     !actor->receipt.record.end_returned ||
+                     actor->receipt.record.end_result ||
+                     actor->receipt.record.terminal_journal !=
+                         QEMU_PLUGIN_CRUCIBLE_RAM_RECORD_TERMINAL_COMPLETED ||
+                     actor->receipt.record.completion_result)) ||
+                   (!actor->receipt.moved &&
+                    (actor->receipt.frame_bytes || actor->receipt.alias_count)))) {
+        status = inventory_pending ?
+            QEMU_CRUCIBLE_RAM_OWNER_INVENTORY_PENDING_RECORD : -EAGAIN;
+    }
+    if (status) {
+        /* Requested gate remains retained; partial work can drain its loan. */
+        pthread_mutex_unlock(&actor->dispatch_mutex);
+        return status;
+    }
+    /* The nominal lease retains the gate and exit exclusion. Unlock before
+     * registry capture or any subsystem/module callback. */
+    qatomic_store_release(&pause->held, true);
+    pthread_mutex_unlock(&actor->dispatch_mutex);
+    return 0;
+}
