@@ -0,0 +1,91 @@
+/*
+ * Native managed-RAM realization receipt
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef SYSTEM_CRUCIBLE_OBSERVATION_REALIZATION_H
+#define SYSTEM_CRUCIBLE_OBSERVATION_REALIZATION_H
+
+#include "qapi/error.h"
+#include "qom/object.h"
+
+typedef struct QemuCrucibleObservationConstructionBinding
+    QemuCrucibleObservationConstructionBinding;
+typedef struct QemuCrucibleObservationBootFrame
+    QemuCrucibleObservationBootFrame;
+typedef struct QemuCrucibleObservationManagedReceipt
+    QemuCrucibleObservationManagedReceipt;
+
+/* Exact native body request. A genuine construction Source debit must precede
+ * publication; later inventory/native_floor accounting cannot issue it. */
+size_t qemu_crucible_observation_boot_body_bytes_v1(void);
+size_t qemu_crucible_observation_boot_body_alignment_v1(void);
+size_t qemu_crucible_observation_realization_metadata_bytes_v1(void);
+
+/* The genuine early class0 binding pays the exact aggregate before this
+ * producer publishes a pending owner. Nonnull output retains return custody
+ * independently of signed admission. CPU closure has no own-CPU exemption. */
+int qemu_crucible_observation_boot_begin_v1(
+    QemuCrucibleObservationConstructionBinding *binding,
+    QemuCrucibleObservationBootFrame **out);
+/* Reciprocal callback-free actual native birth and physical return receipts
+ * for Source. They issue no Original/time/payment and accept no scalar proof. */
+int qemu_crucible_observation_boot_birth_current_v1(
+    QemuCrucibleObservationConstructionBinding *binding);
+int qemu_crucible_observation_boot_return_current_v1(
+    QemuCrucibleObservationConstructionBinding *binding);
+int qemu_crucible_observation_boot_current_v1(
+    QemuCrucibleObservationBootFrame *frame);
+int qemu_crucible_observation_boot_identity_v1(
+    QemuCrucibleObservationBootFrame **out);
+int qemu_crucible_observation_boot_identity_return_v1(
+    QemuCrucibleObservationBootFrame **owner);
+
+/* Only the actual paging_requested seal caller may attach this classification.
+ * A nonnull output owns return even when the original checks fail. This grants
+ * neither live writer closure nor Source time, and does not seal the graph. */
+int qemu_crucible_observation_managed_acquire_v1(
+    QemuCrucibleObservationBootFrame *frame,
+    QemuCrucibleObservationManagedReceipt **out, Error **errp);
+int qemu_crucible_observation_managed_classification_current_v1(
+    QemuCrucibleObservationManagedReceipt *receipt);
+int qemu_crucible_observation_managed_runtime_current_v1(
+    QemuCrucibleObservationManagedReceipt *receipt);
+int qemu_crucible_observation_managed_identity_return_v1(
+    QemuCrucibleObservationManagedReceipt **owner);
+
+#ifdef CONFIG_LINUX
+/* The actual private QOM allocator request carries selected Type geometry.
+ * Source must debit its own header, receipt storage and payload before birth. */
+int qemu_crucible_cpu_allocation_request_current_v1(
+    QemuCrucibleCpuAllocationRequest *request,
+    QemuCrucibleObservationConstructionBinding **actual_binding,
+    size_t *bytes, size_t *alignment);
+#ifdef CONFIG_PLUGIN
+int qemu_crucible_cpu_tlb_storage_constructor_identity_v1(
+    QemuCrucibleCpuTlbStorageRequest *request,
+    QemuCrucibleObservationConstructionBinding **binding,
+    QemuCrucibleCpuSourceAllocationOwner **parent_owner, uint64_t *serial);
+int qemu_crucible_cpu_tlb_storage_constructor_current_v1(
+    QemuCrucibleCpuTlbStorageRequest *request,
+    QemuCrucibleObservationConstructionBinding **binding,
+    QemuCrucibleCpuSourceAllocationOwner **parent_owner, uint64_t *serial);
+#endif
+/* Pair the actual request with its immutable entered serial. Reusing the
+ * pending slot cannot lend an earlier allocation owner's paid storage. */
+int qemu_crucible_cpu_allocation_request_serial_v1(
+    QemuCrucibleCpuAllocationRequest *request, uint64_t *serial);
+int qemu_crucible_cpu_allocation_result_current_v1(
+    QemuCrucibleCpuAllocationRequest *request,
+    QemuCrucibleCpuSourceAllocationOwner *owner, void **actual_payload);
+/* Return succeeds only after exact pre-effect abandonment or the matching
+ * allocator's real free return. Null payloads and Source status prove neither. */
+int qemu_crucible_cpu_allocation_returned_current_v1(
