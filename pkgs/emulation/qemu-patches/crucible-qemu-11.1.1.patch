+int qemu_crucible_ram_inventory_capture_end_v1(QemuCrucibleRamInventoryCaptureLoan **owner)
+{
+    QemuCrucibleRamInventoryCaptureLoan *loan;
+    CrucibleRamInventory *alias;
+    int first = 0, status;
+
+    if (!owner || *owner != &inventory_capture) {
+        return -EPERM;
+    }
+    loan = *owner;
+    status = inventory_capture_return_identity(loan->parent, loan);
+    if (status) {
+        return status;
+    }
+    if (loan->source_capture) {
+        status = qemu_crucible_checkpoint_inventory_capture_return_v1(
+            loan->parent, &loan->source_capture);
+        if (status && !loan->return_status) {
+            loan->return_status = status;
+        }
+        if (loan->source_capture) {
+            return status ? status : -EBUSY;
+        }
+        first = status;
+    }
+    alias = loan->regions;
+    status = region_inventory_return(&loan->regions, &loan->inventory_return);
+    if (!first) {
+        first = status;
+    }
+    if (!loan->regions && (!alias || loan->inventory_return.consumed)) {
+        if (capture_regions == alias) {
+            capture_regions = NULL;
+        }
+        capture_active = false;
+        capture_observation_only = false;
+    }
+    loan->cleanup_pending = inventory_return_pending(&loan->inventory_return);
+    loan->physically_returned = !loan->source_capture && !loan->regions &&
+        loan->inventory_return.disposition.physical != RAM_PHYSICAL_PENDING;
+    if (loan->cleanup_pending || !loan->physically_returned) {
+        return first ? first : -EBUSY;
+    }
+    loan->active = false;
+    loan->pinning = false;
+    *owner = NULL;
+    return first ? first : loan->return_status;
+}
