+static int reinitialize_child_resources(void *opaque)
+{
+    ChildResourceReinitializer *reinitializer = opaque;
+
+    reinitializer->called = true;
+    reinitializer->installed_mapping = mmap(
+        reinitializer->address, reinitializer->length,
+        PROT_READ | PROT_WRITE, MAP_SHARED | MAP_FIXED_NOREPLACE,
+        reinitializer->backing_fd, 0);
+    if (reinitializer->installed_mapping == MAP_FAILED) {
+        return -errno;
+    }
+    return 0;
+}
