diff --git a/target/xtensa/timer.h b/target/xtensa/timer.h
new file mode 100644
index 0000000000000000000000000000000000000000..62d2fadbdd0eceb80c85f8fdf271a4ab6f674216
--- /dev/null
+++ b/target/xtensa/timer.h
@@ -0,0 +1,54 @@
+/*
+ * Xtensa timer conversion helpers.
+ *
+ * SPDX-License-Identifier: BSD-3-Clause
+ */
+
+#ifndef XTENSA_TIMER_H
+#define XTENSA_TIMER_H
+
+#include "hw/core/clock.h"
+#include "qemu/timer.h"
+
+static inline uint32_t xtensa_clock_ps_to_ticks(const Clock *clock,
+                                                __int128 time_ps)
+{
+    __int128 divisor = (__int128)clock_get(clock) *
+                       PICOSECONDS_PER_NANOSECOND;
+    __int128 dividend;
+    __int128 ticks;
+
+    if (!divisor) {
+        return 0;
+    }
+    dividend = time_ps * ((__int128)1 << 32);
+    ticks = dividend / divisor;
+    if (dividend < 0 && dividend % divisor) {
+        ticks--;
+    }
+    return (uint32_t)ticks;
+}
+
+static inline __int128 xtensa_clock_ticks_to_ps(const Clock *clock,
+                                                uint64_t ticks)
+{
+    __uint128_t dividend = (__uint128_t)clock_get(clock) * ticks *
+                           PICOSECONDS_PER_NANOSECOND;
+    __uint128_t divisor = (__uint128_t)1 << 32;
+
+    return (dividend + divisor - 1) / divisor;
+}
+
+static inline __int128 xtensa_ccompare_deadline_ps(const Clock *clock,
+                                                   __int128 now_ps,
+                                                   uint64_t ticks)
+{
+    const __int128 horizon_ps = (__int128)INT64_MAX *
+                                PICOSECONDS_PER_NANOSECOND + 999;
+    __int128 delay_ps = xtensa_clock_ticks_to_ps(clock, ticks);
+
+    return now_ps >= horizon_ps || delay_ps > horizon_ps - now_ps ?
+        horizon_ps : now_ps + delay_ps;
+}
+
+#endif
