+/*
+ * Actual s390 TOD conversion over the supported picosecond domain.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "target/s390x/tcg/s390-tod.h"
+
+typedef struct TODVector {
+    const char *name;
+    int64_t ps_high;
+    uint64_t ps_low;
+    int64_t units_high;
+    uint64_t units_low;
+} TODVector;
+
+/* Exact floor(ps * 4096 / 1000000), computed with arbitrary precision. */
+static const TODVector vectors[] = {
+    { "zero",
+      INT64_C(0), UINT64_C(0),
+      INT64_C(0), UINT64_C(0) },
+    { "one",
+      INT64_C(0), UINT64_C(1),
+      INT64_C(0), UINT64_C(0) },
+    { "negative-one",
+      -INT64_C(1), UINT64_C(18446744073709551615),
+      -INT64_C(1), UINT64_C(18446744073709551615) },
+    { "tick-before",
+      INT64_C(0), UINT64_C(244),
+      INT64_C(0), UINT64_C(0) },
+    { "tick-after",
+      INT64_C(0), UINT64_C(245),
+      INT64_C(0), UINT64_C(1) },
+    { "negative-tick-before",
+      -INT64_C(1), UINT64_C(18446744073709551372),
+      -INT64_C(1), UINT64_C(18446744073709551615) },
+    { "negative-tick-after",
+      -INT64_C(1), UINT64_C(18446744073709551371),
+      -INT64_C(1), UINT64_C(18446744073709551614) },
+    { "microsecond-before",
+      INT64_C(0), UINT64_C(999999),
+      INT64_C(0), UINT64_C(4095) },
+    { "microsecond",
+      INT64_C(0), UINT64_C(1000000),
+      INT64_C(0), UINT64_C(4096) },
+    { "microsecond-after",
+      INT64_C(0), UINT64_C(1000001),
+      INT64_C(0), UINT64_C(4096) },
+    { "negative-microsecond-before",
+      -INT64_C(1), UINT64_C(18446744073708551617),
+      -INT64_C(1), UINT64_C(18446744073709547520) },
+    { "negative-microsecond",
+      -INT64_C(1), UINT64_C(18446744073708551616),
+      -INT64_C(1), UINT64_C(18446744073709547520) },
+    { "negative-microsecond-after",
+      -INT64_C(1), UINT64_C(18446744073708551615),
+      -INT64_C(1), UINT64_C(18446744073709547519) },
+    { "ns-horizon",
+      INT64_C(500), UINT64_C(357),
+      INT64_C(2), UINT64_C(885443715538058479) },
+    { "negative-ns-horizon",
+      -INT64_C(501), UINT64_C(18446744073709551259),
+      -INT64_C(3), UINT64_C(17561300358171493136) },
+    { "wide",
+      INT64_C(72057594037927936), UINT64_C(357),
+      INT64_C(295147905179352), UINT64_C(15234354273737475460) },
+    { "negative-wide",
+      -INT64_C(72057594037927937), UINT64_C(18446744073709551259),
+      -INT64_C(295147905179353), UINT64_C(3212389799972076155) },
+    { "maximum",
+      INT64_C(9223372036854775807), UINT64_C(18446744073709551615),
+      INT64_C(37778931862957161), UINT64_C(13089219298893939121) },
+    { "minimum",
+      INT64_MIN, UINT64_C(0),
+      -INT64_C(37778931862957162), UINT64_C(5357524774815612494) },
+    { "minimum-next",
+      INT64_MIN, UINT64_C(1),
+      -INT64_C(37778931862957162), UINT64_C(5357524774815612494) },
+};
+
+static __int128 join_words(int64_t high, uint64_t low)
+{
+    return (__int128)high * ((__int128)1 << 64) + low;
+}
+
+static void test_conversion(gconstpointer data)
+{
+    const TODVector *vector = data;
+    __int128 ps = join_words(vector->ps_high, vector->ps_low);
+    __int128 expected = join_words(vector->units_high, vector->units_low);
+    __uint128_t base = ((__uint128_t)37 << 64) | (UINT64_MAX - 7);
+    __uint128_t expected_clock = base + (__uint128_t)expected;
+    uint8_t high = 37;
+    uint64_t low = UINT64_MAX - 7;
+
+    g_assert_true(ps2tod(ps) == expected);
+    s390_tod_add_ps(&high, &low, ps);
+    g_assert_cmpuint(high, ==, (uint8_t)(expected_clock >> 64));
+    g_assert_cmpuint(low, ==, (uint64_t)expected_clock);
+}
+
+static void test_nanosecond_projection(void)
+{
+    const uint64_t nanoseconds[] = {
+        0, 1, 124, 125, 126, 999, 1000, UINT32_MAX,
+    };
+
+    for (unsigned index = 0; index < G_N_ELEMENTS(nanoseconds); index++) {
+        uint64_t ns = nanoseconds[index];
+
+        g_assert_cmpuint((uint64_t)ps2tod((__int128)ns * 1000),
+                         ==, time2tod(ns));
+    }
+
+    /* Preserve the existing ordinary helper's large-value projection. */
+    g_assert_cmpuint(time2tod(UINT64_MAX), ==, UINT64_C(1770887431076116856));
+    g_assert_cmpuint((uint64_t)ps2tod((__int128)UINT64_MAX * 1000),
+                     ==, UINT64_C(1770887431076116951));
+}
+
+static void test_canonical_distance(void)
+{
+    const __int128 distances[] = {
+        0, 1, -1, ((__int128)1 << 71) - 1, -((__int128)1 << 71),
+    };
+
+    for (unsigned index = 0; index < G_N_ELEMENTS(distances); index++) {
+        __int128 distance = distances[index];
+        __int128 numerator = distance * PICOSECONDS_PER_MICROSECOND;
+        __int128 expected = numerator / TOD_UNITS_PER_MICROSECOND +
+                            (numerator % TOD_UNITS_PER_MICROSECOND > 0);
+        uint8_t high = (uint8_t)((__uint128_t)distance >> 64);
+        uint64_t low = distance;
+
+        g_assert_true(s390_tod_delta(high, low, 0, 0) == distance);
+        g_assert_true(tod2ps_ceil(distance) == expected);
+    }
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    for (unsigned index = 0; index < G_N_ELEMENTS(vectors); index++) {
+        g_autofree char *name = g_strdup_printf("/s390/tod/%s",
+                                               vectors[index].name);
+
+        g_test_add_data_func(name, &vectors[index], test_conversion);
+    }
+    g_test_add_func("/s390/tod/nanosecond-projection",
+                    test_nanosecond_projection);
+    g_test_add_func("/s390/tod/canonical-distance", test_canonical_distance);
+    return g_test_run();
+}
