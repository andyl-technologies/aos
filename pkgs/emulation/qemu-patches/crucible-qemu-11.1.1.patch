+    session.snapshot_busy = false;
+    session.module_borrowed = true;
+    session.module_observation.descriptor = 9;
+    g_assert_cmpint(preexec_publisher_module_base_current(&session), ==, -EBUSY);
+    g_assert_cmpint(preexec_publisher_module_drop(&session, &service), ==, -EBUSY);
+    session.module_observation.descriptor = -1;
+    session.module_observation.close_uncertain = true;
+    g_assert_cmpint(preexec_publisher_module_base_current(&session), ==, -EBUSY);
+    g_assert_cmpint(preexec_publisher_module_drop(&session, &service), ==, -EBUSY);
+    session.module_observation.close_uncertain = false;
+    g_assert_cmpint(preexec_publisher_module_drop(&session, &service), ==, 0);
+    g_assert_cmpint(session.module_service == NULL, ==, true);
+    g_assert_cmpint(session.module_returned, ==, true);
+
+    g_assert_true(preexec_publisher_module_output_disjoint(span, sizeof(span)));
