+            "static int startup_failure("),
+        "watcher": lambda: declaration_block(
+            "plugins/api-system.c",
+            "struct QemuCrucibleFingerprintWakeWatcher {",
+            "size_t qemu_plugin_crucible_wake_watcher_storage_bytes_v1("),
+        "drain": lambda: EXTRACT["body_cut"](
+            api,
+            "static int qemu_plugin_wake_fd = -1;",
+            "static QemuMutex qemu_plugin_crucible_resource_lock;"),
+        "wake-notifiers": lambda: EXTRACT["body_cut"](
+            api,
+            "static NotifierList qemu_plugin_wake_notifiers =",
+            "qemu_plugin_vcpu_idle_resume_cb_t qemu_plugin_control_boundary_cb;"),
+        "resume-userdata": lambda: EXTRACT["unique_line"](
+            api, "void *qemu_plugin_vcpu_idle_resume_userdata;"),
+        "resume-context": lambda: EXTRACT["body_cut"](
+            api,
+            "static __thread CPUState *qemu_plugin_crucible_resume_callback_cpu;",
+            "static __thread bool qemu_plugin_crucible_idle_wait_issued;"),
+        "selected-process": lambda: EXTRACT["unique_line"](
+            (ROOT / "util/osdep.c").read_text(),
+            "int qemu_crucible_selected_process_id;"),
+        "plugin": lambda: "struct qemu_plugin_state plugin;\n",
+    }
+    if groups is None:
+        return "\n\n".join(select() for select in output.values())
+    selected = set().union(*(DECLARATION_GROUPS[group] for group in groups))
+    return "\n\n".join(select() for name, select in output.items() if name in selected)
+
+
+def dependencies(production, groups=None):
+    """Add actual implementations once, sharing the fixture's callback slots."""
+    selected = []
+    original = list(EXTRACT["function_definitions"](production))
+    existing = {name for name, _, _, _ in original}
+    functions = (None if groups is None else
+                 set().union(*(FUNCTION_GROUPS[group] for group in groups)))
+    boundaries = (None if groups is None else
+                  set().union(*(UNAVAILABLE_GROUPS[group] for group in groups)))
+    for path, names in FUNCTIONS.items():
+        needed = [name for name in names if name not in existing
+                  and (functions is None or name in functions)]
+        if needed:
+            available = definitions(path)
+            selected.extend(available[name] for name in needed)
+    unavailable = []
+    for path, names in UNAVAILABLE.items():
+        needed = [name for name in names if name not in existing
+                  and (boundaries is None or name in boundaries)]
+        if needed:
+            available = definitions(path)
+            for name in needed:
+                signature = available[name].split("{", 1)[0].rstrip()
+                unavailable.append(signature + "\n{\n    g_assert_not_reached();\n}\n")
+    # All bodies remain whole; prototypes only resolve their original order.
+    bodies = selected + unavailable
+    prototypes = [body.split("{", 1)[0].rstrip() + ";"
+                  for body in [entry[3] for entry in original] + bodies]
+    return "\n\n".join(prototypes + bodies)
