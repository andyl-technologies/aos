diff --git a/hw/isa/lpc-ich9-fingerprint.h b/hw/isa/lpc-ich9-fingerprint.h
new file mode 100644
index 0000000000000000000000000000000000000000..5da51a53f39411e63b3288e35d4e7fd8b037ca4a
--- /dev/null
+++ b/hw/isa/lpc-ich9-fingerprint.h
@@ -0,0 +1,118 @@
+/*
+ * ICH9 LPC fingerprint projection internals
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef HW_ISA_LPC_ICH9_FINGERPRINT_H
+#define HW_ISA_LPC_ICH9_FINGERPRINT_H
+
+#include "hw/acpi/ich9.h"
+#include "migration/qemu-file.h"
+#include "qapi/error.h"
+
+static inline void ich9_crucible_clock_fingerprint_projection(
+    QEMUFile *f, const ACPIPMTimer *timer)
+{
+    bool present = timer->crucible_timer_arm_sequence != 0;
+
+    qemu_put_byte(f, present);
+    if (present) {
+        qemu_put_be64(f, timer->crucible_guest_deadline_ns);
+        qemu_put_be64(f, timer->crucible_transform_generation);
+        qemu_put_be64(f, timer->crucible_timer_arm_sequence);
+    }
+}
+
+static inline bool ich9_hotplug_fingerprint_validate(
+    const ICH9LPCPMRegs *pm, Error **errp)
+{
+    if (pm->cpuhp_state.dev_count > 4096 ||
+        (pm->cpuhp_state.dev_count != 0 && !pm->cpuhp_state.devs) ||
+        pm->acpi_memory_hotplug.dev_count > ACPI_MAX_RAM_SLOTS ||
+        (pm->acpi_memory_hotplug.dev_count != 0 &&
+         !pm->acpi_memory_hotplug.devs)) {
+        error_setg(errp, "ICH9 LPC fingerprint has invalid hotplug geometry");
+        return false;
+    }
+
+    for (uint32_t i = 0; i < pm->cpuhp_state.dev_count; i++) {
+        const AcpiCpuStatus *status = &pm->cpuhp_state.devs[i];
+
+        if (status->fw_remove) {
+            error_setg(errp,
+                       "ICH9 LPC cannot restore a pending firmware CPU "
+                       "removal");
+            return false;
+        }
+    }
+
+    for (uint32_t i = 0; i < pm->acpi_memory_hotplug.dev_count; i++) {
+        const MemStatus *status = &pm->acpi_memory_hotplug.devs[i];
+
+        if (status->is_removing) {
+            error_setg(errp,
+                       "ICH9 LPC cannot restore a pending memory removal");
+            return false;
+        }
+    }
+
+    if (pm->acpi_pci_hotplug.use_acpi_hotplug_bridge) {
+        for (size_t i = 0;
+             i < ARRAY_SIZE(
+                 pm->acpi_pci_hotplug.acpi_pcihp_pci_status); i++) {
+            if (pm->acpi_pci_hotplug.acpi_pcihp_pci_status[i].down != 0) {
+                error_setg(errp,
+                           "ICH9 LPC cannot project a pending PCI removal");
+                return false;
+            }
+        }
+    }
+
+    return true;
+}
+
+static inline void ich9_hotplug_fingerprint_put(
+    QEMUFile *f, const ICH9LPCPMRegs *pm)
+{
+    qemu_put_be32(f, pm->cpuhp_state.selector);
+    qemu_put_byte(f, pm->cpuhp_state.command);
+    qemu_put_be32(f, pm->cpuhp_state.dev_count);
+    for (uint32_t i = 0; i < pm->cpuhp_state.dev_count; i++) {
+        const AcpiCpuStatus *status = &pm->cpuhp_state.devs[i];
+
+        qemu_put_be64(f, status->arch_id);
+        qemu_put_byte(f, status->cpu != NULL);
+        qemu_put_byte(f, status->is_inserting);
+        qemu_put_byte(f, status->is_removing);
+        qemu_put_be32(f, status->ost_event);
+        qemu_put_be32(f, status->ost_status);
+    }
+
+    qemu_put_be32(f, pm->acpi_memory_hotplug.selector);
+    qemu_put_be32(f, pm->acpi_memory_hotplug.dev_count);
+    for (uint32_t i = 0; i < pm->acpi_memory_hotplug.dev_count; i++) {
+        const MemStatus *status = &pm->acpi_memory_hotplug.devs[i];
+
+        qemu_put_byte(f, status->dimm != NULL);
+        qemu_put_byte(f, status->is_enabled);
+        qemu_put_byte(f, status->is_inserting);
+        qemu_put_be32(f, status->ost_event);
+        qemu_put_be32(f, status->ost_status);
+    }
+
+    qemu_put_byte(f, pm->acpi_pci_hotplug.use_acpi_hotplug_bridge);
+    if (pm->acpi_pci_hotplug.use_acpi_hotplug_bridge) {
+        qemu_put_be32(f, pm->acpi_pci_hotplug.hotplug_select);
+        qemu_put_be32(f, pm->acpi_pci_hotplug.acpi_index);
+        for (size_t i = 0;
+             i < ARRAY_SIZE(
+                 pm->acpi_pci_hotplug.acpi_pcihp_pci_status); i++) {
+            const AcpiPciHpPciStatus *status =
+                &pm->acpi_pci_hotplug.acpi_pcihp_pci_status[i];
+
+            qemu_put_be32(f, status->up);
+        }
+    }
+}
+
+#endif
