+static void fixture_be32(uint8_t *wire, size_t offset, uint32_t value)
+{
+    for (size_t index = 0; index < 4; index++) {
+        wire[offset + index] = value >> (8 * (3 - index));
+    }
+}
+
+static void fixture_be64(uint8_t *wire, size_t offset, uint64_t value)
+{
+    for (size_t index = 0; index < 8; index++) {
+        wire[offset + index] = value >> (8 * (7 - index));
+    }
+}
+
+static void fixture_record(uint8_t *wire, uint32_t scope, uint64_t device)
+{
+    memset(wire, 0, 128);
+    memcpy(wire, "CRUCWSP1", 8);
+    fixture_be32(wire, 8, 1);
+    fixture_be32(wire, 12, scope);
+    for (size_t index = 0; index < 32; index++) {
+        wire[16 + index] = 0xa0 + index;
+    }
+
+    fixture_be64(wire, 48, FIXTURE_TOTAL);
+    fixture_be64(wire, 56, FIXTURE_METADATA);
+    fixture_be64(wire, 64, FIXTURE_RESIDENT);
+    fixture_be64(wire, 72, FIXTURE_PROCESS);
+    fixture_be64(wire, 80, FIXTURE_ACCOUNT);
+    fixture_be64(wire, 88, FIXTURE_WORKSPACE);
+    fixture_be64(wire, 96, device);
+    fixture_be64(wire, 104, FIXTURE_INODE);
+    fixture_be32(wire, 112, FIXTURE_FD_PEAK);
+    fixture_be32(wire, 116, FIXTURE_VMA_PEAK);
+    fixture_be64(wire, 120, 65536);
+}
+
+static void assert_record(const QemuCrucibleDeviceWorkspaceWireRecord *record,
+                          uint32_t scope, uint64_t device)
+{
+    g_assert_cmpuint(record->schema_version, ==, 1);
+    g_assert_cmpuint(record->scope, ==, scope);
+    for (size_t index = 0; index < 32; index++) {
+        g_assert_cmpuint(record->source_proof_digest[index], ==, 0xa0 + index);
+    }
+
+    g_assert_true(record->original_total_bytes == FIXTURE_TOTAL);
+    g_assert_true(record->metadata_charge_bytes == FIXTURE_METADATA);
+    g_assert_true(record->resident_charge_bytes == FIXTURE_RESIDENT);
+    g_assert_true(record->process_generation == FIXTURE_PROCESS);
+    g_assert_true(record->account_generation == FIXTURE_ACCOUNT);
+    g_assert_true(record->workspace_generation == FIXTURE_WORKSPACE);
+    g_assert_true(record->workspace_device == device);
+    g_assert_true(record->workspace_inode == FIXTURE_INODE);
+    g_assert_cmpuint(record->native_fd_peak, ==, FIXTURE_FD_PEAK);
+    g_assert_cmpuint(record->native_vma_peak, ==, FIXTURE_VMA_PEAK);
+    g_assert_true(record->workspace_length == 65536);
+}
+
+static void test_record_fields(void)
+{
+    uint8_t wire[128];
+    uint8_t before[128];
+    QemuCrucibleDeviceWorkspaceWireRecord record;
+
+    for (uint32_t scope = 1; scope <= 2; scope++) {
+        for (size_t index = 0; index < 2; index++) {
+            uint64_t device = index ? FIXTURE_DEVICE : 0;
+
+            fixture_record(wire, scope, device);
+            memcpy(before, wire, sizeof(before));
+            g_assert_cmpint(qemu_crucible_device_workspace_decode(
+                                wire, sizeof(wire), &record), ==, 0);
