+/* Resident classification is a property of the actual accepted inventory,
+ * never the absence of a pager callback. This admission-boundary proof is not
+ * used per page; the retained writer loan independently closes RAM writers. */
+int qemu_crucible_ram_fingerprint_resident_retirement_current_v1(
+    qemu_plugin_id_t id, qemu_plugin_crucible_fingerprint_retirement_v1 *loan,
+    qemu_plugin_crucible_fingerprint_operation_v1 *same_operation)
+{
+    qemu_plugin_crucible_fingerprint_operation_v1 *operation = NULL;
+    uint32_t phase = 0;
+    bool inventory_held = false;
+    int status;
+
+    status = qemu_crucible_ram_fingerprint_retirement_phase_current_v1(
+        id, loan, &operation, &phase);
+    if (status) {
+        return status;
+    }
+    if (phase != 1 || !same_operation || operation != same_operation ||
+        loan->frame_serial != fingerprint_root_frame.serial ||
+        !fingerprint_root_writer || capture_active || admission_grant_open ||
+        qemu_crucible_ram_paging_requested() ||
+        !admission_grant_applied || !admission_regions ||
+        !admission_regions->len || loan->regions != admission_regions ||
+        admission.region_count != admission_regions->len ||
+        loan->topology != admission.topology_generation ||
+        loan->topology != qatomic_read(&topology_generation) ||
+        loan->dirty != qatomic_read(&dirty_generation)) {
+        return -ESTALE;
+    }
+    for (size_t index = 0; index < G_N_ELEMENTS(inventory_owners); index++) {
+        const CrucibleRamInventoryOwner *owner = &inventory_owners[index];
+
+        if (qatomic_load_acquire(&owner->state) == RAM_INVENTORY_LIVE &&
+            owner->array == loan->regions &&
+            owner->container_owner.admission.charge.held &&
+            owner->references >= 2) {
+            inventory_held = true;
+            break;
+        }
+    }
+    if (!inventory_held) {
+        return -EPERM;
+    }
+    status = qemu_crucible_observation_writer_current_v1(fingerprint_root_writer);
+    if (status) {
+        return status;
+    }
+    WITH_RCU_READ_LOCK_GUARD() {
+        for (size_t index = 0; index < loan->regions->len; index++) {
+            const CrucibleRamRegion *region = region_inventory_index(loan->regions, index);
+            RAMBlock *block, *live = NULL;
+            uint64_t length = region->descriptor.logical_length;
+            uintptr_t begin = region->admitted_resident_host;
+            uintptr_t end;
+
+            RAMBLOCK_FOREACH(block) {
+                if (block == region->block) {
+                    live = block;
+                    break;
+                }
+            }
+            if (!live || !region->metadata_owner.admission.charge.held || !begin ||
+                !region->admitted_resident_region ||
+                live->mr != region->admitted_resident_region ||
+                !region_has_logical_ram_backing(live) ||
+                (uintptr_t)live->host != begin || live->used_length != length ||
+                live->offset != region->fingerprint_ram_offset ||
+                strlen(live->idstr) != region->descriptor.id_length ||
+                memcmp(live->idstr, region->descriptor.id, region->descriptor.id_length) ||
+                !length || length > (ram_addr_t)-1 - live->offset ||
+                (live->offset & (TARGET_PAGE_SIZE - 1)) ||
+                (begin & (TARGET_PAGE_SIZE - 1)) ||
+                length > UINT64_MAX - (TARGET_PAGE_SIZE - 1) ||
+                TARGET_PAGE_ALIGN(length) > live->max_length ||
+                TARGET_PAGE_ALIGN(length) > UINTPTR_MAX - begin) {
+                return -ESTALE;
+            }
+            end = begin + TARGET_PAGE_ALIGN(length);
+            for (size_t other = 0; other < index; other++) {
+                const CrucibleRamRegion *prior = region_inventory_index(loan->regions, other);
+                uintptr_t prior_begin = prior->admitted_resident_host;
+                uintptr_t prior_end = prior_begin +
+                    TARGET_PAGE_ALIGN(prior->descriptor.logical_length);
+
+                if (begin < prior_end && prior_begin < end) {
+                    return -ENOTSUP;
+                }
+            }
+        }
+    }
+    /* The independent writer proof remains live across the geometry walk.
+     * Source then checks its SAME entered Original before invoking FPbegin. */
+    status = qemu_crucible_observation_writer_current_v1(fingerprint_root_writer);
+    if (!status && (loan->topology != qatomic_read(&topology_generation) ||
+                    loan->dirty != qatomic_read(&dirty_generation))) {
+        status = -ESTALE;
+    }
+    return status;
+}
