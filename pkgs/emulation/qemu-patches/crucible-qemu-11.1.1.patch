+         index++) {
+        const uint8_t *row = wire + QEMU_PLUGIN_CRUCIBLE_CONTROL_LAYOUT_HEADER_BYTES +
+            index * QEMU_PLUGIN_CRUCIBLE_CONTROL_LAYOUT_ROLE_BYTES;
+        QemuCrucibleProcessPurposeRequest *request = &decoded.requests[index];
+
+        if (ldl_be_p(row) != index + 1 || ldl_be_p(row + 4)) {
+            return -EINVAL;
+        }
+        request->extent = ldq_be_p(row + 8);
+        request->alignment = ldq_be_p(row + 16);
+        request->count = ldq_be_p(row + 24);
+        if (!request->extent || !request->alignment ||
+            (request->alignment & (request->alignment - 1)) ||
+            request->extent % request->alignment || request->count != 1) {
+            return -EINVAL;
+        }
+    }
+    *out = decoded;
+    return 0;
+}
