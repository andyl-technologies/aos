+def check_streaming(source, output):
+    """Compile actual bodies; supplied schema rows are not provider issuers."""
+    extract = runpy.run_path(str(source / "tests/unit/extract-crucible-startup-source-controls.py"))
+    hash_source = (source / "crypto/hash.c").read_text()
+    hash_literal = hash_source[:hash_source.index("static size_t qcrypto_hash_alg_size")]
+    hash_literal = hash_literal.replace('#include "hashpriv.h"',
+                                        '#include "crypto/hashpriv.h"')
+    unit = (source / "tests/unit/test-crypto-hash.c").read_text()
+    checks = 'static const char hex[] = "0123456789abcdef";\n'
+    checks += unit[unit.index("static void test_sha256_caller_vector"):
+                   unit.index("int main(")]
+    vmstate = (source / "plugins/crucible-fault-vmstate.c").read_text()
+    manifest = '#define CRUCIBLE_FAULT_VMSTATE_VERSION 2\n'
+    manifest += 'static GPtrArray *crucible_fault_vmstate_sections;\n'
+    manifest += vmstate[vmstate.index("static const char *const crucible_fault_vmstate_required"):
+                        vmstate.index("static int crucible_fault_vmstate_section_compare")]
+    for signature in ("static int crucible_fault_vmstate_section_compare(",
+                      "static int crucible_fault_vmstate_registry_validate("):
+        manifest += extract["function"](vmstate, signature) + "\n"
+    manifest += vmstate[vmstate.index("typedef int (*CrucibleManifestWrite)"):
+                        vmstate.index("void qemu_crucible_fault_vmstate_put_u8(")]
+    variants = {"stream-positive": (hash_literal, manifest)}
+    omissions = {
+        "name": ("write(opaque, section->name, strlen(section->name) + 1)",
+                 "write(opaque, section->name, 0)"),
+        "name-nul": ("strlen(section->name) + 1);", "strlen(section->name));"),
+        "version": ("write(opaque, version, sizeof(version))",
+                    "write(opaque, version, 0)"),
+        "version-endian": ("stl_be_p(version, section->version)",
+                           "stl_le_p(version, section->version)"),
+        "last-section": ("index < crucible_fault_vmstate_sections->len;",
+                         "index + 1 < crucible_fault_vmstate_sections->len;"),
+        "state-output-disjoint": (
+            "!crucible_manifest_spans_disjoint(hash, sizeof(*hash), out, sizeof(*out))",
+            "false"),
+        "input-disjoint": (
+            "return crucible_manifest_spans_disjoint(hash, sizeof(*hash), input, bytes) &&\n"
+            "        crucible_manifest_spans_disjoint(out, sizeof(*out), input, bytes);",
+            "return true;"),
+    }
+    for name, (old, new) in omissions.items():
+        if old not in manifest:
+            raise ValueError(f"reviewed manifest operation changed: {name}")
+        variants[f"stream-omit-{name}"] = (hash_literal, manifest.replace(old, new, 1))
+    hash_omissions = {
+        "length-limit": ("len > UINT64_MAX / 8 - hash->bytes", "false"),
+        "update-alias": ("!qcrypto_sha256_disjoint(hash, data, len)", "false"),
+        "final-alias": ("!qcrypto_sha256_disjoint(hash, digest, digest_len)", "false"),
+        "final-capacity": ("digest_len != QCRYPTO_HASH_DIGEST_LEN_SHA256", "false"),
+        "final-active": ("!hash->active ||\n        hash->bytes", "false ||\n        hash->bytes"),
+    }
+    for name, (old, new) in hash_omissions.items():
+        if old not in hash_literal:
+            raise ValueError(f"reviewed hash operation changed: {name}")
+        variants[f"stream-omit-{name}"] = (hash_literal.replace(old, new, 1), manifest)
+    allocation_probe = manifest.replace(
+        "status = qcrypto_sha256_init(hash);",
+        "g_checksum_free(g_checksum_new(G_CHECKSUM_SHA256));\n"
+        "    status = qcrypto_sha256_init(hash);", 1)
+    variants["stream-omit-allocation-free"] = (hash_literal, allocation_probe)
+    proof = {}
+    for name, (hash_body, manifest_body) in variants.items():
+        generated = output / f"{name}.c"
+        generated.write_text(
+            hash_body + '\n#include "qemu/crucible-fault.h"\n'
+            '#include "plugins/qemu-plugin.h"\n' +
+            STREAM_ALLOCATION_OBSERVERS + manifest_body + checks + STREAM_CHECKS)
+        binary = output / name
+        command = [*shlex.split(os.environ.get("CC", "cc")),
+                   *shlex.split(os.environ.get("CFLAGS", "")), str(generated),
+                   "-o", str(binary), *shlex.split(os.environ.get("LDFLAGS", ""))]
+        (output / f"{name}.compile-command.json").write_text(json.dumps(command, indent=2) + "\n")
+        compiled = subprocess.run(command, text=True, stdout=subprocess.PIPE,
+                                  stderr=subprocess.STDOUT)
+        (output / f"{name}.compile.log").write_text(compiled.stdout)
+        if compiled.returncode:
+            raise RuntimeError(f"{name} compile failed:\n{compiled.stdout}")
+        result = subprocess.run([str(binary)], text=True, stdout=subprocess.PIPE,
+                                stderr=subprocess.STDOUT, timeout=30, cwd=output)
+        (output / f"{name}.log").write_text(result.stdout)
+        expected = 0 if name == "stream-positive" else -6
+        if result.returncode != expected:
+            raise RuntimeError(f"unexpected {name} outcome: {result.returncode}\n{result.stdout}")
+        proof[name] = {"returncode": result.returncode, "output": result.stdout}
+    (output / "stream-proof.json").write_text(json.dumps(proof, indent=2) + "\n")
+    print(proof["stream-positive"]["output"], end="")
+    print(f"PASS {len(proof) - 1} independently rebuilt streaming omission controls")
