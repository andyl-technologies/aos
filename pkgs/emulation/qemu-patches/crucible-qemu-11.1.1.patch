+static void scenario_decode(void)
+{
+    uint8_t wire[81] = { 0 };
+    QemuCrucibleCheckpointOriginal output, sentinel;
+
+    memcpy(wire, "CRUCPAU1", 8);
+    stl_be_p(wire + 8, 1);
+    stl_be_p(wire + 12, 80);
+    wire[16] = 0x7a;
+    stq_be_p(wire + 48, UINT64_MAX);
+    stq_be_p(wire + 56, 1);
+    stq_be_p(wire + 64, 2);
+    stq_be_p(wire + 72, UINT64_MAX);
+    memset(&output, 0xa5, sizeof(output));
+    sentinel = output;
+    g_assert_cmpint(qemu_crucible_checkpoint_original_decode_v1(
+        wire, 79, &output), ==, -EINVAL);
+    g_assert_cmpmem(&output, sizeof(output), &sentinel, sizeof(sentinel));
+    g_assert_cmpint(qemu_crucible_checkpoint_original_decode_v1(
+        wire, 81, &output), ==, -EINVAL);
+    g_assert_cmpmem(&output, sizeof(output), &sentinel, sizeof(sentinel));
+    for (unsigned offset = 48; offset <= 72; offset += 8) {
+        uint8_t malformed[80];
+
+        memcpy(malformed, wire, 80);
+        stq_be_p(malformed + offset, 0);
+        g_assert_cmpint(qemu_crucible_checkpoint_original_decode_v1(
+            malformed, 80, &output), ==, -EINVAL);
+        g_assert_cmpmem(&output, sizeof(output), &sentinel, sizeof(sentinel));
+    }
+    g_assert_cmpint(qemu_crucible_checkpoint_original_decode_v1(
+        wire, 80, &output), ==, 0);
+    g_assert_cmpuint(output.operation_id, ==, UINT64_MAX);
+    g_assert_cmpuint(output.poll_ns, ==, UINT64_MAX);
+}
