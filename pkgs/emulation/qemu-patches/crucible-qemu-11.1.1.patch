+/* Usable privilege is observed from the kernel before selected receipt and
+ * again before publication/lifetime use. Bounding bits alone confer no usable
+ * capability under no-new-privileges; no retained CAP_SETPCAP/ambient workaround
+ * or capability mutation is introduced by the receiver.
+ */
+static int preexec_setup_kernel_capabilities(void)
+{
+    struct __user_cap_header_struct header = {
+        .version = _LINUX_CAPABILITY_VERSION_3,
+        .pid = 0,
+    };
+    struct __user_cap_data_struct data[_LINUX_CAPABILITY_U32S_3] = { 0 };
+    int identity_status = preexec_setup_identity();
+    long status;
+
+    if (identity_status) {
+        return identity_status;
+    }
+    status = preexec_setup_syscall5(SYS_prctl, PR_GET_NO_NEW_PRIVS, 0, 0, 0, 0);
+    if (status != 1) {
+        return status < 0 ? (int)status : -EPERM;
+    }
+    status = preexec_setup_syscall5(SYS_capget, (long)(uintptr_t)&header,
+                                     (long)(uintptr_t)data, 0, 0, 0);
+    if (status < 0) {
+        return (int)status;
+    }
+    for (size_t index = 0; index < _LINUX_CAPABILITY_U32S_3; index++) {
+        if (data[index].effective || data[index].permitted || data[index].inheritable) {
+            return -EPERM;
+        }
+    }
+    for (unsigned capability = 0; capability < 64; capability++) {
+        status = preexec_setup_syscall5(SYS_prctl, PR_CAP_AMBIENT,
+            PR_CAP_AMBIENT_IS_SET, capability, 0, 0);
+        if (status == -EINVAL && capability > CAP_LAST_CAP) {
+            break;
+        }
+        if (status != 0) {
+            return status < 0 ? (int)status : -EPERM;
+        }
+    }
+    return 0;
+}
+
+static int preexec_setup_capabilities(void)
+{
+    size_t bytes;
+    int status = preexec_setup_kernel_capabilities();
+
+    if (status) {
+        return status;
+    }
+    status = preexec_setup_metadata_read(AT_FDCWD, "/proc/self/status", &bytes);
+    if (status) {
+        return status;
+    }
+    return preexec_setup_status_capabilities(preexec_setup_owner.metadata_bytes, bytes);
+}
