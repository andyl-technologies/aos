+int qemu_crucible_checkpoint_inventory_post_v1(
+    QemuCrucibleCheckpointInventoryLoan *loan, int first_status)
+{
+    uint64_t slice;
+    int status = checkpoint_inventory_identity(loan);
+
+    if (status || loan->observer_invoking) {
+        return status ? status : -EBUSY;
+    }
+    if (first_status > 0) {
+        return -EPROTO;
+    }
+    if (first_status && !loan->first_status) {
+        loan->first_status = first_status;
+        checkpoint_fail(loan->transaction, first_status, false);
+    }
+    if (!loan->post_recorded) {
+        /* Retained inventory remains held through this one independent post.
+         * Its raw result is not the parent's earlier aggregate first failure. */
+        loan->post_status = checkpoint_live_raw(loan->transaction, &slice);
+        loan->post_recorded = true;
+        if (loan->post_status) {
+            checkpoint_fail(loan->transaction, loan->post_status, true);
+        }
+    }
+    return loan->post_status;
+}
