+    /*
+     * The time-advance fence owns the aggregate idle state through its RR FIFO
+     * drain and final main-loop wake.  The plugin commits its pending request
+     * before that drain finishes, so firing another idle callback in this
+     * window could try to arm the next timer witness while QEMU still owns the
+     * current one.
+     */
+    time_advance_pending = qemu_plugin_time_advance_is_pending();
+    if (time_advance_pending) {
+        return QEMU_PLUGIN_CRUCIBLE_IDLE_CALLBACK_COMPLETE;
+    }
+
+    /*
+     * Clear every stale halt bit before any idle callback can observe the
+     * aggregate plugin tracker.  A single interleaved walk could visit a
+     * halted CPU before a later runnable sibling, letting that first callback
+     * authorize an idle-time jump from the preceding all-halted snapshot.
+     */
+    CPU_FOREACH(cpu) {
+        if (!rr_crucible_sim_vcpu_is_halted(cpu)) {
+            qemu_plugin_maybe_fire_vcpu_resume_cb(cpu);
+        }
+        if (qemu_plugin_crucible_vmstop_pending()) {
+            return QEMU_PLUGIN_CRUCIBLE_IDLE_CALLBACK_COMPLETE;
+        }
+    }
+
+    CPU_FOREACH(cpu) {
+        if (rr_crucible_sim_vcpu_is_halted(cpu)) {
+            QemuPluginCrucibleIdleCallbackDisposition disposition;
+
+            disposition = qemu_plugin_maybe_fire_vcpu_idle_cb(cpu);
+            if (disposition == QEMU_PLUGIN_CRUCIBLE_IDLE_CALLBACK_RESCAN) {
+                return QEMU_PLUGIN_CRUCIBLE_IDLE_CALLBACK_RESCAN;
+            }
+        }
+        if (qemu_plugin_crucible_vmstop_pending()) {
+            break;
+        }
+    }
+    return QEMU_PLUGIN_CRUCIBLE_IDLE_CALLBACK_COMPLETE;
+}
