+static void fixture_base_alias_checks(void)
+{
+    QemuCruciblePreexecSetupOwner *owner = &preexec_setup_owner;
+    struct stat memory;
+    int memory_fd;
+
+    /* Actual alias producer and physical current leaves only. No plan decoder,
+     * Source payer, peer, Original or module admission succeeds here. */
+    g_assert_cmpint(preexec_publisher_module_memory_current(), ==, -ENOKEY);
+    g_assert_cmpint(preexec_setup_aliases(), ==, 0);
+    g_assert_true(owner->memory_alias_identity_known);
+    g_assert_cmpint(preexec_setup_aliases(), ==, -EALREADY);
+    g_assert_cmpint(preexec_publisher_module_memory_current(), ==, 0);
+    memory = owner->memory_alias_identity;
+    owner->memory_alias_identity.st_ino++;
+    g_assert_cmpint(preexec_publisher_module_memory_current(), ==, -ESTALE);
+    owner->memory_alias_identity = memory;
+    owner->memory_alias_identity.st_size++;
+    g_assert_cmpint(preexec_publisher_module_memory_current(), ==, -ESTALE);
+    owner->memory_alias_identity = memory;
+    owner->memory_alias_identity_known = false;
+    g_assert_cmpint(preexec_publisher_module_memory_current(), ==, -ENOKEY);
+    owner->memory_alias_identity_known = true;
+
+    /* Mutate the actual backing and actual role, not just receipt scalars. */
+    g_assert_cmpint(ftruncate(owner->descriptors[0], memory.st_size + 1), ==, 0);
+    g_assert_cmpint(preexec_publisher_module_memory_current(), ==, -ESTALE);
+    g_assert_cmpint(ftruncate(owner->descriptors[0], memory.st_size), ==, 0);
+    memory_fd = owner->descriptors[0];
+    owner->descriptors[0] = owner->descriptors[2];
