+    if (first || !startup_invocation(id) || !initializer || !destructor) {
+        return first ? first : -EPERM;
+    }
+    first = startup_process_purpose_live();
+    if (!first) {
+        first = qemu_crucible_startup_source_fingerprint_context_identity_v1(id);
+    }
+    if (first) {
+        return first;
+    }
+    qemu_thread_get_self(&thread);
+    qemu_mutex_lock(&registry->mutex);
+    first = callback_child_identity_locked(child);
+    if (!first && (!child->allocated || child->allocation_active || child->closing ||
+                   child->initialization_attempted || child->physical_returned)) {
+        first = -ESTALE;
+    }
+    if (first) {
+        qemu_mutex_unlock(&registry->mutex);
+        return first;
+    }
+    child->initializer = initializer;
+    child->destructor = destructor;
+    child->initialization_thread = thread;
+    child->initialization_attempted = true;
+    child->initialization_active = true;
+    address = child->address;
+    extent = child->extent;
+    alignment = child->alignment;
+    bridge = child->bridge;
+    qemu_mutex_unlock(&registry->mutex);
+
+    SOURCE_CALLBACK_MASKED_INVOKE(
+
+        first, &child->initializer, initializer, synchronous_input,
+
+        id, child, address, extent, alignment, bridge, synchronous_input);
+    qemu_mutex_lock(&registry->mutex);
+    child->initialization_first_status = first;
+    child->initialization_returned = true;
+    child->initialization_active = false;
+    /* A callback status does not tell us which Rust fields exist. Only the
+     * entered full-init or successful prefix-cleanup cut resolves placement. */
+    if (child->placement_started && !child->initialized &&
+        !child->prefix_rollback_completed) {
+        child->placement_uncertain = true;
+        if (!first) {
+            child->initialization_first_status = first = -EPROTO;
+        }
+    } else if (!first && !child->initialized) {
+        child->initialization_first_status = first = -EPROTO;
+    }
+    qemu_mutex_unlock(&registry->mutex);
+
+    post = startup_process_purpose_live();
+    qemu_mutex_lock(&registry->mutex);
+    child->initialization_post_status = post;
+    qemu_mutex_unlock(&registry->mutex);
+    if (post) {
+        crucible_metadata_partition_record_post(&startup_source.metadata_partition, post);
+    }
+    return first ? first : post;
+#else
+    return -ENOTSUP;
+#endif
+}
