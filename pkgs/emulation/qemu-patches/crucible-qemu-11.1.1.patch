+int qemu_plugin_crucible_native_registry_bind_v1(
+    QemuCrucibleNativeInvocationRegistry *registry)
+{
+    pid_t process = getpid();
+    int status = 0;
+
+    /* Initialization and complete payment precede this nominal Source call;
+     * neither this pointer nor these scalars can create that owning cut. */
+    if (!registry) {
+        return -EINVAL;
+    }
+    if (!registry_process_current(registry, process)) {
+        return -EPERM;
+    }
+    qemu_mutex_lock(&registry->mutex);
+    if (!registry_identity_locked(registry, process)) {
+        status = -EPERM;
+    } else if (!registry->child_owner || !registry->child_registration_seen) {
+        status = -ENOKEY;
+    } else if (registry->binding_attempted || registry->revoked || registry->bound) {
+        status = -EALREADY;
+    } else {
+        /* Prepared geometry cannot bind callback ownership. Only completion
+         * of the genuine Source-backed registrar establishes the association. */
+        status = -ENOKEY;
+    }
+    qemu_mutex_unlock(&registry->mutex);
+    return status;
+}
