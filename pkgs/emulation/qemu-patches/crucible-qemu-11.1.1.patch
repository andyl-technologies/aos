+        if (returned) {
+            return -EINVAL;
+        }
+        return returning && (startup_source.module_custody_published || member->held ||
+                             startup_source.publisher_module.held ||
+                             startup_source.advance_holder ||
+                             startup_source.pending_offer_read.busy ||
+                             !pending_constructor_closed()) ?
+            -EBUSY : 0;
+    }
+    if (child != member || member->canonical_owner != member || !member->attempted ||
+        !member->held || member->returned || !member->transition_active ||
+        !member->holder || *member->holder != member ||
+        member->publisher_lender != startup_source.publisher_lender ||
+        !member->publisher_lender || member->component != &startup_source.control_callback ||
+        member->component->command_member != member ||
+        member->slot != &startup_source.setup_slot || member->slot->command_member != member ||
+        member->child_owner != &startup_source.callbacks.owner ||
+        member->child != member->child_owner->child ||
+        member->runtime != member->child_owner->runtime ||
+        member->bridge != member->child_owner->bridge ||
+        (!!returning != member->closing) ||
+        (returning ? returned != &member->publisher_returned : returned != NULL)) {
+        return -ESTALE;
+    }
+    return 0;
+}
