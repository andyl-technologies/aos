+
+static bool gicv3_cpuif_crucible_pending(GICv3CPUState *cs, uint32_t irq)
+{
+    uint8_t pending;
+
+    if (irq < GIC_INTERNAL) {
+        return cs->gicr_ipendr0 & (1U << irq);
+    }
+    if (irq < cs->gic->num_irq) {
+        return gicv3_gicd_pending_test(cs->gic, irq);
+    }
+    if (irq < GICV3_LPI_INTID_START) {
+        return true;
+    }
+    if (address_space_read(
+            &cs->gic->dma_as,
+            (cs->gicr_pendbaser & R_GICR_PENDBASER_PHYADDR_MASK) + irq / 8,
+            MEMTXATTRS_UNSPECIFIED, &pending, sizeof(pending)) != MEMTX_OK) {
+        return true;
+    }
+    return extract32(pending, irq % 8, 1);
+}
+
+static void gicv3_cpuif_crucible_clear_pending(
+    GICv3CPUState *cs, uint32_t intid)
+{
+    if (intid < GIC_INTERNAL) {
+        cs->gicr_ipendr0 &= ~(1U << intid);
+        cs->crucible_interrupt_family[intid] = 0;
+        cs->crucible_interrupt_source_sequence[intid] = 0;
+        cs->crucible_interrupt_routing_generation[intid] = 0;
+        cs->crucible_interrupt_priority_valid &= ~(1U << intid);
+        gicv3_redist_update(cs);
+    } else if (intid < cs->gic->num_irq) {
+        gicv3_gicd_pending_clear(cs->gic, intid);
+        cs->gic->crucible_interrupt_family[intid] = 0;
+        cs->gic->crucible_interrupt_source_sequence[intid] = 0;
+        cs->gic->crucible_interrupt_routing_generation[intid] = 0;
+        cs->gic->crucible_interrupt_target[intid] = -1;
+        cs->gic->crucible_interrupt_priority_valid[BIT32_WORD(intid)] &=
+            ~BIT32_MASK(intid);
+        gicv3_update(cs->gic, intid, 1);
+    } else {
+        gicv3_redist_lpi_pending(cs, intid, 0);
+        qemu_crucible_fault_interrupt_provenance_clear(
+            QEMU_CRUCIBLE_INTERRUPT_ARM_GIC_LPI,
+            cs->cpu->cpu_index, intid);
+    }
+}
