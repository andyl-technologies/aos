+static int ram_control_parent_original_current(
+    QemuCrucibleRamControlActor *actor, qemu_plugin_id_t id,
+    QemuCrucibleRamParentOriginal *original, uint64_t *bounded_ns)
+{
+    int status = ram_control_parent_slice(actor, id, bounded_ns);
+
+    if (status) {
+        return status;
+    }
+    /* Only a genuine native callback issuer may fill this slot. This packet
+     * deliberately supplies no scalar-to-holder publication or success stub. */
+    if (original != &actor->parent_original || !original->held ||
+        !original->callback_held) {
+        return -ENOKEY;
+    }
+    if (original->actor != actor || original->runtime != actor->purpose ||
+        original->endpoint != actor->ram_endpoint ||
+        original->callback != startup_source.parent_park_callback ||
+        original->userdata != actor->userdata || original->process != getpid() ||
+        original->owner_thread != qemu_get_thread_id() ||
+        original->incarnation != actor->incarnation) {
+        return -ESTALE;
+    }
+    return 0;
+}
