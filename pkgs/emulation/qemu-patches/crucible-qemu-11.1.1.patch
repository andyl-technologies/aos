+/* Actual Main and worker paths choose their own fixed cursor. Neither takes
+ * a Source lock across I/O or borrows the other actor's invocation authority.
+ * This records an independent observation; current() also applies sticky first. */
+static int fingerprint_material_observe(QemuCrucibleFingerprintMaterial *material,
+    QemuCrucibleFingerprintMaterialObserver *observer, uint64_t *bounded_ns)
+{
+    struct QemuCrucibleFingerprintOperation *operation = &material->operation;
+    QemuCrucibleStandingRecord observed;
+    const QemuCrucibleStandingBudget *admitted, *current;
+    struct pollfd cancellation;
+    uint64_t now, sequence, slice, progress_ns;
+    uint32_t first_class = QEMU_CRUCIBLE_STANDING_CLASS_COUNT;
+    uint32_t last_class = QEMU_CRUCIBLE_STANDING_CLASS_COUNT;
+    int cancellation_fd = -1;
+    int status = fingerprint_material_identity(material);
+
+    if (status) {
+        return status;
+    }
+    if (!((observer == &material->main_observer && qemu_in_main_thread() &&
+           qemu_thread_is_self(&operation->thread)) ||
+          (observer == &material->worker_observer &&
+           qemu_thread_is_self(&material->worker->native.thread) &&
+           material->worker->native.entry_entered && !material->worker->native.entry_returned))) {
+        return -EPERM;
+    }
+    if (operation->action_original) {
+        return action_original_material_current(material, observer, bounded_ns);
+    }
+    status = qemu_crucible_preexec_standing_identity_v1(
+        startup_source.standing.lender, &observer->observation, &cancellation_fd);
+    if (!status) {
+        status = qemu_crucible_preexec_standing_snapshot_v1(
+            startup_source.standing.lender, observer->snapshot, &sequence);
+    }
+    if (!status) {
+        status = qemu_crucible_standing_record_decode_v4(
+            observer->snapshot, sizeof(observer->snapshot), &observed);
+    }
+    if (!status) {
+        status = standing_subject_current(&observed);
+    }
+    if (!status) {
+        status = standing_action_snapshot_validate(
+            &observer->current.action, &observed.action, sequence);
+    }
+    if (!status) {
+        status = standing_park_snapshot_validate(
+            &observer->current.park, &observed.park, sequence);
+    }
+    if (!status && (sequence < observer->sequence ||
+        observed.outer_revision < observer->current.outer_revision ||
+        observed.roster_revision < observer->current.roster_revision ||
+        (observer->current.state && observed.state != observer->current.state) ||
+        (observed.outer_revision == observer->current.outer_revision &&
+         (observed.outer_allowance_present != observer->current.outer_allowance_present ||
+          observed.outer_allowance_ns != observer->current.outer_allowance_ns)) ||
+        (observed.roster_revision == observer->current.roster_revision &&
+         !standing_roster_equal(&observed, &observer->current)))) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        status = standing_roster_finite(&observed);
+    }
+    if (!status) {
+        /* Load published physical progress before sampling this observer's
+         * clock. A later worker update cannot create a future timestamp in
+         * this observation or underflow its elapsed-progress calculation. */
+        progress_ns = qatomic_load_acquire(&operation->progress_ns);
+        status = standing_clock(&now);
+    }
+    if (!status && (now < observer->last_now_ns || now < progress_ns)) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        observer->last_now_ns = now;
+        observer->current = observed;
+        observer->sequence = sequence;
+        status = standing_limits_current(&observed, now);
+    }
+    if (!status) {
+        status = standing_limits_current(&operation->admitted, now);
+    }
+    if (!status) {
+        cancellation = (struct pollfd) { .fd = cancellation_fd, .events = POLLIN };
+        int polled = poll(&cancellation, 1, 0);
+
+        if (polled < 0) {
+            status = -errno;
+        } else if (polled || cancellation.revents) {
+            status = -ECANCELED;
+        }
+    }
+    if (!status) {
+        if (operation->class_index == UINT32_MAX && material->capture_entered &&
+            !material->root_attached) {
+            /* Before Root selects its actual class, aggregate work pays both
+             * admissible class budgets from the original child birth. */
+            first_class = QEMU_CRUCIBLE_STANDING_INITIALIZATION_CLASS;
+            last_class = QEMU_CRUCIBLE_STANDING_UPDATE_CLASS;
+        } else if (material->root_attached &&
+            (operation->class_index == QEMU_CRUCIBLE_STANDING_INITIALIZATION_CLASS ||
+             operation->class_index == QEMU_CRUCIBLE_STANDING_UPDATE_CLASS)) {
+            first_class = operation->class_index;
+            last_class = operation->class_index;
+        } else {
+            status = -EPROTO;
+        }
+        if (!status && (first_class > last_class ||
+                       last_class >= QEMU_CRUCIBLE_STANDING_CLASS_COUNT)) {
+            status = -EPROTO;
+        }
+    }
+    if (!status) {
+        slice = UINT64_MAX;
+        for (uint32_t class_index = first_class; class_index <= last_class; class_index++) {
+            admitted = &operation->admitted.budgets[class_index];
+            current = &observed.budgets[class_index];
+            slice = MIN(slice, MIN(admitted->poll_ns, current->poll_ns));
+            standing_slice_budget(now - operation->start_ns, admitted->total_present,
+                                  admitted->total_ns, &slice);
+            standing_slice_budget(now - progress_ns, admitted->progress_present,
+                                  admitted->progress_ns, &slice);
+            standing_slice_budget(now - operation->start_ns, current->total_present,
+                                  current->total_ns, &slice);
+            standing_slice_budget(now - progress_ns, current->progress_present,
+                                  current->progress_ns, &slice);
+        }
+        standing_slice_budget(now - operation->admitted.origin_ns,
+                              operation->admitted.outer_allowance_present,
+                              operation->admitted.outer_allowance_ns, &slice);
+        standing_slice_budget(now - observed.origin_ns, observed.outer_allowance_present,
+                              observed.outer_allowance_ns, &slice);
+        if (!slice) {
+            status = -ETIMEDOUT;
+        } else if (bounded_ns) {
+            *bounded_ns = slice;
+        }
+    }
+    if (status) {
+        qatomic_cmpxchg(&material->first_status, 0, status);
+    }
+    return status;
+}
+
+static int fingerprint_material_current(QemuCrucibleFingerprintMaterial *material,
+    QemuCrucibleFingerprintMaterialObserver *observer, uint64_t *bounded_ns)
+{
+    uint64_t slice;
+    int status = fingerprint_material_identity(material);
+    int first;
+
+    if (status) {
+        return status;
+    }
+    status = fingerprint_material_observe(material, observer, &slice);
+    first = qatomic_load_acquire(&material->first_status);
+    if (first || status) {
+        return first ? first : status;
+    }
+    if (bounded_ns) {
+        *bounded_ns = slice;
+    }
+    return 0;
+}
