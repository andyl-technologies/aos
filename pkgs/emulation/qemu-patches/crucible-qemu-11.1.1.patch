+
+    assert(child >= 0);
+    if (!child) {
+        const QemuCrucibleFaultHandler *child_handler = NULL;
+
+        assert(qemu_crucible_fault_node_registration_identity_v1(
+            &foreign.registration, &foreign.registration.holder, false,
+            &child_handler) == -EPERM);
+        assert(!child_handler);
+        assert(qemu_crucible_fault_node_pending_current_v1(&foreign_pending) == -EPERM);
+        assert(qemu_crucible_fault_node_pending_return_v1(
+            &foreign_pending, &pending_returned) == -EPERM);
+        assert(!pending_returned);
+        assert(qemu_crucible_fault_pending_birth_current_v1(
+            &foreign.handler, &command, &born_pending) == -EPERM);
+        assert(qemu_crucible_fault_pending_returning_v1(&foreign_pending) == -EPERM);
+        assert(!crucible_pending_stage_retire_begin(&foreign_stage));
+        assert(qemu_crucible_fault_node_validation_owned_v1(&foreign.handler) == -EPERM);
+        assert(qemu_crucible_fault_node_validate_v1(
+            &foreign.handler, &command, NULL, 0) == -EPERM);
+        assert(qemu_crucible_fault_node_registration_return_v1(&copy) == -EPERM);
+        assert(qemu_crucible_fault_registration_observe_v1(
+            &foreign.registration, &foreign.registration.holder,
+            &observed) == -EPERM);
+        assert(!memcmp(&observed, &saved, sizeof(saved)));
+        _exit(0);
