+/* Keep elapsed origins exact; the NVMe registers expose whole milliseconds. */
+#define NVME_PICOSECONDS_PER_MILLISECOND 1000000000LL
+
+static bool nvme_capture_clock_origin(uint64_t *milliseconds,
+                                     uint32_t *phase_ps)
+{
+    if (!qemu_timer_tcg_ps_enabled()) {
+        *milliseconds = qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL);
+        *phase_ps = 0;
+        return true;
+    }
+
+    __int128 now_ps = qemu_clock_get_ps_wide(QEMU_CLOCK_VIRTUAL);
+    __int128 now_ms = now_ps / NVME_PICOSECONDS_PER_MILLISECOND;
+
+    if (now_ps < 0 || now_ms > UINT64_MAX) {
+        return false;
+    }
+    *milliseconds = now_ms;
+    *phase_ps = now_ps % NVME_PICOSECONDS_PER_MILLISECOND;
+    return true;
+}
+
+static bool nvme_elapsed_clock_ms(uint64_t origin_ms, uint32_t phase_ps,
+                                 uint64_t *elapsed_ms)
+{
+    if (!qemu_timer_tcg_ps_enabled()) {
+        *elapsed_ms = qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) - origin_ms;
+        return true;
+    }
+
+    __int128 origin_ps = (__int128)origin_ms *
+                         NVME_PICOSECONDS_PER_MILLISECOND + phase_ps;
+    __int128 now_ps = qemu_clock_get_ps_wide(QEMU_CLOCK_VIRTUAL);
+    __int128 elapsed;
+
+    if (phase_ps >= NVME_PICOSECONDS_PER_MILLISECOND || now_ps < origin_ps) {
+        return false;
+    }
+    elapsed = (now_ps - origin_ps) / NVME_PICOSECONDS_PER_MILLISECOND;
+    if (elapsed > UINT64_MAX) {
+        return false;
+    }
+    *elapsed_ms = elapsed;
+    return true;
+}
