+/* Use the runtime's retained kernel vector, not mutable environ adjacency.
+ * The existing helper isolates system ELF declarations in its own TU. */
+static int preexec_setup_mapping_page_size(uint64_t *out)
+{
+#ifdef CONFIG_GETAUXVAL
+    unsigned long page_size;
+
+    if (!out) {
+        return -EINVAL;
+    }
+    page_size = qemu_getauxval(AT_PAGESZ);
+    if (!page_size || (page_size & (page_size - 1))) {
+        return -EPROTO;
+    }
+    *out = page_size;
+    return 0;
+#else
+    /* The allocator/procfs fallback has no prebirth payer in this cut. */
+    return -ENOTSUP;
+#endif
+}
