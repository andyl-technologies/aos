+         * guards, without provider callback, Root or installing fallback. */
+        status = qemu_crucible_checkpoint_inventory_metadata_current_v1(borrow->loan);
+    }
+    return status ? status :
+        crucible_metadata_partition_admission_status(borrow->partition);
+}
