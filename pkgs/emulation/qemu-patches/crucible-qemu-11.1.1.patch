+int qemu_plugin_crucible_callback_child_storage_initialize_v1(
+    qemu_plugin_id_t id, QemuCrucibleCallbackChildStorage *child,
+    int (*initializer)(qemu_plugin_id_t, QemuCrucibleCallbackChildStorage *,
+                       void *, size_t, size_t, QemuCrucibleCommandConsumerStorage *, void *),
+    int (*destructor)(qemu_plugin_id_t, QemuCrucibleCallbackChildStorage *,
+                      void *, size_t, size_t),
+    void *synchronous_input)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *registry = &startup_source.commands;
+    QemuThread thread;
+    void *address;
+    size_t extent;
+    size_t alignment;
+    QemuCrucibleCommandConsumerStorage *bridge;
+    int first = command_registry_identity(id);
+    int post;
