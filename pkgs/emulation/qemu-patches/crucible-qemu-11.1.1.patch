+        return -EPERM;
+    }
+    status = source_control_component_identity(binding);
+    if (status) {
+        qemu_mutex_lock(&commands->mutex);
+        status = binding->first_status ? binding->first_status : status;
+        qemu_mutex_unlock(&commands->mutex);
+        return status;
+    }
+    status = startup_runtime_admission(
+        binding->installer.plugin_id, binding->runtime);
+    if (status) {
