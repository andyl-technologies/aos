+    }
+    if (!crucible_metadata_partition_residual_valid(account->partition)) {
+        return -EOVERFLOW;
+    }
+    /* This is callback-free metadata lifetime/accounting, never CPU execution,
+     * Root/read authority or an Original observation. Native must separately
+     * authenticate its same paid CPU/MMU row and actual allocation request. */
+    return crucible_metadata_partition_admission_status(account->partition);
+}
+#endif
