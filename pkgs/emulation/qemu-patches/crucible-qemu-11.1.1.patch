+static CPUState *frame_reclaim_locked(QemuCrucibleNativeInvocation *frame)
+{
+    if (frame->live || frame->use_references || frame->suppressed_children ||
+        frame->initial_cpu_child.held || frame->initial_cpu_child.register_read.held ||
+        frame->cpu_return_in_flight) {
+        return NULL;
+    }
+    if (frame->cpu) {
+        /* Keep the slot and descriptor pin through the real unlocked unref.
+         * Terminal census and pool reuse must still see this physical effect. */
+        frame->cpu_return_in_flight = true;
+        return frame->cpu;
+    }
+    if (frame->registration) {
+        assert(frame->registration->references);
+        frame->registration->references--;
+    }
+    *frame = (QemuCrucibleNativeInvocation) { 0 };
+    return NULL;
+}
