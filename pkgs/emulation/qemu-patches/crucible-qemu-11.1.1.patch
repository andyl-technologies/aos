+def run_active_host_ready_test(qemu, plugin, bios):
+    busy_bios = bytearray(open(bios, "rb").read())
+    busy_bios[-16:-13] = bytes((0xFA, 0xEB, 0xFD))
+    with tempfile.NamedTemporaryFile(
+        prefix="active-host-ready-bios-"
+    ) as bios_file:
+        bios_file.write(busy_bios)
+        bios_file.flush()
+        live = LiveQemu(
+            qemu,
+            plugin,
+            bios_file.name,
+            dispatch_ceiling=RR_SWITCH_QUANTUM,
+            rr_switch_quantum=RR_SWITCH_QUANTUM,
+            x86_smp="4,maxcpus=4",
+            active_host_ready=True,
+            start_paused=True,
+        )
+
+    try:
+        cont_id = live.qmp_send("cont")
+
+        initial_events = [live.marker() for _ in range(4)]
+        expected_work = [("work", vcpu_index) for vcpu_index in range(4)]
+        if initial_events != expected_work:
+            raise AssertionError(
+                f"unexpected host-ready initial work: {initial_events!r}"
+            )
+
+        first_dispatch = live.marker()
+        if first_dispatch != ("dispatch", RR_SWITCH_QUANTUM):
+            raise AssertionError(
+                f"unexpected host-ready first boundary: {first_dispatch!r}"
+            )
+
+        startup_deadline = time.monotonic() + TIMEOUT_SECONDS
+        live.wait_for_rr_dispatch_event(startup_deadline)
+        cont_result = live.qmp_wait(cont_id, deadline=startup_deadline)
+        if cont_result != {}:
+            raise AssertionError(
+                f"unexpected active host-ready cont result: {cont_result!r}"
+            )
+
+        blocked_dispatch_index = 1
+        blocked_icount = RR_SWITCH_QUANTUM * 2
+        startup_ceiling = (
+            RR_SWITCH_QUANTUM *
+            (ACTIVE_HOST_READY_MAX_TRANSIENT_POLLS + 4)
+        )
+        live.control_state[16:20] = blocked_dispatch_index.to_bytes(
+            4, byteorder=sys.byteorder
+        )
+        live.control_state[8:16] = startup_ceiling.to_bytes(
+            8, byteorder=sys.byteorder
+        )
+        live.control_state.flush()
+        os.eventfd_write(live.wake_fd, 1)
+
+        startup_control = None
+        while True:
+            blocked_dispatch = live.marker()
+            if blocked_dispatch == (
+                "control", (RR_SWITCH_QUANTUM, 1)
+            ):
+                if startup_control is not None:
+                    raise AssertionError(
+                        "startup ceiling published duplicate control: "
+                        f"{blocked_dispatch!r}"
+                    )
+                startup_control = blocked_dispatch
+                continue
+            if blocked_dispatch == ("dispatch", blocked_icount):
+                break
+            if blocked_dispatch[0] == "park" or (
+                blocked_dispatch[0] == "result" and
+                blocked_dispatch[1] == 9
+            ):
+                continue
+            raise AssertionError(
+                "unexpected host-ready blocked boundary: "
+                f"{blocked_dispatch!r}"
+            )
+        if startup_control is None:
+            raise AssertionError(
+                "startup ceiling did not publish its control boundary"
+            )
+
+        deadline = time.monotonic() + TIMEOUT_SECONDS
+        transient_polls = []
+        while True:
+            (
+                prior_generation,
+                prior_poll_result,
+                poll_timeout,
+                poll_pending,
+            ) = live.wait_for_host_poll_state(deadline)
+            if poll_timeout == -1:
+                break
+
+            transient_polls.append(
+                (
+                    prior_generation,
+                    prior_poll_result,
+                    poll_timeout,
+                    poll_pending,
+                )
+            )
+            if len(transient_polls) > ACTIVE_HOST_READY_MAX_TRANSIENT_POLLS:
+                raise AssertionError(
+                    "main loop did not reach an infinite durable host poll "
+                    "after bounded transient polls: "
+                    f"polls={transient_polls!r}"
+                )
+
+            next_dispatch_index = blocked_dispatch_index + 1
+            live.control_state[16:20] = next_dispatch_index.to_bytes(
+                4, byteorder=sys.byteorder
+            )
+            live.control_state.flush()
+            live.control_state[4:8] = blocked_dispatch_index.to_bytes(
+                4, byteorder=sys.byteorder
+            )
+            live.control_state.flush()
+
+            blocked_dispatch_index = next_dispatch_index
+            blocked_icount += RR_SWITCH_QUANTUM
+            while True:
+                blocked_dispatch = live.marker(deadline)
+                if blocked_dispatch == ("dispatch", blocked_icount):
+                    break
+                if blocked_dispatch[0] == "park" or (
+                    blocked_dispatch[0] == "result" and
+                    blocked_dispatch[1] == 9
+                ):
+                    continue
+                raise AssertionError(
+                    "unexpected host-ready retry boundary: "
+                    f"{blocked_dispatch!r}; polls={transient_polls!r}"
+                )
+
+        dispatch_ceiling = blocked_icount + RR_SWITCH_QUANTUM * 2
+        live.control_state[8:16] = dispatch_ceiling.to_bytes(
+            8, byteorder=sys.byteorder
+        )
+        # The selected callback still waits for its matching release. Later
+        # callbacks must not trap the QMP response behind a new replay hold.
+        live.control_state[20:24] = blocked_dispatch_index.to_bytes(
+            4, byteorder=sys.byteorder
+        )
+        live.control_state.flush()
+
+        # Force the race where an unrelated ready fd returns the infinite poll
+        # while the vCPU is still blocked in the selected active callback.
+        # The main loop must first reacquire the replay token held by this
+        # callback before it can enter another poll.
+        query_status_id = live.qmp_send("query-status")
+        if poll_pending:
+            prior_generation = live.wait_for_infinite_host_poll_ready(
+                prior_generation, deadline
+            )
+        elif prior_poll_result <= 0:
+            raise AssertionError(
+                "completed infinite host poll did not publish readiness: "
+                f"generation={prior_generation} result={prior_poll_result}"
+            )
+
+        os.eventfd_write(live.wake_fd, 1)
+        live.control_state[4:8] = blocked_dispatch_index.to_bytes(
+            4, byteorder=sys.byteorder
+        )
+        live.control_state.flush()
+        query_status = live.qmp_wait(query_status_id, deadline=deadline)
+        if query_status.get("status") != "running":
+            raise AssertionError(
+                f"unexpected active host-ready status: {query_status!r}"
+            )
+
+        events = []
+        reached_ceiling = False
+        while not reached_ceiling or not any(
+            event == "control" for event, _value in events
+        ):
+            event = live.marker(deadline)
+            if event[0] in ("dispatch", "control"):
+                events.append(event)
+                reached_ceiling |= event == (
+                    "dispatch", dispatch_ceiling
+                )
+                continue
+            if event[0] == "park" or (
+                event[0] == "result" and event[1] == 9
+            ):
+                continue
+            raise AssertionError(f"unexpected host-ready marker: {event!r}")
+
+        controls = [event for event in events if event[0] == "control"]
+        expected_control = (
+            "control", (dispatch_ceiling, 2)
+        )
+        if controls != [expected_control]:
+            raise AssertionError(
+                "active external readiness did not admit exactly one control "
+                f"pass: {events!r}"
+            )
+        expected = [
+            ("dispatch", blocked_icount + RR_SWITCH_QUANTUM),
+            ("dispatch", dispatch_ceiling),
+            expected_control,
+        ]
+        if events != expected:
+            raise AssertionError(
+                "active external readiness crossed a non-ceiling quantum: "
+                f"{events!r}"
+            )
+    finally:
+        live.control_state[16:20] = ACTIVE_HOST_READY_RELEASE_ALL.to_bytes(
+            4, byteorder=sys.byteorder
+        )
+        live.control_state[4:8] = ACTIVE_HOST_READY_RELEASE_ALL.to_bytes(
+            4, byteorder=sys.byteorder
+        )
+        live.control_state.flush()
+        live.close()
+
+    if live.shutdown_marker_counts["control"] != 0:
+        raise AssertionError(
+            "active external readiness published an additional control pass: "
+            f"counts={dict(live.shutdown_marker_counts)!r}"
+        )
+    return tuple(event for event, _value in events)
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--qemu", required=True)
+    parser.add_argument("--plugin", required=True)
+    parser.add_argument("--bios", required=True)
+    args = parser.parse_args()
+
+    run_non_sim_quantum_inert_test(args.qemu, args.bios)
+    stop_live = run_stop_test(args.qemu, args.plugin, args.bios)
+    hotplug_lives = [
+        run_hotplug_test(args.qemu, args.plugin, args.bios)
+        for _ in range(HOTPLUG_SHUTDOWN_RUNS)
+    ]
+    control_lives = [
+        run_control_boundary_test(args.qemu, args.plugin, args.bios)
+        for _ in range(CONTROL_BOUNDARY_RUNS)
+    ]
+    idle_external_lives = [
+        run_control_boundary_test(
+            args.qemu,
+            args.plugin,
+            args.bios,
+            rr_switch_quantum=RR_SWITCH_QUANTUM,
+        )
+        for _ in range(IDLE_EXTERNAL_READY_RUNS)
+    ]
+    nonfirst_control_lives = [
+        run_nonfirst_control_boundary_test(args.qemu, args.plugin, args.bios)
+        for _ in range(CONTROL_BOUNDARY_RUNS)
+    ]
+    time_advance_reentry_results = [
+        run_time_advance_reentry_test(args.qemu, args.plugin, args.bios)
+        for _ in range(TIME_ADVANCE_REENTRY_RUNS)
+    ]
+    control_time_advance_results = [
+        run_control_time_advance_test(args.qemu, args.plugin, args.bios)
+        for _ in range(CONTROL_TIME_ADVANCE_RUNS)
+    ]
+    hlt_boundary_results = [
+        run_hlt_at_ceiling_test(args.qemu, args.plugin, args.bios)
+        for _ in range(EXACT_BOUNDARY_RUNS)
+    ]
+    vmstop_boundary_results = [
+        run_vmstop_at_ceiling_test(
+            args.qemu, args.plugin, args.bios, HLT_DISPATCH_CEILING
+        )
+        for _ in range(EXACT_BOUNDARY_RUNS)
+    ]
+    already_due_vmstop_results = [
+        run_vmstop_at_ceiling_test(args.qemu, args.plugin, args.bios, 0)
+        for _ in range(ALREADY_DUE_BOUNDARY_RUNS)
+    ]
+    late_ceiling_results = [
+        run_late_ceiling_test(args.qemu, args.plugin, args.bios)
+        for _ in range(LATE_CEILING_RUNS)
+    ]
+    guest_aio_notify_results = [
+        run_guest_aio_notify_test(args.qemu, args.plugin, args.bios)
+        for _ in range(GUEST_AIO_NOTIFY_RUNS)
+    ]
+    active_host_ready_results = [
+        run_active_host_ready_test(args.qemu, args.plugin, args.bios)
+        for _ in range(ACTIVE_HOST_READY_RUNS)
+    ]
+    if stop_live.futex_entries_observed != 1:
+        raise AssertionError("stop case did not attest one FUTEX_WAIT entry")
+    if any(live.futex_entries_observed != 2 for live in hotplug_lives):
+        raise AssertionError(
+            "a hotplug case did not attest two FUTEX_WAIT entries"
+        )
+    if any(live.futex_entries_observed != 1 for live in control_lives):
+        raise AssertionError(
+            "a control case did not attest one FUTEX_WAIT entry"
+        )
+    if any(live.futex_entries_observed != 1 for live in idle_external_lives):
+        raise AssertionError(
+            "a finite-RR idle host-ready case did not attest one FUTEX_WAIT "
+            "entry"
+        )
+    if any(live.futex_entries_observed != 1 for live in nonfirst_control_lives):
+        raise AssertionError(
+            "a non-first control case did not attest one FUTEX_WAIT entry"
+        )
+    time_advance_orders = [result[0] for result in time_advance_reentry_results]
+    request_exit_records = [
+        result[1] for result in time_advance_reentry_results
+    ]
+    completion_records = [
+        result[2] for result in time_advance_reentry_results
+    ]
+    expected_time_advance_order = (
+        ("work",) * TIME_ADVANCE_VCPU_COUNT + ("advance", "park")
+    )
+    if set(time_advance_orders) != {expected_time_advance_order}:
+        raise AssertionError(
+            "time-advance direct reentry varied: "
+            f"{time_advance_orders!r}"
+        )
+    if len(set(request_exit_records)) != 1:
+        raise AssertionError(
+            "time-advance request exit evidence varied: "
+            f"{request_exit_records!r}"
+        )
+    if len(set(completion_records)) != 1:
+        raise AssertionError(
+            "time-advance completion evidence varied: "
+            f"{completion_records!r}"
+        )
+    if len(set(control_time_advance_results)) != 1:
+        raise AssertionError(
+            "synchronous control time-advance coordinates varied: "
+            f"{control_time_advance_results!r}"
+        )
+    if len(set(hlt_boundary_results)) != 1:
+        raise AssertionError(
+            f"HLT-at-ceiling events varied: {hlt_boundary_results!r}"
+        )
+    if len(set(vmstop_boundary_results)) != 1:
+        raise AssertionError(
+            "VM-stop-at-ceiling events varied: "
+            f"{vmstop_boundary_results!r}"
+        )
+    if len(set(already_due_vmstop_results)) != 1:
+        raise AssertionError(
+            "already-due VM-stop events varied: "
