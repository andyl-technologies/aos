 struct QapiDeallocVisitor
 {
     Visitor visitor;
+    QemuCrucibleQmpAllocationOwner *source_owner;
+    bool source;
+    bool invoking;
+    int status;
+    int first_failure;
+    int post_status;
+    QemuThread thread;
+    Coroutine *coroutine;
+    QemuCrucibleQmpVisitorLoan *loan;
 };
 
+static QapiDeallocVisitor *to_qdv(Visitor *visitor)
+{
+    return container_of(visitor, QapiDeallocVisitor, visitor);
+}
+
+static int dealloc_source_identity(Visitor *visitor)
+{
+    QemuCrucibleQmpAllocationOwner *owner;
+    unsigned kind;
+    int status = qemu_crucible_qmp_visitor_observe(visitor, &kind, &owner);
+
+    if (status) {
+        return status;
+    }
+    if (kind != QEMU_CRUCIBLE_QMP_VISITOR_DEALLOC ||
+        !to_qdv(visitor)->source || to_qdv(visitor)->source_owner != owner) {
+        return -ESTALE;
+    }
+    return 0;
+}
+
+static bool dealloc_source_current(Visitor *visitor)
+{
+    QapiDeallocVisitor *v;
+    int status = qemu_crucible_qmp_visitor_loan_current(visitor, NULL);
+
+    if (status) {
+        return false;
+    }
+    v = to_qdv(visitor);
+    if (!v->invoking) {
+        status = -EPERM;
+    }
+    if (status && !v->status) {
+        v->status = status;
+    }
+    return !v->status;
+}
+
+static void dealloc_source_result(QapiDeallocVisitor *v, int status)
+{
+    if (status) {
+        if (!v->first_failure) {
+            v->first_failure = status;
+        }
+        if (!v->status) {
+            v->status = status;
+        }
+        v->post_status = status;
+    }
+}
+
+static bool dealloc_source_free(Visitor *visitor, void **holder)
+{
+    QapiDeallocVisitor *v = to_qdv(visitor);
+    QemuCrucibleQmpAllocationOwner *owner;
+    size_t extent;
+    int status;
+
+    if (!dealloc_source_current(visitor)) {
+        return false;
+    }
+    if (!holder || !*holder) {
+        return true;
+    }
+    status = qemu_crucible_qmp_allocation_observe(*holder, &owner, &extent);
+    if (!status && owner != v->source_owner) {
+        status = -EXDEV;
+    }
+    if (!status) {
+        status = qemu_crucible_qmp_free(holder);
+    }
+    /* Source free updates the caller's field at the real physical mutation,
+     * even when subsequent debit retirement fails. */
+    dealloc_source_result(v, status);
+    return !status;
+}
+
