+static void fixture_component_workers_return(FixtureRuntimeParent *runtime, int peer)
+{
+    QemuCrucibleRequiredWorker **holders[] = { &runtime->run, &runtime->teardown };
+    uint64_t before = startup_source.metadata_partition.native_live;
+    uint64_t stacks = 0;
+
+    g_assert_cmpuint(runtime->owner->component_users, ==, 2);
+    g_assert_cmpuint(runtime->child->physical_users, ==, 2);
+    for (size_t index = 0; index < G_N_ELEMENTS(holders); index++) {
+        QemuCrucibleRequiredWorker *worker = *holders[index];
+        QemuCruciblePluginWorker *native = &worker->native;
+        int status;
+
+        stacks += native->layout.stack_bytes;
+        g_assert_cmpint(qemu_plugin_crucible_required_worker_close_v1(
+            fixture.ctx.id, worker), ==, 0);
+        do {
+            uint64_t slice;
+
+            /* Observe within the same retained installing and containing
+             * deadlines after registration closes admission. This is no new
+             * cleanup Original or renewal of allocation permission. */
+            g_assert_cmpint(startup_process_purpose_live(), ==, 0);
+            status = qemu_plugin_crucible_required_worker_tryjoin_v1(fixture.ctx.id, worker);
+            if (status == -EBUSY) {
+                g_assert_cmpint(startup_live_slice(&slice), ==, 0);
+                g_usleep(MIN(slice / 1000, UINT64_C(1000)));
+                g_assert_cmpint(startup_process_purpose_live(), ==, 0);
+            }
+        } while (status == -EBUSY);
+        g_assert_cmpint(status, ==, 0);
+        g_assert_true(native->birth.born);
+        g_assert_true(native->joined);
+        g_assert_true(native->entry_returned);
+        g_assert_cmpint(native->entry_status, ==, 0);
+        g_assert_true(native->destroyed);
+        g_assert_true(native->physical_returned);
+        g_assert_false(native->pins_held);
+        g_assert_false(native->task_reserved);
+        g_assert_false(native->stack_charge.held);
+        g_assert_null(native->stack);
+        g_assert_null(native->owning_alias);
+        g_assert_true(native->residual_charge.held);
+        g_assert_cmpint(qemu_plugin_crucible_required_worker_identity_return_v1(
+            fixture.ctx.id, holders[index]), ==, 0);
+        g_assert_null(*holders[index]);
+    }
+    g_assert_cmpuint(startup_source.metadata_partition.native_live, ==, before - stacks);
+    g_assert_cmpuint(startup_source.task_ledger.live_reserved, ==, 0);
+    g_assert_cmpuint(runtime->owner->component_users, ==, 0);
+    g_assert_cmpuint(runtime->child->physical_users, ==, 0);
+    g_assert_cmpint(qemu_plugin_crucible_callback_registration_owner_return_v1(
+        fixture.ctx.id, &runtime->owner), ==, 0);
+    g_assert_null(runtime->owner);
+    g_assert_cmpint(qemu_plugin_crucible_callback_child_storage_return_v1(
+        fixture.ctx.id, &runtime->child), ==, 0);
+    g_assert_null(runtime->child);
+    g_assert_true(startup_source.commands.child.physical_returned);
+    g_assert_cmpint(qemu_plugin_crucible_command_consumer_storage_return_v1(
+        fixture.ctx.id, &runtime->bridge), ==, 0);
+    g_assert_null(runtime->bridge);
+    g_assert_true(startup_source.commands.storage.physical_returned);
+    g_assert_cmpint(close(peer), ==, 0);
+    /* The completion binding still retains its paid Runtime. Its lifetime is
+     * process-held; no local free is mislabeled completion/physical return. */
+    g_assert_true(runtime->purpose->charge.held);
+    g_assert_null(qemu_crucible_startup_source_native_selection_v1());
+}
