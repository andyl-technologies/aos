+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Exercise selected FD-monitor bodies with real forked endpoint replacement.
+
+The kernel descriptors, fork, dup3, epoll and GLib source are real. AIO handler
+storage, its single-thread list lock and the registered reader are explicit
+providers; this is not a linked QEMU or guest execution test.
+"""
+
+import argparse
+import json
+import os
+import runpy
+from pathlib import Path
+import shlex
+import subprocess
+
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+def without_includes(path):
+    return "\n".join(line for line in path.read_text().splitlines()
+                     if not line.startswith("#include"))
+
+
+EXTRACT = runpy.run_path(str(Path(__file__).with_name(
+    "extract-crucible-startup-source-controls.py")))
+
+
+def definition(source, signature):
+    for _, _, _, body in EXTRACT["function_definitions"](source):
+        if body.startswith(signature):
+            return body.rstrip()
+    raise ValueError(f"function definition missing: {signature}")
+
+
+def selected(source, name):
+    for current, _, _, body in EXTRACT["function_definitions"](source):
+        if current == name:
+            return body
+    raise ValueError(f"function definition missing: {name}")
+
+
+def registration_dependencies():
+    api = (ROOT / "plugins/api-system.c").read_text()
+    source = (ROOT / "plugins/crucible-startup-source.c").read_text()
+    declarations = EXTRACT["body_cut"](
+        api, "struct QemuCrucibleFingerprintWakeWatcher {",
+        "size_t qemu_plugin_crucible_wake_watcher_storage_bytes_v1(")
+    declarations += EXTRACT["body_cut"](
+        source, "static QemuCrucibleStartupSourceControl startup_source = {",
+        "static int startup_failure(")
+    declarations += EXTRACT["unique_line"](
+        (ROOT / "util/osdep.c").read_text(),
+        "int qemu_crucible_selected_process_id;")
+    bodies = selected(source,
+        "qemu_crucible_startup_source_fingerprint_enrollment_required_v1")
+    bodies += selected(api, "qemu_plugin_crucible_wake_watcher_current_v1")
+    bodies += selected((ROOT / "util/qemu-thread-posix.c").read_text(),
+                        "qemu_thread_get_self")
+    # No Source constructor or selected process exists in this endpoint fixture.
+    unavailable = {
+        "plugins/api-system.c": ("fingerprint_wake_watcher_return",),
+        "plugins/crucible-startup-source.c": (
+            "qemu_crucible_startup_source_watcher_prebirth_current_v1",
+            "qemu_crucible_startup_source_watcher_borrow_v1",
+            "qemu_crucible_startup_source_watcher_current_v1",
+        ),
+        "system/crucible-hot-fork-coordinator.c": (
+            "qemu_crucible_fingerprint_main_execution_enroll_v1",
+        ),
+    }
+    for path, names in unavailable.items():
+        text = (ROOT / path).read_text()
+        for name in names:
+            signature = selected(text, name).split("{", 1)[0].rstrip()
+            bodies += signature + "\n{\n    g_assert_not_reached();\n}\n"
+    return declarations + bodies
+
+
+PRELUDE = r"""
+#include "qemu/osdep.h"
+#include <sys/epoll.h>
+#include <sys/eventfd.h>
+#include <sys/wait.h>
+#include "qemu/aio.h"
+#include "qemu/main-loop.h"
+#include "qemu/rcu_queue.h"
+#include "qemu/lockable.h"
+#include "qemu/crucible-hot-fork-child.h"
+#include "@AIO_POSIX_HEADER@"
+#include "@SOURCE_HEADER@"
+
+static QemuMutex crucible_hot_fork_aio_lock;
+static bool fixture_registry_locked, fixture_list_locked;
+static unsigned context_lock_calls;
+
+/* One serialized context: typed count/lock providers model no concurrency. */
+void qemu_lockcnt_init(QemuLockCnt *count)
+{
+    count->count = 0;
+}
+
+unsigned qemu_lockcnt_count(QemuLockCnt *count)
+{
+    return count->count;
+}
+
+void qemu_lockcnt_inc(QemuLockCnt *count)
+{
+    ++count->count;
+}
+
+void qemu_lockcnt_dec(QemuLockCnt *count)
+{
+    assert(count->count);
+    --count->count;
+}
+
+bool qemu_lockcnt_dec_if_lock(QemuLockCnt *count)
+{
+    if (count->count != 1) { return false; }
+    --count->count;
+    fixture_list_locked = true;
+    return true;
+}
+
+void qemu_lockcnt_inc_and_unlock(QemuLockCnt *count)
+{
+    assert(fixture_list_locked);
+    fixture_list_locked = false;
+    ++count->count;
+}
+
+void qemu_lockcnt_lock(QemuLockCnt *count)
+{
+    assert(count->count == 0 && !fixture_list_locked);
+    fixture_list_locked = true;
+    ++context_lock_calls;
+}
+
+void qemu_lockcnt_unlock(QemuLockCnt *count)
+{
+    assert(count->count == 0 && fixture_list_locked);
+    fixture_list_locked = false;
+}
+
+void qemu_mutex_init(QemuMutex *mutex)
+{
+    assert(pthread_mutex_init(&mutex->lock, NULL) == 0);
+    mutex->initialized = true;
+}
+
+void qemu_mutex_destroy(QemuMutex *mutex)
+{
+    assert(mutex->initialized);
+    assert(pthread_mutex_destroy(&mutex->lock) == 0);
+    mutex->initialized = false;
+}
+
+void qemu_mutex_lock_impl(QemuMutex *mutex, const char *file, int line)
+{
+    assert(mutex == &crucible_hot_fork_aio_lock && mutex->initialized);
+    assert(pthread_mutex_lock(&mutex->lock) == 0);
+    fixture_registry_locked = true;
+}
+
+void qemu_mutex_unlock_impl(QemuMutex *mutex, const char *file, int line)
+{
+    assert(mutex == &crucible_hot_fork_aio_lock && fixture_registry_locked);
+    fixture_registry_locked = false;
+    assert(pthread_mutex_unlock(&mutex->lock) == 0);
+}
+QemuMutexLockFunc qemu_mutex_lock_func = qemu_mutex_lock_impl;
+
+void qemu_thread_atexit_add(Notifier *notifier) { (void)notifier; }
+bool aio_poll_disabled(AioContext *ctx) { (void)ctx; return true; }
+int qemu_poll_ns(GPollFD *descriptors, unsigned count, int64_t timeout)
+{
+    assert(timeout == 0);
+    return g_poll(descriptors, count, 0);
+}
+void aio_add_ready_handler(AioHandlerList *ready, AioHandler *node, int revents)
+{
+    node->pfd.revents |= revents;
+    if (!QLIST_IS_INSERTED(node, node_ready)) {
+        QLIST_INSERT_HEAD(ready, node, node_ready);
+    }
+}
+"""
+
+PROVIDERS = r"""
+static AioContext *main_context;
+static int qemu_plugin_wake_fd = -1;
+static unsigned reader_calls, invalidations;
+AioContext *qemu_get_aio_context(void) { return main_context; }
+static void qemu_plugin_control_drain_invalidate(void) { ++invalidations; }
+
+/* Descriptor-read provider: it consumes the real registered eventfd but
+ * does not model a protocol acknowledgement, RR callback or guest. */
+static void qemu_plugin_wake_fd_read(void *opaque)
+{
+    uint64_t value;
+    int fd = (int)(intptr_t)opaque;
+
+    assert(read(fd, &value, sizeof(value)) == sizeof(value));
+    assert(value == 1);
+    ++reader_calls;
+}
+
+/* Handler-storage provider uses the selected backend's real update operation.
+ * Replacement reproduces the old/new numeric-FD inputs of aio_set_fd_handler. */
+void aio_set_fd_handler(AioContext *ctx, int fd, IOHandler *io_read,
+                         IOHandler *io_write, AioPollFn *io_poll,
+                         IOHandler *io_poll_ready, void *opaque)
+{
+    AioHandler *old = NULL, *node;
+
+    assert(io_poll == NULL && io_poll_ready == NULL);
+    QLIST_FOREACH(node, &ctx->aio_handlers, node) {
+        if (node->pfd.fd == fd) { old = node; break; }
+    }
+    node = g_new0(AioHandler, 1);
+    node->pfd.fd = fd;
+    node->pfd.events = G_IO_IN | G_IO_HUP | G_IO_ERR;
+    node->io_read = io_read;
+    node->io_write = io_write;
+    node->opaque = opaque;
+    QLIST_INSERT_HEAD(&ctx->aio_handlers, node, node);
+    ctx->fdmon_ops->update(ctx, old, node);
+    if (old) { QLIST_REMOVE(old, node); g_free(old); }
+}
+
+static gboolean source_prepare(GSource *source, gint *timeout)
+{
+    AioContext *ctx = (AioContext *)source;
+
+    *timeout = -1;
+    ctx->fdmon_ops->gsource_prepare(ctx);
+    return false;
+}
+static gboolean source_check(GSource *source)
+{
+    AioContext *ctx = (AioContext *)source;
+    return ctx->fdmon_ops->gsource_check(ctx);
+}
+static gboolean source_dispatch(GSource *source, GSourceFunc callback,
+                                gpointer opaque)
+{
+    AioContext *ctx = (AioContext *)source;
+    AioHandlerList ready = QLIST_HEAD_INITIALIZER(ready);
+    AioHandler *node;
+
+    assert(callback == NULL && opaque == NULL);
+    ctx->fdmon_ops->gsource_dispatch(ctx, &ready);
+    while ((node = QLIST_FIRST(&ready))) {
+        QLIST_REMOVE(node, node_ready);
+        node->pfd.revents = 0;
+        node->io_read(node->opaque);
+    }
+    return true;
+}
+static GSourceFuncs source_functions = {
+    .prepare = source_prepare, .check = source_check,
+    .dispatch = source_dispatch,
+};
+"""
+
+AUTHORITIES = r"""
+static QTAILQ_HEAD(, AioContext) crucible_hot_fork_aio_contexts =
+    QTAILQ_HEAD_INITIALIZER(crucible_hot_fork_aio_contexts);
+static int crucible_hot_fork_async_worker_transaction_active = 1;
+static QemuAsyncWorkerHotForkBarrierInventory fixture_barrier;
+
+/* Admission/barrier inventory providers are controlled negative inputs. The
+ * actual registry and per-context wrapper bodies enforce their real checks. */
+int qemu_get_thread_id(void) { return getpid(); }
+void qemu_async_worker_hot_fork_barrier(
+    QemuAsyncWorkerHotForkBarrierOperation operation,
+    QemuAsyncWorkerHotForkBarrierInventory *inventory)
+{
+    assert(operation == QEMU_ASYNC_WORKER_HOT_FORK_BARRIER_QUERY);
+    *inventory = fixture_barrier;
+}
+
+"""
+
+MAIN = r"""
+typedef enum Refusal {
+    REFUSAL_NONE,
+    REFUSAL_CLOSED_BACKEND,
+    REFUSAL_RETAINED_BAD_HANDLER,
+    REFUSAL_UNRETAINED_HANDLER,
+    REFUSAL_STALE_BARRIER,
+    REFUSAL_PARENT_TRANSACTION,
+    REFUSAL_BAD_LIST,
+    REFUSAL_ACTIVE_ABSENT,
+    REFUSAL_STANDBY_ABSENT,
+    REFUSAL_BARRIER_OWNER,
+    REFUSAL_BARRIER_OPEN,
+    REFUSAL_BARRIER_BUSY,
+    REFUSAL_RELEASED_TRANSACTION,
+    REFUSAL_CHILD_PHASE,
+    REFUSAL_WORKER_START,
+    REFUSAL_UNPOLLABLE_HANDLER,
+} Refusal;
+
+static int compare_fd(const void *left, const void *right)
+{
+    int a = *(const int *)left;
+    int b = *(const int *)right;
+    return (a > b) - (a < b);
+}
+
+static void run_case(const char *name, bool upgrade, bool reconstruct,
+                     bool future_upgrade, Refusal refusal)
+{
+    int endpoints[64], retained[65], replacement;
+    size_t retained_count = ARRAY_SIZE(retained);
+    AioHandlerList ready = QLIST_HEAD_INITIALIZER(ready);
+    GMainContext *loop = g_main_context_new();
+    AioContext *ctx = (AioContext *)g_source_new(&source_functions, sizeof(*ctx));
+    QemuAsyncWorkerHotForkRetainedTransaction transaction = {
+        .barrier_generation = 7,
+        .barrier_owner_thread_id = getpid(),
+        .parent_process_id = getpid(),
+        .parent_thread_id = getpid(),
+        .active = true,
+    };
+    QemuCrucibleHotForkRuntimeTransaction runtime = {
+        .rcu.parent_process_id = getpid(),
+        .active = true, .async_retained = true, .child_prepared = true,
+    };
+    GPollFD inherited_poll[128];
+    int priority, timeout, poll_count;
+    pid_t child;
+    int status;
+
+    qemu_mutex_init(&crucible_hot_fork_aio_lock);
+    qemu_lockcnt_init(&ctx->list_lock);
+    QLIST_INIT(&ctx->aio_handlers);
+    QTAILQ_INIT(&crucible_hot_fork_aio_contexts);
+    QTAILQ_INSERT_TAIL(&crucible_hot_fork_aio_contexts, ctx,
+                       crucible_hot_fork_node);
+    fixture_barrier = (QemuAsyncWorkerHotForkBarrierInventory) {
+        .held = true, .quiescent = true, .generation = 7,
+        .owner_thread_id = getpid(),
+    };
+    ctx->fdmon_ops = &fdmon_poll_ops;
+    ctx->epollfd = -1;
+    main_context = ctx;
+    qemu_plugin_wake_fd = -1;
+    reader_calls = 0;
+    invalidations = 0;
+    context_lock_calls = 0;
+    fdmon_epoll_setup(ctx);
+    assert(ctx->epollfd >= 0);
+    retained[0] = ctx->epollfd;
+
+    for (unsigned index = 0; index < ARRAY_SIZE(endpoints); ++index) {
+        endpoints[index] = eventfd(0, EFD_NONBLOCK | EFD_CLOEXEC);
+        assert(endpoints[index] >= 0);
+        retained[index + 1] = endpoints[index];
+        if (index == 0) {
+            assert(qemu_plugin_register_wake_fd(endpoints[index]) == 0);
+        } else {
+            aio_set_fd_handler(ctx, endpoints[index], qemu_plugin_wake_fd_read,
+                               NULL, NULL, NULL,
+                               (void *)(intptr_t)endpoints[index]);
+        }
+    }
+    qsort(retained, retained_count, sizeof(retained[0]), compare_fd);
+    g_source_attach(&ctx->source, loop);
+    if (upgrade) {
+        qemu_lockcnt_inc(&ctx->list_lock);
+        assert(fdmon_poll_wait(ctx, &ready, 0) == 0);
+        assert(QLIST_EMPTY(&ready));
+        assert(ctx->fdmon_ops == &fdmon_epoll_ops);
+        qemu_lockcnt_dec(&ctx->list_lock);
+    }
+
+    replacement = eventfd(0, EFD_NONBLOCK | EFD_CLOEXEC);
+    assert(replacement >= 0 && replacement != endpoints[0]);
+    /* Match the carrier's POLL_OK fork point: the GLib query predates the
+     * fork and reconstruction, while check/dispatch consumes its old array. */
+    assert(g_main_context_acquire(loop));
+    g_main_context_prepare(loop, &priority);
+    poll_count = g_main_context_query(loop, priority, &timeout, inherited_poll,
+                                      ARRAY_SIZE(inherited_poll));
+    assert(poll_count >= 0 && poll_count <= ARRAY_SIZE(inherited_poll));
+    assert(g_poll(inherited_poll, poll_count, 0) >= 0);
+    fflush(NULL);
+    child = fork();
+    assert(child >= 0);
+    if (child == 0) {
+        QemuCrucibleHotForkDescriptorTableTransaction descriptors = {
+            .parent_pid = getppid(), .child_pid = getpid(),
+            .descriptors_applied = true,
+        };
+        uint64_t value = 1;
+        int original_backend = ctx->epollfd;
+        void *original_tag = ctx->epollfd_tag;
+        const FDMonOps *original_ops = ctx->fdmon_ops;
+        int expected_error = 0;
+
+        assert(dup3(replacement, endpoints[0], O_CLOEXEC) == endpoints[0]);
+        assert(close(replacement) == 0);
+        assert(qemu_plugin_register_wake_fd(endpoints[0]) == 0);
+        assert(invalidations == 1);
+        if (refusal == REFUSAL_CLOSED_BACKEND) {
+            assert(close(original_backend) == 0);
+            expected_error = -EBADF;
+        } else if (refusal == REFUSAL_RETAINED_BAD_HANDLER) {
+            assert(close(endpoints[1]) == 0);
+            expected_error = -EBADF;
+        } else if (refusal == REFUSAL_UNRETAINED_HANDLER) {
+            for (size_t index = 0; index < retained_count; ++index) {
+                if (retained[index] == endpoints[1]) {
+                    memmove(&retained[index], &retained[index + 1],
+                            (retained_count - index - 1) * sizeof(retained[0]));
+                    --retained_count;
+                    break;
+                }
+            }
+            expected_error = -EPERM;
+        } else if (refusal == REFUSAL_STALE_BARRIER) {
+            ++transaction.barrier_generation;
+            expected_error = -EPERM;
+        } else if (refusal == REFUSAL_PARENT_TRANSACTION) {
+            transaction.parent_process_id = getpid();
+            expected_error = -EPERM;
+        } else if (refusal == REFUSAL_BAD_LIST) {
+            retained[1] = retained[0];
+            expected_error = -EINVAL;
+        }
+
+        if (refusal == REFUSAL_ACTIVE_ABSENT ||
+            refusal == REFUSAL_STANDBY_ABSENT) {
+            assert(close(ctx->epollfd) == 0);
+            ctx->epollfd = -1;
+            original_backend = -1;
+            expected_error = upgrade ? -EPROTO : 0;
+        } else if (refusal == REFUSAL_BARRIER_OWNER) {
+            ++fixture_barrier.owner_thread_id;
+            expected_error = -EPERM;
+        } else if (refusal == REFUSAL_BARRIER_OPEN) {
+            fixture_barrier.held = false;
+            expected_error = -EPERM;
+        } else if (refusal == REFUSAL_BARRIER_BUSY) {
+            fixture_barrier.quiescent = false;
+            expected_error = -EPERM;
+        } else if (refusal == REFUSAL_RELEASED_TRANSACTION) {
+            transaction.child_released = true;
+            expected_error = -EPERM;
+        } else if (refusal == REFUSAL_CHILD_PHASE) {
+            runtime.child_prepared = false;
+            expected_error = -EINVAL;
+        } else if (refusal == REFUSAL_WORKER_START) {
+            fixture_worker_result = -EIO;
+            expected_error = -EIO;
+        }
+        if (refusal == REFUSAL_UNPOLLABLE_HANDLER) {
+            FILE *regular = tmpfile();
+            assert(regular);
+            assert(dup3(fileno(regular), endpoints[1], O_CLOEXEC) == endpoints[1]);
+            assert(fclose(regular) == 0);
+            expected_error = -EPERM;
+        }
+        runtime.async = transaction;
+        fixture_original_backend = original_backend;
+        fixture_standby_absent = refusal == REFUSAL_STANDBY_ABSENT;
+        if (reconstruct) {
+            int result = qemu_crucible_hot_fork_start_child_runtime(
+                &runtime, &descriptors, retained, retained_count);
+
+            assert(result == expected_error);
+            assert(!fixture_registry_locked && !fixture_list_locked &&
+                   qemu_lockcnt_count(&ctx->list_lock) == 0);
+            if (expected_error) {
+                assert(!runtime.child_workers_started);
+                if (refusal == REFUSAL_WORKER_START) {
+                    assert(fixture_worker_calls == 1);
+                    assert(ctx->epollfd != original_backend);
+                    _exit(0);
+                }
+                assert(fixture_worker_calls == 0);
+                assert(ctx->epollfd == original_backend);
+                assert(ctx->epollfd_tag == original_tag);
+                assert(ctx->fdmon_ops == original_ops);
+                if (refusal == REFUSAL_CLOSED_BACKEND) {
+                    /* Allocation after refusal reuses the closed number.
+                     * A second call must reject its different kernel kind
+                     * without closing that unrelated live eventfd. */
+                    int reused = eventfd(0, EFD_NONBLOCK | EFD_CLOEXEC);
+                    assert(reused == original_backend);
+                    assert(qemu_aio_hot_fork_reconstruct_child_epoll(
+                        &transaction, retained, retained_count) == -ESTALE);
+                    assert(fcntl(reused, F_GETFD) >= 0);
+                }
+                _exit(0);
+            }
+            assert(context_lock_calls == 1);
+            assert(fixture_worker_calls == 1 && runtime.child_workers_started);
+            if (fixture_standby_absent) {
+                assert(ctx->epollfd == -1);
+            } else {
+                assert(ctx->epollfd != original_backend);
+            }
+            assert(ctx->fdmon_ops == original_ops);
+        }
+        if (future_upgrade) {
+            qemu_lockcnt_inc(&ctx->list_lock);
+            assert(fdmon_poll_wait(ctx, &ready, 0) == 0);
+            assert(QLIST_EMPTY(&ready));
+            assert(ctx->fdmon_ops == &fdmon_epoll_ops);
+            qemu_lockcnt_dec(&ctx->list_lock);
+        }
+        assert(write(endpoints[0], &value, sizeof(value)) == sizeof(value));
+        if (g_main_context_check(loop, priority, inherited_poll, poll_count)) {
+            g_main_context_dispatch(loop);
+        }
+        g_main_context_release(loop);
+        for (unsigned pass = 0; pass < 3; ++pass) {
+            g_main_context_iteration(loop, false);
+        }
+        bool expected = !upgrade || reconstruct;
+        assert(reader_calls == (expected ? 1 : 0));
+        if (!expected) {
+            struct pollfd direct = { .fd = endpoints[0], .events = POLLIN };
+            assert(poll(&direct, 1, 0) == 1 && (direct.revents & POLLIN));
+            assert(ctx->fdmon_ops == &fdmon_epoll_ops);
+        }
+        _exit(0);
+    }
+    assert(waitpid(child, &status, 0) == child);
+    assert(WIFEXITED(status) && WEXITSTATUS(status) == 0);
+    assert(ctx->fdmon_ops == (upgrade ? &fdmon_epoll_ops : &fdmon_poll_ops));
+    if (future_upgrade) {
+        qemu_lockcnt_inc(&ctx->list_lock);
+        assert(fdmon_poll_wait(ctx, &ready, 0) == 0);
+        assert(QLIST_EMPTY(&ready));
+        assert(ctx->fdmon_ops == &fdmon_epoll_ops);
+        qemu_lockcnt_dec(&ctx->list_lock);
+    }
+    if (g_main_context_check(loop, priority, inherited_poll, poll_count)) {
+        g_main_context_dispatch(loop);
+    }
+    g_main_context_release(loop);
+    uint64_t parent_value = 1;
+    assert(write(endpoints[0], &parent_value, sizeof(parent_value)) ==
+           sizeof(parent_value));
+    for (unsigned pass = 0; pass < 3; ++pass) {
+        g_main_context_iteration(loop, false);
+    }
+    assert(reader_calls == 1);
+    printf("PASS %s; parent endpoint/backend intact\n", name);
+    fflush(stdout);
+
+    g_source_destroy(&ctx->source);
+    if (ctx->epollfd >= 0) { close(ctx->epollfd); }
+    for (unsigned index = 0; index < ARRAY_SIZE(endpoints); ++index) {
+        close(endpoints[index]);
+    }
+    close(replacement);
+    AioHandler *node;
+    while ((node = QLIST_FIRST(&ctx->aio_handlers))) {
+        QLIST_REMOVE(node, node);
+        g_free(node);
+    }
+    QTAILQ_REMOVE(&crucible_hot_fork_aio_contexts, ctx, crucible_hot_fork_node);
+    g_source_unref(&ctx->source);
+    g_main_context_unref(loop);
+    qemu_mutex_destroy(&crucible_hot_fork_aio_lock);
+}
+
+int main(void)
+{
+    run_case("poll replacement", false, false, false, REFUSAL_NONE);
+    run_case("epoll baseline remains unread", true, false, false, REFUSAL_NONE);
+    run_case("private active epoll delivers", true, true, false, REFUSAL_NONE);
+    run_case("private standby/future upgrade delivers", false, true, true, REFUSAL_NONE);
+    run_case("closed backend / live wrong-kind reuse refuses", true, true, false,
+             REFUSAL_CLOSED_BACKEND);
+    run_case("retained invalid handler refuses", true, true, false,
+             REFUSAL_RETAINED_BAD_HANDLER);
+    run_case("unretained active handler refuses", true, true, false,
+             REFUSAL_UNRETAINED_HANDLER);
+    run_case("standby unretained handler refuses", false, true, false,
+             REFUSAL_UNRETAINED_HANDLER);
+    run_case("stale barrier refuses", true, true, false, REFUSAL_STALE_BARRIER);
+    run_case("parent transaction refuses", true, true, false,
+             REFUSAL_PARENT_TRANSACTION);
+    run_case("unsorted/duplicate retained list refuses", true, true, false,
+             REFUSAL_BAD_LIST);
+    run_case("active absent backend refuses", true, true, false,
+             REFUSAL_ACTIVE_ABSENT);
+    run_case("absent standby remains poll", false, true, false,
+             REFUSAL_STANDBY_ABSENT);
+    run_case("foreign barrier owner refuses", true, true, false,
+             REFUSAL_BARRIER_OWNER);
+    run_case("open barrier refuses", true, true, false, REFUSAL_BARRIER_OPEN);
+    run_case("busy barrier refuses", true, true, false, REFUSAL_BARRIER_BUSY);
+    run_case("released transaction refuses", true, true, false,
+             REFUSAL_RELEASED_TRANSACTION);
+    run_case("unprepared child refuses", true, true, false, REFUSAL_CHILD_PHASE);
+    run_case("worker refusal propagates after backend reconstruction", true,
+             true, false, REFUSAL_WORKER_START);
+    run_case("kernel registration refusal preserves original backend", true,
+             true, false, REFUSAL_UNPOLLABLE_HANDLER);
+    return 0;
+}
+"""
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--output-dir", type=Path, required=True)
+    parser.add_argument("--omit-refresh", action="store_true",
+                        help="Remove the actual child backend reconstruction call")
+    args = parser.parse_args()
+    args.output_dir.mkdir(parents=True, exist_ok=True)
+
+    poll_body = without_includes(ROOT / "util/fdmon-poll.c")
+    epoll_body = without_includes(ROOT / "util/fdmon-epoll.c")
+    registration = definition((ROOT / "plugins/api-system.c").read_text(),
+                              "int qemu_plugin_register_wake_fd(int fd)")
+    source = args.output_dir / "aio-fork-custody.c"
+    executable = args.output_dir / "aio-fork-custody"
+    exercise = MAIN
+    wrapper = definition((ROOT / "util/aio-posix.c").read_text(),
+                         "int aio_context_reconstruct_child_epoll(")
+    if args.omit_refresh:
+        wrapper = wrapper.replace(
+            "result = fdmon_epoll_reconstruct_child(ctx, retained_fds, retained_count);",
+            "result = 0;")
+    registry = definition((ROOT / "util/async.c").read_text(),
+                          "int qemu_aio_hot_fork_reconstruct_child_epoll(")
+    worker_provider = r"""
+/* The worker start is a bounded provider with genuine transaction storage. */
+static unsigned fixture_worker_calls;
+static int fixture_worker_result, fixture_original_backend;
+static bool fixture_standby_absent;
+int qemu_rcu_hot_fork_start_child_worker(QemuRcuHotForkTransaction *rcu)
+{
+    assert(rcu->parent_process_id == getppid());
+    assert(fixture_barrier.held && fixture_barrier.quiescent);
+    assert(!fixture_registry_locked && !fixture_list_locked &&
+           qemu_lockcnt_count(&main_context->list_lock) == 0);
+    assert(fixture_standby_absent ? main_context->epollfd == -1 :
+           main_context->epollfd != fixture_original_backend);
+    ++fixture_worker_calls;
+    return fixture_worker_result;
+}
+"""
+    start_worker = definition((ROOT / "util/crucible-hot-fork-child.c").read_text(),
+                              "int qemu_crucible_hot_fork_start_child_runtime(")
+    prelude = PRELUDE.replace("@AIO_POSIX_HEADER@", str(ROOT / "util/aio-posix.h"))
+    prelude = prelude.replace("@SOURCE_HEADER@", str(ROOT / "plugins/crucible-startup-source.h"))
+    source.write_text(prelude + epoll_body + poll_body + PROVIDERS + AUTHORITIES
+                      + wrapper + registry + worker_provider + start_worker
+                      + registration_dependencies() + registration + exercise)
+    command = shlex.split(os.environ.get("CC", "cc"))
+    command += shlex.split(os.environ.get("CFLAGS", ""))
+    # Keep the configured QEMU warning set: adding -Wextra diagnoses unused
+    # parameters and signed loops in these unchanged production bodies.
+    command += ["-std=gnu11", "-Wall", "-Werror",
+                "-Wno-unused-function", "-I" + str(ROOT / "include"),
+                str(source), "-o", str(executable)]
+    command += shlex.split(os.environ.get("LDFLAGS", ""))
+    (args.output_dir / "compile-command.json").write_text(
+        json.dumps(command, indent=2) + "\n")
+    subprocess.run(command, check=True)
+    subprocess.run([str(executable)], check=True, timeout=15)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/unit/test-crucible-aio-retirement.c b/tests/unit/test-crucible-aio-retirement.c
