+    if (worker != &startup_source.fingerprint_worker || !worker->native.attempted ||
+        id != startup_source.saved.plugin_id || !out || !startup_owner() ||
+        callback_child_output_overlap(out, sizeof(*out), &startup_source,
+                                      sizeof(startup_source))) {
+        return -EPERM;
+    }
+    if (fingerprint_output_workspace_overlap(out, sizeof(*out))) {
+        return -EINVAL;
+    }
+    if (out->schema_version != 2 || out->struct_size != sizeof(*out)) {
+        return -EINVAL;
+    }
+    qemu_mutex_lock(&startup_source.commands.mutex);
+    *out = (struct qemu_plugin_crucible_fingerprint_worker_status_v2) {
+        .schema_version = 2, .struct_size = sizeof(*out),
+        .first_status = worker->native.first_status, .post_status = worker->native.post_status,
+        .create_status = worker->native.birth.create_status,
+        .mask_restore_status = worker->native.birth.mask_restore_status,
+        .attr_destroy_status = worker->native.birth.attr_destroy_status,
+        .entry_status = worker->native.entry_status, .join_status = worker->native.join_status,
+        .unmap_status = worker->native.unmap_status, .residual_bytes = worker->native.residual_bytes,
+        .births_reserved = startup_source.task_ledger.births_reserved,
+        .born = worker->native.birth.born, .initialized = worker->native.initialized,
+        .closing = worker->native.closing, .entry_returned = worker->native.entry_returned,
+        .joined = worker->native.joined, .destroyed = worker->native.destroyed,
+        .physical_returned = worker->native.physical_returned,
+        .material_held = fingerprint_work_held(worker),
+        .bytes_held = worker->active != NULL,
+        .control_users = worker->native.control_users,
+        .destruction_calls = worker->native.destruction_calls,
+        .control_status = worker->native.control_status,
+        .destructor_status = worker->native.destructor_status,
+        .destruction_first_status = worker->native.destruction_first_status,
+        .destruction_active = worker->native.destruction_active,
+        .destruction_returned = worker->native.destruction_returned,
+        .destruction_begun = worker->native.destroy_attempted,
+        .destruction_uncertain = worker->native.destruction_uncertain,
+        .control_lifetime_status = worker->native.control_lifetime_status,
+        .control_lifetime_uncertain = worker->native.control_lifetime_uncertain,
+    };
+    qemu_mutex_unlock(&startup_source.commands.mutex);
+    return 0;
+}
+
+int qemu_plugin_crucible_fingerprint_worker_identity_return_v1(
+    qemu_plugin_id_t id, QemuCrucibleFingerprintWorker **holder)
+{
+    return plugin_worker_identity_return(id, &startup_source.fingerprint_worker.native, holder);
+}
+#else
+int qemu_crucible_startup_source_output_span_check(const void *out, size_t bytes)
+{
+    return -ENOTSUP;
+}
+#endif
diff --git a/plugins/crucible-idle-wait.c b/plugins/crucible-idle-wait.c
new file mode 100644
index 0000000000000000000000000000000000000000..e8d98a0beb68a58aed72e673fb28070cd31472e5
--- /dev/null
+++ b/plugins/crucible-idle-wait.c
@@ -0,0 +1,171 @@
+/*
+ * Crucible one-shot idle wait core
+ *
+ * Copyright (c) Andyl, Inc.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+
+#include "qemu/crucible-idle-wait.h"
+
+enum qemu_plugin_crucible_idle_wait_status
+qemu_plugin_crucible_idle_wait_once(bool *wait_issued,
+                                    bool context_valid,
+                                    bool wait_supported,
+                                    uint32_t *wake_signal,
+                                    uint32_t expected,
+                                    const QemuPluginCrucibleIdleWaitOps *ops,
+                                    void *opaque,
+                                    bool *rescan_required,
+                                    int *result_errno)
+{
+    int wait_errno = 0;
+    int wait_result;
+
+    *rescan_required = true;
+    if (*wait_issued) {
+        *result_errno = EALREADY;
+        return QEMU_PLUGIN_CRUCIBLE_IDLE_WAIT_ALREADY_ISSUED;
+    }
+    *wait_issued = true;
+
+    if (!wake_signal ||
+        ((uintptr_t)wake_signal % _Alignof(uint32_t)) != 0) {
+        *result_errno = EINVAL;
+        return QEMU_PLUGIN_CRUCIBLE_IDLE_WAIT_INVALID_ARGUMENT;
+    }
+    if (!context_valid || !ops || !ops->pin_cpu || !ops->unpin_cpu ||
+        !ops->arm_wait || !ops->unlock_bql || !ops->lock_bql ||
+        !ops->wait || !ops->disarm_wait ||
+        !ops->cpu_valid_after_wait) {
+        *result_errno = EPERM;
+        return QEMU_PLUGIN_CRUCIBLE_IDLE_WAIT_INVALID_CONTEXT;
+    }
+    if (!wait_supported) {
+        *result_errno = ENOSYS;
+        return QEMU_PLUGIN_CRUCIBLE_IDLE_WAIT_UNSUPPORTED;
+    }
+
+    ops->pin_cpu(opaque);
+    if (!ops->arm_wait(opaque, wake_signal, expected)) {
+        ops->unpin_cpu(opaque);
+        *result_errno = EAGAIN;
+        return QEMU_PLUGIN_CRUCIBLE_IDLE_WAIT_QEMU_WORK_PENDING;
+    }
+
+    ops->unlock_bql(opaque);
+    wait_result = ops->wait(opaque, wake_signal, expected, &wait_errno);
+    ops->lock_bql(opaque);
+    ops->disarm_wait(opaque);
+
+    if (!ops->cpu_valid_after_wait(opaque)) {
+        ops->unpin_cpu(opaque);
+        *result_errno = wait_errno;
+        return QEMU_PLUGIN_CRUCIBLE_IDLE_WAIT_CPU_CHANGED;
+    }
+    ops->unpin_cpu(opaque);
+    *result_errno = wait_errno;
+
+    if (wait_result == 0) {
+        return QEMU_PLUGIN_CRUCIBLE_IDLE_WAIT_WOKEN;
+    }
+    if (wait_errno == EAGAIN) {
+        return QEMU_PLUGIN_CRUCIBLE_IDLE_WAIT_VALUE_CHANGED;
+    }
+    if (wait_errno == EINTR) {
+        return QEMU_PLUGIN_CRUCIBLE_IDLE_WAIT_INTERRUPTED;
+    }
+    return QEMU_PLUGIN_CRUCIBLE_IDLE_WAIT_SYSCALL_ERROR;
+}
+
+int qemu_plugin_crucible_virtual_timer_witness_arm(
+    QemuPluginCrucibleVirtualTimerWitnessState *state,
+    int64_t deadline_ps, uint64_t deadline_tick,
+    uint64_t armed_raw_icount, uint64_t *generation)
+{
+    struct qemu_plugin_crucible_virtual_timer_witness *witness;
+
+    if (!state || !generation || deadline_ps < 0) {
+        return -EINVAL;
+    }
+    witness = &state->witness;
+    if (state->armed && witness->completed == 0) {
+        if (!state->firing && witness->deadline_ps == deadline_ps &&
+            witness->deadline_tick == deadline_tick &&
+            witness->armed_raw_icount == armed_raw_icount) {
+            *generation = witness->generation;
+            return 0;
+        }
+        return -EBUSY;
+    }
+    if (state->next_generation == UINT64_MAX) {
+        return -EOVERFLOW;
+    }
+
+    memset(witness, 0, sizeof(*witness));
+    witness->generation = ++state->next_generation;
+    witness->deadline_ps = deadline_ps;
+    witness->deadline_tick = deadline_tick;
+    witness->armed_raw_icount = armed_raw_icount;
+    state->armed = true;
+    state->firing = false;
+    *generation = witness->generation;
+    return 0;
+}
+
+bool qemu_plugin_crucible_virtual_timer_witness_state_begin(
+    QemuPluginCrucibleVirtualTimerWitnessState *state,
+    int64_t expire_ps, int64_t virtual_ps, uint64_t raw_icount,
+    uint64_t *generation)
+{
+    struct qemu_plugin_crucible_virtual_timer_witness *witness;
+
+    if (!state || !generation || !state->armed || state->firing) {
+        return false;
+    }
+    witness = &state->witness;
+    if (witness->completed != 0 || witness->deadline_ps != expire_ps) {
+        return false;
+    }
+
+    witness->fired_expire_ps = expire_ps;
+    witness->fired_virtual_ps = virtual_ps;
+    witness->fired_raw_icount = raw_icount;
+    state->firing = true;
+    *generation = witness->generation;
+    return true;
+}
+
+void qemu_plugin_crucible_virtual_timer_witness_state_complete(
+    QemuPluginCrucibleVirtualTimerWitnessState *state, uint64_t generation)
+{
+    if (!state || !state->armed || !state->firing || generation == 0 ||
+        state->witness.generation != generation) {
+        return;
+    }
+
+    state->firing = false;
+    state->witness.completed = 1;
+}
+
+int qemu_plugin_crucible_virtual_timer_witness_query(
+    const QemuPluginCrucibleVirtualTimerWitnessState *state,
+    uint64_t generation,
+    struct qemu_plugin_crucible_virtual_timer_witness *witness)
+{
+    if (!witness) {
+        return -EINVAL;
+    }
+    memset(witness, 0, sizeof(*witness));
+    if (!state || !state->armed || generation == 0 ||
+        state->witness.generation != generation) {
+        return -ESTALE;
+    }
+    if (state->witness.completed == 0) {
+        return -EAGAIN;
+    }
+
+    *witness = state->witness;
+    return 0;
+}
diff --git a/plugins/crucible-initial-cpu.inc.h b/plugins/crucible-initial-cpu.inc.h
new file mode 100644
index 0000000000000000000000000000000000000000..7f812a5f7331e51e87327ab188dcac37e4a5c4f7
--- /dev/null
+++ b/plugins/crucible-initial-cpu.inc.h
@@ -0,0 +1,951 @@
+/*
+ * Initial CPU children of the actual machine-construction Original
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+static int initial_cpu_identity(CPUState *cpu,
+    struct QemuCrucibleInitialCpuParticipant **holder,
+    struct QemuCrucibleInitialCpuParticipant **out)
+{
+    QemuCrucibleCpuSourceAllocationOwner *owner = NULL;
+    QemuCrucibleCpuAllocationReceipt *receipt = NULL;
+    uint64_t generation = 0;
+    int status = qemu_crucible_startup_source_cpu_instance_identity_v1(
+        OBJECT(cpu), &owner, &receipt, &generation);
+
+    if (status) {
+        return status;
+    }
+    struct QemuCrucibleInitialCpuParticipant *participant = &owner->initial;
+
+    if (!participant->attempted || !participant->held ||
+        participant->owner != owner || participant->cpu != cpu ||
+        participant->holder != holder || *holder != participant ||
+        participant->process != getpid() || participant->receipt != receipt ||
+        participant->allocation_generation != generation ||
+        participant->binding != &startup_source.standing.construction ||
+        participant->operation_serial != participant->binding->operation.serial) {
+        return -ESTALE;
+    }
+    *out = participant;
+    return 0;
+}
+
+static int initial_cpu_child_source_current(
+    struct QemuCrucibleInitialCpuParticipant *participant, bool returning);
+
+int qemu_crucible_source_construction_cpu_child_current_v1(
+    QemuCrucibleObservationConstructionBinding *binding, CPUState *cpu,
+    struct QemuCrucibleInitialCpuParticipant **holder)
+{
+    struct QemuCrucibleInitialCpuParticipant *participant = NULL;
+    int status = qemu_plugin_crucible_initial_cpu_dispatch_current_v1(
+        cpu, holder, true, false);
+
+    if (!status) {
+        status = initial_cpu_identity(cpu, holder, &participant);
+    }
+    if (!status && (binding != participant->binding || !participant->entered ||
+        (!participant->module_callback_active && !participant->callback_return_observed) ||
+        !binding->operation.held ||
+        binding->operation.post_recorded || binding->operation.class_index ||
+        binding->operation.process != getpid())) {
+        status = -EPERM;
+    }
+    if (!status) {
+        status = qemu_plugin_crucible_initial_cpu_callback_current_v1(
+            cpu, participant->group->callback, participant->callback_return_observed);
+    }
+    if (!status) {
+        status = initial_cpu_child_source_current(
+            participant, participant->callback_return_observed);
+    }
+    return status;
+}
+
+static int initial_cpu_limits_current(const struct QemuCrucibleFingerprintOperation *operation,
+    const QemuCrucibleStandingRecord *current, uint64_t last_now_ns, uint64_t now)
+{
+    const QemuCrucibleStandingBudget *budgets[] = {
+        &operation->admitted.budgets[0], &current->budgets[0],
+    };
+    int status;
+
+    if (now < last_now_ns || now < operation->start_ns || now < operation->progress_ns) {
+        return -ESTALE;
+    }
+    status = standing_limits_current(&operation->admitted, now);
+    if (!status) {
+        status = standing_limits_current(current, now);
+    }
+    for (size_t index = 0; !status && index < G_N_ELEMENTS(budgets); index++) {
+        const QemuCrucibleStandingBudget *budget = budgets[index];
+
+        if ((budget->total_present && now - operation->start_ns >= budget->total_ns) ||
+            (budget->progress_present && now - operation->progress_ns >= budget->progress_ns)) {
+            status = -ETIMEDOUT;
+        }
+    }
+    return status;
+}
+
+/* The original creator remains blocked in its actual construction frame.
+ * The CPU child observes that same live Original; it issues no new clock,
+ * class, progress or operation from a roster or passive execution witness. */
+static int initial_cpu_original_observe(
+    struct QemuCrucibleInitialCpuParticipant *participant, bool post)
+{
+    struct QemuCrucibleFingerprintOperation *operation = &participant->binding->operation;
+    struct pollfd cancellation = {
+        .fd = startup_source.standing.cancellation_fd, .events = POLLIN,
+    };
+    uint64_t sequence = 0;
+    uint64_t now;
+    int status;
+
+    if (!operation->held || operation->post_recorded || operation->class_index ||
+        operation->serial != participant->operation_serial ||
+        operation->process != getpid() || (!post && operation->first_status) ||
+        participant->callback_returned || participant->return_in_flight) {
+        return !post && operation->first_status ? operation->first_status : -EPERM;
+    }
+    if (!participant->cpu->created || !participant->cpu->stopped ||
+        qatomic_read(&participant->cpu->running)) {
+        return -EBUSY;
+    }
+    status = qemu_crucible_startup_source_callback_group_owner_identity_v1(
+        participant->group, QEMU_CRUCIBLE_NATIVE_GROUP_VCPU_INIT, participant->group_serial);
+    if (!status && (!participant->group->native.complete ||
+                    participant->group->native.terminal)) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        status = qemu_crucible_preexec_standing_sequence_v1(
+            startup_source.standing.lender, &sequence);
+    }
+    if (!status && (!sequence || (sequence & 1) || sequence != participant->sequence ||
+                   startup_source.standing.sequence != participant->sequence)) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        int polled = poll(&cancellation, 1, 0);
+
+        status = polled < 0 ? -errno : polled || cancellation.revents ? -ECANCELED : 0;
+    }
+    if (!status) {
+        status = standing_clock(&now);
+    }
+    if (!status) {
+        status = initial_cpu_limits_current(operation, &startup_source.standing.current,
+                                            participant->last_now_ns, now);
+    }
+    if (!status) {
+        participant->last_now_ns = now;
+    }
+    return status;
+}
+
+static int initial_cpu_original_current(
+    struct QemuCrucibleInitialCpuParticipant *participant)
+{
+    return initial_cpu_original_observe(participant, false);
+}
+
+/* This observation never grants permission. A saved first error cannot skip
+ * the independent standing/clock/limit checks at an owned callback's post. */
+static int initial_cpu_original_post(
+    struct QemuCrucibleInitialCpuParticipant *participant)
+{
+    return initial_cpu_original_observe(participant, true);
+}
+
+int qemu_crucible_source_initial_cpu_acquire_v1(
+    CPUState *cpu, struct QemuCrucibleInitialCpuParticipant **holder)
+{
+    QemuCrucibleObservationConstructionBinding *binding = &startup_source.standing.construction;
+    QemuCrucibleCallbackRegistrationGroupOwner *group = &startup_source.callback_groups.vcpu_init;
+    QemuCrucibleCpuSourceAllocationOwner *owner = NULL;
+    QemuCrucibleCpuAllocationReceipt *receipt = NULL;
+    struct QemuCrucibleInitialCpuParticipant *participant;
+    uint64_t generation = 0;
+    int status = qemu_plugin_crucible_initial_cpu_dispatch_current_v1(
+        cpu, holder, false, false);
+
+    if (status || !holder || *holder) {
+        return status ? status : -EINVAL;
+    }
+    if (!standing_construction_operation_identity() ||
+        qemu_crucible_machine_construction_frame_current_v1(binding->frame)) {
+        return -EPERM;
+    }
+    status = qemu_crucible_startup_source_callback_group_owner_identity_v1(
+        group, QEMU_CRUCIBLE_NATIVE_GROUP_VCPU_INIT, group->publication_serial);
+    if (!status && (!group->held || !group->native.complete || group->native.terminal ||
+        !group->callback || group->member_count != 1)) {
+        status = -ENOKEY;
+    }
+    if (!status) {
+        status = qemu_crucible_startup_source_cpu_instance_identity_v1(
+            OBJECT(cpu), &owner, &receipt, &generation);
+    }
+    if (status) {
+        return status;
+    }
+    participant = &owner->initial;
+    if (participant->attempted || participant->held) {
+        return -EALREADY;
+    }
+    object_ref(OBJECT(cpu));
+    *participant = (struct QemuCrucibleInitialCpuParticipant) {
+        .owner = owner, .binding = binding, .group = group,
+        .group_serial = group->publication_serial, .receipt = receipt, .holder = holder,
+        .cpu = cpu, .process = getpid(), .operation_serial = binding->operation.serial,
+        .allocation_generation = generation, .sequence = startup_source.standing.sequence,
+        .last_now_ns = binding->operation.last_now_ns, .attempted = true, .held = true,
+    };
+    qemu_thread_get_self(&participant->creator);
+    *holder = participant;
+    status = initial_cpu_original_current(participant);
+    participant->first_status = participant->post_status = status;
+    return status;
+}
+
+int qemu_crucible_source_initial_cpu_enter_v1(
+    CPUState *cpu, struct QemuCrucibleInitialCpuParticipant **holder)
+{
+    struct QemuCrucibleInitialCpuParticipant *participant = NULL;
+    int status = qemu_plugin_crucible_initial_cpu_dispatch_current_v1(
+        cpu, holder, true, false);
+
+    if (!status) {
+        status = initial_cpu_identity(cpu, holder, &participant);
+    }
+    if (!status && (participant->entered || participant->callback_returned)) {
+        status = -EALREADY;
+    }
+    if (!status) {
+        participant->entered = true;
+        status = initial_cpu_original_current(participant);
+        if (!participant->first_status) {
+            participant->first_status = status;
+        }
+    }
+    return status ? status : participant->first_status;
+}
+
+/* These fields corroborate an already authenticated canonical Native child.
+ * They cannot authenticate a supplied pointer or lend operation permission. */
+static int initial_cpu_child_source_facts_current(
+    const struct QemuCrucibleInitialCpuParticipant *participant,
+    const QemuCrucibleNativeInitialCpuChild *child)
+{
+    if (!child || participant->native_child != child || !participant->child_held ||
+        participant->child_return_in_flight || participant->child_physically_returned ||
+        !participant->owner->constructor_children ||
+        participant->native_child_serial != child->serial) {
+        return -ESTALE;
+    }
+    return 0;
+}
+
+static int initial_cpu_child_source_current(
+    struct QemuCrucibleInitialCpuParticipant *participant, bool returning)
+{
+    /* Core compares the pointer with its real holder before Native observes
+     * the slot. Do not dereference a changed Source journal pointer first. */
+    int status = qemu_plugin_crucible_initial_cpu_child_current_v1(
+        participant->cpu, participant->native_child, returning);
+
+    return status ? status : initial_cpu_child_source_facts_current(
+        participant, participant->native_child);
+}
+
+static int initial_cpu_child_original_observe(
+    struct QemuCrucibleInitialCpuParticipant *participant, bool post);
+
+int qemu_crucible_source_initial_cpu_current_v1(
+    CPUState *cpu, struct QemuCrucibleInitialCpuParticipant **holder)
+{
+    struct QemuCrucibleInitialCpuParticipant *participant = NULL;
+    int status = qemu_plugin_crucible_initial_cpu_dispatch_current_v1(
+        cpu, holder, true, false);
+
+    if (!status) {
+        status = initial_cpu_identity(cpu, holder, &participant);
+    }
+    if (!status && (!participant->entered || !participant->module_callback_active ||
+        qemu_plugin_crucible_initial_cpu_callback_current_v1(
+            cpu, participant->group->callback, false))) {
+        status = -EPERM;
+    }
+    if (!status) {
+        status = initial_cpu_child_source_current(participant, false);
+    }
+    if (!status && (!participant->child_post_recorded || participant->child_first_status ||
+                    participant->child_post_status)) {
+        status = -EPERM;
+    }
+    if (!status) {
+        status = initial_cpu_child_original_observe(participant, false);
+        if (!participant->first_status) {
+            participant->first_status = status;
+        }
+    }
+    return status ? status : participant->first_status;
+}
+
+static void initial_cpu_sdk_record(
+    struct QemuCrucibleInitialCpuParticipant *participant,
+    int first_status, int post_status)
+{
+    if (!participant->sdk_first_status) {
+        participant->sdk_first_status = first_status;
+    }
+    if (!participant->sdk_post_status) {
+        participant->sdk_post_status = post_status;
+    }
+    if (!participant->first_status) {
+        participant->first_status = first_status ? first_status : post_status;
+    }
+}
+
+int qemu_crucible_source_initial_cpu_sdk_post_v1(
+    CPUState *cpu, struct QemuCrucibleInitialCpuParticipant **holder,
+    int first_status)
+{
+    struct QemuCrucibleInitialCpuParticipant *participant = NULL;
+    int status = qemu_plugin_crucible_initial_cpu_dispatch_current_v1(
+        cpu, holder, true, false);
+
+    if (!status) {
+        status = initial_cpu_identity(cpu, holder, &participant);
+    }
+    if (!status && (!participant->entered || !participant->module_callback_active ||
+        qemu_plugin_crucible_initial_cpu_callback_current_v1(
+            cpu, participant->group->callback, false))) {
+        status = -EPERM;
+    }
+    if (!status) {
+        status = initial_cpu_child_source_current(participant, false);
+    }
+    if (status) {
+        return status;
+    }
+    /* The actual SDK result and its independent Original post remain distinct.
+     * Neither result records module return or consumes this physical child. */
+    status = initial_cpu_child_original_observe(participant, true);
+    initial_cpu_sdk_record(participant, first_status, status);
+    return first_status ? first_status : status;
+}
+
+int qemu_crucible_source_initial_cpu_callback_begin_v1(
+    CPUState *cpu, struct QemuCrucibleInitialCpuParticipant **holder,
+    struct qemu_plugin_cb *callback)
+{
+    struct QemuCrucibleInitialCpuParticipant *participant = NULL;
+    int status = qemu_plugin_crucible_initial_cpu_callback_current_v1(cpu, callback, false);
+
+    if (!status) {
+        status = initial_cpu_identity(cpu, holder, &participant);
+    }
+    if (!status && (!participant->entered || participant->module_callback_active ||
+        participant->module_callback_returned || callback != participant->group->callback ||
+        participant->group != &startup_source.callback_groups.vcpu_init ||
+        participant->group_serial != participant->group->publication_serial)) {
+        status = -EPERM;
+    }
+    if (!status) {
+        status = initial_cpu_original_current(participant);
+    }
+    if (!status) {
+        participant->module_callback_active = true;
+    }
+    return status;
+}
+
+static int initial_cpu_child_original_observe(
+    struct QemuCrucibleInitialCpuParticipant *participant, bool post)
+{
+    struct QemuCrucibleInitialCpuParticipant *actual = NULL;
+    int status = initial_cpu_identity(participant->cpu, participant->holder, &actual);
+
+    if (!status && actual != participant) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        status = qemu_plugin_crucible_initial_cpu_callback_current_v1(
+            participant->cpu, participant->group->callback,
+            participant->callback_return_observed);
+    }
+    if (!status && participant->native_child) {
+        status = initial_cpu_child_source_current(
+            participant, participant->callback_return_observed);
+    }
+    if (!status) {
+        status = qemu_crucible_machine_construction_frame_child_current_v1(
+            participant->binding->frame, participant->binding, participant->cpu,
+            participant->holder);
+    }
+    if (!status) {
+        status = post ? initial_cpu_original_post(participant) :
+                        initial_cpu_original_current(participant);
+    }
+    return status;
+}
+
+static int initial_cpu_child_acquire_first(
+    CPUState *cpu, QemuCrucibleNativeInitialCpuChild *child)
+{
+    struct QemuCrucibleInitialCpuParticipant *participant = NULL;
+    int status = cpu ? initial_cpu_identity(cpu, &cpu->crucible_initial_participant,
+                                            &participant) : -EINVAL;
+
+    if (!status) {
+        status = qemu_plugin_crucible_initial_cpu_callback_current_v1(
+            cpu, participant->group->callback, false);
+    }
+    if (!status) {
+        status = qemu_plugin_crucible_initial_cpu_child_current_v1(cpu, child, false);
+    }
+    if (status || !child || participant->native_child ||
+        !participant->entered || !participant->module_callback_active ||
+        participant->owner->constructor_children == UINT_MAX) {
+        return status ? status : -EBUSY;
+    }
+    /* Native corroborates the exact inline child and Core canonical holder;
+     * equality with a supplied serial is never an allocation or callback loan. */
+    if (!child->held || !child->holder || *child->holder != child) {
+        return -EPERM;
+    }
+    object_ref(OBJECT(cpu));
+    participant->owner->constructor_children++;
+    participant->native_child = child;
+    participant->native_child_serial = child->serial;
+    participant->child_held = true;
+    participant->child_first_status = initial_cpu_child_original_observe(participant, false);
+    return participant->child_first_status;
+}
+
+int qemu_crucible_source_initial_cpu_child_acquire_v1(
+    CPUState *cpu, QemuCrucibleNativeInitialCpuChild *child)
+{
+    int first = initial_cpu_child_acquire_first(cpu, child);
+    struct QemuCrucibleInitialCpuParticipant *participant = NULL;
+    int post = cpu ? initial_cpu_identity(cpu, &cpu->crucible_initial_participant,
+                                          &participant) : -EINVAL;
+
+    /* Independently authenticate even an acquisition that failed before a
+     * Source reference existed. A refused post never creates that reference. */
+    if (!post) {
+        post = qemu_plugin_crucible_initial_cpu_child_current_v1(cpu, child, false);
+    }
+    if (!post) {
+        post = initial_cpu_child_original_observe(participant, true);
+    }
+    if (participant && participant->native_child == child && participant->child_held &&
+        !participant->child_post_recorded) {
+        participant->child_post_status = post;
+        participant->child_post_recorded = true;
+        if (!participant->first_status) {
+            participant->first_status = first ? first : post;
+        }
+    }
+    return first ? first : post;
+}
+
+static int initial_cpu_callback_return_first(
+    CPUState *cpu, struct QemuCrucibleInitialCpuParticipant **holder,
+    struct qemu_plugin_cb *callback)
+{
+    struct QemuCrucibleInitialCpuParticipant *participant = NULL;
+    bool entered = false;
+    int status = initial_cpu_identity(cpu, holder, &participant);
+
+    if (!status) {
+        status = qemu_plugin_crucible_initial_cpu_callback_return_observe_v1(
+            cpu, callback, &entered);
+    }
+    if (status || callback != participant->group->callback ||
+        participant->callback_return_observed ||
+        (entered && !participant->module_callback_active)) {
+        return status ? status : -EPERM;
+    }
+    /* Core alone records the real call edge. A denied call clears active
+     * custody without claiming that a module callback physically returned. */
+    participant->module_callback_active = false;
+    participant->module_callback_returned = entered;
+    participant->module_callback_not_entered = !entered;
+    participant->callback_return_observed = true;
+    status = qemu_plugin_crucible_initial_cpu_callback_current_v1(cpu, callback, true);
+    if (!status) {
+        status = initial_cpu_child_original_observe(participant, false);
+    }
+    participant->callback_first_status = status;
+    if (!participant->first_status) {
+        participant->first_status = status;
+    }
+    return status;
+}
+
+static int initial_cpu_callback_return_post(
+    CPUState *cpu, struct QemuCrucibleInitialCpuParticipant **holder,
+    struct qemu_plugin_cb *callback, struct QemuCrucibleInitialCpuParticipant **out)
+{
+    struct QemuCrucibleInitialCpuParticipant *participant = NULL;
+    bool entered = false;
+    int status = initial_cpu_identity(cpu, holder, &participant);
+
+    if (!status) {
+        status = qemu_plugin_crucible_initial_cpu_callback_return_observe_v1(
+            cpu, callback, &entered);
+    }
+    if (status || callback != participant->group->callback) {
+        return status ? status : -EPERM;
+    }
+    *out = participant;
+    if (!participant->callback_return_observed) {
+        return -EPERM;
+    }
+    status = qemu_plugin_crucible_initial_cpu_callback_current_v1(cpu, callback, true);
+    if (!status) {
+        status = initial_cpu_child_original_observe(participant, true);
+    }
+    return status;
+}
+
+int qemu_crucible_source_initial_cpu_callback_end_v1(
+    CPUState *cpu, struct QemuCrucibleInitialCpuParticipant **holder,
+    struct qemu_plugin_cb *callback)
+{
+    int first = initial_cpu_callback_return_first(cpu, holder, callback);
+    struct QemuCrucibleInitialCpuParticipant *participant = NULL;
+    int post = initial_cpu_callback_return_post(cpu, holder, callback, &participant);
+
+    /* Always attempt the independent post, including identity/first refusal.
+     * Only a separately authenticated actual return cut may update this owner. */
+    if (participant && !participant->callback_post_recorded) {
+        participant->callback_post_status = post;
+        participant->callback_post_recorded = true;
+        if (!participant->first_status) {
+            participant->first_status = first ? first : post;
+        }
+    }
+    return first ? first : post;
+}
+
+static bool initial_cpu_register_borrow_held(
+    const struct QemuCrucibleInitialCpuParticipant *participant)
+{
+    const QemuCrucibleInitialRegisterWorkspaceOwner *workspace =
+        &startup_source.initial_register_workspace;
+
+    return (workspace->borrow_held && workspace->borrow_participant == participant) ||
+        qemu_crucible_fault_register_borrow_outstanding_v1(participant->cpu);
+}
+
+int qemu_crucible_source_initial_cpu_callback_closed_v1(
+    CPUState *cpu, struct QemuCrucibleInitialCpuParticipant **holder,
+    struct qemu_plugin_cb *callback)
+{
+    struct QemuCrucibleInitialCpuParticipant *participant = NULL;
+    bool entered = false;
+    int status = initial_cpu_identity(cpu, holder, &participant);
+
+    if (!status) {
+        status = qemu_plugin_crucible_initial_cpu_callback_return_observe_v1(
+            cpu, callback, &entered);
+    }
+    if (!status && (callback != participant->group->callback ||
+        participant->module_callback_active || !participant->callback_return_observed ||
+        !participant->callback_post_recorded ||
+        initial_cpu_register_borrow_held(participant) ||
+        participant->child_held || participant->child_return_in_flight ||
+        (entered ? !participant->module_callback_returned :
+                   !participant->module_callback_not_entered))) {
+        status = -EBUSY;
+    }
+    return status;
+}
+
+int qemu_crucible_source_initial_cpu_child_return_v1(
+    CPUState *cpu, QemuCrucibleNativeInitialCpuChild *child)
+{
+    struct QemuCrucibleInitialCpuParticipant *participant = NULL;
+    bool entered = false;
+    int status = cpu ? initial_cpu_identity(cpu, &cpu->crucible_initial_participant,
+                                            &participant) : -EINVAL;
+
+    if (!status) {
+        status = qemu_plugin_crucible_initial_cpu_callback_return_observe_v1(
+            cpu, participant->group->callback, &entered);
+    }
+    if (!status) {
+        status = qemu_plugin_crucible_initial_cpu_callback_current_v1(
+            cpu, participant->group->callback, true);
+    }
+    if (!status) {
+        status = qemu_plugin_crucible_initial_cpu_child_current_v1(cpu, child, true);
+    }
+    if (status || !child || participant->module_callback_active ||
+        !participant->callback_return_observed || !participant->callback_post_recorded ||
+        participant->child_return_in_flight ||
+        (entered ? !participant->module_callback_returned :
+                   !participant->module_callback_not_entered)) {
+        return status ? status : -EBUSY;
+    }
+    if (initial_cpu_register_borrow_held(participant) ||
+        participant->owner->getter_children) {
+        return -EBUSY;
+    }
+    if (!participant->native_child) {
+        /* Source refused before retaining a dependency. The actual no-call
+         * cut may close Native's child, without inventing a Source return. */
+        return !entered && !participant->child_held ? 0 : -EPERM;
+    }
+    if (participant->native_child != child ||
+        participant->native_child_serial != child->serial) {
+        return -ESTALE;
+    }
+    if (participant->child_physically_returned) {
+        return participant->child_held ? -ESTALE : 0;
+    }
+    if (!participant->child_held || !participant->owner->constructor_children) {
+        return -ESTALE;
+    }
+    /* Both the initial participant and live Native parent still retain real
+     * QOM pins. Keep their journals and the allocation count through this
+     * unlocked physical return; Core cannot exit either parent until we finish. */
+    participant->child_return_in_flight = true;
+    object_unref(OBJECT(cpu));
+    participant->owner->constructor_children--;
+    participant->child_held = false;
+    participant->child_return_in_flight = false;
+    participant->child_physically_returned = true;
+    return 0;
+}
+
+int qemu_crucible_source_initial_cpu_post_v1(
+    CPUState *cpu, struct QemuCrucibleInitialCpuParticipant **holder, int first_status)
+{
+    struct QemuCrucibleInitialCpuParticipant *participant = NULL;
+    int status = qemu_plugin_crucible_initial_cpu_dispatch_current_v1(
+        cpu, holder, true, false);
+
+    if (!status) {
+        status = initial_cpu_identity(cpu, holder, &participant);
+    }
+    if (status || participant->callback_returned) {
+        return status ? status : -EALREADY;
+    }
+    if (!participant->first_status) {
+        participant->first_status = first_status;
+    }
+    participant->post_status = initial_cpu_original_post(participant);
+    if (!participant->post_status && !participant->module_callback_returned) {
+        participant->post_status = -ENOKEY;
+    }
+    /* This actual async producer records its own callback return, including
+     * a refused entry. FIFO ordering alone never writes this physical fact. */
+    participant->callback_returned = true;
+    if (!participant->first_status) {
+        participant->first_status = participant->post_status;
+    }
+    return participant->post_status;
+}
+
+int qemu_crucible_source_initial_cpu_return_v1(
+    CPUState *cpu, struct QemuCrucibleInitialCpuParticipant **holder)
+{
+    struct QemuCrucibleInitialCpuParticipant *participant = NULL;
+    int status = qemu_plugin_crucible_initial_cpu_dispatch_current_v1(
+        cpu, holder, false, true);
+
+    if (!status) {
+        status = initial_cpu_identity(cpu, holder, &participant);
+    }
+    if (status || !qemu_thread_is_self(&participant->creator) ||
+        participant->module_callback_active || participant->child_held ||
+        participant->owner->getter_children ||
+        participant->child_return_in_flight ||
+        (participant->native_child && !participant->child_physically_returned) ||
+        (participant->entered && !participant->callback_returned)) {
+        return status ? status : -EBUSY;
+    }
+    participant->return_in_flight = true;
+    *holder = NULL;
+    object_unref(OBJECT(cpu));
+    participant->return_in_flight = false;
+    participant->held = false;
+    participant->physically_returned = true;
+    return participant->first_status;
+}
+
+int qemu_crucible_source_initial_cpus_closed_v1(void)
+{
+    QemuCrucibleCpuSourceAllocationOwner *owner;
+    int status;
+
+    if (getpid() != startup_source.owner_process) {
+        return -EPERM;
+    }
+    status = pthread_mutex_trylock(&startup_source.cpu_allocations.lock);
+    if (status) {
+        return -status;
+    }
+    for (owner = startup_source.cpu_allocations.owners; owner; owner = owner->next) {
+        if (owner->payload && (!owner->initial.attempted || owner->initial.held ||
+            owner->initial.return_in_flight || owner->initial.child_held ||
+            owner->initial.child_return_in_flight ||
+            (owner->initial.native_child && !owner->initial.child_physically_returned) ||
+            !owner->initial.physically_returned)) {
+            status = -EBUSY;
+            break;
+        }
+    }
+    pthread_mutex_unlock(&startup_source.cpu_allocations.lock);
+    return status;
+}
+
+static int initial_hardware_catalogue_identity(
+    QemuCrucibleInitialHardwareCatalogueLease *lease,
+    QemuCrucibleInitialHardwareCatalogueLease **holder, bool returning)
+{
+    QemuCrucibleCpuSourceAllocationOwner *owner = NULL;
+    QemuCrucibleCpuAllocationReceipt *receipt = NULL;
+    uint64_t generation = 0;
+    int status;
+
+    if (lease != &startup_source.initial_hardware_catalogue ||
+        !lease->attempted || !lease->held || lease->dependency_returned ||
+        lease->return_in_flight || lease->process != getpid() ||
+        lease->holder != holder || !holder || *holder != lease ||
+        lease->account != &startup_source.cpu_metadata_account) {
+        return -EPERM;
+    }
+    status = qemu_crucible_fault_hardware_catalogue_holder_v1(lease, holder, returning);
+    if (!status) {
+        status = cpu_metadata_account_identity(lease->account);
+    }
+    if (!status && lease->fixed_extent != lease->account->fixed_native_extent) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        status = qemu_crucible_startup_source_cpu_instance_identity_v1(
+            OBJECT(lease->cpu), &owner, &receipt, &generation);
+    }
+    if (!status && (owner != lease->cpu_owner || receipt != lease->cpu_receipt ||
+        generation != lease->cpu_generation || !owner->constructor_children)) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        status = qemu_crucible_startup_source_cpu_instance_identity_v1(
+            OBJECT(lease->constructor_cpu), &owner, &receipt, &generation);
+    }
+    if (!status && (owner != lease->constructor_owner ||
+        receipt != lease->constructor_receipt ||
+        generation != lease->constructor_generation || !owner->constructor_children)) {
+        status = -ESTALE;
+    }
+    return status;
+}
+
+int qemu_crucible_source_initial_hardware_catalogue_acquire_v1(
+    CPUState *cpu, QemuCrucibleInitialHardwareCatalogueLease **holder)
+{
+    QemuCrucibleInitialHardwareCatalogueLease *lease = &startup_source.initial_hardware_catalogue;
+    struct QemuCrucibleInitialCpuParticipant *participant = NULL;
+    QemuCrucibleCpuSourceAllocationOwner *owner = NULL;
+    QemuCrucibleCpuAllocationReceipt *receipt = NULL;
+    CPUState *described_cpu = qemu_get_cpu(0);
+    uint64_t generation = 0;
+    int status = qemu_crucible_fault_hardware_catalogue_issuing_v1(cpu, holder);
+
+    if (!status && (!holder || *holder || lease->attempted || !described_cpu)) {
+        status = -EINVAL;
+    }
+    if (!status) {
+        status = qemu_crucible_source_initial_cpu_current_v1(
+            cpu, &cpu->crucible_initial_participant);
+    }
+    if (!status) {
+        status = initial_cpu_identity(cpu, &cpu->crucible_initial_participant, &participant);
+    }
+    if (!status) {
+        status = cpu_metadata_account_identity(&startup_source.cpu_metadata_account);
+    }
+    if (!status) {
+        status = qemu_crucible_startup_source_cpu_instance_identity_v1(
+            OBJECT(described_cpu), &owner, &receipt, &generation);
+    }
+    if (!status && (owner->binding != participant->binding ||
+        !described_cpu->created || !described_cpu->stopped ||
+        qatomic_read(&described_cpu->running) ||
+        owner->constructor_children == UINT_MAX ||
+        participant->owner->constructor_children == UINT_MAX)) {
+        status = -EBUSY;
+    }
+    if (status) {
+        return status;
+    }
+
+    /* The account's authenticated fixed floor reserved this actual Native
+     * declaration before installation. No malloc, new dynamic debit or byte
+     * estimate is involved here. The two QOM dependencies precede output birth.
+     */
+    object_ref(OBJECT(described_cpu));
+    owner->constructor_children++;
+    if (cpu != described_cpu) {
+        object_ref(OBJECT(cpu));
+        participant->owner->constructor_children++;
+    }
+    *lease = (QemuCrucibleInitialHardwareCatalogueLease) {
+        .holder = holder, .account = &startup_source.cpu_metadata_account,
+        .cpu_owner = owner, .constructor_owner = participant->owner,
+        .cpu_receipt = receipt, .constructor_receipt = participant->receipt,
+        .cpu = described_cpu, .constructor_cpu = cpu,
+        .cpu_generation = generation,
+        .constructor_generation = participant->allocation_generation,
+        .operation_serial = participant->operation_serial,
+        .group_serial = participant->group_serial,
+        .fixed_extent = startup_source.cpu_metadata_account.fixed_native_extent,
+        .process = getpid(), .attempted = true, .held = true,
+    };
+    *holder = lease;
+    lease->post_status = initial_cpu_original_current(participant);
+    lease->first_status = lease->post_status;
+    return lease->first_status;
+}
+
+int qemu_crucible_source_initial_hardware_catalogue_current_v1(
+    CPUState *cpu, QemuCrucibleInitialHardwareCatalogueLease *lease,
+    QemuCrucibleInitialHardwareCatalogueLease **holder)
+{
+    struct QemuCrucibleInitialCpuParticipant *participant = NULL;
+    int status = initial_hardware_catalogue_identity(lease, holder, false);
+
+    if (status || !cpu) {
+        return status ? status : -EPERM;
+    }
+    status = qemu_plugin_crucible_initial_cpu_dispatch_current_v1(
+        cpu, &cpu->crucible_initial_participant, true, false);
+    if (!status) {
+        status = initial_cpu_identity(cpu, &cpu->crucible_initial_participant, &participant);
+    }
+    if (!status && (participant->operation_serial != lease->operation_serial ||
+        participant->group_serial != lease->group_serial ||
+        participant->binding != lease->account->binding)) {
+        status = -ESTALE;
+    }
+    if (status) {
+        return status;
+    }
+    status = qemu_crucible_source_initial_cpu_current_v1(
+        cpu, &cpu->crucible_initial_participant);
+    if (!status) {
+        status = initial_cpu_original_current(participant);
+    }
+    if (!lease->first_status) {
+        lease->first_status = status;
+    }
+    return status ? status : lease->first_status;
+}
+
+static int initial_hardware_catalogue_terminal_dependencies(void)
+{
+    CPUState *cpu;
+    QemuCruciblePluginWorker *workers[] = {
+        &startup_source.fingerprint_worker.native,
+        &startup_source.run_worker.native,
+        &startup_source.teardown_worker.native,
+    };
+
+    CPU_FOREACH(cpu) {
+        if (!cpu->stopped || qatomic_read(&cpu->running) || !cpu_work_list_empty(cpu)) {
+            return -EBUSY;
+        }
+    }
+    for (size_t index = 0; index < G_N_ELEMENTS(workers); index++) {
+        if (workers[index]->attempted && !workers[index]->physical_returned) {
+            return -EBUSY;
+        }
+    }
+    for (size_t index = 0; index < G_N_ELEMENTS(startup_source.fingerprint_material); index++) {
+        QemuCrucibleFingerprintMaterial *material = &startup_source.fingerprint_material[index];
+
+        if (material->held || material->work ||
+            (material->capture_entered && !material->physical_returned)) {
+            return -EBUSY;
+        }
+    }
+    if (startup_source.action_original.held ||
+        startup_source.action_original.module_action ||
+        startup_source.action_original.publisher ||
+        startup_source.action_original.uncertain ||
+        startup_source.main_control_borrow.held ||
+        startup_source.main_control_borrow.transition_active ||
+        startup_source.ready_delivery.held || startup_source.ready_delivery.transition_active ||
+        startup_source.parent_park_loan.held || startup_source.parent_park_loan.transition_busy) {
+        return -EBUSY;
+    }
+    return qemu_crucible_source_initial_cpus_closed_v1();
+}
+
+int qemu_crucible_source_initial_hardware_catalogue_terminal_owner_v1(void)
+{
+    return qemu_plugin_crucible_startup_source_retained() && startup_owner() ? 0 : -EPERM;
+}
+
+int qemu_crucible_source_initial_hardware_catalogue_terminal_ready_v1(
+    QemuCrucibleInitialHardwareCatalogueLease *lease,
+    QemuCrucibleInitialHardwareCatalogueLease **holder)
+{
+    int status = qemu_plugin_crucible_initial_hardware_terminal_current_v1();
+
+    if (!status && !startup_owner()) {
+        status = -EPERM;
+    }
+    if (!status) {
+        status = initial_hardware_catalogue_identity(lease, holder, false);
+    }
+    if (!status) {
+        status = initial_hardware_catalogue_terminal_dependencies();
+    }
+    if (!status) {
+        /* This real retirement permanently closes callback entrants and keeps
+         * refusing while descriptors, frames, registrars or group debt remain.
+         * An empty hint or successful atexit callback is not this receipt. */
+        status = qemu_plugin_crucible_native_registry_retired_current_v1(
+            &startup_source.callbacks.native);
+    }
+    return status;
+}
+
+int qemu_crucible_source_initial_hardware_catalogue_return_v1(
+    QemuCrucibleInitialHardwareCatalogueLease **holder)
+{
+    QemuCrucibleInitialHardwareCatalogueLease *lease = &startup_source.initial_hardware_catalogue;
+    int status = qemu_plugin_crucible_initial_hardware_terminal_current_v1();
+
+    if (!status && !startup_owner()) {
+        status = -EPERM;
+    }
+    if (!status) {
+        status = initial_hardware_catalogue_identity(lease, holder, true);
+    }
+    if (status) {
+        return status;
+    }
+    lease->return_in_flight = true;
+    object_unref(OBJECT(lease->cpu));
+    if (lease->constructor_cpu != lease->cpu) {
+        object_unref(OBJECT(lease->constructor_cpu));
+        lease->constructor_owner->constructor_children--;
+    }
+    lease->cpu_owner->constructor_children--;
+    *holder = NULL;
+    lease->held = false;
+    lease->return_in_flight = false;
+    lease->dependency_returned = true;
+    /* Still-mapped static Native backing stays in the original fixed floor. */
+    return 0;
+}
