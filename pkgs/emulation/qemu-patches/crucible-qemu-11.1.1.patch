+    qemu_plugin_id_t id;
+    int status = callback_registry_identity(&id);
+
+    if (status) {
+        return status;
+    }
+    qemu_mutex_lock(&commands->mutex);
+    status = callback_child_owner_identity_locked(owner);
+    if (!status && (owner->closing || owner->child->closing ||
+                    owner->child->callback_closing || owner->child->destructor_attempted ||
+                    owner->child->physical_returned)) {
+        status = -ESTALE;
+    }
+    qemu_mutex_unlock(&commands->mutex);
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
