+int qemu_plugin_crucible_native_main_control_bind_v1(
+    QemuCrucibleNativeInvocationTicket *holder, QemuCrucibleMainControlBorrow *borrow)
+{
+#ifndef CONFIG_USER_ONLY
+    int status = qemu_plugin_crucible_native_main_control_current_v1(holder, false);
+
+    if (!status) {
+        status = qemu_crucible_source_main_control_issuing_v1(borrow, holder);
+    }
+    if (status) {
+        return status;
+    }
+    qemu_mutex_lock(&holder->registry->mutex);
+    if (holder->frame->main_borrow) {
+        status = -EBUSY;
+    } else {
+        holder->frame->main_borrow = borrow;
