+static void *vcpu_registry_worker(void *opaque)
+{
+    void *result;
+
+    qemu_thread_hot_fork_set_current_disposition(
+        QEMU_THREAD_HOT_FORK_VCPU_RESTART);
+    rcu_register_thread();
+    result = registry_worker(opaque);
+    rcu_unregister_thread();
