@@ -272,9 +578,122 @@ Visitor *qobject_output_visitor_new(QObject **result)
     v->visitor.policy_skip = qobject_output_policy_skip;
     v->visitor.complete = qobject_output_complete;
     v->visitor.free = qobject_output_free;
+}
+
+Visitor *qobject_output_visitor_new(QObject **result)
+{
+    QObjectOutputVisitor *v;
+
+    v = g_malloc0(sizeof(*v));
+
+    qobject_output_visitor_init(v);
 
     *result = NULL;
     v->result = result;
 
     return &v->visitor;
 }
+
+int qobject_output_visitor_new_source(QObject **result, Visitor **out)
+{
+    QemuCrucibleQmpAllocationOwner *owner;
+    QObjectOutputVisitor *qov;
+    void *body = NULL;
+    int status;
+
+    if (!result || !out || *out || *result) {
+        return -EINVAL;
+    }
+    status = qemu_crucible_qmp_scope_identity_current(&owner);
+    if (status) {
+        return status;
+    }
+    status = qemu_crucible_qmp_visitor_allocate(SOURCE_OUTPUT_VISITOR, &body);
+    if (body) {
+        qov = body;
+        qobject_output_visitor_init(qov);
+        qov->source = true;
+        qov->source_owner = owner;
+        qov->source_status = status;
+        qov->result = result;
+        *out = &qov->visitor;
+    }
+    return status;
+}
+
+int qobject_output_visitor_complete_source(Visitor *visitor, QObject **result)
+{
+    QObjectOutputVisitor *qov;
+    int status = output_source_identity(visitor);
+
+    if (status) {
+        return status;
+    }
+    qov = to_qov(visitor);
+    if (!output_source_current(qov)) {
+        return qapi_source_output_status(visitor);
+    }
+    if (!result || result != qov->result || *result || !qov->root ||
+        !QSLIST_EMPTY(&qov->stack) || qov->source_pending_value ||
+        qov->source_retained_entry) {
+        return -EBUSY;
+    }
+    status = qobject_source_graph_current(qov->root);
+    if (status) {
+        qov->source_status = status;
+        return status;
+    }
+    *result = qobject_ref(qov->root);
+    qov->result = NULL;
+    return 0;
+}
+
+int qobject_output_visitor_free_source(Visitor **holder)
+{
+    QObjectOutputVisitor *qov;
+    void *body;
+    int status;
+
+    if (!holder) {
+        return -EINVAL;
+    }
+    if (!*holder) {
+        return 0;
+    }
+    status = output_source_identity(*holder);
+    if (status) {
+        return status;
+    }
+    qov = to_qov(*holder);
+    while (!QSLIST_EMPTY(&qov->stack) || qov->source_retained_entry) {
+        if (!qov->source_retained_entry) {
+            qov->source_retained_entry = QSLIST_FIRST(&qov->stack);
+            QSLIST_REMOVE_HEAD(&qov->stack, node);
+        }
+        body = qov->source_retained_entry;
+        status = qemu_crucible_qmp_free(&body);
+        qov->source_retained_entry = body;
+        if (status) {
+            qov->source_post_status = status;
+            return status;
+        }
+    }
+    status = 0;
+    if (qov->source_pending_value) {
+        status = qobject_unref_source(&qov->source_pending_value);
+    }
+    if (!status && qov->root) {
+        status = qobject_unref_source(&qov->root);
+    }
+    if (status) {
+        qov->source_post_status = status;
+        return status;
+    }
+    body = qov;
+    status = qemu_crucible_qmp_free(&body);
+    *holder = body;
+    if (status && body) {
+        to_qov(*holder)->source_post_status = status;
+    }
+    return status;
+}
