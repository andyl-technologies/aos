+static void fork_child_observer(void)
+{
+    g_assert_cmpint(replay_mutex_locked(), ==, callback_expected_locked);
+    g_assert_false(replay_mutex_owned());
+    child_observer_called = true;
+}
+
+static void fork_parent_observer(void)
+{
+    g_assert_cmpint(replay_mutex_locked(), ==, callback_expected_locked);
+    g_assert_cmpint(replay_mutex_owned(), ==, callback_expected_owned);
+    parent_observer_called = true;
+}
+
+static bool enter_subprocess(void)
+{
+    if (g_test_subprocess()) {
+        return true;
+    }
+    g_test_trap_subprocess(NULL, 10 * G_USEC_PER_SEC, 0);
+    g_test_trap_assert_passed();
+    return false;
+}
+
+static void assert_reacquired(void)
+{
+    g_assert_false(replay_mutex_locked());
+    g_assert_false(replay_mutex_owned());
+    replay_mutex_lock();
+    g_assert_true(replay_mutex_locked());
+    g_assert_true(replay_mutex_owned());
+    replay_mutex_unlock();
+    g_assert_false(replay_mutex_locked());
+    g_assert_false(replay_mutex_owned());
+}
+
+static void test_acquisition(void)
+{
+    if (!enter_subprocess()) {
+        return;
+    }
+
+    g_assert_false(replay_mutex_locked());
+    g_assert_false(replay_mutex_owned());
+    replay_mutex_lock();
+    replay_mutex_unlock();
+    g_assert_false(replay_mutex_owned());
+
+    replay_mutex_enable();
+    g_assert_true(replay_mutex_locked());
+    g_assert_true(replay_mutex_owned());
+    replay_mutex_unlock();
+    assert_reacquired();
+    assert_reacquired();
+}
+
+static void *replacement_thread(void *unused)
+{
+    (void)unused;
+    assert_reacquired();
+    return NULL;
+}
+
+static void test_replacement_thread(void)
+{
+    QemuThread thread;
+
+    if (!enter_subprocess()) {
+        return;
+    }
+
+    replay_mutex_enable();
+    replay_mutex_unlock();
+    qemu_thread_create(&thread, "replay-owner", replacement_thread, NULL,
+                       QEMU_THREAD_JOINABLE);
+    qemu_thread_join(&thread);
+    assert_reacquired();
+}
+
+static unsigned int active_replay_owners;
+
+typedef struct ContendingReplayWorker {
+    unsigned int completed;
+} ContendingReplayWorker;
+
+static unsigned int replay_condition_waiters(void)
+{
+    QemuMutexHotForkInventory inventory = { 0 };
+    unsigned int waiters = 0;
+
+    qemu_mutex_hot_fork_inventory(&inventory);
+    g_assert_false(inventory.overflowed);
+    for (size_t index = 0; index < inventory.entry_count; index++) {
+        waiters += inventory.entries[index].condition_waiters;
+    }
+    qemu_mutex_hot_fork_inventory_destroy(&inventory);
+    return waiters;
+}
+
+static void *contending_replay_worker(void *opaque)
+{
+    ContendingReplayWorker *worker = opaque;
+
+    g_assert_false(replay_mutex_locked());
+    g_assert_false(replay_mutex_owned());
+    for (unsigned int iteration = 0; iteration < 1000; iteration++) {
+        replay_mutex_lock();
+        g_assert_true(replay_mutex_locked());
+        g_assert_true(replay_mutex_owned());
+        g_assert_cmpuint(qatomic_fetch_inc(&active_replay_owners), ==, 0);
+        sched_yield();
+        g_assert_true(replay_mutex_owned());
+        g_assert_cmpuint(qatomic_fetch_dec(&active_replay_owners), ==, 1);
+        replay_mutex_unlock();
+        g_assert_false(replay_mutex_locked());
+        g_assert_false(replay_mutex_owned());
+        worker->completed++;
+    }
+    return NULL;
+}
+
+static void test_contending_waiter_ownership(void)
+{
+    ContendingReplayWorker workers[2] = { 0 };
+    QemuThread threads[2];
+    unsigned int attempts;
+
+    if (!enter_subprocess()) {
+        return;
+    }
+
+    g_assert_cmpuint(replay_condition_waiters(), ==, 0);
+    replay_mutex_enable();
+    for (size_t index = 0; index < 2; index++) {
+        qemu_thread_create(&threads[index], "replay-contender",
+                           contending_replay_worker, &workers[index],
+                           QEMU_THREAD_JOINABLE);
+    }
+
+    /* Both workers must reach the real condition queue behind this token. */
+    for (attempts = 0; attempts < 1000000; attempts++) {
+        if (replay_condition_waiters() == 2) {
+            break;
+        }
+        sched_yield();
+    }
+    g_assert_cmpuint(attempts, <, 1000000);
+    g_assert_true(replay_mutex_owned());
+    g_assert_cmpuint(active_replay_owners, ==, 0);
+    replay_mutex_unlock();
+
+    for (size_t index = 0; index < 2; index++) {
+        qemu_thread_join(&threads[index]);
+        g_assert_cmpuint(workers[index].completed, ==, 1000);
+    }
+    g_assert_cmpuint(active_replay_owners, ==, 0);
+    g_assert_cmpuint(replay_condition_waiters(), ==, 0);
+    assert_reacquired();
+}
