index 0000000000000000000000000000000000000000..c2fa1f5d461002291d01e26a4432b93b53bd8569
--- /dev/null
+++ b/tests/unit/test-crucible-tcg-page-collection.py
@@ -0,0 +1,791 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Exercise native system-mode TB page collection and tagged-list insertion.
+
+The production function bodies and list iterator are extracted unchanged.
+GLib owns the real tree; pthread mutexes provide page locks. A transient busy
+trylock is injected explicitly to exercise deterministic retry ordering. The
+PageDesc table and dirty-code notification are providers, not a guest MMU.
+The native fast invalidation, range body and page removal also execute for
+precise-SMC cleanup. CPU restoration, hash removal and jump unlinking are
+providers; a setjmp/longjmp boundary checks all locks are released before exit.
+This does not replace system-mode SMC, MTTCG, or replay integration tests.
+
+For a differential run, use --baseline-revision REF or --baseline-source-root
+ROOT. The same cases execute both native representations and require identical
+stdout: each case prints its exact L (lock), T (successful trylock),
+B (busy trylock), and U (unlock) page-index trace, followed by the success
+marker "page-collection: passed". Stderr reports explicit production lookup,
+tree-creation and heap-entry calls, not all GLib internal allocations; these
+intentionally differ. Membership visits count the preliminary lock-discovery
+walk only. Pages whose locked crossing count is zero must visit no memberships;
+invalidation still walks the native list. Inline collections must
+create no tree or heap entry until the fifth distinct existing page. Standalone
+baseline selection remains available through --revision and --source-root.
+The omission, spill-state, cleanup, ordered-iteration, empty-admission and
+eager-tree negatives must
+fail native ownership, trace or allocation assertions. --emit-only writes the
+selected source fixtures without compiling or executing them.
+"""
+
+import argparse
+import difflib
+import json
+import os
+from pathlib import Path
+import shlex
+import subprocess
+import sys
+
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+def definition(source, signature):
+    """Return a complete source definition beginning at its signature."""
+    start = source.index(signature)
+    brace = source.index("{", start)
+    depth = 1
+    end = brace + 1
+    while depth:
+        depth += (source[end] == "{") - (source[end] == "}")
+        end += 1
+    return source[start:end]
+
+
+PRELUDE = r"""
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <pthread.h>
+#include <setjmp.h>
+#include <glib.h>
+#include "qemu/compiler.h"
+#include "qemu/qtree.h"
+
+#define TARGET_PAGE_BITS 12
+#define TARGET_PAGE_MASK (~(UINT64_C(4096) - 1))
+#define PAGE_SIZE UINT64_C(4096)
+#define MAX_PAGES 16
+typedef uint64_t tb_page_addr_t;
+typedef uint64_t ram_addr_t;
+typedef pthread_mutex_t QemuSpin;
+typedef struct PageDesc PageDesc;
+typedef int PageForEachNext;
+typedef struct TranslationBlock {
+    tb_page_addr_t page_addr[2];
+    uintptr_t page_next[2];
+    uint16_t size;
+    uint32_t cflags;
+} TranslationBlock;
+
+typedef struct TCGCPUOps { bool precise_smc; } TCGCPUOps;
+typedef struct CPUClass { TCGCPUOps *tcg_ops; } CPUClass;
+typedef struct CPUState {
+    CPUClass *cc;
+    uint32_t cflags_next_tb;
+} CPUState;
+
+#define tcg_debug_assert assert
+#define FIXTURE_CFLAGS UINT32_C(0x00020000)
+"""
+
+
+PROVIDERS = r"""
+static PageDesc fixture_pages[MAX_PAGES];
+static bool present[MAX_PAGES], held[MAX_PAGES];
+static int transient_busy_index = -1;
+static unsigned int tree_lookups, tree_creations, entry_allocations, trace_count;
+static unsigned int membership_visits;
+static bool count_membership_visits;
+static unsigned int restored, exits, invalidated, unprotected;
+static TCGCPUOps fixture_ops = { .precise_smc = true };
+static CPUClass fixture_class = { .tcg_ops = &fixture_ops };
+static CPUState fixture_cpu = { .cc = &fixture_class };
+static TranslationBlock *fixture_current_tb;
+static jmp_buf fixture_exit;
+static struct {
+    char operation;
+    unsigned int index;
+} trace[256];
+
+static unsigned int lock_index(QemuSpin *lock)
+{
+    for (unsigned int i = 0; i < MAX_PAGES; i++) {
+        if (lock == &fixture_pages[i].lock) {
+            return i;
+        }
+    }
+    assert(false);
+    return 0;
+}
+
+static void record_lock(char operation, unsigned int index)
+{
+    assert(trace_count < sizeof(trace) / sizeof(trace[0]));
+    trace[trace_count].operation = operation;
+    trace[trace_count++].index = index;
+}
+
+static void qemu_spin_lock(QemuSpin *lock)
+{
+    unsigned int index = lock_index(lock);
+
+    assert(!held[index]);
+    assert(pthread_mutex_lock(lock) == 0);
+    held[index] = true;
+    record_lock('L', index);
+}
+
+static bool qemu_spin_trylock(QemuSpin *lock)
+{
+    unsigned int index = lock_index(lock);
+
+    assert(!held[index]);
+    if ((int)index == transient_busy_index) {
+        transient_busy_index = -1;
+        record_lock('B', index);
+        return true;
+    }
+    assert(pthread_mutex_trylock(lock) == 0);
+    held[index] = true;
+    record_lock('T', index);
+    return false;
+}
+
+static void qemu_spin_unlock(QemuSpin *lock)
+{
+    unsigned int index = lock_index(lock);
+
+    assert(held[index]);
+    held[index] = false;
+    record_lock('U', index);
+    assert(pthread_mutex_unlock(lock) == 0);
+}
+
+static void assert_page_locked(const PageDesc *pd)
+{
+    assert(held[pd - fixture_pages]);
+}
+
+static void assert_no_pages_locked(void)
+{
+    for (unsigned int i = 0; i < MAX_PAGES; i++) {
+        assert(!held[i]);
+    }
+}
+
+static bool counted_membership_visit(const PageDesc *pd)
+{
+    assert_page_locked(pd);
+    membership_visits += count_membership_visits;
+    return true;
+}
+
+static void page_lock__debug(const PageDesc *pd) { }
+static void page_unlock__debug(const PageDesc *pd) { }
+
+static PageDesc *page_find(tb_page_addr_t index)
+{
+    assert(index < MAX_PAGES);
+    return present[index] ? &fixture_pages[index] : NULL;
+}
+
+static PageDesc *page_find_alloc(tb_page_addr_t index, bool alloc)
+{
+    assert(!alloc);
+    assert(page_find(index));
+    return page_find(index);
+}
+
+static void tlb_protect_code(tb_page_addr_t addr)
+{
+    assert_page_locked(page_find(addr >> TARGET_PAGE_BITS));
+}
+
+static void tlb_unprotect_code(tb_page_addr_t addr)
+{
+    assert_page_locked(page_find(addr >> TARGET_PAGE_BITS));
+    unprotected++;
+}
+
+static uint32_t tb_cflags(const TranslationBlock *tb)
+{
+    return tb->cflags;
+}
+
+static TranslationBlock *tcg_tb_lookup(uintptr_t pc)
+{
+    assert(pc == 0x1234);
+    return fixture_current_tb;
+}
+
+static void cpu_restore_state_from_tb(CPUState *cpu, TranslationBlock *tb,
+                                      uintptr_t pc)
+{
+    assert(cpu == &fixture_cpu && tb == fixture_current_tb && pc == 0x1234);
+    restored++;
+}
+
+static uint32_t curr_cflags(CPUState *cpu)
+{
+    assert(cpu == &fixture_cpu);
+    return FIXTURE_CFLAGS;
+}
+
+static void tb_remove(TranslationBlock *tb);
+
+static void do_tb_phys_invalidate(TranslationBlock *tb, bool remove_from_pages)
+{
+    /* Hash removal and jump unlinking are providers; page removal is native. */
+    assert(remove_from_pages);
+    tb_remove(tb);
+    invalidated++;
+}
+
+static G_NORETURN void cpu_loop_exit_noexc(CPUState *cpu)
+{
+    assert(cpu == &fixture_cpu);
+    assert(cpu->cflags_next_tb == (1 | CF_NOIRQ | FIXTURE_CFLAGS));
+    assert_no_pages_locked();
+    exits++;
+    longjmp(fixture_exit, 1);
+}
+
+static gpointer counted_tree_lookup(QTree *tree, gconstpointer key)
+{
+    tree_lookups++;
+    return q_tree_lookup(tree, key);
+}
+
+static QTree *counted_tree_new_full(GCompareDataFunc compare, gpointer data,
+                                   GDestroyNotify key_destroy,
+                                   GDestroyNotify value_destroy)
+{
+    tree_creations++;
+    return q_tree_new_full(compare, data, key_destroy, value_destroy);
+}
+
+static gpointer counted_malloc(gsize bytes)
+{
+    if (bytes == sizeof(struct page_entry)) {
+        entry_allocations++;
+    }
+    return g_malloc(bytes);
+}
+
+#ifdef FIXTURE_INLINE_COLLECTION
+static gpointer counted_malloc_n(gsize count, gsize bytes)
+{
+    if (count == 1 && bytes == sizeof(struct page_entry)) {
+        entry_allocations++;
+    }
+    return g_malloc_n(count, bytes);
+}
+#endif
+
+#define q_tree_lookup counted_tree_lookup
+#define q_tree_new_full counted_tree_new_full
+#define g_malloc counted_malloc
+#ifdef FIXTURE_INLINE_COLLECTION
+#define g_malloc_n counted_malloc_n
+#endif
+"""
+
+
+EXERCISE = r"""
+#undef q_tree_lookup
+#undef q_tree_new_full
+#undef g_malloc
+#undef g_malloc_n
+
+#ifdef FIXTURE_INLINE_COLLECTION
+_Static_assert(PAGE_COLLECTION_INLINE_CAPACITY == 4,
+               "The boundary cases require four inline entries");
+#endif
+
+static void reset_fixture(void)
+{
+    assert_no_pages_locked();
+    for (unsigned int i = 0; i < MAX_PAGES; i++) {
+        fixture_pages[i].first_tb = 0;
+#ifdef FIXTURE_CROSSING_COUNT
+        fixture_pages[i].crossing_tb_count = 0;
+#endif
+        present[i] = false;
+    }
+    transient_busy_index = -1;
+    tree_lookups = 0;
+    tree_creations = 0;
+    entry_allocations = 0;
+    restored = exits = invalidated = unprotected = 0;
+    fixture_current_tb = NULL;
+    fixture_cpu.cflags_next_tb = 0;
+    trace_count = 0;
+    membership_visits = 0;
+    count_membership_visits = false;
+}
+
+static void add_tb(TranslationBlock *tb, unsigned int first,
+                   int second, unsigned int offset)
+{
+    *tb = (TranslationBlock) {
+        .page_addr = { first * PAGE_SIZE + offset,
+                       second < 0 ? -1 : second * PAGE_SIZE },
+        .size = 32,
+    };
+    present[first] = true;
+    assert(pthread_mutex_lock(&fixture_pages[first].lock) == 0);
+    held[first] = true;
+    if (second >= 0 && (unsigned int)second != first) {
+        present[second] = true;
+        assert(pthread_mutex_lock(&fixture_pages[second].lock) == 0);
+        held[second] = true;
+    }
+    /* Native insertion checks lock ownership and creates both list tags. */
+    tb_record(tb);
+    held[first] = false;
+    assert(pthread_mutex_unlock(&fixture_pages[first].lock) == 0);
+    if (second >= 0 && (unsigned int)second != first) {
+        held[second] = false;
+        assert(pthread_mutex_unlock(&fixture_pages[second].lock) == 0);
+    }
+}
+
+static gboolean check_entry(gpointer key, gpointer value, gpointer data)
+{
+    struct page_entry *entry = value;
+    unsigned int *mask = data;
+
+    assert(entry->index < MAX_PAGES);
+    assert(*(tb_page_addr_t *)key == entry->index);
+    assert(!(*mask & (1u << entry->index)));
+    assert(entry->pd == &fixture_pages[entry->index]);
+    assert(entry->locked && held[entry->index]);
+    *mask |= 1u << entry->index;
+    return false;
+}
+
+static void check_trace(const char *name, const char *expected_trace)
+{
+    char actual_trace[1024];
+    size_t position = 0;
+
+    for (unsigned int i = 0; i < trace_count; i++) {
+        int written = snprintf(actual_trace + position,
+                               sizeof(actual_trace) - position,
+                               "%c%u ", trace[i].operation, trace[i].index);
+
+        assert(written > 0 && (size_t)written < sizeof(actual_trace) - position);
+        position += written;
+    }
+    actual_trace[position] = 0;
+    assert(strcmp(actual_trace, expected_trace) == 0);
+    printf("%s: %s\n", name, actual_trace);
+    fprintf(stderr, "%s: tree-lookups=%u trees=%u entries=%u memberships=%u\n",
+            name, tree_lookups, tree_creations, entry_allocations,
+            membership_visits);
+}
+
+static void check_collection(const char *name, unsigned int first,
+                             unsigned int last, unsigned int expected_mask,
+                             const char *expected_trace)
+{
+    struct page_collection *pages;
+#ifdef FIXTURE_INLINE_COLLECTION
+    struct page_collection storage;
+#endif
+    unsigned int found_mask = 0;
+    unsigned int expected_count = __builtin_popcount(expected_mask);
+
+    trace_count = 0;
+    count_membership_visits = true;
+#ifdef FIXTURE_INLINE_COLLECTION
+    pages = &storage;
+    page_collection_lock(pages, first * PAGE_SIZE, last * PAGE_SIZE + 7);
+    if (pages->tree) {
+        q_tree_foreach(pages->tree, check_entry, &found_mask);
+    } else {
+        for (unsigned int i = 0; i < pages->inline_count; i++) {
+            struct page_entry *entry = &pages->inline_entries[i];
+
+            if (i) {
+                assert(pages->inline_entries[i - 1].index < entry->index);
+            }
+            check_entry(&entry->index, entry, &found_mask);
+        }
+    }
+    assert(!!pages->tree == (expected_count > PAGE_COLLECTION_INLINE_CAPACITY));
+    assert(tree_creations == !!pages->tree);
+    assert(entry_allocations == (pages->tree ? expected_count : 0));
+#else
+    pages = page_collection_lock(first * PAGE_SIZE, last * PAGE_SIZE + 7);
+    q_tree_foreach(pages->tree, check_entry, &found_mask);
+    assert(tree_creations == 1);
+    assert(entry_allocations == expected_count);
+#endif
+    count_membership_visits = false;
+
+#ifdef FIXTURE_CROSSING_COUNT
+    if (!strcmp(name, "single-page") || !strcmp(name, "physical-alias")) {
+        assert(membership_visits == 0);
+    }
+#endif
+
+    for (unsigned int i = 0; i < MAX_PAGES; i++) {
+        assert(held[i] == !!(expected_mask & (1u << i)));
+    }
+    assert(found_mask == expected_mask);
+    page_collection_unlock(pages);
+    assert_no_pages_locked();
+
+    check_trace(name, expected_trace);
+}
+
+static void check_precise_exit(bool spill)
+{
+    static TranslationBlock blocks[5];
+
+    reset_fixture();
+    if (spill) {
+        add_tb(&blocks[0], 8, 7, 4090);
+        add_tb(&blocks[1], 8, 6, 4090);
+        add_tb(&blocks[2], 8, 4, 4090);
+        add_tb(&blocks[3], 8, 2, 4090);
+    }
+    add_tb(&blocks[4], 8, -1, 64);
+    fixture_current_tb = &blocks[4];
+
+    if (!setjmp(fixture_exit)) {
+        tb_invalidate_phys_range_fast(&fixture_cpu, 8 * PAGE_SIZE + 80, 1, 0x1234);
+        assert(false); /* A precise current-TB write must leave the caller. */
+    }
+    assert(restored == 1 && exits == 1 && invalidated == 1);
+    assert(unprotected == !spill);
+    assert_no_pages_locked();
+    check_trace(spill ? "precise-exit-spill" : "precise-exit-inline",
+                spill ? "L8 T2 T4 T6 T7 U2 U4 U6 U7 U8 " : "L8 U8 ");
+}
+
+int main(void)
+{
+    TranslationBlock blocks[64];
+
+    for (unsigned int i = 0; i < MAX_PAGES; i++) {
+        assert(pthread_mutex_init(&fixture_pages[i].lock, NULL) == 0);
+    }
+
+    reset_fixture();
+    check_collection("absent", 4, 4, 0, "");
+
+    reset_fixture();
+    present[0] = true;
+    check_collection("first-page-zero", 0, 0, 1, "L0 U0 ");
+
+    reset_fixture();
+    present[4] = true;
+    check_collection("empty", 4, 4, 1u << 4, "L4 U4 ");
+
+    reset_fixture();
+    for (unsigned int i = 0; i < 64; i++) {
+        add_tb(&blocks[i], 4, -1, i * 32);
+    }
+    check_collection("single-page", 4, 4, 1u << 4, "L4 U4 ");
+
+    reset_fixture();
+    add_tb(&blocks[0], 4, 4, 4090);
+    check_collection("physical-alias", 4, 4, 1u << 4, "L4 U4 ");
+
+    reset_fixture();
+    add_tb(&blocks[0], 2, 5, 4090);
+    check_collection("tag-zero", 2, 2, (1u << 2) | (1u << 5),
+                     "L2 L5 U2 U5 ");
+
+    reset_fixture();
+    add_tb(&blocks[0], 5, 2, 4090);
+    check_collection("tag-one", 2, 2, (1u << 2) | (1u << 5),
+                     "L2 L5 U2 U5 ");
+
+    reset_fixture();
+    add_tb(&blocks[0], 5, 2, 4090);
+    check_collection("reverse-order", 5, 5, (1u << 2) | (1u << 5),
+                     "L5 T2 U2 U5 ");
+
+    reset_fixture();
+    add_tb(&blocks[0], 5, 2, 4090);
+    transient_busy_index = 2;
+    check_collection("retry", 5, 5, (1u << 2) | (1u << 5),
+                     "L5 B2 U5 L2 L5 U2 U5 ");
+
+    reset_fixture();
+    add_tb(&blocks[0], 2, 5, 4090);
+    add_tb(&blocks[1], 2, 5, 4080);
+    check_collection("dedup-and-range", 2, 5, (1u << 2) | (1u << 5),
+                     "L2 L5 U2 U5 ");
+
+    reset_fixture();
+    present[2] = present[3] = present[4] = true;
+    check_collection("below-capacity", 2, 4, 0x1c,
+                     "L2 L3 L4 U2 U3 U4 ");
+
+    reset_fixture();
+    present[2] = present[3] = present[4] = present[5] = true;
+    check_collection("at-capacity", 2, 5, 0x3c,
+                     "L2 L3 L4 L5 U2 U3 U4 U5 ");
+
+    reset_fixture();
+    present[2] = present[3] = present[4] = present[5] = present[6] = true;
+    check_collection("spill", 2, 6, 0x7c,
