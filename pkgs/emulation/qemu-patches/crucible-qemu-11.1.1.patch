+int qemu_crucible_startup_source_loader_admit(const char *path, uint64_t bytes,
+                                             unsigned role,
+                                             const char **load_path)
+{
+    if (!qatomic_load_acquire(&qemu_crucible_selected_process_id)) {
+        *load_path = path;
+        return 0;
+    }
+#if defined(CONFIG_LINUX) && defined(__x86_64__) && !defined(__ILP32__)
+    QemuCruciblePreexecSourceBorrow borrowed;
+    QemuCrucibleMetadataAdmission *admission;
+    size_t length;
+    int status;
+
+    if (!qatomic_load_acquire(&startup_source.process_purpose_complete) ||
+        getpid() != startup_source.owner_process) {
+        return -ENOKEY;
+    }
+    status = qemu_crucible_preexec_purpose_borrow_v3(
+        startup_source.preexec_purpose_owner, &borrowed);
+    if (status) {
+        return startup_failure(status);
+    }
+    if (!path || !load_path || role >= 3 || !bytes) {
+        return startup_failure(-EINVAL);
+    }
+    length = strnlen(path, QEMU_CRUCIBLE_PREEXEC_PLUGIN_PATH_BYTES);
+    if (length == QEMU_CRUCIBLE_PREEXEC_PLUGIN_PATH_BYTES ||
+        strlen(borrowed.plugin_path) != length ||
+        memcmp(path, borrowed.plugin_path, length + 1)) {
+        return startup_failure(-ESTALE);
+    }
+    admission = &startup_source.loader_admissions[role];
+    status = qemu_crucible_startup_source_native_metadata_admit(bytes, admission);
+    if (status) {
+        return status;
+    }
+    /* These loader requested allocations remain conservatively charged until
+     * process retirement; freeing a temporary does not return backing credit.
+     */
+    *load_path = borrowed.load_alias;
+    return 0;
+#else
+    return -ENOTSUP;
+#endif
+}
