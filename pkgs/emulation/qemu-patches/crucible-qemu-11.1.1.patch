+static void char_socket_fd_mode_test(gconstpointer opaque)
+{
+    const CharSocketFdMode *mode = opaque;
+    char *directory = g_dir_make_tmp("qemu-char-fd-mode.XXXXXX", NULL);
+    char *path;
+    char *options;
+    QemuOpts *opts;
+    Chardev *chr;
+    CharFrontend frontend = { 0 };
+    FeHandler handler = { 0 };
+    QIOChannelSocket *sender;
+    SocketAddress address = { .type = SOCKET_ADDRESS_TYPE_UNIX };
+    struct stat original_identity;
+    struct stat received_identity;
+    uint64_t event_value = 0;
+    int original_fd;
+    int received_fd;
+    int original_flags;
+    int original_descriptor_flags;
+    int expected_flags;
+
+    g_assert_nonnull(directory);
+    path = g_build_filename(directory, "socket", NULL);
+    options = g_strdup_printf("socket,id=fd-mode,path=%s,server=on,wait=off%s",
+                              path, mode->option);
+    opts = qemu_opts_parse(qemu_find_opts("chardev"), options, true,
+                           &error_abort);
+    chr = qemu_chr_new_from_opts(opts, NULL, &error_abort);
+    qemu_opts_del(opts);
+    g_assert_nonnull(chr);
+    g_assert_cmpint(SOCKET_CHARDEV(chr)->fd_preserve_blocking, ==,
+                    mode->preserved);
+    g_assert_true(qemu_chr_fe_init(&frontend, chr, &error_abort));
+    qemu_chr_fe_set_handlers(&frontend, fe_can_read, fe_read, fe_event,
+                             NULL, &handler, NULL, true);
+
+    address.u.q_unix.path = path;
+    sender = qio_channel_socket_new();
+    g_assert_cmpint(qio_channel_socket_connect_sync(sender, &address,
+                                                   &error_abort), ==, 0);
+    qemu_chr_wait_connected(chr, &error_abort);
+    g_assert_true(chr->be_open);
+    g_assert_true(qemu_chr_has_feature(chr, QEMU_CHAR_FEATURE_FD_PASS));
+
+    original_fd = eventfd(7, (mode->close_on_exec ? EFD_CLOEXEC : 0) |
+                         (mode->nonblocking ? EFD_NONBLOCK : 0));
+    g_assert_cmpint(original_fd, >=, 0);
+    original_flags = fcntl(original_fd, F_GETFL);
+    original_descriptor_flags = fcntl(original_fd, F_GETFD);
+    g_assert_cmpint(original_flags, >=, 0);
+    g_assert_cmpint(!!(original_descriptor_flags & FD_CLOEXEC), ==,
+                    mode->close_on_exec);
+    g_assert_cmpint(!!(original_flags & O_NONBLOCK), ==, mode->nonblocking);
+    g_assert_cmpint(fstat(original_fd, &original_identity), ==, 0);
+
+    char_socket_send_fd(sender->fd, original_fd);
+    main_loop();
+    g_assert_cmpint(handler.read_count, ==, 1);
+    g_assert_cmpint((uint8_t)handler.read_buf[0], ==, 0x5a);
+    received_fd = qemu_chr_fe_get_msgfd(&frontend);
+    g_assert_cmpint(received_fd, >=, 0);
+    g_assert_cmpint(received_fd, !=, original_fd);
+    g_assert_cmpint(qemu_chr_fe_get_msgfd(&frontend), ==, -1);
+    expected_flags = mode->preserved ? original_flags :
+        original_flags & ~O_NONBLOCK;
+    g_assert_cmpint(fcntl(original_fd, F_GETFL), ==, expected_flags);
+    g_assert_cmpint(fcntl(received_fd, F_GETFL), ==, expected_flags);
+    g_assert_cmpint(fcntl(original_fd, F_GETFD), ==, original_descriptor_flags);
+    g_assert_cmpint(fcntl(received_fd, F_GETFD) & FD_CLOEXEC, !=, 0);
+    g_assert_cmpint(fstat(received_fd, &received_identity), ==, 0);
+    g_assert_cmpuint(received_identity.st_dev, ==, original_identity.st_dev);
+    g_assert_cmpuint(received_identity.st_ino, ==, original_identity.st_ino);
+
+    /* Reading the original after import proves its value was not consumed. */
+    g_assert_cmpint(read(original_fd, &event_value, sizeof(event_value)), ==,
+                    sizeof(event_value));
+    g_assert_cmpuint(event_value, ==, 7);
+    g_assert_cmpint(close(received_fd), ==, 0);
+    g_assert_cmpint(fcntl(original_fd, F_GETFD), ==, original_descriptor_flags);
+    g_assert_cmpint(close(original_fd), ==, 0);
+
+    object_unref(OBJECT(sender));
+    qemu_chr_fe_deinit(&frontend, true);
+    g_assert_cmpint(g_rmdir(directory), ==, 0);
+    g_free(options);
+    g_free(path);
+    g_free(directory);
+}
