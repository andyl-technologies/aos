+static void test_rr_time_advance_effects_remain_fenced_until_final_wake(void)
+{
+    unsigned int state = RR_TCG_EXEC_IDLE;
+    unsigned int claimed_state = UINT_MAX;
+    uint64_t consumed_generation = 0;
+    uint64_t publish_generation = 0;
+    bool time_advance_pending = true;
+    RRCrucibleSimWakeSnapshot snapshot = { 0 };
+
+    /* A raced host advance and notifier work both publish under the fence. */
+    g_assert_true(rr_crucible_sim_wake_try_claim(&state, &claimed_state));
+    rr_crucible_sim_wake_publish(
+        &state, claimed_state, &publish_generation);
+    g_assert_true(rr_crucible_sim_wake_try_claim(&state, &claimed_state));
+    rr_crucible_sim_wake_publish(
+        &state, claimed_state, &publish_generation);
+    g_assert_true(time_advance_pending);
+
+    g_assert_true(rr_crucible_sim_wake_consume_snapshot(
+        &state, &publish_generation, consumed_generation, &snapshot));
+    g_assert_cmpint(rr_crucible_sim_wake_try_collapse(
+                        &state, &publish_generation, &consumed_generation,
+                        &snapshot), ==,
+                    RR_TCG_WAKE_CONSUME_PENDING);
+    g_assert_cmpuint(consumed_generation, ==, 2);
+
+    /* The completion wake is canonical while the advance fence remains set. */
+    g_assert_true(rr_crucible_sim_wake_try_claim(&state, &claimed_state));
+    rr_crucible_sim_wake_publish(
+        &state, claimed_state, &publish_generation);
+    g_assert_cmpuint(state, ==, RR_TCG_EXEC_IDLE_WAKE_PENDING);
+    g_assert_true(time_advance_pending);
+
+    /* Completion is observable only after its wake state is durable. */
+    time_advance_pending = false;
+    g_assert_false(time_advance_pending);
+    g_assert_true(rr_crucible_sim_wake_consume_snapshot(
+        &state, &publish_generation, consumed_generation, &snapshot));
+    g_assert_cmpint(rr_crucible_sim_wake_try_collapse(
+                        &state, &publish_generation, &consumed_generation,
+                        &snapshot), ==,
+                    RR_TCG_WAKE_CONSUME_PENDING);
+    g_assert_cmpuint(consumed_generation, ==, 3);
+}
+
+static void test_rr_time_advance_completion_wake_is_idle_and_coalescing(void)
+{
+    unsigned int state = RR_TCG_EXEC_IDLE;
+    unsigned int claimed_state = UINT_MAX;
+    uint64_t consumed_generation = 0;
+    uint64_t publish_generation = 0;
+    RRCrucibleSimWakeSnapshot snapshot = { 0 };
+
+    g_assert_true(rr_crucible_sim_wake_try_claim(&state, &claimed_state));
+    g_assert_true(rr_crucible_sim_time_advance_wake_can_publish(claimed_state));
+    rr_crucible_sim_wake_publish(
+        &state, claimed_state, &publish_generation);
+
+    /* A concurrent generic wake remains in the same durable idle epoch. */
+    g_assert_true(rr_crucible_sim_wake_try_claim(&state, &claimed_state));
+    g_assert_true(rr_crucible_sim_time_advance_wake_can_publish(claimed_state));
+    rr_crucible_sim_wake_publish(
+        &state, claimed_state, &publish_generation);
+    g_assert_cmpuint(state, ==, RR_TCG_EXEC_IDLE_WAKE_PENDING);
+    g_assert_cmpuint(publish_generation, ==, 2);
+
+    g_assert_true(rr_crucible_sim_wake_consume_snapshot(
+        &state, &publish_generation, consumed_generation, &snapshot));
+    g_assert_cmpint(rr_crucible_sim_wake_try_collapse(
+                        &state, &publish_generation, &consumed_generation,
+                        &snapshot), ==,
+                    RR_TCG_WAKE_CONSUME_PENDING);
+    g_assert_cmpuint(consumed_generation, ==, 2);
+
+    g_assert_false(rr_crucible_sim_time_advance_wake_can_publish(
+        RR_TCG_EXEC_STARTING));
+    g_assert_false(rr_crucible_sim_time_advance_wake_can_publish(
+        RR_TCG_EXEC_ACTIVE));
+    g_assert_false(rr_crucible_sim_time_advance_wake_can_publish(
+        RR_TCG_EXEC_ACTIVE_WAKE_PENDING));
+}
+
