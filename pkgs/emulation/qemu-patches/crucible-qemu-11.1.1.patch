+    post_load = post_load.replace("int version_id)",
+                                  "int version_id G_GNUC_UNUSED)")
+    generated = arguments.output_dir / "snapshot-fast-path.c"
+    prelude = PRELUDE.replace("static ICountMode use_icount",
+                              modes + "static ICountMode use_icount")
+    generated.write_text("\n\n".join([prelude, bodies, post_load, CHECKS]))
+    binary = arguments.output_dir / "snapshot-fast-path"
+    command = [os.environ.get("CC", "cc"),
