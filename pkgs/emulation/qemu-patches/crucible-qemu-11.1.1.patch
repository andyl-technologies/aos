+int qemu_crucible_preexec_family_observe_v1(
+    QemuCrucibleFixedFamilyPurposeOwner *held,
+    QemuCrucibleSourceAssignmentOwner *source,
+    QemuCruciblePreexecFamilyObservation *out)
+{
+    QemuCruciblePreexecSetupOwner *owner = &preexec_setup_owner;
+    QemuCrucibleFixedFamilyPurposeOwner *family = &owner->fixed_family;
+    QemuCruciblePreexecPeerObservation peer;
+    QemuCruciblePreexecFamilyObservation observed;
+    int status;
+
+    /* Authenticate registry/singleton identities before dereferencing a
+     * supplied opaque pointer. Observation is not a Target owner constructor. */
+    if (held != family || source != &family->source || !out) {
+        return -EPERM;
+    }
+    if (!family->published || !family->retained || family->issuer != owner ||
+        !family->source.retained || family->source.family != family ||
+        !family->target.reserved || family->target.family != family ||
+        family->source.material.reserved || family->target.material.reserved ||
+        owner->incarnation.assignment != source ||
+        source->process_generation != owner->incarnation.generation ||
+        family->source_process != owner->process_id ||
+        family->source.process != owner->process_id ||
+        family->main_process != owner->peer_process ||
+        family->main_connection.st_dev != owner->control_identity.st_dev ||
+        family->main_connection.st_ino != owner->control_identity.st_ino) {
+        return -ESTALE;
+    }
