+    initialize_cpu(&cpu);
+    cpu.env.insn_flags = ISA_MIPS_R2;
+    origin = kind == 0 ? ((__int128)INT64_MAX + 1) * 1000 + 357 :
+             kind == 1 ? ((__int128)1 << 120) + 357 :
+             kind == 2 ? -((__int128)1 << 120) + 357 : 100000;
+    observed_ps = origin;
+    cpu_mips_store_count(&cpu.env, 0);
+    cpu_mips_store_compare(&cpu.env, 7);
+    deadline = origin + 28000;
+    g_assert_cmpuint(cpu_mips_get_count(&cpu.env), ==, 0);
+    if (exact) {
