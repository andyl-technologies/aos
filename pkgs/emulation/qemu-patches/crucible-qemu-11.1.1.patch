+        "static int crucible_fault_reject_submit(",
+        "static int crucible_fault_complete_rejected_submit(",
+        "int qemu_plugin_crucible_fault_submit(",
+        "int qemu_plugin_crucible_fault_cancel(",
+        "void qemu_crucible_fault_dispatch_boundary(",
+        "bool qemu_crucible_fault_has_pending_at_or_before(",
+        "uint64_t qemu_crucible_fault_next_icount(",
+        "uint64_t qemu_crucible_fault_next_boundary_deadline(",
+        "int64_t qemu_crucible_fault_clamp_budget(",
+        "static void crucible_fault_command_vmstate_free_pending(",
+        "static void crucible_fault_command_vmstate_free_completed(",
+        "static void crucible_fault_command_vmstate_free(",
+        "static void crucible_fault_command_registry_hash(",
+        "static gint crucible_fault_command_u64_compare(",
+        "static int crucible_fault_command_vmstate_encode(",
+        "static void crucible_fault_command_vmstate_commit(",
+    ]
+    bodies = "\n\n".join(definition(queue, signature) for signature in signatures)
+    # Select the actual transitive provider closure. Interleaved retirement
+    # and QObject producers are not declarations and cannot be sliced in with
+    # the queue globals. No selected predicate or callee is rewritten.
+    provider_units = [storage, registration, pending, queue]
+    provider_definitions = {}
+    for unit in provider_units:
+        for name, start, end, body in definitions(unit):
+            provider_definitions[name] = body
+    supplied = {name for name, *_ in definitions(QUEUE_PROVIDERS)}
+    roots = {name for name, *_ in definitions(bodies)}
+    selected = identifiers(bodies + CHECKS) & provider_definitions.keys() - supplied - roots
+    while True:
+        references = set().union(*(identifiers(provider_definitions[name])
+                                   for name in selected))
+        added = references & provider_definitions.keys() - selected - supplied - roots
+        if not added:
+            break
+        selected.update(added)
+    for name, start, end, body in reversed(list(definitions(globals_))):
+        globals_ = globals_[:start] + globals_[end:]
+    registration_provider = (
+        definition(thread, "void qemu_thread_get_self(") + "\n" +
+        definition(thread, "bool qemu_thread_is_self(") + "\n" +
+        impulse + "\n" + storage_declarations + registration_declarations +
+        "\n".join(provider_definitions[name].split("{", 1)[0].rstrip() + ";"
+                  for name in sorted(selected | roots)
+                  if name in provider_definitions) + "\n" +
+        "\n\n".join(provider_definitions[name] for name in sorted(selected)))
+    abi = (ROOT / "include/aos/crucible/crucible_shmem_abi.h").read_text()
+    registration_types += "\n" + next(line for line in abi.splitlines()
+        if line.startswith("#define CRUCIBLE_FAULT_COMMAND_NODE_HANG ")) + "\n"
+    types = instruction[instruction.index("typedef struct CrucibleInstructionMetadata {"):
+                        instruction.index("typedef struct CrucibleInstructionContext {")]
+    completion = definition(instruction,
+                            "void qemu_crucible_fault_instruction_execution_complete(")
+    if arguments.negative_control == "queue":
+        for result in ["false", "UINT64_MAX"]:
+            guard = ("    if (!qatomic_load_acquire(&crucible_pending_count)) {\n"
+                     f"        return {result};\n    }}\n")
+            assert bodies.count(guard) == 1
+            bodies = bodies.replace(guard, "")
+    elif arguments.negative_control == "completion":
+        statement = "    observed_icount = qemu_crucible_fault_observed_icount();\n"
+        assert completion.count(statement) == 1
+        completion = completion.replace(statement, "")
+        completion = completion.replace("    uint64_t observed_icount;",
+                                        statement.strip())
+        completion = completion.replace("observed_icount =", "uint64_t observed_icount =", 1)
+    elif arguments.negative_control == "restore":
+        statement = "    qatomic_store_release(&crucible_pending_count, state->pending_count);\n"
+        assert bodies.count(statement) == 1
+        bodies = bodies.replace(statement, "")
+    generated = arguments.output_dir / "tcg-fast-paths.c"
+    generated.write_text(PRELUDE + handlers + registration_types +
+                         globals_ + registration_provider + QUEUE_PROVIDERS + bodies +
+                         types + INSTRUCTION_PROVIDERS + completion + CHECKS)
+    binary = arguments.output_dir / "tcg-fast-paths"
+    command = [os.environ.get("CC", "cc"),
+               *shlex.split(os.environ.get("CFLAGS", "")),
+               str(generated), str(source_provider), "-o", str(binary),
+               *shlex.split(os.environ.get("LDFLAGS", ""))]
+    (arguments.output_dir / "compile-command.json").write_text(
+        json.dumps({"cwd": os.getcwd(), "argv": command}, indent=2) + "\n")
+    subprocess.run(command, check=True)
+    subprocess.run([str(binary)], cwd=arguments.output_dir, check=True)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/unit/test-crucible-tcg-page-collection.py b/tests/unit/test-crucible-tcg-page-collection.py
