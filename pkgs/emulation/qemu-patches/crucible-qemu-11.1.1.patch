+static void test_periodic_fraction(void)
+{
+    const int64_t offsets[] = { 334, 667, 1000, 1334 };
+    __int128 origin = (__int128)1 << 120;
+    ptimer_state *timer;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    initialize_clock(true);
+    /* Select the existing qtest policy that leaves rapid periods unclamped. */
+    qtest_allowed = true;
+    observed_ps = origin;
+    timer = ptimer_init(observe_expiry, NULL, PTIMER_POLICY_LEGACY);
+    ptimer_transaction_begin(timer);
+    ptimer_set_freq(timer, 3000000000U);
+    ptimer_set_limit(timer, 1, 1);
+    ptimer_run(timer, 0);
+    ptimer_transaction_commit(timer);
+
+    for (size_t i = 0; i < G_N_ELEMENTS(offsets); i++) {
+        g_assert_true(timer_expire_time_ps_wide(timer->timer) ==
