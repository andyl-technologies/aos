+/*
+ * Forking tests run inside the full runtime transaction: RCU's atfork handler
+ * locks registered mutexes, which the retained registry guard would deadlock
+ * unless the RCU transaction has disabled it.
+ */
+static int begin_runtime_transaction_when_quiescent(
+    QemuCrucibleHotForkRuntimeTransaction *transaction)
+{
+    int result = -EBUSY;
+
+    for (unsigned int attempt = 0; attempt < 1000 && result == -EBUSY;
+         attempt++) {
+        result = qemu_crucible_hot_fork_begin_runtime_transaction(transaction);
+        if (result == -EBUSY) {
+            g_usleep(1000);
+        }
+    }
+    return result;
+}
+
+typedef struct TestMutexMapping {
+    uintptr_t reservation_address;
+    uintptr_t mutex_address;
+    size_t page_size;
+} TestMutexMapping;
+
+static QemuMutex *map_test_mutex_page(const TestMutexMapping *mapping,
+                                      int protection)
+{
+    void *address = (void *)mapping->mutex_address;
+    void *result;
+
+    result = mmap(address, mapping->page_size, protection,
+                  MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED, -1, 0);
+    g_assert_true(result != MAP_FAILED);
+    g_assert_true(result == address);
+    return result;
+}
+
+static TestMutexMapping reserve_test_mutex_mapping(void)
+{
+    size_t page_size = qemu_real_host_page_size();
+    void *reservation;
+    TestMutexMapping mapping;
+
+    reservation = mmap(NULL, page_size * 3, PROT_NONE,
+                       MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    g_assert_true(reservation != MAP_FAILED);
+    mapping = (TestMutexMapping) {
+        .reservation_address = (uintptr_t)reservation,
+        .mutex_address = (uintptr_t)reservation + page_size,
+        .page_size = page_size,
+    };
+    map_test_mutex_page(&mapping, PROT_READ | PROT_WRITE);
+    return mapping;
+}
+
+static void abandon_test_mutex_mapping(const TestMutexMapping *mapping)
+{
+    map_test_mutex_page(mapping, PROT_NONE);
+}
+
+static void release_test_mutex_mapping(const TestMutexMapping *mapping)
+{
+    g_assert_cmpint(munmap((void *)mapping->reservation_address,
+                           mapping->page_size * 3),
+                    ==, 0);
+}
