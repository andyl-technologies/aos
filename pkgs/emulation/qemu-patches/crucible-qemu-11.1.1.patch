+    status = qemu_crucible_fingerprint_material_capture_begin_v2(material);
+    if (status) {
+        if (material->owner) {
+            qemu_crucible_fingerprint_material_capture_end_v2(material, -1, 0, status);
+        }
+        return status;
+    }
