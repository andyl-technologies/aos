+static int virtio_blk_ram_physical_check(DeviceState *device, Error **errp)
+{
+    VirtIOBlock *block = VIRTIO_BLK(device);
+    VirtIOBlkConf *conf = &block->conf;
+    AioContext *main_context = qemu_get_aio_context();
+
+    /* Bounce buffers close kernel pins, but an I/O thread could still publish
+     * DMA completion bytes concurrently with an instruction-boundary root.
+     * Admission requires the actual queue and backend contexts to serialize
+     * their guest-memory access with the native main-loop/BQL owner. */
+    if (conf->iothread || conf->iothread_vq_mapping_list ||
+        !conf->conf.blk || !block->vq_aio_context ||
+        blk_get_aio_context(conf->conf.blk) != main_context) {
+        error_setg(errp, "managed RAM requires main-loop virtio-blk ownership");
+        return -ENOTSUP;
+    }
+    for (unsigned index = 0; index < conf->num_queues; index++) {
+        if (block->vq_aio_context[index] != main_context) {
+            error_setg(errp, "managed RAM cannot admit an asynchronous "
+                       "virtio-blk queue owner");
+            return -ENOTSUP;
+        }
+    }
+    return blk_crucible_require_main_aio_context(conf->conf.blk, errp);
+}
