+int qemu_crucible_startup_source_fingerprint_completion_enroll_v1(
+    qemu_plugin_id_t id, QemuCrucibleFingerprintViewReturnCallback view_return,
+    void *userdata,
+    qemu_plugin_crucible_fingerprint_operation_v1 **module_view_holder,
+    struct QemuCrucibleLogicalPublication **publication_holder)
+{
+    QemuCrucibleFingerprintCompletionBinding *binding =
+        &startup_source.fingerprint_completion;
+    uint64_t extent;
+    uintptr_t keeper;
+    uintptr_t field;
+    uintptr_t publication_field;
+    int status;
+
+    if (!view_return || !userdata || !module_view_holder || !publication_holder ||
+        !startup_invocation(id) || id != startup_source.saved.plugin_id ||
+        binding->attempted) {
+        return -EPERM;
+    }
+    status = qemu_crucible_startup_source_fingerprint_observer_current_v1(
+        startup_source.standing.observer);
+    if (!status) {
+        status = startup_runtime_admission(
+            id, &startup_source.runtime_purpose);
+    }
+    if (!status) {
+        status = qemu_crucible_checkpoint_storage_current_v1();
+    }
+    if (status) {
+        return status;
+    }
+    /* Row0 is the genuine already reserved runtime Box request. This check
+     * corroborates a narrow initialized field inside that actual keeper; it
+     * does not create credit from an address or manufacture a new allocation. */
+    extent = startup_runtime_parent_extent(&startup_source.runtime_purpose);
+    keeper = (uintptr_t)userdata;
+    field = (uintptr_t)module_view_holder;
+    publication_field = (uintptr_t)publication_holder;
+
+    if (!extent || extent > UINTPTR_MAX - keeper || field < keeper ||
+        sizeof(*module_view_holder) > extent ||
+        field - keeper > extent - sizeof(*module_view_holder) ||
+        field % _Alignof(qemu_plugin_crucible_fingerprint_operation_v1 *) ||
+        publication_field < keeper || sizeof(*publication_holder) > extent ||
+        publication_field - keeper > extent - sizeof(*publication_holder) ||
+        publication_field % _Alignof(struct QemuCrucibleLogicalPublication *) ||
+        publication_field == field || *module_view_holder || *publication_holder) {
+        return -EINVAL;
+    }
+    /* Save the actual owner/field before independent installing post. Runtime
+     * Box birth and its row0 charge precede this narrow installer enrollment. */
+    *binding = (QemuCrucibleFingerprintCompletionBinding) {
+        .installer = startup_source.saved,
+        .runtime = &startup_source.runtime_purpose,
+        .view_return = view_return,
+        .userdata = userdata,
+        .module_view_holder = module_view_holder,
+        .publication_holder = publication_holder,
+        .process = getpid(),
+        .attempted = true,
+    };
+    binding->post_status = startup_runtime_admission(
+        id, binding->runtime);
+    if (binding->post_status) {
+        binding->first_status = binding->post_status;
+        return binding->post_status;
+    }
+    binding->enrolled = true;
+    return 0;
+}
