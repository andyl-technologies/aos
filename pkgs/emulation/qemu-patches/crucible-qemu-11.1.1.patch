+        if (!(crucible_fingerprint_projection_state_domain(se) & domains)) {
+            continue;
+        }
+        projection = se->vmsd ?
+            se->vmsd->crucible_fingerprint_projection :
+            se->ops->crucible_fingerprint_projection;
+        if (!projection || !projection->schema || !projection->schema[0] ||
+            projection->version == 0 || !projection->save) {
+            error_setg(errp,
+                       "section %s has no dedicated fingerprint projection",
+                       se->idstr);
+            return -ENOTSUP;
+        }
+        if (*sections == UINT64_MAX) {
+            error_setg(errp, "too many read-only fingerprint sections");
+            return -EOVERFLOW;
