+        receiver->module_command_serial != UINT64_MAX && receiver->module_membership &&
+        receiver->module_membership_serial && receiver->module_membership_serial != UINT64_MAX &&
+        receiver->module_cleanup && receiver->module_cleanup_serial &&
+        receiver->module_cleanup_serial != UINT64_MAX;
