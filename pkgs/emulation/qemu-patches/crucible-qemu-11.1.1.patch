+static uint64_t fixture_runtime_native_live(uint64_t roster_bytes)
+{
+    QemuCruciblePluginWorker *workers[] = {
+        &startup_source.run_worker.native, &startup_source.teardown_worker.native,
+    };
+    uint64_t bytes = roster_bytes;
+
+    for (size_t index = 0; index < G_N_ELEMENTS(workers); index++) {
+        QemuCruciblePluginWorker *worker = workers[index];
+
+        g_assert_true(worker->planned);
+        g_assert_true(worker->funding_attempted);
+        g_assert_cmpint(worker->funding_status, ==, 0);
+        g_assert_true(worker->residual_charge.held);
+        g_assert_cmpuint(worker->residual_charge.bytes, ==, worker->residual_bytes);
+        g_assert_true(worker->stack_charge.held);
+        g_assert_cmpuint(worker->stack_charge.bytes, ==, worker->layout.stack_bytes);
+        g_assert_true(worker->task_reserved);
+        g_assert_false(worker->attempted);
+        g_assert_false(worker->birth.born);
+        g_assert_false(worker->physical_returned);
+        bytes += worker->residual_charge.bytes + worker->stack_charge.bytes;
+    }
+    g_assert_cmpuint(startup_source.task_ledger.live_reserved, ==, 2);
+    g_assert_cmpuint(bytes - roster_bytes, ==, fixture_required_worker_charge_bytes());
+    return bytes;
+}
