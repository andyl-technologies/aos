+typedef struct RamMainLoopTest {
+    QemuThread submitter;
+    int64_t main_thread_id;
+    int64_t submitter_thread_id;
+    int64_t callback_thread_id;
+    uint64_t lent_value;
+    unsigned int callback_count;
+    int callback_result;
+    int returned_result;
+    int completed;
+    bool caller_bql_restored;
+} RamMainLoopTest;
+
+static int ram_main_loop_callback(void *opaque)
+{
+    RamMainLoopTest *state = opaque;
+
+    g_assert_true(bql_locked());
+    g_assert_cmpint(qemu_get_thread_id(), ==, state->main_thread_id);
+    g_assert_cmpuint(state->lent_value, ==, 71);
+    state->callback_thread_id = qemu_get_thread_id();
+    state->callback_count++;
+    state->lent_value = 83;
+    return state->callback_result;
+}
+
+static void *ram_main_loop_submit(void *opaque)
+{
+    RamMainLoopTest *state = opaque;
+
+    bql_lock();
+    state->submitter_thread_id = qemu_get_thread_id();
+    state->returned_result = qemu_crucible_ram_run_on_main_loop(
+        ram_main_loop_callback, state);
+    state->caller_bql_restored = bql_locked();
+    bql_unlock();
+    qatomic_set(&state->completed, 1);
+    qemu_notify_event();
+    return NULL;
+}
+
+static void test_ram_main_loop_actor_handoff(void)
+{
+    RamMainLoopTest state = {
+        .main_thread_id = qemu_get_thread_id(),
+        .lent_value = 71,
+        .callback_result = -ESTALE,
+    };
+    unsigned int lifecycle_events = coordinator_test.event_count;
+
+    qemu_thread_create(&state.submitter, "physical submitter", ram_main_loop_submit,
+                       &state, QEMU_THREAD_JOINABLE);
+    /* Production enters main_loop_wait with BQL held; polling releases it
+     * while blocked, then dispatches the main-loop mailbox under BQL. */
+    bql_lock();
+    while (!qatomic_read(&state.completed)) {
+        main_loop_wait(false);
+    }
+    bql_unlock();
+    qemu_thread_join(&state.submitter);
+
+    g_assert_cmpint(state.returned_result, ==, -ESTALE);
+    g_assert_cmpuint(state.callback_count, ==, 1);
+    g_assert_cmpuint(state.lent_value, ==, 83);
+    g_assert_cmpint(state.callback_thread_id, !=, state.submitter_thread_id);
+    g_assert_true(state.caller_bql_restored);
+    g_assert_cmpuint(coordinator_test.event_count, ==, lifecycle_events);
+}
