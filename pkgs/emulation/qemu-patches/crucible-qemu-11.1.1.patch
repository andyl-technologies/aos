+typedef struct VirtioProjectionSharedRegion {
+    const VirtioSharedMemory *region;
+    uint8_t id;
+} VirtioProjectionSharedRegion;
+
+typedef struct VirtioProjectionSharedMapping {
+    const VirtioSharedMemoryMapping *mapping;
+    uint64_t offset;
+    uint64_t length;
+} VirtioProjectionSharedMapping;
+
+static int virtio_projection_compare_shared_regions(const void *left,
+                                                    const void *right)
+{
+    const VirtioProjectionSharedRegion *a = left;
+    const VirtioProjectionSharedRegion *b = right;
+
+    return (a->id > b->id) - (a->id < b->id);
+}
+
+static int virtio_projection_compare_shared_mappings(const void *left,
+                                                     const void *right)
+{
+    const VirtioProjectionSharedMapping *a = left;
+    const VirtioProjectionSharedMapping *b = right;
+
+    if (a->offset != b->offset) {
+        return (a->offset > b->offset) - (a->offset < b->offset);
+    }
+    return (a->length > b->length) - (a->length < b->length);
+}
+
+static bool virtio_projection_validate_shared_memory(
+    const VirtIODevice *vdev, Error **errp)
+{
+    g_autofree VirtioProjectionSharedRegion *regions = NULL;
+    const VirtioSharedMemory *region;
+    uint32_t region_count = 0;
+    uint32_t region_index = 0;
+
+    QSIMPLEQ_FOREACH(region, &vdev->shmem_list, entry) {
+        if (region_count == UINT32_MAX) {
+            error_setg(errp,
+                       "virtio projection has too many shared-memory regions");
+            return false;
+        }
+        region_count++;
+    }
+    regions = g_new(VirtioProjectionSharedRegion, region_count);
+    QSIMPLEQ_FOREACH(region, &vdev->shmem_list, entry) {
+        regions[region_index++] = (VirtioProjectionSharedRegion) {
+            .region = region,
+            .id = region->shmid,
+        };
+    }
+    qsort(regions, region_count, sizeof(*regions),
+          virtio_projection_compare_shared_regions);
+
+    for (region_index = 0; region_index < region_count; region_index++) {
+        g_autofree VirtioProjectionSharedMapping *mappings = NULL;
+        const VirtioSharedMemoryMapping *mapping;
+        const VirtioSharedMemory *current = regions[region_index].region;
+        uint64_t region_size = memory_region_size(&current->mr);
+        uint32_t mapping_count = 0;
+        uint32_t mapping_index = 0;
+
+        if (region_index != 0 &&
+            regions[region_index - 1].id == regions[region_index].id) {
+            error_setg(errp, "virtio projection has duplicate shared-memory "
+                       "region identifiers");
+            return false;
+        }
+        QTAILQ_FOREACH(mapping, &current->mmaps, link) {
+            if (mapping_count == UINT32_MAX) {
+                error_setg(errp, "virtio projection has too many shared-memory "
+                           "mappings");
+                return false;
+            }
+            mapping_count++;
+        }
+        mappings = g_new(VirtioProjectionSharedMapping, mapping_count);
+        QTAILQ_FOREACH(mapping, &current->mmaps, link) {
+            if (!mapping->mr || mapping->shmid != current->shmid ||
+                mapping->len == 0 ||
+                memory_region_size(mapping->mr) != mapping->len ||
+                mapping->offset > region_size ||
+                mapping->len > region_size - mapping->offset) {
+                error_setg(errp, "virtio projection has invalid shared-memory "
+                           "mapping");
+                return false;
+            }
+            mappings[mapping_index++] = (VirtioProjectionSharedMapping) {
+                .mapping = mapping,
+                .offset = mapping->offset,
+                .length = mapping->len,
+            };
+        }
+        qsort(mappings, mapping_count, sizeof(*mappings),
+              virtio_projection_compare_shared_mappings);
+
+        for (mapping_index = 1; mapping_index < mapping_count;
+             mapping_index++) {
+            const VirtioProjectionSharedMapping *previous =
+                &mappings[mapping_index - 1];
+            const VirtioProjectionSharedMapping *candidate =
+                &mappings[mapping_index];
+
+            if (candidate->offset < previous->offset + previous->length) {
+                error_setg(errp, "virtio projection has overlapping "
+                           "shared-memory mappings");
+                return false;
+            }
+        }
+    }
+
+    return true;
+}
+
+static void virtio_projection_put_shared_memory(QEMUFile *f,
+                                                const VirtIODevice *vdev)
+{
+    g_autofree VirtioProjectionSharedRegion *regions = NULL;
+    const VirtioSharedMemory *region;
+    uint32_t region_count = 0;
+    uint32_t region_index = 0;
+
+    QSIMPLEQ_FOREACH(region, &vdev->shmem_list, entry) {
+        region_count++;
+    }
+    regions = g_new(VirtioProjectionSharedRegion, region_count);
+    QSIMPLEQ_FOREACH(region, &vdev->shmem_list, entry) {
+        regions[region_index++] = (VirtioProjectionSharedRegion) {
+            .region = region,
+            .id = region->shmid,
+        };
+    }
+    qsort(regions, region_count, sizeof(*regions),
+          virtio_projection_compare_shared_regions);
+
+    qemu_put_be32(f, region_count);
+    for (region_index = 0; region_index < region_count; region_index++) {
+        g_autofree VirtioProjectionSharedMapping *mappings = NULL;
+        const VirtioSharedMemoryMapping *mapping;
+        const VirtioSharedMemory *current = regions[region_index].region;
+        uint64_t region_size = memory_region_size(&current->mr);
+        uint32_t mapping_count = 0;
+        uint32_t mapping_index = 0;
+
+        QTAILQ_FOREACH(mapping, &current->mmaps, link) {
+            mapping_count++;
+        }
+        mappings = g_new(VirtioProjectionSharedMapping, mapping_count);
+        QTAILQ_FOREACH(mapping, &current->mmaps, link) {
+            mappings[mapping_index++] = (VirtioProjectionSharedMapping) {
+                .mapping = mapping,
+                .offset = mapping->offset,
+                .length = mapping->len,
+            };
+        }
+        qsort(mappings, mapping_count, sizeof(*mappings),
+              virtio_projection_compare_shared_mappings);
+
+        qemu_put_byte(f, current->shmid);
+        qemu_put_be64(f, region_size);
+        qemu_put_be32(f, mapping_count);
+        for (mapping_index = 0; mapping_index < mapping_count;
+             mapping_index++) {
+            const VirtioSharedMemoryMapping *current_mapping =
+                mappings[mapping_index].mapping;
+
+            qemu_put_be64(f, current_mapping->offset);
+            qemu_put_be64(f, current_mapping->len);
+            qemu_put_byte(f, memory_region_is_rom(current_mapping->mr));
+        }
+    }
+}
+
+static bool virtio_fingerprint_validate(
+    const VirtIODevice *vdev, BusState **bus_out,
+    VirtioBusClass **bus_class_out, size_t *name_length_out,
+    Error **errp)
+{
+    DeviceState *device = (DeviceState *)vdev;
+    BusState *bus;
+    VirtioBusClass *bus_class;
+    size_t name_length;
+
+    if (!vdev || !vdev->vq ||
+        (vdev->config_len != 0 && !vdev->config) ||
+        vdev->config_len > UINT32_MAX || !vdev->name) {
+        error_setg(errp, "virtio device has invalid projection state");
+        return false;
+    }
+    bus = qdev_get_parent_bus(device);
+    if (!bus || !object_dynamic_cast(OBJECT(bus), TYPE_VIRTIO_BUS)) {
+        error_setg(errp, "virtio device has no projection-capable transport");
+        return false;
+    }
+    bus_class = VIRTIO_BUS_GET_CLASS(bus);
+    if (!bus_class->validate_fingerprint_projection ||
+        !bus_class->put_fingerprint_projection) {
+        error_setg(errp, "virtio transport has no fingerprint projection");
+        return false;
+    }
+    if (!bus_class->validate_fingerprint_projection(bus->parent, errp)) {
+        return false;
+    }
+
+    name_length = strlen(vdev->name);
+    if (name_length == 0 || name_length > UINT16_MAX) {
+        error_setg(errp, "virtio device has invalid projection provenance");
+        return false;
+    }
+    if (!virtio_projection_validate_shared_memory(vdev, errp)) {
+        return false;
+    }
+    for (size_t index = 0; index < VIRTIO_QUEUE_MAX; index++) {
+        if (vdev->vq[index].vring.num == 0) {
+            continue;
+        }
+        if (vdev->vq[index].queue_index != index) {
+            error_setg(errp, "virtio queue index is not canonical");
+            return false;
+        }
+        if (!virtio_projection_validate_queue(
+                vdev, &vdev->vq[index], errp)) {
+            return false;
+        }
+    }
+
+    *bus_out = bus;
+    *bus_class_out = bus_class;
+    *name_length_out = name_length;
+    return true;
+}
+
+bool virtio_save_fingerprint_projection(QEMUFile *f,
+                                        const VirtIODevice *vdev,
+                                        Error **errp)
+{
+    static const uint8_t schema[] = "crucible.qemu.virtio-core.v2";
+    BusState *bus;
+    VirtioBusClass *bus_class;
+    uint32_t active_queues = 0;
+    size_t name_length;
+
+    if (!f) {
+        error_setg(errp, "virtio projection requires an output file");
+        return false;
+    }
+    if (!virtio_fingerprint_validate(
+            vdev, &bus, &bus_class, &name_length, errp)) {
+        return false;
+    }
+
+    qemu_put_be16(f, sizeof(schema) - 1);
+    qemu_put_buffer(f, schema, sizeof(schema) - 1);
+    qemu_put_be32(f, 2);
+    bus_class->put_fingerprint_projection(bus->parent, f);
+    qemu_put_be16(f, name_length);
+    qemu_put_buffer(f, (const uint8_t *)vdev->name, name_length);
+    qemu_put_be16(f, vdev->device_id);
+    qemu_put_byte(f, vdev->status);
+    qemu_put_byte(f, vdev->isr);
+    qemu_put_be16(f, vdev->queue_sel);
+    for (size_t index = 0; index < VIRTIO_FEATURES_NU64S; index++) {
+        qemu_put_be64(f, vdev->host_features_ex[index]);
+        qemu_put_be64(f, vdev->guest_features_ex[index]);
+        qemu_put_be64(f, vdev->backend_features_ex[index]);
+    }
+    qemu_put_be32(f, vdev->config_len);
+    qemu_put_buffer(f, vdev->config, vdev->config_len);
+    qemu_put_be16(f, vdev->config_vector);
+    qemu_put_be32(f, vdev->generation);
+    qemu_put_be32(f, vdev->nvectors);
+    qemu_put_byte(f, vdev->vm_running);
+    qemu_put_byte(f, vdev->broken);
+    qemu_put_byte(f, vdev->use_disabled_flag);
+    qemu_put_byte(f, vdev->disabled);
+    qemu_put_byte(f, vdev->use_started);
+    qemu_put_byte(f, vdev->started);
+    qemu_put_byte(f, vdev->start_on_kick);
+    qemu_put_byte(f, vdev->disable_legacy_check);
+    qemu_put_byte(f, vdev->vhost_started);
+    qemu_put_byte(f, vdev->use_guest_notifier_mask);
+    qemu_put_byte(f, vdev->device_endian);
+    qemu_put_byte(f, vdev->device_iotlb_enabled);
+    qemu_put_buffer(f, vdev->crucible_dma_identity,
+                    sizeof(vdev->crucible_dma_identity));
+    virtio_projection_put_shared_memory(f, vdev);
+
+    for (size_t index = 0; index < VIRTIO_QUEUE_MAX; index++) {
+        if (vdev->vq[index].vring.num != 0) {
+            active_queues++;
+        }
+    }
+    qemu_put_be32(f, active_queues);
+    for (size_t index = 0; index < VIRTIO_QUEUE_MAX; index++) {
+        if (vdev->vq[index].vring.num == 0) {
