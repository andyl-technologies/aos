+static int candidate_capture_close(
+    struct QemuCrucibleCheckpointCandidateCaptureLoan *claim)
+{
+    CrucibleRamInventory *regions;
+    bool retained_inventory = false;
+    int status = candidate_capture_identity(claim);
+
+    if (status) {
+        return status;
+    }
+    for (size_t index = 0; index < G_N_ELEMENTS(inventory_owners); index++) {
+        CrucibleRamInventoryOwner *owner = &inventory_owners[index];
+
+        if (qatomic_load_acquire(&owner->state) == RAM_INVENTORY_LIVE &&
+            owner->array == capture_regions && owner->references > 1) {
+            retained_inventory = true;
+            break;
+        }
+    }
+    if (!retained_inventory) {
+        return -ESTALE;
+    }
+    /* This drops only the actual extra admission reference. No last-ref
+     * allocator/region finalizers can run: Source still owns the admission. */
+    regions = capture_regions;
+    status = region_inventory_drop(&regions);
+    if (regions) {
+        return status ? status : -EBUSY;
+    }
+    capture_regions = NULL;
+    capture_active = false;
+    capture_owner_token = 0;
+    claim->active = false;
+    claim->issued = false;
+    claim->publication_pending = false;
+    claim->closed = true;
+    return status;
+}
