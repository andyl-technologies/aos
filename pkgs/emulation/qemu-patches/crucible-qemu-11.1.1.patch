+    g_assert_cmpuint(fixture_cas_calls, ==, 2);
+    g_assert_cmpuint(fixture_write_calls, ==, 0);
+    g_assert_cmpuint(fixture_callback_calls, ==, 0);
+
+    /* After exact physical restore, existing ordinary publication/cancel work
+     * with their original generation advancement and callback semantics.
+     */
+    g_assert_cmpint(qemu_crucible_ram_schedule_on_main_loop(
+        fixture_callback, &fixture_callback_opaque), ==, 0);
+    g_assert_cmpuint(ram_scheduled.state, ==, 98);
+    g_assert_cmpint(qemu_crucible_ram_cancel_scheduled_main_loop(), ==, 0);
+    g_assert_cmpuint(ram_scheduled.state, ==, 96);
+    g_assert_cmpint(qemu_crucible_ram_schedule_on_main_loop(
+        fixture_callback, &fixture_callback_opaque), ==, 0);
+    crucible_ram_execute_scheduled();
+    g_assert_cmpuint(fixture_callback_calls, ==, 1);
+    g_assert_cmpuint(ram_scheduled.state, ==, 104);
+    fixture_assert_event_untouched();
+}
