+static int fingerprint_retirement_cancel(int first_status)
+{
+    struct QemuCrucibleFingerprintRetirementLoan *loan = &ordinary_fingerprint;
+    int post, close;
+
+    if (first_status && !loan->first_status) {
+        loan->first_status = first_status;
+    }
+    loan->invoking = true;
+    /* Completed semantic work permits identity-only end, never post replay. */
+    post = loan->attempted ? 0 :
+        qemu_crucible_startup_source_fingerprint_post_v1(loan);
+    if (post && !loan->post_status) {
+        loan->post_status = post;
+    }
+    loan->attempted = true;
+    close = qemu_crucible_startup_source_fingerprint_retirement_end_v1(loan);
+    if (close && !loan->post_status) {
+        loan->post_status = close;
+    }
+    loan->invoking = false;
+    loan->operation_borrowed =
+        !qemu_crucible_startup_source_fingerprint_retirement_idle_v1();
+    fingerprint_retirement_history(loan->first_status, loan->post_status);
+    return loan->first_status ? loan->first_status : loan->post_status;
+}
