+/* Internal publication cut only; a caller result cannot issue a partition. */
+int qemu_crucible_startup_source_inventory_allowance_reserve(uint64_t bytes)
+{
+    int status = qemu_crucible_startup_source_native_metadata_check();
+
+    if (status) {
+        return status;
