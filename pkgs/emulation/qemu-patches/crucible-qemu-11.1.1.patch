+    g_test_add_func("/ppc/booke/wide", test_booke_wide);
+    g_test_add_func("/ppc/booke/overflow", test_booke_overflow);
+    g_test_add_func("/ppc/booke/ordinary", test_booke_ordinary);
+    g_test_add_data_func("/ppc/booke/subms", GUINT_TO_POINTER(0),
+                         test_booke_submillisecond);
+    g_test_add_data_func("/ppc/booke/one-ps", GUINT_TO_POINTER(1),
+                         test_booke_submillisecond);
+    g_test_add_func("/ppc/booke/precise/phase", test_booke_precise_phase);
+    g_test_add_func("/ppc/booke/precise/rollover", test_booke_precise_rollover);
+    g_test_add_func("/ppc/decrementer/wide", test_decrementer_wide);
+    g_test_add_func("/ppc/decrementer/negative",
+                    test_decrementer_negative_phase);
+    g_test_add_func("/ppc/pit/wide-reload", test_pit_wide_reload);
+    g_test_add_func("/ppc/decrementer/tick-wrap", test_decrementer_tick_wrap);
+    g_test_add_func("/ppc/decrementer/ordinary", test_ordinary_decrementer);
+    g_test_add_func("/ppc/migration/ordinary", test_ordinary_migration);
+    g_test_add_func("/ppc/migration/wide", test_wide_migration);
+    g_test_add_func("/ppc/migration/negative", test_negative_migration);
+    g_test_add_func("/ppc/migration/all-timers", test_all_timer_migration);
+    for (unsigned mutation = 0; mutation < 8; mutation++) {
+        g_autofree char *name = g_strdup_printf("/ppc/migration/refusal/%u",
+                                               mutation);
+
+        g_test_add_data_func(name, GUINT_TO_POINTER(mutation),
+                             test_malformed_migration);
+    }
+    return g_test_run();
+}
