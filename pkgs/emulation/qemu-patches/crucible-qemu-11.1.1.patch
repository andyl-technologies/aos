+        production_definition(block_types, "typedef struct BdrvCrucibleHotForkFileState", True),
+        production_definition(block_types, "typedef enum BdrvCrucibleHotForkFileAction", True),
+        production_definition(native, "typedef struct HotForkChildFileEntry", True),
+        *functions, SUPERVISOR_CONTROLS,
+        TESTS.replace("int main(void)\n{", """int main(void)
+{
+    const char *control = getenv("PROCFD_SUPERVISOR_CONTROL");
+
+    if (control) {
+        return supervisor_control(control);
+    }
+""", 1),
+    ]))
