+/* Caller holds the Source CPU registry lock. Acquire the same actual accounting
+ * lane before reading rows or retiring headers; a live transition keeps it
+ * unavailable. Closed Native storage remains after CPU free, so this path
+ * never reads the departed CPU or an expired construction Original. */
+static void cpu_tlb_reap_locked(void)
+{
+    QemuCrucibleCpuMetadataAccount *account = &startup_source.cpu_metadata_account;
+    QemuCrucibleCpuSourceAllocationRegistry *registry = &startup_source.cpu_allocations;
+    QemuCrucibleCpuTlbSourceOwner **link;
+    QemuCrucibleMetadataPartition *partition;
+
+    if (cpu_metadata_account_identity(account)) {
+        return;
+    }
+    partition = account->partition;
+    if (!crucible_metadata_partition_enter(partition)) {
+        return;
+    }
+    if (qatomic_load_acquire(&account->active_transition)) {
+        crucible_metadata_partition_leave(partition);
+        return;
+    }
+    if (registry->tlb_pending_charge.held) {
+        if (!registry->tlb_pending_physical_return ||
+            cpu_tlb_retire(partition, &registry->tlb_pending_charge)) {
+            crucible_metadata_partition_leave(partition);
+            return;
+        }
+        registry->tlb_pending_physical_return = false;
+    }
+    link = &registry->tlb_owners;
+    while (*link) {
+        QemuCrucibleCpuTlbSourceOwner *owner = *link;
+        QemuCrucibleCpuTlbSourceOwner **parent_link;
+        int status = cpu_tlb_storage_identity(owner);
+
+        if (!status) {
+            status = qemu_crucible_cpu_tlb_storage_returned_current_v1(
+                owner->control, owner);
+        }
+        if (status) {
+            link = &owner->next;
+            continue;
+        }
+        for (size_t row = 0; row < owner->row_count && !status; row++) {
+            QemuCrucibleCpuTlbSourceRow *cell = &cpu_tlb_rows(owner)[row];
+
+            if (!cell->request) {
+                status = cell->charge.held ? -EBUSY : 0;
+                continue;
+            }
+            status = qemu_crucible_cpu_tlb_allocation_returned_current_v1(
+                owner->control, owner, cell->request, cell->serial);
+            if (!status) {
+                status = cpu_tlb_retire(partition, &cell->charge);
+            }
+            if (!status) {
+                status = qemu_crucible_cpu_tlb_allocation_identity_return_v1(
+                    owner->control, owner, &cell->request, cell->serial);
+            }
+        }
+        if (!status) {
+            status = qemu_crucible_cpu_tlb_storage_identity_return_v1(
+                &owner->control, owner);
+        }
+        if (status || owner->control) {
+            link = &owner->next;
+            continue;
+        }
+        /* The actual parent child link outlives an RR spare payload free.
+         * Only fully disposed row/control custody can detach this child. */
+        for (parent_link = &owner->parent->tlb_children; *parent_link != owner;
+             parent_link = &(*parent_link)->parent_next) {
+            if (!*parent_link) {
+                /* The canonical parent association is now uncertain. Keep the
+                 * Source header and its debit rather than guess a refund. */
+                status = -ESTALE;
+                break;
+            }
+        }
+        if (status) {
+            link = &owner->next;
+            continue;
+        }
+        *parent_link = owner->parent_next;
+        *link = owner->next;
+        registry->tlb_pending_charge = owner->charge;
+        g_free(owner);
+        registry->tlb_pending_physical_return = true;
+        status = cpu_tlb_retire(partition, &registry->tlb_pending_charge);
+        if (status) {
+            break;
+        }
+        registry->tlb_pending_physical_return = false;
+    }
+    crucible_metadata_partition_leave(partition);
+}
+
+static uint64_t cpu_tlb_metadata_bytes_locked(void)
+{
+    QemuCrucibleCpuSourceAllocationRegistry *registry = &startup_source.cpu_allocations;
+    QemuCrucibleMetadataPartition *partition = &startup_source.metadata_partition;
+    QemuCrucibleCpuTlbSourceOwner *owner;
+    uint64_t bytes = 0;
+
+    if (!registry->tlb_owners && !registry->tlb_pending_charge.held) {
+        return 0;
+    }
+    if (!crucible_metadata_partition_enter(partition)) {
+        return UINT64_MAX;
+    }
+    if (registry->tlb_pending_charge.held) {
+        bytes = registry->tlb_pending_charge.bytes;
+    }
+    for (owner = registry->tlb_owners; owner && bytes != UINT64_MAX;
+         owner = owner->next) {
+        if (!owner->charge.held || owner->charge.bytes > UINT64_MAX - bytes) {
+            bytes = UINT64_MAX;
+            break;
+        }
+        bytes += owner->charge.bytes;
+        for (size_t row = 0; row < owner->row_count; row++) {
+            QemuCrucibleMetadataCharge *charge = &cpu_tlb_rows(owner)[row].charge;
+
+            if (charge->held) {
+                if (charge->bytes > UINT64_MAX - bytes) {
+                    bytes = UINT64_MAX;
+                    break;
+                }
+                bytes += charge->bytes;
+            }
+        }
+    }
+    crucible_metadata_partition_leave(partition);
+    return bytes;
+}
