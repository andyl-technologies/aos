+    parked_worker_init(1);
+    start_registry_worker_thread(&monitor_worker, "IO mon_iothread",
+                                 parked_monitor_registry_worker);
+    g_assert_cmpint(begin_runtime_transaction_when_quiescent(&transaction),
+                    ==, 0);
+    g_assert_true(transaction.registry.active);
+    g_assert_cmpuint(transaction.registry.carried_count, ==, 2);
+
+    child = fork();
+    g_assert_cmpint(child, >=, 0);
+    if (child == 0) {
+        int child_status = qemu_thread_hot_fork_reconstruct_child_registry(
+            &transaction.registry);
+
+        if (child_status == 0) {
+            /* The parked thread vanished; both mutexes are free again. */
+            qemu_rec_mutex_lock(&parked_worker_recursive_mutex);
+            qemu_rec_mutex_unlock(&parked_worker_recursive_mutex);
+            qemu_mutex_lock(&parked_worker_wait_mutex);
+            qemu_mutex_unlock(&parked_worker_wait_mutex);
+        }
+        write_child_result(child_result[1], child_status);
+        _exit(0);
+    }
+
+    g_assert_cmpint(qemu_crucible_hot_fork_release_parent_runtime_transaction(
+                        &transaction),
+                    ==, 0);
+    close(child_result[1]);
+    g_assert_cmpint(read_child_result(child_result[0]), ==, 0);
+    wait_for_child(child);
+    close(child_result[0]);
+    parked_worker_release();
+    stop_registry_worker_thread(&monitor_worker);
+    parked_worker_destroy();
+}
