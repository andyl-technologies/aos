+static int standing_budget_current(struct QemuCrucibleFingerprintOperation *operation)
+{
+    QemuCrucibleStandingSourcePurpose *purpose = &startup_source.standing;
+    const QemuCrucibleStandingBudget *admitted;
+    const QemuCrucibleStandingBudget *current;
+    struct pollfd event;
+    uint64_t now;
+    int status;
+
+    status = standing_clock(&now);
+    if (status || now < operation->last_now_ns) {
+        return status ? status : -ESTALE;
+    }
+    operation->last_now_ns = now;
+    if (operation->action_original) {
+        struct pollfd cancellation = {
+            .fd = purpose->cancellation_fd, .events = POLLIN,
+        };
+
+        if (operation->action_original != &startup_source.action_original ||
+            operation->action_serial != startup_source.action_original.serial) {
+            return -ESTALE;
+        }
+        status = qemu_crucible_source_action_original_current_v1(
+            operation->action_original, operation->plugin_id);
+        if (!status) {
+            int polled = poll(&cancellation, 1, 0);
+
+            status = polled < 0 ? -errno :
+                polled || cancellation.revents ? -ECANCELED : 0;
+        }
+        if (!status) {
+            status = standing_limits_current(&operation->admitted, now);
+        }
+        return status;
+    }
+    status = standing_refresh(false);
+    if (status) {
+        return status;
+    }
+    if (now >= operation->next_poll_ns) {
+        event = (struct pollfd) { .fd = purpose->cancellation_fd, .events = POLLIN };
+        status = poll(&event, 1, 0);
+        if (status < 0) {
+            return -errno;
+        }
+        if (status || event.revents) {
+            return -ECANCELED;
+        }
+        uint64_t poll_ns = MIN(operation->admitted.budgets[operation->class_index].poll_ns,
+                               purpose->current.budgets[operation->class_index].poll_ns);
+
+        operation->next_poll_ns = poll_ns > UINT64_MAX - now ? UINT64_MAX : now + poll_ns;
+    }
+    status = standing_limits_current(&operation->admitted, now);
+    if (!status) {
+        status = standing_limits_current(&purpose->current, now);
+    }
+    if (status) {
+        return status;
+    }
+    admitted = &operation->admitted.budgets[operation->class_index];
+    current = &purpose->current.budgets[operation->class_index];
+    if ((admitted->total_present && now - operation->start_ns >= admitted->total_ns) ||
+        (current->total_present && now - operation->start_ns >= current->total_ns) ||
+        (admitted->progress_present && now - operation->progress_ns >= admitted->progress_ns) ||
+        (current->progress_present && now - operation->progress_ns >= current->progress_ns)) {
+        return -ETIMEDOUT;
+    }
+    return 0;
+}
