+/* Project a phased reference to ns without making the counter advance early. */
+static inline bool npcm_clk_project_ref_to_ns(int64_t *ref_ns,
+                                               uint16_t *phase_ps)
+{
+    if (*phase_ps >= PICOSECONDS_PER_NANOSECOND) {
+        return false;
+    }
+    if (*phase_ps) {
+        if (*ref_ns == INT64_MAX) {
+            return false;
+        }
+        (*ref_ns)++;
+        *phase_ps = 0;
+    }
+    return true;
+}
