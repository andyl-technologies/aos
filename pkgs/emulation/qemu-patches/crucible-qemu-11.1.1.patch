new file mode 100644
index 0000000000000000000000000000000000000000..70641e8f1e219761f4c0198a4b3159cb5cea46cf
--- /dev/null
+++ b/tests/unit/test-crucible-placement-registration.py
@@ -0,0 +1,872 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Checks placement and write registration in the native post-grant window.
+
+The fixture extracts both production registrars, their shared window helper,
+the grant function, and the before-resume boundary. BQL, sealed-region construction, and run-state endpoints are explicit
+component inputs; grant application is the production function and thread IDs
+come from real kernel threads. The literal startup TOTAL helper reads modeled
+pin/total storage only; this fixture neither acquires Source custody nor
+issues an original budget. This does not qualify a translated guest.
+"""
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import shlex
+import subprocess
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+def definition(source, signature):
+    start = source.index(signature)
+    opening = source.index("{", start)
+    depth = 0
+    for index in range(opening, len(source)):
+        depth += (source[index] == "{") - (source[index] == "}")
+        if depth == 0:
+            return source[start:index + 1]
+    raise AssertionError(signature)
+
+
+def declaration(header, signature):
+    start = header.index(signature)
+    return header[start:header.index(";", start) + 1]
+
+
+PRELUDE = r"""
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE
+#endif
+#include "qemu/osdep.h"
+#include <assert.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <glib.h>
+#include <pthread.h>
+#include <poll.h>
+#include <sched.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+#include "qemu/compiler.h"
+#include "qemu/atomic.h"
+#include "qemu/crucible-metadata-partition.h"
+
+static _Thread_local bool fixture_bql_owned;
+static bool fixture_paused;
+static bool fixture_vmstop_quiesced;
+static bool fixture_paging_requested;
+static unsigned boundary_entries;
+static unsigned boundary_leaves;
+static unsigned placement_calls;
+static int diagnostic_failure;
+
+/* Only the storage read by literal TOTAL/retained-D observations is modeled.
+ * These pins are fixture inputs, not an acquired Source or purpose issuer. */
+static struct {
+    bool total_pinned;
+    bool custody_retained;
+    pid_t owner_process;
+    int first_negative_status;
+    QemuCrucibleMetadataPartition metadata_partition;
+    /* The full allowance helper declares these owners; none is issued here. */
+    struct QemuCruciblePreexecPurposeOwner *preexec_purpose_owner;
+    struct QemuCrucibleProcessContractOwner *process_contract_owner;
+    struct QemuCrucibleIncarnationPurposeOwner *incarnation_purpose_owner;
+    QemuCrucibleProcessPurposeRecord process_purpose_record;
+    bool process_purpose_complete;
+    struct {
+        uint64_t original_total_bytes;
+    } original;
+} fixture_startup_total;
+
+/* This fixture cannot acquire a Source. Its typed current-owner seam models
+ * only the source wrapper's pre/post gate; full real original checks execute
+ * in the permanent startup Source controls, not this declaration fixture. */
+static int fixture_partition_current(void)
+{
+    if (!fixture_startup_total.custody_retained ||
+        !fixture_startup_total.metadata_partition.controller_retained) {
+        return 0;
+    }
+    if (!fixture_bql_owned || fixture_startup_total.owner_process != getpid()) {
+        return -EPERM;
+    }
+    if (fixture_startup_total.first_negative_status) {
+        return fixture_startup_total.first_negative_status;
+    }
+    return crucible_metadata_partition_admission_status(
+        &fixture_startup_total.metadata_partition);
+}
+
+static int fixture_partition_failure(int status)
+{
+    if (!fixture_startup_total.first_negative_status) {
+        fixture_startup_total.first_negative_status = status;
+    }
+    return fixture_startup_total.first_negative_status;
+}
+
+static bool bql_locked(void) { return fixture_bql_owned; }
+int qemu_get_thread_id(void) { return syscall(SYS_gettid); }
+#define RUN_STATE_PAUSED 1
+static bool runstate_check(int state)
+{
+    assert(state == RUN_STATE_PAUSED);
+    return fixture_paused;
+}
+static bool qemu_crucible_ram_paging_requested(void)
+{
+    return fixture_paging_requested;
+}
+static bool qemu_plugin_crucible_vmstop_quiesced(void)
+{
+    return fixture_vmstop_quiesced;
+}
+/* The original pause generation is a scalar fixture input, not a VM proof. */
+static uint64_t qemu_plugin_crucible_vmstop_generation(void)
+{
+    return 7;
+}
+
+static void qemu_plugin_crucible_exact_boundary_enter(void)
+{
+    boundary_entries++;
+}
+static void qemu_plugin_crucible_exact_boundary_leave(void)
+{
+    boundary_leaves++;
+}
+
+/* Only the len observation is modeled; no private inventory lifetime is
+ * constructed or qualified by these registration controls. */
+typedef struct FixtureSealedRegions {
+    unsigned len;
+} FixtureSealedRegions;
+static FixtureSealedRegions sealed_regions = { .len = 1 };
+static FixtureSealedRegions *admission_regions;
+static struct qemu_plugin_crucible_ram_admission_v1 admission;
+static uint64_t topology_generation;
+static uint64_t metadata_budget;
+static uint64_t rust_metadata_budget;
+static bool admission_grant_open;
+static bool admission_grant_applied;
+static uint64_t admission_grant_owner;
+static int (*placement_boundary)(void);
+static qemu_plugin_crucible_ram_write_begin_v1 write_prepare;
+static qemu_plugin_crucible_ram_write_check_v1 write_check;
+static qemu_plugin_crucible_ram_write_finish_v1 write_finish;
+static qemu_plugin_crucible_ram_write_progress_v1 write_progress;
+static qemu_plugin_crucible_ram_write_scratch_v1 write_scratch_reserve;
+static qemu_plugin_crucible_ram_write_finish_v1 write_scratch_release;
+"""
+
+TESTS = r"""
+static int placement_callback(void)
+{
+    assert(bql_locked() && fixture_paused && fixture_vmstop_quiesced);
+    assert(boundary_entries == boundary_leaves + 1);
+    placement_calls++;
+    return -EIO;
+}
+
+static int replacement_callback(void)
+{
+    assert(false);
+    return 0;
+}
+
+static void sealed_startup_window(void)
+{
+    /* Sealing publishes this header before invoking the admission observer.
+     * These are component inputs, not a caller-authored physical certificate. */
+    sealed_regions.len = 1;
+    admission_regions = &sealed_regions;
+    admission = (struct qemu_plugin_crucible_ram_admission_v1) {
+        .schema = 1,
+        .region_count = 1,
+        .topology_generation = 7,
+        .logical_bytes = 4096,
+        .native_metadata_bytes = 4096,
+        .native_scratch_bytes = 16384,
+    };
+    topology_generation = 7;
+    fixture_bql_owned = true;
+    fixture_paused = false;
+    fixture_vmstop_quiesced = false;
+    fixture_paging_requested = true;
+    admission_grant_owner = qemu_get_thread_id();
+    admission_grant_open = true;
+    admission_grant_applied = false;
+    placement_boundary = NULL;
+    write_prepare = NULL;
+    write_check = NULL;
+    write_finish = NULL;
+    write_progress = NULL;
+    write_scratch_reserve = NULL;
+    write_scratch_release = NULL;
+    qatomic_store_release(&fixture_startup_total.total_pinned, false);
+    fixture_startup_total.original.original_total_bytes = 0;
+    fixture_startup_total.custody_retained = false;
+    fixture_startup_total.owner_process = getpid();
+    fixture_startup_total.first_negative_status = 0;
+    fixture_startup_total.metadata_partition =
+        (QemuCrucibleMetadataPartition) { 0 };
+    metadata_budget = 0;
+    rust_metadata_budget = 0;
+    boundary_entries = boundary_leaves = placement_calls = 0;
+    diagnostic_failure = 0;
+}
+
+static void apply_original_grant(void)
+{
+    uint64_t allowance = 0;
+
+    assert(qemu_plugin_crucible_ram_admission_grant_v1(
+        admission.topology_generation, 8192, &allowance) == 0);
+    assert(admission_grant_applied && allowance == 4096);
+    assert(metadata_budget == 8192 && rust_metadata_budget == allowance);
+}
+
+static void refused_unpublished(void)
+{
+    assert(qemu_plugin_crucible_register_ram_placement_v1(
+        placement_callback) == -EBUSY);
+    assert(qatomic_load_acquire(&placement_boundary) == NULL);
+    assert(!placement_calls && !boundary_entries && !boundary_leaves);
+}
+
+static void assert_grant_refused(uint64_t generation, uint64_t total,
+                                 uint64_t *allowance)
+{
+    uint64_t saved_allowance = allowance ? *allowance : 0;
+    uint64_t saved_budget = metadata_budget;
+    uint64_t saved_rust_budget = rust_metadata_budget;
+    bool saved_applied = admission_grant_applied;
+
+    assert(qemu_plugin_crucible_ram_admission_grant_v1(
+        generation, total, allowance) == -EPERM);
+    assert(!allowance || *allowance == saved_allowance);
+    assert(metadata_budget == saved_budget);
+    assert(rust_metadata_budget == saved_rust_budget);
+    assert(admission_grant_applied == saved_applied);
+    assert(!placement_boundary && !write_prepare && !write_check);
+    assert(!write_finish && !write_progress);
+    assert(!write_scratch_reserve && !write_scratch_release);
+    assert(!placement_calls && !boundary_entries && !boundary_leaves);
+}
+
+static void *foreign_grant_owner(void *opaque)
+{
+    uint64_t *allowance = opaque;
+
+    fixture_bql_owned = true;
+    assert(qemu_get_thread_id() != admission_grant_owner);
+    assert_grant_refused(admission.topology_generation, 8192, allowance);
+    return NULL;
+}
+
+static void test_original_total_grant(void)
+{
+    pthread_t worker;
+    uint64_t allowance = UINT64_C(0x6b9d0137);
+
+    sealed_startup_window();
+    fixture_startup_total.original.original_total_bytes = 8192;
+    qatomic_store_release(&fixture_startup_total.total_pinned, true);
+    assert(qemu_crucible_startup_source_total_matches(8192));
+    assert(!qemu_crucible_startup_source_total_matches(12288));
+    assert_grant_refused(admission.topology_generation, 12288, &allowance);
+
+    /* Earlier grant gates retain their priority and leave every output alone. */
+    assert_grant_refused(admission.topology_generation, 8192, NULL);
+    assert_grant_refused(admission.topology_generation + 1, 8192, &allowance);
+    assert(pthread_create(&worker, NULL, foreign_grant_owner, &allowance) == 0);
+    assert(pthread_join(worker, NULL) == 0);
+    assert(allowance == UINT64_C(0x6b9d0137));
+    assert(fixture_startup_total.original.original_total_bytes == 8192);
+    assert(qatomic_load_acquire(&fixture_startup_total.total_pinned));
+
+    apply_original_grant();
+    assert(fixture_startup_total.original.original_total_bytes == 8192);
+    assert(qatomic_load_acquire(&fixture_startup_total.total_pinned));
+
+    /* Without a pin the upstream ordinary grant retains its original domain. */
+    sealed_startup_window();
+    fixture_startup_total.original.original_total_bytes = 1;
+    assert(qemu_crucible_startup_source_total_matches(8192));
+    assert(qemu_crucible_startup_source_total_matches(12288));
+    apply_original_grant();
+}
+
+static unsigned write_callback_calls;
+
+static int begin_write(uint64_t generation, uint64_t scratch_token,
+                       const struct qemu_plugin_crucible_ram_write_coordinate_v1 *pages,
+                       size_t count, uint64_t *token)
+{
+    assert(generation && scratch_token && pages && count && token);
+    write_callback_calls++;
+    return -EIO;
+}
+
+static int check_write(uint64_t token, uint32_t ready)
+{
+    assert(token && ready);
+    write_callback_calls++;
+    return -EIO;
+}
+
+static int finish_write(uint64_t token)
+{
+    assert(token);
+    write_callback_calls++;
+    return -EIO;
+}
+
+static int progress_write(uint64_t token, uint64_t completed)
+{
+    assert(token && completed);
+    write_callback_calls++;
+    return -EIO;
+}
+
+static int reserve_scratch(uint64_t bytes, uint64_t *token)
+{
+    assert(bytes && token);
+    write_callback_calls++;
+    return -EIO;
+}
+
+static int register_write(void)
+{
+    return qemu_plugin_crucible_register_ram_write_preparation_v1(
+        begin_write, check_write, finish_write, progress_write,
+        reserve_scratch, finish_write);
+}
+
+static void assert_write_table_empty(void)
+{
+    assert(!qatomic_load_acquire(&write_prepare));
+    assert(!write_check && !write_finish && !write_progress);
+    assert(!write_scratch_reserve && !write_scratch_release);
+    assert(!write_callback_calls);
+}
+
+static void refuse_write_unpublished(void)
+{
+    assert(register_write() == -EINVAL);
+    assert_write_table_empty();
+}
+
+static void *foreign_owner(void *opaque)
+{
+    uint64_t *actual_tid = opaque;
+
+    *actual_tid = qemu_get_thread_id();
+    assert(*actual_tid != admission_grant_owner);
+    /* Even a modeled BQL endpoint cannot replace the real granting TID. */
+    fixture_bql_owned = true;
+    refused_unpublished();
+    refuse_write_unpublished();
+    return NULL;
+}
+
+static void test_exact_post_grant_window(void)
+{
+    sealed_startup_window();
+    refused_unpublished();
+    apply_original_grant();
+
+    /* The old unconditional admission_regions refusal fails at this point.
+     * Registration precedes machine-ready/VMStop, without invoking placement. */
+    assert(admission_regions && !fixture_paused && !fixture_vmstop_quiesced);
+    assert(qemu_plugin_crucible_register_ram_placement_v1(
+        placement_callback) == 0);
+    assert(qatomic_load_acquire(&placement_boundary) == placement_callback);
+    assert(!placement_calls && !boundary_entries && !boundary_leaves);
+
+    assert(qemu_plugin_crucible_register_ram_placement_v1(
+        replacement_callback) == -EBUSY);
+    assert(qemu_plugin_crucible_register_ram_placement_v1(NULL) == -EBUSY);
+    assert(qatomic_load_acquire(&placement_boundary) == placement_callback);
+}
+
+static void test_failed_windows(void)
+{
+    pthread_t worker;
+    uint64_t foreign_tid = 0;
+    uint64_t allowance = 0;
+
+    sealed_startup_window();
+    apply_original_grant();
+    assert(qemu_plugin_crucible_register_ram_placement_v1(NULL) == -EBUSY);
+    assert(!placement_boundary);
+
+    admission_regions = NULL;
+    refused_unpublished();
+    admission_regions = &sealed_regions;
+    sealed_regions.len = 0;
+    refused_unpublished();
+    sealed_regions.len = 1;
+    admission.region_count = 2;
+    refused_unpublished();
+    admission.region_count = 1;
+
+    fixture_bql_owned = false;
+    refused_unpublished();
+    fixture_bql_owned = true;
+    assert(pthread_create(&worker, NULL, foreign_owner, &foreign_tid) == 0);
+    assert(pthread_join(worker, NULL) == 0);
+    assert(foreign_tid && !placement_boundary);
+
+    admission_grant_owner = 0;
+    refused_unpublished();
+    admission_grant_owner = qemu_get_thread_id();
+    admission_grant_open = false;
+    refused_unpublished();
+    admission_grant_open = true;
+    admission_grant_applied = false;
+    refused_unpublished();
+    admission_grant_applied = true;
+
+    admission.topology_generation = topology_generation = 0;
+    refused_unpublished();
+    admission.topology_generation = 7;
+    topology_generation = 8;
+    refused_unpublished();
+
+    /* A failed grant never publishes a callback; closing its window cannot
+     * turn the retained sealed header into later registration authority. */
+    sealed_startup_window();
+    assert(qemu_plugin_crucible_ram_admission_grant_v1(
+        admission.topology_generation, admission.native_metadata_bytes,
+        &allowance) == -ENOSPC);
+    assert(!admission_grant_applied && !allowance);
+    refused_unpublished();
+    admission_grant_open = false;
+    admission_grant_owner = 0;
+    refused_unpublished();
+
+    /* Nor can a successfully granted but closed window register late. */
+    sealed_startup_window();
+    apply_original_grant();
+    admission_grant_open = false;
+    admission_grant_owner = 0;
+    refused_unpublished();
+}
+
+static void *observe_published_write_table(void *opaque)
+{
+    (void)opaque;
+    while (!qatomic_load_acquire(&write_prepare)) {
+        sched_yield();
+    }
+    /* Acquiring the begin publication must expose every preceding slot. */
+    assert(write_prepare == begin_write);
+    assert(write_check == check_write && write_finish == finish_write);
+    assert(write_progress == progress_write && write_scratch_reserve == reserve_scratch);
+    assert(write_scratch_release == finish_write);
+    return NULL;
+}
+
+static void test_write_registration(void)
+{
+    pthread_t reader;
+
+    sealed_startup_window();
+    refuse_write_unpublished();
+    apply_original_grant();
+
+    /* Startup installs placement and then the write table on this same grant.
+     * The signed16f registrar fails here solely because inventory is sealed. */
+    assert(qemu_plugin_crucible_register_ram_placement_v1(
+        placement_callback) == 0);
+    assert(pthread_create(&reader, NULL, observe_published_write_table, NULL) == 0);
+    assert(register_write() == 0);
+    assert(pthread_join(reader, NULL) == 0);
+    assert(qatomic_load_acquire(&write_prepare) == begin_write);
+    assert(write_check == check_write && write_finish == finish_write);
+    assert(write_progress == progress_write && write_scratch_reserve == reserve_scratch);
+    assert(write_scratch_release == finish_write && !write_callback_calls);
+    assert(register_write() == -EINVAL);
+    assert(qatomic_load_acquire(&write_prepare) == begin_write);
+    assert(write_check == check_write && write_finish == finish_write);
+    assert(write_progress == progress_write && write_scratch_reserve == reserve_scratch);
+    assert(write_scratch_release == finish_write && !write_callback_calls);
+}
+
+static void test_write_null_and_partial_table(void)
+{
+    sealed_startup_window();
+    apply_original_grant();
+
+    for (unsigned missing = 0; missing < 6; missing++) {
+        assert(qemu_plugin_crucible_register_ram_write_preparation_v1(
+            missing == 0 ? NULL : begin_write,
+            missing == 1 ? NULL : check_write,
+            missing == 2 ? NULL : finish_write,
+            missing == 3 ? NULL : progress_write,
+            missing == 4 ? NULL : reserve_scratch,
+            missing == 5 ? NULL : finish_write) == -EINVAL);
+        assert_write_table_empty();
+    }
+
+    /* Each existing slot independently refuses replacement. These modeled
+     * interrupted tables remain unchanged; no partial owner is repaired here. */
+    for (unsigned existing = 0; existing < 6; existing++) {
+        sealed_startup_window();
+        apply_original_grant();
+        switch (existing) {
+        case 0: write_prepare = begin_write; break;
+        case 1: write_check = check_write; break;
+        case 2: write_finish = finish_write; break;
+        case 3: write_progress = progress_write; break;
+        case 4: write_scratch_reserve = reserve_scratch; break;
+        case 5: write_scratch_release = finish_write; break;
+        default: assert(false);
+        }
+        assert(register_write() == -EINVAL);
+        assert(write_prepare == (existing == 0 ? begin_write : NULL));
+        assert(write_check == (existing == 1 ? check_write : NULL));
+        assert(write_finish == (existing == 2 ? finish_write : NULL));
+        assert(write_progress == (existing == 3 ? progress_write : NULL));
+        assert(write_scratch_reserve == (existing == 4 ? reserve_scratch : NULL));
+        assert(write_scratch_release == (existing == 5 ? finish_write : NULL));
+        assert(!write_callback_calls);
+    }
+}
+
+static void test_write_failed_windows(void)
+{
+    pthread_t worker;
+    uint64_t foreign_tid = 0;
+    uint64_t allowance = 0;
+
+    sealed_startup_window();
+    apply_original_grant();
+    admission_regions = NULL;
+    refuse_write_unpublished();
+    admission_regions = &sealed_regions;
+    sealed_regions.len = 0;
+    refuse_write_unpublished();
+    sealed_regions.len = 1;
+    admission.region_count = 2;
+    refuse_write_unpublished();
+    admission.region_count = 1;
+    fixture_bql_owned = false;
+    refuse_write_unpublished();
+    fixture_bql_owned = true;
+    assert(pthread_create(&worker, NULL, foreign_owner, &foreign_tid) == 0);
+    assert(pthread_join(worker, NULL) == 0);
+    assert(foreign_tid && !placement_boundary);
+    admission_grant_owner = 0;
+    refuse_write_unpublished();
+    admission_grant_owner = qemu_get_thread_id();
+    admission_grant_open = false;
+    refuse_write_unpublished();
+    admission_grant_open = true;
+    admission_grant_applied = false;
+    refuse_write_unpublished();
+    admission_grant_applied = true;
+    admission.topology_generation = topology_generation = 0;
+    refuse_write_unpublished();
+    admission.topology_generation = 7;
+    topology_generation = 8;
+    refuse_write_unpublished();
+
+    sealed_startup_window();
+    assert(qemu_plugin_crucible_ram_admission_grant_v1(
+        admission.topology_generation, admission.native_metadata_bytes,
+        &allowance) == -ENOSPC);
+    assert(!admission_grant_applied && !allowance);
+    refuse_write_unpublished();
+    admission_grant_open = false;
+    admission_grant_owner = 0;
+    refuse_write_unpublished();
+
+    sealed_startup_window();
+    apply_original_grant();
+    admission_grant_open = false;
+    admission_grant_owner = 0;
+    refuse_write_unpublished();
+}
+
+static void test_diagnostic_failure_precedes_resume_effects(void)
+{
+    sealed_startup_window();
+    apply_original_grant();
+    assert(qemu_plugin_crucible_register_ram_placement_v1(
+        placement_callback) == 0);
+
+    assert(qemu_crucible_ram_diagnostic_fail(-ESTALE) == -ESTALE);
+    assert(qemu_crucible_ram_diagnostic_fail(-EIO) == -ESTALE);
+    assert(qemu_crucible_ram_diagnostic_failure() == -ESTALE);
+
+    /* The retained first failure precedes paused fences and callback effects. */
+    fixture_bql_owned = false;
+    fixture_paused = false;
+    fixture_vmstop_quiesced = false;
+    assert(qemu_crucible_ram_placement_before_resume() == -ESTALE);
+    assert(!placement_calls && !boundary_entries && !boundary_leaves);
+
+    fixture_paging_requested = false;
+    assert(qemu_crucible_ram_placement_before_resume() == -ESTALE);
+    assert(!placement_calls && !boundary_entries && !boundary_leaves);
+}
+
+static void test_resume_fences_unchanged(void)
+{
+    sealed_startup_window();
+    apply_original_grant();
+    assert(qemu_plugin_crucible_register_ram_placement_v1(
+        placement_callback) == 0);
+    admission_grant_open = false;
+    admission_grant_owner = 0;
+
+    assert(qemu_crucible_ram_placement_before_resume() == -EPERM);
+    fixture_paused = true;
+    assert(qemu_crucible_ram_placement_before_resume() == -EPERM);
+    fixture_vmstop_quiesced = true;
+    fixture_bql_owned = false;
+    assert(qemu_crucible_ram_placement_before_resume() == -EPERM);
+    assert(!placement_calls && !boundary_entries && !boundary_leaves);
+
+    fixture_bql_owned = true;
+    assert(qemu_crucible_ram_placement_before_resume() == -EIO);
+    assert(placement_calls == 1 && boundary_entries == 1 && boundary_leaves == 1);
+    fixture_paging_requested = false;
+    assert(qemu_crucible_ram_placement_before_resume() == 0);
+    assert(placement_calls == 1 && boundary_entries == boundary_leaves);
+}
+
+static void test_selected_failure_cannot_use_ordinary_resume(void)
+{
+    sealed_startup_window();
+    qatomic_set(&research_resident.state, RESEARCH_RESIDENT_FAILED);
+    fixture_paging_requested = false;
+    fixture_bql_owned = false;
+
+    assert(qemu_crucible_ram_placement_before_resume() == -EPERM);
+    assert(qatomic_read(&research_resident.state) == RESEARCH_RESIDENT_FAILED);
+    assert(!placement_calls && !boundary_entries && !boundary_leaves);
+
+    fixture_bql_owned = true;
+    fixture_paused = true;
+    fixture_vmstop_quiesced = true;
+    assert(qemu_crucible_ram_placement_before_resume() == -EPERM);
+    assert(qatomic_read(&research_resident.state) == RESEARCH_RESIDENT_FAILED);
+    assert(!placement_calls && !boundary_entries && !boundary_leaves);
+}
+
+/* Retained D is an explicit accounting input, never a fixture admission grant.
+ * The real grant body must subtract it once and retain refusal output/state. */
+static void test_retained_controller_partition(void)
+{
+    uint64_t allowance = UINT64_MAX;
+
+    sealed_startup_window();
+    fixture_startup_total.custody_retained = true;
+    /* Modeled immutable purpose; this is not an acquired native issuer.
+     * The actual ledger and reserve wrapper validate its conserved fields. */
+    fixture_startup_total.metadata_partition = (QemuCrucibleMetadataPartition) {
+        .total = 8192, .native_extent = 8192 - 512,
+        .fixed_native_extent = 4096, .controller_extent = 512,
+        .controller_retained = true, .published = true,
+    };
+    assert(qemu_plugin_crucible_ram_admission_grant_v1(
+        topology_generation, 8192, &allowance) == 0);
+    assert(allowance == 8192 - 4096 - 512);
+    assert(fixture_startup_total.metadata_partition.inventory_allowance_retained);
+    assert(fixture_startup_total.metadata_partition.inventory_allowance == allowance);
+    assert(fixture_startup_total.metadata_partition.controller_extent == 512);
+    allowance = UINT64_MAX;
+    assert(qemu_plugin_crucible_ram_admission_grant_v1(
+        topology_generation, 8192, &allowance) == -EPERM);
+    assert(allowance == UINT64_MAX);
+
+    sealed_startup_window();
+    fixture_startup_total.custody_retained = true;
+    fixture_startup_total.metadata_partition.controller_retained = true;
+    fixture_startup_total.metadata_partition.controller_extent = 4096;
+    allowance = UINT64_MAX;
+    assert(qemu_plugin_crucible_ram_admission_grant_v1(
+        topology_generation, 8192, &allowance) == -ENOSPC);
+    assert(allowance == UINT64_MAX);
+    assert(!admission_grant_applied && !metadata_budget && !rust_metadata_budget);
+    assert(fixture_startup_total.metadata_partition.controller_extent == 4096);
+    assert(!placement_calls && !boundary_entries && !boundary_leaves);
+
+    sealed_startup_window();
+    fixture_startup_total.custody_retained = true;
+    fixture_startup_total.metadata_partition.controller_retained = true;
+    fixture_startup_total.metadata_partition.controller_extent = 512;
+    fixture_startup_total.metadata_partition.post_status = -EOVERFLOW;
+    allowance = UINT64_MAX;
+    assert(qemu_plugin_crucible_ram_admission_grant_v1(
+        topology_generation, 8192, &allowance) == -EOVERFLOW);
+    assert(allowance == UINT64_MAX);
+    assert(!admission_grant_applied && !metadata_budget && !rust_metadata_budget);
+    assert(fixture_startup_total.metadata_partition.controller_extent == 512);
+    assert(fixture_startup_total.metadata_partition.post_status == -EOVERFLOW);
+}
+
+int main(void)
+{
+    test_original_total_grant();
+    test_retained_controller_partition();
+    test_exact_post_grant_window();
+    test_failed_windows();
+    test_write_registration();
+    test_write_null_and_partial_table();
+    test_write_failed_windows();
+    test_diagnostic_failure_precedes_resume_effects();
+    test_resume_fences_unchanged();
+    test_selected_failure_cannot_use_ordinary_resume();
+    puts("placement registration: exact post-grant window, actual TID, refusal nonpublication and unchanged resume fences PASS");
+    puts("write registration: original grant window, six null/partial slots, actual TID, unpublished refusals and release-published complete table PASS");
+    puts("resume diagnostic: retained first failure precedes fences, disabled paging and callback effects PASS");
+    return 0;
+}
