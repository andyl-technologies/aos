+/*
+ * Physical RAM borrower owner closure
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef SYSTEM_CRUCIBLE_RAM_QUIESCENCE_H
+#define SYSTEM_CRUCIBLE_RAM_QUIESCENCE_H
+
+/* Fixed native collector storage, charged once per admitted process owner. */
+uint64_t qemu_crucible_ram_owner_metadata_bytes(void);
+uint64_t qemu_crucible_ram_main_loop_metadata_bytes(void);
+
+/* Immediate same-process return contract: only the pre-census actor record
+ * gate may return this positive pending marker. Every negative raw errno,
+ * including later EAGAIN or failed cleanup, remains terminal and unchanged. */
+#define QEMU_CRUCIBLE_RAM_OWNER_INVENTORY_PENDING_RECORD 1
+
+/* Actual current memberships only; future actors/descriptors require explicit
+ * prospective entitlements from their owning subsystems before admission.
+ */
+int qemu_crucible_ram_owner_inventory(uint64_t *tasks, uint64_t *descriptors,
+                                     uint64_t *service_tasks);
+
+/* Role 1 is the isolated pager actor; role 2 is the host policy controller. */
+int qemu_crucible_ram_service_worker(uint32_t role, uint64_t generation,
+                                     uint64_t thread_id, uint32_t enter);
+/* Qualified actor self-entry/exit, independent from fault-service role1. */
+int qemu_crucible_ram_service_actor(void *actor, bool enter);
+/* Read-only observation of the actual constructor-owned role2 entry. One means
+ * short membership-lock contention only, never readiness or a pause proof. */
+int qemu_crucible_ram_service_actor_enrollment_current(
+    void *actor, uint64_t generation, uint64_t thread_id);
+
+/* Runs the entire physical operation on the native main-loop actor under BQL.
+ * The caller lends its opaque context synchronously, drops BQL while waiting,
+ * and retains exact cleanup identities on failure until actual return or reap.
+ * No native/engine/root mutex may be held across this actor handoff.
+ */
+int qemu_crucible_ram_run_on_main_loop(int (*callback)(void *), void *opaque);
+
+/* Schedules one retained native context without registered QEMU locks. The
+ * callback runs once on a genuinely paused/quiesced main loop under BQL. The
+ * caller retains context custody until callback completion or successful
+ * cancellation. Active guests are never kicked to create a new boundary.
+ * A busy cancellation retains custody and must be retried or contained.
+ */
+int qemu_crucible_ram_schedule_on_main_loop(int (*callback)(void *), void *opaque);
+int qemu_crucible_ram_cancel_scheduled_main_loop(void);
+
+/* Native-private mailbox custody, not checkpoint admission or pager readiness.
+ * Only the actual retained checkpoint transaction may bind this owner. No
+ * original/purpose constructor is provided. A genuine receiver must retain
+ * its original transaction and cancellation alias before making
+ * the sole private owner available to these operations. They require the
+ * actual main-loop thread, BQL and a nonyielding call scope.
+ */
+typedef struct QemuCrucibleCheckpointPlacementOwner
+    QemuCrucibleCheckpointPlacementOwner;
+
+typedef struct QemuCrucibleCheckpointHeldTransaction
+    QemuCrucibleCheckpointHeldTransaction;
+
+int qemu_crucible_checkpoint_main_loop_current(void);
+int qemu_crucible_checkpoint_placement_bind_v1(
+    QemuCrucibleCheckpointHeldTransaction *transaction,
+    uint64_t stopped_generation, int cancellation_fd,
+    QemuCrucibleCheckpointPlacementOwner **out);
+
+int qemu_crucible_checkpoint_placement_detach_v1(
+    QemuCrucibleCheckpointPlacementOwner *owner);
+/* Exact process-private accepted tuple, checked at the same one-CAS cut.
+ * Empty requires NULL/NULL; accepted queue generation is not policy generation.
+ */
+int qemu_crucible_checkpoint_placement_detach_expected_v2(
+    QemuCrucibleCheckpointPlacementOwner *owner,
+    int (*expected_callback)(void *), void *expected_opaque);
+/* Observe only the genuine held tuple; outputs unchanged on refusal. */
+int qemu_crucible_checkpoint_placement_observe_v1(
+    QemuCrucibleCheckpointPlacementOwner *owner,
+    uint64_t *accepted_generation, uint32_t *held_kind);
+int qemu_crucible_checkpoint_placement_restore_v1(
+    QemuCrucibleCheckpointPlacementOwner *owner);
+
+/* Validates the exact restored mailbox and retained tuple without granting
+ * new work. The transaction's final cleanup cut retains the root identity. */
+int qemu_crucible_checkpoint_placement_restored_current_v1(
+    QemuCrucibleCheckpointPlacementOwner *owner,
+    QemuCrucibleCheckpointHeldTransaction *transaction,
+    uint64_t accepted_generation, uint32_t held_kind,
+    int (*expected_callback)(void *), void *expected_opaque);
+
+/* Borrows only a real already-issued native background closure. This does not
+ * acquire participants, synthesize a paused token, or collect descriptors. */
+int qemu_crucible_ram_observation_background_borrow_v1(uint64_t *token);
+int qemu_crucible_ram_observation_background_current_v1(uint64_t token);
+int qemu_crucible_ram_observation_background_return_v1(uint64_t *token);
+
+/* A nonzero token retains exact cleanup identity after partial/uncertain
+ * release. Only current/validate can prove exclusion, and neither accepts an
+ * incarnation after end admission. A token alone never proves held writers. */
+int qemu_crucible_ram_owner_closure_begin(uint64_t *token);
+/* Only a genuinely entered resident Root can lend this Source absence owner.
+ * Both acquisition and cleanup errors survive a failed physical constructor.
+ * A nonzero token must be returned even when acquisition fails. */
+struct QemuCrucibleResidentServiceAbsence;
+int qemu_crucible_ram_owner_resident_begin_v1(
+    struct QemuCrucibleResidentServiceAbsence *absence, uint64_t *token,
+    int *first_status, int *cleanup_status);
+/* Identity-only observation; no census, Original, or fresh acquisition. */
+int qemu_crucible_ram_owner_resident_returned_v1(
+    struct QemuCrucibleResidentServiceAbsence *absence);
+/* Checks only the retained process/thread/paused fence, without collecting
+ * memberships or acquiring holds. It is not a replacement for validate. */
+bool qemu_crucible_ram_owner_closure_current(uint64_t token);
+int qemu_crucible_ram_owner_closure_validate(uint64_t token);
+/* A diagnostic lends initialized root scratch synchronously. No name or
+ * scratch pointer escapes; a failed sole proc close remains separate evidence.
+ */
+int qemu_crucible_ram_owner_closure_validate_with_scratch(
+    uint64_t token, uint8_t *scratch, size_t capacity, int *proc_close_status);
+struct qemu_plugin_crucible_ram_physical_end_v2;
+int qemu_crucible_ram_owner_end_output_check_v1(
+    const struct qemu_plugin_crucible_ram_physical_end_v2 *out);
+int qemu_crucible_ram_owner_closure_end_v2(
+    uint64_t token, struct qemu_plugin_crucible_ram_physical_end_v2 *out);
+int qemu_crucible_ram_owner_closure_end_observe_v1(
+    uint64_t token, struct qemu_plugin_crucible_ram_physical_end_v2 *out);
+#endif
