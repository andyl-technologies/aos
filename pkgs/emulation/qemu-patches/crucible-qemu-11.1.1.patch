+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Observe the real ordinary anonymous RAM producer and physical reclaim.
+
+The caller supplies a matching, unstripped Linux x86-64 system executable and
+its actual physmem object. Real DWARF and ELF symbols describe the private
+storage; the parent observes only genuinely born children through /proc. No
+Source, Original, active mapping child, allocator-body disposal receipt or
+selected admission is created by these observations. QMP responses alone are
+never physical-return evidence. The QEMU process has one 30-second deadline.
+"""
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import selectors
+import subprocess
+import time
+
+parser = argparse.ArgumentParser()
+parser.add_argument('--qemu', type=Path, required=True)
+parser.add_argument('--physmem-object', type=Path, required=True)
+parser.add_argument('--output-dir', type=Path, required=True)
+parser.add_argument('--readelf', type=Path, required=True)
+parser.add_argument('--nm', type=Path, required=True)
+args = parser.parse_args()
+qemu = args.qemu.resolve()
+output = args.output_dir.resolve()
+output.mkdir(parents=True, exist_ok=False)
+elf = qemu.read_bytes()[:20]
+assert elf[:6] == b'\x7fELF\x02\x01' and elf[18:20] == b'\x3e\x00'
+read = subprocess.run(
+    [str(args.readelf.resolve()), '--debug-dump=info',
+     str(args.physmem_object.resolve())],
+    capture_output=True, text=True, check=True)
+(output / 'physmem-dwarf.log').write_text(read.stdout + read.stderr)
+nodes = {}
+stack = {}
+node = None
+for line in read.stdout.splitlines():
+    match = re.match(r' <(\d+)><([0-9a-f]+)>: Abbrev Number: \d+(?: \((DW_TAG_\w+)\))?', line)
+    if match:
+        depth, offset, tag = int(match[1]), int(match[2], 16), match[3]
+        node = None
+        if tag:
+            node = {'tag': tag, 'children': []}
+            nodes[offset] = node
+            if depth - 1 in stack:
+                stack[depth - 1]['children'].append(offset)
+            stack[depth] = node
+        continue
+    attr = re.match(r'\s*<[0-9a-f]+>\s+(DW_AT_\w+)\s*:\s*(.*)', line)
+    if node is not None and attr:
+        node[attr[1]] = attr[2]
+
+
+def name(node):
+    value = node.get('DW_AT_name', '')
+    return value.rsplit(': ', 1)[-1]
+
+
+def referenced(node):
+    return nodes[int(re.search(r'<0x([0-9a-f]+)>', node['DW_AT_type'])[1], 16)]
+
+
+def members(node):
+    return {name(nodes[child]): int(nodes[child]['DW_AT_data_member_location'])
+            for child in node['children'] if nodes[child]['tag'] == 'DW_TAG_member'}
+
+variable = next(node for node in nodes.values()
+                if node['tag'] == 'DW_TAG_variable' and
+                name(node) == 'ram_read_mapping_registry')
+registry_type = referenced(variable)
+registry_members = members(registry_type)
+array = referenced(next(nodes[index] for index in registry_type['children']
+                        if name(nodes[index]) == 'owners'))
+owner_type = referenced(array)
+owner_members = members(owner_type)
+stride = int(owner_type['DW_AT_byte_size'])
+count = int(next(nodes[index]['DW_AT_upper_bound']
+                 for index in array['children']
+                 if nodes[index]['tag'] == 'DW_TAG_subrange_type')) + 1
+journal_type = next(node for node in nodes.values()
+                    if node['tag'] == 'DW_TAG_structure_type' and
+                    name(node) == 'QemuRamMappingJournal')
+block_type = next(node for node in nodes.values()
+                  if node['tag'] == 'DW_TAG_structure_type' and
+                  name(node) == 'RAMBlock' and 'DW_AT_byte_size' in node)
+journal_members, block_members = members(journal_type), members(block_type)
+layout = {
+    'registry': registry_members, 'owner': owner_members,
+    'owner_bytes': stride, 'slots': count, 'journal': journal_members,
+    'journal_bytes': int(journal_type['DW_AT_byte_size']),
+    'block': block_members,
+}
+(output / 'actual-layout.json').write_text(json.dumps(layout, indent=2) + '\n')
+nm = subprocess.check_output([str(args.nm.resolve()), '-S', '--defined-only', str(qemu)], text=True)
+row = next(line for line in nm.splitlines() if line.split()[-1] == 'ram_read_mapping_registry')
+disposal_row = next(line for line in nm.splitlines()
+                    if line.split()[-1] == 'ram_read_disposal_in_flight')
+assert int(disposal_row.split()[1], 16) == 8
+disposal_symbol = int(disposal_row.split()[0], 16)
+symbol = int(row.split()[0], 16)
+assert int(row.split()[1], 16) == int(registry_type['DW_AT_byte_size'])
+command = [str(qemu), '-machine', 'none', '-accel', 'tcg', '-nodefaults',
+           '-display', 'none', '-S', '-qmp', 'stdio']
+start = time.monotonic()
+deadline = start + 30
+stderr = (output / 'qemu.stderr').open('wb')
+process = subprocess.Popen(command, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=stderr)
+selector = selectors.DefaultSelector()
+selector.register(process.stdout, selectors.EVENT_READ)
+wire_in = (output / 'qmp-input.bin').open('wb')
+wire_out = (output / 'qmp-output.bin').open('wb')
+pending = b''
+observations = []
+
+
+def response():
+    global pending
+    while True:
+        if b'\n' in pending:
+            line, pending = pending.split(b'\n', 1)
+            if line.strip():
+                return json.loads(line)
+        remaining = deadline - time.monotonic()
+        assert remaining > 0, 'unchanged 30-second process deadline'
+        assert selector.select(remaining), 'QMP response deadline'
+        chunk = os.read(process.stdout.fileno(), 65536)
+        assert chunk, f'QEMU exited before QMP response: {process.poll()}'
+        wire_out.write(chunk)
+        wire_out.flush()
+        pending += chunk
+
+
+def request(execute, arguments=None):
+    message = {'execute': execute, 'id': execute}
+    if arguments is not None:
+        message['arguments'] = arguments
+    payload = json.dumps(message, separators=(',', ':')).encode() + b'\r\n'
+    wire_in.write(payload)
+    wire_in.flush()
+    process.stdin.write(payload)
+    process.stdin.flush()
+    while True:
+        result = response()
+        if 'event' in result:
+            continue
+        assert result.get('id') == execute and 'return' in result, result
+        return result['return']
+
+
+def maps():
+    return Path(f'/proc/{process.pid}/maps').read_text()
+
+def map_ranges(text):
+    for line in text.splitlines():
+        low, high = line.split()[0].split('-')
+        yield int(low, 16), int(high, 16)
+
+
+def integer(data, offset, width=8):
+    return int.from_bytes(data[offset:offset + width], 'little')
+
+
+try:
+    greeting = response()
+    assert 'QMP' in greeting
+    request('qmp_capabilities')
+    initial_maps = maps()
+    (output / 'maps-initial.txt').write_text(initial_maps)
+    first = next(line for line in initial_maps.splitlines()
+                 if len(line.split()) >= 6 and
+                 Path(line.split()[-1]) == qemu and
+                 int(line.split()[2], 16) == 0)
+    base = int(first.split('-')[0], 16) if int.from_bytes(elf[16:18], 'little') == 3 else 0
+    address = base + symbol
+    with Path(f'/proc/{process.pid}/mem').open('rb', buffering=0) as memory:
+        def read_at(where, size):
+            value = os.pread(memory.fileno(), size, where)
+            assert len(value) == size
+            return value
+        def registry():
+            body = read_at(address, int(registry_type['DW_AT_byte_size']))
+            offset = registry_members['owners']
+            return [(index, body[offset + index * stride:
+                                 offset + (index + 1) * stride])
+                    for index in range(count)]
+        initial = {index: integer(body, owner_members['block']) for index, body in registry()}
+        request('object-add', {
+            'qom-type': 'memory-backend-ram', 'id': 'mapping-proof',
+            'size': 4194304, 'share': False, 'reserve': True, 'prealloc': True,
+        })
+        assert request('qom-get', {'path': '/objects/mapping-proof', 'property': 'size'}) == 4194304
+        born = [(index, body) for index, body in registry()
+                if integer(body, owner_members['block']) and not initial[index]]
+        assert len(born) == 1, 'actual anonymous producer was not uniquely installed'
+        index, body = born[0]
+        block = integer(body, owner_members['block'])
+        assert integer(body, owner_members['process'], 4) == process.pid
+        assert integer(body, owner_members['readers'], 4) == 0
+        (output / 'born-owner.bin').write_bytes(body)
+        assert (body[owner_members['install_attempted']] ==
+                body[owner_members['installed']] == 1), (
+                    'actual producer installation receipt missing')
+        journal_address = block + block_members['native_mapping']
+        journal = read_at(journal_address, int(journal_type['DW_AT_byte_size']))
+        (output / 'born-journal.bin').write_bytes(journal)
+        assert integer(journal, journal_members['canonical']) == journal_address
+        assert integer(journal, journal_members['process'], 4) == process.pid
+        for field in ('reserve_attempted', 'reserve_returned',
+                      'activate_attempted', 'activate_returned', 'complete'):
+            assert journal[journal_members[field]] == 1, field
+        assert not journal[journal_members['unmap_attempted']]
+        assert integer(journal, journal_members['bytes']) == 4194304
+        mapping = integer(journal, journal_members['reservation'])
+        extent = integer(journal, journal_members['reservation_bytes'])
+        before_delete = maps()
+        (output / 'maps-born.txt').write_text(before_delete)
+        assert any(low <= mapping < high
+                   for low, high in map_ranges(before_delete))
+        request('object-del', {'id': 'mapping-proof'})
+        while True:
+            current = dict(registry())[index]
+            current_maps = maps()
+            covered = any(low < mapping + extent and high > mapping
+                          for low, high in map_ranges(current_maps))
+            disposals = integer(read_at(base + disposal_symbol, 8), 0)
+            remaining_block = integer(current, owner_members['block'])
+            observations.append({
+                'seconds': time.monotonic() - start,
+                'producer_block': remaining_block, 'range_overlap': covered,
+                'in_flight_disposals': disposals,
+            })
+            if not remaining_block:
+                assert not covered, 'producer returned without actual mapping removal'
+                break
+            if not covered and not disposals:
+                # Reobserve the external row after disposal reaches zero.
+                # The earlier /proc reads are separate factual observations.
+                current = dict(registry())[index]
+                remaining_block = integer(current, owner_members['block'])
+                assert not remaining_block, 'actual disposal-end without external registry return'
+            assert time.monotonic() < deadline, 'actual RCU reclaim/map removal not observed'
+            request('query-status')
+            time.sleep(.01)
+        (output / 'maps-returned.txt').write_text(current_maps)
+        result = {
+            'command': command,
+            'qemu_sha256': hashlib.sha256(qemu.read_bytes()).hexdigest(),
+            'physmem_sha256': hashlib.sha256(
+                args.physmem_object.read_bytes()).hexdigest(),
+            'registry_symbol': row, 'slot': index,
+            'serial': integer(body, owner_members['serial']),
+            'mapping': mapping, 'extent': extent,
+            'seconds': time.monotonic() - start, 'observations': observations,
+            'scope': ('Actual ordinary QOM creation, preallocation, deletion '
+                      'and queued reclaim effects observed: native mapping '
+                      'removal and external producer return. No Source, '
+                      'Original, active child or allocator backing disposal.'),
+        }
+        (output / 'result.json').write_text(json.dumps(result, indent=2) + '\n')
+    request('quit')
+    assert process.wait(timeout=max(.001, deadline - time.monotonic())) == 0
+    print('PASS actual ordinary QMP anonymous owner installation and physical reclaim')
+except BaseException as error:
+    failure = {'type': type(error).__name__, 'message': str(error)}
+    (output / 'failure.json').write_text(json.dumps(failure, indent=2) + '\n')
+    raise
+finally:
+    (output / 'observations.json').write_text(json.dumps(observations, indent=2) + '\n')
+    if process.poll() is None:
+        (output / 'maps-last.txt').write_text(maps())
+    if process.poll() is None:
+        process.kill()
+        process.wait()
+    wire_in.close()
+    wire_out.close()
+    stderr.close()
