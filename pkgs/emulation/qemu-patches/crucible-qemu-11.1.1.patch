+    qemu_plugin_crucible_native_group_member_attempt_v1(&registrar, 1);
+    qemu_plugin_crucible_native_registration_release_v1(native_block_io_members[1]);
+    qatomic_store_release(&native_block_io_members[1],
+        qemu_plugin_crucible_native_group_member_v1(&registrar, 1));
