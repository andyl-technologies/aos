+static int ram_control_receive_read_locked(
+    qemu_plugin_id_t id, qemu_plugin_crucible_ram_control_actor_v1 *actor,
+    qemu_plugin_crucible_ram_control_receive_v1 *receipt, size_t maximum_bytes,
+    size_t *received)
+{
+#if defined(CONFIG_LINUX) && defined(__x86_64__) && !defined(__ILP32__)
+    union {
+        struct cmsghdr aligned;
+        uint8_t bytes[CMSG_SPACE(sizeof(int))];
+    } control = { 0 };
+    struct iovec vector;
+    struct msghdr message = { 0 };
+    struct cmsghdr *header;
+    ssize_t result;
+    int status = qemu_crucible_ram_control_actor_current(actor, id);
+    int post;
+
+    if (status || receipt != &actor->receipt || !received ||
+        !receipt->active || receipt->uncertain || receipt->moved ||
+        !maximum_bytes || maximum_bytes > sizeof(receipt->frame) - receipt->frame_bytes ||
+        (!receipt->frame_bytes && maximum_bytes != 1)) {
+        return status ? status : -EINVAL;
+    }
+    if (qatomic_read(&actor->first_status)) {
+        return qatomic_read(&actor->first_status);
+    }
+    if (receipt->frame_bytes &&
+        (!receipt->record.acquired || !receipt->record.held ||
+         receipt->record.callback_active || receipt->record.end_attempted ||
+         receipt->record.release_attempted)) {
+        return -ENOKEY;
+    }
+    if (!actor->record_in_flight &&
+        (actor->quiesce_requested || actor->pause.requested ||
+         actor->request_pause.requested)) {
+        return -EAGAIN;
+    }
+    status = qemu_crucible_ram_control_actor_contract_current(actor);
+    if (!status) {
+        status = startup_descriptor_preflight(&actor->observation,
+                                               actor->descriptor_limit, 1);
+    }
+    if (status) {
+        return ram_control_failure(actor, status, false);
+    }
+    /* The raw length is only a bound within paid storage. Finish the four-byte
+     * prefix before a body read, and never consume the next framed record. */
+    if (receipt->frame_bytes < 4) {
+        maximum_bytes = MIN(maximum_bytes, 4 - receipt->frame_bytes);
+    } else {
+        if (!receipt->frame_extent || receipt->frame_bytes >= receipt->frame_extent) {
+            return -EALREADY;
+        }
+        maximum_bytes = MIN(maximum_bytes,
+                            receipt->frame_extent - receipt->frame_bytes);
+    }
+    vector = (struct iovec) {
+        .iov_base = receipt->frame + receipt->frame_bytes,
+        .iov_len = maximum_bytes,
+    };
+    message.msg_iov = &vector;
+    message.msg_iovlen = 1;
+    message.msg_control = control.bytes;
+    /* LP64 aligned storage is24, but syscall length20 admits only one int.
+     * CMSG_SPACE(sizeof(int)) as length would physically admit two aliases. */
+    message.msg_controllen = CMSG_LEN(sizeof(int));
+    result = recvmsg(actor->endpoint_descriptor, &message,
+                     MSG_DONTWAIT | MSG_CMSG_CLOEXEC);
+    /* This transition shares the mutex with pause acquisition and precedes
+     * all module inspection. Empty EAGAIN keeps the prepaid bank idle. */
+    if (result > 0) {
+        actor->record_in_flight = true;
+    }
+    status = result < 0 ? -errno : result == 0 ? -ECONNRESET : 0;
+    for (header = CMSG_FIRSTHDR(&message); result >= 0 && header;
+         header = CMSG_NXTHDR(&message, header)) {
+        if (header->cmsg_level != SOL_SOCKET || header->cmsg_type != SCM_RIGHTS ||
+            header->cmsg_len != CMSG_LEN(sizeof(int))) {
+            status = -EPROTO;
+            receipt->uncertain = true;
+            break;
+        }
+        if (receipt->alias_count == G_N_ELEMENTS(receipt->aliases)) {
+            status = -EOVERFLOW;
+            receipt->uncertain = true;
+            break;
+        }
+        memcpy(&receipt->aliases[receipt->alias_count++], CMSG_DATA(header),
+               sizeof(int));
+        if (receipt->frame_bytes) {
+            status = -EPROTO;
+        } else {
+            receipt->first_alias = true;
+        }
+    }
+    if (message.msg_flags & MSG_CTRUNC) {
+        status = -EMSGSIZE;
+        receipt->uncertain = true;
+    }
+    if (result > 0) {
+        receipt->frame_bytes += result;
+        if (receipt->frame_bytes >= 4 && !receipt->frame_extent) {
+            uint32_t body_bytes = ((uint32_t)receipt->frame[0] << 24) |
+                                  ((uint32_t)receipt->frame[1] << 16) |
+                                  ((uint32_t)receipt->frame[2] << 8) |
+                                  receipt->frame[3];
+
+            if (body_bytes > sizeof(receipt->frame) - 4) {
+                status = -EMSGSIZE;
+                receipt->uncertain = true;
+            } else {
+                receipt->frame_extent = 4 + body_bytes;
+            }
+        }
+    }
+    if (status == -EINTR) {
+        receipt->uncertain = true;
+    }
+    post = qemu_crucible_ram_control_actor_contract_current(actor);
+    if (post) {
+        receipt->uncertain = true;
+        ram_control_failure(actor, post, true);
+    }
+    if (status && status != -EAGAIN && status != -EWOULDBLOCK) {
+        ram_control_failure(actor, status, false);
+    }
+    if (qatomic_read(&actor->first_status)) {
+        return qatomic_read(&actor->first_status);
+    }
+    if (status) {
+        return status;
+    }
+    *received = result;
+    return 0;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+#endif
+
+#ifdef CONFIG_LINUX
+static int ram_control_pending_adopt_locked(
+    qemu_plugin_id_t id, qemu_plugin_crucible_ram_control_actor_v1 *actor,
+    qemu_plugin_crucible_ram_control_receive_v1 *receipt,
+    const uint8_t original[80], const uint8_t digest[32],
+    uint64_t *request_generation)
+{
+    int status = qemu_crucible_ram_control_actor_current(actor, id);
+
+    if (status || receipt != &actor->receipt || !receipt->active ||
+        receipt->uncertain || receipt->moved || !receipt->first_alias ||
+        receipt->alias_count != 1 || receipt->frame_bytes != 242 ||
+        !original || !digest || !request_generation) {
+        return status ? status : -EINVAL;
+    }
+    /* The actual actor gives up receipt before publishing its operation;
+     * even a retained negative may not restart another receive incarnation. */
+    qatomic_store_release(&actor->idle, true);
+    status = qemu_crucible_checkpoint_pending_adopt_native_v1(
+        actor, receipt, original, digest, request_generation);
+    return status;
+}
