+/*
+ * RISC-V instruction-count trigger timer
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef RISCV_ITRIGGER_TIMER_H
+#define RISCV_ITRIGGER_TIMER_H
+
+#include "exec/icount.h"
+#include "qemu/timer.h"
+
+static inline bool riscv_itrigger_uses_tb_helper(ICountMode mode)
+{
+    /* Adaptive ps/insn cannot represent a raw-instruction deadline as a timer. */
+    return mode != ICOUNT_PRECISE;
+}
+
+static inline int riscv_itrigger_step_count(int count)
+{
+    g_assert(count > 0);
+    return count - 1;
+}
+
+static inline void riscv_itrigger_schedule_timer(QEMUTimer *timer, int count)
+{
+    __int128 deadline_ps;
+
+    /* The trigger counts instructions, not nanoseconds of virtual time. */
+    if (__builtin_add_overflow(qemu_clock_get_ps_wide(QEMU_CLOCK_VIRTUAL),
+                               icount_to_ps_wide(count), &deadline_ps)) {
+        g_error("RISC-V instruction trigger deadline exceeds virtual "
+                "clock range");
+    }
+    timer_mod_ps_wide(timer, deadline_ps);
+}
+
+#endif /* RISCV_ITRIGGER_TIMER_H */
