+static void test_checkpoint_guard(const void *opaque)
+{
+    bool active_erase = GPOINTER_TO_INT(opaque);
+    g_autofree char *state_path = NULL;
+    g_autofree char *uri = NULL;
+    GError *err = NULL;
+    FlashConfig config = expand_config_defaults(&configuration[0]);
+    QTestState *qtest;
+    int fd;
+    int64_t timeout;
+
+    fd = g_file_open_tmp("qtest-cfi02-state.XXXXXX", &state_path, &err);
+    g_assert_no_error(err);
+    g_assert_cmpint(fd, >=, 0);
+    close(fd);
+
+    qtest = qtest_initf("-M musicpal"
+                        " -drive if=pflash,file=%s,format=raw,copy-on-read=on",
+                        image_path);
+    config.qtest = qtest;
+    qtest_qmp_assert_success(qtest, "{'execute':'stop'}");
+
+    if (active_erase) {
+        sector_erase(&config, 0);
+    }
+
+    uri = g_strdup_printf("file:%s", state_path);
+    qtest_qmp_assert_success(qtest,
+                             "{'execute':'migrate','arguments':{'uri':%s}}",
+                             uri);
+
+    timeout = g_get_monotonic_time() + 10 * G_USEC_PER_SEC;
+    while (g_get_monotonic_time() < timeout) {
+        QDict *response = qtest_qmp(qtest, "{'execute':'query-migrate'}");
+        QDict *result = qdict_get_qdict(response, "return");
+        const char *status = qdict_get_str(result, "status");
+
+        if (g_str_equal(status, active_erase ? "failed" : "completed")) {
+            if (active_erase) {
+                const char *description = qdict_get_try_str(result,
+                                                             "error-desc");
+
+                g_assert_nonnull(description);
+                g_assert_nonnull(strstr(description, "CFI02"));
+            }
+            qobject_unref(response);
+            qtest_quit(qtest);
+            unlink(state_path);
+            return;
+        }
+
+        g_assert_false(g_str_equal(status,
+                                   active_erase ? "completed" : "failed"));
+        qobject_unref(response);
+        g_usleep(1000);
+    }
+
+    g_error("CFI02 checkpoint did not finish within the test deadline");
+}
+
 int main(int argc, char **argv)
 {
     GError *err = NULL;
@@ -674,6 +734,10 @@ int main(int argc, char **argv)
 
     qtest_add_data_func("pflash-cfi02/cfi-in-autoselect", &configuration[0],
                         test_cfi_in_autoselect);
+    qtest_add_data_func("pflash-cfi02/checkpoint-idle", GINT_TO_POINTER(0),
+                        test_checkpoint_guard);
+    qtest_add_data_func("pflash-cfi02/checkpoint-active-erase",
+                        GINT_TO_POINTER(1), test_checkpoint_guard);
     int result = g_test_run();
     cleanup(NULL);
     return result;
