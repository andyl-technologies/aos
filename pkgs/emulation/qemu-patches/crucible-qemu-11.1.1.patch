+static uint64_t cpu_allocation_metadata_bytes(void)
+{
+    QemuCrucibleCpuSourceAllocationOwner *owner;
+    uint64_t bytes = 0;
+
+    if (pthread_mutex_trylock(&startup_source.cpu_allocations.lock)) {
+        return UINT64_MAX;
+    }
+    if (startup_source.cpu_allocations.pending_charge.held) {
+        bytes = startup_source.cpu_allocations.pending_charge.bytes;
+    }
+    for (owner = startup_source.cpu_allocations.owners; owner;
+         owner = owner->next) {
+        if (!owner->charge.held || owner->charge.bytes > UINT64_MAX - bytes) {
+            bytes = UINT64_MAX;
+            break;
+        }
+        bytes += owner->charge.bytes;
+    }
+#if defined(CONFIG_TCG) && defined(CONFIG_PLUGIN)
+    uint64_t tlb_bytes = cpu_tlb_metadata_bytes_locked();
+
+    bytes = tlb_bytes > UINT64_MAX - bytes ? UINT64_MAX : bytes + tlb_bytes;
+#endif
+    pthread_mutex_unlock(&startup_source.cpu_allocations.lock);
+    /* These exact requests already occupy native_live. Reporting them excludes
+     * their held extents from the later inventory allowance exactly once. */
+    return bytes;
+}
+
+static void cpu_allocation_reap_returned(void)
+{
+    QemuCrucibleCpuSourceAllocationOwner *owner;
+    QemuCrucibleCpuSourceAllocationOwner *next;
+
+    /* Native records matching frees even on other threads. Physical Source
+     * retirement happens on its genuine constructing Main at these boundary
+     * calls, outside replay and without current/post/clock or new admission. */
+    if (!startup_source.standing.construction.attempted || replay_mutex_owned() ||
+        !qemu_thread_is_self(&startup_source.standing.construction.operation.thread) ||
+        pthread_mutex_trylock(&startup_source.cpu_allocations.lock)) {
+        return;
+    }
+    cpu_allocation_pending_retire_locked();
+#if defined(CONFIG_TCG) && defined(CONFIG_PLUGIN)
+    cpu_tlb_reap_locked();
+#endif
+    for (owner = startup_source.cpu_allocations.owners; owner; owner = next) {
+        next = owner->next;
+        if (!cpu_allocation_identity_locked(owner) &&
+            !qemu_crucible_cpu_allocation_returned_current_v1(owner)) {
+            /* Negative retirement keeps the real registry holder, or its
+             * physically consumed debit in the fixed pending journal. */
+            cpu_allocation_return_locked(&owner);
+        }
+    }
+    pthread_mutex_unlock(&startup_source.cpu_allocations.lock);
+}
