+static int fixture_wait(pid_t child)
+{
+    int status = 0;
+
+    for (unsigned attempt = 0; attempt < 1000; attempt++) {
+        pid_t result = waitpid(child, &status, WNOHANG);
+
+        if (result == child) {
+            return status;
+        }
+        if (result < 0 && errno != EINTR) {
+            g_error("actual child wait refused: %s", strerror(errno));
+        }
+        g_usleep(1000);
+    }
+    /* This fixture child cannot fork or escape its process identity. A failed
+     * probe must be killed and actually waited, never reported as positive. */
+    kill(child, SIGKILL);
+    for (unsigned attempt = 0; attempt < 1000; attempt++) {
+        pid_t result = waitpid(child, &status, WNOHANG);
+
+        if (result == child) {
+            g_error("preinit probe exceeded its separate one-second bound");
+        }
+        if (result < 0 && errno != EINTR) {
+            g_error("preinit probe retirement unknown: %s", strerror(errno));
+        }
+        g_usleep(1000);
+    }
+    g_error("preinit probe physical retirement unproven");
+    abort();
+}
