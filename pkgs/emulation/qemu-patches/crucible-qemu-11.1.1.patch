+static bool virtio_blk_fingerprint_projection(QEMUFile *f,
+                                              const void *opaque,
+                                              Error **errp)
+{
+    VirtIOBlock *s = (VirtIOBlock *)opaque;
+    const char *serial = s->conf.serial ? s->conf.serial : "";
+    size_t serial_length = strlen(serial);
+
+    if (serial_length > UINT16_MAX || s->conf.num_queues == 0 ||
+        s->conf.num_queues > VIRTIO_QUEUE_MAX) {
+        error_setg(errp, "virtio-blk projection has invalid configuration");
+        return false;
+    }
+    qemu_mutex_lock(&s->rq_lock);
+    if (!virtio_blk_validate_request_list(s, s->rq, errp) ||
+        !virtio_blk_validate_request_list(s, s->dropped_rq, errp)) {
+        qemu_mutex_unlock(&s->rq_lock);
+        return false;
+    }
+    if (!virtio_save_fingerprint_projection(f, VIRTIO_DEVICE(s), errp)) {
+        qemu_mutex_unlock(&s->rq_lock);
+        return false;
+    }
+
+    qemu_put_be16(f, serial_length);
+    qemu_put_buffer(f, (const uint8_t *)serial, serial_length);
+    qemu_put_be16(f, s->conf.num_queues);
+    qemu_put_be16(f, s->conf.queue_size);
+    qemu_put_be32(f, s->conf.request_merging);
+    qemu_put_be64(f, s->host_features);
+    qemu_put_be64(f, s->config_size);
+    qemu_put_be16(f, s->sector_mask);
+    qemu_put_byte(f, s->original_wce);
+    qemu_put_byte(f, blk_enable_write_cache(s->blk));
+
+    virtio_blk_put_request_list(f, s, s->rq);
+    virtio_blk_put_request_list(f, s, s->dropped_rq);
+    qemu_mutex_unlock(&s->rq_lock);
+    return qemu_file_get_error(f) == 0;
