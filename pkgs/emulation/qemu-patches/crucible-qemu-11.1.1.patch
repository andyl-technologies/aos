+int qemu_crucible_startup_source_control_purpose_check_v2(
+    QemuCrucibleStartupControlPurpose *purpose)
+{
+    int status;
+
+    bool steady = standing_operation_identity(&startup_source.standing.operation) ||
+        standing_construction_operation_identity();
+
+    if (purpose != &startup_source.control_purpose ||
+        (!steady && (!startup_owner() ||
+                     !startup_invocation(startup_source.saved.plugin_id)))) {
+        return -EPERM;
+    }
+    status = steady ? 0 : startup_active(startup_source.saved.plugin_id);
+    if (status) {
+        return status;
+    }
+    if (!purpose->held || purpose->process_id != startup_source.owner_process ||
+        purpose->plugin_id != startup_source.saved.plugin_id ||
+        purpose->process_generation != startup_source.original.process_generation ||
+        purpose->ctx != startup_source.saved.ctx ||
+        purpose->module != startup_source.saved.module ||
+        purpose->install != startup_source.saved.install) {
+        return startup_failure(-ESTALE);
+    }
+    /* Temporal checks remain on the actual installing original. This holder
+     * retains credit beyond completion, but cannot issue later allocations.
+     */
+#ifdef CONFIG_LINUX
+    return startup_process_purpose_live();
+#else
+    return -ENOTSUP;
+#endif
+}
