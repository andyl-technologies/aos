+void qemu_crucible_ram_topology_will_change(void)
+{
+    if (qatomic_load_acquire(&logical_capture->active) ||
+        qatomic_load_acquire(&inventory_capture.active) ||
+        qatomic_load_acquire(&logical_physical_debt.pending)) {
+        /* The real add/resize/free producers already call this before their
+         * destructive effect. A void topology transition cannot retire/reuse
+         * these retained incarnations before genuine physical settlement. */
+        error_report("retained fingerprint debt requires completed RAM retirement");
+        abort();
+    }
+    if (fingerprint_baseline.regions) {
+        CrucibleRamInventory *retired = fingerprint_baseline.regions;
+
+        /* Retire the actual accepted marker BEFORE an allocation can disappear.
+         * It can no longer classify a future operation from reused addresses. */
+        fingerprint_baseline.accepted = false;
+        fingerprint_baseline.regions = NULL;
+        if (region_inventory_drop(&retired)) {
+            error_report("RAM topology change retains native metadata cleanup debt");
+            abort();
+        }
+    }
+    if (qatomic_load_acquire(&paging_topology_pinned)) {
+        /* Stable addresses and dirty-plane pointers remain owned until reap.
+         * A future topology transition must first drain and rebind that owner. */
+        error_report("active host paging requires an admitted RAM topology transition");
+        abort();
+    }
+}
