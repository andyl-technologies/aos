+        view->rearm_timers || view->source_kind || view->instance) {
+        return -EINVAL;
+    }
+    status = x86_crucible_register_qom_child(cpu, &child);
+    if (status || !child) {
+        return status ? status : -ENOTSUP;
+    }
+    APICCommonState *apic = APIC_COMMON(child);
+    APICCommonClass *klass = APIC_COMMON_GET_CLASS(apic);
