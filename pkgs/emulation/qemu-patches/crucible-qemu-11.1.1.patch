new file mode 100644
index 0000000000000000000000000000000000000000..5f70f85adcf9054eede4d2f2f23ba52cc9eafb36
--- /dev/null
+++ b/util/crucible-hot-fork-child.c
@@ -0,0 +1,1294 @@
+/*
+ * Crucible hot-fork child resource disposition helpers
+ *
+ * Copyright (c) Andyl, Inc.
