+static void qemu_plugin_time_advance_run_on_rr(run_on_cpu_func func)
+{
+    g_assert(first_cpu);
+    if (qemu_cpu_is_self(first_cpu)) {
+        func(first_cpu, RUN_ON_CPU_NULL);
+        return;
+    }
+
+    /* Let RR acquire replay while run_on_cpu drops the BQL. */
+    g_assert(bql_locked());
+    replay_mutex_unlock();
+    run_on_cpu(first_cpu, func, RUN_ON_CPU_NULL);
+
+    /* Restore the canonical replay-before-BQL acquisition order. */
+    bql_unlock();
+    replay_mutex_lock();
+    bql_lock();
+}
