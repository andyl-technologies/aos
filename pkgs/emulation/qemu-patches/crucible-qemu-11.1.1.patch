+void rr_crucible_sim_trace_idle_advance(const char *phase,
+                                        int64_t target_tick)
+{
+    char cpu_facts[192];
+    uint64_t halted = 0;
+    uint64_t work = 0;
+    uint64_t exit = 0;
+    uint64_t interrupt = 0;
+    uint64_t stop = 0;
+    unsigned int cpu_count = 0;
+    unsigned int exec_state;
+    int64_t virtual_ps;
+    int64_t deadline_delta;
+    int64_t deadline_ps;
+    int cpu_facts_length;
+    uint64_t sequence;
+    CPUState *cpu;
+
+    if (!rr_crucible_sim_mode() ||
+        !trace_event_get_state_backends(TRACE_CRUCIBLE_SIM_DETERMINISM_IDLE)) {
+        return;
+    }
+
+    sequence = qemu_crucible_determinism_trace_begin();
+    CPU_FOREACH(cpu) {
+        if (cpu->cpu_index >= 0 && cpu->cpu_index < 64) {
+            uint64_t bit = UINT64_C(1) << cpu->cpu_index;
+
+            halted |= cpu->halted ? bit : 0;
+            work |= cpu_work_list_empty(cpu) ? 0 : bit;
+            exit |= qatomic_read(&cpu->exit_request) ? bit : 0;
+            interrupt |= qatomic_read(&cpu->interrupt_request) ? bit : 0;
+            stop |= qatomic_read(&cpu->stop) ||
+                    qatomic_read(&cpu->stopped) ||
+                    qatomic_read(&cpu->unplug) ? bit : 0;
+        }
+        cpu_count++;
+    }
+    if (cpu_count > 64) {
+        error_report("Crucible determinism trace supports at most 64 CPUs");
+        abort();
+    }
+
+    virtual_ps = qemu_clock_get_ps(QEMU_CLOCK_VIRTUAL);
+    deadline_delta = qemu_clock_deadline_ps_all(QEMU_CLOCK_VIRTUAL,
+                                                QEMU_TIMER_ATTR_ALL);
+    deadline_ps = deadline_delta < 0 || virtual_ps < 0 ? -1 :
+        deadline_delta > INT64_MAX - virtual_ps ? INT64_MAX :
+        virtual_ps + deadline_delta;
+    exec_state = rr_crucible_sim_wake_read_stable(&rr_tcg_exec_state);
+    cpu_facts_length = g_snprintf(
+        cpu_facts, sizeof(cpu_facts),
+        "cpu_count=%u halted=0x%" PRIx64 " work=0x%" PRIx64
+        " exit=0x%" PRIx64 " interrupt=0x%" PRIx64
+        " stop=0x%" PRIx64 " state=%u",
+        cpu_count, halted, work, exit, interrupt, stop, exec_state);
+    g_assert(cpu_facts_length >= 0 &&
+             (size_t)cpu_facts_length < sizeof(cpu_facts));
+    trace_crucible_sim_determinism_idle(
+        phase, sequence,
+        (uint64_t)MAX(icount_get_raw_observed(), 0), virtual_ps,
+        target_tick, deadline_ps, icount_crucible_rr_current_vcpu(),
+        icount_crucible_rr_cursor_position(), cpu_facts);
+    qemu_crucible_determinism_trace_end();
+}
