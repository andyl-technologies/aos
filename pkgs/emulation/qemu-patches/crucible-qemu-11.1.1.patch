+/*
+ * Independent canonical-byte vectors, never an accepting publisher fixture.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "qemu/bswap.h"
+#include "qemu/crucible-publisher-protocol.h"
+
+typedef int (*Decode)(const uint8_t *, size_t, void *);
+
+typedef struct DecodeCase {
+    size_t bytes;
+    size_t output_bytes;
+    size_t alignment;
+    Decode decode;
+} DecodeCase;
+
+static int header_decode(const uint8_t *wire, size_t bytes, void *out)
+{
+    return qemu_crucible_publisher_header_decode_v1(wire, bytes, out);
+}
+
+static int publication_decode(const uint8_t *wire, size_t bytes, void *out)
+{
+    return qemu_crucible_publisher_publication_decode_v1(wire, bytes, out);
+}
+
+static int return_decode(const uint8_t *wire, size_t bytes, void *out)
+{
+    return qemu_crucible_publisher_return_decode_v1(wire, bytes, out);
+}
+
+static int terminal_decode(const uint8_t *wire, size_t bytes, void *out)
+{
+    return qemu_crucible_publisher_terminal_decode_v1(wire, bytes, out);
+}
+
+static const DecodeCase cases[] = {
+    { 256, sizeof(QemuCruciblePublisherHeaderView),
+      _Alignof(QemuCruciblePublisherHeaderView), header_decode },
+    { 1536, sizeof(QemuCruciblePublisherPublicationView),
+      _Alignof(QemuCruciblePublisherPublicationView), publication_decode },
+    { 504, sizeof(QemuCruciblePublisherReturnView),
+      _Alignof(QemuCruciblePublisherReturnView), return_decode },
+    { 512, sizeof(QemuCruciblePublisherTerminalView),
+      _Alignof(QemuCruciblePublisherTerminalView), terminal_decode },
+};
+
+/* Literal protocol offsets and lengths are deliberately independent of the
+ * implementation's geometry constants. No producer encoder creates vectors. */
+static void header_vector(uint8_t wire[256])
+{
+    memset(wire, 0, 256);
+    memcpy(wire, "CRUCPLM1", 8);
+    stl_be_p(wire + 8, 1);
+    stl_be_p(wire + 12, 4096);
+    stq_be_p(wire + 16, 3);
+    stq_be_p(wire + 32, 4);
+    stq_be_p(wire + 40, 5);
+    memset(wire + 48, 0x11, 32);
+    memset(wire + 80, 0x22, 32);
+    stl_be_p(wire + 112, 31);
+    stl_be_p(wire + 116, 32);
+    stl_be_p(wire + 120, 256);
+    stl_be_p(wire + 124, 1536);
+    stl_be_p(wire + 128, 1792);
+    stl_be_p(wire + 132, 512);
+    stl_be_p(wire + 136, 2304);
+    stl_be_p(wire + 140, 512);
+}
+
+static void row_vector(uint8_t row[192], bool preparation)
+{
+    memset(row, 0, 192);
+    memset(row, 0x33, 32);
+    stq_be_p(row + 32, 4);
+    stq_be_p(row + 40, 5);
+    stl_be_p(row + 48, preparation ? 12 : 1);
+    stq_be_p(row + 56, 1);
+    stq_be_p(row + 64, 1);
+    stq_be_p(row + 72, 10);
+    stq_be_p(row + 80, 11);
+    stq_be_p(row + 88, 12);
+    stq_be_p(row + 96, 100);
+    stq_be_p(row + 128, 1);
+    stq_be_p(row + 144, 1);
+    stl_be_p(row + 156, preparation);
+    stq_be_p(row + 160, 9);
+}
+
+static void publication_vector(uint8_t wire[1536])
+{
+    uint8_t *cohort = wire + 128;
+    uint8_t *command = wire + 1024;
+
+    memset(wire, 0, 1536);
+    stq_be_p(wire, 2);
+    stq_be_p(wire + 8, 3);
+    stq_be_p(wire + 16, 4);
+    stq_be_p(wire + 24, 1);
+    stq_be_p(wire + 32, 6);
+    stq_be_p(wire + 40, 1);
+    stl_be_p(wire + 48, 128);
+    stl_be_p(wire + 52, 896);
+    stl_be_p(wire + 56, 1024);
+    stl_be_p(wire + 60, 128);
+
+    memcpy(cohort, "CRUCACT2", 8);
+    stl_be_p(cohort + 8, 2);
+    stl_be_p(cohort + 12, 896);
+    memset(cohort + 16, 0x11, 32);
+    memset(cohort + 48, 0x22, 32);
+    stq_be_p(cohort + 80, 4);
+    stq_be_p(cohort + 88, 5);
+    stl_be_p(cohort + 96, 2);
+    stl_be_p(cohort + 100, 3);
+    stq_be_p(cohort + 104, 13);
+    stq_be_p(cohort + 112, 6);
+    stl_be_p(cohort + 120, 0x10101);
+    stl_be_p(cohort + 124, 1);
+    row_vector(cohort + 128, false);
+
+    memcpy(command, "CRUCQCM1", 8);
+    stl_be_p(command + 8, 1);
+    stl_be_p(command + 12, 128);
+    stq_be_p(command + 16, 8);
+    stq_be_p(command + 32, UINT64_MAX);
+    stl_be_p(command + 56, 1);
+    stq_be_p(command + 64, 13);
+}
+
+static void return_vector(uint8_t wire[504])
+{
+    memset(wire, 0, 504);
+    stq_be_p(wire, 2);
+    stq_be_p(wire + 8, 4);
+    stq_be_p(wire + 16, 3);
+    stq_be_p(wire + 24, 2);
+    stq_be_p(wire + 32, 5);
+    stl_be_p(wire + 40, (uint32_t)-EIO);
+    stl_be_p(wire + 44, (uint32_t)-ESTALE);
+    stl_be_p(wire + 48, 1);
+    stl_be_p(wire + 52, 0x7f);
+}
+
+static void terminal_vector(uint8_t wire[512])
+{
+    memset(wire, 0, 512);
+    stq_be_p(wire, 2);
+    stq_be_p(wire + 8, 4);
+    stq_be_p(wire + 16, 3);
+    stq_be_p(wire + 24, 2);
+    stq_be_p(wire + 32, 2);
+    stl_be_p(wire + 40, (uint32_t)-EIO);
+    stl_be_p(wire + 44, (uint32_t)-ESTALE);
+    stl_be_p(wire + 48, 1);
+    stl_be_p(wire + 52, 1);
+    stq_be_p(wire + 56, 6);
+}
+
+static void assert_refusal(const DecodeCase *test, const uint8_t *wire,
+                           size_t bytes, int status)
+{
+    _Alignas(max_align_t) uint8_t output[2048];
+    uint8_t saved[2048];
+
+    g_assert_cmpuint(test->output_bytes, <=, sizeof(output));
+    memset(output, 0xa5, sizeof(output));
+    memcpy(saved, output, sizeof(saved));
+    g_assert_cmpint(test->decode(wire, bytes, output), ==, status);
+    g_assert_cmpmem(output, sizeof(output), saved, sizeof(saved));
+}
+
+static void test_header(void)
+{
+    uint8_t wire[256];
+    QemuCruciblePublisherHeaderView view;
+    static const size_t geometry[] = { 120, 124, 128, 132, 136, 140 };
+    static const size_t generations[] = { 16, 32, 40 };
+
+    header_vector(wire);
+    g_assert_cmpint(header_decode(wire, sizeof(wire), &view), ==, 0);
+    g_assert_cmpuint(view.lender_generation, ==, 3);
+    g_assert_cmpuint(view.account_generation, ==, 4);
+    g_assert_cmpuint(view.process_generation, ==, 5);
+    g_assert_cmpuint(view.node_index, ==, 31);
+    g_assert_cmpuint(view.node_count, ==, 32);
+    g_assert_cmpmem(view.source_capability, 32, wire + 48, 32);
+    g_assert_cmpmem(view.source_reservation, 32, wire + 80, 32);
+
+    for (size_t i = 0; i < G_N_ELEMENTS(geometry); i++) {
+        header_vector(wire);
+        stl_be_p(wire + geometry[i], UINT32_MAX);
+        assert_refusal(&cases[0], wire, sizeof(wire), -EPROTO);
+    }
+    for (size_t i = 0; i < G_N_ELEMENTS(generations); i++) {
+        header_vector(wire);
+        stq_be_p(wire + generations[i], 0);
+        assert_refusal(&cases[0], wire, sizeof(wire), -EPROTO);
+        stq_be_p(wire + generations[i], UINT64_MAX);
+        assert_refusal(&cases[0], wire, sizeof(wire), -EPROTO);
+    }
+    for (size_t i = 144; i < sizeof(wire); i++) {
+        header_vector(wire);
+        wire[i] = 1;
+        assert_refusal(&cases[0], wire, sizeof(wire), -EPROTO);
+    }
+    header_vector(wire);
+    memset(wire + 48, 0, 32);
+    assert_refusal(&cases[0], wire, sizeof(wire), -EPROTO);
+    header_vector(wire);
+    memset(wire + 80, 0, 32);
+    assert_refusal(&cases[0], wire, sizeof(wire), -EPROTO);
+    header_vector(wire);
+    stq_be_p(wire + 24, 1);
+    assert_refusal(&cases[0], wire, sizeof(wire), -EPROTO);
+    header_vector(wire);
+    stl_be_p(wire + 116, 31);
+    assert_refusal(&cases[0], wire, sizeof(wire), -EPROTO);
+    stl_be_p(wire + 116, 33);
+    assert_refusal(&cases[0], wire, sizeof(wire), -EPROTO);
+    header_vector(wire);
+    wire[0] ^= 1;
+    assert_refusal(&cases[0], wire, sizeof(wire), -EPROTONOSUPPORT);
+    header_vector(wire);
+    stl_be_p(wire + 8, 2);
+    assert_refusal(&cases[0], wire, sizeof(wire), -EPROTONOSUPPORT);
+    header_vector(wire);
+    stl_be_p(wire + 12, 4095);
+    assert_refusal(&cases[0], wire, sizeof(wire), -EPROTONOSUPPORT);
+}
+
+static void test_publication(void)
+{
+    uint8_t wire[1536];
+    QemuCruciblePublisherPublicationView view;
+    static const size_t geometry[] = { 48, 52, 56, 60 };
+    static const uint64_t bad_sequence[] = { 0, 1, UINT64_MAX };
+
+    publication_vector(wire);
+    g_assert_cmpint(publication_decode(wire, sizeof(wire), &view), ==, 0);
+    g_assert_true(view.command_present);
+    g_assert_cmpuint(view.command.scheduler_generation, ==, 8);
+    g_assert_cmpuint(view.command.initial_raw_icount, ==, 0);
+    g_assert_cmpuint(view.command.max_advance_raw_icount, ==, UINT64_MAX);
+    g_assert_cmpuint(view.command.logical_tick_ceiling, ==, 0);
+    g_assert_cmpuint(view.command.native_ceiling_ns, ==, 0);
+    g_assert_cmpuint(view.cohort.binding.command_frontier, ==, 13);
+    for (unsigned phase = 1; phase <= 3; phase++) {
+        stq_be_p(wire + 24, phase);
+        g_assert_cmpint(publication_decode(wire, sizeof(wire), &view), ==, 0);
+        g_assert_cmpuint(view.permission_phase, ==, phase);
+    }
+    for (size_t i = 0; i < G_N_ELEMENTS(bad_sequence); i++) {
+        publication_vector(wire);
+        stq_be_p(wire, bad_sequence[i]);
+        assert_refusal(&cases[1], wire, sizeof(wire), -EPROTO);
+        publication_vector(wire);
+        stq_be_p(wire + 32, bad_sequence[i]);
+        assert_refusal(&cases[1], wire, sizeof(wire), -EPROTO);
+        publication_vector(wire);
+        stq_be_p(wire + 1024 + 16, bad_sequence[i]);
+        assert_refusal(&cases[1], wire, sizeof(wire), -EPROTO);
+    }
+    for (size_t i = 0; i < G_N_ELEMENTS(geometry); i++) {
+        publication_vector(wire);
+        stl_be_p(wire + geometry[i], UINT32_MAX);
+        assert_refusal(&cases[1], wire, sizeof(wire), -EPROTO);
+    }
+    for (size_t i = 64; i < 128; i++) {
+        publication_vector(wire);
+        wire[i] = 1;
+        assert_refusal(&cases[1], wire, sizeof(wire), -EPROTO);
+    }
+    for (size_t i = 1152; i < sizeof(wire); i++) {
+        publication_vector(wire);
+        wire[i] = 1;
+        assert_refusal(&cases[1], wire, sizeof(wire), -EPROTO);
+    }
+    publication_vector(wire);
+    stq_be_p(wire + 16, UINT64_MAX >> 3);
+    g_assert_cmpint(publication_decode(wire, sizeof(wire), &view), ==, 0);
+    stq_be_p(wire + 16, (UINT64_MAX >> 3) + 1);
+    assert_refusal(&cases[1], wire, sizeof(wire), -EPROTO);
+    publication_vector(wire);
+    stq_be_p(wire + 24, 4);
+    assert_refusal(&cases[1], wire, sizeof(wire), -EPROTO);
+    publication_vector(wire);
+    stq_be_p(wire + 40, 2);
+    assert_refusal(&cases[1], wire, sizeof(wire), -EPROTO);
+    publication_vector(wire);
+    stq_be_p(wire + 32, 4);
+    assert_refusal(&cases[1], wire, sizeof(wire), -EPROTO);
+
+    /* Root-owner zero is a valid identity, never authority. Each projected
+     * operation still has positive required-work inventory. */
+    publication_vector(wire);
+    stq_be_p(wire + 256 + 32, 0);
+    g_assert_cmpint(publication_decode(wire, sizeof(wire), &view), ==, 0);
+    g_assert_cmpuint(view.cohort.rows[0].budget_owner, ==, 0);
+    stq_be_p(wire + 256 + 40, 0);
+    assert_refusal(&cases[1], wire, sizeof(wire), -EPROTO);
+    publication_vector(wire);
+    stq_be_p(wire + 256 + 144, 0);
+    assert_refusal(&cases[1], wire, sizeof(wire), -EPROTO);
+    publication_vector(wire);
+    stq_be_p(wire + 256 + 136, 2);
+    assert_refusal(&cases[1], wire, sizeof(wire), -EPROTO);
+
+    /* A complete four-row cohort preserves each distinct position, including
+     * equal lender bytes. A born unprojected row is physical syntax only. */
+    publication_vector(wire);
+    stl_be_p(wire + 128 + 120, 0xf0f01);
+    stl_be_p(wire + 128 + 124, 4);
+    stl_be_p(wire + 256 + 152, 2);
+    for (size_t i = 1; i < 4; i++) {
+        row_vector(wire + 256 + i * 192, true);
+    }
+    g_assert_cmpint(publication_decode(wire, sizeof(wire), &view), ==, 0);
+    g_assert_cmpuint(view.cohort.planned_count, ==, 4);
+    g_assert_cmpuint(view.cohort.born_mask, ==, 15);
+    g_assert_cmpuint(view.cohort.projected_mask, ==, 15);
+    for (size_t i = 0; i < 4; i++) {
+        uint8_t *row = wire + 256 + i * 192;
+
+        stq_be_p(row + 32, 0);
+        g_assert_cmpint(publication_decode(wire, sizeof(wire), &view), ==, 0);
+        g_assert_cmpuint(view.cohort.rows[i].budget_owner, ==, 0);
+        stq_be_p(row + 144, 0);
+        assert_refusal(&cases[1], wire, sizeof(wire), -EPROTO);
+        stq_be_p(row + 144, 1);
+    }
+    stl_be_p(wire + 128 + 120, UINT32_C(0x80010f01));
+    memset(wire + 448, 0, 576);
+    g_assert_cmpint(publication_decode(wire, sizeof(wire), &view), ==, 0);
+    g_assert_cmpuint(view.cohort.born_mask, ==, 15);
+    g_assert_cmpuint(view.cohort.projected_mask, ==, 1);
+    wire[448] = 1;
+    assert_refusal(&cases[1], wire, sizeof(wire), -EPROTO);
+}
+
+static void test_command(void)
+{
+    uint8_t wire[1536];
+    uint8_t *command = wire + 1024;
+    QemuCruciblePublisherPublicationView view;
+
+    for (size_t offset = 0; offset <= 12; offset += 4) {
+        publication_vector(wire);
+        command[offset] ^= 1;
+        assert_refusal(&cases[1], wire, sizeof(wire), -EPROTONOSUPPORT);
+    }
+    for (unsigned mode = 0; mode <= 3; mode += 3) {
+        publication_vector(wire);
+        stl_be_p(command + 56, mode);
+        assert_refusal(&cases[1], wire, sizeof(wire), -EPROTO);
+    }
+    publication_vector(wire);
+    stl_be_p(command + 60, 1);
+    assert_refusal(&cases[1], wire, sizeof(wire), -EPROTO);
+    publication_vector(wire);
+    stq_be_p(command + 24, UINT64_MAX);
+    g_assert_cmpint(publication_decode(wire, sizeof(wire), &view), ==, 0);
+    stq_be_p(command + 32, UINT64_MAX - 1);
+    assert_refusal(&cases[1], wire, sizeof(wire), -EPROTO);
+    publication_vector(wire);
+    stl_be_p(command + 56, 2);
+    stq_be_p(command + 72, 9);
+    stq_be_p(command + 40, UINT64_MAX);
+    stq_be_p(command + 48, UINT64_MAX);
+    g_assert_cmpint(publication_decode(wire, sizeof(wire), &view), ==, 0);
+    g_assert_cmpuint(view.command.next_idle_generation, ==, 9);
+    g_assert_cmpuint(view.command.logical_tick_ceiling, ==, UINT64_MAX);
+    g_assert_cmpuint(view.command.native_ceiling_ns, ==, UINT64_MAX);
+    stq_be_p(command + 72, 0);
+    assert_refusal(&cases[1], wire, sizeof(wire), -EPROTO);
+    stq_be_p(command + 72, UINT64_MAX);
+    assert_refusal(&cases[1], wire, sizeof(wire), -EPROTO);
+    publication_vector(wire);
+    stq_be_p(command + 72, 1);
+    assert_refusal(&cases[1], wire, sizeof(wire), -EPROTO);
+    for (size_t i = 80; i < 128; i++) {
+        publication_vector(wire);
+        command[i] = 1;
+        assert_refusal(&cases[1], wire, sizeof(wire), -EPROTO);
+    }
+    publication_vector(wire);
+    stq_be_p(command + 64, 14);
+    assert_refusal(&cases[1], wire, sizeof(wire), -EPROTO);
+    publication_vector(wire);
+    stl_be_p(wire + 256 + 48, 12);
+    assert_refusal(&cases[1], wire, sizeof(wire), -EPROTO);
+
+    /* Sample/preparation metadata cannot be converted to a Quantum command. */
+    publication_vector(wire);
+    stq_be_p(wire + 40, 0);
+    stl_be_p(wire + 60, 0);
+    memset(command, 0, 128);
+    assert_refusal(&cases[1], wire, sizeof(wire), -EPROTO);
+    stl_be_p(wire + 256 + 48, 4);
+    g_assert_cmpint(publication_decode(wire, sizeof(wire), &view), ==, 0);
+    g_assert_false(view.command_present);
+    command[127] = 1;
+    assert_refusal(&cases[1], wire, sizeof(wire), -EPROTO);
+}
+
+static void test_return(void)
+{
+    uint8_t wire[504];
+    QemuCruciblePublisherReturnView view;
+
+    return_vector(wire);
+    g_assert_cmpint(return_decode(wire, sizeof(wire), &view), ==, 0);
+    g_assert_cmpint(view.first_status, ==, -EIO);
+    g_assert_cmpint(view.post_status, ==, -ESTALE);
