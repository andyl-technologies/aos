+
+    /*
+     * The exit status names the failing step or detail, but not the result
+     * that failed it.  Once descriptor application has routed this process's
+     * stderr to the branch-private diagnostics stream, the host reads the
+     * exact result there; before that the line goes wherever the source's
+     * stderr went.
+     */
+    length = snprintf(report, sizeof(report),
+                      "crucible hot-fork child failed: step %u detail %u "
+                      "result %d\n", step, detail, result);
+    if (length > 0 && length < (int)sizeof(report)) {
+        ssize_t written = write(STDERR_FILENO, report, (size_t)length);
+
+        (void)written;
+    }
+    if (step == 9 && detail != 0) {
+        _exit(CRUCIBLE_HOT_FORK_CHILD_DETAIL_EXIT_BASE + detail);
+    }
+    _exit(CRUCIBLE_HOT_FORK_CHILD_STEP_EXIT_BASE + step);
+}
+
+/*
+ * Names a block-layer failure on the child's stderr, which descriptor
+ * application has routed to its branch-private diagnostics stream; the exit
+ * status names only the step.
+ */
+static void crucible_hot_fork_child_report_error(const char *stage,
+                                                 Error *error)
+{
+    fprintf(stderr, "crucible hot-fork child %s failed: %s\n", stage,
+            error ? error_get_pretty(error) : "no error detail");
+    error_free(error);
+}
+
+static int crucible_hot_fork_finish_child_operation(void *opaque)
+{
+    CrucibleHotForkOperation *operation = opaque;
+    QemuCrucibleHotForkDescriptorTableTransaction descriptors = { 0 };
+    QemuCrucibleHotForkDescriptorTableProof proof = { 0 };
+    QemuCrucibleHotForkChildResourcePlan resources = { 0 };
+    QemuBlockBackendHotForkBarrierInventory block = { 0 };
+    Error *child_error = NULL;
+    unsigned int step = 1;
+    int result;
+
+    if (!operation || !operation->prepared) {
+        return -EINVAL;
+    }
+    result = crucible_hot_fork_apply_child_process_contract(operation);
+    if (result == 0) {
+        step++;
+        result = qemu_crucible_hot_fork_begin_descriptor_table(
+            &operation->parent_identity, &descriptors);
+    }
+    if (result == 0) {
+        step++;
+        result = qemu_crucible_hot_fork_reconstruct_child_runtime(
+            &operation->runtime, &descriptors);
+    }
+    if (result == 0) {
+        step++;
+        result = qemu_crucible_hot_fork_begin_child_resource_plan(
+            &resources, &operation->plugin_resources);
+    }
+    if (result == 0) {
+        step++;
+        result = qemu_crucible_hot_fork_merge_diagnostics_child_resources(
+            &resources, &operation->diagnostics_resources);
+    }
+    if (result == 0) {
+        step++;
+        result = qemu_crucible_hot_fork_merge_qmp_child_resources(
+            &resources, &operation->qmp_resources);
+    }
+    if (result == 0) {
+        step++;
+        result = qemu_crucible_hot_fork_merge_console_child_resources(
+            &resources, &operation->console_resources);
+    }
+    if (result == 0) {
+        step++;
+        result = qemu_crucible_hot_fork_complete_child_resource_plan(
+            &resources, &descriptors, operation->excluded_fds,
+            operation->excluded_fd_count, &proof);
+    }
+    if (result == 0) {
+        step++;
+        result = qemu_crucible_hot_fork_apply_child_runtime_resource_plan(
+            &resources, &descriptors, &operation->runtime,
+            qemu_crucible_hot_fork_verify_child_descriptor_table, &proof,
+            &operation->plugin_reinitializer,
+            &operation->qmp_reinitializer,
+            &operation->console_reinitializer);
+    }
+    if (result == 0) {
+        step++;
+        result = qemu_crucible_hot_fork_activate_plugin_child(
+            &operation->plugin_reinitializer);
+    }
+    if (result == 0) {
+        step++;
+        /*
+         * The vCPU thread vanished with the parent while parked at the
+         * retained VM-stop boundary.  Restart it once the plugin child is
+         * active, so its idle/resume callbacks have a target, and before the
+         * block barrier releases; it parks again on the inherited stop.
+         */
+        result = cpus_hot_fork_restart_vcpu_threads();
+    }
+    if (result == 0) {
+        step++;
+        if (!qemu_block_backend_hot_fork_barrier(
+                QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_RELEASE, &block) ||
+            block.held || block.snapshot_bound) {
+            result = -EPROTO;
+        }
+    }
+    qemu_block_backend_hot_fork_barrier_inventory_destroy(&block);
+    if (result != 0) {
+        crucible_hot_fork_child_exit_at(step, result);
+    }
+    if (crucible_hot_fork_child_files_plan) {
+        /* Adoption consumes both the inherited plan and the source set. */
+        if (!qemu_block_hot_fork_child_files_install(
+                crucible_hot_fork_child_files_plan, &child_error)) {
+            crucible_hot_fork_child_report_error("install child files",
+                                                 child_error);
+            crucible_hot_fork_child_exit_at(13, -EPROTO);
+        }
+        crucible_hot_fork_child_files_plan = NULL;
+        operation->child_files = NULL;
+    } else if (!qemu_block_hot_fork_source_set_release_external_child(
+                   crucible_hot_fork_template_sources, &child_error)) {
+        crucible_hot_fork_child_report_error("release external child sources",
+                                             child_error);
+        crucible_hot_fork_child_exit_at(14, -EPROTO);
+    }
+    crucible_hot_fork_template_sources = NULL;
+    /* Inherited destination duplicates were closed by descriptor disposition. */
+    crucible_hot_fork_child_files_stage_clear(false);
+
+    crucible_hot_fork_child_resource_plan = resources;
+    crucible_hot_fork_plugin_child_reinitializer =
+        operation->plugin_reinitializer;
+    crucible_hot_fork_qmp_child_basis = operation->monitor_basis;
+    crucible_hot_fork_qmp_child_reinitializer =
+        operation->qmp_reinitializer;
+    crucible_hot_fork_qmp_child_reinitializer.runtime_opaque =
+        &crucible_hot_fork_qmp_child_basis;
+    crucible_hot_fork_console_child_basis = operation->console_basis;
+    crucible_hot_fork_console_child_reinitializer =
+        operation->console_reinitializer;
+    crucible_hot_fork_console_child_reinitializer.runtime_opaque =
+        &crucible_hot_fork_console_child_basis;
+    g_clear_pointer(&crucible_hot_fork_template_snapshot_bindings, g_free);
+    crucible_hot_fork_template_snapshot_binding_count = 0;
+    crucible_hot_fork_template_active = false;
+    crucible_hot_fork_template_abort_requested = false;
+    crucible_hot_fork_template_block_transition_scheduled = false;
+    crucible_hot_fork_template_phase =
+        CRUCIBLE_HOT_FORK_TEMPLATE_PHASE_IDLE;
+    crucible_hot_fork_operation_active = false;
+    crucible_hot_fork_child_active = true;
+    operation->prepared = false;
+
+    result = monitor_hot_fork_release_child_protocol_input(
+        &crucible_hot_fork_qmp_child_basis);
+    if (result != 0) {
+        crucible_hot_fork_child_exit_at(15, result);
+    }
+    return 0;
+}
+
+CrucibleHotForkState *qmp_crucible_hot_fork(
+    uint64_t template_generation, uint64_t private_ring_generation,
+    uint64_t diagnostic_generation, uint64_t qmp_generation,
+    uint64_t console_generation,
+    uint64_t monitor_generation, uint64_t plugin_endpoint_generation,
+    uint64_t plugin_barrier_generation, uint64_t rcu_barrier_generation,
+    uint64_t async_worker_barrier_generation,
+    uint64_t block_barrier_generation,
+    uint64_t parent_process_generation, uint64_t child_process_generation,
+    uint64_t child_process_contract_generation,
+    uint64_t child_files_generation,
+    Error **errp)
+{
+    CrucibleHotForkOperation operation = {
+        .template_generation = template_generation,
+        .private_ring_generation = private_ring_generation,
+        .diagnostic_generation = diagnostic_generation,
+        .qmp_generation = qmp_generation,
+        .console_generation = console_generation,
+        .monitor_generation = monitor_generation,
+        .plugin_endpoint_generation = plugin_endpoint_generation,
+        .plugin_barrier_generation = plugin_barrier_generation,
+        .rcu_barrier_generation = rcu_barrier_generation,
+        .async_worker_barrier_generation = async_worker_barrier_generation,
+        .block_barrier_generation = block_barrier_generation,
+        .parent_process_generation = parent_process_generation,
+        .child_process_generation = child_process_generation,
+        .child_process_contract_generation =
+            child_process_contract_generation,
+        .child_files_generation = child_files_generation,
+        .child_process_cgroup_fd = -1,
+        .child_process_cgroup_procs_fd = -1,
+        .child_process_cancellation_fd = -1,
+        .parent_identity = { .parent_pid = -1, .parent_pidfd = -1 },
+    };
+    QemuCrucibleHotForkMainLoopOperation request = {
+        .prepare = crucible_hot_fork_prepare_operation,
+        .parent = crucible_hot_fork_finish_parent_operation,
+        .child = crucible_hot_fork_finish_child_operation,
+        .opaque = &operation,
+        .child_cgroup_fd = -1,
+        .child_cgroup_procs_fd = -1,
+    };
+    CrucibleHotForkState *report;
+    pid_t child_pid = -1;
+    int result;
+
+    g_mutex_lock(&crucible_hot_fork_template_lock);
+    if (crucible_hot_fork_operation_active) {
+        g_mutex_unlock(&crucible_hot_fork_template_lock);
+        error_setg(errp, "A Crucible hot-fork operation is already active");
+        return NULL;
+    }
+    if (child_process_contract_generation == 0 ||
+        child_process_contract_generation !=
+            crucible_hot_fork_child_process_contract_stage.generation ||
+        !crucible_hot_fork_child_process_contract_bound()) {
+        g_mutex_unlock(&crucible_hot_fork_template_lock);
+        error_setg(errp, "Crucible hot fork requires the exact staged "
+                   "one-shot child process contract");
+        return NULL;
+    }
+    /*
+     * This command runs on the monitor thread under its recursive parser
+     * lock, which the main-loop preparation cannot take.  Verify the child
+     * monitor basis here, where the recursive lock succeeds, and carry the
+     * verdict; the monitor thread then blocks inside this command, so no
+     * monitor state can change before preparation consumes it.
+     */
+    if (!monitor_hot_fork_child_basis_matches_current(
+            &crucible_hot_fork_qmp_child_basis, monitor_generation)) {
+        g_mutex_unlock(&crucible_hot_fork_template_lock);
+        error_setg(errp, "Crucible hot fork requires the exact staged child "
+                   "monitor basis");
+        return NULL;
+    }
+    operation.monitor_basis_verified = true;
+    request.child_cgroup_fd =
+        crucible_hot_fork_child_process_contract_stage.cgroup_fd;
+    request.child_cgroup_procs_fd =
+        crucible_hot_fork_child_process_contract_stage.cgroup_procs_fd;
+    crucible_hot_fork_operation_active = true;
+    g_mutex_unlock(&crucible_hot_fork_template_lock);
+
+    result = qemu_crucible_hot_fork_main_loop_fork(
+        &request, child_process_contract_generation, &child_pid);
+
+    g_mutex_lock(&crucible_hot_fork_template_lock);
+    if (child_pid > 0) {
+        crucible_hot_fork_child_process_contract_stage.consumed = true;
+        if (crucible_hot_fork_child_files_stage.staged) {
+            crucible_hot_fork_child_files_stage.consumed = true;
+        }
+    }
+    crucible_hot_fork_operation_active = false;
+    g_mutex_unlock(&crucible_hot_fork_template_lock);
+    if (child_pid <= 0) {
+        error_setg_errno(errp, result < 0 ? -result : EPROTO,
+                         "Could not complete Crucible hot-fork preparation: %s",
+                         operation.blocker ? operation.blocker :
+                             "runtime transaction or process creation failed");
+        return NULL;
+    }
+
+    report = g_new0(CrucibleHotForkState, 1);
+    report->schema_version = 3;
+    report->outcome = result == 0 ?
+        CRUCIBLE_HOT_FORK_OUTCOME_FORKED :
+        CRUCIBLE_HOT_FORK_OUTCOME_PARENT_DISPOSITION_FAILED;
+    report->parent_status = result;
+    report->child_pid = child_pid;
+    report->template_generation = template_generation;
+    report->private_ring_generation = private_ring_generation;
+    report->diagnostic_generation = diagnostic_generation;
+    report->qmp_generation = qmp_generation;
+    report->console_generation = console_generation;
+    report->monitor_generation = monitor_generation;
+    report->plugin_endpoint_generation = plugin_endpoint_generation;
+    report->plugin_barrier_generation = plugin_barrier_generation;
+    report->rcu_barrier_generation = rcu_barrier_generation;
+    report->async_worker_barrier_generation = async_worker_barrier_generation;
+    report->block_barrier_generation = block_barrier_generation;
+    report->parent_process_generation = parent_process_generation;
+    report->child_process_generation = child_process_generation;
+    report->child_process_contract_generation =
+        child_process_contract_generation;
+    report->child_files_generation = child_files_generation;
+    return report;
+}
+
+static CrucibleHotForkChildProcessContractState *
+crucible_hot_fork_child_process_contract_report(void)
+{
+    CrucibleHotForkChildProcessContractStage *stage =
+        &crucible_hot_fork_child_process_contract_stage;
+    CrucibleHotForkChildProcessContractState *report =
+        g_new0(CrucibleHotForkChildProcessContractState, 1);
+
+    report->schema_version = 2;
+    report->generation = stage->generation;
+    report->template_generation = stage->template_generation;
+    report->staged = stage->staged;
+    report->consumed = stage->consumed;
+    if (stage->staged) {
+        report->cgroup_fdname = g_strdup(stage->cgroup_fdname);
+        report->cgroup_procs_fdname = g_strdup(stage->cgroup_procs_fdname);
+        report->cancellation_fdname = g_strdup(stage->cancellation_fdname);
+    }
+    report->cgroup_device = stage->cgroup_device;
+    report->cgroup_inode = stage->cgroup_inode;
+    report->cgroup_procs_inode = stage->cgroup_procs_inode;
+    report->cancellation_eventfd_id = stage->cancellation_eventfd_id;
+    report->maximum_file_bytes = stage->maximum_file_bytes;
+    report->cgroup_placement_bound = stage->staged;
+    return report;
+}
+
+static bool crucible_hot_fork_child_process_contract_matches(
+    const char *cgroup_fdname, const char *cgroup_procs_fdname,
+    const char *cancellation_fdname,
+    uint64_t cgroup_device, uint64_t cgroup_inode,
+    uint64_t cgroup_procs_inode,
+    uint64_t cancellation_eventfd_id, uint64_t maximum_file_bytes)
+{
+    CrucibleHotForkChildProcessContractStage *stage =
+        &crucible_hot_fork_child_process_contract_stage;
+
+    return stage->staged && cgroup_fdname && cgroup_procs_fdname &&
+        cancellation_fdname &&
+        strcmp(stage->cgroup_fdname, cgroup_fdname) == 0 &&
+        strcmp(stage->cgroup_procs_fdname, cgroup_procs_fdname) == 0 &&
+        strcmp(stage->cancellation_fdname, cancellation_fdname) == 0 &&
+        stage->cgroup_device == cgroup_device &&
+        stage->cgroup_inode == cgroup_inode &&
+        stage->cgroup_procs_inode == cgroup_procs_inode &&
+        stage->cancellation_eventfd_id == cancellation_eventfd_id &&
+        stage->maximum_file_bytes == maximum_file_bytes;
+}
+
+CrucibleHotForkChildProcessContractState *
+qmp_crucible_hot_fork_child_process_contract(
+    CrucibleHotForkChildProcessContractAction action,
+    const char *cgroup_fdname, const char *cgroup_procs_fdname,
+    const char *cancellation_fdname,
+    bool has_expected_cgroup_device, uint64_t expected_cgroup_device,
+    bool has_expected_cgroup_inode, uint64_t expected_cgroup_inode,
+    bool has_expected_cgroup_procs_inode,
+    uint64_t expected_cgroup_procs_inode,
+    bool has_expected_cancellation_eventfd_id,
+    uint64_t expected_cancellation_eventfd_id,
+    bool has_maximum_file_bytes, uint64_t maximum_file_bytes,
+    Error **errp)
+{
+    CrucibleHotForkChildProcessContractStage *stage =
+        &crucible_hot_fork_child_process_contract_stage;
+    CrucibleHotForkChildProcessContractState *report = NULL;
+    CrucibleHotForkPluginBarrierState *plugin_barrier = NULL;
+    struct rlimit file_limit;
+    uint64_t observed_device = 0;
+    uint64_t observed_inode = 0;
+    uint64_t observed_procs_inode = 0;
+    uint64_t observed_eventfd_id = 0;
+    int cgroup_candidate = -1;
+    int cgroup_procs_candidate = -1;
+    int cancellation_candidate = -1;
+
+    g_mutex_lock(&crucible_hot_fork_template_lock);
+    switch (action) {
+    case CRUCIBLE_HOT_FORK_CHILD_PROCESS_CONTRACT_ACTION_STAGE:
+        if (!cgroup_fdname || !cgroup_procs_fdname || !cancellation_fdname ||
+            strcmp(cgroup_fdname, cancellation_fdname) == 0 ||
+            strcmp(cgroup_fdname, cgroup_procs_fdname) == 0 ||
+            strcmp(cgroup_procs_fdname, cancellation_fdname) == 0 ||
+            !crucible_hot_fork_private_ring_fd_name_valid(cgroup_fdname) ||
+            !crucible_hot_fork_private_ring_fd_name_valid(
+                cgroup_procs_fdname) ||
+            !crucible_hot_fork_private_ring_fd_name_valid(
+                cancellation_fdname) ||
+            !has_expected_cgroup_device || expected_cgroup_device == 0 ||
+            !has_expected_cgroup_inode || expected_cgroup_inode == 0 ||
+            !has_expected_cgroup_procs_inode ||
+            expected_cgroup_procs_inode == 0 ||
+            !has_expected_cancellation_eventfd_id ||
+            expected_cancellation_eventfd_id == 0 ||
+            !has_maximum_file_bytes || maximum_file_bytes == 0 ||
+            maximum_file_bytes == UINT64_MAX) {
+            error_setg(errp, "Crucible hot-fork child process contract "
+                       "requires one exact bounded descriptor basis");
+            goto out;
+        }
+        if (!crucible_hot_fork_template_active) {
+            error_setg(errp, "Crucible hot-fork child process contract "
+                       "requires an active retained template");
+            goto out;
+        }
+        if (!crucible_hot_fork_resource_stage_allowed(
+                &plugin_barrier, errp)) {
+            goto out;
+        }
+        if (getrlimit(RLIMIT_FSIZE, &file_limit) < 0) {
+            error_setg_errno(errp, errno,
+                             "Could not inspect QEMU file-size limit");
+            goto out;
+        }
+        if (file_limit.rlim_max != RLIM_INFINITY &&
+            maximum_file_bytes > file_limit.rlim_max) {
+            error_setg(errp, "Crucible hot-fork child file-size ceiling "
+                       "exceeds the source QEMU hard limit");
+            goto out;
+        }
+        cgroup_candidate = monitor_dup_fd(
+            monitor_cur(), cgroup_fdname, errp);
+        if (cgroup_candidate < 0) {
+            goto out;
+        }
+        cgroup_procs_candidate = monitor_dup_fd(
+            monitor_cur(), cgroup_procs_fdname, errp);
+        if (cgroup_procs_candidate < 0) {
+            goto out;
+        }
+        cancellation_candidate = monitor_dup_fd(
+            monitor_cur(), cancellation_fdname, errp);
+        /*
+         * Socket receive clears O_NONBLOCK on every SCM_RIGHTS descriptor,
+         * and that flag lives on the open file description the host still
+         * shares for its own sticky-cancellation polling.  Restore it before
+         * authenticating so both processes keep the nonblocking contract.
+         */
+        if (cancellation_candidate >= 0 &&
+            !qemu_set_blocking(cancellation_candidate, false, errp)) {
+            goto out;
+        }
+        if (cancellation_candidate < 0 ||
+            !crucible_hot_fork_cgroup_directory_identity(
+                cgroup_candidate, &observed_device, &observed_inode, errp) ||
+            !crucible_hot_fork_cgroup_procs_identity(
+                cgroup_procs_candidate, cgroup_candidate,
+                &observed_procs_inode, errp) ||
+            !crucible_hot_fork_nonblocking_eventfd_identity(
+                cancellation_candidate, &observed_eventfd_id, errp)) {
+            goto out;
+        }
+        if (observed_device != expected_cgroup_device ||
+            observed_inode != expected_cgroup_inode ||
+            observed_procs_inode != expected_cgroup_procs_inode ||
+            observed_eventfd_id != expected_cancellation_eventfd_id) {
+            error_setg(errp, "Crucible hot-fork child process contract "
+                       "descriptor identity mismatch");
+            goto out;
+        }
+        if (stage->staged) {
+            if (!crucible_hot_fork_child_process_contract_matches(
+                    cgroup_fdname, cgroup_procs_fdname, cancellation_fdname,
+                    expected_cgroup_device, expected_cgroup_inode,
+                    expected_cgroup_procs_inode,
+                    expected_cancellation_eventfd_id,
+                    maximum_file_bytes) || stage->consumed ||
+                stage->template_generation !=
+                    crucible_hot_fork_template_generation) {
+                error_setg(errp, "Different or consumed Crucible hot-fork "
+                           "child process contract is already staged");
+                goto out;
+            }
+            report = crucible_hot_fork_child_process_contract_report();
+            goto out;
+        }
+        if (stage->generation == UINT64_MAX) {
+            error_setg(errp, "Crucible hot-fork child process contract "
+                       "generation is exhausted");
+            goto out;
+        }
+        stage->staged = true;
+        stage->consumed = false;
+        stage->cgroup_fd = cgroup_candidate;
+        cgroup_candidate = -1;
+        stage->cgroup_procs_fd = cgroup_procs_candidate;
+        cgroup_procs_candidate = -1;
+        stage->cancellation_fd = cancellation_candidate;
+        cancellation_candidate = -1;
+        stage->cgroup_fdname = g_strdup(cgroup_fdname);
+        stage->cgroup_procs_fdname = g_strdup(cgroup_procs_fdname);
+        stage->cancellation_fdname = g_strdup(cancellation_fdname);
+        stage->cgroup_device = expected_cgroup_device;
+        stage->cgroup_inode = expected_cgroup_inode;
+        stage->cgroup_procs_inode = expected_cgroup_procs_inode;
+        stage->cancellation_eventfd_id =
+            expected_cancellation_eventfd_id;
+        stage->maximum_file_bytes = maximum_file_bytes;
+        stage->template_generation = crucible_hot_fork_template_generation;
+        stage->generation++;
+        report = crucible_hot_fork_child_process_contract_report();
+        break;
+    case CRUCIBLE_HOT_FORK_CHILD_PROCESS_CONTRACT_ACTION_QUERY:
+        if (cgroup_fdname || cgroup_procs_fdname || cancellation_fdname ||
+            has_expected_cgroup_device || has_expected_cgroup_inode ||
+            has_expected_cgroup_procs_inode ||
+            has_expected_cancellation_eventfd_id || has_maximum_file_bytes) {
+            error_setg(errp, "Crucible hot-fork child process contract query "
+                       "accepts no descriptor basis");
+            goto out;
+        }
+        report = crucible_hot_fork_child_process_contract_report();
+        break;
+    case CRUCIBLE_HOT_FORK_CHILD_PROCESS_CONTRACT_ACTION_RELEASE:
+        if (!cgroup_fdname || !cgroup_procs_fdname || !cancellation_fdname ||
+            !has_expected_cgroup_device || !has_expected_cgroup_inode ||
+            !has_expected_cgroup_procs_inode ||
+            !has_expected_cancellation_eventfd_id ||
+            !has_maximum_file_bytes ||
+            !crucible_hot_fork_child_process_contract_matches(
+                cgroup_fdname, cgroup_procs_fdname, cancellation_fdname,
+                expected_cgroup_device, expected_cgroup_inode,
+                expected_cgroup_procs_inode,
+                expected_cancellation_eventfd_id, maximum_file_bytes)) {
+            error_setg(errp, "Crucible hot-fork child process contract "
+                       "release requires the exact retained basis");
+            goto out;
+        }
+        if (crucible_hot_fork_operation_active) {
+            error_setg(errp, "Cannot release a child process contract during "
+                       "a hot-fork operation");
+            goto out;
+        }
+        close(stage->cgroup_fd);
+        close(stage->cgroup_procs_fd);
+        close(stage->cancellation_fd);
+        g_clear_pointer(&stage->cgroup_fdname, g_free);
+        g_clear_pointer(&stage->cgroup_procs_fdname, g_free);
+        g_clear_pointer(&stage->cancellation_fdname, g_free);
+        stage->staged = false;
+        stage->consumed = false;
+        stage->cgroup_fd = -1;
+        stage->cgroup_procs_fd = -1;
+        stage->cancellation_fd = -1;
+        stage->cgroup_device = 0;
+        stage->cgroup_inode = 0;
+        stage->cgroup_procs_inode = 0;
+        stage->cancellation_eventfd_id = 0;
+        stage->maximum_file_bytes = 0;
+        stage->template_generation = 0;
+        report = crucible_hot_fork_child_process_contract_report();
+        break;
+    default:
+        g_assert_not_reached();
+    }
+out:
+    close(cgroup_candidate);
+    close(cgroup_procs_candidate);
+    close(cancellation_candidate);
+    g_free(plugin_barrier);
+    g_mutex_unlock(&crucible_hot_fork_template_lock);
+    return report;
+}
