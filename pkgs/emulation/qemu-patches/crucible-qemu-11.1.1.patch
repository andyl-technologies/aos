+out:
+    if (file) {
+        qemu_fclose(file);
+    }
+    if (channel) {
+        object_unref(OBJECT(channel));
+    }
+    if (writer_fd >= 0) {
+        close(writer_fd);
+    }
+    if (fd >= 0) {
+        close(fd);
+    }
+    if (status != 0) {
+        memset(digest_out, 0, 32);
+        *bytes_out = 0;
+    }
+    return status;
+}
