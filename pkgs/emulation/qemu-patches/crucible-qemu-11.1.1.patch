+int qemu_plugin_crucible_callback_child_storage_return_v1(
+    qemu_plugin_id_t id, QemuCrucibleCallbackChildStorage **holder)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *registry = &startup_source.commands;
+    QemuCrucibleCallbackChildStorage *child = &registry->child;
+    int (*destructor)(qemu_plugin_id_t, QemuCrucibleCallbackChildStorage *,
+                      void *, size_t, size_t);
+    QemuThread thread;
+    void *address;
+    size_t extent;
+    size_t alignment;
+    bool needs_destruction;
+    bool already_freed;
+    int first = command_registry_identity(id);
+    int post = 0;
