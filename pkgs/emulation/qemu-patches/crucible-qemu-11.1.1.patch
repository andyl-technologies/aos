+void rr_crucible_sim_publish_time_advance_wake(void)
+{
+    CPUState *cpu;
+    CPUState *selected;
+    unsigned int claimed_state;
+
+    if (!rr_crucible_sim_mode()) {
+        return;
+    }
+    g_assert(bql_locked());
+    g_assert(first_cpu);
+
+    /*
+     * The time-advance fence remains armed through the RR settle marker.  The
+     * claimed-state assertion below proves that this finalizer publishes only
+     * from the resulting idle lifecycle state.  Publish a durable generation
+     * without fabricating CPU exit requests that could survive into the next
+     * turn; after release, the finalizer signals both possible RR wait objects.
+     */
+    while (!rr_crucible_sim_wake_try_claim(&rr_tcg_exec_state,
+                                            &claimed_state)) {
+        cpu_relax();
+    }
+    g_assert(rr_crucible_sim_time_advance_wake_can_publish(claimed_state));
+
+    /*
+     * Timer callbacks can make a different halted vCPU runnable while the
+     * advance is fenced. Select that owner, then retire every request exit
+     * left by the completed dispatch before publishing its wake. A concurrent
+     * generic kick that set an exit before claiming this epoch republishes it
+     * after the epoch is released.
+     */
+    selected = icount_crucible_rr_select_cpu(first_cpu);
+    g_assert(selected);
+    CPU_FOREACH(cpu) {
+        rr_crucible_sim_reset_exit_request(cpu);
+    }
+    rr_crucible_sim_wake_publish(
+        &rr_tcg_exec_state, claimed_state, &rr_wake_publish_generation);
+}
+
+void rr_crucible_sim_signal_time_advance_wake(void)
+{
+    if (!rr_crucible_sim_mode()) {
+        return;
+    }
+    g_assert(bql_locked());
+    g_assert(first_cpu);
+
+    qemu_cond_broadcast(first_cpu->halt_cond);
+    rr_crucible_sim_notify_dispatch_ceiling();
+}
