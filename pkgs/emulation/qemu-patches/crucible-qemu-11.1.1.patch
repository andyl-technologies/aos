+void qmp_stop(Error **errp)
+{
+    int status;
+
+    /* if there is a dump in background, we should wait until the dump
+     * finished */
+    if (qemu_system_dump_in_progress()) {
+        error_setg(errp, "There is a dump in process, please wait.");
+        return;
+    }
+
+    if (runstate_check(RUN_STATE_INMIGRATE)) {
+        autostart = 0;
+    } else {
+        status = vm_stop(RUN_STATE_PAUSED);
+        if (status == 0) {
+            status = qemu_plugin_crucible_vmstop_flush_status();
+        }
+        if (status < 0) {
+            error_setg_errno(errp, -status,
+                             "Could not flush devices while stopping the VM");
+        }
+    }
+}
