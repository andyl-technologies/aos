+__int128 riscv_time_ps_to_ticks(__int128 time_ps, uint32_t frequency)
+{
+    __int128 seconds = time_ps / PICOSECONDS_PER_SECOND;
+    __int128 phase_ps = time_ps % PICOSECONDS_PER_SECOND;
+
+    if (phase_ps < 0) {
+        seconds--;
+        phase_ps += PICOSECONDS_PER_SECOND;
+    }
+    return seconds * frequency +
+           phase_ps * frequency / PICOSECONDS_PER_SECOND;
