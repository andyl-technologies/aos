+int qemu_plugin_crucible_startup_hello_write_v1(
+    qemu_plugin_id_t id, QemuCrucibleSetupHandshakeOwner **out)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleSetupHandshakeOwner *owner = &startup_source.setup_handshake;
+    QemuCruciblePreexecPeerObservation peer;
+    int status;
+
+    if (!startup_invocation(id)) {
+        return -EPERM;
+    }
+    if (!out || *out || owner->attempted) {
+        return -EINVAL;
+    }
+    status = startup_active(id);
+    if (!status &&
+        (!startup_source.checkpoint_storage.fixed_charge.held ||
+         startup_source.checkpoint_storage.issuer != startup_source.preexec_purpose_owner ||
+         !qatomic_load_acquire(&startup_source.custody_retained) ||
+         !qatomic_load_acquire(&startup_source.process_purpose_complete) ||
+         startup_source.metadata_partition.fixed_native_extent !=
+             qemu_crucible_startup_source_fixed_control_extent())) {
+        status = -ENOKEY;
+    }
+    if (!status) {
+        status = qemu_crucible_preexec_peer_observe_v3(
+            startup_source.preexec_purpose_owner, &peer);
+    }
+    if (!status) {
+        status = startup_process_purpose_live();
+    }
+    if (status) {
+        return status;
+    }
+    if (startup_source.standing.operation.held) {
+        return -EBUSY;
+    }
+    if (startup_source.standing.construction.operation.held &&
+        (!standing_construction_operation_identity() ||
+         startup_source.standing.construction.operation.class_index != 0)) {
+        return -EPERM;
+    }
+    *owner = (QemuCrucibleSetupHandshakeOwner) {
+        .issuer = startup_source.preexec_purpose_owner,
+        .installer = startup_source.saved,
+        .holder = &owner->creation_owner,
+        .peer = peer,
+        .control_device = startup_source.control_device,
+        .control_inode = startup_source.control_inode,
+        .fixed_native_extent = startup_source.metadata_partition.fixed_native_extent,
+        .process_generation = startup_source.original.process_generation,
+        .account_generation = startup_source.standing.initial.account_generation,
+        .process = getpid(),
+        .descriptor = QEMU_CRUCIBLE_PREEXEC_SETUP_CONTROL_FD,
+        .attempted = true,
+        .held = true,
+    };
+    if (standing_construction_operation_identity()) {
+        owner->construction_operation = &startup_source.standing.construction.operation;
+        owner->operation_serial = owner->construction_operation->serial;
+    }
+    owner->creation_owner = owner;
+    *out = owner;
+    stl_be_p(owner->hello, 9);
+    owner->hello[4] = 0xf0;
+    stl_be_p(owner->hello + 5, 8);
+    stl_be_p(owner->hello + 9, CRUCIBLE_SHMEM_ABI_VERSION);
+    owner->write_active = true;
+    while (owner->write_cursor < sizeof(owner->hello)) {
+        ssize_t result;
+        int saved_errno;
+        int first = 0;
+        size_t remaining = sizeof(owner->hello) - owner->write_cursor;
+
+        status = setup_handshake_exchange_current(id, owner);
+        if (status) {
+            break;
+        }
+        owner->io_active = true;
+        result = send(owner->descriptor, owner->hello + owner->write_cursor,
+                      remaining,
+                      MSG_DONTWAIT | MSG_NOSIGNAL);
+        saved_errno = result < 0 ? errno : 0;
+        owner->last_io_status = result < 0 ? -saved_errno : 0;
+        if (result > 0 && (uint64_t)result <= remaining) {
+            owner->write_cursor += result;
+        } else if (result == 0 || (result > 0 && (uint64_t)result > remaining)) {
+            first = -EIO;
+        } else if (saved_errno != EINTR && saved_errno != EAGAIN &&
+                   saved_errno != EWOULDBLOCK) {
+            first = -saved_errno;
+        }
+        if (first && !owner->first_status) {
+            owner->first_status = first;
+        }
+        status = setup_handshake_original_current(owner, NULL);
+        setup_handshake_record_post(owner, status, false);
+        owner->io_active = false;
+        if (first) {
+            status = first;
+            break;
+        }
+        if (status) {
+            break;
+        }
+        if (result < 0 && (saved_errno == EAGAIN || saved_errno == EWOULDBLOCK)) {
+            status = setup_handshake_wait(owner, POLLOUT);
+            if (status) {
+                break;
+            }
+        }
+        /* EINTR retries only this unchanged remaining cursor. */
+    }
+    owner->write_completed = owner->write_cursor == sizeof(owner->hello);
+    owner->write_active = false;
+    return setup_handshake_phase_post(owner, status, false);
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_startup_hello_ack_read_v1(
+    qemu_plugin_id_t id, QemuCrucibleSetupHandshakeOwner *owner)
+{
+#ifdef CONFIG_LINUX
+    int status = setup_handshake_identity(id, owner);
+
+    if (status) {
+        return status;
+    }
+    if (!startup_invocation(id)) {
+        return -EPERM;
+    }
+    if (owner->read_active || owner->write_active || owner->read_post_recorded ||
+        !owner->write_completed || !owner->write_post_recorded ||
+        owner->first_status || owner->write_post) {
+        return -EBUSY;
+    }
+    owner->read_active = true;
+    while (owner->read_cursor < sizeof(owner->reply)) {
+        ssize_t result;
+        int saved_errno;
+        int first = 0;
+        size_t remaining = sizeof(owner->reply) - owner->read_cursor;
+
+        status = setup_handshake_exchange_current(id, owner);
+        if (status) {
+            break;
+        }
+        /* This later phase forbids ancillary imports. A zero control buffer
+         * leaves no destination for descriptors; Linux reports discarded
+         * ancillary data through MSG_CTRUNC. Keep the message and vector in
+         * the same prebirth-paid Source holder as the remaining byte cursor. */
+        owner->receive_vector = (struct iovec) {
+            .iov_base = owner->reply + owner->read_cursor,
+            .iov_len = remaining,
+        };
+        owner->receive_message = (struct msghdr) {
+            .msg_iov = &owner->receive_vector,
+            .msg_iovlen = 1,
+            .msg_control = NULL,
+            .msg_controllen = 0,
+        };
+        owner->io_active = true;
+        result = recvmsg(owner->descriptor, &owner->receive_message, MSG_DONTWAIT);
+        saved_errno = result < 0 ? errno : 0;
+        owner->last_io_status = result < 0 ? -saved_errno : 0;
+        if (result > 0 && (uint64_t)result <= remaining) {
+            owner->read_cursor += result;
+        } else if (result == 0 || (result > 0 && (uint64_t)result > remaining)) {
+            first = -EPIPE;
+        } else if (saved_errno != EINTR && saved_errno != EAGAIN &&
+                   saved_errno != EWOULDBLOCK) {
+            first = -saved_errno;
+        }
+        /* Consumed bytes stay consumed even when the accompanying control
+         * data is forbidden. Do not inspect or retry any discarded rights. */
+        if (result >= 0 &&
+            (owner->receive_message.msg_flags & (MSG_CTRUNC | MSG_TRUNC) ||
+             owner->receive_message.msg_controllen != 0)) {
+            first = -EPROTO;
+        }
+        if (first && !owner->first_status) {
+            owner->first_status = first;
+        }
+        status = setup_handshake_original_current(owner, NULL);
+        setup_handshake_record_post(owner, status, false);
+        owner->io_active = false;
+        if (first) {
+            status = first;
+            break;
+        }
+        if (status) {
+            break;
+        }
+        if (result < 0 && (saved_errno == EAGAIN || saved_errno == EWOULDBLOCK)) {
+            status = setup_handshake_wait(owner, POLLIN);
+            if (status) {
+                break;
+            }
+        }
+    }
+    owner->read_completed = owner->read_cursor == sizeof(owner->reply);
+    if (!status && owner->read_completed) {
+        if (ldl_be_p(owner->reply) != 17 || owner->reply[4] != 0xf1 ||
+            ldl_be_p(owner->reply + 5) != 8 ||
+            ldl_be_p(owner->reply + 9) != CRUCIBLE_SHMEM_ABI_VERSION ||
+            !ldl_be_p(owner->reply + 17) ||
+            ldl_be_p(owner->reply + 17) > CRUCIBLE_SHMEM_MAX_NODES ||
+            ldl_be_p(owner->reply + 13) >= ldl_be_p(owner->reply + 17)) {
+            status = -EPROTO;
+        } else {
+            owner->reply_validated = true;
+        }
+    }
+    owner->read_active = false;
+    return setup_handshake_phase_post(owner, status, true);
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_startup_hello_observe_v1(
+    qemu_plugin_id_t id, QemuCrucibleSetupHandshakeOwner *owner,
+    struct qemu_plugin_crucible_setup_handshake_status_v1 *out)
+{
+#ifdef CONFIG_LINUX
+    int status = setup_handshake_identity(id, owner);
+
+    if (status || !out) {
+        return status ? status : -EINVAL;
+    }
+    if (!startup_owner()) {
+        return -EPERM;
+    }
+    /* No installer clock is consulted. Actual complete byte disposition is
+     * observable even when its independent signed post refused admission. */
+    *out = (struct qemu_plugin_crucible_setup_handshake_status_v1) {
+        .schema_version = 1,
+        .struct_size = sizeof(*out),
+        .written_bytes = owner->write_cursor,
+        .read_bytes = owner->read_cursor,
+        .first_status = owner->first_status,
+        .write_post_status = owner->write_post,
+        .read_post_status = owner->read_post,
+        .io_post_status = owner->io_post_status,
+        .wait_post_status = owner->wait_post_status,
+        .last_io_status = owner->last_io_status,
+        .last_wait_status = owner->last_wait_status,
+        .write_completed = owner->write_completed,
+        .read_completed = owner->read_completed,
+        .reply_validated = owner->reply_validated,
+        .selected_slot = owner->reply_validated ? ldl_be_p(owner->reply + 13) : 0,
+        .node_count = owner->reply_validated ? ldl_be_p(owner->reply + 17) : 0,
+    };
+    return 0;
+#else
+    return -ENOTSUP;
+#endif
+}
