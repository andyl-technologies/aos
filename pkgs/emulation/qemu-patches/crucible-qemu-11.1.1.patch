+static void test_piix_southbridge_mutable_state(void)
+{
+    PIIXState first = { 0 };
+    PIIXState second = { 0 };
+    int32_t first_irq_levels[PIIX_NUM_PIRQS] = { 0 };
+    int32_t second_irq_levels[PIIX_NUM_PIRQS] = { 0 };
+    g_autoptr(GBytes) first_bytes = NULL;
+    g_autoptr(GBytes) second_bytes = NULL;
