+    ),
+    'nested leave debit': (
+        'record->ram_writer_nested_io_depth--;',
+        '(void)record->ram_writer_nested_io_depth;',
+    ),
+    'typed copied-debt prelock guards': (
+        '    if (ram_writer_record_inherited(qemu_hot_fork_current_thread)) {\n        return -ESTALE;\n    }',
+        '    (void)qemu_hot_fork_current_thread;',
+    ),
