+static int fingerprint_root_cleanup_cpu_begin(qemu_plugin_id_t id)
+{
+    struct QemuCrucibleFingerprintCleanupExecution *candidate = &fingerprint_cleanup;
+    QemuCrucibleFingerprintCompletionBinding *keeper = NULL;
+    int status;
+
+    if (candidate->held) {
+        if (candidate->id != id || candidate->operation != fingerprint_root_operation) {
+            return -EBUSY;
+        }
+    } else {
+        if (!fingerprint_root_outcome.original_recorded || !fingerprint_root_execution) {
+            return -EPERM;
+        }
+        status = qemu_crucible_startup_source_fingerprint_completion_borrow_v1(id, &keeper);
+        if (status) {
+            return status;
+        }
+        *candidate = (struct QemuCrucibleFingerprintCleanupExecution) {
+            .id = id,
+            .operation = fingerprint_root_operation,
+            .keeper = keeper,
+            .execution = fingerprint_root_execution,
+            .original = fingerprint_root_outcome.original,
+            .process = getpid(),
+            .frame_serial = fingerprint_root_frame.serial,
+            .held = true,
+        };
+        qemu_thread_get_self(&candidate->thread);
+    }
+    if (!candidate->cpu_closure) {
+        candidate->issuing = true;
+        status = qemu_crucible_observation_cleanup_cpu_acquire_v1(candidate, id,
+                                                               &candidate->cpu_closure);
+        candidate->issuing = false;
+        candidate->closure_status = status;
+        if (status || !candidate->cpu_closure) {
+            return status ? status : -EPROTO;
+        }
+    } else {
+        /* Retry ONLY the producer's journaled preactivation refusal on this
+         * same retained wrapper. An active Requested gate merely drains; it
+         * never re-enters or replaces its admission epoch/Original. */
+        status = qemu_crucible_observation_cleanup_cpu_retry_v1(
+            candidate, id, candidate->cpu_closure);
+        candidate->closure_retry_status = status;
+        if (status) {
+            return status;
+        }
+    }
+    status = qemu_crucible_ram_fingerprint_cleanup_execution_current_v1(candidate, id,
+                                                                      candidate->operation);
+    if (!status && !candidate->source_execution) {
+        status = qemu_crucible_startup_source_fingerprint_cleanup_bind_v1(
+            id, candidate->operation, candidate, &candidate->source_execution);
+        candidate->source_bind_status = status;
+    }
+    return status ? status : candidate->source_execution ? 0 : -EPROTO;
+}
