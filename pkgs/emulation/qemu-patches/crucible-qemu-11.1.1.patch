+int qemu_crucible_startup_source_publisher_receiver_identity_v1(
+    QemuCruciblePreexecPurposeOwner *issuer,
+    QemuCruciblePublisherSessionLender **holder, const void *child,
+    int returning, int *returned)
+{
+    QemuCrucibleCommandConsumerMember *member = &startup_source.command_member;
+
+    if (issuer != startup_source.preexec_purpose_owner ||
+        holder != &startup_source.publisher_lender ||
+        !startup_source.custody_retained || !startup_source.metadata_partition.published ||
+        !startup_source.checkpoint_storage.fixed_charge.held ||
+        startup_source.checkpoint_storage.issuer != issuer) {
+        return -EPERM;
