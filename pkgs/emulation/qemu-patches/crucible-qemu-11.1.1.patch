+
+#define TYPE_REGISTRY_TEST "physical-registry-test"
+#define TYPE_UNAUDITED_TEST "physical-unaudited-test"
+
+typedef struct RegistryTestDevice {
+    DeviceState parent_obj;
+    unsigned identifier;
+    int failure;
+    bool fail_realize;
+} RegistryTestDevice;
+
+static unsigned registry_order[8];
+static size_t registry_visits;
+
+static void registry_test_realize(DeviceState *device, Error **errp)
+{
+    RegistryTestDevice *test = (RegistryTestDevice *)device;
+
+    if (test->fail_realize) {
+        error_setg(errp, "deliberate realize failure");
+    }
+}
+
+static int registry_test_check(DeviceState *device, Error **errp)
+{
+    RegistryTestDevice *test = (RegistryTestDevice *)device;
+
+    g_assert_cmpuint(registry_visits, <, G_N_ELEMENTS(registry_order));
+    registry_order[registry_visits++] = test->identifier;
+    if (test->failure) {
+        error_setg(errp, "owner failure %u", test->identifier);
+    }
+    return test->failure;
+}
+
+static void registry_test_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *device_class = DEVICE_CLASS(klass);
+
+    device_class->realize = registry_test_realize;
+    qemu_crucible_ram_physical_owner_register(device_class, registry_test_check);
+}
+
+static void unaudited_test_class_init(ObjectClass *klass, const void *data)
+{
+    DEVICE_CLASS(klass)->realize = registry_test_realize;
+}
+
+static const TypeInfo registry_test_types[] = {
+    {
+        .name = TYPE_REGISTRY_TEST,
+        .parent = TYPE_DEVICE,
+        .instance_size = sizeof(RegistryTestDevice),
+        .class_init = registry_test_class_init,
+    }, {
+        .name = TYPE_UNAUDITED_TEST,
+        .parent = TYPE_DEVICE,
+        .instance_size = sizeof(RegistryTestDevice),
+        .class_init = unaudited_test_class_init,
+    },
+};
+
+static RegistryTestDevice *registry_test_new(unsigned identifier)
+{
+    RegistryTestDevice *test = (RegistryTestDevice *)object_new(TYPE_REGISTRY_TEST);
+
+    test->identifier = identifier;
+    return test;
+}
+
+static void registry_test_drop(RegistryTestDevice *test)
+{
+    if (test->parent_obj.realized) {
+        qdev_unrealize(DEVICE(test));
+    }
+    object_unparent(OBJECT(test));
+    object_unref(test);
+}
+
+static void registry_test_empty(void)
+{
+    uint64_t count = UINT64_MAX;
+    Error *error = NULL;
+
+    registry_visits = 0;
+    g_assert_cmpint(qemu_crucible_ram_physical_device_inventory(&count, &error),
+                    ==, 0);
+    g_assert_null(error);
+    g_assert_cmpuint(count, ==, 0);
+    g_assert_cmpuint(registry_visits, ==, 0);
+}
+
+static void test_registry_failed_realize(void)
+{
+    RegistryTestDevice *test = registry_test_new(1);
+    Error *error = NULL;
+
+    rust_bql_mock_lock();
+    test->fail_realize = true;
+    g_assert_false(qdev_realize(DEVICE(test), NULL, &error));
+    g_assert_false(test->parent_obj.realized);
+    g_assert_nonnull(error);
+    g_assert_cmpstr(error_get_pretty(error), ==, "deliberate realize failure");
+    error_free(error);
+
+    registry_test_empty();
+    registry_test_drop(test);
+}
+
+static void test_registry_unrealize_and_rerealize(void)
+{
+    RegistryTestDevice *first = registry_test_new(1);
+    RegistryTestDevice *second = registry_test_new(2);
+    uint64_t count = 0;
+    Error *error = NULL;
+
+    rust_bql_mock_lock();
+    qdev_realize(DEVICE(first), NULL, &error_fatal);
+    qdev_realize(DEVICE(second), NULL, &error_fatal);
+    qdev_unrealize(DEVICE(first));
