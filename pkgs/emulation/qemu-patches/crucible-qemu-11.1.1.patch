+        if (first || post) {
+            child->closing = false;
+        }
+        qemu_mutex_unlock(&registry->mutex);
+        if (first || post) {
+            /* Known destruction and its signed failure remain independent.
+             * Later allocation retirement skips drop. Unknown drop retains
+             * the owner forever unless a genuine same-owner proof joins it. */
+            return first ? first : post;
+        }
+    }
+    if (!already_freed) {
+        qemu_mutex_lock(&registry->mutex);
+        first = callback_child_identity_locked(child);
+        if (!first && (child->physical_users || child->publication_users ||
+                       child->registration_retained || registry->use.held ||
+                       child->free_attempted || (child->initialized && !child->destroyed))) {
+            first = -EBUSY;
+        }
