+int qemu_plugin_crucible_register_resource_manifest(
+    const struct qemu_plugin_crucible_resource_manifest *manifest)
+{
+    uint64_t optional_callbacks;
+    uint64_t observed_callbacks;
+    QEMU_LOCK_GUARD(&qemu_plugin_crucible_resource_lock);
+
+    observed_callbacks =
+        qemu_plugin_crucible_resource_inventory.observed_callback_mask;
+
+    if (!manifest ||
+        manifest->schema_version !=
+            QEMU_PLUGIN_CRUCIBLE_RESOURCE_MANIFEST_VERSION ||
+        manifest->struct_size != sizeof(*manifest) ||
+        manifest->process_generation == 0 || manifest->plugin_id == 0 ||
+        manifest->node_count == 0 ||
+        manifest->slot_index >= manifest->node_count ||
+        manifest->control_fd < 0 || manifest->wake_fd < 0 ||
+        manifest->control_fd == manifest->wake_fd ||
+        manifest->shmem_inode == 0 || manifest->shmem_length == 0 ||
+        (manifest->resource_mask & ~QEMU_PLUGIN_CRUCIBLE_RESOURCE_ALL) != 0 ||
+        (manifest->callback_mask & ~QEMU_PLUGIN_CRUCIBLE_CALLBACK_ALL) != 0 ||
+        (manifest->resource_mask & QEMU_PLUGIN_CRUCIBLE_RESOURCE_REQUIRED) !=
+            QEMU_PLUGIN_CRUCIBLE_RESOURCE_REQUIRED ||
+        (manifest->callback_mask & QEMU_PLUGIN_CRUCIBLE_CALLBACK_REQUIRED) !=
+            QEMU_PLUGIN_CRUCIBLE_CALLBACK_REQUIRED ||
+        (manifest->worker_mask & ~QEMU_PLUGIN_CRUCIBLE_WORKER_ALL) != 0 ||
+        (manifest->worker_mask & QEMU_PLUGIN_CRUCIBLE_WORKER_REQUIRED) !=
+            QEMU_PLUGIN_CRUCIBLE_WORKER_REQUIRED ||
+        (((manifest->worker_mask &
+           QEMU_PLUGIN_CRUCIBLE_WORKER_FINGERPRINT) != 0) !=
+         ((manifest->resource_mask &
+           QEMU_PLUGIN_CRUCIBLE_RESOURCE_FINGERPRINT) != 0))) {
+        return -EINVAL;
+    }
+    if (qemu_plugin_crucible_resource_inventory.registered) {
+        return memcmp(&qemu_plugin_crucible_resource_inventory.manifest,
+                      manifest, sizeof(*manifest)) == 0 ? 0 : -EALREADY;
+    }
+    if (qemu_plugin_crucible_callback_plugin_conflict ||
+        qemu_plugin_crucible_observed_plugin_id != manifest->plugin_id ||
+        qemu_plugin_wake_fd != manifest->wake_fd ||
+        observed_callbacks != manifest->callback_mask) {
+        error_report("Crucible resource manifest mismatch: conflict=%d "
+                     "observed_plugin=%" PRIu64 " manifest_plugin=%" PRIu64 " "
+                     "observed_wake=%d manifest_wake=%d "
+                     "observed_callbacks=%" PRIx64
+                     " manifest_callbacks=%" PRIx64,
+                     qemu_plugin_crucible_callback_plugin_conflict,
+                     qemu_plugin_crucible_observed_plugin_id,
+                     manifest->plugin_id, qemu_plugin_wake_fd,
+                     manifest->wake_fd,
+                     observed_callbacks, manifest->callback_mask);
+        return -EPROTO;
+    }
+
+    optional_callbacks = manifest->callback_mask &
+        ~QEMU_PLUGIN_CRUCIBLE_CALLBACK_REQUIRED;
+    if (((manifest->resource_mask &
+          (QEMU_PLUGIN_CRUCIBLE_RESOURCE_COVERAGE |
+           QEMU_PLUGIN_CRUCIBLE_RESOURCE_WHITEBOX)) != 0) !=
+        ((optional_callbacks &
+          QEMU_PLUGIN_CRUCIBLE_CALLBACK_TB_TRANSLATION) != 0) ||
+        ((manifest->resource_mask & QEMU_PLUGIN_CRUCIBLE_RESOURCE_COVERAGE) !=
+         0) !=
+        ((optional_callbacks & QEMU_PLUGIN_CRUCIBLE_CALLBACK_FLUSH) != 0)) {
+        return -EPROTO;
+    }
+
+    qemu_plugin_crucible_resource_inventory.manifest = *manifest;
+    qemu_plugin_crucible_resource_inventory.registered = true;
+    qemu_plugin_crucible_resource_inventory.complete = true;
+    qemu_plugin_crucible_resource_inventory.generation++;
+    return 0;
+}
+
+void qemu_plugin_crucible_hot_fork_inventory(
+    QemuPluginCrucibleHotForkInventory *inventory)
+{
+    QEMU_LOCK_GUARD(&qemu_plugin_crucible_resource_lock);
+
+    *inventory = qemu_plugin_crucible_resource_inventory;
+    inventory->complete = inventory->registered && inventory->complete &&
+        !qemu_plugin_crucible_callback_plugin_conflict &&
+        inventory->manifest.callback_mask == inventory->observed_callback_mask;
+}
+
+int qemu_plugin_crucible_hot_fork_barrier(
+    uint32_t action,
+    QemuPluginCrucibleHotForkBarrierInventory *inventory)
+{
+    struct qemu_plugin_crucible_hot_fork_barrier_status status = { 0 };
+    qemu_plugin_crucible_hot_fork_barrier_cb_t cb;
+    void *userdata;
+    uint32_t previous_flags;
+    uint64_t previous_in_flight;
+    uint64_t previous_ring_count;
+    uint64_t previous_rings_held;
+    uint64_t previous_ring_producers_in_flight;
+    uint64_t previous_ring_consumers_in_flight;
+    uint64_t previous_worker_mask;
+    uint64_t previous_parked_worker_mask;
+    uint64_t previous_pending_worker_mask;
+    uint64_t previous_worker_operations_in_flight;
+    uint64_t previous_worker_process_id;
+    uint64_t previous_worker_membership_generation;
+    uint64_t previous_worker_thread_ids[3];
+    bool worker_identities_valid;
+    int result;
+
+    if (!inventory ||
+        (action != QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_HOLD &&
+         action != QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_QUERY &&
+         action != QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_RELEASE)) {
+        return -EINVAL;
+    }
+
+    qemu_mutex_lock(&qemu_plugin_crucible_barrier_operation_lock);
+    qemu_mutex_lock(&qemu_plugin_crucible_resource_lock);
+    if (!qemu_plugin_crucible_barrier_inventory.registered) {
+        *inventory = qemu_plugin_crucible_barrier_inventory;
+        qemu_mutex_unlock(&qemu_plugin_crucible_resource_lock);
+        qemu_mutex_unlock(&qemu_plugin_crucible_barrier_operation_lock);
+        return action == QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_QUERY ? 0 :
+               -ENODEV;
+    }
+    cb = qemu_plugin_crucible_barrier_cb;
+    userdata = qemu_plugin_crucible_barrier_userdata;
+    qemu_mutex_unlock(&qemu_plugin_crucible_resource_lock);
+
+    QemuCrucibleNativeInvocationTicket native =
+        qemu_plugin_crucible_native_mask_v1(&cb, cb, userdata);
+
+    result = cb(action, &status, userdata);
+    qemu_plugin_crucible_native_exit_v1(native);
+    if (result != 0) {
+        qemu_mutex_unlock(&qemu_plugin_crucible_barrier_operation_lock);
+        return result;
+    }
+    worker_identities_valid = status.worker_process_id == (uint64_t)getpid() &&
+        status.worker_membership_generation != 0;
+    for (size_t index = 0; index < ARRAY_SIZE(status.worker_thread_ids); index++) {
+        uint64_t thread_id = status.worker_thread_ids[index];
+
+        worker_identities_valid &= (thread_id != 0) ==
+            ((status.worker_mask & (UINT64_C(1) << index)) != 0);
+        for (size_t prior = 0; thread_id && prior < index; prior++) {
+            worker_identities_valid &=
+                thread_id != status.worker_thread_ids[prior];
+        }
+    }
+    if (status.schema_version !=
+            QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_STATUS_VERSION ||
+        status.struct_size != sizeof(status) || status.reserved != 0 ||
+        !worker_identities_valid ||
+        (status.flags &
+         ~QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_FLAG_ALL) != 0 ||
+        status.ring_count == 0 || status.rings_held > status.ring_count ||
+        (status.rings_held != 0 &&
+         status.rings_held != status.ring_count) ||
+        (status.worker_mask & ~QEMU_PLUGIN_CRUCIBLE_WORKER_ALL) != 0 ||
+        (status.worker_mask & QEMU_PLUGIN_CRUCIBLE_WORKER_REQUIRED) !=
+            QEMU_PLUGIN_CRUCIBLE_WORKER_REQUIRED ||
+        (status.parked_worker_mask & ~status.worker_mask) != 0 ||
+        (status.pending_worker_mask & ~status.parked_worker_mask) != 0 ||
+        ctpop64(status.parked_worker_mask) +
+            status.worker_operations_in_flight > (uint64_t)ctpop64(status.worker_mask) ||
+        (((status.flags &
+           QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_FLAG_HELD) != 0) !=
+         (status.rings_held == status.ring_count)) ||
+        (((status.flags &
+           QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_FLAG_MAPPING_DONTFORK) !=
+          0) !=
+         ((status.flags &
+           QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_FLAG_HELD) != 0)) ||
+        (action == QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_HOLD &&
+         (status.flags &
+          QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_FLAG_HELD) == 0) ||
+        (action == QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_RELEASE &&
+         (status.flags &
+          QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_FLAG_HELD) != 0)) {
+        qemu_mutex_unlock(&qemu_plugin_crucible_barrier_operation_lock);
+        return -EPROTO;
+    }
+    if (action == QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_HOLD &&
+        (status.flags &
+         QEMU_PLUGIN_CRUCIBLE_HOT_FORK_BARRIER_FLAG_TEARDOWN) != 0) {
+        qemu_mutex_unlock(&qemu_plugin_crucible_barrier_operation_lock);
+        return -ESHUTDOWN;
+    }
+
+    qemu_mutex_lock(&qemu_plugin_crucible_resource_lock);
+    previous_flags = qemu_plugin_crucible_barrier_inventory.status.flags;
+    previous_in_flight =
+        qemu_plugin_crucible_barrier_inventory.status.in_flight;
+    previous_ring_count =
+        qemu_plugin_crucible_barrier_inventory.status.ring_count;
+    previous_rings_held =
+        qemu_plugin_crucible_barrier_inventory.status.rings_held;
+    previous_ring_producers_in_flight =
+        qemu_plugin_crucible_barrier_inventory.status.ring_producers_in_flight;
+    previous_ring_consumers_in_flight =
+        qemu_plugin_crucible_barrier_inventory.status.ring_consumers_in_flight;
+    previous_worker_mask =
+        qemu_plugin_crucible_barrier_inventory.status.worker_mask;
+    previous_parked_worker_mask =
+        qemu_plugin_crucible_barrier_inventory.status.parked_worker_mask;
+    previous_pending_worker_mask =
+        qemu_plugin_crucible_barrier_inventory.status.pending_worker_mask;
+    previous_worker_operations_in_flight =
+        qemu_plugin_crucible_barrier_inventory.status
+            .worker_operations_in_flight;
+    previous_worker_process_id =
+        qemu_plugin_crucible_barrier_inventory.status.worker_process_id;
+    previous_worker_membership_generation =
+        qemu_plugin_crucible_barrier_inventory.status.worker_membership_generation;
+    memcpy(previous_worker_thread_ids,
+           qemu_plugin_crucible_barrier_inventory.status.worker_thread_ids,
+           sizeof(previous_worker_thread_ids));
+    if (previous_flags != status.flags ||
+        previous_in_flight != status.in_flight ||
+        previous_ring_count != status.ring_count ||
+        previous_rings_held != status.rings_held ||
+        previous_ring_producers_in_flight !=
+            status.ring_producers_in_flight ||
+        previous_ring_consumers_in_flight !=
+            status.ring_consumers_in_flight ||
+        previous_worker_mask != status.worker_mask ||
+        previous_parked_worker_mask != status.parked_worker_mask ||
+        previous_pending_worker_mask != status.pending_worker_mask ||
+        previous_worker_operations_in_flight !=
+            status.worker_operations_in_flight ||
+        previous_worker_process_id != status.worker_process_id ||
+        previous_worker_membership_generation !=
+            status.worker_membership_generation ||
+        memcmp(previous_worker_thread_ids, status.worker_thread_ids,
+               sizeof(previous_worker_thread_ids))) {
+        if (qemu_plugin_crucible_barrier_inventory.generation == UINT64_MAX) {
+            qemu_mutex_unlock(&qemu_plugin_crucible_resource_lock);
+            qemu_mutex_unlock(&qemu_plugin_crucible_barrier_operation_lock);
+            return -EOVERFLOW;
+        }
+        qemu_plugin_crucible_barrier_inventory.generation++;
+    }
+    qemu_plugin_crucible_barrier_inventory.status = status;
+    qemu_plugin_crucible_barrier_inventory.manifest_consistent =
+        qemu_plugin_crucible_resource_inventory.registered &&
+        qemu_plugin_crucible_resource_inventory.complete &&
+        qemu_plugin_crucible_resource_inventory.manifest.plugin_id ==
+            qemu_plugin_crucible_barrier_inventory.plugin_id &&
+        qemu_plugin_crucible_resource_inventory.manifest.worker_mask ==
+            status.worker_mask;
+    *inventory = qemu_plugin_crucible_barrier_inventory;
+    qemu_mutex_unlock(&qemu_plugin_crucible_resource_lock);
+    qemu_mutex_unlock(&qemu_plugin_crucible_barrier_operation_lock);
+    return 0;
+}
+
+int qemu_plugin_crucible_hot_fork_child_runtime(
+    uint32_t action,
+    const struct qemu_plugin_crucible_hot_fork_child_plan *plan,
+    QemuPluginCrucibleHotForkChildRuntimeInventory *inventory)
+{
+    struct qemu_plugin_crucible_hot_fork_child_status status = { 0 };
+    qemu_plugin_crucible_hot_fork_child_runtime_cb_t cb;
+    void *userdata;
+    struct qemu_plugin_crucible_hot_fork_child_status previous_status;
+    uint64_t previous_generation;
+    int result;
+
+    if (!inventory ||
+        (action != QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_INITIALIZE &&
+         action != QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_QUERY &&
+         action != QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_RELEASE) ||
+        (action == QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_INITIALIZE &&
+         !qemu_crucible_hot_fork_plugin_child_plan_valid(plan))) {
+        return -EINVAL;
+    }
+
+    qemu_mutex_lock(&qemu_plugin_crucible_barrier_operation_lock);
+    qemu_mutex_lock(&qemu_plugin_crucible_resource_lock);
+    if (!qemu_plugin_crucible_child_runtime_inventory.registered) {
+        *inventory = qemu_plugin_crucible_child_runtime_inventory;
+        qemu_mutex_unlock(&qemu_plugin_crucible_resource_lock);
+        qemu_mutex_unlock(&qemu_plugin_crucible_barrier_operation_lock);
+        return action == QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_QUERY ? 0 :
+               -ENODEV;
+    }
+    if (!qemu_plugin_crucible_resource_inventory.registered ||
+        !qemu_plugin_crucible_resource_inventory.complete ||
+        qemu_plugin_crucible_resource_inventory.manifest.plugin_id !=
+            qemu_plugin_crucible_child_runtime_inventory.plugin_id ||
+        (action == QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_INITIALIZE &&
+         (plan->parent_process_generation !=
+              qemu_plugin_crucible_resource_inventory.manifest.
+                  process_generation ||
+          plan->worker_mask !=
+              qemu_plugin_crucible_resource_inventory.manifest.worker_mask ||
+          plan->control_fd !=
+              qemu_plugin_crucible_resource_inventory.manifest.control_fd ||
+          plan->wake_fd !=
+              qemu_plugin_crucible_resource_inventory.manifest.wake_fd ||
+          (plan->shmem_device ==
+               qemu_plugin_crucible_resource_inventory.manifest.shmem_device &&
+           plan->shmem_inode ==
+               qemu_plugin_crucible_resource_inventory.manifest.
+                   shmem_inode)))) {
+        qemu_mutex_unlock(&qemu_plugin_crucible_resource_lock);
+        qemu_mutex_unlock(&qemu_plugin_crucible_barrier_operation_lock);
+        fprintf(stderr, "crucible plugin child runtime: action %u does not "
+                "match the sealed resource manifest\n", action);
+        return -EPROTO;
+    }
+    cb = qemu_plugin_crucible_child_runtime_cb;
+    userdata = qemu_plugin_crucible_child_runtime_userdata;
+    previous_status =
+        qemu_plugin_crucible_child_runtime_inventory.status;
+    if (action != QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_QUERY &&
+        qemu_plugin_crucible_child_runtime_inventory.generation ==
+            UINT64_MAX) {
+        qemu_mutex_unlock(&qemu_plugin_crucible_resource_lock);
+        qemu_mutex_unlock(&qemu_plugin_crucible_barrier_operation_lock);
+        return -EOVERFLOW;
+    }
+    if (action == QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_INITIALIZE &&
+        qemu_plugin_crucible_resource_inventory.generation == UINT64_MAX) {
+        qemu_mutex_unlock(&qemu_plugin_crucible_resource_lock);
+        qemu_mutex_unlock(&qemu_plugin_crucible_barrier_operation_lock);
+        return -EOVERFLOW;
+    }
+    qemu_mutex_unlock(&qemu_plugin_crucible_resource_lock);
+
+    if (action == QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_INITIALIZE) {
+        result = qemu_crucible_fault_lifecycle_rebind_process_generation(
+            plan->parent_process_generation,
+            plan->child_process_generation);
+        if (result != 0) {
+            qemu_mutex_unlock(&qemu_plugin_crucible_barrier_operation_lock);
+            return result;
+        }
+        qemu_mutex_lock(&qemu_plugin_crucible_resource_lock);
+        qemu_plugin_crucible_resource_inventory.manifest.process_generation =
+            plan->child_process_generation;
+        qemu_plugin_crucible_resource_inventory.generation++;
+        qemu_mutex_unlock(&qemu_plugin_crucible_resource_lock);
+    }
+    QemuCrucibleNativeInvocationTicket native =
+        qemu_plugin_crucible_native_mask_v1(&cb, cb, userdata);
+
+    result = cb(action, plan, &status, userdata);
+    qemu_plugin_crucible_native_exit_v1(native);
+    if (result != 0) {
+        qemu_mutex_unlock(&qemu_plugin_crucible_barrier_operation_lock);
+        return result;
+    }
+    /*
+     * A held child's replacement workers park from their own threads after
+     * initialization returns, so the readiness flag must track the parked
+     * mask rather than the phase; the reinitializer queries until it is set.
+     */
+    if (status.schema_version !=
+            QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_STATUS_VERSION ||
+        status.struct_size != sizeof(status) ||
+        status.workspace_reserved != 0 ||
+        (status.flags &
+         ~QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_RUNTIME_ALL) != 0 ||
+        status.phase > QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PHASE_FAILED ||
+        (status.worker_mask & ~QEMU_PLUGIN_CRUCIBLE_WORKER_ALL) != 0 ||
+        (status.worker_mask & QEMU_PLUGIN_CRUCIBLE_WORKER_REQUIRED) !=
+            QEMU_PLUGIN_CRUCIBLE_WORKER_REQUIRED ||
+        (status.parked_worker_mask & ~status.worker_mask) != 0 ||
+        (status.pending_worker_mask & ~status.parked_worker_mask) != 0 ||
+        ctpop64(status.parked_worker_mask) +
+            status.worker_operations_in_flight > ctpop64(status.worker_mask) ||
+        (((status.flags &
+         QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_ACTIVE) != 0) !=
+         (status.phase ==
+          QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PHASE_ACTIVE)) ||
+        (((status.flags &
+         QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_FAILED) != 0) !=
+         (status.phase ==
+          QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PHASE_FAILED)) ||
+        (status.phase == QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PHASE_TEMPLATE &&
+         (status.parent_process_generation != 0 ||
+          status.child_process_generation != 0 ||
+          status.template_generation != 0 ||
+          status.private_ring_generation != 0 ||
+          status.plugin_endpoint_generation != 0 ||
+          status.plugin_barrier_generation != 0 ||
+          status.control_socket_cookie != 0 ||
+          status.wake_eventfd_id != 0 ||
+          status.source_mapping_start != 0 ||
+          status.source_mapping_length != 0 ||
+          status.source_mapping_offset != 0)) ||
+        (status.phase >=
+         QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PHASE_WORKERS_HELD &&
+         (status.parent_process_generation == 0 ||
+          status.parent_process_generation == UINT64_MAX ||
+          status.child_process_generation !=
+              status.parent_process_generation + 1 ||
+          status.template_generation == 0 ||
+          status.private_ring_generation == 0 ||
+          status.plugin_endpoint_generation == 0 ||
+          status.plugin_barrier_generation == 0 ||
+          status.control_socket_cookie == 0 ||
+          status.wake_eventfd_id == 0 ||
+          status.source_mapping_start == 0 ||
+          status.source_mapping_length == 0 ||
+          status.source_mapping_offset != 0)) ||
+        (status.phase ==
+             QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PHASE_WORKERS_HELD &&
+         ((status.flags &
+           (QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_CALLBACKS_HELD |
+            QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_MAPPING_INSTALLED)) !=
+          (QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_CALLBACKS_HELD |
+           QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_MAPPING_INSTALLED) ||
+          (((status.flags &
+             QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_WORKERS_READY) != 0) !=
+           (status.parked_worker_mask == status.worker_mask &&
+            status.pending_worker_mask == 0 &&
+            status.worker_operations_in_flight == 0)))) ||
+        (status.phase == QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PHASE_ACTIVE &&
+         ((status.flags &
+           (QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_CALLBACKS_HELD |
+            QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_WORKERS_READY)) != 0 ||
+          (status.flags &
+           QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_MAPPING_INSTALLED) ==
+              0)) ||
+        (action == QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_INITIALIZE &&
+         ((status.flags &
+           QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_CALLBACKS_HELD) == 0 ||
+          (status.flags &
+           QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_MAPPING_INSTALLED) == 0 ||
+          status.parent_process_generation !=
+              plan->parent_process_generation ||
+          status.child_process_generation !=
+              plan->child_process_generation ||
+          status.template_generation != plan->template_generation ||
+          status.private_ring_generation != plan->private_ring_generation ||
+          status.plugin_endpoint_generation !=
+              plan->plugin_endpoint_generation ||
+          status.plugin_barrier_generation !=
+              plan->plugin_barrier_generation ||
+          status.control_socket_cookie != plan->control_socket_cookie ||
+          status.wake_eventfd_id != plan->wake_eventfd_id ||
+          status.source_mapping_start != plan->source_mapping_start ||
+          status.source_mapping_length != plan->source_mapping_length ||
+          status.source_mapping_offset != plan->source_mapping_offset)) ||
+        (action != QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_INITIALIZE &&
+         previous_status.phase !=
+             QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PHASE_TEMPLATE &&
+         (status.parent_process_generation !=
+              previous_status.parent_process_generation ||
+          status.child_process_generation !=
+              previous_status.child_process_generation ||
+          status.template_generation !=
+              previous_status.template_generation ||
+          status.private_ring_generation !=
