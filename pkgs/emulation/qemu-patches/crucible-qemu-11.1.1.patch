+#include "exec/memattrs.h"
+#include "plugins/qemu-plugin.h"
+#include "qemu/typedefs.h"
+
+struct QCryptoSHA256;
+
+/*
+ * Factual caller-storage query, not a selected SDK or runtime borrower.
+ * The caller retains exclusive valid backing and a stable complete registry.
+ * Hash and output must be aligned and disjoint from each other and registry
+ * records, names and pointer storage. Validation refusal changes neither.
+ * Success reinitializes/consumes hash and publishes the same legacy manifest;
+ * repeating the query is allowed with the same exclusively retained storage.
+ * Returns 0, or -EINVAL for readiness or storage-geometry refusal.
+ */
+int qemu_crucible_fault_system_manifest_into_v1(
+    struct QCryptoSHA256 *hash,
+    struct qemu_plugin_crucible_fault_system_manifest *out);
+
+/* Exact typed catalogue backing, retained for the native image lifetime. */
+uint64_t qemu_crucible_fault_hardware_catalogue_fixed_storage_bytes_v1(void);
+uint64_t qemu_crucible_fault_interrupt_catalogue_fixed_storage_bytes_v1(void);
+uint64_t qemu_crucible_fault_clock_registry_fixed_storage_bytes_v1(void);
+
+typedef struct QemuCrucibleInitialHardwareCatalogueLease
+    QemuCrucibleInitialHardwareCatalogueLease;
+
+/* Process-private constructor/terminal seams; none is a module SDK issuer. */
+int qemu_crucible_fault_hardware_catalogue_issuing_v1(
+    CPUState *cpu, QemuCrucibleInitialHardwareCatalogueLease **holder);
+int qemu_crucible_fault_hardware_catalogue_holder_v1(
+    QemuCrucibleInitialHardwareCatalogueLease *lease,
+    QemuCrucibleInitialHardwareCatalogueLease **holder, bool returning);
+int qemu_crucible_fault_hardware_catalogue_terminal_v1(void);
+
+typedef struct QemuCrucibleFaultHandler QemuCrucibleFaultHandler;
+typedef struct QemuCrucibleFaultRule QemuCrucibleFaultRule;
+typedef struct QemuCrucibleFaultEventReservation
+    QemuCrucibleFaultEventReservation;
+typedef struct CPUFaultException CPUFaultException;
+typedef struct QObject QObject;
+typedef void (*QemuCrucibleAcceleratorLifecycleFn)(
+    void *opaque, uint32_t transition, uint32_t queue_policy,
+    uint32_t memory_policy);
+
+typedef int (*QemuCrucibleFaultVmstateSaveFn)(GByteArray *payload);
+typedef int (*QemuCrucibleFaultVmstatePrepareFn)(
+    const uint8_t *payload, size_t payload_len, void **staged);
+typedef void (*QemuCrucibleFaultVmstateCommitFn)(void *staged);
+typedef void (*QemuCrucibleFaultVmstateFreeFn)(void *staged);
+
+typedef struct QemuCrucibleFaultVmstateSection {
+    const char *name;
+    uint32_t version;
+    QemuCrucibleFaultVmstateSaveFn save;
+    QemuCrucibleFaultVmstateSaveFn fingerprint_projection;
+    QemuCrucibleFaultVmstatePrepareFn prepare;
+    QemuCrucibleFaultVmstateCommitFn commit;
