+static void test_riscv_itrigger_adaptive_shift(void)
+{
+    const int64_t initial_ps_per_instruction = 8192;
+    const int64_t later_ps_per_instruction = 4096;
+    QEMUTimer *old_projected_timer;
+    int remaining = 100;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    test_generic_virtual_ps = 1050;
+    test_itrigger_count = remaining;
+    test_itrigger_duration_ps = remaining * initial_ps_per_instruction;
+    qemu_init_clocks(NULL);
+    qemu_timer_enable_tcg_ps_clock(NULL, test_generic_virtual_clock_ps);
+    qemu_clock_enable(QEMU_CLOCK_VIRTUAL, true);
+    old_projected_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL,
+                                       test_timer_callback, NULL);
+
+    g_assert_false(riscv_itrigger_uses_tb_helper(ICOUNT_PRECISE));
+    g_assert_true(riscv_itrigger_uses_tb_helper(ICOUNT_ADAPTATIVE));
+    riscv_itrigger_schedule_timer(old_projected_timer, remaining);
+
+    for (int instruction = 0; instruction < 100; instruction++) {
+        test_generic_virtual_ps += instruction < 50 ?
+                                   initial_ps_per_instruction :
+                                   later_ps_per_instruction;
+        remaining = riscv_itrigger_step_count(remaining);
+        if (instruction < 99) {
+            g_assert_cmpint(remaining, >, 0);
+        }
+    }
+
+    g_assert_cmpint(remaining, ==, 0);
+    g_assert_false(qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL));
+    g_assert_cmpuint(test_timer_callbacks, ==, 0);
+    timer_free(old_projected_timer);
+}
