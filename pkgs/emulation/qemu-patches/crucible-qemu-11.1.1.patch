+    size_t output_capacity,
+    void *userdata)
+{
+#ifdef CONFIG_PLUGIN
+    QemuCrucibleNativeGroupDescriptorView actual;
+    QemuCrucibleNativeGroupUse use =
+        qemu_plugin_crucible_native_group_use_begin_v1(
+            &native_accelerator_members[4],
+            qemu_plugin_crucible_native_accelerator_descriptor_observe_v1,
+            4, &actual);
+    int result = -1;
+
+    (void)userdata;
+    if (actual.function) {
+        result = ((qemu_plugin_accelerator_restore_cb_t)actual.function)(
+            sequence,
+            device_id,
+            class_id,
+            job_kind,
+            queue_id,
+            service_units,
+            output_capacity,
+            actual.userdata);
+    }
+    qemu_plugin_crucible_native_group_use_end_v1(use);
+    return result;
+#else
+    return accelerator_restore_cb(sequence, device_id, class_id, job_kind, queue_id, service_units, output_capacity, userdata);
+#endif
+}
+
+static int crucible_group_call_accelerator_restore_commit_cb(
+    void *userdata)
+{
+#ifdef CONFIG_PLUGIN
+    QemuCrucibleNativeGroupDescriptorView actual;
+    QemuCrucibleNativeGroupUse use =
+        qemu_plugin_crucible_native_group_use_begin_v1(
+            &native_accelerator_members[5],
+            qemu_plugin_crucible_native_accelerator_descriptor_observe_v1,
+            5, &actual);
+    int result = -1;
+
+    (void)userdata;
+    if (actual.function) {
+        result = ((qemu_plugin_accelerator_restore_commit_cb_t)actual.function)(
+            actual.userdata);
+    }
+    qemu_plugin_crucible_native_group_use_end_v1(use);
+    return result;
+#else
+    return accelerator_restore_commit_cb(userdata);
+#endif
+}
+
+static void crucible_group_call_accelerator_restore_abort_cb(
+    void *userdata)
+{
+#ifdef CONFIG_PLUGIN
+    QemuCrucibleNativeGroupDescriptorView actual;
+    QemuCrucibleNativeGroupUse use =
+        qemu_plugin_crucible_native_group_use_begin_v1(
+            &native_accelerator_members[6],
+            qemu_plugin_crucible_native_accelerator_descriptor_observe_v1,
+            6, &actual);
+
+    (void)userdata;
+    if (actual.function) {
+        ((qemu_plugin_accelerator_restore_abort_cb_t)actual.function)(
+            actual.userdata);
+    }
+    qemu_plugin_crucible_native_group_use_end_v1(use);
+#else
+    accelerator_restore_abort_cb(userdata);
+#endif
