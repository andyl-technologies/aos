+static inline bool ich9_ahci_state_fingerprint_validate(
+    const AHCIState *ahci, Error **errp)
+{
+    if (ahci->ports == 0 || ahci->ports > AHCI_MAX_PORTS || !ahci->dev) {
+        error_setg(errp, "ICH9 AHCI fingerprint has invalid port geometry");
+        return false;
+    }
+
+    for (uint32_t port_index = 0; port_index < ahci->ports; port_index++) {
+        const AHCIDevice *port = &ahci->dev[port_index];
+        const IDEBus *bus = &port->port;
+
+        if (port->port_no != port_index || bus->max_units <= 0 ||
+            bus->max_units > MAX_IDE_DEVS) {
+            error_setg(errp, "ICH9 AHCI fingerprint port identity mismatch");
+            return false;
+        }
+        for (size_t unit = 0; unit < bus->max_units; unit++) {
+            const IDEState *ide = &bus->ifs[unit];
+
+            if (ide->blk) {
+                error_setg(errp,
+                           "ICH9 AHCI fingerprint does not admit IDE media");
+                return false;
+            }
+        }
+        for (size_t slot = 0; slot < AHCI_MAX_CMDS; slot++) {
+            const NCQTransferState *ncq = &port->ncq_tfs[slot];
+            bool live = ncq->used || ncq->halt;
+
+            if (ncq->used != ncq->halt ||
+                (live && (ncq->slot != slot || ncq->tag != slot))) {
+                error_setg(errp,
+                           "ICH9 AHCI fingerprint has invalid NCQ state");
+                return false;
+            }
+            if (live) {
+                error_setg(errp,
+                           "ICH9 AHCI fingerprint does not admit live NCQ "
+                           "without an IDE backend continuation");
+                return false;
+            }
+        }
+    }
+    return true;
+}
+
+static inline void ich9_ahci_state_fingerprint_put(QEMUFile *f,
+                                                    const AHCIState *ahci)
+{
+    qemu_put_be32(f, ahci->ports);
+    qemu_put_be32(f, ahci->control_regs.cap);
+    qemu_put_be32(f, ahci->control_regs.ghc);
+    qemu_put_be32(f, ahci->control_regs.irqstatus);
+    qemu_put_be32(f, ahci->control_regs.impl);
+    qemu_put_be32(f, ahci->control_regs.version);
+    qemu_put_be32(f, ahci->idp_index);
+
+    for (uint32_t port_index = 0; port_index < ahci->ports; port_index++) {
+        const AHCIDevice *port = &ahci->dev[port_index];
+        const AHCIPortRegs *regs = &port->port_regs;
+        const IDEBus *bus = &port->port;
+
+        qemu_put_be32(f, port->port_no);
+        qemu_put_be32(f, port->port_state);
+        qemu_put_be32(f, port->finished);
+        qemu_put_be32(f, regs->lst_addr);
+        qemu_put_be32(f, regs->lst_addr_hi);
+        qemu_put_be32(f, regs->fis_addr);
+        qemu_put_be32(f, regs->fis_addr_hi);
+        qemu_put_be32(f, regs->irq_stat);
+        qemu_put_be32(f, regs->irq_mask);
+        qemu_put_be32(f, regs->cmd);
+        qemu_put_be32(f, regs->tfdata);
+        qemu_put_be32(f, regs->sig);
+        qemu_put_be32(f, regs->scr_stat);
+        qemu_put_be32(f, regs->scr_ctl);
+        qemu_put_be32(f, regs->scr_err);
+        qemu_put_be32(f, regs->scr_act);
+        qemu_put_be32(f, regs->cmd_issue);
+        qemu_put_byte(f, port->done_first_drq);
+        qemu_put_be32(f, port->busy_slot);
+        qemu_put_byte(f, port->init_d2h_sent);
+
+        qemu_put_byte(f, bus->unit);
+        qemu_put_byte(f, bus->max_units);
+        qemu_put_byte(f, bus->cmd);
+        qemu_put_byte(f, bus->error_status != 0);
+        if (bus->error_status != 0) {
+            qemu_put_be32(f, bus->error_status);
+            qemu_put_byte(f, bus->retry_unit);
+            qemu_put_be64(f, bus->retry_sector_num);
+            qemu_put_be32(f, bus->retry_nsector);
+        }
+
+        for (size_t unit = 0; unit < bus->max_units; unit++) {
+            const IDEState *ide = &bus->ifs[unit];
+
+            qemu_put_byte(f, ide->unit);
+            qemu_put_byte(f, ide->feature);
+            qemu_put_byte(f, ide->error);
+            qemu_put_be32(f, ide->nsector);
+            qemu_put_byte(f, ide->sector);
+            qemu_put_byte(f, ide->lcyl);
+            qemu_put_byte(f, ide->hcyl);
+            qemu_put_byte(f, ide->hob_feature);
+            qemu_put_byte(f, ide->hob_nsector);
+            qemu_put_byte(f, ide->hob_sector);
+            qemu_put_byte(f, ide->hob_lcyl);
+            qemu_put_byte(f, ide->hob_hcyl);
+            qemu_put_byte(f, ide->select);
+            qemu_put_byte(f, ide->status);
+            qemu_put_byte(f, ide->lba48);
+            qemu_put_byte(f, ide->io8);
+            qemu_put_be32(f, ide->dma_cmd);
+            qemu_put_be32(f, ide->req_nb_sectors);
+        }
+
+        for (size_t slot = 0; slot < AHCI_MAX_CMDS; slot++) {
+            const NCQTransferState *ncq = &port->ncq_tfs[slot];
+
+            qemu_put_byte(f, ncq->used || ncq->halt);
+        }
+    }
+}
+
+#endif
