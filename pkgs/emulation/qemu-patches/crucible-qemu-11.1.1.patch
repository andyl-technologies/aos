+int qemu_crucible_startup_source_cpu_allocation_admit_v1(
+    QemuCrucibleCpuAllocationRequest *request,
+    QemuCrucibleCpuSourceAllocationOwner **out)
+{
+    QemuCrucibleObservationConstructionBinding *binding = NULL;
+    QemuCrucibleCpuSourceAllocationOwner *owner;
+    size_t payload_bytes = 0;
+    size_t payload_alignment = 0;
+    size_t receipt_bytes = qemu_crucible_cpu_allocation_receipt_bytes_v1();
+    size_t receipt_alignment = qemu_crucible_cpu_allocation_receipt_alignment_v1();
+    size_t storage_bytes;
+    uint64_t serial = 0;
+    uintptr_t receipt;
+    int status;
+
+    if (!out || *out) {
+        return -EINVAL;
+    }
+    status = qemu_crucible_cpu_allocation_request_current_v1(
+        request, &binding, &payload_bytes, &payload_alignment);
+    if (!status) {
+        status = qemu_crucible_cpu_allocation_request_serial_v1(request, &serial);
+    }
+    if (status) {
+        return status;
+    }
+    if (binding != &startup_source.standing.construction || !serial ||
+        !payload_bytes || !payload_alignment ||
+        (payload_alignment & (payload_alignment - 1)) ||
+        !receipt_bytes || !receipt_alignment ||
+        (receipt_alignment & (receipt_alignment - 1)) ||
+        receipt_alignment - 1 > SIZE_MAX - sizeof(*owner) ||
+        receipt_bytes > SIZE_MAX - sizeof(*owner) - (receipt_alignment - 1)) {
+        return -EOVERFLOW;
+    }
+    storage_bytes = sizeof(*owner) + receipt_alignment - 1 + receipt_bytes;
+    if (payload_bytes > UINT64_MAX - storage_bytes) {
+        return -EOVERFLOW;
+    }
+    status = pthread_mutex_trylock(&startup_source.cpu_allocations.lock);
+    if (status) {
+        return -status;
+    }
+    status = cpu_allocation_pending_retire_locked();
+    if (!status) {
+        status = qemu_crucible_startup_source_observation_construction_current_v1(binding);
+    }
+    if (!status) {
+        status = crucible_metadata_native_admit(
+            &startup_source.metadata_partition, storage_bytes + payload_bytes,
+            &startup_source.cpu_allocations.pending_charge);
+        if (status && startup_source.cpu_allocations.pending_charge.held) {
+            /* This newly attempted debit has not entered the header allocator.
+             * Record that exact no-allocation cut; preserve its signed refusal
+             * independently of physical accounting retirement. */
+            startup_source.cpu_allocations.pending_physical_return = true;
+            cpu_allocation_pending_retire_locked();
+        }
+    }
+    if (status) {
+        pthread_mutex_unlock(&startup_source.cpu_allocations.lock);
+        return status;
+    }
+
+    /* The actual request is debited before either header or QOM payload birth.
+     * The QOM allocator is still outside its allocation-start phase here. */
+    owner = g_try_malloc0(storage_bytes);
+    if (!owner) {
+        startup_source.cpu_allocations.pending_physical_return = true;
+        cpu_allocation_pending_retire_locked();
+        pthread_mutex_unlock(&startup_source.cpu_allocations.lock);
+        return -ENOMEM;
+    }
+    receipt = ((uintptr_t)(owner + 1) + receipt_alignment - 1) &
+              ~(uintptr_t)(receipt_alignment - 1);
+    owner->binding = binding;
+    owner->request = request;
+    owner->request_serial = serial;
+    owner->process = getpid();
+    owner->payload_bytes = payload_bytes;
+    owner->payload_alignment = payload_alignment;
+    owner->storage_bytes = storage_bytes;
+    owner->receipt_offset = receipt - (uintptr_t)owner;
+    owner->charge = startup_source.cpu_allocations.pending_charge;
+    owner->partition = &startup_source.metadata_partition;
+    startup_source.cpu_allocations.pending_charge = (QemuCrucibleMetadataCharge) { 0 };
+    owner->next = startup_source.cpu_allocations.owners;
+    startup_source.cpu_allocations.owners = owner;
+    *out = owner;
+
+    /* Born-negative custody is visible before the independent semantic cut.
+     * Native can borrow its receipt and journal true allocator abandonment. */
+    status = qemu_crucible_startup_source_observation_construction_current_v1(binding);
+    pthread_mutex_unlock(&startup_source.cpu_allocations.lock);
+    return status;
+}
+
+int qemu_crucible_startup_source_cpu_allocation_receipt_borrow_v1(
+    QemuCrucibleCpuAllocationRequest *request,
+    QemuCrucibleCpuSourceAllocationOwner *owner,
+    QemuCrucibleCpuAllocationReceipt **out)
+{
+    uint64_t serial = 0;
+    int status;
+
+    if (!out || *out) {
+        return -EINVAL;
+    }
+    status = pthread_mutex_trylock(&startup_source.cpu_allocations.lock);
+    if (status) {
+        return -status;
+    }
+    status = cpu_allocation_identity_locked(owner);
+    if (!status) {
+        status = qemu_crucible_cpu_allocation_request_serial_v1(request, &serial);
+    }
+    if (!status && (owner->request != request || owner->request_serial != serial ||
+                    owner->receipt)) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        owner->receipt = (QemuCrucibleCpuAllocationReceipt *)
+            ((uint8_t *)owner + owner->receipt_offset);
+        *out = owner->receipt;
+    }
+    pthread_mutex_unlock(&startup_source.cpu_allocations.lock);
+    return status;
+}
