+    assert(dirty_calls == 1 && disk_calls == 0);
+    assert(dirty_start == 4096 + 17 && dirty_length == 19);
+    assert(dirty_mask & (1 << DIRTY_MEMORY_CRUCIBLE_RAM));
+    assert(!(dirty_mask & (1 << DIRTY_MEMORY_MIGRATION)));
+    pflash02_update(&second, 29, 31);
+    assert(invalidations == 1);
+    assert(dirty_calls == 2 && disk_calls == 0);
+    assert(dirty_start == 8192 + 29 && dirty_length == 31);
