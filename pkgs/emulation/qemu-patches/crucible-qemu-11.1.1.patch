+static void test_foreign_and_unpublished(void)
+{
+    QemuThread thread;
+    QemuCrucibleCheckpointPlacementOwner before;
+    int result = 23;
+
+    if (!fixture_enter_subprocess()) {
+        return;
+    }
+    fixture_prepare(2);
+    checkpoint_placement_owner.first_status = -ECANCELED;
+    memcpy(&before, &checkpoint_placement_owner, sizeof(before));
+
+    qemu_thread_create(&thread, "mailbox foreign", fixture_foreign_call,
+                       &result, QEMU_THREAD_JOINABLE);
+    qemu_thread_join(&thread);
+    g_assert_cmpint(result, ==, -EPERM);
+    g_assert_cmpmem(&checkpoint_placement_owner, sizeof(before),
+                    &before, sizeof(before));
+    g_assert_cmpint(qemu_crucible_checkpoint_placement_detach_v1(NULL), ==,
+                    -EPERM);
+    qatomic_store_release(&checkpoint_placement_owner.published, false);
+    g_assert_cmpint(qemu_crucible_checkpoint_placement_detach_v1(
+        &checkpoint_placement_owner), ==, -EPERM);
+    g_assert_cmpuint(fixture_cas_calls, ==, 0);
