+    crucible_hot_fork_mutex_registry_held = true;
+}
+
+static void crucible_hot_fork_mutex_registry_unlock(void)
+{
+    int err;
+
+    crucible_hot_fork_mutex_registry_held = false;
+    err = pthread_mutex_unlock(&crucible_hot_fork_mutex_registry_guard);
+    if (err) {
+        error_exit(err, __func__);
+    }
+}
+
+static void crucible_hot_fork_mutex_latch_inconsistent(void)
+{
+    if (crucible_hot_fork_mutex_inconsistent) {
+        return;
+    }
+    crucible_hot_fork_mutex_inconsistent = true;
+    if (crucible_hot_fork_mutex_generation != UINT64_MAX) {
+        crucible_hot_fork_mutex_generation++;
+    }
+}
+
+/* The registry guard must be held while its generation is advanced. */
+static void crucible_hot_fork_mutex_changed(void)
+{
+    if (crucible_hot_fork_mutex_generation == UINT64_MAX) {
+        crucible_hot_fork_mutex_latch_inconsistent();
+        return;
+    }
+    crucible_hot_fork_mutex_generation++;
+}
+
+static void crucible_hot_fork_mutex_slots_init(void)
+{
+    size_t index;
+
+    if (crucible_hot_fork_mutex_slots_initialized) {
+        return;
+    }
+    for (index = 0; index < QEMU_HOT_FORK_MUTEX_INVENTORY_MAX; index++) {
+        crucible_hot_fork_mutex_free_slots[index] =
+            QEMU_HOT_FORK_MUTEX_INVENTORY_MAX - index - 1;
+    }
+    crucible_hot_fork_mutex_free_count =
+        QEMU_HOT_FORK_MUTEX_INVENTORY_MAX;
+    crucible_hot_fork_mutex_slots_initialized = true;
+}
+
+static size_t crucible_hot_fork_mutex_address_hash(uintptr_t mutex_address)
+{
+    uint64_t value = mutex_address;
+
+    value >>= 3;
+    value ^= value >> 33;
+    value *= UINT64_C(0xff51afd7ed558ccd);
+    value ^= value >> 33;
+    return value & (CRUCIBLE_HOT_FORK_MUTEX_ADDRESS_CAPACITY - 1);
+}
+
+/* The registry guard must be held while the address index is queried. */
+static bool crucible_hot_fork_mutex_address_find(
+    uintptr_t mutex_address, size_t *bucket_out, uint32_t *slot_out)
+{
+    size_t first_tombstone = SIZE_MAX;
+    size_t start = crucible_hot_fork_mutex_address_hash(mutex_address);
+    size_t probe;
+
+    for (probe = 0; probe < CRUCIBLE_HOT_FORK_MUTEX_ADDRESS_CAPACITY;
+         probe++) {
+        size_t bucket =
+            (start + probe) &
+            (CRUCIBLE_HOT_FORK_MUTEX_ADDRESS_CAPACITY - 1);
+        CrucibleHotForkMutexAddressEntry *address =
+            &crucible_hot_fork_mutex_addresses[bucket];
+
+        if (address->state == CRUCIBLE_HOT_FORK_MUTEX_ADDRESS_ACTIVE &&
+            address->mutex_address == mutex_address) {
+            *bucket_out = bucket;
+            *slot_out = address->slot;
+            return true;
+        }
+        if (address->state == CRUCIBLE_HOT_FORK_MUTEX_ADDRESS_TOMBSTONE &&
+            first_tombstone == SIZE_MAX) {
+            first_tombstone = bucket;
+        }
+        if (address->state == CRUCIBLE_HOT_FORK_MUTEX_ADDRESS_EMPTY) {
+            *bucket_out = first_tombstone == SIZE_MAX ?
+                bucket : first_tombstone;
+            return false;
+        }
+    }
+
+    if (first_tombstone != SIZE_MAX) {
+        *bucket_out = first_tombstone;
+        return false;
+    }
+    crucible_hot_fork_mutex_latch_inconsistent();
+    return false;
+}
+
+static bool crucible_hot_fork_mutex_address_insert(
+    uintptr_t mutex_address, uint32_t slot)
+{
+    CrucibleHotForkMutexAddressEntry *address;
+    uint32_t existing_slot = UINT32_MAX;
+    size_t bucket = SIZE_MAX;
+
+    if (crucible_hot_fork_mutex_address_find(
+            mutex_address, &bucket, &existing_slot) || bucket == SIZE_MAX) {
+        crucible_hot_fork_mutex_latch_inconsistent();
+        return false;
+    }
+
+    address = &crucible_hot_fork_mutex_addresses[bucket];
+    if (address->state == CRUCIBLE_HOT_FORK_MUTEX_ADDRESS_TOMBSTONE) {
+        g_assert(crucible_hot_fork_mutex_address_tombstones > 0);
+        crucible_hot_fork_mutex_address_tombstones--;
+    }
+    *address = (CrucibleHotForkMutexAddressEntry) {
+        .mutex_address = mutex_address,
+        .slot = slot,
+        .state = CRUCIBLE_HOT_FORK_MUTEX_ADDRESS_ACTIVE,
+    };
+    return true;
+}
+
+static bool crucible_hot_fork_mutex_address_remove(
+    uintptr_t mutex_address, uint32_t expected_slot)
+{
+    CrucibleHotForkMutexAddressEntry *address;
+    uint32_t slot = UINT32_MAX;
+    size_t bucket = SIZE_MAX;
+
+    if (!crucible_hot_fork_mutex_address_find(
+            mutex_address, &bucket, &slot) ||
+        slot != expected_slot) {
+        crucible_hot_fork_mutex_latch_inconsistent();
+        return false;
+    }
+
+    address = &crucible_hot_fork_mutex_addresses[bucket];
+    address->mutex_address = 0;
+    address->slot = UINT32_MAX;
+    address->state = CRUCIBLE_HOT_FORK_MUTEX_ADDRESS_TOMBSTONE;
+    crucible_hot_fork_mutex_address_tombstones++;
+    return true;
+}
+
+static void crucible_hot_fork_mutex_address_rebuild(void)
+{
+    size_t index;
+
+    if (crucible_hot_fork_mutex_address_tombstones <=
+            CRUCIBLE_HOT_FORK_MUTEX_ADDRESS_CAPACITY / 4 ||
+        crucible_hot_fork_mutex_address_tombstones <=
+            crucible_hot_fork_mutex_count) {
+        return;
+    }
+
+    memset(crucible_hot_fork_mutex_addresses, 0,
+           sizeof(crucible_hot_fork_mutex_addresses));
+    crucible_hot_fork_mutex_address_tombstones = 0;
+    for (index = 0; index < QEMU_HOT_FORK_MUTEX_INVENTORY_MAX; index++) {
+        CrucibleHotForkMutexEntry *entry =
+            &crucible_hot_fork_mutexes[index];
+
+        if (entry->active &&
+            !crucible_hot_fork_mutex_address_insert(
+                entry->mutex_address, index)) {
+            return;
+        }
+    }
+}
+
+static bool crucible_hot_fork_mutex_entry_quiescent(
+    const CrucibleHotForkMutexEntry *entry)
+{
+    return entry->ownership_valid && !entry->unlock_active &&
+        entry->owner_thread_id == 0 && entry->recursion_depth == 0 &&
+        entry->acquisition_waiters == 0 && entry->condition_waiters == 0 &&
+        entry->condition_waiter_thread_id == 0;
+}
+
+/* The registry guard must be held while a token is validated. */
+static CrucibleHotForkMutexEntry *crucible_hot_fork_mutex_entry(
+    QemuMutex *mutex)
+{
+    uint32_t slot = mutex->crucible_hot_fork_slot;
+    uint64_t registration_id = mutex->crucible_hot_fork_registration_id;
+    CrucibleHotForkMutexEntry *entry;
+
+    if (slot == UINT32_MAX && registration_id == 0) {
+        return NULL;
+    }
+    if (slot >= QEMU_HOT_FORK_MUTEX_INVENTORY_MAX || registration_id == 0) {
+        crucible_hot_fork_mutex_latch_inconsistent();
+        return NULL;
+    }
+
+    entry = &crucible_hot_fork_mutexes[slot];
+    if (!entry->active || entry->registration_id != registration_id ||
+        entry->mutex_address != (uintptr_t)mutex) {
+        crucible_hot_fork_mutex_latch_inconsistent();
+        return NULL;
+    }
+    return entry;
+}
+
+static void crucible_hot_fork_mutex_register(QemuMutex *mutex, bool recursive)
+{
+    CrucibleHotForkMutexEntry *entry;
+    uint32_t existing_slot = UINT32_MAX;
+    uint32_t slot = UINT32_MAX;
+    size_t bucket = SIZE_MAX;
+    bool reused = false;
+
+    mutex->crucible_hot_fork_registration_id = 0;
+    mutex->crucible_hot_fork_slot = UINT32_MAX;
+
+    crucible_hot_fork_mutex_registry_lock();
+    crucible_hot_fork_mutex_slots_init();
+    crucible_hot_fork_mutex_address_rebuild();
+
+    if (crucible_hot_fork_mutex_next_id == 0) {
+        crucible_hot_fork_mutex_latch_inconsistent();
+        goto untracked;
+    }
+
+    if (crucible_hot_fork_mutex_address_find(
+            (uintptr_t)mutex, &bucket, &existing_slot)) {
+        if (existing_slot >= QEMU_HOT_FORK_MUTEX_INVENTORY_MAX) {
+            crucible_hot_fork_mutex_latch_inconsistent();
+            goto untracked;
+        }
+        entry = &crucible_hot_fork_mutexes[existing_slot];
+        if (!entry->active || entry->mutex_address != (uintptr_t)mutex ||
+            !crucible_hot_fork_mutex_entry_quiescent(entry)) {
+            crucible_hot_fork_mutex_latch_inconsistent();
+            goto untracked;
+        }
+        slot = existing_slot;
+        reused = true;
+    } else {
+        if (crucible_hot_fork_mutex_free_count == 0) {
+            crucible_hot_fork_mutex_overflowed = true;
+            goto untracked;
+        }
+        slot = crucible_hot_fork_mutex_free_slots[
+            --crucible_hot_fork_mutex_free_count];
+        entry = &crucible_hot_fork_mutexes[slot];
+        g_assert(!entry->active);
+        if (!crucible_hot_fork_mutex_address_insert(
+                (uintptr_t)mutex, slot)) {
+            crucible_hot_fork_mutex_free_slots[
+                crucible_hot_fork_mutex_free_count++] = slot;
+            goto untracked;
+        }
+    }
+
+    *entry = (CrucibleHotForkMutexEntry) {
+        .mutex_address = (uintptr_t)mutex,
+        .registration_id = crucible_hot_fork_mutex_next_id++,
+        .recursive = recursive,
+        .ownership_valid = true,
+        .active = true,
+    };
+    mutex->crucible_hot_fork_registration_id = entry->registration_id;
+    mutex->crucible_hot_fork_slot = slot;
+    if (!reused) {
+        crucible_hot_fork_mutex_count++;
+    }
+    crucible_hot_fork_mutex_changed();
+    crucible_hot_fork_mutex_registry_unlock();
+    return;
+
+untracked:
+    crucible_hot_fork_mutex_changed();
+    crucible_hot_fork_mutex_registry_unlock();
+}
+
+static void crucible_hot_fork_mutex_wait_begin(QemuMutex *mutex)
+{
+    CrucibleHotForkMutexEntry *entry;
+
+    crucible_hot_fork_mutex_registry_lock();
+    entry = crucible_hot_fork_mutex_entry(mutex);
+    if (entry) {
+        qatomic_inc(&entry->acquisition_waiters);
+    }
+    crucible_hot_fork_mutex_registry_unlock();
+}
+
+static void crucible_hot_fork_mutex_wait_cancel(QemuMutex *mutex)
+{
+    CrucibleHotForkMutexEntry *entry;
+
+    crucible_hot_fork_mutex_registry_lock();
+    entry = crucible_hot_fork_mutex_entry(mutex);
+    if (entry) {
+        if (qatomic_read(&entry->acquisition_waiters) == 0) {
+            qatomic_set(&entry->ownership_valid, false);
+        } else {
+            qatomic_dec(&entry->acquisition_waiters);
+        }
+    }
+    crucible_hot_fork_mutex_registry_unlock();
+}
+
+static void crucible_hot_fork_mutex_acquired(QemuMutex *mutex)
+{
+    CrucibleHotForkMutexEntry *entry;
+    int64_t thread_id;
+    int64_t owner;
+    uint32_t depth;
+
+    crucible_hot_fork_mutex_registry_lock();
+    entry = crucible_hot_fork_mutex_entry(mutex);
+    if (!entry) {
+        crucible_hot_fork_mutex_registry_unlock();
+        return;
+    }
+
+    thread_id = qemu_get_thread_id();
+    owner = qatomic_read(&entry->owner_thread_id);
+    depth = qatomic_read(&entry->recursion_depth);
+
+    if (entry->recursive && owner == thread_id && depth > 0) {
+        if (depth == UINT32_MAX) {
+            qatomic_set(&entry->ownership_valid, false);
+        } else {
+            qatomic_set(&entry->recursion_depth, depth + 1);
+        }
+    } else {
+        if (owner != 0 || depth != 0) {
+            qatomic_set(&entry->ownership_valid, false);
+        }
+        qatomic_set(&entry->owner_thread_id, thread_id);
+        qatomic_set(&entry->recursion_depth, 1);
+    }
+    if (qatomic_read(&entry->acquisition_waiters) == 0) {
+        qatomic_set(&entry->ownership_valid, false);
+    } else {
+        qatomic_dec(&entry->acquisition_waiters);
+    }
+    crucible_hot_fork_mutex_registry_unlock();
+}
+
+static void crucible_hot_fork_mutex_unlock_begin(QemuMutex *mutex)
+{
+    CrucibleHotForkMutexEntry *entry;
+    int64_t thread_id;
+    int64_t owner;
+    uint32_t depth;
+
+    crucible_hot_fork_mutex_registry_lock();
+    entry = crucible_hot_fork_mutex_entry(mutex);
+    if (!entry) {
+        crucible_hot_fork_mutex_registry_unlock();
+        return;
+    }
+
+    thread_id = qemu_get_thread_id();
+    owner = qatomic_read(&entry->owner_thread_id);
+    depth = qatomic_read(&entry->recursion_depth);
+
+    qatomic_set(&entry->unlock_active, true);
+    if (owner != thread_id || depth == 0) {
+        qatomic_set(&entry->ownership_valid, false);
+    }
+    if (entry->recursive && depth > 1) {
+        qatomic_set(&entry->recursion_depth, depth - 1);
+    } else {
+        qatomic_set(&entry->recursion_depth, 0);
+        qatomic_set(&entry->owner_thread_id, 0);
+    }
+    crucible_hot_fork_mutex_registry_unlock();
+}
+
+static void crucible_hot_fork_mutex_unlock_end(QemuMutex *mutex)
+{
+    CrucibleHotForkMutexEntry *entry;
+
+    crucible_hot_fork_mutex_registry_lock();
+    entry = crucible_hot_fork_mutex_entry(mutex);
+    if (entry) {
+        qatomic_set(&entry->unlock_active, false);
+    }
+    crucible_hot_fork_mutex_registry_unlock();
+}
+
+static void crucible_hot_fork_mutex_condition_wait_begin(QemuMutex *mutex)
+{
+    CrucibleHotForkMutexEntry *entry;
+    int64_t owner;
+    uint32_t depth;
+
+    crucible_hot_fork_mutex_registry_lock();
+    entry = crucible_hot_fork_mutex_entry(mutex);
+    if (!entry) {
+        crucible_hot_fork_mutex_registry_unlock();
+        return;
+    }
+
+    owner = qatomic_read(&entry->owner_thread_id);
+    depth = qatomic_read(&entry->recursion_depth);
+
+    if (qatomic_fetch_inc(&entry->condition_waiters) == 0) {
+        qatomic_set(&entry->condition_waiter_thread_id,
+                    qemu_get_thread_id());
+    } else {
+        /* Concurrent waiters have no single identity to carry. */
+        qatomic_set(&entry->condition_waiter_thread_id, -1);
+    }
+    if (owner != qemu_get_thread_id() || depth != 1 || entry->recursive) {
+        qatomic_set(&entry->ownership_valid, false);
+    }
+    qatomic_set(&entry->recursion_depth, 0);
+    qatomic_set(&entry->owner_thread_id, 0);
+    crucible_hot_fork_mutex_registry_unlock();
+}
+
+static void crucible_hot_fork_mutex_condition_wait_end(QemuMutex *mutex)
+{
+    CrucibleHotForkMutexEntry *entry;
+    int64_t owner;
+    uint32_t depth;
+
+    crucible_hot_fork_mutex_registry_lock();
+    entry = crucible_hot_fork_mutex_entry(mutex);
+    if (!entry) {
+        crucible_hot_fork_mutex_registry_unlock();
+        return;
+    }
+
+    owner = qatomic_read(&entry->owner_thread_id);
+    depth = qatomic_read(&entry->recursion_depth);
+
+    if (owner != 0 || depth != 0) {
+        qatomic_set(&entry->ownership_valid, false);
+    }
+    qatomic_set(&entry->owner_thread_id, qemu_get_thread_id());
+    qatomic_set(&entry->recursion_depth, 1);
+    if (qatomic_read(&entry->condition_waiters) == 0) {
+        qatomic_set(&entry->ownership_valid, false);
+    } else if (qatomic_fetch_dec(&entry->condition_waiters) == 1) {
+        qatomic_set(&entry->condition_waiter_thread_id, 0);
+    }
+    crucible_hot_fork_mutex_registry_unlock();
+}
+
+static int crucible_hot_fork_mutex_inventory_entry_compare(
+    const void *left_pointer, const void *right_pointer)
+{
+    const QemuMutexHotForkInventoryEntry *left = left_pointer;
+    const QemuMutexHotForkInventoryEntry *right = right_pointer;
+
+    if (left->mutex_id < right->mutex_id) {
+        return -1;
+    }
+    return left->mutex_id > right->mutex_id;
+}
+
+void qemu_mutex_hot_fork_inventory(QemuMutexHotForkInventory *inventory)
+{
+    size_t count = 0;
+    size_t index;
+
+    *inventory = (QemuMutexHotForkInventory) { 0 };
+    crucible_hot_fork_mutex_registry_lock();
+    inventory->generation = crucible_hot_fork_mutex_generation;
+    inventory->overflowed = crucible_hot_fork_mutex_overflowed ||
+        crucible_hot_fork_mutex_inconsistent;
+    inventory->entries = g_new0(QemuMutexHotForkInventoryEntry,
+                                crucible_hot_fork_mutex_count);
+    inventory->entry_count = crucible_hot_fork_mutex_count;
+
+    for (index = 0; index < QEMU_HOT_FORK_MUTEX_INVENTORY_MAX; index++) {
+        CrucibleHotForkMutexEntry *mutex = &crucible_hot_fork_mutexes[index];
+        QemuMutexHotForkInventoryEntry *entry;
+
+        if (!mutex->active) {
+            continue;
+        }
+        g_assert(count < inventory->entry_count);
+        entry = &inventory->entries[count++];
+        entry->mutex_id = mutex->registration_id;
+        entry->owner_thread_id = qatomic_read(&mutex->owner_thread_id);
+        entry->recursion_depth = qatomic_read(&mutex->recursion_depth);
+        entry->acquisition_waiters = qatomic_read(
+            &mutex->acquisition_waiters);
+        entry->condition_waiters = qatomic_read(&mutex->condition_waiters);
+        entry->recursive = mutex->recursive;
+        entry->unlock_active = qatomic_read(&mutex->unlock_active);
+        entry->ownership_valid = qatomic_read(&mutex->ownership_valid);
+    }
+    g_assert(count == inventory->entry_count);
+    if (inventory->entry_count > 1) {
+        qsort(inventory->entries, inventory->entry_count,
+              sizeof(inventory->entries[0]),
+              crucible_hot_fork_mutex_inventory_entry_compare);
+    }
+    crucible_hot_fork_mutex_registry_unlock();
+}
+
+void qemu_mutex_hot_fork_inventory_destroy(
+    QemuMutexHotForkInventory *inventory)
+{
+    g_free(inventory->entries);
+    *inventory = (QemuMutexHotForkInventory) { 0 };
+}
