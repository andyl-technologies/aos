+    envelope_methods = "\n\n".join(extract["function"](envelope, name) for name in (
+        "static CrucibleNodeRegistrationChild *node_envelope_child_locked(",
+        "static bool node_envelope_child_current(",
+        "static bool node_envelope_transfer(",
+        "static int node_envelope_free(",
+        "static int node_envelope_release(",
+        "static bool node_envelope_split("))
+    owned_definitions = {name: body for name, _, _, body
+                         in extract["function_definitions"](node)}
+    methods = "\n\n".join(owned_definitions[name] for name in (
+        "node_event_reserve_owned", "node_reservation_restore_owned")) + "\n\n" + methods
+    declarations = "\n".join(line for line in node.splitlines() if line.startswith((
+        "#define CRUCIBLE_NODE_EVENT_CAPACITY ",
+        "static size_t crucible_node_event_count;",
+        "static uint64_t crucible_node_event_sequence;",
+        "static bool crucible_node_event_terminal;",
+        "static size_t crucible_node_event_reserved;",
+        "static uint64_t crucible_node_event_sequence_reserved;",
+        "static bool crucible_node_vmstate_restoring;",
+    )))
+    # No actual pending callback exists in this component. The registration
+    # component compiles this bridge against the real pending providers.
+    storage = storage.replace(extract["function"](
+        storage, "int qemu_crucible_fault_node_state_returned_v1("), "")
+    current = extract["function"](node, "static bool node_reservation_current(")
+    post = extract["function"](storage, "static void node_storage_retire_post(")
+    failed_post = post.replace(
+        "if (qemu_thread_is_self(&crucible_node_storage.returning[kind].thread))",
+        "if (false)")
+    assert failed_post != post
+    variants = {
+        "positive": (storage, methods),
+        "omit-selected-prebirth-refusal": (
+            storage.replace("qemu_plugin_crucible_startup_source_retained() ||", "false ||").replace(
+                "!qemu_plugin_crucible_startup_source_retained() &&", "true &&"), methods),
+        "bypass-reservation-membership": (
+            storage, methods.replace(current, current[:current.index("{")] + "{ return true; }")),
+        "omit-operation-serialization": (
+            storage.replace("g_rec_mutex_lock(&crucible_node_storage.operations);", "").replace(
+                "g_rec_mutex_unlock(&crucible_node_storage.operations);", ""), methods),
+        "retain-after-independent-post-refusal": (
+            storage.replace(post, failed_post), methods),
+        "omit-physical-return-journal": (
+            storage.replace(post, post[:post.index("{")] + "{}"), methods),
+    }
+    proof = {}
+    for name, (actual_storage, actual_methods) in variants.items():
+        generated = output / f"{name}.c"
+        generated.write_text(
+            '#include "qemu/osdep.h"\n#include <assert.h>\n#include <sys/wait.h>\n'
+            '#include "qemu/atomic.h"\n#include "qemu/crucible-fault-registration.h"\n'
+            '#include "qemu/crucible-fault.h"\n#include "qobject/qobject-lifetime.h"\n'
+            'static bool selected;\n'
+            '#define qemu_plugin_crucible_startup_source_retained() selected\n'
+            '#define error_report(...) fprintf(stderr, __VA_ARGS__)\n' +
+            extract["function"](thread, "void qemu_thread_get_self(") + "\n" +
+            extract["function"](thread, "bool qemu_thread_is_self(") + "\n" +
+            ("#define EXPECT_FAILED_POST\n" if name == "retain-after-independent-post-refusal" else "") +
+            actual_storage + "\n" + registration_declarations + "\n" +
+            registration_methods + "\n" + "typedef struct CrucibleNodeEnvelope CrucibleNodeEnvelope;\n" +
+            envelope_declarations + "\n" + reservation + "\n" + declarations + "\n" +
+            envelope_methods + "\n" + actual_methods + "\n" + CHECKS)
+        binary = output / name
+        command = [*shlex.split(os.environ.get("CC", "cc")),
+                   *shlex.split(os.environ.get("CFLAGS", "")), str(generated),
+                   "-o", str(binary), *shlex.split(os.environ.get("LDFLAGS", ""))]
+        (output / f"{name}.compile-command.json").write_text(json.dumps(command, indent=2) + "\n")
+        subprocess.run(command, check=True)
+        result = subprocess.run([str(binary)], stdout=subprocess.PIPE,
+                                stderr=subprocess.STDOUT, text=True, timeout=30,
+                                cwd=output)
+        (output / f"{name}.log").write_text(result.stdout)
+        expected_assertion = {
+            "omit-selected-prebirth-refusal": "!qemu_crucible_fault_event_reserve(2)",
+            "bypass-reservation-membership": "!node_reservation_current(&foreign)",
+            "omit-physical-return-journal": "node_storage_returned(split",
+            "omit-operation-serialization": "!entered",
+        }.get(name)
+        if result.returncode != (0 if name in ("positive", "retain-after-independent-post-refusal") else -6):
+            raise RuntimeError(f"unexpected {name}: {result.returncode}\n{result.stdout}")
+        if expected_assertion and expected_assertion not in result.stdout:
+            raise RuntimeError(f"{name} missed its exact causal assertion")
+        proof[name] = {"returncode": result.returncode, "output": result.stdout}
+    (output / "proof.json").write_text(json.dumps(proof, indent=2) + "\n")
+    print(proof["positive"]["output"], end="")
+    print("PASS four independently rebuilt storage defects reached exact assertions; failed-post retention passed")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/unit/test-crucible-fdc-fingerprint.c b/tests/unit/test-crucible-fdc-fingerprint.c
new file mode 100644
index 0000000000000000000000000000000000000000..8c972db14596c1fc9b9a80e2542bb0587145627c
--- /dev/null
+++ b/tests/unit/test-crucible-fdc-fingerprint.c
@@ -0,0 +1,225 @@
+/*
+ * Floppy disk controller fingerprint projection tests
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "qemu/osdep.h"
+
+#include "block/block_int-global-state.h"
+#include "hw/block/fdc-fingerprint.h"
+#include "io/channel-file.h"
+#include "qemu/main-loop.h"
+#include "qemu/module.h"
+#include "system/block-backend.h"
+
+static BlockDriver test_media_driver = {
+    .format_name = "crucible-fdc-test-media",
+    .instance_size = 1,
+};
+
+static int64_t test_virtual_clock_ps(void)
+{
+    return 0;
+}
+
+static void initialize_fdc(FDCtrl *fdctrl, uint8_t fifo[512],
+                           QEMUTimer *result_timer)
+{
+    memset(fdctrl, 0, sizeof(*fdctrl));
+    memset(fifo, 0, 512);
+    timer_init_ns(result_timer, QEMU_CLOCK_VIRTUAL, NULL, NULL);
+
+    fdctrl->fifo = fifo;
+    fdctrl->fifo_size = 512;
+    fdctrl->result_timer = result_timer;
+    fdctrl->phase = 1;
+    fdctrl->num_floppies = MAX_FD;
+    for (size_t index = 0; index < MAX_FD; index++) {
+        fdctrl->drives[index].drive = FLOPPY_DRIVE_TYPE_NONE;
+        fdctrl->drives[index].disk = FLOPPY_DRIVE_TYPE_NONE;
+        fdctrl->drives[index].ro = true;
+        fdctrl->drives[index].media_changed = 1;
+    }
+}
+
+static GBytes *project_fdc(FDCtrl *fdctrl, bool expected_success)
+{
+    char *path = NULL;
+    int read_fd;
+    int write_fd = g_file_open_tmp("qemu-fdc-fingerprint-XXXXXX", &path,
+                                   NULL);
+    QIOChannelFile *channel;
+    QEMUFile *file;
+    Error *error = NULL;
+    struct stat stat_buffer;
+    bool success;
+
+    g_assert_cmpint(write_fd, >=, 0);
+    read_fd = dup(write_fd);
+    g_assert_cmpint(read_fd, >=, 0);
+    unlink(path);
+    g_free(path);
+    channel = qio_channel_file_new_fd(write_fd);
+    file = qemu_file_new_output(QIO_CHANNEL(channel));
+
+    success = fdctrl_state_fingerprint_projection(file, fdctrl, &error);
+    g_assert_cmpint(success, ==, expected_success);
+    if (!success) {
+        g_assert_nonnull(error);
+        error_free(error);
+        qemu_fclose(file);
+        object_unref(OBJECT(channel));
+
+        g_assert_cmpint(fstat(read_fd, &stat_buffer), ==, 0);
+        g_assert_cmpint(stat_buffer.st_size, ==, 0);
+        close(read_fd);
+        return NULL;
+    }
+    g_assert_null(error);
+    g_assert_cmpint(qemu_fflush(file), ==, 0);
+    g_assert_cmpint(qemu_fclose(file), ==, 0);
+
+    g_assert_cmpint(fstat(read_fd, &stat_buffer), ==, 0);
+    g_autofree uint8_t *data = g_malloc(stat_buffer.st_size);
+    g_assert_cmpint(pread(read_fd, data, stat_buffer.st_size, 0), ==,
+                    stat_buffer.st_size);
+    GBytes *bytes = g_bytes_new(data, stat_buffer.st_size);
+    object_unref(OBJECT(channel));
+    close(read_fd);
+    return bytes;
+}
+
+static void assert_fdc_distinct(FDCtrl *candidate, const GBytes *baseline)
+{
+    g_autoptr(GBytes) candidate_bytes = project_fdc(candidate, true);
+
+    g_assert_false(g_bytes_equal(baseline, candidate_bytes));
+}
+
+static void test_fdc_mutable_state(void)
+{
+    uint8_t baseline_fifo[512];
+    uint8_t candidate_fifo[512];
+    QEMUTimer baseline_timer;
+    QEMUTimer candidate_timer;
+    FDCtrl baseline_state;
+    FDCtrl candidate;
+    g_autoptr(GBytes) baseline = NULL;
+    g_autoptr(GBytes) subns_deadline = NULL;
+    g_autoptr(GBytes) next_subns_deadline = NULL;
+
+    initialize_fdc(&baseline_state, baseline_fifo, &baseline_timer);
+    initialize_fdc(&candidate, candidate_fifo, &candidate_timer);
+    baseline = project_fdc(&baseline_state, true);
+
+    candidate.sra = 1;
+    assert_fdc_distinct(&candidate, baseline);
+
+    initialize_fdc(&candidate, candidate_fifo, &candidate_timer);
+    candidate.fifo[17] = 1;
+    assert_fdc_distinct(&candidate, baseline);
+
+    initialize_fdc(&candidate, candidate_fifo, &candidate_timer);
+    candidate.data_pos = 1;
+    assert_fdc_distinct(&candidate, baseline);
+
+    initialize_fdc(&candidate, candidate_fifo, &candidate_timer);
+    candidate.timer0 = 1;
+    assert_fdc_distinct(&candidate, baseline);
+
+    initialize_fdc(&candidate, candidate_fifo, &candidate_timer);
+    candidate.drives[0].head = 1;
+    assert_fdc_distinct(&candidate, baseline);
+
+    initialize_fdc(&candidate, candidate_fifo, &candidate_timer);
+    candidate.drives[0].media_rate = 1;
+    assert_fdc_distinct(&candidate, baseline);
+
+    initialize_fdc(&candidate, candidate_fifo, &candidate_timer);
+    candidate.reset_sensei = 1;
+    assert_fdc_distinct(&candidate, baseline);
+
+    initialize_fdc(&candidate, candidate_fifo, &candidate_timer);
+    timer_mod_ps(candidate.result_timer, 500);
+    assert_fdc_distinct(&candidate, baseline);
+
+    subns_deadline = project_fdc(&candidate, true);
+    timer_mod_ps(candidate.result_timer, 501);
+    next_subns_deadline = project_fdc(&candidate, true);
+    g_assert_false(g_bytes_equal(subns_deadline, next_subns_deadline));
+    timer_del(candidate.result_timer);
+
+    initialize_fdc(&candidate, candidate_fifo, &candidate_timer);
+    candidate.phase = 2;
+    assert_fdc_distinct(&candidate, baseline);
+
+    initialize_fdc(&candidate, candidate_fifo, &candidate_timer);
+    candidate.drives[0].blk = blk_new(qemu_get_aio_context(), 0, BLK_PERM_ALL);
+    candidate.drives[0].drive = FLOPPY_DRIVE_TYPE_288;
+    candidate.drives[0].last_sect = UINT8_MAX;
+    candidate.drives[0].max_track = UINT8_MAX;
+    assert_fdc_distinct(&candidate, baseline);
+    blk_unref(candidate.drives[0].blk);
+}
+
+static void test_fdc_rejects_unrestorable_state(void)
+{
+    uint8_t fifo[512];
+    QEMUTimer timer;
+    FDCtrl fdctrl;
+    BlockDriverState *media;
+
+    initialize_fdc(&fdctrl, fifo, &timer);
+    fdctrl.fifo_size = 511;
+    g_assert_null(project_fdc(&fdctrl, false));
+
+    initialize_fdc(&fdctrl, fifo, &timer);
+    fdctrl.phase = 0;
+    g_assert_null(project_fdc(&fdctrl, false));
+
+    initialize_fdc(&fdctrl, fifo, &timer);
+    fdctrl.drives[0].blk = blk_new(qemu_get_aio_context(), 0, BLK_PERM_ALL);
+    fdctrl.drives[0].drive = FLOPPY_DRIVE_TYPE_288;
+    fdctrl.drives[0].last_sect = UINT8_MAX;
+    fdctrl.drives[0].max_track = UINT8_MAX;
+    fdctrl.drives[1].blk = blk_new(qemu_get_aio_context(), 0, BLK_PERM_ALL);
+    media = bdrv_new_open_driver(&test_media_driver, "fdc-test-media", 0,
+                                 &error_abort);
+    blk_insert_bs(fdctrl.drives[1].blk, media, &error_abort);
+    g_assert_null(project_fdc(&fdctrl, false));
+    blk_remove_bs(fdctrl.drives[1].blk);
+    bdrv_unref(media);
+    blk_unref(fdctrl.drives[0].blk);
+    blk_unref(fdctrl.drives[1].blk);
+
+    initialize_fdc(&fdctrl, fifo, &timer);
+    fdctrl.drives[0].drive = FLOPPY_DRIVE_TYPE_AUTO;
+    g_assert_null(project_fdc(&fdctrl, false));
+
+    initialize_fdc(&fdctrl, fifo, &timer);
+    fdctrl.drives[0].drive = FLOPPY_DRIVE_TYPE__MAX;
+    g_assert_null(project_fdc(&fdctrl, false));
+
+    initialize_fdc(&fdctrl, fifo, &timer);
+    fdctrl.drives[0].last_sect = 1;
+    g_assert_null(project_fdc(&fdctrl, false));
+
+    initialize_fdc(&fdctrl, fifo, &timer);
+    fdctrl.drives[0].media_changed = 0;
+    g_assert_null(project_fdc(&fdctrl, false));
+}
+
+int main(int argc, char **argv)
+{
+    module_call_init(MODULE_INIT_QOM);
+    bdrv_init();
+    qemu_init_main_loop(&error_abort);
+    qemu_timer_enable_tcg_ps_clock(test_virtual_clock_ps, NULL);
+
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/crucible/fdc/mutable-state", test_fdc_mutable_state);
+    g_test_add_func("/crucible/fdc/unrestorable-state",
+                    test_fdc_rejects_unrestorable_state);
+    return g_test_run();
+}
diff --git a/tests/unit/test-crucible-flatview-custody.py b/tests/unit/test-crucible-flatview-custody.py
new file mode 100644
index 0000000000000000000000000000000000000000..06b816aee53b5365f362378fb7434b4b1b67345f
--- /dev/null
+++ b/tests/unit/test-crucible-flatview-custody.py
@@ -0,0 +1,406 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Compile the actual one-attempt view pin with real RCU and atomic races.
+
+AddressSpace/FlatView records, BQL and nominal journals are factual component
+inputs, without initialized topology or Source enrollment. The supplied
+source-built utility archive runs actual RCU; a rendezvous after the real
+atomic load lets a real foreign thread change the count before the actual
+compare/exchange. Ordinary concrete QOM input types exercise real allocation
+and extra-reference return, without CPU realization. An SDK-post boundary
+always refuses after checking those return effects. No accepting Source,
+translation, selected getter, last-view destructor or device runs.
+"""
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import runpy
+import shlex
+import subprocess
+
+
+PREFIX = r'''
+#include "qemu/osdep.h"
+#include "system/memory.h"
+#include "system/ramblock.h"
+#include "qemu/main-loop.h"
+#include "qemu/crucible-apic-getter.h"
+#include "hw/core/cpu.h"
+#include "plugins/crucible-startup-source.h"
+#include "qemu/module.h"
+
+typedef struct QemuCrucibleCpuSourceAllocationOwner QemuCrucibleCpuSourceAllocationOwner;
+
+static QemuMutex component_ram_mutex;
+
+void qemu_mutex_lock_ramlist(void)
+{
+    qemu_mutex_lock(&component_ram_mutex);
+}
+
+void qemu_mutex_unlock_ramlist(void)
+{
+    qemu_mutex_unlock(&component_ram_mutex);
+}
+
+static bool input_bql, race, retiring;
+static unsigned loads;
+static pthread_barrier_t loaded, changed;
+static FlatView input_view = { .ref = 1 };
+static AddressSpace input_space;
+
+static bool input_bql_locked(void)
+{
+    return input_bql;
+}
+
+#define bql_locked input_bql_locked
+
+static unsigned read_reference(unsigned *references)
+{
+    unsigned value = qatomic_read(references);
+
+    assert(get_ptr_rcu_reader()->depth > 0);
+    loads++;
+    if (race) {
+        pthread_barrier_wait(&loaded);
+        pthread_barrier_wait(&changed);
+    }
+    return value;
+}
+
+/* Only the acquisition body's atomic load is instrumented. The real load
+ * above and compare/exchange below are unchanged. */
+#undef qatomic_read
+#define qatomic_read(pointer) read_reference(pointer)
+'''
+
+
+CHECKS = r'''
+#undef qatomic_read
+#define qatomic_read(pointer) __atomic_load_n(pointer, __ATOMIC_SEQ_CST)
+
+static void *change_reference(void *opaque)
+{
+    pthread_barrier_wait(&loaded);
+    if (retiring) {
+        qatomic_dec(&input_view.ref);
+    } else {
+        qatomic_inc(&input_view.ref);
+    }
+    pthread_barrier_wait(&changed);
+    return NULL;
+}
+
+static void flatview_destroy(FlatView *view)
+{
+    abort();
+}
+
+#define trace_flatview_destroy_rcu(...) abort()
+'''
+
+
+MAIN = r'''
+int main(void)
+{
+    FlatView *out = NULL;
+    QemuCrucibleApicGetterLoan journal = { .first_status = -ENOTSUP };
+    pthread_t thread;
+
+    input_space.current_map = &input_view;
+    assert(address_space_get_flatview_once(&input_space, &out) == -EPERM);
+    assert(!out && input_view.ref == 1 && loads == 0);
+    input_bql = true;
+    assert(address_space_get_flatview_once(NULL, &out) == -EPERM);
+    assert(address_space_get_flatview_once(&input_space, NULL) == -EPERM);
+    out = &input_view;
+    assert(address_space_get_flatview_once(&input_space, &out) == -EPERM);
+    assert(out == &input_view && input_view.ref == 1 && loads == 0);
+    out = NULL;
+    input_space.current_map = NULL;
+    assert(address_space_get_flatview_once(&input_space, &out) == -ENOENT);
+    assert(!out && input_view.ref == 1 && loads == 0);
+    input_space.current_map = &input_view;
+
+    input_view.ref = 0;
+    assert(address_space_get_flatview_once(&input_space, &out) == -ESTALE);
+    assert(!out && input_view.ref == 0);
+    input_view.ref = UINT_MAX;
+    assert(address_space_get_flatview_once(&input_space, &out) == -EOVERFLOW);
+    assert(!out && input_view.ref == UINT_MAX);
+
+    input_view.ref = 1;
+    assert(address_space_get_flatview_once(&input_space, &out) == 0);
+    assert(out == &input_view && input_view.ref == 2);
+    journal.view = out;
+    journal.view_acquired = true;
+    journal.view_unref_attempted = true;
+    apic_getter_view_return(&journal);
+    assert(input_view.ref == 2 && !journal.view_unref_returned);
+    journal.view_unref_attempted = false;
+    apic_getter_view_return(&journal);
+    assert(journal.view_unref_attempted && journal.view_unref_returned);
+    assert(journal.first_status == -ENOTSUP && !journal.post_recorded);
+    assert(input_view.ref == 1);
+    apic_getter_view_return(&journal);
+    out = NULL;
+    assert(input_view.ref == 1);
+    assert(get_ptr_rcu_reader()->depth == 0);
+
+    pthread_barrier_init(&loaded, NULL, 2);
+    pthread_barrier_init(&changed, NULL, 2);
+    race = true;
+    loads = 0;
+    assert(pthread_create(&thread, NULL, change_reference, NULL) == 0);
+    assert(address_space_get_flatview_once(&input_space, &out) == -EAGAIN);
+    assert(pthread_join(thread, NULL) == 0);
+    assert(!out && input_view.ref == 2 && loads == 1);
+    assert(get_ptr_rcu_reader()->depth == 0);
+
+    /* This is a factual zero-count transition, without last-body disposal.
+     * RCU still protects the input record across the failed CAS. */
+    input_view.ref = 1;
+    retiring = true;
+    loads = 0;
+    assert(pthread_create(&thread, NULL, change_reference, NULL) == 0);
+    assert(address_space_get_flatview_once(&input_space, &out) == -EAGAIN);
+    assert(pthread_join(thread, NULL) == 0);
+    assert(!out && input_view.ref == 0 && loads == 1);
+    assert(get_ptr_rcu_reader()->depth == 0);
+    pthread_barrier_destroy(&loaded);
+    pthread_barrier_destroy(&changed);
+    check_return_post();
+    puts("PASS actual view pin/unref and RCU/atomic race; no initialized topology or Source");
+    return 0;
+}
+'''
+
+
+RETURN_POST = r'''
+static QemuCrucibleApicGetterLoan *return_input;
+static bool expect_returns;
+static unsigned return_posts;
+
+/* This boundary always refuses. It cannot issue an Original or accept any
+ * Source owner. The private physical helper has factual preconditions only. */
+int qemu_crucible_source_initial_cpu_sdk_post_v1(CPUState *cpu,
+    struct QemuCrucibleInitialCpuParticipant **holder, int first_status)
+{
+    assert(cpu == return_input->cpu && !first_status);
+    assert(holder == &cpu->crucible_initial_participant);
+    assert(return_input->return_post_attempted);
+    assert(!return_input->return_post_recorded);
+    if (expect_returns) {
+        assert(input_view.ref == 1);
+        assert(OBJECT(cpu)->ref == 1 && return_input->child->ref == 1);
+        assert(return_input->chunk.owner->ref == 1);
+        assert(return_input->chunk.region_object->ref == 1);
+        assert(memory_region_read_custody_returned(&return_input->chunk));
+        assert(return_input->view_unref_returned);
+        assert(return_input->child_unref_returned && return_input->cpu_unref_returned);
+    } else {
+        assert(input_view.ref == 2);
+        assert(return_input->chunk.owner->ref == 2);
+        assert(return_input->chunk.region_object->ref == 2);
+        assert(!return_input->chunk.return_attempted);
+        assert(!return_input->chunk.region_return_attempted);
+        assert(OBJECT(cpu)->ref == 2 && return_input->child->ref == 2);
+    }
+    return_posts++;
+    return -ETIMEDOUT;
+}
+
+static void check_return_post(void)
+{
+    static const TypeInfo input_type = {
+        .name = "getter-return-component-input",
+        .parent = TYPE_OBJECT,
+        .instance_size = sizeof(CPUState),
+    };
+    static const TypeInfo child_type = {
+        .name = "getter-return-child-input",
+        .parent = TYPE_OBJECT,
