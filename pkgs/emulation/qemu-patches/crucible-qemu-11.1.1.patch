+void qemu_plugin_register_accelerator_cb(
+    qemu_plugin_accelerator_submit_cb_t submit_cb,
+    qemu_plugin_accelerator_poll_cb_t poll_cb,
+    qemu_plugin_accelerator_wait_cb_t wait_cb,
+    qemu_plugin_accelerator_restore_begin_cb_t restore_begin_cb,
+    qemu_plugin_accelerator_restore_cb_t restore_cb,
+    qemu_plugin_accelerator_restore_commit_cb_t restore_commit_cb,
+    qemu_plugin_accelerator_restore_abort_cb_t restore_abort_cb,
+    qemu_plugin_accelerator_cancel_cb_t cancel_cb, void *userdata)
+{
+#ifdef CONFIG_PLUGIN
+    QemuCrucibleNativeGroupRegistrar registrar;
+    QemuCrucibleNativeGroupDescriptorView actual;
+    const QemuCrucibleNativeGroupDescriptorView expected[] = {
+        {
+            .coordinate = &accelerator_submit_cb,
+            .function = submit_cb,
+            .userdata = userdata,
+            .userdata_coordinate = &accelerator_userdata,
+            .kind = QEMU_CRUCIBLE_NATIVE_REGISTERED,
+        },
+        {
+            .coordinate = &accelerator_poll_cb,
+            .function = poll_cb,
+            .userdata = userdata,
+            .userdata_coordinate = &accelerator_userdata,
+            .kind = QEMU_CRUCIBLE_NATIVE_REGISTERED,
+        },
+        {
+            .coordinate = &accelerator_wait_cb,
+            .function = wait_cb,
+            .userdata = userdata,
+            .userdata_coordinate = &accelerator_userdata,
+            .kind = QEMU_CRUCIBLE_NATIVE_REGISTERED,
+        },
+        {
+            .coordinate = &accelerator_restore_begin_cb,
+            .function = restore_begin_cb,
+            .userdata = userdata,
+            .userdata_coordinate = &accelerator_userdata,
+            .kind = QEMU_CRUCIBLE_NATIVE_REGISTERED,
+        },
+        {
+            .coordinate = &accelerator_restore_cb,
+            .function = restore_cb,
+            .userdata = userdata,
+            .userdata_coordinate = &accelerator_userdata,
+            .kind = QEMU_CRUCIBLE_NATIVE_REGISTERED,
+        },
+        {
+            .coordinate = &accelerator_restore_commit_cb,
+            .function = restore_commit_cb,
+            .userdata = userdata,
+            .userdata_coordinate = &accelerator_userdata,
+            .kind = QEMU_CRUCIBLE_NATIVE_REGISTERED,
+        },
+        {
+            .coordinate = &accelerator_restore_abort_cb,
+            .function = restore_abort_cb,
+            .userdata = userdata,
+            .userdata_coordinate = &accelerator_userdata,
+            .kind = QEMU_CRUCIBLE_NATIVE_REGISTERED,
+        },
+        {
+            .coordinate = &accelerator_cancel_cb,
+            .function = cancel_cb,
+            .userdata = userdata,
+            .userdata_coordinate = &accelerator_userdata,
+            .kind = QEMU_CRUCIBLE_NATIVE_REGISTERED,
+        },
+    };
+
+    if (qemu_plugin_crucible_native_group_begin_v1(
+            QEMU_CRUCIBLE_NATIVE_GROUP_ACCELERATOR, expected, ARRAY_SIZE(expected),
+            &registrar) ||
+        qemu_plugin_crucible_native_group_effect_begin_v1(&registrar)) {
+        qemu_plugin_crucible_native_group_finish_v1(&registrar);
+        return;
+    }
+
+    qemu_plugin_crucible_native_group_member_attempt_v1(&registrar, 0);
+    qemu_plugin_crucible_native_registration_release_v1(native_accelerator_members[0]);
+    qatomic_store_release(&native_accelerator_members[0],
+        qemu_plugin_crucible_native_group_member_v1(&registrar, 0));
+    qemu_plugin_crucible_native_group_member_attempt_v1(&registrar, 1);
+    qemu_plugin_crucible_native_registration_release_v1(native_accelerator_members[1]);
+    qatomic_store_release(&native_accelerator_members[1],
+        qemu_plugin_crucible_native_group_member_v1(&registrar, 1));
+    qemu_plugin_crucible_native_group_member_attempt_v1(&registrar, 2);
+    qemu_plugin_crucible_native_registration_release_v1(native_accelerator_members[2]);
+    qatomic_store_release(&native_accelerator_members[2],
+        qemu_plugin_crucible_native_group_member_v1(&registrar, 2));
+    qemu_plugin_crucible_native_group_member_attempt_v1(&registrar, 3);
+    qemu_plugin_crucible_native_registration_release_v1(native_accelerator_members[3]);
+    qatomic_store_release(&native_accelerator_members[3],
+        qemu_plugin_crucible_native_group_member_v1(&registrar, 3));
+    qemu_plugin_crucible_native_group_member_attempt_v1(&registrar, 4);
+    qemu_plugin_crucible_native_registration_release_v1(native_accelerator_members[4]);
+    qatomic_store_release(&native_accelerator_members[4],
+        qemu_plugin_crucible_native_group_member_v1(&registrar, 4));
+    qemu_plugin_crucible_native_group_member_attempt_v1(&registrar, 5);
+    qemu_plugin_crucible_native_registration_release_v1(native_accelerator_members[5]);
+    qatomic_store_release(&native_accelerator_members[5],
+        qemu_plugin_crucible_native_group_member_v1(&registrar, 5));
+    qemu_plugin_crucible_native_group_member_attempt_v1(&registrar, 6);
+    qemu_plugin_crucible_native_registration_release_v1(native_accelerator_members[6]);
+    qatomic_store_release(&native_accelerator_members[6],
+        qemu_plugin_crucible_native_group_member_v1(&registrar, 6));
+    qemu_plugin_crucible_native_group_member_attempt_v1(&registrar, 7);
+    qemu_plugin_crucible_native_registration_release_v1(native_accelerator_members[7]);
+    qatomic_store_release(&native_accelerator_members[7],
+        qemu_plugin_crucible_native_group_member_v1(&registrar, 7));
+
+#endif
+    accelerator_submit_cb = submit_cb;
+    accelerator_poll_cb = poll_cb;
+    accelerator_wait_cb = wait_cb;
+    accelerator_restore_begin_cb = restore_begin_cb;
+    accelerator_restore_cb = restore_cb;
+    accelerator_restore_commit_cb = restore_commit_cb;
+    accelerator_restore_abort_cb = restore_abort_cb;
+    accelerator_cancel_cb = cancel_cb;
+    accelerator_userdata = userdata;
+
+#ifdef CONFIG_PLUGIN
+    if (qemu_plugin_crucible_native_accelerator_descriptor_observe_v1(0, &actual)) {
+        qemu_plugin_crucible_native_group_member_installed_v1(
+            &registrar, 0, &actual);
+    }
+    if (qemu_plugin_crucible_native_accelerator_descriptor_observe_v1(1, &actual)) {
+        qemu_plugin_crucible_native_group_member_installed_v1(
+            &registrar, 1, &actual);
+    }
+    if (qemu_plugin_crucible_native_accelerator_descriptor_observe_v1(2, &actual)) {
+        qemu_plugin_crucible_native_group_member_installed_v1(
+            &registrar, 2, &actual);
+    }
+    if (qemu_plugin_crucible_native_accelerator_descriptor_observe_v1(3, &actual)) {
+        qemu_plugin_crucible_native_group_member_installed_v1(
+            &registrar, 3, &actual);
+    }
+    if (qemu_plugin_crucible_native_accelerator_descriptor_observe_v1(4, &actual)) {
+        qemu_plugin_crucible_native_group_member_installed_v1(
+            &registrar, 4, &actual);
+    }
+    if (qemu_plugin_crucible_native_accelerator_descriptor_observe_v1(5, &actual)) {
+        qemu_plugin_crucible_native_group_member_installed_v1(
+            &registrar, 5, &actual);
+    }
+    if (qemu_plugin_crucible_native_accelerator_descriptor_observe_v1(6, &actual)) {
+        qemu_plugin_crucible_native_group_member_installed_v1(
