+bool qemu_crucible_fault_exception_decode(const QObject *object,
+                                          CPUFaultException *exception)
+{
+    QDict *dict = qobject_to(QDict, object);
+    QDict *record;
+    const char *architecture;
+    const char *record_kind;
+    uint32_t vector;
+    uint64_t syndrome, fault_address;
+
+    if (!node_json_exception(object)) {
+        return false;
+    }
+    memset(exception, 0, sizeof(*exception));
+    architecture = qdict_get_str(dict, "architecture");
+    exception->architecture = strcmp(architecture, "x86_64") == 0 ?
+        CPU_FAULT_EXCEPTION_X86_64 : CPU_FAULT_EXCEPTION_AARCH64;
+    if (!node_json_u32(qdict_get(dict, "vector"), &vector) ||
+        !node_json_u64(qdict_get(dict, "syndrome"), &syndrome)) {
+        return false;
+    }
+    exception->vector = vector;
+    exception->syndrome = syndrome;
+    exception->before_instruction = qdict_get_bool(
+        dict, "before_instruction");
+    exception->maskable = qdict_get_bool(dict, "maskable");
+    exception->has_fault_address =
+        !node_json_null(qdict_get(dict, "fault_address"));
+    if (exception->has_fault_address) {
+        if (!node_json_u64(qdict_get(dict, "fault_address"), &fault_address)) {
+            return false;
+        }
+        exception->fault_address = fault_address;
+    }
+    record = qdict_get_qdict(dict, "record");
+    record_kind = qdict_get_str(record, "kind");
+    exception->record = strcmp(record_kind, "architecture_default") == 0 ?
+        CPU_FAULT_EXCEPTION_ARCHITECTURE_DEFAULT :
+        (strcmp(record_kind, "x86_machine_check") == 0 ?
+         CPU_FAULT_EXCEPTION_X86_MACHINE_CHECK :
+         CPU_FAULT_EXCEPTION_AARCH64_RAS);
+    if (exception->record == CPU_FAULT_EXCEPTION_X86_MACHINE_CHECK) {
+        QDict *parameters = qdict_get_qdict(record, "parameters");
+        uint32_t bank;
+        uint64_t status, global_status, address, misc;
+
+        if (!node_json_u32(qdict_get(parameters, "bank"), &bank) ||
+            !node_json_u64(qdict_get(parameters, "status"), &status) ||
+            !node_json_u64(qdict_get(parameters, "global_status"),
+                           &global_status)) {
+            return false;
+        }
+        exception->x86_machine_check.bank = bank;
+        exception->x86_machine_check.status = status;
+        exception->x86_machine_check.global_status = global_status;
+        exception->x86_machine_check.corrected =
+            qdict_get_bool(parameters, "corrected");
+        exception->x86_machine_check.has_address =
+            !node_json_null(qdict_get(parameters, "address"));
+        if (exception->x86_machine_check.has_address) {
+            if (!node_json_u64(qdict_get(parameters, "address"), &address)) {
+                return false;
+            }
+            exception->x86_machine_check.address = address;
+        }
+        exception->x86_machine_check.has_misc =
+            !node_json_null(qdict_get(parameters, "misc"));
+        if (exception->x86_machine_check.has_misc) {
+            if (!node_json_u64(qdict_get(parameters, "misc"), &misc)) {
+                return false;
+            }
+            exception->x86_machine_check.misc = misc;
+        }
+    } else if (exception->record == CPU_FAULT_EXCEPTION_AARCH64_RAS) {
+        QDict *parameters = qdict_get_qdict(record, "parameters");
+        uint64_t esr, far, disr;
+
+        if (!node_json_u64(qdict_get(parameters, "esr"), &esr)) {
+            return false;
+        }
+        exception->aarch64_ras.esr = esr;
+        exception->aarch64_ras.asynchronous =
+            qdict_get_bool(parameters, "asynchronous");
+        exception->aarch64_ras.corrected =
+            qdict_get_bool(parameters, "corrected");
+        exception->aarch64_ras.fatal =
+            qdict_get_bool(parameters, "fatal");
+        exception->aarch64_ras.has_far =
+            !node_json_null(qdict_get(parameters, "far"));
+        if (exception->aarch64_ras.has_far) {
+            if (!node_json_u64(qdict_get(parameters, "far"), &far)) {
+                return false;
+            }
+            exception->aarch64_ras.far = far;
+        }
+        exception->aarch64_ras.has_disr =
+            !node_json_null(qdict_get(parameters, "disr"));
+        if (exception->aarch64_ras.has_disr) {
+            if (!node_json_u64(qdict_get(parameters, "disr"), &disr)) {
+                return false;
+            }
+            exception->aarch64_ras.disr = disr;
+        }
+    }
+    return true;
+}
