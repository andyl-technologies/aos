+++ b/plugins/crucible-control-stop.h
@@ -0,0 +1,41 @@
+/*
+ * Native causal control Stop custody
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef CRUCIBLE_CONTROL_STOP_H
+#define CRUCIBLE_CONTROL_STOP_H
+
+#include "crucible-startup-source.h"
+
+typedef struct QemuCrucibleSourceControlStopIntent
+    QemuCrucibleSourceControlStopIntent;
+
+/* Only the actual entered captured callback lends this fixed paid owner.
+ * Failed constructor/admission retains custody; no scalar refusal releases it.
+ */
+int qemu_plugin_crucible_source_control_stop_intent_borrow_v1(
+    QemuCrucibleSourceControlStopIntent **out);
+int qemu_plugin_crucible_source_control_stop_intent_current_v1(
+    QemuCrucibleSourceControlStopIntent *intent, bool admission);
+int qemu_plugin_crucible_source_control_stop_intent_source_v1(
+    QemuCrucibleSourceControlStopIntent *intent,
+    QemuCrucibleStartupInstallerBinding *installer,
+    QemuCrucibleStartupRuntimePurpose **runtime);
+void qemu_plugin_crucible_source_control_stop_intent_admitted_v1(
+    QemuCrucibleSourceControlStopIntent *intent);
+void qemu_plugin_crucible_source_control_stop_intent_stopped_v1(
+    QemuCrucibleSourceControlStopIntent *intent, int flush_status);
+
+/* Receiving must first relinquish its real semantic owner. A global Paused or
+ * resume-consumption scalar never releases that owner or its physical loan.
+ */
+int qemu_plugin_crucible_source_control_stop_intent_return_v1(
+    QemuCrucibleSourceControlStopIntent *intent);
+
+/* These are separately owned Receiving prerequisites, never success stubs. */
+int qemu_crucible_checkpoint_stop_intent_control_v1(
+    QemuCrucibleSourceControlStopIntent *intent);
+int qemu_crucible_checkpoint_stop_control_return_current_v1(
+    QemuCrucibleSourceControlStopIntent *intent);
+
+#endif
diff --git a/plugins/crucible-control-stop.inc.h b/plugins/crucible-control-stop.inc.h
new file mode 100644
index 0000000000000000000000000000000000000000..ac29e6198470fefd6e6b5c238b4e7c430cf1b0d2
--- /dev/null
+++ b/plugins/crucible-control-stop.inc.h
@@ -0,0 +1,636 @@
+/*
+ * Actual control invocation and Stop effect journals
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Included once after native callback and VM stop state declarations. The
+ * entire fixed holder is included in Source's prebirth containing debit.
+ * Main/BQL serializes it; no callback runs under actor or service locks.
+ */
+
+enum ControlDispatchPhase {
+    CONTROL_DISPATCH_NONE,
+    CONTROL_DISPATCH_PREPARING,
+    CONTROL_DISPATCH_CALLING,
+    CONTROL_DISPATCH_RETURNING,
+};
+
+struct QemuCrucibleSourceControlStopIntent {
+    QemuCrucibleSourceControlInvocation *invocation;
+    QemuThread admission_thread;
+    QemuThread completion_thread;
+    pid_t process;
+    uint64_t invocation_serial;
+    uint64_t admitted_generation;
+    uint64_t completed_generation;
+    bool held;
+    bool admission_call;
+    bool admitted;
+    bool completion_attempted;
+    bool return_proof_held;
+    int flush_status;
+    int first_status;
+    int post_status;
+};
+
+static struct {
+    struct {
+        qemu_plugin_vcpu_idle_resume_cb_t callback;
+        void *userdata;
+        CPUState *cpu;
+        QemuThread thread;
+        pid_t process;
+        QemuCrucibleSourceControlInvocation *invocation;
+        QemuCrucibleNativeInvocationTicket callback_ticket;
+        enum ControlDispatchPhase phase;
+        bool installed;
+        int begin_status;
+        int end_status;
+        int advance_status;
+        int advance_handoff_status;
+        uint64_t cleanup_serial;
+        bool cleanup;
+        bool callback_entered;
+    } dispatch;
+    struct {
+        QemuCrucibleNativeInvocationTicket ticket;
+        QemuCrucibleMainControlBorrow *borrow;
+        QemuCrucibleNativeRegistration *record;
+        CPUState *cpu;
+        int begin_status;
+        int borrow_status;
+        int payload_status;
+        int payload_return_status;
+        int return_status;
+        bool held;
+        bool returned;
+    } main;
+    int main_first_status;
+    QemuCrucibleSourceControlStopIntent stop;
+    bool admission_commit;
+    bool stopped_commit;
+} control_stop_storage;
+
+uint64_t qemu_plugin_crucible_control_stop_storage_bytes_v1(void)
+{
+    return sizeof(control_stop_storage) + sizeof(native_callback_registrations);
