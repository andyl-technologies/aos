+        &preexec_setup_owner.publisher_storage.session, &service,
+        span, sizeof(span), &view), ==, -ENOKEY);
+    g_assert_cmpint(qemu_crucible_preexec_publisher_module_current_v1(
+        &preexec_setup_owner.publisher_storage.session, &service,
+        span, sizeof(span), &view), ==, -ENOKEY);
+    g_assert_cmpint(qemu_crucible_preexec_publisher_module_return_v1(
+        &preexec_setup_owner.publisher_storage.session, &service, &returned), <, 0);
+    g_assert_cmpmem(&view, sizeof(view), &unchanged, sizeof(unchanged));
+    g_assert_cmpint(returned, ==, 0);
+    g_assert_null(preexec_setup_owner.publisher_storage.session.module_service);
+    g_assert_false(preexec_setup_owner.publisher_storage.session.module_borrowed);
