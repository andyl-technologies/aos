+    print(proof["positive"]["output"], end="")
+    print("PASS foreign-record membership defect reached the nominal refusal assertion")
+    print("PASS validation-interval defect reached the missing-entry refusal assertion")
+    print("PASS pending/staging membership and birth-interval defects reached exact refusals")
