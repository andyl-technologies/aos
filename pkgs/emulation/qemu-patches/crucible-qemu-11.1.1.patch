+        memcpy(hash->block + buffered, input, chunk);
+        buffered += chunk;
+        input += chunk;
+        len -= chunk;
+        if (buffered == sizeof(hash->block)) {
+            qcrypto_sha256_compress(hash, hash->block);
+            buffered = 0;
+        }
+    }
