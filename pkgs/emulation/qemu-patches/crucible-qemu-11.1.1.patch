+static void scenario_checkpoint_process(void)
+{
+    QemuCrucibleStartupSourceControl before;
+    GHashTable *table;
+    pid_t child;
+    int status;
+
+    fixture_prepare(0, false);
+    g_assert_cmpint(fixture_acquire(), ==, 0);
+    table = plugin.id_ht;
+    plugin.id_ht = NULL;
+    memcpy(&before, &startup_source, sizeof(before));
+    child = fork();
+    g_assert_cmpint(child, >=, 0);
+    if (child == 0) {
+        g_assert_cmpint(fixture_register_checkpoint(), ==, -EPERM);
+        g_assert_cmpmem(&startup_source, sizeof(startup_source),
+                        &before, sizeof(before));
+        _exit(0);
+    }
+    g_assert_cmpint(waitpid(child, &status, 0), ==, child);
+    g_assert_true(WIFEXITED(status));
+    g_assert_cmpint(WEXITSTATUS(status), ==, 0);
+    plugin.id_ht = table;
+    g_assert_cmpint(fixture_register_checkpoint(), ==, 0);
+    assert_checkpoint_published();
+}
