+        &startup_source.metadata_partition, bytes);
+    if (status) {
+        return startup_failure(status);
+    }
+    status = qemu_crucible_startup_source_native_metadata_check();
+    if (status) {
+        /* Even an untouched output cannot refund an already reserved allowance.
+         * Publication or original uncertainty keeps this debit to retirement. */
+        crucible_metadata_partition_record_post(
+            &startup_source.metadata_partition, status);
+    }
+    return status;
