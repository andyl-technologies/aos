+        /* Initial admission belongs to the native startup owner. Later
+         * certificate revalidation may run under another retained BQL owner,
+         * but must only observe this already sealed backend capability. */
+        if (!qemu_in_main_thread() || !bql_locked()) {
+            error_setg(errp, "managed RAM block ownership was not sealed "
+                       "by its native startup owner");
+            return -EBUSY;
