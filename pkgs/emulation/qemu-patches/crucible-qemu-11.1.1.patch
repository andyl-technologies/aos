+        OBJECT(cpu), &owner, &receipt, &generation);
+    if (status || !owner || !receipt || !generation) {
+        object_unref(OBJECT(cpu));
+        return status ? status : -ENOKEY;
+    }
+    qemu_rec_mutex_lock(&plugin.lock);
+    qemu_mutex_lock(&registry->mutex);
