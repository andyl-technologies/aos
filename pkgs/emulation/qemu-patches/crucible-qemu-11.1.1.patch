+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Exercise retained template admission with real registered eventfd input.
+
+The production reader, native control owner, monitor connection helpers and
+template continuation execute unchanged. CPU topology, QOM references, block
+barrier acquisition and serialized AIO slices are fixtures, not a linked guest
+or a proof of reconstructed process custody.
+"""
+
+import argparse
+import json
+import os
+from pathlib import Path
+import runpy
+import shlex
+import subprocess
+
+
+ROOT = Path(__file__).resolve().parents[2]
+SUPPORT = runpy.run_path(str(Path(__file__).with_name(
+    "test-crucible-control-deferred.py")))
+BASE = SUPPORT["SUPPORT"]
+definition = SUPPORT["definition"]
+
+EXTRA = r"""
+#include <sys/eventfd.h>
+#include <stdarg.h>
+#include "qemu/notify.h"
+#include "monitor/monitor-internal.h"
+#include "system/block-backend-global-state.h"
+#include "qapi/qapi-types-misc.h"
+static int poll_failure;
+static GPtrArray *allocated_bhs;
+static void qemu_plugin_control_drain_notify(void);
+static void qemu_plugin_control_drain_invalidate(void);
+static int qemu_plugin_control_drain_wake_state(void);
+static void qemu_plugin_unregister_wake_fd(int fd);
+int qemu_poll_ns(GPollFD *fds, unsigned count, int64_t timeout)
+{
+    g_assert_cmpint(timeout, ==, 0);
+    if (poll_failure) {
+        errno = poll_failure;
+        return -1;
+    }
+    return g_poll(fds, count, 0);
+}
+static MonitorQMP test_monitor;
+static Monitor *current_monitor;
+
+/* Only this ordinary fixture's QOM identity/refcount endpoints are modeled. */
+Object *object_dynamic_cast(Object *object, const char *type)
+{
+    return object == OBJECT(&test_monitor) &&
+           strcmp(type, TYPE_MONITOR_QMP) == 0 ? object : NULL;
+}
+
+Object *object_dynamic_cast_assert(Object *object, const char *type,
+                                   const char *file, int line, const char *func)
+{
+    Object *actual = object_dynamic_cast(object, type);
+
+    g_assert_nonnull(actual);
+    return actual;
+}
+
+Monitor *monitor_cur(void) { return current_monitor; }
+
+Object *object_ref(void *pointer)
+{
+    Object *object = pointer;
+
+    object->ref++;
+    return object;
+}
+
+void object_unref(void *pointer)
+{
+    Object *object = pointer;
+
+    g_assert_cmpuint(object->ref, >, 1);
+    object->ref--;
+}
+
+static int64_t virtual_ps;
+static uint64_t runstate_generation = 1;
+int64_t qemu_clock_get_ps(QEMUClockType type) { return virtual_ps; }
+uint64_t qemu_runstate_transition_generation(void) { return runstate_generation; }
+int qemu_crucible_hot_fork_ram_set_forkable(bool forkable) { return 0; }
+/* Keep canceled queued BHs inert until the captured slice is released. */
+static void persistent_bh_dispatch(void *opaque)
+{
+    QEMUBH *bh = opaque;
+    if (!bh->pending || bh->deleted) {
+        return;
+    }
+    bh->pending = false;
+    bh->callback(bh->opaque);
+}
+QEMUBH *qemu_bh_new_full(QEMUBHFunc *cb, void *opaque, const char *name,
+                          struct MemReentrancyGuard *guard)
+{
+    QEMUBH *bh = g_new0(QEMUBH, 1);
+    if (!allocated_bhs) {
+        allocated_bhs = g_ptr_array_new_with_free_func(g_free);
+    }
+    g_ptr_array_add(allocated_bhs, bh);
+    bh->callback = cb;
+    bh->opaque = opaque;
+    return bh;
+}
+void qemu_bh_schedule(QEMUBH *bh)
+{
+    if (!bh->pending && !bh->deleted) {
+        bh->pending = true;
+        aio_bh_schedule_oneshot(NULL, persistent_bh_dispatch, bh);
+    }
+}
+void qemu_bh_cancel(QEMUBH *bh) { bh->pending = false; }
+void qemu_bh_delete(QEMUBH *bh) { bh->deleted = true; }
+"""
+
+CHECKS = r"""
+static unsigned block_holds;
+static int test_fd;
+static bool test_fd_closed;
+static int64_t original_raw, original_ps;
+
+static void crucible_hot_fork_template_block_transition(void *opaque)
+{
+    g_assert_true(crucible_hot_fork_exact_paused_boundary());
+    g_assert_true(qemu_plugin_crucible_control_drain_settled());
+    g_assert_cmpuint(qemu_plugin_control_drain_callback_depth, ==, 0);
+    g_assert_cmpint(raw_icount, ==, original_raw);
