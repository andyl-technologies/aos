+            ["git", "show", f"{baseline_ref}:{register_path}"], cwd=ROOT, text=True)
+    for signature, expected_hash in BASELINE_HASHES.items():
+        original = definition(BASELINE_BODIES, signature)
+        assert hashlib.sha256(original.encode()).hexdigest() == expected_hash
+        baseline_source = old_node if signature in (
+            "static void node_rules_ensure(void)\n{",
+            "void qemu_crucible_fault_rule_foreach(") else old_register
+        assert definition(baseline_source, signature) == original
+    types = "\n\n".join(type_definition(node, signature) for signature in [
+        "typedef struct CrucibleNodeField {",
