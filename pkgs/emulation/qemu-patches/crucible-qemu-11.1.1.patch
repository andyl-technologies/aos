+static bool edu_state_valid(const EduState *edu, Error **errp)
+{
+    uint32_t status = qatomic_read(&edu->status);
+    bool computing = status & EDU_STATUS_COMPUTING;
+    bool dma_running = edu->dma.cmd & EDU_DMA_RUN;
+
+    if (status & ~(EDU_STATUS_COMPUTING | EDU_STATUS_IRQFACT)) {
+        error_setg(errp, "EDU status contains unsupported bits");
+        return false;
+    }
+    if ((!computing && (edu->fact_remaining || edu->fact_result)) ||
+        (computing && edu->fact_remaining > edu->fact)) {
+        error_setg(errp, "EDU factorial continuation is inconsistent");
+        return false;
+    }
+    if (dma_running != timer_pending(&edu->dma_timer)) {
+        error_setg(errp, "EDU DMA command and timer state are inconsistent");
+        return false;
+    }
+    return true;
+}
+
+static int edu_pre_save(void *opaque)
+{
