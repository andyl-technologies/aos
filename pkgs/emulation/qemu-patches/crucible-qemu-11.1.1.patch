+        block_offset >= block->used_length) {
+        return -ESTALE;
+    }
+    for (uint32_t index = 0; index < capture_regions->len; index++) {
+        CrucibleRamRegion *region = region_inventory_index(capture_regions, index);
+
+        if (region->block == block) {
+            return qemu_plugin_crucible_ram_capture_read_page_v2(
+                transaction, 0, index, block_offset / RAM_PAGE_BYTES,
+                page, bytes, RAM_PAGE_BYTES);
+        }
+    }
+    return -ENOENT;
+}
