+++ b/tests/unit/test-crucible-publisher-member-return.py
@@ -0,0 +1,290 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Exercise literal receiver-child cleanup facts without an accepting provider.
+
+Local records test only pointer retention and status selection. No canonical
+Source, Original, session, module, producer membership or runtime is issued.
+"""
+
+import argparse
+import json
+import os
+from pathlib import Path
+import runpy
+import shlex
+import signal
+import subprocess
+
+
+PREFIX = r'''
+#include "qemu/osdep.h"
+#include "plugins/crucible-startup-source.h"
+static QemuCrucibleStartupSourceControl startup_source;
+/* Negative-only absent dependency; no configured worker owner is issued. */
+int qemu_plugin_crucible_required_workers_current_v1(qemu_plugin_id_t id,
+    qemu_plugin_crucible_runtime_purpose_v3 *runtime)
+{
+    return -ENOKEY;
+}
+'''
+
+CHECKS = r'''
+static int factual_install(qemu_plugin_id_t id, const qemu_info_t *info,
+    int argc, char **argv)
+{
+    return -ENOKEY;
+}
+
+int main(void)
+{
+    QemuCruciblePublisherModuleService service = { 0 };
+    struct qemu_plugin_crucible_setup_borrow_v4 view;
+    struct qemu_plugin_ctx installer = { .id = 7, .installing = true };
+    struct qemu_plugin_ctx other_installer = { .id = 7, .installing = true };
+    QemuCrucibleCommandConsumerMember member = { 0 };
+    QemuCrucibleCommandConsumerMember *holder = &member;
+    QemuCrucibleSourceControlBinding component = { .command_member = &member };
+    QemuCrucibleSetupSlotOwner slot = { .command_member = &member };
+
+    member.component = &component;
+    member.slot = &slot;
+    member.holder = &holder;
+    member.creation_owner = &member;
+    member.held = true;
+    member.transition_active = true;
+    command_member_publisher_return_finish(&member, &holder, 0);
+    assert(holder == &member && component.command_member == &member);
+    assert(slot.command_member == &member && member.held && !member.returned);
+    assert(!member.transition_active);
+    assert(command_member_publisher_return_result(&member, 0, 0, 0) == -EINPROGRESS);
+
+    member.publisher_returned = 1;
+    member.transition_active = true;
+    command_member_publisher_return_finish(&member, &holder, -ESTALE);
+    assert(holder == &member && component.command_member == &member);
+    assert(slot.command_member == &member && member.held && !member.returned);
+    assert(member.transition_active);
+    assert(command_member_publisher_return_result(&member, 0, 0, -ESTALE) == -ESTALE);
+
+    member.return_first_status = -EIO;
+    member.return_post_status = -ECANCELED;
+    command_member_publisher_return_finish(&member, &holder, 0);
+    assert(!holder && !component.command_member && !slot.command_member);
+    assert(!member.held && member.returned && !member.holder && !member.creation_owner);
+    assert(!member.transition_active);
+    assert(command_member_publisher_return_result(&member, 0, 0, 0) == -EIO);
+    assert(member.return_first_status == -EIO && member.return_post_status == -ECANCELED);
+    member.return_first_status = 0;
+    assert(command_member_publisher_return_result(&member, 0, 0, 0) == -ECANCELED);
+    member.return_post_status = 0;
+    assert(command_member_publisher_return_result(&member, -EIO, -ECANCELED, 0) == -EIO);
+    assert(command_member_publisher_return_result(&member, 0, -ECANCELED, 0) == -ECANCELED);
+    assert(command_member_publisher_return_result(&member, 0, 0, 0) == 0);
+    /* Factual local service journal only; no Source or callback is entered. */
+    service.creation_owner = &service;
+    service.holder = &service.creation_owner;
+    service.held = true;
+    service.transition_active = true;
+    startup_setup_service_return_finish(&service, 0);
+    assert(service.held && service.creation_owner == &service);
+    assert(service.holder == &service.creation_owner && !service.transition_active);
+    service.returned = 1;
+    startup_setup_service_return_finish(&service, -ESTALE);
+    assert(service.held && service.creation_owner == &service);
+    assert(service.holder == &service.creation_owner);
+    service.first_status = -ENOKEY;
+    service.post_status = -EIO;
+    service.return_first_status = -EPERM;
+    service.return_post_status = -ECANCELED;
+    startup_setup_service_return_finish(&service, 0);
+    assert(!service.held && !service.creation_owner && !service.holder);
+    assert(service.first_status == -ENOKEY && service.post_status == -EIO);
+    assert(service.return_first_status == -EPERM && service.return_post_status == -ECANCELED);
+
+    assert(startup_setup_service_output_check(4, sizeof(view), &view) == 0);
+    assert(startup_setup_service_output_check(3, sizeof(view), &view) == -EINVAL);
+    assert(startup_setup_service_output_check(4, sizeof(view) - 1, &view) == -EINVAL);
+    assert(startup_setup_service_output_check(4, sizeof(view) + 1, &view) == -EINVAL);
+    assert(startup_setup_service_output_check(4, sizeof(view), NULL) == -EINVAL);
+    assert(startup_setup_service_output_check(4, sizeof(view),
+        (void *)&startup_source.publisher_module) == -EINVAL);
+    assert(startup_setup_service_output_check(4, sizeof(view),
+        (void *)(UINTPTR_MAX - 7)) == -EINVAL);
+    /* Literal installer-frame predicates and ordinary leave only: no Source
+     * custody/Original/payer is published and no service API admits a child. */
+    startup_source.owner_initialized = true;
+    startup_source.owner_process = getpid();
+    qemu_thread_get_self(&startup_source.owner_thread);
+    installer.handle = (GModule *)&installer;
+    qemu_crucible_startup_source_install_enter(&installer, factual_install);
+    startup_source.publisher_module.installer = startup_source.current;
+    startup_source.publisher_module.held = true;
+    startup_source.publisher_module.first_status = -EIO;
+    startup_source.publisher_module.post_status = -ECANCELED;
+    assert(startup_setup_service_installer_current(7) == 0);
+    assert(startup_setup_service_installer_current(8) == -EPERM);
+    startup_source.publisher_module.installer.ctx = &other_installer;
+    assert(startup_setup_service_installer_current(7) == -EPERM);
+    startup_source.publisher_module.installer = startup_source.current;
+    startup_source.publisher_module.installer.module = (GModule *)&other_installer;
+    assert(startup_setup_service_installer_current(7) == -EPERM);
+    startup_source.publisher_module.installer = startup_source.current;
+    startup_source.publisher_module.installer.install = NULL;
+    assert(startup_setup_service_installer_current(7) == -EPERM);
+    startup_source.publisher_module.installer = startup_source.current;
+    assert(qemu_crucible_startup_source_install_leave(&installer, 0) == 0);
+    assert(startup_source.publisher_module.held &&
+           !startup_source.publisher_module.returned);
+    assert(startup_source.publisher_module.first_status == -EIO &&
+           startup_source.publisher_module.post_status == -ECANCELED);
+    assert(startup_setup_service_installer_current(7) == -EPERM);
+    printf("module_service=%zu view=%zu; factual spans and closure only\n",
+           sizeof(service), sizeof(view));
+    printf("Source=%zu member=%zu; factual return helpers only\n",
+           sizeof(QemuCrucibleStartupSourceControl), sizeof(member));
+    return 0;
+}
+'''
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--source-root', type=Path,
+                        default=Path(__file__).resolve().parents[2])
+    parser.add_argument('--output-dir', type=Path, required=True)
+    args = parser.parse_args()
+    args.output_dir.mkdir(parents=True, exist_ok=True)
+    extract = runpy.run_path(str(
+        args.source_root / 'tests/unit/extract-crucible-startup-source-controls.py'))
+    source = (args.source_root / 'plugins/crucible-command-membership.inc.h').read_text()
+    constructor = (args.source_root / 'plugins/crucible-pending-constructor.inc.h').read_text()
+    literal = extract['function'](constructor, 'static bool pending_constructor_closed(')
+    literal += '\n\n' + '\n\n'.join(extract['function'](source, signature) for signature in (
+        'static void command_member_publisher_return_finish(',
+        'static int command_member_publisher_return_result(',
+    ))
+    source_service = (args.source_root / 'plugins/crucible-startup-source.c').read_text()
+    literal += '\n\n' + '\n\n'.join(extract['function'](source_service, signature)
+        for signature in (
+            'static bool startup_setup_output_disjoint(',
+            'static int startup_setup_service_output_check(',
+            'static void startup_setup_service_return_finish(',
+        ))
+    thread_source = (args.source_root / 'util/qemu-thread-posix.c').read_text()
+    threads = '\n\n'.join(extract['function'](thread_source, signature)
+        for signature in ('void qemu_thread_get_self(', 'bool qemu_thread_is_self('))
+    frames = '\n\n'.join(extract['function'](source_service, signature)
+        for signature in ('static bool startup_owner(',
+                          'static bool startup_invocation(',
+                          'static int startup_failure(int status)\n{',
+                          'void qemu_crucible_startup_source_install_enter(',
+                          'static int startup_setup_service_installer_current('))
+    # Only the actual ordinary no-custody leave branch executes. The configured
+    # Linux worker dependency is retained as an unresolved negative-only stub.
+    leave = extract['function'](source_service,
+        'int qemu_crucible_startup_source_install_leave(')
+    phase_start = source_service.index('enum StartupSourcePhase {')
+    phase_end = source_service.index('};', phase_start) + 2
+    phases = source_service[phase_start:phase_end]
+    literal += '\n\n' + phases + '\n\n' + threads + '\n\n' + frames + '\n\n' + leave
+    controls = {
+        'positive': literal,
+        'omit-physical-child': literal.replace(
+            '!identity && member->publisher_returned', '!identity'),
+        'omit-independent-identity': literal.replace(
+            '!identity && member->publisher_returned', 'member->publisher_returned'),
+        'omit-holder-return': literal.replace('*holder = NULL;', '(void)holder;'),
+        'omit-component-return': literal.replace(
+            'member->component->command_member = NULL;', '(void)member;'),
+        'omit-slot-return': literal.replace(
+            'member->slot->command_member = NULL;', '(void)member;'),
+        'omit-first-status': literal.replace(
+            'return member->return_first_status;', 'return 0;'),
+        'omit-post-status': literal.replace(
+            'return member->return_post_status;', 'return 0;'),
+        'omit-current-post': literal.replace(
+            'return first ? first : post ? post : identity;', 'return first ? first : identity;'),
+    }
+    controls.update({
+        'omit-service-physical': literal.replace(
+            '!identity && service->returned', '!identity'),
+        'omit-service-identity': literal.replace(
+            '!identity && service->returned', 'service->returned'),
+        'omit-service-creation': literal.replace('service->creation_owner = NULL;', '(void)service;'),
+        'omit-service-holder': literal.replace('service->holder = NULL;', '(void)service;'),
+        'omit-service-held': literal.replace('service->held = false;', '(void)service;'),
+        'omit-service-version': literal.replace('version == 4', 'version != UINT32_MAX'),
+        'omit-service-size': literal.replace('bytes == sizeof(*out)', 'bytes != SIZE_MAX'),
+        'omit-service-overflow': literal.replace('bytes <= UINTPTR_MAX - address', 'true'),
+        'omit-service-source-span': literal.replace(
+            '!(address < source + sizeof(startup_source) && source < address + bytes)',
+            '(source != 0)'),
+    })
+    frame_begin = literal.index('static int startup_setup_service_installer_current(')
+    frame_end = literal.index('\n}', frame_begin) + 2
+    frame = literal[frame_begin:frame_end]
+    for name, check in {
+        'omit-installer-invocation': 'startup_invocation(id)',
+        'omit-installer-context': 'service->installer.ctx == startup_source.current.ctx',
+        'omit-installer-module': 'service->installer.module == startup_source.current.module',
+        'omit-installer-function': 'service->installer.install == startup_source.current.install',
+    }.items():
+        replacement = ('(id != UINT64_MAX)' if name == 'omit-installer-invocation'
+                       else '(service != NULL)')
+        controls[name] = literal[:frame_begin] + frame.replace(check, replacement) + literal[frame_end:]
+    assertions = {
+        'omit-physical-child': 'holder == &member && component.command_member == &member',
+        'omit-independent-identity': 'holder == &member && component.command_member == &member',
+        'omit-holder-return': '!holder && !component.command_member && !slot.command_member',
+        'omit-component-return': '!holder && !component.command_member && !slot.command_member',
+        'omit-slot-return': '!holder && !component.command_member && !slot.command_member',
+        'omit-first-status': 'command_member_publisher_return_result(&member, 0, 0, 0) == -EIO',
+        'omit-post-status': 'command_member_publisher_return_result(&member, 0, 0, 0) == -ECANCELED',
+        'omit-current-post': 'command_member_publisher_return_result(&member, 0, -ECANCELED, 0) == -ECANCELED',
+    }
+    assertions.update({
+        'omit-service-physical': 'service.held && service.creation_owner == &service',
+        'omit-service-identity': 'service.held && service.creation_owner == &service',
+        'omit-service-creation': '!service.held && !service.creation_owner && !service.holder',
+        'omit-service-holder': '!service.held && !service.creation_owner && !service.holder',
+        'omit-service-held': '!service.held && !service.creation_owner && !service.holder',
+        'omit-service-version': 'startup_setup_service_output_check(3, sizeof(view), &view) == -EINVAL',
+        'omit-service-size': 'startup_setup_service_output_check(4, sizeof(view) - 1, &view) == -EINVAL',
+        'omit-service-overflow': 'startup_setup_service_output_check(4, sizeof(view), (void *)(UINTPTR_MAX - 7)) == -EINVAL',
+        'omit-service-source-span': 'startup_setup_service_output_check(4, sizeof(view), (void *)&startup_source.publisher_module) == -EINVAL',
+    })
+    assertions.update({
+        'omit-installer-invocation': 'startup_setup_service_installer_current(8) == -EPERM',
+        'omit-installer-context': 'startup_setup_service_installer_current(7) == -EPERM',
+        'omit-installer-module': 'startup_setup_service_installer_current(7) == -EPERM',
+        'omit-installer-function': 'startup_setup_service_installer_current(7) == -EPERM',
+    })
+    results = {}
+    for name, body in controls.items():
+        if name != 'positive' and body == literal:
+            raise ValueError(f'unchanged omission: {name}')
+        generated = args.output_dir / f'{name}.c'
+        generated.write_text(PREFIX + body + CHECKS)
+        binary = args.output_dir / name
+        command = [os.environ.get('CC', 'cc'),
+                   *shlex.split(os.environ.get('CFLAGS', '')), str(generated),
+                   '-o', str(binary), *shlex.split(os.environ.get('LDFLAGS', ''))]
+        (args.output_dir / f'{name}.command.json').write_text(
+            json.dumps(command, indent=2) + '\n')
+        compiled = subprocess.run(command, cwd=args.source_root, capture_output=True, text=True)
+        (args.output_dir / f'{name}.compile.log').write_text(compiled.stdout + compiled.stderr)
+        compiled.check_returncode()
+        result = subprocess.run([str(binary)], capture_output=True, text=True, timeout=30)
+        output = result.stdout + result.stderr
+        (args.output_dir / f'{name}.run.log').write_text(output)
+        expected = 0 if name == 'positive' else -signal.SIGABRT
+        if result.returncode != expected or (name != 'positive' and
+                                              assertions[name] not in output):
+            raise RuntimeError(f'unexpected {name}: {result.returncode}\n{output}')
+        results[name] = {'returncode': result.returncode, 'output': output}
+    (args.output_dir / 'results.json').write_text(json.dumps(results, indent=2) + '\n')
+    print(results['positive']['output'], end='')
+    print('PASS21 independently rebuilt factual cleanup/span omissions; no owner admission')
+
+
+if __name__ == '__main__':
+    main()
diff --git a/tests/unit/test-crucible-publisher-protocol.c b/tests/unit/test-crucible-publisher-protocol.c
