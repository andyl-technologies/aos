+           opcode == CXL_MBOX_FIRMWARE_TRANSFER_OPCODE ||
+           opcode == CXL_MBOX_MEDIA_SANITIZE_OPCODE ||
+           opcode == CXL_MBOX_SCAN_MEDIA_OPCODE;
+}
+
+static void cxl_bg_abort_continuation(CXLCCI *cci)
+{
+    switch (cci->bg.opcode) {
+    case CXL_MBOX_FIRMWARE_TRANSFER_OPCODE:
+        cxl_fw_clear_transfer(cci);
+        break;
+    case CXL_MBOX_MEDIA_SANITIZE_OPCODE:
+        if (object_dynamic_cast(OBJECT(cci->d), TYPE_CXL_TYPE3)) {
+            CXLType3Dev *ct3d = CXL_TYPE3(cci->d);
+
+            g_clear_pointer(&ct3d->media_op_sanitize, g_free);
+        }
+        break;
+    default:
+        break;
+    }
+}
+
+static void cxl_bg_unblock_migration(CXLCCI *cci)
+{
+    if (cci->bg.migration_blocker) {
+        migrate_del_blocker(&cci->bg.migration_blocker);
+    }
+}
+
+static bool cxl_bg_block_unsupported_migration(CXLCCI *cci, uint16_t opcode)
+{
+    if (!qemu_timer_tcg_ps_enabled() || cxl_bg_opcode_migratable(opcode)) {
+        return true;
+    }
+
+    g_assert(!cci->bg.migration_blocker);
+    error_setg(&cci->bg.migration_blocker,
+               "CXL background opcode 0x%04x has no migration state",
+               opcode);
+    return migrate_add_blocker_internal(&cci->bg.migration_blocker,
+                                        NULL) == 0;
+}
+
+static void cxl_bg_set_start_time(CXLCCI *cci)
+{
+    __int128 start_ps;
+
+    if (qemu_timer_tcg_ps_enabled()) {
+        start_ps = qemu_clock_get_ps_wide(QEMU_CLOCK_VIRTUAL);
+    } else {
+        start_ps = (__int128)qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) *
+                   CXL_PS_PER_MS;
+    }
+    g_assert(qemu_time_split_ps(start_ps, &cci->bg.starttime_ns,
+                                &cci->bg.starttime_phase_ps));
+}
+
+static __int128 cxl_bg_start_time_ps(const CXLCCI *cci)
+{
+    __int128 start_ps;
+
+    g_assert(qemu_time_join_ps(cci->bg.starttime_ns,
+                               cci->bg.starttime_phase_ps, &start_ps));
+    return start_ps;
+}
+
+static bool cxl_fw_transfer_timed_out(const CXLCCI *cci)
+{
+    __int128 last_part_ps;
+    __int128 now_ps;
+
+    g_assert(cci->fw.last_partxfer_valid);
+    if (!qemu_timer_tcg_ps_enabled()) {
+        return difftime(time(NULL), cci->fw.last_partxfer) > 30.0;
+    }
+
+    g_assert(qemu_time_join_ps(cci->fw.last_partxfer_ns,
+                               cci->fw.last_partxfer_phase_ps,
+                               &last_part_ps));
+    now_ps = qemu_clock_get_ps_wide(QEMU_CLOCK_VIRTUAL);
+    return now_ps - last_part_ps >
+           (__int128)30 * NANOSECONDS_PER_SECOND *
+           PICOSECONDS_PER_NANOSECOND;
+}
+
+static void cxl_fw_set_last_part_time(CXLCCI *cci)
+{
+    if (qemu_timer_tcg_ps_enabled()) {
+        __int128 now_ps = qemu_clock_get_ps_wide(QEMU_CLOCK_VIRTUAL);
+
+        g_assert(qemu_time_split_ps(now_ps, &cci->fw.last_partxfer_ns,
+                                    &cci->fw.last_partxfer_phase_ps));
+        cci->fw.last_partxfer_tcg = true;
+    } else {
+        cci->fw.last_partxfer = time(NULL);
+        cci->fw.last_partxfer_tcg = false;
+    }
+    cci->fw.last_partxfer_valid = true;
+}
+
+static bool cxl_fw_project_last_part_time(CXLCCI *cci, Error **errp)
+{
+    bool destination_tcg = qemu_timer_tcg_ps_enabled();
+
+    if (!cci->fw.last_partxfer_valid ||
+        cci->fw.last_partxfer_tcg == destination_tcg) {
+        return true;
+    }
+
+    if (destination_tcg) {
+        int64_t now_seconds = time(NULL);
+        __int128 age_seconds = (__int128)now_seconds -
+                               cci->fw.last_partxfer;
+        __int128 origin_ps = qemu_clock_get_ps_wide(QEMU_CLOCK_VIRTUAL) -
+                             (age_seconds > 0 ? age_seconds : 0) *
+                             NANOSECONDS_PER_SECOND *
+                             PICOSECONDS_PER_NANOSECOND;
+
+        if (!qemu_time_split_ps(origin_ps, &cci->fw.last_partxfer_ns,
+                                &cci->fw.last_partxfer_phase_ps)) {
+            error_setg(errp, "CXL firmware transfer time cannot be restored");
+            return false;
+        }
+    } else {
+        __int128 origin_ps;
+        __int128 age_ps;
+        __int128 age_seconds;
+        const __int128 ps_per_second =
+            (__int128)NANOSECONDS_PER_SECOND *
+            PICOSECONDS_PER_NANOSECOND;
+        int64_t now_seconds = time(NULL);
+
+        if (!qemu_time_join_ps(cci->fw.last_partxfer_ns,
+                               cci->fw.last_partxfer_phase_ps,
+                               &origin_ps)) {
+            error_setg(errp, "invalid CXL firmware transfer time");
+            return false;
+        }
+        age_ps = (__int128)qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) *
+                 PICOSECONDS_PER_NANOSECOND - origin_ps;
+        age_seconds = age_ps > 0 ?
+            (age_ps + ps_per_second - 1) / ps_per_second : 0;
+        cci->fw.last_partxfer =
+            age_seconds > (__int128)now_seconds - INT64_MIN ? INT64_MIN :
+            now_seconds - (int64_t)age_seconds;
+    }
+    cci->fw.last_partxfer_tcg = destination_tcg;
+    return true;
+}
+
+static void cxl_bg_arm_update(CXLCCI *cci)
+{
+    if (qemu_timer_tcg_ps_enabled()) {
+        __int128 now_ps = qemu_clock_get_ps_wide(QEMU_CLOCK_VIRTUAL);
+        __int128 completion_ps = cxl_bg_start_time_ps(cci) +
+                                 (__int128)cci->bg.runtime * CXL_PS_PER_MS;
+        __int128 update_ps = now_ps +
+                             (__int128)CXL_MBOX_BG_UPDATE_FREQ *
+                             CXL_PS_PER_MS;
+
+        timer_mod_ps_wide(cci->bg.timer, MIN(completion_ps, update_ps));
+    } else {
+        int64_t start_ms = cci->bg.starttime_ns / SCALE_MS;
+        int64_t now_ms = qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL);
+        __int128 completion_ms = (__int128)start_ms + cci->bg.runtime;
+        __int128 update_ms = (__int128)now_ms + CXL_MBOX_BG_UPDATE_FREQ;
+        __int128 deadline_ms = MIN(completion_ms, update_ms);
+
+        if (deadline_ms < INT64_MIN || deadline_ms > INT64_MAX) {
+            g_error("CXL background update deadline overflow");
+        }
+        timer_mod(cci->bg.timer, deadline_ms);
+    }
+}
+
+bool cxl_cci_timing_needed(const CXLCCI *cci)
+{
+    bool active = cci->bg.runtime || timer_pending(cci->bg.timer);
+    bool fw_changed = cci->fw.active_slot != 1 || cci->fw.staged_slot ||
+                      cci->fw.slot[1] || cci->fw.slot[2] ||
+                      cci->fw.slot[3] || cci->fw.transferring;
+
+    return cci->initialized &&
+           (qemu_timer_tcg_ps_enabled() || fw_changed ||
+            (active && cxl_bg_opcode_migratable(cci->bg.opcode)));
+}
+
+void cxl_cci_timing_pre_load(CXLCCI *cci)
+{
+    g_assert(cci->initialized);
+    cxl_reset_cci_background(cci);
+    memset(&cci->fw, 0, sizeof(cci->fw));
+    cci->fw.active_slot = 1;
+    cci->fw.slot[0] = true;
+}
+
+static bool cxl_cci_timing_post_load(void *opaque, int version_id,
+                                     Error **errp)
+{
+    CXLCCI *cci = opaque;
+    bool active = cci->bg.runtime != 0;
+    bool fw_extent_valid = cci->fw.prev_offset <= CXL_FW_SIZE &&
+                           cci->fw.prev_len <=
+                           CXL_FW_SIZE - cci->fw.prev_offset;
+
+    if (cci->bg.starttime_phase_ps >= PICOSECONDS_PER_NANOSECOND ||
+        cci->fw.last_partxfer_phase_ps >= PICOSECONDS_PER_NANOSECOND ||
+        cci->fw.active_slot == 0 || cci->fw.active_slot > CXL_FW_SLOTS ||
+        cci->fw.staged_slot > CXL_FW_SLOTS || !fw_extent_valid ||
+        cci->fw.slot[2] || cci->fw.slot[3] ||
+        !cci->fw.slot[cci->fw.active_slot - 1] ||
+        cci->bg.complete_pct > 100 ||
+        active != timer_pending(cci->bg.timer) ||
+        (active && (cci->bg.complete_pct == 100 || cci->bg.aborted)) ||
+        (!active &&
+         (cci->bg.starttime_ns || cci->bg.starttime_phase_ps))) {
+        error_setg(errp, "invalid CXL CCI background timing state");
+        return false;
+    }
+    if (active && !cxl_bg_opcode_migratable(cci->bg.opcode)) {
+        error_setg(errp,
+                   "CXL background opcode 0x%04x has no migration state",
+                   cci->bg.opcode);
+        return false;
+    }
+    if (active && cci->bg.opcode == CXL_MBOX_FIRMWARE_TRANSFER_OPCODE &&
+        (cci->fw.curr_action > CXL_FW_XFER_ACTION_END ||
+         cci->fw.curr_slot == 0 ||
+         cci->fw.curr_slot > CXL_FW_SLOTS ||
+         ((cci->fw.curr_action == CXL_FW_XFER_ACTION_FULL ||
+           cci->fw.curr_action == CXL_FW_XFER_ACTION_END) &&
+          cci->fw.curr_slot == cci->fw.active_slot) ||
+         (cci->fw.curr_action == CXL_FW_XFER_ACTION_FULL &&
+          cci->fw.transferring) ||
+         (cci->fw.curr_action != CXL_FW_XFER_ACTION_FULL &&
+          !cci->fw.transferring))) {
+        error_setg(errp, "invalid CXL firmware transfer continuation state");
+        return false;
+    }
+    if (active && !qemu_timer_tcg_ps_enabled() &&
+        !cxl_timing_project_to_ms(&cci->bg.starttime_ns,
+                                  &cci->bg.starttime_phase_ps, errp)) {
+        return false;
+    }
+    if (!cxl_fw_project_last_part_time(cci, errp)) {
+        return false;
+    }
+    if (active && cci->bg.opcode == CXL_MBOX_SANITIZE_OPCODE &&
+        object_dynamic_cast(OBJECT(cci->d), TYPE_CXL_TYPE3)) {
+        cxl_dev_disable_media(&CXL_TYPE3(cci->d)->cxl_dstate);
+    }
+
+    cci->bg.timing_vmstate_loaded = true;
+    return true;
+}
+
+const VMStateDescription vmstate_cxl_cci_timing = {
+    .name = "cxl-cci-timing",
+    .version_id = 2,
+    .minimum_version_id = 2,
+    .post_load_errp = cxl_cci_timing_post_load,
