+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Compare production rule-presence and register-boundary bodies.
+
+The field-access shim traces each command-kind comparison in a bounded model;
+it changes only the member expression, never loop control or boolean operands.
+Real GLib vectors and native fork execute with the actual rule layout. Upsert,
+removal and restore pointer replacement are modeled vector mutations, not
+production admission or VMState stream execution. Undefined corrupted-vector
+behavior and running translated guests are outside this fixture's contract.
+"""
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import runpy
+import shlex
+import subprocess
+
