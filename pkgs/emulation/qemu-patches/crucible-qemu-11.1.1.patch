+int qemu_crucible_ram_root(uint32_t scope, uint8_t root[32],
+                           uint64_t *logical_bytes)
+{
+    qemu_plugin_crucible_ram_root_observer_v2 observer;
+    int status;
+
+    if (!root || !logical_bytes || scope > 2) {
+        return -EINVAL;
+    }
+    memset(root, 0, 32);
+    *logical_bytes = 0;
+    if (qatomic_load_acquire(&logical_capture->active) &&
+        (current_cpu || !qemu_in_main_thread() || fingerprint_root_frame.active)) {
+        /* Only genuine Main pre-entry may return old metadata owners before
+         * a fresh operation. CPU replay never invokes that cleanup callback. */
+        return -EBUSY;
+    }
+    if (qemu_crucible_ram_diagnostic_failure()) {
+        return qemu_crucible_ram_diagnostic_failure();
+    }
+    observer = qatomic_load_acquire(&root_observer);
+    if (!observer) {
+        return -ENOSYS;
+    }
+    if (current_cpu && !bql_locked() &&
+        qemu_plugin_crucible_single_threaded_rr() &&
+        replay_mutex_owned()) {
+        uint64_t before_dirty, before_topology;
+
+        /* An instruction-boundary observer retains the existing RR token.
+         * Taking BQL serializes projection reads without a CPU kick, event
+         * dispatch, quantum truncation, or modeled clock change.
+         */
+        bql_lock();
+        fault_root_writer_scope = true;
+        before_dirty = qatomic_read(&dirty_generation);
+        before_topology = qatomic_read(&topology_generation);
+        if (logical_root_invocation) {
+            status = -EBUSY;
+        } else {
+            logical_root_invocation = true;
+            status = fingerprint_root_observe(observer, scope, root, logical_bytes);
+            logical_root_invocation = false;
+        }
+        /* A fresh logical noACK observation may seed the next mutation. The
+         * same RR instruction boundary must still describe its current RAM. */
+        if (!status && (before_dirty != qatomic_read(&dirty_generation) ||
+                        before_topology != qatomic_read(&topology_generation))) {
+            status = -ESTALE;
+        }
+        fault_root_writer_scope = false;
+        bql_unlock();
+        return diagnostic_root_result(status, root, logical_bytes);
+    }
+    if (!bql_locked() || logical_root_invocation) {
+        return diagnostic_root_result(!bql_locked() ? -EPERM : -EBUSY,
+                                      root, logical_bytes);
+    }
+    logical_root_invocation = true;
+    status = fingerprint_root_observe(observer, scope, root, logical_bytes);
+    logical_root_invocation = false;
+    return diagnostic_root_result(status, root, logical_bytes);
+}
