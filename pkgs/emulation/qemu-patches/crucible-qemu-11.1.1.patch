+
+static bool qemu_plugin_crucible_write_u64(uint8_t *out,
+                                           size_t capacity,
+                                           size_t *offset,
+                                           uint64_t value)
+{
+    size_t start = *offset;
+
+    *offset += sizeof(value);
+    if (start > capacity || capacity - start < sizeof(value)) {
+        return false;
+    }
+
+    for (size_t i = 0; i < sizeof(value); i++) {
+        out[start + i] = (value >> (i * 8)) & 0xffU;
+    }
+    return true;
+}
+
+static bool qemu_plugin_crucible_write_bytes(uint8_t *out,
+                                             size_t capacity,
+                                             size_t *offset,
+                                             const uint8_t *bytes,
+                                             size_t len)
+{
+    size_t start = *offset;
+
+    *offset += len;
+    if (len == 0) {
+        return true;
+    }
+    if (!bytes || start > capacity || capacity - start < len) {
+        return false;
+    }
+
+    memcpy(out + start, bytes, len);
+    return true;
+}
+
+static bool qemu_plugin_crucible_write_cstr(uint8_t *out,
+                                            size_t capacity,
+                                            size_t *offset,
+                                            const char *text)
+{
+    size_t len = text ? strlen(text) : 0;
+    bool wrote_len;
+    bool wrote_bytes;
+
+    wrote_len = qemu_plugin_crucible_write_u64(out, capacity, offset, len);
+    wrote_bytes = qemu_plugin_crucible_write_bytes(out, capacity, offset,
+                                                   (const uint8_t *)text, len);
+    return wrote_len && wrote_bytes;
+}
+
+static int crucible_read_vcpu_regs_unchecked(
+    unsigned int vcpu_index, uint8_t *out_register_bytes,
+    size_t out_register_capacity, size_t *out_register_len,
+    uint64_t *out_retired_instruction_count)
+{
+    CPUState *cpu = qemu_get_cpu(vcpu_index);
+    g_autoptr(GArray) descriptors = NULL;
+    g_autoptr(GByteArray) buffer = NULL;
+    size_t offset = 0;
+    bool ok = true;
+
+    if (!out_register_len || !out_retired_instruction_count ||
+        (!out_register_bytes && out_register_capacity != 0) || !cpu) {
+        return -1;
+    }
+
+    *out_register_len = 0;
+    *out_retired_instruction_count = 0;
+
+    descriptors = crucible_internal_get_vcpu_registers(vcpu_index);
+    if (!descriptors || descriptors->len == 0) {
+        return -1;
+    }
+
+    buffer = g_byte_array_new();
+    if (!buffer) {
+        return -1;
+    }
+
+    ok &= qemu_plugin_crucible_write_cstr(out_register_bytes,
+                                          out_register_capacity,
+                                          &offset,
+                                          "aos-qemu-vcpu-regs-v1");
+    ok &= qemu_plugin_crucible_write_u64(out_register_bytes,
+                                         out_register_capacity,
+                                         &offset,
+                                         vcpu_index);
+    ok &= qemu_plugin_crucible_write_u64(out_register_bytes,
+                                         out_register_capacity,
+                                         &offset,
+                                         descriptors->len);
+
+    for (unsigned int i = 0; i < descriptors->len; i++) {
+        const qemu_plugin_reg_descriptor *reg =
+            &g_array_index(descriptors, qemu_plugin_reg_descriptor, i);
+        int size;
+
+        g_byte_array_set_size(buffer, 0);
+        size = crucible_internal_read_vcpu_register(vcpu_index,
+                                                       reg->handle,
+                                                       buffer);
+        if (size < 0 || (size_t)size != buffer->len) {
+            return -1;
+        }
+
+        ok &= qemu_plugin_crucible_write_cstr(out_register_bytes,
+                                              out_register_capacity,
+                                              &offset,
+                                              reg->name);
+        ok &= qemu_plugin_crucible_write_cstr(out_register_bytes,
+                                              out_register_capacity,
+                                              &offset,
+                                              reg->feature);
+        ok &= qemu_plugin_crucible_write_u64(out_register_bytes,
+                                             out_register_capacity,
+                                             &offset,
+                                             (uint64_t)size);
+        ok &= qemu_plugin_crucible_write_bytes(out_register_bytes,
+                                               out_register_capacity,
+                                               &offset,
+                                               buffer->data,
+                                               buffer->len);
+    }
+
+    /*
+     * The aggregate sample icount belongs to the caller's trace sample.
+     * qemu_plugin_icount_raw() is not valid in every plugin callback context,
+     * so the canonical register export keeps this ABI field deterministic and
+     * side-effect-free instead of sampling raw icount here.
+     */
+    *out_register_len = offset;
+    return ok ? 0 : -1;
+}
+
+static __thread unsigned int crucible_device_projection_depth;
+
+static void crucible_device_projection_enter(void)
+{
+    g_assert(bql_locked());
+    g_assert(crucible_device_projection_depth == 0);
+    crucible_device_projection_depth++;
+}
+
+static void crucible_device_projection_leave(void)
+{
+    g_assert(crucible_device_projection_depth == 1);
+    crucible_device_projection_depth--;
+}
+
+int qemu_crucible_internal_read_vcpu_regs(
+    unsigned int vcpu_index, uint8_t *out_register_bytes,
+    size_t out_register_capacity, size_t *out_register_len,
+    uint64_t *out_retired_instruction_count)
+{
+    if (crucible_device_projection_depth != 1 || !bql_locked()) {
+        return -1;
+    }
+    return crucible_read_vcpu_regs_unchecked(
+        vcpu_index, out_register_bytes, out_register_capacity,
+        out_register_len, out_retired_instruction_count);
+}
+
+int qemu_plugin_read_vcpu_regs(unsigned int vcpu_index,
+                               uint8_t *out_register_bytes,
+                               size_t out_register_capacity,
+                               size_t *out_register_len,
+                               uint64_t *out_retired_instruction_count)
+{
+    if (!qemu_plugin_crucible_vcpu_register_read_allowed()) {
+        return -1;
+    }
+    return crucible_read_vcpu_regs_unchecked(
+        vcpu_index, out_register_bytes, out_register_capacity,
+        out_register_len, out_retired_instruction_count);
+}
+
+int qemu_plugin_rr_cursor(struct qemu_plugin_rr_cursor *out)
+{
+    CPUState *cpu = current_cpu;
+    CPUState *next_cpu;
+    bool exact_boundary = qemu_plugin_crucible_exact_boundary_active();
+    uint64_t current_vcpu = icount_crucible_rr_current_vcpu();
+    uint64_t cursor_position = exact_boundary ?
+        icount_crucible_rr_cursor_position() :
+        icount_crucible_rr_cursor_position_observed(cpu);
+    uint64_t rr_switch_quantum = icount_crucible_rr_switch_quantum();
+    int num_vcpus = qemu_plugin_num_vcpus();
+    bool genesis_cursor = exact_boundary && current_vcpu == UINT64_MAX &&
+        icount_get_raw_observed() == 0 && cursor_position == 0;
+    bool terminal_cursor = !exact_boundary && cpu &&
+        current_vcpu == (uint64_t)cpu->cpu_index &&
+        rr_switch_quantum != 0 && cursor_position == rr_switch_quantum;
+
+    if (terminal_cursor) {
+        next_cpu = CPU_NEXT(cpu);
+        if (!next_cpu) {
+            next_cpu = first_cpu;
+        }
+        if (!next_cpu) {
+            return -1;
+        }
+        current_vcpu = next_cpu->cpu_index;
+        cursor_position = 0;
+    }
+
+    if (!out || (!cpu && !exact_boundary) ||
+        (current_vcpu == UINT64_MAX && !genesis_cursor) ||
+        (cpu && cpu->cpu_index != current_vcpu && !exact_boundary &&
+         !terminal_cursor) ||
+        num_vcpus <= 0 ||
+        (current_vcpu != UINT64_MAX &&
+         current_vcpu >= (uint64_t)num_vcpus) || rr_switch_quantum == 0 ||
+        cursor_position >= rr_switch_quantum) {
+        return -1;
+    }
+
+    /*
+     * Before the first runnable selection, the serialized cursor is invalid by
+     * construction.  At an exact raw-zero boundary its unique next coordinate
+     * is nevertheless vCPU 0 at position 0.  Expose that canonical genesis
+     * coordinate without mutating TimersState; every non-genesis invalid cursor
+     * remains rejected.
+     */
+    out->current_vcpu = genesis_cursor ? 0 : current_vcpu;
+    out->cursor_position = cursor_position;
+    out->rr_switch_quantum = rr_switch_quantum;
+    return 0;
+}
+
+uint64_t qemu_crucible_internal_rr_current_vcpu(void)
+{
+    CPUState *cpu = current_cpu;
+    uint64_t owner = icount_crucible_rr_current_vcpu();
+
+    if (!cpu || owner == UINT64_MAX || cpu->cpu_index != owner) {
+        return UINT64_MAX;
+    }
+    return owner;
+}
+
+uint64_t qemu_crucible_internal_rr_cursor_position(void)
+{
+    return icount_crucible_rr_cursor_position_observed(current_cpu);
+}
+
+uint64_t qemu_crucible_internal_rr_switch_quantum(void)
+{
+    return icount_crucible_rr_switch_quantum();
+}
+
+static void crucible_checksum_u64(GChecksum *checksum, uint64_t value)
+{
+    uint8_t encoded[8];
+
+    for (size_t i = 0; i < sizeof(encoded); i++) {
+        encoded[sizeof(encoded) - i - 1] = value & 0xff;
+        value >>= 8;
+    }
+    g_checksum_update(checksum, encoded, sizeof(encoded));
+}
+
+static void crucible_checksum_bytes(GChecksum *checksum,
+                                    const void *bytes, size_t length)
+{
+    crucible_checksum_u64(checksum, length);
+    if (length != 0) {
+        g_checksum_update(checksum, bytes, length);
+    }
+}
+
+static int crucible_material_write(int fd, const void *bytes, uint64_t length)
+{
+    const uint8_t *cursor = bytes;
+
+    while (length != 0) {
+        size_t chunk = MIN(length, (uint64_t)(64 * MiB));
+        ssize_t written = qemu_write_full(fd, cursor, chunk);
+
+        if (written != chunk) {
+            return written < 0 ? -errno : -EIO;
+        }
+        cursor += chunk;
+        length -= chunk;
+    }
+    return 0;
+}
+
+static int crucible_material_write_u64(int fd, uint64_t value)
+{
+    uint8_t encoded[8];
+
+    for (size_t i = 0; i < sizeof(encoded); i++) {
+        encoded[sizeof(encoded) - i - 1] = value & 0xff;
+        value >>= 8;
+    }
+    return crucible_material_write(fd, encoded, sizeof(encoded));
+}
+
+static int crucible_material_write_bytes(int fd, const void *bytes,
+                                         uint64_t length)
+{
+    int status = crucible_material_write_u64(fd, length);
+
+    if (status == 0) {
+        status = crucible_material_write(fd, bytes, length);
+    }
+    return status;
+}
+
+static int crucible_hash_device_projection(uint8_t digest_out[32],
+                                           uint64_t *bytes_out)
+{
+    static const char domain[] = "crucible.qemu.device-projection.v2";
+    QIOChannelFile *channel = NULL;
+    QEMUFile *file = NULL;
+    Error *local_err = NULL;
+    g_autoptr(GChecksum) checksum = NULL;
+    uint8_t buffer[64 * KiB];
+    gsize digest_length = 32;
+    uint64_t sections = 0;
+    off_t length;
+    int writer_fd = -1;
+    int fd = -1;
+    int close_status;
+    int status = 0;
+
+    if (!digest_out || !bytes_out) {
+        return -EINVAL;
+    }
+    memset(digest_out, 0, 32);
+    *bytes_out = 0;
