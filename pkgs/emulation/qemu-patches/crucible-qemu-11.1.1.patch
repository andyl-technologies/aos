+static void test_submit_commit(
+    const struct qemu_plugin_crucible_fault_result *prepared)
+{
+    if (prepared->status != CRUCIBLE_FAULT_STATUS_PREPARED ||
+        prepared->command_sequence != 1 || prepared->reserved != 0 ||
+        prepared->phase != test_command.phase ||
+        prepared->semantic_version !=
+            CRUCIBLE_FAULT_COMMAND_SEMANTIC_VERSION ||
+        prepared->capability_version != 1 ||
+        prepared->observed_icount != test_command.target_icount ||
+        prepared->applied_icount != 0 ||
+        memcmp(prepared->before_hash, prepared->after_hash, 32) != 0) {
+        test_fail("register prepare returned the wrong result");
+    }
+    test_command.command_flags = 0;
+    test_command.command_sequence = 2;
+    if (test_terminal_cursor_required) {
+        struct qemu_plugin_rr_cursor rr = { 0 };
+        uint64_t current_icount = qemu_plugin_icount_raw();
+        uint64_t current_position;
+        uint64_t remaining;
+
+        if (qemu_plugin_rr_cursor(&rr) != 0 ||
+            rr.rr_switch_quantum == 0 ||
+            rr.cursor_position >= rr.rr_switch_quantum ||
+            current_icount < prepared->observed_icount) {
+            test_fail("terminal-cursor test has no valid RR coordinate");
+        }
+        /*
+         * The prepare completion runs inside the exact after-instruction
+         * boundary. Its raw count includes that instruction while the exact
+         * cursor remains at the committed pre-instruction position. Advance
+         * that position once, then select the following terminal when the
+         * current boundary itself completed a quantum.
+         */
+        current_position = rr.cursor_position + 1;
+        if (current_position == rr.rr_switch_quantum) {
+            current_position = 0;
+        }
+        remaining = rr.rr_switch_quantum - current_position;
+        if (current_icount > UINT64_MAX - remaining) {
+            test_fail("terminal-cursor target overflows node icount");
+        }
+        test_command.target_icount = current_icount + remaining;
+    } else {
+        test_command.target_icount = prepared->observed_icount + 16;
+    }
+    test_command.authorization_ceiling_icount = test_command.target_icount;
+    memcpy(test_command.expected_precondition_hash,
+           prepared->before_hash, 32);
+    if (test_mode == TEST_MODE_REJECT_PRECONDITION) {
+        test_initial_target_len = test_read_fault_register(
+            test_initial_target);
+        test_command.expected_precondition_hash[0] ^= 1;
+    }
+    if (qemu_plugin_crucible_fault_submit(
+            &test_command, test_payload, test_payload_len) != 0) {
+        test_fail("QEMU rejected the prepared register commit");
+    }
+    test_commit_submitted = true;
+    qemu_plugin_force_vcpu_exit();
+}
