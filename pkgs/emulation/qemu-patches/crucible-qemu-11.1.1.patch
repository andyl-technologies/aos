+int qemu_plugin_crucible_ram_control_dispatch_wait_v2(
+    qemu_plugin_id_t id, qemu_plugin_crucible_ram_control_actor_v1 *actor,
+    uint32_t direction)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleRamControlReceive *receipt;
+    QemuCrucibleRamRecordLease *lease;
+    struct pollfd endpoint;
+    struct timespec timeout = { .tv_sec = 0, .tv_nsec = 10000000 };
+    uint64_t slice = 0;
+    bool record_wait = false;
+    bool custody_wait = false;
+    int result;
+    int post;
+    int status = qemu_crucible_ram_control_actor_current(actor, id);
+
+    if (status || (direction != QEMU_PLUGIN_CRUCIBLE_RAM_WAIT_READ &&
+                   direction != QEMU_PLUGIN_CRUCIBLE_RAM_WAIT_WRITE)) {
+        return status ? status : -EINVAL;
+    }
+    status = pthread_mutex_trylock(&actor->dispatch_mutex);
+    if (status) {
+        return status == EBUSY ? -EAGAIN : -status;
+    }
+    receipt = &actor->receipt;
+    lease = &receipt->record;
+    if (receipt->uncertain || actor->first_status || actor->post_status) {
+        status = -ESTALE;
+    } else if (actor->record_in_flight && receipt->active &&
+               lease->acquired && lease->held && !lease->end_attempted &&
+               !lease->callback_active && !lease->release_attempted) {
+        record_wait = true;
+        status = direction == QEMU_PLUGIN_CRUCIBLE_RAM_WAIT_WRITE &&
+            (!receipt->frame_extent || receipt->frame_bytes != receipt->frame_extent) ?
+            -EINPROGRESS : 0;
+    } else if (!actor->record_in_flight && receipt->active && receipt->moved &&
+               receipt->first_alias && receipt->alias_count == 1 &&
+               receipt->frame_bytes == 242 && receipt->frame_extent == 242 &&
+               lease->acquired && lease->held && lease->owner &&
+               lease->end_attempted && lease->end_returned && !lease->end_result &&
+               lease->terminal_journal ==
+                   QEMU_PLUGIN_CRUCIBLE_RAM_RECORD_TERMINAL_COMPLETED &&
+               !lease->completion_result && !lease->callback_active &&
+               !lease->release_attempted && !lease->physical_bank_returned) {
+        /* Actual moved bank/ended record slot remains owned until genuine Main
+         * returns it. No ended operation query, readiness or new read is issued. */
+        custody_wait = true;
+        status = 0;
+    } else if (!actor->record_in_flight &&
+               (ram_control_wait_pause_held(actor, &actor->pause) ||
+                ram_control_wait_pause_held(actor, &actor->request_pause))) {
+        custody_wait = true;
+        status = 0;
+    } else if (actor->quiesce_requested) {
+        status = -EAGAIN;
+    } else if (receipt->moved || actor->idle || receipt->frame_bytes ||
+               receipt->frame_extent || receipt->alias_count || lease->held ||
+               lease->callback_active ||
+               direction == QEMU_PLUGIN_CRUCIBLE_RAM_WAIT_WRITE) {
+        /* Neither an idle flag nor a writable selector issues record custody. */
+        status = -ENOKEY;
+    } else {
+        status = 0;
+    }
+    if (!status) {
+        status = qemu_crucible_ram_control_actor_contract_current(actor);
+    }
+    if (!status && custody_wait) {
+        status = qemu_thread_ram_actor_enrollment_current(
+            actor->thread_binding, actor->thread_id);
+        if (!status) {
+            status = qemu_crucible_ram_service_actor_enrollment_current(
+                actor, actor->service_generation, actor->thread_id);
+        }
+        if (status == 1) {
+            status = -EAGAIN;
+        }
+    }
+    status = ram_control_record_unlock(actor, status);
+    if (status) {
+        return status;
+    }
+    if (record_wait) {
+        status = ram_control_record_query(actor, id, &slice);
+        if (status) {
+            return status;
+        }
+        timeout.tv_nsec = MIN(slice, UINT64_C(10000000));
+    }
+    endpoint = (struct pollfd) {
+        .fd = actor->endpoint_descriptor,
+        .events = direction == QEMU_PLUGIN_CRUCIBLE_RAM_WAIT_WRITE ? POLLOUT : POLLIN,
+    };
+    /* Owned pause/moved custody waits on no descriptor and consumes no stream
+     * readiness. Polling remains finite under genuine physical lifetime; only
+     * an open entered record uses its own shrinking original slice. */
+    result = ppoll(custody_wait ? NULL : &endpoint, custody_wait ? 0 : 1,
+                    &timeout, NULL);
+    status = result < 0 ? -errno : !custody_wait &&
+        (endpoint.revents & POLLNVAL) ? -EBADF : !custody_wait &&
+        (endpoint.revents & (POLLERR | POLLHUP)) ? -EIO : 0;
+    if (record_wait) {
+        post = ram_control_record_query(actor, id, &slice);
+    } else {
+        post = pthread_mutex_lock(&actor->dispatch_mutex);
+        if (post) {
+            post = -post;
+        } else {
+            post = qemu_crucible_ram_control_actor_contract_current(actor);
+            post = ram_control_record_unlock(actor, post);
+        }
+    }
+    if (post) {
+        ram_control_failure(actor, post, true);
+    }
+    if (status) {
+        ram_control_failure(actor, status, false);
+    }
+    return qatomic_read(&actor->first_status);
+#else
+    return -ENOTSUP;
+#endif
+}
