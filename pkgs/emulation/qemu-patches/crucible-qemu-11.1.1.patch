+static bool ich9_aux_enabled(const ICH9LPCPMRegs *pm, unsigned index)
+{
+    return index == 0 ? pm->enable_tco :
+           index == 1 ? pm->swsmi_timer_enabled : pm->periodic_timer_enabled;
+}
+
+static QEMUTimer *ich9_aux_timer(ICH9LPCPMRegs *pm, unsigned index)
+{
+    return index == 0 ? pm->tco_regs.tco_timer :
+           index == 1 ? pm->swsmi_timer : pm->periodic_timer;
+}
+
+static __int128 ich9_aux_expiry(const ICH9PMTimerClock *clock)
+{
+    return (__int128)(((__uint128_t)clock->expiry_hi << 64) | clock->expiry_lo);
+}
+
+static int ich9_aux_validate(ICH9LPCPMRegs *pm, unsigned index)
+{
+    ICH9PMTimerClock *clock = ich9_aux_clock(pm, index);
+
+    if (!ich9_aux_enabled(pm, index)) {
+        return clock->loaded ? -EINVAL : 0;
+    }
+    if (!clock->loaded) {
+        return qemu_timer_tcg_ps_enabled() ? -EINVAL : 0;
+    }
+    if (clock->mode != 1 || clock->active > 1 ||
+        (!clock->active && (clock->expiry_hi || clock->expiry_lo))) {
+        return -EINVAL;
+    }
+    if (!qemu_timer_tcg_ps_enabled() && clock->active) {
+        int64_t whole_ns;
+        uint16_t phase_ps;
+
+        if (!qemu_time_split_ps(ich9_aux_expiry(clock), &whole_ns, &phase_ps) ||
+            (phase_ps && whole_ns == INT64_MAX)) {
+            return -ERANGE;
+        }
+    }
+    return 0;
+}
+
+static void ich9_aux_restore(ICH9LPCPMRegs *pm, unsigned index)
+{
+    ICH9PMTimerClock *clock = ich9_aux_clock(pm, index);
+    QEMUTimer *timer;
+
+    if (!ich9_aux_enabled(pm, index)) {
+        return;
+    }
+    timer = ich9_aux_timer(pm, index);
+    if (!clock->loaded) {
+        /* Ordinary streams retain their original TCO timer field. */
+        if (index == 0) {
+            if (pm->tco_regs.legacy_timer_ns == -1) {
+                timer_del(timer);
+            } else {
+                timer_mod_ns(timer, pm->tco_regs.legacy_timer_ns);
+            }
+        }
+        return;
+    }
+    if (!clock->active) {
+        timer_del(timer);
+    } else if (qemu_timer_tcg_ps_enabled()) {
+        timer_mod_ps_wide(timer, ich9_aux_expiry(clock));
+    } else {
+        int64_t whole_ns;
+        uint16_t phase_ps;
+        bool representable = qemu_time_split_ps(ich9_aux_expiry(clock),
+                                                 &whole_ns, &phase_ps);
+
+        assert(representable && !(phase_ps && whole_ns == INT64_MAX));
+        timer_mod_ns(timer, whole_ns + (phase_ps != 0));
+    }
