+    g_ptr_array_add(crucible_node_rules, new_rule(20));
+    unsigned int before_destroyed = destroyed;
+    clear_rules();
+    g_assert_cmpuint(destroyed, ==, before_destroyed + 1);
+    puts("PASS same null/empty initializer and GLib destroy callback");
+}
+
+static void check_queries(void)
+{
+    const uint16_t positions[][5] = {
+        {1, 2, 3, 4, 5}, {20, 2, 3, 4, 5}, {1, 2, 20, 4, 5},
+        {1, 2, 3, 4, 20}, {20, 2, 20, 4, 20},
