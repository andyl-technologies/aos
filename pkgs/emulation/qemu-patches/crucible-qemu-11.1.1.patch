+static bool ps2_common_fingerprint_projection(QEMUFile *f,
+                                              const PS2State *state,
+                                              Error **errp)
+{
+    const PS2Queue *queue = &state->queue;
+    int command_reply_count = 0;
+
+    if (queue->rptr < 0 || queue->rptr >= PS2_BUFFER_SIZE ||
+        queue->wptr < 0 || queue->wptr >= PS2_BUFFER_SIZE ||
+        queue->count < 0 || queue->count > PS2_BUFFER_SIZE ||
+        (queue->cwptr != -1 &&
+         (queue->cwptr < 0 || queue->cwptr >= PS2_BUFFER_SIZE)) ||
+        queue->wptr != ((queue->rptr + queue->count) &
+                        (PS2_BUFFER_SIZE - 1))) {
+        error_setg(errp, "PS/2 queue has invalid projection geometry");
+        return false;
+    }
+    if (queue->cwptr != -1) {
+        command_reply_count =
+            (queue->cwptr - queue->rptr) & (PS2_BUFFER_SIZE - 1);
+        if (command_reply_count > queue->count) {
+            error_setg(errp, "PS/2 command reply exceeds the live queue");
+            return false;
+        }
+    }
+    qemu_put_be32(f, state->write_cmd);
+    qemu_put_be32(f, queue->count);
+    qemu_put_be32(f, command_reply_count);
+    for (int offset = 0; offset < queue->count; offset++) {
+        qemu_put_byte(f, queue->data[(queue->rptr + offset) &
+                                     (PS2_BUFFER_SIZE - 1)]);
+    }
+    return true;
+}
