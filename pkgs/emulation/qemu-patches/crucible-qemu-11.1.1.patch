+#define TYPE_OMAP1_TIMING_OWNER "omap1-timing-owner"
+OBJECT_DECLARE_SIMPLE_TYPE(OMAP1TimingOwner, OMAP1_TIMING_OWNER)
+
+struct OMAP1TimingOwner {
+    DeviceState parent_obj;
+    struct omap_mpu_state_s *mpu;
+};
+
+static bool omap1_timing_exact_needed(void *opaque)
+{
+    return qemu_timer_tcg_ps_enabled();
+}
+
+static int omap1_timing_exact_post_load(void *opaque, int version_id)
+{
+    OMAP1TimingOwner *owner = opaque;
+
+    owner->mpu->timing_exact_loaded = true;
+    return 0;
+}
+
+static int omap1_timing_pre_load(void *opaque)
+{
+    OMAP1TimingOwner *owner = opaque;
+    struct omap_mpu_state_s *mpu = owner->mpu;
+    struct omap_mpu_timer_s *timers[] = {
+        mpu->timer[0], mpu->timer[1], mpu->timer[2],
+        &mpu->wdt->timer, &mpu->os_timer->timer,
+    };
+    int i;
+
+    mpu->timing_exact_loaded = false;
+    mpu->ulpd_gauge_phase_ps = 0;
+    for (i = 0; i < ARRAY_SIZE(timers); i++) {
+        timer_del(timers[i]->timer);
+        timers[i]->time_phase_ps = 0;
+        if (timers[i]->tick) {
+            qemu_bh_cancel(timers[i]->tick);
+            timers[i]->tick_pending = false;
+        }
+    }
+    timer_del(mpu->mcbsp1->source_timer);
+    timer_del(mpu->mcbsp1->sink_timer);
+    timer_del(mpu->mcbsp2->source_timer);
+    timer_del(mpu->mcbsp2->sink_timer);
+    timer_del(mpu->mcbsp3->source_timer);
+    timer_del(mpu->mcbsp3->sink_timer);
+    timer_del(mpu->led[0]->tm);
+    timer_del(mpu->led[1]->tm);
+    return 0;
+}
+
+static bool omap_timer_state_valid(struct omap_mpu_timer_s *timer)
+{
+    bool running = timer->enable && timer->st && timer->rate > 0;
+    bool pending = timer_pending(timer->timer);
+
+    if (timer->time_phase_ps >= PICOSECONDS_PER_NANOSECOND ||
+        timer->rate < 0 ||
+        (pending && timer->tick_pending)) {
+        return false;
+    }
+    if (running != (pending || timer->tick_pending)) {
+        return false;
+    }
+    return !timer->tick_pending || timer->tick;
+}
+
+static bool omap_mcbsp_state_valid(struct omap_mcbsp_s *s)
+{
+    int rx_rate, tx_rate;
+    bool source_expected;
+    bool sink_expected;
+
+    omap_mcbsp_expected_rates(s, &rx_rate, &tx_rate);
+    source_expected = rx_rate && (!s->codec || !s->codec->rts);
+    sink_expected = tx_rate && (!s->codec || !s->codec->cts);
+    return s->rx_rate == rx_rate && s->tx_rate == tx_rate &&
+           timer_pending(s->source_timer) == source_expected &&
+           timer_pending(s->sink_timer) == sink_expected;
+}
+
+static bool omap_lpg_state_valid(struct omap_lpg_s *s)
+{
+    bool running = s->on && s->on != s->period;
+
+    return timer_pending(s->tm) == running;
+}
+
+static bool omap_project_origin_ns(int64_t *origin_ns, uint16_t *phase_ps)
+{
+    if (*phase_ps) {
+        if (*origin_ns == INT64_MAX) {
+            return false;
+        }
+        (*origin_ns)++;
+        *phase_ps = 0;
+    }
+    return true;
+}
+
+static int omap1_timing_post_load(void *opaque, int version_id)
+{
+    OMAP1TimingOwner *owner = opaque;
+    struct omap_mpu_state_s *mpu = owner->mpu;
+    struct omap_mpu_timer_s *timers[] = {
+        mpu->timer[0], mpu->timer[1], mpu->timer[2],
+        &mpu->wdt->timer, &mpu->os_timer->timer,
+    };
+    int i;
+
+    if (icount_crucible_sim_mode() && !mpu->timing_exact_loaded) {
+        error_report("OMAP1 sim state is missing exact timing state");
+        return -EINVAL;
+    }
+    if (mpu->ulpd_gauge_phase_ps >= PICOSECONDS_PER_NANOSECOND) {
+        return -EINVAL;
+    }
+    if (!qemu_timer_tcg_ps_enabled() && mpu->timing_exact_loaded) {
+        for (i = 0; i < ARRAY_SIZE(timers); i++) {
+            if (!omap_project_origin_ns(&timers[i]->time,
+                                        &timers[i]->time_phase_ps)) {
+                return -EINVAL;
+            }
+        }
+        if (!omap_project_origin_ns(&mpu->ulpd_gauge_start,
+                                    &mpu->ulpd_gauge_phase_ps)) {
+            return -EINVAL;
+        }
+    }
+    for (i = 0; i < ARRAY_SIZE(timers); i++) {
+        if (!omap_timer_state_valid(timers[i])) {
+            return -EINVAL;
+        }
+        if (timers[i]->tick_pending) {
+            qemu_bh_schedule(timers[i]->tick);
+        }
+    }
+    if (!omap_mcbsp_state_valid(mpu->mcbsp1) ||
+        !omap_mcbsp_state_valid(mpu->mcbsp2) ||
+        !omap_mcbsp_state_valid(mpu->mcbsp3) ||
+        !omap_lpg_state_valid(mpu->led[0]) ||
+        !omap_lpg_state_valid(mpu->led[1])) {
+        return -EINVAL;
+    }
+
+    qemu_set_irq(mpu->mcbsp1->rxdrq, mpu->mcbsp1->rx_req != 0);
+    qemu_set_irq(mpu->mcbsp1->txdrq, mpu->mcbsp1->tx_req != 0);
+    qemu_set_irq(mpu->mcbsp2->rxdrq, mpu->mcbsp2->rx_req != 0);
+    qemu_set_irq(mpu->mcbsp2->txdrq, mpu->mcbsp2->tx_req != 0);
+    qemu_set_irq(mpu->mcbsp3->rxdrq, mpu->mcbsp3->rx_req != 0);
+    qemu_set_irq(mpu->mcbsp3->txdrq, mpu->mcbsp3->tx_req != 0);
+    qemu_set_irq(qdev_get_gpio_in(mpu->ih[1], OMAP_INT_GAUGE_32K),
+                 mpu->ulpd_pm_regs[0x14 >> 2] & 1);
+    return 0;
+}
