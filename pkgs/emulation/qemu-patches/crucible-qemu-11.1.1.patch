+static int fixture_pager(
+    qemu_plugin_id_t id,
+    const struct qemu_plugin_crucible_checkpoint_pager_invocation *call,
+    struct qemu_plugin_crucible_checkpoint_pager_status *status, void *userdata)
+{
+    QemuCrucibleCheckpointReadLoan *read = NULL;
+    struct qemu_plugin_crucible_checkpoint_placement_disposition observed, sentinel;
+    uint64_t slice = UINT64_MAX;
+    bool pending = callback_pending;
+    int result;
+
+    memset(&observed, 0xa5, sizeof(observed));
+    sentinel = observed;
+    callbacks++;
+    g_assert_true(userdata == &model_userdata);
+    g_assert_cmpint(qemu_mutex_trylock(&admission_lock), ==, 0);
+    g_assert_cmpint(qemu_plugin_crucible_checkpoint_original_check_v1(id), ==, 0);
+    g_assert_cmpint(qemu_plugin_crucible_checkpoint_original_query_slice_v1(
+                       id, &slice), ==, 0);
+    g_assert_cmpuint(slice, >, 0);
+    g_assert_cmpuint(slice, <=, checkpoint_transaction.original.poll_ns);
+    uint64_t wrong_id_output = UINT64_MAX;
+
+    g_assert_cmpint(qemu_plugin_crucible_checkpoint_original_query_slice_v1(
+                       id + 1, &wrong_id_output), ==, -EPERM);
+    g_assert_cmpuint(wrong_id_output, ==, UINT64_MAX);
+    if (check_reader_bounds) {
+        reader_bounds_in_callback();
+    }
+    if (check_foreign) {
+        foreign_in_callback();
+    }
+    if (call->action == QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PAGER_PREPARE) {
+        /* The real fixture admission mutex stays held across native detach.
+         * Closing this modeled policy is not a production purpose publisher.
+         */
+        policy_closed = true;
+        result = qemu_plugin_crucible_checkpoint_proof_hold_v1(id, &fixture_proof);
+        if (result) {
+            qemu_mutex_unlock(&admission_lock);
+            return result;
+        }
+        g_assert_cmpint(qemu_plugin_crucible_checkpoint_placement_restore_v1(id, &observed),
+                        ==, -EPERM);
+        g_assert_cmpmem(&observed, sizeof(observed), &sentinel, sizeof(sentinel));
+        result = qemu_plugin_crucible_checkpoint_placement_detach_v2(
+            id, fixture_proof, empty_mailbox ? NULL : queued_callback,
+            empty_mailbox ? NULL : &model_request, &observed);
+        if (result && result != -EINPROGRESS) {
+            g_assert_cmpmem(&observed, sizeof(observed), &sentinel,
+                            sizeof(sentinel));
+            qemu_mutex_unlock(&admission_lock);
+            return result;
+        }
+        pending |= result == -EINPROGRESS;
+        if (!result) {
+            g_assert_true(checkpoint_placement_owner.detached);
+            g_assert_cmpuint(ram_scheduled.state & 7, ==, empty_mailbox ? 6 : 5);
+            g_assert_cmpuint(observed.schema_version, ==, 1);
+            g_assert_cmpuint(observed.struct_size, ==, sizeof(observed));
+            g_assert_cmpuint(observed.disposition, ==,
+                            QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PLACEMENT_HELD);
+            g_assert_cmpuint(observed.held_kind, ==, empty_mailbox ?
+                            QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PLACEMENT_EMPTY :
+                            QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PLACEMENT_QUEUED);
+            g_assert_cmpuint(observed.accepted_placement_generation, ==, 80);
+            g_assert_cmpuint(observed.native_transaction_generation, ==,
+                            call->native_transaction_generation);
+            held_receipt = observed;
+            g_assert_cmpint(qemu_plugin_crucible_checkpoint_placement_detach_v1(
+                                id, &observed), ==, 0);
+            g_assert_cmpmem(&observed, sizeof(observed), &held_receipt,
+                            sizeof(held_receipt));
+        } else {
+            g_assert_cmpmem(&observed, sizeof(observed), &sentinel,
+                            sizeof(sentinel));
+        }
+    } else {
+        g_assert_true(policy_closed);
+        g_assert_cmpint(qemu_plugin_crucible_checkpoint_placement_detach_v1(id, &observed),
+                        ==, -EPERM);
+        g_assert_cmpmem(&observed, sizeof(observed), &sentinel, sizeof(sentinel));
+    }
+    if (callback_wants_read || leave_read || fail_read_return) {
+        result = qemu_crucible_checkpoint_read_begin_v1(
+            &checkpoint_transaction.invocation, &read);
+        g_assert_cmpint(result, ==, 0);
+        if (fail_read_return) {
+            uint64_t one = 1;
+
+            g_assert_cmpint(write(event_fd, &one, sizeof(one)), ==, sizeof(one));
+            result = qemu_crucible_checkpoint_read_end_v1(read, -EIO);
+            g_assert_cmpint(result, ==, -EIO);
+            g_assert_cmpint(checkpoint_transaction.post_status, ==, -ECANCELED);
+            g_assert_cmpuint(checkpoint_transaction.invocation.readers, ==, 0);
+            qemu_mutex_unlock(&admission_lock);
+            return result;
+        }
+        if (!leave_read) {
+            g_assert_cmpint(qemu_crucible_checkpoint_read_end_v1(read, 0), ==, 0);
+            g_assert_true(checkpoint_transaction.original_valid);
+            g_assert_cmpint(fcntl(event_fd, F_GETFD), >=, 0);
+        }
+    }
+    if (fail_callback) {
+        if (cancel_in_callback) {
+            uint64_t one = 1;
+
+            g_assert_cmpint(write(event_fd, &one, sizeof(one)), ==, sizeof(one));
+        }
+        if (close_after_callback) {
+            fail_reader_close = true;
+        }
+        qemu_mutex_unlock(&admission_lock);
+        return -EIO;
+    }
+    if (call->action == QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PAGER_RELEASE) {
+        /* Exact native restore happens BEFORE the local journal/policy open,
+         * under the SAME admission guard and native non-yield invocation.
+         */
+        g_assert_true(checkpoint_placement_owner.detached);
+        result = qemu_plugin_crucible_checkpoint_placement_restore_v1(id, &observed);
+        if (expect_restore_refusal) {
+            g_assert_cmpint(result, ==, -ESTALE);
+            g_assert_cmpmem(&observed, sizeof(observed), &sentinel,
+                            sizeof(sentinel));
+            g_assert_true(policy_closed);
+            g_assert_false(checkpoint_transaction.mailbox_restored);
+            qemu_mutex_unlock(&admission_lock);
+            return result;
+        }
+        g_assert_cmpint(result, ==, 0);
+        g_assert_false(checkpoint_placement_owner.detached);
+        g_assert_cmpuint(ram_scheduled.state, ==, empty_mailbox ? 80 : 82);
+        g_assert_true(checkpoint_transaction.mailbox_restored);
+        g_assert_cmpuint(observed.disposition, ==,
+                        QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PLACEMENT_RESTORED);
+        g_assert_cmpuint(observed.held_kind, ==, held_receipt.held_kind);
+        g_assert_cmpuint(observed.accepted_placement_generation, ==,
+                        held_receipt.accepted_placement_generation);
+        g_assert_cmpuint(observed.native_transaction_generation, ==,
+                        held_receipt.native_transaction_generation);
+        g_assert_cmpuint(held_receipt.disposition, ==,
+                        QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PLACEMENT_HELD);
+        restore_journals++;
+        result = qemu_plugin_crucible_checkpoint_proof_return_v1(id, fixture_proof);
+        if (result) {
+            qemu_mutex_unlock(&admission_lock);
+            return result;
+        }
+        sentinel = observed;
+        g_assert_cmpint(qemu_plugin_crucible_checkpoint_placement_restore_v1(
+                            id, &observed), ==, -EALREADY);
+        g_assert_cmpmem(&observed, sizeof(observed), &sentinel, sizeof(sentinel));
+        g_assert_cmpuint(queued_calls, ==, 0);
+    }
+    *status = (struct qemu_plugin_crucible_checkpoint_pager_status) {
+        .schema_version = call->schema_version,
+        .struct_size = sizeof(*status), .action = call->action,
+        .state = call->action == QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PAGER_RELEASE ?
+            QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PAGER_DISPOSED :
+            pending ? QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PAGER_PENDING :
+                      QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PAGER_SETTLED_HELD,
+        .native_transaction_generation = call->native_transaction_generation,
+        .plugin_owner_generation = 99, .process_generation = call->process_generation,
+        .arena_generation = call->arena_generation,
+        .topology_generation = call->topology_generation,
+    };
+    if (corrupt_status) {
+        status->topology_generation++;
+    }
+    if (cancel_in_callback) {
+        uint64_t one = 1;
+
+        g_assert_cmpint(write(event_fd, &one, sizeof(one)), ==, sizeof(one));
+    }
+    qemu_mutex_unlock(&admission_lock);
+    return 0;
+}
