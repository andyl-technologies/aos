+    if (ram_writer_record_inherited(qemu_hot_fork_current_thread)) {
+        return -ESTALE;
+    }
+    if (cpus && cpus->process_id != getpid()) {
+        return -ESTALE;
+    }
+
+    pthread_mutex_lock(&ram_writer_lock);
+    status = ram_cpu_construction_identity_locked(cpus);
+    if (!status && ram_writer_owner) {
+        status = -ESTALE;
+    }
+    if (!status && ram_writer_cpus) {
+        /* Already-admitted CPU frames retain their original drain custody. */
+        status = -EBUSY;
+    }
+    if (!status && ram_writer_generation == UINT64_MAX) {
+        status = -EOVERFLOW;
+    }
+    if (!status) {
+        *writers = (QemuThreadRamWriterTransaction) {
+            .record = qemu_hot_fork_current_thread,
+            .thread = cpus->thread,
+            .generation = ++ram_writer_generation,
+            .process_id = cpus->process_id,
+            .owner_thread_id = cpus->owner_thread_id,
+            .active = true,
+        };
+        /* Both pointers are changed under the same admission mutex. There is
+         * no wake or interval in which a new CPU or RAM writer may enter. */
+        ram_writer_record_admit_locked(writers->record);
+        if (writers->record) {
+            ((QemuHotForkThreadRecord *)writers->record)->ram_writer_closed = true;
+        }
+        ram_writer_owner = writers;
+        ram_cpu_construction_owner = NULL;
+        cpus->active = false;
+        /* Negative still returns the real Requested writer owner. In-flight
+         * IO scopes and their legitimate alias landings remain retained. */
+        status = ram_writer_closed_locked(writers);
+    }
+    pthread_mutex_unlock(&ram_writer_lock);
+    return status;
+}
+
+static int ram_cpu_execution_identity_locked(
+    const QemuThreadRamCpuExecutionWitness *owner)
+{
+    return owner && ram_cpu_execution_witness == owner && owner->active &&
+        owner->process_id == getpid() ? 0 : -ESTALE;
+}
+
+int qemu_thread_ram_cpu_execution_borrow(
+    QemuThreadRamCpuExecutionWitness *owner, void *cpu)
+{
+    QemuHotForkThreadRecord *record = qemu_hot_fork_current_thread;
+    int status;
+
+    if (!owner || owner->active || !cpu) {
+        return -EINVAL;
+    }
+    pthread_mutex_lock(&ram_writer_lock);
+    if (ram_cpu_execution_witness) {
+        status = -EBUSY;
+    } else if (!record || record->ram_writer_cpu != cpu ||
+               record->ram_writer_cpu_depth != 1 ||
+               !record->ram_writer_cpu_execution_generation) {
+        status = -ESTALE;
+    } else {
+        *owner = (QemuThreadRamCpuExecutionWitness) {
+            .record = record,
+            .cpu = cpu,
+            .execution_generation = record->ram_writer_cpu_execution_generation,
+            .process_id = getpid(),
+            .active = true,
+        };
+        ram_cpu_execution_witness = owner;
+        status = 0;
+    }
+    pthread_mutex_unlock(&ram_writer_lock);
+    return status;
+}
+
+int qemu_thread_ram_cpu_execution_current(
+    const QemuThreadRamCpuExecutionWitness *owner)
+{
+    int status;
+
+    pthread_mutex_lock(&ram_writer_lock);
+    status = ram_cpu_execution_identity_locked(owner);
+    pthread_mutex_unlock(&ram_writer_lock);
+    return status;
+}
+
+int qemu_thread_ram_cpu_execution_ended(
+    const QemuThreadRamCpuExecutionWitness *owner)
+{
+    int status;
+
+    pthread_mutex_lock(&ram_writer_lock);
+    status = ram_cpu_execution_identity_locked(owner);
+    if (!status && !owner->ended) {
+        status = -EBUSY;
+    }
+    pthread_mutex_unlock(&ram_writer_lock);
+    return status;
+}
+
+int qemu_thread_ram_cpu_execution_return(
+    QemuThreadRamCpuExecutionWitness *owner)
+{
+    int status;
+
+    pthread_mutex_lock(&ram_writer_lock);
+    status = ram_cpu_execution_identity_locked(owner);
+    if (!status) {
+        ram_cpu_execution_witness = NULL;
+        owner->active = false;
+    }
+    pthread_mutex_unlock(&ram_writer_lock);
+    return status;
+}
+
+size_t qemu_thread_ram_writer_fixed_storage_bytes(void)
+{
+    /* These actual static declarations are invariant across registration,
+     * starts, returns and forks. Dynamic rows require their own birth lender. */
+    return sizeof(ram_writer_lock) +
+        sizeof(ram_writer_resume) + sizeof(ram_writer_generation) +
+        sizeof(ram_writer_cpus) + sizeof(ram_writer_io) +
+        sizeof(ram_writer_aliases) + sizeof(ram_writer_owner) +
+        sizeof(ram_writer_scopes) +
+        sizeof(ram_cpu_construction_owner) +
+        sizeof(ram_cpu_construction_generation) +
+        sizeof(ram_cpu_execution_generation) + sizeof(ram_cpu_execution_witness) +
+        sizeof(ram_membership_resume) + sizeof(ram_membership_owner);
+}
+
+static QemuHotForkThreadRecord *qemu_hot_fork_thread_register(
+    const char *name, int mode, QemuThreadHotForkDisposition disposition)
+{
+    QemuHotForkThreadRecord *record = g_new0(QemuHotForkThreadRecord, 1);
+    size_t name_length = name ?
+        strnlen(name, QEMU_HOT_FORK_THREAD_NAME_MAX + 1) : 0;
+    int err;
+
+    record->thread_id = qemu_get_thread_id();
+    record->joinable = mode == QEMU_THREAD_JOINABLE;
+    record->disposition = disposition;
+    record->name_valid = name && name_length <= QEMU_HOT_FORK_THREAD_NAME_MAX &&
+                         g_utf8_validate(name, name_length, NULL);
+    g_strlcpy(record->name, record->name_valid ? name : "<invalid>",
+              sizeof(record->name));
+
+    err = pthread_mutex_lock(&qemu_hot_fork_thread_lock);
+    if (err) {
+        error_exit(err, __func__);
+    }
+    ram_membership_wait_locked();
+    if (qemu_hot_fork_thread_count == QEMU_HOT_FORK_THREAD_INVENTORY_MAX) {
+        qemu_hot_fork_thread_overflow++;
+    } else {
+        record->tracked = true;
+        qemu_hot_fork_threads = g_list_prepend(qemu_hot_fork_threads, record);
+        qemu_hot_fork_thread_count++;
+    }
+    qemu_hot_fork_thread_generation++;
+    err = pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+    if (err) {
+        error_exit(err, __func__);
+    }
+    return record;
+}
+
+static void qemu_hot_fork_thread_start_begin(void)
+{
+    int err = pthread_mutex_lock(&qemu_hot_fork_thread_lock);
+
+    if (err) {
+        error_exit(err, __func__);
+    }
+    ram_membership_wait_locked();
+    if (qemu_hot_fork_thread_starts_in_flight == SIZE_MAX ||
+        qemu_hot_fork_thread_generation == UINT64_MAX) {
+        error_exit(EOVERFLOW, __func__);
+    }
+    qemu_hot_fork_thread_starts_in_flight++;
+    qemu_hot_fork_thread_generation++;
+    err = pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+    if (err) {
+        error_exit(err, __func__);
+    }
+}
+
+static bool bounded_identity(QemuThread *thread, void *native_owner,
+                             QemuThreadBoundedCreateReceipt *receipt)
+{
+    /* Process identity is immutable and checked before inherited locks. */
+    return thread && native_owner && receipt &&
+        receipt->canonical_owner == receipt && receipt->thread_owner == thread &&
+        receipt->native_owner == native_owner && receipt->process_id == getpid();
+}
+
+static bool bounded_creator(QemuThread *thread, void *native_owner,
+                            QemuThreadBoundedCreateReceipt *receipt)
+{
+    return bounded_identity(thread, native_owner, receipt) &&
+        qemu_thread_is_self(&receipt->creator);
+}
+
+static QemuHotForkThreadRecord *bounded_record_locked(
+    QemuThreadBoundedCreateReceipt *receipt)
+{
+    QemuHotForkThreadRecord *record;
+
+    for (record = qemu_hot_fork_bounded_threads; record;
+         record = record->bounded_next) {
+        if (record->bounded == receipt &&
+            record->bounded_native_owner == receipt->native_owner &&
+            record->bounded_birth_generation == receipt->birth_generation) {
+            return record;
+        }
+    }
+    return NULL;
+}
+
+static void qemu_hot_fork_thread_bounded_enroll(
+    QemuHotForkThreadRecord *record, QemuThreadBoundedCreateReceipt *receipt,
+    void *native_owner)
+{
+    int status;
+
+    if (!receipt) {
+        return;
+    }
+    pthread_mutex_lock(&qemu_hot_fork_thread_lock);
+    /* Keep the actual record association even on inventory refusal so its
+     * later real unregister has an independent retained return journal. */
+    record->bounded = receipt;
+    record->bounded_native_owner = native_owner;
+    record->bounded_thread = pthread_self();
+    record->bounded_birth_generation = receipt->birth_generation;
+    record->bounded_next = qemu_hot_fork_bounded_threads;
+    qemu_hot_fork_bounded_threads = record;
+    receipt->registry_registered = true;
+    status = !bounded_identity(receipt->thread_owner, native_owner, receipt) || !receipt->birth_generation ? -EPERM :
+        !record->tracked ? -ENOSPC : 0;
+    receipt->enrollment_status = status;
+    receipt->enrollment_complete = true;
+    pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+}
+
+static int bounded_current(QemuThread *thread, void *native_owner,
+                           QemuThreadBoundedCreateReceipt *receipt, bool self)
+{
+    QemuHotForkThreadRecord *match;
+    int status;
+
+    if (!bounded_identity(thread, native_owner, receipt)) {
+        return -EPERM;
+    }
+    pthread_mutex_lock(&qemu_hot_fork_thread_lock);
+    if (receipt->identity_returned || receipt->closing ||
+        receipt->registry_returned) {
+        status = -ESTALE;
+    } else if (!receipt->enrollment_complete) {
+        status = -EAGAIN;
+    } else if (receipt->enrollment_status) {
+        status = receipt->enrollment_status;
+    } else {
+        match = bounded_record_locked(receipt);
+        status = !receipt->birth_generation || !receipt->registry_registered ||
+            !match || !match->tracked || match->bounded_departed ||
+            (self ? match != qemu_hot_fork_current_thread :
+             !pthread_equal(match->bounded_thread, thread->thread)) ? -ESTALE : 0;
+    }
+    pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+    return status;
+}
+
+int qemu_thread_bounded_current(QemuThread *thread, void *native_owner,
+                               QemuThreadBoundedCreateReceipt *receipt)
+{
+    /* Only the creator may observe the published pthread output. A newborn
+     * must use self_current's actual registry/TLS identity instead. */
+    if (!bounded_creator(thread, native_owner, receipt)) {
+        return -EPERM;
+    }
+    return bounded_current(thread, native_owner, receipt, false);
+}
+
+int qemu_thread_bounded_self_current(QemuThread *thread, void *native_owner,
+                                    QemuThreadBoundedCreateReceipt *receipt)
+{
+    return bounded_current(thread, native_owner, receipt, true);
+}
+
+int qemu_thread_bounded_observe(QemuThread *thread, void *native_owner,
+                               QemuThreadBoundedCreateReceipt *receipt,
+                               QemuThreadBoundedCreateReceipt *out)
+{
+    uintptr_t output = (uintptr_t)out;
+    uintptr_t input = (uintptr_t)receipt;
+
+    if (!bounded_creator(thread, native_owner, receipt) || !out) {
+        return -EPERM;
+    }
+    if (output > UINTPTR_MAX - sizeof(*out) ||
+        input > UINTPTR_MAX - sizeof(*receipt) ||
+        (output < input + sizeof(*receipt) && input < output + sizeof(*out))) {
+        return -EINVAL;
+    }
+    pthread_mutex_lock(&qemu_hot_fork_thread_lock);
+    if (receipt->born && !receipt->identity_returned &&
+        !bounded_record_locked(receipt)) {
+        pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+        return -ESTALE;
+    }
+    *out = *receipt;
+    pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+    return 0;
+}
+
+int qemu_thread_bounded_close(QemuThread *thread, void *native_owner,
+                             QemuThreadBoundedCreateReceipt *receipt)
+{
+    if (!bounded_creator(thread, native_owner, receipt)) {
+        return -EPERM;
+    }
+    pthread_mutex_lock(&qemu_hot_fork_thread_lock);
+    if (receipt->identity_returned ||
+        (receipt->registry_registered && !bounded_record_locked(receipt))) {
+        pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+        return -ESTALE;
+    }
+    receipt->closing = true;
+    pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+    return 0;
+}
+
+int qemu_thread_bounded_tryjoin(QemuThread *thread, void *native_owner,
+                               QemuThreadBoundedCreateReceipt *receipt,
+                               void **result)
+{
+    QemuHotForkThreadRecord *record;
+    int status;
+
+    if (!result || !bounded_creator(thread, native_owner, receipt)) {
+        return -EPERM;
+    }
+    pthread_mutex_lock(&qemu_hot_fork_thread_lock);
+    record = bounded_record_locked(receipt);
+    if (receipt->identity_returned || !receipt->born) {
+        status = -EPERM;
+    } else if (!receipt->enrollment_complete) {
+        status = -EBUSY;
+    } else if (!record || !pthread_equal(record->bounded_thread, thread->thread)) {
+        status = -ESTALE;
+    } else if (receipt->joined) {
+        status = -EALREADY;
+    } else {
+        status = receipt->joining ? -EBUSY : 0;
+    }
+    if (!status) {
+        receipt->joining = true;
+    }
+    pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+    if (status) {
+        return status;
+    }
+    status = qemu_thread_tryjoin(thread, result);
+    pthread_mutex_lock(&qemu_hot_fork_thread_lock);
+    if (!status) {
+        receipt->joined = true;
+        record = bounded_record_locked(receipt);
+        if (record) {
+            record->bounded_joined = true;
+        } else if (!receipt->registry_return_status) {
+            /* Preserve actual join separately from an independent lost join
+             * association. Neither status reconstructs a missing owner. */
+            receipt->registry_return_status = -ESTALE;
+        }
+    }
+    receipt->joining = false;
+    pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+    return status;
+}
+
+int qemu_thread_bounded_identity_return(QemuThread *thread, void *native_owner,
+                                       QemuThreadBoundedCreateReceipt *receipt)
+{
+    QemuHotForkThreadRecord *record = NULL;
+    int status = 0;
+
+    if (!bounded_creator(thread, native_owner, receipt)) {
+        return -EPERM;
+    }
+    pthread_mutex_lock(&qemu_hot_fork_thread_lock);
+    if (receipt->identity_returned) {
+        status = -EALREADY;
+    } else if (receipt->registry_return_status) {
+        status = receipt->registry_return_status;
+    } else if (receipt->joining) {
+        status = -EBUSY;
+    } else if (receipt->born) {
+        record = bounded_record_locked(receipt);
+        if (!record) {
+            status = -ESTALE;
+        } else if (!receipt->joined || !record->bounded_joined ||
+                   !receipt->registry_registered || !receipt->registry_returned ||
+                   !record->bounded_departed) {
+            status = -EBUSY;
+        }
+    } else if (receipt->registry_registered ||
+               (receipt->birth_attempted && receipt->create_status >= 0)) {
+        status = -EBUSY;
+    }
+    if (!status) {
+        if (record) {
+            QemuHotForkThreadRecord **link = &qemu_hot_fork_bounded_threads;
+
+            while (*link != record) {
+                link = &(*link)->bounded_next;
+            }
+            *link = record->bounded_next;
+        }
+        receipt->identity_returned = true;
+    }
+    pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+    /* The real record allocation retires only after actual join. Allocator
+     * history remains paid; no native lock spans this physical free. */
+    if (!status) {
+        g_free(record);
+    }
+    return status;
+}
+
+static void qemu_hot_fork_thread_start_end(void)
+{
+    int err = pthread_mutex_lock(&qemu_hot_fork_thread_lock);
+
+    if (err) {
+        error_exit(err, __func__);
+    }
+    ram_membership_wait_locked();
+    assert(qemu_hot_fork_thread_starts_in_flight > 0);
+    if (qemu_hot_fork_thread_generation == UINT64_MAX) {
+        error_exit(EOVERFLOW, __func__);
+    }
+    qemu_hot_fork_thread_starts_in_flight--;
+    qemu_hot_fork_thread_generation++;
+    err = pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+    if (err) {
+        error_exit(err, __func__);
+    }
+}
+
+void qemu_thread_hot_fork_set_current_disposition(
+    QemuThreadHotForkDisposition disposition)
+{
+    QemuHotForkThreadRecord *record = qemu_hot_fork_current_thread;
+    int err;
+
+    assert(record);
+    assert(disposition != QEMU_THREAD_HOT_FORK_COORDINATOR);
+    assert(disposition != QEMU_THREAD_HOT_FORK_RAM_ACTOR);
+    err = pthread_mutex_lock(&qemu_hot_fork_thread_lock);
+    if (err) {
+        error_exit(err, __func__);
+    }
+    ram_membership_wait_locked();
+    if (record->disposition != disposition) {
+        record->disposition = disposition;
+        qemu_hot_fork_thread_generation++;
+    }
+    err = pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+    if (err) {
+        error_exit(err, __func__);
+    }
+}
+
+int qemu_thread_hot_fork_bind_monitor_restart(int64_t thread_id)
+{
+    QemuHotForkThreadRecord *match = NULL;
+    GList *node;
+    int err;
+
+    if (thread_id <= 0) {
+        return -EINVAL;
+    }
+    err = pthread_mutex_lock(&qemu_hot_fork_thread_lock);
+    if (err) {
+        error_exit(err, __func__);
+    }
+    ram_membership_wait_locked();
+    for (node = qemu_hot_fork_threads; node; node = node->next) {
+        QemuHotForkThreadRecord *record = node->data;
+
+        if (record->thread_id == thread_id) {
+            if (match) {
+                match = NULL;
+                break;
+            }
+            match = record;
+        }
+    }
+    if (!match || !match->tracked ||
+        match->disposition != QEMU_THREAD_HOT_FORK_UNCLASSIFIED_AIO) {
+        err = pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+        if (err) {
+            error_exit(err, __func__);
+        }
+        return -ESTALE;
+    }
+    match->disposition = QEMU_THREAD_HOT_FORK_MONITOR_RESTART;
+    qemu_hot_fork_thread_generation++;
+    err = pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+    if (err) {
+        error_exit(err, __func__);
+    }
+    return 0;
+}
+
+static void qemu_hot_fork_thread_unregister(void *opaque)
+{
+    QemuHotForkThreadRecord *record = opaque;
+    int err = pthread_mutex_lock(&qemu_hot_fork_thread_lock);
+
+    if (err) {
+        error_exit(err, __func__);
+    }
+    ram_membership_wait_locked();
+    if (record->bounded) {
+        QemuThreadBoundedCreateReceipt *receipt = record->bounded;
+        int status = !bounded_identity(receipt->thread_owner,
+                                       record->bounded_native_owner, receipt) ||
+            !pthread_equal(record->bounded_thread, pthread_self()) ||
+            receipt->birth_generation != record->bounded_birth_generation ||
+            !receipt->registry_registered || receipt->registry_returned ?
+            -ESTALE : 0;
+
+        if (status && !receipt->registry_return_status) {
+            receipt->registry_return_status = status;
+        }
+        receipt->registry_returned = true;
+        record->bounded_departed = true;
+    }
+    if (record->tracked) {
+        qemu_hot_fork_threads = g_list_remove(qemu_hot_fork_threads, record);
+        assert(qemu_hot_fork_thread_count > 0);
+        qemu_hot_fork_thread_count--;
+    } else {
+        assert(qemu_hot_fork_thread_overflow > 0);
+        qemu_hot_fork_thread_overflow--;
+    }
+    qemu_hot_fork_thread_generation++;
+    err = pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+    if (err) {
+        error_exit(err, __func__);
+    }
+    qemu_hot_fork_current_thread = NULL;
+    if (!record->bounded) {
+        g_free(record);
+    }
+}
+
+static int qemu_hot_fork_thread_entry_compare(const void *left,
+                                               const void *right)
+{
+    const QemuThreadHotForkInventoryEntry *a = left;
+    const QemuThreadHotForkInventoryEntry *b = right;
+
+    return (a->thread_id > b->thread_id) - (a->thread_id < b->thread_id);
+}
+
+static QemuHotForkThreadRecord *qemu_hot_fork_register_coordinator(void)
+{
+    int64_t thread_id = qemu_get_thread_id();
+    GList *node;
+    int err = pthread_mutex_lock(&qemu_hot_fork_thread_lock);
+
+    if (err) {
+        error_exit(err, __func__);
+    }
+    if (qemu_hot_fork_coordinator_thread_id == thread_id) {
+        QemuHotForkThreadRecord *coordinator = NULL;
+
+        for (node = qemu_hot_fork_threads; node; node = node->next) {
+            QemuHotForkThreadRecord *record = node->data;
+
+            if (record->thread_id == thread_id &&
+                record->disposition == QEMU_THREAD_HOT_FORK_COORDINATOR) {
+                if (coordinator) {
+                    coordinator = NULL;
+                    break;
+                }
+                coordinator = record;
+            }
+        }
+        qemu_hot_fork_current_thread = coordinator;
+        err = pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+        if (err) {
+            error_exit(err, __func__);
+        }
+        return coordinator;
+    }
+    if (qemu_hot_fork_coordinator_thread_id != 0) {
+        err = pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+        if (err) {
+            error_exit(err, __func__);
+        }
+        return NULL;
+    }
+    ram_membership_wait_locked();
+    for (node = qemu_hot_fork_threads; node; node = node->next) {
+        QemuHotForkThreadRecord *record = node->data;
+
+        if (record->thread_id == thread_id) {
+            if (record->disposition != QEMU_THREAD_HOT_FORK_COORDINATOR) {
+                record->disposition = QEMU_THREAD_HOT_FORK_COORDINATOR;
+                qemu_hot_fork_thread_generation++;
+            }
+            qemu_hot_fork_coordinator_thread_id = thread_id;
+            err = pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+            if (err) {
+                error_exit(err, __func__);
+            }
+            qemu_hot_fork_current_thread = record;
+            return record;
+        }
+    }
+    qemu_hot_fork_coordinator_thread_id = thread_id;
+    err = pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+    if (err) {
+        error_exit(err, __func__);
+    }
+
+    /* The QMP main-loop thread is process-lifetime authority. */
+    qemu_hot_fork_current_thread = qemu_hot_fork_thread_register(
+        "qemu-main-loop", QEMU_THREAD_DETACHED,
+        QEMU_THREAD_HOT_FORK_COORDINATOR);
+    return qemu_hot_fork_current_thread;
+}
+
+/*
+ * Static description of the basis that last blocked a registry transaction.
+ * Diagnostics only: the coordinator reports it with the errno-style status.
+ */
+static char qemu_hot_fork_registry_blocker[256];
+
+const char *qemu_thread_hot_fork_registry_transaction_blocker(void)
+{
+    return qemu_hot_fork_registry_blocker[0] ?
+        qemu_hot_fork_registry_blocker : NULL;
+}
+
+/*
+ * Threads whose mutex state one fork may carry.  The coordinator continues in
+ * the child and keeps everything it owns; discard-and-restart threads vanish,
+ * so the child reinitializes whatever they were parked on.  Every other owner
+ * or waiter is a fork blocker.
+ */
+typedef struct CrucibleHotForkMutexCarrier {
+    int64_t coordinator_thread_id;
+    int64_t restart_thread_ids[QEMU_HOT_FORK_RESTART_THREAD_MAX];
+    size_t restart_thread_count;
+} CrucibleHotForkMutexCarrier;
+
+typedef enum CrucibleHotForkMutexDisposition {
+    CRUCIBLE_HOT_FORK_MUTEX_QUIESCENT,
+    CRUCIBLE_HOT_FORK_MUTEX_COORDINATOR_OWNED,
+    CRUCIBLE_HOT_FORK_MUTEX_PARKED,
+    CRUCIBLE_HOT_FORK_MUTEX_BLOCKED,
+} CrucibleHotForkMutexDisposition;
+
+static bool crucible_hot_fork_carrier_is_restart_thread(
+    const CrucibleHotForkMutexCarrier *carrier, int64_t thread_id)
+{
+    size_t index;
+
+    if (thread_id <= 0) {
+        return false;
+    }
+    for (index = 0; index < carrier->restart_thread_count; index++) {
+        if (carrier->restart_thread_ids[index] == thread_id) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static CrucibleHotForkMutexDisposition crucible_hot_fork_mutex_disposition(
+    CrucibleHotForkMutexEntry *mutex,
+    const CrucibleHotForkMutexCarrier *carrier)
+{
+    int64_t owner = qatomic_read(&mutex->owner_thread_id);
+    uint32_t depth = qatomic_read(&mutex->recursion_depth);
+    uint32_t condition_waiters = qatomic_read(&mutex->condition_waiters);
+    int64_t waiter = qatomic_read(&mutex->condition_waiter_thread_id);
+    bool parked = false;
+
+    if (!mutex->active || !qatomic_read(&mutex->ownership_valid) ||
+        qatomic_read(&mutex->unlock_active) ||
+        qatomic_read(&mutex->acquisition_waiters) != 0 ||
+        (owner == 0) != (depth == 0) ||
+        (owner == carrier->coordinator_thread_id &&
+         !mutex->recursive && depth != 1)) {
+        return CRUCIBLE_HOT_FORK_MUTEX_BLOCKED;
+    }
+    if (owner != 0 && owner != carrier->coordinator_thread_id) {
+        if (depth != 1 ||
+            !crucible_hot_fork_carrier_is_restart_thread(carrier, owner)) {
+            return CRUCIBLE_HOT_FORK_MUTEX_BLOCKED;
+        }
+        parked = true;
+    }
+    if (condition_waiters != 0) {
+        if (condition_waiters != 1 ||
+            !crucible_hot_fork_carrier_is_restart_thread(carrier, waiter)) {
+            return CRUCIBLE_HOT_FORK_MUTEX_BLOCKED;
+        }
+        parked = true;
+    }
+    if (parked) {
+        return CRUCIBLE_HOT_FORK_MUTEX_PARKED;
+    }
+    return owner != 0 ? CRUCIBLE_HOT_FORK_MUTEX_COORDINATOR_OWNED :
+        CRUCIBLE_HOT_FORK_MUTEX_QUIESCENT;
+}
+
+/*
+ * Classify every registered mutex against @carrier.  Mutexes the fork must
+ * carry are appended to @carried when it is supplied; without it, only
+ * coordinator-owned mutexes are tolerated.  The registry guard is held.
+ */
+static bool qemu_hot_fork_registered_mutexes_carried(
+    const CrucibleHotForkMutexCarrier *carrier,
+    QemuMutexHotForkRegistration *carried,
+    size_t *carried_count)
+{
+    size_t index;
+    size_t count = 0;
+
+    if (crucible_hot_fork_mutex_overflowed ||
+        crucible_hot_fork_mutex_inconsistent) {
+        snprintf(qemu_hot_fork_registry_blocker,
+                 sizeof(qemu_hot_fork_registry_blocker),
+                 "registered mutex inventory is incomplete or inconsistent");
+        return false;
+    }
+
+    for (index = 0; index < QEMU_HOT_FORK_MUTEX_INVENTORY_MAX; index++) {
+        CrucibleHotForkMutexEntry *mutex =
+            &crucible_hot_fork_mutexes[index];
+        CrucibleHotForkMutexDisposition disposition =
+            CRUCIBLE_HOT_FORK_MUTEX_BLOCKED;
+
+        if (!mutex->active) {
+            continue;
+        }
+        count++;
+        disposition = crucible_hot_fork_mutex_disposition(mutex, carrier);
+        if (disposition == CRUCIBLE_HOT_FORK_MUTEX_BLOCKED ||
+            (disposition == CRUCIBLE_HOT_FORK_MUTEX_PARKED && !carried)) {
+            snprintf(qemu_hot_fork_registry_blocker,
+                     sizeof(qemu_hot_fork_registry_blocker),
+                     "registered mutex %zu is not quiescent (owner thread "
+                     "%" PRId64 ", depth %u, waiters %u/%u, condition waiter "
+                     "%" PRId64 ", recursive %u, unlock %u)",
+                     count,
+                     (int64_t)qatomic_read(&mutex->owner_thread_id),
+                     (unsigned)qatomic_read(&mutex->recursion_depth),
+                     (unsigned)qatomic_read(&mutex->acquisition_waiters),
+                     (unsigned)qatomic_read(&mutex->condition_waiters),
+                     (int64_t)qatomic_read(
+                         &mutex->condition_waiter_thread_id),
+                     (unsigned)mutex->recursive,
+                     (unsigned)qatomic_read(&mutex->unlock_active));
+            return false;
+        }
+        if (disposition == CRUCIBLE_HOT_FORK_MUTEX_QUIESCENT || !carried) {
+            continue;
+        }
+        if (*carried_count == QEMU_HOT_FORK_CARRIED_MUTEX_MAX) {
+            snprintf(qemu_hot_fork_registry_blocker,
+                     sizeof(qemu_hot_fork_registry_blocker),
+                     "registered mutex %zu cannot be carried: %zu mutexes "
+                     "are already carried", count, *carried_count);
+            return false;
+        }
+        carried[*carried_count] = (QemuMutexHotForkRegistration) {
+            .registration_id = mutex->registration_id,
+            .slot = index,
+        };
+        (*carried_count)++;
+    }
+    return true;
+}
+
+static CrucibleHotForkMutexEntry *crucible_hot_fork_registered_mutex(
+    QemuMutexHotForkRegistration registration)
+{
+    CrucibleHotForkMutexEntry *entry;
+
+    if (registration.slot >= QEMU_HOT_FORK_MUTEX_INVENTORY_MAX ||
+        registration.registration_id == 0) {
+        return NULL;
+    }
+
+    entry = &crucible_hot_fork_mutexes[registration.slot];
+    if (!entry->active ||
+        entry->registration_id != registration.registration_id ||
+        entry->mutex_address == 0) {
+        return NULL;
+    }
+    return entry;
+}
+
+static bool crucible_hot_fork_registration_equal(
+    QemuMutexHotForkRegistration left,
+    QemuMutexHotForkRegistration right)
+{
+    return left.registration_id == right.registration_id &&
+        left.slot == right.slot;
+}
+
+/*
+ * Verify that the transaction retained every restartable record in the
+ * copied thread list exactly once.  The list and transaction are both sealed
+ * under qemu_hot_fork_thread_lock before fork(), but the child still validates
+ * their correspondence before using the IDs to authorize mutex adoption.
+ */
+static bool qemu_hot_fork_copied_thread_list_matches(
+    const QemuThreadHotForkRegistryTransaction *transaction,
+    const QemuHotForkThreadRecord *coordinator,
+    GList **coordinator_node)
+{
+    int64_t restart_thread_ids[QEMU_HOT_FORK_RESTART_THREAD_MAX] = { 0 };
+    size_t restart_thread_count = 0;
+    size_t copied_count = 0;
+    size_t coordinator_count = 0;
+    size_t rcu_restart_count = 0;
+    size_t monitor_restart_count = 0;
+    size_t vcpu_restart_count = 0;
+    GList *node;
+
+    *coordinator_node = NULL;
+    for (node = qemu_hot_fork_threads; node; node = node->next) {
+        QemuHotForkThreadRecord *record = node->data;
+
+        copied_count++;
+        if (record == coordinator) {
+            coordinator_count++;
+            *coordinator_node = node;
+            continue;
+        }
+        if (!record || !record->tracked || record->thread_id <= 0 ||
+            restart_thread_count == QEMU_HOT_FORK_RESTART_THREAD_MAX) {
+            return false;
+        }
+        switch (record->disposition) {
+        case QEMU_THREAD_HOT_FORK_RCU_RESTART:
+            rcu_restart_count++;
+            break;
+        case QEMU_THREAD_HOT_FORK_MONITOR_RESTART:
+            monitor_restart_count++;
+            break;
+        case QEMU_THREAD_HOT_FORK_VCPU_RESTART:
+            vcpu_restart_count++;
+            break;
+        default:
+            return false;
+        }
+        restart_thread_ids[restart_thread_count++] = record->thread_id;
+    }
+    if (qemu_hot_fork_thread_overflow != 0 ||
+        qemu_hot_fork_bounded_threads ||
+        qemu_hot_fork_thread_starts_in_flight != 0 ||
+        coordinator_count != 1 || rcu_restart_count != 1 ||
+        monitor_restart_count != 1 || vcpu_restart_count > 1 ||
+        copied_count != qemu_hot_fork_thread_count ||
+        copied_count != 3 + vcpu_restart_count ||
+        restart_thread_count != transaction->restart_thread_count ||
+        qemu_hot_fork_coordinator_thread_id !=
+            transaction->parent_thread_id ||
+        qemu_hot_fork_current_thread != coordinator) {
+        return false;
+    }
+    return memcmp(restart_thread_ids, transaction->restart_thread_ids,
+                  restart_thread_count * sizeof(restart_thread_ids[0])) == 0;
+}
+
+/*
+ * Make one carried mutex usable in the immediate fork child.
+ *
+ * A mutex the coordinator owns stays owned by the same thread under its new
+ * process-local ID.  A mutex a discard-and-restart thread held is still
+ * locked by that vanished thread in the copied pthread state, so it is
+ * replaced with a fresh unlocked mutex of the same kind before any child
+ * thread can contend for it.  A vanished condition waiter is forgotten; the
+ * condition variable it waited on is reinitialized by its owning subsystem.
+ */
+static void crucible_hot_fork_mutex_adopt_in_child(
+    CrucibleHotForkMutexEntry *entry,
+    const CrucibleHotForkMutexCarrier *carrier,
+    int64_t child_thread_id)
+{
+    QemuMutex *mutex = (QemuMutex *)entry->mutex_address;
+    int64_t owner = qatomic_read(&entry->owner_thread_id);
+    uint32_t depth = qatomic_read(&entry->recursion_depth);
+    pthread_mutexattr_t attr;
+    uint32_t lock_index;
+    int err;
+
+    err = pthread_mutexattr_init(&attr);
+    if (err) {
+        error_exit(err, __func__);
+    }
+    if (entry->recursive) {
+        err = pthread_mutexattr_settype(&attr, PTHREAD_MUTEX_RECURSIVE);
+        if (err) {
+            error_exit(err, __func__);
+        }
+    }
+    memset(&mutex->lock, 0, sizeof(mutex->lock));
+    err = pthread_mutex_init(&mutex->lock, &attr);
+    pthread_mutexattr_destroy(&attr);
+    if (err) {
+        error_exit(err, __func__);
+    }
+
+    if (owner == carrier->coordinator_thread_id) {
+        for (lock_index = 0; lock_index < depth; lock_index++) {
+            err = pthread_mutex_lock(&mutex->lock);
+            if (err) {
+                error_exit(err, __func__);
+            }
+        }
+        qatomic_set(&entry->owner_thread_id, child_thread_id);
+    } else {
+        qatomic_set(&entry->owner_thread_id, 0);
+        qatomic_set(&entry->recursion_depth, 0);
+    }
+    qatomic_set(&entry->condition_waiters, 0);
+    qatomic_set(&entry->condition_waiter_thread_id, 0);
+}
+
+int qemu_thread_ram_actor_bind_self(QemuThread *thread,
+                                    QemuThreadRamActorBinding **out)
+{
+    QemuHotForkThreadRecord *record = qemu_hot_fork_current_thread;
+    int status;
+
+    if (!thread || !out || !qemu_thread_is_self(thread) || !record) {
+        return -EPERM;
+    }
+    status = pthread_mutex_lock(&qemu_hot_fork_thread_lock);
+    if (status) {
+        return -status;
+    }
+    ram_membership_wait_locked();
+    if (qemu_hot_fork_thread_generation == UINT64_MAX) {
+        status = -EOVERFLOW;
+    } else if (!record->tracked || record->thread_id != qemu_get_thread_id() ||
+        record->disposition != QEMU_THREAD_HOT_FORK_UNCLASSIFIED ||
+        record->ram_actor.record) {
+        status = -ESTALE;
+    } else {
+        record->ram_actor = (QemuThreadRamActorBinding) {
+            .record = record, .process_id = getpid(),
+            .thread_id = record->thread_id,
+        };
+        record->disposition = QEMU_THREAD_HOT_FORK_RAM_ACTOR;
+        qemu_hot_fork_thread_generation++;
+        *out = &record->ram_actor;
+    }
+    pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+    return status;
+}
+
+int qemu_thread_ram_actor_enrollment_current(QemuThreadRamActorBinding *binding,
+                                            uint64_t thread_id)
+{
+    GList *node;
+    size_t matches = 0;
+    int status;
+
+    if (!binding || !thread_id) {
+        return -EPERM;
+    }
+    status = pthread_mutex_trylock(&qemu_hot_fork_thread_lock);
+    if (status) {
+        return status == EBUSY ? 1 : -status;
+    }
+    for (node = qemu_hot_fork_threads; node; node = node->next) {
+        QemuHotForkThreadRecord *record = node->data;
+
+        matches += binding == &record->ram_actor && binding->record == record &&
+            binding->process_id == getpid() &&
+            binding->thread_id == record->thread_id &&
+            (uint64_t)record->thread_id == thread_id && record->tracked &&
+            record->disposition == QEMU_THREAD_HOT_FORK_RAM_ACTOR;
+    }
+    status = pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+    return status ? -status : matches == 1 ? 0 : -ESTALE;
+}
+
+static bool bounded_ram_pause_current_locked(QemuThreadRamActorBinding *binding)
+{
+    QemuHotForkThreadRecord *record;
+
+    for (record = qemu_hot_fork_bounded_threads; record;
+         record = record->bounded_next) {
+        /* Preserve only the existing exact, separately paused RAM actor. All
+         * other bounded owners lack role quiescence; even a departed record
+         * can still own live TLS/TSD until actual join and identity return. */
+        if (record->bounded_departed || binding != &record->ram_actor ||
+            binding->record != record || binding->process_id != getpid() ||
+            binding->thread_id != record->thread_id ||
+            record->disposition != QEMU_THREAD_HOT_FORK_RAM_ACTOR) {
+            return false;
+        }
+    }
+    return true;
+}
+
+int qemu_thread_ram_pause_begin_actor(QemuThreadRamPauseTransaction *transaction,
+                                      QemuThreadRamActorBinding *binding)
+{
+    GList *node;
+    bool owner_found = false;
+    QemuThreadRamPauseRefusal refusal = { 0 };
+    int status;
+
+    if (!transaction || transaction->active ||
+        (transaction->end.entered && !transaction->end.complete)) {
+        return -EINVAL;
+    }
+    /* Inventory initializes the process-lifetime main-loop registration. */
+    if (!qemu_hot_fork_current_thread) {
+        qemu_hot_fork_register_coordinator();
+    }
+    status = pthread_mutex_lock(&qemu_hot_fork_thread_lock);
+    if (status) {
+        return -status;
+    }
+    if (ram_membership_owner || qemu_hot_fork_thread_overflow ||
+        qemu_hot_fork_thread_starts_in_flight ||
+        !bounded_ram_pause_current_locked(binding) ||
+        qemu_hot_fork_thread_count > QEMU_RAM_PAUSE_MAX_THREADS) {
+        status = -EBUSY;
+        goto fail;
+    }
+    memset(&transaction->end, 0, sizeof(transaction->end));
+    transaction->thread_count = 0;
+    for (node = qemu_hot_fork_threads; node; node = node->next) {
+        QemuHotForkThreadRecord *record = node->data;
+
+        /* These are registrations by native owners, not inferred names. */
+        switch (record->disposition) {
+        case QEMU_THREAD_HOT_FORK_COORDINATOR:
+        case QEMU_THREAD_HOT_FORK_MONITOR_RESTART:
+        case QEMU_THREAD_HOT_FORK_RCU_RESTART:
+        case QEMU_THREAD_HOT_FORK_VCPU_RESTART:
+            break;
+        case QEMU_THREAD_HOT_FORK_RAM_ACTOR:
+            if (binding == &record->ram_actor &&
+                binding->record == record && binding->process_id == getpid() &&
+                binding->thread_id == record->thread_id) {
+                break;
+            }
+            /* An ordinary capture without this owner-issued binding refuses. */
+            status = -EPERM;
+            goto fail;
+        default: {
+            static const char hex[] = "0123456789abcdef";
+            size_t length = 0;
+
+            /* Snapshot only the first refused member under the registry lock.
+             * The inventory caller emits it after releasing its owned holds. */
+            while (length < 16 && record->name[length]) {
+                unsigned char byte = record->name[length];
+
+                refusal.name_prefix_hex[2 * length] = hex[byte >> 4];
+                refusal.name_prefix_hex[2 * length + 1] = hex[byte & 15];
+                length++;
+            }
+            refusal.name_prefix_hex[2 * length] = '\0';
+            refusal.thread_id = record->thread_id;
+            refusal.disposition = record->disposition;
+            refusal.present = true;
+            status = -ENOTSUP;
+            goto fail;
+        }
+        }
+        if (record->thread_id <= 0 || !record->tracked) {
+            status = -ESTALE;
+            goto fail;
+        }
+        owner_found |= record->thread_id == qemu_get_thread_id();
+        transaction->thread_ids[transaction->thread_count++] = record->thread_id;
+    }
+    if (!owner_found || transaction->thread_count != qemu_hot_fork_thread_count) {
+        status = -EPERM;
+        goto fail;
+    }
+    transaction->generation = qemu_hot_fork_thread_generation;
+    transaction->process_id = getpid();
+    transaction->owner_thread_id = qemu_get_thread_id();
+    transaction->ram_actor = binding;
+    transaction->canonical_owner = transaction;
+    transaction->active = true;
+    /* Publish nominal admission before releasing the short registry lock.
+     * Callback introspection may now reenter without permitting new members. */
+    ram_membership_owner = transaction;
+    pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+    return 0;
+
+fail:
+    pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+    memset(transaction, 0, sizeof(*transaction));
+    transaction->refusal = refusal;
+    return status;
+}
+
+int qemu_thread_ram_pause_begin(QemuThreadRamPauseTransaction *transaction)
+{
+    return qemu_thread_ram_pause_begin_actor(transaction, NULL);
+}
+
+bool qemu_thread_ram_actor_matches(const QemuThreadRamPauseTransaction *transaction,
+                                    QemuThreadRamActorBinding *binding,
+                                    uint64_t thread_id)
+{
+    GList *node;
+    size_t matches = 0;
+
+    if (qemu_thread_ram_pause_validate(transaction) || !binding ||
+        transaction->ram_actor != binding) {
+        return false;
+    }
+    pthread_mutex_lock(&qemu_hot_fork_thread_lock);
+    for (node = qemu_hot_fork_threads; node; node = node->next) {
+        QemuHotForkThreadRecord *record = node->data;
+
+        matches += binding == &record->ram_actor && binding->record == record &&
+            binding->process_id == getpid() &&
+            binding->thread_id == record->thread_id &&
+            (uint64_t)record->thread_id == thread_id && record->tracked &&
+            record->disposition == QEMU_THREAD_HOT_FORK_RAM_ACTOR;
+    }
+    pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+    return matches == 1;
+}
+
+static int ram_membership_current_locked(
+    const QemuThreadRamPauseTransaction *transaction)
+{
+    return transaction && transaction->active &&
+        ram_membership_owner == transaction &&
+        transaction->process_id == getpid() &&
+        transaction->owner_thread_id == qemu_get_thread_id() &&
+        transaction->generation == qemu_hot_fork_thread_generation ?
+        0 : -ESTALE;
+}
+
+int qemu_thread_ram_pause_validate(const QemuThreadRamPauseTransaction *transaction)
+{
+    int status;
+
+    pthread_mutex_lock(&qemu_hot_fork_thread_lock);
+    status = ram_membership_current_locked(transaction);
+    if (!status && transaction->end.entered) {
+        status = -ESTALE;
+    }
+    pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+    return status;
+}
+
+int qemu_thread_ram_pause_end_v2(QemuThreadRamPauseTransaction *transaction,
+                                 QemuRamPauseEndDisposition *out)
+{
+    QemuRamPauseEndDisposition *end;
+    uintptr_t address = (uintptr_t)out;
+    uintptr_t owner = (uintptr_t)transaction;
+    int status;
+
+    if (!transaction || !out || sizeof(*out) > UINTPTR_MAX - address ||
+        sizeof(*transaction) > UINTPTR_MAX - owner ||
+        (address < owner + sizeof(*transaction) && owner < address + sizeof(*out)) ||
+        transaction->canonical_owner != transaction ||
+        transaction->process_id != getpid() ||
+        transaction->owner_thread_id != qemu_get_thread_id()) {
+        return -EPERM;
+    }
+    end = &transaction->end;
+    /* Only this exact owner can observe an already entered return. Never
+     * notify/unlock twice after committed release or uncertain completion. */
+    if (end->released || end->uncertain) {
+        *out = *end;
+        return end->last_status;
+    }
+    if (end->attempts == UINT64_MAX) {
+        return -EOVERFLOW;
+    }
+    end->attempts++;
+    end->entered = true;
+    status = pthread_mutex_lock(&qemu_hot_fork_thread_lock);
+    end->effect_status = status ? -status : 0;
+    if (!status) {
+        end->effect_status = ram_membership_current_locked(transaction);
+        if (!end->effect_status) {
+            ram_membership_owner = NULL;
+            transaction->active = false;
+            end->released = true;
+            /* Record the gate clear before either independent post. */
+            end->notify_entered = true;
+            end->notify_status = -pthread_cond_broadcast(&ram_membership_resume);
+            end->notify_returned = true;
+        }
+        end->unlock_status = -pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+    }
+    end->uncertain = end->notify_status || end->unlock_status;
+    end->complete = end->released && !end->uncertain;
+    end->last_status = end->effect_status ? end->effect_status :
+        end->notify_status ? end->notify_status : end->unlock_status;
+    if (!end->first_status) {
+        end->first_status = end->last_status;
+    }
+    *out = *end;
+    return end->last_status;
+}
+
+int qemu_thread_hot_fork_begin_registry_transaction(
+    QemuThreadHotForkRegistryTransaction *transaction)
+{
+    QemuHotForkThreadRecord *coordinator;
+    GList *node;
+    size_t coordinator_count = 0;
+    size_t rcu_restart_count = 0;
+    size_t monitor_restart_count = 0;
+    size_t vcpu_restart_count = 0;
+    int64_t thread_id = qemu_get_thread_id();
+    CrucibleHotForkMutexCarrier carrier = {
+        .coordinator_thread_id = thread_id,
+    };
+    QemuMutexHotForkRegistration
+        carried[QEMU_HOT_FORK_CARRIED_MUTEX_MAX];
+    size_t carried_count = 0;
+    bool restart_overflow = false;
+    int err;
+
+    if (!transaction || transaction->active ||
+        transaction->coordinator_record || getpid() <= 1 || thread_id <= 0) {
+        return -EINVAL;
+    }
+    coordinator = qemu_hot_fork_register_coordinator();
+    if (!coordinator) {
+        return -EPERM;
+    }
+
+    crucible_hot_fork_mutex_registry_lock();
+    err = pthread_mutex_lock(&qemu_hot_fork_thread_lock);
+    if (err) {
+        error_exit(err, __func__);
+    }
+    if (ram_membership_owner) {
+        pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+        crucible_hot_fork_mutex_registry_unlock();
+        return -EBUSY;
+    }
+
+    for (node = qemu_hot_fork_threads; node; node = node->next) {
+        QemuHotForkThreadRecord *record = node->data;
+
+        bool restart = false;
+
+        if (record->disposition == QEMU_THREAD_HOT_FORK_COORDINATOR) {
+            coordinator_count++;
+        } else if (record->disposition ==
+                   QEMU_THREAD_HOT_FORK_RCU_RESTART) {
+            rcu_restart_count++;
+            restart = true;
+        } else if (record->disposition ==
+                   QEMU_THREAD_HOT_FORK_MONITOR_RESTART) {
+            monitor_restart_count++;
+            restart = true;
+        } else if (record->disposition ==
+                   QEMU_THREAD_HOT_FORK_VCPU_RESTART) {
+            vcpu_restart_count++;
+            restart = true;
+        }
+        if (restart) {
+            if (carrier.restart_thread_count ==
+                QEMU_HOT_FORK_RESTART_THREAD_MAX) {
+                restart_overflow = true;
+            } else {
+                carrier.restart_thread_ids[carrier.restart_thread_count++] =
+                    record->thread_id;
+            }
+        }
+    }
+    qemu_hot_fork_registry_blocker[0] = '\0';
+    if (qemu_hot_fork_thread_overflow != 0 ||
+        qemu_hot_fork_bounded_threads ||
+        qemu_hot_fork_thread_starts_in_flight != 0 ||
+        qemu_hot_fork_thread_count != 3 + vcpu_restart_count ||
+        coordinator_count != 1 ||
+        rcu_restart_count != 1 ||
+        monitor_restart_count != 1 ||
+        vcpu_restart_count > 1 ||
+        qemu_hot_fork_coordinator_thread_id != thread_id ||
+        qemu_hot_fork_current_thread != coordinator ||
+        coordinator->thread_id != thread_id || !coordinator->tracked ||
+        coordinator->disposition != QEMU_THREAD_HOT_FORK_COORDINATOR ||
+        restart_overflow ||
+        !qemu_hot_fork_registered_mutexes_carried(&carrier, carried,
+                                                  &carried_count) ||
+        qemu_hot_fork_thread_generation == UINT64_MAX) {
+        if (!qemu_hot_fork_registry_blocker[0]) {
+            snprintf(qemu_hot_fork_registry_blocker,
+                     sizeof(qemu_hot_fork_registry_blocker),
+                     "thread registry is not forkable (threads %zu, "
+                     "coordinators %zu, rcu %zu, monitor %zu, vcpu %zu, "
+                     "overflow %zu, starts %zu, caller %" PRId64
+                     ", coordinator %" PRId64 ")",
+                     qemu_hot_fork_thread_count, coordinator_count,
+                     rcu_restart_count, monitor_restart_count,
+                     vcpu_restart_count,
+                     (size_t)qemu_hot_fork_thread_overflow,
+                     (size_t)qemu_hot_fork_thread_starts_in_flight,
+                     thread_id,
+                     (int64_t)qemu_hot_fork_coordinator_thread_id);
+        }
+        err = pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+        if (err) {
+            error_exit(err, __func__);
+        }
+        crucible_hot_fork_mutex_registry_unlock();
+        return -EBUSY;
+    }
+
+    *transaction = (QemuThreadHotForkRegistryTransaction) {
+        .thread_generation = qemu_hot_fork_thread_generation,
+        .parent_process_id = getpid(),
+        .parent_thread_id = thread_id,
+        .coordinator_record = coordinator,
+        .restart_thread_count = carrier.restart_thread_count,
+        .carried_count = carried_count,
+        .active = true,
+    };
+    memcpy(transaction->restart_thread_ids, carrier.restart_thread_ids,
+           sizeof(transaction->restart_thread_ids));
+    memcpy(transaction->carried_mutexes, carried,
+           carried_count * sizeof(carried[0]));
+    return 0;
+}
+
+int qemu_thread_hot_fork_release_parent_registry_transaction(
+    QemuThreadHotForkRegistryTransaction *transaction)
+{
+    int err;
+
+    if (!transaction || !transaction->active ||
+        transaction->child_reconstructed ||
+        transaction->parent_process_id != getpid() ||
+        transaction->parent_thread_id != qemu_get_thread_id() ||
+        transaction->coordinator_record != qemu_hot_fork_current_thread ||
+        transaction->thread_generation != qemu_hot_fork_thread_generation) {
+        return -EPERM;
+    }
+
+    transaction->active = false;
+    err = pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+    if (err) {
+        error_exit(err, __func__);
+    }
+    crucible_hot_fork_mutex_registry_unlock();
+    return 0;
+}
+
+int qemu_thread_hot_fork_reconstruct_child_registry(
+    QemuThreadHotForkRegistryTransaction *transaction)
+{
+    QemuHotForkThreadRecord *coordinator;
+    GList *coordinator_node = NULL;
+    int64_t child_thread_id = qemu_get_thread_id();
+    CrucibleHotForkMutexCarrier parent_carrier = {
+        .coordinator_thread_id = transaction ? transaction->parent_thread_id :
+            0,
+    };
+    CrucibleHotForkMutexCarrier child_carrier = {
+        .coordinator_thread_id = child_thread_id,
+    };
+    size_t index;
+    int err;
+
+    /* Native reconstruction uses the uncached, authenticated child ID. */
+    crucible_mutex_owner_cache_refresh(child_thread_id);
+
+    if (!transaction || !transaction->active ||
+        transaction->child_reconstructed ||
+        transaction->parent_process_id <= 1 ||
+        transaction->parent_process_id == getpid() ||
+        transaction->parent_process_id != getppid() ||
+        transaction->parent_thread_id <= 0 || child_thread_id <= 0 ||
+        transaction->thread_generation != qemu_hot_fork_thread_generation) {
+        return -EPERM;
+    }
+    coordinator = qemu_hot_fork_current_thread;
+    if (!coordinator || transaction->coordinator_record != coordinator ||
+        !coordinator->tracked ||
+        coordinator->thread_id != transaction->parent_thread_id ||
+        coordinator->disposition != QEMU_THREAD_HOT_FORK_COORDINATOR ||
+        transaction->restart_thread_count >
+            QEMU_HOT_FORK_RESTART_THREAD_MAX ||
+        transaction->carried_count > QEMU_HOT_FORK_CARRIED_MUTEX_MAX ||
+        !qemu_hot_fork_copied_thread_list_matches(
+            transaction, coordinator, &coordinator_node)) {
+        return -EPROTO;
+    }
+
+    /*
+     * The carried mutexes were classified under the retained registry guard
+     * immediately before fork(), so the child sees exactly that state.
+     * Re-verify each one against the parent's carrier before adopting it, and
+     * then require the whole registry to be quiescent or child-owned.
+     */
+    parent_carrier.restart_thread_count = transaction->restart_thread_count;
+    memcpy(parent_carrier.restart_thread_ids, transaction->restart_thread_ids,
+           sizeof(parent_carrier.restart_thread_ids));
+    for (index = 0; index < transaction->carried_count; index++) {
+        QemuMutexHotForkRegistration registration =
+            transaction->carried_mutexes[index];
+        CrucibleHotForkMutexEntry *mutex =
+            crucible_hot_fork_registered_mutex(registration);
+        QemuMutex *live_mutex;
+        CrucibleHotForkMutexDisposition disposition;
+        size_t previous;
+
+        for (previous = 0; previous < index; previous++) {
+            if (crucible_hot_fork_registration_equal(
+                    registration,
+                    transaction->carried_mutexes[previous])) {
+                return -EPROTO;
+            }
+        }
+
+        if (!mutex) {
+            return -EPROTO;
+        }
+        disposition = crucible_hot_fork_mutex_disposition(mutex,
+                                                          &parent_carrier);
+        if (disposition != CRUCIBLE_HOT_FORK_MUTEX_COORDINATOR_OWNED &&
+            disposition != CRUCIBLE_HOT_FORK_MUTEX_PARKED) {
+            return -EPROTO;
+        }
+
+        /*
+         * Only a carried ownership state proves that the registered address
+         * still names live mutex storage.  Validate external state before
+         * consulting the object's embedded token.
+         */
+        live_mutex = (QemuMutex *)mutex->mutex_address;
+        if (live_mutex->crucible_hot_fork_slot != registration.slot ||
+            live_mutex->crucible_hot_fork_registration_id !=
+                registration.registration_id) {
+            return -EPROTO;
+        }
+    }
+    for (index = 0; index < transaction->carried_count; index++) {
+        CrucibleHotForkMutexEntry *mutex =
+            crucible_hot_fork_registered_mutex(
+                transaction->carried_mutexes[index]);
+
+        g_assert(mutex);
+        crucible_hot_fork_mutex_adopt_in_child(
+            mutex, &parent_carrier, child_thread_id);
+    }
+    if (!qemu_hot_fork_registered_mutexes_carried(&child_carrier, NULL,
+                                                  NULL)) {
+        return -EPROTO;
+    }
+
+    coordinator_node->prev = NULL;
+    coordinator_node->next = NULL;
+    coordinator->thread_id = child_thread_id;
+    qemu_hot_fork_threads = coordinator_node;
+    qemu_hot_fork_thread_count = 1;
+    qemu_hot_fork_thread_overflow = 0;
+    qemu_hot_fork_thread_starts_in_flight = 0;
+    qemu_hot_fork_coordinator_thread_id = child_thread_id;
+    qemu_hot_fork_current_thread = coordinator;
+    qemu_hot_fork_thread_generation++;
+    transaction->active = false;
+    transaction->child_reconstructed = true;
+
+    err = pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+    if (err) {
+        error_exit(err, __func__);
+    }
+    crucible_hot_fork_mutex_registry_unlock();
+    return 0;
+}
+
+void qemu_thread_hot_fork_inventory(QemuThreadHotForkInventory *inventory)
+{
+    GList *node;
+    size_t index = 0;
+    int err;
+
+    memset(inventory, 0, sizeof(*inventory));
+    qemu_hot_fork_register_coordinator();
+
+    err = pthread_mutex_lock(&qemu_hot_fork_thread_lock);
+    if (err) {
+        error_exit(err, __func__);
+    }
+    inventory->generation = qemu_hot_fork_thread_generation;
+    inventory->entry_count = qemu_hot_fork_thread_count;
+    inventory->overflow_count = qemu_hot_fork_thread_overflow;
+    inventory->starts_in_flight = qemu_hot_fork_thread_starts_in_flight;
+    inventory->entries = g_new0(QemuThreadHotForkInventoryEntry,
+                                inventory->entry_count);
+    for (node = qemu_hot_fork_threads; node; node = node->next) {
+        QemuHotForkThreadRecord *record = node->data;
+        QemuThreadHotForkInventoryEntry *entry = &inventory->entries[index++];
+
+        entry->thread_id = record->thread_id;
+        entry->name = g_strdup(record->name);
+        entry->joinable = record->joinable;
+        entry->name_valid = record->name_valid;
+        entry->disposition = record->disposition;
+    }
+    assert(index == inventory->entry_count);
+    err = pthread_mutex_unlock(&qemu_hot_fork_thread_lock);
+    if (err) {
+        error_exit(err, __func__);
+    }
+    if (inventory->entry_count > 1) {
+        qsort(inventory->entries, inventory->entry_count,
+              sizeof(*inventory->entries),
+              qemu_hot_fork_thread_entry_compare);
+    }
+}
+
+void qemu_thread_hot_fork_inventory_destroy(
+    QemuThreadHotForkInventory *inventory)
+{
+    size_t index;
+
+    for (index = 0; index < inventory->entry_count; index++) {
+        g_free(inventory->entries[index].name);
+    }
+    g_free(inventory->entries);
+    memset(inventory, 0, sizeof(*inventory));
+}
+
+static void *qemu_thread_start(void *args)
+{
+    QemuThreadArgs *qemu_thread_args = args;
+    void *(*start_routine)(void *) = qemu_thread_args->start_routine;
+    void *arg = qemu_thread_args->arg;
+    int mode = qemu_thread_args->mode;
+    QemuHotForkThreadRecord *hot_fork_record;
+    void *r;
+
+    if (qemu_thread_args->name) {
+        qemu_thread_set_name(qemu_thread_args->name);
+    }
+    QEMU_TSAN_ANNOTATE_THREAD_NAME(qemu_thread_args->name);
+    hot_fork_record = qemu_hot_fork_thread_register(
+        qemu_thread_args->name, mode, QEMU_THREAD_HOT_FORK_UNCLASSIFIED);
+    qemu_hot_fork_current_thread = hot_fork_record;
+    qemu_hot_fork_thread_bounded_enroll(hot_fork_record,
+                                        qemu_thread_args->bounded, arg);
+    qemu_hot_fork_thread_start_end();
+    g_free(qemu_thread_args->name);
+    g_free(qemu_thread_args);
