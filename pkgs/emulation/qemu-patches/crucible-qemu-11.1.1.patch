+        VMSTATE_UINT64(fw.prev_len, CXLCCI),
+        VMSTATE_INT64(fw.last_partxfer, CXLCCI),
+        VMSTATE_INT64(fw.last_partxfer_ns, CXLCCI),
+        VMSTATE_UINT16(fw.last_partxfer_phase_ps, CXLCCI),
+        VMSTATE_BOOL(fw.last_partxfer_valid, CXLCCI),
+        VMSTATE_BOOL(fw.last_partxfer_tcg, CXLCCI),
+        VMSTATE_END_OF_LIST()
+    }
+};
+
+bool cxl_cci_timing_validate(const CXLCCI *cci, Error **errp)
+{
+    if (cci->initialized && qemu_timer_exact_virtual_ps_enabled() &&
+        !cci->bg.timing_vmstate_loaded) {
+        error_setg(errp, "CXL CCI is missing exact timing state");
+        return false;
+    }
+    return true;
+}
 
