+static void test_crucible_reject_replaced_launch_image(void)
+{
+    QTestState *qts = qtest_init(common_args);
+    int original_fd = crucible_test_image();
+    int replacement_fd = crucible_test_image();
+    QDict *reply;
+
+    qtest_qmp_fds_assert_success(qts, &original_fd, 1,
+        "{'execute':'add-fd','arguments':{'fdset-id':1,"
+        "'opaque':'crucible-vmstate'}}");
+    qtest_qmp_assert_success(qts,
+        "{'execute':'blockdev-add','arguments':{'driver':'file',"
+        "'filename':'/dev/fdset/1','node-name':'vmstate-test'}}");
+    qtest_qmp_assert_success(qts,
+        "{'execute':'remove-fd','arguments':{'fdset-id':1}}");
+    qtest_qmp_fds_assert_success(qts, &replacement_fd, 1,
+        "{'execute':'add-fd','arguments':{'fdset-id':1,"
+        "'opaque':'crucible-vmstate'}}");
+
+    reply = qtest_qmp(qts,
+        "{'execute':'x-crucible-adopt-launch-fdsets',"
+        "'arguments':{'root-overlay':false}}");
