+
+    clock_step(639);
+    g_assert_cmphex(readl(CLK_BA + CLK_CNTR25M), ==, 0);
+
+    clock_step(1);
+    g_assert_cmphex(readl(CLK_BA + CLK_CNTR25M), ==, 16);
+
+    clock_step(NANOSECONDS_PER_SECOND - 640);
+    g_assert_cmphex(readl(CLK_BA + CLK_SECCNT), ==, 1);
+    g_assert_cmphex(readl(CLK_BA + CLK_CNTR25M), ==, 0);
+}
