+    qemu_mutex_lock(&registry->mutex);
+    first = callback_child_identity_locked(child);
+    if (!first) {
+        child->bridge->callback_child_held = false;
+        child->bridge_borrow_held = false;
+        child->held = false;
+        child->creation_owner = NULL;
+        child->holder = NULL;
+        child->runtime_holder = NULL;
+        child->claim->held = false;
+        child->claim->canonical_owner = NULL;
+        child->closing = false;
+        *holder = NULL;
+    } else {
+        child->closing = false;
+    }
+    qemu_mutex_unlock(&registry->mutex);
+    return first;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_callback_child_storage_observe_v1(
+    qemu_plugin_id_t id, QemuCrucibleCallbackChildStorage *child,
+    struct qemu_plugin_crucible_callback_child_status_v1 *out)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *registry = &startup_source.commands;
+    struct qemu_plugin_crucible_callback_child_status_v1 observed;
+    int status = command_registry_identity(id);
+
+    if (status || !out) {
+        return status ? status : -EINVAL;
+    }
+    qemu_mutex_lock(&registry->mutex);
+    status = callback_child_output_conflicts_locked(out, sizeof(*out)) ?
+        -EINVAL : callback_child_identity_locked(child);
+    if (!status) {
+        observed = (struct qemu_plugin_crucible_callback_child_status_v1) {
+            .schema_version = 1,
+            .struct_size = sizeof(observed),
+            .extent_bytes = child->extent,
+            .alignment_bytes = child->alignment,
+            .allocation_first_status = child->allocation_first_status,
+            .allocation_post_status = child->allocation_post_status,
+            .initialization_first_status = child->initialization_first_status,
+            .initialization_post_status = child->initialization_post_status,
+            .destructor_first_status = child->destructor_first_status,
+            .destructor_post_status = child->destructor_post_status,
+            .allocation_return_post_status = child->allocation_return_post_status,
+            .allocation_active = child->allocation_active,
+            .allocated = child->allocated,
+            .initialization_active = child->initialization_active,
+            .initialization_returned = child->initialization_returned,
+            .placement_started = child->placement_started,
+            .initialized = child->initialization_returned && child->initialized,
+            .prefix_rollback_completed = child->initialization_returned &&
+                child->prefix_rollback_completed,
+            .placement_uncertain = child->placement_uncertain,
+            .destructor_attempted = child->destructor_attempted,
+            .destruction_active = child->destruction_active,
+            .destructor_returned = child->destructor_returned,
+            .destroyed = child->destructor_returned && child->destroyed,
+            .destruction_uncertain = child->destruction_uncertain,
+            .transferred = child->transferred,
+            .physical_returned = child->physical_returned,
+            .bridge_borrow_held = child->bridge_borrow_held,
+            .registration_retained = child->registration_retained,
+        };
+        *out = observed;
+    }
+    qemu_mutex_unlock(&registry->mutex);
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_callback_child_storage_holder_observe_v1(
+    qemu_plugin_id_t id, QemuCrucibleCallbackChildStorage **runtime_field,
+    QemuCrucibleCallbackChildStorage **out)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *registry = &startup_source.commands;
+    QemuCrucibleCallbackChildStorage *child = &registry->child;
+    int status = command_registry_identity(id);
+
+    if (status || !out) {
+        return status ? status : -EINVAL;
+    }
+    qemu_mutex_lock(&registry->mutex);
+    if (out == runtime_field || callback_child_output_conflicts_locked(out, sizeof(*out))) {
+        status = -EINVAL;
+    } else if (!child->attempted || !child->held) {
+        status = -ENOKEY;
+    } else if ((child->transferred && runtime_field != child->runtime_holder) ||
+               (!child->transferred && runtime_field)) {
+        status = -EPERM;
+    } else {
+        status = callback_child_identity_locked(child);
+    }
+    if (!status) {
+        *out = child;
+    }
+    qemu_mutex_unlock(&registry->mutex);
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
diff --git a/plugins/crucible-callback-groups.inc.h b/plugins/crucible-callback-groups.inc.h
new file mode 100644
index 0000000000000000000000000000000000000000..f616d42f7206886415f069c9328f010259ccf011
--- /dev/null
+++ b/plugins/crucible-callback-groups.inc.h
@@ -0,0 +1,1012 @@
+/*
+ * Complete configured callback-group custody and transient registrar loans.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifdef CONFIG_LINUX
+static QemuCrucibleCallbackRegistrationGroupOwner *callback_group_slot(
+    QemuCrucibleNativeRegistrationGroupKind kind,
+    QemuCrucibleNativeRegistration **members, size_t *count)
+{
+    QemuCrucibleCallbackRegistrationGroups *groups = &startup_source.callback_groups;
+
+#define SOURCE_GROUP_SLOT(group, array) \
+    do { \
+        *members = groups->array; \
+        *count = G_N_ELEMENTS(groups->array); \
+        return &groups->group; \
+    } while (0)
+
+    switch (kind) {
+    case QEMU_CRUCIBLE_NATIVE_GROUP_IDLE_RESUME:
+        SOURCE_GROUP_SLOT(idle_resume, idle_resume_members);
+    case QEMU_CRUCIBLE_NATIVE_GROUP_SHMEM_DISPATCH:
+        SOURCE_GROUP_SLOT(shmem_dispatch, shmem_dispatch_members);
+    case QEMU_CRUCIBLE_NATIVE_GROUP_NET_TX:
+        SOURCE_GROUP_SLOT(net_tx, net_tx_members);
+    case QEMU_CRUCIBLE_NATIVE_GROUP_BLOCK_IO:
+        SOURCE_GROUP_SLOT(block_io, block_io_members);
+    case QEMU_CRUCIBLE_NATIVE_GROUP_BLOCK_EVENT:
+        SOURCE_GROUP_SLOT(block_event, block_event_members);
+    case QEMU_CRUCIBLE_NATIVE_GROUP_BLOCK_WAIT:
+        SOURCE_GROUP_SLOT(block_wait, block_wait_members);
+    case QEMU_CRUCIBLE_NATIVE_GROUP_9P:
+        SOURCE_GROUP_SLOT(nine_p, nine_p_members);
+    case QEMU_CRUCIBLE_NATIVE_GROUP_ACCELERATOR:
+        SOURCE_GROUP_SLOT(accelerator, accelerator_members);
+    case QEMU_CRUCIBLE_NATIVE_GROUP_CONTROL:
+        SOURCE_GROUP_SLOT(control, control_members);
+    case QEMU_CRUCIBLE_NATIVE_GROUP_TIME_ADVANCE:
+        SOURCE_GROUP_SLOT(time_advance, time_advance_members);
+    case QEMU_CRUCIBLE_NATIVE_GROUP_VCPU_INIT:
+        SOURCE_GROUP_SLOT(vcpu_init, vcpu_init_members);
+    default:
+        return NULL;
+    }
+#undef SOURCE_GROUP_SLOT
+}
+
+static struct qemu_plugin_cb *callback_group_callback(
+    QemuCrucibleNativeRegistrationGroupKind kind)
+{
+    /* Catalog identity selects Source's complete prepaid cell. A caller
+     * cannot nominate a descriptor, and its mutable Native fields are never
+     * inspected under the Source mutex. The real Native effect owns them. */
+    return kind == QEMU_CRUCIBLE_NATIVE_GROUP_VCPU_INIT ?
+        &startup_source.callback_groups.vcpu_init_callback : NULL;
+}
+
+static bool callback_group_output_conflicts_locked(const void *output, size_t bytes)
+{
+    return callback_child_output_conflicts_locked(output, bytes) ||
+        callback_child_output_overlap(output, bytes, &startup_source.callback_groups,
+                                     sizeof(startup_source.callback_groups));
+}
+
+static int callback_group_identity_locked(
+    QemuCrucibleCallbackRegistrationGroupOwner *owner,
+    QemuCrucibleNativeRegistrationGroupKind kind, uint64_t serial)
+{
+    QemuCrucibleNativeRegistration *members = NULL;
+    size_t count = 0;
+    QemuCrucibleCallbackRegistrationGroupOwner *canonical =
+        callback_group_slot(kind, &members, &count);
+    int status;
+
+    /* The real registry selects the complete nominal slot before any caller
+     * owner field is read. A copied kind/count/pointer supplies no custody. */
+    if (!canonical || owner != canonical) {
+        return -EPERM;
+    }
+    if (owner->canonical_owner != owner ||
+        !owner->attempted || !owner->held || owner->returned ||
+        owner->kind != kind || !serial || owner->publication_serial != serial ||
+        owner->members != members || owner->member_count != count ||
+        owner->callback != callback_group_callback(kind) ||
+        owner->child_owner != &startup_source.callbacks.owner ||
+        (!owner->transferred && (owner->creation_owner != owner ||
+                                owner->holder != &owner->creation_owner)) ||
+        (owner->transferred && (owner->creation_owner ||
+                               owner->holder != owner->runtime_holder))) {
+        return -ESTALE;
+    }
+    status = callback_child_owner_identity_locked(owner->child_owner);
+    if (!status && owner->transferred) {
+        uintptr_t field = (uintptr_t)owner->runtime_holder;
+
+        if (!owner->runtime_base ||
+            owner->runtime_base != owner->child_owner->runtime_base ||
+            owner->runtime_extent != owner->child_owner->runtime_extent ||
+            owner->runtime_extent < sizeof(*owner->runtime_holder) ||
+            owner->runtime_extent > UINTPTR_MAX - owner->runtime_base ||
+            field < owner->runtime_base ||
+            field % _Alignof(QemuCrucibleCallbackRegistrationGroupOwner *) ||
+            field - owner->runtime_base >
+                owner->runtime_extent - sizeof(*owner->runtime_holder)) {
+            status = -ESTALE;
+        } else if (*owner->runtime_holder != owner) {
+            status = -ESTALE;
+        }
+    }
+    return status;
+}
+
+static int callback_group_live_locked(
+    QemuCrucibleCallbackRegistrationGroupOwner *owner,
+    QemuCrucibleNativeRegistrationGroupKind kind, uint64_t serial)
+{
+    int status = callback_group_identity_locked(owner, kind, serial);
+
+    if (!status && (!owner->current || !owner->span_held ||
+                    startup_source.callback_groups.entered != owner ||
+                    owner->first_status || owner->post_status ||
+                    !qemu_thread_is_self(&owner->thread))) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        status = callback_registration_owner_live_locked(owner->child_owner);
+    }
+    return status;
+}
+
+static void callback_group_record_locked(
+    QemuCrucibleCallbackRegistrationGroupOwner *owner,
+    QemuCrucibleNativeRegistrationGroupKind kind, uint64_t serial,
+    int first, int post)
+{
+    if (callback_group_identity_locked(owner, kind, serial)) {
+        return;
+    }
+    if (first && !owner->first_status) {
+        owner->first_status = first;
+    }
+    if (post && !owner->post_status) {
+        owner->post_status = post;
+    }
+    if (first || post) {
+        owner->current = false;
+    }
+}
+
+static int callback_group_registrar_identity_locked(
+    QemuCrucibleCallbackRegistrationGroupBorrow *borrow, uint64_t serial,
+    QemuCrucibleNativeRegistrationGroupKind kind)
+{
+    QemuCrucibleCallbackRegistrationGroups *groups = &startup_source.callback_groups;
+    int status;
+
+    if (borrow != &groups->borrower || borrow->canonical_owner != borrow ||
+        !borrow->held || !serial || borrow->serial != serial ||
+        !qemu_thread_is_self(&borrow->thread)) {
+        return -EPERM;
+    }
+    status = callback_group_identity_locked(borrow->owner, kind, borrow->publication_serial);
+    if (!status && (!borrow->owner->transferred || !borrow->owner->native_debt ||
+                    !borrow->owner->child_owner->child->publication_users)) {
+        status = -ESTALE;
+    }
+    return status;
+}
+
+static int callback_group_registrar_current_locked(
+    QemuCrucibleCallbackRegistrationGroupBorrow *borrow, uint64_t serial,
+    QemuCrucibleNativeRegistrationGroupKind kind)
+{
+    int status = callback_group_registrar_identity_locked(borrow, serial, kind);
+
+    return status ? status : callback_group_live_locked(
+        borrow->owner, kind, borrow->publication_serial);
+}
+#endif
+
+int qemu_plugin_crucible_callback_group_begin_v1(
+    qemu_plugin_id_t id, QemuCrucibleCallbackChildStorage *child,
+    QemuCrucibleNativeRegistrationGroupKind kind,
+    QemuCrucibleCallbackRegistrationGroupOwner **out, uint64_t *serial)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    QemuCrucibleCallbackRegistrationGroups *groups = &startup_source.callback_groups;
+    QemuCrucibleNativeRegistration *members = NULL;
+    QemuCrucibleCallbackRegistrationGroupOwner *owner;
+    QemuCrucibleCallbackChildOwner *child_owner = &startup_source.callbacks.owner;
+    QemuThread thread;
+    size_t count = 0;
+    int first = command_registry_identity(id);
+    int post;
+
+    if (first || !startup_invocation(id) || startup_source.install_returned) {
+        return first ? first : -EPERM;
+    }
+    if (!out || !serial) {
+        return -EINVAL;
+    }
+    owner = callback_group_slot(kind, &members, &count);
+    if (!owner) {
+        return -EINVAL;
+    }
+    first = startup_process_purpose_live();
+    if (!first) {
+        first = qemu_crucible_checkpoint_storage_current_v1();
+    }
+    if (first) {
+        return first;
+    }
+    qemu_thread_get_self(&thread);
+    qemu_mutex_lock(&commands->mutex);
+    if (callback_group_output_conflicts_locked(out, sizeof(*out)) ||
+        callback_group_output_conflicts_locked(serial, sizeof(*serial)) ||
+        callback_child_output_overlap(out, sizeof(*out), serial, sizeof(*serial))) {
+        first = -EINVAL;
+    } else if (*out || *serial) {
+        first = -EINVAL;
+    } else {
+        first = callback_registration_owner_live_locked(child_owner);
+    }
+    if (!first && (child != child_owner->child || groups->entered ||
+                   groups->borrower.held || startup_source.callbacks.publication.held ||
+                   startup_source.callbacks.registrar.held || owner->attempted)) {
+        first = -EBUSY;
+    }
+    if (!first && (groups->publication_serial == UINT64_MAX ||
+                   child->publication_users == UINT64_MAX)) {
+        first = -EOVERFLOW;
+    }
+    if (first) {
+        qemu_mutex_unlock(&commands->mutex);
+        return first;
+    }
+    *owner = (QemuCrucibleCallbackRegistrationGroupOwner) {
+        .canonical_owner = owner,
+        .creation_owner = owner,
+        .holder = &owner->creation_owner,
+        .child_owner = child_owner,
+        .callback = callback_group_callback(kind),
+        .members = members,
+        .member_count = count,
+        .thread = thread,
+        .publication_serial = ++groups->publication_serial,
+        .kind = kind,
+        .attempted = true,
+        .held = true,
+        .current = true,
+        .span_held = true,
+    };
+    child->publication_users++;
+    groups->entered = owner;
+    *out = owner;
+    *serial = owner->publication_serial;
+    qemu_mutex_unlock(&commands->mutex);
+
+    /* Canonical Source custody and the complete role span survive this post.
+     * The same installing Original is observed; no callback group is inferred
+     * from a single-family span or a decoded tuple. */
+    first = callback_native_prepare_owner(child_owner);
+    post = startup_process_purpose_live();
+    qemu_mutex_lock(&commands->mutex);
+    callback_group_record_locked(owner, kind, owner->publication_serial, first, post);
+    qemu_mutex_unlock(&commands->mutex);
+    if (post) {
+        crucible_metadata_partition_record_post(&startup_source.metadata_partition, post);
+    }
+    return first ? first : post;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_crucible_startup_source_callback_group_borrow_current_v1(
+    QemuCrucibleNativeRegistrationGroupKind kind,
+    QemuCrucibleCallbackRegistrationGroupBorrow **out, uint64_t *serial)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    QemuCrucibleCallbackRegistrationGroups *groups = &startup_source.callback_groups;
+    QemuCrucibleCallbackRegistrationGroupBorrow *borrow = &groups->borrower;
+    QemuCrucibleCallbackRegistrationGroupOwner *owner;
+    QemuThread thread;
+    qemu_plugin_id_t id;
+    int first;
+    int post;
+
+    if (!out || !serial) {
+        return -EINVAL;
+    }
+    /* Ordinary absence is decided by Source itself and performs no write,
+     * lock, syscall, denial-as-fallback or invented installing invocation. */
+    if (!qatomic_load_acquire(&qemu_crucible_selected_process_id) &&
+        !qemu_plugin_crucible_startup_source_retained()) {
+        return *out || *serial ? -EINVAL : 0;
+    }
+    first = callback_registry_identity(&id);
+    if (first || !startup_invocation(id) || startup_source.install_returned) {
+        return first ? first : -EPERM;
+    }
+    first = source_control_component_identity(&startup_source.control_callback);
+    if (!first) {
+        first = startup_process_purpose_live();
+    }
+    if (first) {
+        return first;
+    }
+    qemu_thread_get_self(&thread);
+    qemu_mutex_lock(&commands->mutex);
+    owner = groups->entered;
+    if (callback_group_output_conflicts_locked(out, sizeof(*out)) ||
+        callback_group_output_conflicts_locked(serial, sizeof(*serial)) ||
+        callback_child_output_overlap(out, sizeof(*out), serial, sizeof(*serial))) {
+        first = -EINVAL;
+    } else if (*out || *serial) {
+        first = -EINVAL;
+    } else if (!owner) {
+        /* An entered single-family span is not this complete group owner. */
+        first = -ENOKEY;
+    } else {
+        first = callback_group_live_locked(owner, kind, owner->publication_serial);
+    }
+    if (!first && (!owner->transferred || borrow->held ||
+                   startup_source.callbacks.registrar.held ||
+                   !startup_source.callbacks.native_prepared)) {
+        first = -EBUSY;
+    }
+    if (!first && owner->native_debt) {
+        /* One complete registrar attempt per configured owner. A partial or
+         * unknown previous installation cannot be replayed as a fresh group. */
+        first = -EALREADY;
+    }
+    if (!first && (groups->registrar_serial == UINT64_MAX ||
+                   (!owner->native_debt &&
+                    owner->child_owner->child->publication_users == UINT64_MAX))) {
+        first = -EOVERFLOW;
+    }
+    if (first) {
+        qemu_mutex_unlock(&commands->mutex);
+        return first;
+    }
+    /* Giving Native its exact prepriced writable record span may create
+     * registrations even if a later signed result refuses. This distinct
+     * physical pin remains after both borrowed output and typed-span return. */
+    if (!owner->native_debt) {
+        owner->child_owner->child->publication_users++;
+        owner->native_debt = true;
+    }
+    *borrow = (QemuCrucibleCallbackRegistrationGroupBorrow) {
+        .canonical_owner = borrow,
+        .owner = owner,
+        .thread = thread,
+        .publication_serial = owner->publication_serial,
+        .serial = ++groups->registrar_serial,
+        .held = true,
+    };
+    *out = borrow;
+    *serial = borrow->serial;
+    qemu_mutex_unlock(&commands->mutex);
+
+    post = startup_process_purpose_live();
+    qemu_mutex_lock(&commands->mutex);
+    callback_group_record_locked(owner, kind, borrow->publication_serial, 0, post);
+    qemu_mutex_unlock(&commands->mutex);
+    if (post) {
+        crucible_metadata_partition_record_post(&startup_source.metadata_partition, post);
+    }
+    return post;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_callback_group_current_v1(
+    qemu_plugin_id_t id, QemuCrucibleCallbackRegistrationGroupOwner *owner,
+    uint64_t serial, QemuCrucibleNativeRegistrationGroupKind kind,
+    void **address, size_t *bytes, size_t *alignment)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    int first = command_registry_identity(id);
+    int post;
+
+    if (first || !startup_invocation(id) || startup_source.install_returned) {
+        return first ? first : -EPERM;
+    }
+    if (!address || !bytes || !alignment) {
+        return -EINVAL;
+    }
+    first = startup_process_purpose_live();
+    qemu_mutex_lock(&commands->mutex);
+    if (first) {
+        callback_group_record_locked(owner, kind, serial, first, 0);
+    }
+    if (!first && (callback_group_output_conflicts_locked(address, sizeof(*address)) ||
+                   callback_group_output_conflicts_locked(bytes, sizeof(*bytes)) ||
+                   callback_group_output_conflicts_locked(alignment, sizeof(*alignment)) ||
+                   callback_child_output_overlap(address, sizeof(*address), bytes, sizeof(*bytes)) ||
+                   callback_child_output_overlap(address, sizeof(*address), alignment, sizeof(*alignment)) ||
+                   callback_child_output_overlap(bytes, sizeof(*bytes), alignment, sizeof(*alignment)))) {
+        first = -EINVAL;
+    }
+    if (!first && (*address || *bytes || *alignment)) {
+        first = -EINVAL;
+    }
+    if (!first) {
+        first = callback_group_live_locked(owner, kind, serial);
+    }
+    if (!first && !owner->transferred) {
+        first = -ESTALE;
+    }
+    if (!first) {
+        *address = owner->child_owner->child->address;
+        *bytes = owner->child_owner->child->extent;
+        *alignment = owner->child_owner->child->alignment;
+    }
+    qemu_mutex_unlock(&commands->mutex);
+    if (first) {
+        return first;
+    }
+    post = startup_process_purpose_live();
+    qemu_mutex_lock(&commands->mutex);
+    callback_group_record_locked(owner, kind, serial, 0, post);
+    qemu_mutex_unlock(&commands->mutex);
+    if (post) {
+        crucible_metadata_partition_record_post(&startup_source.metadata_partition, post);
+    }
+    /* The real span output and its entered custody precede a negative post. */
+    return post;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_callback_group_span_return_v1(
+    qemu_plugin_id_t id, QemuCrucibleCallbackRegistrationGroupOwner **projection,
+    uint64_t serial, QemuCrucibleNativeRegistrationGroupKind kind)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    QemuCrucibleCallbackRegistrationGroups *groups = &startup_source.callback_groups;
+    QemuCrucibleCallbackRegistrationGroupOwner *owner;
+    int status = command_registry_identity(id);
+
+    if (status || !projection) {
+        return status ? status : -EINVAL;
+    }
+    qemu_mutex_lock(&commands->mutex);
+    if (callback_group_output_conflicts_locked(projection, sizeof(*projection))) {
+        status = -EINVAL;
+    } else {
+        owner = *projection;
+        status = callback_group_identity_locked(owner, kind, serial);
+    }
+    if (!status && (!owner->transferred || !owner->span_held || groups->entered != owner ||
+                    owner->receipt_active || owner->terminal_active ||
+                    groups->borrower.held || !qemu_thread_is_self(&owner->thread) ||
+                    !owner->child_owner->child->publication_users)) {
+        status = -EBUSY;
+    }
+    if (!status) {
+        owner->child_owner->child->publication_users--;
+        owner->span_held = false;
+        owner->current = false;
+        groups->entered = NULL;
+        *projection = NULL;
+    }
+    qemu_mutex_unlock(&commands->mutex);
+    /* Native debt and the canonical Runtime field are deliberately retained. */
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_callback_group_owner_return_v1(
+    qemu_plugin_id_t id, QemuCrucibleCallbackRegistrationGroupOwner **holder,
+    uint64_t serial, QemuCrucibleNativeRegistrationGroupKind kind)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    QemuCrucibleCallbackRegistrationGroups *groups = &startup_source.callback_groups;
+    QemuCrucibleNativeRegistration *members = NULL;
+    QemuCrucibleCallbackRegistrationGroupOwner *owner;
+    QemuCrucibleNativeGroupReceipt receipt = { 0 };
+    size_t count = 0;
+    bool terminal_needed = false;
+    int status = command_registry_identity(id);
+
+    if (status || !holder) {
+        return status ? status : -EINVAL;
+    }
+    qemu_mutex_lock(&commands->mutex);
+    owner = callback_group_slot(kind, &members, &count);
+    status = callback_group_identity_locked(owner, kind, serial);
+    if (!status && ((owner->transferred && holder != owner->runtime_holder) ||
+                    (!owner->transferred &&
+                     callback_group_output_conflicts_locked(holder, sizeof(*holder))))) {
+        status = -EINVAL;
+    }
+    if (!status && (*holder != owner || owner->receipt_active || owner->terminal_active ||
+                    (owner->transferred && owner->span_held) ||
+                    (groups->borrower.held && groups->borrower.owner == owner))) {
+        status = -EBUSY;
+    }
+    if (!status && owner->native_debt) {
+        owner->terminal_active = true;
+        terminal_needed = true;
+    }
+    qemu_mutex_unlock(&commands->mutex);
+
+    /* Native performs actual descriptor/user settlement and may release its
+     * module pin. It calls Source identity before its own locks, so neither
+     * operation runs under the Source ledger mutex. The whole holder stays
+     * permanent; this proof can settle only this group's payload dependency. */
+    if (terminal_needed) {
+        status = qemu_plugin_crucible_native_group_terminal_v1(
+            &startup_source.callbacks.native, owner, kind, serial);
+        int observed = qemu_plugin_crucible_native_group_receipt_observe_v1(
+            &startup_source.callbacks.native, owner, kind, serial, &receipt);
+
+        qemu_mutex_lock(&commands->mutex);
+        int identity = callback_group_identity_locked(owner, kind, serial);
+
+        if (!identity) {
+            owner->terminal_active = false;
+            if (status && !owner->terminal_status) {
+                owner->terminal_status = status;
+            }
+            if (!observed) {
+                owner->receipt = receipt;
+                owner->receipt_observed = true;
+            } else if (!owner->receipt_status) {
+                owner->receipt_status = observed;
+            }
+        }
+        if (!status) {
+            status = identity ? identity : observed;
+        }
+        if (!status && (!owner->transferred || holder != owner->runtime_holder ||
+                        *holder != owner || owner->span_held ||
+                        (groups->borrower.held && groups->borrower.owner == owner) ||
+                        !receipt.terminal || receipt.module_retained ||
+                        receipt.borrow_retained ||
+                        !owner->child_owner->child->publication_users)) {
+            status = -EBUSY;
+        }
+        if (!status) {
+            owner->child_owner->child->publication_users--;
+            owner->native_debt = false;
+        }
+        qemu_mutex_unlock(&commands->mutex);
+    }
+
+    qemu_mutex_lock(&commands->mutex);
+    if (!status) {
+        status = callback_group_identity_locked(owner, kind, serial);
+    }
+    if (!status && owner->span_held &&
+        (groups->entered != owner || !qemu_thread_is_self(&owner->thread) ||
+         !owner->child_owner->child->publication_users)) {
+        status = -EBUSY;
+    }
+    if (!status) {
+        /* Pretransfer negative birth never exposed a typed span or Native
+         * member storage. Consume its still-entered creation loan together
+         * with the exact movable projection without losing the return token. */
+        if (owner->span_held) {
+            owner->child_owner->child->publication_users--;
+            groups->entered = NULL;
+            owner->span_held = false;
+            owner->current = false;
+        }
+        *holder = NULL;
+        owner->creation_owner = NULL;
+        owner->holder = NULL;
+        owner->runtime_holder = NULL;
+        owner->held = false;
+        owner->returned = true;
+    }
+    qemu_mutex_unlock(&commands->mutex);
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_callback_group_holder_observe_v1(
+    qemu_plugin_id_t id, QemuCrucibleCallbackRegistrationGroupOwner **runtime_field,
+    QemuCrucibleNativeRegistrationGroupKind kind,
+    QemuCrucibleCallbackRegistrationGroupOwner **projection, uint64_t *serial)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    QemuCrucibleNativeRegistration *members = NULL;
+    QemuCrucibleCallbackRegistrationGroupOwner *owner;
+    size_t count = 0;
+    int status = command_registry_identity(id);
+
+    if (status || !runtime_field || !projection || !serial) {
+        return status ? status : -EINVAL;
+    }
+    qemu_mutex_lock(&commands->mutex);
+    owner = callback_group_slot(kind, &members, &count);
+    if (!owner) {
+        status = -EINVAL;
+    } else {
+        status = callback_group_identity_locked(owner, kind, owner->publication_serial);
+    }
+    if (!status && (!owner->transferred || runtime_field != owner->runtime_holder ||
+                    callback_group_output_conflicts_locked(projection, sizeof(*projection)) ||
+                    callback_group_output_conflicts_locked(serial, sizeof(*serial)) ||
+                    callback_child_output_overlap(projection, sizeof(*projection), serial, sizeof(*serial)))) {
+        status = -EINVAL;
+    }
+    if (!status && (*projection || *serial)) {
+        status = -EBUSY;
+    }
+    if (!status) {
+        *projection = owner;
+        *serial = owner->publication_serial;
+    }
+    qemu_mutex_unlock(&commands->mutex);
+    /* Factual output only; neither this getter nor a copied pointer starts a
+     * group, extends its Original or proves Native physical completion. */
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_callback_group_postreceipt_v1(
+    qemu_plugin_id_t id, QemuCrucibleCallbackRegistrationGroupOwner *owner,
+    uint64_t serial, QemuCrucibleNativeRegistrationGroupKind kind)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    QemuCrucibleCallbackRegistrationGroups *groups = &startup_source.callback_groups;
+    QemuCrucibleNativeGroupReceipt receipt = { 0 };
+    int first = command_registry_identity(id);
+    int observed;
+    int installed = 0;
+    int post;
+
+    if (first || !startup_invocation(id) || startup_source.install_returned) {
+        return first ? first : -EPERM;
+    }
+    qemu_mutex_lock(&commands->mutex);
+    first = callback_group_identity_locked(owner, kind, serial);
+    if (!first && (!owner->transferred || !owner->span_held ||
+                   groups->entered != owner || !qemu_thread_is_self(&owner->thread) ||
+                   !owner->native_debt || owner->receipt_active || owner->terminal_active)) {
+        first = -EBUSY;
+    }
+    if (first) {
+        qemu_mutex_unlock(&commands->mutex);
+        return first;
+    }
+    owner->receipt_active = true;
+    first = owner->first_status;
+    qemu_mutex_unlock(&commands->mutex);
+
+    observed = qemu_plugin_crucible_native_group_receipt_observe_v1(
+        &startup_source.callbacks.native, owner, kind, serial, &receipt);
+
+    /* Save every authentic partial/negative observation before another
+     * fallible current or post query. Native's mutex supplies the snapshot;
+     * copied fields alone cannot authenticate a complete registration set. */
+    qemu_mutex_lock(&commands->mutex);
+    int identity = callback_group_identity_locked(owner, kind, serial);
+
+    if (!identity) {
+        if (!observed) {
+            owner->receipt = receipt;
+            owner->receipt_observed = true;
+            if (!first) {
+                first = receipt.first_status;
+            }
+            callback_group_record_locked(owner, kind, serial,
+                                         receipt.first_status, receipt.post_status);
+        } else if (!owner->receipt_status) {
+            owner->receipt_status = observed;
+        }
+    }
+    if (!first) {
+        first = identity ? identity : observed;
+    }
+    qemu_mutex_unlock(&commands->mutex);
+
+    if (!first && !receipt.post_status && !receipt.return_status) {
+        installed = qemu_plugin_crucible_native_group_installed_current_v1(
+            &startup_source.callbacks.native, owner, kind, serial);
+        if (installed) {
+            first = installed;
+        }
+    }
+    post = startup_process_purpose_live();
+    qemu_mutex_lock(&commands->mutex);
+    identity = callback_group_identity_locked(owner, kind, serial);
+    if (!identity) {
+        if (!first && receipt.return_status) {
+            first = receipt.return_status;
+        }
+        callback_group_record_locked(owner, kind, serial, first, post);
+        owner->receipt_active = false;
+        if (!first && owner->post_status) {
+            post = owner->post_status;
+        }
+    } else if (!first) {
+        first = identity;
+    }
+    qemu_mutex_unlock(&commands->mutex);
+    if (post) {
+        crucible_metadata_partition_record_post(&startup_source.metadata_partition, post);
+    }
+    return first ? first : post;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_callback_group_status_observe_v1(
+    qemu_plugin_id_t id, QemuCrucibleCallbackRegistrationGroupOwner *owner,
+    uint64_t serial, QemuCrucibleNativeRegistrationGroupKind kind,
+    QemuCrucibleCallbackRegistrationGroupStatus *out)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    int status = command_registry_identity(id);
+
+    if (status || !out) {
+        return status ? status : -EINVAL;
+    }
+    qemu_mutex_lock(&commands->mutex);
+    status = callback_group_identity_locked(owner, kind, serial);
+    if (!status && callback_group_output_conflicts_locked(out, sizeof(*out))) {
+        status = -EINVAL;
+    }
+    if (!status) {
+        const QemuCrucibleNativeGroupReceipt *receipt = &owner->receipt;
+
+        *out = (QemuCrucibleCallbackRegistrationGroupStatus) {
+            .publication_serial = owner->publication_serial,
+            .registrar_serial = receipt->registrar_serial,
+            .member_count = owner->member_count,
+            .installed_members = receipt->installed_members,
+            .attempted_mask = receipt->attempted_mask,
+            .installed_mask = receipt->installed_mask,
+            .first_status = owner->first_status,
+            .post_status = owner->post_status,
+            .native_first_status = receipt->first_status,
+            .native_post_status = receipt->post_status,
+            .native_return_status = receipt->return_status,
+            .receipt_status = owner->receipt_status,
+            .terminal_status = owner->terminal_status,
+            .receipt_observed = owner->receipt_observed,
+            .native_debt = owner->native_debt,
+            .span_held = owner->span_held,
+            .receipt_active = owner->receipt_active,
+            .terminal_active = owner->terminal_active,
+            .reserved = receipt->reserved,
+            .effect_started = receipt->effect_started,
+            .effect_finished = receipt->effect_finished,
+            .complete = receipt->complete,
+            .module_retained = receipt->module_retained,
+            .borrow_retained = receipt->borrow_retained,
+            .terminal = receipt->terminal,
+        };
+    }
+    qemu_mutex_unlock(&commands->mutex);
+    /* A pure closing-safe snapshot lends no typed span, registrar or Original.
+     * Every refusal leaves caller output and all canonical fields intact. */
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_crucible_startup_source_callback_group_current_v1(
+    QemuCrucibleCallbackRegistrationGroupBorrow *borrow, uint64_t serial,
+    QemuCrucibleNativeRegistrationGroupKind kind)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    qemu_plugin_id_t id;
+    int first = callback_registry_identity(&id);
+    int post;
+
+    if (first || !startup_invocation(id) || startup_source.install_returned) {
+        return first ? first : -EPERM;
+    }
+    first = source_control_component_identity(&startup_source.control_callback);
+    if (!first) {
+        first = startup_process_purpose_live();
+    }
+    qemu_mutex_lock(&commands->mutex);
+    if (!first) {
+        first = callback_group_registrar_current_locked(borrow, serial, kind);
+    }
+    if (first && !callback_group_registrar_identity_locked(borrow, serial, kind)) {
+        callback_group_record_locked(borrow->owner, kind, borrow->publication_serial, first, 0);
+    }
+    qemu_mutex_unlock(&commands->mutex);
+    if (first) {
+        return first;
+    }
+    post = startup_process_purpose_live();
+    qemu_mutex_lock(&commands->mutex);
+    if (!callback_group_registrar_identity_locked(borrow, serial, kind)) {
+        callback_group_record_locked(borrow->owner, kind, borrow->publication_serial, 0, post);
+    }
+    qemu_mutex_unlock(&commands->mutex);
+    if (post) {
+        crucible_metadata_partition_record_post(&startup_source.metadata_partition, post);
+    }
+    return post;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_crucible_startup_source_callback_group_observe_v1(
+    QemuCrucibleCallbackRegistrationGroupBorrow *borrow, uint64_t serial,
+    QemuCrucibleNativeRegistrationGroupKind kind,
+    QemuCrucibleCallbackRegistrationGroupView *out)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    QemuCrucibleCallbackRegistrationGroupOwner *owner;
+    QemuCrucibleCallbackChildOwner *child_owner;
+    qemu_plugin_id_t id;
+    int status = callback_registry_identity(&id);
+
+    if (status || !out) {
+        return status ? status : -EINVAL;
+    }
+    qemu_mutex_lock(&commands->mutex);
+    if (callback_group_output_conflicts_locked(out, sizeof(*out))) {
+        status = -EINVAL;
+    } else {
+        status = callback_group_registrar_identity_locked(borrow, serial, kind);
+    }
+    if (!status) {
+        owner = borrow->owner;
+        child_owner = owner->child_owner;
+        *out = (QemuCrucibleCallbackRegistrationGroupView) {
+            .owner = owner,
+            .borrow = borrow,
+            .child_owner = child_owner,
+            .callback = owner->callback,
+            .registry = &startup_source.callbacks.native,
+            .native = &owner->native,
+            .members = owner->members,
+            .member_count = owner->member_count,
+            .ctx = child_owner->installer.ctx,
+            .module = child_owner->installer.module,
+            .runtime = child_owner->runtime,
+            .child = child_owner->child,
+            .bridge = child_owner->bridge,
+            .child_holder = child_owner->child_holder,
+            .bridge_holder = child_owner->bridge_holder,
+            .publication_serial = borrow->publication_serial,
+            .registrar_serial = serial,
+            .kind = kind,
+        };
+    }
+    qemu_mutex_unlock(&commands->mutex);
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_crucible_startup_source_callback_group_return_v1(
+    QemuCrucibleCallbackRegistrationGroupBorrow **projection, uint64_t serial,
+    QemuCrucibleNativeRegistrationGroupKind kind)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    QemuCrucibleCallbackRegistrationGroupBorrow *borrow =
+        &startup_source.callback_groups.borrower;
+    qemu_plugin_id_t id;
+    int status = callback_registry_identity(&id);
+
+    if (status || !projection) {
+        return status ? status : -EINVAL;
+    }
+    qemu_mutex_lock(&commands->mutex);
+    if (callback_group_output_conflicts_locked(projection, sizeof(*projection))) {
+        status = -EINVAL;
+    } else {
+        status = callback_group_registrar_identity_locked(borrow, serial, kind);
+    }
+    if (!status && *projection != borrow) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        /* This consumes only the synchronous registrar loan. No clock, ACK,
+         * copied snapshot or signed status retires Native lifetime debt. */
+        borrow->held = false;
+        borrow->canonical_owner = NULL;
+        *projection = NULL;
+    }
+    qemu_mutex_unlock(&commands->mutex);
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_crucible_startup_source_callback_group_owner_identity_v1(
+    QemuCrucibleCallbackRegistrationGroupOwner *owner,
+    QemuCrucibleNativeRegistrationGroupKind kind, uint64_t serial)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    qemu_plugin_id_t id;
+    int status = callback_registry_identity(&id);
+
+    if (status) {
+        return status;
+    }
+    qemu_mutex_lock(&commands->mutex);
+    status = callback_group_identity_locked(owner, kind, serial);
+    qemu_mutex_unlock(&commands->mutex);
+    /* Pure identity stays available after closing/revoke/expiry, and never
+     * grants a new entered group, typed span or registration effect. */
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_callback_group_transfer_v1(
+    qemu_plugin_id_t id, QemuCrucibleCallbackRegistrationGroupOwner **projection,
+    uint64_t serial, QemuCrucibleNativeRegistrationGroupKind kind,
+    QemuCrucibleCallbackRegistrationGroupOwner **runtime_field)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    QemuCrucibleCallbackRegistrationGroupOwner *owner;
+    uintptr_t field = (uintptr_t)runtime_field;
+    int first = command_registry_identity(id);
+    int post;
+
+    if (first || !startup_invocation(id) || !projection || !runtime_field) {
+        return first ? first : -EPERM;
+    }
+    first = startup_process_purpose_live();
+    if (first) {
+        return first;
+    }
+    qemu_mutex_lock(&commands->mutex);
+    if (callback_group_output_conflicts_locked(projection, sizeof(*projection)) ||
+        callback_group_output_conflicts_locked(runtime_field, sizeof(*runtime_field)) ||
+        callback_child_output_overlap(projection, sizeof(*projection),
+                                     runtime_field, sizeof(*runtime_field))) {
+        first = -EINVAL;
+    } else {
+        owner = *projection;
+        first = callback_group_identity_locked(owner, kind, serial);
+        if (!first) {
+            first = callback_registration_owner_live_locked(owner->child_owner);
+        }
+        if (!first && (owner->transferred || !owner->span_held ||
+                       startup_source.callback_groups.entered != owner ||
+                       !qemu_thread_is_self(&owner->thread) ||
+                       owner->child_owner->runtime_extent < sizeof(*runtime_field) ||
+                       owner->child_owner->runtime_extent >
+                           UINTPTR_MAX - owner->child_owner->runtime_base ||
+                       field < owner->child_owner->runtime_base ||
+                       field % _Alignof(QemuCrucibleCallbackRegistrationGroupOwner *) ||
+                       field - owner->child_owner->runtime_base >
+                           owner->child_owner->runtime_extent - sizeof(*runtime_field))) {
+            first = -ESTALE;
+        }
+        if (!first && *runtime_field) {
+            first = -EBUSY;
+        }
+        if (!first) {
+            *runtime_field = owner;
+            owner->runtime_holder = runtime_field;
+            owner->holder = runtime_field;
+            owner->runtime_base = owner->child_owner->runtime_base;
+            owner->runtime_extent = owner->child_owner->runtime_extent;
+            owner->transferred = true;
+            owner->creation_owner = NULL;
+            /* This Source-owned identity remains canonical after movement;
+             * the caller projection is consumed before independent post. */
+            *projection = NULL;
+        }
+    }
+    qemu_mutex_unlock(&commands->mutex);
+    if (first) {
+        return first;
+    }
+    post = startup_process_purpose_live();
+    qemu_mutex_lock(&commands->mutex);
+    callback_group_record_locked(owner, kind, serial, 0, post);
+    qemu_mutex_unlock(&commands->mutex);
+    if (post) {
+        crucible_metadata_partition_record_post(&startup_source.metadata_partition, post);
+    }
+    return post;
+#else
+    return -ENOTSUP;
+#endif
+}
diff --git a/plugins/crucible-callback-owner.inc.h b/plugins/crucible-callback-owner.inc.h
new file mode 100644
index 0000000000000000000000000000000000000000..fc1bd8b8810bbcebe166f9a77f3682c846e5ea9e
--- /dev/null
+++ b/plugins/crucible-callback-owner.inc.h
@@ -0,0 +1,331 @@
+/*
+ * Source-owned completed-child registration custody
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifdef CONFIG_LINUX
+static int callback_registration_owner_holder_identity_locked(
+    QemuCrucibleCallbackChildOwner *owner)
+{
+    QemuCrucibleCallbackPublicationRegistry *callbacks = &startup_source.callbacks;
+    QemuCrucibleCallbackChildStorage *child = &startup_source.commands.child;
+    QemuCrucibleFingerprintCompletionBinding *completion =
+        &startup_source.fingerprint_completion;
+    uintptr_t field;
+
+    /* Registry membership precedes every nominated owner dereference. */
+    if (owner != &callbacks->owner || owner->canonical_owner != owner ||
+        !owner->initialized || !owner->held || owner->returned ||
+        owner->child != child || !child->transferred) {
+        return -ESTALE;
+    }
+    if (!owner->transferred) {
+        return owner->holder == &owner->creation_owner &&
+            owner->creation_owner == owner ? 0 : -ESTALE;
+    }
+    field = (uintptr_t)owner->runtime_holder;
+    if (!completion->enrolled || completion->runtime != owner->runtime ||
+        (uintptr_t)completion->userdata != owner->runtime_base ||
+        child->runtime_base != owner->runtime_base ||
+        child->runtime_extent != owner->runtime_extent ||
+        owner->holder != owner->runtime_holder || !owner->runtime_base ||
+        owner->runtime_extent < sizeof(*owner->runtime_holder) ||
+        owner->runtime_extent > UINTPTR_MAX - owner->runtime_base ||
+        field < owner->runtime_base ||
+        field % _Alignof(QemuCrucibleCallbackChildOwner *) ||
+        field - owner->runtime_base >
+            owner->runtime_extent - sizeof(*owner->runtime_holder)) {
+        return -ESTALE;
+    }
+    return *owner->runtime_holder == owner ? 0 : -ESTALE;
+}
+
+static int callback_registration_owner_live_locked(
+    QemuCrucibleCallbackChildOwner *owner)
+{
+    int status = callback_child_owner_identity_locked(owner);
+
+    if (!status && (!owner->transferred || owner->closing ||
+                    owner->first_status || owner->post_status ||
+                    owner->child->allocation_first_status ||
+                    owner->child->allocation_post_status ||
+                    owner->child->initialization_first_status ||
+                    owner->child->initialization_post_status ||
+                    owner->child->closing || owner->child->callback_closing ||
+                    owner->child->destructor_attempted ||
+                    owner->child->physical_returned ||
+                    !owner->bridge->initialized ||
+                    !owner->bridge->initialization_returned ||
+                    owner->bridge->initialization_active ||
+                    owner->bridge->initialization_uncertain ||
+                    owner->bridge->first_status || owner->bridge->post_status ||
+                    owner->bridge->initialize_first_status ||
+                    owner->bridge->initialize_post_status ||
+                    owner->bridge->closing || owner->bridge->destructor_attempted ||
+                    owner->bridge->destroyed || owner->bridge->physical_returned)) {
+        status = -ESTALE;
+    }
+    return status;
+}
+#endif
+
+int qemu_plugin_crucible_callback_registration_owner_create_v1(
+    qemu_plugin_id_t id, QemuCrucibleCallbackChildStorage *child,
+    QemuCrucibleCallbackChildOwner **out)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    QemuCrucibleCallbackChildOwner *owner = &startup_source.callbacks.owner;
+    int first = command_registry_identity(id);
+    int post;
+
+    if (first || !out || !startup_invocation(id) || startup_source.install_returned) {
+        return first ? first : -EPERM;
+    }
+    first = startup_runtime_admission(id, &startup_source.runtime_purpose);
+    if (!first) {
+        /* This exact compiled Source holder includes the owner before birth. */
+        first = qemu_crucible_checkpoint_storage_current_v1();
+    }
+    if (!first) {
+        first = fingerprint_completion_identity(&startup_source.fingerprint_completion);
+    }
+    if (first) {
+        return first;
+    }
+    qemu_mutex_lock(&commands->mutex);
+    if (callback_child_output_conflicts_locked(out, sizeof(*out)) || *out) {
+        first = -EINVAL;
+    } else {
+        first = callback_child_identity_locked(child);
+    }
+    if (!first && (!child->initialized || !child->initialization_returned ||
+                   child->initialization_active || child->placement_uncertain ||
+                   child->closing || child->callback_closing ||
+                   child->destructor_attempted || child->physical_returned ||
+                   !child->transferred || !child->bridge->transferred ||
+                   owner->initialized)) {
+        first = -EBUSY;
+    }
+    if (!first && child->publication_users == UINT64_MAX) {
+        first = -EOVERFLOW;
+    }
+    if (first) {
+        qemu_mutex_unlock(&commands->mutex);
+        return first;
+    }
+
+    /* The fixed Source field owns creation; the caller receives only a
+     * movable projection. This is a real borrower of the completed child,
+     * whose Bridge remains owned by its separate Runtime canonical field. */
+    *owner = (QemuCrucibleCallbackChildOwner) {
+        .canonical_owner = owner,
+        .creation_owner = owner,
+        .holder = &owner->creation_owner,
+        .child = child,
+        .bridge = child->bridge,
+        .runtime = child->runtime,
+        .child_holder = child->runtime_holder,
+        .bridge_holder = child->bridge->runtime_holder,
+        .installer = child->installer,
+        .process_generation = child->process_generation,
+        .account_generation = child->account_generation,
+        .process = child->process,
+        .initialized = true,
+        .held = true,
+    };
+    child->publication_users++;
+    *out = owner;
+    qemu_mutex_unlock(&commands->mutex);
+
+    post = startup_process_purpose_live();
+    qemu_mutex_lock(&commands->mutex);
+    owner->post_status = post;
+    qemu_mutex_unlock(&commands->mutex);
+    if (post) {
+        crucible_metadata_partition_record_post(&startup_source.metadata_partition, post);
+    }
+    return post;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_callback_registration_owner_transfer_v1(
+    qemu_plugin_id_t id, QemuCrucibleCallbackChildOwner **projection,
+    QemuCrucibleCallbackChildOwner **runtime_field)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    QemuCrucibleCallbackChildOwner *owner = &startup_source.callbacks.owner;
+    QemuCrucibleCallbackChildStorage *child = &commands->child;
+    uintptr_t field = (uintptr_t)runtime_field;
+    int status = command_registry_identity(id);
+    int post;
+
+    if (status || !projection || !runtime_field ||
+        !startup_invocation(id) || startup_source.install_returned) {
+        return status ? status : -EPERM;
+    }
+    status = startup_runtime_admission(id, &startup_source.runtime_purpose);
+    if (status) {
+        return status;
+    }
+    qemu_mutex_lock(&commands->mutex);
+    if (callback_child_output_conflicts_locked(projection, sizeof(*projection)) ||
+        callback_child_output_conflicts_locked(runtime_field, sizeof(*runtime_field)) ||
+        callback_child_output_overlap(projection, sizeof(*projection),
+                                      runtime_field, sizeof(*runtime_field))) {
+        status = -EINVAL;
+    } else {
+        status = callback_child_owner_identity_locked(owner);
+    }
+    if (!status && (*projection != owner || owner->transferred ||
+                    owner->closing || owner->first_status || owner->post_status ||
+                    child->closing || child->callback_closing ||
+                    child->destructor_attempted || child->physical_returned)) {
+        status = -ESTALE;
+    }
+    /* The nominal child authenticates this paid Runtime. Range and alignment
+     * corroborate its distinct stable field; they cannot nominate a child. */
+    if (!status && (!child->runtime_base ||
+                    child->runtime_extent < sizeof(*runtime_field) ||
+                    child->runtime_extent > UINTPTR_MAX - child->runtime_base ||
+                    field < child->runtime_base ||
+                    field % _Alignof(QemuCrucibleCallbackChildOwner *) ||
+                    field - child->runtime_base >
+                        child->runtime_extent - sizeof(*runtime_field))) {
+        status = -EINVAL;
+    }
+    if (!status && *runtime_field) {
+        status = -EINVAL;
+    }
+    if (!status) {
+        *runtime_field = owner;
+        owner->runtime_holder = runtime_field;
+        owner->runtime_base = child->runtime_base;
+        owner->runtime_extent = child->runtime_extent;
+        owner->holder = runtime_field;
+        owner->transferred = true;
+        owner->creation_owner = NULL;
+        *projection = NULL;
+    }
+    qemu_mutex_unlock(&commands->mutex);
+    if (status) {
+        return status;
+    }
+    post = startup_process_purpose_live();
+    qemu_mutex_lock(&commands->mutex);
+    if (post && !owner->post_status) {
+        owner->post_status = post;
+    }
+    qemu_mutex_unlock(&commands->mutex);
+    if (post) {
+        crucible_metadata_partition_record_post(&startup_source.metadata_partition, post);
+    }
+    return post;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_callback_registration_owner_current_v1(
+    qemu_plugin_id_t id, QemuCrucibleCallbackChildOwner *owner)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    int status = command_registry_identity(id);
+
+    if (status) {
+        return status;
+    }
+    qemu_mutex_lock(&commands->mutex);
+    status = callback_registration_owner_live_locked(owner);
+    qemu_mutex_unlock(&commands->mutex);
+    /* Nominal physical observation only: typed body access, registrar effects,
+     * callback entry and operations require their independent retained cuts. */
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_callback_registration_owner_return_v1(
+    qemu_plugin_id_t id, QemuCrucibleCallbackChildOwner **holder)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    QemuCrucibleCallbackPublicationRegistry *callbacks = &startup_source.callbacks;
+    QemuCrucibleCallbackChildOwner *owner = &callbacks->owner;
+    QemuCrucibleCallbackChildStorage *child = &commands->child;
+    int status = command_registry_identity(id);
+
+    if (status || !holder) {
+        return status ? status : -EINVAL;
+    }
+    qemu_mutex_lock(&commands->mutex);
+    if ((!owner->transferred &&
+         callback_child_output_conflicts_locked(holder, sizeof(*holder))) ||
+        (owner->transferred && holder != owner->runtime_holder)) {
+        status = -EINVAL;
+    } else {
+        status = callback_child_owner_identity_locked(owner);
+    }
+    if (!status && (*holder != owner || owner->child != child || child->closing ||
+                    owner->component_users || owner->workspace_users ||
+                    owner->service_users || owner->publisher_service ||
+                    startup_source.publisher_module.held ||
+                    callbacks->publication.held || callbacks->registrar.held ||
+                    startup_source.callback_groups.entered ||
+                    startup_source.callback_groups.borrower.held ||
+                    callbacks->native_preparing || child->publication_users != 1)) {
+        status = -EBUSY;
+    }
+    if (status) {
+        qemu_mutex_unlock(&commands->mutex);
+        return status;
+    }
+
+    /* Close admission permanently, but retain the owner and its sole child
+     * pin while Native proves terminal custody outside the Source mutex. */
+    owner->closing = true;
+    child->callback_closing = true;
+    child->closing = true;
+    qemu_mutex_unlock(&commands->mutex);
+
+    status = callback_child_native_retire(child);
+
+    qemu_mutex_lock(&commands->mutex);
+    if (!status) {
+        status = callback_child_owner_identity_locked(owner);
+    }
+    if (!status && (owner->child != child || *holder != owner ||
+                    (owner->transferred && holder != owner->runtime_holder) ||
+                    !child->closing || child->publication_users != 1 ||
+                    owner->component_users || owner->workspace_users ||
+                    owner->service_users || owner->publisher_service ||
+                    startup_source.publisher_module.held ||
+                    callbacks->publication.held || callbacks->registrar.held ||
+                    startup_source.callback_groups.entered ||
+                    startup_source.callback_groups.borrower.held ||
+                    callbacks->native_preparing)) {
+        status = -EBUSY;
+    }
+    if (!status) {
+        child->registration_retained = false;
+        child->publication_users--;
+        *holder = NULL;
+        owner->creation_owner = NULL;
+        owner->holder = NULL;
+        owner->held = false;
+        owner->returned = true;
+    }
+    /* A failed proof retains the exact owner and pin. Only the transient
+     * transition latch opens for a continuation by that same closing owner. */
+    child->closing = false;
+    qemu_mutex_unlock(&commands->mutex);
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
diff --git a/plugins/crucible-callback-publication.inc.h b/plugins/crucible-callback-publication.inc.h
new file mode 100644
index 0000000000000000000000000000000000000000..5fa429333eac7974d7272a2839c089758c8ac057
--- /dev/null
+++ b/plugins/crucible-callback-publication.inc.h
@@ -0,0 +1,826 @@
+/*
+ * Retained Source child publication and permanent native holder custody
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifdef CONFIG_LINUX
+static int callback_registry_identity(qemu_plugin_id_t *id)
+{
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+
+    /* Acquire the real initialization publication before reading any saved
+     * installer association. Reject fork copies before the inherited mutex. */
+    if (!qatomic_load_acquire(&startup_source.module_custody_published) ||
+        !qatomic_load_acquire(&commands->initialized) ||
+        getpid() != commands->process || commands->process != startup_source.owner_process) {
+        return -EPERM;
+    }
+    *id = startup_source.saved.plugin_id;
+    return command_registry_identity(*id);
+}
+
+static int callback_child_owner_identity_locked(QemuCrucibleCallbackChildOwner *owner)
+{
+    QemuCrucibleCallbackPublicationRegistry *callbacks = &startup_source.callbacks;
+    QemuCrucibleCallbackChildStorage *child = &startup_source.commands.child;
+    int status;
+
+    if (owner != &callbacks->owner || owner->canonical_owner != owner ||
+        !owner->initialized || owner->child != child ||
+        owner->bridge != &startup_source.commands.storage ||
+        owner->runtime != &startup_source.runtime_purpose ||
+        owner->child_holder != child->runtime_holder ||
+        owner->bridge_holder != owner->bridge->runtime_holder ||
+        owner->installer.ctx != startup_source.saved.ctx ||
+        owner->installer.module != startup_source.saved.module ||
+        owner->installer.install != startup_source.saved.install ||
+        owner->process != startup_source.commands.process ||
+        owner->process_generation != startup_source.original.process_generation ||
+        owner->account_generation != startup_source.standing.initial.account_generation) {
+        return -ESTALE;
+    }
+    status = callback_child_identity_locked(child);
+    if (!status) {
+        status = callback_registration_owner_holder_identity_locked(owner);
+    }
+    if (!status && (!child->transferred || !child->initialized ||
+                    !child->initialization_returned || child->placement_uncertain ||
+                    !owner->bridge->transferred || !child->bridge_borrow_held)) {
+        status = -ESTALE;
+    }
+    return status;
+}
+
+static int callback_publication_identity_locked(
+    QemuCrucibleCallbackPublicationLoan *publication, uint64_t serial)
+{
+    QemuCrucibleCallbackPublicationRegistry *callbacks = &startup_source.callbacks;
+    int status;
+
+    if (publication != &callbacks->publication || !serial ||
+        publication->canonical_owner != publication || !publication->held ||
+        publication->serial != serial || publication->owner != &callbacks->owner ||
+        startup_source.install_returned || !startup_invocation(startup_source.saved.plugin_id) ||
+        !qemu_thread_is_self(&publication->thread)) {
+        return -ESTALE;
+    }
+    status = callback_child_owner_identity_locked(publication->owner);
+    return status;
+}
+
+static int callback_registrar_identity_locked(
+    QemuCrucibleCallbackRegistrationBorrow *borrow, uint64_t serial)
+{
+    QemuCrucibleCallbackPublicationRegistry *callbacks = &startup_source.callbacks;
+    int status;
+
+    if (borrow != &callbacks->registrar || !serial ||
+        borrow->canonical_owner != borrow || !borrow->held || borrow->serial != serial ||
+        borrow->publication != &callbacks->publication ||
+        borrow->owner != &callbacks->owner || !qemu_thread_is_self(&borrow->thread)) {
+        return -ESTALE;
+    }
+    status = callback_publication_identity_locked(borrow->publication,
+                                                  borrow->publication_serial);
+    return status;
+}
+
+static void callback_publication_record_refusal_locked(
+    QemuCrucibleCallbackPublicationLoan *publication, uint64_t serial,
+    int first, int post)
+{
+    if (callback_publication_identity_locked(publication, serial)) {
+        return;
+    }
+    if (first && !publication->first_status) {
+        publication->first_status = first;
+    }
+    if (post && !publication->post_status) {
+        publication->post_status = post;
+    }
+    if (first || post) {
+        publication->current = false;
+    }
+}
+
+static int callback_native_prepare_owner(QemuCrucibleCallbackChildOwner *owner)
+{
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    QemuCrucibleCallbackPublicationRegistry *callbacks = &startup_source.callbacks;
+    QemuCrucibleNativeInvocationRegistry *native = &callbacks->native;
+    int status;
+
+    qemu_mutex_lock(&commands->mutex);
+    status = callback_registration_owner_live_locked(owner);
+    if (!status && callbacks->native_prepared) {
+        qemu_mutex_unlock(&commands->mutex);
+        return 0;
+    }
+    if (!status && callbacks->native_preparing) {
+        status = -EBUSY;
+    }
+    if (status) {
+        qemu_mutex_unlock(&commands->mutex);
+        return status;
+    }
+    callbacks->native_preparing = true;
+    /* Nothing can fetch the native mutex yet. The permanent inline holder
+     * was paid in sizeof(Source) before this unique initialization phase. */
+    native->canonical_owner = native;
+    native->ctx = owner->installer.ctx;
+    native->module = owner->installer.module;
+    native->runtime = owner->runtime;
+    native->storage = owner->bridge;
+    native->storage_holder = owner->bridge_holder;
+    native->process = owner->process;
+    native->process_generation = owner->process_generation;
+    native->account_generation = owner->account_generation;
+    qemu_mutex_unlock(&commands->mutex);
+
+    qemu_mutex_init(&native->mutex);
+    qemu_mutex_lock(&commands->mutex);
+    native->initialized = true;
+    callbacks->native_preparing = false;
+    callbacks->native_prepared = true;
+    /* Paid permanent holder discovery lets unknown nested callbacks suppress
+     * factual frames. Runtime selection and bound admission stay separate. */
+    qatomic_store_release(&callbacks->dispatch_hint, native);
+    qemu_mutex_unlock(&commands->mutex);
+    return 0;
+}
+
+static int callback_native_prepare(QemuCrucibleCallbackPublicationLoan *publication)
+{
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    int status;
+
+    qemu_mutex_lock(&commands->mutex);
+    status = callback_publication_identity_locked(publication, publication->serial);
+    qemu_mutex_unlock(&commands->mutex);
+    return status ? status : callback_native_prepare_owner(&startup_source.callbacks.owner);
+}
+
+static bool callback_publication_family_known(QemuCrucibleCallbackPublicationFamily family)
+{
+    return family >= QEMU_CRUCIBLE_CALLBACK_VCPU_INIT &&
+        family <= QEMU_CRUCIBLE_CALLBACK_SHMEM_OBSERVER_ADVANCE;
+}
+#endif
+
+int qemu_plugin_crucible_callback_child_publication_begin_v1(
+    qemu_plugin_id_t id, QemuCrucibleCallbackChildStorage *child,
+    QemuCrucibleCallbackPublicationFamily family,
+    QemuCrucibleCallbackPublicationLoan **out, uint64_t *serial)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    QemuCrucibleCallbackPublicationRegistry *callbacks = &startup_source.callbacks;
+    QemuCrucibleCallbackPublicationLoan *publication = &callbacks->publication;
+    QemuCrucibleCallbackChildOwner *owner = &callbacks->owner;
+    QemuThread thread;
+    int status = command_registry_identity(id);
+    int post;
+
+    if (status || !startup_invocation(id) || startup_source.install_returned) {
+        return status ? status : -EPERM;
+    }
+    if (!out || !serial || *out || *serial ||
+        !callback_publication_family_known(family)) {
+        return -EINVAL;
+    }
+    status = startup_process_purpose_live();
+    if (!status) {
+        status = qemu_crucible_startup_source_fingerprint_context_identity_v1(id);
+    }
+    if (status) {
+        return status;
+    }
+    qemu_thread_get_self(&thread);
+    qemu_mutex_lock(&commands->mutex);
+    if (callback_child_output_conflicts_locked(out, sizeof(*out)) ||
+        callback_child_output_conflicts_locked(serial, sizeof(*serial)) ||
+        callback_child_output_overlap(out, sizeof(*out), serial, sizeof(*serial))) {
+        status = -EINVAL;
+    } else {
+        status = callback_child_identity_locked(child);
+    }
+    if (!status && (!child->initialized || !child->initialization_returned ||
+                    !child->transferred || !child->bridge->transferred ||
+                    child->initialization_active || child->placement_uncertain ||
+                    child->closing || child->callback_closing || child->destructor_attempted ||
+                    child->physical_returned || publication->held || callbacks->registrar.held ||
+                    startup_source.callback_groups.entered ||
+                    startup_source.callback_groups.borrower.held ||
+                    callbacks->native_preparing || owner->closing)) {
+        status = -EBUSY;
+    }
+    if (!status && (callbacks->publication_serial == UINT64_MAX ||
+                    child->publication_users == UINT64_MAX)) {
+        status = -EOVERFLOW;
+    }
+    if (status) {
+        qemu_mutex_unlock(&commands->mutex);
+        return status;
+    }
+    status = callback_registration_owner_live_locked(owner);
+    if (status) {
+        qemu_mutex_unlock(&commands->mutex);
+        return status;
+    }
+    *publication = (QemuCrucibleCallbackPublicationLoan) {
+        .canonical_owner = publication,
+        .owner = owner,
+        .thread = thread,
+        .serial = ++callbacks->publication_serial,
+        .family = family,
+        .held = true,
+        .current = true,
+    };
+    child->publication_users++;
+    *out = publication;
+    *serial = publication->serial;
+    qemu_mutex_unlock(&commands->mutex);
+
+    status = callback_native_prepare(publication);
+    post = startup_process_purpose_live();
+    qemu_mutex_lock(&commands->mutex);
+    publication->first_status = status;
+    publication->post_status = post;
+    if (status || post) {
+        publication->current = false;
+    }
+    qemu_mutex_unlock(&commands->mutex);
+    if (post) {
+        crucible_metadata_partition_record_post(&startup_source.metadata_partition, post);
+    }
+    return status ? status : post;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_callback_child_publication_current_v1(
+    qemu_plugin_id_t id, QemuCrucibleCallbackPublicationLoan *publication,
+    uint64_t serial, void **address, size_t *bytes, size_t *alignment)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    int status = command_registry_identity(id);
+    int post;
+
+    if (status || !startup_invocation(id) || startup_source.install_returned) {
+        return status ? status : -EPERM;
+    }
+    if (!address || !bytes || !alignment || *address || *bytes || *alignment) {
+        return -EINVAL;
+    }
+    status = startup_process_purpose_live();
+    if (!status) {
+        status = qemu_crucible_startup_source_fingerprint_context_identity_v1(id);
+    }
+    if (status) {
+        qemu_mutex_lock(&commands->mutex);
+        callback_publication_record_refusal_locked(publication, serial, status, 0);
+        qemu_mutex_unlock(&commands->mutex);
+        return status;
+    }
+    qemu_mutex_lock(&commands->mutex);
+    if (callback_child_output_conflicts_locked(address, sizeof(*address)) ||
+        callback_child_output_conflicts_locked(bytes, sizeof(*bytes)) ||
+        callback_child_output_conflicts_locked(alignment, sizeof(*alignment)) ||
+        callback_child_output_overlap(address, sizeof(*address), bytes, sizeof(*bytes)) ||
+        callback_child_output_overlap(address, sizeof(*address), alignment, sizeof(*alignment)) ||
+        callback_child_output_overlap(bytes, sizeof(*bytes), alignment, sizeof(*alignment))) {
+        status = -EINVAL;
+    } else {
+        status = callback_publication_identity_locked(publication, serial);
+    }
+    if (!status && (!publication->current || publication->first_status ||
+                    publication->post_status || publication->owner->closing ||
+                    publication->owner->child->callback_closing ||
+                    publication->owner->child->closing ||
+                    publication->owner->child->destructor_attempted ||
+                    !publication->owner->child->allocated ||
+                    !publication->owner->child->address)) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        /* The real retained publication loan protects this exact typed span
+         * until return. Bare current_v1 and a caller pointer cannot expose it. */
+        *address = publication->owner->child->address;
+        *bytes = publication->owner->child->extent;
+        *alignment = publication->owner->child->alignment;
+    }
+    qemu_mutex_unlock(&commands->mutex);
+    if (status) {
+        return status;
+    }
+    /* The real span and retained loan are already observable on a negative
+     * post. Refusal revokes fresh publication, never this physical custody. */
+    post = startup_process_purpose_live();
+    qemu_mutex_lock(&commands->mutex);
+    callback_publication_record_refusal_locked(publication, serial, 0, post);
+    qemu_mutex_unlock(&commands->mutex);
+    if (post) {
+        crucible_metadata_partition_record_post(&startup_source.metadata_partition, post);
+    }
+    return post;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_callback_child_publication_return_v1(
+    qemu_plugin_id_t id, QemuCrucibleCallbackPublicationLoan **projection,
+    uint64_t serial)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    QemuCrucibleCallbackPublicationRegistry *callbacks = &startup_source.callbacks;
+    QemuCrucibleCallbackPublicationLoan *publication = &callbacks->publication;
+    int status = command_registry_identity(id);
+
+    if (status || !projection || !serial) {
+        return status ? status : -EINVAL;
+    }
+    qemu_mutex_lock(&commands->mutex);
+    if (callback_child_output_conflicts_locked(projection, sizeof(*projection))) {
+        status = -EINVAL;
+    } else {
+        status = callback_publication_identity_locked(publication, serial);
+    }
+    if (!status && (*projection != publication || callbacks->registrar.held ||
+                    !publication->owner->child->publication_users)) {
+        status = -EBUSY;
+    }
+    if (!status) {
+        publication->owner->child->publication_users--;
+        publication->current = false;
+        publication->held = false;
+        publication->canonical_owner = NULL;
+        *projection = NULL;
+    }
+    qemu_mutex_unlock(&commands->mutex);
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_crucible_startup_source_callback_registration_borrow_v1(
+    struct qemu_plugin_ctx *ctx, QemuCrucibleCallbackPublicationFamily family,
+    QemuCrucibleCallbackRegistrationBorrow **out, uint64_t *serial)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    QemuCrucibleCallbackPublicationRegistry *callbacks = &startup_source.callbacks;
+    QemuCrucibleCallbackPublicationLoan *publication = &callbacks->publication;
+    QemuCrucibleCallbackRegistrationBorrow *borrow = &callbacks->registrar;
+    qemu_plugin_id_t id;
+    QemuThread thread;
+    int status = callback_registry_identity(&id);
+    int post;
+
+    if (status || !startup_invocation(id) || startup_source.install_returned || ctx != startup_source.saved.ctx) {
+        return status ? status : -EPERM;
+    }
+    if (!out || !serial || *out || *serial || !callback_publication_family_known(family)) {
+        return -EINVAL;
+    }
+    status = startup_process_purpose_live();
+    if (status) {
+        return status;
+    }
+    qemu_thread_get_self(&thread);
+    qemu_mutex_lock(&commands->mutex);
+    if (callback_child_output_conflicts_locked(out, sizeof(*out)) ||
+        callback_child_output_conflicts_locked(serial, sizeof(*serial)) ||
+        callback_child_output_overlap(out, sizeof(*out), serial, sizeof(*serial))) {
+        status = -EINVAL;
+    } else {
+        status = callback_publication_identity_locked(publication, publication->serial);
+    }
+    if (!status && (!publication->current || publication->first_status || publication->post_status ||
+                    publication->family != family || publication->owner->closing ||
+                    publication->owner->child->callback_closing ||
+                    publication->owner->child->closing || borrow->held)) {
+        status = -EBUSY;
+    }
+    if (!status && (callbacks->registrar_serial == UINT64_MAX ||
+                    publication->owner->child->publication_users == UINT64_MAX)) {
+        status = -EOVERFLOW;
+    }
+    if (status) {
+        qemu_mutex_unlock(&commands->mutex);
+        return status;
+    }
+    *borrow = (QemuCrucibleCallbackRegistrationBorrow) {
+        .canonical_owner = borrow,
+        .publication = publication,
+        .owner = publication->owner,
+        .thread = thread,
+        .publication_serial = publication->serial,
+        .serial = ++callbacks->registrar_serial,
+        .family = family,
+        .held = true,
+    };
+    /* Retain before any registrar effect, even if the later Native post
+     * refuses. Only a genuine child-aware native terminal may settle this
+     * registration lifetime; V2's registry census is insufficient. */
+    publication->owner->child->publication_users++;
+    publication->owner->child->registration_retained = true;
+    *out = borrow;
+    *serial = borrow->serial;
+    qemu_mutex_unlock(&commands->mutex);
+
+    post = startup_process_purpose_live();
+    qemu_mutex_lock(&commands->mutex);
+    if (post) {
+        publication->current = false;
+        if (!publication->post_status) {
+            publication->post_status = post;
+        }
+    }
+    qemu_mutex_unlock(&commands->mutex);
+    if (post) {
+        crucible_metadata_partition_record_post(&startup_source.metadata_partition, post);
+    }
+    return post;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_crucible_startup_source_callback_registration_borrow_id_v1(
+    qemu_plugin_id_t id, QemuCrucibleCallbackPublicationFamily family,
+    QemuCrucibleCallbackRegistrationBorrow **out, uint64_t *serial)
+{
+#ifdef CONFIG_LINUX
+    qemu_plugin_id_t entered_id;
+    int status = callback_registry_identity(&entered_id);
+
+    /* Resolve the context from actual retained Source installation, before
+     * plugin.lock. A supplied id cannot create a publication or another ctx.
+     * Native subsequently compares its real id_to_ctx result under that lock. */
+    if (status || id != entered_id || !startup_invocation(entered_id) ||
+        startup_source.install_returned) {
+        return status ? status : -EPERM;
+    }
+    return qemu_crucible_startup_source_callback_registration_borrow_v1(
+        startup_source.saved.ctx, family, out, serial);
+#else
+    return -ENOTSUP;
+#endif
+}
