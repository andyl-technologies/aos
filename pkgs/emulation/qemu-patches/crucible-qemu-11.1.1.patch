+            g_assert_cmpuint(view.selectable_offset, ==, 39);
+            g_assert_cmpuint(view.selectable_bytes, ==, 5);
+            g_assert_cmpuint(view.workspace_offset, ==, 44);
+            g_assert_cmpuint(view.workspace_bytes, ==, workspace);
