+        char *environment[] = { entry, NULL };
+
+        entry[sizeof(entry) - 2] = '0' + edition;
+        g_assert_cmpint(preexec_setup_selection(environment), ==,
+                        (edition == QEMU_CRUCIBLE_PREEXEC_SETUP_EDITION || edition == 6) ?
