+            startup_source.preexec_purpose_owner, &purpose->observation,
+            &purpose->descriptor_limit);
+    }
+    if (!status && purpose->cancellation_fd >= 0 && purpose->cancellation_fd != fd) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        purpose->cancellation_fd = fd;
+        if (startup_source.command_member.action_enter &&
+            startup_source.action_original.held) {
+            uint64_t sequence = 0;
+
+            /* The nominal Ready subscription already captured this cohort.
+             * Main/Root and inherited physical posts only refuse drift; no
+             * coherent read or operation-clock renewal occurs under BQL. */
+            status = qemu_crucible_preexec_standing_sequence_v1(purpose->lender, &sequence);
+            if (!status && (!sequence || (sequence & 1) ||
+                sequence != startup_source.action_original.publisher_sequence)) {
