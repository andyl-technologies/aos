+    bytes = save_state(&vmstate_cpu_timer, timer);
+    payload = subsection_payload(bytes, "cpu_timer/clock-wide");
+    timer_mod_ps_wide(restored->qtimer, observed_ps + 123);
+    switch (kind) {
+    case 0: remove_subsection(bytes, "cpu_timer/clock-wide"); break;
+    case 1: duplicate_subsection(bytes, "cpu_timer/clock-wide"); break;
+    case 2: bytes->data[payload] = 2; break;
+    case 3: bytes->data[payload + 1] = 2; break;
+    case 4: bytes->data[0] = bytes->data[1] = bytes->data[2] = bytes->data[3] = 0; break;
+    case 5: bytes->data[35] ^= 1; break; /* origin shadow */
+    case 6: bytes->data[43] ^= 1; break; /* deadline shadow */
+    case 7: bytes->data[payload + 1] = 0; break;
+    case 8: bytes->data[payload - 1] = 0; break; /* section version */
+    case 9: bytes->data[7] = 2; break; /* disabled boolean */
+    case 10: bytes->data[19] = 2; break; /* npt boolean */
+    case 11: bytes->data[15] ^= 1; break; /* disabled mask */
+    case 12: bytes->data[27] ^= 1; break; /* npt mask */
+    case 13: bytes->data[7] = 1; break; /* active disabled timer */
+    default: g_assert_not_reached();
