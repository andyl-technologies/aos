+        resources, transaction, runtime, verify_descriptors,
+        descriptor_opaque, plugin_reinitializer, qmp_reinitializer,
+        console_reinitializer);
+}
+
+void qemu_crucible_hot_fork_reset_plugin_child_reinitializer(
+    QemuCrucibleHotForkPluginChildReinitializer *reinitializer)
+{
+    if (reinitializer) {
+        *reinitializer = (QemuCrucibleHotForkPluginChildReinitializer) { 0 };
+    }
+}
+
+/*
+ * Identity a child status must carry regardless of how far its replacement
+ * workers have settled: the plan it was initialized from, exactly.
+ */
+static bool crucible_hot_fork_plugin_child_identity_matches(
+    const QemuCrucibleHotForkPluginChildReinitializer *reinitializer)
+{
+    const struct qemu_plugin_crucible_hot_fork_child_plan *plan =
+        &reinitializer->plan;
+    const QemuPluginCrucibleHotForkChildRuntimeInventory *inventory =
+        &reinitializer->inventory;
+    const struct qemu_plugin_crucible_hot_fork_child_status *status =
+        &inventory->status;
+
+    return inventory->registered && inventory->manifest_consistent &&
+        inventory->generation != 0 && inventory->plugin_id != 0 &&
+        status->schema_version ==
+            QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_STATUS_VERSION &&
+        status->struct_size == sizeof(*status) &&
+        status->parent_process_generation ==
+            plan->parent_process_generation &&
+        status->child_process_generation == plan->child_process_generation &&
+        status->template_generation == plan->template_generation &&
+        status->private_ring_generation == plan->private_ring_generation &&
+        status->plugin_endpoint_generation ==
+            plan->plugin_endpoint_generation &&
+        status->plugin_barrier_generation ==
+            plan->plugin_barrier_generation &&
+        status->control_socket_cookie == plan->control_socket_cookie &&
+        status->wake_eventfd_id == plan->wake_eventfd_id &&
+        status->source_mapping_start == plan->source_mapping_start &&
+        status->source_mapping_length == plan->source_mapping_length &&
+        status->source_mapping_offset == plan->source_mapping_offset &&
+        status->worker_mask == plan->worker_mask &&
+        (status->parked_worker_mask & ~status->worker_mask) == 0;
+}
+
+/*
+ * A held child has every replacement worker parked behind the hold with
+ * nothing pending or in flight.  An active child's workers are live: an
+ * idle worker parks at its receive safe point and a busy one carries an
+ * item, so only the held state constrains those masks.
+ */
+static bool crucible_hot_fork_plugin_child_workers_held(
+    const struct qemu_plugin_crucible_hot_fork_child_status *status)
+{
+    return status->parked_worker_mask == status->worker_mask &&
+        status->pending_worker_mask == 0 &&
+        status->worker_operations_in_flight == 0;
+}
+
+static bool crucible_hot_fork_plugin_child_status_matches(
+    const QemuCrucibleHotForkPluginChildReinitializer *reinitializer,
+    bool active)
+{
+    const struct qemu_plugin_crucible_hot_fork_child_status *status =
+        &reinitializer->inventory.status;
+    const uint32_t expected_flags = active ?
+        QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_MAPPING_INSTALLED |
+            QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_ACTIVE :
+        QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_CALLBACKS_HELD |
+            QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_MAPPING_INSTALLED |
+            QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_WORKERS_READY;
+
+    return crucible_hot_fork_plugin_child_identity_matches(reinitializer) &&
+        status->flags == expected_flags &&
+        status->phase == (active ?
+            QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PHASE_ACTIVE :
+            QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PHASE_WORKERS_HELD) &&
+        (active || crucible_hot_fork_plugin_child_workers_held(status));
+}
+
+/*
+ * A freshly initialized child whose replacement workers have not all
+ * reached their parked safe point yet: the same identity and held phase,
+ * only the readiness flag and a subset of the parked mask outstanding.
+ */
+static bool crucible_hot_fork_plugin_child_workers_settling(
+    const QemuCrucibleHotForkPluginChildReinitializer *reinitializer)
+{
+    const struct qemu_plugin_crucible_hot_fork_child_status *status =
+        &reinitializer->inventory.status;
+
+    return crucible_hot_fork_plugin_child_identity_matches(reinitializer) &&
+        status->flags ==
+            (QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_CALLBACKS_HELD |
+             QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_MAPPING_INSTALLED) &&
+        status->phase ==
+            QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PHASE_WORKERS_HELD &&
+        status->pending_worker_mask == 0 &&
+        status->worker_operations_in_flight == 0;
+}
+
+/* Bound on the replacement workers reaching their parked safe point. */
+#define CRUCIBLE_HOT_FORK_PLUGIN_CHILD_WORKER_SETTLE_US (10 * G_USEC_PER_SEC)
+#define CRUCIBLE_HOT_FORK_PLUGIN_CHILD_WORKER_POLL_US 1000
+
+/*
+ * Written to the child's stderr, which descriptor application has routed to
+ * its branch-private diagnostics stream, when the plugin child status does
+ * not match the plan: the host otherwise sees only EPROTO.
+ */
+static void crucible_hot_fork_plugin_child_report_status(
+    const QemuCrucibleHotForkPluginChildReinitializer *reinitializer,
+    const char *stage, int result)
+{
+    const QemuPluginCrucibleHotForkChildRuntimeInventory *inventory =
+        &reinitializer->inventory;
+    const struct qemu_plugin_crucible_hot_fork_child_status *status =
+        &inventory->status;
+
+    fprintf(stderr,
+            "crucible hot-fork plugin child %s: result %d registered %d "
+            "consistent %d generation %" PRIu64 " plugin %" PRIu64
+            " identity %d schema %u size %u flags 0x%x phase %u "
+            "workers 0x%" PRIx64 " parked 0x%" PRIx64 " pending 0x%" PRIx64
+            " in-flight %" PRIu64 " process %" PRIu64 "/%" PRIu64
+            " plan %" PRIu64 "/%" PRIu64 "\n",
+            stage, result, inventory->registered,
+            inventory->manifest_consistent, inventory->generation,
+            inventory->plugin_id,
+            crucible_hot_fork_plugin_child_identity_matches(reinitializer),
+            status->schema_version, status->struct_size, status->flags,
+            status->phase, status->worker_mask, status->parked_worker_mask,
+            status->pending_worker_mask, status->worker_operations_in_flight,
+            status->parent_process_generation,
+            status->child_process_generation,
+            reinitializer->plan.parent_process_generation,
+            reinitializer->plan.child_process_generation);
+}
+
+int qemu_crucible_hot_fork_reinitialize_plugin_child(void *opaque)
+{
+    QemuCrucibleHotForkPluginChildReinitializer *reinitializer = opaque;
+    gint64 deadline;
+    int result;
+
+    if (!reinitializer || !reinitializer->prepared ||
+        reinitializer->attempted) {
+        return -EPERM;
+    }
+
+    reinitializer->attempted = true;
+    result = qemu_plugin_crucible_hot_fork_child_runtime(
+        QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_INITIALIZE,
+        &reinitializer->plan, &reinitializer->inventory);
+    if (result != 0) {
+        crucible_hot_fork_plugin_child_report_status(
+            reinitializer, "initialization failed", result);
+        return result;
+    }
+
+    /*
+     * Initialization spawns the replacement workers, but each one parks
+     * behind the retained hold from its own thread, so the readiness the
+     * held status requires arrives after the synchronous call returns.
+     * Query until it does, within a bound; anything other than that
+     * settling shape is a protocol failure straight away.
+     */
+    deadline = g_get_monotonic_time() +
+        CRUCIBLE_HOT_FORK_PLUGIN_CHILD_WORKER_SETTLE_US;
+    while (!crucible_hot_fork_plugin_child_status_matches(
+               reinitializer, false)) {
+        if (!crucible_hot_fork_plugin_child_workers_settling(reinitializer)) {
+            crucible_hot_fork_plugin_child_report_status(
+                reinitializer, "status mismatch", -EPROTO);
+            return -EPROTO;
+        }
+        if (g_get_monotonic_time() >= deadline) {
+            crucible_hot_fork_plugin_child_report_status(
+                reinitializer, "workers never settled", -ETIMEDOUT);
+            return -ETIMEDOUT;
+        }
+        g_usleep(CRUCIBLE_HOT_FORK_PLUGIN_CHILD_WORKER_POLL_US);
+        result = qemu_plugin_crucible_hot_fork_child_runtime(
+            QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_QUERY, NULL,
+            &reinitializer->inventory);
+        if (result != 0) {
+            return result;
+        }
+    }
+
+    reinitializer->initialized = true;
+    return 0;
+}
+
+int qemu_crucible_hot_fork_activate_plugin_child(
+    QemuCrucibleHotForkPluginChildReinitializer *reinitializer)
+{
+    QemuPluginCrucibleHotForkChildRuntimeInventory inventory;
+    int result;
+
+    if (!reinitializer || !reinitializer->prepared ||
+        !reinitializer->attempted || !reinitializer->initialized ||
+        reinitializer->activated ||
+        !crucible_hot_fork_plugin_child_status_matches(
+            reinitializer, false)) {
+        return -EPERM;
+    }
+    result = qemu_plugin_crucible_hot_fork_child_runtime(
+        QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_RELEASE, NULL, &inventory);
+    if (result != 0) {
+        crucible_hot_fork_plugin_child_report_status(
+            reinitializer, "release failed", result);
+        return result;
+    }
+    reinitializer->inventory = inventory;
+    if (!crucible_hot_fork_plugin_child_status_matches(
+            reinitializer, true)) {
+        crucible_hot_fork_plugin_child_report_status(
+            reinitializer, "activation status mismatch", -EPROTO);
+        return -EPROTO;
+    }
+    reinitializer->activated = true;
+    return 0;
+}
