+    fixture_issue(&partition);
+    g_assert_cmpint(crucible_metadata_controller_reserve(
+        &partition, fixture_requests, &output), ==, 0);
+    g_assert_cmpuint(output, ==, 152);
+    g_assert_cmpuint(partition.native_extent, ==, 872);
+    g_assert_cmpuint(partition.total, ==,
+        partition.native_extent + partition.controller_extent);
