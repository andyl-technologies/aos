+}
+
+static void test_setup_refusals(void)
+{
+    /* Aggregate boundary material is heap storage, never a stack payload. */
+    uint8_t *wire = g_malloc0(37748765);
+    QemuCrucibleDeviceWorkspaceSetupView view;
+    uint32_t total;
+
+    total = fixture_setup(wire, 3, 5, 128, 128);
+    fixture_record(wire + 44, 1, 0);
+    fixture_startup(wire + 172, 0, 3);
+    assert_setup_refusal(NULL, total);
+    assert_setup_refusal(wire, 35);
+    assert_setup_refusal(wire, total - 1);
+    assert_setup_refusal(wire, total + 1);
+    g_assert_cmpint(qemu_crucible_device_workspace_setup_decode(
+                        wire, total, NULL), <, 0);
+
+    memcpy(wire, "CRUCSUP2", 8);
+    assert_setup_refusal(wire, total);
+    fixture_setup(wire, 3, 5, 128, 128);
+    fixture_be32(wire, 8, 2);
+    assert_setup_refusal(wire, total);
+    fixture_setup(wire, 3, 5, 128, 128);
+    fixture_be32(wire, 12, 32);
+    assert_setup_refusal(wire, total);
+    assert_setup_refusal(wire, 32);
+    fixture_setup(wire, 3, 5, 128, 128);
+    fixture_be32(wire, 12, 28);
+    assert_setup_refusal(wire, total);
+    fixture_setup(wire, 3, 5, 128, 128);
+    fixture_be32(wire, 16, total - 1);
+    assert_setup_refusal(wire, total);
+    fixture_setup(wire, 4, 5, 128, 128);
+    fixture_be32(wire, 16, total);
+    assert_setup_refusal(wire, total);
+
+    total = fixture_setup(wire, 3, 5, 127, 128);
+    assert_setup_refusal(wire, total);
+    total = fixture_setup(wire, 3, 5, 129, 128);
+    assert_setup_refusal(wire, total);
+    total = fixture_setup(wire, 3, 5, 128, 127);
+    assert_setup_refusal(wire, total);
+    total = fixture_setup(wire, 3, 5, 128, 129);
+    assert_setup_refusal(wire, total);
+
+    total = fixture_setup(wire, 3, 5, 128, 128);
+    wire[44] = 'X';
+    assert_setup_refusal(wire, total);
+    fixture_record(wire + 44, 1, 0);
+    wire[172] = 'X';
+    assert_setup_refusal(wire, total);
+    fixture_startup(wire + 172, 0, 3);
+    fixture_be32(wire, 172 + 108, 2);
+    assert_setup_refusal(wire, total);
+
+    fixture_startup(wire + 172, 0, 3);
+    fixture_be64(wire, 172 + 80, FIXTURE_PROCESS + 1);
+    assert_setup_refusal(wire, total);
+    fixture_startup(wire + 172, 0, 3);
+    fixture_be64(wire, 172 + 120, FIXTURE_TOTAL + 1);
+    assert_setup_refusal(wire, total);
+
+    /* Each individual limit witness has a valid independent total equation. */
+    total = fixture_setup(wire, 4194305, 0, 0, 0);
+    assert_setup_refusal(wire, total);
+    total = fixture_setup(wire, 0, 33554433, 0, 0);
+    assert_setup_refusal(wire, total);
+    total = fixture_setup(wire, 4194304, 33554425, 0, 0);
+    g_assert_cmpuint(total, ==, 37748765);
+    assert_setup_refusal(wire, total);
+
+    for (uint32_t workspace = 0; workspace <= 128; workspace += 128) {
+        for (uint32_t startup = 0; startup <= 128; startup += 128) {
+            uint32_t selectable = 33554424 - workspace - startup;
+            uint32_t workspace_offset = 36 + 4194304 + selectable;
+
+            total = fixture_setup(wire, 4194304, selectable, workspace,
+                                  startup);
+            if (workspace) {
+                fixture_record(wire + workspace_offset, 2, 0);
+            }
+            if (startup) {
+                fixture_startup(wire + workspace_offset + workspace, 0, 3);
+            }
+            g_assert_cmpuint(total, ==, 37748764);
+            g_assert_cmpint(qemu_crucible_device_workspace_setup_decode(
+                                wire, total, &view), ==, 0);
+
+            g_assert_cmpuint(view.total_bytes, ==, 37748764);
+            g_assert_cmpuint(view.workspace_offset, ==, workspace_offset);
+            g_assert_cmpuint(view.startup_offset, ==,
+                             workspace_offset + workspace);
+            if (workspace) {
+                assert_record(&view.workspace, 2, 0);
+            }
+            if (startup) {
+                assert_startup(&view.startup, 0, 3);
+            }
+
+            total = fixture_setup(wire, 4194304, selectable + 1, workspace,
+                                  startup);
+            if (workspace) {
+                fixture_record(wire + workspace_offset + 1, 2, 0);
+            }
+            if (startup) {
+                fixture_startup(wire + workspace_offset + workspace + 1,
+                                0, 3);
