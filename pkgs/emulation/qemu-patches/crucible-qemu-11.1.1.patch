+/*
+ * Admit exactly one normal main-loop pass after guest-affecting work has been
+ * published. The main loop may block in synchronous vCPU work during that
+ * pass, so ordinary kick publication wakes this loop to drain the work before
+ * it waits again.
+ */
+static uint64_t rr_crucible_sim_begin_main_loop_handoff(void)
+{
+    g_assert(bql_locked());
+    g_assert(rr_replay_mutex_owned);
+    g_assert(!qatomic_read(&rr_main_loop_dispatch_active));
+
+    qatomic_store_release(&rr_main_loop_dispatch_active, true);
+
+    return qatomic_fetch_inc(&rr_main_loop_dispatch_requested) + 1;
+}
+
+static void rr_crucible_sim_finish_main_loop_handoff(uint64_t generation)
+{
+    g_assert(bql_locked());
+    g_assert(rr_replay_mutex_owned);
+    g_assert(generation != 0);
+
+    while (qatomic_load_acquire(&rr_main_loop_dispatch_completed) <
+           generation) {
+        qemu_event_reset(&rr_dispatch_ceiling_event);
+        if (qatomic_load_acquire(&rr_main_loop_dispatch_completed) >=
+            generation) {
+            break;
+        }
+        /* VM stop waits for this thread to acknowledge CPUState::stop. */
+        if (rr_crucible_sim_stop_or_unplug_pending() ||
+            rr_crucible_sim_vcpu_work_pending()) {
+            rr_crucible_sim_drain_vcpu_work();
+            continue;
+        }
+
+        rr_replay_mutex_unlock();
+        bql_unlock();
+        qemu_event_wait(&rr_dispatch_ceiling_event);
+        rr_replay_mutex_lock();
+        bql_lock();
+    }
+
+    if (!qemu_force_shutdown_requested()) {
+        qatomic_store_release(&rr_main_loop_poll_priming, true);
+    }
+    qatomic_store_release(&rr_main_loop_dispatch_acknowledged, generation);
+    qemu_event_set(&rr_main_loop_resume_event);
+
+    /* Do not let guest execution outrun the main loop's next host poll. */
+    while (qatomic_read(&rr_main_loop_poll_priming)) {
+        qemu_event_reset(&rr_dispatch_ceiling_event);
+        if (!qatomic_read(&rr_main_loop_poll_priming)) {
+            break;
+        }
+        if (rr_crucible_sim_stop_or_unplug_pending()) {
+            rr_crucible_sim_drain_vcpu_work();
+        }
+        if (!runstate_is_running()) {
+            /* A stopped VM cannot advance guest time before the next poll. */
+            break;
+        }
+        bql_unlock();
+        qemu_event_wait(&rr_dispatch_ceiling_event);
+        bql_lock();
+    }
+}
+
+static void rr_crucible_sim_handoff_main_loop(void)
+{
+    uint64_t generation = rr_crucible_sim_begin_main_loop_handoff();
+
+    rr_crucible_sim_finish_main_loop_handoff(generation);
+}
