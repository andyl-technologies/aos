+    stq_be_p(wire + QEMU_CRUCIBLE_PROCESS_PURPOSE_RAM_OWNER_GENERATION_OFFSET, 10);
+    assert_refusal(wire, sizeof(wire), -EINVAL);
+    stq_be_p(wire + QEMU_CRUCIBLE_PROCESS_PURPOSE_RAM_OWNER_GENERATION_OFFSET, 9);
+    for (size_t index = 0; index < G_N_ELEMENTS(nonzero); index++) {
+        uint64_t value = ldq_be_p(wire + nonzero[index]);
+
+        stq_be_p(wire + nonzero[index], 0);
+        assert_refusal(wire, sizeof(wire), -EINVAL);
+        stq_be_p(wire + nonzero[index], value);
+    }
+}
+
+#ifdef CONFIG_LINUX
+static void fixture_startup(uint8_t wire[QEMU_CRUCIBLE_ORIGINAL_STARTUP_WIRE_BYTES])
+{
+    memset(wire, 0, QEMU_CRUCIBLE_ORIGINAL_STARTUP_WIRE_BYTES);
+    memcpy(wire, "CRUCSTP1", 8);
+    stl_be_p(wire + 8, QEMU_CRUCIBLE_ORIGINAL_STARTUP_SCHEMA);
+    stl_be_p(wire + 12, QEMU_CRUCIBLE_ORIGINAL_STARTUP_WIRE_BYTES);
+    wire[STARTUP_CAPABILITY] = 0xa5;
+    stq_be_p(wire + STARTUP_OPERATION, 11); /* Distinct installing original. */
+    stq_be_p(wire + STARTUP_START, 200);
+    stq_be_p(wire + STARTUP_END, 2000);
+    stq_be_p(wire + STARTUP_POLL, 9999);
+    stq_be_p(wire + STARTUP_PROCESS_GENERATION, 9);
+    stq_be_p(wire + STARTUP_CANCELLATION_INODE, 1);
+    stl_be_p(wire + STARTUP_CANCELLATION_DESCRIPTOR, 12);
+    stl_be_p(wire + STARTUP_FLAGS, QEMU_CRUCIBLE_ORIGINAL_STARTUP_FLAGS);
+    stq_be_p(wire + STARTUP_CANCELLATION_EVENT, 1);
+    stq_be_p(wire + STARTUP_TOTAL, 100000);
+}
+
+static void seal_fd(int fd)
+{
+    g_assert_cmpint(fcntl(fd, F_ADD_SEALS, F_SEAL_WRITE | F_SEAL_GROW |
+                          F_SEAL_SHRINK | F_SEAL_SEAL), ==, 0);
+}
+
+static int fixture_fd(uint32_t total, uint32_t app, uint32_t selectable,
+                      bool sealed)
+{
+    uint8_t header[QEMU_CRUCIBLE_PROCESS_PURPOSE_PLAN_HEADER_BYTES] = { 0 };
+    uint8_t startup[QEMU_CRUCIBLE_PROCESS_PURPOSE_PLAN_STARTUP_BYTES];
+    uint8_t purpose[QEMU_CRUCIBLE_PROCESS_PURPOSE_BYTES];
+    uint64_t offset = sizeof(header) + (uint64_t)app + selectable;
+    int fd = memfd_create("purpose-syntax", MFD_CLOEXEC | MFD_ALLOW_SEALING);
+
+    g_assert_cmpint(fd, >=, 0);
+    memcpy(header, QEMU_CRUCIBLE_PROCESS_PURPOSE_PLAN_MAGIC, 8);
+    stl_be_p(header + QEMU_CRUCIBLE_PROCESS_PURPOSE_PLAN_SCHEMA_OFFSET,
+             QEMU_CRUCIBLE_PROCESS_PURPOSE_PLAN_SCHEMA);
+    stl_be_p(header + QEMU_CRUCIBLE_PROCESS_PURPOSE_PLAN_HEADER_LENGTH_OFFSET,
+             sizeof(header));
+    stl_be_p(header + QEMU_CRUCIBLE_PROCESS_PURPOSE_PLAN_TOTAL_OFFSET, total);
+    stl_be_p(header + QEMU_CRUCIBLE_PROCESS_PURPOSE_PLAN_APP_LENGTH_OFFSET, app);
+    stl_be_p(header + QEMU_CRUCIBLE_PROCESS_PURPOSE_PLAN_SELECTABLE_LENGTH_OFFSET,
+             selectable);
+    stl_be_p(header + QEMU_CRUCIBLE_PROCESS_PURPOSE_PLAN_STARTUP_LENGTH_OFFSET,
+             sizeof(startup));
+    stl_be_p(header + QEMU_CRUCIBLE_PROCESS_PURPOSE_PLAN_PURPOSE_LENGTH_OFFSET,
+             sizeof(purpose));
+    fixture_startup(startup);
+    fixture_purpose(purpose);
+    g_assert_cmpint(ftruncate(fd, total), ==, 0);
+    g_assert_cmpint(pwrite(fd, header, sizeof(header), 0), ==, sizeof(header));
+    g_assert_cmpint(pwrite(fd, startup, sizeof(startup), offset), ==,
+                      sizeof(startup));
+    g_assert_cmpint(pwrite(fd, purpose, sizeof(purpose), offset + sizeof(startup)),
+                      ==, sizeof(purpose));
+    if (sealed) {
+        seal_fd(fd);
+    }
+    return fd;
+}
+
+static void assert_fd_refusal(int fd, int expected)
+{
+    QemuCrucibleProcessPurposePlan out;
+    uint8_t before[sizeof(out)];
+    int flags = fcntl(fd, F_GETFL);
+    off_t position = lseek(fd, 0, SEEK_CUR);
+
+    memset(&out, 0x6b, sizeof(out));
+    memcpy(before, &out, sizeof(before));
+    g_assert_cmpint(qemu_crucible_process_purpose_plan_read_fd_v3(fd, &out), ==,
+                      expected);
+    g_assert_cmpmem(&out, sizeof(out), before, sizeof(before));
+    g_assert_cmpint(fcntl(fd, F_GETFD), >=, 0);
+    g_assert_cmpint(fcntl(fd, F_GETFL), ==, flags);
+    g_assert_cmpint(lseek(fd, 0, SEEK_CUR), ==, position);
+}
+
+static void test_descriptor(void)
+{
+    QemuCrucibleProcessPurposePlan out;
+    int fd = fixture_fd(PLAN_FIXED_BYTES, 0, 0, true);
+    int flags = fcntl(fd, F_GETFL);
+
+    g_assert_cmpint(lseek(fd, 7, SEEK_SET), ==, 7);
+    g_assert_cmpint(qemu_crucible_process_purpose_plan_read_fd_v3(fd, &out), ==, 0);
+    g_assert_cmpuint(out.startup_offset, ==,
+                     QEMU_CRUCIBLE_PROCESS_PURPOSE_PLAN_HEADER_BYTES);
+    g_assert_cmpuint(out.purpose_offset, ==,
+                     QEMU_CRUCIBLE_PROCESS_PURPOSE_PLAN_HEADER_BYTES +
+                     QEMU_CRUCIBLE_PROCESS_PURPOSE_PLAN_STARTUP_BYTES);
+    g_assert_cmpuint(out.startup.operation_id, ==, 11);
+    g_assert_cmpuint(out.purpose.containing_operation, ==, UINT64_MAX);
+    g_assert_cmpuint(out.workspace_bytes, ==, 0);
+    g_assert_cmpint(fcntl(fd, F_GETFL), ==, flags);
+    g_assert_cmpint(lseek(fd, 0, SEEK_CUR), ==, 7);
+    g_assert_cmpint(close(fd), ==, 0);
+
+    fd = fixture_fd(PLAN_FIXED_BYTES, 0, 0, false);
+    assert_fd_refusal(fd, -EPERM);
+    g_assert_cmpint(close(fd), ==, 0);
+}
+
+static void test_nested_refusals(void)
+{
+    static const size_t startup_offsets[] = {
+        STARTUP_CAPABILITY, STARTUP_PROCESS_GENERATION, STARTUP_TOTAL,
+    };
+    uint8_t value[8];
+    int fd;
+
+    for (size_t index = 0; index < G_N_ELEMENTS(startup_offsets); index++) {
+        fd = fixture_fd(PLAN_FIXED_BYTES, 0, 0, false);
+        stq_be_p(value, 17);
+        g_assert_cmpint(pwrite(fd, value, sizeof(value),
+                              QEMU_CRUCIBLE_PROCESS_PURPOSE_PLAN_HEADER_BYTES +
+                              startup_offsets[index]), ==, sizeof(value));
+        seal_fd(fd);
+        assert_fd_refusal(fd, -ESTALE);
+        g_assert_cmpint(close(fd), ==, 0);
+    }
+    fd = fixture_fd(PLAN_FIXED_BYTES, 0, 0, false);
+    stl_be_p(value, QEMU_CRUCIBLE_PROCESS_PURPOSE_BYTES - 1);
+    g_assert_cmpint(pwrite(fd, value, 4,
+                          QEMU_CRUCIBLE_PROCESS_PURPOSE_PLAN_PURPOSE_LENGTH_OFFSET),
+                      ==, 4);
+    seal_fd(fd);
+    assert_fd_refusal(fd, -EINVAL);
+    g_assert_cmpint(close(fd), ==, 0);
+
+    fd = fixture_fd(PLAN_FIXED_BYTES, 0, 0, false);
+    g_assert_cmpint(ftruncate(fd, PLAN_FIXED_BYTES - 1), ==, 0);
+    seal_fd(fd);
+    assert_fd_refusal(fd, -EINVAL);
+    g_assert_cmpint(close(fd), ==, 0);
+
+    fd = fixture_fd(PLAN_FIXED_BYTES + 1, 0, 0, true);
+    assert_fd_refusal(fd, -EINVAL);
+    g_assert_cmpint(close(fd), ==, 0);
+}
+
+static void fixture_subscription(uint8_t wire[224])
+{
+    memset(wire, 0, 224);
+    memcpy(wire, "CRUCPSP1", 8);
+    stl_be_p(wire + 8, 1);
+    stl_be_p(wire + 12, 224);
+    stq_be_p(wire + 16, 3);
+    stq_be_p(wire + 24, 7);
+    stq_be_p(wire + 32, 9);
+    wire[40] = 0xa5;
+    wire[72] = 1;
+    stq_be_p(wire + 120, 4096);
+    stq_be_p(wire + 128, 11);
+    stq_be_p(wire + 136, 13);
+    stq_be_p(wire + 144, 65536);
+    stq_be_p(wire + 152, 1);
+    stq_be_p(wire + 160, 65536);
+    stq_be_p(wire + 168, 3);
+    stq_be_p(wire + 176, 4096);
+    stq_be_p(wire + 184, 1);
+}
+
+static int fixture_plan9(const uint8_t subscription[224], unsigned changed)
+{
+    uint8_t header[48] = { 0 };
+    uint8_t startup[128];
+    uint8_t purpose[2520];
+    const uint32_t total = 48 + 128 + 2520 + 224;
+    int fd = memfd_create("plan9-canonical-bytes", MFD_CLOEXEC | MFD_ALLOW_SEALING);
+
+    g_assert_cmpint(fd, >=, 0);
+    memcpy(header, "CRUCSUP9", 8);
+    stl_be_p(header + 8, 9);
+    stl_be_p(header + 12, 48);
+    stl_be_p(header + 16, total);
+    stl_be_p(header + 32, 128);
+    stl_be_p(header + 36, 2520);
+    stl_be_p(header + 40, 224);
+    if (changed) {
+        header[changed] ^= 1;
+    }
+    fixture_startup(startup);
+    fixture_purpose(purpose);
+    g_assert_cmpint(ftruncate(fd, total), ==, 0);
+    g_assert_cmpint(pwrite(fd, header, 48, 0), ==, 48);
+    g_assert_cmpint(pwrite(fd, startup, 128, 48), ==, 128);
+    g_assert_cmpint(pwrite(fd, purpose, 2520, 176), ==, 2520);
+    g_assert_cmpint(pwrite(fd, subscription, 224, 2696), ==, 224);
+    seal_fd(fd);
+    return fd;
+}
+
+static void test_subscription_plan(void)
+{
+    uint8_t wire[224];
+    QemuCruciblePublisherPurpose record;
+    QemuCrucibleProcessPurposePlan out;
+    int fd;
+
+    fixture_subscription(wire);
+    g_assert_cmpint(qemu_crucible_publisher_purpose_decode_v1(wire, 224, &record), ==, 0);
+    g_assert_cmpuint(record.backing_bytes, ==, 65536);
+    fd = fixture_plan9(wire, 0);
+    g_assert_cmpint(qemu_crucible_process_purpose_plan_read_fd_v3(fd, &out), ==, 0);
+    g_assert_cmpuint(out.schema, ==, 9);
+    g_assert_cmpuint(out.startup_offset, ==, 48);
+    g_assert_cmpuint(out.subscription_offset, ==, 2696);
+    g_assert_cmpuint(out.subscription_bytes, ==, 224);
+    g_assert_cmpuint(out.subscription.cleanup_generation, ==, 1);
+    g_assert_cmpint(close(fd), ==, 0);
+
+    for (unsigned byte = 192; byte < 224; byte++) {
+        QemuCruciblePublisherPurpose before;
+
+        fixture_subscription(wire);
+        wire[byte] = 1;
+        memset(&record, 0x7b, sizeof(record));
+        before = record;
+        g_assert_cmpint(qemu_crucible_publisher_purpose_decode_v1(wire, 224, &record), ==, -EINVAL);
+        g_assert_cmpmem(&record, sizeof(record), &before, sizeof(before));
+    }
+    const unsigned invalid_fields[] = { 16, 24, 32, 120, 128, 136, 144, 152, 160, 168, 176, 184 };
+    for (size_t index = 0; index < G_N_ELEMENTS(invalid_fields); index++) {
+        fixture_subscription(wire);
+        stq_be_p(wire + invalid_fields[index], 0);
+        g_assert_cmpint(qemu_crucible_publisher_purpose_decode_v1(wire, 224, &record), ==, -EINVAL);
+    }
+    fixture_subscription(wire);
+    stq_be_p(wire + 136, 11);
+    g_assert_cmpint(qemu_crucible_publisher_purpose_decode_v1(wire, 224, &record), ==, -EINVAL);
+    const unsigned binding_offsets[] = { 24, 32, 40, 72 };
+    for (size_t index = 0; index < G_N_ELEMENTS(binding_offsets); index++) {
+        fixture_subscription(wire);
+        wire[binding_offsets[index]] ^= 2;
+        fd = fixture_plan9(wire, 0);
+        assert_fd_refusal(fd, -ESTALE);
+        g_assert_cmpint(close(fd), ==, 0);
+    }
+    fixture_subscription(wire);
+    fd = fixture_plan9(wire, 44);
+    assert_fd_refusal(fd, -EINVAL);
+    g_assert_cmpint(close(fd), ==, 0);
+}
+
+static void test_plan_versions(void)
+{
+    uint8_t magic[8];
+    uint8_t schema[4];
+
+    for (unsigned version = 1; version < QEMU_CRUCIBLE_PROCESS_PURPOSE_PLAN_SCHEMA;
+         version++) {
+        int fd = fixture_fd(PLAN_FIXED_BYTES, 0, 0, false);
+
+        memcpy(magic, QEMU_CRUCIBLE_PROCESS_PURPOSE_PLAN_MAGIC, sizeof(magic));
+        magic[7] = '0' + version;
+        stl_be_p(schema, version);
+        g_assert_cmpint(pwrite(fd, magic, sizeof(magic), 0), ==, sizeof(magic));
+        g_assert_cmpint(pwrite(fd, schema, sizeof(schema),
+                              QEMU_CRUCIBLE_PROCESS_PURPOSE_PLAN_SCHEMA_OFFSET),
+                          ==, sizeof(schema));
+        seal_fd(fd);
+        assert_fd_refusal(fd, -EPROTONOSUPPORT);
+        g_assert_cmpint(close(fd), ==, 0);
+    }
+}
+
+static void test_aggregate(void)
+{
+    QemuCrucibleProcessPurposePlan out;
+    uint32_t maximum = QEMU_CRUCIBLE_PROCESS_PURPOSE_PLAN_TOTAL_MAX;
+    uint32_t selectable = QEMU_CRUCIBLE_PROCESS_PURPOSE_PLAN_SELECTABLE_MAX;
+    uint32_t app = maximum - selectable - PLAN_FIXED_BYTES;
+    int fd = fixture_fd(maximum, app, selectable, true);
+
+    g_assert_cmpint(qemu_crucible_process_purpose_plan_read_fd_v3(fd, &out), ==, 0);
+    g_assert_cmpuint(out.total_bytes, ==, maximum);
+    g_assert_cmpuint(out.selectable_bytes, ==, selectable);
+    g_assert_cmpuint(out.app_bytes, ==, app);
+    g_assert_cmpint(close(fd), ==, 0);
+
+    fd = fixture_fd(maximum + 1, app + 1, selectable, true);
+    assert_fd_refusal(fd, -EINVAL);
+    g_assert_cmpint(close(fd), ==, 0);
+    app = QEMU_CRUCIBLE_PROCESS_PURPOSE_PLAN_APP_MAX + 1;
+    fd = fixture_fd(PLAN_FIXED_BYTES + app, app, 0, true);
+    assert_fd_refusal(fd, -EINVAL);
+    g_assert_cmpint(close(fd), ==, 0);
+    selectable++;
+    fd = fixture_fd(PLAN_FIXED_BYTES + selectable, 0, selectable, true);
+    assert_fd_refusal(fd, -EINVAL);
+    g_assert_cmpint(close(fd), ==, 0);
+}
+
+#endif
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/purpose/fields", test_fields);
+    g_test_add_func("/purpose/framing", test_framing);
+    g_test_add_func("/purpose/domains", test_domains);
+    g_test_add_func("/purpose/rows", test_rows);
+    g_test_add_func("/purpose/conservation", test_conservation);
+    g_test_add_func("/purpose/family", test_family);
+    g_test_add_func("/purpose/standing", test_standing);
+    g_test_add_func("/purpose/standing-retention-edition",
+                    test_standing_retention_edition);
+    g_test_add_func("/purpose/ram", test_ram);
+#ifdef CONFIG_LINUX
+    g_test_add_func("/purpose/descriptor", test_descriptor);
+    g_test_add_func("/purpose/aggregate", test_aggregate);
+    g_test_add_func("/purpose/plan-versions", test_plan_versions);
+    g_test_add_func("/purpose/subscription-plan", test_subscription_plan);
+    g_test_add_func("/purpose/nested-refusals", test_nested_refusals);
+#endif
+    return g_test_run();
+}
