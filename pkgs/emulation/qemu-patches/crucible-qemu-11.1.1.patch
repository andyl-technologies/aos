+    if (!candidate || !journal_monitor || !first_status || !post_status ||
+        !qemu_in_main_thread() ||
+        !bql_locked() || qemu_in_coroutine()) {
+        return -EPERM;
+    }
+    if (*journal_monitor) {
+        /* This handle was emitted by this actual return before its payload
+         * free. The reservation's existing Monitor ref remains in the journal.
+         */
+        mon = MONITOR_QMP(*journal_monitor);
+        if (!mon->crucible_stop_returning) {
+            return -ESTALE;
+        }
+    } else {
+        reservation = *candidate;
+        status = qemu_crucible_qmp_allocation_current(NULL, reservation);
+        if (status) {
