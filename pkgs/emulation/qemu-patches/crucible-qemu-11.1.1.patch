+        *shlex.split(os.environ["CC"]),
+        *shlex.split(os.environ.get("CFLAGS", "")),
+        "-std=gnu11", "-Wall", "-Werror", str(fixture), str(ROOT / "util/error.c"),
+        str(ROOT / "util/crucible-descriptor-table.c"),
+        str(ROOT / "stubs/crucible-qmp-allocation.c"),
+        "-o", str(binary), *shlex.split(os.environ.get("LDFLAGS", "")),
+    ]
+    (args.output_dir / "compile-command.json").write_text(json.dumps(command, indent=2) + "\n")
