+QemuCrucibleNativeInvocationTicket qemu_plugin_crucible_native_enter_v1(
+    struct qemu_plugin_ctx *ctx, const void *coordinate, void *function,
+    void *userdata, enum QemuCrucibleNativeInvocationKind kind)
+{
+    QemuCrucibleNativeInvocationTicket ticket = { 0 };
+    QemuCrucibleNativeInvocationRegistry *registry = native_dispatch_hint();
+    QemuCrucibleNativeRegistration *record = NULL;
+    QemuCrucibleNativeInvocation *parent, *frame = NULL;
+    QemuThread thread;
+    pid_t process;
+    bool selected;
+    size_t i;
+
+    if (!registry) {
+        return ticket;
+    }
+    /* The hint is never a lifetime or admission proof. A selected callback
+     * still enters the native mutex; an ordinary callback does so only when
+     * an active selected frame may need same-thread suppression. */
+    if (ctx && ctx != registry->ctx &&
+        !qatomic_load_acquire(&registry->active_frame_hint)) {
+        return ticket;
+    }
+    process = getpid();
+    if (!registry_process_current(registry, process)) {
+        return ticket;
+    }
+    qemu_thread_get_self(&thread);
+    qemu_mutex_lock(&registry->mutex);
+    if (!registry_identity_locked(registry, process)) {
+        qemu_mutex_unlock(&registry->mutex);
+        return ticket;
+    }
+
+    parent = top_locked(registry);
+    if (kind != QEMU_CRUCIBLE_NATIVE_UNQUALIFIED &&
+        kind != QEMU_CRUCIBLE_NATIVE_VCPU_INIT &&
+        kind != QEMU_CRUCIBLE_NATIVE_MAIN_CONTROL &&
+        native_selection() == registry && registry_current_locked(registry, process)) {
+        record = registration_locked(registry, coordinate, function, userdata, kind);
+    }
+    /* Context and callback arguments corroborate the retained descriptor;
+     * neither a matching module nor a tuple admits an unowned callback. */
+    selected = record && (!ctx || ctx == record->ctx) &&
+        record->child_owner == registry->child_owner;
+
+    if (selected && registry->serial != UINT64_MAX) {
+        for (i = 0; i < ARRAY_SIZE(registry->frames); i++) {
+            if (!registry->frames[i].canonical_owner) {
+                frame = &registry->frames[i];
+                break;
+            }
+        }
+    }
+    if (!frame) {
+        /* A failed nested entry cannot expose its parent's identity. The
+         * finite slot pool and non-wrapping serial never authorize fallback. */
+        if (parent) {
+            assert(parent->suppressed_children < UINT_MAX);
+            parent->suppressed_children++;
+            ticket = (QemuCrucibleNativeInvocationTicket) {
+                .registry = registry,
+                .frame = parent,
+                .serial = parent->serial,
+                .suppressed = true,
+            };
+        }
+        qemu_mutex_unlock(&registry->mutex);
+        return ticket;
+    }
+
+    *frame = (QemuCrucibleNativeInvocation) {
+        .owner = registry,
+        .canonical_owner = frame,
+        .registration = record,
+        .child_owner = record->child_owner,
+        .coordinate = record ? record->coordinate : coordinate,
+        .function = function,
+        .userdata = userdata,
+        .ctx = registry->ctx,
+        .module = registry->module,
+        .runtime = registry->runtime,
+        .storage = registry->storage,
+        .storage_holder = registry->storage_holder,
+        .thread = thread,
+        .process = process,
+        .process_generation = registry->process_generation,
+        .account_generation = registry->account_generation,
+        .serial = ++registry->serial,
+        .kind = kind,
+        .live = true,
+    };
+    if (record) {
+        record->references++;
+    }
+    ticket.frame = frame;
+    ticket.registry = registry;
+    ticket.serial = frame->serial;
+    qatomic_store_release(&registry->active_frame_hint,
+                         qatomic_read(&registry->active_frame_hint) + 1);
+    qemu_mutex_unlock(&registry->mutex);
+    return ticket;
+}
+
+static int frame_identity_locked(QemuCrucibleNativeInvocationRegistry *registry,
+                                 QemuCrucibleNativeInvocation *frame,
+                                 uint64_t serial, pid_t process)
+{
+    if (!registry_identity_locked(registry, process) ||
+        !frame_member_locked(registry, frame)) {
+        return -EPERM;
+    }
+    if (!serial || frame->canonical_owner != frame ||
+        frame->owner != registry || frame->serial != serial ||
+        frame->process != process || !qemu_thread_is_self(&frame->thread) ||
+        frame->ctx != registry->ctx || frame->module != registry->module ||
+        frame->runtime != registry->runtime || frame->storage != registry->storage ||
+        frame->storage_holder != registry->storage_holder ||
+        frame->process_generation != registry->process_generation ||
+        frame->account_generation != registry->account_generation) {
+        return -ESTALE;
+    }
+    return 0;
+}
+
+/* The fixed slot and descriptor remain retained until the actual Object pin
+ * return completes, including any QOM finalizers run by object_unref. */
+static void frame_cpu_pin_return(QemuCrucibleNativeInvocationTicket ticket,
+                                 CPUState *cpu)
+{
+    QemuCrucibleNativeInvocationRegistry *registry = ticket.registry;
+    QemuCrucibleNativeInvocation *frame = ticket.frame;
+
+    object_unref(OBJECT(cpu));
+    qemu_mutex_lock(&registry->mutex);
+    assert(!frame_identity_locked(registry, frame, ticket.serial, getpid()));
+    assert(frame->cpu_return_in_flight && frame->cpu == cpu);
+    frame->cpu = NULL;
+    frame->cpu_return_in_flight = false;
+    frame_reclaim_locked(frame);
+    qemu_mutex_unlock(&registry->mutex);
+}
