+static int crucible_ram_physical_device_visit(
+    DeviceState *device, CrucibleRamPhysicalDeviceInventory *inventory)
+{
+    Object *object = OBJECT(device);
+    DeviceClass *device_class;
+    int result;
+
+    if (!device->realized) {
+        return -ESTALE;
+    }
+    if (inventory->count == UINT64_MAX) {
+        return -EOVERFLOW;
+    }
+    inventory->count++;
+    if (device->mem_reentrancy_guard.engaged_in_io) {
+        error_setg(inventory->errp, "RAM physical owner '%s' is executing I/O",
+                   object_get_typename(object));
+        return -EBUSY;
+    }
+
+    /* The common TCG executor owns CPU RAM accesses. Its complete vCPU thread
+     * and pause receipt is checked by the retained owner coordinator, rather
+     * than inferred from an architecture's model name or VMState schema. */
+    if (object_dynamic_cast(object, TYPE_CPU)) {
+        return 0;
+    }
+    device_class = DEVICE_GET_CLASS(device);
+    if (device_class->crucible_ram_physical_owner != device_class) {
+        error_setg(inventory->errp, "RAM physical owner '%s' has no audited "
+                   "native access capability", object_get_typename(object));
+        return -ENOTSUP;
+    }
+    if (!device_class->crucible_ram_physical_check) {
+        return 0;
+    }
+    result = device_class->crucible_ram_physical_check(device, inventory->errp);
+    if (result != 0 && inventory->errp && !*inventory->errp) {
+        error_setg(inventory->errp, "RAM physical owner '%s' is not closed",
+                   object_get_typename(object));
+    }
+    return result;
