+int qemu_crucible_startup_source_cpu_instance_identity_v1(
+    Object *instance, QemuCrucibleCpuSourceAllocationOwner **out,
+    QemuCrucibleCpuAllocationReceipt **receipt, uint64_t *generation)
+{
+    QemuCrucibleCpuSourceAllocationOwner *owner;
+    int status;
+
+    if (!instance || !out || *out || !receipt || *receipt || !generation ||
+        *generation) {
+        return -EINVAL;
+    }
+    /* Reject inherited Source before its potentially inherited mutex. */
+    if (getpid() != startup_source.owner_process) {
+        return -EPERM;
+    }
+    status = pthread_mutex_trylock(&startup_source.cpu_allocations.lock);
+    if (status) {
+        return -status;
+    }
+    for (owner = startup_source.cpu_allocations.owners; owner;
+         owner = owner->next) {
+        if (owner->payload == instance) {
+            break;
+        }
+    }
+    status = owner ? cpu_allocation_identity_locked(owner) : -ENOENT;
+    if (!status) {
+        status = object_native_allocation_live_instance_current(instance, owner,
+            owner->receipt, owner->request_serial);
+    }
+    if (!status) {
+        *out = owner;
+        *receipt = owner->receipt;
+        *generation = owner->request_serial;
+    }
+    pthread_mutex_unlock(&startup_source.cpu_allocations.lock);
+    return status;
+}
