+    assert(inventory().generation == 3 && qemu_crucible_ram_paging_request() == -EBUSY);
+    crucible_ram_cache_borrow_change(true, false);
+    assert(inventory().consistent && inventory().caches == 0);
+    puts("PASS real fork retains startup refusal and independent child memberships");
+}
