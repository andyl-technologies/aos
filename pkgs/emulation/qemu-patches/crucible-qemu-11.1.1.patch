+int qemu_crucible_clock_callback_frame_current_v1(
+    QemuCrucibleTimerCallbackFrame *frame, void *source,
+    void (*callback)(void *), void *opaque, bool returned)
+{
+    if (!frame || crucible_clock_registry.callback_frame != frame ||
+        !bql_locked() || frame->process != getpid() ||
+        !qemu_thread_is_self(&frame->thread) || !frame->serial || frame->timer ||
+        frame->source != source || frame->callback != callback ||
+        frame->opaque != opaque || frame->returned != returned ||
+        frame->entered != returned) {
+        return -EPERM;
+    }
+    return 0;
+}
