+        memcmp(old_binding->source_reservation, binding->source_reservation, 32) ||
+        old_binding->account_incarnation != binding->account_incarnation ||
+        old_binding->process_incarnation != binding->process_incarnation ||
+        old_binding->request_correlation != binding->request_correlation ||
+        old_binding->command_frontier != binding->command_frontier ||
+        previous->primary_count != current->primary_count ||
+        previous->planned_count != current->planned_count ||
+        (previous->born_mask & ~current->born_mask) ||
+        (previous->projected_mask & ~current->projected_mask)) {
+        return -ESTALE;
+    }
+    /* Compare every distinct projected row. Equal underlying identities do
+     * not collapse two actual borrower memberships or their custody bits. */
+    for (size_t index = 0; index < current->planned_count; index++) {
+        const QemuCrucibleProducingActionRow *old_row = &previous->rows[index];
+        const QemuCrucibleProducingActionRow *row = &current->rows[index];
+        uint32_t bit = UINT32_C(1) << index;
+
+        if (!(previous->projected_mask & current->projected_mask & bit)) {
+            continue;
+        }
+        if (memcmp(old_row->lender_capability, row->lender_capability, 32) ||
+            old_row->budget_owner != row->budget_owner ||
+            old_row->operation != row->operation ||
+            old_row->producing_class != row->producing_class ||
+            old_row->original_origin_ns != row->original_origin_ns ||
+            old_row->original_start_ns != row->original_start_ns ||
+            old_row->preparation_row_plus_one != row->preparation_row_plus_one ||
+            old_row->role != row->role ||
+            old_row->immutable_entry_revision != row->immutable_entry_revision ||
+            row->policy_revision < old_row->policy_revision ||
+            row->outer_revision < old_row->outer_revision ||
+            row->genuine_progress_ns < old_row->genuine_progress_ns ||
+            row->completed_required_units < old_row->completed_required_units ||
+            (old_row->state && row->state != old_row->state)) {
+            return -ESTALE;
+        }
+    }
+    return 0;
+}
