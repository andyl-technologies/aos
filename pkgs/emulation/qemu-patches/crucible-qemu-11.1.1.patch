+/* Linux's actual socketpair peer credentials identify the retained preexec
+ * sender process. A matching peer/parent is physical session corroboration;
+ * it never replaces genuine issued material or its artifact/contract checks.
+ */
+static int preexec_setup_peer(void)
+{
+    struct {
+        int process;
+        uint32_t user;
+        uint32_t group;
+    } credentials;
+    socklen_t length = sizeof(credentials);
+    QemuCruciblePreexecSetupOwner *owner = &preexec_setup_owner;
+    long status;
+
+    owner->parent_process = preexec_setup_syscall5(SYS_getppid, 0, 0, 0, 0, 0);
+    status = preexec_setup_syscall5(
+        SYS_getsockopt, QEMU_CRUCIBLE_PREEXEC_SETUP_CONTROL_FD, SOL_SOCKET,
+        SO_PEERCRED, (long)(uintptr_t)&credentials, (long)(uintptr_t)&length);
+    if (status < 0) {
+        return (int)status;
+    }
+    if (length != sizeof(credentials)) {
+        return -EPROTO;
+    }
+    owner->peer_process = credentials.process;
+    owner->peer_user = credentials.user;
+    owner->peer_group = credentials.group;
+    if (owner->parent_process <= 1 ||
+        owner->peer_process != owner->parent_process) {
+        return -EPERM;
+    }
+    status = preexec_setup_syscall5(SYS_fstat,
+        QEMU_CRUCIBLE_PREEXEC_SETUP_CONTROL_FD,
+        (long)(uintptr_t)&owner->control_identity, 0, 0, 0);
+    if (status < 0) {
+        return (int)status;
+    }
+    if (!S_ISSOCK(owner->control_identity.st_mode)) {
+        return -EPROTOTYPE;
+    }
+    owner->peer_validated = true;
+    return 0;
+}
