+    g_assert_null(err);
+    g_assert_true(child_file_prepared_matches(&entry, &err));
+    g_assert_null(err);
+    g_assert_cmpint(fcntl(entry.prepared_fd, F_GETFL), ==,
+                    entry.source.flags & ~O_NOFOLLOW);
+    g_assert_cmpint(fcntl(entry.prepared_fd, F_GETFD) & FD_CLOEXEC, ==, FD_CLOEXEC);
