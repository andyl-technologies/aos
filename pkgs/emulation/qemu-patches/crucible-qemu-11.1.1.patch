+              "#define qatomic_load_acquire(state) settle_load(state)\n" + settle +
+              "\n#undef qatomic_load_acquire\n"
+              "#define qatomic_load_acquire(state) __atomic_load_n(state, __ATOMIC_ACQUIRE)")
