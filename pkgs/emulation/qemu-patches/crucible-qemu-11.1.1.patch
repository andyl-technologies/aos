+
+int qemu_plugin_crucible_ram_lifecycle(
+    uint32_t operation, uint64_t source_generation)
+{
+    qemu_plugin_crucible_ram_lifecycle_cb_t cb =
+        qatomic_load_acquire(&qemu_plugin_crucible_ram_lifecycle_cb);
+    int result;
+
+    if (source_generation == 0 ||
+        operation < QEMU_PLUGIN_CRUCIBLE_RAM_PREPARE_FORK ||
+        operation > QEMU_PLUGIN_CRUCIBLE_RAM_ABORT_FORK) {
+        return -EINVAL;
+    }
+    if (!cb) {
+        return -ENOTSUP;
+    }
+    if (operation != QEMU_PLUGIN_CRUCIBLE_RAM_RESUME_PARENT &&
+        operation != QEMU_PLUGIN_CRUCIBLE_RAM_ABORT_FORK) {
+        result = qemu_crucible_ram_diagnostic_failure();
+        if (result) {
+            return result;
+        }
+    }
+    /* Resume/abort reopen owned trackers, never the guest CPU. The separate
+     * pre-resume gate retains containment after those cleanup callbacks. */
+    if (operation == QEMU_PLUGIN_CRUCIBLE_RAM_PREPARE_FORK) {
+        if (!bql_locked() || !runstate_check(RUN_STATE_PAUSED) ||
+            !qemu_plugin_crucible_vmstop_quiesced()) {
+            return -EPERM;
+        }
+        /* This scope authorizes observation within an already proven native
+         * pause; it does not create a new guest pause or writer barrier. */
+        qemu_plugin_crucible_exact_boundary_enter();
+        QemuCrucibleNativeInvocationTicket native =
+            qemu_plugin_crucible_native_mask_v1(
+                &cb, cb, qemu_plugin_crucible_ram_lifecycle_userdata);
+
+        result = cb(operation, source_generation,
+                    qemu_plugin_crucible_ram_lifecycle_userdata);
+        qemu_plugin_crucible_native_exit_v1(native);
+        qemu_plugin_crucible_exact_boundary_leave();
+        if (result == 0) {
+            qatomic_store_release(&qemu_plugin_crucible_ram_lifecycle_is_frozen,
+                                  true);
+        }
+        return result;
+    }
+    /* FINAL_SEAL and early child rebinding cannot enter the frozen registry. */
+    QemuCrucibleNativeInvocationTicket native =
+        qemu_plugin_crucible_native_mask_v1(
+            &cb, cb, qemu_plugin_crucible_ram_lifecycle_userdata);
+
+    result = cb(operation, source_generation,
+                qemu_plugin_crucible_ram_lifecycle_userdata);
+    qemu_plugin_crucible_native_exit_v1(native);
+    if (result == 0 && operation != QEMU_PLUGIN_CRUCIBLE_RAM_FINAL_SEAL) {
+        qatomic_store_release(&qemu_plugin_crucible_ram_lifecycle_is_frozen,
+                              false);
+    }
+    return result;
+}
+
+bool qemu_plugin_crucible_ram_lifecycle_frozen(void)
+{
+    return qatomic_load_acquire(&qemu_plugin_crucible_ram_lifecycle_is_frozen);
+}
