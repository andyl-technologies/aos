+
+    startup_source.publisher_module.runtime_holder = &fields[0];
+    assert(callback_child_output_conflicts_locked(&fields[0], sizeof(fields[0])));
+    assert(!callback_child_output_conflicts_locked(&fields[1], sizeof(fields[1])));
+    startup_source.publisher_module.runtime_holder = NULL;
+    assert(publisher_service_users_drained());
+    DRAIN_CHECKS
