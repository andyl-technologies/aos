+static void assert_refusal(const uint8_t *wire, size_t length, int expected)
+{
+    QemuCrucibleProcessPurposeRecord out;
+    uint8_t before[sizeof(out)];
+
+    memset(&out, 0x6b, sizeof(out));
+    memcpy(before, &out, sizeof(out));
+    g_assert_cmpint(qemu_crucible_process_purpose_decode_v8(
+                       wire, length, &out), ==, expected);
+    g_assert_cmpmem(&out, sizeof(out), before, sizeof(before));
+}
