+/* Registry identity precedes any nominated holder or roster dereference.
+ * This is a retained same-bank storage check; no Setup/Root clock is queried. */
+int qemu_plugin_crucible_startup_runtime_check_v3(
+    qemu_plugin_id_t id, QemuCrucibleStartupRuntimePurpose *purpose)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleMetadataPartition *partition = &startup_source.metadata_partition;
+    uint64_t payload = 0;
+
+    if (!qatomic_load_acquire(&startup_source.module_custody_published) ||
+        purpose != &startup_source.runtime_purpose ||
+        startup_source.owner_process != getpid() ||
+        id != startup_source.saved.plugin_id) {
+        return -EPERM;
+    }
+    if (!purpose->attempted || !purpose->configured_attempted ||
+        !qatomic_load_acquire(&purpose->configured_published) ||
+        !purpose->charge.held || !purpose->installer.held ||
+        purpose->installer.process_id != startup_source.owner_process ||
+        purpose->installer.plugin_id != id ||
+        purpose->installer.process_generation != startup_source.original.process_generation ||
+        purpose->installer.ctx != startup_source.saved.ctx ||
+        purpose->installer.module != startup_source.saved.module ||
+        purpose->installer.install != startup_source.saved.install ||
+        !startup_source.custody_retained ||
+        !qatomic_load_acquire(&partition->published) ||
+        !qatomic_load_acquire(&partition->controller_retained) ||
+        !purpose->fixed_native_extent ||
+        purpose->fixed_native_extent != partition->fixed_native_extent ||
+        !purpose->configured_count || !purpose->configured_requests ||
+        purpose->configured_count > SIZE_MAX / sizeof(*purpose->configured_requests) ||
+        purpose->configured_storage_bytes !=
+            purpose->configured_count * sizeof(*purpose->configured_requests)) {
+        return -ESTALE;
+    }
+    for (size_t index = 0; index < purpose->configured_count; index++) {
+        const QemuCrucibleProcessPurposeRequest *request =
+            &purpose->configured_requests[index];
+
+        if (!request->extent || !request->alignment ||
+            (request->alignment & (request->alignment - 1)) ||
+            request->extent % request->alignment || request->count != 1 ||
+            request->extent > UINT64_MAX - payload) {
+            return -ESTALE;
+        }
+        payload += request->extent;
+    }
+    if (payload != purpose->configured_payload_bytes ||
+        purpose->configured_storage_bytes > UINT64_MAX - payload ||
+        purpose->charge.bytes != payload + purpose->configured_storage_bytes) {
+        return -ESTALE;
+    }
+    return crucible_metadata_partition_admission_status(partition);
+#else
+    return -ENOTSUP;
+#endif
+}
+
+static int startup_runtime_reserve_configured(
+    qemu_plugin_id_t id,
+    const struct qemu_plugin_crucible_runtime_request_v4 *role_requests,
+    size_t count, QemuCrucibleStartupRuntimePurpose **out,
+    QemuCrucibleCommandConsumerRequest **claim_out,
+    QemuCrucibleCallbackChildRequest **child_out,
+    QemuCrucibleFingerprintWorkerClaim **worker_out,
+    QemuCrucibleRunWorkerClaim **run_out,
+    QemuCrucibleTeardownWorkerClaim **teardown_out)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleStartupRuntimePurpose *purpose = &startup_source.runtime_purpose;
+    QemuCrucibleProcessPurposeRequest *roster;
+    uint64_t payload = 0;
+    size_t storage_bytes;
+    size_t bridge_index = SIZE_MAX;
+    size_t child_index = SIZE_MAX;
+    size_t worker_index = SIZE_MAX;
+    size_t run_index = SIZE_MAX;
+    size_t teardown_index = SIZE_MAX;
+    QemuCrucibleCommandConsumerRegistry *registry = &startup_source.commands;
+    pid_t process;
+    int status;
+
+    if (!startup_invocation(id)) {
+        return -EPERM;
+    }
+    {
+        const void *outputs[] = { out, claim_out, child_out, worker_out, run_out, teardown_out };
+
+        for (size_t index = 0; index < G_N_ELEMENTS(outputs); index++) {
+            if (callback_child_output_overlap(outputs[index], sizeof(void *),
+                                              &startup_source, sizeof(startup_source)) ||
+                fingerprint_output_workspace_overlap(outputs[index], sizeof(void *))) {
+                return -EINVAL;
+            }
+            for (size_t other = 0; other < index; other++) {
+                if (callback_child_output_overlap(outputs[index], sizeof(void *),
+                                                  outputs[other], sizeof(void *))) {
+                    return -EINVAL;
+                }
+            }
+        }
+    }
+    if (!out || *out || !role_requests || !count ||
+        !claim_out || *claim_out || (void *)claim_out == (void *)out ||
+        !child_out || *child_out || (void *)child_out == (void *)out ||
+        (void *)child_out == (void *)claim_out ||
+        !worker_out || *worker_out || (void *)worker_out == (void *)out ||
+        (void *)worker_out == (void *)claim_out ||
+        (void *)worker_out == (void *)child_out ||
+        !run_out || *run_out || !teardown_out || *teardown_out ||
+        (void *)run_out == (void *)out || (void *)run_out == (void *)claim_out ||
+        (void *)run_out == (void *)child_out || (void *)run_out == (void *)worker_out ||
+        (void *)teardown_out == (void *)out || (void *)teardown_out == (void *)claim_out ||
+        (void *)teardown_out == (void *)child_out || (void *)teardown_out == (void *)worker_out ||
+        (void *)teardown_out == (void *)run_out ||
+        count > SIZE_MAX / sizeof(*roster)) {
+        return -EINVAL;
+    }
+    if (purpose->attempted || purpose->configured_attempted) {
+        return -EALREADY;
+    }
+    status = qemu_crucible_startup_source_control_purpose_check_v2(
+        &startup_source.control_purpose);
+    if (status) {
+        return status;
+    }
+    storage_bytes = count * sizeof(*roster);
+    for (size_t index = 0; index < count; index++) {
+        const struct qemu_plugin_crucible_runtime_request_v4 *request =
+            &role_requests[index];
+
+        if (request->reserved || request->role > QEMU_CRUCIBLE_RUNTIME_ROLE_TEARDOWN_WORKER_CONTROL ||
+            (request->role == QEMU_CRUCIBLE_RUNTIME_ROLE_RUN_WORKER_CONTROL &&
+             (!index || run_index != SIZE_MAX)) ||
+            (request->role == QEMU_CRUCIBLE_RUNTIME_ROLE_TEARDOWN_WORKER_CONTROL &&
+             (!index || teardown_index != SIZE_MAX)) ||
+            (request->role == QEMU_CRUCIBLE_RUNTIME_ROLE_WORKER_CONTROL &&
+             (!index || worker_index != SIZE_MAX)) ||
+            (request->role == QEMU_CRUCIBLE_RUNTIME_ROLE_CALLBACK_CHILD &&
+             (!index || child_index != SIZE_MAX)) ||
+            (request->role == QEMU_CRUCIBLE_RUNTIME_ROLE_COMMAND_BRIDGE &&
+             (!index || bridge_index != SIZE_MAX))) {
+            return -EINVAL;
+        }
+        if (request->role == QEMU_CRUCIBLE_RUNTIME_ROLE_COMMAND_BRIDGE) {
+            bridge_index = index;
+        } else if (request->role == QEMU_CRUCIBLE_RUNTIME_ROLE_CALLBACK_CHILD) {
+            child_index = index;
+        } else if (request->role == QEMU_CRUCIBLE_RUNTIME_ROLE_WORKER_CONTROL) {
+            worker_index = index;
+        } else if (request->role == QEMU_CRUCIBLE_RUNTIME_ROLE_RUN_WORKER_CONTROL) {
+            run_index = index;
+        } else if (request->role == QEMU_CRUCIBLE_RUNTIME_ROLE_TEARDOWN_WORKER_CONTROL) {
+            teardown_index = index;
+        }
+
+        if (!request->extent_bytes || !request->alignment_bytes ||
+            (request->alignment_bytes & (request->alignment_bytes - 1)) ||
+            request->extent_bytes % request->alignment_bytes ||
+            request->birth_count != 1) {
+            return -EINVAL;
+        }
+        if (request->extent_bytes > UINT64_MAX - payload) {
+            return -EOVERFLOW;
+        }
+        payload += request->extent_bytes;
+    }
+    if (bridge_index == SIZE_MAX || child_index == SIZE_MAX ||
+        run_index == SIZE_MAX || teardown_index == SIZE_MAX) {
+        return -EINVAL;
+    }
+    if (storage_bytes > UINT64_MAX - payload) {
+        return -EOVERFLOW;
+    }
+    status = startup_process_purpose_live();
+    if (status) {
+        return status;
+    }
+
+    /* sizeof(Source) pays this actual inline owner before these writes. The
+     * closed roster array is separately debited before its allocator entry.
+     * Row zero is never replaced by the sum of other requested bodies. */
+    process = getpid();
+    if (startup_source.owner_process != process ||
+        !startup_source.checkpoint_storage.fixed_charge.held ||
+        startup_source.metadata_partition.fixed_native_extent !=
+            qemu_crucible_startup_source_fixed_control_extent()) {
+        return -EPERM;
+    }
+    if (!qatomic_load_acquire(&registry->initialized)) {
+        qemu_mutex_init(&registry->mutex);
+        registry->process = process;
+        qatomic_store_release(&registry->initialized, true);
+    }
+    if (registry->process != process) {
+        return -EPERM;
+    }
+    qemu_mutex_lock(&registry->mutex);
+    if (registry->claim.attempted || registry->child_claim.attempted) {
+        qemu_mutex_unlock(&registry->mutex);
+        return -EALREADY;
+    }
+    registry->claim = (QemuCrucibleCommandConsumerRequest) {
+        .runtime = purpose,
+        .canonical_owner = &registry->claim,
+        .request_index = bridge_index,
+        .extent = role_requests[bridge_index].extent_bytes,
+        .alignment = role_requests[bridge_index].alignment_bytes,
+        .process_generation = startup_source.original.process_generation,
+        .account_generation = startup_source.standing.initial.account_generation,
+        .fixed_native_extent = startup_source.metadata_partition.fixed_native_extent,
+        .process = process,
+        .attempted = true,
+        .held = true,
+    };
+    *claim_out = &registry->claim;
+    registry->child_claim = (QemuCrucibleCallbackChildRequest) {
+        .runtime = purpose,
+        .canonical_owner = &registry->child_claim,
+        .request_index = child_index,
+        .extent = role_requests[child_index].extent_bytes,
+        .alignment = role_requests[child_index].alignment_bytes,
+        .process_generation = startup_source.original.process_generation,
+        .account_generation = startup_source.standing.initial.account_generation,
+        .fixed_native_extent = startup_source.metadata_partition.fixed_native_extent,
+        .process = process,
+        .attempted = true,
+        .held = true,
+    };
+    *child_out = &registry->child_claim;
+    if (worker_index != SIZE_MAX) {
+        startup_source.worker_claim = (QemuCrucibleFingerprintWorkerClaim) {
+            .runtime = purpose,
+            .request_index = worker_index,
+            .issued = true,
+        };
+        *worker_out = &startup_source.worker_claim;
+    }
+    startup_source.run_worker_claim = (QemuCrucibleRunWorkerClaim) {
+        .runtime = purpose, .request_index = run_index, .issued = true,
+    };
+    startup_source.teardown_worker_claim = (QemuCrucibleTeardownWorkerClaim) {
+        .runtime = purpose, .request_index = teardown_index, .issued = true,
+    };
+    *run_out = &startup_source.run_worker_claim;
+    *teardown_out = &startup_source.teardown_worker_claim;
+    qemu_mutex_unlock(&registry->mutex);
+    purpose->installer = startup_source.control_purpose;
+    purpose->attempted = true;
+    purpose->configured_attempted = true;
+    purpose->configured_count = count;
+    purpose->configured_storage_bytes = storage_bytes;
+    purpose->configured_payload_bytes = payload;
+    purpose->fixed_native_extent = startup_source.metadata_partition.fixed_native_extent;
+    *out = purpose;
+    status = crucible_metadata_native_admit(&startup_source.metadata_partition,
+        payload + storage_bytes, &purpose->charge);
+    if (status) {
+        return startup_failure(status);
+    }
+    /* The retained roster stores the compiled request geometry; the role is
+     * retained separately in the nominal Source claim, not in payload bytes. */
+    G_STATIC_ASSERT(sizeof(((QemuCrucibleProcessPurposeRequest *)0)->extent) ==
+                    sizeof(((struct qemu_plugin_crucible_runtime_request_v4 *)0)->extent_bytes));
+    G_STATIC_ASSERT(sizeof(((QemuCrucibleProcessPurposeRequest *)0)->alignment) ==
+                    sizeof(((struct qemu_plugin_crucible_runtime_request_v4 *)0)->alignment_bytes));
+    G_STATIC_ASSERT(_Alignof(QemuCrucibleProcessPurposeRequest) <=
+                    _Alignof(max_align_t));
+    roster = g_try_malloc0(storage_bytes);
+    purpose->configured_requests = roster;
+    if (!roster) {
+        /* The actual no-allocation result does not refund the process-held
+         * prefix. The nominal owner and debit stay visible to containment. */
+        status = startup_process_purpose_live();
+        if (status) {
+            crucible_metadata_partition_record_post(&startup_source.metadata_partition,
+                                                    status);
+        }
+        startup_failure(-ENOMEM);
+        return -ENOMEM;
+    }
+    for (size_t index = 0; index < count; index++) {
+        roster[index] = (QemuCrucibleProcessPurposeRequest) {
+            .extent = role_requests[index].extent_bytes,
+            .alignment = role_requests[index].alignment_bytes,
+            .count = role_requests[index].birth_count,
+        };
+    }
+    qemu_mutex_lock(&registry->mutex);
+    registry->claim.request = &roster[bridge_index];
+    registry->child_claim.request = &roster[child_index];
+    if (worker_index != SIZE_MAX) {
+        startup_source.worker_claim.request = &roster[worker_index];
+    }
+    startup_source.run_worker_claim.request = &roster[run_index];
+    startup_source.teardown_worker_claim.request = &roster[teardown_index];
+    qemu_mutex_unlock(&registry->mutex);
+    /* Both real role layouts, backing debits and task reservations precede
+     * publication. A failed pair remains retained and admits no worker birth. */
+    status = required_workers_plan(purpose);
+    if (!status) {
+        status = startup_process_purpose_live();
+    }
+    if (status) {
+        crucible_metadata_partition_record_post(&startup_source.metadata_partition,
+                                                status);
+        return status;
+    }
+    qatomic_store_release(&purpose->configured_published, true);
+    return qemu_plugin_crucible_startup_runtime_check_v3(id, purpose);
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_startup_runtime_reserve_v7(
+    qemu_plugin_id_t id,
+    const struct qemu_plugin_crucible_runtime_request_v4 *requests,
+    size_t count, QemuCrucibleStartupRuntimePurpose **out,
+    QemuCrucibleCommandConsumerRequest **bridge_claim,
+    QemuCrucibleCallbackChildRequest **child_claim,
+    QemuCrucibleFingerprintWorkerClaim **worker_claim,
+    QemuCrucibleRunWorkerClaim **run_claim,
+    QemuCrucibleTeardownWorkerClaim **teardown_claim)
+{
+    if (!child_claim) {
+        return -EINVAL;
+    }
+    return startup_runtime_reserve_configured(
+        id, requests, count, out, bridge_claim, child_claim, worker_claim,
+        run_claim, teardown_claim);
+}
+
+static uint64_t startup_runtime_parent_extent(
+    QemuCrucibleStartupRuntimePurpose *purpose)
+{
+    if (!qatomic_load_acquire(&startup_source.module_custody_published) ||
+        purpose != &startup_source.runtime_purpose) {
+        return 0;
+    }
+    return qemu_plugin_crucible_startup_runtime_check_v3(
+        startup_source.saved.plugin_id, purpose) ? 0 :
+        purpose->configured_requests[0].extent;
+}
+
+/* Temporal admission remains distinct from retained roster accounting.
+ * Every caller below also requires its actual installer or entered operation. */
+static int startup_runtime_admission(
+    qemu_plugin_id_t id, QemuCrucibleStartupRuntimePurpose *purpose)
+{
+    int status;
+
+    if (!startup_invocation(id) &&
+        !(standing_operation_identity(&startup_source.standing.operation) &&
+          startup_source.standing.operation.plugin_id == id) &&
+        !(standing_construction_operation_identity() &&
+          startup_source.standing.construction.associated &&
+          startup_source.standing.construction.installer.plugin_id == id)) {
+        return -EPERM;
+    }
+    status = qemu_crucible_startup_source_control_purpose_check_v2(
+        &startup_source.control_purpose);
+    if (status) {
+        return status;
+    }
+    status = crucible_metadata_partition_admission_status(
+        &startup_source.metadata_partition);
+    if (status) {
+        return status;
+    }
+    if (purpose != &startup_source.runtime_purpose || !purpose->attempted ||
+        !purpose->charge.held ||
+        purpose->installer.process_id != startup_source.owner_process ||
+        purpose->installer.plugin_id != id ||
+        purpose->installer.process_generation !=
+            startup_source.original.process_generation ||
+        purpose->installer.ctx != startup_source.saved.ctx ||
+        purpose->installer.module != startup_source.saved.module ||
+        purpose->installer.install != startup_source.saved.install) {
+        return -EPERM;
+    }
+#ifdef CONFIG_LINUX
+    status = qemu_plugin_crucible_startup_runtime_check_v3(id, purpose);
+    if (status) {
+        return status;
+    }
+    return startup_process_purpose_live();
+#else
+    return -ENOTSUP;
+#endif
+}
+
+/* Cleanup authenticates retained custody independently of the completed Setup
+ * clock. It remains on the actual native installing/creating thread; a worker
+ * cannot enroll itself or perform teardown by copying the holder or plugin id.
+ */
+static int startup_runtime_cleanup_identity(
+    qemu_plugin_id_t id, QemuCrucibleStartupRuntimePurpose *purpose)
+{
+    if (!startup_owner() ||
+        !qatomic_load_acquire(&startup_source.process_purpose_complete)) {
+        return -EPERM;
+    }
+    if (purpose != &startup_source.runtime_purpose || !purpose->attempted ||
+        !purpose->charge.held || !purpose->installer.held ||
+        purpose->installer.process_id != getpid() ||
+        purpose->installer.plugin_id != id ||
+        purpose->installer.ctx != startup_source.saved.ctx ||
+        purpose->installer.module != startup_source.saved.module ||
+        purpose->installer.install != startup_source.saved.install ||
+        purpose->installer.process_generation !=
+            startup_source.original.process_generation ||
+        !startup_source.custody_retained || !startup_source.owns_event) {
+        return -EPERM;
+    }
+    return 0;
+}
+
+#ifdef CONFIG_LINUX
+static int startup_runtime_original_post(void)
+{
+    uint64_t now;
+    int status = startup_cancelled();
+
+    if (!status) {
+        status = startup_event_identity();
+    }
+    if (!status) {
+        status = startup_monotonic_now(&now);
+    }
+    if (!status && now < startup_source.original.original_start_ns) {
+        status = -ESTALE;
+    }
+    if (!status && now >= startup_source.original.absolute_end_ns) {
+        status = -ETIMEDOUT;
+    }
+    return status;
+}
+#endif
+
+int qemu_plugin_crucible_startup_runtime_interrupt_v2(
+    qemu_plugin_id_t id, qemu_plugin_crucible_runtime_purpose_v2 *purpose,
+    int initiating_status)
+{
+#ifdef CONFIG_LINUX
+    struct stat observed;
+    int result;
+    int saved_errno;
+    int post;
+    int status = startup_runtime_cleanup_identity(id, purpose);
+
+    if (status) {
+        return status;
+    }
+    if (initiating_status >= 0) {
+        return -EINVAL;
+    }
+    if (qatomic_cmpxchg(&purpose->interrupt_cut, 0, 1)) {
+        return -EAGAIN;
+    }
+    if (purpose->interrupt_attempted) {
+        qatomic_store_release(&purpose->interrupt_cut, 0);
+        return -EALREADY;
+    }
+    /* Verify SAME retained endpoint before any shutdown. No fd is closed,
+     * duplicated or numerically retried, including an ambiguous interruption. */
+    if (fstat(QEMU_CRUCIBLE_PREEXEC_SETUP_CONTROL_FD, &observed) < 0) {
+        status = -errno;
+    } else if (!S_ISSOCK(observed.st_mode) ||
+               (uint64_t)observed.st_dev != startup_source.control_device ||
+               (uint64_t)observed.st_ino != startup_source.control_inode) {
+        status = -ESTALE;
+    }
+    if (status) {
+        qatomic_store_release(&purpose->interrupt_cut, 0);
+        return status;
+    }
+    startup_failure(initiating_status);
+    purpose->interrupt_attempted = true;
+    result = shutdown(QEMU_CRUCIBLE_PREEXEC_SETUP_CONTROL_FD, SHUT_RDWR);
+    saved_errno = errno;
+    purpose->interrupt_result = result;
+    purpose->interrupt_errno = result < 0 ? saved_errno : 0;
+    if (result < 0) {
+        crucible_metadata_partition_record_post(
+            &startup_source.metadata_partition, -saved_errno);
+    }
+    /* Raw original post remains independent of the initiating signed failure.
+     * Expiry/cancellation cannot suppress safe same-owned terminal interruption.
+     * A successful shutdown is not a reader join or allocation retirement. */
+    post = startup_runtime_original_post();
+    purpose->interrupt_post = post;
+    if (post) {
+        crucible_metadata_partition_record_post(
+            &startup_source.metadata_partition, post);
+    }
+    qatomic_store_release(&purpose->interrupt_cut, 0);
+    errno = saved_errno;
+    return startup_source.first_negative_status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_startup_runtime_interrupt_observe_v2(
+    qemu_plugin_id_t id, qemu_plugin_crucible_runtime_purpose_v2 *purpose,
+    struct qemu_plugin_crucible_runtime_interrupt_status_v2 *out)
+{
+    struct qemu_plugin_crucible_runtime_interrupt_status_v2 observed;
+    int status = startup_runtime_cleanup_identity(id, purpose);
+
+    if (status || !out) {
+        return status ? status : -EINVAL;
+    }
+    if (qatomic_cmpxchg(&purpose->interrupt_cut, 0, 1)) {
+        return -EAGAIN;
+    }
+    observed = (struct qemu_plugin_crucible_runtime_interrupt_status_v2) {
+        .schema_version = 2,
+        .struct_size = sizeof(observed),
+        .attempted = purpose->interrupt_attempted,
+        .result = purpose->interrupt_result,
+        .saved_errno = purpose->interrupt_errno,
+        .first_status = startup_source.first_negative_status,
+        .post_status = purpose->interrupt_post,
+        .reserved = 0,
+    };
+    qatomic_store_release(&purpose->interrupt_cut, 0);
+    *out = observed;
+    return 0;
+}
+
+int qemu_plugin_crucible_startup_source_acquire_v1(
+    qemu_plugin_id_t id, int purpose_plan_fd)
+{
+#ifdef CONFIG_LINUX
+    QemuCruciblePreexecSourceBorrow borrowed;
+    struct stat purpose_before;
+    struct stat purpose_after;
+    void *registered;
+    uint64_t bounded_ns;
+    uint64_t native_generation;
+    int result;
+
+    if (!startup_invocation(id)) {
+        return -EPERM;
+    }
+    if (!qatomic_load_acquire(&qemu_crucible_selected_process_id) ||
+        !qatomic_load_acquire(&startup_source.process_purpose_complete) ||
+        !startup_source.preexec_purpose_owner ||
+        !startup_source.process_contract_owner ||
+        !startup_source.incarnation_purpose_owner) {
+        return startup_failure(-ENOKEY);
+    }
+    if (startup_source.acquisition_attempted) {
+        if (startup_source.saved.plugin_id != id) {
+            return -EPERM;
+        }
+        return startup_source.first_negative_status != 0 ?
+            startup_source.first_negative_status : startup_failure(-EALREADY);
+    }
+    /* Validate the entered installer without waiting on a foreign caller. */
+    result = qemu_rec_mutex_trylock(&plugin.lock);
+    if (result != 0) {
+        return result;
+    }
+    registered = g_hash_table_lookup(plugin.id_ht, &id);
+    if (registered != &startup_source.current.ctx->id ||
+        startup_source.current.ctx->resetting ||
+        startup_source.current.ctx->uninstalling) {
+        qemu_rec_mutex_unlock(&plugin.lock);
+        return -EPERM;
+    }
+    qemu_rec_mutex_unlock(&plugin.lock);
+
+#if defined(__x86_64__) && !defined(__ILP32__)
+    result = qemu_crucible_preexec_purpose_borrow_v3(
+        startup_source.preexec_purpose_owner, &borrowed);
+    if (result || purpose_plan_fd != borrowed.descriptors[2]) {
+        return startup_failure(result ? result : -ESTALE);
+    }
+#else
+    return startup_failure(-ENOTSUP);
+#endif
+
+    /* Recheck lifecycle after the unlocked purpose borrow. The entered
+     * installer retains ctx across this cut. Even a pending retirement keeps
+     * the authenticated module binding as negative custody. */
+    result = qemu_rec_mutex_trylock(&plugin.lock);
+    if (result != 0) {
+        return startup_failure(result);
+    }
+    registered = g_hash_table_lookup(plugin.id_ht, &id);
+    if (registered != &startup_source.current.ctx->id) {
+        qemu_rec_mutex_unlock(&plugin.lock);
+        return startup_failure(-EPERM);
+    }
+    result = startup_source.current.ctx->resetting ||
+        startup_source.current.ctx->uninstalling ? -EPERM : 0;
+
+    /* No callback, clock, allocation or descriptor effect under this lock.
+     * The separate release flag makes every saved field immutable to readers;
+     * the earlier preinit custody flag cannot publish a module binding. */
+    startup_source.saved = startup_source.current;
+    startup_source.acquisition_attempted = true;
+    startup_source.purpose_plan_fd = purpose_plan_fd;
+    startup_source.event_fd = STARTUP_EVENT_FD;
+    startup_source.owns_event = true;
+    qatomic_store_release(&startup_source.custody_retained, true);
+    qatomic_store_release(&startup_source.module_custody_published, true);
+    qemu_rec_mutex_unlock(&plugin.lock);
+    if (result != 0) {
+        return startup_failure(result);
+    }
+
+    /* Preserve the already genuinely retained fixed Source+Receiving floor.
+     * Acquisition cannot refund or reissue separate static storage custody. */
+    if (!startup_source.checkpoint_storage.fixed_charge.held ||
+        startup_source.checkpoint_storage.issuer != startup_source.preexec_purpose_owner ||
+        startup_source.metadata_partition.fixed_native_extent !=
+            qemu_crucible_startup_source_fixed_control_extent()) {
+        return startup_failure(-ENOKEY);
+    }
+    if (fstat(purpose_plan_fd, &purpose_before) < 0) {
+        return startup_failure(-errno);
+    }
+    startup_source.purpose_device = purpose_before.st_dev;
+    startup_source.purpose_inode = purpose_before.st_ino;
+    qatomic_store_release(&startup_source.purpose_identity_known, true);
+
+    /* SAME retained plan and original, never a second read/receive issuer. */
+    if (fstat(purpose_plan_fd, &purpose_after) < 0) {
+        return startup_failure(-errno);
+    }
+    if (purpose_before.st_dev != purpose_after.st_dev ||
+        purpose_before.st_ino != purpose_after.st_ino) {
+        return startup_failure(-ESTALE);
+    }
+    if (borrowed.plan->startup.cancellation_descriptor != STARTUP_EVENT_FD) {
+        return startup_failure(-EINVAL);
+    }
+    startup_source.original = borrowed.plan->startup;
+    qatomic_store_release(&startup_source.total_pinned, true);
+    native_generation = qemu_crucible_fault_lifecycle_process_generation();
+    if (native_generation != 0 &&
+        native_generation != startup_source.original.process_generation) {
+        return startup_failure(-ESTALE);
+    }
+    result = qemu_plugin_crucible_ram_set_metadata_budget_v1(
+        startup_source.original.original_total_bytes);
+    if (result != 0) {
+        return startup_failure(result);
+    }
+    if (startup_source.original.original_total_bytes < sizeof(startup_source)) {
+        return startup_failure(-ENOSPC);
+    }
+    result = startup_live_slice(&bounded_ns);
+    if (result == 0) {
+        startup_source.phase = STARTUP_SOURCE_ACQUIRED;
+        qatomic_store_release(&startup_source.original_record_complete, true);
+    }
+    return result;
+#else
+    return -ENOTSUP;
+#endif
+}
