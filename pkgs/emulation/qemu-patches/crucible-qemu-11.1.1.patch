+int qemu_plugin_crucible_ram_control_actor_observe_v1(
+    qemu_plugin_id_t id, qemu_plugin_crucible_ram_control_actor_v1 *actor,
+    struct qemu_plugin_crucible_ram_control_actor_status_v1 *out)
+{
+    struct qemu_plugin_crucible_ram_control_actor_status_v1 observed;
+    int status = ram_control_creator(actor, id);
+
+    if (status || !out) {
+        return status ? status : -EINVAL;
+    }
+    observed = (struct qemu_plugin_crucible_ram_control_actor_status_v1) {
+        .schema_version = 1,
+        .struct_size = sizeof(observed),
+        .born = qatomic_load_acquire(&actor->born),
+        .returned = qatomic_load_acquire(&actor->returned),
+        .joined = actor->joined,
+        .join_attempted = actor->join_attempted,
+        .join_result = actor->join_result,
+        .join_errno = actor->join_errno,
+        .entry_status = qatomic_read(&actor->entry_status),
+        .first_status = qatomic_read(&actor->first_status),
+        .post_status = qatomic_read(&actor->post_status),
+    };
+    *out = observed;
+    return 0;
+}
