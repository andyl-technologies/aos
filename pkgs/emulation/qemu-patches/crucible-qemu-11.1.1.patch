+    stq_be_p(hash->block + 56, hash->bytes * 8);
+    qcrypto_sha256_compress(hash, hash->block);
+    for (size_t index = 0; index < 8; index++) {
+        stl_be_p(digest + index * 4, hash->state[index]);
+    }
+    hash->active = false;
+    return 0;
