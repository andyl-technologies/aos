+
+static int fingerprint_worker_resolve(QemuCrucibleFingerprintWorker *worker)
+{
+    const struct qemu_plugin_crucible_fingerprint_worker_layout_v1 *layout;
+    gpointer symbol;
+
+#define RESOLVE_WORKER(member, suffix)                                      \
+    do {                                                                  \
+        if (!g_module_symbol(worker->native.installer.module,                     \
+              "qemu_plugin_crucible_fingerprint_worker_" suffix "_v1",     \
+              &symbol) || !plugin_worker_same_module(symbol)) {       \
+            return -ELIBBAD;                                               \
+        }                                                                 \
+        worker->member = (__typeof__(worker->member))symbol;                \
+    } while (0)
+
+    RESOLVE_WORKER(construct, "construct");
+    RESOLVE_WORKER(entry, "entry");
+    RESOLVE_WORKER(close, "module_close");
+    RESOLVE_WORKER(control, "module_control");
