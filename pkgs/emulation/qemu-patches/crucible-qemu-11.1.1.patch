+    timer_wide_fixture.needed = timer_fixture_wide_needed;
+    module_call_init(MODULE_INIT_QOM);
+    qemu_init_main_loop(&error);
+    g_assert_null(error);
+    if (!g_getenv("RTC_TIMER_ORDINARY")) {
+        qemu_timer_enable_tcg_ps_clock(NULL, diagnostic_clock);
+    }
+    qemu_clock_enable(rtc_clock, true);
+
+    for (unsigned index = 0; index < ARRAY_SIZE(calendar_vectors); index++) {
+        char *name = g_strdup_printf("/rtc-wide/calendar/%u", index);
+
+        g_test_add_data_func(name, GUINT_TO_POINTER(index), test_calendar);
+        g_free(name);
+    }
+    for (unsigned index = 0; index < ARRAY_SIZE(oscillator_vectors); index++) {
+        char *name = g_strdup_printf("/rtc-wide/oscillator/%u", index);
+
+        g_test_add_data_func(name, GUINT_TO_POINTER(index), test_oscillator);
+        g_free(name);
+    }
+    for (unsigned index = 0; index < 3; index++) {
+        char *name = g_strdup_printf("/rtc-wide/update/%u", index);
+
+        g_test_add_data_func(name, GUINT_TO_POINTER(index), test_update_program);
+        g_free(name);
+        name = g_strdup_printf("/rtc-wide/stop/%u", index);
+        g_test_add_data_func(name, GUINT_TO_POINTER(index), test_update_stop);
+        g_free(name);
+    }
+    for (unsigned index = 0; index < 9; index++) {
+        char *name = g_strdup_printf("/rtc-wide/migration/%u", index);
+
+        g_test_add_data_func(name, GUINT_TO_POINTER(index), test_round_trip);
+        g_free(name);
+    }
+    for (unsigned index = 0; index < 11; index++) {
+        char *name = g_strdup_printf("/rtc-wide/malformed/%u", index);
+
+        g_test_add_data_func(name, GUINT_TO_POINTER(index), test_malformed);
+        g_free(name);
+    }
+    for (unsigned index = 0; index < ARRAY_SIZE(periodic_vectors); index++) {
+        char *name = g_strdup_printf("/rtc-wide/periodic/%u", index);
+
+        g_test_add_data_func(name, GUINT_TO_POINTER(index), test_periodic_program);
+        g_free(name);
+    }
+    for (unsigned index = 0; index < 6; index++) {
+        char *name = g_strdup_printf("/rtc-wide/cross-mode/%u", index);
+
+        g_test_add_data_func(name, GUINT_TO_POINTER(index), test_cross_mode);
+        g_free(name);
+    }
+    for (unsigned index = 0; index < 4; index++) {
+        char *name = g_strdup_printf("/rtc-wide/timer-projection/%u", index);
+
+        g_test_add_data_func(name, GUINT_TO_POINTER(index), test_timer_projection);
+        g_free(name);
+    }
+    g_test_add_func("/rtc-wide/bounded-mapper", test_bounded_service_mapper);
+    g_test_add_func("/rtc-wide/capture-origin", test_capture_origin);
+    g_test_add_func("/rtc-wide/uip", test_uip_window);
+    g_test_add_func("/rtc-wide/overflow", test_overflow);
+    g_test_add_func("/rtc-wide/actual-callback", test_actual_callback);
+    g_test_add_func("/rtc-wide/ordinary", test_ordinary);
+    return g_test_run();
+}
