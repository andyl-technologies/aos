+static int preexec_setup_pread(int fd, uint8_t *buffer, size_t bytes,
+                               uint64_t offset)
+{
+    size_t completed = 0;
+
+    while (completed < bytes) {
+        long result = preexec_setup_syscall5(
+            SYS_pread64, fd, (long)(uintptr_t)(buffer + completed),
+            bytes - completed, (uint64_t)offset + completed, 0);
+
+        /* Every accepted iteration makes positive bounded progress. Neither
+         * EINTR nor EOF is retried; the exact attempted body remains retained.
+         */
+        if (result < 0) {
+            return (int)result;
+        }
+        if (!result || (uint64_t)result > bytes - completed) {
+            return -EIO;
+        }
+        completed += result;
+    }
+    return 0;
+}
