+    notifier_remove(notifier);
+}
+
+int qemu_plugin_inject_preemption(uint64_t at_icount,
+                                  uint64_t deadline_icount,
+                                  uint64_t ceiling_icount,
+                                  unsigned int kind, uint32_t arg0,
+                                  uint32_t arg1, uint32_t arg2)
+{
+    return crucible_sim_preemption_enqueue(at_icount, deadline_icount,
+                                           ceiling_icount, kind, arg0, arg1,
+                                           arg2);
+}
+
+static void qemu_plugin_wake_fd_read(void *opaque)
+{
+    int fd = (intptr_t)opaque;
+    uint8_t buffer[256];
+    CPUState *cpu;
+    bool drained = false;
+
+    for (;;) {
+        ssize_t ret = read(fd, buffer, sizeof(buffer));
+
+        if (ret > 0) {
+            drained = true;
+            continue;
+        }
+        if (ret < 0 && errno == EINTR) {
+            continue;
+        }
+        if (ret < 0 && (errno == EAGAIN || errno == EWOULDBLOCK)) {
+            bool single_threaded_rr = drained && first_cpu &&
+                qemu_plugin_crucible_single_threaded_rr();
+
+            if (drained) {
+                notifier_list_notify(&qemu_plugin_wake_notifiers,
+                                     (void *)(intptr_t)QEMU_PLUGIN_WAKE_EVENT_DRAINED);
+            }
+            if (single_threaded_rr &&
+                qemu_plugin_crucible_vmstop_quiesced()) {
+                /*
+                 * A stopped RR thread cannot claim a native request.  Device
+                 * notifiers have already settled under the BQL, so transfer
+                 * any older request to the existing two-pass main-loop owner
+                 * and let it acknowledge this exact paused boundary.
+                 */
+                if (qemu_plugin_crucible_rr_control_boundary_pending()) {
+                    qemu_plugin_crucible_rr_control_boundary_cancel();
+                }
+                qemu_plugin_schedule_control_boundary();
+            } else if (single_threaded_rr) {
+                qemu_plugin_request_rr_control_boundary();
+            } else if (drained && first_cpu) {
+                qemu_plugin_schedule_control_boundary();
+                /* Preserve the generic wake for every MTTCG vCPU. */
+                CPU_FOREACH(cpu) {
+                    tcg_kick_vcpu_thread(cpu);
+                }
+            }
+            return;
+        }
+        if (ret == 0) {
+            error_report("Crucible plugin wake fd %d reached EOF", fd);
+        } else {
+            error_report("Crucible plugin wake fd %d read failed: %s",
+                         fd, strerror(errno));
+        }
+        notifier_list_notify(&qemu_plugin_wake_notifiers,
+                             (void *)(intptr_t)QEMU_PLUGIN_WAKE_EVENT_FAILED);
+        qemu_plugin_unregister_wake_fd(fd);
+        qemu_system_shutdown_request(SHUTDOWN_CAUSE_HOST_ERROR);
+        if (first_cpu) {
+            qemu_cpu_kick(first_cpu);
+        }
+        return;
+    }
+}
+
+int qemu_plugin_register_wake_fd(int fd)
+{
+    int flags;
+
+    if (fd < 0) {
+        return -1;
+    }
+    flags = fcntl(fd, F_GETFL);
+    if (flags < 0 || !(flags & O_NONBLOCK)) {
+        return -1;
+    }
+
+    if (qemu_plugin_wake_fd >= 0) {
+        return qemu_plugin_wake_fd == fd ? 0 : -EBUSY;
+    }
+
+    qemu_plugin_wake_fd = fd;
+    aio_set_fd_handler(qemu_get_aio_context(), fd,
+                       qemu_plugin_wake_fd_read, NULL, NULL, NULL,
+                       (void *)(intptr_t)fd);
+    return 0;
+}
+
+void qemu_plugin_request_shutdown(int failure)
+{
+    qemu_system_shutdown_request(failure ? SHUTDOWN_CAUSE_HOST_ERROR :
+                                           SHUTDOWN_CAUSE_HOST_QMP_QUIT);
+    if (first_cpu) {
+        qemu_cpu_kick(first_cpu);
+    }
+}
+
+void qemu_plugin_register_vcpu_idle_resume_cb(qemu_plugin_vcpu_idle_resume_cb_t idle_cb,
+                                              qemu_plugin_vcpu_idle_resume_cb_t resume_cb,
+                                              void *userdata)
+{
+    qemu_plugin_vcpu_idle_resume_userdata = userdata;
+    qemu_plugin_vcpu_idle_resume_resume_cb = resume_cb;
+    qemu_plugin_vcpu_idle_resume_idle_cb = idle_cb;
+    if (idle_cb && resume_cb) {
+        qemu_plugin_crucible_callback_registered(
+            0, QEMU_PLUGIN_CRUCIBLE_CALLBACK_VCPU_IDLE_RESUME);
+    }
+}
+
+static bool qemu_plugin_crucible_idle_cpu_is_current_member(
+    CPUState *cpu, unsigned int vcpu_index, unsigned int generation)
+{
+    CPUState *member;
+    bool found = false;
+
+    if (cpu_list_generation_id_get() != generation ||
+        !QTAILQ_IN_USE(cpu, node) || cpu->cpu_index != vcpu_index ||
+        !cpu->created || cpu->unplug || !qemu_cpu_is_self(cpu)) {
+        return false;
+    }
+
+    CPU_FOREACH(member) {
+        if (member == cpu) {
+            found = true;
+            break;
+        }
+    }
+    return found;
+}
+
+typedef struct QemuPluginCrucibleIdleWaitProduction {
+    CPUState *cpu;
+    unsigned int vcpu_index;
+    unsigned int cpu_list_generation;
+} QemuPluginCrucibleIdleWaitProduction;
+
+void qemu_plugin_crucible_kick_idle_wait(CPUState *cpu)
+{
+#ifdef CONFIG_LINUX
+    QEMU_LOCK_GUARD(&qemu_plugin_crucible_idle_wait_lock);
+
+    (void)cpu;
+    if (qemu_plugin_crucible_active_idle_wake_signal) {
+        qatomic_fetch_add(qemu_plugin_crucible_active_idle_wake_signal, 1);
+        if (qemu_futex(qemu_plugin_crucible_active_idle_wake_signal,
+                       FUTEX_WAKE, 1, NULL, NULL, 0) < 0) {
+            error_report("Crucible idle-wait futex wake failed: %s",
+                         strerror(errno));
+            abort();
+        }
+    }
+#else
+    (void)cpu;
+#endif
+}
+
+static void qemu_plugin_crucible_idle_pin_cpu(void *opaque)
+{
+    QemuPluginCrucibleIdleWaitProduction *wait = opaque;
+
+    object_ref(OBJECT(wait->cpu));
+}
+
+static void qemu_plugin_crucible_idle_unpin_cpu(void *opaque)
+{
+    QemuPluginCrucibleIdleWaitProduction *wait = opaque;
+
+    object_unref(OBJECT(wait->cpu));
+}
+
+static bool qemu_plugin_crucible_idle_arm_wait(void *opaque,
+                                               uint32_t *wake_signal,
+                                               uint32_t expected)
+{
+    CPUState *cpu;
+    bool can_wait = true;
+
+    (void)opaque;
+    qemu_mutex_lock(&qemu_plugin_crucible_idle_wait_lock);
+    g_assert(!qemu_plugin_crucible_active_idle_wake_signal);
+    (void)expected;
+    qemu_plugin_crucible_active_idle_wake_signal = wake_signal;
+
+    /*
+     * A handled host wake can leave exit_request set on halted CPUs that share
+     * the RR thread.  At this aggregate idle boundary, retire those transient
+     * bits only when every durable per-CPU work predicate is clean.  A
+     * concurrent qemu_cpu_kick() publishes its exit before waiting for this
+     * mutex, then increments the published futex word after we unlock.  The
+     * final acquire scan below also catches every durable predicate.
+     */
+    CPU_FOREACH(cpu) {
+        if (cpu->halted &&
+            !qatomic_read(&cpu->stop) &&
+            !qatomic_read(&cpu->stopped) &&
+            !qatomic_read(&cpu->unplug) &&
+            !qatomic_read(&cpu->interrupt_request) &&
+            cpu_work_list_empty(cpu) && cpu_thread_is_idle(cpu) &&
+            !cpu_has_work(cpu)) {
+            qatomic_xchg(&cpu->exit_request, 0);
+        }
+    }
+
+    smp_mb_acquire();
+    if (!runstate_is_running() ||
+        qemu_plugin_crucible_guest_pause_handoff_pending() ||
+        qemu_plugin_crucible_vmstop_pending() ||
+        qemu_plugin_crucible_vmstop_admission_pending()) {
+        can_wait = false;
+    }
+
+    CPU_FOREACH(cpu) {
+        if (qatomic_read(&cpu->stop) || qatomic_read(&cpu->stopped) ||
+            qatomic_read(&cpu->unplug) ||
+            qatomic_read(&cpu->exit_request) ||
+            qatomic_read(&cpu->interrupt_request) ||
+            !cpu_work_list_empty(cpu) || !cpu_thread_is_idle(cpu) ||
+            cpu_has_work(cpu)) {
+            can_wait = false;
+            break;
+        }
+    }
+    if (!can_wait) {
+        qemu_plugin_crucible_active_idle_wake_signal = NULL;
+    }
+    qemu_mutex_unlock(&qemu_plugin_crucible_idle_wait_lock);
+    return can_wait;
+}
+
+static void qemu_plugin_crucible_idle_unlock_bql(void *opaque)
+{
+    (void)opaque;
+    bql_unlock();
+}
+
+static void qemu_plugin_crucible_idle_lock_bql(void *opaque)
+{
+    (void)opaque;
+    bql_lock();
+}
+
+static int qemu_plugin_crucible_idle_raw_wait(
+    void *opaque, uint32_t *wake_signal, uint32_t expected,
+    int *wait_errno)
+{
+#ifdef CONFIG_LINUX
+    int result = qemu_futex(wake_signal, FUTEX_WAIT, (int)expected,
+                            NULL, NULL, 0);
+
+    (void)opaque;
+    *wait_errno = result == 0 ? 0 : errno;
+    return result;
+#else
+    g_assert_not_reached();
+#endif
+}
+
+static void qemu_plugin_crucible_idle_disarm_wait(void *opaque)
+{
+    QEMU_LOCK_GUARD(&qemu_plugin_crucible_idle_wait_lock);
+
+    (void)opaque;
+    g_assert(qemu_plugin_crucible_active_idle_wake_signal);
+    qemu_plugin_crucible_active_idle_wake_signal = NULL;
+}
+
+static bool qemu_plugin_crucible_idle_validate_cpu(void *opaque)
+{
+    QemuPluginCrucibleIdleWaitProduction *wait = opaque;
+
+    return qemu_plugin_crucible_idle_cpu_is_current_member(
+        wait->cpu, wait->vcpu_index, wait->cpu_list_generation);
+}
+
+static const QemuPluginCrucibleIdleWaitOps
+qemu_plugin_crucible_idle_wait_ops = {
+    .pin_cpu = qemu_plugin_crucible_idle_pin_cpu,
+    .unpin_cpu = qemu_plugin_crucible_idle_unpin_cpu,
+    .arm_wait = qemu_plugin_crucible_idle_arm_wait,
+    .unlock_bql = qemu_plugin_crucible_idle_unlock_bql,
+    .lock_bql = qemu_plugin_crucible_idle_lock_bql,
+    .wait = qemu_plugin_crucible_idle_raw_wait,
+    .disarm_wait = qemu_plugin_crucible_idle_disarm_wait,
+    .cpu_valid_after_wait = qemu_plugin_crucible_idle_validate_cpu,
+};
+
+static bool qemu_plugin_crucible_idle_wait_for_control_boundary(
+    QemuPluginCrucibleIdleWaitProduction *wait,
+    uint64_t observed_generation,
+    uint64_t *rr_target_generation,
+    bool *rr_target_bound)
+{
+    GPollFD wake_poll = {
+        .fd = qemu_plugin_wake_fd,
+        .events = G_IO_IN,
+    };
+    CPUState *cpu;
+    uint64_t current_icount = qemu_plugin_icount_raw();
+    bool wake_pending = false;
+    bool scheduler_clamped = crucible_sim_shmem_dispatch_registered() &&
+        current_icount >= crucible_sim_shmem_max_advance_icount();
+
+    uint64_t rr_complete_generation = qatomic_load_acquire(
+        &qemu_plugin_rr_control_complete_generation);
+    uint64_t rr_request_generation = qatomic_load_acquire(
+        &qemu_plugin_rr_control_request_generation);
+
+    if (!*rr_target_bound && rr_request_generation != rr_complete_generation) {
+        *rr_target_generation = rr_request_generation;
+        *rr_target_bound = true;
+    }
+    bool rr_request_pending = *rr_target_bound &&
+        rr_complete_generation < *rr_target_generation;
+
+    if (wake_poll.fd >= 0) {
+        int poll_status;
+
+        do {
+            poll_status = qemu_poll_ns(&wake_poll, 1, 0);
+        } while (poll_status < 0 && errno == EINTR);
+        wake_pending = poll_status > 0 && wake_poll.revents != 0;
+    }
+
+    if (!rr_request_pending && !wake_pending &&
+        qatomic_load_acquire(&qemu_plugin_control_boundary_generation) !=
+            observed_generation) {
+        return false;
+    }
+
+    if (!qemu_plugin_crucible_idle_cpu_is_current_member(
+            wait->cpu, wait->vcpu_index, wait->cpu_list_generation) ||
+        !runstate_is_running() ||
+        qemu_plugin_crucible_vmstop_pending()) {
+        return false;
+    }
+
+    CPU_FOREACH(cpu) {
+        if (qatomic_read(&cpu->stop) || qatomic_read(&cpu->stopped) ||
+            qatomic_read(&cpu->unplug)) {
+            return false;
+        }
+    }
+
+    if (rr_request_pending &&
+        qatomic_load_acquire(&qemu_plugin_rr_control_ack_generation) <
+            *rr_target_generation) {
+        qemu_plugin_crucible_rr_control_boundary_acknowledge();
+    }
+    if (!rr_request_pending && !scheduler_clamped && !wake_pending &&
+        !qatomic_load_acquire(&qemu_plugin_control_boundary_scheduled)) {
+        return false;
+    }
+
+    /*
+     * Single-thread RR control producers signal the canonical first CPU.
+     * Every idle callback must therefore park on that same condition.
+     */
+    g_assert(first_cpu);
+    qemu_cond_wait_bql(first_cpu->halt_cond);
+    return true;
+}
+
+enum qemu_plugin_crucible_idle_wait_status
+qemu_plugin_crucible_wait_idle_wake(unsigned int vcpu_index,
+                                    uint32_t *wake_signal,
+                                    uint32_t expected)
+{
+    CPUState *cpu = qemu_plugin_crucible_idle_callback_cpu;
+    QemuPluginCrucibleIdleWaitProduction wait = {
+        .cpu = cpu,
+        .vcpu_index = vcpu_index,
+    };
+    bool context_valid = cpu && qemu_plugin_crucible_idle_callback_depth == 1 &&
+        qemu_plugin_crucible_exact_boundary_depth == 1 && bql_locked() &&
+        icount_enabled() == ICOUNT_PRECISE &&
+        qemu_plugin_crucible_single_threaded_rr() &&
+        cpu->cpu_index == vcpu_index && cpu->created && !cpu->unplug &&
+        qemu_cpu_is_self(cpu) && QTAILQ_IN_USE(cpu, node);
+    bool rescan_required = false;
+    uint64_t control_boundary_generation = qatomic_load_acquire(
+        &qemu_plugin_control_boundary_generation);
+    uint64_t rr_target_generation = 0;
+    bool rr_target_bound = false;
+    int result_errno;
+    enum qemu_plugin_crucible_idle_wait_status status;
+#ifdef CONFIG_LINUX
+    const bool wait_supported = true;
+#else
+    const bool wait_supported = false;
+#endif
+
+    if (context_valid) {
+        wait.cpu_list_generation = cpu_list_generation_id_get();
+    }
+    status = qemu_plugin_crucible_idle_wait_once(
+        &qemu_plugin_crucible_idle_wait_issued, context_valid,
+        wait_supported, wake_signal, expected,
+        &qemu_plugin_crucible_idle_wait_ops, &wait, &rescan_required,
+        &result_errno);
+    while (context_valid &&
+           qemu_plugin_crucible_idle_wait_for_control_boundary(
+               &wait, control_boundary_generation, &rr_target_generation,
+               &rr_target_bound)) {
+        /* The completed boundary provides the authoritative scheduler wake. */
+    }
+    if (rescan_required) {
+        qemu_plugin_crucible_idle_callback_disposition =
+            QEMU_PLUGIN_CRUCIBLE_IDLE_CALLBACK_RESCAN;
+    }
+    errno = result_errno;
+    return status;
+}
+
+QemuPluginCrucibleIdleCallbackDisposition
+qemu_plugin_fire_vcpu_idle_cb(CPUState *cpu)
+{
+    qemu_plugin_vcpu_idle_resume_cb_t cb = qemu_plugin_vcpu_idle_resume_idle_cb;
+    bool outermost;
+
+    if (!cb || !cpu) {
+        return QEMU_PLUGIN_CRUCIBLE_IDLE_CALLBACK_COMPLETE;
+    }
+
+    outermost = qemu_plugin_crucible_idle_callback_depth == 0;
+    if (outermost) {
+        qemu_plugin_crucible_idle_callback_cpu = cpu;
+        qemu_plugin_crucible_idle_wait_issued = false;
+        qemu_plugin_crucible_idle_callback_disposition =
+            QEMU_PLUGIN_CRUCIBLE_IDLE_CALLBACK_COMPLETE;
+    }
+    g_assert(qemu_plugin_crucible_idle_callback_depth < UINT_MAX);
+    qemu_plugin_crucible_idle_callback_depth++;
+
+    qemu_plugin_crucible_exact_boundary_enter();
+    cb(cpu->cpu_index, qemu_plugin_icount_raw(),
+       qemu_plugin_vcpu_idle_resume_userdata);
+    qemu_plugin_crucible_exact_boundary_leave();
+
+    qemu_plugin_crucible_idle_callback_depth--;
+    if (outermost) {
+        QemuPluginCrucibleIdleCallbackDisposition disposition =
+            qemu_plugin_crucible_idle_callback_disposition;
+
+        qemu_plugin_crucible_idle_callback_cpu = NULL;
+        return disposition;
+    }
+    return qemu_plugin_crucible_idle_callback_disposition;
+}
+
+void qemu_plugin_fire_vcpu_resume_cb(CPUState *cpu)
+{
+    qemu_plugin_vcpu_idle_resume_cb_t cb = qemu_plugin_vcpu_idle_resume_resume_cb;
+
+    if (cb && cpu) {
+        g_assert(qemu_plugin_crucible_resume_callback_depth == 0);
+        qemu_plugin_crucible_resume_callback_cpu = cpu;
+        qemu_plugin_crucible_resume_callback_depth++;
+        qemu_plugin_crucible_exact_boundary_enter();
+        cb(cpu->cpu_index, qemu_plugin_icount_raw(),
+           qemu_plugin_vcpu_idle_resume_userdata);
+        qemu_plugin_crucible_exact_boundary_leave();
+        qemu_plugin_crucible_resume_callback_depth--;
+        qemu_plugin_crucible_resume_callback_cpu = NULL;
+    }
+}
+
+void qemu_plugin_register_control_boundary_cb(
+    qemu_plugin_vcpu_idle_resume_cb_t cb, void *userdata)
+{
+    qemu_plugin_control_boundary_userdata = userdata;
+    qemu_plugin_control_boundary_cb = cb;
+    if (cb) {
+        qemu_plugin_crucible_callback_registered(
+            0, QEMU_PLUGIN_CRUCIBLE_CALLBACK_CONTROL_BOUNDARY);
+    }
+}
+
+void qemu_plugin_register_rr_handoff_cb(qemu_plugin_rr_handoff_cb_t cb,
+                                        void *userdata)
+{
+    qemu_plugin_rr_handoff_cb = cb;
+    qemu_plugin_rr_handoff_userdata = userdata;
+    if (cb) {
+        qemu_plugin_crucible_callback_registered(
+            0, QEMU_PLUGIN_CRUCIBLE_CALLBACK_RR_HANDOFF);
+    }
+}
+
+void qemu_plugin_fire_rr_handoff_cb(unsigned int from_vcpu,
+                                    unsigned int to_vcpu,
+                                    uint64_t rr_switch_quantum,
+                                    uint64_t source_retired_delta)
+{
+    if (qemu_plugin_rr_handoff_cb) {
+        qemu_plugin_rr_handoff_cb(from_vcpu, to_vcpu, rr_switch_quantum,
+                                  source_retired_delta,
+                                  qemu_plugin_rr_handoff_userdata);
+    }
+}
+
+void qemu_plugin_fire_control_boundary_cb(CPUState *cpu)
+{
+    qemu_plugin_vcpu_idle_resume_cb_t cb = qemu_plugin_control_boundary_cb;
+
+    if (cb && cpu) {
+        uint64_t observed_icount = qemu_plugin_icount_raw();
+
+        g_assert(qemu_plugin_crucible_control_boundary_depth < UINT_MAX);
+        qemu_plugin_crucible_control_boundary_depth++;
+        qemu_plugin_crucible_exact_boundary_enter();
+        cb(cpu->cpu_index, observed_icount,
+           qemu_plugin_control_boundary_userdata);
+        qemu_plugin_crucible_exact_boundary_leave();
+        qemu_plugin_crucible_control_boundary_depth--;
+    }
+}
+
+int qemu_plugin_crucible_fault_dispatch_node_boundary(uint64_t raw_icount)
+{
+    if (!qemu_plugin_crucible_control_boundary_active() ||
+        !qemu_plugin_crucible_exact_boundary_active() ||
+        !bql_locked() || qemu_plugin_icount_raw() != raw_icount) {
+        return -EPERM;
+    }
+
+    if (qemu_crucible_fault_has_pending_at_or_before(
+            CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY, raw_icount)) {
+        qemu_crucible_fault_dispatch_boundary(
+            CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY, raw_icount);
+    }
+    return qemu_plugin_icount_raw() == raw_icount ? 0 : -EIO;
+}
+
+static NetClientState *qemu_plugin_default_nic_queue(void)
+{
+    NetClientState *nc;
+
+    QTAILQ_FOREACH(nc, &net_clients, next) {
+        if (nc->info->type == NET_CLIENT_DRIVER_NIC && nc->queue_index == 0) {
+            return nc;
+        }
+    }
+
+    return NULL;
+}
+
+static bool qemu_plugin_valid_net_payload(const uint8_t *data, size_t len)
+{
+    return data != NULL && len > 0 && len <= INT_MAX;
+}
+
+int qemu_plugin_net_inject(const uint8_t *data, size_t len)
+{
+    NetClientState *nc;
+    ssize_t delivered;
+
+    if (!qemu_plugin_valid_net_payload(data, len)) {
+        return -1;
+    }
+
+    nc = qemu_plugin_default_nic_queue();
+    if (nc == NULL || nc->link_down) {
+        return -1;
+    }
+
+    /*
+     * qemu_receive_packet() sets receive_disabled when the device reports
+     * backpressure.  The ordinary QEMU send path later clears that latch
+     * while flushing its private packet queue.  Crucible deliberately leaves
+     * ownership in canonical shared memory instead, so each explicit retry
+     * must re-probe the device rather than inherit a latch whose queue is
+     * intentionally empty.
+     */
+    nc->receive_disabled = 0;
+    delivered = qemu_receive_packet(nc, data, (int)len);
+    if (delivered == (ssize_t)len) {
+        return 0;
+    }
+    if (delivered == 0) {
+        return 1;
+    }
+    return -1;
+}
+
+int64_t qemu_plugin_clock_deadline_ns(void)
+{
+    int64_t delta = qemu_clock_deadline_ns_all(QEMU_CLOCK_VIRTUAL,
+                                              QEMU_TIMER_ATTR_ALL);
+
+    if (delta < 0) {
+        return -1;
+    }
+    return qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + delta;
+}
+
+int qemu_plugin_crucible_arm_virtual_timer_witness(
+    int64_t deadline_ns, uint64_t deadline_icount, uint64_t *generation)
+{
+    CPUState *cpu = qemu_plugin_crucible_idle_callback_cpu;
+    int64_t current_deadline;
+    int64_t current_virtual_ns;
+    uint64_t raw_icount;
+    int result;
+
+    if (!generation || deadline_ns < 0) {
+        return -EINVAL;
+    }
+    *generation = 0;
+    if (!cpu || qemu_plugin_crucible_idle_callback_depth != 1 ||
+        qemu_plugin_crucible_exact_boundary_depth != 1 || !bql_locked() ||
+        icount_enabled() != ICOUNT_PRECISE ||
+        !qemu_plugin_crucible_single_threaded_rr() ||
+        !qemu_cpu_is_self(cpu)) {
+        return -EPERM;
+    }
+
+    current_deadline = qemu_plugin_clock_deadline_ns();
+    current_virtual_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    raw_icount = qemu_plugin_icount_raw();
+    if (current_deadline < 0 || deadline_ns != current_deadline) {
+        return -ESTALE;
+    }
+    if (deadline_ns <= current_virtual_ns) {
+        return -ERANGE;
+    }
+
+    qemu_mutex_lock(&qemu_plugin_crucible_virtual_timer_witness_lock);
+    result = qemu_plugin_crucible_virtual_timer_witness_arm(
+        &qemu_plugin_crucible_virtual_timer_witness_state,
+        deadline_ns, deadline_icount, raw_icount, generation);
+    qemu_mutex_unlock(&qemu_plugin_crucible_virtual_timer_witness_lock);
+    return result;
+}
+
+int qemu_plugin_crucible_query_virtual_timer_witness(
+    uint64_t generation,
+    struct qemu_plugin_crucible_virtual_timer_witness *witness)
+{
+    int result;
+
+    if (!witness) {
+        return -EINVAL;
+    }
+    memset(witness, 0, sizeof(*witness));
+    if (!qemu_plugin_time_advance_callback_active ||
+        qemu_plugin_crucible_exact_boundary_depth != 1 || !bql_locked() ||
+        !qemu_plugin_time_advance_is_pending()) {
+        return -EPERM;
+    }
+
+    qemu_mutex_lock(&qemu_plugin_crucible_virtual_timer_witness_lock);
+    result = qemu_plugin_crucible_virtual_timer_witness_query(
+        &qemu_plugin_crucible_virtual_timer_witness_state,
+        generation, witness);
+    qemu_mutex_unlock(&qemu_plugin_crucible_virtual_timer_witness_lock);
+    return result;
+}
+
+static uint64_t qemu_plugin_crucible_virtual_timer_witness_begin(
+    int64_t expire_ns, int64_t virtual_ns)
+{
+    uint64_t generation = 0;
+
+    qemu_mutex_lock(&qemu_plugin_crucible_virtual_timer_witness_lock);
+    qemu_plugin_crucible_virtual_timer_witness_state_begin(
+        &qemu_plugin_crucible_virtual_timer_witness_state,
+        expire_ns, virtual_ns, qemu_plugin_icount_raw(), &generation);
+    qemu_mutex_unlock(&qemu_plugin_crucible_virtual_timer_witness_lock);
+    return generation;
+}
+
+static void qemu_plugin_crucible_virtual_timer_witness_complete(
+    uint64_t generation)
+{
+    if (generation == 0) {
+        return;
+    }
+
+    qemu_mutex_lock(&qemu_plugin_crucible_virtual_timer_witness_lock);
+    qemu_plugin_crucible_virtual_timer_witness_state_complete(
+        &qemu_plugin_crucible_virtual_timer_witness_state, generation);
+    qemu_mutex_unlock(&qemu_plugin_crucible_virtual_timer_witness_lock);
+}
