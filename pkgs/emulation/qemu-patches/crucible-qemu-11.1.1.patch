+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Compile actual checked QOM pin and first-region custody/return bodies.
+
+The owner is a real ordinary QOM allocation. Region, RAMBlock and section
+records are factual component inputs, without initialized topology, realized
+RAM or Source enrollment. The real foreign thread changes the QOM reference
+between the actual load and compare/exchange. The positive refuses the factual
+IOMMU callback; a gate omission deliberately enters its refusal. Ordinary input
+allocation/cleanup provides no selected funding or allocator backing-return
+receipt. The real resize admission/enrollment/removal bodies use an ordinary
+component mutex in place of the initialized machine's RAM-list mutex. A real
+foreign thread holds resize admission, and a real forked process cannot return
+the parent cursor. The full resize body/notifiers do not run. No accepting
+Source, read, RAM mapping or device destruction runs.
+"""
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import runpy
+import shlex
+import subprocess
+
+
+PREFIX = r'''
+#define COMPILING_PER_TARGET
+#define CONFIG_TARGET "x86_64-softmmu-config-target.h"
+#include "qemu/osdep.h"
+#include <sys/wait.h>
+#include <sys/prctl.h>
+#include "exec/target_page.h"
+#include "qemu/module.h"
+#include "qemu/main-loop.h"
+#include "system/memory.h"
+#include "system/memory-internal.h"
+#include "system/ramblock.h"
+
+static QemuMutex component_ram_mutex;
+
+void qemu_mutex_lock_ramlist(void)
+{
+    qemu_mutex_lock(&component_ram_mutex);
+}
+
+void qemu_mutex_unlock_ramlist(void)
+{
+    qemu_mutex_unlock(&component_ram_mutex);
+}
+
+static bool component_bql, racing, expect_rcu;
+static pthread_barrier_t loaded, changed;
+static Object *race_owner;
+
+static bool component_bql_locked(void)
+{
+    return component_bql;
+}
+
+static uint32_t read_reference(uint32_t *references)
+{
+    uint32_t value = qatomic_read(references);
+
+    if (expect_rcu) {
+        assert(get_ptr_rcu_reader()->depth > 0);
+    }
+    if (racing) {
+        pthread_barrier_wait(&loaded);
+        pthread_barrier_wait(&changed);
+    }
+    return value;
+}
+
+static void *change_reference(void *unused)
+{
+    pthread_barrier_wait(&loaded);
+    object_ref(race_owner);
+    pthread_barrier_wait(&changed);
+    return NULL;
+}
+
+#define bql_locked component_bql_locked
+#define object_ref_once component_object_ref_once
+'''
+
+
+TRANSLATION_CHECKS = r'''
+static void *foreign_resize_writer(void *opaque)
+{
+    assert(ram_read_resize_begin(opaque) == 0);
+    pthread_barrier_wait(&loaded);
+    pthread_barrier_wait(&changed);
+    ram_read_resize_end();
+    return NULL;
+}
+
+static void *foreign_resize_return(void *opaque)
+{
+    assert(memory_region_read_resize_return(opaque) == -EPERM);
+    return NULL;
+}
+
+static int forbidden_iommu_index(IOMMUMemoryRegion *iommu, MemTxAttrs attrs)
+{
+    assert(!"unsupported IOMMU attrs_to_index entered");
+    return 0;
+}
+
+static void component_region_class_init(ObjectClass *klass, const void *data)
+{
+    ((IOMMUMemoryRegionClass *)klass)->attrs_to_index = forbidden_iommu_index;
+}
+
+static void check_translation(Object *owner, MemoryRegion *region)
+{
+    FlatView view = { 0 };
+    MemoryRegionSection sections[2] = {
+        { .mr = &io_mem_unassigned },
+        { .mr = region, .size = int128_make64(4096) },
+    };
+    AddressSpaceDispatch dispatch = {
+        .mru_section = &sections[1],
+        .phys_map = { .ptr = 1 },
+        .map = { .sections_nb = 2, .sections = sections },
+    };
+    MemoryRegionReadCustody custody = { 0 };
+    RAMBlock block = { .mr = region, .used_length = 4096, .max_length = 8192 };
+    hwaddr offset, length = 5;
+    AddressSpace *target = NULL;
+    MemoryRegionSection translated;
+
+    view.dispatch = &dispatch;
+    region->owner = owner;
+    region->ram = true;
+    region->ram_block = &block;
+    component_bql = true;
+    expect_rcu = true;
+    assert(flatview_read_first_chunk_custody(&view, 4094, 0,
+        MEMTXATTRS_UNSPECIFIED, &custody) == -EPERM);
+    assert(!custody.attempted && !custody.owner);
+    assert(flatview_read_first_chunk_custody(&view, UINT64_MAX, 5,
+        MEMTXATTRS_UNSPECIFIED, &custody) == -EPERM);
+    assert(!custody.attempted && !custody.owner);
+    custody.attempted = true;
+    assert(flatview_read_first_chunk_custody(&view, 4094, 5,
+        MEMTXATTRS_UNSPECIFIED, &custody) == -EPERM);
+    assert(!custody.owner && owner->ref == 1 && OBJECT(region)->ref == 1);
+    custody = (MemoryRegionReadCustody) { 0 };
+    assert(flatview_read_first_chunk_custody(&view, 4094, 5,
+        MEMTXATTRS_UNSPECIFIED, &custody) == -ENOTSUP);
+    assert(custody.attempted && custody.translated);
+    assert(custody.view == &view && custody.region == region);
+    assert(custody.address == 4094 && custody.region_offset == 4094);
+    assert(custody.length == 2 && custody.ram_block == &block);
+    assert(owner->ref == 2 && OBJECT(region)->ref == 2);
+    assert(custody.resize_attempted && custody.resize_acquired);
+    assert(custody.resize_canonical == &custody && custody.resize_serial);
+    {
+        RAMBlock unrelated = { 0 };
+        MemoryRegionReadCustody copied = custody;
+        pthread_t foreign;
+        pid_t child;
+        int status;
+
+        assert(ram_read_resize_begin(&block) == -EBUSY);
+        assert(ram_read_resize_begin(&unrelated) == 0);
+        ram_read_resize_end();
+        assert(memory_region_read_resize_return(&copied) == -EPERM);
+        assert(pthread_create(&foreign, NULL, foreign_resize_return, &custody) == 0);
+        assert(pthread_join(foreign, NULL) == 0);
+        child = fork();
+        assert(child >= 0);
+        if (!child) {
+            _exit(memory_region_read_resize_return(&custody) == -EPERM ? 0 : 1);
+        }
+        assert(waitpid(child, &status, 0) == child);
+        assert(WIFEXITED(status) && WEXITSTATUS(status) == 0);
+        assert(ram_read_resize_begin(&block) == -EBUSY);
+    }
+    assert(flatview_read_first_chunk_custody(&view, 4094, 5,
+        MEMTXATTRS_UNSPECIFIED, &custody) == -EPERM);
+    assert(owner->ref == 2 && OBJECT(region)->ref == 2);
+    assert(memory_region_read_custody_return(&custody) == 0);
+    assert(owner->ref == 1 && OBJECT(region)->ref == 1);
+
+    {
+        MemoryRegionReadCustody copied = custody;
+        uint64_t saved_serial = ram_read_resize_registry.serial;
+
+        assert(custody.resize_return_attempted && custody.resize_returned);
+        assert(memory_region_read_resize_return(&copied) == -EPERM);
+        assert(ram_read_resize_begin(&block) == 0);
+        custody = (MemoryRegionReadCustody) { 0 };
+        assert(flatview_read_first_chunk_custody(&view, 0, 5,
+            MEMTXATTRS_UNSPECIFIED, &custody) == -EBUSY);
+        assert(custody.resize_attempted && !custody.resize_acquired);
+        assert(owner->ref == 2 && OBJECT(region)->ref == 2);
+        assert(memory_region_read_custody_return(&custody) == 0);
+        ram_read_resize_end();
+        {
+            pthread_t foreign;
+
+            pthread_barrier_init(&loaded, NULL, 2);
+            pthread_barrier_init(&changed, NULL, 2);
+            assert(pthread_create(&foreign, NULL, foreign_resize_writer, &block) == 0);
+            pthread_barrier_wait(&loaded);
+            custody = (MemoryRegionReadCustody) { 0 };
+            assert(flatview_read_first_chunk_custody(&view, 0, 5,
+                MEMTXATTRS_UNSPECIFIED, &custody) == -EBUSY);
+            assert(!custody.resize_acquired && custody.reference_acquired);
+            assert(memory_region_read_custody_return(&custody) == 0);
+            pthread_barrier_wait(&changed);
+            assert(pthread_join(foreign, NULL) == 0);
+            pthread_barrier_destroy(&loaded);
+            pthread_barrier_destroy(&changed);
+            assert(!ram_read_resize_registry.writers);
+        }
+        ram_read_resize_registry.writers = UINT64_MAX;
+        assert(ram_read_resize_begin(&block) == -EOVERFLOW);
+        assert(ram_read_resize_registry.writers == UINT64_MAX);
+        ram_read_resize_registry.writers = 0;
+        custody = (MemoryRegionReadCustody) { 0 };
+        ram_read_resize_registry.serial = UINT64_MAX;
+        assert(flatview_read_first_chunk_custody(&view, 0, 5,
+            MEMTXATTRS_UNSPECIFIED, &custody) == -EOVERFLOW);
+        assert(!custody.resize_serial && !custody.resize_acquired);
+        assert(memory_region_read_custody_return(&custody) == 0);
+        ram_read_resize_registry.serial = saved_serial;
+        custody = (MemoryRegionReadCustody) { 0 };
+        block.used_length = 4095;
+        assert(flatview_read_first_chunk_custody(&view, 4094, 5,
+            MEMTXATTRS_UNSPECIFIED, &custody) == -ESTALE);
+        assert(custody.length == 2 && !custody.resize_acquired);
+        assert(memory_region_read_custody_return(&custody) == 0);
+        block.used_length = 4096;
+    }
+
+    /* The ordinary translation wrapper shares the exact dispatch body without
+     * acquiring these extra references or changing its successful geometry. */
+    rcu_read_lock();
+    translated = flatview_do_translate(&view, 4094, &offset, &length, NULL,
+                                        false, true, &target,
+                                        MEMTXATTRS_UNSPECIFIED);
+    rcu_read_unlock();
+    assert(translated.mr == region && offset == 4094 && length == 2);
+    assert(owner->ref == 1 && OBJECT(region)->ref == 1);
+
+    custody = (MemoryRegionReadCustody) { 0 };
+    region->ram = false;
+    region->is_iommu = true;
+    assert(flatview_read_first_chunk_custody(&view, 0, 5,
+        MEMTXATTRS_UNSPECIFIED, &custody) == -ENOTSUP);
+    assert(custody.attempted && custody.translated);
+    assert(!custody.reference_attempted && !custody.owner);
+    assert(owner->ref == 1 && OBJECT(region)->ref == 1);
+    assert(memory_region_read_custody_return(&custody) == 0);
+    region->is_iommu = false;
+    custody = (MemoryRegionReadCustody) { 0 };
+    assert(flatview_read_first_chunk_custody(&view, 4094, 5,
+        MEMTXATTRS_UNSPECIFIED, &custody) == -ENOTSUP);
+    assert(custody.length == 5 && !custody.ram_block);
+    assert(owner->ref == 2 && OBJECT(region)->ref == 2);
+    assert(memory_region_read_custody_return(&custody) == 0);
+    assert(owner->ref == 1 && OBJECT(region)->ref == 1);
+    expect_rcu = false;
+}
+'''
+
+
+MAIN = r'''
+static const TypeInfo owner_type = {
+    .name = "region-custody-component-owner",
+    .parent = TYPE_OBJECT,
+    .instance_size = sizeof(Object),
+};
+
+static const TypeInfo region_type = {
+    .name = "region-custody-component-region",
+    .parent = TYPE_OBJECT,
+    .instance_size = sizeof(MemoryRegion),
+    .class_size = sizeof(IOMMUMemoryRegionClass),
+    .class_init = component_region_class_init,
+};
+
+int main(void)
+{
+    Object *owner, *out = NULL;
+    Object invalid = { 0 };
+    MemoryRegion *region;
+    RAMBlock block = { 0 };
+    MemoryRegionSection section = { 0 };
+    MemoryRegionReadCustody custody = { 0 };
+    pthread_t worker;
+
+    /* Intentional assertion mutants must not start an external core writer. */
+    assert(prctl(PR_SET_DUMPABLE, 0) == 0);
+    assert(prctl(PR_GET_DUMPABLE) == 0);
+
+    qemu_mutex_init(&component_ram_mutex);
+    assert(qemu_crucible_ram_read_resize_storage_bytes() ==
+           sizeof(ram_read_resize_registry));
+    module_call_init(MODULE_INIT_QOM);
+    type_register_static(&owner_type);
+    type_register_static(&region_type);
+    owner = object_new(owner_type.name);
+    region = (MemoryRegion *)object_new(region_type.name);
+    section.mr = region;
+    assert(owner->ref == 1);
+
+    assert(object_ref_once(owner, &out) == 0);
+    assert(out == owner && owner->ref == 2);
+    assert(object_ref_once(owner, &out) == -EPERM && out == owner);
+    object_unref(out);
+    out = NULL;
+    assert(owner->ref == 1);
+    assert(object_ref_once(&invalid, &out) == -ESTALE && !out);
+    invalid.ref = INT_MAX;
+    assert(object_ref_once(&invalid, &out) == -EOVERFLOW && !out);
+    invalid.ref = UINT_MAX;
+    assert(object_ref_once(&invalid, &out) == -EOVERFLOW && !out);
+
+    race_owner = owner;
+    pthread_barrier_init(&loaded, NULL, 2);
+    pthread_barrier_init(&changed, NULL, 2);
+    racing = true;
+    assert(pthread_create(&worker, NULL, change_reference, NULL) == 0);
+    assert(object_ref_once(owner, &out) == -EAGAIN);
+    pthread_join(worker, NULL);
+    racing = false;
+    assert(!out && owner->ref == 2);
+    object_unref(owner);
+    pthread_barrier_destroy(&loaded);
+    pthread_barrier_destroy(&changed);
+    assert(owner->ref == 1);
+
+    region->owner = owner;
+    region->ram = true;
+    region->ram_block = &block;
