+               payload->module_borrow != payload->issued_borrow ||
+               payload->serial != payload->issued_serial || callback_status >= 0) {
+        validation = -EPROTO;
+        payload->uncertain = true;
+    }
+    if (callback_status > 0) {
+        validation = -EPROTO;
+        payload->uncertain = true;
