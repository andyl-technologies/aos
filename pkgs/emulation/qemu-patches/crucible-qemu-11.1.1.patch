+#define CRUCIBLE_NODE_FAULT_FIELD_P3 3
+#define CRUCIBLE_NODE_FAULT_FIELD_P4 4
+#define CRUCIBLE_NODE_FAULT_OPERATION_APPLY 1
+#define QEMU_CRUCIBLE_MODEL_PHASE_AFTER_INSTRUCTION 12
+#define CRUCIBLE_FAULT_EVENT_OUTCOME_APPLIED 1
+#define CRUCIBLE_FAULT_EVENT_OUTCOME_ERROR 2
+
+typedef struct QemuCrucibleFaultHandler QemuCrucibleFaultHandler;
+typedef struct QemuCrucibleFaultRule QemuCrucibleFaultRule;
+typedef void (*QemuCrucibleFaultBoundaryObserverFn)(uint16_t, uint64_t);
+typedef uint64_t (*QemuCrucibleFaultBoundaryDeadlineFn)(uint16_t);
+
+/* Prototypes retain public function diagnostics in this bounded translation. */
+void qemu_plugin_crucible_exact_boundary_enter(void);
+void qemu_plugin_crucible_exact_boundary_leave(void);
+void qemu_crucible_fault_registry_seal(void);
+void qemu_crucible_fault_dispatch_boundary(uint16_t, uint64_t);
+bool qemu_crucible_fault_has_pending_at_or_before(uint16_t, uint64_t);
