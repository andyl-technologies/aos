+int qemu_crucible_parent_park_return_main_v1(
+    const QemuCrucibleParkBinding *binding, QemuCrucibleNativeParkRequest *request)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleParentParkReceive *owner = &startup_source.parent_park_receive;
+    QemuCrucibleParentParkLoan *loan = &startup_source.parent_park_loan;
+    QemuCrucibleNativeParkRequestView view;
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    int status = parent_park_main_identity(true);
+
+    if (status || !binding) {
+        return status ? status : -EINVAL;
+    }
+    status = parent_park_receive_identity(owner);
+    if (status || !parent_park_binding_equal(binding, &owner->binding) ||
+        monitor_cur() != owner->monitor ||
+        !monitor_qmp_connection_watch_valid(owner->monitor, owner->connection_epoch) ||
+        owner->busy || owner->creating ||
+        owner->terminal_published) {
+        return status ? status : -EPERM;
+    }
+    if (loan->transition_busy || loan->callback_request ||
+        loan->callback_invocation || loan->callback || loan->callback_userdata) {
+        return -EBUSY;
+    }
+    if (owner->terminal_ready) {
+        goto publish;
+    }
+    status = qemu_crucible_native_park_handler_outcome(request, owner, &view);
+    if (!status) {
+        status = qemu_crucible_native_park_request_returned(request, view.loan);
+    }
+    if (status) {
+        return status;
+    }
+    if (!owner->prepared_returned) {
+        owner->terminal_operation_status = view.operation_status ?
+            view.operation_status : view.first_status;
+        owner->terminal_physical_status = view.physical_status;
+        owner->terminal_native_generation = view.native_generation;
+        parent_park_fail(owner, owner->terminal_operation_status, false);
+        parent_park_fail(owner, view.post_status, true);
+    }
+    if (owner->metadata_users) {
+        return -EBUSY;
+    }
+    if (!owner->final_posts_observed) {
+        /* Both raw final observations happen even after earlier failure. They
+         * describe the whole entered lifetime, before any original alias goes. */
+        parent_park_pair_raw_post(owner);
+        memcpy(owner->final_original_post, owner->original_post,
+               sizeof(owner->final_original_post));
+        owner->final_posts_observed = true;
+    }
+    if (!owner->prepared_returned) {
+        if (loan->held) {
+            status = qemu_crucible_parent_park_prepared_identity_v1(loan);
+            if (status) {
+                return status;
+            }
+            loan->held = false;
+            owner->borrowers--;
+        } else if (loan->issued || owner->borrowers) {
+            return -ESTALE;
+        }
+        if (loan->ctx_retained) {
+            loan->ctx_retained = false;
+            plugin_ctx_callback_release(owner->installer.ctx);
+        }
+        owner->prepared_returned = true;
+    }
+    if (!owner->descriptors_returned) {
+        int *descriptors[] = {
+            &owner->basis_fd, &owner->cancellation_fd, &owner->metadata_fd,
+        };
+
+        if (owner->metadata_close_uncertain) {
+            return -EBUSY;
+        }
+        for (size_t index = 0; index < G_N_ELEMENTS(descriptors); index++) {
+            if (*descriptors[index] >= 0) {
+                int descriptor = *descriptors[index];
+
+                /* Linux close consumes the descriptor even on EINTR. Never
+                 * retry its numeric value after a failure or possible reuse. */
+                *descriptors[index] = -1;
+                if (close(descriptor) < 0) {
+                    owner->metadata_close_uncertain = true;
+                    owner->terminal_physical_status = -errno;
+                    return -errno;
+                }
+            }
+        }
+        owner->descriptors_returned = true;
+    }
+    if (!owner->request_returned) {
+        if (!owner->main_request_received || !owner->request_borrow) {
+            return -ENOKEY;
+        }
+        status = qemu_crucible_qmp_borrow_end(&owner->request_borrow);
+        if (status) {
+            return status;
+        }
+        owner->request_returned = true;
+    }
+    qemu_mutex_lock(&commands->mutex);
+    status = command_member_identity_locked(owner->member);
+    if (!status && (owner->member->park_request_users != 1 ||
+                    owner->member->park_writer_users || owner->borrowers ||
+                    owner->metadata_users)) {
+        status = -EBUSY;
+    }
+    if (!status) {
+        owner->member->park_request_users--;
+        owner->terminal_ready = true;
+    }
+    qemu_mutex_unlock(&commands->mutex);
+    if (status) {
+        return status;
+    }
+publish:
+    /* The exact Monitor remains pinned for this sole writer. Any uncertain
+     * publication retains that pin and the writer's own member dependency. */
+    status = qemu_crucible_parent_park_terminal_write_v2(owner);
+    if (owner->terminal_published && !owner->member->park_writer_users) {
+        Monitor *monitor = owner->monitor;
+        int closed;
+
+        owner->monitor = NULL;
+        bql_lock();
+        object_unref(OBJECT(monitor));
+        bql_unlock();
+        owner->monitor_released = true;
+        closed = parent_park_record_local_closure(request);
+
+        if (!status) {
+            status = closed;
+        }
+    }
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+#ifdef CONFIG_LINUX
+/* Identity-only audit of the old request after its last callback and Monitor
+ * reference release. No clock, publisher callback or new Original is involved. */
+static int parent_park_local_closed(QemuCrucibleNativeParkRequest *request)
+{
+    QemuCrucibleParentParkReceive *owner = &startup_source.parent_park_receive;
+    QemuCrucibleParentParkLoan *loan = &startup_source.parent_park_loan;
+    QemuCrucibleParentParkMetadataOwner *metadata = &startup_source.parent_park_metadata;
+    QemuCrucibleCommandConsumerMember *member = &startup_source.command_member;
+    QemuCrucibleParkReturnWriterRole *writer = &member->park_writer;
+    QemuCrucibleNativeParkRequestView view;
+    int status;
+
+    if (owner->process != getpid() || !qemu_thread_is_self(&owner->thread) ||
+        !startup_source.standing.retained ||
+        !startup_source.runtime_purpose.charge.held ||
+        owner->busy || owner->creating || !owner->terminal_ready ||
+        !owner->terminal_published || !owner->final_posts_observed ||
+        !owner->descriptors_returned || !owner->prepared_returned ||
+        !owner->request_returned || !owner->monitor_released ||
+        owner->request_borrow || owner->monitor || owner->borrowers ||
+        owner->metadata_users || owner->metadata_close_uncertain ||
+        owner->basis_fd >= 0 || owner->cancellation_fd >= 0 || owner->metadata_fd >= 0 ||
+        loan->held || loan->ctx_retained || loan->transition_busy ||
+        (metadata->attempted && (!metadata->returned || metadata->held ||
+                                metadata->busy || metadata->charge.held))) {
+        return -EBUSY;
+    }
+    status = qemu_crucible_native_park_handler_outcome(request, owner, &view);
+    if (!status) {
+        status = qemu_crucible_native_park_request_returned(request, view.loan);
+    }
+    if (status) {
+        return status;
+    }
+    qemu_mutex_lock(&startup_source.commands.mutex);
+    status = command_member_identity_locked(member);
+    if (!status && (member->park_request_users || member->park_writer_users ||
+                    writer->receive != owner || writer->invoking || writer->uncertain ||
+                    !writer->attempted || writer->validation_status ||
+                    !writer->progress.write_attempted ||
+                    !writer->progress.return_published ||
+                    !writer->progress.writer_released ||
+                    writer->progress.publication_uncertain)) {
+        status = -EBUSY;
+    }
+    qemu_mutex_unlock(&startup_source.commands.mutex);
+    return status;
+}
+
+static int parent_park_record_local_closure(QemuCrucibleNativeParkRequest *request)
+{
+    QemuCrucibleParentParkReceive *owner = &startup_source.parent_park_receive;
+    QemuCrucibleParentParkClosure *closure = &startup_source.parent_park_closure;
+    QemuCrucibleParkReturnWriterRole *writer = &owner->member->park_writer;
+    QemuCrucibleNativeParkRequestView view;
+    uint64_t completed;
+    int first;
+    int post;
+    int status = parent_park_local_closed(request);
+
+    if (status || owner->local_closed) {
+        return status;
+    }
+    if (closure->completed_requests == UINT64_MAX ||
+        (closure->completed_requests &&
+         owner->binding.loan_sequence <= closure->binding.loan_sequence)) {
+        return -EOVERFLOW;
+    }
+    status = qemu_crucible_native_park_handler_outcome(request, owner, &view);
+    if (status) {
+        return status;
+    }
+    completed = closure->completed_requests + 1;
+    first = closure->lifetime_first_status ? closure->lifetime_first_status :
+        owner->first_status;
+    post = closure->lifetime_post_status ? closure->lifetime_post_status :
+        owner->post_status ? owner->post_status : writer->progress.post_status;
+    *closure = (QemuCrucibleParentParkClosure) {
+        .binding = owner->binding,
+        .completed_requests = completed,
+        .stopped_generation = owner->stopped_generation,
+        .native_generation = view.native_generation,
+        .plugin_owner_generation = view.plugin_owner_generation,
+        .connection_epoch = owner->connection_epoch,
+        .first_status = owner->first_status,
+        .post_status = owner->post_status,
+        .operation_status = owner->terminal_operation_status,
+        .physical_status = owner->terminal_physical_status,
+        .final_original_post = {
+            owner->final_original_post[0], owner->final_original_post[1],
+        },
+        .writer_status = writer->callback_status,
+        .writer_first_status = writer->progress.first_status,
+        .writer_post_status = writer->progress.post_status,
+        .lifetime_first_status = first,
+        .lifetime_post_status = post,
+    };
+    owner->local_closed = true;
+    return 0;
+}
+#endif
+
+int qemu_crucible_parent_park_closure_observe_v1(
+    const QemuCrucibleParkBinding *binding, QemuCrucibleNativeParkRequest *request,
+    QemuCrucibleParentParkClosure *out)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleParentParkClosure *closure = &startup_source.parent_park_closure;
+    QemuCrucibleQmpAllocationOwner *current = NULL;
+    int status = parent_park_main_identity(false);
+
+    if (status || !bql_locked() || !binding ||
+        parent_park_source_overlap(out, sizeof(*out))) {
+        return status ? status : -EPERM;
+    }
+    status = qemu_crucible_qmp_scope_identity_current(&current);
+    if (status || !current || !monitor_cur() ||
+        !startup_source.parent_park_receive.local_closed ||
+        !closure->completed_requests ||
+        !parent_park_binding_equal(binding, &closure->binding)) {
+        return status ? status : -ESTALE;
+    }
+    status = parent_park_local_closed(request);
+    if (!status) {
+        *out = *closure;
+    }
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_crucible_parent_park_rearm_main_v1(
+    const QemuCrucibleParkBinding *binding, QemuCrucibleNativeParkRequest *request)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleParentParkReceive *owner = &startup_source.parent_park_receive;
+    QemuCrucibleParentParkClosure *closure = &startup_source.parent_park_closure;
+    QemuCrucibleCommandConsumerMember *member = &startup_source.command_member;
+    QemuCrucibleParkReturnWriterRole *writer = &member->park_writer;
+    QemuCrucibleQmpAllocationOwner *current = NULL;
+    const QemuCrucibleBoundaryParkRecord *publication;
+    int status = parent_park_main_identity(false);
+
+    if (status || !bql_locked() || !binding || !owner->local_closed ||
+        !closure->completed_requests) {
+        return status ? status : -EBUSY;
+    }
+    if (parent_park_source_overlap(binding, sizeof(*binding))) {
+        return -EINVAL;
+    }
+    status = qemu_crucible_qmp_scope_identity_current(&current);
+    if (!status && !current) {
+        status = -ENOKEY;
+    }
+    if (!status) {
+        status = parent_park_local_closed(request);
+    }
+    if (status) {
+        return status;
+    }
+    if (binding->loan_sequence <= closure->binding.loan_sequence ||
+        binding->request_correlation <= closure->binding.request_correlation) {
+        return -EALREADY;
+    }
+    /* Read the actual retained publisher before erasing even a closed holder.
+     * A fresh numeric tuple, cleared flags or changed tail cannot issue it. */
+    owner->busy = true;
+    bql_unlock();
+    status = standing_boundary();
+    publication = &startup_source.standing.current.park;
+    if (!status && (!publication->present || publication->dirty ||
+                    publication->primary_count != 2 ||
+                    publication->born_mask !=
+                        (1U << publication->planned_count) - 1 ||
+                    publication->projected_mask != publication->born_mask ||
+                    !parent_park_binding_equal(binding, &publication->binding))) {
+        status = -ESTALE;
+    }
+    bql_lock();
+    owner->busy = false;
+    if (status) {
+        return status;
+    }
+    status = parent_park_local_closed(request);
+    if (status) {
+        return status;
+    }
+    qemu_mutex_lock(&startup_source.commands.mutex);
+    status = command_member_live_locked(member);
+    if (!status && (member->park_request_users || member->park_writer_users ||
+                    writer->invoking || writer->uncertain)) {
+        status = -EBUSY;
+    }
+    if (!status) {
+        /* Only the proven closed request holders reset. The real registered
+         * writer/member, Source standing owner, fixed floor, bank and lifetime
+         * closure/error/replay journal remain independently retained. */
+        *writer = (QemuCrucibleParkReturnWriterRole) {
+            .member = writer->member,
+            .callback = writer->callback,
+            .born = writer->born,
+        };
+        startup_source.parent_park_metadata =
+            (QemuCrucibleParentParkMetadataOwner) { 0 };
+        startup_source.parent_park_loan = (QemuCrucibleParentParkLoan) { 0 };
+        *owner = (QemuCrucibleParentParkReceive) {
+            .basis_fd = -1,
+            .cancellation_fd = -1,
+            .metadata_fd = -1,
+            .observation.descriptor = -1,
+        };
+    }
+    qemu_mutex_unlock(&startup_source.commands.mutex);
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
diff --git a/plugins/crucible-pending-command.inc.h b/plugins/crucible-pending-command.inc.h
new file mode 100644
index 0000000000000000000000000000000000000000..af44da5943b57123ebdb3cf832dab23e762c81ca
--- /dev/null
+++ b/plugins/crucible-pending-command.inc.h
@@ -0,0 +1,449 @@
+/*
+ * Actual pending-command cohort lender under the registered callback Runtime.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#if defined(CONFIG_LINUX) && defined(__x86_64__) && !defined(__ILP32__)
+static bool pending_runtime_field(uintptr_t base, uint64_t extent,
+                                  const void *field, size_t bytes, size_t alignment)
+{
+    uintptr_t address = (uintptr_t)field;
+
+    return base && extent && extent <= UINTPTR_MAX - base && field && bytes &&
+        address % alignment == 0 && bytes <= UINTPTR_MAX - address &&
+        address >= base && bytes <= extent && address - base <= extent - bytes;
+}
+
+static bool pending_span_geometry(uint32_t version, size_t bytes,
+                                   const void *out, size_t expected, size_t alignment,
+                                   const void *holder, const void *serial)
+{
+    uintptr_t address = (uintptr_t)out;
+
+    return version == 1 && bytes == expected && out && address % alignment == 0 &&
+        bytes <= UINTPTR_MAX - address &&
+        !callback_child_output_overlap(out, bytes, holder, sizeof(void *)) &&
+        !callback_child_output_overlap(out, bytes, serial, sizeof(uint64_t));
+}
+
+static bool pending_attempt_same_frame(QemuCrucibleSourcePendingCommandLender *lender,
+                                       uint64_t main_serial, uint64_t control_serial)
+{
+    return lender->attempted && lender->main_serial == main_serial &&
+        lender->control_serial == control_serial;
+}
+
+static int pending_output_geometry(uint32_t version, size_t bytes,
+                                    const void *out, size_t expected, size_t alignment,
+                                    const void *holder, const void *serial)
+{
+    int status;
+
+    if (!pending_span_geometry(version, bytes, out, expected, alignment, holder, serial)) {
+        return -EINVAL;
+    }
+    qemu_mutex_lock(&startup_source.commands.mutex);
+    status = callback_child_output_conflicts_locked(out, bytes) ? -EINVAL : 0;
+    qemu_mutex_unlock(&startup_source.commands.mutex);
+    if (!status) {
+        status = qemu_crucible_preexec_publisher_pending_output_v1(
+            startup_source.publisher_lender, out, bytes);
+    }
+    return status;
+}
+
+static int pending_lender_identity(QemuCrucibleSourcePendingCommandLender *lender,
+                                   uint64_t serial, bool consumed)
+{
+    QemuCrucibleSourceAdvanceReceiver *receiver = &startup_source.advance_receiver;
+    QemuCrucibleCommandConsumerMember *member = &startup_source.command_member;
+    int status;
+
+    if (lender != &startup_source.pending_command_lender ||
+        lender->canonical_owner != lender || !lender->attempted ||
+        lender->receiver != receiver || !serial || serial == UINT64_MAX ||
+        serial != lender->serial || lender->process != getpid() ||
+        !qemu_thread_is_self(&lender->thread) ||
+        lender->receiver_serial != receiver->serial ||
+        (consumed ? (!lender->consumed || lender->held || !lender->return_attempted) :
+                    (!lender->held || lender->consumed || lender->return_attempted))) {
+        return -ESTALE;
+    }
+    status = advance_receiver_identity(receiver);
+    if (status) {
+        return status;
+    }
+    if (!pending_runtime_field(member->runtime_base, member->runtime_extent,
+                               lender->holder, sizeof(*lender->holder),
+                               _Alignof(*lender->holder)) ||
+        !pending_runtime_field(member->runtime_base, member->runtime_extent,
+                               lender->serial_holder, sizeof(*lender->serial_holder),
+                               _Alignof(*lender->serial_holder))) {
+        return -ESTALE;
+    }
+    if (consumed) {
+        return *lender->holder || *lender->serial_holder ? -ESTALE : 0;
+    }
+    return *lender->holder == lender && *lender->serial_holder == serial ? 0 : -ESTALE;
+}
+
+static int pending_physical_current(QemuCrucibleSourcePendingCommandLender *lender)
+{
+    QemuCrucibleSourceAdvanceReceiver *receiver = lender->receiver;
+    int status;
+
+    if (receiver->main_returned) {
+        return -EPERM;
+    }
+    if (receiver->callback.entered && !receiver->callback.returned) {
+        status = qemu_plugin_crucible_native_advance_callback_current_v1(
+            receiver->main, receiver->control, &receiver->callback.mask);
+    } else {
+        status = qemu_plugin_crucible_native_advance_entry_current_v1(
+            receiver->main, receiver->control);
+    }
+    if (!status && (lender->main_serial != receiver->main->serial ||
+        lender->control_serial != receiver->control->serial)) {
+        status = -ESTALE;
+    }
+    return status;
+}
+
+static void pending_preserve_status(int *saved, int status)
+{
+    if (!*saved) {
+        *saved = status;
+    }
+}
+
+/* Every real cut runs independently; a masked callback uses its exact
+ * physical producer rather than calling and bypassing the outer Main check. */
+static int pending_protocol_cut(QemuCrucibleSourcePendingCommandLender *lender)
+{
+    QemuCrucibleSourceAdvanceReceiver *receiver = lender->receiver;
+
+    lender->cut_native_status = pending_physical_current(lender);
+    lender->cut_recipient_status = qemu_crucible_preexec_publisher_recipient_current_v1(
+        receiver->lender, receiver->recipient, receiver);
+    lender->cut_cohort_status = advance_receiver_identity(receiver);
+    if (!lender->cut_cohort_status) {
+        lender->cut_cohort_status = advance_publication_current(receiver);
+    }
+    lender->cut_final_status = qemu_crucible_preexec_publisher_recipient_current_v1(
+        receiver->lender, receiver->recipient, receiver);
+    pending_preserve_status(&lender->native_post_status, lender->cut_native_status);
+    pending_preserve_status(&lender->recipient_post_status, lender->cut_recipient_status);
+    pending_preserve_status(&lender->cohort_post_status, lender->cut_cohort_status);
+    pending_preserve_status(&lender->publication_final_status, lender->cut_final_status);
+    return lender->cut_native_status ? lender->cut_native_status :
+        lender->cut_recipient_status ? lender->cut_recipient_status :
+        lender->cut_cohort_status ? lender->cut_cohort_status : lender->cut_final_status;
+}
+
+static int pending_lender_current(QemuCrucibleSourcePendingCommandLender *lender)
+{
+    int first = pending_lender_identity(lender, lender->serial, false);
+    int post;
+
+    if (first) {
+        return first;
+    }
+    post = pending_protocol_cut(lender);
+    return post ? post : lender->first_status ? lender->first_status : lender->post_status;
+}
+
+static void pending_disposition(QemuCrucibleSourcePendingCommandLender *lender,
+                                struct qemu_plugin_crucible_pending_command_disposition_v1 *out,
+                                int first, int post)
+{
+    *out = (struct qemu_plugin_crucible_pending_command_disposition_v1) {
+        .schema_version = 1,
+        .struct_size = sizeof(*out),
+        .attempted = lender->attempted,
+        .retained = lender->held,
+        .return_attempted = lender->return_attempted,
+        .consumed = lender->consumed,
+        .first_status = first,
+        .post_status = post,
+    };
+}
+
+static void pending_consume_local(QemuCrucibleSourcePendingCommandLender *lender)
+{
+    lender->return_attempted = true;
+    *lender->holder = NULL;
+    *lender->serial_holder = 0;
+    lender->held = false;
+    lender->consumed = true;
+}
+
+static int pending_copy(QemuCrucibleSourcePendingCommandLender *lender)
+{
+    int first;
+
+    if (lender->observing) {
+        return -EBUSY;
+    }
+    lender->observing = true;
+    lender->scratch.schema_version = 1;
+    lender->scratch.struct_size = sizeof(lender->scratch);
+    lender->scratch.lender_serial = lender->serial;
+    lender->scratch.publication_sequence = lender->receiver->publication.sequence;
+    lender->scratch.loan_generation = lender->receiver->publication.loan_generation;
+    lender->scratch.ticket_serial = lender->receiver->publication.ticket_serial;
+    first = qemu_crucible_preexec_publisher_recipient_pending_copy_v1(
+        lender->receiver->lender, lender->receiver->recipient, lender->receiver,
+        lender->scratch.cohort, lender->scratch.command, &lender->scratch.recipient_serial,
+        &lender->copy_first_status, &lender->copy_post_status);
+    lender->observing = false;
+    return first;
+}
+#endif
+
+int qemu_crucible_source_advance_pending_copy_current_v1(
+    QemuCrucibleSourceAdvanceReceiver *receiver,
+    uint8_t *cohort, uint8_t *command, uint64_t *recipient_serial,
+    int *first, int *post)
+{
+#if defined(CONFIG_LINUX) && defined(__x86_64__) && !defined(__ILP32__)
+    QemuCrucibleSourcePendingCommandLender *lender = &startup_source.pending_command_lender;
+    int status = pending_lender_identity(lender, lender->serial, false);
+
+    if (status) {
+        return status;
+    }
+    if (receiver != lender->receiver || !lender->observing ||
+        cohort != lender->scratch.cohort || command != lender->scratch.command ||
+        recipient_serial != &lender->scratch.recipient_serial ||
+        first != &lender->copy_first_status || post != &lender->copy_post_status) {
+        return -EPERM;
+    }
+    return pending_physical_current(lender);
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_crucible_source_advance_pending_lend_v1(
+    QemuCrucibleCommandConsumerMember *member,
+    QemuCrucibleNativeInvocationTicket *main,
+    QemuCrucibleNativeInvocationTicket *control,
+    QemuCrucibleSourcePendingCommandLender **holder, uint64_t *serial,
+    uint32_t version, size_t bytes,
+    struct qemu_plugin_crucible_pending_command_disposition_v1 *out)
+{
+#if defined(CONFIG_LINUX) && defined(__x86_64__) && !defined(__ILP32__)
+    QemuCrucibleSourcePendingCommandLender *lender = &startup_source.pending_command_lender;
+    int first;
+    int post;
+
+    if (member != &startup_source.command_member) {
+        return -EPERM;
+    }
+    first = qemu_plugin_crucible_native_advance_entry_current_v1(main, control);
+    if (first) {
+        return first;
+    }
+    first = pending_output_geometry(version, bytes, out, sizeof(*out),
+                                     _Alignof(*out), holder, serial);
+    if (first) {
+        return first;
+    }
+    first = qemu_crucible_preexec_publisher_pending_output_v1(
+        startup_source.publisher_lender, holder, sizeof(*holder));
+    if (!first) {
+        first = qemu_crucible_preexec_publisher_pending_output_v1(
+            startup_source.publisher_lender, serial, sizeof(*serial));
+    }
+    if (first) {
+        return first;
+    }
+    qemu_mutex_lock(&startup_source.commands.mutex);
+    first = command_member_live_locked(member);
+    if (!first && (!command_member_advance_callbacks_valid(&member->advance) ||
+        !command_member_advance_receiver_callbacks_valid(&member->advance_receiver) ||
+        !pending_runtime_field(member->runtime_base, member->runtime_extent, holder,
+                               sizeof(*holder), _Alignof(*holder)) ||
+        !pending_runtime_field(member->runtime_base, member->runtime_extent, serial,
+                               sizeof(*serial), _Alignof(*serial)) ||
+        callback_child_output_overlap(holder, sizeof(*holder), serial, sizeof(*serial)) ||
+        callback_child_output_overlap(holder, sizeof(*holder), member->pending_constructor.observation,
+                                       sizeof(*member->pending_constructor.observation)) ||
+        callback_child_output_overlap(serial, sizeof(*serial), member->pending_constructor.observation,
+                                       sizeof(*member->pending_constructor.observation)) ||
+        callback_child_output_conflicts_locked(holder, sizeof(*holder)) ||
+        callback_child_output_conflicts_locked(serial, sizeof(*serial)))) {
+        first = -EINVAL;
+    }
+    if (!first && (*holder || *serial || lender->held || lender->observing ||
+        !pending_constructor_closed() ||
+        startup_source.pending_offer_read.busy || startup_source.advance_holder ||
+        lender->serial >= UINT64_MAX - 1 ||
+        pending_attempt_same_frame(lender, main->serial, control->serial))) {
+        first = -EBUSY;
+    }
+    if (!first) {
+        uint64_t next_serial = lender->serial + 1;
+
+        *lender = (QemuCrucibleSourcePendingCommandLender) {
+            .canonical_owner = lender,
+            .holder = holder,
+            .serial_holder = serial,
+            .receiver = &startup_source.advance_receiver,
+            .process = getpid(),
+            .serial = next_serial,
+            .main_serial = main->serial,
+            .control_serial = control->serial,
+            .attempted = true,
+        };
+        qemu_thread_get_self(&lender->thread);
+    }
+    qemu_mutex_unlock(&startup_source.commands.mutex);
+    if (first) {
+        return first;
+    }
+    first = qemu_crucible_source_advance_pending_prepare_v1(member, main, control);
+    lender->receiver_serial = lender->receiver->serial;
+    if (!first) {
+        /* Publish real local custody before copy or independent post. The
+         * receiver already holds its own Runtime/session cleanup parents. */
+        lender->held = true;
+        *holder = lender;
+        *serial = lender->serial;
+        first = pending_copy(lender);
+        lender->recipient_serial = lender->scratch.recipient_serial;
+        post = pending_lender_current(lender);
+    } else {
+        post = qemu_plugin_crucible_native_advance_entry_current_v1(main, control);
+    }
+    lender->first_status = first;
+    lender->post_status = post;
+    pending_disposition(lender, out, first, post);
+    return first ? first : post;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_crucible_source_advance_pending_callback_return_v1(
+    QemuCrucibleNativeInvocationTicket *main,
+    QemuCrucibleNativeInvocationTicket *control)
+{
+#if defined(CONFIG_LINUX) && defined(__x86_64__) && !defined(__ILP32__)
+    QemuCrucibleSourcePendingCommandLender *lender = &startup_source.pending_command_lender;
+    QemuCrucibleSourceAdvanceReceiver *receiver = &startup_source.advance_receiver;
+    int status;
+
+    if (!receiver->held || receiver->main_returned) {
+        return 0;
+    }
+    if (receiver->main != main || receiver->control != control ||
+        lender->receiver != receiver || lender->receiver_serial != receiver->serial ||
+        !lender->attempted || lender->producer_returned) {
+        return -EPERM;
+    }
+    status = qemu_plugin_crucible_native_advance_entry_current_v1(main, control);
+    lender->callback_return_status = status;
+    if (!status) {
+        lender->producer_returned = true;
+    }
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_advance_pending_command_observe_v1(
+    QemuCrucibleSourcePendingCommandLender *lender, uint64_t serial,
+    uint32_t version, size_t bytes,
+    struct qemu_plugin_crucible_pending_command_observation_v1 *out)
+{
+#if defined(CONFIG_LINUX) && defined(__x86_64__) && !defined(__ILP32__)
+    int first = pending_lender_identity(lender, serial, false);
+    int post;
+
+    if (first) {
+        return first;
+    }
+    first = pending_output_geometry(version, bytes, out, sizeof(*out), _Alignof(*out),
+                                     lender->holder, lender->serial_holder);
+    if (!first) {
+        first = qemu_crucible_preexec_publisher_recipient_output_v1(
+            lender->receiver->lender, lender->receiver->recipient, lender->receiver,
+            out, bytes);
+    }
+    if (first) {
+        return first;
+    }
+    first = pending_lender_current(lender);
+    if (!first) {
+        first = pending_copy(lender);
+        if (!first && lender->scratch.recipient_serial != lender->recipient_serial) {
+            first = -ESTALE;
+        }
+    }
+    post = pending_lender_current(lender);
+    pending_preserve_status(&lender->observe_first_status, first);
+    pending_preserve_status(&lender->observe_post_status, post);
+    if (!first && !post) {
+        *out = lender->scratch;
+    }
+    return first ? first : post;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_advance_pending_command_return_v1(
+    QemuCrucibleSourcePendingCommandLender *lender, uint64_t serial,
+    uint32_t version, size_t bytes,
+    struct qemu_plugin_crucible_pending_command_disposition_v1 *out)
+{
+#if defined(CONFIG_LINUX) && defined(__x86_64__) && !defined(__ILP32__)
+    int first;
+    int post;
+
+    if (lender != &startup_source.pending_command_lender) {
+        return -EPERM;
+    }
+    first = pending_lender_identity(lender, serial, lender->consumed);
+    if (!first) {
+        first = pending_output_geometry(version, bytes, out, sizeof(*out),
+                                         _Alignof(*out), lender->holder,
+                                         lender->serial_holder);
+    }
+    if (!first) {
+        first = qemu_crucible_preexec_publisher_recipient_output_v1(
+            lender->receiver->lender, lender->receiver->recipient, lender->receiver,
+            out, bytes);
+    }
+    if (!first) {
+        first = pending_physical_current(lender);
+    }
+    if (first) {
+        return first;
+    }
+    if (lender->consumed) {
+        pending_disposition(lender, out, lender->return_first_status,
+                             lender->return_post_status);
+        return lender->return_first_status ? lender->return_first_status :
+            lender->return_post_status;
+    }
+    if (lender->observing || lender->return_attempted ||
+        !pending_constructor_closed() ||
+        !advance_module_outputs_absent(lender->receiver)) {
+        return -EBUSY;
+    }
+    first = pending_lender_current(lender);
+    /* No semantic permission is needed to consume this exact physical loan.
+     * Keep its receiver/session and external post journal after local return. */
+    pending_consume_local(lender);
+    post = pending_protocol_cut(lender);
+    lender->return_first_status = first;
+    lender->return_post_status = post;
+    pending_disposition(lender, out, first, post);
+    return first ? first : post;
+#else
+    return -ENOTSUP;
+#endif
+}
diff --git a/plugins/crucible-pending-constructor.inc.h b/plugins/crucible-pending-constructor.inc.h
new file mode 100644
index 0000000000000000000000000000000000000000..82214f22db4c20cea7ba1446132835d6a2e5b51f
--- /dev/null
+++ b/plugins/crucible-pending-constructor.inc.h
@@ -0,0 +1,727 @@
+/*
+ * Registered lifetime of the actual pending Quantum constructor.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+/* A retained or uncertain child independently defeats every no-birth edge,
+ * including before ReceiverAcquire has published any module outputs. */
+static bool pending_constructor_closed(void)
+{
+    QemuCrucibleSourcePendingQuantumConstructor *child = &startup_source.pending_constructor;
+    QemuCruciblePendingConstructorRegistration *registration =
+        &startup_source.command_member.pending_constructor;
+    QemuCrucibleSourcePendingCommandLender *lender = &startup_source.pending_command_lender;
+
+    return !registration->active_child && !lender->constructor &&
+        !lender->constructor_serial && !child->held && !child->uncertain &&
+        !child->observing && (!child->attempted ||
+        (child->consumed && child->return_attempted));
+}
+
+/* The existing no-birth wire tail has no born mask and publishes zero child
+ * bits. Even a physically returned genuine Original needs its own registered
+ * operation-return edge; it cannot be relabelled as never born. */
+static bool pending_constructor_no_birth(void)
+{
+    QemuCrucibleSourcePendingQuantumConstructor *child = &startup_source.pending_constructor;
+
+    return pending_constructor_closed() && !child->construction.original_entered &&
+        !child->post.original_entered && !child->returned.original_entered;
+}
+
+#if defined(CONFIG_LINUX) && defined(__x86_64__) && !defined(__ILP32__)
+static bool pending_constructor_table_valid(
+    const struct qemu_plugin_crucible_pending_constructor_callbacks_v1 *table)
+{
+    return table->schema_version == 1 && table->struct_size == sizeof(*table) &&
+        table->construct && table->current && table->returned_current;
+}
+
+static bool pending_constructor_storage_valid(
+    QemuCrucibleCommandConsumerMember *member,
+    QemuCrucibleSourcePendingQuantumConstructor **holder, uint64_t *epoch,
+    struct qemu_plugin_crucible_pending_constructor_observation_v1 *observation,
+    void *journal, size_t journal_bytes)
+{
+    return pending_runtime_field(member->runtime_base, member->runtime_extent,
+                                  holder, sizeof(*holder), _Alignof(*holder)) &&
+        pending_runtime_field(member->runtime_base, member->runtime_extent,
+                              epoch, sizeof(*epoch), _Alignof(*epoch)) &&
+        pending_runtime_field(member->runtime_base, member->runtime_extent,
+                              observation, sizeof(*observation), _Alignof(*observation)) &&
+        pending_runtime_field(member->runtime_base, member->runtime_extent,
+                              journal, journal_bytes, _Alignof(void *)) &&
+        !callback_child_output_overlap(holder, sizeof(*holder), epoch, sizeof(*epoch)) &&
+        !callback_child_output_overlap(observation, sizeof(*observation), holder, sizeof(*holder)) &&
+        !callback_child_output_overlap(observation, sizeof(*observation), epoch, sizeof(*epoch)) &&
+        !callback_child_output_overlap(journal, journal_bytes, holder, sizeof(*holder)) &&
+        !callback_child_output_overlap(journal, journal_bytes, epoch, sizeof(*epoch)) &&
+        !callback_child_output_overlap(journal, journal_bytes, observation, sizeof(*observation));
+}
+
+static int pending_constructor_identity(QemuCrucibleSourcePendingQuantumConstructor *child,
+                                        uint64_t epoch, bool consumed)
+{
+    QemuCrucibleCommandConsumerMember *member = &startup_source.command_member;
+    QemuCruciblePendingConstructorRegistration *registration = &member->pending_constructor;
+    QemuCrucibleSourcePendingCommandLender *lender = &startup_source.pending_command_lender;
+    int status;
+
+    if (child != &startup_source.pending_constructor || child->canonical_owner != child ||
+        !child->attempted || !epoch || epoch == UINT64_MAX || child->serial != epoch ||
+        child->process != getpid() || !qemu_thread_is_self(&child->thread) ||
+        child->member != member || child->lender != lender ||
+        child->receiver != &startup_source.advance_receiver ||
+        child->receiver != lender->receiver || child->lender_serial != lender->serial ||
+        child->receiver_serial != child->receiver->serial ||
+        child->main != child->receiver->main || child->control != child->receiver->control ||
+        child->main_serial != lender->main_serial || child->control_serial != lender->control_serial ||
+        !registration->registered || registration->serial != child->registration_serial ||
+        child->holder != registration->holder || child->serial_holder != registration->epoch ||
+        !pending_constructor_storage_valid(member, registration->holder, registration->epoch,
+            registration->observation, registration->module_journal,
+            registration->module_journal_bytes)) {
+        return -ESTALE;
+    }
+    status = pending_lender_identity(lender, child->lender_serial, false);
+    if (status) {
+        return status;
+    }
+    if (consumed) {
+        return child->consumed && !child->held && child->return_attempted &&
+            !*child->holder && !*child->serial_holder && !registration->active_child &&
+            !lender->constructor && !lender->constructor_serial ? 0 : -ESTALE;
+    }
+    return child->held && !child->consumed && registration->active_child == child &&
+        lender->constructor == child && lender->constructor_serial == epoch &&
+        *child->holder == child && *child->serial_holder == epoch ? 0 : -ESTALE;
+}
+
+static int pending_constructor_source_current(QemuCrucibleSourcePendingQuantumConstructor *child)
+{
+    int status = pending_constructor_identity(child, child->serial, child->consumed);
+
+    if (!status) {
+        qemu_mutex_lock(&startup_source.commands.mutex);
+        status = command_member_live_locked(child->member);
+        qemu_mutex_unlock(&startup_source.commands.mutex);
+    }
+    return status;
+}
+
+/* No callback here. Each cut is independent, even after identity or first
+ * refusal. The lender owns every parent read by these external observations. */
+static int pending_constructor_post(QemuCrucibleSourcePendingQuantumConstructor *child)
+{
+    int source = pending_constructor_source_current(child);
+    int protocol = pending_protocol_cut(child->lender);
+
+    pending_preserve_status(&child->source_post_status, source);
+    pending_preserve_status(&child->native_post_status, child->lender->cut_native_status);
+    pending_preserve_status(&child->recipient_post_status, child->lender->cut_recipient_status);
+    pending_preserve_status(&child->cohort_post_status, child->lender->cut_cohort_status);
+    pending_preserve_status(&child->final_status, child->lender->cut_final_status);
+    if (!source && (child->publication_sequence != child->receiver->publication.sequence ||
+        child->loan_generation != child->receiver->publication.loan_generation ||
+        child->ticket_serial != child->receiver->publication.ticket_serial ||
+        child->recipient_serial != child->lender->recipient_serial)) {
+        source = -ESTALE;
+        pending_preserve_status(&child->source_post_status, source);
+    }
+    return source ? source : protocol;
+}
+
+static void pending_constructor_receipt_init(
+    struct qemu_plugin_crucible_pending_constructor_receipt_v1 *receipt)
+{
+    *receipt = (struct qemu_plugin_crucible_pending_constructor_receipt_v1) {
+        .schema_version = 1,
+        .struct_size = sizeof(*receipt),
+    };
+}
+
+static bool pending_constructor_receipt_valid(
+    const struct qemu_plugin_crucible_pending_constructor_receipt_v1 *receipt)
+{
+    return receipt->schema_version == 1 && receipt->struct_size == sizeof(*receipt) &&
+        receipt->original_attempted <= 1 && receipt->original_entered <= 1 &&
+        receipt->original_moved <= 1 && receipt->original_returned <= 1 &&
+        receipt->return_attempted <= 1 && receipt->local_consumed <= 1 &&
+        receipt->first_status <= 0 && receipt->post_status <= 0 &&
+        (receipt->original_entered || !receipt->original_serial) &&
+        (receipt->original_moved || !receipt->transfer_serial) &&
+        (!receipt->original_entered || (receipt->original_attempted &&
+            receipt->original_serial && receipt->original_serial != UINT64_MAX)) &&
+        (!receipt->original_moved || (receipt->original_entered &&
+            receipt->transfer_serial && receipt->transfer_serial != UINT64_MAX)) &&
+        (!receipt->original_returned || (receipt->original_entered && receipt->return_attempted)) &&
+        (!receipt->local_consumed || (!receipt->original_entered || receipt->original_returned));
+}
+
+/* Syntax is corroboration only. The registered real module callback must
+ * authenticate its actual typed Core constructor and retained return journals. */
+static bool pending_constructor_receipt_continues(
+    const struct qemu_plugin_crucible_pending_constructor_receipt_v1 *earlier,
+    const struct qemu_plugin_crucible_pending_constructor_receipt_v1 *later)
+{
+    return pending_constructor_receipt_valid(later) &&
+        (!earlier->original_attempted || later->original_attempted) &&
+        (!earlier->original_entered || (later->original_entered &&
+            earlier->original_serial == later->original_serial)) &&
+        (!earlier->original_moved || (later->original_moved &&
+            earlier->transfer_serial == later->transfer_serial)) &&
+        (!earlier->original_returned || later->original_returned) &&
+        (!earlier->return_attempted || later->return_attempted) &&
+        (!earlier->local_consumed || later->local_consumed);
+}
+
+static bool pending_constructor_module_same(QemuCrucibleSourcePendingQuantumConstructor *child)
+{
+    QemuCruciblePendingConstructorRegistration *registration = &child->member->pending_constructor;
+
+    return child->module_owner_seen && child->module_pending == child->module_at_construct &&
+        child->module_pending_serial == child->module_at_construct_serial &&
+        child->module_pending_serial && child->module_pending_serial != UINT64_MAX &&
+        pending_runtime_field((uintptr_t)registration->module_journal,
+            registration->module_journal_bytes, child->module_pending,
+            sizeof(void *), _Alignof(void *));
+}
+
+/* ReceiverAcquire can only retain the genuine constructor's existing owner.
+ * Its own independent Core Current remains the module's responsibility. */
+static int pending_constructor_receive_current(QemuCrucibleSourceAdvanceReceiver *receiver)
+{
+    QemuCrucibleSourcePendingQuantumConstructor *child = &startup_source.pending_constructor;
+    int first = pending_constructor_identity(child, child->serial, false);
+    int post;
+
+    if (first) {
+        return first;
+    }
+    first = child->first_status ? child->first_status : child->post_status;
+    if (!first && (child->receiver != receiver || !child->construct_entered ||
+        !child->construct_returned || child->uncertain || child->return_attempted ||
+        child->observing || !child->construction.original_entered ||
+        !child->post.original_entered || child->post.original_returned ||
+        child->post.local_consumed || !pending_constructor_module_same(child))) {
+        first = -ESTALE;
+    }
+    post = pending_constructor_post(child);
+    pending_preserve_status(&child->post_status, post);
+    return first ? first : post;
+}
+
+static int pending_constructor_callback_status(int status)
+{
+    return status > 0 ? -EPROTO : status;
+}
+
+/* An unentered Current has no receipt to validate. Its refusal still persists,
+ * but cannot erase the known actual module owner or fabricate a callback return.
+ * A later genuine factual return remains possible in the same physical Main. */
+static int pending_constructor_capture_post(QemuCrucibleSourcePendingQuantumConstructor *child,
+                                            int status)
+{
+    int post = pending_constructor_callback_status(status);
+
+    if (child->post_entered) {
+        if (!child->post_returned ||
+            !pending_constructor_receipt_continues(&child->construction, &child->post)) {
+            child->uncertain = true;
+            post = post ? post : -ESTALE;
+        }
+        if (!post) {
+            post = child->post.first_status ? child->post.first_status : child->post.post_status;
+        }
+        if (!post && (child->post.original_returned || child->post.local_consumed)) {
+            post = -ESTALE;
+        }
+    }
+    if (!pending_constructor_module_same(child)) {
+        child->uncertain = true;
+        post = post ? post : -ESTALE;
+    }
+    pending_preserve_status(&child->module_post_status, post);
+    return post;
+}
+
+/* This validates only the reciprocal result after its real registered callback
+ * physically returned. It never turns receipt syntax into a Core return issuer. */
+static int pending_constructor_capture_return(QemuCrucibleSourcePendingQuantumConstructor *child,
+                                              int status)
+{
+    int physical = pending_constructor_callback_status(status);
+
+    if (!child->returned_entered || !child->returned_returned ||
+        !pending_constructor_module_same(child) ||
+        !pending_constructor_receipt_continues(&child->construction, &child->returned) ||
+        (child->post_entered &&
+         !pending_constructor_receipt_continues(&child->post, &child->returned)) ||
+        !child->returned.local_consumed) {
+        physical = physical ? physical : -ESTALE;
+    }
+    return physical;
+}
+
+static void pending_constructor_disposition(QemuCrucibleSourcePendingQuantumConstructor *child,
+    struct qemu_plugin_crucible_pending_constructor_disposition_v1 *out, int first, int post)
+{
+    *out = (struct qemu_plugin_crucible_pending_constructor_disposition_v1) {
+        .schema_version = 1,
+        .struct_size = sizeof(*out),
+        .attempted = child->attempted,
+        .held = child->held,
+        .construct_entered = child->construct_entered,
+        .construct_returned = child->construct_returned,
+        .return_attempted = child->return_attempted,
+        .consumed = child->consumed,
+        .first_status = first,
+        .post_status = post,
+        .module_serial = child->module_at_construct_serial,
+    };
+}
+
+static int pending_constructor_output(QemuCrucibleSourcePendingQuantumConstructor *child,
+    uint32_t version, size_t bytes, void *out, size_t expected, size_t alignment)
+{
+    QemuCruciblePendingConstructorRegistration *registration = &child->member->pending_constructor;
+    int status;
+
+    if (expected == sizeof(*registration->observation) && out == registration->observation) {
+        if (!pending_span_geometry(version, bytes, out, expected, alignment,
+                                   child->holder, child->serial_holder)) {
+            return -EINVAL;
+        }
+        /* Only this exact prepaid observation may bypass its own exclusion. */
+        qemu_mutex_lock(&startup_source.commands.mutex);
+        status = callback_child_output_conflicts_except_locked(out, bytes, out) ? -EINVAL : 0;
+        qemu_mutex_unlock(&startup_source.commands.mutex);
+        if (!status) {
+            status = qemu_crucible_preexec_publisher_pending_output_v1(
+                startup_source.publisher_lender, out, bytes);
+        }
+    } else {
+        status = pending_output_geometry(version, bytes, out, expected, alignment,
+                                          child->holder, child->serial_holder);
+    }
+    if (!status && (((expected != sizeof(*registration->observation) || out != registration->observation) &&
+        callback_child_output_overlap(out, bytes, registration->observation,
+                                       sizeof(*registration->observation))) ||
+        callback_child_output_overlap(out, bytes, registration->module_journal,
+                                                  registration->module_journal_bytes) ||
+        callback_child_output_overlap(out, bytes, child->lender->holder,
+                                       sizeof(*child->lender->holder)) ||
+        callback_child_output_overlap(out, bytes, child->lender->serial_holder,
+                                       sizeof(*child->lender->serial_holder)))) {
+        status = -EINVAL;
+    }
+    return status;
+}
+
+/* The Source-owned module fields remain intact through factual closure. Only
+ * the exact Source holder and its reciprocal debts are consumed, once. */
+static void pending_constructor_consume(QemuCrucibleSourcePendingQuantumConstructor *child)
+{
+    *child->holder = NULL;
+    *child->serial_holder = 0;
+    child->lender->constructor = NULL;
+    child->lender->constructor_serial = 0;
+    child->member->pending_constructor.active_child = NULL;
+    child->held = false;
+    child->consumed = true;
+}
+#else
+static int pending_constructor_receive_current(QemuCrucibleSourceAdvanceReceiver *receiver)
+{
+    return -ENOTSUP;
+}
+#endif
+
+int qemu_plugin_crucible_advance_pending_constructor_register_v1(
+    qemu_plugin_id_t id, QemuCrucibleCommandConsumerMember *member,
+    const struct qemu_plugin_crucible_pending_constructor_callbacks_v1 *table,
+    QemuCrucibleSourcePendingQuantumConstructor **holder, uint64_t *epoch,
+    struct qemu_plugin_crucible_pending_constructor_observation_v1 *observation,
+    void *journal, size_t journal_bytes, uint32_t version, size_t bytes,
+    struct qemu_plugin_crucible_pending_constructor_registration_v1 *out)
+{
+#if defined(CONFIG_LINUX) && defined(__x86_64__) && !defined(__ILP32__)
+    QemuCruciblePendingConstructorRegistration *registration;
+    int first = command_registry_identity(id);
+    int post;
+
+    if (first || member != &startup_source.command_member || !startup_invocation(id) ||
+        startup_source.install_returned) {
+        return first ? first : -EPERM;
+    }
+    first = pending_output_geometry(version, bytes, out, sizeof(*out), _Alignof(*out),
+                                     holder, epoch);
+    if (!first) {
+        first = pending_output_geometry(1, sizeof(*table), table, sizeof(*table),
+                                         _Alignof(*table), holder, epoch);
+    }
+    if (first || callback_child_output_overlap(out, bytes, table, sizeof(*table)) ||
+        !pending_constructor_storage_valid(member, holder, epoch, observation, journal, journal_bytes) ||
+        callback_child_output_overlap(out, bytes, observation, sizeof(*observation)) ||
+        callback_child_output_overlap(out, bytes, journal, journal_bytes) ||
+        callback_child_output_overlap(table, sizeof(*table), observation, sizeof(*observation)) ||
+        callback_child_output_overlap(table, sizeof(*table), journal, journal_bytes) ||
+        !pending_constructor_table_valid(table)) {
+        return first ? first : -EINVAL;
+    }
+    first = startup_runtime_admission(id, member->runtime);
+    if (first) {
+        return first;
+    }
+    qemu_mutex_lock(&startup_source.commands.mutex);
+    first = command_member_live_locked(member);
+    registration = &member->pending_constructor;
+    if (!first && (registration->attempted || registration->serial >= UINT64_MAX - 1 ||
+        !command_member_advance_callbacks_valid(&member->advance) ||
+        !command_member_advance_receiver_callbacks_valid(&member->advance_receiver) ||
+        *holder || *epoch || callback_child_output_conflicts_locked(holder, sizeof(*holder)) ||
+        callback_child_output_conflicts_locked(epoch, sizeof(*epoch)) ||
+        callback_child_output_conflicts_locked(observation, sizeof(*observation)) ||
+        callback_child_output_conflicts_locked(journal, journal_bytes))) {
+        first = -EBUSY;
+    }
+    if (!first) {
+        registration->table = *table;
+        registration->holder = holder;
+        registration->epoch = epoch;
+        registration->observation = observation;
+        registration->module_journal = journal;
+        registration->module_journal_bytes = journal_bytes;
+        registration->serial++;
+        registration->attempted = true;
+        registration->registered = true;
+    }
+    qemu_mutex_unlock(&startup_source.commands.mutex);
+    if (first) {
+        return first;
+    }
+    /* Actual registration is retained even if its independent Original post
+     * refuses. Such a registration cannot admit a constructor child. */
+    post = startup_runtime_admission(id, member->runtime);
+    registration->first_status = first;
+    registration->post_status = post;
+    *out = (struct qemu_plugin_crucible_pending_constructor_registration_v1) {
+        .schema_version = 1,
+        .struct_size = sizeof(*out),
+        .registered = registration->registered,
+        .registration_serial = registration->serial,
+        .first_status = first,
+        .post_status = post,
+    };
+    return first ? first : post;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_advance_pending_constructor_enter_v1(
+    QemuCrucibleSourcePendingCommandLender *lender, uint64_t lender_serial,
+    uint32_t version, size_t bytes,
+    struct qemu_plugin_crucible_pending_constructor_disposition_v1 *out)
+{
+#if defined(CONFIG_LINUX) && defined(__x86_64__) && !defined(__ILP32__)
+    QemuCrucibleSourcePendingQuantumConstructor *child = &startup_source.pending_constructor;
+    QemuCrucibleCommandConsumerMember *member = &startup_source.command_member;
+    QemuCruciblePendingConstructorRegistration *registration = &member->pending_constructor;
+    int first = pending_lender_identity(lender, lender_serial, false);
+    int post;
+
+    if (first) {
+        return first;
+    }
+    if (!registration->registered || registration->first_status || registration->post_status ||
+        !pending_constructor_table_valid(&registration->table)) {
+        return -ENOKEY;
+    }
+    first = pending_output_geometry(version, bytes, out, sizeof(*out), _Alignof(*out),
+                                     registration->holder, registration->epoch);
+    if (!first && (callback_child_output_overlap(out, bytes, registration->module_journal,
+                                                   registration->module_journal_bytes) ||
+        callback_child_output_overlap(out, bytes, registration->observation,
+                                       sizeof(*registration->observation)) ||
+        callback_child_output_overlap(out, bytes, lender->holder, sizeof(*lender->holder)) ||
+        callback_child_output_overlap(out, bytes, lender->serial_holder, sizeof(*lender->serial_holder)))) {
+        first = -EINVAL;
+    }
+    if (!first) {
+        first = pending_lender_current(lender);
+    }
+    if (first) {
+        return first;
+    }
+    qemu_mutex_lock(&startup_source.commands.mutex);
+    first = command_member_live_locked(member);
+    if (!first && (!pending_constructor_closed() ||
+        (child->attempted && child->lender_serial == lender_serial) ||
+        !pending_constructor_storage_valid(member, registration->holder, registration->epoch,
+            registration->observation, registration->module_journal, registration->module_journal_bytes) ||
+        *registration->holder || *registration->epoch || child->serial >= UINT64_MAX - 1 ||
+        lender->observing || lender->producer_returned || lender->receiver->acquire_entered ||
+        (lender->receiver->callback.entered && !lender->receiver->callback.returned))) {
+        first = -EBUSY;
+    }
+    if (!first) {
+        *child = (QemuCrucibleSourcePendingQuantumConstructor) {
+            .canonical_owner = child,
+            .holder = registration->holder,
+            .serial_holder = registration->epoch,
+            .lender = lender,
+            .member = member,
+            .receiver = lender->receiver,
+            .main = lender->receiver->main,
+            .control = lender->receiver->control,
+            .process = getpid(),
+            .serial = child->serial + 1,
+            .registration_serial = registration->serial,
+            .lender_serial = lender_serial,
+            .receiver_serial = lender->receiver->serial,
+            .recipient_serial = lender->recipient_serial,
+            .publication_sequence = lender->receiver->publication.sequence,
+            .loan_generation = lender->receiver->publication.loan_generation,
+            .ticket_serial = lender->receiver->publication.ticket_serial,
+            .main_serial = lender->main_serial,
+            .control_serial = lender->control_serial,
+            .attempted = true,
+            .held = true,
+        };
+        qemu_thread_get_self(&child->thread);
+        registration->active_child = child;
+        lender->constructor = child;
+        lender->constructor_serial = child->serial;
+        *child->holder = child;
+        *child->serial_holder = child->serial;
+    }
+    qemu_mutex_unlock(&startup_source.commands.mutex);
+    if (first) {
+        return first;
+    }
+    pending_constructor_receipt_init(&child->construction);
+    pending_constructor_receipt_init(&child->post);
+    first = advance_callback_begin(child->receiver, QEMU_CRUCIBLE_ADVANCE_CALLBACK_PENDING_CONSTRUCT,
+                                    registration->table.construct);
+    child->native_first_status = first;
+    if (!first) {
+        child->construct_entered = true;
+        child->constructor_frame_serial = child->receiver->callback.serial;
+        child->construct_status = registration->table.construct(child, lender, lender_serial,
+            &child->module_pending, &child->module_pending_serial, &child->construction,
+            member->component->userdata);
+        child->construct_returned = true;
+        /* Save actual output identities before any independent module post. */
+        child->module_at_construct = child->module_pending;
+        child->module_at_construct_serial = child->module_pending_serial;
+        child->module_owner_seen = child->module_pending && child->module_pending_serial &&
+            child->module_pending_serial != UINT64_MAX;
+        advance_callback_end(child->receiver);
+        if (child->construct_status > 0) {
+            child->construct_status = pending_constructor_callback_status(child->construct_status);
+        }
+        first = child->construct_status;
+        if (!first) {
+            first = child->construction.first_status ? child->construction.first_status :
+                child->construction.post_status;
+        }
+        if (!first && !child->construction.original_entered) {
+            first = -ENOKEY;
+        }
+        if (!first && (child->construction.original_returned || child->construction.local_consumed)) {
+            first = -ESTALE;
+        }
+        if (!pending_constructor_receipt_valid(&child->construction) ||
+            !pending_constructor_module_same(child)) {
+            child->uncertain = true;
+            first = first ? first : -ESTALE;
+        }
+        /* Save the original cause before an independent Current can itself
+         * observe a new failure. The post cannot replace this earlier first. */
+        pending_preserve_status(&child->first_status, first);
+        /* Independent Current is attempted even when construct refused. */
+        post = advance_callback_begin(child->receiver, QEMU_CRUCIBLE_ADVANCE_CALLBACK_PENDING_CURRENT,
+                                       registration->table.current);
+        if (!post) {
+            child->post_entered = true;
+            child->last_callback_serial = child->receiver->callback.serial;
+            post = registration->table.current(&child->module_pending,
+                child->module_pending_serial, child, &child->post, member->component->userdata);
+            child->post_returned = true;
+            advance_callback_end(child->receiver);
+        }
+        pending_constructor_capture_post(child, post);
+    }
+    pending_preserve_status(&child->first_status, first);
+    post = pending_constructor_post(child);
+    pending_preserve_status(&child->post_status, child->module_post_status);
+    pending_preserve_status(&child->post_status, post);
+    pending_constructor_disposition(child, out, child->first_status, child->post_status);
+    return child->first_status ? child->first_status : child->post_status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_advance_pending_constructor_observe_v1(
+    QemuCrucibleSourcePendingQuantumConstructor *child, uint64_t epoch,
+    uint32_t version, size_t bytes,
+    struct qemu_plugin_crucible_pending_constructor_observation_v1 *out)
+{
+#if defined(CONFIG_LINUX) && defined(__x86_64__) && !defined(__ILP32__)
+    QemuCruciblePendingConstructorRegistration *registration;
+    int first = pending_constructor_identity(child, epoch, false);
+    int post;
+
+    if (first) {
+        return first;
+    }
+    registration = &child->member->pending_constructor;
+    first = pending_constructor_output(child, version, bytes, out, sizeof(*out), _Alignof(*out));
+    if (first || out != registration->observation) {
+        return first ? first : -EINVAL;
+    }
+    if (child->observing || child->uncertain || child->return_attempted ||
+        (child->receiver->callback.kind != QEMU_CRUCIBLE_ADVANCE_CALLBACK_PENDING_CONSTRUCT &&
+         child->receiver->callback.kind != QEMU_CRUCIBLE_ADVANCE_CALLBACK_PENDING_CURRENT)) {
+        return -EBUSY;
+    }
+    child->observing = true;
+    first = advance_observation_current(child->receiver, child->receiver->callback.kind);
+    if (!first && ((child->receiver->callback.kind == QEMU_CRUCIBLE_ADVANCE_CALLBACK_PENDING_CONSTRUCT &&
+        child->receiver->callback.serial != child->constructor_frame_serial) ||
+        (child->receiver->callback.kind == QEMU_CRUCIBLE_ADVANCE_CALLBACK_PENDING_CURRENT &&
+         child->receiver->callback.serial != child->last_callback_serial))) {
+        first = -ESTALE;
+    }
+    if (!first) {
+        first = pending_constructor_source_current(child);
+    }
+    if (!first) {
+        first = pending_lender_current(child->lender);
+    }
+    if (!first) {
+        first = pending_copy(child->lender);
+    }
+    if (!first) {
+        child->observation = (struct qemu_plugin_crucible_pending_constructor_observation_v1) {
+            .schema_version = 1,
+            .struct_size = sizeof(child->observation),
+            .constructor_serial = child->serial,
+            .lender_serial = child->lender_serial,
+            .receiver_serial = child->receiver_serial,
+            .recipient_serial = child->lender->scratch.recipient_serial,
+            .publication_sequence = child->publication_sequence,
+            .loan_generation = child->loan_generation,
+            .ticket_serial = child->ticket_serial,
+            .callback_epoch = child->receiver->callback.serial,
+        };
+        memcpy(child->observation.cohort, child->lender->scratch.cohort,
+               sizeof(child->observation.cohort));
+        memcpy(child->observation.command, child->lender->scratch.command,
+               sizeof(child->observation.command));
+        if (child->observation.recipient_serial != child->recipient_serial) {
+            first = -ESTALE;
+        }
+    }
+    post = pending_constructor_post(child);
+    pending_preserve_status(&child->first_status, first);
+    pending_preserve_status(&child->post_status, post);
+    child->observing = false;
+    if (!first && !post && !child->first_status && !child->post_status) {
+        *out = child->observation;
+    }
+    return first ? first : post ? post : child->first_status ?
+        child->first_status : child->post_status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_advance_pending_constructor_return_v1(
+    QemuCrucibleSourcePendingQuantumConstructor *child, uint64_t epoch,
+    uint32_t version, size_t bytes,
+    struct qemu_plugin_crucible_pending_constructor_disposition_v1 *out)
+{
+#if defined(CONFIG_LINUX) && defined(__x86_64__) && !defined(__ILP32__)
+    QemuCruciblePendingConstructorRegistration *registration;
+    int first;
+    int post;
+    int physical;
+
+    if (child != &startup_source.pending_constructor) {
+        return -EPERM;
+    }
+    first = pending_constructor_identity(child, epoch, child->consumed);
+    if (!first) {
+        first = pending_constructor_output(child, version, bytes, out, sizeof(*out), _Alignof(*out));
+    }
+    if (!first) {
+        first = pending_physical_current(child->lender);
+    }
+    if (first) {
+        return first;
+    }
+    if (child->consumed) {
+        pending_constructor_disposition(child, out, child->return_first_status, child->return_post_status);
+        return child->return_first_status ? child->return_first_status : child->return_post_status;
+    }
+    if (child->return_attempted || child->observing || child->uncertain ||
+        (child->receiver->callback.entered && !child->receiver->callback.returned) ||
+        (child->construct_entered && !child->construct_returned)) {
+        return -EBUSY;
+    }
+    first = child->first_status ? child->first_status : child->post_status;
+    registration = &child->member->pending_constructor;
+    child->return_attempted = true;
+    pending_constructor_receipt_init(&child->returned);
+    if (!child->construct_entered) {
+        /* Only Source's actual failed callback-entry edge proves this absence. */
+        physical = child->native_first_status && !child->module_pending &&
+            !child->module_pending_serial ? 0 : -ESTALE;
+    } else {
+        physical = pending_constructor_module_same(child) ? 0 : -ESTALE;
+        if (!physical) {
+            physical = advance_callback_begin(child->receiver,
+                QEMU_CRUCIBLE_ADVANCE_CALLBACK_PENDING_RETURNED_CURRENT,
+                registration->table.returned_current);
+        }
+        if (!physical) {
+            child->returned_entered = true;
+            child->last_callback_serial = child->receiver->callback.serial;
+            physical = registration->table.returned_current(&child->module_pending,
+                child->module_pending_serial, child, &child->returned,
+                child->member->component->userdata);
+            child->returned_returned = true;
+            advance_callback_end(child->receiver);
+            physical = pending_constructor_capture_return(child, physical);
+        }
+    }
+    physical = pending_constructor_callback_status(physical);
+    child->module_return_status = physical;
+    child->physical_status = physical;
+    if (!physical && child->construct_entered) {
+        pending_preserve_status(&child->first_status, child->returned.first_status);
+        pending_preserve_status(&child->post_status, child->returned.post_status);
+        if (!first) {
+            first = child->returned.first_status ? child->returned.first_status :
+                child->returned.post_status;
+        }
+    }
+    if (!physical) {
+        pending_constructor_consume(child);
+    } else {
+        child->uncertain = true;
+    }
+    /* Post observes retained Runtime/lender/session journals, never the Core
+     * Original or a released wrapper. Negative post cannot resurrect a child. */
+    post = pending_constructor_post(child);
+    child->return_first_status = first ? first : physical;
+    child->return_post_status = post;
+    pending_constructor_disposition(child, out, child->return_first_status, post);
+    return child->return_first_status ? child->return_first_status : post;
+#else
+    return -ENOTSUP;
+#endif
+}
diff --git a/plugins/crucible-pending-offer.inc.h b/plugins/crucible-pending-offer.inc.h
new file mode 100644
index 0000000000000000000000000000000000000000..41066e8b3804da07bdf63284679f4cd413f62421
--- /dev/null
+++ b/plugins/crucible-pending-offer.inc.h
@@ -0,0 +1,207 @@
+/*
+ * Nonissuing dispatch observation under the actual entered control frame.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#if defined(CONFIG_LINUX) && defined(__x86_64__) && !defined(__ILP32__)
+static int pending_offer_identity(QemuCrucibleSourcePendingOfferRead *read)
+{
+    QemuCrucibleCommandConsumerMember *member = &startup_source.command_member;
+    QemuCruciblePublisherModuleService *service = &startup_source.publisher_module;
+    int status;
+
+    if (read != &startup_source.pending_offer_read || read->canonical_owner != read ||
+        !read->busy || !read->attempted || read->consumed || read->member != member ||
+        read->lender != startup_source.publisher_lender || !read->lender ||
+        read->process != getpid() || !qemu_thread_is_self(&read->thread) ||
+        !read->serial || read->serial == UINT64_MAX) {
+        return -ESTALE;
+    }
+    qemu_mutex_lock(&startup_source.commands.mutex);
+    status = command_member_identity_locked(member);
+    if (!status) {
+        status = publisher_service_runtime_identity_locked(service);
+    }
+    if (!status && (member->child_owner != service->runtime_owner ||
+        member->runtime_base != service->runtime_base ||
+        member->runtime_extent != service->runtime_extent ||
+        member->publisher_lender != read->lender || !member->runtime_holder ||
+        *member->runtime_holder != member)) {
+        status = -ESTALE;
+    }
+    qemu_mutex_unlock(&startup_source.commands.mutex);
+    return status;
+}
+
+/* Semantic-current refusal withholds dispatch, while physical identity above
+ * remains available to return the exact local read after such a refusal. */
+static int pending_offer_source_current(QemuCrucibleSourcePendingOfferRead *read)
+{
+    int status = pending_offer_identity(read);
+
+    if (status) {
+        return status;
+    }
+    qemu_mutex_lock(&startup_source.commands.mutex);
+    status = command_member_live_locked(read->member);
+    if (!status && startup_source.publisher_module.closing) {
+        status = -ESTALE;
+    }
+    qemu_mutex_unlock(&startup_source.commands.mutex);
+    return status;
+}
+
+static int pending_offer_native_current(QemuCrucibleSourcePendingOfferRead *read)
+{
+    int status = qemu_plugin_crucible_native_advance_entry_current_v1(
+        read->main, read->control);
+
+    if (!status && (read->main->serial != read->main_serial ||
+        read->control->serial != read->control_serial)) {
+        status = -ESTALE;
+    }
+    return status;
+}
+
+static bool pending_offer_read_returnable(const QemuCrucibleSourcePendingOfferRead *read)
+{
+    return !read->return_attempted &&
+        (!read->observation.entered || read->observation.read_returned);
+}
+
+static void pending_offer_consume_read(QemuCrucibleSourcePendingOfferRead *read)
+{
+    read->return_attempted = true;
+    read->consumed = true;
+    read->busy = false;
+}
+
+static int pending_offer_return_read(QemuCrucibleSourcePendingOfferRead *read)
+{
+    int status = pending_offer_identity(read);
+
+    if (status || !pending_offer_read_returnable(read)) {
+        return status ? status : -EBUSY;
+    }
+    pending_offer_consume_read(read);
+    return 0;
+}
+
+static int pending_offer_post(QemuCrucibleSourcePendingOfferRead *read, int first)
+{
+    read->first_status = first;
+    read->native_post_status = pending_offer_native_current(read);
+    read->source_post_status = pending_offer_source_current(read);
+    read->session_post_status = qemu_crucible_preexec_publisher_pending_output_v1(
+        read->lender, &read->observation, sizeof(read->observation));
+    read->return_status = pending_offer_return_read(read);
+    return read->native_post_status ? read->native_post_status :
+        read->source_post_status ? read->source_post_status :
+        read->session_post_status ? read->session_post_status : read->return_status;
+}
+
+#endif
+
+int qemu_crucible_source_pending_offer_current_v1(
+    QemuCruciblePublisherSessionLender *lender,
+    QemuCrucibleCommandConsumerMember *member,
+    QemuCruciblePublisherOfferObservation *observation)
+{
+#if defined(CONFIG_LINUX) && defined(__x86_64__) && !defined(__ILP32__)
+    QemuCrucibleSourcePendingOfferRead *read = &startup_source.pending_offer_read;
+    int status = pending_offer_source_current(read);
+
+    if (status) {
+        return status;
+    }
+    if (lender != read->lender || member != read->member ||
+        observation != &read->observation || read->return_attempted) {
+        return -EPERM;
+    }
+    return pending_offer_native_current(read);
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_crucible_source_pending_offer_select_v1(
+    QemuCrucibleCommandConsumerMember *member,
+    QemuCrucibleNativeInvocationTicket *main,
+    QemuCrucibleNativeInvocationTicket *control,
+    uint32_t version, size_t bytes,
+    struct qemu_plugin_crucible_pending_offer_selection_v1 *out)
+{
+#if defined(CONFIG_LINUX) && defined(__x86_64__) && !defined(__ILP32__)
+    QemuCrucibleSourcePendingOfferRead *read = &startup_source.pending_offer_read;
+    QemuCrucibleSourcePendingCommandLender *pending = &startup_source.pending_command_lender;
+    int first;
+    int post;
+
+    if (member != &startup_source.command_member) {
+        return -EPERM;
+    }
+    first = qemu_plugin_crucible_native_advance_entry_current_v1(main, control);
+    if (first) {
+        return first;
+    }
+    first = pending_output_geometry(version, bytes, out, sizeof(*out), _Alignof(*out),
+                                     pending->holder, pending->serial_holder);
+    if (first) {
+        return first;
+    }
+    qemu_mutex_lock(&startup_source.commands.mutex);
+    first = command_member_live_locked(member);
+    if (!first) {
+        first = publisher_service_runtime_identity_locked(&startup_source.publisher_module);
+    }
+    if (!first && (read->busy || startup_source.advance_holder || pending->held ||
+        startup_source.publisher_module.closing || member->transition_active ||
+        member->publisher_lender != startup_source.publisher_lender)) {
+        first = -EBUSY;
+    }
+    if (!first && read->serial >= UINT64_MAX - 1) {
+        first = -EOVERFLOW;
+    }
+    if (!first) {
+        uint64_t serial = read->serial + 1;
+
+        *read = (QemuCrucibleSourcePendingOfferRead) {
+            .canonical_owner = read,
+            .member = member,
+            .lender = startup_source.publisher_lender,
+            .main = main,
+            .control = control,
+            .process = getpid(),
+            .serial = serial,
+            .main_serial = main->serial,
+            .control_serial = control->serial,
+            .busy = true,
+            .attempted = true,
+        };
+        qemu_thread_get_self(&read->thread);
+    }
+    qemu_mutex_unlock(&startup_source.commands.mutex);
+    if (first) {
+        return first;
+    }
+    first = qemu_crucible_preexec_publisher_offer_observe_v1(
+        read->lender, member, &read->observation);
+    /* These cuts and local physical return are independent of read/decode.
+     * A negative post withholds output but cannot recreate a returned read. */
+    post = pending_offer_post(read, first);
+    if (!first && !post) {
+        *out = (struct qemu_plugin_crucible_pending_offer_selection_v1) {
+            .schema_version = 1,
+            .struct_size = sizeof(*out),
+            .state = read->observation.state,
+            .publication_sequence = read->observation.state ?
+                read->observation.publication.sequence : 0,
+            .ticket_serial = read->observation.state ?
+                read->observation.publication.ticket_serial : 0,
+        };
+    }
+    return first ? first : post;
+#else
+    return -ENOTSUP;
+#endif
+}
diff --git a/plugins/crucible-plugin-worker.inc.h b/plugins/crucible-plugin-worker.inc.h
new file mode 100644
index 0000000000000000000000000000000000000000..285bcb3d2bfe4f61b54d877cbb931c9830a35411
--- /dev/null
+++ b/plugins/crucible-plugin-worker.inc.h
@@ -0,0 +1,1120 @@
+/*
+ * Shared Source-owned native lifetime for fingerprint, RUN and teardown workers
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Included once by startup-source.c. Role adapters retain their genuine claims,
+ * typed callbacks and role-specific borrowers; this file owns physical effects.
+ */
+#ifdef CONFIG_LINUX
+#include <link.h>
+#ifdef __GLIBC__
+#include <gnu/libc-version.h>
+#endif
+
+static bool plugin_worker_slot(QemuCruciblePluginWorker *worker)
+{
+    return worker == &startup_source.fingerprint_worker.native ||
+        worker == &startup_source.run_worker.native ||
+        worker == &startup_source.teardown_worker.native;
+}
+
+static int plugin_worker_identity(QemuCruciblePluginWorker *worker)
+{
+    if (!plugin_worker_slot(worker) || !worker->attempted || !worker->pins_held ||
+        getpid() != startup_source.owner_process ||
+        !qatomic_load_acquire(&startup_source.module_custody_published) ||
+        worker->installer.ctx != startup_source.saved.ctx ||
+        worker->installer.module != startup_source.saved.module ||
+        worker->installer.install != startup_source.saved.install ||
+        worker->runtime != &startup_source.runtime_purpose ||
+        worker->child != &startup_source.callbacks.owner || !worker->role_identity) {
+        return -EPERM;
+    }
+    return worker->role_identity(worker);
+}
+
+/* Typed SDK projections contain object pointers. memcpy observes their actual
+ * fields without accessing a typed pointer object through void **. */
+static void *plugin_worker_projection_read(const void *field)
+{
+    void *value;
+
+    memcpy(&value, field, sizeof(value));
+    return value;
+}
+
+static void plugin_worker_projection_write(void *field, void *value)
+{
+    memcpy(field, &value, sizeof(value));
+}
+
+static int plugin_worker_post(QemuCruciblePluginWorker *worker)
+{
+    uint64_t descriptor_limit;
+    int status = qemu_crucible_preexec_contract_check_v3(
+        startup_source.preexec_purpose_owner,
+        &worker->observation,
+        &descriptor_limit);
+
+    if (status && !worker->post_status) {
+        worker->post_status = status;
+    }
+    return status;
+}
+
+static int plugin_worker_stage_post(QemuCruciblePluginWorker *worker, int *journal)
+{
+    int status = plugin_worker_post(worker);
+
+    if (status && !*journal) {
+        *journal = status;
+    }
+    return status;
+}
+
+static int plugin_worker_holder_identity_locked(QemuCruciblePluginWorker *worker)
+{
+    uintptr_t field;
+    int status = plugin_worker_identity(worker);
+
+    if (status) {
+        return status;
+    }
+    status = callback_child_owner_identity_locked(worker->child);
+    if (status) {
+        return status;
+    }
+    if (worker->holder == &worker->creation_owner) {
+        return worker->creation_owner == worker->projection ? 0 : -ESTALE;
+    }
+    field = (uintptr_t)worker->holder;
+    if (!worker->holder || worker->creation_owner ||
+        worker->runtime_base != worker->child->runtime_base ||
+        worker->runtime_extent != worker->child->runtime_extent ||
+        !worker->runtime_base || worker->runtime_extent < sizeof(void *) ||
+        worker->runtime_extent > UINTPTR_MAX - worker->runtime_base ||
+        field < worker->runtime_base || field % _Alignof(QemuCruciblePluginWorker *) ||
+        field - worker->runtime_base > worker->runtime_extent - sizeof(void *) ||
+        plugin_worker_projection_read(worker->holder) != worker->projection) {
+        return -ESTALE;
+    }
+    return 0;
+}
+
+static bool plugin_worker_same_module(void *symbol)
+{
+    Dl_info actual, installer;
+
+    return symbol && dladdr(symbol, &actual) &&
+        dladdr((void *)startup_source.saved.install, &installer) &&
+        actual.dli_fbase == installer.dli_fbase;
+}
+
+typedef struct PluginTlsInventory {
+    uint64_t bytes;
+    uint64_t modules;
+    uint64_t max_modid;
+    uint64_t maximum_alignment;
+    int status;
+} PluginTlsInventory;
+
+static bool plugin_worker_add(uint64_t *total, uint64_t bytes)
+{
+    if (bytes > UINT64_MAX - *total) {
+        return false;
+    }
+    *total += bytes;
+    return true;
+}
+
+static int plugin_worker_tls(struct dl_phdr_info *info, size_t bytes,
+                                  void *opaque)
+{
+    PluginTlsInventory *inventory = opaque;
+
+    if (bytes < offsetof(struct dl_phdr_info, dlpi_tls_data) +
+                sizeof(info->dlpi_tls_data)) {
+        inventory->status = -ENOTSUP;
+        return 1;
+    }
+    /* A retired highest module id could leave a larger DTV namespace than
+     * the current PT_TLS roster exposes. This cohort retains every module. */
+    if (info->dlpi_subs) {
+        inventory->status = -ENOTSUP;
+        return 1;
+    }
+    inventory->max_modid = MAX(inventory->max_modid, info->dlpi_tls_modid);
+    for (size_t index = 0; index < info->dlpi_phnum; index++) {
+        const ElfW(Phdr) *header = &info->dlpi_phdr[index];
+        uint64_t alignment;
+
+        if (header->p_type != PT_TLS) {
+            continue;
+        }
+        alignment = MAX(header->p_align, 1);
+        if ((alignment & (alignment - 1)) ||
+            !plugin_worker_add(&inventory->bytes, header->p_memsz) ||
+            !plugin_worker_add(&inventory->bytes, alignment) ||
+            inventory->modules == UINT64_MAX) {
+            inventory->status = -EOVERFLOW;
+            return 1;
+        }
+        inventory->maximum_alignment = MAX(inventory->maximum_alignment, alignment);
+        inventory->modules++;
+    }
+    return 0;
+}
+
+static int plugin_worker_policy_read(QemuCruciblePluginWorker *worker,
+                                           const char *path, char *bytes, size_t capacity)
+{
+    ssize_t length;
+    int status = 0;
+
+    if (worker->policy_descriptor >= 0 || worker->policy_close_uncertain) {
+        return -EBUSY;
+    }
+    worker->policy_descriptor = open(path, O_RDONLY | O_CLOEXEC | O_NOFOLLOW);
+    if (worker->policy_descriptor < 0) {
+        return -errno;
+    }
+    length = read(worker->policy_descriptor, bytes, capacity - 1);
+    if (length < 0) {
+        status = -errno;
+    } else if (!length || length == capacity - 1) {
+        status = -EOVERFLOW;
+    } else {
+        bytes[length] = 0;
+    }
+    if (close(worker->policy_descriptor) < 0) {
+        worker->policy_close_uncertain = true;
+        return status ? status : -errno;
+    }
+    worker->policy_descriptor = -1;
+    return status;
+}
+
+static int plugin_worker_allocator_policy(QemuCruciblePluginWorker *worker)
+{
+#ifdef __GLIBC__
+    Dl_info allocator, libc;
+    char policy[128];
+    char *end;
+    uint64_t hugepage;
+    int status;
+
+    if ((strcmp(gnu_get_libc_version(), "2.39") &&
+         strcmp(gnu_get_libc_version(), "2.42")) ||
+        !dladdr((void *)malloc, &allocator) ||
+        !dladdr((void *)gnu_get_libc_version, &libc) ||
+        allocator.dli_fbase != libc.dli_fbase) {
+        return -ENOTSUP;
+    }
+    for (char **environment = environ; *environment; environment++) {
+        if (g_str_has_prefix(*environment, "MALLOC_") ||
+            g_str_has_prefix(*environment, "GLIBC_TUNABLES=") ||
+            g_str_has_prefix(*environment, "LD_PRELOAD=") ||
+            g_str_has_prefix(*environment, "LD_AUDIT=")) {
+            return -ENOTSUP;
+        }
+    }
+    status = plugin_worker_policy_read(worker,
+        "/sys/kernel/mm/transparent_hugepage/enabled", policy, sizeof(policy));
+    if (status == -ENOENT) {
+        /* Kernel without THP support; base-page commitment applies. */
+        return 0;
+    }
+    if (status) {
+        return status;
+    }
+    if (strstr(policy, "[never]") || strstr(policy, "[madvise]")) {
+        return 0;
+    }
+    if (!strstr(policy, "[always]")) {
+        return -ENOTSUP;
+    }
+    /* Default glibc does not request hugetlb. For system-wide THP promotion,
+     * derive physical rounding from the actual kernel PMD size. The Source
+     * stack separately opts out on its own mapping; no global policy changes. */
+    status = plugin_worker_policy_read(worker,
+        "/sys/kernel/mm/transparent_hugepage/hpage_pmd_size", policy, sizeof(policy));
+    if (status) {
+        return status;
+    }
+    errno = 0;
+    hugepage = strtoull(policy, &end, 10);
+    if (errno || end == policy || (*end && strcmp(end, "\n")) ||
+        !hugepage || (hugepage & (hugepage - 1))) {
+        return -EPROTO;
+    }
+    worker->backing_page_bytes = MAX(worker->backing_page_bytes, hugepage);
+    return 0;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+/* Audited against glibc-2.39 and glibc-2.42 malloc/{malloc,arena}.c,
+ * elf/dl-tunables.list, elf/dl-tls.c and nptl/{allocatestack,pthread_create}.c.
+ * These are committed-backing allowances, not the 64MiB
+ * PROT_NONE arena address reservation. Default top_pad is 128KiB; a new heap
+ * has a 32KiB minimum (also exceeding this build's heap_info + malloc_state +
+ * chunk headers). mmap-as-morecore has a 1MiB minimum. Two pages cover initial
+ * rounding and secondary brk alignment. Summing all three overbounds each
+ * allocation path, including a failed attempt followed by arena retry.
+ *
+ * The cohort has exactly one control allocation, four QEMU allocations
+ * (arguments, name, registry record and list cell), DTV, tcache, and at most
+ * one dynamic TLS allocation per loaded TLS module. Entry/job APIs allocate
+ * nothing. This reserve is historical: free, entry exit and join never refund
+ * allocator arenas, caches or TLS history. memory.max remains enforcement.
+ * The AOS glibc-2.39 source pin is the unmodified GNU release. Its 64-bin
+ * tcache is smaller than the 76-bin allowance below; heap/arena headers fit
+ * within the 32KiB minimum. Its DTV has the same 14 surplus entries and
+ * two header entries. User stacks contain the pthread/first TSD/static TLS,
+ * bypass guards/cache, and allocate only DTV plus dynamic TLS externally.
+ * First-thread late_init installs signals without allocating. Default attrs
+ * contain no extension allocation; this constructor uses explicit attrs.
+ * These bounds cover committed backing, including retained allocator/TLS
+ * history. Thread exit or join does not prove physical libc backing return.
+ * https://sourceware.org/git/?p=glibc.git;a=tree;hb=glibc-2.39
+ * https://sourceware.org/git/?p=glibc.git;a=tree;hb=glibc-2.42
+ */
+static int plugin_worker_backing(QemuCruciblePluginWorker *worker)
+{
+    PluginTlsInventory inventory = { 0 };
+    uint64_t page, minimum, requests, entries, per_entry, residual;
+    long queried_page = sysconf(_SC_PAGESIZE);
+    long queried_minimum = sysconf(_SC_THREAD_STACK_MIN);
+    int status;
+
+    worker->backing_page_bytes = queried_page > 0 ? queried_page : 0;
+    status = plugin_worker_allocator_policy(worker);
+
+    if (status || sizeof(void *) != 8 || queried_page <= 0 || queried_minimum <= 0) {
+        return status ? status : -ENOTSUP;
+    }
+    /* No mallopt or allocator substitution is permitted in this matched
+     * constructor/entry cohort. Reject loader/tunable changes rather than
+     * changing global allocator policy to fit an assumed bound. */
+    dl_iterate_phdr(plugin_worker_tls, &inventory);
+    if (inventory.status) {
+        return inventory.status;
+    }
+    page = queried_page;
+    minimum = queried_minimum;
+    if ((page & (page - 1)) ||
+        !plugin_worker_add(&minimum, inventory.bytes) ||
+        !plugin_worker_add(&minimum, inventory.maximum_alignment) ||
+        worker->layout.stack_bytes < minimum || worker->layout.stack_bytes % page) {
+        return -EINVAL;
+    }
+    /* allocatestack.c places the TCB and static TLS in the user mapping.
+     * The native minimum additionally covers the pinned TCB/static surplus;
+     * dynamic TLS is separately overcounted below to avoid claiming free TLS.
+     * DTV consists of two-pointer entries, max_modid + DTV_SURPLUS(14) + 2.
+     * tcache has 64 small + 12 large bins, each uint16_t and one pointer. */
+    if (inventory.max_modid > UINT64_MAX / (2 * sizeof(void *)) - 16) {
+        return -EOVERFLOW;
+    }
+    /* The complete WORKER_CONTROL request was already debited by the runtime
+     * roster. This additional reserve pays allocator alignment/backing, not
+     * that same language-owned storage a second time. */
+    requests = worker->layout.control_alignment;
+    if (!plugin_worker_add(&requests, qemu_thread_bounded_control_bytes(
+            strlen(worker->thread_name) + 1)) ||
+        !plugin_worker_add(&requests,
+            (inventory.max_modid + 16) * 2 * sizeof(void *)) ||
+        !plugin_worker_add(&requests, 76 * (sizeof(uint16_t) + sizeof(void *))) ||
+        !plugin_worker_add(&requests, inventory.bytes)) {
+        return -EOVERFLOW;
+    }
+    entries = inventory.modules;
+    if (!plugin_worker_add(&entries, 7)) {
+        return -EOVERFLOW;
+    }
+    per_entry = 32768 + 131072 + 1048576;
+    if (worker->backing_page_bytes > UINT64_MAX / 3 ||
+        !plugin_worker_add(&per_entry, 3 * worker->backing_page_bytes) ||
+        entries > UINT64_MAX / per_entry) {
+        return -EOVERFLOW;
+    }
+    residual = entries * per_entry;
+    if (!plugin_worker_add(&residual, requests)) {
+        return -EOVERFLOW;
+    }
+    worker->tls_bytes = inventory.bytes;
+    worker->tls_modules = inventory.modules;
+    worker->tls_max_modid = inventory.max_modid;
+    worker->residual_bytes = residual;
+    return 0;
+}
+
+static int plugin_worker_frame(QemuCruciblePluginWorker *worker, bool destroying)
+{
+    int status = plugin_worker_identity(worker);
+
+    if (!status && (!worker->frame.entered ||
+        worker->frame.destroying != destroying ||
+        !qemu_thread_is_self(&worker->frame.thread))) {
+        status = -EPERM;
+    }
+    return status;
+}
+
+static int plugin_worker_allocation_begin(QemuCruciblePluginWorker *worker)
+{
+    int status = plugin_worker_frame(worker, false);
+
+    if (status) {
+        return status;
+    }
+    if (worker->allocation_attempted) {
+        return -EALREADY;
+    }
+    worker->allocation_attempted = true;
+    return 0;
+}
+
+static int plugin_worker_allocation_result(QemuCruciblePluginWorker *worker,
+                                          void *allocation, void *owning_alias)
+{
+    int status = plugin_worker_frame(worker, false);
+
+    if (status) {
+        return status;
+    }
+    if (!worker->allocation_attempted || worker->allocation_returned ||
+        (!!allocation != !!owning_alias) ||
+        (allocation && (uintptr_t)allocation % worker->layout.control_alignment)) {
+        return -EINVAL;
+    }
+    worker->allocation = allocation;
+    worker->owning_alias = owning_alias;
+    worker->allocation_returned = true;
+    return 0;
+}
+
+static int plugin_worker_initialized(QemuCruciblePluginWorker *worker)
+{
+    int status = plugin_worker_frame(worker, false);
+
+    if (status) {
+        return status;
+    }
+    if (!worker->allocation_returned || !worker->owning_alias || worker->initialized) {
+        return -EINVAL;
+    }
+    worker->initialized = true;
+    return 0;
+}
+
+static int plugin_worker_destroyed(QemuCruciblePluginWorker *worker)
+{
+    int status = plugin_worker_frame(worker, true);
+
+    if (status) {
+        return status;
+    }
+    qemu_mutex_lock(&startup_source.commands.mutex);
+    if (!worker->destroy_attempted || !worker->destruction_active ||
+        worker->owning_alias || worker->destroyed) {
+        status = -EINVAL;
+    } else {
+        worker->destroyed = true;
+    }
+    qemu_mutex_unlock(&startup_source.commands.mutex);
+    return status;
+}
+
+static int plugin_worker_destroy_begin(QemuCruciblePluginWorker *worker)
+{
+    int status = plugin_worker_frame(worker, true);
+
+    if (status) {
+        return status;
+    }
+    qemu_mutex_lock(&startup_source.commands.mutex);
+    status = worker->control_lifetime_uncertain ? worker->control_lifetime_status :
+        plugin_worker_holder_identity_locked(worker);
+    if (!status && (worker->destroy_attempted || worker->destroyed)) {
+        status = -EALREADY;
+    }
+    if (!status && (!worker->destruction_active || !worker->transition_active ||
+        worker->destruction_uncertain || !worker->closing || worker->control_users ||
+        (worker->birth.born && !worker->joined) ||
+        (worker->initialized && (!worker->close_attempted || !worker->close_returned)) ||
+        !worker->owning_alias || worker->owning_alias != worker->destruction_alias ||
+        (worker->borrowers_held && worker->borrowers_held(worker)))) {
+        status = -EBUSY;
+    }
+    if (!status) {
+        /* Only the entered module, after its real uniqueness/upgrade
+         * exclusion, may begin the once-only physical owning drop. */
+        worker->destroy_attempted = true;
+    }
+    qemu_mutex_unlock(&startup_source.commands.mutex);
+    return status;
+}
+
+static int plugin_worker_control_scope(qemu_plugin_id_t id,
+    QemuCruciblePluginWorker *worker, void *synchronous_input, bool terminal,
+    int (*invoke)(QemuCruciblePluginWorker *, void *, void *),
+    int (*admit_locked)(QemuCruciblePluginWorker *))
+{
+    void *owning_alias = NULL;
+    int status;
+    int consistency;
+
+    if (!plugin_worker_slot(worker) ||
+        !qatomic_load_acquire(&startup_source.module_custody_published) ||
+        !qatomic_load_acquire(&startup_source.commands.initialized) ||
+        getpid() != startup_source.owner_process ||
+        id != startup_source.saved.plugin_id ||
+        (terminal && (!qemu_in_main_thread() || !startup_owner()))) {
+        return -EPERM;
+    }
+    qemu_mutex_lock(&startup_source.commands.mutex);
+    status = worker->control_lifetime_uncertain ? worker->control_lifetime_status :
+        plugin_worker_holder_identity_locked(worker);
+    if (!status && (worker->transition_active || worker->destroy_attempted ||
+        worker->destruction_active || worker->destruction_uncertain || worker->destroyed)) {
+        status = -EBUSY;
+    }
+    if (!status && ((!terminal && worker->closing) ||
+        (terminal && (!worker->closing || !worker->close_attempted ||
+                      !worker->close_returned)))) {
+        status = -ESHUTDOWN;
+    }
+    if (!status && (!worker->initialized || !worker->construction_returned ||
+        !worker->owning_alias || !invoke)) {
+        status = -ENOKEY;
+    }
+    if (!status && worker->control_users == UINT64_MAX) {
+        status = -EOVERFLOW;
+    }
+    if (!status && admit_locked) {
+        /* Source admission and the actual user pin are one locked cut.
+         * An uninvoked refusal is not a returned module/control failure. */
+        status = admit_locked(worker);
+    }
+    if (!status) {
+        worker->control_users++;
+        owning_alias = worker->owning_alias;
+    }
+    qemu_mutex_unlock(&startup_source.commands.mutex);
+    if (status) {
+        return status;
+    }
+
+    status = invoke(worker, owning_alias, synchronous_input);
+    if (status > 0) {
+        status = -EPROTO;
+    }
+    qemu_mutex_lock(&startup_source.commands.mutex);
+    consistency = worker->control_lifetime_uncertain ? 0 :
+        !worker->control_users ? -EPROTO :
+        plugin_worker_holder_identity_locked(worker);
+    if (!worker->control_lifetime_uncertain && !consistency &&
+        (worker->owning_alias != owning_alias || worker->destroy_attempted)) {
+        consistency = -EPROTO;
+    }
+    if (consistency && !worker->control_lifetime_uncertain) {
+        /* Keep the admitted owner and first disproven invariant even when
+         * the module already returned a different semantic failure. */
+        worker->control_lifetime_alias = owning_alias;
+        worker->control_lifetime_status = consistency;
+        worker->control_lifetime_uncertain = true;
+    }
+    if (worker->control_lifetime_uncertain) {
+        /* A broken lifetime journal cannot be repaired by later returns.
+         * Callback outputs remain owned independently of this status. */
+        status = status ? status : worker->control_lifetime_status;
+    } else {
+        /* Only a proven actual return ends its synchronous physical use. */
+        worker->control_users--;
+    }
+    /* Semantic failure permits later cleanup scopes, but no successful
+     * return erases health failure or repairs uncertain lifetime custody. */
+    if (status && !worker->control_status) {
+        worker->control_status = status;
+    }
+    if (status && !worker->first_status) {
+        worker->first_status = status;
+    }
+    qemu_cond_broadcast(&worker->wake);
+    qemu_mutex_unlock(&startup_source.commands.mutex);
+    return status;
+}
+
+static void *plugin_worker_entry(void *opaque)
+{
+    QemuCruciblePluginWorker *worker = opaque;
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    int status = qemu_thread_bounded_self_current(&worker->thread, worker,
+                                                 &worker->birth);
+
+    qemu_mutex_lock(&commands->mutex);
+    worker->enrollment_status = status;
+    worker->enrollment_returned = true;
+    qemu_cond_broadcast(&worker->wake);
+    while (!worker->entry_released) {
+        qemu_cond_wait(&worker->wake, &commands->mutex);
+    }
+    status = status ? status : -ECANCELED;
+    if (!worker->enrollment_status && worker->birth.born &&
+        qemu_thread_is_self(&worker->thread) && worker->entry_allowed && !worker->closing && worker->initialized &&
+        worker->owning_alias && !plugin_worker_identity(worker)) {
+        worker->entry_entered = true;
+        if (worker == &startup_source.run_worker.native) {
+            /* The sole RUN reader does not enter module code until the
+             * actual sole stream has moved and its handoff callback returned. */
+            worker->ready = true;
+            qemu_cond_broadcast(&worker->wake);
+            while (!worker->handoff_released && !worker->closing) {
+                qemu_cond_wait(&worker->wake, &commands->mutex);
+            }
+        }
+        if (!worker->closing) {
+            qemu_mutex_unlock(&commands->mutex);
+            status = worker->entry(worker, worker->owning_alias);
+            qemu_mutex_lock(&commands->mutex);
+        }
+    }
+    worker->entry_status = status;
+    worker->entry_returned = true;
+    worker->entry_allowed = false;
+    qemu_cond_broadcast(&worker->wake);
+    qemu_mutex_unlock(&commands->mutex);
+    return NULL;
+}
+
+/* Planning is a retained preeffect debit, not a layout-based issuer. The
+ * runtime roster already pays the actual complete control allocation. */
+static int plugin_worker_fund(QemuCruciblePluginWorker *worker)
+{
+    int status;
+
+    if (worker->funding_attempted) {
+        return worker->funding_status;
+    }
+    worker->funding_attempted = true;
+    status = plugin_worker_backing(worker);
+    if (!status) {
+        status = crucible_metadata_native_admit(&startup_source.metadata_partition,
+            worker->residual_bytes, &worker->residual_charge);
+    }
+    if (!status) {
+        status = crucible_metadata_native_admit(&startup_source.metadata_partition,
+            worker->layout.stack_bytes, &worker->stack_charge);
+    }
+    worker->funding_status = status;
+    return status;
+}
+
+static int plugin_worker_enrollment(qemu_plugin_id_t id,
+                                    QemuCruciblePluginWorker *worker)
+{
+    uint64_t bounded_ns;
+    int status;
+
+    for (;;) {
+        /* Query this same genuine Setup Original outside the native locks.
+         * A timeout/refusal keeps the actual born owner for close and join. */
+        status = qemu_plugin_crucible_startup_source_query_slice_v1(id, &bounded_ns);
+        if (status) {
+            break;
+        }
+        qemu_mutex_lock(&startup_source.commands.mutex);
+        if (worker->enrollment_returned) {
+            status = worker->enrollment_status;
+            qemu_mutex_unlock(&startup_source.commands.mutex);
+            break;
+        }
+        qemu_cond_timedwait(&worker->wake, &startup_source.commands.mutex,
+            MIN(bounded_ns / 1000000 + !!(bounded_ns % 1000000), INT_MAX));
+        qemu_mutex_unlock(&startup_source.commands.mutex);
+    }
+    if (!status) {
+        status = qemu_thread_bounded_current(&worker->thread, worker, &worker->birth);
+    }
+    worker->enrollment_admission_status = status;
+    /* An independent post cannot erase the actual enrollment result. */
+    plugin_worker_stage_post(worker, &worker->enrollment_post_status);
+    return status;
+}
+
+static int plugin_worker_birth(qemu_plugin_id_t id, QemuCruciblePluginWorker *worker,
+                               void *synchronous_input)
+{
+    int status = plugin_worker_fund(worker);
+
+    if (!status) {
+        worker->frame.entered = true;
+        qemu_thread_get_self(&worker->frame.thread);
+        status = worker->construct(worker, synchronous_input);
+        worker->frame.entered = false;
+        worker->construction_returned = true;
+        if (!worker->allocation_attempted || !worker->allocation_returned ||
+            (worker->owning_alias && !worker->initialized)) {
+            status = status ? status : -EPROTO;
+        } else if (!worker->owning_alias) {
+            status = status ? status : -ENOMEM;
+        }
+    }
+    if (!status) {
+        status = startup_runtime_admission(id, worker->runtime);
+    }
+    if (!status) {
+        worker->stack = mmap(NULL, worker->layout.stack_bytes,
+            PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_STACK, -1, 0);
+        if (worker->stack == MAP_FAILED) {
+            worker->stack = NULL;
+            status = -errno;
+        } else if (madvise(worker->stack, worker->layout.stack_bytes,
+                           MADV_DONTFORK) < 0) {
+            status = -errno;
+        } else if (madvise(worker->stack, worker->layout.stack_bytes,
+                           MADV_NOHUGEPAGE) < 0) {
+            status = -errno;
+        }
+    }
+    if (!status && !worker->task_reserved) {
+        status = startup_task_reserve(&worker->task_reserved);
+    }
+    if (!status) {
+        status = qemu_thread_create_bounded(&worker->thread, worker->thread_name,
+            plugin_worker_entry, worker, worker->stack,
+            worker->layout.stack_bytes, &worker->birth);
+    }
+    if (!worker->birth.born && worker->task_reserved) {
+        int returned = startup_task_physical_return(&worker->task_reserved);
+
+        if (returned && !worker->task_return_status) {
+            worker->task_return_status = returned;
+        }
+        status = status ? status : returned;
+    }
+    if (worker->birth.born) {
+        int enrollment = plugin_worker_enrollment(id, worker);
+
+        status = status ? status : enrollment;
+    }
+    worker->first_status = status;
+    plugin_worker_post(worker);
+    qemu_mutex_lock(&startup_source.commands.mutex);
+    worker->entry_allowed = !worker->first_status && !worker->post_status;
+    worker->entry_released = true;
+    worker->transition_active = false;
+    qemu_cond_broadcast(&worker->wake);
+    qemu_mutex_unlock(&startup_source.commands.mutex);
+    return worker->first_status ? worker->first_status : worker->post_status;
+}
+
+static int plugin_worker_close(
+    qemu_plugin_id_t id, QemuCruciblePluginWorker *worker)
+{
+    void *owning_alias = NULL;
+    int status;
+    bool invoke = false;
+    bool admitted = false;
+
+    if (!plugin_worker_slot(worker) ||
+        !qatomic_load_acquire(&startup_source.module_custody_published) ||
+        !qatomic_load_acquire(&startup_source.commands.initialized) ||
+        id != startup_source.saved.plugin_id || !startup_owner()) {
+        return -EPERM;
+    }
+    qemu_mutex_lock(&startup_source.commands.mutex);
+    status = worker->control_lifetime_uncertain ? plugin_worker_identity(worker) :
+        plugin_worker_holder_identity_locked(worker);
+    if (!status && worker->transition_active) {
+        status = -EBUSY;
+    }
+    if (!status) {
+        /* Close admission before draining existing synchronous aliases.
+         * The module close gate then excludes its own weak-upgrade paths. */
+        admitted = true;
+        worker->closing = true;
+        status = worker->cancel_pending ? worker->cancel_pending(worker) : 0;
+        if (worker == &startup_source.run_worker.native &&
+            !worker->handoff_committed && !worker->handoff_active) {
+            worker->cancelled_before_handoff = true;
+        }
+        if (!status && worker->control_lifetime_uncertain) {
+            status = worker->control_lifetime_status;
+        } else if (!status && worker->control_users) {
+            status = -EBUSY;
+        } else if (!status && worker->initialized && worker->owning_alias && !worker->close_attempted) {
+            worker->close_attempted = true;
+            worker->transition_active = true;
+            owning_alias = worker->owning_alias;
+            invoke = true;
+        }
+        qemu_cond_broadcast(&worker->wake);
+    }
+    qemu_mutex_unlock(&startup_source.commands.mutex);
+    if (admitted && worker->birth.born) {
+        int registry = qemu_thread_bounded_close(&worker->thread, worker,
+                                                 &worker->birth);
+
+        if (registry && !worker->registry_close_status) {
+            worker->registry_close_status = registry;
+        }
+        status = status ? status : registry;
+    }
+    if (invoke) {
+        int preclose = status;
+
+        status = worker->close(worker, owning_alias);
+        qemu_mutex_lock(&startup_source.commands.mutex);
+        worker->close_status = status;
+        worker->close_returned = true;
+        worker->transition_active = false;
+        if (status && !worker->first_status) {
+            worker->first_status = status;
+        }
+        qemu_mutex_unlock(&startup_source.commands.mutex);
+        status = preclose ? preclose : status;
+    }
+    if (admitted && worker != &startup_source.fingerprint_worker.native) {
+        int post = plugin_worker_post(worker);
+
+        if (post && !worker->close_post_status) {
+            worker->close_post_status = post;
+        }
+        status = status ? status : post;
+    }
+    return status;
+}
+
+static int plugin_worker_tryjoin(
+    qemu_plugin_id_t id, QemuCruciblePluginWorker *worker)
+{
+    int status;
+    int independent_post = 0;
+    bool destroy = false;
+
+    if (!plugin_worker_slot(worker) ||
+        !qatomic_load_acquire(&startup_source.module_custody_published) ||
+        !qatomic_load_acquire(&startup_source.commands.initialized) ||
+        id != startup_source.saved.plugin_id || !startup_owner()) {
+        return -EPERM;
+    }
+    qemu_mutex_lock(&startup_source.commands.mutex);
+    status = worker->control_lifetime_uncertain ? plugin_worker_identity(worker) :
+        plugin_worker_holder_identity_locked(worker);
+    if (!status && worker->destruction_uncertain) {
+        status = worker->destruction_first_status ? worker->destruction_first_status : -EIO;
+    }
+    if (!status && (!worker->closing || worker->transition_active ||
+        worker->destruction_active)) {
+        status = -EBUSY;
+    }
+    if (!status && !worker->control_lifetime_uncertain && (worker->control_users ||
+        (worker->borrowers_held && worker->borrowers_held(worker)) || worker->policy_close_uncertain ||
+        (worker->initialized && (!worker->close_attempted || !worker->close_returned)))) {
+        status = -EBUSY;
+    }
+    if (!status) {
+        worker->transition_active = true;
+    }
+    qemu_mutex_unlock(&startup_source.commands.mutex);
+    if (status) {
+        return status;
+    }
+    if (worker->birth.born && !worker->joined) {
+        void *physical_result;
+
+        status = qemu_thread_bounded_tryjoin(&worker->thread, worker,
+                                             &worker->birth, &physical_result);
+        qemu_mutex_lock(&startup_source.commands.mutex);
+        worker->join_status = status;
+        if (!status) {
+            worker->joined_result = physical_result;
+            worker->joined = true;
+            if (!worker->entry_returned) {
+                status = -EPROTO;
+            }
+        }
+        qemu_mutex_unlock(&startup_source.commands.mutex);
+        if (!status && worker != &startup_source.fingerprint_worker.native) {
+            independent_post = plugin_worker_stage_post(worker, &worker->join_post_status);
+        }
+    }
+    if (!status && worker->task_reserved) {
+        /* A closed creator with a definite no-birth receipt can return its
+         * retained reservation without inventing join or entry-return facts.
+         * An inconsistent attempted birth remains unreturned task debt. */
+        bool no_birth = !worker->birth.born &&
+            (!worker->birth.birth_attempted || worker->birth.create_status < 0);
+
+        if (worker->joined || no_birth) {
+            int returned = startup_task_physical_return(&worker->task_reserved);
+
+            if (returned && !worker->task_return_status) {
+                worker->task_return_status = returned;
+            }
+            status = returned;
+        } else {
+            status = -EPROTO;
+        }
+    }
+    if (!status) {
+        qemu_mutex_lock(&startup_source.commands.mutex);
+        /* Actual join/task return above consumes no uncertain control owner.
+         * Destruction, unmap and borrower return still require proven custody. */
+        if (worker->control_lifetime_uncertain) {
+            status = worker->control_lifetime_status;
+        } else if (worker->owning_alias && !worker->destroy_attempted) {
+            if (!worker->destroy || worker->destruction_calls == UINT64_MAX) {
+                status = worker->destroy ? -EOVERFLOW : -ENOKEY;
+            } else {
+                worker->destruction_calls++;
+                worker->destruction_active = true;
+                worker->destruction_returned = false;
+                worker->destruction_alias = worker->owning_alias;
+                worker->frame.destroying = true;
+                worker->frame.entered = true;
+                qemu_thread_get_self(&worker->frame.thread);
+                destroy = true;
+            }
+        }
+        qemu_mutex_unlock(&startup_source.commands.mutex);
+    }
+    if (destroy) {
+        status = worker->destroy(worker, &worker->owning_alias);
+        if (status > 0) {
+            status = -EPROTO;
+        }
+        qemu_mutex_lock(&startup_source.commands.mutex);
+        worker->frame.entered = false;
+        worker->destruction_active = false;
+        worker->destruction_returned = true;
+        worker->destructor_status = status;
+        if (!worker->destroy_attempted) {
+            /* A returned preflight refusal may retry only while the exact
+             * owning alias is unchanged and no physical begin was admitted. */
+            if (worker->owning_alias != worker->destruction_alias || !status) {
+                worker->destruction_uncertain = true;
+                status = status ? status : -EPROTO;
+            }
+        } else if (!worker->destroyed || worker->owning_alias) {
+            /* Once begun, absent final acknowledgement retains uncertainty;
+             * neither an errno nor another tryjoin can repeat physical drop. */
+            worker->destruction_uncertain = true;
+            status = status ? status : -EPROTO;
+        }
+        if (worker->destruction_uncertain && !worker->destruction_first_status) {
+            /* Last callback return and first physical uncertainty are
+             * independent; a no-effect preflight creates no uncertainty. */
+            worker->destruction_first_status = status ? status : -EIO;
+        }
+        if (status && !worker->first_status) {
+            worker->first_status = status;
+        }
+        qemu_mutex_unlock(&startup_source.commands.mutex);
+        if (worker != &startup_source.fingerprint_worker.native) {
+            int post = plugin_worker_stage_post(worker, &worker->destruction_post_status);
+
+            independent_post = independent_post ? independent_post : post;
+        }
+    }
+    /* An unacknowledged allocation or destruction stays exact negative
+     * custody. Callback status alone never proves physical final return. */
+    if (!status && ((!worker->construction_returned && worker->allocation_attempted) ||
+        (worker->allocation_attempted && !worker->allocation_returned) ||
+        (worker->allocation && (!worker->destroyed || !worker->destruction_returned)))) {
+        status = -EBUSY;
+    }
+    if (!status && worker->stack && !worker->unmap_attempted) {
+        worker->unmap_attempted = true;
+        worker->unmap_status = munmap(worker->stack, worker->layout.stack_bytes) < 0 ?
+            -errno : 0;
+        if (!worker->unmap_status) {
+            worker->stack = NULL;
+            if (worker != &startup_source.fingerprint_worker.native) {
+                int post = plugin_worker_stage_post(worker, &worker->unmap_post_status);
+
+                independent_post = independent_post ? independent_post : post;
+            }
+        }
+    }
+    if (!status && worker->unmap_status) {
+        status = worker->unmap_status;
+    }
+    if (!status && !worker->stack && worker->stack_charge.held) {
+        int retired = crucible_metadata_native_retire(&startup_source.metadata_partition,
+                                                     &worker->stack_charge);
+
+        if (retired && !worker->stack_retire_status) {
+            worker->stack_retire_status = retired;
+        }
+        status = retired;
+    }
+    if (!status && worker->birth.canonical_owner &&
+        !worker->birth.identity_returned) {
+        int returned = qemu_thread_bounded_identity_return(&worker->thread,
+                                                          worker, &worker->birth);
+
+        if (returned && !worker->registry_identity_return_status) {
+            worker->registry_identity_return_status = returned;
+        }
+        status = returned;
+        if (!returned && worker != &startup_source.fingerprint_worker.native) {
+            int post = plugin_worker_stage_post(worker,
+                &worker->registry_identity_return_post_status);
+
+            independent_post = independent_post ? independent_post : post;
+        }
+    }
+    qemu_mutex_lock(&startup_source.commands.mutex);
+    if (!status && !worker->stack && !worker->stack_charge.held &&
+        !worker->owning_alias && !worker->task_reserved &&
+        (!worker->birth.born || (worker->joined && worker->entry_returned)) &&
+        !(worker->borrowers_held && worker->borrowers_held(worker)) && !worker->control_users &&
+        !worker->destruction_active && !worker->destruction_uncertain &&
+        !worker->control_lifetime_uncertain) {
+        if (worker->release_role) {
+            worker->release_role(worker);
+        }
+        worker->child->component_users--;
+        worker->child->child->physical_users--;
+        worker->pins_held = false;
+        worker->physical_returned = true;
+    }
+    worker->transition_active = false;
+    qemu_mutex_unlock(&startup_source.commands.mutex);
+    return status ? status : independent_post;
+}
+
+static int plugin_worker_transfer(qemu_plugin_id_t id,
+                                  QemuCruciblePluginWorker *worker,
+                                  void *projection, void *runtime_field)
+{
+    uintptr_t field = (uintptr_t)runtime_field;
+    int status = plugin_worker_identity(worker);
+
+    if (status || id != startup_source.saved.plugin_id || !startup_invocation(id) ||
+        !projection || !runtime_field || projection == runtime_field) {
+        return status ? status : -EPERM;
+    }
+    if (fingerprint_output_workspace_overlap(projection, sizeof(void *)) ||
+        fingerprint_output_workspace_overlap(runtime_field, sizeof(void *))) {
+        return -EINVAL;
+    }
+    qemu_mutex_lock(&startup_source.commands.mutex);
+    if (worker->transition_active || worker->closing || worker->control_lifetime_uncertain ||
+        worker->holder != &worker->creation_owner ||
+        worker->creation_owner != worker->projection ||
+        !worker->runtime_base || worker->runtime_extent < sizeof(void *) ||
+        worker->runtime_extent > UINTPTR_MAX - worker->runtime_base ||
+        field < worker->runtime_base || field % _Alignof(void *) ||
+        field - worker->runtime_base > worker->runtime_extent - sizeof(void *) ||
+        callback_child_output_conflicts_locked(runtime_field, sizeof(void *)) ||
+        callback_child_output_conflicts_locked(projection, sizeof(void *)) ||
+        callback_child_output_overlap(projection, sizeof(void *), runtime_field, sizeof(void *)) ||
+        plugin_worker_projection_read(projection) != worker->projection ||
+        plugin_worker_projection_read(runtime_field)) {
+        status = -EINVAL;
+    } else {
+        plugin_worker_projection_write(runtime_field, worker->projection);
+        plugin_worker_projection_write(projection, NULL);
+        worker->creation_owner = NULL;
+        worker->holder = runtime_field;
+    }
+    qemu_mutex_unlock(&startup_source.commands.mutex);
+    if (!status) {
+        status = plugin_worker_post(worker);
+        if (status && !worker->transfer_post_status) {
+            worker->transfer_post_status = status;
+        }
+    }
+    return status;
+}
+
+static int plugin_worker_enrollment_observe(qemu_plugin_id_t id,
+    QemuCruciblePluginWorker *worker,
+    struct qemu_plugin_crucible_worker_enrollment_status_v1 *out)
+{
+    QemuThreadBoundedCreateReceipt facts = { 0 };
+    int status;
+
+    if (!plugin_worker_slot(worker) || !worker->attempted || !out ||
+        id != startup_source.saved.plugin_id || !startup_owner() ||
+        callback_child_output_overlap(out, sizeof(*out), &startup_source,
+                                      sizeof(startup_source))) {
+        return -EPERM;
+    }
+    if (fingerprint_output_workspace_overlap(out, sizeof(*out)) ||
+        out->schema_version != 1 || out->struct_size != sizeof(*out)) {
+        return -EINVAL;
+    }
+    /* Native registry facts use its own mutex, never the Source mutex. These
+     * are independent observations, not an atomic activation/return receipt. */
+    if (worker->birth.canonical_owner) {
+        status = qemu_thread_bounded_observe(&worker->thread, worker,
+                                             &worker->birth, &facts);
+        if (status) {
+            return status;
+        }
+    }
+    qemu_mutex_lock(&startup_source.commands.mutex);
+    *out = (struct qemu_plugin_crucible_worker_enrollment_status_v1) {
+        .schema_version = 1,
+        .struct_size = sizeof(*out),
+        .birth_generation = facts.birth_generation,
+        .native_enrollment_status = facts.enrollment_status,
+        .entry_enrollment_status = worker->enrollment_status,
+        .creator_enrollment_status = worker->enrollment_admission_status,
+        .enrollment_post_status = worker->enrollment_post_status,
+        .registry_close_status = worker->registry_close_status,
+        .registry_return_status = facts.registry_return_status,
+        .registry_identity_return_status = worker->registry_identity_return_status,
+        .registry_identity_return_post_status =
+            worker->registry_identity_return_post_status,
+        .entry_enrollment_returned = worker->enrollment_returned,
+        .native_enrollment_complete = facts.enrollment_complete,
+        .registry_registered = facts.registry_registered,
+        .registry_returned = facts.registry_returned,
+        .native_closing = facts.closing,
+        .native_joined = facts.joined,
+        .native_identity_returned = facts.identity_returned,
+    };
+    qemu_mutex_unlock(&startup_source.commands.mutex);
+    return 0;
+}
+
+static int plugin_worker_identity_return(qemu_plugin_id_t id,
+                                         QemuCruciblePluginWorker *worker,
+                                         void *holder)
+{
+    int status = 0;
+
+    if (!plugin_worker_slot(worker) || !holder || id != startup_source.saved.plugin_id ||
+        !startup_owner() ||
+        !qatomic_load_acquire(&startup_source.commands.initialized)) {
+        return -EPERM;
+    }
+    if (fingerprint_output_workspace_overlap(holder, sizeof(void *)) ||
+        callback_child_output_overlap(holder, sizeof(void *), &startup_source, sizeof(startup_source))) {
+        return -EINVAL;
+    }
+    if (plugin_worker_projection_read(holder) != worker->projection) {
+        return -EPERM;
+    }
+    qemu_mutex_lock(&startup_source.commands.mutex);
+    if (worker->control_lifetime_uncertain) {
+        status = worker->control_lifetime_status;
+    } else if ((worker->holder != holder && worker->holder != &worker->creation_owner) ||
+        !worker->physical_returned || worker->pins_held || worker->transition_active) {
+        status = -EPERM;
+    } else {
+        plugin_worker_projection_write(holder, NULL);
+        worker->holder = NULL;
+        worker->creation_owner = NULL;
+    }
+    qemu_mutex_unlock(&startup_source.commands.mutex);
+    return status;
+}
