+    qemu_mutex_lock(&startup_source.commands.mutex);
+    work = fingerprint_work_ref(worker, projection);
+    if (!work || !qemu_thread_is_self(&work->material->operation.thread)) {
+        status = -ESTALE;
+        goto out;
+    }
+    work->return_attempted = true;
+    if (worker->completed_count > G_N_ELEMENTS(worker->completed)) {
+        status = -EOVERFLOW;
+    }
+    for (completed_index = 0; !status && completed_index < worker->completed_count; completed_index++) {
+        if (worker->completed[completed_index] == work) {
+            break;
+        }
+    }
+    if (!status && (work->bytes_held || !work->completed || completed_index == worker->completed_count ||
+        worker->active == work || worker->pending == work)) {
+        status = -EBUSY;
+    }
+    work->return_status = status;
+    if (status && !work->return_first_status) {
+        work->return_first_status = status;
+    }
+    if (!status) {
+        QemuCrucibleFingerprintMaterial *material = work->material;
+
+        /* Consume only this completed incarnation. Other slots may still
+         * own the one workspace or a pending job; they do not delay return. */
+        *result = work->result;
+        *projection = (QemuCrucibleFingerprintWorkRef) { 0 };
+        for (size_t index = completed_index + 1; index < worker->completed_count; index++) {
+            worker->completed[index - 1] = worker->completed[index];
+        }
+        worker->completed[--worker->completed_count] = NULL;
+        work->main_returned = true;
+        material->work_returned = true;
+        material->work = NULL;
+        work->material_held = false;
+        material->returned_work = *work;
+        work->material = NULL;
+        qemu_cond_broadcast(&worker->native.wake);
+    }
+out:
+    qemu_mutex_unlock(&startup_source.commands.mutex);
+    return status;
+}
