+        qemu_put_be16(f, tco->tco.sts1);
+        qemu_put_be16(f, tco->tco.sts2);
+        qemu_put_be16(f, tco->tco.cnt1);
+        qemu_put_be16(f, tco->tco.cnt2);
+        qemu_put_byte(f, tco->tco.msg1);
+        qemu_put_byte(f, tco->tco.msg2);
