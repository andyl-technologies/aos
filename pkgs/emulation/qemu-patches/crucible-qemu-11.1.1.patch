@@ -0,0 +1,220 @@
+/*
+ * Private subscription receipt storage in the actual preexec singleton.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+/* These are retained physical-return journals, not public wire layouts. Their
+ * storage has a real preexec debit; absent paired input creates no alias, map,
+ * session borrower or operation membership. A later matched constructor must
+ * journal each actual acquisition before any fallible independent post. */
+typedef struct PreexecPublisherAliasJournal {
+    struct stat identity;
+    uint64_t event_token;
+    int descriptor;
+    int first_status;
+    int post_status;
+    int return_status;
+    bool received;
+    bool close_attempted;
+    bool physically_returned;
+    bool uncertain;
+} PreexecPublisherAliasJournal;
+
+typedef struct PreexecPublisherMappingJournal {
+    uint64_t *address;
+    uint64_t requested_bytes;
+    uint64_t backing_bytes;
+    int first_status;
+    int post_status;
+    int return_status;
+    bool attempted;
