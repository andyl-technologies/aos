index 0000000000000000000000000000000000000000..f1dd5e82e85e3ff4bff76c5571378b3be8a147fc
--- /dev/null
+++ b/tests/tcg/plugins/crucible-instruction.c
@@ -0,0 +1,1881 @@
+/*
+ * Live Crucible instruction-fault test plugin
+ *
+ * Copyright (c) 2026 ANDYL Technologies
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include <glib.h>
+#include <qemu-plugin.h>
+
+#include "aos/crucible/crucible_shmem_abi.h"
+
+QEMU_PLUGIN_EXPORT int qemu_plugin_version = QEMU_PLUGIN_VERSION;
+
+#define TEST_INSTRUCTION_EVIDENCE_HEADER_BYTES 608
+#define TEST_EVENT_ENVELOPE_HEADER_BYTES 192
+#define TEST_EVENT_CAPACITY 4096
+#define TEST_MODEL_PHASE_BEFORE_INSTRUCTION 11
+#define TEST_MODEL_PHASE_AFTER_INSTRUCTION 12
+
+typedef enum TestMode {
+    TEST_RESULT,
+    TEST_RESULT_COMPOSE,
+    TEST_RESULT_INPUT,
+    TEST_RESULT_INPUT_COMPOSE,
+    TEST_RESULT_FAULT_RETRY,
+    TEST_EVENT_SATURATION,
+    TEST_REJECT_OVERLAP,
+    TEST_EXCLUSIVE_SELECTORS,
+    TEST_SKIP,
+    TEST_REPLAY,
+    TEST_EXCEPTION_BEFORE,
+    TEST_EXCEPTION_AFTER,
+    TEST_REJECT_ATOMIC_SKIP,
+    TEST_REJECT_CONTROL_REPLAY,
+    TEST_REJECT_DESTINATION,
+    TEST_REJECT_BYTES,
+    TEST_REJECT_OPCODE_CLASS,
+    TEST_REJECT_PREFIX,
+    TEST_REJECT_LOCK,
+    TEST_REJECT_A64_CMP_SP,
+    TEST_REJECT_A64_FP_COMPARE_DESTINATION,
+    TEST_REJECT_X86_SSE_PREFIX,
+    TEST_REJECT_X86_FAR_REGISTER,
+    TEST_REJECT_A64_SHIFT_IMM6,
+    TEST_REJECT_A64_VECTOR_MODE,
+    TEST_REJECT_A64_EXCEPTION_ENCODING,
+    TEST_REJECT_A64_FP_TYPE,
+    TEST_REJECT_A64_VECTOR_SIZE,
+    TEST_RESULT_LOAD,
+    TEST_RESULT_FP_SIMD,
+    TEST_SKIP_CONTROL,
+    TEST_SKIP_EXCEPTION,
+    TEST_REPLAY_STORE,
+    TEST_REPLAY_ATOMIC,
+    TEST_REPLAY_DEVICE,
+    TEST_SKIP_LOAD,
+    TEST_REPLAY_LOAD,
+    TEST_SKIP_STORE,
+    TEST_SKIP_FP_SIMD,
+    TEST_REPLAY_FP_SIMD,
+    TEST_INPUT_MISMATCH,
+    TEST_REPLAY_SELF_MODIFY,
+    TEST_REPLAY_EXCEPTION,
+} TestMode;
+
+static TestMode test_mode;
+static uint16_t test_architecture;
+static uint16_t test_model_phase;
+static uint32_t test_register_id;
+static uint32_t test_register_bytes;
+static uint64_t test_pc;
+static uint64_t test_selected_address;
+static uint64_t test_iterations_address;
+static uint64_t test_exception_address;
+static uint64_t test_result_fault_count_address;
+static uint8_t test_register_identity[32];
+static uint8_t test_instruction_manifest_sha256[32];
+static uint8_t *test_instruction_bytes;
+static size_t test_instruction_len;
+static uint8_t *test_payload;
+static size_t test_payload_len;
+static uint8_t *test_payload2;
+static size_t test_payload2_len;
+static struct qemu_plugin_crucible_fault_command test_command;
+static struct qemu_plugin_crucible_fault_command test_command2;
+static bool test_prepare_submitted;
+static bool test_commit_submitted;
+static bool test_rule_installed;
+static bool test_event_validated;
+static bool test_guest_validated;
+static bool test_finished;
+static uint32_t test_replay_events;
+static uint32_t test_terminal_events;
+static uint32_t test_compose_events;
+static uint32_t test_compose_completions;
+static uint8_t test_compose_precondition[32];
+static bool test_replay_ram_changed;
+static uint32_t test_target_translations;
+static uint32_t test_target_translations_after_install;
+static size_t test_target_tb_instructions;
+static uint64_t test_target_tb_pc;
+static size_t test_target_tb_index;
+static size_t test_translated_instruction_len;
+static uint8_t test_translated_instruction[32];
+static uint32_t test_last_selected;
+static uint32_t test_last_iterations;
+static bool test_last_guest_state_read;
+static char *test_input_state_json;
+static bool test_result_fault_primed;
+static bool test_natural_exception_primed;
+static bool test_guest_code_ready;
+
+static void test_fail(const char *message);
+
+static void test_set_result_fault_trigger(uint8_t value)
+{
+    const uint8_t encoded[4] = { value, 0, 0, 0 };
+
+    if (!qemu_plugin_crucible_write_memory_vaddr(
+            test_result_fault_count_address, encoded, sizeof(encoded))) {
+        test_fail("result-fault guest trigger could not be updated");
+    }
+    qemu_plugin_force_vcpu_exit();
+}
+
+static void test_arm_natural_exception(void)
+{
+    static const uint8_t armed[4] = { 1, 0, 0, 0 };
+
+    if (test_mode != TEST_SKIP_EXCEPTION || !test_guest_code_ready ||
+        test_natural_exception_primed) {
+        return;
+    }
+    if (!qemu_plugin_crucible_write_memory_vaddr(
+            test_selected_address, armed, sizeof(armed))) {
+        test_fail("natural-exception guest trigger could not be armed");
+    }
+    test_natural_exception_primed = true;
+    qemu_plugin_force_vcpu_exit();
+}
+
+static void test_arm_result_fault(void)
+{
+    if (test_mode == TEST_RESULT_FAULT_RETRY) {
+        test_set_result_fault_trigger(1);
+    }
+}
+
+static bool test_compose_mode(void)
+{
+    return test_mode == TEST_RESULT_COMPOSE ||
+           test_mode == TEST_RESULT_INPUT_COMPOSE;
+}
+
+static bool test_input_bound_mode(void)
+{
+    return test_mode == TEST_RESULT_INPUT ||
+           test_mode == TEST_RESULT_INPUT_COMPOSE;
+}
+
+static bool test_saturation_mode(void)
+{
+    return test_mode == TEST_EVENT_SATURATION;
+}
+
+static bool test_result_mode(void)
+{
+    return test_mode == TEST_RESULT || test_compose_mode() ||
+           test_mode == TEST_RESULT_INPUT ||
+           test_mode == TEST_RESULT_FAULT_RETRY ||
+           test_saturation_mode() ||
+           test_mode == TEST_RESULT_LOAD ||
+           test_mode == TEST_RESULT_FP_SIMD ||
+           test_mode == TEST_REJECT_A64_CMP_SP ||
+           test_mode == TEST_REJECT_A64_FP_COMPARE_DESTINATION;
+}
+
+static bool test_control_plane_mode(void)
+{
+    return test_mode == TEST_REJECT_OVERLAP ||
+           test_mode == TEST_EXCLUSIVE_SELECTORS;
+}
+
+static bool test_skip_mode(void)
+{
+    return test_mode == TEST_SKIP || test_mode == TEST_SKIP_CONTROL ||
+           test_mode == TEST_SKIP_EXCEPTION ||
+           test_mode == TEST_SKIP_LOAD ||
+           test_mode == TEST_SKIP_STORE ||
+           test_mode == TEST_SKIP_FP_SIMD ||
+           test_mode == TEST_INPUT_MISMATCH;
