+        (!loan->reader_invoking && !loan->observer_invoking &&
+         !loan->cleanup_invoking)) {
+        return status ? status : -EPERM;
+    }
+    *out = (struct qemu_plugin_crucible_checkpoint_candidate_read_status_v1) {
