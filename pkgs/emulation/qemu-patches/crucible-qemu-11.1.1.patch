+/* Parent MMIO/PCI/GPE restoration is excluded from this timer-only stream. */
+static int auxiliary_post_load(void *opaque, int version_id)
+{
+    ICH9LPCPMRegs *pm = opaque;
+
+    for (unsigned index = 0; index < 3; index++) {
+        int result = ich9_aux_validate(pm, index);
+
+        if (result < 0) {
+            return result;
+        }
+    }
+    for (unsigned index = 0; index < 3; index++) {
+        ich9_aux_restore(pm, index);
+    }
+    return 0;
+}
+
+static const VMStateDescription auxiliary_stream = {
+    .name = "ich9_pm",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .pre_save = ich9_pm_pre_save,
+    .pre_load = ich9_pm_pre_load,
+    .post_load = auxiliary_post_load,
+    .fields = (const VMStateField[]) {
+        VMSTATE_STRUCT(tco_regs, ICH9LPCPMRegs, 1, vmstate_tco_io_sts,
+                        TCOIORegs),
+        VMSTATE_END_OF_LIST()
+    },
+    .subsections = (const VMStateDescription * const []) {
+        &vmstate_ich9_tco_timer_wide,
+        &vmstate_ich9_swsmi_timer_wide,
+        &vmstate_ich9_periodic_timer_wide,
+        NULL,
+    },
+};
+
+static GByteArray *save_description(ICH9LPCPMRegs *pm,
+                                    const VMStateDescription *description)
+{
+    QIOChannelBuffer *channel = qio_channel_buffer_new(256);
+    QEMUFile *file = qemu_file_new_output(QIO_CHANNEL(channel));
+    GByteArray *bytes = g_byte_array_new();
+    Error *error = NULL;
+
+    g_assert_cmpint(vmstate_save_state(file, description, pm, NULL,
+                                      &error), ==, 0);
+    g_assert_null(error);
+    qemu_put_byte(file, QEMU_VM_EOF);
+    g_assert_cmpint(qemu_fflush(file), ==, 0);
+    g_byte_array_append(bytes, channel->data, channel->usage);
+    g_assert_cmpint(qemu_fclose(file), ==, 0);
+    object_unref(OBJECT(channel));
+    return bytes;
+}
+
+static GByteArray *save_auxiliary(ICH9LPCPMRegs *pm)
+{
+    return save_description(pm, &auxiliary_stream);
+}
+
+static int load_auxiliary(ICH9LPCPMRegs *pm, GByteArray *bytes)
+{
+    QIOChannelBuffer *channel = qio_channel_buffer_new(bytes->len);
+    QEMUFile *file;
+    Error *error = NULL;
+    int result;
+
+    memcpy(channel->data, bytes->data, bytes->len);
+    channel->usage = bytes->len;
+    file = qemu_file_new_input(QIO_CHANNEL(channel));
+    result = vmstate_load_state(file, &auxiliary_stream, pm, 1, &error);
+    error_free(error);
+    qemu_fclose(file);
+    object_unref(OBJECT(channel));
+    return result;
+}
