+{
+    uint64_t extent = qemu_crucible_startup_source_fixed_control_extent();
+    uint64_t modeled_extent = 4096 + 4096; /* Guest and residual allowance. */
+
+    g_assert_cmpuint(fixture_extra_native_allowance, <=, UINT64_MAX - modeled_extent);
+    modeled_extent += fixture_extra_native_allowance;
+
+    for (size_t index = 0; index < 7; index++) {
+        modeled_extent += 64 + index * 16;
+    }
+    g_assert_cmpuint(workspace_extent, <=, UINT64_MAX - modeled_extent);
+    modeled_extent += workspace_extent;
+    g_assert_cmpuint(extent, >, 0);
