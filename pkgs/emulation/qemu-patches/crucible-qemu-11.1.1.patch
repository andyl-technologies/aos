+TESTS = r"""
+static void expect_adoption_refusal(BlockDriverState *node, pid_t parent,
+                                     int descriptor, const char *message)
+{
+    Error *err = NULL;
+
+    g_assert_false(raw_crucible_hot_fork_file_child(
+        node, parent, descriptor, &err));
+    g_assert_nonnull(err);
+    g_assert_nonnull(strstr(error_get_pretty(err), message));
+    error_free(err);
+}
+
+static bool run_case(int status_flags, bool private_file, bool retained_adoption)
+{
+    char source_path[] = "procfd-source-XXXXXX";
+    char destination_path[] = "procfd-destination-XXXXXX";
+    char symlink_path[128];
+    uint8_t bytes[4096];
+    BDRVRawState state = { .fd = -1 };
+    BlockDriverState node = { .opaque = &state };
+    HotForkChildFileEntry entry = { .prepared_fd = -1, .destination_fd = -1 };
+    Error *err = NULL;
+    int creation, original, duplicate, pin, destination, status, adoption_fd;
+    pid_t parent = getpid(), child;
+
+    memset(bytes, 0x5a, sizeof(bytes));
+    creation = mkstemp(source_path);
+    g_assert_cmpint(creation, >=, 0);
+    g_assert_cmpint(write(creation, bytes, sizeof(bytes)), ==, sizeof(bytes));
+    g_assert_cmpint(close(creation), ==, 0);
+
+    original = open(source_path, (private_file ? O_RDWR : O_RDONLY) |
+                                 O_NOFOLLOW | status_flags);
+    if (original < 0 && (status_flags & O_DIRECT) &&
+        (errno == EINVAL || errno == EOPNOTSUPP)) {
+        g_assert_cmpint(unlink(source_path), ==, 0);
+        puts("PROCFD_DIRECT_UNSUPPORTED: local filesystem rejects O_DIRECT");
+        return false;
+    }
+    g_assert_cmpint(original, >=, 0);
+    duplicate = qemu_dup(original);
+    g_assert_cmpint(duplicate, >=, 0);
+    g_assert_cmpint(fcntl(duplicate, F_GETFL), ==, fcntl(original, F_GETFL));
+    g_assert_cmpint(fcntl(duplicate, F_GETFL) & O_NOFOLLOW, ==, O_NOFOLLOW);
+    state.fd = duplicate;
+    g_assert_true(raw_crucible_hot_fork_file(
+        &node, BDRV_CRUCIBLE_HOT_FORK_FILE_PIN, &entry.source, &err));
+    g_assert_null(err);
+    g_assert_cmpint(entry.source.flags & O_ACCMODE, ==,
+                    private_file ? O_RDWR : O_RDONLY);
+    pin = source_file_open(duplicate, O_RDONLY, &err);
+    g_assert_cmpint(pin, >=, 0);
+    g_assert_null(err);
+    entry.original_fd = pin;
