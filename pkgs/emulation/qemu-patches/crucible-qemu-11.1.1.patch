+        cpu_boundary.process = getpid();
+        cpu_boundary.phase = phase;
+        qemu_thread_get_self(&cpu_boundary.thread);
+        scope->generation = ++cpu_boundary.generation;
+        scope->active = true;
+        cpu_boundary.scope = scope;
+    }
+    qatomic_store_release(&observation_writer_cut, 0);
+    return status;
+}
+
+int qemu_crucible_observation_cpu_boundary_end_v1(
+    QemuCrucibleObservationCpuBoundaryScope *scope)
+{
+    int status;
+
+    observation_boundary_control_lock();
+    status = scope && scope->active && cpu_boundary.scope == scope &&
+        scope->generation == cpu_boundary.generation &&
+        cpu_boundary.process == getpid() &&
+        qemu_thread_is_self(&cpu_boundary.thread) ? 0 : -ESTALE;
+    if (!status) {
+        /* End of the real callback window revokes semantic CPU exemption.
+         * Retained physical borrower metadata prevents this slot's reuse. */
+        cpu_boundary.scope = NULL;
+        scope->active = false;
+    }
+    qatomic_store_release(&observation_writer_cut, 0);
+    return status;
+}
+
+int qemu_crucible_observation_cpu_boundary_unwind_v1(void *cpu)
+{
+    int status = 0;
+
+    observation_boundary_control_lock();
+    if (cpu_boundary.scope) {
+        if (cpu_boundary.cpu != cpu || cpu_boundary.process != getpid() ||
+            !qemu_thread_is_self(&cpu_boundary.thread)) {
+            status = -ESTALE;
+        } else {
+            /* The genuine longjmp revokes semantic exemption even while
+             * physical borrower metadata remains. Never dereference the
+             * expired stack address or discard that borrower's ownership. */
+            cpu_boundary.scope = NULL;
+            status = cpu_boundary.borrowers ? -EBUSY : 0;
+        }
+    }
+    qatomic_store_release(&observation_writer_cut, 0);
+    return status;
+}
+
+size_t qemu_crucible_observation_cleanup_cpu_body_bytes_v1(void)
+{
+    return sizeof(cleanup_cpu_closure);
+}
+
+size_t qemu_crucible_observation_cleanup_cpu_body_alignment_v1(void)
+{
+    return _Alignof(QemuCrucibleObservationCleanupCpuClosure);
+}
+
+static int cleanup_cpu_identity_locked(
+    QemuCrucibleObservationCleanupCpuClosure *owner)
+{
+    return owner == &cleanup_cpu_closure && owner->held &&
+        owner->candidate && owner->execution && owner->process == getpid() &&
+        qemu_thread_is_self(&owner->thread) ? 0 : -ESTALE;
+}
+
+int qemu_crucible_observation_cleanup_cpu_acquire_v1(
+    QemuCrucibleFingerprintCleanupExecution *candidate, uint64_t id,
+    QemuCrucibleObservationCleanupCpuClosure **out)
+{
+    QemuCrucibleObservationRootExecutionWitness *execution = NULL;
+    int status;
+
+    if (!out || *out || !bql_locked() || current_cpu) {
+        return -EINVAL;
+    }
+    /* The actual Main candidate, saved independent post and paid keeper are
+     * authenticated before this cut. No Source call runs under a gate mutex. */
+    status = qemu_crucible_ram_fingerprint_cleanup_birth_current_v1(
+        candidate, id, &execution);
+    if (status || !execution) {
+        return status ? status : -ESTALE;
+    }
+    if (qatomic_cmpxchg(&observation_writer_cut, 0, 1)) {
+        return -EBUSY;
+    }
+    status = root_execution_identity_locked(execution);
+    if (!status) {
+        status = qemu_thread_ram_cpu_execution_ended(&execution->execution);
+    }
+    if (!status && cleanup_cpu_closure.held) {
+        status = -EBUSY;
+    }
+    if (!status) {
+        cleanup_cpu_closure = (QemuCrucibleObservationCleanupCpuClosure) {
+            .candidate = candidate,
+            .execution = execution,
+            .source_id = id,
+            .process = getpid(),
+            .held = true,
+        };
+        qemu_thread_get_self(&cleanup_cpu_closure.thread);
+        /* Pending wrapper custody survives every core admission disposition.
+         * The real core gate publishes Requested before inspecting old CPUs. */
+        *out = &cleanup_cpu_closure;
+        status = qemu_thread_ram_cpu_construction_begin(
+            &cleanup_cpu_closure.cpus);
+        cleanup_cpu_closure.admission_status = status;
+        /* Only this exact producer's known existing-owner refusal had no
+         * admission effect. Never generalize an arbitrary signed status. */
+        cleanup_cpu_closure.admission_retryable =
+            status == -EBUSY && !cleanup_cpu_closure.cpus.active;
+    }
+    qatomic_store_release(&observation_writer_cut, 0);
+    return status;
+}
+
+int qemu_crucible_observation_cleanup_cpu_retry_v1(
+    QemuCrucibleFingerprintCleanupExecution *candidate, uint64_t id,
+    QemuCrucibleObservationCleanupCpuClosure *owner)
+{
+    QemuCrucibleObservationRootExecutionWitness *execution = NULL;
+    int status;
+
+    if (owner != &cleanup_cpu_closure || !owner->held ||
+        candidate != owner->candidate || id != owner->source_id ||
+        owner->process != getpid() || !qemu_thread_is_self(&owner->thread)) {
+        return -ESTALE;
+    }
+    /* The real old candidate and SAME paid keeper remain authoritative.
+     * This factual proof supplies no new Original, charge or native owner. */
+    status = qemu_crucible_ram_fingerprint_cleanup_candidate_current_v1(
+        candidate, id, &execution);
+    if (status) {
+        return status;
+    }
+    if (qatomic_cmpxchg(&observation_writer_cut, 0, 1)) {
+        return -EBUSY;
+    }
+    status = cleanup_cpu_identity_locked(owner);
+    if (!status && execution != owner->execution) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        status = root_execution_identity_locked(execution);
+    }
+    if (!status) {
+        status = qemu_thread_ram_cpu_execution_ended(&execution->execution);
+    }
+    if (!status && owner->cpus.active) {
+        /* Requested already owns its sole real epoch. Wait for actual old
+         * producers to drain; do not replace or reissue the native gate. */
+        status = qemu_thread_ram_cpu_construction_current(&owner->cpus);
+    } else if (!status) {
+        if (!owner->admission_retryable || owner->admission_status != -EBUSY) {
+            status = -EPERM;
+        } else {
+            /* This SAME embedded gate never admitted before. Its first real
+             * activation emits one epoch, with no new wrapper or paid body. */
+            status = qemu_thread_ram_cpu_construction_begin(&owner->cpus);
+            owner->admission_status = status;
+            owner->admission_retryable = status == -EBUSY && !owner->cpus.active;
+        }
+    }
+    qatomic_store_release(&observation_writer_cut, 0);
+    return status;
+}
+
+int qemu_crucible_observation_cleanup_cpu_current_v1(
+    QemuCrucibleObservationCleanupCpuClosure *owner)
+{
+    QemuCrucibleObservationRootExecutionWitness *execution = NULL;
+    int status;
+
+    if (owner != &cleanup_cpu_closure || !owner->held ||
+        owner->process != getpid() || !qemu_thread_is_self(&owner->thread)) {
+        return -ESTALE;
+    }
+    /* This exact factual candidate proof invokes no cleanup gate/current.
+     * Its Source keeper checks finish before the cut, avoiding recursion. */
+    status = qemu_crucible_ram_fingerprint_cleanup_candidate_current_v1(
+        owner->candidate, owner->source_id, &execution);
+    if (status) {
+        return status;
+    }
+    if (qatomic_cmpxchg(&observation_writer_cut, 0, 1)) {
+        return -EBUSY;
+    }
+    status = cleanup_cpu_identity_locked(owner);
+    if (!status && execution != owner->execution) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        status = root_execution_identity_locked(execution);
+    }
+    if (!status) {
+        status = qemu_thread_ram_cpu_execution_ended(&execution->execution);
+    }
+    if (!status) {
+        /* No own-CPU exemption: every actually entered foreign frame must
+         * have returned, while this nominal gate closes their next entries. */
+        status = !owner->cpus.active && owner->admission_retryable ? -EBUSY :
+            qemu_thread_ram_cpu_construction_current(&owner->cpus);
+    }
+    qatomic_store_release(&observation_writer_cut, 0);
+    return status;
+}
+
+int qemu_crucible_observation_cleanup_cpu_identity_return_v1(
+    QemuCrucibleObservationCleanupCpuClosure **owner)
+{
+    QemuCrucibleObservationCleanupCpuClosure *closure;
+    int status;
+
+    if (!owner || !(closure = *owner)) {
+        return -EINVAL;
+    }
+    if (qatomic_cmpxchg(&observation_writer_cut, 0, 1)) {
+        return -EBUSY;
+    }
+    /* The Source operation may have physically ended already. Its current,
+     * post or expired Original cannot strand this actual creator's gate. */
+    status = cleanup_cpu_identity_locked(closure);
+    if (!status && closure->cpus.active) {
+        status = qemu_thread_ram_cpu_construction_end(&closure->cpus);
+    }
+    if (!status) {
+        closure->held = false;
+        *owner = NULL;
+    }
+    qatomic_store_release(&observation_writer_cut, 0);
+    return status;
+}
diff --git a/system/crucible-preexec-artifact.inc.h b/system/crucible-preexec-artifact.inc.h
