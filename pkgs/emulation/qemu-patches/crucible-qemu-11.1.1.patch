+typedef struct RegistryWorker {
+    int ready_fd;
+    int release_fd;
+} RegistryWorker;
+
+typedef struct RegistryWorkerThread {
+    RegistryWorker worker;
+    QemuThread thread;
+    int ready[2];
+    int release[2];
+} RegistryWorkerThread;
+
+static void *registry_worker(void *opaque)
+{
+    RegistryWorker *worker = opaque;
+
+    write_child_result(worker->ready_fd, 0);
+    (void)read_child_result(worker->release_fd);
+    return NULL;
+}
+
+static void *aio_registry_worker(void *opaque)
+{
+    qemu_thread_hot_fork_set_current_disposition(
+        QEMU_THREAD_HOT_FORK_UNCLASSIFIED_AIO);
+    return registry_worker(opaque);
+}
+
+static void *monitor_registry_worker(void *opaque)
+{
+    void *result;
+
+    qemu_thread_hot_fork_set_current_disposition(
+        QEMU_THREAD_HOT_FORK_MONITOR_RESTART);
+    rcu_register_thread();
+    result = registry_worker(opaque);
+    rcu_unregister_thread();
+    return result;
+}
