+static void scenario_setup3_once_custody(void)
+{
+    struct qemu_plugin_crucible_setup_borrow_v3 first;
+    struct qemu_plugin_crucible_setup_borrow_v3 repeated;
+    unsigned borrowed;
+    uint8_t byte = 0;
+
+    fixture_prepare(0, false);
+    g_assert_cmpint(qemu_plugin_crucible_startup_setup_borrow_v3(
+        fixture.ctx.id, &first), ==, 0);
+    g_assert_cmpint(qemu_plugin_crucible_startup_setup_borrow_v3(
+        fixture.ctx.id, &repeated), ==, 0);
+    g_assert_true(first.frame == repeated.frame);
+    g_assert_true(first.descriptors == repeated.descriptors);
+    g_assert_cmpuint(first.descriptor_count, ==, QEMU_CRUCIBLE_PREEXEC_SETUP_BASE_FDS);
+    g_assert_cmpuint(ldl_be_p(first.frame + 13), ==, 0);
+    g_assert_cmpuint(ldl_be_p(first.frame + 17), ==, 0);
+    borrowed = fixture.borrows;
+
+    /* A repeat acquire cannot read/receive or replace the retained plan.
+     * The fixture provider only lends the same already prepared aliases.
+     */
+    g_assert_cmpint(fixture_acquire(), ==, -EALREADY);
+    g_assert_cmpuint(fixture.borrows, ==, borrowed);
