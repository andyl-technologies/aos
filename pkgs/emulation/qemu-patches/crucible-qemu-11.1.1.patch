+/* Each actual descriptor has its own sole-close journal. The fallback device
+ * and IOC_NEW result coexist; one close cannot discharge the other slot. */
+typedef struct QemuCrucibleUserfaultfdDescriptor {
+    int descriptor;
+    int close_status;
+    int close_errno;
+    bool held;
+    bool close_attempted;
+    bool close_returned;
+    bool close_uncertain;
+} QemuCrucibleUserfaultfdDescriptor;
+
+/* Kernel read storage stays inside the prepaid endpoint body. Partial bytes
+ * and a malformed complete message remain the same issued receipt; projection
+ * into address/flags/TID cannot create a second event owner. */
+struct QemuCrucibleUserfaultfdEventReceipt {
+    QemuCrucibleUserfaultfdEndpoint *endpoint;
+    struct QemuCrucibleObservationParticipantBinding *participant;
+    QemuThread reader;
+    pid_t process;
+    uint64_t serial;
+    union {
+        struct uffd_msg message;
+        uint8_t bytes[sizeof(struct uffd_msg)];
+    } kernel;
+    size_t received_bytes;
+    ssize_t read_result;
+    int read_errno;
+    bool held;
+    bool read_entered;
+    bool read_returned;
+    bool complete;
+    bool malformed;
+    bool physical_uncertain;
+};
+
+/* This is storage for a later genuine actor-pause borrower. Its clock-free
+ * wait must follow that pause's real release/ACK producer, independently of
+ * the writer gate. No endpoint or pause may be issued from these fields. */
+typedef struct QemuCrucibleUserfaultfdPauseWait {
+    QemuCrucibleUserfaultfdEndpoint *endpoint;
+    QemuCrucibleRamActorPause *pause;
+    QemuThread worker;
+    pid_t process;
+    int wait_status;
+    bool held;
+    bool wait_entered;
+    bool release_observed;
+    bool release_acknowledged;
+    bool physically_returned;
+} QemuCrucibleUserfaultfdPauseWait;
+
+/* The coupled Source descriptor/storage lender must debit this entire typed
+ * body before any field is written. The event and wait holders are interiors,
+ * not separately funded allocations. API negotiation is distinct from actual
+ * registered mapping and participant authority. */
+struct QemuCrucibleUserfaultfdEndpoint {
+    QemuCrucibleUserfaultfdEndpoint *next;
+    QemuCrucibleStartupInstallerBinding installer;
+    QemuCrucibleStartupRuntimePurpose *runtime;
+    QemuCrucibleObservationConstructionBinding *construction;
+    qemu_plugin_crucible_fingerprint_operation_v1 *operation;
+    struct QemuCrucibleObservationMappingOwner *mapping;
+    QemuCrucibleMetadataCharge body_charge;
+    QemuThread creator;
+    pid_t process;
+    uint64_t serial;
+    QemuCrucibleUserfaultfdDescriptor descriptors[2];
+    struct uffdio_api api;
+    QemuCrucibleUserfaultfdEventReceipt receipt;
+    QemuCrucibleUserfaultfdPauseWait pause_wait;
+    int creation_status;
+    int creation_errno;
+    int negotiation_status;
+    int negotiation_errno;
+    bool syscall_entered;
+    bool syscall_returned;
+    bool device_open_entered;
+    bool device_open_returned;
+    bool device_ioctl_entered;
+    bool device_ioctl_returned;
+    bool negotiation_entered;
+    bool negotiation_returned;
+    bool held;
+    bool published;
+    bool parent_disarmed;
+};
+
+/* Only compiled Linux ABI types determine the payer's request. These getters
+ * neither publish a holder nor issue descriptor, mapping or operation credit. */
+/* This read-only ELF declaration describes the actual compiled storage request.
+ * An artifact reader observes it without calling QEMU. It carries no credit,
+ * constructor support bit or permission to consume the descriptor-table loan. */
+#define USERFAULTFD_LAYOUT_BE32(value) \
+    (uint8_t)((uint32_t)(value) >> 24), \
+    (uint8_t)((uint32_t)(value) >> 16), \
+    (uint8_t)((uint32_t)(value) >> 8), \
+    (uint8_t)(uint32_t)(value)
+#define USERFAULTFD_LAYOUT_BE64(value) \
+    (uint8_t)((uint64_t)(value) >> 56), \
+    (uint8_t)((uint64_t)(value) >> 48), \
+    (uint8_t)((uint64_t)(value) >> 40), \
+    (uint8_t)((uint64_t)(value) >> 32), \
+    (uint8_t)((uint64_t)(value) >> 24), \
+    (uint8_t)((uint64_t)(value) >> 16), \
+    (uint8_t)((uint64_t)(value) >> 8), \
+    (uint8_t)(uint64_t)(value)
+
+const uint8_t qemu_crucible_userfaultfd_constructor_layout_v1[64]
+    __attribute__((used, aligned(8),
+                   section(".qemu.crucible.userfaultfd-constructor"))) = {
+    'C', 'R', 'U', 'C', 'U', 'F', 'D', '1',
+    USERFAULTFD_LAYOUT_BE32(1),
+    USERFAULTFD_LAYOUT_BE32(sizeof(qemu_crucible_userfaultfd_constructor_layout_v1)),
+    USERFAULTFD_LAYOUT_BE64(sizeof(QemuCrucibleUserfaultfdEndpoint)),
+    USERFAULTFD_LAYOUT_BE64(_Alignof(QemuCrucibleUserfaultfdEndpoint)),
+    USERFAULTFD_LAYOUT_BE64(offsetof(QemuCrucibleUserfaultfdEndpoint, receipt)),
+    USERFAULTFD_LAYOUT_BE64(sizeof(QemuCrucibleUserfaultfdEventReceipt)),
+    USERFAULTFD_LAYOUT_BE64(_Alignof(QemuCrucibleUserfaultfdEventReceipt)),
+    USERFAULTFD_LAYOUT_BE32(ARRAY_SIZE(
+        ((QemuCrucibleUserfaultfdEndpoint *)0)->descriptors)),
+    USERFAULTFD_LAYOUT_BE32(0),
+};
