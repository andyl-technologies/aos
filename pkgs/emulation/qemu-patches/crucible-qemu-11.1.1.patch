+#if defined(CONFIG_LINUX) && defined(__x86_64__) && !defined(__ILP32__)
+static int advance_callback_begin(QemuCrucibleSourceAdvanceReceiver *receiver,
+                                  QemuCrucibleAdvanceCallbackKind kind,
+                                  void *function)
+{
+    QemuCrucibleAdvanceCallbackFrame *frame = &receiver->callback;
+    int status = advance_receiver_identity(receiver);
+
+    if (status) {
+        return status;
+    }
+    if ((frame->entered && !frame->returned) ||
+        receiver->next_callback_serial >= UINT64_MAX - 1) {
+        return -EBUSY;
+    }
+    *frame = (QemuCrucibleAdvanceCallbackFrame) {
+        .receiver = receiver,
+        .serial = ++receiver->next_callback_serial,
+        .kind = kind,
+    };
+    frame->mask = qemu_plugin_crucible_native_mask_v1(
+        frame, function, receiver->member->component->userdata);
+    frame->entered = true;
+    status = qemu_plugin_crucible_native_advance_callback_current_v1(
+        receiver->main, receiver->control, &frame->mask);
+    if (status) {
+        /* No module body entered. Consume only the actual mask receipt. */
+        frame->entered = false;
+        qemu_plugin_crucible_native_exit_v1(frame->mask);
+    }
+    return status;
+}
+
+static void advance_callback_end(QemuCrucibleSourceAdvanceReceiver *receiver)
+{
+    QemuCrucibleAdvanceCallbackFrame *frame = &receiver->callback;
+
+    /* Save actual callback return before consuming its physical mask. No
+     * module object is inspected by the subsequent independent post call. */
+    frame->returned = true;
+    qemu_plugin_crucible_native_exit_v1(frame->mask);
+}
