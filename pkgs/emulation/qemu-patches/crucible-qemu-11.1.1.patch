+CrucibleCheckpointRestore *qmp_crucible_checkpoint_restore(
+    const char *ram_root_fdname, const char *ram_root_blake3,
+    const char *topology_blake3, const char *source_session,
+    const char *source_owner, uint64_t source_generation,
+    const char *device_fdname, const char *device_sha256,
+    const char *cancellation_fdname, const char *checkpoint_sha256,
+    const char *target_sha256, const char *frontier_sha256,
+    uint64_t maximum_device_bytes, Error **errp)
+{
+    CrucibleCheckpointRestore *report = NULL;
+    int root_fd = -1;
+    int device_fd = -1;
+    int cancellation_fd = -1;
+
+    if (!strcmp(ram_root_fdname, device_fdname) ||
+        !strcmp(ram_root_fdname, cancellation_fdname) ||
+        !strcmp(device_fdname, cancellation_fdname)) {
+        error_setg(errp, "Crucible restore descriptors must be distinct");
+        return NULL;
+    }
+    root_fd = monitor_get_fd(monitor_cur(), ram_root_fdname, errp);
+    if (root_fd < 0) {
+        goto out;
+    }
+    device_fd = monitor_get_fd(monitor_cur(), device_fdname, errp);
+    if (device_fd < 0) {
+        goto out;
+    }
+    cancellation_fd = monitor_get_fd(monitor_cur(), cancellation_fdname, errp);
+    if (cancellation_fd < 0) {
+        goto out;
+    }
+    report = qemu_crucible_checkpoint_restore(
+        root_fd, device_fd, cancellation_fd, ram_root_blake3, topology_blake3,
+        source_session, source_owner, source_generation, device_sha256,
+        checkpoint_sha256, target_sha256, frontier_sha256,
+        maximum_device_bytes, errp);
+    root_fd = -1;
+    device_fd = -1;
+
+out:
+    if (root_fd >= 0) {
+        close(root_fd);
+    }
+    if (device_fd >= 0) {
+        close(device_fd);
+    }
+    if (cancellation_fd >= 0) {
+        close(cancellation_fd);
+    }
+    return report;
+}
