+bool arm_cpu_get_fault_translation(CPUState *cs, vaddr addr,
+                                   MMUAccessType access_type,
+                                   CPUFaultTranslation *result)
+{
+    ARMCPU *cpu = ARM_CPU(cs);
+    CPUARMState *env = &cpu->env;
+    ARMMMUIdx mmu_idx = arm_mmu_idx(env);
+    S1Translate ptw = {
+        .in_mmu_idx = mmu_idx,
+        .in_space = arm_security_space(env),
+        .in_debug = true,
+    };
+    GetPhysAddrResult res = {};
+    ARMMMUFaultInfo fi = {};
+
+    if (!get_phys_addr_gpc(env, &ptw, addr, access_type, 0, &res, &fi) ||
+        res.f.lg_page_size >= 64 ||
+        (access_type == MMU_DATA_LOAD && !(res.f.prot & PAGE_READ)) ||
+        (access_type == MMU_DATA_STORE && !(res.f.prot & PAGE_WRITE)) ||
+        (access_type == MMU_INST_FETCH && !(res.f.prot & PAGE_EXEC))) {
+        return false;
+    }
+    result->physical_address = res.f.phys_addr;
+    result->page_size = 1ULL << res.f.lg_page_size;
+    result->attrs = res.f.attrs;
+    result->readable = res.f.prot & PAGE_READ;
+    result->writable = res.f.prot & PAGE_WRITE;
+    result->executable = res.f.prot & PAGE_EXEC;
+    result->user = arm_current_el(env) == 0;
+    return true;
+}
