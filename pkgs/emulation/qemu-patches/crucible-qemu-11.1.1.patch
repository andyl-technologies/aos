+def run_nonfirst_control_boundary_test(qemu, plugin, bios):
+    live = LiveQemu(
+        qemu,
+        plugin,
+        bios,
+        control_nonfirst_wait=True,
+        rr_switch_quantum=RR_SWITCH_QUANTUM,
+        x86_smp="4,maxcpus=4",
+    )
+    try:
+        wait_owner = None
+        arm_observed = False
+        wait_parked = False
+        deadline = time.monotonic() + TIMEOUT_SECONDS
+        while not wait_parked:
+            if time.monotonic() >= deadline:
+                raise TimeoutError(
+                    "non-first control wait did not park before its deadline"
+                )
+            event, value = live.marker(deadline)
+            if event == "control-wait-owner":
+                if wait_owner is not None:
+                    raise AssertionError(
+                        "multiple non-first control wait owners published: "
+                        f"{wait_owner!r}, {value!r}"
+                    )
+                wait_owner = value
+                live.control_state[0:4] = (1).to_bytes(
+                    4, byteorder=sys.byteorder
+                )
+                live.control_state.flush()
+            elif event == "control-arm-observed":
+                if wait_owner is None:
+                    raise AssertionError(
+                        "control arm was observed before identifying its owner"
+                    )
+                arm_observed = True
+            elif event == "park":
+                if wait_owner is None:
+                    raise AssertionError(
+                        "non-first control wait parked before identifying its owner"
+                    )
+                if not arm_observed:
+                    raise AssertionError(
+                        "non-first control wait parked before observing its arm"
+                    )
+                park_thread, park_address = value
+                wait_parked = live.wait_for_futex_entry(
+                    park_thread,
+                    park_address,
+                    deadline,
+                    stable_duration=0.02,
+                    poll_interval=0.0001,
+                )
+            elif event != "work":
+                raise AssertionError(
+                    f"unexpected pre-park marker: {(event, value)!r}"
+                )
+        if wait_owner != 1:
+            raise AssertionError(
+                f"control wait was not owned by vCPU 1: {wait_owner!r}"
+            )
+
+        live.control_state[0:4] = (2).to_bytes(
+            4, byteorder=sys.byteorder
+        )
+        live.control_state.flush()
+        os.eventfd_write(live.wake_fd, 1)
+
+        saw_control = False
+        deadline = time.monotonic() + TIMEOUT_SECONDS
+        while True:
+            if time.monotonic() >= deadline:
+                raise TimeoutError(
+                    "non-first control wait did not resume before its deadline"
+                )
+            event, value = live.marker(deadline)
+            if event == "control":
+                saw_control = True
+                continue
+            if event == "result" and value == 0:
+                break
+            if event == "ordering-error":
+                raise AssertionError(
+                    "eventfd woke non-first idle wait before control boundary"
+                )
+            if event not in ("park", "result", "work"):
+                raise AssertionError(
+                    f"unexpected control marker: {(event, value)!r}"
+                )
+        if not saw_control:
+            raise AssertionError(
+                "non-first idle wait resumed without a control boundary"
+            )
+    finally:
+        live.close()
+    return live
