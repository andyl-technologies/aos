+static const VMStateDescription vmstate_crucible_shmem = {
+    .name = "block/crucible-shmem",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .pre_load = crucible_shmem_pre_load,
+    .post_load = crucible_shmem_post_load,
