+bool qemu_plugin_crucible_native_accelerator_descriptor_observe_v1(
+    size_t member, QemuCrucibleNativeGroupDescriptorView *out)
+{
+    if (!out) {
+        return false;
+    }
+
+    switch (member) {
+    case 0:
+        *out = (QemuCrucibleNativeGroupDescriptorView) {
+            .coordinate = &accelerator_submit_cb,
+            .function = accelerator_submit_cb,
+            .userdata = accelerator_userdata,
+            .userdata_coordinate = &accelerator_userdata,
+            .kind = QEMU_CRUCIBLE_NATIVE_REGISTERED,
+        };
+        return true;
+    case 1:
+        *out = (QemuCrucibleNativeGroupDescriptorView) {
+            .coordinate = &accelerator_poll_cb,
+            .function = accelerator_poll_cb,
+            .userdata = accelerator_userdata,
+            .userdata_coordinate = &accelerator_userdata,
+            .kind = QEMU_CRUCIBLE_NATIVE_REGISTERED,
+        };
+        return true;
+    case 2:
+        *out = (QemuCrucibleNativeGroupDescriptorView) {
+            .coordinate = &accelerator_wait_cb,
+            .function = accelerator_wait_cb,
+            .userdata = accelerator_userdata,
+            .userdata_coordinate = &accelerator_userdata,
+            .kind = QEMU_CRUCIBLE_NATIVE_REGISTERED,
