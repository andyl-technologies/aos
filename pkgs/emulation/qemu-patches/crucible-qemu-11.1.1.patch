+bool arm_cpu_get_fault_translation(CPUState *cs, vaddr addr,
+                                   MMUAccessType access_type,
+                                   CPUFaultTranslation *result)
+{
+    ARMCPU *cpu = ARM_CPU(cs);
+    CPUARMState *env = &cpu->env;
+    ARMMMUIdx mmu_idx = arm_mmu_idx(env);
+    S1Translate ptw = {
+        .in_mmu_idx = mmu_idx,
+        .in_space = arm_security_space(env),
+        .in_debug = true,
+    };
+    GetPhysAddrResult res = {};
+    ARMMMUFaultInfo fi = {};
+
+    if (!get_phys_addr_gpc(env, &ptw, addr, access_type, 0, &res, &fi) ||
+        res.f.lg_page_size >= 64 ||
+        (access_type == MMU_DATA_LOAD && !(res.f.prot & PAGE_READ)) ||
+        (access_type == MMU_DATA_STORE && !(res.f.prot & PAGE_WRITE)) ||
+        (access_type == MMU_INST_FETCH && !(res.f.prot & PAGE_EXEC))) {
+        return false;
+    }
+    result->physical_address = res.f.phys_addr;
+    result->page_size = 1ULL << res.f.lg_page_size;
+    result->attrs = res.f.attrs;
+    result->readable = res.f.prot & PAGE_READ;
+    result->writable = res.f.prot & PAGE_WRITE;
+    result->executable = res.f.prot & PAGE_EXEC;
+    result->user = arm_current_el(env) == 0;
+    return true;
+}
+
+bool arm_cpu_validate_fault_exception(
+    CPUState *cs, const CPUFaultException *exception)
+{
+    ARMCPU *cpu = ARM_CPU(cs);
+    bool abort = exception->vector == CPU_FAULT_AARCH64_INSTRUCTION_ABORT ||
+                 exception->vector == CPU_FAULT_AARCH64_DATA_ABORT;
+    uint32_t syndrome = exception->syndrome;
+    uint32_t exception_class = syn_get_ec(syndrome);
+    bool syndrome_valid = false;
+
+    if (exception->architecture == CPU_FAULT_EXCEPTION_AARCH64 &&
+        exception->record == CPU_FAULT_EXCEPTION_AARCH64_RAS) {
+        const bool asynchronous = exception->aarch64_ras.asynchronous;
+        const uint32_t aet = exception->syndrome & (7U << 10);
+        const uint32_t set = exception->syndrome & (3U << 11);
+        const bool serror_syndrome_matches =
+            exception->syndrome ==
+                syn_serror(exception->aarch64_ras.disr & 0x1ffffff);
+        const bool address_matches =
+            exception->aarch64_ras.has_far ==
+                exception->has_fault_address &&
+            (!exception->has_fault_address ||
+             exception->aarch64_ras.far == exception->fault_address);
+
+        return is_a64(&cpu->env) && cpu_isar_feature(aa64_ras, cpu) &&
+            !exception->aarch64_ras.corrected &&
+            exception->syndrome <= UINT32_MAX &&
+            exception->aarch64_ras.esr == exception->syndrome &&
+            address_matches &&
+            exception->maskable == asynchronous &&
+            (asynchronous ?
+             (exception->vector == EC_SERROR &&
+              syn_get_ec(exception->syndrome) == EC_SERROR &&
+              exception->aarch64_ras.has_disr &&
+              serror_syndrome_matches &&
+              aet == (exception->aarch64_ras.fatal ? 0 : (3U << 10)) &&
+              !exception->has_fault_address) :
+             (exception->vector == CPU_FAULT_AARCH64_DATA_ABORT &&
+              syn_get_ec(exception->syndrome) ==
+                  (arm_current_el(&cpu->env) == 0 ?
+                       EC_DATAABORT : EC_DATAABORT_SAME_EL) &&
+              exception->has_fault_address &&
+              (exception->syndrome & 0x3f) == 0x10 &&
+              set == (exception->aarch64_ras.fatal ? (2U << 11) : 0) &&
+              !exception->aarch64_ras.has_disr));
+    }
+    switch (exception->vector) {
+    case CPU_FAULT_AARCH64_UNDEFINED:
+        syndrome_valid = syndrome == syn_uncategorized();
+        break;
+    case CPU_FAULT_AARCH64_INSTRUCTION_ABORT:
+        syndrome_valid = (exception_class == EC_INSNABORT ||
+                          exception_class == EC_INSNABORT_SAME_EL) &&
+            FIELD_EX32(syndrome, SYNDROME, IL) &&
+            !(syndrome & 0x01ff0000U) &&
+            exception->has_fault_address;
+        break;
+    case CPU_FAULT_AARCH64_DATA_ABORT:
+        syndrome_valid = (exception_class == EC_DATAABORT ||
+                          exception_class == EC_DATAABORT_SAME_EL) &&
+            FIELD_EX32(syndrome, SYNDROME, IL) &&
+            !(syndrome & 0x01ff8000U) &&
+            exception->has_fault_address;
+        break;
+    case CPU_FAULT_AARCH64_BREAKPOINT:
+        syndrome_valid = exception_class == EC_AA64_BKPT &&
+            FIELD_EX32(syndrome, SYNDROME, IL) &&
+            !(syndrome & 0x01ff0000U);
+        break;
+    default:
+        break;
+    }
+    return exception->architecture == CPU_FAULT_EXCEPTION_AARCH64 &&
+           exception->record == CPU_FAULT_EXCEPTION_ARCHITECTURE_DEFAULT &&
+           exception->syndrome <= UINT32_MAX &&
+           syndrome_valid && !exception->maskable &&
+           (exception->vector == CPU_FAULT_AARCH64_UNDEFINED || abort ||
+            exception->vector == CPU_FAULT_AARCH64_BREAKPOINT) &&
+           (abort || !exception->has_fault_address);
+}
+
+bool arm_cpu_get_fault_hardware_error_capability(
+    CPUState *cs, CPUFaultHardwareErrorCapability *capability)
+{
+    ARMCPU *cpu = ARM_CPU(cs);
+
+    if (!arm_feature(&cpu->env, ARM_FEATURE_AARCH64) ||
+        !cpu_isar_feature(aa64_ras, cpu)) {
+        return false;
+    }
+    capability->bank_count = 1;
+    capability->ras = true;
+    return true;
+}
+
+bool arm_cpu_get_fault_privilege(CPUState *cs, uint32_t *privilege)
+{
+    if (!privilege) {
+        return false;
+    }
+    *privilege = arm_current_el(cpu_env(cs));
+    return *privilege <= 3;
+}
+
+bool arm_cpu_read_fault_hardware_error_state(
+    CPUState *cs, uint32_t bank, CPUFaultHardwareErrorState *state)
+{
+    CPUARMState *env = cpu_env(cs);
+
+    if (bank != 0) {
+        return false;
+    }
+    state->architecture = CPU_FAULT_EXCEPTION_AARCH64;
+    state->record = CPU_FAULT_EXCEPTION_AARCH64_RAS;
+    state->bank = bank;
+    state->flags = env->crucible_hardware_error.synchronous_pending |
+        (env->crucible_hardware_error.asynchronous_pending << 1) |
+        (env->crucible_hardware_error.fatal << 2);
+    state->interrupt_request = cs->interrupt_request;
+    state->syndrome = env->crucible_hardware_error.syndrome;
+    state->fault_address = env->crucible_hardware_error.address;
+    state->esr = env->crucible_hardware_error.syndrome;
+    state->far = env->crucible_hardware_error.address;
+    state->disr = env->cp15.disr_el1;
+    return true;
+}
+
+bool arm_cpu_restore_fault_hardware_error_state(
+    CPUState *cs, const CPUFaultHardwareErrorState *state)
+{
+    CPUARMState *env = cpu_env(cs);
+
+    if (!state || state->architecture != CPU_FAULT_EXCEPTION_AARCH64 ||
+        state->record != CPU_FAULT_EXCEPTION_AARCH64_RAS ||
+        state->bank != 0 || (state->flags & ~7U)) {
+        return false;
+    }
+    env->crucible_hardware_error.synchronous_pending = state->flags & 1;
+    env->crucible_hardware_error.asynchronous_pending =
+        (state->flags >> 1) & 1;
+    env->crucible_hardware_error.fatal = (state->flags >> 2) & 1;
+    env->crucible_hardware_error.syndrome = state->syndrome;
+    env->crucible_hardware_error.address = state->fault_address;
+    env->crucible_hardware_error.disr = state->disr;
+    env->cp15.disr_el1 = state->disr;
+    if (state->interrupt_request & CPU_INTERRUPT_SERROR) {
+        cpu_interrupt(cs, CPU_INTERRUPT_SERROR);
+    } else {
+        cpu_reset_interrupt(cs, CPU_INTERRUPT_SERROR);
+    }
+    return true;
+}
+
+bool arm_cpu_record_corrected_fault(
+    CPUState *cs, const CPUFaultException *exception)
+{
+    (void)cs;
+    (void)exception;
+    return false;
+}
+
+bool arm_cpu_queue_fault_hardware_error(
+    CPUState *cs, const CPUFaultException *exception)
+{
+    CPUARMState *env = cpu_env(cs);
+    BQL_LOCK_GUARD();
+
+    if (!arm_cpu_validate_fault_exception(cs, exception) ||
+        exception->aarch64_ras.corrected ||
+        env->crucible_hardware_error.synchronous_pending ||
+        env->crucible_hardware_error.asynchronous_pending) {
+        return false;
+    }
+    if (exception->aarch64_ras.asynchronous) {
+        env->cp15.disr_el1 = exception->aarch64_ras.disr;
+        env->crucible_hardware_error.disr =
+            exception->aarch64_ras.disr;
+        env->crucible_hardware_error.asynchronous_pending = 1;
+    } else {
+        env->crucible_hardware_error.syndrome = exception->syndrome;
+        env->crucible_hardware_error.address = exception->fault_address;
+        env->crucible_hardware_error.synchronous_pending = 1;
+    }
+    env->crucible_hardware_error.fatal = exception->aarch64_ras.fatal;
+    cpu_interrupt(cs, CPU_INTERRUPT_SERROR);
+    return true;
+}
+
+void arm_cpu_inject_fault_exception(
+    CPUState *cs, const CPUFaultException *exception, uintptr_t retaddr)
+{
+    CPUARMState *env = cpu_env(cs);
+    uint32_t exception_index;
+
+    if (exception->record == CPU_FAULT_EXCEPTION_AARCH64_RAS &&
+        exception->aarch64_ras.asynchronous) {
+        g_assert(arm_cpu_queue_fault_hardware_error(cs, exception));
+        cpu_loop_exit(cs);
+    }
+
+    switch (exception->vector) {
+    case CPU_FAULT_AARCH64_UNDEFINED:
+        exception_index = EXCP_UDEF;
+        break;
+    case CPU_FAULT_AARCH64_INSTRUCTION_ABORT:
+        exception_index = EXCP_PREFETCH_ABORT;
+        break;
+    case CPU_FAULT_AARCH64_DATA_ABORT:
+        exception_index = EXCP_DATA_ABORT;
+        break;
+    case CPU_FAULT_AARCH64_BREAKPOINT:
+        exception_index = EXCP_BKPT;
+        break;
+    default:
+        g_assert_not_reached();
+    }
+
+    if (exception->has_fault_address) {
+        env->exception.vaddress = exception->fault_address;
+    }
+    if (retaddr) {
+        raise_exception_ra(env, exception_index, exception->syndrome,
+                           exception_target_el(env), retaddr);
+    }
+    raise_exception(env, exception_index, exception->syndrome,
+                    exception_target_el(env));
+}
+
+void arm_cpu_inject_fault_access_error(
+    CPUState *cs, vaddr address, unsigned size,
+    MMUAccessType access_type, uintptr_t retaddr)
+{
+    ARMCPU *cpu = ARM_CPU(cs);
+    ARMMMUFaultInfo fi = {
+        .ea = 1,
+        .type = ARMFault_SyncExternal,
+    };
+
+    if (retaddr) {
+        cpu_restore_state(cs, retaddr);
+    }
+    arm_deliver_fault(cpu, address, access_type,
+                      cpu_mmu_index(cs, false), &fi);
+}
