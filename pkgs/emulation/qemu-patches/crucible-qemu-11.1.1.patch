+static bool node_reservation_current(
+    const QemuCrucibleFaultEventReservation *reservation)
+{
+    bool current;
+
+    if (!node_storage_process_current()) {
+        return false;
+    }
+    g_mutex_lock(&crucible_node_storage.lock);
+    current = node_storage_find_locked(
+        reservation, CRUCIBLE_NODE_STORAGE_RESERVATION) != NULL;
+    g_mutex_unlock(&crucible_node_storage.lock);
+    return current;
+}
