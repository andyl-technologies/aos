+typedef struct CrucibleFaultVmstateStaged {
+    const QemuCrucibleFaultVmstateSection *section;
+    const uint8_t *payload;
+    size_t payload_len;
+    void *state;
+} CrucibleFaultVmstateStaged;
+
+static struct {
+    GMutex lock;
+    pid_t process;
+    QemuThread thread;
+    const CrucibleFaultVmstateStaged *item;
+    uint64_t issuance;
+    bool calling;
+    bool excluding;
+    QemuCrucibleFaultRegistration *terminal_owner;
+    QemuCrucibleFaultRegistration **terminal_holder;
+    bool physically_returned;
+    int first_status;
+    int post_status;
+} crucible_fault_restore_call;
+
+int qemu_crucible_fault_vmstate_restore_current_v1(void)
+{
+    int status;
+
+    if (qatomic_load_acquire(&crucible_fault_restore_call.process) != getpid()) {
+        return -EPERM;
+    }
+    g_mutex_lock(&crucible_fault_restore_call.lock);
+    status = crucible_fault_restore_call.calling &&
+        !crucible_fault_restore_call.physically_returned &&
+        crucible_fault_restore_call.item && qemu_thread_is_self(&crucible_fault_restore_call.thread) ? 0 : -EPERM;
+    g_mutex_unlock(&crucible_fault_restore_call.lock);
+    return status;
+}
+
+/* This exclusion is entered only by the actual registry removal interval.
+ * It closes the check/entry race with a concurrent real aggregate callback. */
+int qemu_crucible_fault_vmstate_restore_exclude_v1(
+    QemuCrucibleFaultRegistration *owner,
+    QemuCrucibleFaultRegistration **holder)
+{
+    pid_t process = qatomic_load_acquire(&crucible_fault_restore_call.process);
+    int status;
+
+    if ((process && process != getpid()) ||
+        qemu_crucible_fault_registration_retiring_current_v1(owner, holder, false)) {
+        return -EPERM;
+    }
+    g_mutex_lock(&crucible_fault_restore_call.lock);
+    status = crucible_fault_restore_call.calling ||
+        crucible_fault_restore_call.excluding ||
+        crucible_fault_restore_call.post_status ||
+        crucible_fault_restore_call.issuance == UINT64_MAX ? -EBUSY : 0;
+    if (!status) {
+        qatomic_store_release(&crucible_fault_restore_call.process, getpid());
+        qemu_thread_get_self(&crucible_fault_restore_call.thread);
+        crucible_fault_restore_call.issuance++;
+        crucible_fault_restore_call.terminal_owner = owner;
+        crucible_fault_restore_call.terminal_holder = holder;
+        crucible_fault_restore_call.excluding = true;
+    }
+    g_mutex_unlock(&crucible_fault_restore_call.lock);
+    return status;
+}
+
+int qemu_crucible_fault_vmstate_restore_exclusion_return_v1(
+    QemuCrucibleFaultRegistration *owner,
+    QemuCrucibleFaultRegistration **holder, bool removed)
+{
+    int status;
+
+    if (qemu_crucible_fault_registration_retiring_current_v1(owner, holder, removed)) {
+        return -EPERM;
+    }
+    g_mutex_lock(&crucible_fault_restore_call.lock);
+    status = crucible_fault_restore_call.excluding &&
+        !crucible_fault_restore_call.calling &&
+        crucible_fault_restore_call.terminal_owner == owner &&
+        crucible_fault_restore_call.terminal_holder == holder &&
+        qemu_thread_is_self(&crucible_fault_restore_call.thread) ? 0 : -EPERM;
+    if (!status) {
+        crucible_fault_restore_call.excluding = false;
+        crucible_fault_restore_call.terminal_owner = NULL;
+        crucible_fault_restore_call.terminal_holder = NULL;
+    }
+    g_mutex_unlock(&crucible_fault_restore_call.lock);
+    return status;
+}
+
+static bool crucible_fault_restore_enter(const CrucibleFaultVmstateStaged *item)
+{
+    pid_t process = qatomic_load_acquire(&crucible_fault_restore_call.process);
+
+    if (process && process != getpid()) {
+        return false;
+    }
+    g_mutex_lock(&crucible_fault_restore_call.lock);
+    if (crucible_fault_restore_call.calling || crucible_fault_restore_call.excluding ||
+        crucible_fault_restore_call.issuance == UINT64_MAX) {
+        g_mutex_unlock(&crucible_fault_restore_call.lock);
+        return false;
+    }
+    crucible_fault_restore_call.issuance++;
+    qatomic_store_release(&crucible_fault_restore_call.process, getpid());
+    qemu_thread_get_self(&crucible_fault_restore_call.thread);
+    crucible_fault_restore_call.item = item;
+    crucible_fault_restore_call.calling = true;
+    crucible_fault_restore_call.physically_returned = false;
+    crucible_fault_restore_call.first_status = 0;
+    crucible_fault_restore_call.post_status = 0;
+    g_mutex_unlock(&crucible_fault_restore_call.lock);
+    return true;
+}
+
+static int crucible_fault_restore_post(const CrucibleFaultVmstateStaged *item,
+                                        int first)
+{
+    int post;
+
+    if (qatomic_load_acquire(&crucible_fault_restore_call.process) != getpid()) {
+        return -EPERM;
+    }
+    g_mutex_lock(&crucible_fault_restore_call.lock);
+    /* Record the actual callback's return separately from authentication. */
+    crucible_fault_restore_call.first_status = first;
+    crucible_fault_restore_call.physically_returned = true;
+    post = crucible_fault_restore_call.calling &&
+        crucible_fault_restore_call.item == item &&
+        qemu_thread_is_self(&crucible_fault_restore_call.thread) ? 0 : -EPERM;
+    crucible_fault_restore_call.post_status = post;
+    if (!post) {
+        crucible_fault_restore_call.calling = false;
+        crucible_fault_restore_call.item = NULL;
+    }
+    g_mutex_unlock(&crucible_fault_restore_call.lock);
+    return post;
+}
+
+uint64_t qemu_crucible_fault_restore_fixed_bytes_v1(void)
+{
+    return sizeof(crucible_fault_restore_call);
+}
