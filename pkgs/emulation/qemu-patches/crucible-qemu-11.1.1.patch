+static void qemu_plugin_advance_time_bh(void *opaque)
+{
+    QEMUBH *barrier = (QEMUBH *)qatomic_load_acquire(
+        &qemu_plugin_time_advance_barrier);
+    int64_t target_tick = qatomic_read(&qemu_plugin_time_advance_target);
+    int status = 0;
+
+    (void)opaque;
+    if (!barrier) {
+        barrier = qemu_bh_new(qemu_plugin_time_advance_barrier_bh, NULL);
+
+        qatomic_store_release(&qemu_plugin_time_advance_barrier,
+                              (uintptr_t)barrier);
+    }
+    qatomic_store_release(&qemu_plugin_time_advance_timer_state,
+                          QEMU_PLUGIN_TIME_ADVANCE_TIMERS_NOT_READY);
+    if (!has_control) {
+        status = -ENODEV;
+    } else if (qemu_plugin_crucible_vmstop_pending()) {
+        /* An output stop can win after the host reserved this advance. */
+        status = -EBUSY;
+    } else {
+        rr_crucible_sim_trace_idle_stage("bh-before-advance", target_tick);
+        status = icount_advance_virtual_time_to_tick(target_tick);
+        rr_crucible_sim_trace_idle_stage("bh-after-advance", target_tick);
+    }
+
+    qatomic_set(&qemu_plugin_time_advance_status, status);
+    g_assert(strcmp(current_accel_name(), "sim") == 0);
+    qemu_plugin_time_advance_run_on_rr(
+        qemu_plugin_time_advance_service_timers_on_cpu);
+}
