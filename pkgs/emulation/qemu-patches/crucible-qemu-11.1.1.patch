+uint64_t qemu_crucible_startup_source_fixed_control_extent(void)
+{
+    uint64_t receiving = qemu_crucible_checkpoint_owner_bytes();
+    uint64_t control_stop = qemu_plugin_crucible_control_stop_storage_bytes_v1();
+    uint64_t construction = qemu_crucible_machine_construction_frame_storage_bytes_v1();
+    uint64_t watcher = qemu_plugin_crucible_wake_watcher_storage_bytes_v1();
+    uint64_t execution = qemu_crucible_fingerprint_main_execution_storage_bytes_v1();
+    uint64_t park_requests = qemu_crucible_native_park_request_static_extent();
+    uint64_t ram_metadata = qemu_crucible_ram_metadata_fixed_storage_bytes();
+    const uint64_t descriptor_storage[] = {
+        qemu_crucible_ram_read_resize_storage_bytes(),
+        qemu_crucible_ram_read_discard_storage_bytes(),
+        qemu_crucible_ram_read_disposal_storage_bytes(),
+        qemu_crucible_ram_read_mapping_storage_bytes(),
+        qemu_crucible_fault_hardware_catalogue_fixed_storage_bytes_v1(),
+        qemu_crucible_fault_register_workspace_fixed_storage_bytes_v1(),
+        qemu_crucible_fault_node_registration_fixed_storage_bytes_v1(),
+        qemu_crucible_fault_registration_fixed_storage_bytes_v1(),
+        qemu_crucible_fault_interrupt_catalogue_fixed_storage_bytes_v1(),
+        qemu_crucible_fault_clock_registry_fixed_storage_bytes_v1(),
+        qemu_crucible_timer_callback_fixed_storage_bytes_v1(),
+        qemu_plugin_crucible_initial_cpu_dispatch_storage_bytes_v1(),
+        qemu_thread_bounded_registry_fixed_storage_bytes(),
+        qemu_plugin_crucible_native_shmem_dispatch_descriptor_storage_bytes_v1(),
+        qemu_plugin_crucible_native_net_tx_descriptor_storage_bytes_v1(),
+        qemu_plugin_crucible_native_block_io_descriptor_storage_bytes_v1(),
+        qemu_plugin_crucible_native_block_event_descriptor_storage_bytes_v1(),
+        qemu_plugin_crucible_native_block_wait_descriptor_storage_bytes_v1(),
+        qemu_plugin_crucible_native_9p_descriptor_storage_bytes_v1(),
+        qemu_plugin_crucible_native_accelerator_descriptor_storage_bytes_v1(),
+    };
+    uint64_t fixed = sizeof(startup_source);
+
+    /* Exact separate static declarations are consumed by the real preexec
+     * provisional reservation before metadata/artifact/semantic owner births.
+     * Their physical floor remains held through process containment; semantic
+     * Stop/Root completion never refunds or reissues these static allocations. */
+    if (receiving > UINT64_MAX - fixed) {
+        return UINT64_MAX;
+    }
+    fixed += receiving;
+    if (!construction || control_stop > UINT64_MAX - fixed) {
+        return UINT64_MAX;
+    }
+    fixed += control_stop;
+    if (construction > UINT64_MAX - fixed) {
+        return UINT64_MAX;
+    }
+    fixed += construction;
+    if (!watcher || watcher > UINT64_MAX - fixed) {
+        return UINT64_MAX;
+    }
+    fixed += watcher;
+    if (!execution || execution > UINT64_MAX - fixed) {
+        return UINT64_MAX;
+    }
+    fixed += execution;
+    if (!park_requests || park_requests > UINT64_MAX - fixed) {
+        return UINT64_MAX;
+    }
+    fixed += park_requests;
+    if (!ram_metadata || ram_metadata > UINT64_MAX - fixed) {
+        return UINT64_MAX;
+    }
+    fixed += ram_metadata;
+    /* Idle/resume already belongs to control_stop. The retained bounded-record
+     * head and these seven provider association arrays are separate physical
+     * declarations; embedded groups, receipts and members belong to Source. */
+    for (size_t index = 0; index < G_N_ELEMENTS(descriptor_storage); index++) {
+        uint64_t bytes = descriptor_storage[index];
+
+        if (!bytes || bytes > UINT64_MAX - fixed) {
+            return UINT64_MAX;
+        }
+        fixed += bytes;
+    }
+    return fixed;
+}
