+        /* Reach the runtime branch through its real controller reserve;
+         * an unpublished accounting partition correctly returns earlier. */
+        fixture_seven_purpose();
+        g_assert_cmpint(fixture_reserve_seven(&control), ==, 0);
+        startup_source.standing.operation.held = true;
+        startup_source.standing.operation.plugin_id = fixture.ctx.id;
+        startup_source.standing.operation.process = getpid();
+        qemu_thread_get_self(&startup_source.standing.operation.thread);
+        qemu_crucible_startup_source_native_metadata_check();
+        g_assert_not_reached();
+    }
+    g_test_trap_subprocess(NULL, 10000000, 0);
+    g_test_trap_assert_failed();
+    g_test_trap_assert_stderr("*fixture_root_current_unavailable*");
+}
