+static int advance_binding_install(QemuCrucibleSourceAdvanceReceiver *receiver)
+{
+    const QemuCruciblePublisherPublicationView *publication = &receiver->publication;
+    const QemuCruciblePublisherCommandView *command = &publication->command;
+    uint64_t ceiling = UINT64_MAX;
+    bool present = false;
+
+    for (size_t index = 0; index < publication->cohort.planned_count; index++) {
+        const QemuCrucibleProducingActionRow *row = &publication->cohort.rows[index];
+        const uint64_t ends[] = {
+            row->total_end_ns, row->progress_end_ns, row->outer_end_ns,
+            row->private_interval_end_ns,
+        };
+
+        for (size_t end = 0; end < G_N_ELEMENTS(ends); end++) {
+            if (ends[end]) {
+                present = true;
+                ceiling = MIN(ceiling, ends[end]);
+            }
+        }
+    }
+    if (present && ceiling != command->native_ceiling_ns) {
+        return -ESTALE;
+    }
+    /* This copy corroborates the protocol producer's actual cohort contract.
+     * The module still independently authenticates its retained Original and
+     * optional clock; no numeric field issues that Original here. */
+    receiver->binding = (struct qemu_plugin_crucible_advance_binding_v1) {
+        .source_receiver_serial = receiver->serial,
+        .source_publication_serial = receiver->serial,
+        .command_sequence = publication->sequence,
+        .loan_generation = publication->loan_generation,
+        .ticket_serial = publication->ticket_serial,
+        .scheduler_generation = command->scheduler_generation,
+        .initial_raw_icount = command->initial_raw_icount,
+        .max_advance_raw_icount = command->max_advance_raw_icount,
+        .logical_tick_ceiling = command->logical_tick_ceiling,
+        .native_ceiling_ns = command->native_ceiling_ns,
+        .command_frontier = command->command_frontier,
+        .next_idle_generation = command->next_idle_generation,
+        .stop_mode = command->stop_mode,
+        .native_ceiling_present = present,
+    };
+    return 0;
+}
