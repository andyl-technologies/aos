+static int ram_scheduled_callback(void *opaque)
+{
+    RamScheduledTest *state = opaque;
+
+    g_assert_true(bql_locked());
+    g_assert_cmpint(qemu_get_thread_id(), ==, state->owner_thread);
+    state->calls++;
+    g_assert_cmpint(qemu_crucible_ram_cancel_scheduled_main_loop(), ==, -EBUSY);
+    if (state->request_rerun && state->calls == 1) {
+        g_assert_cmpint(qemu_crucible_ram_schedule_on_main_loop(
+                           ram_scheduled_callback, state), ==, 0);
+    }
+    return 0;
+}
