+static void test_fail(const char *message)
+{
+    g_printerr("Crucible instruction live test failed: %s\n", message);
+    abort();
+}
+
+static uint16_t test_get_u16(const uint8_t *bytes)
+{
+    return bytes[0] | (uint16_t)bytes[1] << 8;
+}
+
+static uint32_t test_get_u32(const uint8_t *bytes)
+{
+    return bytes[0] | (uint32_t)bytes[1] << 8 |
+           (uint32_t)bytes[2] << 16 | (uint32_t)bytes[3] << 24;
+}
+
+static const uint8_t *test_event_evidence(
+    const struct qemu_plugin_crucible_fault_event *event,
+    const uint8_t *envelope, size_t envelope_len, size_t *evidence_len)
+{
+    uint32_t request_len;
+    uint32_t encoded_evidence_len;
+
+    if (envelope_len < TEST_EVENT_ENVELOPE_HEADER_BYTES ||
+        memcmp(envelope, "CRUCEVQ1", 8) != 0 ||
+        test_get_u16(envelope + 8) != 1) {
+        test_fail("fault event envelope header is invalid");
+    }
+    request_len = test_get_u32(envelope + 12);
+    encoded_evidence_len = test_get_u32(envelope + 16);
+    if (request_len > envelope_len - TEST_EVENT_ENVELOPE_HEADER_BYTES ||
+        encoded_evidence_len !=
+            envelope_len - TEST_EVENT_ENVELOPE_HEADER_BYTES - request_len ||
+        encoded_evidence_len != event->evidence_length) {
+        test_fail("fault event envelope lengths are invalid");
+    }
+    *evidence_len = encoded_evidence_len;
+    return envelope + TEST_EVENT_ENVELOPE_HEADER_BYTES + request_len;
+}
+
+static uint64_t test_get_u64(const uint8_t *bytes)
+{
+    return test_get_u32(bytes) | (uint64_t)test_get_u32(bytes + 4) << 32;
+}
+
+static bool test_bytes_equal(const uint8_t *bytes, size_t length,
+                             uint8_t expected)
+{
+    for (size_t i = 0; i < length; i++) {
+        if (bytes[i] != expected) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static void test_put_u16(uint8_t *bytes, uint16_t value)
+{
+    bytes[0] = value;
+    bytes[1] = value >> 8;
+}
+
+static void test_put_u32(uint8_t *bytes, uint32_t value)
+{
+    for (size_t i = 0; i < sizeof(value); i++) {
+        bytes[i] = value >> (i * 8);
+    }
+}
+
+static void test_put_u64(uint8_t *bytes, uint64_t value)
+{
+    for (size_t i = 0; i < sizeof(value); i++) {
+        bytes[i] = value >> (i * 8);
+    }
+}
+
+static void test_sha256(const uint8_t *bytes, size_t length,
+                        uint8_t digest[32])
+{
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    gsize digest_len = 32;
+
+    g_checksum_update(checksum, bytes, length);
+    g_checksum_get_digest(checksum, digest, &digest_len);
+    if (digest_len != 32) {
+        test_fail("SHA-256 framing failed");
+    }
+}
+
+static void test_instruction_state_sha256(
+    const uint8_t cpu_sha256[32], const uint8_t ram_sha256[32],
+    const uint8_t device_sha256[32], uint64_t ram_bytes,
+    uint64_t device_bytes, uint8_t digest[32])
+{
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    uint8_t lengths[16];
+    gsize digest_len = 32;
+
+    test_put_u64(lengths, ram_bytes);
+    test_put_u64(lengths + 8, device_bytes);
+    g_checksum_update(
+        checksum, (const uint8_t *)"crucible.instruction-state.v1\0",
+        strlen("crucible.instruction-state.v1") + 1);
+    g_checksum_update(checksum, cpu_sha256, 32);
+    g_checksum_update(checksum, ram_sha256, 32);
+    g_checksum_update(checksum, device_sha256, 32);
+    g_checksum_update(checksum, lengths, sizeof(lengths));
+    g_checksum_get_digest(checksum, digest, &digest_len);
+    if (digest_len != 32) {
+        test_fail("instruction-state SHA-256 framing failed");
+    }
+}
+
+static bool test_port_io_evidence(const uint8_t *evidence, size_t length)
+{
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    uint8_t digest[32];
+    gsize digest_len = sizeof(digest);
+    uint32_t count;
+    uint32_t value_bytes = 0;
+
+    if (length < 56 || memcmp(evidence, "CRUCIOP1", 8) != 0 ||
+        test_get_u16(evidence + 8) != 1 ||
+        test_get_u16(evidence + 10) != 24 ||
+        !test_bytes_equal(evidence + 20, 4, 0)) {
+        return false;
+    }
+    count = test_get_u32(evidence + 12);
+    if (count == 0 || count > 8 || length != 56 + count * 24) {
+        return false;
+    }
+    g_checksum_update(
+        checksum, (const uint8_t *)"crucible.port-io.v1\0",
+        strlen("crucible.port-io.v1") + 1);
+    g_checksum_update(checksum, evidence + 56, count * 24);
+    g_checksum_get_digest(checksum, digest, &digest_len);
+    if (digest_len != sizeof(digest) ||
+        memcmp(digest, evidence + 24, sizeof(digest)) != 0) {
+        return false;
+    }
+    for (uint32_t index = 0; index < count; index++) {
+        const uint8_t *entry = evidence + 56 + index * 24;
+        uint8_t size = entry[1];
+
+        if (entry[0] > 1 || (size != 1 && size != 2 && size != 4) ||
+            entry[2] != 1 || entry[3] != 0 ||
+            !test_bytes_equal(entry + 8 + size, 16 - size, 0)) {
+            return false;
+        }
+        value_bytes += size;
+    }
+    return value_bytes == test_get_u32(evidence + 16);
+}
+
+static void test_identity(uint8_t output[32], uint8_t domain, uint32_t value)
+{
+    memset(output, 0, 32);
+    output[0] = domain;
+    test_put_u32(output + 1, value);
+}
+
+static uint8_t test_hex_nibble(char value)
+{
+    if (value >= '0' && value <= '9') {
+        return value - '0';
+    }
+    if (value >= 'a' && value <= 'f') {
+        return value - 'a' + 10;
+    }
+    if (value >= 'A' && value <= 'F') {
+        return value - 'A' + 10;
+    }
+    test_fail("instruction byte argument is not hexadecimal");
+    return 0;
+}
+
+static uint8_t *test_decode_hex(const char *hex, size_t *length)
+{
+    uint8_t *bytes;
+    size_t hex_len = strlen(hex);
+
+    if (hex_len == 0 || hex_len > 64 || hex_len % 2 != 0) {
+        test_fail("instruction byte argument has an invalid length");
+    }
+    *length = hex_len / 2;
+    bytes = g_malloc(*length);
+    for (size_t i = 0; i < *length; i++) {
+        bytes[i] = (test_hex_nibble(hex[i * 2]) << 4) |
+                   test_hex_nibble(hex[i * 2 + 1]);
+    }
+    return bytes;
+}
+
+static char *test_encode_hex(const uint8_t *bytes, size_t length)
+{
+    static const char digits[] = "0123456789abcdef";
+    char *hex = g_malloc(length * 2 + 1);
+
+    for (size_t i = 0; i < length; i++) {
+        hex[i * 2] = digits[bytes[i] >> 4];
+        hex[i * 2 + 1] = digits[bytes[i] & 15];
+    }
+    hex[length * 2] = '\0';
+    return hex;
+}
+
+static void test_append_field(GByteArray *payload, uint16_t tag,
+                              uint16_t type, const void *value,
+                              uint32_t length)
+{
+    uint8_t header[CRUCIBLE_NODE_FAULT_FIELD_HEADER_V1_BYTES] = { 0 };
+
+    test_put_u16(header + CRUCIBLE_NODE_FAULT_FIELD_TAG_OFFSET, tag);
+    test_put_u16(header + CRUCIBLE_NODE_FAULT_FIELD_TYPE_OFFSET, type);
+    test_put_u32(header + CRUCIBLE_NODE_FAULT_FIELD_LENGTH_OFFSET, length);
+    g_byte_array_append(payload, header, sizeof(header));
+    if (length != 0) {
+        g_byte_array_append(payload, value, length);
+    }
+}
+
+static void test_append_u32(GByteArray *payload, uint16_t tag, uint32_t value)
+{
+    uint8_t bytes[4];
+
+    test_put_u32(bytes, value);
+    test_append_field(payload, tag, CRUCIBLE_NODE_FAULT_FIELD_TYPE_U32,
+                      bytes, sizeof(bytes));
+}
+
+static uint8_t *test_build_instruction_payload(
+    size_t *payload_len, bool compose_replace, bool alternate_selector,
+    uint16_t operation, uint64_t occurrence_count)
+{
+    g_autoptr(GByteArray) payload = g_byte_array_sized_new(1024);
+    g_autofree uint8_t *selector_bytes = g_memdup2(
+        test_instruction_bytes, test_instruction_len);
+    g_autofree char *instruction_hex = NULL;
+    size_t selector_len = test_instruction_len;
+    const char *input_state = test_input_state_json ? test_input_state_json :
+        (test_mode == TEST_INPUT_MISMATCH ?
+             "\"ffffffffffffffffffffffffffffffff"
+             "ffffffffffffffffffffffffffffffff\"" :
+             "null");
+    uint64_t occurrence_first =
+        test_control_plane_mode() ? G_MAXUINT64 : 1;
+    uint64_t selector_occurrence_count =
+        test_control_plane_mode() ? 1 : occurrence_count;
+    g_autofree char *opcode_class = NULL;
+
+    if (test_mode == TEST_REJECT_BYTES) {
+        memset(selector_bytes, test_architecture == 2 ? 0x62 : 0xff,
+               test_instruction_len);
+    } else if (test_mode == TEST_REJECT_PREFIX) {
+        selector_len += 2;
+        selector_bytes = g_realloc(selector_bytes, selector_len);
+        memmove(selector_bytes + 2, selector_bytes, test_instruction_len);
+        selector_bytes[0] = 0xf2;
+        selector_bytes[1] = 0xf3;
+    } else if (test_mode == TEST_REJECT_LOCK) {
+        static const uint8_t invalid_lock_call[] = { 0xf0, 0xff, 0xd0 };
+
+        selector_len = sizeof(invalid_lock_call);
+        selector_bytes = g_realloc(selector_bytes, selector_len);
+        memcpy(selector_bytes, invalid_lock_call, selector_len);
+    } else if (test_mode == TEST_REJECT_A64_CMP_SP) {
+        static const uint8_t compare_immediate[] = {
+            0x1f, 0x04, 0x00, 0xf1,
+        };
+
+        selector_len = sizeof(compare_immediate);
+        selector_bytes = g_realloc(selector_bytes, selector_len);
+        memcpy(selector_bytes, compare_immediate, selector_len);
+    } else if (test_mode == TEST_REJECT_A64_FP_COMPARE_DESTINATION) {
+        static const uint8_t fp_compare[] = { 0x00, 0x20, 0x61, 0x1e };
+
+        selector_len = sizeof(fp_compare);
+        selector_bytes = g_realloc(selector_bytes, selector_len);
+        memcpy(selector_bytes, fp_compare, selector_len);
+    } else if (test_mode == TEST_REJECT_X86_SSE_PREFIX) {
+        static const uint8_t invalid_movaps[] = { 0xf3, 0x0f, 0x28, 0xc0 };
+
+        selector_len = sizeof(invalid_movaps);
+        selector_bytes = g_realloc(selector_bytes, selector_len);
+        memcpy(selector_bytes, invalid_movaps, selector_len);
+    } else if (test_mode == TEST_REJECT_X86_FAR_REGISTER) {
+        static const uint8_t invalid_far_call[] = { 0xff, 0xd8 };
+
+        selector_len = sizeof(invalid_far_call);
+        selector_bytes = g_realloc(selector_bytes, selector_len);
+        memcpy(selector_bytes, invalid_far_call, selector_len);
+    } else if (test_mode == TEST_REJECT_A64_SHIFT_IMM6) {
+        static const uint8_t invalid_add_shift[] = { 0x00, 0x80, 0x00, 0x0b };
+
+        selector_len = sizeof(invalid_add_shift);
+        selector_bytes = g_realloc(selector_bytes, selector_len);
+        memcpy(selector_bytes, invalid_add_shift, selector_len);
+    } else if (test_mode == TEST_REJECT_A64_VECTOR_MODE) {
+        static const uint8_t invalid_vector_store[] = {
+            0x00, 0x08, 0x00, 0x3c,
+        };
+
+        selector_len = sizeof(invalid_vector_store);
+        selector_bytes = g_realloc(selector_bytes, selector_len);
+        memcpy(selector_bytes, invalid_vector_store, selector_len);
+    } else if (test_mode == TEST_REJECT_A64_EXCEPTION_ENCODING) {
+        static const uint8_t invalid_exception[] = { 0x00, 0x00, 0x00, 0xd4 };
+
+        selector_len = sizeof(invalid_exception);
+        selector_bytes = g_realloc(selector_bytes, selector_len);
+        memcpy(selector_bytes, invalid_exception, selector_len);
+    } else if (test_mode == TEST_REJECT_A64_FP_TYPE) {
+        static const uint8_t invalid_fp_type[] = { 0x00, 0x28, 0xe0, 0x1e };
+
+        selector_len = sizeof(invalid_fp_type);
+        selector_bytes = g_realloc(selector_bytes, selector_len);
+        memcpy(selector_bytes, invalid_fp_type, selector_len);
+    } else if (test_mode == TEST_REJECT_A64_VECTOR_SIZE) {
+        static const uint8_t invalid_vector_size[] = { 0x00, 0xd4, 0x60, 0x0e };
+
+        selector_len = sizeof(invalid_vector_size);
+        selector_bytes = g_realloc(selector_bytes, selector_len);
+        memcpy(selector_bytes, invalid_vector_size, selector_len);
+    }
+    if (alternate_selector) {
+        static const uint8_t x86_alternate[] = { 0x48, 0x01, 0xc0 };
+        static const uint8_t aarch64_alternate[] = {
+            0x00, 0x00, 0x00, 0x91,
+        };
+        const uint8_t *alternate = test_architecture == 2 ?
+            x86_alternate : aarch64_alternate;
+        size_t alternate_len = test_architecture == 2 ?
+            sizeof(x86_alternate) : sizeof(aarch64_alternate);
+
+        selector_bytes = g_realloc(selector_bytes, alternate_len);
+        memcpy(selector_bytes, alternate, alternate_len);
+        selector_len = alternate_len;
+    }
+    instruction_hex = test_encode_hex(selector_bytes, selector_len);
+    opcode_class = test_mode == TEST_REJECT_OPCODE_CLASS ?
+        g_strdup_printf("%u", test_architecture == 2 ?
+                        0x01000008U : 0x02000007U) :
+        g_strdup("null");
+    g_autofree char *selector = g_strdup_printf(
+        "CRUCJSN1{\"input_state_sha256\":%s,"
+        "\"instruction_bytes\":\"%s\","
+        "\"occurrence\":{\"kind\":\"periodic\",\"parameters\":{"
+        "\"count\":%" G_GUINT64_FORMAT ",\"first\":%"
+        G_GUINT64_FORMAT
+        ",\"period\":1}},"
+        "\"opcode_class\":%s,\"pc_length\":%zu,"
+        "\"pc_start\":%" G_GUINT64_FORMAT "}",
+        input_state, instruction_hex, selector_occurrence_count,
+        occurrence_first, opcode_class, selector_len, test_pc);
+    g_autofree char *mask = g_malloc0(test_register_bytes * 2 + 1);
+    g_autofree char *value = g_malloc0(test_register_bytes * 2 + 1);
+    g_autofree char *mutation = NULL;
+    uint8_t header[CRUCIBLE_NODE_FAULT_PAYLOAD_HEADER_V1_BYTES] = { 0 };
+    uint8_t zero_hash[32] = { 0 };
+    uint8_t zero_byte = 0;
+    uint8_t action_hash[32];
+    uint8_t target_hash[32];
+    uint8_t schema_hash[32];
+    uint32_t mutation_kind = 0;
+    uint32_t replay_count = 0;
+
+    memset(mask, '0', test_register_bytes * 2);
+    mask[0] = '0';
+    mask[1] = '1';
+    memset(value, '0', test_register_bytes * 2);
+    value[0] = '4';
+    value[1] = '2';
+    mutation = compose_replace ?
+        g_strdup_printf(
+            "CRUCJSN1{\"kind\":\"replace\","
+            "\"parameters\":{\"value\":\"%s\"}}", value) :
+        g_strdup_printf(
+            "CRUCJSN1{\"kind\":\"bit_flip\","
+            "\"parameters\":{\"mask\":\"%s\"}}", mask);
+    switch (test_mode) {
+    case TEST_RESULT:
+    case TEST_RESULT_COMPOSE:
+    case TEST_RESULT_INPUT:
+    case TEST_RESULT_INPUT_COMPOSE:
+    case TEST_RESULT_FAULT_RETRY:
+    case TEST_EVENT_SATURATION:
+    case TEST_RESULT_LOAD:
+    case TEST_RESULT_FP_SIMD:
+    case TEST_REJECT_DESTINATION:
+    case TEST_REJECT_A64_CMP_SP:
+    case TEST_REJECT_A64_FP_COMPARE_DESTINATION:
+        mutation_kind = 1;
+        break;
+    case TEST_SKIP:
+    case TEST_REJECT_OVERLAP:
+    case TEST_EXCLUSIVE_SELECTORS:
+    case TEST_SKIP_CONTROL:
+    case TEST_SKIP_EXCEPTION:
+    case TEST_SKIP_LOAD:
+    case TEST_SKIP_STORE:
+    case TEST_SKIP_FP_SIMD:
+    case TEST_INPUT_MISMATCH:
+    case TEST_REJECT_ATOMIC_SKIP:
+    case TEST_REJECT_BYTES:
+    case TEST_REJECT_OPCODE_CLASS:
+    case TEST_REJECT_PREFIX:
+    case TEST_REJECT_LOCK:
+    case TEST_REJECT_X86_SSE_PREFIX:
+    case TEST_REJECT_X86_FAR_REGISTER:
+    case TEST_REJECT_A64_SHIFT_IMM6:
+    case TEST_REJECT_A64_VECTOR_MODE:
+    case TEST_REJECT_A64_EXCEPTION_ENCODING:
+    case TEST_REJECT_A64_FP_TYPE:
+    case TEST_REJECT_A64_VECTOR_SIZE:
+        mutation_kind = 2;
+        break;
+    case TEST_REPLAY:
+    case TEST_REPLAY_STORE:
+    case TEST_REPLAY_ATOMIC:
+    case TEST_REPLAY_DEVICE:
+    case TEST_REPLAY_LOAD:
+    case TEST_REPLAY_FP_SIMD:
+    case TEST_REPLAY_SELF_MODIFY:
+    case TEST_REPLAY_EXCEPTION:
+    case TEST_REJECT_CONTROL_REPLAY:
+        mutation_kind = 3;
+        replay_count = 2;
+        break;
+    default:
+        test_fail("exception mode used an instruction payload");
+    }
+    test_identity(action_hash, 0xa1,
+                  mutation_kind + (compose_replace ? 16 : 0));
+    test_identity(target_hash, 0xa2, 0);
+    test_identity(schema_hash, 0xa3, 1);
+    memcpy(header + CRUCIBLE_NODE_FAULT_PAYLOAD_MAGIC_OFFSET,
+           "CRUCNOD1", 8);
+    test_put_u16(header + CRUCIBLE_NODE_FAULT_PAYLOAD_VERSION_OFFSET,
+                 CRUCIBLE_NODE_FAULT_PAYLOAD_VERSION_V1);
+    test_put_u16(header + CRUCIBLE_NODE_FAULT_PAYLOAD_COMMAND_KIND_OFFSET,
+                 CRUCIBLE_FAULT_COMMAND_CPU_INSTRUCTION_TRANSFORM);
+    test_put_u16(header + CRUCIBLE_NODE_FAULT_PAYLOAD_OPERATION_OFFSET,
+                 operation);
+    test_put_u16(header + CRUCIBLE_NODE_FAULT_PAYLOAD_TARGET_KIND_OFFSET,
+                 CRUCIBLE_NODE_FAULT_TARGET_VCPU);
+    test_put_u16(header + CRUCIBLE_NODE_FAULT_PAYLOAD_MODEL_PHASE_OFFSET,
+                 test_model_phase);
+    test_put_u64(header + CRUCIBLE_NODE_FAULT_PAYLOAD_GENERATION_OFFSET, 1);
+    memcpy(header + CRUCIBLE_NODE_FAULT_PAYLOAD_ACTION_HASH_OFFSET,
+           action_hash, 32);
+    memcpy(header + CRUCIBLE_NODE_FAULT_PAYLOAD_TARGET_HASH_OFFSET,
+           target_hash, 32);
+    memcpy(header + CRUCIBLE_NODE_FAULT_PAYLOAD_SCHEMA_HASH_OFFSET,
+           schema_hash, 32);
+    test_put_u16(header + CRUCIBLE_NODE_FAULT_PAYLOAD_FIELD_COUNT_OFFSET, 6);
+    g_byte_array_append(payload, header, sizeof(header));
+    test_append_field(payload, CRUCIBLE_NODE_FAULT_FIELD_P1,
+                      CRUCIBLE_NODE_FAULT_FIELD_TYPE_BYTES,
+                      selector, strlen(selector));
+    test_append_u32(payload, CRUCIBLE_NODE_FAULT_FIELD_P2, mutation_kind);
+    test_append_field(payload, CRUCIBLE_NODE_FAULT_FIELD_P3,
+                      CRUCIBLE_NODE_FAULT_FIELD_TYPE_HASH,
+                      mutation_kind == 1 ? test_register_identity : zero_hash,
+                      32);
+    test_append_field(payload, CRUCIBLE_NODE_FAULT_FIELD_P4,
+                      CRUCIBLE_NODE_FAULT_FIELD_TYPE_BYTES,
+                      mutation_kind == 1 ? (uint8_t *)mutation : &zero_byte,
+                      mutation_kind == 1 ? strlen(mutation) : 1);
+    test_append_u32(payload, CRUCIBLE_NODE_FAULT_FIELD_P5, replay_count);
+    test_append_u32(payload, CRUCIBLE_NODE_FAULT_FIELD_T1, 0);
+    *payload_len = payload->len;
+    return g_byte_array_free(g_steal_pointer(&payload), false);
+}
