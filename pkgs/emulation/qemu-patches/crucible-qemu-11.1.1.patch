+static void crucible_test_direct_overlay(int *read_fd, int *write_fd)
+{
+    g_autofree char *path = NULL;
+    int file = g_file_open_tmp("crucible-direct-overlay-XXXXXX", &path, NULL);
+
+    g_assert_cmpint(file, >=, 0);
+    g_assert_cmpint(ftruncate(file, 4096), ==, 0);
+    *read_fd = open(path, O_RDONLY | O_DIRECT | O_CLOEXEC);
+    *write_fd = open(path, O_RDWR | O_DIRECT | O_CLOEXEC);
+    g_assert_cmpint(*read_fd, >=, 0);
+    g_assert_cmpint(*write_fd, >=, 0);
+    g_assert_cmpint(unlink(path), ==, 0);
+    close(file);
