+        qemu_mutex_unlock(&registry->mutex);
+        return -ESTALE;
+    }
+    child->closing = true;
+    qemu_mutex_unlock(&registry->mutex);
+
+    first = callback_child_native_retire(child);
+    if (first) {
+        qemu_mutex_lock(&registry->mutex);
+        child->closing = false;
+        qemu_mutex_unlock(&registry->mutex);
+        return first;
+    }
+    if (needs_destruction) {
+        first = qemu_crucible_startup_source_fingerprint_context_identity_v1(id);
+        if (first) {
+            qemu_mutex_lock(&registry->mutex);
+            child->closing = false;
+            qemu_mutex_unlock(&registry->mutex);
+            return first;
+        }
+        qemu_mutex_lock(&registry->mutex);
+        child->destruction_thread = thread;
+        child->destructor_attempted = true;
+        child->destruction_active = true;
+        qemu_mutex_unlock(&registry->mutex);
