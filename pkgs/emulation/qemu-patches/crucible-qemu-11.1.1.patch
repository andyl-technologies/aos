+static uint32_t fixture_setup(uint8_t *wire, uint32_t app_bytes,
+                              uint32_t selectable_bytes,
+                              uint32_t workspace_bytes, uint32_t startup_bytes)
+{
+    uint32_t total = 36 + app_bytes + selectable_bytes +
+        workspace_bytes + startup_bytes;
+
+    memcpy(wire, "CRUCSUP3", 8);
+    fixture_be32(wire, 8, 3);
+    fixture_be32(wire, 12, 36);
+    fixture_be32(wire, 16, total);
+    fixture_be32(wire, 20, app_bytes);
+    fixture_be32(wire, 24, selectable_bytes);
+    fixture_be32(wire, 28, workspace_bytes);
+    fixture_be32(wire, 32, startup_bytes);
+    return total;
+}
+
+static void test_setup_fields(void)
+{
+    uint8_t wire[300] = { 0 };
+    uint8_t before[300];
