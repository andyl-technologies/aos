index 0000000000000000000000000000000000000000..6d8f8ffc1221e7a2c35adee5980c72f367c8f2b2
--- /dev/null
+++ b/system/crucible-checkpoint.c
@@ -0,0 +1,1431 @@
+/*
+ * Crucible exact checkpoint RAM epochs
+ *
