+    position = timers_state.crucible_rr_cursor_position;
+    if (position >= quantum) {
+        return quantum;
+    }
+
+    /*
+     * The serialized cursor advances when a translation block returns to the
+     * scheduler. Plugin callbacks run inside that block, so include its
+     * retired prefix when reporting the live instruction coordinate. The
+     * terminal value is observable until the scheduler commits the handoff;
+     * only the serialized checkpoint state remains strictly below quantum.
