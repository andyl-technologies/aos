+    if (!qatomic_load_acquire(&startup_source.metadata_partition.published) ||
+        !qatomic_load_acquire(&startup_source.metadata_partition.controller_retained) ||
+        startup_source.metadata_partition.fixed_native_extent !=
+            qemu_crucible_startup_source_fixed_control_extent()) {
+        return -ENOKEY;
+    }
+
+    /* sizeof(Source), including this exact lender, was reserved by the same
+     * authentic preexec floor before Source birth. The entered construction
+     * Original authorizes this once issuer; no new subdivision or clock exists. */
+    account->binding = binding;
+    account->partition = &startup_source.metadata_partition;
+    account->issuer = startup_source.preexec_purpose_owner;
+    account->fixed_native_extent = startup_source.metadata_partition.fixed_native_extent;
+    account->process = getpid();
+    account->process_generation = startup_source.original.process_generation;
+    qatomic_store_release(&account->retained, true);
