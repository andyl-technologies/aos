+/*
+ * Identity a child status must carry regardless of how far its replacement
+ * workers have settled: the plan it was initialized from, exactly.
+ */
+static bool crucible_hot_fork_plugin_child_identity_matches(
+    const QemuCrucibleHotForkPluginChildReinitializer *reinitializer)
+{
+    const struct qemu_plugin_crucible_hot_fork_child_plan *plan =
+        &reinitializer->plan;
+    const QemuPluginCrucibleHotForkChildRuntimeInventory *inventory =
+        &reinitializer->inventory;
+    const struct qemu_plugin_crucible_hot_fork_child_status *status =
+        &inventory->status;
+
+    return inventory->registered && inventory->manifest_consistent &&
+        inventory->generation != 0 && inventory->plugin_id != 0 &&
+        status->schema_version ==
+            QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_STATUS_VERSION &&
+        status->struct_size == sizeof(*status) &&
+        status->parent_process_generation ==
+            plan->parent_process_generation &&
+        status->child_process_generation == plan->child_process_generation &&
+        status->template_generation == plan->template_generation &&
+        status->private_ring_generation == plan->private_ring_generation &&
+        status->plugin_endpoint_generation ==
+            plan->plugin_endpoint_generation &&
+        status->plugin_barrier_generation ==
+            plan->plugin_barrier_generation &&
+        status->control_socket_cookie == plan->control_socket_cookie &&
+        status->wake_eventfd_id == plan->wake_eventfd_id &&
+        status->source_mapping_start == plan->source_mapping_start &&
+        status->source_mapping_length == plan->source_mapping_length &&
+        status->source_mapping_offset == plan->source_mapping_offset &&
+        status->worker_mask == plan->worker_mask &&
+        (status->parked_worker_mask & ~status->worker_mask) == 0;
+}
+
+/*
+ * A held child has every replacement worker parked behind the hold with
+ * nothing pending or in flight.  An active child's workers are live: an
+ * idle worker parks at its receive safe point and a busy one carries an
+ * item, so only the held state constrains those masks.
+ */
+static bool crucible_hot_fork_plugin_child_workers_held(
+    const struct qemu_plugin_crucible_hot_fork_child_status *status)
+{
+    return status->parked_worker_mask == status->worker_mask &&
+        status->pending_worker_mask == 0 &&
+        status->worker_operations_in_flight == 0;
+}
+
+static bool crucible_hot_fork_plugin_child_status_matches(
+    const QemuCrucibleHotForkPluginChildReinitializer *reinitializer,
+    bool active)
+{
+    const struct qemu_plugin_crucible_hot_fork_child_status *status =
+        &reinitializer->inventory.status;
+    const uint32_t expected_flags = active ?
+        QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_MAPPING_INSTALLED |
+            QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_ACTIVE :
+        QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_CALLBACKS_HELD |
+            QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_MAPPING_INSTALLED |
+            QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_WORKERS_READY;
+
+    return crucible_hot_fork_plugin_child_identity_matches(reinitializer) &&
+        status->flags == expected_flags &&
+        status->phase == (active ?
+            QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PHASE_ACTIVE :
+            QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PHASE_WORKERS_HELD) &&
+        (active || crucible_hot_fork_plugin_child_workers_held(status));
+}
+
+/*
+ * A freshly initialized child whose replacement workers have not all
+ * reached their parked safe point yet: the same identity and held phase,
+ * only the readiness flag and a subset of the parked mask outstanding.
+ */
+static bool crucible_hot_fork_plugin_child_workers_settling(
+    const QemuCrucibleHotForkPluginChildReinitializer *reinitializer)
+{
+    const struct qemu_plugin_crucible_hot_fork_child_status *status =
+        &reinitializer->inventory.status;
+
+    return crucible_hot_fork_plugin_child_identity_matches(reinitializer) &&
+        status->flags ==
+            (QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_CALLBACKS_HELD |
+             QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_FLAG_MAPPING_INSTALLED) &&
+        status->phase ==
+            QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_PHASE_WORKERS_HELD &&
+        status->pending_worker_mask == 0 &&
+        status->worker_operations_in_flight == 0;
+}
+
+/* Bound on the replacement workers reaching their parked safe point. */
+#define CRUCIBLE_HOT_FORK_PLUGIN_CHILD_WORKER_SETTLE_US (10 * G_USEC_PER_SEC)
+#define CRUCIBLE_HOT_FORK_PLUGIN_CHILD_WORKER_POLL_US 1000
+
+/*
+ * Written to the child's stderr, which descriptor application has routed to
+ * its branch-private diagnostics stream, when the plugin child status does
+ * not match the plan: the host otherwise sees only EPROTO.
+ */
+static void crucible_hot_fork_plugin_child_report_status(
+    const QemuCrucibleHotForkPluginChildReinitializer *reinitializer,
+    const char *stage, int result)
+{
+    const QemuPluginCrucibleHotForkChildRuntimeInventory *inventory =
+        &reinitializer->inventory;
+    const struct qemu_plugin_crucible_hot_fork_child_status *status =
+        &inventory->status;
+
+    fprintf(stderr,
+            "crucible hot-fork plugin child %s: result %d registered %d "
+            "consistent %d generation %" PRIu64 " plugin %" PRIu64
+            " identity %d schema %u size %u flags 0x%x phase %u "
+            "workers 0x%" PRIx64 " parked 0x%" PRIx64 " pending 0x%" PRIx64
+            " in-flight %" PRIu64 " process %" PRIu64 "/%" PRIu64
+            " plan %" PRIu64 "/%" PRIu64 "\n",
+            stage, result, inventory->registered,
+            inventory->manifest_consistent, inventory->generation,
+            inventory->plugin_id,
+            crucible_hot_fork_plugin_child_identity_matches(reinitializer),
+            status->schema_version, status->struct_size, status->flags,
+            status->phase, status->worker_mask, status->parked_worker_mask,
+            status->pending_worker_mask, status->worker_operations_in_flight,
+            status->parent_process_generation,
+            status->child_process_generation,
+            reinitializer->plan.parent_process_generation,
+            reinitializer->plan.child_process_generation);
+}
+
+int qemu_crucible_hot_fork_reinitialize_plugin_child(void *opaque)
+{
+    QemuCrucibleHotForkPluginChildReinitializer *reinitializer = opaque;
+    gint64 deadline;
+    int result;
+
+    if (!reinitializer || !reinitializer->prepared ||
+        reinitializer->attempted) {
+        return -EPERM;
+    }
+
+    reinitializer->attempted = true;
+    result = qemu_plugin_crucible_hot_fork_child_runtime(
+        QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_INITIALIZE,
+        &reinitializer->plan, &reinitializer->inventory);
+    if (result != 0) {
+        crucible_hot_fork_plugin_child_report_status(
+            reinitializer, "initialization failed", result);
+        return result;
+    }
+
+    /*
+     * Initialization spawns the replacement workers, but each one parks
+     * behind the retained hold from its own thread, so the readiness the
+     * held status requires arrives after the synchronous call returns.
+     * Query until it does, within a bound; anything other than that
+     * settling shape is a protocol failure straight away.
+     */
+    deadline = g_get_monotonic_time() +
+        CRUCIBLE_HOT_FORK_PLUGIN_CHILD_WORKER_SETTLE_US;
+    while (!crucible_hot_fork_plugin_child_status_matches(
+               reinitializer, false)) {
+        if (!crucible_hot_fork_plugin_child_workers_settling(reinitializer)) {
+            crucible_hot_fork_plugin_child_report_status(
+                reinitializer, "status mismatch", -EPROTO);
+            return -EPROTO;
+        }
+        if (g_get_monotonic_time() >= deadline) {
+            crucible_hot_fork_plugin_child_report_status(
+                reinitializer, "workers never settled", -ETIMEDOUT);
+            return -ETIMEDOUT;
+        }
+        g_usleep(CRUCIBLE_HOT_FORK_PLUGIN_CHILD_WORKER_POLL_US);
+        result = qemu_plugin_crucible_hot_fork_child_runtime(
+            QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_QUERY, NULL,
+            &reinitializer->inventory);
+        if (result != 0) {
+            return result;
+        }
+    }
+
+    reinitializer->initialized = true;
+    return 0;
+}
+
+int qemu_crucible_hot_fork_activate_plugin_child(
+    QemuCrucibleHotForkPluginChildReinitializer *reinitializer)
+{
+    QemuPluginCrucibleHotForkChildRuntimeInventory inventory;
+    int result;
+
+    if (!reinitializer || !reinitializer->prepared ||
+        !reinitializer->attempted || !reinitializer->initialized ||
+        reinitializer->activated ||
+        !crucible_hot_fork_plugin_child_status_matches(
+            reinitializer, false)) {
+        return -EPERM;
+    }
+    result = qemu_plugin_crucible_hot_fork_child_runtime(
+        QEMU_PLUGIN_CRUCIBLE_HOT_FORK_CHILD_RELEASE, NULL, &inventory);
+    if (result != 0) {
+        crucible_hot_fork_plugin_child_report_status(
+            reinitializer, "release failed", result);
+        return result;
+    }
+    reinitializer->inventory = inventory;
+    if (!crucible_hot_fork_plugin_child_status_matches(
+            reinitializer, true)) {
+        crucible_hot_fork_plugin_child_report_status(
+            reinitializer, "activation status mismatch", -EPROTO);
+        return -EPROTO;
+    }
+    reinitializer->activated = true;
+    return 0;
+}
diff --git a/system/crucible-native-park-request.c b/system/crucible-native-park-request.c
new file mode 100644
index 0000000000000000000000000000000000000000..e95e29018a955203b57d45538ffc8e0065181bac
--- /dev/null
+++ b/system/crucible-native-park-request.c
@@ -0,0 +1,1462 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * Native Park reception continuation, charged metadata capture, actual writer
+ * exclusion and physical return journals. Driver drain and snapshot ownership
+ * remain independent prerequisites borrowed by this request.
+ */
+#include "qemu/osdep.h"
+#include "qapi/qapi-commands-run-state.h"
+#include "qapi/error.h"
+#include "qemu/coroutine.h"
+#include "monitor/monitor.h"
+#include <sys/mman.h>
+#include "qemu/main-loop.h"
+#include "qemu/atomic.h"
+#include "qemu/rcu.h"
+#include "qemu/plugin.h"
+#include "qemu/thread.h"
+#include "system/runstate.h"
+#include "system/crucible-ram-quiescence.h"
+#include "qemu/crucible-hot-fork-async.h"
+#include "system/block-backend-global-state.h"
+#include "system/crucible-native-park-request.h"
+#include "plugins/crucible-startup-source.h"
+
+struct QemuCrucibleNativeParkCapture {
+    QemuCrucibleNativeParkRequest *request;
+    QemuCrucibleParentParkMetadataOwner *child;
+    uint64_t sequence;
+    int first_status;
+    int post_status;
+    bool active;
+    bool ready;
+    /* Source policy reentry cannot finish, reuse storage or return gates
+     * before the complete pre/post disposition has been retained. */
+    bool transitioning;
+};
+
+struct QemuCrucibleNativeParkRequest {
+    QemuCrucibleNativeParkRequestView view;
+    QemuCrucibleParentParkPreparedView prepared;
+    QemuCrucibleParkCensus block;
+    QemuCrucibleParkCensus rcu;
+    QemuCrucibleParkCensus async;
+    QemuThread thread;
+    pid_t process;
+    QemuCrucibleNativeParkCapture capture;
+    QemuThreadRamWriterTransaction writers;
+    QemuBlockBackendHotForkBarrierInventory block_report;
+    QemuRcuHotForkBarrierInventory rcu_report;
+    QemuAsyncWorkerHotForkBarrierInventory async_report;
+    struct qemu_plugin_crucible_parent_park_drain_invocation invocation;
+    struct qemu_plugin_crucible_parent_park_drain_status plugin_report;
+    uint64_t plugin_owner_generation;
+    int run_status;
+    int return_status;
+    bool run_attempted;
+    bool run_busy;
+    bool acquire_attempted;
+    bool plugin_returned;
+    bool entered;
+    bool run_finished;
+    QemuCrucibleParentParkReceive *received;
+    QemuCrucibleParentParkLoan *handler_loan;
+    QemuCrucibleParentParkMetadataOwner *handler_child;
+    int handler_status;
+    bool handler_attempted;
+    bool handler_pending;
+    QemuCrucibleParentParkClosure previous_closure;
+    uint64_t capture_sequence;
+    uint64_t storage_sequences[QEMU_CRUCIBLE_PARK_ARRAY_COUNT];
+    int consuming;
+    int creating;
+    bool issued;
+    bool busy;
+};
+
+static QemuCrucibleNativeParkRequest native_park_request;
+
+static bool native_park_output_overlap(const void *output, size_t size,
+                                       const void *owner, size_t owner_size)
+{
+    uintptr_t start = (uintptr_t)output;
+    uintptr_t base = (uintptr_t)owner;
+
+    if (!output || !size || start > UINTPTR_MAX - size ||
+        base > UINTPTR_MAX - owner_size) {
+        return true;
+    }
+    return start < base + owner_size && base < start + size;
+}
+
+static bool
+native_park_prepared_equal(const QemuCrucibleParentParkPreparedView *saved,
+                           const QemuCrucibleParentParkPreparedView *now)
+{
+    return saved->loan == now->loan && saved->receive == now->receive &&
+           saved->ctx == now->ctx && saved->module == now->module &&
+           saved->callback == now->callback &&
+           saved->userdata == now->userdata && saved->runtime == now->runtime &&
+           saved->member == now->member && saved->plugin_id == now->plugin_id &&
+           saved->request_correlation == now->request_correlation &&
+           saved->requested_stopped_generation ==
+               now->requested_stopped_generation;
+}
+
+size_t qemu_crucible_native_park_request_static_extent(void)
+{
+    return sizeof(native_park_request);
+}
+
+/* The second latch read covers a reader that arrived just before creation.
+ * No immutable owner fields are read until publication is either absent or
+ * complete. The issued bit is atomic because it changes during that window. */
+static int
+native_park_request_publication_identity(QemuCrucibleNativeParkRequest *request)
+{
+    if (request != &native_park_request) {
+        return -ESTALE;
+    }
+    if (qatomic_load_acquire(&request->creating)) {
+        return -EBUSY;
+    }
+    if (!qatomic_load_acquire(&request->issued)) {
+        return -ESTALE;
+    }
+    if (qatomic_load_acquire(&request->creating)) {
+        return -EBUSY;
+    }
+    return 0;
+}
+
+int qemu_crucible_native_park_request_identity(
+    QemuCrucibleNativeParkRequest *request, QemuCrucibleParentParkLoan *loan)
+{
+    int status = native_park_request_publication_identity(request);
+
+    if (status) {
+        return status;
+    }
+    if (request->view.loan != loan || request->process != getpid() ||
+        !qemu_thread_is_self(&request->thread)) {
+        return -ESTALE;
+    }
+    return qemu_crucible_parent_park_prepared_identity_v1(loan);
+}
+
+/* Checks publication before fetching the immutable same-loan identity. */
+static int
+native_park_request_own_identity(QemuCrucibleNativeParkRequest *request)
+{
+    int status = native_park_request_publication_identity(request);
+
+    if (status) {
+        return status;
+    }
+    return qemu_crucible_native_park_request_identity(request,
+                                                      request->view.loan);
+}
+
+static bool native_park_census_equal(const QemuCrucibleParkCensus *saved,
+                                     const QemuCrucibleParkCensus *now)
+{
+    return now->complete && now->held &&
+           now->owner_thread_id == qemu_get_thread_id() &&
+           saved->owner_thread_id == now->owner_thread_id &&
+           saved->barrier_generation == now->barrier_generation &&
+           memcmp(saved->generation, now->generation,
+                  sizeof(saved->generation)) == 0 &&
+           memcmp(saved->arrays, now->arrays, sizeof(saved->arrays)) == 0;
+}
+
+static int
+native_park_request_census_current(QemuCrucibleNativeParkRequest *request)
+{
+    QemuCrucibleParkCensus block;
+    QemuCrucibleParkCensus rcu;
+    QemuCrucibleParkCensus async;
+    int status;
+
+    /* Policy callbacks and clock queries never run under these locks. */
+    bql_lock();
+    status = qemu_block_backend_hot_fork_census(
+        QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_QUERY, &block);
+    bql_unlock();
+    if (status) {
+        return status;
+    }
+    status = qemu_rcu_hot_fork_census(QEMU_RCU_HOT_FORK_BARRIER_QUERY, &rcu);
+    if (status) {
+        return status;
+    }
+    status = qemu_async_worker_hot_fork_census(
+        QEMU_ASYNC_WORKER_HOT_FORK_BARRIER_QUERY, &async);
+    if (status) {
+        return status;
+    }
+    if (!native_park_census_equal(&request->block, &block) ||
+        !native_park_census_equal(&request->rcu, &rcu) ||
+        !native_park_census_equal(&request->async, &async)) {
+        return -ESTALE;
+    }
+    return 0;
+}
+
+/* Only the constructor and the guarded public current path call this body.
+ * The constructor retains creating through both policy results and their save.
+ */
+static int
+native_park_request_parent_current(QemuCrucibleNativeParkRequest *request)
+{
+    QemuCrucibleParentParkPreparedView prepared;
+    int status = qemu_crucible_parent_park_prepared_observe_v1(
+        request->view.loan, &prepared);
+
+    if (!status && !native_park_prepared_equal(&request->prepared, &prepared)) {
+        status = -ESTALE;
+    }
+    return status;
+}
+
+static int
+native_park_request_policy_current(QemuCrucibleNativeParkRequest *request)
+{
+    int status = native_park_request_parent_current(request);
+
+    if (!status) {
+        status = native_park_request_census_current(request);
+    }
+    return status;
+}
+
+int qemu_crucible_native_park_request_current(
+    QemuCrucibleNativeParkRequest *request)
+{
+    int status = native_park_request_own_identity(request);
+
+    if (status) {
+        return status;
+    }
+    if (bql_locked() || request->busy || request->view.released ||
+        !request->view.closed) {
+        return -EBUSY;
+    }
+    if (request->view.first_status) {
+        return request->view.first_status;
+    }
+    request->busy = true;
+    status = native_park_request_policy_current(request);
+    request->busy = false;
+    return status;
+}
+
+int qemu_crucible_native_park_request_begin(QemuCrucibleParentParkLoan *loan,
+                                            QemuCrucibleNativeParkRequest **out)
+{
+    QemuCrucibleNativeParkRequest *request = &native_park_request;
+    QemuCrucibleParentParkPreparedView prepared;
+    int status;
+    int post_status;
+
+    if (!out || bql_locked()) {
+        return -EINVAL;
+    }
+    status = qemu_crucible_parent_park_prepared_identity_v1(loan);
+    if (status) {
+        return status;
+    }
+    if (qatomic_cmpxchg(&request->creating, 0, 1) != 0) {
+        return -EBUSY;
+    }
+    if (request->issued) {
+        qatomic_store_release(&request->creating, 0);
+        return -EBUSY;
+    }
+    if (native_park_output_overlap(out, sizeof(*out), request,
+                                   sizeof(*request)) ||
+        native_park_output_overlap(out, sizeof(*out), loan, sizeof(*loan))) {
+        qatomic_store_release(&request->creating, 0);
+        return -EINVAL;
+    }
+    status = qemu_crucible_parent_park_prepared_observe_v1(loan, &prepared);
+    if (status) {
+        qatomic_store_release(&request->creating, 0);
+        return status;
+    }
+
+    request->view.loan = loan;
+    request->prepared = prepared;
+    request->process = getpid();
+    qemu_thread_get_self(&request->thread);
+    qatomic_store_release(&request->issued, true);
+    request->busy = true;
+    *out = request;
+
+    status =
+        qemu_rcu_hot_fork_census(QEMU_RCU_HOT_FORK_BARRIER_HOLD, &request->rcu);
+    if (!status) {
+        status = qemu_async_worker_hot_fork_census(
+            QEMU_ASYNC_WORKER_HOT_FORK_BARRIER_HOLD, &request->async);
+    }
+    if (!status) {
+        bql_lock();
+        status = qemu_block_backend_hot_fork_census(
+            QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_HOLD, &request->block);
+        bql_unlock();
+    }
+    if (!status && (!request->block.complete || !request->rcu.complete ||
+                    !request->async.complete)) {
+        status = -EBUSY;
+    }
+    if (!status && (request->block.owner_thread_id != qemu_get_thread_id() ||
+                    request->rcu.owner_thread_id != qemu_get_thread_id() ||
+                    request->async.owner_thread_id != qemu_get_thread_id())) {
+        status = -ESTALE;
+    }
+
+    request->view.arrays[QEMU_CRUCIBLE_PARK_BLOCK_ENTRIES] =
+        request->block.arrays[0];
+    request->view.arrays[QEMU_CRUCIBLE_PARK_PERSISTENT_ROOTS] =
+        request->block.arrays[1];
+    request->view.arrays[QEMU_CRUCIBLE_PARK_ROOT_COPY] =
+        request->block.arrays[2];
+    request->view.arrays[QEMU_CRUCIBLE_PARK_RCU_READERS] =
+        request->rcu.arrays[0];
+    for (size_t index = 0; index < 4; index++) {
+        request->view.arrays[QEMU_CRUCIBLE_PARK_AIO_CONTEXTS + index] =
+            request->async.arrays[index];
+    }
+    request->view.closed = !status;
+    request->view.first_status = status;
+
+    /* The held canonical output precedes the independent original dual post.
+     * Partial gate effects still require a genuine post, not a copied cause. */
+    post_status = native_park_request_parent_current(request);
+    request->view.post_status = post_status;
+    if (!status) {
+        status = post_status;
+        if (!status) {
+            status = native_park_request_census_current(request);
+        }
+        request->view.first_status = status;
+    }
+    request->busy = false;
+    qatomic_store_release(&request->creating, 0);
+    return status;
+}
+
+int qemu_crucible_native_park_request_observe(
+    QemuCrucibleNativeParkRequest *request,
+    QemuCrucibleNativeParkRequestView *out)
+{
+    int status = native_park_request_own_identity(request);
+
+    if (status || request->busy) {
+        return status ? status : -EINVAL;
+    }
+    if (native_park_output_overlap(out, sizeof(*out), request,
+                                   sizeof(*request)) ||
+        native_park_output_overlap(out, sizeof(*out), request->view.loan,
+                                   sizeof(*request->view.loan))) {
+        return -EINVAL;
+    }
+    *out = request->view;
+    return 0;
+}
+
+static bool
+native_park_storage_quiescent(const QemuCrucibleNativeParkRequest *request)
+{
+    for (size_t index = 0; index < QEMU_CRUCIBLE_PARK_ARRAY_COUNT; index++) {
+        const QemuCrucibleNativeParkStorageSlot *slot =
+            &request->view.slots[index];
+
+        if (slot->users || slot->uncertain ||
+            (slot->attempted &&
+             (!slot->freed ||
+              slot->attempt_sequence != slot->free_sequence))) {
+            return false;
+        }
+    }
+    return true;
+}
+
+int qemu_crucible_native_park_request_release(
+    QemuCrucibleNativeParkRequest *request)
+{
+    QemuCrucibleParkCensus now;
+    int status = native_park_request_own_identity(request);
+
+    if (status) {
+        return status;
+    }
+    if (bql_locked() || request->busy || request->view.released ||
+        request->capture.active || request->capture.transitioning ||
+        qatomic_load_acquire(&request->consuming)) {
+        return -EBUSY;
+    }
+    if (!native_park_storage_quiescent(request)) {
+        return -EBUSY;
+    }
+    request->busy = true;
+    if (request->block.acquired) {
+        bql_lock();
+        status = qemu_block_backend_hot_fork_census(
+            QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_QUERY, &now);
+        if (!status &&
+            now.barrier_generation != request->block.barrier_generation) {
+            status = -ESTALE;
+        }
+        if (!status) {
+            status = qemu_block_backend_hot_fork_census(
+                QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_RELEASE, &now);
+        }
+        bql_unlock();
+        if (!status) {
+            request->block.acquired = false;
+        }
+    }
+    if (!status && request->async.acquired) {
+        status = qemu_async_worker_hot_fork_census(
+            QEMU_ASYNC_WORKER_HOT_FORK_BARRIER_QUERY, &now);
+        if (!status &&
+            now.barrier_generation != request->async.barrier_generation) {
+            status = -ESTALE;
+        }
+        if (!status) {
+            status = qemu_async_worker_hot_fork_census(
+                QEMU_ASYNC_WORKER_HOT_FORK_BARRIER_RELEASE, &now);
+        }
+        if (!status) {
+            request->async.acquired = false;
+        }
+    }
+    if (!status && request->rcu.acquired) {
+        status =
+            qemu_rcu_hot_fork_census(QEMU_RCU_HOT_FORK_BARRIER_QUERY, &now);
+        if (!status &&
+            now.barrier_generation != request->rcu.barrier_generation) {
+            status = -ESTALE;
+        }
+        if (!status) {
+            status = qemu_rcu_hot_fork_census(QEMU_RCU_HOT_FORK_BARRIER_RELEASE,
+                                              &now);
+        }
+        if (!status) {
+            request->rcu.acquired = false;
+        }
+    }
+    request->view.physical_status = status;
+    request->view.released = !status;
+    request->busy = false;
+    return status;
+}
+
+int qemu_crucible_native_park_request_storage_claim(
+    QemuCrucibleNativeParkRequest *request, QemuCrucibleParentParkLoan *loan,
+    QemuCrucibleParentParkMetadataOwner *child)
+{
+    int status = qemu_crucible_native_park_request_identity(request, loan);
+
+    if (status) {
+        return status;
+    }
+    if (!child || request->busy || !request->view.closed ||
+        request->view.released || request->view.first_status ||
+        request->view.metadata_owner || request->view.storage_closed) {
+        return -EBUSY;
+    }
+    request->view.metadata_owner = child;
+    return 0;
+}
+
+int qemu_crucible_native_park_request_storage_close(
+    QemuCrucibleNativeParkRequest *request, QemuCrucibleParentParkLoan *loan,
+    QemuCrucibleParentParkMetadataOwner *child)
+{
+    int status = qemu_crucible_native_park_request_identity(request, loan);
+
+    if (status) {
+        return status;
+    }
+    if (!child || request->view.metadata_owner != child || request->busy ||
+        qatomic_load_acquire(&request->consuming)) {
+        return -ESTALE;
+    }
+    for (size_t index = 0; index < QEMU_CRUCIBLE_PARK_ARRAY_COUNT; index++) {
+        const QemuCrucibleNativeParkStorageSlot *slot =
+            &request->view.slots[index];
+
+        if (slot->users || slot->uncertain ||
+            (slot->attempted &&
+             (!slot->freed ||
+              slot->attempt_sequence != slot->free_sequence)) ||
+            (!slot->attempted &&
+             (slot->raw || slot->born || slot->freed ||
+              slot->attempt_sequence || slot->free_sequence))) {
+            return -EBUSY;
+        }
+    }
+    request->view.storage_closed = true;
+    return 0;
+}
+
+static int native_park_capture_identity(QemuCrucibleNativeParkCapture *capture)
+{
+    QemuCrucibleNativeParkRequest *request = &native_park_request;
+    int status;
+
+    if (capture != &request->capture) {
+        return -ESTALE;
+    }
+    status = native_park_request_own_identity(request);
+    if (status) {
+        return status;
+    }
+    if (capture->transitioning) {
+        return -EBUSY;
+    }
+    return capture->request == request && capture->active &&
+                   qatomic_load_acquire(&request->consuming) &&
+                   capture->child == request->view.metadata_owner
+               ? 0
+               : -ESTALE;
+}
+
+static int native_park_capture_fail(QemuCrucibleNativeParkCapture *capture,
+                                    int status)
+{
+    if (status && !capture->first_status) {
+        capture->first_status = status < 0 ? status : -EPROTO;
+    }
+    return capture->first_status;
+}
+
+int qemu_crucible_native_park_capture_begin(
+    QemuCrucibleNativeParkRequest *request,
+    QemuCrucibleParentParkMetadataOwner *child,
+    QemuCrucibleNativeParkCapture **out)
+{
+    QemuCrucibleNativeParkCapture *capture;
+    int status = native_park_request_own_identity(request);
+
+    if (status) {
+        return status;
+    }
+    if (!out || bql_locked() || !child ||
+        request->view.metadata_owner != child || request->view.storage_closed ||
+        request->view.released ||
+        native_park_output_overlap(out, sizeof(*out), request,
+                                   sizeof(*request))) {
+        return -EINVAL;
+    }
+    if (request->busy || qatomic_cmpxchg(&request->consuming, 0, 1)) {
+        return -EBUSY;
+    }
+    capture = &request->capture;
+    if (request->capture_sequence == UINT64_MAX) {
+        qatomic_store_release(&request->consuming, 0);
+        return -EOVERFLOW;
+    }
+    capture->sequence = ++request->capture_sequence;
+    capture->request = request;
+    capture->child = child;
+    capture->first_status = 0;
+    capture->post_status = 0;
+    capture->active = true;
+    capture->ready = false;
+    capture->transitioning = true;
+    *out = capture;
+
+    status = qemu_crucible_parent_park_metadata_current_v1(child);
+    native_park_capture_fail(capture, status);
+    capture->ready = !status;
+    capture->transitioning = false;
+    return status;
+}
+
+int qemu_crucible_native_park_capture_finish(
+    QemuCrucibleNativeParkCapture *capture)
+{
+    int status = native_park_capture_identity(capture);
+
+    if (status) {
+        return status;
+    }
+    if (bql_locked()) {
+        return -EBUSY;
+    }
+    capture->ready = false;
+    capture->transitioning = true;
+    status = qemu_crucible_parent_park_metadata_current_v1(capture->child);
+    capture->post_status = status;
+    native_park_capture_fail(capture, status);
+    capture->active = false;
+    capture->transitioning = false;
+    qatomic_store_release(&capture->request->consuming, 0);
+    return capture->first_status;
+}
+
+static uint64_t
+native_park_array_generation(QemuCrucibleNativeParkRequest *request,
+                             QemuCrucibleNativeParkArray array)
+{
+    switch (array) {
+    case QEMU_CRUCIBLE_PARK_BLOCK_ENTRIES:
+        return request->block.generation[1];
+    case QEMU_CRUCIBLE_PARK_ROOT_COPY:
+        return request->block.generation[2];
+    case QEMU_CRUCIBLE_PARK_RCU_READERS:
+        return request->rcu.generation[0];
+    case QEMU_CRUCIBLE_PARK_AIO_CONTEXTS:
+    case QEMU_CRUCIBLE_PARK_BOTTOM_HALVES:
+    case QEMU_CRUCIBLE_PARK_AIO_HANDLERS:
+    case QEMU_CRUCIBLE_PARK_TIMERS:
+        return request->async
+            .generation[array - QEMU_CRUCIBLE_PARK_AIO_CONTEXTS];
+    default:
+        return UINT64_MAX;
+    }
+}
+
+int qemu_crucible_native_park_storage_prepare(
+    QemuCrucibleNativeParkCapture *capture, QemuCrucibleNativeParkArray array,
+    size_t count, size_t size, size_t alignment, uint64_t generation,
+    QemuCrucibleNativeParkStorageLoan *out)
+{
+    QemuCrucibleNativeParkStorageSlot *slot;
+    const QemuCrucibleParkArrayRequest *planned;
+    QemuCrucibleNativeParkRequest *request;
+    int status = native_park_capture_identity(capture);
+
+    if (status) {
+        return status;
+    }
+    if (!capture->ready || capture->first_status) {
+        return capture->first_status ? capture->first_status : -EBUSY;
+    }
+    request = capture->request;
+    if (!out || (unsigned)array >= QEMU_CRUCIBLE_PARK_ARRAY_COUNT ||
+        array == QEMU_CRUCIBLE_PARK_PERSISTENT_ROOTS ||
+        native_park_output_overlap(out, sizeof(*out), request,
+                                   sizeof(*request))) {
+        return native_park_capture_fail(capture, -EINVAL);
+    }
+    status =
+        qemu_crucible_parent_park_metadata_credit_v1(capture->child, request);
+    if (status) {
+        return native_park_capture_fail(capture, status);
+    }
+    planned = &request->view.arrays[array];
+    slot = &request->view.slots[array];
+    if (count != planned->count || size != planned->element_size ||
+        alignment != planned->element_alignment ||
+        generation != native_park_array_generation(request, array)) {
+        return native_park_capture_fail(capture, -ESTALE);
+    }
+    if (slot->users || slot->uncertain ||
+        (slot->attempted && (!slot->freed ||
+                             slot->attempt_sequence != slot->free_sequence))) {
+        return native_park_capture_fail(capture, -EBUSY);
+    }
+    *out = (QemuCrucibleNativeParkStorageLoan){0};
+    if (!count) {
+        return 0;
+    }
+    if (request->storage_sequences[array] == UINT64_MAX) {
+        return native_park_capture_fail(capture, -EOVERFLOW);
+    }
+    slot->attempt_sequence = ++request->storage_sequences[array];
+    slot->attempted = true;
+    slot->born = false;
+    slot->freed = false;
+    slot->raw = NULL;
+    slot->uncertain = true;
+    *out = (QemuCrucibleNativeParkStorageLoan){
+        .request = request,
+        .sequence = slot->attempt_sequence,
+        .array = array,
+    };
+    return 0;
+}
+
+int qemu_crucible_native_park_mapping_extent(size_t bytes, size_t *out)
+{
+    size_t page = qemu_real_host_page_size();
+
+    if (!out || !page || (page & (page - 1)) || bytes > SIZE_MAX - (page - 1)) {
+        return -EOVERFLOW;
+    }
+    *out = (bytes + page - 1) & ~(page - 1);
+    return 0;
+}
+
+void *qemu_crucible_native_park_storage_allocate(
+    QemuCrucibleNativeParkCapture *capture,
+    QemuCrucibleNativeParkStorageLoan *loan)
+{
+    QemuCrucibleNativeParkRequest *request = &native_park_request;
+    size_t extent;
+    void *raw;
+
+    if (native_park_capture_identity(capture) || !capture->ready ||
+        capture->first_status || !loan || loan->request != request ||
+        (unsigned)loan->array >= QEMU_CRUCIBLE_PARK_ARRAY_COUNT ||
+        !loan->sequence || request->view.slots[loan->array].born ||
+        request->view.slots[loan->array].raw || request->view.slots[loan->array].freed ||
+        !request->view.slots[loan->array].uncertain ||
+        loan->sequence != request->view.slots[loan->array].attempt_sequence ||
+        qemu_crucible_native_park_mapping_extent(
+            request->view.arrays[loan->array].bytes, &extent) || !extent) {
+        return NULL;
+    }
+    raw = mmap(NULL, extent, PROT_READ | PROT_WRITE,
+               MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    if (raw == MAP_FAILED) {
+        QemuCrucibleNativeParkStorageSlot *slot = &request->view.slots[loan->array];
+
+        /* A failed mmap creates no mapping. Keep the attempt and raw failure,
+         * but do not invent unknown physical custody for that known result. */
+        slot->first_status = -errno;
+        slot->freed = true;
+        slot->free_sequence = slot->attempt_sequence;
+        slot->uncertain = false;
+        native_park_capture_fail(capture, slot->first_status);
+        *loan = (QemuCrucibleNativeParkStorageLoan) { 0 };
+        return NULL;
+    }
+    qemu_crucible_native_park_storage_record(capture, loan, raw);
+    return raw;
+}
+
+void qemu_crucible_native_park_storage_record(
+    QemuCrucibleNativeParkCapture *capture,
+    const QemuCrucibleNativeParkStorageLoan *loan, void *raw)
+{
+    QemuCrucibleNativeParkRequest *request = &native_park_request;
+    QemuCrucibleNativeParkStorageSlot *slot;
+
+    if (capture != &request->capture || request->process != getpid() ||
+        !qemu_thread_is_self(&request->thread) || !loan ||
+        loan->request != request ||
+        (unsigned)loan->array >= QEMU_CRUCIBLE_PARK_ARRAY_COUNT) {
+        return;
+    }
+    slot = &request->view.slots[loan->array];
+    if (!capture->active || !capture->ready || slot->born ||
+        slot->attempt_sequence != loan->sequence || !slot->uncertain) {
+        native_park_capture_fail(capture, -ESTALE);
+        return;
+    }
+
+    /* The actual raw result is retained before any later signed disposition. */
+    slot->raw = raw;
+    slot->born = raw != NULL;
+    slot->users = raw ? 1 : 0;
+    slot->uncertain = !raw;
+    if (!raw) {
+        slot->first_status = -ENOMEM;
+        native_park_capture_fail(capture, -ENOMEM);
+    }
+}
+
+int qemu_crucible_native_park_storage_free(
+    QemuCrucibleNativeParkStorageLoan *loan, void *raw)
+{
+    QemuCrucibleNativeParkRequest *request = &native_park_request;
+    QemuCrucibleNativeParkStorageSlot *slot;
+    size_t extent;
+    int status;
+
+    if (!loan || loan->request != request ||
+        (unsigned)loan->array >= QEMU_CRUCIBLE_PARK_ARRAY_COUNT ||
+        request->process != getpid() ||
+        !qemu_thread_is_self(&request->thread)) {
+        return -ESTALE;
+    }
+    slot = &request->view.slots[loan->array];
+    if (slot->raw != raw || slot->attempt_sequence != loan->sequence) {
+        return -ESTALE;
+    }
+    status = native_park_request_own_identity(request);
+    if (!status) {
+        status = qemu_crucible_parent_park_metadata_identity_v1(
+            request->view.metadata_owner);
+    }
+    if (!status &&
+        (!raw || slot->users != 1 || !slot->born || slot->freed ||
+         slot->uncertain || slot->free_sequence == slot->attempt_sequence)) {
+        status = -ESTALE;
+    }
+    if (status) {
+        slot->physical_status = status;
+        if (!slot->first_physical_status) {
+            slot->first_physical_status = status;
+        }
+        return status;
+    }
+    slot->uncertain = true;
+    status = qemu_crucible_native_park_mapping_extent(
+        request->view.arrays[loan->array].bytes, &extent);
+    if (!status && munmap(raw, extent) < 0) {
+        status = -errno;
+    }
+    if (status) {
+        slot->physical_status = status;
+        if (!slot->first_physical_status) {
+            slot->first_physical_status = status;
+        }
+        return status;
+    }
+    slot->freed = true;
+    slot->free_sequence = slot->attempt_sequence;
+    slot->users = 0;
+    slot->physical_status = 0;
+    slot->uncertain = false;
+    *loan = (QemuCrucibleNativeParkStorageLoan){0};
+    return 0;
+}
+
+int qemu_crucible_native_park_capture_release_ready(
+    QemuCrucibleNativeParkCapture *capture, QemuCrucibleNativeParkArray array,
+    uint64_t barrier_generation)
+{
+    QemuCrucibleParkCensus *census;
+    int status = native_park_capture_identity(capture);
+
+    if (status) {
+        return status;
+    }
+    if (!capture->ready || !native_park_storage_quiescent(capture->request)) {
+        return native_park_capture_fail(capture, -EBUSY);
+    }
+    if (array == QEMU_CRUCIBLE_PARK_RCU_READERS) {
+        census = &capture->request->rcu;
+    } else if (array == QEMU_CRUCIBLE_PARK_AIO_CONTEXTS) {
+        census = &capture->request->async;
+    } else {
+        return native_park_capture_fail(capture, -EINVAL);
+    }
+    if (!census->acquired || census->barrier_generation != barrier_generation) {
+        return native_park_capture_fail(capture, -ESTALE);
+    }
+    status = qemu_crucible_parent_park_metadata_identity_v1(capture->child);
+    return native_park_capture_fail(capture, status);
+}
+
+void qemu_crucible_native_park_capture_released(
+    QemuCrucibleNativeParkCapture *capture, QemuCrucibleNativeParkArray array,
+    uint64_t barrier_generation)
+{
+    QemuCrucibleParkCensus *census;
+
+    if (native_park_capture_identity(capture)) {
+        return;
+    }
+    census = array == QEMU_CRUCIBLE_PARK_RCU_READERS ? &capture->request->rcu
+             : array == QEMU_CRUCIBLE_PARK_AIO_CONTEXTS
+                 ? &capture->request->async
+                 : NULL;
+    if (!census || !census->acquired ||
+        census->barrier_generation == UINT64_MAX ||
+        barrier_generation != census->barrier_generation + 1) {
+        native_park_capture_fail(capture, -ESTALE);
+        return;
+    }
+    /* Keep the frozen census version: a physical return never renews it. */
+    census->acquired = false;
+}
+
+/* Native stop facts come from the retained writer gate and actual VM stop
+ * producer. Request coordinates alone never create an entered callback. */
+static int native_park_stop_current(QemuCrucibleNativeParkRequest *request,
+                                    bool drained)
+{
+    int status;
+
+    bql_lock();
+    status = !runstate_check(RUN_STATE_PAUSED) ||
+        !request->prepared.requested_stopped_generation ||
+        qemu_plugin_crucible_vmstop_generation() !=
+            request->prepared.requested_stopped_generation ? -ESTALE : 0;
+    bql_unlock();
+    if (!status && !request->writers.active) {
+        status = -ENOKEY;
+    }
+    if (!status && drained) {
+        status = qemu_thread_ram_writer_current(&request->writers);
+    }
+    return status;
+}
+
+/* The parent may restart workers only after the real census owners returned.
+ * The same Source loan and writer gate remain held through this disposition. */
+static int native_park_disposition_current(QemuCrucibleNativeParkRequest *request)
+{
+    const QemuCrucibleNativeParkCapture *capture = &request->capture;
+
+    if (capture->request != request || !capture->sequence ||
+        capture->sequence != request->capture_sequence ||
+        capture->child != request->view.metadata_owner) {
+        return -ESTALE;
+    }
+    if (capture->active || capture->ready || capture->transitioning ||
+        request->busy || qatomic_load_acquire(&request->consuming) ||
+        !native_park_storage_quiescent(request)) {
+        return -EBUSY;
+    }
+    if (request->run_status || capture->first_status || capture->post_status ||
+        request->view.physical_status) {
+        int status = request->run_status ? request->run_status :
+            capture->first_status ? capture->first_status :
+            capture->post_status ? capture->post_status :
+            request->view.physical_status;
+
+        return status < 0 ? status : -EPROTO;
+    }
+    if (!request->view.released || request->block.acquired ||
+        request->async.acquired || request->rcu.acquired) {
+        return -EBUSY;
+    }
+    return 0;
+}
+
+int qemu_crucible_native_park_request_invocation(
+    QemuCrucibleNativeParkRequest *request,
+    struct qemu_plugin_crucible_parent_park_drain_invocation *out)
+{
+    int status = native_park_request_own_identity(request);
+
+    if (status || !out || bql_locked()) {
+        return status ? status : -EINVAL;
+    }
+    if (!request->run_busy || !request->writers.active ||
+        native_park_output_overlap(out, sizeof(*out), request, sizeof(*request))) {
+        return -EPERM;
+    }
+    switch (request->invocation.action) {
+    case QEMU_PLUGIN_CRUCIBLE_PARENT_PARK_DRAIN_ACQUIRE:
+    case QEMU_PLUGIN_CRUCIBLE_PARENT_PARK_DRAIN_CHECK:
+        status = native_park_capture_identity(&request->capture);
+        if (!status) {
+            status = native_park_stop_current(request, request->entered);
+        }
+        break;
+    case QEMU_PLUGIN_CRUCIBLE_PARENT_PARK_DRAIN_DISPOSITION:
+        status = native_park_disposition_current(request);
+        break;
+    default:
+        status = -EINVAL;
+        break;
+    }
+    if (!status) {
+        *out = request->invocation;
+    }
+    return status;
+}
+
+static int native_park_callback(QemuCrucibleNativeParkRequest *request,
+                                uint32_t action)
+{
+    struct qemu_plugin_crucible_parent_park_drain_status *report =
+        &request->plugin_report;
+    int status;
+
+    request->invocation =
+        (struct qemu_plugin_crucible_parent_park_drain_invocation) {
+            .schema_version = QEMU_PLUGIN_CRUCIBLE_PARENT_PARK_DRAIN_VERSION,
+            .struct_size = sizeof(request->invocation),
+            .action = action,
+            .disposition = action ==
+                QEMU_PLUGIN_CRUCIBLE_PARENT_PARK_DRAIN_DISPOSITION ?
+                QEMU_PLUGIN_CRUCIBLE_PARENT_PARK_DRAIN_RELINQUISH :
+                QEMU_PLUGIN_CRUCIBLE_PARENT_PARK_DRAIN_DISPOSITION_NONE,
+            .native_context_generation = request->writers.generation,
+            .stopped_generation = request->prepared.requested_stopped_generation,
+            .request_correlation = request->prepared.request_correlation,
+        };
+    /* Save the unchanged-output negative result separately from a prior valid
+     * observation. A previous HELD report is never a disposal observation. */
+    *report = (struct qemu_plugin_crucible_parent_park_drain_status) { 0 };
+    if (action == QEMU_PLUGIN_CRUCIBLE_PARENT_PARK_DRAIN_ACQUIRE) {
+        request->acquire_attempted = true;
+    }
+    status = qemu_crucible_parent_park_invoke_v1(request->view.loan, request,
+                                               report);
+    if (status) {
+        return status;
+    }
+    if (report->schema_version != QEMU_PLUGIN_CRUCIBLE_PARENT_PARK_DRAIN_VERSION ||
+        report->struct_size != sizeof(*report) || report->action != action ||
+        report->native_context_generation != request->writers.generation ||
+        report->stopped_generation != request->prepared.requested_stopped_generation ||
+        report->request_correlation != request->prepared.request_correlation ||
+        !report->plugin_owner_generation || report->first_status > 0 ||
+        report->post_status > 0 ||
+        (request->plugin_owner_generation && request->plugin_owner_generation !=
+             report->plugin_owner_generation)) {
+        return -EPROTO;
+    }
+    request->plugin_owner_generation = report->plugin_owner_generation;
+    request->view.plugin_owner_generation = report->plugin_owner_generation;
+    if (action == QEMU_PLUGIN_CRUCIBLE_PARENT_PARK_DRAIN_DISPOSITION) {
+        request->plugin_returned =
+            report->state == QEMU_PLUGIN_CRUCIBLE_PARENT_PARK_DRAIN_DISPOSED;
+    } else if (report->state != QEMU_PLUGIN_CRUCIBLE_PARENT_PARK_DRAIN_HELD) {
+        return -EBUSY;
+    }
+    return report->first_status ? report->first_status : report->post_status;
+}
+
+static void native_park_run_record(QemuCrucibleNativeParkRequest *request,
+                                    int status)
+{
+    if (status && !request->run_status) {
+        request->run_status = status < 0 ? status : -EPROTO;
+        request->view.operation_status = request->run_status;
+    }
+}
+
+int qemu_crucible_native_park_request_run(
+    QemuCrucibleNativeParkRequest *request,
+    QemuCrucibleParentParkMetadataOwner *child)
+{
+    QemuCrucibleNativeParkCapture *capture = NULL;
+    int status = native_park_request_own_identity(request);
+
+    if (status) {
+        return status;
+    }
+    if (bql_locked() || request->run_attempted || request->run_busy) {
+        return -EBUSY;
+    }
+    request->run_attempted = true;
+    request->run_busy = true;
+    status = qemu_crucible_native_park_capture_begin(request, child, &capture);
+    native_park_run_record(request, status);
+    if (status) {
+        goto finish;
+    }
+
+    /* This is a real admission gate, including when old writers remain. The
+     * plugin's acquire can drain its existing borrowers, but cannot admit new
+     * RAM writers through this gate. Only current certifies drained custody. */
+    status = qemu_thread_ram_writer_close(&request->writers, NULL);
+    request->view.native_generation = request->writers.generation;
+    if (request->writers.active && (status == 0 || status == -EBUSY)) {
+        status = native_park_callback(
+            request, QEMU_PLUGIN_CRUCIBLE_PARENT_PARK_DRAIN_ACQUIRE);
+    }
+    native_park_run_record(request, status);
+    if (!request->run_status) {
+        status = native_park_stop_current(request, true);
+        native_park_run_record(request, status);
+    }
+    if (!request->run_status) {
+        /* The block drain and snapshot have independent existing owners.
+         * This request borrows their actual quiescent observation. It never
+         * manufactures a driver-drain parent from metadata admission. */
+        bql_lock();
+        status = qemu_block_backend_hot_fork_barrier_capture(
+            capture, QEMU_BLOCK_BACKEND_HOT_FORK_BARRIER_QUERY,
+            &request->block_report) ? 0 : -EBUSY;
+        bql_unlock();
+        if (!status && (!request->block_report.quiescent ||
+                        !request->block_report.snapshot_complete ||
+                        request->block_report.owner_thread_id != qemu_get_thread_id())) {
+            status = -EBUSY;
+        }
+        native_park_run_record(request, status);
+    }
+    if (!request->run_status) {
+        qemu_rcu_hot_fork_barrier_capture(capture,
+            QEMU_RCU_HOT_FORK_BARRIER_QUERY, &request->rcu_report);
+        qemu_async_worker_hot_fork_barrier_capture(capture,
+            QEMU_ASYNC_WORKER_HOT_FORK_BARRIER_QUERY, &request->async_report);
+        if (!request->rcu_report.quiescent || !request->async_report.quiescent ||
+            request->rcu_report.owner_thread_id != qemu_get_thread_id() ||
+            request->async_report.owner_thread_id != qemu_get_thread_id()) {
+            native_park_run_record(request, -EBUSY);
+        }
+    }
+    if (!request->run_status) {
+        request->entered = true;
+        status = native_park_callback(
+            request, QEMU_PLUGIN_CRUCIBLE_PARENT_PARK_DRAIN_CHECK);
+        native_park_run_record(request, status);
+    }
+
+finish:
+    qemu_block_backend_hot_fork_barrier_inventory_destroy(&request->block_report);
+    if (capture) {
+        status = qemu_crucible_native_park_capture_finish(capture);
+        native_park_run_record(request, status);
+    }
+    /* Return physical owners even when a semantic post already failed. Keep
+     * each partial return in its census journal; success cannot erase failure. */
+    if (!request->view.released) {
+        status = qemu_crucible_native_park_request_release(request);
+        native_park_run_record(request, status);
+    }
+
+    /* Return this request's block, async and RCU census before restoring
+     * plugin resources. The writer gate still excludes guest producers, and
+     * any capture or physical-return failure retains containment. */
+    if (!request->acquire_attempted) {
+        request->plugin_returned = true;
+    } else if (!request->run_status) {
+        status = native_park_callback(
+            request, QEMU_PLUGIN_CRUCIBLE_PARENT_PARK_DRAIN_DISPOSITION);
+        native_park_run_record(request, status);
+    }
+    request->run_finished = true;
+    request->run_busy = false;
+    return request->run_status;
+}
+
+int qemu_crucible_native_park_request_return(
+    QemuCrucibleNativeParkRequest *request)
+{
+    QemuCrucibleParentParkMetadataOwner *child;
+    int status = native_park_request_own_identity(request);
+
+    if (status) {
+        return status;
+    }
+    if (bql_locked() || request->run_busy || request->capture.active ||
+        (request->acquire_attempted && !request->plugin_returned) ||
+        !native_park_storage_quiescent(request)) {
+        return -EBUSY;
+    }
+    /* A failed constructor can own gates without ever starting a run. Its
+     * exact physical return is still valid and carries the initiating error. */
+    /* A Source child can be born before its Native backlink is accepted.
+     * The actual handler output still owns that failed constructor's loan. */
+    child = request->view.metadata_owner ? request->view.metadata_owner :
+        request->handler_child;
+    if (child && !child->returned) {
+        status = qemu_crucible_parent_park_metadata_identity_return_v1(child);
+    }
+    if (!status && !request->view.released) {
+        status = qemu_crucible_native_park_request_release(request);
+    }
+    if (!status && request->writers.active) {
+        status = qemu_thread_ram_writer_end(&request->writers);
+    }
+    if (status && !request->return_status) {
+        request->return_status = status;
+    }
+    return status;
+}
+
+int qemu_crucible_native_park_request_returned(
+    QemuCrucibleNativeParkRequest *request, QemuCrucibleParentParkLoan *loan)
+{
+    if (request != &native_park_request || request->process != getpid() ||
+        !qemu_thread_is_self(&request->thread)) {
+        return -ESTALE;
+    }
+    if (request->handler_pending || request->run_busy || request->busy ||
+        request->creating || qatomic_load_acquire(&request->consuming) ||
+        request->capture.active || request->writers.active) {
+        return -EBUSY;
+    }
+    if (!request->issued) {
+        return request->handler_attempted && request->received &&
+            request->handler_loan == loan ? 0 : -ESTALE;
+    }
+    if (request->view.loan != loan || request->creating) {
+        return -ESTALE;
+    }
+    return !request->run_busy && !request->capture.active &&
+        !request->writers.active && !request->busy && !request->creating &&
+        !qatomic_load_acquire(&request->consuming) && request->view.released &&
+        (!request->view.metadata_owner ||
+         (request->view.storage_closed && request->view.metadata_owner->returned &&
+          !request->view.metadata_owner->held &&
+          !request->view.metadata_owner->charge.held)) &&
+        (!request->handler_child || request->handler_child->returned) &&
+        (!request->acquire_attempted || request->plugin_returned) &&
+        native_park_storage_quiescent(request) ? 0 : -EBUSY;
+}
+
+static int native_park_hex(const char *text, uint8_t out[32])
+{
+    if (!text || strlen(text) != 64) {
+        return -EINVAL;
+    }
+    for (size_t index = 0; index < 32; index++) {
+        int high = g_ascii_xdigit_value(text[index * 2]);
+        int low = g_ascii_xdigit_value(text[index * 2 + 1]);
+
+        if (high < 0 || low < 0) {
+            return -EINVAL;
+        }
+        out[index] = (high << 4) | low;
+    }
+    return 0;
+}
+
+static int native_park_binding(const CrucibleParentParkBinding *input,
+                                QemuCrucibleParkBinding *out)
+{
+    int status = native_park_hex(input->source_capability, out->source_capability);
+
+    if (!status) {
+        status = native_park_hex(input->source_reservation, out->source_reservation);
+    }
+    if (status) {
+        return status;
+    }
+    out->account_incarnation = input->account_incarnation;
+    out->process_incarnation = input->process_incarnation;
+    out->request_correlation = input->request_correlation;
+    out->command_frontier = input->command_frontier;
+    out->loan_sequence = input->loan_sequence;
+    return !out->account_incarnation || !out->process_incarnation ||
+        !out->request_correlation || !out->loan_sequence ||
+        out->loan_sequence == UINT64_MAX || (out->loan_sequence & 1) ? -EINVAL : 0;
+}
+
+static char *native_park_hex_encode(const uint8_t bytes[32])
+{
+    static const char digits[] = "0123456789abcdef";
+    char *text = g_malloc0(65);
+
+    for (size_t index = 0; index < 32; index++) {
+        text[index * 2] = digits[bytes[index] >> 4];
+        text[index * 2 + 1] = digits[bytes[index] & 15];
+    }
+    return text;
+}
+
+static CrucibleParentParkClosure *native_park_closure_report(
+    const QemuCrucibleParentParkClosure *closed)
+{
+    CrucibleParentParkClosure *result = g_new0(CrucibleParentParkClosure, 1);
+    CrucibleParentParkBinding *binding = g_new0(CrucibleParentParkBinding, 1);
+
+    binding->source_capability =
+        native_park_hex_encode(closed->binding.source_capability);
+    binding->source_reservation =
+        native_park_hex_encode(closed->binding.source_reservation);
+    binding->account_incarnation = closed->binding.account_incarnation;
+    binding->process_incarnation = closed->binding.process_incarnation;
+    binding->request_correlation = closed->binding.request_correlation;
+    binding->command_frontier = closed->binding.command_frontier;
+    binding->loan_sequence = closed->binding.loan_sequence;
+    result->binding = binding;
+    result->completed_requests = closed->completed_requests;
+    result->stopped_generation = closed->stopped_generation;
+    result->native_generation = closed->native_generation;
+    result->plugin_owner_generation = closed->plugin_owner_generation;
+    result->connection_epoch = closed->connection_epoch;
+    result->status = closed->first_status;
+    result->post_status = closed->post_status;
+    result->operation_status = closed->operation_status;
+    result->physical_status = closed->physical_status;
+    result->final_original0_status = closed->final_original_post[0];
+    result->final_original1_status = closed->final_original_post[1];
+    result->writer_status = closed->writer_status;
+    result->writer_first_status = closed->writer_first_status;
+    result->writer_post_status = closed->writer_post_status;
+    /* This field reports absence of an owning publisher witness. It cannot
+     * be inferred from any local-return bit or a fresh publication. */
+    result->publisher_cohort_return_proven = false;
+    return result;
+}
+
+static CrucibleParentParkResult *native_park_result(
+    QemuCrucibleNativeParkRequest *request, int return_status,
+    const QemuCrucibleParkBinding *binding)
+{
+    CrucibleParentParkResult *result = g_new0(CrucibleParentParkResult, 1);
+    QemuCrucibleParentParkReceive *source = request->received;
+    QemuCrucibleParentParkClosure closed;
+    const QemuCrucibleParentParkClosure *history = &request->previous_closure;
+
+    result->status = request->handler_status;
+    result->return_status = return_status;
+    result->received = source && source->main_request_received;
+    result->entered = request->entered;
+    result->pending = request->handler_pending;
+    result->native_returned =
+        !qemu_crucible_native_park_request_returned(request, request->handler_loan);
+    result->terminal_published = source && source->terminal_published;
+    result->post_status = source ? source->post_status : 0;
+    result->mapped_metadata_bytes = request->handler_child ?
+        request->handler_child->requested_mapping : 0;
+    if (!qemu_crucible_parent_park_closure_observe_v1(binding, request, &closed)) {
+        result->closed_request = native_park_closure_report(&closed);
+        history = &closed;
+    }
+    result->completed_requests = history->completed_requests;
+    result->lifetime_first_status = history->lifetime_first_status;
+    result->lifetime_post_status = history->lifetime_post_status;
+    return result;
+}
+
+/* Runs at the real coordinator poll cut, after the issuing QMP BH returned.
+ * Its static context remains paid and Source retains the original Main loan. */
+static int native_park_main_loop(void *opaque)
+{
+    QemuCrucibleNativeParkRequest *request = &native_park_request;
+    QemuCrucibleNativeParkRequest *received_request = NULL;
+    int status;
+    int physical_status = 0;
+
+    if (opaque != request || !request->handler_pending || !bql_locked() ||
+        request->process != getpid() || !qemu_thread_is_self(&request->thread)) {
+        return -EPERM;
+    }
+    bql_unlock();
+    status = qemu_crucible_native_park_request_begin(
+        request->handler_loan, &received_request);
+    if (received_request && received_request != request) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        status = qemu_crucible_parent_park_metadata_create_v1(
+            request->handler_loan, request, &request->handler_child);
+    }
+    if (!status) {
+        status = qemu_crucible_native_park_request_run(request, request->handler_child);
+    }
+    if (request->issued) {
+        physical_status = qemu_crucible_native_park_request_return(request);
+    }
+    request->handler_status = status ? status : physical_status;
+    request->handler_pending = false;
+    bql_lock();
+    return request->handler_status;
+}
+
+CrucibleParentParkResult *qmp_crucible_parent_park_begin(
+    CrucibleParentParkBinding *input, uint64_t stopped_generation,
+    const char *basis_fdname, const char *cancellation_fdname, Error **errp)
+{
+    QemuCrucibleNativeParkRequest *request = &native_park_request;
+    QemuCrucibleParkBinding binding;
+    int status;
+
+    if (!qemu_in_main_thread() || !bql_locked() || qemu_in_coroutine() ||
+        !runstate_check(RUN_STATE_PAUSED) || !stopped_generation ||
+        qemu_plugin_crucible_vmstop_generation() != stopped_generation) {
+        error_setg(errp, "Parent Park requires the actual paused Main boundary");
+        return NULL;
+    }
+    status = native_park_binding(input, &binding);
+    if (status) {
+        error_setg(errp, "Invalid parent Park binding");
+        return NULL;
+    }
+    if (request->handler_attempted) {
+        QemuCrucibleParentParkClosure previous;
+        uint64_t storage_sequences[QEMU_CRUCIBLE_PARK_ARRAY_COUNT];
+        uint64_t capture_sequence = request->capture_sequence;
+
+        memcpy(storage_sequences, request->storage_sequences, sizeof(storage_sequences));
+        status = request->received && request->received->local_closed ?
+            qemu_crucible_parent_park_closure_observe_v1(
+                &request->received->binding, request, &previous) : -EBUSY;
+        if (!status) {
+            status = qemu_crucible_parent_park_rearm_main_v1(&binding, request);
+        }
+        if (status) {
+            error_setg_errno(errp, -status,
+                             "Parent Park requires prior closure and a fresh publisher");
+            return NULL;
+        }
+        /* The genuine Source closure was observed before its closed holders
+         * reset. No active Native loan, mapping, callback or gate survives. */
+        *request = (QemuCrucibleNativeParkRequest) {
+            .previous_closure = previous,
+            .capture_sequence = capture_sequence,
+        };
+        memcpy(request->storage_sequences, storage_sequences, sizeof(storage_sequences));
+    }
+    request->handler_attempted = true;
+    request->process = getpid();
+    qemu_thread_get_self(&request->thread);
+    status = qemu_crucible_parent_park_receive_main_v1(
+        &binding, stopped_generation, basis_fdname, cancellation_fdname,
+        &request->received);
+    bql_unlock();
+    if (!status) {
+        status = qemu_crucible_parent_park_prepared_borrow_v1(
+            request->received, &request->handler_loan);
+    }
+    if (!status) {
+        request->handler_pending = true;
+        status = qemu_crucible_ram_schedule_on_main_loop(native_park_main_loop, request);
+        if (status) {
+            request->handler_pending = false;
+        }
+    }
+    request->handler_status = status;
+    bql_lock();
+    return native_park_result(request, 0, &binding);
+}
+
+CrucibleParentParkResult *qmp_crucible_parent_park_return(
+    CrucibleParentParkBinding *input, Error **errp)
+{
+    QemuCrucibleNativeParkRequest *request = &native_park_request;
+    QemuCrucibleParkBinding binding;
+    int status;
+
+    if (!qemu_in_main_thread() || !bql_locked() || qemu_in_coroutine() ||
+        !request->handler_attempted || !request->received) {
+        error_setg(errp, "No parent Park request is retained on Main");
+        return NULL;
+    }
+    status = native_park_binding(input, &binding);
+    if (status) {
+        error_setg(errp, "Invalid parent Park return binding");
+        return NULL;
+    }
+    if (request->received->local_closed) {
+        /* Observing the authenticated closed request never replays its writer
+         * and contributes no new physical return or publisher retirement. */
+        QemuCrucibleParentParkClosure closed;
+
+        status = qemu_crucible_parent_park_closure_observe_v1(
+            &binding, request, &closed);
+        return native_park_result(request, status, &binding);
+    }
+    /* The first received request and Monitor remain in Source. This later
+     * parser contributes no substitute borrower, descriptor or identity. */
+    bql_unlock();
+    status = request->handler_pending ? -EINPROGRESS : 0;
+    if (!status && request->issued &&
+        qemu_crucible_native_park_request_returned(request, request->handler_loan)) {
+        status = qemu_crucible_native_park_request_return(request);
+    }
+    if (!status) {
+        status = qemu_crucible_parent_park_return_main_v1(
+            &binding, request);
+    }
+    bql_lock();
+    return native_park_result(request, status, &binding);
+}
+
+
+int qemu_crucible_native_park_handler_outcome(
+    QemuCrucibleNativeParkRequest *request,
+    QemuCrucibleParentParkReceive *receive,
+    QemuCrucibleNativeParkRequestView *out)
+{
+    if (request != &native_park_request || !out ||
+        native_park_output_overlap(out, sizeof(*out), request, sizeof(*request)) ||
+        !request->handler_attempted || request->received != receive ||
+        request->handler_pending ||
+        request->process != getpid() || !qemu_thread_is_self(&request->thread)) {
+        return -ESTALE;
+    }
+    *out = request->view;
+    out->loan = request->handler_loan;
+    if (!out->operation_status) {
+        out->operation_status = request->handler_status;
+    }
+    return 0;
+}
diff --git a/system/crucible-observation-realization.c b/system/crucible-observation-realization.c
new file mode 100644
index 0000000000000000000000000000000000000000..5dac90d3e342a9c5af2ddd28e68c2b806aaf67ac
--- /dev/null
+++ b/system/crucible-observation-realization.c
@@ -0,0 +1,480 @@
+/*
+ * Native managed-RAM realization receipt
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/main-loop.h"
+#include "qemu/thread.h"
+#include "qemu/crucible-paged-ram.h"
+#include "hw/core/qdev.h"
+#include "system/memory.h"
+#include "system/crucible-observation-realization.h"
+
+/* Source authenticates its retained preexec debit and entered construction
+ * Original before the native CPU admission body may be born. */
+int qemu_crucible_startup_source_observation_construction_identity_v1(
+    QemuCrucibleObservationConstructionBinding *binding);
+int qemu_crucible_startup_source_observation_construction_current_v1(
+    QemuCrucibleObservationConstructionBinding *binding);
+int qemu_crucible_startup_source_observation_construction_birth_current_v1(
+    QemuCrucibleObservationConstructionBinding *binding,
+    size_t bytes, size_t alignment);
+
+/* Each allocation keeps its separately charged Source header and receipt
+ * storage independently of construction's temporal return. */
+int qemu_crucible_startup_source_cpu_allocation_admit_v1(
+    QemuCrucibleCpuAllocationRequest *request,
+    QemuCrucibleCpuSourceAllocationOwner **out);
+int qemu_crucible_startup_source_cpu_allocation_receipt_borrow_v1(
+    QemuCrucibleCpuAllocationRequest *request,
+    QemuCrucibleCpuSourceAllocationOwner *owner,
+    QemuCrucibleCpuAllocationReceipt **out);
+int qemu_crucible_startup_source_cpu_allocation_result_v1(
+    QemuCrucibleCpuAllocationRequest *request,
+    QemuCrucibleCpuSourceAllocationOwner *owner);
+
+static const ObjectNativeAllocationOps cpu_allocation_ops;
+
+struct QemuCrucibleObservationBootFrame {
+    QemuThreadRamCpuConstruction cpus;
+    ObjectNativeAllocationObserver *allocations;
+    QemuCrucibleObservationConstructionBinding *binding;
+    pid_t process;
+    QemuThread thread;
+    bool held;
+    bool attempted;
+    bool issuing;
+    bool return_recorded;
+    int return_status;
+};
+
+struct QemuCrucibleObservationManagedReceipt {
+    QemuCrucibleObservationConstructionBinding *binding;
+    uint64_t devices;
+    uint64_t listeners;
+    pid_t process;
+    QemuThread thread;
+    bool held;
+    bool accepted;
+};
+
+typedef struct ObservationConstructionBody {
+    QemuCrucibleObservationBootFrame boot;
+    QemuCrucibleObservationManagedReceipt managed;
+} ObservationConstructionBody;
+
+/* The actual early Source class0 constructor debits this exact aggregate
+ * before native birth. Returning temporal boot custody never refunds it. */
+static ObservationConstructionBody construction;
+
+size_t qemu_crucible_observation_boot_body_bytes_v1(void)
+{
+    return sizeof(construction) + object_native_allocation_metadata_bytes();
+}
+
+size_t qemu_crucible_observation_boot_body_alignment_v1(void)
+{
+    return MAX(_Alignof(ObservationConstructionBody),
+               object_native_allocation_metadata_alignment());
+}
+
+size_t qemu_crucible_observation_realization_metadata_bytes_v1(void)
+{
+    return sizeof(construction) + object_native_allocation_metadata_bytes();
+}
+
+static int boot_creator_identity(QemuCrucibleObservationBootFrame *frame)
+{
+    return frame == &construction.boot && frame->attempted && frame->binding &&
+        frame->process == getpid() && qemu_thread_is_self(&frame->thread) ?
+        0 : -ESTALE;
+}
+
+int qemu_crucible_observation_boot_birth_current_v1(
+    QemuCrucibleObservationConstructionBinding *binding)
+{
+    QemuCrucibleObservationBootFrame *frame = &construction.boot;
+    int status = boot_creator_identity(frame);
+
+    /* This is the actual issuing cut inside native begin, not a caller's
+     * pre-dispatch assertion or a byte geometry request. No Source recursion. */
+    return !status && frame->binding == binding && frame->held &&
+        frame->issuing && !frame->return_recorded && !frame->cpus.active ?
+        0 : status ? status : -EPERM;
+}
+
+int qemu_crucible_observation_boot_begin_v1(
+    QemuCrucibleObservationConstructionBinding *binding,
+    QemuCrucibleObservationBootFrame **out)
+{
+    QemuCrucibleObservationBootFrame *frame = &construction.boot;
+    int status;
+
+    if (!out || *out || frame->attempted || !bql_locked()) {
+        return -EINVAL;
+    }
+    /* Authenticate the real preexec Source debit and entered VL frame before
+     * native body publication. Source Current finishes before core locking. */
+    status = qemu_crucible_startup_source_observation_construction_current_v1(
+        binding);
+    if (status) {
+        return status;
+    }
+    *frame = (QemuCrucibleObservationBootFrame) {
+        .binding = binding,
+        .process = getpid(),
+        .held = true,
+        .attempted = true,
+        .issuing = true,
+    };
+    qemu_thread_get_self(&frame->thread);
+    *out = frame;
+    status = qemu_crucible_startup_source_observation_construction_birth_current_v1(
+        binding, qemu_crucible_observation_boot_body_bytes_v1(),
+        qemu_crucible_observation_boot_body_alignment_v1());
+    frame->issuing = false;
+    if (!status) {
+        status = qemu_thread_ram_cpu_construction_begin(&frame->cpus);
+    }
+    if (!status) {
+        /* Register only after this actual prepaid boot owns real CPU admission.
+         * No guest has dispatched; these allocation callbacks cannot run in RR. */
+        status = object_native_allocation_observer_begin(
+            &cpu_allocation_ops, frame, &frame->allocations);
+    }
+    return status;
+}
+
+int qemu_crucible_observation_boot_current_v1(
+    QemuCrucibleObservationBootFrame *frame)
+{
+    int status = boot_creator_identity(frame);
+
+    if (status || !frame->held || frame->issuing || !bql_locked()) {
+        return status ? status : -ESTALE;
+    }
+    status = qemu_crucible_startup_source_observation_construction_current_v1(
+        frame->binding);
+    if (!status) {
+        status = qemu_thread_ram_cpu_construction_current(&frame->cpus);
+    }
+    return status;
+}
+
+int qemu_crucible_observation_boot_return_current_v1(
+    QemuCrucibleObservationConstructionBinding *binding)
+{
+    QemuCrucibleObservationBootFrame *frame = &construction.boot;
+    int status = boot_creator_identity(frame);
+
+    /* Genuine physical return is recorded by the actual owner method below.
+     * Retained managed classification/body charge need not have returned. */
+    return !status && frame->binding == binding && frame->return_recorded &&
+        !frame->return_status && !frame->held && !frame->cpus.active &&
+        !frame->allocations ?
+        0 : status ? status : -EBUSY;
+}
+
+int qemu_crucible_observation_boot_identity_v1(
+    QemuCrucibleObservationBootFrame **out)
+{
+    int status;
+
+    if (!out || *out) {
+        return -EINVAL;
+    }
+    status = qemu_crucible_observation_boot_current_v1(&construction.boot);
+    if (!status) {
+        *out = &construction.boot;
+    }
+    return status;
+}
+
+int qemu_crucible_observation_boot_identity_return_v1(
+    QemuCrucibleObservationBootFrame **owner)
+{
+    QemuCrucibleObservationBootFrame *frame;
+    int status;
+
+    if (!owner || !(frame = *owner)) {
+        return -EINVAL;
+    }
