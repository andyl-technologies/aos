+int qemu_crucible_startup_source_cpu_allocation_result_v1(
+    QemuCrucibleCpuAllocationRequest *request,
+    QemuCrucibleCpuSourceAllocationOwner *owner)
+{
+    void *payload = NULL;
+    void *current_payload = NULL;
+    uint64_t serial = 0;
+    int status = pthread_mutex_trylock(&startup_source.cpu_allocations.lock);
+
+    if (status) {
+        return -status;
+    }
+    status = cpu_allocation_identity_locked(owner);
+    if (!status) {
+        status = qemu_crucible_cpu_allocation_request_serial_v1(request, &serial);
+    }
+    if (!status && (owner->request != request || owner->request_serial != serial ||
+                    !owner->receipt || owner->payload)) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        status = object_native_allocation_result_current(request, owner, &payload);
+    }
+    if (!status) {
+        /* The physical allocator result is held before expiry/post can refuse.
+         * Native also retains it in its callback-free matching free journal. */
+        owner->payload = payload;
+        status = qemu_crucible_cpu_allocation_result_current_v1(
+            request, owner, &current_payload);
+    }
+    if (!status && current_payload != owner->payload) {
+        status = -ESTALE;
+    }
+    pthread_mutex_unlock(&startup_source.cpu_allocations.lock);
+    return status;
+}
