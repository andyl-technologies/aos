+static void test_timestamp_boundary(gconstpointer data)
+{
+    NvmeCtrl controller = { 0 };
+    bool exact = GPOINTER_TO_INT(data);
+    uint64_t timestamp;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    observed_ps = 10 * (__int128)NVME_PICOSECONDS_PER_MILLISECOND + 999999999;
+    initialize_clock(exact);
+    nvme_set_timestamp(&controller, cpu_to_le64(123));
+    g_assert_cmpuint(controller.timestamp_set_qemu_clock_ms, ==, 10);
+
+    observed_ps++;
+    timestamp = le64_to_cpu(nvme_get_timestamp(&controller));
+    g_assert_cmpuint(timestamp & 0xffffffffffffULL, ==, exact ? 123 : 124);
+    g_assert_cmpuint((timestamp >> 49) & 7, ==, 1);
+    g_assert_cmpuint(controller.timestamp_set_phase_ps, ==,
+                     exact ? 999999999 : 0);
+
+    observed_ps = 12 * (__int128)NVME_PICOSECONDS_PER_MILLISECOND - 2;
+    timestamp = le64_to_cpu(nvme_get_timestamp(&controller));
+    g_assert_cmpuint(timestamp & 0xffffffffffffULL, ==, exact ? 123 : 124);
+    observed_ps++;
+    timestamp = le64_to_cpu(nvme_get_timestamp(&controller));
+    g_assert_cmpuint(timestamp & 0xffffffffffffULL, ==, 124);
+}
