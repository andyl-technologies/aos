diff --git a/hw/block/fdc-fingerprint.h b/hw/block/fdc-fingerprint.h
new file mode 100644
index 0000000000000000000000000000000000000000..b40c813d3b11e73429ea8931e8cff07dc5ffb267
--- /dev/null
+++ b/hw/block/fdc-fingerprint.h
@@ -0,0 +1,104 @@
+/*
+ * Floppy disk controller fingerprint projection internals
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef HW_BLOCK_FDC_FINGERPRINT_H
+#define HW_BLOCK_FDC_FINGERPRINT_H
+
+#include "fdc-internal.h"
+#include "migration/qemu-file.h"
+#include "qapi/error.h"
+#include "qemu/timer.h"
+#include "system/block-backend-io.h"
+
+#define FDC_FINGERPRINT_FIFO_SIZE 512
+
+static inline bool fdctrl_state_fingerprint_projection(
+    QEMUFile *f, const FDCtrl *fdctrl, Error **errp)
+{
+    if (!fdctrl->fifo || fdctrl->fifo_size != FDC_FINGERPRINT_FIFO_SIZE ||
+        !fdctrl->result_timer || fdctrl->cur_drv >= MAX_FD ||
+        fdctrl->phase < 1 || fdctrl->phase > 3 ||
+        (fdctrl->data_state & ~0x03) != 0 || fdctrl->data_dir > 5 ||
+        fdctrl->num_floppies != MAX_FD || fdctrl->reset_sensei < 0 ||
+        fdctrl->reset_sensei > 4) {
+        error_setg(errp, "FDC fingerprint has invalid controller state");
+        return false;
+    }
+
+    for (size_t index = 0; index < MAX_FD; index++) {
+        const FDrive *drive = &fdctrl->drives[index];
+        bool backend_present = drive->blk != NULL;
+        bool medium_present = backend_present && blk_bs(drive->blk) != NULL;
+
+        if (medium_present) {
+            error_setg(errp,
+                       "FDC fingerprint does not admit floppy media");
+            return false;
+        }
+        if (drive->drive < FLOPPY_DRIVE_TYPE_144 ||
+            drive->drive > FLOPPY_DRIVE_TYPE_NONE ||
+            drive->disk != FLOPPY_DRIVE_TYPE_NONE || drive->flags != 0 ||
+            drive->bps != 0 || !drive->ro || drive->media_changed != 1 ||
+            drive->media_validated ||
+            (backend_present &&
+             (drive->last_sect != UINT8_MAX ||
+              drive->max_track != UINT8_MAX)) ||
+            (!backend_present &&
+             (drive->drive != FLOPPY_DRIVE_TYPE_NONE ||
+              drive->last_sect != 0 || drive->max_track != 0))) {
+            error_setg(errp,
+                       "FDC fingerprint has unrestorable empty-drive state");
+            return false;
+        }
+    }
+
+    qemu_put_byte(f, fdctrl->sra);
+    qemu_put_byte(f, fdctrl->srb);
+    qemu_put_byte(f, fdctrl->dor | fdctrl->cur_drv);
+    qemu_put_byte(f, fdctrl->tdr);
+    qemu_put_byte(f, fdctrl->dsr);
+    qemu_put_byte(f, fdctrl->msr);
+    qemu_put_byte(f, fdctrl->status0);
+    qemu_put_byte(f, fdctrl->status1);
+    qemu_put_byte(f, fdctrl->status2);
+    qemu_put_be32(f, fdctrl->fifo_size);
+    qemu_put_buffer(f, fdctrl->fifo, fdctrl->fifo_size);
+    qemu_put_be32(f, fdctrl->data_pos);
+    qemu_put_be32(f, fdctrl->data_len);
+    qemu_put_byte(f, fdctrl->data_state);
+    qemu_put_byte(f, fdctrl->data_dir);
+    qemu_put_byte(f, fdctrl->eot);
+    qemu_put_byte(f, fdctrl->timer0);
+    qemu_put_byte(f, fdctrl->timer1);
+    qemu_put_byte(f, fdctrl->precomp_trk);
+    qemu_put_byte(f, fdctrl->config);
+    qemu_put_byte(f, fdctrl->lock);
+    qemu_put_byte(f, fdctrl->pwrd);
+    qemu_put_byte(f, fdctrl->num_floppies);
+
+    for (size_t index = 0; index < MAX_FD; index++) {
+        const FDrive *drive = &fdctrl->drives[index];
+
+        qemu_put_byte(f, drive->blk != NULL);
+        qemu_put_byte(f, drive->drive);
+        qemu_put_byte(f, drive->head);
+        qemu_put_byte(f, drive->track);
+        qemu_put_byte(f, drive->sect);
+        qemu_put_byte(f, drive->media_changed);
+        qemu_put_byte(f, drive->media_rate);
+        qemu_put_byte(f, drive->perpendicular);
+    }
+
+    qemu_put_sbe32(f, fdctrl->reset_sensei);
+    qemu_put_byte(f, timer_pending(fdctrl->result_timer));
+    if (timer_pending(fdctrl->result_timer)) {
+        qemu_put_sbe64(f, timer_expire_time_ns(fdctrl->result_timer));
+    }
+    qemu_put_byte(f, fdctrl->phase);
+    return qemu_file_get_error(f) == 0;
+}
+
+#endif
