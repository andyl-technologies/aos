+int memory_region_read_resize_return(MemoryRegionReadCustody *custody)
+{
+    MemoryRegionReadCustody *member, *child;
+    int status = 0;
+
+    if (!custody || !bql_locked()) {
+        return -EPERM;
+    }
+    if (!custody->resize_acquired) {
+        return !custody->resize_canonical && !custody->resize_serial &&
+            !custody->resize_return_attempted &&
+            !custody->resize_returned ? 0 : -ESTALE;
+    }
+    if (custody->resize_canonical != custody ||
+        custody->resize_process != getpid() ||
+        !qemu_thread_is_self(&custody->resize_thread)) {
+        return -EPERM;
+    }
+    qemu_mutex_lock_ramlist();
+    /* Search by address before trusting intrusive links. A copied cursor
+     * cannot remove the genuine member or inherit its physical receipt. */
+    QLIST_FOREACH(member, &ram_read_resize_registry.members, resize_link) {
+        if (member == custody) {
+            break;
+        }
+    }
+    QLIST_FOREACH(child, &ram_read_discard_registry.members, discard_link) {
+        if (child == custody) {
+            status = -EBUSY;
+            goto out;
+        }
+    }
+    if (custody->resize_return_attempted) {
+        status = custody->resize_returned && !member ? 0 : -EBUSY;
+        goto out;
+    }
+    if (!member || !ram_read_resize_registry.member_count ||
+        !custody->resize_serial ||
+        !custody->reference_acquired || !custody->region_reference_acquired ||
+        !custody->region || OBJECT(custody->region) != custody->region_object ||
+        custody->region->owner != custody->owner ||
+        !custody->ram_block || custody->ram_block->mr != custody->region ||
+        custody->region->ram_block != custody->ram_block) {
+        status = -ESTALE;
+        goto out;
+    }
+    custody->resize_return_attempted = true;
+    QLIST_REMOVE(custody, resize_link);
+    ram_read_resize_registry.member_count--;
+    custody->resize_returned = true;
+out:
+    qemu_mutex_unlock_ramlist();
+    return status;
+}
