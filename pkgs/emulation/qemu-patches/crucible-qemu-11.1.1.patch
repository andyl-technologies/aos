+    g_free(blocks);
+    journal->phase = RAM_RETURN_FREE_RETURNED;
+    qemu_crucible_ram_native_metadata_released(report_bytes);
+    journal->report_returned = true;
+    if (state->cursor_active && journal->address == state->stop_address &&
+        journal->serial == state->stop_serial) {
+        state->stop_reached = true;
+    }
+    return dirty_retirement_status(qemu_crucible_ram_return_settle(journal));
