+static void test_hot_fork_source_graph_descriptor_custody(void)
+{
+    HotForkSourceSetFixture fixture;
+    QemuBlockHotForkSourceSet *sources;
+    QemuBlockHotForkGraphReceipt graph = { 0 };
+    char ancestor[] = "/tmp/qemu-graph-private-XXXXXX";
+    struct stat metadata[3], denied;
+    size_t index, files = 0;
+
+    if (geteuid() == 0) {
+        g_test_skip("Descriptor custody test requires unprivileged DAC checks");
+        return;
+    }
+    test_hot_fork_source_set_setup(&fixture, false);
+    g_assert_nonnull(mkdtemp(ancestor));
+    for (index = 0; index < G_N_ELEMENTS(fixture.paths); index++) {
+        char destination[64];
+
+        g_snprintf(destination, sizeof(destination), "%s/file-%zu",
+                    ancestor, index);
+        g_assert_cmpint(rename(fixture.paths[index], destination), ==, 0);
+        g_strlcpy(fixture.paths[index], destination,
+                  sizeof(fixture.paths[index]));
+        g_assert_cmpint(stat(destination, &metadata[index]), ==, 0);
+    }
+    g_assert_cmpint(chmod(ancestor, 0), ==, 0);
+    g_assert_cmpint(stat(fixture.paths[0], &denied), ==, -1);
+    g_assert_cmpint(errno, ==, EACCES);
+
+    /* Native roots, including VMState, retain their actual open files even
+     * though neither the launch path nor the display path is traversable. */
+    sources = qemu_block_hot_fork_source_set_new(
+        fixture.roots, G_N_ELEMENTS(fixture.roots), &error_abort);
+    g_assert_true(qemu_block_hot_fork_source_set_freeze(sources, &error_abort));
+    g_assert_true(qemu_block_hot_fork_source_set_graph_receipt(
+        sources, 64, 16 * HOT_FORK_SNAPSHOT_SIZE, &graph, &error_abort));
+    for (index = 0; index < graph.count; index++) {
+        QemuBlockHotForkGraphMember *member = &graph.members[index];
+
+        if (member->file_backed) {
+            struct stat *original = &metadata[member->root_index];
+
+            g_assert_cmpuint(member->file_device, ==, original->st_dev);
+            g_assert_cmpuint(member->file_inode, ==, original->st_ino);
+            g_assert_cmpstr(member->file_path, ==,
+                            fixture.paths[member->root_index]);
+            g_assert_cmpuint(strlen(member->file_sha256), ==, 64);
+            files++;
+        }
+    }
+    g_assert_cmpuint(files, ==, G_N_ELEMENTS(fixture.roots));
+    qemu_block_hot_fork_graph_receipt_destroy(&graph);
+    g_assert_true(qemu_block_hot_fork_source_set_restore(sources, &error_abort));
+    g_assert_true(qemu_block_hot_fork_source_set_free(sources, &error_abort));
+
+    g_assert_cmpint(chmod(ancestor, 0700), ==, 0);
+    test_hot_fork_source_set_cleanup(&fixture);
+    g_assert_cmpint(rmdir(ancestor), ==, 0);
+}
