+int qemu_plugin_crucible_ram_research_resident_request_v1(
+    uint32_t schema, uint64_t total_metadata, uint64_t full_resident,
+    uint64_t full_backing, int cancellation_fd)
+{
+    int status;
+
+    if (!bql_locked()) {
+        return -EPERM;
+    }
+    if (qatomic_cmpxchg(&research_resident.state,
+                       RESEARCH_RESIDENT_ABSENT, RESEARCH_RESIDENT_REQUESTING) !=
+        RESEARCH_RESIDENT_ABSENT) {
+        return -EBUSY;
+    }
+    /* Publish the claim before any fallible descriptor observation. A bad
+     * request cannot silently become an ordinary managed or resident launch. */
+    if (schema != 1 || !total_metadata || !full_resident || !full_backing ||
+        cancellation_fd != 11 || admission_regions || capture_active) {
+        qatomic_set(&research_resident.state, RESEARCH_RESIDENT_FAILED);
+        return -EINVAL;
+    }
+    status = research_resident_cancellation_status(cancellation_fd);
+    if (status) {
+        qatomic_set(&research_resident.state, RESEARCH_RESIDENT_FAILED);
+        return status;
+    }
+    research_resident.cancellation_fd = cancellation_fd;
+    research_resident.total_metadata = total_metadata;
+    research_resident.full_resident = full_resident;
+    research_resident.full_backing = full_backing;
+    if (qatomic_cmpxchg(&research_resident.state, RESEARCH_RESIDENT_REQUESTING,
+                       RESEARCH_RESIDENT_REQUESTED) != RESEARCH_RESIDENT_REQUESTING) {
+        return -ENOTSUP;
+    }
+    return 0;
+}
+
+/* Unsupported lifecycle calls can originate outside BQL. They only close
+ * this atomic selection scalar; inventory and descriptor fields stay untouched. */
+int __attribute__((cold))
+qemu_plugin_crucible_ram_research_resident_refuse_transition_v1(void)
+{
+    enum ResearchResidentState previous;
+
+    do {
+        previous = qatomic_read(&research_resident.state);
+        if (previous == RESEARCH_RESIDENT_ABSENT ||
+            previous == RESEARCH_RESIDENT_FAILED) {
+            return -ENOTSUP;
+        }
+    } while (qatomic_cmpxchg(&research_resident.state, previous,
+                            RESEARCH_RESIDENT_FAILED) != previous);
+    return -ENOTSUP;
+}
