+static bool arm_cpu_fingerprint_validate(const ARMCPU *cpu,
+                                         uint32_t *cpreg_count,
+                                         Error **errp)
+{
+    const CPUARMState *env = &cpu->env;
+    bool za_active = FIELD_EX64(env->svcr, SVCR, ZA);
+
+    *cpreg_count = 0;
+
+    if (!arm_feature(env, ARM_FEATURE_AARCH64)) {
+        error_setg(errp, "ARM CPU fingerprint requires an AArch64 CPU");
+        return false;
+    }
+    if (cpu->cpreg_array_len < 0 ||
+        (cpu->cpreg_array_len != 0 && !cpu->cpreg_indexes) ||
+        cpu->sve_max_vq > ARM_MAX_VQ || cpu->sme_max_vq > ARM_MAX_VQ) {
+        error_setg(errp, "ARM CPU fingerprint has invalid register geometry");
+        return false;
+    }
+
+    for (int i = 0; i < cpu->cpreg_array_len; i++) {
+        uint32_t key = kvm_to_cpreg_id(cpu->cpreg_indexes[i]);
+        const ARMCPRegInfo *ri = get_arm_cp_reginfo(cpu->cp_regs, key);
+
+        if (i != 0 && cpu->cpreg_indexes[i] <= cpu->cpreg_indexes[i - 1]) {
+            error_setg(errp,
+                       "ARM CPU fingerprint register order is not canonical");
+            return false;
+        }
+        if (!ri) {
+            error_setg(errp,
+                       "ARM CPU fingerprint cannot resolve system register %#x",
+                       key);
+            return false;
+        }
+        if (!(ri->type & ARM_CP_NO_RAW)) {
+            (*cpreg_count)++;
+        }
+    }
+
+    if (za_active && cpu->sme_max_vq == 0) {
+        error_setg(errp, "ARM CPU has active ZA without an SME vector length");
+        return false;
+    }
+
+    return arm_cpu_continuation_fingerprint_validate(cpu, errp);
+}
