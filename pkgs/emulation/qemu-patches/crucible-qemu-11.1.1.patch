+static GBytes *project_piix_state(PIIXState *piix,
+                                  const int32_t irq_levels[PIIX_NUM_PIRQS])
+{
+    char *path = NULL;
+    int read_fd;
+    int write_fd = g_file_open_tmp("qemu-piix-fingerprint-XXXXXX", &path,
+                                   NULL);
