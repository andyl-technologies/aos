+    .name = "timer",
+    .load = load_timer_ns_projection,
+    .save = save_timer_ns_projection,
+};
+
+/*
+ * New timer-owner subsections use an explicit active marker so every signed
+ * nanosecond coordinate remains representable.  Existing eight-byte timer
+ * fields stay unchanged for ordinary QEMU migration compatibility.
+ */
+static bool load_timer_ns_phase(QEMUFile *f, void *pv, size_t size,
+                                const VMStateField *field, Error **errp)
+{
+    QEMUTimer *timer = pv;
+    uint8_t active = qemu_get_byte(f);
+    int64_t expiry_ns = qemu_get_sbe64(f);
+    uint16_t phase_ps = qemu_get_be16(f);
+
+    if (active > 1 || phase_ps >= PICOSECONDS_PER_NANOSECOND) {
+        error_setg(errp, "invalid exact timer state");
+        return false;
+    }
+    if (!active) {
+        if (expiry_ns != 0 || phase_ps != 0) {
+            error_setg(errp, "inactive exact timer state is not canonical");
+            return false;
+        }
+        timer_del(timer);
+        return true;
+    }
+    if (!timer_mod_ns_phase(timer, expiry_ns, phase_ps)) {
+        error_setg(errp, "exact timer deadline cannot be restored");
+        return false;
+    }
+    return true;
+}
+
+static bool save_timer_ns_phase(QEMUFile *f, void *pv, size_t size,
+                                const VMStateField *field,
+                                JSONWriter *vmdesc, Error **errp)
+{
+    QEMUTimer *timer = pv;
+    uint16_t phase_ps = 0;
+    int64_t expiry_ns = 0;
+    int status;
+
+    status = timer_expire_time_ns_phase(timer, &expiry_ns, &phase_ps);
+    if (status < 0) {
+        error_setg(errp, "exact timer deadline exceeds the stream horizon");
+        return false;
+    }
+    qemu_put_byte(f, status != 0);
+    qemu_put_sbe64(f, expiry_ns);
+    qemu_put_be16(f, phase_ps);
+    return true;
+}
+
