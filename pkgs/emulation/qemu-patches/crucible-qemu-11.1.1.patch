+static FixtureRuntimeParent *fixture_component_workers_start(
+    QemuCrucibleStartupRuntimePurpose *purpose,
+    QemuCrucibleCommandConsumerRequest *bridge_claim,
+    QemuCrucibleCallbackChildRequest *child_claim,
+    QemuCrucibleRunWorkerClaim *run_claim,
+    QemuCrucibleTeardownWorkerClaim *teardown_claim, int *peer)
+{
+    FixtureRuntimeParent *runtime = g_new0(FixtureRuntimeParent, 1);
+    QemuCrucibleCommandConsumerStorage *bridge = NULL;
+    QemuCrucibleCallbackChildStorage *child = NULL;
+    QemuCrucibleCallbackChildOwner *owner = NULL;
+    QemuCrucibleRequiredWorker *run = NULL, *teardown = NULL;
+    int stream[2];
+    uint64_t slice;
+
+    runtime->purpose = purpose;
+    /* Isolated fixture input, like cleanup-only completion custody above.
+     * This models installer enrollment, not a standing observer or operation.
+     * Every allocation/placement/holder/worker transition below is real. */
+    startup_source.fingerprint_completion = (QemuCrucibleFingerprintCompletionBinding) {
+        .installer = startup_source.saved,
+        .runtime = purpose, .view_return = fixture_component_view_return,
+        .userdata = runtime, .module_view_holder = &runtime->module_view,
+        .publication_holder = &runtime->publication,
+        .process = getpid(), .attempted = true, .enrolled = true,
+    };
+    g_assert_cmpint(qemu_plugin_crucible_command_consumer_storage_create_v1(
+        fixture.ctx.id, purpose, bridge_claim, &bridge), ==, 0);
+    g_assert_cmpint(qemu_plugin_crucible_command_consumer_storage_initialize_v1(
+        fixture.ctx.id, bridge, fixture_component_bridge_initialize,
+        fixture_component_bridge_destroy, bridge), ==, 0);
+    g_assert_cmpint(qemu_plugin_crucible_command_consumer_storage_transfer_v1(
+        fixture.ctx.id, purpose, &bridge, &runtime->bridge), ==, 0);
+    g_assert_null(bridge);
+    g_assert_cmpint(qemu_plugin_crucible_callback_child_storage_create_v1(
+        fixture.ctx.id, purpose, child_claim, runtime->bridge, &child), ==, 0);
+    g_assert_cmpint(qemu_plugin_crucible_callback_child_storage_initialize_v1(
+        fixture.ctx.id, child, fixture_component_child_initialize,
+        fixture_component_child_destroy, NULL), ==, 0);
+    g_assert_cmpint(qemu_plugin_crucible_callback_child_storage_transfer_v1(
+        fixture.ctx.id, purpose, &child, &runtime->child), ==, 0);
+    g_assert_null(child);
+    g_assert_cmpint(qemu_plugin_crucible_callback_registration_owner_create_v1(
+        fixture.ctx.id, runtime->child, &owner), ==, 0);
+    g_assert_cmpint(qemu_plugin_crucible_callback_registration_owner_transfer_v1(
+        fixture.ctx.id, &owner, &runtime->owner), ==, 0);
+    g_assert_null(owner);
+
+    g_assert_cmpint(qemu_plugin_crucible_run_worker_create_v1(
+        fixture.ctx.id, purpose, run_claim, runtime->owner, runtime, &run), ==, 0);
+    g_assert_cmpint(qemu_plugin_crucible_required_worker_transfer_v1(
+        fixture.ctx.id, &run, &runtime->run), ==, 0);
+    g_assert_null(run);
+    g_assert_cmpint(qemu_plugin_crucible_teardown_worker_create_v1(
+        fixture.ctx.id, purpose, teardown_claim, runtime->owner, runtime, &teardown), ==, 0);
+    g_assert_cmpint(qemu_plugin_crucible_required_worker_transfer_v1(
+        fixture.ctx.id, &teardown, &runtime->teardown), ==, 0);
+    g_assert_null(teardown);
+
+    /* Wait within the unchanged installing Original, using actual condition
+     * publications. Neither the fixture nor a copied row sets readiness. */
+    qemu_mutex_lock(&startup_source.commands.mutex);
+    while (!startup_source.run_worker.native.ready ||
+           !startup_source.teardown_worker.native.ready) {
+        qemu_mutex_unlock(&startup_source.commands.mutex);
+        g_assert_cmpint(qemu_plugin_crucible_startup_source_query_slice_v1(
+            fixture.ctx.id, &slice), ==, 0);
+        qemu_mutex_lock(&startup_source.commands.mutex);
+        qemu_cond_timedwait(&startup_source.run_worker.native.wake,
+            &startup_source.commands.mutex, 1);
+    }
+    qemu_mutex_unlock(&startup_source.commands.mutex);
+    g_assert_cmpint(qemu_plugin_crucible_required_workers_current_v1(
+        fixture.ctx.id, purpose), ==, 0);
+
+    g_assert_cmpint(socketpair(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, stream), ==, 0);
+    stream[0] = fixture_high_fd(stream[0]);
+    *peer = fixture_high_fd(stream[1]);
+    g_assert_cmpint(qemu_plugin_crucible_run_worker_handoff_v1(
+        fixture.ctx.id, runtime->run, &stream[0]), ==, 0);
+    g_assert_cmpint(stream[0], ==, -1);
+    qemu_sem_wait(&((FixtureRuntimeRunControl *)
+        startup_source.run_worker.native.owning_alias)->wake);
+    g_assert_true(startup_source.run_worker.native.entry_entered);
+    g_assert_true(startup_source.teardown_worker.native.entry_entered);
+    g_assert_null(qemu_crucible_startup_source_native_selection_v1());
+    return runtime;
+}
