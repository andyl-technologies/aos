+    if (callback_child_output_conflicts_locked(out, sizeof(*out))) {
+        status = -EINVAL;
+    } else {
+        status = callback_registrar_identity_locked(borrow, serial);
+    }
+    if (!status) {
+        *out = (QemuCrucibleCallbackPublicationView) {
+            .owner = borrow->owner,
+            .ctx = borrow->owner->installer.ctx,
+            .module = borrow->owner->installer.module,
+            .runtime = borrow->owner->runtime,
+            .child = borrow->owner->child,
+            .child_holder = borrow->owner->child_holder,
+            .bridge = borrow->owner->bridge,
+            .bridge_holder = borrow->owner->bridge_holder,
+            .child_address = borrow->owner->child->address,
+            .child_extent = borrow->owner->child->extent,
+            .child_alignment = borrow->owner->child->alignment,
+            .publication_serial = borrow->publication_serial,
+            .registrar_serial = borrow->serial,
+            .family = borrow->family,
+        };
