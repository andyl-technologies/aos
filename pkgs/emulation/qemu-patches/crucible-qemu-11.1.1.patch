+static void test_deadline(gconstpointer data)
+{
+    unsigned kind = GPOINTER_TO_UINT(data);
+    ARMCPU cpu = { 0 };
+    __int128 deadline;
+    uint64_t count;
+    uint64_t phase;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+    initialize_clock(true);
+    initialize_timers(&cpu);
+    switch (kind) {
+    case 0:
+        observed_ps = ((__int128)1 << 120) + 357;
+        break;
+    case 1:
+        observed_ps = -((__int128)1 << 120) + 357;
+        break;
+    case 2:
+        observed_ps = (__int128)(UINT64_MAX - 2) * 1000 + 357;
+        break;
+    case 3:
+        observed_ps = -2643;
+        break;
+    case 4:
+        observed_ps = 0;
+        cpu.gt_cntfrq_hz = 1;
+        arm_gt_timer_mod_ticks(&cpu, cpu.wfxt_timer, UINT64_MAX);
+        g_assert_true(timer_expire_time_ps_wide(cpu.wfxt_timer) ==
+                      (__int128)UINT64_MAX * PICOSECONDS_PER_SECOND);
+        destroy_timers(&cpu);
+        return;
+    case 5:
+        observed_ps = ((__int128)1 << 120) + 357;
+        count = arm_gt_counter_phase(&cpu, observed_ps, &phase);
+        arm_gt_timer_mod_delta(&cpu, cpu.wfxt_timer, observed_ps, phase,
+                                (__uint128_t)1 << 64);
+        deadline = observed_ps + ((__int128)1 << 64) * 1000 - phase / 1000000000;
+        g_assert_true(timer_expire_time_ps_wide(cpu.wfxt_timer) == deadline);
+        destroy_timers(&cpu);
+        return;
+    default:
+        g_assert_not_reached();
+    }
+    count = gt_get_countervalue_raw(&cpu.env);
+    deadline = observed_ps - ((observed_ps % 1000 + 1000) % 1000) + 5000;
+
+    arm_gt_timer_mod_ticks(&cpu, cpu.wfxt_timer, count + 5);
+    g_assert_true(timer_expire_time_ps_wide(cpu.wfxt_timer) == deadline);
+    observed_ps = deadline - 1;
+    qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL);
+    g_assert_cmpuint(callbacks, ==, 0);
+    observed_ps = deadline;
+    qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL);
+    g_assert_cmpuint(callbacks, ==, 1);
+    g_assert_false(timer_pending(cpu.wfxt_timer));
+
+    destroy_timers(&cpu);
+}
