+static bool virtio_rng_fingerprint_projection(QEMUFile *f,
+                                              const void *opaque,
+                                              Error **errp)
+{
+    const VirtIORNG *vrng = opaque;
+    const RngRequest *request;
+    uint16_t phase_ps = 0;
+    int64_t expiry_ns = 0;
+    int timer_status;
