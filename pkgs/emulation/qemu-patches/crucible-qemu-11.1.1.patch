+        "static int crucible_fault_clock_bind_body(",
+        "static void crucible_clock_vmstate_put_source(",
+        "static int crucible_clock_vmstate_save(",
+    ]
+    bodies = types + "\n".join(function(source, name) for name in signatures)
+    bodies = re.sub(r"\bCrucibleClock", "LegacyClock", bodies)
+    bodies = re.sub(r"\bcrucible_clock_", "legacy_clock_", bodies)
+    bodies = re.sub(r"\bcrucible_fault_clock_", "legacy_fault_clock_", bodies)
+    bodies = bodies.replace("qemu_crucible_fault_clock_source_register",
