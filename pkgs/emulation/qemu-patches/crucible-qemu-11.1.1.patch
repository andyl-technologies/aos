+    QemuCrucibleNativeInvocationRegistry *registry = native_dispatch_hint();
+    QemuCrucibleNativeInvocation *frame;
+    int status = qemu_plugin_crucible_initial_cpu_native_holder_current_v1(cpu, callback);
+
+    if (status || !registry || !registry_process_current(registry, getpid()) ||
+        !callback || callback->registry != registry || callback->suppressed) {
+        return status ? status : -EPERM;
+    }
+    qemu_mutex_lock(&registry->mutex);
+    frame = callback->frame;
+    status = frame_identity_locked(registry, frame, callback->serial, getpid());
+    if (!status && (!frame->live || frame->kind != QEMU_CRUCIBLE_NATIVE_VCPU_INIT ||
+        frame->cpu != cpu || current_cpu != cpu || top_locked(registry) != frame ||
+        frame->suppressed_children || frame->use_references || frame->cpu_return_in_flight ||
+        !frame->cpu_owner || !frame->cpu_receipt || !frame->cpu_generation ||
+        !frame->registration || !frame->registration->descriptor_retained ||
+        !frame->registration->source_authenticated ||
+        !group_identity_locked(registry, frame->registration->group) ||
+        frame->registration->group->terminal || !frame->registration->group->complete ||
+        frame->registration->group->kind != QEMU_CRUCIBLE_NATIVE_GROUP_VCPU_INIT)) {
+        status = -EBUSY;
+    }
+    qemu_mutex_unlock(&registry->mutex);
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+#if defined(CONFIG_LINUX) && !defined(CONFIG_USER_ONLY)
+/* Factual shape only, after actual registry/slot/group authentication. A
+ * matching frame or bare use count cannot call this helper to obtain custody. */
+static int initial_cpu_child_facts_current(
+    QemuCrucibleNativeInvocation *frame, CPUState *cpu,
+    QemuCrucibleNativeInitialCpuChild **holder)
+{
+    QemuCrucibleNativeInitialCpuChild *child = &frame->initial_cpu_child;
+
+    if (!frame->live || frame->kind != QEMU_CRUCIBLE_NATIVE_VCPU_INIT ||
+        frame->cpu != cpu || current_cpu != cpu || frame->suppressed_children ||
+        frame->use_references != 1 || frame->cpu_return_in_flight ||
+        !frame->cpu_owner || !frame->cpu_receipt || !frame->cpu_generation ||
+        !frame->registration || !frame->registration->descriptor_retained ||
+        !frame->registration->source_authenticated ||
+        !holder || *holder != child || child->holder != holder || !child->held ||
+        child->parent_serial != frame->serial || child->serial <= frame->serial) {
+        return -ESTALE;
+    }
+    return 0;
+}
+
+static bool initial_cpu_child_return_facts(
+    const QemuCrucibleNativeInitialCpuChild *child, bool entered)
+{
+    return child->held && child->callback_entered == entered &&
+        child->callback_returned == entered && child->callback_not_entered != entered;
+}
+
+static int initial_cpu_child_identity_locked(
+    QemuCrucibleNativeInvocationRegistry *registry,
+    QemuCrucibleNativeInvocationTicket *callback, CPUState *cpu,
+    QemuCrucibleNativeInitialCpuChild **holder)
+{
+    QemuCrucibleNativeInvocation *frame = callback->frame;
+    int status = frame_identity_locked(registry, frame, callback->serial, getpid());
+
+    if (status) {
+        return status;
+    }
+    if (top_locked(registry) != frame || !frame->registration ||
+        !group_identity_locked(registry, frame->registration->group) ||
+        frame->registration->group->terminal || !frame->registration->group->complete ||
+        frame->registration->group->kind != QEMU_CRUCIBLE_NATIVE_GROUP_VCPU_INIT) {
+        return -ESTALE;
+    }
+    return initial_cpu_child_facts_current(frame, cpu, holder);
+}
+#endif
+
+int qemu_plugin_crucible_native_initial_cpu_child_current_v1(
+    CPUState *cpu, QemuCrucibleNativeInvocationTicket *callback,
+    QemuCrucibleNativeInitialCpuChild **holder, bool returning)
+{
+#if defined(CONFIG_LINUX) && !defined(CONFIG_USER_ONLY)
+    QemuCrucibleNativeInvocationRegistry *registry = native_dispatch_hint();
+    QemuCrucibleCpuSourceAllocationOwner *owner = NULL;
+    QemuCrucibleCpuAllocationReceipt *receipt = NULL;
+    uint64_t generation = 0;
+    int status = qemu_plugin_crucible_initial_cpu_child_holder_current_v1(
+        cpu, callback, holder, returning);
+
+    if (status || !registry || !registry_process_current(registry, getpid()) ||
+        !callback || callback->registry != registry || callback->suppressed) {
+        return status ? status : -EPERM;
+    }
+    status = qemu_crucible_startup_source_cpu_instance_identity_v1(
+        OBJECT(cpu), &owner, &receipt, &generation);
+    if (status) {
+        return status;
+    }
+    qemu_mutex_lock(&registry->mutex);
+    status = initial_cpu_child_identity_locked(registry, callback, cpu, holder);
+    if (!status) {
+        QemuCrucibleNativeInvocation *frame = callback->frame;
+        QemuCrucibleNativeInitialCpuChild *child = &frame->initial_cpu_child;
+
+        if (frame->cpu_owner != owner || frame->cpu_receipt != receipt ||
+            frame->cpu_generation != generation) {
+            status = -ESTALE;
+        }
+        if (!status && returning) {
+            bool entered = false;
+
+            status = qemu_plugin_crucible_initial_cpu_callback_return_observe_v1(
+                cpu, frame->registration->group->callback, &entered);
+            if (!status && (child->register_read.held ||
+                            !initial_cpu_child_return_facts(child, entered))) {
+                status = -ESTALE;
+            }
+        } else if (!status && (child->callback_entered || child->callback_returned ||
+                               child->callback_not_entered)) {
+            status = -ESTALE;
+        }
+    }
+    qemu_mutex_unlock(&registry->mutex);
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_native_initial_cpu_child_begin_v1(
+    CPUState *cpu, QemuCrucibleNativeInvocationTicket *callback,
+    QemuCrucibleNativeInitialCpuChild **holder)
+{
+#if defined(CONFIG_LINUX) && !defined(CONFIG_USER_ONLY)
+    int status = qemu_plugin_crucible_initial_cpu_child_holder_current_v1(
+        cpu, callback, holder, false);
+
+    if (status || !holder || *holder) {
+        return status ? status : -EINVAL;
+    }
+    status = qemu_plugin_crucible_native_initial_cpu_current_v1(cpu, callback);
+    if (status) {
+        return status;
+    }
+    QemuCrucibleNativeInvocationRegistry *registry = callback->registry;
+
+    qemu_mutex_lock(&registry->mutex);
+    QemuCrucibleNativeInvocation *frame = callback->frame;
+
+    status = frame_identity_locked(registry, frame, callback->serial, getpid());
+    if (!status && (frame->use_references || frame->initial_cpu_child.serial ||
+                    !frame->live || top_locked(registry) != frame)) {
+        status = -EBUSY;
+    }
+    if (!status && registry->serial == UINT64_MAX) {
+        status = -EOVERFLOW;
+    }
+    if (!status) {
+        frame->initial_cpu_child = (QemuCrucibleNativeInitialCpuChild) {
+            .holder = holder, .parent_serial = frame->serial,
+            .serial = ++registry->serial, .held = true,
+        };
+        frame->use_references++;
+        *holder = &frame->initial_cpu_child;
+    }
+    qemu_mutex_unlock(&registry->mutex);
+    if (!status) {
+        /* A negative Source first/post retains this exact child for the real
+         * not-entered return cut. No callback or scratch may use it yet. */
+        status = qemu_crucible_source_initial_cpu_child_acquire_v1(cpu, *holder);
+    }
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_native_initial_cpu_child_complete_v1(
+    CPUState *cpu, QemuCrucibleNativeInvocationTicket *callback,
+    QemuCrucibleNativeInitialCpuChild **holder)
+{
+#if defined(CONFIG_LINUX) && !defined(CONFIG_USER_ONLY)
+    bool entered = false;
+    int status = qemu_plugin_crucible_initial_cpu_child_holder_current_v1(
+        cpu, callback, holder, true);
+
+    if (status || !callback || !callback->registry ||
+        callback->registry != native_dispatch_hint() || callback->suppressed ||
+        !registry_process_current(callback->registry, getpid())) {
+        return status ? status : -EPERM;
+    }
+    QemuCrucibleNativeInvocationRegistry *registry = callback->registry;
+
+    qemu_mutex_lock(&registry->mutex);
+    status = initial_cpu_child_identity_locked(registry, callback, cpu, holder);
+    if (!status) {
+        status = qemu_plugin_crucible_initial_cpu_callback_return_observe_v1(
+            cpu, callback->frame->registration->group->callback, &entered);
+    }
+    if (!status) {
+        QemuCrucibleNativeInitialCpuChild *child = *holder;
+
+        if (child->register_read.held) {
+            status = -EBUSY;
+        } else if (child->callback_returned || child->callback_not_entered) {
+            status = -EALREADY;
+        } else {
+            child->callback_entered = entered;
+            child->callback_returned = entered;
+            child->callback_not_entered = !entered;
+        }
+    }
+    qemu_mutex_unlock(&registry->mutex);
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_native_initial_cpu_child_close_v1(
+    CPUState *cpu, QemuCrucibleNativeInvocationTicket *callback,
+    QemuCrucibleNativeInitialCpuChild **holder)
+{
+#if defined(CONFIG_LINUX) && !defined(CONFIG_USER_ONLY)
+    int status = qemu_plugin_crucible_native_initial_cpu_child_current_v1(
+        cpu, callback, holder, true);
+
+    if (status) {
+        return status;
+    }
+    status = qemu_crucible_source_initial_cpu_child_return_v1(cpu, *holder);
+    if (status) {
+        return status;
+    }
+    QemuCrucibleNativeInvocationRegistry *registry = callback->registry;
+
+    qemu_mutex_lock(&registry->mutex);
+    status = initial_cpu_child_identity_locked(registry, callback, cpu, holder);
+    if (!status) {
+        (*holder)->held = false;
+        callback->frame->use_references--;
+        *holder = NULL;
+    }
+    qemu_mutex_unlock(&registry->mutex);
+    /* The parent remains live through this actual Core return. Its ordinary
+     * exit later revokes permission and returns its own real QOM pin. */
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
