+        close_status = qemu_fclose(file);
+        if (status == 0 && close_status != 0) {
+            status = close_status;
+        }
+    }
+    if (device_channel) {
+        object_unref(OBJECT(device_channel));
+    }
+    if (device_writer_fd >= 0) {
+        close(device_writer_fd);
+    }
+    if (material->owner) {
+        int material_post = qemu_crucible_fingerprint_material_capture_end_v2(
+            material, out->device_fd, out->device_material_length, status);
