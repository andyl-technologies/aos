diff --git a/hw/display/vga-fingerprint.h b/hw/display/vga-fingerprint.h
new file mode 100644
index 0000000000000000000000000000000000000000..8c648d586970b3650b7f60ecb0f7323adcfb2f62
--- /dev/null
+++ b/hw/display/vga-fingerprint.h
@@ -0,0 +1,151 @@
+/*
+ * Standard PCI VGA fingerprint projection internals
+ *
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef HW_DISPLAY_VGA_FINGERPRINT_H
+#define HW_DISPLAY_VGA_FINGERPRINT_H
+
+#include "vga_int.h"
+#include "vga_regs.h"
+#include "migration/qemu-file.h"
+#include "qapi/error.h"
+#include "qemu/host-utils.h"
+#include "qemu/units.h"
+
+#define PCI_VGA_FINGERPRINT_EDID_SIZE 384
+
+static inline bool vga_common_fingerprint_validate(
+    const VGACommonState *vga, Error **errp)
+{
+    uint8_t expected_sr_vbe[sizeof(vga->sr_vbe)] = { 0 };
+    uint8_t expected_gr[sizeof(vga->gr)];
+    uint8_t expected_cr[sizeof(vga->cr)];
+    bool vbe_enabled =
+        vga->vbe_regs[VBE_DISPI_INDEX_ENABLE] & VBE_DISPI_ENABLED;
+
+    if (vga->vram_size_mb < 1 || vga->vram_size_mb > 512 ||
+        !is_power_of_2(vga->vram_size_mb) ||
+        vga->vram_size != vga->vram_size_mb * MiB ||
+        vga->vbe_size == 0 || vga->vbe_size > vga->vram_size ||
+        !is_power_of_2(vga->vbe_size) ||
+        vga->vbe_size_mask != vga->vbe_size - 1 ||
+        vga->is_vbe_vmstate != 1 ||
+        (vga->ar_flip_flop != 0 && vga->ar_flip_flop != 1)) {
+        error_setg(errp, "standard VGA fingerprint has invalid geometry");
+        return false;
+    }
+
+    if (vga->dac_8bit) {
+        error_setg(errp,
+                   "standard VGA fingerprint does not admit 8-bit DAC state");
+        return false;
+    }
+
+    memcpy(expected_gr, vga->gr, sizeof(expected_gr));
+    memcpy(expected_cr, vga->cr, sizeof(expected_cr));
+    if (vbe_enabled) {
+        uint16_t height = vga->vbe_regs[VBE_DISPI_INDEX_YRES] - 1;
+        uint8_t shift_control;
+
+        expected_gr[VGA_GFX_MISC] =
+            (expected_gr[VGA_GFX_MISC] & ~0x0c) | 0x04 |
+            VGA_GR06_GRAPHICS_MODE;
+        expected_cr[VGA_CRTC_MODE] |= 3;
+        expected_cr[VGA_CRTC_OFFSET] = vga->vbe_line_offset >> 3;
+        expected_cr[VGA_CRTC_H_DISP] =
+            (vga->vbe_regs[VBE_DISPI_INDEX_XRES] >> 3) - 1;
+        expected_cr[VGA_CRTC_V_DISP_END] = height;
+        expected_cr[VGA_CRTC_OVERFLOW] =
+            (expected_cr[VGA_CRTC_OVERFLOW] & ~0x42) |
+            ((height >> 7) & 0x02) | ((height >> 3) & 0x40);
+        expected_cr[VGA_CRTC_LINE_COMPARE] = 0xff;
+        expected_cr[VGA_CRTC_OVERFLOW] |= 0x10;
+        expected_cr[VGA_CRTC_MAX_SCAN] |= 0x40;
+
+        if (vga->vbe_regs[VBE_DISPI_INDEX_BPP] == 4) {
+            shift_control = 0;
+            expected_sr_vbe[VGA_SEQ_CLOCK_MODE] &= ~8;
+        } else {
+            shift_control = 2;
+            expected_sr_vbe[VGA_SEQ_MEMORY_MODE] |= VGA_SR04_CHN_4M;
+            expected_sr_vbe[VGA_SEQ_PLANE_WRITE] |= VGA_SR02_ALL_PLANES;
+        }
+        expected_gr[VGA_GFX_MODE] =
+            (expected_gr[VGA_GFX_MODE] & ~0x60) | (shift_control << 5);
+        expected_cr[VGA_CRTC_MAX_SCAN] &= ~0x9f;
+    }
+    if (memcmp(vga->sr_vbe, expected_sr_vbe,
+               sizeof(expected_sr_vbe)) != 0 ||
+        memcmp(vga->gr, expected_gr, sizeof(expected_gr)) != 0 ||
+        memcmp(vga->cr, expected_cr, sizeof(expected_cr)) != 0) {
+        error_setg(errp,
+                   "standard VGA fingerprint has unrestorable VBE-derived "
+                   "state");
+        return false;
+    }
+
+    return true;
+}
+
+static inline void vga_common_fingerprint_put(QEMUFile *f,
+                                               const VGACommonState *vga)
+{
+    qemu_put_be32(f, vga->vram_size_mb);
+    qemu_put_be32(f, vga->vram_size);
+    qemu_put_be32(f, vga->vbe_size);
+    qemu_put_be32(f, vga->vbe_size_mask);
+    qemu_put_byte(f, vga->default_endian_fb);
+    qemu_put_byte(f, vga->global_vmstate);
+
+    qemu_put_be32(f, vga->latch);
+    qemu_put_byte(f, vga->sr_index);
+    qemu_put_buffer(f, vga->sr, 8);
+    qemu_put_byte(f, vga->gr_index);
+    qemu_put_buffer(f, vga->gr, 16);
+    qemu_put_byte(f, vga->ar_index);
+    qemu_put_buffer(f, vga->ar, sizeof(vga->ar));
+    qemu_put_be32(f, vga->ar_flip_flop);
+    qemu_put_byte(f, vga->cr_index);
+    qemu_put_buffer(f, vga->cr, sizeof(vga->cr));
+    qemu_put_byte(f, vga->msr);
+    qemu_put_byte(f, vga->fcr);
+    qemu_put_byte(f, vga->st00);
+    qemu_put_byte(f, vga->st01);
+    qemu_put_byte(f, vga->dac_state);
+    qemu_put_byte(f, vga->dac_sub_index);
+    qemu_put_byte(f, vga->dac_read_index);
+    qemu_put_byte(f, vga->dac_write_index);
+    qemu_put_buffer(f, vga->dac_cache, sizeof(vga->dac_cache));
+    qemu_put_buffer(f, vga->palette, sizeof(vga->palette));
+    qemu_put_be32(f, vga->bank_offset);
+    qemu_put_byte(f, vga->is_vbe_vmstate);
+    qemu_put_be16(f, vga->vbe_index);
+    for (size_t index = 0; index < VBE_DISPI_INDEX_NB; index++) {
+        qemu_put_be16(f, vga->vbe_regs[index]);
+    }
+    qemu_put_be32(f, vga->vbe_start_addr);
+    qemu_put_be32(f, vga->vbe_line_offset);
+    qemu_put_be32(f, vga->vbe_bank_mask);
+    qemu_put_byte(f, vga->big_endian_fb);
+}
+
+static inline bool pci_vga_state_fingerprint_validate(
+    const VGACommonState *vga, Error **errp)
+{
+    return vga_common_fingerprint_validate(vga, errp);
+}
+
+static inline void pci_vga_state_fingerprint_put(
+    QEMUFile *f, const VGACommonState *vga, uint32_t flags,
+    const uint8_t edid[PCI_VGA_FINGERPRINT_EDID_SIZE], bool edid_enabled)
+{
+    vga_common_fingerprint_put(f, vga);
+    qemu_put_be32(f, flags);
+    qemu_put_byte(f, edid_enabled);
+    if (edid_enabled) {
+        qemu_put_buffer(f, edid, PCI_VGA_FINGERPRINT_EDID_SIZE);
+    }
+}
+
+#endif
