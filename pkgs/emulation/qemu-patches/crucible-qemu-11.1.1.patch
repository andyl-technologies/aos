+static void cpu_timer_fingerprint_projection(QEMUFile *f,
+                                             const QEMUTimer *timer)
+{
+    bool present = timer != NULL;
+    bool pending = present && timer_pending(timer);
+
+    qemu_put_byte(f, present);
+    qemu_put_byte(f, pending);
+    if (pending) {
+        bool picosecond_clock = qemu_timer_tcg_ps_enabled() &&
+                                timer_is_virtual(timer);
+        __int128 expiry = picosecond_clock ?
+                          timer_expire_time_ps_wide(timer) :
+                          timer_expire_time_ns(timer);
+        unsigned __int128 bits = expiry;
+
+        qemu_put_byte(f, picosecond_clock);
+        qemu_put_be64(f, (uint64_t)(bits >> 64));
+        qemu_put_be64(f, (uint64_t)bits);
+    }
+}
