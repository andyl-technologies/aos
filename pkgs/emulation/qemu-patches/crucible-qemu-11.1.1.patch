+                  "Invalid parameter type for '%s', expected: %s",
+                  name ? name : "null", expected);
+    } else {
+        error_setg(errp, "Invalid parameter type for '%s', expected: %s",
+                   name ? name : "null", expected);
+    }
+    return false;
+}
