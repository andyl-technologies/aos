+int qemu_plugin_crucible_native_main_control_finish_v1(
+    QemuCrucibleNativeInvocationTicket *holder, QemuCrucibleMainControlBorrow *borrow)
+{
+#ifndef CONFIG_USER_ONLY
+    QemuCrucibleNativeInvocationRegistry *registry;
+    QemuCrucibleNativeInvocation *frame;
+    int status = qemu_plugin_crucible_native_main_control_current_v1(holder, true);
+
+    if (status) {
+        return status;
+    }
+    if (borrow) {
+        status = qemu_crucible_source_action_original_closed_v1(borrow);
+        if (status) {
+            return status;
+        }
+    }
+    registry = holder->registry;
+    frame = holder->frame;
+    qemu_mutex_lock(&registry->mutex);
+    if (frame->main_borrow != borrow) {
+        status = -ESTALE;
+    } else {
+        CPUState *remaining;
+
+        frame->main_borrow = NULL;
+        frame->use_references--;
+        remaining = frame_reclaim_locked(frame);
+        assert(!remaining);
+        *holder = (QemuCrucibleNativeInvocationTicket) { 0 };
+    }
+    qemu_mutex_unlock(&registry->mutex);
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
