+def check_control(arguments):
+    """Accept only a named assertion abort in a separately compiled control."""
+    parser = argparse.ArgumentParser(description=check_control.__doc__)
+    parser.add_argument('control', choices=CONTROL_CASES)
+    parser.add_argument('binary', type=Path)
+    parser.add_argument('--baseline', type=Path, required=True)
+    args = parser.parse_args(arguments)
+    scenario, assertion = CONTROL_CASES[args.control]
+    command = [str(args.binary.resolve()), '--causal-probe', scenario]
+    baseline_command = [str(args.baseline.resolve()), '--causal-probe', scenario]
+
+    try:
+        baseline = subprocess.run(baseline_command, capture_output=True,
+                                  text=True, timeout=5, check=False)
+        if baseline.returncode:
+            sys.stdout.write(baseline.stdout + baseline.stderr)
+            raise SystemExit('baseline scenario refused; no causal control established')
+        result = subprocess.run(command, capture_output=True, text=True,
+                                timeout=5, check=False)
+    except subprocess.TimeoutExpired as error:
+        raise SystemExit('control timed out; no causal refusal established') from error
+    output = result.stdout + result.stderr
+    # A compiler error, setup failure, unrelated abort or timeout is not a
+    # successful omission. The caller must compile each executable separately.
+    expected_assertion = f'assertion failed ({assertion}):'
+    if result.returncode != -signal.SIGABRT or expected_assertion not in output:
+        sys.stdout.write(output)
+        raise SystemExit(f'control did not reach its exact assertion: '
+                         f'{args.control}, status={result.returncode}')
+    print(json.dumps({'control': args.control, 'scenario': scenario,
+                      'baseline_returncode': baseline.returncode,
+                      'returncode': result.returncode,
+                      'assertion': assertion, 'classification': 'causal-abort',
+                      'baseline_command': baseline_command,
+                      'baseline_stdout': baseline.stdout,
+                      'baseline_stderr': baseline.stderr,
+                      'command': command, 'stdout': result.stdout,
+                      'stderr': result.stderr}))
+
