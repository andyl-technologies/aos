+int qemu_plugin_crucible_checkpoint_candidate_capture_begin_v1(
+    qemu_plugin_crucible_checkpoint_candidate_read_v1 *reader, uint32_t full,
+    qemu_plugin_crucible_checkpoint_candidate_capture_v1 **out,
+    struct qemu_plugin_crucible_ram_capture_v1 *inventory)
+{
+    uint64_t topology;
+    int status;
+
+    if (!out || *out || !inventory || full > 1) {
+        return -EINVAL;
+    }
+    status = qemu_crucible_checkpoint_candidate_read_identity_v1(reader, false);
+    if (!status) {
+        status = qemu_crucible_checkpoint_storage_current_v1();
+    }
+    if (!status) {
+        status = qemu_crucible_checkpoint_candidate_capture_boundary_v1(reader);
+    }
+    if (!status) {
+        status = qemu_crucible_checkpoint_candidate_read_topology_v1(reader, &topology);
+    }
+    if (status) {
+        return status;
+    }
+    if (capture_active || candidate_capture.active || !admission_regions ||
+        !rust_metadata_budget || !metadata_budget ||
+        topology != admission.topology_generation ||
+        topology != qatomic_read(&topology_generation) ||
+        capture_generation == UINT64_MAX) {
+        return -ESTALE;
+    }
+    status = region_inventory_ref(admission_regions, &capture_regions);
+    if (status) {
+        return status;
+    }
+    /* No dirty-log start, guessed container, fresh budget or raw token authorizes
+     * this claim. Missing logging forces a real full initial enumeration. */
+    capture_full = full || !(global_dirty_tracking & GLOBAL_DIRTY_CRUCIBLE_RAM);
+    capture_region_cursor = 0;
+    capture_page_cursor = 0;
+    capture_dirty_end = 0;
+    capture_dirty_generation = qatomic_read(&dirty_generation);
+    capture_topology_generation = topology;
+    capture_owner_token = 0;
+    capture_generation++;
+    candidate_capture = (struct QemuCrucibleCheckpointCandidateCaptureLoan) {
+        .reader = reader,
+        .process = getpid(),
+        .generation = capture_generation,
+        .topology = topology,
+        .dirty = capture_dirty_generation,
+        .active = true,
+        .issued = true,
+        .full = capture_full,
+        .fingerprint_observer =
+            qemu_crucible_checkpoint_candidate_read_identity_v1(reader, true) == 0,
+    };
+    qemu_thread_get_self(&candidate_capture.thread);
+    if (candidate_capture.fingerprint_observer) {
+        for (size_t index = 0; index < capture_regions->len; index++) {
+            CrucibleRamRegion *region = region_inventory_index(capture_regions, index);
+
+            region->fingerprint_capture_start = 0;
+            region->fingerprint_capture_end = 0;
+        }
+    }
+    capture_active = true;
+    *out = &candidate_capture;
+    *inventory = (struct qemu_plugin_crucible_ram_capture_v1) {
+        .schema = 1,
+        .region_count = capture_regions->len,
+        .topology_generation = topology,
+        .capture_generation = capture_generation,
+        .metadata_budget_bytes = rust_metadata_budget,
+    };
+    return 0;
+}
+
+int qemu_plugin_crucible_checkpoint_candidate_capture_region_v1(
+    qemu_plugin_crucible_checkpoint_candidate_capture_v1 *claim, uint32_t index,
+    struct qemu_plugin_crucible_ram_region_v1 *out)
+{
+    int status = candidate_capture_current(claim);
+
+    if (status || !out || index >= capture_regions->len) {
+        return status ? status : -EINVAL;
+    }
+    *out = ((CrucibleRamRegion *)region_inventory_index(capture_regions, index))->descriptor;
+    return 0;
+}
+
+int qemu_plugin_crucible_checkpoint_candidate_capture_next_v1(
+    qemu_plugin_crucible_checkpoint_candidate_capture_v1 *claim,
+    struct qemu_plugin_crucible_ram_page_v1 *out)
+{
+    int status = candidate_capture_current(claim);
+
+    if (status || !out) {
+        return status ? status : -EINVAL;
+    }
+    if (!claim->fingerprint_observer || claim->coordinate_pending) {
+        return -EBUSY;
+    }
+    while (capture_region_cursor < capture_regions->len) {
+        CrucibleRamRegion *region = region_inventory_index(capture_regions, capture_region_cursor);
+        uint64_t length = region->descriptor.logical_length;
+        uint64_t pages;
+
+        if (!length || length > (ram_addr_t)-1 - region->block->offset) {
+            return -EOVERFLOW;
+        }
+        pages = 1 + (length - 1) / RAM_PAGE_BYTES;
+
+        while (capture_page_cursor < pages) {
+            uint64_t page = capture_page_cursor;
+            uint64_t offset = page * RAM_PAGE_BYTES;
+
+            if (!capture_full && region->block->offset + offset >= capture_dirty_end) {
+                ram_addr_t start;
+
+                if (length > (ram_addr_t)-1 - region->block->offset) {
+                    return -EOVERFLOW;
+                }
+                status = qemu_crucible_ram_next_dirty_range(
+                    region->block->offset + offset,
+                    region->block->offset + length, &start, &capture_dirty_end);
+                if (status < 0) {
+                    return status;
+                }
+                if (status == 1) {
+                    break;
+                }
+                page = (start - region->block->offset) / RAM_PAGE_BYTES;
+                offset = page * RAM_PAGE_BYTES;
+            }
+            *out = (struct qemu_plugin_crucible_ram_page_v1) {
+                .region_index = capture_region_cursor,
+                .valid_length = MIN((uint64_t)RAM_PAGE_BYTES, length - offset),
+                .page_index = page,
+                .page_version = claim->dirty,
+            };
+            claim->pending_page = *out;
+            claim->coordinate_pending = true;
+            capture_page_cursor = page + 1;
+            return 0;
+        }
+        capture_region_cursor++;
+        capture_page_cursor = 0;
+        capture_dirty_end = 0;
+    }
+    return 1;
+}
+
+int qemu_plugin_crucible_checkpoint_candidate_capture_finish_v1(
+    qemu_plugin_crucible_checkpoint_candidate_capture_v1 **candidate,
+    uint32_t fingerprint)
+{
+    struct QemuCrucibleCheckpointCandidateCaptureLoan *claim;
+    int status;
+
+    if (!candidate || fingerprint > 1) {
+        return -EINVAL;
+    }
+    claim = *candidate;
+    status = candidate_capture_identity(claim);
+    if (status || !claim->issued) {
+        return status ? status : -EPERM;
+    }
+    if (fingerprint) {
+        status = candidate_capture_current(claim);
+        if (!status) {
+            status = qemu_crucible_checkpoint_candidate_read_identity_v1(
+                claim->reader, true);
+        }
+        if (status || !claim->fingerprint_observer || claim->coordinate_pending ||
+            capture_region_cursor != capture_regions->len) {
+            return status ? status : -EBUSY;
+        }
+        /* The issued handle moves into the actual outer callback holder. A
+         * scalar finish request cannot accept publication or acknowledge dirt. */
+        claim->publication_pending = true;
+        claim->issued = false;
+        *candidate = NULL;
+        return 0;
+    }
+    status = candidate_capture_close(claim);
+    if (!status) {
+        *candidate = NULL;
+    }
+    return status;
+}
+
+int qemu_plugin_crucible_checkpoint_candidate_capture_publication_observe_v1(
+    qemu_plugin_crucible_checkpoint_candidate_read_v1 *reader,
+    struct qemu_plugin_crucible_checkpoint_candidate_capture_status_v1 *out)
+{
+    int status = qemu_crucible_checkpoint_candidate_read_identity_v1(reader, false);
+
+    if (status || !out || candidate_capture.reader != reader) {
+        return status ? status : -ENOENT;
+    }
+    *out = (struct qemu_plugin_crucible_checkpoint_candidate_capture_status_v1) {
+        .schema_version = 1,
+        .struct_size = sizeof(*out),
+        .capture_generation = candidate_capture.generation,
+        .topology_generation = candidate_capture.topology,
+        .dirty_generation = candidate_capture.dirty,
+        .full = candidate_capture.full,
+        .claim_closed = candidate_capture.closed,
+        .publication_capture_generation =
+            candidate_fingerprint_deferred.publication_generation,
+        .publication_pending = candidate_capture.publication_pending,
+        .publication_accepted = candidate_fingerprint_deferred.reader_selector == reader,
+        .rearm_deferred = candidate_fingerprint_deferred.rearm_deferred,
+        .fingerprint_acknowledged =
+            candidate_fingerprint_deferred.reader_selector == reader &&
+            candidate_fingerprint_deferred.acknowledged,
+        .first_status = candidate_capture.first_status,
+        .post_status = candidate_capture.post_status,
+    };
+    return 0;
+}
+
+bool qemu_crucible_checkpoint_candidate_capture_busy_v1(
+    QemuCrucibleCheckpointCandidateReadLoan *reader)
+{
+    return candidate_capture.active && candidate_capture.reader == reader;
+}
+
+int qemu_crucible_checkpoint_candidate_capture_publication_v1(
+    QemuCrucibleCheckpointCandidateReadLoan *reader, uint32_t refresh,
+    int first_status, int post_status)
+{
+    struct QemuCrucibleCheckpointCandidateCaptureLoan *claim = &candidate_capture;
+    int status = qemu_crucible_checkpoint_candidate_capture_publication_current_v1(
+        reader, refresh, first_status, post_status);
+
+    if (status) {
+        return status;
+    }
+    if (!claim->active || claim->reader != reader) {
+        if (refresh && !first_status && !post_status) {
+            return -ENOKEY;
+        }
+        return 0;
+    }
+    status = candidate_capture_identity(claim);
+    if (status) {
+        return status;
+    }
+    if (first_status && !claim->first_status) {
+        claim->first_status = first_status;
+    }
+    if (post_status && !claim->post_status) {
+        claim->post_status = post_status;
+    }
+    if (!refresh || !claim->publication_pending || claim->issued) {
+        /* The module still holds its actual issued handle. Callback return
+         * cannot manufacture that handle's return or permit native reuse. */
+        return first_status ? first_status : post_status ? post_status : -EBUSY;
+    }
+    claim->publication_attempted = true;
+    if (claim->topology != qatomic_read(&topology_generation) ||
+        claim->dirty != qatomic_read(&dirty_generation)) {
+        status = -ESTALE;
+    } else {
+        status = first_status ? first_status : post_status;
+    }
+    if (status && !claim->first_status && !claim->post_status) {
+        claim->first_status = status;
+    }
+    {
+        CrucibleRamInventory *retained = NULL;
+        int close_status;
+
+        if (!status && !qemu_crucible_startup_source_fingerprint_retirement_idle_v1()) {
+            status = -EBUSY;
+        }
+        if (!status) {
+            status = region_inventory_ref(capture_regions, &retained);
+        }
+        if (status && !claim->first_status && !claim->post_status) {
+            claim->first_status = status;
+        }
+        close_status = candidate_capture_close(claim);
+        if (close_status && !claim->post_status) {
+            claim->post_status = close_status;
+        }
+        if (!status && !close_status) {
+            /* Actual callback0, Original post0 and physical claim-close0 accept
+             * the staged immutable view. Held page-state rearm stays deferred;
+             * both independent consumers keep every dirty obligation. */
+            CrucibleRamInventory *previous = candidate_fingerprint_deferred.regions;
+            int previous_first = candidate_fingerprint_deferred.first_status;
+            int previous_post = candidate_fingerprint_deferred.post_status;
+
+            /* A newer accepted incremental view included every still-live
+             * fingerprint bit; replacing coordinates retires no obligation. */
+            for (size_t index = 0; index < retained->len; index++) {
+                CrucibleRamRegion *region = region_inventory_index(retained, index);
+
+                region->fingerprint_deferred_start = region->fingerprint_capture_start;
+                region->fingerprint_deferred_end = region->fingerprint_capture_end;
+            }
+            candidate_fingerprint_deferred =
+                (struct QemuCrucibleFingerprintRetirementLoan) {
+                    .reader_selector = reader,
+                    .regions = retained,
+                    .process = getpid(),
+                    .publication_generation = claim->generation,
+                    .topology = claim->topology,
+                    .dirty = claim->dirty,
+                    .rearm_deferred = true,
+                    .first_status = previous_first,
+                    .post_status = previous_post,
+                };
+            qemu_thread_get_self(&candidate_fingerprint_deferred.thread);
+            retained = NULL;
+            if (previous) {
+                status = region_inventory_drop_preserving(&previous, status);
+            }
+        }
+        if (retained) {
+            status = region_inventory_drop_preserving(&retained, status);
+        }
+        return status ? status : close_status;
+    }
+}
+
+int qemu_crucible_checkpoint_candidate_capture_before_module_cleanup_v1(
+    QemuCrucibleCheckpointCandidateReadLoan *reader)
+{
+    struct QemuCrucibleCheckpointCandidateCaptureLoan *claim = &candidate_capture;
+    int status = qemu_crucible_checkpoint_candidate_read_identity_v1(reader, false);
+
+    if (status) {
+        return status;
+    }
+    if (!claim->active || claim->reader != reader) {
+        return 0;
+    }
+    status = candidate_capture_identity(claim);
+    if (status) {
+        return status;
+    }
+    if (claim->issued) {
+        /* This zero means callback admission only, never claim closure. The
+         * actual module's still-held pointer must perform finish(noACK) itself. */
+        return 0;
+    }
+    if (!claim->publication_pending || !claim->publication_attempted) {
+        return -EBUSY;
+    }
+    /* The actual outer callback already transferred this handle. Do not replay
+     * publication or Original checks; return only its retained inventory ref. */
+    return candidate_capture_close(claim);
+}
+
+int qemu_crucible_checkpoint_candidate_capture_reader_cleanup_v1(
+    QemuCrucibleCheckpointCandidateReadLoan *reader)
+{
+    struct QemuCrucibleCheckpointCandidateCaptureLoan *claim = &candidate_capture;
+
+    if (!claim->active || claim->reader != reader) {
+        return 0;
+    }
+    /* Only the actual outer callback owns this transferred handle. A still
+     * issued module/caller handle cannot be reclaimed by read-end guesses. */
+    if (claim->issued || !claim->publication_pending ||
+        !claim->publication_attempted) {
+        return -EBUSY;
+    }
+    return candidate_capture_close(claim);
+}
+
+void qemu_crucible_checkpoint_candidate_capture_reader_return_v1(
+    QemuCrucibleCheckpointCandidateReadLoan *reader)
+{
+    if (!candidate_capture.active && candidate_capture.reader == reader) {
+        candidate_capture.reader = NULL;
+    }
+    if (candidate_fingerprint_deferred.reader_selector == reader) {
+        /* Keep deferred dirty obligations and factual publication coordinates;
+         * only the expired reader selector is consumed at its actual end. */
+        candidate_fingerprint_deferred.reader_selector = NULL;
+    }
+}
+
+int qemu_plugin_crucible_ram_capture_read_page_v2(
+    uint64_t generation, uint64_t owner_token,
+    uint32_t region_index, uint64_t page_index,
+    struct qemu_plugin_crucible_ram_page_v1 *out, uint8_t *bytes, size_t capacity)
+{
+    CrucibleRamRegion *region;
+    uint64_t offset;
+    size_t valid;
+    int status;
+
+    if (!out || !bytes || capacity < RAM_PAGE_BYTES ||
+        !capture_valid(generation, owner_token) ||
+        region_index >= capture_regions->len || page_index > UINT64_MAX / RAM_PAGE_BYTES) {
+        return -ESTALE;
+    }
+    if (qemu_crucible_ram_diagnostic_failure()) {
+        memset(out, 0, sizeof(*out));
+        return qemu_crucible_ram_diagnostic_failure();
+    }
+    region = region_inventory_index(capture_regions, region_index);
+    offset = page_index * RAM_PAGE_BYTES;
+    if (offset >= region->descriptor.logical_length) {
+        return -ERANGE;
+    }
+    valid = MIN((uint64_t)RAM_PAGE_BYTES, region->descriptor.logical_length - offset);
+    status = operational_read((uintptr_t)region->block->host + offset, bytes, valid);
+    if (status != 0) {
+        return status;
+    }
+    memset(out, 0, sizeof(*out));
+    out->region_index = region_index;
+    out->valid_length = valid;
+    out->page_index = page_index;
+    out->page_version = capture_dirty_generation;
+    if (!capture_valid(generation, owner_token)) {
+        return -ESTALE;
+    }
+    if (!owner_token) {
+        fingerprint_capture_record(region, offset, valid);
+        if (logical_capture->active) {
+            status = logical_capture_progress_publish(out);
+            if (status) {
+                return status;
+            }
+        }
+    }
+    return 0;
+}
+
+int qemu_crucible_checkpoint_candidate_read_region_current_v1(
+    QemuCrucibleCheckpointCandidateReadLoan *loan,
+    uint64_t address, uint32_t valid)
+{
+    uint64_t topology;
+    int status = qemu_crucible_checkpoint_candidate_read_topology_v1(
+        loan, &topology);
+
+    if (status || !valid || valid > RAM_PAGE_BYTES || !admission_regions ||
+        !topology || topology != admission.topology_generation ||
+        topology != qatomic_read(&topology_generation)) {
+        return status ? status : -ESTALE;
+    }
+    for (size_t index = 0; index < admission_regions->len; index++) {
+        const CrucibleRamRegion *region = region_inventory_index(admission_regions,
+                                                          index);
+        uint64_t start = (uintptr_t)region->block->host;
+        uint64_t offset;
+
+        if (address < start) {
+            continue;
+        }
+        offset = address - start;
+        if (offset >= region->descriptor.logical_length) {
+            continue;
+        }
+        if (offset % RAM_PAGE_BYTES ||
+            valid != MIN((uint64_t)RAM_PAGE_BYTES,
+                          region->descriptor.logical_length - offset)) {
+            return -ERANGE;
+        }
+        /* A real retained admission RAMBlock reference binds this exact page,
+         * not a native pointer or topology supplied by the reader callback.
+         */
+        return 0;
+    }
+    return -ENOENT;
+}
+
+int qemu_plugin_crucible_checkpoint_candidate_capture_page_v1(
+    qemu_plugin_crucible_checkpoint_candidate_read_v1 *loan,
+    uint64_t generation, uint32_t region_index, uint64_t page_index,
+    struct qemu_plugin_crucible_ram_page_v1 *out,
+    uint8_t *bytes, size_t capacity)
+{
+    struct qemu_plugin_crucible_ram_page_v1 observed;
+    CrucibleRamRegion *region;
+    uint64_t offset;
+    uint32_t valid;
+    int status = qemu_crucible_checkpoint_candidate_read_identity_v1(loan, false);
+
+    if (!status) {
+        status = candidate_capture_current(&candidate_capture);
+    }
+    if (status || !out || !bytes || capacity < RAM_PAGE_BYTES ||
+        candidate_capture.reader != loan ||
+        candidate_capture.generation != generation ||
+        region_index >= capture_regions->len || page_index > UINT64_MAX / RAM_PAGE_BYTES) {
+        return status ? status : -ESTALE;
+    }
+    if (candidate_capture.fingerprint_observer &&
+        (!candidate_capture.coordinate_pending ||
+         candidate_capture.pending_page.region_index != region_index ||
+         candidate_capture.pending_page.page_index != page_index)) {
+        return -EPERM;
+    }
+    region = region_inventory_index(capture_regions, region_index);
+    offset = page_index * RAM_PAGE_BYTES;
+    if (offset >= region->descriptor.logical_length) {
+        return -ERANGE;
+    }
+    valid = MIN((uint64_t)RAM_PAGE_BYTES,
+                region->descriptor.logical_length - offset);
+    status = qemu_crucible_checkpoint_candidate_read_page_v1(
+        loan, (uintptr_t)region->block->host + offset, bytes, valid);
+    if (status) {
+        return status;
+    }
+    status = candidate_capture_current(&candidate_capture);
+    if (status || candidate_capture.reader != loan ||
+        candidate_capture.generation != generation) {
+        return status ? status : -ESTALE;
+    }
+    observed = (struct qemu_plugin_crucible_ram_page_v1) {
+        .region_index = region_index,
+        .valid_length = valid,
+        .page_index = page_index,
+        .page_version = capture_dirty_generation,
+    };
+    if (candidate_capture.fingerprint_observer) {
+        /* Record only pages successfully read and independently posted. Empty
+         * intervals are distinct from a first page whose byte offset is zero. */
+        fingerprint_capture_record(region, offset, valid);
+        candidate_capture.coordinate_pending = false;
+    }
+    *out = observed;
+    return 0;
+}
+
+int qemu_plugin_crucible_ram_capture_region_v2(
+    uint64_t generation, uint64_t owner_token, uint32_t index,
+    struct qemu_plugin_crucible_ram_region_v1 *out)
+{
+    CrucibleRamRegion *region;
+
+    if (!out || !capture_valid(generation, owner_token) || index >= capture_regions->len) {
+        return -ESTALE;
+    }
+    if (qemu_crucible_ram_diagnostic_failure()) {
+        memset(out, 0, sizeof(*out));
+        return qemu_crucible_ram_diagnostic_failure();
+    }
+    region = region_inventory_index(capture_regions, index);
+    *out = region->descriptor;
+    return 0;
+}
+
+/* Select coordinates from the retained inventory only. The caller owns all
+ * admission, operational reads, version revalidation and physical retirement. */
+static int capture_next_page_coordinate(
+    struct qemu_plugin_crucible_ram_page_v1 *out,
+    CrucibleRamRegion **selected, uint64_t *selected_offset)
+{
+    while (capture_region_cursor < capture_regions->len) {
+        CrucibleRamRegion *region = region_inventory_index(capture_regions, capture_region_cursor);
+        uint64_t length = region->descriptor.logical_length;
+        uint64_t page_count = 1 + (length - 1) / RAM_PAGE_BYTES;
+
+        while (capture_page_cursor < page_count) {
+            uint64_t page_index = capture_page_cursor;
+            uint64_t offset = page_index * RAM_PAGE_BYTES;
+            size_t valid;
+
+            if (!capture_full) {
+                ram_addr_t dirty_start;
+                int status;
+
+                if (length > (ram_addr_t)-1 - region->block->offset) {
+                    return -EOVERFLOW;
+                }
+                if (region->block->offset + offset >= capture_dirty_end) {
+                    status = qemu_crucible_ram_next_dirty_range(
+                        region->block->offset + offset,
+                        region->block->offset + length,
+                        &dirty_start, &capture_dirty_end);
+                    if (status < 0) {
+                        return status;
+                    }
+                    if (status == 1) {
+                        break;
+                    }
+                    page_index = (dirty_start - region->block->offset) / RAM_PAGE_BYTES;
+                    offset = page_index * RAM_PAGE_BYTES;
+                }
+            }
+            capture_page_cursor = page_index + 1;
+            valid = MIN((uint64_t)RAM_PAGE_BYTES, length - offset);
+            memset(out, 0, sizeof(*out));
+            out->region_index = capture_region_cursor;
+            out->valid_length = valid;
+            out->page_index = page_index;
+            out->page_version = capture_dirty_generation;
+            *selected = region;
+            *selected_offset = offset;
+            return 0;
+        }
+        capture_region_cursor++;
+        capture_page_cursor = 0;
+        capture_dirty_end = 0;
+    }
+    return 1;
+}
+
+int qemu_plugin_crucible_ram_capture_next_page_v2(
+    uint64_t generation, uint64_t owner_token, uint64_t *cursor,
+    struct qemu_plugin_crucible_ram_page_v1 *out,
+    uint8_t *bytes, size_t capacity)
+{
+    CrucibleRamRegion *region;
+    uint64_t offset;
+    size_t valid;
+    int status;
+
+    if (!cursor || !out || !bytes || capacity < RAM_PAGE_BYTES ||
+        !capture_valid(generation, owner_token)) {
+        return -ESTALE;
+    }
+    if (qemu_crucible_ram_diagnostic_failure()) {
+        memset(out, 0, sizeof(*out));
+        return qemu_crucible_ram_diagnostic_failure();
+    }
+    if (owner_token) {
+        if (capacity != sizeof(struct qemu_plugin_crucible_ram_root_scratch_v2)) {
+            return -EINVAL;
+        }
+        if (qatomic_load_acquire(&root_reader_registration.state) != ROOT_READERS_READY) {
+            return -ENOSYS;
+        }
+    }
+    status = capture_next_page_coordinate(out, &region, &offset);
+    if (status) {
+        return status;
+    }
+    valid = out->valid_length;
+    /* Operational read: no guest memory opportunity/controller hook. */
+    if (owner_token) {
+        /* The diagnostic owns this exact private page and discards it
+         * on failure. Ordinary token-zero outputs remain staged. */
+        status = root_reader_registration.reader(
+            (uintptr_t)region->block->host + offset,
+            (struct qemu_plugin_crucible_ram_root_scratch_v2 *)bytes,
+            valid, NULL);
+    } else {
+        status = operational_read(
+            (uintptr_t)region->block->host + offset, bytes, valid);
+    }
+    if (status != 0) {
+        return status;
+    }
+    if (!capture_valid(generation, owner_token)) {
+        return -ESTALE;
+    }
+    if (!owner_token) {
+        fingerprint_capture_record(region, offset, valid);
+        if (logical_capture->active) {
+            status = logical_capture_progress_publish(out);
+            if (status) {
+                return status;
+            }
+        }
+    }
+    *cursor += 1;
+    return 0;
+}
+
+static int fingerprint_retirement_identity(
+    qemu_plugin_id_t id, struct QemuCrucibleFingerprintRetirementLoan *loan)
+{
+    if (loan != &ordinary_fingerprint || !loan->regions || !loan->invoking ||
+        loan->process != getpid() || !qemu_thread_is_self(&loan->thread) ||
+        !qemu_crucible_startup_source_fingerprint_retirement_current_v1(id, loan)) {
+        return -EPERM;
+    }
+    return 0;
+}
+
+/* An old accepted publication names retained obligations, not today's cache
+ * or dirty epoch. Current successful reads fold those intervals conservatively. */
+static void fingerprint_retirement_range(uint32_t index, uint64_t *start, uint64_t *end)
+{
+    const CrucibleRamRegion *retained = region_inventory_index(ordinary_fingerprint.regions, index);
+    uint64_t old_start = 0, old_end = 0;
+    uint64_t current_start = 0, current_end = 0;
+
+    if (candidate_fingerprint_deferred.rearm_deferred) {
+        old_start = retained->fingerprint_deferred_start;
+        old_end = retained->fingerprint_deferred_end;
+    }
+    if (logical_physical_debt.pending) {
+        uint64_t debt_end = retained->fingerprint_physical_end;
+
+        if (debt_end) {
+            old_start = old_end ? MIN(old_start, retained->fingerprint_physical_start) :
+                retained->fingerprint_physical_start;
+            old_end = MAX(old_end, debt_end);
+        }
+    }
+    if (capture_active && !candidate_capture.active &&
+        index < capture_regions->len) {
+        const CrucibleRamRegion *current = region_inventory_index(capture_regions, index);
+
+        current_start = current->fingerprint_capture_start;
+        current_end = current->fingerprint_capture_end;
+    }
+    *start = old_end && current_end ? MIN(old_start, current_start) :
+        old_end ? old_start : current_start;
+    *end = MAX(old_end, current_end);
+}
