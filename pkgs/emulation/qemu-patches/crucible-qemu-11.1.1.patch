+int qemu_plugin_crucible_ram_control_receive_descriptor_free_v1(
+    qemu_plugin_id_t id, qemu_plugin_crucible_ram_control_actor_v1 *actor,
+    qemu_plugin_crucible_ram_control_receive_v1 *receipt)
+{
+#ifdef CONFIG_LINUX
+    int status = qemu_crucible_ram_control_actor_current(actor, id);
+    int post;
+
+    if (status) {
+        return status;
+    }
+    status = pthread_mutex_trylock(&actor->dispatch_mutex);
+    if (status) {
+        return status == EBUSY ? -EAGAIN : -status;
+    }
+    if (receipt != &actor->receipt || !receipt->active || receipt->moved ||
+        receipt->uncertain || !actor->record_in_flight ||
+        !receipt->frame_extent || receipt->frame_bytes != receipt->frame_extent ||
+        !receipt->record.acquired || !receipt->record.held ||
+        receipt->record.callback_active || receipt->record.end_attempted ||
+        actor->first_status || actor->post_status) {
+        status = -EPERM;
+    } else if (receipt->alias_count || receipt->first_alias) {
+        status = -EPROTO;
+    } else {
+        status = 0;
+    }
+    post = qemu_crucible_ram_control_actor_contract_current(actor);
+    if (post) {
+        receipt = &actor->receipt;
+        receipt->uncertain = true;
+        ram_control_failure(actor, post, true);
+        status = status ? status : post;
+    }
+    {
+        int unlock = pthread_mutex_unlock(&actor->dispatch_mutex);
+
+        if (unlock) {
+            ram_control_failure(actor, -unlock, true);
+            status = status ? status : -unlock;
+        }
+    }
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
