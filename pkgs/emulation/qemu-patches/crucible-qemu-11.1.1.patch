+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Bounded advisory stop diagnostics; no field grants native ownership. */
+#ifndef CRUCIBLE_STOP_CONTEXT_H
+#define CRUCIBLE_STOP_CONTEXT_H
+
+typedef enum CrucibleStopContextPhase {
+    CRUCIBLE_STOP_ASYNC_ADMITTED,
+    CRUCIBLE_STOP_CONTROL_ADMITTED,
+    CRUCIBLE_STOP_PUBLISHED,
+    CRUCIBLE_STOP_REARM_NO_CPU,
+    CRUCIBLE_STOP_REARM_SHUTDOWN,
+    CRUCIBLE_STOP_REARM_ADVANCE,
+    CRUCIBLE_STOP_REARM_NO_OWNER,
+    CRUCIBLE_STOP_READER_DRAINED,
+    CRUCIBLE_STOP_READER_EOF,
+    CRUCIBLE_STOP_READER_ERROR,
+    CRUCIBLE_STOP_CONTEXT_PHASE_COUNT,
+} CrucibleStopContextPhase;
+
+typedef struct CrucibleStopContext {
+    uint64_t generation, request, ack, complete;
+    unsigned int state;
+    char runstate[12];
+    int flush, fd;
+    char shutdown[12];
+    bool advance;
+    /* PC and instruction-budget fields are absent without original ownership. */
+    char cpu[192];
+} CrucibleStopContext;
+
+static const char *const crucible_stop_context_phases[] = {
+    "async-admitted", "control-admitted", "stopped", "rearm-no-cpu",
+    "rearm-shutdown", "rearm-advance", "rearm-no-owner", "reader-drained",
+    "reader-eof", "reader-error",
+};
+
+static struct {
+    uint64_t generation, request;
+    bool emitted;
+} crucible_stop_context_seen[CRUCIBLE_STOP_CONTEXT_PHASE_COUNT];
+static pid_t crucible_stop_context_pid;
+
+/* Fixed phase caches retain late generations without an exhausted global cap.
+ * One phase emits at most once per advancing stop/request epoch under BQL;
+ * concurrent advisory claims can emit bounded duplicates. Fork resets only
+ * this diagnostic cache. The original retained stream has its own byte cap.
+ */
+static void crucible_stop_context_emit(CrucibleStopContextPhase phase,
+                                       const CrucibleStopContext *context)
+{
+    uint64_t previous;
+    pid_t pid = getpid();
+    bool emit;
+    char row[512];
+    int length, saved_errno = errno;
+
+    if (qatomic_read(&crucible_stop_context_pid) != pid) {
+        for (unsigned int index = 0;
+             index < CRUCIBLE_STOP_CONTEXT_PHASE_COUNT; index++) {
+            qatomic_set(&crucible_stop_context_seen[index].generation, 0);
+            qatomic_set(&crucible_stop_context_seen[index].request, 0);
+            qatomic_set(&crucible_stop_context_seen[index].emitted, false);
+        }
+        qatomic_set(&crucible_stop_context_pid, pid);
+    }
+    emit = !qatomic_xchg(&crucible_stop_context_seen[phase].emitted, true);
+    previous = qatomic_read(&crucible_stop_context_seen[phase].generation);
+    if (context->generation > previous &&
+        qatomic_cmpxchg(&crucible_stop_context_seen[phase].generation,
+                       previous, context->generation) == previous) {
+        emit = true;
+    }
+    previous = qatomic_read(&crucible_stop_context_seen[phase].request);
+    if (context->request > previous &&
