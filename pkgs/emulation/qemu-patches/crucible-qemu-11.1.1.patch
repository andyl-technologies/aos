+static void test_rr_wake_concurrent_producers_serialize_rearm(void)
+{
+    unsigned int state = RR_TCG_EXEC_ACTIVE_WAKE_PENDING;
+    unsigned int first_claim = UINT_MAX;
+    unsigned int second_claim = UINT_MAX;
+    uint64_t consumed_generation = 0;
+    uint64_t publish_generation = 1;
+    RRCrucibleSimWakeSnapshot snapshot = { 0 };
+
+    g_assert_true(rr_crucible_sim_wake_try_claim(&state, &first_claim));
+    g_assert_false(rr_crucible_sim_wake_try_claim(&state, &second_claim));
+    g_assert_false(rr_crucible_sim_wake_consume_snapshot(
+        &state, &publish_generation, consumed_generation, &snapshot));
+
+    rr_crucible_sim_wake_publish(
+        &state, first_claim, &publish_generation);
+    g_assert_true(rr_crucible_sim_wake_try_claim(&state, &second_claim));
+    rr_crucible_sim_wake_publish(
+        &state, second_claim, &publish_generation);
+    g_assert_true(rr_crucible_sim_wake_consume_snapshot(
+        &state, &publish_generation, consumed_generation, &snapshot));
+    g_assert_cmpint(rr_crucible_sim_wake_try_collapse(
+                        &state, &publish_generation, &consumed_generation,
+                        &snapshot), ==,
+                    RR_TCG_WAKE_CONSUME_PENDING);
+    g_assert_cmpuint(consumed_generation, ==, 3);
+}
