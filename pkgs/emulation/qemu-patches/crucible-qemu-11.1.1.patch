+static int command_receive_publisher_corroboration(
+    QemuCrucibleCommandReceiveOwner *owner, const QemuCrucibleBoundaryActionRecord *current)
+{
+    const QemuCrucibleActionBinding *binding = &owner->publisher.binding;
+
+    /* These equalities bind two observations obtained from the actual
+     * installed transport and retained Source lender. They issue no Original;
+     * the separate publisher membership constructor must retain that loan. */
+    if (!owner->progress.request_received) {
+        return 0;
+    }
+    if (!owner->publisher.present || !current->present ||
+        binding->publisher_birth_sequence != current->binding.publisher_birth_sequence ||
+        binding->request_token != current->binding.request_token ||
+        binding->command_frontier != current->binding.command_frontier ||
+        binding->capture_generation != current->binding.capture_generation ||
+        owner->facts.control_sequence > UINT32_MAX ||
+        owner->facts.sample_generation > UINT32_MAX ||
+        owner->facts.control_sequence != binding->request_token ||
+        owner->facts.command_producer_ordinal != binding->command_frontier ||
+        owner->facts.sample_generation != binding->capture_generation ||
+        binding->account_incarnation != owner->member->account_generation ||
+        binding->process_incarnation != owner->member->process_generation ||
+        memcmp(binding->source_reservation, startup_source.standing.initial.source_reservation, 32)) {
+        return -ESTALE;
+    }
+    return standing_action_snapshot_validate(&owner->publisher, current,
+                                              startup_source.standing.sequence);
+}
