+    qemu_put_buffer(f, (const uint8_t *)mount_tag, mount_tag_length);
+    qemu_put_be16(f, fsdev_id_length);
+    qemu_put_buffer(f, (const uint8_t *)fsdev_id, fsdev_id_length);
+    qemu_put_be32(f, v->config_size);
+    qemu_put_be32(f, v->next_crucible_9p_request_id);
+    qemu_put_byte(f, v->crucible_9p_burst_active);
