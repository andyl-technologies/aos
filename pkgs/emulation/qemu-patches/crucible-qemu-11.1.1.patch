diff --git a/include/qemu/crucible-device-workspace.h b/include/qemu/crucible-device-workspace.h
new file mode 100644
index 0000000000000000000000000000000000000000..ae015acf95d98a9b3b88541600b9b4fe16e84c0e
--- /dev/null
+++ b/include/qemu/crucible-device-workspace.h
@@ -0,0 +1,141 @@
+/*
+ * Crucible fixed workspace wire evidence and early child status syntax
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef QEMU_CRUCIBLE_DEVICE_WORKSPACE_H
+#define QEMU_CRUCIBLE_DEVICE_WORKSPACE_H
+
+#include "plugins/qemu-plugin.h"
+
+#define QEMU_CRUCIBLE_DEVICE_WORKSPACE_WIRE_BYTES 128U
+#define QEMU_CRUCIBLE_DEVICE_WORKSPACE_SCHEMA 1U
+#define QEMU_CRUCIBLE_DEVICE_WORKSPACE_INITIAL 1U
+#define QEMU_CRUCIBLE_DEVICE_WORKSPACE_CHILD 2U
+#define QEMU_CRUCIBLE_DEVICE_WORKSPACE_BYTES UINT64_C(65536)
+
+#define QEMU_CRUCIBLE_ORIGINAL_STARTUP_WIRE_BYTES 128U
+#define QEMU_CRUCIBLE_ORIGINAL_STARTUP_SCHEMA 2U
+#define QEMU_CRUCIBLE_ORIGINAL_STARTUP_FLAGS 1U
+
+#define QEMU_CRUCIBLE_WORKSPACE_SETUP_SCHEMA 3U
+#define QEMU_CRUCIBLE_WORKSPACE_SETUP_HEADER_BYTES 36U
+#define QEMU_CRUCIBLE_WORKSPACE_SETUP_APP_RANDOM_MAX 4194304U
+#define QEMU_CRUCIBLE_WORKSPACE_SETUP_SELECTABLE_MAX 33554432U
+#define QEMU_CRUCIBLE_WORKSPACE_SETUP_TOTAL_MAX 37748764U
+
+/*
+ * Decoded public scalars are evidence, never an issued or admitted owner.
+ * No native layout of this type is serialized. Charge and source-proof values
+ * cannot authorize allocations without the separate authenticated issuer.
+ */
+typedef struct QemuCrucibleDeviceWorkspaceWireRecord {
+    uint32_t schema_version;
+    uint32_t scope;
+    uint8_t source_proof_digest[32];
+    uint64_t original_total_bytes;
+    uint64_t metadata_charge_bytes;
+    uint64_t resident_charge_bytes;
+    uint64_t process_generation;
+    uint64_t account_generation;
+    uint64_t workspace_generation;
+    uint64_t workspace_device;
+    uint64_t workspace_inode;
+    uint32_t native_fd_peak;
+    uint32_t native_vma_peak;
+    uint64_t workspace_length;
+} QemuCrucibleDeviceWorkspaceWireRecord;
+
+/* Original-start scalars do not create a guard, event borrow or deadline. */
+typedef struct QemuCrucibleOriginalStartupWireRecord {
+    uint32_t schema_version;
+    uint32_t record_bytes;
+    uint8_t cap_id[32];
+    uint64_t operation_id;
+    uint64_t original_start_ns;
+    uint64_t absolute_end_ns;
+    uint64_t poll_ns;
+    uint64_t process_generation;
+    uint64_t cancellation_device;
+    uint64_t cancellation_inode;
+    int32_t cancellation_descriptor;
+    uint32_t flags;
+    uint64_t cancellation_event_id;
+    uint64_t original_total_bytes;
+} QemuCrucibleOriginalStartupWireRecord;
+
+/* Checked sections remain offsets into the caller's unchanged wire buffer. */
+typedef struct QemuCrucibleDeviceWorkspaceSetupView {
+    uint32_t total_bytes;
+    uint32_t app_random_offset;
+    uint32_t app_random_bytes;
+    uint32_t selectable_offset;
+    uint32_t selectable_bytes;
+    uint32_t workspace_offset;
+    uint32_t workspace_bytes;
+    QemuCrucibleDeviceWorkspaceWireRecord workspace;
+    uint32_t startup_offset;
+    uint32_t startup_bytes;
+    QemuCrucibleOriginalStartupWireRecord startup;
+} QemuCrucibleDeviceWorkspaceSetupView;
+
+/*
+ * Decode CRUCSUP3/header36 with optional workspace and original-start records.
+ * Other sections are bounded opaque bytes; contents and issuer are not
+ * authenticated. Absent records have zero fields. Refusal leaves view
+ * untouched.
+ * Both present records must have equal process_generation and original TOTAL
+ * evidence.
+ * Output storage must not overlap the caller-owned wire buffer.
+ */
+int qemu_crucible_device_workspace_setup_decode(
+    const uint8_t *wire, size_t length,
+    QemuCrucibleDeviceWorkspaceSetupView *view);
+
+/*
+ * Read fixed setup evidence from a borrowed immutable Linux sealed descriptor.
+ * Read only header36 and optional records through checked pread offsets, using
+ * fixed scratch; the opaque variable body is never allocated or read here.
+ * Require WRITE, SHRINK, GROW and SEAL seals and stable file identity/size.
+ * Refusal leaves view untouched, including interrupted reads or premature EOF.
+ * The caller keeps fd open and unreused through the call; this function neither
+ * duplicates/closes it nor changes its file position. No issuer, operation,
+ * event ownership or metadata grant follows from success. Other hosts refuse
+ * with ENOTSUP. This reader does not replace opaque-section validation.
+ */
+int qemu_crucible_device_workspace_setup_read_fd(
+    int fd, QemuCrucibleDeviceWorkspaceSetupView *view);
+
+/*
+ * Decode one exact 128-byte big-endian CRUCWSP1 record. Refusal leaves output
+ * untouched. Output storage must not overlap wire. Success verifies syntax
+ * only; it does not authenticate the issuer or compiled source proof, reserve
+ * resources, or change any claim state.
+ */
+int qemu_crucible_device_workspace_decode(
+    const uint8_t *wire, size_t length,
+    QemuCrucibleDeviceWorkspaceWireRecord *record);
+
+/*
+ * Decode exact big-endian CRUCSTP1/schema2 syntax, including nonzero original
+ * TOTAL evidence. Schema1 refuses. Refusal leaves output untouched.
+ * Output storage must not overlap wire. Scalars identify original-start
+ * evidence only: no clock sample, cancellation action, FD ownership or guard
+ * is created. Any later authenticated check must retain the original event
+ * and original CLOCK_MONOTONIC end, rather than use a guest clock.
+ */
+int qemu_crucible_original_startup_decode(
+    const uint8_t *wire, size_t length,
+    QemuCrucibleOriginalStartupWireRecord *record);
+
+/*
+ * Match only DISARM4 syntax and its four prepared generation values. This
+ * does not authenticate a child, prove physical alias closure, or admit a
+ * workspace. Ordinary readiness predicates must not accept this shape.
+ */
+bool qemu_crucible_device_workspace_disarm_status_matches(
+    const struct qemu_plugin_crucible_hot_fork_child_plan *plan,
+    const struct qemu_plugin_crucible_hot_fork_child_status *status);
+
+#endif /* QEMU_CRUCIBLE_DEVICE_WORKSPACE_H */
