+static void test_hot_fork_source_graph_repeated_children(void)
+{
+    HotForkSourceSetFixture fixture;
+    QemuBlockHotForkSourceSet *sources;
+    QemuBlockHotForkSourceSetInventory inventory;
+    QemuBlockHotForkGraphReceipt graph = { 0 };
+    QemuBlockHotForkChildFile files[2];
+    char paths[2][80];
+    size_t index;
+    unsigned iteration;
+
+    test_hot_fork_source_set_setup(&fixture, false);
+    for (index = 0; index < G_N_ELEMENTS(files); index++) {
+        g_snprintf(paths[index], sizeof(paths[index]),
+                    "/tmp/qemu-hot-fork-repeated-%zu-XXXXXX", index);
+        files[index] = (QemuBlockHotForkChildFile) {
+            .node = fixture.roots[index].root->file->bs,
+            .descriptor = mkstemp(paths[index]),
+        };
+        g_assert_cmpint(files[index].descriptor, >=, 0);
+    }
+    sources = qemu_block_hot_fork_source_set_new(
+        fixture.roots, G_N_ELEMENTS(fixture.roots), &error_abort);
+    g_assert_true(qemu_block_hot_fork_source_set_restored_current(
+        sources, &error_abort));
+    g_assert_true(qemu_block_hot_fork_source_set_freeze(sources, &error_abort));
+    g_assert_false(qemu_block_hot_fork_source_set_restored_current(sources, NULL));
+    g_assert_true(qemu_aio_hot_fork_prepare_thread_pools(&error_abort));
+
+    for (iteration = 0; iteration < 3; iteration++) {
+        QemuBlockHotForkChildFiles *plan;
+        pid_t child;
+        int status;
+
+        g_assert_true(qemu_block_hot_fork_source_set_graph_receipt(
+            sources, 64, 16 * HOT_FORK_SNAPSHOT_SIZE, &graph, &error_abort));
+        g_assert_cmpuint(graph.count, ==, 6);
+        qemu_block_hot_fork_graph_receipt_destroy(&graph);
+        for (index = 0; index < G_N_ELEMENTS(files); index++) {
+            g_assert_cmpint(ftruncate(files[index].descriptor, 0), ==, 0);
+        }
+        plan = qemu_block_hot_fork_child_files_prepare(
+            sources, files, G_N_ELEMENTS(files),
+            16 * HOT_FORK_SNAPSHOT_SIZE, &error_abort);
+        g_assert_nonnull(plan);
+        child = fork();
+        g_assert_cmpint(child, >=, 0);
+        if (child == 0) {
+            test_hot_fork_child_alarm(15);
+            g_assert_false(qemu_block_hot_fork_source_set_restored_current(
+                sources, NULL));
+            g_assert_null(qemu_block_hot_fork_source_set_new(
+                fixture.roots, G_N_ELEMENTS(fixture.roots), NULL));
+            g_assert_true(qemu_block_hot_fork_child_files_install(
+                plan, &error_abort));
+            {
+                QemuBlockHotForkSourceSet *descendant_sources;
+                QemuBlockHotForkGraphReceipt descendant_graph = { 0 };
+                BdrvCrucibleHotForkFileState adopted =
+                    test_hot_fork_file_state(fixture.roots[0].root);
+
+                descendant_sources = qemu_block_hot_fork_source_set_new(
+                    fixture.roots, G_N_ELEMENTS(fixture.roots), &error_abort);
+                g_assert_false(qemu_block_hot_fork_source_set_has_graph_receipt(
+                    descendant_sources));
+                g_assert_true(qemu_block_hot_fork_source_set_freeze(
+                    descendant_sources, &error_abort));
+                g_assert_true(qemu_block_hot_fork_source_set_graph_receipt(
+                    descendant_sources, 64, 16 * HOT_FORK_SNAPSHOT_SIZE,
+                    &descendant_graph, &error_abort));
+                g_assert_cmpuint(descendant_graph.members[1].file_device,
+                                  ==, adopted.device);
+                g_assert_cmpuint(descendant_graph.members[1].file_inode,
+                                  ==, adopted.inode);
+                g_assert_cmpstr(descendant_graph.members[1].file_path,
+                                 ==, paths[0]);
+                qemu_block_hot_fork_graph_receipt_destroy(&descendant_graph);
+                g_assert_true(qemu_block_hot_fork_source_set_restore(
+                    descendant_sources, &error_abort));
+                g_assert_true(qemu_block_hot_fork_source_set_free(
+                    descendant_sources, &error_abort));
+            }
+            _exit(0);
+        }
+        g_assert_cmpint(waitpid(child, &status, 0), ==, child);
+        g_assert_true(WIFEXITED(status));
+        g_assert_cmpint(WEXITSTATUS(status), ==, 0);
+        g_assert_true(qemu_block_hot_fork_child_files_free(plan, &error_abort));
+        g_assert_true(qemu_block_hot_fork_source_set_query(
+            sources, &inventory, &error_abort));
+        g_assert_true(inventory.frozen);
+        g_assert_true(qemu_block_hot_fork_source_set_has_graph_receipt(sources));
+    }
+
+    g_assert_true(qemu_block_hot_fork_source_set_restore(sources, &error_abort));
+    g_assert_true(qemu_block_hot_fork_source_set_restored_current(
+        sources, &error_abort));
+    g_assert_true(qemu_block_hot_fork_source_set_free(sources, &error_abort));
+    sources = qemu_block_hot_fork_source_set_new(
+        fixture.roots, G_N_ELEMENTS(fixture.roots), &error_abort);
+    g_assert_false(qemu_block_hot_fork_source_set_has_graph_receipt(sources));
+    g_assert_true(qemu_block_hot_fork_source_set_freeze(sources, &error_abort));
+    g_assert_true(qemu_block_hot_fork_source_set_graph_receipt(
+        sources, 64, 16 * HOT_FORK_SNAPSHOT_SIZE, &graph, &error_abort));
+    qemu_block_hot_fork_graph_receipt_destroy(&graph);
+    g_assert_true(qemu_block_hot_fork_source_set_restore(sources, &error_abort));
+    g_assert_true(qemu_block_hot_fork_source_set_free(sources, &error_abort));
+    for (index = 0; index < G_N_ELEMENTS(files); index++) {
+        close(files[index].descriptor);
+        unlink(paths[index]);
+    }
+    test_hot_fork_source_set_cleanup(&fixture);
+}
