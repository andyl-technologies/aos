@@ -0,0 +1,331 @@
+/* MOS6522 exact virtual timer and migration tests. */
+/* SPDX-License-Identifier: MIT */
+
+#include "qemu/osdep.h"
+
+#include "exec/icount.h"
+#include "hw/misc/mac_via.h"
+#include "hw/misc/mos6522.h"
+#include "io/channel-file.h"
