+/* This constructor consumes only the real singleton storage reservation.
+ * Setup5 has no subscription roles: session aliases, mapping, holder and debt
+ * stay unborn. This receipt cannot be promoted into a session or an Original. */
+static int preexec_publisher_storage_construct(QemuCruciblePreexecSetupOwner *owner)
+{
+    PreexecPublisherStoragePurpose *storage = &preexec_setup_owner.publisher_storage;
+
+    if (owner != &preexec_setup_owner || storage->attempted ||
+        owner->source_published || !owner->fixed_owner_retained ||
+        owner->fixed_owner_charge != sizeof(*owner) ||
+        !owner->fixed_family.retained || owner->fixed_family.issuer != owner ||
+        !owner->fixed_family.source.retained ||
+        owner->incarnation.assignment != &owner->fixed_family.source ||
+        !owner->artifact_verified || !owner->identity_corroborated ||
+        preexec_setup_syscall5(SYS_getpid, 0, 0, 0, 0, 0) != owner->process_id ||
+        preexec_setup_syscall5(SYS_gettid, 0, 0, 0, 0, 0) != owner->thread_id) {
+        return -EPERM;
+    }
+    storage->canonical_owner = storage;
+    storage->issuer = owner;
+    storage->family = &owner->fixed_family;
+    storage->assignment = &owner->fixed_family.source;
+    storage->process = owner->process_id;
+    storage->thread = owner->thread_id;
+    storage->process_generation = owner->incarnation.generation;
+    storage->account_generation = owner->fixed_family.account_generation;
+    storage->fixed_owner_charge = owner->fixed_owner_charge;
+    storage->storage_bytes = sizeof(*storage);
+    /* This once-only actual constructor issues the local cleanup incarnation.
+     * It is independent of every command/member generation and never reused. */
+    storage->cleanup_generation = 1;
+    storage->attempted = true;
+    storage->retained = true;
+    for (size_t index = 0; index < 3; index++) {
+        storage->session.aliases[index].descriptor = -1;
+    }
+    /* Retain storage even on a negative first. The independent post always
+     * runs and neither result invents a received alias or callback return. */
+    storage->first_status = preexec_setup_original_live();
+    storage->post_status = preexec_setup_original_live();
+    return storage->first_status ? storage->first_status : storage->post_status;
+}
+
+static int preexec_publisher_storage_identity(QemuCruciblePreexecSetupOwner *owner)
+{
+    PreexecPublisherStoragePurpose *storage = &preexec_setup_owner.publisher_storage;
+
+    if (owner != &preexec_setup_owner || !owner->fixed_owner_retained ||
+        owner->fixed_owner_charge != sizeof(*owner) ||
+        storage->canonical_owner != storage || !storage->attempted ||
+        !storage->retained || storage->issuer != owner ||
+        storage->family != &owner->fixed_family ||
+        storage->assignment != &owner->fixed_family.source ||
+        storage->process != owner->process_id || storage->thread != owner->thread_id ||
+        storage->process_generation != owner->incarnation.generation ||
+        storage->account_generation != owner->fixed_family.account_generation ||
+        storage->fixed_owner_charge != owner->fixed_owner_charge ||
+        storage->storage_bytes != sizeof(*storage) ||
+        storage->cleanup_generation != 1) {
+        return -ESTALE;
+    }
+    return 0;
+}
+
+static int preexec_publisher_storage_current(QemuCruciblePreexecSetupOwner *owner)
+{
+    PreexecPublisherStoragePurpose *storage = &preexec_setup_owner.publisher_storage;
+    int status = preexec_publisher_storage_identity(owner);
+
+    return status ? status : storage->first_status ? storage->first_status :
+        storage->post_status;
+}
