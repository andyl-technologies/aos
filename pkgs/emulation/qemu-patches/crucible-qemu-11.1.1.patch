+static int standing_refresh(bool force)
+{
+    QemuCrucibleStandingSourcePurpose *purpose = &startup_source.standing;
+    QemuCrucibleStandingRecord current;
+    uint64_t sequence = 0;
+    int status = qemu_crucible_preexec_standing_sequence_v1(purpose->lender, &sequence);
+
+    if (status) {
+        return status;
+    }
+    if (!force && purpose->sequence && sequence == purpose->sequence) {
+        return 0;
+    }
+    status = qemu_crucible_preexec_standing_snapshot_v1(
+        purpose->lender, purpose->snapshot, &sequence);
+    if (!status) {
+        status = qemu_crucible_standing_record_decode_v4(
+            purpose->snapshot, sizeof(purpose->snapshot), &current);
+    }
+    if (!status) {
+        status = standing_subject_current(&current);
+    }
+    if (!status) {
+        status = standing_action_snapshot_validate(
+            &purpose->current.action, &current.action, sequence);
+    }
+    if (!status) {
+        status = standing_park_snapshot_validate(
+            &purpose->current.park, &current.park, sequence);
+    }
+    if (status) {
+        return status;
+    }
+    if (sequence < purpose->sequence ||
+        current.outer_revision < purpose->current.outer_revision ||
+        current.roster_revision < purpose->current.roster_revision ||
+        (purpose->current.state && current.state != purpose->current.state)) {
+        return -ESTALE;
+    }
+    /* Same revision names immutable content; an actual update publisher must
+     * advance the appropriate revision before changing that content. */
+    if (purpose->sequence &&
+        ((current.outer_revision == purpose->current.outer_revision &&
+          (current.outer_allowance_present != purpose->current.outer_allowance_present ||
+           current.outer_allowance_ns != purpose->current.outer_allowance_ns)) ||
+         (current.roster_revision == purpose->current.roster_revision &&
+          !standing_roster_equal(&current, &purpose->current)))) {
+        return -ESTALE;
+    }
+    status = standing_roster_finite(&current);
+    if (status) {
+        return status;
+    }
+    purpose->sequence = sequence;
+    purpose->current = current;
+    return 0;
+}
+
+static int standing_limits_current(const QemuCrucibleStandingRecord *record,
+                                   uint64_t now)
+{
+    if (record->state) {
+        return record->state == 2 ? -ETIMEDOUT :
+            record->state == 3 ? -ECANCELED : -EPIPE;
+    }
+    if (now < record->origin_ns) {
+        return -ESTALE;
+    }
+    if (record->outer_allowance_present &&
+        now - record->origin_ns >= record->outer_allowance_ns) {
+        return -ETIMEDOUT;
+    }
+    return 0;
+}
