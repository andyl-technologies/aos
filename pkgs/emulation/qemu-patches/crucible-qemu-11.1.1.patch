+typedef struct Fixture {
+    int sender;
+    int sources[FIXTURE_DESCRIPTOR_COUNT];
+    int original_flags[3];
+    uint8_t frame[QEMU_CRUCIBLE_PREEXEC_SETUP_FRAME_BYTES];
+} Fixture;
+
+static int fixture_high_alias(int fd)
+{
+    int high = fcntl(fd, F_DUPFD_CLOEXEC, 32);
+
+    g_assert_cmpint(high, >=, 32);
+    g_assert_cmpint(close(fd), ==, 0);
+    return high;
+}
+
+static void fixture_be32(uint8_t *bytes, uint32_t value)
+{
+    bytes[0] = value >> 24;
+    bytes[1] = value >> 16;
+    bytes[2] = value >> 8;
+    bytes[3] = value;
+}
+
+static void fixture_be64(uint8_t *bytes, uint64_t value)
+{
+    fixture_be32(bytes, value >> 32);
+    fixture_be32(bytes + 4, value);
+}
+
+static void fixture_prepare(Fixture *fixture, bool workspace, int type)
+{
+    struct rlimit limit = {
+        .rlim_cur = FIXTURE_DESCRIPTOR_LIMIT,
+        .rlim_max = FIXTURE_DESCRIPTOR_LIMIT,
+    };
+    int pair[2];
+
+    /* Lower the actual kernel ceiling only in the isolated fixture process.
+     * High source aliases and received aliases overlap under this finite bound.
+     * This transport ceiling supplies no issuer, Source or allocation grant. */
+    g_assert_true(fixture_isolated());
+    g_assert_cmpint(setrlimit(RLIMIT_NOFILE, &limit), ==, 0);
+    g_assert_cmpint(socketpair(AF_UNIX, type | SOCK_CLOEXEC, 0, pair), ==, 0);
+    pair[0] = fixture_high_alias(pair[0]);
+    fixture->sender = fixture_high_alias(pair[1]);
+    for (size_t index = 0; index < G_N_ELEMENTS(fixture->sources); index++) {
+        int fd = index == 1 ? eventfd(0, EFD_CLOEXEC) :
+            memfd_create("preexec-physical-fixture", MFD_CLOEXEC |
+                         (index == 2 || (workspace && index == 5) ? MFD_ALLOW_SEALING : 0));
+
+        g_assert_cmpint(fd, >=, 0);
+        if (index == 0) {
+            g_assert_cmpint(ftruncate(fd, 4096), ==, 0);
+        }
+        if (index == 2) {
+            g_assert_cmpint(fcntl(fd, F_ADD_SEALS, F_SEAL_SHRINK | F_SEAL_GROW |
+                F_SEAL_WRITE | F_SEAL_SEAL), ==, 0);
+        }
+        if (workspace && index == 5) {
+            g_assert_cmpint(ftruncate(fd,
+                QEMU_CRUCIBLE_PROCESS_WORKSPACE_ALLOCATION_BYTES), ==, 0);
+            g_assert_cmpint(fcntl(fd, F_ADD_SEALS,
+                F_SEAL_SHRINK | F_SEAL_GROW | F_SEAL_SEAL), ==, 0);
+        }
+        fixture->sources[index] = fixture_high_alias(fd);
+    }
+    /* These sacrificial names are installed only in an isolated test process.
+     * Old aliases and incoming SCM aliases remain distinct physical resources. */
+    g_assert_cmpint(dup2(pair[0], 3), ==, 3);
+    g_assert_cmpint(dup2(fixture->sources[0], 4), ==, 4);
+    g_assert_cmpint(dup2(fixture->sources[1], 5), ==, 5);
+    g_assert_cmpint(close(pair[0]), ==, 0);
+    for (size_t index = 0; index < 3; index++) {
+        fixture->original_flags[index] = fcntl(3 + index, F_GETFL);
+        g_assert_cmpint(fixture->original_flags[index], >=, 0);
+    }
+    memset(fixture->frame, 0, sizeof(fixture->frame));
+    fixture_be32(fixture->frame, QEMU_CRUCIBLE_PREEXEC_SETUP_MESSAGE_BYTES);
+    fixture->frame[QEMU_CRUCIBLE_PREEXEC_SETUP_TAG_OFFSET] =
+        QEMU_CRUCIBLE_PREEXEC_SETUP_TAG_V5;
+    fixture_be64(fixture->frame + 5, 4096);
+    fixture_be64(fixture->frame + 21, 7);
+    if (workspace) {
+        fixture_be32(fixture->frame + 13,
+                     QEMU_CRUCIBLE_PREEXEC_SETUP_WORKSPACE_PRESENT);
+        fixture_be32(fixture->frame + 17,
+                     QEMU_CRUCIBLE_PREEXEC_SETUP_WORKSPACE_FLAG);
+        fixture_be64(fixture->frame + 29, 9);
+        fixture_be64(fixture->frame + 37, 11);
+        /* Zero device/inode adds no invented nonzero binding restriction. */
+    }
+}
+
+static void fixture_send(Fixture *fixture, size_t bytes, size_t descriptors)
+{
+    union {
+        struct cmsghdr alignment;
+        uint8_t bytes[CMSG_SPACE(FIXTURE_DESCRIPTOR_COUNT * sizeof(int))];
+    } ancillary = { 0 };
+    struct iovec iov = { .iov_base = fixture->frame, .iov_len = bytes };
+    struct msghdr message = { .msg_iov = &iov, .msg_iovlen = 1 };
+
+    g_assert_cmpuint(descriptors, <=, G_N_ELEMENTS(fixture->sources));
+    if (descriptors) {
+        struct cmsghdr *header;
+
+        message.msg_control = ancillary.bytes;
+        message.msg_controllen = CMSG_SPACE(descriptors * sizeof(int));
+        header = CMSG_FIRSTHDR(&message);
+        header->cmsg_level = SOL_SOCKET;
+        header->cmsg_type = SCM_RIGHTS;
+        header->cmsg_len = CMSG_LEN(descriptors * sizeof(int));
+        memcpy(CMSG_DATA(header), fixture->sources, descriptors * sizeof(int));
+    }
+    g_assert_cmpint(sendmsg(fixture->sender, &message, 0), ==, bytes);
+}
+
+static void fixture_assert_aliases(const Fixture *fixture, size_t count)
+{
+    g_assert_cmpuint(preexec_setup_owner.descriptor_count, ==, count);
+    for (size_t index = 0; index < count; index++) {
+        struct stat source;
+        struct stat alias;
+        int fd = preexec_setup_owner.descriptors[index];
+
+        g_assert_cmpint(fd, !=, fixture->sources[index]);
+        g_assert_cmpint(fd, >, 5);
+        g_assert_cmpint(fstat(fixture->sources[index], &source), ==, 0);
+        g_assert_cmpint(fstat(fd, &alias), ==, 0);
+        g_assert_cmpuint(alias.st_dev, ==, source.st_dev);
+        g_assert_cmpuint(alias.st_ino, ==, source.st_ino);
+        g_assert_cmpint(fcntl(fd, F_GETFD) & FD_CLOEXEC, ==, FD_CLOEXEC);
+        g_assert_cmpint(fcntl(fd, F_GETFL), ==,
+                        fcntl(fixture->sources[index], F_GETFL));
+    }
+    for (size_t index = 0; index < 3; index++) {
+        g_assert_cmpint(fcntl(3 + index, F_GETFL), ==,
+                        fixture->original_flags[index]);
+    }
+}
