+static bool virtio_projection_validate_queue(const VirtIODevice *vdev,
+                                             const VirtQueue *vq,
+                                             Error **errp)
+{
+    if (vq->vdev != vdev || vq->vring.num == 0 ||
+        vq->vring.num > VIRTQUEUE_MAX_SIZE ||
+        vq->vring.num_default > VIRTQUEUE_MAX_SIZE ||
+        vq->inuse > vq->vring.num) {
+        error_setg(errp, "virtio queue has invalid projection geometry");
+        return false;
+    }
+
+    if (virtio_vdev_has_feature(vq->vdev, VIRTIO_F_IN_ORDER)) {
+        if (!vq->used_elems) {
+            error_setg(errp, "in-order virtio queue has no continuation state");
+            return false;
+        }
+        for (size_t index = 0; index < vq->vring.num; index++) {
+            const VirtQueueElement *element = &vq->used_elems[index];
+
+            if (element->in_order_filled &&
+                (element->ndescs == 0 || element->ndescs > vq->vring.num)) {
+                error_setg(errp,
+                           "virtio queue has invalid in-order continuation");
+                return false;
+            }
+        }
+    }
+
+    return true;
+}
+
+static void virtio_projection_put_queue(QEMUFile *f, const VirtQueue *vq)
+{
+    uint32_t filled_entries = 0;
+
+    qemu_put_be16(f, vq->queue_index);
+    qemu_put_be32(f, vq->vring.num);
+    qemu_put_be32(f, vq->vring.num_default);
+    qemu_put_be32(f, vq->vring.align);
+    qemu_put_be64(f, vq->vring.desc);
+    qemu_put_be64(f, vq->vring.avail);
+    qemu_put_be64(f, vq->vring.used);
+    qemu_put_be16(f, vq->last_avail_idx);
+    qemu_put_byte(f, vq->last_avail_wrap_counter);
+    qemu_put_be16(f, vq->used_idx);
+    qemu_put_byte(f, vq->used_wrap_counter);
+    qemu_put_be16(f, vq->signalled_used);
+    qemu_put_byte(f, vq->signalled_used_valid);
+    qemu_put_byte(f, vq->notification);
+    qemu_put_be32(f, vq->inuse);
+    qemu_put_be16(f, vq->vector);
+
+    if (virtio_vdev_has_feature(vq->vdev, VIRTIO_F_IN_ORDER)) {
+        for (size_t index = 0; index < vq->vring.num; index++) {
+            if (vq->used_elems[index].in_order_filled) {
+                filled_entries++;
+            }
+        }
+    }
+    qemu_put_be32(f, filled_entries);
+    for (size_t index = 0; index < vq->vring.num && filled_entries != 0;
+         index++) {
+        const VirtQueueElement *element = &vq->used_elems[index];
+
+        if (!element->in_order_filled) {
+            continue;
+        }
+        qemu_put_be16(f, index);
+        qemu_put_be32(f, element->index);
+        qemu_put_be32(f, element->len);
+        qemu_put_be32(f, element->ndescs);
+    }
+}
