+int qemu_crucible_startup_source_control_component_enroll_v1(
+    qemu_plugin_id_t id, qemu_plugin_vcpu_idle_resume_cb_t callback,
+    void *child_userdata,
+    qemu_plugin_crucible_fingerprint_intent_cb_v1 snapshot_callback,
+    void *runtime_userdata, QemuCrucibleSourceControlBinding **paid_holder)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    QemuCrucibleSourceControlBinding *binding = &startup_source.control_callback;
+    QemuCrucibleCallbackChildOwner *owner = &startup_source.callbacks.owner;
+    QemuCrucibleFingerprintCompletionBinding *completion =
+        &startup_source.fingerprint_completion;
+    uintptr_t base;
+    uintptr_t field = (uintptr_t)paid_holder;
+    uint64_t extent;
+    int status = command_registry_identity(id);
+    int post;
+
+    if (status || !startup_invocation(id) || startup_source.install_returned ||
+        !callback || !snapshot_callback || !child_userdata || !paid_holder) {
+        return status ? status : -EPERM;
+    }
+    status = fingerprint_completion_identity(completion);
+    if (!status) {
+        status = startup_runtime_admission(id, completion->runtime);
+    }
+    if (status) {
+        return status;
+    }
+    qemu_mutex_lock(&commands->mutex);
+    status = callback_registration_owner_live_locked(owner);
+    if (!status && (binding->attempted || runtime_userdata != completion->userdata ||
+                    completion->runtime != owner->runtime ||
+                    child_userdata != owner->child->address)) {
+        status = -EPERM;
+    }
+    if (!status && owner->component_users == UINT64_MAX) {
+        status = -EOVERFLOW;
+    }
+    if (!status) {
+        /* The entered nominal owner supplies the completed child and real
+         * Runtime. Callback/userdata and field geometry only corroborate it. */
+        base = owner->runtime_base;
+        extent = owner->runtime_extent;
+        if (!extent || extent > UINTPTR_MAX - base || field < base ||
+            sizeof(*paid_holder) > extent ||
+            field - base > extent - sizeof(*paid_holder) ||
+            field % _Alignof(QemuCrucibleSourceControlBinding *) ||
+            callback_child_output_conflicts_locked(paid_holder, sizeof(*paid_holder)) ||
+            *paid_holder) {
+            status = -EINVAL;
+        }
+    }
+    if (status) {
+        qemu_mutex_unlock(&commands->mutex);
+        return status;
+    }
+    *binding = (QemuCrucibleSourceControlBinding) {
+        .installer = startup_source.saved,
+        .child_owner = owner,
+        .runtime = owner->runtime,
+        .completion = completion,
+        .holder = paid_holder,
+        .callback = callback,
+        .snapshot_callback = snapshot_callback,
+        .userdata = owner->child->address,
+        .fixed_storage_bytes = sizeof(startup_source.control_callback),
+        .attempted = true,
+        .observation.descriptor = -1,
+    };
+    owner->component_users++;
+    *paid_holder = binding;
+    qemu_mutex_unlock(&commands->mutex);
+
+    /* Preserve the authentic owner dependency and born field even if the
+     * independent installing post refuses before any registration effect. */
+    post = startup_runtime_admission(id, owner->runtime);
+    qemu_mutex_lock(&commands->mutex);
+    binding->first_status = post;
+    binding->enrolled = !post;
+    qemu_mutex_unlock(&commands->mutex);
+    if (post) {
+        crucible_metadata_partition_record_post(&startup_source.metadata_partition, post);
+    }
+    return post;
+#else
+    return -ENOTSUP;
+#endif
+}
