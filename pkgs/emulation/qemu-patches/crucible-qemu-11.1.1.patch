+static void fingerprint_capture_record(CrucibleRamRegion *region,
+                                       uint64_t offset, uint32_t valid)
+{
+    if (!region->fingerprint_capture_end) {
+        region->fingerprint_capture_start = offset;
+    } else {
+        region->fingerprint_capture_start = MIN(region->fingerprint_capture_start, offset);
+    }
+    region->fingerprint_capture_end = MAX(region->fingerprint_capture_end, offset + valid);
+}
