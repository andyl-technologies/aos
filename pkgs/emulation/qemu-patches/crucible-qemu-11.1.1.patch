+int qemu_plugin_crucible_wake_watcher_snapshot_enter_v1(
+    QemuCrucibleFingerprintWakeWatcher *watcher,
+    QemuCrucibleFingerprintMainReadyFrame *frame, uint64_t registration_serial)
