+    } else if (!strcmp(kind, "present-generation")) {
+        count = QEMU_CRUCIBLE_PREEXEC_SETUP_WORKSPACE_FDS;
+        fixture_be64(fixture.frame + 37, 0);
+    } else if (!strcmp(kind, "type")) {
+        expected = -EPROTOTYPE;
+    } else if (!strcmp(kind, "empty")) {
+        expected = -EAGAIN;
+    } else if (!strcmp(kind, "eof")) {
+        expected = -EMSGSIZE;
+        g_assert_cmpint(close(fixture.sender), ==, 0);
+    }
+    if (strcmp(kind, "empty") && strcmp(kind, "eof")) {
+        fixture_send(&fixture, bytes, count);
