+                )
+
+        while True:
+            event, value = live.marker()
+            if event == "result" and value == 0:
+                break
+            if event not in ("park", "result", "work"):
+                raise AssertionError(
+                    f"unexpected post-boundary marker: {(event, value)!r}"
+                )
+    finally:
+        live.close()
+    return live
