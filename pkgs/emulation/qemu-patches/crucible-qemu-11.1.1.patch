+static void scenario_park_registry(void)
+{
+    GHashTable *table;
+    QemuThread thread;
+
+    fixture_prepare(0, false);
+    g_assert_cmpint(fixture_acquire(), ==, 0);
+    table = plugin.id_ht;
+    plugin.id_ht = NULL;
+    g_assert_cmpint(fixture_register_park(), ==, -EPERM);
+    plugin.id_ht = table;
+    g_assert_true(g_hash_table_remove(table, &fixture.ctx.id));
+    g_assert_cmpint(fixture_register_park(), ==, -EPERM);
+    g_assert_true(g_hash_table_insert(table, &fixture.ctx.id, &fixture.ctx.id));
+    fixture.ctx.resetting = true;
+    g_assert_cmpint(fixture_register_park(), ==, -EPERM);
+    fixture.ctx.resetting = false;
+    fixture.ctx.uninstalling = true;
+    g_assert_cmpint(fixture_register_park(), ==, -EPERM);
+    fixture.ctx.uninstalling = false;
+
+    assert_park_unpublished();
+    g_assert_cmpint(startup_source.first_negative_status, ==, 0);
+    g_assert_cmpint(fixture_register_park(), ==, 0);
+    /* Every attempted recursive level was released; original level survives. */
+    qemu_rec_mutex_unlock(&plugin.lock);
+    qemu_thread_create(&thread, "park-register-unlocked",
+                       foreign_park_mutex_probe, NULL, QEMU_THREAD_JOINABLE);
+    qemu_thread_join(&thread);
+    assert_retained();
