+void qemu_crucible_fault_event_reservation_consume(
+    QemuCrucibleFaultEventReservation *reservation)
+{
+    g_auto(CrucibleNodeStorageOperation) operation =
+        node_storage_operation_begin();
+    if (!operation.entered || !node_reservation_current(reservation) ||
+        reservation->remaining == 0 ||
+        crucible_node_event_reserved == 0) {
+        error_report("Invalid Crucible fault-event reservation consume");
+        abort();
+    }
+    reservation->remaining--;
+    crucible_node_event_reserved--;
+    crucible_node_event_sequence_reserved--;
+}
+
+QemuCrucibleFaultEventReservation *
+qemu_crucible_fault_event_reservation_split(
+    QemuCrucibleFaultEventReservation *reservation, size_t count)
+{
+    g_auto(CrucibleNodeStorageOperation) operation =
+        node_storage_operation_begin();
+    QemuCrucibleFaultEventReservation *split;
+    uint64_t issuance;
+    CrucibleNodeRegistrationChild *child = NULL;
+
+    if (!operation.entered || !node_reservation_current(reservation) ||
+        count == 0 || count > reservation->remaining) {
+        error_report("Invalid Crucible fault-event reservation split");
+        abort();
+    }
+    issuance = node_storage_admit(CRUCIBLE_NODE_STORAGE_RESERVATION);
+    if (!issuance) {
+        error_report("Crucible event-reservation split lacks an allocation route");
+        abort();
+    }
+    if (node_registration_child_acquire(reservation->storage.origin,
+            CRUCIBLE_NODE_STORAGE_RESERVATION, &child)) {
+        error_report("Crucible reservation split lost its registration parent");
+        abort();
+    }
+    split = g_new0(QemuCrucibleFaultEventReservation, 1);
+    node_storage_publish(&split->storage, split, split, NULL,
+                         CRUCIBLE_NODE_STORAGE_RESERVATION, issuance,
+                         reservation->storage.origin, child);
+    if (!node_envelope_split(reservation, split, count)) {
+        error_report("Crucible reservation split lost prepaid envelope custody");
+        abort();
+    }
+    split->remaining = count;
+    reservation->remaining -= count;
+    return split;
+}
+
+void qemu_crucible_fault_event_reservation_release(
+    QemuCrucibleFaultEventReservation *reservation)
+{
+    g_auto(CrucibleNodeStorageOperation) operation =
+        node_storage_operation_begin();
+    CrucibleNodeStorageControl *control;
+    uint64_t issuance;
+
+    if (!operation.entered ||
+        (!reservation && crucible_node_vmstate_restoring)) {
+        return;
+    }
+    control = node_storage_retire_begin(
+        reservation, CRUCIBLE_NODE_STORAGE_RESERVATION);
+    if (!control) {
+        return;
+    }
+    issuance = control->issuance;
+    if (!crucible_node_vmstate_restoring && (
+        crucible_node_event_reserved < reservation->remaining ||
+        crucible_node_event_sequence_reserved < reservation->remaining)) {
+        error_report("Invalid Crucible fault-event reservation release");
+        abort();
+    }
+    if (!crucible_node_vmstate_restoring) {
+        crucible_node_event_reserved -= reservation->remaining;
+        crucible_node_event_sequence_reserved -= reservation->remaining;
+    }
+    int envelope_status = node_envelope_release(reservation);
+
+    if (envelope_status) {
+        control->post_status = envelope_status;
+        return;
+    }
+    if (!node_storage_unpublish(control)) {
+        return;
+    }
+    g_free(reservation);
+    node_storage_retire_post(reservation, issuance,
+                             CRUCIBLE_NODE_STORAGE_RESERVATION);
+}
+
+/* Discarding prepared restore storage never retires live queue credits. */
+void qemu_crucible_fault_event_reservation_discard(
+    QemuCrucibleFaultEventReservation *reservation)
+{
+    g_auto(CrucibleNodeStorageOperation) operation =
+        node_storage_operation_begin();
+    CrucibleNodeStorageControl *control;
+    uint64_t issuance;
+
+    if (!operation.entered || !reservation) {
+        return;
+    }
+    control = node_storage_retire_begin(
+        reservation, CRUCIBLE_NODE_STORAGE_RESERVATION);
+    if (!control) {
+        return;
+    }
+    issuance = control->issuance;
+    int envelope_status = node_envelope_release(reservation);
+
+    if (envelope_status) {
+        control->post_status = envelope_status;
+        return;
+    }
+    if (!node_storage_unpublish(control)) {
+        return;
+    }
+    g_free(reservation);
+    node_storage_retire_post(reservation, issuance,
+                             CRUCIBLE_NODE_STORAGE_RESERVATION);
+}
