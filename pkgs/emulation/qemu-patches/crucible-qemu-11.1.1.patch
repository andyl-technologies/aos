+bool qemu_crucible_fault_host_memory_service_profile_valid(
+    bool cpu_ticket_available)
+{
+    if (!crucible_node_rules) {
+        return true;
+    }
+    for (guint i = 0; i < crucible_node_rules->len; i++) {
+        QemuCrucibleFaultRule *rule =
+            g_ptr_array_index(crucible_node_rules, i);
+
+        const QObject *actor;
+
+        if (rule->command_kind != CRUCIBLE_FAULT_COMMAND_MEMORY_SERVICE) {
+            return false;
+        }
+        actor = node_field(rule, CRUCIBLE_NODE_FAULT_FIELD_P7)->json;
+        if (!node_memory_service_actor_is_fw_cfg(rule) &&
+            !(cpu_ticket_available &&
+              node_json_tag_dict(actor, "cpu_single_access"))) {
+            return false;
+        }
+    }
+    return true;
+}
