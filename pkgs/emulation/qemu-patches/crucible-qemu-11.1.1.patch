diff --git a/tests/unit/test-crucible-apic-timer-storage.py b/tests/unit/test-crucible-apic-timer-storage.py
new file mode 100644
index 0000000000000000000000000000000000000000..cb5476a3f38ac64bbe6bf9ecbf820216680a31a9
--- /dev/null
+++ b/tests/unit/test-crucible-apic-timer-storage.py
@@ -0,0 +1,313 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Exercise literal software APIC timer storage with real QOM/timer libraries.
+
+The parent class and timer callback are diagnostic fixtures. No CPU, APIC
+realization, selected Source receipt or architecture read authority is issued.
+CC/CFLAGS/LDFLAGS must select the configured QEMU target and libraries.
+"""
+
+import argparse
+import json
+import os
+from pathlib import Path
+import runpy
+import shlex
+import signal
+import subprocess
+
+
+PREFIX = r"""
+#include "qemu/osdep.h"
+#include "qemu/module.h"
+#include "qemu/main-loop.h"
+#include "qapi/error.h"
+#include "qemu/error-report.h"
+#include "qemu/crucible-fault.h"
+#include "hw/i386/apic_internal.h"
+#include "qemu/crucible-clock-custody.h"
+
+/* No Source owner is issued in this ordinary initialized-QOM control. */
+int qemu_crucible_fault_clock_source_unregister_owned_v1(
+    QemuCrucibleClockStorage *storage)
+{
+    abort();
+}
+
+int qemu_crucible_source_clock_callback_begin_v1(
+    QemuCrucibleCpuSourceAllocationOwner *owner,
+    QemuCrucibleTimerCallbackFrame *frame,
+    QemuCrucibleClockCallbackLease **holder)
+{
+    abort();
+}
+
+int qemu_crucible_source_clock_callback_end_v1(
+    QemuCrucibleTimerCallbackFrame *frame,
+    QemuCrucibleClockCallbackLease **holder)
+{
+    abort();
+}
+
+static unsigned callbacks, frees;
+static APICCommonState *expected_callback;
+static APICCommonState *local_apics[1];
+static void (*original_free)(void *);
+
+int64_t cpu_get_clock(void)
+{
+    return 1000;
+}
+
+static __int128 diagnostic_clock_ps(void)
+{
+    return 1000000;
+}
+
+static void apic_timer(void *opaque)
+{
+    assert(opaque == expected_callback);
+    callbacks++;
+}
+
+/* The real APIC class initializer installs architecture callbacks. Those are
+ * excluded here: this fixture exercises initialized QOM storage and timers. */
+static void apic_class_init(ObjectClass *klass, const void *data)
+{
+}
+
+#define TYPE_APIC "apic"
+"""
+
+
+CHECKS = r"""
+static void observed_free(void *opaque)
+{
+    APICState *apic = opaque;
+
+    assert(apic->parent_obj.timer == NULL);
+    assert(apic->timer_storage.timer_list == NULL);
+    assert(!apic->timer_storage.pending);
+    assert(!qemu_clock_has_timers(QEMU_CLOCK_VIRTUAL));
+    frees++;
+    original_free(opaque);
+}
+
+static APICState *new_storage(void)
+{
+    Object *object = object_new(TYPE_APIC);
+    APICState *apic = APIC(object);
+
+    assert(object_get_instance_size(object) == sizeof(APICState));
+    assert(sizeof(APICState) >= sizeof(APICCommonState) + sizeof(QEMUTimer));
+    assert(_Alignof(APICState) == _Alignof(APICCommonState));
+    assert(!apic->parent_obj.timer);
+    original_free = object->free;
+    object->free = observed_free;
+    return apic;
+}
+
+static void initialize(APICState *apic)
+{
+    APICCommonState *s = &apic->parent_obj;
+
+    apic_timer_initialize(apic);
+    assert(s->timer == &apic->timer_storage);
+    assert(s->timer->timer_list != NULL);
+    assert(s->timer->cb == apic_timer && s->timer->opaque == s);
+    assert(s->timer->scale == SCALE_NS);
+    assert(!s->timer->pending);
+    assert(s->timer->expire_time == -1);
+}
+
+int main(void)
+{
+    const TypeInfo parent = {
+        .name = TYPE_APIC_COMMON,
+        .parent = TYPE_OBJECT,
+        .instance_size = sizeof(APICCommonState),
+        .class_size = sizeof(APICCommonClass),
+    };
+    APICState *apic;
+    APICCommonState *s;
+    Error *error = NULL;
+
+    module_call_init(MODULE_INIT_QOM);
+    qemu_init_main_loop(&error);
+    assert(!error);
+    if (g_getenv("APIC_TIMER_PS")) {
+        qemu_timer_enable_tcg_ps_clock(NULL, diagnostic_clock_ps);
+    }
+    qemu_clock_enable(QEMU_CLOCK_VIRTUAL, true);
+    type_register_static(&parent);
+    type_register_static(&apic_info);
+
+    if (g_getenv("APIC_TIMER_BENCH")) {
+        apic = new_storage();
+        s = &apic->parent_obj;
+        initialize(apic);
+        expected_callback = s;
+        int64_t start = g_get_monotonic_time();
+        const unsigned count = 200000;
+
+        for (unsigned iteration = 0; iteration < count; iteration++) {
+            timer_mod_ns(s->timer, 999);
+            qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL);
+        }
+        assert(callbacks == count);
+        printf("ordinary-dispatch=%u us=%" PRId64 " ps=%d\n", count,
+               g_get_monotonic_time() - start, !!g_getenv("APIC_TIMER_PS"));
+        apic_unrealize((DeviceState *)apic);
+        object_unref(OBJECT(apic));
+        return 0;
+    }
+
+    /* Successful list dispatch uses the actual timer APIs and stored callback.
+     * Architecture delivery and callback custody are deliberately excluded. */
+    apic = new_storage();
+    s = &apic->parent_obj;
+    initialize(apic);
+    expected_callback = s;
+    timer_mod_ns(s->timer, 999);
+    assert(timer_pending(s->timer));
+    qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL);
+    assert(callbacks == 1 && !timer_pending(s->timer));
+
+    timer_mod_ns(s->timer, 2000);
+    assert(qemu_clock_has_timers(QEMU_CLOCK_VIRTUAL));
+    local_apics[0] = s;
+    apic_unrealize((DeviceState *)apic);
+    assert(!local_apics[0]);
+    assert(!s->timer && !apic->timer_storage.timer_list);
+    assert(!qemu_clock_has_timers(QEMU_CLOCK_VIRTUAL));
+    apic_timer_cleanup(apic);
+
+    /* A later realize can initialize fresh timer identity in the same extent. */
+    initialize(apic);
+    timer_mod_ns(s->timer, 2000);
+    apic_unrealize((DeviceState *)apic);
+    object_unref(OBJECT(apic));
+    assert(frees == 1);
+
+    /* The actual finalizer must also cover failure after initialization but
+     * before qdev considers the device realized (and hence skips unrealize). */
+    apic = new_storage();
+    initialize(apic);
+    timer_mod_ns(apic->parent_obj.timer, 2000);
+    object_unref(OBJECT(apic));
+    assert(frees == 2 && callbacks == 1);
+
+    apic = new_storage();
+    object_unref(OBJECT(apic));
+    assert(frees == 3);
+    printf("PASS real QOM storage and timer dispatch/unrealize/finalize; "
+           "common=%zu timer=%zu software=%zu align=%zu; "
+           "diagnostic parent/callback only\n",
+           sizeof(APICCommonState), sizeof(QEMUTimer), sizeof(APICState),
+           _Alignof(APICState));
+    return 0;
+}
+"""
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    parser.add_argument("--positive-only", action="store_true")
+    args = parser.parse_args()
+    source = Path(__file__).resolve().parents[2]
+    output = args.output_dir.resolve()
+    output.mkdir(parents=True, exist_ok=True)
+    extract = runpy.run_path(str(
+        source / "tests/unit/extract-crucible-startup-source-controls.py"))
+    function = extract["function"]
+    text = (source / "hw/intc/apic.c").read_text()
+    start = text.index("typedef struct APICState {")
+    end = text.index("DECLARE_INSTANCE_CHECKER(APICState, APIC, TYPE_APIC)", start)
+    declaration = (text[start:end] +
+                   "DECLARE_INSTANCE_CHECKER(APICState, APIC, TYPE_APIC)\n")
+    bodies = "\n\n".join(function(text, opening) for opening in (
+        "static void apic_timer_initialize(",
+        "static void apic_timer_cleanup(",
+        "static void apic_unrealize(",
+        "static void apic_instance_finalize("))
+    start = text.index("static const TypeInfo apic_info = {")
+    info = text[start:text.index("\n};", start) + 3]
+    production = declaration + bodies + "\n" + info
+    omissions = {
+        "instance-extent": (".instance_size = sizeof(APICState)",
+                            ".instance_size = sizeof(APICCommonState)"),
+        "initialize": (
+            "timer_init_ns(&apic->timer_storage, QEMU_CLOCK_VIRTUAL, "
+            "apic_timer, s);", ""),
+        "storage-binding": ("s->timer = &apic->timer_storage;", ""),
+        "list-return": ("timer_del(s->timer);", ""),
+        "deinitialize": ("timer_deinit(s->timer);", ""),
+        "clear-interface": ("s->timer = NULL;", ""),
+        "unrealize-cleanup": ("apic_timer_cleanup(apic);", ""),
+        "finalize-cleanup": ("apic_timer_cleanup(APIC(obj));", ""),
+        "finalize-registration": (
+            ".instance_finalize = apic_instance_finalize,", ""),
+    }
+    variants = {"positive": PREFIX + production + CHECKS}
+    for name, (before, after) in ({} if args.positive_only else omissions).items():
+        if production.count(before) != 1:
+            raise ValueError(f"reviewed operation changed: {name}")
+        variants["omit-" + name] = (
+            PREFIX + production.replace(before, after, 1) + CHECKS)
+
+    detectors = {
+        "instance-extent": "object_get_instance_size(object) == sizeof(APICState)",
+        "initialize": "s->timer->timer_list != NULL",
+        "storage-binding": "s->timer == &apic->timer_storage",
+        "list-return": "!ts->pending",
+        "deinitialize": "!s->timer && !apic->timer_storage.timer_list",
+        "clear-interface": "!s->timer && !apic->timer_storage.timer_list",
+        "unrealize-cleanup": "!s->timer && !apic->timer_storage.timer_list",
+        "finalize-cleanup": "apic->parent_obj.timer == NULL",
+        "finalize-registration": "apic->parent_obj.timer == NULL",
+    }
+
+    records = {}
+    for name, body in variants.items():
+        generated = output / (name + ".c")
+        binary = output / name
+        generated.write_text(body)
+        command = [*shlex.split(os.environ.get("CC", "cc")),
+                   *shlex.split(os.environ.get("CFLAGS", "")),
+                   str(generated), "-ffunction-sections", "-fdata-sections",
+                   "-Wl,--gc-sections", "-o", str(binary),
+                   *shlex.split(os.environ.get("LDFLAGS", ""))]
+        (output / (name + ".command.json")).write_text(
+            json.dumps(command, indent=2) + "\n")
+        result = subprocess.run(command, stdout=subprocess.PIPE,
+                                stderr=subprocess.STDOUT, text=True)
+        (output / (name + ".compile.log")).write_text(result.stdout)
+        if result.returncode:
+            raise RuntimeError(f"{name} compile failed: {result.stdout}")
+        result = subprocess.run([str(binary)], stdout=subprocess.PIPE,
+                                stderr=subprocess.STDOUT, text=True)
+        (output / (name + ".run.log")).write_text(result.stdout)
+        records[name] = result.returncode
+        if (name == "positive") != (result.returncode == 0):
+            raise RuntimeError(f"{name} unexpected result: {result.stdout}")
+        if name != "positive":
+            detector = detectors[name.removeprefix("omit-")]
+            if (result.returncode != -signal.SIGABRT or
+                    detector not in result.stdout):
+                raise RuntimeError(f"{name} missed causal detector: {result.stdout}")
+        print(name, result.returncode, result.stdout.strip(), flush=True)
+        if name == "positive":
+            result = subprocess.run(
+                [str(binary)], env=dict(os.environ, APIC_TIMER_PS="1"),
+                stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
+            (output / "positive-ps.run.log").write_text(result.stdout)
+            records["positive-ps"] = result.returncode
+            if result.returncode:
+                raise RuntimeError(f"positive ps mode failed: {result.stdout}")
+            print("positive-ps", result.returncode, result.stdout.strip(),
+                  flush=True)
+    (output / "results.json").write_text(json.dumps(records, indent=2) + "\n")
+
+
+if __name__ == "__main__":
+    main()
