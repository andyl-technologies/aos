index 0000000000000000000000000000000000000000..4ddc6b3a43e0d26d4833b3140f610d96a06e2dcf
--- /dev/null
+++ b/tests/unit/test-crucible-kernel-swap-observation.c
@@ -0,0 +1,72 @@
+/*
+ * Bounded anonymous RAM observation controls
+ * Copyright (c) 2026 Andyl, Inc.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+#include "system/crucible-kernel-swap-observation.h"
+
+static void test_categories(void)
+{
+    CrucibleSwapChunk chunk = { 0 };
+    CrucibleSwapCounts counts = { 0 };
+
+    chunk.regions[0] = (CrucibleSwapPageRegion) {
+        4096, 8192, CRUCIBLE_SCAN_PRESENT | CRUCIBLE_SCAN_PFNZERO,
+    };
+    chunk.regions[1] = (CrucibleSwapPageRegion) {
+        8192, 12288, CRUCIBLE_SCAN_SWAPPED,
+    };
+    chunk.regions[2] = (CrucibleSwapPageRegion) {
+        12288, 16384, CRUCIBLE_SCAN_SWAPPED,
+    };
+    g_assert_true(crucible_swap_associate(&chunk, 4096, 3, 3));
+    chunk.entries[0] = UINT64_C(1) << 63;
+    chunk.entries[1] = UINT64_C(1) << 62;
+    chunk.entries[2] = UINT64_C(1) << 63;
+    chunk.resident[0] = chunk.resident[2] = 1;
+    g_assert_true(crucible_swap_count(&chunk, 3, &counts));
+    g_assert_cmpuint(counts.present, ==, 2);
+    g_assert_cmpuint(counts.zero, ==, 1);
+    g_assert_cmpuint(counts.swapped_nonresident, ==, 1);
+    g_assert_cmpuint(counts.changed, ==, 1);
+
+    /* A swapped but resident page may still be in swap cache. */
+    chunk.entries[2] = UINT64_C(1) << 62;
+    counts = (CrucibleSwapCounts) { 0 };
+    g_assert_true(crucible_swap_count(&chunk, 3, &counts));
+    g_assert_cmpuint(counts.swapped, ==, 2);
+    g_assert_cmpuint(counts.swapped_nonresident, ==, 1);
+}
+
+static void test_invalid_intervals(void)
+{
+    CrucibleSwapChunk chunk = { 0 };
+    CrucibleSwapCounts counts = { 0 };
+
+    chunk.regions[0] = (CrucibleSwapPageRegion) { 4096, 12288, 0 };
+    g_assert_true(crucible_swap_associate(&chunk, 4096, 2, 1));
+    g_assert_false(crucible_swap_associate(&chunk, 4096, 3, 1));
+    g_assert_false(crucible_swap_associate(&chunk, UINT64_MAX - 4095, 2, 1));
+    g_assert_false(crucible_swap_associate(&chunk, 4096, 65, 1));
+    chunk.regions[0].start = 8192;
+    g_assert_false(crucible_swap_associate(&chunk, 4096, 2, 1));
+    chunk.regions[0].start = 4096;
+    chunk.regions[0].categories = CRUCIBLE_SCAN_HUGE;
+    g_assert_false(crucible_swap_associate(&chunk, 4096, 2, 1));
+    chunk.regions[0].categories = CRUCIBLE_SCAN_FILE;
+    g_assert_false(crucible_swap_associate(&chunk, 4096, 2, 1));
+    chunk.regions[0].categories = CRUCIBLE_SCAN_PRESENT | CRUCIBLE_SCAN_SWAPPED;
+    g_assert_false(crucible_swap_associate(&chunk, 4096, 2, 1));
+    chunk.entries[0] = UINT64_C(3) << 62;
+    g_assert_false(crucible_swap_count(&chunk, 2, &counts));
+    g_assert_cmpuint(counts.present, ==, 0);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/crucible/kernel-swap/categories", test_categories);
+    g_test_add_func("/crucible/kernel-swap/invalid-intervals", test_invalid_intervals);
+    return g_test_run();
+}
