+/**
+ * qemu_plugin_net_inject() - injects an inbound frame into the default NIC
+ * @data: Ethernet frame bytes
+ * @len: byte length of @data
+ *
+ * This direct injection helper is intended for deterministic sim-mode plugins
+ * that have already advanced virtual time to the frame's delivery icount. It
+ * preserves caller ownership when the guest NIC cannot receive at that moment.
+ *
+ * Returns: 0 on complete delivery, 1 on transient guest backpressure, and a
+ * negative value on a permanent capability, payload, or link failure.
+ */
+QEMU_PLUGIN_API
+int qemu_plugin_net_inject(const uint8_t *data, size_t len);
