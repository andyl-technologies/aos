+/* The native collector retains actual writer/thread/descriptor admission.
+ * Audited device/listener ownership and paired DMA/cache lifetime evidence are
+ * additional obligations, not consequences of paused vCPU/BQL ownership. */
+static uint64_t physical_token;
+static uint64_t physical_topology;
+static uint64_t physical_borrow_generation;
+static uint64_t physical_device_generation;
+static uint64_t physical_listener_generation;
+
+/* A checkpoint borrows the real collector hold rather than reconstructing
+ * one from a caller token. The fixed slot is counted once in the native floor.
+ * Its identity survives failed checks until the exact callback returns it.
+ */
+struct QemuCrucibleCheckpointNativeFence {
+    QemuCrucibleCheckpointHeldTransaction *transaction;
+    pid_t process;
+    QemuThread thread;
+    uint64_t token;
+    uint64_t topology;
+    bool held;
+    bool local_returned;
+    bool cleanup_started;
+    struct qemu_plugin_crucible_ram_physical_end_v2 end;
+};
+
+static QemuCrucibleCheckpointNativeFence checkpoint_native_fence;
+static unsigned checkpoint_native_fence_cut;
+
+static int checkpoint_native_fence_current(
+    QemuCrucibleCheckpointHeldTransaction *transaction)
+{
+    int status = qemu_crucible_checkpoint_transaction_proof_current(transaction);
+
+    if (status) {
+        return status;
+    }
+    if (!physical_token) {
+        /* PREPARE may have closed local gates before the genuine native
+         * collector owner exists. Pending never constructs that owner. */
+        return -EINPROGRESS;
+    }
+    if (physical_topology != admission.topology_generation ||
+        physical_topology != qatomic_read(&topology_generation) ||
+        physical_device_generation != qemu_crucible_ram_physical_device_generation() ||
+        physical_listener_generation != qemu_crucible_ram_physical_listener_generation() ||
+        !qemu_crucible_ram_owner_closure_current(physical_token)) {
+        return -ESTALE;
+    }
+    return 0;
+}
+
+int qemu_crucible_checkpoint_native_fence_acquire_v1(
+    QemuCrucibleCheckpointHeldTransaction *transaction,
+    QemuCrucibleCheckpointNativeFence **out)
+{
+    int status = checkpoint_native_fence_current(transaction);
+
+    if (status || !out) {
+        return status ? status : -EINVAL;
+    }
+    if (qatomic_cmpxchg(&checkpoint_native_fence_cut, 0, 1)) {
+        return -EAGAIN;
+    }
+    status = checkpoint_native_fence_current(transaction);
+    if (!status && checkpoint_native_fence.held) {
+        status = checkpoint_native_fence.transaction == transaction ?
+            -EALREADY : -EBUSY;
+    }
+    if (!status) {
+        checkpoint_native_fence.transaction = transaction;
+        checkpoint_native_fence.process = getpid();
+        qemu_thread_get_self(&checkpoint_native_fence.thread);
+        checkpoint_native_fence.token = physical_token;
+        checkpoint_native_fence.topology = physical_topology;
+        checkpoint_native_fence.local_returned = false;
+        checkpoint_native_fence.cleanup_started = false;
+        qatomic_store_release(&checkpoint_native_fence.held, true);
+        *out = &checkpoint_native_fence;
+    }
+    qatomic_store_release(&checkpoint_native_fence_cut, 0);
+    return status;
+}
+
+int qemu_crucible_checkpoint_native_fence_check_v1(
+    QemuCrucibleCheckpointHeldTransaction *transaction,
+    QemuCrucibleCheckpointNativeFence *fence)
+{
+    int status = qemu_crucible_checkpoint_transaction_proof_current(transaction);
+
+    if (status) {
+        return status;
+    }
+    if (fence != &checkpoint_native_fence ||
+        !qatomic_load_acquire(&checkpoint_native_fence.held) ||
+        fence->process != getpid() || !qemu_thread_is_self(&fence->thread) ||
+        fence->transaction != transaction) {
+        return -EPERM;
+    }
+    if (fence->token != physical_token || fence->topology != physical_topology) {
+        return -ESTALE;
+    }
+    return checkpoint_native_fence_current(transaction);
+}
+
+int qemu_crucible_checkpoint_native_fence_return_v1(
+    QemuCrucibleCheckpointHeldTransaction *transaction,
+    QemuCrucibleCheckpointNativeFence *fence)
+{
+    int status = qemu_crucible_checkpoint_native_fence_check_v1(transaction, fence);
+
+    if (status) {
+        return status;
+    }
+    if (qatomic_cmpxchg(&checkpoint_native_fence_cut, 0, 1)) {
+        return -EAGAIN;
+    }
+    status = qemu_crucible_checkpoint_native_fence_check_v1(transaction, fence);
+    if (!status && fence->local_returned) {
+        status = -EALREADY;
+    }
+    if (!status) {
+        /* Local proof disposition precedes callback return and native post.
+         * Keep the real collector exclusion through that entire interval and
+         * later exact Receiving cleanup. This is not whole fence retirement.
+         */
+        fence->local_returned = true;
+    }
+    qatomic_store_release(&checkpoint_native_fence_cut, 0);
+    /* Actual Receiving final retirement must release this native cleanup hold;
+     * it is not supplied by a callback status or the returned local proof. */
+    return status;
+}
+
+int qemu_crucible_checkpoint_native_fence_retire_v1(
+    QemuCrucibleCheckpointHeldTransaction *transaction,
+    QemuCrucibleCheckpointNativeFence *fence)
+{
+    int status =
+        qemu_crucible_checkpoint_transaction_retirement_current(transaction);
+
+    if (status) {
+        return status;
+    }
+    if (qatomic_cmpxchg(&checkpoint_native_fence_cut, 0, 1)) {
+        return -EAGAIN;
+    }
+    status = qemu_crucible_checkpoint_transaction_retirement_current(transaction);
+    if (!status &&
+        (fence != &checkpoint_native_fence || !fence->held ||
+         fence->process != getpid() || !qemu_thread_is_self(&fence->thread) ||
+         fence->transaction != transaction || !fence->local_returned)) {
+        status = -EPERM;
+    }
+    if (!status &&
+        (!physical_token || fence->token != physical_token ||
+         fence->topology != physical_topology ||
+         physical_topology != admission.topology_generation ||
+         physical_topology != qatomic_read(&topology_generation))) {
+        status = -ESTALE;
+    }
+    if (!status && !fence->cleanup_started &&
+        (physical_device_generation != qemu_crucible_ram_physical_device_generation() ||
+         physical_listener_generation != qemu_crucible_ram_physical_listener_generation() ||
+         !qemu_crucible_ram_owner_closure_current(fence->token))) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        /* End admission revokes exclusion. This exact fence retains cleanup
+         * identity; only the owner journal can authorize its consumption. */
+        struct qemu_plugin_crucible_ram_physical_end_v2 end = {
+            .schema_version = 2, .struct_size = sizeof(end),
+        };
+
+        fence->cleanup_started = true;
+        status = qemu_crucible_ram_owner_closure_end_v2(fence->token, &end);
+        fence->end = end;
+        if (end.return_complete) {
+            physical_token = 0;
+            physical_topology = 0;
+            physical_borrow_generation = 0;
+            physical_device_generation = 0;
+            physical_listener_generation = 0;
+            qatomic_store_release(&fence->held, false);
+        }
+    }
+    qatomic_store_release(&checkpoint_native_fence_cut, 0);
+    return status;
+}
+
+static int physical_owner_inventory(uint64_t *borrow_generation)
+{
+    QemuCrucibleRamBorrowInventory borrowers;
+    uint64_t count;
+    uint64_t devices = qemu_crucible_ram_physical_device_generation();
+    uint64_t listeners = qemu_crucible_ram_physical_listener_generation();
+    int status;
+
+    if (!devices || !listeners) {
+        return -EOVERFLOW;
+    }
+    qemu_crucible_ram_borrow_inventory(&borrowers);
+    if (!borrowers.paging_requested || !borrowers.consistent ||
+        borrowers.direct_maps || borrowers.bounce_maps ||
+        borrowers.direct_caches) {
+        return -EBUSY;
+    }
+    /* This token check returns only a status. Detailed admission callers keep
+     * their own error sinks; do not allocate text discarded by this check. */
+    status = qemu_crucible_ram_physical_device_inventory(&count, NULL);
+    if (!status) {
+        status = qemu_crucible_ram_physical_listener_inventory(&count, NULL);
+    }
+    if (!status && (devices != qemu_crucible_ram_physical_device_generation() ||
+                    listeners != qemu_crucible_ram_physical_listener_generation())) {
+        status = -ESTALE;
+    }
+    if (!status && borrow_generation) {
+        *borrow_generation = borrowers.generation;
+    }
+    return status;
+}
