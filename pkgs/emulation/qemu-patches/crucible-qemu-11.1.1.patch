+            have_write = true;
+        } else {
+            goto invalid;
+        }
+        if (have_overlay_stat &&
+            (current_stat.st_dev != overlay_stat.st_dev ||
+             current_stat.st_ino != overlay_stat.st_ino ||
+             current_stat.st_mode != overlay_stat.st_mode)) {
+            goto invalid;
+        }
+        overlay_stat = current_stat;
+        have_overlay_stat = true;
+    }
+    if (!have_read || !have_write || QLIST_EMPTY(&fdset->dup_fds)) {
+        goto invalid;
+    }
+
+    QLIST_FOREACH(duplicate, &fdset->dup_fds, next) {
+        struct stat duplicate_stat;
+        int flags = fcntl(duplicate->fd, F_GETFL);
+        int access_and_direct = flags & (O_ACCMODE | O_DIRECT);
+
+        if (duplicate->opaque || flags < 0 ||
+            (access_and_direct != (O_RDONLY | O_DIRECT) &&
+             access_and_direct != (O_RDWR | O_DIRECT)) ||
+            fstat(duplicate->fd, &duplicate_stat) < 0 ||
+            duplicate_stat.st_dev != overlay_stat.st_dev ||
+            duplicate_stat.st_ino != overlay_stat.st_ino ||
+            duplicate_stat.st_mode != overlay_stat.st_mode) {
