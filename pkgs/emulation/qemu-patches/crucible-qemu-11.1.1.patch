+    source_retired_delta = timers_state.crucible_rr_cursor_position;
+    timers_state.crucible_rr_current_vcpu = next->cpu_index;
+    timers_state.crucible_rr_cursor_position = 0;
+    timers_state.crucible_rr_selection_pending = true;
+    qemu_plugin_fire_rr_handoff_cb(
+        cpu->cpu_index, next->cpu_index,
+        icount_crucible_rr_switch_quantum(), source_retired_delta);
+}
