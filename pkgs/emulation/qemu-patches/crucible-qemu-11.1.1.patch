+                      &startup_source.original_record_complete));
+    g_assert_cmpmem(&original, sizeof(original),
+                    &startup_source.original, sizeof(original));
+    g_assert_cmpmem(&saved, sizeof(saved), &startup_source.saved, sizeof(saved));
+    assert_retained();
