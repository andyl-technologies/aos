+static void fingerprint_main_ready_dispatch(
+    QemuCrucibleFingerprintMainReadyFrame *frame,
+    int poll_result, int64_t timeout_ns)
+{
+    QemuCrucibleFingerprintMainExecution *execution = &fingerprint_main_execution;
+    int status;
+
+    /* Poll readiness and timeout are not capture intent or operation credit. */
+    (void)poll_result;
+    (void)timeout_ns;
+
+    status = qemu_crucible_fingerprint_main_ready_current_v1(
+        frame, execution->watcher, execution->registration_serial);
+    if (status) {
+        return;
+    }
+    if (!execution->snapshot_cycle_active) {
+        status = qemu_plugin_crucible_wake_watcher_snapshot_enter_v1(
+            execution->watcher, frame, execution->registration_serial);
+        if (status) {
+            return;
+        }
+        execution->snapshot_cycle_active = true;
+        execution->collection_returned = false;
+        execution->snapshot_born = false;
+        execution->snapshot_return_completed = false;
+        qemu_crucible_startup_source_main_ready_dispatch_v1(frame, execution);
+        /* Save real custody independently of the callback's signed result. */
+        execution->snapshot_born = execution->snapshot != NULL;
+        execution->collection_returned = true;
+    }
+
+    /* An older retained loan is returned only. A fresh poll pass never repeats
+     * its factual callback or replaces its parent/holder with a new loan. */
+    if (execution->snapshot) {
+        qemu_crucible_startup_source_fingerprint_intent_identity_return_v1(
+            frame, execution, &execution->snapshot);
+        execution->snapshot_return_completed = execution->snapshot == NULL;
+    } else if (!execution->snapshot_born) {
+        execution->snapshot_return_completed = execution->collection_returned;
+    }
+    if (!execution->snapshot_return_completed) {
+        return;
+    }
+    status = qemu_plugin_crucible_wake_watcher_snapshot_leave_v1(
+        execution->watcher, frame, execution->registration_serial);
+    if (!status) {
+        execution->snapshot_cycle_active = false;
+    }
