+
+    /* Singleton APIs carry no id. Only this real entered installing Source
+     * may select its nominal module; a callback/userdata tuple selects none. */
+    if (status || !startup_invocation(entered_id) || startup_source.install_returned) {
+        return status ? status : -EPERM;
+    }
