+        "#undef startup_failure",
+        "#undef qemu_crucible_startup_source_native_metadata_check",
+        "#undef startup_source",
+        *bodies, TESTS,
+    ]))
+    bindings = {
+        "sources": {
+            name: hashlib.sha256((args.source_root / name).read_bytes()).hexdigest()
+            for name in (
+                "plugins/crucible-paged-ram.c",
+                "plugins/crucible-startup-source.c",
+                "plugins/crucible-startup-source.h",
+                "include/plugins/qemu-plugin.h",
+                "include/qemu/crucible-paged-ram.h",
