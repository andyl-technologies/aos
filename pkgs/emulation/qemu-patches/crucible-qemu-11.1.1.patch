+int qemu_plugin_crucible_startup_hello_transfer_v1(
+    qemu_plugin_id_t id, QemuCrucibleStartupRuntimePurpose *runtime,
+    QemuCrucibleSetupHandshakeOwner **from, QemuCrucibleSetupHandshakeOwner **to)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleSetupHandshakeOwner *owner = &startup_source.setup_handshake;
+    int status = setup_handshake_identity(id, owner);
+
+    if (!status) {
+        status = setup_owned_runtime_field_current(id, runtime, to);
+    }
+    if (status) {
+        return status;
+    }
+    if (!from || from == to || owner->transferred || owner->write_active ||
+        owner->read_active || owner->holder != &owner->creation_owner ||
+        owner->creation_owner != owner || *from != owner || *to) {
+        return -ESTALE;
+    }
+    *to = owner;
+    owner->creation_owner = NULL;
+    *from = NULL;
+    owner->holder = to;
+    owner->runtime = runtime;
+    owner->transferred = true;
+    /* The real move is complete before this independent installing post. */
+    status = setup_handshake_original_current(owner, NULL);
+    if (status) {
+        crucible_metadata_partition_record_post(&startup_source.metadata_partition, status);
+    }
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
