+     * No callback, new Original, clock or baseline publication occurs here. */
+    status = standing_boundary();
+    operation->return_status = status;
+    if (status && !startup_source.standing.return_first_status) {
+        startup_source.standing.return_first_status = status;
+    }
+    if (status && !operation->return_first_status) {
