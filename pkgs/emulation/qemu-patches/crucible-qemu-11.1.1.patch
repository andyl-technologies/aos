+/* This reciprocal is entered only by the real preexec recipient constructor.
+ * Exact output addresses are selected before any proposed publication is read.
+ * The caller's retained session journal, not matching coordinates, owns CAS. */
+int qemu_crucible_source_advance_recipient_cut_v1(
+    QemuCrucibleSourceAdvanceReceiver *receiver,
+    QemuCruciblePublisherSessionLender *lender,
+    QemuCruciblePublisherRecipient **holder,
+    const QemuCruciblePublisherPublicationView *publication, int publication_ready)
+{
+#if defined(CONFIG_LINUX) && defined(__x86_64__) && !defined(__ILP32__)
+    int status = advance_receiver_identity(receiver);
+
+    if (status) {
+        return status;
+    }
+    if (lender != receiver->lender || holder != &receiver->recipient ||
+        publication != &receiver->publication ||
+        (publication_ready != 0 && publication_ready != 1) ||
+        receiver->acquire_entered || receiver->main_returned || receiver->uncertain) {
+        return -EPERM;
+    }
+    status = qemu_plugin_crucible_native_advance_entry_current_v1(
+        receiver->main, receiver->control);
+    if (!status && publication_ready) {
+        status = advance_publication_current(receiver);
+    }
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
