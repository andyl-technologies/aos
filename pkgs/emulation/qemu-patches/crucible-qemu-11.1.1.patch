+     * A completed unref is separate from saved acquisition/current statuses. */
+    return owner->returning_qom_owner == allocation && owner->qom_returned &&
+        !owner->transition_active && !owner->borrow_held && !owner->read.held &&
+        owner->physical_returned && !owner->mapped && !owner->charge.held &&
+        allocation->register_workspace == owner &&
+        allocation->constructor_children &&
+        (allocation->register_workspace_parent ? owner->pinned_children != 0 :
+            !owner->pinned_children && owner->pinned_cpus != 0);
