+                char prepare_trace[64];
+                snprintf(prepare_trace, sizeof(prepare_trace), "GL%s", limit_trace);
+                expect_trace(prepare_trace);
+                cases++;
+            }
+        }
+    }
+    assert(cases == 102);
+    puts("PASS production accel classification: 102 none/sim/tcg/concrete/arbitrary-name, inheritance and precise/adaptive/off cases retain exact query order, budgets and timer effects");
+}
+
+static void deadline_and_hot_queries(void)
+{
+    bool allowed = false;
+    AccelClass klass = { .name = "sim", .allowed = &allowed,
+                          .init_machine = init_callback };
+    AccelState accel = { .parent_obj.klass = &klass };
+    MachineState machine = { 0 };
+    initialize(&accel, &machine, true, 0);
+    use_icount = ICOUNT_PRECISE;
+    virtual_deadline = 0;
+    clear_trace();
+    assert(icount_percpu_budget(2) == 0);
+    expect_trace("GVGJHGVGE");
+    CPUState cpu = { 0 };
+    icount_prepare_for_run_locked(&cpu, 4, true);
+    assert(cpu.icount_budget == 0 && cpu.icount_extra == 0);
+    expect_trace("GGVGEBAb");
+
+    realtime_deadline = 0;
+    for (int mode = ICOUNT_DISABLED; mode <= ICOUNT_ADAPTATIVE; mode++) {
+        if (mode == ICOUNT_PRECISE) {
+            continue;
+        }
+        use_icount = mode;
+        assert(icount_percpu_budget(2) == 3);
+        expect_trace("VGERNOOGJHVGERNOOGE");
+        CPUState ordinary = { 0 };
+        icount_prepare_for_run_locked(&ordinary, 4, true);
+        assert(ordinary.icount_budget == 4);
+        assert(ordinary.neg.icount_decr.u16.low == 4);
+        assert(ordinary.icount_extra == 0);
+        expect_trace("GVGERNOOGE");
+    }
+    realtime_deadline = 100;
+    use_icount = ICOUNT_PRECISE;
+
+    crucible_rr_switch_quantum = 0;
+    assert(!crucible_vcpu_service_mode());
+    expect_trace("GEG");
+    assert(!crucible_sim_preemption_mode());
+    expect_trace("GEG");
+    crucible_rr_switch_quantum = 5;
+
+    replay_mode = REPLAY_MODE_PLAY;
+    assert(icount_get_limit() == 9);
+    expect_trace("Y");
+    replay_mode = 0;
+    virtual_deadline = -1;
+    assert(icount_get_limit() == INT32_MAX);
+    expect_trace("GV");
+    virtual_deadline = 2000;
+
+    unsigned int old_classes = class_reads, old_names = name_reads;
+    unsigned int old_observations = observation_reads;
+    observed_tick = INT64_MAX;
+    crucible_node_rules = &unused_index;
+    gpa_index.len = 1;
+    recording = false;
+    for (unsigned int query = 0; query < 10000; query++) {
+        assert(current_accel_is_sim());
+        assert(icount_crucible_sim_mode());
+        assert(rr_crucible_sim_mode());
+        assert(crucible_clock_mode());
+        assert(crucible_lifecycle_mode());
+        assert(crucible_vcpu_service_mode());
+        assert(crucible_sim_preemption_mode());
+        assert(qemu_crucible_fault_memory_rules_active());
+        rr_start_kick_timer();
+        assert(qemu_plugin_sim_tick_observed() == INT64_MAX);
+    }
+    recording = true;
+    assert(class_reads == old_classes && name_reads == old_names);
+    assert(observation_reads == old_observations + 10000);
+    assert(!memcmp(current_accel_name(), "sim", sizeof("sim")));
+    expect_trace("Q");
+    assert(class_reads == old_classes + 1 && name_reads == old_names);
+    puts("PASS production accel classification: zero-deadline/replay paths and 90000 hot calls retain effects without repeated QOM casts or name comparisons");
+    puts("PASS production tick observation API: safe early/nameless getter contract, all named modes, retry/reset/restore/fork identity, exact mode/icount/observation counts and order, signed edge ticks and 10000 hot observations");
+}
