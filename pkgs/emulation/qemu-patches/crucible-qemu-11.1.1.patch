+int qemu_plugin_register_time_advance_cb(qemu_plugin_time_advance_cb_t cb,
+                                         void *userdata)
+{
+    QemuCrucibleNativeGroupRegistrar registrar;
+    QemuCrucibleNativeGroupDescriptorView actual;
+    const QemuCrucibleNativeGroupDescriptorView expected = {
+        .coordinate = &qemu_plugin_time_advance_cb,
+        .function = cb,
+        .userdata = userdata,
+        .userdata_coordinate = &qemu_plugin_time_advance_userdata,
+        .kind = QEMU_CRUCIBLE_NATIVE_REGISTERED,
+    };
+    int status = qemu_plugin_crucible_native_group_begin_v1(
+        QEMU_CRUCIBLE_NATIVE_GROUP_TIME_ADVANCE, &expected, 1, &registrar);
+
+    if (!status && qatomic_read(&qemu_plugin_time_advance_pending)) {
+        status = -EBUSY;
+    }
+    if (!status && cb && strcmp(current_accel_name(), "sim") != 0) {
+        status = -EPERM;
+    }
+    qemu_plugin_crucible_native_group_refuse_v1(&registrar, status);
+    if (status || qemu_plugin_crucible_native_group_effect_begin_v1(&registrar)) {
+        return qemu_plugin_crucible_native_group_finish_v1(&registrar);
+    }
+
+    qemu_plugin_crucible_native_group_member_attempt_v1(&registrar, 0);
+    qemu_plugin_crucible_native_registration_release_v1(
+        native_callback_registrations.time_advance);
+    qatomic_store_release(&native_callback_registrations.time_advance,
+        qemu_plugin_crucible_native_group_member_v1(&registrar, 0));
+    qemu_plugin_time_advance_userdata = userdata;
+    qemu_plugin_time_advance_cb = cb;
+    qemu_plugin_crucible_native_time_advance_descriptor_observe_v1(0, &actual);
+    qemu_plugin_crucible_native_group_member_installed_v1(&registrar, 0, &actual);
+    qemu_plugin_crucible_native_group_effect_end_v1(&registrar);
+    status = qemu_plugin_crucible_native_group_finish_v1(&registrar);
+    if (cb) {
+        qemu_plugin_crucible_callback_registered(
+            0, QEMU_PLUGIN_CRUCIBLE_CALLBACK_TIME_ADVANCE);
+    }
+    return status;
+}
