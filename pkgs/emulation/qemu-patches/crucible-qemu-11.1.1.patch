+    qemu_put_byte(f, smb->smb_auxctl);
+    qemu_put_byte(f, smb->smb_blkdata);
+    qemu_put_byte(f, smb->i2c_enable);
+    qemu_put_byte(f, smb->op_done);
+    qemu_put_byte(f, smb->in_i2c_block_read);
+    qemu_put_byte(f, smb->start_transaction_on_status_read);
