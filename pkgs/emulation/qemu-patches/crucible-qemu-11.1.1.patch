+static int import_ordinary(const char *path, unsigned kind)
+{
+    LoongArchCPU cpu = { 0 };
+    GByteArray *bytes;
+    gchar *contents;
+    gsize length;
+    int status;
+
+    initialize_clock(false);
+    initialize_timer(&cpu);
+    g_assert_true(g_file_get_contents(path, &contents, &length, NULL));
+    bytes = g_byte_array_new_take((guint8 *)contents, length);
+    env_sys(&cpu.env)->CSR_TVAL = 123;
+    if (kind == 6) {
+        observed_ps = (__int128)INT64_MIN * 1000;
+    }
+    status = load_state(&timer_fixture, &cpu, bytes);
+    if (kind == 0 || kind == 2 || kind == 4 || kind == 5 || kind == 7) {
+        uint64_t expected_ticks = 0;
+
+        if (kind == 0) {
+            expected_ticks = 15;
+        } else if (kind == 7) {
+            expected_ticks = CONSTANT_TIMER_TICK_MASK;
+        }
+        g_assert_cmpint(status, ==, 0);
+        g_assert_false(timer_pending(&cpu.timer));
+        g_assert_cmpuint(env_sys(&cpu.env)->CSR_TVAL, ==, expected_ticks);
+    } else {
+        g_assert_cmpint(status, <, 0);
+        g_assert_false(timer_pending(&cpu.timer));
+    }
+
+    destroy_timer(&cpu);
+    g_byte_array_unref(bytes);
+    return 0;
+}
