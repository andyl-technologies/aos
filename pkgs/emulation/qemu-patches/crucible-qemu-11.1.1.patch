+static void scenario_action_same_birth_masks_are_monotone(void)
+{
+    uint8_t wire[QEMU_CRUCIBLE_ACTION_BYTES];
+    QemuCrucibleBoundaryActionRecord before;
+    QemuCrucibleBoundaryActionRecord after;
+
+    fixture_action_wire(wire);
+    g_assert_cmpint(qemu_crucible_boundary_action_decode_v2(
+        wire, sizeof(wire), &before), ==, 0);
+    after = before;
+    after.dirty = true;
+    after.projected_mask = 0;
+    memset(after.rows, 0, sizeof(after.rows));
+
+    /* A dirty observation cannot erase first-projected identity, then restore
+     * different facts under the same publisher birth. Cache is no authority. */
+    g_assert_cmpint(standing_action_snapshot_validate(&before, &after, 2), ==, -ESTALE);
+    after = before;
+    after.born_mask = 0;
+    g_assert_cmpint(standing_action_snapshot_validate(&before, &after, 2), ==, -ESTALE);
+    after = before;
+    after.dirty = true;
+    g_assert_cmpint(standing_action_snapshot_validate(&before, &after, 2), ==, 0);
+    after.rows[0].original_start_ns++;
+    g_assert_cmpint(standing_action_snapshot_validate(&before, &after, 2), ==, -ESTALE);
+}
