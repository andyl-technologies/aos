+int main(int argc, char **argv)
+{
+    const char *scenario = argc > 1 ? argv[1] : "payload-healthy";
+    bool legacy = !strcmp(scenario, "payload-v2-unavailable");
+    bool borrowed = !strcmp(scenario, "payload-module-borrow");
+    int status;
+
+    prepare_payload(legacy);
+    reader_failure = !strcmp(scenario, "payload-reader-negative") ? -EIO : 0;
+    claim_failure = !strcmp(scenario, "payload-claim-negative") ? -ECANCELED :
+        !strcmp(scenario, "payload-claim-refused-empty") ? -EAGAIN : 0;
+    release_failure = !strcmp(scenario, "payload-release-negative") ? -EAGAIN : 0;
+    partial_claim = !strcmp(scenario, "payload-partial");
+    empty_claim = !strcmp(scenario, "payload-empty") ||
+        !strcmp(scenario, "payload-claim-refused-empty");
+    contradict_release = !strcmp(scenario, "payload-release-contradiction");
+    claim_post_failure = !strcmp(scenario, "payload-claim-post");
+    release_post_failure = !strcmp(scenario, "payload-release-post");
+    callback_reentry = !strcmp(scenario, "payload-reentrant");
+    receive_request();
+    g_assert_true(actual_child.owned);
+    g_assert_cmpuint(actual_child.pending.value, ==, 0x93);
+    create_delivery();
+    g_assert_cmpint(DELIVERY(payload_claim)(1, creation, delivery_serial + 1), ==, -ESTALE);
+    g_assert_cmpuint(claim_calls, ==, 0);
+    g_assert_cmpint(DELIVERY(payload_return)(1, creation, delivery_serial), ==, -ENOENT);
+    g_assert_cmpint(DELIVERY(use_begin)(1, creation, delivery_serial, &use, &use_serial), ==, 0);
+    g_assert_cmpint(DELIVERY(payload_claim)(1, creation, delivery_serial), ==, legacy ? -ENOTSUP : -EBUSY);
+    g_assert_cmpuint(claim_calls, ==, 0);
+    g_assert_cmpint(DELIVERY(use_return)(1, &use, use_serial), ==, 0);
+    status = DELIVERY(payload_claim)(1, creation, delivery_serial);
+    g_assert_cmpint(status, ==, legacy ? -ENOTSUP : claim_failure ? claim_failure :
+                    partial_claim || empty_claim ? -EPROTO : claim_post_failure ? -EIO : 0);
+    if (legacy) {
+        g_assert_cmpuint(claim_calls, ==, 0);
+        g_assert_cmpint(DELIVERY(identity_return)(1, &creation, delivery_serial), ==, 0);
+        g_assert_true(actual_child.owned);
+        return 0;
+    }
+    g_assert_cmpuint(claim_calls, ==, 1);
+    if (empty_claim && claim_failure) {
+        g_assert_false(creation->payload_held);
+        g_assert_false(creation->payload_uncertain);
+        g_assert_cmpint(DELIVERY(identity_return)(1, &creation, delivery_serial), ==, 0);
+        g_assert_true(actual_child.owned);
+        g_assert_null(actual_child.holder);
+        g_assert_cmpint(RECEIVE(identity_return)(1, &receive, receive_serial), ==, -ENOKEY);
+        g_assert_nonnull(receive);
+        return 0;
+    }
+    g_assert_cmpint(DELIVERY(payload_claim)(1, creation, delivery_serial), ==, -EBUSY);
+    g_assert_cmpint(DELIVERY(identity_return)(1, &creation, delivery_serial), ==, -EBUSY);
+    g_assert_nonnull(creation);
+    if (partial_claim || empty_claim) {
+        g_assert_true(creation->payload_uncertain);
+        g_assert_cmpint(DELIVERY(payload_return)(1, creation, delivery_serial), ==, -EBUSY);
+        g_assert_true(actual_child.owned);
+        g_assert_cmpuint(release_calls, ==, 0);
+        return 0;
+    }
+    g_assert_true(creation->payload_held);
+    g_assert_true(actual_child.holder == &creation->payload);
+    QemuCrucibleModuleRequestPayload *copy = creation->payload;
+    bool reenter = callback_reentry;
+
+    callback_reentry = false;
+    g_assert_cmpint(module_release(&copy, creation->payload_serial, &actual_child), ==, -ESTALE);
+    g_assert_true(copy == creation->payload);
+    g_assert_cmpint(module_release(&creation->payload, creation->payload_serial + 1,
+                                  &actual_child), ==, -ESTALE);
+    g_assert_true(actual_child.owned);
+    callback_reentry = reenter;
+    use_serial = 0;
+    g_assert_cmpint(DELIVERY(use_begin)(1, creation, delivery_serial, &use, &use_serial), ==, 0);
+    unsigned int before = release_calls;
+
+    g_assert_cmpint(DELIVERY(payload_return)(1, creation, delivery_serial), ==, -EBUSY);
+    g_assert_cmpuint(release_calls, ==, before);
+    g_assert_cmpint(DELIVERY(use_return)(1, &use, use_serial), ==, 0);
+    if (borrowed) {
+        qemu_mutex_lock(&actual_child.journal);
+    }
+    status = DELIVERY(payload_return)(1, creation, delivery_serial);
+    g_assert_cmpint(status, ==, borrowed ? -EBUSY : release_failure ? release_failure :
+                    contradict_release ? -EPROTO : release_post_failure ? -EIO : 0);
+    if (borrowed) {
+        qemu_mutex_unlock(&actual_child.journal);
+    }
+    if (borrowed || release_failure || contradict_release) {
+        g_assert_true(actual_child.owned);
+        g_assert_nonnull(creation->payload);
+        g_assert_cmpuint(destruction_calls, ==, 0);
+        g_assert_cmpint(DELIVERY(identity_return)(1, &creation, delivery_serial), ==, -EBUSY);
+        if (contradict_release) {
+            g_assert_true(creation->payload_uncertain);
+            return 0;
+        }
+        release_failure = 0;
+        g_assert_cmpint(DELIVERY(payload_return)(1, creation, delivery_serial), ==,
+                        borrowed ? -EBUSY : -EAGAIN);
+    }
+    g_assert_false(actual_child.owned);
+    g_assert_cmpuint(actual_child.pending.value, ==, 0);
+    g_assert_cmpuint(destruction_calls, ==, 1);
+    g_assert_null(creation->payload);
+    g_assert_false(creation->payload_held);
+    g_assert_true(creation->payload_returned);
+    before = release_calls;
+    g_assert_cmpint(DELIVERY(payload_return)(1, creation, delivery_serial), ==,
+                    borrowed ? -EBUSY : !strcmp(scenario, "payload-release-negative") ? -EAGAIN :
+                    release_post_failure ? -EIO : 0);
+    g_assert_cmpuint(release_calls, ==, before);
+    /* Consumption is independent of callback/post diagnostics. Pure local
+     * lifetime return must succeed after actual destruction, even on EIO post. */
+    g_assert_cmpint(DELIVERY(identity_return)(1, &creation, delivery_serial), ==, 0);
+    g_assert_null(creation);
+    g_assert_cmpuint(receive->delivery_users, ==, 0);
+    g_assert_cmpint(RECEIVE(identity_return)(1, &receive, receive_serial), ==, -ENOKEY);
+    g_assert_nonnull(receive);
+    puts("PASS module payload custody: actual child journal, canonical claim/destruction; no publisher return");
+    return 0;
+}
