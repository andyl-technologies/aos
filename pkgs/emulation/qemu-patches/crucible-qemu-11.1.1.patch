+    g_assert_cmpint(preexec_setup_receive_once(), ==, expected);
+    g_assert_cmpint(preexec_setup_owner.first_status, ==, expected);
+    g_assert_false(preexec_setup_owner.frame_validated);
+    fixture_assert_borrow_refused(expected);
+    if (strcmp(kind, "empty") && strcmp(kind, "type") &&
+        strcmp(kind, "eof")) {
+        g_assert_cmpmem(preexec_setup_owner.frame, bytes, fixture.frame, bytes);
+        fixture_assert_aliases(&fixture,
+            MIN(count, QEMU_CRUCIBLE_PREEXEC_SETUP_WORKSPACE_FDS));
