+int qemu_plugin_crucible_native_main_control_begin_v1(
+    QemuCrucibleNativeGroupUse *use, CPUState *cpu,
+    QemuCrucibleNativeInvocationTicket *holder)
+{
+#if defined(CONFIG_LINUX) && !defined(CONFIG_USER_ONLY)
+    QemuCrucibleNativeRegistration *record = use ? use->record : NULL;
+    QemuCrucibleNativeInvocationRegistry *registry;
+    QemuCrucibleNativeRegistrationGroup *group;
+    QemuCrucibleCpuSourceAllocationOwner *owner = NULL;
+    QemuCrucibleCpuAllocationReceipt *receipt = NULL;
+    QemuCrucibleNativeInvocation *frame = NULL;
