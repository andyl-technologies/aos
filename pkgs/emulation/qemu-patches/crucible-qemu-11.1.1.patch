+    g_assert_cmpint(qemu_plugin_crucible_startup_source_registration_complete_v1(
+                       fixture.ctx.id, 0), ==, 0);
+    g_assert_cmpint(plugin_startup_source_install_leave(&fixture.ctx, 0), ==, 0);
