+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Check literal inline registry return under real initialized QEMU BQL.
+
+Literal BQL/TLS mutex bodies and factual row/frame observers execute. No Source owner, allocation
+receipt, callback lease or operation permission is issued by this fixture.
+"""
+
+import argparse
+import json
+import os
+from pathlib import Path
+import runpy
+import shlex
+import subprocess
+
+
+CHECKS = r'''
+int main(void)
+{
+    Error *error = NULL;
+    QemuCrucibleClockStorage storage[3] = { 0 };
+    static const char *names[] = { "z", "a", "m" };
+
+    qemu_init_main_loop(&error);
+    assert(!error);
+    qemu_mutex_init(&bql);
+    bql_lock();
+    assert(bql_locked());
+    crucible_clock_bindings_sealed = true;
+    assert(!crucible_clock_storage_unregister(&storage[0]));
+    crucible_clock_bindings_sealed = false;
+    QEMUTimer timer = { 0 };
+    QemuCrucibleTimerCallbackFrame frame = {
+        .timer = &timer, .callback = apic_timer, .serial = 1,
+        .process = getpid(),
+    };
+    qemu_thread_get_self(&frame.thread);
+    crucible_timer_callback_dispatch.current = &frame;
+    assert(!component_timer_frame_current(&frame, &timer, apic_timer, NULL, false));
+    frame.returned = true;
+    assert(component_timer_frame_current(&frame, &timer, apic_timer, NULL, false));
+    frame.returned = false;
+    frame.entered = true;
+    assert(component_timer_frame_current(&frame, &timer, apic_timer, NULL, false));
+    frame.returned = true;
+    assert(!component_timer_frame_current(&frame, &timer, apic_timer, NULL, true));
+    frame.entered = frame.returned = false;
+#define REFUSE_FRAME(field, value) do { \
+    QemuCrucibleTimerCallbackFrame saved = frame; \
+    frame.field = value; \
+    assert(component_timer_frame_current(&frame, &timer, apic_timer, NULL, false)); \
+    frame = saved; \
+} while (0)
+    REFUSE_FRAME(process, frame.process + 1);
+    REFUSE_FRAME(serial, 0);
+    REFUSE_FRAME(timer, NULL);
+    REFUSE_FRAME(source, &timer);
+    REFUSE_FRAME(callback, NULL);
+    REFUSE_FRAME(opaque, &timer);
+    crucible_timer_callback_dispatch.current = NULL;
+    assert(component_timer_frame_current(&frame, &timer, apic_timer, NULL, false));
+    for (unsigned index = 0; index < 3; index++) {
+        QemuCrucibleClockSourceDescriptor input = descriptor(index, names[index]);
+
+        assert(!crucible_clock_source_register_into(&input, &storage[index]));
+        assert(!qemu_crucible_fault_clock_storage_current_v1(&storage[index], true));
+        assert(qemu_crucible_fault_clock_storage_current_v1(&storage[index], false));
+    }
+    crucible_clock_bindings_sealed = true;
+    assert(crucible_clock_storage_unregister(&storage[0]) == -EBUSY);
+    assert(!qemu_crucible_fault_clock_storage_current_v1(&storage[0], true));
+    crucible_clock_bindings_sealed = false;
+    /* Populate actual atomic hints before removal. Every residual reference
+     * must independently prevent the post from reporting physical removal. */
+    for (unsigned index = 0; index < 3; index++) {
+        assert(crucible_clock_source_by_kind(QEMU_CRUCIBLE_CLOCK_X86_TSC,
+                                             index) == (void *)storage[index].row);
+    }
+    for (unsigned index = 0; index < 3; index++) {
+        assert(!crucible_clock_storage_unregister(&storage[index]));
+        assert(!qemu_crucible_fault_clock_storage_current_v1(&storage[index], false));
+        assert(qemu_crucible_fault_clock_storage_current_v1(&storage[index], true));
+    }
+    assert(!crucible_clock_registry.len && !crucible_clock_registry.first &&
+           !crucible_clock_registry.last);
+    bql_unlock();
+    puts("PASS literal inline row removal/post with real BQL; no Source owner or owned callback");
+    return 0;
+}
+'''
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    args = parser.parse_args()
+    root = Path(__file__).resolve().parents[2]
+    output = args.output_dir.resolve()
+    output.mkdir(parents=True, exist_ok=True)
+    registry = runpy.run_path(str(root / "tests/unit/test-crucible-clock-canonical-rows.py"))
+    timer = runpy.run_path(str(root / "tests/unit/test-crucible-apic-timer-storage.py"))
+    function = registry["function"]
+    source = (root / "plugins/crucible-fault-clock.c").read_text()
+    types = source[source.index("enum CrucibleClockSourceState {"):
+                   source.index("static bool crucible_clock_registered;")]
+    bodies = "\n".join(function(source, signature) for signature in (
+        "static bool crucible_clock_lookup_step_bounded(",
+        "static unsigned crucible_clock_lookup_bucket(",
+        "static CrucibleClockSource *crucible_clock_source_by_kind(",
+        "static int crucible_clock_source_register_into(",
+        "static int crucible_clock_storage_unlink(",
+        "static int crucible_clock_storage_current_locked(",
+        "int qemu_crucible_fault_clock_storage_current_v1(",
+        "static int crucible_clock_storage_unregister("))
+    cpus = (root / "system/cpus.c").read_text()
+    # Actual BQL mutex/TLS bodies replace libqemuutil's deliberate unit-test
+    # no-op BQL stub. This is a real lock, not callback/provider admission.
+    bql = ('static QemuMutex bql;\n'
+           'QEMU_DEFINE_STATIC_CO_TLS(bool, bql_locked)\n'
+           'static uint32_t bql_unlock_blocked;\n')
+    bql += "\n".join(function(cpus, signature) for signature in (
+        "bool mutex_is_bql(", "void bql_update_status(",
+        "void bql_block_unlock(", "bool bql_locked(",
+        "void bql_lock_impl(", "void bql_unlock("))
+    prefix = (timer["PREFIX"] + '#include "qemu/atomic.h"\n'
+              '#define CRUCIBLE_CLOCK_MAX_SOURCES 4096\n'
+              '#define CRUCIBLE_CLOCK_LOOKUP_BUCKETS 256\n'
+              '#define crucible_clock_mode() false\n'
+              '#include "qemu/coroutine-tls.h"\n'
+              '#define CLOCK_LOCK_OBSERVE() assert(!g_mutex_trylock(&crucible_clock_registry.lookup_lock))\n' + bql)
+    timer_source = (root / "util/qemu-timer.c").read_text()
+    dispatch_start = timer_source.index("static struct {\n    QemuCrucibleTimerCallbackFrame *current;")
+    dispatch_end = timer_source.index("uint64_t qemu_crucible_timer_callback_fixed_storage_bytes_v1", dispatch_start)
+    timer_bodies = timer_source[dispatch_start:dispatch_end]
+    timer_bodies += function(timer_source,
+        "int qemu_crucible_timer_callback_frame_current_v1(").replace(
+            "qemu_crucible_timer_callback_frame_current_v1", "component_timer_frame_current")
+    bodies += timer_bodies
+    lock_line = "    g_mutex_lock(&crucible_clock_registry.lookup_lock);"
+    bodies = bodies.replace(lock_line, lock_line + "\n    CLOCK_LOCK_OBSERVE();")
+    descriptor = function(registry["CHECKS"],
+                          "static QemuCrucibleClockSourceDescriptor descriptor(")
+    omissions = {
+        "lookup-reference": "        *link = source->lookup_next;",
+        "previous-next": "            source->previous->next = source->next;",
+        "next-previous": "            source->next->previous = source->previous;",
+        "head": "            crucible_clock_registry.first = source->next;",
+        "tail": "            crucible_clock_registry.last = source->previous;",
+        "count": "        crucible_clock_registry.len--;",
+        "links": "        source->next = source->previous = source->lookup_next = NULL;",
+        "hint": "            qatomic_set(&crucible_clock_registry.lookup[index].tsc_hint, NULL);",
+    }
+    for name, token in {
+        "frame-nominal": "crucible_timer_callback_dispatch.current != frame ||",
+        "frame-process": "frame->process != getpid() ||",
+        "frame-serial": "!frame->serial ||",
+        "frame-timer": "frame->timer != timer ||",
+        "frame-source": "frame->source ||",
+        "frame-callback": "frame->callback != callback ||",
+        "frame-opaque": "frame->opaque != opaque ||",
+        "frame-return": "frame->returned != returned ||",
+        "frame-entry": "frame->entered != returned",
+    }.items():
+        omissions[name] = token
+    lock_omissions = {
+        "cold-walk-lock": "static CrucibleClockSource *crucible_clock_source_by_kind(",
+        "publication-lock": "static int crucible_clock_source_register_into(",
+        "unlink-lock": "static int crucible_clock_storage_unlink(",
+        "post-walk-lock": "int qemu_crucible_fault_clock_storage_current_v1(",
+    }
+    omissions.update({name: lock_line for name in lock_omissions})
+    results = {}
+    for name in ["positive", *omissions]:
+        literal = bodies
+        if name != "positive":
+            before = omissions[name]
+            if name in lock_omissions:
+                at = literal.index(lock_omissions[name])
+                literal = literal[:at] + literal[at:].replace(before, "", 1)
+            else:
+                assert literal.count(before) == 1, name
+                literal = literal.replace(before, "false" if name == "frame-entry" else "", 1)
+        generated = output / (name + ".c")
+        binary = generated.with_suffix("")
+        generated.write_text(prefix + types + literal + descriptor + CHECKS)
+        command = [*shlex.split(os.environ["CC"]),
+                   *shlex.split(os.environ["CFLAGS"]), str(generated),
+                   "-ffunction-sections", "-fdata-sections", "-Wl,--gc-sections",
+                   "-o", str(binary), *shlex.split(os.environ["LDFLAGS"])]
+        (output / (name + ".command.json")).write_text(json.dumps(command, indent=2))
+        result = subprocess.run(command, capture_output=True, text=True)
+        (output / (name + ".compile.log")).write_text(result.stdout + result.stderr)
+        if result.returncode:
+            raise RuntimeError(f"{name} compile failed: {result.stderr}")
+        result = subprocess.run([str(binary)], capture_output=True, text=True)
+        (output / (name + ".run.log")).write_text(result.stdout + result.stderr)
+        results[name] = result.returncode
+        if (name == "positive") != (result.returncode == 0):
+            raise RuntimeError(f"{name} unexpected result: {result.stdout}{result.stderr}")
+        if name != "positive" and (result.returncode != -6 or
+                (
+                    "g_mutex_trylock" if name in lock_omissions else
+                    "component_timer_frame_current" if name.startswith("frame-") else
+                    "qemu_crucible_fault_clock_storage_current_v1(&storage[index], false)"
+                ) not in result.stderr):
+            raise RuntimeError(f"{name} missed actual independent removal observer")
+        print(name, result.returncode, result.stdout.strip(), flush=True)
+    (output / "results.json").write_text(json.dumps(results, indent=2) + "\n")
+
+
+if __name__ == "__main__":
+    main()
