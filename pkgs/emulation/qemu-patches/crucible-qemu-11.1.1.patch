+int main(int argc, char **argv)
+{
+    program_path = argv[0];
+    if (argc == 4 && !strcmp(argv[1], "--import-ordinary")) {
+        return import_ordinary(argv[2], strtoul(argv[3], NULL, 10));
+    }
+    g_test_init(&argc, &argv, NULL);
+    for (unsigned i = 0; i < ARRAY_SIZE(counter_cases); i++) {
+        char *name = g_strdup_printf("/arm/counter/%u", i);
+
+        g_test_add_data_func(name, &counter_cases[i], test_counter);
+        g_free(name);
+    }
+    for (unsigned i = 0; i < 6; i++) {
+        char *name = g_strdup_printf("/arm/deadline/%u", i);
+
+        g_test_add_data_func(name, GUINT_TO_POINTER(i), test_deadline);
+        g_free(name);
+    }
+    for (unsigned i = 0; i < 6; i++) {
+        char *name = g_strdup_printf("/arm/migration/%u", i);
+
+        g_test_add_data_func(name, GUINT_TO_POINTER(i), test_migration);
+        g_free(name);
+    }
+    for (unsigned i = 0; i < 9; i++) {
+        char *name = g_strdup_printf("/arm/malformed/%u", i);
+
+        g_test_add_data_func(name, GUINT_TO_POINTER(i), test_malformed);
+        g_free(name);
+    }
+    for (unsigned i = 0; i < 2; i++) {
+        char *name = g_strdup_printf("/arm/range/%u", i);
+
+        g_test_add_data_func(name, GUINT_TO_POINTER(i), test_range);
+        g_free(name);
+    }
+    for (unsigned i = 0; i < 5; i++) {
+        char *name = g_strdup_printf("/arm/cross-mode/%u", i);
+
+        g_test_add_data_func(name, GUINT_TO_POINTER(i), test_cross_mode);
+        g_free(name);
+    }
+    g_test_add_func("/arm/comparator", test_comparator);
+    g_test_add_func("/arm/ordinary-scale", test_ordinary_scale);
+    g_test_add_func("/arm/without-wfxt", test_without_wfxt);
+    g_test_add_func("/arm/timeout", test_timeout);
+    g_test_add_func("/arm/pmu-deadline", test_pmu_deadline);
+    g_test_add_func("/arm/ordinary", test_ordinary);
+    return g_test_run();
+}
diff --git a/tests/unit/test-crucible-bounded-thread.c b/tests/unit/test-crucible-bounded-thread.c
new file mode 100644
index 0000000000000000000000000000000000000000..b118eb4dcf2989aee45533c8a7b886a471366381
--- /dev/null
+++ b/tests/unit/test-crucible-bounded-thread.c
@@ -0,0 +1,400 @@
+/*
+ * Real bounded birth and native registry enrollment component controls.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * These exercise qemuutil's actual pthread/registry implementation. A test
+ * owner is not a Source issuer, role claim, metadata lender or fork grant.
+ */
+#include "qemu/osdep.h"
+#include "qemu/thread.h"
+#include <sys/mman.h>
+#include <sys/wait.h>
+
+#define BOUNDED_TEST_STACK_BYTES (1024 * 1024)
+
+typedef struct BoundedOwner {
+    QemuThread thread;
+    QemuThreadBoundedCreateReceipt birth;
+    pthread_mutex_t lock;
+    pthread_cond_t wake;
+    void *stack;
+    bool entered;
+    bool release;
+    bool use_tsd;
+    bool tsd_entered;
+    bool tsd_release;
+    int self_status;
+    int newborn_current_status;
+    struct BoundedOwner *probe_target;
+    int probe_current_status;
+} BoundedOwner;
+
+static pthread_key_t bounded_test_key;
+
+static void owner_wait(BoundedOwner *owner, bool *condition)
+{
+    struct timespec deadline;
+
+    g_assert_cmpint(clock_gettime(CLOCK_REALTIME, &deadline), ==, 0);
+    deadline.tv_sec += 10;
+    while (!*condition) {
+        g_assert_cmpint(pthread_cond_timedwait(&owner->wake, &owner->lock,
+                                              &deadline), ==, 0);
+    }
+}
+
+static void owner_init(BoundedOwner *owner)
+{
+    *owner = (BoundedOwner) { 0 };
+    g_assert_cmpint(pthread_mutex_init(&owner->lock, NULL), ==, 0);
+    g_assert_cmpint(pthread_cond_init(&owner->wake, NULL), ==, 0);
+    owner->stack = mmap(NULL, BOUNDED_TEST_STACK_BYTES, PROT_READ | PROT_WRITE,
+                        MAP_PRIVATE | MAP_ANONYMOUS | MAP_STACK, -1, 0);
+    g_assert_true(owner->stack != MAP_FAILED);
+}
+
+static void owner_dispose(BoundedOwner *owner)
+{
+    g_assert_true(owner->birth.identity_returned);
+    g_assert_cmpint(munmap(owner->stack, BOUNDED_TEST_STACK_BYTES), ==, 0);
+    g_assert_cmpint(pthread_cond_destroy(&owner->wake), ==, 0);
+    g_assert_cmpint(pthread_mutex_destroy(&owner->lock), ==, 0);
+}
+
+static void *bounded_entry(void *opaque)
+{
+    BoundedOwner *owner = opaque;
+
+    /* The real newborn must refuse the creator API even if it runs before
+     * pthread_create publishes its output; self_current uses its actual row. */
+    owner->newborn_current_status = qemu_thread_bounded_current(&owner->thread,
+        owner, &owner->birth);
+    owner->self_status = qemu_thread_bounded_self_current(&owner->thread, owner,
+                                                         &owner->birth);
+    if (owner->probe_target) {
+        BoundedOwner *target = owner->probe_target;
+
+        owner->probe_current_status = qemu_thread_bounded_current(&target->thread,
+            target, &target->birth);
+    }
+    g_assert_cmpint(pthread_mutex_lock(&owner->lock), ==, 0);
+    owner->entered = true;
+    g_assert_cmpint(pthread_cond_broadcast(&owner->wake), ==, 0);
+    owner_wait(owner, &owner->release);
+    g_assert_cmpint(pthread_mutex_unlock(&owner->lock), ==, 0);
+    if (owner->use_tsd) {
+        g_assert_cmpint(pthread_setspecific(bounded_test_key, owner), ==, 0);
+    }
+    return owner;
+}
+
+static void owner_create(BoundedOwner *owner)
+{
+    g_assert_cmpint(qemu_thread_create_bounded(&owner->thread, "bounded-test",
+        bounded_entry, owner, owner->stack, BOUNDED_TEST_STACK_BYTES,
+        &owner->birth), ==, 0);
+    g_assert_true(owner->birth.born);
+    g_assert_cmpint(pthread_mutex_lock(&owner->lock), ==, 0);
+    owner_wait(owner, &owner->entered);
+    g_assert_cmpint(owner->self_status, ==, 0);
+    g_assert_cmpint(owner->newborn_current_status, ==, -EPERM);
+    g_assert_cmpint(pthread_mutex_unlock(&owner->lock), ==, 0);
+}
+
+static void owner_release(BoundedOwner *owner)
+{
+    g_assert_cmpint(pthread_mutex_lock(&owner->lock), ==, 0);
+    owner->release = true;
+    g_assert_cmpint(pthread_cond_broadcast(&owner->wake), ==, 0);
+    g_assert_cmpint(pthread_mutex_unlock(&owner->lock), ==, 0);
+}
+
+static void owner_join(BoundedOwner *owner)
+{
+    int64_t deadline = g_get_monotonic_time() + 10 * G_TIME_SPAN_SECOND;
+    void *result = NULL;
+    int status;
+
+    do {
+        status = qemu_thread_bounded_tryjoin(&owner->thread, owner,
+                                            &owner->birth, &result);
+        if (status == -EBUSY) {
+            g_assert_cmpint(g_get_monotonic_time(), <, deadline);
+            g_thread_yield();
+        }
+    } while (status == -EBUSY);
+    g_assert_cmpint(status, ==, 0);
+    g_assert_true(result == owner);
+    g_assert_true(owner->birth.joined);
+    g_assert_true(owner->birth.registry_returned);
+    g_assert_cmpint(owner->birth.registry_return_status, ==, 0);
+    g_assert_cmpint(qemu_thread_bounded_identity_return(&owner->thread, owner,
+                                                      &owner->birth), ==, 0);
+}
+
+static void test_current_close_join(void)
+{
+    BoundedOwner owner;
+    void *unchanged = &owner;
+
+    owner_init(&owner);
+    owner_create(&owner);
+
+    g_assert_cmpuint(owner.birth.birth_generation, >, 0);
+    g_assert_true(owner.birth.registry_registered);
+    g_assert_cmpint(qemu_thread_bounded_current(&owner.thread, &owner,
+                                               &owner.birth), ==, 0);
+    g_assert_cmpint(qemu_thread_bounded_self_current(&owner.thread, &owner,
+                                                    &owner.birth), ==, -ESTALE);
+    g_assert_cmpint(qemu_thread_bounded_tryjoin(&owner.thread, &owner,
+        &owner.birth, &unchanged), ==, -EBUSY);
+    g_assert_true(unchanged == &owner);
+    g_assert_cmpint(qemu_thread_bounded_identity_return(&owner.thread, &owner,
+        &owner.birth), ==, -EBUSY);
+    g_assert_cmpint(qemu_thread_bounded_close(&owner.thread, &owner,
+                                             &owner.birth), ==, 0);
+    g_assert_cmpint(qemu_thread_bounded_current(&owner.thread, &owner,
+                                               &owner.birth), ==, -ESTALE);
+    /* Enrollment and close never relabel this real thread as fork-safe. */
+    {
+        QemuThreadHotForkInventory inventory;
+        size_t unclassified = 0;
+
+        qemu_thread_hot_fork_inventory(&inventory);
+        for (size_t i = 0; i < inventory.entry_count; i++) {
+            unclassified += inventory.entries[i].disposition ==
+                QEMU_THREAD_HOT_FORK_UNCLASSIFIED;
+        }
+        g_assert_cmpuint(unclassified, >, 0);
+        qemu_thread_hot_fork_inventory_destroy(&inventory);
+    }
+    owner_release(&owner);
+    owner_join(&owner);
+    owner_dispose(&owner);
+}
+
+static void test_identity_and_copy_refusal(void)
+{
+    BoundedOwner owner;
+    QemuThreadBoundedCreateReceipt copy;
+    QemuThreadBoundedCreateReceipt unissued = { 0 };
+    QemuThread foreign;
+    void *unchanged = &copy;
+
+    owner_init(&owner);
+    owner_create(&owner);
+    copy = owner.birth;
+
+    g_assert_cmpint(qemu_thread_bounded_current(&owner.thread, &owner, &copy),
+                    ==, -EPERM);
+    g_assert_cmpint(qemu_thread_bounded_current(&foreign, &owner, &owner.birth),
+                    ==, -EPERM);
+    g_assert_cmpint(qemu_thread_bounded_current(&owner.thread, &foreign,
+                                               &owner.birth), ==, -EPERM);
+    g_assert_cmpint(qemu_thread_bounded_current(&owner.thread, &owner, &unissued),
+                    ==, -EPERM);
+    g_assert_cmpint(qemu_thread_bounded_close(&owner.thread, &owner, &copy),
+                    ==, -EPERM);
+    g_assert_cmpint(qemu_thread_bounded_tryjoin(&owner.thread, &owner, &copy,
+                                               &unchanged), ==, -EPERM);
+    g_assert_true(unchanged == &copy);
+    g_assert_cmpint(qemu_thread_bounded_identity_return(&owner.thread, &owner,
+                                                      &copy), ==, -EPERM);
+    /* Repointing a copied projection cannot create its missing native record. */
+    copy.canonical_owner = &copy;
+    g_assert_cmpint(qemu_thread_bounded_current(&owner.thread, &owner, &copy),
+                    ==, -ESTALE);
+    g_assert_cmpint(qemu_thread_bounded_tryjoin(&owner.thread, &owner, &copy,
+                                               &unchanged), ==, -ESTALE);
+    g_assert_true(unchanged == &copy);
+    g_assert_cmpint(qemu_thread_create_bounded(&owner.thread, "bounded-test",
+        bounded_entry, &owner, owner.stack, BOUNDED_TEST_STACK_BYTES,
+        &owner.birth), ==, -EALREADY);
+    g_assert_cmpint(qemu_thread_bounded_current(&owner.thread, &owner,
+                                               &owner.birth), ==, 0);
+    owner_release(&owner);
+    owner_join(&owner);
+    owner_dispose(&owner);
+}
+
+static void test_noncreator_current_refusal(void)
+{
+    BoundedOwner target;
+    BoundedOwner probe;
+
+    owner_init(&target);
+    owner_create(&target);
+    owner_init(&probe);
+    probe.probe_target = &target;
+    owner_create(&probe);
+
+    /* An actual different pthread has all exact canonical pointers, but did
+     * not create the parked target. Refusal must not change target admission. */
+    g_assert_cmpint(probe.probe_current_status, ==, -EPERM);
+    g_assert_cmpint(qemu_thread_bounded_current(&target.thread, &target,
+                                               &target.birth), ==, 0);
+    owner_release(&probe);
+    owner_join(&probe);
+    owner_release(&target);
+    owner_join(&target);
+    owner_dispose(&probe);
+    owner_dispose(&target);
+}
+
+static void test_definite_no_birth(void)
+{
+    BoundedOwner owner;
+
+    owner_init(&owner);
+    /* The real pthread attribute setter refuses this physical stack geometry. */
+    g_assert_cmpint(qemu_thread_create_bounded(&owner.thread, "bounded-test",
+        bounded_entry, &owner, owner.stack, 1, &owner.birth), ==, -EINVAL);
+    g_assert_false(owner.birth.birth_attempted);
+    g_assert_false(owner.birth.born);
+    g_assert_false(owner.birth.registry_registered);
+    g_assert_false(owner.birth.joined);
+    g_assert_cmpint(qemu_thread_bounded_identity_return(&owner.thread, &owner,
+                                                      &owner.birth), ==, 0);
+    owner_dispose(&owner);
+}
+
+static void bounded_tsd_destructor(void *opaque)
+{
+    BoundedOwner *owner = opaque;
+
+    g_assert_cmpint(pthread_mutex_lock(&owner->lock), ==, 0);
+    owner->tsd_entered = true;
+    g_assert_cmpint(pthread_cond_broadcast(&owner->wake), ==, 0);
+    owner_wait(owner, &owner->tsd_release);
+    g_assert_cmpint(pthread_mutex_unlock(&owner->lock), ==, 0);
+}
+
+static void test_registry_departure_before_tsd(void)
+{
+    BoundedOwner owner;
+    void *unchanged = &owner;
+
+    owner_init(&owner);
+    owner.use_tsd = true;
+    g_assert_cmpint(pthread_key_create(&bounded_test_key,
+                                      bounded_tsd_destructor), ==, 0);
+    owner_create(&owner);
+    owner_release(&owner);
+    g_assert_cmpint(pthread_mutex_lock(&owner.lock), ==, 0);
+    owner_wait(&owner, &owner.tsd_entered);
+
+    /* Actual unregister has run, but this actual thread still owns live TSD. */
+    g_assert_cmpint(qemu_thread_bounded_current(&owner.thread, &owner,
+                                               &owner.birth), ==, -ESTALE);
+    {
+        QemuThreadBoundedCreateReceipt facts;
+
+        g_assert_cmpint(qemu_thread_bounded_observe(&owner.thread, &owner,
+            &owner.birth, &facts), ==, 0);
+        g_assert_true(facts.registry_returned);
+        g_assert_false(facts.joined);
+        g_assert_cmpint(qemu_thread_bounded_current(&owner.thread, &owner,
+                                                   &facts), ==, -EPERM);
+    }
+    g_assert_false(owner.birth.joined);
+    {
+        QemuThreadRamPauseTransaction *pause = g_new0(QemuThreadRamPauseTransaction, 1);
+
+        g_assert_cmpint(qemu_thread_ram_pause_begin(pause), ==, -EBUSY);
+        g_assert_false(pause->active);
+        g_free(pause);
+    }
+    g_assert_cmpint(qemu_thread_bounded_tryjoin(&owner.thread, &owner,
+        &owner.birth, &unchanged), ==, -EBUSY);
+    g_assert_true(unchanged == &owner);
+    g_assert_cmpint(qemu_thread_bounded_identity_return(&owner.thread, &owner,
+                                                      &owner.birth), ==, -EBUSY);
+    owner.tsd_release = true;
+    g_assert_cmpint(pthread_cond_broadcast(&owner.wake), ==, 0);
+    g_assert_cmpint(pthread_mutex_unlock(&owner.lock), ==, 0);
+
+    owner_join(&owner);
+    {
+        QemuThreadRamPauseTransaction *pause = g_new0(QemuThreadRamPauseTransaction, 1);
+        QemuRamPauseEndDisposition end = { 0 };
+
+        /* The genuine native component is now just the live coordinator;
+         * this membership loan still supplies no Source/provider permission. */
+        g_assert_cmpint(qemu_thread_ram_pause_begin(pause), ==, 0);
+        g_assert_cmpint(qemu_thread_ram_pause_validate(pause), ==, 0);
+        g_assert_cmpint(qemu_thread_ram_pause_end_v2(pause, &end), ==, 0);
+        g_assert_true(end.entered);
+        g_assert_true(end.released);
+        g_assert_true(end.notify_entered);
+        g_assert_true(end.notify_returned);
+        g_assert_true(end.complete);
+        g_assert_false(end.uncertain);
+        g_assert_false(pause->active);
+        g_free(pause);
+    }
+    g_assert_cmpint(pthread_key_delete(bounded_test_key), ==, 0);
+    owner_dispose(&owner);
+}
+
+static void test_reuse_after_actual_join(void)
+{
+    BoundedOwner owner;
+    uint64_t prior_generation;
+
+    owner_init(&owner);
+    owner_create(&owner);
+    prior_generation = owner.birth.birth_generation;
+    owner_release(&owner);
+    owner_join(&owner);
+
+    owner.entered = false;
+    owner.release = false;
+    owner_create(&owner);
+    g_assert_cmpuint(owner.birth.birth_generation, >, prior_generation);
+    owner_release(&owner);
+    owner_join(&owner);
+    owner_dispose(&owner);
+}
+
+static void test_copied_process_refusal(void)
+{
+    BoundedOwner owner;
+    pid_t child;
+    int status;
+
+    owner_init(&owner);
+    owner_create(&owner);
+    child = fork();
+    g_assert_cmpint(child, >=, 0);
+    if (!child) {
+        /* Rejection precedes the inherited registry mutex. No child grant. */
+        _exit(qemu_thread_bounded_current(&owner.thread, &owner, &owner.birth)
+              == -EPERM ? 0 : 1);
+    }
+    g_assert_cmpint(waitpid(child, &status, 0), ==, child);
+    g_assert_true(WIFEXITED(status));
+    g_assert_cmpint(WEXITSTATUS(status), ==, 0);
+    owner_release(&owner);
+    owner_join(&owner);
+    owner_dispose(&owner);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/crucible/bounded/current-close-join",
+                    test_current_close_join);
+    g_test_add_func("/crucible/bounded/identity-copy-refusal",
+                    test_identity_and_copy_refusal);
+    g_test_add_func("/crucible/bounded/noncreator-current",
+                    test_noncreator_current_refusal);
+    g_test_add_func("/crucible/bounded/definite-no-birth",
+                    test_definite_no_birth);
+    g_test_add_func("/crucible/bounded/registry-before-tsd",
+                    test_registry_departure_before_tsd);
+    g_test_add_func("/crucible/bounded/reuse-after-join",
+                    test_reuse_after_actual_join);
+    g_test_add_func("/crucible/bounded/copied-process",
+                    test_copied_process_refusal);
+    return g_test_run();
+}
diff --git a/tests/unit/test-crucible-cached-writer.c b/tests/unit/test-crucible-cached-writer.c
new file mode 100644
index 0000000000000000000000000000000000000000..2f3d5024f23d2a00d35ae44fb111e2a1e5bde5a3
--- /dev/null
+++ b/tests/unit/test-crucible-cached-writer.c
@@ -0,0 +1,414 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+static uint8_t memory[64];
+static MemoryRegionCache cache = { .ptr = memory, .len = sizeof(memory) };
+static int cpu_operand;
+
+static void enroll(void)
+{
+    assert(!qemu_hot_fork_current_thread);
+    qemu_hot_fork_current_thread = qemu_hot_fork_thread_register(
+        "writer-control", QEMU_THREAD_JOINABLE, QEMU_THREAD_HOT_FORK_UNCLASSIFIED);
+}
+
+static void retire(void)
+{
+    assert(!ram_writer_owner && !ram_writer_cpus && !ram_writer_io);
+    assert(!qemu_hot_fork_current_thread->ram_writer_io_depth);
+    assert(!qemu_hot_fork_current_thread->ram_writer_nested_io_depth);
+    qemu_hot_fork_thread_unregister(qemu_hot_fork_current_thread);
+}
+
+static void cached_writes(void)
+{
+    const uint8_t copy[] = { 11, 12, 13 };
+
+    address_space_stb_cached(&cache, 0, 9, 0, NULL);
+    address_space_stw_le_cached(&cache, 2, 0x1234, 0, NULL);
+    address_space_stw_be_cached(&cache, 4, 0x1234, 0, NULL);
+    address_space_stl_le_cached(&cache, 8, 0x12345678, 0, NULL);
+    address_space_stl_be_cached(&cache, 12, 0x12345678, 0, NULL);
+    address_space_stq_le_cached(&cache, 16, UINT64_C(0x123456789abcdef0), 0, NULL);
+    address_space_stq_be_cached(&cache, 24, UINT64_C(0x123456789abcdef0), 0, NULL);
+    assert(address_space_write_cached(&cache, 32, copy, sizeof(copy)) == MEMTX_OK);
+    assert(memory[0] == 9 && memory[2] == 0x34 && memory[4] == 0x12);
+    assert(memory[8] == 0x78 && memory[12] == 0x12);
+    assert(memory[16] == 0xf0 && memory[24] == 0x12);
+    assert(!memcmp(memory + 32, copy, sizeof(copy)));
+}
+
+static pthread_barrier_t phases;
+static void barrier(void)
+{
+    int status = pthread_barrier_wait(&phases);
+    assert(!status || status == PTHREAD_BARRIER_SERIAL_THREAD);
+}
+
+static void *foreign_closer(void *unused)
+{
+    QemuThreadRamWriterTransaction close = {0};
+    (void)unused;
+
+    enroll();
+    assert(qemu_thread_ram_writer_close(&close, NULL) == -EBUSY);
+    barrier();
+    barrier();
+    assert(qemu_thread_ram_writer_current(&close) == -EBUSY);
+    barrier();
+    barrier();
+    assert(!qemu_thread_ram_writer_current(&close));
+    assert(!qemu_thread_ram_writer_end(&close));
+    retire();
+    return NULL;
+}
+
+static void foreign_promotion(void)
+{
+    pthread_t closer;
+
+    qemu_thread_ram_writer_enter(&cpu_operand);
+    assert(!pthread_barrier_init(&phases, NULL, 2));
+    assert(!pthread_create(&closer, NULL, foreign_closer, NULL));
+    barrier();
+    /* This real earlier CPU admission remains usable while a foreign close
+     * is Requested. Its outstanding nested IO survives the CPU's return. */
+    cached_writes();
+    qemu_thread_ram_writer_enter(NULL);
+    qemu_thread_ram_writer_leave(&cpu_operand);
+    assert(!ram_writer_cpus && ram_writer_io == 1);
+    barrier();
+    barrier();
+    qemu_thread_ram_writer_leave(NULL);
+    barrier();
+    assert(!pthread_join(closer, NULL));
+    assert(!pthread_barrier_destroy(&phases));
+}
+
+static _Atomic bool foreign_wrote;
+
+static void *new_writer(void *unused)
+{
+    (void)unused;
+    enroll();
+    cached_writes();
+    atomic_store(&foreign_wrote, true);
+    retire();
+    return NULL;
+}
+
+static void foreign_admission(void)
+{
+    pthread_t writer;
+    QemuThreadRamWriterTransaction close = {0};
+
+    assert(!qemu_thread_ram_writer_close(&close, NULL));
+    assert(!pthread_create(&writer, NULL, new_writer, NULL));
+    while (!atomic_load(&writer_waits)) {
+        sched_yield();
+    }
+    assert(!atomic_load(&foreign_wrote));
+    assert(!qemu_thread_ram_writer_current(&close));
+    assert(!qemu_thread_ram_writer_end(&close));
+    assert(!pthread_join(writer, NULL));
+    assert(atomic_load(&foreign_wrote));
+}
+
+static void copied_fork(bool leave, bool rebind)
+{
+    int status;
+    pid_t child;
+
+    qemu_thread_ram_writer_enter(&cpu_operand);
+    if (leave) {
+        qemu_thread_ram_writer_enter(NULL);
+    }
+    assert(qemu_thread_current_id() == qemu_hot_fork_current_thread->thread_id);
+    assert(!pthread_mutex_lock(&ram_writer_lock));
+    child = fork();
+    assert(child >= 0);
+    if (!child) {
+        alarm(2);
+        if (rebind) {
+            /* Literal child registry/cache rebinding cuts; the outstanding
+             * admitted writer identity must not follow the mutable row. */
+            int64_t child_thread_id = qemu_get_thread_id();
+            QemuHotForkThreadRecord *coordinator = qemu_hot_fork_current_thread;
+            crucible_mutex_owner_cache_refresh(child_thread_id);
+            coordinator->thread_id = child_thread_id;
+        }
+        if (leave) {
+            qemu_thread_ram_writer_leave(NULL);
+        } else {
+            address_space_stb_cached(&cache, 0, 9, 0, NULL);
+        }
+        _exit(0);
+    }
+    assert(waitpid(child, &status, 0) == child);
+    assert(WIFSIGNALED(status) && WTERMSIG(status) == SIGABRT);
+    assert(!pthread_mutex_unlock(&ram_writer_lock));
+    if (leave) {
+        qemu_thread_ram_writer_leave(NULL);
+    }
+    qemu_thread_ram_writer_leave(&cpu_operand);
+}
+
+static void copied_status(void)
+{
+    QemuThreadRamWriterScope scope = {0};
+    QemuThreadRamWriterTransaction close = {0};
+    pid_t child;
+    int status;
+
+    qemu_thread_ram_writer_enter(&cpu_operand);
+    assert(!qemu_thread_ram_writer_scope_enter(&scope));
+    assert(qemu_thread_ram_writer_close(&close, &cpu_operand) == -EBUSY);
+    assert(!pthread_mutex_lock(&ram_writer_lock));
+    child = fork();
+    assert(child >= 0);
+    if (!child) {
+        QemuThreadRamWriterScope next = {0};
+        QemuThreadRamWriterTransaction copied_close = {0};
+        QemuThreadRamCpuConstruction construction = {0};
+        alarm(2);
+        assert(qemu_thread_ram_writer_scope_enter(&next) == -ESTALE);
+        assert(qemu_thread_ram_writer_scope_try_enter(&next) == -ESTALE);
+        assert(qemu_thread_ram_writer_scope_leave(&scope) == -ESTALE);
+        assert(qemu_thread_ram_writer_alias_lend(&scope) == -ESTALE);
+        assert(qemu_thread_ram_writer_close(&copied_close, NULL) == -ESTALE);
+        assert(qemu_thread_ram_writer_current(&close) == -ESTALE);
+        assert(qemu_thread_ram_writer_end(&close) == -ESTALE);
+        assert(qemu_thread_ram_cpu_construction_begin(&construction) == -ESTALE);
+        assert(qemu_thread_ram_cpu_construction_current(&construction) == -ESTALE);
+        assert(qemu_thread_ram_cpu_construction_end(&construction) == -ESTALE);
+        assert(qemu_thread_ram_cpu_construction_upgrade_writer(&construction, &copied_close) == -ESTALE);
+        _exit(0);
+    }
+    assert(waitpid(child, &status, 0) == child);
+    assert(WIFEXITED(status) && !WEXITSTATUS(status));
+    assert(!pthread_mutex_unlock(&ram_writer_lock));
+    assert(!qemu_thread_ram_writer_scope_leave(&scope));
+    assert(!qemu_thread_ram_writer_current(&close));
+    assert(!qemu_thread_ram_writer_end(&close));
+    qemu_thread_ram_writer_leave(&cpu_operand);
+}
+
+static void copied_readonly(void)
+{
+    QemuThreadRamWriterTransaction close = {0};
+    int status;
+    pid_t child;
+
+    assert(!qemu_thread_ram_writer_close(&close, NULL));
+    assert(!pthread_mutex_lock(&ram_writer_lock));
+    child = fork();
+    assert(child >= 0);
+    if (!child) {
+        int64_t child_thread_id = qemu_get_thread_id();
+        QemuHotForkThreadRecord *coordinator = qemu_hot_fork_current_thread;
+        alarm(2);
+        crucible_mutex_owner_cache_refresh(child_thread_id);
+        coordinator->thread_id = child_thread_id;
+        cached_writes();
+        _exit(0);
+    }
+    assert(waitpid(child, &status, 0) == child);
+    assert(WIFSIGNALED(status) && WTERMSIG(status) == SIGABRT);
+    assert(!pthread_mutex_unlock(&ram_writer_lock));
+    assert(!qemu_thread_ram_writer_end(&close));
+}
+
+static void fresh_child_interval(void)
+{
+    pid_t child = fork();
+    int status;
+
+    assert(child >= 0);
+    if (!child) {
+        int64_t child_thread_id = qemu_get_thread_id();
+        QemuHotForkThreadRecord *coordinator = qemu_hot_fork_current_thread;
+        /* Literal rebind slice only: this fixture does not authenticate the
+         * complete QEMU carried-mutex/runtime reconstruction transaction. */
+        crucible_mutex_owner_cache_refresh(child_thread_id);
+        coordinator->thread_id = child_thread_id;
+        qemu_thread_ram_writer_enter(&cpu_operand);
+        cached_writes();
+        qemu_thread_ram_writer_leave(&cpu_operand);
+        assert(!ram_writer_cpus && !ram_writer_io);
+        _exit(0);
+    }
+    assert(waitpid(child, &status, 0) == child);
+    assert(WIFEXITED(status) && !WEXITSTATUS(status));
+}
+
+int main(int argc, char **argv)
+{
+    const char *mode;
+    QemuThreadRamWriterTransaction close = {0};
+    QemuThreadRamWriterScope scope = {0};
+    unsigned before;
+
+    assert(argc == 2);
+    mode = argv[1];
+    alarm(6);
+    if (!strcmp(mode, "no-record")) {
+        assert(!qemu_hot_fork_current_thread);
+        before = writer_locks;
+        cached_writes();
+        assert(writer_locks == before + 16);
+        printf("unregistered Main/IO: 8 accesses, 16 writer locks + 16 unlocks; no ID accessor\n");
+        return 0;
+    }
+    enroll();
+    if (!strcmp(mode, "enrolled-ordinary")) {
+        (void)qemu_thread_current_id();
+        unsigned ids = native_id_calls;
+        before = writer_locks;
+        cached_writes();
+        assert(writer_locks == before + 16 && native_id_calls == ids);
+        printf("enrolled Main/IO without interval: 8 accesses, 16 writer locks + 16 unlocks; 16 cached ID accessor calls on enter/return\n");
+    } else if (!strcmp(mode, "cpu-cached")) {
+        qemu_thread_ram_writer_enter(&cpu_operand);
+        (void)qemu_thread_current_id();
+        unsigned ids = native_id_calls;
+        before = writer_locks;
+        cached_writes();
+        assert(writer_locks == before && native_id_calls == ids);
+        assert(ram_writer_cpus == 1 && !ram_writer_io);
+        assert(!qemu_hot_fork_current_thread->ram_writer_io_depth);
+        qemu_thread_ram_writer_leave(&cpu_operand);
+        printf("nested CPU: 8 accesses, zero writer locks/ID syscalls after cache warmup; 16 ID accessor calls\n");
+    } else if (!strcmp(mode, "io-nested") || !strcmp(mode, "plain-return-first")) {
+        qemu_thread_ram_writer_enter(NULL);
+        before = writer_locks;
+        qemu_thread_ram_writer_enter(NULL);
+        cached_writes();
+        assert(writer_locks == before && ram_writer_io == 1);
+        assert(qemu_hot_fork_current_thread->ram_writer_io_depth == 2);
+        qemu_thread_ram_writer_leave(NULL);
+        assert(ram_writer_io == 1 && qemu_hot_fork_current_thread->ram_writer_io_depth == 1);
+        assert(!qemu_hot_fork_current_thread->ram_writer_nested_io_depth);
+        qemu_thread_ram_writer_leave(NULL);
+    } else if (!strcmp(mode, "scope-nested") || !strcmp(mode, "scope-promotion")) {
+        assert(!qemu_thread_ram_writer_scope_enter(&scope));
+        before = writer_locks;
+        cached_writes();
+        assert(writer_locks == before && ram_writer_io == 1);
+        if (!strcmp(mode, "scope-promotion")) {
+            qemu_thread_ram_writer_enter(NULL);
+            assert(!qemu_thread_ram_writer_scope_leave(&scope));
+            assert(ram_writer_io == 1 && !qemu_hot_fork_current_thread->ram_writer_nested_io_depth);
+            assert(qemu_thread_ram_writer_close(&close, NULL) == -EBUSY);
+            qemu_thread_ram_writer_leave(NULL);
+            assert(!qemu_thread_ram_writer_current(&close));
+            assert(!qemu_thread_ram_writer_end(&close));
+        } else {
+            assert(!qemu_thread_ram_writer_scope_leave(&scope));
+        }
+    } else if (!strcmp(mode, "cpu-promotion")) {
+        qemu_thread_ram_writer_enter(&cpu_operand);
+        qemu_thread_ram_writer_enter(NULL);
+        qemu_thread_ram_writer_leave(&cpu_operand);
+        assert(!ram_writer_cpus && ram_writer_io == 1);
+        assert(!qemu_hot_fork_current_thread->ram_writer_nested_io_depth);
+        assert(qemu_thread_ram_writer_close(&close, NULL) == -EBUSY);
+        qemu_thread_ram_writer_leave(NULL);
+        assert(!qemu_thread_ram_writer_current(&close));
+        assert(!qemu_thread_ram_writer_end(&close));
+    } else if (!strcmp(mode, "foreign-close")) {
+        foreign_promotion();
+    } else if (!strcmp(mode, "foreign-admission")) {
+        foreign_admission();
+    } else if (!strcmp(mode, "return-marker")) {
+        qemu_thread_ram_writer_enter(&cpu_operand);
+        assert(!qemu_thread_ram_writer_close(&close, &cpu_operand));
+        assert(!qemu_thread_ram_writer_end(&close));
+        before = writer_locks;
+        cached_writes();
+        assert(writer_locks == before);
+        qemu_thread_ram_writer_leave(&cpu_operand);
+    } else if (!strcmp(mode, "alias")) {
+        assert(!qemu_thread_ram_writer_scope_try_enter(&scope));
+        assert(!qemu_thread_ram_writer_alias_lend(&scope));
+        assert(qemu_thread_ram_writer_close(&close, NULL) == -EBUSY);
+        assert(!qemu_thread_ram_writer_scope_leave(&scope));
+        assert(qemu_thread_ram_writer_current(&close) == -EBUSY);
+        qemu_thread_ram_writer_alias_return();
+        assert(!qemu_thread_ram_writer_current(&close));
+        assert(!qemu_thread_ram_writer_end(&close));
+    } else if (!strcmp(mode, "copied-fork") || !strcmp(mode, "copied-leave") || !strcmp(mode, "copied-rebind")) {
+        copied_fork(!strcmp(mode, "copied-leave"), !strcmp(mode, "copied-rebind"));
+    } else if (!strcmp(mode, "copied-status")) {
+        copied_status();
+    } else if (!strcmp(mode, "copied-readonly")) {
+        copied_readonly();
+    } else if (!strcmp(mode, "execution-return")) {
+        QemuThreadRamCpuExecutionWitness witness = {0};
+        qemu_thread_ram_writer_enter(&cpu_operand);
+        assert(!qemu_thread_ram_cpu_execution_borrow(&witness, &cpu_operand));
+        assert(!qemu_thread_ram_cpu_execution_current(&witness));
+        assert(qemu_thread_ram_cpu_execution_ended(&witness) == -EBUSY);
+        qemu_thread_ram_writer_enter(NULL);
+        qemu_thread_ram_writer_leave(&cpu_operand);
+        assert(!qemu_thread_ram_cpu_execution_ended(&witness));
+        assert(!qemu_thread_ram_cpu_execution_return(&witness));
+        qemu_thread_ram_writer_leave(NULL);
+    } else if (!strcmp(mode, "fresh-child-interval")) {
+        fresh_child_interval();
+    } else if (!strcmp(mode, "atfork-failure")) {
+        refuse_atfork = true;
+        qemu_thread_ram_writer_enter(NULL);
+        before = native_id_calls;
+        cached_writes();
+        assert(!crucible_mutex_owner_cache_enabled);
+        assert(native_id_calls == before + 16);
+        qemu_thread_ram_writer_leave(NULL);
+        copied_fork(false, false);
+        printf("failed atfork registration: uncached native ID checks retained\n");
+    } else if (!strcmp(mode, "cache-suspended")) {
+        (void)qemu_thread_current_id();
+        crucible_mutex_owner_cache_prepare();
+        assert(!crucible_mutex_owner_cached_thread_id);
+        before = native_id_calls;
+        assert(qemu_thread_current_id() == qemu_hot_fork_current_thread->thread_id);
+        assert(qemu_thread_current_id() == qemu_hot_fork_current_thread->thread_id);
+        assert(native_id_calls == before + 2 && !crucible_mutex_owner_cached_thread_id);
+        crucible_mutex_owner_cache_resume();
+    } else if (!strcmp(mode, "self-cpu")) {
+        qemu_thread_ram_writer_enter(&cpu_operand);
+        assert(!qemu_thread_ram_writer_close(&close, &cpu_operand));
+        assert(!qemu_thread_ram_writer_current(&close));
+        cached_writes();
+        return 0;
+    } else if (!strcmp(mode, "self-io")) {
+        qemu_thread_ram_writer_enter(NULL);
+        qemu_thread_ram_writer_enter(NULL);
+        assert(qemu_thread_ram_writer_close(&close, NULL) == -EBUSY);
+        qemu_thread_ram_writer_leave(NULL);
+        assert(qemu_thread_ram_writer_current(&close) == -EBUSY);
+        cached_writes();
+        return 0;
+    } else if (!strcmp(mode, "upgrade")) {
+        QemuThreadRamCpuConstruction construction = {0};
+        assert(!qemu_thread_ram_cpu_construction_begin(&construction));
+        assert(!qemu_thread_ram_cpu_construction_current(&construction));
+        qemu_thread_ram_writer_enter(NULL);
+        assert(qemu_thread_ram_cpu_construction_upgrade_writer(&construction, &close) == -EBUSY);
+        assert(!construction.active && close.active);
+        cached_writes();
+        return 0;
+    } else if (!strcmp(mode, "layout")) {
+        printf("old record=%zu align=%zu; new record=%zu align=%zu; old/new row+GList=%zu/%zu\n",
+               sizeof(OldQemuHotForkThreadRecord), _Alignof(OldQemuHotForkThreadRecord),
+               sizeof(QemuHotForkThreadRecord), _Alignof(QemuHotForkThreadRecord),
+               sizeof(OldQemuHotForkThreadRecord) + sizeof(GList),
+               qemu_thread_hot_fork_record_storage_bytes());
+    } else {
+        abort();
+    }
+    /* Exercise the genuine identity-only construction return too. */
+    QemuThreadRamCpuConstruction returned = {0};
+    assert(!qemu_thread_ram_cpu_construction_begin(&returned));
+    assert(!qemu_thread_ram_cpu_construction_end(&returned));
+    retire();
+    puts(mode);
+    return 0;
+}
diff --git a/tests/unit/test-crucible-checkpoint-placement.c b/tests/unit/test-crucible-checkpoint-placement.c
new file mode 100644
index 0000000000000000000000000000000000000000..10a99d7abb6ffde2ae2e542783c636a4424239cd
--- /dev/null
+++ b/tests/unit/test-crucible-checkpoint-placement.c
@@ -0,0 +1,558 @@
+/*
+ * Bounded checkpoint placement mailbox controls.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#include "qemu/osdep.h"
+
+#include "qemu/atomic.h"
+#include "qemu/event_notifier.h"
+#include "qemu/notify.h"
+#include "qemu/thread.h"
+#include "plugins/qemu-plugin.h"
+#include "plugins/crucible-checkpoint-receiving.h"
+#include "system/crucible-hot-fork-coordinator.h"
+#include "system/crucible-ram-quiescence.h"
+#include "system/runstate.h"
+
+#include <sys/eventfd.h>
+
+/* The real issuer, pager transaction and continuously held BQL are not provided
+ * by this utility. These providers disclose the conditional physical mailbox
+ * boundary. Real native atomics, thread identity and descriptors are retained.
+ */
+static bool fixture_paused = true;
+static bool fixture_quiesced = true;
+static bool fixture_cold;
+static bool fixture_bql = true;
+static uint64_t fixture_stop_generation = 73;
+static unsigned int fixture_cas_calls;
+static unsigned int fixture_write_calls;
+static unsigned int fixture_callback_calls;
+static int fixture_write_error;
+static bool fixture_cas_loss;
+static int fixture_dispatch_status;
+static unsigned int fixture_dispatch_calls;
+static unsigned char fixture_transaction_storage;
+static unsigned char fixture_callback_opaque;
+
+static bool fixture_runstate_check(RunState state)
+{
+    return state == RUN_STATE_PAUSED && fixture_paused;
+}
+
+static bool fixture_vmstop_quiesced(void)
+{
+    return fixture_quiesced;
+}
+
+static bool fixture_vmstop_cold_origin(void)
+{
+    return fixture_cold;
+}
+
+static uint64_t fixture_vmstop_generation(void)
+{
+    return fixture_stop_generation;
+}
+
+static bool fixture_bql_locked(void)
+{
+    return fixture_bql;
+}
+
+static uint64_t fixture_cmpxchg(uint64_t *address, uint64_t old, uint64_t value)
+{
+    fixture_cas_calls++;
+    if (fixture_cas_loss) {
+        fixture_cas_loss = false;
+        qatomic_set(address, (old & ~UINT64_C(7)) | 1);
+    }
+    return qatomic_cmpxchg(address, old, value);
+}
+
+static ssize_t fixture_write(int fd, const void *buffer, size_t size)
+{
+    fixture_write_calls++;
+    if (fixture_write_error) {
+        errno = fixture_write_error;
+        return -1;
+    }
+    return write(fd, buffer, size);
+}
+
+static int fixture_transaction_current(
+    QemuCrucibleCheckpointHeldTransaction *transaction,
+    uint64_t stopped_generation, int cancellation_fd)
+{
+    /* Stop-generation revalidation remains the literal mailbox body's cut,
+     * not a second modeled oracle that masks its causal omission control. */
+    (void)stopped_generation;
+    return transaction == (void *)&fixture_transaction_storage &&
+        cancellation_fd >= 0 ? 0 : -EPERM;
+}
+
+static bool fixture_in_coroutine(void)
+{
+    return false;
+}
+
+/* Receiving's real transaction/Root retirement is outside this mailbox
+ * fixture. Its status is an explicit nonissuing dependency: refusal must
+ * preserve the exact ready body without a CAS or callback effect. */
+static int fixture_dispatch_check(void)
+{
+    fixture_dispatch_calls++;
+    return fixture_dispatch_status;
+}
+
+/* The CAS-loss and EINTR controls inject syscall/atomic result branches, not
+ * evidence of kernel EINTR or a genuine concurrent transaction acquisition.
+ */
+#pragma push_macro("qatomic_cmpxchg")
+#undef qatomic_cmpxchg
+#define qatomic_cmpxchg fixture_cmpxchg
+#define write fixture_write
+#define runstate_check fixture_runstate_check
+#define qemu_plugin_crucible_vmstop_quiesced fixture_vmstop_quiesced
+#define qemu_plugin_crucible_vmstop_cold_origin fixture_vmstop_cold_origin
+#define qemu_plugin_crucible_vmstop_generation fixture_vmstop_generation
+#define bql_locked fixture_bql_locked
+#define qemu_in_coroutine fixture_in_coroutine
+#define qemu_crucible_checkpoint_transaction_placement_current fixture_transaction_current
+#define qemu_crucible_checkpoint_scheduled_dispatch_check fixture_dispatch_check
+#include "crucible-checkpoint-placement.inc.h"
+#undef qemu_crucible_checkpoint_scheduled_dispatch_check
+#undef qemu_crucible_checkpoint_transaction_placement_current
+#undef qemu_in_coroutine
+#undef bql_locked
+#undef qemu_plugin_crucible_vmstop_generation
+#undef qemu_plugin_crucible_vmstop_cold_origin
+#undef qemu_plugin_crucible_vmstop_quiesced
+#undef runstate_check
+#undef write
+#pragma pop_macro("qatomic_cmpxchg")
+
+static int fixture_callback(void *opaque)
+{
+    g_assert_true(opaque == &fixture_callback_opaque);
+    fixture_callback_calls++;
+    return 0;
+}
+
+static void fixture_prepare(uint64_t phase)
+{
+    int wake_fd = eventfd(0, EFD_CLOEXEC | EFD_NONBLOCK);
+    int cancellation_fd = eventfd(9, EFD_CLOEXEC | EFD_NONBLOCK);
+
+    g_assert_cmpint(wake_fd, >=, 0);
+    g_assert_cmpint(cancellation_fd, >=, 0);
+    memset(&crucible_hot_fork_coordinator, 0,
+           sizeof(crucible_hot_fork_coordinator));
+    crucible_hot_fork_coordinator.process_id = getpid();
+    crucible_hot_fork_coordinator.main_thread_id = qemu_get_thread_id();
+    event_notifier_init_fd(&crucible_hot_fork_coordinator.wake, wake_fd);
+    qatomic_store_release(&crucible_hot_fork_coordinator.initialized, true);
+
+    /* Test-only publication models a previously acquired genuine transaction.
+     * No production constructor, grant, callback or original check is supplied.
+     */
+    memset(&checkpoint_placement_owner, 0, sizeof(checkpoint_placement_owner));
+    checkpoint_placement_owner.process_id = getpid();
+    checkpoint_placement_owner.owner_thread_id = qemu_get_thread_id();
+    checkpoint_placement_owner.transaction =
+        (QemuCrucibleCheckpointHeldTransaction *)&fixture_transaction_storage;
+    checkpoint_placement_owner.stopped_generation = fixture_stop_generation;
+    checkpoint_placement_owner.cancellation_fd = cancellation_fd;
+    checkpoint_placement_owner.saved_cancellation_fd = -1;
+    qatomic_store_release(&checkpoint_placement_owner.published, true);
+
+    qatomic_set(&ram_scheduled.callback, fixture_callback);
+    qatomic_set(&ram_scheduled.opaque, &fixture_callback_opaque);
+    qatomic_store_release(&ram_scheduled.state, UINT64_C(88) | phase);
+    fixture_cas_calls = 0;
+    fixture_write_calls = 0;
+}
+
+static void fixture_assert_event_untouched(void)
+{
+    uint64_t value = 0;
+
+    /* Only this test verification consumes its own event. Production helpers
+     * never read, duplicate or close the retained cancellation descriptor.
+     */
+    g_assert_cmpint(read(checkpoint_placement_owner.cancellation_fd,
+                         &value, sizeof(value)), ==, sizeof(value));
+    g_assert_cmpuint(value, ==, 9);
+}
+
+static bool fixture_enter_subprocess(void)
+{
+    if (g_test_subprocess()) {
+        return true;
+    }
+    g_test_trap_subprocess(NULL, 5 * G_TIME_SPAN_SECOND, 0);
+    g_test_trap_assert_passed();
+    return false;
+}
+
+static void test_queued_round_trip(void)
+{
+    QemuCrucibleCheckpointPlacementOwner *owner = &checkpoint_placement_owner;
+
+    if (!fixture_enter_subprocess()) {
+        return;
+    }
+    fixture_prepare(2);
+
+    g_assert_cmpint(qemu_crucible_checkpoint_placement_detach_v1(owner), ==, 0);
+    g_assert_cmpuint(fixture_cas_calls, ==, 1);
+    g_assert_cmpuint(owner->saved_state, ==, 90);
+    g_assert_true(owner->saved_callback == fixture_callback);
+    g_assert_true(owner->saved_opaque == &fixture_callback_opaque);
+    g_assert_cmpint(owner->saved_cancellation_fd, ==, owner->cancellation_fd);
+    g_assert_true(owner->detached);
+    g_assert_cmpuint(ram_scheduled.state, ==, 93);
+    crucible_ram_execute_scheduled();
+    g_assert_cmpuint(fixture_callback_calls, ==, 0);
+    g_assert_cmpint(qemu_crucible_ram_schedule_on_main_loop(
+        fixture_callback, &fixture_callback_opaque), ==, -EBUSY);
+    g_assert_cmpint(qemu_crucible_ram_cancel_scheduled_main_loop(), ==, -EBUSY);
+    g_assert_cmpuint(fixture_cas_calls, ==, 1);
+    g_assert_cmpint(qemu_crucible_checkpoint_placement_detach_v1(owner), ==,
+                    -EALREADY);
+
+    g_assert_cmpint(qemu_crucible_checkpoint_placement_restore_v1(owner), ==, 0);
+    g_assert_cmpuint(fixture_cas_calls, ==, 2);
+    g_assert_cmpuint(fixture_write_calls, ==, 1);
+    g_assert_cmpuint(ram_scheduled.state, ==, 90);
+    g_assert_false(owner->detached);
+    g_assert_cmpint(qemu_crucible_checkpoint_placement_restore_v1(owner), ==,
+                    -EALREADY);
+    crucible_ram_execute_scheduled();
+    crucible_ram_execute_scheduled();
+    g_assert_cmpuint(fixture_callback_calls, ==, 1);
+    g_assert_cmpuint(ram_scheduled.state, ==, 88);
+    fixture_assert_event_untouched();
+}
+
+static void test_empty_round_trip(void)
+{
+    QemuCrucibleCheckpointPlacementOwner *owner = &checkpoint_placement_owner;
+
+    if (!fixture_enter_subprocess()) {
+        return;
+    }
+    fixture_prepare(0);
+
+    g_assert_cmpint(qemu_crucible_checkpoint_placement_detach_v1(owner), ==, 0);
+    g_assert_cmpuint(ram_scheduled.state, ==, 94);
+    g_assert_cmpint(qemu_crucible_ram_schedule_on_main_loop(
+        fixture_callback, &fixture_callback_opaque), ==, -EBUSY);
+    g_assert_cmpint(qemu_crucible_ram_cancel_scheduled_main_loop(), ==, -EBUSY);
+    g_assert_cmpint(qemu_crucible_checkpoint_placement_restore_v1(owner), ==, 0);
