+int qemu_crucible_startup_source_control_purpose_reserve_v2(
+    qemu_plugin_id_t id, const QemuCrucibleProcessPurposeRequest requests[7],
+    QemuCrucibleStartupControlPurpose **out)
+{
+#ifdef CONFIG_LINUX
+    uint64_t native_generation;
+    int status;
+
+    if (!startup_invocation(id) || !startup_source.acquisition_attempted ||
+        startup_source.saved.plugin_id != id ||
+        startup_source.current.ctx != startup_source.saved.ctx ||
+        startup_source.current.module != startup_source.saved.module ||
+        startup_source.current.install != startup_source.saved.install) {
+        return -EPERM;
+    }
+    status = startup_active(id);
+    if (status) {
+        return status;
+    }
+    if (!out || !requests) {
+        return startup_failure(-EINVAL);
+    }
+    status = qemu_plugin_crucible_startup_source_check_v1(id);
+    if (status) {
+        return status;
+    }
+    /* This is not a publisher: exact retained physical/artifact/contract loan
+     * construction is still required. Raw record bytes cannot set these slots.
+     */
+    if (!qatomic_load_acquire(&startup_source.process_purpose_complete) ||
+        !startup_source.preexec_purpose_owner ||
+        !startup_source.process_contract_owner ||
+        !startup_source.incarnation_purpose_owner) {
+        return startup_failure(-ENOKEY);
+    }
+    if (!qatomic_load_acquire(&startup_source.original_record_complete) ||
+        memcmp(startup_source.process_purpose_record.containing_capability,
+               startup_source.original.cap_id, 32) ||
+        startup_source.process_purpose_record.original_total !=
+            startup_source.original.original_total_bytes ||
+        startup_source.process_purpose_record.process_generation !=
+            startup_source.original.process_generation ||
+        startup_source.metadata_partition.total !=
+            startup_source.original.original_total_bytes ||
+        startup_source.metadata_partition.process_extent !=
+            startup_source.process_purpose_record.local_extent) {
+        return startup_failure(-ESTALE);
+    }
+    native_generation = qemu_crucible_fault_lifecycle_process_generation();
+    status = qemu_crucible_startup_source_generation_check(
+        native_generation ? native_generation :
+            startup_source.original.process_generation, false);
+    if (status) {
+        return status;
+    }
+    for (size_t index = 0; index < 7; index++) {
+        const QemuCrucibleProcessPurposeRequest *issued =
+            &startup_source.process_purpose_record.requests[index];
+
+        if (requests[index].extent != issued->extent ||
+            requests[index].alignment != issued->alignment ||
+            requests[index].count != issued->count) {
+            return startup_failure(-ESTALE);
+        }
+    }
+    status = startup_process_purpose_live();
+    if (status) {
+        return status;
+    }
+    if (startup_source.control_purpose.held) {
+        return startup_failure(-EALREADY);
+    }
+    if (!startup_source.metadata_partition.controller_retained) {
+        /* Historical utility publication does not precharge the seven rows. */
+        status = crucible_metadata_control7_reserve(
+            &startup_source.metadata_partition, requests);
+        if (status) {
+            return startup_failure(status);
+        }
+    }
+    startup_source.control_purpose = (QemuCrucibleStartupControlPurpose) {
+        .process_id = startup_source.owner_process,
+        .plugin_id = id,
+        .process_generation = startup_source.original.process_generation,
+        .ctx = startup_source.saved.ctx,
+        .module = startup_source.saved.module,
+        .install = startup_source.saved.install,
+        .held = true,
+    };
+    status = startup_process_purpose_live();
+    if (status) {
+        crucible_metadata_partition_record_post(
+            &startup_source.metadata_partition, status);
+        return status;
+    }
+    *out = &startup_source.control_purpose;
+    return 0;
+#else
+    return -ENOTSUP;
+#endif
+}
