+#ifdef CONFIG_LINUX
+static int startup_process_purpose_live(void)
+{
+    uint64_t slice;
+    uint64_t now;
+    struct timespec time;
+    int status;
+
+    if (standing_construction_operation_identity()) {
+        return qemu_crucible_startup_source_observation_construction_current_v1(
+            &startup_source.standing.construction);
+    }
+    if (standing_operation_identity(&startup_source.standing.operation)) {
+        return standing_operation_current(&startup_source.standing.operation);
+    }
+    status = startup_live_slice(&slice);
+
+    if (status) {
+        return status;
+    }
+    if (!startup_source.process_purpose_record.containing_start ||
+        !startup_source.process_purpose_record.containing_poll ||
+        startup_source.process_purpose_record.containing_end <=
+            startup_source.process_purpose_record.containing_start) {
+        return startup_failure(-EPROTO);
+    }
+    if (clock_gettime(CLOCK_MONOTONIC, &time) < 0) {
+        return startup_failure(-errno);
+    }
+    if (time.tv_sec < 0 || time.tv_nsec < 0 || time.tv_nsec >= 1000000000 ||
+        (uint64_t)time.tv_sec >
+            (UINT64_MAX - (uint64_t)time.tv_nsec) / 1000000000) {
+        return startup_failure(-EOVERFLOW);
+    }
+    now = (uint64_t)time.tv_sec * 1000000000 + time.tv_nsec;
+    if (now < startup_source.process_purpose_record.containing_start) {
+        return startup_failure(-ESTALE);
+    }
+    if (now >= startup_source.process_purpose_record.containing_end) {
+        return startup_failure(-ETIMEDOUT);
+    }
+    return 0;
+}
+#endif
