+    if (first || !holder || !startup_owner()) {
+        return first ? first : -EPERM;
+    }
+    qemu_thread_get_self(&thread);
+    qemu_mutex_lock(&registry->mutex);
+    first = callback_child_identity_locked(child);
+    if (!first && ((child->transferred && holder != child->runtime_holder) ||
+                   (void *)holder == (void *)child->bridge->holder || *holder != child)) {
+        first = -EPERM;
+    }
+    if (!first && (child->allocation_active || child->initialization_active ||
