+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Literal coordinate/bitmap component only. No Source owner, capture admission,
+ * operational reader, ACK, retirement or live lifecycle is modeled here. */
+
+#include <assert.h>
+#include <errno.h>
+#include <limits.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#ifdef FIXTURE_RAM_ADDR_32
+typedef uint32_t ram_addr_t;
+#else
+typedef uint64_t ram_addr_t;
+#endif
+static unsigned target_page_bits;
+#define TARGET_PAGE_BITS target_page_bits
+#define TARGET_PAGE_SIZE (UINT64_C(1) << TARGET_PAGE_BITS)
+#define TARGET_PAGE_MASK (~(TARGET_PAGE_SIZE - 1))
+#define TARGET_PAGE_ALIGN(value) (((value) + TARGET_PAGE_SIZE - 1) & TARGET_PAGE_MASK)
+#define RAM_PAGE_BYTES 4096
+#define DIRTY_MEMORY_CRUCIBLE_RAM 0
+#define DIRTY_MEMORY_NUM 2
+#define DIRTY_MEMORY_BLOCK_SIZE (UINT64_C(256) * 1024 * 8)
+#define BITS_PER_LONG (sizeof(unsigned long) * CHAR_BIT)
+#define BIT_WORD(bit) ((bit) / BITS_PER_LONG)
+#define DIV_ROUND_UP(value, divisor) (((value) + (divisor) - 1) / (divisor))
+#define MIN(left, right) ((left) < (right) ? (left) : (right))
+#define MAX(left, right) ((left) > (right) ? (left) : (right))
+#define qatomic_read(pointer) (*(pointer))
+#define qatomic_rcu_read(pointer) (*(pointer))
+#define qatomic_load_acquire(pointer) (*(pointer))
+#define ctzl(value) __builtin_ctzl(value)
+
+typedef struct DirtyMemoryBlocks {
+    unsigned long *blocks[3];
+} DirtyMemoryBlocks;
+static struct { DirtyMemoryBlocks *dirty_memory[DIRTY_MEMORY_NUM]; } ram_list;
+static uint64_t word_loads, rcu_entries, rcu_exits;
+static unsigned rcu_depth;
+static bool change_on_word;
+static uint64_t dirty_generation = 11, capture_dirty_generation = 11;
+static uint64_t capture_page_cursor;
+static ram_addr_t capture_dirty_end;
+static uint32_t capture_region_cursor;
+static bool capture_full;
+
+typedef struct FixtureRcuGuard { bool active; } FixtureRcuGuard;
+
+static FixtureRcuGuard fixture_rcu_enter(void)
+{
+    assert(rcu_depth++ == 0);
+    rcu_entries++;
+    return (FixtureRcuGuard) { true };
+}
+
+static void fixture_rcu_leave(FixtureRcuGuard *guard)
+{
+    assert(rcu_depth-- == 1);
+    rcu_exits++;
+    guard->active = false;
+}
+
+#define WITH_RCU_READ_LOCK_GUARD() \
+    for (FixtureRcuGuard guard __attribute__((cleanup(fixture_rcu_leave))) = \
+         fixture_rcu_enter(); guard.active; guard.active = false)
+
+static inline unsigned long fixture_word(const unsigned long *pointer)
+{
+    assert(rcu_depth == 1);
+    word_loads++;
+    if (change_on_word) {
+        dirty_generation++;
+        change_on_word = false;
+    }
+    return *pointer;
+}
+
+typedef struct RAMBlock {
+    ram_addr_t offset, used_length;
+    uint8_t *host;
+} RAMBlock;
+typedef struct CrucibleRamRegion {
+    RAMBlock *block;
+    struct { uint64_t logical_length; } descriptor;
+} CrucibleRamRegion;
+typedef struct FixtureRegions {
+    unsigned len;
+    CrucibleRamRegion *entries[3];
+} FixtureRegions;
+static FixtureRegions regions;
+static FixtureRegions *capture_regions;
+#define region_inventory_index(array, index) ((array)->entries[(index)])
+
+struct qemu_plugin_crucible_ram_page_v1 {
+    uint32_t region_index, valid_length;
+    uint64_t page_index, page_version;
+};
+
+#ifdef FIXTURE_INDEX_32
+typedef uint32_t FixtureNativeSize;
+#define size_t FixtureNativeSize
+#endif
+
+unsigned long find_next_bit(const unsigned long *, unsigned long, unsigned long);
+bool physical_memory_get_dirty_flag(ram_addr_t, unsigned);
+int qemu_crucible_ram_next_dirty_range(ram_addr_t, ram_addr_t,
+                                      ram_addr_t *, ram_addr_t *);
+
+#include "extracted-production.h"
+
+#ifdef FIXTURE_INDEX_32
+#undef size_t
+#endif
+
+typedef int (*NextCoordinate)(struct qemu_plugin_crucible_ram_page_v1 *,
+                              CrucibleRamRegion **, uint64_t *);
+typedef struct OrderedCapture {
+    struct qemu_plugin_crucible_ram_page_v1 pages[8192];
+    unsigned count;
+} OrderedCapture;
+static uint64_t cases, tuple_digest = UINT64_C(1469598103934665603);
+
+/* Independent fixed matrix dimensions: seven page sizes, three alignments,
+ * 256 dirty masks plus full selection; two block-boundary and word-boundary
+ * selections per representable size, then two oversized-page selections. */
+#ifdef FIXTURE_RAM_ADDR_32
+#define EXPECTED_MATRIX_CASES (UINT64_C(7) * 3 * (256 + 1) + 1 * 2 + 7 * 2 + 2)
+#else
+#define EXPECTED_MATRIX_CASES (UINT64_C(7) * 3 * (256 + 1) + 7 * 2 + 7 * 2 + 2)
+#endif
+
+
+static void set_bit(uint64_t page)
+{
+    assert(page / DIRTY_MEMORY_BLOCK_SIZE < 3);
+    unsigned long *bitmap = ram_list.dirty_memory[0]->blocks[page / DIRTY_MEMORY_BLOCK_SIZE];
+    uint64_t bit = page % DIRTY_MEMORY_BLOCK_SIZE;
+
+    bitmap[BIT_WORD(bit)] |= 1UL << (bit % BITS_PER_LONG);
+}
+
+/* These are component inputs, not capture admission or a live owner. */
+static void reset_selection(bool full)
+{
+    capture_regions = &regions;
+    capture_region_cursor = 0;
+    capture_page_cursor = 0;
+    capture_dirty_end = 0;
+    capture_dirty_generation = dirty_generation;
+    capture_full = full;
+    word_loads = rcu_entries = rcu_exits = 0;
+    change_on_word = false;
+}
+
+static OrderedCapture collect(NextCoordinate next, bool full)
+{
+    OrderedCapture result = {0};
+
+    reset_selection(full);
+    for (;;) {
+        struct qemu_plugin_crucible_ram_page_v1 page = {0};
+        CrucibleRamRegion *selected = NULL;
+        uint64_t offset = UINT64_MAX;
+        int status = next(&page, &selected, &offset);
+
+        if (status == 1) {
+            break;
+        }
+        assert(status == 0 && result.count < 8192);
+        assert(page.valid_length > 0 && page.valid_length <= RAM_PAGE_BYTES);
+        assert(page.region_index < regions.len);
+        assert(selected == regions.entries[page.region_index]);
+        assert(offset == page.page_index * RAM_PAGE_BYTES);
+        assert(offset < selected->descriptor.logical_length);
+        assert(page.valid_length <= selected->descriptor.logical_length - offset);
+        result.pages[result.count] = page;
+        result.count++;
+    }
+    assert(rcu_depth == 0 && rcu_entries == rcu_exits);
+    return result;
+}
+
+static void compare(bool full)
+{
+    OrderedCapture old = collect(old_next_page_coordinate, full);
+    OrderedCapture actual = collect(capture_next_page_coordinate, full);
+
+    assert(old.count == actual.count);
+    for (unsigned i = 0; i < old.count; i++) {
+        assert(old.pages[i].region_index == actual.pages[i].region_index);
+        assert(old.pages[i].page_index == actual.pages[i].page_index);
+        assert(old.pages[i].valid_length == actual.pages[i].valid_length);
+        assert(old.pages[i].page_version == actual.pages[i].page_version);
+        tuple_digest = (tuple_digest ^ actual.pages[i].page_index) * UINT64_C(1099511628211);
+        tuple_digest = (tuple_digest ^ actual.pages[i].valid_length) * UINT64_C(1099511628211);
+        tuple_digest = (tuple_digest ^ actual.pages[i].region_index) * UINT64_C(1099511628211);
+    }
+    cases++;
+}
+
+static void clear_maps(void)
+{
+    for (unsigned i = 0; i < 3; i++) {
+        memset(ram_list.dirty_memory[0]->blocks[i], 0,
+               DIRTY_MEMORY_BLOCK_SIZE / CHAR_BIT);
+    }
+}
+
+static void matrix(void)
+{
+    RAMBlock blocks[3] = {{0}};
+    CrucibleRamRegion descriptors[3] = {{0}};
+    uint8_t backing[3][8 * RAM_PAGE_BYTES];
+
+    memset(backing, 0x65, sizeof(backing));
+    for (unsigned i = 0; i < 3; i++) {
+        blocks[i].host = backing[i];
+        descriptors[i].block = &blocks[i];
+        regions.entries[i] = &descriptors[i];
+    }
+    regions.len = 3;
+    for (unsigned bits = 10; bits <= 16; bits++) {
+        target_page_bits = bits;
+        for (unsigned alignment = 0; alignment < 3; alignment++) {
+            uint64_t start = 3 * TARGET_PAGE_SIZE + (alignment == 0 ? 0 :
+                             alignment == 1 ? 1 : TARGET_PAGE_SIZE - 1);
+
+            for (unsigned i = 0; i < 3; i++) {
+                blocks[i].offset = start + i * 8 * MAX(TARGET_PAGE_SIZE, RAM_PAGE_BYTES);
+                blocks[i].used_length = 5 * RAM_PAGE_BYTES + 1 + i * 997;
+                descriptors[i].descriptor.logical_length = blocks[i].used_length;
+            }
+            for (unsigned mask = 0; mask < 256; mask++) {
+                clear_maps();
+                for (unsigned i = 0; i < 3; i++) {
+                    for (unsigned bit = 0; bit < 8; bit++) {
+                        if (mask & (1U << bit)) {
+                            set_bit((blocks[i].offset >> bits) + bit);
+                        }
+                    }
+                }
+                compare(false);
+            }
+            compare(true);
+        }
+        /* A tiny partial region on either side of a bitmap-block boundary. */
+        regions.len = 2;
+        uint64_t boundary = DIRTY_MEMORY_BLOCK_SIZE << bits;
+        if (boundary <= (ram_addr_t)-1 - 2 * RAM_PAGE_BYTES) {
+            blocks[0].offset = boundary - 2 * RAM_PAGE_BYTES - 3;
+            blocks[0].used_length = 2 * RAM_PAGE_BYTES + 1;
+            blocks[1].offset = boundary + 3;
+            blocks[1].used_length = RAM_PAGE_BYTES + 1;
+            for (unsigned i = 0; i < 2; i++) {
+                descriptors[i].descriptor.logical_length = blocks[i].used_length;
+            }
+            clear_maps();
+            set_bit(DIRTY_MEMORY_BLOCK_SIZE - 1);
+            set_bit(DIRTY_MEMORY_BLOCK_SIZE);
+            compare(false);
+            compare(true);
+        }
+        blocks[0].offset = (BITS_PER_LONG - 1) * TARGET_PAGE_SIZE + 1;
+        blocks[0].used_length = 3 * RAM_PAGE_BYTES + 1;
+        blocks[1].offset = blocks[0].offset + blocks[0].used_length;
+        blocks[1].used_length = RAM_PAGE_BYTES + 1;
+        for (unsigned i = 0; i < 2; i++) {
+            descriptors[i].descriptor.logical_length = blocks[i].used_length;
+        }
+        clear_maps();
+        set_bit(BITS_PER_LONG - 1);
+        set_bit(BITS_PER_LONG);
+        compare(false);
+        compare(true);
+        regions.len = 3;
+    }
+    /* A larger-than-system-profile target page exercises interval expansion. */
+    target_page_bits = 24;
+    regions.len = 1;
+    blocks[0].offset = TARGET_PAGE_SIZE - 17;
+    blocks[0].used_length = 3 * RAM_PAGE_BYTES + 31;
+    descriptors[0].descriptor.logical_length = blocks[0].used_length;
+    clear_maps();
+    set_bit(0);
+    set_bit(1);
+    compare(false);
+    compare(true);
+}
+
+static void coordinate_refusals_and_mutations(void)
+{
+    uint8_t backing[8192] = {0};
+    RAMBlock block = { .offset = 0, .used_length = sizeof(backing), .host = backing };
+    CrucibleRamRegion region = {
+        .block = &block, .descriptor.logical_length = sizeof(backing),
+    };
+    struct qemu_plugin_crucible_ram_page_v1 page;
+    CrucibleRamRegion *selected = NULL;
+    uint64_t offset;
+    ram_addr_t start, end;
+
+    target_page_bits = 12;
+    regions.len = 1;
+    regions.entries[0] = &region;
+    clear_maps();
+    reset_selection(false);
+    assert(qemu_crucible_ram_next_dirty_range(1, 1, &start, &end) == -EINVAL);
+    assert(qemu_crucible_ram_next_dirty_range(0, 1, NULL, &end) == -EINVAL);
+    assert(rcu_entries == 0);
+
+    /* A changed byte without a bitmap notification stays unselected. */
+    uint8_t original_backing[sizeof(backing)];
+
+    memcpy(original_backing, backing, sizeof(backing));
+    backing[0] = 0x66;
+    assert(memcmp(original_backing, backing, sizeof(backing)) != 0);
+    assert(collect(capture_next_page_coordinate, false).count == 0);
+    assert(collect(old_next_page_coordinate, false).count == 0);
+    assert(collect(capture_next_page_coordinate, true).count == 2);
+    assert(collect(old_next_page_coordinate, true).count == 2);
+    set_bit(0);
+    compare(false);
+    assert(ram_list.dirty_memory[0]->blocks[0][0] == 1);
+    assert(ram_list.dirty_memory[1]->blocks[0][0] == 0xf0f0UL);
+
+#ifdef FIXTURE_COUNTED
+    for (unsigned mode = 0; mode < 2; mode++) {
+        NextCoordinate next = mode ? capture_next_page_coordinate :
+                                     old_next_page_coordinate;
+        uint64_t before = dirty_generation;
+
+        reset_selection(false);
+        change_on_word = true;
+        assert(next(&page, &selected, &offset) == 0);
+        assert(dirty_generation == before + 1);
+        assert(capture_dirty_generation == before);
+        assert(ram_list.dirty_memory[0]->blocks[0][0] == 1);
+        assert(rcu_depth == 0 && rcu_entries == rcu_exits);
+    }
+#endif
+
+    clear_maps();
+#ifdef FIXTURE_INDEX_32
+    target_page_bits = 10;
+    assert(qemu_crucible_ram_next_dirty_range(
+               UINT64_C(1) << 63, (UINT64_C(1) << 63) + 1,
+               &start, &end) == -EOVERFLOW);
+    assert(rcu_depth == 0 && rcu_entries == rcu_exits);
+    target_page_bits = 12;
+#endif
+    block.offset = (ram_addr_t)-1 - 4095;
+    reset_selection(false);
+    assert(capture_next_page_coordinate(&page, &selected, &offset) == -EOVERFLOW);
+}
+
+static uint64_t clean_work(void)
+{
+    RAMBlock block = { .offset = 0, .used_length = 4096 * 4096, .host = (void *)0x100000 };
+    CrucibleRamRegion region = { .block = &block, .descriptor.logical_length = 4096 * 4096 };
+
+    target_page_bits = 12;
+    regions.len = 1;
+    regions.entries[0] = &region;
+    clear_maps();
+    collect(old_next_page_coordinate, false);
+    uint64_t old_rcu = rcu_entries, old_words = word_loads;
+
+    collect(capture_next_page_coordinate, false);
+    assert(old_rcu == 4096 && rcu_entries == 1 && rcu_exits == 1);
+    if (word_loads) {
+        assert(old_words == 4096 && word_loads == 4096 / BITS_PER_LONG);
+    }
+    return word_loads;
+}
+
+int main(void)
+{
+    DirtyMemoryBlocks maps[DIRTY_MEMORY_NUM];
+
+    for (unsigned client = 0; client < DIRTY_MEMORY_NUM; client++) {
+        for (unsigned i = 0; i < 3; i++) {
+            maps[client].blocks[i] = calloc(DIRTY_MEMORY_BLOCK_SIZE / BITS_PER_LONG,
+                                          sizeof(unsigned long));
+            assert(maps[client].blocks[i] != NULL);
+        }
+        ram_list.dirty_memory[client] = &maps[client];
+    }
+    maps[1].blocks[0][0] = 0xf0f0UL;
+    matrix();
+    if (cases != EXPECTED_MATRIX_CASES) {
+        fprintf(stderr, "FAIL component matrix coverage: actual=%llu expected=%llu\n",
+                (unsigned long long)cases,
+                (unsigned long long)EXPECTED_MATRIX_CASES);
+        return EXIT_FAILURE;
+    }
+    uint64_t matrix_cases = cases;
+
+    coordinate_refusals_and_mutations();
+    assert(cases == EXPECTED_MATRIX_CASES + 1);
+    uint64_t work = clean_work();
+
+    printf("PASS component cases=%llu tuples=%016llx work=%llu matrix_cases=%llu\n",
+           (unsigned long long)cases, (unsigned long long)tuple_digest,
+           (unsigned long long)work, (unsigned long long)matrix_cases);
+    for (unsigned client = 0; client < DIRTY_MEMORY_NUM; client++) {
+        for (unsigned i = 0; i < 3; i++) {
+            free(maps[client].blocks[i]);
+        }
+    }
+    return 0;
+}
diff --git a/tests/unit/test-crucible-e1000-fingerprint.c b/tests/unit/test-crucible-e1000-fingerprint.c
new file mode 100644
index 0000000000000000000000000000000000000000..a56f97cc637d959e34eacb00cb73c9e4be22e0fc
--- /dev/null
+++ b/tests/unit/test-crucible-e1000-fingerprint.c
@@ -0,0 +1,179 @@
+/*
+ * Intel e1000 fingerprint projection tests
+ *
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+
+#include "qemu/osdep.h"
+
+#include "hw/net/mii.h"
+#include "hw/pci/pci_device.h"
+#include "net/checksum.h"
+#include "net/eth.h"
+#include "net/net.h"
+
+#include "hw/net/e1000_common.h"
+#include "hw/net/e1000-fingerprint.h"
+#include "io/channel-file.h"
+#include "qemu/module.h"
+
+typedef struct E1000TestState {
+    E1000FingerprintState projection;
+    e1000x_txd_props main_tx_props;
+    e1000x_txd_props tso_tx_props;
+    uint8_t tx_header[E1000_FINGERPRINT_HEADER_SIZE];
+    uint8_t tx_data[E1000_FINGERPRINT_DATA_SIZE];
+    uint16_t eeprom_data[E1000_FINGERPRINT_EEPROM_WORDS];
+    uint16_t phy_reg[E1000_FINGERPRINT_PHY_WORDS];
+    uint32_t mac_reg[E1000_FINGERPRINT_MAC_REGS];
+} E1000TestState;
+
+static void initialize_e1000(E1000TestState *state)
+{
+    memset(state, 0, sizeof(*state));
+    state->projection.main_tx_props = &state->main_tx_props;
+    state->projection.tso_tx_props = &state->tso_tx_props;
+    state->projection.tx_header = state->tx_header;
+    state->projection.tx_data = state->tx_data;
+    state->projection.eeprom_data = state->eeprom_data;
+    state->projection.phy_reg = state->phy_reg;
+    state->projection.mac_reg = state->mac_reg;
+}
+
+static GBytes *project_e1000(E1000FingerprintState *state,
+                             bool expected_success)
+{
+    char *path = NULL;
+    int read_fd;
+    int write_fd = g_file_open_tmp("qemu-e1000-fingerprint-XXXXXX", &path,
+                                   NULL);
+    QIOChannelFile *channel;
+    QEMUFile *file;
+    Error *error = NULL;
+    struct stat stat_buffer;
+    bool success;
+
+    g_assert_cmpint(write_fd, >=, 0);
+    read_fd = dup(write_fd);
+    g_assert_cmpint(read_fd, >=, 0);
+    unlink(path);
+    g_free(path);
+    channel = qio_channel_file_new_fd(write_fd);
+    file = qemu_file_new_output(QIO_CHANNEL(channel));
+
+    success = e1000_state_fingerprint_projection(file, state, &error);
+    g_assert_cmpint(success, ==, expected_success);
+    if (!success) {
+        g_assert_nonnull(error);
+        error_free(error);
+        qemu_fclose(file);
+        object_unref(OBJECT(channel));
+
+        g_assert_cmpint(fstat(read_fd, &stat_buffer), ==, 0);
+        g_assert_cmpint(stat_buffer.st_size, ==, 0);
+        close(read_fd);
+        return NULL;
+    }
+    g_assert_null(error);
+    g_assert_cmpint(qemu_fflush(file), ==, 0);
+    g_assert_cmpint(qemu_fclose(file), ==, 0);
+
+    g_assert_cmpint(fstat(read_fd, &stat_buffer), ==, 0);
+    g_autofree uint8_t *data = g_malloc(stat_buffer.st_size);
+    g_assert_cmpint(pread(read_fd, data, stat_buffer.st_size, 0), ==,
+                    stat_buffer.st_size);
+    GBytes *bytes = g_bytes_new(data, stat_buffer.st_size);
+    object_unref(OBJECT(channel));
+    close(read_fd);
+    return bytes;
+}
+
+static void assert_e1000_distinct(E1000TestState *candidate,
+                                  const GBytes *baseline)
+{
+    g_autoptr(GBytes) candidate_bytes =
+        project_e1000(&candidate->projection, true);
+
+    g_assert_false(g_bytes_equal(baseline, candidate_bytes));
+}
+
+static void test_e1000_migrated_state(void)
+{
+    g_autofree E1000TestState *baseline_state = g_new0(E1000TestState, 1);
+    g_autofree E1000TestState *candidate = g_new0(E1000TestState, 1);
+    g_autoptr(GBytes) baseline = NULL;
+
+    initialize_e1000(baseline_state);
+    initialize_e1000(candidate);
+    baseline = project_e1000(&baseline_state->projection, true);
+
+    candidate->projection.rxbuf_size = 1;
+    assert_e1000_distinct(candidate, baseline);
+
+    initialize_e1000(candidate);
+    candidate->projection.eecd_val_in = 1;
+    assert_e1000_distinct(candidate, baseline);
+
+    initialize_e1000(candidate);
+    candidate->main_tx_props.paylen = 1;
+    assert_e1000_distinct(candidate, baseline);
+
+    initialize_e1000(candidate);
+    candidate->projection.tx_size = 1;
+    assert_e1000_distinct(candidate, baseline);
+
+    initialize_e1000(candidate);
+    candidate->tx_header[17] = 1;
+    assert_e1000_distinct(candidate, baseline);
+
+    initialize_e1000(candidate);
+    candidate->tx_data[4097] = 1;
+    assert_e1000_distinct(candidate, baseline);
+
+    initialize_e1000(candidate);
+    candidate->eeprom_data[7] = 1;
+    assert_e1000_distinct(candidate, baseline);
+
+    initialize_e1000(candidate);
+    candidate->phy_reg[3] = 1;
+    assert_e1000_distinct(candidate, baseline);
+
+    initialize_e1000(candidate);
+    candidate->mac_reg[0x1234] = 1;
+    assert_e1000_distinct(candidate, baseline);
+
+    initialize_e1000(candidate);
+    candidate->projection.mit_irq_level = true;
+    assert_e1000_distinct(candidate, baseline);
+
+    initialize_e1000(candidate);
+    candidate->projection.compat_flags = 1 << 3;
+    candidate->projection.tso_state_present = true;
+    candidate->tso_tx_props.mss = 1;
+    assert_e1000_distinct(candidate, baseline);
+}
+
+static void test_e1000_rejects_incomplete_state(void)
+{
+    g_autofree E1000TestState *state = g_new0(E1000TestState, 1);
+
+    initialize_e1000(state);
+    state->projection.mac_reg = NULL;
+    g_assert_null(project_e1000(&state->projection, false));
+
+    initialize_e1000(state);
+    state->projection.tso_state_present = true;
+    state->projection.tso_tx_props = NULL;
+    g_assert_null(project_e1000(&state->projection, false));
+}
+
+int main(int argc, char **argv)
+{
+    module_call_init(MODULE_INIT_QOM);
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/crucible/e1000/migrated-state",
+                    test_e1000_migrated_state);
+    g_test_add_func("/crucible/e1000/incomplete-state",
+                    test_e1000_rejects_incomplete_state);
+    return g_test_run();
+}
diff --git a/tests/unit/test-crucible-fault-node-live.py b/tests/unit/test-crucible-fault-node-live.py
new file mode 100644
index 0000000000000000000000000000000000000000..08f555835821518bbd7c492947809fa45f8f8366
--- /dev/null
+++ b/tests/unit/test-crucible-fault-node-live.py
@@ -0,0 +1,616 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Link ordinary fault custody into a matched, actual system executable.
+
+Requires a complete source-built configured system build with compatible CPU
+and thread layouts. Production constructors and dispatch create every owner;
+the test appends observations to the full node translation unit. The unchanged
+resident-RAM observer supplies its existing ordinary component prerequisite.
+This does not exercise selected Source admission or launched capture ownership.
+"""
+
+import argparse
+import concurrent.futures
+import hashlib
+import json
+import os
+from pathlib import Path
+import shlex
+import subprocess
+
+
+def digest(path):
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def record_command(output, label, command, cwd):
+    (output / f"{label}.command.json").write_text(json.dumps({
+        "argv": command, "cwd": str(cwd),
+    }, indent=2) + "\n")
+    with (output / f"{label}.log").open("w") as log:
+        subprocess.run(command, cwd=cwd, stdout=log,
+                       stderr=subprocess.STDOUT, check=True)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--source-root", type=Path,
+                        default=Path(__file__).resolve().parents[2])
+    parser.add_argument("--build-root", type=Path, required=True)
+    parser.add_argument("--compile-commands", type=Path)
+    parser.add_argument("--resident-plugin", type=Path, required=True)
+    parser.add_argument("--output-dir", type=Path, required=True)
+    parser.add_argument("--event-roundtrip", action="store_true")
+    parser.add_argument("--aggregate", action="store_true")
+    parser.add_argument("--consume-events", action="store_true")
+    parser.add_argument("--prime-genesis", action="store_true")
+    parser.add_argument("--retire-registration", action="store_true",
+                        help="retire the genuine ordinary NODE_HANG owner after actual drainage")
+    parser.add_argument("--machine", choices=("none", "pc"), default="none")
+    parser.add_argument("--bios", type=Path)
+    parser.add_argument("--rr-switch-quantum", type=int, default=1,
+                        help="ordinary aggregate service quantum; guest remains stopped")
+    parser.add_argument("--process-generation", type=int, default=1,
+                        help="ordinary lifecycle generation bound before aggregate commands")
+    parser.add_argument("--watchdog", action="store_true",
+                        help="observe genuine 304-byte watchdog geometry before unchanged terminal stop refusal")
+    parser.add_argument("--emergency", action="store_true",
+                        help="observe actual ordinary emergency body return, retaining other debts")
+    parser.add_argument("--defect", choices=("validation-return", "pending-return",
+                                           "storage-return", "event-arm",
+                                           "event-unknown", "event-producer",
+                                           "stage-return", "stage-handoff", "child-return",
+                                           "reader-return", "json-return", "json-birth",
+                                           "registry-unpublish", "registration-return",
+                                           "registration-post", "restore-entry",
+                                           "json-post", "json-post-return",
+                                           "json-post-retention", "json-journal-return",
+                                           "watchdog-capacity", "envelope-birth", "envelope-transfer",
+                                           "envelope-payload", "envelope-return", "envelope-row",
+                                           "envelope-post", "envelope-post-return",
+                                           "envelope-post-retention", "envelope-restore-transfer"))
+    args = parser.parse_args()
+    if args.defect in ("event-arm", "event-unknown", "event-producer") and not args.event_roundtrip:
+        parser.error("event phase defects require --event-roundtrip")
+    retirement_defects = {"child-return", "reader-return", "json-return", "json-birth",
+                          "registry-unpublish", "registration-return", "registration-post",
+                          "restore-entry", "json-post", "json-post-return",
+                          "json-post-retention", "json-journal-return"}
+    if args.retire_registration and not (args.aggregate and args.prime_genesis):
+        parser.error("registration retirement requires the actual aggregate/genesis route")
+    if args.defect in retirement_defects and not args.retire_registration:
+        parser.error("retirement defects require --retire-registration")
+    if args.emergency and (args.watchdog or not (args.aggregate and args.prime_genesis and args.retire_registration)):
+        parser.error("emergency requires the initialized ordinary aggregate route without watchdog")
+    envelope_post_defects = {"envelope-post", "envelope-post-return", "envelope-post-retention"}
+    if args.defect in envelope_post_defects and not args.emergency:
+        parser.error("envelope post control requires the actual emergency body")
+    if args.defect == "watchdog-capacity" and not args.watchdog:
+        parser.error("watchdog capacity control requires the genuine enabled branch")
+    if args.watchdog and not (args.aggregate and args.prime_genesis and args.retire_registration):
+        parser.error("watchdog requires the complete initialized aggregate/retirement route")
+    if args.prime_genesis and not args.aggregate:
+        parser.error("genesis priming requires --aggregate")
+    if args.defect in ("stage-return", "stage-handoff") and not args.aggregate:
+        parser.error("aggregate staging defects require --aggregate")
+    if not 0 < args.rr_switch_quantum <= 2**31 - 1:
+        parser.error("RR switch quantum must be a positive int32")
+    if not 0 < args.process_generation < 2**64:
+        parser.error("process generation must be a nonzero uint64")
+    root = args.source_root.resolve()
+    build = args.build_root.resolve()
+    output = args.output_dir.resolve()
+    plugin = args.resident_plugin.resolve()
+    output.mkdir(parents=True, exist_ok=True)
+    database = (args.compile_commands or build / "compile_commands.json").resolve()
+
+    # A new CPUClass or thread shape cannot be mixed with old device/target
+    # objects. Rebuilding a few providers does not repair that incompatibility.
+    shapes = ("include/hw/core/cpu.h", "include/qemu/thread.h",
+              "target/i386/cpu.h", "include/plugins/qemu-plugin.h")
+    identities = {}
+    for name in shapes:
+        source_hash = digest(root / name)
+        configured_hash = digest(build.parent / name)
+        identities[name] = {"source": source_hash, "configured": configured_hash}
+    (output / "layout-identities.json").write_text(
+        json.dumps(identities, indent=2) + "\n")
+    if any(row["source"] != row["configured"] for row in identities.values()):
+        raise RuntimeError(
+            "complete matched system objects required; private layouts differ")
+    if plugin.name != "libcrucible-resident-ram-observer.so":
+        raise RuntimeError("the unchanged resident-RAM observer is required")
+
+    ninja = (build / "build.ninja").read_text()
+    begin = ninja.index("build qemu-system-x86_64:")
+    stanza = ninja[begin:ninja.index("\n\n", begin)].splitlines()
+    first = stanza[0].split(": ", 1)[1]
+    rule, inputs = first.split(" ", 1)
+    if rule not in ("c_LINKER", "c_LINKER_RSP") or "$" in inputs:
+        raise RuntimeError("unsupported system link rule; preserve actual build inputs")
+    objects = shlex.split(inputs.split(" | ", 1)[0])
+    link_args = next(line.split(" = ", 1)[1] for line in stanza[1:]
+                     if line.startswith(" LINK_ARGS = "))
+    records = json.loads(database.read_text())
+    selected = []
+    providers = {"../plugins/crucible-startup-source.c",
+                 "../plugins/crucible-native-invocation.c",
+                 "../plugins/core.c", "../plugins/api.c",
+                 "../plugins/api-system.c", "../system/vl.c"}
+    qobjects = {f"../qobject/{name}.c" for name in
+                ("qobject", "qobject-source", "qnum", "qbool", "qdict", "qlist", "qstring")}
+    for row in records:
+        if row["file"] in qobjects:
+            selected.append(row)
+            continue
+        if row["output"] not in objects:
+            continue
+        if row["file"].startswith("../plugins/crucible-fault") or row["file"] in providers:
+            selected.append(row)
+    expected = {"../plugins/crucible-fault.c", "../plugins/crucible-fault-node.c"}
+    if not expected.union(providers).issubset({row["file"] for row in selected}):
+        raise RuntimeError(
+            "actual fault and Source/Native/Core/API providers are required")
+
+    # Each defect removes one journal write from the actual producing body.
+    # It neither creates an owner nor substitutes a callback/provider.
+    defects = {
+        "validation-return": ("crucible-fault-registration.inc.h",
+                              "child->physically_returned = true;\n    post ="),
+        "pending-return": ("crucible-fault-registration.inc.h",
+                           "owner->pending_retirement.physically_returned = true;"),
+        "storage-return": ("crucible-fault-storage.inc.h",
+                           "crucible_node_storage.returning[kind].physically_returned = true;"),
+    }
+    defects.update({
+        "child-return": ("crucible-fault-registration.inc.h",
+                         "child->physically_returned = true;\n        child->post_status = post_status;"),
+        "registration-return": ("crucible-fault-registration.inc.h",
+                                "crucible_node_registrations.returning.physically_returned = true;"),
+        "stage-return": ("crucible-fault-pending.inc.h",
+                         "crucible_fault_pending_custody.stage_retirement.physically_returned = true;"),
+        "stage-handoff": ("crucible-fault-pending.inc.h",
+                          "control->stage = NULL;\n    control->location = CRUCIBLE_PENDING_QUEUED;"),
+    })
+    body = (root / "plugins/crucible-fault-node.c").read_text()
+    command_body = (root / "plugins/crucible-fault.c").read_text()
+    for name in ("crucible-fault-registration.inc.h", "crucible-fault-storage.inc.h",
+                 "crucible-fault-pending.inc.h", "crucible-fault-envelope.inc.h"):
+        contents = (root / "plugins" / name).read_text()
+        if args.defect in defects and defects[args.defect][0] == name:
+            needle = defects[args.defect][1]
+            if contents.count(needle) != 1:
+                raise RuntimeError("physical journal defect requires one exact real write")
+            replacement = "/* Deliberately omitted for causal control. */"
+            if args.defect == "child-return":
+                replacement += ("\n        if (child->kind >= CRUCIBLE_NODE_STORAGE_KINDS + 2) {"
+                                " child->physically_returned = true; }\n"
+                                "        child->post_status = post_status;")
+            if args.defect == "validation-return":
+                replacement += "\n    post ="
+            contents = contents.replace(needle, replacement)
+        included = output / name
+        included.write_text(contents)
+        body = body.replace('"' + name + '"', '"' + str(included) + '"')
+        command_body = command_body.replace('"' + name + '"', '"' + str(included) + '"')
+    envelope_mutations = {
+        "envelope-birth": ("node_registration_child_born(child, body, body, child->issuance);", ""),
+        "envelope-transfer": ("child->envelope_custodian = next;", ""),
+        "envelope-restore-transfer": ("child->envelope_custodian = next;",
+                                     "if (child->envelope_role) { child->envelope_custodian = next; }"),
+        "envelope-payload": ("child->payload_returned = true;", ""),
+        "envelope-return": ("node_registration_child_returned(child, body, issuance, post);", ""),
+        "envelope-row": ("node_registration_child_returned(child, event, child->issuance, post);", ""),
+        "envelope-post": ("\n    post = qemu_thread_is_self(&child->thread) ? 0 : -EPERM;",
+                          "\n    post = child->envelope_role == CRUCIBLE_NODE_ENVELOPE_EMERGENCY_ROLE ? -EIO : 0;"),
+    }
+    if args.defect in envelope_mutations:
+        path = output / "crucible-fault-envelope.inc.h"
+        contents = path.read_text()
+        needle, replacement = envelope_mutations[args.defect]
+        if contents.count(needle) != 1:
+            raise RuntimeError("actual envelope causal boundary changed")
+        path.write_text(contents.replace(needle, replacement or "/* Omitted actual journal effect. */"))
+    if args.defect in envelope_post_defects:
+        path = output / "crucible-fault-envelope.inc.h"
+        contents = path.read_text()
+        if args.defect != "envelope-post":
+            needle, replacement = envelope_mutations["envelope-post"]
+            if contents.count(needle) != 1:
+                raise RuntimeError("actual envelope post boundary changed")
+            contents = contents.replace(needle, replacement)
+        if args.defect == "envelope-post-return":
+            needle = "node_registration_child_returned(child, body, issuance, post);"
+            contents = contents.replace(needle,
+                "if (child->envelope_role != CRUCIBLE_NODE_ENVELOPE_EMERGENCY_ROLE) { " + needle + " }")
+        path.write_text(contents)
+        if args.defect == "envelope-post-retention":
+            path = output / "crucible-fault-registration.inc.h"
+            contents = path.read_text()
+            needle = "child->post_status = post_status;"
+            if contents.count(needle) != 1:
+                raise RuntimeError("actual child post receipt changed")
+            path.write_text(contents.replace(needle,
+                "if (child->kind != CRUCIBLE_NODE_ENVELOPE_CHILD || "
+                "child->envelope_role != CRUCIBLE_NODE_ENVELOPE_EMERGENCY_ROLE) { " + needle + " }"))
+    if args.defect == "reader-return":
+        needle = "child->callback_returned = true;"
+        if body.count(needle) != 1:
+            raise RuntimeError("reader return write changed")
+        body = body.replace(needle, "/* Deliberately omitted reader return. */")
+    if args.defect == "registry-unpublish":
+        needle = "g_ptr_array_remove_index(crucible_fault_handlers, position);"
+        if command_body.count(needle) != 1:
+            raise RuntimeError("actual registry removal changed")
+        command_body = command_body.replace(needle, "/* Deliberately omitted removal. */")
+    if args.defect == "registration-post":
+        path = output / "crucible-fault-registration.inc.h"
+        contents = path.read_text()
+        needle = "/* Only the external cursor is read after producer free. */"
+        if contents.count(needle) != 1:
+            raise RuntimeError("terminal post boundary changed")
+        start, tail = contents.split(needle)
+        tail = tail.replace("crucible_node_registrations.returning.post_status = post;",
+                            "post = -EIO;\n    crucible_node_registrations.returning.post_status = post;", 1)
+        path.write_text(start + needle + tail)
+    observed_lifecycle = None
+    if args.watchdog:
+        lifecycle_body = (root / "plugins/crucible-fault-lifecycle.c").read_text()
+        needle = "    g_assert(rule && evidence && evidence_len != 0);"
+        if lifecycle_body.count(needle) != 1:
+            raise RuntimeError("actual terminal geometry boundary changed")
+        lifecycle_body = lifecycle_body.replace(needle,
+            "    extern void crucible_fault_node_live_watchdog_observe(\n"
+            "        const QemuCrucibleFaultRule *, const uint8_t *, size_t);\n"
+            "    crucible_fault_node_live_watchdog_observe(rule, evidence, evidence_len);\n" + needle)
+        if args.defect == "watchdog-capacity":
+            needle = "CRUCIBLE_LIFECYCLE_EVIDENCE_BYTES)) : 0;"
+            if lifecycle_body.count(needle) != 1:
+                raise RuntimeError("actual watchdog geometry producer changed")
+            lifecycle_body = lifecycle_body.replace(
+                needle, "CRUCIBLE_HANG_EVIDENCE_BYTES)) : 0;")
+        observed_lifecycle = output / "actual-lifecycle-with-observations.c"
