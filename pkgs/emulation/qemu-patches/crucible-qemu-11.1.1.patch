+    production += "\n" + leaf
+    production += "\n\n".join(definition(api, signature) for signature in [
+        "static void qemu_plugin_trace_stop_context(CrucibleStopContextPhase phase)\n{",
+        "static int qemu_plugin_crucible_vmstop_begin(bool ordinary)",
+        "int qemu_plugin_crucible_vmstop_admit_internal(void)",
+        "bool qemu_plugin_crucible_vmstop_pending(void)",
+        "bool qemu_plugin_crucible_vmstop_quiesced(void)",
+        "static bool qemu_plugin_quiesced_control_boundary_available(void)\n{",
+        "static void qemu_plugin_rearm_deferred_control_boundary(void)\n{",
+        "void qemu_plugin_crucible_vmstop_request_stopped(int flush_status)",
+        "void qemu_plugin_crucible_rr_control_boundary_defer(void)",
+        "static void qemu_plugin_wake_fd_read(void *opaque)\n{",
+    ])
+    if arguments.negative_control == "disabled":
+        production = production.replace(
+            "    if (!rr_crucible_sim_control_delivery_trace_enabled()) {\n        return;\n    }",
+            "    (void)rr_crucible_sim_control_delivery_trace_enabled();", 1)
+    elif arguments.negative_control == "ownership":
+        production = production.replace("!qatomic_read(&first_cpu->running)", "true", 1)
+    elif arguments.negative_control == "dedup":
+        production = production.replace("    if (!emit) {\n        return;\n    }", "    (void)emit;", 1)
+    generated = arguments.output_dir / "stop-context.c"
+    prelude = PRELUDE.replace("@SOURCE_HEADER@", str(ROOT / "plugins/crucible-startup-source.h"))
+    prelude = prelude.replace("@RECEIVING_HEADER@", str(ROOT / "plugins/crucible-checkpoint-receiving.h"))
+    prelude = prelude.replace("@CONTROL_HEADER@", str(ROOT / "plugins/crucible-control-stop.h"))
+    generated.write_text(prelude + dependencies + production + CHECKS)
+    binary = arguments.output_dir / "stop-context"
+    command = [os.environ.get("CC", "cc"), *shlex.split(os.environ.get("CFLAGS", "")),
+               "-Wno-missing-prototypes", "-Wno-unused-function", "-Wno-unused-variable",
