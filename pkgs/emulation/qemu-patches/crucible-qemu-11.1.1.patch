+    out->fault_commands_data_extent = out->fault_commands_entry_count * UINT64_C(256);
+
+    if (out->fault_commands_data_extent > UINT64_MAX - out->fault_commands_data_offset) {
+        return -EOVERFLOW;
+    }
+    out->fault_commands_end = out->fault_commands_data_offset + out->fault_commands_data_extent;
+
+    if (out->fault_commands_end > UINT64_MAX - UINT64_C(127)) {
+        return -EOVERFLOW;
