+QemuCrucibleNativeRegistration *qemu_plugin_crucible_native_registrar_attach_v1(
+    QemuCrucibleNativeRegistrar *registrar, struct qemu_plugin_ctx *ctx,
+    const void *descriptor, void *function, void *userdata,
+    enum QemuCrucibleNativeInvocationKind kind)
+{
+    QemuCrucibleNativeInvocationRegistry *registry = registrar->registry;
+    QemuCrucibleNativeRegistration *available = NULL;
+    pid_t process;
+    size_t i;
+
+    if (!registry || !registrar->authenticated || !descriptor || !function ||
+        kind == QEMU_CRUCIBLE_NATIVE_TRANSLATED || kind == QEMU_CRUCIBLE_NATIVE_MEMORY ||
+        kind == QEMU_CRUCIBLE_NATIVE_UNQUALIFIED) {
+        return NULL;
+    }
+    process = getpid();
+    if (!registry_process_current(registry, process)) {
+        return NULL;
+    }
+    qemu_mutex_lock(&registry->mutex);
+    if (!registry_identity_locked(registry, process) || registry->revoked ||
+        registry->source_registrar != registrar->borrow ||
+        registry->source_registrar_serial != registrar->serial ||
+        registry->registrar_users != 1 || registry->child_owner != registrar->owner ||
+        ctx != registrar->ctx || ctx != registry->ctx ||
+        registrar->module != registry->module || registry->serial == UINT64_MAX) {
+        registrar->first_status = -ESTALE;
+    } else {
+        for (i = 0; i < ARRAY_SIZE(registry->registrations); i++) {
+            QemuCrucibleNativeRegistration *record = &registry->registrations[i];
+
+            if (!record->descriptor_retained && !record->references && !available) {
+                available = record;
+            }
+        }
+        if (available) {
+            *available = (QemuCrucibleNativeRegistration) {
+                .owner = registry,
+                .child_owner = registrar->owner,
+                .ctx = ctx,
+                .module = registrar->module,
+                .publication_serial = registrar->publication_serial,
+                .registrar_serial = registrar->serial,
+                .family = registrar->family,
+                .descriptor_retained = true,
+                .coordinate = descriptor,
+                .function = function,
+                .userdata = userdata,
+                .serial = ++registry->serial,
+                .kind = kind,
+            };
+            registrar->registration = available;
+        } else {
+            registrar->first_status = -ENOSPC;
+        }
+    }
+    if (registrar->first_status && !registry->first_registration_status) {
+        registry->first_registration_status = registrar->first_status;
+    }
+    qemu_mutex_unlock(&registry->mutex);
+    return available;
+}
+
+void qemu_plugin_crucible_native_registrar_finish_v1(
+    QemuCrucibleNativeRegistrar *registrar)
+{
+#ifndef CONFIG_USER_ONLY
+    QemuCrucibleNativeInvocationRegistry *registry = registrar->registry;
+    QemuCrucibleCallbackRegistrationBorrow *borrow = registrar->borrow;
+    int post = 0;
+    int returned;
+
+    if (!borrow) {
+        return;
+    }
+    if (registrar->authenticated) {
+        post = qemu_crucible_startup_source_callback_registration_current_v1(
+            borrow, registrar->serial, registrar->family);
+    }
+    /* Return the genuine Source borrower only after the actual publication
+     * effect. Its successful return leaves Native's descriptor owner retained. */
+    returned = qemu_crucible_startup_source_callback_registration_return_v1(
+        &registrar->borrow, registrar->serial);
+    if (!registry || !registry_process_current(registry, getpid())) {
+        return;
+    }
+    qemu_mutex_lock(&registry->mutex);
+    if (registry->source_registrar == borrow &&
+        registry->source_registrar_serial == registrar->serial) {
+        if (!returned) {
+            assert(registry->registrar_users == 1);
+            registry->registrar_users--;
+            registry->source_registrar = NULL;
+            registry->source_registrar_serial = 0;
+        }
+        if (registrar->registration && registrar->registration->owner == registry &&
+            registrar->registration->registrar_serial == registrar->serial) {
+            QemuCrucibleNativeRegistration *record = registrar->registration;
+
+            record->source_authenticated = !registrar->first_status && !post && !returned;
+            record->active = record->source_authenticated &&
+                record->descriptor_retained && !registry->revoked;
+            if (record->source_authenticated && !registry->revoked) {
+                registry->binding_attempted = true;
+                registry->bound = true;
+            }
+        }
+        int status = registrar->first_status ? registrar->first_status : post ? post : returned;
+
+        if (status && !registry->first_registration_status) {
+            registry->first_registration_status = status;
+        }
+    }
+    qemu_mutex_unlock(&registry->mutex);
+#else
+    (void)registrar;
+#endif
+}
