+static void advance_authority(uint64_t *authority, const char *name)
+{
+    uint64_t current = qatomic_read(authority);
+
+    for (;;) {
+        uint64_t observed;
+
+        if (current == UINT64_MAX) {
+            error_report("logical RAM %s authority exhausted", name);
+            abort();
+        }
+        observed = qatomic_cmpxchg(authority, current, current + 1);
+        if (observed == current) {
+            return;
+        }
+        current = observed;
+    }
+}
