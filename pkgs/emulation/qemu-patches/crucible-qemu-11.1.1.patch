+typedef struct RRPreparkRaceFixture {
+    QemuEvent wake_event;
+    unsigned int state;
+    uint64_t publish_generation;
+} RRPreparkRaceFixture;
+
+static void *rr_prepark_publish_after_final_check(void *opaque)
+{
+    RRPreparkRaceFixture *fixture = opaque;
+    unsigned int claimed_state = UINT_MAX;
+
+    while (!rr_crucible_sim_wake_try_claim(
+               &fixture->state, &claimed_state)) {
+        cpu_relax();
+    }
+    rr_crucible_sim_wake_publish(
+        &fixture->state, claimed_state, &fixture->publish_generation);
+    qemu_event_set(&fixture->wake_event);
+    return NULL;
+}
+
+static void test_rr_prepark_event_catches_postcheck_publication(void)
+{
+    RRPreparkRaceFixture fixture = {
+        .state = RR_TCG_EXEC_IDLE,
+        .publish_generation = 0,
+    };
+    RRCrucibleSimWakeSnapshot snapshot = { 0 };
+    uint64_t consumed_generation = 0;
+    QemuThread producer;
+
+    qemu_event_init(&fixture.wake_event, true);
+    qemu_event_reset(&fixture.wake_event);
+    g_assert_true(rr_crucible_sim_wake_consume_snapshot(
+        &fixture.state, &fixture.publish_generation, consumed_generation,
+        &snapshot));
+    g_assert_cmpint(rr_crucible_sim_wake_try_collapse(
+                        &fixture.state, &fixture.publish_generation,
+                        &consumed_generation, &snapshot), ==,
+                    RR_TCG_WAKE_CONSUME_EMPTY);
+    g_assert_false(rr_crucible_sim_prepark_requires_rescan(
+        false, false, false, false, false, false, false));
+
+    /* Start the producer after the final scan; its event must remain set. */
+    qemu_thread_create(&producer, "rr-prepark-producer",
+                       rr_prepark_publish_after_final_check, &fixture,
+                       QEMU_THREAD_JOINABLE);
+    qemu_event_wait(&fixture.wake_event);
+    qemu_thread_join(&producer);
+
+    g_assert_true(rr_crucible_sim_wake_consume_snapshot(
+        &fixture.state, &fixture.publish_generation, consumed_generation,
+        &snapshot));
+    g_assert_cmpint(rr_crucible_sim_wake_try_collapse(
+                        &fixture.state, &fixture.publish_generation,
+                        &consumed_generation, &snapshot), ==,
+                    RR_TCG_WAKE_CONSUME_PENDING);
+    qemu_event_destroy(&fixture.wake_event);
+}
