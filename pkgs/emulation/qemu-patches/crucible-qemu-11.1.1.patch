index 0000000000000000000000000000000000000000..edbcd8d9c4806dd34ea2968e517ff4e2d79c4f37
--- /dev/null
+++ b/tests/tcg/plugins/crucible-exact-tb-exit.c
@@ -0,0 +1,136 @@
+/*
+ * Crucible exact translated-block exit test plugin
+ *
+ * Copyright (c) Andyl, Inc.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include <stdbool.h>
+#include <inttypes.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include <qemu-plugin.h>
+#include "crucible-resident-ram.h"
+
+QEMU_PLUGIN_EXPORT int qemu_plugin_version = QEMU_PLUGIN_VERSION;
+
+static int result_fd = -1;
+static uint64_t target_entry_icount;
+static uint64_t target_icount;
+static uint64_t target_tb_insns;
+static bool target_entry_valid;
+static bool exit_pending;
+
+static void finish(const char *verdict, uint64_t boundary_icount)
+{
+    char result[192];
+    int length = snprintf(result, sizeof(result),
+                          "%s trap_icount=%" PRIu64
+                          " boundary_icount=%" PRIu64 "\n",
+                          verdict, target_icount, boundary_icount);
+
+    if (length <= 0 || (size_t)length >= sizeof(result) ||
+        write(result_fd, result, length) != (ssize_t)length) {
+        _exit(91);
+    }
+    qemu_plugin_request_shutdown(strcmp(verdict, "PASS") != 0);
+}
+
+static uint64_t unlimited_icount(void *userdata)
+{
+    (void)userdata;
+    return UINT64_MAX;
+}
+
+static void observe_boundary(uint64_t current_icount, void *userdata)
+{
+    uint64_t expected_icount;
+
+    (void)userdata;
+    if (!exit_pending) {
+        return;
+    }
+
+    exit_pending = false;
+    expected_icount = target_icount + 1;
+    finish(current_icount == expected_icount ? "PASS" : "FAIL",
+           current_icount);
+}
+
+static void observe_target_tb_entry(unsigned int vcpu_index, void *userdata)
+{
+    uint64_t tb_insns = (uintptr_t)userdata;
+
+    (void)vcpu_index;
+    target_entry_valid =
+        qemu_plugin_icount_at_tb_entry(tb_insns,
+                                       &target_entry_icount) == 0;
+}
+
+static void request_exact_exit(unsigned int vcpu_index, void *userdata)
+{
+    (void)vcpu_index;
+    (void)userdata;
+    if (!target_entry_valid) {
+        finish("FAIL", qemu_plugin_icount_raw());
+        return;
+    }
+
+    target_icount = target_entry_icount + target_tb_insns - 1;
+    if (qemu_plugin_crucible_force_vcpu_tb_exit() != 0) {
+        finish("FAIL", qemu_plugin_icount_raw());
+        return;
+    }
+    exit_pending = true;
+}
+
+static void translate_tb(struct qemu_plugin_tb *tb, void *userdata)
+{
+    size_t count = qemu_plugin_tb_n_insns(tb);
+
+    (void)userdata;
+    for (size_t index = 0; index < count; index++) {
+        struct qemu_plugin_insn *insn = qemu_plugin_tb_get_insn(tb, index);
+        uint8_t bytes[2];
+
+        if (qemu_plugin_insn_data(insn, bytes, sizeof(bytes)) != sizeof(bytes) ||
+            bytes[0] != 0xe6 || bytes[1] != 0xe7) {
+            continue;
+        }
+        if (index + 1 != count || target_tb_insns != 0) {
+            finish("FAIL", qemu_plugin_icount_raw());
+            return;
+        }
+
+        target_tb_insns = count;
+        qemu_plugin_register_vcpu_tb_exec_cb(
+            tb, observe_target_tb_entry, QEMU_PLUGIN_CB_NO_REGS,
+            (void *)(uintptr_t)count);
+        qemu_plugin_register_vcpu_insn_exec_cb(
+            insn, request_exact_exit, QEMU_PLUGIN_CB_NO_REGS, NULL);
+    }
+}
+
+QEMU_PLUGIN_EXPORT int qemu_plugin_install(qemu_plugin_id_t id,
+                                           const qemu_info_t *info,
+                                           int argc, char **argv)
+{
+    (void)info;
+    for (int index = 0; index < argc; index++) {
+        if (strncmp(argv[index], "result-fd=", 10) == 0) {
+            result_fd = atoi(argv[index] + 10);
+        }
+    }
+    if (result_fd < 0 || crucible_fixture_install_resident_ram() != 0) {
+        return -1;
+    }
+
+    qemu_plugin_register_sim_shmem_observer_cb(
+        observe_boundary, unlimited_icount, NULL);
+    qemu_plugin_register_vcpu_tb_trans_cb(id, translate_tb, NULL);
+    return 0;
+}
