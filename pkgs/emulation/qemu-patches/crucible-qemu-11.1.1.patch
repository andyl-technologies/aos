+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    observed_ps = 10501;
+    initialize_clock(true);
+    nvme_set_timestamp(&controller, cpu_to_le64(0xffffffffffffULL));
+    observed_ps += NVME_PICOSECONDS_PER_MILLISECOND;
+    timestamp = le64_to_cpu(nvme_get_timestamp(&controller));
+    g_assert_cmpuint(timestamp & 0xffffffffffffULL, ==, 0);
+    g_assert_cmpuint((timestamp >> 49) & 7, ==, 1);
+
+    observed_ps += 123;
+    nvme_set_timestamp(&controller, 0);
+    observed_ps += NVME_PICOSECONDS_PER_MILLISECOND - 1;
+    g_assert_cmpuint(le64_to_cpu(nvme_get_timestamp(&controller)), ==, 0);
+    observed_ps++;
+    g_assert_cmpuint(le64_to_cpu(nvme_get_timestamp(&controller)), ==, 1);
+}
+
+static uint64_t read_smart_hours(NvmeCtrl *controller)
+{
+    NvmeSmartLog log = { 0 };
+    NvmeRequest request = { 0 };
+    uint16_t status;
+
+    /* Exercise real PRP/CMB mapping and IOV copy without backend or DMA IO. */
+    controller->page_size = 4096;
+    controller->cmb.cmse = true;
+    controller->cmb.cba = 0x10000;
+    controller->cmb.mem.size = int128_make64(sizeof(log));
+    controller->cmb.buf = (uint8_t *)&log;
+    request.cmd.dptr.prp1 = cpu_to_le64(controller->cmb.cba);
+    request.cmd.nsid = cpu_to_le32(0xffffffff);
+    status = nvme_smart_info(controller, true, sizeof(log), 0, &request);
+    g_assert_cmpuint(status, ==, NVME_SUCCESS);
+    nvme_sg_unmap(&request.sg);
+    controller->cmb.buf = NULL;
+    return le64_to_cpu(log.power_on_hours[0]);
+}
+
+static void test_smart_hours_boundary(void)
+{
+    NvmeCtrl controller = { 0 };
+    __int128 origin;
+    __int128 hour_ps = (__int128)3600 * PICOSECONDS_PER_SECOND;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    observed_ps = 10501;
+    initialize_clock(true);
+    origin = observed_ps;
+    g_assert_true(nvme_capture_clock_origin(&controller.starttime_ms,
+                                           &controller.starttime_phase_ps));
+    observed_ps = hour_ps;
+    g_assert_cmpuint(read_smart_hours(&controller), ==, 0);
+    observed_ps = origin + hour_ps - 1;
+    g_assert_cmpuint(read_smart_hours(&controller), ==, 0);
+    observed_ps++;
+    g_assert_cmpuint(read_smart_hours(&controller), ==, 1);
+}
+
+static void test_origin_range(void)
+{
+    uint64_t milliseconds = 17;
+    uint32_t phase = 19;
+    uint64_t elapsed = 23;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    initialize_clock(true);
+    observed_ps = -1;
+    g_assert_false(nvme_capture_clock_origin(&milliseconds, &phase));
+    g_assert_cmpuint(milliseconds, ==, 17);
+    g_assert_cmpuint(phase, ==, 19);
+    observed_ps = ((__int128)UINT64_MAX + 1) *
+                  NVME_PICOSECONDS_PER_MILLISECOND;
+    g_assert_false(nvme_capture_clock_origin(&milliseconds, &phase));
+    g_assert_cmpuint(milliseconds, ==, 17);
+    g_assert_cmpuint(phase, ==, 19);
+    g_assert_false(nvme_elapsed_clock_ms(0, 0, &elapsed));
+    g_assert_cmpuint(elapsed, ==, 23);
+    observed_ps = 0;
+    g_assert_false(nvme_elapsed_clock_ms(1, 0, &elapsed));
+    g_assert_false(nvme_elapsed_clock_ms(0, 1000000000, &elapsed));
+    g_assert_cmpuint(elapsed, ==, 23);
+}
+
+static void test_origin_migration(void)
+{
+    NvmeCtrl controller = { 0 };
+    QIOChannelBuffer *buffer;
+    QIOChannelBuffer *input;
+    QEMUFile *file;
+    Error *error = NULL;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    observed_ps = 10501;
+    initialize_clock(true);
+    nvme_set_timestamp(&controller, cpu_to_le64(123));
+    controller.starttime_phase_ps = 999999999;
+    g_assert_true(nvme_clock_phase_needed(&controller));
+
+    /* Serialize the actual optional subsection with QEMU's real VMState IO. */
+    buffer = qio_channel_buffer_new(64);
+    file = qemu_file_new_output(QIO_CHANNEL(buffer));
+    g_assert_cmpint(vmstate_save_state(file, &nvme_vmstate_clock_phase,
+                                      &controller, NULL, &error), ==, 0);
+    g_assert_null(error);
+    qemu_put_byte(file, 0);
+    qemu_fflush(file);
+    input = qio_channel_buffer_new(buffer->usage);
+    input->usage = buffer->usage;
+    g_assert_cmpuint(input->usage, ==, 9);
+    memcpy(input->data, buffer->data, buffer->usage);
+    g_assert_cmpint(qemu_fclose(file), ==, 0);
+    object_unref(OBJECT(buffer));
+
+    g_assert_true(nvme_ctrl_pre_load(&controller, &error));
+    g_assert_false(nvme_clock_phase_needed(&controller));
+    file = qemu_file_new_input(QIO_CHANNEL(input));
+    g_assert_cmpint(vmstate_load_state(file, &nvme_vmstate_clock_phase,
+                                      &controller, 1, &error), ==, 0);
+    g_assert_cmpint(qemu_fclose(file), ==, 0);
+    g_assert_null(error);
+    g_assert_cmpuint(controller.timestamp_set_phase_ps, ==, 10501);
+    g_assert_cmpuint(controller.starttime_phase_ps, ==, 999999999);
+    observed_ps += NVME_PICOSECONDS_PER_MILLISECOND - 1;
+    g_assert_cmpuint(le64_to_cpu(nvme_get_timestamp(&controller)) &
+                     0xffffffffffffULL, ==, 123);
+    observed_ps++;
+    g_assert_cmpuint(le64_to_cpu(nvme_get_timestamp(&controller)) &
+                     0xffffffffffffULL, ==, 124);
+    object_unref(OBJECT(input));
+}
+
+static void test_legacy_phase_default(void)
+{
+    NvmeCtrl controller = {
+        .timestamp_set_qemu_clock_ms = 10,
+        .starttime_ms = 7,
+        .timestamp_set_phase_ps = 501,
+        .starttime_phase_ps = 999999999,
+    };
+    Error *error = NULL;
+
+    g_assert_true(nvme_ctrl_pre_load(&controller, &error));
+    g_assert_null(error);
+    g_assert_cmpuint(controller.timestamp_set_qemu_clock_ms, ==, 10);
+    g_assert_cmpuint(controller.starttime_ms, ==, 7);
+    g_assert_false(nvme_clock_phase_needed(&controller));
+}
+
+static void test_invalid_migration_phase(void)
+{
+    NvmeCtrl controller = { 0 };
+    QIOChannelBuffer *input;
+    QEMUFile *file;
+    Error *error = NULL;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    initialize_clock(true);
+    for (unsigned field = 0; field < 2; field++) {
+        input = qio_channel_buffer_new(9);
+        input->usage = 9;
+        memset(input->data, 0, input->usage);
+        stl_be_p(input->data + field * sizeof(uint32_t), 1000000000);
+        g_assert_true(nvme_ctrl_pre_load(&controller, &error));
+        file = qemu_file_new_input(QIO_CHANNEL(input));
+        g_assert_cmpint(vmstate_load_state(file, &nvme_vmstate_clock_phase,
+                                          &controller, 1, &error), <, 0);
+        g_assert_nonnull(error);
+        error_free(error);
+        error = NULL;
+        qemu_fclose(file);
+        object_unref(OBJECT(input));
+    }
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_data_func("/nvme/timestamp/fractional-origin",
+                         GINT_TO_POINTER(true), test_timestamp_boundary);
+    g_test_add_data_func("/nvme/timestamp/non-tcg-origin",
+                         GINT_TO_POINTER(false), test_timestamp_boundary);
+    g_test_add_func("/nvme/timestamp/rebase-wrap",
+                    test_timestamp_rebase_and_wrap);
+    g_test_add_func("/nvme/smart/hour-boundary", test_smart_hours_boundary);
+    g_test_add_func("/nvme/clock/range-refusal", test_origin_range);
+    g_test_add_func("/nvme/migration/origin-roundtrip", test_origin_migration);
+    g_test_add_func("/nvme/migration/legacy-default",
+                    test_legacy_phase_default);
+    g_test_add_func("/nvme/migration/invalid-phase",
+                    test_invalid_migration_phase);
+    return g_test_run();
+}
