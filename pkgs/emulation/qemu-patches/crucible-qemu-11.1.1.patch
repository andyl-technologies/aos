+            &event, gicv3_cpuif_crucible_inject, cs)) {
+        gicv3_cpuif_crucible_clear_pending(cs, irq);
+        if (event.disposition == 1 && !edge) {
+            if (irq < GIC_INTERNAL && extract32(cs->level, irq, 1)) {
+                cs->gicr_ipendr0 |= 1U << irq;
+                gicv3_redist_update(cs);
+            } else if (irq < cs->gic->num_irq &&
+                       gicv3_gicd_level_test(cs->gic, irq)) {
+                cs->gic->crucible_interrupt_target[irq] =
+                    event.target_vcpu;
+                gicv3_gicd_pending_set(cs->gic, irq);
+                gicv3_update(cs->gic, irq, 1);
+            }
