+bool arm_cpu_validate_fault_exception(
+    CPUState *cs, const CPUFaultException *exception)
+{
+    ARMCPU *cpu = ARM_CPU(cs);
+    bool abort = exception->vector == CPU_FAULT_AARCH64_INSTRUCTION_ABORT ||
+                 exception->vector == CPU_FAULT_AARCH64_DATA_ABORT;
+    uint32_t syndrome = exception->syndrome;
+    uint32_t exception_class = syn_get_ec(syndrome);
+    bool syndrome_valid = false;
+
+    if (exception->architecture == CPU_FAULT_EXCEPTION_AARCH64 &&
+        exception->record == CPU_FAULT_EXCEPTION_AARCH64_RAS) {
+        const bool asynchronous = exception->aarch64_ras.asynchronous;
+        const uint32_t aet = exception->syndrome & (7U << 10);
+        const uint32_t set = exception->syndrome & (3U << 11);
+        const bool serror_syndrome_matches =
+            exception->syndrome ==
+                syn_serror(exception->aarch64_ras.disr & 0x1ffffff);
+        const bool address_matches =
+            exception->aarch64_ras.has_far ==
+                exception->has_fault_address &&
+            (!exception->has_fault_address ||
+             exception->aarch64_ras.far == exception->fault_address);
+
+        return is_a64(&cpu->env) && cpu_isar_feature(aa64_ras, cpu) &&
+            !exception->aarch64_ras.corrected &&
+            exception->syndrome <= UINT32_MAX &&
+            exception->aarch64_ras.esr == exception->syndrome &&
+            address_matches &&
+            exception->maskable == asynchronous &&
+            (asynchronous ?
+             (exception->vector == EC_SERROR &&
+              syn_get_ec(exception->syndrome) == EC_SERROR &&
+              exception->aarch64_ras.has_disr &&
+              serror_syndrome_matches &&
+              aet == (exception->aarch64_ras.fatal ? 0 : (3U << 10)) &&
+              !exception->has_fault_address) :
+             (exception->vector == CPU_FAULT_AARCH64_DATA_ABORT &&
+              syn_get_ec(exception->syndrome) ==
+                  (arm_current_el(&cpu->env) == 0 ?
+                       EC_DATAABORT : EC_DATAABORT_SAME_EL) &&
+              exception->has_fault_address &&
+              (exception->syndrome & 0x3f) == 0x10 &&
+              set == (exception->aarch64_ras.fatal ? (2U << 11) : 0) &&
+              !exception->aarch64_ras.has_disr));
+    }
+    switch (exception->vector) {
+    case CPU_FAULT_AARCH64_UNDEFINED:
+        syndrome_valid = syndrome == syn_uncategorized();
+        break;
+    case CPU_FAULT_AARCH64_INSTRUCTION_ABORT:
+        syndrome_valid = (exception_class == EC_INSNABORT ||
+                          exception_class == EC_INSNABORT_SAME_EL) &&
+            FIELD_EX32(syndrome, SYNDROME, IL) &&
+            !(syndrome & 0x01ff0000U) &&
+            exception->has_fault_address;
+        break;
+    case CPU_FAULT_AARCH64_DATA_ABORT:
+        syndrome_valid = (exception_class == EC_DATAABORT ||
+                          exception_class == EC_DATAABORT_SAME_EL) &&
+            FIELD_EX32(syndrome, SYNDROME, IL) &&
+            !(syndrome & 0x01ff8000U) &&
+            exception->has_fault_address;
+        break;
+    case CPU_FAULT_AARCH64_BREAKPOINT:
+        syndrome_valid = exception_class == EC_AA64_BKPT &&
+            FIELD_EX32(syndrome, SYNDROME, IL) &&
+            !(syndrome & 0x01ff0000U);
+        break;
+    default:
+        break;
+    }
+    return exception->architecture == CPU_FAULT_EXCEPTION_AARCH64 &&
+           exception->record == CPU_FAULT_EXCEPTION_ARCHITECTURE_DEFAULT &&
+           exception->syndrome <= UINT32_MAX &&
+           syndrome_valid && !exception->maskable &&
+           (exception->vector == CPU_FAULT_AARCH64_UNDEFINED || abort ||
+            exception->vector == CPU_FAULT_AARCH64_BREAKPOINT) &&
+           (abort || !exception->has_fault_address);
+}
