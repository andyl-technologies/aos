+    g_assert_cmpint(coordinator_test.submitted_child_pid, ==, 12345);
+    g_assert_cmpint(coordinator_test.parent_child_pid, ==, 23456);
+    g_assert_cmpint(coordinator_test.submitter_thread_id, !=,
+                    coordinator_test.main_thread_id);
+    g_assert_cmpuint(coordinator_test.prepare_calls, ==, 0);
+    g_assert_cmpuint(coordinator_test.parent_calls, ==, 0);
+    g_assert_cmpuint(coordinator_test.child_calls, ==, 0);
