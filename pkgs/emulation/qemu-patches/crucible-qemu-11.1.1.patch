+static void test_tb_trans(struct qemu_plugin_tb *tb, void *opaque)
+{
+    size_t count = qemu_plugin_tb_n_insns(tb);
+
+    (void)opaque;
+    if ((qemu_plugin_tb_vaddr(tb) & ~UINT64_C(0xfff)) ==
+        (test_pc & ~UINT64_C(0xfff))) {
+        test_guest_code_ready = true;
+    }
+    for (size_t i = 0; i < count; i++) {
+        struct qemu_plugin_insn *insn = qemu_plugin_tb_get_insn(tb, i);
+
+        if (qemu_plugin_insn_vaddr(insn) == test_pc) {
+            test_target_translations++;
+            if (test_rule_installed) {
+                test_target_translations_after_install++;
+            }
+            test_target_tb_instructions = count;
+            test_target_tb_pc = qemu_plugin_tb_vaddr(tb);
+            test_target_tb_index = i;
+            test_translated_instruction_len = qemu_plugin_insn_data(
+                insn, test_translated_instruction,
+                sizeof(test_translated_instruction));
+        }
+    }
+    qemu_plugin_register_vcpu_tb_exec_cb(
+        tb, test_tb_exec, QEMU_PLUGIN_CB_NO_REGS, NULL);
+}
