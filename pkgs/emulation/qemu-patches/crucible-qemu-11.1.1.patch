+
+static __int128 observed_ps;
+static unsigned nanosecond_reads;
+
+/* Diagnostic CPU-clock adapter, not an installed TCG/controller provider. */
+int64_t cpu_get_clock(void)
+{
+    __int128 nanoseconds = observed_ps / PICOSECONDS_PER_NANOSECOND;
+
+    nanosecond_reads++;
+    if (nanoseconds < 0 || nanoseconds > INT64_MAX) {
+        g_error("Diagnostic nanosecond projection exceeds the API range");
+    }
+    return nanoseconds;
+}
+
+bool icount_crucible_sim_mode(void)
+{
+    return false;
+}
+
+static __int128 observed_clock_ps(void)
+{
+    return observed_ps;
+}
+
+static void initialize_clock(bool exact)
+{
+    Error *error = NULL;
+
+    module_call_init(MODULE_INIT_QOM);
+    qemu_init_main_loop(&error);
+    g_assert_null(error);
+    if (exact) {
+        qemu_timer_enable_tcg_ps_clock(NULL, observed_clock_ps);
+    }
+    qemu_clock_enable(QEMU_CLOCK_VIRTUAL, true);
+    nanosecond_reads = 0;
+}
+
+static unsigned callbacks;
+
+static void observe_expiry(void *opaque)
+{
+    callbacks++;
+}
+
+static ptimer_state *create_countdown(uint64_t count)
+{
+    ptimer_state *timer = ptimer_init(observe_expiry, NULL,
+                                    PTIMER_POLICY_LEGACY);
+
+    ptimer_transaction_begin(timer);
+    ptimer_set_freq(timer, 3000000000U);
+    ptimer_set_count(timer, count);
+    ptimer_run(timer, 1);
+    ptimer_transaction_commit(timer);
+    return timer;
+}
+
+static void test_wide_origin(void)
+{
+    ptimer_state *timer;
+    __int128 origin = ((__int128)INT64_MAX + 1) *
+                      PICOSECONDS_PER_NANOSECOND + 357;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    initialize_clock(true);
+    observed_ps = origin;
+    timer = create_countdown(3);
+    g_assert_true(timer_expire_time_ps_wide(timer->timer) == origin + 1000);
+    g_assert_cmpuint(ptimer_get_count(timer), ==, 3);
+    observed_ps = origin + 999;
+    qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL);
+    g_assert_cmpuint(callbacks, ==, 0);
+    observed_ps++;
+    qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL);
+    g_assert_cmpuint(callbacks, ==, 1);
+    g_assert_false(timer_pending(timer->timer));
+    g_assert_cmpuint(nanosecond_reads, ==, 0);
+    ptimer_free(timer);
+}
+
+static GByteArray *save_state(ptimer_state *timer)
+{
+    QIOChannelBuffer *output = qio_channel_buffer_new(256);
+    QEMUFile *file = qemu_file_new_output(QIO_CHANNEL(output));
+    GByteArray *bytes = g_byte_array_new();
+    Error *error = NULL;
+
+    g_assert_cmpint(vmstate_save_state(file, &vmstate_ptimer, timer, NULL,
+                                      &error), ==, 0);
+    g_assert_null(error);
+    qemu_put_byte(file, QEMU_VM_EOF);
+    g_assert_cmpint(qemu_fflush(file), ==, 0);
+    g_byte_array_append(bytes, output->data, output->usage);
+    g_assert_cmpint(qemu_fclose(file), ==, 0);
+    object_unref(OBJECT(output));
+    return bytes;
+}
+
+static int load_state(ptimer_state *timer, GByteArray *bytes)
+{
+    QIOChannelBuffer *input = qio_channel_buffer_new(bytes->len);
+    QEMUFile *file;
+    Error *error = NULL;
+    int result;
+
+    input->usage = bytes->len;
+    memcpy(input->data, bytes->data, bytes->len);
+    file = qemu_file_new_input(QIO_CHANNEL(input));
+    result = vmstate_load_state(file, &vmstate_ptimer, timer, 1, &error);
+    error_free(error);
+    qemu_fclose(file);
+    object_unref(OBJECT(input));
+    return result;
+}
+
+static void test_wide_migration(void)
+{
+    __int128 origin = ((__int128)1 << 120) + 357;
+    ptimer_state *original;
+    ptimer_state *restored;
+    GByteArray *bytes;
+    PtimerTime next;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    initialize_clock(true);
+    observed_ps = origin;
+    original = create_countdown(1);
+    bytes = save_state(original);
+    next = ptimer_next_time(original);
+    g_assert_cmpuint(next.subps, !=, 0);
+    restored = ptimer_init(observe_expiry, NULL, PTIMER_POLICY_LEGACY);
+    g_assert_cmpint(load_state(restored, bytes), ==, 0);
+    g_assert_true(ptimer_time_equal(ptimer_next_time(restored), next));
+    g_assert_true(timer_expire_time_ps_wide(restored->timer) == origin + 334);
+    g_assert_cmpuint(ptimer_get_count(restored), ==, 1);
+    ptimer_free(original);
+
+    observed_ps = origin + 333;
+    qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL);
+    g_assert_cmpuint(callbacks, ==, 0);
+    observed_ps++;
+    qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL);
+    g_assert_cmpuint(callbacks, ==, 1);
+    g_assert_false(timer_pending(restored->timer));
+    ptimer_free(restored);
+    g_byte_array_unref(bytes);
+}
+
+static void test_long_countdown(void)
+{
+    ptimer_state *timer;
+    const uint64_t count = UINT64_C(1) << 40;
+    const int64_t period_ns = INT64_C(1) << 55;
+    __int128 period_ps = (__int128)period_ns * PICOSECONDS_PER_NANOSECOND;
+    __int128 origin = (__int128)1 << 110;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    initialize_clock(true);
+    observed_ps = origin;
+    timer = ptimer_init(observe_expiry, NULL, PTIMER_POLICY_LEGACY);
+    ptimer_transaction_begin(timer);
+    ptimer_set_period(timer, period_ns);
+    ptimer_set_count(timer, count);
+    ptimer_run(timer, 1);
+    ptimer_transaction_commit(timer);
+    g_assert_true(timer_expire_time_ps_wide(timer->timer) ==
+                  origin + period_ps * count);
+    g_assert_cmpuint(ptimer_get_count(timer), ==, count);
+    observed_ps += period_ps;
+    g_assert_cmpuint(ptimer_get_count(timer), ==, count - 1);
+    observed_ps = origin + period_ps * (count - 1);
+    g_assert_cmpuint(ptimer_get_count(timer), ==, 1);
+    observed_ps++;
+    g_assert_cmpuint(ptimer_get_count(timer), ==, 0);
+    ptimer_free(timer);
+}
+
+static void test_full_horizon(void)
