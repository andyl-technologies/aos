+ * only in the single-threaded immediate child.
+ *
+ * Returns zero for the exact captured table or a negative errno-style status.
+ */
+int qemu_crucible_hot_fork_verify_child_descriptor_table(void *opaque);
+
+/**
+ * qemu_crucible_hot_fork_child_resource_plan_contains_plugin() - match basis
+ * @resources: sealed caller-owned complete plan
+ * @plugin: exact plugin contribution required by the retained transaction
+ *
+ * Revalidates the sealed plan and requires its replacement table plus canonical
+ * descriptor and mapping unions to contain the exact plugin contribution.
+ * Other independently validated subsystem entries may also be present.
+ *
+ * Returns true exactly when the sealed plan contains @plugin without conflict.
+ */
+bool qemu_crucible_hot_fork_child_resource_plan_contains_plugin(
+    const QemuCrucibleHotForkChildResourcePlan *resources,
+    const QemuCrucibleHotForkPluginChildResourcePlan *plugin);
+
+/**
+ * qemu_crucible_hot_fork_child_resource_plan_contains_diagnostics() - match
+ * @resources: sealed complete child resource plan
+ * @diagnostics: exact prepared branch-private stderr contribution
+ *
+ * Returns true exactly when the sealed plan contains @diagnostics without a
+ * conflicting source, target, or socket identity.
+ */
+bool qemu_crucible_hot_fork_child_resource_plan_contains_diagnostics(
+    const QemuCrucibleHotForkChildResourcePlan *resources,
+    const QemuCrucibleHotForkDiagnosticsChildResourcePlan *diagnostics);
+
+/**
+ * qemu_crucible_hot_fork_child_resource_plan_contains_qmp() - match QMP basis
+ * @resources: sealed complete child resource plan
+ * @qmp: exact prepared branch-private QMP contribution
+ *
+ * Returns true exactly when the sealed plan retains @qmp without conflict.
+ */
+bool qemu_crucible_hot_fork_child_resource_plan_contains_qmp(
+    const QemuCrucibleHotForkChildResourcePlan *resources,
+    const QemuCrucibleHotForkQmpChildResourcePlan *qmp);
+
+/**
+ * qemu_crucible_hot_fork_child_resource_plan_contains_console() - match basis
+ * @resources: sealed complete child resource plan
+ * @console: exact console contribution expected by the caller
+ *
+ * Returns true exactly when the sealed plan retains @console.
+ */
+bool qemu_crucible_hot_fork_child_resource_plan_contains_console(
+    const QemuCrucibleHotForkChildResourcePlan *resources,
+    const QemuCrucibleHotForkConsoleChildResourcePlan *console);
+
+/**
+ * qemu_crucible_hot_fork_apply_child_resource_plan() - consume a sealed plan
+ * @resources: inherited, sealed complete resource plan
+ * @transaction: active authenticated immediate-child transaction
+ * @verify_descriptors: complete installed descriptor-table verifier
+ * @descriptor_opaque: caller-owned value passed to @verify_descriptors
+ * @plugin_reinitializer: exact inherited plugin child-runtime adapter
+ * @qmp_reinitializer: exact inherited child-QMP runtime adapter
+ * @console_reinitializer: exact inherited console runtime adapter
+ *
+ * Revalidates the complete sealed union and its exact plugin contribution,
+ * requires unconsumed plugin, child-QMP, and console reinitializers for the
+ * same sealed immutable basis, and passes only those adapters and tables to the
+ * destructive child resource transaction. A successful preflight consumes
+ * @resources before descriptor mutation begins; the plan and all three runtime
+ * adapters are one-shot even when a later destructive phase fails. Success
+ * records both
+ * the plan and transaction as completely applied while every recreated worker,
+ * callback path, and the replacement monitor input remain held.
+ *
+ * This adapter still covers only explicitly merged subsystem contributions.
+ * It neither proves that the union is a complete QEMU inventory nor releases
+ * guest admission, and therefore does not acknowledge readiness bit 7 or 8.
+ *
+ * Returns zero after exact application, -EPERM when either linear owner is not
+ * current, -EINVAL when the immutable bases disagree, or the destructive child
+ * transaction's negative errno-style status after the plan is consumed.
+ */
+int qemu_crucible_hot_fork_apply_child_resource_plan(
+    QemuCrucibleHotForkChildResourcePlan *resources,
+    QemuCrucibleHotForkDescriptorTableTransaction *transaction,
+    QemuCrucibleHotForkDescriptorVerifier verify_descriptors,
+    void *descriptor_opaque,
+    QemuCrucibleHotForkPluginChildReinitializer *plugin_reinitializer,
+    QemuCrucibleHotForkQmpChildReinitializer *qmp_reinitializer,
+    QemuCrucibleHotForkConsoleChildReinitializer *console_reinitializer);
+
+/**
+ * qemu_crucible_hot_fork_apply_child_runtime_resource_plan() - rebuild child
+ * @resources: inherited, sealed complete resource plan
+ * @transaction: active authenticated immediate-child descriptor transaction
+ * @runtime: prepared RCU and QEMU registry transaction for this exact child
+ * @verify_descriptors: complete installed descriptor-table verifier
+ * @descriptor_opaque: caller-owned value passed to @verify_descriptors
+ * @plugin_reinitializer: exact inherited plugin child-runtime adapter
+ * @qmp_reinitializer: exact inherited child-QMP runtime adapter
+ * @console_reinitializer: exact inherited console runtime adapter
+ *
+ * Applies the same one-shot resource plan as
+ * qemu_crucible_hot_fork_apply_child_resource_plan(), but also starts the
+ * deferred RCU callback worker inside the destructive child-reinitialization
+ * phase.  For a retained-template transaction, plugin reconstruction completes
+ * before the copied async-worker barrier is released and the replacement QMP
+ * monitor starts.  The caller must have opened @transaction and prepared
+ * @runtime while the immediate child was still single-threaded.  Descriptor
+ * disposition is therefore complete before any replacement worker can run.
+ *
+ * This remains an internal composition primitive.  It does not prove that the
+ * retained resource union covers every QEMU subsystem, release guest input, or
+ * authorize fork from a production command.
+ *
+ * Returns zero after exact application or the same negative errno-style
+ * statuses as the underlying runtime and resource transactions.
+ */
+int qemu_crucible_hot_fork_apply_child_runtime_resource_plan(
+    QemuCrucibleHotForkChildResourcePlan *resources,
+    QemuCrucibleHotForkDescriptorTableTransaction *transaction,
+    QemuCrucibleHotForkRuntimeTransaction *runtime,
+    QemuCrucibleHotForkDescriptorVerifier verify_descriptors,
+    void *descriptor_opaque,
+    QemuCrucibleHotForkPluginChildReinitializer *plugin_reinitializer,
+    QemuCrucibleHotForkQmpChildReinitializer *qmp_reinitializer,
+    QemuCrucibleHotForkConsoleChildReinitializer *console_reinitializer);
+
+/**
+ * qemu_crucible_hot_fork_activate_plugin_child() - release held callbacks
+ * @reinitializer: exact successfully initialized child plugin adapter
+ *
+ * Invokes the registered plugin's one-shot child release only after the
+ * descriptor, mapping, runtime, and monitor reconstruction transaction has
+ * committed. The returned plugin inventory must preserve every immutable
+ * generation and resource identity while moving from workers-held to active
+ * with no parked or pending work.
+ *
+ * Returns zero after exact activation, or a negative errno-style status. A
+ * failure leaves the fork child fail-closed and requires termination.
+ */
+int qemu_crucible_hot_fork_activate_plugin_child(
+    QemuCrucibleHotForkPluginChildReinitializer *reinitializer);
+
+/**
+ * qemu_crucible_hot_fork_reset_child_resource_plan() - clear composition
+ * @resources: caller-owned plan no longer admitted by a template
+ *
+ * Clears the parent-process copy when its retained resource stage is released.
+ */
+void qemu_crucible_hot_fork_reset_child_resource_plan(
+    QemuCrucibleHotForkChildResourcePlan *resources);
+
+/**
+ * qemu_crucible_hot_fork_prepare_plugin_child_reinitializer() - copy a plan
+ * @reinitializer: caller-owned storage inherited by the future fork child
+ * @plan: immutable registered plugin child-runtime plan
+ *
+ * Validates and copies the complete plan before a destructive child resource
+ * transaction.  Repreparing the caller-owned storage before fork replaces the
+ * prior plan.  Once child initialization is attempted, that inherited copy is
+ * one-shot and cannot be retried.
+ *
+ * Returns zero after exact preparation or -EINVAL for an invalid argument or
+ * plan.
+ */
+int qemu_crucible_hot_fork_prepare_plugin_child_reinitializer(
+    QemuCrucibleHotForkPluginChildReinitializer *reinitializer,
+    const struct qemu_plugin_crucible_hot_fork_child_plan *plan);
+
+/**
+ * qemu_crucible_hot_fork_plugin_child_reinitializer_prepared_for() - match plan
+ * @reinitializer: caller-owned inherited child-runtime adapter
+ * @plan: exact immutable plan expected by the retained template transaction
+ *
+ * Revalidates the supplied plan and compares every closed field with the
+ * adapter's copied plan.  A consumed or successfully initialized adapter never
+ * matches.  This lets the template coordinator attest its by-value plan without
+ * exposing mutable adapter storage.
+ *
+ * Returns true exactly for one unconsumed adapter prepared for @plan.
+ */
+bool qemu_crucible_hot_fork_plugin_child_reinitializer_prepared_for(
+    const QemuCrucibleHotForkPluginChildReinitializer *reinitializer,
+    const struct qemu_plugin_crucible_hot_fork_child_plan *plan);
+
+/**
+ * qemu_crucible_hot_fork_reset_plugin_child_reinitializer() - clear adapter
+ * @reinitializer: caller-owned adapter no longer admitted by a template
+ *
+ * Clears the parent-process copy after its retained descriptor stage is
+ * released.  A fork child owns an independent copy and must never use this
+ * operation after beginning its destructive transaction.
+ */
+void qemu_crucible_hot_fork_reset_plugin_child_reinitializer(
+    QemuCrucibleHotForkPluginChildReinitializer *reinitializer);
+
+/**
+ * qemu_crucible_hot_fork_reinitialize_plugin_child() - invoke held runtime
+ * @opaque: prepared QemuCrucibleHotForkPluginChildReinitializer
+ *
+ * Invokes the process-global registered plugin runtime exactly once with the
+ * copied initialization plan.  Success additionally requires the registered
+ * runtime to echo the exact plan in a complete workers-held state: callbacks
+ * remain closed, the private mapping is installed, and every sealed worker is
+ * parked without pending local work.  This function matches
+ * QemuCrucibleHotForkChildReinitializer and is intended to run only inside the
+ * authenticated destructive child resource transaction.
+ *
+ * Returns zero after exact held initialization, -EPERM when the context is not
+ * prepared or was already attempted, -EPROTO for a contradictory successful
+ * runtime response, or the registered runtime's negative errno-style failure.
+ */
+int qemu_crucible_hot_fork_reinitialize_plugin_child(void *opaque);
+
+#endif
diff --git a/include/system/crucible-kernel-swap-observation.h b/include/system/crucible-kernel-swap-observation.h
new file mode 100644
index 0000000000000000000000000000000000000000..9a7bf6f0e48829934a44f661740ccd6fdfb2128b
--- /dev/null
+++ b/include/system/crucible-kernel-swap-observation.h
@@ -0,0 +1,112 @@
+/*
+ * Bounded interval observations of anonymous main RAM
+ * Copyright (c) 2026 Andyl, Inc.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef SYSTEM_CRUCIBLE_KERNEL_SWAP_OBSERVATION_H
+#define SYSTEM_CRUCIBLE_KERNEL_SWAP_OBSERVATION_H
+
+#define CRUCIBLE_SWAP_CHUNK_PAGES 64
+#define CRUCIBLE_SWAP_PAGE_BYTES 4096
+#define CRUCIBLE_SWAP_GUEST_BYTES (UINT64_C(512) * 1024 * 1024)
+
+/* Linux syscall categories, confined to this GPL-private implementation. */
+#define CRUCIBLE_SCAN_FILE (UINT64_C(1) << 2)
+#define CRUCIBLE_SCAN_PRESENT (UINT64_C(1) << 3)
+#define CRUCIBLE_SCAN_SWAPPED (UINT64_C(1) << 4)
+#define CRUCIBLE_SCAN_PFNZERO (UINT64_C(1) << 5)
+#define CRUCIBLE_SCAN_HUGE (UINT64_C(1) << 6)
+#define CRUCIBLE_SCAN_MASK (CRUCIBLE_SCAN_FILE | CRUCIBLE_SCAN_PRESENT | \
+                           CRUCIBLE_SCAN_SWAPPED | CRUCIBLE_SCAN_PFNZERO | \
+                           CRUCIBLE_SCAN_HUGE)
+
+typedef struct CrucibleSwapPageRegion {
+    uint64_t start;
+    uint64_t end;
+    uint64_t categories;
+} CrucibleSwapPageRegion;
+
+typedef struct CrucibleSwapChunk {
+    CrucibleSwapPageRegion regions[CRUCIBLE_SWAP_CHUNK_PAGES];
+    uint64_t entries[CRUCIBLE_SWAP_CHUNK_PAGES];
+    uint64_t categories[CRUCIBLE_SWAP_CHUNK_PAGES];
+    unsigned char resident[CRUCIBLE_SWAP_CHUNK_PAGES];
+} CrucibleSwapChunk;
+
+typedef struct CrucibleSwapCounts {
+    uint64_t present;
+    uint64_t swapped;
+    uint64_t absent;
+    uint64_t resident;
+    uint64_t zero;
+    uint64_t swapped_nonresident;
+    uint64_t changed;
+} CrucibleSwapCounts;
+
+/* Require complete ordered coverage; gaps are not evidence of absent pages. */
+static inline bool crucible_swap_associate(
+    CrucibleSwapChunk *chunk, uint64_t start, size_t pages, size_t regions)
+{
+    uint64_t cursor = start;
+    size_t index = 0;
+
+    if (!pages || pages > CRUCIBLE_SWAP_CHUNK_PAGES || !regions ||
+        regions > pages || start % CRUCIBLE_SWAP_PAGE_BYTES ||
+        start > UINT64_MAX - pages * CRUCIBLE_SWAP_PAGE_BYTES) {
+        return false;
+    }
+    for (size_t region = 0; region < regions; region++) {
+        const CrucibleSwapPageRegion *item = &chunk->regions[region];
+        uint64_t flags = item->categories;
+
+        if (item->start != cursor || item->end <= cursor ||
+            item->end % CRUCIBLE_SWAP_PAGE_BYTES ||
+            item->end > start + pages * CRUCIBLE_SWAP_PAGE_BYTES ||
+            flags & ~CRUCIBLE_SCAN_MASK ||
+            flags & (CRUCIBLE_SCAN_FILE | CRUCIBLE_SCAN_HUGE) ||
+            ((flags & CRUCIBLE_SCAN_PRESENT) &&
+             (flags & CRUCIBLE_SCAN_SWAPPED)) ||
+            ((flags & CRUCIBLE_SCAN_PFNZERO) &&
+             !(flags & CRUCIBLE_SCAN_PRESENT))) {
+            return false;
+        }
+        while (cursor < item->end) {
+            chunk->categories[index++] = flags;
+            cursor += CRUCIBLE_SWAP_PAGE_BYTES;
+        }
+    }
+    return index == pages;
+}
+
+/* Each association describes separate syscall samples of one page coordinate. */
+static inline bool crucible_swap_count(
+    const CrucibleSwapChunk *chunk, size_t pages, CrucibleSwapCounts *counts)
+{
+    CrucibleSwapCounts next = *counts;
+
+    if (!pages || pages > CRUCIBLE_SWAP_CHUNK_PAGES) {
+        return false;
+    }
+    for (size_t index = 0; index < pages; index++) {
+        uint64_t entry = chunk->entries[index];
+        uint64_t scan = chunk->categories[index];
+        bool present = entry >> 63;
+        bool swapped = (entry >> 62) & 1;
+        bool resident = chunk->resident[index] & 1;
+
+        if ((entry & (UINT64_C(1) << 61)) || (present && swapped)) {
+            return false;
+        }
+        next.present += present;
+        next.swapped += swapped;
+        next.absent += !present && !swapped;
+        next.resident += resident;
+        next.zero += !!(scan & CRUCIBLE_SCAN_PFNZERO);
+        next.swapped_nonresident += swapped && !resident;
+        next.changed += present != !!(scan & CRUCIBLE_SCAN_PRESENT) ||
+                        swapped != !!(scan & CRUCIBLE_SCAN_SWAPPED);
+    }
+    *counts = next;
+    return true;
+}
+#endif
diff --git a/include/system/crucible-native-park-request.h b/include/system/crucible-native-park-request.h
new file mode 100644
index 0000000000000000000000000000000000000000..5a3c001843cb8d3b185069d12c9a3ecc45945fcd
--- /dev/null
+++ b/include/system/crucible-native-park-request.h
@@ -0,0 +1,112 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Native Park census, mapped capture and physically checked request return. */
+#ifndef SYSTEM_CRUCIBLE_NATIVE_PARK_REQUEST_H
+#define SYSTEM_CRUCIBLE_NATIVE_PARK_REQUEST_H
+
+#include "qemu/crucible-park-census.h"
+
+typedef struct QemuCrucibleParentParkLoan QemuCrucibleParentParkLoan;
+typedef struct QemuCrucibleParentParkReceive QemuCrucibleParentParkReceive;
+typedef struct QemuCrucibleNativeParkRequest QemuCrucibleNativeParkRequest;
+typedef struct QemuCrucibleParentParkMetadataOwner
+    QemuCrucibleParentParkMetadataOwner;
+
+/* Owned future storage slots exist before any allocator may be invoked.
+ * A declaration is not a born allocation, and an empty slot is not a receipt
+ * returning an independently retained alias or Source charge. */
+typedef struct QemuCrucibleNativeParkStorageSlot {
+    void *raw;
+    uint64_t attempt_sequence;
+    uint64_t free_sequence;
+    size_t users;
+    int first_status;
+    int physical_status;
+    int first_physical_status;
+    bool attempted;
+    bool born;
+    bool freed;
+    bool uncertain;
+} QemuCrucibleNativeParkStorageSlot;
+
+typedef struct QemuCrucibleNativeParkRequestView {
+    QemuCrucibleParentParkLoan *loan;
+    QemuCrucibleParentParkMetadataOwner *metadata_owner;
+    QemuCrucibleParkArrayRequest arrays[QEMU_CRUCIBLE_PARK_ARRAY_COUNT];
+    QemuCrucibleNativeParkStorageSlot slots[QEMU_CRUCIBLE_PARK_ARRAY_COUNT];
+    int first_status;
+    int post_status;
+    int physical_status;
+    int operation_status;
+    uint64_t native_generation;
+    uint64_t plugin_owner_generation;
+    bool closed;
+    bool storage_closed;
+    bool released;
+} QemuCrucibleNativeParkRequestView;
+
+/* The singleton is part of the separately priced prebirth static floor. */
+size_t qemu_crucible_native_park_request_static_extent(void);
+
+/* Returns held custody before the independent post, even on post failure.
+ * No heap array is born in this phase. No storage-return proof is issued. */
+int qemu_crucible_native_park_request_begin(
+    QemuCrucibleParentParkLoan *loan, QemuCrucibleNativeParkRequest **out);
+int qemu_crucible_native_park_request_identity(
+    QemuCrucibleNativeParkRequest *request, QemuCrucibleParentParkLoan *loan);
+int qemu_crucible_native_park_request_current(
+    QemuCrucibleNativeParkRequest *request);
+
+/* Identity-only factual observation remains available after expiry/release. */
+int qemu_crucible_native_park_request_observe(
+    QemuCrucibleNativeParkRequest *request,
+    QemuCrucibleNativeParkRequestView *out);
+
+/* Releases only gates acquired here. Retains the canonical request forever;
+ * existing root aliases and future storage debt are never erased by release. */
+int qemu_crucible_native_park_request_release(
+    QemuCrucibleNativeParkRequest *request);
+
+/* Associates a nominal Source child once. This records identity only; it
+ * neither validates that child nor grants allocation or payment authority. */
+int qemu_crucible_native_park_request_storage_claim(
+    QemuCrucibleNativeParkRequest *request, QemuCrucibleParentParkLoan *loan,
+    QemuCrucibleParentParkMetadataOwner *child);
+
+/* Permanently closes this request's future storage admission. The canonical
+ * journal must have no users, uncertainty or unreturned attempted storage.
+ * Existing persistent aliases remain retained and are not retired here. */
+int qemu_crucible_native_park_request_storage_close(
+    QemuCrucibleNativeParkRequest *request, QemuCrucibleParentParkLoan *loan,
+    QemuCrucibleParentParkMetadataOwner *child);
+
+/* Opens one exact metadata-array effect burst, outside BQL and native locks.
+ * The early capture remains held on failed pre/post until finish is called. */
+int qemu_crucible_native_park_capture_begin(
+    QemuCrucibleNativeParkRequest *request,
+    QemuCrucibleParentParkMetadataOwner *child,
+    QemuCrucibleNativeParkCapture **out);
+int qemu_crucible_native_park_capture_finish(
+    QemuCrucibleNativeParkCapture *capture);
+
+/* Executes only with genuine native writer exclusion and preexisting driver
+ * drain custody. All callback outputs and physical cleanup remain in request. */
+int qemu_crucible_native_park_request_run(
+    QemuCrucibleNativeParkRequest *request,
+    QemuCrucibleParentParkMetadataOwner *child);
+int qemu_crucible_native_park_request_return(
+    QemuCrucibleNativeParkRequest *request);
+int qemu_crucible_native_park_request_returned(
+    QemuCrucibleNativeParkRequest *request, QemuCrucibleParentParkLoan *loan);
+struct qemu_plugin_crucible_parent_park_drain_invocation;
+int qemu_crucible_native_park_request_invocation(
+    QemuCrucibleNativeParkRequest *request,
+    struct qemu_plugin_crucible_parent_park_drain_invocation *out);
+
+/* Exact original handler identity, also available after a preissuance failure.
+ * This returns factual status only; it creates no request or loan. */
+int qemu_crucible_native_park_handler_outcome(
+    QemuCrucibleNativeParkRequest *request,
+    QemuCrucibleParentParkReceive *receive,
+    QemuCrucibleNativeParkRequestView *out);
+
+#endif
diff --git a/include/system/crucible-observation-realization.h b/include/system/crucible-observation-realization.h
