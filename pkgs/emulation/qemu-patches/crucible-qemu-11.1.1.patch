+def generated_source(source, negative_control):
+    """Extract the real registry and native operation bodies."""
+    header = (ROOT / "include/qemu/thread.h").read_text()
+    types = header[header.index("typedef struct QemuMutexHotForkInventoryEntry {"):
+                   header.index("/*\n * Snapshot every active QemuMutex/")]
+    declaration_signatures = [
+        "void qemu_mutex_hot_fork_inventory(",
+        "void qemu_mutex_hot_fork_inventory_destroy(",
+        "void qemu_cond_init(",
+        "void qemu_cond_destroy(",
+        "void TSA_NO_TSA qemu_cond_wait_impl(",
+        "bool qemu_cond_timedwait_impl(",
+    ]
+    declarations = []
+    for signature in declaration_signatures:
+        start = header.index(signature)
+        declarations.append(header[start:header.index(";", start) + 1])
+    globals_source = source[
+        source.index("static pthread_mutex_t crucible_hot_fork_mutex_registry_guard"):
+        source.index("/*\n * This is not defined on Linux")]
+    globals_source += "\nstatic __thread bool crucible_hot_fork_mutex_registry_held;\n"
+    prelude = OWNER_FIXTURE["PRELUDE"]
+    for name in ("pre_lock", "post_lock", "pre_unlock"):
+        prelude = prelude.replace(definition(prelude,
+            f"static void qemu_mutex_{name}("), "")
+    bodies = "\n\n".join(definition(source, signature)
+                            for signature in SIGNATURES)
+
+    mutations = {
+        "admission": ("static void crucible_hot_fork_mutex_wait_begin(",
+                      "        entry->acquisition_waiters++;", ""),
+        "cancel": ("static void crucible_hot_fork_mutex_wait_cancel(",
+                   "            entry->acquisition_waiters--;", ""),
+        "acquired": ("static void crucible_hot_fork_mutex_acquired(",
+                     "        entry->acquisition_waiters--;", ""),
+        "condition-begin": (
+            "static void crucible_hot_fork_mutex_condition_wait_begin(",
+            "entry->condition_waiters++ == 0", "entry->condition_waiters == 0"),
+        "condition-end": (
+            "static void crucible_hot_fork_mutex_condition_wait_end(",
+            "entry->condition_waiters-- == 1", "entry->condition_waiters == 1"),
+    }
+    if negative_control:
+        signature, before, after = mutations[negative_control]
+        original = definition(bodies, signature)
+        assert original.count(before) == 1
+        bodies = bodies.replace(original, original.replace(before, after))
+    return (prelude + types + "\n".join(declarations) + "\n" +
+            globals_source + HOOKS + bodies + CHECKS)
