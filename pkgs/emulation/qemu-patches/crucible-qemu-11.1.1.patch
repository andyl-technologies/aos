+    crucible_selectable_reset_generation = owner->observation_generation;
+    status = qemu_plugin_crucible_selectable_reset_call(
+        QEMU_PLUGIN_CRUCIBLE_SELECTABLE_RESET_PREPARE, &owner->request);
