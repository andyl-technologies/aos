diff --git a/include/qemu/crucible-metadata-partition.h b/include/qemu/crucible-metadata-partition.h
new file mode 100644
index 0000000000000000000000000000000000000000..408d6581d0379a50c790bc656f142a9d91d439d9
--- /dev/null
+++ b/include/qemu/crucible-metadata-partition.h
@@ -0,0 +1,504 @@
+/*
+ * Process-private fixed metadata partition accounting
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef QEMU_CRUCIBLE_METADATA_PARTITION_H
+#define QEMU_CRUCIBLE_METADATA_PARTITION_H
+
+#include "qemu/atomic.h"
+#include "qemu/crucible-process-purpose.h"
+
+/* No constructor here issues the fixed controller purpose. Publication needs
+ * the matched module/type geometry; a fixture may model that missing issuer. */
+typedef struct QemuCrucibleMetadataPartition {
+    uint64_t total;
+    /* Original total remains provenance. These fields are populated only by
+     * the genuine local process-purpose constructor, not a budget setter. */
+    uint64_t process_extent;
+    uint64_t compulsory_extent;
+    uint64_t native_extent;
+    uint64_t native_live;
+    uint64_t fixed_native_extent;
+    uint64_t controller_extent;
+    /* The old four-slot fixture mechanism has no production publisher. */
+    uint64_t controller_requests[4];
+    uint64_t control_requests[7];
+    uint64_t control_alignments[7];
+    uint64_t control_counts[7];
+    uint64_t inventory_allowance;
+    int first_status;
+    int post_status;
+    bool accounting_busy;
+    bool inventory_allowance_retained;
+    bool controller_retained;
+    bool published;
+} QemuCrucibleMetadataPartition;
+
+/* Embedded in the actual allocation owner, not a caller authorization token. */
+typedef struct QemuCrucibleMetadataCharge {
+    uint64_t bytes;
+    bool held;
+} QemuCrucibleMetadataCharge;
+
+/* The owner exists before either observation. A negative post cannot hide a
+ * completed debit, and an unattempted post is not reported as a healthy one. */
+typedef struct QemuCrucibleMetadataAdmission {
+    QemuCrucibleMetadataCharge charge;
+    int first_status;
+    int post_status;
+    bool post_attempted;
+} QemuCrucibleMetadataAdmission;
+
+typedef struct QemuCrucibleRamMetadataKeeper QemuCrucibleRamMetadataKeeper;
+typedef struct QemuCrucibleRamReturnJournal QemuCrucibleRamReturnJournal;
+
+/* Bound by the actual Source birth, never reconstructed from a byte count. */
+typedef struct QemuCrucibleRamMetadataOwner {
+    QemuCrucibleRamMetadataKeeper *keeper;
+    uint64_t serial;
+    uintptr_t address;
+    uint64_t bytes;
+    QemuCrucibleMetadataAdmission admission;
+    unsigned returning;
+} QemuCrucibleRamMetadataOwner;
+
+typedef enum QemuCrucibleRamReturnPhase {
+    RAM_RETURN_EMPTY,
+    RAM_RETURN_CLAIMED,
+    RAM_RETURN_FREE_STARTED,
+    RAM_RETURN_FREE_RETURNED,
+    RAM_RETURN_SETTLED,
+} QemuCrucibleRamReturnPhase;
+
+/* Actual static storage survives its departing allocation and failed refund. */
+struct QemuCrucibleRamReturnJournal {
+    QemuCrucibleRamMetadataKeeper *keeper;
+    QemuCrucibleRamMetadataOwner *owner;
+    uint64_t serial;
+    uintptr_t address;
+    uint64_t bytes;
+    QemuCrucibleMetadataAdmission admission;
+    unsigned phase;
+    int first_status;
+    int settlement_status;
+    bool report_returned;
+};
+
+/* The real preexec lender binds these immutable identities before release of
+ * Source custody. The sequence names actual allocations, not another credit. */
+struct QemuCrucibleRamMetadataKeeper {
+    QemuCrucibleMetadataPartition *partition;
+    QemuCruciblePreexecPurposeOwner *payer;
+    int64_t process;
+    uint64_t process_generation;
+    uint64_t account_generation;
+    uint64_t next_serial;
+    QemuCrucibleRamReturnJournal *inventory_returns[2];
+    QemuCrucibleRamReturnJournal *dirty_return;
+};
+
+typedef enum QemuCrucibleRamPhysicalDisposition {
+    RAM_PHYSICAL_NOT_OWED,
+    RAM_PHYSICAL_PENDING,
+    RAM_PHYSICAL_RETURNED,
+} QemuCrucibleRamPhysicalDisposition;
+
+typedef enum QemuCrucibleRamDebtDisposition {
+    RAM_DEBT_NOT_OWED,
+    RAM_DEBT_RETAINED,
+    RAM_DEBT_SETTLED,
+} QemuCrucibleRamDebtDisposition;
+
+typedef struct QemuCrucibleRamCleanupTicket {
+    unsigned row;
+    uint64_t incarnation;
+} QemuCrucibleRamCleanupTicket;
+
+typedef struct QemuCrucibleRamReturnDisposition {
+    bool projection_consumed;
+    QemuCrucibleRamPhysicalDisposition physical;
+    QemuCrucibleRamDebtDisposition debt;
+    QemuCrucibleRamCleanupTicket continuation;
+    int effect_status;
+    int settlement_status;
+} QemuCrucibleRamReturnDisposition;
+
+/* This loan names embedded Source custody, never a stack-local charge or an
+ * allocation grant. Only the matched, exclusively entered constructor moves
+ * its receipt after the actual allocation has returned. */
+typedef struct QemuCrucibleMetadataBirth QemuCrucibleMetadataBirth;
+typedef struct QemuCrucibleMetadataBirthLoan {
+    QemuCrucibleMetadataBirth *owner;
+    QemuCrucibleMetadataAdmission *admission;
+    QemuCrucibleRamMetadataKeeper *keeper;
+    uint64_t serial;
+} QemuCrucibleMetadataBirthLoan;
+
+/* Pure physical custody move in a prevalidated constructor. No ledger spend,
+ * temporal observation, allocator or callback occurs between these stores.
+ * A destination may accumulate only successful, actual bitmap allocations. */
+static inline void crucible_metadata_admission_transfer(
+    QemuCrucibleMetadataAdmission *source,
+    QemuCrucibleMetadataAdmission *destination, uint64_t bytes)
+{
+    assert(source && destination && source != destination);
+    assert(!source->first_status && !source->post_status &&
+           source->post_attempted && source->charge.held && bytes &&
+           bytes <= source->charge.bytes);
+    assert(!destination->first_status && !destination->post_status &&
+           destination->charge.bytes <= UINT64_MAX - bytes &&
+           (destination->charge.held || !destination->charge.bytes));
+
+    destination->charge.bytes += bytes;
+    destination->charge.held = true;
+    destination->post_attempted = true;
+    source->charge.bytes -= bytes;
+    source->charge.held = source->charge.bytes != 0;
+}
+
+/* Every destination is already anchored by its actual constructor. One batch
+ * serial plus its distinct real address also names each dirty header. */
+static inline void crucible_ram_metadata_birth_transfer(
+    QemuCrucibleMetadataBirthLoan *birth,
+    QemuCrucibleRamMetadataOwner *destination, void *body, uint64_t bytes)
+{
+    assert(birth && birth->owner && birth->keeper && birth->serial && body);
+    assert(destination && !destination->keeper && !destination->returning);
+    destination->keeper = birth->keeper;
+    destination->serial = birth->serial;
+    destination->address = (uintptr_t)body;
+    destination->bytes = bytes;
+    crucible_metadata_admission_transfer(birth->admission,
+                                         &destination->admission, bytes);
+}
+
+static inline int crucible_metadata_partition_status(
+    QemuCrucibleMetadataPartition *partition, int status)
+{
+    if (status < 0) {
+        qatomic_cmpxchg(&partition->first_status, 0, status);
+    }
+    return qatomic_read(&partition->first_status);
+}
+
+static inline void crucible_metadata_partition_record_post(
+    QemuCrucibleMetadataPartition *partition, int status)
+{
+    if (status < 0) {
+        qatomic_cmpxchg(&partition->post_status, 0, status);
+    }
+}
+
+/* One nonblocking cut protects controller, native and inventory debits. A
+ * caller never spins; retirement uncertainty retains requested custody. */
+static inline bool crucible_metadata_partition_enter(
+    QemuCrucibleMetadataPartition *partition)
+{
+    return !qatomic_cmpxchg(&partition->accounting_busy, false, true);
+}
+
+static inline void crucible_metadata_partition_leave(
+    QemuCrucibleMetadataPartition *partition)
+{
+    qatomic_store_release(&partition->accounting_busy, false);
+}
+
+static inline int crucible_metadata_partition_admission_status(
+    QemuCrucibleMetadataPartition *partition)
+{
+    int first = qatomic_read(&partition->first_status);
+
+    return first ? first : qatomic_read(&partition->post_status);
+}
+
+/* Validate residual arithmetic without deriving any issued subdivision. */
+static inline bool crucible_metadata_partition_residual_valid(
+    const QemuCrucibleMetadataPartition *partition)
+{
+    uint64_t bound = partition->process_extent ?
+        partition->process_extent : partition->total;
+
+    return bound && partition->compulsory_extent <= bound &&
+        partition->controller_extent <= bound - partition->compulsory_extent &&
+        partition->native_extent ==
+            bound - partition->compulsory_extent - partition->controller_extent;
+}
+
+/* Only the actual Source nominal owner calls this seven-role cut. A modeled
+ * publisher may exercise it in controls; no numerical publication API exists.
+ */
+static inline int crucible_metadata_control7_reserve(
+    QemuCrucibleMetadataPartition *partition,
+    const QemuCrucibleProcessPurposeRequest requests[7])
+{
+    uint64_t extent = 0;
+    uint64_t available;
+    int status = crucible_metadata_partition_admission_status(partition);
+
+    if (status) {
+        return status;
+    }
+    if (!crucible_metadata_partition_enter(partition)) {
+        return -EAGAIN;
+    }
+    status = crucible_metadata_partition_admission_status(partition);
+    if (status) {
+        goto out;
+    }
+    if (!qatomic_load_acquire(&partition->published) ||
+        !partition->process_extent || !partition->total ||
+        partition->process_extent > partition->total) {
+#ifdef ENOKEY
+        status = -ENOKEY;
+#else
+        status = -ENOTSUP;
+#endif
+        goto out;
+    }
+    if (partition->controller_retained) {
+        status = -EALREADY;
+        goto out;
+    }
+    if (!requests) {
+        status = -EINVAL;
+        goto out;
+    }
+    for (size_t index = 0; index < 7; index++) {
+        const QemuCrucibleProcessPurposeRequest *request = &requests[index];
+
+        if (!request->extent || !request->alignment ||
+            (request->alignment & (request->alignment - 1)) ||
+            request->extent % request->alignment || request->count != 1 ||
+            request->extent != partition->control_requests[index] ||
+            request->alignment != partition->control_alignments[index] ||
+            request->count != partition->control_counts[index]) {
+            status = -ESTALE;
+            goto out;
+        }
+        if (request->extent > UINT64_MAX - extent) {
+            status = -EOVERFLOW;
+            goto out;
+        }
+        extent += request->extent;
+    }
+    available = partition->process_extent;
+    if (partition->compulsory_extent > available) {
+        status = -ENOSPC;
+        goto out;
+    }
+    available -= partition->compulsory_extent;
+    if (extent > available || partition->fixed_native_extent > available - extent ||
+        partition->native_live > available - extent - partition->fixed_native_extent ||
+        partition->inventory_allowance > available - extent -
+            partition->fixed_native_extent - partition->native_live) {
+        status = -ENOSPC;
+        goto out;
+    }
+    partition->controller_extent = extent;
+    partition->native_extent = available - extent;
+    qatomic_store_release(&partition->controller_retained, true);
+
+out:
+    crucible_metadata_partition_leave(partition);
+    return status;
+}
+
+static inline int crucible_metadata_controller_reserve(
+    QemuCrucibleMetadataPartition *partition, const uint64_t requests[4],
+    uint64_t *reserved)
+{
+    uint64_t extent = 0;
+    int status = crucible_metadata_partition_admission_status(partition);
+
+    if (status) {
+        return status;
+    }
+    if (!crucible_metadata_partition_enter(partition)) {
+        return -EAGAIN;
+    }
+    status = crucible_metadata_partition_admission_status(partition);
+    if (status) {
+        goto out;
+    }
+    if (!qatomic_load_acquire(&partition->published)) {
+#ifdef ENOKEY
+        status = -ENOKEY;
+#else
+        status = -ENOTSUP;
+#endif
+        goto out;
+    }
+    if (partition->process_extent) {
+        status = -EPROTONOSUPPORT;
+        goto out;
+    }
+    if (qatomic_load_acquire(&partition->controller_retained)) {
+        status = -EALREADY;
+        goto out;
+    }
+    if (!requests || !reserved) {
+        status = -EINVAL;
+        goto out;
+    }
+    for (size_t index = 0; index < 4; index++) {
+        if (!requests[index] ||
+            requests[index] != partition->controller_requests[index]) {
+            status = -EINVAL;
+            goto out;
+        }
+        if (requests[index] > UINT64_MAX - extent) {
+            status = -EOVERFLOW;
+            goto out;
+        }
+        extent += requests[index];
+    }
+    if (!partition->total || extent > partition->total ||
+        partition->fixed_native_extent > partition->total - extent ||
+        partition->native_live >
+            partition->total - extent - partition->fixed_native_extent) {
+        status = -ENOSPC;
+        goto out;
+    }
+    partition->controller_extent = extent;
+    partition->native_extent = partition->total - extent;
+    qatomic_store_release(&partition->controller_retained, true);
+    *reserved = extent;
+
+out:
+    crucible_metadata_partition_leave(partition);
+    return status;
+}
+
+/* Valid only for a genuinely published partition. The caller supplies the
+ * actual inventory result, not an issuer floor or another account. Reusing
+ * the identical retained allowance is continuation, never refill or refund. */
+static inline int crucible_metadata_inventory_reserve(
+    QemuCrucibleMetadataPartition *partition, uint64_t bytes)
+{
+    int status = crucible_metadata_partition_admission_status(partition);
+
+    if (status) {
+        return status;
+    }
+    if (!crucible_metadata_partition_enter(partition)) {
+        return -EAGAIN;
+    }
+    status = crucible_metadata_partition_admission_status(partition);
+    if (status) {
+        goto out;
+    }
+    if (!qatomic_load_acquire(&partition->published) ||
+        !qatomic_load_acquire(&partition->controller_retained) ||
+        !crucible_metadata_partition_residual_valid(partition)) {
+#ifdef ENOKEY
+        status = -ENOKEY;
+#else
+        status = -ENOTSUP;
+#endif
+        goto out;
+    }
+    if (!bytes) {
+        status = -EINVAL;
+        goto out;
+    }
+    if (partition->inventory_allowance_retained) {
+        status = bytes == partition->inventory_allowance ? 0 : -ESTALE;
+        goto out;
+    }
+    if (partition->fixed_native_extent > partition->native_extent ||
+        partition->native_live >
+            partition->native_extent - partition->fixed_native_extent ||
+        bytes > partition->native_extent -
+            partition->fixed_native_extent - partition->native_live) {
+        status = -ENOSPC;
+        goto out;
+    }
+    partition->inventory_allowance = bytes;
+    partition->inventory_allowance_retained = true;
+
+out:
+    crucible_metadata_partition_leave(partition);
+    return status;
+}
+
+static inline int crucible_metadata_native_admit(
+    QemuCrucibleMetadataPartition *partition, uint64_t bytes,
+    QemuCrucibleMetadataCharge *charge)
+{
+    uint64_t available;
+    int status = crucible_metadata_partition_admission_status(partition);
+
+    if (status) {
+        return status;
+    }
+    if (!crucible_metadata_partition_enter(partition)) {
+        return -EAGAIN;
+    }
+    status = crucible_metadata_partition_admission_status(partition);
+    if (status) {
+        goto out;
+    }
+    if (!qatomic_load_acquire(&partition->published) ||
+        !qatomic_load_acquire(&partition->controller_retained) ||
+        !crucible_metadata_partition_residual_valid(partition)) {
+#ifdef ENOKEY
+        status = -ENOKEY;
+#else
+        status = -ENOTSUP;
+#endif
+        goto out;
+    }
+    if (!bytes || !charge || charge->held) {
+        status = -EINVAL;
+        goto out;
+    }
+    if (partition->fixed_native_extent > partition->native_extent) {
+        status = -ENOSPC;
+        goto out;
+    }
+    available = partition->native_extent - partition->fixed_native_extent;
+    if (partition->inventory_allowance > available) {
+        status = -ENOSPC;
+        goto out;
+    }
+    available -= partition->inventory_allowance;
+    if (partition->native_live > available ||
+        bytes > available - partition->native_live) {
+        status = -ENOSPC;
+        goto out;
+    }
+    partition->native_live += bytes;
+    *charge = (QemuCrucibleMetadataCharge) { bytes, true };
+
+out:
+    crucible_metadata_partition_leave(partition);
+    return status;
+}
+
+static inline int crucible_metadata_native_retire(
+    QemuCrucibleMetadataPartition *partition,
+    QemuCrucibleMetadataCharge *charge)
+{
+    int status = 0;
+
+    if (!charge || !charge->held) {
+        return -EALREADY;
+    }
+    if (!crucible_metadata_partition_enter(partition)) {
+        return -EAGAIN;
+    }
+    if (charge->bytes > partition->native_live) {
+        status = -EOVERFLOW;
+        goto out;
+    }
+    /* Actual free precedes this requested-allocation retirement. Neither D
+     * nor the exposed inventory allowance refunds here or at completion. */
+    partition->native_live -= charge->bytes;
+    *charge = (QemuCrucibleMetadataCharge) { 0 };
+
+out:
+    crucible_metadata_partition_leave(partition);
+    return status;
+}
+
+#endif
