+/* Ordinary writers retain their generic geometry and output. The real
+ * observer rejects Source classification before reading a Source-only field. */
+static void scenario_json_ordinary(void)
+{
+    JSONWriter *writer;
+    QemuCrucibleQmpAllocationOwner *owner = NULL;
+    int first = -1;
+    int post = -1;
+
+    g_assert_cmpint(qemu_crucible_selected_process_id, ==, 0);
+    writer = json_writer_new(false);
+    json_writer_start_object(writer, NULL);
+    json_writer_uint64(writer, "count", 2);
+    json_writer_str(writer, "message", "ok");
+    json_writer_end_object(writer);
+    g_assert_cmpstr(json_writer_get(writer), ==,
+                    "{\"count\": 2, \"message\": \"ok\"}");
+    g_assert_cmpint(qemu_crucible_qmp_json_writer_observe(writer, &owner), ==, -ENOENT);
+    g_assert_null(owner);
+    g_assert_cmpint(json_writer_source_status(writer, &first, &post), ==, -ENOENT);
+    g_assert_cmpint(first, ==, 0);
+    g_assert_cmpint(post, ==, 0);
+    json_writer_free(writer);
+}
+
+static void scenario_json_no_source_scope(void)
+{
+    JSONWriter *writer = NULL;
+    GString *output = NULL;
+    void *body = &fixture;
+
+    fixture_prepare(0, false);
+    g_assert_cmpint(fixture_acquire(), ==, 0);
+    g_assert_null(qmp_allocation_scope);
+    g_assert_cmpint(json_writer_new_source(false, &writer, &output), ==, -ENOKEY);
+    g_assert_null(writer);
+    g_assert_null(output);
+    g_assert_cmpint(qemu_crucible_qmp_json_writer_allocate(&body), ==, -ENOKEY);
+    g_assert_null(body);
+    g_assert_null(startup_source.qmp_allocations.owners);
+    g_assert_cmpuint(startup_source.metadata_partition.native_live, ==, 0);
+    assert_retained();
+}
+
+static void scenario_json_unknown_source_membership(void)
+{
+    JSONWriter *writer;
+    GString *string;
+    QemuCrucibleQmpAllocationOwner *owner = NULL;
+    int first = -1;
+    int post = -1;
+
+    fixture_prepare(0, false);
+    g_assert_cmpint(fixture_acquire(), ==, 0);
+    writer = json_writer_new(false);
+    json_writer_start_array(writer, NULL);
+    json_writer_int64(writer, NULL, 7);
+    json_writer_end_array(writer);
+    g_assert_cmpint(qemu_crucible_qmp_json_writer_observe(writer, &owner), ==, -ENOENT);
+    g_assert_null(owner);
+    g_assert_cmpint(json_writer_source_status(writer, &first, &post), ==, -ENOENT);
+    g_assert_cmpint(first, ==, 0);
+    g_assert_cmpint(post, ==, 0);
+    g_assert_cmpstr(json_writer_get(writer), ==, "[7]");
+
+    /* A generic GString cannot donate paid mutation membership. Even a
+     * self-referencing request must refuse before a temporary copy or grow. */
+    string = g_string_new("ordinary");
+    g_assert_cmpint(qemu_crucible_qmp_string_append(
+        string, string->str, string->len), ==, -EPERM);
+    g_assert_cmpint(qemu_crucible_qmp_string_prepend(string, "prefix", 6), ==, -EPERM);
+    g_assert_cmpint(qemu_crucible_qmp_string_erase(string, 0, -1), ==, -EPERM);
+    g_assert_cmpstr(string->str, ==, "ordinary");
+    g_assert_null(startup_source.qmp_allocations.owners);
+    g_assert_cmpuint(startup_source.metadata_partition.native_live, ==, 0);
+    g_string_free(string, true);
+    json_writer_free(writer);
+    assert_retained();
+}
