+    if (!count || !bql_locked()) {
+        return -EINVAL;
+    }
+    *count = 0;
+    if (qemu_crucible_ram_physical_device_generation() == 0) {
+        return -EOVERFLOW;
+    }
+    /* Completion order is stable under BQL. Every realized device is included,
+     * including busless devices outside the system-bus traversal. */
+    QTAILQ_FOREACH(device, &crucible_ram_realized_devices,
+                  crucible_ram_realized_link) {
+        result = crucible_ram_physical_device_visit(device, &inventory);
+        if (result != 0) {
+            break;
+        }
+    }
+    if (result == 0) {
