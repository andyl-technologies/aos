+int qdict_clone_shallow_source(const QDict *source, QDict **out);
+
+/* Registry provenance is checked before any QObject field read. This is
+ * physical ownership, not permission to create a checkpoint/Stop request.
+ * Last-free updates the caller handle at actual physical free even when its
+ * independent post fails. An unfinished destructor retains the same object
+ * handle and actual child/key/entry journals for a genuine cleanup retry. */
