+#define CRUCIBLE_INTERRUPT_SCOPE_X86_64 2
+#define CRUCIBLE_INTERRUPT_SCOPE_AARCH64 3
+#define CRUCIBLE_INTERRUPT_PHASE_RAISE 23
+#define CRUCIBLE_INTERRUPT_PHASE_ROUTE 24
