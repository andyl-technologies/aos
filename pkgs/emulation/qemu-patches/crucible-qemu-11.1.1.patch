+/*
+ * ARM CPU fingerprint projection tests
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+
+#include "io/channel-file.h"
+#include "qemu/module.h"
+#include "target/arm/crucible-fingerprint.h"
+
+static void noop_timer_callback(void *opaque)
+{
+}
+
+static GBytes *project_arm_continuation(const ARMCPU *cpu,
+                                        bool expected_success)
+{
+    char *path = NULL;
+    int read_fd;
+    int write_fd = g_file_open_tmp("qemu-arm-fingerprint-XXXXXX", &path,
+                                   NULL);
+    QIOChannelFile *channel;
+    QEMUFile *file;
+    Error *error = NULL;
+    struct stat stat_buffer;
+    bool success;
+
+    g_assert_cmpint(write_fd, >=, 0);
+    read_fd = dup(write_fd);
+    g_assert_cmpint(read_fd, >=, 0);
+    unlink(path);
+    g_free(path);
+
+    channel = qio_channel_file_new_fd(write_fd);
+    file = qemu_file_new_output(QIO_CHANNEL(channel));
+    success = arm_cpu_continuation_fingerprint_validate(cpu, &error);
+    if (success) {
+        arm_cpu_continuation_fingerprint_put(file, cpu);
+    }
+    g_assert_cmpint(success, ==, expected_success);
+    if (!success) {
+        g_assert_nonnull(error);
+        error_free(error);
+        qemu_fclose(file);
+        object_unref(OBJECT(channel));
+        g_assert_cmpint(fstat(read_fd, &stat_buffer), ==, 0);
+        g_assert_cmpint(stat_buffer.st_size, ==, 0);
+        close(read_fd);
+        return NULL;
+    }
+
+    g_assert_null(error);
+    g_assert_cmpint(qemu_fflush(file), ==, 0);
+    g_assert_cmpint(qemu_fclose(file), ==, 0);
+
+    g_assert_cmpint(fstat(read_fd, &stat_buffer), ==, 0);
+    g_autofree uint8_t *data = g_malloc(stat_buffer.st_size);
+    g_assert_cmpint(pread(read_fd, data, stat_buffer.st_size, 0), ==,
+                    stat_buffer.st_size);
+    GBytes *bytes = g_bytes_new(data, stat_buffer.st_size);
+    object_unref(OBJECT(channel));
+    close(read_fd);
+    return bytes;
+}
+
+static void assert_projection_equal(const ARMCPU *first,
+                                    const ARMCPU *second)
+{
+    g_autoptr(GBytes) first_bytes = project_arm_continuation(first, true);
+    g_autoptr(GBytes) second_bytes = project_arm_continuation(second, true);
+
+    g_assert_true(g_bytes_equal(first_bytes, second_bytes));
+}
+
+static void assert_projection_changed(const ARMCPU *first,
+                                      const ARMCPU *second)
+{
+    g_autoptr(GBytes) first_bytes = project_arm_continuation(first, true);
+    g_autoptr(GBytes) second_bytes = project_arm_continuation(second, true);
+
+    g_assert_false(g_bytes_equal(first_bytes, second_bytes));
+}
+
+static void initialize_inactive_cpu(ARMCPU *cpu)
+{
+    cpu->parent_obj.exception_index = -1;
+    cpu->env.exclusive_addr = UINT64_MAX;
+}
+
+static void test_exclusive_projection(void)
+{
+    ARMCPU first = { 0 };
+    ARMCPU second = { 0 };
+
+    initialize_inactive_cpu(&first);
+    initialize_inactive_cpu(&second);
+    first.env.exclusive_val = 1;
+    first.env.exclusive_high = 2;
+    second.env.exclusive_val = 3;
+    second.env.exclusive_high = 4;
+    assert_projection_equal(&first, &second);
+
+    first.env.exclusive_addr = second.env.exclusive_addr = 0x1000;
+    assert_projection_changed(&first, &second);
+}
+
+static void test_exception_projection(void)
+{
+    ARMCPU first = { 0 };
+    ARMCPU second = { 0 };
+
+    initialize_inactive_cpu(&first);
+    initialize_inactive_cpu(&second);
+    first.env.exception.syndrome = 1;
+    first.env.exception.vaddress = 2;
+    first.env.exception.fsr = 3;
+    first.env.exception.target_el = 1;
+    second.env.exception.syndrome = 4;
+    second.env.exception.vaddress = 5;
+    second.env.exception.fsr = 6;
+    second.env.exception.target_el = 2;
+    assert_projection_equal(&first, &second);
+
+    second.parent_obj.exception_index = 7;
+    assert_projection_changed(&first, &second);
+
+    first.parent_obj.exception_index = 7;
+    assert_projection_changed(&first, &second);
+}
+
+static void test_serror_projection(void)
+{
+    ARMCPU first = { 0 };
+    ARMCPU second = { 0 };
+
+    initialize_inactive_cpu(&first);
+    initialize_inactive_cpu(&second);
+    first.env.serror.has_esr = true;
+    first.env.serror.esr = 1;
+    second.env.serror.esr = 2;
+    assert_projection_equal(&first, &second);
+
+    second.env.serror.pending = true;
+    assert_projection_changed(&first, &second);
+
+    first.env.serror.pending = true;
+    first.env.serror.has_esr = false;
+    assert_projection_equal(&first, &second);
+
+    first.env.serror.has_esr = true;
+    assert_projection_changed(&first, &second);
+}
+
+static void test_hardware_error_projection(void)
+{
+    ARMCPU first = { 0 };
+    ARMCPU second = { 0 };
+
+    initialize_inactive_cpu(&first);
+    initialize_inactive_cpu(&second);
+    first.env.crucible_hardware_error.syndrome = 1;
+    first.env.crucible_hardware_error.address = 2;
+    first.env.crucible_hardware_error.disr = 3;
+    second.env.crucible_hardware_error.syndrome = 4;
+    second.env.crucible_hardware_error.address = 5;
+    second.env.crucible_hardware_error.disr = 6;
+    assert_projection_equal(&first, &second);
+
+    first.env.crucible_hardware_error.synchronous_pending = true;
+    second.env.crucible_hardware_error.synchronous_pending = true;
+    assert_projection_changed(&first, &second);
+
+    first.env.crucible_hardware_error.asynchronous_pending = true;
+    g_assert_null(project_arm_continuation(&first, false));
+
+    first.env.crucible_hardware_error.synchronous_pending = false;
+    first.env.crucible_hardware_error.asynchronous_pending = false;
+    first.env.crucible_hardware_error.fatal = true;
+    g_assert_null(project_arm_continuation(&first, false));
+}
+
+static void test_timer_projection(void)
+{
+    ARMCPU first = { 0 };
+    ARMCPU second = { 0 };
+    QEMUTimer *first_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL,
+                                          noop_timer_callback, NULL);
+    QEMUTimer *second_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL,
+                                           noop_timer_callback, NULL);
+
+    initialize_inactive_cpu(&first);
+    initialize_inactive_cpu(&second);
+    first.gt_timer[GTIMER_PHYS] = first_timer;
+    second.gt_timer[GTIMER_PHYS] = second_timer;
+    first.crucible_gt_guest_deadline_ps[GTIMER_PHYS] = 1;
+    first.crucible_gt_transform_generation[GTIMER_PHYS] = 2;
+    second.crucible_gt_guest_deadline_ps[GTIMER_PHYS] = 3;
+    second.crucible_gt_transform_generation[GTIMER_PHYS] = 4;
+    assert_projection_equal(&first, &second);
+
+    timer_mod_ns(first_timer, 10);
+    timer_mod_ns(second_timer, 20);
+    assert_projection_changed(&first, &second);
+
+    timer_del(first_timer);
+    timer_del(second_timer);
+    first.crucible_gt_timer_arm_sequence[GTIMER_PHYS] = 1;
+    second.crucible_gt_timer_arm_sequence[GTIMER_PHYS] = 1;
+    assert_projection_changed(&first, &second);
+
+    timer_free(first_timer);
+    timer_free(second_timer);
+}
+
+static void test_projection_does_not_mutate(void)
+{
+    ARMCPU cpu = { 0 };
+    ARMCPU before;
+    g_autoptr(GBytes) projection = NULL;
+
+    initialize_inactive_cpu(&cpu);
+    cpu.env.serror.pending = true;
+    cpu.env.serror.has_esr = true;
+    cpu.env.serror.esr = 0x1234;
+    before = cpu;
+
+    projection = project_arm_continuation(&cpu, true);
+    g_assert_nonnull(projection);
+    g_assert_cmpmem(&cpu, sizeof(cpu), &before, sizeof(before));
+}
+
+int main(int argc, char **argv)
+{
+    qemu_init_clocks(NULL);
+    module_call_init(MODULE_INIT_QOM);
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/crucible/arm/exclusive", test_exclusive_projection);
+    g_test_add_func("/crucible/arm/exception", test_exception_projection);
+    g_test_add_func("/crucible/arm/serror", test_serror_projection);
+    g_test_add_func("/crucible/arm/hardware-error",
+                    test_hardware_error_projection);
+    g_test_add_func("/crucible/arm/timer", test_timer_projection);
+    g_test_add_func("/crucible/arm/nonmutation",
+                    test_projection_does_not_mutate);
+    return g_test_run();
+}
diff --git a/tests/unit/test-crucible-arm-register-preflight.py b/tests/unit/test-crucible-arm-register-preflight.py
new file mode 100644
index 0000000000000000000000000000000000000000..71e81bb172b541ee81b0048ecdf43db9db80d37d
--- /dev/null
+++ b/tests/unit/test-crucible-arm-register-preflight.py
@@ -0,0 +1,200 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Check literal AArch64 count preflight without descriptor allocation.
+
+The realized registry and feature fields are component inputs. No Source
+constructor, CPU callback, descriptor workspace or allocation payer is issued.
+"""
+
+import argparse
+import json
+import os
+from pathlib import Path
+import runpy
+import shlex
+import subprocess
+
+
+INPUTS = r"""
+static ARMCPU input_cpu;
+static size_t key_workspace_births;
+
+static GArray *observed_key_workspace(gboolean zero_terminated,
+                                      gboolean clear, guint element_size)
+{
+    key_workspace_births++;
+    return g_array_new(zero_terminated, clear, element_size);
+}
+
+#undef ARM_CPU
+#define ARM_CPU(cpu) (&input_cpu)
+#define g_array_new observed_key_workspace
+"""
+
+CHECKS = r"""
+/* Frozen eligibility from the allocating count/keys implementation. Keep this
+ * oracle independent of the production shared predicate. */
+static bool old_eligibility(const ARMCPRegInfo *ri)
+{
+    bool explicit_exception = ri->name &&
+        (!strcmp(ri->name, "ELR_EL1") || !strcmp(ri->name, "SPSR_EL1") ||
+         !strcmp(ri->name, "ELR_EL2") || !strcmp(ri->name, "SPSR_EL2") ||
+         !strcmp(ri->name, "ELR_EL3") || !strcmp(ri->name, "SPSR_EL3"));
+
+    return ri->state == ARM_CP_STATE_AA64 &&
+        !(ri->type & (ARM_CP_NO_RAW | ARM_CP_NO_GDB)) && !explicit_exception;
+}
+
+static void check_registry(size_t expected_fixed)
+{
+    GHashTableIter iter;
+    gpointer raw_value;
+    size_t expected = expected_fixed;
+
+    g_hash_table_iter_init(&iter, input_cpu.cp_regs);
+    while (g_hash_table_iter_next(&iter, NULL, &raw_value)) {
+        expected += old_eligibility(raw_value);
+    }
+    GArray *keys = a64_crucible_sysreg_keys(&input_cpu);
+    assert(keys->len + expected_fixed == expected);
+    for (guint index = 1; index < keys->len; index++) {
+        assert(g_array_index(keys, uint32_t, index - 1) <
+               g_array_index(keys, uint32_t, index));
+    }
+    g_array_unref(keys);
+    key_workspace_births = 0;
+    assert(aarch64_crucible_register_count(NULL) == expected);
+    assert(key_workspace_births == 0);
+}
+
+int main(void)
+{
+    ARMCPRegInfo rows[] = {
+        { .name = "ordinary", .state = ARM_CP_STATE_AA64 },
+        { .name = "aarch32", .state = ARM_CP_STATE_AA32 },
+        { .name = "no-raw", .state = ARM_CP_STATE_AA64, .type = ARM_CP_NO_RAW },
+        { .name = "no-gdb", .state = ARM_CP_STATE_AA64, .type = ARM_CP_NO_GDB },
+        { .name = "ELR_EL1", .state = ARM_CP_STATE_AA64 },
+        { .name = "SPSR_EL1", .state = ARM_CP_STATE_AA64 },
+        { .name = "ELR_EL2", .state = ARM_CP_STATE_AA64 },
+        { .name = "SPSR_EL2", .state = ARM_CP_STATE_AA64 },
+        { .name = "ELR_EL3", .state = ARM_CP_STATE_AA64 },
+        { .name = "SPSR_EL3", .state = ARM_CP_STATE_AA64 },
+        { .name = "elr_el1", .state = ARM_CP_STATE_AA64 },
+        { .name = NULL, .state = ARM_CP_STATE_AA64 },
+    };
+    static ARMCPRegInfo large[4100];
+
+    input_cpu.cp_regs = g_hash_table_new(g_direct_hash, g_direct_equal);
+    check_registry(70);
+    for (size_t index = 0; index < G_N_ELEMENTS(rows); index++) {
+        g_hash_table_insert(input_cpu.cp_regs,
+                            GUINT_TO_POINTER(100 - index), &rows[index]);
+    }
+    check_registry(70);
+    for (unsigned features = 0; features < 4; features++) {
+        input_cpu.env.features =
+            (features & 1 ? UINT64_C(1) << ARM_FEATURE_EL2 : 0) |
+            (features & 2 ? UINT64_C(1) << ARM_FEATURE_EL3 : 0);
+        check_registry(70 + (features & 1 ? 2 : 0) + (features & 2 ? 2 : 0));
+    }
+    input_cpu.env.features = 0;
+    input_cpu.sve_max_vq = 1;
+    check_registry(70);
+    FIELD_DP64_IDREG(&input_cpu.isar, ID_AA64PFR0, SVE, 1);
+    input_cpu.sve_max_vq = 0;
+    check_registry(70);
+    input_cpu.sve_max_vq = 1;
+    check_registry(119);
+    input_cpu.sve_max_vq = 16;
+    check_registry(119);
+    input_cpu.sve_max_vq = 0;
+    FIELD_DP64_IDREG(&input_cpu.isar, ID_AA64PFR0, SVE, 0);
+    g_hash_table_remove_all(input_cpu.cp_regs);
+    input_cpu.env.features = 0;
+    for (size_t index = 0; index < G_N_ELEMENTS(large); index++) {
+        large[index] = (ARMCPRegInfo) {
+            .name = "same-name-counts-before-descriptor-validation",
+            .state = ARM_CP_STATE_AA64,
+        };
+        g_hash_table_insert(input_cpu.cp_regs, GUINT_TO_POINTER(index), &large[index]);
+    }
+    check_registry(70);
+    assert(aarch64_crucible_register_count(NULL) == 4170);
+    g_hash_table_unref(input_cpu.cp_regs);
+    puts("PASS literal AArch64 allocation-free count, old eligibility and realized registry edges; no constructor authority");
+    return 0;
+}
+"""
+
+
+ALLOCATING_COUNT = r"""
+size_t aarch64_crucible_register_count(CPUState *cs)
+{
+    ARMCPU *cpu = ARM_CPU(cs);
+    g_autoptr(GArray) keys = a64_crucible_sysreg_keys(cpu);
+
+    return a64_crucible_fixed_count(cpu) + keys->len;
+}
+"""
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--source-root", type=Path,
+                        default=Path(__file__).resolve().parents[2])
+    parser.add_argument("--output-dir", type=Path, required=True)
+    arguments = parser.parse_args()
+    source = arguments.source_root.resolve()
+    output = arguments.output_dir.resolve()
+    output.mkdir(parents=True, exist_ok=True)
+
+    extract = runpy.run_path(str(source / "tests/unit/extract-crucible-startup-source-controls.py"))
+    body = (source / "target/arm/crucible-register.c").read_text()
+    literal = body[body.index("enum {"):body.index("static void a64_crucible_masks(")]
+    for signature in (
+        "static bool a64_crucible_has_sve(",
+        "static size_t a64_crucible_exception_count(",
+        "static bool a64_crucible_is_explicit_exception_sysreg(",
+        "static gint a64_crucible_compare_key(",
+        "static bool a64_crucible_sysreg_in_manifest(",
+        "static GArray *a64_crucible_sysreg_keys(",
+        "static size_t a64_crucible_fixed_count(",
+    ):
+        literal += "\n\n" + extract["function"](body, signature)
+    count = extract["function"](body, "size_t aarch64_crucible_register_count(")
+    variants = {
+        "positive": literal + count,
+        "restore-key-allocation": literal + ALLOCATING_COUNT,
+        "include-no-raw-registers": (literal + count).replace(
+            "(ARM_CP_NO_RAW | ARM_CP_NO_GDB)", "ARM_CP_NO_GDB"),
+    }
+    proof = {}
+    for name, definitions in variants.items():
+        if name != "positive" and definitions == variants["positive"]:
+            raise ValueError(f"negative control did not change the literal count: {name}")
+        generated = output / f"{name}.c"
+        generated.write_text('#include "qemu/osdep.h"\n#include <assert.h>\n'
+                             '#define CPU_DEFS_H\n#include "target/arm/cpu.h"\n'
+                             '#include "target/arm/cpregs.h"\n'
+                             '#include "target/arm/internals.h"\n' + INPUTS + definitions + CHECKS)
+        binary = output / name
+        command = [*shlex.split(os.environ.get("CC", "cc")),
+                   *shlex.split(os.environ.get("CFLAGS", "")),
+                   str(generated), "-o", str(binary),
+                   *shlex.split(os.environ.get("LDFLAGS", ""))]
+        (output / f"{name}.compile-command.json").write_text(json.dumps(command, indent=2) + "\n")
+        subprocess.run(command, check=True)
+        result = subprocess.run([str(binary)], text=True, stdout=subprocess.PIPE,
+                                stderr=subprocess.STDOUT, timeout=30, cwd=output)
+        (output / f"{name}.log").write_text(result.stdout)
+        expected = 0 if name == "positive" else -6
+        if result.returncode != expected:
+            raise RuntimeError(f"unexpected {name} outcome: {result.returncode}\n{result.stdout}")
+        proof[name] = {"returncode": result.returncode, "output": result.stdout}
+    (output / "proof.json").write_text(json.dumps(proof, indent=2) + "\n")
+    print(proof["positive"]["output"], end="")
+    print("PASS allocating-count and eligibility-change controls reached assertions")
+
+
+if __name__ == "__main__":
+    main()
