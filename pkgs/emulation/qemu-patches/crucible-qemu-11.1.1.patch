+#include "../../hw/char/serial-isa.c"
+#undef serial_register_types
+#undef type_init
+#define type_init(function) \
+    static void *const excluded_##function __attribute__((unused)) = function;
+#include "../../hw/input/pckbd.c"
+
+static __int128 observed_ps;
+static unsigned fired;
+
+int64_t cpu_get_clock(void)
+{
+    g_assert_true(observed_ps / 1000 <= INT64_MAX);
+    g_assert_true(observed_ps / 1000 >= INT64_MIN);
+    return observed_ps / 1000;
+}
+
+static __int128 diagnostic_clock(void)
+{
+    return observed_ps;
+}
+
+static __int128 coordinate(int64_t hi, uint64_t lo)
+{
+    return (__int128)hi * ((__int128)1 << 64) + lo;
+}
+
+static void assert_coordinate(__int128 actual, __int128 expected)
+{
+    g_assert_cmpint((int64_t)(actual >> 64), ==, (int64_t)(expected >> 64));
+    g_assert_cmpuint((uint64_t)actual, ==, (uint64_t)expected);
+}
+
+static void callback(void *opaque)
+{
+    fired++;
+}
+
+typedef struct TimerFixture {
+    SerialState serial;
+    KBDState kbd;
+} TimerFixture;
+
+static void initialize(TimerFixture *state)
+{
+    memset(state, 0, sizeof(*state));
+    state->serial.char_transmit_time = 7357;
+    state->serial.fifo_timeout_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL,
+                                                    callback, state);
+    state->serial.modem_status_poll = timer_new_ns(QEMU_CLOCK_VIRTUAL,
+                                                   callback, state);
+    state->kbd.throttle_timer = timer_new_us(QEMU_CLOCK_VIRTUAL, callback, state);
+    fifo8_create(&state->serial.recv_fifo, UART_FIFO_LENGTH);
+    fifo8_create(&state->serial.xmit_fifo, UART_FIFO_LENGTH);
+}
+
+static void destroy(TimerFixture *state)
+{
+    if (state->serial.fifo_timeout_timer) {
+        timer_free(state->serial.fifo_timeout_timer);
+    }
+    if (state->serial.modem_status_poll) {
+        timer_free(state->serial.modem_status_poll);
+    }
+    if (state->kbd.throttle_timer) {
+        timer_free(state->kbd.throttle_timer);
+    }
+    fifo8_destroy(&state->serial.recv_fifo);
+    fifo8_destroy(&state->serial.xmit_fifo);
+}
+
+static int serial_fixture_post_load(void *opaque, int version)
+{
+    SerialState *state = opaque;
+    int status = serial_timing_validate_load(state);
+
+    if (!status) {
+        if (state->timing_exact_loaded) {
+            state->char_transmit_time = state->char_transmit_time_vmstate;
+        }
+        serial_timing_restore(state);
+    }
+    return status;
+}
+
+static int kbd_fixture_pre_save(void *opaque)
+{
+    return kbd_extended_state_pre_save(opaque);
+}
+
+static int kbd_fixture_post_load(void *opaque, int version)
+{
+    KBDState *state = opaque;
+    int status = kbd_timer_validate_load(state);
+
+    if (!status) {
+        kbd_timer_restore(state);
+    }
+    return status;
+}
+
+/* Relevant ordinary eight-byte timer shadows plus actual exact production
+ * subsections and hooks. Device parameter/FIFO/PS2 effect dispatch is excluded.
+ */
+static const VMStateDescription serial_fixture = {
+    .name = "serial",
+    .version_id = 3,
+    .minimum_version_id = 3,
+    .pre_save = serial_timing_wide_pre_save,
+    .pre_load = serial_pre_load,
+    .post_load = serial_fixture_post_load,
+    .fields = (const VMStateField[]) {
+        VMSTATE_INT64(fifo_timeout_ns_shadow, SerialState),
+        VMSTATE_INT64(modem_poll_ns_shadow, SerialState),
+        VMSTATE_END_OF_LIST(),
+    },
+    .subsections = (const VMStateDescription *const[]) {
+        &vmstate_serial_timing_wide,
+        NULL,
+    },
+};
+
+static const VMStateDescription kbd_fixture = {
+    .name = "pckbd",
+    .version_id = 3,
+    .minimum_version_id = 3,
+    .pre_save = kbd_fixture_pre_save,
+    .pre_load = kbd_pre_load,
+    .post_load = kbd_fixture_post_load,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT32(migration_flags, KBDState),
+        VMSTATE_END_OF_LIST(),
+    },
+    .subsections = (const VMStateDescription *const[]) {
+        &vmstate_kbd_timer_wide,
+        NULL,
+    },
+};
+
+static const VMStateDescription *description(bool keyboard)
+{
+    return keyboard ? &kbd_fixture : &serial_fixture;
+}
+
+static void *device(TimerFixture *state, bool keyboard)
+{
+    return keyboard ? (void *)&state->kbd : &state->serial;
+}
+
+static GByteArray *save_state(TimerFixture *state, bool keyboard)
+{
+    QIOChannelBuffer *output = qio_channel_buffer_new(4096);
+    QEMUFile *file = qemu_file_new_output(QIO_CHANNEL(output));
+    GByteArray *bytes = g_byte_array_new();
+    Error *error = NULL;
+
+    g_assert_cmpint(vmstate_save_state(file, description(keyboard),
+                                      device(state, keyboard), NULL, &error), ==, 0);
+    g_assert_null(error);
+    qemu_put_byte(file, QEMU_VM_EOF);
+    g_assert_cmpint(qemu_fflush(file), ==, 0);
+    g_byte_array_append(bytes, output->data, output->usage);
+    qemu_fclose(file);
+    object_unref(OBJECT(output));
+    return bytes;
+}
+
+static int load_state(TimerFixture *state, bool keyboard, GByteArray *bytes)
+{
+    QIOChannelBuffer *input = qio_channel_buffer_new(bytes->len);
+    QEMUFile *file;
+    int status;
+
+    memcpy(input->data, bytes->data, bytes->len);
+    input->usage = bytes->len;
+    file = qemu_file_new_input(QIO_CHANNEL(input));
+    status = vmstate_load_state(file, description(keyboard),
+                               device(state, keyboard), 3, NULL);
+    qemu_fclose(file);
+    object_unref(OBJECT(input));
+    return status;
+}
+
+static QEMUTimer *physical_timer(TimerFixture *state, unsigned index)
+{
+    return index == 0 ? state->serial.fifo_timeout_timer :
+           index == 1 ? state->serial.modem_status_poll : state->kbd.throttle_timer;
+}
+
+static const struct {
+    int64_t hi;
+    uint64_t lo;
+} deadlines[] = {
+    { 72057594037927936, 357 },
+    { -72057594037927936, 357 },
+    { INT64_MIN, 0 },
+    { INT64_MAX, UINT64_MAX },
+    { -1, UINT64_MAX },
+    { 0, 0 },
+    { 0, 999 },
+    { 0, 1000 },
+};
+
+static void arm_kind(TimerFixture *state, bool keyboard, __int128 expiry)
+{
+    if (keyboard) {
+        timer_mod_ps_wide(state->kbd.throttle_timer, expiry);
+    } else {
+        timer_mod_ps_wide(state->serial.fifo_timeout_timer, expiry);
+        timer_mod_ps_wide(state->serial.modem_status_poll, expiry);
+    }
+}
+
+static void assert_kind(TimerFixture *state, bool keyboard, bool pending,
+                        __int128 expiry)
+{
+    for (unsigned index = keyboard ? 2 : 0; index < (keyboard ? 3 : 2); index++) {
+        QEMUTimer *timer = physical_timer(state, index);
+
+        g_assert_cmpint(timer_pending(timer), ==, pending);
+        if (pending) {
+            assert_coordinate(timer_expire_time_ps_wide(timer), expiry);
+        }
+    }
+}
+
+static void test_round_trip(gconstpointer opaque)
+{
+    unsigned data = GPOINTER_TO_UINT(opaque);
+    bool keyboard = data >= 9;
+    unsigned index = data % 9;
+    bool pending = index < ARRAY_SIZE(deadlines);
+    __int128 expiry = pending ? coordinate(deadlines[index].hi,
+                                           deadlines[index].lo) : 0;
+    TimerFixture source, destination;
+    GByteArray *bytes;
+
+    initialize(&source);
+    initialize(&destination);
+    if (pending) {
+        arm_kind(&source, keyboard, expiry);
+    }
+    bytes = save_state(&source, keyboard);
+    arm_kind(&destination, keyboard, 1);
+
+    g_assert_cmpint(load_state(&destination, keyboard, bytes), ==, 0);
+    assert_kind(&destination, keyboard, pending, expiry);
+    if (!keyboard) {
+        g_assert_cmpuint(destination.serial.char_transmit_time, ==, 7357);
+    }
+
+    g_byte_array_unref(bytes);
+    destroy(&source);
+    destroy(&destination);
+}
+
+static size_t section_offset(GByteArray *bytes, const char *name)
+{
+    for (size_t index = 0; index + strlen(name) < bytes->len; index++) {
+        if (!memcmp(bytes->data + index, name, strlen(name))) {
+            return index - 2;
+        }
+    }
+    g_assert_not_reached();
+}
+
+static void test_malformed(gconstpointer opaque)
+{
+    unsigned data = GPOINTER_TO_UINT(opaque);
+    bool keyboard = data >= 15;
+    unsigned index = data % 15;
+    const char *name = keyboard ? "pckbd/timer-wide" : "serial/timing-wide";
+    TimerFixture source, destination;
+    GByteArray *bytes;
+    size_t section, payload;
+
+    initialize(&source);
+    initialize(&destination);
+    arm_kind(&source, keyboard, 7357);
+    bytes = save_state(&source, keyboard);
+    section = section_offset(bytes, name);
+    payload = section + 2 + strlen(name) + 4;
+
+    switch (index) {
+    case 0:
+        g_byte_array_set_size(bytes, section + 1);
+        bytes->data[section] = QEMU_VM_EOF;
+        break;
+    case 1:
+        bytes->data[payload] = 2;
+        break;
+    case 2:
+        bytes->data[payload + 1] = keyboard ? 0 : 1;
+        break;
+    case 3:
+        bytes->data[payload + 2] = keyboard ? 2 : 4;
+        break;
+    case 4:
+        bytes->data[payload + 2] = 0;
+        if (keyboard) {
+            bytes->data[3] = 0;
+        }
+        break;
+    case 5:
+        bytes->data[payload - 1] = 2;
+        break;
+    case 6: {
+        GByteArray *duplicate = g_byte_array_new();
+
+        g_byte_array_append(duplicate, bytes->data + section,
+                             bytes->len - section - 1);
+        g_byte_array_set_size(bytes, bytes->len - 1);
+        g_byte_array_append(bytes, duplicate->data, duplicate->len);
+        g_byte_array_append(bytes, (const uint8_t[]){ QEMU_VM_EOF }, 1);
+        g_byte_array_unref(duplicate);
+        break;
+    }
+    case 7:
+        g_byte_array_set_size(bytes, payload + 10);
+        break;
+    case 8:
+        bytes->data[payload] = 0;
+        break;
+    case 9: {
+        const char *legacy_name = keyboard ? "pckbd/throttle-timer-ps" :
+                                             "serial/timing-ps";
+        GByteArray *legacy = g_byte_array_new();
+        uint8_t header[] = { QEMU_VM_SUBSECTION, strlen(legacy_name) };
+
+        g_byte_array_append(legacy, bytes->data, section);
+        g_byte_array_append(legacy, header, sizeof(header));
+        g_byte_array_append(legacy, (const uint8_t *)legacy_name,
+                             strlen(legacy_name));
+        g_byte_array_append(legacy, bytes->data + payload - 4,
+                             bytes->len - payload + 4);
+        g_byte_array_unref(bytes);
+        bytes = legacy;
+        break;
+    }
+    case 10:
+        if (keyboard) {
+            bytes->data[3] = 0; /* Actual pending metadata contradicts timer. */
+        } else {
+            memset(bytes->data + payload + 3, 0, 8); /* Zero character duration. */
+        }
+        break;
+    case 11:
+        if (keyboard) {
+            bytes->data[payload + 1] = 2;
+        } else {
+            memset(bytes->data + payload + 3, 0xff, 8);
+        }
+        break;
+    case 12:
+        if (keyboard) {
+            timer_free(destination.kbd.throttle_timer);
+            destination.kbd.throttle_timer = NULL;
+        } else {
+            timer_free(destination.serial.modem_status_poll);
+            destination.serial.modem_status_poll = NULL;
+        }
+        break;
+    case 13:
+        bytes->data[payload + 1] = 8;
+        break;
+    default:
+        bytes->data[payload + 2] = 8;
+        break;
+    }
+    if (keyboard && destination.kbd.throttle_timer) {
+        timer_mod_ps_wide(destination.kbd.throttle_timer, 1);
+    } else if (!keyboard) {
+        timer_mod_ps_wide(destination.serial.fifo_timeout_timer, 1);
+        if (destination.serial.modem_status_poll) {
+            timer_mod_ps_wide(destination.serial.modem_status_poll, 1);
+        }
+    }
+
+    g_assert_cmpint(load_state(&destination, keyboard, bytes), <, 0);
+    for (unsigned timer = keyboard ? 2 : 0; timer < (keyboard ? 3 : 2); timer++) {
+        if (physical_timer(&destination, timer)) {
+            g_assert_false(timer_pending(physical_timer(&destination, timer)));
+        }
+    }
+
+    g_byte_array_unref(bytes);
+    destroy(&source);
+    destroy(&destination);
+}
+
+static GByteArray *project_state(TimerFixture *state, bool keyboard)
+{
+    QIOChannelBuffer *output = qio_channel_buffer_new(4096);
+    QEMUFile *file = qemu_file_new_output(QIO_CHANNEL(output));
+    GByteArray *bytes = g_byte_array_new();
+    Error *error = NULL;
+
+    g_assert_true(keyboard ? kbd_fingerprint_projection(file, &state->kbd, &error) :
+                  serial_fingerprint_projection(file, &state->serial, &error));
+    g_assert_null(error);
+    g_assert_cmpint(qemu_fflush(file), ==, 0);
+    g_byte_array_append(bytes, output->data, output->usage);
+    qemu_fclose(file);
+    object_unref(OBJECT(output));
+    return bytes;
+}
+
+static void test_projection(gconstpointer opaque)
+{
+    unsigned data = GPOINTER_TO_UINT(opaque);
+    bool keyboard = data >= 3;
+    unsigned index = data % 3;
+    TimerFixture state;
+    GByteArray *before, *after;
+
+    initialize(&state);
+    arm_kind(&state, keyboard, -1);
+    before = project_state(&state, keyboard);
+    if (index < 2) {
+        timer_mod_ps_wide(physical_timer(&state, keyboard ? 2 : index),
+                          ((__int128)1 << 120) - 1);
+    } else {
+        timer_del(physical_timer(&state, keyboard ? 2 : 0));
+    }
+    after = project_state(&state, keyboard);
+
+    g_assert_true(before->len != after->len ||
+                  memcmp(before->data, after->data, before->len));
+    g_assert_cmpstr(keyboard ? kbd_fingerprint.schema : serial_fingerprint.schema,
+                    ==, keyboard ? "crucible.qemu.pckbd.v4" :
+                                   "crucible.qemu.serial.v5");
+
+    g_byte_array_unref(before);
+    g_byte_array_unref(after);
+    destroy(&state);
+}
+
+static void test_wrapper_projection(void)
+{
+    TimerFixture state;
+    ISASerialState serial = { 0 };
+    ISAKBDState keyboard = { 0 };
+    Error *error = NULL;
+    QIOChannelBuffer *output;
+    QEMUFile *file;
+    GByteArray *expected;
+
+    initialize(&state);
+    arm_kind(&state, false, ((__int128)1 << 120) + 357);
+    arm_kind(&state, true, -((__int128)1 << 120) + 357);
+    serial.state = state.serial;
+    keyboard.kbd = state.kbd;
+
+    for (unsigned index = 0; index < 2; index++) {
+        output = qio_channel_buffer_new(4096);
+        file = qemu_file_new_output(QIO_CHANNEL(output));
+        expected = project_state(&state, index);
+
+        g_assert_true(index ? kbd_isa_fingerprint_projection(file, &keyboard,
+                                                             &error) :
+                      serial_isa_fingerprint_projection(file, &serial, &error));
+        g_assert_null(error);
+        g_assert_cmpint(qemu_fflush(file), ==, 0);
+        g_assert_cmpmem(output->data, output->usage,
+                        expected->data, expected->len);
+
+        g_byte_array_unref(expected);
+        qemu_fclose(file);
+        object_unref(OBJECT(output));
+    }
+    g_assert_cmpstr(serial_isa_fingerprint.schema, ==,
+                    "crucible.qemu.serial-isa.v3");
+    g_assert_cmpuint(serial_isa_fingerprint.version, ==, 3);
+    g_assert_cmpstr(kbd_isa_fingerprint.schema, ==, "crucible.qemu.pckbd.v3");
+    g_assert_cmpuint(kbd_isa_fingerprint.version, ==, 3);
+    destroy(&state);
+}
+
+static void test_relative_program(gconstpointer opaque)
+{
+    unsigned index = GPOINTER_TO_UINT(opaque);
+    TimerFixture state;
+    QEMUTimer *timer;
+
+    initialize(&state);
+    timer = physical_timer(&state, index % 3);
+    observed_ps = index == 3 ? coordinate(INT64_MAX, UINT64_MAX) :
+                  index == 1 ? -((__int128)1 << 120) + 357 :
+                               ((__int128)1 << 120) + 357;
+    timer_mod_ps_wide(timer, 7357);
+
+    if (index == 3) {
+        g_assert_false(timer_mod_after_ns(timer, SCALE_MS));
+        assert_coordinate(timer_expire_time_ps_wide(timer), 7357);
+    } else {
+        g_assert_true(timer_mod_after_ns(timer, SCALE_MS));
+        assert_coordinate(timer_expire_time_ps_wide(timer),
+                           observed_ps + (__int128)SCALE_MS * 1000);
+    }
+    destroy(&state);
+}
+
+static void test_absent_keyboard(void)
+{
+    TimerFixture source, destination;
+    GByteArray *bytes;
+
+    initialize(&source);
+    initialize(&destination);
+    timer_free(source.kbd.throttle_timer);
+    source.kbd.throttle_timer = NULL;
+    timer_free(destination.kbd.throttle_timer);
+    destination.kbd.throttle_timer = NULL;
+    bytes = save_state(&source, true);
+
+    g_assert_cmpint(load_state(&destination, true, bytes), ==, 0);
+    g_assert_true(destination.kbd.throttle_timer_exact_loaded);
+    g_assert_cmpuint(destination.kbd.throttle_timer_wide_present, ==, 0);
+
+    g_byte_array_unref(bytes);
+    destroy(&source);
+    destroy(&destination);
+}
+
+static void test_callback(gconstpointer opaque)
+{
+    bool keyboard = GPOINTER_TO_UINT(opaque);
+    TimerFixture source, destination;
+    GByteArray *bytes;
+
+    initialize(&source);
+    initialize(&destination);
+    arm_kind(&source, keyboard, -1);
+    bytes = save_state(&source, keyboard);
+    for (unsigned index = 0; index < 3; index++) {
+        timer_del(physical_timer(&source, index));
+    }
+    observed_ps = 0;
+    fired = 0;
+
+    g_assert_cmpint(load_state(&destination, keyboard, bytes), ==, 0);
+    qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL);
+    g_assert_cmpuint(fired, ==, keyboard ? 1 : 2);
+
+    g_byte_array_unref(bytes);
+    destroy(&source);
+    destroy(&destination);
+}
+
+static void test_cross_mode(gconstpointer opaque)
+{
+    unsigned data = GPOINTER_TO_UINT(opaque);
+    bool keyboard = data >= 6;
+    unsigned index = data % 6;
+    const __int128 expiries[] = {
+        357, -1, -1001, ((__int128)1 << 120) + 357,
+        coordinate(INT64_MIN, 0), coordinate(INT64_MAX, UINT64_MAX),
+    };
+
+    if (g_test_subprocess()) {
+        TimerFixture destination;
+        char *contents;
+        gsize length;
+        GByteArray *bytes;
+        int status;
+
+        initialize(&destination);
+        g_assert_true(g_file_get_contents(g_getenv("SERIAL_KBD_IMAGE"),
+                                         &contents, &length, NULL));
+        bytes = g_byte_array_new_take((uint8_t *)contents, length);
+        if (keyboard) {
+            timer_mod_ns(destination.kbd.throttle_timer, 1);
+        } else {
+            timer_mod(destination.serial.fifo_timeout_timer, 1);
+            timer_mod(destination.serial.modem_status_poll, 1);
+        }
+        status = load_state(&destination, keyboard, bytes);
+
+        if (index < 3) {
+            g_assert_cmpint(status, ==, 0);
+            for (unsigned timer = keyboard ? 2 : 0;
+                 timer < (keyboard ? 3 : 2); timer++) {
+                g_assert_true(timer_pending(physical_timer(&destination, timer)));
+                g_assert_cmpint(timer_expire_time_ns(
+                                    physical_timer(&destination, timer)), ==,
+                                index == 0 ? 1 : 0);
+            }
+        } else {
+            g_assert_cmpint(status, <, 0);
+            assert_kind(&destination, keyboard, false, 0);
+        }
+
+        g_byte_array_unref(bytes);
+        destroy(&destination);
+        return;
+    }
+    TimerFixture source;
+    GByteArray *bytes;
+    char *path;
+    int descriptor;
+
+    initialize(&source);
+    arm_kind(&source, keyboard, expiries[index]);
+    bytes = save_state(&source, keyboard);
+    descriptor = g_file_open_tmp("serial-kbd-wide-XXXXXX", &path, NULL);
+    g_assert_cmpint(descriptor, >=, 0);
+    close(descriptor);
+    g_assert_true(g_file_set_contents(path, (const char *)bytes->data,
+                                     bytes->len, NULL));
+    g_setenv("SERIAL_KBD_ORDINARY", "1", true);
+    g_setenv("SERIAL_KBD_IMAGE", path, true);
+
+    g_test_trap_subprocess(NULL, 0, 0);
+    g_test_trap_assert_passed();
+
+    g_unsetenv("SERIAL_KBD_ORDINARY");
+    g_unsetenv("SERIAL_KBD_IMAGE");
+    unlink(path);
+    g_free(path);
+    g_byte_array_unref(bytes);
+    destroy(&source);
+}
+
+static void test_ordinary(void)
+{
+    if (g_test_subprocess()) {
+        TimerFixture source, destination;
+        GByteArray *bytes;
+
+        initialize(&source);
+        initialize(&destination);
+        observed_ps = 7357000;
+        g_assert_true(timer_mod_after_ns(source.serial.fifo_timeout_timer, 1000));
+        bytes = save_state(&source, false);
+
+        g_assert_cmpint(load_state(&destination, false, bytes), ==, 0);
+        g_assert_cmpint(timer_expire_time_ns(destination.serial.fifo_timeout_timer),
+                        ==, 8357);
+        g_assert_false(destination.serial.timing_exact_loaded);
+
+        g_byte_array_unref(bytes);
+        destroy(&source);
+        destroy(&destination);
+        return;
+    }
+    g_setenv("SERIAL_KBD_ORDINARY", "1", true);
+    g_test_trap_subprocess(NULL, 0, 0);
+    g_unsetenv("SERIAL_KBD_ORDINARY");
+    g_test_trap_assert_passed();
+}
+
+int main(int argc, char **argv)
+{
+    Error *error = NULL;
+
+    g_test_init(&argc, &argv, NULL);
+    module_call_init(MODULE_INIT_QOM);
+    qemu_init_main_loop(&error);
+    g_assert_null(error);
+    if (!g_getenv("SERIAL_KBD_ORDINARY")) {
+        qemu_timer_enable_tcg_ps_clock(NULL, diagnostic_clock);
+    }
+    qemu_clock_enable(QEMU_CLOCK_VIRTUAL, true);
+
+    for (unsigned index = 0; index < 18; index++) {
+        char *name = g_strdup_printf("/serial-kbd-wide/migration/%u", index);
+
+        g_test_add_data_func(name, GUINT_TO_POINTER(index), test_round_trip);
+        g_free(name);
+    }
+    for (unsigned index = 0; index < 30; index++) {
+        char *name = g_strdup_printf("/serial-kbd-wide/malformed/%u", index);
+
+        g_test_add_data_func(name, GUINT_TO_POINTER(index), test_malformed);
+        g_free(name);
+    }
+    for (unsigned index = 0; index < 6; index++) {
+        char *name = g_strdup_printf("/serial-kbd-wide/projection/%u", index);
+
+        g_test_add_data_func(name, GUINT_TO_POINTER(index), test_projection);
+        g_free(name);
+    }
+    for (unsigned index = 0; index < 4; index++) {
+        char *name = g_strdup_printf("/serial-kbd-wide/program/%u", index);
+
+        g_test_add_data_func(name, GUINT_TO_POINTER(index), test_relative_program);
+        g_free(name);
+    }
+    for (unsigned index = 0; index < 2; index++) {
+        char *name = g_strdup_printf("/serial-kbd-wide/callback/%u", index);
+
+        g_test_add_data_func(name, GUINT_TO_POINTER(index), test_callback);
+        g_free(name);
+    }
+    for (unsigned index = 0; index < 12; index++) {
+        char *name = g_strdup_printf("/serial-kbd-wide/cross-mode/%u", index);
+
+        g_test_add_data_func(name, GUINT_TO_POINTER(index), test_cross_mode);
+        g_free(name);
+    }
+    g_test_add_func("/serial-kbd-wide/absent-keyboard", test_absent_keyboard);
+    g_test_add_func("/serial-kbd-wide/ordinary", test_ordinary);
+    g_test_add_func("/serial-kbd-wide/wrappers", test_wrapper_projection);
+    return g_test_run();
+}
