+int qemu_plugin_crucible_native_child_bound_current_v1(
+    QemuCrucibleNativeInvocationRegistry *registry,
+    QemuCrucibleCallbackChildOwner *owner)
+{
+#ifndef CONFIG_USER_ONLY
+    pid_t process = getpid();
+    bool association = false;
+    int status;
+    size_t i;
+
+    if (!registry_process_current(registry, process)) {
+        return -EPERM;
+    }
+    status = qemu_crucible_startup_source_callback_child_owner_current_v1(owner);
+    if (status) {
+        return status;
+    }
+    qemu_mutex_lock(&registry->mutex);
+    if (!registry_current_locked(registry, process) || registry->child_owner != owner ||
+        !registry->child_registration_seen || !registry->child || !registry->child_holder ||
+        !registry->child_address || !registry->child_extent || !registry->child_alignment ||
+        registry->registrar_users || registry->source_registrar) {
+        status = -ESTALE;
+    } else if (registry->first_registration_status) {
+        /* Failed real effects remain visible to future Source publication.
+         * Terminal restitution still uses identity and actual debt settlement. */
+        status = registry->first_registration_status;
+    } else {
+        for (i = 0; i < ARRAY_SIZE(registry->registrations); i++) {
+            QemuCrucibleNativeRegistration *record = &registry->registrations[i];
+
+            if (record->descriptor_retained && record->active &&
+                record->source_authenticated && record->owner == registry &&
+                record->child_owner == owner && record->ctx == registry->ctx &&
+                record->module == registry->module && record->coordinate &&
+                record->publication_serial && record->registrar_serial) {
+                association = true;
+            }
+        }
+        status = association ? 0 : -ENOKEY;
+    }
+    qemu_mutex_unlock(&registry->mutex);
+    return status;
+#else
+    (void)registry;
+    (void)owner;
+    return -ENOTSUP;
+#endif
+}
+
+static bool group_debt_locked(QemuCrucibleNativeInvocationRegistry *registry,
+                               QemuCrucibleCallbackChildOwner *child_owner)
+{
+    size_t i;
+    size_t member;
+
+    for (i = 0; i < ARRAY_SIZE(registry->groups); i++) {
+        QemuCrucibleNativeRegistrationGroup *group = registry->groups[i];
+
+        if (!group || (child_owner && group->child_owner != child_owner)) {
+            continue;
+        }
+        if (!group_identity_locked(registry, group) || group->borrow ||
+            group->module_retained || !group->terminal) {
+            return true;
+        }
+        for (member = 0; member < group->member_count; member++) {
+            QemuCrucibleNativeRegistration *record = &group->members[member];
+
+            if (record->descriptor_retained || record->active || record->references) {
+                return true;
+            }
+        }
+    }
+    return false;
+}
+
+#ifndef CONFIG_USER_ONLY
+static bool registration_empty(const QemuCrucibleNativeRegistration *record)
+{
+    return !record->owner && !record->group && !record->child_owner &&
+        !record->ctx && !record->module && !record->publication_serial &&
+        !record->registrar_serial && !record->family && !record->descriptor_retained &&
+        !record->source_authenticated && !record->coordinate && !record->function &&
+        !record->userdata && !record->userdata_coordinate && !record->serial &&
+        !record->references && !record->kind && !record->active;
+}
+
+static int child_terminal_groups_locked(
+    QemuCrucibleNativeInvocationRegistry *registry,
+    QemuCrucibleCallbackChildOwner *owner, bool *association, bool *registered)
+{
+    for (size_t index = 0; index < ARRAY_SIZE(registry->groups); index++) {
+        QemuCrucibleNativeRegistrationGroup *group = registry->groups[index];
+
+        if (!group) {
+            continue;
+        }
+        /* A failed attempt is canonical before module corroboration. It can
+         * precede child_owner/seen, but it cannot belong to another child.
+         * The Source group header's child/members/count/callback associations
+         * are immutable construction facts, including after its holder returns. */
+        if (!group_identity_locked(registry, group) || group_index(group->kind) != index ||
+            group->child_owner != owner || group->owner->child_owner != owner ||
+            group->ctx != registry->ctx || group->module != registry->module) {
+            return -ESTALE;
+        }
+        if (group->borrow || group->module_retained || !group->terminal ||
+            (group->effect_started && !group->effect_finished)) {
+            return -EBUSY;
+        }
+        if (!registry->child_registration_seen &&
+            (group->first_status >= 0 || group->effect_started || group->effect_finished ||
+             group->attempted_mask ||
+             group->installed_mask || group->installed_members)) {
+            return -ESTALE;
+        }
+        bool all_authenticated = true;
+        bool any_authenticated = false;
+
+        for (size_t member = 0; member < group->member_count; member++) {
+            QemuCrucibleNativeRegistration *record = &group->members[member];
+
+            all_authenticated &= record->source_authenticated;
+            any_authenticated |= record->source_authenticated;
+            if (record->owner != registry || record->group != group ||
+                record->child_owner != owner || record->ctx != group->ctx ||
+                record->module != group->module ||
+                record->publication_serial != group->publication_serial ||
+                record->registrar_serial != group->registrar_serial ||
+                (!registry->child_registration_seen && record->source_authenticated)) {
+                return -ESTALE;
+            }
+            if (record->descriptor_retained || record->active || record->references) {
+                return -EBUSY;
+            }
+        }
+        if (any_authenticated &&
+            (!all_authenticated || !group->effect_started || !group->effect_finished ||
+             group->installed_members != group->member_count ||
+             group->attempted_mask != (1U << group->member_count) - 1 ||
+             group->installed_mask != group->attempted_mask)) {
+            return -ESTALE;
+        }
+        *association = true;
+        *registered |= all_authenticated;
+    }
+    return 0;
+}
+#endif
+
+int qemu_plugin_crucible_native_child_registration_terminal_v1(
+    QemuCrucibleNativeInvocationRegistry *registry,
+    QemuCrucibleCallbackChildOwner *owner)
+{
+#ifndef CONFIG_USER_ONLY
+    pid_t process = getpid();
+    bool association = false;
+    bool registered = false;
+    int status;
+
+    /* Source selects the actual prepared registry and authenticates its still
+     * held owner before Native takes its mutex. Geometry and a zero census
+     * cannot select a substitute prepared-only cleanup owner. */
+    if (!registry ||
+        qemu_crucible_startup_source_native_registry_v1(NULL, false) != registry) {
+        return -ESTALE;
+    }
+    status = qemu_crucible_startup_source_callback_child_owner_identity_v1(owner);
+    if (status) {
+        return status;
+    }
+    if (!registry_process_current(registry, process)) {
+        return -EPERM;
+    }
+    qemu_mutex_lock(&registry->mutex);
+    if (!registry_identity_locked(registry, process) ||
+        (registry->child_registration_seen ? registry->child_owner != owner :
+         registry->child_owner != NULL) ||
+        (!registry->child_registration_seen && registry->binding_attempted)) {
+        status = -ESTALE;
+    } else if (!registry->revoked || registry->bound || registry->registrar_users ||
+               registry->source_registrar || registry->source_registrar_serial) {
+        status = -EBUSY;
+    } else if ((registry->child || registry->child_holder || registry->child_address ||
+                registry->child_extent || registry->child_alignment) &&
+               (!registry->child_registration_seen || !registry->child ||
+                !registry->child_holder || !registry->child_address ||
+                !registry->child_extent || !registry->child_alignment)) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        /* Source payload/holder fields are mutable under its own mutex. The
+         * reciprocal identity above authenticates selection; only Native's
+         * retained associations are read while this mutex is held. */
+        status = child_terminal_groups_locked(registry, owner, &association, &registered);
+    }
+    for (size_t index = 0; !status && index < ARRAY_SIZE(registry->registrations); index++) {
+        QemuCrucibleNativeRegistration *record = &registry->registrations[index];
+
+        if (registration_empty(record)) {
+            continue;
+        }
+        if (!registry->child_registration_seen || record->owner != registry ||
+            record->group || record->child_owner != owner || record->ctx != registry->ctx ||
+            record->module != registry->module || !record->serial ||
+            !record->publication_serial || !record->registrar_serial ||
+            !registry->child || !registry->child_holder || !registry->child_address ||
+            !registry->child_extent || !registry->child_alignment) {
+            status = -ESTALE;
+        } else if (record->descriptor_retained || record->active || record->references) {
+            status = -EBUSY;
+        } else {
+            association = true;
+            registered |= record->source_authenticated;
+        }
+    }
+    for (size_t index = 0; !status && index < ARRAY_SIZE(registry->frames); index++) {
+        QemuCrucibleNativeInvocation *frame = &registry->frames[index];
+
+        /* No foreign frame or terminal record may disappear from this proof. */
+        if (frame->canonical_owner || frame->owner || frame->child_owner ||
+            frame->registration || frame->ctx || frame->module || frame->runtime ||
+            frame->storage || frame->storage_holder || frame->serial ||
+            frame->cpu || frame->cpu_owner || frame->cpu_receipt ||
+            frame->cpu_generation || frame->main_holder || frame->main_borrow ||
+            frame->cpu_return_in_flight || frame->initial_cpu_child.serial ||
+            frame->live || frame->use_references || frame->suppressed_children) {
+            status = -EBUSY;
+        }
+    }
+    if (!status && !association && !registry->child_registration_seen && registry->serial) {
+        status = -ESTALE;
+    }
+    if (!status && registry->first_registration_status > 0) {
+        status = -EPROTO;
+    }
+    if (!status && registry->binding_attempted && !registered) {
+        status = -ENOKEY;
+    }
+    if (!status && registry->child_registration_seen && !association &&
+        !registry->first_registration_status) {
+        /* A real registered cohort needs its retained association. An empty
+         * census is sufficient only for an actual Source-prepared registry or
+         * a canonical failed registrar/group attempt with no physical debt. */
+        status = -ENOKEY;
+    }
+    qemu_mutex_unlock(&registry->mutex);
+    return status;
+#else
+    (void)registry;
+    (void)owner;
+    return -ENOTSUP;
+#endif
+}
