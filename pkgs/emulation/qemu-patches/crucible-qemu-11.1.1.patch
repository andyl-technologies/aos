+    g_assert_cmpuint(partition.native_live, ==, 16);
+    g_assert_cmpint(crucible_metadata_inventory_reserve(
+        &partition, 700), ==, 0);
+    g_assert_true(partition.inventory_allowance_retained);
+    g_assert_cmpint(crucible_metadata_native_admit(
+        &partition, 28, &second), ==, 0);
+    g_assert_cmpuint(partition.fixed_native_extent + partition.native_live +
+        partition.inventory_allowance + partition.controller_extent,
+        ==, partition.total);
+    g_assert_cmpint(crucible_metadata_native_admit(
+        &partition, 1, &sentinel), ==, -ENOSPC);
+    g_assert_false(sentinel.held);
+    g_assert_cmpuint(sentinel.bytes, ==, 0);
+
+    g_assert_cmpint(crucible_metadata_inventory_reserve(
+        &partition, 700), ==, 0);
+    g_assert_cmpint(crucible_metadata_inventory_reserve(
+        &partition, 701), ==, -ESTALE);
+    g_assert_cmpuint(partition.inventory_allowance, ==, 700);
+    g_assert_cmpint(crucible_metadata_native_retire(
+        &partition, &first), ==, 0);
+    g_assert_cmpint(crucible_metadata_native_retire(
+        &partition, &second), ==, 0);
+    g_assert_cmpuint(partition.native_live, ==, 0);
+    g_assert_cmpuint(partition.inventory_allowance, ==, 700);
+    g_assert_true(partition.inventory_allowance_retained);
+    crucible_metadata_partition_record_post(&partition, -ECANCELED);
+    g_assert_cmpint(crucible_metadata_inventory_reserve(
+        &partition, 700), ==, -ECANCELED);
+    g_assert_cmpint(crucible_metadata_native_admit(
+        &partition, 1, &sentinel), ==, -ECANCELED);
+    g_assert_false(sentinel.held);
+    g_assert_cmpint(crucible_metadata_partition_status(
+        &partition, -ETIMEDOUT), ==, -ETIMEDOUT);
+    g_assert_cmpint(crucible_metadata_inventory_reserve(
+        &partition, 700), ==, -ETIMEDOUT);
+    g_assert_cmpint(partition.post_status, ==, -ECANCELED);
+}
+
+typedef struct InterleavingFixture {
+    QemuCrucibleMetadataPartition *partition;
+    QemuCrucibleMetadataCharge charge;
+    QemuCrucibleMetadataCharge output;
+    void *allocation;
+    int native_status;
+    int inventory_status;
+    int retire_status;
+} InterleavingFixture;
+
+/* A real joined thread attempts all transitions while the main thread holds
+ * the actual common cut. It models ledger callers, not Source enrollment. */
+static void *interleaving_attempts(void *opaque)
+{
+    InterleavingFixture *fixture = opaque;
+
+    fixture->native_status = crucible_metadata_native_admit(
+        fixture->partition, 1, &fixture->output);
+    fixture->inventory_status = crucible_metadata_inventory_reserve(
+        fixture->partition, 700);
+    g_free(fixture->allocation);
+    fixture->allocation = NULL;
+    fixture->retire_status = crucible_metadata_native_retire(
+        fixture->partition, &fixture->charge);
+    return NULL;
+}
+
+static void test_inventory_interleaving(void)
+{
+    QemuCrucibleMetadataPartition partition;
+    InterleavingFixture fixture = { .partition = &partition };
+    QemuThread thread;
+    uint64_t controller;
+
+    fixture_issue(&partition);
+    g_assert_cmpint(crucible_metadata_controller_reserve(
+        &partition, fixture_requests, &controller), ==, 0);
+    g_assert_cmpint(crucible_metadata_native_admit(
+        &partition, 16, &fixture.charge), ==, 0);
+    fixture.allocation = g_malloc(16);
+    g_assert_true(crucible_metadata_partition_enter(&partition));
+    qemu_thread_create(&thread, "metadata-interleave", interleaving_attempts,
+                       &fixture, QEMU_THREAD_JOINABLE);
+    qemu_thread_join(&thread);
+    g_assert_cmpint(fixture.native_status, ==, -EAGAIN);
+    g_assert_cmpint(fixture.inventory_status, ==, -EAGAIN);
+    g_assert_cmpint(fixture.retire_status, ==, -EAGAIN);
+    g_assert_null(fixture.allocation);
+    g_assert_false(fixture.output.held);
+    g_assert_cmpuint(fixture.output.bytes, ==, 0);
+    g_assert_true(fixture.charge.held);
+    g_assert_cmpuint(partition.native_live, ==, 16);
+    g_assert_false(partition.inventory_allowance_retained);
+    crucible_metadata_partition_leave(&partition);
+
+    /* Physical requested allocation ended, but accounting retirement is
+     * uncertain; the real caller's post record must block further spending. */
+    crucible_metadata_partition_record_post(&partition, fixture.retire_status);
+    g_assert_cmpint(crucible_metadata_native_admit(
+        &partition, 1, &fixture.output), ==, -EAGAIN);
+    g_assert_cmpint(crucible_metadata_inventory_reserve(
+        &partition, 700), ==, -EAGAIN);
+    g_assert_true(fixture.charge.held);
+    g_assert_cmpuint(partition.native_live, ==, 16);
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/crucible/metadata/reserve", test_reserve);
+    g_test_add_func("/crucible/metadata/refusals", test_refusals);
+    g_test_add_func("/crucible/metadata/rcu-overlap", test_rcu_overlap);
+    g_test_add_func("/crucible/metadata/native-capacity", test_native_capacity);
+    g_test_add_func("/crucible/metadata/fixed-and-overlap", test_fixed_and_overlap);
+    g_test_add_func("/crucible/metadata/retirement-failure", test_retirement_failure);
+    g_test_add_func("/crucible/metadata/inventory-conservation",
+                    test_inventory_conservation);
+    g_test_add_func("/crucible/metadata/inventory-interleaving",
+                    test_inventory_interleaving);
+    return g_test_run();
+}
