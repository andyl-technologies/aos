+        request->phase = OBJECT_NATIVE_ALLOCATION_IDLE;
+        pthread_mutex_unlock(&native_allocations.lock);
+        /* Release the pending journal before any initializer/class callback,
+         * permitting genuine nested parent/CPU constructor allocations. */
+    }
+    if (free_payload) {
+        *free_payload = alignment <= __alignof__(max_align_t) ?
+            object_native_paid_g_free : object_native_paid_qemu_vfree;
+    }
+    return payload;
+}
+
+static void *object_native_allocate(TypeImpl *type,
+                                    ObjectNativeAllocationKind kind,
+                                    bool clear, void (**free_payload)(void *))
+{
+    return object_native_allocate_for_parent(type, NULL, kind, clear,
+                                            free_payload);
+}
+
+static void object_native_free_with_dispose(
+    void *payload, void (*free_payload)(void *), void (*dispose)(void *))
+{
+    QemuCrucibleCpuAllocationReceipt *receipt;
+    QemuCrucibleCpuAllocationReceipt *matched = NULL;
+
+    pthread_mutex_lock(&native_allocations.lock);
+    for (receipt = native_allocations.receipts; receipt; receipt = receipt->next) {
+        if (receipt->payload == payload && receipt->free == free_payload &&
+            receipt->process == getpid() && receipt->active &&
+            receipt->allocation_started && !receipt->allocation_abandoned &&
+            !receipt->physical_returned &&
+            !receipt->free_in_flight) {
+            if (receipt->aliases > 1) {
+                receipt->aliases--;
+                pthread_mutex_unlock(&native_allocations.lock);
+                return;
+            }
+            receipt->aliases = 0;
+            receipt->free_in_flight = true;
+            matched = receipt;
+            break;
+        }
+    }
+    pthread_mutex_unlock(&native_allocations.lock);
+    if (dispose) {
+        dispose(payload);
+    }
+    free_payload(payload);
+    if (matched) {
+        /* The exact real allocator returned. Recording is callback-free even
+         * under replay, and Source cannot retire this receipt before this cut. */
+        pthread_mutex_lock(&native_allocations.lock);
+        matched->physical_returned = true;
+        matched->free_in_flight = false;
+        pthread_mutex_unlock(&native_allocations.lock);
+    }
+}
+
+static void object_native_free(void *payload, void (*free_payload)(void *))
+{
+    object_native_free_with_dispose(payload, free_payload, NULL);
+}
+
+static void object_native_condition_dispose(void *payload)
+{
+    qemu_cond_destroy(payload);
+}
+
+static void object_native_plain_condition_free(void *payload)
+{
+    object_native_condition_dispose(payload);
+    g_free(payload);
+}
+
+static void object_native_paid_condition_free(void *payload)
+{
+    object_native_free_with_dispose(payload, g_free,
