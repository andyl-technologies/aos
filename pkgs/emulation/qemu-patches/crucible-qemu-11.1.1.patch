diff --git a/qobject/qobject-lifetime.inc.h b/qobject/qobject-lifetime.inc.h
new file mode 100644
index 0000000000000000000000000000000000000000..a3a0a6d13327da80920cd4ba13fe342ed991f9f3
--- /dev/null
+++ b/qobject/qobject-lifetime.inc.h
@@ -0,0 +1,363 @@
+/*
+ * Ordinary construction journals, included by the real QObject implementation
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+typedef struct QObjectConstructionAllocation {
+    struct QObjectConstructionAllocation *next;
+    void *allocation;
+    size_t extent;
+    uint64_t issuance;
+    bool born;
+    bool returning;
+    bool physically_returned;
+} QObjectConstructionAllocation;
+
+struct QObjectConstructionJournal {
+    QObjectConstructionJournal *next;
+    QObjectConstructionJournal **canonical_holder;
+    QObjectConstructionAllocation *allocations;
+    QemuThread thread;
+    pid_t process;
+    uint64_t issuance;
+    uint64_t control_bytes;
+    uint64_t payload_bytes;
+    uint64_t allocation_attempts;
+    bool entered;
+    bool returned;
+    bool retiring;
+    int first_status;
+    int post_status;
+};
+
+static QObjectConstructionJournal *qobject_construction_calling;
+
+static struct {
+    GMutex lock;
+    pid_t process;
+    uint64_t issuance;
+    QObjectConstructionJournal *head;
+    struct {
+        QObjectConstructionJournal *journal;
+        QObjectConstructionJournal **holder;
+        QObjectConstructionAllocation *next;
+        QemuThread thread;
+        uint64_t issuance;
+        uint64_t controls_returned;
+        uint64_t payload_bytes;
+        uint64_t control_bytes;
+        bool physically_returned;
+        bool active;
+        int first_status;
+        int post_status;
+    } returning;
+} qobject_constructions;
+
+uint64_t qobject_construction_fixed_bytes(void)
+{
+    return sizeof(qobject_constructions) + sizeof(qobject_construction_calling);
+}
+
+static bool qobject_construction_process_current(void)
+{
+    pid_t process = qatomic_load_acquire(&qobject_constructions.process);
+
+    if (!process) {
+        process = qatomic_cmpxchg(&qobject_constructions.process, 0, getpid());
+        if (!process) {
+            process = getpid();
+        }
+    }
+    return process == getpid();
+}
+
+/* The actual registry is authenticated before any supplied journal is read. */
+static QObjectConstructionJournal *qobject_construction_find_locked(
+    QObjectConstructionJournal *journal)
+{
+    QObjectConstructionJournal *actual;
+
+    for (actual = qobject_constructions.head; actual; actual = actual->next) {
+        if (actual == journal) {
+            return actual;
+        }
+    }
+    return NULL;
+}
+
+int qobject_construction_begin(QObjectConstructionJournal **holder)
+{
+    QObjectConstructionJournal *journal;
+
+    if (!holder || *holder ||
+        !qobject_construction_process_current()) {
+        return -EPERM;
+    }
+    g_mutex_lock(&qobject_constructions.lock);
+    if (qobject_construction_calling || qobject_constructions.returning.active ||
+        qobject_constructions.issuance == UINT64_MAX) {
+        g_mutex_unlock(&qobject_constructions.lock);
+        return -EBUSY;
+    }
+    journal = g_new0(QObjectConstructionJournal, 1);
+    journal->issuance = ++qobject_constructions.issuance;
+    journal->process = getpid();
+    qemu_thread_get_self(&journal->thread);
+    journal->canonical_holder = holder;
+    journal->entered = true;
+    journal->control_bytes = sizeof(*journal);
+    journal->next = qobject_constructions.head;
+    qobject_constructions.head = journal;
+    *holder = journal;
+    qobject_construction_calling = journal;
+    g_mutex_unlock(&qobject_constructions.lock);
+    return 0;
+}
+
+int qobject_construction_end(QObjectConstructionJournal *journal)
+{
+    int status;
+
+    if (!qobject_construction_process_current()) {
+        return -EPERM;
+    }
+    g_mutex_lock(&qobject_constructions.lock);
+    journal = qobject_construction_find_locked(journal);
+    status = journal && journal == qobject_construction_calling &&
+        journal->entered && !journal->returned && !journal->retiring &&
+        journal->process == getpid() && qemu_thread_is_self(&journal->thread) ?
+        0 : -EPERM;
+    if (!status) {
+        /* Actual parser return revokes construction even if its independent
+         * canonical-holder post refuses. The retained journal keeps the debt. */
+        journal->returned = true;
+        qobject_construction_calling = NULL;
+        if (*journal->canonical_holder != journal && !journal->post_status) {
+            journal->post_status = -EPERM;
+        }
+        status = journal->first_status ? journal->first_status : journal->post_status;
+    }
+    g_mutex_unlock(&qobject_constructions.lock);
+    return status;
+}
+
+static QObjectConstructionAllocation *qobject_construction_admit(size_t extent)
+{
+    QObjectConstructionJournal *journal;
+    QObjectConstructionAllocation *record;
+
+    if (!qatomic_load_acquire(&qobject_constructions.process) ||
+        !qobject_construction_process_current()) {
+        return NULL;
+    }
+    g_mutex_lock(&qobject_constructions.lock);
+    journal = qobject_construction_calling;
+    if (!journal || !qemu_thread_is_self(&journal->thread)) {
+        g_mutex_unlock(&qobject_constructions.lock);
+        return NULL;
+    }
+    journal = qobject_construction_find_locked(journal);
+    if (!journal || journal->returned || journal->retiring) {
+        g_mutex_unlock(&qobject_constructions.lock);
+        abort();
+    }
+    if (qobject_constructions.issuance == UINT64_MAX ||
+        journal->allocation_attempts == UINT64_MAX ||
+        journal->control_bytes > UINT64_MAX - sizeof(*record) ||
+        journal->payload_bytes > UINT64_MAX - extent) {
+        /* Preserve ordinary constructor output semantics, with sticky debt
+         * instead of a clean retirement of an untracked allocation. */
+        journal->first_status = -EOVERFLOW;
+        g_mutex_unlock(&qobject_constructions.lock);
+        return NULL;
+    }
+    record = g_new0(QObjectConstructionAllocation, 1);
+    record->extent = extent;
+    record->issuance = ++qobject_constructions.issuance;
+    journal->allocation_attempts++;
+    record->next = journal->allocations;
+    journal->allocations = record;
+    journal->control_bytes += sizeof(*record);
+    journal->payload_bytes += extent;
+    g_mutex_unlock(&qobject_constructions.lock);
+    return record;
+}
+
+void *qobject_construction_malloc(size_t extent, bool zero)
+{
+    QObjectConstructionAllocation *record = qobject_construction_admit(extent);
+    void *allocation = zero ? g_malloc0(extent) : g_malloc(extent);
+
+    if (record) {
+        g_mutex_lock(&qobject_constructions.lock);
+        record->allocation = allocation;
+        record->born = true;
+        g_mutex_unlock(&qobject_constructions.lock);
+    }
+    return allocation;
+}
+
+char *qobject_construction_strndup(const char *text, size_t length)
+{
+    size_t used = strnlen(text, length);
+    char *copy;
+
+    assert(used != SIZE_MAX);
+    copy = qobject_construction_malloc(used + 1, false);
+    memcpy(copy, text, used);
+    copy[used] = 0;
+    return copy;
+}
+
+char *qobject_construction_take_gstring(GString *string)
+{
+    bool owned;
+    char *copy;
+
+    if (!qatomic_load_acquire(&qobject_constructions.process) ||
+        !qobject_construction_process_current()) {
+        return g_string_free(string, false);
+    }
+    g_mutex_lock(&qobject_constructions.lock);
+    owned = qobject_construction_calling &&
+        qemu_thread_is_self(&qobject_construction_calling->thread);
+    g_mutex_unlock(&qobject_constructions.lock);
+    if (!owned) {
+        return g_string_free(string, false);
+    }
+    /* Retained graph storage is produced here, rather than adopting an opaque
+     * GString allocator extent. Parser scratch remains ordinary GLib storage. */
+    assert(string->len != SIZE_MAX);
+    copy = qobject_construction_malloc(string->len + 1, false);
+    memcpy(copy, string->str, string->len + 1);
+    g_string_free(string, true);
+    return copy;
+}
+
+void qobject_construction_free(void *allocation)
+{
+    QObjectConstructionJournal *journal;
+    QObjectConstructionAllocation *record = NULL;
+
+    if (!allocation) {
+        return;
+    }
+    if (!qatomic_load_acquire(&qobject_constructions.process) ||
+        !qobject_construction_process_current()) {
+        /* Preserve generic ordinary destruction in a fork. A copied journal
+         * never receives a receipt and its nominal return still refuses. */
+        g_free(allocation);
+        return;
+    }
+    g_mutex_lock(&qobject_constructions.lock);
+    for (journal = qobject_constructions.head; journal; journal = journal->next) {
+        for (record = journal->allocations; record; record = record->next) {
+            if (record->allocation == allocation && !record->physically_returned) {
+                break;
+            }
+        }
+        if (record) {
+            break;
+        }
+    }
+    if (record && record->returning) {
+        journal->post_status = -EBUSY;
+        g_mutex_unlock(&qobject_constructions.lock);
+        return;
+    }
+    if (record) {
+        record->returning = true;
+    }
+    g_mutex_unlock(&qobject_constructions.lock);
+
+    g_free(allocation);
+
+    if (record) {
+        g_mutex_lock(&qobject_constructions.lock);
+        record->physically_returned = true;
+        g_mutex_unlock(&qobject_constructions.lock);
+    }
+}
+
+int qobject_construction_return(QObjectConstructionJournal **holder,
+                                QObjectConstructionReceipt *receipt)
+{
+    QObjectConstructionJournal *journal;
+    QObjectConstructionJournal **link;
+    QObjectConstructionAllocation *record;
+    uint64_t allocation_count = 0;
+    int post;
+
+    if (!holder || !receipt || receipt->physically_returned ||
+        !qobject_construction_process_current()) {
+        return -EPERM;
+    }
+    g_mutex_lock(&qobject_constructions.lock);
+    /* Compare holder coordinates before dereferencing caller storage. */
+    for (journal = qobject_constructions.head; journal; journal = journal->next) {
+        if (journal->canonical_holder == holder) {
+            break;
+        }
+    }
+    if (!journal || *holder != journal || journal->process != getpid() ||
+        !qemu_thread_is_self(&journal->thread)) {
+        g_mutex_unlock(&qobject_constructions.lock);
+        return -EPERM;
+    }
+    if (!journal->returned || journal->retiring || journal->first_status ||
+        journal->post_status || qobject_constructions.returning.active) {
+        g_mutex_unlock(&qobject_constructions.lock);
+        return -EBUSY;
+    }
+    for (record = journal->allocations; record; record = record->next) {
+        allocation_count++;
+        if (!record->born || !record->returning || !record->physically_returned) {
+            g_mutex_unlock(&qobject_constructions.lock);
+            return -EBUSY;
+        }
+    }
+    if (allocation_count != journal->allocation_attempts) {
+        g_mutex_unlock(&qobject_constructions.lock);
+        return -EBUSY;
+    }
+    journal->retiring = true;
+    qobject_constructions.returning.journal = journal;
+    qobject_constructions.returning.holder = holder;
+    qobject_constructions.returning.issuance = journal->issuance;
+    qobject_constructions.returning.next = journal->allocations;
+    qobject_constructions.returning.controls_returned = 0;
+    qobject_constructions.returning.control_bytes = journal->control_bytes;
+    qobject_constructions.returning.payload_bytes = journal->payload_bytes;
+    qobject_constructions.returning.physically_returned = false;
+    qobject_constructions.returning.first_status = journal->first_status;
+    qobject_constructions.returning.post_status = journal->post_status;
+    qobject_constructions.returning.active = true;
+    qemu_thread_get_self(&qobject_constructions.returning.thread);
+    while ((record = qobject_constructions.returning.next)) {
+        qobject_constructions.returning.next = record->next;
+        g_free(record);
+        qobject_constructions.returning.controls_returned++;
+    }
+    for (link = &qobject_constructions.head; *link != journal; link = &(*link)->next) {
+    }
+    *link = journal->next;
+    g_free(journal);
+    qobject_constructions.returning.physically_returned = true;
+    if (!qemu_thread_is_self(&qobject_constructions.returning.thread)) {
+        qobject_constructions.returning.post_status = -EPERM;
+    }
+    /* Physical consumption is retained independently of the post. */
+    receipt->control_bytes = qobject_constructions.returning.control_bytes;
+    receipt->payload_bytes = qobject_constructions.returning.payload_bytes;
+    receipt->allocations_returned = qobject_constructions.returning.controls_returned;
+    receipt->physically_returned = qobject_constructions.returning.physically_returned;
+    receipt->first_status = qobject_constructions.returning.first_status;
+    receipt->post_status = qobject_constructions.returning.post_status;
+    *holder = NULL;
+    if (!qobject_constructions.returning.post_status) {
+        qobject_constructions.returning.active = false;
+    }
+    post = qobject_constructions.returning.post_status;
+
+    g_mutex_unlock(&qobject_constructions.lock);
+    return post;
+}
diff --git a/qobject/qobject-source.c b/qobject/qobject-source.c
new file mode 100644
index 0000000000000000000000000000000000000000..c2fb469e96c66f1a8c6de76234f50bee186e1f67
--- /dev/null
+++ b/qobject/qobject-source.c
@@ -0,0 +1,702 @@
+/*
+ * Checked selected QObject construction, graph custody and last free
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+#include "qemu/osdep.h"
+#include "qemu/crucible-qmp-allocation.h"
+#include "qobject/qobject-source.h"
+#include "qobject/qnull.h"
+#include "qobject-internal.h"
+
+static int source_owned_extent(const void *payload,
+                                QemuCrucibleQmpAllocationOwner *expected,
+                                size_t minimum, size_t *extent);
+
+static int source_object_new(unsigned kind, void **out)
+{
+    int status;
+
+    if (!out) {
+        return -EINVAL;
+    }
+    *out = NULL;
+    status = qemu_crucible_qmp_object_allocate(kind, out);
+    if (out && *out) {
+        /* Actual allocation survives a negative publication post. Initialize
+         * only its physical cleanup shape, never publish semantic success. */
+        qobject_init(*out, kind);
+        ((QObject *)*out)->base.source_owned = true;
+    }
+    return status;
+}
+
+int qdict_new_source(QDict **out)
+{
+    return source_object_new(QTYPE_QDICT, (void **)out);
+}
+
+int qlist_new_source(QList **out)
+{
+    int status = source_object_new(QTYPE_QLIST, (void **)out);
+
+    if (out && *out) {
+        QTAILQ_INIT(&(*out)->head);
+    }
+    return status;
+}
+
+int qnum_from_int_source(int64_t value, QNum **out)
+{
+    int status = source_object_new(QTYPE_QNUM, (void **)out);
+
+    if (out && *out) {
+        (*out)->kind = QNUM_I64;
+        (*out)->u.i64 = value;
+    }
+    return status;
+}
+
+int qnum_from_uint_source(uint64_t value, QNum **out)
+{
+    int status = source_object_new(QTYPE_QNUM, (void **)out);
+
+    if (out && *out) {
+        (*out)->kind = QNUM_U64;
+        (*out)->u.u64 = value;
+    }
+    return status;
+}
+
+int qnum_from_double_source(double value, QNum **out)
+{
+    int status = source_object_new(QTYPE_QNUM, (void **)out);
+
+    if (out && *out) {
+        (*out)->kind = QNUM_DOUBLE;
+        (*out)->u.dbl = value;
+    }
+    return status;
+}
+
+int qbool_from_bool_source(bool value, QBool **out)
+{
+    int status = source_object_new(QTYPE_QBOOL, (void **)out);
+
+    if (out && *out) {
+        (*out)->value = value;
+    }
+    return status;
+}
+
+int qstring_reserve_source(size_t capacity, QString **out)
+{
+    QemuCrucibleQmpAllocationOwner *owner;
+    void *buffer = NULL;
+    int status;
+
+    if (!capacity || !out) {
+        return -EINVAL;
+    }
+    *out = NULL;
+    status = qemu_crucible_qmp_scope_identity_current(&owner);
+    if (!status) {
+        status = source_object_new(QTYPE_QSTRING, (void **)out);
+    }
+    if (status) {
+        return status;
+    }
+    status = qemu_crucible_qmp_allocate(owner, capacity, false, &buffer);
+    if (buffer) {
+        (*out)->string = buffer;
+        (*out)->source_capacity = capacity;
+        ((char *)buffer)[0] = 0;
+    }
+    return status;
+}
+
+int qstring_from_bytes_source(const char *bytes, size_t count, QString **out)
+{
+    int status;
+
+    if (!bytes || count == SIZE_MAX) {
+        return -EINVAL;
+    }
+    status = qstring_reserve_source(count + 1, out);
+    if (!status) {
+        memcpy((char *)(*out)->string, bytes, count);
+        ((char *)(*out)->string)[count] = 0;
+    }
+    return status;
+}
+
+int qstring_from_gstring_source(GString **string, QString **out)
+{
+    char *segment = NULL;
+    size_t capacity;
+    int status;
+
+    if (!string || !*string || !out) {
+        return -EINVAL;
+    }
+    *out = NULL;
+    /* Real Source registry qualification precedes GString field access. The
+     * sole owner has already returned every mutation loan before this steal. */
+    size_t length;
+
+    status = qemu_crucible_qmp_string_observe(*string, &length, &capacity);
+    if (status) {
+        return status;
+    }
+    if (!capacity || length >= capacity) {
+        return -ESTALE;
+    }
+    status = source_object_new(QTYPE_QSTRING, (void **)out);
+    if (status) {
+        return status;
+    }
+    status = qemu_crucible_qmp_string_free(string, &segment);
+    if (segment) {
+        /* Steal moves the same paid allocation; actual failed body cleanup
+         * cannot erase or donate this escaped segment's original owner. */
+        (*out)->string = segment;
+        (*out)->source_capacity = capacity;
+    }
+    return status;
+}
+
+static int source_object_observe(const QObject *object, unsigned *kind,
+                                 QemuCrucibleQmpAllocationOwner **owner)
+{
+    int status;
+
+    if (!object) {
+        return -EINVAL;
+    }
+    status = qemu_crucible_qmp_object_observe(object, kind, owner);
+    if (!status && (!object->base.source_owned || object->base.type != *kind)) {
+        status = -ESTALE;
+    }
+    return status;
+}
+
+int qobject_source_current(const QObject *object)
+{
+    QemuCrucibleQmpAllocationOwner *owner;
+    unsigned kind;
+
+    /* qnull_ is the existing indestructible compiled singleton, not dynamic
+     * input storage and not a received pointer selecting a physical payer. */
+    if (object == QOBJECT(&qnull_)) {
+        return 0;
+    }
+    return source_object_observe(object, &kind, &owner);
+}
+
+static int source_container_owner(const QObject *object, unsigned expected,
+                                   QemuCrucibleQmpAllocationOwner **owner)
+{
+    QemuCrucibleQmpAllocationOwner *current;
+    unsigned kind;
+    int status = source_object_observe(object, &kind, owner);
+
+    if (!status && kind != expected) {
+        status = -EINVAL;
+    }
+    if (!status) {
+        status = qemu_crucible_qmp_scope_identity_current(&current);
+    }
+    if (!status && *owner != current) {
+        status = -EPERM;
+    }
+    return status;
+}
+
+static int source_dict_find(QDict *dict, QemuCrucibleQmpAllocationOwner *owner,
+                             const char *key, unsigned bucket, QDictEntry **out)
+{
+    QDictEntry *entry = QLIST_FIRST(&dict->table[bucket]);
+    size_t visited = 0;
+
+    *out = NULL;
+    while (entry) {
+        size_t extent;
+        int status;
+
+        if (++visited > dict->size) {
+            return -ESTALE;
+        }
+        status = source_owned_extent(entry, owner, sizeof(*entry), &extent);
+        if (!status) {
+            status = source_owned_extent(entry->key, owner, 1, &extent);
+        }
+        if (!status && !memchr(entry->key, 0, extent)) {
+            status = -ESTALE;
+        }
+        if (status) {
+            return status;
+        }
+        if (!strcmp(entry->key, key)) {
+            *out = entry;
+            return 0;
+        }
+        entry = QLIST_NEXT(entry, next);
+    }
+    return 0;
+}
+
+int qdict_put_obj_source(QDict *dict, const char *key, QObject **value)
+{
+    QemuCrucibleQmpAllocationOwner *owner;
+    QDictEntry *entry;
+    void *payload = NULL;
+    size_t count;
+    unsigned bucket;
+    int status;
+
+    if (!dict || !key || !value || !*value) {
+        return -EINVAL;
+    }
+    status = source_container_owner(QOBJECT(dict), QTYPE_QDICT, &owner);
+    if (!status) {
+        status = qobject_source_current(*value);
+    }
+    if (status) {
+        return status;
+    }
+    if (dict->source_pending) {
+        return -EINPROGRESS;
+    }
+    bucket = qdict_source_bucket(key);
+    status = source_dict_find(dict, owner, key, bucket, &entry);
+    if (status || entry) {
+        return status ? status : -EEXIST;
+    }
+    count = strlen(key);
+    if (count == SIZE_MAX) {
+        return -EOVERFLOW;
+    }
+    status = qemu_crucible_qmp_allocate(owner, sizeof(*entry), true, &payload);
+    if (payload) {
+        dict->source_pending = payload;
+    }
+    if (status) {
+        return status;
+    }
+    entry = payload;
+    payload = NULL;
+    status = qemu_crucible_qmp_allocate(owner, count + 1, false, &payload);
+    if (payload) {
+        entry->key = payload;
+    }
+    if (status) {
+        return status;
+    }
+    memcpy(entry->key, key, count + 1);
+    /* Preserve QDict's existing hash and intrinsic fixed table. No hidden
+     * GLib hash capacity or separate guessed bank is introduced. */
+    bucket = qdict_source_bucket(key);
+    entry->value = *value;
+    QLIST_INSERT_HEAD(&dict->table[bucket], entry, next);
+    dict->size++;
+    dict->source_pending = NULL;
+    *value = NULL;
+    return 0;
+}
+
+int qlist_append_obj_source(QList *list, QObject **value)
+{
+    QemuCrucibleQmpAllocationOwner *owner;
+    QListEntry *entry;
+    void *payload = NULL;
+    int status;
+
+    if (!list || !value || !*value) {
+        return -EINVAL;
+    }
+    status = source_container_owner(QOBJECT(list), QTYPE_QLIST, &owner);
+    if (!status) {
+        status = qobject_source_current(*value);
+    }
+    if (status) {
+        return status;
+    }
+    if (list->source_pending) {
+        return -EINPROGRESS;
+    }
+    status = qemu_crucible_qmp_allocate(owner, sizeof(*entry), true, &payload);
+    if (payload) {
+        list->source_pending = payload;
+    }
+    if (status) {
+        return status;
+    }
+    entry = payload;
+    entry->value = *value;
+    QTAILQ_INSERT_TAIL(&list->head, entry, next);
+    list->source_pending = NULL;
+    *value = NULL;
+    return 0;
+}
+
+static int source_dict_entry_free(QDictEntry *entry,
+                                   QemuCrucibleQmpAllocationOwner *owner)
+{
+    void *key;
+    size_t extent;
+    int status = source_owned_extent(entry, owner, sizeof(*entry), &extent);
+
+    if (status) {
+        return status;
+    }
+    key = entry->key;
+    if (key) {
+        status = source_owned_extent(key, owner, 1, &extent);
+        if (status) {
+            return status;
+        }
+    }
+
+    if (entry->value) {
+        status = qobject_unref_source(&entry->value);
+        if (status) {
+            return status;
+        }
+    }
+    if (key) {
+        status = qemu_crucible_qmp_free(&key);
+        entry->key = key;
+        if (status) {
+            return status;
+        }
+    }
+    return 0;
+}
+
+static int source_dict_destroy(QDict *dict, QemuCrucibleQmpAllocationOwner *owner)
+{
+    int status;
+
+    if (dict->source_pending) {
+        QDictEntry *pending = dict->source_pending;
+        void *payload = pending;
+
+        status = source_dict_entry_free(pending, owner);
+        if (!status) {
+            status = qemu_crucible_qmp_free(&payload);
+            dict->source_pending = payload;
+        }
+        if (status) {
+            return status;
+        }
+    }
+    for (unsigned bucket = 0; bucket < QDICT_BUCKET_MAX; bucket++) {
+        QDictEntry *entry;
+
+        while ((entry = QLIST_FIRST(&dict->table[bucket]))) {
+            status = source_dict_entry_free(entry, owner);
+            if (status) {
+                return status;
+            }
+            /* Keep concrete custody if allocation retirement contends. The
+             * actual entry unlink is journaled before its physical free. */
+            QLIST_REMOVE(entry, next);
+            dict->size--;
+            dict->source_pending = entry;
+            void *payload = entry;
+
+            status = qemu_crucible_qmp_free(&payload);
+            dict->source_pending = payload;
+            if (status) {
+                return status;
+            }
+        }
+    }
+    return 0;
+}
+
+static int source_list_destroy(QList *list, QemuCrucibleQmpAllocationOwner *owner)
+{
+    int status;
+
+    if (list->source_pending) {
+        void *payload = list->source_pending;
+
+        status = qemu_crucible_qmp_free(&payload);
+        list->source_pending = payload;
+        if (status) {
+            return status;
+        }
+    }
+    while (!QTAILQ_EMPTY(&list->head)) {
+        QListEntry *entry = QTAILQ_FIRST(&list->head);
+        size_t extent;
+
+        status = source_owned_extent(entry, owner, sizeof(*entry), &extent);
+        if (status) {
+            return status;
+        }
+        if (entry->value) {
+            status = qobject_unref_source(&entry->value);
+            if (status) {
+                return status;
+            }
+        }
+        QTAILQ_REMOVE(&list->head, entry, next);
+        list->source_pending = entry;
+        void *payload = entry;
+
+        status = qemu_crucible_qmp_free(&payload);
+        list->source_pending = payload;
+        if (status) {
+            return status;
+        }
+    }
+    return 0;
+}
+
+int qobject_destroy_source(QObject **object)
+{
+    QemuCrucibleQmpAllocationOwner *owner;
+    unsigned kind;
+    void *payload;
+    int status;
+
+    if (!object || !*object) {
+        return -EINVAL;
+    }
+    status = source_object_observe(*object, &kind, &owner);
+    if (status) {
+        return status;
+    }
+    if (qatomic_read(&(*object)->base.refcnt)) {
+        return -EBUSY;
+    }
+    switch (kind) {
+    case QTYPE_QDICT:
+        status = source_dict_destroy((QDict *)*object, owner);
+        break;
+    case QTYPE_QLIST:
+        status = source_list_destroy((QList *)*object, owner);
+        break;
+    case QTYPE_QSTRING: {
+        QString *string = (QString *)*object;
+        void *buffer = (void *)string->string;
+
+        if (buffer) {
+            status = qemu_crucible_qmp_free(&buffer);
+            string->string = buffer;
+            if (!buffer) {
+                string->source_capacity = 0;
+            }
+        }
+        break;
+    }
+    case QTYPE_QNUM:
+    case QTYPE_QBOOL:
+        break;
+    default:
+        return -ESTALE;
+    }
+    if (status) {
+        return status;
+    }
+    payload = *object;
+    status = qemu_crucible_qmp_free(&payload);
+    *object = payload;
+    return status;
+}
+
+int qobject_unref_source(QObject **object)
+{
+    int status;
+
+    if (!object || !*object) {
+        return -EINVAL;
+    }
+    if (*object == QOBJECT(&qnull_)) {
+        qobject_unref(*object);
+        *object = NULL;
+        return 0;
+    }
+    status = qobject_source_current(*object);
+    if (status) {
+        return status;
+    }
+    if (qatomic_read(&(*object)->base.refcnt) &&
+        qatomic_fetch_dec(&(*object)->base.refcnt) != 1) {
+        *object = NULL;
+        return 0;
+    }
+    return qobject_destroy_source(object);
+}
+
+int qdict_del_source(QDict *dict, const char *key)
+{
+    QemuCrucibleQmpAllocationOwner *owner;
+    QDictEntry *entry;
+    unsigned bucket;
+    int status = source_container_owner(QOBJECT(dict), QTYPE_QDICT, &owner);
+
+    if (status) {
+        return status;
+    }
+    if (dict->source_pending) {
+        return -EINPROGRESS;
+    }
+    bucket = qdict_source_bucket(key);
+    status = source_dict_find(dict, owner, key, bucket, &entry);
+    if (status || !entry) {
+        return status;
+    }
+    status = source_dict_entry_free(entry, owner);
+    if (status) {
+        return status;
+    }
+    QLIST_REMOVE(entry, next);
+    dict->size--;
+    dict->source_pending = entry;
+    void *payload = entry;
+
+    status = qemu_crucible_qmp_free(&payload);
+    dict->source_pending = payload;
+    return status;
+}
+
+int qdict_clone_shallow_source(const QDict *source, QDict **out)
+{
+    int status = qobject_source_graph_current(QOBJECT(source));
+
+    if (status) {
+        return status;
+    }
+    status = qdict_new_source(out);
+    if (status) {
+        return status;
+    }
+    for (unsigned bucket = 0; bucket < QDICT_BUCKET_MAX; bucket++) {
+        QDictEntry *entry;
+
+        QLIST_FOREACH(entry, &source->table[bucket], next) {
+            QObject *reference = qobject_ref(entry->value);
+
+            status = qdict_put_obj_source(*out, entry->key, &reference);
+            if (status) {
+                /* No new allocation is needed to return this extra reference:
+                 * the genuine source container still retains the child. */
+                qobject_unref(reference);
+                return status;
+            }
+        }
+    }
+    return 0;
+}
+
+static int source_owned_extent(const void *payload,
+                                QemuCrucibleQmpAllocationOwner *expected,
+                                size_t minimum, size_t *extent)
+{
+    QemuCrucibleQmpAllocationOwner *actual;
+    int status = qemu_crucible_qmp_allocation_observe(payload, &actual, extent);
+
+    return status ? status : actual != expected || *extent < minimum ? -ESTALE : 0;
+}
+
+static int source_graph_current(const QObject *object, unsigned depth)
+{
+    QemuCrucibleQmpAllocationOwner *owner;
+    unsigned kind;
+    size_t extent;
+    int status;
+
+    if (depth > 1024) {
+        return -E2BIG;
+    }
+    if (object == QOBJECT(&qnull_)) {
+        return 0;
+    }
+    status = source_object_observe(object, &kind, &owner);
+    if (status) {
+        return status;
+    }
+    if (!qatomic_read(&object->base.refcnt)) {
+        return -ESTALE;
+    }
+    switch (kind) {
+    case QTYPE_QSTRING: {
+        const QString *string = (const QString *)object;
+
+        if (!string->source_capacity) {
+            return -ESTALE;
+        }
+        status = source_owned_extent(string->string, owner,
+                                     string->source_capacity, &extent);
+        return status ? status :
+            memchr(string->string, 0, string->source_capacity) ? 0 : -ESTALE;
+    }
+    case QTYPE_QLIST: {
+        const QList *list = (const QList *)object;
+        const QListEntry *entry = QTAILQ_FIRST(&list->head);
+        size_t visited = 0;
+
+        if (list->source_pending) {
+            return -EINPROGRESS;
+        }
+        while (entry) {
+            if (++visited > (2ULL << 20)) {
+                return -E2BIG;
+            }
+            status = source_owned_extent(entry, owner, sizeof(*entry), &extent);
+            if (!status) {
+                status = source_graph_current(entry->value, depth + 1);
+            }
+            if (status) {
+                return status;
+            }
+            entry = QTAILQ_NEXT(entry, next);
+        }
+        return 0;
+    }
+    case QTYPE_QDICT: {
+        const QDict *dict = (const QDict *)object;
+        size_t counted = 0;
+
+        if (dict->source_pending) {
+            return -EINPROGRESS;
+        }
+        for (unsigned bucket = 0; bucket < QDICT_BUCKET_MAX; bucket++) {
+            const QDictEntry *entry = QLIST_FIRST(&dict->table[bucket]);
+
+            while (entry) {
+                status = source_owned_extent(entry, owner, sizeof(*entry), &extent);
+                if (!status) {
+                    status = source_owned_extent(entry->key, owner, 1, &extent);
+                }
+                if (!status && !memchr(entry->key, 0, extent)) {
+                    status = -ESTALE;
+                }
+                if (!status) {
+                    status = source_graph_current(entry->value, depth + 1);
+                }
+                if (status) {
+                    return status;
+                }
+                if (counted == SIZE_MAX || ++counted > dict->size) {
+                    return -ESTALE;
+                }
+                entry = QLIST_NEXT(entry, next);
+            }
+        }
+        return counted == dict->size ? 0 : -ESTALE;
+    }
+    case QTYPE_QNUM:
+    case QTYPE_QBOOL:
+        return 0;
+    default:
+        return -ESTALE;
+    }
+}
+
+int qobject_source_graph_current(const QObject *object)
+{
+    return source_graph_current(object, 0);
+}
