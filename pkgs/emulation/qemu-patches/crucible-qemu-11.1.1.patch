+    int status;
+
+    if (!startup_invocation(id)) {
+        return -EPERM;
+    }
+    status = startup_active(id);
+    if (status) {
+        return status;
+    }
+    if (qatomic_load_acquire(&startup_source.fingerprint_retirement_attempted)) {
+        return -EALREADY;
+    }
+    if (!borrow || !rearm || !check || !end || !userdata ||
+        !qatomic_load_acquire(&startup_source.checkpoint_candidate_readers_registered) ||
+        !qatomic_load_acquire(&startup_source.checkpoint_pager_registered) ||
+        !qatomic_load_acquire(&startup_source.provider_registered) ||
+        !qatomic_load_acquire(&startup_source.checkpoint_finalize_registered) ||
+        !qatomic_load_acquire(&startup_source.checkpoint_candidate_cleanup_registered) ||
+        userdata != startup_source.checkpoint_pager_userdata ||
+        userdata != startup_source.provider_userdata ||
+        startup_source.ram_control_actor.attempted) {
+        return -EINVAL;
+    }
+    /* The same installer retains its runtime before this once attempt. No read
+     * or new provider acquisition occurs during callback table enrollment. */
+    qatomic_store_release(&startup_source.fingerprint_retirement_attempted, true);
+    status = qemu_rec_mutex_trylock(&plugin.lock);
+    if (status) {
+        return startup_failure(status);
+    }
+    registered = plugin.id_ht ? g_hash_table_lookup(plugin.id_ht, &id) : NULL;
+    if (registered != &startup_source.current.ctx->id ||
+        startup_source.current.ctx->resetting ||
+        startup_source.current.ctx->uninstalling ||
+        startup_source.current.ctx != startup_source.saved.ctx ||
+        startup_source.current.module != startup_source.saved.module ||
+        startup_source.current.install != startup_source.saved.install) {
+        qemu_rec_mutex_unlock(&plugin.lock);
+        return startup_failure(-EPERM);
+    }
+    qemu_rec_mutex_unlock(&plugin.lock);
+
+    status = qemu_plugin_crucible_startup_source_check_v1(id);
+    if (status) {
+        return status;
+    }
+    startup_source.fingerprint_borrow = borrow;
+    startup_source.fingerprint_rearm = rearm;
+    startup_source.fingerprint_check = check;
+    startup_source.fingerprint_end = end;
+    startup_source.fingerprint_userdata = userdata;
+    startup_source.fingerprint_resident_purpose = NULL;
+    /* The actual retained installer owns every callback. Operation authority
+     * still comes from the module's real entered-operation borrow. */
+    qatomic_store_release(&startup_source.fingerprint_retirement_registered, true);
+    return 0;
+}
+
+bool qemu_crucible_startup_source_fingerprint_retirement_idle_v1(void)
+{
+    return !startup_source.fingerprint_retirement_invoking &&
+        !startup_source.fingerprint_operation_owner &&
+        !startup_source.fingerprint_loan;
+}
+
+bool qemu_crucible_startup_source_fingerprint_retirement_current_v1(
+    qemu_plugin_id_t id, qemu_plugin_crucible_fingerprint_retirement_v1 *loan)
+{
+    QemuCrucibleCheckpointPagerBinding binding;
+
+    if (!loan || !startup_source.fingerprint_retirement_invoking ||
+        startup_source.fingerprint_loan != loan ||
+        qemu_crucible_startup_source_fingerprint_context_identity_v1(id) ||
+        !qatomic_load_acquire(&startup_source.fingerprint_retirement_registered) ||
+        !startup_source.fingerprint_userdata) {
+        return false;
+    }
+    if (startup_source.fingerprint_resident_purpose) {
+#ifdef CONFIG_LINUX
+        return resident_fingerprint_identity(startup_source.fingerprint_resident_purpose) == 0;
+#else
+        return false;
+#endif
+    }
+    return qemu_crucible_checkpoint_pager_binding_borrow(&binding) == 0 &&
+        binding.installer.ctx == startup_source.saved.ctx &&
+        binding.installer.module == startup_source.saved.module &&
+        binding.installer.install == startup_source.saved.install &&
+        binding.userdata == startup_source.fingerprint_userdata &&
+        binding.userdata == startup_source.provider_userdata;
+}
+
+int qemu_crucible_startup_source_fingerprint_context_identity_v1(qemu_plugin_id_t id)
+{
+    if (!qatomic_load_acquire(&startup_source.module_custody_published) ||
+        getpid() != startup_source.owner_process ||
+        !qatomic_load_acquire(&startup_source.custody_retained) ||
+        id != startup_source.saved.plugin_id || !startup_source.saved.ctx ||
+        !startup_source.saved.module || !startup_source.saved.install ||
+        startup_source.saved.ctx->id != id ||
+        startup_source.saved.ctx->handle != startup_source.saved.module) {
+        return -EPERM;
+    }
+    /* Lifetime identity only, including fully resident Source without a pager,
+     * provider, control controller or UFFD service. This issues no operation
+     * purpose, prepaid resource, new clock or physical capture/Stop authority. */
+    return 0;
+}
+
+int qemu_crucible_startup_source_fingerprint_return_borrow_v1(
+    qemu_plugin_id_t id, qemu_plugin_crucible_fingerprint_retirement_v1 **out)
+{
+    QemuCrucibleCheckpointPagerBinding binding;
+
+    if (!out || *out || !bql_locked() || !qemu_in_main_thread() || current_cpu ||
+        qemu_in_coroutine() || startup_source.fingerprint_retirement_invoking ||
+        qemu_crucible_startup_source_fingerprint_context_identity_v1(id) ||
+        !qatomic_load_acquire(&startup_source.fingerprint_retirement_registered) ||
+        !startup_source.fingerprint_end || !startup_source.fingerprint_userdata) {
+        return -EPERM;
+    }
+    /* Physical lookup follows the actual registered resident or checkpoint
+     * lifetime. It lends no clock, rearm or new inventory authority. */
+    if (startup_source.fingerprint_resident_purpose) {
+#ifdef CONFIG_LINUX
+        if (resident_fingerprint_identity(startup_source.fingerprint_resident_purpose)) {
+            return -EPERM;
+        }
+#else
+        return -ENOTSUP;
+#endif
+    } else if (qemu_crucible_checkpoint_pager_binding_borrow(&binding) ||
+               !qemu_crucible_checkpoint_pager_binding_current(&binding) ||
+               binding.userdata != startup_source.fingerprint_userdata ||
+               binding.userdata != startup_source.provider_userdata) {
+        return -EPERM;
+    }
+    if (!startup_source.fingerprint_operation_owner && !startup_source.fingerprint_loan) {
+        return -ENOENT;
+    }
+    if (!startup_source.fingerprint_operation_owner || !startup_source.fingerprint_loan) {
+        return -EPROTO;
+    }
+    /* Actual Source custody precedes all caller-visible status. Lookup only
+     * lends the same retained nominal identity for physical return, never a
+     * fresh operation or permission to inspect the expired Original. */
+    *out = startup_source.fingerprint_loan;
+    return 0;
+}
+
+#ifdef CONFIG_LINUX
+static int fingerprint_main_phase(
+    qemu_plugin_crucible_fingerprint_retirement_v1 *loan, uint32_t expected,
+    qemu_plugin_crucible_fingerprint_operation_v1 **out)
+{
+    qemu_plugin_crucible_fingerprint_operation_v1 *operation = NULL;
+    uint32_t phase = 0;
+    int status;
+
+    if (!qatomic_load_acquire(&startup_source.module_custody_published) ||
+        !out || *out || !loan) {
+        return -EINVAL;
+    }
+    status = qemu_crucible_ram_fingerprint_retirement_phase_current_v1(
+        startup_source.saved.plugin_id, loan, &operation, &phase);
+    if (status || phase != expected || !standing_operation_identity(operation)) {
+        return status ? status : -EPERM;
+    }
+    *out = operation;
+    return 0;
+}
+
+int qemu_plugin_crucible_fingerprint_retirement_operation_borrow_v1(
+    qemu_plugin_id_t id, qemu_plugin_crucible_fingerprint_retirement_v1 *loan,
+    qemu_plugin_crucible_fingerprint_operation_v1 **out)
+{
+    qemu_plugin_crucible_fingerprint_operation_v1 *operation = NULL;
+    int status;
+
+    if (!out || *out ||
+        !qemu_crucible_startup_source_fingerprint_retirement_current_v1(id, loan) ||
+        fingerprint_completion_identity(&startup_source.fingerprint_completion) ||
+        out != startup_source.fingerprint_completion.module_view_holder) {
+        return -EPERM;
+    }
+    status = fingerprint_main_phase(loan, 1, &operation);
+    if (status || operation != startup_source.fingerprint_source_operation ||
+        operation->module_borrowed || operation->post_recorded) {
+        return status ? status : -EPERM;
+    }
+    status = standing_operation_current(operation);
+    if (status) {
+        return status;
+    }
+    operation->module_view_holder = out;
+    operation->module_borrowed = true;
+    *out = operation;
+    return standing_operation_current(operation);
+}
+
+int qemu_plugin_crucible_fingerprint_retirement_operation_observe_v1(
+    qemu_plugin_id_t id, qemu_plugin_crucible_fingerprint_retirement_v1 *loan,
+    qemu_plugin_crucible_fingerprint_operation_v1 *operation,
+    struct qemu_plugin_crucible_fingerprint_original_v1 *out)
+{
+    qemu_plugin_crucible_fingerprint_operation_v1 *actual = NULL;
+    uint32_t phase = 0;
+    int status;
+
+    if (!out ||
+        !qemu_crucible_startup_source_fingerprint_retirement_current_v1(id, loan) ||
+        operation != startup_source.fingerprint_source_operation ||
+        !standing_operation_identity(operation)) {
+        return -EPERM;
+    }
+    status = qemu_crucible_ram_fingerprint_retirement_phase_current_v1(
+        id, loan, &actual, &phase);
+    if (status || actual != operation || (phase != 1 && phase != 2) ||
+        operation->module_view_holder !=
+            startup_source.fingerprint_completion.module_view_holder) {
+        return status ? status : -EPERM;
+    }
+    return standing_original_observe(operation, out);
+}
+#else
+int qemu_plugin_crucible_fingerprint_retirement_operation_borrow_v1(
+    qemu_plugin_id_t id, qemu_plugin_crucible_fingerprint_retirement_v1 *loan,
+    qemu_plugin_crucible_fingerprint_operation_v1 **out)
+{
+    return -ENOTSUP;
+}
+
+int qemu_plugin_crucible_fingerprint_retirement_operation_observe_v1(
+    qemu_plugin_id_t id, qemu_plugin_crucible_fingerprint_retirement_v1 *loan,
+    qemu_plugin_crucible_fingerprint_operation_v1 *operation,
+    struct qemu_plugin_crucible_fingerprint_original_v1 *out)
+{
+    return -ENOTSUP;
+}
+#endif
+
+int qemu_crucible_startup_source_fingerprint_borrow_v1(
+    qemu_plugin_crucible_fingerprint_retirement_v1 *loan)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCheckpointPagerBinding binding;
+    qemu_plugin_crucible_fingerprint_operation_v1 *operation = NULL;
+    int status;
+
+    if (!loan || !qemu_crucible_startup_source_fingerprint_retirement_idle_v1() ||
+        !qatomic_load_acquire(&startup_source.fingerprint_retirement_registered)) {
+        return -EPERM;
+    }
+    status = fingerprint_main_phase(loan, 1, &operation);
+    if (status || operation->post_recorded) {
+        return status ? status : -EPERM;
+    }
+    if (startup_source.fingerprint_resident_purpose) {
+        status = resident_fingerprint_identity(startup_source.fingerprint_resident_purpose);
+        if (!status) {
+            status = qemu_crucible_ram_fingerprint_resident_retirement_current_v1(
+                operation->plugin_id, loan, operation);
+        }
+    } else {
+        status = qemu_crucible_checkpoint_pager_binding_borrow(&binding);
+        if (!status && !qemu_crucible_checkpoint_pager_binding_current(&binding)) {
+            status = -EPERM;
+        }
+    }
+    if (!status) {
+        /* Boundary geometry/identity can consume time. Recheck this SAME
+         * already-entered Original before any module callback effect. */
+        status = standing_operation_current(operation);
+    }
+    if (status) {
+        return status;
+    }
+    /* The actual Source-entered owner exists before the dedicated FP callback;
+     * the module borrows it directly, retaining its actual runtime/page custody. */
+    startup_source.fingerprint_source_operation = operation;
+    startup_source.fingerprint_loan = loan;
+    startup_source.fingerprint_retirement_invoking = true;
+    SOURCE_CALLBACK_MASKED_INVOKE(
+        status, &startup_source.fingerprint_borrow, startup_source.fingerprint_borrow, startup_source.fingerprint_userdata,
+        startup_source.saved.plugin_id, loan,
+        &startup_source.fingerprint_operation_owner, startup_source.fingerprint_userdata);
+    status = status > 0 ? -EPROTO : status;
+    startup_source.fingerprint_retirement_invoking = false;
+    if (!status && !startup_source.fingerprint_operation_owner) {
+        status = -ENOKEY;
+    }
+    if (!startup_source.fingerprint_operation_owner) {
+        startup_source.fingerprint_loan = NULL;
+        startup_source.fingerprint_source_operation = NULL;
+    }
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_crucible_startup_source_fingerprint_post_v1(
+    qemu_plugin_crucible_fingerprint_retirement_v1 *loan)
+{
+#ifdef CONFIG_LINUX
+    qemu_plugin_crucible_fingerprint_operation_v1 *operation = NULL;
+    int status = fingerprint_main_phase(loan, 3, &operation);
+
+    if (status || startup_source.fingerprint_loan != loan ||
+        startup_source.fingerprint_retirement_invoking ||
+        operation != startup_source.fingerprint_source_operation || !operation->post_recorded) {
+        return status ? status : -EPERM;
+    }
+    /* Native has already taken the ONE independent Source Original post after
+     * observer return and real pager rearm. No callback/clock is replayed. */
+    return operation->post_status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_crucible_startup_source_fingerprint_retire_v1(
+    qemu_plugin_crucible_fingerprint_retirement_v1 *loan,
+    int *first_status, int *post_status)
+{
+#ifdef CONFIG_LINUX
+    qemu_plugin_crucible_fingerprint_operation_v1 *operation = NULL;
+    int first, check, status;
+
+    if (!loan || !first_status || !post_status ||
+        startup_source.fingerprint_loan != loan ||
+        startup_source.fingerprint_retirement_invoking ||
+        !startup_source.fingerprint_operation_owner) {
+        return -EPERM;
+    }
+    status = fingerprint_main_phase(loan, 2, &operation);
+    if (status || operation != startup_source.fingerprint_source_operation ||
+        operation->post_recorded) {
+        return status ? status : -EPERM;
+    }
+    /* Both callbacks borrow the SAME still-entered Source Original. Native
+     * locks and module State/Slot guards are outside these callback cuts. */
+    startup_source.fingerprint_retirement_invoking = true;
+    SOURCE_CALLBACK_MASKED_INVOKE(
+        first, &startup_source.fingerprint_rearm, startup_source.fingerprint_rearm, startup_source.fingerprint_userdata,
+        startup_source.saved.plugin_id, loan,
+        startup_source.fingerprint_operation_owner, startup_source.fingerprint_userdata);
+    first = first > 0 ? -EPROTO : first;
+    SOURCE_CALLBACK_MASKED_INVOKE(
+        check, &startup_source.fingerprint_check, startup_source.fingerprint_check, startup_source.fingerprint_userdata,
+        startup_source.saved.plugin_id, loan,
+        startup_source.fingerprint_operation_owner, startup_source.fingerprint_userdata);
+    check = check > 0 ? -EPROTO : check;
+    startup_source.fingerprint_retirement_invoking = false;
+    if (!first) {
+        first = check;
+    }
+    *first_status = first;
+    *post_status = 0;
+    /* Post is genuinely not taken yet. Only phase3 exposes its independent
+     * recorded result, before native versions/FP-only acknowledgment. */
+    return first;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_crucible_startup_source_fingerprint_retirement_end_v1(
+    qemu_plugin_crucible_fingerprint_retirement_v1 *loan)
+{
+#ifdef CONFIG_LINUX
+    qemu_plugin_crucible_fingerprint_operation_v1 *operation = NULL;
+    int status;
+
+    if (!loan || startup_source.fingerprint_loan != loan) {
+        return qemu_crucible_startup_source_fingerprint_retirement_idle_v1() ? 0 : -EPERM;
+    }
+    status = fingerprint_main_phase(loan, 4, &operation);
+    if (status || operation != startup_source.fingerprint_source_operation ||
+        !startup_source.fingerprint_operation_owner ||
+        startup_source.fingerprint_retirement_invoking) {
+        return status ? status : -EPERM;
+    }
+    startup_source.fingerprint_retirement_invoking = true;
+    SOURCE_CALLBACK_MASKED_INVOKE(
+        status, &startup_source.fingerprint_end, startup_source.fingerprint_end, startup_source.fingerprint_userdata,
+        startup_source.saved.plugin_id, loan, &startup_source.fingerprint_operation_owner,
+        startup_source.fingerprint_userdata);
+    status = status > 0 ? -EPROTO : status;
+    startup_source.fingerprint_retirement_invoking = false;
+    /* Record physical consumption independently of semantic/end failure. */
+    if (!startup_source.fingerprint_operation_owner) {
+        startup_source.fingerprint_loan = NULL;
+        startup_source.fingerprint_source_operation = NULL;
+    } else if (!status) {
+        status = -EBUSY;
+    }
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+/* Registered fields and saved binding are immutable after release publication.
+ * This is a lifetime borrow, never a check of a completed Setup operation.
+ */
+int qemu_crucible_checkpoint_pager_binding_borrow(
+    QemuCrucibleCheckpointPagerBinding *binding)
+{
+    QemuCrucibleCheckpointPagerBinding retained;
+
+    if (!binding) {
+        return -EINVAL;
+    }
+    if (!qatomic_load_acquire(&startup_source.module_custody_published) ||
+        !qatomic_load_acquire(&startup_source.checkpoint_pager_registered) ||
+        getpid() != startup_source.owner_process ||
+        !qatomic_load_acquire(&startup_source.custody_retained)) {
+        return -EPERM;
+    }
+    retained = (QemuCrucibleCheckpointPagerBinding) {
+        .installer = startup_source.saved,
+        .process_id = startup_source.owner_process,
+        .prepare = startup_source.checkpoint_pager_prepare,
+        .check = startup_source.checkpoint_pager_check,
+        .release = startup_source.checkpoint_pager_release,
+        .provider_acquire = startup_source.provider_acquire,
+        .provider_check = startup_source.provider_check,
+        .provider_end = startup_source.provider_end,
+        .finalize = startup_source.checkpoint_finalize,
+        .candidate_read = qatomic_load_acquire(
+            &startup_source.checkpoint_candidate_readers_registered) ?
+            startup_source.checkpoint_candidate_read : NULL,
+        .candidate_observe = qatomic_load_acquire(
+            &startup_source.checkpoint_candidate_readers_registered) ?
+            startup_source.checkpoint_candidate_observe : NULL,
+        .candidate_cleanup = qatomic_load_acquire(
+            &startup_source.checkpoint_candidate_cleanup_registered) ?
+            startup_source.checkpoint_candidate_cleanup : NULL,
+        .userdata = startup_source.checkpoint_pager_userdata,
+    };
+    *binding = retained;
+    return 0;
+}
+
+bool qemu_crucible_checkpoint_pager_binding_current(
+    const QemuCrucibleCheckpointPagerBinding *binding)
+{
+    QemuCrucibleCheckpointPagerBinding retained;
+
+    if (!binding || getpid() != binding->process_id ||
+        qemu_crucible_checkpoint_pager_binding_borrow(&retained) != 0) {
+        return false;
+    }
+    return binding->installer.ctx == retained.installer.ctx &&
+        binding->installer.module == retained.installer.module &&
+        binding->installer.install == retained.installer.install &&
+        binding->installer.plugin_id == retained.installer.plugin_id &&
+        binding->prepare == retained.prepare &&
+        binding->check == retained.check &&
+        binding->release == retained.release &&
+        binding->provider_acquire == retained.provider_acquire &&
+        binding->provider_check == retained.provider_check &&
+        binding->provider_end == retained.provider_end &&
+        binding->finalize == retained.finalize &&
+        binding->candidate_read == retained.candidate_read &&
+        binding->candidate_observe == retained.candidate_observe &&
+        binding->candidate_cleanup == retained.candidate_cleanup &&
+        binding->userdata == retained.userdata;
+}
