+
+static int64_t observed_ps;
+
+#define TYPE_TEST_MOS6522 "test-mos6522"
+
+typedef struct TestExactTimerState {
+    QEMUTimer *timer;
+} TestExactTimerState;
+
+static const VMStateDescription vmstate_test_exact_timer = {
+    .name = "test-exact-timer",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_TIMER_NS_PHASE_PTR(timer, TestExactTimerState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static const VMStateDescription vmstate_test_timer_projection = {
+    .name = "test-timer-projection",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_TIMER_NS_PROJECTION_PTR(timer, TestExactTimerState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static const TypeInfo test_sysbus_device_type_info = {
+    .name = TYPE_SYS_BUS_DEVICE,
+    .parent = TYPE_DEVICE,
+    .instance_size = sizeof(SysBusDevice),
+    .instance_align = __alignof__(SysBusDevice),
+    .class_size = sizeof(SysBusDeviceClass),
+    .abstract = true,
+};
+
+static const TypeInfo test_mos6522_type_info = {
+    .name = TYPE_TEST_MOS6522,
+    .parent = TYPE_MOS6522,
+};
+
+/* Sim snapshots require the MOS6522 picosecond phase subsection. */
+bool icount_crucible_sim_mode(void)
+{
+    return true;
+}
+
+void memory_region_init_io(MemoryRegion *mr, Object *owner,
+                           const MemoryRegionOps *ops, void *opaque,
+                           const char *name, uint64_t size)
+{
+}
+
