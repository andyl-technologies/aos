+static int preexec_setup_status_capabilities(const char *text, size_t bytes)
+{
+    const char *names[4] = { "CapEff:", "CapPrm:", "CapInh:", "CapAmb:" };
+    unsigned found = 0;
+
+    for (size_t cursor = 0; cursor < bytes;) {
+        size_t end = cursor;
+
+        while (end < bytes && text[end] != '\n') {
+            end++;
+        }
+        for (size_t index = 0; index < 4; index++) {
+            size_t value = cursor + 7;
+
+            if (end - cursor < 7 || preexec_setup_compare(text + cursor,
+                                                           names[index], 7)) {
+                continue;
+            }
+            if (found & (1U << index)) {
+                return -EPROTO;
+            }
+            while (value < end && (text[value] == ' ' || text[value] == '\t')) {
+                value++;
+            }
+            if (end - value != 16) {
+                return -EPROTO;
+            }
+            for (size_t digit = value; digit < end; digit++) {
+                if (text[digit] != '0') {
+                    return -EPERM;
+                }
+            }
+            found |= 1U << index;
+        }
+        cursor = end + 1;
+    }
+    return found == 15 ? 0 : -EPROTO;
+}
