+    int status;
+
+    if (!qatomic_load_acquire(&startup_source.module_custody_published)) {
+        return -EPERM;
+    }
+    status = qemu_crucible_ram_control_actor_current(actor, startup_source.saved.plugin_id);
+
+    if (status || !generation || !thread_id || !actor->thread_binding) {
+        return status ? status : -EPERM;
+    }
+    status = qemu_crucible_ram_control_actor_contract_current(actor);
+    if (!status) {
+        *generation = startup_source.process_purpose_record.process_generation;
+        *thread_id = qemu_get_thread_id();
+    }
+    return status;
+}
