+static int control_stop_identity(QemuCrucibleSourceControlStopIntent *intent)
+{
+    if (intent != &control_stop_storage.stop || !intent->held ||
+        !intent->invocation || intent->process != getpid() ||
+        !intent->invocation_serial ||
+        intent->invocation_serial != intent->invocation->serial ||
+        !intent->invocation->retained ||
+        !qemu_thread_is_self(&intent->admission_thread)) {
+        return -ENOKEY;
+    }
+    return qemu_crucible_source_control_invocation_current_v1(
+        intent->invocation, false);
+}
