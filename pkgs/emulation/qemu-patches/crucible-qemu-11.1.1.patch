+static uint64_t crucible_hot_fork_template_acknowledged_proofs(
+    const CrucibleHotForkPluginBarrierState *plugin_barrier,
+    const CrucibleHotForkRcuBarrierState *rcu_barrier,
+    const CrucibleHotForkAsyncWorkerBarrierState *async_worker_barrier,
+    const CrucibleHotForkBlockBarrierState *block_barrier)
+{
+    uint64_t acknowledged = crucible_hot_fork_acknowledged_proofs();
+    bool plugin_ring_proof = crucible_hot_fork_template_active &&
+        plugin_barrier->quiescent &&
+        crucible_hot_fork_private_ring_stage.staged &&
+        crucible_hot_fork_private_ring_stage.shrink_sealed &&
+        crucible_hot_fork_diagnostic_stage.staged &&
+        crucible_hot_fork_qmp_stage.staged &&
+        crucible_hot_fork_console_stage.staged &&
+        crucible_hot_fork_plugin_endpoint_stage.staged &&
+        crucible_hot_fork_private_ring_stage.template_generation ==
+            crucible_hot_fork_template_generation &&
+        crucible_hot_fork_diagnostic_stage.template_generation ==
+            crucible_hot_fork_template_generation &&
+        crucible_hot_fork_qmp_stage.template_generation ==
+            crucible_hot_fork_template_generation &&
+        crucible_hot_fork_console_stage.template_generation ==
+            crucible_hot_fork_template_generation &&
+        crucible_hot_fork_plugin_endpoint_stage.template_generation ==
+            crucible_hot_fork_template_generation &&
+        crucible_hot_fork_plugin_endpoint_stage.private_ring_generation ==
+            crucible_hot_fork_private_ring_stage.generation &&
+        crucible_hot_fork_plugin_worker_disposition_matches(plugin_barrier);
+
+    if (crucible_hot_fork_template_active && rcu_barrier->quiescent) {
+        acknowledged |= CRUCIBLE_HOT_FORK_PROOF_RCU;
+    }
+    if (crucible_hot_fork_template_active && async_worker_barrier->quiescent &&
+        qemu_aio_hot_fork_thread_pools_empty()) {
+        acknowledged |= CRUCIBLE_HOT_FORK_PROOF_ASYNC_WORKERS;
+    }
+    if (crucible_hot_fork_template_active &&
+        block_barrier->snapshot_complete && block_barrier->snapshot_sources->frozen) {
+        acknowledged |= CRUCIBLE_HOT_FORK_PROOF_BLOCK_SNAPSHOT;
+    }
+    if (plugin_ring_proof) {
+        acknowledged |= CRUCIBLE_HOT_FORK_PROOF_PLUGIN_RINGS;
+    }
+    return acknowledged;
+}
+
+static CrucibleHotForkTemplateState *
+crucible_hot_fork_template_report(
+    CrucibleHotForkTemplateOutcome outcome,
+    CrucibleHotForkPluginBarrierState *plugin_barrier,
+    CrucibleHotForkRcuBarrierState *rcu_barrier,
+    CrucibleHotForkAsyncWorkerBarrierState *async_worker_barrier,
+    CrucibleHotForkBlockBarrierState *block_barrier)
+{
+    CrucibleHotForkTemplateState *report =
+        g_new0(CrucibleHotForkTemplateState, 1);
+    uint64_t acknowledged = crucible_hot_fork_template_acknowledged_proofs(
+        plugin_barrier, rcu_barrier, async_worker_barrier, block_barrier);
+
+    report->schema_version = 27;
+    report->generation = crucible_hot_fork_template_generation;
+    report->outcome = outcome;
+    report->transaction_active = crucible_hot_fork_template_active;
+    report->required_proofs = CRUCIBLE_HOT_FORK_TEMPLATE_REQUIRED_PROOFS;
+    report->acknowledged_proofs = acknowledged;
+    report->missing_proofs =
+        CRUCIBLE_HOT_FORK_TEMPLATE_REQUIRED_PROOFS & ~acknowledged;
+    report->plugin_barrier = plugin_barrier;
+    report->rcu_barrier = rcu_barrier;
+    report->async_worker_barrier = async_worker_barrier;
+    report->block_barrier = block_barrier;
+    report->resource_stage =
+        crucible_hot_fork_template_resource_stage_report(plugin_barrier);
+    report->rollback_complete = !report->transaction_active &&
+        !plugin_barrier->held && !rcu_barrier->held &&
+        !async_worker_barrier->held && !block_barrier->held &&
+        !block_barrier->snapshot_bound;
+    report->ready = outcome == CRUCIBLE_HOT_FORK_TEMPLATE_OUTCOME_PREPARED &&
+        report->transaction_active && plugin_barrier->quiescent &&
+        rcu_barrier->quiescent && async_worker_barrier->quiescent &&
+        block_barrier->quiescent && block_barrier->snapshot_complete &&
+        report->missing_proofs == 0;
+    return report;
+}
