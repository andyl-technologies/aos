+static bool input_source_policy_reject(QObjectInputVisitor *qiv,
+                                        uint64_t features, const char *kind,
+                                        const char *name, Error **errp)
+{
+    bool deprecated = features & (1u << QAPI_DEPRECATED);
+    bool unstable = features & (1u << QAPI_UNSTABLE);
+    CompatPolicy *policy = &qiv->visitor.compat_policy;
+    CompatPolicyInput choice = deprecated ? policy->deprecated_input :
+                                           COMPAT_POLICY_INPUT_ACCEPT;
+    const char *adjective = "Deprecated";
+
+    if (!input_source_current(qiv)) {
+        return true;
+    }
+    if (!deprecated || choice == COMPAT_POLICY_INPUT_ACCEPT) {
+        choice = unstable ? policy->unstable_input : COMPAT_POLICY_INPUT_ACCEPT;
+        adjective = "Unstable";
+    }
+    if (choice == COMPAT_POLICY_INPUT_ACCEPT) {
+        return false;
+    }
+    if (choice != COMPAT_POLICY_INPUT_REJECT) {
+        /* Preserve the explicitly configured compatibility crash policy. */
+        abort();
+    }
+    qiv_error(qiv, errp, "%s %s %s disabled by policy", adjective, kind, name);
+    return true;
+}
