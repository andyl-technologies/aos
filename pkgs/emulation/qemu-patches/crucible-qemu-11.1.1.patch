diff --git a/plugins/crucible-ram-owner-diagnostic.c b/plugins/crucible-ram-owner-diagnostic.c
new file mode 100644
index 0000000000000000000000000000000000000000..9d23e88c5c5432f96e6704a88e802a3aeb90e717
--- /dev/null
+++ b/plugins/crucible-ram-owner-diagnostic.c
@@ -0,0 +1,38 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Owns bounded formatting and the single write of RAM ownership evidence. */
+#include "qemu/osdep.h"
+#include "qemu/crucible-paged-ram.h"
+#include "crucible-ram-owner-diagnostic.h"
+
+void qemu_crucible_ram_owner_diagnostic_report(CrucibleRamOwnerDiagnostic *result)
+{
+    char record[256];
+    int length;
+    ssize_t written;
+
+    /* A failed owner close may still retain registered QEMU locks. Reporting
+     * must not enter a monitor or acquire stderr's FILE lock under that hold. */
+    length = snprintf(record, sizeof(record),
+                      "crucible RAM owner diagnostic raw=%" PRIu64
+                      " vmstop=%" PRIu64 " topology=%" PRIu64
+                      " token=%" PRIu64 " first=%d proc_close=%d release=%d"
+                      " capture_generation=%" PRIu64 " capture=%d attempted=%u\n",
+                      result->raw_icount, result->vmstop_generation,
+                      result->topology_generation, result->token,
+                      result->first_status, result->proc_close_status, result->release_status,
+                      result->capture_close.generation, result->capture_close.status,
+                      result->capture_close.attempted);
+    if (length < 0 || (size_t)length >= sizeof(record)) {
+        result->report_status = length < 0 ? -EIO : -EOVERFLOW;
+    } else {
+        written = write(STDERR_FILENO, record, length);
+        if (written < 0) {
+            result->report_status = -errno;
+        } else if (written != length) {
+            result->report_status = -EIO;
+        }
+    }
+    if (result->report_status) {
+        qemu_crucible_ram_diagnostic_fail(result->report_status);
+    }
+}
diff --git a/plugins/crucible-ram-owner-diagnostic.h b/plugins/crucible-ram-owner-diagnostic.h
new file mode 100644
index 0000000000000000000000000000000000000000..533d4b79f2b2d900fa6d96609c5d6ba1dc8b8327
--- /dev/null
+++ b/plugins/crucible-ram-owner-diagnostic.h
@@ -0,0 +1,23 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/* Private retained evidence for the paused RAM ownership diagnostic. */
+#ifndef CRUCIBLE_RAM_OWNER_DIAGNOSTIC_H
+#define CRUCIBLE_RAM_OWNER_DIAGNOSTIC_H
+
+typedef struct CrucibleRamOwnerDiagnostic {
+    uint64_t raw_icount;
+    uint64_t vmstop_generation;
+    uint64_t topology_generation;
+    uint64_t token;
+    struct qemu_plugin_crucible_ram_capture_close_v2 capture_close;
+    int first_status;
+    int proc_close_status;
+    int release_status;
+    struct qemu_plugin_crucible_ram_physical_end_v2 release;
+    int report_status;
+    bool attempted;
+} CrucibleRamOwnerDiagnostic;
+
+/* Reports after owner close without entering a monitor or stdio stream. */
+void qemu_crucible_ram_owner_diagnostic_report(CrucibleRamOwnerDiagnostic *result);
+
+#endif /* CRUCIBLE_RAM_OWNER_DIAGNOSTIC_H */
diff --git a/plugins/crucible-ram-record.inc.h b/plugins/crucible-ram-record.inc.h
new file mode 100644
index 0000000000000000000000000000000000000000..06c7717a72f48d51622e9c7da2c2fc984b07b99f
--- /dev/null
+++ b/plugins/crucible-ram-record.inc.h
@@ -0,0 +1,419 @@
+/*
+ * Genuine registered per-record original lease for the retained RAM actor.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Included once from crucible-ram-control.inc.h after native failure helpers.
+ * No callback runs under actor/service/registry locks. This is process-private
+ * Source custody, never wire data or an externally nominated operation owner.
+ */
+
+int qemu_plugin_crucible_register_ram_control_record_v1(
+    qemu_plugin_id_t id, qemu_plugin_crucible_control_purpose_v2 *control,
+    qemu_plugin_crucible_runtime_purpose_v2 *runtime,
+    qemu_plugin_crucible_ram_record_acquire_cb_t acquire,
+    qemu_plugin_crucible_ram_record_query_cb_t query,
+    qemu_plugin_crucible_ram_record_end_cb_t end,
+    qemu_plugin_crucible_ram_record_release_cb_t release, void *userdata)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleRamRecordBinding *binding = &startup_source.record_binding;
+    int status;
+
+    if (qemu_crucible_resident_service_birth_blocked_v1()) {
+        return -EBUSY;
+    }
+    if (!startup_invocation(id)) {
+        return -EPERM;
+    }
+    status = qemu_plugin_crucible_startup_control_check_v2(id, control);
+    if (!status) {
+        status = startup_runtime_admission(id, runtime);
+    }
+    if (status) {
+        return status;
+    }
+    if (binding->attempted) {
+        return -EALREADY;
+    }
+    if (!acquire || !query || !end || !release || !userdata ||
+        userdata != startup_source.checkpoint_pager_userdata ||
+        userdata != startup_source.provider_userdata ||
+        !qatomic_load_acquire(&startup_source.checkpoint_pager_registered) ||
+        !qatomic_load_acquire(&startup_source.provider_registered) ||
+        startup_source.ram_control_actor.attempted) {
+        return -EINVAL;
+    }
+    binding->attempted = true;
+    binding->control = control;
+    binding->runtime = runtime;
+    binding->installer = startup_source.saved;
+    binding->acquire = acquire;
+    binding->query = query;
+    binding->end = end;
+    binding->release = release;
+    binding->userdata = userdata;
+    binding->process = getpid();
+    /* Publication retains genuine registrar/module/purpose custody and no
+     * controller pointer or callback execution. The module preserves its real
+     * separately admitted controller registration until process retirement. */
+    status = qemu_plugin_crucible_startup_source_check_v1(id);
+    if (status) {
+        return status;
+    }
+    qatomic_store_release(&binding->registered, true);
+    return 0;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+#ifdef CONFIG_LINUX
+static int ram_control_record_binding_current(QemuCrucibleRamControlActor *actor)
+{
+    QemuCrucibleRamRecordBinding *binding = &startup_source.record_binding;
+
+    if (!qatomic_load_acquire(&startup_source.module_custody_published) ||
+        actor != &startup_source.ram_control_actor || actor->process != getpid() ||
+        !qatomic_load_acquire(&binding->registered) || binding->process != getpid() ||
+        binding->control != &startup_source.control_purpose ||
+        binding->runtime != &startup_source.runtime_purpose ||
+        actor->purpose != binding->runtime || !binding->control->held ||
+        !binding->runtime->charge.held ||
+        binding->installer.ctx != startup_source.saved.ctx ||
+        binding->installer.module != startup_source.saved.module ||
+        binding->installer.install != startup_source.saved.install ||
+        binding->installer.plugin_id != startup_source.saved.plugin_id ||
+        binding->userdata != actor->userdata ||
+        binding->userdata != startup_source.checkpoint_pager_userdata ||
+        binding->userdata != startup_source.provider_userdata ||
+        !qatomic_load_acquire(&startup_source.custody_retained) ||
+        !qatomic_load_acquire(&startup_source.checkpoint_pager_registered) ||
+        !qatomic_load_acquire(&startup_source.provider_registered)) {
+        return -ENOKEY;
+    }
+    return 0;
+}
+
+static int ram_control_record_unlock(QemuCrucibleRamControlActor *actor, int status)
+{
+    int unlock = pthread_mutex_unlock(&actor->dispatch_mutex);
+
+    if (unlock) {
+        actor->receipt.uncertain = true;
+        ram_control_failure(actor, -unlock, true);
+        return status ? status : -unlock;
+    }
+    return status;
+}
+
+static int ram_control_record_acquire(QemuCrucibleRamControlActor *actor,
+                                      qemu_plugin_id_t id)
+{
+    QemuCrucibleRamControlReceive *receipt = &actor->receipt;
+    QemuCrucibleRamRecordLease *lease = &receipt->record;
+    QemuCrucibleRamRecordBinding *binding = &startup_source.record_binding;
+    void *owner = NULL;
+    int status = qemu_crucible_ram_control_actor_current(actor, id);
+    int result;
+    int post;
+
+    if (status) {
+        return status;
+    }
+    status = pthread_mutex_lock(&actor->dispatch_mutex);
+    if (status) {
+        return ram_control_failure(actor, -status, true);
+    }
+    status = ram_control_record_binding_current(actor);
+    if (status || !receipt->active || receipt->uncertain || receipt->moved ||
+        !actor->record_in_flight || receipt->frame_bytes != 1 ||
+        lease->acquire_attempted || lease->held || lease->callback_active ||
+        actor->record_serial == UINT64_MAX) {
+        return ram_control_record_unlock(actor, status ? status : -EPERM);
+    }
+    status = qemu_crucible_ram_control_actor_contract_current(actor);
+    if (status) {
+        receipt->uncertain = true;
+        ram_control_failure(actor, status, false);
+        return ram_control_record_unlock(actor, status);
+    }
+    lease->serial = ++actor->record_serial;
+    lease->acquire_attempted = true;
+    lease->callback_active = true;
+    status = ram_control_record_unlock(actor, 0);
+    if (status) {
+        return status;
+    }
+    SOURCE_CALLBACK_MASKED_INVOKE(
+        result, &binding->acquire, binding->acquire, binding->userdata,
+        id, actor, receipt, binding->userdata, &owner);
+    qatomic_set(&lease->owner, owner);
+    qatomic_set(&lease->acquire_result, result);
+    status = pthread_mutex_lock(&actor->dispatch_mutex);
+    if (status) {
+        /* Callback may already have acquired actual custody. Native keeps its
+         * callback-active exclusion and cannot guess ownership or invoke again. */
+        return ram_control_failure(actor, -status, true);
+    }
+    lease->owner = owner;
+    lease->acquire_result = result;
+    lease->held = owner != NULL;
+    lease->callback_active = false;
+    post = ram_control_record_binding_current(actor);
+    if (!post) {
+        post = qemu_crucible_ram_control_actor_contract_current(actor);
+    }
+    if (result || !owner || post) {
+        receipt->uncertain = true;
+        status = ram_control_failure(actor,
+            result < 0 ? result : result > 0 ? -EPROTO : !owner ? -ENOKEY : post,
+            false);
+        if (post) {
+            ram_control_failure(actor, post, true);
+        }
+    } else {
+        /* This nominal lease is issued only from actual native first-byte
+         * callback acquisition, never a setter or caller-supplied owner. */
+        lease->acquired = true;
+        status = 0;
+    }
+    return ram_control_record_unlock(actor, status);
+}
+
+static int ram_control_record_query(QemuCrucibleRamControlActor *actor,
+                                    qemu_plugin_id_t id, uint64_t *duration_ns)
+{
+    QemuCrucibleRamControlReceive *receipt = &actor->receipt;
+    QemuCrucibleRamRecordLease *lease = &receipt->record;
+    QemuCrucibleRamRecordBinding *binding = &startup_source.record_binding;
+    uint64_t slice = 0;
+    int status = qemu_crucible_ram_control_actor_current(actor, id);
+    int result;
+    int post;
+
+    if (status || !duration_ns) {
+        return status ? status : -EINVAL;
+    }
+    status = pthread_mutex_lock(&actor->dispatch_mutex);
+    if (status) {
+        return ram_control_failure(actor, -status, true);
+    }
+    status = ram_control_record_binding_current(actor);
+    if (status || !receipt->active || !lease->held || !lease->acquired ||
+        !lease->owner || !lease->serial || lease->end_attempted ||
+        lease->callback_active || lease->release_attempted) {
+        return ram_control_record_unlock(actor, status ? status : -ENOKEY);
+    }
+    lease->callback_active = true;
+    status = ram_control_record_unlock(actor, 0);
+    if (status) {
+        return status;
+    }
+    /* This is the same acquired actual operation slot on every pre/post cut.
+     * The callback checks its own original total/progress/poll journal. */
+    SOURCE_CALLBACK_MASKED_INVOKE(
+        result, &binding->query, binding->query, binding->userdata,
+        id, actor, receipt, lease->owner,
+        binding->userdata, &slice);
+    status = pthread_mutex_lock(&actor->dispatch_mutex);
+    if (status) {
+        return ram_control_failure(actor, -status, true);
+    }
+    lease->query_result = result;
+    lease->callback_active = false;
+    post = ram_control_record_binding_current(actor);
+    if (!post) {
+        post = qemu_crucible_ram_control_actor_contract_current(actor);
+    }
+    if (result || !slice || post) {
+        receipt->uncertain = true;
+        status = ram_control_failure(actor,
+            result < 0 ? result : result > 0 ? -EPROTO : !slice ? -ETIMEDOUT : post,
+            false);
+        if (post) {
+            ram_control_failure(actor, post, true);
+        }
+    } else {
+        *duration_ns = slice;
+        status = 0;
+    }
+    return ram_control_record_unlock(actor, status);
+}
+
+static int ram_control_record_end(QemuCrucibleRamControlActor *actor,
+                                  qemu_plugin_id_t id,
+                                  QemuCrucibleRamControlReceive *receipt,
+                                  bool moved)
+{
+    QemuCrucibleRamRecordLease *lease = &actor->receipt.record;
+    QemuCrucibleRamRecordBinding *binding = &startup_source.record_binding;
+    struct qemu_plugin_crucible_ram_record_end_status_v1 terminal = {
+        .terminal_journal = QEMU_PLUGIN_CRUCIBLE_RAM_RECORD_TERMINAL_UNKNOWN,
+        .completion_result = -EINPROGRESS,
+    };
+    uint64_t slice;
+    int result;
+    int status;
+    int post;
+
+    if (receipt != &actor->receipt) {
+        return -EPERM;
+    }
+    if (lease->end_attempted) {
+        return -EALREADY;
+    }
+    status = ram_control_record_query(actor, id, &slice);
+    if (status) {
+        return status;
+    }
+    status = pthread_mutex_lock(&actor->dispatch_mutex);
+    if (status) {
+        return ram_control_failure(actor, -status, true);
+    }
+    status = ram_control_record_binding_current(actor);
+    if (status || receipt != &actor->receipt || !receipt->active ||
+        receipt->uncertain || receipt->moved != moved ||
+        !actor->record_in_flight || !receipt->frame_extent ||
+        receipt->frame_bytes != receipt->frame_extent || !lease->held ||
+        !lease->acquired || !lease->owner || lease->end_attempted ||
+        lease->callback_active || lease->release_attempted ||
+        actor->first_status || actor->post_status) {
+        return ram_control_record_unlock(actor, status ? status : -EPERM);
+    }
+    for (size_t index = 0; !moved && index < receipt->alias_count; index++) {
+        if (receipt->aliases[index] < 0 || receipt->close_attempted[index]) {
+            return ram_control_record_unlock(actor, -EINPROGRESS);
+        }
+    }
+    /* Real callback checks actual synchronous reply/cursor/operation return.
+     * Native checks physical returnability first, not a success scalar alone. */
+    lease->end_attempted = true;
+    lease->callback_active = true;
+    status = ram_control_record_unlock(actor, 0);
+    if (status) {
+        return status;
+    }
+    SOURCE_CALLBACK_MASKED_INVOKE(
+        result, &binding->end, binding->end, binding->userdata,
+        id, actor, receipt, lease->owner,
+        binding->userdata, &terminal);
+    qatomic_set(&lease->end_result, result);
+    qatomic_set(&lease->terminal_journal, terminal.terminal_journal);
+    qatomic_set(&lease->completion_result, terminal.completion_result);
+    qatomic_store_release(&lease->end_returned, true);
+    status = pthread_mutex_lock(&actor->dispatch_mutex);
+    if (status) {
+        return ram_control_failure(actor, -status, true);
+    }
+    lease->end_result = result;
+    lease->end_returned = true;
+    lease->terminal_journal = terminal.terminal_journal;
+    lease->completion_result = terminal.completion_result;
+    lease->callback_active = false;
+    /* No operation query/complete is retried after end, including Completed
+     * after Err. Physical retained-purpose post remains independent. */
+    post = ram_control_record_binding_current(actor);
+    if (!post) {
+        post = qemu_crucible_ram_control_actor_contract_current(actor);
+    }
+    if (result > 0 || terminal.terminal_journal !=
+                       QEMU_PLUGIN_CRUCIBLE_RAM_RECORD_TERMINAL_COMPLETED ||
+        terminal.completion_result > 0 || post) {
+        receipt->uncertain = true;
+        status = ram_control_failure(actor,
+            result < 0 ? result : result > 0 ? -EPROTO :
+            terminal.completion_result < 0 ? terminal.completion_result :
+            terminal.completion_result > 0 ? -EPROTO : post ? post : -EINPROGRESS,
+            false);
+        if (post) {
+            ram_control_failure(actor, post, true);
+        }
+    } else {
+        /* Genuine actual Completed is known even after semantic failure. Keep
+         * both raw causes, poison further stream dispatch, and permit only the
+         * independently checked physical bank return before owner release. */
+        if (result < 0) {
+            ram_control_failure(actor, result, false);
+        }
+        if (terminal.completion_result < 0) {
+            ram_control_failure(actor, terminal.completion_result, false);
+        }
+        status = 0;
+    }
+    return ram_control_record_unlock(actor, status);
+}
+
+/* Called only after the actual worker dispose or authentic request bank-return
+ * wrapper confirms native physical return. The latter already proves genuine
+ * Main/request/pause/alias custody; no public caller supplies this confirmation. */
+static int ram_control_record_release(QemuCrucibleRamControlActor *actor)
+{
+    QemuCrucibleRamControlReceive *receipt = &actor->receipt;
+    QemuCrucibleRamRecordLease *lease = &receipt->record;
+    QemuCrucibleRamRecordBinding *binding = &startup_source.record_binding;
+    int status = pthread_mutex_lock(&actor->dispatch_mutex);
+    int result;
+    int post;
+
+    if (status) {
+        return ram_control_failure(actor, -status, true);
+    }
+    status = ram_control_record_binding_current(actor);
+    if (status || !lease->held || !lease->acquired || !lease->owner ||
+        !lease->end_attempted || !lease->end_returned || lease->end_result > 0 ||
+        lease->terminal_journal !=
+            QEMU_PLUGIN_CRUCIBLE_RAM_RECORD_TERMINAL_COMPLETED ||
+        lease->completion_result > 0 || !lease->physical_bank_returned ||
+        lease->callback_active || lease->release_attempted || receipt->active ||
+        receipt->moved || receipt->uncertain || actor->record_in_flight ||
+        receipt->frame_bytes || receipt->frame_extent || receipt->alias_count) {
+        return ram_control_record_unlock(actor, status ? status : -EINPROGRESS);
+    }
+    lease->release_attempted = true;
+    lease->callback_active = true;
+    status = ram_control_record_unlock(actor, 0);
+    if (status) {
+        return status;
+    }
+    SOURCE_CALLBACK_MASKED_INVOKE(
+        result, &binding->release, binding->release, binding->userdata,
+        startup_source.saved.plugin_id, actor, receipt,
+        lease->owner, binding->userdata);
+    qatomic_set(&lease->release_result, result);
+    if (!result) {
+        /* Actual release0 is irreversible even if reacquiring the mutex fails.
+         * callback_active still excludes all proof/reuse until post settles. */
+        qatomic_set(&lease->owner, NULL);
+        qatomic_set(&lease->held, false);
+        qatomic_store_release(&lease->released, true);
+    }
+    status = pthread_mutex_lock(&actor->dispatch_mutex);
+    if (status) {
+        return ram_control_failure(actor, -status, true);
+    }
+    lease->release_result = result;
+    lease->callback_active = false;
+    if (!result) {
+        lease->released = true;
+        lease->held = false;
+        lease->owner = NULL;
+        pthread_cond_broadcast(&actor->dispatch_condition);
+    }
+    post = ram_control_record_binding_current(actor);
+    if (!post) {
+        post = qemu_crucible_ram_control_actor_contract_current(actor);
+    }
+    if (result || post) {
+        receipt->uncertain = true;
+        status = ram_control_failure(actor,
+            result < 0 ? result : result > 0 ? -EPROTO : post, false);
+        if (post) {
+            ram_control_failure(actor, post, true);
+        }
+    } else {
+        status = 0;
+    }
+    return ram_control_record_unlock(actor, status);
+}
+#endif
diff --git a/plugins/crucible-register-read.inc.h b/plugins/crucible-register-read.inc.h
new file mode 100644
index 0000000000000000000000000000000000000000..a3dc636d14231d724dab3dfe051abefb7507a305
--- /dev/null
+++ b/plugins/crucible-register-read.inc.h
@@ -0,0 +1,146 @@
+/*
+ * Actual synchronous architecture read entry under the construction borrower
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+int qemu_crucible_fault_register_read_frame_current_v1(
+    QemuCrucibleRegisterReadFrame *frame,
+    QemuCrucibleInitialRegisterRead **holder,
+    QemuCrucibleRegisterReadPhase phase)
+{
+#ifdef CONFIG_LINUX
+    if (frame != &crucible_register_workspace.read_frame ||
+        holder != &crucible_register_workspace.read_holder) {
+        return -EPERM;
+    }
+    if (!bql_locked() || frame->process != getpid() ||
+        !qemu_thread_is_self(&frame->thread) ||
+        !crucible_register_workspace.borrow_owner ||
+        frame->parent != crucible_register_workspace.borrow_owner ||
+        frame->parent != crucible_register_workspace.owner ||
+        current_cpu != crucible_register_workspace.borrow_cpu ||
+        crucible_register_workspace.process != getpid() ||
+        !crucible_register_workspace.borrow_calling ||
+        !crucible_register_workspace.borrow_entered ||
+        crucible_register_workspace.borrow_returned ||
+        crucible_register_workspace.borrow_issuing ||
+        crucible_register_workspace.borrow_returning ||
+        frame->serial != crucible_register_workspace.read_serial ||
+        !frame->serial) {
+        return -ESTALE;
+    }
+    switch (phase) {
+    case QEMU_CRUCIBLE_REGISTER_READ_ISSUING:
+        return frame->issuing && !*holder && !frame->calling &&
+            !frame->returning && !frame->entered && !frame->returned ? 0 : -EPERM;
+    case QEMU_CRUCIBLE_REGISTER_READ_BOUND_ISSUING:
+        return frame->issuing && *holder && !frame->calling &&
+            !frame->returning && !frame->entered && !frame->returned ? 0 : -EPERM;
+    case QEMU_CRUCIBLE_REGISTER_READ_CALLING:
+        return *holder && !frame->issuing && frame->calling &&
+            !frame->returning && !frame->entered && !frame->returned ? 0 : -EPERM;
+    case QEMU_CRUCIBLE_REGISTER_READ_ENTERED:
+        return *holder && !frame->issuing && frame->calling &&
+            !frame->returning && frame->entered && !frame->returned ? 0 : -EPERM;
+    case QEMU_CRUCIBLE_REGISTER_READ_RETURNING:
+        return *holder && !frame->issuing && !frame->calling &&
+            frame->returning && frame->entered == frame->returned ? 0 : -EPERM;
+    default:
+        return -EINVAL;
+    }
+#else
+    return -ENOTSUP;
+#endif
+}
+
+static int crucible_register_read_prebirth(bool occupied, uint64_t serial)
+{
+    if (occupied) {
+        return -EBUSY;
+    }
+    return serial == UINT64_MAX ? -EOVERFLOW : 0;
+}
+
+static int crucible_register_stream_read(
+    const QemuCrucibleRegisterFingerprintManifest *manifest,
+    const QemuCrucibleRegisterFingerprintStorage *storage, CPUState *cpu,
+    uint32_t numeric_id, const CrucibleCPURegisterGeometry *geometry,
+    const CrucibleCPURegisterKeyView *keys, void *value, size_t bytes)
+{
+    CPUClass *cc = CPU_GET_CLASS(cpu);
+    int result;
+
+    if (!qemu_plugin_crucible_startup_source_retained()) {
+        /* Preserve the ordinary architecture callback and its existing
+         * length/error contract. No Source borrower is needed in this mode. */
+        result = cc->crucible_register_read_into(cpu, numeric_id, geometry,
+                                                keys, value, bytes);
+        return result == bytes ? 0 : -EIO;
+    }
+#ifdef CONFIG_LINUX
+    QemuCrucibleRegisterReadFrame *frame =
+        &crucible_register_workspace.read_frame;
+    QemuCrucibleInitialRegisterRead **holder =
+        &crucible_register_workspace.read_holder;
+    int first, post;
+
+    if (manifest != &crucible_register_workspace.manifest ||
+        storage != &crucible_register_workspace.storage ||
+        geometry != &storage->scratch->geometry ||
+        keys != &storage->scratch->keys || value != storage->value || !bytes ||
+        bytes > storage->value_capacity || !bql_locked() ||
+        !crucible_register_workspace.borrow_owner ||
+        !crucible_register_workspace.borrow_calling ||
+        crucible_register_workspace.borrow_returned ||
+        !crucible_register_workspace.borrow_entered) {
+        return -EPERM;
+    }
+    first = crucible_register_read_prebirth(
+        *holder || frame->issuing || frame->calling || frame->returning,
+        crucible_register_workspace.read_serial);
+    if (first) {
+        return first;
+    }
+    *frame = (QemuCrucibleRegisterReadFrame) {
+        .parent = crucible_register_workspace.borrow_owner,
+        .cpu = cpu,
+        .value = value,
+        .bytes = bytes,
+        .numeric_id = numeric_id,
+        .serial = ++crucible_register_workspace.read_serial,
+        .process = getpid(),
+        .issuing = true,
+    };
+    qemu_thread_get_self(&frame->thread);
+    first = qemu_crucible_source_initial_register_read_begin_v1(frame, holder);
+    frame->issuing = false;
+    if (*holder) {
+        if (!first) {
+            frame->calling = true;
+            first = qemu_crucible_source_initial_register_read_current_v1(frame, holder);
+            if (!first) {
+                frame->entered = true;
+                result = cc->crucible_register_read_into(
+                    cpu, numeric_id, geometry, keys, value, bytes);
+                frame->returned = true;
+                first = result < 0 ? result : result == bytes ? 0 : -EIO;
+            }
+            frame->calling = false;
+        }
+        frame->work_status = first;
+        frame->returning = true;
+        post = qemu_crucible_source_initial_register_read_end_v1(frame, holder);
+        if (!first) {
+            first = post;
+        }
+        if (*holder) {
+            /* A failed close keeps the actual frame and parent dependency.
+             * No later stream call can overwrite it or repeat the callback. */
+            return first ? first : -EBUSY;
+        }
+        frame->returning = false;
+    }
+    return first;
+#else
+    return -ENOTSUP;
+#endif
+}
diff --git a/plugins/crucible-register-workspace.inc.h b/plugins/crucible-register-workspace.inc.h
new file mode 100644
index 0000000000000000000000000000000000000000..8c78d45dfe95eb5fe89cd8afcf32722af446d626
--- /dev/null
+++ b/plugins/crucible-register-workspace.inc.h
@@ -0,0 +1,659 @@
+/*
+ * Inactive register producer workspace custody
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * The selected SDK still refuses before this construction-only path. Neither
+ * its real storage custody nor a scoped loan authorizes runtime execution.
+ */
+static struct {
+    QemuCrucibleInitialRegisterWorkspaceOwner *owner;
+    QemuCrucibleRegisterWorkspaceLayout layout;
+    CPUState *issuing_cpu;
+    pid_t process;
+    int first_status;
+    int terminal_first_status;
+    size_t runtime_users;
+    size_t staged_users;
+    bool attempted;
+    bool issuing;
+    bool unpublished;
+    bool returning;
+    QemuCrucibleInitialRegisterWorkspaceOwner *borrow_owner;
+    CPUState *borrow_cpu;
+    uint64_t borrow_serial;
+    int borrow_work_status;
+    uint8_t construction_digest[32];
+    QemuCrucibleRegisterFingerprintManifest manifest;
+    QemuCrucibleRegisterFingerprintStorage storage;
+    bool borrow_issuing;
+    bool borrow_calling;
+    bool borrow_entered;
+    bool borrow_returned;
+    bool borrow_returning;
+    QemuCrucibleRegisterReadFrame read_frame;
+    QemuCrucibleInitialRegisterRead *read_holder;
+    uint64_t read_serial;
+} crucible_register_workspace;
+
+uint64_t qemu_crucible_fault_register_workspace_fixed_storage_bytes_v1(void)
+{
+    return sizeof(crucible_register_workspace);
+}
+
+#ifdef CONFIG_LINUX
+static int crucible_register_workspace_observe(
+    QemuCrucibleRegisterWorkspaceLayout *out)
+{
+    CrucibleCPURegisterGeometry geometry, other;
+    CPUState *cpu, *first = qemu_get_cpu(0);
+    CPUClass *cc;
+    const char *model;
+    size_t count = 0;
+    long page;
+
+    if (!out || !bql_locked() || !current_machine || !first ||
+        !current_machine->smp.cpus) {
+        return -EPERM;
+    }
+    cc = CPU_GET_CLASS(first);
+    if ((cc->crucible_register_scope != CRUCIBLE_REGISTER_SCOPE_X86_64 &&
+         cc->crucible_register_scope != CRUCIBLE_REGISTER_SCOPE_AARCH64) ||
+        !cc->crucible_register_geometry || !cc->crucible_register_keys_into ||
+        !cc->crucible_register_describe_into || !cc->crucible_register_read ||
+        !cc->crucible_register_validate_write || !cc->crucible_register_write ||
+        !cc->crucible_register_geometry(first, &geometry)) {
+        return -ENOTSUP;
+    }
+    model = object_get_typename(OBJECT(first));
+    if (!model) {
+        return -ESTALE;
+    }
+    CPU_FOREACH(cpu) {
+        CPUClass *actual = CPU_GET_CLASS(cpu);
+
+        if (count == SIZE_MAX || cpu->cpu_index < 0 ||
+            (size_t)cpu->cpu_index != count || !cpu->created || !cpu->stopped ||
+            qatomic_read(&cpu->running) || actual != cc ||
+            strcmp(object_get_typename(OBJECT(cpu)), model) ||
+            !actual->crucible_register_geometry(cpu, &other)) {
+            return -ESTALE;
+        }
+        other.cpu = first;
+        if (!crucible_register_geometry_equal(&geometry, &other)) {
+            return -ESTALE;
+        }
+        count++;
+    }
+    /* This is the actual configured initial cohort, not a partial list hint. */
+    if (count != current_machine->smp.cpus) {
+        return -EBUSY;
+    }
+    page = sysconf(_SC_PAGESIZE);
+    if (page <= 0 || strlen(model) == SIZE_MAX ||
+        !crucible_register_workspace_layout(&geometry, count, strlen(model) + 1,
+                                            page, out)) {
+        return -EOVERFLOW;
+    }
+    return 0;
+}
+#endif
+
+int qemu_crucible_fault_register_workspace_issuing_v1(
+    CPUState *cpu, QemuCrucibleInitialRegisterWorkspaceOwner **holder,
+    const QemuCrucibleRegisterWorkspaceLayout **layout)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleRegisterWorkspaceLayout current;
+    int status;
+
+    if (!layout || *layout || !crucible_register_workspace.attempted ||
+        !crucible_register_workspace.issuing ||
+        crucible_register_workspace.issuing_cpu != cpu || current_cpu != cpu ||
+        crucible_register_workspace.process != getpid() ||
+        holder != &crucible_register_workspace.owner || *holder ||
+        crucible_register_workspace.unpublished) {
+        return -EPERM;
+    }
+    status = crucible_register_workspace_observe(&current);
+    if (!status && !crucible_register_workspace_equal(
+            &crucible_register_workspace.layout, &current)) {
+        status = -ESTALE;
+    }
+    if (!status) {
+        *layout = &crucible_register_workspace.layout;
+    }
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+static bool crucible_register_workspace_unpublication_blocked(void)
+{
+    return crucible_register_handler_registered ||
+        crucible_register_workspace.borrow_owner ||
+        crucible_register_workspace.read_holder ||
+        crucible_register_workspace.runtime_users ||
+        crucible_register_workspace.staged_users || crucible_register_manifest ||
+        crucible_register_targets || crucible_register_bindings ||
+        crucible_register_numeric_bindings;
+}
+
+int qemu_crucible_fault_register_borrow_observe_v1(
+    CPUState *cpu, QemuCrucibleInitialRegisterWorkspaceOwner *owner,
+    QemuCrucibleInitialRegisterWorkspaceOwner **holder,
+    bool issuing, bool returning, bool *entered)
+{
+#ifdef CONFIG_LINUX
+    if (!bql_locked() || !entered || !cpu || current_cpu != cpu ||
+        cpu != crucible_register_workspace.borrow_cpu ||
+        owner != crucible_register_workspace.owner ||
+        crucible_register_workspace.process != getpid() ||
+        holder != &crucible_register_workspace.borrow_owner ||
+        issuing != crucible_register_workspace.borrow_issuing ||
+        returning != crucible_register_workspace.borrow_returning ||
+        crucible_register_workspace.borrow_calling ||
+        (issuing ? *holder != NULL : *holder != owner) ||
+        (returning && crucible_register_workspace.borrow_returned !=
+                       crucible_register_workspace.borrow_entered)) {
+        return -EPERM;
+    }
+    if (!issuing && crucible_register_workspace.borrow_serial != owner->borrow_serial) {
+        return -ESTALE;
+    }
+    *entered = crucible_register_workspace.borrow_entered;
+    return 0;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_crucible_fault_register_borrow_return_v1(CPUState *cpu)
+{
+#ifdef CONFIG_LINUX
+    int status;
+
+    if (!crucible_register_workspace.borrow_owner) {
+        return 0;
+    }
+    if (crucible_register_workspace.read_holder ||
+        crucible_register_workspace.borrow_cpu != cpu ||
+        crucible_register_workspace.borrow_issuing ||
+        crucible_register_workspace.borrow_calling ||
+        !crucible_register_workspace.borrow_returning) {
+        return -EBUSY;
+    }
+    status = qemu_crucible_source_initial_register_borrow_end_v1(
+        cpu, crucible_register_workspace.owner, &crucible_register_workspace.owner,
+        &crucible_register_workspace.borrow_owner,
+        crucible_register_workspace.borrow_work_status);
+    if (crucible_register_workspace.borrow_owner) {
+        return status ? status : -EBUSY;
+    }
+    crucible_register_workspace.borrow_returning = false;
+    crucible_register_workspace.borrow_entered = false;
+    crucible_register_workspace.borrow_returned = false;
+    crucible_register_workspace.borrow_cpu = NULL;
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+bool qemu_crucible_fault_register_borrow_outstanding_v1(CPUState *cpu)
+{
+    return crucible_register_workspace.borrow_owner &&
+        crucible_register_workspace.borrow_cpu == cpu;
+}
+
+int qemu_crucible_fault_register_workspace_holder_v1(
+    QemuCrucibleInitialRegisterWorkspaceOwner *owner,
+    QemuCrucibleInitialRegisterWorkspaceOwner **holder, bool returning)
+{
+    if (!owner || holder != &crucible_register_workspace.owner ||
+        *holder != owner || !crucible_register_workspace.attempted ||
+        crucible_register_workspace.process != getpid() ||
+        crucible_register_workspace.returning != returning ||
+        (returning && (!crucible_register_workspace.unpublished ||
+            crucible_register_workspace_unpublication_blocked())) ||
+        (!returning && crucible_register_workspace.unpublished)) {
+        return -EPERM;
+    }
+    return 0;
+}
+
+int qemu_crucible_fault_register_workspace_prepare_v1(void)
+{
+#ifdef CONFIG_LINUX
+    int status;
+
+    if (!qemu_plugin_crucible_startup_source_retained()) {
+        return -ENOTSUP;
+    }
+    if (!current_cpu || crucible_register_workspace.attempted) {
+        return -EPERM;
+    }
+    status = qemu_crucible_source_initial_cpu_current_v1(
+        current_cpu, &current_cpu->crucible_initial_participant);
+    if (!status) {
+        status = crucible_register_workspace_observe(
+            &crucible_register_workspace.layout);
+    }
+    if (status) {
+        return status;
+    }
+    crucible_register_workspace.attempted = true;
+    crucible_register_workspace.process = getpid();
+    crucible_register_workspace.issuing_cpu = current_cpu;
+    crucible_register_workspace.issuing = true;
+    status = qemu_crucible_source_initial_register_workspace_acquire_v1(
+        current_cpu, &crucible_register_workspace.owner);
+    crucible_register_workspace.issuing = false;
+    crucible_register_workspace.issuing_cpu = NULL;
+    crucible_register_workspace.first_status = status;
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_crucible_fault_register_workspace_terminal_v1(void)
+{
+#ifdef CONFIG_LINUX
+    int status;
+
+    if (crucible_register_workspace.returning || crucible_register_workspace.issuing) {
+        return -EBUSY;
+    }
+    if (!crucible_register_workspace.owner) {
+        return 0;
+    }
+    if (!crucible_register_workspace.unpublished) {
+        status = qemu_crucible_source_initial_register_workspace_terminal_ready_v1(
+            crucible_register_workspace.owner, &crucible_register_workspace.owner);
+        if (!status && crucible_register_workspace_unpublication_blocked()) {
+            status = -EBUSY;
+        }
+        if (status) {
+            if (!crucible_register_workspace.terminal_first_status) {
+                crucible_register_workspace.terminal_first_status = status;
+            }
+            return status;
+        }
+        crucible_register_workspace.unpublished = true;
+    }
+    crucible_register_workspace.returning = true;
+    status = qemu_crucible_source_initial_register_workspace_return_v1(
+        &crucible_register_workspace.owner);
+    crucible_register_workspace.returning = false;
+    if (!crucible_register_workspace.terminal_first_status) {
+        crucible_register_workspace.terminal_first_status = status;
+    }
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+/* Complete bounded schema production over factual, already retained spans.
+ * Source separately owns and authenticates the mapping and CPU cohort. No
+ * successful geometry check can authorize a selected architecture read. */
+static int crucible_register_workspace_manifest_into(
+    const QemuCrucibleRegisterWorkspaceLayout *layout, void *address,
+    QemuCrucibleRegisterFingerprintManifest *manifest,
+    QemuCrucibleRegisterFingerprintStorage *storage)
+{
+    QemuCrucibleRegisterWorkspaceLayout checked;
+    CrucibleRegisterCapability *rows;
+    CrucibleRegisterTarget *targets;
+    const char **names;
+    QemuCrucibleRegisterCpuDependency *dependencies;
+    QemuCrucibleRegisterFingerprintCpu *cohort;
+    QemuCrucibleRegisterFingerprintScratch *scratch;
+    CPUState *first = qemu_get_cpu(0), *cpu;
+    CPUClass *cc;
+    const char *model;
+    size_t count = 0, name_bytes = 0, mask_bytes = 0;
+
+    if (!bql_locked() || !layout || !address || !manifest || !storage ||
+        !first || !current_machine ||
+        !crucible_register_workspace_layout(&layout->geometry, layout->cpu_count,
+            layout->model_bytes, layout->page_bytes, &checked) ||
+        !crucible_register_workspace_equal(layout, &checked) ||
+        (uintptr_t)address % checked.page_bytes ||
+        !crucible_register_spans_disjoint(address, checked.backing_bytes,
+                                           layout, sizeof(*layout)) ||
+        !crucible_register_spans_disjoint(address, checked.backing_bytes,
+                                           manifest, sizeof(*manifest)) ||
+        !crucible_register_spans_disjoint(address, checked.backing_bytes,
+                                           storage, sizeof(*storage)) ||
+        !crucible_register_spans_disjoint(manifest, sizeof(*manifest),
+                                           storage, sizeof(*storage)) ||
+        !crucible_register_spans_disjoint(manifest, sizeof(*manifest),
+                                           layout, sizeof(*layout)) ||
+        !crucible_register_spans_disjoint(storage, sizeof(*storage),
+                                           layout, sizeof(*layout)) ||
+        current_machine->smp.cpus != checked.cpu_count ||
+        layout->geometry.cpu != first) {
+        return -EINVAL;
+    }
+    cc = CPU_GET_CLASS(first);
+    model = object_get_typename(OBJECT(first));
+    if (!model || strlen(model) + 1 != checked.model_bytes ||
+        (cc->crucible_register_scope != CRUCIBLE_REGISTER_SCOPE_X86_64 &&
+         cc->crucible_register_scope != CRUCIBLE_REGISTER_SCOPE_AARCH64) ||
+        !cc->crucible_register_geometry || !cc->crucible_register_keys_into ||
+        !cc->crucible_register_describe_into ||
+        !cc->crucible_register_qom_child) {
+        return -ENOTSUP;
+    }
+#define WORKSPACE(kind) \
+    ((void *)((uint8_t *)address + checked.part[kind].offset))
+    dependencies = WORKSPACE(CRUCIBLE_REGISTER_WORKSPACE_CPUS);
+    CPU_FOREACH(cpu) {
+        CrucibleCPURegisterGeometry geometry;
+        size_t instance_bytes = object_get_instance_size(OBJECT(cpu));
+        Object *child = NULL;
+
+        if (count >= checked.cpu_count || cpu->cpu_index < 0 ||
+            (size_t)cpu->cpu_index != count || !cpu->created || !cpu->stopped ||
+            qatomic_read(&cpu->running) || CPU_GET_CLASS(cpu) != cc ||
+            strcmp(object_get_typename(OBJECT(cpu)), model) ||
+            !cc->crucible_register_geometry(cpu, &geometry) ||
+            geometry.cpu != cpu ||
+            geometry.register_count != checked.geometry.register_count ||
+            geometry.key_count != checked.geometry.key_count ||
+            geometry.name_bytes != checked.geometry.name_bytes ||
+            geometry.mask_bytes != checked.geometry.mask_bytes ||
+            geometry.max_name_bytes != checked.geometry.max_name_bytes ||
+            geometry.max_mask_bytes != checked.geometry.max_mask_bytes ||
+            dependencies[count].cpu != cpu ||
+            dependencies[count].instance_bytes != instance_bytes ||
+            instance_bytes < sizeof(*cpu) ||
+            !crucible_register_spans_disjoint(address, checked.backing_bytes,
+                                               cpu, instance_bytes) ||
+            !crucible_register_spans_disjoint(manifest, sizeof(*manifest),
+                                               cpu, instance_bytes) ||
+            !crucible_register_spans_disjoint(storage, sizeof(*storage),
+                                               cpu, instance_bytes)) {
+            return -ESTALE;
+        }
+        if (cc->crucible_register_qom_child(cpu, &child) ||
+            dependencies[count].child != child ||
+            dependencies[count].child_instance_bytes !=
+                (child ? object_get_instance_size(child) : 0) ||
+            (child &&
+                (!crucible_register_spans_disjoint(address, checked.backing_bytes,
+                    child, object_get_instance_size(child)) ||
+                 !crucible_register_spans_disjoint(manifest, sizeof(*manifest),
+                    child, object_get_instance_size(child)) ||
+                 !crucible_register_spans_disjoint(storage, sizeof(*storage),
+                    child, object_get_instance_size(child))))) {
+            return -ESTALE;
+        }
+        count++;
+    }
+    if (count != checked.cpu_count) {
+        return -ESTALE;
+    }
+    /* All writable extents and complete initialized CPU/child extents were
+     * checked before the first scratch, schema, key, model or output mutation. */
+    rows = WORKSPACE(CRUCIBLE_REGISTER_WORKSPACE_ROWS);
+    targets = WORKSPACE(CRUCIBLE_REGISTER_WORKSPACE_TARGETS);
+    names = WORKSPACE(CRUCIBLE_REGISTER_WORKSPACE_NAME_INDEX);
+    cohort = WORKSPACE(CRUCIBLE_REGISTER_WORKSPACE_FINGERPRINT_CPUS);
+    scratch = WORKSPACE(CRUCIBLE_REGISTER_WORKSPACE_FINGERPRINT_SCRATCH);
+    scratch->geometry = checked.geometry;
+    if (!cc->crucible_register_keys_into(first,
+            WORKSPACE(CRUCIBLE_REGISTER_WORKSPACE_KEYS),
+            checked.geometry.key_count, &scratch->keys)) {
+        return -EIO;
+    }
+    for (size_t index = 0; index < checked.geometry.register_count; index++) {
+        CrucibleCPURegisterBuffers buffers = {
+            .name = WORKSPACE(CRUCIBLE_REGISTER_WORKSPACE_CANDIDATE_NAME),
+            .name_capacity = checked.geometry.max_name_bytes,
+            .writable_mask = WORKSPACE(CRUCIBLE_REGISTER_WORKSPACE_CANDIDATE_WRITABLE),
+            .reserved_mask = WORKSPACE(CRUCIBLE_REGISTER_WORKSPACE_CANDIDATE_RESERVED),
+            .ignored_mask = WORKSPACE(CRUCIBLE_REGISTER_WORKSPACE_CANDIDATE_IGNORED),
+            .read_only_mask = WORKSPACE(CRUCIBLE_REGISTER_WORKSPACE_CANDIDATE_READ_ONLY),
+            .mask_capacity = checked.geometry.max_mask_bytes,
+        };
+        CrucibleCPURegisterCapability *candidate = &scratch->candidate;
+        size_t bytes;
+
+        if (!cc->crucible_register_describe_into(first, index,
+                &scratch->geometry, &scratch->keys, &buffers, candidate) ||
+            candidate->numeric_id != index + 1 ||
+            candidate->name != buffers.name ||
+            candidate->writable_mask != buffers.writable_mask ||
+            candidate->reserved_mask != buffers.reserved_mask ||
+            candidate->ignored_mask != buffers.ignored_mask ||
+            candidate->read_only_mask != buffers.read_only_mask ||
+            candidate->mask_bytes > buffers.mask_capacity ||
+            !candidate->width_bits || candidate->width_bits > 65536 ||
+            candidate->mask_bytes != DIV_ROUND_UP(candidate->width_bits, 8) ||
+            !crucible_register_capability_valid(candidate)) {
+            return -EIO;
+        }
+        bytes = strnlen(candidate->name, buffers.name_capacity);
+        if (bytes == buffers.name_capacity) {
+            return -EOVERFLOW;
+        }
+        bytes++;
+        if (bytes > 97 || bytes > checked.geometry.name_bytes - name_bytes ||
+            candidate->mask_bytes > checked.geometry.mask_bytes - mask_bytes) {
+            return -EOVERFLOW;
+        }
+        for (size_t previous = 0; previous < index; previous++) {
+            if (!strcmp(names[previous], candidate->name)) {
+                return -EEXIST;
+            }
+        }
+        rows[index] = (CrucibleRegisterCapability) {
+            .numeric_id = candidate->numeric_id,
+            .width_bits = candidate->width_bits,
+            .group = candidate->group,
+            .model_phase_mask = candidate->model_phase_mask,
+            .side_effects = candidate->side_effects,
+            .capabilities = candidate->capabilities,
+            .name = (char *)WORKSPACE(CRUCIBLE_REGISTER_WORKSPACE_NAMES) + name_bytes,
+            .writable_mask = (uint8_t *)WORKSPACE(CRUCIBLE_REGISTER_WORKSPACE_WRITABLE) + mask_bytes,
+            .reserved_mask = (uint8_t *)WORKSPACE(CRUCIBLE_REGISTER_WORKSPACE_RESERVED) + mask_bytes,
+            .ignored_mask = (uint8_t *)WORKSPACE(CRUCIBLE_REGISTER_WORKSPACE_IGNORED) + mask_bytes,
+            .read_only_mask = (uint8_t *)WORKSPACE(CRUCIBLE_REGISTER_WORKSPACE_READ_ONLY) + mask_bytes,
+            .mask_bytes = candidate->mask_bytes,
+        };
+        memcpy((void *)rows[index].name, candidate->name, bytes);
+        memcpy((void *)rows[index].writable_mask, candidate->writable_mask,
+               candidate->mask_bytes);
+        memcpy((void *)rows[index].reserved_mask, candidate->reserved_mask,
+               candidate->mask_bytes);
+        memcpy((void *)rows[index].ignored_mask, candidate->ignored_mask,
+               candidate->mask_bytes);
+        memcpy((void *)rows[index].read_only_mask, candidate->read_only_mask,
+               candidate->mask_bytes);
+        targets[index] = (CrucibleRegisterTarget) {
+            candidate->numeric_id, candidate->width_bits,
+        };
+        names[index] = rows[index].name;
+        name_bytes += bytes;
+        mask_bytes += candidate->mask_bytes;
+    }
+    if (name_bytes != checked.geometry.name_bytes ||
+        mask_bytes != checked.geometry.mask_bytes) {
+        return -ESTALE;
+    }
+    memcpy(WORKSPACE(CRUCIBLE_REGISTER_WORKSPACE_MODEL), model, checked.model_bytes);
+    for (size_t index = 0; index < count; index++) {
+        cohort[index] = (QemuCrucibleRegisterFingerprintCpu) {
+            dependencies[index].cpu, dependencies[index].instance_bytes,
+        };
+    }
+    *storage = (QemuCrucibleRegisterFingerprintStorage) {
+        .scratch = scratch,
+        .keys = WORKSPACE(CRUCIBLE_REGISTER_WORKSPACE_LOOKUP_KEYS),
+        .key_capacity = checked.geometry.key_count,
+        .candidate = {
+            .name = WORKSPACE(CRUCIBLE_REGISTER_WORKSPACE_CANDIDATE_NAME),
+            .name_capacity = checked.geometry.max_name_bytes,
+            .writable_mask = WORKSPACE(CRUCIBLE_REGISTER_WORKSPACE_CANDIDATE_WRITABLE),
+            .reserved_mask = WORKSPACE(CRUCIBLE_REGISTER_WORKSPACE_CANDIDATE_RESERVED),
+            .ignored_mask = WORKSPACE(CRUCIBLE_REGISTER_WORKSPACE_CANDIDATE_IGNORED),
+            .read_only_mask = WORKSPACE(CRUCIBLE_REGISTER_WORKSPACE_CANDIDATE_READ_ONLY),
+            .mask_capacity = checked.geometry.max_mask_bytes,
+        },
+        .value = WORKSPACE(CRUCIBLE_REGISTER_WORKSPACE_FINGERPRINT_VALUE),
+        .value_capacity = checked.geometry.max_mask_bytes,
+    };
+    *manifest = (QemuCrucibleRegisterFingerprintManifest) {
+        rows, checked.geometry.register_count, cc->crucible_register_scope,
+        WORKSPACE(CRUCIBLE_REGISTER_WORKSPACE_MODEL),
+    };
+#undef WORKSPACE
+    return 0;
+}
+
+
+static int crucible_register_initial_manifest_work(void)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleInitialRegisterWorkspaceOwner *owner =
+        crucible_register_workspace.borrow_owner;
+    int status = crucible_register_workspace_manifest_into(
+        &owner->layout, owner->address, &crucible_register_workspace.manifest,
+        &crucible_register_workspace.storage);
+
+    if (status) {
+        return status;
+    }
+    const QemuCrucibleRegisterWorkspaceSpan *span =
+        &owner->layout.part[CRUCIBLE_REGISTER_WORKSPACE_FINGERPRINT_CPUS];
+    const QemuCrucibleRegisterFingerprintCpu *cohort =
+        (const void *)((const uint8_t *)owner->address + span->offset);
+
+    /* No invented construction RR coordinate. The existing SDK payment
+     * refusal must remain until architecture callback/transitive effects and
+     * their genuine allocation providers join this same loan. */
+    return qemu_crucible_fault_register_fingerprints_into_v1(
+        &crucible_register_workspace.manifest, cohort, owner->layout.cpu_count,
+        &crucible_register_workspace.storage, 0, NULL, NULL,
+        crucible_register_workspace.construction_digest);
+#else
+    return -ENOTSUP;
+#endif
+}
+
+static bool crucible_register_initial_outputs_disjoint(
+    const QemuCrucibleInitialRegisterWorkspaceOwner *owner,
+    CrucibleRegisterCapability *out, size_t capacity,
+    uint16_t *architecture, const char **cpu_model)
+{
+#ifdef CONFIG_LINUX
+    const void *outputs[] = { out, architecture, cpu_model };
+    size_t bytes[] = { 0, sizeof(*architecture), sizeof(*cpu_model) };
+    CPUState *cpu;
+
+    if (capacity > SIZE_MAX / sizeof(*out) ||
+        (out && capacity && (uintptr_t)out % _Alignof(*out)) ||
+        (uintptr_t)architecture % _Alignof(*architecture) ||
+        (uintptr_t)cpu_model % _Alignof(*cpu_model)) {
+        return false;
+    }
+    bytes[0] = out ? capacity * sizeof(*out) : 0;
+    for (size_t index = 0; index < G_N_ELEMENTS(outputs); index++) {
+        if (!crucible_register_spans_disjoint(outputs[index], bytes[index],
+                owner->address, owner->layout.backing_bytes) ||
+            !crucible_register_spans_disjoint(outputs[index], bytes[index],
+                owner, sizeof(*owner)) ||
+            !crucible_register_spans_disjoint(outputs[index], bytes[index],
+                &crucible_register_workspace, sizeof(crucible_register_workspace))) {
+            return false;
+        }
+        for (size_t other = index + 1; other < G_N_ELEMENTS(outputs); other++) {
+            if (!crucible_register_spans_disjoint(outputs[index], bytes[index],
+                    outputs[other], bytes[other])) {
+                return false;
+            }
+        }
+        CPU_FOREACH(cpu) {
+            CPUClass *cc = CPU_GET_CLASS(cpu);
+            Object *child = NULL;
+
+            if (!crucible_register_spans_disjoint(outputs[index], bytes[index],
+                    cpu, object_get_instance_size(OBJECT(cpu))) ||
+                !cc->crucible_register_qom_child ||
+                cc->crucible_register_qom_child(cpu, &child) ||
+                (child && !crucible_register_spans_disjoint(
+                    outputs[index], bytes[index], child,
+                    object_get_instance_size(child)))) {
+                return false;
+            }
+        }
+    }
+    return true;
+#else
+    return false;
+#endif
+}
+
+static int crucible_register_initial_manifest_attempt(
+    CrucibleRegisterCapability *out, size_t capacity,
+    uint16_t *architecture, const char **cpu_model)
+{
+#ifdef CONFIG_LINUX
+    int first, post;
+
+    if (!architecture || !cpu_model || !current_cpu ||
+        crucible_register_workspace.borrow_owner ||
+        crucible_register_workspace.borrow_issuing ||
+        crucible_register_workspace.borrow_calling ||
+        crucible_register_workspace.borrow_returning) {
+        return -EPERM;
+    }
+    if (!crucible_register_workspace.attempted) {
+        first = qemu_crucible_fault_register_workspace_prepare_v1();
+    } else {
+        first = crucible_register_workspace.first_status;
+    }
+    if (first || !crucible_register_workspace.owner) {
+        return first ? first : -ESTALE;
+    }
+    crucible_register_workspace.borrow_cpu = current_cpu;
+    crucible_register_workspace.borrow_issuing = true;
+    first = qemu_crucible_source_initial_register_borrow_begin_v1(
+        current_cpu, crucible_register_workspace.owner,
+        &crucible_register_workspace.owner,
+        &crucible_register_workspace.borrow_owner);
+    crucible_register_workspace.borrow_issuing = false;
+    if (crucible_register_workspace.borrow_owner) {
+        crucible_register_workspace.borrow_serial =
+            crucible_register_workspace.borrow_owner->borrow_serial;
+        if (!first && !crucible_register_initial_outputs_disjoint(
+                crucible_register_workspace.borrow_owner,
+                out, capacity, architecture, cpu_model)) {
+            first = -EINVAL;
+        }
+        if (!first) {
+            crucible_register_workspace.borrow_calling = true;
+            crucible_register_workspace.borrow_entered = true;
+            first = crucible_register_initial_manifest_work();
+            crucible_register_workspace.borrow_returned = true;
+            crucible_register_workspace.borrow_calling = false;
+        }
+        crucible_register_workspace.borrow_work_status = first;
+        crucible_register_workspace.borrow_returning = true;
+        post = qemu_crucible_fault_register_borrow_return_v1(current_cpu);
+        if (!first) {
+            first = post;
+        }
+        if (crucible_register_workspace.borrow_owner) {
+            /* Preserve call facts and the canonical holder on failed close. */
+            return first ? first : -EBUSY;
+        }
+    }
+    return first;
+#else
+    return -ENOTSUP;
+#endif
+}
diff --git a/plugins/crucible-required-workers.inc.h b/plugins/crucible-required-workers.inc.h
new file mode 100644
index 0000000000000000000000000000000000000000..42383e0441ee8d50ef8c5d023fae058a0ff1ecf9
--- /dev/null
+++ b/plugins/crucible-required-workers.inc.h
@@ -0,0 +1,765 @@
+/*
+ * Genuine required RUN and teardown role adapters for the shared native worker
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * These producers establish physical lifetime only. They qualify no provider,
+ * Original, Source activation, callback publication or inventory model.
+ */
+#ifdef CONFIG_LINUX
+static bool required_worker_slot(QemuCrucibleRequiredWorker *worker)
+{
+    return worker == &startup_source.run_worker || worker == &startup_source.teardown_worker;
+}
+
+static QemuCrucibleRequiredWorker *required_worker_from_native(QemuCruciblePluginWorker *native)
+{
+    if (native == &startup_source.run_worker.native) {
+        return &startup_source.run_worker;
+    }
+    if (native == &startup_source.teardown_worker.native) {
+        return &startup_source.teardown_worker;
+    }
+    return NULL;
+}
+
+static int required_worker_role_identity(QemuCruciblePluginWorker *native)
+{
+    if (native == &startup_source.run_worker.native) {
+        QemuCrucibleRunWorkerClaim *claim = &startup_source.run_worker_claim;
+
+        return claim->issued && claim->consumed && claim->runtime == native->runtime &&
+            claim->request == native->request ? 0 : -EPERM;
+    }
+    if (native == &startup_source.teardown_worker.native) {
+        QemuCrucibleTeardownWorkerClaim *claim = &startup_source.teardown_worker_claim;
+
+        return claim->issued && claim->consumed && claim->runtime == native->runtime &&
+            claim->request == native->request ? 0 : -EPERM;
+    }
+    return -EPERM;
+}
+
+static int required_worker_invoke_construct(QemuCruciblePluginWorker *native, void *input)
+{
+    QemuCrucibleRequiredWorker *worker = required_worker_from_native(native);
+    qemu_plugin_id_t id = native->installer.plugin_id;
+    int status;
+
+    if (!worker) {
+        return -EPERM;
+    }
+    SOURCE_CALLBACK_MASKED_INVOKE(status, &worker->frame, worker->construct,
+        input, id, &worker->frame, input);
+    return status > 0 ? -EPROTO : status;
+}
+
+static int required_worker_invoke_entry(QemuCruciblePluginWorker *native, void *owner)
+{
+    QemuCrucibleRequiredWorker *worker = required_worker_from_native(native);
+    qemu_plugin_id_t id = native->installer.plugin_id;
+    int status;
+
+    if (!worker) {
+        return -EPERM;
+    }
+    SOURCE_CALLBACK_MASKED_INVOKE(status, worker, worker->entry, owner, id, worker, owner);
+    return status > 0 ? -EPROTO : status;
+}
+
+static int required_worker_invoke_close(QemuCruciblePluginWorker *native, void *owner)
+{
+    QemuCrucibleRequiredWorker *worker = required_worker_from_native(native);
+    qemu_plugin_id_t id = native->installer.plugin_id;
+    int status;
+
+    if (!worker) {
+        return -EPERM;
+    }
+    SOURCE_CALLBACK_MASKED_INVOKE(status, worker, worker->close, owner, id, worker, owner);
+    return status > 0 ? -EPROTO : status;
+}
+
+static int required_worker_invoke_control(QemuCruciblePluginWorker *native,
+                                          void *owner, void *input)
+{
+    QemuCrucibleRequiredWorker *worker = required_worker_from_native(native);
+    qemu_plugin_id_t id = native->installer.plugin_id;
+    int status;
+
+    if (!worker) {
+        return -EPERM;
+    }
+    SOURCE_CALLBACK_MASKED_INVOKE(status, worker, worker->control, owner, id, worker, owner, input);
+    return status > 0 ? -EPROTO : status;
+}
+
+static int required_worker_invoke_destroy(QemuCruciblePluginWorker *native, void **owning_field)
+{
+    QemuCrucibleRequiredWorker *worker = required_worker_from_native(native);
+    qemu_plugin_id_t id = native->installer.plugin_id;
+    int status;
+
+    if (!worker) {
+        return -EPERM;
+    }
+    SOURCE_CALLBACK_MASKED_INVOKE(status, &worker->frame, worker->destroy,
+        native->destruction_alias, id, &worker->frame, owning_field);
+    return status;
+}
+
+/* Symbol names select the two actual matched constructors; they are not
+ * caller-supplied roles and cannot manufacture a Source-issued claim. */
+static int required_worker_resolve(QemuCrucibleRequiredWorker *worker)
+{
+    const struct qemu_plugin_crucible_fingerprint_worker_layout_v1 *layout;
+    const char *prefix = worker == &startup_source.run_worker ?
+        "qemu_plugin_crucible_run_worker_" : "qemu_plugin_crucible_teardown_worker_";
+    char name[96];
+    gpointer symbol;
+
+#define RESOLVE_REQUIRED(member, suffix)                                   \
+    do {                                                                   \
+        snprintf(name, sizeof(name), "%s%s_v1", prefix, suffix);             \
+        if (!g_module_symbol(worker->native.installer.module, name, &symbol) || \
+            !plugin_worker_same_module(symbol)) {                           \
+            return -ELIBBAD;                                                \
+        }                                                                  \
+        worker->member = (__typeof__(worker->member))symbol;                 \
+    } while (0)
+
+    RESOLVE_REQUIRED(construct, "construct");
+    RESOLVE_REQUIRED(entry, "entry");
+    RESOLVE_REQUIRED(close, "module_close");
+    RESOLVE_REQUIRED(control, "module_control");
+    RESOLVE_REQUIRED(destroy, "destroy");
+    if (worker == &startup_source.run_worker) {
+        RESOLVE_REQUIRED(handoff, "module_handoff");
+    }
+#undef RESOLVE_REQUIRED
+
+    snprintf(name, sizeof(name), "%slayout_v1", prefix);
+    if (!g_module_symbol(worker->native.installer.module, name, &symbol) ||
+        !plugin_worker_same_module(symbol)) {
+        return -ELIBBAD;
+    }
+    layout = symbol;
+    if (layout->schema_version != 1 || layout->struct_size != sizeof(*layout) ||
+        layout->control_bytes != worker->native.request->extent ||
+        layout->control_alignment != worker->native.request->alignment ||
+        !layout->stack_bytes || layout->stack_bytes > SIZE_MAX) {
+        return -ESTALE;
+    }
+    worker->native.layout = *layout;
+    return 0;
+}
+
+static int required_worker_plan(QemuCrucibleRequiredWorker *worker,
+                                QemuCrucibleStartupRuntimePurpose *runtime,
+                                const QemuCrucibleProcessPurposeRequest *request,
+                                const char *thread_name)
+{
+    int status;
+
+    if (worker->native.planned) {
+        return -EALREADY;
+    }
+    worker->native = (QemuCruciblePluginWorker) {
+        .installer = startup_source.saved,
+        .runtime = runtime,
+        .request = request,
+        .projection = worker,
+        .thread_name = thread_name,
+        .observation.descriptor = -1,
+        .policy_descriptor = -1,
+        .planned = true,
+        .construct = required_worker_invoke_construct,
+        .entry = required_worker_invoke_entry,
+        .close = required_worker_invoke_close,
+        .control = required_worker_invoke_control,
+        .destroy = required_worker_invoke_destroy,
+        .role_identity = required_worker_role_identity,
+    };
+    worker->frame.worker = worker;
+    qemu_cond_init(&worker->native.wake);
+    status = required_worker_resolve(worker);
+    if (!status) {
+        status = plugin_worker_fund(&worker->native);
+    }
+    worker->native.first_status = status;
+    return status;
+}
+
+static int required_workers_plan(QemuCrucibleStartupRuntimePurpose *runtime)
+{
+    QemuCrucibleRequiredWorker *run = &startup_source.run_worker;
+    QemuCrucibleRequiredWorker *teardown = &startup_source.teardown_worker;
+    int status;
+
+    /* Called only by real roster admission before publication. Neither a
+     * layout symbol nor a numeric request row independently issues credit. */
+    if (runtime != &startup_source.runtime_purpose || !runtime->charge.held ||
+        !runtime->configured_requests || getpid() != startup_source.owner_process ||
+        !startup_source.run_worker_claim.issued || !startup_source.teardown_worker_claim.issued) {
+        return -ENOKEY;
+    }
+    status = required_worker_plan(run, runtime, startup_source.run_worker_claim.request,
+                                  "crucible-run");
+    if (!status) {
+        status = required_worker_plan(teardown, runtime,
+            startup_source.teardown_worker_claim.request, "crucible-drop");
+    }
+    /* Retain the actual issued task entitlement for BOTH roles before either
+     * creator can be admitted. Failure retains its funded prefix; no ceiling
+     * changes and no other task's occupancy becomes capacity credit. */
+    if (!status) {
+        status = startup_task_reserve(&run->native.task_reserved);
+    }
+    if (!status) {
+        status = startup_task_reserve(&teardown->native.task_reserved);
+    }
+    return status;
+}
+
+int qemu_plugin_crucible_required_workers_unborn_return_v1(
+    qemu_plugin_id_t id, QemuCrucibleStartupRuntimePurpose *runtime,
+    QemuCrucibleRunWorkerClaim *run_claim,
+    QemuCrucibleTeardownWorkerClaim *teardown_claim)
+{
+    QemuCrucibleRequiredWorker *workers[] = {
+        &startup_source.run_worker, &startup_source.teardown_worker,
+    };
+    bool unused[2] = { false, false };
+    int first = 0;
+
+    /* This rollback needs no published-success roster: a failed pair may
+     * retain debits and task entitlements before that final publication. */
+    if (!startup_invocation(id) || runtime != &startup_source.runtime_purpose ||
+        !runtime->attempted || run_claim != &startup_source.run_worker_claim ||
+        teardown_claim != &startup_source.teardown_worker_claim ||
+        !run_claim->issued || !teardown_claim->issued ||
+        run_claim->runtime != runtime || teardown_claim->runtime != runtime) {
+        return -EPERM;
+    }
+    qemu_mutex_lock(&startup_source.commands.mutex);
+    for (size_t index = 0; index < G_N_ELEMENTS(workers); index++) {
+        QemuCruciblePluginWorker *native = &workers[index]->native;
+
+        /* An admitted creator retains its real worker output for ordinary
+         * close/join. Only its unused sibling can take this no-birth path. */
+        if (native->attempted) {
+            continue;
+        }
+        if (native->birth.birth_attempted || native->stack) {
+            qemu_mutex_unlock(&startup_source.commands.mutex);
+            return -EPROTO;
+        }
+        if (index == 0) {
+            run_claim->consumed = true;
+        } else {
+            teardown_claim->consumed = true;
+        }
+        unused[index] = true;
+    }
+    qemu_mutex_unlock(&startup_source.commands.mutex);
+
+    for (size_t index = 0; index < G_N_ELEMENTS(workers); index++) {
+        QemuCruciblePluginWorker *native = &workers[index]->native;
+        int status = 0;
+
+        if (!unused[index]) {
+            continue;
+        }
+        if (native->task_reserved) {
+            status = startup_task_physical_return(&native->task_reserved);
+            if (status && !native->task_return_status) {
+                native->task_return_status = status;
+            }
+        }
+        if (!status && native->stack_charge.held) {
+            status = crucible_metadata_native_retire(&startup_source.metadata_partition,
+                                                     &native->stack_charge);
+            if (status && !native->stack_retire_status) {
+                native->stack_retire_status = status;
+            }
+        }
+        first = first ? first : status;
+    }
+    /* Residual/roster history remains process-held. No worker was returned,
+     * joined or destroyed by this proof of excluded creator admission. */
+    return first;
+}
+
+static int required_worker_create(qemu_plugin_id_t id,
+                                  QemuCrucibleStartupRuntimePurpose *runtime,
+                                  QemuCrucibleCallbackChildOwner *child,
+                                  QemuCrucibleRequiredWorker *worker,
+                                  void *input, QemuCrucibleRequiredWorker **out)
+{
+    QemuCruciblePluginWorker *native = &worker->native;
+    int status = command_registry_identity(id);
+
+    if (status || !startup_invocation(id) || !out ||
+        callback_child_output_overlap(out, sizeof(*out), &startup_source, sizeof(startup_source)) ||
+        fingerprint_output_workspace_overlap(out, sizeof(*out))) {
+        return status ? status : -EPERM;
+    }
+    if (*out) {
+        return -EINVAL;
+    }
+    status = startup_runtime_admission(id, runtime);
+    if (status) {
+        return status;
+    }
+    qemu_mutex_lock(&startup_source.commands.mutex);
+    status = callback_registration_owner_live_locked(child);
+    if (!status && (!native->planned || native->attempted || native->first_status ||
+        native->runtime != runtime || !native->funding_attempted || native->funding_status ||
+        !native->residual_charge.held || !native->stack_charge.held || !native->task_reserved ||
+        native->residual_charge.bytes != native->residual_bytes ||
+        native->stack_charge.bytes != native->layout.stack_bytes ||
+        child != &startup_source.callbacks.owner || child->component_users == UINT64_MAX ||
+        child->child->physical_users == UINT64_MAX)) {
+        status = -EPERM;
+    }
+    if (!status && worker == &startup_source.run_worker) {
+        QemuCrucibleRunWorkerClaim *claim = &startup_source.run_worker_claim;
+
+        if (!claim->issued || claim->consumed || claim->runtime != runtime ||
+            claim->request_index >= runtime->configured_count ||
+            claim->request != &runtime->configured_requests[claim->request_index] ||
+            claim->request != native->request) {
+            status = -EPERM;
+        } else {
+            claim->consumed = true;
+        }
+    } else if (!status) {
+        QemuCrucibleTeardownWorkerClaim *claim = &startup_source.teardown_worker_claim;
+
+        if (!claim->issued || claim->consumed || claim->runtime != runtime ||
+            claim->request_index >= runtime->configured_count ||
+            claim->request != &runtime->configured_requests[claim->request_index] ||
+            claim->request != native->request) {
+            status = -EPERM;
+        } else {
+            claim->consumed = true;
+        }
+    }
+    if (!status) {
+        native->child = child;
+        native->attempted = true;
+        native->pins_held = true;
+        native->transition_active = true;
+        native->creation_owner = worker;
+        native->holder = &native->creation_owner;
+        native->runtime_base = child->runtime_base;
+        native->runtime_extent = child->runtime_extent;
+        child->component_users++;
+        child->child->physical_users++;
+        *out = worker;
+    }
+    qemu_mutex_unlock(&startup_source.commands.mutex);
+    if (status) {
+        return status;
+    }
+    return plugin_worker_birth(id, native, input);
+}
+
+int qemu_plugin_crucible_run_worker_create_v1(
+    qemu_plugin_id_t id, QemuCrucibleStartupRuntimePurpose *runtime,
+    QemuCrucibleRunWorkerClaim *claim, QemuCrucibleCallbackChildOwner *child,
+    void *input, QemuCrucibleRequiredWorker **out)
+{
+    if (claim != &startup_source.run_worker_claim) {
+        return -EPERM;
+    }
+    return required_worker_create(id, runtime, child, &startup_source.run_worker, input, out);
+}
+
+int qemu_plugin_crucible_teardown_worker_create_v1(
+    qemu_plugin_id_t id, QemuCrucibleStartupRuntimePurpose *runtime,
+    QemuCrucibleTeardownWorkerClaim *claim, QemuCrucibleCallbackChildOwner *child,
