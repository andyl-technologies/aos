+        }
+        operation = QEMU_RCU_HOT_FORK_BARRIER_HOLD;
+        break;
+    case CRUCIBLE_HOT_FORK_RCU_BARRIER_ACTION_QUERY:
+        operation = QEMU_RCU_HOT_FORK_BARRIER_QUERY;
+        break;
+    case CRUCIBLE_HOT_FORK_RCU_BARRIER_ACTION_RELEASE:
+        if (crucible_hot_fork_template_reserves_barriers()) {
+            error_setg(errp, "Crucible hot-fork template transaction owns "
+                       "the RCU barrier");
+            goto out;
+        }
+        operation = QEMU_RCU_HOT_FORK_BARRIER_RELEASE;
+        break;
+    default:
+        error_setg(errp, "Unknown Crucible hot-fork RCU barrier action");
+        goto out;
+    }
+
+    report = crucible_hot_fork_rcu_barrier(operation);
+out:
+    g_mutex_unlock(&crucible_hot_fork_template_lock);
+    return report;
