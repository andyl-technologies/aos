+def native_without_plugin_redeclaration(source, native):
+    # These separately compiled producers share the same unconditional global.
+    # The composed unit retains Source's literal declaration and removes only
+    # Native's identical declaration after checking scope and compatibility.
+    declaration = "extern struct qemu_plugin_state plugin;"
+    for unit in (source, native):
+        literal = unique_line(unit, declaration)
+        code = code_mask(unit)
+        unique_line(code, declaration)
+        prefix = code[:code.index(declaration)]
+        conditional_depth = 0
+        for directive in re.finditer(r"(?m)^\s*#\s*(if|ifdef|ifndef|endif)\b", prefix):
