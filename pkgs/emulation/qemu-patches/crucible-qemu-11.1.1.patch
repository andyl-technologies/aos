+     * full observation cannot replace callbacks or reset its private claim. */
+    if (qatomic_cmpxchg(&root_reader_registration.state,
+                        ROOT_READERS_EMPTY, ROOT_READERS_INSTALLING) != 0) {
+        return -EBUSY;
