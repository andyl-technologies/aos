+void qemu_plugin_register_vcpu_idle_resume_cb(qemu_plugin_vcpu_idle_resume_cb_t idle_cb,
+                                              qemu_plugin_vcpu_idle_resume_cb_t resume_cb,
+                                              void *userdata)
+{
+#ifdef CONFIG_PLUGIN
+    QemuCrucibleNativeGroupRegistrar registrar;
+    QemuCrucibleNativeGroupDescriptorView actual;
+    const QemuCrucibleNativeGroupDescriptorView expected[] = {
+        {
+            .coordinate = &qemu_plugin_vcpu_idle_resume_idle_cb,
+            .function = idle_cb,
+            .userdata = userdata,
+            .userdata_coordinate = &qemu_plugin_vcpu_idle_resume_userdata,
+            .kind = QEMU_CRUCIBLE_NATIVE_REGISTERED,
+        },
+        {
+            .coordinate = &qemu_plugin_vcpu_idle_resume_resume_cb,
+            .function = resume_cb,
+            .userdata = userdata,
+            .userdata_coordinate = &qemu_plugin_vcpu_idle_resume_userdata,
+            .kind = QEMU_CRUCIBLE_NATIVE_REGISTERED,
+        },
+    };
+
+    if (qemu_plugin_crucible_native_group_begin_v1(
+            QEMU_CRUCIBLE_NATIVE_GROUP_IDLE_RESUME, expected, ARRAY_SIZE(expected),
+            &registrar) ||
+        qemu_plugin_crucible_native_group_effect_begin_v1(&registrar)) {
+        qemu_plugin_crucible_native_group_finish_v1(&registrar);
+        return;
+    }
+
+    qemu_plugin_crucible_native_group_member_attempt_v1(&registrar, 0);
+    qemu_plugin_crucible_native_registration_release_v1(native_callback_registrations.idle);
+    qatomic_store_release(&native_callback_registrations.idle,
+        qemu_plugin_crucible_native_group_member_v1(&registrar, 0));
+    qemu_plugin_crucible_native_group_member_attempt_v1(&registrar, 1);
+    qemu_plugin_crucible_native_registration_release_v1(native_callback_registrations.resume);
+    qatomic_store_release(&native_callback_registrations.resume,
+        qemu_plugin_crucible_native_group_member_v1(&registrar, 1));
+
+#endif
+    qemu_plugin_vcpu_idle_resume_userdata = userdata;
+    qemu_plugin_vcpu_idle_resume_resume_cb = resume_cb;
+    qemu_plugin_vcpu_idle_resume_idle_cb = idle_cb;
+
+#ifdef CONFIG_PLUGIN
+    if (qemu_plugin_crucible_native_idle_resume_descriptor_observe_v1(0, &actual)) {
+        qemu_plugin_crucible_native_group_member_installed_v1(
+            &registrar, 0, &actual);
+    }
+    if (qemu_plugin_crucible_native_idle_resume_descriptor_observe_v1(1, &actual)) {
+        qemu_plugin_crucible_native_group_member_installed_v1(
+            &registrar, 1, &actual);
+    }
+    qemu_plugin_crucible_native_group_effect_end_v1(&registrar);
+    qemu_plugin_crucible_native_group_finish_v1(&registrar);
+#endif
+
+    if (idle_cb && resume_cb) {
+        qemu_plugin_crucible_callback_registered(
+            0, QEMU_PLUGIN_CRUCIBLE_CALLBACK_VCPU_IDLE_RESUME);
+    }
+}
