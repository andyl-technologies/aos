+    if (kbd_timer) {
+        timer_del(kbd_timer);
+    }
+    while ((item = QTAILQ_FIRST(&kbd_queue))) {
+        QTAILQ_REMOVE(&kbd_queue, item, node);
+        qemu_input_queue_item_free(item);
+    }
+    queue_count = 0;
+}
+
+static bool qemu_input_console_identity(QemuConsole *console,
+                                        QemuInputConsoleIdentity *identity,
+                                        Error **errp)
+{
+    Object *device = NULL;
+    g_autofree char *device_path = NULL;
+    const char *type;
+    int index;
+
+    memset(identity, 0, sizeof(*identity));
+    identity->index = QEMU_INPUT_CONSOLE_NONE;
+    if (!console) {
+        return true;
+    }
+
+    index = qemu_console_get_index(console);
+    type = object_get_typename(OBJECT(console));
+    if (index < 0 || !type || strlen(type) >= sizeof(identity->type)) {
+        error_setg(errp, "queued keyboard event has invalid console identity");
+        return false;
+    }
+
+    if (qemu_console_lookup_by_index(index) != console) {
+        error_setg(errp, "queued keyboard event references a stale console");
+        return false;
+    }
+
+    identity->index = index;
+    pstrcpy(identity->type, sizeof(identity->type), type);
+    identity->head = qemu_console_get_head(console);
+
+    if (qemu_console_is_graphic(console)) {
+        device = object_property_get_link(OBJECT(console), "device", errp);
+        if (*errp) {
+            return false;
+        }
+    }
+    if (!device) {
+        return true;
+    }
+
+    device_path = object_get_canonical_path(device);
+    if (strlen(device_path) >= sizeof(identity->device_path)) {
+        error_setg(errp, "queued keyboard console device path is too long");
+        return false;
+    }
+    pstrcpy(identity->device_path, sizeof(identity->device_path), device_path);
+    return true;
+}
+
+static bool qemu_input_console_resolve(const QemuInputConsoleIdentity *identity,
+                                       QemuConsole **console, Error **errp)
+{
+    QemuInputConsoleIdentity actual;
+
+    *console = NULL;
+    if (identity->index == QEMU_INPUT_CONSOLE_NONE) {
+        if (identity->type[0] || identity->head || identity->device_path[0]) {
+            error_setg(errp, "null queued keyboard console has topology data");
+            return false;
+        }
+        return true;
+    }
+    if (identity->index < 0) {
+        error_setg(errp, "queued keyboard console index is invalid");
+        return false;
+    }
+
+    *console = qemu_console_lookup_by_index(identity->index);
+    if (!*console ||
+        !qemu_input_console_identity(*console, &actual, errp)) {
+        if (!*errp) {
+            error_setg(errp, "queued keyboard console %d is missing",
+                       identity->index);
+        }
+        return false;
+    }
+    if (strcmp(identity->type, actual.type) ||
+        identity->head != actual.head ||
+        strcmp(identity->device_path, actual.device_path)) {
+        error_setg(errp, "queued keyboard console %d topology changed",
+                   identity->index);
+        return false;
+    }
+
+    object_ref(OBJECT(*console));
+    return true;
+}
+
+static void qemu_input_queue_arm_delay(QemuInputEventQueue *item)
+{
+    if (qemu_timer_tcg_ps_enabled()) {
+        timer_mod_after_ns(item->timer,
+                           (int64_t)item->delay_ms *
+                           (NANOSECONDS_PER_SECOND / 1000));
+    } else {
+        timer_mod(item->timer, qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) +
+                  item->delay_ms);
+    }
+}
+
+static bool qemu_input_queue_validate(int64_t *deadline_ns,
+                                      uint16_t *phase_ps, Error **errp)
+{
+    QemuInputEventQueue *item;
+    QemuInputConsoleIdentity identity;
+    uint32_t count = 0;
+    bool expect_sync = false;
+    int timer_status;
+
+    QTAILQ_FOREACH(item, &kbd_queue, node) {
+        count++;
+        if (count > queue_limit) {
+            error_setg(errp, "keyboard queue exceeds its configured limit");
+            return false;
+        }
+
+        switch (item->type) {
+        case QEMU_INPUT_QUEUE_DELAY:
+            if (expect_sync || item->timer != kbd_timer ||
+                (!item->delay_ms && item != QTAILQ_FIRST(&kbd_queue))) {
+                error_setg(errp, "keyboard queue contains an invalid delay");
+                return false;
+            }
+            break;
+        case QEMU_INPUT_QUEUE_EVENT:
+            if (expect_sync || item->evt.type != INPUT_EVENT_KIND_KEY ||
+                !item->evt.key.key) {
+                error_setg(errp, "keyboard queue contains an invalid event");
+                return false;
+            }
+            if (!qemu_input_console_identity(item->src, &identity, errp)) {
+                return false;
+            }
+            expect_sync = true;
+            break;
+        case QEMU_INPUT_QUEUE_SYNC:
+            if (!expect_sync) {
+                error_setg(errp, "keyboard queue contains an invalid sync");
+                return false;
+            }
+            expect_sync = false;
+            break;
+        default:
+            error_setg(errp, "keyboard queue contains an unknown operation");
+            return false;
+        }
+    }
+
+    if (count != queue_count || expect_sync) {
+        error_setg(errp, "keyboard queue accounting is inconsistent");
+        return false;
+    }
+    if (!count) {
+        if (kbd_timer && timer_pending(kbd_timer)) {
+            error_setg(errp, "empty keyboard queue has a pending timer");
+            return false;
+        }
+        return true;
+    }
+    if (QTAILQ_FIRST(&kbd_queue)->type != QEMU_INPUT_QUEUE_DELAY ||
+        !kbd_timer) {
+        error_setg(errp, "keyboard queue has no leading delay");
+        return false;
+    }
+
+    timer_status = timer_expire_time_ns_phase(kbd_timer, deadline_ns,
+                                               phase_ps);
+    if (timer_status < 0) {
+        error_setg(errp, "keyboard delay exceeds the nanosecond horizon");
+        return false;
+    }
+    if (!timer_status) {
+        error_setg(errp, "keyboard queue has no pending delay timer");
+        return false;
+    }
+    return true;
+}
+
+static bool qemu_input_queue_write(QEMUFile *file, Error **errp)
+{
+    QemuInputEventQueue *item;
+    QemuInputConsoleIdentity identity;
+    uint16_t phase_ps = 0;
+    int64_t deadline_ns = 0;
+
+    if (!qemu_input_queue_validate(&deadline_ns, &phase_ps, errp)) {
+        return false;
+    }
+
+    qemu_put_be32(file, queue_count);
+    qemu_put_byte(file, queue_count != 0);
+    if (queue_count) {
+        qemu_put_sbe64(file, deadline_ns);
+        qemu_put_be16(file, phase_ps);
+    }
+
+    QTAILQ_FOREACH(item, &kbd_queue, node) {
+        qemu_put_byte(file, item->type);
+        switch (item->type) {
+        case QEMU_INPUT_QUEUE_DELAY:
+            qemu_put_be32(file, item == QTAILQ_FIRST(&kbd_queue) ?
+                                0 : item->delay_ms);
+            break;
+        case QEMU_INPUT_QUEUE_EVENT:
+            if (!qemu_input_console_identity(item->src, &identity, errp)) {
+                return false;
+            }
+            qemu_put_sbe32(file, identity.index);
+            qemu_put_counted_string(file, identity.type);
+            qemu_put_be32(file, identity.head);
+            qemu_put_counted_string(file, identity.device_path);
+            qemu_put_be32(file, item->evt.type);
+            qemu_put_be32(file, item->evt.key.key);
+            qemu_put_byte(file, item->evt.key.down);
+            break;
+        case QEMU_INPUT_QUEUE_SYNC:
+            break;
+        default:
+            g_assert_not_reached();
+        }
+    }
+
+    if (qemu_file_get_error(file)) {
+        error_setg(errp, "failed to write keyboard queue state");
+        return false;
+    }
+    return true;
+}
+
+static void qemu_input_queue_temp_clear(QemuInputEventQueueHead *queue)
+{
+    QemuInputEventQueue *item;
+
+    while ((item = QTAILQ_FIRST(queue))) {
+        QTAILQ_REMOVE(queue, item, node);
+        qemu_input_queue_item_free(item);
+    }
+}
+
+static bool qemu_input_queue_read_string(QEMUFile *file, char value[256],
+                                         bool allow_empty)
+{
+    size_t length = qemu_get_counted_string(file, value);
+
+    return !qemu_file_get_error(file) && (allow_empty || length != 0);
+}
+
+static int qemu_input_queue_load(QEMUFile *file, void *opaque, int version_id)
+{
+    QemuInputEventQueueHead loaded_queue;
+    QemuInputEventQueue *item;
+    QemuInputConsoleIdentity identity;
+    Error *local_err = NULL;
+    uint32_t count;
+    uint32_t i;
+    uint16_t phase_ps = 0;
+    int64_t deadline_ns = 0;
+    uint8_t pending_wire;
+    bool expect_sync = false;
+    bool pending;
+
+    if (version_id != QEMU_INPUT_QUEUE_VMSTATE_VERSION || kbd_queue_loaded) {
+        return -EINVAL;
+    }
+
+    QTAILQ_INIT(&loaded_queue);
+    count = qemu_get_be32(file);
+    pending_wire = qemu_get_byte(file);
+    if (pending_wire > 1 || count > queue_limit ||
+        pending_wire != (count != 0)) {
+        goto malformed;
+    }
+    pending = pending_wire;
+    if (pending) {
+        deadline_ns = qemu_get_sbe64(file);
+        phase_ps = qemu_get_be16(file);
+        if (phase_ps >= 1000) {
+            goto malformed;
+        }
+    }
+
+    for (i = 0; i < count; i++) {
+        item = g_new0(QemuInputEventQueue, 1);
+        item->type = qemu_get_byte(file);
+
+        switch (item->type) {
+        case QEMU_INPUT_QUEUE_DELAY:
+            item->delay_ms = qemu_get_be32(file);
+            item->timer = qemu_input_queue_timer();
+            if (expect_sync || (!item->delay_ms && i != 0)) {
+                g_free(item);
+                goto malformed;
+            }
+            break;
+        case QEMU_INPUT_QUEUE_EVENT: {
+            uint8_t down;
+
+            identity.index = qemu_get_sbe32(file);
+            if (expect_sync ||
+                !qemu_input_queue_read_string(
+                    file, identity.type,
+                    identity.index == QEMU_INPUT_CONSOLE_NONE)) {
+                g_free(item);
+                goto malformed;
+            }
+            identity.head = qemu_get_be32(file);
+            if (!qemu_input_queue_read_string(file, identity.device_path,
+                                              true)) {
+                g_free(item);
+                goto malformed;
+            }
+            item->evt.type = qemu_get_be32(file);
+            item->evt.key.key = qemu_get_be32(file);
+            down = qemu_get_byte(file);
+            item->evt.key.down = down;
+            if (item->evt.type != INPUT_EVENT_KIND_KEY ||
+                !item->evt.key.key || down > 1 ||
+                !qemu_input_console_resolve(&identity, &item->src,
+                                            &local_err)) {
+                qemu_input_queue_item_free(item);
+                goto malformed;
+            }
+            expect_sync = true;
+            break;
+        }
+        case QEMU_INPUT_QUEUE_SYNC:
+            if (!expect_sync) {
+                g_free(item);
+                goto malformed;
+            }
+            expect_sync = false;
+            break;
+        default:
+            g_free(item);
+            goto malformed;
+        }
+
+        QTAILQ_INSERT_TAIL(&loaded_queue, item, node);
+    }
+
+    if (qemu_file_get_error(file) || expect_sync ||
+        (count && QTAILQ_FIRST(&loaded_queue)->type !=
+                  QEMU_INPUT_QUEUE_DELAY)) {
+        goto malformed;
+    }
+    qemu_input_queue_clear();
+    while ((item = QTAILQ_FIRST(&loaded_queue))) {
+        QTAILQ_REMOVE(&loaded_queue, item, node);
+        QTAILQ_INSERT_TAIL(&kbd_queue, item, node);
+    }
+    queue_count = count;
+    if (pending &&
+        !timer_mod_ns_phase(qemu_input_queue_timer(), deadline_ns, phase_ps)) {
+        qemu_input_queue_clear();
+        error_setg(&local_err, "keyboard delay cannot be restored");
+        goto malformed;
+    }
+    kbd_queue_loaded = true;
+    return 0;
+
+malformed:
+    qemu_input_queue_temp_clear(&loaded_queue);
+    if (local_err) {
+        error_report_err(local_err);
+    }
+    return -EINVAL;
+}
+
+static int qemu_input_queue_load_setup(QEMUFile *file, void *opaque,
+                                       Error **errp)
+{
+    qemu_input_queue_clear();
+    kbd_queue_loaded = false;
+    return 0;
+}
+
+static int qemu_input_queue_save_prepare(void *opaque, Error **errp)
+{
+    uint16_t phase_ps;
+    int64_t deadline_ns;
+
+    return qemu_input_queue_validate(&deadline_ns, &phase_ps, errp) ? 0 :
+                                                                    -EINVAL;
+}
+
+static void qemu_input_queue_save(QEMUFile *file, void *opaque)
+{
+    Error *local_err = NULL;
+
+    if (!qemu_input_queue_write(file, &local_err)) {
+        qemu_file_set_error_obj(file, -EINVAL, local_err);
+    }
+}
+
+static bool qemu_input_queue_fingerprint(QEMUFile *file, const void *opaque,
+                                         Error **errp)
+{
+    return qemu_input_queue_write(file, errp);
+}
+
+static const CrucibleFingerprintProjection qemu_input_queue_projection = {
+    .schema = "crucible.qemu.ui-input-queue.v1",
+    .version = 1,
+    .save = qemu_input_queue_fingerprint,
+};
+
+static const SaveVMHandlers qemu_input_queue_vmstate = {
+    .save_prepare = qemu_input_queue_save_prepare,
+    .save_state = qemu_input_queue_save,
+    .load_setup = qemu_input_queue_load_setup,
+    .load_state = qemu_input_queue_load,
+    .crucible_fingerprint_projection = &qemu_input_queue_projection,
+};
+
+static void qemu_input_queue_reset(void *opaque)
+{
+    qemu_input_queue_clear();
+    kbd_queue_loaded = false;
+}
+
+static void qemu_input_queue_machine_done(Notifier *notifier, void *opaque)
+{
+    (void)notifier;
+    (void)opaque;
+
+    if (!icount_crucible_sim_mode()) {
+        return;
+    }
+
+    register_savevm_live("ui-input-queue", 0,
+                         QEMU_INPUT_QUEUE_VMSTATE_VERSION,
+                         &qemu_input_queue_vmstate, NULL);
+}
+
+static Notifier qemu_input_queue_machine_done_notifier = {
+    .notify = qemu_input_queue_machine_done,
+};
+
+static void qemu_input_queue_migration_init(void)
+{
+    qemu_add_machine_init_done_notifier(&qemu_input_queue_machine_done_notifier);
+    qemu_register_reset(qemu_input_queue_reset, NULL);
+}
+
+migration_init(qemu_input_queue_migration_init);
 
