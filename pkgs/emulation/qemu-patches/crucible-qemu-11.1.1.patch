                                       size_t unused, Error **errp)
 {
+    QapiDeallocVisitor *dv = to_qdv(v);
+
+    if (dv->source) {
+        QemuCrucibleQmpAllocationOwner *owner;
+        size_t extent;
+        int status;
+
+        if (!dealloc_source_current(&dv->visitor)) {
+            return false;
