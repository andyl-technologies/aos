+int qemu_crucible_quantum_cpu_rr_current_v1(CPUState *cpu)
+{
+    QemuCrucibleQuantumCpuExecution *execution = &cpu->crucible_quantum_execution;
+
+    return execution->retained && execution->cpu == cpu &&
+        execution->holder && *execution->holder == execution &&
+        execution->process == getpid() && execution->serial &&
+        qemu_thread_is_self(&execution->thread) && !execution->rr_returned ?
+        0 : -ESTALE;
+}
+
+static int rr_quantum_cpu_acquire(CPUState *cpu,
+                                 QemuCrucibleQuantumCpuExecution **holder)
+{
+    QemuCrucibleQuantumCpuExecution *execution = &cpu->crucible_quantum_execution;
+    uint64_t serial = execution->serial;
+
+    if (!bql_locked() || !holder || *holder || execution->retained) {
+        return -EBUSY;
+    }
+    if (serial == UINT64_MAX) {
+        return -EOVERFLOW;
+    }
+    object_ref(OBJECT(cpu));
+    *execution = (QemuCrucibleQuantumCpuExecution) {
+        .cpu = cpu, .holder = holder, .process = getpid(),
+        .serial = serial + 1, .retained = true,
+    };
+    qemu_thread_get_self(&execution->thread);
+    *holder = execution;
+
+    if (qatomic_load_acquire(&qemu_crucible_selected_process_id)) {
+#if defined(CONFIG_PLUGIN) && defined(CONFIG_LINUX)
+        return qemu_crucible_source_quantum_cpu_admit_v1(cpu);
+#else
+        return -ENOTSUP;
+#endif
+    }
+    /* Ordinary RR retains factual QOM custody, with no operation child. */
+    return 0;
+}
+
+void qemu_crucible_quantum_cpu_execution_start_v1(CPUState *cpu)
+{
+    QemuCrucibleQuantumCpuExecution *execution = &cpu->crucible_quantum_execution;
+
+    if (!execution->retained) {
+        return;
+    }
+    g_assert(!qemu_crucible_quantum_cpu_rr_current_v1(cpu));
+    g_assert(!execution->execution_started && !execution->execution_ended);
+    /* Starting the physical executor cannot restore revoked permission. */
+    execution->execution_started = true;
+}
+
+void qemu_crucible_quantum_cpu_execution_revoke_v1(CPUState *cpu)
+{
+    QemuCrucibleQuantumCpuExecution *execution = &cpu->crucible_quantum_execution;
+
+    if (!execution->retained) {
+        return;
+    }
+    g_assert(!qemu_crucible_quantum_cpu_rr_current_v1(cpu));
+    execution->permission_revoked = true;
+    /* Revocation alone returns neither the executor nor any physical child. */
+}
+
+void qemu_crucible_quantum_cpu_execution_end_v1(CPUState *cpu)
+{
+    QemuCrucibleQuantumCpuExecution *execution = &cpu->crucible_quantum_execution;
+
+    if (!execution->retained) {
+        return;
+    }
+    g_assert(!qemu_crucible_quantum_cpu_rr_current_v1(cpu));
+    g_assert(execution->execution_started && !execution->execution_ended);
+    g_assert(execution->permission_revoked);
+    execution->execution_ended = true;
+}
+
+void qemu_crucible_quantum_cpu_cleanup_v1(CPUState *cpu)
+{
+    QemuCrucibleQuantumCpuExecution *execution = &cpu->crucible_quantum_execution;
+
+    if (!execution->retained) {
+        return;
+    }
+    g_assert(!qemu_crucible_quantum_cpu_rr_current_v1(cpu));
+    g_assert(execution->permission_revoked);
+    execution->cleanup_completed = true;
+    /* cpu_exec_setjmp separately decides whether continuation is permitted.
+     * Cleanup alone cannot certify cpu_exec_end or return a physical child. */
+}
+
+static void rr_quantum_cpu_return(CPUState *cpu,
+                                 QemuCrucibleQuantumCpuExecution **holder)
+{
+    QemuCrucibleQuantumCpuExecution *execution = &cpu->crucible_quantum_execution;
+
+    g_assert(bql_locked());
+    g_assert(!qemu_crucible_quantum_cpu_rr_current_v1(cpu));
+    g_assert(execution->holder == holder);
+    g_assert(!execution->execution_started || execution->execution_ended);
+    /* A real Source child must physically return before its QOM custodian.
+     * There is deliberately no issuer/return bypass for such a child here. */
+    g_assert(!execution->child);
+    execution->permission_revoked = true;
+    execution->rr_returned = true;
+    execution->retained = false;
+    execution->holder = NULL;
+    execution->allocation = NULL;
+    execution->receipt = NULL;
+    execution->allocation_generation = 0;
+    *holder = NULL;
+    object_unref(OBJECT(cpu));
+}
