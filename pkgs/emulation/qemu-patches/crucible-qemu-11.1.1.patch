+++ b/tests/unit/crucible-fault-node-event-fixture.inc.h
@@ -0,0 +1,47 @@
+/*
+ * Round-trip the actual produced NODE_HANG ARM event through its VMState codec.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+static void live_node_event_roundtrip(void)
+{
+    CrucibleNodeEvent *actual = QTAILQ_FIRST(&crucible_node_events);
+    CrucibleNodeEvent decoded = { 0 };
+    g_autoptr(GByteArray) encoded = g_byte_array_new();
+    QemuCrucibleFaultVmstateReader reader;
+    GError *error = NULL;
+
+    assert(actual && actual->event.command_kind == CRUCIBLE_FAULT_COMMAND_NODE_HANG);
+    assert(actual->event.model_phase == QEMU_CRUCIBLE_MODEL_PHASE_ARM);
+
+    crucible_node_vmstate_put_event(encoded, actual);
+    assert(g_file_set_contents("node-event-stream.bin", (char *)encoded->data,
+                               encoded->len, &error));
+    assert(!error);
+    reader = (QemuCrucibleFaultVmstateReader) {
+        .data = encoded->data, .length = encoded->len,
+    };
+    assert(crucible_node_vmstate_get_event(&reader, &decoded));
+    assert(qemu_crucible_fault_vmstate_reader_finished(&reader));
+    assert(decoded.event.command_kind == actual->event.command_kind);
+    assert(decoded.event.model_phase == actual->event.model_phase);
+    assert(decoded.event.event_sequence == actual->event.event_sequence);
+    assert(decoded.event.rule_command_sequence == actual->event.rule_command_sequence);
+    assert(decoded.payload_length == actual->payload_length);
+    assert(!memcmp(node_event_bytes(&decoded), node_event_bytes(actual),
+                   actual->payload_length));
+    assert(!crucible_node_vmstate_event_phase_valid(
+        CRUCIBLE_FAULT_COMMAND_NODE_HANG, 0));
+    assert(!crucible_node_vmstate_event_phase_valid(
+        CRUCIBLE_FAULT_COMMAND_NODE_HANG, 37));
+    assert(!crucible_node_vmstate_event_phase_valid(
+        CRUCIBLE_FAULT_COMMAND_NODE_HANG, UINT16_MAX));
+    assert(!crucible_node_vmstate_event_phase_valid(
+        CRUCIBLE_FAULT_COMMAND_NODE_HANG, CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY));
+    assert(!crucible_node_vmstate_event_phase_valid(
+        CRUCIBLE_FAULT_COMMAND_NODE_LIFECYCLE, QEMU_CRUCIBLE_MODEL_PHASE_ARM));
+    assert(crucible_node_vmstate_event_phase_valid(
+        CRUCIBLE_FAULT_COMMAND_NODE_LIFECYCLE, CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY));
+
+    g_clear_pointer(&decoded.payload, g_byte_array_unref);
+    puts("PASS actual unconsumed NODE_HANG ARM event VMState round-trip");
+}
