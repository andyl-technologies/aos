+    if (!qcrypto_sha256_storage(hash) || !hash->active ||
+        hash->bytes > UINT64_MAX / 8 ||
+        digest_len != QCRYPTO_HASH_DIGEST_LEN_SHA256 ||
+        !qcrypto_sha256_disjoint(hash, digest, digest_len)) {
+        return -EINVAL;
+    }
+    buffered = hash->bytes % sizeof(hash->block);
+    hash->block[buffered++] = 0x80;
+    if (buffered > 56) {
+        memset(hash->block + buffered, 0, sizeof(hash->block) - buffered);
+        qcrypto_sha256_compress(hash, hash->block);
+        buffered = 0;
+    }
