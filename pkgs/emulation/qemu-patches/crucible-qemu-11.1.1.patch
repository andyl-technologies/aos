+    state->base_rtc = 951782400;
+    state->cmos_data[RTC_REG_A] = 0x26;
+    state->cmos_data[RTC_REG_B] = REG_B_PIE | REG_B_24H;
+    state->periodic_timer = timer_new_ns(rtc_clock, timer_consumer, state);
+    state->update_timer = timer_new_ns(rtc_clock, timer_consumer, state);
+    state->coalesced_timer = timer_new_ns(rtc_clock, timer_consumer, state);
+    state->lost_tick_policy = LOST_TICK_POLICY_SLEW;
+}
