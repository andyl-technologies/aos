+int qemu_plugin_crucible_selectable_reset_call(
+    uint32_t action,
+    const struct qemu_plugin_crucible_selectable_reset_request *request)
+{
+    qemu_plugin_crucible_selectable_reset_cb_t callback;
+    void *userdata;
+    int status;
+
+    if (!bql_locked() || !request ||
+        action < QEMU_PLUGIN_CRUCIBLE_SELECTABLE_RESET_PREPARE ||
+        action > QEMU_PLUGIN_CRUCIBLE_SELECTABLE_RESET_COMMIT) {
+        return -EINVAL;
+    }
+    qemu_mutex_lock(&qemu_plugin_crucible_barrier_operation_lock);
+    qemu_mutex_lock(&qemu_plugin_crucible_resource_lock);
+    callback = qemu_plugin_crucible_selectable_reset_cb;
+    userdata = qemu_plugin_crucible_selectable_reset_userdata;
+    if (!callback) {
+        qemu_mutex_unlock(&qemu_plugin_crucible_resource_lock);
+        qemu_mutex_unlock(&qemu_plugin_crucible_barrier_operation_lock);
+        return -ENOSYS;
+    }
+    /* Claim before calling loaded code; even a panic-result retains custody. */
+    if (action == QEMU_PLUGIN_CRUCIBLE_SELECTABLE_RESET_PREPARE) {
+        if (qemu_plugin_crucible_selectable_reset_busy) {
+            qemu_mutex_unlock(&qemu_plugin_crucible_resource_lock);
+            qemu_mutex_unlock(&qemu_plugin_crucible_barrier_operation_lock);
+            return -EBUSY;
+        }
+        qemu_plugin_crucible_selectable_reset_busy = true;
+    } else if (!qemu_plugin_crucible_selectable_reset_busy) {
+        qemu_mutex_unlock(&qemu_plugin_crucible_resource_lock);
+        qemu_mutex_unlock(&qemu_plugin_crucible_barrier_operation_lock);
+        return -ESTALE;
+    }
+    qemu_mutex_unlock(&qemu_plugin_crucible_resource_lock);
+
+    QemuCrucibleNativeInvocationTicket native =
+        qemu_plugin_crucible_native_mask_v1(&callback, callback, userdata);
+
+    status = callback(action, request, userdata);
+    qemu_plugin_crucible_native_exit_v1(native);
+    if (status > 0) {
+        status = -EPROTO;
+    }
+    if (!status && action == QEMU_PLUGIN_CRUCIBLE_SELECTABLE_RESET_COMMIT) {
+        qemu_mutex_lock(&qemu_plugin_crucible_resource_lock);
+        qemu_plugin_crucible_selectable_reset_busy = false;
+        qemu_mutex_unlock(&qemu_plugin_crucible_resource_lock);
+    }
+    qemu_mutex_unlock(&qemu_plugin_crucible_barrier_operation_lock);
+    return status;
+}
+
+int qemu_plugin_crucible_selectable_reset_unregister(qemu_plugin_id_t plugin_id)
+{
+    int status = 0;
+
+    /* Serialize removal with every use of the loaded callback address. */
+    qemu_mutex_lock(&qemu_plugin_crucible_barrier_operation_lock);
+    qemu_mutex_lock(&qemu_plugin_crucible_resource_lock);
+    /* Recheck after any wait, before removing a retained loaded callback. */
+    if (plugin_startup_source_retains_id(plugin_id)) {
+        status = -EPERM;
+    } else if (qemu_plugin_crucible_selectable_reset_owner == plugin_id) {
+        if (qemu_plugin_crucible_selectable_reset_busy) {
+            status = -EBUSY;
+        } else {
+            qemu_plugin_crucible_selectable_reset_owner = 0;
+            qemu_plugin_crucible_selectable_reset_cb = NULL;
+            qemu_plugin_crucible_selectable_reset_userdata = NULL;
+        }
+    }
+    qemu_mutex_unlock(&qemu_plugin_crucible_resource_lock);
+    qemu_mutex_unlock(&qemu_plugin_crucible_barrier_operation_lock);
+    return status;
+}
