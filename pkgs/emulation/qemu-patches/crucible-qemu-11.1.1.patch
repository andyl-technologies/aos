+        &foreign.registration.holder) == -EPERM);
+    assert(foreign.registration.holder == &foreign.registration);
+    memset(&observed, 0xa5, sizeof(observed));
+    saved = observed;
+    assert(qemu_crucible_fault_registration_observe_v1(
+        &foreign.registration, &foreign.registration.holder, &observed) == -EPERM);
+    assert(!memcmp(&observed, &saved, sizeof(saved)));
+    assert(qemu_crucible_fault_register_node_owned_v1(
+        &foreign.registration, &foreign.registration.holder) == -EPERM);
+    /* This component creates no QEMU threads or RCU readers. Keep the actual
+     * provider mutex locked across fork: the copied process must refuse before
+     * touching that inherited mutex, without any synthetic issuer. */
+    g_mutex_lock(&crucible_fault_lock);
+    g_mutex_lock(&crucible_node_registrations.lock);
+    g_mutex_lock(&crucible_fault_pending_custody.lock);
+    pid_t child = fork();
