+static void scenario_control_healthy(void)
+{
+    QemuCrucibleMetadataAdmission charge = { 0 };
+    uint64_t output = UINT64_MAX;
+    uint64_t expected = 960;
+    uint64_t rust_output = UINT64_MAX;
+
+    fixture_prepare(0, false);
+    g_assert_cmpint(fixture_acquire(), ==, 0);
+    fixture_control_purpose();
+    g_assert_cmpint(qemu_crucible_startup_source_reserve_control_metadata_v1(
+        fixture.ctx.id, control_requests, &output), ==, 0);
+    g_assert_cmpuint(output, ==, expected);
+    g_assert_cmpuint(startup_source.metadata_partition.fixed_native_extent,
+                    ==, qemu_crucible_startup_source_fixed_control_extent());
+    g_assert_cmpuint(startup_source.metadata_partition.native_extent + output,
+                    ==, fixture.total);
+    g_assert_cmpint(qemu_crucible_startup_source_native_metadata_admit(
+        32, &charge), ==, 0);
+    g_assert_true(charge.charge.held);
+    g_assert_cmpuint(startup_source.metadata_partition.native_live, ==, 32);
+    /* The report remains N. A grant excludes D once; the ordinary same-epoch
+     * repeat refuses and does not refill this still-held allocation charge. */
+    admission_grant_open = true;
+    admission_grant_owner = qemu_get_thread_id();
+    admission.topology_generation = topology_generation;
+    /* This modeled report includes the actual fixed declarations and live
+     * request. It observes the ledger; it does not create an issuer. */
+    admission.native_metadata_bytes =
+        qemu_crucible_startup_source_fixed_control_extent() + 32;
+    g_assert_cmpint(qemu_plugin_crucible_ram_admission_grant_v1(
+        topology_generation, fixture.total, &rust_output), ==, 0);
+    g_assert_cmpuint(rust_output, ==,
+        fixture.total - qemu_crucible_startup_source_fixed_control_extent() -
+        32 - expected);
+    rust_output = UINT64_MAX;
+    g_assert_cmpint(qemu_plugin_crucible_ram_admission_grant_v1(
+        topology_generation, fixture.total, &rust_output), ==, -EPERM);
+    g_assert_cmpuint(rust_output, ==, UINT64_MAX);
+    g_assert_cmpint(qemu_plugin_crucible_ram_set_metadata_budget_v1(
+        fixture.total), ==, 0);
+    g_assert_cmpuint(startup_source.metadata_partition.native_live, ==, 32);
+    g_assert_cmpuint(startup_source.metadata_partition.controller_extent,
+                    ==, expected);
+    fixture_ledger_component_retire(&charge.charge);
+    g_assert_false(charge.charge.held);
+    g_assert_cmpuint(startup_source.metadata_partition.native_live, ==, 0);
+    g_assert_cmpint(qemu_plugin_crucible_startup_source_registration_complete_v1(
+        fixture.ctx.id, 0), ==, 0);
+    g_assert_cmpuint(startup_source.metadata_partition.controller_extent,
+                    ==, expected);
+    output = UINT64_MAX;
+    g_assert_cmpint(qemu_crucible_startup_source_reserve_control_metadata_v1(
+        fixture.ctx.id, control_requests, &output), ==, -EALREADY);
+    g_assert_cmpuint(output, ==, UINT64_MAX);
+    g_assert_cmpuint(startup_source.metadata_partition.controller_extent,
+                    ==, expected);
+    assert_retained();
+}
