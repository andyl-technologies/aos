+/* Physical allocation retirement waits for every real child, independently of
+ * operation status and of any callback-return observation. */
+static bool cpu_allocation_children_held(
+    const QemuCrucibleCpuSourceAllocationOwner *owner)
+{
+    return owner->tlb_children || owner->constructor_children ||
+        owner->getter_children || owner->getter.held ||
+        owner->clock_children || owner->clock.held || owner->clock.callback.held ||
+        owner->register_workspace || owner->register_workspace_parent ||
+        owner->initial.held || owner->initial.child_held ||
+        owner->initial.child_return_in_flight || owner->initial.return_in_flight;
+}
+
+static int cpu_allocation_return_locked(
+    QemuCrucibleCpuSourceAllocationOwner **out)
+{
+    QemuCrucibleCpuSourceAllocationOwner **link;
+    QemuCrucibleCpuSourceAllocationOwner *owner;
+    int status = cpu_allocation_identity_locked(*out);
+
+    if (!status) {
+        status = cpu_allocation_pending_retire_locked();
+    }
+    if (!status) {
+        status = qemu_crucible_cpu_allocation_returned_current_v1(*out);
+    }
+    if (status) {
+        return status;
+    }
+    owner = *out;
+    if (!owner->receipt || cpu_allocation_children_held(owner)) {
+        return -EBUSY;
+    }
+    status = qemu_crucible_cpu_allocation_receipt_identity_return_v1(&owner->receipt);
+    if (status || owner->receipt) {
+        return status ? status : -EBUSY;
+    }
+    for (link = &startup_source.cpu_allocations.owners; *link != owner;
+         link = &(*link)->next) {
+        /* Membership was authenticated while this same registry lock held. */
+    }
+    *link = owner->next;
+    startup_source.cpu_allocations.pending_charge = owner->charge;
+    g_free(owner);
+    *out = NULL;
+    startup_source.cpu_allocations.pending_physical_return = true;
+    return cpu_allocation_pending_retire_locked();
+}
+
+int qemu_crucible_startup_source_cpu_allocation_identity_return_v1(
+    QemuCrucibleCpuSourceAllocationOwner **out)
+{
+    int status;
+
+    if (!out || !*out ||
+        !qemu_thread_is_self(&startup_source.standing.construction.operation.thread)) {
+        return -EPERM;
+    }
+    status = pthread_mutex_trylock(&startup_source.cpu_allocations.lock);
+    if (status) {
+        return -status;
+    }
+    status = cpu_allocation_return_locked(out);
+    pthread_mutex_unlock(&startup_source.cpu_allocations.lock);
+    return status;
+}
