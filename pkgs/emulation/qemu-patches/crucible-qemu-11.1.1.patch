+#ifdef CONFIG_PLUGIN
+static int crucible_checkpoint_inventory_poll(
+    QemuCrucibleCheckpointInventoryLoan *inventory, int fd, Error **errp)
+{
+    struct pollfd cancellation = { .fd = fd, .events = POLLIN };
+    uint64_t slice;
+    int status;
+
+    for (;;) {
+        int current = qemu_crucible_checkpoint_inventory_current_v1(inventory,
+                                                                    &slice);
+
+        if (current) {
+            return current;
+        }
+        status = poll(&cancellation, 1, 0);
+        if (status >= 0 || errno != EINTR) {
+            break;
+        }
+    }
+    if (status < 0) {
+        int failure = errno;
+
+        error_setg_errno(errp, failure,
+                         "Could not poll RAM topology cancellation");
+        return -failure;
+    }
+    if (!status) {
+        return 0;
+    }
+    if (cancellation.revents & POLLIN) {
+        error_setg(errp, "RAM topology preparation was cancelled");
+        return -ECANCELED;
+    }
+    error_setg(errp, "RAM topology cancellation descriptor failed");
+    return -EIO;
+}
+
+static int crucible_checkpoint_inventory_write(
+    QemuCrucibleCheckpointInventoryLoan *inventory,
+    CrucibleCheckpointWriter *writer, const void *bytes, size_t length,
+    Error **errp)
+{
+    const uint8_t *cursor = bytes;
+    uint64_t slice;
+
+    if (length > writer->maximum_bytes - writer->written) {
+        error_setg(errp, "RAM topology record exceeds its maximum byte count");
+        return -EFBIG;
+    }
+    while (length) {
+        ssize_t written;
+        int status = crucible_checkpoint_inventory_poll(
+            inventory, writer->cancellation_fd, errp);
+
+        if (!status) {
+            status = qemu_crucible_checkpoint_inventory_current_v1(inventory,
+                                                                   &slice);
+        }
+        if (status) {
+            return status;
+        }
+        written = write(writer->fd, cursor, length);
+        if (written < 0 && errno == EINTR) {
+            /* Reobserve the same Original before retrying the unchanged slice. */
+            continue;
+        }
+        if (written <= 0) {
+            int failure = written == 0 ? EIO : errno;
+
+            error_setg_errno(errp, failure, "Could not write RAM topology record");
+            return -failure;
+        }
+        cursor += written;
+        length -= written;
+        writer->written += written;
+
+        /* Journal real progress before any independent trailing refusal. */
+        status = qemu_crucible_checkpoint_inventory_current_v1(inventory, &slice);
+        if (status) {
+            return status;
+        }
+    }
+    return 0;
+}
+#endif
+
+CrucibleCheckpointTopology *qemu_crucible_checkpoint_prepare_topology(
+    QemuCrucibleCheckpointInventoryLoan **inventory_owner,
+    const char *checkpoint_sha256, const char *target_sha256,
+    const char *frontier_sha256, int *semantic_status, Error **errp)
+{
+#ifdef CONFIG_PLUGIN
+    QemuCrucibleCheckpointInventoryLoan *inventory;
+    QemuCrucibleRamInventoryCaptureLoan *capture = NULL;
+    QemuCrucibleQmpAllocationOwner *allocation_owner = NULL;
+    struct qemu_plugin_crucible_ram_capture_v1 header = { 0 };
+    CrucibleCheckpointTopology *report = NULL;
+    CrucibleCheckpointWriter writer = {
+        .fd = -1,
+        .cancellation_fd = -1,
+        .maximum_bytes = CRUCIBLE_CHECKPOINT_ROOT_MAX_BYTES,
+    };
+    void *payload = NULL;
+    uint8_t root[32], copied_root[32], topology[32];
+    uint8_t checkpoint[32], target[32], frontier[32];
+    uint64_t logical_bytes, slice;
+    size_t length = 0, copied = 0;
+    struct stat metadata;
+    bool boundary_entered = false;
+    int status = -EINVAL;
+    int cleanup_status = 0;
+    int post, returned;
+
+    topology_receipt_active = 0;
+    if (semantic_status) {
+        *semantic_status = status;
+    }
+    if (!semantic_status || !inventory_owner || !*inventory_owner) {
+        error_setg(errp, "Checkpoint topology requires its retained inventory");
+        return NULL;
+    }
+    inventory = *inventory_owner;
+    status = qemu_crucible_checkpoint_inventory_current_v1(inventory, &slice);
+    if (status) {
+        goto out;
+    }
+    status = -EINVAL;
+    if (!crucible_checkpoint_exact_paused_boundary() ||
+        crucible_checkpoint_authority.candidate_active ||
+        topology_receipt_generation == UINT64_MAX ||
+        !crucible_checkpoint_identity(checkpoint_sha256, checkpoint, errp) ||
+        !crucible_checkpoint_identity(target_sha256, target, errp) ||
+        !crucible_checkpoint_identity(frontier_sha256, frontier, errp)) {
+        if (!*errp) {
+            error_setg(errp, "RAM topology preparation requires an unused "
+                       "paused exact checkpoint boundary");
+        }
+        goto out;
+    }
+    status = qemu_crucible_checkpoint_inventory_output_current_v1(inventory,
+                                                                 &writer.fd);
+    if (!status) {
+        status = qemu_crucible_checkpoint_inventory_cancellation_current_v1(
+            inventory, &writer.cancellation_fd);
+    }
+    if (status || !crucible_checkpoint_output_file(writer.fd,
+                                                  "RAM topology record",
+                                                  &metadata, errp)) {
+        status = status ? status : -EINVAL;
+        goto out;
+    }
+
+    qemu_plugin_crucible_exact_boundary_enter();
+    boundary_entered = true;
+    status = qemu_crucible_checkpoint_inventory_cached_root_v1(
+        inventory, 1, root, &logical_bytes);
+    if (!status) {
+        status = qemu_crucible_checkpoint_inventory_root_record_v1(
+            inventory, 1, NULL, 0, &length, copied_root);
+    }
+    if (status || !length || length > CRUCIBLE_CHECKPOINT_ROOT_MAX_BYTES ||
+        memcmp(root, copied_root, 32)) {
+        error_setg(errp, "Could not measure bounded RAM topology record (%d)",
+                   status);
+        status = status ? status : -EINVAL;
+        goto out;
+    }
+
+    /* This pays physical QMP storage only. The retained inventory separately
+     * qualifies every metadata operation and the native region pin below. */
+    status = qemu_crucible_qmp_scope_current(&allocation_owner);
+    if (!status) {
+        status = qemu_crucible_qmp_allocate(allocation_owner, length, false,
+                                            &payload);
+    }
+    if (status || !payload) {
+        error_setg(errp, "Could not reserve RAM topology metadata (%d)", status);
+        status = status ? status : -ENOMEM;
+        goto out;
+    }
+    status = qemu_crucible_checkpoint_inventory_root_record_v1(
+        inventory, 1, payload, length, &copied, copied_root);
+    if (status || copied != length || memcmp(root, copied_root, 32)) {
+        error_setg(errp, "RAM topology record changed during preparation");
+        status = status ? status : -ESTALE;
+        goto out;
+    }
+
+    status = qemu_crucible_ram_inventory_capture_begin_v1(inventory, &capture,
+                                                         &header);
+    if (status) {
+        error_setg_errno(errp, -status,
+                         "Could not fence RAM topology inventory");
+        goto out;
+    }
+    status = qemu_crucible_ram_inventory_capture_topology_v1(capture, topology);
+    if (!status) {
+        status = qemu_crucible_checkpoint_inventory_current_v1(inventory, &slice);
+    }
+    if (status || !header.topology_generation ||
+        !crucible_checkpoint_prepare_output_file(writer.fd,
+                                                 "RAM topology record", errp)) {
+        if (!*errp) {
+            error_setg(errp, "RAM topology inventory changed during preparation");
+        }
+        status = status ? status : -EIO;
+        goto out;
+    }
+    status = crucible_checkpoint_inventory_write(inventory, &writer, payload,
+                                                 length, errp);
+    if (status) {
+        goto out;
+    }
+
+    topology_receipt_inventory = header.topology_generation;
+    topology_receipt_owner = getpid();
+    memcpy(topology_receipt_checkpoint, checkpoint, 32);
+    memcpy(topology_receipt_target, target, 32);
+    memcpy(topology_receipt_frontier, frontier, 32);
+    topology_receipt_active = ++topology_receipt_generation;
+    if (!crucible_checkpoint_vmstate_handler) {
+        crucible_checkpoint_vmstate_handler = qemu_add_vm_change_state_handler(
+            crucible_checkpoint_vmstate_changed, NULL);
+    }
+    report = g_new0(CrucibleCheckpointTopology, 1);
+    report->schema_version = CRUCIBLE_CHECKPOINT_SCHEMA_VERSION;
+    report->topology_admission_generation = topology_receipt_active;
+    report->root_bytes = length;
+    report->ram_root_blake3 = g_malloc(65);
+    report->topology_blake3 = g_malloc(65);
+    for (size_t index = 0; index < 32; index++) {
+        snprintf(report->ram_root_blake3 + 2 * index, 3, "%02x", root[index]);
+        snprintf(report->topology_blake3 + 2 * index, 3, "%02x", topology[index]);
+    }
+
+out:
+    if (payload) {
+        cleanup_status = qemu_crucible_qmp_free(&payload);
+        /* A failed physical return leaves the block in the actual QMP owner's
+         * registry. After free, Source retains its separate debit journal. */
+    }
+    returned = qemu_crucible_checkpoint_inventory_output_close_v1(inventory);
+    if (!cleanup_status) {
+        cleanup_status = returned;
+    }
+    /* Keep capture and inventory custody through the independent post. Return
+     * failures are distinct from the interpretation and Original post result. */
+    post = qemu_crucible_checkpoint_inventory_post_v1(
+        inventory, status ? status : cleanup_status);
+    if (!status) {
+        status = post;
+    }
+    if (capture) {
+        returned = qemu_crucible_ram_inventory_capture_end_v1(&capture);
+        if (!cleanup_status) {
+            cleanup_status = returned;
+        }
+    }
+    if (!capture) {
+        returned = qemu_crucible_checkpoint_inventory_end_v1(
+            inventory_owner, status ? status : cleanup_status);
+        if (!cleanup_status) {
+            cleanup_status = returned;
+        }
+    }
+    if (boundary_entered) {
+        qemu_plugin_crucible_exact_boundary_leave();
+    }
+    *semantic_status = status;
+    if (status || cleanup_status || capture || *inventory_owner) {
+        topology_receipt_active = 0;
+        qapi_free_CrucibleCheckpointTopology(report);
+        if (!*errp) {
+            int failure = status ? status : cleanup_status ? cleanup_status : -EBUSY;
+
+            error_setg_errno(errp, -failure,
+                             "RAM topology inventory did not complete");
+        }
+        return NULL;
+    }
+
+    return report;
+#else
+    if (semantic_status) {
+        *semantic_status = -ENOTSUP;
+    }
+    error_setg(errp, "Checkpoint topology requires plugin receiving support");
+    return NULL;
+#endif
+}
+
+CrucibleCheckpointCapture *qemu_crucible_checkpoint_capture(
+    bool initial_required,
+    uint64_t topology_admission_generation,
+    int ram_fd,
+    int device_fd,
+    int cancellation_fd,
+    const char *checkpoint_sha256,
+    const char *target_sha256,
+    const char *frontier_sha256,
+    bool has_parent_checkpoint_sha256,
+    const char *parent_checkpoint_sha256,
+    bool has_parent_target_sha256,
+    const char *parent_target_sha256,
+    bool has_parent_frontier_sha256,
+    const char *parent_frontier_sha256,
+    uint64_t maximum_ram_bytes,
+    uint64_t maximum_device_bytes,
+    Error **errp)
+{
+    uint8_t ram_root[32];
+    qemu_plugin_crucible_checkpoint_candidate_read_v1 *reader = NULL;
+    uint64_t capture_generation = 0;
+    uint64_t ram_regions = 0;
+    uint64_t ram_records = 0;
+    bool boundary_scope = false;
+    CrucibleCheckpointCapture *report = NULL;
+    CrucibleCheckpointWriter writer = {
+        .fd = ram_fd,
+        .cancellation_fd = cancellation_fd,
+        .maximum_bytes = maximum_ram_bytes,
+    };
+    uint8_t checkpoint_digest[32];
+    uint8_t target_digest[32];
+    uint8_t frontier_digest[32];
+    uint8_t device_digest[32];
+    struct stat ram_stat;
+    struct stat device_stat;
+    uint64_t device_bytes = 0;
+    uint64_t capture_dirty_generation;
+    bool parent_complete = has_parent_checkpoint_sha256 &&
+        has_parent_target_sha256 && has_parent_frontier_sha256;
+    bool parent_absent = !has_parent_checkpoint_sha256 &&
+        !has_parent_target_sha256 && !has_parent_frontier_sha256;
+    bool capture_reserved = false;
+    int status = -EINVAL;
+    int ram_close_status = 0;
+    int device_close_status = 0;
+    int cancellation_close_status = 0;
+#ifdef CONFIG_PLUGIN
+    QemuCrucibleCheckpointHeldTransaction *transaction = NULL;
+
+    status = qemu_crucible_checkpoint_candidate_begin_v1(cancellation_fd,
+                                                       &transaction);
+    if (status) {
+        error_setg_errno(errp, -status, "Checkpoint request is not capture-ready");
+        goto out;
+    }
+#else
+    error_setg(errp, "Checkpoint capture requires a receiving request");
+    goto out;
+#endif
+
+    if (!crucible_checkpoint_exact_paused_boundary()) {
+        error_setg(errp, "Crucible checkpoint capture requires the exact "
+                   "paused deterministic simulator boundary");
+        goto out;
+    }
+    if (crucible_checkpoint_authority.candidate_active) {
+        error_setg(errp, "A Crucible checkpoint candidate is already active");
+        goto out;
+    }
+    if (crucible_checkpoint_authority.epoch_generation == UINT64_MAX) {
+        error_setg(errp, "Crucible checkpoint epoch namespace is exhausted");
+        goto out;
+    }
+    if (maximum_ram_bytes == 0 || maximum_device_bytes == 0 ||
+        maximum_ram_bytes > INT64_MAX || maximum_device_bytes > INT64_MAX) {
+        error_setg(errp, "Crucible checkpoint byte ceilings must be positive "
+                   "signed file offsets");
+        goto out;
+    }
+    if (!crucible_checkpoint_identity(checkpoint_sha256, checkpoint_digest,
+                                      errp) ||
+        !crucible_checkpoint_identity(target_sha256, target_digest, errp) ||
+        !crucible_checkpoint_identity(frontier_sha256, frontier_digest,
+                                      errp)) {
+        goto out;
+    }
+    if (!topology_admission_generation ||
+        topology_admission_generation != topology_receipt_active ||
+        topology_receipt_owner != getpid() ||
+        memcmp(checkpoint_digest, topology_receipt_checkpoint, 32) ||
+        memcmp(target_digest, topology_receipt_target, 32) ||
+        memcmp(frontier_digest, topology_receipt_frontier, 32)) {
+        error_setg(errp, "RAM capture has no matching host-admitted topology");
+        goto out;
+    }
+    /* An acknowledgement is single-use even if later device pre-save fails. */
+    topology_receipt_active = 0;
+    if ((!parent_complete && !parent_absent) ||
+        parent_complete != crucible_checkpoint_authority.epoch_active ||
+        (!initial_required && !parent_complete)) {
+        error_setg(errp, "RAM page capture requires exact committed parent authority");
+        goto out;
+    }
+    if (parent_complete &&
+        (strcmp(parent_checkpoint_sha256,
+                crucible_checkpoint_authority.committed_checkpoint_sha256) ||
+         strcmp(parent_target_sha256,
+                crucible_checkpoint_authority.committed_target_sha256) ||
+         strcmp(parent_frontier_sha256,
+                crucible_checkpoint_authority.committed_frontier_sha256))) {
+        error_setg(errp, "RAM page capture parent does not match committed authority");
+        goto out;
+    }
+    if (!crucible_checkpoint_output_file(ram_fd, "RAM file", &ram_stat,
+                                         errp) ||
+        !crucible_checkpoint_output_file(device_fd, "device VMState file",
+                                         &device_stat, errp)) {
+        goto out;
+    }
+    if (ram_stat.st_dev == device_stat.st_dev &&
+        ram_stat.st_ino == device_stat.st_ino) {
+        error_setg(errp, "Crucible checkpoint output files must not alias");
+        goto out;
+    }
+
+    status = migration_crucible_checkpoint_capture_begin();
+    if (status != 0) {
+        error_setg_errno(errp, -status,
+                         "Crucible checkpoint state capture is unavailable");
+        goto out;
+    }
+    capture_reserved = true;
+    if (!(global_dirty_tracking & GLOBAL_DIRTY_CRUCIBLE_CHECKPOINT) &&
+        !memory_global_dirty_log_start(
+            GLOBAL_DIRTY_CRUCIBLE_CHECKPOINT, errp)) {
+        error_prepend(errp, "Could not start Crucible checkpoint dirty "
+                      "tracking: ");
+        goto out;
+    }
+    if (!crucible_checkpoint_prepare_output_file(
+            ram_fd, "RAM file", errp) ||
+        !crucible_checkpoint_prepare_output_file(
+            device_fd, "device VMState file", errp)) {
+        goto out;
+    }
+
+    /* qemu_save_device_state() has the same deterministic pre-save callbacks
+     * as QEMU's existing snapshot contract. Run them before RAM is measured
+     * and copied so any callback RAM effects are part of this candidate. */
+    status = crucible_checkpoint_save_device_state(
+        device_fd, cancellation_fd, maximum_device_bytes, &device_bytes,
+        device_digest, &device_close_status, errp);
+    device_fd = -1;
+    if (status != 0 || device_bytes == 0) {
+        if (status == 0) {
+            error_setg(errp, "Crucible checkpoint device VMState was empty");
+        }
+        goto out;
+    }
+#ifdef CONFIG_PLUGIN
+    status = qemu_crucible_checkpoint_candidate_ram_begin_v1(
+        transaction, topology_receipt_inventory);
+    if (status) {
+        error_setg_errno(errp, -status,
+                         "Checkpoint RAM collector or pager cut is not ready");
+        goto out;
+    }
+    status = qemu_crucible_checkpoint_candidate_read_begin_v1(transaction,
+                                                             &reader);
+    if (status) {
+        error_setg_errno(errp, -status,
+                         "Checkpoint held page reader is unavailable");
+        goto out;
+    }
+#endif
+    capture_dirty_generation =
+        qatomic_read(&crucible_checkpoint_dirty_generation);
+    qemu_plugin_crucible_exact_boundary_enter();
+    boundary_scope = true;
+    if (!crucible_checkpoint_write_paged_ram(
+            reader, &writer, initial_required, ram_root, &capture_generation,
+            &ram_regions, &ram_records, errp) ||
+        qatomic_read(&crucible_checkpoint_dirty_generation) !=
+            capture_dirty_generation) {
+        if (!*errp) {
+            error_setg(errp, "Logical RAM page versions changed during capture");
+        }
+        goto out;
+    }
+#ifdef CONFIG_PLUGIN
+    status = qemu_crucible_checkpoint_candidate_read_end_v1(&reader, 0);
+    if (status) {
+        error_setg_errno(errp, -status,
+                         "Checkpoint held page reader post failed");
+        goto out;
+    }
+#endif
+    if (fdatasync(ram_fd) < 0) {
+        error_setg_errno(errp, errno,
+                         "Could not synchronize Crucible checkpoint RAM");
+        goto out;
+    }
+
+    crucible_checkpoint_authority.candidate_active = true;
+#ifdef CONFIG_PLUGIN
+    crucible_checkpoint_authority.candidate_transaction = transaction;
+    crucible_checkpoint_authority.candidate_disposition = 0;
+#endif
+    crucible_checkpoint_authority.candidate_capture_generation =
+        capture_generation;
+    crucible_checkpoint_authority.candidate_checkpoint_sha256 =
+        g_strdup(checkpoint_sha256);
+    crucible_checkpoint_authority.candidate_target_sha256 =
+        g_strdup(target_sha256);
+    crucible_checkpoint_authority.candidate_frontier_sha256 =
+        g_strdup(frontier_sha256);
+    memcpy(crucible_checkpoint_authority.candidate_ram_root,
+           ram_root, sizeof(ram_root));
+    memcpy(crucible_checkpoint_authority.candidate_device_digest,
+           device_digest, sizeof(device_digest));
+    crucible_checkpoint_authority.candidate_dirty_generation =
+        capture_dirty_generation;
+    crucible_checkpoint_authority.candidate_maximum_device_bytes =
+        maximum_device_bytes;
+    if (!crucible_checkpoint_vmstate_handler) {
+        crucible_checkpoint_vmstate_handler = qemu_add_vm_change_state_handler(
+            crucible_checkpoint_vmstate_changed, NULL);
+    }
+
+    report = g_new0(CrucibleCheckpointCapture, 1);
+    report->schema_version = CRUCIBLE_CHECKPOINT_SCHEMA_VERSION;
+    report->initial_capture = initial_required;
+    report->capture_generation = capture_generation;
+    report->checkpoint_sha256 = g_strdup(checkpoint_sha256);
+    report->target_sha256 = g_strdup(target_sha256);
+    report->frontier_sha256 = g_strdup(frontier_sha256);
+    report->ram_root_blake3 = g_malloc(65);
+    for (size_t index = 0; index < 32; index++) {
+        snprintf(report->ram_root_blake3 + 2 * index, 3, "%02x", ram_root[index]);
+    }
+    report->ram_regions = ram_regions;
+    report->ram_records = ram_records;
+    report->ram_bytes = writer.written;
+    report->device_bytes = device_bytes;
+
+out:
+#ifdef CONFIG_PLUGIN
+    if (reader) {
+        int read_status = qemu_crucible_checkpoint_candidate_read_end_v1(
+            &reader, status < 0 ? status : -EIO);
+
+        if (!status) {
+            status = read_status;
+        }
+    }
+#endif
+    if (boundary_scope) {
+        qemu_plugin_crucible_exact_boundary_leave();
+    }
+    /* Every alias has one actual close attempt; uncertain close is retained
+     * in the nominal journal and never retried by its recycled fd number.
+     */
+    if (ram_fd >= 0 && close(ram_fd) < 0) {
+        ram_close_status = -errno;
+    }
+    if (device_fd >= 0 && close(device_fd) < 0) {
+        device_close_status = -errno;
+    }
+    if (cancellation_fd >= 0 && close(cancellation_fd) < 0) {
+        cancellation_close_status = -errno;
+    }
+#ifdef CONFIG_PLUGIN
+    qemu_crucible_checkpoint_candidate_alias_closed_v1(transaction, 0,
+                                                      ram_close_status);
+    qemu_crucible_checkpoint_candidate_alias_closed_v1(transaction, 1,
+                                                      device_close_status);
+    qemu_crucible_checkpoint_candidate_alias_closed_v1(transaction, 2,
+                                                      cancellation_close_status);
+    qemu_crucible_checkpoint_candidate_io_end_v1(
+        transaction, report ? 0 : status < 0 ? status : -EIO);
+#endif
+    /* Successful I/O is not terminal: the candidate keeps this real
+     * migration reservation until commit/abort/invalidation calls clear.
+     */
+    if (capture_reserved && !report) {
+        migration_crucible_checkpoint_capture_end();
+    }
+#ifdef CONFIG_PLUGIN
+    if (!report) {
+        qemu_crucible_checkpoint_candidate_end_v1(
+            transaction, QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PAGER_ABORT,
+            status < 0 ? status : -EIO);
+    }
+#endif
+    return report;
+}
+
+#ifdef CONFIG_PLUGIN
+static int crucible_checkpoint_measure_candidate_root(
+    QemuCrucibleCheckpointHeldTransaction *transaction,
+    uint8_t root[32], uint64_t *logical_bytes)
+{
+    QemuCrucibleCheckpointCandidateReadLoan *reader = NULL;
+    size_t required;
+    int status = qemu_crucible_checkpoint_candidate_read_begin_v1(transaction,
+                                                                &reader);
+
+    if (!status) {
+        status = qemu_crucible_checkpoint_candidate_root_v1(
+            reader, 1, 1, NULL, 0, &required, root, logical_bytes);
+    }
+    if (reader) {
+        int post = qemu_crucible_checkpoint_candidate_read_end_v1(&reader,
+                                                                 status);
+
+        if (!status) {
+            status = post;
+        }
+    }
+    return status;
+}
+#endif
+
+CrucibleCheckpointEpochState *qemu_crucible_checkpoint_commit(
+    const char *checkpoint_sha256,
+    const char *target_sha256,
+    const char *frontier_sha256,
+    uint64_t capture_generation,
+    Error **errp)
+{
+    uint8_t ram_root[32];
+    uint64_t logical_bytes;
+    Error *local_error = NULL;
+    uint8_t device_digest[32];
+    uint64_t device_bytes;
+    uint64_t validated_dirty_generation;
+    int status;
+
+    /*
+     * The successful capture that created the candidate still owns the
+     * migration/raw-state reservation. candidate_clear() releases it only
+     * after this validation and dirty-bitmap transition finish.
+     */
+    if (!crucible_checkpoint_exact_paused_boundary()) {
+        error_setg(errp, "Crucible checkpoint commit requires the exact paused "
+                   "deterministic simulator boundary");
+        return NULL;
+    }
+    if (crucible_checkpoint_authority.epoch_generation == UINT64_MAX) {
+        error_setg(errp, "Crucible checkpoint epoch namespace is exhausted");
+        return NULL;
+    }
+    if (capture_generation == 0 ||
+        capture_generation != crucible_checkpoint_authority.candidate_capture_generation ||
+        !crucible_checkpoint_candidate_matches(
+            checkpoint_sha256, target_sha256, frontier_sha256)) {
+        error_setg(errp, "Crucible checkpoint commit identity does not match "
+                   "the active candidate");
+        return NULL;
+    }
+    if (qatomic_read(&crucible_checkpoint_dirty_generation) !=
+        crucible_checkpoint_authority.candidate_dirty_generation) {
+        error_setg(errp, "Crucible checkpoint candidate became stale after a "
+                   "RAM write");
+        return NULL;
+    }
+    status = qemu_crucible_ram_diagnostic_failure();
+    if (status) {
+        error_setg_errno(errp, -status,
+                         "RAM diagnostic refused checkpoint commit");
+        return NULL;
+    }
+    status = crucible_checkpoint_save_device_state(
+        -1, -1,
+        crucible_checkpoint_authority.candidate_maximum_device_bytes,
+        &device_bytes, device_digest, NULL, errp);
+    if (status != 0 || device_bytes == 0) {
+        if (status == 0) {
+            error_setg(errp, "Crucible checkpoint validation VMState was "
+                       "empty");
+        }
+        return NULL;
+    }
+    if (memcmp(device_digest,
+               crucible_checkpoint_authority.candidate_device_digest,
+               sizeof(device_digest)) != 0 ||
+        qatomic_read(&crucible_checkpoint_dirty_generation) !=
+            crucible_checkpoint_authority.candidate_dirty_generation) {
+        error_setg(errp, "Crucible checkpoint candidate device or RAM state "
+                   "became stale");
+        return NULL;
+    }
+    qemu_plugin_crucible_exact_boundary_enter();
+#ifdef CONFIG_PLUGIN
+    status = crucible_checkpoint_measure_candidate_root(
+        crucible_checkpoint_authority.candidate_transaction, ram_root,
+        &logical_bytes);
+#else
+    status = -ENOTSUP;
+#endif
+    qemu_plugin_crucible_exact_boundary_leave();
+    if (status != 0 ||
+        memcmp(ram_root, crucible_checkpoint_authority.candidate_ram_root,
+               sizeof(ram_root)) != 0) {
+        error_setg(errp, "Checkpoint candidate logical RAM root became stale");
+        return NULL;
+    }
+    validated_dirty_generation =
+        crucible_checkpoint_authority.candidate_dirty_generation;
+    if (!crucible_checkpoint_authority.epoch_active &&
+        !memory_global_dirty_log_start(
+            GLOBAL_DIRTY_CRUCIBLE_CHECKPOINT, &local_error)) {
+        error_propagate_prepend(errp, local_error,
+                                "Could not start Crucible checkpoint dirty "
+                                "epoch: ");
+        return NULL;
+    }
+
+    /* QMP owns the BQL and the exact paused/device-flushed boundary across
+     * validation and clear. A violating RAM writer advances the generation;
+     * restore an all-dirty private bitmap before refusing the commit. */
+    qemu_ram_foreach_block(crucible_checkpoint_clear_private_dirty_block,
+                           NULL);
+    /* Pair prior candidate validation with the generation sample after clear. */
+    smp_mb();
+    if (qatomic_read(&crucible_checkpoint_dirty_generation) !=
+        validated_dirty_generation) {
+        qemu_ram_foreach_block(crucible_checkpoint_set_private_dirty_block,
+                               NULL);
+        error_setg(errp, "Crucible checkpoint candidate changed while its "
+                   "dirty epoch was advancing");
+        return NULL;
+    }
+    g_free(crucible_checkpoint_authority.committed_checkpoint_sha256);
+    g_free(crucible_checkpoint_authority.committed_target_sha256);
+    g_free(crucible_checkpoint_authority.committed_frontier_sha256);
+    crucible_checkpoint_authority.committed_checkpoint_sha256 =
+        g_strdup(checkpoint_sha256);
+    crucible_checkpoint_authority.committed_target_sha256 =
+        g_strdup(target_sha256);
+    crucible_checkpoint_authority.committed_frontier_sha256 =
+        g_strdup(frontier_sha256);
+    memcpy(crucible_checkpoint_authority.committed_ram_root,
+           crucible_checkpoint_authority.candidate_ram_root,
+           sizeof(crucible_checkpoint_authority.committed_ram_root));
+    crucible_checkpoint_authority.committed_capture_generation = capture_generation;
+    crucible_checkpoint_authority.epoch_active = true;
+    crucible_checkpoint_authority.epoch_generation++;
+#ifdef CONFIG_PLUGIN
+    crucible_checkpoint_authority.candidate_disposition =
+        QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PAGER_COMMIT;
+#endif
+    crucible_checkpoint_candidate_clear();
+    return crucible_checkpoint_epoch_report();
+}
+
+CrucibleCheckpointEpochState *qemu_crucible_checkpoint_abort(
+    const char *checkpoint_sha256,
+    const char *target_sha256,
+    const char *frontier_sha256,
+    uint64_t capture_generation,
+    Error **errp)
+{
+    if (capture_generation == 0 ||
+        capture_generation != crucible_checkpoint_authority.candidate_capture_generation ||
+        !crucible_checkpoint_candidate_matches(
+            checkpoint_sha256, target_sha256, frontier_sha256)) {
+        error_setg(errp, "Crucible checkpoint abort identity does not match "
+                   "the active candidate");
+        return NULL;
+    }
+#ifdef CONFIG_PLUGIN
+    crucible_checkpoint_authority.candidate_disposition =
+        QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PAGER_ABORT;
+#endif
+    crucible_checkpoint_candidate_clear();
+    return crucible_checkpoint_epoch_report();
+}
+
+#ifdef CONFIG_PLUGIN
+int qemu_crucible_checkpoint_end_candidate_v1(
+    QemuCrucibleCheckpointHeldTransaction *owner)
+{
+    if (!owner || !qemu_in_main_thread() || !bql_locked() ||
+        qemu_in_coroutine()) {
+        return -EPERM;
+    }
+    if (crucible_checkpoint_authority.candidate_transaction &&
+        crucible_checkpoint_authority.candidate_transaction != owner) {
+        return -ESTALE;
+    }
+    if (crucible_checkpoint_authority.candidate_active) {
+        if (crucible_checkpoint_authority.candidate_transaction != owner) {
+            return -ESTALE;
+        }
+        /* The actual active candidate is aborted. An earlier completed
+         * commit/invalidate keeps its own disposition and epoch receipts.
+         */
+        crucible_checkpoint_authority.candidate_disposition =
+            QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PAGER_ABORT;
+        crucible_checkpoint_candidate_clear();
+    }
+    if (crucible_checkpoint_authority.candidate_transaction) {
+        uint32_t disposition = crucible_checkpoint_authority.candidate_disposition;
+        int status;
+
+        if (!disposition) {
+            return -EINPROGRESS;
+        }
+        status = qemu_crucible_checkpoint_candidate_end_v1(
+            owner, disposition,
+            disposition == QEMU_PLUGIN_CRUCIBLE_CHECKPOINT_PAGER_INVALIDATE ?
+                -ESTALE : 0);
+        if (status) {
+            return status;
+        }
+        crucible_checkpoint_authority.candidate_transaction = NULL;
+        crucible_checkpoint_authority.candidate_disposition = 0;
+    }
+    return 0;
+}
+#endif
+
+CrucibleCheckpointEpochState *qemu_query_crucible_checkpoint_epoch(void)
+{
+    return crucible_checkpoint_epoch_report();
+}
+
+#ifdef CONFIG_LINUX
+#include <linux/fs.h>
+#include <sys/ioctl.h>
+#endif
+#include "hw/core/boards.h"
+#include "monitor/monitor.h"
+#include "qapi/qapi-commands-misc.h"
+#include "system/system.h"
+#include "system/crucible-kernel-swap-observation.h"
+
+static bool crucible_swap_header(
+    uint64_t generation, int cancellation_fd,
+    struct qemu_plugin_crucible_ram_admission_v1 *admission, Error **errp)
+{
+    if (crucible_checkpoint_cancelled(cancellation_fd, errp)) {
+        return false;
+    }
+    /* The ordinary paused predicate alone does not exclude RESUME_PENDING. */
+    if (!generation || generation == UINT64_MAX || !bql_locked() ||
+        !qemu_plugin_crucible_vmstop_quiesced() ||
+        !crucible_checkpoint_exact_paused_boundary() ||
+        qemu_plugin_crucible_vmstop_generation() != generation ||
+        qemu_plugin_crucible_ram_admission_header_v1(admission) ||
+        admission->schema != 1 || !admission->region_count ||
+        admission->region_count > 1024 || !admission->topology_generation ||
+        admission->topology_generation == UINT64_MAX) {
+        error_setg(errp, "Kernel-swap observation boundary became stale");
+        return false;
+    }
+    return true;
+}
+
+static bool crucible_swap_boundary(
+    uint64_t generation,
+    const struct qemu_plugin_crucible_ram_admission_v1 *saved,
+    int cancellation_fd, Error **errp)
+{
+    struct qemu_plugin_crucible_ram_admission_v1 current;
+
+    if (!crucible_swap_header(generation, cancellation_fd, &current, errp)) {
+        return false;
+    }
+    if (current.schema != saved->schema ||
+        current.region_count != saved->region_count ||
+        current.topology_generation != saved->topology_generation ||
+        current.logical_bytes != saved->logical_bytes ||
+        current.native_metadata_bytes != saved->native_metadata_bytes ||
+        current.native_scratch_bytes != saved->native_scratch_bytes) {
+        error_setg(errp, "Kernel-swap admitted RAM header changed");
+        return false;
+    }
+    return true;
+}
+
+static bool crucible_swap_main_arena(
+    uint64_t generation,
+    const struct qemu_plugin_crucible_ram_admission_v1 *admission,
+    int cancellation_fd, uint64_t *address, Error **errp)
+{
+    struct qemu_plugin_crucible_ram_arena_v1 arena;
+    MachineState *machine = MACHINE(qdev_get_machine());
+    size_t matches = 0;
+
+    if (!crucible_swap_boundary(generation, admission, cancellation_fd, errp)) {
+        return false;
+    }
+    if (mlock_state != MLOCK_OFF ||
+        qemu_real_host_page_size() != CRUCIBLE_SWAP_PAGE_BYTES ||
+        !machine->ram || !memory_region_is_ram(machine->ram) ||
+        memory_region_size(machine->ram) != CRUCIBLE_SWAP_GUEST_BYTES) {
+        error_setg(errp, "Kernel-swap query requires private pageable main RAM");
+        return false;
+    }
+    *address = (uintptr_t)memory_region_get_ram_ptr(machine->ram);
+    if (*address % CRUCIBLE_SWAP_PAGE_BYTES ||
+        *address > UINTPTR_MAX - CRUCIBLE_SWAP_GUEST_BYTES ||
+        (*address / CRUCIBLE_SWAP_PAGE_BYTES) >
+            (INT64_MAX / sizeof(uint64_t)) -
+            (CRUCIBLE_SWAP_GUEST_BYTES / CRUCIBLE_SWAP_PAGE_BYTES)) {
+        error_setg(errp, "Unsupported main RAM inventory");
+        return false;
+    }
+    for (uint32_t index = 0; index < admission->region_count; index++) {
+        if (!crucible_swap_boundary(generation, admission, cancellation_fd,
+                                    errp)) {
+            return false;
+        }
+        if (qemu_plugin_crucible_ram_arena_region_v1(
+                admission->topology_generation, index, &arena) ||
+            arena.schema != 1 || arena.region_index != index ||
+            arena.topology_generation != admission->topology_generation) {
+            error_setg(errp, "Native RAM arena authority became unavailable");
+            return false;
+        }
+        if (arena.host_address == *address) {
+            if (arena.mapping_length != CRUCIBLE_SWAP_GUEST_BYTES ||
+                arena.logical_length != CRUCIBLE_SWAP_GUEST_BYTES ||
+                arena.flags != QEMU_PLUGIN_CRUCIBLE_RAM_ARENA_PAGEABLE) {
+                error_setg(errp, "Main RAM is not a private anonymous arena");
+                return false;
+            }
+            matches++;
+        }
+        if (!crucible_swap_boundary(generation, admission, cancellation_fd,
+                                    errp)) {
+            return false;
+        }
+    }
+    if (matches != 1) {
+        error_setg(errp, "Main RAM has no unique admitted arena");
+        return false;
+    }
+    /* BQL protects the admitted arena and machine identity during this lookup. */
+    return crucible_swap_boundary(generation, admission, cancellation_fd, errp);
+}
+
+static void crucible_swap_close_cancellation(int fd, Error **errp)
+{
+    /* Linux consumes the descriptor even on close error; never retry. */
+    if (close(fd)) {
+        if (*errp) {
+            error_append_hint(errp, "Cancellation close also failed: %s\n",
+                              strerror(errno));
+        } else {
+            error_setg_errno(errp, errno, "Could not close cancellation descriptor");
+        }
+    }
+}
+
+CrucibleKernelSwapAdmission *qmp_query_crucible_kernel_swap_admission_v1(
+    uint64_t expected_generation, const char *cancellation_fdname, Error **errp)
+{
+    CrucibleKernelSwapAdmission *report = NULL;
+    struct qemu_plugin_crucible_ram_admission_v1 admission;
+    uint64_t address;
+    int cancellation_fd = monitor_get_fd(monitor_cur(), cancellation_fdname,
+                                         errp);
+
+    if (cancellation_fd < 0) {
+        return NULL;
+    }
+    if (!crucible_swap_header(expected_generation, cancellation_fd, &admission,
+                              errp) ||
+        !crucible_swap_main_arena(expected_generation, &admission,
+                                  cancellation_fd, &address, errp)) {
+        goto out;
+    }
+    report = g_new0(CrucibleKernelSwapAdmission, 1);
+    report->schema_version = 1;
+    report->generation = expected_generation;
+    report->topology_generation = admission.topology_generation;
+    report->native_page_size = CRUCIBLE_SWAP_PAGE_BYTES;
+    report->guest_bytes = CRUCIBLE_SWAP_GUEST_BYTES;
+    if (!crucible_swap_boundary(expected_generation, &admission,
+                                cancellation_fd, errp)) {
+        goto out;
+    }
+out:
+    crucible_swap_close_cancellation(cancellation_fd, errp);
+    if (*errp) {
+        qapi_free_CrucibleKernelSwapAdmission(report);
+        return NULL;
+    }
+    return report;
+}
+
+#if defined(CONFIG_LINUX) && defined(PAGEMAP_SCAN) && defined(PAGE_IS_PFNZERO)
+G_STATIC_ASSERT(sizeof(struct page_region) == sizeof(CrucibleSwapPageRegion));
+G_STATIC_ASSERT(PAGE_IS_FILE == CRUCIBLE_SCAN_FILE);
+G_STATIC_ASSERT(PAGE_IS_PRESENT == CRUCIBLE_SCAN_PRESENT);
+G_STATIC_ASSERT(PAGE_IS_SWAPPED == CRUCIBLE_SCAN_SWAPPED);
+G_STATIC_ASSERT(PAGE_IS_PFNZERO == CRUCIBLE_SCAN_PFNZERO);
+G_STATIC_ASSERT(PAGE_IS_HUGE == CRUCIBLE_SCAN_HUGE);
+
+static bool crucible_swap_scan(
+    int fd, uint64_t address, uint64_t generation,
+    const struct qemu_plugin_crucible_ram_admission_v1 *admission,
+    int cancellation_fd,
+                               CrucibleSwapCounts *counts, Error **errp)
+{
+    CrucibleSwapChunk chunk;
+    uint64_t pages = CRUCIBLE_SWAP_GUEST_BYTES / CRUCIBLE_SWAP_PAGE_BYTES;
+
+    for (uint64_t offset = 0; offset < pages;
+         offset += CRUCIBLE_SWAP_CHUNK_PAGES) {
+        uint64_t start = address + offset * CRUCIBLE_SWAP_PAGE_BYTES;
+        size_t take = MIN(pages - offset, CRUCIBLE_SWAP_CHUNK_PAGES);
+        struct pm_scan_arg scan = {
+            .size = sizeof(scan),
+            .flags = 0,
+            .start = start,
+            .end = start + take * CRUCIBLE_SWAP_PAGE_BYTES,
+            .vec = (uintptr_t)chunk.regions,
+            .vec_len = take,
+            .max_pages = take,
+            .return_mask = CRUCIBLE_SCAN_MASK,
+        };
+        int regions;
+        ssize_t length;
+
+        if (!crucible_swap_boundary(generation, admission, cancellation_fd,
+                                    errp)) {
+            return false;
+        }
+        regions = ioctl(fd, PAGEMAP_SCAN, &scan);
+        if (regions < 0) {
+            error_setg_errno(errp, errno, "Could not scan guest PTE categories");
+            return false;
+        }
+        if (scan.walk_end != scan.end ||
+            !crucible_swap_associate(&chunk, start, take, regions)) {
+            error_setg(errp, "Incomplete or unsupported guest PTE interval");
+            return false;
+        }
+        /* Neither metadata syscall dereferences the main RAM mapping. Their
+         * observations can differ as host reclaim progresses between them. */
+        length = pread(fd, chunk.entries, take * sizeof(uint64_t),
+                       (start / CRUCIBLE_SWAP_PAGE_BYTES) * sizeof(uint64_t));
+        if (length != take * sizeof(uint64_t)) {
+            if (length < 0) {
+                error_setg_errno(errp, errno, "Could not read guest pagemap");
+            } else {
+                error_setg(errp, "Truncated guest pagemap interval");
+            }
+            return false;
+        }
+        if (mincore((void *)(uintptr_t)start,
+                    take * CRUCIBLE_SWAP_PAGE_BYTES, chunk.resident)) {
+            error_setg_errno(errp, errno, "Could not observe guest residency");
+            return false;
+        }
+        if (!crucible_swap_count(&chunk, take, counts)) {
+            error_setg(errp, "Unsupported guest PTE classification");
+            return false;
+        }
+    }
+    return crucible_swap_boundary(generation, admission, cancellation_fd, errp);
+}
+#endif
+
+CrucibleKernelSwapResidency *qmp_query_crucible_kernel_swap_residency_v1(
+    uint64_t expected_generation, uint64_t expected_topology_generation,
+    const char *cancellation_fdname, Error **errp)
+{
+    CrucibleKernelSwapResidency *report = NULL;
+    int cancellation_fd = monitor_get_fd(monitor_cur(), cancellation_fdname,
+                                         errp);
+    int pagemap_fd = -1;
+
+    if (cancellation_fd < 0) {
+        return NULL;
+    }
+#if defined(CONFIG_LINUX) && defined(PAGEMAP_SCAN) && defined(PAGE_IS_PFNZERO)
+    struct qemu_plugin_crucible_ram_admission_v1 admission;
+    CrucibleSwapCounts counts = { 0 };
+    uint64_t address;
+
+    if (!expected_topology_generation ||
+        expected_topology_generation == UINT64_MAX ||
+        !crucible_swap_header(expected_generation, cancellation_fd, &admission,
+                              errp)) {
+        if (!*errp) {
+            error_setg(errp, "Invalid expected kernel-swap inventory generation");
+        }
+        goto out;
+    }
+    if (admission.topology_generation != expected_topology_generation) {
+        error_setg(errp, "Kernel-swap inventory generation became stale");
+        goto out;
+    }
+    if (!crucible_swap_main_arena(expected_generation, &admission,
+                                  cancellation_fd, &address, errp)) {
+        goto out;
+    }
+    pagemap_fd = open("/proc/self/pagemap", O_RDONLY | O_CLOEXEC);
+    if (pagemap_fd < 0) {
+        error_setg_errno(errp, errno, "Could not open own pagemap");
+        goto out;
+    }
+    if (!crucible_swap_scan(pagemap_fd, address, expected_generation,
+                            &admission, cancellation_fd,
+                            &counts, errp)) {
+        goto out;
+    }
+    report = g_new0(CrucibleKernelSwapResidency, 1);
+    report->schema_version = 1;
+    report->observation = g_strdup("interval");
+    report->generation = expected_generation;
+    report->topology_generation = expected_topology_generation;
+    report->native_page_size = CRUCIBLE_SWAP_PAGE_BYTES;
+    report->guest_bytes = CRUCIBLE_SWAP_GUEST_BYTES;
+    report->guest_pages = CRUCIBLE_SWAP_GUEST_BYTES / CRUCIBLE_SWAP_PAGE_BYTES;
+    report->chunks = report->guest_pages / CRUCIBLE_SWAP_CHUNK_PAGES;
+    report->pte_present_pages = counts.present;
+    report->pte_swapped_pages = counts.swapped;
+    report->pte_absent_pages = counts.absent;
+    report->resident_pages = counts.resident;
+    report->scan_zero_pages = counts.zero;
+    report->sampled_swapped_nonresident_pages = counts.swapped_nonresident;
+    report->changed_pte_pages = counts.changed;
+    report->target_certified = false;
+    if (!crucible_swap_boundary(expected_generation, &admission,
+                                cancellation_fd, errp)) {
+        goto out;
+    }
+#else
+    error_setg(errp, "Kernel-swap residency requires Linux PAGEMAP_SCAN/PFNZERO");
+    goto out;
+#endif
+out:
+    /* Linux close consumes the descriptor even on error; never retry. Keep
+     * the initiating failure primary and report independent close failures. */
+    if (pagemap_fd >= 0 && close(pagemap_fd)) {
+        if (*errp) {
+            error_append_hint(errp, "Pagemap close also failed: %s\n",
+                              strerror(errno));
+        } else {
+            error_setg_errno(errp, errno, "Could not close pagemap");
+        }
+    }
+    crucible_swap_close_cancellation(cancellation_fd, errp);
+    if (*errp) {
+        qapi_free_CrucibleKernelSwapResidency(report);
+        return NULL;
+    }
+    return report;
+}
