+static void standing_slice_budget(uint64_t elapsed, bool present,
+                                  uint64_t allowance, uint64_t *slice)
+{
+    if (present) {
+        *slice = MIN(*slice, elapsed < allowance ? allowance - elapsed : 0);
+    }
+}
