+/* These checks execute the actual pure codec. A valid byte record creates
+ * no Source owner, operation, mapping or physical return journal. */
+static void fixture_action_wire(uint8_t wire[QEMU_CRUCIBLE_ACTION_BYTES])
+{
+    uint8_t *row = wire + 128;
+
+    memset(wire, 0, QEMU_CRUCIBLE_ACTION_BYTES);
+    memcpy(wire, "CRUCACT2", 8);
+    stl_be_p(wire + 8, 2);
+    stl_be_p(wire + 12, QEMU_CRUCIBLE_ACTION_BYTES);
+    wire[16] = 1;
+    wire[48] = 2;
+    stq_be_p(wire + 80, 3);
+    stq_be_p(wire + 88, 4);
+    stq_be_p(wire + 112, 2);
+    stl_be_p(wire + 120, UINT32_C(0x00010101));
+    stl_be_p(wire + 124, 1);
+
+    row[0] = 5;
+    stq_be_p(row + 32, 6);
+    stq_be_p(row + 40, 7);
+    stl_be_p(row + 48, 1);
+    stq_be_p(row + 72, 8);
+    stq_be_p(row + 80, 9);
+    stq_be_p(row + 88, 9);
+    stq_be_p(row + 128, 1);
+    stq_be_p(row + 144, 1);
+}
+
+static void scenario_action_codec_custody_and_projection(void)
+{
+    uint8_t wire[QEMU_CRUCIBLE_ACTION_BYTES];
+    QemuCrucibleBoundaryActionRecord record;
+
+    fixture_action_wire(wire);
+    g_assert_cmpint(qemu_crucible_boundary_action_decode_v2(
+        wire, sizeof(wire), &record), ==, 0);
+    g_assert_true(record.present);
+    g_assert_cmpuint(record.binding.request_token, ==, 0);
+    g_assert_cmpuint(record.binding.capture_generation, ==, 0);
+    g_assert_cmpuint(record.born_mask, ==, 1);
+    g_assert_cmpuint(record.projected_mask, ==, 1);
+
+    /* Durable birth precedes a refused projection. Zero evidence does not
+     * erase the genuinely born membership or claim its physical return. */
+    memset(wire + 128, 0, QEMU_CRUCIBLE_ACTION_ROW_BYTES);
+    stl_be_p(wire + 120, UINT32_C(0x80000101));
+    g_assert_cmpint(qemu_crucible_boundary_action_decode_v2(
+        wire, sizeof(wire), &record), ==, 0);
+    g_assert_true(record.dirty);
+    g_assert_cmpuint(record.born_mask, ==, 1);
+    g_assert_cmpuint(record.projected_mask, ==, 0);
+
+    stl_be_p(wire + 120, UINT32_C(0x80010001));
+    g_assert_cmpint(qemu_crucible_boundary_action_decode_v2(
+        wire, sizeof(wire), &record), ==, -EPROTO);
+    fixture_action_wire(wire);
+    memcpy(wire, "CRUCACT1", 8);
+    stl_be_p(wire + 8, 1);
+    g_assert_cmpint(qemu_crucible_boundary_action_decode_v2(
+        wire, sizeof(wire), &record), ==, -EPROTONOSUPPORT);
+}
+
+static void scenario_action_codec_distinct_borrower_rows(void)
+{
+    uint8_t wire[QEMU_CRUCIBLE_ACTION_BYTES];
+    QemuCrucibleBoundaryActionRecord record;
+
+    fixture_action_wire(wire);
+    memcpy(wire + 128 + QEMU_CRUCIBLE_ACTION_ROW_BYTES, wire + 128,
+           QEMU_CRUCIBLE_ACTION_ROW_BYTES);
+    stl_be_p(wire + 120, UINT32_C(0x00030302));
+    stl_be_p(wire + 124, 2);
+
+    g_assert_cmpint(qemu_crucible_boundary_action_decode_v2(
+        wire, sizeof(wire), &record), ==, 0);
+    g_assert_cmpuint(record.primary_count, ==, 2);
+    g_assert_cmpuint(record.planned_count, ==, 2);
+    g_assert_cmpuint(record.born_mask, ==, 3);
+    g_assert_cmpuint(record.projected_mask, ==, 3);
+    g_assert_cmpuint(record.rows[0].operation, ==, record.rows[1].operation);
+
+    /* Nonzero evidence without its projection bit is malformed even when
+     * its actual birth bit is present. */
+    stl_be_p(wire + 120, UINT32_C(0x80010302));
+    g_assert_cmpint(qemu_crucible_boundary_action_decode_v2(
+        wire, sizeof(wire), &record), ==, -EPROTO);
+}
