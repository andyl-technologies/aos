+                "include/qemu/crucible-process-purpose.h",
+                "include/qemu/crucible-device-workspace.h",
+            )
+        },
+        "literal_total_helper_sha256": hashlib.sha256(
+            total_helper.encode()).hexdigest(),
+        "literal_bodies_sha256": [hashlib.sha256(body.encode()).hexdigest()
+                                  for body in bodies],
+        "fixture_sha256": hashlib.sha256(fixture.read_bytes()).hexdigest(),
+        "literal_retained_helper_sha256": hashlib.sha256(definition(
+            startup, "bool qemu_plugin_crucible_startup_source_retained("
+        ).encode()).hexdigest(),
+        "literal_controller_observation_sha256": hashlib.sha256(definition(
+            startup,
+            "uint64_t qemu_crucible_startup_source_control_metadata_bytes("
+        ).encode()).hexdigest(),
+        "modeled_total_storage": True,
+        "literal_partition_status_sha256": hashlib.sha256(definition(
+            startup, "int qemu_crucible_startup_source_metadata_partition_status("
+        ).encode()).hexdigest(),
+        "modeled_controller_storage": True,
+        "literal_inventory_reserve_sha256": hashlib.sha256(definition(
+            startup, "int qemu_crucible_startup_source_inventory_allowance_reserve("
+        ).encode()).hexdigest(),
+        "literal_inventory_limit_sha256": hashlib.sha256(
+            allowance_limit.encode()).hexdigest(),
+        "modeled_current_original_pre_post_seam": True,
+        "source_acquisition_or_issuer": False,
+    }
+    (args.output_dir / "source-bindings.json").write_text(
+        json.dumps(bindings, indent=2, sort_keys=True) + "\n")
+    if args.generate_only:
+        return
+    command = [*shlex.split(os.environ["CC"]), *shlex.split(os.environ.get("CFLAGS", "")),
+               "-std=gnu11", "-Wall", "-Werror", "-pthread", str(fixture),
+               "-o", str(binary), *shlex.split(os.environ.get("LDFLAGS", ""))]
+    (args.output_dir / "compile-command.json").write_text(json.dumps(command, indent=2) + "\n")
+    subprocess.run(command, check=True)
+    subprocess.run([str(binary)], cwd=args.output_dir, check=True, timeout=10)
+
+
+if __name__ == "__main__":
+    main()
