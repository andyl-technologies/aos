+int qemu_plugin_crucible_ram_control_receive_begin_v1(
+    qemu_plugin_id_t id, qemu_plugin_crucible_ram_control_actor_v1 *actor,
+    struct qemu_plugin_crucible_ram_control_receive_borrow_v1 *out)
+{
+    int status = qemu_crucible_ram_control_actor_current(actor, id);
+
+    if (status) {
+        return status;
+    }
+    pthread_mutex_lock(&actor->dispatch_mutex);
+    status = (actor->quiesce_requested || actor->pause.requested ||
+              actor->request_pause.requested) ? -EAGAIN :
+        ram_control_receive_begin_locked(id, actor, out);
+    pthread_mutex_unlock(&actor->dispatch_mutex);
+    return status;
+}
