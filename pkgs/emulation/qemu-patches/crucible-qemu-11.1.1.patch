+static void test_build_region(uint32_t kind, uint64_t address,
+                              uint64_t length, const char *policy,
+                              bool virtual_address)
+{
+    test_payload_begin(CRUCIBLE_FAULT_COMMAND_MEMORY_REGION_STATE, 9);
