+int qemu_crucible_fingerprint_material_capture_end_v2(
+    const QemuCrucibleFingerprintMaterialRef *reference, int descriptor,
+    uint64_t bytes, int first_status)
+{
+    QemuCrucibleFingerprintMaterial *material;
+    struct stat identity;
+    int status;
+
+    if (!reference || !qemu_in_main_thread()) {
+        return -EPERM;
+    }
+    if (fingerprint_output_workspace_overlap(reference, sizeof(*reference)) ||
+        (reference != &startup_source.fingerprint_capture &&
+         callback_child_output_overlap(reference, sizeof(*reference),
+                                       &startup_source, sizeof(startup_source)))) {
+        return -EINVAL;
+    }
+    /* The canonical current-capture Ref is an intentional private Source
+     * read; arbitrary caller Ref spans cannot name Source storage. */
+    material = fingerprint_material_ref(reference);
+    status = fingerprint_material_identity(material);
+
+    if (status || material != fingerprint_current_capture() || !qemu_in_main_thread() ||
+        !qemu_thread_is_self(&material->operation.thread)) {
+        return status ? status : -EPERM;
+    }
+    material->descriptor = descriptor;
+    material->device_length = bytes;
+    if (first_status) {
+        qatomic_cmpxchg(&material->first_status, 0, first_status);
+    }
+    if (!first_status && !fingerprint_material_root_returned(material)) {
+        status = -EPROTO;
+    }
+    if (!status && !first_status) {
+        int seals = fcntl(descriptor, F_GET_SEALS);
+
+        if (fstat(descriptor, &identity) < 0) {
+            status = -errno;
+        } else if (!S_ISREG(identity.st_mode) || identity.st_size < 0 ||
+            (uint64_t)identity.st_size != bytes || !bytes ||
+            seals != (F_SEAL_GROW | F_SEAL_SHRINK | F_SEAL_WRITE | F_SEAL_SEAL)) {
+            status = -ESTALE;
+        } else {
+            material->device = identity.st_dev;
+            material->inode = identity.st_ino;
+            material->sealed = true;
+        }
+    }
+    material->capture_entered = false;
+    startup_source.fingerprint_capture = (QemuCrucibleFingerprintMaterialRef) { 0 };
+    material->post_status = status ? status : fingerprint_material_observe(
+        material, &material->main_observer, NULL);
+    if (material->post_status) {
+        qatomic_cmpxchg(&material->first_status, 0, material->post_status);
+    }
+    first_status = qatomic_load_acquire(&material->first_status);
+    return first_status ? first_status : material->post_status;
+}
