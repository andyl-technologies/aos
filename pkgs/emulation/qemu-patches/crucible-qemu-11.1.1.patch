+    }
+    if (status == -ENOENT) {
+        return 0;
+    }
+    if (status) {
+        return status;
+    }
+    if (selector != fingerprint_root_operation) {
+        return -EPERM;
+    }
+    status = qemu_crucible_startup_source_fingerprint_completion_borrow_v1(id, &binding);
+    if (!status) {
+        status = qemu_crucible_startup_source_fingerprint_completion_observe_v1(
+            binding, &view_return, &userdata);
+    }
+    if (!status) {
+        status = qemu_crucible_startup_source_fingerprint_module_view_current_v1(id, selector);
+    }
+    if (status) {
+        return status;
+    }
+    /* This is the enrolled creating-Main physical-return body, outside native
+     * guards. It must pass its OWN stable field to borrow_end, never this alias. */
+    status = view_return(id, selector, userdata);
+    disposition = qemu_crucible_startup_source_fingerprint_module_view_returned_v1(id, selector);
+    fingerprint_root_outcome.old_module_return_status = status;
+    fingerprint_root_outcome.old_module_disposition_status = disposition;
+    return status ? status : disposition;
+}
+
+static int fingerprint_root_background_return(void)
+{
+    int status;
+
+    if (!fingerprint_root_background.source && !fingerprint_root_background.token) {
+        return 0;
+    }
+    if (fingerprint_root_writer) {
+        status = fingerprint_root_outcome.writer_return_status ?
+            fingerprint_root_outcome.writer_return_status : -EBUSY;
+        fingerprint_root_background.return_status = status;
+        if (!fingerprint_root_background.cleanup_status) {
+            fingerprint_root_background.cleanup_status = status;
+        }
+        return status;
+    }
+    if (fingerprint_root_background.token) {
+        struct qemu_plugin_crucible_ram_physical_end_v2 end = {
+            .schema_version = 2, .struct_size = sizeof(end),
+        };
+
+        status = qemu_crucible_ram_owner_closure_end_v2(fingerprint_root_background.token, &end);
+        fingerprint_root_background.end = end;
+        fingerprint_root_background.return_status = status;
+        if (status && !fingerprint_root_background.cleanup_status) {
+            fingerprint_root_background.cleanup_status = status;
+        }
+        if (!end.return_complete) {
+            return status ? status : -EINPROGRESS;
+        }
+        fingerprint_root_background.token = 0;
+    }
+    status = qemu_crucible_startup_source_resident_absence_return_v1(
+        &fingerprint_root_background.source, fingerprint_root_background.cleanup_status);
+    fingerprint_root_background.return_status = status;
+    if (status && !fingerprint_root_background.cleanup_status) {
+        fingerprint_root_background.cleanup_status = status;
+    }
+    return status;
+}
