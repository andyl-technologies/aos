+static int logical_capture_geometry_check(bool require_writer)
+{
+    struct QemuCrucibleLogicalCapture *claim = logical_capture;
+    int status = require_writer ? logical_capture_native_current() :
+        logical_capture_native_versions_current();
+
+    if (!require_writer && (claim->source_claim || fingerprint_root_operation ||
+                           fingerprint_root_writer)) {
+        return -EPERM;
+    }
+    if (status) {
+        return status;
+    }
+    /* The nominal claim retains admission/MR refs and the actual writer loan.
+     * Full inventory/alias proof runs at admission and publication boundaries,
+     * not on every page's pre/post current observation. */
+    WITH_RCU_READ_LOCK_GUARD() {
+        for (size_t index = 0; index < claim->regions->len; index++) {
+            const CrucibleRamRegion *retained = region_inventory_index(claim->regions, index);
+            const CrucibleRamRegion *current = claim->generation ?
+                region_inventory_index(capture_regions, index) : retained;
+            RAMBlock *block, *live = NULL;
+            uint64_t length = retained->descriptor.logical_length;
+
+            RAMBLOCK_FOREACH(block) {
+                if (block == retained->block) {
+                    live = block;
+                    break;
+                }
+            }
+            if (!live || live != current->block || !live->host ||
+                memcmp(&retained->descriptor, &current->descriptor, sizeof(retained->descriptor)) ||
+                live->used_length != length ||
+                live->offset != retained->fingerprint_ram_offset ||
+                current->fingerprint_ram_offset != retained->fingerprint_ram_offset ||
+                length > (ram_addr_t)-1 - retained->fingerprint_ram_offset ||
+                (live->offset & (TARGET_PAGE_SIZE - 1)) ||
+                ((uintptr_t)live->host & (TARGET_PAGE_SIZE - 1)) ||
+                length > UINTPTR_MAX - (uintptr_t)live->host ||
+                length > UINT64_MAX - (TARGET_PAGE_SIZE - 1) ||
+                TARGET_PAGE_ALIGN(length) > live->max_length ||
+                TARGET_PAGE_ALIGN(length) > UINTPTR_MAX - (uintptr_t)live->host ||
+                current->fingerprint_capture_start > current->fingerprint_capture_end ||
+                current->fingerprint_capture_end > length) {
+                return -ESTALE;
+            }
+            /* Every host alias of this RAM backing lies in the same host
+             * interval. Reject overlapping independently owned RAMBlocks. */
+            for (size_t other = 0; other < index; other++) {
+                const CrucibleRamRegion *prior = region_inventory_index(claim->regions, other);
+                uintptr_t begin = (uintptr_t)live->host;
+                uintptr_t end = begin + TARGET_PAGE_ALIGN(length);
+                uintptr_t prior_begin = (uintptr_t)prior->block->host;
+                uintptr_t prior_end = prior_begin + TARGET_PAGE_ALIGN(prior->descriptor.logical_length);
+
+                if (begin < prior_end && prior_begin < end) {
+                    return -ENOTSUP;
+                }
+            }
+        }
+    }
+    return 0;
+}
