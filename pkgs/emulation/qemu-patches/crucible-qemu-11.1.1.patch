+    fingerprint_control_component.holder = &holder;
+    fingerprint_control_component.callback = factual_callback;
+    fingerprint_control_component.process = getpid();
+    fingerprint_control_component.attempted = true;
+    fingerprint_control_component.detached = true;
+    frame->canonical_owner = frame;
+    frame->component = &component;
+    frame->holder = &holder;
+    frame->process = getpid();
+    frame->serial = 1;
+    frame->active = true;
+    qemu_thread_get_self(&frame->thread);
+#define CURRENT() qemu_plugin_crucible_publisher_service_return_frame_current_v1( \
+    frame, &component, &holder)
+    assert(CURRENT() == 0);
+    assert(qemu_plugin_crucible_wake_watcher_storage_bytes_v1() ==
+        sizeof(fingerprint_wake_watcher) + sizeof(fingerprint_wake_registration_serial) +
+        sizeof(fingerprint_control_component));
+    copied = *frame;
+    copied.canonical_owner = &copied;
+    assert(qemu_plugin_crucible_publisher_service_return_frame_current_v1(
+        &copied, &component, &holder) == -ESTALE);
+    assert(pthread_create(&other, NULL, factual_other_thread, frame) == 0);
+    assert(pthread_join(other, NULL) == 0);
+    NATIVE_MUTATIONS
+    frame->serial = 0;
+    assert(CURRENT() == -ESTALE);
+    frame->serial = UINT64_MAX;
+    assert(CURRENT() == -ESTALE);
+    frame->serial = 1;
+    qemu_plugin_rr_control_request_generation = 1;
+    assert(CURRENT() == -EBUSY);
+    qemu_plugin_rr_control_request_generation = 0;
+    assert(CURRENT() == 0);
+    frame->active = false;
+    frame->retained = true;
+    assert(qemu_plugin_crucible_control_component_return_v1(&holder) == -EBUSY);
+    assert(!drain_calls && !source_return_calls && !component_return_calls);
+    frame->retained = false;
+    frame->active = true;
+    assert(qemu_plugin_crucible_control_component_return_v1(&holder) == -EBUSY);
+    assert(!drain_calls && !source_return_calls && !component_return_calls);
+    frame->active = false;
+    frame->serial = UINT64_MAX - 1;
+    assert(qemu_plugin_crucible_control_component_return_v1(&holder) == -EBUSY);
+    assert(!drain_calls && !source_return_calls && !component_return_calls);
+    frame->serial = 1;
+    assert(qemu_plugin_crucible_control_component_return_v1(&holder) == -ENOKEY);
+    assert(drain_calls == 1 && !source_return_calls && !component_return_calls);
+    assert(holder == &component && frame->serial == 1 && !frame->active);
+    /* Only the physical reciprocal is exercised: these local records issue no
+     * canonical Source service, Runtime, payer or Original. */
+    startup_source.publisher_module.transferred = true;
+    assert(startup_setup_service_return_boundary_current(
+        &startup_source.publisher_module) == -ESTALE);
+    holder = &startup_source.control_callback;
+    startup_source.control_callback.holder = &holder;
+    fingerprint_control_component.component = holder;
+    frame->component = holder;
+    frame->holder = &holder;
+    frame->active = true;
+    startup_source.publisher_module.cleanup_frame = frame;
+    assert(startup_setup_service_return_boundary_current(
+        &startup_source.publisher_module) == 0);
+    copied = *frame;
+    copied.canonical_owner = &copied;
+    startup_source.publisher_module.cleanup_frame = &copied;
+    assert(startup_setup_service_return_boundary_current(
+        &startup_source.publisher_module) == -ESTALE);
+    memset(&startup_source, 0, sizeof(startup_source));
+#undef CURRENT
+}
+'''
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--source-root', type=Path,
+                        default=Path(__file__).resolve().parents[2])
+    parser.add_argument('--output-dir', type=Path, required=True)
+    args = parser.parse_args()
+    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
+    args.output_dir.mkdir(parents=True, exist_ok=True)
+    extract = runpy.run_path(str(args.source_root /
+        'tests/unit/extract-crucible-startup-source-controls.py'))['function']
+    source = (args.source_root / 'plugins/crucible-publisher-service.inc.h').read_text()
+    literal = '\n\n'.join(extract(source, signature) for signature in (
+        'static bool publisher_service_runtime_span(',
+        'static bool publisher_service_group_drained(',
+        'static bool publisher_service_groups_drained(',
+        'static bool publisher_service_users_drained(',
+        'static void publisher_service_runtime_return_finish(',
+    ))
