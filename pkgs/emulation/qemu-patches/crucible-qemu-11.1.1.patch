+void qemu_rcu_hot_fork_barrier(QemuRcuHotForkBarrierOperation operation,
+                               QemuRcuHotForkBarrierInventory *inventory)
+{
+    QemuRcuHotForkInventory readers;
+    size_t index;
+
+    memset(inventory, 0, sizeof(*inventory));
+    qemu_mutex_lock(&rcu_hot_fork_barrier_lock);
+    switch (operation) {
+    case QEMU_RCU_HOT_FORK_BARRIER_HOLD:
+        if (!qatomic_read(&rcu_hot_fork_barrier_held)) {
+            qemu_event_reset(&rcu_hot_fork_barrier_release);
+            qatomic_set(&rcu_hot_fork_barrier_owner, qemu_get_thread_id());
+            smp_mb_global();
+            qatomic_set(&rcu_hot_fork_barrier_held, 1);
+            rcu_hot_fork_barrier_generation++;
+            assert(rcu_hot_fork_barrier_generation != 0);
+        }
+        break;
+    case QEMU_RCU_HOT_FORK_BARRIER_QUERY:
+        break;
+    case QEMU_RCU_HOT_FORK_BARRIER_RELEASE:
+        if (qatomic_read(&rcu_hot_fork_barrier_held)) {
+            qatomic_set(&rcu_hot_fork_barrier_held, 0);
+            qatomic_set(&rcu_hot_fork_barrier_owner, 0);
+            rcu_hot_fork_barrier_generation++;
+            assert(rcu_hot_fork_barrier_generation != 0);
+            qemu_event_set(&rcu_hot_fork_barrier_release);
+        }
+        break;
+    default:
+        g_assert_not_reached();
+    }
+
+    qemu_rcu_hot_fork_inventory(&readers);
+    inventory->generation = rcu_hot_fork_barrier_generation;
+    inventory->owner_thread_id =
+        qatomic_read(&rcu_hot_fork_barrier_owner);
+    inventory->registered_readers = readers.entry_count;
+    for (index = 0; index < readers.entry_count; index++) {
+        if (readers.entries[index].active) {
+            inventory->active_readers++;
+        }
+    }
+    inventory->admissions_in_flight =
+        qatomic_read(&rcu_hot_fork_admissions);
+    inventory->pending_callbacks = readers.pending_callbacks;
+    inventory->held = qatomic_read(&rcu_hot_fork_barrier_held) != 0;
+    inventory->drain_active = readers.drain_active;
+    inventory->complete = !readers.overflowed;
+    inventory->quiescent = inventory->complete && inventory->held &&
+        inventory->active_readers == 0 &&
+        inventory->admissions_in_flight == 0 &&
+        inventory->pending_callbacks == 0 && !inventory->drain_active;
+    qemu_rcu_hot_fork_inventory_destroy(&readers);
+    qemu_mutex_unlock(&rcu_hot_fork_barrier_lock);
+}
