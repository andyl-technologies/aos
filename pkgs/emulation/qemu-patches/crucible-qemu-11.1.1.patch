+
+static void fork_preserves_original_live_memberships(void)
+{
+    reset_borrow_inventory();
+    crucible_ram_cache_borrow_change(true, true);
+    pid_t child = fork();
+    assert(child >= 0);
+    if (child == 0) {
+        assert(inventory().caches == 1 && inventory().direct_caches == 1);
+        assert(inventory().generation == 3);
+        assert(qemu_crucible_ram_paging_request() == -EBUSY);
+        crucible_ram_cache_borrow_change(true, false);
+        assert(inventory().generation == 5 && inventory().consistent);
