+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Run native procfd preparation and adoption bodies against Linux descriptors.
+
+Graph state is a small fixture with locking disabled. Opens, duplication, copy,
+hashing, descriptor queries, and parent/child custody use real syscalls. This
+standalone test does not exercise a complete QEMU guest or fork coordinator.
+A Linux subreaper retains the owned fixture group through a fixed, separate
+cleanup budget; uncertainty never converts the execution timeout into success.
+"""
+
+import argparse
+import ctypes
+import errno
+import json
+import os
+from pathlib import Path
+import shlex
+import signal
+import subprocess
+import sys
+import time
+
+ROOT = Path(__file__).resolve().parents[2]
+EXECUTION_SECONDS = 10
+CLEANUP_SECONDS = 3
+POLL_SECONDS = 0.025
+
+# Linux UAPI prctl operations; no process outside this test is enrolled.
+PR_SET_CHILD_SUBREAPER = 36
+PR_GET_CHILD_SUBREAPER = 37
+_retained_supervisions = []
+
+
+def production_definition(source: str, signature: str, is_type=False) -> str:
+    """Extract one complete production function or typedef for compilation."""
+    start = source.index(signature)
+    opening = source.index("{", start)
+    depth = 0
+
+    for index in range(opening, len(source)):
+        if source[index] == "{":
+            depth += 1
+        elif source[index] == "}":
+            depth -= 1
+            if depth == 0:
+                end = source.index(";", index) if is_type else index
+                return source[start:end + 1]
+
+    raise AssertionError(f"unterminated production definition: {signature}")
+
+
+PRELUDE = r"""
+#include "qemu/osdep.h"
