+int qemu_plugin_crucible_parent_park_drain_original_check_v1(qemu_plugin_id_t id)
+{
+#ifdef CONFIG_LINUX
+    uint64_t unused;
+
+    return parent_park_callback_slice(id, &unused);
+#else
+    return -ENOTSUP;
+#endif
+}
