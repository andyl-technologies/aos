+{
+    if (!resources || !control_source_fd || !wake_source_fd) {
+        return false;
+    }
+    if (resources->replacements[0].target_fd == resources->plan.control_fd) {
+        *control_source_fd = resources->replacements[0].source_fd;
+        *wake_source_fd = resources->replacements[1].source_fd;
+        return resources->replacements[1].target_fd == resources->plan.wake_fd;
+    }
+    *control_source_fd = resources->replacements[1].source_fd;
+    *wake_source_fd = resources->replacements[0].source_fd;
+    return resources->replacements[1].target_fd == resources->plan.control_fd &&
+        resources->replacements[0].target_fd == resources->plan.wake_fd;
+}
