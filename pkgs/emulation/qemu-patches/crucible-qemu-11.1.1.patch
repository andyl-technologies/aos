+int qemu_plugin_crucible_startup_source_command_receive_transfer_v1(
+    qemu_plugin_id_t id, QemuCrucibleCommandReceiveOwner **projection,
+    uint64_t serial, QemuCrucibleCommandReceiveOwner **runtime_field)
+{
