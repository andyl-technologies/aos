+static uint32_t preexec_setup_be32(const volatile uint8_t *bytes)
+{
+    return ((uint32_t)bytes[0] << 24) | ((uint32_t)bytes[1] << 16) |
+           ((uint32_t)bytes[2] << 8) | bytes[3];
+}
+
+static uint64_t preexec_setup_be64(const volatile uint8_t *bytes)
+{
+    return ((uint64_t)preexec_setup_be32(bytes) << 32) |
+           preexec_setup_be32(bytes + 4);
+}
