+     * Its private partition association is never exposed to Native borrowers. */
+    if (account != &startup_source.cpu_metadata_account ||
+        !qatomic_load_acquire(&account->retained) ||
+        account->binding != &startup_source.standing.construction ||
+        account->partition != &startup_source.metadata_partition ||
+        account->process != getpid() ||
+        account->process_generation != startup_source.original.process_generation ||
+        account->process != startup_source.owner_process ||
+        account->issuer != startup_source.preexec_purpose_owner ||
+        !qatomic_load_acquire(&startup_source.process_purpose_complete) ||
+        !qatomic_load_acquire(&startup_source.custody_retained) ||
+        account->binding->issuer != account->issuer ||
+        !account->binding->body_charge.held ||
+        !qatomic_load_acquire(&account->partition->published) ||
+        !qatomic_load_acquire(&account->partition->controller_retained) ||
+        !account->fixed_native_extent ||
+        account->partition->fixed_native_extent != account->fixed_native_extent) {
+        return -ESTALE;
+    }
+    /* The once entered constructor captured this actual Source/bank lifetime.
+     * Runtime uses the retained subject plus Native's specific CPU/MMU request,
+     * never the old Original, installer context, floor getter or new factory.
+     * getpid remains a real process-identity query; no syscall-free claim. */
+    return 0;
+}
