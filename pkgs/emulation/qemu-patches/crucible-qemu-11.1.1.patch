+static void qemu_plugin_time_advance_complete_bh(void *opaque)
+{
+    qemu_plugin_time_advance_cb_t cb = qemu_plugin_time_advance_cb;
+    void *userdata = qemu_plugin_time_advance_userdata;
+    int status = qatomic_read(&qemu_plugin_time_advance_status);
+    int64_t target = qatomic_read(&qemu_plugin_time_advance_target);
+
+    (void)opaque;
+    qatomic_store_release(&qemu_plugin_time_advance_timer_state,
+                          QEMU_PLUGIN_TIME_ADVANCE_TIMERS_WAITING);
+    if (!qemu_plugin_time_advance_claim_timer_barrier()) {
+        return;
+    }
+    if (cb) {
+        g_assert(!qemu_plugin_time_advance_callback_active);
+        qemu_plugin_time_advance_callback_active = true;
+        qemu_plugin_crucible_exact_boundary_enter();
+        cb(status, target, userdata);
+        qemu_plugin_crucible_exact_boundary_leave();
+        qemu_plugin_time_advance_callback_active = false;
+    }
+    /*
+     * A Crucible block coroutine can be parked because the guest itself cannot
+     * retire instructions while waiting for device I/O.  Re-enter all
+     * wake-fd-backed device waiters only after the plugin has committed the
+     * completed logical-time advance.  A waiter whose response is still
+     * physically absent simply parks again; no guest instruction or virtual
+     * time can observe that host-side race.
+     */
+    notifier_list_notify(&qemu_plugin_wake_notifiers,
+                         (void *)(intptr_t)QEMU_PLUGIN_WAKE_EVENT_DRAINED);
+    g_assert(first_cpu);
+    g_assert(qatomic_cmpxchg(&qemu_plugin_time_advance_timer_state,
+                            QEMU_PLUGIN_TIME_ADVANCE_TIMERS_COMPLETING,
+                            QEMU_PLUGIN_TIME_ADVANCE_TIMERS_SETTLE_READY) ==
+             QEMU_PLUGIN_TIME_ADVANCE_TIMERS_COMPLETING);
+    qemu_cpu_kick(first_cpu);
+}
