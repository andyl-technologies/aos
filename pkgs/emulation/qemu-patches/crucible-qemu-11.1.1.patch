+#include "qemu/typedefs.h"
+#include "qemu/atomic.h"
+#include "qemu/queue.h"
+#include "plugins/qemu-plugin.h"
+#define error_report(...) g_error(__VA_ARGS__)
+
+/* Only scalar ABI symbols needed by these extracted bodies are supplied. */
+#define CRUCIBLE_FAULT_COMMAND_ABI_MAJOR 1
+#define CRUCIBLE_FAULT_COMMAND_ABI_MINOR 0
+#define CRUCIBLE_FAULT_COMMAND_FLAG_PREPARE_ONLY 1
+#define CRUCIBLE_FAULT_COMMAND_QUERY_CAPABILITIES 1
+#define CRUCIBLE_FAULT_COMMAND_BOUNDARY_PROBE 2
+#define CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY 1
+#define CRUCIBLE_FAULT_PHASE_DEVICE 5
+#define CRUCIBLE_FAULT_HARD_PAYLOAD_BYTES 65536
+#define CRUCIBLE_SIM_TICKS_PER_INSTRUCTION 1000
+#define QEMU_CRUCIBLE_FAULT_STATUS_DEFERRED_INTERNAL UINT16_MAX
+#define CRUCIBLE_FAULT_STATUS_APPLIED 1
+#define CRUCIBLE_FAULT_STATUS_PREPARED 2
+#define CRUCIBLE_FAULT_STATUS_MALFORMED_COMMAND 3
+#define CRUCIBLE_FAULT_STATUS_DUPLICATE_SEQUENCE 4
+#define CRUCIBLE_FAULT_STATUS_UNSUPPORTED_CAPABILITY 5
+#define CRUCIBLE_FAULT_STATUS_INVALID_PHASE 6
+#define CRUCIBLE_FAULT_STATUS_RESOURCE_LIMIT 7
+#define CRUCIBLE_FAULT_STATUS_GUEST_REJECTED 8
+#define CRUCIBLE_FAULT_STATUS_NOT_APPLICABLE 9
+#define CRUCIBLE_FAULT_STATUS_PAST_BOUNDARY 10
+#define CRUCIBLE_FAULT_STATUS_INTERNAL_ERROR 11
+#define CRUCIBLE_COMMAND_VMSTATE_MAGIC "CRUFCMD4"
+#define CRUCIBLE_COMMAND_VMSTATE_VERSION 4
+#define CRUCIBLE_COMMAND_VMSTATE_HEADER_BYTES 96
+#define CRUCIBLE_INSTRUCTION_MAX_BYTES 32
+#define CRUCIBLE_INSTRUCTION_MAX_DESTINATIONS 4
