+int qemu_plugin_crucible_source_control_stop_intent_current_v1(
+    QemuCrucibleSourceControlStopIntent *intent, bool admission)
+{
+    int status = control_stop_identity(intent);
+    int state;
+
+    if (status) {
+        return status;
+    }
+    if (intent->first_status || intent->post_status) {
+        return intent->first_status ? intent->first_status : intent->post_status;
+    }
+    if (intent->invocation->first_status || intent->invocation->post_status ||
+        intent->invocation->binding->first_status) {
+        return intent->invocation->first_status ? intent->invocation->first_status :
+               intent->invocation->post_status ? intent->invocation->post_status :
+               intent->invocation->binding->first_status;
+    }
+    if (admission) {
+        if (intent->admitted || intent->completion_attempted ||
+            control_stop_storage.dispatch.phase != CONTROL_DISPATCH_CALLING ||
+            control_stop_storage.dispatch.invocation != intent->invocation) {
+            return -EPERM;
+        }
+        return qemu_crucible_source_control_invocation_current_v1(
+            intent->invocation, true);
+    }
+    /* The retained invocation supplies identity. These journals qualify only
+     * the effects actually reached under that same lender, not global Paused.
+     */
+    if (!intent->admitted || !intent->admitted_generation ||
+        intent->admitted_generation !=
+            qatomic_read(&qemu_plugin_crucible_vmstop_generation_value) ||
+        qemu_plugin_crucible_vmstop_cold_admitted) {
+        return -ENOKEY;
+    }
+    state = qatomic_read(&qemu_plugin_crucible_vmstop_state);
+    if (!intent->completion_attempted) {
+        return state == QEMU_PLUGIN_CRUCIBLE_VMSTOP_ADMITTED ? 0 : -ESTALE;
+    }
+    if (!qemu_thread_is_self(&intent->completion_thread) || intent->flush_status ||
+        intent->completed_generation != intent->admitted_generation) {
+        return intent->flush_status ? intent->flush_status : -ESTALE;
+    }
+    return state == QEMU_PLUGIN_CRUCIBLE_VMSTOP_STOPPED ||
+           state == QEMU_PLUGIN_CRUCIBLE_VMSTOP_RESUME_PENDING ? 0 : -ESTALE;
+}
