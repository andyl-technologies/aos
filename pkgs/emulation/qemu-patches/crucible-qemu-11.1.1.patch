+static uint8_t *family_row(uint8_t *wire, size_t index)
+{
+    return wire + QEMU_CRUCIBLE_PROCESS_FAMILY_OFFSET +
+        QEMU_CRUCIBLE_PROCESS_FAMILY_ROWS_OFFSET +
+        index * QEMU_CRUCIBLE_PROCESS_FAMILY_ROW_BYTES;
+}
