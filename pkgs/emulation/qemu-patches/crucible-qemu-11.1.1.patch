+bool x86_cpu_validate_fault_exception(
+    CPUState *cs, const CPUFaultException *exception)
+{
+    CPUX86State *env = cpu_env(cs);
+    bool has_error_code;
+    bool supported;
+    bool syndrome_valid;
+
+    if (exception->architecture == CPU_FAULT_EXCEPTION_X86_64 &&
+        exception->record == CPU_FAULT_EXCEPTION_X86_MACHINE_CHECK) {
+        const uint64_t status_flags = MCI_STATUS_VAL | MCI_STATUS_OVER |
+            MCI_STATUS_UC | MCI_STATUS_EN | MCI_STATUS_MISCV |
+            MCI_STATUS_ADDRV | MCI_STATUS_PCC | MCI_STATUS_S |
+            MCI_STATUS_AR | MCI_STATUS_DEFERRED | MCI_STATUS_POISON;
+        const uint64_t global_flags = MCG_STATUS_RIPV | MCG_STATUS_EIPV |
+            MCG_STATUS_MCIP | MCG_STATUS_LMCE;
+        const unsigned banks = env->mcg_cap & 0xff;
+        const uint64_t status = exception->x86_machine_check.status;
+        const uint64_t global =
+            exception->x86_machine_check.global_status;
+        const bool corrected = exception->x86_machine_check.corrected;
+        const bool uc = status & MCI_STATUS_UC;
+        const bool signaled = status & MCI_STATUS_S;
+        const bool action_required = status & MCI_STATUS_AR;
+        const bool context_corrupt = status & MCI_STATUS_PCC;
+        const bool local = global & MCG_STATUS_LMCE;
+
+        return env->mcg_cap && exception->vector == EXCP12_MCHK &&
+            exception->syndrome == 0 && !exception->maskable &&
+            !(cs->interrupt_request & CPU_INTERRUPT_MCE) &&
+            exception->x86_machine_check.bank < banks &&
+            (status & MCI_STATUS_VAL) &&
+            !(status & MCI_STATUS_OVER) &&
+            !(status & ~(status_flags | UINT64_C(0xffffffff))) &&
+            !(global & ~global_flags) &&
+            (corrected ? global == 0 : !!(global & MCG_STATUS_MCIP)) &&
+            corrected == !uc &&
+            (!corrected ||
+             !(status & (MCI_STATUS_S | MCI_STATUS_AR |
+                         MCI_STATUS_PCC | MCI_STATUS_DEFERRED |
+                         MCI_STATUS_POISON))) &&
+            (!signaled || uc) &&
+            (!action_required ||
+             (uc && signaled && !(status & MCI_STATUS_DEFERRED) &&
+              (global & (MCG_STATUS_RIPV | MCG_STATUS_EIPV)) ==
+                  (MCG_STATUS_RIPV | MCG_STATUS_EIPV))) &&
+            (!context_corrupt ||
+             (uc && !(global & (MCG_STATUS_RIPV | MCG_STATUS_EIPV)))) &&
+            !(status & MCI_STATUS_DEFERRED) &&
+            (!(global & MCG_STATUS_EIPV) ||
+             (global & MCG_STATUS_RIPV)) &&
+            (!local ||
+             ((env->mcg_cap & MCG_LMCE_P) &&
+              (env->mcg_ext_ctl & MCG_EXT_CTL_LMCE_EN))) &&
+            exception->x86_machine_check.has_address ==
+                !!(status & MCI_STATUS_ADDRV) &&
+            exception->x86_machine_check.has_misc ==
+                !!(status & MCI_STATUS_MISCV) &&
+            exception->has_fault_address ==
+                exception->x86_machine_check.has_address &&
+            (!exception->has_fault_address ||
+             exception->fault_address ==
+                 exception->x86_machine_check.address) &&
+            (exception->x86_machine_check.corrected ||
+             ((env->cr[4] & CR4_MCE_MASK) &&
+              !(env->mcg_status & MCG_STATUS_MCIP) &&
+              (!(env->mcg_cap & MCG_CTL_P) ||
+               env->mcg_ctl == UINT64_MAX) &&
+              env->mce_banks[4 * exception->x86_machine_check.bank] ==
+                  UINT64_MAX));
+    }
+    has_error_code = exception->vector == EXCP0A_TSS ||
+                     exception->vector == EXCP0B_NOSEG ||
+                     exception->vector == EXCP0C_STACK ||
+                     exception->vector == EXCP0D_GPF ||
+                     exception->vector == EXCP0E_PAGE;
+    supported = exception->vector == EXCP00_DIVZ ||
+                exception->vector == EXCP01_DB ||
+                exception->vector == EXCP03_INT3 ||
+                exception->vector == EXCP04_INTO ||
+                exception->vector == EXCP05_BOUND ||
+                exception->vector == EXCP06_ILLOP ||
+                exception->vector == EXCP07_PREX ||
+                exception->vector == EXCP0A_TSS ||
+                exception->vector == EXCP0B_NOSEG ||
+                exception->vector == EXCP0C_STACK ||
+                exception->vector == EXCP0D_GPF ||
+                exception->vector == EXCP0E_PAGE ||
+                exception->vector == EXCP10_COPR ||
+                exception->vector == EXCP11_ALGN ||
+                exception->vector == 19;
+    if (exception->vector == EXCP0E_PAGE) {
+        const uint32_t page_error_mask = 0x7f | (1U << 15);
+
+        syndrome_valid = exception->syndrome <= UINT32_MAX &&
+            !(exception->syndrome & ~page_error_mask) &&
+            exception->has_fault_address;
+    } else if (has_error_code) {
+        syndrome_valid = exception->syndrome <= UINT16_MAX &&
+            !exception->has_fault_address;
+    } else {
+        syndrome_valid = exception->syndrome == 0 &&
+            !exception->has_fault_address;
+    }
+    return exception->architecture == CPU_FAULT_EXCEPTION_X86_64 &&
+           exception->record == CPU_FAULT_EXCEPTION_ARCHITECTURE_DEFAULT &&
+           supported && syndrome_valid && !exception->maskable;
+}
