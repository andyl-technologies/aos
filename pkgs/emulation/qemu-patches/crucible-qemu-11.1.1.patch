+static int fixture_provider_acquire(
+    qemu_plugin_id_t id, QemuCrucibleCheckpointRequestLoan *request,
+    void *userdata, void **out)
+{
+    uint64_t now;
+
+    g_assert_cmpuint(id, ==, fixture_ctx.id);
+    g_assert_true(request == &checkpoint_request);
+    g_assert_true(userdata == &model_userdata);
+    g_assert_nonnull(out);
+    g_assert_null(*out);
+    g_assert_true(request->provider_invoking);
+    provider_acquires++;
+    if (!provider_acquire_status || provider_output_on_failure) {
+        *out = &external_provider;
+    }
+
+    /* Adverse mutations occur after real pending alias adoption, before the
+     * literal begin constructor calls receive. None grants an owner. */
+    if (inject_malformed) {
+        request->original_wire[0] ^= 1;
+    }
+    if (inject_expired) {
+        g_assert_cmpint(checkpoint_now(&now), ==, 0);
+        stq_be_p(request->original_wire + 56, now - 2);
+        stq_be_p(request->original_wire + 64, now - 1);
+    }
+    if (inject_identity_mismatch) {
+        request->cancellation_event_id++;
+    }
+    if (inject_cancelled) {
+        uint64_t one = 1;
+
+        g_assert_cmpint(write(event_fd, &one, sizeof(one)), ==, sizeof(one));
+    }
+    fail_reader_close = inject_close_uncertain;
+    return provider_acquire_status;
+}
