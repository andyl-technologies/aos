+    }
+
+    initialize_clock(false);
+    observed_ps = 357000;
+    bytes = save_in_exact_process(wide);
+    restored = ptimer_init(observe_expiry, NULL, PTIMER_POLICY_LEGACY);
+    timer_mod_ns(restored->timer, 5555);
+    if (wide) {
+        g_assert_cmpint(load_state(restored, bytes), <, 0);
+        g_assert_cmpuint(timer_expire_time_ns(restored->timer), ==, 5555);
+    } else {
+        g_assert_cmpint(load_state(restored, bytes), ==, 0);
+        g_assert_cmpuint(timer_expire_time_ns(restored->timer), ==, 358);
+        g_assert_cmpuint(ptimer_get_count(restored), ==, 1);
+        observed_ps = 358000;
+        qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL);
+        g_assert_cmpuint(callbacks, ==, 1);
+    }
+    ptimer_free(restored);
+    g_byte_array_unref(bytes);
+}
+
+static int encode_exact_stream(const char *path, bool wide)
+{
+    ptimer_state *timer;
+    GByteArray *bytes;
+    GError *error = NULL;
+
+    initialize_clock(true);
+    observed_ps = wide ? ((__int128)1 << 120) + 357 : 357000;
+    timer = create_countdown(1);
+    bytes = save_state(timer);
+    g_assert_true(g_file_set_contents(path, (const char *)bytes->data,
+                                      bytes->len, &error));
+    g_assert_no_error(error);
+    g_byte_array_unref(bytes);
+    ptimer_free(timer);
+    return 0;
+}
+
+int main(int argc, char **argv)
+{
+    test_executable = argv[0];
+    if (argc == 4 && !strcmp(argv[1], "--encode-stream")) {
+        return encode_exact_stream(argv[2], !strcmp(argv[3], "wide"));
+    }
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/ptimer/wide-origin", test_wide_origin);
+    g_test_add_func("/ptimer/wide-migration", test_wide_migration);
+    g_test_add_func("/ptimer/long-countdown", test_long_countdown);
+    g_test_add_func("/ptimer/full-horizon", test_full_horizon);
+    g_test_add_func("/ptimer/deadline-overflow", test_deadline_overflow);
+    g_test_add_func("/ptimer/negative-origin", test_negative_origin);
+    g_test_add_func("/ptimer/ordinary-migration", test_ordinary_migration);
+    g_test_add_func("/ptimer/periodic-fraction", test_periodic_fraction);
+    g_test_add_data_func("/ptimer/cross-mode/narrow", GINT_TO_POINTER(false),
+                         test_cross_mode);
+    g_test_add_data_func("/ptimer/cross-mode/wide", GINT_TO_POINTER(true),
+                         test_cross_mode);
+    g_test_add_data_func("/ptimer/zero-period/inactive-exact",
+                         GINT_TO_POINTER(true), test_inactive_zero_period);
+    g_test_add_data_func("/ptimer/zero-period/inactive-ordinary",
+                         GINT_TO_POINTER(false), test_inactive_zero_period);
+    const char *names[] = { "missing-exact", "invalid-mode", "invalid-active",
+                            "invalid-projection", "invalid-deadline",
+                            "reversed-events", "duplicate-exact",
+                            "truncated-exact", "inactive-payload",
+                            "zero-period" };
+
+    for (size_t i = 0; i < G_N_ELEMENTS(names); i++) {
+        char *path = g_strdup_printf("/ptimer/migration/%s", names[i]);
+
+        g_test_add_data_func(path, GINT_TO_POINTER(i), test_invalid_stream);
+        g_free(path);
+    }
+    return g_test_run();
+}
diff --git a/tests/unit/test-crucible-publisher-initial-state.py b/tests/unit/test-crucible-publisher-initial-state.py
new file mode 100644
index 0000000000000000000000000000000000000000..74a2182664644d826f76b314399b288e14004c72
--- /dev/null
+++ b/tests/unit/test-crucible-publisher-initial-state.py
@@ -0,0 +1,165 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Check actual initial-zero and later header atomic-copy leaves.
+
+Local mapped-word and journal inputs exercise physical leaves only. They do not
+construct a paid session, recipient, module owner, Original or selected entry.
+Every omission is independently rebuilt against the same unchanged assertions.
+"""
+
+import argparse
+import json
+import os
+from pathlib import Path
+import resource
+import runpy
+import shlex
+import subprocess
+
+
+CHECKS = r'''
+int main(void)
+{
+    uint64_t words[QEMU_CRUCIBLE_PUBLISHER_REGION_BYTES / 8] = { 0 };
+    PreexecPublisherSessionJournal session = { 0 };
+
+    session.mapping.address = words;
+    session.mapping.requested_bytes = sizeof(words);
+    session.mapping.backing_bytes = sizeof(words);
+    session.mapping.retained = true;
+    session.mapping.dontfork = true;
+    assert(!preexec_publisher_mapping_initial_zero(&session));
+
+    session.mapping.retained = false;
+    assert(preexec_publisher_mapping_initial_zero(&session) == -ESTALE);
+    session.mapping.retained = true;
+    session.mapping.dontfork = false;
+    assert(preexec_publisher_mapping_initial_zero(&session) == -ESTALE);
+    session.mapping.dontfork = true;
+    session.mapping.unmap_attempted = true;
+    assert(preexec_publisher_mapping_initial_zero(&session) == -ESTALE);
+    session.mapping.unmap_attempted = false;
+    session.mapping.requested_bytes--;
+    assert(preexec_publisher_mapping_initial_zero(&session) == -ESTALE);
+    session.mapping.requested_bytes++;
+
+    session.mapping.backing_bytes--;
+    assert(preexec_publisher_mapping_initial_zero(&session) == -ESTALE);
+    session.mapping.backing_bytes++;
+    session.mapping.address = NULL;
+    assert(preexec_publisher_mapping_initial_zero(&session) == -ESTALE);
+    session.mapping.address = (void *)((uintptr_t)words + 1);
+    assert(preexec_publisher_mapping_initial_zero(&session) == -ESTALE);
+    session.mapping.address = (void *)(UINTPTR_MAX - 7);
+    assert(preexec_publisher_mapping_initial_zero(&session) == -ESTALE);
+    session.mapping.address = words;
+
+    /* Initial zero covers the first and last words of every mutable span. */
+    const size_t boundaries[] = { 256, 1784, 1792, 2296, 2304, 2808 };
+    for (size_t index = 0; index < G_N_ELEMENTS(boundaries); index++) {
+        words[boundaries[index] / 8] = 1;
+        assert(preexec_publisher_mapping_initial_zero(&session) == -EPROTO);
+        words[boundaries[index] / 8] = 0;
+    }
+
+    /* Header observation is not an initial-state or operation predicate. */
+    session.observation.kind = PREEXEC_PUBLISHER_OBSERVE_HEADER;
+    words[0] = 42;
+    for (size_t index = 256 / 8; index < 2816 / 8; index++) {
+        words[index] = 1;
+    }
+    assert(!preexec_publisher_observation_copy(&session, 0, 256));
+    assert(!preexec_publisher_observation_final(&session, 0));
+    assert(session.snapshot[0] == 42);
+
+    for (size_t index = 2816 / 8; index < G_N_ELEMENTS(words); index++) {
+        words[index] = 1;
+        assert(preexec_publisher_observation_copy(&session, 0, 256) == -EPROTO);
+        assert(preexec_publisher_observation_final(&session, 0) == -EPROTO);
+        words[index] = 0;
+    }
+    assert(!preexec_publisher_observation_copy(&session, 0, 256));
+    words[0]++;
+    assert(preexec_publisher_observation_final(&session, 0) == -ESTALE);
+    words[0]--;
+    assert(!preexec_publisher_observation_final(&session, 0));
+    puts("PASS initial-zero/header leaves; no canonical paid constructor or recipient");
+    return 0;
+}
+'''
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("source", type=Path)
+    parser.add_argument("output", type=Path)
+    args = parser.parse_args()
+    source = args.source.resolve()
+    output = args.output.resolve()
+    output.mkdir(parents=True, exist_ok=True)
+    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
+
+    extract = runpy.run_path(str(source / "tests/unit/extract-crucible-startup-source-controls.py"))
+    session = (source / "system/crucible-preexec-publisher-session.inc.h").read_text()
+    setup = (source / "system/crucible-preexec-setup.c").read_text()
+    names = ("preexec_publisher_observation_sequence", "preexec_publisher_observation_copy",
+             "preexec_publisher_observation_final", "preexec_publisher_mapping_initial_zero")
+    bodies = "\n\n".join(extract["function"](session, "static int " + name + "(")
+                            for name in names)
+    before = ('#include "qemu/osdep.h"\n'
+              '#include "plugins/crucible-startup-source.h"\n'
+              '#include "qemu/crucible-publisher-protocol.h"\n'
+              '#include "system/crucible-preexec-publisher-storage.inc.h"\n' +
+              extract["function"](setup, "static uint32_t preexec_setup_be32(") + "\n" +
+              extract["function"](setup, "static uint64_t preexec_setup_be64("))
+    controls = {"positive": bodies}
+    for field in ("retained", "dontfork"):
+        controls["omit-" + field] = bodies.replace("!mapping->" + field + " ||", "false ||")
+    controls["omit-unmap"] = bodies.replace("mapping->unmap_attempted ||", "false ||")
+    controls["omit-exact-extent"] = bodies.replace(
+        "mapping->requested_bytes != QEMU_CRUCIBLE_PUBLISHER_REGION_BYTES", "false")
+    controls["omit-backing-extent"] = bodies.replace(
+        "mapping->backing_bytes < QEMU_CRUCIBLE_PUBLISHER_REGION_BYTES ||", "false ||")
+    controls["omit-initial-first-word"] = bodies.replace(
+        "index = QEMU_CRUCIBLE_PUBLISHER_HEADER_BYTES / 8;", "index = 264 / 8;")
+    controls["omit-initial-last-word"] = bodies.replace("index < 2816 / 8;", "index < 2808 / 8;")
+    controls["omit-initial-zero"] = bodies.replace(
+        "if (__atomic_load_n(mapping->address + index, __ATOMIC_SEQ_CST))", "if (false)")
+    controls["omit-reserved-copy"] = bodies.replace(
+        "if (__atomic_load_n(session->mapping.address + index, __ATOMIC_SEQ_CST))",
+        "if (false)", 1)
+    start = bodies.index("static int preexec_publisher_observation_final(")
+    controls["omit-reserved-final"] = bodies[:start] + bodies[start:].replace(
+        "if (__atomic_load_n(session->mapping.address + index, __ATOMIC_SEQ_CST))",
+        "if (false)", 1)
+    controls["omit-header-final"] = bodies.replace(
+        "session->snapshot[index])", "session->mapping.address[index])")
+
+    proof = {}
+    for name, body in controls.items():
+        if name != "positive" and body == bodies:
+            raise ValueError("unchanged omission: " + name)
+        c_file = output / (name + ".c")
+        binary = output / name
+        c_file.write_text(before + "\n" + body + "\n" + CHECKS)
+        command = [os.environ.get("CC", "cc"), *shlex.split(os.environ.get("CFLAGS", "")),
+                   str(c_file), "-o", str(binary),
+                   *shlex.split(os.environ.get("LDFLAGS", ""))]
+        (output / (name + ".command.json")).write_text(json.dumps(command, indent=2) + "\n")
+        compiled = subprocess.run(command, text=True, stdout=subprocess.PIPE,
+                                  stderr=subprocess.STDOUT)
+        (output / (name + ".compile.log")).write_text(compiled.stdout)
+        compiled.check_returncode()
+        result = subprocess.run([str(binary)], text=True, stdout=subprocess.PIPE,
+                                stderr=subprocess.STDOUT, timeout=30)
+        (output / (name + ".log")).write_text(result.stdout)
+        expected = 0 if name == "positive" else -6
+        if result.returncode != expected:
+            raise RuntimeError(f"{name}: expected {expected}, got {result.returncode}")
+        proof[name] = {"returncode": result.returncode, "output": result.stdout}
+    (output / "proof.json").write_text(json.dumps(proof, indent=2) + "\n")
+    print(proof["positive"]["output"], end="")
+    print(f"PASS {len(controls) - 1} independently rebuilt omissions")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/unit/test-crucible-publisher-member-return.py b/tests/unit/test-crucible-publisher-member-return.py
