index 0000000000000000000000000000000000000000..9b0020ffe5b924aeb1544f62ee19c0e9201a0861
--- /dev/null
+++ b/tests/unit/test-crucible-snapshot-fast-path.py
@@ -0,0 +1,371 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Exercise production snapshot continuation and RR restoration bodies.
+
+CPU topology, accelerator identity and raw icount are bounded providers. The
+production TimersState fields, predicate, genesis, resume, selection and VMState
+post-load bodies execute unchanged. No translated guest or migration stream is
+executed; TB shape and scheduling code are outside this change.
+"""
+
+import argparse
+import json
+import os
+from pathlib import Path
+import runpy
+import shlex
+import subprocess
+
+
+ROOT = Path(__file__).resolve().parents[2]
+definition = runpy.run_path(str(Path(__file__).with_name(
+    "test-crucible-net-output-stop.py")))["definition"]
+
+PRELUDE = r"""
+#include <errno.h>
+#include <limits.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <glib.h>
+#include "qemu/typedefs.h"
+#define qemu_build_assert(condition) _Static_assert(condition, #condition)
+#include "qemu/atomic.h"
+
+/* Lock layout is irrelevant to these single-threaded, field-only bodies. */
+typedef struct { int unused; } QemuSeqLock;
+struct QemuSpin { int unused; };
+#include "system/cpu-timers-internal.h"
+
+struct CPUState {
+    CPUState *next;
+    int cpu_index;
+    bool runnable, halted, work;
+};
+#define CPU_NEXT(cpu) ((cpu)->next)
+#define CRUCIBLE_SIM_TICKS_PER_INSTRUCTION 1000
+
+uint64_t icount_crucible_rr_switch_quantum(void);
+uint64_t icount_crucible_rr_current_vcpu(void);
+uint64_t icount_crucible_rr_cursor_position(void);
+bool icount_crucible_rr_snapshot_continuation(void);
+void icount_crucible_rr_snapshot_resume_prepare(void);
+void icount_crucible_rr_initialize_genesis(CPUState *cpu);
+CPUState *icount_crucible_rr_select_cpu(CPUState *suggested);
+bool icount_crucible_sim_mode(void);
+
+TimersState timers_state;
+static uint64_t crucible_rr_switch_quantum;
+static bool crucible_rr_snapshot_continuation;
+static ICountMode use_icount = ICOUNT_PRECISE;
+static CPUState cpus[2];
+static CPUState *first_cpu = &cpus[0];
+static const char *accel_name = "sim";
+static unsigned int accel_reads, raw_reads, error_reports, handoffs;
+
+/* Count identity lookups at the same provider called by the real predicate. */
+static const char *current_accel_name(void)
+{
+    accel_reads++;
+    return accel_name;
+}
+
+static bool current_accel_is_sim(void)
+{
+    return strcmp(current_accel_name(), "sim") == 0;
+}
+
+static int64_t icount_get_raw(void)
+{
+    raw_reads++;
+    return timers_state.qemu_icount;
+}
+
+static ICountMode icount_enabled(void)
+{
+    return use_icount;
+}
+
+static CPUState *qemu_get_cpu(uint64_t index)
+{
+    return index < G_N_ELEMENTS(cpus) ? &cpus[index] : NULL;
+}
+
+static bool cpu_can_run(CPUState *cpu)
+{
+    return cpu->runnable;
+}
+
+static bool cpu_has_work(CPUState *cpu)
+{
+    return cpu->work;
+}
+
+static void qemu_plugin_fire_rr_handoff_cb(uint32_t from, uint32_t to,
+                                         uint64_t quantum, uint64_t delta)
+{
+    (void)from;
+    (void)to;
+    (void)quantum;
+    (void)delta;
+    handoffs++;
+}
+
+/* Invalid model inputs report errors without terminating the fixture. */
+#define error_report(...) ((void)error_reports++)
+"""
+
+CHECKS = r"""
+static void reset(void)
+{
+    memset(&timers_state, 0, sizeof(timers_state));
+    cpus[0] = (CPUState) { .cpu_index = 0, .runnable = true,
+                          .next = &cpus[1] };
+    cpus[1] = (CPUState) { .cpu_index = 1, .runnable = true };
+    accel_name = "sim";
+    crucible_rr_switch_quantum = 17;
+    crucible_rr_snapshot_continuation = false;
+    use_icount = ICOUNT_PRECISE;
+    accel_reads = raw_reads = error_reports = handoffs = 0;
+}
+
+static void truth_table(void)
+{
+    const char *names[] = { "sim", "tcg", "kvm" };
+    uint64_t quanta[] = { 0, 1, 17, UINT64_MAX };
+    unsigned int cases = 0;
+
+    reset();
+    for (unsigned int continuation = 0; continuation < 2; continuation++) {
+        for (size_t name = 0; name < G_N_ELEMENTS(names); name++) {
+            for (size_t quantum = 0; quantum < G_N_ELEMENTS(quanta); quantum++) {
+                crucible_rr_snapshot_continuation = continuation;
+                accel_name = names[name];
+                crucible_rr_switch_quantum = quanta[quantum];
+                bool expected = continuation && !strcmp(accel_name, "sim") &&
+                                crucible_rr_switch_quantum != 0;
+
+                g_assert_cmpint(icount_crucible_rr_snapshot_continuation(),
+                                ==, expected);
+                cases++;
+            }
+        }
+    }
+    g_assert_cmpuint(cases, ==, 24);
+    puts("PASS production snapshot fast path: 24 continuation/accelerator/quantum truth-table cases");
+}
+
+static void cold_checks(void)
+{
+    const char *names[] = { "sim", "tcg", "kvm" };
+    uint64_t quanta[] = { 0, 17 };
+
+    reset();
+    for (size_t name = 0; name < G_N_ELEMENTS(names); name++) {
+        for (size_t quantum = 0; quantum < G_N_ELEMENTS(quanta); quantum++) {
+            accel_name = names[name];
+            crucible_rr_switch_quantum = quanta[quantum];
+            for (unsigned int call = 0; call < 10000; call++) {
+                g_assert_false(icount_crucible_rr_snapshot_continuation());
+            }
+        }
+    }
+    /* The old operand order has the same results but fails this assertion. */
+    g_assert_cmpuint(accel_reads, ==, 0);
+    g_assert_cmpuint(raw_reads, ==, 0);
+    puts("PASS production snapshot fast path: 60000 cold calls, zero accelerator/raw-icount reads");
+}
+
+static void assert_cursor(uint64_t owner, uint64_t position, bool pending)
+{
+    g_assert_true(timers_state.crucible_rr_cursor_valid);
+    g_assert_cmpuint(icount_crucible_rr_current_vcpu(), ==, owner);
+    g_assert_cmpuint(icount_crucible_rr_cursor_position(), ==, position);
+    g_assert_cmpint(timers_state.crucible_rr_selection_pending, ==, pending);
+}
+
+static void active_checks(void)
+{
+    reset();
+    icount_crucible_rr_initialize_genesis(NULL);
+    g_assert_false(timers_state.crucible_rr_cursor_valid);
+    icount_crucible_rr_snapshot_resume_prepare();
+    g_assert_false(crucible_rr_snapshot_continuation);
+
+    accel_name = "tcg";
+    icount_crucible_rr_initialize_genesis(&cpus[1]);
+    g_assert_false(timers_state.crucible_rr_cursor_valid);
+    accel_name = "sim";
+    crucible_rr_switch_quantum = 0;
+    icount_crucible_rr_initialize_genesis(&cpus[1]);
+    g_assert_false(timers_state.crucible_rr_cursor_valid);
+    crucible_rr_switch_quantum = 17;
+    icount_crucible_rr_initialize_genesis(&cpus[1]);
+    assert_cursor(1, 0, false);
+    g_assert_false(crucible_rr_snapshot_continuation);
+    g_assert_cmpuint(raw_reads, ==, 1);
+
+    timers_state.qemu_icount = 40;
+    timers_state.crucible_rr_cursor_position = 7;
+    /* A valid loaded cursor makes genesis a no-op, even at nonzero icount. */
+    icount_crucible_rr_initialize_genesis(&cpus[0]);
+    assert_cursor(1, 7, false);
+    g_assert_cmpuint(raw_reads, ==, 1);
+
+    accel_name = "tcg";
+    icount_crucible_rr_snapshot_resume_prepare();
+    assert_cursor(1, 7, false);
+    g_assert_false(crucible_rr_snapshot_continuation);
+    accel_name = "sim";
+    crucible_rr_switch_quantum = 0;
+    icount_crucible_rr_snapshot_resume_prepare();
+    assert_cursor(1, 7, false);
+    g_assert_false(crucible_rr_snapshot_continuation);
+    crucible_rr_switch_quantum = 17;
+    icount_crucible_rr_snapshot_resume_prepare();
+    assert_cursor(1, 7, true);
+
+    unsigned int reads = accel_reads;
+    for (unsigned int call = 0; call < 100; call++) {
+        g_assert_true(icount_crucible_rr_snapshot_continuation());
+    }
+    g_assert_cmpuint(accel_reads - reads, ==, 100);
+    g_assert_true(crucible_rr_snapshot_continuation);
+    g_assert_true(icount_crucible_rr_select_cpu(&cpus[0]) == &cpus[1]);
+    assert_cursor(1, 7, true);
+    g_assert_cmpuint(handoffs, ==, 0);
+    g_assert_cmpint(timers_state.qemu_icount, ==, 40);
+    puts("PASS production snapshot fast path: genesis/resume/select preserve owner 1, intra-turn 7, icount 40, sticky continuation");
+}
+
+static void loaded_state(void)
+{
+    reset();
+    timers_state.icount_mode_migration = ICOUNT_PRECISE;
+    timers_state.icount_sim_mode_migration = true;
+    timers_state.crucible_rr_cursor_valid = true;
+    timers_state.crucible_rr_current_vcpu = 1;
+    timers_state.crucible_rr_cursor_position = 7;
+    timers_state.qemu_icount = 40;
+}
+
+static void post_load_checks(void)
+{
+    loaded_state();
+    g_assert_cmpint(icount_state_pre_load(&timers_state), ==, 0);
+    g_assert_cmpint(icount_model_post_load(&timers_state, 2), ==, 0);
+    g_assert_cmpint(icount_state_post_load(&timers_state, 5), ==, 0);
+    assert_cursor(1, 7, true);
+    g_assert_true(icount_crucible_rr_snapshot_continuation());
+    icount_crucible_rr_initialize_genesis(&cpus[0]);
+    g_assert_true(icount_crucible_rr_select_cpu(&cpus[0]) == &cpus[1]);
+    assert_cursor(1, 7, true);
+    g_assert_cmpuint(raw_reads, ==, 0);
+    g_assert_cmpuint(handoffs, ==, 0);
+
+    /* Invalid loaded coordinates must not enable continuation or repair state. */
+    for (unsigned int invalid = 0; invalid < 8; invalid++) {
+        loaded_state();
+        g_assert_cmpint(icount_model_post_load(&timers_state, 2), ==, 0);
+        switch (invalid) {
+        case 0: timers_state.icount_model_migration_loaded = false; break;
+        case 1: timers_state.qemu_icount = -1; break;
+        case 2: timers_state.crucible_rr_cursor_valid = false; break;
+        case 3: timers_state.crucible_rr_cursor_position = 17; break;
+        case 4: timers_state.crucible_rr_current_vcpu = 2; break;
+        case 5: timers_state.qemu_icount_bias_ps_hi = 1; break;
+        case 6: timers_state.qemu_icount_bias_ps_lo = 1; break;
+        case 7: timers_state.crucible_sim_tick_bias = -1; break;
+        }
+        TimersState before = timers_state;
+        g_assert_cmpint(icount_state_post_load(&timers_state, 5), ==, -EINVAL);
+        g_assert_cmpmem(&timers_state, sizeof(timers_state), &before, sizeof(before));
+        g_assert_false(crucible_rr_snapshot_continuation);
+    }
+
+    loaded_state();
+    timers_state.qemu_icount = INT64_MAX;
+    g_assert_cmpint(icount_model_post_load(&timers_state, 2), ==, 0);
+    g_assert_cmpint(icount_state_post_load(&timers_state, 5), ==, -EINVAL);
+    g_assert_false(crucible_rr_snapshot_continuation);
+
+    loaded_state();
+    timers_state.icount_sim_mode_migration = false;
+    g_assert_cmpint(icount_model_post_load(&timers_state, 2), ==, -EINVAL);
+    g_assert_cmpuint(error_reports, ==, 1);
+    g_assert_false(crucible_rr_snapshot_continuation);
+
+    loaded_state();
+    crucible_rr_switch_quantum = 0;
+    g_assert_cmpint(icount_model_post_load(&timers_state, 2), ==, 0);
+    g_assert_cmpint(icount_state_post_load(&timers_state, 5), ==, 0);
+    assert_cursor(1, 7, false);
+    g_assert_false(crucible_rr_snapshot_continuation);
+    puts("PASS production snapshot fast path: VMState post-load preserves restored cursor, rejects invalid coordinates, avoids eager reset");
+}
+
+int main(void)
+{
+    truth_table();
+    cold_checks();
+    active_checks();
+    post_load_checks();
+    return 0;
+}
