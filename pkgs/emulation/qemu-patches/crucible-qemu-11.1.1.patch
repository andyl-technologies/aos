+/*
+ * ACPI fingerprint projection tests
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+
+#include "hw/isa/lpc-ich9-fingerprint.h"
+#include "hw/acpi/generic-event-device-fingerprint.h"
+#include "hw/acpi/piix4-fingerprint.h"
