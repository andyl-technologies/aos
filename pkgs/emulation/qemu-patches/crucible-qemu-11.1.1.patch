+static void node_memory_shadow_state_commit(
+    QemuCrucibleFaultRule *original, QemuCrucibleFaultRule *shadow)
+{
+    original->opportunity_count = shadow->opportunity_count;
+    original->applied_count = shadow->applied_count;
+    original->last_exposure_tick = shadow->last_exposure_tick;
+    original->retention_next_tick = shadow->retention_next_tick;
+    original->exposure_initialized = shadow->exposure_initialized;
+    original->retention_scheduled = shadow->retention_scheduled;
+    original->translation_error_reported =
+        shadow->translation_error_reported;
+    original->evidence_mutation_count = shadow->evidence_mutation_count;
+    original->evidence_mutation_bytes = shadow->evidence_mutation_bytes;
+    memcpy(original->evidence_mutation_hash,
+           shadow->evidence_mutation_hash,
+           sizeof(original->evidence_mutation_hash));
+    original->evidence_aggressor = shadow->evidence_aggressor;
+    original->evidence_counter_before = shadow->evidence_counter_before;
+    original->evidence_counter_after = shadow->evidence_counter_after;
+    original->evidence_victim_rows = shadow->evidence_victim_rows;
+
+    g_clear_pointer(&original->retention_cells, g_hash_table_unref);
+    original->retention_cells = shadow->retention_cells;
+    shadow->retention_cells = NULL;
+    g_clear_pointer(&original->row_counters, g_hash_table_unref);
+    original->row_counters = shadow->row_counters;
+    shadow->row_counters = NULL;
+    g_clear_pointer(&original->evidence_mutation_records,
+                    g_byte_array_unref);
+    original->evidence_mutation_records = shadow->evidence_mutation_records;
+    shadow->evidence_mutation_records = NULL;
+    g_clear_pointer(&original->evidence_counter_records,
+                    g_byte_array_unref);
+    original->evidence_counter_records = shadow->evidence_counter_records;
+    shadow->evidence_counter_records = NULL;
+}
