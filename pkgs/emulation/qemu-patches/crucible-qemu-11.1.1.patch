+/* Source authenticates the actual retained registrar before any Native or
+ * plugin lock. A view only corroborates this owning cut; it cannot create it. */
+#ifndef CONFIG_USER_ONLY
+static void registrar_prepare(QemuCrucibleNativeRegistrar *registrar, int first)
+{
+    QemuCrucibleCallbackPublicationView view = { 0 };
+    QemuCrucibleNativeInvocationRegistry *registry;
+    pid_t process = getpid();
+    int status;
+
+    registrar->first_status = first;
+    if (!registrar->borrow) {
+        return;
+    }
+    status = qemu_crucible_startup_source_callback_registration_observe_v1(
+        registrar->borrow, registrar->serial, &view);
+    if (status) {
+        registrar->first_status = first ? first : status;
+        return;
+    }
+    registry = qemu_crucible_startup_source_native_registry_v1(view.ctx, false);
+    if (!registry_process_current(registry, process)) {
+        registrar->first_status = first ? first : -EPERM;
+        return;
+    }
+    status = qemu_crucible_startup_source_callback_registration_current_v1(
+        registrar->borrow, registrar->serial, registrar->family);
+    if (!first) {
+        registrar->first_status = status;
+    }
+    registrar->registry = registry;
+    registrar->owner = view.owner;
+    registrar->ctx = view.ctx;
+    registrar->module = view.module;
+    registrar->publication_serial = view.publication_serial;
+
+    qemu_mutex_lock(&registry->mutex);
+    if (!registry_identity_locked(registry, process) || registry->revoked ||
+        registry->source_registrar || registry->registrar_users ||
+        view.family != registrar->family || view.registrar_serial != registrar->serial ||
+        view.ctx != registry->ctx || view.module != registry->module ||
+        view.runtime != registry->runtime || view.bridge != registry->storage ||
+        view.bridge_holder != registry->storage_holder ||
+        (registry->child_owner && registry->child_owner != view.owner)) {
+        if (!registrar->first_status) {
+            registrar->first_status = -ESTALE;
+        }
+    } else {
+        /* Retain even a negative Source post. Revocation and terminal must
+         * observe the real borrow until its actual Source return succeeds. */
+        registry->child_owner = view.owner;
+        registry->child = view.child;
+        registry->child_holder = view.child_holder;
+        registry->child_address = view.child_address;
+        registry->child_extent = view.child_extent;
+        registry->child_alignment = view.child_alignment;
+        registry->source_registrar = registrar->borrow;
+        registry->source_registrar_serial = registrar->serial;
+        registry->registrar_users++;
+        registry->child_registration_seen = true;
+        registrar->authenticated = !registrar->first_status;
+    }
+    if (registrar->first_status && !registry->first_registration_status) {
+        registry->first_registration_status = registrar->first_status;
+    }
+    qemu_mutex_unlock(&registry->mutex);
+}
+#endif
