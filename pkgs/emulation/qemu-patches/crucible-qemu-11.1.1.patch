+static void test_clean_cohorts(void)
+{
+    uint8_t publication[1536];
+    uint8_t wire[896];
+
+    for (unsigned park = 0; park <= 1; park++) {
+        unsigned primary = park ? 2 : 1;
+
+        for (unsigned planned = primary; planned <= 4; planned++) {
+            unsigned full = (1U << planned) - 1;
+
+            for (unsigned born = 1; born <= full; born++) {
+                for (unsigned projected = 0; projected <= full; projected++) {
+                    if (projected & ~born) {
+                        continue;
+                    }
+                    for (unsigned dirty = 0; dirty <= 1; dirty++) {
+                        bool complete = born == full && projected == full;
+                        int expected = dirty || complete ? 0 : -EPROTO;
+                        int status;
+
+                        publication_vector(publication);
+                        memcpy(wire, publication + 128, sizeof(wire));
+                        memset(wire + 128, 0, 768);
+                        if (park) {
+                            memcpy(wire, "CRUCPRK1", 8);
+                            stl_be_p(wire + 8, 1);
+                            stq_be_p(wire + 96, 7);
+                        }
+                        stl_be_p(wire + 120, primary | (born << 8) |
+                                 (projected << 16) | (dirty << 31));
+                        stl_be_p(wire + 124, planned);
+                        for (unsigned i = 0; i < planned; i++) {
+                            uint8_t *row = wire + 128 + i * 192;
+
+                            if (!(projected & (1U << i))) {
+                                continue;
+                            }
+                            row_vector(row, i >= primary);
+                            if (park && i < primary) {
+                                stl_be_p(row + 48, 6);
+                                stq_be_p(row + 40, 5 + i);
+                            }
+                        }
+                        if (park) {
+                            QemuCrucibleBoundaryParkRecord record;
+                            QemuCrucibleBoundaryParkRecord saved;
+
+                            memset(&record, 0xa5, sizeof(record));
+                            memcpy(&saved, &record, sizeof(saved));
+                            status = qemu_crucible_boundary_park_decode_v1(
+                                wire, sizeof(wire), &record);
+                            g_assert_cmpint(status, ==, expected);
+                            if (status) {
+                                g_assert_cmpmem(&record, sizeof(record),
+                                                &saved, sizeof(saved));
+                            } else {
+                                g_assert_cmpuint(record.born_mask, ==, born);
+                                g_assert_cmpuint(record.projected_mask, ==,
+                                                 projected);
+                                g_assert_cmpint(record.dirty, ==, dirty);
+                            }
+                        } else {
+                            QemuCrucibleBoundaryActionRecord record;
+                            QemuCrucibleBoundaryActionRecord saved;
+
+                            memset(&record, 0xa5, sizeof(record));
+                            memcpy(&saved, &record, sizeof(saved));
+                            status = qemu_crucible_boundary_action_decode_v2(
+                                wire, sizeof(wire), &record);
+                            g_assert_cmpint(status, ==, expected);
+                            if (status) {
+                                g_assert_cmpmem(&record, sizeof(record),
+                                                &saved, sizeof(saved));
+                            } else {
+                                g_assert_cmpuint(record.born_mask, ==, born);
+                                g_assert_cmpuint(record.projected_mask, ==,
+                                                 projected);
+                                g_assert_cmpint(record.dirty, ==, dirty);
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
+
+/* Matched public facts for an independently implemented peer codec. These
+ * bytes describe no issuer, lender receipt or live scheduler publication. */
+static void test_common_vectors(void)
+{
+    uint8_t header[256];
+    uint8_t publication[1536];
+    uint8_t *command = publication + 1024;
+    QemuCruciblePublisherHeaderView header_view;
+    QemuCruciblePublisherPublicationView publication_view;
+
+    header_vector(header);
+    stq_be_p(header + 16, 3);
+    stq_be_p(header + 32, 5);
+    stq_be_p(header + 40, 7);
+    for (size_t i = 0; i < 32; i++) {
+        header[48 + i] = i + 1;
+        header[80 + i] = i + 161;
+    }
+    stl_be_p(header + 112, 2);
+    stl_be_p(header + 116, 4);
+
+    g_assert_cmpint(header_decode(header, sizeof(header), &header_view), ==, 0);
+    g_assert_cmpuint(header_view.lender_generation, ==, 3);
+    g_assert_cmpuint(header_view.account_generation, ==, 5);
+    g_assert_cmpuint(header_view.process_generation, ==, 7);
+    g_assert_cmpuint(header_view.node_index, ==, 2);
+    g_assert_cmpuint(header_view.node_count, ==, 4);
+    for (size_t i = 0; i < 32; i++) {
+        g_assert_cmpuint(header_view.source_capability[i], ==, i + 1);
+        g_assert_cmpuint(header_view.source_reservation[i], ==, i + 161);
+    }
+
+    publication_vector(publication);
+    stq_be_p(command + 16, UINT64_C(0x0102030405060708));
+    stq_be_p(command + 24, UINT64_MAX - 15);
+    stq_be_p(command + 32, UINT64_MAX);
+    stq_be_p(command + 40, 0);
+    stq_be_p(command + 48, UINT64_MAX);
+    stl_be_p(command + 56, 2);
+    stq_be_p(command + 64, UINT64_C(0x1122334455667788));
+    stq_be_p(command + 72, 9);
+    stq_be_p(publication + 128 + 104, UINT64_C(0x1122334455667788));
+
+    g_assert_cmpint(publication_decode(publication, sizeof(publication),
+                                       &publication_view), ==, 0);
+    g_assert_cmpuint(publication_view.command.scheduler_generation, ==,
+                     UINT64_C(0x0102030405060708));
+    g_assert_cmpuint(publication_view.command.initial_raw_icount, ==,
+                     UINT64_MAX - 15);
+    g_assert_cmpuint(publication_view.command.max_advance_raw_icount, ==,
+                     UINT64_MAX);
+    g_assert_cmpuint(publication_view.command.logical_tick_ceiling, ==, 0);
+    g_assert_cmpuint(publication_view.command.native_ceiling_ns, ==, UINT64_MAX);
+    g_assert_cmpuint(publication_view.command.stop_mode, ==, 2);
+    g_assert_cmpuint(publication_view.command.next_idle_generation, ==, 9);
+    g_assert_cmpuint(publication_view.command.command_frontier, ==,
+                     UINT64_C(0x1122334455667788));
+}
+
+int main(int argc, char **argv)
+{
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/publisher/header", test_header);
+    g_test_add_func("/publisher/publication", test_publication);
+    g_test_add_func("/publisher/command", test_command);
+    g_test_add_func("/publisher/return", test_return);
+    g_test_add_func("/publisher/terminal", test_terminal);
+    g_test_add_func("/publisher/generations", test_generations);
+    g_test_add_func("/publisher/geometry", test_geometry);
+    g_test_add_func("/publisher/common-vectors", test_common_vectors);
+    g_test_add_func("/publisher/clean-cohorts", test_clean_cohorts);
+    g_test_add_func("/publisher/park-pair", test_park_pair);
+    return g_test_run();
+}
