+static int research_resident_cancellation_status(int fd)
+{
+#ifdef CONFIG_LINUX
+    struct pollfd cancellation = { .fd = fd, .events = POLLIN };
+    int status;
+
+    if (fcntl(fd, F_GETFD) < 0) {
+        return -errno;
+    }
+    status = poll(&cancellation, 1, 0);
+    if (status < 0) {
+        return -errno;
+    }
+    if (cancellation.revents & (POLLERR | POLLHUP | POLLNVAL)) {
+        return -EBADF;
+    }
+    if (cancellation.revents & POLLIN) {
+        return -ECANCELED;
+    }
+    return cancellation.revents ? -EPROTO : 0;
+#else
+    return -ENOTSUP;
+#endif
+}
