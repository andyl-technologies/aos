+typedef struct NativeMetadataOverlap {
+    QemuCrucibleMetadataBirthLoan loan;
+    QemuSemaphore first_refusal;
+    bool done;
+    unsigned attempts;
+} NativeMetadataOverlap;
+
+static void *native_birth_overlap_finish(void *opaque)
+{
+    NativeMetadataOverlap *overlap = opaque;
+    QemuCrucibleMetadataBirthLoan before;
+
+    memcpy(&before, &overlap->loan, sizeof(before));
+    do {
+        g_assert_cmpint(qemu_crucible_startup_source_ram_metadata_birth_finish(
+                           &overlap->loan), ==, -EPERM);
+        g_assert_cmpmem(&overlap->loan, sizeof(before), &before, sizeof(before));
+        if (!overlap->attempts++) {
+            qemu_sem_post(&overlap->first_refusal);
+        }
+    } while (!qatomic_load_acquire(&overlap->done));
+    return NULL;
+}
+
+static void scenario_native_birth_overlap_finish(void)
+{
+    QemuCrucibleMetadataBirthLoan birth = { 0 };
+    QemuCrucibleMetadataAdmission *allocation;
+    QemuCrucibleMetadataCharge returned;
+    NativeMetadataOverlap overlap = { 0 };
+    QemuThread foreign;
+
+    fixture_inventory_purpose();
+    g_assert_cmpint(qemu_crucible_startup_source_ram_region_birth_begin(
+                       sizeof(*allocation), &birth), ==, 0);
+    overlap.loan = birth;
+    fixture_birth_creator_target = &birth.owner->creator;
+    qemu_sem_init(&overlap.first_refusal, 0);
+    qemu_thread_create(&foreign, "metadata-overlap", native_birth_overlap_finish,
+                       &overlap, QEMU_THREAD_JOINABLE);
+    qemu_sem_wait(&overlap.first_refusal);
+    g_assert_cmpuint(qatomic_read(&fixture_foreign_creator_reads), ==, 0);
+
+    /* The real creator allocates, moves and returns while the foreign actor
+     * keeps attempting the same canonical cell through its own loan copy. */
+    allocation = g_new0(QemuCrucibleMetadataAdmission, 1);
+    crucible_metadata_admission_transfer(birth.admission, allocation,
+                                         sizeof(*allocation));
+    g_assert_cmpint(qemu_crucible_startup_source_ram_metadata_birth_finish(
+                       &birth), ==, 0);
+    qatomic_store_release(&overlap.done, true);
+    qemu_thread_join(&foreign);
+    qemu_sem_destroy(&overlap.first_refusal);
+    g_assert_cmpuint(overlap.attempts, >, 0);
+    g_assert_cmpuint(qatomic_read(&fixture_foreign_creator_reads), ==, 0);
+    g_assert_null(birth.owner);
+    g_assert_null(birth.admission);
+    g_assert_true(allocation->charge.held);
+    g_assert_cmpuint(allocation->charge.bytes, ==, sizeof(*allocation));
+    g_assert_cmpuint(startup_source.metadata_partition.native_live,
+                    ==, sizeof(*allocation));
+
+    returned = allocation->charge;
+    g_free(allocation);
+    fixture_ledger_component_retire(&returned);
+    g_assert_false(returned.held);
+    g_assert_cmpuint(startup_source.metadata_partition.native_live, ==, 0);
+}
