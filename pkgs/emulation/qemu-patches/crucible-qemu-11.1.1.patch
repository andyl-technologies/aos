+static void test_irq(gconstpointer data)
+{
+    unsigned kind = GPOINTER_TO_UINT(data);
+    SPARCCPU cpu = { 0 };
+    CPUTimer *timer;
+    QEMUTimerCB *callback = kind == 0 ? tick_irq :
+                            kind == 1 ? stick_irq : hstick_irq;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
