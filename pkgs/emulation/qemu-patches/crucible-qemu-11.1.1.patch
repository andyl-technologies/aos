+    extent += modeled_extent;
+
+    /* Both family rows and all outside pending debits fit the original total. */
+    g_assert_cmpuint(fixture.total, >, 256 + workspace_extent);
+    g_assert_cmpuint(extent, <=,
+                    (fixture.total - 256 - workspace_extent) / 2);
+    return extent;
+}
+
+static void fixture_purpose_wire(uint8_t *purpose, const uint8_t *original,
+                                 bool small)
+{
+    uint64_t local = small ? 64 :
+        fixture_local_extent(fixture.workspace ? 65536 : 0);
+    uint8_t *family = purpose + QEMU_CRUCIBLE_PROCESS_FAMILY_OFFSET;
+    uint8_t *standing = purpose + 1024;
+    uint8_t *roster = standing + QEMU_CRUCIBLE_STANDING_HEADER_BYTES;
+    size_t roster_bytes = 4;
+
+    /* Canonical absence clears the whole176-byte RAM tail. These syntax
+     * bytes do not construct an inherited endpoint or a kernel owner.
+     */
+    memset(purpose, 0, QEMU_CRUCIBLE_PROCESS_PURPOSE_BYTES);
+    memcpy(purpose, QEMU_CRUCIBLE_PROCESS_PURPOSE_MAGIC, 8);
+    stl_be_p(purpose + 8, QEMU_CRUCIBLE_PROCESS_PURPOSE_SCHEMA);
+    stl_be_p(purpose + 12, QEMU_CRUCIBLE_PROCESS_PURPOSE_BYTES);
+    stq_be_p(purpose + 16, fixture.total);
+    stq_be_p(purpose + 24, local * 2);
+    for (size_t offset = 32; offset <= 64; offset += 8) {
+        stq_be_p(purpose + offset,
+            small ? 1 : fixture.workspace && offset == 32 ? 65536 : 32);
+    }
+    stq_be_p(purpose + 72, small ? 1 : 4096);
+    stq_be_p(purpose + 80, 1);
+    stq_be_p(purpose + 88, 1);
+    stq_be_p(purpose + 96, 1);
+    stq_be_p(purpose + 104, local);
+    stq_be_p(purpose + 112, 131072);
+    stq_be_p(purpose + 120, 8);
+    stq_be_p(purpose + 128, 64);
+    stq_be_p(purpose + 136, 1);
+    purpose[144] = 0x5a;
+    stl_be_p(purpose + 176, 62);
+    stl_be_p(purpose + 180, 7);
+    memcpy(purpose + 184, original + 16, 32);
+    stq_be_p(purpose + 216, 8);
+    memcpy(purpose + 224, original + 56, 24);
+    for (size_t index = 0; index < 7; index++) {
+        uint8_t *row = purpose + 248 + index * 32;
+
+        stl_be_p(row, index + 1);
+        stq_be_p(row + 8, small ? 8 : 64 + index * 16);
+        stq_be_p(row + 16, 8);
+        stq_be_p(row + 24, 1);
+    }
+    stq_be_p(purpose + 472, local);
+    stq_be_p(purpose + 480, 2);
+    stq_be_p(purpose + 504, 17);
+    stq_be_p(purpose + 520, 18);
+    stq_be_p(purpose + 528, 200000);
+    stq_be_p(purpose + 536, 100000);
+    stq_be_p(purpose + 544, 16);
+    stq_be_p(purpose + 552, 1000);
+    stq_be_p(purpose + 560, 1001);
+    if (fixture_ram_endpoint_requested) {
+        /* Independent nonzero syntax witnesses, not observed socket cookies
+         * or authenticated daemon/owner/node identities. Device0 is valid.
+         */
+        stq_be_p(purpose + 576, 23);
+        stq_be_p(purpose + 584, 29);
+        purpose[592] = 0x51;
+        purpose[624] = 0xd1;
+        purpose[656] = 0xa1;
+        purpose[688] = 0xb1;
+        stq_be_p(purpose + 720, ldq_be_p(purpose + 96));
+        stq_be_p(purpose + 728, 7);
+    }
+
+    /* Two distinct reserved rows and an absent action exercise the current
+     * decoder. These disclosed test bytes never issue a family or action loan.
+     */
+    memcpy(family, QEMU_CRUCIBLE_PROCESS_FAMILY_MAGIC, 8);
+    stl_be_p(family + 8, QEMU_CRUCIBLE_PROCESS_FAMILY_SCHEMA);
+    stl_be_p(family + 12, QEMU_CRUCIBLE_PROCESS_FAMILY_BYTES);
+    memcpy(family + 16, original + 16, 32);
+    stq_be_p(family + 48, 1);
+    stq_be_p(family + 56, 1);
+    for (size_t index = 0; index < 2; index++) {
+        uint8_t *row = family + QEMU_CRUCIBLE_PROCESS_FAMILY_ROWS_OFFSET +
+            index * QEMU_CRUCIBLE_PROCESS_FAMILY_ROW_BYTES;
+
+        stl_be_p(row, index);
+        row[8] = index + 1;
+        stq_be_p(row + 40, local);
+        stq_be_p(row + 56, local);
+        stq_be_p(row + 64, 131072);
+        stq_be_p(row + 72, 8);
+        stq_be_p(row + 80, 64);
+        stq_be_p(row + 88, 1);
+    }
+    stq_be_p(purpose + 1016, QEMU_CRUCIBLE_STANDING_MAPPING_BYTES);
+    memcpy(standing, "CRUCSRV4", 8);
+    stl_be_p(standing + 8, 4);
+    stl_be_p(standing + 12, QEMU_CRUCIBLE_STANDING_PAYLOAD_BYTES);
+    stl_be_p(standing + 196, QEMU_CRUCIBLE_PRODUCER_RETENTION_EDITION);
+    memcpy(standing + 16, original + 16, 32);
+    stq_be_p(standing + 48, ldq_be_p(original + 56));
+    stq_be_p(standing + 72, 1);
+    stq_be_p(standing + 80, 1);
+    memcpy(standing + 88, original + 16, 32);
+    memcpy(standing + 120, family + QEMU_CRUCIBLE_PROCESS_FAMILY_ROWS_OFFSET + 8, 32);
+    memcpy(standing + 160, original + 88, 16);
+    stq_be_p(standing + 176, ldq_be_p(original + 112));
+    memcpy(standing + 200, purpose + 144, 32);
+    stl_be_p(roster, 11);
+    for (size_t index = 0; index < QEMU_CRUCIBLE_STANDING_CLASS_COUNT; index++) {
+        stq_be_p(roster + roster_bytes, 1000000);
+        roster_bytes += 8;
+        /* Both optional progress and total allowances are absent. */
+        roster_bytes += 2;
+    }
+    stl_be_p(standing + 192, roster_bytes);
+}
+
+static void fixture_prepare(int time_mode, bool malformed)
+{
+    uint8_t wire[40 + 128 + 128 + QEMU_CRUCIBLE_PROCESS_PURPOSE_BYTES] = { 0 };
+    size_t workspace_bytes = fixture_workspace_requested ? 128 : 0;
+    size_t wire_bytes = 40 + workspace_bytes + 128 + QEMU_CRUCIBLE_PROCESS_PURPOSE_BYTES;
+    uint8_t *record = wire + 40 + workspace_bytes;
+    uint64_t now = fixture_now();
+    uint64_t start = now > 1000000 ? now - 1000000 : 1;
+    uint64_t end = now + UINT64_C(30000000000);
+    struct stat event;
+    struct stat workspace_identity = { 0 };
+    int fd;
+
+    errno = 0;
+    g_assert_cmpint(fcntl(12, F_GETFD), ==, -1);
+    g_assert_cmpint(errno, ==, EBADF);
+    fd = eventfd(0, EFD_NONBLOCK | EFD_CLOEXEC);
+    g_assert_cmpint(fd, >=, 0);
+    if (fd != 12) {
+        g_assert_cmpint(dup3(fd, 12, 0), ==, 12);
+        g_assert_cmpint(close(fd), ==, 0);
+    }
+    g_assert_cmpint(fcntl(12, F_SETFD, 0), ==, 0);
+    g_assert_cmpint(fstat(12, &event), ==, 0);
+    if (time_mode < 0) {
+        start = now - 1000000;
+        end = now - 1;
+    } else if (time_mode == 1) {
+        start = now + UINT64_C(30000000000);
+        end = start + UINT64_C(30000000000);
+    } else if (time_mode == 2) {
+        end = now + UINT64_C(1000000000);
+    }
+    fixture.workspace = fixture_workspace_requested;
+    fixture.workspace_role_absent = !fixture_workspace_requested;
+    fixture.workspace_borrows = 0;
+    fixture.workspace_borrow_status = 0;
+    fixture.descriptors[QEMU_CRUCIBLE_PREEXEC_SETUP_STANDING_PUBLICATION_INDEX] = -1;
+    fixture.descriptors[QEMU_CRUCIBLE_PREEXEC_SETUP_STANDING_CANCELLATION_INDEX] = -1;
+    fixture.descriptors[QEMU_CRUCIBLE_PREEXEC_SETUP_WORKSPACE_INDEX] = -1;
+    if (fixture.workspace) {
+        fixture.descriptors[QEMU_CRUCIBLE_PREEXEC_SETUP_WORKSPACE_INDEX] = fixture_high_fd(
+            memfd_create("startup-workspace", MFD_CLOEXEC));
+        g_assert_cmpint(ftruncate(fixture.descriptors[QEMU_CRUCIBLE_PREEXEC_SETUP_WORKSPACE_INDEX], 65536), ==, 0);
+        g_assert_cmpint(fstat(fixture.descriptors[QEMU_CRUCIBLE_PREEXEC_SETUP_WORKSPACE_INDEX], &workspace_identity), ==, 0);
+    }
+    fixture.original_end_ns = end;
+    /* Keep the original 1 MiB baseline. Runtime fixtures add the genuine
+     * planner cost to each declared family row, before decoding/admission. */
+    g_assert_cmpuint(fixture_extra_native_allowance, <=,
+                     (UINT64_MAX - UINT64_C(1048576)) / 2);
+    fixture.total = time_mode == 3 ? sizeof(startup_source) - 1 :
+        UINT64_C(1048576) + 2 * fixture_extra_native_allowance;
+
+    memcpy(wire, QEMU_CRUCIBLE_PROCESS_PURPOSE_PLAN_MAGIC, 8);
+    stl_be_p(wire + 8, QEMU_CRUCIBLE_PROCESS_PURPOSE_PLAN_SCHEMA);
+    stl_be_p(wire + 12, 40);
+    stl_be_p(wire + 16, wire_bytes);
+    stl_be_p(wire + 28, workspace_bytes);
+    stl_be_p(wire + 32, 128);
+    stl_be_p(wire + 36, QEMU_CRUCIBLE_PROCESS_PURPOSE_BYTES);
+    memcpy(record, "CRUCSTP1", 8);
+    stl_be_p(record + 8, malformed ? 1 : 2);
+    stl_be_p(record + 12, 128);
+    record[16] = 1;
+    stq_be_p(record + 48, 7);
+    stq_be_p(record + 56, start);
+    stq_be_p(record + 64, end);
+    stq_be_p(record + 72, 1000000);
+    stq_be_p(record + 80, 1);
+    stq_be_p(record + 88, event.st_dev);
+    stq_be_p(record + 96, event.st_ino);
+    stl_be_p(record + 104, 12);
+    stl_be_p(record + 108, 1);
+    stq_be_p(record + 112, fixture_event_token());
+    stq_be_p(record + 120, fixture.total);
+    fixture_purpose_wire(record + 128, record, time_mode == 3);
+    if (workspace_bytes) {
+        uint8_t *workspace = wire + 40;
+
+        memcpy(workspace, "CRUCWSP2", 8);
+        stl_be_p(workspace + 8, 2);
+        stl_be_p(workspace + 12, 1);
+        memcpy(workspace + 16, record + 16, 32);
+        stq_be_p(workspace + 48, fixture.total);
+        stq_be_p(workspace + 56, 65536);
+        stq_be_p(workspace + 64, 65536);
+        stq_be_p(workspace + 72, 1);
+        stq_be_p(workspace + 80, 1);
+        stq_be_p(workspace + 88, 9);
+        stq_be_p(workspace + 96, workspace_identity.st_dev);
+        stq_be_p(workspace + 104, workspace_identity.st_ino);
+        stq_be_p(workspace + 120, 65536);
+    }
+
+    fixture.plan_fd = memfd_create("startup-prepared-family", MFD_CLOEXEC | MFD_ALLOW_SEALING);
+    g_assert_cmpint(fixture.plan_fd, >=, 0);
+    fixture.plan_fd = fixture_high_fd(fixture.plan_fd);
+    g_assert_cmpint(write(fixture.plan_fd, wire, wire_bytes), ==, wire_bytes);
+    g_assert_cmpint(fcntl(fixture.plan_fd, F_ADD_SEALS,
+        F_SEAL_SEAL | F_SEAL_SHRINK | F_SEAL_GROW | F_SEAL_WRITE), ==, 0);
+    fixture.plan_status = qemu_crucible_process_purpose_plan_read_fd_v3(
+        fixture.plan_fd, &fixture.plan);
+    g_assert_cmpint(fixture.plan_status, ==, malformed ? -EPROTONOSUPPORT : 0);
+
+    fixture.process = getpid();
+    qemu_thread_get_self(&fixture.thread);
+    fixture.family_prepared = !malformed;
+    fixture.descriptors[0] = fixture_high_fd(memfd_create("startup-memory", MFD_CLOEXEC));
+    g_assert_cmpint(ftruncate(fixture.descriptors[0], 4096), ==, 0);
+    fixture.descriptors[1] = 12;
+    fixture.descriptors[2] = fixture.plan_fd;
+    stl_be_p(fixture.frame, 57);
+    fixture.frame[4] = QEMU_CRUCIBLE_PREEXEC_SETUP_TAG_V5;
+    stq_be_p(fixture.frame + 5, 4096);
+    stq_be_p(fixture.frame + 21, 1);
+    if (fixture.workspace) {
+        stl_be_p(fixture.frame + 13, 1);
+        stl_be_p(fixture.frame + 17, 2);
+        stq_be_p(fixture.frame + 29, 1);
+        stq_be_p(fixture.frame + 37, 9);
+        stq_be_p(fixture.frame + 45, workspace_identity.st_dev);
+        stq_be_p(fixture.frame + 53, workspace_identity.st_ino);
+    }
+    fixture.ctx.id = 17;
+    fixture.ctx.handle = g_module_open(NULL, G_MODULE_BIND_LOCAL);
+    g_assert_nonnull(fixture.ctx.handle);
+    fixture.ctx.installing = true;
+    plugin.id_ht = g_hash_table_new(g_int64_hash, g_int64_equal);
+    g_assert_true(g_hash_table_insert(plugin.id_ht, &fixture.ctx.id, &fixture.ctx.id));
+    qemu_rec_mutex_lock(&plugin.lock);
+    plugin_startup_source_install_enter(&fixture.ctx, fixture_install);
+
+    /* Only this disclosed prepared-family seam publishes the test identities.
+     * It is not the real preinit once-receive/artifact/cgroup constructor.
+     * Ledger recipes are installed separately to isolate their actual cuts.
+     */
+    qemu_crucible_selected_process_id = getpid();
+    startup_source.preexec_purpose_owner = &modeled_preexec_owner;
+    startup_source.process_contract_owner = &modeled_contract_owner;
+    startup_source.incarnation_purpose_owner = &modeled_incarnation_owner;
+    /* Prepared-family fixture input only: these storage facts cannot issue a
+     * runtime provider. Constructor tests below exercise actual publication. */
+    startup_source.checkpoint_storage.issuer = &modeled_preexec_owner;
+    startup_source.checkpoint_storage.fixed_charge = (QemuCrucibleMetadataCharge) {
+        .bytes = qemu_crucible_checkpoint_owner_bytes(), .held = !malformed,
+    };
+    startup_source.metadata_partition.fixed_native_extent =
+        qemu_crucible_startup_source_fixed_control_extent();
+    startup_source.process_purpose_record = fixture.plan.purpose;
+    /* The same disclosed prepared-family seam binds immutable cleanup custody
+     * to the decoded payer/process/account and real native journal addresses.
+     * This supplies no launched Source, RCU grace or physical-return proof. */
+    startup_source.ram_metadata_keeper = (QemuCrucibleRamMetadataKeeper) {
+        .partition = &startup_source.metadata_partition,
+        .payer = startup_source.preexec_purpose_owner,
+        .process = fixture.process,
+        .process_generation = fixture.plan.purpose.process_generation,
+        .account_generation = fixture.plan.purpose.account_generation,
+        .next_serial = 1,
+        .inventory_returns = {
+            qemu_crucible_ram_inventory_return_journal(0),
+            qemu_crucible_ram_inventory_return_journal(1),
+        },
+        .dirty_return = qemu_crucible_ram_dirty_return_journal(),
+    };
+    qatomic_store_release(&startup_source.process_purpose_complete, !malformed);
+}
+
+/* Constructor controls clear only this subprocess's unentered Source storage.
+ * The decoded prepared input remains a fixture, with no production issuer. */
+static void fixture_clear_source(void)
+{
+    startup_source = (QemuCrucibleStartupSourceControl) {
+        .event_fd = -1,
+        .metadata_fd = -1,
+        .purpose_plan_fd = -1,
+        .socket_ingress.observation.descriptor = -1,
+        .ram_control_actor.observation.descriptor = -1,
+        .qmp_allocations.observation.descriptor = -1,
+        .checkpoint_storage.observation.descriptor = -1,
+        .control_callback.observation.descriptor = -1,
+        .wake_keeper.observation.descriptor = -1,
+        .standing.observation.descriptor = -1,
+        .standing.cancellation_fd = -1,
+        .standing.construction_storage.observation.descriptor = -1,
+        .cpu_allocations.lock = PTHREAD_MUTEX_INITIALIZER,
+    };
+    qemu_crucible_startup_source_owner_init();
+    qemu_crucible_startup_source_install_enter(&fixture.ctx, fixture_install);
+}
+
+static void assert_preexec_custody(void)
+{
+    g_assert_true(qemu_plugin_crucible_startup_source_retained());
+    g_assert_false(startup_source.module_custody_published);
+    g_assert_false(startup_source.acquisition_attempted);
+    g_assert_true(startup_source.standing.retained);
+    g_assert_true(startup_source.standing.lender == &modeled_standing_owner);
+    g_assert_true(startup_source.preexec_purpose_owner == &modeled_preexec_owner);
+    g_assert_true(startup_source.checkpoint_storage.fixed_charge.held);
+    g_assert_cmpuint(startup_source.checkpoint_storage.fixed_charge.bytes, ==,
+                     qemu_crucible_checkpoint_owner_bytes());
+    g_assert_cmpuint(startup_source.metadata_partition.fixed_native_extent, ==,
+                     qemu_crucible_startup_source_fixed_control_extent());
+    g_assert_cmpint(startup_source.purpose_plan_fd, ==, fixture.plan_fd);
+    g_assert_cmpint(fcntl(fixture.plan_fd, F_GETFD), >=, 0);
+    g_assert_cmpint(fcntl(12, F_GETFD), ==, 0);
+    g_assert_null(qemu_crucible_startup_source_native_selection_v1());
+}
+
+static int fixture_acquire(void)
+{
+    return qemu_plugin_crucible_startup_source_acquire_v1(fixture.ctx.id, fixture.plan_fd);
+}
+
+static void fixture_signal(void)
+{
+    uint64_t one = 1;
+
+    g_assert_cmpint(write(12, &one, sizeof(one)), ==, sizeof(one));
+}
+
+static void assert_retained(void)
+{
+    struct stat plan;
+    struct stat event;
+
+    g_assert_true(qemu_plugin_crucible_startup_source_retained());
+    g_assert_true(plugin_startup_source_retains_ctx(&fixture.ctx));
+    g_assert_true(plugin_startup_source_retains_id(fixture.ctx.id));
+    g_assert_cmpint(fstat(fixture.plan_fd, &plan), ==, 0);
+    g_assert_cmpint(fstat(12, &event), ==, 0);
+    g_assert_cmpint(startup_source.purpose_plan_fd, ==, fixture.plan_fd);
+    g_assert_true(qatomic_load_acquire(&startup_source.purpose_identity_known));
+    g_assert_cmpuint(startup_source.purpose_device, ==, plan.st_dev);
+    g_assert_cmpuint(startup_source.purpose_inode, ==, plan.st_ino);
+    g_assert_cmpuint(qemu_crucible_startup_source_metadata_bytes(), ==,
+        sizeof(QemuCrucibleStartupSourceControl) +
+        qemu_crucible_ram_metadata_fixed_storage_bytes() +
+        startup_source.standing.construction_storage.fixed_charge.bytes);
+}
diff --git a/tests/unit/crucible-timer-stream.h b/tests/unit/crucible-timer-stream.h
new file mode 100644
index 0000000000000000000000000000000000000000..f517993ed29c5a6611a6d10ad6a2a612c9d3207e
--- /dev/null
+++ b/tests/unit/crucible-timer-stream.h
@@ -0,0 +1,279 @@
+/*
+ * Bounded same-executable streams for timer migration fixtures.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+#ifndef TESTS_CRUCIBLE_TIMER_STREAM_H
+#define TESTS_CRUCIBLE_TIMER_STREAM_H
+
+#include "qemu/osdep.h"
+#include <poll.h>
+#include <sys/wait.h>
+
+#define TIMER_STREAM_TIMEOUT_US (5 * G_USEC_PER_SEC)
+#define TIMER_STREAM_CLEANUP_US G_USEC_PER_SEC
+#define TIMER_STREAM_SUBPROCESS_TIMEOUT_US (10 * G_USEC_PER_SEC)
+
+/* Keep each fixture's existing bytes: only ICH9 prefixes a native length. */
+typedef enum TimerStreamFraming {
+    TIMER_STREAM_U32_LENGTH,
+    TIMER_STREAM_TO_EOF,
+} TimerStreamFraming;
+
+typedef struct TimerStreamProducer {
+    GPid pid;
+    int output;
+    int status;
+    bool reaped;
+    bool wait_failed;
+} TimerStreamProducer;
+
+static void timer_stream_failure(GError **error, const char *operation,
+                                 int code)
+{
+    if (!*error) {
+        g_set_error(error, G_FILE_ERROR, g_file_error_from_errno(code),
+                    "%s: %s", operation, g_strerror(code));
+    }
+}
+
+static ssize_t timer_stream_read(int fd, void *buffer, size_t length,
+                                 int64_t deadline, GError **error)
+{
+    for (;;) {
+        int64_t remaining = deadline - g_get_monotonic_time();
+        ssize_t received;
+        struct pollfd descriptor = { .fd = fd, .events = POLLIN };
+        int ready;
+
+        if (remaining <= 0) {
+            timer_stream_failure(error, "producer IPC deadline", ETIMEDOUT);
+            return -1;
+        }
+        received = read(fd, buffer, length);
+        if (received >= 0) {
+            return received;
+        }
+        if (errno == EINTR) {
+            continue;
+        }
+        if (errno != EAGAIN && errno != EWOULDBLOCK) {
+            timer_stream_failure(error, "producer read", errno);
+            return -1;
+        }
+        remaining = deadline - g_get_monotonic_time();
+        if (remaining <= 0) {
+            continue;
+        }
+        ready = poll(&descriptor, 1, (remaining + 999) / 1000);
+        if (ready < 0 && errno != EINTR) {
+            timer_stream_failure(error, "producer poll", errno);
+            return -1;
+        }
+        if (ready > 0 && (descriptor.revents & POLLNVAL)) {
+            timer_stream_failure(error, "producer poll descriptor", EBADF);
+            return -1;
+        }
+    }
+}
+
+static bool timer_stream_read_exact(int fd, void *buffer, size_t length,
+                                    int64_t deadline, GError **error)
+{
+    for (size_t offset = 0; offset < length;) {
+        ssize_t received = timer_stream_read(fd, (uint8_t *)buffer + offset,
+                                              length - offset, deadline, error);
+
+        if (received <= 0) {
+            if (!received) {
+                timer_stream_failure(error, "incomplete producer frame", EPIPE);
+            }
+            return false;
+        }
+        offset += received;
+    }
+    return true;
+}
+
+static bool timer_stream_observe_exit(TimerStreamProducer *producer,
+                                      GError **error)
+{
+    pid_t result = waitpid(producer->pid, &producer->status, WNOHANG);
+
+    if (result == producer->pid) {
+        producer->reaped = true;
+    } else if (result < 0 && errno != EINTR) {
+        /* An uncertain child identity must never become a numeric kill. */
+        producer->wait_failed = true;
+        timer_stream_failure(error, "producer waitpid", errno);
+        return false;
+    }
+    return true;
+}
+
+static bool timer_stream_wait(TimerStreamProducer *producer, int64_t deadline,
+                              GError **error)
+{
+    while (!producer->reaped) {
+        int64_t remaining = deadline - g_get_monotonic_time();
+
+        if (remaining <= 0) {
+            timer_stream_failure(error, "producer reap deadline", ETIMEDOUT);
+            return false;
+        }
+        if (!timer_stream_observe_exit(producer, error)) {
+            return false;
+        }
+        remaining = deadline - g_get_monotonic_time();
+        if (!producer->reaped && remaining > 0) {
+            g_usleep(MIN(remaining, 1000));
+        }
+    }
+    return true;
+}
+
+static void timer_stream_cleanup(TimerStreamProducer *producer)
+{
+    GError *error = NULL;
+    const int signals[] = { SIGTERM, SIGKILL };
+
+    if (!timer_stream_observe_exit(producer, &error)) {
+        g_printerr("Producer cleanup: %s\n", error->message);
+        g_clear_error(&error);
+        return;
+    }
+    for (unsigned index = 0; !producer->reaped &&
+                            index < G_N_ELEMENTS(signals); index++) {
+        int64_t deadline = g_get_monotonic_time() + TIMER_STREAM_CLEANUP_US;
+
+        if (kill(producer->pid, signals[index]) < 0 && errno != ESRCH) {
+            timer_stream_failure(&error, "producer cleanup signal", errno);
+        }
+        timer_stream_wait(producer, deadline, &error);
+        if (error) {
+            g_printerr("Producer cleanup: %s\n", error->message);
+            g_clear_error(&error);
+        }
+        if (producer->wait_failed) {
+            break;
+        }
+    }
+}
+
+static GByteArray *timer_stream_capture(char *executable, char *helper_mode,
+                                        unsigned scenario,
+                                        TimerStreamFraming framing)
+{
+    TimerStreamProducer producer = { .output = -1 };
+    char scenario_argument[] = { '0' + scenario, '\0' };
+    char *arguments[] = {
+        executable, helper_mode, scenario_argument, NULL,
+    };
+    int64_t deadline = g_get_monotonic_time() + TIMER_STREAM_TIMEOUT_US;
+    uint32_t length = 0;
+    uint8_t trailing;
+    GPid spawned_pid = 0;
+    int spawned_output = -1;
+    int flags;
+    GByteArray *bytes = NULL;
+    GError *error = NULL;
+    ssize_t received;
+
+    g_assert_true(framing == TIMER_STREAM_U32_LENGTH ||
+                  framing == TIMER_STREAM_TO_EOF);
+    if (!g_spawn_async_with_pipes(NULL, arguments, NULL,
+            G_SPAWN_DO_NOT_REAP_CHILD | G_SPAWN_CLOEXEC_PIPES,
+            NULL, NULL, &spawned_pid, NULL, &spawned_output, NULL, &error)) {
+        goto out;
+    }
+    producer.pid = spawned_pid;
+    producer.output = spawned_output;
+    flags = fcntl(producer.output, F_GETFL);
+    if (flags < 0 || fcntl(producer.output, F_SETFL, flags | O_NONBLOCK) < 0) {
+        timer_stream_failure(&error, "producer pipe nonblocking", errno);
+        goto out;
+    }
+    if (framing == TIMER_STREAM_U32_LENGTH) {
+        if (!timer_stream_read_exact(producer.output, &length, sizeof(length),
+                                      deadline, &error)) {
+            goto out;
+        }
+        if (!length || length >= 512) {
+            timer_stream_failure(&error, "producer frame length", EINVAL);
+            goto out;
+        }
+        bytes = g_byte_array_sized_new(length);
+        g_byte_array_set_size(bytes, length);
+        if (!timer_stream_read_exact(producer.output, bytes->data, length,
+                                      deadline, &error)) {
+            goto out;
+        }
+        received = timer_stream_read(producer.output, &trailing, 1,
+                                      deadline, &error);
+        if (received != 0) {
+            if (received > 0) {
+                timer_stream_failure(&error, "trailing producer bytes", EINVAL);
+            }
+            goto out;
+        }
+    } else {
+        uint8_t buffer[256];
+
+        bytes = g_byte_array_new();
+        for (;;) {
+            received = timer_stream_read(producer.output, buffer,
+                                          sizeof(buffer), deadline, &error);
+            if (received < 0) {
+                goto out;
+            }
+            if (!received) {
+                break;
+            }
+            if (bytes->len + received >= 512) {
+                timer_stream_failure(&error, "producer stream length", EINVAL);
+                goto out;
+            }
+            g_byte_array_append(bytes, buffer, received);
+        }
+        length = bytes->len;
+        if (!length) {
+            timer_stream_failure(&error, "empty producer stream", EINVAL);
+            goto out;
+        }
+    }
+    if (!timer_stream_wait(&producer, deadline, &error)) {
+        goto out;
+    }
+    if (!g_spawn_check_wait_status(producer.status, &error)) {
+        goto out;
+    }
+
+out:
+    if (producer.output >= 0) {
+        int output = producer.output;
+
+        producer.output = -1;
+        if (close(output) < 0) {
+            timer_stream_failure(&error, "producer pipe close", errno);
+        }
+    }
+    if (producer.pid && !producer.reaped && !producer.wait_failed) {
+        timer_stream_cleanup(&producer);
+    }
+    if (producer.reaped) {
+        g_spawn_close_pid(producer.pid);
+    }
+    if (error) {
+        g_clear_pointer(&bytes, g_byte_array_unref);
+        g_error("Exact producer failed: %s%s", error->message,
+                producer.pid && !producer.reaped ?
+                "; producer reap remains unproved" : "");
+    }
+    g_assert_true(producer.reaped);
+    g_assert_cmpuint(length, >, 0);
+    g_assert_cmpuint(length, <, 512);
+    g_assert_true(WIFEXITED(producer.status));
+    g_assert_cmpint(WEXITSTATUS(producer.status), ==, 0);
+    return bytes;
+}
+
+#endif /* TESTS_CRUCIBLE_TIMER_STREAM_H */
