+static bool qemu_rcu_hot_fork_reader_is_registered(
+    struct rcu_reader_data *expected)
+{
+    struct rcu_reader_data *reader;
+    size_t matches = 0;
+
+    QLIST_FOREACH(reader, &registry, node) {
+        if (reader == expected) {
+            matches++;
+        }
+    }
+    return matches == 1;
+}
