+        self.work_cpu_indices = set()
+        self.futex_entries_observed = 0
+        self.shutdown_marker_counts = Counter()
+        self.shutdown_marker_tail = deque(maxlen=16)
+        self.shutdown_stderr_tail = bytearray()
