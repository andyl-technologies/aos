+static void test_crossmode_stream(gconstpointer opaque)
+{
+    unsigned scenario = GPOINTER_TO_UINT(opaque);
+    ICH9LPCState lpc = { 0 };
+    GByteArray *bytes;
+    const int64_t expected[] = {
+        INT64_C(2400000001), INT64_C(1500001), INT64_C(64000000001),
+    };
+
+    if (!run_in_child()) {
+        return;
+    }
+    bytes = exact_producer_stream(scenario);
+    initialize_fixture(&lpc, scenario == 3);
+    observed_ps = 0;
+    for (unsigned index = 0; index < 3; index++) {
+        timer_mod_ns(ich9_aux_timer(&lpc.pm, index), 999 + index);
+    }
+
+    int result = load_auxiliary(&lpc.pm, bytes);
+
+    if (scenario == 3) {
+        g_assert_cmpint(result, <, 0);
+    } else if (scenario == 1) {
+        /* VMState maps the parent's range refusal to its stream error. */
+        g_assert_cmpint(result, ==, -EINVAL);
+        g_assert_cmpint(ich9_aux_validate(&lpc.pm, 0), ==, -ERANGE);
+    } else {
+        g_assert_cmpint(result, ==, 0);
+    }
+    for (unsigned index = 0; index < 3; index++) {
+        QEMUTimer *timer = ich9_aux_timer(&lpc.pm, index);
+
+        g_assert_true(timer_pending(timer));
+        g_assert_cmpint(timer_expire_time_ns(timer), ==,
+                        (scenario == 1 || scenario == 3) ? 999 + index :
+                        scenario == 2 ? 0 : expected[index]);
+    }
+    g_byte_array_unref(bytes);
+    destroy_fixture(&lpc);
+}
+
+int main(int argc, char **argv)
+{
+    int result;
+
+    /* Exec producers emit only the frame, before TAP or test registration. */
+    if (argc > 1 && strcmp(argv[1], "--ich9-exact-producer") == 0) {
+        if (argc != 3 || argv[2][0] < '0' || argv[2][0] > '3' ||
+            argv[2][1] != '\0') {
+            return EXIT_FAILURE;
+        }
+        return produce_exact_stream(argv[2][0] - '0');
+    }
+    fixture_executable = realpath(argv[0], NULL);
+    g_assert_nonnull(fixture_executable);
+    g_test_init(&argc, &argv, NULL);
+    g_test_add_func("/ich9/tco-wide-runtime", test_tco_wide_runtime);
+    g_test_add_func("/ich9/tco-events", test_tco_events);
+    g_test_add_func("/ich9/smi-wide-rates", test_smi_wide_rates);
+    g_test_add_func("/ich9/wide-roundtrip", test_wide_roundtrip);
+    const char *refusals[] = {
+        "mode", "active", "inactive", "version", "missing", "duplicate",
+        "swsmi-mode", "periodic-mode",
+    };
+
+    for (unsigned index = 0; index < G_N_ELEMENTS(refusals); index++) {
+        char *name = g_strdup_printf("/ich9/refuse-%s", refusals[index]);
+
+        g_test_add_data_func(name, GUINT_TO_POINTER(index),
+                             test_stream_refusal);
+        g_free(name);
+    }
+    g_test_add_func("/ich9/inactive-roundtrip", test_inactive_roundtrip);
+    g_test_add_func("/ich9/negative-pending-roundtrip",
+                    test_negative_pending_roundtrip);
+    g_test_add_func("/ich9/ordinary-roundtrip", test_ordinary_roundtrip);
+    g_test_add_func("/ich9/full-span-count", test_full_span_count);
+    g_test_add_func("/ich9/checked-arm-overflow", test_checked_arm_overflow);
+    g_test_add_data_func("/ich9/crossmode-phase", GUINT_TO_POINTER(0),
+                         test_crossmode_stream);
+    g_test_add_data_func("/ich9/crossmode-refuse-wide", GUINT_TO_POINTER(1),
+                         test_crossmode_stream);
+    g_test_add_data_func("/ich9/crossmode-negative", GUINT_TO_POINTER(2),
+                         test_crossmode_stream);
+    g_test_add_data_func("/ich9/refuse-prior-precise-format",
+                         GUINT_TO_POINTER(3), test_crossmode_stream);
+    result = g_test_run();
+    free(fixture_executable);
+    return result;
+}
diff --git a/tests/unit/test-crucible-icount-rate.c b/tests/unit/test-crucible-icount-rate.c
