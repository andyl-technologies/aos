+    QemuCrucibleQmpAllocationOwner *owner;
+    SourceJSONWriter *writer;
+    void *body = NULL;
+    int status;
+
+    if (!out || !output || *out || *output) {
+        return -EINVAL;
+    }
+    status = qemu_crucible_qmp_scope_identity_current(&owner);
+    if (status) {
+        return status;
+    }
+    status = qemu_crucible_qmp_json_writer_allocate(&body);
