+        startup_source.publisher_subscription.action_users ||
+        (borrow->payload_borrow.attempted && (!borrow->payload_borrow.closed ||
+         borrow->payload_borrow.held || borrow->payload_borrow.module_borrow ||
+         borrow->payload_borrow.serial ||
+         borrow->payload_borrow.transition_active || borrow->payload_borrow.uncertain)) ||
+        handoff->main_users != 1 || !handoff->held ||
+        handoff->delivery_serial != borrow->delivery_serial ||
+        !borrow->invocation || borrow->invocation->serial != borrow->invocation_serial) {
+        status = -EBUSY;
+    } else {
+        borrow->transition_active = true;
+        status = qemu_plugin_crucible_native_main_control_finish_v1(
+            borrow->invocation, borrow);
+        if (!status && borrow->invocation->frame) {
+            status = -EPROTO;
+            borrow->uncertain = true;
+        }
+        if (!status) {
+            /* Real QOM return and Native slot/descriptor consumption already
+             * completed. Save this actual Source consumption before post. */
+            handoff->main_users--;
+            borrow->held = false;
+            borrow->returned = true;
+            *holder = NULL;
+            status = received_delivery_identity_locked(handoff->delivery,
+                                                       handoff->delivery_serial);
+        }
+        borrow->transition_active = false;
+    }
+    if (status && !borrow->return_status) {
+        borrow->return_status = status;
+    }
+    status = borrow->return_status;
+    qemu_mutex_unlock(&commands->mutex);
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_startup_source_received_delivery_ready_return_v1(
+    qemu_plugin_id_t id, QemuCrucibleReceivedDeliveryOwner *delivery,
+    uint64_t serial, uint32_t *locally_returned)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    QemuCrucibleReadyDeliveryHandoff *handoff = &startup_source.ready_delivery;
+    int status = command_registry_identity(id);
+
+    if (status || !locally_returned ||
+        (uintptr_t)locally_returned % _Alignof(uint32_t) ||
+        (uintptr_t)locally_returned > UINTPTR_MAX - sizeof(*locally_returned)) {
+        return status ? status : -EINVAL;
+    }
+    qemu_mutex_lock(&commands->mutex);
+    if (callback_child_output_conflicts_locked(locally_returned, sizeof(*locally_returned))) {
+        status = -EINVAL;
+    } else {
+        status = received_delivery_identity_locked(delivery, serial);
+    }
+    if (status) {
+        qemu_mutex_unlock(&commands->mutex);
+        return status;
+    }
+    *locally_returned = 0;
+    if (delivery->payload_transition_active || delivery->use_users || handoff->main_users ||
+        (handoff->held && (handoff->delivery != delivery || handoff->delivery_serial != serial))) {
+        status = -EBUSY;
+    } else if (delivery->ready_closed) {
+        *locally_returned = 1;
+        status = handoff->attempted && handoff->delivery == delivery &&
+            handoff->delivery_serial == serial ? handoff->return_first : 0;
+    } else if (!delivery->ready_users) {
+        /* Absence is terminal for this actual delivery, including component
+         * callers that never entered Ready. A later callback cannot reissue. */
+        if (handoff->held) {
+            status = -ESTALE;
+        } else {
+            delivery->ready_closed = true;
+            *locally_returned = 1;
+        }
+    } else if (handoff->canonical_owner != handoff || !handoff->held ||
+               handoff->transition_active || handoff->uncertain ||
+               handoff->process != getpid() || !qemu_thread_is_self(&handoff->thread) ||
+               handoff->receive != delivery->receive ||
+               handoff->receive_serial != delivery->receive_serial ||
+               handoff->member != delivery->member || handoff->child != delivery->member->child ||
+               handoff->lender != delivery->lender ||
+               handoff->payload_holder != &delivery->payload ||
+               handoff->payload != delivery->payload || handoff->payload_serial != delivery->payload_serial ||
+               delivery->ready_users != 1) {
+        status = -EBUSY;
+    } else if ((status = publisher_subscription_view_return_locked(delivery))) {
+        /* The live child or uncertain view remains retained with Ready. */
+    } else {
+        handoff->transition_active = true;
+        status = handoff->execution_holder ?
+            qemu_crucible_fingerprint_ready_delivery_identity_return_v1(
+                handoff->execution, handoff->execution_holder, handoff) : 0;
+        if (!status && handoff->execution_holder && *handoff->execution_holder) {
+            /* A scalar zero cannot conceal an unconsumed actual dependency. */
+            status = -EPROTO;
+            handoff->uncertain = true;
+        }
+        if (!status) {
+            handoff->execution_holder = NULL;
+            handoff->held = false;
+            handoff->returned = true;
+            delivery->ready_users--;
+            delivery->ready_closed = true;
+            *locally_returned = 1;
+            /* Record actual consumption before independent physical post. */
+            status = received_delivery_identity_locked(delivery, serial);
+        }
+        handoff->transition_active = false;
+        if (status && !handoff->return_first) {
+            handoff->return_first = status;
+        }
+        status = handoff->return_first;
+    }
+    qemu_mutex_unlock(&commands->mutex);
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_startup_source_received_delivery_payload_claim_v1(
+    qemu_plugin_id_t id, QemuCrucibleReceivedDeliveryOwner *owner, uint64_t serial)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    int status = command_registry_identity(id);
+    int callback_status;
+    int ready_status;
+
+    if (status || bql_locked() || qemu_in_coroutine()) {
+        return status ? status : -EPERM;
+    }
+    qemu_mutex_lock(&commands->mutex);
+    status = received_delivery_identity_locked(owner, serial);
+    if (!status && (!owner->member->payload_claim || !owner->member->payload_release)) {
+        status = -ENOTSUP;
+    }
+    if (!status && (owner->use_users || owner->payload_transition_active ||
+                    owner->payload_attempted || owner->payload || owner->payload_serial)) {
+        status = -EBUSY;
+    }
+    if (status) {
+        qemu_mutex_unlock(&commands->mutex);
+        return status;
+    }
+
+    /* This is a physical custody transition, not an Original query. The real
+     * first-bound child and member remain pinned throughout the outside-lock
+     * callback. Source's exact paid field, never copied receive facts, is the
+     * module's canonical claimant identity before interpreting any result. */
+    owner->payload_attempted = true;
+    owner->payload_transition_active = true;
+    owner->payload_claim = owner->member->payload_claim;
+    owner->payload_release = owner->member->payload_release;
+    owner->payload_userdata = owner->member->child->address;
+    qemu_mutex_unlock(&commands->mutex);
+
+    SOURCE_CALLBACK_MASKED_INVOKE(
+        callback_status, &owner->payload_claim, owner->payload_claim,
+        owner->payload_userdata, &owner->payload, &owner->payload_serial,
+        owner->payload_userdata);
+
+    qemu_mutex_lock(&commands->mutex);
+    owner->payload_claim_status = callback_status;
+    owner->payload_held = owner->payload && owner->payload_serial;
+    if (callback_status > 0 || (!!owner->payload != !!owner->payload_serial) ||
+        (!callback_status && !owner->payload_held)) {
+        owner->payload_claim_validation = -EPROTO;
+        owner->payload_uncertain = true;
+    }
+    /* Independently authenticate the same actual retained chain after saving
+     * every callback output, including a claimed pair followed by failure. */
+    ready_status = owner->payload_held ? ready_delivery_capture_locked(owner) : 0;
+    owner->payload_claim_post = received_delivery_identity_locked(owner, serial);
+    if (!owner->payload_claim_post) {
+        owner->payload_claim_post = ready_status;
+    }
+    owner->payload_transition_active = false;
+    status = received_delivery_payload_result(callback_status,
+        owner->payload_claim_validation, owner->payload_claim_post);
+    qemu_mutex_unlock(&commands->mutex);
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
+
+int qemu_plugin_crucible_startup_source_received_delivery_payload_return_v1(
+    qemu_plugin_id_t id, QemuCrucibleReceivedDeliveryOwner *owner, uint64_t serial)
+{
+#ifdef CONFIG_LINUX
+    QemuCrucibleCommandConsumerRegistry *commands = &startup_source.commands;
+    QemuCrucibleModuleRequestPayload *payload;
+    uint64_t payload_serial;
+    int status = command_registry_identity(id);
+    int callback_status;
+    int result;
+
+    if (status || bql_locked() || qemu_in_coroutine()) {
+        return status ? status : -EPERM;
+    }
+    qemu_mutex_lock(&commands->mutex);
+    status = received_delivery_identity_locked(owner, serial);
+    if (!status && (owner->use_users || owner->ready_users || owner->payload_transition_active ||
+                    owner->payload_uncertain)) {
+        status = -EBUSY;
+    }
+    if (!status && owner->payload_returned) {
+        status = owner->payload_return_first;
+        qemu_mutex_unlock(&commands->mutex);
+        return status;
+    }
+    if (!status && (!owner->payload_held || !owner->payload || !owner->payload_serial ||
+                    !owner->payload_attempted || !owner->payload_release)) {
+        status = -ENOENT;
+    }
+    if (status) {
+        qemu_mutex_unlock(&commands->mutex);
+        return status;
+    }
+    payload = owner->payload;
+    payload_serial = owner->payload_serial;
+    owner->payload_return_attempted = true;
+    owner->payload_transition_active = true;
+    qemu_mutex_unlock(&commands->mutex);
+
+    SOURCE_CALLBACK_MASKED_INVOKE(
+        callback_status, &owner->payload_release, owner->payload_release,
+        owner->payload_userdata, &owner->payload, payload_serial,
+        owner->payload_userdata);
+
+    qemu_mutex_lock(&commands->mutex);
+    owner->payload_return_status = callback_status;
+    /* Module zero means actual destruction followed by exact field nulling.
+     * Save that consumption BEFORE independent Native post. A later negative
+     * cannot restore a destroyed payload or strand a closed lifetime loan. */
+    if (!callback_status && !owner->payload && owner->payload_serial == payload_serial) {
+        owner->payload_held = false;
+        owner->payload_returned = true;
+    } else if (callback_status >= 0 || owner->payload != payload ||
+               owner->payload_serial != payload_serial) {
+        owner->payload_return_validation = -EPROTO;
+        owner->payload_uncertain = true;
+    }
+    owner->payload_return_post = received_delivery_identity_locked(owner, serial);
+    owner->payload_transition_active = false;
+    result = received_delivery_payload_result(callback_status,
+        owner->payload_return_validation, owner->payload_return_post);
+    if (result && !owner->payload_return_first) {
+        owner->payload_return_first = result;
+    }
+    status = owner->payload_return_first;
+    qemu_mutex_unlock(&commands->mutex);
+    return status;
+#else
+    return -ENOTSUP;
+#endif
+}
diff --git a/plugins/crucible-control-invocation.inc.h b/plugins/crucible-control-invocation.inc.h
new file mode 100644
index 0000000000000000000000000000000000000000..0ef15f03cfb367f47acb25df79d09703ea94ccde
--- /dev/null
+++ b/plugins/crucible-control-invocation.inc.h
@@ -0,0 +1,226 @@
+/*
+ * Source custody for the genuinely installed native control callback
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Included once in Source. The native dispatch frame supplies invocation
+ * provenance; this holder supplies its containing physical payer. Neither a
+ * callback pointer nor this physical loan issues a Stop receipt or Original.
+ */
+
+static int source_control_binding_identity(
+    QemuCrucibleSourceControlBinding *binding)
+{
+#ifdef CONFIG_LINUX
+    if (!qatomic_load_acquire(&startup_source.module_custody_published) ||
+        binding != &startup_source.control_callback ||
+        !qatomic_load_acquire(&binding->registered) || !binding->attempted ||
+        !binding->enrolled || !binding->callback || !binding->userdata ||
+        binding->completion != &startup_source.fingerprint_completion ||
+        binding->runtime != &startup_source.runtime_purpose ||
+        binding->installer.ctx != startup_source.saved.ctx ||
+        binding->installer.module != startup_source.saved.module ||
+        binding->installer.install != startup_source.saved.install ||
+        binding->installer.plugin_id != startup_source.saved.plugin_id ||
+        binding->fixed_storage_bytes != sizeof(startup_source.control_callback) ||
+        !qemu_plugin_crucible_control_stop_storage_bytes_v1() ||
+        startup_source.metadata_partition.fixed_native_extent !=
+            qemu_crucible_startup_source_fixed_control_extent()) {
+        return -ENOKEY;
+    }
+    /* The complete Source binding is inside sizeof(Source). The distinct
+     * actual Native Stop singleton is also inside the same retained preexec
+     * fixed floor; its bytes never stand in for this Source binding's size.
+     * Neither static body is refunded or repriced at callback completion. */
+    return fingerprint_completion_identity(binding->completion);
+#else
+    return -ENOTSUP;
+#endif
+}
+
+static int source_control_binding_current(QemuCrucibleSourceControlBinding *binding)
+{
+    gpointer registered;
+    int status = source_control_binding_identity(binding);
+
+    if (status) {
+        return status;
+    }
+    status = qemu_rec_mutex_trylock(&plugin.lock);
+    if (status) {
+        return status;
+    }
+    registered = plugin.id_ht ? g_hash_table_lookup(
+        plugin.id_ht, &binding->installer.plugin_id) : NULL;
+    if (registered != &binding->installer.ctx->id ||
+        binding->installer.ctx->resetting || binding->installer.ctx->uninstalling ||
+        binding->installer.ctx->handle != binding->installer.module) {
+        status = -EPERM;
+    }
+    qemu_rec_mutex_unlock(&plugin.lock);
+    if (status) {
+        return status;
+    }
+#if defined(CONFIG_LINUX) && defined(__x86_64__) && !defined(__ILP32__)
+    return qemu_crucible_preexec_contract_check_v3(
+        startup_source.preexec_purpose_owner, &binding->observation,
+        &binding->descriptor_limit);
+#else
+    return -ENOTSUP;
+#endif
+}
+
+static int source_control_invocation_identity(QemuCrucibleSourceControlInvocation *loan)
+{
+    QemuCrucibleSourceControlBinding *binding = &startup_source.control_callback;
+
+    if (loan != &binding->invocation || !loan->held || loan->binding != binding ||
+        loan->process != getpid() || loan->process != startup_source.owner_process ||
+        !qemu_thread_is_self(&loan->thread) || !qemu_in_main_thread() ||
+        !bql_locked() || qemu_in_coroutine() || !loan->serial ||
+        loan->serial != binding->serial) {
+        return -EPERM;
+    }
+    return source_control_binding_identity(binding);
+}
+
+int qemu_crucible_source_control_invocation_current_v1(
+    QemuCrucibleSourceControlInvocation *loan, bool admission)
+{
+    int status = source_control_invocation_identity(loan);
+
+    if (status) {
+        return status;
+    }
+    if (admission) {
+        if (!loan->active || loan->returned || loan->first_status ||
+            loan->post_status || loan->binding->first_status) {
+            return -EPERM;
+        }
+        status = qemu_plugin_crucible_source_control_dispatch_current_v1(
+            loan->binding->callback, loan->binding->userdata);
+        if (status) {
+            return status;
+        }
+    }
+    return source_control_binding_current(loan->binding);
+}
+
+int qemu_crucible_source_control_callback_begin_v1(
+    qemu_plugin_vcpu_idle_resume_cb_t callback, void *userdata,
+    QemuCrucibleSourceControlInvocation **out)
+{
+    QemuCrucibleSourceControlBinding *binding = &startup_source.control_callback;
+    QemuCrucibleSourceControlInvocation *loan = &binding->invocation;
+    int status;
+
+    if (!out) {
+        return -EINVAL;
+    }
+    *out = NULL;
+    if (!qemu_in_main_thread() || !bql_locked() || qemu_in_coroutine() ||
+        callback != binding->callback || userdata != binding->userdata) {
+        return -EPERM;
+    }
+    status = source_control_binding_current(binding);
+    if (!status) {
+        status = qemu_plugin_crucible_source_control_dispatch_current_v1(callback, userdata);
+    }
+    if (status) {
+        return status;
+    }
+    if (binding->first_status || loan->held || binding->serial == UINT64_MAX) {
+        return binding->first_status ? binding->first_status : -EBUSY;
+    }
+    *loan = (QemuCrucibleSourceControlInvocation) {
+        .binding = binding,
+        .process = getpid(),
+        .serial = ++binding->serial,
+        .held = true,
+        .active = true,
+    };
+    qemu_thread_get_self(&loan->thread);
+    *out = loan;
+
+    /* Custody precedes independent publication post. Failed post leaves the
+     * exact output loan for actual callback return/cleanup, never a new bank. */
+    status = source_control_binding_current(binding);
+    if (status) {
+        loan->first_status = loan->post_status = status;
+        binding->first_status = status;
+    }
+    return status;
+}
+
+int qemu_crucible_source_control_invocation_retain_v1(
+    QemuCrucibleSourceControlInvocation *loan)
+{
+    int status = qemu_crucible_source_control_invocation_current_v1(loan, true);
+
+    if (status) {
+        return status;
+    }
+    if (loan->retained) {
+        return -EALREADY;
+    }
+    /* Native Stop admission takes this exact physical loan before its effects.
+     * The separate Stop issuer still authenticates intent and vmstop state. */
+    loan->retained = true;
+    return 0;
+}
+
+int qemu_crucible_source_control_callback_end_v1(
+    QemuCrucibleSourceControlInvocation *loan)
+{
+    int status = source_control_invocation_identity(loan);
+    int post;
+
+    if (status) {
+        return status;
+    }
+    if (!loan->active || loan->returned) {
+        return -EPERM;
+    }
+    status = qemu_plugin_crucible_source_control_dispatch_current_v1(
+        loan->binding->callback, loan->binding->userdata);
+    if (status) {
+        return status;
+    }
+    post = source_control_binding_current(loan->binding);
+    if (post) {
+        if (!loan->first_status) {
+            loan->first_status = post;
+        }
+        if (!loan->post_status) {
+            loan->post_status = post;
+        }
+        if (!loan->binding->first_status) {
+            loan->binding->first_status = post;
+        }
+    }
+    loan->active = false;
+    loan->returned = true;
+    if (!loan->retained && !post) {
+        loan->held = false;
+    }
+    return post;
+}
+
+int qemu_crucible_source_control_invocation_return_v1(
+    QemuCrucibleSourceControlInvocation *loan)
+{
+    int status = qemu_crucible_source_control_invocation_current_v1(loan, false);
+
+    if (status) {
+        return status;
+    }
+    if (loan->active || !loan->returned) {
+        return -EBUSY;
+    }
+    status = qemu_plugin_crucible_source_control_return_current_v1(loan);
+    if (status) {
+        return status;
+    }
+    loan->retained = false;
+    loan->held = false;
+    return 0;
+}
diff --git a/plugins/crucible-control-stop.h b/plugins/crucible-control-stop.h
new file mode 100644
index 0000000000000000000000000000000000000000..c59aa6c7a3c1078aa88a3019b2104ccac7a965dc
