+static void test_setup_fd_refusals(void)
+{
+#ifdef CONFIG_LINUX
+    const int seals = F_SEAL_WRITE | F_SEAL_SHRINK | F_SEAL_GROW | F_SEAL_SEAL;
+    static const int required[] = {
+        F_SEAL_WRITE, F_SEAL_SHRINK, F_SEAL_GROW, F_SEAL_SEAL,
+    };
+    uint8_t wire[301] = { 0 };
+    struct stat identity;
+    uint32_t total = fixture_setup(wire, 3, 5, 128, 128);
+    int pipe_fds[2];
+    int descriptor_flags;
+    int status_flags;
+    int fd;
+
+    fixture_record(wire + 44, 1, 0);
+    fixture_startup(wire + 172, 0, 3);
+    assert_fd_refusal(-1);
+    g_assert_cmpint(pipe2(pipe_fds, O_CLOEXEC), ==, 0);
+    assert_fd_refusal(pipe_fds[0]);
+    g_assert_cmpint(fcntl(pipe_fds[0], F_GETFD), >=, 0);
+    g_assert_cmpint(close(pipe_fds[0]), ==, 0);
+    g_assert_cmpint(close(pipe_fds[1]), ==, 0);
+
+    fd = fixture_setup_fd(wire, total, seals);
+    g_assert_cmpint(qemu_crucible_device_workspace_setup_read_fd(fd, NULL),
+                    <, 0);
+    g_assert_cmpint(fcntl(fd, F_GETFD), >=, 0);
+    g_assert_cmpint(close(fd), ==, 0);
+    assert_fd_refusal(fd);
+
+    for (size_t index = 0; index < G_N_ELEMENTS(required); index++) {
+        fd = fixture_setup_fd(wire, total, seals & ~required[index]);
+        assert_fd_refusal(fd);
+        g_assert_cmpint(fcntl(fd, F_GETFD), >=, 0);
+        g_assert_cmpint(close(fd), ==, 0);
+    }
+    fd = fixture_setup_fd(wire, total, 0);
+    assert_fd_refusal(fd);
+    g_assert_cmpint(close(fd), ==, 0);
+
+    /* Actual immutable files retain malformed/truncated/trailing evidence. */
+    fd = fixture_setup_fd(wire, 0, seals);
+    assert_fd_refusal(fd);
+    g_assert_cmpint(close(fd), ==, 0);
+    fd = fixture_setup_fd(wire, 35, seals);
+    assert_fd_refusal(fd);
+    g_assert_cmpint(close(fd), ==, 0);
+    fd = fixture_setup_fd(wire, total - 1, seals);
+    assert_fd_refusal(fd);
+    g_assert_cmpint(close(fd), ==, 0);
+    fd = fixture_setup_fd(wire, total + 1, seals);
+    assert_fd_refusal(fd);
+    g_assert_cmpint(close(fd), ==, 0);
+
+    wire[0] = 'X';
+    fd = fixture_setup_fd(wire, total, seals);
+    assert_fd_refusal(fd);
+    g_assert_cmpint(close(fd), ==, 0);
+    fixture_setup(wire, 3, 5, 128, 128);
+    fixture_be32(wire, 28, 127);
+    fd = fixture_setup_fd(wire, total, seals);
+    assert_fd_refusal(fd);
+    g_assert_cmpint(close(fd), ==, 0);
+    fixture_setup(wire, 3, 5, 128, 128);
+    fixture_be32(wire, 32, 129);
+    fd = fixture_setup_fd(wire, total, seals);
+    assert_fd_refusal(fd);
+    g_assert_cmpint(close(fd), ==, 0);
+    fixture_setup(wire, 3, 5, 128, 128);
+    fixture_be32(wire, 12, 32);
+    fd = fixture_setup_fd(wire, total, seals);
+    assert_fd_refusal(fd);
+    g_assert_cmpint(close(fd), ==, 0);
+    fixture_setup(wire, 3, 5, 128, 128);
+    fixture_be32(wire, 172 + 8, 1);
+    fd = fixture_setup_fd(wire, total, seals);
+    assert_fd_refusal(fd);
+    g_assert_cmpint(close(fd), ==, 0);
+
+    fixture_startup(wire + 172, 0, 3);
+    fixture_be64(wire, 172 + 120, 0);
+    fd = fixture_setup_fd(wire, total, seals);
+    assert_fd_refusal(fd);
+    g_assert_cmpint(close(fd), ==, 0);
+
+    fixture_startup(wire + 172, 0, 3);
+    fixture_be64(wire, 172 + 80, FIXTURE_PROCESS + 1);
+    fd = fixture_setup_fd(wire, total, seals);
+    assert_fd_refusal(fd);
+    g_assert_cmpint(close(fd), ==, 0);
+    fixture_startup(wire + 172, 0, 3);
+    fixture_be64(wire, 172 + 120, FIXTURE_TOTAL + 1);
+    fd = fixture_setup_fd(wire, total, seals);
+    g_assert_cmpint(fstat(fd, &identity), ==, 0);
+    g_assert_true(lseek(fd, 11, SEEK_SET) == 11);
+    descriptor_flags = fcntl(fd, F_GETFD);
+    status_flags = fcntl(fd, F_GETFL);
+
+    assert_fd_refusal(fd);
+
+    assert_fd_identity(fd, &identity, descriptor_flags, status_flags, 11);
+    g_assert_cmpint(close(fd), ==, 0);
+
+    fd = memfd_create("crucible-setup-over-cap",
+                      MFD_CLOEXEC | MFD_ALLOW_SEALING);
+    g_assert_cmpint(fd, >=, 0);
+    g_assert_cmpint(ftruncate(fd, 37748765), ==, 0);
+    g_assert_cmpint(fcntl(fd, F_ADD_SEALS, seals), ==, 0);
+    assert_fd_refusal(fd);
+    g_assert_cmpint(close(fd), ==, 0);
+#else
+    g_test_skip("Linux immutable memfd reader controls");
+#endif
+}
