+int qemu_crucible_checkpoint_inventory_begin_v1(
+    void *monitor, QemuCrucibleCheckpointInventoryLoan **out)
+{
+    QemuCrucibleCheckpointHeldTransaction *owner = &checkpoint_transaction;
+    QemuCrucibleCheckpointInventoryLoan *loan = &owner->inventory;
+    uint64_t slice;
+    int status;
+
+    if (!out || *out || loan->active || owner->invocation.active ||
+        owner->invoking || owner->cleanup_invoking || owner->finalize_invoking ||
+        owner->candidate_read.active || monitor != monitor_cur() ||
+        !qemu_in_main_thread() || !bql_locked() || qemu_in_coroutine()) {
+        return -EPERM;
+    }
+    /* This authenticates the actual already entered request/provider and
+     * binds its genuine ordinary Stop receipt. Paused/token facts cannot. */
+    status = checkpoint_inventory_admission_identity(monitor);
+    if (status) {
+        return status;
+    }
+    *loan = (QemuCrucibleCheckpointInventoryLoan) {
+        .transaction = owner,
+        .request = owner->request,
+        .provider_owner = owner->request->provider_owner,
+        .stop = &checkpoint_stop_owner,
+        .process = getpid(),
+        .stopped_generation = owner->stopped_generation,
+        .output.fd = -1,
+        .cancellation.fd = -1,
+        .active = true,
+    };
+    qemu_thread_get_self(&loan->thread);
+    *out = loan;
+#ifdef CONFIG_LINUX
+    status = qemu_crucible_startup_source_checkpoint_inventory_metadata_begin_v1(
+        loan, &loan->metadata_borrow);
+#else
+    status = -ENOTSUP;
+#endif
+    if (status) {
+        loan->first_status = status;
+        return status;
+    }
+    /* Born custody precedes this independent trailing Original observation. */
+    status = qemu_crucible_checkpoint_inventory_current_v1(loan, &slice);
+    if (status) {
+        loan->first_status = status;
+    }
+    return status;
+}
