+        if (!(domain & domains)) {
+            continue;
+        }
+        projection = se->vmsd ?
+            se->vmsd->crucible_fingerprint_projection :
+            se->ops->crucible_fingerprint_projection;
+        if (!projection || !projection->schema || !projection->schema[0] ||
+            projection->version == 0 || !projection->save) {
+            memset(digest, 0, 32);
+            return -ENOTSUP;
+        }
+        sections++;
+        crucible_checksum_string(checksum, "read-only-section");
+        crucible_checksum_string(checksum, se->idstr);
+        crucible_checksum_u64(checksum, se->instance_id);
+        crucible_checksum_string(checksum,
+                                 se->vmsd ? se->vmsd->name : se->idstr);
+        crucible_checksum_u64(checksum,
+                              se->vmsd ? se->vmsd->version_id :
