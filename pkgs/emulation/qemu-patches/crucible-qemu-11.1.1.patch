+    "node_cpu_memory_ticket_clear",
+    "node_cpu_memory_ticket_identity",
+    "qemu_crucible_fault_cpu_memory_ticket_pending",
+    "qemu_crucible_fault_cpu_memory_ticket_active",
+    "qemu_crucible_fault_cpu_memory_ticket_replay_load",
+    "qemu_crucible_fault_cpu_memory_ticket_replay_store",
+    "qemu_crucible_fault_cpu_memory_candidate_record",
+    "qemu_crucible_fault_cpu_memory_candidate_discard",
+    "qemu_crucible_fault_cpu_memory_ticket_stage",
+    "node_cpu_memory_service_boundary",
+)
+CONTROLS = (
+    "standalone", "suppressed", "compound", "identity", "load",
+    "class-refusal", "deadlines", "no-delay",
+)
+PREDECESSOR_FAILURES = {"standalone", "suppressed", "identity", "class-refusal"}
+
+
+def definition(source, start):
+    """Extract a brace-balanced definition while ignoring comments and strings."""
+    opening = source.index("{", start)
+    depth = 0
+    state = "code"
+    index = opening
+
+    while index < len(source):
+        character = source[index]
+        pair = source[index:index + 2]
+        if state == "code":
+            if pair == "/*":
+                state = "comment"
+                index += 2
+                continue
+            if pair == "//":
+                state = "line"
+                index += 2
+                continue
+            if character in "\"'":
+                state = character
+            elif character == "{":
+                depth += 1
+            elif character == "}":
+                depth -= 1
+                if depth == 0:
+                    return source[start:index + 1]
+        elif state == "comment":
+            if pair == "*/":
+                state = "code"
+                index += 2
+                continue
+        elif state == "line":
+            if character == "\n":
+                state = "code"
+        elif character == "\\":
+            index += 2
+            continue
+        elif character == state:
+            state = "code"
+        index += 1
+
+    raise AssertionError("unterminated production definition")
+
+
+def function(source, name):
+    match = re.search(
+        r"(?m)^(?:static )?(?:bool|void)\s+" + re.escape(name) +
+        r"\([^;]*?\)\s*\{", source,
+    )
+    assert match is not None, name
+    return definition(source, match.start())
+
+
+def typedef(source, name):
+    start = source.index("typedef struct " + name + " {")
+    end = source.index("} " + name + ";", start) + len("} " + name + ";")
+    return source[start:end]
+
+
+def constant(source, name):
+    match = re.search(r"(?m)^#define " + re.escape(name) + r" [^\n]+$", source)
+    assert match is not None, name
+    return match.group()
+
+
+PRELUDE = r"""
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+typedef struct { int identity; } QemuCrucibleFaultRule;
+typedef struct { int identity; } QemuCrucibleFaultEventReservation;
+typedef struct CPUState {
+    uint32_t cpu_index;
+    uint64_t crucible_memory_service_ticks;
+} CPUState;
+"""
+
+PROVIDERS = r"""
+static CPUState only_cpu = { .cpu_index = 6 };
+static CrucibleCpuMemoryTicket current;
+static QemuCrucibleFaultRule rule = { .identity = 11 };
+static QemuCrucibleFaultEventReservation reservation = { .identity = 17 };
+static int64_t now;
+static unsigned writes, publishes, clears;
+static uint8_t physical_byte;
+
+#define CPU_FOREACH(cpu) \
+    for ((cpu) = &only_cpu; (cpu); (cpu) = NULL)
+#define error_report(message) fputs((message), stderr)
+
+static bool qemu_crucible_fault_cpu_memory_ticket_supported(const CPUState *cpu)
+{
+    return cpu == &only_cpu;
+}
+
+static CrucibleCpuMemoryTicket *node_cpu_memory_ticket(CPUState *cpu, bool create)
+{
+    (void)create;
+    return cpu == &only_cpu ? &current : NULL;
+}
+
+static bool qemu_crucible_fault_deferred_service_valid(
+    const QemuCrucibleDeferredMemoryService *service)
+{
+    return service->rule == &rule &&
+           service->event_reservation == &reservation &&
+           service->ready_tick >= service->grant_tick;
+}
+
+static void qemu_crucible_fault_deferred_service_clear(
+    QemuCrucibleDeferredMemoryService *service)
+{
+    clears++;
+    memset(service, 0, sizeof(*service));
+}
+
+static void qemu_crucible_fault_deferred_service_publish(
+    QemuCrucibleDeferredMemoryService *service)
+{
+    assert(service->grant_tick == 55 && service->ready_tick == 77);
+    assert(service->observed_icount == 41);
+    assert(service->rule == &rule && service->event_reservation == &reservation);
+    for (unsigned index = 0; index < 32; index++) {
+        assert(service->opportunity_hash[index] == (uint8_t)(index + 1));
+        assert(service->before_hash[index] == (uint8_t)(index + 33));
+        assert(service->after_hash[index] == (uint8_t)(index + 65));
+    }
+    for (unsigned index = 0; index < sizeof(service->evidence); index++) {
+        assert(service->evidence[index] == (uint8_t)(index ^ 0xa5));
+    }
+    publishes++;
+    service->rule = NULL;
+    service->event_reservation = NULL;
+}
+
+static int64_t icount_crucible_sim_tick_observed(void)
+{
+    return now;
+}
+
+static void physical_memory_write(uint64_t address, const uint8_t *bytes,
+                                  size_t size)
+{
+    assert(address == 0x1234 && size == 1);
+    writes++;
+    physical_byte = *bytes;
+}
+"""
+
+CHECKS = r"""
+static void setup(void)
+{
+    memset(&current, 0, sizeof(current));
+    writes = publishes = clears = 0;
+    physical_byte = 0;
+    now = 55;
+    only_cpu.crucible_memory_service_ticks = 22;
+
+    current.service.grant_tick = 55;
+    current.service.ready_tick = 77;
+    current.service.observed_icount = 41;
+    current.service.rule = &rule;
+    current.service.event_reservation = &reservation;
+    for (unsigned index = 0; index < 32; index++) {
+        current.service.opportunity_hash[index] = (uint8_t)(index + 1);
+        current.service.before_hash[index] = (uint8_t)(index + 33);
+        current.service.after_hash[index] = (uint8_t)(index + 65);
+    }
+    for (unsigned index = 0; index < sizeof(current.service.evidence); index++) {
+        current.service.evidence[index] = (uint8_t)(index ^ 0xa5);
+    }
+}
+
+static void stage_store(bool suppress)
+{
+    assert(qemu_crucible_fault_cpu_memory_ticket_stage(
+        &only_cpu, QEMU_CRUCIBLE_MEMORY_CPU_STORE, 0x2345, 0x1234,
+        0x33, suppress, 0x9999, 4));
+}
+
+static bool replay_store(void)
+{
+    return qemu_crucible_fault_cpu_memory_ticket_replay_store(
+        &only_cpu, 0x2345, 0x9999, 4);
+}
+
+static void complete(void)
+{
+    now = 77;
+    node_cpu_memory_service_boundary(CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY, 100);
+}
+
+static void standalone(void)
+{
+    setup();
+    stage_store(false);
+    assert(current.replay_phase == CRUCIBLE_CPU_MEMORY_REPLAY_ACCESS);
+    assert(qemu_crucible_fault_cpu_memory_ticket_pending(&only_cpu));
+    CrucibleCpuMemoryTicket saved = current;
+
+    assert(!replay_store());
+    assert(memcmp(&saved, &current, sizeof(saved)) == 0);
+    assert(writes == 0 && publishes == 0);
+
+    complete();
+    assert(writes == 1 && physical_byte == 0x33 && publishes == 1);
+    assert(replay_store());
+    assert(!qemu_crucible_fault_cpu_memory_ticket_active(&only_cpu));
+    assert(clears == 1);
+    assert(!replay_store());
+    assert(writes == 1 && publishes == 1 && clears == 1);
+}
+
+static void suppressed(void)
+{
+    setup();
+    stage_store(true);
+    complete();
+
+    assert(writes == 0 && publishes == 1);
+    assert(replay_store());
+    assert(clears == 1 && writes == 0);
+}
+
+static void compound(void)
+{
+    uint8_t value = 0;
+
+    setup();
+    qemu_crucible_fault_cpu_memory_candidate_record(
+        &only_cpu, 0x1111, 0x5a, 0x9999, 4);
+    stage_store(false);
+    assert(current.replay_phase == CRUCIBLE_CPU_MEMORY_REPLAY_LOAD);
+    complete();
+
+    assert(!replay_store());
+    assert(qemu_crucible_fault_cpu_memory_ticket_replay_load(
+        &only_cpu, 0x1111, 0x9999, 4, &value));
+    assert(value == 0x5a);
+    assert(current.replay_phase == CRUCIBLE_CPU_MEMORY_REPLAY_STORE);
+    assert(replay_store());
+    assert(writes == 1 && publishes == 1 && clears == 1);
+}
+
+static void identity(void)
+{
+    setup();
+    stage_store(false);
+    complete();
+    CrucibleCpuMemoryTicket saved = current;
+
+    assert(!qemu_crucible_fault_cpu_memory_ticket_replay_store(
+        &only_cpu, 0x2346, 0x9999, 4));
+    assert(!qemu_crucible_fault_cpu_memory_ticket_replay_store(
+        &only_cpu, 0x2345, 0x9998, 4));
+    assert(!qemu_crucible_fault_cpu_memory_ticket_replay_store(
+        &only_cpu, 0x2345, 0x9999, 5));
+    assert(memcmp(&saved, &current, sizeof(saved)) == 0);
+    assert(replay_store());
+}
+
+static void load(void)
+{
+    uint8_t value = 0;
+
+    setup();
+    assert(qemu_crucible_fault_cpu_memory_ticket_stage(
+        &only_cpu, QEMU_CRUCIBLE_MEMORY_CPU_LOAD, 0x2345, 0x1234,
+        0x7a, false, 0x9999, 4));
+    complete();
+
+    assert(writes == 0 && !replay_store());
+    assert(qemu_crucible_fault_cpu_memory_ticket_replay_load(
+        &only_cpu, 0x2345, 0x9999, 4, &value));
+    assert(value == 0x7a && clears == 1);
+}
+
+static void class_refusal(void)
+{
+    setup();
+    stage_store(false);
+    complete();
+    current.access_class = QEMU_CRUCIBLE_MEMORY_CPU_LOAD;
+    current.replay_phase = CRUCIBLE_CPU_MEMORY_REPLAY_STORE;
+    CrucibleCpuMemoryTicket saved = current;
+
+    assert(!replay_store());
+    assert(memcmp(&saved, &current, sizeof(saved)) == 0);
+}
+
+static void deadlines(void)
+{
+    setup();
+    stage_store(false);
+    now = 76;
+    node_cpu_memory_service_boundary(CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY, 100);
+    assert(writes == 0 && !current.ready);
+
+    now = 77;
+    node_cpu_memory_service_boundary(2, 100);
+    assert(writes == 0 && !current.ready);
+    complete();
+    node_cpu_memory_service_boundary(CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY, 101);
+    assert(writes == 1 && publishes == 1);
+}
+
+static void no_delay(void)
+{
+    setup();
+    only_cpu.crucible_memory_service_ticks = 0;
+    CrucibleCpuMemoryTicket saved = current;
+
+    assert(!qemu_crucible_fault_cpu_memory_ticket_stage(
+        &only_cpu, QEMU_CRUCIBLE_MEMORY_CPU_STORE, 0x2345, 0x1234,
+        0x33, false, 0x9999, 4));
+    assert(memcmp(&saved, &current, sizeof(saved)) == 0);
+    qemu_crucible_fault_cpu_memory_candidate_discard(&only_cpu);
+}
+
+int main(int argc, char **argv)
+{
+    assert(argc == 2);
+    if (!strcmp(argv[1], "standalone")) {
+        standalone();
+    } else if (!strcmp(argv[1], "suppressed")) {
+        suppressed();
+    } else if (!strcmp(argv[1], "compound")) {
+        compound();
+    } else if (!strcmp(argv[1], "identity")) {
+        identity();
+    } else if (!strcmp(argv[1], "load")) {
+        load();
+    } else if (!strcmp(argv[1], "class-refusal")) {
+        class_refusal();
+    } else if (!strcmp(argv[1], "deadlines")) {
+        deadlines();
+    } else if (!strcmp(argv[1], "no-delay")) {
+        no_delay();
+    } else {
+        abort();
+    }
+    puts("PASS");
+    return 0;
+}
+"""
+
+
+def check_variant(output, name, bodies, declarations):
+    directory = output / name
+    directory.mkdir(parents=True, exist_ok=True)
+    for function_name, body in zip(FUNCTIONS, bodies):
+        (directory / (function_name + ".c")).write_text(body + "\n")
+
+    prototypes = "\n".join(body[:body.index("{")].strip() + ";" for body in bodies)
+    generated = directory / "memory-service-ticket.c"
+    generated.write_text(
+        PRELUDE + declarations + PROVIDERS + prototypes + "\n\n" +
+        "\n\n".join(bodies) + CHECKS,
+    )
+    binary = directory / "memory-service-ticket"
+    command = [
+        os.environ.get("CC", "cc"),
+        *shlex.split(os.environ.get("CFLAGS", "")),
+        str(generated), "-o", str(binary),
+        *shlex.split(os.environ.get("LDFLAGS", "")),
+    ]
+    (directory / "compile-command.json").write_text(
+        json.dumps({"cwd": os.getcwd(), "argv": command}, indent=2) + "\n",
+    )
+    subprocess.run(command, check=True)
+
+    results = []
+    for control in CONTROLS:
+        result = subprocess.run(
+            [str(binary), control], cwd=directory,
+            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
+        )
+        (directory / (control + ".log")).write_text(result.stdout)
+        expected_failure = name == "predecessor" and control in PREDECESSOR_FAILURES
+        if expected_failure:
+            assert result.returncode == -signal.SIGABRT, (control, result)
+            expression = "!replay_store()" if control == "class-refusal" else "replay_store()"
+            assert expression in result.stdout and "Assertion" in result.stdout, result
+        else:
+            assert result.returncode == 0 and result.stdout == "PASS\n", result
+        results.append({"control": control, "exit": result.returncode})
+    return results
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--output-dir", type=Path, required=True)
+    parser.add_argument("--source-root", type=Path, default=ROOT)
+    arguments = parser.parse_args()
+    arguments.output_dir.mkdir(parents=True, exist_ok=True)
+    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
+
+    source = (arguments.source_root / "plugins/crucible-fault-node.c").read_text()
+    header = (arguments.source_root / "include/qemu/crucible-fault.h").read_text()
+    abi = (arguments.source_root / "include/aos/crucible/crucible_shmem_abi.h").read_text()
+    enum_start = header.index("enum QemuCrucibleMemoryAccessClass {")
+    access_class = definition(header, enum_start) + ";\n"
+    definitions = [function(source, name) for name in FUNCTIONS]
+    declarations = "\n".join((
+        constant(source, "CRUCIBLE_CPU_MEMORY_REPLAY_ACCESS"),
+        constant(source, "CRUCIBLE_CPU_MEMORY_REPLAY_LOAD"),
+        constant(source, "CRUCIBLE_CPU_MEMORY_REPLAY_STORE"),
+        constant(header, "QEMU_CRUCIBLE_DEFERRED_SERVICE_EVIDENCE_SIZE"),
+        constant(abi, "CRUCIBLE_FAULT_PHASE_NODE_BOUNDARY"),
+        access_class,
+        typedef(header, "QemuCrucibleDeferredMemoryService"),
+        typedef(source, "CrucibleCpuMemoryTicket"),
+    )) + "\n"
+
+    corrected = """        ticket->access_class != QEMU_CRUCIBLE_MEMORY_CPU_STORE ||
+        (ticket->replay_phase != CRUCIBLE_CPU_MEMORY_REPLAY_ACCESS &&
+         ticket->replay_phase != CRUCIBLE_CPU_MEMORY_REPLAY_STORE) ||"""
+    old = """        ticket->replay_phase != CRUCIBLE_CPU_MEMORY_REPLAY_STORE ||"""
+    index = FUNCTIONS.index("qemu_crucible_fault_cpu_memory_ticket_replay_store")
+    assert definitions[index].count(corrected) == 1
+    predecessor = definitions.copy()
+    predecessor[index] = predecessor[index].replace(corrected, old)
+
+    results = {
+        "production": check_variant(arguments.output_dir, "production", definitions, declarations),
+        "predecessor": check_variant(arguments.output_dir, "predecessor", predecessor, declarations),
+    }
+    (arguments.output_dir / "results.json").write_text(json.dumps(results, indent=2) + "\n")
+    print("PASS production memory-service tickets: eight continuation controls; four matched predecessor failures")
+
+
+if __name__ == "__main__":
+    main()
