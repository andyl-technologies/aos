+    timer_mod_ps_wide(restored.pmu_timer, 42);
+    bytes = save_state(&timer_fixture, &original);
+    payload = exact_payload(bytes);
+
+    switch (kind) {
+    case 0:
+        g_byte_array_set_size(bytes, 24);
+        g_byte_array_append(bytes, (const uint8_t[]){ QEMU_VM_EOF }, 1);
+        break;
+    case 1: {
+        size_t start = payload - strlen("cpu/timers-wide") - 6;
+        size_t length = bytes->len - start - 1;
+        guint8 *copy = g_memdup2(bytes->data + start, length);
+
+        g_byte_array_set_size(bytes, bytes->len + length);
+        bytes->data[bytes->len - 1] = QEMU_VM_EOF;
+        memcpy(bytes->data + start + length, copy, length);
+        g_free(copy);
+        break;
+    }
+    case 2:
+        bytes->data[payload] = 2;
+        break;
+    case 3:
+        bytes->data[payload + 2] = 2;
+        break;
+    case 4:
+        bytes->data[7] ^= 1;
+        break;
+    case 5:
+        bytes->data[payload + 2] = 0;
+        break;
+    case 6:
+        bytes->data[payload - 1] = 0;
+        break;
+    case 7:
+        bytes->data[payload + 1] = 0;
+        break;
+    case 8:
+        bytes->data[payload + 3] = 0;
+        bytes->data[payload + 5 + 8 + 7] = 1;
+        break;
+    default:
+        g_assert_not_reached();
+    }
+
+    g_assert_cmpint(load_state(&timer_fixture, &restored, bytes), <, 0);
+    for (unsigned i = 0; i < NUM_GTIMERS; i++) {
+        g_assert_false(timer_pending(restored.gt_timer[i]));
+    }
+    g_assert_false(timer_pending(restored.wfxt_timer));
+    g_assert_false(timer_pending(restored.pmu_timer));
+    g_assert_cmpuint(callbacks, ==, 0);
+
+    g_byte_array_unref(bytes);
+    destroy_timers(&original);
+    destroy_timers(&restored);
+}
