+static int crucible_fault_vmstate_section_compare(gconstpointer left,
+                                                  gconstpointer right)
+{
+    const QemuCrucibleFaultVmstateSection *a = *(const void *const *)left;
+    const QemuCrucibleFaultVmstateSection *b = *(const void *const *)right;
+
+    return strcmp(a->name, b->name);
+}
+
+void qemu_crucible_fault_vmstate_register(
+    const QemuCrucibleFaultVmstateSection *section)
+{
+    g_assert(section && section->name && section->version != 0);
+    g_assert(section->save && section->fingerprint_projection &&
+             section->prepare && section->commit && section->free_staged);
+    g_assert(strlen(section->name) <= CRUCIBLE_FAULT_VMSTATE_MAX_NAME_BYTES);
+    if (!crucible_fault_vmstate_sections) {
+        crucible_fault_vmstate_sections = g_ptr_array_new();
+    }
+    for (size_t i = 0; i < crucible_fault_vmstate_sections->len; i++) {
+        const QemuCrucibleFaultVmstateSection *existing =
+            g_ptr_array_index(crucible_fault_vmstate_sections, i);
+        g_assert(strcmp(existing->name, section->name) != 0);
+    }
+    g_ptr_array_add(crucible_fault_vmstate_sections, (void *)section);
+    g_ptr_array_sort(crucible_fault_vmstate_sections,
+                     crucible_fault_vmstate_section_compare);
+}
+
+void qemu_crucible_fault_vmstate_expect_reservations(size_t count)
+{
+    g_assert(!crucible_fault_vmstate_has_expected_reservations);
+    crucible_fault_vmstate_expected_reservations = count;
+    crucible_fault_vmstate_has_expected_reservations = true;
+}
+
+void qemu_crucible_fault_vmstate_count_reservations(size_t count)
+{
+    g_assert(crucible_fault_vmstate_counted_reservations <=
+             SIZE_MAX - count);
+    crucible_fault_vmstate_counted_reservations += count;
+}
+
+void qemu_crucible_fault_vmstate_expect_deferred(size_t count)
+{
+    g_assert(!crucible_fault_vmstate_has_expected_deferred);
+    crucible_fault_vmstate_expected_deferred = count;
+    crucible_fault_vmstate_has_expected_deferred = true;
+}
+
+void qemu_crucible_fault_vmstate_count_deferred(size_t count)
+{
+    g_assert(crucible_fault_vmstate_counted_deferred <= SIZE_MAX - count);
+    crucible_fault_vmstate_counted_deferred += count;
+}
+
+static int crucible_fault_vmstate_registry_validate(void)
+{
+    bool required_seen[G_N_ELEMENTS(crucible_fault_vmstate_required)] = { 0 };
+
+    if (!crucible_fault_vmstate_sections ||
+        crucible_fault_vmstate_sections->len <
+            G_N_ELEMENTS(crucible_fault_vmstate_required) ||
+        crucible_fault_vmstate_sections->len >
+            G_N_ELEMENTS(crucible_fault_vmstate_required) +
+                G_N_ELEMENTS(crucible_fault_vmstate_optional)) {
+        return -EINVAL;
+    }
+    for (size_t section_index = 0;
+         section_index < crucible_fault_vmstate_sections->len;
+         section_index++) {
+        const QemuCrucibleFaultVmstateSection *section =
+            g_ptr_array_index(crucible_fault_vmstate_sections, section_index);
+        bool known = false;
+
+        for (size_t required = 0;
+             required < G_N_ELEMENTS(crucible_fault_vmstate_required);
+             required++) {
+            if (strcmp(section->name,
+                       crucible_fault_vmstate_required[required]) == 0) {
+                required_seen[required] = true;
+                known = true;
+                break;
+            }
+        }
+        for (size_t optional = 0;
+             !known && optional < G_N_ELEMENTS(crucible_fault_vmstate_optional);
+             optional++) {
+            known = strcmp(section->name,
+                           crucible_fault_vmstate_optional[optional]) == 0;
+        }
+        if (!known) {
+            return -EINVAL;
+        }
+    }
+    for (size_t required = 0;
+         required < G_N_ELEMENTS(crucible_fault_vmstate_required);
+         required++) {
+        if (!required_seen[required]) {
+            return -EINVAL;
+        }
+    }
+    return 0;
+}
+
+static bool crucible_fault_vmstate_section_registered(const char *name)
+{
+    for (size_t i = 0; i < crucible_fault_vmstate_sections->len; i++) {
+        const QemuCrucibleFaultVmstateSection *section =
+            g_ptr_array_index(crucible_fault_vmstate_sections, i);
+
+        if (strcmp(section->name, name) == 0) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static bool crucible_fault_vmstate_profile_section(
+    uint32_t profile, const char *name)
+{
+    if (profile == CRUCIBLE_FAULT_VMSTATE_PROFILE_COMPLETE) {
+        return true;
+    }
+    return profile == CRUCIBLE_FAULT_VMSTATE_PROFILE_HOST_MEMORY_SERVICE &&
+        (strcmp(name, "command") == 0 ||
+         strcmp(name, "cpu-memory-service-ticket") == 0 ||
+         strcmp(name, "fwcfg-service") == 0 ||
+         strcmp(name, "memory") == 0 ||
+         strcmp(name, "node-rules") == 0);
+}
+
+static uint32_t crucible_fault_vmstate_profile(void)
+{
+    return qemu_crucible_fault_lifecycle_process_bound() ?
+        CRUCIBLE_FAULT_VMSTATE_PROFILE_COMPLETE :
+        CRUCIBLE_FAULT_VMSTATE_PROFILE_HOST_MEMORY_SERVICE;
+}
+
+static uint32_t crucible_fault_vmstate_profile_count(uint32_t profile)
+{
+    uint32_t count = 0;
+
+    for (size_t i = 0; i < crucible_fault_vmstate_sections->len; i++) {
+        const QemuCrucibleFaultVmstateSection *section =
+            g_ptr_array_index(crucible_fault_vmstate_sections, i);
+
+        count += crucible_fault_vmstate_profile_section(
+            profile, section->name);
+    }
+    return count;
+}
+
+typedef int (*CrucibleManifestWrite)(void *opaque, const void *bytes,
+                                    size_t length);
+
+/* Both adapters consume the same sorted, complete registry byte stream. */
+static int crucible_fault_system_manifest_stream(CrucibleManifestWrite write,
+                                                 void *opaque)
+{
+    for (size_t index = 0; index < crucible_fault_vmstate_sections->len; index++) {
+        const QemuCrucibleFaultVmstateSection *section =
+            g_ptr_array_index(crucible_fault_vmstate_sections, index);
+        uint8_t version[4];
+        int status;
+
+        status = write(opaque, section->name, strlen(section->name) + 1);
+        if (status) {
+            return status;
+        }
+        stl_be_p(version, section->version);
+        status = write(opaque, version, sizeof(version));
+        if (status) {
+            return status;
+        }
+    }
+    return 0;
+}
+
+static bool crucible_fault_system_manifest_ready(void)
+{
+    return crucible_fault_vmstate_registry_validate() == 0 &&
+        strcmp(QEMU_CRUCIBLE_BUILD_ID, "unconfigured") != 0 &&
+        strcmp(QEMU_CRUCIBLE_ATOMIC_PATCH_HASH, "unconfigured") != 0 &&
+        strcmp(QEMU_CRUCIBLE_SHMEM_HEADER_HASH, "unconfigured") != 0;
+}
+
+static void crucible_fault_system_manifest_publish(
+    struct qemu_plugin_crucible_fault_system_manifest *out)
+{
+    out->semantic_version = 1;
+    out->vmstate_format_version = CRUCIBLE_FAULT_VMSTATE_VERSION;
+    out->vmstate_section_count = crucible_fault_vmstate_sections->len;
+    out->reserved = 0;
+    out->system_capability = "qemu.fault-system.complete.v1";
+    out->vmstate_capability = "qemu.fault-vmstate.v1";
+    out->qemu_build_id = QEMU_CRUCIBLE_BUILD_ID;
+    out->qemu_atomic_patch_hash = QEMU_CRUCIBLE_ATOMIC_PATCH_HASH;
+    out->shmem_header_hash = QEMU_CRUCIBLE_SHMEM_HEADER_HASH;
+}
+
+static int crucible_fault_system_manifest_glib_write(
+    void *opaque, const void *bytes, size_t length)
+{
+    g_checksum_update(opaque, bytes, length);
+    return 0;
+}
+
+int qemu_plugin_crucible_fault_system_manifest(
+    struct qemu_plugin_crucible_fault_system_manifest *out)
+{
+    g_autoptr(GChecksum) checksum = NULL;
+    gsize digest_length = 32;
+    int status;
+
+    if (!out || !crucible_fault_system_manifest_ready()) {
+        return -EINVAL;
+    }
+    checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    status = crucible_fault_system_manifest_stream(
+        crucible_fault_system_manifest_glib_write, checksum);
+    if (status) {
+        return status;
+    }
+    g_checksum_get_digest(checksum, out->vmstate_sections_sha256, &digest_length);
+    g_assert(digest_length == 32);
+    crucible_fault_system_manifest_publish(out);
+    return 0;
+}
+
+static bool crucible_manifest_spans_disjoint(const void *first, size_t first_len,
+                                             const void *second,
+                                             size_t second_len)
+{
+    uintptr_t left = (uintptr_t)first;
+    uintptr_t right = (uintptr_t)second;
+
+    return (!first_len || first) && (!second_len || second) &&
+        first_len <= UINTPTR_MAX - left && second_len <= UINTPTR_MAX - right &&
+        (!first_len || !second_len || left + first_len <= right ||
+         right + second_len <= left);
+}
+
+static bool crucible_manifest_input_disjoint(
+    QCryptoSHA256 *hash, struct qemu_plugin_crucible_fault_system_manifest *out,
+    const void *input, size_t bytes)
+{
+    return crucible_manifest_spans_disjoint(hash, sizeof(*hash), input, bytes) &&
+        crucible_manifest_spans_disjoint(out, sizeof(*out), input, bytes);
+}
+
+static bool crucible_manifest_storage_disjoint(
+    QCryptoSHA256 *hash, struct qemu_plugin_crucible_fault_system_manifest *out)
+{
+    if (!hash || !out || (uintptr_t)hash % _Alignof(QCryptoSHA256) ||
+        (uintptr_t)out % _Alignof(*out) ||
+        !crucible_manifest_spans_disjoint(hash, sizeof(*hash), out, sizeof(*out)) ||
+        !crucible_manifest_input_disjoint(hash, out,
+            &crucible_fault_vmstate_sections,
+            sizeof(crucible_fault_vmstate_sections)) ||
+        !crucible_manifest_input_disjoint(hash, out,
+            crucible_fault_vmstate_sections,
+            sizeof(*crucible_fault_vmstate_sections)) ||
+        !crucible_manifest_input_disjoint(hash, out,
+            crucible_fault_vmstate_sections->pdata,
+            crucible_fault_vmstate_sections->len * sizeof(void *))) {
+        return false;
+    }
+    for (size_t index = 0; index < crucible_fault_vmstate_sections->len; index++) {
+        const QemuCrucibleFaultVmstateSection *section =
+            g_ptr_array_index(crucible_fault_vmstate_sections, index);
+
+        if (!crucible_manifest_input_disjoint(
+                hash, out, section, sizeof(*section)) ||
+            !crucible_manifest_input_disjoint(hash, out,
+                section->name, strlen(section->name) + 1)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static int crucible_fault_system_manifest_sha256_write(
+    void *opaque, const void *bytes, size_t length)
+{
+    return qcrypto_sha256_update(opaque, bytes, length);
+}
+
+int qemu_crucible_fault_system_manifest_into_v1(
+    QCryptoSHA256 *hash, struct qemu_plugin_crucible_fault_system_manifest *out)
+{
+    int status;
+
+    if (!crucible_fault_system_manifest_ready() ||
+        !crucible_manifest_storage_disjoint(hash, out)) {
+        return -EINVAL;
+    }
+    status = qcrypto_sha256_init(hash);
+    if (!status) {
+        status = crucible_fault_system_manifest_stream(
+            crucible_fault_system_manifest_sha256_write, hash);
+    }
+    if (!status) {
+        status = qcrypto_sha256_finalize(
+            hash, out->vmstate_sections_sha256,
+            sizeof(out->vmstate_sections_sha256));
+    }
+    if (!status) {
+        crucible_fault_system_manifest_publish(out);
+    }
+    return status;
+}
+
+void qemu_crucible_fault_vmstate_put_u8(GByteArray *bytes, uint8_t value)
+{
+    g_byte_array_append(bytes, &value, sizeof(value));
+}
+
+void qemu_crucible_fault_vmstate_put_u16(GByteArray *bytes, uint16_t value)
+{
+    uint8_t encoded[2];
+
+    stw_be_p(encoded, value);
+    g_byte_array_append(bytes, encoded, sizeof(encoded));
+}
+
+void qemu_crucible_fault_vmstate_put_u32(GByteArray *bytes, uint32_t value)
+{
+    uint8_t encoded[4];
+
+    stl_be_p(encoded, value);
+    g_byte_array_append(bytes, encoded, sizeof(encoded));
+}
+
+void qemu_crucible_fault_vmstate_put_u64(GByteArray *bytes, uint64_t value)
+{
+    uint8_t encoded[8];
+
+    stq_be_p(encoded, value);
+    g_byte_array_append(bytes, encoded, sizeof(encoded));
+}
+
+void qemu_crucible_fault_vmstate_put_bytes(GByteArray *bytes,
+                                           const void *value, size_t length)
+{
+    g_byte_array_append(bytes, value, length);
+}
+
+bool qemu_crucible_fault_vmstate_get_view(
+    QemuCrucibleFaultVmstateReader *reader, const uint8_t **value,
+    size_t length)
+{
+    if (reader->offset > reader->length ||
+        length > reader->length - reader->offset) {
+        return false;
+    }
+    *value = reader->data + reader->offset;
+    reader->offset += length;
+    return true;
+}
+
+bool qemu_crucible_fault_vmstate_get_bytes(
+    QemuCrucibleFaultVmstateReader *reader, void *value, size_t length)
+{
+    const uint8_t *encoded;
+
+    if (!qemu_crucible_fault_vmstate_get_view(reader, &encoded, length)) {
+        return false;
+    }
+    memcpy(value, encoded, length);
+    return true;
+}
+
+bool qemu_crucible_fault_vmstate_get_u8(
+    QemuCrucibleFaultVmstateReader *reader, uint8_t *value)
+{
+    return qemu_crucible_fault_vmstate_get_bytes(reader, value,
+                                                  sizeof(*value));
+}
+
+bool qemu_crucible_fault_vmstate_get_u16(
+    QemuCrucibleFaultVmstateReader *reader, uint16_t *value)
+{
+    uint8_t encoded[2];
+
+    if (!qemu_crucible_fault_vmstate_get_bytes(reader, encoded,
+                                                sizeof(encoded))) {
+        return false;
+    }
+    *value = lduw_be_p(encoded);
+    return true;
+}
+
+bool qemu_crucible_fault_vmstate_get_u32(
+    QemuCrucibleFaultVmstateReader *reader, uint32_t *value)
+{
+    uint8_t encoded[4];
+
+    if (!qemu_crucible_fault_vmstate_get_bytes(reader, encoded,
+                                                sizeof(encoded))) {
+        return false;
+    }
+    *value = ldl_be_p(encoded);
+    return true;
+}
+
+bool qemu_crucible_fault_vmstate_get_u64(
+    QemuCrucibleFaultVmstateReader *reader, uint64_t *value)
+{
+    uint8_t encoded[8];
+
+    if (!qemu_crucible_fault_vmstate_get_bytes(reader, encoded,
+                                                sizeof(encoded))) {
+        return false;
+    }
+    *value = ldq_be_p(encoded);
+    return true;
+}
+
+bool qemu_crucible_fault_vmstate_reader_finished(
+    const QemuCrucibleFaultVmstateReader *reader)
+{
+    return reader->offset == reader->length;
+}
+
+static void crucible_fault_vmstate_sha256(const uint8_t *bytes, size_t len,
+                                          uint8_t digest[32])
+{
+    g_autoptr(GChecksum) checksum = g_checksum_new(G_CHECKSUM_SHA256);
+    gsize digest_len = 32;
+
+    g_checksum_update(checksum, bytes, len);
+    g_checksum_get_digest(checksum, digest, &digest_len);
+    g_assert(digest_len == 32);
+}
+
+static int crucible_fault_vmstate_profile_validate(uint32_t profile,
+                                                   Error **errp)
+{
+    int status = crucible_fault_vmstate_registry_validate();
+
+    if (status != 0) {
+        error_setg(errp, "Crucible fault VMState registry is incomplete");
+        return status;
+    }
+    if (profile != CRUCIBLE_FAULT_VMSTATE_PROFILE_COMPLETE &&
+        profile != CRUCIBLE_FAULT_VMSTATE_PROFILE_HOST_MEMORY_SERVICE) {
+        error_setg(errp, "Crucible fault VMState profile is invalid");
+        return -EINVAL;
+    }
+    if (profile == CRUCIBLE_FAULT_VMSTATE_PROFILE_HOST_MEMORY_SERVICE &&
+        !qemu_crucible_fault_host_memory_service_profile_valid(
+            crucible_fault_vmstate_section_registered(
+                "cpu-memory-service-ticket"))) {
+        error_setg(errp,
+                   "Crucible host memory service VMState profile has "
+                   "unsupported fault state");
+        return -ENOTSUP;
+    }
+    return 0;
+}
+
+static int crucible_fault_vmstate_save_prepare(void *opaque, Error **errp)
+{
+    return crucible_fault_vmstate_profile_validate(
+        crucible_fault_vmstate_profile(), errp);
+}
+
+static void crucible_fault_vmstate_save(QEMUFile *file, void *opaque)
+{
+    g_autoptr(GByteArray) encoded = g_byte_array_new();
+    uint8_t digest[32];
+    uint32_t profile = crucible_fault_vmstate_profile();
+    int status;
+
+    g_byte_array_append(encoded,
+                        (const uint8_t *)CRUCIBLE_FAULT_VMSTATE_MAGIC, 8);
+    qemu_crucible_fault_vmstate_put_u32(encoded,
+                                        CRUCIBLE_FAULT_VMSTATE_VERSION);
+    qemu_crucible_fault_vmstate_put_u32(encoded, profile);
+    qemu_crucible_fault_vmstate_put_u32(
+        encoded, crucible_fault_vmstate_profile_count(profile));
+    for (size_t i = 0; i < crucible_fault_vmstate_sections->len; i++) {
+        const QemuCrucibleFaultVmstateSection *section =
+            g_ptr_array_index(crucible_fault_vmstate_sections, i);
+        g_autoptr(GByteArray) payload = g_byte_array_new();
+        size_t name_len = strlen(section->name);
+
+        if (!crucible_fault_vmstate_profile_section(profile,
+                                                     section->name)) {
+            continue;
+        }
+        status = section->save(payload);
+        if (status != 0 ||
+            payload->len > CRUCIBLE_FAULT_VMSTATE_MAX_SECTION_BYTES ||
+            name_len > CRUCIBLE_FAULT_VMSTATE_MAX_NAME_BYTES ||
+            encoded->len > CRUCIBLE_FAULT_VMSTATE_MAX_TOTAL_BYTES - 16 ||
+            encoded->len + 16 >
+                CRUCIBLE_FAULT_VMSTATE_MAX_TOTAL_BYTES - name_len ||
+            encoded->len + 16 + name_len >
+                CRUCIBLE_FAULT_VMSTATE_MAX_TOTAL_BYTES - payload->len) {
+            qemu_file_set_error(file, status != 0 ? status : -E2BIG);
+            return;
+        }
+        qemu_crucible_fault_vmstate_put_u16(encoded, name_len);
+        qemu_crucible_fault_vmstate_put_u16(encoded, 0);
+        qemu_crucible_fault_vmstate_put_u32(encoded, section->version);
+        qemu_crucible_fault_vmstate_put_u64(encoded, payload->len);
+        g_byte_array_append(encoded, (const uint8_t *)section->name, name_len);
+        g_byte_array_append(encoded, payload->data, payload->len);
+    }
+    if (encoded->len > CRUCIBLE_FAULT_VMSTATE_MAX_TOTAL_BYTES) {
+        qemu_file_set_error(file, -E2BIG);
+        return;
+    }
+    crucible_fault_vmstate_sha256(encoded->data, encoded->len, digest);
+    qemu_put_be64(file, encoded->len);
+    qemu_put_buffer(file, encoded->data, encoded->len);
+    qemu_put_buffer(file, digest, sizeof(digest));
+}
+
+static bool crucible_fault_fingerprint_projection(QEMUFile *file,
+                                                  const void *opaque,
+                                                  Error **errp)
+{
+    static const uint8_t magic[] = "CRUCFPFAULT3";
+    g_autoptr(GPtrArray) payloads =
+        g_ptr_array_new_with_free_func((GDestroyNotify)g_byte_array_unref);
+    uint32_t profile = crucible_fault_vmstate_profile();
+    uint32_t count;
+    uint64_t total = sizeof(magic) - 1 + 2 * sizeof(uint32_t);
+    size_t payload_index = 0;
+
+    (void)opaque;
+    if (crucible_fault_vmstate_profile_validate(profile, errp) != 0) {
+        return false;
+    }
+    count = crucible_fault_vmstate_profile_count(profile);
+
+    for (size_t i = 0; i < crucible_fault_vmstate_sections->len; i++) {
+        const QemuCrucibleFaultVmstateSection *section =
+            g_ptr_array_index(crucible_fault_vmstate_sections, i);
+        GByteArray *payload;
+        size_t name_len = strlen(section->name);
+        uint64_t row_size;
+        int status;
+
+        if (!crucible_fault_vmstate_profile_section(profile,
+                                                     section->name)) {
+            continue;
+        }
+        payload = g_byte_array_new();
+        g_ptr_array_add(payloads, payload);
+        status = section->fingerprint_projection(payload);
+        row_size = 16 + name_len + payload->len;
+        if (status != 0 ||
+            payload->len > CRUCIBLE_FAULT_VMSTATE_MAX_SECTION_BYTES ||
+            name_len == 0 ||
+            name_len > CRUCIBLE_FAULT_VMSTATE_MAX_NAME_BYTES ||
+            total > CRUCIBLE_FAULT_VMSTATE_MAX_TOTAL_BYTES - row_size) {
+            error_setg(errp,
+                       "Crucible fault projection section %s is invalid",
+                       section->name);
+            return false;
+        }
+        total += row_size;
+    }
+
+    qemu_put_buffer(file, magic, sizeof(magic) - 1);
+    qemu_put_be32(file, profile);
+    qemu_put_be32(file, count);
+    for (size_t i = 0; i < crucible_fault_vmstate_sections->len; i++) {
+        const QemuCrucibleFaultVmstateSection *section =
+            g_ptr_array_index(crucible_fault_vmstate_sections, i);
+        const GByteArray *payload;
+        size_t name_len = strlen(section->name);
+
+        if (!crucible_fault_vmstate_profile_section(profile,
+                                                     section->name)) {
+            continue;
+        }
+        payload = g_ptr_array_index(payloads, payload_index++);
+        qemu_put_be16(file, name_len);
+        qemu_put_be16(file, 0);
+        qemu_put_be32(file, section->version);
+        qemu_put_be64(file, payload->len);
+        qemu_put_buffer(file, (const uint8_t *)section->name, name_len);
+        qemu_put_buffer(file, payload->data, payload->len);
+    }
+    g_assert(payload_index == count);
+    return qemu_file_get_error(file) == 0;
+}
+
+static const CrucibleFingerprintProjection crucible_fault_fingerprint = {
+    .schema = "crucible.qemu.fault-continuation.v3",
+    .version = 3,
+    .save = crucible_fault_fingerprint_projection,
+};
+
+static const QemuCrucibleFaultVmstateSection *
+crucible_fault_vmstate_find(const uint8_t *name, size_t name_len)
+{
+    for (size_t i = 0; i < crucible_fault_vmstate_sections->len; i++) {
+        const QemuCrucibleFaultVmstateSection *section =
+            g_ptr_array_index(crucible_fault_vmstate_sections, i);
+
+        if (strlen(section->name) == name_len &&
+            memcmp(section->name, name, name_len) == 0) {
+            return section;
+        }
+    }
+    return NULL;
+}
+
+static int crucible_fault_vmstate_load(QEMUFile *file, void *opaque,
+                                       int version_id)
+{
+    g_autofree uint8_t *encoded = NULL;
+    g_autoptr(GArray) staged = g_array_new(false, true,
+                                           sizeof(CrucibleFaultVmstateStaged));
+    bool seen[CRUCIBLE_FAULT_VMSTATE_MAX_SECTIONS] = { false };
+    uint8_t expected_digest[32];
+    uint8_t actual_digest[32];
+    uint64_t encoded_len;
+    size_t offset = 0;
+    uint32_t count, profile;
+    int status = -EINVAL;
+
+    crucible_fault_vmstate_expected_reservations = 0;
+    crucible_fault_vmstate_counted_reservations = 0;
+    crucible_fault_vmstate_expected_deferred = 0;
+    crucible_fault_vmstate_counted_deferred = 0;
+    crucible_fault_vmstate_has_expected_reservations = false;
+    crucible_fault_vmstate_has_expected_deferred = false;
+
+    if (version_id != 1 || crucible_fault_vmstate_registry_validate() != 0) {
+        return -EINVAL;
+    }
+    encoded_len = qemu_get_be64(file);
+    if (encoded_len < 20 ||
+        encoded_len > CRUCIBLE_FAULT_VMSTATE_MAX_TOTAL_BYTES) {
+        return -E2BIG;
+    }
+    encoded = g_malloc(encoded_len);
+    if (qemu_get_buffer(file, encoded, encoded_len) != encoded_len ||
+        qemu_get_buffer(file, expected_digest, sizeof(expected_digest)) !=
+            sizeof(expected_digest)) {
+        return -EIO;
+    }
+    crucible_fault_vmstate_sha256(encoded, encoded_len, actual_digest);
+    if (memcmp(expected_digest, actual_digest, sizeof(actual_digest)) != 0 ||
+        memcmp(encoded, CRUCIBLE_FAULT_VMSTATE_MAGIC, 8) != 0 ||
+        ldl_be_p(encoded + 8) != CRUCIBLE_FAULT_VMSTATE_VERSION) {
+        return -EINVAL;
+    }
+    profile = ldl_be_p(encoded + 12);
+    count = ldl_be_p(encoded + 16);
+    offset = 20;
+    if ((profile != CRUCIBLE_FAULT_VMSTATE_PROFILE_COMPLETE &&
+         profile != CRUCIBLE_FAULT_VMSTATE_PROFILE_HOST_MEMORY_SERVICE) ||
+        count != crucible_fault_vmstate_profile_count(profile)) {
+        return -EINVAL;
+    }
+    for (uint32_t i = 0; i < count; i++) {
+        const QemuCrucibleFaultVmstateSection *section;
+        CrucibleFaultVmstateStaged item = { 0 };
+        uint16_t name_len;
+        uint32_t section_version;
+        uint64_t payload_len;
+        size_t section_index;
+
+        if (offset > encoded_len || encoded_len - offset < 16) {
+            goto cleanup;
+        }
+        name_len = lduw_be_p(encoded + offset);
+        if (lduw_be_p(encoded + offset + 2) != 0) {
+            goto cleanup;
+        }
+        section_version = ldl_be_p(encoded + offset + 4);
+        payload_len = ldq_be_p(encoded + offset + 8);
+        offset += 16;
+        if (name_len == 0 || name_len > CRUCIBLE_FAULT_VMSTATE_MAX_NAME_BYTES ||
+            payload_len > CRUCIBLE_FAULT_VMSTATE_MAX_SECTION_BYTES ||
+            offset > encoded_len || encoded_len - offset < name_len ||
+            encoded_len - offset - name_len < payload_len) {
+            goto cleanup;
+        }
+        section = crucible_fault_vmstate_find(encoded + offset, name_len);
+        if (!section || section->version != section_version) {
+            goto cleanup;
+        }
+        section_index = 0;
+        while (g_ptr_array_index(crucible_fault_vmstate_sections,
+                                 section_index) != section) {
+            section_index++;
+        }
+        if (seen[section_index] ||
+            !crucible_fault_vmstate_profile_section(profile,
+                                                     section->name)) {
+            goto cleanup;
+        }
+        for (size_t prior = 0; prior < section_index; prior++) {
+            const QemuCrucibleFaultVmstateSection *prior_section =
+                g_ptr_array_index(crucible_fault_vmstate_sections, prior);
+
+            if (crucible_fault_vmstate_profile_section(
+                    profile, prior_section->name) && !seen[prior]) {
+                goto cleanup;
+            }
+        }
+        seen[section_index] = true;
+        offset += name_len;
+        item.section = section;
+        item.payload = encoded + offset;
+        item.payload_len = payload_len;
+        g_array_append_val(staged, item);
+        offset += payload_len;
+    }
+    if (offset != encoded_len) {
+        status = -EINVAL;
+        goto cleanup;
+    }
+    for (size_t pass = 0; pass < 2; pass++) {
+        for (size_t i = 0; i < staged->len; i++) {
+            CrucibleFaultVmstateStaged *item = &g_array_index(
+                staged, CrucibleFaultVmstateStaged, i);
+            bool node_rules = strcmp(item->section->name, "node-rules") == 0;
+
+            if (node_rules != (pass == 0)) {
+                continue;
+            }
+            if (!crucible_fault_restore_enter(item)) {
+                status = -EBUSY;
+                goto cleanup;
+            }
+            status = item->section->prepare(item->payload, item->payload_len,
+                                            &item->state);
+            int post = crucible_fault_restore_post(item, status);
+
+            if (!status) {
+                status = post;
+            }
+            if (status != 0) {
+                error_report("Crucible fault VMState section '%s' rejected "
+                             "restore: %d",
+                             item->section->name, status);
+                goto cleanup;
+            }
+        }
+    }
+    if (!crucible_fault_vmstate_has_expected_reservations ||
+        !crucible_fault_vmstate_has_expected_deferred ||
+        crucible_fault_vmstate_expected_reservations !=
+            crucible_fault_vmstate_counted_reservations ||
+        crucible_fault_vmstate_expected_deferred !=
+            crucible_fault_vmstate_counted_deferred) {
+        error_report("Crucible fault VMState reservation accounting "
+                     "mismatch: expected=%zu counted=%zu "
+                     "deferred-expected=%zu deferred-counted=%zu",
+                     crucible_fault_vmstate_expected_reservations,
+                     crucible_fault_vmstate_counted_reservations,
+                     crucible_fault_vmstate_expected_deferred,
+                     crucible_fault_vmstate_counted_deferred);
+        status = -EINVAL;
+        goto cleanup;
+    }
+    qemu_crucible_fault_vmstate_restoring(true);
+    for (size_t pass = 0; pass < 3; pass++) {
+        for (size_t i = 0; i < staged->len; i++) {
+            CrucibleFaultVmstateStaged *item = &g_array_index(
+                staged, CrucibleFaultVmstateStaged, i);
+            bool node_rules = strcmp(item->section->name, "node-rules") == 0;
+            bool command = strcmp(item->section->name, "command") == 0;
+
+            if ((pass == 0 && !node_rules) ||
+                (pass == 1 && (node_rules || command)) ||
+                (pass == 2 && !command)) {
+                continue;
+            }
+            if (!crucible_fault_restore_enter(item)) {
+                return -EBUSY;
+            }
+            item->section->commit(item->state);
+            if (crucible_fault_restore_post(item, 0)) {
+                return -EPERM;
+            }
+            item->state = NULL;
+        }
+    }
+    qemu_crucible_fault_vmstate_restoring(false);
+    status = 0;
+
+cleanup:
+    for (size_t i = 0; i < staged->len; i++) {
+        CrucibleFaultVmstateStaged *item = &g_array_index(
+            staged, CrucibleFaultVmstateStaged, i);
+        if (item->state) {
+            if (!crucible_fault_restore_enter(item)) {
+                return -EBUSY;
+            }
+            item->section->free_staged(item->state);
+            if (crucible_fault_restore_post(item, 0)) {
+                return -EPERM;
+            }
+        }
+    }
+    return status;
+}
+
+static bool crucible_fault_vmstate_active(void *opaque)
+{
+    return qemu_plugin_crucible_single_threaded_rr();
+}
+
+static const SaveVMHandlers crucible_fault_vmstate_handlers = {
+    .save_prepare = crucible_fault_vmstate_save_prepare,
+    .save_state = crucible_fault_vmstate_save,
+    .load_state = crucible_fault_vmstate_load,
+    .is_active = crucible_fault_vmstate_active,
+    .crucible_fingerprint_projection = &crucible_fault_fingerprint,
+};
+
+static void crucible_fault_vmstate_machine_done_notify(
+    Notifier *notifier, void *opaque)
+{
+    int status;
+
+    (void)notifier;
+    (void)opaque;
+    status = register_savevm_live("crucible-fault", 0, 1,
+                                  &crucible_fault_vmstate_handlers, NULL);
+    if (status != 0) {
+        error_report("Crucible fault VMState registration failed: %d",
+                     status);
+        abort();
+    }
+}
+
+int qemu_crucible_fault_vmstate_enable(void)
+{
+    if (crucible_fault_vmstate_enabled) {
+        return 0;
+    }
+    crucible_fault_vmstate_machine_done.notify =
+        crucible_fault_vmstate_machine_done_notify;
+    qemu_add_machine_init_done_notifier(
+        &crucible_fault_vmstate_machine_done);
+    crucible_fault_vmstate_enabled = true;
+    return 0;
+}
