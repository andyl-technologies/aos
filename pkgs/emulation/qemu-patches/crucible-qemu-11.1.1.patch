diff --git a/tests/unit/crucible-action-original-fixture.inc.h b/tests/unit/crucible-action-original-fixture.inc.h
new file mode 100644
index 0000000000000000000000000000000000000000..216b66defb60d1f0dcdc474afd13e4c3c37ee731
--- /dev/null
+++ b/tests/unit/crucible-action-original-fixture.inc.h
@@ -0,0 +1,112 @@
+/*
+ * Assertions at actual semantic Main entry and physical closure cuts.
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * These checks provide no issuer or replacement provider. The caller must
+ * construct the real Source action, subscriber and module journal first.
+ * Component installation models do not qualify the launched lifecycle.
+ */
+
+static void action_original_fixture_entered(QemuCrucibleMainControlBorrow *main)
+{
+    QemuCrucibleActionOriginal *action = &startup_source.action_original;
+    QemuCrucibleActionOriginal copy = *action;
+    QemuCrucibleMainControlBorrow main_copy = *main;
+    QemuCruciblePublisherActionLoan *publisher_copy = action->publisher;
+    QemuCrucibleBoundaryActionRecord original = action->cohort;
+    QemuCrucibleModuleFingerprintAction *module = action->module_action;
+    uint64_t serial = action->module_serial;
+    qemu_plugin_id_t id = action->member->installer.plugin_id;
+
+    g_assert_true(action->held);
+    g_assert_true(action->qualified);
+    g_assert_true(action->callback_active);
+    g_assert_false(action->issuing);
+    g_assert_false(action->returning);
+    g_assert_nonnull(action->publisher);
+    g_assert_nonnull(module);
+    g_assert_cmpuint(serial, >, 0);
+    g_assert_cmpint(qemu_plugin_crucible_source_action_call_current_v1(main), ==, 0);
+    g_assert_cmpint(qemu_crucible_source_action_original_current_v1(action, id), ==, 0);
+
+    /* Copied records and output holders cannot issue or consume authority. */
+    g_assert_cmpint(qemu_crucible_source_action_original_current_v1(&copy, id), ==, -EPERM);
+    g_assert_cmpint(qemu_crucible_source_action_original_publisher_current_v1(
+        action, &main_copy, &action->publisher), <, 0);
+    g_assert_cmpint(qemu_crucible_source_action_original_publisher_current_v1(
+        action, main, &publisher_copy), <, 0);
+    g_assert_cmpint(qemu_crucible_source_action_original_publisher_issuing_v1(
+        action, main, &action->publisher), <, 0);
+    g_assert_cmpint(qemu_crucible_source_action_original_publisher_returning_v1(
+        action, main, &action->publisher), <, 0);
+    g_assert_cmpint(qemu_crucible_source_action_original_closed_v1(main), ==, -EBUSY);
+    g_assert_cmpint(qemu_crucible_source_action_original_return_v1(main), <, 0);
+
+    /* A real nested Native mask must hide the entered callback, even though
+     * the outer Main, action, module token and scalar serial still match. */
+    QemuCrucibleNativeInvocationTicket nested = qemu_plugin_crucible_native_mask_v1(
+        &action_original_fixture_entered, action_original_fixture_entered, NULL);
+
+    g_assert_cmpint(qemu_plugin_crucible_source_action_call_current_v1(main), <, 0);
+    g_assert_cmpint(qemu_crucible_source_action_original_current_v1(action, id), <, 0);
+    qemu_plugin_crucible_native_exit_v1(nested);
+    g_assert_cmpint(qemu_plugin_crucible_source_action_call_current_v1(main), ==, 0);
+    g_assert_cmpint(qemu_crucible_source_action_original_current_v1(action, id), ==, 0);
+    g_assert_true(action->module_action == module);
+    g_assert_cmpuint(action->module_serial, ==, serial);
+    g_assert_true(action->publisher == publisher_copy);
+    g_assert_cmpmem(&action->cohort, sizeof(action->cohort), &original, sizeof(original));
+}
+
+static void action_original_fixture_retained(void)
+{
+    QemuCrucibleActionOriginal *action = &startup_source.action_original;
+    QemuCrucibleMainControlBorrow *main = action->main;
+    QemuCrucibleModuleFingerprintAction *module = action->module_action;
+    uint64_t serial = action->module_serial;
+    qemu_plugin_id_t id = action->member->installer.plugin_id;
+
+    g_assert_true(action->held);
+    g_assert_false(action->callback_active);
+    g_assert_true(action->post_attempted);
+    g_assert_cmpint(qemu_crucible_source_action_original_current_v1(action, id), <, 0);
+    g_assert_cmpint(qemu_crucible_source_action_original_publisher_current_v1(
+        action, main, &action->publisher), <, 0);
+    g_assert_cmpint(qemu_crucible_source_action_original_closed_v1(main), ==, -EBUSY);
+    /* This call is outside an actual returning/cleanup entry. A retained Main
+     * address cannot revive the expired interval or authenticate a retry. */
+    g_assert_cmpint(qemu_crucible_source_action_original_return_v1(main), <, 0);
+    g_assert_true(action->module_action == module);
+    g_assert_cmpuint(action->module_serial, ==, serial);
+    g_assert_true(main->held);
+    g_assert_true(main->payload_borrow.held);
+}
+
+static void action_original_fixture_closed(QemuCrucibleReceivedDeliveryOwner *delivery,
+                                           uint64_t serial)
+{
+    QemuCrucibleActionOriginal *action = &startup_source.action_original;
+    QemuCrucibleReceivedDeliveryOwner copy = *delivery;
+    int first = INT_MAX;
+    int post = INT_MAX;
+
+    g_assert_false(action->held);
+    g_assert_false(action->uncertain);
+    g_assert_true(action->module_closed);
+    g_assert_null(action->module_action);
+    g_assert_cmpuint(action->module_serial, ==, 0);
+    g_assert_null(action->publisher);
+    qemu_mutex_lock(&startup_source.commands.mutex);
+    g_assert_cmpint(qemu_crucible_source_action_original_delivery_result_v1(
+        &copy, serial, &first, &post), <, 0);
+    g_assert_cmpint(first, ==, INT_MAX);
+    g_assert_cmpint(post, ==, INT_MAX);
+    g_assert_cmpint(qemu_crucible_source_action_original_delivery_result_v1(
+        delivery, serial + 1, &first, &post), <, 0);
+    g_assert_cmpint(qemu_crucible_source_action_original_delivery_result_v1(
+        delivery, serial, &first, &post), ==, 0);
+    qemu_mutex_unlock(&startup_source.commands.mutex);
+    /* Physical closure does not erase either independent saved failure. */
+    g_assert_cmpint(first, ==, action->first_status);
+    g_assert_cmpint(post, ==, action->post_status);
+}
