+    TestMutexMapping mapping = reserve_test_mutex_mapping();
+    QemuMutex *abandoned_mutex = (QemuMutex *)mapping.mutex_address;
+    QemuMutexHotForkRegistration abandoned;
+    QemuMutex live_mutex;
+    int child_result[2];
+    pid_t child;
+
+    qemu_mutex_init(abandoned_mutex);
+    abandoned = (QemuMutexHotForkRegistration) {
+        .registration_id =
+            abandoned_mutex->crucible_hot_fork_registration_id,
+        .slot = abandoned_mutex->crucible_hot_fork_slot,
+    };
+    abandon_test_mutex_mapping(&mapping);
+
+    g_assert_cmpint(pipe2(child_result, O_CLOEXEC), ==, 0);
+    start_registry_worker_thread(&monitor_worker, "IO mon_iothread",
+                                 monitor_registry_worker);
