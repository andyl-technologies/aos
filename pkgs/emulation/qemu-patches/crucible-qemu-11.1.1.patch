+static int crucible_test_image(void)
+{
+    g_autofree char *path = NULL;
+    int fd = g_file_open_tmp("crucible-launch-image-XXXXXX", &path, NULL);
+
+    g_assert_cmpint(fd, >=, 0);
+    g_assert_cmpint(ftruncate(fd, 4096), ==, 0);
