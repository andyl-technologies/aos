+    if (hash->bytes > UINT64_MAX / 8 || len > UINT64_MAX / 8 - hash->bytes) {
+        return -EOVERFLOW;
+    }
+    buffered = hash->bytes % sizeof(hash->block);
+    hash->bytes += len;
+    while (len) {
+        size_t chunk = MIN(len, sizeof(hash->block) - buffered);
