+/* Ordinary actual Linux physical bodies only. These journals do not install
+ * a Source purpose/session, and cannot stand in for a paid provider fixture. */
+static void test_publisher_physical(void)
+{
+    PreexecPublisherMappingJournal mapping = { 0 };
+    PreexecPublisherAliasJournal alias = { 0 };
+    long page = sysconf(_SC_PAGESIZE);
+    int descriptor = memfd_create("publisher-physical-body", MFD_CLOEXEC);
+    void *address;
+    void *replacement;
+    int spare;
+    int child_status;
+    pid_t child;
+
+    g_assert_cmpint(page, >, 0);
+    g_assert_cmpint(descriptor, >=, 0);
+    g_assert_cmpint(ftruncate(descriptor, page), ==, 0);
+    g_assert_cmpint(preexec_publisher_mapping_acquire(&mapping, descriptor, page, page), ==, 0);
+    g_assert_true(mapping.attempted);
+    g_assert_cmpint(mapping.retained, ==, true);
+    g_assert_true(mapping.dontfork);
+    address = mapping.address;
+    mapping.address[0] = UINT64_C(0x1122334455667788);
+    g_assert_cmpint(preexec_publisher_mapping_acquire(&mapping, descriptor, page, page), ==, -EALREADY);
+    g_assert_cmpuint(mapping.address[0], ==, UINT64_C(0x1122334455667788));
+    child = fork();
+    g_assert_cmpint(child, >=, 0);
+    if (!child) {
+        unsigned char resident;
+        int observed = mincore(address, page, &resident);
+
+        _exit(observed == -1 && errno == ENOMEM ? 0 : 1);
+    }
+    g_assert_cmpint(waitpid(child, &child_status, 0), ==, child);
+    g_assert_true(WIFEXITED(child_status));
+    g_assert_cmpint(WEXITSTATUS(child_status), ==, 0);
+    g_assert_cmpint(preexec_publisher_mapping_return(&mapping), ==, 0);
+    g_assert_true(mapping.unmap_attempted);
+    g_assert_true(mapping.physically_returned);
+    g_assert_false(mapping.uncertain);
+    g_assert_cmpint(mprotect(address, page, PROT_READ), ==, -1);
+    g_assert_cmpint(errno, ==, ENOMEM);
+
+    /* Reuse the same address with a distinct real allocation. Repeating the
+     * consumed destructor would incorrectly dispose of this new object. */
+    replacement = mmap(address, page, PROT_READ | PROT_WRITE,
+        MAP_FIXED | MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    g_assert_true(replacement == address);
+    g_assert_cmpint(preexec_publisher_mapping_return(&mapping), ==, 0);
+    g_assert_cmpint(mprotect(replacement, page, PROT_READ | PROT_WRITE), ==, 0);
+    g_assert_cmpint(munmap(replacement, page), ==, 0);
+
+    alias.descriptor = descriptor;
+    alias.received = true;
+    g_assert_cmpint(preexec_publisher_alias_return(&alias), ==, 0);
+    g_assert_true(alias.close_attempted);
+    g_assert_true(alias.physically_returned);
+    g_assert_false(alias.uncertain);
+    g_assert_cmpint(fcntl(descriptor, F_GETFD), ==, -1);
+    g_assert_cmpint(errno, ==, EBADF);
+    spare = memfd_create("publisher-next-physical-object", MFD_CLOEXEC);
+    g_assert_cmpint(spare, >=, 0);
+    if (spare != descriptor) {
+        g_assert_cmpint(dup2(spare, descriptor), ==, descriptor);
+        g_assert_cmpint(close(spare), ==, 0);
+    }
+    g_assert_cmpint(preexec_publisher_alias_return(&alias), ==, 0);
+    g_assert_cmpint(fcntl(descriptor, F_GETFD), >=, 0);
+    g_assert_cmpint(close(descriptor), ==, 0);
+
+    memset(&alias, 0, sizeof(alias));
+    alias.descriptor = -1;
+    alias.received = true;
+    g_assert_cmpint(preexec_publisher_alias_return(&alias), ==, -EBADF);
+    g_assert_true(alias.close_attempted);
+    g_assert_false(alias.physically_returned);
+    g_assert_true(alias.uncertain);
+    g_assert_cmpint(preexec_publisher_alias_return(&alias), ==, -EBADF);
+    g_assert_false(preexec_setup_owner.publisher_storage.session.held);
+}
