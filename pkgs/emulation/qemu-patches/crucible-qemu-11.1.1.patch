+    QemuCrucibleFingerprintWakeKeeper *keeper;
+    QemuCrucibleFingerprintMainExecution **owner_field;
+    QemuCrucibleFingerprintIntentObservation *snapshot;
+    QemuCrucibleReadyDeliveryHandoff *ready_delivery;
+    struct QemuCrucibleResidentRootRequest *request;
