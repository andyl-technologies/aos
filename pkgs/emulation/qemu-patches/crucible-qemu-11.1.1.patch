+static void test_committed_completion_stop(void)
+{
+    reset_control();
+    publish_wake();
+    qemu_plugin_crucible_rr_control_boundary_acknowledge();
+    stop_in_completion = true;
+    g_assert_cmpint(qemu_plugin_advance_time_ticks(19000), ==, 0);
+    service_events();
+    g_assert_cmpuint(control_calls, ==, 0);
+    g_assert_cmpint(observed_completion_status, ==, 0);
+    g_assert_cmpuint(completion_calls, ==, 1);
+    g_assert_cmpuint(frames, ==, 3);
+    g_assert_cmpint(timers_state.crucible_sim_tick_bias, ==, 2000);
+    g_assert_cmpint(qemu_plugin_time_advance_pending, ==, 0);
+    finish_stop();
+    finish_stop();
+    finish_stop();
+    current_cpu = NULL;
+    service_events();
+    g_assert_cmpuint(control_calls, ==, 1);
+    g_assert_cmpint(timers_state.crucible_sim_tick_bias, ==, 2000);
