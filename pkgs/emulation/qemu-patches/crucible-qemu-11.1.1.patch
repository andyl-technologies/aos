+/* Original TOTAL authenticates provenance, not the per-incarnation spend
+ * bound. No caller floor, output scalar or completed Setup creates this owner.
+ */
+int qemu_crucible_startup_source_inventory_allowance_limit_v2(
+    uint64_t original_total, uint64_t native_report, uint64_t *allowance)
+{
+    QemuCrucibleMetadataPartition *partition =
+        &startup_source.metadata_partition;
+    uint64_t available;
+    int status;
+
+    /* Preserve the existing inactive/four-slot path without an added temporal
+     * observation. Its existing reserve cut retains original pre/post priority.
+     */
+    if (!qemu_crucible_startup_source_control_metadata_bytes() ||
+        !partition->process_extent) {
+        return 0;
+    }
+    status = qemu_crucible_startup_source_native_metadata_check();
+    if (status) {
+        return status;
+    }
+    if (!qatomic_load_acquire(&startup_source.process_purpose_complete) ||
+        !startup_source.preexec_purpose_owner ||
+        !startup_source.process_contract_owner ||
+        !startup_source.incarnation_purpose_owner) {
+#ifdef CONFIG_LINUX
+        return startup_failure(-ENOKEY);
+#else
+        return startup_failure(-ENOTSUP);
+#endif
+    }
+    if (!allowance || original_total != partition->total ||
+        original_total != startup_source.original.original_total_bytes ||
+        partition->process_extent !=
+            startup_source.process_purpose_record.local_extent ||
+        !crucible_metadata_partition_residual_valid(partition)) {
+        return startup_failure(-ESTALE);
+    }
+    available = partition->process_extent - partition->compulsory_extent;
+    if (native_report > available ||
+        partition->controller_extent >= available - native_report) {
+        return startup_failure(-ENOSPC);
+    }
+    *allowance = available - native_report - partition->controller_extent;
+    return 0;
+}
