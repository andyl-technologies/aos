+int qemu_crucible_ram_mutation_begin(uint64_t *transaction,
+                                    uint64_t *topology)
+{
+    struct qemu_plugin_crucible_ram_capture_v1 capture;
+    uint8_t baseline[32];
+    uint64_t logical_bytes;
+    int status;
+
+    if (!transaction || !topology || mutation_writer_scope || capture_active ||
+        (mutation_preflight_scope && !mutation_preflight_ready)) {
+        return -EBUSY;
+    }
+    /* The existing replay owner may establish an operational writer fence
+     * without interrupt polling, advancing an event, or ending its quantum.
+     * Device/kernel borrower exclusion remains a caller admission obligation.
+     */
+    if (current_cpu && qemu_plugin_crucible_single_threaded_rr() &&
+        replay_mutex_owned()) {
+        if (!bql_locked()) {
+            bql_lock();
+            mutation_bql_owned = true;
+        }
+        fault_root_writer_scope = true;
+    }
+    mutation_writer_scope = true;
+    status = qemu_crucible_ram_root(0, baseline, &logical_bytes);
+    if (!status) {
+        status = qemu_plugin_crucible_ram_capture_begin_v2(1, 0, &capture);
+    }
+    if (status) {
+        if (!mutation_preflight_scope) {
+            fault_root_writer_scope = false;
+        }
+        mutation_writer_scope = false;
+        if (mutation_bql_owned && !mutation_preflight_scope) {
+            mutation_bql_owned = false;
+            bql_unlock();
+        }
+        return status;
+    }
+    *transaction = capture.capture_generation;
+    *topology = capture.topology_generation;
+    return 0;
+}
