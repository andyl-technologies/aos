+# SPDX-License-Identifier: GPL-2.0-or-later
+"""Executes child resource-limit installation against the real Linux kernel.
+
+The production child function is extracted unchanged. Only its operation
+metadata is modeled; fork, eventfd, descriptor ownership, resource limits,
+memory locking and cancellation are actual syscalls. This component test does
+not establish complete guest paging or fork reconstruction qualification.
+"""
+
+import argparse
+import json
+import os
+from pathlib import Path
+import shlex
+import subprocess
+
+
+ROOT = Path(__file__).resolve().parents[2]
+
+
+def definition(source: str, signature: str) -> str:
+    start = source.index(signature)
+    opening = source.index("{", start)
+    depth = 0
+    for index in range(opening, len(source)):
+        if source[index] == "{":
+            depth += 1
+        elif source[index] == "}":
+            depth -= 1
+            if depth == 0:
+                return source[start:index + 1]
+    raise AssertionError(f"unterminated production function: {signature}")
+
+
+PRELUDE = r"""
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE
+#endif
+#include <assert.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <sys/eventfd.h>
+#include <sys/mman.h>
+#include <sys/resource.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+typedef struct CrucibleHotForkOperation {
+    bool prepared;
+    int child_process_cgroup_fd;
+    int child_process_cgroup_procs_fd;
+    int child_process_cancellation_fd;
+    uint64_t maximum_file_bytes;
+    uint64_t maximum_locked_bytes;
+} CrucibleHotForkOperation;
+"""
+
+
+TESTS = r"""
+static struct rlimit limit(int resource)
+{
+    struct rlimit value;
+    assert(getrlimit(resource, &value) == 0);
+    return value;
+}
+
+static void child_case(unsigned int kind)
+{
+    struct rlimit original = limit(RLIMIT_MEMLOCK);
+    CrucibleHotForkOperation operation = {
+        .prepared = kind != 5,
+        .child_process_cgroup_fd = eventfd(0, EFD_CLOEXEC | EFD_NONBLOCK),
+        .child_process_cgroup_procs_fd = eventfd(0, EFD_CLOEXEC | EFD_NONBLOCK),
+        .child_process_cancellation_fd = eventfd(0, EFD_CLOEXEC | EFD_NONBLOCK),
+        .maximum_file_bytes = 4096,
+        .maximum_locked_bytes = kind == 0 ? 0 : 4096,
+    };
+    assert(operation.child_process_cgroup_fd >= 0);
+    assert(operation.child_process_cgroup_procs_fd >= 0);
+    assert(operation.child_process_cancellation_fd >= 0);
+
+    if (kind == 2) {
+        uint64_t signal = 1;
+        assert(write(operation.child_process_cancellation_fd,
+                     &signal, sizeof(signal)) == sizeof(signal));
+    } else if (kind == 3) {
+        struct rlimit denied = { .rlim_cur = 0, .rlim_max = 0 };
+        assert(setrlimit(RLIMIT_MEMLOCK, &denied) == 0);
+    } else if (kind == 4) {
+        operation.maximum_locked_bytes = UINT64_MAX;
+    }
+
+    int descriptors[] = {
+        operation.child_process_cgroup_fd,
+        operation.child_process_cgroup_procs_fd,
+        operation.child_process_cancellation_fd,
+    };
+    int result = crucible_hot_fork_apply_child_process_contract(&operation);
+
+    if (kind >= 4) {
+        assert(result == -EINVAL);
+        for (unsigned int index = 0; index < 3; index++) {
+            assert(fcntl(descriptors[index], F_GETFD) >= 0);
+            assert(close(descriptors[index]) == 0);
+        }
+    } else {
+        for (unsigned int index = 0; index < 3; index++) {
+            assert(fcntl(descriptors[index], F_GETFD) == -1 && errno == EBADF);
+        }
+        assert(operation.child_process_cgroup_fd == -1);
+        assert(operation.child_process_cgroup_procs_fd == -1);
+        assert(operation.child_process_cancellation_fd == -1);
+    }
+
+    struct rlimit observed = limit(RLIMIT_MEMLOCK);
+    if (kind == 2 || kind >= 4) {
+        assert(result == (kind == 2 ? -ECANCELED : -EINVAL));
+        assert(observed.rlim_cur == original.rlim_cur);
+        assert(observed.rlim_max == original.rlim_max);
+    } else if (kind == 3) {
+        assert(result == -EPERM);
+        assert(observed.rlim_cur == 0 && observed.rlim_max == 0);
+    } else {
+        assert(result == 0);
+        assert(observed.rlim_cur == operation.maximum_locked_bytes);
+        assert(observed.rlim_max == operation.maximum_locked_bytes);
+        struct rlimit file = limit(RLIMIT_FSIZE);
+        assert(file.rlim_cur == 4096 && file.rlim_max == 4096);
+
+        void *page = mmap(NULL, 4096, PROT_READ | PROT_WRITE,
+                          MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+        assert(page != MAP_FAILED);
+        int locked = mlock(page, 4096);
+        if (kind == 0) {
+            assert(locked == -1 && errno == EPERM);
+        } else {
+            assert(locked == 0);
+            assert(munlock(page, 4096) == 0);
+        }
+        assert(munmap(page, 4096) == 0);
+    }
+}
+
+int main(void)
+{
+    struct rlimit original_lock = limit(RLIMIT_MEMLOCK);
+    struct rlimit original_file = limit(RLIMIT_FSIZE);
+    assert(original_lock.rlim_max == RLIM_INFINITY || original_lock.rlim_max >= 4096);
+    assert(original_file.rlim_max == RLIM_INFINITY || original_file.rlim_max >= 4096);
+
+    for (unsigned int kind = 0; kind < 6; kind++) {
+        pid_t child = fork();
+        assert(child >= 0);
+        if (child == 0) {
+            child_case(kind);
+            _exit(0);
+        }
+        int status;
+        assert(waitpid(child, &status, 0) == child);
+        assert(WIFEXITED(status) && WEXITSTATUS(status) == 0);
+
+        struct rlimit parent_lock = limit(RLIMIT_MEMLOCK);
+        struct rlimit parent_file = limit(RLIMIT_FSIZE);
+        assert(parent_lock.rlim_cur == original_lock.rlim_cur);
+        assert(parent_lock.rlim_max == original_lock.rlim_max);
+        assert(parent_file.rlim_cur == original_file.rlim_cur);
+        assert(parent_file.rlim_max == original_file.rlim_max);
+    }
+    puts("Crucible child memory limits PASS");
+    return 0;
+}
+"""
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--output-dir", type=Path, required=True)
+    arguments = parser.parse_args()
+    source = (ROOT / "monitor/qmp-cmds.c").read_text()
+    function = definition(source, "static int crucible_hot_fork_apply_child_process_contract(")
+    arguments.output_dir.mkdir(parents=True, exist_ok=True)
+    fixture = arguments.output_dir / "child-memory-limit.c"
+    binary = arguments.output_dir / "child-memory-limit"
+    fixture.write_text("\n\n".join([PRELUDE, function, TESTS]))
+    command = [*shlex.split(os.environ["CC"]),
+               *shlex.split(os.environ.get("CFLAGS", "")),
+               "-std=gnu11", "-Wall", "-Wextra", "-Werror", str(fixture),
+               "-o", str(binary), *shlex.split(os.environ.get("LDFLAGS", ""))]
+    (arguments.output_dir / "compile-command.json").write_text(json.dumps(command, indent=2) + "\n")
+    subprocess.run(command, check=True)
+    subprocess.run([str(binary)], cwd=arguments.output_dir, check=True, timeout=10)
+
+
+if __name__ == "__main__":
+    main()
