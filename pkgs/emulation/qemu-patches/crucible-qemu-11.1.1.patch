+void qemu_crucible_checkpoint_candidate_alias_closed_v1(
+    QemuCrucibleCheckpointHeldTransaction *owner, unsigned role, int close_status)
+{
+    if (!owner || checkpoint_identity(owner) || !owner->candidate_started ||
+        role >= 3 || (owner->candidate_aliases_closed & (1U << role))) {
+        return;
+    }
+    owner->candidate_aliases_closed |= 1U << role;
+    if (close_status < 0) {
+        owner->candidate_alias_uncertain = true;
+        checkpoint_fail(owner, close_status, true);
+    }
