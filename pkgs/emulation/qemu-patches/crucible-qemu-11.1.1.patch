+    QemuCrucibleNativeRegistration refused = { .owner = &registry };
+    CrucibleShmemCallbackResult result;
+    unsigned ends_before = physical_ends, posts_before = posts;
+    unsigned callbacks_before = callbacks;
+    uint64_t out = UINT64_C(0x1122334455667788);
