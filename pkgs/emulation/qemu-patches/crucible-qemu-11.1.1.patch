+static void test_riscv_itrigger_phase(bool sim_mode)
+{
+    QEMUTimer *timer;
+    __int128 deadline_ps;
+    __int128 *clock_ps = sim_mode ? NULL : &test_generic_virtual_ps;
+
+    if (!g_test_subprocess()) {
+        g_test_trap_subprocess(NULL, 0, 0);
+        g_test_trap_assert_passed();
+        return;
+    }
+
+    test_virtual_ps = 1050;
+    test_generic_virtual_ps = 1050;
+    test_itrigger_count = 3;
+    test_itrigger_duration_ps = sim_mode ? 150 : 3072;
+    qemu_init_clocks(NULL);
+    qemu_timer_enable_tcg_ps_clock(
+        sim_mode ? test_virtual_clock_ps : NULL,
+        sim_mode ? NULL : test_generic_virtual_clock_ps);
+    qemu_clock_enable(QEMU_CLOCK_VIRTUAL, true);
+    timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, test_timer_callback, NULL);
+
+    g_assert_true(qemu_timer_exact_virtual_ps_enabled() == sim_mode);
+    riscv_itrigger_schedule_timer(timer, 3);
+    deadline_ps = timer_expire_time_ps_wide(timer);
+    g_assert_true(deadline_ps == 1050 + test_itrigger_duration_ps);
+    if (clock_ps) {
+        *clock_ps = deadline_ps - 1;
+    } else {
+        test_virtual_ps = deadline_ps - 1;
+    }
+    g_assert_false(qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL));
+    if (clock_ps) {
+        *clock_ps = deadline_ps;
+    } else {
+        test_virtual_ps = deadline_ps;
+    }
+    g_assert_true(qemu_clock_run_timers(QEMU_CLOCK_VIRTUAL));
+    g_assert_cmpuint(test_timer_callbacks, ==, 1);
+    timer_free(timer);
+}
+
+static void test_riscv_itrigger_sim_phase(void)
+{
+    test_riscv_itrigger_phase(true);
+}
+
+static void test_riscv_itrigger_generic_phase(void)
+{
+    test_riscv_itrigger_phase(false);
+}
