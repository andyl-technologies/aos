+static int initial_register_workspace_current_post(
+    CPUState *cpu, QemuCrucibleInitialRegisterWorkspaceOwner *owner,
+    QemuCrucibleInitialRegisterWorkspaceOwner **holder, bool *authenticated)
+{
+    struct QemuCrucibleInitialCpuParticipant *participant = NULL;
+    int status;
+
+    *authenticated = false;
+    if (!cpu || owner != &startup_source.initial_register_workspace ||
+        cpu != owner->constructor_cpu) {
+        return -EPERM;
+    }
+    status = qemu_crucible_fault_register_workspace_holder_v1(owner, holder, false);
+    if (!status) {
+        status = qemu_plugin_crucible_initial_cpu_dispatch_current_v1(
+            cpu, &cpu->crucible_initial_participant, true, false);
+    }
+    if (!status) {
+        status = initial_cpu_identity(cpu, &cpu->crucible_initial_participant,
+                                      &participant);
+    }
+    if (!status && (!participant->entered || !participant->module_callback_active)) {
+        status = -EPERM;
+    }
+    if (!status) {
+        status = qemu_plugin_crucible_initial_cpu_callback_current_v1(
+            cpu, participant->group->callback, false);
+    }
+    if (status) {
+        return status;
+    }
+    /* Reauthenticate the actual callback independently of mutable workspace
+     * fields and its first result; this post cannot lend scratch or a CPU. */
+    *authenticated = true;
+    return initial_cpu_original_post(participant);
+}
+#endif
