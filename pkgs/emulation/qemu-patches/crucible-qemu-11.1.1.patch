 }
 
+typedef struct TestFingerprintProjectionState {
+    uint64_t value;
+    uint64_t migration_shadow;
+    unsigned int pre_save_calls;
+    unsigned int needed_calls;
+    unsigned int field_exists_calls;
+} TestFingerprintProjectionState;
+
+static int test_fingerprint_projection_pre_save(void *opaque)
+{
+    TestFingerprintProjectionState *state = opaque;
+
+    state->pre_save_calls++;
+    state->migration_shadow = state->value;
+    return 0;
+}
+
+static bool test_fingerprint_projection_needed(void *opaque)
+{
+    TestFingerprintProjectionState *state = opaque;
+
+    state->needed_calls++;
+    return true;
+}
+
+static bool test_fingerprint_projection_field_exists(void *opaque,
+                                                     int version_id)
+{
+    TestFingerprintProjectionState *state = opaque;
+
+    state->field_exists_calls++;
+    return version_id == 1;
+}
+
+static bool test_fingerprint_projection_save(QEMUFile *f,
+                                             const void *opaque,
+                                             Error **errp)
+{
+    const TestFingerprintProjectionState *state = opaque;
+
+    (void)errp;
+    qemu_put_be64(f, state->value);
+    return true;
+}
+
+static const CrucibleFingerprintProjection test_fingerprint_projection = {
+    .schema = "crucible.qemu.test-fingerprint-projection.v1",
+    .version = 1,
+    .save = test_fingerprint_projection_save,
+};
+
+static const VMStateDescription vmstate_test_fingerprint_projection = {
+    .name = "test-fingerprint-projection",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .pre_save = test_fingerprint_projection_pre_save,
+    .needed = test_fingerprint_projection_needed,
+    .crucible_fingerprint_projection = &test_fingerprint_projection,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT64_TEST(migration_shadow,
+                            TestFingerprintProjectionState,
+                            test_fingerprint_projection_field_exists),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static const VMStateDescription vmstate_test_missing_fingerprint_projection = {
+    .name = "test-missing-fingerprint-projection",
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT64(value, TestFingerprintProjectionState),
+        VMSTATE_END_OF_LIST()
+    },
+};
+
+static GBytes *capture_test_fingerprint_projection(
+    const VMStateDescription *vmsd, TestFingerprintProjectionState *state,
+    Error **errp)
+{
+    struct stat statbuf;
+    g_autofree uint8_t *bytes = NULL;
+    QEMUFile *f = open_test_file(true);
+    int ret;
+
+    ret = vmstate_save_fingerprint_projection(f, vmsd, state, errp);
+    qemu_fclose(f);
+    if (ret < 0) {
+        return NULL;
+    }
+
+    g_assert_cmpint(fstat(temp_fd, &statbuf), ==, 0);
+    g_assert_cmpint(statbuf.st_size, >, 0);
+    bytes = g_malloc(statbuf.st_size);
+    g_assert_cmpint(pread(temp_fd, bytes, statbuf.st_size, 0),
+                    ==, statbuf.st_size);
+    return g_bytes_new_take(g_steal_pointer(&bytes), statbuf.st_size);
+}
+
+static void test_fingerprint_projection_registry(void)
+{
+    TestFingerprintProjectionState state = {
+        .value = 0x123456789abcdef0ULL,
+        .migration_shadow = 0xfeedfaceULL,
+    };
+    g_autoptr(GBytes) first = NULL;
+    g_autoptr(GBytes) second = NULL;
+    g_autoptr(GBytes) changed = NULL;
+    Error *local_err = NULL;
+
+    first = capture_test_fingerprint_projection(
+        &vmstate_test_fingerprint_projection, &state, &error_abort);
